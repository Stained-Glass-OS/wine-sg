# SVG sources (relative to the Wine tree) that the series redraws, whose
# rendered .ico/.bmp/.cur build.sh regenerates after applying it.
# user32's default window icon (IDI_WINLOGO): our mark, not Wine's glass (0441)
dlls/user32/resources/oic_winlogo.svg
# the icon of a program without one of its own (IDI_APPLICATION), ours, not a wine glass
dlls/user32/resources/oic_sample.svg
# our own file and folder icons, written by theme/icons.py (0478)
dlls/shell32/resources/folder.svg
dlls/shell32/resources/folder_open.svg
dlls/shell32/resources/document.svg
dlls/shell32/resources/sg_text.svg
programs/notepad/notepad.svg
dlls/shell32/resources/mycomputer.svg
dlls/shell32/resources/desktop.svg
dlls/shell32/resources/mydocs.svg
dlls/shell32/resources/drive.svg
dlls/comctl32/idb_view_small.svg
dlls/comctl32/idb_view_large.svg
