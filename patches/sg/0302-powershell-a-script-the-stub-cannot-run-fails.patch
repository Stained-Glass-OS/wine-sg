+    if (arg[0] != '-' && arg[0] != '/') return FALSE;
+    for (i = 0; i < ARRAY_SIZE(options); i++)
+        if (!wcsicmp(arg + 1, options[i] + 1)) return TRUE;
+    return FALSE;
+}
+
+/* "exit N" alone is a script this stub can run */
+static BOOL is_plain_exit(const WCHAR *script, int *code)
+{
+    const WCHAR *p = script;
+    WCHAR *end;
+
+    while (iswspace(*p)) p++;
+    if (wcsnicmp(p, L"exit", 4)) return FALSE;
+    p += 4;
+    while (iswspace(*p)) p++;
+    if (!*p) { *code = 0; return TRUE; }
+    *code = wcstol(p, &end, 10);
+    if (end == p) return FALSE;
+    while (iswspace(*end) || *end == ';') end++;
+    return !*end;
+}
