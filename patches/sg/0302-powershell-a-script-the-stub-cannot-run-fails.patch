+/* A script-bearing option: what follows it is PowerShell to run. */
+static BOOL is_script_option(const WCHAR *arg)
+{
+    static const WCHAR *options[] = {L"-command", L"-c", L"-file", L"-f", L"-encodedcommand", L"-e", L"-ec"};
+    unsigned int i;
