+#ifndef __WINE_APPEXECLINK_H
+#define __WINE_APPEXECLINK_H
+
+/* A deployed package's app execution alias (appxdeploymentclient writes
+ * them in %LOCALAPPDATA%\Microsoft\WindowsApps). On Windows the file is an
+ * IO_REPARSE_TAG_APPEXECLINK reparse point that CreateProcess follows; here
+ * it is a small UTF-16LE text file: this first line, then
+ *
+ *   PackageFamilyName=<family>
+ *   AppUserModelId=<family>!<application id>
+ *   Target=<the package's executable>
+ *
+ * each ending in CRLF. kernelbase's CreateProcess starts the target, when it
+ * is inside the install location of a package of that family deployed for
+ * the user; shell32 reports the target's executable type. */
+
+#define APPEXECLINK_MAGIC L"\xfeff[Stained Glass AppExecLink]\r\n"
+#define APPEXECLINK_MAX_SIZE 2048   /* bytes */
+
+/* Parse the file's text in place (text must be NUL-terminated). */
+static inline BOOL appexeclink_parse( WCHAR *text, const WCHAR **family, const WCHAR **aumid, const WCHAR **target )
+{
+    static const WCHAR magic[] = APPEXECLINK_MAGIC;
+    WCHAR *line, *next, *p;
+
+    *family = *aumid = *target = NULL;
+    if (wcsncmp( text, magic, ARRAY_SIZE(magic) - 1 )) return FALSE;
+    for (line = text + ARRAY_SIZE(magic) - 1; *line; line = next)
+    {
+        if ((next = wcschr( line, '\n' ))) *next++ = 0;
+        else next = line + wcslen( line );
+        if ((p = wcschr( line, '\r' ))) *p = 0;
+        if (!wcsncmp( line, L"PackageFamilyName=", 18 )) *family = line + 18;
+        else if (!wcsncmp( line, L"AppUserModelId=", 15 )) *aumid = line + 15;
+        else if (!wcsncmp( line, L"Target=", 7 )) *target = line + 7;
+    }
+    return *family && *target && (*target)[0];
+}
+
+#endif /* __WINE_APPEXECLINK_H */
