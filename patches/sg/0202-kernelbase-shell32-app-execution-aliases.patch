+/***********************************************************************
+ *           app_exec_link_target
+ *
+ * An app execution alias starts its package's executable (see
+ * wine/appexeclink.h): only when the target is inside the install location
+ * of a package of the alias's family that is deployed for this user
+ * (appxdeploymentclient's records, as kernelbase's version.c reads them).
+ */
+static BOOL app_exec_link_target( const WCHAR *path, WCHAR *target, DWORD size )
+{
+    static const WCHAR packagesW[] = L"Software\\Wine\\AppModel\\Packages";
+    WCHAR text[APPEXECLINK_MAX_SIZE / sizeof(WCHAR) + 1], name[256], value[MAX_PATH];
+    const WCHAR *family, *aumid, *link;
+    LARGE_INTEGER file_size;
+    DWORD read = 0, index = 0, len, bytes;
+    HANDLE file;
+    BOOL ret = FALSE;
+    HKEY key, sub;
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, 0 );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    if (GetFileSizeEx( file, &file_size ) && file_size.QuadPart <= APPEXECLINK_MAX_SIZE)
+        ReadFile( file, text, file_size.u.LowPart, &read, NULL );
+    CloseHandle( file );
+    text[read / sizeof(WCHAR)] = 0;
+    if (!appexeclink_parse( text, &family, &aumid, &link ) || wcslen( link ) >= size) return FALSE;
+
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, packagesW, 0, KEY_READ, &key ))
+    {
+        while (!ret && (len = ARRAY_SIZE(name), !RegEnumKeyExW( key, index++, name, &len, NULL, NULL, NULL, NULL )))
+        {
+            if (RegOpenKeyExW( key, name, 0, KEY_READ, &sub )) continue;
+            bytes = sizeof(value);
+            if (!RegGetValueW( sub, NULL, L"FamilyName", RRF_RT_REG_SZ, NULL, value, &bytes ) &&
+                !wcsicmp( value, family ))
+            {
+                bytes = sizeof(value);
+                if (!RegGetValueW( sub, NULL, L"InstallLocation", RRF_RT_REG_SZ, NULL, value, &bytes ) &&
+                    (len = wcslen( value )) && !wcsnicmp( link, value, len ) && link[len] == '\\' &&
+                    !wcsstr( link + len, L"\\..\\" ) &&
+                    GetFileAttributesW( link ) != INVALID_FILE_ATTRIBUTES)
+                {
+                    wcscpy( target, link );
+                    ret = TRUE;
+                }
+            }
+            RegCloseKey( sub );
+        }
+        RegCloseKey( key );
+    }
+    TRACE( "%s (%s) -> %s\n", debugstr_w( path ), debugstr_w( aumid ), ret ? debugstr_w( target ) : "(no deployed package)" );
+    return ret;
+}
