From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: an alpha-layered popup shows what is under it

In a virtual desktop every window is a child of the desktop's X window, and
X does not blend a child's alpha with what is under it: an alpha-layered
popup showed its see-through pixels black -- Chrome's menu had a thick black
frame where its shadow is (David). As such a popup is shown, winex11 takes a
copy of what is under it, and puts the popup's pixels blended over that copy,
opaque. The copy is dropped when the popup is hidden or moves.
---
--- a/dlls/winex11.drv/bitblt.c
+++ b/dlls/winex11.drv/bitblt.c
@@ -26,6 +26,7 @@
 #include "config.h"
 
 #include <assert.h>
+#include <pthread.h>
 #include <stdarg.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -1786,6 +1787,154 @@
     }
 }
 
+/* Stained Glass OS: in a virtual desktop every window is a child of the
+ * desktop's X window, and X does not blend a child's alpha with what is under
+ * it: an alpha-layered popup (a menu with a soft shadow -- Chrome's) showed
+ * its see-through pixels black. Such a popup, as it is shown, takes a copy of
+ * what is under it (its backdrop); its pixels are then blended over that copy
+ * and put opaque. The copy is dropped when the popup is hidden or moves. */
+struct backdrop
+{
+    struct list entry;
+    Window      window;
+    int         width, height;
+    DWORD      *bits;           /* width x height, what was under the window */
+};
+
+static struct list backdrops = LIST_INIT( backdrops );
+static pthread_mutex_t backdrop_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static int backdrop_error( Display *display, XErrorEvent *event, void *arg )
+{
+    return 1;
+}
+
+static struct backdrop *find_backdrop( Window window )
+{
+    struct backdrop *bd;
+    LIST_FOR_EACH_ENTRY( bd, &backdrops, struct backdrop, entry )
+        if (bd->window == window) return bd;
+    return NULL;
+}
+
+void drop_window_backdrop( Window window )
+{
+    struct backdrop *bd;
+    pthread_mutex_lock( &backdrop_mutex );
+    if ((bd = find_backdrop( window )))
+    {
+        list_remove( &bd->entry );
+        free( bd->bits );
+        free( bd );
+    }
+    pthread_mutex_unlock( &backdrop_mutex );
+}
+
+/* what is under window, about to be shown at (x, y) of the desktop's X window */
+void take_window_backdrop( Display *display, Window window, int x, int y, int width, int height )
+{
+    struct backdrop *bd;
+    XImage *image = NULL;
+    Window root;
+    int gx, gy, cx0, cy0, cx1, cy1, i, j;
+    unsigned int dw, dh, border, depth;
+
+    drop_window_backdrop( window );
+    TRACE( "take %lx %d,%d %dx%d\n", window, x, y, width, height );
+    if (width <= 0 || height <= 0 || width > 4096 || height > 4096) return;
+    if (!XGetGeometry( display, root_window, &root, &gx, &gy, &dw, &dh, &border, &depth )) return;
+    cx0 = max( x, 0 ); cy0 = max( y, 0 );
+    cx1 = min( x + width, (int)dw ); cy1 = min( y + height, (int)dh );
+    if (!(bd = calloc( 1, sizeof(*bd) ))) return;
+    if (!(bd->bits = calloc( (size_t)width * height, sizeof(DWORD) )))
+    {
+        free( bd );
+        return;
+    }
+    bd->window = window;
+    bd->width = width;
+    bd->height = height;
+    if (cx0 < cx1 && cy0 < cy1)
+    {
+        X11DRV_expect_error( display, backdrop_error, NULL );
+        image = XGetImage( display, root_window, cx0, cy0, cx1 - cx0, cy1 - cy0, AllPlanes, ZPixmap );
+        if (X11DRV_check_error() && image)
+        {
+            XDestroyImage( image );
+            image = NULL;
+        }
+    }
+    if (!image || image->bits_per_pixel != 32)
+    {
+        TRACE( "no image %p bpp %d clip %d,%d-%d,%d\n", image, image ? image->bits_per_pixel : 0, cx0, cy0, cx1, cy1 );
+        if (image) XDestroyImage( image );
+        free( bd->bits );
+        free( bd );
+        return;
+    }
+    for (j = cy0; j < cy1; j++)
+        for (i = cx0; i < cx1; i++)
+            bd->bits[(j - y) * width + (i - x)] = XGetPixel( image, i - cx0, j - cy0 ) & 0xffffff;
+    XDestroyImage( image );
+    TRACE( "window %lx: backdrop %dx%d at %d,%d\n", window, width, height, x, y );
+    pthread_mutex_lock( &backdrop_mutex );
+    list_add_head( &backdrops, &bd->entry );
+    pthread_mutex_unlock( &backdrop_mutex );
+}
+
+/* the dirty part of a surface, blended over its window's backdrop and put opaque */
+static BOOL put_over_backdrop( struct x11drv_window_surface *surface, XImage *ximage, const RECT *rect,
+                               const RECT *dirty )
+{
+    int width = dirty->right - dirty->left, height = dirty->bottom - dirty->top, stride, x, y;
+    struct backdrop *bd;
+    DWORD *buf;
+    XImage *image;
+
+    if (list_empty( &backdrops ) || surface->byteswap || ximage->bits_per_pixel != 32 || width <= 0 || height <= 0)
+        return FALSE;
+    pthread_mutex_lock( &backdrop_mutex );
+    if (!(bd = find_backdrop( surface->window )) || !(buf = malloc( (size_t)width * height * sizeof(DWORD) )))
+    {
+        pthread_mutex_unlock( &backdrop_mutex );
+        return FALSE;
+    }
+    stride = ximage->bytes_per_line / sizeof(DWORD);
+    for (y = 0; y < height; y++)
+    {
+        const DWORD *src = (const DWORD *)ximage->data + (dirty->top + y) * stride + dirty->left;
+        int wy = rect->top + dirty->top + y;
+        for (x = 0; x < width; x++)
+        {
+            DWORD p = src[x], a = p >> 24, b = 0;
+            int wx = rect->left + dirty->left + x;
+            if (wx >= 0 && wy >= 0 && wx < bd->width && wy < bd->height) b = bd->bits[wy * bd->width + wx];
+            if (a == 0xff) buf[y * width + x] = p;
+            else
+            {
+                /* premultiplied: out = src + under * (1 - alpha) */
+                DWORD r = min( 255, ((p >> 16) & 0xff) + ((b >> 16) & 0xff) * (255 - a) / 255 );
+                DWORD g = min( 255, ((p >> 8) & 0xff) + ((b >> 8) & 0xff) * (255 - a) / 255 );
+                DWORD bl = min( 255, (p & 0xff) + (b & 0xff) * (255 - a) / 255 );
+                buf[y * width + x] = 0xff000000 | (r << 16) | (g << 8) | bl;
+            }
+        }
+    }
+    pthread_mutex_unlock( &backdrop_mutex );
+    if (!(image = XCreateImage( gdi_display, argb_visual.visual, ximage->depth, ZPixmap, 0, (char *)buf,
+                                width, height, 32, width * 4 )))
+    {
+        free( buf );
+        return FALSE;
+    }
+    XPutImage( gdi_display, surface->window, surface->gc, image, 0, 0, rect->left + dirty->left,
+               rect->top + dirty->top, width, height );
+    image->data = NULL;
+    XDestroyImage( image );
+    free( buf );
+    return TRUE;
+}
+
 /***********************************************************************
  *           x11drv_surface_flush
  */
@@ -1831,7 +1980,8 @@
                 ptr[x] |= alpha_bits;
     }
 
-    if (!put_shm_image( ximage, &surface->image->shminfo, surface->window, surface->gc, rect, dirty ))
+    if (put_over_backdrop( surface, ximage, rect, dirty )) ;
+    else if (!put_shm_image( ximage, &surface->image->shminfo, surface->window, surface->gc, rect, dirty ))
         XPutImage( gdi_display, surface->window, surface->gc, ximage, dirty->left,
                    dirty->top, rect->left + dirty->left, rect->top + dirty->top,
                    dirty->right - dirty->left, dirty->bottom - dirty->top );
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -1455,6 +1455,7 @@
         changes.x = pt.x;
         changes.y = pt.y;
         mask |= CWX | CWY;
+        drop_window_backdrop( data->whole_window ); /* what is under it is no longer there */
     }
 
     if (above)
@@ -1617,10 +1618,23 @@
     case MAKELONG(WithdrawnState, NormalState):
     case MAKELONG(IconicState, NormalState):
         if (data->embedded) set_xembed_flags( data, XEMBED_MAPPED );
-        else XMapWindow( data->display, data->whole_window );
+        else
+        {
+            /* an alpha-layered popup in a virtual desktop: what is under it, to blend over */
+            if (is_virtual_desktop() && data->layered && !data->managed && data->vis.depth == 32 &&
+                data->whole_window != root_window)
+            {
+                POINT pt = virtual_screen_to_root( data->rects.visible.left, data->rects.visible.top );
+                take_window_backdrop( data->display, data->whole_window, pt.x, pt.y,
+                                      data->rects.visible.right - data->rects.visible.left,
+                                      data->rects.visible.bottom - data->rects.visible.top );
+            }
+            XMapWindow( data->display, data->whole_window );
+        }
         break;
     case MAKELONG(NormalState, WithdrawnState):
     case MAKELONG(IconicState, WithdrawnState):
+        drop_window_backdrop( data->whole_window );
         if (data->embedded) set_xembed_flags( data, 0 );
         else if (!data->managed) XUnmapWindow( data->display, data->whole_window );
         else XWithdrawWindow( data->display, data->whole_window, data->vis.screen );
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -368,6 +368,8 @@
 };
 
 extern BOOL needs_offscreen_rendering( HWND hwnd, BOOL known_child );
+extern void take_window_backdrop( Display *display, Window window, int x, int y, int width, int height );
+extern void drop_window_backdrop( Window window );
 extern void set_dc_drawable( HDC hdc, Drawable drawable, const RECT *rect, int mode );
