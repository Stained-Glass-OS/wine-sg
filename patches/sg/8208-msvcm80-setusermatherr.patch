From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcm80, msvcm90: __setusermatherr_m is the C runtime's; DoDllLanguageSupportValidation quiet.

A C++/CLI module's startup installs its math error handler with __setusermatherr_m; it was a stub, so the
handler was never called and math errors set errno instead. It is now msvcr80's (msvcr90's)
__setusermatherr. DoDllLanguageSupportValidation refuses nothing (the runtime that loaded the module has
accepted it) and no longer warns at every module's start.
---
--- a/dlls/msvcm80/msvcm_main.c
+++ b/dlls/msvcm80/msvcm_main.c
@@ -28,7 +28,10 @@
 /* void __cdecl <CrtImplementationDetails>::DoDllLanguageSupportValidation(void) */
 void __cdecl CrtImplementationDetails_DoDllLanguageSupportValidation(void)
 {
-    FIXME("stub\n");
+    /* Stained Glass OS (wine-sg 8208): the CRT refuses here a module whose language support (native, mixed,
+     * pure) the process cannot load; the runtime that loaded the module has already accepted it, so there
+     * is nothing to refuse, and nothing to warn about at every C++/CLI module's start */
+    TRACE("\n");
 }
 
 /* void __cdecl <CrtImplementationDetails>::RegisterModuleUninitializer(System.EventHandler^) */
@@ -37,12 +40,8 @@
     FIXME("%p: stub\n", handler);
 }
 
-/* handler is a "method" with signature int32 (*handler)(_exception*), but I'm
- * not sure what that means */
-void __cdecl __setusermatherr_m(void *handler)
-{
-    FIXME("%p: stub\n", handler);
-}
+/* __setusermatherr_m: the C runtime's __setusermatherr (msvcm80.spec, msvcm90.spec forward it): the
+ * handler is a function pointer the C++/CLI compiler gives native callers (Stained Glass OS, wine-sg 8208) */
 
 /* void __cdecl <CrtImplementationDetails>::ThrowModuleLoadException(System.String^) */
 void __cdecl CrtImplementationDetails_ThrowModuleLoadException(void* message)
--- a/dlls/msvcm80/msvcm80.spec
+++ b/dlls/msvcm80/msvcm80.spec
@@ -300,7 +300,7 @@
 @ cdecl -arch=win64 ?setw@std@@YA?AU?$_Smanip@_J@1@_J@Z(ptr long) msvcp80.?setw@std@@YA?AU?$_Smanip@_J@1@_J@Z
 @ cdecl ?signal@@YAP6MXH@ZHH@Z(long long) msvcr80.signal
 @ cdecl ?signal@@YAP6MXH@ZHP6MXH@Z@Z(long long) msvcr80.signal
-@ cdecl __setusermatherr_m(ptr)
+@ cdecl __setusermatherr_m(ptr) msvcr80.__setusermatherr
 @ cdecl towctrans(long long) msvcp80.towctrans
 @ cdecl wctrans(str) msvcp80.wctrans
 @ cdecl wctype(str) msvcp80.wctype
--- a/dlls/msvcm90/msvcm90.spec
+++ b/dlls/msvcm90/msvcm90.spec
@@ -175,7 +175,7 @@
 @ cdecl -arch=win64 ?setw@std@@YA?AU?$_Smanip@_J@1@_J@Z(ptr long) msvcp90.?setw@std@@YA?AU?$_Smanip@_J@1@_J@Z
 @ cdecl ?signal@@YAP6MXH@ZHH@Z(long long) msvcr90.signal
 @ cdecl ?signal@@YAP6MXH@ZHP6MXH@Z@Z(long long) msvcr90.signal
-@ cdecl __setusermatherr_m(ptr)
+@ cdecl __setusermatherr_m(ptr) msvcr90.__setusermatherr
 @ cdecl towctrans(long long) msvcp90.towctrans
 @ cdecl wctrans(str) msvcp90.wctrans
 @ cdecl wctype(str) msvcp90.wctype
