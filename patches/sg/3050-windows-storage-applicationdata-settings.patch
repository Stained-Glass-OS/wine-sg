+static HRESULT WINAPI obs_add_MapChanged( IObservableMap_HSTRING_IInspectable *iface,
+        IMapChangedEventHandler_HSTRING_IInspectable *handler, EventRegistrationToken *token )
+{
+    struct property_set *impl = impl_from_IObservableMap( iface );
+    struct handler *entry;
+
+    if (!handler || !token) return E_POINTER;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    IMapChangedEventHandler_HSTRING_IInspectable_AddRef( (entry->handler = handler) );
+    EnterCriticalSection( &impl->cs );
+    entry->token.value = ++impl->next_token;
+    *token = entry->token;
+    list_add_tail( &impl->handlers, &entry->entry );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+static HRESULT WINAPI obs_remove_MapChanged( IObservableMap_HSTRING_IInspectable *iface, EventRegistrationToken token )
+{
+    struct property_set *impl = impl_from_IObservableMap( iface );
+    struct handler *entry;
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( entry, &impl->handlers, struct handler, entry )
+    {
+        if (entry->token.value == token.value)
+        {
+            list_remove( &entry->entry );
+            LeaveCriticalSection( &impl->cs );
+            IMapChangedEventHandler_HSTRING_IInspectable_Release( entry->handler );
+            free( entry );
+            return S_OK;
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
