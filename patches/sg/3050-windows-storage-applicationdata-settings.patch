+        args->change = change;
+        WindowsDuplicateString( key, &args->key );
+        for (i = 0; i < n; i++)
+            IMapChangedEventHandler_HSTRING_IInspectable_Invoke( copies[i], (IObservableMap_HSTRING_IInspectable *)&impl->IObservableMap_iface,
+                                                               &args->IMapChangedEventArgs_iface );
+        IMapChangedEventArgs_HSTRING_Release( &args->IMapChangedEventArgs_iface );
+    }
+    for (i = 0; i < n; i++) IMapChangedEventHandler_HSTRING_IInspectable_Release( copies[i] );
+    free( copies );
+}
+
+/* Reads every value into a snapshot. */
+static HRESULT read_entries( struct property_set *impl, struct entry **out, UINT *count )
+{
+    DWORD i, max_name, max_data, n = 0;
+    struct entry *entries = NULL;
+    HKEY key;
+    WCHAR *name;
+    BYTE *data;
+
+    *out = NULL;
+    *count = 0;
+    if (!(key = open_set_key( impl, FALSE, KEY_QUERY_VALUE ))) return S_OK;
+    if (RegQueryInfoKeyW( key, NULL, NULL, NULL, NULL, NULL, NULL, &n, &max_name, &max_data, NULL, NULL ) || !n)
+    {
+        RegCloseKey( key );
+        return S_OK;
+    }
+    name = malloc( (max_name + 1) * sizeof(WCHAR) );
+    data = malloc( max_data ? max_data : 1 );
+    entries = calloc( n, sizeof(*entries) );
+    if (!name || !data || !entries)
+    {
+        free( name ); free( data ); free( entries );
+        RegCloseKey( key );
+        return E_OUTOFMEMORY;
+    }
+    *count = 0;
+    for (i = 0; i < n; i++)
+    {
+        DWORD name_len = max_name + 1, size = max_data, type;
+        IInspectable *value;
+
+        if (RegEnumValueW( key, i, name, &name_len, NULL, &type, data, &size ) || type != REG_BINARY) continue;
+        if (FAILED( blob_to_value( data, size, &value ) )) continue;
+        if (FAILED( WindowsCreateString( name, name_len, &entries[*count].key ) ))
+        {
+            IInspectable_Release( value );
+            continue;
+        }
+        entries[(*count)++].value = (IUnknown *)value;
+    }
+    free( name );
+    free( data );
+    RegCloseKey( key );
+    *out = entries;
+    return S_OK;
+}
+
+static void free_entries( struct entry *entries, UINT count )
+{
+    UINT i;
+
+    for (i = 0; i < count; i++)
+    {
+        WindowsDeleteString( entries[i].key );
+        if (entries[i].value) IUnknown_Release( entries[i].value );
+    }
+    free( entries );
+}
