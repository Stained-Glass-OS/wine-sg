+
+    /* containers */
+    WindowsCreateString( L"child", 5, &name_str );
+    hr = IApplicationDataContainer_CreateContainer( settings, name_str, ApplicationDataCreateDisposition_Existing, &child );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+    hr = IApplicationDataContainer_CreateContainer( settings, name_str, ApplicationDataCreateDisposition_Always, &child );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IApplicationDataContainer_get_Name( child, &str );
+    ok( hr == S_OK && !wcscmp( WindowsGetStringRawBuffer( str, NULL ), L"child" ), "got hr %#lx.\n", hr );
+    WindowsDeleteString( str );
+    IApplicationDataContainer_Release( child );
+    hr = IApplicationDataContainer_get_Containers( settings, &containers );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IMapView_HSTRING_ApplicationDataContainer_get_Size( containers, &size );
+    ok( hr == S_OK && size == 1, "got hr %#lx, size %u.\n", hr, size );
+    IMapView_HSTRING_ApplicationDataContainer_Release( containers );
+    hr = IApplicationDataContainer_DeleteContainer( settings, name_str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IApplicationDataContainer_get_Containers( settings, &containers );
+    IMapView_HSTRING_ApplicationDataContainer_get_Size( containers, &size );
+    ok( size == 0, "got size %u.\n", size );
+    IMapView_HSTRING_ApplicationDataContainer_Release( containers );
+    WindowsDeleteString( name_str );
+
+    /* clearing removes the settings */
+    hr = IApplicationData_ClearAsync( data, ApplicationDataLocality_Local, &action );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IAsyncAction_Release( action );
+    hr = IMap_HSTRING_IInspectable_get_Size( map, &size );
+    ok( hr == S_OK && size == 0, "got hr %#lx, size %u.\n", hr, size );
+    hr = IApplicationData_ClearAsync( data, 77, &action );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+
+    WindowsDeleteString( key );
+    WindowsDeleteString( key2 );
+    IPropertyValueStatics_Release( value_statics );
+    IIterable_IKeyValuePair_HSTRING_IInspectable_Release( iterable );
+    IObservableMap_HSTRING_IInspectable_Release( observable );
+    IMap_HSTRING_IInspectable_Release( map );
+    IPropertySet_Release( values );
+    IApplicationDataContainer_Release( settings );
+    IApplicationData_Release( data );
+    IApplicationDataStatics_Release( statics );
+}
+
+static void run_packaged_child(void)
+{
+    PROCESS_INFORMATION info;
+    STARTUPINFOA startup = { sizeof(startup) };
+    char path[MAX_PATH], cmd[MAX_PATH + 16], dir[MAX_PATH];
+    WCHAR wdir[MAX_PATH];
+    DWORD code = 1;
+    HKEY key;
+    BOOL ret;
+    char *p;
+
+    GetModuleFileNameA( NULL, path, sizeof(path) );
+    strcpy( dir, path );
+    if ((p = strrchr( dir, '\\' ))) *p = 0;
+    MultiByteToWideChar( CP_ACP, 0, dir, -1, wdir, ARRAY_SIZE(wdir) );
+
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, test_package_key, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL ))
+    {
+        skip( "cannot register a test package\n" );
+        return;
+    }
+    RegSetValueExW( key, L"InstallLocation", 0, REG_SZ, (BYTE *)wdir, (wcslen( wdir ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+
+    sprintf( cmd, "\"%s\" data packaged", path );
+    ret = CreateProcessA( NULL, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &startup, &info );
+    ok( ret, "CreateProcess failed, error %lu.\n", GetLastError() );
+    if (ret)
+    {
+        WaitForSingleObject( info.hProcess, 30000 );
+        GetExitCodeProcess( info.hProcess, &code );
+        ok( !code, "the packaged child failed with %lu.\n", code );
+        CloseHandle( info.hProcess );
+        CloseHandle( info.hThread );
+    }
+    RegDeleteTreeW( HKEY_CURRENT_USER, test_package_key );
+    RegDeleteTreeW( HKEY_CURRENT_USER, L"Software\\Wine\\ApplicationData\\Wine.DataTest_8wekyb3d8bbwe" );
+}
+
 START_TEST(data)
 {
     HRESULT hr;
+    char **argv;
+    int argc = winetest_get_mainargs( &argv );
 
     hr = RoInitialize( RO_INIT_MULTITHREADED );
     ok( hr == S_OK, "RoInitialize failed, hr %#lx\n", hr );
 
+    if (argc > 2 && !strcmp( argv[2], "packaged" ))
+    {
+        test_packaged_data();
+        RoUninitialize();
+        return;
+    }
+
     test_ApplicationDataStatics();
+    run_packaged_child();
 
     RoUninitialize();
 }
