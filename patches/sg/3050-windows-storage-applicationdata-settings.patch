+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IPropertySet_QueryInterface( values, &IID_IMap_HSTRING_IInspectable, (void **)&map );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IPropertySet_QueryInterface( values, &IID_IObservableMap_HSTRING_IInspectable, (void **)&observable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IPropertySet_QueryInterface( values, &IID_IIterable_IKeyValuePair_HSTRING_IInspectable, (void **)&iterable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    hr = IObservableMap_HSTRING_IInspectable_add_MapChanged( observable, (IMapChangedEventHandler_HSTRING_IInspectable *)&map_handler, &token2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    WindowsCreateString( L"count", 5, &key );
+    WindowsCreateString( L"title", 5, &key2 );
+    WindowsCreateString( L"Windows.Foundation.PropertyValue", 32, &str );
+    hr = RoGetActivationFactory( str, &IID_IPropertyValueStatics, (void **)&value_statics );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    IMap_HSTRING_IInspectable_Clear( map );
+    map_handler.calls = 0;
+
+    hr = IPropertyValueStatics_CreateInt32( value_statics, 42, &boxed );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    replaced = TRUE;
+    hr = IMap_HSTRING_IInspectable_Insert( map, key, boxed, &replaced );
+    ok( hr == S_OK && !replaced, "got hr %#lx, replaced %d.\n", hr, replaced );
+    ok( map_handler.calls == 1 && map_handler.last_arg == CollectionChange_ItemInserted, "got %d calls, change %d.\n",
+        map_handler.calls, map_handler.last_arg );
+    IInspectable_Release( boxed );
+    hr = IPropertyValueStatics_CreateInt32( value_statics, 43, &boxed );
+    hr = IMap_HSTRING_IInspectable_Insert( map, key, boxed, &replaced );
+    ok( hr == S_OK && replaced, "got hr %#lx, replaced %d.\n", hr, replaced );
+    ok( map_handler.last_arg == CollectionChange_ItemChanged, "got change %d.\n", map_handler.last_arg );
+    IInspectable_Release( boxed );
+
+    WindowsCreateString( L"hello", 5, &str );
+    IPropertyValueStatics_CreateString( value_statics, str, &boxed );
+    WindowsDeleteString( str );
+    hr = IMap_HSTRING_IInspectable_Insert( map, key2, boxed, &replaced );
+    ok( hr == S_OK && !replaced, "got hr %#lx.\n", hr );
+    IInspectable_Release( boxed );
+
+    hr = IMap_HSTRING_IInspectable_get_Size( map, &size );
+    ok( hr == S_OK && size == 2, "got hr %#lx, size %u.\n", hr, size );
+    hr = IMap_HSTRING_IInspectable_HasKey( map, key, &found );
+    ok( hr == S_OK && found, "got hr %#lx.\n", hr );
+
+    hr = IMap_HSTRING_IInspectable_Lookup( map, key, &got );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IInspectable_QueryInterface( got, &IID_IPropertyValue, (void **)&property_value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    i32 = 0;
+    hr = IPropertyValue_GetInt32( property_value, &i32 );
+    ok( hr == S_OK && i32 == 43, "got hr %#lx, value %d.\n", hr, i32 );
