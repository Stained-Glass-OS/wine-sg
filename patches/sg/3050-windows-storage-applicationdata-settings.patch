+    hr = IMap_HSTRING_IInspectable_Lookup( map, key, &got );
+    ok( hr == 0x8000000b && !got, "got hr %#lx.\n", hr );
+    hr = IObservableMap_HSTRING_IInspectable_remove_MapChanged( observable, token2 );
