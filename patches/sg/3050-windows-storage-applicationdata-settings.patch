+#pragma pack(push, 1)
+struct stored_value
+{
+    UINT32 type;
+    BYTE data[1];
+};
+#pragma pack(pop)
+
+/* Serializes a boxed value. The caller frees *blob. */
+static HRESULT value_to_blob( IInspectable *value, BYTE **blob, DWORD *size )
+{
+    IPropertyValue *pv;
+    PropertyType type;
+    struct stored_value *sv;
+    HRESULT hr;
+    UINT32 data_size = 0;
+    union
+    {
+        BYTE u8; INT16 i16; UINT16 u16; INT32 i32; UINT32 u32; INT64 i64; UINT64 u64; FLOAT f; DOUBLE d;
+        WCHAR ch; boolean b; GUID guid; DateTime dt; TimeSpan ts;
+    } v;
+    HSTRING str = NULL;
+    const WCHAR *chars = NULL;
+    UINT32 chars_len = 0;
+
+    if (!value) return E_INVALIDARG;
+    if (FAILED( hr = IInspectable_QueryInterface( value, &IID_IPropertyValue, (void **)&pv ) )) return E_INVALIDARG;
+    if (FAILED( hr = IPropertyValue_get_Type( pv, &type ) )) goto done;
+
+    switch (type)
+    {
+    case PropertyType_UInt8: hr = IPropertyValue_GetUInt8( pv, &v.u8 ); data_size = 1; break;
+    case PropertyType_Int16: hr = IPropertyValue_GetInt16( pv, &v.i16 ); data_size = 2; break;
+    case PropertyType_UInt16: hr = IPropertyValue_GetUInt16( pv, &v.u16 ); data_size = 2; break;
+    case PropertyType_Int32: hr = IPropertyValue_GetInt32( pv, &v.i32 ); data_size = 4; break;
+    case PropertyType_UInt32: hr = IPropertyValue_GetUInt32( pv, &v.u32 ); data_size = 4; break;
+    case PropertyType_Int64: hr = IPropertyValue_GetInt64( pv, &v.i64 ); data_size = 8; break;
+    case PropertyType_UInt64: hr = IPropertyValue_GetUInt64( pv, &v.u64 ); data_size = 8; break;
+    case PropertyType_Single: hr = IPropertyValue_GetSingle( pv, &v.f ); data_size = 4; break;
+    case PropertyType_Double: hr = IPropertyValue_GetDouble( pv, &v.d ); data_size = 8; break;
+    case PropertyType_Char16: hr = IPropertyValue_GetChar16( pv, &v.ch ); data_size = 2; break;
+    case PropertyType_Boolean: hr = IPropertyValue_GetBoolean( pv, &v.b ); data_size = 1; break;
+    case PropertyType_Guid: hr = IPropertyValue_GetGuid( pv, &v.guid ); data_size = sizeof(GUID); break;
+    case PropertyType_DateTime: hr = IPropertyValue_GetDateTime( pv, &v.dt ); data_size = 8; break;
+    case PropertyType_TimeSpan: hr = IPropertyValue_GetTimeSpan( pv, &v.ts ); data_size = 8; break;
+    case PropertyType_String:
+        if (SUCCEEDED( hr = IPropertyValue_GetString( pv, &str ) ))
+        {
+            chars = WindowsGetStringRawBuffer( str, &chars_len );
+            data_size = chars_len * sizeof(WCHAR);
+        }
+        break;
+    default:
+        hr = E_INVALIDARG; /* only simple types can be stored */
+        break;
+    }
+    if (FAILED( hr )) goto done;
+
+    if (!(sv = malloc( offsetof(struct stored_value, data[data_size]) )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    sv->type = type;
+    if (str) memcpy( sv->data, chars, data_size );
+    else memcpy( sv->data, &v, data_size );
+    *blob = (BYTE *)sv;
+    *size = offsetof(struct stored_value, data[data_size]);
+    hr = S_OK;
+
+done:
+    WindowsDeleteString( str );
+    IPropertyValue_Release( pv );
+    return hr;
+}
+
+static HRESULT blob_to_value( const BYTE *blob, DWORD size, IInspectable **out )
+{
+    const struct stored_value *sv = (const struct stored_value *)blob;
+    IPropertyValueStatics *statics;
+    UINT32 data_size;
+    HRESULT hr;
+    HSTRING str;
+    const BYTE *d;
+
+    if (size < offsetof(struct stored_value, data)) return E_FAIL;
+    if (FAILED( hr = get_value_statics( &statics ) )) return hr;
+    data_size = size - offsetof(struct stored_value, data);
+    d = sv->data;
+
+#define CASE( t, n, T, args ) \
+    case t: if (data_size != n) return E_FAIL; return IPropertyValueStatics_Create##T args
+
+    switch (sv->type)
+    {
+    CASE( PropertyType_UInt8, 1, UInt8, ( statics, *d, out ) );
+    CASE( PropertyType_Int16, 2, Int16, ( statics, *(INT16 *)d, out ) );
+    CASE( PropertyType_UInt16, 2, UInt16, ( statics, *(UINT16 *)d, out ) );
+    CASE( PropertyType_Int32, 4, Int32, ( statics, *(INT32 *)d, out ) );
+    CASE( PropertyType_UInt32, 4, UInt32, ( statics, *(UINT32 *)d, out ) );
+    CASE( PropertyType_Int64, 8, Int64, ( statics, *(INT64 *)d, out ) );
+    CASE( PropertyType_UInt64, 8, UInt64, ( statics, *(UINT64 *)d, out ) );
+    CASE( PropertyType_Single, 4, Single, ( statics, *(FLOAT *)d, out ) );
+    CASE( PropertyType_Double, 8, Double, ( statics, *(DOUBLE *)d, out ) );
+    CASE( PropertyType_Char16, 2, Char16, ( statics, *(WCHAR *)d, out ) );
+    CASE( PropertyType_Boolean, 1, Boolean, ( statics, *d != 0, out ) );
+    CASE( PropertyType_Guid, sizeof(GUID), Guid, ( statics, *(GUID *)d, out ) );
+    CASE( PropertyType_DateTime, 8, DateTime, ( statics, *(DateTime *)d, out ) );
+    CASE( PropertyType_TimeSpan, 8, TimeSpan, ( statics, *(TimeSpan *)d, out ) );
+    case PropertyType_String:
+        if (FAILED( hr = WindowsCreateString( (const WCHAR *)d, data_size / sizeof(WCHAR), &str ) )) return hr;
+        hr = IPropertyValueStatics_CreateString( statics, str, out );
+        WindowsDeleteString( str );
+        return hr;
+    default:
+        return E_FAIL;
+    }
+#undef CASE
+}
