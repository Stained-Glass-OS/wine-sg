+static HRESULT snapshot_qi( struct snapshot *impl, const IID *iid, const IID *own_iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, own_iid ))
+    {
+        *out = &impl->lpVtbl;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG snapshot_addref( struct snapshot *impl )
+{
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG snapshot_release( struct snapshot *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++)
+        {
+            WindowsDeleteString( impl->entries[i].key );
+            if (impl->entries[i].value) IUnknown_Release( impl->entries[i].value );
+        }
+        free( impl->entries );
+        free( impl );
+    }
+    return ref;
