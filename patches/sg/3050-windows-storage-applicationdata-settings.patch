+static BOOL valid_key( HSTRING key )
+{
+    UINT32 len;
+    const WCHAR *str = WindowsGetStringRawBuffer( key, &len );
+
+    return str && len && len <= 255;
+}
+
+static HRESULT WINAPI map_Lookup( IMap_HSTRING_IInspectable *iface, HSTRING key, IInspectable **value )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    DWORD size = 0, type;
+    HRESULT hr = E_BOUNDS_HR;
+    HKEY reg;
+    BYTE *data;
+
+    TRACE( "iface %p, key %s, value %p.\n", iface, debugstr_hstring( key ), value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!valid_key( key )) return E_INVALIDARG;
+
+    if (!(reg = open_set_key( impl, FALSE, KEY_QUERY_VALUE ))) return E_BOUNDS_HR;
+    if (!RegQueryValueExW( reg, WindowsGetStringRawBuffer( key, NULL ), NULL, &type, NULL, &size ) && type == REG_BINARY &&
+        (data = malloc( size )))
+    {
+        if (!RegQueryValueExW( reg, WindowsGetStringRawBuffer( key, NULL ), NULL, &type, data, &size ))
+            hr = blob_to_value( data, size, value );
+        free( data );
+    }
+    RegCloseKey( reg );
+    return hr;
+}
+
+static HRESULT WINAPI map_get_Size( IMap_HSTRING_IInspectable *iface, UINT32 *size )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    struct entry *entries;
+    UINT count;
+    HRESULT hr;
+
+    if (!size) return E_POINTER;
+    if (SUCCEEDED( hr = read_entries( impl, &entries, &count ) ))
+    {
+        *size = count;
+        free_entries( entries, count );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI map_HasKey( IMap_HSTRING_IInspectable *iface, HSTRING key, boolean *found )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    HKEY reg;
+    DWORD type;
+
+    if (!found) return E_POINTER;
+    *found = FALSE;
+    if (!valid_key( key )) return E_INVALIDARG;
+    if ((reg = open_set_key( impl, FALSE, KEY_QUERY_VALUE )))
+    {
+        *found = !RegQueryValueExW( reg, WindowsGetStringRawBuffer( key, NULL ), NULL, &type, NULL, NULL ) && type == REG_BINARY;
+        RegCloseKey( reg );
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI map_GetView( IMap_HSTRING_IInspectable *iface, IMapView_HSTRING_IInspectable **view )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    struct entry *entries;
+    UINT count;
+    HRESULT hr;
+
+    if (!view) return E_POINTER;
+    if (FAILED( hr = read_entries( impl, &entries, &count ) )) return hr;
+    hr = snapshot_create( view_vtbl, &inspectable_kind, entries, count, 0, (void **)view );
+    free_entries( entries, count );
+    return hr;
+}
+
+static HRESULT WINAPI map_Insert( IMap_HSTRING_IInspectable *iface, HSTRING key, IInspectable *value, boolean *replaced )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    boolean existed = FALSE;
+    BYTE *blob;
+    DWORD size;
+    HRESULT hr;
+    HKEY reg;
+    LONG err;
+
+    TRACE( "iface %p, key %s, value %p, replaced %p.\n", iface, debugstr_hstring( key ), value, replaced );
+
+    if (!replaced) return E_POINTER;
+    if (!valid_key( key )) return E_INVALIDARG;
+    if (FAILED( hr = value_to_blob( value, &blob, &size ) )) return hr;
+
+    map_HasKey( iface, key, &existed );
+    if (!(reg = open_set_key( impl, TRUE, KEY_SET_VALUE )))
+    {
+        free( blob );
+        return HRESULT_FROM_WIN32( ERROR_ACCESS_DENIED );
+    }
+    err = RegSetValueExW( reg, WindowsGetStringRawBuffer( key, NULL ), 0, REG_BINARY, blob, size );
+    RegCloseKey( reg );
+    free( blob );
+    if (err) return HRESULT_FROM_WIN32( err );
+
+    *replaced = existed;
+    notify( impl, existed ? CollectionChange_ItemChanged : CollectionChange_ItemInserted, key );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_Remove( IMap_HSTRING_IInspectable *iface, HSTRING key )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    boolean existed = FALSE;
+    HKEY reg;
+
+    TRACE( "iface %p, key %s.\n", iface, debugstr_hstring( key ) );
+
+    if (!valid_key( key )) return E_INVALIDARG;
+    map_HasKey( iface, key, &existed );
+    if (!existed || !(reg = open_set_key( impl, FALSE, KEY_SET_VALUE ))) return E_BOUNDS_HR;
+    RegDeleteValueW( reg, WindowsGetStringRawBuffer( key, NULL ) );
+    RegCloseKey( reg );
+    notify( impl, CollectionChange_ItemRemoved, key );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_Clear( IMap_HSTRING_IInspectable *iface )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    struct entry *entries;
+    UINT count, i;
+    HKEY reg;
+    HSTRING empty = NULL;
+
+    TRACE( "iface %p.\n", iface );
+
+    read_entries( impl, &entries, &count );
+    if ((reg = open_set_key( impl, FALSE, KEY_SET_VALUE )))
+    {
+        for (i = 0; i < count; i++) RegDeleteValueW( reg, WindowsGetStringRawBuffer( entries[i].key, NULL ) );
+        RegCloseKey( reg );
+    }
+    free_entries( entries, count );
+    notify( impl, CollectionChange_Reset, empty );
+    return S_OK;
+}
