+/* ---- ApplicationDataContainer ---- */
+
+struct container
+{
+    IApplicationDataContainer IApplicationDataContainer_iface;
+    LONG ref;
+    ApplicationDataLocality locality;
+    WCHAR *path; /* below HKEY_CURRENT_USER */
+    WCHAR *name;
+};
