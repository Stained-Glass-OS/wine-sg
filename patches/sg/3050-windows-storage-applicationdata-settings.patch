+/* Deletes the contents of a package folder, never following links. */
+static void clear_directory( const WCHAR *dir )
+{
+    WIN32_FIND_DATAW data;
+    WCHAR pattern[MAX_PATH], path[MAX_PATH];
+    HANDLE find;
+
+    swprintf( pattern, ARRAY_SIZE(pattern), L"%ls\\*", dir );
+    if ((find = FindFirstFileW( pattern, &data )) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (!wcscmp( data.cFileName, L"." ) || !wcscmp( data.cFileName, L".." )) continue;
+        swprintf( path, ARRAY_SIZE(path), L"%ls\\%ls", dir, data.cFileName );
+        if ((data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) && !(data.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT))
+        {
+            clear_directory( path );
+            RemoveDirectoryW( path );
+        }
+        else if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) RemoveDirectoryW( path );
+        else DeleteFileW( path );
+    } while (FindNextFileW( find, &data ));
+    FindClose( find );
+}
