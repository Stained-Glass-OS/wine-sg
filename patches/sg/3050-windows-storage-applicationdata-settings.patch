+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI container_get_Name( IApplicationDataContainer *iface, HSTRING *value )
+{
+    struct container *impl = impl_from_IApplicationDataContainer( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    return WindowsCreateString( impl->name, wcslen( impl->name ), value );
+}
+
+static HRESULT WINAPI container_get_Locality( IApplicationDataContainer *iface, ApplicationDataLocality *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl_from_IApplicationDataContainer( iface )->locality;
+    return S_OK;
+}
+
+static HRESULT WINAPI container_get_Values( IApplicationDataContainer *iface, IPropertySet **value )
+{
+    struct container *impl = impl_from_IApplicationDataContainer( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    return property_set_create( impl->path, value );
+}
+
+static HRESULT WINAPI container_get_Containers( IApplicationDataContainer *iface, IMapView_HSTRING_ApplicationDataContainer **value )
+{
+    struct container *impl = impl_from_IApplicationDataContainer( iface );
+    WCHAR name[256];
+    HSTRING *names = NULL;
+    IUnknown **containers = NULL;
+    UINT count = 0, i;
+    HRESULT hr = S_OK;
+    HKEY key;
+    DWORD index, len, subkeys = 0;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, impl->path, 0, KEY_ENUMERATE_SUB_KEYS | KEY_QUERY_VALUE, &key ))
+    {
+        RegQueryInfoKeyW( key, NULL, NULL, NULL, &subkeys, NULL, NULL, NULL, NULL, NULL, NULL, NULL );
+        if (subkeys)
+        {
+            names = calloc( subkeys, sizeof(*names) );
+            containers = calloc( subkeys, sizeof(*containers) );
+        }
+        if (subkeys && (!names || !containers)) hr = E_OUTOFMEMORY;
+        for (index = 0; hr == S_OK && index < subkeys; index++)
+        {
+            WCHAR path[MAX_PATH];
+
+            len = ARRAY_SIZE(name);
+            if (RegEnumKeyExW( key, index, name, &len, NULL, NULL, NULL, NULL )) break;
+            swprintf( path, ARRAY_SIZE(path), L"%ls\\%ls", impl->path, name );
+            if (FAILED(hr = WindowsCreateString( name, len, &names[count] ))) break;
+            if (FAILED(hr = container_create( impl->locality, path, name, (IApplicationDataContainer **)&containers[count] )))
+            {
+                WindowsDeleteString( names[count] );
+                break;
+            }
+            count++;
+        }
+        RegCloseKey( key );
+    }
+
+    if (SUCCEEDED(hr)) hr = container_view_create( names, containers, count, (void **)value );
+    for (i = 0; i < count; i++)
+    {
+        WindowsDeleteString( names[i] );
+        IUnknown_Release( containers[i] );
+    }
+    free( names );
+    free( containers );
+    return hr;
+}
+
+static BOOL valid_container_name( const WCHAR *name, UINT32 len )
+{
+    UINT32 i;
+
+    if (!len || len > 255) return FALSE;
+    for (i = 0; i < len; i++)
+        if (name[i] == '\\' || name[i] == '/' || name[i] < ' ') return FALSE;
+    return TRUE;
+}
+
+static HRESULT WINAPI container_CreateContainer( IApplicationDataContainer *iface, HSTRING name,
+                                                 ApplicationDataCreateDisposition disposition,
+                                                 IApplicationDataContainer **container )
+{
+    struct container *impl = impl_from_IApplicationDataContainer( iface );
+    WCHAR path[MAX_PATH];
+    UINT32 len;
+    const WCHAR *str = WindowsGetStringRawBuffer( name, &len );
+    HKEY key;
+    LONG err;
+
+    TRACE( "iface %p, name %s, disposition %d, container %p.\n", iface, debugstr_hstring( name ), disposition, container );
+
+    if (!container) return E_POINTER;
+    *container = NULL;
+    if (!valid_container_name( str, len ) || len + wcslen( impl->path ) + 2 >= ARRAY_SIZE(path)) return E_INVALIDARG;
+    if (disposition != ApplicationDataCreateDisposition_Always && disposition != ApplicationDataCreateDisposition_Existing) return E_INVALIDARG;
+
+    swprintf( path, ARRAY_SIZE(path), L"%ls\\%ls", impl->path, str );
+    if (disposition == ApplicationDataCreateDisposition_Existing)
+    {
+        if ((err = RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_QUERY_VALUE, &key ))) return HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+    }
+    else if ((err = RegCreateKeyExW( HKEY_CURRENT_USER, path, 0, NULL, 0, KEY_QUERY_VALUE, NULL, &key, NULL )))
+        return HRESULT_FROM_WIN32( err );
+    RegCloseKey( key );
+    return container_create( impl->locality, path, str, container );
+}
+
+static HRESULT WINAPI container_DeleteContainer( IApplicationDataContainer *iface, HSTRING name )
+{
+    struct container *impl = impl_from_IApplicationDataContainer( iface );
+    WCHAR path[MAX_PATH];
+    UINT32 len;
+    const WCHAR *str = WindowsGetStringRawBuffer( name, &len );
+
+    TRACE( "iface %p, name %s.\n", iface, debugstr_hstring( name ) );
+
+    if (!valid_container_name( str, len ) || len + wcslen( impl->path ) + 2 >= ARRAY_SIZE(path)) return E_INVALIDARG;
+    swprintf( path, ARRAY_SIZE(path), L"%ls\\%ls", impl->path, str );
+    RegDeleteTreeW( HKEY_CURRENT_USER, path ); /* deleting a container that is not there is not an error */
+    return S_OK;
+}
+
+static const IApplicationDataContainerVtbl container_vtbl =
+{
+    container_QueryInterface,
+    container_AddRef,
+    container_Release,
+    /* IInspectable methods */
+    container_GetIids,
+    container_GetRuntimeClassName,
+    container_GetTrustLevel,
+    /* IApplicationDataContainer methods */
+    container_get_Name,
+    container_get_Locality,
+    container_get_Values,
+    container_get_Containers,
+    container_CreateContainer,
+    container_DeleteContainer,
+};
+
+static HRESULT container_create( ApplicationDataLocality locality, const WCHAR *path, const WCHAR *name,
+                                 IApplicationDataContainer **out )
+{
+    struct container *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IApplicationDataContainer_iface.lpVtbl = &container_vtbl;
+    impl->ref = 1;
+    impl->locality = locality;
+    if (!(impl->path = wcsdup( path )) || !(impl->name = wcsdup( name )))
+    {
+        free( impl->path );
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    *out = &impl->IApplicationDataContainer_iface;
+    return S_OK;
+}
