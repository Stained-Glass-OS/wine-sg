+static IPropertyValueStatics *value_statics;
+
+static HRESULT get_value_statics( IPropertyValueStatics **out )
+{
+    IPropertyValueStatics *statics;
+    HSTRING name;
+    HRESULT hr;
+
+    if ((statics = value_statics)) { *out = statics; return S_OK; }
+    if (FAILED( hr = WindowsCreateString( RuntimeClass_Windows_Foundation_PropertyValue,
+                wcslen( RuntimeClass_Windows_Foundation_PropertyValue ), &name ) )) return hr;
+    hr = RoGetActivationFactory( name, &IID_IPropertyValueStatics, (void **)&statics );
+    WindowsDeleteString( name );
+    if (FAILED( hr )) return hr;
+    if (InterlockedCompareExchangePointer( (void **)&value_statics, statics, NULL )) IPropertyValueStatics_Release( statics );
+    *out = value_statics;
+    return S_OK;
+}
