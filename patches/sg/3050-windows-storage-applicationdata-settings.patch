+    IPropertyValue_Release( property_value );
+    IInspectable_Release( got );
+
+    /* a second set sees the same registry values, enumeration and views */
+    hr = IIterable_IKeyValuePair_HSTRING_IInspectable_First( iterable, &iterator );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    has = FALSE;
+    hr = IIterator_IKeyValuePair_HSTRING_IInspectable_get_HasCurrent( iterator, &has );
+    ok( hr == S_OK && has, "got hr %#lx.\n", hr );
+    hr = IIterator_IKeyValuePair_HSTRING_IInspectable_get_Current( iterator, &pair );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IKeyValuePair_HSTRING_IInspectable_get_Key( pair, &str );
+    ok( hr == S_OK && (!wcscmp( WindowsGetStringRawBuffer( str, NULL ), L"count" ) ||
