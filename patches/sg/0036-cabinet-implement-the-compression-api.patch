+/*
+ * Compression API (compressapi.h)
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Buffer mode frames the data: a 24-byte header, then chunks, each a 32-bit
+ * compressed size and the compressed data, each expanding to the chunk size
+ * but the last. The header is
+ *
+ *   0  0x0a 0x51 0xe5 0xc0   signature
+ *   4  0x18                  header size
+ *   5  0
+ *   6  checksum              low byte of the CRC-32 of the other 23 bytes
+ *   7  algorithm
+ *   8  uncompressed size     64-bit
+ *  16  chunk size            64-bit
+ *
+ * An MSZIP chunk is a series of blocks, each "CK" and a raw deflate stream of
+ * at most 32 KiB of output, with the previous 32 KiB of the chunk as its
+ * dictionary -- as MSZIP folders in cabinets. COMPRESS_RAW omits the header
+ * and chunking: the data is the blocks alone. XPRESS, XPRESS_HUFF and LZMS
+ * are not implemented yet.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "compressapi.h"
+#include "zlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(cabinet);
+
+#define HANDLE_COMPRESSOR    0x524d5043   /* "CPMR" */
+#define HANDLE_DECOMPRESSOR  0x4d504344   /* "DCPM" */
+#define HEADER_SIZE          24
+#define MSZIP_BLOCK          32768
+#define DEFAULT_CHUNK        65536
+
+struct compress_handle
+{
+    DWORD type;
+    DWORD algorithm;
+    BOOL raw;
+    SIZE_T block_size;
+    DWORD level;
+};
+
+static struct compress_handle *get_handle( HANDLE handle, DWORD type )
+{
+    struct compress_handle *h = handle;
+    if (!h || h == INVALID_HANDLE_VALUE || h->type != type)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return NULL;
+    }
+    return h;
+}
+
+static voidpf cmp_zalloc( voidpf opaque, uInt items, uInt size )
+{
+    return (UINT64)items * size > 0x7fffffff ? NULL : malloc( items * size );
+}
+
+static void cmp_zfree( voidpf opaque, voidpf address )
+{
+    free( address );
+}
+
+static BOOL create_handle( DWORD type, DWORD algorithm, HANDLE *out )
+{
+    struct compress_handle *h;
+    DWORD alg = algorithm & ~COMPRESS_RAW;
+
+    if (!out)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *out = NULL;
+    if (alg != COMPRESS_ALGORITHM_NULL && alg != COMPRESS_ALGORITHM_MSZIP &&
+        alg != COMPRESS_ALGORITHM_XPRESS && alg != COMPRESS_ALGORITHM_XPRESS_HUFF && alg != COMPRESS_ALGORITHM_LZMS)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (alg != COMPRESS_ALGORITHM_NULL && alg != COMPRESS_ALGORITHM_MSZIP)
+    {
+        FIXME( "algorithm %lu is not implemented\n", alg );
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+    if (!(h = calloc( 1, sizeof(*h) )))
+    {
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    h->type = type;
+    h->algorithm = alg;
+    h->raw = !!(algorithm & COMPRESS_RAW);
+    h->block_size = DEFAULT_CHUNK;
+    *out = h;
+    return TRUE;
+}
+
+static BOOL close_handle( HANDLE handle, DWORD type )
+{
+    struct compress_handle *h = get_handle( handle, type );
+    if (!h) return FALSE;
+    h->type = 0;
+    free( h );
+    return TRUE;
+}
+
+static BOOL set_information( HANDLE handle, DWORD type, COMPRESS_INFORMATION_CLASS class, LPCVOID info, SIZE_T size )
+{
+    struct compress_handle *h = get_handle( handle, type );
+    DWORD value;
+
+    if (!h) return FALSE;
+    if (!info || size < sizeof(DWORD))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    memcpy( &value, info, sizeof(value) );
+    switch (class)
+    {
+    case COMPRESS_INFORMATION_CLASS_BLOCK_SIZE:
+        if (value && value < 65536) { SetLastError( ERROR_INVALID_PARAMETER ); return FALSE; }
+        h->block_size = value ? value : DEFAULT_CHUNK;
+        return TRUE;
+    case COMPRESS_INFORMATION_CLASS_LEVEL:
+        h->level = value;
+        return TRUE;
+    default:
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+}
+
+static BOOL query_information( HANDLE handle, DWORD type, COMPRESS_INFORMATION_CLASS class, PVOID info, SIZE_T size )
+{
+    struct compress_handle *h = get_handle( handle, type );
+    DWORD value;
+
+    if (!h) return FALSE;
+    if (!info || size < sizeof(DWORD))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    switch (class)
+    {
+    case COMPRESS_INFORMATION_CLASS_BLOCK_SIZE: value = h->block_size; break;
+    case COMPRESS_INFORMATION_CLASS_LEVEL: value = h->level; break;
+    default:
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    memcpy( info, &value, sizeof(value) );
+    return TRUE;
+}
+
+/* ---- MSZIP ---------------------------------------------------------------- */
+
+/* Decodes CK blocks from in[] into out[] (at most out_size); the dictionary
+ * runs over what this call produced. Fails on anything malformed. */
+static BOOL mszip_decode( const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T out_size, SIZE_T *produced )
+{
+    SIZE_T pos = 0, done = 0;
+
+    while (pos < in_size)
+    {
+        z_stream z = {0};
+        SIZE_T room = out_size - done < MSZIP_BLOCK ? out_size - done : MSZIP_BLOCK;
+        int ret;
+
+        if (in_size - pos < 2 || in[pos] != 'C' || in[pos + 1] != 'K' || !room) return FALSE;
+        pos += 2;
+        z.zalloc = cmp_zalloc;
+        z.zfree = cmp_zfree;
+        if (inflateInit2( &z, -MAX_WBITS ) != Z_OK) return FALSE;
+        if (done)
+        {
+            SIZE_T dict = done < MSZIP_BLOCK ? done : MSZIP_BLOCK;
+            if (inflateSetDictionary( &z, out + done - dict, dict ) != Z_OK) { inflateEnd( &z ); return FALSE; }
+        }
+        z.next_in = (BYTE *)in + pos;
+        z.avail_in = in_size - pos;
+        z.next_out = out + done;
+        z.avail_out = room;
+        ret = inflate( &z, Z_FINISH );
+        pos += (in_size - pos) - z.avail_in;
+        done += room - z.avail_out;
+        inflateEnd( &z );
+        if (ret != Z_STREAM_END) return FALSE;
+    }
+    *produced = done;
+    return TRUE;
+}
+
+static SIZE_T mszip_bound( SIZE_T size )
+{
+    SIZE_T blocks = (size + MSZIP_BLOCK - 1) / MSZIP_BLOCK;
+    /* deflate's own bound for stored blocks, plus "CK" */
+    return blocks * (2 + MSZIP_BLOCK + MSZIP_BLOCK / 16 + 64) + (size ? 0 : 2 + 64);
+}
+
+static BOOL mszip_encode( const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T out_size, DWORD level, SIZE_T *written )
+{
+    SIZE_T pos = 0, o = 0;
+
+    do
+    {
+        SIZE_T len = in_size - pos < MSZIP_BLOCK ? in_size - pos : MSZIP_BLOCK;
+        z_stream z = {0};
+        int ret;
+
+        if (out_size - o < 2) return FALSE;
+        out[o++] = 'C';
+        out[o++] = 'K';
+        z.zalloc = cmp_zalloc;
+        z.zfree = cmp_zfree;
+        if (deflateInit2( &z, Z_DEFAULT_COMPRESSION, Z_DEFLATED, -MAX_WBITS, 8, Z_DEFAULT_STRATEGY ) != Z_OK)
+            return FALSE;
+        if (pos)
+        {
+            SIZE_T dict = pos < MSZIP_BLOCK ? pos : MSZIP_BLOCK;
+            deflateSetDictionary( &z, in + pos - dict, dict );
+        }
+        z.next_in = (BYTE *)in + pos;
+        z.avail_in = len;
+        z.next_out = out + o;
+        z.avail_out = out_size - o;
+        ret = deflate( &z, Z_FINISH );
+        o += (out_size - o) - z.avail_out;
+        deflateEnd( &z );
+        if (ret != Z_STREAM_END) return FALSE;
+        pos += len;
+    } while (pos < in_size);
+    *written = o;
+    return TRUE;
+}
+
+/* ---- a chunk ------------------------------------------------------------ */
+
+static BOOL decode_chunk( DWORD algorithm, const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T expect )
+{
+    SIZE_T produced;
+
+    if (algorithm == COMPRESS_ALGORITHM_NULL || (in_size == expect && (in_size < 2 || in[0] != 'C' || in[1] != 'K')))
+    {
+        /* stored */
+        if (in_size != expect) return FALSE;
+        memcpy( out, in, expect );
+        return TRUE;
+    }
+    return mszip_decode( in, in_size, out, expect, &produced ) && produced == expect;
+}
+
+static UINT64 get64( const BYTE *p ) { UINT64 v; memcpy( &v, p, 8 ); return v; }
+static UINT32 get32( const BYTE *p ) { UINT32 v; memcpy( &v, p, 4 ); return v; }
+
+static BYTE header_checksum( const BYTE *h )
+{
+    BYTE copy[HEADER_SIZE - 1];
+    memcpy( copy, h, 6 );
+    memcpy( copy + 6, h + 7, HEADER_SIZE - 7 );
+    return crc32( 0, copy, sizeof(copy) ) & 0xff;
+}
+
+/* ---- exports ------------------------------------------------------------ */
+
+BOOL WINAPI CreateDecompressor( DWORD algorithm, PCOMPRESS_ALLOCATION_ROUTINES routines, PDECOMPRESSOR_HANDLE handle )
+{
+    TRACE( "algorithm %#lx, routines %p, handle %p\n", algorithm, routines, handle );
+    return create_handle( HANDLE_DECOMPRESSOR, algorithm, handle );
+}
+
+BOOL WINAPI CloseDecompressor( DECOMPRESSOR_HANDLE handle )
+{
+    TRACE( "handle %p\n", handle );
+    return close_handle( handle, HANDLE_DECOMPRESSOR );
+}
+
+BOOL WINAPI ResetDecompressor( DECOMPRESSOR_HANDLE handle )
+{
+    TRACE( "handle %p\n", handle );
+    return get_handle( handle, HANDLE_DECOMPRESSOR ) != NULL;
+}
+
+BOOL WINAPI SetDecompressorInformation( DECOMPRESSOR_HANDLE handle, COMPRESS_INFORMATION_CLASS class, LPCVOID info, SIZE_T size )
+{
+    return set_information( handle, HANDLE_DECOMPRESSOR, class, info, size );
+}
+
+BOOL WINAPI QueryDecompressorInformation( DECOMPRESSOR_HANDLE handle, COMPRESS_INFORMATION_CLASS class, PVOID info, SIZE_T size )
+{
+    return query_information( handle, HANDLE_DECOMPRESSOR, class, info, size );
+}
+
+BOOL WINAPI Decompress( DECOMPRESSOR_HANDLE handle, LPCVOID compressed, SIZE_T compressed_size,
+                        PVOID uncompressed, SIZE_T uncompressed_size, PSIZE_T result_size )
+{
+    struct compress_handle *h = get_handle( handle, HANDLE_DECOMPRESSOR );
+    const BYTE *in = compressed;
+    UINT64 total, chunk, done = 0;
+    SIZE_T pos = HEADER_SIZE;
+
+    TRACE( "handle %p, compressed %p, compressed_size %Iu, uncompressed %p, uncompressed_size %Iu, result_size %p\n",
+           handle, compressed, compressed_size, uncompressed, uncompressed_size, result_size );
+
+    if (!h) return FALSE;
+    if (!in && compressed_size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    if (h->raw)
+    {
+        SIZE_T produced;
+        if (!uncompressed) { SetLastError( ERROR_INSUFFICIENT_BUFFER ); return FALSE; }
+        if (h->algorithm == COMPRESS_ALGORITHM_NULL)
+        {
+            if (compressed_size > uncompressed_size) { SetLastError( ERROR_INSUFFICIENT_BUFFER ); return FALSE; }
+            memcpy( uncompressed, in, compressed_size );
+            produced = compressed_size;
+        }
+        else if (!mszip_decode( in, compressed_size, uncompressed, uncompressed_size, &produced ))
+        {
+            SetLastError( ERROR_BAD_COMPRESSION_BUFFER );
+            return FALSE;
+        }
+        if (result_size) *result_size = produced;
+        return TRUE;
+    }
+
+    if (compressed_size < HEADER_SIZE || in[0] != 0x0a || in[1] != 0x51 || in[2] != 0xe5 || in[3] != 0xc0 ||
+        in[4] != HEADER_SIZE || in[5] || in[7] != h->algorithm || in[6] != header_checksum( in ))
+    {
+        WARN( "not a buffer of this algorithm\n" );
+        SetLastError( ERROR_BAD_COMPRESSION_BUFFER );
+        return FALSE;
+    }
+    total = get64( in + 8 );
+    chunk = get64( in + 16 );
+    if (total > (SIZE_T)~0 || (total && !chunk))
+    {
+        SetLastError( ERROR_BAD_COMPRESSION_BUFFER );
+        return FALSE;
+    }
+    if (result_size) *result_size = total;
+    if (!uncompressed || uncompressed_size < total)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+
+    while (done < total)
+    {
+        UINT64 expect = total - done < chunk ? total - done : chunk;
+        UINT32 size;
+
+        if (compressed_size - pos < 4) break;
+        size = get32( in + pos );
+        pos += 4;
+        if (size > compressed_size - pos) break;
+        if (!decode_chunk( h->algorithm, in + pos, size, (BYTE *)uncompressed + done, expect )) break;
+        pos += size;
+        done += expect;
+    }
+    if (done != total)
+    {
+        WARN( "corrupt chunk at %I64u of %I64u\n", done, total );
+        SetLastError( ERROR_BAD_COMPRESSION_BUFFER );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+BOOL WINAPI CreateCompressor( DWORD algorithm, PCOMPRESS_ALLOCATION_ROUTINES routines, PCOMPRESSOR_HANDLE handle )
+{
+    TRACE( "algorithm %#lx, routines %p, handle %p\n", algorithm, routines, handle );
+    return create_handle( HANDLE_COMPRESSOR, algorithm, handle );
+}
+
+BOOL WINAPI CloseCompressor( COMPRESSOR_HANDLE handle )
+{
+    TRACE( "handle %p\n", handle );
+    return close_handle( handle, HANDLE_COMPRESSOR );
+}
+
+BOOL WINAPI ResetCompressor( COMPRESSOR_HANDLE handle )
+{
+    TRACE( "handle %p\n", handle );
+    return get_handle( handle, HANDLE_COMPRESSOR ) != NULL;
+}
+
+BOOL WINAPI SetCompressorInformation( COMPRESSOR_HANDLE handle, COMPRESS_INFORMATION_CLASS class, LPCVOID info, SIZE_T size )
+{
+    return set_information( handle, HANDLE_COMPRESSOR, class, info, size );
+}
+
+BOOL WINAPI QueryCompressorInformation( COMPRESSOR_HANDLE handle, COMPRESS_INFORMATION_CLASS class, PVOID info, SIZE_T size )
+{
+    return query_information( handle, HANDLE_COMPRESSOR, class, info, size );
+}
+
+BOOL WINAPI Compress( COMPRESSOR_HANDLE handle, LPCVOID uncompressed, SIZE_T uncompressed_size,
+                      PVOID compressed, SIZE_T compressed_size, PSIZE_T result_size )
+{
+    struct compress_handle *h = get_handle( handle, HANDLE_COMPRESSOR );
+    const BYTE *in = uncompressed;
+    BYTE *out = compressed;
+    SIZE_T chunk, pos, o, bound, written;
+
+    TRACE( "handle %p, uncompressed %p, uncompressed_size %Iu, compressed %p, compressed_size %Iu, result_size %p\n",
+           handle, uncompressed, uncompressed_size, compressed, compressed_size, result_size );
+
+    if (!h) return FALSE;
+    if (!in && uncompressed_size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    if (h->raw)
+    {
+        bound = h->algorithm == COMPRESS_ALGORITHM_NULL ? uncompressed_size : mszip_bound( uncompressed_size );
+        if (!out || compressed_size < bound)
+        {
+            if (result_size) *result_size = bound;
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        if (h->algorithm == COMPRESS_ALGORITHM_NULL) { memcpy( out, in, uncompressed_size ); written = uncompressed_size; }
+        else if (!mszip_encode( in, uncompressed_size, out, compressed_size, h->level, &written ))
+        {
+            SetLastError( ERROR_INTERNAL_ERROR );
+            return FALSE;
+        }
+        if (result_size) *result_size = written;
+        return TRUE;
+    }
+
+    chunk = uncompressed_size < h->block_size ? uncompressed_size : h->block_size;
+    bound = HEADER_SIZE;
+    for (pos = 0; pos < uncompressed_size; pos += chunk)
+    {
+        SIZE_T len = uncompressed_size - pos < chunk ? uncompressed_size - pos : chunk;
+        bound += 4 + (h->algorithm == COMPRESS_ALGORITHM_NULL ? len : mszip_bound( len ));
+    }
+    if (!out || compressed_size < bound)
+    {
+        if (result_size) *result_size = bound;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+
+    out[0] = 0x0a; out[1] = 0x51; out[2] = 0xe5; out[3] = 0xc0;
+    out[4] = HEADER_SIZE; out[5] = 0; out[7] = h->algorithm;
+    {
+        UINT64 total = uncompressed_size, c = chunk;
+        memcpy( out + 8, &total, 8 );
+        memcpy( out + 16, &c, 8 );
+    }
+    out[6] = header_checksum( out );
+
+    for (pos = 0, o = HEADER_SIZE; pos < uncompressed_size; pos += chunk)
+    {
+        SIZE_T len = uncompressed_size - pos < chunk ? uncompressed_size - pos : chunk;
+        UINT32 size32;
+
+        if (h->algorithm == COMPRESS_ALGORITHM_NULL) { memcpy( out + o + 4, in + pos, len ); written = len; }
+        else if (!mszip_encode( in + pos, len, out + o + 4, compressed_size - o - 4, h->level, &written ))
+        {
+            SetLastError( ERROR_INTERNAL_ERROR );
+            return FALSE;
+        }
+        size32 = written;
+        memcpy( out + o, &size32, 4 );
+        o += 4 + written;
+    }
+    if (result_size) *result_size = o;
+    return TRUE;
+}
