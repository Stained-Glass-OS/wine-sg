 HRESULT WINAPI ADsEncodeBinaryData(PBYTE pbSrcData, DWORD dwSrcLen, LPWSTR *ppszDestData)
 {
-    FIXME("(%p,%ld,%p)!stub\n", pbSrcData, dwSrcLen, *ppszDestData);
-    return E_NOTIMPL;
+    static const WCHAR hex[] = L"0123456789ABCDEF";
+    WCHAR *out;
+    DWORD i;
+
+    TRACE("(%p,%ld,%p)\n", pbSrcData, dwSrcLen, ppszDestData);
+
+    if (!ppszDestData) return E_ADS_BAD_PARAMETER;
+    *ppszDestData = NULL;
+    if (!pbSrcData && dwSrcLen) return E_ADS_BAD_PARAMETER;
+
+    /* each byte becomes a backslash followed by two hexadecimal digits */
+    out = AllocADsMem((dwSrcLen * 3 + 1) * sizeof(WCHAR));
+    if (!out) return E_OUTOFMEMORY;
+    for (i = 0; i < dwSrcLen; i++)
+    {
+        out[i * 3] = '\\';
+        out[i * 3 + 1] = hex[pbSrcData[i] >> 4];
+        out[i * 3 + 2] = hex[pbSrcData[i] & 15];
+    }
+    out[dwSrcLen * 3] = 0;
+    *ppszDestData = out;
+    return S_OK;
+}
+
+static int hex_value(WCHAR c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/*****************************************************
+ * ADsDecodeBinaryData     [ACTIVEDS.24]
+ */
+HRESULT WINAPI ADsDecodeBinaryData(LPWSTR szSrcData, PBYTE *ppbDestData, ULONG *pdwDestLen)
+{
+    SIZE_T len, i, n = 0;
+    BYTE *out;
+
+    TRACE("(%s,%p,%p)\n", debugstr_w(szSrcData), ppbDestData, pdwDestLen);
+
+    if (!szSrcData || !ppbDestData || !pdwDestLen) return E_ADS_BAD_PARAMETER;
+    *ppbDestData = NULL;
+    *pdwDestLen = 0;
+
+    len = lstrlenW(szSrcData);
+    out = AllocADsMem(len ? len : 1);
+    if (!out) return E_OUTOFMEMORY;
+
+    for (i = 0; i < len; )
+    {
+        int hi, lo;
+
+        if (szSrcData[i] != '\\' || i + 3 > len)
+        {
+            FreeADsMem(out);
+            return E_ADS_BAD_PARAMETER;
+        }
+        hi = hex_value(szSrcData[i + 1]);
+        lo = hex_value(szSrcData[i + 2]);
+        if (hi < 0 || lo < 0) { FreeADsMem(out); return E_ADS_BAD_PARAMETER; }
+        out[n++] = (hi << 4) | lo;
+        i += 3;
+    }
+
+    *ppbDestData = out;
+    *pdwDestLen = n;
+    return S_OK;
+}
+
+/* ADSVALUE conversions */
+
+static void free_adsvalue(ADSVALUE *v)
+{
+    switch (v->dwType)
+    {
+    case ADSTYPE_DN_STRING:
+    case ADSTYPE_CASE_EXACT_STRING:
+    case ADSTYPE_CASE_IGNORE_STRING:
+    case ADSTYPE_PRINTABLE_STRING:
+    case ADSTYPE_NUMERIC_STRING:
+    case ADSTYPE_OBJECT_CLASS:
+        FreeADsStr(v->DNString);
+        break;
+    case ADSTYPE_OCTET_STRING:
+    case ADSTYPE_PROV_SPECIFIC:
+        FreeADsMem(v->OctetString.lpValue);
+        break;
+    default:
+        break;
+    }
+}
+
+/*****************************************************
+ * AdsFreeAdsValues     [ACTIVEDS.23]
+ */
+void WINAPI AdsFreeAdsValues(PADSVALUE values, DWORD count)
+{
+    DWORD i;
+
+    TRACE("(%p,%ld)\n", values, count);
+
+    if (!values) return;
+    for (i = 0; i < count; i++) free_adsvalue(&values[i]);
+}
+
+static HRESULT variant_to_adsvalue(const VARIANT *var, ADSVALUE *out)
+{
+    memset(out, 0, sizeof(*out));
+
+    switch (V_VT(var))
+    {
+    case VT_BSTR:
+        out->dwType = ADSTYPE_CASE_IGNORE_STRING;
+        out->CaseIgnoreString = AllocADsStr(V_BSTR(var) ? V_BSTR(var) : (WCHAR *)L"");
+        return out->CaseIgnoreString ? S_OK : E_OUTOFMEMORY;
+    case VT_BOOL:
+        out->dwType = ADSTYPE_BOOLEAN;
+        out->Boolean = V_BOOL(var) ? TRUE : FALSE;
+        return S_OK;
+    case VT_I2:
+        out->dwType = ADSTYPE_INTEGER;
+        out->Integer = V_I2(var);
+        return S_OK;
+    case VT_I4:
+        out->dwType = ADSTYPE_INTEGER;
+        out->Integer = V_I4(var);
+        return S_OK;
+    case VT_UI4:
+        out->dwType = ADSTYPE_INTEGER;
+        out->Integer = V_UI4(var);
+        return S_OK;
+    case VT_DATE:
+    {
+        SYSTEMTIME st;
+
+        if (!VariantTimeToSystemTime(V_DATE(var), &st)) return E_FAIL;
+        out->dwType = ADSTYPE_UTC_TIME;
+        out->UTCTime = st;
+        return S_OK;
+    }
+    case VT_ARRAY | VT_UI1:
+    {
+        LONG lo, hi;
+        void *data;
+        HRESULT hr;
+
+        if (!V_ARRAY(var) || SafeArrayGetDim(V_ARRAY(var)) != 1) return E_ADS_BAD_PARAMETER;
+        if (FAILED(hr = SafeArrayGetLBound(V_ARRAY(var), 1, &lo))) return hr;
+        if (FAILED(hr = SafeArrayGetUBound(V_ARRAY(var), 1, &hi))) return hr;
+        out->dwType = ADSTYPE_OCTET_STRING;
+        out->OctetString.dwLength = hi - lo + 1;
+        out->OctetString.lpValue = AllocADsMem(out->OctetString.dwLength ? out->OctetString.dwLength : 1);
+        if (!out->OctetString.lpValue) return E_OUTOFMEMORY;
+        if (FAILED(hr = SafeArrayAccessData(V_ARRAY(var), &data)))
+        {
+            FreeADsMem(out->OctetString.lpValue);
+            return hr;
+        }
+        memcpy(out->OctetString.lpValue, data, out->OctetString.dwLength);
+        SafeArrayUnaccessData(V_ARRAY(var));
+        return S_OK;
+    }
+    default:
+        FIXME("unsupported variant type %#x\n", V_VT(var));
+        return E_ADS_CANT_CONVERT_DATATYPE;
+    }
+}
+
+/*****************************************************
+ * PropVariantToAdsType     [ACTIVEDS.21]
+ */
+HRESULT WINAPI PropVariantToAdsType(VARIANT *variant, DWORD count, PADSVALUE *values, PDWORD num_values)
+{
+    ADSVALUE *out;
+    DWORD i;
+    HRESULT hr;
+
+    TRACE("(%p,%ld,%p,%p)\n", variant, count, values, num_values);
+
+    if (!variant || !count || !values || !num_values) return E_ADS_BAD_PARAMETER;
+    *values = NULL;
+    *num_values = 0;
+
+    /* a single array of variants holds all the values */
+    if (count == 1 && V_VT(variant) == (VT_ARRAY | VT_VARIANT))
+    {
+        LONG lo, hi, idx;
+        VARIANT item;
+
+        if (!V_ARRAY(variant) || SafeArrayGetDim(V_ARRAY(variant)) != 1) return E_ADS_BAD_PARAMETER;
+        SafeArrayGetLBound(V_ARRAY(variant), 1, &lo);
+        SafeArrayGetUBound(V_ARRAY(variant), 1, &hi);
+        count = hi - lo + 1;
+        if (!count) return E_ADS_BAD_PARAMETER;
+        out = AllocADsMem(count * sizeof(*out));
+        if (!out) return E_OUTOFMEMORY;
+        for (idx = lo; idx <= hi; idx++)
+        {
+            VariantInit(&item);
+            hr = SafeArrayGetElement(V_ARRAY(variant), &idx, &item);
+            if (SUCCEEDED(hr)) hr = variant_to_adsvalue(&item, &out[idx - lo]);
+            VariantClear(&item);
+            if (FAILED(hr))
+            {
+                AdsFreeAdsValues(out, idx - lo);
+                FreeADsMem(out);
+                return hr;
+            }
+        }
+        *values = out;
+        *num_values = count;
+        return S_OK;
+    }
+
+    out = AllocADsMem(count * sizeof(*out));
+    if (!out) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        if (FAILED(hr = variant_to_adsvalue(&variant[i], &out[i])))
+        {
+            AdsFreeAdsValues(out, i);
+            FreeADsMem(out);
+            return hr;
+        }
+    }
+    *values = out;
+    *num_values = count;
+    return S_OK;
+}
+
+static HRESULT adsvalue_to_variant(const ADSVALUE *v, VARIANT *var)
+{
+    VariantInit(var);
+
+    switch (v->dwType)
+    {
+    case ADSTYPE_DN_STRING:
+    case ADSTYPE_CASE_EXACT_STRING:
+    case ADSTYPE_CASE_IGNORE_STRING:
+    case ADSTYPE_PRINTABLE_STRING:
+    case ADSTYPE_NUMERIC_STRING:
+    case ADSTYPE_OBJECT_CLASS:
+        V_VT(var) = VT_BSTR;
+        V_BSTR(var) = SysAllocString(v->DNString);
+        return V_BSTR(var) || !v->DNString ? S_OK : E_OUTOFMEMORY;
+    case ADSTYPE_BOOLEAN:
+        V_VT(var) = VT_BOOL;
+        V_BOOL(var) = v->Boolean ? VARIANT_TRUE : VARIANT_FALSE;
+        return S_OK;
+    case ADSTYPE_INTEGER:
+        V_VT(var) = VT_I4;
+        V_I4(var) = v->Integer;
+        return S_OK;
+    case ADSTYPE_UTC_TIME:
+    {
+        DATE date;
+
+        if (!SystemTimeToVariantTime((SYSTEMTIME *)&v->UTCTime, &date)) return E_FAIL;
+        V_VT(var) = VT_DATE;
+        V_DATE(var) = date;
+        return S_OK;
+    }
+    case ADSTYPE_OCTET_STRING:
+    case ADSTYPE_PROV_SPECIFIC:
+    {
+        SAFEARRAY *sa = SafeArrayCreateVector(VT_UI1, 0, v->OctetString.dwLength);
+        void *data;
+
+        if (!sa) return E_OUTOFMEMORY;
+        if (v->OctetString.dwLength)
+        {
+            SafeArrayAccessData(sa, &data);
+            memcpy(data, v->OctetString.lpValue, v->OctetString.dwLength);
+            SafeArrayUnaccessData(sa);
+        }
+        V_VT(var) = VT_ARRAY | VT_UI1;
+        V_ARRAY(var) = sa;
+        return S_OK;
+    }
+    default:
+        FIXME("unsupported ADS type %d\n", v->dwType);
+        return E_ADS_CANT_CONVERT_DATATYPE;
+    }
+}
+
+/*****************************************************
+ * AdsTypeToPropVariant     [ACTIVEDS.22]
+ */
+HRESULT WINAPI AdsTypeToPropVariant(PADSVALUE values, DWORD count, VARIANT *variant)
+{
+    HRESULT hr;
+
+    TRACE("(%p,%ld,%p)\n", values, count, variant);
+
+    if (!values || !count || !variant) return E_ADS_BAD_PARAMETER;
+
+    if (count == 1)
+        return adsvalue_to_variant(&values[0], variant);
+
+    {
+        SAFEARRAY *sa = SafeArrayCreateVector(VT_VARIANT, 0, count);
+        LONG idx;
+
+        if (!sa) return E_OUTOFMEMORY;
+        for (idx = 0; idx < (LONG)count; idx++)
+        {
+            VARIANT item;
+
+            if (FAILED(hr = adsvalue_to_variant(&values[idx], &item)) ||
+                FAILED(hr = SafeArrayPutElement(sa, &idx, &item)))
+            {
+                VariantClear(&item);
+                SafeArrayDestroy(sa);
+                return hr;
+            }
+            VariantClear(&item);
+        }
+        VariantInit(variant);
+        V_VT(variant) = VT_ARRAY | VT_VARIANT;
+        V_ARRAY(variant) = sa;
+    }
+    return S_OK;
 }
