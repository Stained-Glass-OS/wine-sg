 VOID WINAPI ADsSetLastError(DWORD dwErr, LPWSTR pszError, LPWSTR pszProvider)
 {
-    FIXME("(%ld,%p,%p)!stub\n", dwErr, pszError, pszProvider);
+    struct ads_error *err;
+
+    TRACE("(%ld,%s,%s)\n", dwErr, debugstr_w(pszError), debugstr_w(pszProvider));
+
+    if (!(err = get_thread_error(TRUE))) return;
+
+    free(err->message);
+    free(err->provider);
+    err->code = dwErr;
+    err->message = pszError ? wcsdup(pszError) : NULL;
+    err->provider = pszProvider ? wcsdup(pszProvider) : NULL;
+}
+
+static void copy_error_string(const WCHAR *src, WCHAR *dst, DWORD len)
+{
+    if (!dst || !len) return;
+    if (src) lstrcpynW(dst, src, len);
+    else dst[0] = 0;
 }
 
