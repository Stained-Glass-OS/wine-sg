+/* elements of the DN are separated by commas that are not escaped */
+static const WCHAR *find_separator(const WCHAR *p)
+{
+    for (; *p; p++)
+    {
+        if (*p == '\\' && p[1]) p++;
+        else if (*p == ',') return p;
+    }
+    return NULL;
+}
+
+static LONG count_elements(const WCHAR *dn)
+{
+    LONG n = 0;
+
+    if (!dn || !*dn) return 0;
+    for (;;)
+    {
+        n++;
+        if (!(dn = find_separator(dn))) break;
+        dn++;
+    }
+    return n;
+}
+
+static WCHAR *dup_range(const WCHAR *start, const WCHAR *end)
+{
+    WCHAR *ret = malloc((end - start + 1) * sizeof(WCHAR));
+
+    if (ret)
+    {
+        memcpy(ret, start, (end - start) * sizeof(WCHAR));
+        ret[end - start] = 0;
+    }
+    return ret;
+}
+
+/* returns the element at the index, optionally without the attribute name */
+static WCHAR *get_element(const Pathname *path, LONG index, BOOL value_only)
+{
+    const WCHAR *p = path->dn, *end;
+    LONG i;
+
+    if (!p || !*p || index < 0) return NULL;
+    for (i = 0; ; i++)
+    {
+        end = find_separator(p);
+        if (i == index) break;
+        if (!end) return NULL;
+        p = end + 1;
+    }
+    if (!end) end = p + wcslen(p);
+
+    if (value_only)
+    {
+        const WCHAR *eq = p;
+        while (eq < end && *eq != '=') eq++;
+        if (eq < end) p = eq + 1;
+    }
+    return dup_range(p, end);
+}
+
+static HRESULT alloc_bstr_result(const WCHAR *str, BSTR *out)
+{
+    *out = SysAllocString(str);
+    return *out ? S_OK : E_OUTOFMEMORY;
+}
+
+/* element list in the Windows form: root first, separated by slashes */
+static WCHAR *build_windows_dn(const Pathname *path, LONG skip_leaf)
+{
+    LONG count = count_elements(path->dn), i;
+    SIZE_T len = 1;
+    WCHAR *ret, *pos;
+
+    for (i = skip_leaf; i < count; i++)
+    {
+        WCHAR *e = get_element(path, i, FALSE);
+        if (!e) return NULL;
+        len += wcslen(e) + 1;
+        free(e);
+    }
+    if (!(ret = malloc(len * sizeof(WCHAR)))) return NULL;
+    pos = ret;
+    *pos = 0;
+    for (i = count - 1; i >= skip_leaf; i--)
+    {
+        WCHAR *e = get_element(path, i, FALSE);
+        if (!e) { free(ret); return NULL; }
+        if (pos != ret) *pos++ = '/';
+        wcscpy(pos, e);
+        pos += wcslen(e);
+        free(e);
+    }
+    return ret;
+}
+
+static WCHAR *build_x500_dn(const Pathname *path, LONG skip_leaf)
+{
+    const WCHAR *p = path->dn;
+    LONG i;
+
+    if (!p) return wcsdup(L"");
+    for (i = 0; i < skip_leaf; i++)
+    {
+        if (!(p = find_separator(p))) return wcsdup(L"");
+        p++;
+    }
+    return wcsdup(p);
 }
 
