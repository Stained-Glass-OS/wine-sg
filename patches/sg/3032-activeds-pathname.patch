+struct ads_error
+{
+    DWORD code;
+    WCHAR *message;
+    WCHAR *provider;
+};
+
+static DWORD error_tls = TLS_OUT_OF_INDEXES;
+
+static struct ads_error *get_thread_error(BOOL create)
+{
+    struct ads_error *err = TlsGetValue(error_tls);
+
+    if (!err && create)
+    {
+        err = calloc(1, sizeof(*err));
+        if (err) TlsSetValue(error_tls, err);
+    }
+    return err;
+}
+
+BOOL WINAPI DllMain(HINSTANCE inst, DWORD reason, void *reserved)
+{
+    struct ads_error *err;
+
+    switch (reason)
+    {
+    case DLL_PROCESS_ATTACH:
+        DisableThreadLibraryCalls(inst);
+        if ((error_tls = TlsAlloc()) == TLS_OUT_OF_INDEXES) return FALSE;
+        break;
+    case DLL_PROCESS_DETACH:
+        if (reserved) break;
+        if ((err = TlsGetValue(error_tls)))
+        {
+            free(err->message);
+            free(err->provider);
+            free(err);
+        }
+        TlsFree(error_tls);
+        break;
+    }
+    return TRUE;
+}
+
 /*****************************************************
  * ADsSetLastError    [ACTIVEDS.12]
