diff --git a/dlls/netio.sys/netio.c b/dlls/netio.sys/netio.c
--- a/dlls/netio.sys/netio.c
+++ b/dlls/netio.sys/netio.c
@@ -88,6 +88,7 @@
 static LPFN_CONNECTEX pConnectEx;
 
 static const WSK_PROVIDER_CONNECTION_DISPATCH wsk_provider_connection_dispatch;
+static const WSK_PROVIDER_STREAM_DISPATCH wsk_provider_stream_dispatch;
 
 static inline struct wsk_socket_internal *wsk_socket_internal_from_wsk_socket(WSK_SOCKET *wsk_socket)
 {
@@ -358,7 +359,8 @@
             dispatch_pending_io(io, STATUS_CANCELLED, 0);
     }
 
-    if (s->flags & WSK_FLAG_LISTEN_SOCKET && s->callback_context.listen_socket_callback_context.acceptor)
+    if (s->flags & (WSK_FLAG_LISTEN_SOCKET | WSK_FLAG_STREAM_SOCKET)
+            && s->callback_context.listen_socket_callback_context.acceptor)
         closesocket(s->callback_context.listen_socket_callback_context.acceptor);
 
     status = closesocket(s->s) ? sock_error_to_ntstatus(WSAGetLastError()) : STATUS_SUCCESS;
@@ -400,6 +402,34 @@
     return STATUS_PENDING;
 }
 
+static NTSTATUS WINAPI wsk_listen(WSK_SOCKET *socket, IRP *irp)
+{
+    struct wsk_socket_internal *s = wsk_socket_internal_from_wsk_socket(socket);
+    NTSTATUS status;
+
+    TRACE("socket %p, irp %p.\n", socket, irp);
+
+    if (!irp)
+        return STATUS_INVALID_PARAMETER;
+
+    irp->IoStatus.Information = 0;
+
+    /* only a stream socket bound with WskBind may listen */
+    if (!s->bound)
+        status = STATUS_INVALID_DEVICE_STATE;
+#ifdef SG_MUTANT_NETIO_NOLISTEN
+    else if (0)
+#else
+    else if (listen(s->s, SOMAXCONN))
+#endif
+        status = sock_error_to_ntstatus(WSAGetLastError());
+    else
+        status = STATUS_SUCCESS;
+
+    dispatch_irp(irp, status);
+    return STATUS_PENDING;
+}
+
 static void create_accept_socket(struct wsk_socket_internal *socket, struct wsk_pending_io *io)
 {
     struct listen_socket_callback_context *context
@@ -416,14 +446,20 @@
     else
     {
         TRACE("accept_socket %p.\n", accept_socket);
-        accept_socket->wsk_socket.Dispatch = &wsk_provider_connection_dispatch;
+#ifdef SG_MUTANT_NETIO_KIND
+        accept_socket->wsk_socket.Dispatch = socket->flags == 0xffff
+#else
+        accept_socket->wsk_socket.Dispatch = socket->flags == WSK_FLAG_STREAM_SOCKET
+#endif
+                ? (const void *)&wsk_provider_stream_dispatch : (const void *)&wsk_provider_connection_dispatch;
         accept_socket->s = context->acceptor;
         accept_socket->client_dispatch = context->client_dispatch;
         accept_socket->client_context = context->client_context;
         accept_socket->socket_type = socket->socket_type;
         accept_socket->address_family = socket->address_family;
         accept_socket->protocol = socket->protocol;
-        accept_socket->flags = WSK_FLAG_CONNECTION_SOCKET;
+        accept_socket->flags = socket->flags == WSK_FLAG_STREAM_SOCKET ? WSK_FLAG_STREAM_SOCKET
+                : WSK_FLAG_CONNECTION_SOCKET;
         accept_socket->bound = TRUE;
         socket_init(accept_socket);
 
@@ -1145,6 +1181,33 @@
     wsk_receive_ex,
 };
 
+static const WSK_PROVIDER_BASIC_DISPATCH wsk_provider_basic_dispatch =
+{
+    wsk_control_socket,
+    wsk_close_socket,
+};
+
+static const WSK_PROVIDER_STREAM_DISPATCH wsk_provider_stream_dispatch =
+{
+    {
+        wsk_control_socket,
+        wsk_close_socket,
+    },
+    wsk_bind,
+    wsk_accept,
+    wsk_connect,
+    wsk_listen,
+    wsk_send,
+    wsk_receive,
+    wsk_disconnect,
+    wsk_release,
+    wsk_get_local_address,
+    wsk_get_remote_address,
+    wsk_connext_ex,
+    wsk_send_ex,
+    wsk_receive_ex,
+};
+
 static NTSTATUS WINAPI wsk_socket(WSK_CLIENT *client, ADDRESS_FAMILY address_family, USHORT socket_type,
         ULONG protocol, ULONG flags, void *socket_context, const void *dispatch, PEPROCESS owning_process,
         PETHREAD owning_thread, SECURITY_DESCRIPTOR *security_descriptor, IRP *irp)
@@ -1189,6 +1252,16 @@
 
     switch (flags)
     {
+#ifndef SG_MUTANT_NETIO_BASIC
+        case WSK_FLAG_BASIC_SOCKET:
+            socket->wsk_socket.Dispatch = &wsk_provider_basic_dispatch;
+            break;
+#endif
+
+        case WSK_FLAG_STREAM_SOCKET:
+            socket->wsk_socket.Dispatch = &wsk_provider_stream_dispatch;
+            break;
+
         case WSK_FLAG_LISTEN_SOCKET:
             socket->wsk_socket.Dispatch = &wsk_provider_listen_dispatch;
             break;
diff --git a/dlls/ntoskrnl.exe/tests/driver_netio.c b/dlls/ntoskrnl.exe/tests/driver_netio.c
--- a/dlls/ntoskrnl.exe/tests/driver_netio.c
+++ b/dlls/ntoskrnl.exe/tests/driver_netio.c
@@ -1105,6 +1105,95 @@
     ok(status == STATUS_INVALID_PARAMETER, "long address: got unexpected status %#lx.\n", status);
 }
 
+static void test_wsk_socket_kinds(void)
+{
+    const WSK_PROVIDER_STREAM_DISPATCH *sd, *accepted_dispatch;
+    struct sockaddr_in addr, listen_addr, local, remote;
+    const WSK_PROVIDER_BASIC_DISPATCH *basic;
+    WSK_SOCKET *listener, *client, *server;
+    struct async accept_irp;
+    NTSTATUS status;
+    SIZE_T done;
+    char data[16];
+    ULONG in, out;
+    SIZE_T returned;
+
+    /* a basic socket only has the control and close functions */
+    client = create_test_socket(SOCK_STREAM, IPPROTO_TCP, WSK_FLAG_BASIC_SOCKET);
+    ok(!!client, "Got no basic socket.\n");
+    basic = client->Dispatch;
+    in = 1;
+    out = 0;
+    status = basic->WskControlSocket(client, WskSetOption, SO_KEEPALIVE, SOL_SOCKET, sizeof(in), &in, 0, NULL, NULL, NULL);
+    ok(status == STATUS_SUCCESS, "basic: got unexpected status %#lx.\n", status);
+    returned = 0;
+    status = basic->WskControlSocket(client, WskIoctl, TEST_FIONREAD, 0, 0, NULL, sizeof(out), &out, &returned, NULL);
+    ok(status == STATUS_SUCCESS && returned == 4 && !out, "basic: ioctl got status %#lx, %Iu bytes.\n", status, returned);
+    close_test_socket(client);
+
+    /* a stream socket listens and accepts, and connects, with one dispatch table */
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+
+    listener = create_test_socket(SOCK_STREAM, IPPROTO_TCP, WSK_FLAG_STREAM_SOCKET);
+    sd = listener->Dispatch;
+    ok(sd->WskListen && sd->WskAccept && sd->WskConnect && sd->WskSend && sd->WskDisconnect,
+            "Stream dispatch table is incomplete.\n");
+
+    prepare_irp();
+    status = finish_irp(sd->WskListen(listener, wsk_irp));
+    ok(status == STATUS_INVALID_DEVICE_STATE, "listen unbound: got unexpected status %#lx.\n", status);
+    prepare_irp();
+    status = finish_irp(sd->WskBind(listener, (SOCKADDR *)&addr, 0, wsk_irp));
+    ok(status == STATUS_SUCCESS, "bind: got unexpected status %#lx.\n", status);
+    prepare_irp();
+    status = finish_irp(sd->WskListen(listener, wsk_irp));
+    ok(status == STATUS_SUCCESS, "listen: got unexpected status %#lx.\n", status);
+    prepare_irp();
+    status = finish_irp(sd->WskGetLocalAddress(listener, (SOCKADDR *)&listen_addr, wsk_irp));
+    ok(status == STATUS_SUCCESS && listen_addr.sin_port, "local: got unexpected status %#lx.\n", status);
+
+    async_init(&accept_irp);
+    status = sd->WskAccept(listener, 0, NULL, NULL, (SOCKADDR *)&local, (SOCKADDR *)&remote,
+            async_prepare(&accept_irp));
+    ok(status == STATUS_PENDING, "accept: got unexpected status %#lx.\n", status);
+
+    client = create_test_socket(SOCK_STREAM, IPPROTO_TCP, WSK_FLAG_STREAM_SOCKET);
+    sd = client->Dispatch;
+    prepare_irp();
+    status = finish_irp(sd->WskBind(client, (SOCKADDR *)&addr, 0, wsk_irp));
+    ok(status == STATUS_SUCCESS, "client bind: got unexpected status %#lx.\n", status);
+    prepare_irp();
+    status = finish_irp(sd->WskConnect(client, (SOCKADDR *)&listen_addr, 0, wsk_irp));
+    ok(status == STATUS_SUCCESS, "connect: got unexpected status %#lx.\n", status);
+    status = async_wait(&accept_irp, STATUS_PENDING, 5000);
+    ok(status == STATUS_SUCCESS, "accept: got unexpected status %#lx.\n", status);
+    server = (WSK_SOCKET *)accept_irp.irp->IoStatus.Information;
+    async_free(&accept_irp);
+
+    if (server)
+    {
+        accepted_dispatch = server->Dispatch;
+        ok(accepted_dispatch == listener->Dispatch, "Accepted socket has dispatch %p, expected the stream table %p.\n",
+                accepted_dispatch, listener->Dispatch);
+        ok(remote.sin_port == local.sin_port || remote.sin_port, "Got no remote address.\n");
+        status = socket_send(client, "stream", 6, &done);
+        ok(status == STATUS_SUCCESS && done == 6, "send: status %#lx, %Iu bytes.\n", status, done);
+        status = socket_receive(server, data, sizeof(data), &done, 3000);
+        ok(status == STATUS_SUCCESS && done == 6 && !memcmp(data, "stream", 6),
+                "receive: status %#lx, %Iu bytes.\n", status, done);
+        prepare_irp();
+        status = finish_irp(accepted_dispatch->WskDisconnect(server, NULL, 0, wsk_irp));
+        ok(status == STATUS_SUCCESS, "disconnect: got unexpected status %#lx.\n", status);
+        status = socket_receive(client, data, sizeof(data), &done, 3000);
+        ok(status == STATUS_SUCCESS && !done, "client end: status %#lx, %Iu bytes.\n", status, done);
+        close_test_socket(server);
+    }
+    close_test_socket(client);
+    close_test_socket(listener);
+}
+
 static void test_wsk_control_socket(void)
 {
     static const struct
@@ -1195,6 +1284,7 @@
     test_wsk_connect_ex();
     test_wsk_socket_connect();
     test_wsk_get_name_info();
+    test_wsk_socket_kinds();
 
     irp->IoStatus.Information = 0;
     return STATUS_SUCCESS;
