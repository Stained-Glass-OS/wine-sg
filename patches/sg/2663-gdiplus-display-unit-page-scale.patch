From: Stained Glass OS <ke7oxh@gmail.com>
gdiplus: the page scale does not apply to fonts with UnitDisplay

With the page unit UnitDisplay the page scale is not part of the world to
device transform; the font height must not be divided by it either.
Removes the todo_wine marks of the string measuring tests for that case.
---
--- a/dlls/gdiplus/graphics.c
+++ b/dlls/gdiplus/graphics.c
@@ -2573,7 +2573,11 @@ void get_font_hfont(GpGraphics *graphics, GDIPCONST GpFont *font,
 
     transform_properties(graphics, matrix, TRUE, &rel_width, &rel_height, &angle);
     /* If the font unit is not pixels scaling should not be applied */
+#ifdef SG_MUTANT_GPDISPLAY_SCALE
     if (font->unit != UnitPixel && font->unit != UnitWorld)
+#else
+    if (font->unit != UnitPixel && font->unit != UnitWorld && graphics->unit != UnitDisplay)
+#endif
     {
         rel_width /= graphics->scale;
         rel_height /= graphics->scale;
--- a/dlls/gdiplus/tests/graphics.c
+++ b/dlls/gdiplus/tests/graphics.c
@@ -3981,7 +3981,6 @@ static void test_GdipMeasureString(void)
 
             expectf(0.0, bounds.X);
             expectf(0.0, bounds.Y);
-            todo_wine_if(td[i].unit == UnitDisplay && td[i].page_scale == 2.0)
             expectf_(height, bounds.Height, height / 85.0);
             expectf_(bounds.Height / base_cy, bounds.Width / base_cx, 0.1);
             expect(7, chars);
@@ -3998,7 +3997,6 @@ static void test_GdipMeasureString(void)
             expect(Ok, status);
             expectf(50.0, bounds.X);
             expectf(50.0, bounds.Y);
-            todo_wine_if(td[i].unit == UnitDisplay && td[i].page_scale == 2.0)
             expectf_(height, bounds.Height, height / 85.0);
             expectf_(bounds.Height / base_cy, bounds.Width / base_cx, 0.1);
             expect(7, chars);
@@ -4010,7 +4008,6 @@ static void test_GdipMeasureString(void)
                 height *= td[i].page_scale;
             /*trace("%u: unit %u, %.1fx%.1f dpi, scale %.1f, height %f, pixels %f\n",
                   i, td[i].unit, td[i].res_x, td[i].res_y, td[i].page_scale, bounds.Height, height);*/
-            todo_wine_if(td[i].unit == UnitDisplay && td[i].page_scale == 2.0)
             expectf_(100.0, height, 1.1);
 
             status = GdipDeleteGraphics(graphics);
