+/* Stained Glass OS 9150: the owner of what a token creates, as Windows sets it -- Administrators
+ * for an administrator's full token (an elevated program, SYSTEM), the user for everyone else
+ * (a standard user, an administrator unelevated). create_token() made it the primary group, this
+ * machine's Domain Users, which EVERY account's token holds: every account was the owner of
+ * every key created at run time -- HKLM\Software\Classes, an elevated installer's keys, another
+ * user's -- and an owner may always change the DACL (WRITE_DAC) and delete. */
+static void sg_token_set_windows_owner( struct token *token, int admin )
+{
+    struct group *group;
+
+#ifdef SG_MUTANT_OWNER_PRIMARY_GROUP
+    return;
+#endif
+    token->owner = token->user;
+    if (!admin) return;
+    LIST_FOR_EACH_ENTRY( group, &token->groups, struct group, entry )
+        if (equal_sid( &group->sid, &builtin_admins_sid ) && (group->attrs & SE_GROUP_ENABLED) &&
+            !(group->attrs & SE_GROUP_USE_FOR_DENY_ONLY))
+            token->owner = &group->sid;
+}
