+/* Stained Glass OS 9150: the descriptor of a process (or thread) running with TOKEN. An elevated
+ * program's is Windows': owner Administrators, SYSTEM and Administrators full, and the person
+ * (unelevated: Administrators only for deny) only waits on it and asks its name and exit code
+ * (LIMITED: PROCESS_ or THREAD_QUERY_LIMITED_INFORMATION). With the person's full access every
+ * program they run unelevated could open their elevated installer for writing its memory and
+ * starting threads in it -- elevation without consent. Everyone else's: sg_create_owner_sd. */
+struct security_descriptor *sg_create_process_sd( struct token *token, unsigned int limited )
+{
+    const struct sid *user = token_get_user( token );
+    struct security_descriptor *sd;
+    size_t owner_len, group_len, dacl_len;
+    struct acl *dacl;
+    struct ace *ace;
+    char *ptr;
+
+#ifdef SG_MUTANT_ELEVATED_PROCESS_OPEN
+    return sg_create_owner_sd( user );
+#endif
+    if (!token->owner || !equal_sid( token->owner, &builtin_admins_sid ) || equal_sid( user, &local_system_sid ))
+        return sg_create_owner_sd( user );
+    owner_len = sid_len( &builtin_admins_sid );
+    group_len = sid_len( &domain_users_sid );
+    dacl_len = sizeof(struct acl) + 3 * sizeof(struct ace) + sid_len( &local_system_sid ) +
+               sid_len( &builtin_admins_sid ) + sid_len( user );
+    if (!(sd = mem_alloc( sizeof(*sd) + owner_len + group_len + dacl_len ))) return NULL;
+    sd->control   = SE_DACL_PRESENT;
+    sd->owner_len = owner_len;
+    sd->group_len = group_len;
+    sd->sacl_len  = 0;
+    sd->dacl_len  = dacl_len;
+    ptr = (char *)(sd + 1);
+    copy_sid( (struct sid *)ptr, &builtin_admins_sid ); ptr += owner_len;
+    copy_sid( (struct sid *)ptr, &domain_users_sid ); ptr += group_len;
+    dacl = (struct acl *)ptr;
+    dacl->revision = ACL_REVISION;
+    dacl->pad1     = 0;
+    dacl->size     = dacl_len;
+    dacl->count    = 3;
+    dacl->pad2     = 0;
+    ace = set_ace( ace_first( dacl ), &local_system_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    ace = set_ace( ace_next( ace ), &builtin_admins_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    set_ace( ace_next( ace ), user, ACCESS_ALLOWED_ACE_TYPE, 0, SYNCHRONIZE | limited );
+    return sd;
+}
