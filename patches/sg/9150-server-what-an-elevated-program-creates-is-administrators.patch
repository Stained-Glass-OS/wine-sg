+/* Stained Glass OS 9150: the descriptor a key of a user's hive without one is CHECKED against, not
+ * only reported (5950 said so; check_object_access fell back to the machine default only, so these
+ * keys were open to everyone: a standard user created keys in another person's HKCU\Software).
+ * Another account is refused, as on Windows; the user, SYSTEM and Administrators are not. */
+const struct security_descriptor *sg_user_hive_default_sd( struct object *obj )
+{
+#ifdef SG_MUTANT_USERKEY_UNCHECKED
+    return NULL;
+#endif
+    if (!sg_system_prefix || obj->ops != &key_ops) return NULL;
+    return sg_user_key_default_sd( obj );
+}
+
+/* whether a key is the caller's own Windows Installer registration (UserData\<its SID>...) */
+static int sg_is_own_userdata_key( struct object *obj )
+{
+    data_size_t len = 0;
+    WCHAR *name = obj->ops->get_full_name( obj, &len );
+    int ret = name && sg_is_own_installer_userdata( name, len );
+    if (!name) clear_error();
+    free( name );
+    return ret;
+}
+
+/* Stained Glass OS 9150: an elevated program's key in its person's own Installer\UserData\<SID>
+ * (a per-user package installed with consent). Its token now gives only SYSTEM and Administrators;
+ * the person, unelevated, still repairs and removes their own per-user packages there (5944), so
+ * it stays without a descriptor, as the subtree's keys loaded from system.reg: the person may use
+ * it, other accounts get the machine default. */
+static int sg_elevated_own_userdata( struct object *obj )
+{
+#ifdef SG_MUTANT_ELEVATED_USERDATA_ADMIN
+    return 0;
+#endif
+    return sg_system_prefix && sg_is_own_userdata_key( obj );
+}
