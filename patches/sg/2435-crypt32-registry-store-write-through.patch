From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: registry certificate stores write through, current service of a plain process

From Wine's own store tests (todo_wine, recorded from Windows): a
certificate added to or deleted from a registry-backed system store is in
the registry at once, so another handle sees it before the first closes;
the store being brought up to date by a resync writes nothing back; and
CertRegisterSystemStore/CertOpenStore for CERT_SYSTEM_STORE_CURRENT_SERVICE
work from a process that is no service, which stands in for one under its
program name. 3 todo_wine marks removed. The certresync gate (1662)
expected the opposite for the last point and now expects the store.

Gate: test/regstorethrough-gate.sh (64 and 32 bit). Mutants
SG_MUTANT_REG_LATE, _REG_RESYNC_WRITES and SG_MUTANT_NO_PROCESS_SERVICE
are caught.
---
--- a/dlls/crypt32/regstore.c
+++ b/dlls/crypt32/regstore.c
@@ -39,6 +39,7 @@ typedef struct _WINE_REGSTOREINFO
     HCERTSTORE       memStore;
     HKEY             key;
     BOOL             dirty;
+    BOOL             resyncing; /* the memory store is being brought to what the registry holds */
     CRITICAL_SECTION cs;
     struct list      certsToDelete;
     struct list      crlsToDelete;
@@ -339,15 +340,47 @@ static void WINAPI CRYPT_RegCloseStore(HCERTSTORE hCertStore, DWORD dwFlags)
     CryptMemFree(store);
 }
 
+/* a context added to the store is in the registry at once, not when the store is closed:
+ * another opener of the same store sees it */
+static BOOL CRYPT_RegWriteThrough(WINE_REGSTOREINFO *store, const void *context,
+ const WINE_CONTEXT_INTERFACE *contextInterface, const WCHAR *subKeyName)
+{
+    BYTE hash[20];
+    DWORD hashSize = sizeof(hash), size = 0;
+    BYTE *buf = NULL;
+    HKEY key;
+    BOOL ret = FALSE;
+
+    if (!contextInterface->getProp(context, CERT_HASH_PROP_ID, hash, &hashSize)) return FALSE;
+    contextInterface->serialize(context, 0, NULL, &size);
+    if (!size || !(buf = CryptMemAlloc(size))) return FALSE;
+    if (contextInterface->serialize(context, 0, buf, &size) &&
+        !RegCreateKeyExW(store->key, subKeyName, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL))
+    {
+        ret = CRYPT_WriteSerializedToReg(key, 0, hash, buf, size);
+        RegCloseKey(key);
+    }
+    CryptMemFree(buf);
+    return ret;
+}
+
 static BOOL CRYPT_RegWriteContext(WINE_REGSTOREINFO *store,
- const void *context, DWORD dwFlags)
+ const void *context, DWORD dwFlags, const WINE_CONTEXT_INTERFACE *contextInterface,
+ const WCHAR *subKeyName)
 {
     BOOL ret;
 
+#ifndef SG_MUTANT_REG_RESYNC_WRITES
+    if (store->resyncing) return TRUE;
+#endif
     if (dwFlags & CERT_STORE_PROV_WRITE_ADD_FLAG)
     {
         store->dirty = TRUE;
         ret = TRUE;
+#ifndef SG_MUTANT_REG_LATE
+        /* a failure here is not the add's: the close writes the whole store again */
+        CRYPT_RegWriteThrough(store, context, contextInterface, subKeyName);
+#endif
     }
     else
         ret = FALSE;
@@ -356,10 +389,13 @@ static BOOL CRYPT_RegWriteContext(WINE_REGSTOREINFO *store,
 
 static BOOL CRYPT_RegDeleteContext(WINE_REGSTOREINFO *store,
  struct list *deleteList, const void *context,
- const WINE_CONTEXT_INTERFACE *contextInterface)
+ const WINE_CONTEXT_INTERFACE *contextInterface, const WCHAR *subKeyName)
 {
     BOOL ret;
 
+#ifndef SG_MUTANT_REG_RESYNC_WRITES
+    if (store->resyncing) return TRUE;
+#endif
     if (store->dwOpenFlags & CERT_STORE_READONLY_FLAG)
     {
         SetLastError(ERROR_ACCESS_DENIED);
@@ -390,7 +426,25 @@ static BOOL CRYPT_RegDeleteContext(WINE_REGSTOREINFO *store,
         else
             ret = FALSE;
         if (ret)
+        {
+            BYTE hash[20];
+            DWORD size = sizeof(hash);
+            HKEY key;
+
             store->dirty = TRUE;
+#ifndef SG_MUTANT_REG_LATE
+            /* gone from the registry at once as well */
+            if (contextInterface->getProp(context, CERT_HASH_PROP_ID, hash, &size) &&
+                !RegOpenKeyExW(store->key, subKeyName, 0, KEY_ALL_ACCESS, &key))
+            {
+                WCHAR asciiHash[20 * 2 + 1];
+
+                CRYPT_HashToStr(hash, asciiHash);
+                RegDeleteKeyW(key, asciiHash);
+                RegCloseKey(key);
+            }
+#endif
+        }
     }
     return ret;
 }
@@ -402,7 +456,7 @@ static BOOL WINAPI CRYPT_RegWriteCert(HCERTSTORE hCertStore,
 
     TRACE("(%p, %p, %ld)\n", hCertStore, cert, dwFlags);
 
-    return CRYPT_RegWriteContext(store, cert, dwFlags);
+    return CRYPT_RegWriteContext(store, cert, dwFlags, pCertInterface, L"Certificates");
 }
 
 static BOOL WINAPI CRYPT_RegDeleteCert(HCERTSTORE hCertStore,
@@ -413,7 +467,7 @@ static BOOL WINAPI CRYPT_RegDeleteCert(HCERTSTORE hCertStore,
     TRACE("(%p, %p, %08lx)\n", store, pCertContext, dwFlags);
 
     return CRYPT_RegDeleteContext(store, &store->certsToDelete, pCertContext,
-     pCertInterface);
+     pCertInterface, L"Certificates");
 }
 
 static BOOL WINAPI CRYPT_RegWriteCRL(HCERTSTORE hCertStore,
@@ -423,7 +477,7 @@ static BOOL WINAPI CRYPT_RegWriteCRL(HCERTSTORE hCertStore,
 
     TRACE("(%p, %p, %ld)\n", hCertStore, crl, dwFlags);
 
-    return CRYPT_RegWriteContext(store, crl, dwFlags);
+    return CRYPT_RegWriteContext(store, crl, dwFlags, pCRLInterface, L"CRLs");
 }
 
 static BOOL WINAPI CRYPT_RegDeleteCRL(HCERTSTORE hCertStore,
@@ -434,7 +488,7 @@ static BOOL WINAPI CRYPT_RegDeleteCRL(HCERTSTORE hCertStore,
     TRACE("(%p, %p, %08lx)\n", store, pCrlContext, dwFlags);
 
     return CRYPT_RegDeleteContext(store, &store->crlsToDelete, pCrlContext,
-     pCRLInterface);
+     pCRLInterface, L"CRLs");
 }
 
 static BOOL WINAPI CRYPT_RegWriteCTL(HCERTSTORE hCertStore,
@@ -444,7 +498,7 @@ static BOOL WINAPI CRYPT_RegWriteCTL(HCERTSTORE hCertStore,
 
     TRACE("(%p, %p, %ld)\n", hCertStore, ctl, dwFlags);
 
-    return CRYPT_RegWriteContext(store, ctl, dwFlags);
+    return CRYPT_RegWriteContext(store, ctl, dwFlags, pCTLInterface, L"CTLs");
 }
 
 static BOOL WINAPI CRYPT_RegDeleteCTL(HCERTSTORE hCertStore,
@@ -455,7 +509,7 @@ static BOOL WINAPI CRYPT_RegDeleteCTL(HCERTSTORE hCertStore,
     TRACE("(%p, %p, %08lx)\n", store, pCtlContext, dwFlags);
 
     return CRYPT_RegDeleteContext(store, &store->ctlsToDelete, pCtlContext,
-     pCTLInterface);
+     pCTLInterface, L"CTLs");
 }
 
 /* signal an event when the store changes: its key, or a key under it (the
@@ -518,7 +572,10 @@ static void CRYPT_RegResync(WINE_REGSTOREINFO *store)
 
     CRYPT_RegFlushStore(store, FALSE);
     CRYPT_RegReadFromReg(store->key, memStore, CERT_STORE_ADD_REPLACE_EXISTING);
+    /* what the update adds and removes is the registry's state: none of it goes back there */
+    store->resyncing = TRUE;
     I_CertUpdateStore(store->memStore, memStore, 0, 0);
+    store->resyncing = FALSE;
     CertCloseStore(memStore, 0);
 }
 
@@ -701,6 +758,7 @@ WINECRYPT_CERTSTORE *CRYPT_RegOpenStore(HCRYPTPROV hCryptProv, DWORD dwFlags,
                     list_init(&regInfo->ctlsToDelete);
                     CRYPT_RegReadFromReg(regInfo->key, regInfo->memStore, CERT_STORE_ADD_ALWAYS);
                     regInfo->dirty = FALSE;
+                    regInfo->resyncing = FALSE;
                     provInfo.cbSize = sizeof(provInfo);
                     provInfo.cStoreProvFunc = ARRAY_SIZE(regProvFuncs);
                     provInfo.rgpvStoreProvFunc = regProvFuncs;
--- a/dlls/crypt32/store.c
+++ b/dlls/crypt32/store.c
@@ -427,6 +427,25 @@ static BOOL current_service_name(WCHAR *name, DWORD len)
     }
     CryptMemFree(services);
     CloseServiceHandle(scm);
+#ifndef SG_MUTANT_NO_PROCESS_SERVICE
+    if (!ret)
+    {
+        /* not a service: the process stands in for one, under its program's name */
+        WCHAR path[MAX_PATH], *base, *dot;
+
+        if (GetModuleFileNameW(NULL, path, ARRAY_SIZE(path)))
+        {
+            base = wcsrchr(path, '\\');
+            base = base ? base + 1 : path;
+            if ((dot = wcsrchr(base, '.'))) *dot = 0;
+            if (*base)
+            {
+                lstrcpynW(name, base, len);
+                ret = TRUE;
+            }
+        }
+    }
+#endif
     return ret;
 }
 
