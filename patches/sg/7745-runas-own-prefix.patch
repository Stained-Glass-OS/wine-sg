From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32, msi, kernelbase, msiexec: runas in a prefix of one's own elevates again, and msiexec never relaunches itself twice

7740 took a linked token below impersonation level for unusable, so that a
Stained Glass person's runas goes to the consent broker. Upstream Wine's
linked admin token is at identification level too, and its owner may use it:
in a prefix of one's own (no broker) runas then started the program
unelevated, and msiexec, which relaunches itself with runas for an all-users
package, started itself without end (released in 10.0-861; msifont,
msiallusers and msitransform hung). Usable now means the token can be made a
primary token (DuplicateTokenEx), which a person's query-only handle cannot;
and msiexec's runas relaunch installs as it is, whatever it got. The
relaunch marker is taken out of the environment at once, so nothing msiexec
starts inherits it.
---
diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index 5bb02fd..4377a77 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -808,16 +808,15 @@ static BOOL sg_elevation_required( const WCHAR *app_name, HANDLE token )
          * token). Stained Glass OS 7740: a filtered administrator's is at identification level, and
          * elevation goes through consent, the broker */
         TOKEN_LINKED_TOKEN linked;
-        SECURITY_IMPERSONATION_LEVEL level = SecurityAnonymous;
-        TOKEN_TYPE tok_type = TokenImpersonation;
+        HANDLE dup;
         BOOL usable = FALSE;
 
+        /* 7745: usable means the loader can make it a primary token (as elevate_token does), not its
+         * impersonation level: upstream Wine's is at identification level and its owner's to use */
         if (GetTokenInformation( tok, TokenLinkedToken, &linked, sizeof(linked), &size ))
         {
-            usable = GetTokenInformation( linked.LinkedToken, TokenType, &tok_type, sizeof(tok_type), &size ) &&
-                     (tok_type == TokenPrimary ||
-                      (GetTokenInformation( linked.LinkedToken, TokenImpersonationLevel, &level, sizeof(level), &size ) &&
-                       level >= SecurityImpersonation));
+            if ((usable = DuplicateTokenEx( linked.LinkedToken, 0, NULL, SecurityAnonymous, TokenPrimary, &dup )))
+                CloseHandle( dup );
             CloseHandle( linked.LinkedToken );
         }
 #ifdef SG_MUTANT_LOADER_LIMITED_ANY
diff --git a/dlls/msi/custom.c b/dlls/msi/custom.c
index 0b4496a..fedd50a 100644
--- a/dlls/msi/custom.c
+++ b/dlls/msi/custom.c
@@ -590,19 +590,17 @@ static HANDLE get_admin_token(void)
     if (!GetTokenInformation(GetCurrentThreadEffectiveToken(), TokenLinkedToken, &linked, sizeof(linked), &size))
         return NULL;
     /* Stained Glass OS 7740: a filtered administrator's linked token can be read, not used to start the
-     * custom action server (identification level, query-only); the server then runs as the caller */
+     * custom action server (query-only); the server then runs as the caller. 7745: the test is whether
+     * it can be made a primary token, which upstream Wine's linked admin token can */
     {
-        SECURITY_IMPERSONATION_LEVEL level = SecurityAnonymous;
-        TOKEN_TYPE tok_type = TokenImpersonation;
+        HANDLE dup;
 
-        if (!GetTokenInformation(linked.LinkedToken, TokenType, &tok_type, sizeof(tok_type), &size) ||
-            (tok_type != TokenPrimary &&
-             (!GetTokenInformation(linked.LinkedToken, TokenImpersonationLevel, &level, sizeof(level), &size) ||
-              level < SecurityImpersonation)))
+        if (!DuplicateTokenEx(linked.LinkedToken, 0, NULL, SecurityAnonymous, TokenPrimary, &dup))
         {
             CloseHandle(linked.LinkedToken);
             return NULL;
         }
+        CloseHandle(dup);
     }
     return linked.LinkedToken;
 }
diff --git a/dlls/shell32/shlexec.c b/dlls/shell32/shlexec.c
index 92f4f37..e6bcfdc 100644
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -432,21 +432,22 @@ static HANDLE get_admin_token(void)
     if (!GetTokenInformation(GetCurrentThreadEffectiveToken(), TokenLinkedToken, &linked, sizeof(linked), &size))
         return NULL;
 #ifndef SG_MUTANT_RUNAS_IDENTIFY_TOKEN
-    /* Stained Glass OS 7740: a filtered administrator's linked token is the person's full token at
-     * identification level, which can be read but not used to start a program (as Windows gives it to
-     * a caller without SeTcbPrivilege); elevation then goes through consent, the elevation broker */
+    /* Stained Glass OS 7740: a filtered administrator's linked token is the person's full token, handed
+     * out to query only (as Windows gives it, at identification level, to a caller without
+     * SeTcbPrivilege): it cannot start a program, and elevation goes through consent, the elevation
+     * broker. 7745: the test is whether it can be made a primary token -- upstream Wine's linked admin
+     * token is at identification level too, but its owner may use it (a prefix of one's own) */
     {
-        SECURITY_IMPERSONATION_LEVEL level = SecurityAnonymous;
-        TOKEN_TYPE tok_type = TokenImpersonation;
+        HANDLE dup;
 
-        if (!GetTokenInformation(linked.LinkedToken, TokenType, &tok_type, sizeof(tok_type), &size) ||
-            (tok_type != TokenPrimary &&
-             (!GetTokenInformation(linked.LinkedToken, TokenImpersonationLevel, &level, sizeof(level), &size) ||
-              level < SecurityImpersonation)))
+#ifndef SG_MUTANT_RUNAS_OWN_TOKEN_REFUSED
+        if (!DuplicateTokenEx(linked.LinkedToken, 0, NULL, SecurityAnonymous, TokenPrimary, &dup))
+#endif
         {
             CloseHandle(linked.LinkedToken);
             return NULL;
         }
+        CloseHandle(dup);
     }
 #endif
     return linked.LinkedToken;
diff --git a/programs/msiexec/msiexec.c b/programs/msiexec/msiexec.c
index 3881485..fa56365 100644
--- a/programs/msiexec/msiexec.c
+++ b/programs/msiexec/msiexec.c
@@ -735,6 +735,22 @@ static BOOL package_for_all_users(const WCHAR *package, const WCHAR *properties)
     return !wcscmp(allusers, L"2") && wcscmp(peruser, L"1");
 }
 
+/* the marker is this process's alone: taken out at once, so that nothing it starts (a custom action's
+ * nested msiexec, a program the installer runs at the end) is taken for the relaunch */
+static BOOL relaunched(void)
+{
+    BOOL ret = GetEnvironmentVariableW(L"SG_MSIEXEC_RUNAS", NULL, 0) != 0;
+
+    SetEnvironmentVariableW(L"SG_MSIEXEC_RUNAS", NULL);
+#ifdef SG_MUTANT_MSIEXEC_RELAUNCH_LOOP
+    ret = FALSE;
+#endif
+#ifdef SG_MUTANT_MSIEXEC_MARKER_KEPT
+    if (ret) SetEnvironmentVariableW(L"SG_MSIEXEC_RUNAS", L"1");
+#endif
+    return ret;
+}
+
 static DWORD run_elevated(void)
 {
     SHELLEXECUTEINFOW sei = { sizeof(sei) };
@@ -751,6 +767,7 @@ static DWORD run_elevated(void)
     sei.lpParameters = args;
     sei.nShow = SW_SHOWNORMAL;
     WINE_TRACE("installing for all users, elevated: %s\n", wine_dbgstr_w(args));
+    SetEnvironmentVariableW(L"SG_MSIEXEC_RUNAS", L"1");
     if (!ShellExecuteExW(&sei) || !sei.hProcess) return ERROR_INSTALL_USEREXIT;
     WaitForSingleObject(sei.hProcess, INFINITE);
     GetExitCodeProcess(sei.hProcess, &code);
@@ -760,6 +777,7 @@ static DWORD run_elevated(void)
 
 int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine, int nCmdShow)
 {
+	BOOL was_relaunched = relaunched();  /* first: nothing this process starts inherits the marker */
 	int i;
 	BOOL FunctionInstall = FALSE;
 	BOOL FunctionInstallAdmin = FALSE;
@@ -1208,8 +1226,11 @@ int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine
     if (PatchFileName && !(patch_unquoted = remove_quotes(PatchFileName))) return 1;
     if (DllName && !(dll_unquoted = remove_quotes(DllName))) return 1;
 
+	/* Stained Glass OS 7745: the msiexec "runas" started installs as it is, elevated or not: when
+	 * elevation could not be had (no consent broker, a token that cannot be used), each one started
+	 * the next, without end */
 	if ((FunctionInstall || FunctionRepair) && !FunctionInstallAdmin && package_unquoted &&
-	    !process_elevated() && package_for_all_users(package_unquoted, Properties))
+	    !process_elevated() && !was_relaunched && package_for_all_users(package_unquoted, Properties))
 		ExitProcess(run_elevated());
 
 	ReturnCode = 1;
