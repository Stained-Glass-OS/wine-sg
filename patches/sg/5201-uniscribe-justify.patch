From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] gdi32: ScriptApplyLogicalWidth and ScriptJustify

ScriptApplyLogicalWidth turns logical character widths into glyph advances
(clusters add up, a character over several glyphs is shared, zero-width
glyphs take none) and rebuilds the ABC width. ScriptJustify gives the width
change to kashida points, then blanks, then characters, and returns S_FALSE
with the advances copied when nothing can be justified. CORE: integrator must
review (patches/notes/5201.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/gdi32/uniscribe/usp10.c b/dlls/gdi32/uniscribe/usp10.c
--- a/dlls/gdi32/uniscribe/usp10.c
+++ b/dlls/gdi32/uniscribe/usp10.c
@@ -4024,24 +4024,151 @@
                                        const int *advance, const SCRIPT_ANALYSIS *sa,
                                        ABC *abc, int *justify)
 {
-    int i;
+    int i, g, *acc, total;
 
-    FIXME("(%p, %d, %d, %p, %p, %p, %p, %p, %p)\n",
+    TRACE("(%p, %d, %d, %p, %p, %p, %p, %p, %p)\n",
           dx, num_chars, num_glyphs, log_clust, sva, advance, sa, abc, justify);
 
+    if (!dx || !log_clust || !sva || !advance || !sa || !justify || num_chars < 0 || num_glyphs < 0)
+        return E_INVALIDARG;
+    if (!num_glyphs) return S_OK;
+#ifdef SG_MUTANT_ALW_COPY
     for (i = 0; i < num_chars; i++) justify[i] = advance[i];
     return S_OK;
+#endif
+
+    /* the logical width of every character of a cluster adds up to the cluster's advance */
+    if (!(acc = heap_calloc(num_glyphs, sizeof(*acc)))) return E_OUTOFMEMORY;
+    for (i = 0; i < num_chars; i++)
+    {
+        if (log_clust[i] >= num_glyphs)
+        {
+            heap_free(acc);
+            return E_INVALIDARG;
+        }
+        acc[log_clust[i]] += dx[i];
+    }
+
+    /* a cluster is the run of glyphs from its first glyph to the next cluster's first glyph;
+     * the glyphs that take part in the advance share the cluster's width equally */
+    memset(justify, 0, num_glyphs * sizeof(*justify));
+    for (g = 0; g < num_glyphs;)
+    {
+        int end = g + 1, i2, count = 0, last = -1, share, rest;
+        BOOL is_start = FALSE;
+
+        for (i2 = 0; i2 < num_chars; i2++) if (log_clust[i2] == g) is_start = TRUE;
+        while (end < num_glyphs)
+        {
+            BOOL next_start = FALSE;
+            for (i2 = 0; i2 < num_chars; i2++) if (log_clust[i2] == end) next_start = TRUE;
+            if (next_start) break;
+            end++;
+        }
+        if (!is_start)
+        {
+            /* a glyph before any character's cluster: keep what the shaper made */
+            for (i2 = g; i2 < end; i2++) justify[i2] = advance[i2];
+            g = end;
+            continue;
+        }
+        for (i2 = g; i2 < end; i2++)
+            if (!sva[i2].fZeroWidth) { count++; last = i2; }
+        if (!count) { count = 1; last = end - 1; }
+        share = acc[g] / count;
+        rest = acc[g] - share * count;
+        for (i2 = g; i2 < end; i2++)
+            if (!sva[i2].fZeroWidth) justify[i2] = share;
+        justify[last] += rest;
+        g = end;
+    }
+    heap_free(acc);
+
+#ifndef SG_MUTANT_ALW_NOABC
+    if (abc)
+    {
+        for (total = 0, g = 0; g < num_glyphs; g++) total += justify[g];
+        /* the black part takes up what the new advances leave beside the bearings */
+        abc->abcB = total - abc->abcA - abc->abcC;
+    }
+#endif
+    return S_OK;
 }
 
+static BOOL is_kashida_class(unsigned int c)
+{
+    return c >= SCRIPT_JUSTIFY_ARABIC_NORMAL && c <= SCRIPT_JUSTIFY_ARABIC_SEEN_M;
+}
+
+static BOOL is_blank_class(unsigned int c)
+{
+    return c == SCRIPT_JUSTIFY_BLANK || c == SCRIPT_JUSTIFY_ARABIC_BLANK;
+}
+
+static BOOL is_character_class(unsigned int c)
+{
+    return c == SCRIPT_JUSTIFY_CHARACTER;
+}
+
+/***********************************************************************
+ *      ScriptJustify (USP10.@)
+ *
+ * Generate justified glyph advances: kashida points take the change first,
+ * then the blanks, then the characters (Uniscribe's documented priority).
+ *
+ * PARAMS
+ *  sva          [I] Visual attributes of the glyphs.
+ *  advance      [I] Glyph advance widths.
+ *  num_glyphs   [I] Number of glyphs.
+ *  dx           [I] Change in the line's width, positive or negative.
+ *  min_kashida  [I] Narrowest kashida to generate.
+ *  justify      [O] Justified advance widths.
+ *
+ * RETURNS
+ *  S_OK, or S_FALSE when no glyph can be justified (the advances are copied).
+ */
 HRESULT WINAPI ScriptJustify(const SCRIPT_VISATTR *sva, const int *advance,
                              int num_glyphs, int dx, int min_kashida, int *justify)
 {
-    int i;
+    BOOL (*is_class[])(unsigned int) = { is_kashida_class, is_blank_class, is_character_class };
+    int i, c, cn, count, share, rest, use, seen;
+
+    TRACE("(%p, %p, %d, %d, %d, %p)\n", sva, advance, num_glyphs, dx, min_kashida, justify);
 
-    FIXME("(%p, %p, %d, %d, %d, %p)\n", sva, advance, num_glyphs, dx, min_kashida, justify);
+    if (!sva || !advance || !justify || num_glyphs < 0) return E_INVALIDARG;
 
     for (i = 0; i < num_glyphs; i++) justify[i] = advance[i];
+    if (!dx) return S_OK;
+#ifdef SG_MUTANT_JUST_COPY
     return S_OK;
+#endif
+
+    for (cn = 0; cn < ARRAY_SIZE(is_class); cn++)
+    {
+        c = cn;
+#ifdef SG_MUTANT_JUST_NOPRIO
+        c = ARRAY_SIZE(is_class) - 1 - cn;
+#endif
+        for (count = 0, i = 0; i < num_glyphs; i++)
+            if (is_class[c](sva[i].uJustification) && !sva[i].fZeroWidth) count++;
+        if (!count) continue;
+
+        /* a kashida is never narrower than asked: use fewer points rather than thin ones */
+        use = count;
+        if (c == 0 && min_kashida > 0 && abs(dx) / count < min_kashida)
+            use = max(1, abs(dx) / min_kashida);
+        share = dx / use;
+        rest = dx - share * use;
+        /* the extra width goes to the last glyphs of the class, in visual order */
+        for (seen = 0, i = num_glyphs - 1; i >= 0 && seen < use; i--)
+        {
+            if (!is_class[c](sva[i].uJustification) || sva[i].fZeroWidth) continue;
+            justify[i] = max(0, advance[i] + share + (seen == 0 ? rest : 0));
+            seen++;
+        }
+        return S_OK;
+    }
+    return S_FALSE;
 }
 
 HRESULT WINAPI ScriptGetFontScriptTags( HDC hdc, SCRIPT_CACHE *psc, SCRIPT_ANALYSIS *psa, int cMaxTags, OPENTYPE_TAG *pScriptTags, int *pcTags)
