+/* ---- dependencies and resources ---------------------------------------------- */
+
+struct dependency_obj
+{
+    IAppxManifestPackageDependency IAppxManifestPackageDependency_iface;
+    LONG ref;
+    struct manifest *manifest;
+    unsigned int index;
+};
+
+static inline struct dependency_obj *impl_from_IAppxManifestPackageDependency( IAppxManifestPackageDependency *iface )
+{
+    return CONTAINING_RECORD( iface, struct dependency_obj, IAppxManifestPackageDependency_iface );
+}
+
+static HRESULT WINAPI dependency_QueryInterface( IAppxManifestPackageDependency *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxManifestPackageDependency ))
+    {
+        *out = iface;
+        IUnknown_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI dependency_AddRef( IAppxManifestPackageDependency *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxManifestPackageDependency( iface )->ref );
+}
+
+static ULONG WINAPI dependency_Release( IAppxManifestPackageDependency *iface )
+{
+    struct dependency_obj *impl = impl_from_IAppxManifestPackageDependency( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        IAppxManifestReader_Release( &impl->manifest->IAppxManifestReader_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI dependency_GetName( IAppxManifestPackageDependency *iface, LPWSTR *name )
+{
+    struct dependency_obj *impl = impl_from_IAppxManifestPackageDependency( iface );
+    if (!name) return E_POINTER;
+    return (*name = co_strdupW( impl->manifest->deps[impl->index].name )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI dependency_GetPublisher( IAppxManifestPackageDependency *iface, LPWSTR *publisher )
+{
+    struct dependency_obj *impl = impl_from_IAppxManifestPackageDependency( iface );
+    if (!publisher) return E_POINTER;
+    return (*publisher = co_strdupW( impl->manifest->deps[impl->index].publisher )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI dependency_GetMinVersion( IAppxManifestPackageDependency *iface, UINT64 *version )
+{
+    struct dependency_obj *impl = impl_from_IAppxManifestPackageDependency( iface );
+    if (!version) return E_POINTER;
+    *version = impl->manifest->deps[impl->index].min_version;
+    return S_OK;
+}
+
+static const IAppxManifestPackageDependencyVtbl dependency_vtbl =
