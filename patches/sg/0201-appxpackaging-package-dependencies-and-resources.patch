+
+static HRESULT WINAPI dep_enum_GetCurrent( IAppxManifestPackageDependenciesEnumerator *iface,
+                                           IAppxManifestPackageDependency **out )
+{
+    struct list_enum *impl = impl_from_IAppxManifestPackageDependenciesEnumerator( iface );
+    struct dependency_obj *dep;
+
+    if (!out) return E_POINTER;
+    if (impl->index >= impl->count) return APPX_E_INVALID_MANIFEST;
+    if (!(dep = calloc( 1, sizeof(*dep) ))) return E_OUTOFMEMORY;
+    dep->IAppxManifestPackageDependency_iface.lpVtbl = &dependency_vtbl;
+    dep->ref = 1;
+    dep->manifest = impl->manifest;
+    dep->index = impl->index;
+    IAppxManifestReader_AddRef( &impl->manifest->IAppxManifestReader_iface );
+    *out = &dep->IAppxManifestPackageDependency_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI dep_enum_GetHasCurrent( IAppxManifestPackageDependenciesEnumerator *iface, BOOL *has_current )
+{
+    struct list_enum *impl = impl_from_IAppxManifestPackageDependenciesEnumerator( iface );
+    if (!has_current) return E_POINTER;
+    *has_current = impl->index < impl->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI dep_enum_MoveNext( IAppxManifestPackageDependenciesEnumerator *iface, BOOL *has_next )
+{
+    struct list_enum *impl = impl_from_IAppxManifestPackageDependenciesEnumerator( iface );
+    if (!has_next) return E_POINTER;
+    if (impl->index < impl->count) impl->index++;
+    *has_next = impl->index < impl->count;
+    return S_OK;
+}
