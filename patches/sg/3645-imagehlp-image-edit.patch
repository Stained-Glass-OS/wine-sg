From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] imagehlp: image config information, unused header bytes, RemoveRelocations (3645)

imagehlp: image config information, unused header bytes, RemoveRelocations
---
diff --git a/dlls/imagehlp/access.c b/dlls/imagehlp/access.c
index a15b99f..025d9a8 100644
--- a/dlls/imagehlp/access.c
+++ b/dlls/imagehlp/access.c
@@ -44,11 +44,29 @@ BOOL WINAPI GetImageConfigInformation(
   PLOADED_IMAGE LoadedImage,
   PIMAGE_LOAD_CONFIG_DIRECTORY ImageConfigInformation)
 {
-  FIXME("(%p, %p): stub\n",
-    LoadedImage, ImageConfigInformation
-  );
-  SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-  return FALSE;
+  PIMAGE_LOAD_CONFIG_DIRECTORY dir;
+  ULONG size;
+
+  TRACE("(%p, %p)\n", LoadedImage, ImageConfigInformation);
+
+  if (!LoadedImage || !ImageConfigInformation)
+  {
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+  }
+  dir = RtlImageDirectoryEntryToData((void *)LoadedImage->MappedAddress, FALSE,
+                                     IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG, &size);
+  if (!dir || size < sizeof(DWORD))
+  {
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+  }
+  /* the directory starts with its own size: a shorter one is zero extended */
+  memset(ImageConfigInformation, 0, sizeof(*ImageConfigInformation));
+#ifndef SG_MUTANT_CFG_ZERO
+  memcpy(ImageConfigInformation, dir, min(min(size, dir->Size), sizeof(*ImageConfigInformation)));
+#endif
+  return TRUE;
 }
 
 /***********************************************************************
@@ -58,11 +76,28 @@ DWORD WINAPI GetImageUnusedHeaderBytes(
   PLOADED_IMAGE LoadedImage,
   LPDWORD SizeUnusedHeaderBytes)
 {
-  FIXME("(%p, %p): stub\n",
-    LoadedImage, SizeUnusedHeaderBytes
-  );
-  SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-  return 0;
+  DWORD first_raw = ~0u, headers_end, i;
+
+  TRACE("(%p, %p)\n", LoadedImage, SizeUnusedHeaderBytes);
+
+  if (!LoadedImage || !SizeUnusedHeaderBytes || !LoadedImage->FileHeader)
+  {
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return 0;
+  }
+  /* the room between the end of the section table and the first section's data */
+  for (i = 0; i < LoadedImage->NumberOfSections; i++)
+  {
+    DWORD raw = LoadedImage->Sections[i].PointerToRawData;
+    if (raw && raw < first_raw) first_raw = raw;
+  }
+  headers_end = (BYTE *)(LoadedImage->Sections + LoadedImage->NumberOfSections) - LoadedImage->MappedAddress;
+  *SizeUnusedHeaderBytes = first_raw != ~0u && first_raw > headers_end ? first_raw - headers_end : 0;
+  /* the return value is where the unused bytes start (the end of the section table) */
+#ifdef SG_MUTANT_UNUSED_RET
+  return *SizeUnusedHeaderBytes;
+#endif
+  return headers_end;
 }
 
 /***********************************************************************
@@ -214,11 +249,26 @@ BOOL WINAPI SetImageConfigInformation(
   PLOADED_IMAGE LoadedImage,
   PIMAGE_LOAD_CONFIG_DIRECTORY ImageConfigInformation)
 {
-  FIXME("(%p, %p): stub\n",
-    LoadedImage, ImageConfigInformation
-  );
-  SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-  return FALSE;
+  PIMAGE_LOAD_CONFIG_DIRECTORY dir;
+  ULONG size;
+
+  TRACE("(%p, %p)\n", LoadedImage, ImageConfigInformation);
+
+  if (!LoadedImage || !ImageConfigInformation)
+  {
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+  }
+  dir = RtlImageDirectoryEntryToData((void *)LoadedImage->MappedAddress, FALSE,
+                                     IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG, &size);
+  if (!dir || size < sizeof(DWORD) || LoadedImage->fReadOnly)
+  {
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+  }
+  /* the new data replaces the directory in the mapped file, up to the size the file has room for */
+  memcpy(dir, ImageConfigInformation, min(size, sizeof(*ImageConfigInformation)));
+  return TRUE;
 }
 
 /***********************************************************************
diff --git a/dlls/imagehlp/modify.c b/dlls/imagehlp/modify.c
index dc2b7e1..655fde9 100644
--- a/dlls/imagehlp/modify.c
+++ b/dlls/imagehlp/modify.c
@@ -377,8 +377,24 @@ BOOL WINAPI RemovePrivateCvSymbolic(
  */
 VOID WINAPI RemoveRelocations(PCHAR ImageName)
 {
-  FIXME("(%p): stub\n", ImageName);
-  SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+  LOADED_IMAGE image;
+  PIMAGE_DATA_DIRECTORY dir;
+
+  TRACE("(%s)\n", debugstr_a(ImageName));
+
+  if (!MapAndLoad(ImageName, NULL, &image, FALSE, FALSE))
+    return;
+  /* the relocations are marked as stripped and the base relocation directory is emptied */
+  image.FileHeader->FileHeader.Characteristics |= IMAGE_FILE_RELOCS_STRIPPED;
+  if (image.FileHeader->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC)
+    dir = ((PIMAGE_NT_HEADERS64)image.FileHeader)->OptionalHeader.DataDirectory;
+  else
+    dir = ((PIMAGE_NT_HEADERS32)image.FileHeader)->OptionalHeader.DataDirectory;
+#ifndef SG_MUTANT_RELOCS_KEEP
+  dir[IMAGE_DIRECTORY_ENTRY_BASERELOC].VirtualAddress = 0;
+  dir[IMAGE_DIRECTORY_ENTRY_BASERELOC].Size = 0;
+#endif
+  UnMapAndLoad(&image);
 }
 
 /***********************************************************************
diff --git a/dlls/imagehlp/tests/image.c b/dlls/imagehlp/tests/image.c
index 1432f13..982e7d3 100644
--- a/dlls/imagehlp/tests/image.c
+++ b/dlls/imagehlp/tests/image.c
@@ -619,9 +619,7 @@ static void test_image_load(void)
 
         count = 0xdeadbeef;
         ret = GetImageUnusedHeaderBytes(img, &count);
-        todo_wine
         ok(ret == 448, "GetImageUnusedHeaderBytes returned %lu instead of 448\n", ret);
-        todo_wine
         ok(count == 64, "unexpected size for unused header bytes, got %lu instead of 64\n", count);
 
         ImageUnload(img);
@@ -630,9 +628,89 @@ static void test_image_load(void)
     DeleteFileA(temp_file);
 }
 
+static void test_sg_image_edit(void)
+{
+    char self[MAX_PATH], copy[MAX_PATH];
+    IMAGE_LOAD_CONFIG_DIRECTORY cfg;
+    LOADED_IMAGE image;
+    DWORD unused, ret;
+    IMAGE_DATA_DIRECTORY *dir;
+    BOOL has_relocs, r;
+
+    GetModuleFileNameA(NULL, self, sizeof(self));
+    GetTempPathA(sizeof(copy), copy);
+    strcat(copy, "sgimagehlp.exe");
+    r = CopyFileA(self, copy, FALSE);
+    ok(r, "CopyFile failed %lu.\n", GetLastError());
+
+    memset(&image, 0, sizeof(image));
+    r = MapAndLoad(copy, NULL, &image, FALSE, FALSE);
+    ok(r, "MapAndLoad failed %lu.\n", GetLastError());
+    if (!r) { DeleteFileA(copy); return; }
+
+    SetLastError(0xdeadbeef);
+    r = GetImageConfigInformation(NULL, &cfg);
+    ok(!r && GetLastError() == ERROR_INVALID_PARAMETER, "Got %d, %lu.\n", r, GetLastError());
+
+    /* give the copy a load configuration directory inside its first section */
+    dir = &image.FileHeader->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG];
+    ok(!dir->VirtualAddress, "The test executable has a load configuration directory.\n");
+    memset(&cfg, 0xcc, sizeof(cfg));
+    r = GetImageConfigInformation(&image, &cfg);
+    ok(!r, "GetImageConfigInformation succeeded without a directory.\n");
+    {
+        IMAGE_LOAD_CONFIG_DIRECTORY *raw = (void *)(image.MappedAddress + image.Sections[0].PointerToRawData + 0x10);
+
+        memset(raw, 0, 0x40);
+        raw->Size = 0x40;
+        raw->GlobalFlagsClear = 0x777;
+        dir->VirtualAddress = image.Sections[0].VirtualAddress + 0x10;
+        dir->Size = 0x40;
+    }
+    memset(&cfg, 0xcc, sizeof(cfg));
+    r = GetImageConfigInformation(&image, &cfg);
+    ok(r, "GetImageConfigInformation failed %lu.\n", GetLastError());
+    ok(cfg.Size == 0x40 && cfg.GlobalFlagsClear == 0x777, "Got size %lu, flags %#lx.\n", cfg.Size, cfg.GlobalFlagsClear);
+    ok(!cfg.GlobalFlagsSet && !cfg.CriticalSectionDefaultTimeout, "The rest is not zero.\n");
+    cfg.GlobalFlagsClear = 0x12345;
+    r = SetImageConfigInformation(&image, &cfg);
+    ok(r, "SetImageConfigInformation failed %lu.\n", GetLastError());
+    memset(&cfg, 0, sizeof(cfg));
+    r = GetImageConfigInformation(&image, &cfg);
+    ok(r && cfg.GlobalFlagsClear == 0x12345, "Got %d, %#lx.\n", r, cfg.GlobalFlagsClear);
+
+    ret = GetImageUnusedHeaderBytes(&image, &unused);
+    ok(ret > sizeof(IMAGE_DOS_HEADER) && ret + unused <= image.Sections[0].PointerToRawData + 0x1000,
+            "Got %lu and %lu.\n", ret, unused);
+    ok(unused < 0x10000, "Got %lu unused header bytes.\n", unused);
+    ok(!GetImageUnusedHeaderBytes(&image, NULL), "NULL pointer accepted.\n");
+    UnMapAndLoad(&image);
+
+    memset(&image, 0, sizeof(image));
+    MapAndLoad(copy, NULL, &image, FALSE, TRUE);
+    has_relocs = !!image.FileHeader->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_BASERELOC].VirtualAddress;
+    UnMapAndLoad(&image);
+
+    RemoveRelocations(copy);
+    memset(&image, 0, sizeof(image));
+    r = MapAndLoad(copy, NULL, &image, FALSE, TRUE);
+    ok(r, "MapAndLoad failed %lu.\n", GetLastError());
+    if (r)
+    {
+        ok(image.FileHeader->FileHeader.Characteristics & IMAGE_FILE_RELOCS_STRIPPED,
+                "Relocations not marked as stripped (had directory: %d).\n", has_relocs);
+        ok(!image.FileHeader->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_BASERELOC].VirtualAddress
+                && !image.FileHeader->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_BASERELOC].Size,
+                "Base relocation directory is not empty.\n");
+        UnMapAndLoad(&image);
+    }
+    DeleteFileA(copy);
+}
+
 START_TEST(image)
 {
     test_get_digest_stream();
     test_bind_image_ex();
     test_image_load();
+    test_sg_image_edit();
 }
