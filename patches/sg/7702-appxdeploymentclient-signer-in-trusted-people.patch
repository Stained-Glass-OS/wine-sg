From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxdeploymentclient: a package whose signer is in the machine's TrustedPeople installs

---
diff --git a/dlls/appxdeploymentclient/Makefile.in b/dlls/appxdeploymentclient/Makefile.in
index dab7b9c..455a9e1 100644
--- a/dlls/appxdeploymentclient/Makefile.in
+++ b/dlls/appxdeploymentclient/Makefile.in
@@ -1,5 +1,5 @@
 MODULE  = appxdeploymentclient.dll
-IMPORTS = combase ole32 shell32 shlwapi wintrust advapi32 urlmon xmllite user32
+IMPORTS = combase ole32 shell32 shlwapi wintrust crypt32 advapi32 urlmon xmllite user32
 
 SOURCES = \
 	applist.c \
diff --git a/dlls/appxdeploymentclient/deploy.c b/dlls/appxdeploymentclient/deploy.c
index d14212f..31977ec 100644
--- a/dlls/appxdeploymentclient/deploy.c
+++ b/dlls/appxdeploymentclient/deploy.c
@@ -646,6 +646,30 @@ static HRESULT staging_root( WCHAR *root, size_t size )
     return S_OK;
 }
 
+/* The verified file's signer: its certificate, from the signature's chain. */
+static BOOL signer_in_trusted_people( HANDLE state )
+{
+    CRYPT_PROVIDER_DATA *prov = WTHelperProvDataFromStateData( state );
+    CRYPT_PROVIDER_SGNR *signer;
+    const CERT_CONTEXT *cert = NULL, *found;
+    HCERTSTORE store;
+
+    if (!prov || !(signer = WTHelperGetProvSignerFromChain( prov, 0, FALSE, 0 ))) return FALSE;
+    if (signer->csCertChain && signer->pasCertChain && signer->pasCertChain[0].pCert)
+        cert = signer->pasCertChain[0].pCert;
+    else if (signer->pChainContext && signer->pChainContext->cChain &&
+             signer->pChainContext->rgpChain[0]->cElement)
+        cert = signer->pChainContext->rgpChain[0]->rgpElement[0]->pCertContext;
+    if (!cert) return FALSE;
+    if (!(store = CertOpenStore( CERT_STORE_PROV_SYSTEM_W, 0, 0, CERT_SYSTEM_STORE_LOCAL_MACHINE |
+                                 CERT_STORE_OPEN_EXISTING_FLAG | CERT_STORE_READONLY_FLAG, L"TrustedPeople" )))
+        return FALSE;
+    found = CertFindCertificateInStore( store, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, 0, CERT_FIND_EXISTING, cert, NULL );
+    if (found) CertFreeCertificateContext( found );
+    CertCloseStore( store, 0 );
+    return found != NULL;
+}
+
 static HRESULT verify_signature( const WCHAR *path )
 {
     GUID action = WINTRUST_ACTION_GENERIC_VERIFY_V2;
@@ -660,6 +684,16 @@ static HRESULT verify_signature( const WCHAR *path )
     data.pFile = &file;
     data.dwStateAction = WTD_STATEACTION_VERIFY;
     status = WinVerifyTrust( INVALID_HANDLE_VALUE, &action, &data );
+#ifndef SG_MUTANT_AX_NO_TRUSTED_PEOPLE
+    /* Stained Glass OS: as on Windows, a package whose signer's own certificate the machine trusts
+     * (LocalMachine\TrustedPeople, where a sideloaded package's .cer goes) installs although its
+     * chain ends in no trusted root; the signature itself must be good */
+    if ((status == CERT_E_UNTRUSTEDROOT || status == CERT_E_CHAINING) && signer_in_trusted_people( data.hWVTStateData ))
+    {
+        TRACE( "%s: the signer is in TrustedPeople\n", debugstr_w( path ) );
+        status = ERROR_SUCCESS;
+    }
+#endif
     data.dwStateAction = WTD_STATEACTION_CLOSE;
     WinVerifyTrust( INVALID_HANDLE_VALUE, &action, &data );
     return status;
