+
+/* Presentation statistics, as reported through IQualProp. Times are 100ns units, reported values are
+   milliseconds unless noted. */
+static void video_presenter_update_stats(struct video_presenter *presenter, IMFSample *sample)
+{
+    LONGLONG now = MFGetSystemTime(), pts = 0, clocktime = 0, expected, interval;
+    BOOL have_offset = FALSE;
+    MFTIME systime;
+    double offset;
+
+    if (presenter->clock && SUCCEEDED(IMFSample_GetSampleTime(sample, &pts))
+            && SUCCEEDED(IMFClock_GetCorrelatedTime(presenter->clock, 0, &clocktime, &systime)))
+        have_offset = TRUE;
+
+    EnterCriticalSection(&presenter->stats_cs);
+
+    if (!presenter->frame_stats.presented)
+        presenter->frame_stats.first_time = now;
+    else
+    {
+        interval = now - presenter->frame_stats.last_time;
+        expected = presenter->frame_time_threshold * 4;
+        presenter->frame_stats.jitter = (int)(llabs(interval - expected) / 10000);
+    }
+    presenter->frame_stats.last_time = now;
+#ifndef SG_MUTANT_STATS_NOCOUNT
+    presenter->frame_stats.presented++;
+#endif
+
+    if (have_offset)
+    {
+        offset = (double)(clocktime - pts) / 10000.0;
+        presenter->frame_stats.sync_count++;
+        presenter->frame_stats.sync_sum += offset;
+        presenter->frame_stats.sync_sumsq += offset * offset;
+    }
+
+    LeaveCriticalSection(&presenter->stats_cs);
+}
