+/* Without thinning the presenter can show a frame per display refresh at most, so the fastest rate is the
+   display refresh rate over the frame rate. */
+static float video_presenter_get_max_rate(struct video_presenter *presenter, BOOL thin)
+{
+    float max_rate = FLT_MAX;
+    UINT64 frame_rate;
+    DEVMODEW mode;
+
+    if (thin || !presenter->media_type)
+        return max_rate;
+
+    if (FAILED(IMFMediaType_GetUINT64(presenter->media_type, &MF_MT_FRAME_RATE, &frame_rate))
+            || !(frame_rate >> 32) || !(UINT32)frame_rate)
+        return max_rate;
+
+    memset(&mode, 0, sizeof(mode));
+    mode.dmSize = sizeof(mode);
+    if (!EnumDisplaySettingsW(NULL, ENUM_CURRENT_SETTINGS, &mode) || mode.dmDisplayFrequency <= 1)
+        mode.dmDisplayFrequency = 60;
+
+    return (float)mode.dmDisplayFrequency * (UINT32)frame_rate / (float)(frame_rate >> 32);
+}
+
