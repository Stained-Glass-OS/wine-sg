+
+    if (presenter->state == PRESENTER_STATE_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        *rate = video_presenter_get_max_rate(presenter, thin);
+        if (direction == MFRATE_REVERSE)
+            *rate = -*rate;
+    }
+
+    LeaveCriticalSection(&presenter->cs);
+
+    return hr;
 }
 
