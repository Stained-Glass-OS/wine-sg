From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, winex11: a screen turned upright -- the desktop may take its size

Wine's virtual desktop offered a portrait screen's own size only turned
sideways, so after auto-rotate the shell's desktop could not follow (the
bottom of the screen unused, the taskbar not along the turned screen's
bottom, its icons cut off). The size as it is is offered too, and winex11
learns the new screen size when the screen changes. Field report 2026-10-17.
---
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -1699,7 +1699,7 @@
      * device, which isn't necessarily a horizontal mode */
     vertical = initial->dmPelsHeight > initial->dmPelsWidth;
 
-    modes = malloc( ARRAY_SIZE(depths) * (ARRAY_SIZE(screen_sizes) + 2) * sizeof(*modes) );
+    modes = malloc( ARRAY_SIZE(depths) * (ARRAY_SIZE(screen_sizes) + 4) * sizeof(*modes) );
 
     for (count = i = 0; modes && i < ARRAY_SIZE(depths); ++i)
     {
@@ -1733,6 +1733,25 @@
             mode.dmPelsHeight = vertical ? maximum->dmPelsWidth : maximum->dmPelsHeight;
             modes[count++] = mode;
         }
+
+#ifndef SG_MUTANT_NO_PORTRAIT_MODE
+        /* Stained Glass: a screen turned upright (a tablet's auto-rotate, a
+         * portrait monitor) -- its own size, as it is, is a size the desktop
+         * may take; above only its sideways twin was offered, so the shell's
+         * desktop could not follow the turned screen (David, 2026-10-17) */
+        if (vertical)
+        {
+            mode.dmPelsWidth = maximum->dmPelsWidth;
+            mode.dmPelsHeight = maximum->dmPelsHeight;
+            modes[count++] = mode;
+            if (initial->dmPelsWidth != maximum->dmPelsWidth || initial->dmPelsHeight != maximum->dmPelsHeight)
+            {
+                mode.dmPelsWidth = initial->dmPelsWidth;
+                mode.dmPelsHeight = initial->dmPelsHeight;
+                modes[count++] = mode;
+            }
+        }
+#endif
     }
 
     *modes_count = count;
--- a/dlls/winex11.drv/desktop.c
+++ b/dlls/winex11.drv/desktop.c
@@ -95,6 +95,13 @@
     return TRUE;
 }
 
+/* Stained Glass: the screen changed (turned, a new mode): what "the whole
+ * screen" is, for a desktop that fills it */
+void X11DRV_desktop_host_changed(void)
+{
+    host_primary_rect = get_host_primary_monitor_rect();
+}
+
 BOOL is_desktop_fullscreen(void)
 {
     RECT primary_rect = NtUserGetPrimaryMonitorRect();
--- a/dlls/winex11.drv/xrandr.c
+++ b/dlls/winex11.drv/xrandr.c
@@ -1220,6 +1220,7 @@
     /* Update xinerama monitors for xinerama_get_fullscreen_monitors() */
     rect = get_host_primary_monitor_rect();
     xinerama_init( rect.right - rect.left, rect.bottom - rect.top );
+    if (is_virtual_desktop()) X11DRV_desktop_host_changed();
     return FALSE;
 }
 
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -856,6 +856,7 @@
 extern void X11DRV_init_desktop( Window win, unsigned int width, unsigned int height );
 extern BOOL is_virtual_desktop(void);
 extern BOOL is_desktop_fullscreen(void);
+extern void X11DRV_desktop_host_changed(void);
 extern BOOL is_detached_mode(const DEVMODEW *);
 void X11DRV_Settings_Init(void);
 
