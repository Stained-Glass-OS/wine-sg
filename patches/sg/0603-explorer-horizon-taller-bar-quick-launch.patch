From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Horizon closer to its era -- a taller bar, Quick Launch

David: the Horizon bar should be thicker and match XP more closely. The bar
is 38 px; Start says "start" in small letters, larger; pinned programs are a
Quick Launch strip -- 26 px icons that stay while their program runs, whose
windows get buttons of their own after an etched line. The other looks keep
the running window in its pin's place.
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -152,6 +152,7 @@
 static int icon_cx, icon_cy, tray_width, tray_height;
 static int start_button_width, taskbar_button_width;
 static WCHAR start_label[50];
+static WCHAR sg_horizon_label[50];   /* Horizon's: in small letters, as those desktops wrote it */
 
 static struct icon *balloon_icon;
 static HWND balloon_window;
@@ -211,7 +212,13 @@
  * bar's colour (Taskbar color) and the Rounded style's bar. */
 enum { SG_LOOK_FLAT, SG_LOOK_HORIZON, SG_LOOK_GLASS };
 static DWORD sg_look;
-#define SG_HORIZON_HEIGHT   30  /* Horizon's bar */
+#define SG_HORIZON_HEIGHT   38  /* Horizon's bar: the taller bar of those desktops (David: "thicker") */
+/* Horizon's pinned programs are a Quick Launch strip, as on those desktops:
+ * small icons, always there (a running program's windows get buttons of their
+ * own after them), and an etched line between them and the window buttons */
+#define SG_QL_BUTTON        26
+#define SG_QL_GAP           12
+static int sg_ql_sep = -1;      /* where that line is, along the bar (-1: none) */
 #define SG_HORIZON_TRAY_PAD 10  /* the notification panel's edge before the icons */
 static const struct sg_palette sg_horizon_palette =
     { RGB(0x28,0x62,0xD8), RGB(0x4A,0x8A,0xF0), RGB(0x1C,0x4A,0xAE), RGB(0xFF,0xFF,0xFF) };
@@ -267,6 +274,7 @@
 {
     return sg_look == SG_LOOK_GLASS && !sg_bar.small && !sg_vertical() ? 60 : 48;
 }
+static BOOL sg_quick_launch(void) { return sg_look == SG_LOOK_HORIZON && !sg_vertical(); }
 static int sg_clock_len(void)
 {
     if (sg_look == SG_LOOK_HORIZON) return sg_vertical() ? 30 : 72;   /* the time alone */
@@ -1084,9 +1092,10 @@
         BOOL running = FALSE;
         LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
             if (win->hwnd && win->visible && win->exe[0] && !wcsicmp( win->exe, sg_pins[i].target )) running = TRUE;
-        if (!running) idle_pins++;
+        if (!running || sg_quick_launch()) idle_pins++;
     }
-    head += idle_pins * SG_ICON_BUTTON;
+    if (sg_quick_launch()) head += idle_pins * SG_QL_BUTTON + (idle_pins ? SG_QL_GAP : 0);
+    else head += idle_pins * SG_ICON_BUTTON;
     combine = sg_bar.glom == 0 ||
               (sg_bar.glom == 1 && (sg_vertical() || head + count * taskbar_button_width > limit));
     icons = combine || sg_vertical();
@@ -1142,11 +1151,21 @@
     }
     /* the pinned programs first, in their order: a running one's buttons in
      * its place, the pin's own button otherwise */
+    sg_ql_sep = -1;
     for (i = 0; i < SG_PIN_MAX; i++)
     {
         BOOL running = FALSE;
         if (!sg_pin_buttons[i]) continue;
         if (i >= sg_npins) { hide_button( sg_pin_buttons[i] ); continue; }
+        if (sg_quick_launch())
+        {
+            if (limit - pos < SG_QL_BUTTON) { hide_button( sg_pin_buttons[i] ); continue; }
+            place_button( sg_pin_buttons[i], pos, SG_QL_BUTTON );
+            InvalidateRect( sg_pin_buttons[i], NULL, TRUE );
+            pos += SG_QL_BUTTON;
+            sg_ql_sep = pos;
+            continue;
+        }
         LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
         {
             if (!win->hwnd || !win->visible || !win->exe[0] || wcsicmp( win->exe, sg_pins[i].target )) continue;
@@ -1168,6 +1187,7 @@
             pos += SG_ICON_BUTTON;
         }
     }
+    if (sg_ql_sep >= 0) pos += SG_QL_GAP;
     LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
     {
         if (!win->hwnd || win->placed) continue;  /* start button, pinned programs */
@@ -1950,6 +1970,16 @@
         if (sg_vertical()) { edge.bottom = edge.top + 1; sg_fill( hdc, &edge, RGB(0x10,0x4C,0xA8) ); OffsetRect( &edge, 0, 1 ); }
         else { edge.right = edge.left + 1; sg_fill( hdc, &edge, RGB(0x10,0x4C,0xA8) ); OffsetRect( &edge, 1, 0 ); }
         sg_fill( hdc, &edge, RGB(0x8C,0xD6,0xFA) );
+        /* the etched line after Quick Launch */
+        if (sg_ql_sep >= 0 && !sg_vertical())
+        {
+            RECT line;
+            SetRect( &line, bar->left + sg_ql_sep + SG_QL_GAP / 2 - 1, bar->top + 6,
+                     bar->left + sg_ql_sep + SG_QL_GAP / 2, bar->bottom - 6 );
+            sg_fill( hdc, &line, RGB(0x16,0x40,0x9C) );
+            OffsetRect( &line, 1, 0 );
+            sg_fill( hdc, &line, RGB(0x72,0xA8,0xF6) );
+        }
     }
     else
     {
@@ -2079,7 +2109,7 @@
         lf = ncm.lfCaptionFont;
         lf.lfWeight = FW_BOLD;
         lf.lfItalic = TRUE;
-        lf.lfHeight = -16;
+        lf.lfHeight = -20;
         font = CreateFontIndirectW( &lf );
         old = SelectObject( dis->hDC, font );
         SetBkMode( dis->hDC, TRANSPARENT );
@@ -2087,10 +2117,10 @@
         t.right -= 8;
         OffsetRect( &t, 1, 1 );
         SetTextColor( dis->hDC, RGB(0x1A,0x4A,0x18) );
-        DrawTextW( dis->hDC, start_label, -1, &t, DT_LEFT | DT_VCENTER | DT_SINGLELINE );
+        DrawTextW( dis->hDC, sg_horizon_label, -1, &t, DT_LEFT | DT_VCENTER | DT_SINGLELINE );
         OffsetRect( &t, -1, -1 );
         SetTextColor( dis->hDC, RGB(0xFF,0xFF,0xFF) );
-        DrawTextW( dis->hDC, start_label, -1, &t, DT_LEFT | DT_VCENTER | DT_SINGLELINE );
+        DrawTextW( dis->hDC, sg_horizon_label, -1, &t, DT_LEFT | DT_VCENTER | DT_SINGLELINE );
         SelectObject( dis->hDC, old );
         DeleteObject( font );
     }
@@ -3054,11 +3084,11 @@
         HFONT bold;
         lf.lfWeight = FW_BOLD;
         lf.lfItalic = TRUE;
-        lf.lfHeight = -16;
+        lf.lfHeight = -20;
         bold = CreateFontIndirectW( &lf );
         hdc = GetDC( 0 );
         SelectObject( hdc, bold );
-        GetTextExtentPointW( hdc, start_label, lstrlenW(start_label), &size );
+        GetTextExtentPointW( hdc, sg_horizon_label, lstrlenW(sg_horizon_label), &size );
         ReleaseDC( 0, hdc );
         DeleteObject( bold );
         sg_horizon_start_width = max( 96, size.cx + 4 + SG_HORIZON_HEIGHT + 18 );
@@ -3432,6 +3462,8 @@
     }
 
     LoadStringW( NULL, IDS_START_LABEL, start_label, ARRAY_SIZE( start_label ));
+    lstrcpyW( sg_horizon_label, start_label );
+    CharLowerW( sg_horizon_label );
 
     add_taskbar_button( 0 );
 
