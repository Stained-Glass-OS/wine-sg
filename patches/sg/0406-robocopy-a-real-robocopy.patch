+static BOOL remove_tree( const WCHAR *path )
+{
+    WIN32_FIND_DATAW fd;
+    WCHAR *mask = join( path, L"*" ), *child;
+    HANDLE find;
+    BOOL ret = TRUE;
+
+    find = FindFirstFileW( mask, &fd );
+    free( mask );
+    if (find != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (!wcscmp( fd.cFileName, L"." ) || !wcscmp( fd.cFileName, L".." )) continue;
+            child = join( path, fd.cFileName );
+            if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) ret &= remove_tree( child );
+            else
+            {
+                SetFileAttributesW( child, FILE_ATTRIBUTE_NORMAL );
+                ret &= DeleteFileW( child );
+            }
+            free( child );
+        } while (FindNextFileW( find, &fd ));
+        FindClose( find );
+    }
+    SetFileAttributesW( path, FILE_ATTRIBUTE_NORMAL );
+    return RemoveDirectoryW( path ) && ret;
+}
