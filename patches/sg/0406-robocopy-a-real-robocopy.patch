+static BOOL matches( const WCHAR *name, WCHAR **specs, int count )
+{
+    int i;
+    for (i = 0; i < count; i++)
+    {
+        const WCHAR *base = wcsrchr( specs[i], '\\' );
+        if (PathMatchSpecW( name, base ? base + 1 : specs[i] )) return TRUE;
+    }
+    return FALSE;
+}
+
+/* a directory excluded by /XD: by name, or by its full path */
+static BOOL dir_excluded( const WCHAR *name, const WCHAR *path )
+{
+    int i;
+    for (i = 0; i < opt.nxd; i++)
+    {
+        if (PathMatchSpecW( name, opt.xd[i] )) return TRUE;
+        if (wcschr( opt.xd[i], '\\' ))
+        {
+            WCHAR *full = full_path( opt.xd[i] );
+            BOOL same = full && !wcsicmp( full, path );
+            free( full );
+            if (same) return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static BOOL wanted_file( const WCHAR *name )
+{
+    if (opt.nfiles && !matches( name, opt.files, opt.nfiles )) return FALSE;
+    if (opt.nxf && matches( name, opt.xf, opt.nxf )) return FALSE;
+    return TRUE;
+}
