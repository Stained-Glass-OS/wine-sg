+static BOOL is_option( const WCHAR *arg, const WCHAR *name, const WCHAR **value )
+{
+    size_t n = wcslen( name );
+    if (wcsnicmp( arg, name, n )) return FALSE;
+    if (!arg[n]) { if (value) *value = NULL; return TRUE; }
+    if (arg[n] == ':' && value) { *value = arg + n + 1; return TRUE; }
+    return FALSE;
+}
+
+static DWORD parse_attrs( const WCHAR *s )
+{
+    DWORD a = 0;
+    for (; s && *s; s++)
+    {
+        switch (towupper( *s ))
+        {
+        case 'R': a |= FILE_ATTRIBUTE_READONLY; break;
+        case 'A': a |= FILE_ATTRIBUTE_ARCHIVE; break;
+        case 'S': a |= FILE_ATTRIBUTE_SYSTEM; break;
+        case 'H': a |= FILE_ATTRIBUTE_HIDDEN; break;
+        case 'C': a |= FILE_ATTRIBUTE_COMPRESSED; break;
+        case 'N': a |= FILE_ATTRIBUTE_NOT_CONTENT_INDEXED; break;
+        case 'E': a |= FILE_ATTRIBUTE_ENCRYPTED; break;
+        case 'T': a |= FILE_ATTRIBUTE_TEMPORARY; break;
+        }
+    }
+    return a;
+}
