+        else if ((is_option( a, L"/LOG", &value ) || is_option( a, L"/LOG+", &value ) ||
+                  is_option( a, L"/UNILOG", &value ) || is_option( a, L"/UNILOG+", &value )) && value)
+        {
+            BOOL append = !!wcschr( a, '+' );
+            opt.log = CreateFileW( value, GENERIC_WRITE, FILE_SHARE_READ, NULL, append ? OPEN_ALWAYS : CREATE_ALWAYS,
+                                   FILE_ATTRIBUTE_NORMAL, NULL );
+            if (opt.log == INVALID_HANDLE_VALUE)
+            {
+                opt.log = NULL;
+                output( L"ERROR : Invalid Parameter #%d : \"%s\"\r\n", i, a );
+                return RC_FATAL;
+            }
+            if (append) SetFilePointer( opt.log, 0, NULL, FILE_END );
+        }
+        else if (is_option( a, L"/?", NULL )) { usage(); return RC_FATAL; }
+        /* accepted: what to copy, retries, threads, modes, logging details */
+        else if (is_option( a, L"/R", &value ) || is_option( a, L"/W", &value ) || is_option( a, L"/MT", &value ) ||
+                 is_option( a, L"/COPY", &value ) || is_option( a, L"/DCOPY", &value ) || is_option( a, L"/COPYALL", NULL ) ||
+                 is_option( a, L"/SEC", NULL ) || is_option( a, L"/SECFIX", NULL ) || is_option( a, L"/TIMFIX", NULL ) ||
+                 is_option( a, L"/Z", NULL ) || is_option( a, L"/B", NULL ) || is_option( a, L"/ZB", NULL ) ||
+                 is_option( a, L"/J", NULL ) || is_option( a, L"/FFT", NULL ) || is_option( a, L"/DST", NULL ) ||
+                 is_option( a, L"/NOCOPY", NULL ) || is_option( a, L"/BYTES", NULL ) || is_option( a, L"/TS", NULL ) ||
+                 is_option( a, L"/FP", NULL ) || is_option( a, L"/V", NULL ) || is_option( a, L"/ETA", NULL ) ||
+                 is_option( a, L"/NOOFFLOAD", NULL ) || is_option( a, L"/COMPRESS", NULL ) || is_option( a, L"/SL", NULL ) ||
+                 is_option( a, L"/XJ", NULL ) || is_option( a, L"/XJD", NULL ) || is_option( a, L"/XJF", NULL ) ||
+                 is_option( a, L"/NODCOPY", NULL ) || is_option( a, L"/UNICODE", NULL ) || is_option( a, L"/IPG", &value ) ||
+                 is_option( a, L"/REG", NULL ) || is_option( a, L"/TBD", NULL ) || is_option( a, L"/256", NULL ) ||
+                 is_option( a, L"/EFSRAW", NULL ) || is_option( a, L"/IM", NULL ) || is_option( a, L"/NOSD", NULL ) ||
+                 is_option( a, L"/NODD", NULL ) || is_option( a, L"/MAXAGE", &value ) || is_option( a, L"/MINAGE", &value ) ||
+                 is_option( a, L"/MAXLAD", &value ) || is_option( a, L"/MINLAD", &value ))
+            WINE_TRACE( "accepted %s\n", wine_dbgstr_w(a) );
+        else
+        {
+            output( L"\r\nERROR : Invalid Parameter #%d : \"%s\"\r\n", i, a );
+            usage();
+            return RC_FATAL;
+        }
+    }
+    if (!opt.source || !opt.dest)
+    {
+        usage();
+        return RC_FATAL;
+    }
+
+    opt.source = full_path( opt.source );
+    opt.dest = full_path( opt.dest );
+    if (!opt.nfiles) opt.files[opt.nfiles++] = (WCHAR *)L"*.*";
+
+    if (!opt.no_header)
+    {
+        int f;
+        GetLocalTime( &st );
+        output( L"\r\n-------------------------------------------------------------------------------\r\n"
+                L"   ROBOCOPY     ::     Robust File Copy\r\n"
+                L"-------------------------------------------------------------------------------\r\n\r\n"
+                L"  Started : %02u/%02u/%04u %02u:%02u:%02u\r\n   Source : %s\\\r\n     Dest : %s\\\r\n\r\n    Files :",
+                st.wMonth, st.wDay, st.wYear, st.wHour, st.wMinute, st.wSecond, opt.source, opt.dest );
+        for (f = 0; f < opt.nfiles; f++) output( L" %s", opt.files[f] );
+        output( L"\r\n\r\n  Options :%s%s%s%s%s\r\n\r\n------------------------------------------------------------------------------\r\n\r\n",
+                opt.subdirs ? (opt.empty_dirs ? L" /E" : L" /S") : L"", opt.purge ? L" /PURGE" : L"",
+                opt.move_dirs ? L" /MOVE" : opt.move_files ? L" /MOV" : L"", opt.list_only ? L" /L" : L"", L" /R:1000000 /W:30" );
+    }
+
+    if (!PathIsDirectoryW( opt.source ))
+    {
+        GetLocalTime( &st );
+        output( L"%04u/%02u/%02u %02u:%02u:%02u ERROR 2 (0x00000002) Accessing Source Directory %s\\\r\n"
+                L"The system cannot find the file specified.\r\n",
+                st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond, opt.source );
+        return RC_FATAL;
+    }
+
+    copy_dir( opt.source, opt.dest, 1 );
+    if (opt.move_dirs && !opt.list_only) RemoveDirectoryW( opt.source );
+
+    if (!opt.no_summary)
+    {
+        output( L"\r\n------------------------------------------------------------------------------\r\n\r\n"
+                L"               Total    Copied   Skipped  Mismatch    FAILED    Extras\r\n" );
+        summary_row( L"Dirs", stats.dirs_total, stats.dirs_copied, stats.dirs_total - stats.dirs_copied, 0, stats.dirs_extra );
+        summary_row( L"Files", stats.files_total, stats.files_copied, stats.files_skipped, stats.files_failed, stats.files_extra );
+        summary_row( L"Bytes", stats.bytes_total, stats.bytes_copied, stats.bytes_total - stats.bytes_copied, 0, 0 );
+        GetLocalTime( &st );
+        output( L"\r\n   Ended : %02u/%02u/%04u %02u:%02u:%02u\r\n", st.wMonth, st.wDay, st.wYear, st.wHour, st.wMinute, st.wSecond );
+    }
+    if (opt.log) CloseHandle( opt.log );
+    return result;
 }
