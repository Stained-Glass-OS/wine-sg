+/* what is in the destination and not in the source: counted as extra, and
+ * deleted with /PURGE or /MIR */
+static void purge_extras( const WCHAR *src, const WCHAR *dst, int level )
+{
+    WIN32_FIND_DATAW fd;
+    WCHAR *mask = join( dst, L"*" ), *d, *s;
+    HANDLE find = FindFirstFileW( mask, &fd );
+
+    free( mask );
+    if (find == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        BOOL dir = !!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY);
+        if (!wcscmp( fd.cFileName, L"." ) || !wcscmp( fd.cFileName, L".." )) continue;
+        s = join( src, fd.cFileName );
+        d = join( dst, fd.cFileName );
+        if (dir)
+        {
+            if (opt.subdirs && (!opt.levels || level < opt.levels) && !dir_excluded( fd.cFileName, s ) &&
+                GetFileAttributesW( s ) == INVALID_FILE_ATTRIBUTES)
+            {
+                stats.dirs_extra++;
+                result |= RC_EXTRA;
+                if (!opt.no_dir_list) output( L"\t%-13s\t\t%s\\\r\n", opt.no_class ? L"" : L"*EXTRA Dir", d );
+                if (opt.purge && !opt.list_only && !opt.exclude_extra) remove_tree( d );
+            }
+        }
+        else if (wanted_file( fd.cFileName ) && GetFileAttributesW( s ) == INVALID_FILE_ATTRIBUTES)
+        {
+            stats.files_extra++;
+            result |= RC_EXTRA;
+            file_line( L"*EXTRA File", file_size( &fd ), fd.cFileName );
+            if (opt.purge && !opt.list_only && !opt.exclude_extra)
+            {
+                SetFileAttributesW( d, FILE_ATTRIBUTE_NORMAL );
+                DeleteFileW( d );
+            }
+        }
+        free( s );
+        free( d );
+    } while (FindNextFileW( find, &fd ));
+    FindClose( find );
