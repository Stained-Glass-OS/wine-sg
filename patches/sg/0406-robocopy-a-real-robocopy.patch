+static WCHAR *join( const WCHAR *dir, const WCHAR *name )
+{
+    size_t len = wcslen( dir ) + wcslen( name ) + 2;
+    WCHAR *ret = malloc( len * sizeof(WCHAR) );
+    if (!ret) return NULL;
+    if (!*name) wcscpy( ret, dir );
+    else swprintf( ret, len, L"%s%s%s", dir, dir[0] && dir[wcslen( dir ) - 1] == '\\' ? L"" : L"\\", name );
+    return ret;
+}
+
+static WCHAR *full_path( const WCHAR *path )
+{
+    DWORD len = GetFullPathNameW( path, 0, NULL, NULL );
+    WCHAR *ret;
+
+    if (!len || !(ret = malloc( len * sizeof(WCHAR) ))) return NULL;
+    GetFullPathNameW( path, len, ret, NULL );
+    /* no trailing backslash, except for a drive's root */
+    len = wcslen( ret );
+    while (len > 3 && ret[len - 1] == '\\') ret[--len] = 0;
+    return ret;
+}
