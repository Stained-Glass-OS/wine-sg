From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 08:04:00 -0700
Subject: [PATCH] ieframe: IShellUIHelper2 first-run state

ResetFirstBootMode, RunOnceShown, SkipRunOnce, RunOnceRequiredSettingsComplete and RunOnceHasShown keep
IE's first-run flags (RunOnceHasShown, RunOnceComplete) under HKCU\Software\Microsoft\Internet Explorer\Main.
ResetSafeMode and RefreshOfflineDesktop succeed (no safe mode state, no offline desktop) and
IsSearchMigrated reports true (no search providers are kept).

diff --git a/dlls/ieframe/shelluihelper.c b/dlls/ieframe/shelluihelper.c
index 58124a1..6c267b6 100644
--- a/dlls/ieframe/shelluihelper.c
+++ b/dlls/ieframe/shelluihelper.c
@@ -144,25 +144,66 @@ static HRESULT WINAPI ShellUIHelper2_Invoke(IShellUIHelper2 *iface, DISPID dispI
             pVarResult, pExepInfo, puArgErr);
 }
 
+/* IE's first-run state lives under HKCU\Software\Microsoft\Internet Explorer\Main:
+ * RunOnceHasShown (the first-run page was shown), RunOnceComplete (the required settings are done) */
+static HRESULT runonce_set(const WCHAR *name, DWORD value)
+{
+    HKEY key;
+    LONG err;
+
+    if ((err = RegCreateKeyExW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Internet Explorer\\Main", 0, NULL, 0,
+                               KEY_SET_VALUE, NULL, &key, NULL)))
+        return HRESULT_FROM_WIN32(err);
+    err = RegSetValueExW(key, name, 0, REG_DWORD, (const BYTE *)&value, sizeof(value));
+    RegCloseKey(key);
+    return HRESULT_FROM_WIN32(err);
+}
+
+static BOOL runonce_get(const WCHAR *name)
+{
+    DWORD value = 0, size = sizeof(value);
+    HKEY key;
+
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Internet Explorer\\Main", 0, KEY_QUERY_VALUE, &key))
+        return FALSE;
+    if (RegQueryValueExW(key, name, NULL, NULL, (BYTE *)&value, &size)) value = 0;
+    RegCloseKey(key);
+    return value != 0;
+}
+
+static void runonce_clear(void)
+{
+    HKEY key;
+
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Internet Explorer\\Main", 0, KEY_SET_VALUE, &key))
+        return;
+    RegDeleteValueW(key, L"RunOnceHasShown");
+    RegDeleteValueW(key, L"RunOnceComplete");
+    RegCloseKey(key);
+}
+
 static HRESULT WINAPI ShellUIHelper2_ResetFirstBootMode(IShellUIHelper2 *iface)
 {
     ShellUIHelper *This = impl_from_IShellUIHelper2(iface);
-    FIXME("(%p)->()\n", This);
-    return E_NOTIMPL;
+    TRACE("(%p)->()\n", This);
+    runonce_clear();
+    return S_OK;
 }
 
 static HRESULT WINAPI ShellUIHelper2_ResetSafeMode(IShellUIHelper2 *iface)
 {
     ShellUIHelper *This = impl_from_IShellUIHelper2(iface);
-    FIXME("(%p)->()\n", This);
-    return E_NOTIMPL;
+    TRACE("(%p)->()\n", This);
+    /* there is no safe mode state to reset */
+    return S_OK;
 }
 
 static HRESULT WINAPI ShellUIHelper2_RefreshOfflineDesktop(IShellUIHelper2 *iface)
 {
     ShellUIHelper *This = impl_from_IShellUIHelper2(iface);
-    FIXME("(%p)->()\n", This);
-    return E_NOTIMPL;
+    TRACE("(%p)->()\n", This);
+    /* there is no offline desktop */
+    return S_OK;
 }
 
 static HRESULT WINAPI ShellUIHelper2_AddFavourite(IShellUIHelper2 *iface, BSTR URL, VARIANT *Title)
@@ -296,15 +337,17 @@ static HRESULT WINAPI ShellUIHelper2_AddSearchProvider(IShellUIHelper2 *iface, B
 static HRESULT WINAPI ShellUIHelper2_RunOnceShown(IShellUIHelper2 *iface)
 {
     ShellUIHelper *This = impl_from_IShellUIHelper2(iface);
-    FIXME("(%p)->()\n", This);
-    return E_NOTIMPL;
+    TRACE("(%p)->()\n", This);
+    return runonce_set(L"RunOnceHasShown", 1);
 }
 
 static HRESULT WINAPI ShellUIHelper2_SkipRunOnce(IShellUIHelper2 *iface)
 {
     ShellUIHelper *This = impl_from_IShellUIHelper2(iface);
-    FIXME("(%p)->()\n", This);
-    return E_NOTIMPL;
+    HRESULT hres;
+    TRACE("(%p)->()\n", This);
+    if (SUCCEEDED(hres = runonce_set(L"RunOnceHasShown", 1))) hres = runonce_set(L"RunOnceComplete", 1);
+    return hres;
 }
 
 static HRESULT WINAPI ShellUIHelper2_CustomizeSettings(IShellUIHelper2 *iface, VARIANT_BOOL fSQM,
@@ -383,8 +426,11 @@ static HRESULT WINAPI ShellUIHelper2_IsSearchProviderInstalled(IShellUIHelper2 *
 static HRESULT WINAPI ShellUIHelper2_IsSearchMigrated(IShellUIHelper2 *iface, VARIANT_BOOL *pfMigrated)
 {
     ShellUIHelper *This = impl_from_IShellUIHelper2(iface);
-    FIXME("(%p)->(%p)\n", This, pfMigrated);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", This, pfMigrated);
+    if (!pfMigrated) return E_POINTER;
+    /* no search providers are kept, so there is nothing left to migrate */
+    *pfMigrated = VARIANT_TRUE;
+    return S_OK;
 }
 
 static HRESULT WINAPI ShellUIHelper2_DefaultSearchProvider(IShellUIHelper2 *iface, BSTR *pbstrName)
@@ -397,15 +443,21 @@ static HRESULT WINAPI ShellUIHelper2_DefaultSearchProvider(IShellUIHelper2 *ifac
 static HRESULT WINAPI ShellUIHelper2_RunOnceRequiredSettingsComplete(IShellUIHelper2 *iface, VARIANT_BOOL fComplete)
 {
     ShellUIHelper *This = impl_from_IShellUIHelper2(iface);
-    FIXME("(%p)->(%x)\n", This, fComplete);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%x)\n", This, fComplete);
+    return runonce_set(L"RunOnceComplete", fComplete ? 1 : 0);
 }
 
 static HRESULT WINAPI ShellUIHelper2_RunOnceHasShown(IShellUIHelper2 *iface, VARIANT_BOOL *pfShown)
 {
     ShellUIHelper *This = impl_from_IShellUIHelper2(iface);
-    FIXME("(%p)->(%p)\n", This, pfShown);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", This, pfShown);
+    if (!pfShown) return E_POINTER;
+#ifdef SG_MUTANT_IE_RUNONCE
+    *pfShown = VARIANT_FALSE;
+    return S_OK;
+#endif
+    *pfShown = runonce_get(L"RunOnceHasShown") ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
 }
 
 static HRESULT WINAPI ShellUIHelper2_SearchGuideUrl(IShellUIHelper2 *iface, BSTR *pbstrUrl)
