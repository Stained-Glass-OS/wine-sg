 /* Reads the back buffer into memory. Called with the critical section held,
  * on the thread that presents. Premultiplied alpha is drawn opaque: nothing
  * is composed beneath the visual here. */
+/* A 16-bit float swap chain holds linear (scRGB) values; the window gets
+ * them sRGB encoded, clamped to [0, 1]. */
+static float composition_half_to_float(WORD h)
+{
+    UINT sign = (h & 0x8000) << 16, exp = (h >> 10) & 0x1f, mant = h & 0x3ff;
+    union { UINT u; float f; } v;
+
+    if (!exp)
+        return (sign ? -1.0f : 1.0f) * mant * (1.0f / 16777216.0f);
+    if (exp == 31)
+        v.u = sign | 0x7f800000 | (mant << 13);
+    else
+        v.u = sign | ((exp + 112) << 23) | (mant << 13);
+    return v.f;
+}
+
+static BYTE composition_encode_srgb(float c)
+{
+    static BYTE table[4097];
+    static BOOL ready;
+    unsigned int i;
+
+    if (!ready)
+    {
+        for (i = 0; i <= 4096; ++i)
+        {
+            double l = i / 4096.0;
+            double e = l <= 0.0031308 ? l * 12.92 : 1.055 * pow(l, 1.0 / 2.4) - 0.055;
+            table[i] = (BYTE)(e * 255.0 + 0.5);
+        }
+        ready = TRUE;
+    }
+    if (!(c > 0.0f))
+        return 0;
+    if (c >= 1.0f)
+        return 255;
+    return table[(unsigned int)(c * 4096.0f + 0.5f)];
+}
+
+static void composition_convert_half_row(DWORD *dst, const WORD *src, UINT width)
+{
+    float r, g, b, a;
+    UINT j;
+
+    for (j = 0; j < width; ++j, src += 4)
+    {
+        r = composition_half_to_float(src[0]);
+        g = composition_half_to_float(src[1]);
+        b = composition_half_to_float(src[2]);
+        a = composition_half_to_float(src[3]);
+        dst[j] = composition_encode_srgb(b) | (composition_encode_srgb(g) << 8) | (composition_encode_srgb(r) << 16)
+                | ((a >= 1.0f ? 255u : a > 0.0f ? (UINT)(a * 255.0f + 0.5f) : 0u) << 24);
+    }
+}
