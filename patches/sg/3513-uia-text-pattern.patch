+
+/* Client side: text pattern and text ranges. */
+
+#define UIA_TEXT_RANGE_MAGIC 0x54525447
+
+struct uia_text_range {
+    DWORD magic;
+    HUIANODE node;
+    int prov_idx;
+    INT64 id; /* the range, as the provider side numbers it */
+};
+
+static struct uia_text_range *unsafe_text_range(HUIATEXTRANGE hrange)
+{
+    struct uia_text_range *range = (struct uia_text_range *)hrange;
+
+    if (!range || range->magic != UIA_TEXT_RANGE_MAGIC)
+        return NULL;
+    return range;
+}
+
+static void set_handle_variant(VARIANT *v, void *handle)
+{
+#ifdef _WIN64
+    V_VT(v) = VT_I8;
+    V_I8(v) = (UINT64)handle;
+#else
+    V_VT(v) = VT_I4;
+    V_I4(v) = (UINT32)handle;
+#endif
+}
+
+static BOOL get_handle_variant(const VARIANT *v, void **handle)
+{
+#ifdef _WIN64
+    if (V_VT(v) != VT_I8) return FALSE;
+    *handle = (void *)V_I8(v);
+#else
+    if (V_VT(v) != VT_I4) return FALSE;
+    *handle = (void *)(UINT_PTR)V_I4(v);
+#endif
+    return TRUE;
+}
+
+static HRESULT make_text_range(HUIANODE node, int prov_idx, INT64 id, HUIATEXTRANGE *out)
+{
+    struct uia_text_range *range;
+
+    *out = NULL;
+    if (!id)
+        return S_OK;
+    if (!(range = calloc(1, sizeof(*range))))
+        return E_OUTOFMEMORY;
+    range->magic = UIA_TEXT_RANGE_MAGIC;
+    range->node = node;
+    IWineUiaNode_AddRef((IWineUiaNode *)node);
+    range->prov_idx = prov_idx;
+    range->id = id;
+    *out = (HUIATEXTRANGE)range;
+    return S_OK;
+}
+
+static HRESULT text_call(HUIANODE node, int prov_idx, int method, const VARIANT *args, int count, VARIANT *out)
+{
+    SAFEARRAY *sa;
+    VARIANT in;
+    HRESULT hr;
+    int i;
+
+    if (!(sa = SafeArrayCreateVector(VT_VARIANT, 0, count)))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        LONG idx = i;
+        SafeArrayPutElement(sa, &idx, (VARIANT *)&args[i]);
+    }
+    V_VT(&in) = VT_VARIANT | VT_ARRAY;
+    V_ARRAY(&in) = sa;
+    VariantInit(out);
+    hr = call_pattern_on_node_provider((IWineUiaNode *)node, prov_idx, UIA_TextPatternId, method, &in, out);
+    SafeArrayDestroy(sa);
+    return hr;
+}
+
+static HRESULT text_pattern_call(HUIAPATTERNOBJECT hobj, int method, const VARIANT *args, int count, VARIANT *out,
+        struct uia_pattern_object **obj_out)
+{
+    struct uia_pattern_object *obj = unsafe_pattern_object(hobj);
+
+    if (!obj || obj->pattern_id != UIA_TextPatternId)
+        return E_INVALIDARG;
+    *obj_out = obj;
+    return text_call(obj->node, obj->prov_idx, method, args, count, out);
+}
+
+static HRESULT text_range_call(HUIATEXTRANGE hrange, int method, const VARIANT *args, int count, VARIANT *out)
+{
+    struct uia_text_range *range = unsafe_text_range(hrange);
+    VARIANT all[5];
+    int i;
+
+    if (!range || count > 4)
+        return E_INVALIDARG;
+    V_VT(&all[0]) = VT_I8;
+    V_I8(&all[0]) = range->id;
+    for (i = 0; i < count; i++)
+        all[i + 1] = args[i];
+    return text_call(range->node, range->prov_idx, method, all, count + 1, out);
+}
+
+static HRESULT text_range_from_result(HUIANODE node, int prov_idx, VARIANT *res, HUIATEXTRANGE *out)
+{
+    if (!out)
+        return E_INVALIDARG;
+    if (V_VT(res) != VT_I8)
+    {
+        *out = NULL;
+        return V_VT(res) == VT_EMPTY ? S_OK : E_FAIL;
+    }
+    return make_text_range(node, prov_idx, V_I8(res), out);
+}
+
+/* The provider side numbers become handles, in an array of variants that UiaHTextRangeFromVariant reads. */
+static HRESULT text_range_array_from_result(HUIANODE node, int prov_idx, VARIANT *res, SAFEARRAY **out)
+{
+    SAFEARRAY *sa;
+    LONG lb, ub, i;
+    HRESULT hr = S_OK;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+    if (V_VT(res) != (VT_I8 | VT_ARRAY) || !V_ARRAY(res))
+        return S_OK;
+    if (FAILED(SafeArrayGetLBound(V_ARRAY(res), 1, &lb)) || FAILED(SafeArrayGetUBound(V_ARRAY(res), 1, &ub)))
+        return E_FAIL;
+    if (!(sa = SafeArrayCreateVector(VT_VARIANT, 0, ub - lb + 1)))
+        return E_OUTOFMEMORY;
+    for (i = lb; i <= ub && SUCCEEDED(hr); i++)
+    {
+        INT64 id = 0;
+        HUIATEXTRANGE range;
+        VARIANT v;
+        LONG idx = i - lb;
+
+        SafeArrayGetElement(V_ARRAY(res), &i, &id);
+        if (SUCCEEDED(hr = make_text_range(node, prov_idx, id, &range)))
+        {
+            VariantInit(&v);
+            if (range)
+                set_handle_variant(&v, range);
+            SafeArrayPutElement(sa, &idx, &v);
+        }
+    }
+    if (FAILED(hr))
+    {
+        SafeArrayDestroy(sa);
+        return hr;
+    }
+    *out = sa;
+    return S_OK;
+}
+
+HRESULT WINAPI TextPattern_get_DocumentRange(HUIAPATTERNOBJECT hobj, HUIATEXTRANGE *range)
+{
+    struct uia_pattern_object *obj;
+    VARIANT res;
+    HRESULT hr;
+
+    TRACE("(%p, %p)\n", hobj, range);
+
+    if (!range)
+        return E_INVALIDARG;
+    *range = NULL;
+    if (FAILED(hr = text_pattern_call(hobj, PATTERN_METHOD_TEXT_DOC_RANGE, NULL, 0, &res, &obj)))
+        return hr;
+    hr = text_range_from_result(obj->node, obj->prov_idx, &res, range);
+    VariantClear(&res);
+    return hr;
+}
+
+HRESULT WINAPI TextPattern_get_SupportedTextSelection(HUIAPATTERNOBJECT hobj, enum SupportedTextSelection *sel)
+{
+    struct uia_pattern_object *obj;
+    VARIANT res;
+    HRESULT hr;
+
+    TRACE("(%p, %p)\n", hobj, sel);
+
+    if (!sel)
+        return E_INVALIDARG;
+    *sel = SupportedTextSelection_None;
+    if (FAILED(hr = text_pattern_call(hobj, PATTERN_METHOD_TEXT_SUPPORTED_SEL, NULL, 0, &res, &obj)))
+        return hr;
+    if (V_VT(&res) == VT_I4)
+        *sel = V_I4(&res);
+    VariantClear(&res);
+    return S_OK;
+}
+
+static HRESULT text_pattern_range_array(HUIAPATTERNOBJECT hobj, int method, SAFEARRAY **ranges)
+{
+    struct uia_pattern_object *obj;
+    VARIANT res;
+    HRESULT hr;
+
+    if (!ranges)
+        return E_INVALIDARG;
+    *ranges = NULL;
+    if (FAILED(hr = text_pattern_call(hobj, method, NULL, 0, &res, &obj)))
+        return hr;
+    hr = text_range_array_from_result(obj->node, obj->prov_idx, &res, ranges);
+    VariantClear(&res);
+    return hr;
+}
+
+HRESULT WINAPI TextPattern_GetSelection(HUIAPATTERNOBJECT hobj, SAFEARRAY **ranges)
+{
+    TRACE("(%p, %p)\n", hobj, ranges);
+    return text_pattern_range_array(hobj, PATTERN_METHOD_TEXT_GET_SELECTION, ranges);
+}
+
+HRESULT WINAPI TextPattern_GetVisibleRanges(HUIAPATTERNOBJECT hobj, SAFEARRAY **ranges)
+{
+    TRACE("(%p, %p)\n", hobj, ranges);
+    return text_pattern_range_array(hobj, PATTERN_METHOD_TEXT_GET_VISIBLE, ranges);
+}
+
+HRESULT WINAPI TextPattern_RangeFromChild(HUIAPATTERNOBJECT hobj, HUIANODE child, HUIATEXTRANGE *range)
+{
+    IWineUiaNode *child_node = uia_checked_node(child);
+    struct uia_pattern_object *obj;
+    VARIANT arg, res;
+    LRESULT lr;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %p)\n", hobj, child, range);
+
+    if (!range)
+        return E_INVALIDARG;
+    *range = NULL;
+    if (!child_node)
+        return E_INVALIDARG;
+    /* the node travels as a marshalled reference; the one we hold stays ours */
+    IWineUiaNode_AddRef(child_node);
+    if (!(lr = uia_lresult_from_node(child)))
+    {
+        IWineUiaNode_Release(child_node);
+        return E_FAIL;
+    }
+    V_VT(&arg) = VT_I4;
+    V_I4(&arg) = lr;
+    if (FAILED(hr = text_pattern_call(hobj, PATTERN_METHOD_TEXT_RANGE_FROM_CHILD, &arg, 1, &res, &obj)))
+        return hr;
+    hr = text_range_from_result(obj->node, obj->prov_idx, &res, range);
+    VariantClear(&res);
+    return hr;
+}
+
+HRESULT WINAPI TextPattern_RangeFromPoint(HUIAPATTERNOBJECT hobj, struct UiaPoint point, HUIATEXTRANGE *range)
+{
+    struct uia_pattern_object *obj;
+    VARIANT args[2], res;
+    HRESULT hr;
+
+    TRACE("(%p, %f, %f, %p)\n", hobj, point.x, point.y, range);
+
+    if (!range)
+        return E_INVALIDARG;
+    *range = NULL;
+    V_VT(&args[0]) = VT_R8;
+    V_R8(&args[0]) = point.x;
+    V_VT(&args[1]) = VT_R8;
+    V_R8(&args[1]) = point.y;
+    if (FAILED(hr = text_pattern_call(hobj, PATTERN_METHOD_TEXT_RANGE_FROM_POINT, args, 2, &res, &obj)))
+        return hr;
+    hr = text_range_from_result(obj->node, obj->prov_idx, &res, range);
+    VariantClear(&res);
+    return hr;
+}
+
+BOOL WINAPI UiaTextRangeRelease(HUIATEXTRANGE hrange)
+{
+    struct uia_text_range *range = unsafe_text_range(hrange);
+    VARIANT res;
+
+    TRACE("(%p)\n", hrange);
+
+    if (!range)
+        return FALSE;
+    text_range_call(hrange, PATTERN_METHOD_TEXT_RANGE_RELEASE, NULL, 0, &res);
+    VariantClear(&res);
+    range->magic = 0;
+    IWineUiaNode_Release((IWineUiaNode *)range->node);
+    free(range);
+    return TRUE;
+}
+
+HRESULT WINAPI UiaHTextRangeFromVariant(VARIANT *var, HUIATEXTRANGE *range)
+{
+    void *handle;
+
+    TRACE("(%p, %p)\n", var, range);
+
+    if (!var || !range)
+        return E_INVALIDARG;
+    *range = NULL;
+    if (!get_handle_variant(var, &handle) || !unsafe_text_range((HUIATEXTRANGE)handle))
+        return E_INVALIDARG;
+    *range = (HUIATEXTRANGE)handle;
+    return S_OK;
+}
+
+HRESULT WINAPI UiaHPatternObjectFromVariant(VARIANT *var, HUIAPATTERNOBJECT *obj)
+{
+    void *handle;
+
+    TRACE("(%p, %p)\n", var, obj);
+
+    if (!var || !obj)
+        return E_INVALIDARG;
+    *obj = NULL;
+    if (!get_handle_variant(var, &handle) || !unsafe_pattern_object((HUIAPATTERNOBJECT)handle))
+        return E_INVALIDARG;
+    *obj = (HUIAPATTERNOBJECT)handle;
+    return S_OK;
+}
+
+HRESULT WINAPI TextRange_Clone(HUIATEXTRANGE hrange, HUIATEXTRANGE *out)
+{
+    struct uia_text_range *range = unsafe_text_range(hrange);
+    VARIANT res;
+    HRESULT hr;
+
+    TRACE("(%p, %p)\n", hrange, out);
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+    if (FAILED(hr = text_range_call(hrange, PATTERN_METHOD_TEXT_RANGE_CLONE, NULL, 0, &res)))
+        return hr;
+    hr = text_range_from_result(range->node, range->prov_idx, &res, out);
+    VariantClear(&res);
+    return hr;
+}
+
+HRESULT WINAPI TextRange_Compare(HUIATEXTRANGE hrange, HUIATEXTRANGE other, BOOL *same)
+{
+    struct uia_text_range *r2 = unsafe_text_range(other);
+    VARIANT arg, res;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %p)\n", hrange, other, same);
+
+    if (!same || !r2)
+        return E_INVALIDARG;
+    *same = FALSE;
+    V_VT(&arg) = VT_I8;
+    V_I8(&arg) = r2->id;
+    if (FAILED(hr = text_range_call(hrange, PATTERN_METHOD_TEXT_RANGE_COMPARE, &arg, 1, &res)))
+        return hr;
+    *same = V_VT(&res) == VT_BOOL && V_BOOL(&res);
+    return S_OK;
+}
+
+HRESULT WINAPI TextRange_CompareEndpoints(HUIATEXTRANGE hrange, enum TextPatternRangeEndpoint endpoint,
+        HUIATEXTRANGE target, enum TextPatternRangeEndpoint target_endpoint, int *result)
+{
+    struct uia_text_range *r2 = unsafe_text_range(target);
+    VARIANT args[3], res;
+    HRESULT hr;
+
+    TRACE("(%p, %d, %p, %d, %p)\n", hrange, endpoint, target, target_endpoint, result);
+
+    if (!result || !r2)
+        return E_INVALIDARG;
+    *result = 0;
+    variant_init_i4(&args[0], endpoint);
+    V_VT(&args[1]) = VT_I8;
+    V_I8(&args[1]) = r2->id;
+    variant_init_i4(&args[2], target_endpoint);
+    if (FAILED(hr = text_range_call(hrange, PATTERN_METHOD_TEXT_RANGE_COMPARE_ENDPOINTS, args, 3, &res)))
+        return hr;
+    if (V_VT(&res) == VT_I4)
+        *result = V_I4(&res);
+    return S_OK;
+}
+
+HRESULT WINAPI TextRange_ExpandToEnclosingUnit(HUIATEXTRANGE hrange, enum TextUnit unit)
+{
+    VARIANT arg, res;
+    HRESULT hr;
+
+    TRACE("(%p, %d)\n", hrange, unit);
+
+    variant_init_i4(&arg, unit);
+    hr = text_range_call(hrange, PATTERN_METHOD_TEXT_RANGE_EXPAND, &arg, 1, &res);
+    VariantClear(&res);
+    return hr;
+}
+
+HRESULT WINAPI TextRange_GetAttributeValue(HUIATEXTRANGE hrange, TEXTATTRIBUTEID id, VARIANT *value)
+{
+    VARIANT arg;
+
+    TRACE("(%p, %d, %p)\n", hrange, id, value);
+
+    if (!value)
+        return E_INVALIDARG;
+    VariantInit(value);
+    variant_init_i4(&arg, id);
+    return text_range_call(hrange, PATTERN_METHOD_TEXT_RANGE_GET_ATTR, &arg, 1, value);
+}
+
+HRESULT WINAPI TextRange_FindAttribute(HUIATEXTRANGE hrange, TEXTATTRIBUTEID id, VARIANT val, BOOL backward,
+        HUIATEXTRANGE *out)
+{
+    struct uia_text_range *range = unsafe_text_range(hrange);
+    VARIANT args[3], res;
+    HRESULT hr;
+
+    TRACE("(%p, %d, %s, %d, %p)\n", hrange, id, debugstr_variant(&val), backward, out);
+
+    if (!out || !range)
+        return E_INVALIDARG;
+    *out = NULL;
+    variant_init_i4(&args[0], id);
+    args[1] = val;
+    variant_init_bool(&args[2], backward);
