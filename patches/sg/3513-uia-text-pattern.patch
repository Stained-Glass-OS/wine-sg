+/*
+ * UI Automation text pattern, provider side of the client calls.
+ *
+ * A client holds a text range as a handle (HUIATEXTRANGE). The range itself is an ITextRangeProvider
+ * that lives with the provider, so this side keeps a table from a number to the range. Calls on a range
+ * arrive here as IWineUiaProvider::call_pattern with that number; releasing the client handle removes it.
+ * Ranges whose client is gone without releasing them stay until the provider's process ends.
+ *
+ * Stained Glass OS: written from the documented ITextProvider and ITextRangeProvider interfaces.
+ */
+#include "uia_private.h"
+
+#include "wine/list.h"
+
+struct text_range_entry
+{
+    struct list entry;
+    INT64 id;
+    ITextRangeProvider *range;
+};
+
+static CRITICAL_SECTION text_ranges_cs;
+static CRITICAL_SECTION_DEBUG text_ranges_cs_debug =
+{
+    0, 0, &text_ranges_cs,
+    { &text_ranges_cs_debug.ProcessLocksList, &text_ranges_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": text_ranges_cs") }
+};
+static CRITICAL_SECTION text_ranges_cs = { &text_ranges_cs_debug, -1, 0, 0, 0, 0 };
+static struct list text_ranges = LIST_INIT(text_ranges);
+static INT64 next_range_id = 1;
+
+/* Takes the reference the caller holds. Stores 0 for no range. */
+static HRESULT add_range(ITextRangeProvider *range, INT64 *id)
+{
+    struct text_range_entry *entry;
+
+    *id = 0;
+    if (!range)
+        return S_OK;
+    if (!(entry = calloc(1, sizeof(*entry))))
+    {
+        ITextRangeProvider_Release(range);
+        return E_OUTOFMEMORY;
+    }
+    entry->range = range;
+    EnterCriticalSection(&text_ranges_cs);
+    entry->id = *id = next_range_id++;
+    list_add_tail(&text_ranges, &entry->entry);
+    LeaveCriticalSection(&text_ranges_cs);
+    return S_OK;
+}
+
+static ITextRangeProvider *get_range(INT64 id)
+{
+    struct text_range_entry *entry;
+    ITextRangeProvider *range = NULL;
+
+    EnterCriticalSection(&text_ranges_cs);
+    LIST_FOR_EACH_ENTRY(entry, &text_ranges, struct text_range_entry, entry)
+    {
+        if (entry->id == id)
+        {
+            range = entry->range;
+            ITextRangeProvider_AddRef(range);
+            break;
+        }
+    }
+    LeaveCriticalSection(&text_ranges_cs);
+    return range;
+}
+
+static void release_range(INT64 id)
+{
+    struct text_range_entry *entry, *next;
+
+    EnterCriticalSection(&text_ranges_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &text_ranges, struct text_range_entry, entry)
+    {
+        if (entry->id == id)
+        {
+            list_remove(&entry->entry);
+            ITextRangeProvider_Release(entry->range);
+            free(entry);
+            break;
+        }
+    }
+    LeaveCriticalSection(&text_ranges_cs);
+}
+
+/* The arguments of a call arrive as a vector of variants. */
+static HRESULT get_args(const VARIANT *in, VARIANT **args, LONG *count, SAFEARRAY **sa)
+{
+    LONG lb, ub;
+
+    *args = NULL;
+    *count = 0;
+    *sa = NULL;
+    if (!in || V_VT(in) != (VT_VARIANT | VT_ARRAY) || !V_ARRAY(in))
+        return S_OK;
+    if (SafeArrayGetDim(V_ARRAY(in)) != 1 || FAILED(SafeArrayGetLBound(V_ARRAY(in), 1, &lb))
+            || FAILED(SafeArrayGetUBound(V_ARRAY(in), 1, &ub)))
+        return E_INVALIDARG;
+    if (FAILED(SafeArrayAccessData(V_ARRAY(in), (void **)args)))
+        return E_INVALIDARG;
+    *sa = V_ARRAY(in);
+    *count = ub - lb + 1;
+    return S_OK;
+}
+
+static BOOL arg_int(const VARIANT *args, LONG count, LONG idx, LONG *val)
+{
+    VARIANT v;
+
+    if (idx >= count)
+        return FALSE;
+    VariantInit(&v);
+    if (FAILED(VariantChangeType(&v, &args[idx], 0, VT_I4)))
+        return FALSE;
+    *val = V_I4(&v);
+    return TRUE;
+}
+
+static BOOL arg_id(const VARIANT *args, LONG count, LONG idx, INT64 *val)
+{
+    if (idx >= count || V_VT(&args[idx]) != VT_I8)
+        return FALSE;
+    *val = V_I8(&args[idx]);
+    return TRUE;
+}
+
+static void out_i4(VARIANT *out, LONG val)
+{
+    V_VT(out) = VT_I4;
+    V_I4(out) = val;
+}
+
+static HRESULT out_range(VARIANT *out, ITextRangeProvider *range)
+{
+    INT64 id;
+    HRESULT hr = add_range(range, &id);
+
+    if (SUCCEEDED(hr))
+    {
+        V_VT(out) = VT_I8;
+        V_I8(out) = id;
+    }
+    return hr;
+}
+
+/* An array of ranges, as ITextProvider returns them (an array of variants, or of interface pointers),
+ * becomes an array of range numbers. */
+static HRESULT out_range_array(SAFEARRAY *sa, VARIANT *out)
+{
+    SAFEARRAY *ids;
+    LONG lb, ub, i;
+    VARTYPE vt;
+    HRESULT hr = S_OK;
+
+    if (!sa)
+    {
+        V_VT(out) = VT_EMPTY;
+        return S_OK;
+    }
+    if (FAILED(SafeArrayGetVartype(sa, &vt)) || SafeArrayGetDim(sa) != 1
+            || FAILED(SafeArrayGetLBound(sa, 1, &lb)) || FAILED(SafeArrayGetUBound(sa, 1, &ub)))
+    {
+        SafeArrayDestroy(sa);
+        return E_INVALIDARG;
+    }
+    if (!(ids = SafeArrayCreateVector(VT_I8, 0, ub - lb + 1)))
+    {
+        SafeArrayDestroy(sa);
+        return E_OUTOFMEMORY;
+    }
+    for (i = lb; i <= ub && SUCCEEDED(hr); i++)
+    {
+        IUnknown *unk = NULL;
+        ITextRangeProvider *range = NULL;
+        VARIANT v;
+        INT64 id = 0;
+        LONG idx = i - lb;
+
+        VariantInit(&v);
+        if (vt == VT_VARIANT)
+        {
+            if (SUCCEEDED(SafeArrayGetElement(sa, &i, &v)) && (V_VT(&v) == VT_UNKNOWN || V_VT(&v) == VT_DISPATCH))
+                unk = V_UNKNOWN(&v);
+        }
+        else if (vt == VT_UNKNOWN || vt == VT_DISPATCH)
+            SafeArrayGetElement(sa, &i, &unk);
+        if (unk && SUCCEEDED(IUnknown_QueryInterface(unk, &IID_ITextRangeProvider, (void **)&range)))
+            hr = add_range(range, &id);
+        if (vt == VT_VARIANT) VariantClear(&v);
+        else if (unk) IUnknown_Release(unk);
+        SafeArrayPutElement(ids, &idx, &id);
+    }
+    SafeArrayDestroy(sa);
+    if (FAILED(hr))
+    {
+        SafeArrayDestroy(ids);
+        return hr;
+    }
+    V_VT(out) = VT_I8 | VT_ARRAY;
+    V_ARRAY(out) = ids;
+    return S_OK;
+}
+
+static HRESULT out_node(VARIANT *out, IRawElementProviderSimple *elprov)
+{
+    HUIANODE node;
+    LRESULT lr;
+    HRESULT hr;
+
+    if (!elprov)
+    {
+        V_VT(out) = VT_EMPTY;
+        return S_OK;
+    }
+    hr = create_uia_node_from_elprov(elprov, &node, TRUE, 0);
+    IRawElementProviderSimple_Release(elprov);
+    if (FAILED(hr))
+        return hr;
+    if (!(lr = uia_lresult_from_node(node)))
+        return E_FAIL;
+    out_i4(out, lr);
+    return S_OK;
+}
+
+static HRESULT text_pattern_call(ITextProvider *text, int method, const VARIANT *args, LONG count, VARIANT *out)
+{
+    ITextRangeProvider *range = NULL;
+    SAFEARRAY *sa = NULL;
+    HRESULT hr;
+
+    switch (method)
+    {
+    case PATTERN_METHOD_TEXT_DOC_RANGE:
+        if (FAILED(hr = ITextProvider_get_DocumentRange(text, &range)))
+            return hr;
+        return out_range(out, range);
+    case PATTERN_METHOD_TEXT_SUPPORTED_SEL:
+    {
+        enum SupportedTextSelection sel = 0;
+
+        if (FAILED(hr = ITextProvider_get_SupportedTextSelection(text, &sel)))
+            return hr;
+        out_i4(out, sel);
+        return S_OK;
+    }
+    case PATTERN_METHOD_TEXT_GET_SELECTION:
+        if (FAILED(hr = ITextProvider_GetSelection(text, &sa)))
+            return hr;
+        return out_range_array(sa, out);
+    case PATTERN_METHOD_TEXT_GET_VISIBLE:
+        if (FAILED(hr = ITextProvider_GetVisibleRanges(text, &sa)))
+            return hr;
+        return out_range_array(sa, out);
+    case PATTERN_METHOD_TEXT_RANGE_FROM_POINT:
+    {
+        struct UiaPoint pt;
+
+        if (count < 2 || V_VT(&args[0]) != VT_R8 || V_VT(&args[1]) != VT_R8)
+            return E_INVALIDARG;
+        pt.x = V_R8(&args[0]);
+        pt.y = V_R8(&args[1]);
+        if (FAILED(hr = ITextProvider_RangeFromPoint(text, pt, &range)))
+            return hr;
+        return out_range(out, range);
+    }
+    case PATTERN_METHOD_TEXT_RANGE_FROM_CHILD:
+    {
+        IRawElementProviderSimple *child;
+        HUIANODE node;
+
+        if (count < 1 || V_VT(&args[0]) != VT_I4)
+            return E_INVALIDARG;
+        if (FAILED(hr = uia_node_from_lresult((LRESULT)V_I4(&args[0]), &node, 0)))
+            return hr;
+        hr = uia_node_get_elprov(node, &child);
+        UiaNodeRelease(node);
+        if (FAILED(hr))
+            return hr;
+        hr = ITextProvider_RangeFromChild(text, child, &range);
+        IRawElementProviderSimple_Release(child);
+        if (FAILED(hr))
+            return hr;
+        return out_range(out, range);
+    }
+    default:
+        return E_NOTIMPL;
+    }
+}
+
+static HRESULT text_range_call(int method, const VARIANT *args, LONG count, VARIANT *out)
+{
+    ITextRangeProvider *range, *other = NULL, *res = NULL;
+    INT64 id, id2;
+    LONG a, b, c;
+    int n = 0;
+    BOOL same = FALSE;
+    HRESULT hr;
+
+    if (!arg_id(args, count, 0, &id))
+        return E_INVALIDARG;
+    if (method == PATTERN_METHOD_TEXT_RANGE_RELEASE)
+    {
+        release_range(id);
+        return S_OK;
+    }
+    if (!(range = get_range(id)))
+        return E_INVALIDARG;
+
+    switch (method)
+    {
+    case PATTERN_METHOD_TEXT_RANGE_CLONE:
+        if (SUCCEEDED(hr = ITextRangeProvider_Clone(range, &res)))
+            hr = out_range(out, res);
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_COMPARE:
+        if (!arg_id(args, count, 1, &id2) || !(other = get_range(id2))) { hr = E_INVALIDARG; break; }
+        if (SUCCEEDED(hr = ITextRangeProvider_Compare(range, other, &same)))
+        {
+            V_VT(out) = VT_BOOL;
+            V_BOOL(out) = same ? VARIANT_TRUE : VARIANT_FALSE;
+        }
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_COMPARE_ENDPOINTS:
+        if (!arg_int(args, count, 1, &a) || !arg_id(args, count, 2, &id2) || !arg_int(args, count, 3, &b)
+                || !(other = get_range(id2))) { hr = E_INVALIDARG; break; }
+        if (SUCCEEDED(hr = ITextRangeProvider_CompareEndpoints(range, a, other, b, &n)))
+            out_i4(out, n);
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_EXPAND:
+        hr = arg_int(args, count, 1, &a) ? ITextRangeProvider_ExpandToEnclosingUnit(range, a) : E_INVALIDARG;
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_FIND_ATTR:
+        if (!arg_int(args, count, 1, &a) || count < 4 || !arg_int(args, count, 3, &b)) { hr = E_INVALIDARG; break; }
+        if (SUCCEEDED(hr = ITextRangeProvider_FindAttribute(range, a, args[2], b ? TRUE : FALSE, &res)))
+            hr = out_range(out, res);
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_FIND_TEXT:
+        if (count < 4 || V_VT(&args[1]) != VT_BSTR || !arg_int(args, count, 2, &a) || !arg_int(args, count, 3, &b))
+        { hr = E_INVALIDARG; break; }
+        if (SUCCEEDED(hr = ITextRangeProvider_FindText(range, V_BSTR(&args[1]), a ? TRUE : FALSE, b ? TRUE : FALSE, &res)))
+            hr = out_range(out, res);
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_GET_ATTR:
+        hr = arg_int(args, count, 1, &a) ? ITextRangeProvider_GetAttributeValue(range, a, out) : E_INVALIDARG;
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_GET_RECTS:
+    {
+        SAFEARRAY *sa = NULL;
+
+        if (SUCCEEDED(hr = ITextRangeProvider_GetBoundingRectangles(range, &sa)))
+        {
+            V_VT(out) = VT_R8 | VT_ARRAY;
+            V_ARRAY(out) = sa;
+            if (!sa) V_VT(out) = VT_EMPTY;
+        }
+        break;
+    }
+    case PATTERN_METHOD_TEXT_RANGE_GET_ENCLOSING:
+    {
+        IRawElementProviderSimple *elem = NULL;
+
+        if (SUCCEEDED(hr = ITextRangeProvider_GetEnclosingElement(range, &elem)))
+            hr = out_node(out, elem);
+        break;
+    }
+    case PATTERN_METHOD_TEXT_RANGE_GET_TEXT:
+    {
+        BSTR text = NULL;
+
+        if (!arg_int(args, count, 1, &a)) { hr = E_INVALIDARG; break; }
+        if (SUCCEEDED(hr = ITextRangeProvider_GetText(range, a, &text)))
+        {
+            V_VT(out) = VT_BSTR;
+            V_BSTR(out) = text;
+        }
+        break;
+    }
+    case PATTERN_METHOD_TEXT_RANGE_MOVE:
+        if (!arg_int(args, count, 1, &a) || !arg_int(args, count, 2, &b)) { hr = E_INVALIDARG; break; }
+        if (SUCCEEDED(hr = ITextRangeProvider_Move(range, a, b, &n)))
+            out_i4(out, n);
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_MOVE_ENDPOINT_UNIT:
+        if (!arg_int(args, count, 1, &a) || !arg_int(args, count, 2, &b) || !arg_int(args, count, 3, &c))
+        { hr = E_INVALIDARG; break; }
+        if (SUCCEEDED(hr = ITextRangeProvider_MoveEndpointByUnit(range, a, b, c, &n)))
+            out_i4(out, n);
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_MOVE_ENDPOINT_RANGE:
+        if (!arg_int(args, count, 1, &a) || !arg_id(args, count, 2, &id2) || !arg_int(args, count, 3, &b)
+                || !(other = get_range(id2))) { hr = E_INVALIDARG; break; }
+        hr = ITextRangeProvider_MoveEndpointByRange(range, a, other, b);
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_SELECT:
+        hr = ITextRangeProvider_Select(range);
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_ADD_SEL:
+        hr = ITextRangeProvider_AddToSelection(range);
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_REMOVE_SEL:
+        hr = ITextRangeProvider_RemoveFromSelection(range);
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_SCROLL:
+        hr = arg_int(args, count, 1, &a) ? ITextRangeProvider_ScrollIntoView(range, a ? TRUE : FALSE) : E_INVALIDARG;
+        break;
+    case PATTERN_METHOD_TEXT_RANGE_GET_CHILDREN:
+    {
+        SAFEARRAY *sa = NULL, *lresults;
+        LONG lb, ub, i;
+        VARTYPE vt;
+
+        if (FAILED(hr = ITextRangeProvider_GetChildren(range, &sa)))
+            break;
+        if (!sa) { V_VT(out) = VT_EMPTY; break; }
+        if (FAILED(SafeArrayGetVartype(sa, &vt)) || SafeArrayGetDim(sa) != 1
+                || FAILED(SafeArrayGetLBound(sa, 1, &lb)) || FAILED(SafeArrayGetUBound(sa, 1, &ub))
+                || !(lresults = SafeArrayCreateVector(VT_I4, 0, ub - lb + 1)))
+        {
+            SafeArrayDestroy(sa);
+            hr = E_FAIL;
+            break;
+        }
+        for (i = lb; i <= ub; i++)
+        {
+            IUnknown *unk = NULL;
+            IRawElementProviderSimple *elprov = NULL;
+            VARIANT v, nv;
+            LONG idx = i - lb, lr = 0;
+
+            VariantInit(&v);
+            VariantInit(&nv);
+            if (vt == VT_VARIANT)
+            {
+                if (SUCCEEDED(SafeArrayGetElement(sa, &i, &v)) && (V_VT(&v) == VT_UNKNOWN || V_VT(&v) == VT_DISPATCH))
+                    unk = V_UNKNOWN(&v);
+            }
+            else
+                SafeArrayGetElement(sa, &i, &unk);
+            if (unk && SUCCEEDED(IUnknown_QueryInterface(unk, &IID_IRawElementProviderSimple, (void **)&elprov))
+                    && SUCCEEDED(out_node(&nv, elprov)))
+                lr = V_I4(&nv);
+            if (vt == VT_VARIANT) VariantClear(&v);
+            else if (unk) IUnknown_Release(unk);
+            SafeArrayPutElement(lresults, &idx, &lr);
+        }
+        SafeArrayDestroy(sa);
+        V_VT(out) = VT_I4 | VT_ARRAY;
+        V_ARRAY(out) = lresults;
+        hr = S_OK;
+        break;
+    }
+    default:
+        hr = E_NOTIMPL;
+        break;
+    }
+
+    if (other) ITextRangeProvider_Release(other);
+    ITextRangeProvider_Release(range);
+    return hr;
+}
+
+HRESULT uia_text_call_provider(IRawElementProviderSimple *elprov, IUnknown *pattern, int method, VARIANT *in_val,
+        VARIANT *out_val)
+{
+    VARIANT *args;
+    SAFEARRAY *sa;
+    LONG count;
+    HRESULT hr;
+
+    if (FAILED(hr = get_args(in_val, &args, &count, &sa)))
+        return hr;
+    if (method >= PATTERN_METHOD_TEXT_RANGE_FIRST)
+        hr = text_range_call(method, args, count, out_val);
+    else
+        hr = text_pattern_call((ITextProvider *)pattern, method, args, count, out_val);
+    if (sa) SafeArrayUnaccessData(sa);
+    return hr;
+}
