+static HRESULT find_node_elprov(IWineUiaNode *node, IRawElementProviderSimple **elprov, int depth)
+{
+    int idx;
+
+    for (idx = 0; depth < 8; idx++)
+    {
+        IWineUiaProvider *prov;
+        HRESULT hr = UIA_E_NOTSUPPORTED;
+
+        if (FAILED(IWineUiaNode_get_provider(node, idx, &prov)))
+            break;
+        if (prov->lpVtbl == &uia_provider_vtbl)
+        {
+            *elprov = impl_from_IWineUiaProvider(prov)->elprov;
+            IRawElementProviderSimple_AddRef(*elprov);
+            hr = S_OK;
