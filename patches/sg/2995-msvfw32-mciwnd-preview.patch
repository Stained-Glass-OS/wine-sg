From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvfw32: MCIWnd volume/speed/repeat/palette/save messages; file dialog log

MCIWnd: MCIWNDM_SETVOLUME/GETVOLUME, SETSPEED/GETSPEED, GETPALETTE/SETPALETTE
and REALIZE/PALETTEKICK are sent to the device as MCI_SETAUDIO/MCI_STATUS/MCI_SET/
MCI_SETVIDEO/MCI_REALIZE commands and the device's error is returned; SETREPEAT/
GETREPEAT keep the repeat flag, which adds MCI_DGV_PLAY_REPEAT to PLAYFROM/PLAYTO
on digital video devices. The MCI_SAVE message (lParam: file name) saves through
MCI_SAVE and MCI_RECORD starts recording. MCI commands that are not MCIWnd
messages fall through to default window handling without a FIXME. NEW and
OPENINTERFACE are still not implemented.
GetOpenFileNamePreview*/GetSaveFileNamePreview* log one FIXME about the missing
preview pane instead of one per entry point.
---
diff --git a/dlls/msvfw32/mciwnd.c b/dlls/msvfw32/mciwnd.c
index c71e4fe..7003428 100644
--- a/dlls/msvfw32/mciwnd.c
+++ b/dlls/msvfw32/mciwnd.c
@@ -58,6 +58,7 @@ typedef struct
     MCIERROR    lasterror;
     WCHAR       return_string[128];
     WORD        active_timer, inactive_timer;
+    BOOL        repeat;
 } MCIWndInfo;
 
 static LRESULT WINAPI MCIWndProc(HWND hWnd, UINT wMsg, WPARAM wParam, LPARAM lParam);
@@ -430,6 +431,11 @@ static LRESULT mci_get_devcaps(MCIWndInfo *mwi, UINT cap)
     return mci_devcaps.dwReturn;
 }
 
+static DWORD mci_repeat_flag(const MCIWndInfo *mwi)
+{
+    return (mwi->repeat && mwi->dev_type == MCI_DEVTYPE_DIGITAL_VIDEO) ? MCI_DGV_PLAY_REPEAT : 0;
+}
+
 static LRESULT MCIWND_KeyDown(MCIWndInfo *mwi, UINT key)
 {
     TRACE("%p, key %04x\n", mwi->hWnd, key);
@@ -877,7 +883,7 @@ end_of_mci_open:
             mci_play.dwCallback = (DWORD_PTR)hWnd;
             mci_play.dwFrom = lParam;
             mwi->lasterror = mciSendCommandW(mwi->mci, MCI_PLAY,
-                                             MCI_FROM | MCI_NOTIFY,
+                                             MCI_FROM | MCI_NOTIFY | mci_repeat_flag(mwi),
                                              (DWORD_PTR)&mci_play);
             if (mwi->lasterror)
             {
@@ -899,7 +905,7 @@ end_of_mci_open:
             mci_play.dwCallback = (DWORD_PTR)hWnd;
             mci_play.dwTo = lParam;
             mwi->lasterror = mciSendCommandW(mwi->mci, MCI_PLAY,
-                                             MCI_TO | MCI_NOTIFY,
+                                             MCI_TO | MCI_NOTIFY | mci_repeat_flag(mwi),
                                              (DWORD_PTR)&mci_play);
             if (mwi->lasterror)
             {
@@ -1281,18 +1287,102 @@ end_of_mci_open:
         }
 
     case MCIWNDM_SETVOLUME:
+        {
+            MCI_DGV_SETAUDIO_PARMSW mci_audio = {0};
+
+            TRACE("MCIWNDM_SETVOLUME %Id\n", lParam);
+
+            mci_audio.dwItem = MCI_DGV_SETAUDIO_VOLUME;
+            mci_audio.dwValue = lParam;
+            mwi->lasterror = mciSendCommandW(mwi->mci, MCI_SETAUDIO,
+                                             MCI_DGV_SETAUDIO_ITEM | MCI_DGV_SETAUDIO_VALUE,
+                                             (DWORD_PTR)&mci_audio);
+            if (mwi->lasterror)
+                MCIWND_notify_error(mwi);
+            return mwi->lasterror;
+        }
+
     case MCIWNDM_GETVOLUME:
-    case MCIWNDM_SETSPEED:
     case MCIWNDM_GETSPEED:
+    case MCIWNDM_GETPALETTE:
+        {
+            MCI_DGV_STATUS_PARMSW mci_status = {0};
+
+            mci_status.dwItem = (wMsg == MCIWNDM_GETVOLUME) ? MCI_DGV_STATUS_VOLUME :
+                                (wMsg == MCIWNDM_GETSPEED) ? MCI_DGV_STATUS_SPEED : MCI_DGV_STATUS_HPAL;
+            mwi->lasterror = mciSendCommandW(mwi->mci, MCI_STATUS, MCI_STATUS_ITEM,
+                                             (DWORD_PTR)&mci_status);
+            if (mwi->lasterror)
+            {
+                MCIWND_notify_error(mwi);
+                return 0;
+            }
+            TRACE("status item %#lx: %Id\n", mci_status.dwItem, mci_status.dwReturn);
+            return mci_status.dwReturn;
+        }
+
+    case MCIWNDM_SETSPEED:
+        {
+            MCI_DGV_SET_PARMS mci_set = {0};
+
+            TRACE("MCIWNDM_SETSPEED %Id\n", lParam);
+
+            mci_set.dwSpeed = lParam;
+            mwi->lasterror = mciSendCommandW(mwi->mci, MCI_SET, MCI_DGV_SET_SPEED,
+                                             (DWORD_PTR)&mci_set);
+            if (mwi->lasterror)
+                MCIWND_notify_error(mwi);
+            return mwi->lasterror;
+        }
+
     case MCIWNDM_SETREPEAT:
+        TRACE("MCIWNDM_SETREPEAT %Id\n", lParam);
+#ifndef SG_MUTANT_VFW_REPEAT
+        mwi->repeat = !!lParam;
+#endif
+        return 0;
+
     case MCIWNDM_GETREPEAT:
+        TRACE("MCIWNDM_GETREPEAT: %d\n", mwi->repeat);
+        return mwi->repeat;
+
     case MCIWNDM_REALIZE:
-    case MCIWNDM_GETPALETTE:
+    case MCIWNDM_PALETTEKICK:
+        {
+            MCI_GENERIC_PARMS mci_generic = {0};
+
+            TRACE("MCIWNDM_REALIZE/PALETTEKICK %08Ix\n", wParam);
+
+            mwi->lasterror = mciSendCommandW(mwi->mci, MCI_REALIZE,
+                                             (wMsg == MCIWNDM_REALIZE && wParam) ?
+                                             MCI_DGV_REALIZE_BKGD : MCI_DGV_REALIZE_NORM,
+                                             (DWORD_PTR)&mci_generic);
+            if (mwi->lasterror)
+                MCIWND_notify_error(mwi);
+            return (wMsg == MCIWNDM_REALIZE) ? mwi->lasterror : !mwi->lasterror;
+        }
+
     case MCIWNDM_SETPALETTE:
+        {
+            MCI_DGV_SETVIDEO_PARMSW mci_video = {0};
+
+            TRACE("MCIWNDM_SETPALETTE %p\n", (HPALETTE)wParam);
+
+            mci_video.dwItem = MCI_DGV_SETVIDEO_PALHANDLE;
+            mci_video.dwValue = (DWORD)wParam;
+            mwi->lasterror = mciSendCommandW(mwi->mci, MCI_SETVIDEO,
+                                             MCI_DGV_SETVIDEO_ITEM | MCI_DGV_SETVIDEO_VALUE,
+                                             (DWORD_PTR)&mci_video);
+            if (mwi->lasterror)
+                MCIWND_notify_error(mwi);
+            return mwi->lasterror;
+        }
+
     case MCIWNDM_NEWA:
     case MCIWNDM_NEWW:
-    case MCIWNDM_PALETTEKICK:
     case MCIWNDM_OPENINTERFACE:
+        /* Creating a new element and opening an object interface need MCI
+         * device support that is not available here. */
         FIXME("support for MCIWNDM_ message WM_USER+%d not implemented\n", wMsg - WM_USER);
         return 0;
 
@@ -1372,46 +1462,50 @@ end_of_mci_open:
             SendDriverMessage(mwi->hdrv, DRV_CONFIGURE, (LPARAM)hWnd, 0);
         return 0;
 
-    case MCI_BREAK:
-    case MCI_CAPTURE:
-    case MCI_COPY:
-    case MCI_CUE:
-    case MCI_CUT:
-    case MCI_DELETE:
-    case MCI_ESCAPE:
-    case MCI_FREEZE:
-    case MCI_GETDEVCAPS:
-    /*case MCI_INDEX:*/
-    case MCI_INFO:
-    case MCI_LIST:
-    case MCI_LOAD:
-    /*case MCI_MARK:*/
-    case MCI_MONITOR:
-    case MCI_OPEN:
-    case MCI_PASTE:
-    case MCI_PUT:
-    case MCI_QUALITY:
-    case MCI_REALIZE:
-    case MCI_RECORD:
-    case MCI_RESERVE:
-    case MCI_RESTORE:
     case MCI_SAVE:
-    case MCI_SET:
-    case MCI_SETAUDIO:
-    /*case MCI_SETTIMECODE:*/
-    /*case MCI_SETTUNER:*/
-    case MCI_SETVIDEO:
-    case MCI_SIGNAL:
-    case MCI_SPIN:
-    case MCI_STATUS:
-    case MCI_SYSINFO:
-    case MCI_UNDO:
-    case MCI_UNFREEZE:
-    case MCI_UPDATE:
-    case MCI_WHERE:
-    case MCI_WINDOW:
-        FIXME("support for MCI_ command %04x not implemented\n", wMsg);
-        return 0;
+        {
+            MCI_SAVE_PARMSW mci_save;
+
+            TRACE("MCI_SAVE %s\n", debugstr_w((LPCWSTR)lParam));
+
+            if (!lParam || lParam == (LPARAM)-1)
+            {
+                /* There is no dialog to ask for a name. */
+                mwi->lasterror = MCIERR_FILENAME_REQUIRED;
+                MCIWND_notify_error(mwi);
+                return mwi->lasterror;
+            }
+
+#ifdef SG_MUTANT_VFW_SAVE
+            return 0;
+#endif
+            mci_save.dwCallback = 0;
+            mci_save.lpfilename = (LPCWSTR)lParam;
+            mwi->lasterror = mciSendCommandW(mwi->mci, MCI_SAVE, MCI_SAVE_FILE | MCI_WAIT,
+                                             (DWORD_PTR)&mci_save);
+            if (mwi->lasterror)
+                MCIWND_notify_error(mwi);
+            return mwi->lasterror;
+        }
+
+    case MCI_RECORD:
+        {
+            MCI_RECORD_PARMS mci_record = {0};
+
+            TRACE("MCI_RECORD\n");
+
+            mci_record.dwCallback = (DWORD_PTR)hWnd;
+            mwi->lasterror = mciSendCommandW(mwi->mci, MCI_RECORD, MCI_NOTIFY,
+                                             (DWORD_PTR)&mci_record);
+            if (mwi->lasterror)
+            {
+                MCIWND_notify_error(mwi);
+                return mwi->lasterror;
+            }
+            MCIWND_notify_mode(mwi);
+            MCIWND_UpdateState(mwi);
+            return 0;
+        }
     }
 
     if (wMsg >= WM_USER)
diff --git a/dlls/msvfw32/msvideo_main.c b/dlls/msvfw32/msvideo_main.c
index d332300..03dca10 100644
--- a/dlls/msvfw32/msvideo_main.c
+++ b/dlls/msvfw32/msvideo_main.c
@@ -1630,7 +1630,7 @@ static BOOL GetFileNamePreview(LPVOID lpofn,BOOL bSave,BOOL bUnicode)
   HMODULE hComdlg32;
   BOOL    ret;
 
-  FIXME("(%p,%d,%d), semi-stub!\n",lpofn,bSave,bUnicode);
+  TRACE("(%p,%d,%d)\n",lpofn,bSave,bUnicode);
 
   lstrcpyA(szFunctionName, (bSave ? "GetSaveFileName" : "GetOpenFileName"));
   lstrcatA(szFunctionName, (bUnicode ? "W" : "A"));
@@ -1646,7 +1646,7 @@ static BOOL GetFileNamePreview(LPVOID lpofn,BOOL bSave,BOOL bUnicode)
     return FALSE;
   }
 
-  /* FIXME: need to add OFN_ENABLEHOOK and our own handler */
+  FIXME("The preview pane of the dialog is not implemented.\n");
   ret = fnGetFileName(lpofn);
 
   FreeLibrary(hComdlg32);
@@ -1658,7 +1658,7 @@ static BOOL GetFileNamePreview(LPVOID lpofn,BOOL bSave,BOOL bUnicode)
  */
 BOOL WINAPI GetOpenFileNamePreviewA(LPOPENFILENAMEA lpofn)
 {
-  FIXME("(%p), semi-stub!\n", lpofn);
+  TRACE("(%p)\n", lpofn);
 
   return GetFileNamePreview(lpofn, FALSE, FALSE);
 }
@@ -1668,7 +1668,7 @@ BOOL WINAPI GetOpenFileNamePreviewA(LPOPENFILENAMEA lpofn)
  */
 BOOL WINAPI GetOpenFileNamePreviewW(LPOPENFILENAMEW lpofn)
 {
-  FIXME("(%p), semi-stub!\n", lpofn);
+  TRACE("(%p)\n", lpofn);
 
   return GetFileNamePreview(lpofn, FALSE, TRUE);
 }
@@ -1678,7 +1678,7 @@ BOOL WINAPI GetOpenFileNamePreviewW(LPOPENFILENAMEW lpofn)
  */
 BOOL WINAPI GetSaveFileNamePreviewA(LPOPENFILENAMEA lpofn)
 {
-  FIXME("(%p), semi-stub!\n", lpofn);
+  TRACE("(%p)\n", lpofn);
 
   return GetFileNamePreview(lpofn, TRUE, FALSE);
 }
@@ -1688,7 +1688,7 @@ BOOL WINAPI GetSaveFileNamePreviewA(LPOPENFILENAMEA lpofn)
  */
 BOOL WINAPI GetSaveFileNamePreviewW(LPOPENFILENAMEW lpofn)
 {
-  FIXME("(%p), semi-stub!\n", lpofn);
+  TRACE("(%p)\n", lpofn);
 
   return GetFileNamePreview(lpofn, TRUE, TRUE);
 }
