+
+static BOOL sg_same_parent( LPCITEMIDLIST a, LPCITEMIDLIST b )
+{
+    LPITEMIDLIST pa = ILClone( a ), pb = ILClone( b );
+    BOOL ret = pa && pb && ILRemoveLastID( pa ) == ILRemoveLastID( pb ) && ILIsEqual( pa, pb );
+    ILFree( pa );
+    ILFree( pb );
+    return ret;
+}
+
+/* the shell's object (a menu, a data object) for these items: from their
+ * folder when they share one -- the user's or the public Desktop -- else from
+ * the namespace's root, with full ID lists */
+static HRESULT sg_items_object( HWND hwnd, LPITEMIDLIST *pidls, unsigned int n, REFIID riid, void **out )
+{
+    LPCITEMIDLIST *children;
+    IShellFolder *folder = NULL;
+    BOOL shared = TRUE;
+    unsigned int i;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!n || !(children = calloc( n, sizeof(*children) ))) return E_FAIL;
+    for (i = 1; i < n; i++) if (!sg_same_parent( pidls[0], pidls[i] )) shared = FALSE;
+    if (shared) hr = SHBindToParent( pidls[0], &IID_IShellFolder, (void **)&folder, NULL );
+    else hr = SHGetDesktopFolder( &folder );
+    for (i = 0; i < n; i++) children[i] = shared ? ILFindLastID( pidls[i] ) : pidls[i];
+    if (SUCCEEDED(hr)) hr = IShellFolder_GetUIObjectOf( folder, hwnd, n, children, riid, NULL, out );
+    if (folder) IShellFolder_Release( folder );
+    free( children );
+    return hr;
+}
