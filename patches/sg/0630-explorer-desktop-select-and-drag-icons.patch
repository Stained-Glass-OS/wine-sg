+/* the mouse on the desktop: what the left button went down on */
+static int sg_press_index = -2;      /* -2 nothing; -1 the empty desktop; else an icon */
+static POINT sg_press_pt;
+static BOOL sg_press_reselect;       /* a plain click on a selected icon: it alone, on release */
+static BOOL sg_press_toggle;         /* the band toggles (Ctrl) rather than adds */
+static BOOL *sg_band_base;           /* the selection the band started from */
+static int sg_anchor = -1;           /* where Shift+click selects from */
+
+static void sg_band_update( HWND hwnd, POINT pt )
+{
+    RECT old = sg_band, dirty, tmp;
+    unsigned int i;
+
+    sg_band_active = TRUE;
+    sg_band.left = min( sg_press_pt.x, pt.x );
+    sg_band.top = min( sg_press_pt.y, pt.y );
+    sg_band.right = max( sg_press_pt.x, pt.x ) + 1;
+    sg_band.bottom = max( sg_press_pt.y, pt.y ) + 1;
+    UnionRect( &dirty, &old, &sg_band );
+    for (i = 0; i < nb_launchers; i++)
+    {
+        RECT box = sg_item_box( i );
+        BOOL base = sg_band_base && sg_band_base[i], hit = IntersectRect( &tmp, &box, &sg_band );
+        BOOL sel = sg_press_toggle ? base != hit : base || hit;
+
+        if (sel == launchers[i]->selected) continue;
+        launchers[i]->selected = sel;
+        if (hit) sg_selected = i;
+        UnionRect( &dirty, &dirty, &box );
+    }
+    InflateRect( &dirty, 1, 1 );
+    sg_redraw( hwnd, &dirty );
+    sg_dump();
+}
+
+static void sg_band_end( HWND hwnd )
+{
+    RECT dirty = sg_band;
+
+    free( sg_band_base );
+    sg_band_base = NULL;
+    if (!sg_band_active) return;
+    sg_band_active = FALSE;
+    SetRectEmpty( &sg_band );
+    InflateRect( &dirty, 1, 1 );
+    sg_redraw( hwnd, &dirty );
+    sg_dump();
+}
