+/* --- the desktop as a drop target --------------------------------------------------- */
+
+static IDataObject *sg_drop_data;
+static IDropTarget *sg_drop_sub;     /* the target the drag is over: a folder icon's or the Desktop folder's */
+static int sg_drop_sub_index = -2;   /* its icon; -1 the Desktop folder; -2 none (the icons move) */
+
+static IDropTarget *sg_target_of( HWND hwnd, const WCHAR *name, BOOL folder_itself )
+{
+    IShellFolder *parent = NULL, *folder = NULL;
+    IDropTarget *dt = NULL;
+    LPITEMIDLIST pidl = NULL;
+    LPCITEMIDLIST child;
+
+    if (SUCCEEDED(SHParseDisplayName( name, NULL, &pidl, 0, NULL )) &&
+        SUCCEEDED(SHBindToParent( pidl, &IID_IShellFolder, (void **)&parent, &child )))
+    {
+        if (!folder_itself)
+            IShellFolder_GetUIObjectOf( parent, hwnd, 1, &child, &IID_IDropTarget, NULL, (void **)&dt );
+        else if (SUCCEEDED(IShellFolder_BindToObject( parent, child, NULL, &IID_IShellFolder, (void **)&folder )))
+            IShellFolder_CreateViewObject( folder, hwnd, &IID_IDropTarget, (void **)&dt );
+    }
+    if (folder) IShellFolder_Release( folder );
+    if (parent) IShellFolder_Release( parent );
+    CoTaskMemFree( pidl );
+    return dt;
+}
+
+static void sg_set_drop_hilite( int index )
+{
+    RECT box;
+
+    if (index == sg_drop_hilite) return;
+    if (sg_drop_hilite >= 0 && sg_drop_hilite < (int)nb_launchers)
+    {
+        box = sg_item_box( sg_drop_hilite );
+        sg_drop_hilite = -1;
+        sg_redraw( sg_desktop_hwnd, &box );
+    }
+    sg_drop_hilite = index;
+    if (index >= 0)
+    {
+        box = sg_item_box( index );
+        sg_redraw( sg_desktop_hwnd, &box );
+    }
+    sg_dump();
+}
+
+static void sg_drop_leave_sub(void)
+{
+    if (sg_drop_sub)
+    {
+        IDropTarget_DragLeave( sg_drop_sub );
+        IDropTarget_Release( sg_drop_sub );
+        sg_drop_sub = NULL;
+    }
+    sg_drop_sub_index = -2;
+    sg_set_drop_hilite( -1 );
+}
+
+/* the drag moved: over a folder icon (or the Recycle Bin, a drive), its own
+ * target; over the empty desktop, the Desktop folder -- or, for the desktop's
+ * own icons, their new place */
+static HRESULT sg_drop_over( DWORD keys, POINTL spt, DWORD *effect, BOOL enter )
+{
+    DWORD allowed = *effect;
+    POINT pt = { spt.x, spt.y };
+    int index, want;
+
+    ScreenToClient( sg_desktop_hwnd, &pt );
+    index = launcher_index_from_point( pt.x, pt.y );
+    if (index >= 0 && ((sg_dragging && launchers[index]->selected) || (launchers[index]->is_file && !launchers[index]->is_dir)))
+        index = -1;
+    want = index >= 0 ? index : sg_dragging ? -2 : -1;
+    if (want != sg_drop_sub_index || enter)
+    {
+        sg_drop_leave_sub();
+        sg_drop_sub_index = want;
+        if (want >= 0) sg_drop_sub = sg_target_of( sg_desktop_hwnd, sg_parse_name( launchers[want] ), FALSE );
+        else if (want == -1) sg_drop_sub = sg_target_of( sg_desktop_hwnd, desktop_folder, TRUE );
+        if (sg_drop_sub)
+        {
+            *effect = allowed;
+            if (FAILED(IDropTarget_DragEnter( sg_drop_sub, sg_drop_data, keys, spt, effect ))) *effect = DROPEFFECT_NONE;
+            sg_set_drop_hilite( want >= 0 && *effect ? want : -1 );
+            return S_OK;
+        }
+    }
+    if (sg_drop_sub)
+    {
+        *effect = allowed;
+        if (FAILED(IDropTarget_DragOver( sg_drop_sub, keys, spt, effect ))) *effect = DROPEFFECT_NONE;
+        sg_set_drop_hilite( sg_drop_sub_index >= 0 && *effect ? sg_drop_sub_index : -1 );
+    }
+    else *effect = want == -2 ? allowed & DROPEFFECT_MOVE : DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI sg_droptarget_QueryInterface( IDropTarget *iface, REFIID riid, void **out )
+{
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IDropTarget ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI sg_droptarget_AddRef( IDropTarget *iface ) { return 2; }
+static ULONG WINAPI sg_droptarget_Release( IDropTarget *iface ) { return 1; }
+
+static HRESULT WINAPI sg_droptarget_DragEnter( IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect )
+{
+    if (sg_drop_data) IDataObject_Release( sg_drop_data );
+    if ((sg_drop_data = data)) IDataObject_AddRef( data );
+    return sg_drop_over( keys, pt, effect, TRUE );
+}
+
+static HRESULT WINAPI sg_droptarget_DragOver( IDropTarget *iface, DWORD keys, POINTL pt, DWORD *effect )
+{
+    return sg_drop_over( keys, pt, effect, FALSE );
+}
+
+static HRESULT WINAPI sg_droptarget_DragLeave( IDropTarget *iface )
+{
+    sg_drop_leave_sub();
+    if (sg_drop_data) IDataObject_Release( sg_drop_data );
+    sg_drop_data = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI sg_droptarget_Drop( IDropTarget *iface, IDataObject *data, DWORD keys, POINTL spt, DWORD *effect )
+{
+    POINT pt = { spt.x, spt.y };
+    HRESULT hr = S_OK;
+
+    sg_drop_over( keys, spt, effect, FALSE );
+    ScreenToClient( sg_desktop_hwnd, &pt );
+    if (sg_drop_sub_index == -2)
+    {
+        TRACE( "moving the selected icons to %ld,%ld\n", pt.x, pt.y );
+        sg_move_selection( sg_desktop_hwnd, pt );
+    }
+    else if (sg_drop_sub && *effect)
+    {
+        if (sg_drop_sub_index == -1 && launcher_size)
+        {
+            /* files dropped on the empty desktop are placed where they were dropped */
+            sg_save_positions();
+            sg_drop_slot = (max( 0, pt.x ) / launcher_size) * max( launchers_per_column, 1 ) +
+                           min( max( 0, pt.y ) / launcher_size, max( launchers_per_column, 1 ) - 1 );
+            sg_drop_time = GetTickCount();
+        }
+        TRACE( "dropping on %d\n", sg_drop_sub_index );
+        hr = IDropTarget_Drop( sg_drop_sub, data, keys, spt, effect );
+        IDropTarget_Release( sg_drop_sub );
+        sg_drop_sub = NULL;
+    }
+    else *effect = DROPEFFECT_NONE;
+    sg_drop_leave_sub();
+    if (sg_drop_data) IDataObject_Release( sg_drop_data );
+    sg_drop_data = NULL;
+    PostMessageW( sg_desktop_hwnd, WM_SG_DESKTOP_RESCAN, 0, 0 );
+    return hr;
+}
+
+static const IDropTargetVtbl sg_droptarget_vtbl =
+{
