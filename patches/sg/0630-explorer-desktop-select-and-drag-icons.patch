+/* the selected icons go with the mouse: the shell's data object for them
+ * (the files; the shell icons when only they are selected), as Explorer's
+ * view drags its items */
+static void sg_drag_icons( HWND hwnd )
+{
+    IDataObject *data;
+    LPITEMIDLIST *pidls;
+    DWORD effect = DROPEFFECT_NONE;
+    unsigned int n;
+
+    sg_ole_init();
+    if (!(n = sg_selection_pidls( TRUE, &pidls )))
+    {
+        sg_free_pidls( pidls, 0 );
+        n = sg_selection_pidls( FALSE, &pidls );
+    }
+    if (SUCCEEDED(sg_items_object( hwnd, pidls, n, &IID_IDataObject, (void **)&data )))
+    {
+        TRACE( "dragging %u item(s)\n", n );
+        sg_dragging = TRUE;
+        sg_drag_image_show( hwnd );
+        DoDragDrop( data, &sg_drop_source, DROPEFFECT_COPY | DROPEFFECT_MOVE | DROPEFFECT_LINK, &effect );
+        sg_dragging = FALSE;
+        if (sg_drag_image) DestroyWindow( sg_drag_image );
+        sg_drag_image = NULL;
+        IDataObject_Release( data );
+    }
+    sg_free_pidls( pidls, n );
+    PostMessageW( hwnd, WM_SG_DESKTOP_RESCAN, 0, 0 );
+}
