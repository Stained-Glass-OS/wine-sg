+/* Shift+click: the icons in the rectangle from the anchor to INDEX, as a list
+ * view of icons selects */
+static void sg_select_range( int index )
+{
+    unsigned int i;
+    int c0, c1, r0, r1;
+
+    if (sg_anchor < 0 || sg_anchor >= (int)nb_launchers) sg_anchor = index;
+    c0 = min( launchers[sg_anchor]->col, launchers[index]->col );
+    c1 = max( launchers[sg_anchor]->col, launchers[index]->col );
+    r0 = min( launchers[sg_anchor]->row, launchers[index]->row );
+    r1 = max( launchers[sg_anchor]->row, launchers[index]->row );
+    for (i = 0; i < nb_launchers; i++)
+        launchers[i]->selected = launchers[i]->col >= c0 && launchers[i]->col <= c1 &&
+                                 launchers[i]->row >= r0 && launchers[i]->row <= r1;
+    sg_selected = index;
+}
