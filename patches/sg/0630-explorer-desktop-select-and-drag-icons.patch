+/* the picture of the dragged icons: a translucent, click-through window the
+ * drag moves with the mouse (drawn on black and on white, for its alpha) */
+static void sg_drag_image_show( HWND hwnd )
+{
+    BITMAPINFO bi = {{ sizeof(bi.bmiHeader) }};
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 0xc8, AC_SRC_ALPHA };
+    RECT bound, anchor, box;
+    DWORD *black, *white;
+    HBITMAP bmb, bmw;
+    HDC screen, mem;
+    WNDCLASSW wc = { 0 };
+    POINT pos, zero = { 0, 0 };
+    SIZE size;
+    unsigned int i, n;
+
+    SetRectEmpty( &bound );
+    anchor = sg_item_box( sg_drag_anchor );
+    for (i = 0; i < nb_launchers; i++)
+        if (launchers[i]->selected) { box = sg_item_box( i ); UnionRect( &bound, &bound, &box ); }
+    /* not too big a picture: what is near the dragged icon */
+    bound.left = max( bound.left, anchor.left - 3 * launcher_size );
+    bound.top = max( bound.top, anchor.top - 3 * launcher_size );
+    bound.right = min( bound.right, anchor.right + 3 * launcher_size );
+    bound.bottom = min( bound.bottom, anchor.bottom + 3 * launcher_size );
+    size.cx = bound.right - bound.left;
+    size.cy = bound.bottom - bound.top;
+    if (size.cx <= 0 || size.cy <= 0) return;
+
+    wc.lpfnWndProc = DefWindowProcW;
+    wc.hInstance = GetModuleHandleW( NULL );
+    wc.lpszClassName = L"SgDesktopDragImage";
+    RegisterClassW( &wc );
+    sg_drag_hot.x = sg_press_pt.x - bound.left;
+    sg_drag_hot.y = sg_press_pt.y - bound.top;
+    pos.x = bound.left;
+    pos.y = bound.top;
+    ClientToScreen( hwnd, &pos );
+    if (!(sg_drag_image = CreateWindowExW( WS_EX_LAYERED | WS_EX_TRANSPARENT | WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_NOACTIVATE,
+                                           wc.lpszClassName, L"", WS_POPUP, pos.x, pos.y, size.cx, size.cy,
+                                           NULL, NULL, wc.hInstance, NULL ))) return;
+    bi.bmiHeader.biWidth = size.cx;
+    bi.bmiHeader.biHeight = -size.cy;
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    screen = GetDC( 0 );
+    mem = CreateCompatibleDC( screen );
+    bmb = CreateDIBSection( screen, &bi, DIB_RGB_COLORS, (void **)&black, NULL, 0 );
+    bmw = CreateDIBSection( screen, &bi, DIB_RGB_COLORS, (void **)&white, NULL, 0 );
+    if (bmb && bmw)
+    {
+        HGDIOBJ old = SelectObject( mem, bmw );
+        SetWindowOrgEx( mem, bound.left, bound.top, NULL );
+        sg_drag_draw( mem, &bound, RGB(255,255,255) );
+        SelectObject( mem, bmb );
+        sg_drag_draw( mem, &bound, RGB(0,0,0) );
+        for (n = 0; n < (unsigned int)(size.cx * size.cy); n++)
+        {
+            /* what shows through white is transparent; on black, the colour premultiplied */
+            int a = 255 - ((white[n] >> 8 & 0xff) - (black[n] >> 8 & 0xff));
+            black[n] = ((DWORD)max( 0, min( 255, a )) << 24) | (black[n] & 0xffffff);
+        }
+        SetWindowOrgEx( mem, 0, 0, NULL );
+        UpdateLayeredWindow( sg_drag_image, screen, &pos, &size, mem, &zero, 0, &blend, ULW_ALPHA );
+        SelectObject( mem, old );
+        ShowWindow( sg_drag_image, SW_SHOWNOACTIVATE );
+    }
+    if (bmb) DeleteObject( bmb );
+    if (bmw) DeleteObject( bmw );
+    DeleteDC( mem );
+    ReleaseDC( 0, screen );
+}
