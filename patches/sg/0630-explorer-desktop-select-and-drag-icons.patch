+/* the selected icons' new places: the dragged one's cell under the mouse, the
+ * others as they were around it; a taken place, the nearest free one */
+static void sg_move_selection( HWND hwnd, POINT pt )
+{
+    int cols = max( launchers_per_row, 1 ), rows = max( launchers_per_column, 1 );
+    int x, y, dc, dr, c, r, best, dist, d;
+    BYTE *used;
+    unsigned int i, k;
+
+    if (sg_drag_anchor < 0 || sg_drag_anchor >= (int)nb_launchers || !launcher_size) return;
+    x = max( 0, pt.x - sg_drag_offset.x + launcher_size / 2 ) / launcher_size;
+    y = max( 0, pt.y - sg_drag_offset.y + launcher_size / 2 ) / launcher_size;
+    dc = min( x, cols - 1 ) - launchers[sg_drag_anchor]->col;
+    dr = min( y, rows - 1 ) - launchers[sg_drag_anchor]->row;
+    if ((!dc && !dr) || !(used = calloc( cols * rows, 1 ))) return;
+    for (i = 0; i < nb_launchers; i++)
+        if (!launchers[i]->selected && launchers[i]->col < cols && launchers[i]->row < rows)
+            used[launchers[i]->col * rows + launchers[i]->row] = 1;
+    /* the dragged icon first: it lands where it was dropped */
+    for (k = 0; k <= nb_launchers; k++)
+    {
+        i = k ? k - 1 : sg_drag_anchor;
+        if ((k && (int)i == sg_drag_anchor) || !launchers[i]->selected) continue;
+        c = max( 0, min( cols - 1, launchers[i]->col + dc ));
+        r = max( 0, min( rows - 1, launchers[i]->row + dr ));
+        for (best = -1, dist = 0x7fffffff, x = 0; x < cols * rows; x++)
+        {
+            if (used[x]) continue;
+            d = max( abs( x / rows - c ), abs( x % rows - r )) * 1000 + abs( x / rows - c ) + abs( x % rows - r );
+            if (d < dist) { dist = d; best = x; }
+        }
+        if (best < 0) break;
+        used[best] = 1;
+        launchers[i]->col = best / rows;
+        launchers[i]->row = best % rows;
+    }
+    free( used );
+    sg_save_positions();
+    InvalidateRect( hwnd, NULL, TRUE );
+}
