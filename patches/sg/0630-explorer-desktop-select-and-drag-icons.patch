+/* Stained Glass OS: draw part of the desktop at once, off screen first (a
+ * rubber band follows the mouse without flicker) */
+static void sg_redraw( HWND hwnd, const RECT *dirty )
+{
+    HDC hdc, mem;
+    HBITMAP bmp;
+    RECT rc, r;
+
+    GetClientRect( hwnd, &rc );
+    if (!IntersectRect( &r, dirty, &rc )) return;
+    hdc = GetDCEx( hwnd, 0, DCX_CACHE | DCX_CLIPCHILDREN );
+    mem = CreateCompatibleDC( hdc );
+    if ((bmp = CreateCompatibleBitmap( hdc, r.right - r.left, r.bottom - r.top )))
+    {
+        HGDIOBJ old = SelectObject( mem, bmp );
+        SetWindowOrgEx( mem, r.left, r.top, NULL );
+        PaintDesktop( mem );
+        draw_launchers( mem, r );
+        BitBlt( hdc, r.left, r.top, r.right - r.left, r.bottom - r.top, mem, r.left, r.top, SRCCOPY );
+        SelectObject( mem, old );
+        DeleteObject( bmp );
+    }
+    DeleteDC( mem );
+    ReleaseDC( hwnd, hdc );
+}
+
+static RECT sg_item_box( unsigned int index )
+{
+    RECT icon = get_icon_rect( index ), title = get_title_rect( index ), box;
+    UnionRect( &box, &icon, &title );
+    InflateRect( &box, 2, 2 );
+    return box;
+}
