+/* every icon a place: the kept one if it is free and on the screen; the rest,
+ * in Sort by's order, in the first free places column by column (or from
+ * where they were just dropped) */
+static void sg_place_icons(void)
+{
+    int cols = max( launchers_per_row, 1 ), rows = max( launchers_per_column, 1 ), slots = cols * rows;
+    int start = 0, extra = slots, slot, n;
+    BYTE *used = calloc( slots, 1 );
+    BOOL kept, added = FALSE;
+    HKEY key = NULL;
+    unsigned int i;
+
+    if (sg_drop_slot >= 0 && sg_drop_slot < slots && GetTickCount() - sg_drop_time < 10000) start = sg_drop_slot;
+    RegOpenKeyExW( HKEY_CURRENT_USER, sg_positions_key, 0, KEY_QUERY_VALUE, &key );
+    kept = key != NULL;
+    for (i = 0; i < nb_launchers; i++)
+    {
+        struct launcher *l = launchers[i];
+        DWORD v, size = sizeof(v), type;
+
+        l->col = -1;
+        if (key && used && !RegQueryValueExW( key, sg_item_key( l ), NULL, &type, (BYTE *)&v, &size ) &&
+            type == REG_DWORD && HIWORD(v) < cols && LOWORD(v) < rows && !used[HIWORD(v) * rows + LOWORD(v)])
+        {
+            l->col = HIWORD(v);
+            l->row = LOWORD(v);
+            used[l->col * rows + l->row] = 1;
+        }
+    }
+    if (key) RegCloseKey( key );
+    for (i = 0; i < nb_launchers; i++)
+    {
+        struct launcher *l = launchers[i];
+
+        if (l->col >= 0) continue;
+        added = TRUE;
+        for (n = 0, slot = -1; used && n < slots; n++)
+            if (!used[(start + n) % slots]) { slot = (start + n) % slots; break; }
+        if (slot < 0) slot = extra++;     /* the screen is full: past its right edge */
+        else used[slot] = 1;
+        l->col = slot / rows;
+        l->row = slot % rows;
+    }
+    free( used );
+    /* once icons have been moved, a new one keeps the place it was given */
+    if (kept && added) sg_save_positions();
+}
+
+/* keep every icon's place (an icon was moved, or files are dropped) */
+static void sg_save_positions(void)
+{
+    HKEY key;
+    unsigned int i;
+
+    if (sg_hide_icons) return;
+    RegDeleteTreeW( HKEY_CURRENT_USER, sg_positions_key );
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, sg_positions_key, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )) return;
+    for (i = 0; i < nb_launchers; i++)
+    {
+        DWORD v = MAKELONG( launchers[i]->row, launchers[i]->col );
+        RegSetValueExW( key, sg_item_key( launchers[i] ), 0, REG_DWORD, (BYTE *)&v, sizeof(v) );
+    }
+    RegCloseKey( key );
+}
+
+/* Sort by lines the icons up again */
+static void sg_forget_positions(void)
+{
+    sg_drop_slot = -1;
+    RegDeleteTreeW( HKEY_CURRENT_USER, sg_positions_key );
+    RegDeleteKeyW( HKEY_CURRENT_USER, sg_positions_key );
+}
