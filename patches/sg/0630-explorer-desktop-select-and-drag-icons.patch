+/* the selected icons drawn on BG (black or white) at their places around the
+ * dragged one, for the picture that follows the mouse */
+static void sg_drag_draw( HDC hdc, const RECT *bound, COLORREF bg )
+{
+    HBRUSH brush = CreateSolidBrush( bg );
+    RECT all = *bound;
+    LOGFONTW lf;
+    HFONT font;
+    unsigned int i;
+
+    FillRect( hdc, &all, brush );
+    DeleteObject( brush );
+    SystemParametersInfoW( SPI_GETICONTITLELOGFONT, sizeof(lf), &lf, 0 );
+    font = SelectObject( hdc, CreateFontIndirectW( &lf ) );
+    SetBkMode( hdc, TRANSPARENT );
+    for (i = 0; i < nb_launchers; i++)
+    {
+        RECT icon = get_icon_rect( i ), title = get_title_rect( i ), shadow, tmp;
+
+        if (!launchers[i]->selected || !IntersectRect( &tmp, &icon, bound )) continue;
+        DrawIconEx( hdc, icon.left, icon.top, launchers[i]->icon, icon_cx, icon_cy, 0, 0, DI_DEFAULTSIZE | DI_NORMAL );
+        shadow = title;
+        OffsetRect( &shadow, 1, 1 );
+        SetTextColor( hdc, RGB(0,0,0) );
+        DrawTextW( hdc, launchers[i]->title, -1, &shadow, DT_CENTER | DT_WORDBREAK | DT_EDITCONTROL | DT_END_ELLIPSIS );
+        SetTextColor( hdc, RGB(255,255,255) );
+        DrawTextW( hdc, launchers[i]->title, -1, &title, DT_CENTER | DT_WORDBREAK | DT_EDITCONTROL | DT_END_ELLIPSIS );
+    }
+    DeleteObject( SelectObject( hdc, font ) );
+    GdiFlush();
+}
