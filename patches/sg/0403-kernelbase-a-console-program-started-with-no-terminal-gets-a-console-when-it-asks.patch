From: Stained Glass OS contributors
Subject: kernelbase: a console program started with no terminal gets a console when it asks for one

On Windows every console program has a console. Wine gives one started
with no terminal -- by a script, a service, a scheduled task, with its
output redirected to a file -- none ("shell, no window"), so opening CONIN$
or CONOUT$ fails. PowerShell 7's console host opens CONOUT$ at start: under
Wine, `pwsh -c ... > log`, a logon or startup script that calls pwsh, or a
service running it, died in ConsoleHost.Start (a NullReferenceException),
ran nothing and exited 0.

When such a program opens CONIN$, CONOUT$ or CON, kernelbase now allocates
it a headless console (conhost --headless), keeping its redirected standard
handles; children inherit it. Programs that never ask cost nothing.

Gate: test/shellconsole-gate.sh (5 checks, 3 fail without this patch).
---
--- a/dlls/kernelbase/console.c
+++ b/dlls/kernelbase/console.c
@@ -393,8 +393,15 @@
 }
 
 
+static BOOL alloc_console_ex( BOOL headless, BOOL keep_std_handles );
+
 static BOOL alloc_console( BOOL headless )
 {
+    return alloc_console_ex( headless, FALSE );
+}
+
+static BOOL alloc_console_ex( BOOL headless, BOOL keep_std_handles )
+{
     SECURITY_ATTRIBUTES inheritable_attr = { sizeof(inheritable_attr), NULL, TRUE };
     STARTUPINFOEXW console_si;
     STARTUPINFOW app_si;
@@ -464,7 +471,7 @@
     Wow64RevertWow64FsRedirection( redir );
 
     if (!ret || !create_console_connection( console)) goto error;
-    if (!init_console_std_handles( !(app_si.dwFlags & STARTF_USESTDHANDLES) )) goto error;
+    if (!init_console_std_handles( !keep_std_handles && !(app_si.dwFlags & STARTF_USESTDHANDLES) )) goto error;
 
     RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle = console;
     TRACE( "Started conhost pid=%08lx tid=%08lx\n", pi.dwProcessId, pi.dwThreadId );
@@ -486,6 +493,29 @@
 }
 
 
+/* A console program started with no terminal -- from a script, a service, a
+ * scheduled task, with its output redirected -- has no console ("shell, no
+ * window"); on Windows every console program has one. When such a program
+ * opens CONIN$ or CONOUT$ (PowerShell's console host does, at start), it gets
+ * one now: headless, its redirected standard handles kept. Programs that
+ * never ask cost nothing. */
+BOOL alloc_shell_console( void )
+{
+    RTL_USER_PROCESS_PARAMETERS *params = RtlGetCurrentPeb()->ProcessParameters;
+    BOOL ret = FALSE;
+
+    RtlEnterCriticalSection( &console_section );
+    if (params->ConsoleHandle == CONSOLE_HANDLE_SHELL_NO_WINDOW &&
+        RtlImageNtHeader( GetModuleHandleW( NULL ))->OptionalHeader.Subsystem == IMAGE_SUBSYSTEM_WINDOWS_CUI)
+    {
+        TRACE( "allocating a headless console for a program with none\n" );
+        params->ConsoleHandle = NULL;
+        if (!(ret = alloc_console_ex( TRUE, TRUE ))) params->ConsoleHandle = CONSOLE_HANDLE_SHELL_NO_WINDOW;
+    }
+    RtlLeaveCriticalSection( &console_section );
+    return ret;
+}
+
 /******************************************************************
  *      AllocConsole   (kernelbase.@)
  */
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -39,6 +39,7 @@
 #include "ioringapi.h"
 
 #include "kernelbase.h"
+#include "wine/condrv.h"
 #include "wine/exception.h"
 #include "wine/debug.h"
 
@@ -917,6 +918,14 @@
         return INVALID_HANDLE_VALUE;
     }
 
+    /* the console of a console program started with none (see alloc_shell_console) */
+    if (RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle == CONSOLE_HANDLE_SHELL_NO_WINDOW)
+    {
+        const WCHAR *dev = wcsncmp( filename, L"\\\\.\\", 4 ) ? filename : filename + 4;
+        if (!wcsicmp( dev, L"CONIN$" ) || !wcsicmp( dev, L"CONOUT$" ) || !wcsicmp( dev, L"CON" ))
+            alloc_shell_console();
+    }
+
     /* now call NtCreateFile */
 
     if (attributes & FILE_FLAG_DELETE_ON_CLOSE)
--- a/dlls/kernelbase/kernelbase.h
+++ b/dlls/kernelbase/kernelbase.h
@@ -37,6 +37,7 @@
 extern void init_startup_info( RTL_USER_PROCESS_PARAMETERS *params );
 extern void init_locale( HMODULE module );
 extern void init_console(void);
+extern BOOL alloc_shell_console(void);
 extern DWORD sg_admin_request( const WCHAR *verb, const WCHAR *arg );
 
 extern const WCHAR windows_dir[];
