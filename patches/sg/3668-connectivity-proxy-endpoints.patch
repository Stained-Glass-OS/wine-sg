+static void test_proxy_configuration(void)
+{
+    static const WCHAR *name = L"Windows.Networking.Connectivity.NetworkInformation";
+    INetworkInformationStatics *statics;
+    IActivationFactory *factory;
+    IAsyncOperation_ProxyConfiguration *op;
+    HKEY key;
+    HSTRING str;
+    HRESULT hr;
+    BYTE *saved = NULL;
+    DWORD saved_size = 0, type;
+
+    WindowsCreateString( name, wcslen( name ), &str );
+    hr = RoGetActivationFactory( str, &IID_IActivationFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    if (hr != S_OK) return;
+    hr = IActivationFactory_QueryInterface( factory, &IID_INetworkInformationStatics, (void **)&statics );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    hr = INetworkInformationStatics_GetProxyConfigurationAsync( statics, NULL, &op );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = INetworkInformationStatics_GetProxyConfigurationAsync( statics, (IUriRuntimeClass *)statics, NULL );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+
+    if (!RegCreateKeyExW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections",
+                          0, NULL, 0, KEY_READ | KEY_WRITE, NULL, &key, NULL ))
+    {
+        if (!RegQueryValueExW( key, L"DefaultConnectionSettings", NULL, &type, NULL, &saved_size ) && (saved = malloc( saved_size )))
+            RegQueryValueExW( key, L"DefaultConnectionSettings", NULL, &type, saved, &saved_size );
+    }
+
+    /* static proxies per scheme, a bypass list with <local> and a wildcard */
+    set_proxy_settings( 2, "http=wproxy:3128;https=sproxy:3129", "<local>;*.corp.example" );
+    check_proxy( statics, L"http://www.example.org/", L"wproxy", 3128 );
+    check_proxy( statics, L"https://www.example.org/", L"sproxy", 3129 );
+    check_proxy( statics, L"http://intranet/", NULL, 0 );
+    check_proxy( statics, L"http://build.corp.example/", NULL, 0 );
+    check_proxy( statics, L"ftp://ftp.example.org/", NULL, 0 );
+    /* one proxy for every scheme */
+    set_proxy_settings( 2, "allproxy:8080", "" );
+    check_proxy( statics, L"http://www.example.org/", L"allproxy", 8080 );
+    check_proxy( statics, L"https://www.example.org/", L"allproxy", 8080 );
+    /* proxy switched off, nothing to auto-detect */
+    set_proxy_settings( 0, "allproxy:8080", "" );
+    check_proxy( statics, L"http://www.example.org/", NULL, 0 );
+
+    if (saved) RegSetValueExW( key, L"DefaultConnectionSettings", 0, REG_BINARY, saved, saved_size );
+    else RegDeleteValueW( key, L"DefaultConnectionSettings" );
+    RegCloseKey( key );
+    free( saved );
+
+    INetworkInformationStatics_Release( statics );
+    IActivationFactory_Release( factory );
+}
