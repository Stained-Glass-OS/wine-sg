+/* ---- ProxyConfiguration ---- */
+
+struct proxy_configuration
+{
+    IProxyConfiguration IProxyConfiguration_iface;
+    LONG ref;
+    boolean direct;
+    IVectorView_Uri *uris;
+};
+
+static inline struct proxy_configuration *impl_from_IProxyConfiguration( IProxyConfiguration *iface )
+{
+    return CONTAINING_RECORD( iface, struct proxy_configuration, IProxyConfiguration_iface );
+}
+
+static HRESULT WINAPI proxy_QueryInterface( IProxyConfiguration *iface, REFIID iid, void **out )
+{
+    struct proxy_configuration *impl = impl_from_IProxyConfiguration( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IProxyConfiguration ))
+    {
+        IProxyConfiguration_AddRef( (*out = &impl->IProxyConfiguration_iface) );
+        return S_OK;
+    }
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI proxy_AddRef( IProxyConfiguration *iface )
+{
+    return InterlockedIncrement( &impl_from_IProxyConfiguration( iface )->ref );
+}
+
+static ULONG WINAPI proxy_Release( IProxyConfiguration *iface )
+{
+    struct proxy_configuration *impl = impl_from_IProxyConfiguration( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->uris) IVectorView_Uri_Release( impl->uris );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI proxy_GetIids( IProxyConfiguration *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = IID_IProxyConfiguration;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI proxy_GetRuntimeClassName( IProxyConfiguration *iface, HSTRING *name )
+{
+    if (!name) return E_POINTER;
+    return WindowsCreateString( RuntimeClass_Windows_Networking_Connectivity_ProxyConfiguration,
+                                wcslen( RuntimeClass_Windows_Networking_Connectivity_ProxyConfiguration ), name );
+}
+
+static HRESULT WINAPI proxy_GetTrustLevel( IProxyConfiguration *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI proxy_get_ProxyUris( IProxyConfiguration *iface, IVectorView_Uri **value )
