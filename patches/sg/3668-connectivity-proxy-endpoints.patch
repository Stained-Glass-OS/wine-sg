+static void check_proxy( INetworkInformationStatics *statics, const WCHAR *url, const WCHAR *proxy_host, DWORD proxy_port )
+{
+    IAsyncOperation_ProxyConfiguration *op;
+    IUriRuntimeClassFactory *uri_factory;
+    IUriRuntimeClass *uri, *proxy_uri;
+    IProxyConfiguration *config;
+    IVectorView_Uri *uris;
+    HSTRING str, host;
+    boolean direct;
+    UINT32 size;
+    INT32 port;
+    HRESULT hr;
+
+    hr = WindowsCreateString( L"Windows.Foundation.Uri", 22, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = RoGetActivationFactory( str, &IID_IUriRuntimeClassFactory, (void **)&uri_factory );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+    hr = WindowsCreateString( url, wcslen( url ), &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IUriRuntimeClassFactory_CreateUri( uri_factory, str, &uri );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsDeleteString( str );
+    IUriRuntimeClassFactory_Release( uri_factory );
+
+    hr = INetworkInformationStatics_GetProxyConfigurationAsync( statics, uri, &op );
+    ok( hr == S_OK, "%s: got hr %#lx.\n", debugstr_w( url ), hr );
+    hr = IAsyncOperation_ProxyConfiguration_GetResults( op, &config );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IAsyncOperation_ProxyConfiguration_Release( op );
+    IUriRuntimeClass_Release( uri );
+
+    hr = IProxyConfiguration_get_CanConnectDirectly( config, &direct );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IProxyConfiguration_get_ProxyUris( config, &uris );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IVectorView_Uri_get_Size( uris, &size );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (!proxy_host)
+    {
+        ok( direct, "%s: expected a direct connection.\n", debugstr_w( url ) );
+        ok( !size, "%s: got %u proxies.\n", debugstr_w( url ), size );
+    }
+    else
+    {
+        ok( !direct, "%s: expected a proxy.\n", debugstr_w( url ) );
+        ok( size == 1, "%s: got %u proxies.\n", debugstr_w( url ), size );
+        if (size == 1)
+        {
+            hr = IVectorView_Uri_GetAt( uris, 0, &proxy_uri );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            hr = IUriRuntimeClass_get_Host( proxy_uri, &host );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            hr = IUriRuntimeClass_get_Port( proxy_uri, &port );
+            ok( hr == S_OK && port == proxy_port, "%s: got port %d.\n", debugstr_w( url ), port );
+            ok( !wcscmp( WindowsGetStringRawBuffer( host, NULL ), proxy_host ), "%s: got proxy host %s.\n",
+                debugstr_w( url ), debugstr_hstring( host ) );
+            WindowsDeleteString( host );
+            IUriRuntimeClass_Release( proxy_uri );
+        }
+    }
+    IVectorView_Uri_Release( uris );
+    IProxyConfiguration_Release( config );
+}
