+    iterator_GetTrustLevel, iterator_get_Current, iterator_get_HasCurrent, iterator_MoveNext, iterator_GetMany,
+};
+
+static void check_order( INetworkInformationStatics *statics, IHostNameFactory *hosts, IEndpointPairFactory *pairs,
+                         HostNameSortOptions options, const WCHAR **input, const int *expected, UINT32 count, const char *what )
+{
+    struct test_iterable iterable = { {&iterable_vtbl}, {&iterator_vtbl} };
+    IVectorView_EndpointPair *sorted;
+    IEndpointPair **objects;
+    UINT32 i, size;
+    HRESULT hr;
+
+    objects = calloc( count, sizeof(*objects) );
+    for (i = 0; i < count; i++) objects[i] = make_pair( hosts, pairs, input[i], L"80" );
+    iterable.items = objects;
+    iterable.count = count;
+
+    hr = INetworkInformationStatics_GetSortedEndpointPairs( statics, &iterable.IIterable_iface, options, &sorted );
+    ok( hr == S_OK, "%s: got hr %#lx.\n", what, hr );
+    if (hr == S_OK)
+    {
+        hr = IVectorView_EndpointPair_get_Size( sorted, &size );
+        ok( hr == S_OK && size == count, "%s: got hr %#lx, size %u.\n", what, hr, size );
+        for (i = 0; i < min( size, count ); i++)
+        {
+            IEndpointPair *got;
+            hr = IVectorView_EndpointPair_GetAt( sorted, i, &got );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            ok( got == objects[expected[i]], "%s: position %u holds %p, expected input %d.\n", what, i, got, expected[i] );
+            IEndpointPair_Release( got );
+        }
+        IVectorView_EndpointPair_Release( sorted );
+    }
+    for (i = 0; i < count; i++) IEndpointPair_Release( objects[i] );
+    free( objects );
+}
+
+static void test_sorted_endpoints(void)
+{
+    static const WCHAR *host_name = L"Windows.Networking.HostName", *pair_name = L"Windows.Networking.EndpointPair";
+    static const WCHAR *a[] = { L"8.8.8.8", L"127.0.0.1" };
+    static const int a_order[] = { 1, 0 };
+    static const WCHAR *b[] = { L"127.0.0.2", L"127.0.0.1" };
+    static const int b_order[] = { 0, 1 };
+    static const WCHAR *c[] = { L"example.invalid", L"127.0.0.1" };
+    static const int c_order[] = { 1, 0 };
+    IHostNameFactory *hosts;
+    IEndpointPairFactory *pairs;
+    INetworkInformationStatics *statics;
+    IActivationFactory *factory;
+    HSTRING str;
+    HRESULT hr;
+
+    WindowsCreateString( L"Windows.Networking.Connectivity.NetworkInformation", 50, &str );
+    hr = RoGetActivationFactory( str, &IID_IActivationFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    if (hr != S_OK) return;
+    IActivationFactory_QueryInterface( factory, &IID_INetworkInformationStatics, (void **)&statics );
+
+    WindowsCreateString( host_name, wcslen( host_name ), &str );
+    hr = RoGetActivationFactory( str, &IID_IHostNameFactory, (void **)&hosts );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsCreateString( pair_name, wcslen( pair_name ), &str );
+    hr = RoGetActivationFactory( str, &IID_IEndpointPairFactory, (void **)&pairs );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+
+    hr = INetworkInformationStatics_GetSortedEndpointPairs( statics, NULL, HostNameSortOptions_None, (void *)&str );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+
+    /* loopback is the smaller scope; an unreachable or equal-ranked destination keeps the order */
+    check_order( statics, hosts, pairs, HostNameSortOptions_None, a, a_order, 2, "scope" );
+    check_order( statics, hosts, pairs, HostNameSortOptions_None, b, b_order, 2, "stable" );
+    check_order( statics, hosts, pairs, HostNameSortOptions_None, c, c_order, 2, "names last" );
+
+    IEndpointPairFactory_Release( pairs );
+    IHostNameFactory_Release( hosts );
+    INetworkInformationStatics_Release( statics );
+    IActivationFactory_Release( factory );
+}
