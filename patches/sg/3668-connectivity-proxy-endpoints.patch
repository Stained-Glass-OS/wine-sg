+static ULONG WINAPI iterator_AddRef( IIterator_EndpointPair *iface ) { return 2; }
+static ULONG WINAPI iterator_Release( IIterator_EndpointPair *iface ) { return 1; }
+static HRESULT WINAPI iterator_GetIids( IIterator_EndpointPair *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI iterator_GetRuntimeClassName( IIterator_EndpointPair *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI iterator_GetTrustLevel( IIterator_EndpointPair *iface, TrustLevel *level ) { return E_NOTIMPL; }
+static HRESULT WINAPI iterator_get_Current( IIterator_EndpointPair *iface, IEndpointPair **value )
+{
+    struct test_iterable *impl = iterator_from( iface );
+    if (impl->index >= impl->count) return E_BOUNDS;
+    IEndpointPair_AddRef( (*value = impl->items[impl->index]) );
+    return S_OK;
+}
+static HRESULT WINAPI iterator_get_HasCurrent( IIterator_EndpointPair *iface, boolean *value )
+{
+    struct test_iterable *impl = iterator_from( iface );
+    *value = impl->index < impl->count;
+    return S_OK;
+}
+static HRESULT WINAPI iterator_MoveNext( IIterator_EndpointPair *iface, boolean *value )
+{
+    struct test_iterable *impl = iterator_from( iface );
+    if (impl->index < impl->count) impl->index++;
+    *value = impl->index < impl->count;
+    return S_OK;
+}
+static HRESULT WINAPI iterator_GetMany( IIterator_EndpointPair *iface, UINT32 size, IEndpointPair **items, UINT32 *count )
+{
+    return E_NOTIMPL;
