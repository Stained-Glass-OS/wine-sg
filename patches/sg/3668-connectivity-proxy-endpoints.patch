+    struct proxy_configuration *impl = impl_from_IProxyConfiguration( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    IVectorView_Uri_AddRef( (*value = impl->uris) );
+    return S_OK;
+}
+
+static HRESULT WINAPI proxy_get_CanConnectDirectly( IProxyConfiguration *iface, boolean *value )
