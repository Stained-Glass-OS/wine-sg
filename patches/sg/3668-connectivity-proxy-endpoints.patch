+static IEndpointPair *make_pair( IHostNameFactory *hosts, IEndpointPairFactory *pairs, const WCHAR *remote, const WCHAR *service )
+{
+    HSTRING_HEADER h1, h2, h3;
+    HSTRING s1, s2, s3;
+    IHostName *host;
+    IEndpointPair *pair;
+    HRESULT hr;
+
+    WindowsCreateStringReference( remote, wcslen( remote ), &h1, &s1 );
+    WindowsCreateStringReference( service, wcslen( service ), &h2, &s2 );
+    WindowsCreateStringReference( L"0", 1, &h3, &s3 );
+    hr = IHostNameFactory_CreateHostName( hosts, s1, &host );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IEndpointPairFactory_CreateEndpointPair( pairs, NULL, s3, host, s2, &pair );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IHostName_Release( host );
+    return pair;
+}
