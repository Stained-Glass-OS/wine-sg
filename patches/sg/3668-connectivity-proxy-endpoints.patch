+/* an IIterable<EndpointPair> over an array, with its own iterator */
+struct test_iterable
+{
+    IIterable_EndpointPair IIterable_iface;
+    IIterator_EndpointPair IIterator_iface;
+    IEndpointPair **items;
+    UINT32 count, index;
+};
+
+static struct test_iterable *iterable_from( IIterable_EndpointPair *iface )
+{
+    return CONTAINING_RECORD( iface, struct test_iterable, IIterable_iface );
+}
+
+static struct test_iterable *iterator_from( IIterator_EndpointPair *iface )
+{
+    return CONTAINING_RECORD( iface, struct test_iterable, IIterator_iface );
+}
+
+static HRESULT WINAPI iterable_QueryInterface( IIterable_EndpointPair *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IIterable_EndpointPair ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI iterable_AddRef( IIterable_EndpointPair *iface ) { return 2; }
+static ULONG WINAPI iterable_Release( IIterable_EndpointPair *iface ) { return 1; }
+static HRESULT WINAPI iterable_GetIids( IIterable_EndpointPair *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI iterable_GetRuntimeClassName( IIterable_EndpointPair *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI iterable_GetTrustLevel( IIterable_EndpointPair *iface, TrustLevel *level ) { return E_NOTIMPL; }
+static HRESULT WINAPI iterable_First( IIterable_EndpointPair *iface, IIterator_EndpointPair **value )
+{
+    struct test_iterable *impl = iterable_from( iface );
+    impl->index = 0;
+    *value = &impl->IIterator_iface;
+    return S_OK;
+}
