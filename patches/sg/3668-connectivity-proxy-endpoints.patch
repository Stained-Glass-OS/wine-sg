+/* ---- proxy lookup ---- */
+
+/* "*" matches any run of characters; case insensitive */
+static BOOL wildcard_match( const WCHAR *pattern, const WCHAR *text )
+{
+    if (!*pattern) return !*text;
+    if (*pattern == '*')
+    {
+        do { if (wildcard_match( pattern + 1, text )) return TRUE; } while (*text++);
+        return FALSE;
+    }
+    return *text && towlower( *pattern ) == towlower( *text ) && wildcard_match( pattern + 1, text + 1 );
+}
+
+static BOOL is_separator( WCHAR c ) { return c == ';' || c == ' ' || c == '\t' || c == ','; }
+
+static BOOL host_bypassed( const WCHAR *bypass, const WCHAR *host )
+{
+    WCHAR token[256];
+    const WCHAR *p = bypass;
+
+    while (p && *p)
+    {
+        SIZE_T len;
+
+        while (is_separator( *p )) p++;
+        for (len = 0; p[len] && !is_separator( p[len] ); len++) {}
+        if (len && len < ARRAY_SIZE(token))
+        {
+            memcpy( token, p, len * sizeof(WCHAR) );
+            token[len] = 0;
+            if (!wcsicmp( token, L"<local>" ))
+            {
+                if (!wcschr( host, '.' )) return TRUE;
+            }
+            else if (wildcard_match( token, host )) return TRUE;
+        }
+        p += len;
+    }
+    return FALSE;
+}
+
+/* The proxy URL for "scheme" out of a WinHTTP proxy list: "[scheme=]host:port;...". */
+static WCHAR *select_proxy( const WCHAR *list, const WCHAR *scheme )
+{
+    WCHAR token[512], *url, *eq;
+    const WCHAR *p = list;
+    WCHAR *plain = NULL;
+
+    while (p && *p)
+    {
+        SIZE_T len;
+
+        while (is_separator( *p )) p++;
+        for (len = 0; p[len] && !is_separator( p[len] ); len++) {}
+        if (len && len < ARRAY_SIZE(token))
+        {
+            memcpy( token, p, len * sizeof(WCHAR) );
+            token[len] = 0;
+            if ((eq = wcschr( token, '=' )) && !wcsstr( token, L"://" ))
+            {
+                *eq++ = 0;
+#ifdef SG_MUTANT_PROXY_SCHEME
+                if (1)
+#else
+                if (!wcsicmp( token, scheme ))
+#endif
+                {
+                    free( plain );
+                    plain = wcsdup( eq );
+                    break;
+                }
+            }
+            else if (!plain) plain = wcsdup( token );
+        }
+        p += len;
+    }
+    if (!plain) return NULL;
+    if (wcsstr( plain, L"://" )) return plain;
+    if (!(url = malloc( (wcslen( plain ) + 8) * sizeof(WCHAR) ))) return plain;
+    wcscpy( url, L"http://" );
+    wcscat( url, plain );
+    free( plain );
+    return url;
+}
+
+/* The proxy "uri" goes through, or NULL for a direct connection. */
+static WCHAR *lookup_proxy( const WCHAR *uri_text, const WCHAR *scheme, const WCHAR *host )
+{
+    WINHTTP_CURRENT_USER_IE_PROXY_CONFIG ie = {0};
+    WINHTTP_AUTOPROXY_OPTIONS opts = {0};
+    WINHTTP_PROXY_INFO info = {0};
+    const WCHAR *list = NULL, *bypass = NULL;
+    WCHAR *result = NULL, *auto_list = NULL;
+    HINTERNET session = NULL;
+
+    if (!WinHttpGetIEProxyConfigForCurrentUser( &ie )) return NULL;
+
+    if ((ie.fAutoDetect || ie.lpszAutoConfigUrl) &&
+        (session = WinHttpOpen( NULL, WINHTTP_ACCESS_TYPE_NO_PROXY, NULL, NULL, 0 )))
+    {
+        if (ie.fAutoDetect)
+        {
+            opts.dwFlags = WINHTTP_AUTOPROXY_AUTO_DETECT;
+            opts.dwAutoDetectFlags = WINHTTP_AUTO_DETECT_TYPE_DHCP | WINHTTP_AUTO_DETECT_TYPE_DNS_A;
+        }
+        else
+        {
+            opts.dwFlags = WINHTTP_AUTOPROXY_CONFIG_URL;
+            opts.lpszAutoConfigUrl = ie.lpszAutoConfigUrl;
+        }
+        if (WinHttpGetProxyForUrl( session, uri_text, &opts, &info ))
+        {
+            if (info.dwAccessType == WINHTTP_ACCESS_TYPE_NAMED_PROXY && info.lpszProxy)
+            {
+                list = auto_list = wcsdup( info.lpszProxy );
+                bypass = NULL;
+            }
+            else
+            {
+                /* the script says DIRECT */
+                if (info.lpszProxy) GlobalFree( info.lpszProxy );
+                if (info.lpszProxyBypass) GlobalFree( info.lpszProxyBypass );
+                WinHttpCloseHandle( session );
+                goto done;
+            }
+            if (info.lpszProxy) GlobalFree( info.lpszProxy );
+            if (info.lpszProxyBypass) GlobalFree( info.lpszProxyBypass );
+        }
+        WinHttpCloseHandle( session );
+    }
+    if (!list)
+    {
+        list = ie.lpszProxy;
+        bypass = ie.lpszProxyBypass;
+    }
+
+#ifdef SG_MUTANT_PROXY_BYPASS
+    bypass = NULL;
+#endif
+    if (list && *list && !(bypass && host_bypassed( bypass, host )))
+        result = select_proxy( list, scheme );
+
+done:
+    free( auto_list );
+    if (ie.lpszAutoConfigUrl) GlobalFree( ie.lpszAutoConfigUrl );
+    if (ie.lpszProxy) GlobalFree( ie.lpszProxy );
+    if (ie.lpszProxyBypass) GlobalFree( ie.lpszProxyBypass );
+    return result;
+}
+
+HRESULT proxy_configuration_async( IUriRuntimeClass *uri, IAsyncOperation_ProxyConfiguration **value )
+{
+    IUriRuntimeClassFactory *uri_factory = NULL;
+    struct proxy_configuration *config;
+    struct proxy_async *op;
+    HSTRING absolute = NULL, scheme = NULL, host = NULL, proxy_text = NULL;
+    IUriRuntimeClass *proxy_uri = NULL;
+    WCHAR *proxy = NULL;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!uri) return E_INVALIDARG;
+
+    if (FAILED(hr = IUriRuntimeClass_get_AbsoluteUri( uri, &absolute )) ||
+        FAILED(hr = IUriRuntimeClass_get_SchemeName( uri, &scheme )) ||
+        FAILED(hr = IUriRuntimeClass_get_Host( uri, &host )))
+        goto done;
+
+    proxy = lookup_proxy( WindowsGetStringRawBuffer( absolute, NULL ), WindowsGetStringRawBuffer( scheme, NULL ),
+                          WindowsGetStringRawBuffer( host, NULL ) );
+
+    if (!(config = calloc( 1, sizeof(*config) ))) { hr = E_OUTOFMEMORY; goto done; }
+    config->IProxyConfiguration_iface.lpVtbl = &proxy_vtbl;
+    config->ref = 1;
+    config->direct = !proxy;
+    if (proxy)
+    {
+        IUriRuntimeClass **elements;
+
+        if (!(elements = calloc( 1, sizeof(*elements) ))) hr = E_OUTOFMEMORY;
+        else if (SUCCEEDED(hr = WindowsCreateString( proxy, wcslen( proxy ), &proxy_text )))
+        {
+            HSTRING class_name;
+
+            hr = WindowsCreateString( RuntimeClass_Windows_Foundation_Uri,
+                                      wcslen( RuntimeClass_Windows_Foundation_Uri ), &class_name );
+            if (SUCCEEDED(hr))
+            {
+                hr = RoGetActivationFactory( class_name, &IID_IUriRuntimeClassFactory, (void **)&uri_factory );
+                WindowsDeleteString( class_name );
+            }
+            if (SUCCEEDED(hr)) hr = IUriRuntimeClassFactory_CreateUri( uri_factory, proxy_text, &proxy_uri );
+        }
+        if (SUCCEEDED(hr))
+        {
+            elements[0] = proxy_uri;
+            proxy_uri = NULL;
+            hr = vector_view_create( VECTOR_URI, (void **)elements, 1, (void **)&config->uris );
+        }
+        free( elements );
+    }
+    else hr = vector_view_create( VECTOR_URI, NULL, 0, (void **)&config->uris );
+    if (FAILED(hr))
+    {
+        IProxyConfiguration_Release( &config->IProxyConfiguration_iface );
+        goto done;
+    }
+
+    if (!(op = calloc( 1, sizeof(*op) )))
+    {
+        IProxyConfiguration_Release( &config->IProxyConfiguration_iface );
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    op->IAsyncOperation_iface.lpVtbl = &aop_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &ainfo_vtbl;
+    op->ref = 1;
+    op->result = &config->IProxyConfiguration_iface;
+    *value = &op->IAsyncOperation_iface;
+
+done:
+    if (proxy_uri) IUriRuntimeClass_Release( proxy_uri );
+    if (uri_factory) IUriRuntimeClassFactory_Release( uri_factory );
+    WindowsDeleteString( proxy_text );
+    WindowsDeleteString( absolute );
+    WindowsDeleteString( scheme );
+    WindowsDeleteString( host );
+    free( proxy );
+    return hr;
+}
+
+
+/* ---- endpoint pair ordering (RFC 6724 destination address selection) ---- */
+
+struct address_info
+{
+    IN6_ADDR addr;      /* IPv4 as ::ffff:a.b.c.d */
+    BOOL is_v4;
+};
+
+static BOOL address_from_name( const WCHAR *text, struct address_info *info )
+{
+    const WCHAR *end;
+    IN_ADDR a4;
+
+    if (!RtlIpv4StringToAddressW( text, TRUE, &end, &a4 ) && !*end)
+    {
+        memset( &info->addr, 0, sizeof(info->addr) );
+        info->addr.u.Word[5] = 0xffff;
+        memcpy( &info->addr.u.Byte[12], &a4, 4 );
+        info->is_v4 = TRUE;
+        return TRUE;
+    }
+    if (wcschr( text, ':' ) && !RtlIpv6StringToAddressW( text, &end, &info->addr ) && !*end)
+    {
+        info->is_v4 = FALSE;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static int prefix_match( const IN6_ADDR *a, const IN6_ADDR *b, int bits )
+{
+    int i;
+
+    for (i = 0; i < bits / 8; i++) if (a->u.Byte[i] != b->u.Byte[i]) return 0;
+    if (bits % 8)
+    {
+        BYTE mask = 0xff << (8 - bits % 8);
+        if ((a->u.Byte[bits / 8] ^ b->u.Byte[bits / 8]) & mask) return 0;
+    }
+    return 1;
+}
+
+static int common_prefix( const IN6_ADDR *a, const IN6_ADDR *b )
+{
+    int i, bit;
+
+    for (i = 0; i < 16; i++)
+    {
+        BYTE diff = a->u.Byte[i] ^ b->u.Byte[i];
+        if (!diff) continue;
+        for (bit = 0; bit < 8; bit++) if (diff & (0x80 >> bit)) return i * 8 + bit;
+    }
+    return 128;
+}
+
+/* the default policy table of RFC 6724 section 2.1 */
+static void policy_lookup( const IN6_ADDR *addr, int *precedence, int *label )
+{
+    IN6_ADDR p;
+    int best = -1, bits = -1;
+
+    /* longest matching prefix wins; entries are built here from their textual form */
+    static const struct { const char *text; int bits, precedence, label; } rows[] =
+    {
+        { "::1", 128, 50, 0 }, { "::", 0, 40, 1 }, { "::ffff:0:0", 96, 35, 4 }, { "2002::", 16, 30, 2 },
+        { "2001::", 32, 5, 5 }, { "fc00::", 7, 3, 13 }, { "::", 96, 1, 3 }, { "fec0::", 10, 1, 11 },
+        { "3ffe::", 16, 1, 12 },
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(rows); i++)
+    {
+        WCHAR wide[40];
+        const WCHAR *end;
+
+        MultiByteToWideChar( CP_ACP, 0, rows[i].text, -1, wide, ARRAY_SIZE(wide) );
+        if (RtlIpv6StringToAddressW( wide, &end, &p )) continue;
+        if (rows[i].bits > bits && prefix_match( addr, &p, rows[i].bits )) { best = i; bits = rows[i].bits; }
+    }
+    *precedence = rows[best].precedence;
+    *label = rows[best].label;
+}
+
+/* scope of RFC 6724 section 3.1: 2 link-local, 5 site-local, 14 global */
+static int address_scope( const struct address_info *info )
+{
+    const IN6_ADDR *a = &info->addr;
+
+    if (info->is_v4)
+    {
+        if (a->u.Byte[12] == 127 || (a->u.Byte[12] == 169 && a->u.Byte[13] == 254)) return 2;
+        return 14;
+    }
+    if (a->u.Byte[0] == 0xff) return a->u.Byte[1] & 0x0f;
+    if (IN6_IS_ADDR_LOOPBACK( a ) || (a->u.Byte[0] == 0xfe && (a->u.Byte[1] & 0xc0) == 0x80)) return 2;
+    if (a->u.Byte[0] == 0xfe && (a->u.Byte[1] & 0xc0) == 0xc0) return 5;
+    return 14;
+}
+
+struct pair_entry
+{
+    IEndpointPair *pair;
+    UINT32 index;
+    BOOL is_address;            /* the remote host is an IP address (else a name, ranked last) */
+    BOOL usable;
+    BOOL tunnel;                /* Teredo or 6to4 */
+    struct address_info dest, source;
+    int scope, source_scope, label, source_label, precedence;
+    BOOL long_connections;
+};
+
+static int compare_entries( const struct pair_entry *a, const struct pair_entry *b )
+{
+    int ma, mb, diff;
+
+#ifndef SG_MUTANT_SORT_NAMES
+    if (a->is_address != b->is_address) return a->is_address ? -1 : 1;
+#endif
+    if (!a->is_address) return a->index < b->index ? -1 : 1;
+
+    /* rule 1: avoid unusable destinations */
+    if (a->usable != b->usable) return a->usable ? -1 : 1;
+    if (a->usable)
+    {
+        /* rule 2: prefer matching scope */
+        ma = a->scope == a->source_scope;
+        mb = b->scope == b->source_scope;
+        if (ma != mb) return ma ? -1 : 1;
+        /* rule 5: prefer matching label */
+        ma = a->label == a->source_label;
+        mb = b->label == b->source_label;
+        if (ma != mb) return ma ? -1 : 1;
+        /* rule 6: prefer higher precedence */
+        if (a->precedence != b->precedence) return a->precedence > b->precedence ? -1 : 1;
+        /* rule 7 (for long connections): prefer native transport over tunnels */
+        if (a->long_connections && a->tunnel != b->tunnel) return a->tunnel ? 1 : -1;
+        /* rule 8: prefer smaller scope */
+#ifdef SG_MUTANT_SORT_SCOPE
+        if (a->scope != b->scope) return a->scope < b->scope ? 1 : -1;
+#else
+        if (a->scope != b->scope) return a->scope < b->scope ? -1 : 1;
+#endif
+        /* rule 9: longest matching prefix (IPv6 pairs only) */
+        if (!a->dest.is_v4 && !b->dest.is_v4)
+        {
+            diff = common_prefix( &a->dest.addr, &a->source.addr ) - common_prefix( &b->dest.addr, &b->source.addr );
+            if (diff) return diff > 0 ? -1 : 1;
+        }
+    }
+    /* rule 10: leave the order unchanged */
+    return a->index < b->index ? -1 : 1;
+}
+
+/* the source address the host would pick to reach "dest"; FALSE when the destination is unreachable */
+static BOOL find_source( const struct address_info *dest, WORD port, struct address_info *source )
+{
+    SOCKET s;
+    SOCKADDR_STORAGE addr = {0}, local = {0};
+    int len = sizeof(local), addr_len;
+    BOOL ret = FALSE;
+
+    if (dest->is_v4)
+    {
+        SOCKADDR_IN *in = (SOCKADDR_IN *)&addr;
+        in->sin_family = AF_INET;
+        in->sin_port = port;
+        memcpy( &in->sin_addr, &dest->addr.u.Byte[12], 4 );
+        addr_len = sizeof(*in);
+    }
+    else
+    {
+        SOCKADDR_IN6 *in6 = (SOCKADDR_IN6 *)&addr;
+        in6->sin6_family = AF_INET6;
+        in6->sin6_port = port;
+        in6->sin6_addr = dest->addr;
+        addr_len = sizeof(*in6);
+    }
+    if ((s = socket( addr.ss_family, SOCK_DGRAM, IPPROTO_UDP )) == INVALID_SOCKET) return FALSE;
+    if (!connect( s, (SOCKADDR *)&addr, addr_len ) && !getsockname( s, (SOCKADDR *)&local, &len ))
+    {
+        memset( source, 0, sizeof(*source) );
+        if (local.ss_family == AF_INET)
+        {
+            source->is_v4 = TRUE;
+            source->addr.u.Word[5] = 0xffff;
+            memcpy( &source->addr.u.Byte[12], &((SOCKADDR_IN *)&local)->sin_addr, 4 );
+        }
+        else source->addr = ((SOCKADDR_IN6 *)&local)->sin6_addr;
+        ret = TRUE;
+    }
+    closesocket( s );
+    return ret;
+}
+
+/* a plain insertion sort keeps this stable and simple */
+static void sort_entries( struct pair_entry *entries, UINT32 count )
+{
+    UINT32 i, j;
+
+    for (i = 1; i < count; i++)
+    {
+        struct pair_entry key = entries[i];
+
+        for (j = i; j > 0 && compare_entries( &entries[j - 1], &key ) > 0; j--) entries[j] = entries[j - 1];
+        entries[j] = key;
+    }
+}
+
+HRESULT sorted_endpoint_pairs( IIterable_EndpointPair *pairs, HostNameSortOptions options, IVectorView_EndpointPair **value )
+{
+    IIterator_EndpointPair *iterator = NULL;
+    struct pair_entry *entries = NULL;
+    UINT32 count = 0, capacity = 0, i;
+    WSADATA data;
+    boolean has;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!pairs) return E_INVALIDARG;
+
+    WSAStartup( MAKEWORD(2, 2), &data );
+
+    if (FAILED(hr = IIterable_EndpointPair_First( pairs, &iterator ))) goto done;
+    if (FAILED(hr = IIterator_EndpointPair_get_HasCurrent( iterator, &has ))) goto done;
+    while (has)
+    {
+        struct pair_entry *entry;
+        IHostName *remote = NULL;
+        HSTRING canonical = NULL, service = NULL;
+        IEndpointPair *pair;
+        HostNameType type;
+        WORD port = htons( 9 );
+
+        if (count == capacity)
+        {
+            struct pair_entry *tmp = realloc( entries, (capacity ? capacity * 2 : 8) * sizeof(*entries) );
+            if (!tmp) { hr = E_OUTOFMEMORY; goto done; }
+            entries = tmp;
+            capacity = capacity ? capacity * 2 : 8;
+        }
+        if (FAILED(hr = IIterator_EndpointPair_get_Current( iterator, &pair ))) goto done;
+        entry = &entries[count++];
+        memset( entry, 0, sizeof(*entry) );
+        entry->pair = pair;
+        entry->index = count - 1;
+        entry->long_connections = !!(options & HostNameSortOptions_OptimizeForLongConnections);
+
+        if (SUCCEEDED(IEndpointPair_get_RemoteHostName( pair, &remote )) && remote)
+        {
+            if (SUCCEEDED(IHostName_get_Type( remote, &type )) && type != HostNameType_DomainName &&
+                SUCCEEDED(IHostName_get_CanonicalName( remote, &canonical )))
+                entry->is_address = address_from_name( WindowsGetStringRawBuffer( canonical, NULL ), &entry->dest );
+            WindowsDeleteString( canonical );
+            IHostName_Release( remote );
+        }
+        if (entry->is_address)
+        {
+            if (SUCCEEDED(IEndpointPair_get_RemoteServiceName( pair, &service )) && service)
+            {
+                const WCHAR *text = WindowsGetStringRawBuffer( service, NULL );
+                if (*text >= '0' && *text <= '9') port = htons( wcstoul( text, NULL, 10 ) );
+            }
+            WindowsDeleteString( service );
+
+            entry->usable = find_source( &entry->dest, port, &entry->source );
+            entry->scope = address_scope( &entry->dest );
+            policy_lookup( &entry->dest.addr, &entry->precedence, &entry->label );
+            if (entry->usable)
+            {
+                int unused;
+                entry->source_scope = address_scope( &entry->source );
+                policy_lookup( &entry->source.addr, &unused, &entry->source_label );
+            }
+            entry->tunnel = !entry->dest.is_v4 && (entry->label == 2 || entry->label == 5);
+        }
+        if (FAILED(hr = IIterator_EndpointPair_MoveNext( iterator, &has ))) goto done;
+    }
+
+#ifndef SG_MUTANT_SORT_NONE
+    sort_entries( entries, count );
+#endif
+    {
+        IEndpointPair **elements = calloc( count + 1, sizeof(*elements) );
+
+        if (!elements) { hr = E_OUTOFMEMORY; goto done; }
+        for (i = 0; i < count; i++)
+        {
+            elements[i] = entries[i].pair;
+            entries[i].pair = NULL;
+        }
+        hr = vector_view_create( VECTOR_ENDPOINT_PAIR, (void **)elements, count, (void **)value );
+        free( elements );
+    }
+
+done:
+    for (i = 0; i < count; i++) if (entries[i].pair) IEndpointPair_Release( entries[i].pair );
+    free( entries );
+    if (iterator) IIterator_EndpointPair_Release( iterator );
+    WSACleanup();
+    return hr;
+}
