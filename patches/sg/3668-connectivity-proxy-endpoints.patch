+static void set_proxy_settings( DWORD flags, const char *proxy, const char *bypass )
+{
+    static const WCHAR *path = L"Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections";
+    DWORD plen = strlen( proxy ), blen = strlen( bypass ), size = 12 + 4 + plen + 4 + blen + 4;
+    BYTE *blob = calloc( 1, size ), *p = blob;
+    HKEY key;
+
+    *(DWORD *)p = 0x46; p += 4;
+    *(DWORD *)p = 0; p += 4;
+    *(DWORD *)p = flags; p += 4;
+    *(DWORD *)p = plen; p += 4;
+    memcpy( p, proxy, plen ); p += plen;
+    *(DWORD *)p = blen; p += 4;
+    memcpy( p, bypass, blen ); p += blen;
+    *(DWORD *)p = 0;
+    if (!RegCreateKeyExW( HKEY_CURRENT_USER, path, 0, NULL, 0, KEY_WRITE, NULL, &key, NULL ))
+    {
+        RegSetValueExW( key, L"DefaultConnectionSettings", 0, REG_BINARY, blob, size );
+        RegCloseKey( key );
+    }
+    free( blob );
+}
