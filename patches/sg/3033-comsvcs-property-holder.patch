--- a/dlls/comsvcs/main.c
+++ b/dlls/comsvcs/main.c
@@ -38,6 +38,16 @@ typedef struct holder
     LONG ref;
 
     IDispenserDriver *driver;
+
+    CRITICAL_SECTION cs;
+    struct tracked_resource
+    {
+        BOOL is_string;
+        BOOL in_use;
+        RESID id;
+        WCHAR *sid;
+    } *resources;
+    unsigned int count;
 } holder;
 
 struct new_moniker
@@ -108,21 +118,105 @@ static ULONG WINAPI holder_Release(IHolder *iface)
 
     if (!ref)
     {
+        unsigned int i;
+
+        /* never closed: give the driver reference back */
+        if (This->driver) IDispenserDriver_Release(This->driver);
+        for (i = 0; i < This->count; i++) free(This->resources[i].sid);
+        free(This->resources);
+        DeleteCriticalSection(&This->cs);
         free(This);
     }
 
     return ref;
 }
 
+/* resources handed out or pooled by the holder; callers hold the cs */
+static struct tracked_resource *holder_find(holder *This, BOOL is_string, RESID id, const WCHAR *sid)
+{
+    unsigned int i;
+
+    for (i = 0; i < This->count; i++)
+    {
+        struct tracked_resource *r = &This->resources[i];
+        if (r->is_string != is_string) continue;
+        if (is_string ? (r->sid && sid && !wcscmp(r->sid, sid)) : r->id == id) return r;
+    }
+    return NULL;
+}
+
+static HRESULT holder_add(holder *This, BOOL is_string, RESID id, const WCHAR *sid, BOOL in_use)
+{
+    struct tracked_resource *n;
+
+    if (!(n = realloc(This->resources, (This->count + 1) * sizeof(*n)))) return E_OUTOFMEMORY;
+    This->resources = n;
+    n += This->count;
+    n->is_string = is_string;
+    n->in_use = in_use;
+    n->id = id;
+    n->sid = NULL;
+    if (is_string && !(n->sid = wcsdup(sid))) return E_OUTOFMEMORY;
+    This->count++;
+    return S_OK;
+}
+
+static void holder_remove(holder *This, struct tracked_resource *r)
+{
+    free(r->sid);
+    *r = This->resources[--This->count];
+}
+
 static HRESULT WINAPI holder_AllocResource(IHolder *iface, const RESTYPID typeid, RESID *resid)
 {
     holder *This = impl_from_IHolder(iface);
+    RESOURCERATING best_rating = 0, rating;
+    struct tracked_resource *best = NULL;
     HRESULT hr;
     TIMEINSECS secs;
+    unsigned int i;
+
+    TRACE("(%p)->(%08Ix, %p)\n", This, typeid, resid);
 
-    TRACE("(%p)->(%08Ix, %p) stub\n", This, typeid, resid);
+    if (!resid) return E_INVALIDARG;
+    if (!This->driver) return E_UNEXPECTED;
 
-    hr = IDispenserDriver_CreateResource(This->driver, typeid, resid, &secs);
+    IDispenserDriver_AddRef(This->driver);
+    EnterCriticalSection(&This->cs);
+
+    /* pooled resources first: ask the driver how well each one fits */
+    for (i = 0; i < This->count; i++)
+    {
+        struct tracked_resource *r = &This->resources[i];
+
+        if (r->in_use || r->is_string) continue;
+        rating = 0;
+        if (SUCCEEDED(IDispenserDriver_RateResource(This->driver, typeid, r->id, FALSE, &rating)) &&
+                rating > best_rating)
+        {
+            best_rating = rating;
+            best = r;
+        }
+    }
+
+    if (best)
+    {
+        best->in_use = TRUE;
+        *resid = best->id;
+        hr = S_OK;
+    }
+    else
+    {
+        hr = IDispenserDriver_CreateResource(This->driver, typeid, resid, &secs);
+        if (SUCCEEDED(hr) && FAILED(holder_add(This, FALSE, *resid, NULL, TRUE)))
+        {
+            IDispenserDriver_DestroyResource(This->driver, *resid);
+            hr = E_OUTOFMEMORY;
+        }
+    }
+
+    LeaveCriticalSection(&This->cs);
+    IDispenserDriver_Release(This->driver);
 
     TRACE("<- 0x%08lx\n", hr);
     return hr;
@@ -131,71 +225,153 @@ static HRESULT WINAPI holder_AllocResource(IHolder *iface, const RESTYPID typeid
 static HRESULT WINAPI holder_FreeResource(IHolder *iface, const RESID resid)
 {
     holder *This = impl_from_IHolder(iface);
-    HRESULT hr;
+    struct tracked_resource *r;
+    HRESULT hr = S_OK;
 
-    TRACE("(%p)->(%08Ix) stub\n", This, resid);
+    TRACE("(%p)->(%08Ix)\n", This, resid);
 
-    hr = IDispenserDriver_DestroyResource(This->driver, resid);
+    if (!This->driver) return E_UNEXPECTED;
 
-    TRACE("<- 0x%08lx\n", hr);
+    EnterCriticalSection(&This->cs);
+    if (!(r = holder_find(This, FALSE, resid, NULL)))
+    {
+        LeaveCriticalSection(&This->cs);
+        return E_INVALIDARG;
+    }
+
+    /* the resource goes back to the pool once the driver has reset it */
+    if (SUCCEEDED(hr = IDispenserDriver_ResetResource(This->driver, resid)))
+        r->in_use = FALSE;
+    else
+    {
+        IDispenserDriver_DestroyResource(This->driver, resid);
+        holder_remove(This, r);
+    }
+    LeaveCriticalSection(&This->cs);
 
+    TRACE("<- 0x%08lx\n", hr);
     return hr;
 }
 
 static HRESULT WINAPI holder_TrackResource(IHolder *iface, const RESID resid)
 {
     holder *This = impl_from_IHolder(iface);
+    HRESULT hr = S_OK;
 
-    FIXME("(%p)->(%08Ix) stub\n", This, resid);
+    TRACE("(%p)->(%08Ix)\n", This, resid);
 
-    return E_NOTIMPL;
+    EnterCriticalSection(&This->cs);
+    if (!holder_find(This, FALSE, resid, NULL))
