+    LeaveCriticalSection(&This->cs);
+    return hr;
 }
 
 static HRESULT WINAPI holder_TrackResourceS(IHolder *iface, const SRESID resid)
 {
     holder *This = impl_from_IHolder(iface);
+    HRESULT hr = S_OK;
 
-    FIXME("(%p)->(%s) stub\n", This, debugstr_w(resid));
+    TRACE("(%p)->(%s)\n", This, debugstr_w(resid));
 
-    return E_NOTIMPL;
+    if (!resid) return E_INVALIDARG;
+    EnterCriticalSection(&This->cs);
+    if (!holder_find(This, TRUE, 0, resid))
+        hr = holder_add(This, TRUE, 0, resid, TRUE);
+    LeaveCriticalSection(&This->cs);
+    return hr;
 }
 
 static HRESULT WINAPI holder_UntrackResource(IHolder *iface, const RESID resid, const BOOL value)
 {
     holder *This = impl_from_IHolder(iface);
+    struct tracked_resource *r;
 
-    FIXME("(%p)->(%08Ix, %d) stub\n", This, resid, value);
+    TRACE("(%p)->(%08Ix, %d)\n", This, resid, value);
 
-    return E_NOTIMPL;
+    EnterCriticalSection(&This->cs);
+    if ((r = holder_find(This, FALSE, resid, NULL)))
+    {
+        holder_remove(This, r);
+        /* value: the resource has to be destroyed as well */
+        if (value && This->driver)
+            IDispenserDriver_DestroyResource(This->driver, resid);
+    }
+    LeaveCriticalSection(&This->cs);
+    return S_OK;
 }
 
 static HRESULT WINAPI holder_UntrackResourceS(IHolder *iface, const SRESID resid, const BOOL value)
 {
     holder *This = impl_from_IHolder(iface);
+    struct tracked_resource *r;
 
-    FIXME("(%p)->(%s, %d) stub\n", This, debugstr_w(resid), value);
+    TRACE("(%p)->(%s, %d)\n", This, debugstr_w(resid), value);
 
-    return E_NOTIMPL;
+    if (!resid) return E_INVALIDARG;
+    EnterCriticalSection(&This->cs);
+    if ((r = holder_find(This, TRUE, 0, resid)))
+    {
+        holder_remove(This, r);
+        if (value && This->driver)
+            IDispenserDriver_DestroyResourceS(This->driver, resid);
+    }
+    LeaveCriticalSection(&This->cs);
+    return S_OK;
 }
 
 static HRESULT WINAPI holder_Close(IHolder *iface)
 {
     holder *This = impl_from_IHolder(iface);
+    IDispenserDriver *driver;
+    unsigned int i;
 
-    FIXME("(%p) stub\n", This);
+    TRACE("(%p)\n", This);
 
-    IDispenserDriver_Release(This->driver);
+    EnterCriticalSection(&This->cs);
+    driver = This->driver;
+    This->driver = NULL;
+    if (driver)
+    {
+        /* every resource still known is destroyed; the results do not matter */
+        for (i = 0; i < This->count; i++)
+        {
+            struct tracked_resource *r = &This->resources[i];
 
+            if (r->is_string) IDispenserDriver_DestroyResourceS(driver, r->sid);
+            else IDispenserDriver_DestroyResource(driver, r->id);
+        }
+    }
+    for (i = 0; i < This->count; i++) free(This->resources[i].sid);
+    free(This->resources);
+    This->resources = NULL;
+    This->count = 0;
+    LeaveCriticalSection(&This->cs);
+
+    if (driver) IDispenserDriver_Release(driver);
     return S_OK;
 }
 
 static HRESULT WINAPI holder_RequestDestroyResource(IHolder *iface, const RESID resid)
 {
     holder *This = impl_from_IHolder(iface);
+    struct tracked_resource *r;
+    HRESULT hr = S_OK;
 
-    FIXME("(%p)->(%08Ix) stub\n", This, resid);
+    TRACE("(%p)->(%08Ix)\n", This, resid);
 
-    return E_NOTIMPL;
+    EnterCriticalSection(&This->cs);
+    if (!This->driver)
+        hr = E_UNEXPECTED;
+    else if ((r = holder_find(This, FALSE, resid, NULL)))
+    {
+        hr = IDispenserDriver_DestroyResource(This->driver, resid);
+        holder_remove(This, r);
+    }
+    else
+        hr = E_INVALIDARG;
+    LeaveCriticalSection(&This->cs);
+    return hr;
 }
 
