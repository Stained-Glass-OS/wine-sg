+    if (FAILED(hr = get_typeinfo(iid, &ti, slot))) return hr;
+    hr = ITypeInfo_Invoke(ti, obj, member, flags, params, result, except, argerr);
+    ITypeInfo_Release(ti);
+    return hr;
+}
