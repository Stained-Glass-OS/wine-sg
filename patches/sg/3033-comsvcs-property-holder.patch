+static HRESULT group_get_property_at(struct property_group *group, int index, BOOL create,
+        VARIANT_BOOL *exists, ISharedProperty **out)
+{
+    struct shared_property *property = NULL;
+
+    if (index < 0) return E_INVALIDARG;
+
+    EnterCriticalSection(&property_cs);
+    if ((ULONG)index < group->count) property = group->properties[index];
+
+    if (property)
+    {
+        if (exists) *exists = VARIANT_TRUE;
+    }
+    else if (create)
+    {
+        if ((ULONG)index >= group->count)
+        {
+            struct shared_property **n = realloc(group->properties, (index + 1) * sizeof(*n));
+            if (!n)
+            {
+                LeaveCriticalSection(&property_cs);
+                return E_OUTOFMEMORY;
+            }
+            memset(n + group->count, 0, (index + 1 - group->count) * sizeof(*n));
+            group->properties = n;
+            group->count = index + 1;
+        }
+        if (!(property = shared_property_create(NULL)))
+        {
+            LeaveCriticalSection(&property_cs);
+            return E_OUTOFMEMORY;
+        }
+        group->properties[index] = property;
+        if (exists) *exists = VARIANT_FALSE;
+    }
+    else
+    {
+        LeaveCriticalSection(&property_cs);
+        *out = NULL;
+        return E_INVALIDARG;
+    }
+    ISharedProperty_AddRef(&property->ISharedProperty_iface);
+    LeaveCriticalSection(&property_cs);
+
+    *out = &property->ISharedProperty_iface;
+    return S_OK;
+}
+
