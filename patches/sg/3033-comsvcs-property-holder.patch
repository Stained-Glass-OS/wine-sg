 static HRESULT WINAPI new_moniker_IsEqual(IMoniker *iface, IMoniker *other_moniker)
 {
-    FIXME("%p, %p.\n", iface, other_moniker);
-
-    return E_NOTIMPL;
+    struct new_moniker *moniker = impl_from_IMoniker(iface);
+    HRESULT hr;
+    CLSID clsid;
+    IROTData *rot = NULL;
+    BYTE data[512], mine[512];
+    ULONG len = 0, mylen = 0;
+
+    TRACE("%p, %p.\n", iface, other_moniker);
+
+    if (!other_moniker) return E_INVALIDARG;
+
+    /* the other moniker has to be a "new" moniker with the same comparison data */
+    if (FAILED(IMoniker_GetClassID(other_moniker, &clsid))) return S_FALSE;
+    if (!IsEqualGUID(&clsid, &CLSID_NewMoniker)) return S_FALSE;
+    if (FAILED(IMoniker_QueryInterface(other_moniker, &IID_IROTData, (void **)&rot))) return S_FALSE;
+    hr = IROTData_GetComparisonData(rot, data, sizeof(data), &len);
+    IROTData_Release(rot);
+    if (FAILED(hr)) return S_FALSE;
+    if (FAILED(IROTData_GetComparisonData(&moniker->IROTData_iface, mine, sizeof(mine), &mylen)))
+        return S_FALSE;
+    return len == mylen && !memcmp(data, mine, len) ? S_OK : S_FALSE;
 }
 
