+static HRESULT dispatch_invoke(void *obj, const GUID *iid, unsigned int slot, DISPID member, REFIID riid,
+        WORD flags, DISPPARAMS *params, VARIANT *result, EXCEPINFO *except, UINT *argerr)
+{
