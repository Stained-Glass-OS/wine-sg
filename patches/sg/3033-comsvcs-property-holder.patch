+/* enumerator over the names of the groups */
+
+struct group_enum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG refcount;
+    ULONG pos;
+};
+
+static inline struct group_enum *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, struct group_enum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI group_enum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **out)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumVARIANT))
+    {
+        *out = iface;
+        IEnumVARIANT_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI group_enum_AddRef(IEnumVARIANT *iface)
+{
+    struct group_enum *e = impl_from_IEnumVARIANT(iface);
+    return InterlockedIncrement(&e->refcount);
+}
+
+static ULONG WINAPI group_enum_Release(IEnumVARIANT *iface)
+{
+    struct group_enum *e = impl_from_IEnumVARIANT(iface);
+    ULONG refcount = InterlockedDecrement(&e->refcount);
+
+    if (!refcount) free(e);
+    return refcount;
+}
+
+static HRESULT WINAPI group_enum_Next(IEnumVARIANT *iface, ULONG count, VARIANT *vars, ULONG *fetched)
+{
+    struct group_enum *e = impl_from_IEnumVARIANT(iface);
+    ULONG n = 0;
+
+    if (!vars) return E_POINTER;
+    if (!fetched && count != 1) return E_INVALIDARG;
+
+    EnterCriticalSection(&property_cs);
+    while (n < count && e->pos < groups_count)
+    {
+        VariantInit(&vars[n]);
+        V_VT(&vars[n]) = VT_BSTR;
+        V_BSTR(&vars[n]) = SysAllocString(groups[e->pos]->name);
+        if (!V_BSTR(&vars[n]))
+        {
+            while (n--) VariantClear(&vars[n]);
+            LeaveCriticalSection(&property_cs);
+            return E_OUTOFMEMORY;
+        }
+        e->pos++;
+        n++;
+    }
+    LeaveCriticalSection(&property_cs);
+
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI group_enum_Skip(IEnumVARIANT *iface, ULONG count)
+{
+    struct group_enum *e = impl_from_IEnumVARIANT(iface);
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&property_cs);
+    if (count > groups_count - e->pos)
+    {
+        e->pos = groups_count;
+        hr = S_FALSE;
+    }
+    else
+        e->pos += count;
+    LeaveCriticalSection(&property_cs);
+    return hr;
+}
+
+static HRESULT WINAPI group_enum_Reset(IEnumVARIANT *iface)
+{
+    struct group_enum *e = impl_from_IEnumVARIANT(iface);
+    e->pos = 0;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl group_enum_vtbl;
+
+static HRESULT WINAPI group_enum_Clone(IEnumVARIANT *iface, IEnumVARIANT **out)
+{
+    struct group_enum *e = impl_from_IEnumVARIANT(iface), *clone;
+
+    if (!out) return E_POINTER;
+    if (!(clone = calloc(1, sizeof(*clone)))) return E_OUTOFMEMORY;
+    clone->IEnumVARIANT_iface.lpVtbl = &group_enum_vtbl;
+    clone->refcount = 1;
+    clone->pos = e->pos;
+    *out = &clone->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl group_enum_vtbl =
+{
+    group_enum_QueryInterface,
+    group_enum_AddRef,
+    group_enum_Release,
+    group_enum_Next,
+    group_enum_Skip,
+    group_enum_Reset,
+    group_enum_Clone,
+};
