+
+    TRACE("iface %p, index %d, property %p.\n", iface, index, property);
+
+    if (!property) return E_POINTER;
+    return group_get_property_at(group, index, FALSE, NULL, property);
+}
+
+static HRESULT group_find_named(struct property_group *group, const WCHAR *name, BOOL create,
+        VARIANT_BOOL *exists, ISharedProperty **out)
+{
+    struct shared_property *property = NULL;
+    ULONG i;
+
+    EnterCriticalSection(&property_cs);
+    for (i = 0; i < group->count; i++)
+    {
+        if (group->properties[i] && group->properties[i]->name && !wcscmp(group->properties[i]->name, name))
+        {
+            property = group->properties[i];
+            break;
+        }
+    }
+
+    if (property)
+    {
+        if (exists) *exists = VARIANT_TRUE;
+    }
+    else if (create)
+    {
+        struct shared_property **n;
+
+        /* named properties take the first free position */
+        for (i = 0; i < group->count; i++)
+            if (!group->properties[i]) break;
+        if (i == group->count)
+        {
+            if (!(n = realloc(group->properties, (group->count + 1) * sizeof(*n))))
+            {
+                LeaveCriticalSection(&property_cs);
+                return E_OUTOFMEMORY;
+            }
+            group->properties = n;
+            group->properties[group->count++] = NULL;
+        }
+        if (!(property = shared_property_create(name)))
+        {
+            LeaveCriticalSection(&property_cs);
+            return E_OUTOFMEMORY;
+        }
+        group->properties[i] = property;
+        if (exists) *exists = VARIANT_FALSE;
+    }
+    else
+    {
+        LeaveCriticalSection(&property_cs);
+        *out = NULL;
+        return E_INVALIDARG;
+    }
+    ISharedProperty_AddRef(&property->ISharedProperty_iface);
+    LeaveCriticalSection(&property_cs);
+
+    *out = &property->ISharedProperty_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI property_group_CreateProperty(ISharedPropertyGroup *iface, BSTR name,
+        VARIANT_BOOL *exists, ISharedProperty **property)
+{
+    struct property_group *group = impl_from_ISharedPropertyGroup(iface);
+
+    TRACE("iface %p, name %s, exists %p, property %p.\n", iface, debugstr_w(name), exists, property);
+
+    if (!property) return E_POINTER;
+    if (!name) return E_INVALIDARG;
+    return group_find_named(group, name, TRUE, exists, property);
+}
+
+static HRESULT WINAPI property_group_get_Property(ISharedPropertyGroup *iface, BSTR name,
+        ISharedProperty **property)
+{
+    struct property_group *group = impl_from_ISharedPropertyGroup(iface);
+
+    TRACE("iface %p, name %s, property %p.\n", iface, debugstr_w(name), property);
+
+    if (!property) return E_POINTER;
+    if (!name) return E_INVALIDARG;
+    return group_find_named(group, name, FALSE, NULL, property);
+}
