+static HRESULT dispatch_get_ids(const GUID *iid, unsigned int slot, REFIID riid, LPOLESTR *names, UINT count,
+        DISPID *dispid)
+{
+    ITypeInfo *ti;
+    HRESULT hr;
+
+    if (!IsEqualGUID(riid, &IID_NULL)) return DISP_E_UNKNOWNINTERFACE;
+    if (FAILED(hr = get_typeinfo(iid, &ti, slot))) return hr;
+    hr = ITypeInfo_GetIDsOfNames(ti, names, count, dispid);
+    ITypeInfo_Release(ti);
+    return hr;
+}
