+/***********************************************************************
+ *      GetObjectContext (COMSVCS.@)
+ */
+HRESULT WINAPI GetObjectContext(IUnknown **context)
+{
+    TRACE("%p.\n", context);
+
+    if (!context) return E_INVALIDARG;
+    *context = NULL;
+
+    /* no COM+ context exists for the calling thread */
+    return CONTEXT_E_NOCONTEXT;
+}
+
+/***********************************************************************
+ *      CosGetCallContext (COMSVCS.5)
+ */
+HRESULT WINAPI CosGetCallContext(REFIID riid, void **obj)
+{
+    TRACE("%s, %p.\n", debugstr_guid(riid), obj);
+
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+    return CONTEXT_E_NOCONTEXT;
+}
diff --git a/dlls/comsvcs/property.c b/dlls/comsvcs/property.c
