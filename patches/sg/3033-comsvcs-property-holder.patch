+    { &property_cs_debug.ProcessLocksList, &property_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": property_cs") }
+};
+static CRITICAL_SECTION property_cs = { &property_cs_debug, -1, 0, 0, 0, 0 };
+
+struct shared_property
+{
+    ISharedProperty ISharedProperty_iface;
+    LONG refcount;
+    WCHAR *name;
+    VARIANT value;
+};
+
+struct property_group
+{
+    ISharedPropertyGroup ISharedPropertyGroup_iface;
+    LONG refcount;
+    WCHAR *name;
+    LONG isolation, release;
+    struct shared_property **properties;
+    ULONG count;
+};
+
+/* all the groups live as long as the process */
+static struct property_group **groups;
+static ULONG groups_count;
+
+static ITypeInfo *typeinfo[3];
+
+static HRESULT get_typeinfo(const GUID *iid, ITypeInfo **ti, unsigned int slot)
+{
+    ITypeLib *lib;
+    ITypeInfo *info;
+    WCHAR path[MAX_PATH];
+    HMODULE module;
+    HRESULT hr;
+
+    if (!typeinfo[slot])
+    {
+        if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                (const WCHAR *)get_typeinfo, &module) ||
+            !GetModuleFileNameW(module, path, ARRAY_SIZE(path)))
+            return HRESULT_FROM_WIN32(GetLastError());
+        if (FAILED(hr = LoadTypeLibEx(path, REGKIND_NONE, &lib))) return hr;
+        hr = ITypeLib_GetTypeInfoOfGuid(lib, iid, &info);
+        ITypeLib_Release(lib);
+        if (FAILED(hr)) return hr;
+        if (InterlockedCompareExchangePointer((void **)&typeinfo[slot], info, NULL))
+            ITypeInfo_Release(info);
+    }
+    *ti = typeinfo[slot];
+    ITypeInfo_AddRef(*ti);
+    return S_OK;
+}
