+static struct shared_property *shared_property_create(const WCHAR *name)
+{
+    struct shared_property *property;
+
+    if (!(property = calloc(1, sizeof(*property)))) return NULL;
+    property->ISharedProperty_iface.lpVtbl = &shared_property_vtbl;
+    property->refcount = 1; /* owned by the group */
+    if (name && !(property->name = wcsdup(name)))
+    {
+        free(property);
+        return NULL;
+    }
+    V_VT(&property->value) = VT_I4;
+    V_I4(&property->value) = 0;
+    return property;
+}
