 }
 
@@ -411,7 +412,7 @@ IXMLDOMNodeList* create_children_nodelist( xmlNodePtr node )
 {
     xmlnodelist *This;
 
-    This = malloc(sizeof(*This));
+    This = calloc(1, sizeof(*This));
     if ( !This )
         return NULL;
 
@@ -426,3 +427,15 @@ IXMLDOMNodeList* create_children_nodelist( xmlNodePtr node )
 
     return &This->IXMLDOMNodeList_iface;
 }
+
+IXMLDOMNodeList* create_empty_nodelist( xmlNodePtr node )
+{
+    IXMLDOMNodeList *list = create_children_nodelist( node );
+    if (list)
+    {
+        xmlnodelist *This = CONTAINING_RECORD(list, xmlnodelist, IXMLDOMNodeList_iface);
+        This->empty = TRUE;
+        This->current = NULL;
+    }
+    return list;
+}
