     while(curr)
     {
         if(nodeIndex++ == index) break;
@@ -235,7 +236,7 @@ static HRESULT WINAPI xmlnodelist_get_length(
     if(!listLength)
         return E_INVALIDARG;
 
-    curr = This->parent->children;
+    curr = This->empty ? NULL : This->parent->children;
     while (curr)
     {
         nodeCount++;
@@ -273,7 +274,7 @@ static HRESULT WINAPI xmlnodelist_reset(
     xmlnodelist *This = impl_from_IXMLDOMNodeList( iface );
 
     TRACE("%p\n", This);
-    This->current = This->parent->children;
