From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 15:42:03 -0700
Subject: [PATCH] msxml3: definition of every node kind, document type node
 methods, empty doctype child list

IXMLDOMNode::definition answers S_FALSE with no node on all node kinds, the IXMLDOMDocumentType methods that were stubs use the shared node helpers, and its childNodes is an empty list.

diff --git a/dlls/msxml3/attribute.c b/dlls/msxml3/attribute.c
index ee65d69..df6c4fd 100644
--- a/dlls/msxml3/attribute.c
+++ b/dlls/msxml3/attribute.c
@@ -420,8 +420,14 @@ static HRESULT WINAPI domattr_get_definition(
     IXMLDOMNode** definitionNode)
 {
     domattr *This = impl_from_IXMLDOMAttribute( iface );
-    FIXME("(%p)->(%p)\n", This, definitionNode);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, definitionNode);
+
+    /* definitions come from a DTD or schema, which are not consulted: no definition is found */
+    if(!definitionNode)
+        return E_INVALIDARG;
+    *definitionNode = NULL;
+    return S_FALSE;
 }
 
 static HRESULT WINAPI domattr_get_nodeTypedValue(
