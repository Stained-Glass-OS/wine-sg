--- a/dlls/msxml3/nodelist.c
+++ b/dlls/msxml3/nodelist.c
@@ -52,6 +52,7 @@ typedef struct
     IXMLDOMNodeList IXMLDOMNodeList_iface;
     LONG ref;
     xmlNodePtr parent;
+    BOOL empty; /* a list of the children of a node whose children are not exposed */
     xmlNodePtr current;
     IEnumVARIANT *enumvariant;
 } xmlnodelist;
@@ -207,7 +208,7 @@ static HRESULT WINAPI xmlnodelist_get_item(
     if (index < 0)
