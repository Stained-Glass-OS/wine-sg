From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.storage: StorageProviderSyncRootManager

Windows.Storage.Provider.StorageProviderSyncRootManager, StorageProviderSyncRootInfo and StorageProviderItemPropertyDefinition were missing: OneDrive registers its folder as a cloud sync root through them, then connects to it with the Cloud Files API (cldapi). A sync root registered here is kept in HKCU ...\Explorer\SyncRootManager\<Id>, with the values cldapi reads for its own (Path, ProviderName, ProviderVersion, ProviderId, SyncRootIdentity from the Context, Policies as a CF_SYNC_POLICIES), so CfConnectSyncRoot accepts it; the rest of the information is kept for reading it back by id, by folder (a folder under the root too) and in GetCurrentSyncRoots. IsSupported is true. Unregister removes it.
---
diff --git a/dlls/windows.storage/Makefile.in b/dlls/windows.storage/Makefile.in
index a026c4b..e389e3e 100644
--- a/dlls/windows.storage/Makefile.in
+++ b/dlls/windows.storage/Makefile.in
@@ -11,6 +11,8 @@ SOURCES = \
 	files.idl \
 	item.c \
 	main.c \
+	provider.c \
+	provider.idl \
 	reader.c \
 	stream.c \
 	wrapstream.c \
diff --git a/dlls/windows.storage/item.c b/dlls/windows.storage/item.c
index e29c7aa..0e9fcd9 100644
--- a/dlls/windows.storage/item.c
+++ b/dlls/windows.storage/item.c
@@ -391,6 +391,18 @@ static HRESULT item_from_path( const WCHAR *path, BOOL is_folder, IUnknown **out
     return S_OK;
 }
 
+/* a StorageFolder for a path (provider.c's sync roots) */
+HRESULT storage_folder_from_path( const WCHAR *path, IStorageFolder **out )
+{
+    IUnknown *folder;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = item_from_path( path, TRUE, &folder ))) return hr;
+    *out = (IStorageFolder *)folder;
+    return S_OK;
+}
+
 /* ---- IStorageItem (the identity of the object) ---- */
 
 static HRESULT WINAPI item_QueryInterface( IStorageItem *iface, REFIID iid, void **out )
diff --git a/dlls/windows.storage/main.c b/dlls/windows.storage/main.c
index 47eb6dd..a590aa6 100644
--- a/dlls/windows.storage/main.c
+++ b/dlls/windows.storage/main.c
@@ -56,6 +56,12 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
         IActivationFactory_QueryInterface( file_io_factory, &IID_IActivationFactory, (void **)factory );
     else if (!wcscmp( buffer, RuntimeClass_Windows_Storage_PathIO ))
         IActivationFactory_QueryInterface( path_io_factory, &IID_IActivationFactory, (void **)factory );
+    else if (!wcscmp( buffer, RuntimeClass_Windows_Storage_Provider_StorageProviderSyncRootManager ))
+        IActivationFactory_QueryInterface( sync_root_manager_factory, &IID_IActivationFactory, (void **)factory );
+    else if (!wcscmp( buffer, RuntimeClass_Windows_Storage_Provider_StorageProviderSyncRootInfo ))
+        IActivationFactory_QueryInterface( sync_root_info_factory, &IID_IActivationFactory, (void **)factory );
+    else if (!wcscmp( buffer, RuntimeClass_Windows_Storage_Provider_StorageProviderItemPropertyDefinition ))
+        IActivationFactory_QueryInterface( item_property_definition_factory, &IID_IActivationFactory, (void **)factory );
     else if (!wcscmp( buffer, RuntimeClass_Windows_Storage_KnownFolders ))
         IActivationFactory_QueryInterface( known_folders_factory, &IID_IActivationFactory, (void **)factory );
 
