+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(storage);
+
+#define SYNC_ROOT_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\SyncRootManager"
+
+static HRESULT dup_hstring( HSTRING in, HSTRING *out )
+{
+    return WindowsDuplicateString( in, out );
+}
+
+/* ---- StorageProviderItemPropertyDefinition ---- */
+
+struct propdef
+{
+    IStorageProviderItemPropertyDefinition IStorageProviderItemPropertyDefinition_iface;
+    LONG ref;
+    INT32 id;
+    HSTRING name;
+};
+
+static struct propdef *propdef_from( IStorageProviderItemPropertyDefinition *iface )
+{
+    return CONTAINING_RECORD( iface, struct propdef, IStorageProviderItemPropertyDefinition_iface );
+}
+
+static HRESULT WINAPI propdef_QueryInterface( IStorageProviderItemPropertyDefinition *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IStorageProviderItemPropertyDefinition ))
+    {
+        *out = iface;
+        IInspectable_AddRef( (IInspectable *)iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI propdef_AddRef( IStorageProviderItemPropertyDefinition *iface )
+{
+    return InterlockedIncrement( &propdef_from( iface )->ref );
+}
+
+static ULONG WINAPI propdef_Release( IStorageProviderItemPropertyDefinition *iface )
+{
+    struct propdef *impl = propdef_from( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->name );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI propdef_GetIids( IStorageProviderItemPropertyDefinition *iface, ULONG *count, IID **iids )
+{
+    *count = 0;
+    *iids = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI propdef_GetRuntimeClassName( IStorageProviderItemPropertyDefinition *iface, HSTRING *name )
+{
+    static const WCHAR str[] = L"Windows.Storage.Provider.StorageProviderItemPropertyDefinition";
+    return WindowsCreateString( str, wcslen( str ), name );
+}
+
+static HRESULT WINAPI propdef_GetTrustLevel( IStorageProviderItemPropertyDefinition *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI propdef_get_Id( IStorageProviderItemPropertyDefinition *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = propdef_from( iface )->id;
+    return S_OK;
+}
+
+static HRESULT WINAPI propdef_put_Id( IStorageProviderItemPropertyDefinition *iface, INT32 value )
+{
+    propdef_from( iface )->id = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI propdef_get_DisplayNameResource( IStorageProviderItemPropertyDefinition *iface, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    return dup_hstring( propdef_from( iface )->name, value );
+}
+
+static HRESULT WINAPI propdef_put_DisplayNameResource( IStorageProviderItemPropertyDefinition *iface, HSTRING value )
+{
+    struct propdef *impl = propdef_from( iface );
+    HSTRING copy;
+    HRESULT hr;
+
+    if (FAILED(hr = dup_hstring( value, &copy ))) return hr;
+    WindowsDeleteString( impl->name );
+    impl->name = copy;
+    return S_OK;
+}
+
+static const IStorageProviderItemPropertyDefinitionVtbl propdef_vtbl =
+{
+    propdef_QueryInterface, propdef_AddRef, propdef_Release, propdef_GetIids, propdef_GetRuntimeClassName,
+    propdef_GetTrustLevel, propdef_get_Id, propdef_put_Id, propdef_get_DisplayNameResource,
+    propdef_put_DisplayNameResource,
+};
+
+static HRESULT propdef_create( INT32 id, const WCHAR *name, IStorageProviderItemPropertyDefinition **out )
+{
+    struct propdef *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IStorageProviderItemPropertyDefinition_iface.lpVtbl = &propdef_vtbl;
+    impl->ref = 1;
+    impl->id = id;
+    if (name) WindowsCreateString( name, wcslen( name ), &impl->name );
+    *out = &impl->IStorageProviderItemPropertyDefinition_iface;
+    return S_OK;
+}
+
+/* ---- IVector<StorageProviderItemPropertyDefinition> ---- */
+
+static const struct vector_ids vector_ids_propdef =
+{
+    &IID_IVectorView_StorageProviderItemPropertyDefinition, &IID_IIterable_StorageProviderItemPropertyDefinition,
+    &IID_IIterator_StorageProviderItemPropertyDefinition,
+    L"Windows.Foundation.Collections.IVectorView`1<Windows.Storage.Provider.StorageProviderItemPropertyDefinition>",
+    L"Windows.Foundation.Collections.IIterator`1<Windows.Storage.Provider.StorageProviderItemPropertyDefinition>",
+};
+
+struct defs
+{
+    IVector_StorageProviderItemPropertyDefinition IVector_iface;
+    IIterable_StorageProviderItemPropertyDefinition IIterable_iface;
+    LONG ref;
+    IStorageProviderItemPropertyDefinition **items;
+    UINT32 count, size;
+};
+
+static struct defs *defs_from( IVector_StorageProviderItemPropertyDefinition *iface )
+{
+    return CONTAINING_RECORD( iface, struct defs, IVector_iface );
+}
+
+static struct defs *defs_from_iterable( IIterable_StorageProviderItemPropertyDefinition *iface )
+{
+    return CONTAINING_RECORD( iface, struct defs, IIterable_iface );
+}
+
+static HRESULT WINAPI defs_QueryInterface( IVector_StorageProviderItemPropertyDefinition *iface, REFIID iid, void **out )
+{
+    struct defs *impl = defs_from( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IVector_StorageProviderItemPropertyDefinition ))
+        *out = &impl->IVector_iface;
+    else if (IsEqualGUID( iid, &IID_IIterable_StorageProviderItemPropertyDefinition ))
+        *out = &impl->IIterable_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI defs_AddRef( IVector_StorageProviderItemPropertyDefinition *iface )
+{
+    return InterlockedIncrement( &defs_from( iface )->ref );
+}
+
+static void defs_clear( struct defs *impl )
+{
+    while (impl->count) IStorageProviderItemPropertyDefinition_Release( impl->items[--impl->count] );
+}
+
+static ULONG WINAPI defs_Release( IVector_StorageProviderItemPropertyDefinition *iface )
+{
+    struct defs *impl = defs_from( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        defs_clear( impl );
+        free( impl->items );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI defs_GetIids( IVector_StorageProviderItemPropertyDefinition *iface, ULONG *count, IID **iids )
+{
+    *count = 0;
+    *iids = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI defs_GetRuntimeClassName( IVector_StorageProviderItemPropertyDefinition *iface, HSTRING *name )
+{
+    static const WCHAR str[] = L"Windows.Foundation.Collections.IVector`1<Windows.Storage.Provider.StorageProviderItemPropertyDefinition>";
+    return WindowsCreateString( str, wcslen( str ), name );
+}
+
+static HRESULT WINAPI defs_GetTrustLevel( IVector_StorageProviderItemPropertyDefinition *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI defs_GetAt( IVector_StorageProviderItemPropertyDefinition *iface, UINT32 index,
+                                  IStorageProviderItemPropertyDefinition **value )
+{
+    struct defs *impl = defs_from( iface );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (index >= impl->count) return E_BOUNDS;
+    *value = impl->items[index];
+    IStorageProviderItemPropertyDefinition_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI defs_get_Size( IVector_StorageProviderItemPropertyDefinition *iface, UINT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = defs_from( iface )->count;
+    return S_OK;
+}
+
+/* a snapshot of the items, each with a reference */
+static IUnknown **defs_snapshot( struct defs *impl )
+{
+    IUnknown **items = calloc( max( impl->count, 1 ), sizeof(*items) );
+    UINT32 i;
+
+    if (!items) return NULL;
+    for (i = 0; i < impl->count; i++)
+    {
+        items[i] = (IUnknown *)impl->items[i];
+        IUnknown_AddRef( items[i] );
+    }
+    return items;
+}
+
+static HRESULT WINAPI defs_GetView( IVector_StorageProviderItemPropertyDefinition *iface,
+                                    IVectorView_StorageProviderItemPropertyDefinition **value )
+{
+    struct defs *impl = defs_from( iface );
+    IUnknown **items;
+
+    if (!value) return E_POINTER;
+    if (!(items = defs_snapshot( impl ))) return E_OUTOFMEMORY;
+    return vector_view_create( &vector_ids_propdef, items, impl->count, (void **)value );
+}
+
+static HRESULT WINAPI defs_IndexOf( IVector_StorageProviderItemPropertyDefinition *iface,
+                                    IStorageProviderItemPropertyDefinition *element, UINT32 *index, boolean *found )
+{
+    struct defs *impl = defs_from( iface );
+    UINT32 i;
+
+    *found = FALSE;
+    *index = 0;
+    for (i = 0; i < impl->count; i++)
+        if (impl->items[i] == element)
+        {
+            *found = TRUE;
+            *index = i;
+            break;
+        }
+    return S_OK;
+}
+
+static HRESULT grow( struct defs *impl )
+{
+    IStorageProviderItemPropertyDefinition **items;
+    UINT32 size;
+
+    if (impl->count < impl->size) return S_OK;
+    size = max( 8, impl->size * 2 );
+    if (!(items = realloc( impl->items, size * sizeof(*items) ))) return E_OUTOFMEMORY;
+    impl->items = items;
+    impl->size = size;
+    return S_OK;
+}
+
+static HRESULT WINAPI defs_SetAt( IVector_StorageProviderItemPropertyDefinition *iface, UINT32 index,
+                                  IStorageProviderItemPropertyDefinition *value )
+{
+    struct defs *impl = defs_from( iface );
+
+    if (index >= impl->count) return E_BOUNDS;
+    if (value) IStorageProviderItemPropertyDefinition_AddRef( value );
+    if (impl->items[index]) IStorageProviderItemPropertyDefinition_Release( impl->items[index] );
+    impl->items[index] = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI defs_InsertAt( IVector_StorageProviderItemPropertyDefinition *iface, UINT32 index,
+                                     IStorageProviderItemPropertyDefinition *value )
+{
+    struct defs *impl = defs_from( iface );
+    HRESULT hr;
+
+    if (index > impl->count) return E_BOUNDS;
+    if (FAILED(hr = grow( impl ))) return hr;
+    memmove( impl->items + index + 1, impl->items + index, (impl->count - index) * sizeof(*impl->items) );
+    if (value) IStorageProviderItemPropertyDefinition_AddRef( value );
+    impl->items[index] = value;
+    impl->count++;
+    return S_OK;
+}
+
+static HRESULT WINAPI defs_RemoveAt( IVector_StorageProviderItemPropertyDefinition *iface, UINT32 index )
+{
+    struct defs *impl = defs_from( iface );
+
+    if (index >= impl->count) return E_BOUNDS;
+    if (impl->items[index]) IStorageProviderItemPropertyDefinition_Release( impl->items[index] );
+    memmove( impl->items + index, impl->items + index + 1, (impl->count - index - 1) * sizeof(*impl->items) );
+    impl->count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI defs_Append( IVector_StorageProviderItemPropertyDefinition *iface,
+                                   IStorageProviderItemPropertyDefinition *value )
+{
+    return defs_InsertAt( iface, defs_from( iface )->count, value );
+}
+
+static HRESULT WINAPI defs_RemoveAtEnd( IVector_StorageProviderItemPropertyDefinition *iface )
+{
+    struct defs *impl = defs_from( iface );
+
+    if (!impl->count) return E_BOUNDS;
+    return defs_RemoveAt( iface, impl->count - 1 );
+}
+
+static HRESULT WINAPI defs_Clear( IVector_StorageProviderItemPropertyDefinition *iface )
+{
+    defs_clear( defs_from( iface ) );
+    return S_OK;
+}
+
+static HRESULT WINAPI defs_GetMany( IVector_StorageProviderItemPropertyDefinition *iface, UINT32 start, UINT32 size,
+                                    IStorageProviderItemPropertyDefinition **items, UINT *actual )
+{
+    struct defs *impl = defs_from( iface );
+    UINT32 i;
+
+    *actual = 0;
+    if (start > impl->count) return E_BOUNDS;
+    for (i = 0; i < size && start + i < impl->count; i++)
+    {
+        items[i] = impl->items[start + i];
+        IStorageProviderItemPropertyDefinition_AddRef( items[i] );
+    }
+    *actual = i;
+    return S_OK;
+}
+
+static HRESULT WINAPI defs_ReplaceAll( IVector_StorageProviderItemPropertyDefinition *iface, UINT32 count,
+                                       IStorageProviderItemPropertyDefinition **items )
+{
+    struct defs *impl = defs_from( iface );
+    UINT32 i;
+    HRESULT hr;
+
+    defs_clear( impl );
+    for (i = 0; i < count; i++)
+        if (FAILED(hr = defs_Append( iface, items[i] ))) return hr;
+    return S_OK;
+}
+
+static const IVector_StorageProviderItemPropertyDefinitionVtbl defs_vtbl =
+{
+    defs_QueryInterface, defs_AddRef, defs_Release, defs_GetIids, defs_GetRuntimeClassName, defs_GetTrustLevel,
+    defs_GetAt, defs_get_Size, defs_GetView, defs_IndexOf, defs_SetAt, defs_InsertAt, defs_RemoveAt, defs_Append,
+    defs_RemoveAtEnd, defs_Clear, defs_GetMany, defs_ReplaceAll,
+};
+
+DEFINE_IINSPECTABLE_( defs_iterable, IIterable_StorageProviderItemPropertyDefinition, struct defs,
+                      impl_from_defs_iterable, IIterable_iface, &impl->IVector_iface )
+
+static HRESULT WINAPI defs_iterable_First( IIterable_StorageProviderItemPropertyDefinition *iface,
+                                           IIterator_StorageProviderItemPropertyDefinition **value )
+{
+    struct defs *impl = defs_from_iterable( iface );
+    IIterable_StorageProviderItemPropertyDefinition *iterable;
+    IVectorView_StorageProviderItemPropertyDefinition *view;
+    HRESULT hr;
+
+    /* over a snapshot: what the vector holds now */
+    if (FAILED(hr = defs_GetView( &impl->IVector_iface, &view ))) return hr;
+    hr = IVectorView_StorageProviderItemPropertyDefinition_QueryInterface( view, &IID_IIterable_StorageProviderItemPropertyDefinition,
+                                                                            (void **)&iterable );
+    IVectorView_StorageProviderItemPropertyDefinition_Release( view );
+    if (FAILED(hr)) return hr;
+    hr = IIterable_StorageProviderItemPropertyDefinition_First( iterable, value );
+    IIterable_StorageProviderItemPropertyDefinition_Release( iterable );
+    return hr;
+}
+
+static const IIterable_StorageProviderItemPropertyDefinitionVtbl defs_iterable_vtbl =
+{
+    defs_iterable_QueryInterface, defs_iterable_AddRef, defs_iterable_Release, defs_iterable_GetIids,
+    defs_iterable_GetRuntimeClassName, defs_iterable_GetTrustLevel, defs_iterable_First,
+};
+
+static HRESULT defs_create( struct defs **out )
+{
+    struct defs *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IVector_iface.lpVtbl = &defs_vtbl;
+    impl->IIterable_iface.lpVtbl = &defs_iterable_vtbl;
+    impl->ref = 1;
+    *out = impl;
+    return S_OK;
+}
+
+/* ---- StorageProviderSyncRootInfo ---- */
+
+struct info
+{
+    IStorageProviderSyncRootInfo IStorageProviderSyncRootInfo_iface;
+    IStorageProviderSyncRootInfo2 IStorageProviderSyncRootInfo2_iface;
+    LONG ref;
+    HSTRING id, display_name, icon, version;
+    IBuffer *context;
+    IStorageFolder *path;
+    IUriRuntimeClass *recycle_bin;
+    StorageProviderHydrationPolicy hydration;
+    StorageProviderHydrationPolicyModifier hydration_modifier;
+    StorageProviderPopulationPolicy population;
+    StorageProviderInSyncPolicy in_sync;
+    StorageProviderHardlinkPolicy hardlink;
+    StorageProviderProtectionMode protection;
+    boolean show_siblings_as_group, allow_pinning;
+    struct defs *defs;
+    GUID provider_id;
+};
+
+static struct info *info_from( IStorageProviderSyncRootInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct info, IStorageProviderSyncRootInfo_iface );
+}
+
+static HRESULT WINAPI info_QueryInterface( IStorageProviderSyncRootInfo *iface, REFIID iid, void **out )
+{
+    struct info *impl = info_from( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IStorageProviderSyncRootInfo ))
+        *out = &impl->IStorageProviderSyncRootInfo_iface;
+    else if (IsEqualGUID( iid, &IID_IStorageProviderSyncRootInfo2 ))
+        *out = &impl->IStorageProviderSyncRootInfo2_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI info_AddRef( IStorageProviderSyncRootInfo *iface )
+{
+    return InterlockedIncrement( &info_from( iface )->ref );
+}
+
+static ULONG WINAPI info_Release( IStorageProviderSyncRootInfo *iface )
+{
+    struct info *impl = info_from( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->id );
+        WindowsDeleteString( impl->display_name );
+        WindowsDeleteString( impl->icon );
+        WindowsDeleteString( impl->version );
+        if (impl->context) IBuffer_Release( impl->context );
+        if (impl->path) IStorageFolder_Release( impl->path );
+        if (impl->recycle_bin) IUriRuntimeClass_Release( impl->recycle_bin );
+        IVector_StorageProviderItemPropertyDefinition_Release( &impl->defs->IVector_iface );
