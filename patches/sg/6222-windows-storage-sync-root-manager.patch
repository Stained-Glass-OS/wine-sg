+static HRESULT WINAPI statics_Register( IStorageProviderSyncRootManagerStatics *iface, IStorageProviderSyncRootInfo *info )
+{
+    TRACE( "iface %p, info %p.\n", iface, info );
+
+#ifdef SG_MUTANT_SYNC_ROOT_NOT_KEPT
+    return S_OK;
+#endif
+    if (!info || info->lpVtbl != &info_vtbl) return E_INVALIDARG;
+    return register_root( info_from( info ) );
+}
+
+static HRESULT WINAPI statics_Unregister( IStorageProviderSyncRootManagerStatics *iface, HSTRING id )
+{
+    WCHAR keypath[600];
+    HKEY key;
+
+    TRACE( "iface %p, id %s.\n", iface, debugstr_hstring( id ) );
+
+    if (!id || !raw( id )[0] || wcschr( raw( id ), '\\' )) return E_INVALIDARG;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, SYNC_ROOT_KEY, 0, KEY_ALL_ACCESS, &key ))
+        return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    swprintf( keypath, ARRAY_SIZE(keypath), L"%s", raw( id ) );
+    if (RegDeleteTreeW( key, keypath ))
+    {
+        RegCloseKey( key );
+        return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    }
+    RegCloseKey( key );
+    return S_OK;
+}
+
+/* every registered root, in key order */
+static HRESULT all_roots( struct info ***out, UINT32 *count )
+{
+    struct info **list = NULL, **tmp, *info;
+    UINT32 n = 0;
+    HKEY key;
+    DWORD i;
+
+    *out = NULL;
+    *count = 0;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, SYNC_ROOT_KEY, 0, KEY_READ, &key )) return S_OK;
+    for (i = 0; ; i++)
+    {
+        WCHAR name[300];
+        DWORD len = ARRAY_SIZE(name);
+
+        if (RegEnumKeyExW( key, i, name, &len, NULL, NULL, NULL, NULL )) break;
+        if (FAILED(read_root( key, name, &info ))) continue;
+        if (!(tmp = realloc( list, (n + 1) * sizeof(*list) )))
+        {
+            IStorageProviderSyncRootInfo_Release( &info->IStorageProviderSyncRootInfo_iface );
+            break;
+        }
+        list = tmp;
+        list[n++] = info;
+    }
+    RegCloseKey( key );
+    *out = list;
+    *count = n;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_GetSyncRootInformationForFolder( IStorageProviderSyncRootManagerStatics *iface,
+        IStorageFolder *folder, IStorageProviderSyncRootInfo **result )
+{
+    struct info **list, *found = NULL;
+    WCHAR *path, *root;
+    UINT32 count, i;
+    HRESULT hr;
+
+    TRACE( "iface %p, folder %p, result %p.\n", iface, folder, result );
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (FAILED(hr = folder_path( folder, &path ))) return hr;
+    all_roots( &list, &count );
+    for (i = 0; i < count; i++)
+    {
+        size_t len;
+        if (!found && SUCCEEDED(folder_path( list[i]->path, &root )))
+        {
+            len = wcslen( root );
+            /* the root or a folder under it */
+            if (!wcsnicmp( root, path, len ) && (!path[len] || path[len] == '\\' || (len && root[len - 1] == '\\')))
+            {
+                found = list[i];
+                IStorageProviderSyncRootInfo_AddRef( &found->IStorageProviderSyncRootInfo_iface );
+            }
+            free( root );
+        }
+        IStorageProviderSyncRootInfo_Release( &list[i]->IStorageProviderSyncRootInfo_iface );
+    }
+    free( list );
+    free( path );
+    if (!found) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    *result = &found->IStorageProviderSyncRootInfo_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_GetSyncRootInformationForId( IStorageProviderSyncRootManagerStatics *iface, HSTRING id,
+        IStorageProviderSyncRootInfo **result )
+{
+    struct info *info;
+    HKEY key;
+    HRESULT hr;
+
+    TRACE( "iface %p, id %s, result %p.\n", iface, debugstr_hstring( id ), result );
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!id || !raw( id )[0] || wcschr( raw( id ), '\\' )) return E_INVALIDARG;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, SYNC_ROOT_KEY, 0, KEY_READ, &key )) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    hr = read_root( key, raw( id ), &info );
+    RegCloseKey( key );
+    if (FAILED(hr)) return hr;
+    *result = &info->IStorageProviderSyncRootInfo_iface;
+    return S_OK;
+}
