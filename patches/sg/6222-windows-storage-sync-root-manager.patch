+        IVectorView_StorageProviderSyncRootInfo **result )
+{
+    struct info **list;
+    IUnknown **items;
+    UINT32 count, i;
+
+    TRACE( "iface %p, result %p.\n", iface, result );
+
+    if (!result) return E_POINTER;
+    all_roots( &list, &count );
+    if (!(items = calloc( max( count, 1 ), sizeof(*items) )))
+    {
+        for (i = 0; i < count; i++) IStorageProviderSyncRootInfo_Release( &list[i]->IStorageProviderSyncRootInfo_iface );
+        free( list );
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++) items[i] = (IUnknown *)&list[i]->IStorageProviderSyncRootInfo_iface;
