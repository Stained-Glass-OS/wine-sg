+/* ---- the registry ---- */
+
+/* cldapi.dll's CF_SYNC_POLICIES */
+struct cf_policies
+{
+    DWORD size;
+    USHORT hydration, hydration_modifier;
+    USHORT population, population_modifier;
+    DWORD in_sync, hardlink, placeholder_management;
+};
+
+static const WCHAR *raw( HSTRING str )
+{
+    return WindowsGetStringRawBuffer( str, NULL );
+}
+
+static void set_sz( HKEY key, const WCHAR *name, const WCHAR *value )
+{
+    RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)value, (wcslen( value ) + 1) * sizeof(WCHAR) );
+}
+
+static void set_dword( HKEY key, const WCHAR *name, DWORD value )
+{
+    RegSetValueExW( key, name, 0, REG_DWORD, (const BYTE *)&value, sizeof(value) );
+}
+
+/* the folder's path, without a trailing separator (but for a drive's root) */
+static HRESULT folder_path( IStorageFolder *folder, WCHAR **out )
+{
+    IStorageItem *item;
+    HSTRING path = NULL;
+    size_t len;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!folder) return E_INVALIDARG;
+    if (FAILED(hr = IStorageFolder_QueryInterface( folder, &IID_IStorageItem, (void **)&item ))) return hr;
+    hr = IStorageItem_get_Path( item, &path );
+    IStorageItem_Release( item );
+    if (FAILED(hr)) return hr;
+    if (!(*out = wcsdup( raw( path ) ))) hr = E_OUTOFMEMORY;
+    WindowsDeleteString( path );
+    if (FAILED(hr)) return hr;
+    len = wcslen( *out );
+    while (len > 3 && (*out)[len - 1] == '\\') (*out)[--len] = 0;
+    return S_OK;
+}
+
+static HRESULT register_root( struct info *info )
+{
+    struct cf_policies policies = { sizeof(policies) };
+    WCHAR keypath[600], *path, *defs = NULL;
+    size_t defs_len = 1;
+    HKEY key;
+    LONG res;
+    BYTE *bytes = NULL;
+    UINT32 length = 0, capacity, i;
+    HRESULT hr;
+
+    if (!info->id || !raw( info->id )[0] || wcschr( raw( info->id ), '\\' ) || wcslen( raw( info->id ) ) > 255)
+        return E_INVALIDARG;
+    if (FAILED(hr = folder_path( info->path, &path ))) return hr;
+    if (info->context) buffer_get_bytes( info->context, &bytes, &length, &capacity );
+
+    swprintf( keypath, ARRAY_SIZE(keypath), SYNC_ROOT_KEY L"\\%s", raw( info->id ) );
+    if ((res = RegCreateKeyExW( HKEY_CURRENT_USER, keypath, 0, NULL, 0, KEY_WRITE, NULL, &key, NULL )))
+    {
+        free( path );
+        return HRESULT_FROM_WIN32( res );
+    }
+    /* what cldapi reads */
+    set_sz( key, L"Path", path );
+    set_sz( key, L"ProviderName", info->display_name && raw( info->display_name )[0] ? raw( info->display_name ) : raw( info->id ) );
+    if (info->version) set_sz( key, L"ProviderVersion", raw( info->version ) );
+    RegSetValueExW( key, L"ProviderId", 0, REG_BINARY, (const BYTE *)&info->provider_id, sizeof(GUID) );
+    RegSetValueExW( key, L"SyncRootIdentity", 0, REG_BINARY, bytes, length );
+    RegSetValueExW( key, L"FileIdentity", 0, REG_BINARY, NULL, 0 );
+    policies.hydration = info->hydration;
+    policies.hydration_modifier = info->hydration_modifier;
+    /* the population policy's values in CF_POPULATION_POLICY_PRIMARY: Full 2, AlwaysFull 3 */
+    policies.population = info->population == StorageProviderPopulationPolicy_AlwaysFull ? 3 : 2;
+    policies.in_sync = info->in_sync;
+    policies.hardlink = info->hardlink;
+    RegSetValueExW( key, L"Policies", 0, REG_BINARY, (const BYTE *)&policies, sizeof(policies) );
+    set_dword( key, L"Flags", 0 );
+    /* the rest, as given */
+    set_sz( key, L"Id", raw( info->id ) );
+    if (info->display_name) set_sz( key, L"DisplayNameResource", raw( info->display_name ) );
+    if (info->icon) set_sz( key, L"IconResource", raw( info->icon ) );
+    set_dword( key, L"HydrationPolicy", info->hydration );
+    set_dword( key, L"HydrationPolicyModifier", info->hydration_modifier );
+    set_dword( key, L"PopulationPolicy", info->population );
+    set_dword( key, L"InSyncPolicy", info->in_sync );
+    set_dword( key, L"HardlinkPolicy", info->hardlink );
+    set_dword( key, L"ShowSiblingsAsGroup", info->show_siblings_as_group );
+    set_dword( key, L"ProtectionMode", info->protection );
+    set_dword( key, L"AllowPinning", info->allow_pinning );
+    if (info->recycle_bin)
+    {
+        HSTRING uri = NULL;
+        if (SUCCEEDED(IUriRuntimeClass_get_RawUri( info->recycle_bin, &uri )) && uri) set_sz( key, L"RecycleBinUri", raw( uri ) );
+        WindowsDeleteString( uri );
+    }
+    /* the property definitions: "id:name" strings */
+    for (i = 0; i < info->defs->count; i++)
+        defs_len += 16 + (info->defs->items[i] ? WindowsGetStringLen( propdef_from( info->defs->items[i] )->name ) : 0);
+    if ((defs = calloc( defs_len, sizeof(WCHAR) )))
+    {
+        WCHAR *p = defs;
+        for (i = 0; i < info->defs->count; i++)
+        {
+            struct propdef *def = info->defs->items[i] ? propdef_from( info->defs->items[i] ) : NULL;
+            if (!def) continue;
+            p += swprintf( p, defs + defs_len - p, L"%d:%s", def->id, def->name ? raw( def->name ) : L"" ) + 1;
+        }
+        *p++ = 0;
+        RegSetValueExW( key, L"PropertyDefinitions", 0, REG_MULTI_SZ, (const BYTE *)defs, (p - defs) * sizeof(WCHAR) );
+        free( defs );
+    }
+    RegCloseKey( key );
+    TRACE( "%s at %s\n", debugstr_hstring( info->id ), debugstr_w( path ) );
+    free( path );
+    return S_OK;
+}
+
+static DWORD get_dword( HKEY key, const WCHAR *name, DWORD def )
+{
+    DWORD value, size = sizeof(value);
+    return RegGetValueW( key, NULL, name, RRF_RT_REG_DWORD, NULL, &value, &size ) ? def : value;
+}
+
+static WCHAR *get_sz( HKEY key, const WCHAR *name )
+{
+    DWORD size = 0;
+    WCHAR *value;
+
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_SZ | RRF_RT_REG_MULTI_SZ, NULL, NULL, &size ) || !size) return NULL;
+    if (!(value = calloc( 1, size + 2 * sizeof(WCHAR) ))) return NULL;
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_SZ | RRF_RT_REG_MULTI_SZ, NULL, value, &size ))
+    {
+        free( value );
+        return NULL;
+    }
+    return value;
+}
+
+static void set_string( HSTRING *field, const WCHAR *value )
+{
+    if (value) WindowsCreateString( value, wcslen( value ), field );
+}
+
+/* a registered root (the key named by its id) as an info */
+static HRESULT read_root( HKEY parent, const WCHAR *name, struct info **out )
+{
+    struct info *info;
+    WCHAR *str;
+    DWORD size;
+    HKEY key;
+    HRESULT hr;
+
+    *out = NULL;
+    if (RegOpenKeyExW( parent, name, 0, KEY_READ, &key )) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    if (FAILED(hr = info_create( &info )))
+    {
+        RegCloseKey( key );
+        return hr;
+    }
+    str = get_sz( key, L"Id" );
+    set_string( &info->id, str ? str : name );
+    free( str );
+    if ((str = get_sz( key, L"Path" )))
+    {
+        storage_folder_from_path( str, &info->path );
+        free( str );
+    }
+    if (!(str = get_sz( key, L"DisplayNameResource" ))) str = get_sz( key, L"ProviderName" );
+    set_string( &info->display_name, str );
+    free( str );
+    str = get_sz( key, L"IconResource" );
+    set_string( &info->icon, str );
+    free( str );
+    str = get_sz( key, L"ProviderVersion" );
+    set_string( &info->version, str );
+    free( str );
+    size = sizeof(info->provider_id);
+    RegGetValueW( key, NULL, L"ProviderId", RRF_RT_REG_BINARY, NULL, &info->provider_id, &size );
+    size = 0;
+    if (!RegGetValueW( key, NULL, L"SyncRootIdentity", RRF_RT_REG_BINARY, NULL, NULL, &size ) &&
+        SUCCEEDED(buffer_create( size, &info->context )))
+    {
+        BYTE *bytes;
+        UINT32 length, capacity;
+        if (SUCCEEDED(buffer_get_bytes( info->context, &bytes, &length, &capacity )))
+        {
+            RegGetValueW( key, NULL, L"SyncRootIdentity", RRF_RT_REG_BINARY, NULL, bytes, &size );
+            IBuffer_put_Length( info->context, size );
+        }
+    }
+    info->hydration = get_dword( key, L"HydrationPolicy", 0 );
+    info->hydration_modifier = get_dword( key, L"HydrationPolicyModifier", 0 );
+    info->population = get_dword( key, L"PopulationPolicy", StorageProviderPopulationPolicy_Full );
+    info->in_sync = get_dword( key, L"InSyncPolicy", 0 );
+    info->hardlink = get_dword( key, L"HardlinkPolicy", 0 );
+    info->show_siblings_as_group = !!get_dword( key, L"ShowSiblingsAsGroup", 0 );
+    info->protection = get_dword( key, L"ProtectionMode", 0 );
+    info->allow_pinning = !!get_dword( key, L"AllowPinning", 0 );
+    if ((str = get_sz( key, L"PropertyDefinitions" )))
+    {
+        WCHAR *p, *colon;
+        for (p = str; *p; p += wcslen( p ) + 1)
+        {
+            IStorageProviderItemPropertyDefinition *def;
+            if (!(colon = wcschr( p, ':' ))) continue;
+            if (SUCCEEDED(propdef_create( wcstol( p, NULL, 10 ), colon + 1, &def )))
+            {
+                defs_Append( &info->defs->IVector_iface, def );
+                IStorageProviderItemPropertyDefinition_Release( def );
+            }
+        }
+        free( str );
+    }
+    RegCloseKey( key );
+    *out = info;
+    return S_OK;
+}
