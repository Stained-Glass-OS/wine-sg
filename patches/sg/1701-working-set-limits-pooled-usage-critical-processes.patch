+        if (limits->MinimumWorkingSetSize > limits->MaximumWorkingSetSize) return STATUS_BAD_WORKING_SET_LIMIT;
+        if (!current) break;
+#ifndef SG_MUTANT_QUOTA_NOT_KEPT
+        if (limits->MinimumWorkingSetSize || limits->MaximumWorkingSetSize)
+        {
