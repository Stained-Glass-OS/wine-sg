+        if (size != sizeof(QUOTA_LIMITS) && size != sizeof(QUOTA_LIMITS_EX)) return STATUS_INFO_LENGTH_MISMATCH;
+        if (!info) return STATUS_ACCESS_VIOLATION;
+        if (size == sizeof(QUOTA_LIMITS_EX))
+        {
+            flags = limits->Flags;
+            if (flags & ~(QUOTA_LIMITS_HARDWS_MIN_ENABLE | QUOTA_LIMITS_HARDWS_MIN_DISABLE |
+                          QUOTA_LIMITS_HARDWS_MAX_ENABLE | QUOTA_LIMITS_HARDWS_MAX_DISABLE))
+                return STATUS_INVALID_PARAMETER;
+            if ((flags & QUOTA_LIMITS_HARDWS_MIN_ENABLE) && (flags & QUOTA_LIMITS_HARDWS_MIN_DISABLE))
+                return STATUS_INVALID_PARAMETER;
+            if ((flags & QUOTA_LIMITS_HARDWS_MAX_ENABLE) && (flags & QUOTA_LIMITS_HARDWS_MAX_DISABLE))
+                return STATUS_INVALID_PARAMETER;
