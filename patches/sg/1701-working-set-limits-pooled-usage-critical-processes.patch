                                                           SIZE_T *maxset, DWORD *flags)
 {
-    FIXME( "(%p,%p,%p,%p): stub\n", process, minset, maxset, flags );
-    /* 32 MB working set size */
-    if (minset) *minset = 32*1024*1024;
-    if (maxset) *maxset = 32*1024*1024;
-    if (flags) *flags = QUOTA_LIMITS_HARDWS_MIN_DISABLE | QUOTA_LIMITS_HARDWS_MAX_DISABLE;
+    QUOTA_LIMITS_EX limits;
+
+    TRACE( "(%p,%p,%p,%p)\n", process, minset, maxset, flags );
+
+    if (!minset || !maxset || !flags)
+    {
+        SetLastError( ERROR_NOACCESS );
+        return FALSE;
+    }
+    if (!set_ntstatus( NtQueryInformationProcess( process, ProcessQuotaLimits, &limits, sizeof(limits), NULL )))
+        return FALSE;
+    *minset = limits.MinimumWorkingSetSize;
+    *maxset = limits.MaximumWorkingSetSize;
+    *flags = (limits.Flags & QUOTA_LIMITS_HARDWS_MIN_ENABLE ? QUOTA_LIMITS_HARDWS_MIN_ENABLE : QUOTA_LIMITS_HARDWS_MIN_DISABLE) |
+             (limits.Flags & QUOTA_LIMITS_HARDWS_MAX_ENABLE ? QUOTA_LIMITS_HARDWS_MAX_ENABLE : QUOTA_LIMITS_HARDWS_MAX_DISABLE);
     return TRUE;
 }
 
@@ -1796,7 +1806,15 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetProcessShutdownParameters( DWORD level, DWORD f
 BOOL WINAPI DECLSPEC_HOTPATCH SetProcessWorkingSetSizeEx( HANDLE process, SIZE_T minset,
                                                           SIZE_T maxset, DWORD flags )
 {
-    return TRUE;
+    QUOTA_LIMITS_EX limits;
+
+    TRACE( "(%p,%Iu,%Iu,%#lx)\n", process, minset, maxset, flags );
+
+    memset( &limits, 0, sizeof(limits) );
+    limits.MinimumWorkingSetSize = minset;
+    limits.MaximumWorkingSetSize = maxset;
+    limits.Flags = flags;
+    return set_ntstatus( NtSetInformationProcess( process, ProcessQuotaLimits, &limits, sizeof(limits) ));
 }
 
 
