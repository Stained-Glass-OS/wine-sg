+        BOOLEAN held = FALSE;
+        BOOL current;
+
+        if (size != sizeof(ULONG)) return STATUS_INFO_LENGTH_MISMATCH;
+        if (!info) return STATUS_ACCESS_VIOLATION;
+        if ((ret = is_current_process( handle, TRUE, &current ))) return ret;
+        privs.PrivilegeCount = 1;
+        privs.Control = PRIVILEGE_SET_ALL_NECESSARY;
+        privs.Privilege[0].Luid.LowPart = SE_DEBUG_PRIVILEGE;
+        privs.Privilege[0].Luid.HighPart = 0;
+        privs.Privilege[0].Attributes = 0;
+        if (NtOpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token )
+                && NtOpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+            return STATUS_PRIVILEGE_NOT_HELD;
+        ret = NtPrivilegeCheck( token, &privs, &held );
+        NtClose( token );
+        if (ret) return ret;
+#ifndef SG_MUTANT_NO_PRIV_CHECK
+        if (!held) return STATUS_PRIVILEGE_NOT_HELD;
+#endif
+        if (current) process_break_on_termination = !!*(const ULONG *)info;
+        break;
+    }
