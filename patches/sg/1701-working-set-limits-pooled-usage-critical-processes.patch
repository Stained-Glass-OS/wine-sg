+            process_ws_max = limits->MaximumWorkingSetSize;
+        }
+        if (flags & QUOTA_LIMITS_HARDWS_MIN_ENABLE) process_ws_flags |= QUOTA_LIMITS_HARDWS_MIN_ENABLE;
+        if (flags & QUOTA_LIMITS_HARDWS_MIN_DISABLE) process_ws_flags &= ~QUOTA_LIMITS_HARDWS_MIN_ENABLE;
+        if (flags & QUOTA_LIMITS_HARDWS_MAX_ENABLE) process_ws_flags |= QUOTA_LIMITS_HARDWS_MAX_ENABLE;
+        if (flags & QUOTA_LIMITS_HARDWS_MAX_DISABLE) process_ws_flags &= ~QUOTA_LIMITS_HARDWS_MAX_ENABLE;
+#endif
