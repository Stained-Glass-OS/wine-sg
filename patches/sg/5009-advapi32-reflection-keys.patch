From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: Report registry reflection as disabled.

RegQueryReflectionKey reports reflection disabled for any open key, and
RegEnableReflectionKey succeeds with no effect ("If the key is not on the
reflection list, this function succeeds but has no effect"). Wine keeps no
reflection list and Windows 7 and later do not reflect either. A closed or NULL
key fails with ERROR_INVALID_HANDLE. Both returned ERROR_CALL_NOT_IMPLEMENTED.

Gate: test/advapi32-reflection-gate.sh (64/32).
---
 dlls/advapi32/registry.c | 25 +++++++++++++++++++++----
 1 file changed, 21 insertions(+), 4 deletions(-)

diff --git a/dlls/advapi32/registry.c b/dlls/advapi32/registry.c
index 32dfe25..63a691b 100644
--- a/dlls/advapi32/registry.c
+++ b/dlls/advapi32/registry.c
@@ -364,11 +364,27 @@ LSTATUS WINAPI RegQueryMultipleValuesW( HKEY hkey, PVALENTW val_list, DWORD num_
 /******************************************************************************
  * RegQueryReflectionKey   [ADVAPI32.@]
  */
+/* Wine keeps no reflection list and copies nothing between the 32- and 64-bit
+ * views (Windows 7 dropped registry reflection too): a key is reported with
+ * reflection disabled, and enabling or disabling it has no effect. */
+static LONG reflection_check_key( HKEY hkey )
+{
+    if (!hkey) return ERROR_INVALID_HANDLE;
+    return RegQueryInfoKeyW( hkey, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL );
+}
+
 LONG WINAPI RegQueryReflectionKey( HKEY hkey, BOOL *is_reflection_disabled )
 {
-    FIXME( "%p, %p stub\n", hkey, is_reflection_disabled );
+    LONG ret;
+
+    TRACE( "%p, %p\n", hkey, is_reflection_disabled );
+
+    if (!is_reflection_disabled) return ERROR_INVALID_PARAMETER;
+#ifndef SG_MUTANT_REFLECTION_NO_CHECK
+    if ((ret = reflection_check_key( hkey ))) return ret;
+#endif
     *is_reflection_disabled = TRUE;
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    return ERROR_SUCCESS;
 }
 
 
@@ -732,8 +748,9 @@ LONG WINAPI RegCopyTreeA( HKEY hsrc, const char *subkey, HKEY hdst )
  */
 LONG WINAPI RegEnableReflectionKey(HKEY base)
 {
-    FIXME("%p: stub\n", base);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    TRACE("%p\n", base);
+    /* "If the key is not on the reflection list, this function succeeds but has no effect" */
+    return reflection_check_key( base );
 }
 
 
