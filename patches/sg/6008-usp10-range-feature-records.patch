From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uniscribe: OpenType range feature records (6008)

ScriptShapeOpenType and ScriptPlaceOpenType turn the features of the
range properties on or off for their characters (G-USP10).
---
diff --git a/dlls/gdi32/uniscribe/shape.c b/dlls/gdi32/uniscribe/shape.c
index ca3bc60..95364be 100644
--- a/dlls/gdi32/uniscribe/shape.c
+++ b/dlls/gdi32/uniscribe/shape.c
@@ -3433,9 +3433,97 @@ rpRangeProperties = &ShapingData[psa->eScript].defaultTextRange;
     SHAPE_ApplyOpenTypeFeatures(hdc, psc, psa, pwOutGlyphs, pcGlyphs, cMaxGlyphs, cChars, rpRangeProperties, pwLogClust);
 }
 
+/* Stained Glass OS: the features a run is shaped with when the caller gives
+ * range properties (ScriptShapeOpenType / ScriptPlaceOpenType): the script's
+ * defaults, without the ones a range turns off (lParameter 0), and the ones a
+ * range turns on that are not among them. Ranges with different features are
+ * shaped with the first range's. */
+static TEXTRANGE_PROPERTIES *merge_range_features(const TEXTRANGE_PROPERTIES *defaults,
+        TEXTRANGE_PROPERTIES **ranges, int range_count)
+{
+    const TEXTRANGE_PROPERTIES *range;
+    TEXTRANGE_PROPERTIES *merged;
+    int i, j, n = 0;
+
+    if (!ranges || range_count <= 0 || !(range = ranges[0])) return NULL;
+    for (i = 1; i < range_count; i++)
+    {
+        if (!ranges[i] || ranges[i]->cotfRecords != range->cotfRecords ||
+            memcmp(ranges[i]->potfRecords, range->potfRecords, range->cotfRecords * sizeof(*range->potfRecords)))
+        {
+            static int once;
+            if (!once++) FIXME("ranges with different features: the first range's are used\n");
+            break;
+        }
+    }
+    if (!(merged = heap_alloc(sizeof(*merged) + (defaults->cotfRecords + range->cotfRecords) * sizeof(OPENTYPE_FEATURE_RECORD))))
+        return NULL;
+    merged->potfRecords = (OPENTYPE_FEATURE_RECORD *)(merged + 1);
+    for (i = 0; i < defaults->cotfRecords; i++)
+    {
+        BOOL off = FALSE;
+        for (j = 0; j < range->cotfRecords; j++)
+            if (range->potfRecords[j].tagFeature == defaults->potfRecords[i].tagFeature && !range->potfRecords[j].lParameter)
+                off = TRUE;
+#ifdef SG_MUTANT_USP_RANGE_OFF_IGNORED
+        off = FALSE;
+#endif
+        if (!off) merged->potfRecords[n++] = defaults->potfRecords[i];
+    }
+    for (j = 0; j < range->cotfRecords; j++)
+    {
+        BOOL known = FALSE;
+        if (range->potfRecords[j].lParameter <= 0) continue;
+        for (i = 0; i < n; i++)
+            if (merged->potfRecords[i].tagFeature == range->potfRecords[j].tagFeature) known = TRUE;
+#ifdef SG_MUTANT_USP_RANGE_ON_IGNORED
+        known = TRUE;
+#endif
+        if (!known) merged->potfRecords[n++] = range->potfRecords[j];
+    }
+    merged->cotfRecords = n;
+    return merged;
+}
+
+void SHAPE_ApplyRangeOpentypeFeatures(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa, WORD *glyphs, INT *glyph_count,
+        INT max_glyphs, INT char_count, TEXTRANGE_PROPERTIES **ranges, int range_count, WORD *log_clust)
+{
+    TEXTRANGE_PROPERTIES *merged = merge_range_features(&ShapingData[psa->eScript].defaultTextRange, ranges, range_count);
+
+    if (!merged)
+    {
+        SHAPE_ApplyDefaultOpentypeFeatures(hdc, psc, psa, glyphs, glyph_count, max_glyphs, char_count, log_clust);
+        return;
+    }
+    SHAPE_ApplyOpenTypeFeatures(hdc, psc, psa, glyphs, glyph_count, max_glyphs, char_count, merged, log_clust);
+    heap_free(merged);
+}
+
+static void apply_positions(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa, const WORD *pwGlyphs, INT cGlyphs,
+        int *piAdvance, GOFFSET *pGoffset, const TEXTRANGE_PROPERTIES *rpRangeProperties);
+
+void SHAPE_ApplyRangeOpenTypePositions(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa, const WORD *glyphs,
+        INT glyph_count, int *advances, GOFFSET *offsets, TEXTRANGE_PROPERTIES **ranges, int range_count)
+{
+    TEXTRANGE_PROPERTIES *merged = merge_range_features(&ShapingData[psa->eScript].defaultGPOSTextRange, ranges, range_count);
+
+    if (!merged)
+    {
+        SHAPE_ApplyOpenTypePositions(hdc, psc, psa, glyphs, glyph_count, advances, offsets);
+        return;
+    }
+    apply_positions(hdc, psc, psa, glyphs, glyph_count, advances, offsets, merged);
+    heap_free(merged);
+}
+
 void SHAPE_ApplyOpenTypePositions(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa, const WORD* pwGlyphs, INT cGlyphs, int *piAdvance, GOFFSET *pGoffset )
 {
-    const TEXTRANGE_PROPERTIES *rpRangeProperties = &ShapingData[psa->eScript].defaultGPOSTextRange;
+    apply_positions(hdc, psc, psa, pwGlyphs, cGlyphs, piAdvance, pGoffset, &ShapingData[psa->eScript].defaultGPOSTextRange);
+}
+
+static void apply_positions(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa, const WORD *pwGlyphs, INT cGlyphs,
+        int *piAdvance, GOFFSET *pGoffset, const TEXTRANGE_PROPERTIES *rpRangeProperties)
+{
     int i;
 
     load_ot_tables(hdc, psc);
diff --git a/dlls/gdi32/uniscribe/usp10.c b/dlls/gdi32/uniscribe/usp10.c
index 5ae7d8f..e30806f 100644
--- a/dlls/gdi32/uniscribe/usp10.c
+++ b/dlls/gdi32/uniscribe/usp10.c
@@ -3106,7 +3106,6 @@ HRESULT WINAPI ScriptShapeOpenType( HDC hdc, SCRIPT_CACHE *psc,
     unsigned int g;
     BOOL rtl;
     int cluster;
-    static int once = 0;
 
     TRACE("(%p, %p, %p, %s, %s, %p, %p, %d, %s, %d, %d, %p, %p, %p, %p, %p )\n",
      hdc, psc, psa,
@@ -3120,9 +3119,6 @@ HRESULT WINAPI ScriptShapeOpenType( HDC hdc, SCRIPT_CACHE *psc,
     if (!pOutGlyphProps || !pcGlyphs || !pCharProps) return E_INVALIDARG;
     if (cChars > cMaxGlyphs) return E_OUTOFMEMORY;
 
-    if (cRanges)
-        if(!once++) FIXME("Ranges not supported yet\n");
-
     rtl = (psa && !psa->fLogicalOrder && psa->fRTL);
 
     *pcGlyphs = cChars;
@@ -3211,7 +3207,9 @@ HRESULT WINAPI ScriptShapeOpenType( HDC hdc, SCRIPT_CACHE *psc,
         *pcGlyphs = g;
 
         SHAPE_ContextualShaping(hdc, (ScriptCache *)*psc, psa, rChars, cChars, pwOutGlyphs, pcGlyphs, cMaxGlyphs, pwLogClust);
-        SHAPE_ApplyDefaultOpentypeFeatures(hdc, (ScriptCache *)*psc, psa, pwOutGlyphs, pcGlyphs, cMaxGlyphs, cChars, pwLogClust);
+        /* Stained Glass OS: the features of the range properties given */
+        SHAPE_ApplyRangeOpentypeFeatures(hdc, (ScriptCache *)*psc, psa, pwOutGlyphs, pcGlyphs, cMaxGlyphs, cChars,
+                rpRangeProperties, cRanges, pwLogClust);
         SHAPE_CharGlyphProp(hdc, (ScriptCache *)*psc, psa, pwcChars, cChars, pwOutGlyphs, *pcGlyphs, pwLogClust, pCharProps, pOutGlyphProps);
 
         for (i = 0; i < cChars; ++i)
@@ -3367,7 +3365,6 @@ HRESULT WINAPI ScriptPlaceOpenType( HDC hdc, SCRIPT_CACHE *psc, SCRIPT_ANALYSIS
 {
     HRESULT hr;
     int i;
-    static int once = 0;
 
     TRACE("(%p, %p, %p, %s, %s, %p, %p, %d, %s, %p, %p, %d, %p, %p, %d, %p %p %p)\n",
      hdc, psc, psa,
@@ -3380,9 +3377,6 @@ HRESULT WINAPI ScriptPlaceOpenType( HDC hdc, SCRIPT_CACHE *psc, SCRIPT_ANALYSIS
     if ((hr = init_script_cache(hdc, psc)) != S_OK) return hr;
     if (!pGoffset) return E_FAIL;
 
-    if (cRanges)
-        if (!once++) FIXME("Ranges not supported yet\n");
-
     ((ScriptCache *)*psc)->userScript = tagScript;
     ((ScriptCache *)*psc)->userLang = tagLangSys;
 
@@ -3452,7 +3446,8 @@ HRESULT WINAPI ScriptPlaceOpenType( HDC hdc, SCRIPT_CACHE *psc, SCRIPT_ANALYSIS
         if (piAdvance) piAdvance[i] = abc.abcA + abc.abcB + abc.abcC;
     }
 
-    SHAPE_ApplyOpenTypePositions(hdc, (ScriptCache *)*psc, psa, pwGlyphs, cGlyphs, piAdvance, pGoffset);
+    SHAPE_ApplyRangeOpenTypePositions(hdc, (ScriptCache *)*psc, psa, pwGlyphs, cGlyphs, piAdvance, pGoffset,
+            rpRangeProperties, cRanges);
 
     if (pABC) TRACE("Total for run: abcA=%d, abcB=%d, abcC=%d\n", pABC->abcA, pABC->abcB, pABC->abcC);
     return S_OK;
diff --git a/dlls/gdi32/uniscribe/usp10_internal.h b/dlls/gdi32/uniscribe/usp10_internal.h
index f289e5f..fad56a0 100644
--- a/dlls/gdi32/uniscribe/usp10_internal.h
+++ b/dlls/gdi32/uniscribe/usp10_internal.h
@@ -266,6 +266,10 @@ void SHAPE_ContextualShaping(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa, WC
 void SHAPE_ApplyDefaultOpentypeFeatures(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa,
                                         WORD *pwOutGlyphs, INT* pcGlyphs, INT cMaxGlyphs,
                                         INT cChars, WORD *pwLogClust);
+void SHAPE_ApplyRangeOpentypeFeatures(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa, WORD *glyphs, INT *glyph_count,
+        INT max_glyphs, INT char_count, TEXTRANGE_PROPERTIES **ranges, int range_count, WORD *log_clust);
+void SHAPE_ApplyRangeOpenTypePositions(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa, const WORD *glyphs,
+        INT glyph_count, int *advances, GOFFSET *offsets, TEXTRANGE_PROPERTIES **ranges, int range_count);
 void SHAPE_ApplyOpenTypePositions(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa,
                                   const WORD *glyphs, INT cGlyphs, int *piAdvance, GOFFSET *goffset );
 HRESULT SHAPE_CheckFontForRequiredFeatures(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa);
