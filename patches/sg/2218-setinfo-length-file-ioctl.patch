From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, wow64, server: INFO_LENGTH_MISMATCH for short set-info buffers, INVALID_DEVICE_REQUEST for foreign FSCTLs on files

Two status codes that Wine's own file tests (todo_wine) record from
Windows.  NtSetInformationFile with a buffer shorter than the information
class needs is STATUS_INFO_LENGTH_MISMATCH (Wine said INVALID_PARAMETER_3),
in ntdll and in the wow64 thunk.  A file-system control code that an
ordinary file or directory does not take is STATUS_INVALID_DEVICE_REQUEST
(Wine's server answered NOT_SUPPORTED for every kind of object); files only
accept the dismount and Wine's blocking lock request, pipes and other
devices keep their own answers.  The server changes, the protocol does not.

---
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -3248,7 +3248,6 @@ static void test_file_disposition_information(void)
     handle = CreateFileA( buffer, GENERIC_WRITE | DELETE, 0, NULL, CREATE_ALWAYS, 0, 0 );
     ok( handle != INVALID_HANDLE_VALUE, "failed to create temp file\n" );
     res = pNtSetInformationFile( handle, &io, &fdi, 0, FileDispositionInformation );
-    todo_wine
     ok( res == STATUS_INFO_LENGTH_MISMATCH, "expected STATUS_INFO_LENGTH_MISMATCH, got %lx\n", res );
     fdi2 = 0x100;
     res = pNtSetInformationFile( handle, &io, &fdi2, sizeof(fdi2), FileDispositionInformation );
@@ -5654,7 +5653,6 @@ static void test_ioctl(void)
 
     SetEvent(event);
     status = pNtFsControlFile(file, event, NULL, NULL, &iosb, 0xdeadbeef, 0, 0, 0, 0);
-    todo_wine
     ok(status == STATUS_INVALID_DEVICE_REQUEST, "NtFsControlFile returned %lx\n", status);
     ok(!is_signaled(event), "event is signaled\n");
 
@@ -5664,7 +5662,6 @@ static void test_ioctl(void)
     memset(&iosb, 0x55, sizeof(iosb));
     status = pNtFsControlFile(file, NULL, NULL, NULL, &iosb, FSCTL_PIPE_PEEK, NULL, 0,
                              &peek_buf, sizeof(peek_buf));
-    todo_wine
     ok(status == STATUS_INVALID_DEVICE_REQUEST, "NtFsControlFile failed: %lx\n", status);
     ok(iosb.Status == 0x55555555, "iosb.Status = %lx\n", iosb.Status);
 
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5393,9 +5393,6 @@ done:
     return status;
 }
 
-/******************************************************************************
- *              NtSetInformationFile   (NTDLL.@)
- */
 /* The status block of a request the file system refused (an error status) is left
  * alone, as on Windows; only a request that went through writes it. */
 static NTSTATUS set_file_info_status( IO_STATUS_BLOCK *io, unsigned int status )
@@ -5407,6 +5404,15 @@ static NTSTATUS set_file_info_status( IO_STATUS_BLOCK *io, unsigned int status )
     return io->Status = status;
 }
 
+#ifdef SG_MUTANT_SETINFO_PARAM3
+#define SET_INFO_SHORT STATUS_INVALID_PARAMETER_3
+#else
+#define SET_INFO_SHORT STATUS_INFO_LENGTH_MISMATCH  /* a buffer too short for the class, as on Windows */
+#endif
+
+/******************************************************************************
+ *              NtSetInformationFile   (NTDLL.@)
+ */
 NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
                                       void *ptr, ULONG len, FILE_INFORMATION_CLASS class )
 {
@@ -5442,7 +5448,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             if (needs_close) close( fd );
             free( unix_name );
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = SET_INFO_SHORT;
         break;
 
     case FilePositionInformation:
@@ -5458,7 +5464,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
 
             if (needs_close) close( fd );
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = SET_INFO_SHORT;
         break;
 
     case FileEndOfFileInformation:
@@ -5474,7 +5480,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             SERVER_END_REQ;
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = SET_INFO_SHORT;
         break;
 
     case FilePipeInformation:
@@ -5497,7 +5503,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             SERVER_END_REQ;
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = SET_INFO_SHORT;
         break;
 
     case FileMailslotSetInformation:
@@ -5529,7 +5535,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             SERVER_END_REQ;
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = SET_INFO_SHORT;
         break;
 
     case FileIoCompletionNotificationInformation:
@@ -5605,7 +5611,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
 #endif
             if (needs_close) close( fd );
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = SET_INFO_SHORT;
         break;
 #endif
 
@@ -5636,7 +5642,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             if (needs_close) close( fd );
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = SET_INFO_SHORT;
         break;
 
     case FileDispositionInformation:
@@ -5652,7 +5658,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             SERVER_END_REQ;
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = SET_INFO_SHORT;
         break;
 
     case FileDispositionInformationEx:
@@ -5671,7 +5677,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             SERVER_END_REQ;
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = SET_INFO_SHORT;
         break;
 
     case FileRenameInformation:
@@ -5731,7 +5737,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             free( redir.Buffer );
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = SET_INFO_SHORT;
         break;
 
     case FileLinkInformation:
@@ -5791,7 +5797,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             free( redir.Buffer );
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = SET_INFO_SHORT;
         break;
 
     default:
--- a/dlls/wow64/file.c
+++ b/dlls/wow64/file.c
@@ -839,7 +839,7 @@ NTSTATUS WINAPI wow64_NtSetInformationFile( UINT *args )
             memcpy( info->FileName, name.Buffer, info->FileNameLength );
             status = NtSetInformationFile( handle, iosb_32to64( &io, io32 ), info, size, class );
         }
-        else { status = STATUS_INVALID_PARAMETER_3; called = FALSE; }  /* refused before the call: the status block stays as it was */
+        else { status = STATUS_INFO_LENGTH_MISMATCH; called = FALSE; }  /* refused before the call: the status block stays as it was */
         break;
 
     case FileCompletionInformation:   /* FILE_COMPLETION_INFORMATION */
@@ -852,7 +852,7 @@ NTSTATUS WINAPI wow64_NtSetInformationFile( UINT *args )
             info.CompletionKey  = info32->CompletionKey;
             status = NtSetInformationFile( handle, iosb_32to64( &io, io32 ), &info, sizeof(info), class );
         }
-        else { status = STATUS_INVALID_PARAMETER_3; called = FALSE; }  /* refused before the call: the status block stays as it was */
+        else { status = STATUS_INFO_LENGTH_MISMATCH; called = FALSE; }  /* refused before the call: the status block stays as it was */
         break;
 
     default:
--- a/server/file.c
+++ b/server/file.c
@@ -49,6 +49,7 @@
 #define WIN32_NO_STATUS
 #include "windef.h"
 #include "winternl.h"
+#include "winioctl.h"
 
 #include "file.h"
 #include "handle.h"
@@ -118,6 +119,28 @@ static const struct object_ops file_ops =
     file_destroy                  /* destroy */
 };
 
+/* control codes that make sense on an ordinary file (or directory); anything else is a
+ * request this kind of device does not take */
+#define IOCTL_WINE_LOCK_FILE_ CTL_CODE( FILE_DEVICE_FILE_SYSTEM, 0xe00, METHOD_BUFFERED, FILE_ANY_ACCESS )  /* as ntdll's */
+
+static void file_ioctl( struct fd *fd, ioctl_code_t code, struct async *async )
+{
+#ifdef SG_MUTANT_FILE_IOCTL_NOT_SUPPORTED
+    default_fd_ioctl( fd, code, async );
+    return;
+#endif
+    switch (code)
+    {
+    case FSCTL_DISMOUNT_VOLUME:
+    case IOCTL_WINE_LOCK_FILE_:
+        default_fd_ioctl( fd, code, async );
+        break;
+    default:
+        set_error( STATUS_INVALID_DEVICE_REQUEST );
+        break;
+    }
+}
+
 static const struct fd_ops file_fd_ops =
 {
     default_fd_get_poll_events,   /* get_poll_events */
@@ -128,7 +151,7 @@ static const struct fd_ops file_fd_ops =
     no_fd_flush,                  /* flush */
     default_fd_get_file_info,     /* get_file_info */
     no_fd_get_volume_info,        /* get_volume_info */
-    default_fd_ioctl,             /* ioctl */
+    file_ioctl,                   /* ioctl */
     default_fd_cancel_async,      /* cancel_async */
     default_fd_queue_async,       /* queue_async */
     default_fd_reselect_async     /* reselect_async */
