 static HRESULT WINAPI HTMLElement3_put_onmove(IHTMLElement3 *iface, VARIANT v)
@@ -4790,8 +4898,63 @@ static HRESULT WINAPI HTMLElement4_removeAttributeNode(IHTMLElement4 *iface, IHT
         IHTMLDOMAttribute **ppretAttribute)
 {
     HTMLElement *This = impl_from_IHTMLElement4(iface);
-    FIXME("(%p)->(%p %p)\n", This, pattr, ppretAttribute);
-    return E_NOTIMPL;
+    HTMLDOMAttribute *attr, *iter;
+    HTMLAttributeCollection *attrs;
+    VARIANT_BOOL success;
+    VARIANT value;
+    BSTR name;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p %p)\n", This, pattr, ppretAttribute);
+
+    attr = unsafe_impl_from_IHTMLDOMAttribute(pattr);
+    if(!attr || attr->elem != This)
+        return E_INVALIDARG;
+
+    hres = HTMLElement_get_attr_col(&This->node, &attrs);
+    if(FAILED(hres))
+        return hres;
+
+    LIST_FOR_EACH_ENTRY(iter, &attrs->attrs, HTMLDOMAttribute, entry)
+        if(iter == attr)
+            break;
+    if(&iter->entry == &attrs->attrs) {
+        IHTMLAttributeCollection_Release(&attrs->IHTMLAttributeCollection_iface);
+        return E_INVALIDARG;
+    }
+
+    hres = dispex_prop_name(&This->node.event_target.dispex, attr->dispid, &name);
+    if(SUCCEEDED(hres)) {
+        V_VT(&value) = VT_EMPTY;
+        if(FAILED(get_elem_attr_value_by_dispid(This, attr->dispid, &value)))
+            V_VT(&value) = VT_EMPTY;
+
+        success = VARIANT_FALSE;
+        hres = IHTMLElement_removeAttribute(&This->IHTMLElement_iface, name, 0, &success);
+        if(FAILED(hres)) {
+            VariantClear(&value);
+            SysFreeString(name);
+        }
+    }
+    if(FAILED(hres)) {
+        IHTMLAttributeCollection_Release(&attrs->IHTMLAttributeCollection_iface);
+        return hres;
+    }
+
+    /* The attribute becomes detached and keeps its name and last value; the reference held by
+     * the collection moves to the caller. */
+    list_remove(&attr->entry);
+    free(attr->name);
+    attr->name = wcsdup(name);
+    SysFreeString(name);
+    VariantClear(&attr->value);
+    attr->value = value;
+    attr->elem = NULL;
+    IHTMLAttributeCollection_Release(&attrs->IHTMLAttributeCollection_iface);
+    IHTMLDOMNode_Release(&This->node.IHTMLDOMNode_iface);
+
+    *ppretAttribute = &attr->IHTMLDOMAttribute_iface;
+    return S_OK;
 }
 
