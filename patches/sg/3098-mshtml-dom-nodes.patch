                                              IHTMLDOMNode **removed)
 {
     HTMLDOMNode *This = impl_from_IHTMLDOMNode(iface);
-    FIXME("(%p)->(%x %p)\n", This, fDeep, removed);
-    return E_NOTIMPL;
+    nsIDOMNode *parent, *child, *junk;
+    nsresult nsres;
+
+    TRACE("(%p)->(%x %p)\n", This, fDeep, removed);
+
+    nsres = nsIDOMNode_GetParentNode(This->nsnode, &parent);
+    if(NS_FAILED(nsres))
+        return E_FAIL;
+    if(!parent) {
+        /* Nothing to remove from; the node itself is returned. */
+        IHTMLDOMNode_AddRef(&This->IHTMLDOMNode_iface);
+        *removed = &This->IHTMLDOMNode_iface;
+        return S_OK;
+    }
+
+    if(!fDeep) {
+        /* Children take the place of the removed node. */
+        for(;;) {
+            nsres = nsIDOMNode_GetFirstChild(This->nsnode, &child);
+            if(NS_FAILED(nsres) || !child)
+                break;
+            nsres = nsIDOMNode_InsertBefore(parent, child, This->nsnode, &junk);
+            nsIDOMNode_Release(child);
+            if(NS_FAILED(nsres)) {
+                nsIDOMNode_Release(parent);
+                return E_FAIL;
+            }
+            if(junk)
+                nsIDOMNode_Release(junk);
+        }
+    }
+
+    nsres = nsIDOMNode_RemoveChild(parent, This->nsnode, &junk);
+    nsIDOMNode_Release(parent);
+    if(NS_FAILED(nsres))
+        return E_FAIL;
+    if(junk)
+        nsIDOMNode_Release(junk);
+
