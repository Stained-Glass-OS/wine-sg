 BOOL WINAPI IsHostInProxyBypassList(INTERNET_SCHEME scheme, LPCSTR szHost, DWORD length)
 {
-    FIXME("STUB: scheme=%d host=%s length=%ld\n", scheme, szHost, length);
-    return FALSE;
+    WCHAR *host, *bypass;
+    BOOL ret;
+    int len;
+
+    TRACE("scheme=%d host=%s length=%ld\n", scheme, debugstr_an(szHost, length), length);
+
+    if (!szHost || !length)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    len = MultiByteToWideChar(CP_ACP, 0, szHost, length, NULL, 0);
+    if (!(host = malloc((len + 1) * sizeof(WCHAR))))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    MultiByteToWideChar(CP_ACP, 0, szHost, length, host, len);
+    host[len] = 0;
+
+    bypass = INTERNET_GetGlobalProxyBypass();
+    ret = HTTP_HostInBypassList(bypass, host);
+    free(bypass);
+    free(host);
+    return ret;
 }
