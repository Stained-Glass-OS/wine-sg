 #include "wine/debug.h"
 #include "internet.h"
@@ -1288,6 +1289,17 @@ DWORD WINAPI InternetSetCookieExA( LPCSTR lpszURL, LPCSTR lpszCookieName, LPCSTR
     return r;
 }
 
+/* The per-site decisions are kept below the user's Internet Settings, one subkey per site
+ * with a DWORD "Decision". */
+static const WCHAR persite_key_path[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\P3P\\History";
+
+static LONG persite_open_key(REGSAM access, BOOL create, HKEY *key)
+{
+    if (create)
+        return RegCreateKeyExW(HKEY_CURRENT_USER, persite_key_path, 0, NULL, 0, access, NULL, key, NULL);
+    return RegOpenKeyExW(HKEY_CURRENT_USER, persite_key_path, 0, access, key);
+}
+
 /***********************************************************************
  *           InternetClearAllPerSiteCookieDecisions (WININET.@)
  *
@@ -1300,7 +1312,31 @@ DWORD WINAPI InternetSetCookieExA( LPCSTR lpszURL, LPCSTR lpszCookieName, LPCSTR
  */
 BOOL WINAPI InternetClearAllPerSiteCookieDecisions( VOID )
 {
-    FIXME("stub\n");
+    HKEY key;
+    WCHAR name[256];
+    LONG res;
+
+    TRACE("\n");
+
+    res = persite_open_key(KEY_ALL_ACCESS, FALSE, &key);
+    if (res == ERROR_FILE_NOT_FOUND) return TRUE;
+    if (res)
+    {
+        SetLastError(res);
+        return FALSE;
+    }
+
+    while (!(res = RegEnumKeyW(key, 0, name, ARRAY_SIZE(name))))
+    {
+        if ((res = RegDeleteTreeW(key, name))) break;
+    }
+    RegCloseKey(key);
+
+    if (res && res != ERROR_NO_MORE_ITEMS)
+    {
+        SetLastError(res);
+        return FALSE;
+    }
     return TRUE;
 }
 
@@ -1312,9 +1348,38 @@ BOOL WINAPI InternetClearAllPerSiteCookieDecisions( VOID )
 BOOL WINAPI InternetEnumPerSiteCookieDecisionA( LPSTR pszSiteName, ULONG *pcSiteNameSize,
                                                 ULONG *pdwDecision, ULONG dwIndex )
 {
-    FIXME("(%s, %p, %p, 0x%08lx) stub\n",
-          debugstr_a(pszSiteName), pcSiteNameSize, pdwDecision, dwIndex);
-    return FALSE;
+    WCHAR *buffer = NULL;
+    ULONG size;
+    BOOL ret;
+
+    TRACE("(%p, %p, %p, 0x%08lx)\n", pszSiteName, pcSiteNameSize, pdwDecision, dwIndex);
+
+    if (!pcSiteNameSize || !pdwDecision)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    size = *pcSiteNameSize;
+    if (pszSiteName && size && !(buffer = malloc(size * sizeof(WCHAR))))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+
+    ret = InternetEnumPerSiteCookieDecisionW(buffer, &size, pdwDecision, dwIndex);
+    if (ret)
+    {
+        int len = WideCharToMultiByte(CP_ACP, 0, buffer, -1, pszSiteName, *pcSiteNameSize, NULL, NULL);
+        if (!len)
+        {
+            SetLastError(ERROR_INSUFFICIENT_BUFFER);
+            ret = FALSE;
+        }
+    }
+    *pcSiteNameSize = size;
+    free(buffer);
+    return ret;
 }
 
 /***********************************************************************
@@ -1330,9 +1395,54 @@ BOOL WINAPI InternetEnumPerSiteCookieDecisionA( LPSTR pszSiteName, ULONG *pcSite
 BOOL WINAPI InternetEnumPerSiteCookieDecisionW( LPWSTR pszSiteName, ULONG *pcSiteNameSize,
                                                 ULONG *pdwDecision, ULONG dwIndex )
 {
-    FIXME("(%s, %p, %p, 0x%08lx) stub\n",
-          debugstr_w(pszSiteName), pcSiteNameSize, pdwDecision, dwIndex);
-    return FALSE;
+    DWORD name_len, type, value, value_size = sizeof(value);
+    WCHAR name[256];
+    HKEY key, site;
+    LONG res;
+
+    TRACE("(%p, %p, %p, 0x%08lx)\n", pszSiteName, pcSiteNameSize, pdwDecision, dwIndex);
+
+    if (!pcSiteNameSize || !pdwDecision)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    if ((res = persite_open_key(KEY_READ, FALSE, &key)))
+    {
+        SetLastError(res == ERROR_FILE_NOT_FOUND ? ERROR_NO_MORE_ITEMS : res);
+        return FALSE;
+    }
+
+    res = RegEnumKeyW(key, dwIndex, name, ARRAY_SIZE(name));
+    if (res)
+    {
+        RegCloseKey(key);
+        SetLastError(res);
+        return FALSE;
+    }
+
+    name_len = lstrlenW(name) + 1;
+    if (!pszSiteName || *pcSiteNameSize < name_len)
+    {
+        *pcSiteNameSize = name_len;
+        RegCloseKey(key);
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+
+    *pdwDecision = COOKIE_STATE_UNKNOWN;
+    if (!RegOpenKeyExW(key, name, 0, KEY_READ, &site))
+    {
+        if (!RegQueryValueExW(site, L"Decision", NULL, &type, (BYTE *)&value, &value_size) && type == REG_DWORD)
+            *pdwDecision = value;
+        RegCloseKey(site);
+    }
+    RegCloseKey(key);
+
+    memcpy(pszSiteName, name, name_len * sizeof(WCHAR));
+    *pcSiteNameSize = name_len;
+    return TRUE;
 }
 
 /***********************************************************************
@@ -1340,8 +1450,28 @@ BOOL WINAPI InternetEnumPerSiteCookieDecisionW( LPWSTR pszSiteName, ULONG *pcSit
  */
 BOOL WINAPI InternetGetPerSiteCookieDecisionA( LPCSTR pwchHostName, ULONG *pResult )
 {
-    FIXME("(%s, %p) stub\n", debugstr_a(pwchHostName), pResult);
-    return FALSE;
+    WCHAR *host;
+    int len;
+    BOOL ret;
+
+    TRACE("(%s, %p)\n", debugstr_a(pwchHostName), pResult);
+
+    if (!pwchHostName || !pResult)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    len = MultiByteToWideChar(CP_ACP, 0, pwchHostName, -1, NULL, 0);
+    if (!(host = malloc(len * sizeof(WCHAR))))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    MultiByteToWideChar(CP_ACP, 0, pwchHostName, -1, host, len);
+    ret = InternetGetPerSiteCookieDecisionW(host, pResult);
+    free(host);
+    return ret;
 }
 
 /***********************************************************************
@@ -1349,8 +1479,44 @@ BOOL WINAPI InternetGetPerSiteCookieDecisionA( LPCSTR pwchHostName, ULONG *pResu
  */
 BOOL WINAPI InternetGetPerSiteCookieDecisionW( LPCWSTR pwchHostName, ULONG *pResult )
 {
-    FIXME("(%s, %p) stub\n", debugstr_w(pwchHostName), pResult);
-    return FALSE;
+    DWORD type, value, size = sizeof(value);
+    HKEY key, site;
+    LONG res;
+
+    TRACE("(%s, %p)\n", debugstr_w(pwchHostName), pResult);
+
+    if (!pwchHostName || !*pwchHostName || !pResult)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    *pResult = COOKIE_STATE_UNKNOWN;
+
+    if ((res = persite_open_key(KEY_READ, FALSE, &key)))
+    {
+        SetLastError(res);
+        return FALSE;
+    }
+
+    res = RegOpenKeyExW(key, pwchHostName, 0, KEY_READ, &site);
+    RegCloseKey(key);
+    if (res)
+    {
+        SetLastError(res);
+        return FALSE;
+    }
+
+    res = RegQueryValueExW(site, L"Decision", NULL, &type, (BYTE *)&value, &size);
+    RegCloseKey(site);
+    if (res || type != REG_DWORD)
+    {
+        SetLastError(res ? res : ERROR_INVALID_DATA);
+        return FALSE;
+    }
+
+    *pResult = value;
+    return TRUE;
 }
 
 /***********************************************************************
@@ -1358,8 +1524,28 @@ BOOL WINAPI InternetGetPerSiteCookieDecisionW( LPCWSTR pwchHostName, ULONG *pRes
  */
 BOOL WINAPI InternetSetPerSiteCookieDecisionA( LPCSTR pchHostName, DWORD dwDecision )
 {
-    FIXME("(%s, 0x%08lx) stub\n", debugstr_a(pchHostName), dwDecision);
-    return FALSE;
+    WCHAR *host;
+    int len;
+    BOOL ret;
+
+    TRACE("(%s, 0x%08lx)\n", debugstr_a(pchHostName), dwDecision);
+
+    if (!pchHostName)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    len = MultiByteToWideChar(CP_ACP, 0, pchHostName, -1, NULL, 0);
+    if (!(host = malloc(len * sizeof(WCHAR))))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    MultiByteToWideChar(CP_ACP, 0, pchHostName, -1, host, len);
+    ret = InternetSetPerSiteCookieDecisionW(host, dwDecision);
+    free(host);
+    return ret;
 }
 
 /***********************************************************************
@@ -1367,8 +1553,51 @@ BOOL WINAPI InternetSetPerSiteCookieDecisionA( LPCSTR pchHostName, DWORD dwDecis
  */
 BOOL WINAPI InternetSetPerSiteCookieDecisionW( LPCWSTR pchHostName, DWORD dwDecision )
 {
-    FIXME("(%s, 0x%08lx) stub\n", debugstr_w(pchHostName), dwDecision);
-    return FALSE;
+    HKEY key, site;
+    LONG res;
+
+    TRACE("(%s, 0x%08lx)\n", debugstr_w(pchHostName), dwDecision);
+
+    if (!pchHostName || !*pchHostName || wcschr(pchHostName, '\\') || dwDecision > COOKIE_STATE_MAX)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    /* "unknown" forgets the decision */
+    if (dwDecision == COOKIE_STATE_UNKNOWN)
+    {
+        if (!(res = persite_open_key(KEY_ALL_ACCESS, FALSE, &key)))
+        {
+            res = RegDeleteTreeW(key, pchHostName);
+            RegCloseKey(key);
+        }
+        if (res == ERROR_FILE_NOT_FOUND) res = ERROR_SUCCESS;
+        if (res) SetLastError(res);
+        return !res;
+    }
+
+    if ((res = persite_open_key(KEY_ALL_ACCESS, TRUE, &key)))
+    {
+        SetLastError(res);
+        return FALSE;
+    }
+    res = RegCreateKeyExW(key, pchHostName, 0, NULL, 0, KEY_SET_VALUE, NULL, &site, NULL);
+    RegCloseKey(key);
+    if (res)
+    {
+        SetLastError(res);
+        return FALSE;
+    }
+
+    res = RegSetValueExW(site, L"Decision", 0, REG_DWORD, (const BYTE *)&dwDecision, sizeof(dwDecision));
+    RegCloseKey(site);
+    if (res)
+    {
+        SetLastError(res);
+        return FALSE;
+    }
+    return TRUE;
 }
 
 void free_cookie(void)
