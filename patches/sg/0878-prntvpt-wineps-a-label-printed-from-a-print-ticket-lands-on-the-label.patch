 }
 
+#ifndef SG_MUTANT_PAPERMATCH
+/* Stained Glass OS: the PPD page a custom size (dmPaperWidth/Length, 1/10 mm)
+ * stands for -- a page whose paper or printable area is that size within
+ * 1 mm, in either orientation; on a tie the page already chosen. A print
+ * ticket's psk:CustomMediaSize arrives this way (DYMO Connect asks for the
+ * printable area of the loaded label), and without a page the job had no
+ * PageSize and printed on the queue's default paper. */
+static int size_diff( int w, int l, float pw, float pl )
+{
+    int a = paper_size_from_points( min( pw, pl ) ), b = paper_size_from_points( max( pw, pl ) );
+    return max( abs( a - w ), abs( b - l ) );
+}
+
+static PAGESIZE *find_pagesize_by_size( PPD *ppd, int width, int length, WORD current )
+{
+    PAGESIZE *page, *best = NULL;
+    int w = min( width, length ), l = max( width, length ), best_diff = 11, diff;
+
+    LIST_FOR_EACH_ENTRY( page, &ppd->PageSizes, PAGESIZE, entry )
+    {
+        if (!page->PaperDimension) continue;
+        diff = size_diff( w, l, page->PaperDimension->x, page->PaperDimension->y );
+        if (page->ImageableArea)
+            diff = min( diff, size_diff( w, l, page->ImageableArea->urx - page->ImageableArea->llx,
+                                         page->ImageableArea->ury - page->ImageableArea->lly ) );
+        if (diff < best_diff || (diff == best_diff && best && page->WinPage == current))
+        {
+            best = page;
+            best_diff = diff;
+        }
+    }
+    return best;
+}
+#endif
+
 DUPLEX *find_duplex( PPD *ppd, const DEVMODEW *dm )
 {
     DUPLEX *duplex;
