+#ifndef SG_MUTANT_PAPERMATCH
+/* Stained Glass OS: the page a custom size stands for; see driver.c. */
+static int size_diff(int w, int l, float pw, float pl)
+{
+    int a = paper_size_from_points(min(pw, pl)), b = paper_size_from_points(max(pw, pl));
+    return max(abs(a - w), abs(b - l));
+}
+
+static const struct page_size *find_pagesize_by_size(const struct printer_info *pi,
+        int width, int length, short current)
+{
+    const struct page_size *page, *best = NULL;
+    int w = min(width, length), l = max(width, length), best_diff = 11, diff, i;
+
+    page = (const struct page_size *)(pi->devmode->data +
+            pi->devmode->input_slots * sizeof(struct input_slot) +
+            pi->devmode->resolutions * sizeof(struct resolution));
+    for (i = 0; i < pi->devmode->page_sizes; i++)
+    {
+        diff = size_diff(w, l, page[i].paper_dimension.x, page[i].paper_dimension.y);
+        diff = min(diff, size_diff(w, l, page[i].imageable_area.right - page[i].imageable_area.left,
+                                   page[i].imageable_area.top - page[i].imageable_area.bottom));
+        if (diff < best_diff || (diff == best_diff && best && page[i].win_page == current))
+        {
+            best = page + i;
+            best_diff = diff;
+        }
+    }
+    return best;
+}
+#endif
+
