+#ifndef SG_MUTANT_CMGETPARENT
+/* Stained Glass OS: one device node per device instance in the process, as
+ * on Windows, however many device information sets hold the device: a
+ * program compares device nodes (DYMO Connect: CM_Get_Parent of the printer
+ * device against the USB device it enumerated). Each node is the instance ID
+ * and how many devices of the sets have it; its device is any of them. */
+struct devnode_entry
+{
+    WCHAR *id;
+    unsigned int refs;
+};
+
+static struct devnode_entry *devnode_table;
+static unsigned int devnode_table_size;
+static struct list all_devices = LIST_INIT(all_devices);
+static CRITICAL_SECTION devnode_cs;
+static CRITICAL_SECTION_DEBUG devnode_cs_debug =
+{
+    0, 0, &devnode_cs,
+    { &devnode_cs_debug.ProcessLocksList, &devnode_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": devnode_cs") }
+};
+static CRITICAL_SECTION devnode_cs = { &devnode_cs_debug, -1, 0, 0, 0, 0 };
+
+static DEVINST alloc_devnode(struct device *device)
+{
+    unsigned int i, free_slot = ~0u;
+
+    EnterCriticalSection(&devnode_cs);
+    list_add_tail(&all_devices, &device->all_entry);
+    for (i = 0; i < devnode_table_size; ++i)
+    {
+        if (devnode_table[i].id && !wcsicmp(devnode_table[i].id, device->instanceId))
+        {
+            devnode_table[i].refs++;
+            LeaveCriticalSection(&devnode_cs);
+            return i;
+        }
+        if (!devnode_table[i].id && free_slot == ~0u) free_slot = i;
+    }
+    if (free_slot == ~0u)
+    {
+        unsigned int size = devnode_table_size ? devnode_table_size * 2 : 256;
+        struct devnode_entry *table = realloc(devnode_table, size * sizeof(*table));
+
+        if (!table)
+        {
+            LeaveCriticalSection(&devnode_cs);
+            return ~0u;
+        }
+        memset(table + devnode_table_size, 0, (size - devnode_table_size) * sizeof(*table));
+        free_slot = devnode_table_size;
+        devnode_table = table;
+        devnode_table_size = size;
+    }
+    devnode_table[free_slot].id = wcsdup(device->instanceId);
+    devnode_table[free_slot].refs = 1;
+    LeaveCriticalSection(&devnode_cs);
+    return free_slot;
+}
+
+static void free_devnode(struct device *device)
+{
+    DEVINST devnode = device->devnode;
+
+    EnterCriticalSection(&devnode_cs);
+    list_remove(&device->all_entry);
+    if (devnode < devnode_table_size && devnode_table[devnode].id && !--devnode_table[devnode].refs)
+    {
+        free(devnode_table[devnode].id);
+        devnode_table[devnode].id = NULL;
+    }
+    LeaveCriticalSection(&devnode_cs);
+}
+
+static struct device *get_devnode_device(DEVINST devnode)
+{
+    struct device *device;
+
+    EnterCriticalSection(&devnode_cs);
+    if (devnode < devnode_table_size && devnode_table[devnode].id)
+    {
+        LIST_FOR_EACH_ENTRY(device, &all_devices, struct device, all_entry)
+        {
+            if (device->devnode == devnode)
+            {
+                LeaveCriticalSection(&devnode_cs);
+                return device;
+            }
+        }
+    }
+    LeaveCriticalSection(&devnode_cs);
+    WARN("device node %lu not found\n", devnode);
+    return NULL;
+}
+#else
 static struct device **devnode_table;
 static unsigned int devnode_table_size;
 
