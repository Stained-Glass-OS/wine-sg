+#ifndef SG_MUTANT_CMDEVNODEPROP
+/***********************************************************************
+ *      CM_Get_DevNode_Registry_Property_ExW (SETUPAPI.@)
+ *
+ * Stained Glass OS: a device node's registry property (CM_DRP_x is SPDRP_x
+ * + 1), as SetupDiGetDeviceRegistryProperty reads it. Was a stub: DYMO
+ * Connect read its LabelWriter's hardware IDs so, found none, and did not
+ * talk to the printer.
+ */
+CONFIGRET WINAPI CM_Get_DevNode_Registry_Property_ExW(DEVINST devnode, ULONG prop, ULONG *type,
+        void *buffer, ULONG *len, ULONG flags, HMACHINE machine)
+{
+    struct device *device = get_devnode_device(devnode);
+    DWORD size, value_type;
+    LONG l;
+
+    TRACE("%lu, %lu, %p, %p, %p, %#lx, %p\n", devnode, prop, type, buffer, len, flags, machine);
+
+    if (!device) return CR_NO_SUCH_DEVNODE;
+    if (!len) return CR_INVALID_POINTER;
+    if (!prop || prop - 1 >= ARRAY_SIZE(PropertyMap) || !PropertyMap[prop - 1].nameW) return CR_INVALID_PROPERTY;
+
+    size = buffer ? *len : 0;
+    l = RegQueryValueExW(device->key, PropertyMap[prop - 1].nameW, NULL, &value_type, buffer, &size);
+    if (l == ERROR_FILE_NOT_FOUND) return CR_NO_SUCH_VALUE;
+    if (l && l != ERROR_MORE_DATA) return CR_REGISTRY_ERROR;
+    *len = size;
+    if (type) *type = value_type;
+    if (l == ERROR_MORE_DATA || !buffer) return CR_BUFFER_SMALL;
+    return CR_SUCCESS;
+}
+#endif
+
+static LSTATUS get_device_property(struct device *device, const DEVPROPKEY *prop_key, DEVPROPTYPE *prop_type,
+                BYTE *prop_buff, DWORD prop_buff_size, DWORD *required_size, DWORD flags);
+
+#ifndef SG_MUTANT_CMGETPARENT
+/***********************************************************************
+ *      CM_Get_Parent (SETUPAPI.@)
+ *
+ * Stained Glass OS: the device's parent, as Wine's PnP manager recorded it
+ * when it enumerated the device (DEVPKEY_Device_Parent). Was a stub: DYMO
+ * Connect finds its USB printer's Printer-class device by its parent, the
+ * USB device, and found none.
+ */
+CONFIGRET WINAPI CM_Get_Parent(DEVINST *parent, DEVINST devnode, ULONG flags)
+{
+    static const DEVPROPKEY parent_key = {{0x4340a6c5,0x93fa,0x4706,{0x97,0x2c,0x7b,0x64,0x80,0x08,0xa5,0xa7}}, 8};
+    static HDEVINFO parents;
+    struct device *device = get_devnode_device(devnode);
+    SP_DEVINFO_DATA data = {sizeof(data)};
+    WCHAR id[MAX_DEVICE_ID_LEN];
+    DEVPROPTYPE type;
+    HDEVINFO set;
+
+    TRACE("%p, %lu, %#lx\n", parent, devnode, flags);
+
+    if (!parent) return CR_INVALID_POINTER;
+    *parent = 0;
+    if (!device) return CR_INVALID_DEVNODE;
+    if (get_device_property(device, &parent_key, &type, (BYTE *)id, sizeof(id), NULL, 0) || type != DEVPROP_TYPE_STRING)
+        return CR_NO_SUCH_DEVNODE;
+    /* the parents' device nodes live as long as the process, as on Windows */
+    if (!parents)
+    {
+        if ((set = SetupDiCreateDeviceInfoList(NULL, NULL)) == INVALID_HANDLE_VALUE) return CR_OUT_OF_MEMORY;
+        if (InterlockedCompareExchangePointer(&parents, set, NULL)) SetupDiDestroyDeviceInfoList(set);
+    }
+    if (!SetupDiOpenDeviceInfoW(parents, id, NULL, 0, &data)) return CR_NO_SUCH_DEVNODE;
+    TRACE("parent %s\n", debugstr_w(id));
+    *parent = data.DevInst;
+    return CR_SUCCESS;
+}
+#endif
+
 CONFIGRET WINAPI CM_Get_Device_ID_Size(ULONG *len, DEVINST devnode, ULONG flags)
 {
     struct device *device = get_devnode_device(devnode);
