+static HRESULT audio_capture_get_device(IMFAttributes *attributes, IMMDevice **device)
+{
+    static const WCHAR mmdev_prefix[] = L"\\\\?\\SWD#MMDEVAPI#";
+    IMMDeviceEnumerator *devenum;
+    WCHAR *id = NULL, *end;
+    UINT32 role, length;
+    HRESULT hr;
+
+    if (FAILED(hr = CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL, CLSCTX_INPROC_SERVER, &IID_IMMDeviceEnumerator,
+            (void **)&devenum)))
+        return hr;
+
+    if (SUCCEEDED(IMFAttributes_GetAllocatedString(attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_AUDCAP_ENDPOINT_ID,
+            &id, &length)))
+    {
+        hr = IMMDeviceEnumerator_GetDevice(devenum, id, device);
+    }
+    else if (SUCCEEDED(IMFAttributes_GetAllocatedString(attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_AUDCAP_SYMBOLIC_LINK,
+            &id, &length)))
+    {
+        /* \\?\SWD#MMDEVAPI#<endpoint id>#<interface class> */
+        if (wcsnicmp(id, mmdev_prefix, wcslen(mmdev_prefix)) || !(end = wcsrchr(id, '#'))
+                || end < id + wcslen(mmdev_prefix))
+            hr = MF_E_NO_CAPTURE_DEVICES_AVAILABLE;
+        else
+        {
+            *end = 0;
+            hr = IMMDeviceEnumerator_GetDevice(devenum, id + wcslen(mmdev_prefix), device);
+        }
+    }
+    else if (SUCCEEDED(hr = IMFAttributes_GetUINT32(attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_AUDCAP_ROLE, &role)))
+    {
+        hr = IMMDeviceEnumerator_GetDefaultAudioEndpoint(devenum, eCapture, role, device);
+    }
+
+    if (hr == E_NOTFOUND || hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND))
+        hr = MF_E_NO_CAPTURE_DEVICES_AVAILABLE;
+
+    CoTaskMemFree(id);
+    IMMDeviceEnumerator_Release(devenum);
+
+    return hr;
+}
