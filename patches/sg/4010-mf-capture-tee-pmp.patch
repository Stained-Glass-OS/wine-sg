+static HRESULT tee_node_request_sample(struct media_session *session, struct topo_node *topo_node, DWORD index)
+{
+    unsigned int i, demand = ~0u;
+    struct tee_output *output;
+    struct topo_node *node;
+    DWORD input, up_output;
+    BOOL have_required = FALSE;
+    HRESULT hr = S_OK;
+
+    if (index >= topo_node->u.tee.output_count)
+        return MF_E_INVALIDSTREAMNUMBER;
+
+    output = &topo_node->u.tee.outputs[index];
+    if (output->end_of_stream)
+    {
+        output->end_of_stream = FALSE;
+        if ((node = session_get_topo_node_output(session, topo_node, index, &input)))
+            session_deliver_sample_to_node(session, node, input, NULL);
+        return S_OK;
+    }
+
+    output->requests++;
+
+    /* Pull as many samples as the slowest required output still wants. */
+    for (i = 0; i < topo_node->u.tee.output_count; ++i)
+    {
+        if (topo_node->u.tee.outputs[i].discardable)
+            continue;
+        have_required = TRUE;
+        demand = min(demand, topo_node->u.tee.outputs[i].requests);
+    }
+    if (!have_required)
+    {
+        demand = 0;
+        for (i = 0; i < topo_node->u.tee.output_count; ++i)
+            demand = max(demand, topo_node->u.tee.outputs[i].requests);
+    }
+
+    if (demand > topo_node->u.tee.pending)
+    {
+        if (!(node = session_get_topo_node_input(session, topo_node, 0, &up_output)))
+            hr = MF_E_INVALIDREQUEST;
+        else if (SUCCEEDED(hr = session_request_sample_from_node(session, node, up_output)))
+            topo_node->u.tee.pending++;
+        if (FAILED(hr))
+            output->requests--;
+    }
+
+    return hr;
+}
