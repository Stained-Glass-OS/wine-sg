+static HRESULT WINAPI audio_capture_stream_GetMediaSource(IMFMediaStream *iface, IMFMediaSource **out)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaStream(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+
+    EnterCriticalSection(&source->cs);
+    if (source->state == CAPTURE_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        *out = &source->IMFMediaSource_iface;
+        IMFMediaSource_AddRef(*out);
