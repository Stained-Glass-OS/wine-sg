+HRESULT create_audio_capture_source(IMFAttributes *attributes, IMFMediaSource **out)
+{
+    struct audio_capture_source *object;
+    IMFMediaTypeHandler *handler;
+    IMFMediaType *media_type;
+    EDataFlow flow;
+    IMMEndpoint *endpoint;
+    HRESULT hr;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->IMFMediaSource_iface.lpVtbl = &audio_capture_source_vtbl;
+    object->IMFMediaStream_iface.lpVtbl = &audio_capture_stream_vtbl;
+    object->refcount = 1;
+    list_init(&object->requests);
+    list_init(&object->samples);
+    InitializeCriticalSection(&object->cs);
+    object->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": audio_capture_source.cs");
+
+    if (FAILED(hr = audio_capture_get_device(attributes, &object->device)))
+        goto failed;
+
+    if (SUCCEEDED(IMMDevice_QueryInterface(object->device, &IID_IMMEndpoint, (void **)&endpoint)))
+    {
+        hr = IMMEndpoint_GetDataFlow(endpoint, &flow);
+        IMMEndpoint_Release(endpoint);
+        if (SUCCEEDED(hr) && flow != eCapture)
+            hr = MF_E_NO_CAPTURE_DEVICES_AVAILABLE;
+        if (FAILED(hr))
+            goto failed;
+    }
+
+    if (FAILED(hr = IMMDevice_Activate(object->device, &IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL,
+            (void **)&object->client)))
+        goto failed;
+    if (FAILED(hr = IAudioClient_GetMixFormat(object->client, &object->format)))
+        goto failed;
+    if (FAILED(hr = IAudioClient_Initialize(object->client, AUDCLNT_SHAREMODE_SHARED, AUDCLNT_STREAMFLAGS_EVENTCALLBACK,
+            1000000, 0, object->format, NULL)))
+        goto failed;
+    if (!(object->buffer_event = CreateEventW(NULL, FALSE, FALSE, NULL)))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        goto failed;
+    }
+    if (FAILED(hr = IAudioClient_SetEventHandle(object->client, object->buffer_event)))
+        goto failed;
+    if (FAILED(hr = IAudioClient_GetService(object->client, &IID_IAudioCaptureClient, (void **)&object->capture)))
+        goto failed;
+
+    if (FAILED(hr = MFCreateMediaType(&media_type)))
+        goto failed;
+    if (SUCCEEDED(hr = MFInitMediaTypeFromWaveFormatEx(media_type, object->format,
+            sizeof(*object->format) + object->format->cbSize)))
+        hr = MFCreateStreamDescriptor(0, 1, &media_type, &object->sd);
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IMFStreamDescriptor_GetMediaTypeHandler(object->sd, &handler)))
+    {
+        hr = IMFMediaTypeHandler_SetCurrentMediaType(handler, media_type);
+        IMFMediaTypeHandler_Release(handler);
+    }
+    IMFMediaType_Release(media_type);
+    if (FAILED(hr))
+        goto failed;
+
+    if (FAILED(hr = MFCreatePresentationDescriptor(1, &object->sd, &object->pd)))
+        goto failed;
+    if (FAILED(hr = IMFPresentationDescriptor_SelectStream(object->pd, 0)))
+        goto failed;
+
+    if (FAILED(hr = MFCreateEventQueue(&object->event_queue)))
+        goto failed;
+    if (FAILED(hr = MFCreateEventQueue(&object->stream_queue)))
+        goto failed;
+
+    if (!(object->thread = CreateThread(NULL, 0, capture_thread_proc, object, 0, NULL)))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        goto failed;
+    }
+
+    *out = &object->IMFMediaSource_iface;
+    return S_OK;
+
+failed:
+    IMFMediaSource_Release(&object->IMFMediaSource_iface);
+    return hr;
+}
