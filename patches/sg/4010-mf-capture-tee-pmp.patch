+static HRESULT enum_encoders(const GUID *category, const GUID *major, const GUID *subtype, DWORD flags,
+        IMFActivate ***activates, UINT32 *count)
+{
+    MFT_REGISTER_TYPE_INFO output = {*major, *subtype};
+
+    if (!flags)
+        flags = MFT_ENUM_FLAG_SYNCMFT | MFT_ENUM_FLAG_LOCALMFT | MFT_ENUM_FLAG_SORTANDFILTER;
+
+    return MFTEnumEx(*category, flags, NULL, &output, activates, count);
+}
+
+/***********************************************************************
+ *      MFTranscodeGetAudioOutputAvailableTypes (mf.@)
+ */
+HRESULT WINAPI MFTranscodeGetAudioOutputAvailableTypes(REFGUID subtype, DWORD flags, IMFAttributes *codec_config,
+        IMFCollection **types)
+{
+    IMFActivate **activates = NULL;
+    IMFCollection *collection;
+    IMFTransform *transform;
+    IMFMediaType *type;
+    UINT32 count = 0, i;
+    DWORD index, items;
+    GUID type_subtype;
+    HRESULT hr;
+
+    TRACE("%s, %#lx, %p, %p.\n", debugstr_guid(subtype), flags, codec_config, types);
+
+    if (!subtype || !types)
+        return E_POINTER;
+
+    *types = NULL;
+
+    if (FAILED(hr = MFCreateCollection(&collection)))
+        return hr;
+
+    if (FAILED(hr = enum_encoders(&MFT_CATEGORY_AUDIO_ENCODER, &MFMediaType_Audio, subtype, flags, &activates, &count)))
+    {
+        IMFCollection_Release(collection);
+        return hr;
+    }
+
+    for (i = 0; i < count; ++i)
+    {
+        if (SUCCEEDED(IMFActivate_ActivateObject(activates[i], &IID_IMFTransform, (void **)&transform)))
+        {
+            IMFAttributes *attributes;
+
+            if (codec_config && SUCCEEDED(IMFTransform_GetAttributes(transform, &attributes)))
+            {
+                IMFAttributes_CopyAllItems(codec_config, attributes);
+                IMFAttributes_Release(attributes);
+            }
+
+            for (index = 0; SUCCEEDED(IMFTransform_GetOutputAvailableType(transform, 0, index, &type)); ++index)
+            {
+                if (SUCCEEDED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &type_subtype))
+                        && IsEqualGUID(&type_subtype, subtype))
+                    IMFCollection_AddElement(collection, (IUnknown *)type);
+                IMFMediaType_Release(type);
+            }
+
+            IMFTransform_Release(transform);
+            IMFActivate_ShutdownObject(activates[i]);
+        }
+        IMFActivate_Release(activates[i]);
+    }
+    CoTaskMemFree(activates);
+
+    if (SUCCEEDED(hr = IMFCollection_GetElementCount(collection, &items)) && !items)
+        hr = MF_E_TRANSCODE_NO_MATCHING_ENCODER;
+
+    if (SUCCEEDED(hr))
+        *types = collection;
+    else
+        IMFCollection_Release(collection);
+
+    return hr;
+}
+
+struct encoder_activate_context
+{
+    const GUID *category;
+    const GUID *major;
+    IMFMediaType *media_type;
+    IPropertyStore *props;
+};
+
+static HRESULT encoder_activate_create_object(IMFAttributes *attributes, void *user_context, IUnknown **obj)
+{
+    struct encoder_activate_context *context = user_context;
+    IMFActivate **activates = NULL;
+    IPropertyStore *store;
+    IMFTransform *transform = NULL;
+    UINT32 count = 0, i;
+    PROPVARIANT value;
+    PROPERTYKEY key;
+    DWORD props;
+    GUID subtype;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFMediaType_GetGUID(context->media_type, &MF_MT_SUBTYPE, &subtype)))
+        return hr;
+    if (FAILED(hr = enum_encoders(context->category, context->major, &subtype, 0, &activates, &count)))
+        return hr;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (!transform && FAILED(hr = IMFActivate_ActivateObject(activates[i], &IID_IMFTransform, (void **)&transform)))
+            transform = NULL;
+        IMFActivate_Release(activates[i]);
+    }
+    CoTaskMemFree(activates);
+
+    if (!transform)
+        return MF_E_TRANSCODE_NO_MATCHING_ENCODER;
+
+    /* Hand the encoding configuration to the encoder. */
+    if (context->props && SUCCEEDED(IMFTransform_QueryInterface(transform, &IID_IPropertyStore, (void **)&store)))
+    {
+        if (SUCCEEDED(IPropertyStore_GetCount(context->props, &props)))
+        {
+            for (i = 0; i < props; ++i)
+            {
+                if (FAILED(IPropertyStore_GetAt(context->props, i, &key)))
+                    continue;
+                PropVariantInit(&value);
+                if (SUCCEEDED(IPropertyStore_GetValue(context->props, &key, &value)))
+                    IPropertyStore_SetValue(store, &key, &value);
+                PropVariantClear(&value);
+            }
+        }
+        IPropertyStore_Release(store);
+    }
+
+    *obj = (IUnknown *)transform;
+    return S_OK;
+}
+
+static void encoder_activate_shutdown_object(void *user_context, IUnknown *obj)
+{
+}
+
+static void encoder_activate_free_private(void *user_context)
+{
+    struct encoder_activate_context *context = user_context;
+
+    IMFMediaType_Release(context->media_type);
+    if (context->props)
+        IPropertyStore_Release(context->props);
+    free(context);
+}
+
+static const struct activate_funcs encoder_activate_funcs =
+{
+    encoder_activate_create_object,
+    encoder_activate_shutdown_object,
+    encoder_activate_free_private,
+};
+
+static HRESULT create_encoder_activate(const GUID *category, const GUID *major, IMFMediaType *media_type,
+        IPropertyStore *props, IMFActivate **activate)
+{
+    struct encoder_activate_context *context;
+    GUID type_major;
+    HRESULT hr;
+
+    if (!media_type || !activate)
+        return E_POINTER;
+
+    if (FAILED(hr = IMFMediaType_GetMajorType(media_type, &type_major)))
+        return hr;
+    if (!IsEqualGUID(&type_major, major))
+        return MF_E_INVALIDMEDIATYPE;
+
+    if (!(context = calloc(1, sizeof(*context))))
+        return E_OUTOFMEMORY;
+    context->category = category;
+    context->major = major;
+    context->media_type = media_type;
+    IMFMediaType_AddRef(media_type);
+    if ((context->props = props))
+        IPropertyStore_AddRef(props);
+
+    if (FAILED(hr = create_activation_object(context, &encoder_activate_funcs, activate)))
+    {
+        encoder_activate_free_private(context);
+        return hr;
+    }
+
+    IMFActivate_SetGUID(*activate, &MF_TRANSFORM_CATEGORY_Attribute, category);
+    return S_OK;
+}
+
+/***********************************************************************
+ *      MFCreateWMAEncoderActivate (mf.@)
+ */
+HRESULT WINAPI MFCreateWMAEncoderActivate(IMFMediaType *media_type, IPropertyStore *props, IMFActivate **activate)
+{
+    TRACE("%p, %p, %p.\n", media_type, props, activate);
+
+    return create_encoder_activate(&MFT_CATEGORY_AUDIO_ENCODER, &MFMediaType_Audio, media_type, props, activate);
+}
+
+/***********************************************************************
+ *      MFCreateWMVEncoderActivate (mf.@)
+ */
+HRESULT WINAPI MFCreateWMVEncoderActivate(IMFMediaType *media_type, IPropertyStore *props, IMFActivate **activate)
+{
+    TRACE("%p, %p, %p.\n", media_type, props, activate);
+
+    return create_encoder_activate(&MFT_CATEGORY_VIDEO_ENCODER, &MFMediaType_Video, media_type, props, activate);
+}
