+static HRESULT WINAPI audio_capture_stream_RequestSample(IMFMediaStream *iface, IUnknown *token)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaStream(iface);
+    struct capture_request *request;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p.\n", iface, token);
+
+    EnterCriticalSection(&source->cs);
+    if (source->state == CAPTURE_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (source->state != CAPTURE_STARTED)
+        hr = MF_E_MEDIA_SOURCE_WRONGSTATE;
+    else if (!(request = malloc(sizeof(*request))))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        if ((request->token = token))
+            IUnknown_AddRef(token);
+        list_add_tail(&source->requests, &request->entry);
+        capture_dispatch_samples(source);
+    }
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
