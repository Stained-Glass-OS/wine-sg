+struct transcode_profile
+{
+    IMFTranscodeProfile IMFTranscodeProfile_iface;
+    LONG refcount;
+    IMFAttributes *audio;
+    IMFAttributes *video;
+    IMFAttributes *container;
+    CRITICAL_SECTION cs;
+};
+
+static struct transcode_profile *impl_from_IMFTranscodeProfile(IMFTranscodeProfile *iface)
+{
+    return CONTAINING_RECORD(iface, struct transcode_profile, IMFTranscodeProfile_iface);
+}
+
+static HRESULT WINAPI transcode_profile_QueryInterface(IMFTranscodeProfile *iface, REFIID riid, void **obj)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualIID(riid, &IID_IMFTranscodeProfile) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IMFTranscodeProfile_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI transcode_profile_AddRef(IMFTranscodeProfile *iface)
+{
+    struct transcode_profile *profile = impl_from_IMFTranscodeProfile(iface);
+    ULONG refcount = InterlockedIncrement(&profile->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static ULONG WINAPI transcode_profile_Release(IMFTranscodeProfile *iface)
+{
+    struct transcode_profile *profile = impl_from_IMFTranscodeProfile(iface);
+    ULONG refcount = InterlockedDecrement(&profile->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        if (profile->audio)
+            IMFAttributes_Release(profile->audio);
+        if (profile->video)
+            IMFAttributes_Release(profile->video);
+        if (profile->container)
+            IMFAttributes_Release(profile->container);
+        DeleteCriticalSection(&profile->cs);
+        free(profile);
+    }
+
+    return refcount;
+}
+
+/* The profile keeps its own copy of the settings. */
+static HRESULT transcode_profile_set(struct transcode_profile *profile, IMFAttributes **dst, IMFAttributes *src)
+{
+    IMFAttributes *copy = NULL;
+    HRESULT hr;
+
+    if (src)
+    {
+        if (FAILED(hr = MFCreateAttributes(&copy, 0)))
+            return hr;
+        if (FAILED(hr = IMFAttributes_CopyAllItems(src, copy)))
+        {
+            IMFAttributes_Release(copy);
+            return hr;
+        }
+    }
+
+    EnterCriticalSection(&profile->cs);
+    if (*dst)
+        IMFAttributes_Release(*dst);
+    *dst = copy;
+    LeaveCriticalSection(&profile->cs);
+
+    return S_OK;
+}
+
+static HRESULT transcode_profile_get(struct transcode_profile *profile, IMFAttributes **src, IMFAttributes **dst)
+{
+    if (!dst)
+        return E_POINTER;
+
+    EnterCriticalSection(&profile->cs);
+    if ((*dst = *src))
+        IMFAttributes_AddRef(*dst);
+    LeaveCriticalSection(&profile->cs);
+
+    return S_OK;
+}
+
+static HRESULT WINAPI transcode_profile_SetAudioAttributes(IMFTranscodeProfile *iface, IMFAttributes *attrs)
+{
+    struct transcode_profile *profile = impl_from_IMFTranscodeProfile(iface);
+
+    TRACE("%p, %p.\n", iface, attrs);
+
+    return transcode_profile_set(profile, &profile->audio, attrs);
+}
+
+static HRESULT WINAPI transcode_profile_GetAudioAttributes(IMFTranscodeProfile *iface, IMFAttributes **attrs)
+{
+    struct transcode_profile *profile = impl_from_IMFTranscodeProfile(iface);
+
+    TRACE("%p, %p.\n", iface, attrs);
+
+    return transcode_profile_get(profile, &profile->audio, attrs);
+}
+
+static HRESULT WINAPI transcode_profile_SetVideoAttributes(IMFTranscodeProfile *iface, IMFAttributes *attrs)
+{
+    struct transcode_profile *profile = impl_from_IMFTranscodeProfile(iface);
+
+    TRACE("%p, %p.\n", iface, attrs);
+
+    return transcode_profile_set(profile, &profile->video, attrs);
+}
+
+static HRESULT WINAPI transcode_profile_GetVideoAttributes(IMFTranscodeProfile *iface, IMFAttributes **attrs)
+{
+    struct transcode_profile *profile = impl_from_IMFTranscodeProfile(iface);
+
+    TRACE("%p, %p.\n", iface, attrs);
+
+    return transcode_profile_get(profile, &profile->video, attrs);
+}
+
+static HRESULT WINAPI transcode_profile_SetContainerAttributes(IMFTranscodeProfile *iface, IMFAttributes *attrs)
+{
+    struct transcode_profile *profile = impl_from_IMFTranscodeProfile(iface);
+
+    TRACE("%p, %p.\n", iface, attrs);
+
+    return transcode_profile_set(profile, &profile->container, attrs);
+}
+
+static HRESULT WINAPI transcode_profile_GetContainerAttributes(IMFTranscodeProfile *iface, IMFAttributes **attrs)
+{
+    struct transcode_profile *profile = impl_from_IMFTranscodeProfile(iface);
+
+    TRACE("%p, %p.\n", iface, attrs);
+
+    return transcode_profile_get(profile, &profile->container, attrs);
+}
+
+static const IMFTranscodeProfileVtbl transcode_profile_vtbl =
+{
+    transcode_profile_QueryInterface,
+    transcode_profile_AddRef,
+    transcode_profile_Release,
+    transcode_profile_SetAudioAttributes,
+    transcode_profile_GetAudioAttributes,
+    transcode_profile_SetVideoAttributes,
+    transcode_profile_GetVideoAttributes,
+    transcode_profile_SetContainerAttributes,
+    transcode_profile_GetContainerAttributes,
+};
