+/***********************************************************************
+ *      MFCreateTranscodeProfile (mf.@)
+ */
+HRESULT WINAPI MFCreateTranscodeProfile(IMFTranscodeProfile **profile)
+{
+    struct transcode_profile *object;
+
+    TRACE("%p.\n", profile);
+
+    if (!profile)
+        return E_POINTER;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->IMFTranscodeProfile_iface.lpVtbl = &transcode_profile_vtbl;
+    object->refcount = 1;
+    InitializeCriticalSection(&object->cs);
+
+    *profile = &object->IMFTranscodeProfile_iface;
+    return S_OK;
+}
