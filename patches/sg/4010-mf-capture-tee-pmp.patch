+/***********************************************************************
+ *      MFCreatePMPMediaSession (mf.@)
+ */
+HRESULT WINAPI MFCreatePMPMediaSession(DWORD flags, IMFAttributes *config, IMFMediaSession **session,
+        IMFActivate **enabler_activate)
+{
+    TRACE("%#lx, %p, %p, %p.\n", flags, config, session, enabler_activate);
+
+    if (!session)
+        return E_POINTER;
+
+    /* There is no protected media path process here: the session always runs
+     * unprotected in the caller's process, so no content enabler is ever needed. */
+    if (enabler_activate)
+        *enabler_activate = NULL;
+
+    return MFCreateMediaSession(config, session);
+}
+
+struct pmp_server
+{
+    IMFPMPServer IMFPMPServer_iface;
+    LONG refcount;
+    LONG locks;
+};
+
+static struct pmp_server *impl_from_IMFPMPServer(IMFPMPServer *iface)
+{
+    return CONTAINING_RECORD(iface, struct pmp_server, IMFPMPServer_iface);
+}
+
+static HRESULT WINAPI pmp_server_QueryInterface(IMFPMPServer *iface, REFIID riid, void **obj)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualIID(riid, &IID_IMFPMPServer) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IMFPMPServer_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI pmp_server_AddRef(IMFPMPServer *iface)
+{
+    struct pmp_server *server = impl_from_IMFPMPServer(iface);
+    ULONG refcount = InterlockedIncrement(&server->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static ULONG WINAPI pmp_server_Release(IMFPMPServer *iface)
+{
+    struct pmp_server *server = impl_from_IMFPMPServer(iface);
+    ULONG refcount = InterlockedDecrement(&server->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+        free(server);
+
+    return refcount;
+}
+
+static HRESULT WINAPI pmp_server_LockProcess(IMFPMPServer *iface)
+{
+    struct pmp_server *server = impl_from_IMFPMPServer(iface);
+
+    TRACE("%p.\n", iface);
+
+    InterlockedIncrement(&server->locks);
+    return S_OK;
+}
+
+static HRESULT WINAPI pmp_server_UnlockProcess(IMFPMPServer *iface)
+{
+    struct pmp_server *server = impl_from_IMFPMPServer(iface);
+
+    TRACE("%p.\n", iface);
+
+    if (InterlockedDecrement(&server->locks) < 0)
+    {
+        InterlockedIncrement(&server->locks);
+        return MF_E_INVALIDREQUEST;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI pmp_server_CreateObjectByCLSID(IMFPMPServer *iface, REFCLSID clsid, REFIID riid, void **obj)
+{
+    TRACE("%p, %s, %s, %p.\n", iface, debugstr_guid(clsid), debugstr_guid(riid), obj);
+
+    if (!obj)
+        return E_POINTER;
+
+    /* The server lives in the caller's process, objects are created in place. */
+    return CoCreateInstance(clsid, NULL, CLSCTX_INPROC_SERVER, riid, obj);
+}
+
+static const IMFPMPServerVtbl pmp_server_vtbl =
+{
+    pmp_server_QueryInterface,
+    pmp_server_AddRef,
+    pmp_server_Release,
+    pmp_server_LockProcess,
+    pmp_server_UnlockProcess,
+    pmp_server_CreateObjectByCLSID,
+};
+
+/***********************************************************************
+ *      MFCreatePMPServer (mf.@)
+ */
+HRESULT WINAPI MFCreatePMPServer(DWORD flags, IMFPMPServer **server)
+{
+    struct pmp_server *object;
+
+    TRACE("%#lx, %p.\n", flags, server);
+
+    if (!server)
+        return E_POINTER;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->IMFPMPServer_iface.lpVtbl = &pmp_server_vtbl;
+    object->refcount = 1;
+
+    *server = &object->IMFPMPServer_iface;
+    return S_OK;
+}
