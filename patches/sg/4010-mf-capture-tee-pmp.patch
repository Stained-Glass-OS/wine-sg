+static void tee_node_deliver_sample(struct media_session *session, struct topo_node *topo_node, IMFSample *sample)
+{
+    struct topo_node *down_node;
+    struct tee_output *output;
+    DWORD i, input;
+
+    if (!sample)
+        topo_node->u.tee.pending = 0; /* end of stream answers every request */
+    else if (topo_node->u.tee.pending)
+        topo_node->u.tee.pending--;
+
+    for (i = 0; i < topo_node->u.tee.output_count; ++i)
+    {
+        output = &topo_node->u.tee.outputs[i];
+        if (!(down_node = session_get_topo_node_output(session, topo_node, i, &input)))
+            continue;
+
+        if (output->requests)
+        {
+            output->requests--;
+            session_deliver_sample_to_node(session, down_node, input, sample);
+        }
+        else if (!sample)
+            output->end_of_stream = TRUE;
+        else
+            TRACE("Dropping sample %p on tee %p output %lu.\n", sample, topo_node, i);
+    }
+}
