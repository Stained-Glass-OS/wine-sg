+/* Audio capture media source: one live PCM stream read from a WASAPI capture
+ * endpoint in shared mode. Samples are produced on a worker thread as the
+ * endpoint delivers data and handed out on RequestSample(). */
+
+enum capture_state
+{
+    CAPTURE_STOPPED,
+    CAPTURE_STARTED,
+    CAPTURE_SHUT_DOWN,
+};
+
+struct capture_request
+{
+    struct list entry;
+    IUnknown *token;
+};
+
+struct capture_sample
+{
+    struct list entry;
+    IMFSample *sample;
+};
+
+struct audio_capture_source
+{
+    IMFMediaSource IMFMediaSource_iface;
+    IMFMediaStream IMFMediaStream_iface;
+    LONG refcount;
+
+    IMFMediaEventQueue *event_queue;
+    IMFMediaEventQueue *stream_queue;
+    IMFPresentationDescriptor *pd;
+    IMFStreamDescriptor *sd;
+
+    IMMDevice *device;
+    IAudioClient *client;
+    IAudioCaptureClient *capture;
+    WAVEFORMATEX *format;
+    HANDLE buffer_event;
+    HANDLE thread;
+    BOOL thread_exit;
+    BOOL stream_announced;
+
+    enum capture_state state;
+    struct list requests;
+    struct list samples;
+    unsigned int sample_count;
+    UINT64 frames;
+    LONGLONG start_time;
+
+    CRITICAL_SECTION cs;
+};
+
+/* At most about a second of audio is kept while nobody asks for it. */
+#define CAPTURE_MAX_QUEUED_SAMPLES 100
+
+static struct audio_capture_source *impl_from_IMFMediaSource(IMFMediaSource *iface)
+{
+    return CONTAINING_RECORD(iface, struct audio_capture_source, IMFMediaSource_iface);
+}
+
+static struct audio_capture_source *impl_from_IMFMediaStream(IMFMediaStream *iface)
+{
+    return CONTAINING_RECORD(iface, struct audio_capture_source, IMFMediaStream_iface);
+}
+
+static void capture_drop_requests(struct audio_capture_source *source)
+{
+    struct capture_request *request, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(request, next, &source->requests, struct capture_request, entry)
+    {
+        list_remove(&request->entry);
+        if (request->token)
+            IUnknown_Release(request->token);
+        free(request);
+    }
+}
+
+static void capture_drop_samples(struct audio_capture_source *source)
+{
+    struct capture_sample *sample, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(sample, next, &source->samples, struct capture_sample, entry)
+    {
+        list_remove(&sample->entry);
+        IMFSample_Release(sample->sample);
+        free(sample);
+    }
+    source->sample_count = 0;
+}
+
+/* Called with the lock held: match queued samples with pending requests. */
+static void capture_dispatch_samples(struct audio_capture_source *source)
+{
+    struct capture_request *request;
+    struct capture_sample *sample;
+    struct list *r, *s;
+
+    while ((r = list_head(&source->requests)) && (s = list_head(&source->samples)))
+    {
+        request = LIST_ENTRY(r, struct capture_request, entry);
+        sample = LIST_ENTRY(s, struct capture_sample, entry);
+        list_remove(&request->entry);
+        list_remove(&sample->entry);
+        source->sample_count--;
+
+        if (request->token)
+            IMFSample_SetUnknown(sample->sample, &MFSampleExtension_Token, request->token);
+        IMFMediaEventQueue_QueueEventParamUnk(source->stream_queue, MEMediaSample, &GUID_NULL, S_OK,
+                (IUnknown *)sample->sample);
+
+        if (request->token)
+            IUnknown_Release(request->token);
+        IMFSample_Release(sample->sample);
+        free(request);
+        free(sample);
+    }
+}
+
+static HRESULT capture_read_packets(struct audio_capture_source *source)
+{
+    UINT32 frames, packet_frames, block_align = source->format->nBlockAlign;
+    struct capture_sample *entry;
+    IMFMediaBuffer *buffer;
+    IMFSample *sample;
+    DWORD flags;
+    BYTE *data, *dst;
+    HRESULT hr;
+
+    while (SUCCEEDED(hr = IAudioCaptureClient_GetNextPacketSize(source->capture, &packet_frames)) && packet_frames)
+    {
+        if (FAILED(hr = IAudioCaptureClient_GetBuffer(source->capture, &data, &frames, &flags, NULL, NULL)))
+            return hr;
+
+        if (SUCCEEDED(hr = MFCreateMemoryBuffer(frames * block_align, &buffer)))
+        {
+            if (SUCCEEDED(hr = IMFMediaBuffer_Lock(buffer, &dst, NULL, NULL)))
+            {
+                if (flags & AUDCLNT_BUFFERFLAGS_SILENT)
+                    memset(dst, 0, frames * block_align);
+                else
+                    memcpy(dst, data, frames * block_align);
+                IMFMediaBuffer_Unlock(buffer);
+                hr = IMFMediaBuffer_SetCurrentLength(buffer, frames * block_align);
+            }
+            if (SUCCEEDED(hr) && SUCCEEDED(hr = MFCreateSample(&sample)))
+            {
+                IMFSample_AddBuffer(sample, buffer);
+                IMFSample_SetSampleTime(sample, source->start_time
+                        + MFllMulDiv(source->frames, 10000000, source->format->nSamplesPerSec, 0));
+                IMFSample_SetSampleDuration(sample, MFllMulDiv(frames, 10000000, source->format->nSamplesPerSec, 0));
+                if (flags & AUDCLNT_BUFFERFLAGS_DATA_DISCONTINUITY || !source->frames)
+                    IMFSample_SetUINT32(sample, &MFSampleExtension_Discontinuity, 1);
+
+                if ((entry = malloc(sizeof(*entry))))
+                {
+                    entry->sample = sample;
+                    list_add_tail(&source->samples, &entry->entry);
+                    if (++source->sample_count > CAPTURE_MAX_QUEUED_SAMPLES)
+                    {
+                        entry = LIST_ENTRY(list_head(&source->samples), struct capture_sample, entry);
+                        list_remove(&entry->entry);
+                        IMFSample_Release(entry->sample);
+                        free(entry);
+                        source->sample_count--;
+                    }
+                }
+                else
+                    IMFSample_Release(sample);
+            }
+            IMFMediaBuffer_Release(buffer);
+        }
+        source->frames += frames;
+
+        IAudioCaptureClient_ReleaseBuffer(source->capture, frames);
+        if (FAILED(hr))
+            return hr;
+    }
+
+    return hr;
+}
+
+static DWORD WINAPI capture_thread_proc(void *arg)
+{
+    struct audio_capture_source *source = arg;
+    HRESULT hr;
+
+    for (;;)
+    {
+        WaitForSingleObject(source->buffer_event, 20);
+
+        EnterCriticalSection(&source->cs);
+        if (source->thread_exit)
+        {
+            LeaveCriticalSection(&source->cs);
+            break;
+        }
+        if (source->state == CAPTURE_STARTED)
+        {
+            if (FAILED(hr = capture_read_packets(source)))
+            {
+                WARN("Failed to read capture data, hr %#lx.\n", hr);
+                if (hr == AUDCLNT_E_DEVICE_INVALIDATED)
+                    hr = MF_E_AUDIO_RECORDING_DEVICE_INVALIDATED;
+                IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MEError, &GUID_NULL, hr, NULL);
+                IAudioClient_Stop(source->client);
+                source->state = CAPTURE_STOPPED;
+            }
+            else
+                capture_dispatch_samples(source);
+        }
+        LeaveCriticalSection(&source->cs);
+    }
+
+    return 0;
+}
+
+static HRESULT WINAPI audio_capture_source_QueryInterface(IMFMediaSource *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFMediaSource) || IsEqualIID(riid, &IID_IMFMediaEventGenerator)
+            || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFMediaSource_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI audio_capture_source_AddRef(IMFMediaSource *iface)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+    ULONG refcount = InterlockedIncrement(&source->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static void audio_capture_source_release_resources(struct audio_capture_source *source)
+{
+    if (source->thread)
+    {
+        EnterCriticalSection(&source->cs);
+        source->thread_exit = TRUE;
+        LeaveCriticalSection(&source->cs);
+        SetEvent(source->buffer_event);
+        WaitForSingleObject(source->thread, INFINITE);
+        CloseHandle(source->thread);
+        source->thread = NULL;
+    }
+    if (source->client)
+    {
+        IAudioClient_Stop(source->client);
+        IAudioClient_Release(source->client);
+        source->client = NULL;
+    }
+    if (source->capture)
+    {
+        IAudioCaptureClient_Release(source->capture);
+        source->capture = NULL;
+    }
+    capture_drop_requests(source);
+    capture_drop_samples(source);
+}
+
+static ULONG WINAPI audio_capture_source_Release(IMFMediaSource *iface)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+    ULONG refcount = InterlockedDecrement(&source->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        audio_capture_source_release_resources(source);
+        if (source->event_queue)
+        {
+            IMFMediaEventQueue_Shutdown(source->event_queue);
+            IMFMediaEventQueue_Release(source->event_queue);
+        }
+        if (source->stream_queue)
+        {
+            IMFMediaEventQueue_Shutdown(source->stream_queue);
+            IMFMediaEventQueue_Release(source->stream_queue);
+        }
+        if (source->pd)
+            IMFPresentationDescriptor_Release(source->pd);
+        if (source->sd)
+            IMFStreamDescriptor_Release(source->sd);
+        if (source->device)
+            IMMDevice_Release(source->device);
+        if (source->buffer_event)
+            CloseHandle(source->buffer_event);
+        CoTaskMemFree(source->format);
+        source->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&source->cs);
+        free(source);
+    }
+
+    return refcount;
+}
+
+static HRESULT WINAPI audio_capture_source_GetEvent(IMFMediaSource *iface, DWORD flags, IMFMediaEvent **event)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+
+    TRACE("%p, %#lx, %p.\n", iface, flags, event);
+
+    return IMFMediaEventQueue_GetEvent(source->event_queue, flags, event);
+}
+
+static HRESULT WINAPI audio_capture_source_BeginGetEvent(IMFMediaSource *iface, IMFAsyncCallback *callback,
+        IUnknown *state)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+
+    TRACE("%p, %p, %p.\n", iface, callback, state);
+
+    return IMFMediaEventQueue_BeginGetEvent(source->event_queue, callback, state);
+}
+
+static HRESULT WINAPI audio_capture_source_EndGetEvent(IMFMediaSource *iface, IMFAsyncResult *result,
+        IMFMediaEvent **event)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+
+    TRACE("%p, %p, %p.\n", iface, result, event);
+
+    return IMFMediaEventQueue_EndGetEvent(source->event_queue, result, event);
+}
+
+static HRESULT WINAPI audio_capture_source_QueueEvent(IMFMediaSource *iface, MediaEventType event_type,
+        REFGUID ext_type, HRESULT hr, const PROPVARIANT *value)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+
+    TRACE("%p, %lu, %s, %#lx, %p.\n", iface, event_type, debugstr_guid(ext_type), hr, value);
+
+    return IMFMediaEventQueue_QueueEventParamVar(source->event_queue, event_type, ext_type, hr, value);
+}
+
+static HRESULT WINAPI audio_capture_source_GetCharacteristics(IMFMediaSource *iface, DWORD *characteristics)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p.\n", iface, characteristics);
+
+    if (!characteristics)
+        return E_POINTER;
+
+    EnterCriticalSection(&source->cs);
+    if (source->state == CAPTURE_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+        *characteristics = MFMEDIASOURCE_IS_LIVE;
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI audio_capture_source_CreatePresentationDescriptor(IMFMediaSource *iface,
+        IMFPresentationDescriptor **pd)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, pd);
+
+    if (!pd)
+        return E_POINTER;
+
+    EnterCriticalSection(&source->cs);
+    if (source->state == CAPTURE_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+        hr = IMFPresentationDescriptor_Clone(source->pd, pd);
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI audio_capture_source_Start(IMFMediaSource *iface, IMFPresentationDescriptor *pd,
+        const GUID *time_format, const PROPVARIANT *start_position)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+    IMFStreamDescriptor *sd;
+    PROPVARIANT value;
+    BOOL selected;
+    HRESULT hr;
+
+    TRACE("%p, %p, %s, %p.\n", iface, pd, debugstr_guid(time_format), start_position);
+
+    if (!pd)
+        return E_INVALIDARG;
+    if (time_format && !IsEqualGUID(time_format, &GUID_NULL))
+        return MF_E_UNSUPPORTED_TIME_FORMAT;
+    if (start_position && start_position->vt != VT_EMPTY && start_position->vt != VT_I8)
+        return MF_E_UNSUPPORTED_TIME_FORMAT;
+
+    if (FAILED(hr = IMFPresentationDescriptor_GetStreamDescriptorByIndex(pd, 0, &selected, &sd)))
+        return MF_E_INVALIDREQUEST;
+    IMFStreamDescriptor_Release(sd);
+
+    EnterCriticalSection(&source->cs);
+
+    if (source->state == CAPTURE_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (source->state == CAPTURE_STARTED)
+    {
+        /* A live source cannot seek; a second Start is a no-op restart. */
+        value.vt = VT_I8;
+        value.hVal.QuadPart = source->start_time;
+        IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourceStarted, &GUID_NULL, S_OK, &value);
+        if (selected)
+            IMFMediaEventQueue_QueueEventParamVar(source->stream_queue, MEStreamStarted, &GUID_NULL, S_OK, &value);
+    }
+    else if (SUCCEEDED(hr = IAudioClient_Start(source->client)))
+    {
+        source->state = CAPTURE_STARTED;
+        source->frames = 0;
+        source->start_time = start_position && start_position->vt == VT_I8 ? start_position->hVal.QuadPart : 0;
+        capture_drop_samples(source);
+
+        if (selected)
+        {
+            IMFMediaEventQueue_QueueEventParamUnk(source->event_queue,
+                    source->stream_announced ? MEUpdatedStream : MENewStream, &GUID_NULL, S_OK,
+                    (IUnknown *)&source->IMFMediaStream_iface);
+            source->stream_announced = TRUE;
+        }
+
+        value.vt = VT_I8;
+        value.hVal.QuadPart = source->start_time;
+        IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourceStarted, &GUID_NULL, S_OK, &value);
+        if (selected)
+            IMFMediaEventQueue_QueueEventParamVar(source->stream_queue, MEStreamStarted, &GUID_NULL, S_OK, &value);
+        SetEvent(source->buffer_event);
+    }
+
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI audio_capture_source_Stop(IMFMediaSource *iface)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&source->cs);
+    if (source->state == CAPTURE_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        if (source->state == CAPTURE_STARTED)
+        {
+            IAudioClient_Stop(source->client);
+            IAudioClient_Reset(source->client);
+        }
+        source->state = CAPTURE_STOPPED;
+        capture_drop_requests(source);
+        capture_drop_samples(source);
+        IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourceStopped, &GUID_NULL, S_OK, NULL);
+        if (source->stream_announced)
+            IMFMediaEventQueue_QueueEventParamVar(source->stream_queue, MEStreamStopped, &GUID_NULL, S_OK, NULL);
+    }
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI audio_capture_source_Pause(IMFMediaSource *iface)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+    HRESULT hr;
+
+    TRACE("%p.\n", iface);
+
+    /* A live capture source does not have MFMEDIASOURCE_CAN_PAUSE. */
+    EnterCriticalSection(&source->cs);
+    hr = source->state == CAPTURE_SHUT_DOWN ? MF_E_SHUTDOWN : MF_E_INVALID_STATE_TRANSITION;
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI audio_capture_source_Shutdown(IMFMediaSource *iface)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&source->cs);
+    if (source->state == CAPTURE_SHUT_DOWN)
+    {
+        LeaveCriticalSection(&source->cs);
+        return MF_E_SHUTDOWN;
+    }
+    source->state = CAPTURE_SHUT_DOWN;
+    LeaveCriticalSection(&source->cs);
+
+    audio_capture_source_release_resources(source);
+    IMFMediaEventQueue_Shutdown(source->event_queue);
+    IMFMediaEventQueue_Shutdown(source->stream_queue);
+
+    return S_OK;
+}
+
+static const IMFMediaSourceVtbl audio_capture_source_vtbl =
+{
+    audio_capture_source_QueryInterface,
+    audio_capture_source_AddRef,
+    audio_capture_source_Release,
+    audio_capture_source_GetEvent,
+    audio_capture_source_BeginGetEvent,
+    audio_capture_source_EndGetEvent,
