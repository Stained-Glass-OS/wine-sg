+static HRESULT session_update_node_attributes(IMFTopology *topology, DWORD count,
+        const MFTOPONODE_ATTRIBUTE_UPDATE *updates)
+{
+    IMFTopologyNode *node;
+    HRESULT hr = S_OK;
+    DWORD i;
+
+    /* Validate everything first, so a bad entry leaves the topology unchanged. */
+    for (i = 0; i < count; ++i)
+    {
+        if (updates[i].attrType != MF_ATTRIBUTE_UINT32 && updates[i].attrType != MF_ATTRIBUTE_UINT64
+                && updates[i].attrType != MF_ATTRIBUTE_DOUBLE)
+            return E_INVALIDARG;
+        if (FAILED(hr = IMFTopology_GetNodeByID(topology, updates[i].NodeId, &node)))
+            return hr;
+        IMFTopologyNode_Release(node);
+    }
+
+    for (i = 0; i < count && SUCCEEDED(hr); ++i)
+    {
+        if (FAILED(hr = IMFTopology_GetNodeByID(topology, updates[i].NodeId, &node)))
+            break;
+
+        switch (updates[i].attrType)
+        {
+            case MF_ATTRIBUTE_UINT32:
+                hr = IMFTopologyNode_SetUINT32(node, &updates[i].guidAttributeKey, updates[i].u32);
+                break;
+            case MF_ATTRIBUTE_UINT64:
+                hr = IMFTopologyNode_SetUINT64(node, &updates[i].guidAttributeKey, updates[i].u64);
+                break;
+            default:
+                hr = IMFTopologyNode_SetDouble(node, &updates[i].guidAttributeKey, updates[i].d);
+                break;
+        }
+
+        IMFTopologyNode_Release(node);
+    }
+
+    return hr;
+}
