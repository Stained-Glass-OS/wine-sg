From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: stand-in characters for the icon font's other glyphs

Text in the icon font (Segoe MDL2 Assets or Segoe Fluent Icons) on a system without it already drew the Symbol values as standard characters; the font's other code points showed as empty boxes. A table of 45 more of them (Up, Down, the chevrons, Search, Refresh, Cancel, CheckMark, Warning, Error, the window buttons and more; code points by their names in the public icon reference) now gives each a standard character too, and a fallback list naming the icon font ("Segoe Fluent Icons, Segoe MDL2 Assets") is recognised. NanaZip's address bar Up button and drop-down chevron show arrows. Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/buttons.c b/dlls/windows.ui.xaml/buttons.c
index bcf256f..5f601d9 100644
--- a/dlls/windows.ui.xaml/buttons.c
+++ b/dlls/windows.ui.xaml/buttons.c
@@ -132,9 +132,50 @@ UINT32 xaml_symbol_fallback( UINT32 code )
 {
     unsigned int i;
     for (i = 0; i < ARRAY_SIZE(symbols); i++) if (symbols[i].value == code) return symbols[i].fallback;
+#ifndef SG_MUTANT_XAML_NO_GLYPH_STANDINS
+    /* the icon font's other code points (FontIcon glyphs, text in the icon font) */
+    {
+        unsigned int lo = 0, hi = ARRAY_SIZE(glyphs);
+        while (lo < hi)
+        {
+            unsigned int mid = (lo + hi) / 2;
+            if (glyphs[mid].value == code) return glyphs[mid].fallback;
+            if (glyphs[mid].value < code) lo = mid + 1;
+            else hi = mid;
+        }
+    }
+#endif
     return 0;
 }
 
+/* a font family names the icon font (Segoe MDL2 Assets or Segoe Fluent Icons, alone or in a list of
+ * fallbacks) and none of its fonts is installed: its glyphs are drawn as standard characters */
+BOOL xaml_is_missing_icon_font( const WCHAR *family )
+{
+    const WCHAR *p = family, *end;
+    BOOL icon = FALSE;
+    WCHAR one[64];
+
+    while (p && *p)
+    {
+        size_t len;
+        while (*p == ' ' || *p == ',') p++;
+        if (!*p) break;
+        end = wcschr( p, ',' );
+        len = end ? end - p : wcslen( p );
+        while (len && p[len - 1] == ' ') len--;
+        if (len && len < ARRAY_SIZE(one))
+        {
+            memcpy( one, p, len * sizeof(WCHAR) );
+            one[len] = 0;
+            if (xaml_font_installed( one )) return FALSE;
+            if (!wcsicmp( one, L"Segoe MDL2 Assets" ) || !wcsicmp( one, L"Segoe Fluent Icons" )) icon = TRUE;
+        }
+        p = end;
+    }
+    return icon;
+}
+
 /* the font symbols are drawn with: the symbol font, else one with the standard characters standing in */
 const WCHAR *xaml_symbol_font(void)
 {
