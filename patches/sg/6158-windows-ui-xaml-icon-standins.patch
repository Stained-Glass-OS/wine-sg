 #!/usr/bin/env python3
 # Stained Glass OS: generates symbols.h from symbols.txt -- Symbol names, their code points, and the
-# standard characters drawn in their place when the symbol font is missing.
-#   make_symbols.py symbols.txt symbols.h
+# standard characters drawn in their place when the symbol font is missing -- and from glyphs.txt,
+# the icon font's other code points with their standard characters.
+#   make_symbols.py symbols.txt glyphs.txt symbols.h
 import sys
 rows = [l.split() for l in open(sys.argv[1]) if l.strip() and not l.startswith('#')]
-out = ['/* generated by make_symbols.py from symbols.txt -- do not edit */', '',
+glyphs = [l.split() for l in open(sys.argv[2]) if l.strip() and not l.startswith('#')]
+values = {int(v) for n, v, fb in rows}
+out = ['/* generated by make_symbols.py from symbols.txt and glyphs.txt -- do not edit */', '',
        'static const struct { const WCHAR *name; UINT32 value; UINT32 fallback; } symbols[] =', '{']
 out += ['    { L"%s", 0x%x, 0x%s },' % (n, int(v), fb) for n, v, fb in rows]
+out += ['};', '', '/* sorted by code point */',
+        'static const struct { UINT32 value; UINT32 fallback; } glyphs[] =', '{']
+out += ['    { 0x%x, 0x%s }, /* %s */' % (int(v, 16), fb, n)
+        for n, v, fb in sorted(glyphs, key=lambda g: int(g[1], 16)) if int(v, 16) not in values]
 out += ['};', '']
-open(sys.argv[2], 'w').write('\n'.join(out))
+open(sys.argv[3], 'w').write('\n'.join(out))
