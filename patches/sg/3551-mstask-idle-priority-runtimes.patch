+static HRESULT WINAPI MSTASK_ITask_GetNextRunTime(ITask *iface, SYSTEMTIME *rt)
+{
+    SYSTEMTIME now;
+
+    TRACE("(%p, %p)\n", iface, rt);
+
+    GetLocalTime(&now);
+    return task_next_run_time(impl_from_ITask(iface), &now, rt);
+}
+
+static HRESULT WINAPI MSTASK_ITask_GetRunTimes(
+        ITask* iface,
+        const LPSYSTEMTIME pstBegin,
+        const LPSYSTEMTIME pstEnd,
+        WORD *pCount,
+        LPSYSTEMTIME *rgstTaskTimes)
+{
+    TaskImpl *This = impl_from_ITask(iface);
+    SYSTEMTIME from, next, *times;
+    FILETIME ft, end_ft;
+    WORD max, n = 0;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %p, %p, %p)\n", iface, pstBegin, pstEnd, pCount, rgstTaskTimes);
+
+    if (!pstBegin || !pCount || !rgstTaskTimes || !*pCount) return E_INVALIDARG;
+    max = *pCount;
+    *rgstTaskTimes = NULL;
+    *pCount = 0;
+
+    if (pstEnd)
+    {
+        SystemTimeToFileTime(pstEnd, &end_ft);
+        SystemTimeToFileTime(pstBegin, &ft);
+        if (CompareFileTime(&end_ft, &ft) < 0) return E_INVALIDARG;
+    }
+    if (!(times = CoTaskMemAlloc(max * sizeof(*times)))) return E_OUTOFMEMORY;
+
+    from = *pstBegin;
+    while (n < max)
+    {
+        hr = task_next_run_time(This, &from, &next);
+        if (hr != S_OK) break;
+        if (pstEnd)
+        {
+            SystemTimeToFileTime(&next, &ft);
+            if (CompareFileTime(&ft, &end_ft) > 0) break;
+        }
+        times[n++] = next;
+        /* continue one minute after this run */
+        SystemTimeToFileTime(&next, &ft);
+        filetime_add_ms(&ft, 60 * 1000);
+        FileTimeToSystemTime(&ft, &from);
+    }
+    if (!n)
+    {
+        CoTaskMemFree(times);
+        return hr == S_OK || hr == SCHED_S_TASK_NO_VALID_TRIGGERS || hr == SCHED_S_EVENT_TRIGGER ? S_OK : hr;
+    }
+    *pCount = n;
+    *rgstTaskTimes = times;
+    return S_OK;
+}
