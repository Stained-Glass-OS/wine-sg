+/* an English description of the trigger, like "At 9:00 AM every day, starting 3/1/2005" */
+HRESULT trigger_to_string(const TASK_TRIGGER *t, WCHAR **out)
+{
+    static const WCHAR *days[] = { L"Sun", L"Mon", L"Tue", L"Wed", L"Thu", L"Fri", L"Sat" };
+    WCHAR buf[512], time[64] = L"", date[64] = L"", *p = buf;
+    SYSTEMTIME st = {0};
+    int i, n;
+
+    st.wYear = t->wBeginYear ? t->wBeginYear : 2000;
+    st.wMonth = t->wBeginMonth ? t->wBeginMonth : 1;
+    st.wDay = t->wBeginDay ? t->wBeginDay : 1;
+    st.wHour = t->wStartHour;
+    st.wMinute = t->wStartMinute;
+    GetTimeFormatW(LOCALE_USER_DEFAULT, TIME_NOSECONDS, &st, NULL, time, ARRAY_SIZE(time));
+    GetDateFormatW(LOCALE_USER_DEFAULT, DATE_SHORTDATE, &st, NULL, date, ARRAY_SIZE(date));
+
+    switch (t->TriggerType)
+    {
+    case TASK_TIME_TRIGGER_ONCE:
+        swprintf(buf, ARRAY_SIZE(buf), L"At %s on %s", time, date);
+        break;
+    case TASK_TIME_TRIGGER_DAILY:
+        if (t->Type.Daily.DaysInterval <= 1)
+            swprintf(buf, ARRAY_SIZE(buf), L"At %s every day, starting %s", time, date);
+        else
+            swprintf(buf, ARRAY_SIZE(buf), L"At %s every %u days, starting %s", time, t->Type.Daily.DaysInterval, date);
+        break;
+    case TASK_TIME_TRIGGER_WEEKLY:
+        n = swprintf(p, ARRAY_SIZE(buf), L"At %s every ", time);
+        p += n;
+        for (i = 0; i < 7; i++)
+            if (t->Type.Weekly.rgfDaysOfTheWeek & (1 << i)) p += swprintf(p, 8, p == buf + n ? L"%s" : L", %s", days[i]);
+        if (t->Type.Weekly.WeeksInterval > 1)
+            p += swprintf(p, 40, L" of every %u weeks", t->Type.Weekly.WeeksInterval);
+        swprintf(p, 64, L", starting %s", date);
+        break;
+    case TASK_TIME_TRIGGER_MONTHLYDATE:
+        swprintf(buf, ARRAY_SIZE(buf), L"At %s on selected days of selected months, starting %s", time, date);
+        break;
+    case TASK_TIME_TRIGGER_MONTHLYDOW:
+        swprintf(buf, ARRAY_SIZE(buf), L"At %s on selected weekdays of selected months, starting %s", time, date);
+        break;
+    case TASK_EVENT_TRIGGER_ON_IDLE:
+        lstrcpyW(buf, L"When the computer is idle");
+        break;
+    case TASK_EVENT_TRIGGER_AT_SYSTEMSTART:
+        lstrcpyW(buf, L"At system startup");
+        break;
+    case TASK_EVENT_TRIGGER_AT_LOGON:
+        lstrcpyW(buf, L"At log on");
+        break;
+    default:
+        return E_FAIL;
+    }
+    if (!(*out = CoTaskMemAlloc((lstrlenW(buf) + 1) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    lstrcpyW(*out, buf);
+    return S_OK;
+}
