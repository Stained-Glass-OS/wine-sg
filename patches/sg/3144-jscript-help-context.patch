From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 02:02:15 -0700
Subject: [PATCH] jscript: help file and help context in the error info

A host exception filled in through pfnDeferredFillIn (or given directly) can
carry a help file and a help context; IActiveScriptError::GetExceptionInfo now
returns them. Removes the todo_wine for them in run.c.

diff --git a/dlls/jscript/engine.h b/dlls/jscript/engine.h
index d36eba5..558a75a 100644
--- a/dlls/jscript/engine.h
+++ b/dlls/jscript/engine.h
@@ -258,6 +258,8 @@ struct _jsexcept_t {
     jsstr_t *source;
     jsstr_t *message;
     jsstr_t *line;
+    jsstr_t *help_file;
+    DWORD help_context;
 
     bytecode_t *code;
     unsigned loc;
diff --git a/dlls/jscript/error.c b/dlls/jscript/error.c
index c32b5b0..1e4db8f 100644
--- a/dlls/jscript/error.c
+++ b/dlls/jscript/error.c
@@ -419,6 +419,11 @@ void handle_dispatch_exception(script_ctx_t *ctx, EXCEPINFO *ei)
         ctx->ei->source = jsstr_alloc_len(ei->bstrSource, SysStringLen(ei->bstrSource));
     if(ei->bstrDescription)
         ctx->ei->message = jsstr_alloc_len(ei->bstrDescription, SysStringLen(ei->bstrDescription));
+#ifndef SG_MUTANT_JS_NOHELP
+    if(ei->bstrHelpFile)
+        ctx->ei->help_file = jsstr_alloc_len(ei->bstrHelpFile, SysStringLen(ei->bstrHelpFile));
+    ctx->ei->help_context = ei->dwHelpContext;
+#endif
     SysFreeString(ei->bstrSource);
     SysFreeString(ei->bstrDescription);
     SysFreeString(ei->bstrHelpFile);
diff --git a/dlls/jscript/jscript.c b/dlls/jscript/jscript.c
index 8b05b17..f8ff4d3 100644
--- a/dlls/jscript/jscript.c
+++ b/dlls/jscript/jscript.c
@@ -260,6 +260,9 @@ static HRESULT WINAPI JScriptError_GetExceptionInfo(IActiveScriptError *iface, E
         jsstr_to_bstr(This->ei.source, &excepinfo->bstrSource);
     if(This->ei.message)
         jsstr_to_bstr(This->ei.message, &excepinfo->bstrDescription);
+    if(This->ei.help_file)
+        jsstr_to_bstr(This->ei.help_file, &excepinfo->bstrHelpFile);
+    excepinfo->dwHelpContext = This->ei.help_context;
     return S_OK;
 }
 
@@ -340,6 +343,11 @@ void reset_ei(jsexcept_t *ei)
         jsstr_release(ei->line);
         ei->line = NULL;
     }
+    if(ei->help_file) {
+        jsstr_release(ei->help_file);
+        ei->help_file = NULL;
+    }
+    ei->help_context = 0;
 }
 
 void enter_script(script_ctx_t *ctx, jsexcept_t *ei)
diff --git a/dlls/jscript/tests/run.c b/dlls/jscript/tests/run.c
index e85e774..0f90c24 100644
--- a/dlls/jscript/tests/run.c
+++ b/dlls/jscript/tests/run.c
@@ -2456,9 +2456,7 @@ static void test_error_reports(void)
             E_FAIL, 0, 1,
             L"source after defer",
             L"desc after defer",
-            L"help after defer", 1234567890,
-            NULL,
-            ERROR_TODO_HELPFILE
+            L"help after defer", 1234567890
         },
         {
             L"switch(2) {\n"
