+/* the picture as a file, made from the picture in memory: a bitmap as a
+ * BMP (or in the format it was loaded in when the original format is
+ * kept), an icon as an .ico, a metafile as a placeable metafile, an
+ * enhanced metafile as an .emf */
+static HRESULT OLEPicture_Serialize(OLEPictureImpl *This, void **buf, unsigned int *len)
+{
+    *buf = NULL;
+    *len = 0;
+    switch (This->desc.picType)
+    {
+    case PICTYPE_BITMAP:
+        if (This->keepOrigFormat)
+        {
+            switch (This->loadtime_format)
+            {
+            case BITMAP_FORMAT_JPEG:
+                return serializeWIC(This->desc.bmp.hbitmap, &GUID_ContainerFormatJpeg, buf, len);
+            case BITMAP_FORMAT_GIF:
+                return serializeWIC(This->desc.bmp.hbitmap, &GUID_ContainerFormatGif, buf, len);
+            case BITMAP_FORMAT_PNG:
+                return serializeWIC(This->desc.bmp.hbitmap, &GUID_ContainerFormatPng, buf, len);
+            }
+        }
+        return serializeBMP(This->desc.bmp.hbitmap, buf, len);
+    case PICTYPE_ICON:
+        return serializeIcon(This->desc.icon.hicon, buf, len) ? S_OK : E_FAIL;
+    case PICTYPE_METAFILE:
+#ifdef SG_MUTANT_NO_METAFILE_SAVE
+        return E_NOTIMPL;
+#endif
+        return serializeAPM(This, buf, len);
+    case PICTYPE_ENHMETAFILE:
+        return serializeEMF(This->desc.emf.hemf, buf, len);
+    case PICTYPE_NONE:
+    case PICTYPE_UNINITIALIZED:
+        return S_OK;
+    default:
+        WARN("unknown picture type %d\n", This->desc.picType);
+        return E_UNEXPECTED;
+    }
+}
