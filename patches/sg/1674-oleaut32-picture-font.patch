+/* encodes a bitmap in a WIC container format (the format it was loaded in) */
+static HRESULT serializeWIC(HBITMAP hbmp, const GUID *container, void **buffer, unsigned int *length)
+{
+    IWICImagingFactory *factory = NULL;
+    IWICBitmap *bitmap = NULL;
+    IWICBitmapEncoder *encoder = NULL;
+    IWICBitmapFrameEncode *frame = NULL;
+    IStream *stream = NULL;
+    HGLOBAL hglobal;
+    STATSTG stat;
+    HRESULT hr, init;
+    void *mem;
+
+    init = CoInitialize(NULL);
+    hr = CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IWICImagingFactory,
+                          (void **)&factory);
+    if (SUCCEEDED(hr)) hr = IWICImagingFactory_CreateBitmapFromHBITMAP(factory, hbmp, NULL, WICBitmapIgnoreAlpha,
+                                                                       &bitmap);
+    if (SUCCEEDED(hr)) hr = IWICImagingFactory_CreateEncoder(factory, container, NULL, &encoder);
+    if (SUCCEEDED(hr)) hr = CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    if (SUCCEEDED(hr)) hr = IWICBitmapEncoder_Initialize(encoder, stream, WICBitmapEncoderNoCache);
+    if (SUCCEEDED(hr)) hr = IWICBitmapEncoder_CreateNewFrame(encoder, &frame, NULL);
+    if (SUCCEEDED(hr)) hr = IWICBitmapFrameEncode_Initialize(frame, NULL);
+    if (SUCCEEDED(hr)) hr = IWICBitmapFrameEncode_WriteSource(frame, (IWICBitmapSource *)bitmap, NULL);
+    if (SUCCEEDED(hr)) hr = IWICBitmapFrameEncode_Commit(frame);
+    if (SUCCEEDED(hr)) hr = IWICBitmapEncoder_Commit(encoder);
+    if (SUCCEEDED(hr)) hr = IStream_Stat(stream, &stat, STATFLAG_NONAME);
+    if (SUCCEEDED(hr)) hr = GetHGlobalFromStream(stream, &hglobal);
+    if (SUCCEEDED(hr))
+    {
+        *length = stat.cbSize.LowPart;
+        if (!(*buffer = malloc(*length)))
+            hr = E_OUTOFMEMORY;
+        else
+        {
+            mem = GlobalLock(hglobal);
+            memcpy(*buffer, mem, *length);
+            GlobalUnlock(hglobal);
+        }
+    }
+    if (frame) IWICBitmapFrameEncode_Release(frame);
+    if (encoder) IWICBitmapEncoder_Release(encoder);
+    if (stream) IStream_Release(stream);
+    if (bitmap) IWICBitmap_Release(bitmap);
+    if (factory) IWICImagingFactory_Release(factory);
+    if (SUCCEEDED(init)) CoUninitialize();
+    return hr;
+}
+
+/* a metafile as a placeable metafile (the header gives its size) */
+static HRESULT serializeAPM(OLEPictureImpl *This, void **buffer, unsigned int *length)
+{
+    APM_HEADER *header;
+    UINT bits = GetMetaFileBitsEx(This->desc.wmf.hmeta, 0, NULL);
+    LONG cx = This->himetricWidth, cy = This->himetricHeight;
+    WORD inch = 2540, *word, sum = 0;
+    int i;
+
+    if (!bits) return E_FAIL;
+    while (inch > 1 && (MulDiv(abs(cx), inch, 2540) > 32767 || MulDiv(abs(cy), inch, 2540) > 32767)) inch /= 2;
+    *length = sizeof(*header) + bits;
+    if (!(*buffer = calloc(1, *length))) return E_OUTOFMEMORY;
+    header = *buffer;
+    header->key = 0x9ac6cdd7;
+    header->right = MulDiv(cx, inch, 2540);
+    header->bottom = MulDiv(cy, inch, 2540);
+    header->inch = inch;
+    for (word = (WORD *)header, i = 0; i < 10; i++) sum ^= word[i];
+    header->checksum = sum;
+    GetMetaFileBitsEx(This->desc.wmf.hmeta, bits, header + 1);
+    return S_OK;
+}
+
+static HRESULT serializeEMF(HENHMETAFILE hemf, void **buffer, unsigned int *length)
+{
+    UINT size = GetEnhMetaFileBits(hemf, 0, NULL);
+
+    if (!size) return E_FAIL;
+    if (!(*buffer = malloc(size))) return E_OUTOFMEMORY;
+    *length = GetEnhMetaFileBits(hemf, size, *buffer);
+    return S_OK;
+}
