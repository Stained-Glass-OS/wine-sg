+/* the image of an icon file nearest the size asked for (OleLoadPictureEx's,
+ * or the system's icon size), then the colours asked for: as few as
+ * LP_MONOCHROME or LP_VGACOLOR ask, else (LP_COLOR, LP_DEFAULT) the most */
+static int choose_icon_entry(OLEPictureImpl *This, const CURSORICONFILEDIR *cifd, ULONG size)
+{
+    int want_cx = This->load_cx ? This->load_cx : GetSystemMetrics(SM_CXICON);
+    int want_cy = This->load_cy ? This->load_cy : GetSystemMetrics(SM_CYICON);
+    int want_bpp = (This->load_flags & LP_MONOCHROME) ? 1 : (This->load_flags & LP_VGACOLOR) ? 4 :
+                   (This->load_flags & LP_COLOR) ? 8 : 32;
+    int i, best = 0, best_size = INT_MAX, best_depth = INT_MAX;
+
+#ifdef SG_MUTANT_ICON_FIRST
+    return 0;
+#endif
+    for (i = 0; i < cifd->idCount; i++)
+    {
+        const CURSORICONFILEDIRENTRY *entry = &cifd->idEntries[i];
+        int cx = entry->bWidth ? entry->bWidth : 256, cy = entry->bHeight ? entry->bHeight : 256;
+        int bpp = 0, size_diff, depth_diff;
+
+        if ((BYTE *)(entry + 1) > (BYTE *)cifd + size) break;
+        if (entry->dwDIBOffset + sizeof(BITMAPINFOHEADER) <= size)
+        {
+            const BITMAPINFOHEADER *bih = (const BITMAPINFOHEADER *)((const BYTE *)cifd + entry->dwDIBOffset);
+            if (bih->biSize == sizeof(BITMAPINFOHEADER)) bpp = bih->biBitCount;
+        }
+        if (!bpp) bpp = entry->bColorCount == 2 ? 1 : entry->bColorCount == 16 ? 4 : 8;
+        size_diff = abs(cx - want_cx) + abs(cy - want_cy);
+        /* more colours than asked for are worse than fewer for the small
+         * palettes; for the most colours, the most there are */
+        depth_diff = want_bpp == 32 ? 32 - bpp : abs(bpp - want_bpp);
+        if (size_diff < best_size || (size_diff == best_size && depth_diff < best_depth))
+        {
+            best = i;
+            best_size = size_diff;
+            best_depth = depth_diff;
+        }
+    }
+    return best;
+}
