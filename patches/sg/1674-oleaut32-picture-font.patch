+/************************************************************************
+ * IEnumConnectionPoints over a container's fixed connection points
+ * (Stained Glass OS 1674: the standard font's and picture's
+ * EnumConnectionPoints were stubs)
+ */
+typedef struct
+{
+    IEnumConnectionPoints IEnumConnectionPoints_iface;
+    LONG ref;
+    IUnknown *container;
+    IConnectionPoint **points;
+    ULONG count, pos;
+} EnumConnectionPointsImpl;
+
+static inline EnumConnectionPointsImpl *impl_from_IEnumConnectionPoints(IEnumConnectionPoints *iface)
+{
+    return CONTAINING_RECORD(iface, EnumConnectionPointsImpl, IEnumConnectionPoints_iface);
+}
+
+static HRESULT WINAPI EnumConnectionPoints_QueryInterface(IEnumConnectionPoints *iface, REFIID riid, void **out)
+{
+    if (!out) return E_POINTER;
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumConnectionPoints))
+    {
+        *out = iface;
+        IEnumConnectionPoints_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EnumConnectionPoints_AddRef(IEnumConnectionPoints *iface)
+{
+    EnumConnectionPointsImpl *This = impl_from_IEnumConnectionPoints(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI EnumConnectionPoints_Release(IEnumConnectionPoints *iface)
+{
+    EnumConnectionPointsImpl *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG ref = InterlockedDecrement(&This->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) IConnectionPoint_Release(This->points[i]);
+        IUnknown_Release(This->container);
+        free(This->points);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI EnumConnectionPoints_Next(IEnumConnectionPoints *iface, ULONG count,
+                                                IConnectionPoint **points, ULONG *fetched)
+{
+    EnumConnectionPointsImpl *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG got = 0;
+
+    TRACE("(%p)->(%lu, %p, %p)\n", This, count, points, fetched);
+
+    if (!points) return E_POINTER;
+    if (count > 1 && !fetched) return E_POINTER;
+    while (got < count && This->pos < This->count)
+    {
+        points[got] = This->points[This->pos++];
+        IConnectionPoint_AddRef(points[got]);
+        got++;
+    }
+    if (fetched) *fetched = got;
+    return got == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumConnectionPoints_Skip(IEnumConnectionPoints *iface, ULONG count)
+{
+    EnumConnectionPointsImpl *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG left = This->count - This->pos;
+
+    TRACE("(%p)->(%lu)\n", This, count);
+
+    This->pos += min(left, count);
+    return count <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumConnectionPoints_Reset(IEnumConnectionPoints *iface)
+{
+    EnumConnectionPointsImpl *This = impl_from_IEnumConnectionPoints(iface);
+
+    TRACE("(%p)\n", This);
+    This->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumConnectionPoints_Clone(IEnumConnectionPoints *iface, IEnumConnectionPoints **out)
+{
+    EnumConnectionPointsImpl *This = impl_from_IEnumConnectionPoints(iface);
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, out);
+
+    if (!out) return E_POINTER;
+    hr = CreateConnectionPointEnum(This->container, This->points, This->count, out);
+    if (SUCCEEDED(hr)) impl_from_IEnumConnectionPoints(*out)->pos = This->pos;
+    return hr;
+}
+
+static const IEnumConnectionPointsVtbl EnumConnectionPointsVtbl =
+{
+    EnumConnectionPoints_QueryInterface,
+    EnumConnectionPoints_AddRef,
+    EnumConnectionPoints_Release,
+    EnumConnectionPoints_Next,
+    EnumConnectionPoints_Skip,
+    EnumConnectionPoints_Reset,
+    EnumConnectionPoints_Clone,
+};
+
+HRESULT CreateConnectionPointEnum(IUnknown *container, IConnectionPoint **points, ULONG count,
+                                  IEnumConnectionPoints **out)
+{
+    EnumConnectionPointsImpl *This;
+    ULONG i;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    if (count && !(This->points = malloc(count * sizeof(*This->points))))
+    {
+        free(This);
+        return E_OUTOFMEMORY;
+    }
+    This->IEnumConnectionPoints_iface.lpVtbl = &EnumConnectionPointsVtbl;
+    This->ref = 1;
+    This->container = container;
+    IUnknown_AddRef(container);
+    This->count = count;
+    for (i = 0; i < count; i++)
+    {
+        This->points[i] = points[i];
+        IConnectionPoint_AddRef(points[i]);
+    }
+    *out = &This->IEnumConnectionPoints_iface;
+    return S_OK;
+}
