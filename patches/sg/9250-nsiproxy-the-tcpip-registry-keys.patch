+static const WCHAR params_path[] = L"System\\CurrentControlSet\\Services\\Tcpip\\Parameters";
+static const WCHAR interfaces_path[] = L"System\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces";
+static const WCHAR network_path[] = L"System\\CurrentControlSet\\Control\\Network\\{4D36E972-E325-11CE-BFC1-08002BE10318}";
+static const WCHAR class_path[] = L"System\\CurrentControlSet\\Control\\Class\\{4D36E972-E325-11CE-BFC1-08002BE10318}";
+static const WCHAR enum_path[] = L"System\\CurrentControlSet\\Enum";
+static const WCHAR net_class_guid[] = L"{4d36e972-e325-11ce-bfc1-08002be10318}";
+/* nsiproxy's adapter GUIDs end in "NetDev" (ndis.c) */
+static const WCHAR netdev_guid_tail[] = L"-4E6574446576}";
