+
+static void add_addr( UINT *list, UINT *count, UINT max, const char *text )
+{
+    struct in_addr in;
+    UINT i;
+
+    if (*count >= max || inet_pton( AF_INET, text, &in ) != 1 || !in.s_addr) return;
+    for (i = 0; i < *count; i++) if (list[i] == in.s_addr) return;
+    list[(*count)++] = in.s_addr;
+}
+
+static void add_addr_list( UINT *list, UINT *count, UINT max, char *text )
+{
+    char *tok, *save = NULL;
+
+    for (tok = strtok_r( text, " ,\t", &save ); tok; tok = strtok_r( NULL, " ,\t", &save ))
+        add_addr( list, count, max, tok );
+}
+
+static void copy_str( char *dst, const char *src, size_t size )
+{
+    snprintf( dst, size, "%s", src );
+}
+
+static char *trim( char *s )
+{
+    char *end;
+
+    while (*s == ' ' || *s == '\t') s++;
+    end = s + strlen( s );
+    while (end > s && (end[-1] == '\n' || end[-1] == '\r' || end[-1] == ' ' || end[-1] == '\t')) *--end = 0;
+    return s;
+}
+
+/* NetworkManager keeps each device's state, the DHCPv4 lease's options among it, in a file
+ * anyone may read: /run/NetworkManager/devices/<ifindex>, a [dhcp4] section with
+ * dhcp4.<option>=<value> lines. A device NetworkManager manages without that section has no
+ * lease: a fixed address, or none. */
+static BOOL read_nm_device( UINT index, struct nsi_dhcp4_info *info )
+{
+    char path[64], line[1024], *value;
+    BOOL in_dhcp4 = FALSE, managed = FALSE;
+    LONGLONG expiry = 0;
+    FILE *f;
+
+#ifdef SG_MUTANT_TCPIPREG_NO_NM
+    return FALSE;
+#endif
+    snprintf( path, sizeof(path), "/run/NetworkManager/devices/%u", index );
+    if (!(f = fopen( path, "r" ))) return FALSE;
+    while (fgets( line, sizeof(line), f ))
+    {
+        char *l = trim( line );
+
+        if (*l == '[')
+        {
+            in_dhcp4 = !strcmp( l, "[dhcp4]" );
+            if (in_dhcp4) info->dhcp = TRUE;
+            continue;
+        }
+        if (!(value = strchr( l, '=' ))) continue;
+        *value++ = 0;
+        value = trim( value );
+        if (!in_dhcp4)
+        {
+            if (!strcmp( l, "managed" )) managed = !strcmp( value, "true" );
+            continue;
+        }
+        if (!strcmp( l, "dhcp4.dhcp_server_identifier" ))
+        {
+            UINT count = 0;
+            add_addr( &info->server, &count, 1, value );
+        }
+        else if (!strcmp( l, "dhcp4.dhcp_lease_time" )) info->lease_time = strtoul( value, NULL, 10 );
+        else if (!strcmp( l, "dhcp4.expiry" )) expiry = strtoll( value, NULL, 10 );
+        else if (!strcmp( l, "dhcp4.domain_name_servers" ))
+            add_addr_list( info->dns, &info->dns_count, ARRAY_SIZE(info->dns), value );
+        else if (!strcmp( l, "dhcp4.domain_name" ))
+        {
+            char *sp = strpbrk( value, " \t" );
+            if (sp) *sp = 0;   /* Windows' DhcpDomain is one name (option 15) */
+            copy_str( info->domain, value, sizeof(info->domain) );
+        }
+    }
+    fclose( f );
+    if (!managed && !info->dhcp) return FALSE;
+    info->source = info->dhcp ? 1 : 2;
+    if (expiry)
+    {
+        info->expires = expiry;
+        if (info->lease_time) info->obtained = expiry - info->lease_time;
+    }
+    return TRUE;
+}
+
+/* systemd-networkd's lease of an interface it runs DHCP on: /run/systemd/netif/leases/<ifindex>,
+ * KEY=value lines; the file is (re)written when the lease is obtained or renewed */
+static BOOL read_networkd_lease( UINT index, struct nsi_dhcp4_info *info )
+{
+    char path[64], line[1024], *value;
+    struct stat st;
+    FILE *f;
+
+    snprintf( path, sizeof(path), "/run/systemd/netif/leases/%u", index );
+    if (!(f = fopen( path, "r" ))) return FALSE;
+    if (!fstat( fileno( f ), &st )) info->obtained = st.st_mtime;
+    while (fgets( line, sizeof(line), f ))
+    {
+        char *l = trim( line );
+
+        if (!(value = strchr( l, '=' ))) continue;
+        *value++ = 0;
+        if (!strcmp( l, "SERVER_ADDRESS" ))
+        {
+            UINT count = 0;
+            add_addr( &info->server, &count, 1, value );
+        }
+        else if (!strcmp( l, "LIFETIME" )) info->lease_time = strtoul( value, NULL, 10 );
+        else if (!strcmp( l, "DNS" )) add_addr_list( info->dns, &info->dns_count, ARRAY_SIZE(info->dns), value );
+        else if (!strcmp( l, "DOMAINNAME" )) copy_str( info->domain, value, sizeof(info->domain) );
+    }
+    fclose( f );
+    info->dhcp = TRUE;
+    info->source = 3;
+    if (info->obtained && info->lease_time) info->expires = info->obtained + info->lease_time;
+    return TRUE;
+}
+
+#ifdef HAVE_LINUX_RTNETLINK_H
+/* Without a DHCP client's own record, the kernel tells: a DHCP client gives the address it leased
+ * the lease's lifetime, a fixed address is permanent (IFA_F_PERMANENT, "valid_lft forever"). */
+static BOOL read_address_lifetimes( UINT index, struct nsi_dhcp4_info *info )
+{
+    struct
+    {
+        struct nlmsghdr hdr;
+        struct ifaddrmsg msg;
+    } req;
+    char buffer[16384];
+    BOOL found = FALSE, done = FALSE;
+    struct timespec now, mono;
+    int fd, len;
+
+    if ((fd = socket( AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_ROUTE )) < 0) return FALSE;
+    memset( &req, 0, sizeof(req) );
+    req.hdr.nlmsg_len = NLMSG_LENGTH( sizeof(req.msg) );
+    req.hdr.nlmsg_type = RTM_GETADDR;
+    req.hdr.nlmsg_flags = NLM_F_REQUEST | NLM_F_DUMP;
+    req.msg.ifa_family = AF_INET;
+    if (send( fd, &req, req.hdr.nlmsg_len, 0 ) < 0)
+    {
+        close( fd );
+        return FALSE;
+    }
+    clock_gettime( CLOCK_REALTIME, &now );
+    clock_gettime( CLOCK_MONOTONIC, &mono );
+    while (!done && (len = recv( fd, buffer, sizeof(buffer), 0 )) > 0)
+    {
+        struct nlmsghdr *nlh;
+
+        for (nlh = (struct nlmsghdr *)buffer; NLMSG_OK( nlh, len ); nlh = NLMSG_NEXT( nlh, len ))
+        {
+            struct ifaddrmsg *ifa = NLMSG_DATA( nlh );
+            struct ifa_cacheinfo *ci = NULL;
+            UINT flags, attr_len;
+            LONGLONG elapsed;
+            struct rtattr *rta;
+
+            if (nlh->nlmsg_type == NLMSG_DONE || nlh->nlmsg_type == NLMSG_ERROR) { done = TRUE; break; }
+            if (nlh->nlmsg_type != RTM_NEWADDR || ifa->ifa_index != index || found) continue;
+            flags = ifa->ifa_flags;
+            attr_len = IFA_PAYLOAD( nlh );
+            for (rta = IFA_RTA( ifa ); RTA_OK( rta, attr_len ); rta = RTA_NEXT( rta, attr_len ))
+            {
+                if (rta->rta_type == IFA_FLAGS) flags = *(UINT *)RTA_DATA( rta );
+                else if (rta->rta_type == IFA_CACHEINFO) ci = RTA_DATA( rta );
+            }
+            if (ifa->ifa_scope != RT_SCOPE_UNIVERSE && ifa->ifa_scope != RT_SCOPE_SITE) continue;
+            found = TRUE;
+            if (flags & IFA_F_PERMANENT || !ci || ci->ifa_valid == ~0u) continue;
+            /* tstamp: when the address was last updated (the lease obtained or renewed), in hundredths
+             * of a second of the monotonic clock; its valid lifetime counts down from then */
+            elapsed = mono.tv_sec - (LONGLONG)ci->tstamp / 100;
+            if (elapsed < 0) elapsed = 0;
+            info->dhcp = TRUE;
+            info->obtained = now.tv_sec - elapsed;
+            info->expires = now.tv_sec + ci->ifa_valid;
+            info->lease_time = ci->ifa_valid + elapsed;
+        }
+    }
+    close( fd );
+    if (found) info->source = 4;
+    return found;
+}
+#else
+static BOOL read_address_lifetimes( UINT index, struct nsi_dhcp4_info *info )
+{
+    return FALSE;
+}
+#endif
+
+/* the name servers and search domains of a resolv.conf */
+static BOOL read_resolv_conf( const char *path, UINT *list, UINT *count, UINT max, char *search, UINT search_size )
+{
+    char line[1024];
+    FILE *f;
+
+    if (!(f = fopen( path, "r" ))) return FALSE;
+    *count = 0;
+    if (search) *search = 0;
+    while (fgets( line, sizeof(line), f ))
+    {
+        char *l = trim( line );
+
+        if (!strncmp( l, "nameserver", 10 ) && (l[10] == ' ' || l[10] == '\t'))
+            add_addr( list, count, max, trim( l + 11 ) );
+        else if (search && !strncmp( l, "search", 6 ) && (l[6] == ' ' || l[6] == '\t'))
+            copy_str( search, trim( l + 7 ), search_size );
+    }
+    fclose( f );
+    return TRUE;
+}
+
+/* The system's own name servers. Behind systemd-resolved's stub (127.0.0.53, 127.0.0.54) they are
+ * the ones resolved forwards to, which it lists in /run/systemd/resolve/resolv.conf. */
+static void read_system_dns( struct nsi_dhcp4_info *info )
+{
+    UINT i, stub = 0, list[ARRAY_SIZE(info->system_dns)], count = 0;
+    char search[sizeof(info->search)];
+
+    if (!read_resolv_conf( "/etc/resolv.conf", info->system_dns, &info->system_dns_count,
+                           ARRAY_SIZE(info->system_dns), info->search, sizeof(info->search) ))
+        return;
+    for (i = 0; i < info->system_dns_count; i++)
+        if (info->system_dns[i] == IPV4_ADDR( 127, 0, 0, 53 ) || info->system_dns[i] == IPV4_ADDR( 127, 0, 0, 54 ))
+            stub++;
+    if (stub && stub == info->system_dns_count &&
+        read_resolv_conf( "/run/systemd/resolve/resolv.conf", list, &count, ARRAY_SIZE(list), search, sizeof(search) ))
+    {
+        memcpy( info->system_dns, list, count * sizeof(*list) );
+        info->system_dns_count = count;
+        if (!info->search[0] || !strcmp( info->search, "." )) strcpy( info->search, search );
+    }
+    if (!strcmp( info->search, "." )) info->search[0] = 0;
+}
+
+static BOOL read_hex_file( const char *dir, const char *name, UINT *value )
+{
+    char path[PATH_MAX], buf[32];
+    FILE *f;
+    BOOL ret = FALSE;
+
+    snprintf( path, sizeof(path), "%s/%s", dir, name );
+    if (!(f = fopen( path, "r" ))) return FALSE;
+    if (fgets( buf, sizeof(buf), f )) { *value = strtoul( buf, NULL, 16 ); ret = TRUE; }
+    fclose( f );
+    return ret;
+}
+
+/* the bus device behind an interface, for its Plug and Play device instance ID */
+static void read_hardware( UINT index, struct nsi_dhcp4_info *info )
+{
+    char name[IF_NAMESIZE], dir[PATH_MAX], real[PATH_MAX], *base;
+    UINT value;
+
+    if (!if_indextoname( index, name )) return;
+    snprintf( dir, sizeof(dir), "/sys/class/net/%s/wireless", name );
+    info->wireless = !access( dir, F_OK );
+    snprintf( dir, sizeof(dir), "/sys/class/net/%s/device", name );
+    if (!realpath( dir, real )) return;
+    base = strrchr( real, '/' ) + 1;
+    if (read_hex_file( real, "vendor", &value ) && read_hex_file( real, "device", &info->hw_device ))
+    {
+        info->bus = 1; /* PCI */
+        info->hw_vendor = value;
+        read_hex_file( real, "subsystem_vendor", &info->hw_subvendor );
+        read_hex_file( real, "subsystem_device", &info->hw_subdevice );
+        read_hex_file( real, "revision", &info->hw_revision );
+        copy_str( info->hw_location, base, sizeof(info->hw_location) );
+        return;
+    }
+    /* a USB interface: the device's ids are one directory up */
+    if ((base = strrchr( real, '/' ))) *base = 0;
+    if (read_hex_file( real, "idVendor", &value ) && read_hex_file( real, "idProduct", &info->hw_device ))
+    {
+        info->bus = 2; /* USB */
+        info->hw_vendor = value;
+        copy_str( info->hw_location, strrchr( real, '/' ) + 1, sizeof(info->hw_location) );
+    }
+}
+
+NTSTATUS unix_nsi_get_dhcp4_info( void *args )
+{
+    struct nsi_get_dhcp4_info_params *params = args;
+    struct nsi_dhcp4_info *info = params->info;
+
+    memset( info, 0, sizeof(*info) );
+    if (!read_nm_device( params->if_index, info ) && !read_networkd_lease( params->if_index, info ))
+        read_address_lifetimes( params->if_index, info );
+    read_system_dns( info );
+    read_hardware( params->if_index, info );
+    TRACE( "if %u: source %u dhcp %u server %08x lease %u dns %u system dns %u bus %u\n", params->if_index,
+           info->source, info->dhcp, info->server, info->lease_time, info->dns_count, info->system_dns_count, info->bus );
+    return STATUS_SUCCESS;
+}
--- a/dlls/nsiproxy.sys/nsi.c
+++ b/dlls/nsiproxy.sys/nsi.c
@@ -294,4 +294,5 @@
     unix_nsi_get_all_parameters_ex,
     unix_nsi_get_parameter_ex,
     unix_nsi_get_notification,
+    unix_nsi_get_dhcp4_info,
 };
--- a/dlls/nsiproxy.sys/nsiproxy_private.h
+++ b/dlls/nsiproxy.sys/nsiproxy_private.h
@@ -91,3 +91,37 @@
     NPI_MODULEID module;
     UINT32 table;
 };
+
+/* Stained Glass OS: an interface's IPv4 configuration as the Linux side has it (dhcp.c), for the
+ * TCP/IP registry keys (tcpipreg.c) */
+struct nsi_dhcp4_info
+{
+    UINT source;            /* 0 nothing known, 1 NetworkManager lease, 2 NetworkManager without one,
+                               3 networkd lease, 4 the address's lifetime */
+    BOOL dhcp;
+    UINT server;            /* the DHCP server, network order; 0 unknown */
+    UINT lease_time;        /* seconds */
+    LONGLONG obtained;      /* Unix times; 0 unknown */
+    LONGLONG expires;
+    UINT dns[4];            /* the lease's name servers */
+    UINT dns_count;
+    char domain[256];       /* the lease's domain name */
+    UINT system_dns[8];     /* the name servers the system uses (behind a local stub: its upstreams) */
+    UINT system_dns_count;
+    char search[512];       /* the system's search domains */
+    BOOL wireless;
+    UINT bus;               /* the device behind the interface: 0 none (virtual), 1 PCI, 2 USB */
+    UINT hw_vendor, hw_device, hw_subvendor, hw_subdevice, hw_revision;
+    char hw_location[64];   /* the bus address: PCI 0000:04:00.0, USB 1-2 */
+};
+
+struct nsi_get_dhcp4_info_params
+{
+    UINT if_index;
+    struct nsi_dhcp4_info *info;
+};
+
+/* PE side (device.c, tcpipreg.c) */
+NTSTATUS nsiproxy_get_dhcp4_info( UINT if_index, struct nsi_dhcp4_info *info );
+void tcpip_registry_start( void );
+void tcpip_registry_changed( const NPI_MODULEID *module, UINT table );
--- /dev/null
+++ b/dlls/nsiproxy.sys/tcpipreg.c
@@ -0,0 +1,598 @@
+/*
+ * nsiproxy.sys: the TCP/IP registry keys, as Windows' TCP/IP driver and DHCP client keep them.
+ * Stained Glass OS.
+ *
+ * Windows keeps each adapter's IPv4 configuration under
+ * HKLM\System\CurrentControlSet\Services\Tcpip\Parameters\Interfaces\{adapter GUID}: EnableDHCP,
+ * the fixed IPAddress/SubnetMask/DefaultGateway/NameServer or the lease's DhcpIPAddress,
+ * DhcpSubnetMask, DhcpServer, DhcpDefaultGateway, DhcpNameServer, DhcpDomain and lease times, and
+ * updates them whenever the network changes. Programs read them directly: dnspython (Electrum,
+ * many Python programs) takes its name servers from there, after checking that the adapter's
+ * device (Control\Network\{4D36E972-...}\{GUID}\Connection PnpInstanceID, then Enum\<id>
+ * ConfigFlags) is not disabled; others find the adapters' NetCfgInstanceId and characteristics
+ * under Control\Class\{4D36E972-...}. Nothing wrote any of it: dnspython failed with
+ * FileNotFoundError.
+ *
+ * nsiproxy is the machine's TCP/IP driver here (it runs once per prefix, for the shared prefix
+ * as SYSTEM), so it keeps the keys: at start, when an address, route or interface changes (its
+ * netlink notifications), and every two minutes. The adapters and their GUIDs are the ones
+ * GetAdaptersAddresses reports; whether an address is leased, and the lease's server, times,
+ * name servers and domain come from the Linux side (dhcp.c). Values are only written when they
+ * change, so a program that watches the keys (RegNotifyChangeKeyValue) hears of real changes.
+ * Keys of adapters that are gone are removed (only those of nsiproxy's own adapter GUIDs).
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
