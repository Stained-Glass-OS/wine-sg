+#define MAX_ADAPTERS 64
+
+/* a REG_MULTI_SZ or a separated list being built */
+struct text_list
+{
+    WCHAR buf[1024];
+    unsigned int len;
+    unsigned int count;
+};
+
+static void list_add( struct text_list *list, const WCHAR *str, WCHAR sep )
+{
+    unsigned int n = wcslen( str );
+
+    if (list->len + n + 2 >= ARRAY_SIZE(list->buf)) return;
+    if (sep && list->count) list->buf[list->len++] = sep;
+    memcpy( list->buf + list->len, str, n * sizeof(WCHAR) );
+    list->len += n;
+    if (!sep) list->len++;  /* REG_MULTI_SZ: keep the terminator */
+    list->buf[list->len] = 0;
+    list->count++;
+}
+
+static void ipv4_text( UINT addr, WCHAR *buf, unsigned int size )
+{
+    const BYTE *b = (const BYTE *)&addr;
+    swprintf( buf, size, L"%u.%u.%u.%u", b[0], b[1], b[2], b[3] );
+}
+
+static UINT prefix_mask( unsigned int len )
+{
+    return len ? RtlUlongByteSwap( ~0u << (32 - min( len, 32 )) ) : 0;
+}
+
+static void set_value( HKEY key, const WCHAR *name, DWORD type, const void *data, DWORD size )
+{
+    BYTE old[4096];
+    DWORD old_type, old_size = sizeof(old);
+
+    if (!RegQueryValueExW( key, name, NULL, &old_type, old, &old_size ) && old_type == type &&
+        old_size == size && !memcmp( old, data, size ))
+        return;
+    RegSetValueExW( key, name, 0, type, data, size );
+}
+
+static void set_sz( HKEY key, const WCHAR *name, const WCHAR *str )
+{
+    set_value( key, name, REG_SZ, str, (wcslen( str ) + 1) * sizeof(WCHAR) );
+}
+
+static void set_dword( HKEY key, const WCHAR *name, DWORD value )
+{
+    set_value( key, name, REG_DWORD, &value, sizeof(value) );
+}
+
+/* a time worked out from the address's lifetime moves by a second between two reads of the clocks:
+ * kept when it is that close, so that nothing changes when nothing did */
+static void set_dword_near( HKEY key, const WCHAR *name, DWORD value, BOOL near )
+{
+    DWORD old, type, size = sizeof(old);
+
+    if (near && !RegQueryValueExW( key, name, NULL, &type, (BYTE *)&old, &size ) && type == REG_DWORD &&
+        old - value + 2 <= 4)
+        return;
+    set_dword( key, name, value );
+}
+
+static void set_multi( HKEY key, const WCHAR *name, const struct text_list *list )
+{
+    if (!list->count) RegDeleteValueW( key, name );
+    else set_value( key, name, REG_MULTI_SZ, list->buf, (list->len + 1) * sizeof(WCHAR) );
+}
+
+static void set_multi1( HKEY key, const WCHAR *name, const WCHAR *str )
+{
+    struct text_list list = {{0}};
+    list_add( &list, str, 0 );
+    set_multi( key, name, &list );
+}
+
+static void delete_values( HKEY key, const WCHAR *const *names )
+{
+    for (; *names; names++) RegDeleteValueW( key, *names );
+}
+
+static BOOL get_dword( HKEY key, const WCHAR *name, DWORD *value )
+{
+    DWORD type, size = sizeof(*value);
+    return !RegQueryValueExW( key, name, NULL, &type, (BYTE *)value, &size ) && type == REG_DWORD;
+}
+
+static BOOL get_sz( HKEY key, const WCHAR *name, WCHAR *buf, DWORD len )
+{
+    DWORD type, size = len * sizeof(WCHAR);
+    if (RegQueryValueExW( key, name, NULL, &type, (BYTE *)buf, &size ) || type != REG_SZ) return FALSE;
+    buf[min( size / sizeof(WCHAR), len - 1 )] = 0;
+    return TRUE;
+}
+
+static HKEY create_key( HKEY root, const WCHAR *path )
+{
+    HKEY key;
+    if (RegCreateKeyExW( root, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL )) return NULL;
+    return key;
+}
+
+static BOOL is_netdev_guid( const WCHAR *name )
+{
+    unsigned int len = wcslen( name ), tail = wcslen( netdev_guid_tail );
+    return len == 38 && name[0] == '{' && !wcsicmp( name + len - tail, netdev_guid_tail );
+}
+
+static DWORD unix_time_dword( LONGLONG t )
+{
+    return t > 0 && t < 0xffffffff ? (DWORD)t : 0;
+}
+
+static const WCHAR *const static_values[] = { L"IPAddress", L"SubnetMask", L"DefaultGateway", NULL };
+static const WCHAR *const lease_values[] =
+{
+    L"DhcpIPAddress", L"DhcpSubnetMask", L"DhcpSubnetMaskOpt", L"DhcpServer", L"Lease", L"LeaseObtainedTime",
+    L"LeaseTerminatesTime", L"T1", L"T2", L"DhcpDefaultGateway", L"DhcpNameServer", L"DhcpDomain", NULL
+};
+
+/* an adapter on DHCP without a lease (no address, the cable out): what Windows shows after the
+ * lease is released */
+static void set_released( HKEY key )
+{
+    static const WCHAR *const gone[] =
+    {
+        L"DhcpSubnetMaskOpt", L"Lease", L"LeaseObtainedTime", L"LeaseTerminatesTime", L"T1", L"T2",
+        L"DhcpDefaultGateway", L"DhcpNameServer", L"DhcpDomain", NULL
+    };
+    set_dword( key, L"EnableDHCP", 1 );
+    set_sz( key, L"DhcpIPAddress", L"0.0.0.0" );
+    set_sz( key, L"DhcpSubnetMask", L"255.0.0.0" );
+    set_sz( key, L"DhcpServer", L"255.255.255.255" );
+    delete_values( key, gone );
+}
+
+static BOOL in_list( UINT addr, const UINT *list, UINT count )
+{
+    UINT i;
+    for (i = 0; i < count; i++) if (list[i] == addr) return TRUE;
+    return FALSE;
+}
+
+static void dns_text( const UINT *list, UINT count, WCHAR sep, struct text_list *out )
+{
+    WCHAR buf[16];
+    UINT i;
+
+    for (i = 0; i < count; i++)
+    {
+        ipv4_text( list[i], buf, ARRAY_SIZE(buf) );
+        list_add( out, buf, sep );
+    }
+}
+
+/* Tcpip\Parameters\Interfaces\{GUID} */
+static void update_interface( HKEY interfaces, const WCHAR *guid, IP_ADAPTER_ADDRESSES *aa,
+                              const struct nsi_dhcp4_info *info )
+{
+    struct text_list addrs = {{0}}, masks = {{0}}, gws = {{0}}, servers = {{0}};
+    IP_ADAPTER_UNICAST_ADDRESS *uni;
+    IP_ADAPTER_GATEWAY_ADDRESS *gw;
+    WCHAR buf[64], first_addr[16] = {0}, first_mask[16] = {0};
+    DWORD dhcp;
+    HKEY key;
+
+    if (!(key = create_key( interfaces, guid ))) return;
+
+    for (uni = aa->FirstUnicastAddress; uni; uni = uni->Next)
+    {
+        SOCKADDR_IN *sin = (SOCKADDR_IN *)uni->Address.lpSockaddr;
+
+        if (sin->sin_family != AF_INET) continue;
+        ipv4_text( sin->sin_addr.S_un.S_addr, buf, ARRAY_SIZE(buf) );
+        list_add( &addrs, buf, 0 );
+        if (addrs.count == 1) wcscpy( first_addr, buf );
+        ipv4_text( prefix_mask( uni->OnLinkPrefixLength ), buf, ARRAY_SIZE(buf) );
+        list_add( &masks, buf, 0 );
+        if (masks.count == 1) wcscpy( first_mask, buf );
+    }
+    for (gw = aa->FirstGatewayAddress; gw; gw = gw->Next)
+    {
+        SOCKADDR_IN *sin = (SOCKADDR_IN *)gw->Address.lpSockaddr;
+
+        if (sin->sin_family != AF_INET) continue;
+        ipv4_text( sin->sin_addr.S_un.S_addr, buf, ARRAY_SIZE(buf) );
+        list_add( &gws, buf, 0 );
+    }
+
+    if (!addrs.count)
+    {
+        /* no address now: an adapter on DHCP has lost its lease; a fixed configuration stays as
+         * it is, as Windows keeps it while the cable is out. A new adapter is on DHCP. */
+        if (!get_dword( key, L"EnableDHCP", &dhcp ) || dhcp) set_released( key );
+    }
+    else if (info->dhcp)
+    {
+        set_dword( key, L"EnableDHCP", 1 );
+        set_sz( key, L"DhcpIPAddress", first_addr );
+        set_sz( key, L"DhcpSubnetMask", first_mask );
+        set_multi1( key, L"DhcpSubnetMaskOpt", first_mask );
+        if (info->server) ipv4_text( info->server, buf, ARRAY_SIZE(buf) );
+        else wcscpy( buf, L"255.255.255.255" );
+        set_sz( key, L"DhcpServer", buf );
+        if (info->lease_time && info->obtained)
+        {
+            BOOL near = info->source == 4;
+
+            set_dword_near( key, L"Lease", info->lease_time, near );
+            set_dword_near( key, L"LeaseObtainedTime", unix_time_dword( info->obtained ), near );
+            set_dword_near( key, L"LeaseTerminatesTime", unix_time_dword( info->obtained + info->lease_time ), near );
+            set_dword_near( key, L"T1", unix_time_dword( info->obtained + info->lease_time / 2 ), near );
+            set_dword_near( key, L"T2", unix_time_dword( info->obtained + (LONGLONG)info->lease_time * 7 / 8 ), near );
+        }
+        set_multi( key, L"DhcpDefaultGateway", &gws );
+        /* the lease's name servers; when only the address's lifetime told of the lease, the ones
+         * the system uses */
+        if (info->dns_count) dns_text( info->dns, info->dns_count, ' ', &servers );
+        else if (info->source == 4) dns_text( info->system_dns, info->system_dns_count, ' ', &servers );
+        if (servers.count) set_sz( key, L"DhcpNameServer", servers.buf );
+        else RegDeleteValueW( key, L"DhcpNameServer" );
+        if (info->domain[0])
+        {
+            MultiByteToWideChar( CP_UTF8, 0, info->domain, -1, buf, ARRAY_SIZE(buf) );
+            set_sz( key, L"DhcpDomain", buf );
+        }
+        else RegDeleteValueW( key, L"DhcpDomain" );
+        /* name servers set by hand over a lease's (the system uses none of the lease's): the
+         * fixed NameServer, as on Windows */
+        servers.len = servers.count = 0;
+        servers.buf[0] = 0;
+        if (info->dns_count && info->system_dns_count)
+        {
+            UINT i;
+            for (i = 0; i < info->dns_count; i++) if (in_list( info->dns[i], info->system_dns, info->system_dns_count )) break;
+            if (i == info->dns_count) dns_text( info->system_dns, info->system_dns_count, ',', &servers );
+        }
+        set_sz( key, L"NameServer", servers.buf );
+        set_dword( key, L"AddressType", 0 );
+        delete_values( key, static_values );
+    }
+    else
+    {
+        set_dword( key, L"EnableDHCP", 0 );
+        set_multi( key, L"IPAddress", &addrs );
+        set_multi( key, L"SubnetMask", &masks );
+        set_multi( key, L"DefaultGateway", &gws );
+        dns_text( info->system_dns, info->system_dns_count, ',', &servers );
+        set_sz( key, L"NameServer", servers.buf );
+        delete_values( key, lease_values );
+    }
+    /* the connection-specific suffix an administrator sets; none by default */
+    if (RegQueryValueExW( key, L"Domain", NULL, NULL, NULL, NULL )) set_sz( key, L"Domain", L"" );
+    RegCloseKey( key );
+}
+
+/* the adapter's Control\Class\{4D36E972-...}\NNNN: the one naming its GUID, or the first free */
+static int find_class_index( HKEY class, const WCHAR *guid, BOOL *found )
+{
+    WCHAR name[16], value[64];
+    BYTE used[1000] = {0};
+    DWORD i, len;
+    HKEY key;
+
+    *found = FALSE;
+    for (i = 0; len = ARRAY_SIZE(name), !RegEnumKeyExW( class, i, name, &len, NULL, NULL, NULL, NULL ); i++)
+    {
+        WCHAR *end;
+        long n = wcstol( name, &end, 10 );
+
+        if (*end || len != 4 || n < 0 || n >= ARRAY_SIZE(used)) continue;
+        used[n] = 1;
+        if (RegOpenKeyExW( class, name, 0, KEY_QUERY_VALUE, &key )) continue;
+        if (get_sz( key, L"NetCfgInstanceId", value, ARRAY_SIZE(value) ) && !wcsicmp( value, guid ))
+        {
+            RegCloseKey( key );
+            *found = TRUE;
+            return n;
+        }
+        RegCloseKey( key );
+    }
+    for (i = 0; i < ARRAY_SIZE(used); i++) if (!used[i]) return i;
+    return -1;
+}
+
+/* the device behind the adapter: Enum\<instance ID>, Control\Class\{4D36E972-...}\NNNN and
+ * Control\Network\{4D36E972-...}\{GUID}\Connection */
+static void update_device( const WCHAR *guid, IP_ADAPTER_ADDRESSES *aa, const struct nsi_dhcp4_info *info )
+{
+    WCHAR id[200], hwid[160], location[64], path[300], driver[64];
+    struct text_list hwids = {{0}};
+    HKEY class, key;
+    BOOL found;
+    int index;
+    unsigned int i;
+
+    if (!(class = create_key( HKEY_LOCAL_MACHINE, class_path ))) return;
+    if ((index = find_class_index( class, guid, &found )) < 0)
+    {
+        RegCloseKey( class );
+        return;
+    }
+    MultiByteToWideChar( CP_UTF8, 0, info->hw_location, -1, location, ARRAY_SIZE(location) );
+    for (i = 0; location[i]; i++) if (location[i] == ':' || location[i] == '.' || location[i] == '-') location[i] = '_';
+    if (info->bus == 1)
+    {
+        swprintf( hwid, ARRAY_SIZE(hwid), L"PCI\\VEN_%04X&DEV_%04X&SUBSYS_%04X%04X&REV_%02X", info->hw_vendor,
+                  info->hw_device, info->hw_subdevice, info->hw_subvendor, info->hw_revision );
+        swprintf( id, ARRAY_SIZE(id), L"%s\\4&%s&0", hwid, location );
+        list_add( &hwids, hwid, 0 );
+        swprintf( hwid, ARRAY_SIZE(hwid), L"PCI\\VEN_%04X&DEV_%04X", info->hw_vendor, info->hw_device );
+        list_add( &hwids, hwid, 0 );
+    }
+    else if (info->bus == 2)
+    {
+        swprintf( hwid, ARRAY_SIZE(hwid), L"USB\\VID_%04X&PID_%04X", info->hw_vendor, info->hw_device );
+        swprintf( id, ARRAY_SIZE(id), L"%s\\5&%s&0", hwid, location );
+        list_add( &hwids, hwid, 0 );
+    }
+    else
+    {
+        wcscpy( hwid, L"ROOT\\NET" );
+        swprintf( id, ARRAY_SIZE(id), L"ROOT\\NET\\%04u", index );
+        list_add( &hwids, L"*SGNET", 0 );
+    }
+    swprintf( driver, ARRAY_SIZE(driver), L"%s\\%04u", net_class_guid, index );
+
+    swprintf( path, ARRAY_SIZE(path), L"%04u", index );
+    if ((key = create_key( class, path )))
+    {
+        WCHAR lower[160];
+
+        set_sz( key, L"NetCfgInstanceId", guid );
+        set_sz( key, L"DriverDesc", aa->Description );
+        set_sz( key, L"DeviceInstanceID", id );
+        for (i = 0; hwids.buf[i] && i < ARRAY_SIZE(lower) - 1; i++) lower[i] = towlower( hwids.buf[i] );
+        lower[i] = 0;
+        set_sz( key, L"ComponentId", lower );
+        set_sz( key, L"MatchingDeviceId", lower );
+        /* NCF_PHYSICAL | NCF_HAS_UI for a device on a bus, NCF_VIRTUAL otherwise */
+        set_dword( key, L"Characteristics", info->bus ? 0x84 : 0x1 );
+        set_dword( key, L"*IfType", aa->IfType );
+        set_dword( key, L"*MediaType", info->wireless ? 16 /* NdisMediumNative802_11 */ : 0 /* NdisMedium802_3 */ );
+        set_dword( key, L"*PhysicalMediaType", !info->bus ? 0 : info->wireless ? 9 /* Native802_11 */ : 14 /* 802_3 */ );
+        set_dword( key, L"NetLuidIndex", aa->Luid.Info.NetLuidIndex );
+        RegCloseKey( key );
+    }
+    RegCloseKey( class );
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", enum_path, id );
+    if ((key = create_key( HKEY_LOCAL_MACHINE, path )))
+    {
+        DWORD flags;
+
+        set_sz( key, L"Class", L"Net" );
+        set_sz( key, L"ClassGUID", net_class_guid );
+        set_sz( key, L"Driver", driver );
+        set_sz( key, L"DeviceDesc", aa->Description );
+        set_sz( key, L"Mfg", info->bus ? L"(Standard network adapters)" : L"Stained Glass OS" );
+        set_multi( key, L"HardwareID", &hwids );
+        /* an administrator may have disabled the device (CONFIGFLAG_DISABLED): kept */
+        if (!get_dword( key, L"ConfigFlags", &flags )) set_dword( key, L"ConfigFlags", 0 );
+        RegCloseKey( key );
+    }
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s\\Connection", network_path, guid );
+    if ((key = create_key( HKEY_LOCAL_MACHINE, path )))
+    {
+        set_sz( key, L"Name", aa->FriendlyName );
+        set_sz( key, L"PnpInstanceID", id );
+        set_dword( key, L"MediaSubType", info->wireless ? 2 : 1 );
+        RegCloseKey( key );
+    }
+}
+
+/* an adapter that is gone: its keys go too */
+static void remove_adapter( const WCHAR *guid )
+{
+    WCHAR path[300], name[16], value[200];
+    HKEY class, key;
+    DWORD i, len;
+
+    TRACE( "removing %s\n", debugstr_w( guid ) );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", interfaces_path, guid );
+    RegDeleteTreeW( HKEY_LOCAL_MACHINE, path );
+    RegDeleteKeyW( HKEY_LOCAL_MACHINE, path );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", network_path, guid );
+    RegDeleteTreeW( HKEY_LOCAL_MACHINE, path );
+    RegDeleteKeyW( HKEY_LOCAL_MACHINE, path );
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, class_path, 0, KEY_ALL_ACCESS, &class )) return;
+    for (i = 0; len = ARRAY_SIZE(name), !RegEnumKeyExW( class, i, name, &len, NULL, NULL, NULL, NULL ); i++)
+    {
+        if (RegOpenKeyExW( class, name, 0, KEY_QUERY_VALUE, &key )) continue;
+        if (!get_sz( key, L"NetCfgInstanceId", value, ARRAY_SIZE(value) ) || wcsicmp( value, guid ))
+        {
+            RegCloseKey( key );
+            continue;
+        }
+        if (get_sz( key, L"DeviceInstanceID", value, ARRAY_SIZE(value) ) && value[0])
+        {
+            WCHAR *slash;
+
+            swprintf( path, ARRAY_SIZE(path), L"%s\\%s", enum_path, value );
+            RegDeleteTreeW( HKEY_LOCAL_MACHINE, path );
+            RegDeleteKeyW( HKEY_LOCAL_MACHINE, path );
+            /* and the hardware ID's key, when no other instance is left in it */
+            if ((slash = wcsrchr( path, '\\' )))
+            {
+                *slash = 0;
+                RegDeleteKeyW( HKEY_LOCAL_MACHINE, path );
+            }
+        }
+        RegCloseKey( key );
+        RegDeleteTreeW( class, name );
+        RegDeleteKeyW( class, name );
+        break;
+    }
+    RegCloseKey( class );
+}
+
+static void update_tcpip_registry(void)
+{
+    static const ULONG flags = GAA_FLAG_INCLUDE_GATEWAYS | GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST |
+                               GAA_FLAG_INCLUDE_ALL_INTERFACES;
+    WCHAR present[MAX_ADAPTERS][40], name[64], dhcp_domain[256] = {0}, buf[512];
+    struct text_list search = {{0}};
+    struct nsi_dhcp4_info *info;
+    IP_ADAPTER_ADDRESSES *addrs = NULL, *aa;
+    unsigned int count = 0, i;
+    ULONG size = 0, err;
+    HKEY interfaces, params;
+    DWORD len;
+
+    for (;;)
+    {
+        err = GetAdaptersAddresses( AF_UNSPEC, flags, NULL, addrs, &size );
+        if (err != ERROR_BUFFER_OVERFLOW) break;
+        free( addrs );
+        if (!(addrs = malloc( size ))) return;
+    }
+    if (err && err != ERROR_NO_DATA)
+    {
+        WARN( "GetAdaptersAddresses failed: %lu\n", err );
+        free( addrs );
+        return;
+    }
+    if (!(info = calloc( 1, sizeof(*info) )) || !(interfaces = create_key( HKEY_LOCAL_MACHINE, interfaces_path )))
+    {
+        free( info );
+        free( addrs );
+        return;
+    }
+
+    for (aa = err ? NULL : addrs; aa; aa = aa->Next)
+    {
+        WCHAR guid[40];
+
+        if (aa->IfType == IF_TYPE_SOFTWARE_LOOPBACK || count == MAX_ADAPTERS) continue;
+        if (!MultiByteToWideChar( CP_ACP, 0, aa->AdapterName, -1, guid, ARRAY_SIZE(guid) )) continue;
+        if (nsiproxy_get_dhcp4_info( aa->IfIndex, info )) memset( info, 0, sizeof(*info) );
+        wcscpy( present[count++], guid );
+        update_interface( interfaces, guid, aa, info );
+        update_device( guid, aa, info );
+        if (info->dhcp && info->domain[0] && !dhcp_domain[0])
+            MultiByteToWideChar( CP_UTF8, 0, info->domain, -1, dhcp_domain, ARRAY_SIZE(dhcp_domain) );
+    }
+
+    for (i = 0; len = ARRAY_SIZE(name), !RegEnumKeyExW( interfaces, i, name, &len, NULL, NULL, NULL, NULL ); i++)
+    {
+        unsigned int j;
+
+        if (!is_netdev_guid( name )) continue;
+        for (j = 0; j < count; j++) if (!wcsicmp( present[j], name )) break;
+        if (j < count) continue;
+        remove_adapter( name );
+        i--;
+    }
+    RegCloseKey( interfaces );
+    /* the system's own settings, without an adapter */
+    if (!count && nsiproxy_get_dhcp4_info( 0, info )) memset( info, 0, sizeof(*info) );
+
+    if ((params = create_key( HKEY_LOCAL_MACHINE, params_path )))
+    {
+        WCHAR *tok, *ctx;
+
+        if (dhcp_domain[0]) set_sz( params, L"DhcpDomain", dhcp_domain );
+        else RegDeleteValueW( params, L"DhcpDomain" );
+        /* the search domains the system has beyond the leases' own domains */
+        MultiByteToWideChar( CP_UTF8, 0, info->search, -1, buf, ARRAY_SIZE(buf) );
+        for (tok = wcstok( buf, L" \t", &ctx ); tok; tok = wcstok( NULL, L" \t", &ctx ))
+            if (wcsicmp( tok, dhcp_domain ) && wcscmp( tok, L"." )) list_add( &search, tok, ',' );
+        set_sz( params, L"SearchList", search.buf );
+        RegCloseKey( params );
+    }
+    free( info );
+    free( addrs );
+}
+
+static DWORD WINAPI tcpip_registry_thread( void *arg )
+{
+    for (;;)
+    {
+        update_tcpip_registry();
+        /* a change comes as a burst of notifications (addresses, routes, the link): settle first */
+        if (!WaitForSingleObject( changed_event, 120 * 1000 ))
+            while (!WaitForSingleObject( changed_event, 300 )) ;
+    }
+    return 0;
+}
+
+void tcpip_registry_changed( const NPI_MODULEID *module, UINT table )
+{
+#ifndef SG_MUTANT_TCPIPREG_NO_FOLLOW
+    if (changed_event) SetEvent( changed_event );
+#endif
+}
+
+void tcpip_registry_start( void )
+{
+    HANDLE thread;
+
+    if (!(changed_event = CreateEventW( NULL, FALSE, FALSE, NULL ))) return;
+    if ((thread = CreateThread( NULL, 0, tcpip_registry_thread, NULL, 0, NULL ))) CloseHandle( thread );
+}
