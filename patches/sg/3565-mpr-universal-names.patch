 /*********************************************************************
- * WNetGetResourceParentA [MPR.@]
+ * WNetGetResourceParentW [MPR.@]
+ *
+ * The parent of a share is its server, the parent of a server is the network.
  */
-DWORD WINAPI WNetGetResourceParentA( LPNETRESOURCEA lpNetResource,
+DWORD WINAPI WNetGetResourceParentW( LPNETRESOURCEW lpNetResource,
                                      LPVOID lpBuffer, LPDWORD lpBufferSize )
 {
-    FIXME( "(%p, %p, %p): stub\n",
-           lpNetResource, lpBuffer, lpBufferSize );
+    const WCHAR *name, *provider = NULL, *p;
+    WCHAR *parent = NULL;
+    NETRESOURCEW *out = lpBuffer;
+    DWORD ret = WN_SUCCESS, len, size, display;
+    int slashes = 0;
 
-    SetLastError(WN_NO_NETWORK);
-    return WN_NO_NETWORK;
+    TRACE( "(%p, %p, %p)\n", lpNetResource, lpBuffer, lpBufferSize );
+
+    if (!lpNetResource || !lpBufferSize) return WN_BAD_POINTER;
+    if (!providerTable || !providerTable->numProviders) { ret = WN_NO_NETWORK; goto done; }
+    name = lpNetResource->lpRemoteName;
+    if (!name || !name[0]) { ret = WN_BAD_NETNAME; goto done; }
+    if (lpNetResource->lpProvider)
+    {
+        DWORD index = _findProviderIndexW( lpNetResource->lpProvider );
+        if (index == BAD_PROVIDER_INDEX) { ret = WN_BAD_PROVIDER; goto done; }
+        provider = providerTable->table[index].name;
+    }
+    else provider = providerTable->table[0].name;
+
+    if (name[0] != '\\' || name[1] != '\\') { ret = WN_BAD_NETNAME; goto done; }
+
+    /* \\server\share[\path] -> the name without its last component, down to \\server */
+    for (p = name + 2; *p; p++) if (*p == '\\') slashes++;
+    len = wcslen( name );
+    if (name[len - 1] == '\\') { len--; slashes--; }
+    if (slashes > 0)
+    {
+        while (len > 2 && name[len - 1] != '\\') len--;
+        len--;  /* the separator */
+        if (!(parent = malloc( (len + 1) * sizeof(WCHAR) ))) { ret = WN_OUT_OF_MEMORY; goto done; }
+        memcpy( parent, name, len * sizeof(WCHAR) );
+        parent[len] = 0;
+        display = slashes == 1 ? RESOURCEDISPLAYTYPE_SERVER : RESOURCEDISPLAYTYPE_SHARE;
+    }
+    else
+    {
+        /* a server: the network the provider stands for */
+        parent = wcsdup( provider );
+        display = RESOURCEDISPLAYTYPE_NETWORK;
+    }
+    if (!parent) { ret = WN_OUT_OF_MEMORY; goto done; }
+
+    size = sizeof(*out) + (wcslen( parent ) + 1 + wcslen( provider ) + 1) * sizeof(WCHAR);
+    if (*lpBufferSize < size || !lpBuffer)
+    {
+        *lpBufferSize = size;
+        ret = WN_MORE_DATA;
+    }
+    else
+    {
+        WCHAR *str = (WCHAR *)(out + 1);
+
+        memset( out, 0, sizeof(*out) );
+        out->dwScope = RESOURCE_GLOBALNET;
+        out->dwType = lpNetResource->dwType;
+        out->dwDisplayType = display;
+        out->dwUsage = RESOURCEUSAGE_CONTAINER;
+        out->lpRemoteName = str;
+        wcscpy( str, parent );
+        str += wcslen( parent ) + 1;
+        out->lpProvider = str;
+        wcscpy( str, provider );
+    }
+    free( parent );
+done:
+    if (ret) SetLastError( ret );
+    return ret;
 }
 
 /*********************************************************************
- * WNetGetResourceParentW [MPR.@]
+ * WNetGetResourceParentA [MPR.@]
  */
-DWORD WINAPI WNetGetResourceParentW( LPNETRESOURCEW lpNetResource,
+DWORD WINAPI WNetGetResourceParentA( LPNETRESOURCEA lpNetResource,
                                      LPVOID lpBuffer, LPDWORD lpBufferSize )
 {
-    FIXME( "(%p, %p, %p): stub\n",
-           lpNetResource, lpBuffer, lpBufferSize );
+    NETRESOURCEW *inW = NULL, *outW = NULL;
+    DWORD ret, count = 1, size = 1024, sizeW;
 
-    SetLastError(WN_NO_NETWORK);
-    return WN_NO_NETWORK;
+    TRACE( "(%p, %p, %p)\n", lpNetResource, lpBuffer, lpBufferSize );
+
+    if (!lpNetResource || !lpBufferSize) return WN_BAD_POINTER;
+    if (!(inW = malloc( size ))) return WN_OUT_OF_MEMORY;
+    ret = _thunkNetResourceArrayAToW( lpNetResource, &count, inW, &size );
+    if (ret == WN_MORE_DATA)
+    {
+        free( inW );
+        if (!(inW = malloc( size ))) return WN_OUT_OF_MEMORY;
+        ret = _thunkNetResourceArrayAToW( lpNetResource, &count, inW, &size );
+    }
+    if (ret == WN_SUCCESS)
+    {
+        sizeW = 2048;
+        if (!(outW = malloc( sizeW ))) ret = WN_OUT_OF_MEMORY;
+        else
+        {
+            ret = WNetGetResourceParentW( inW, outW, &sizeW );
+            if (ret == WN_SUCCESS)
+            {
+                DWORD n = 1, need = sizeW;
+                ret = _thunkNetResourceArrayWToA( outW, &n, lpBuffer, lpBufferSize ? lpBufferSize : &need );
+                if (ret == WN_MORE_DATA)
+                {
+                    /* the size the ANSI form needs */
+                    need = sizeof(NETRESOURCEA);
+                    if (outW->lpRemoteName) need += WideCharToMultiByte( CP_ACP, 0, outW->lpRemoteName, -1, NULL, 0, NULL, NULL );
+                    if (outW->lpProvider) need += WideCharToMultiByte( CP_ACP, 0, outW->lpProvider, -1, NULL, 0, NULL, NULL );
+                    *lpBufferSize = need;
+                }
+            }
+            else if (ret == WN_MORE_DATA)
+                *lpBufferSize = sizeW;
+            free( outW );
+        }
+    }
+    free( inW );
+    if (ret) SetLastError( ret );
+    return ret;
 }
 
 
