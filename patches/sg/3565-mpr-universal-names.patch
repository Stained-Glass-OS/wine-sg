+/* The three parts of a universal name: "\\server\share" (the connection of the
+ * drive), the rest of the path, and the two joined. */
+static DWORD get_universal_parts( const WCHAR *path, WCHAR **universal, WCHAR **connection, const WCHAR **remaining )
+{
+    WCHAR root[4] = { 0, ':', '\\', 0 }, local[3] = { 0, ':', 0 }, *remote;
+    DWORD size = MAX_PATH, ret;
+    const WCHAR *rest;
+
+    if (!path || !iswalpha( path[0] ) || path[1] != ':') return WN_NOT_CONNECTED;
+    root[0] = local[0] = path[0];
+    if (GetDriveTypeW( root ) != DRIVE_REMOTE) return WN_NOT_CONNECTED;
+
+    if (!(remote = malloc( size * sizeof(WCHAR) ))) return WN_OUT_OF_MEMORY;
+    ret = WNetGetConnectionW( local, remote, &size );
+    if (ret == WN_MORE_DATA)
+    {
+        free( remote );
+        if (!(remote = malloc( size * sizeof(WCHAR) ))) return WN_OUT_OF_MEMORY;
+        ret = WNetGetConnectionW( local, remote, &size );
+    }
+    if (ret)
+    {
+        free( remote );
+        return ret;
+    }
+
+    /* the rest of the path; a lone separator is the share itself */
+    rest = path + 2;
+    if (rest[0] == '\\' && !rest[1]) rest++;
+    if (!(*universal = malloc( (wcslen( remote ) + wcslen( rest ) + 1) * sizeof(WCHAR) )))
+    {
+        free( remote );
+        return WN_OUT_OF_MEMORY;
+    }
+    wcscpy( *universal, remote );
+    wcscat( *universal, rest );
+    *connection = remote;
+    *remaining = rest;
+    return WN_SUCCESS;
+}
+
+static DWORD universal_name_check( DWORD level, LPVOID buffer, LPDWORD size )
+{
+    if (!size) return WN_BAD_POINTER;
+    if (level != UNIVERSAL_NAME_INFO_LEVEL && level != REMOTE_NAME_INFO_LEVEL) return WN_BAD_VALUE;
+    return WN_SUCCESS;
 }
 
