+static void test_extended_error(void)
+{
+    DWORD (WINAPI *pNPSSetExtendedErrorA)(DWORD, LPSTR);
+    DWORD (WINAPI *pNPSCopyStringA)(LPCSTR, LPVOID, LPDWORD);
+    HMODULE mpr = GetModuleHandleA("mpr.dll");
+    char text[64], provider[64], out[16];
+    DWORD ret, code = 99, size;
+
+    ret = WNetGetLastErrorA(&code, text, sizeof(text), provider, sizeof(provider));
+    ok(ret == WN_SUCCESS, "got %lu\n", ret);
+    ok(!code && !text[0], "got code %lu, text %s\n", code, debugstr_a(text));
+    ret = WNetGetLastErrorA(NULL, text, sizeof(text), provider, sizeof(provider));
+    ok(ret == WN_BAD_POINTER, "got %lu\n", ret);
+
+    pNPSSetExtendedErrorA = (void *)GetProcAddress(mpr, "NPSSetExtendedErrorA");
+    pNPSCopyStringA = (void *)GetProcAddress(mpr, "NPSCopyStringA");
+    if (!pNPSSetExtendedErrorA || !pNPSCopyStringA)
+    {
+        win_skip("NPSSetExtendedErrorA or NPSCopyStringA not exported\n");
+        return;
+    }
+    ret = pNPSSetExtendedErrorA(1234, (char *)"provider says no");
+    ok(ret == WN_SUCCESS, "got %lu\n", ret);
+    ret = WNetGetLastErrorA(&code, text, sizeof(text), provider, sizeof(provider));
+    ok(ret == WN_SUCCESS, "got %lu\n", ret);
+    ok(code == 1234 && !strcmp(text, "provider says no"), "got code %lu, text %s\n", code, debugstr_a(text));
+    ret = WNetGetLastErrorA(&code, text, 5, provider, sizeof(provider));
+    ok(ret == WN_SUCCESS && !strcmp(text, "prov"), "got %lu, text %s\n", ret, debugstr_a(text));
+
+    size = 3;
+    ret = pNPSCopyStringA("hello", out, &size);
+    ok(ret == WN_MORE_DATA && size == 6, "got %lu, size %lu\n", ret, size);
+    size = sizeof(out);
+    ret = pNPSCopyStringA("hello", out, &size);
+    ok(ret == WN_SUCCESS && !strcmp(out, "hello"), "got %lu, %s\n", ret, debugstr_a(out));
+}
+
+static void test_WNetGetResourceParent(void)
+{
+    char buffer[1024];
+    NETRESOURCEA in = {0}, *out = (NETRESOURCEA *)buffer;
+    DWORD ret, size = sizeof(buffer);
+
+    in.dwType = RESOURCETYPE_DISK;
+    in.lpRemoteName = (char *)"\\\\srv\\share";
+    ret = WNetGetResourceParentA(&in, buffer, &size);
+    if (ret == WN_NO_NETWORK)
+    {
+        skip("no network provider\n");
+        return;
+    }
+    ok(ret == WN_SUCCESS, "got %lu\n", ret);
+    if (ret) return;
+    ok(!strcmp(out->lpRemoteName, "\\\\srv"), "got %s\n", debugstr_a(out->lpRemoteName));
+    ok(out->dwDisplayType == RESOURCEDISPLAYTYPE_SERVER, "got %lu\n", out->dwDisplayType);
+
+    in.lpRemoteName = (char *)"\\\\srv";
+    size = sizeof(buffer);
+    ret = WNetGetResourceParentA(&in, buffer, &size);
+    ok(ret == WN_SUCCESS, "got %lu\n", ret);
+    ok(out->dwDisplayType == RESOURCEDISPLAYTYPE_NETWORK, "got %lu\n", out->dwDisplayType);
+
+    in.lpRemoteName = (char *)"\\\\srv\\share\\a\\b";
+    size = sizeof(buffer);
+    ret = WNetGetResourceParentA(&in, buffer, &size);
+    ok(ret == WN_SUCCESS && !strcmp(out->lpRemoteName, "\\\\srv\\share\\a"), "got %lu\n", ret);
+    size = 4;
+    ret = WNetGetResourceParentA(&in, buffer, &size);
+    ok(ret == WN_MORE_DATA && size > 4, "got %lu, size %lu\n", ret, size);
+    ret = WNetGetResourceParentA(NULL, buffer, &size);
+    ok(ret == WN_BAD_POINTER, "got %lu\n", ret);
+}
+
 START_TEST(mpr)
 {
     test_WNetGetUniversalName();
     test_WNetGetRemoteName();
     test_WNetCachePassword();
     test_WNetUseConnection();
+    test_extended_error();
+    test_WNetGetResourceParent();
 }
