+/* The extended error a provider left with NPSSetExtendedError, kept per thread */
+struct extended_error
+{
+    DWORD code;
+    WCHAR text[512];
+    WCHAR provider[256];
+};
+
+static DWORD extended_error_index = TLS_OUT_OF_INDEXES;
+
+void mpr_extended_error_init( void )
+{
+    extended_error_index = TlsAlloc();
+}
+
+void mpr_extended_error_free( BOOL thread_only )
+{
+    if (extended_error_index == TLS_OUT_OF_INDEXES) return;
+    free( TlsGetValue( extended_error_index ) );
+    TlsSetValue( extended_error_index, NULL );
+    if (!thread_only) TlsFree( extended_error_index );
+}
+
+/* the thread's record, made when it is first needed */
+static struct extended_error *get_extended_error( BOOL create )
+{
+    struct extended_error *err;
+
+    if (extended_error_index == TLS_OUT_OF_INDEXES) return NULL;
+    if (!(err = TlsGetValue( extended_error_index )) && create)
+    {
+        if ((err = calloc( 1, sizeof(*err) ))) TlsSetValue( extended_error_index, err );
+    }
+    return err;
+}
+
+DWORD mpr_set_extended_error( DWORD code, const WCHAR *text, const WCHAR *provider )
+{
+    struct extended_error *err = get_extended_error( TRUE );
+
+    if (!err) return WN_OUT_OF_MEMORY;
+    err->code = code;
+    lstrcpynW( err->text, text ? text : L"", ARRAY_SIZE(err->text) );
+    lstrcpynW( err->provider, provider ? provider : L"", ARRAY_SIZE(err->provider) );
+    return WN_SUCCESS;
 }
 
