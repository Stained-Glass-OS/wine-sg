 /*****************************************************************
  *  NPSCopyStringA [MPR.@]
+ *
+ * Copies a string into the buffer; the size is set to what the string needs
+ * when the buffer is too small.
  */
 DWORD WINAPI NPSCopyStringA( LPCSTR lpString, LPVOID lpBuffer, LPDWORD lpdwBufferSize )
 {
-    FIXME( "(%s, %p, %p): stub\n", debugstr_a(lpString), lpBuffer, lpdwBufferSize );
-    return WN_NOT_SUPPORTED;
+    DWORD len;
+
+    TRACE( "(%s, %p, %p)\n", debugstr_a(lpString), lpBuffer, lpdwBufferSize );
+
+    if (!lpString || !lpdwBufferSize) return WN_BAD_POINTER;
+    len = strlen( lpString ) + 1;
+    if (*lpdwBufferSize < len || !lpBuffer)
+    {
+        *lpdwBufferSize = len;
+        return WN_MORE_DATA;
+    }
+    memcpy( lpBuffer, lpString, len );
+    *lpdwBufferSize = len;
+    return WN_SUCCESS;
 }
 
