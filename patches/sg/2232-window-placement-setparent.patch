From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: placement flags, SetParent through owned popups

GetWindowPlacement reported WPF_RESTORETOMAXIMIZED only for a window that
had been minimized from maximized.  A maximized window has it too, in its
own process and in another one whose owner does not answer the query.
SetParent let a window become the child of an owned popup that belonged to
it through owner and parent links (SetParent(parent, popup owned by its
child)); it now fails.  Matching todo_wine marks removed from the user32
win test.

---
--- a/dlls/user32/tests/win.c
+++ b/dlls/user32/tests/win.c
@@ -4844,7 +4844,7 @@ static void test_SetParent(void)
     ok(!SetParent(child2, child3), "SetParent should fail\n");
     ok(SetParent(child1, parent) != 0, "SetParent should not fail\n");
     ret = SetParent(parent, child2);
-    todo_wine ok( !ret || broken( ret != 0 ), "SetParent should fail\n");
+    ok( !ret || broken( ret != 0 ), "SetParent should fail\n");
     if (ret)  /* nt4, win2k */
     {
         ret = SetParent(parent, child3);
@@ -12897,7 +12897,7 @@ static void other_process_proc(HWND hwnd)
     ret = GetWindowPlacement(hwnd, &wp);
     ok(ret, "Unexpected ret %#lx.\n", ret);
     ok(wp.showCmd == SW_SHOWMAXIMIZED, "Unexpected showCmd %#x.\n", wp.showCmd);
-    todo_wine ok(wp.flags == WPF_RESTORETOMAXIMIZED, "Unexpected flags %#x.\n", wp.flags);
+    ok(wp.flags == WPF_RESTORETOMAXIMIZED, "Unexpected flags %#x.\n", wp.flags);
     SetEvent(test_done_event);
 
     /* SW_SHOWMINIMIZED */
@@ -12915,7 +12915,7 @@ static void other_process_proc(HWND hwnd)
     ret = GetWindowPlacement(hwnd, &wp);
     ok(ret, "Unexpected ret %#lx.\n", ret);
     ok(wp.showCmd == SW_SHOWMAXIMIZED, "Unexpected showCmd %#x.\n", wp.showCmd);
-    todo_wine ok(wp.flags == WPF_RESTORETOMAXIMIZED, "Unexpected flags %#x.\n", wp.flags);
+    ok(wp.flags == WPF_RESTORETOMAXIMIZED, "Unexpected flags %#x.\n", wp.flags);
     SetEvent(test_done_event);
 
     CloseHandle(window_ready_event);
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -423,6 +423,28 @@ HWND WINAPI NtUserSetParent( HWND hwnd, HWND parent )
         return 0;
     }
 
+    /* nor may it become the child of an owned popup that, by owner or parent
+     * links, belongs to it already */
+#ifndef SG_MUTANT_SETPARENT_OWNER_CYCLE
+    if (get_window_long( parent, GWL_STYLE ) & WS_POPUP)
+    {
+        HWND cur = parent, next;
+        int depth;
+
+        for (depth = 0; cur && depth < 64; depth++)
+        {
+            if (cur == get_full_window_handle( hwnd ))
+            {
+                RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+                return 0;
+            }
+            if (!(next = get_window_relative( cur, GW_OWNER ))) next = get_parent( cur );
+            if (next == get_desktop_window()) break;
+            cur = next;
+        }
+    }
+#endif
+
     if (!(full_handle = is_current_thread_window( hwnd )))
         return UlongToHandle( send_message( hwnd, WM_WINE_SETPARENT, (WPARAM)parent, 0 ));
 
@@ -2992,7 +3014,11 @@ BOOL WINAPI NtUserGetWindowPlacement( HWND hwnd, WINDOWPLACEMENT *placement )
         else
             placement->showCmd = (style & WS_MAXIMIZE) ? SW_SHOWMAXIMIZED : SW_SHOWNORMAL;
         /* provide some dummy information */
+#ifndef SG_MUTANT_PLACEMENT_MAX_FLAG
+        placement->flags = (style & WS_MAXIMIZE) ? WPF_RESTORETOMAXIMIZED : 0;
+#else
         placement->flags = 0;
+#endif
         placement->ptMinPosition.x = -1;
         placement->ptMinPosition.y = -1;
         placement->ptMaxPosition.x = -1;
@@ -3023,7 +3049,12 @@ BOOL WINAPI NtUserGetWindowPlacement( HWND hwnd, WINDOWPLACEMENT *placement )
         placement->showCmd = SW_SHOWMINIMIZED;
     else
         placement->showCmd = ( win->dwStyle & WS_MAXIMIZE ) ? SW_SHOWMAXIMIZED : SW_SHOWNORMAL ;
+    /* a maximized window also restores to maximized */
+#ifndef SG_MUTANT_PLACEMENT_MAX_FLAG
+    if ((win->flags & WIN_RESTORE_MAX) || (win->dwStyle & WS_MAXIMIZE))
+#else
     if (win->flags & WIN_RESTORE_MAX)
+#endif
         placement->flags = WPF_RESTORETOMAXIMIZED;
     else
         placement->flags = 0;
