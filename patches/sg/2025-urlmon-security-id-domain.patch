From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] urlmon: GetSecurityIdEx2 domain parameter (2025)

The last parameter of IInternetSecurityManagerEx2::GetSecurityIdEx2 is a
domain (a string): for a hierarchical URI it replaces the host in the
security id ("scheme:domain" followed by the zone). It was ignored with
a FIXME. The urlmon sec_mgr test's two todo_wine marks on this are removed.
---
--- a/dlls/urlmon/sec_mgr.c
+++ b/dlls/urlmon/sec_mgr.c
@@ -676,7 +676,7 @@
     return hres;
 }
 
-static HRESULT generate_security_id(IUri *uri, BYTE *secid, DWORD *secid_len, DWORD zone)
+static HRESULT generate_security_id(IUri *uri, BYTE *secid, DWORD *secid_len, DWORD zone, const WCHAR *domain)
 {
     DWORD len;
     HRESULT hres;
@@ -713,9 +713,19 @@
         DWORD host_len, scheme_len;
         BYTE *ptr;
 
-        hres = IUri_GetHost(uri, &host);
+        /* GetSecurityIdEx2 can be given a domain to use in place of the host. */
+        #ifdef SG_MUTANT_DOMAIN_IGNORED
+        domain = NULL;
+#endif
+        if(domain && scheme_type != URL_SCHEME_WILDCARD) {
+            host = SysAllocString(domain);
+            hres = S_OK;
+        } else
+            hres = IUri_GetHost(uri, &host);
         if(FAILED(hres))
             return hres;
+        if(!host)
+            return E_OUTOFMEMORY;
 
         /* The host can't be empty for Wildcard URIs. */
         if(scheme_type == URL_SCHEME_WILDCARD && !*host) {
@@ -775,13 +785,13 @@
     if(FAILED(hres))
         return hres;
 
-    hres = generate_security_id(uri, secid, secid_len, zone);
+    hres = generate_security_id(uri, secid, secid_len, zone, NULL);
     IUri_Release(uri);
 
     return hres;
 }
 
-static HRESULT get_security_id_for_uri(IUri *uri, BYTE *secid, DWORD *secid_len)
+static HRESULT get_security_id_for_uri(IUri *uri, BYTE *secid, DWORD *secid_len, const WCHAR *domain)
 {
     HRESULT hres;
     IUri *secur_uri;
@@ -791,7 +801,7 @@
     if(FAILED(hres))
         return hres;
 
-    hres = generate_security_id(secur_uri, secid, secid_len, zone);
+    hres = generate_security_id(secur_uri, secid, secid_len, zone, domain);
     IUri_Release(secur_uri);
 
     return hres;
@@ -1788,13 +1798,11 @@
     SecManagerImpl *This = impl_from_IInternetSecurityManagerEx2(iface);
     TRACE("(%p)->(%p %p %p %08Ix) stub\n", This, pUri, pbSecurityId, pcbSecurityId, dwReserved);
 
-    if(dwReserved)
-        FIXME("dwReserved is not supported yet\n");
-
     if(!pUri || !pcbSecurityId || !pbSecurityId)
         return E_INVALIDARG;
 
-    return get_security_id_for_uri(pUri, pbSecurityId, pcbSecurityId);
+    /* dwReserved is a domain (a string) that replaces the host in the id. */
+    return get_security_id_for_uri(pUri, pbSecurityId, pcbSecurityId, (const WCHAR *)dwReserved);
 }
 
 static HRESULT WINAPI SecManagerImpl_QueryCustomPolicyEx2(IInternetSecurityManagerEx2 *iface,
--- a/dlls/urlmon/tests/sec_mgr.c
+++ b/dlls/urlmon/tests/sec_mgr.c
@@ -1839,8 +1839,8 @@
 
     hres = IInternetSecurityManagerEx2_GetSecurityIdEx2(sec_mgr2, uri, buf, &buf_size, (DWORD_PTR)domainW);
     ok(hres == S_OK, "GetSecurityIdEx2 failed: %08lx\n", hres);
-    todo_wine ok(buf_size == sizeof(secid13), "buf_size was %ld\n", buf_size);
-    todo_wine ok(!memcmp(buf, secid13, sizeof(secid13)), "Got wrong secid\n");
+    ok(buf_size == sizeof(secid13), "buf_size was %ld\n", buf_size);
+    ok(!memcmp(buf, secid13, sizeof(secid13)), "Got wrong secid\n");
 
     buf_size = sizeof(buf);
     memset(buf, 0xf0, buf_size);
