From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: a file's mode that does not change is not set (clearing a read-only flag it does not have)

David (2026-11-15): GOG GALAXY's service (SYSTEM) could not remove a folder
the client run by him had filled: "Could not set read-only attribute, error
code: 5". Removing a tree, it clears each file's read-only flag first; the
files had none, but fd_set_file_info still called fchmod, and only a file's
owner may chmod it. A mode that stays the same is now not set (the DOS
attributes still are).
---
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 4580dba..369cbe1 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -1830,8 +1830,10 @@ static int fd_set_dos_attrib( int fd, UINT attr, BOOL force_set )
 static NTSTATUS fd_set_file_info( int fd, UINT attr, BOOL force_set_xattr )
 {
     struct stat st;
+    mode_t old_mode;
 
     if (fstat( fd, &st ) == -1) return errno_to_status( errno );
+    old_mode = st.st_mode;
     if (attr & FILE_ATTRIBUTE_READONLY)
     {
         if (S_ISDIR( st.st_mode))
@@ -1852,6 +1854,19 @@ static NTSTATUS fd_set_file_info( int fd, UINT attr, BOOL force_set_xattr )
      * hidden/system attributes of a read-only file (or one being made read-only) are written
      * while the owner may still write it, and the mode is set afterwards (they were lost) */
 #ifndef SG_MUTANT_RO_XATTR_AFTER_CHMOD
+    /* Stained Glass OS: a mode that does not change is not set: only a file's
+     * owner may chmod it, and a SYSTEM service clearing the read-only flag of
+     * a user's file that has none (GOG GALAXY's service removing a folder the
+     * client had filled, David 2026-11-15) was refused (wine-sg 7794) */
+#ifndef SG_MUTANT_RO_NOOP_CHMOD
+    if (st.st_mode == old_mode && (S_ISDIR( st.st_mode ) || (st.st_mode & 0200)))
+    {
+        if (fd_set_dos_attrib( fd, attr, force_set_xattr ) == -1 && errno != ENOTSUP)
+            WARN( "Failed to set extended attribute " SAMBA_XATTR_DOS_ATTRIB ". errno %d (%s)\n",
+                  errno, strerror( errno ) );
+        return STATUS_SUCCESS;
+    }
+#endif
     if (!S_ISDIR( st.st_mode ) && !(st.st_mode & 0200)) fchmod( fd, st.st_mode | 0200 );
     else if (fchmod( fd, st.st_mode ) == -1) return errno_to_status( errno );
     if (fd_set_dos_attrib( fd, attr, force_set_xattr ) == -1 && errno != ENOTSUP)
