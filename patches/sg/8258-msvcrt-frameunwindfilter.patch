From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcrt: __FrameUnwindFilter

__FrameUnwindFilter is the exception filter compiler-generated code puts around the destructors it runs while a frame unwinds: a C++ exception thrown during unwinding ends the program through terminate(), as C++ requires, and any other exception goes on to the next handler. It was a spec stub in msvcr80-120, ucrtbase and vcruntime140 (LibreOffice, Anki and Dependencies import it, so the stub killed them instead).
---
--- a/dlls/msvcrt/except.c
+++ b/dlls/msvcrt/except.c
@@ -746,6 +746,28 @@
     return _XcptFilter(ex, ptr);
 }
 
+#if _MSVCR_VER >= 80
+#ifndef SG_MUTANT_NO_FRAME_UNWIND_FILTER
+/*********************************************************************
+ *		__FrameUnwindFilter (MSVCR80.@)
+ *
+ * (wine-sg 8258) The filter compiler-generated code puts around the destructors it runs while a frame
+ * unwinds: a C++ exception thrown there, during unwinding, ends the program (std::terminate, as the C++
+ * standard requires); any other exception goes on to the next handler.
+ */
+int CDECL __FrameUnwindFilter(EXCEPTION_POINTERS *ptrs)
+{
+    TRACE("(%p)\n", ptrs);
+
+    if (ptrs && ptrs->ExceptionRecord && is_cxx_exception(ptrs->ExceptionRecord))
+        terminate();
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+#else
+int CDECL __FrameUnwindFilter(EXCEPTION_POINTERS *ptrs) { return EXCEPTION_CONTINUE_EXECUTION; }
+#endif
+#endif
+
 /*********************************************************************
  *		__CxxDetectRethrow (MSVCRT.@)
  */
--- a/dlls/msvcr80/msvcr80.spec
+++ b/dlls/msvcr80/msvcr80.spec
@@ -214,7 +214,7 @@
 @ cdecl __CxxRegisterExceptionObject(ptr ptr)
 @ cdecl __CxxUnregisterExceptionObject(ptr long)
 @ cdecl __DestructExceptionObject(ptr)
-@ stub __FrameUnwindFilter
+@ cdecl __FrameUnwindFilter(ptr)
 @ cdecl __RTCastToVoid(ptr)
 @ cdecl __RTDynamicCast(ptr long ptr ptr long)
 @ cdecl __RTtypeid(ptr)
