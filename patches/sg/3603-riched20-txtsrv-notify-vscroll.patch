From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: text services EN_CHANGE data and empty vertical scroll range (3603)

riched20: text services EN_CHANGE data and empty vertical scroll range

A windowless host's TxNotify(EN_CHANGE) now receives a CHANGENOTIFY
instead of NULL, and ITextServices::TxGetVScroll reports an empty range
(max 0) while the scroll bar is not needed or is disabled. Three
todo_wine marks in tests/txtsrv.c go.
---
diff --git a/dlls/riched20/paint.c b/dlls/riched20/paint.c
index 5d04162..690f307 100644
--- a/dlls/riched20/paint.c
+++ b/dlls/riched20/paint.c
@@ -166,8 +166,15 @@ void ME_UpdateRepaint(ME_TextEditor *editor, BOOL update_now)
 
   if(editor->nEventMask & ENM_CHANGE)
   {
+    /* the CHANGENOTIFY of the text services notifications: a generic change */
+    struct { DWORD change_type; void *cookie; } change = { 0, NULL };
+
     editor->nEventMask &= ~ENM_CHANGE;
+#ifdef SG_MUTANT_RE_CHANGE
     ITextHost_TxNotify( editor->texthost, EN_CHANGE, NULL );
+#else
+    ITextHost_TxNotify( editor->texthost, EN_CHANGE, &change );
+#endif
     editor->nEventMask |= ENM_CHANGE;
   }
 }
diff --git a/dlls/riched20/tests/txtsrv.c b/dlls/riched20/tests/txtsrv.c
index 0b4ac6c..78766d5 100644
--- a/dlls/riched20/tests/txtsrv.c
+++ b/dlls/riched20/tests/txtsrv.c
@@ -446,7 +446,6 @@ static HRESULT __thiscall ITextHostImpl_TxNotify( ITextHost *iface, DWORD code,
         break;
     case EN_CHANGE:
         en_change_sent++;
-        todo_wine
         ok( data != NULL, "got %p\n", data );
         break;
     case EN_SELCHANGE:
@@ -1188,7 +1187,6 @@ static void test_TxGetScroll(void)
     ret = ITextServices_TxGetVScroll( txtserv, &min_pos, &max_pos, &pos, &page, &enabled );
     ok( ret == S_OK, "ITextServices_TxGetHScroll failed: 0x%08lx.\n", ret );
     ok( min_pos == 0, "got %ld\n", min_pos );
-    todo_wine
     ok( max_pos == 0, "got %ld\n", max_pos );
     ok( pos == 0, "got %ld\n", pos );
     ok( page == client.bottom, "got %ld\n", page );
@@ -1212,7 +1210,6 @@ static void test_TxGetScroll(void)
     ret = ITextServices_TxGetVScroll( txtserv, &min_pos, &max_pos, &pos, &page, &enabled );
     ok( ret == S_OK, "ITextServices_TxGetHScroll failed: 0x%08lx.\n", ret );
     ok( min_pos == 0, "got %ld\n", min_pos );
-    todo_wine
     ok( max_pos == 0, "got %ld\n", max_pos );
     ok( pos == 0, "got %ld\n", pos );
     ok( page == client.bottom, "got %ld\n", page );
diff --git a/dlls/riched20/txtsrv.c b/dlls/riched20/txtsrv.c
index 421163f..2eb6f92 100644
--- a/dlls/riched20/txtsrv.c
+++ b/dlls/riched20/txtsrv.c
@@ -224,7 +224,12 @@ HRESULT __thiscall fnTextSrv_TxGetVScroll( ITextServices *iface, LONG *min_pos,
     struct text_services *services = impl_from_ITextServices( iface );
 
     if (min_pos) *min_pos = services->editor->vert_si.nMin;
+    /* with the scroll bar not needed (or disabled) the range is empty */
+#ifdef SG_MUTANT_RE_VSCROLL
     if (max_pos) *max_pos = services->editor->vert_si.nMax;
+#else
+    if (max_pos) *max_pos = services->editor->vert_sb_enabled ? services->editor->vert_si.nMax : 0;
+#endif
     if (pos) *pos = services->editor->vert_si.nPos;
     if (page) *page = services->editor->vert_si.nPage;
     if (enabled) *enabled = services->editor->vert_sb_enabled;
