+                        free_levels(chain, want_mips);
+                        goto end;
+                    }
+                }
+                else
+                {
+                    out_levels[i * out_mips + m] = chain[first_mip + m];
+                    chain[first_mip + m].data = NULL;
+                }
+            }
+            free_levels(chain, want_mips);
+        }
+    }
+
+    /* pack everything behind the subresource descriptions */
+    {
+        SIZE_T total = (SIZE_T)out_count * sizeof(D3D11_SUBRESOURCE_DATA), offset;
+        unsigned int out_mips = want_mips - first_mip;
+        D3D11_SUBRESOURCE_DATA *sub;
+
+        for (i = 0; i < out_count; ++i)
+            total += (SIZE_T)out_levels[i].slice_pitch * out_levels[i].depth;
+        if (!(res_data = malloc(total)))
+        {
+            hr = E_OUTOFMEMORY;
+            goto end;
+        }
+        sub = (D3D11_SUBRESOURCE_DATA *)res_data;
+        offset = (SIZE_T)out_count * sizeof(*sub);
+        for (i = 0; i < out_count; ++i)
+        {
+            SIZE_T bytes = (SIZE_T)out_levels[i].slice_pitch * out_levels[i].depth;
+
+            memcpy(res_data + offset, out_levels[i].data, bytes);
+            sub[i].pSysMem = res_data + offset;
+            sub[i].SysMemPitch = out_levels[i].pitch;
+            sub[i].SysMemSlicePitch = out_levels[i].slice_pitch;
+            offset += bytes;
+        }
+
+        load_info->Width = out_levels[0].width;
+        load_info->Height = out_levels[0].height;
+        load_info->Depth = is_3d ? out_levels[0].depth : D3DX11_DEFAULT;
+        load_info->MipLevels = out_mips;
+        load_info->Format = target_format;
+        if (IS_DEFAULT(load_info->Usage))
+            load_info->Usage = D3D11_USAGE_DEFAULT;
+        if (IS_DEFAULT(load_info->BindFlags))
+            load_info->BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        if (IS_DEFAULT(load_info->CpuAccessFlags))
+            load_info->CpuAccessFlags = 0;
+        if (IS_DEFAULT(load_info->MiscFlags))
+            load_info->MiscFlags = img_info.MiscFlags;
+        else
+            load_info->MiscFlags |= img_info.MiscFlags;
+        if (extra)
+        {
+            extra->dimension = is_3d ? D3D11_RESOURCE_DIMENSION_TEXTURE3D : D3D11_RESOURCE_DIMENSION_TEXTURE2D;
+            extra->array_size = array_size;
+        }
+    }
+
+    *resource_data = (D3D11_SUBRESOURCE_DATA *)res_data;
+    res_data = NULL;
+    hr = S_OK;
+
+end:
+    free_levels(levels, level_count);
+    free_levels(out_levels, out_count);
+    if (dds_decoder)
+        IWICDdsDecoder_Release(dds_decoder);
+    if (dds_frame)
+        IWICDdsFrameDecode_Release(dds_frame);
+    free(res_data);
+    if (frame)
+        IWICBitmapFrameDecode_Release(frame);
+    if (decoder)
+        IWICBitmapDecoder_Release(decoder);
+    if (stream)
+        IWICStream_Release(stream);
+    if (factory)
+        IWICImagingFactory_Release(factory);
+    return hr;
+}
+
+HRESULT create_d3d_texture(ID3D11Device *device, D3DX11_IMAGE_LOAD_INFO *load_info,
+        D3D11_SUBRESOURCE_DATA *resource_data, const struct texture_extra *extra, ID3D11Resource **texture)
+{
+    HRESULT hr;
+
+    if (extra && extra->dimension == D3D11_RESOURCE_DIMENSION_TEXTURE3D)
+    {
+        D3D11_TEXTURE3D_DESC desc;
+        ID3D11Texture3D *texture_3d;
+
+        memset(&desc, 0, sizeof(desc));
+        desc.Width = load_info->Width;
+        desc.Height = load_info->Height;
+        desc.Depth = load_info->Depth;
+        desc.MipLevels = load_info->MipLevels;
+        desc.Format = load_info->Format;
+        desc.Usage = load_info->Usage;
+        desc.BindFlags = load_info->BindFlags;
+        desc.CPUAccessFlags = load_info->CpuAccessFlags;
+        desc.MiscFlags = load_info->MiscFlags;
+        if (FAILED(hr = ID3D11Device_CreateTexture3D(device, &desc, resource_data, &texture_3d)))
+            return hr;
+        *texture = (ID3D11Resource *)texture_3d;
+        return S_OK;
+    }
+    else
+    {
+        D3D11_TEXTURE2D_DESC texture_2d_desc;
+        ID3D11Texture2D *texture_2d;
+
+        memset(&texture_2d_desc, 0, sizeof(texture_2d_desc));
+        texture_2d_desc.Width = load_info->Width;
+        texture_2d_desc.Height = load_info->Height;
+        texture_2d_desc.MipLevels = load_info->MipLevels;
+        texture_2d_desc.ArraySize = extra ? extra->array_size : (load_info->MiscFlags & D3D11_RESOURCE_MISC_TEXTURECUBE ? 6 : 1);
+        texture_2d_desc.Format = load_info->Format;
+        texture_2d_desc.SampleDesc.Count = 1;
+        texture_2d_desc.Usage = load_info->Usage;
+        texture_2d_desc.BindFlags = load_info->BindFlags;
+        texture_2d_desc.CPUAccessFlags = load_info->CpuAccessFlags;
+        texture_2d_desc.MiscFlags = load_info->MiscFlags;
+
+        if (FAILED(hr = ID3D11Device_CreateTexture2D(device, &texture_2d_desc, resource_data, &texture_2d)))
+            return hr;
+        *texture = (ID3D11Resource *)texture_2d;
+        return S_OK;
+    }
+}
