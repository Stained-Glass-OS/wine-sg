+static HRESULT WINAPI copydataloader_Destroy(ID3DX11DataLoader *iface)
+{
+    struct asyncdataloader *loader = impl_from_ID3DX11DataLoader(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    free(loader->data);
+    free(loader);
+    return S_OK;
