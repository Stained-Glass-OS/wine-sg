+static HRESULT queue_info_work(ID3DX11ThreadPump *pump, HRESULT loader_hr, ID3DX11DataLoader *loader,
+        D3DX11_IMAGE_INFO *info, HRESULT *result)
+{
+    ID3DX11DataProcessor *processor;
+    HRESULT hr;
+
+    if (FAILED(loader_hr))
+        return loader_hr;
+    if (FAILED(hr = D3DX11CreateAsyncTextureInfoProcessor(info, &processor)))
+    {
+        ID3DX11DataLoader_Destroy(loader);
+        return hr;
+    }
+    if (FAILED(hr = ID3DX11ThreadPump_AddWorkItem(pump, loader, processor, result, NULL)))
+    {
+        ID3DX11DataLoader_Destroy(loader);
+        ID3DX11DataProcessor_Destroy(processor);
+    }
+    return hr;
+}
+
+static HRESULT queue_texture_work(ID3DX11ThreadPump *pump, HRESULT loader_hr, ID3DX11DataLoader *loader,
+        ID3D11Device *device, D3DX11_IMAGE_LOAD_INFO *load_info, void **object, BOOL view, HRESULT *hresult)
+{
+    ID3DX11DataProcessor *processor;
+    HRESULT hr;
+
+    if (FAILED(loader_hr))
+        return loader_hr;
+    if (view)
+        hr = D3DX11CreateAsyncShaderResourceViewProcessor(device, load_info, &processor);
+    else
+        hr = D3DX11CreateAsyncTextureProcessor(device, load_info, &processor);
+    if (FAILED(hr))
+    {
+        ID3DX11DataLoader_Destroy(loader);
+        return hr;
+    }
+    if (FAILED(hr = ID3DX11ThreadPump_AddWorkItem(pump, loader, processor, hresult, object)))
+    {
+        ID3DX11DataLoader_Destroy(loader);
+        ID3DX11DataProcessor_Destroy(processor);
+    }
+    return hr;
+}
