 #include "d3dx11_private.h"
@@ -50,36 +49,427 @@ static WCHAR *ansi_to_wide(const char *str)
     return ret;
 }
 
+static char *dup_str(const char *str)
+{
+    return str ? strdup(str) : NULL;
+}
+
+enum job_kind
+{
+    JOB_COMPILE,
+    JOB_PREPROCESS,
+};
+
+/* Where the bytes of a job come from. */
+enum source_type
+{
+    SOURCE_MEMORY,
+    SOURCE_FILE_W,
+    SOURCE_RESOURCE_A,
+    SOURCE_RESOURCE_W,
+};
+
+struct source
+{
+    enum source_type type;
+    const void *data;
+    SIZE_T size;
+    const WCHAR *path;
+    HMODULE module;
+    const void *name;
+};
+
+struct job_params
+{
+    enum job_kind kind;
+    const char *filename;
+    const D3D10_SHADER_MACRO *defines;
+    ID3D10Include *include;
+    const char *entry;
+    const char *target;
+    UINT sflags, eflags;
+};
+
+/* Compiles or preprocesses. */
+static HRESULT job_process(const struct job_params *p, const void *data, SIZE_T size,
+        ID3D10Blob **result, ID3D10Blob **errors)
+{
+    ID3D10Include *include = p->include;
+
+    *result = NULL;
+    if (errors)
+        *errors = NULL;
+
+    switch (p->kind)
+    {
+        case JOB_COMPILE:
+            return D3DCompile(data, size, p->filename, p->defines, include, p->entry, p->target,
+                    p->sflags, p->eflags, result, errors);
+
+        case JOB_PREPROCESS:
+            return D3DPreprocess(data, size, p->filename, p->defines, include, result, errors);
+
+    }
+    return E_FAIL;
+}
+
+static HRESULT job_create_object(const struct job_params *p, ID3D10Blob *code, void **object)
+{
+    if (!object)
+        return E_INVALIDARG;
+
+    switch (p->kind)
+    {
+        case JOB_COMPILE:
+        case JOB_PREPROCESS:
+            ID3D10Blob_AddRef(code);
+            *object = code;
+            return S_OK;
+
+    }
+    return E_FAIL;
+}
+
+/* ---- asynchronous processor ---- */
+
+struct shader_processor
+{
+    ID3DX11DataProcessor ID3DX11DataProcessor_iface;
+    struct job_params params;
+    char *filename, *entry, *target;
+    D3D10_SHADER_MACRO *defines;
+    ID3D10Blob **out_object, **out_errors;
+    ID3D10Blob *code;
+};
+
+static inline struct shader_processor *impl_from_shader_processor(ID3DX11DataProcessor *iface)
+{
+    return CONTAINING_RECORD(iface, struct shader_processor, ID3DX11DataProcessor_iface);
+}
+
+static HRESULT WINAPI shader_processor_Process(ID3DX11DataProcessor *iface, void *data, SIZE_T size)
+{
+    struct shader_processor *processor = impl_from_shader_processor(iface);
+    ID3D10Blob *errors = NULL;
+    HRESULT hr;
+
+    TRACE("iface %p, data %p, size %Iu.\n", iface, data, size);
+
+    if (processor->code)
+    {
+        ID3D10Blob_Release(processor->code);
+        processor->code = NULL;
+    }
+    hr = job_process(&processor->params, data, size, &processor->code, &errors);
+    if (errors)
+    {
+        if (processor->out_errors)
+            *processor->out_errors = errors;
+        else
+            ID3D10Blob_Release(errors);
+    }
+    return hr;
+}
+
+static HRESULT WINAPI shader_processor_CreateDeviceObject(ID3DX11DataProcessor *iface, void **object)
+{
+    struct shader_processor *processor = impl_from_shader_processor(iface);
+    void *dummy;
+
+    TRACE("iface %p, object %p.\n", iface, object);
+
+    if (!processor->code)
+        return E_FAIL;
+    if (!object)
+        object = processor->out_object ? (void **)processor->out_object : &dummy;
+    return job_create_object(&processor->params, processor->code, object);
+}
+
+static HRESULT WINAPI shader_processor_Destroy(ID3DX11DataProcessor *iface)
+{
+    struct shader_processor *processor = impl_from_shader_processor(iface);
+    unsigned int i;
+
+    TRACE("iface %p.\n", iface);
+
+    if (processor->code)
+        ID3D10Blob_Release(processor->code);
+    if (processor->defines)
+    {
+        for (i = 0; processor->defines[i].Name; ++i)
+        {
+            free((char *)processor->defines[i].Name);
+            free((char *)processor->defines[i].Definition);
+        }
+        free(processor->defines);
+    }
+    free(processor->filename);
+    free(processor->entry);
+    free(processor->target);
+    free(processor);
+    return S_OK;
+}
+
+static const ID3DX11DataProcessorVtbl shader_processor_vtbl =
+{
+    shader_processor_Process,
+    shader_processor_CreateDeviceObject,
+    shader_processor_Destroy,
+};
+
+static HRESULT shader_processor_create(const struct job_params *params, ID3D10Blob **out_object,
+        ID3D10Blob **out_errors, ID3DX11DataProcessor **out)
+{
+    struct shader_processor *object;
+    unsigned int i, count = 0;
+
+    if (!out)
+        return E_INVALIDARG;
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->ID3DX11DataProcessor_iface.lpVtbl = &shader_processor_vtbl;
+    object->params = *params;
+    object->out_object = out_object;
+    object->out_errors = out_errors;
+    object->filename = dup_str(params->filename);
+    object->entry = dup_str(params->entry);
+    object->target = dup_str(params->target);
+    object->params.filename = object->filename;
+    object->params.entry = object->entry;
+    object->params.target = object->target;
+    object->params.defines = NULL;
+
+    if (params->defines)
+    {
+        while (params->defines[count].Name)
+            ++count;
+        if (!(object->defines = calloc(count + 1, sizeof(*object->defines))))
+            goto oom;
+        for (i = 0; i < count; ++i)
+        {
+            object->defines[i].Name = dup_str(params->defines[i].Name);
+            object->defines[i].Definition = dup_str(params->defines[i].Definition);
+        }
+        object->params.defines = object->defines;
+    }
+    *out = &object->ID3DX11DataProcessor_iface;
+    return S_OK;
+
+oom:
+    shader_processor_Destroy(&object->ID3DX11DataProcessor_iface);
+    return E_OUTOFMEMORY;
+}
+
+HRESULT WINAPI D3DX11CreateAsyncCompilerProcessor(const char *filename, const D3D10_SHADER_MACRO *defines,
+        ID3D10Include *include, const char *entry_point, const char *target, UINT sflags, UINT eflags,
+        ID3D10Blob **shader, ID3D10Blob **errors, ID3DX11DataProcessor **processor)
+{
+    struct job_params params = {JOB_COMPILE, filename, defines, include, entry_point, target, sflags, eflags};
+
+    TRACE("filename %s, defines %p, include %p, entry_point %s, target %s, sflags %#x, eflags %#x, shader %p, "
+            "errors %p, processor %p.\n", debugstr_a(filename), defines, include, debugstr_a(entry_point),
+            debugstr_a(target), sflags, eflags, shader, errors, processor);
+
+    if (!entry_point || !target || !processor)
+        return E_INVALIDARG;
+    return shader_processor_create(&params, shader, errors, processor);
+}
+
+HRESULT WINAPI D3DX11CreateAsyncShaderPreprocessProcessor(const char *filename, const D3D10_SHADER_MACRO *defines,
+        ID3D10Include *include, ID3D10Blob **shader_text, ID3D10Blob **errors, ID3DX11DataProcessor **processor)
+{
+    struct job_params params = {JOB_PREPROCESS, filename, defines, include};
+
+    TRACE("filename %s, defines %p, include %p, shader_text %p, errors %p, processor %p.\n",
+            debugstr_a(filename), defines, include, shader_text, errors, processor);
+
+    if (!processor)
+        return E_INVALIDARG;
+    return shader_processor_create(&params, shader_text, errors, processor);
+}
+
+/* ---- driving a job: synchronously or through a pump ---- */
+
+static HRESULT source_load(const struct source *src, void **data, DWORD *size, BOOL *owned)
+{
+    *owned = FALSE;
+    switch (src->type)
+    {
+        case SOURCE_MEMORY:
+            *data = (void *)src->data;
+            *size = src->size;
+            return S_OK;
+        case SOURCE_FILE_W:
+            *owned = TRUE;
+            return load_file(src->path, data, size);
+        case SOURCE_RESOURCE_A:
+            return load_resourceA(src->module, src->name, data, size);
+        case SOURCE_RESOURCE_W:
+            return load_resourceW(src->module, src->name, data, size);
+    }
+    return E_FAIL;
+}
+
+static HRESULT source_make_loader(const struct source *src, ID3DX11DataLoader **loader)
+{
+    switch (src->type)
+    {
+        case SOURCE_MEMORY:
+            return create_copy_loader(src->data, src->size, loader);
+        case SOURCE_FILE_W:
+            return D3DX11CreateAsyncFileLoaderW(src->path, loader);
+        case SOURCE_RESOURCE_A:
+            return D3DX11CreateAsyncResourceLoaderA(src->module, src->name, loader);
+        case SOURCE_RESOURCE_W:
+            return D3DX11CreateAsyncResourceLoaderW(src->module, src->name, loader);
+    }
+    return E_FAIL;
+}
+
+/* object is the output of an effect/effect pool, or the shader blob of a compile; errors always receives the log. */
+static HRESULT run_job(const struct job_params *params, const struct source *src, ID3DX11ThreadPump *pump,
+        void **object, ID3D10Blob **errors, HRESULT *hresult)
+{
+    ID3DX11DataProcessor *processor;
+    ID3DX11DataLoader *loader;
+    ID3D10Blob *code = NULL;
+    BOOL owned;
+    DWORD size;
+    void *data;
+    HRESULT hr;
+
+    if (pump)
+    {
+        if (FAILED(hr = source_make_loader(src, &loader)))
+            return hr;
+        if (FAILED(hr = shader_processor_create(params, NULL, errors, &processor)))
+        {
+            ID3DX11DataLoader_Destroy(loader);
+            return hr;
+        }
+        if (FAILED(hr = ID3DX11ThreadPump_AddWorkItem(pump, loader, processor, hresult, object)))
+        {
+            ID3DX11DataLoader_Destroy(loader);
+            ID3DX11DataProcessor_Destroy(processor);
+        }
+        return hr;
+    }
+
+    /* only a missing file clears the log; a failing resource lookup leaves it alone */
+    if (errors && src->type == SOURCE_FILE_W)
+        *errors = NULL;
+
+    if (SUCCEEDED(hr = source_load(src, &data, &size, &owned)))
+    {
+        hr = job_process(params, data, size, &code, errors);
+        if (owned)
+            free(data);
+        if (SUCCEEDED(hr))
+        {
+            hr = job_create_object(params, code, object);
+            ID3D10Blob_Release(code);
+            if (params->kind == JOB_COMPILE || params->kind == JOB_PREPROCESS)
+            {
+                /* job_create_object took its own reference; the caller owns that one */
+            }
+        }
+    }
+    if (hresult)
+        *hresult = hr;
+    return hr;
+}
+
+/* ---- shader compiling and preprocessing ---- */
+
+HRESULT WINAPI D3DX11CompileFromMemory(const char *data, SIZE_T data_size, const char *filename,
+        const D3D10_SHADER_MACRO *defines, ID3D10Include *include, const char *entry_point,
+        const char *target, UINT sflags, UINT eflags, ID3DX11ThreadPump *pump, ID3D10Blob **shader,
