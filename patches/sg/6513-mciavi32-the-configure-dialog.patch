From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mciavi32: The configure dialog (6513)

MCI_CONFIGURE on an AVI device was a stub and DRV_CONFIGURE showed a
"Sample AVI Wine Driver !" message box. Both show a playback options
dialog now: play in a window or full screen, zoom by 2, skip frames if
behind, with defaults. The options are kept per user and used: a play
without "window" or "fullscreen" follows the choice, and a movie
opens at twice its size with zoom by 2.
---
diff --git a/dlls/mciavi32/Makefile.in b/dlls/mciavi32/Makefile.in
index a1c211b..877cc17 100644
--- a/dlls/mciavi32/Makefile.in
+++ b/dlls/mciavi32/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = mciavi32.dll
-IMPORTS   = msvfw32 winmm user32 gdi32
+IMPORTS   = msvfw32 winmm user32 gdi32 advapi32
 
 SOURCES = \
 	info.c \
diff --git a/dlls/mciavi32/mciavi.c b/dlls/mciavi32/mciavi.c
index 6b50cfd..7c97181 100644
--- a/dlls/mciavi32/mciavi.c
+++ b/dlls/mciavi32/mciavi.c
@@ -134,21 +134,100 @@ static	DWORD	MCIAVI_drvClose(DWORD dwDevID)
 /**************************************************************************
  * 				MCIAVI_drvConfigure		[internal]
  */
-static	DWORD	MCIAVI_drvConfigure(DWORD dwDevID)
+static const WCHAR options_key[] = L"Software\\Stained Glass\\MCIAVI";
+
+/* Stained Glass OS (wine-sg 6513): the options of the configure dialog, per user */
+void MCIAVI_GetOptions(struct mciavi_options *options)
 {
-    WINE_MCIAVI *wma;
+    DWORD value, size;
+
+    options->fullscreen = FALSE;
+    options->zoom2 = FALSE;
+    options->skip_frames = TRUE;
+    size = sizeof(value);
+    if (!RegGetValueW(HKEY_CURRENT_USER, options_key, L"FullScreen", RRF_RT_REG_DWORD, NULL, &value, &size))
+        options->fullscreen = !!value;
+    size = sizeof(value);
+    if (!RegGetValueW(HKEY_CURRENT_USER, options_key, L"ZoomBy2", RRF_RT_REG_DWORD, NULL, &value, &size))
+        options->zoom2 = !!value;
+    size = sizeof(value);
+    if (!RegGetValueW(HKEY_CURRENT_USER, options_key, L"SkipFrames", RRF_RT_REG_DWORD, NULL, &value, &size))
+        options->skip_frames = !!value;
+}
 
-    TRACE("%04lx\n", dwDevID);
+static void set_options(const struct mciavi_options *options)
+{
+    DWORD value;
+    HKEY key;
+
+    if (RegCreateKeyExW(HKEY_CURRENT_USER, options_key, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL)) return;
+    value = options->fullscreen;
+    RegSetValueExW(key, L"FullScreen", 0, REG_DWORD, (BYTE *)&value, sizeof(value));
+    value = options->zoom2;
+    RegSetValueExW(key, L"ZoomBy2", 0, REG_DWORD, (BYTE *)&value, sizeof(value));
+    value = options->skip_frames;
+    RegSetValueExW(key, L"SkipFrames", 0, REG_DWORD, (BYTE *)&value, sizeof(value));
+    RegCloseKey(key);
+}
 
-    MCIAVI_mciStop(dwDevID, MCI_WAIT, NULL);
+static void show_options(HWND dlg, const struct mciavi_options *options)
+{
+    CheckRadioButton(dlg, IDC_MCIAVI_WINDOW, IDC_MCIAVI_FULL, options->fullscreen ? IDC_MCIAVI_FULL : IDC_MCIAVI_WINDOW);
+    CheckDlgButton(dlg, IDC_MCIAVI_ZOOM2, options->zoom2 ? BST_CHECKED : BST_UNCHECKED);
+    CheckDlgButton(dlg, IDC_MCIAVI_SKIP, options->skip_frames ? BST_CHECKED : BST_UNCHECKED);
+}
 
-    wma = (WINE_MCIAVI*)mciGetDriverData(dwDevID);
+static INT_PTR CALLBACK configure_proc(HWND dlg, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct mciavi_options options;
 
-    if (wma) {
-	MessageBoxA(0, "Sample AVI Wine Driver !", "MM-Wine Driver", MB_OK);
-	return 1;
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        MCIAVI_GetOptions(&options);
+        show_options(dlg, &options);
+        return TRUE;
+    case WM_COMMAND:
+        switch (LOWORD(wparam))
+        {
+        case IDC_MCIAVI_DEFAULTS:
+            options.fullscreen = options.zoom2 = FALSE;
+            options.skip_frames = TRUE;
+            show_options(dlg, &options);
+            return TRUE;
+        case IDOK:
+            options.fullscreen = IsDlgButtonChecked(dlg, IDC_MCIAVI_FULL) == BST_CHECKED;
+            options.zoom2 = IsDlgButtonChecked(dlg, IDC_MCIAVI_ZOOM2) == BST_CHECKED;
+            options.skip_frames = IsDlgButtonChecked(dlg, IDC_MCIAVI_SKIP) == BST_CHECKED;
+#ifndef SG_MUTANT_MCIAVI_OPTIONS_NOT_SAVED
+            set_options(&options);
+#endif
+            EndDialog(dlg, IDOK);
+            return TRUE;
+        case IDCANCEL:
+            EndDialog(dlg, IDCANCEL);
+            return TRUE;
+        }
+        break;
     }
-    return 0;
+    return FALSE;
+}
+
+static INT_PTR configure_dialog(HWND owner)
+{
+    return DialogBoxParamW(MCIAVI_hInstance, MAKEINTRESOURCEW(IDD_MCIAVI_CONFIGURE), owner, configure_proc, 0);
+}
+
+/**************************************************************************
+ * 				MCIAVI_drvConfigure		[internal]
+ */
+static	DWORD	MCIAVI_drvConfigure(DWORD dwDevID)
+{
+    TRACE("%04lx\n", dwDevID);
+
+    /* the configure dialog (it was a "Sample AVI Wine Driver !" message box) */
+    configure_dialog(NULL);
+    return DRVCNF_OK;
 }
 
 /**************************************************************************
@@ -557,8 +636,15 @@ static	DWORD	MCIAVI_mciPlay(UINT wDevID, DWORD dwFlags, LPMCI_PLAY_PARMS lpParms
     if (dwFlags & MCI_DGV_PLAY_REVERSE) return MCIERR_UNSUPPORTED_FUNCTION;
     if (dwFlags & MCI_TEST)	return 0;
 
-    if (dwFlags & (MCI_MCIAVI_PLAY_WINDOW|MCI_MCIAVI_PLAY_FULLBY2))
+    if (dwFlags & MCI_MCIAVI_PLAY_FULLBY2)
 	FIXME("Unsupported flag %08lx\n", dwFlags);
+    if (!(dwFlags & (MCI_MCIAVI_PLAY_WINDOW | MCI_MCIAVI_PLAY_FULLSCREEN)))
+    {
+        /* the configure dialog's choice */
+        struct mciavi_options options;
+        MCIAVI_GetOptions(&options);
+        if (options.fullscreen) dwFlags |= MCI_MCIAVI_PLAY_FULLSCREEN;
+    }
 
     EnterCriticalSection(&wma->cs);
 
@@ -1111,7 +1197,7 @@ static	DWORD	MCIAVI_mciConfigure(UINT wDevID, DWORD dwFlags, LPMCI_GENERIC_PARMS
 {
     WINE_MCIAVI *wma;
 
-    FIXME("(%04x, %08lx, %p) : stub\n", wDevID, dwFlags, lpParms);
+    TRACE("(%04x, %08lx, %p)\n", wDevID, dwFlags, lpParms);
 
     if (lpParms == NULL)	return MCIERR_NULL_PARAMETER_BLOCK;
 
@@ -1119,6 +1205,10 @@ static	DWORD	MCIAVI_mciConfigure(UINT wDevID, DWORD dwFlags, LPMCI_GENERIC_PARMS
     if (wma == NULL)		return MCIERR_INVALID_DEVICE_ID;
     if (dwFlags & MCI_TEST)	return 0;
 
+    /* the options for the next plays and opens (it was a stub) */
+    configure_dialog(wma->hWndPaint && IsWindowVisible(wma->hWndPaint) ? wma->hWndPaint : GetActiveWindow());
+    if (dwFlags & MCI_NOTIFY)
+        mciDriverNotify(HWND_32(LOWORD(lpParms->dwCallback)), wDevID, MCI_NOTIFY_SUCCESSFUL);
     return 0;
 }
 
diff --git a/dlls/mciavi32/mciavi_res.rc b/dlls/mciavi32/mciavi_res.rc
index 0aae615..854456c 100644
--- a/dlls/mciavi32/mciavi_res.rc
+++ b/dlls/mciavi32/mciavi_res.rc
@@ -21,6 +21,7 @@
 #include "winbase.h"
 #include "mmddk.h"
 #include "digitalv.h"
+#include "private_mciavi.h"
 
 #define MCI_DWORD_PTR 13 /* MCI_INTEGER64 */
 
@@ -567,6 +568,22 @@ L"\0", 0x00000000L, MCI_END_COMMAND,
 L"\0", 0x00000000L, MCI_END_COMMAND_LIST
 END
 
+/* the configure dialog (MCI_CONFIGURE, DRV_CONFIGURE) */
+IDD_MCIAVI_CONFIGURE DIALOG 0, 0, 196, 104
+STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
+CAPTION "Video Playback Options"
+FONT 8, "MS Shell Dlg"
+BEGIN
+    GROUPBOX        "Play video in", -1, 7, 7, 120, 44
+    AUTORADIOBUTTON "&Window", IDC_MCIAVI_WINDOW, 14, 20, 100, 10, WS_GROUP | WS_TABSTOP
+    AUTORADIOBUTTON "&Full screen", IDC_MCIAVI_FULL, 14, 34, 100, 10
+    AUTOCHECKBOX    "&Zoom by 2", IDC_MCIAVI_ZOOM2, 7, 58, 120, 10, WS_GROUP | WS_TABSTOP
+    AUTOCHECKBOX    "&Skip video frames if behind", IDC_MCIAVI_SKIP, 7, 72, 120, 10, WS_TABSTOP
+    DEFPUSHBUTTON   "OK", IDOK, 136, 7, 53, 14, WS_GROUP
+    PUSHBUTTON      "Cancel", IDCANCEL, 136, 25, 53, 14
+    PUSHBUTTON      "&Defaults", IDC_MCIAVI_DEFAULTS, 136, 83, 53, 14
+END
+
 STRINGTABLE
 BEGIN
 
diff --git a/dlls/mciavi32/mmoutput.c b/dlls/mciavi32/mmoutput.c
index ed15745..1072fc4 100644
--- a/dlls/mciavi32/mmoutput.c
+++ b/dlls/mciavi32/mmoutput.c
@@ -130,6 +130,12 @@ static BOOL MCIAVI_GetInfoVideo(WINE_MCIAVI* wma, const MMCKINFO* mmckList, MMCK
 
     SetRect(&wma->source, 0, 0, wma->inbih->biWidth, wma->inbih->biHeight);
     wma->dest = wma->source;
+    {
+        /* the configure dialog's "Zoom by 2" */
+        struct mciavi_options options;
+        MCIAVI_GetOptions(&options);
+        if (options.zoom2) SetRect(&wma->dest, 0, 0, 2 * wma->inbih->biWidth, 2 * abs(wma->inbih->biHeight));
+    }
 
     return TRUE;
 }
diff --git a/dlls/mciavi32/private_mciavi.h b/dlls/mciavi32/private_mciavi.h
index 2d3404a..face308 100644
--- a/dlls/mciavi32/private_mciavi.h
+++ b/dlls/mciavi32/private_mciavi.h
@@ -99,6 +99,21 @@ typedef struct {
 
 extern HINSTANCE MCIAVI_hInstance;
 
+/* Stained Glass OS (wine-sg 6513): the configure dialog's options, per user */
+#define IDD_MCIAVI_CONFIGURE 0x100
+#define IDC_MCIAVI_WINDOW    0x101
+#define IDC_MCIAVI_FULL      0x102
+#define IDC_MCIAVI_ZOOM2     0x103
+#define IDC_MCIAVI_SKIP      0x104
+#define IDC_MCIAVI_DEFAULTS  0x105
+struct mciavi_options
+{
+    BOOL fullscreen;    /* play full screen unless the play says "window" */
+    BOOL zoom2;         /* open movies at twice their size */
+    BOOL skip_frames;   /* drop frames to keep time (the player always does) */
+};
+extern void MCIAVI_GetOptions(struct mciavi_options *options);
+
 /* info.c */
 DWORD 	MCIAVI_ConvertTimeFormatToFrame(WINE_MCIAVI* wma, DWORD val);
 DWORD	MCIAVI_mciGetDevCaps(UINT wDevID, DWORD dwFlags,  LPMCI_GETDEVCAPS_PARMS lpParms);
