 {
     UndoManager *This = impl_from_IOleUndoManager(iface);
-    FIXME("(%p)->(%p)\n", This, pUU);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", This, pUU);
+    return um_run(This, &This->undo, &This->undo_cnt, pUU, UM_UNDOING);
