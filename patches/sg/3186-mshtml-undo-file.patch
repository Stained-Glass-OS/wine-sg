+static HRESULT um_add_unit(UndoManager *This, IOleUndoUnit *unit)
+{
+    IOleUndoUnit ***arr = This->mode == UM_UNDOING ? &This->redo : &This->undo;
+    unsigned *cnt = This->mode == UM_UNDOING ? &This->redo_cnt : &This->undo_cnt;
+    unsigned *size = This->mode == UM_UNDOING ? &This->redo_size : &This->undo_size;
+
+#ifndef SG_MUTANT_UNDO_NOCLEAR
+    if(This->mode == UM_NORMAL)
+        um_discard(&This->redo, &This->redo_cnt, 0);
+#endif   /* a new action ends the redo history */
+    if(!um_push((void***)arr, cnt, size, unit))
+        return E_OUTOFMEMORY;
+    IOleUndoUnit_AddRef(unit);
+    return S_OK;
 }
 
 static HRESULT WINAPI OleUndoManager_Close(IOleUndoManager *iface, IOleParentUndoUnit *pPUU,
         BOOL fCommit)
 {
     UndoManager *This = impl_from_IOleUndoManager(iface);
-    FIXME("(%p)->(%p %x)\n", This, pPUU, fCommit);
-    return E_NOTIMPL;
+    IOleParentUndoUnit *top;
+    HRESULT hres = S_OK;
+
+    TRACE("(%p)->(%p %x)\n", This, pPUU, fCommit);
+
+    if(!pPUU)
+        return E_INVALIDARG;
+    if(This->disabled)
+        return S_OK;
+    if(!This->open_cnt || This->open[This->open_cnt - 1] != pPUU)
+        return E_INVALIDARG;
+
+    top = This->open[--This->open_cnt];
+    if(This->open_cnt) {
+        /* a nested unit: the enclosing parent keeps it when committed */
+        IOleParentUndoUnit *parent = This->open[This->open_cnt - 1];
+        hres = IOleParentUndoUnit_Close(parent, top, fCommit);
+    }else if(fCommit) {
+        hres = um_add_unit(This, (IOleUndoUnit*)top);
+    }
+    IOleParentUndoUnit_Release(top);
+    return hres;
 }
 
