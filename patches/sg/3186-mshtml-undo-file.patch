+static BOOL um_find(IOleUndoUnit **arr, unsigned cnt, IOleUndoUnit *unit, unsigned *idx)
+{
+    unsigned i;
+    for(i = 0; i < cnt; i++) {
+        IUnknown *a = NULL, *b = NULL;
+        BOOL same;
+        IOleUndoUnit_QueryInterface(arr[i], &IID_IUnknown, (void**)&a);
+        IOleUndoUnit_QueryInterface(unit, &IID_IUnknown, (void**)&b);
+        same = a && a == b;
+        if(a) IUnknown_Release(a);
+        if(b) IUnknown_Release(b);
+        if(same) { *idx = i; return TRUE; }
+    }
+    return FALSE;
 }
 
 static HRESULT WINAPI OleUndoManager_DiscardFrom(IOleUndoManager *iface, IOleUndoUnit *pUU)
 {
     UndoManager *This = impl_from_IOleUndoManager(iface);
-    FIXME("(%p)->(%p)\n", This, pUU);
+    unsigned idx = 0;
+
+    TRACE("(%p)->(%p)\n", This, pUU);
+
+    if(pUU && !um_find(This->undo, This->undo_cnt, pUU, &idx))
+        return E_INVALIDARG;
+    um_discard(&This->undo, &This->undo_cnt, idx);   /* the unit and everything added after it */
+    um_discard(&This->redo, &This->redo_cnt, 0);
     return S_OK;
 }
 
+static HRESULT um_run(UndoManager *This, IOleUndoUnit ***arr, unsigned *cnt, IOleUndoUnit *pUU, int mode)
+{
+    unsigned idx;
+    HRESULT hres = S_OK;
+
+    if(This->open_cnt)
+        return E_UNEXPECTED;
+    if(!*cnt)
+        return E_FAIL;
+    if(pUU) {
+        if(!um_find(*arr, *cnt, pUU, &idx))
+            return E_INVALIDARG;
+    }else {
+        idx = *cnt - 1;   /* NULL: the most recent unit only */
+    }
+
+    This->mode = mode;
+    while(*cnt > idx && SUCCEEDED(hres)) {
+        IOleUndoUnit *unit = (*arr)[--*cnt];
+        hres = IOleUndoUnit_Do(unit, &This->IOleUndoManager_iface);
+        IOleUndoUnit_Release(unit);
+    }
+    This->mode = UM_NORMAL;
+    return hres;
+}
+
