+typedef struct {
+    IEnumOleUndoUnits IEnumOleUndoUnits_iface;
+    LONG ref;
+    IOleUndoUnit **units;   /* most recent first */
+    unsigned cnt, pos;
+} EnumUndoUnits;
+
+static inline EnumUndoUnits *impl_from_IEnumOleUndoUnits(IEnumOleUndoUnits *iface)
+{
+    return CONTAINING_RECORD(iface, EnumUndoUnits, IEnumOleUndoUnits_iface);
+}
+
+static HRESULT WINAPI EnumUndoUnits_QueryInterface(IEnumOleUndoUnits *iface, REFIID riid, void **ppv)
+{
+    EnumUndoUnits *This = impl_from_IEnumOleUndoUnits(iface);
+
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumOleUndoUnits)) {
+        *ppv = &This->IEnumOleUndoUnits_iface;
+        IUnknown_AddRef((IUnknown*)*ppv);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EnumUndoUnits_AddRef(IEnumOleUndoUnits *iface)
+{
+    EnumUndoUnits *This = impl_from_IEnumOleUndoUnits(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI EnumUndoUnits_Release(IEnumOleUndoUnits *iface)
+{
+    EnumUndoUnits *This = impl_from_IEnumOleUndoUnits(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        while(This->cnt)
+            IOleUndoUnit_Release(This->units[--This->cnt]);
+        free(This->units);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI EnumUndoUnits_Next(IEnumOleUndoUnits *iface, ULONG celt, IOleUndoUnit **rgelt, ULONG *pceltFetched)
+{
+    EnumUndoUnits *This = impl_from_IEnumOleUndoUnits(iface);
+    ULONG n = 0;
+
+    TRACE("(%p)->(%lu %p %p)\n", This, celt, rgelt, pceltFetched);
+
+    if(!rgelt || (!pceltFetched && celt != 1))
+        return E_POINTER;
+    while(n < celt && This->pos < This->cnt) {
+        rgelt[n] = This->units[This->pos++];
+        IOleUndoUnit_AddRef(rgelt[n++]);
+    }
+    if(pceltFetched)
+        *pceltFetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumUndoUnits_Skip(IEnumOleUndoUnits *iface, ULONG celt)
+{
+    EnumUndoUnits *This = impl_from_IEnumOleUndoUnits(iface);
+
+    TRACE("(%p)->(%lu)\n", This, celt);
+
+    if(This->pos + celt > This->cnt) {
+        This->pos = This->cnt;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumUndoUnits_Reset(IEnumOleUndoUnits *iface)
+{
+    EnumUndoUnits *This = impl_from_IEnumOleUndoUnits(iface);
+    This->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_enum_units(IOleUndoUnit **arr, unsigned cnt, unsigned pos, IEnumOleUndoUnits **ret);
+
+static HRESULT WINAPI EnumUndoUnits_Clone(IEnumOleUndoUnits *iface, IEnumOleUndoUnits **ppEnum)
+{
+    EnumUndoUnits *This = impl_from_IEnumOleUndoUnits(iface);
+
+    TRACE("(%p)->(%p)\n", This, ppEnum);
+
+    if(!ppEnum)
+        return E_POINTER;
+    return create_enum_units(This->units, This->cnt, This->pos, ppEnum);
+}
+
+static const IEnumOleUndoUnitsVtbl EnumUndoUnitsVtbl = {
+    EnumUndoUnits_QueryInterface,
+    EnumUndoUnits_AddRef,
+    EnumUndoUnits_Release,
+    EnumUndoUnits_Next,
+    EnumUndoUnits_Skip,
+    EnumUndoUnits_Reset,
+    EnumUndoUnits_Clone
+};
+
+/* arr is given in the order it should be enumerated */
+static HRESULT create_enum_units(IOleUndoUnit **arr, unsigned cnt, unsigned pos, IEnumOleUndoUnits **ret)
+{
+    EnumUndoUnits *e;
+    unsigned i;
+
+    if(!(e = calloc(1, sizeof(*e))))
+        return E_OUTOFMEMORY;
+    if(cnt && !(e->units = malloc(cnt * sizeof(*e->units)))) {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    e->IEnumOleUndoUnits_iface.lpVtbl = &EnumUndoUnitsVtbl;
+    e->ref = 1;
+    e->cnt = cnt;
+    e->pos = pos;
+    for(i = 0; i < cnt; i++) {
+        e->units[i] = arr[i];
+        IOleUndoUnit_AddRef(arr[i]);
+    }
+    *ret = &e->IEnumOleUndoUnits_iface;
+    return S_OK;
+}
+
+static HRESULT enum_stack(IOleUndoUnit **arr, unsigned cnt, IEnumOleUndoUnits **ret)
+{
+    IOleUndoUnit **rev = NULL;
+    unsigned i;
+    HRESULT hres;
+
+    if(!ret)
+        return E_POINTER;
+    if(cnt && !(rev = malloc(cnt * sizeof(*rev))))
+        return E_OUTOFMEMORY;
+    for(i = 0; i < cnt; i++)
+#ifdef SG_MUTANT_UNDO_ORDER
+        rev[i] = arr[i];
+#else
+        rev[i] = arr[cnt - 1 - i];
+#endif
+    hres = create_enum_units(rev, cnt, 0, ret);
+    free(rev);
+    return hres;
 }
 
