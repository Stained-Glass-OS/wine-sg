+static BOOL um_push(void ***arr, unsigned *cnt, unsigned *size, void *unit)
+{
+    if(*cnt == *size) {
+        unsigned new_size = *size ? *size * 2 : 8;
+        void **n = realloc(*arr, new_size * sizeof(*n));
+        if(!n) return FALSE;
+        *arr = n;
+        *size = new_size;
+    }
+    (*arr)[(*cnt)++] = unit;
+    return TRUE;
+}
+
+static void um_discard(IOleUndoUnit ***arr, unsigned *cnt, unsigned from)
+{
+    while(*cnt > from)
+        IOleUndoUnit_Release((*arr)[--*cnt]);
+}
