+
+/*
+ * A Frame is a ContentControl whose content is a page it made: Navigate(type, parameter) makes an
+ * object of that type (the application's, through its metadata provider, or ours), tells the page
+ * left (OnNavigatedFrom) and the page shown (OnNavigatedTo), sets the page's Frame and raises
+ * Navigated.  The pages left are kept as their types and parameters: GoBack and GoForward make them
+ * again.  Navigating, NavigationFailed and NavigationStopped are kept but not raised yet; transitions
+ * are not animated.  Interface identity per windows-rs 0.30.0 (MIT).
+ */
+
+#include <stdlib.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+#define CALL(o, slot, type) ((type)(((void **)((IUnknown *)(o))->lpVtbl)[slot]))
+
+enum navigation_mode { NAV_NEW, NAV_BACK, NAV_FORWARD, NAV_REFRESH };
+
+struct page_entry
+{
+    HSTRING name;
+    INT32 kind;
+    IInspectable *parameter;
+};
+
+struct page_stack
+{
+    struct page_entry *entries;
+    unsigned int count, size;
+};
+
+struct frame
+{
+    struct control c;
+    struct xiface IFrame_iface, IFrame2_iface, IFrame3_iface, IFrame5_iface, INavigate_iface;
+    struct handler_list navigated, navigating, failed, stopped;
+    struct page_entry current;      /* the page shown: its type and parameter (no name: none) */
+    struct page_stack back, forward;
+    INT32 cache_size;
+    boolean stack_enabled;
+};
+
+static struct xaml_property *prop_cache_size, *prop_can_go_back, *prop_can_go_forward, *prop_current_type,
+                            *prop_source_type, *prop_back_depth;
+
+static BOOL WINAPI init_frames( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR fr[] = L"Windows.UI.Xaml.Controls.Frame";
+
+    xaml_controls_init();
+    prop_cache_size = xaml_property_register( fr, L"CacheSize", L"Int32", xbox_int32( 10 ), FALSE, NULL );
+    prop_can_go_back = xaml_property_register( fr, L"CanGoBack", L"Boolean", xbox_boolean( FALSE ), FALSE, NULL );
+    prop_can_go_forward = xaml_property_register( fr, L"CanGoForward", L"Boolean", xbox_boolean( FALSE ), FALSE, NULL );
+    prop_current_type = xaml_property_register( fr, L"CurrentSourcePageType", L"Windows.UI.Xaml.Interop.TypeName", NULL, FALSE, NULL );
+    prop_source_type = xaml_property_register( fr, L"SourcePageType", L"Windows.UI.Xaml.Interop.TypeName", NULL, FALSE, NULL );
+    prop_back_depth = xaml_property_register( fr, L"BackStackDepth", L"Int32", xbox_int32( 0 ), FALSE, NULL );
+    return TRUE;
+}
+
+static void frames_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_frames, NULL, NULL );
+}
+
+static struct frame *frame_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct frame, c.e.d.obj );
+}
+
+/* ---- NavigationEventArgs ---- */
+
+struct nav_args
+{
+    struct xobj obj;
+    struct xiface INavigationEventArgs_iface, INavigationEventArgs2_iface;
+    IInspectable *content, *parameter, *uri;
+    struct xaml_type_name type;
+    INT32 mode;
+};
+
+static struct nav_args *nav_args_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct nav_args, obj );
+}
+
+static HRESULT get_object( IInspectable *obj, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    if ((*value = obj)) IInspectable_AddRef( obj );
+    return S_OK;
+}
+
+static HRESULT WINAPI nav_args_get_Content( struct xiface *iface, IInspectable **value )
+{
+    return get_object( nav_args_from_iface( iface )->content, value );
+}
+
+static HRESULT WINAPI nav_args_get_Parameter( struct xiface *iface, IInspectable **value )
+{
+    return get_object( nav_args_from_iface( iface )->parameter, value );
+}
+
+static HRESULT WINAPI nav_args_get_SourcePageType( struct xiface *iface, struct xaml_type_name *value )
+{
+    struct nav_args *args = nav_args_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    value->Kind = args->type.Kind;
+    return WindowsDuplicateString( args->type.Name, &value->Name );
+}
+
+static HRESULT WINAPI nav_args_get_NavigationMode( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = nav_args_from_iface( iface )->mode;
+    return S_OK;
+}
