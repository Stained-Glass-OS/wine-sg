+static void entry_clear( struct page_entry *entry )
+{
+    WindowsDeleteString( entry->name );
+    if (entry->parameter) IInspectable_Release( entry->parameter );
+    memset( entry, 0, sizeof(*entry) );
+}
+
+static void stack_clear( struct page_stack *stack )
+{
+    while (stack->count) entry_clear( &stack->entries[--stack->count] );
+}
+
+/* the entry moved onto the stack (it is left empty) */
+static BOOL stack_push( struct page_stack *stack, struct page_entry *entry )
+{
+    if (stack->count == stack->size)
+    {
+        unsigned int size = stack->size ? stack->size * 2 : 8;
+        struct page_entry *entries = realloc( stack->entries, size * sizeof(*entries) );
+        if (!entries) return FALSE;
+        stack->entries = entries;
+        stack->size = size;
+    }
+    stack->entries[stack->count++] = *entry;
+    memset( entry, 0, sizeof(*entry) );
+    return TRUE;
+}
+
+static void stacks_changed( struct frame *frame )
+{
+    IInspectable *box;
+
+    if ((box = xbox_boolean( frame->back.count != 0 )))
+    {
+        dobj_set_value( &frame->c.e.d, prop_can_go_back, box );
+        IInspectable_Release( box );
+    }
+    if ((box = xbox_boolean( frame->forward.count != 0 )))
+    {
+        dobj_set_value( &frame->c.e.d, prop_can_go_forward, box );
+        IInspectable_Release( box );
+    }
+    if ((box = xbox_int32( frame->back.count )))
+    {
+        dobj_set_value( &frame->c.e.d, prop_back_depth, box );
+        IInspectable_Release( box );
+    }
+}
+
+static IInspectable *frame_content( struct frame *frame )
+{
+    struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.Controls.ContentControl", L"Content" );
+    IInspectable *content = NULL;
+
+    if (prop) dobj_get_value( &frame->c.e.d, prop, &content );
+    return content;
+}
+
+/* IPageOverrides.OnNavigatedFrom (6) / OnNavigatedTo (7) of a page, if it is one */
+static void page_override( IInspectable *page, int slot, struct nav_args *args )
+{
+    IInspectable *overrides;
+
+    if (!page || FAILED(IInspectable_QueryInterface( page, &IID_IPageOverrides, (void **)&overrides ))) return;
+    CALL( overrides, slot, HRESULT (WINAPI *)( IInspectable *, IInspectable * ) )
+        ( overrides, (IInspectable *)&args->INavigationEventArgs_iface );
+    IInspectable_Release( overrides );
+}
+
+/* the page of the entry made and shown; the entry becomes the current one (it is left empty) */
+static HRESULT navigate( struct frame *frame, struct page_entry *entry, INT32 mode )
+{
+    struct xaml_property *content_prop = xaml_property_find( L"Windows.UI.Xaml.Controls.ContentControl", L"Content" );
+    IInspectable *page = NULL, *old_page, *frame_obj = (IInspectable *)&frame->IFrame_iface;
+    struct nav_args *args;
+    HRESULT hr;
+
+    TRACE( "%p: %s (kind %d), parameter %p, mode %d\n", frame, debugstr_hstring( entry->name ), entry->kind,
+           entry->parameter, mode );
+    if (FAILED(hr = xaml_activate_type( WindowsGetStringRawBuffer( entry->name, NULL ), &page )) || !page)
+    {
+        WARN( "no page %s, hr %#lx\n", debugstr_hstring( entry->name ), hr );
+        return FAILED(hr) ? hr : E_FAIL;
+    }
+
+    old_page = frame_content( frame );
+    if (old_page && (args = new_nav_args( page, entry, mode )))
+    {
+        page_override( old_page, 6, args );
+        IInspectable_Release( (IInspectable *)&args->INavigationEventArgs_iface );
+    }
+
+    if (frame->current.name)
+    {
+        if (mode == NAV_BACK) stack_push( &frame->forward, &frame->current );
+#ifndef SG_MUTANT_FRAME_NO_BACK_STACK
+        else if (mode == NAV_FORWARD || mode == NAV_NEW) stack_push( &frame->back, &frame->current );
+#endif
+        entry_clear( &frame->current );
+    }
+    if (mode == NAV_NEW) stack_clear( &frame->forward );
+    frame->current = *entry;
+    memset( entry, 0, sizeof(*entry) );
+    stacks_changed( frame );
+
+    xaml_page_set_frame( page, frame_obj );
+#ifndef SG_MUTANT_FRAME_NO_CONTENT
+    if (content_prop) dobj_set_value( &frame->c.e.d, content_prop, page );
+#endif
+
+    if ((args = new_nav_args( page, &frame->current, mode )))
+    {
+        xaml_raise_routed( &frame->navigated, frame_obj, (IInspectable *)&args->INavigationEventArgs_iface );
+        page_override( page, 7, args );
+        IInspectable_Release( (IInspectable *)&args->INavigationEventArgs_iface );
+    }
+    if (old_page) IInspectable_Release( old_page );
+    IInspectable_Release( page );
+    return S_OK;
+}
+
+static HRESULT navigate_to( struct frame *frame, struct xaml_type_name type, IInspectable *parameter, boolean *result )
+{
+    struct page_entry entry = { 0 };
+    HRESULT hr;
+
+    if (result) *result = FALSE;
+    if (!type.Name) return E_INVALIDARG;
+    if (FAILED(hr = WindowsDuplicateString( type.Name, &entry.name ))) return hr;
+    entry.kind = type.Kind;
+    if ((entry.parameter = parameter)) IInspectable_AddRef( parameter );
+    hr = navigate( frame, &entry, NAV_NEW );
+    entry_clear( &entry );
+    if (SUCCEEDED(hr) && result) *result = TRUE;
+    /* a page that cannot be made is a navigation that failed, not an error of the caller */
+    return S_OK;
+}
+
+static HRESULT go( struct frame *frame, struct page_stack *stack, INT32 mode )
+{
+    struct page_entry entry;
+    HRESULT hr;
+
+    if (!stack->count) return E_FAIL;
+    entry = stack->entries[--stack->count];
+    hr = navigate( frame, &entry, mode );
+    if (FAILED(hr)) stack_push( stack, &entry );   /* left where it was */
+    entry_clear( &entry );
+    stacks_changed( frame );
+    return hr;
+}
