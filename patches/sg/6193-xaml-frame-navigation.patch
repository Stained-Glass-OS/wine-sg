+/* ---- Windows.UI.Xaml.Interop.NotifyCollectionChangedEventArgs: INotifyCollectionChanged's arguments ---- */
+
+struct collection_changed_args
+{
+    struct xobj obj;
+    struct xiface iface;
+    INT32 action;
+    IInspectable *new_items, *old_items;
+    INT32 new_index, old_index;
+};
+
+static struct collection_changed_args *collection_changed_args_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct collection_changed_args, obj );
+}
+
+static void collection_changed_args_destroy( struct xobj *obj )
+{
+    struct collection_changed_args *args = CONTAINING_RECORD( obj, struct collection_changed_args, obj );
+
+    if (args->new_items) IInspectable_Release( args->new_items );
+    if (args->old_items) IInspectable_Release( args->old_items );
+    free( args );
+}
+
+static const struct xiface_entry collection_changed_args_ifaces[] =
+{
+    { &IID_INotifyCollectionChangedEventArgs, offsetof(struct collection_changed_args, iface) },
+};
+
+static const struct xclass collection_changed_args_class =
+{
+    L"Windows.UI.Xaml.Interop.NotifyCollectionChangedEventArgs", collection_changed_args_ifaces,
+    ARRAY_SIZE(collection_changed_args_ifaces), collection_changed_args_destroy,
+};
+
+static HRESULT WINAPI collection_changed_args_get_Action( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = collection_changed_args_from_iface( iface )->action;
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_changed_args_get_NewItems( struct xiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    if ((*value = collection_changed_args_from_iface( iface )->new_items)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_changed_args_get_OldItems( struct xiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    if ((*value = collection_changed_args_from_iface( iface )->old_items)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_changed_args_get_NewStartingIndex( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = collection_changed_args_from_iface( iface )->new_index;
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_changed_args_get_OldStartingIndex( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = collection_changed_args_from_iface( iface )->old_index;
+    return S_OK;
+}
+
+static const void *collection_changed_args_vtbl[] =
+{
+    INotifyCollectionChangedEventArgs_STUBS,
+    [INotifyCollectionChangedEventArgs_Action] = collection_changed_args_get_Action,
+    [INotifyCollectionChangedEventArgs_NewItems] = collection_changed_args_get_NewItems,
+    [INotifyCollectionChangedEventArgs_OldItems] = collection_changed_args_get_OldItems,
+    [INotifyCollectionChangedEventArgs_NewStartingIndex] = collection_changed_args_get_NewStartingIndex,
+    [INotifyCollectionChangedEventArgs_OldStartingIndex] = collection_changed_args_get_OldStartingIndex,
+};
+
+static HRESULT WINAPI collection_changed_args_CreateInstance( struct xfiface *iface, INT32 action, IInspectable *new_items,
+                                                              IInspectable *old_items, INT32 new_index, INT32 old_index,
+                                                              IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct collection_changed_args *args;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+#ifdef SG_MUTANT_NO_COLLECTION_CHANGED_ARGS
+    return REGDB_E_CLASSNOTREG;
+#endif
+    if (!(args = calloc( 1, sizeof(*args) ))) return E_OUTOFMEMORY;
+    args->iface.vtbl = collection_changed_args_vtbl;
+    args->action = action;
+    if ((args->new_items = new_items)) IInspectable_AddRef( new_items );
+    if ((args->old_items = old_items)) IInspectable_AddRef( old_items );
+    args->new_index = new_index;
+    args->old_index = old_index;
+    xobj_init( &args->obj, &collection_changed_args_class, outer );
+    if (outer)
+    {
+        *inner = &args->obj.IInspectable_inner;
+        IUnknown_AddRef( args->obj.outer );
+    }
+    *value = &args->iface;
+    return S_OK;
+}
+
+static const void *collection_changed_args_factory_vtbl[] =
+{
+    INotifyCollectionChangedEventArgsFactory_FSTUBS,
+    [INotifyCollectionChangedEventArgsFactory_CreateInstanceWithAllParameters] = collection_changed_args_CreateInstance,
+};
+
+static struct xfactory collection_changed_args_factory_obj =
+{
+    { &xfactory_vtbl }, L"Windows.UI.Xaml.Interop.NotifyCollectionChangedEventArgs",
+    { &IID_INotifyCollectionChangedEventArgsFactory }, { { collection_changed_args_factory_vtbl } }, NULL,
+};
+
+IActivationFactory *collection_changed_args_factory = &collection_changed_args_factory_obj.IActivationFactory_iface;
