From: Stained Glass OS <dev@stained-glass.example>
Subject: explorer: Win+I and the Win+X menu open Settings

Windows' Win+I opens Settings, as do the Win+X menu's Settings, and its
"Apps and Features" and "System" open Settings' pages. 0071 sent all of them
to the Control Panel, as Wine had no Settings app; sg-shell now has one,
registered for the ms-settings: protocol. Explorer runs ms-settings:,
ms-settings:appsfeatures and ms-settings:about through ShellExecute, as
Windows does, and falls back to the Control Panel pages 0071 opened when no
ms-settings: handler is registered. The Win+X menu's Control Panel item
stays the Control Panel.

Gate: sg-shell's test/settings-check.sh with WINI=1 (Win+I typed on the X
keyboard opens Settings' Home; the stock build opens the Control Panel).
---
--- a/programs/explorer/shellkeys.c
+++ b/programs/explorer/shellkeys.c
@@ -306,6 +306,15 @@
         WARN( "could not start %s %s\n", debugstr_w(file), debugstr_w(params) );
 }
 
+/* Settings, at the page an ms-settings: URI names, as Windows opens it; the
+ * Control Panel (and its page) where no Settings app is registered. */
+static void run_settings( const WCHAR *uri, const WCHAR *control_params )
+{
+    if ((INT_PTR)ShellExecuteW( NULL, NULL, uri, NULL, NULL, SW_SHOWNORMAL ) > 32) return;
+    TRACE( "no handler for %s, using the Control Panel\n", debugstr_w(uri) );
+    run( L"control.exe", control_params );
+}
+
 static DWORD WINAPI run_dialog_thread( void *arg )
 {
     void (WINAPI *run_file_dlg)( HWND, HICON, const WCHAR *, const WCHAR *, const WCHAR *, UINT );
@@ -360,8 +369,8 @@
     DestroyMenu( menu );
     switch (cmd)
     {
-    case QL_APPS: run( L"control.exe", L"appwiz.cpl" ); break;
-    case QL_SYSTEM: run( L"control.exe", L"/name Microsoft.System" ); break;
+    case QL_APPS: run_settings( L"ms-settings:appsfeatures", L"appwiz.cpl" ); break;
+    case QL_SYSTEM: run_settings( L"ms-settings:about", L"/name Microsoft.System" ); break;
     case QL_NETWORK: run( L"control.exe", L"ncpa.cpl" ); break;
     case QL_EVENTS: run( L"eventvwr.exe", NULL ); break;
     case QL_DEVICES: run( L"devmgmt.msc", NULL ); break;
@@ -371,7 +380,8 @@
         if ((INT_PTR)ShellExecuteW( NULL, NULL, L"pwsh.exe", NULL, NULL, SW_SHOWNORMAL ) <= 32) run( L"cmd.exe", NULL );
         break;
     case QL_TASKMGR: run( L"taskmgr.exe", NULL ); break;
-    case QL_SETTINGS: case QL_CONTROL: run( L"control.exe", NULL ); break;
+    case QL_SETTINGS: run_settings( L"ms-settings:", NULL ); break;
+    case QL_CONTROL: run( L"control.exe", NULL ); break;
     case QL_EXPLORER: run( L"explorer.exe", NULL ); break;
     case QL_RUN: run_dialog(); break;
     case QL_DESKTOP: toggle_desktop(); break;
@@ -390,7 +400,7 @@
     case SK_RESTORE_ALL: restore_all(); return TRUE;
     case SK_EXPLORER: run( L"explorer.exe", NULL ); return TRUE;
     case SK_RUN: run_dialog(); return TRUE;
-    case SK_SETTINGS: run( L"control.exe", NULL ); return TRUE;
+    case SK_SETTINGS: run_settings( L"ms-settings:", NULL ); return TRUE;
     case SK_SYSTEM: run( L"control.exe", L"/name Microsoft.System" ); return TRUE;
     case SK_QUICKLINK: quick_link(); return TRUE;
     case SK_SNAP_LEFT: snap( -1 ); return TRUE;
