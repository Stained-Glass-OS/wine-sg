+struct async
+{
+    IRP *irp;
+    KEVENT event;
+};
+
+static void async_init(struct async *a)
+{
+    a->irp = IoAllocateIrp(1, FALSE);
+    KeInitializeEvent(&a->event, SynchronizationEvent, FALSE);
+}
+
+static void async_free(struct async *a)
+{
+    IoFreeIrp(a->irp);
+}
+
+static IRP *async_prepare(struct async *a)
+{
+    IoReuseIrp(a->irp, STATUS_UNSUCCESSFUL);
+    IoSetCompletionRoutine(a->irp, irp_completion_routine, &a->event, TRUE, TRUE, TRUE);
+    a->irp->IoStatus.Status = 0xdeadbeef;
+    a->irp->IoStatus.Information = 0xdeadbeef;
+    return a->irp;
+}
+
+/* waits for the IRP of a call that returned STATUS_PENDING; STATUS_TIMEOUT if it never completes */
+static NTSTATUS async_wait(struct async *a, NTSTATUS call_status, int ms)
+{
+    LARGE_INTEGER timeout;
+    NTSTATUS status;
+
+    ok(call_status == STATUS_PENDING, "Got unexpected status %#lx.\n", call_status);
+    timeout.QuadPart = -(LONGLONG)ms * 10000;
+    status = KeWaitForSingleObject(&a->event, Executive, KernelMode, FALSE, &timeout);
+    if (status == STATUS_TIMEOUT)
+        return STATUS_TIMEOUT;
+    return a->irp->IoStatus.Status;
+}
+
+static MDL *alloc_buffer(void **buffer, ULONG length)
+{
+    MDL *mdl;
+
+    *buffer = ExAllocatePool(NonPagedPool, length);
+    memset(*buffer, 0, length);
+    mdl = IoAllocateMdl(*buffer, length, FALSE, FALSE, NULL);
+    MmBuildMdlForNonPagedPool(mdl);
+    return mdl;
+}
+
+static void free_buffer(MDL *mdl, void *buffer)
+{
+    IoFreeMdl(mdl);
+    ExFreePool(buffer);
+}
+
+/* sends/receives through a connection socket; returns the IRP status, *length the byte count */
+static NTSTATUS socket_send(WSK_SOCKET *socket, const void *data, ULONG length, SIZE_T *done)
+{
+    const WSK_PROVIDER_CONNECTION_DISPATCH *d = socket->Dispatch;
+    static struct async a;
+    WSK_BUF wsk_buf;
+    NTSTATUS status;
+    void *buffer;
+    MDL *mdl;
+
+    if (!a.irp) async_init(&a);
+    mdl = alloc_buffer(&buffer, length);
+    memcpy(buffer, data, length);
+    wsk_buf.Mdl = mdl;
+    wsk_buf.Offset = 0;
+    wsk_buf.Length = length;
+    status = d->WskSend(socket, &wsk_buf, 0, async_prepare(&a));
+    status = async_wait(&a, status, 5000);
+    *done = a.irp->IoStatus.Information;
+    free_buffer(mdl, buffer);
+    return status;
+}
+
+static NTSTATUS socket_receive(WSK_SOCKET *socket, void *data, ULONG length, SIZE_T *done, int ms)
+{
+    const WSK_PROVIDER_CONNECTION_DISPATCH *d = socket->Dispatch;
+    static struct async a;
+    WSK_BUF wsk_buf;
+    NTSTATUS status;
+    void *buffer;
+    MDL *mdl;
+
+    if (!a.irp) async_init(&a);
+    mdl = alloc_buffer(&buffer, length);
+    wsk_buf.Mdl = mdl;
+    wsk_buf.Offset = 0;
+    wsk_buf.Length = length;
+    status = d->WskReceive(socket, &wsk_buf, 0, async_prepare(&a));
+    status = async_wait(&a, status, ms);
+    *done = a.irp->IoStatus.Information;
+    if (!status) memcpy(data, buffer, min(length, *done));
+    if (status == STATUS_TIMEOUT)
+    {
+        /* leave nothing pending on the buffer: closing the socket cancels it, the caller closes */
+        *done = 0;
+        return status;
+    }
+    free_buffer(mdl, buffer);
+    return status;
+}
+
+/* a listening socket, a connected client and the accepted server socket on the loopback */
+struct pair
+{
+    WSK_SOCKET *listener, *client, *server;
+};
+
+static void pair_create(struct pair *pair, WSK_BUF *connect_buffer, NTSTATUS expected_connect)
+{
+    const WSK_PROVIDER_LISTEN_DISPATCH *ld;
+    const WSK_PROVIDER_CONNECTION_DISPATCH *cd;
+    struct sockaddr_in addr, listen_addr, local, remote;
+    struct async accept_irp;
+    NTSTATUS status;
+
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+
+    pair->listener = create_test_socket(SOCK_STREAM, IPPROTO_TCP, WSK_FLAG_LISTEN_SOCKET);
+    ld = pair->listener->Dispatch;
+    prepare_irp();
+    status = finish_irp(ld->WskBind(pair->listener, (SOCKADDR *)&addr, 0, wsk_irp));
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    prepare_irp();
+    status = finish_irp(ld->WskGetLocalAddress(pair->listener, (SOCKADDR *)&listen_addr, wsk_irp));
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+
+    async_init(&accept_irp);
+    status = ld->WskAccept(pair->listener, 0, NULL, NULL, (SOCKADDR *)&local, (SOCKADDR *)&remote,
+            async_prepare(&accept_irp));
+    ok(status == STATUS_PENDING, "Got unexpected status %#lx.\n", status);
+
+    pair->client = create_test_socket(SOCK_STREAM, IPPROTO_TCP, WSK_FLAG_CONNECTION_SOCKET);
+    cd = pair->client->Dispatch;
+    prepare_irp();
+    status = finish_irp(cd->WskBind(pair->client, (SOCKADDR *)&addr, 0, wsk_irp));
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+
+    prepare_irp();
+    if (connect_buffer)
+        status = finish_irp(cd->WskConnectEx(pair->client, (SOCKADDR *)&listen_addr, connect_buffer, 0, wsk_irp));
+    else
+        status = finish_irp(cd->WskConnect(pair->client, (SOCKADDR *)&listen_addr, 0, wsk_irp));
+    ok(status == expected_connect, "Got unexpected connect status %#lx.\n", status);
+
+    status = async_wait(&accept_irp, STATUS_PENDING, 5000);
+    ok(status == STATUS_SUCCESS, "Got unexpected accept status %#lx.\n", status);
+    pair->server = (WSK_SOCKET *)accept_irp.irp->IoStatus.Information;
+    async_free(&accept_irp);
+}
+
+static void pair_close(struct pair *pair)
+{
+    if (pair->server) close_test_socket(pair->server);
+    if (pair->client) close_test_socket(pair->client);
+    close_test_socket(pair->listener);
+}
