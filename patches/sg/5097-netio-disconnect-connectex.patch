+static void test_wsk_connect_ex(void)
+{
+    const WSK_PROVIDER_CONNECTION_DISPATCH *cd;
+    struct sockaddr_in addr;
+    WSK_BUF wsk_buf;
+    SIZE_T done;
+    NTSTATUS status;
+    struct pair pair;
+    WSK_SOCKET *socket;
+    char data[16];
+    void *buf1, *buf2;
+    MDL *mdl1, *mdl2;
+
+    mdl1 = alloc_buffer(&buf1, 6);
+    memcpy(buf1, "foo", 3);
+    mdl2 = alloc_buffer(&buf2, 6);
+    memcpy(buf2, "bar", 3);
+    mdl1->ByteCount = 3;
+    mdl2->ByteCount = 3;
+
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(CLIENT_LISTEN_PORT);
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+
+    /* the argument checks happen before anything else */
