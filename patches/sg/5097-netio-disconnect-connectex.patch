+            dispatch_pending_io(io, STATUS_NO_MEMORY, 0);
+            unlock_socket(s);
+            return STATUS_PENDING;
+        }
+#ifdef SG_MUTANT_NETIO_CHAIN
+        count = 1;
+#endif
+        for (i = 0; i < count; ++i)
+        {
+            memcpy(p, bufs[i].buf, bufs[i].len);
+            p += bufs[i].len;
