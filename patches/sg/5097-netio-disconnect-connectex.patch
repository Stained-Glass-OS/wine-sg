+    status = socket_receive(pair.server, data, sizeof(data), &done, 3000);
+    ok(status == STATUS_SUCCESS && done == 3 && !memcmp(data, "oba", 3),
+            "offset: server receive got status %#lx, %Iu bytes.\n", status, done);
+    pair_close(&pair);
+
+    mdl1->Next = NULL;
+    free_buffer(mdl1, buf1);
+    free_buffer(mdl2, buf2);
