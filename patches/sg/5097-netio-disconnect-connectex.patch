+    cd = socket->Dispatch;
+    wsk_buf.Mdl = mdl1;
+    wsk_buf.Offset = 0;
+    wsk_buf.Length = 3;
+    prepare_irp();
+    status = finish_irp(cd->WskConnectEx(socket, (SOCKADDR *)&addr, &wsk_buf, 1, wsk_irp));
+    ok(status == STATUS_INVALID_PARAMETER, "flags: got unexpected status %#lx.\n", status);
+    wsk_buf.Length = 0x10000;
