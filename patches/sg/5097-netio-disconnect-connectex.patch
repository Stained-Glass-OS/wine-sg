+/* WSK_FLAG_ABORTIVE is the only disconnect flag; its value is not published in the docs */
+#define TEST_FLAG_ABORTIVE 0x00000001
+
+static void test_wsk_disconnect(void)
+{
+    const WSK_PROVIDER_CONNECTION_DISPATCH *cd;
+    SIZE_T done;
+    NTSTATUS status;
+    struct pair pair;
+    char data[16];
+    WSK_BUF wsk_buf;
+    void *buffer;
+    MDL *mdl;
+
+    /* graceful: the peer sees the end of the stream, the other direction stays open */
+    pair_create(&pair, NULL, STATUS_SUCCESS);
+    cd = pair.client->Dispatch;
+    prepare_irp();
+    status = finish_irp(cd->WskDisconnect(pair.client, NULL, 0, wsk_irp));
+    ok(status == STATUS_SUCCESS, "graceful: got unexpected status %#lx.\n", status);
+    status = socket_receive(pair.server, data, sizeof(data), &done, 3000);
+    ok(status == STATUS_SUCCESS && done == 0, "graceful: server receive got status %#lx, %Iu bytes.\n", status, done);
+    status = socket_send(pair.client, "x", 1, &done);
+    ok(status != STATUS_SUCCESS, "graceful: send after disconnect succeeded.\n");
+    status = socket_send(pair.server, "back", 4, &done);
+    ok(status == STATUS_SUCCESS && done == 4, "graceful: server send got status %#lx, %Iu bytes.\n", status, done);
+    status = socket_receive(pair.client, data, sizeof(data), &done, 3000);
+    ok(status == STATUS_SUCCESS && done == 4 && !memcmp(data, "back", 4),
+            "graceful: client receive got status %#lx, %Iu bytes.\n", status, done);
+    pair_close(&pair);
+
+    /* graceful with data: the data goes out first */
+    pair_create(&pair, NULL, STATUS_SUCCESS);
+    cd = pair.client->Dispatch;
+    mdl = alloc_buffer(&buffer, 8);
+    memcpy(buffer, "goodbye!", 8);
+    wsk_buf.Mdl = mdl;
+    wsk_buf.Offset = 0;
+    wsk_buf.Length = 8;
+    prepare_irp();
+    status = finish_irp(cd->WskDisconnect(pair.client, &wsk_buf, 0, wsk_irp));
+    ok(status == STATUS_SUCCESS, "graceful data: got unexpected status %#lx.\n", status);
+    free_buffer(mdl, buffer);
+    status = socket_receive(pair.server, data, sizeof(data), &done, 3000);
+    ok(status == STATUS_SUCCESS && done == 8 && !memcmp(data, "goodbye!", 8),
+            "graceful data: server receive got status %#lx, %Iu bytes.\n", status, done);
+    status = socket_receive(pair.server, data, sizeof(data), &done, 3000);
+    ok(status == STATUS_SUCCESS && done == 0, "graceful data: server end got status %#lx, %Iu bytes.\n", status, done);
+    pair_close(&pair);
+
+    /* abortive: no data may go with it, pending receives end, nothing more is sent */
+    pair_create(&pair, NULL, STATUS_SUCCESS);
+    cd = pair.client->Dispatch;
+    mdl = alloc_buffer(&buffer, 8);
+    wsk_buf.Mdl = mdl;
+    wsk_buf.Offset = 0;
+    wsk_buf.Length = 8;
+    prepare_irp();
+    status = cd->WskDisconnect(pair.client, &wsk_buf, TEST_FLAG_ABORTIVE, wsk_irp);
+    status = finish_irp(status);
+    ok(status == STATUS_INVALID_PARAMETER, "abortive with data: got unexpected status %#lx.\n", status);
+    free_buffer(mdl, buffer);
+
+    {
+        static struct async recv_async;
+        WSK_BUF rbuf;
+        void *rdata;
+        MDL *rmdl = alloc_buffer(&rdata, 16);
+
+        if (!recv_async.irp) async_init(&recv_async);
+        rbuf.Mdl = rmdl;
+        rbuf.Offset = 0;
+        rbuf.Length = 16;
+        status = cd->WskReceive(pair.client, &rbuf, 0, async_prepare(&recv_async));
+        ok(status == STATUS_PENDING, "Got unexpected status %#lx.\n", status);
+
+        prepare_irp();
+        status = finish_irp(cd->WskDisconnect(pair.client, NULL, TEST_FLAG_ABORTIVE, wsk_irp));
+        ok(status == STATUS_SUCCESS, "abortive: got unexpected status %#lx.\n", status);
+        status = async_wait(&recv_async, STATUS_PENDING, 3000);
+        ok(status != STATUS_TIMEOUT, "abortive: the pending receive was not ended.\n");
+        free_buffer(rmdl, rdata);
+    }
+    status = socket_send(pair.client, "x", 1, &done);
+    ok(status != STATUS_SUCCESS, "abortive: send after disconnect succeeded.\n");
+    pair_close(&pair);
+}
