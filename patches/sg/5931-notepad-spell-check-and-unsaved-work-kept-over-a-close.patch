 /* ------------------------------------------------------------ main window */
 
+/* ------------------------------------------------------------ spell check
+ * View > Spell check: words the dictionary does not know get a red wavy
+ * line (David, 2026-10-17). The dictionary is the system's hunspell one for
+ * the user's language (en_US by default: the image's hunspell-en-us),
+ * read once: its stems, and a word is known when it, or it less a common
+ * ending or beginning (plurals, -ed, -ing, -ly, un-, re-...), is one.
+ * Words in capitals, with digits, or of one letter are let be. */
+
+static WCHAR **spell_tab;
+static unsigned int spell_cap;
+static int spell_state;                /* 0 not read, 1 read, -1 none */
+
+static unsigned int spell_hash(const WCHAR *w, int n)
+{
+    unsigned int h = 2166136261u;
+    while (n--) h = (h ^ *w++) * 16777619u;
+    return h;
+}
+
+static void spell_add(const WCHAR *w, int n)
+{
+    unsigned int i = spell_hash(w, n) & (spell_cap - 1);
+    while (spell_tab[i])
+    {
+        if (!wcsncmp(spell_tab[i], w, n) && !spell_tab[i][n]) return;
+        i = (i + 1) & (spell_cap - 1);
+    }
+    if ((spell_tab[i] = malloc((n + 1) * sizeof(WCHAR)))) { memcpy(spell_tab[i], w, n * sizeof(WCHAR)); spell_tab[i][n] = 0; }
+}
+
+static BOOL spell_has(const WCHAR *w, int n)
+{
+    unsigned int i = spell_hash(w, n) & (spell_cap - 1);
+    while (spell_tab[i])
+    {
+        if (!wcsncmp(spell_tab[i], w, n) && !spell_tab[i][n]) return TRUE;
+        i = (i + 1) & (spell_cap - 1);
+    }
+    return FALSE;
+}
+
+static void spell_load(void)
+{
+    WCHAR name[LOCALE_NAME_MAX_LENGTH] = L"en-US", path[MAX_PATH], *p;
+    LOADED ld;
+    size_t i, s;
+    spell_state = -1;
+    GetUserDefaultLocaleName(name, ARRAY_SIZE(name));
+    for (p = name; *p; p++) if (*p == '-') *p = '_';
+    wsprintfW(path, L"Z:\\usr\\share\\hunspell\\%s.dic", name);
+    if (GetFileAttributesW(path) == INVALID_FILE_ATTRIBUTES) lstrcpyW(path, L"Z:\\usr\\share\\hunspell\\en_US.dic");
+    if (load_file(path, ENC_UTF8, &ld)) return;
+    spell_cap = 1 << 18;
+    if (!(spell_tab = calloc(spell_cap, sizeof(*spell_tab)))) { free(ld.text); return; }
+    for (i = 0; i < ld.len; i = s + 1)
+    {
+        size_t e;
+        for (s = i; s < ld.len && ld.text[s] != '\n'; s++) ;
+        if (i == 0) continue;                         /* the first line: the count */
+        for (e = i; e < s && ld.text[e] != '/' && ld.text[e] != '\r' && ld.text[e] != '\t'; e++) ;
+        if (e > i && e - i < 64)
+        {
+            WCHAR w[64];
+            int k, n = (int)(e - i);
+            for (k = 0; k < n; k++) w[k] = towlower(ld.text[i + k]);
+            spell_add(w, n);
+        }
+    }
+    free(ld.text);
+    spell_state = 1;
+}
+
+BOOL spell_word_ok(const WCHAR *word, int n)
+{
+    static const struct { const WCHAR *end, *add; } ends[] = {
+        { L"'s", L"" }, { L"s", L"" }, { L"es", L"" }, { L"ies", L"y" }, { L"ed", L"" }, { L"d", L"" }, { L"ied", L"y" },
+        { L"ing", L"" }, { L"ing", L"e" }, { L"er", L"" }, { L"r", L"" }, { L"ers", L"" }, { L"est", L"" }, { L"st", L"" },
+        { L"ly", L"" }, { L"ily", L"y" }, { L"ness", L"" }, { L"ment", L"" }, { L"ments", L"" }, { L"ful", L"" },
+        { L"less", L"" }, { L"able", L"" }, { L"ably", L"" }, { L"ation", L"e" }, { L"ations", L"e" }, { L"ings", L"" },
+        { L"ings", L"e" }, { L"iest", L"y" }, { L"ier", L"y" }, { L"ness", L"" }, { L"nesses", L"" }, { L"ize", L"" },
+    };
+    static const WCHAR *const begins[] = { L"un", L"re", L"in", L"dis", L"non", L"pre", L"over", L"mis", L"sub" };
+    WCHAR w[64], t[72];
+    int i, k, caps = 0;
+    if (!spell_state) spell_load();
+    if (spell_state < 0 || n < 2 || n >= 64) return TRUE;
+    for (i = 0; i < n; i++)
+    {
+        if (iswdigit(word[i])) return TRUE;
+        if (iswupper(word[i])) caps++;
+        w[i] = towlower(word[i] == 0x2019 ? '\'' : word[i]);
+    }
+    if (caps == n) return TRUE;                        /* NASA, an acronym */
+#ifdef SG_MUTANT_NP_SPELL_NONE
+    return TRUE;
+#endif
+    if (spell_has(w, n)) return TRUE;
+    for (k = 0; k < ARRAY_SIZE(ends); k++)
+    {
+        int el = lstrlenW(ends[k].end), al = lstrlenW(ends[k].add);
+        if (n - el < 2 || wcsncmp(w + n - el, ends[k].end, el)) continue;
+        memcpy(t, w, (n - el) * sizeof(WCHAR));
+        memcpy(t + n - el, ends[k].add, al * sizeof(WCHAR));
+        if (spell_has(t, n - el + al)) return TRUE;
+        /* a doubled last letter: stopped, running */
+        if (!al && n - el >= 3 && t[n - el - 1] == t[n - el - 2] && spell_has(t, n - el - 1)) return TRUE;
+    }
+    for (k = 0; k < ARRAY_SIZE(begins); k++)
+    {
+        int bl = lstrlenW(begins[k]);
+        if (n - bl >= 3 && !wcsncmp(w, begins[k], bl) && spell_word_ok(word + bl, n - bl)) return TRUE;
+    }
+    return FALSE;
+}
+
+/* ------------------------------------------------------------ unsaved work kept
+ * Closing the window keeps what was not saved, as Windows 11's Notepad does
+ * (David, 2026-10-17): each changed tab's text goes to
+ * %LOCALAPPDATA%\Stained Glass\Notepad\Unsaved, the window closes without
+ * asking, and the next start brings the tabs back, still unsaved -- an
+ * untitled one as untitled, a changed file as that file with the changes.
+ * Only with "Restore previous session" on (View); off, it asks as before. */
+
+static BOOL unsaved_dir(WCHAR *out, int cch)
+{
+    WCHAR base[MAX_PATH];
+    if (!GetEnvironmentVariableW(L"LOCALAPPDATA", base, ARRAY_SIZE(base))) return FALSE;
+    wsprintfW(out, L"%s\\Stained Glass", base); CreateDirectoryW(out, NULL);
+    lstrcatW(out, L"\\Notepad"); CreateDirectoryW(out, NULL);
+    lstrcatW(out, L"\\Unsaved"); CreateDirectoryW(out, NULL);
+    return GetFileAttributesW(out) != INVALID_FILE_ATTRIBUTES && lstrlenW(out) < cch;
+}
+
+static void stash_unsaved(void)
+{
+    WCHAR dir[MAX_PATH], file[MAX_PATH + 32], *rec[64];
+    HKEY key;
+    int i, n = 0;
+    BOOL lossy;
+    if (!unsaved_dir(dir, ARRAY_SIZE(dir))) return;
+    for (i = 0; i < G.ndocs && n < ARRAY_SIZE(rec); i++)
+    {
+        DOC *d = G.docs[i];
+#ifdef SG_MUTANT_NP_FORGETS_UNSAVED
+        break;
+#endif
+        if (!doc_modified(d) || (!d->path && !ed_length(d->ed))) continue;
+        wsprintfW(file, L"%s\\tab%d.txt", dir, i);
+        if (save_file(file, ed_text(d->ed), ed_length(d->ed), ENC_UTF16LE, &lossy)) continue;
+        if (!(rec[n] = malloc((lstrlenW(file) + (d->path ? lstrlenW(d->path) : 0) + 2) * sizeof(WCHAR)))) break;
+        wsprintfW(rec[n], L"%s\t%s", file, d->path ? d->path : L"");
+        n++;
+    }
+    if (!RegCreateKeyExW(HKEY_CURRENT_USER, NOTEPAD_KEY, 0, NULL, 0, KEY_WRITE, NULL, &key, NULL))
+    {
+        set_multi(key, L"sgUnsaved", rec, n);
+        RegCloseKey(key);
+    }
+    for (i = 0; i < n; i++) free(rec[i]);
+}
+
+static void restore_unsaved(void)
+{
+    WCHAR *rec[64], *tab;
+    HKEY key;
+    int n, i;
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, NOTEPAD_KEY, 0, KEY_READ | KEY_SET_VALUE, &key)) return;
+    n = reg_multi(key, L"sgUnsaved", rec, ARRAY_SIZE(rec));
+    RegDeleteValueW(key, L"sgUnsaved");
+    RegCloseKey(key);
+    for (i = 0; i < n; i++)
+    {
+        LOADED ld;
+        DOC *d = NULL;
+        int at;
+        if (!(tab = wcschr(rec[i], '\t'))) { free(rec[i]); continue; }
+        *tab++ = 0;
+        if (!load_file(rec[i], ENC_UTF16LE, &ld))
+        {
+            if (*tab && ((at = find_doc(tab)) >= 0 || (open_file(tab, ENC_COUNT, TRUE) && (at = find_doc(tab)) >= 0)))
+                d = G.docs[at];
+            else if (G.ndocs && is_pristine(G.docs[G.ndocs - 1])) d = G.docs[G.ndocs - 1];
+            else d = new_doc();
+            if (d)
+            {
+                int k;
+                ed_replace(d->ed, 0, ed_length(d->ed), ld.text, ld.len);
+                for (k = 0; k < G.ndocs; k++) if (G.docs[k] == d) activate(k);
+            }
+            free(ld.text);
+        }
+        DeleteFileW(rec[i]);
+        free(rec[i]);
+    }
+    InvalidateRect(G.tabs, NULL, FALSE);
+    update_title();
+}
+
 static BOOL close_all(void)
 {
     int i;
@@ -2372,9 +2574,11 @@
         if (G.theme_mode == 0) apply_theme();
         return 0;
     case WM_QUERYENDSESSION:
+        if (G.restore_session) { stash_unsaved(); return TRUE; }
         return close_all();
     case WM_CLOSE:
-        if (!close_all()) return 0;
+        if (G.restore_session) stash_unsaved();
+        else if (!close_all()) return 0;
         save_session();
         G.closing = TRUE;
         DestroyWindow(hwnd);
@@ -2664,7 +2868,10 @@
             }
     }
     else if (G.restore_session && !other_window)
+    {
         restore_session();
+        restore_unsaved();
+    }
 
     accel = LoadAcceleratorsW(inst, MAKEINTRESOURCEW(ID_ACCEL));
     while (GetMessageW(&msg, 0, 0, 0))
