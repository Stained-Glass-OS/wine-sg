         i = j;
     }
     free(dx);
+    /* spell check: a red wavy line under each word the dictionary does not know */
+    if (e->o.spell)
+    {
+        HPEN pen = CreatePen(PS_SOLID, 1, RGB(0xe0, 0x28, 0x28)), old = SelectObject(dc, pen);
+        int a = 0, n = (int)e->lay_n, yb = y + e->line_h - 2;
+        while (a < n)
+        {
+            int b;
+            if (!IsCharAlphaW(e->lay_s[a])) { a++; continue; }
+            for (b = a; b < n && (IsCharAlphaW(e->lay_s[b]) || ((e->lay_s[b] == '\'' || e->lay_s[b] == 0x2019) &&
+                                                               b + 1 < n && IsCharAlphaW(e->lay_s[b + 1]))); b++) ;
+            if (b > from && a < to && !(ls + a <= e->caret && e->caret <= ls + b) &&
+                !spell_word_ok(e->lay_s + a, b - a))
+            {
+                int xa = x0 + e->xs[max(a, from)] - base, xb = x0 + e->xs[min(b, to)] - base, xx;
+                MoveToEx(dc, xa, yb, NULL);
+                for (xx = xa; xx < xb; xx += 2) LineTo(dc, min(xx + 2, xb), ((xx - xa) / 2) & 1 ? yb : yb + 2);
+            }
+            a = b;
+        }
+        SelectObject(dc, old);
+        DeleteObject(pen);
+    }
 }
 
