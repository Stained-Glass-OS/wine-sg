From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] coremessaging: a DispatcherQueue can be held weakly

OneDrive crashed as its window was made: React Native for Windows (Microsoft.ReactNative.dll, which OneDrive's interface is built on) holds its thread's DispatcherQueue as a weak reference, and the queue answered E_NOINTERFACE for IWeakReferenceSource, so the program used a null. The queue now gives IWeakReferenceSource; its weak reference resolves to the queue while the queue lives and to nothing (S_OK, null) once it is gone.
---
diff --git a/dlls/coremessaging/main.c b/dlls/coremessaging/main.c
index e5d4871..65cccce 100644
--- a/dlls/coremessaging/main.c
+++ b/dlls/coremessaging/main.c
@@ -44,6 +44,7 @@
 #include "windows.foundation.h"
 #include "windows.system.h"
 #include "dispatcherqueue.h"
+#include "weakreference.h"
 
 #include "wine/debug.h"
 #include "wine/list.h"
@@ -603,7 +604,9 @@ struct dispatcher_queue
 {
     IDispatcherQueue IDispatcherQueue_iface;
     IDispatcherQueue2 IDispatcherQueue2_iface;
+    IWeakReferenceSource IWeakReferenceSource_iface;
     LONG ref;
+    struct queue_weak *weak;    /* its weak reference, once one is asked for */
     struct list entry;          /* in queues, while the thread has it */
     DWORD thread_id;
     HWND hwnd;
@@ -615,6 +618,15 @@ struct dispatcher_queue
     struct list timers;         /* running ones */
 };
 
+/* a weak reference to a queue (programs hold their thread's queue weakly): it resolves while the
+ * queue lives; the queue clears it, under queues_cs, before it is freed */
+struct queue_weak
+{
+    IWeakReference IWeakReference_iface;
+    LONG ref;
+    struct dispatcher_queue *queue;
+};
+
 struct dispatcher_queue_timer
 {
     IDispatcherQueueTimer IDispatcherQueueTimer_iface;
@@ -649,6 +661,13 @@ static HRESULT WINAPI dispatcher_queue_QueryInterface( IDispatcherQueue *iface,
         *out = &impl->IDispatcherQueue2_iface; IDispatcherQueue2_AddRef( &impl->IDispatcherQueue2_iface );
         return S_OK;
     }
+#ifndef SG_MUTANT_QUEUE_NO_WEAK_SOURCE
+    if (IsEqualGUID( iid, &IID_IWeakReferenceSource ))
+    {
+        *out = &impl->IWeakReferenceSource_iface; IDispatcherQueue_AddRef( &impl->IDispatcherQueue_iface );
+        return S_OK;
+    }
+#endif
     WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
     *out = NULL;
     return E_NOINTERFACE;
@@ -672,6 +691,13 @@ static ULONG WINAPI dispatcher_queue_Release( IDispatcherQueue *iface )
 
     if (!ref)
     {
+        struct queue_weak *weak;
+
+        /* weak references no longer resolve */
+        EnterCriticalSection( &queues_cs );
+        if ((weak = impl->weak)) weak->queue = NULL;
+        LeaveCriticalSection( &queues_cs );
+        if (weak) IWeakReference_Release( &weak->IWeakReference_iface );
         /* the window was destroyed at shutdown, or goes with its thread */
         LIST_FOR_EACH_ENTRY_SAFE( item, next, &impl->items, struct queue_item, entry )
         {
@@ -815,6 +841,121 @@ static const struct IDispatcherQueueVtbl dispatcher_queue_vtbl =
     dispatcher_queue_remove_ShutdownCompleted,
 };
 
+static inline struct queue_weak *impl_from_IWeakReference( IWeakReference *iface )
+{
+    return CONTAINING_RECORD( iface, struct queue_weak, IWeakReference_iface );
+}
+
+static HRESULT WINAPI queue_weak_QueryInterface( IWeakReference *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference ))
+    {
+        *out = iface; IWeakReference_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI queue_weak_AddRef( IWeakReference *iface )
+{
+    return InterlockedIncrement( &impl_from_IWeakReference( iface )->ref );
+}
+
+static ULONG WINAPI queue_weak_Release( IWeakReference *iface )
+{
+    struct queue_weak *impl = impl_from_IWeakReference( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI queue_weak_Resolve( IWeakReference *iface, REFIID iid, IInspectable **out )
+{
+    struct queue_weak *impl = impl_from_IWeakReference( iface );
+    struct dispatcher_queue *queue;
+    HRESULT hr = S_OK;
+    LONG ref;
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    /* a strong reference only while one is still held: a queue going away is not brought back */
+    EnterCriticalSection( &queues_cs );
+    if ((queue = impl->queue))
+    {
+        do ref = queue->ref; while (ref && InterlockedCompareExchange( &queue->ref, ref + 1, ref ) != ref);
+        if (!ref) queue = NULL;
+    }
+    LeaveCriticalSection( &queues_cs );
+    if (!queue) return S_OK;   /* gone: a null object, as on Windows */
+    hr = IDispatcherQueue_QueryInterface( &queue->IDispatcherQueue_iface, iid, (void **)out );
+    IDispatcherQueue_Release( &queue->IDispatcherQueue_iface );
+    return hr;
+}
+
+static const struct IWeakReferenceVtbl queue_weak_vtbl =
+{
+    queue_weak_QueryInterface,
+    queue_weak_AddRef,
+    queue_weak_Release,
+    queue_weak_Resolve,
+};
+
+static inline struct dispatcher_queue *impl_from_IWeakReferenceSource( IWeakReferenceSource *iface )
+{
+    return CONTAINING_RECORD( iface, struct dispatcher_queue, IWeakReferenceSource_iface );
+}
+
+static HRESULT WINAPI queue_weak_source_QueryInterface( IWeakReferenceSource *iface, REFIID iid, void **out )
+{
+    return IDispatcherQueue_QueryInterface( &impl_from_IWeakReferenceSource( iface )->IDispatcherQueue_iface, iid, out );
+}
+
+static ULONG WINAPI queue_weak_source_AddRef( IWeakReferenceSource *iface )
+{
+    return IDispatcherQueue_AddRef( &impl_from_IWeakReferenceSource( iface )->IDispatcherQueue_iface );
+}
+
+static ULONG WINAPI queue_weak_source_Release( IWeakReferenceSource *iface )
+{
+    return IDispatcherQueue_Release( &impl_from_IWeakReferenceSource( iface )->IDispatcherQueue_iface );
+}
+
+static HRESULT WINAPI queue_weak_source_GetWeakReference( IWeakReferenceSource *iface, IWeakReference **out )
+{
+    struct dispatcher_queue *queue = impl_from_IWeakReferenceSource( iface );
+    struct queue_weak *weak;
+
+    TRACE( "iface %p, out %p.\n", iface, out );
+
+    if (!out) return E_POINTER;
+    EnterCriticalSection( &queues_cs );
+    if (!(weak = queue->weak) && (weak = calloc( 1, sizeof(*weak) )))
+    {
+        weak->IWeakReference_iface.lpVtbl = &queue_weak_vtbl;
+        weak->ref = 1;   /* the queue's */
+        weak->queue = queue;
+        queue->weak = weak;
+    }
+    if (weak) IWeakReference_AddRef( &weak->IWeakReference_iface );
+    LeaveCriticalSection( &queues_cs );
+    if (!weak) return E_OUTOFMEMORY;
+    *out = &weak->IWeakReference_iface;
+    return S_OK;
+}
+
+static const struct IWeakReferenceSourceVtbl queue_weak_source_vtbl =
+{
+    queue_weak_source_QueryInterface,
+    queue_weak_source_AddRef,
+    queue_weak_source_Release,
+    queue_weak_source_GetWeakReference,
+};
+
 static inline struct dispatcher_queue *impl_from_IDispatcherQueue2( IDispatcherQueue2 *iface )
 {
     return CONTAINING_RECORD( iface, struct dispatcher_queue, IDispatcherQueue2_iface );
@@ -1268,6 +1409,7 @@ static HRESULT create_queue_for_current_thread( BOOL dedicated, struct dispatche
     if (!(queue = calloc( 1, sizeof(*queue) ))) return E_OUTOFMEMORY;
     queue->IDispatcherQueue_iface.lpVtbl = &dispatcher_queue_vtbl;
     queue->IDispatcherQueue2_iface.lpVtbl = &dispatcher_queue2_vtbl;
+    queue->IWeakReferenceSource_iface.lpVtbl = &queue_weak_source_vtbl;
     queue->ref = 2;   /* the caller's, and its thread's until shutdown */
     queue->thread_id = GetCurrentThreadId();
     queue->dedicated = dedicated;
