-    return E_NOTIMPL;
+    HRESULT (WINAPI *create)(IStream *, UINT, REFIID, void **);
+    HMODULE storage;
+
+    TRACE("(%p, %d, %s, %p)\n", stream, options, debugstr_guid(riid), ppv);
+
+    if (!stream || !riid || !ppv)
+        return E_INVALIDARG;
+    *ppv = NULL;
+
+    /* the WinRT stream classes live in windows.storage */
