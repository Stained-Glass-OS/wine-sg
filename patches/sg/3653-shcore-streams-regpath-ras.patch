+        return HRESULT_FROM_WIN32(GetLastError());
+    if (!(create = (void *)GetProcAddress(storage, "wine_sg_CreateRandomAccessStreamOverStream")))
+    {
+        FreeLibrary(storage);
+        return E_NOTIMPL;
+    }
+    return create(stream, options, riid, ppv);
