+static HRESULT filestream_lock(IStream *iface, ULARGE_INTEGER offset, ULARGE_INTEGER size, BOOL lock)
+{
+    struct shstream *stream = impl_from_IStream(iface);
+    BOOL ret;
+
+    if (lock)
+        ret = LockFile(stream->u.file.handle, offset.u.LowPart, offset.u.HighPart, size.u.LowPart, size.u.HighPart);
+    else
+        ret = UnlockFile(stream->u.file.handle, offset.u.LowPart, offset.u.HighPart, size.u.LowPart, size.u.HighPart);
+    if (ret) return S_OK;
+
+    switch (GetLastError())
+    {
+    case ERROR_LOCK_VIOLATION:
+#ifndef SG_MUTANT_SHCORE_LOCK
+    case ERROR_NOT_LOCKED:
+#endif
+        return STG_E_LOCKVIOLATION;
+    case ERROR_ACCESS_DENIED:
+        return STG_E_ACCESSDENIED;
+    default:
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+}
+
+static HRESULT WINAPI filestream_LockRegion(IStream *iface, ULARGE_INTEGER offset, ULARGE_INTEGER size, DWORD lock_type)
+{
+    TRACE("%p, %s, %s, %#lx.\n", iface, wine_dbgstr_longlong(offset.QuadPart), wine_dbgstr_longlong(size.QuadPart), lock_type);
+
+    return filestream_lock(iface, offset, size, TRUE);
+}
+
+static HRESULT WINAPI filestream_UnlockRegion(IStream *iface, ULARGE_INTEGER offset, ULARGE_INTEGER size, DWORD lock_type)
+{
+    TRACE("%p, %s, %s, %#lx.\n", iface, wine_dbgstr_longlong(offset.QuadPart), wine_dbgstr_longlong(size.QuadPart), lock_type);
+
+    return filestream_lock(iface, offset, size, FALSE);
+}
