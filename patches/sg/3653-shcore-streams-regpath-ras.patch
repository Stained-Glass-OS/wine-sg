+#include "private.h"
+#include "objidl.h"
+#include "roerrorapi.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(storage);
+
+struct wrap_stream
+{
+    IRandomAccessStream IRandomAccessStream_iface;
+    IInputStream IInputStream_iface;
+    IOutputStream IOutputStream_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    IStream *stream;
+    BOOL closed;
+};
+
+static HRESULT wrap_stream_create( IStream *stream, struct wrap_stream **out );
+
+static inline struct wrap_stream *impl_from_IRandomAccessStream( IRandomAccessStream *iface )
+{
+    return CONTAINING_RECORD( iface, struct wrap_stream, IRandomAccessStream_iface );
+}
+
+static HRESULT WINAPI wrap_QueryInterface( IRandomAccessStream *iface, REFIID iid, void **out )
+{
+    struct wrap_stream *impl = impl_from_IRandomAccessStream( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IRandomAccessStream ))
+        *out = &impl->IRandomAccessStream_iface;
+    else if (IsEqualGUID( iid, &IID_IInputStream ))
+        *out = &impl->IInputStream_iface;
+    else if (IsEqualGUID( iid, &IID_IOutputStream ))
+        *out = &impl->IOutputStream_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI wrap_AddRef( IRandomAccessStream *iface )
+{
+    return InterlockedIncrement( &impl_from_IRandomAccessStream( iface )->ref );
+}
+
+static ULONG WINAPI wrap_Release( IRandomAccessStream *iface )
+{
+    struct wrap_stream *impl = impl_from_IRandomAccessStream( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IStream_Release( impl->stream );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI wrap_GetIids( IRandomAccessStream *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI wrap_GetRuntimeClassName( IRandomAccessStream *iface, HSTRING *class_name )
+{
+    static const WCHAR name[] = L"Windows.Storage.Streams.RandomAccessStream";
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI wrap_GetTrustLevel( IRandomAccessStream *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI wrap_get_Size( IRandomAccessStream *iface, UINT64 *value )
+{
+    struct wrap_stream *impl = impl_from_IRandomAccessStream( iface );
+    STATSTG stat;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (impl->closed) return RO_E_CLOSED;
+    if (FAILED(hr = IStream_Stat( impl->stream, &stat, STATFLAG_NONAME ))) return hr;
+#ifdef SG_MUTANT_SHCORE_RAS_SIZE
+    *value = stat.cbSize.QuadPart + 1;
+#else
+    *value = stat.cbSize.QuadPart;
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI wrap_put_Size( IRandomAccessStream *iface, UINT64 value )
+{
+    struct wrap_stream *impl = impl_from_IRandomAccessStream( iface );
+    ULARGE_INTEGER size;
+
+    TRACE( "iface %p, value %I64u.\n", iface, value );
+
+    if (impl->closed) return RO_E_CLOSED;
+    size.QuadPart = value;
+    return IStream_SetSize( impl->stream, size );
+}
+
+static HRESULT wrap_clone_at( struct wrap_stream *impl, UINT64 position, struct wrap_stream **out )
+{
+    LARGE_INTEGER move;
+    IStream *clone;
+    HRESULT hr;
+
+    if (impl->closed) return RO_E_CLOSED;
+    if (FAILED(hr = IStream_Clone( impl->stream, &clone ))) return hr;
+    move.QuadPart = position;
+    if (FAILED(hr = IStream_Seek( clone, move, STREAM_SEEK_SET, NULL )) ||
+        FAILED(hr = wrap_stream_create( clone, out )))
+    {
+        IStream_Release( clone );
+        return hr;
+    }
+    /* the new stream owns the clone reference */
+    return S_OK;
+}
+
+static HRESULT WINAPI wrap_GetInputStreamAt( IRandomAccessStream *iface, UINT64 position, IInputStream **stream )
+{
+    struct wrap_stream *impl = impl_from_IRandomAccessStream( iface ), *clone;
+    HRESULT hr;
+
+    TRACE( "iface %p, position %I64u, stream %p.\n", iface, position, stream );
+
+    if (FAILED(hr = wrap_clone_at( impl, position, &clone ))) return hr;
+    hr = IRandomAccessStream_QueryInterface( &clone->IRandomAccessStream_iface, &IID_IInputStream, (void **)stream );
+    IRandomAccessStream_Release( &clone->IRandomAccessStream_iface );
+    return hr;
+}
+
+static HRESULT WINAPI wrap_GetOutputStreamAt( IRandomAccessStream *iface, UINT64 position, IOutputStream **stream )
+{
+    struct wrap_stream *impl = impl_from_IRandomAccessStream( iface ), *clone;
+    HRESULT hr;
+
+    TRACE( "iface %p, position %I64u, stream %p.\n", iface, position, stream );
+
+    if (FAILED(hr = wrap_clone_at( impl, position, &clone ))) return hr;
+    hr = IRandomAccessStream_QueryInterface( &clone->IRandomAccessStream_iface, &IID_IOutputStream, (void **)stream );
+    IRandomAccessStream_Release( &clone->IRandomAccessStream_iface );
+    return hr;
+}
+
+static HRESULT WINAPI wrap_get_Position( IRandomAccessStream *iface, UINT64 *value )
+{
+    struct wrap_stream *impl = impl_from_IRandomAccessStream( iface );
+    LARGE_INTEGER zero = {0};
+    ULARGE_INTEGER pos;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (impl->closed) return RO_E_CLOSED;
+    if (FAILED(hr = IStream_Seek( impl->stream, zero, STREAM_SEEK_CUR, &pos ))) return hr;
+    *value = pos.QuadPart;
+    return S_OK;
+}
+
+static HRESULT WINAPI wrap_Seek( IRandomAccessStream *iface, UINT64 position )
+{
+    struct wrap_stream *impl = impl_from_IRandomAccessStream( iface );
+    LARGE_INTEGER move;
+
+    TRACE( "iface %p, position %I64u.\n", iface, position );
+
+    if (impl->closed) return RO_E_CLOSED;
+    move.QuadPart = position;
+    return IStream_Seek( impl->stream, move, STREAM_SEEK_SET, NULL );
+}
+
+static HRESULT WINAPI wrap_CloneStream( IRandomAccessStream *iface, IRandomAccessStream **stream )
+{
+    struct wrap_stream *impl = impl_from_IRandomAccessStream( iface ), *clone;
+    HRESULT hr;
+
+    TRACE( "iface %p, stream %p.\n", iface, stream );
+
+    if (FAILED(hr = wrap_clone_at( impl, 0, &clone ))) return hr;
+    *stream = &clone->IRandomAccessStream_iface;
+    return S_OK;
+}
+
+static DWORD wrap_access( struct wrap_stream *impl )
+{
+    STATSTG stat;
+
+    if (FAILED(IStream_Stat( impl->stream, &stat, STATFLAG_NONAME ))) return STGM_READWRITE;
+    return stat.grfMode & 3;
+}
+
+static HRESULT WINAPI wrap_get_CanRead( IRandomAccessStream *iface, boolean *value )
+{
+    struct wrap_stream *impl = impl_from_IRandomAccessStream( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (impl->closed) { *value = FALSE; return S_OK; }
+    *value = wrap_access( impl ) != STGM_WRITE;
+    return S_OK;
+}
+
+static HRESULT WINAPI wrap_get_CanWrite( IRandomAccessStream *iface, boolean *value )
+{
+    struct wrap_stream *impl = impl_from_IRandomAccessStream( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (impl->closed) { *value = FALSE; return S_OK; }
+    *value = wrap_access( impl ) != STGM_READ;
+    return S_OK;
+}
+
+static const struct IRandomAccessStreamVtbl wrap_vtbl =
+{
+    wrap_QueryInterface,
+    wrap_AddRef,
+    wrap_Release,
+    wrap_GetIids,
+    wrap_GetRuntimeClassName,
+    wrap_GetTrustLevel,
+    wrap_get_Size,
+    wrap_put_Size,
+    wrap_GetInputStreamAt,
+    wrap_GetOutputStreamAt,
+    wrap_get_Position,
+    wrap_Seek,
+    wrap_CloneStream,
+    wrap_get_CanRead,
+    wrap_get_CanWrite,
+};
+
+DEFINE_IINSPECTABLE( wrap_input, IInputStream, struct wrap_stream, IRandomAccessStream_iface )
+
+static HRESULT WINAPI wrap_input_ReadAsync( IInputStream *iface, IBuffer *buffer, UINT32 count,
+                                            InputStreamOptions options,
+                                            IAsyncOperationWithProgress_IBuffer_UINT32 **operation )
+{
+    struct wrap_stream *impl = impl_from_IInputStream( iface );
+    UINT32 capacity;
+    ULONG done = 0;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE( "iface %p, buffer %p, count %u, options %#x, operation %p.\n", iface, buffer, count, options, operation );
+
+    if (!operation) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    if (FAILED(hr = buffer_get_bytes( buffer, &bytes, NULL, &capacity ))) return hr;
+    if (count > capacity) return E_INVALIDARG;
+
+    hr = IStream_Read( impl->stream, bytes, count, &done );
+    if (hr == S_FALSE) hr = S_OK;   /* end of stream */
+    if (FAILED(hr)) return hr;
+
+#ifndef SG_MUTANT_SHCORE_RAS_READ
+    IBuffer_put_Length( buffer, done );
+#endif
+    return async_read_create( buffer, S_OK, operation );
+}
+
+static const struct IInputStreamVtbl wrap_input_vtbl =
+{
+    wrap_input_QueryInterface,
+    wrap_input_AddRef,
+    wrap_input_Release,
+    wrap_input_GetIids,
+    wrap_input_GetRuntimeClassName,
+    wrap_input_GetTrustLevel,
+    wrap_input_ReadAsync,
+};
+
+DEFINE_IINSPECTABLE( wrap_output, IOutputStream, struct wrap_stream, IRandomAccessStream_iface )
+
+static HRESULT WINAPI wrap_output_WriteAsync( IOutputStream *iface, IBuffer *buffer,
+                                              IAsyncOperationWithProgress_UINT32_UINT32 **operation )
+{
+    struct wrap_stream *impl = impl_from_IOutputStream( iface );
+    UINT32 length;
+    ULONG written = 0;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE( "iface %p, buffer %p, operation %p.\n", iface, buffer, operation );
+
+    if (!operation) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    if (FAILED(hr = buffer_get_bytes( buffer, &bytes, &length, NULL ))) return hr;
+    if (FAILED(hr = IStream_Write( impl->stream, bytes, length, &written ))) return hr;
+    return async_write_create( written, S_OK, operation );
+}
+
+static HRESULT WINAPI wrap_output_FlushAsync( IOutputStream *iface, IAsyncOperation_boolean **operation )
+{
+    struct wrap_stream *impl = impl_from_IOutputStream( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    if (!operation) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    hr = IStream_Commit( impl->stream, STGC_DEFAULT );
+    /* streams that do not buffer report E_NOTIMPL: nothing to flush */
+    if (hr == E_NOTIMPL) hr = S_OK;
+    if (FAILED(hr)) return hr;
+    return async_boolean_create( TRUE, S_OK, operation );
+}
+
+static const struct IOutputStreamVtbl wrap_output_vtbl =
+{
+    wrap_output_QueryInterface,
+    wrap_output_AddRef,
+    wrap_output_Release,
+    wrap_output_GetIids,
+    wrap_output_GetRuntimeClassName,
+    wrap_output_GetTrustLevel,
+    wrap_output_WriteAsync,
+    wrap_output_FlushAsync,
+};
+
+DEFINE_IINSPECTABLE( wrap_closable, IClosable, struct wrap_stream, IRandomAccessStream_iface )
+
+static HRESULT WINAPI wrap_closable_Close( IClosable *iface )
+{
+    TRACE( "iface %p.\n", iface );
+    impl_from_IClosable( iface )->closed = TRUE;
+    return S_OK;
+}
+
+static const struct IClosableVtbl wrap_closable_vtbl =
+{
+    wrap_closable_QueryInterface,
+    wrap_closable_AddRef,
+    wrap_closable_Release,
+    wrap_closable_GetIids,
+    wrap_closable_GetRuntimeClassName,
+    wrap_closable_GetTrustLevel,
+    wrap_closable_Close,
+};
+
+static HRESULT wrap_stream_create( IStream *stream, struct wrap_stream **out )
+{
+    struct wrap_stream *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IRandomAccessStream_iface.lpVtbl = &wrap_vtbl;
+    impl->IInputStream_iface.lpVtbl = &wrap_input_vtbl;
+    impl->IOutputStream_iface.lpVtbl = &wrap_output_vtbl;
+    impl->IClosable_iface.lpVtbl = &wrap_closable_vtbl;
+    impl->ref = 1;
+    impl->stream = stream;
+    *out = impl;
+    return S_OK;
+}
+
+/* called by shcore's CreateRandomAccessStreamOverStream; not a Windows export */
+HRESULT WINAPI wine_sg_CreateRandomAccessStreamOverStream( IStream *stream, UINT options, REFIID iid, void **out )
+{
+    struct wrap_stream *impl;
+    HRESULT hr;
+
+    TRACE( "stream %p, options %u, iid %s, out %p.\n", stream, options, debugstr_guid( iid ), out );
+
+    if (!stream || !out) return E_INVALIDARG;
+    *out = NULL;
+    IStream_AddRef( stream );
+    if (FAILED(hr = wrap_stream_create( stream, &impl )))
+    {
+        IStream_Release( stream );
+        return hr;
+    }
+    hr = IRandomAccessStream_QueryInterface( &impl->IRandomAccessStream_iface, iid, out );
+    IRandomAccessStream_Release( &impl->IRandomAccessStream_iface );
+    return hr;
+}
