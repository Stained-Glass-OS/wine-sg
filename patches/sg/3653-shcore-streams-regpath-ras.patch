+static void test_filestream_locks(void)
+{
+    WCHAR path[MAX_PATH];
+    ULARGE_INTEGER off, len;
+    IStream *stream, *clone;
+    HRESULT hr;
+
+    GetTempPathW(MAX_PATH, path);
+    lstrcatW(path, L"sgcalls_lock.tmp");
+    hr = SHCreateStreamOnFileEx(path, STGM_CREATE | STGM_READWRITE, FILE_ATTRIBUTE_NORMAL, TRUE, NULL, &stream);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (FAILED(hr)) return;
+    IStream_Write(stream, "0123456789", 10, NULL);
+
+    off.QuadPart = 0;
+    len.QuadPart = 10;
+    hr = IStream_LockRegion(stream, off, len, LOCK_EXCLUSIVE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IStream_LockRegion(stream, off, len, LOCK_EXCLUSIVE);
+    ok(hr == STG_E_LOCKVIOLATION, "got %#lx\n", hr);
+    hr = IStream_UnlockRegion(stream, off, len, LOCK_EXCLUSIVE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IStream_UnlockRegion(stream, off, len, LOCK_EXCLUSIVE);
+    ok(hr == STG_E_LOCKVIOLATION, "got %#lx\n", hr);
+
+    /* empty ranges, as in the shlwapi tests */
+    len.QuadPart = 0;
+    hr = IStream_LockRegion(stream, off, len, 0);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IStream_UnlockRegion(stream, off, len, 0);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    hr = IStream_Revert(stream);
+    ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+    clone = (IStream *)0xdeadbeef;
+    hr = IStream_Clone(stream, &clone);
+    ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+
+    IStream_Release(stream);
+    DeleteFileW(path);
+}
