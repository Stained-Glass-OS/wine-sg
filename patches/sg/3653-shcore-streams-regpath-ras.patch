+static void test_memstream_clone(void)
+{
+    IStream *stream, *clone, *clone2;
+    LARGE_INTEGER move;
+    ULARGE_INTEGER size;
+    STATSTG stat;
+    char buf[16];
+    ULONG got;
+    HRESULT hr;
+
+    stream = SHCreateMemStream((const BYTE *)"abcdef", 6);
+    ok(!!stream, "Failed to create a stream.\n");
+
+    move.QuadPart = 2;
+    hr = IStream_Seek(stream, move, STREAM_SEEK_SET, NULL);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    hr = IStream_Clone(stream, &clone);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    memset(buf, 0, sizeof(buf));
+    hr = IStream_Read(clone, buf, 2, &got);
+    ok(hr == S_OK && got == 2 && !memcmp(buf, "cd", 2), "got %#lx %lu %s\n", hr, got, buf);
+
+    /* the original keeps its own position */
+    memset(buf, 0, sizeof(buf));
+    hr = IStream_Read(stream, buf, 2, &got);
+    ok(hr == S_OK && got == 2 && !memcmp(buf, "cd", 2), "got %#lx %lu %s\n", hr, got, buf);
+
+    /* writes through the clone are seen by the original, growth included */
+    move.QuadPart = 4;
+    IStream_Seek(clone, move, STREAM_SEEK_SET, NULL);
+    hr = IStream_Write(clone, "XYZW", 4, &got);
+    ok(hr == S_OK && got == 4, "got %#lx %lu\n", hr, got);
+    hr = IStream_Stat(stream, &stat, STATFLAG_NONAME);
+    ok(hr == S_OK && stat.cbSize.QuadPart == 8, "got %#lx %s\n", hr, wine_dbgstr_longlong(stat.cbSize.QuadPart));
+    move.QuadPart = 0;
+    IStream_Seek(stream, move, STREAM_SEEK_SET, NULL);
+    memset(buf, 0, sizeof(buf));
+    hr = IStream_Read(stream, buf, 8, &got);
+    ok(hr == S_OK && got == 8 && !memcmp(buf, "abcdXYZW", 8), "got %#lx %lu %s\n", hr, got, buf);
+
+    /* SetSize through the original is visible to the clone */
+    size.QuadPart = 3;
+    hr = IStream_SetSize(stream, size);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IStream_Stat(clone, &stat, STATFLAG_NONAME);
+    ok(hr == S_OK && stat.cbSize.QuadPart == 3, "got %#lx %s\n", hr, wine_dbgstr_longlong(stat.cbSize.QuadPart));
+
+    /* a clone of a clone, and the bytes outlive the original */
+    hr = IStream_Clone(clone, &clone2);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IStream_Release(stream);
+    IStream_Release(clone);
+    move.QuadPart = 0;
+    IStream_Seek(clone2, move, STREAM_SEEK_SET, NULL);
+    memset(buf, 0, sizeof(buf));
+    hr = IStream_Read(clone2, buf, 8, &got);
+    ok(hr == S_OK && got == 3 && !memcmp(buf, "abc", 3), "got %#lx %lu %s\n", hr, got, buf);
+    IStream_Release(clone2);
+
+}
