+/* A clone shares the bytes of the stream it was made from and has its own position. */
+static HRESULT WINAPI memstream_Clone(IStream *iface, IStream **dest)
+{
+    struct shstream *stream = impl_from_IStream(iface);
+    struct shstream *root = mem_root(stream), *clone;
+
+    TRACE("(%p, %p)\n", stream, dest);
+
+    if (!dest)
+        return E_POINTER;
+    *dest = NULL;
+
+    if (!(clone = calloc(1, sizeof(*clone))))
+        return E_OUTOFMEMORY;
+    clone->IStream_iface.lpVtbl = stream->IStream_iface.lpVtbl;
+    clone->refcount = 1;
+#ifdef SG_MUTANT_SHCORE_CLONE
+    clone->u.mem.root = NULL;
+    clone->u.mem.buffer = calloc(1, 1);
+    clone->u.mem.length = 0;
+#else
+    clone->u.mem.root = root;
+#endif
+    clone->u.mem.position = stream->u.mem.position;
+    IStream_AddRef(&root->IStream_iface);
+
+    *dest = &clone->IStream_iface;
+    return S_OK;
+}
