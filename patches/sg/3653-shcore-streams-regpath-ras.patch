+    RegDeleteKeyW(HKEY_CURRENT_USER, key_name);
+    ret = RegCreateKeyExW(HKEY_CURRENT_USER, key_name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL);
+    ok(!ret, "got %lu\n", ret);
+
+    GetWindowsDirectoryW(win, MAX_PATH);
+    lstrcpyW(path, win);
+    lstrcatW(path, L"\\system32\\sgcalls.dll");
+    ret = SHRegSetPathW(HKEY_CURRENT_USER, key_name, L"Unexpanded", path, 0);
+    ok(!ret, "got %lu\n", ret);
+    size = sizeof(data);
+    ret = RegQueryValueExW(key, L"Unexpanded", NULL, &type, (BYTE *)data, &size);
+    ok(!ret, "got %lu\n", ret);
+    ok(type == REG_EXPAND_SZ, "got type %lu\n", type);
+    ok(!wcsncmp(data, L"%", 1), "got %s\n", wine_dbgstr_w(data));
+    ok(size == (lstrlenW(data) + 1) * sizeof(WCHAR), "size %lu for %s\n", size, wine_dbgstr_w(data));
+    ExpandEnvironmentStringsW(data, expect, MAX_PATH);
+    ok(!lstrcmpiW(expect, path), "got %s\n", wine_dbgstr_w(expect));
+
+    ret = SHRegSetPathW(HKEY_CURRENT_USER, key_name, L"Plain", L"Q:\\no\\expansion\\here.txt", 0);
+    ok(!ret, "got %lu\n", ret);
+    size = sizeof(data);
+    ret = RegQueryValueExW(key, L"Plain", NULL, &type, (BYTE *)data, &size);
+    ok(!ret && type == REG_SZ && !lstrcmpW(data, L"Q:\\no\\expansion\\here.txt"), "got %lu %lu %s\n", ret, type, wine_dbgstr_w(data));
+    ok(size == (lstrlenW(data) + 1) * sizeof(WCHAR), "size %lu\n", size);
+
+    WideCharToMultiByte(CP_ACP, 0, path, -1, dataA, sizeof(dataA), NULL, NULL);
+    ret = SHRegSetPathA(HKEY_CURRENT_USER, "Software\\Wine\\Test\\sgcalls_path", "UnexpandedA", dataA, 0);
+    ok(!ret, "got %lu\n", ret);
+    size = sizeof(dataA);
+    ret = RegQueryValueExA(key, "UnexpandedA", NULL, &type, (BYTE *)dataA, &size);
+    ok(!ret && type == REG_EXPAND_SZ && dataA[0] == '%' && size == strlen(dataA) + 1, "got %lu %lu %s %lu\n", ret, type, dataA, size);
+
+    /* the subkey has to exist */
+    ret = SHRegSetPathW(HKEY_CURRENT_USER, L"Software\\Wine\\Test\\sgcalls_path\\missing", L"v", L"C:\\x", 0);
+    ok(ret == ERROR_FILE_NOT_FOUND, "got %lu\n", ret);
+
+    RegCloseKey(key);
+    RegDeleteKeyW(HKEY_CURRENT_USER, key_name);
+}
+
+static IBuffer *make_buffer(const char *text, UINT32 capacity)
+{
+    static const WCHAR name[] = L"Windows.Storage.Streams.Buffer";
+    IBufferFactory *factory;
+    IBuffer *buffer = NULL;
+    HSTRING str;
+    HRESULT hr;
+
+    WindowsCreateString(name, wcslen(name), &str);
+    hr = RoGetActivationFactory(str, &sg_IID_IBufferFactory, (void **)&factory);
+    WindowsDeleteString(str);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (FAILED(hr)) return NULL;
+    hr = IBufferFactory_Create(factory, capacity, &buffer);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IBufferFactory_Release(factory);
+    return buffer;
+}
+
+static void test_random_access(void)
+{
+    IStream *stream;
+    IRandomAccessStream *ras = NULL, *clone;
+    IInputStream *input;
+    IOutputStream *output;
+    IClosable *closable;
+    IAsyncOperationWithProgress_UINT32_UINT32 *write_op;
+    IAsyncOperationWithProgress_IBuffer_UINT32 *read_op;
+    IAsyncOperation_boolean *flush_op;
+    IBuffer *buffer, *result;
+    UINT64 value;
+    UINT32 count, length;
+    boolean flag;
+    char text[16];
+    LARGE_INTEGER move;
+    ULONG got;
+    HRESULT hr;
+
+    if (!pCreateRandomAccessStreamOverStream)
+    {
+        win_skip("CreateRandomAccessStreamOverStream is not available.\n");
+        return;
+    }
+
+    stream = SHCreateMemStream((const BYTE *)"abcdef", 6);
+    hr = pCreateRandomAccessStreamOverStream(stream, BSOS_DEFAULT, &sg_IID_IRandomAccessStream, (void **)&ras);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (FAILED(hr))
+    {
+        IStream_Release(stream);
+        return;
+    }
+
+    hr = IRandomAccessStream_get_Size(ras, &value);
+    ok(hr == S_OK && value == 6, "got %#lx %I64u\n", hr, value);
+    hr = IRandomAccessStream_get_CanRead(ras, &flag);
+    ok(hr == S_OK && flag, "got %#lx %d\n", hr, flag);
+    hr = IRandomAccessStream_get_CanWrite(ras, &flag);
+    ok(hr == S_OK && flag, "got %#lx %d\n", hr, flag);
+    hr = IRandomAccessStream_get_Position(ras, &value);
+    ok(hr == S_OK && value == 0, "got %#lx %I64u\n", hr, value);
+
+    hr = IRandomAccessStream_Seek(ras, 3);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IRandomAccessStream_get_Position(ras, &value);
+    ok(hr == S_OK && value == 3, "got %#lx %I64u\n", hr, value);
+
+    /* write two bytes at position 3 through the output stream */
+    hr = IRandomAccessStream_QueryInterface(ras, &sg_IID_IOutputStream, (void **)&output);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    buffer = make_buffer("ZZ", 8);
+    {
+        IBufferByteAccess_ *access = NULL;
+        BYTE *bytes = NULL;
+        hr = IBuffer_QueryInterface(buffer, &IID_IBufferByteAccess_, (void **)&access);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        hr = access->lpVtbl->Buffer(access, &bytes);
+        ok(hr == S_OK && bytes, "got %#lx\n", hr);
+        memcpy(bytes, "ZZ", 2);
+        access->lpVtbl->Release(access);
+    }
+    IBuffer_put_Length(buffer, 2);
+    hr = IOutputStream_WriteAsync(output, buffer, &write_op);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    count = 0;
+    hr = IAsyncOperationWithProgress_UINT32_UINT32_GetResults(write_op, &count);
+    ok(hr == S_OK && count == 2, "got %#lx %u\n", hr, count);
+    IAsyncOperationWithProgress_UINT32_UINT32_Release(write_op);
+    hr = IOutputStream_FlushAsync(output, &flush_op);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    flag = FALSE;
+    hr = IAsyncOperation_boolean_GetResults(flush_op, &flag);
+    ok(hr == S_OK && flag, "got %#lx %d\n", hr, flag);
+    IAsyncOperation_boolean_Release(flush_op);
+    IOutputStream_Release(output);
+    IBuffer_Release(buffer);
+
+    hr = IRandomAccessStream_get_Position(ras, &value);
+    ok(hr == S_OK && value == 5, "got %#lx %I64u\n", hr, value);
+
+    /* the COM stream sees the bytes */
+    move.QuadPart = 0;
+    IStream_Seek(stream, move, STREAM_SEEK_SET, NULL);
+    memset(text, 0, sizeof(text));
+    hr = IStream_Read(stream, text, 6, &got);
+    ok(hr == S_OK && got == 6 && !memcmp(text, "abcZZf", 6), "got %#lx %s\n", hr, text);
+
+    /* read it back from the start with an input stream */
+    hr = IRandomAccessStream_GetInputStreamAt(ras, 1, &input);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    buffer = make_buffer("", 16);
+    hr = IInputStream_ReadAsync(input, buffer, 4, InputStreamOptions_None, &read_op);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    result = NULL;
+    hr = IAsyncOperationWithProgress_IBuffer_UINT32_GetResults(read_op, &result);
+    ok(hr == S_OK && result, "got %#lx\n", hr);
+    length = 0;
+    IBuffer_get_Length(result, &length);
+    ok(length == 4, "got %u\n", length);
+    {
+        IBufferByteAccess_ *access = NULL;
+        BYTE *bytes = NULL;
+        IBuffer_QueryInterface(result, &IID_IBufferByteAccess_, (void **)&access);
+        access->lpVtbl->Buffer(access, &bytes);
+        ok(!memcmp(bytes, "bcZZ", 4), "got %.4s\n", bytes);
+        access->lpVtbl->Release(access);
+    }
+    IBuffer_Release(result);
+    IAsyncOperationWithProgress_IBuffer_UINT32_Release(read_op);
+    IBuffer_Release(buffer);
+    IInputStream_Release(input);
+
+    /* a clone starts at position 0; size changes go to the stream */
+    hr = IRandomAccessStream_CloneStream(ras, &clone);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IRandomAccessStream_get_Position(clone, &value);
+    ok(hr == S_OK && value == 0, "got %#lx %I64u\n", hr, value);
+    hr = IRandomAccessStream_put_Size(clone, 4);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IRandomAccessStream_get_Size(ras, &value);
+    ok(hr == S_OK && value == 4, "got %#lx %I64u\n", hr, value);
+    IRandomAccessStream_Release(clone);
+
+    /* after Close everything fails */
+    hr = IRandomAccessStream_QueryInterface(ras, &sg_IID_IClosable, (void **)&closable);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IClosable_Close(closable);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IClosable_Release(closable);
+    hr = IRandomAccessStream_get_Size(ras, &value);
+    ok(hr == RO_E_CLOSED, "got %#lx\n", hr);
+    hr = IRandomAccessStream_Seek(ras, 0);
+    ok(hr == RO_E_CLOSED, "got %#lx\n", hr);
+
+    IRandomAccessStream_Release(ras);
+    IStream_Release(stream);
+
+    /* a stream that cannot be cloned still wraps, but cannot be cloned */
+    {
+        WCHAR path[MAX_PATH];
+        GetTempPathW(MAX_PATH, path);
+        lstrcatW(path, L"sgcalls_ras.tmp");
+        hr = SHCreateStreamOnFileEx(path, STGM_CREATE | STGM_READWRITE, FILE_ATTRIBUTE_NORMAL, TRUE, NULL, &stream);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        hr = pCreateRandomAccessStreamOverStream(stream, BSOS_DEFAULT, &sg_IID_IRandomAccessStream, (void **)&ras);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        hr = IRandomAccessStream_CloneStream(ras, &clone);
+        ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+        IRandomAccessStream_Release(ras);
+        IStream_Release(stream);
+        DeleteFileW(path);
+    }
+}
+
+START_TEST(sgcalls)
+{
+    HMODULE shcore = GetModuleHandleA("shcore.dll");
+
+    pCreateRandomAccessStreamOverStream = (void *)GetProcAddress(shcore, "CreateRandomAccessStreamOverStream");
+
+    CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    test_memstream_clone();
+    test_filestream_locks();
+    test_regsetpath();
+    test_random_access();
+    CoUninitialize();
+}
