From: Stained Glass OS <ke7oxh@gmail.com>
oleacc: implement CreateStdAccessibleProxyA/W

The proxy of a standard window class is the standard accessible object of
the window; a class name and a result pointer are required.
---
--- a/dlls/oleacc/main.c
+++ b/dlls/oleacc/main.c
@@ -200,6 +200,48 @@ HRESULT WINAPI CreateStdAccessibleObject( HWND hwnd, LONG idObject,
     }
 }
 
+/* The proxy of a standard window class is the standard object of the window: the object
+ * follows the window's real class (client.c), the name only has to be one. */
+HRESULT WINAPI CreateStdAccessibleProxyW( HWND hwnd, const WCHAR *class_name, LONG idObject,
+        REFIID riidInterface, void **ppvObject )
+{
+    TRACE("%p %s %ld %s %p\n", hwnd, debugstr_w(class_name), idObject, debugstr_guid(riidInterface), ppvObject);
+
+    if (!ppvObject)
+        return E_INVALIDARG;
+#ifndef SG_MUTANT_ACC_PROXY_NOCLEAR
+    *ppvObject = NULL;
+#endif
+#ifndef SG_MUTANT_ACC_PROXY_NONAME
+    if (!class_name || !class_name[0])
+        return E_INVALIDARG;
+#endif
+    return CreateStdAccessibleObject(hwnd, idObject, riidInterface, ppvObject);
+}
+
+HRESULT WINAPI CreateStdAccessibleProxyA( HWND hwnd, const char *class_name, LONG idObject,
+        REFIID riidInterface, void **ppvObject )
+{
+    WCHAR *nameW = NULL;
+    HRESULT hr;
+    int len;
+
+    TRACE("%p %s %ld %s %p\n", hwnd, debugstr_a(class_name), idObject, debugstr_guid(riidInterface), ppvObject);
+
+    if (!ppvObject)
+        return E_INVALIDARG;
+    if (class_name)
+    {
+        len = MultiByteToWideChar(CP_ACP, 0, class_name, -1, NULL, 0);
+        if (!(nameW = malloc(len * sizeof(WCHAR))))
+            return E_OUTOFMEMORY;
+        MultiByteToWideChar(CP_ACP, 0, class_name, -1, nameW, len);
+    }
+    hr = CreateStdAccessibleProxyW(hwnd, nameW, idObject, riidInterface, ppvObject);
+    free(nameW);
+    return hr;
+}
+
 HRESULT WINAPI ObjectFromLresult( LRESULT result, REFIID riid, WPARAM wParam, void **ppObject )
 {
     WCHAR atom_str[ARRAY_SIZE(lresult_atom_prefix)+3*8+3];
