From: Drafter 5 <noreply@anthropic.com>
Subject: [PATCH] winegstreamer: Implement the remaining AAC decoder and video processor stubs.

The AAC decoder gets its transform attributes and the DRAIN/FLUSH/notification messages; the video
processor reports its output status and handles FLUSH; the documented E_NOTIMPL answers lose their
FIXME.
---
diff --git a/dlls/mf/tests/transform.c b/dlls/mf/tests/transform.c
index 129a8b0..1284e14 100644
--- a/dlls/mf/tests/transform.c
+++ b/dlls/mf/tests/transform.c
@@ -2484,7 +2484,7 @@ static void test_aac_decoder_subtype(const struct attribute_desc *input_type_des
     };
     const struct attribute_desc expect_transform_attributes[] =
     {
-        ATTR_UINT32(MFT_SUPPORT_DYNAMIC_FORMAT_CHANGE, !has_video_processor /* 1 on W7 */, .todo = TRUE),
+        ATTR_UINT32(MFT_SUPPORT_DYNAMIC_FORMAT_CHANGE, !has_video_processor /* 1 on W7 */),
         /* more AAC decoder specific attributes from CODECAPI */
         {0},
     };
diff --git a/dlls/winegstreamer/aac_decoder.c b/dlls/winegstreamer/aac_decoder.c
index d8e8246..5fd420e 100644
--- a/dlls/winegstreamer/aac_decoder.c
+++ b/dlls/winegstreamer/aac_decoder.c
@@ -61,6 +61,7 @@ struct aac_decoder
     UINT input_type_count;
     WAVEFORMATEXTENSIBLE *input_types;
 
+    IMFAttributes *attributes;
     IMFMediaType *input_type;
     IMFMediaType *output_type;
 
@@ -129,6 +130,7 @@ static ULONG WINAPI transform_Release(IMFTransform *iface)
         if (decoder->output_type)
             IMFMediaType_Release(decoder->output_type);
         wg_sample_queue_destroy(decoder->wg_sample_queue);
+        IMFAttributes_Release(decoder->attributes);
         free(decoder);
     }
 
@@ -189,8 +191,18 @@ static HRESULT WINAPI transform_GetOutputStreamInfo(IMFTransform *iface, DWORD i
 
 static HRESULT WINAPI transform_GetAttributes(IMFTransform *iface, IMFAttributes **attributes)
 {
+    struct aac_decoder *decoder = impl_from_IMFTransform(iface);
+
     TRACE("iface %p, attributes %p.\n", iface, attributes);
+
+    if (!attributes)
+        return E_POINTER;
+
+#ifdef SG_MUTANT_AAC_ATTR
     return E_NOTIMPL;
+#endif
+    IMFAttributes_AddRef((*attributes = decoder->attributes));
+    return S_OK;
 }
 
 static HRESULT WINAPI transform_GetInputStreamAttributes(IMFTransform *iface, DWORD id, IMFAttributes **attributes)
@@ -500,9 +512,10 @@ static HRESULT WINAPI transform_GetInputStatus(IMFTransform *iface, DWORD id, DW
     return S_OK;
 }
 
+/* The output status, the bounds and the events are optional: the decoder answers E_NOTIMPL. */
 static HRESULT WINAPI transform_GetOutputStatus(IMFTransform *iface, DWORD *flags)
 {
-    FIXME("iface %p, flags %p stub!\n", iface, flags);
+    TRACE("iface %p, flags %p.\n", iface, flags);
     return E_NOTIMPL;
 }
 
@@ -514,14 +527,37 @@ static HRESULT WINAPI transform_SetOutputBounds(IMFTransform *iface, LONGLONG lo
 
 static HRESULT WINAPI transform_ProcessEvent(IMFTransform *iface, DWORD id, IMFMediaEvent *event)
 {
-    FIXME("iface %p, id %#lx, event %p stub!\n", iface, id, event);
+    TRACE("iface %p, id %#lx, event %p.\n", iface, id, event);
     return E_NOTIMPL;
 }
 
 static HRESULT WINAPI transform_ProcessMessage(IMFTransform *iface, MFT_MESSAGE_TYPE message, ULONG_PTR param)
 {
-    FIXME("iface %p, message %#x, param %p stub!\n", iface, message, (void *)param);
-    return S_OK;
+    struct aac_decoder *decoder = impl_from_IMFTransform(iface);
+
+    TRACE("iface %p, message %#x, param %p.\n", iface, message, (void *)param);
+
+    switch (message)
+    {
+    case MFT_MESSAGE_COMMAND_DRAIN:
+        return decoder->wg_transform ? wg_transform_drain(decoder->wg_transform) : MF_E_TRANSFORM_TYPE_NOT_SET;
+
+    case MFT_MESSAGE_COMMAND_FLUSH:
+#ifdef SG_MUTANT_AAC_FLUSH
+        return S_OK;
+#endif
+        return decoder->wg_transform ? wg_transform_flush(decoder->wg_transform) : MF_E_TRANSFORM_TYPE_NOT_SET;
+
+    case MFT_MESSAGE_NOTIFY_BEGIN_STREAMING:
+    case MFT_MESSAGE_NOTIFY_END_STREAMING:
+    case MFT_MESSAGE_NOTIFY_END_OF_STREAM:
+    case MFT_MESSAGE_NOTIFY_START_OF_STREAM:
+        return S_OK;
+
+    default:
+        FIXME("Ignoring message %#x.\n", message);
+        return S_OK;
+    }
 }
 
 static HRESULT WINAPI transform_ProcessInput(IMFTransform *iface, DWORD id, IMFSample *sample, DWORD flags)
@@ -631,11 +667,11 @@ HRESULT aac_decoder_create(REFIID riid, void **ret)
     decoder->input_types = (WAVEFORMATEXTENSIBLE *)aac_decoder_input_types;
     decoder->input_type_count = ARRAY_SIZE(aac_decoder_input_types);
 
+    if (FAILED(hr = MFCreateAttributes(&decoder->attributes, 1))
+            || FAILED(hr = IMFAttributes_SetUINT32(decoder->attributes, &MFT_SUPPORT_DYNAMIC_FORMAT_CHANGE, FALSE)))
+        goto failed;
     if (FAILED(hr = wg_sample_queue_create(&decoder->wg_sample_queue)))
-    {
-        free(decoder);
-        return hr;
-    }
+        goto failed;
 
     decoder->IMFTransform_iface.lpVtbl = &transform_vtbl;
     decoder->refcount = 1;
@@ -643,4 +679,10 @@ HRESULT aac_decoder_create(REFIID riid, void **ret)
     *ret = &decoder->IMFTransform_iface;
     TRACE("Created decoder %p\n", *ret);
     return S_OK;
+
+failed:
+    if (decoder->attributes)
+        IMFAttributes_Release(decoder->attributes);
+    free(decoder);
+    return hr;
 }
diff --git a/dlls/winegstreamer/video_processor.c b/dlls/winegstreamer/video_processor.c
index 3cb2c1a..048bd59 100644
--- a/dlls/winegstreamer/video_processor.c
+++ b/dlls/winegstreamer/video_processor.c
@@ -86,6 +86,8 @@ struct video_processor
 
     wg_transform_t wg_transform;
     struct wg_sample_queue *wg_sample_queue;
+    /* input samples accepted and not yet converted: the conversion is one to one */
+    LONG pending_samples;
 
     IUnknown *device_manager;
     IMFVideoSampleAllocatorEx *allocator;
@@ -162,6 +164,7 @@ static HRESULT try_create_wg_transform(struct video_processor *impl)
         wg_transform_destroy(impl->wg_transform);
         impl->wg_transform = 0;
     }
+    impl->pending_samples = 0;
 
     if (FAILED(hr = normalize_media_types(bottom_up, &input_type, &output_type)))
         return hr;
@@ -465,6 +468,7 @@ static HRESULT WINAPI video_processor_SetInputType(IMFTransform *iface, DWORD id
         {
             wg_transform_destroy(impl->wg_transform);
             impl->wg_transform = 0;
+            impl->pending_samples = 0;
         }
 
         return S_OK;
@@ -524,6 +528,7 @@ static HRESULT WINAPI video_processor_SetOutputType(IMFTransform *iface, DWORD i
         {
             wg_transform_destroy(impl->wg_transform);
             impl->wg_transform = 0;
+            impl->pending_samples = 0;
         }
 
         return S_OK;
@@ -613,7 +618,7 @@ static HRESULT WINAPI video_processor_GetInputStatus(IMFTransform *iface, DWORD
 {
     struct video_processor *impl = impl_from_IMFTransform(iface);
 
-    FIXME("iface %p, id %#lx, flags %p stub!\n", iface, id, flags);
+    TRACE("iface %p, id %#lx, flags %p.\n", iface, id, flags);
 
     if (!impl->input_type)
         return MF_E_TRANSFORM_TYPE_NOT_SET;
@@ -626,12 +631,19 @@ static HRESULT WINAPI video_processor_GetOutputStatus(IMFTransform *iface, DWORD
 {
     struct video_processor *impl = impl_from_IMFTransform(iface);
 
-    FIXME("iface %p, flags %p stub!\n", iface, flags);
+    TRACE("iface %p, flags %p.\n", iface, flags);
 
-    if (!impl->output_type)
+    if (!flags)
+        return E_POINTER;
+    if (!impl->wg_transform)
         return MF_E_TRANSFORM_TYPE_NOT_SET;
 
-    return E_NOTIMPL;
+#ifdef SG_MUTANT_VPROC_STATUS
+    *flags = 0;
+    return S_OK;
+#endif
+    *flags = ReadAcquire(&impl->pending_samples) > 0 ? MFT_OUTPUT_STATUS_SAMPLE_READY : 0;
+    return S_OK;
 }
 
 static HRESULT WINAPI video_processor_SetOutputBounds(IMFTransform *iface, LONGLONG lower, LONGLONG upper)
@@ -642,7 +654,7 @@ static HRESULT WINAPI video_processor_SetOutputBounds(IMFTransform *iface, LONGL
 
 static HRESULT WINAPI video_processor_ProcessEvent(IMFTransform *iface, DWORD id, IMFMediaEvent *event)
 {
-    FIXME("iface %p, id %#lx, event %p stub!\n", iface, id, event);
+    TRACE("iface %p, id %#lx, event %p.\n", iface, id, event);
     return E_NOTIMPL;
 }
 
@@ -671,6 +683,24 @@ static HRESULT WINAPI video_processor_ProcessMessage(IMFTransform *iface, MFT_ME
         }
         return S_OK;
 
+    case MFT_MESSAGE_COMMAND_FLUSH:
+#ifdef SG_MUTANT_VPROC_FLUSH
+        return S_OK;
+#endif
+        if (processor->wg_transform && SUCCEEDED(hr = wg_transform_flush(processor->wg_transform)))
+            InterlockedExchange(&processor->pending_samples, 0);
+        else if (processor->wg_transform)
+            return hr;
+        return S_OK;
+
+    /* the conversion keeps no state between samples: nothing to drain or announce */
+    case MFT_MESSAGE_COMMAND_DRAIN:
+    case MFT_MESSAGE_NOTIFY_BEGIN_STREAMING:
+    case MFT_MESSAGE_NOTIFY_END_STREAMING:
+    case MFT_MESSAGE_NOTIFY_END_OF_STREAM:
+    case MFT_MESSAGE_NOTIFY_START_OF_STREAM:
+        return S_OK;
+
     default:
         FIXME("Ignoring message %#x.\n", message);
         return S_OK;
@@ -680,13 +710,16 @@ static HRESULT WINAPI video_processor_ProcessMessage(IMFTransform *iface, MFT_ME
 static HRESULT WINAPI video_processor_ProcessInput(IMFTransform *iface, DWORD id, IMFSample *sample, DWORD flags)
 {
     struct video_processor *impl = impl_from_IMFTransform(iface);
+    HRESULT hr;
 
     TRACE("iface %p, id %#lx, sample %p, flags %#lx.\n", iface, id, sample, flags);
 
     if (!impl->wg_transform)
         return MF_E_TRANSFORM_TYPE_NOT_SET;
 
-    return wg_transform_push_mf(impl->wg_transform, sample, impl->wg_sample_queue);
+    if (SUCCEEDED(hr = wg_transform_push_mf(impl->wg_transform, sample, impl->wg_sample_queue)))
+        InterlockedIncrement(&impl->pending_samples);
+    return hr;
 }
 
 static HRESULT WINAPI video_processor_ProcessOutput(IMFTransform *iface, DWORD flags, DWORD count,
@@ -726,6 +759,10 @@ static HRESULT WINAPI video_processor_ProcessOutput(IMFTransform *iface, DWORD f
     if (FAILED(hr = wg_transform_read_mf(impl->wg_transform, output_sample, info.cbSize, &samples->dwStatus)))
         goto done;
     wg_sample_queue_flush(impl->wg_sample_queue, false);
+#ifndef SG_MUTANT_VPROC_PENDING
+    if (ReadAcquire(&impl->pending_samples) > 0)
+        InterlockedDecrement(&impl->pending_samples);
+#endif
 
     if (impl->output_info.dwFlags & MFT_OUTPUT_STREAM_PROVIDES_SAMPLES)
     {
