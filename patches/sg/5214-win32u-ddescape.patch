From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] win32u

 D3DKMTEscape:D3DKMTEscape validates its parameters (STATUS_INVALID_PARAMETER) and answers STATUS_NOT_SUPPORTED for a valid request, instead of STATUS_NO_MEMORY for everything. CORE: integrator must review
(patches/notes/5214.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/win32u/d3dkmt.c b/dlls/win32u/d3dkmt.c
--- a/dlls/win32u/d3dkmt.c
+++ b/dlls/win32u/d3dkmt.c
@@ -167,8 +167,26 @@
  */
 NTSTATUS WINAPI NtGdiDdDDIEscape( const D3DKMT_ESCAPE *desc )
 {
-    FIXME( "(%p): stub\n", desc );
-    return STATUS_NO_MEMORY;
+    BOOL known;
+
+    TRACE( "(%p)\n", desc );
+
+    /* Stained Glass OS: parameters are validated as D3DKMTEscape documents (STATUS_INVALID_PARAMETER);
+     * there is no kernel-mode display driver to exchange data with, so a valid request is not
+     * supported. */
+    if (!desc || !desc->hAdapter) return STATUS_INVALID_PARAMETER;
+    if ((UINT)desc->Type > D3DKMT_ESCAPE_DIAGNOSTICS) return STATUS_INVALID_PARAMETER;
+    if (desc->PrivateDriverDataSize && !desc->pPrivateDriverData) return STATUS_INVALID_PARAMETER;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    known = find_adapter_from_handle( desc->hAdapter ) != NULL;
+    pthread_mutex_unlock( &d3dkmt_lock );
+#ifdef SG_MUTANT_ESCAPE_NOADAPTER
+    known = TRUE;
+#endif
+    if (!known) return STATUS_INVALID_PARAMETER;
+
+    return STATUS_NOT_SUPPORTED;
 }
 
