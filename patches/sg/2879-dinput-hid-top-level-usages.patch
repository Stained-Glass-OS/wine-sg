From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dinput: enumerate HID devices with simulation, game-control and multi-axis top level usages

hid_joystick_device_try_open only accepted generic desktop gamepad and joystick top level usages. A table (hid_usage_type.h) now maps the other game-controller usages to DI8DEVTYPE values: multi-axis controller (1STPERSON/SIXDOF), simulation controls devices (flight, spaceship, airplane, helicopter, magic carpet = FLIGHT; automobile, tank, submarine, sailing, motorcycle, bicycle = DRIVING; sports = JOYSTICK) and game controls (3D game controller = 1STPERSON, pinball = JOYSTICK, gun = SCREENPOINTER/LIGHTGUN). Mouse, keyboard and every other usage stay ignored; the object based type refinement (steering, pedals, X/Y) is unchanged.
---
diff --git a/dlls/dinput/hid_usage_type.h b/dlls/dinput/hid_usage_type.h
new file mode 100644
index 0000000..7066ef0
--- /dev/null
+++ b/dlls/dinput/hid_usage_type.h
@@ -0,0 +1,72 @@
+/*
+ * DirectInput device types for the top level HID usage of a game controller
+ *
+ * This file is distributed under the LGPL; it is written from the HID usage
+ * tables and the DirectInput device type documentation.
+ */
+
+#ifndef __WINE_DINPUT_HID_USAGE_TYPE_H
+#define __WINE_DINPUT_HID_USAGE_TYPE_H
+
+#ifdef SG_MUTANT_UT_PAGES
+#define SG_UT_FLIGHT_SIM 0x03
+#else
+#define SG_UT_FLIGHT_SIM 0x01
+#endif
+
+struct hid_usage_type
+{
+    unsigned short page, usage;
+    unsigned long type; /* DI8DEVTYPE_*, with the subtype in bits 8-15 when it does not depend on the objects */
+};
+
+/* Top level usages that DirectInput enumerates as game controllers. Mouse and
+ * keyboard (generic desktop 0x02 and 0x06) are handled by the callers, every
+ * other usage is not a game controller. Simulation and game controls pages and
+ * the multi-axis controller are mapped from their documented meaning. */
+static const struct hid_usage_type hid_usage_types[] =
+{
+    /* generic desktop */
+    {0x01, 0x04, DI8DEVTYPE_JOYSTICK},
+    {0x01, 0x05, DI8DEVTYPE_GAMEPAD},
+#ifndef SG_MUTANT_UT_MULTIAXIS
+    {0x01, 0x08, DI8DEVTYPE_1STPERSON | (DI8DEVTYPE1STPERSON_SIXDOF << 8)},  /* multi-axis controller */
+#endif
+    /* simulation controls */
+    {0x02, SG_UT_FLIGHT_SIM, DI8DEVTYPE_FLIGHT},   /* flight simulation device */
+#ifdef SG_MUTANT_UT_DRIVING
+    {0x02, 0x02, DI8DEVTYPE_FLIGHT},
+#else
+    {0x02, 0x02, DI8DEVTYPE_DRIVING},  /* automobile simulation device */
+#endif
+    {0x02, 0x03, DI8DEVTYPE_DRIVING},  /* tank simulation device */
+    {0x02, 0x04, DI8DEVTYPE_FLIGHT},   /* spaceship simulation device */
+    {0x02, 0x05, DI8DEVTYPE_DRIVING},  /* submarine simulation device */
+    {0x02, 0x06, DI8DEVTYPE_DRIVING},  /* sailing simulation device */
+    {0x02, 0x07, DI8DEVTYPE_DRIVING},  /* motorcycle simulation device */
+    {0x02, 0x08, DI8DEVTYPE_JOYSTICK}, /* sports simulation device */
+    {0x02, 0x09, DI8DEVTYPE_FLIGHT},   /* airplane simulation device */
+    {0x02, 0x0a, DI8DEVTYPE_FLIGHT},   /* helicopter simulation device */
+    {0x02, 0x0b, DI8DEVTYPE_FLIGHT},   /* magic carpet simulation device */
+    {0x02, 0x0c, DI8DEVTYPE_DRIVING},  /* bicycle simulation device */
+    /* game controls */
+    {0x05, 0x01, DI8DEVTYPE_1STPERSON | (DI8DEVTYPE1STPERSON_UNKNOWN << 8)},  /* 3D game controller */
+    {0x05, 0x02, DI8DEVTYPE_JOYSTICK},                                        /* pinball device */
+#ifdef SG_MUTANT_UT_GAME
+    {0x05, 0x03, DI8DEVTYPE_SCREENPOINTER},
+#else
+    {0x05, 0x03, DI8DEVTYPE_SCREENPOINTER | (DI8DEVTYPESCREENPTR_LIGHTGUN << 8)}, /* gun device */
+#endif
+};
+
+/* returns 0 when the usage is not a game controller */
+static inline unsigned long hid_joystick_usage_type( unsigned short page, unsigned short usage )
+{
+    unsigned int i;
+    for (i = 0; i < sizeof(hid_usage_types) / sizeof(*hid_usage_types); i++)
+        if (hid_usage_types[i].page == page && hid_usage_types[i].usage == usage)
+            return hid_usage_types[i].type;
+    return 0;
+}
+
+#endif /* __WINE_DINPUT_HID_USAGE_TYPE_H */
diff --git a/dlls/dinput/joystick_hid.c b/dlls/dinput/joystick_hid.c
index c5a20c2..d754086 100644
--- a/dlls/dinput/joystick_hid.c
+++ b/dlls/dinput/joystick_hid.c
@@ -40,6 +40,7 @@
 #include "setupapi.h"
 
 #include "dinput_private.h"
+#include "hid_usage_type.h"
 #include "device_private.h"
 
 #include "initguid.h"
@@ -1442,14 +1443,14 @@ static HRESULT hid_joystick_device_try_open( const WCHAR *path, HANDLE *device,
     if (!HidD_GetAttributes( device_file, attrs )) goto failed;
     if (HidP_GetCaps( preparsed_data, caps ) != HIDP_STATUS_SUCCESS) goto failed;
 
-    switch (MAKELONG( caps->Usage, caps->UsagePage ))
-    {
-    case MAKELONG( HID_USAGE_GENERIC_MOUSE, HID_USAGE_PAGE_GENERIC ):  goto failed;
-    case MAKELONG( HID_USAGE_GENERIC_KEYBOARD, HID_USAGE_PAGE_GENERIC ):  goto failed;
-    case MAKELONG( HID_USAGE_GENERIC_GAMEPAD, HID_USAGE_PAGE_GENERIC ): type = DI8DEVTYPE_GAMEPAD; break;
-    case MAKELONG( HID_USAGE_GENERIC_JOYSTICK, HID_USAGE_PAGE_GENERIC ): type = DI8DEVTYPE_JOYSTICK; break;
+    if (caps->UsagePage == HID_USAGE_PAGE_GENERIC &&
+        (caps->Usage == HID_USAGE_GENERIC_MOUSE || caps->Usage == HID_USAGE_GENERIC_KEYBOARD))
+        goto failed;
     /* other top level usages (consumer controls, vendor pages, ...) are not game controllers */
-    default: TRACE( "ignoring device with usage %04x:%04x\n", caps->UsagePage, caps->Usage ); goto failed;
+    if (!(type = hid_joystick_usage_type( caps->UsagePage, caps->Usage )))
+    {
+        TRACE( "ignoring device with usage %04x:%04x\n", caps->UsagePage, caps->Usage );
+        goto failed;
     }
 
     if (!HidD_GetProductString( device_file, instance->tszInstanceName, MAX_PATH * sizeof(WCHAR) )) goto failed;
