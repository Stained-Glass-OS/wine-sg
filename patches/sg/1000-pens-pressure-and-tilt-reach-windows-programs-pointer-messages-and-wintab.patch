+/* Stained Glass OS: a pen's pointer message (wine-sg 1000). The display
+ * driver sends a pen's motion, tip and lift as WM_POINTERUPDATE, DOWN and
+ * UP with the pen's state (pressure, tilt, buttons) in the high half of the
+ * lparam; it reaches the message as its extra info, for GetPointerPenInfo.
+ * A pen enters a window (WM_POINTERENTER) when it first comes over it and
+ * leaves it (WM_POINTERLEAVE) for another or when the driver says so. The
+ * mouse's messages come from the X server's own pointer (marked as a pen's),
+ * so unlike a touch's none are made here, and a pen held still sends nothing
+ * more. Before, a pen's pressure reached no program. */
+static void queue_pen_message( struct desktop *desktop, user_handle_t win, const union hw_input *input )
+{
+    struct hw_msg_source source = { IMDT_PEN, IMO_HARDWARE };
+    unsigned int id = LOWORD(input->hw.wparam), info = input->hw.lparam >> 32;
+    unsigned int wparam = input->hw.wparam | (POINTER_MESSAGE_FLAG_PRIMARY << 16);
+    timeout_t time = get_tick_count();
+    struct pointer *pointer, *found = NULL;
+    struct rectangle top_rect;
+    struct message *msg;
+    int x, y;
+
+    LIST_FOR_EACH_ENTRY( pointer, &desktop->pointers, struct pointer, entry )
+        if (pointer->pen && LOWORD(pointer->input.hw.wparam) == id) found = pointer;
+    if (!(pointer = found))
+    {
+        if (input->hw.msg == WM_POINTERLEAVE) return;
+        if (!(pointer = mem_alloc( sizeof(*pointer) ))) return;
+        pointer->timeout = NULL;
+        pointer->desktop = desktop;
+        pointer->win = 0;
+        pointer->primary = 1;
+        pointer->pen = 1;
+        pointer->contact = 0;
+        list_add_tail( &desktop->pointers, &pointer->entry );
+    }
+
+    get_virtual_screen_rect( desktop, &top_rect, 0 );
+    x = top_rect.left + LOWORD(input->hw.lparam) * (top_rect.right - top_rect.left) / 65535;
+    y = top_rect.top + HIWORD(input->hw.lparam) * (top_rect.bottom - top_rect.top) / 65535;
+    /* to the window it went down on (until it lifts), else the one under
+     * it: the driver names none when the pen is over its desktop window,
+     * which may lie over other programs' windows on the X screen */
+    if (input->hw.msg == WM_POINTERLEAVE) win = pointer->win;
+    else if (pointer->contact && pointer->win) win = pointer->win;
+    else if (!win) win = shallow_window_from_point( desktop, x, y );
+    if (input->hw.msg == WM_POINTERDOWN) pointer->contact = 1;
+    else if (input->hw.msg == WM_POINTERUP) pointer->contact = 0;
+
+    if (pointer->win && pointer->win != win && (msg = alloc_hardware_message( info, source, time, 0 )))
+    {
+        msg->win    = get_user_full_handle( pointer->win );
+        msg->msg    = WM_POINTERLEAVE;
+        msg->wparam = wparam & ~((POINTER_MESSAGE_FLAG_INCONTACT | POINTER_MESSAGE_FLAG_FIRSTBUTTON) << 16);
+        msg->lparam = MAKELONG(x, y);
+        msg->x      = x;
+        msg->y      = y;
+        queue_hardware_message( desktop, msg, 1 );
+    }
+    if (input->hw.msg == WM_POINTERLEAVE)
+    {
+        list_remove( &pointer->entry );
+        free( pointer );
+        return;
+    }
+    if (pointer->win != win && (msg = alloc_hardware_message( info, source, time, 0 )))
+    {
+        msg->win    = get_user_full_handle( win );
+        msg->msg    = WM_POINTERENTER;
+        msg->wparam = wparam | (POINTER_MESSAGE_FLAG_NEW << 16);
+        msg->lparam = MAKELONG(x, y);
+        msg->x      = x;
+        msg->y      = y;
+        queue_hardware_message( desktop, msg, 1 );
+    }
+    pointer->win = win;
+    pointer->input = *input;
+
+    if (!(msg = alloc_hardware_message( info, source, time, 0 ))) return;
+    msg->win    = get_user_full_handle( win );
+    msg->msg    = input->hw.msg;
+    msg->wparam = wparam;
+    msg->lparam = MAKELONG(x, y);
+    msg->x      = x;
+    msg->y      = y;
+    queue_hardware_message( desktop, msg, 1 );
+}
