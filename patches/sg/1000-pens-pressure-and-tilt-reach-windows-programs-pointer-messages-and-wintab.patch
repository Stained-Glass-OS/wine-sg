+static BOOL pen_valuator( const XIValuatorState *valuators, int number, double *value )
+{
+    const double *v = valuators->values;
+    int i;
+
+    if (number < 0 || number >= valuators->mask_len * 8 || !XIMaskIsSet( valuators->mask, number )) return FALSE;
+    for (i = 0; i < number; i++) if (XIMaskIsSet( valuators->mask, i )) v++;
+    *value = *v;
+    return TRUE;
+}
+
+static void send_pen_leave( struct x11drv_thread_data *data )
+{
+    INPUT input = {.type = INPUT_HARDWARE};
+
+    input.hi.uMsg = WM_POINTERLEAVE;
+    input.hi.wParamL = SG_PEN_POINTER_ID( data->pen_last_device );
+    input.hi.wParamH = 0;
+    NtUserSendHardwareInput( 0, 0, &input, (LPARAM)((ULONG64)SG_PEN_MARK << 32) );
+    data->pen_last_device = 0;
+}
+
+/* a pen's pointer message: KIND is XI_Motion, XI_ButtonPress or
+ * XI_ButtonRelease (BUTTON pressed or released), at ROOT_X, ROOT_Y on the X
+ * screen, over HWND (0: whichever window is under it) */
+static void send_pen_message( struct x11drv_thread_data *data, const struct pen_device *pen, HWND hwnd,
+                              int kind, int button, const XIValuatorState *valuators, Window window,
+                              double event_x, double event_y, double root_x, double root_y )
+{
+    RECT virtual = NtUserGetVirtualScreenRect( MDT_RAW_DPI );
+    INPUT input = {.type = INPUT_HARDWARE}, pos = {.type = INPUT_MOUSE};
+    UINT32 state = SG_PEN_MARK;
+    UINT flags = POINTER_MESSAGE_FLAG_INRANGE;
+    BOOL contact, barrel;
+    double value;
+    LPARAM lparam;
+    int x, y;
+
+    if (virtual.right <= virtual.left || virtual.bottom <= virtual.top) return;
+    /* over the desktop's own X window (which may lie over other programs'):
+     * the server sends it to the window under the pen */
+    if (hwnd == NtUserGetDesktopWindow()) hwnd = 0;
+
+    if (kind == XI_ButtonPress) data->pen_buttons |= 1u << (button & 31);
+    else if (kind == XI_ButtonRelease) data->pen_buttons &= ~(1u << (button & 31));
+    contact = (data->pen_buttons >> 1) & 1;
+    barrel = (data->pen_buttons >> 2) & 3;
+
+    if (pen_valuator( valuators, pen->pressure, &value ) && pen->pressure_max > pen->pressure_min)
+        data->pen_pressure = max( 0, min( 1024, (int)lround( (value - pen->pressure_min) * 1024 /
+                                                              (pen->pressure_max - pen->pressure_min) ) ) );
+    if (pen_valuator( valuators, pen->tilt_x, &value )) data->pen_tilt_x = max( -90, min( 90, lround( value ) ) );
+    if (pen_valuator( valuators, pen->tilt_y, &value )) data->pen_tilt_y = max( -90, min( 90, lround( value ) ) );
+
+    state |= SG_PEN_PACK( contact ? data->pen_pressure : 0, data->pen_tilt_x, data->pen_tilt_y );
+    if (pen->pressure >= 0) state |= SG_PEN_HAS_PRESSURE;
+    if (pen->tilt_x >= 0 && pen->tilt_y >= 0) state |= SG_PEN_HAS_TILT;
+    if (barrel) state |= SG_PEN_BARREL;
+    if (pen->eraser) state |= SG_PEN_ERASER;
+    if (contact) flags |= POINTER_MESSAGE_FLAG_INCONTACT | POINTER_MESSAGE_FLAG_FIRSTBUTTON;
+    if (barrel) flags |= POINTER_MESSAGE_FLAG_SECONDBUTTON;
+
+    if (kind == XI_ButtonPress && button == 1) input.hi.uMsg = WM_POINTERDOWN;
+    else if (kind == XI_ButtonRelease && button == 1) input.hi.uMsg = WM_POINTERUP;
+    else input.hi.uMsg = WM_POINTERUPDATE;
+
+    /* the stylus and its eraser end are pointers of their own */
+    if (data->pen_last_device && data->pen_last_device != pen->id) send_pen_leave( data );
+    data->pen_last_device = pen->id;
+
+    pos.mi.dx = lround( event_x );
+    pos.mi.dy = lround( event_y );
+    map_event_coords( hwnd, window, DefaultRootWindow( data->display ), root_x, root_y, &pos );
+    x = (pos.mi.dx - virtual.left) * 65535 / (virtual.right - virtual.left);
+    y = (pos.mi.dy - virtual.top) * 65535 / (virtual.bottom - virtual.top);
+    lparam = (LPARAM)(((ULONG64)state << 32) | MAKELONG( max( 0, min( 65535, x ) ), max( 0, min( 65535, y ) ) ));
+
+    TRACE( "pen %d %s hwnd %p pos %d,%d pressure %u tilt %d,%d flags %#x\n", pen->id,
+           input.hi.uMsg == WM_POINTERDOWN ? "down" : input.hi.uMsg == WM_POINTERUP ? "up" : "update",
+           hwnd, (int)pos.mi.dx, (int)pos.mi.dy, SG_PEN_PRESSURE( state ), SG_PEN_TILT_X( state ),
+           SG_PEN_TILT_Y( state ), flags );
+    input.hi.wParamL = SG_PEN_POINTER_ID( pen->id );
+    input.hi.wParamH = flags;
+    NtUserSendHardwareInput( hwnd, 0, &input, lparam );
+}
