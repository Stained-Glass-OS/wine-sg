+/* Stained Glass OS: the pointer message (a pen's) the thread last
+ * retrieved, as Windows' structures (wine-sg 1000) */
+static void fill_pointer_info( const struct sg_pointer_data *data, POINTER_INFO *info )
+{
+    memset( info, 0, sizeof(*info) );
+    info->pointerType = data->type;
+    info->pointerId = data->id;
+    info->frameId = data->frame;
+    info->pointerFlags = data->flags;
+    info->sourceDevice = ULongToHandle( data->device );
+    info->hwndTarget = ULongToHandle( data->hwnd );
+    info->ptPixelLocation.x = info->ptPixelLocationRaw.x = data->x;
+    info->ptPixelLocation.y = info->ptPixelLocationRaw.y = data->y;
+    /* the device's space is the screen's (GetPointerDeviceRects) */
+    info->ptHimetricLocation = info->ptHimetricLocationRaw = info->ptPixelLocation;
+    info->dwTime = data->time;
+    info->historyCount = 1;
+    if (NtUserGetKeyState( VK_SHIFT ) < 0) info->dwKeyStates |= POINTER_MOD_SHIFT;
+    if (NtUserGetKeyState( VK_CONTROL ) < 0) info->dwKeyStates |= POINTER_MOD_CTRL;
+    info->ButtonChangeType = data->button_change;
+}
+
+static void fill_pen_info( const struct sg_pointer_data *data, POINTER_PEN_INFO *info )
+{
+    fill_pointer_info( data, &info->pointerInfo );
+    info->penFlags = data->pen_flags;
+    info->penMask = data->pen_mask;
+    info->pressure = data->pressure;
+    info->rotation = 0;
+    info->tiltX = data->tilt_x;
+    info->tiltY = data->tilt_y;
+}
+
+static BOOL get_pointer_data( UINT32 id, struct sg_pointer_data *data )
+{
+    if (!NtUserSgGetPointerData( id, data ))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* the history and frame variants: one entry, one pointer (a pen's frame
+ * holds only itself) */
+static BOOL get_pen_info_list( UINT32 id, UINT32 *entries, UINT32 *pointers, POINTER_PEN_INFO *info )
+{
+    struct sg_pointer_data data;
+
+    if (!entries || !get_pointer_data( id, &data )) return FALSE;
+    if (data.type != PT_PEN)
+    {
+        SetLastError(ERROR_DATATYPE_MISMATCH);
+        return FALSE;
+    }
+    if (info && *entries) fill_pen_info( &data, info );
+    *entries = 1;
+    if (pointers) *pointers = 1;
+    return TRUE;
+}
+
+static BOOL get_pointer_info_list( UINT32 id, UINT32 *entries, UINT32 *pointers, POINTER_INFO *info )
+{
+    struct sg_pointer_data data;
+
+    if (!entries || !get_pointer_data( id, &data )) return FALSE;
+    if (info && *entries) fill_pointer_info( &data, info );
+    *entries = 1;
+    if (pointers) *pointers = 1;
+    return TRUE;
+}
