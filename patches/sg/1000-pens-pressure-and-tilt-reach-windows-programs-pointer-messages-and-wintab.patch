--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2351,6 +2351,61 @@ static void send_parent_notify( HWND hwnd, WORD event, WORD idChild, POINT pt )
  */
 static BOOL process_pointer_message( MSG *msg, UINT hw_id, const struct hardware_msg_data *msg_data )
 {
+    /* Stained Glass OS: a pen's message carries the pen's state (the
+     * display driver's, see SG_PEN_*): kept for GetPointerInfo,
+     * GetPointerPenInfo and the like, which ask about the pointer message
+     * the thread last retrieved. Before, they knew no pointer at all, and a
+     * drawing program taking the pen through them drew nothing. */
+#ifndef SG_MUTANT_NO_POINTER_INFO
+    UINT32 pen = (UINT32)msg_data->info;
+    if (pen & SG_PEN_MARK)
+    {
+        struct sg_pointer_data *data = &get_user_thread_info()->sg_pointer;
+        UINT32 flags = HIWORD( msg->wParam );
+        INT hittest;
+        HWND child;
+
+        /* where the pen is (the message's own point is the mouse's) */
+        msg->pt.x = (short)LOWORD( msg->lParam );
+        msg->pt.y = (short)HIWORD( msg->lParam );
+        /* to the child window under it, as a click goes, unless a stroke
+         * began elsewhere */
+        if (data->id == LOWORD( msg->wParam ) && (data->flags & POINTER_FLAG_INCONTACT) &&
+            !(data->flags & POINTER_FLAG_UP) && msg->message != WM_POINTERENTER &&
+            is_current_thread_window( UlongToHandle( data->hwnd ) ))
+            msg->hwnd = UlongToHandle( data->hwnd );
+        else if ((child = window_from_point( msg->hwnd, msg->pt, &hittest )) && is_current_thread_window( child ))
+            msg->hwnd = child;
+
+        if (msg->message == WM_POINTERDOWN) flags |= POINTER_FLAG_DOWN;
+        else if (msg->message == WM_POINTERUP) flags |= POINTER_FLAG_UP;
+        else if (msg->message == WM_POINTERUPDATE) flags |= POINTER_FLAG_UPDATE;
+        data->type = PT_PEN;
+        data->id = LOWORD( msg->wParam );
+        data->frame++;
+        data->flags = flags;
+        data->device = SG_PEN_DEVICE_HANDLE( data->id );
+        data->hwnd = HandleToUlong( msg->hwnd );
+        data->x = msg->pt.x;
+        data->y = msg->pt.y;
+        data->time = msg->time;
+        data->button_change = msg->message == WM_POINTERDOWN ? POINTER_CHANGE_FIRSTBUTTON_DOWN :
+                              msg->message == WM_POINTERUP ? POINTER_CHANGE_FIRSTBUTTON_UP : POINTER_CHANGE_NONE;
+        data->pen_flags = 0;
+        if (pen & SG_PEN_BARREL) data->pen_flags |= PEN_FLAG_BARREL;
+        if (pen & SG_PEN_ERASER)
+        {
+            data->pen_flags |= PEN_FLAG_INVERTED;
+            if (flags & POINTER_FLAG_INCONTACT) data->pen_flags |= PEN_FLAG_ERASER;
+        }
+        data->pen_mask = 0;
+        if (pen & SG_PEN_HAS_PRESSURE) data->pen_mask |= PEN_MASK_PRESSURE;
+        if (pen & SG_PEN_HAS_TILT) data->pen_mask |= PEN_MASK_TILT_X | PEN_MASK_TILT_Y;
+        data->pressure = SG_PEN_PRESSURE( pen );
+        data->tilt_x = SG_PEN_TILT_X( pen );
+        data->tilt_y = SG_PEN_TILT_Y( pen );
+    }
+#endif
     msg->pt = point_phys_to_win_dpi( msg->hwnd, msg->pt );
     return TRUE;
 }
