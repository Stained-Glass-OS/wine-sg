+/***********************************************************************
+ *           X11DRV_PenEvent
+ *
+ * A pen's own XI2 event over one of our windows: its pointer message.
+ */
+static BOOL X11DRV_PenEvent( XGenericEventCookie *xev )
+{
+    XIDeviceEvent *event = xev->data;
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    const struct pen_device *pen = find_pen_device( event->deviceid );
+    HWND hwnd;
+
+    if (!pen || event->deviceid != event->sourceid) return FALSE;
+    data->pen_time = event->time;
+#ifdef SG_MUTANT_NO_PEN_POINTER
+    return FALSE;
+#endif
+    if (XFindContext( event->display, event->event, winContext, (char **)&hwnd )) hwnd = 0;
+    /* the buttons held, as the X server has them */
+    if (event->buttons.mask_len)
+    {
+        int i;
+        data->pen_buttons = 0;
+        for (i = 1; i < 32 && i < event->buttons.mask_len * 8; i++)
+            if (XIMaskIsSet( event->buttons.mask, i )) data->pen_buttons |= 1u << i;
+    }
+    send_pen_message( data, pen, hwnd, event->evtype, event->detail, &event->valuators, event->event,
+                      event->event_x, event->event_y, event->root_x, event->root_y );
+    return TRUE;
+}
+
+/* Wintab's X input 1 events (wintab.c): a window with a Wintab context
+ * takes the pen's events that way, and X gives a client an event either
+ * that way or as XI2, never both -- so the window's XI2 selection goes
+ * (x11drv_pen_deselect) and its pointer messages come from these */
+void x11drv_pen_xi1_event( HWND hwnd, int device, int kind, unsigned int button, unsigned int state,
+                           const int *axis_data, int first_axis, int axes_count, Time time, Window window,
+                           int x, int y, int x_root, int y_root )
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    const struct pen_device *pen = find_pen_device( device );
+    unsigned char mask[2] = {0};
+    double values[16];
+    XIValuatorState valuators = {.mask_len = sizeof(mask), .mask = mask, .values = values};
+    int i, n = 0;
+
+    if (!pen || !data) return;
+    data->pen_time = time;
+#ifdef SG_MUTANT_NO_PEN_POINTER
+    return;
+#endif
+    for (i = 0; i < axes_count && first_axis + i < 16; i++)
+    {
+        XISetMask( mask, first_axis + i );
+        values[n++] = axis_data[i];
+    }
+    data->pen_buttons = 0;
+    for (i = 1; i <= 5; i++) if (state & (Button1Mask << (i - 1))) data->pen_buttons |= 1u << i;
+    send_pen_message( data, pen, hwnd, kind, button, &valuators, window, x, y, x_root, y_root );
+}
+
+void x11drv_pen_deselect( Display *display, Window window )
+{
+    XIEventMask pen_masks[SG_MAX_POINTER_DEVICES];
+    unsigned char pen_bits[XIMaskLen(XI_LASTEVENT)];
+    int i;
+
+    if (!xinput2_available || !pen_device_count) return;
+    /* and stays so (x11drv_xinput2_enable comes again with a new style) */
+    if (!pen_wintab_context) pen_wintab_context = XUniqueContext();
+    XSaveContext( display, window, pen_wintab_context, (char *)1 );
+    memset( pen_bits, 0, sizeof(pen_bits) );
+    for (i = 0; i < pen_device_count; i++)
+    {
+        pen_masks[i].deviceid = pen_devices[i].id;
+        pen_masks[i].mask_len = sizeof(pen_bits);
+        pen_masks[i].mask     = pen_bits;
+    }
+    pXISelectEvents( display, window, pen_masks, pen_device_count );
+}
