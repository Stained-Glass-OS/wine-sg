+/* Stained Glass OS (wine-sg 1000): pens -- X's tablet devices ("xwayland-
+ * tablet stylus/eraser", a Wacom's "... Pen stylus") -- as pointer devices.
+ * A pen moves and clicks X's core pointer, which stays Wine's mouse; its own
+ * XI2 events, taken from its X device on every window, carry its pressure
+ * and tilt and become WM_POINTER* messages with POINTER_PEN_INFO (drawing
+ * programs' Windows Ink), and mark the core events of the same time as a
+ * pen's (GetMessageExtraInfo's MI_WP_SIGNATURE), as Windows marks the mouse
+ * messages a pen makes. Before, programs knew no pen: no pressure. */
+struct pen_device
+{
+    int    id;                  /* X input device */
+    BOOL   eraser;
+    int    pressure, tilt_x, tilt_y;     /* valuator numbers, -1: none */
+    double pressure_min, pressure_max;
+    double x_min, x_max, y_min, y_max;   /* valuators 0 and 1: where (raw events) */
+};
+
+static struct pen_device pen_devices[SG_MAX_POINTER_DEVICES];
+static int pen_device_count;
+static XContext pen_wintab_context;   /* windows taking the pens through Wintab */
+
+static const struct pen_device *find_pen_device( int id )
+{
+    int i;
+    for (i = 0; i < pen_device_count; i++) if (pen_devices[i].id == id) return &pen_devices[i];
+    return NULL;
+}
+
+BOOL x11drv_is_pen_device( int id )
+{
+    return find_pen_device( id ) != NULL;
+}
+
+static BOOL name_has( const char *name, const char *word )
+{
+    size_t len = strlen( word );
+    for (; *name; name++) if (!strncasecmp( name, word, len )) return TRUE;
+    return FALSE;
+}
+
+/* the X server's pens, once per process (gdi_display) */
+static void load_pen_devices( Display *display )
+{
+    Atom pressure = XInternAtom( display, "Abs Pressure", False );
+    Atom tilt_x = XInternAtom( display, "Abs Tilt X", False );
+    Atom tilt_y = XInternAtom( display, "Abs Tilt Y", False );
+    struct sg_pointer_device devs[SG_MAX_POINTER_DEVICES];
+    int major = 2, minor = 2, count, i, j;
+    XIDeviceInfo *info;
+
+    if (pXIQueryVersion( display, &major, &minor )) return;
+    if (!(info = pXIQueryDevice( display, XIAllDevices, &count ))) return;
+    for (i = 0; i < count && pen_device_count < SG_MAX_POINTER_DEVICES; i++)
+    {
+        struct pen_device pen = {.id = info[i].deviceid, .pressure = -1, .tilt_x = -1, .tilt_y = -1};
+
+        if (info[i].use != XISlavePointer || !info[i].name) continue;
+        if (!name_has( info[i].name, "stylus" ) && !name_has( info[i].name, "eraser" )) continue;
+        pen.eraser = name_has( info[i].name, "eraser" );
+        for (j = 0; j < info[i].num_classes; j++)
+        {
+            XIValuatorClassInfo *v = (XIValuatorClassInfo *)info[i].classes[j];
+            if (v->type != XIValuatorClass) continue;
+            if (v->number == 0)
+            {
+                pen.x_min = v->min;
+                pen.x_max = v->max;
+            }
+            else if (v->number == 1)
+            {
+                pen.y_min = v->min;
+                pen.y_max = v->max;
+            }
+            if (v->label == pressure)
+            {
+                pen.pressure = v->number;
+                pen.pressure_min = v->min;
+                pen.pressure_max = v->max;
+            }
+            else if (v->label == tilt_x) pen.tilt_x = v->number;
+            else if (v->label == tilt_y) pen.tilt_y = v->number;
+        }
+        TRACE( "pen %d %s: pressure %d (%f..%f) tilt %d,%d\n", pen.id, debugstr_a(info[i].name), pen.pressure,
+               pen.pressure_min, pen.pressure_max, pen.tilt_x, pen.tilt_y );
+        devs[pen_device_count].handle = SG_PEN_DEVICE_HANDLE( SG_PEN_POINTER_ID( pen.id ) );
+        devs[pen_device_count].type = PT_PEN;
+        devs[pen_device_count].eraser = pen.eraser;
+        pen_devices[pen_device_count++] = pen;
+    }
+    pXIFreeDeviceInfo( info );
+    if (pen_device_count) NtUserSgSetPointerDevices( pen_device_count, devs );
+}
