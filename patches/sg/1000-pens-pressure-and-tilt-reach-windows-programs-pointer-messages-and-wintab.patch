+/* Stained Glass OS: the pens (the display driver's: X's) as pointer devices
+ * (wine-sg 1000). Drawing programs (GTK's, Qt's) list the devices first and
+ * take a pointer message only from a device they listed. */
+static UINT get_pen_devices( struct sg_pointer_device *devs )
+{
+    return min( NtUserSgPointerDevices( SG_MAX_POINTER_DEVICES, devs ), SG_MAX_POINTER_DEVICES );
+}
+
+static BOOL find_pen_device( HANDLE device, struct sg_pointer_device *dev )
+{
+    struct sg_pointer_device devs[SG_MAX_POINTER_DEVICES];
+    UINT i, count = get_pen_devices( devs );
+
+    for (i = 0; i < count; i++)
+        if (devs[i].handle == HandleToUlong( device ))
+        {
+            *dev = devs[i];
+            return TRUE;
+        }
+    return FALSE;
+}
+
+static void fill_pointer_device( const struct sg_pointer_device *dev, POINTER_DEVICE_INFO *info )
+{
+    static const POINT origin;
+
+    memset( info, 0, sizeof(*info) );
+    info->displayOrientation = 0;
+    info->device = ULongToHandle( dev->handle );
+    info->pointerDeviceType = POINTER_DEVICE_TYPE_INTEGRATED_PEN;
+    info->monitor = MonitorFromPoint( origin, MONITOR_DEFAULTTOPRIMARY );
+    info->startingCursorId = 0;
+    info->maxActiveContacts = 1;
+    lstrcpynW( info->productString, dev->eraser ? L"Pen eraser" : L"Pen", ARRAY_SIZE(info->productString) );
+}
