From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] slc, sppc: SLGetWindowsInformation, real contexts, SLGetSLIDList

slc: SLGetWindowsInformation returned SL_E_RIGHT_NOT_GRANTED for every name.
It now reads the license value like SLGetWindowsInformationDWORD does
(NtQueryLicenseValue), returns its type and size and a LocalAlloc'ed copy the
caller frees with LocalFree, SL_E_VALUE_NOT_FOUND for a name that is not
there, E_INVALIDARG for missing arguments.

sppc: SLOpen returned the constant 0xdeadbeef and SLClose did nothing. A
context is now an object; SLClose and every function that takes one answer
E_INVALIDARG (the documented error) for a handle that was closed, never
opened or NULL. SLGetSLIDList answers the combinations the documentation
lists that the installed license files can tell: all applications, all
product SKUs, the SKUs of an application, the applications and the license
files of a SKU. The listed combinations the store cannot answer are
SL_E_VALUE_NOT_FOUND as before; a combination outside the list is
SL_E_NOT_SUPPORTED. SLPersistApplicationPolicies logs quietly: there is no
policy cache, and the page says it succeeds regardless of consumption.

Rebased at integration (integ-2026-10) onto 3246 (fast-a): RECONCILE-CLOUD sppc/slc verdict KEEP-7: dlls/sppc/sppc.c is 5518's (a superset: SLGetSLIDList; the handle code is equivalent), replacing fast-a 3246's.
---
diff --git a/dlls/slc/slc.c b/dlls/slc/slc.c
--- a/dlls/slc/slc.c
+++ b/dlls/slc/slc.c
@@ -31,11 +31,45 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(slc);
 
-HRESULT WINAPI SLGetWindowsInformation(LPCWSTR name, SLDATATYPE *type, UINT *val, LPBYTE *size)
+HRESULT WINAPI SLGetWindowsInformation(LPCWSTR name, SLDATATYPE *type, UINT *size, LPBYTE *data)
 {
-    FIXME("(%s %p %p %p) stub\n", debugstr_w(name), type, val, size );
+    UNICODE_STRING nameW;
+    NTSTATUS status;
+    ULONG value_type, len = 0;
+    BYTE *buf;
+
+    TRACE("(%s %p %p %p)\n", debugstr_w(name), type, size, data );
+
+    if (!name || !size || !data)
+        return E_INVALIDARG;
+    if (!name[0])
+        return SL_E_RIGHT_NOT_GRANTED;
+
+    RtlInitUnicodeString( &nameW, name );
+    status = NtQueryLicenseValue( &nameW, &value_type, NULL, 0, &len );
+    if (status == STATUS_OBJECT_NAME_NOT_FOUND)
+        return SL_E_VALUE_NOT_FOUND;
+    if (status && status != STATUS_BUFFER_TOO_SMALL)
+        return E_FAIL;
+
+#ifdef SG_MUTANT_SLWININFO_NOALLOC
+    buf = NULL;
+    return E_FAIL;
+#endif
+    /* the caller frees it with LocalFree, as the documentation says */
+    if (!(buf = LocalAlloc( LMEM_FIXED, max( len, 1 ) )))
+        return E_OUTOFMEMORY;
+    status = NtQueryLicenseValue( &nameW, &value_type, buf, len, &len );
+    if (status)
+    {
+        LocalFree( buf );
+        return E_FAIL;
+    }
 
-    return SL_E_RIGHT_NOT_GRANTED;
+    if (type) *type = value_type;
+    *size = len;
+    *data = buf;
+    return S_OK;
 }
 
 HRESULT WINAPI SLGetWindowsInformationDWORD(LPCWSTR lpszValueName, LPDWORD pdwValue)
diff --git a/dlls/slc/tests/slc.c b/dlls/slc/tests/slc.c
--- a/dlls/slc/tests/slc.c
+++ b/dlls/slc/tests/slc.c
@@ -61,7 +61,61 @@ static void test_SLGetWindowsInformationDWORD(void)
 }
 
 
+static void test_SLGetWindowsInformation(void)
+{
+    SLDATATYPE type;
+    UINT size;
+    BYTE *data;
+    HRESULT res;
+
+    res = SLGetWindowsInformation(NULL, &type, &size, &data);
+    ok(res == E_INVALIDARG, "expected E_INVALIDARG, got %08lx\n", res);
+    res = SLGetWindowsInformation(L"Kernel-MUI-Number-Allowed", &type, NULL, &data);
+    ok(res == E_INVALIDARG, "expected E_INVALIDARG, got %08lx\n", res);
+    res = SLGetWindowsInformation(L"Kernel-MUI-Number-Allowed", &type, &size, NULL);
+    ok(res == E_INVALIDARG, "expected E_INVALIDARG, got %08lx\n", res);
+
+    data = (BYTE *)0xdeadbeef;
+    res = SLGetWindowsInformation(L"Nonexistent-License-Value", &type, &size, &data);
+    ok(res == SL_E_VALUE_NOT_FOUND, "expected SL_E_VALUE_NOT_FOUND, got %08lx\n", res);
+    ok(data == (BYTE *)0xdeadbeef, "data modified\n");
+
+    res = SLGetWindowsInformation(L"", &type, &size, &data);
+    ok(res == SL_E_RIGHT_NOT_GRANTED || broken(res == 0xd000000d) /* Win 8 */,
+       "expected SL_E_RIGHT_NOT_GRANTED, got %08lx\n", res);
+
+    type = SL_DATA_NONE; size = 0; data = NULL;
+    res = SLGetWindowsInformation(L"Kernel-MUI-Number-Allowed", &type, &size, &data);
+    ok(res == S_OK, "expected S_OK, got %08lx\n", res);
+    if (res == S_OK)
+    {
+        ok(type == SL_DATA_DWORD, "got type %d\n", type);
+        ok(size == sizeof(DWORD), "got size %u\n", size);
+        ok(data != NULL, "no data\n");
+        if (data) ok(*(DWORD *)data != 0xdeadbeef, "unexpected value\n");
+        LocalFree(data);
+    }
+
+    type = SL_DATA_NONE; size = 0; data = NULL;
+    res = SLGetWindowsInformation(L"Kernel-MUI-Language-Allowed", &type, &size, &data);
+    ok(res == S_OK, "expected S_OK, got %08lx\n", res);
+    if (res == S_OK)
+    {
+        ok(type == SL_DATA_SZ, "got type %d\n", type);
+        ok(size >= sizeof(WCHAR) && data && size == (lstrlenW((WCHAR *)data) + 1) * sizeof(WCHAR),
+           "got size %u\n", size);
+        LocalFree(data);
+    }
+
+    /* the type is optional */
+    data = NULL;
+    res = SLGetWindowsInformation(L"Kernel-MUI-Number-Allowed", NULL, &size, &data);
+    ok(res == S_OK, "expected S_OK, got %08lx\n", res);
+    if (res == S_OK) LocalFree(data);
+}
+
 START_TEST(slc)
 {
+    test_SLGetWindowsInformation();
     test_SLGetWindowsInformationDWORD();
 }
