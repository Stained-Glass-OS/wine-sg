+/* "{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}", exactly */
+static BOOL parse_guid_string(const char *value, GUID *guid)
+{
+    unsigned int d[11];
+    int i;
+
+    if (strlen(value) != 38) return FALSE;
+    if (sscanf(value, "{%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x}", &d[0], &d[1], &d[2], &d[3], &d[4],
+               &d[5], &d[6], &d[7], &d[8], &d[9], &d[10]) != 11)
+        return FALSE;
+    guid->Data1 = d[0];
+    guid->Data2 = d[1];
+    guid->Data3 = d[2];
+    for (i = 0; i < 8; i++) guid->Data4[i] = d[3 + i];
+    return TRUE;
+}
