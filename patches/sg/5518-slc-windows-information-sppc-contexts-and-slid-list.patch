+/* the installed license files, as SLGetSLIDList reads them: the file's own
+ * identifier (its name in the store), and the application and product SKU its
+ * text names */
+struct slid_set
+{
+    SLID *ids;
+    UINT count, max;
+};
+
+static BOOL slid_add(struct slid_set *set, const SLID *id)
+{
+    UINT i;
+    SLID *grown;
+
+    for (i = 0; i < set->count; i++) if (IsEqualGUID(&set->ids[i], id)) return TRUE;
+    if (set->count == set->max)
+    {
+        UINT max = set->max ? 2 * set->max : 8;
+        if (!(grown = realloc( set->ids, max * sizeof(*grown) ))) return FALSE;
+        set->ids = grown;
+        set->max = max;
+    }
+    set->ids[set->count++] = *id;
+    return TRUE;
+}
+
+static BOOL parse_item_name(const WCHAR *name, GUID *guid)
+{
+    char narrow[64];
+    int i;
+
+    for (i = 0; name[i] && i < 40; i++) narrow[i] = name[i] < 128 ? name[i] : '?';
+    narrow[i] = 0;
+    return !name[i] && parse_guid_string( narrow, guid );
+}
+
 HRESULT WINAPI SLGetSLIDList(HSLC handle, SLIDTYPE query_type, const SLID *query, SLIDTYPE return_type,
                              UINT *count, SLID **ids)
 {
-    FIXME("(%p %u %s %u %p %p) semi-stub\n", handle, query_type, debugstr_guid(query), return_type, count, ids);
-    if (!valid_slc(handle) || !count || !ids) return E_INVALIDARG;
-    /* the store does not read what the licenses grant: nothing is found */
+    /* the combinations the documentation lists that the store can answer from
+     * the license files; the other listed ones read what is not kept here
+     * (product keys are not tied to a product, licenses within a file are
+     * not told apart) */
+    BOOL all_app = query_type == SL_ID_APPLICATION && return_type == SL_ID_APPLICATION;
+    BOOL all_sku = query_type == SL_ID_PRODUCT_SKU && return_type == SL_ID_PRODUCT_SKU;
+    BOOL app_sku = query_type == SL_ID_APPLICATION && return_type == SL_ID_PRODUCT_SKU;
+    BOOL sku_app = query_type == SL_ID_PRODUCT_SKU && return_type == SL_ID_APPLICATION;
+    BOOL sku_file = query_type == SL_ID_PRODUCT_SKU && return_type == SL_ID_LICENSE_FILE;
+    BOOL listed = (query_type == SL_ID_PRODUCT_SKU && return_type == SL_ID_PKEY) ||
+                  (query_type == SL_ID_LICENSE_FILE && return_type == SL_ID_LICENSE) ||
+                  (query_type == SL_ID_LICENSE && (return_type == SL_ID_LICENSE_FILE ||
+                   return_type == SL_ID_APPLICATION || return_type == SL_ID_PRODUCT_SKU));
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH], path[MAX_PATH];
+    struct slid_set set = {0};
+    WIN32_FIND_DATAW fd;
+    HANDLE find, file;
+
+    TRACE("(%p %u %s %u %p %p)\n", handle, query_type, debugstr_guid(query), return_type, count, ids);
+    if (!sl_valid_handle(handle) || !count || !ids) return E_INVALIDARG;
     *count = 0;
     *ids = NULL;
-    return SL_E_VALUE_NOT_FOUND;
+    if (!all_app && !all_sku && !app_sku && !sku_app && !sku_file)
+        return listed ? SL_E_VALUE_NOT_FOUND : SL_E_NOT_SUPPORTED_SG;
+    /* SLID_ALL is NULL; the others name the item they start from */
+    if ((all_app || all_sku) ? FALSE : !query) return E_INVALIDARG;
+    if ((all_app || all_sku) && query) return E_INVALIDARG;
+
+    if (store_dir(L"licenses", dir))
+    {
+        swprintf(pattern, MAX_PATH, L"%s\\*", dir);
+        if ((find = FindFirstFileW(pattern, &fd)) != INVALID_HANDLE_VALUE)
+        {
+            do
+            {
+                GUID lic_app, sku, fileid;
+                DWORD size, got;
+                char *text;
+
+                if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+                swprintf(path, MAX_PATH, L"%s\\%s", dir, fd.cFileName);
+                file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+                if (file == INVALID_HANDLE_VALUE) continue;
+                size = GetFileSize(file, NULL);
+                if (size == INVALID_FILE_SIZE || size > 16 * 1024 * 1024 || !(text = malloc(size + 1)))
+                {
+                    CloseHandle(file);
+                    continue;
+                }
+                if (!ReadFile(file, text, size, &got, NULL)) got = 0;
+                CloseHandle(file);
+                text[got] = 0;
+                if (license_guid(text, "productSkuId", &sku))
+                {
+                    BOOL have_app = license_guid(text, "applicationId", &lic_app);
+
+                    if (all_app) { if (have_app) slid_add( &set, &lic_app ); }
+                    else if (all_sku) slid_add( &set, &sku );
+                    else if (app_sku) { if (have_app && IsEqualGUID(&lic_app, query)) slid_add( &set, &sku ); }
+                    else if (sku_app)
+                    {
+#ifdef SG_MUTANT_SLID_SKUAPP
+                        if (have_app && IsEqualGUID(&sku, query)) slid_add( &set, &sku );
+#else
+                        if (have_app && IsEqualGUID(&sku, query)) slid_add( &set, &lic_app );
+#endif
+                    }
+                    else if (sku_file && IsEqualGUID(&sku, query) && parse_item_name( fd.cFileName, &fileid ))
+                        slid_add( &set, &fileid );
+                }
+                free(text);
+            } while (FindNextFileW(find, &fd));
+            FindClose(find);
+        }
+    }
+
+    if (!set.count)
+    {
+        free(set.ids);
+        return SL_E_VALUE_NOT_FOUND;
+    }
+    /* the caller frees the list with LocalFree */
+    if (!(*ids = LocalAlloc( LMEM_FIXED, set.count * sizeof(**ids) )))
+    {
+        free(set.ids);
+        return E_OUTOFMEMORY;
+    }
+    memcpy( *ids, set.ids, set.count * sizeof(**ids) );
+    *count = set.count;
+    free(set.ids);
+    return S_OK;
 }
 
