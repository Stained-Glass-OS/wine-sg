From: Stained Glass OS <dev@stained-glass.example>
Subject: kernelbase: the package identity of the current process

GetCurrentPackageFullName, GetCurrentPackageFamilyName, GetCurrentPackageId
and GetCurrentPackagePath always answered APPMODEL_ERROR_NO_PACKAGE, so a
packaged application never knew it was one. A process now has a deployed
package's identity when its executable is inside that package's install
location (appxdeploymentclient's registration, patch 0060) -- however it was
started: its app list entry, a Start menu shortcut, from a command line.
GetPackagePathByFullName and GetPackagesByPackageFamily answer from the
same registrations. GetCurrentPackageInfo is still a stub.

--- a/dlls/kernelbase/version.c
+++ b/dlls/kernelbase/version.c
@@ -37,6 +37,7 @@
 #include "winnls.h"
 #include "winternl.h"
 #include "winerror.h"
+#include "winreg.h"
 #include "appmodel.h"
 #include "bcrypt.h"
 
@@ -1544,13 +1545,82 @@
 }
 
 
+/* Deployed packages (appxdeploymentclient): one key per full name, with the
+ * InstallLocation the package's files are in. A process has a package's
+ * identity when its executable is in that package's location -- however it
+ * was started (its app list entry, a Start menu shortcut, an alias). */
+static const WCHAR deployed_packagesW[] = L"Software\\Wine\\AppModel\\Packages";
+
+static BOOL package_location( const WCHAR *full_name, WCHAR *path, DWORD size )
+{
+    WCHAR key[MAX_PATH];
+    DWORD bytes = size * sizeof(WCHAR);
+
+    if (!full_name || wcslen( full_name ) + ARRAY_SIZE(deployed_packagesW) + 1 >= ARRAY_SIZE(key)) return FALSE;
+    swprintf( key, ARRAY_SIZE(key), L"%s\\%s", deployed_packagesW, full_name );
+    return !RegGetValueW( HKEY_CURRENT_USER, key, L"InstallLocation", RRF_RT_REG_SZ, NULL, path, &bytes );
+}
+
+static WCHAR current_package_name[256], current_package_path[MAX_PATH];
+
+static BOOL CALLBACK init_current_package( INIT_ONCE *once, void *param, void **context )
+{
+    const UNICODE_STRING *image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    WCHAR name[256], path[MAX_PATH];
+    DWORD len, index = 0, plen;
+    HKEY key;
+
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, deployed_packagesW, 0, KEY_READ, &key )) return TRUE;
+    while (len = ARRAY_SIZE(name), !RegEnumKeyExW( key, index++, name, &len, NULL, NULL, NULL, NULL ))
+    {
+        if (!package_location( name, path, ARRAY_SIZE(path) )) continue;
+        plen = wcslen( path );
+        if (plen && image->Length / sizeof(WCHAR) > plen && !wcsnicmp( image->Buffer, path, plen ) &&
+            image->Buffer[plen] == '\\')
+        {
+            wcscpy( current_package_name, name );
+            wcscpy( current_package_path, path );
+            break;
+        }
+    }
+    RegCloseKey( key );
+    TRACE( "%s: package %s\n", debugstr_wn( image->Buffer, image->Length / sizeof(WCHAR) ), debugstr_w( current_package_name ) );
+    return TRUE;
+}
+
+static const WCHAR *current_package(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_current_package, NULL, NULL );
+    return current_package_name[0] ? current_package_name : NULL;
+}
+
+static LONG copy_package_string( const WCHAR *str, UINT32 *length, WCHAR *buffer )
+{
+    UINT32 len = wcslen( str ) + 1;
+
+    if (!length) return ERROR_INVALID_PARAMETER;
+    if (*length < len || !buffer)
+    {
+        *length = len;
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    memcpy( buffer, str, len * sizeof(WCHAR) );
+    *length = len;
+    return ERROR_SUCCESS;
+}
+
+
