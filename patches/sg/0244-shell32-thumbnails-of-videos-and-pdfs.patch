+/* ------------------------------------------------------------------------ */
+/* video: a frame a tenth of the way in, through Media Foundation           */
+
+/* the average brightness of opaque BGRX pixels, 0-255 */
+static UINT brightness(const DWORD *px, UINT w, UINT h)
+{
+    ULONGLONG sum = 0;
+    UINT x, y, n = 0;
+    for (y = 0; y < h; y += max(1, h / 32))
+        for (x = 0; x < w; x += max(1, w / 32), n++)
+        {
+            DWORD p = px[(SIZE_T)y * w + x];
+            sum += ((p >> 16) & 0xff) * 3 + ((p >> 8) & 0xff) * 6 + (p & 0xff);
+        }
+    return n ? (UINT)(sum / n / 10) : 0;
+}
+
+/* one RGB32 frame at pos (100 ns), top-down BGRX, into *pixels */
+static HRESULT read_frame(IMFSourceReader *reader, LONGLONG pos, UINT w, UINT h, LONG stride, DWORD **pixels)
+{
+    IMFSample *sample = NULL;
+    IMFMediaBuffer *buffer;
+    PROPVARIANT where;
+    DWORD index, flags, len;
+    LONGLONG ts;
+    BYTE *data;
+    HRESULT hr;
+    int tries;
+
+    *pixels = NULL;
+    where.vt = VT_I8;
+    where.hVal.QuadPart = pos;
+    if (pos) IMFSourceReader_SetCurrentPosition(reader, &GUID_NULL, &where);
+    for (tries = 0; tries < 30 && !sample; tries++)
+    {
+        hr = IMFSourceReader_ReadSample(reader, MF_SOURCE_READER_FIRST_VIDEO_STREAM, 0, &index, &flags, &ts, &sample);
+        if (FAILED(hr)) return hr;
+        if (flags & (MF_SOURCE_READERF_ENDOFSTREAM | MF_SOURCE_READERF_ERROR)) break;
+    }
+    if (!sample) return E_FAIL;
+    hr = IMFSample_ConvertToContiguousBuffer(sample, &buffer);
+    IMFSample_Release(sample);
+    if (FAILED(hr)) return hr;
+    if (SUCCEEDED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &len)))
+    {
+        LONG pitch = stride ? stride : (LONG)w * 4;
+        UINT y;
+        if ((SIZE_T)labs(pitch) * h > len || labs(pitch) < (LONG)w * 4) hr = E_FAIL;
+        else if (!(*pixels = malloc((SIZE_T)w * h * 4))) hr = E_OUTOFMEMORY;
+        else
+            for (y = 0; y < h; y++)
+            {
+                const BYTE *row = pitch > 0 ? data + (SIZE_T)y * pitch : data + (SIZE_T)(h - 1 - y) * -pitch;
+                DWORD *out = *pixels + (SIZE_T)y * w;
+                UINT x;
+                memcpy(out, row, (SIZE_T)w * 4);
+                for (x = 0; x < w; x++) out[x] |= 0xff000000;
+            }
+        IMFMediaBuffer_Unlock(buffer);
+    }
+    IMFMediaBuffer_Release(buffer);
+    return hr;
+}
+
+static HRESULT video_thumbnail(const WCHAR *path, UINT size, HBITMAP *out)
+{
+    IMFAttributes *attributes = NULL;
+    IMFSourceReader *reader = NULL;
+    IMFMediaType *type = NULL, *current = NULL;
+    PROPVARIANT duration;
+    UINT64 frame_size = 0;
+    UINT32 stride = 0;
+    UINT w, h, tw, th;
+    DWORD *pixels = NULL;
+    BYTE *scaled = NULL;
+    void *bits;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = MFStartup(MF_VERSION, MFSTARTUP_LITE))) return hr;
+    PropVariantInit(&duration);
+    if (SUCCEEDED(hr = MFCreateAttributes(&attributes, 1)))
+        hr = IMFAttributes_SetUINT32(attributes, &MF_SOURCE_READER_ENABLE_VIDEO_PROCESSING, TRUE);
+    if (SUCCEEDED(hr)) hr = MFCreateSourceReaderFromURL(path, attributes, &reader);
+    if (SUCCEEDED(hr))
+    {
+        IMFSourceReader_SetStreamSelection(reader, MF_SOURCE_READER_ALL_STREAMS, FALSE);
+        hr = IMFSourceReader_SetStreamSelection(reader, MF_SOURCE_READER_FIRST_VIDEO_STREAM, TRUE);
+    }
+    if (SUCCEEDED(hr)) hr = MFCreateMediaType(&type);
+    if (SUCCEEDED(hr)) hr = IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Video);
+    if (SUCCEEDED(hr)) hr = IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, &MFVideoFormat_RGB32);
+    if (SUCCEEDED(hr)) hr = IMFSourceReader_SetCurrentMediaType(reader, MF_SOURCE_READER_FIRST_VIDEO_STREAM, NULL, type);
+    if (SUCCEEDED(hr)) hr = IMFSourceReader_GetCurrentMediaType(reader, MF_SOURCE_READER_FIRST_VIDEO_STREAM, &current);
+    if (SUCCEEDED(hr)) hr = IMFMediaType_GetUINT64(current, &MF_MT_FRAME_SIZE, &frame_size);
+    if (FAILED(hr)) goto done;
+    if (FAILED(IMFMediaType_GetUINT32(current, &MF_MT_DEFAULT_STRIDE, &stride))) stride = 0;
+    w = frame_size >> 32;
+    h = (UINT32)frame_size;
+    if (!w || !h || w > 16384 || h > 16384) { hr = E_FAIL; goto done; }
+
+    /* a tenth of the way in, as Explorer does; a dark frame there (a fade
+     * from black) is passed over for one further on */
+    IMFSourceReader_GetPresentationAttribute(reader, MF_SOURCE_READER_MEDIASOURCE, &MF_PD_DURATION, &duration);
+    if (FAILED(hr = read_frame(reader, duration.vt == VT_UI8 ? duration.uhVal.QuadPart / 10 : 0, w, h, (INT32)stride, &pixels)))
+        goto done;
+    if (duration.vt == VT_UI8 && brightness(pixels, w, h) < 12)
+    {
+        DWORD *later;
+        if (SUCCEEDED(read_frame(reader, duration.uhVal.QuadPart * 3 / 10, w, h, (INT32)stride, &later)))
+        {
+            if (brightness(later, w, h) > brightness(pixels, w, h)) { free(pixels); pixels = later; }
+            else free(later);
+        }
+    }
+
+    if (w >= h) { tw = min(w, size); th = max(1, (UINT)((ULONGLONG)h * tw / w)); }
+    else { th = min(h, size); tw = max(1, (UINT)((ULONGLONG)w * th / h)); }
+    if (!(scaled = malloc((SIZE_T)tw * th * 4))) { hr = E_OUTOFMEMORY; goto done; }
+    box_scale((BYTE *)pixels, w, h, scaled, tw, th);
+    if (!(*out = create_dib(tw, th, &bits))) { hr = E_OUTOFMEMORY; goto done; }
+    memcpy(bits, scaled, (SIZE_T)tw * th * 4);
+    hr = S_OK;
+
+done:
+    TRACE("video %s: %#lx\n", debugstr_w(path), hr);
+    free(pixels);
+    free(scaled);
+    PropVariantClear(&duration);
+    if (current) IMFMediaType_Release(current);
+    if (type) IMFMediaType_Release(type);
+    if (reader) IMFSourceReader_Release(reader);
+    if (attributes) IMFAttributes_Release(attributes);
+    MFShutdown();
+    return hr;
+}
+
+/* ------------------------------------------------------------------------ */
+/* PDF: the first page, from sg-session's sg-pdf (poppler)                  */
+
+/* A native helper: Wine gives a Windows program no pipe to one, so it writes
+ * the page as a PNG (renamed into place whole, or OUT.err) and we wait for
+ * the file. SG_PDF names another sg-pdf, as for the PDF Viewer. */
+static HRESULT pdf_thumbnail(const WCHAR *path, UINT size, HBITMAP *out)
+{
+    char *(WINAPI *unix_name)(const WCHAR *) =
+        (void *)GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "wine_get_unix_file_name");
+    WCHAR helper[MAX_PATH] = L"/usr/bin/sg-pdf", dir[MAX_PATH], png[MAX_PATH], err[MAX_PATH + 8], unix_helper[MAX_PATH + 16];
+    WCHAR *cmd = NULL, *wpdf = NULL, *wpng = NULL;
+    char *upng = NULL, *updf = NULL;
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    HRESULT hr = E_FAIL;
+    DWORD i, len;
+
+    *out = NULL;
+    if (!unix_name) return E_FAIL;
+    GetEnvironmentVariableW(L"SG_PDF", helper, MAX_PATH);
+    swprintf(unix_helper, ARRAY_SIZE(unix_helper), L"\\\\?\\unix%s", helper);
+    if (GetFileAttributesW(unix_helper) == INVALID_FILE_ATTRIBUTES) return E_FAIL;
+    if (!GetTempPathW(MAX_PATH, dir) || !GetTempFileNameW(dir, L"sgp", 0, png)) return E_FAIL;
+    DeleteFileW(png);
+    lstrcatW(png, L".png");
+    swprintf(err, ARRAY_SIZE(err), L"%s.err", png);
+    if (!(updf = unix_name(path)) || !(upng = unix_name(png))) goto done;
+    len = MultiByteToWideChar(CP_UNIXCP, 0, updf, -1, NULL, 0);
+    if (!(wpdf = malloc(len * sizeof(WCHAR)))) goto done;
+    MultiByteToWideChar(CP_UNIXCP, 0, updf, -1, wpdf, len);
+    len = MultiByteToWideChar(CP_UNIXCP, 0, upng, -1, NULL, 0);
+    if (!(wpng = malloc(len * sizeof(WCHAR)))) goto done;
+    MultiByteToWideChar(CP_UNIXCP, 0, upng, -1, wpng, len);
+    len = lstrlenW(unix_helper) + lstrlenW(wpdf) + lstrlenW(wpng) + 64;
+    if (!(cmd = malloc(len * sizeof(WCHAR)))) goto done;
+    swprintf(cmd, len, L"\"%s\" --thumbnail \"%s\" %u \"%s\"", unix_helper, wpdf, min(max(size, 16), 1024), wpng);
+    si.dwFlags = STARTF_USESHOWWINDOW;
+    si.wShowWindow = SW_HIDE;
+    if (!CreateProcessW(NULL, cmd, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi)) goto done;
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    /* a native child's handle cannot be waited on: wait for its answer */
+    for (i = 0; i < 400; i++)
+    {
+        if (GetFileAttributesW(png) != INVALID_FILE_ATTRIBUTES)
+        {
+            hr = decode_thumbnail(NULL, png, size, out);
+            break;
+        }
+        if (GetFileAttributesW(err) != INVALID_FILE_ATTRIBUTES) break;
+        Sleep(50);
+    }
+    DeleteFileW(png);
+    DeleteFileW(err);
+done:
+    TRACE("pdf %s: %#lx\n", debugstr_w(path), hr);
+    HeapFree(GetProcessHeap(), 0, updf);
+    HeapFree(GetProcessHeap(), 0, upng);
+    free(wpdf);
+    free(wpng);
+    free(cmd);
+    return hr;
+}
