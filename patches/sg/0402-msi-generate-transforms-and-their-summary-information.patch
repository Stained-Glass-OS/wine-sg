+
+/*
+ * Generating a transform (MsiDatabaseGenerateTransform)
+ *
+ * The transform holds what turns the reference database into this one, in
+ * the format msi_table_apply_transform reads: its own string pool, and per
+ * table a stream of row records -- a 16-bit mask, then the present columns
+ * (string references into the transform's pool, integers biased as tables
+ * store them). A mask with its low bit set is a whole row (column count in the
+ * high byte: an insert, or a row that is replaced); otherwise a bit per
+ * changed column, keys always present; 0 deletes the row. New tables come as
+ * _Tables and _Columns rows first; binary fields as streams named after the
+ * row's keys.
+ */
+
+struct gen_column
+{
+    WCHAR *name;
+    UINT   type;
+};
+
+struct gen_table
+{
+    WCHAR *name;
+    UINT   count;
+    struct gen_column cols[32];
+};
+
+struct gen_row
+{
+    USHORT mask;
+    UINT   vals[32];   /* string ids in the transform's pool, or stored integers */
+};
+
+struct gen_stream
+{
+    UINT  count, size;
+    struct gen_row *rows;
+};
+
+static UINT gen_table_columns( MSIDATABASE *db, const WCHAR *table, struct gen_table *t )
+{
+    MSIQUERY *q;
+    MSIRECORD *rec;
+    UINT r;
+
+    t->count = 0;
+    r = MSI_OpenQuery( db, &q, L"SELECT `Number`, `Name`, `Type` FROM `_Columns` WHERE `Table` = '%s'", table );
+    if (r) return r;
+    if ((r = MSI_ViewExecute( q, NULL ))) goto done;
+    while (!MSI_ViewFetch( q, &rec ))
+    {
+        UINT n = MSI_RecordGetInteger( rec, 1 );
+        if (n >= 1 && n <= 32)
+        {
+            t->cols[n - 1].name = msi_dup_record_field( rec, 2 );
+            t->cols[n - 1].type = MSI_RecordGetInteger( rec, 3 );
+            if (n > t->count) t->count = n;
+        }
+        msiobj_release( &rec->hdr );
+    }
+    MSI_ViewClose( q );
+done:
+    msiobj_release( &q->hdr );
+    return r;
+}
+
+static void gen_free_columns( struct gen_table *t )
+{
+    UINT i;
+    for (i = 0; i < t->count; i++) free( t->cols[i].name );
+    t->count = 0;
+}
+
+static BOOL gen_table_exists( MSIDATABASE *db, const WCHAR *table )
+{
+    MSIRECORD *rec = MSI_QueryGetRecord( db, L"SELECT `Name` FROM `_Tables` WHERE `Name` = '%s'", table );
+    if (!rec) return FALSE;
+    msiobj_release( &rec->hdr );
+    return TRUE;
+}
+
+/* the row's keys as one string: how rows of the two databases are matched */
+static WCHAR *gen_row_key( const struct gen_table *t, MSIRECORD *rec )
+{
+    WCHAR *key = NULL, buf[16];
+    size_t len = 0, l;
+    const WCHAR *s;
+    UINT i;
+    int sl;
+
+    for (i = 0; i < t->count; i++)
+    {
+        if (!(t->cols[i].type & MSITYPE_KEY)) continue;
+        if (MSI_RecordIsNull( rec, i + 1 )) { s = L""; sl = 0; }
+        else if (t->cols[i].type & MSITYPE_STRING) s = msi_record_get_string( rec, i + 1, &sl );
+        else { swprintf( buf, ARRAY_SIZE(buf), L"%d", MSI_RecordGetInteger( rec, i + 1 ) ); s = buf; sl = wcslen( buf ); }
+        l = sl;
+        key = realloc( key, (len + l + 2) * sizeof(WCHAR) );
+        memcpy( key + len, s, l * sizeof(WCHAR) );
+        len += l;
+        key[len++] = 1;
+        key[len] = 0;
+    }
+    return key;
+}
+
+static BOOL gen_streams_equal( MSIRECORD *a, MSIRECORD *b, UINT field )
+{
+    IStream *sa = NULL, *sb = NULL;
+    BYTE ba[4096], bb[4096];
+    ULONG na, nb;
+    BOOL same = TRUE;
+
+    if (MSI_RecordIsNull( a, field ) || MSI_RecordIsNull( b, field ))
+        return MSI_RecordIsNull( a, field ) == MSI_RecordIsNull( b, field );
+    if (MSI_RecordGetIStream( a, field, &sa ) || MSI_RecordGetIStream( b, field, &sb ))
+    {
+        same = FALSE;
+        goto done;
+    }
+    for (;;)
+    {
+        if (FAILED( IStream_Read( sa, ba, sizeof(ba), &na ) ) || FAILED( IStream_Read( sb, bb, sizeof(bb), &nb ) ) ||
+            na != nb || memcmp( ba, bb, na ))
+        {
+            same = FALSE;
+            break;
+        }
+        if (!na) break;
+    }
+done:
+    if (sa) IStream_Release( sa );
+    if (sb) IStream_Release( sb );
+    return same;
+}
+
+static BOOL gen_fields_equal( const struct gen_table *t, UINT i, MSIRECORD *a, MSIRECORD *b )
+{
+    int la, lb;
+    const WCHAR *sa, *sb;
+
+    if (MSITYPE_IS_BINARY( t->cols[i].type )) return gen_streams_equal( a, b, i + 1 );
+    if (MSI_RecordIsNull( a, i + 1 ) != MSI_RecordIsNull( b, i + 1 )) return FALSE;
+    if (MSI_RecordIsNull( a, i + 1 )) return TRUE;
+    if (t->cols[i].type & MSITYPE_STRING)
+    {
+        sa = msi_record_get_string( a, i + 1, &la );
+        sb = msi_record_get_string( b, i + 1, &lb );
+        return la == lb && !memcmp( sa, sb, la * sizeof(WCHAR) );
+    }
+    return MSI_RecordGetInteger( a, i + 1 ) == MSI_RecordGetInteger( b, i + 1 );
+}
+
+static UINT gen_store_int( UINT type, MSIRECORD *rec, UINT field )
+{
+    int v;
+    if (MSI_RecordIsNull( rec, field )) return 0;
+    v = MSI_RecordGetInteger( rec, field );
+    if ((type & 0xff) <= 2) return (v + 0x8000) & 0xffff;
+    return v ^ 0x80000000;
+}
+
+static struct gen_row *gen_add_row( struct gen_stream *s, USHORT mask )
+{
+    struct gen_row *row;
+    if (s->count == s->size)
+    {
+        UINT size = s->size ? s->size * 2 : 16;
+        struct gen_row *rows = realloc( s->rows, size * sizeof(*rows) );
+        if (!rows) return NULL;
+        s->rows = rows;
+        s->size = size;
+    }
+    row = &s->rows[s->count++];
+    memset( row, 0, sizeof(*row) );
+    row->mask = mask;
+    return row;
+}
+
+/* a binary field of a row: its stream, named after the row's keys */
+static UINT gen_copy_stream( IStorage *stg, const WCHAR *table, const struct gen_table *t, MSIRECORD *rec, UINT field )
+{
+    WCHAR name[1024], *encname;
+    IStream *src = NULL, *dst = NULL;
+    ULARGE_INTEGER big;
+    DWORD len;
+    UINT i, p, r = ERROR_FUNCTION_FAILED;
+
+    if (MSI_RecordIsNull( rec, field )) return ERROR_SUCCESS;
+    p = wcslen( table );
+    if (p >= ARRAY_SIZE(name) - 1) return r;
+    wcscpy( name, table );
+    for (i = 0; i < t->count; i++)
+    {
+        if (!(t->cols[i].type & MSITYPE_KEY)) continue;
+        if (p + 2 >= ARRAY_SIZE(name)) return r;
+        name[p++] = '.';
+        len = ARRAY_SIZE(name) - p;
+        if (MSI_RecordGetStringW( rec, i + 1, name + p, &len )) return r;
+        p += len;
+    }
+    name[p] = 0;
+    if (MSI_RecordGetIStream( rec, field, &src )) return r;
+    encname = encode_streamname( FALSE, name );
+    if (SUCCEEDED( IStorage_CreateStream( stg, encname, STGM_CREATE | STGM_WRITE | STGM_SHARE_EXCLUSIVE, 0, 0, &dst ) ))
+    {
+        big.QuadPart = ~0ull;
+        if (SUCCEEDED( IStream_CopyTo( src, dst, big, NULL, NULL ) )) r = ERROR_SUCCESS;
+        IStream_Release( dst );
+    }
+    free( encname );
+    IStream_Release( src );
+    return r;
+}
+
+/* fill a row's fields from rec: the columns in `present` (bit i: column i) */
+static void gen_fill_row( struct gen_row *row, const struct gen_table *t, string_table *st, MSIRECORD *rec, UINT present )
+{
+    UINT i;
+    int len;
+    const WCHAR *s;
+
+    for (i = 0; i < t->count; i++)
+    {
+        if (!(present & (1u << i))) continue;
+        if (MSITYPE_IS_BINARY( t->cols[i].type )) row->vals[i] = 0;
+        else if (t->cols[i].type & MSITYPE_STRING)
+        {
+            s = msi_record_get_string( rec, i + 1, &len );
+            row->vals[i] = (s && !MSI_RecordIsNull( rec, i + 1 )) ? msi_add_string( st, s, len, TRUE ) : 0;
+        }
+        else row->vals[i] = gen_store_int( t->cols[i].type, rec, i + 1 );
+    }
+}
+
+static UINT gen_all_rows( MSIDATABASE *db, const WCHAR *table, MSIRECORD ***recs, UINT *count )
+{
+    MSIQUERY *q;
+    MSIRECORD *rec;
+    UINT r, size = 0;
+
+    *recs = NULL;
+    *count = 0;
+    if ((r = MSI_OpenQuery( db, &q, L"SELECT * FROM `%s`", table ))) return r;
+    if (!(r = MSI_ViewExecute( q, NULL )))
+    {
+        while (!MSI_ViewFetch( q, &rec ))
+        {
+            if (*count == size)
+            {
+                size = size ? size * 2 : 64;
+                *recs = realloc( *recs, size * sizeof(**recs) );
+            }
+            (*recs)[(*count)++] = rec;
+        }
+        MSI_ViewClose( q );
+    }
+    msiobj_release( &q->hdr );
+    return r;
+}
+
+static void gen_free_rows( MSIRECORD **recs, UINT count )
+{
+    UINT i;
+    for (i = 0; i < count; i++) msiobj_release( &recs[i]->hdr );
+    free( recs );
+}
+
+static UINT gen_key_mask( const struct gen_table *t )
+{
+    UINT i, m = 0;
+    for (i = 0; i < t->count; i++) if (t->cols[i].type & MSITYPE_KEY) m |= 1u << i;
+    return m;
+}
+
+static UINT gen_write_table( IStorage *stg, const WCHAR *name, const struct gen_table *t,
+                             const struct gen_stream *s, UINT bytes_per_strref )
+{
+    BYTE *data, *p;
+    UINT i, j, size = 0, r;
+
+    if (!s->count) return ERROR_SUCCESS;
+    for (i = 0; i < s->count; i++)
+    {
+        size += 2;
+        for (j = 0; j < t->count; j++)
+        {
+            USHORT m = s->rows[i].mask;
+            BOOL present = (m & 1) ? j < (UINT)(m >> 8) : ((t->cols[j].type & MSITYPE_KEY) || (m & (1u << j)));
+            if (!present) continue;
+            if (MSITYPE_IS_BINARY( t->cols[j].type )) size += 2;
+            else if (t->cols[j].type & MSITYPE_STRING) size += bytes_per_strref;
+            else size += (t->cols[j].type & 0xff) <= 2 ? 2 : 4;
+        }
+    }
+    if (!(p = data = malloc( size ))) return ERROR_OUTOFMEMORY;
+    for (i = 0; i < s->count; i++)
+    {
+        USHORT m = s->rows[i].mask;
+        *p++ = m & 0xff;
+        *p++ = m >> 8;
+        for (j = 0; j < t->count; j++)
+        {
+            UINT v = s->rows[i].vals[j], n;
+            BOOL present = (m & 1) ? j < (UINT)(m >> 8) : ((t->cols[j].type & MSITYPE_KEY) || (m & (1u << j)));
+            if (!present) continue;
+            if (MSITYPE_IS_BINARY( t->cols[j].type )) n = 2;
+            else if (t->cols[j].type & MSITYPE_STRING) n = bytes_per_strref;
+            else n = (t->cols[j].type & 0xff) <= 2 ? 2 : 4;
+            while (n--) { *p++ = v & 0xff; v >>= 8; }
+        }
+    }
+    r = write_stream_data( stg, name, data, size, TRUE );
+    free( data );
+    return r;
+}
+
+struct gen_output
+{
+    WCHAR *name;
+    struct gen_table cols;
+    struct gen_stream rows;
+};
+
+UINT msi_generate_transform( MSIDATABASE *db, MSIDATABASE *ref, IStorage *stg )
+{
+    static const struct gen_table tables_cols = { NULL, 1, { { (WCHAR *)L"Name", MSITYPE_VALID | MSITYPE_STRING | MSITYPE_KEY | 64 } } };
+    static const struct gen_table columns_cols = { NULL, 4, {
+        { (WCHAR *)L"Table", MSITYPE_VALID | MSITYPE_STRING | MSITYPE_KEY | 64 },
+        { (WCHAR *)L"Number", MSITYPE_VALID | MSITYPE_KEY | 2 },
+        { (WCHAR *)L"Name", MSITYPE_VALID | MSITYPE_STRING | 64 },
+        { (WCHAR *)L"Type", MSITYPE_VALID | 2 } } };
+    struct gen_stream tables_rows = { 0 }, columns_rows = { 0 };
+    struct gen_output *out = NULL;
+    UINT nout = 0, i, j, k, r, bytes_per_strref, changes = 0;
+    MSIRECORD **new_rows = NULL, **old_rows = NULL, *rec;
+    UINT new_count, old_count;
+    string_table *st = NULL;
+    MSIQUERY *q = NULL;
+    WCHAR **names = NULL;
+    UINT nnames = 0;
+
+    if (FAILED( msi_init_string_table( stg ) )) return ERROR_FUNCTION_FAILED;
+    if (!(st = msi_load_string_table( stg, &bytes_per_strref ))) return ERROR_FUNCTION_FAILED;
+    msi_set_string_table_codepage( st, msi_get_string_table_codepage( db->strings ) );
+
+    /* every table of either database */
+    for (k = 0; k < 2; k++)
+    {
+        if ((r = MSI_OpenQuery( k ? ref : db, &q, L"SELECT `Name` FROM `_Tables`" ))) goto done;
+        if (!MSI_ViewExecute( q, NULL ))
+        {
+            while (!MSI_ViewFetch( q, &rec ))
+            {
+                WCHAR *n = msi_dup_record_field( rec, 1 );
+                for (j = 0; j < nnames; j++) if (!wcscmp( names[j], n )) break;
+                if (j == nnames)
+                {
+                    names = realloc( names, (nnames + 1) * sizeof(*names) );
+                    names[nnames++] = n;
+                }
+                else free( n );
+                msiobj_release( &rec->hdr );
+            }
+            MSI_ViewClose( q );
+        }
+        msiobj_release( &q->hdr );
+    }
+
+    for (i = 0; i < nnames; i++)
+    {
+        BOOL in_new = gen_table_exists( db, names[i] ), in_old = gen_table_exists( ref, names[i] );
+        struct gen_table old_cols = { 0 };
+        struct gen_output *o;
+        UINT keys, full;
+
+        out = realloc( out, (nout + 1) * sizeof(*out) );
+        o = &out[nout++];
+        memset( o, 0, sizeof(*o) );
+        o->name = names[i];
+
+        if (!in_new)
+        {
+            /* dropped: its _Tables row is deleted */
+            struct gen_row *row = gen_add_row( &tables_rows, 0 );
+            row->vals[0] = msi_add_string( st, names[i], -1, TRUE );
+            changes++;
+            continue;
+        }
+        if ((r = gen_table_columns( db, names[i], &o->cols ))) goto done;
+        if (in_old && (r = gen_table_columns( ref, names[i], &old_cols ))) goto done;
+        if (in_old && old_cols.count != o->cols.count)
+        {
+            FIXME( "table %s: columns added or removed, not in the transform\n", debugstr_w(names[i]) );
+            gen_free_columns( &old_cols );
+            continue;
+        }
+        if (!in_old)
+        {
+            struct gen_row *row = gen_add_row( &tables_rows, (1 << 8) | 1 );
+            row->vals[0] = msi_add_string( st, names[i], -1, TRUE );
+            for (j = 0; j < o->cols.count; j++)
+            {
+                row = gen_add_row( &columns_rows, (4 << 8) | 1 );
+                row->vals[0] = msi_add_string( st, names[i], -1, TRUE );
+                row->vals[1] = (j + 1 + 0x8000) & 0xffff;
+                row->vals[2] = msi_add_string( st, o->cols.cols[j].name, -1, TRUE );
+                row->vals[3] = (o->cols.cols[j].type + 0x8000) & 0xffff;
+            }
+            changes++;
+        }
+
+        keys = gen_key_mask( &o->cols );
+        full = (1u << o->cols.count) - 1;
+        if ((r = gen_all_rows( db, names[i], &new_rows, &new_count ))) goto done;
+        if (in_old && (r = gen_all_rows( ref, names[i], &old_rows, &old_count ))) goto done;
+        if (!in_old) old_count = 0;
+
+        for (j = 0; j < new_count; j++)
+        {
+            WCHAR *key = gen_row_key( &o->cols, new_rows[j] );
+            MSIRECORD *old = NULL;
+            UINT diff = 0, c;
+            struct gen_row *row;
+
+            for (k = 0; k < old_count; k++)
+            {
+                WCHAR *okey;
+                if (!old_rows[k]) continue;
+                okey = gen_row_key( &o->cols, old_rows[k] );
+                if (!wcscmp( key, okey ))
+                {
+                    old = old_rows[k];
+                    old_rows[k] = NULL;  /* matched */
+                }
+                free( okey );
+                if (old) break;
+            }
+            free( key );
+            if (old)
+            {
+                for (c = 0; c < o->cols.count; c++)
+                    if (!(keys & (1u << c)) && !gen_fields_equal( &o->cols, c, new_rows[j], old )) diff |= 1u << c;
+                msiobj_release( &old->hdr );
+                if (!diff) continue;
+            }
+            /* a new row, or one whose changes a column mask cannot say
+             * (the low bit is the "whole row" flag), goes whole */
+            if (!old || (diff & 1) || o->cols.count > 15)
+            {
+                row = gen_add_row( &o->rows, (o->cols.count << 8) | 1 );
+                diff = full;
+            }
+            else row = gen_add_row( &o->rows, diff );
+            if (!row) { r = ERROR_OUTOFMEMORY; goto done; }
+            gen_fill_row( row, &o->cols, st, new_rows[j], diff | keys );
+            for (c = 0; c < o->cols.count; c++)
+                if ((diff & (1u << c)) && MSITYPE_IS_BINARY( o->cols.cols[c].type ))
+                    gen_copy_stream( stg, names[i], &o->cols, new_rows[j], c + 1 );
+            changes++;
+        }
+        /* rows only the reference has are deleted */
+        for (k = 0; k < old_count; k++)
+        {
+            struct gen_row *row;
+            if (!old_rows[k]) continue;
+            row = gen_add_row( &o->rows, 0 );
+            gen_fill_row( row, &o->cols, st, old_rows[k], keys );
+            changes++;
+        }
+        gen_free_rows( new_rows, new_count );
+        gen_free_rows( old_rows, old_count );
+        new_rows = old_rows = NULL;
+        gen_free_columns( &old_cols );
+    }
+
+    if (!changes)
+    {
+        r = ERROR_NO_DATA;
+        goto done;
+    }
+    if ((r = msi_save_string_table( st, stg, &bytes_per_strref ))) goto done;
+    if ((r = gen_write_table( stg, L"_Tables", &tables_cols, &tables_rows, bytes_per_strref ))) goto done;
+    if ((r = gen_write_table( stg, L"_Columns", &columns_cols, &columns_rows, bytes_per_strref ))) goto done;
+    for (i = 0; i < nout; i++)
+        if ((r = gen_write_table( stg, out[i].name, &out[i].cols, &out[i].rows, bytes_per_strref ))) goto done;
+    r = ERROR_SUCCESS;
+
+done:
+    for (i = 0; i < nout; i++)
+    {
+        gen_free_columns( &out[i].cols );
+        free( out[i].rows.rows );
+    }
+    free( out );
+    for (i = 0; i < nnames; i++) free( names[i] );
+    free( names );
+    free( tables_rows.rows );
+    free( columns_rows.rows );
+    if (st) msi_destroy_stringtable( st );
+    return r;
+}
