From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernel32: A forms of FindFirstVolumeMountPoint, SetVolumeMountPoint, SetFirmwareEnvironmentVariable (3736)

kernel32: A forms of FindFirstVolumeMountPoint, SetVolumeMountPoint, SetFirmwareEnvironmentVariable

The A forms convert their strings and call the W functions.
FindFirstVolumeMountPointW checks that the root is a volume and ends the
enumeration at once (no folder mount points exist here).
---
diff --git a/dlls/kernel32/process.c b/dlls/kernel32/process.c
index 4a7369f..e5af725 100644
--- a/dlls/kernel32/process.c
+++ b/dlls/kernel32/process.c
@@ -40,6 +40,14 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(process);
 
+static WCHAR *strdupAW( const char *src )
+{
+    int len = MultiByteToWideChar( CP_ACP, 0, src, -1, NULL, 0 );
+    WCHAR *dst = HeapAlloc( GetProcessHeap(), 0, len * sizeof(WCHAR) );
+    if (dst) MultiByteToWideChar( CP_ACP, 0, src, -1, dst, len );
+    return dst;
+}
+
 static const struct _KUSER_SHARED_DATA *user_shared_data = (struct _KUSER_SHARED_DATA *)0x7ffe0000;
 
 typedef struct
@@ -783,11 +791,22 @@ DWORD WINAPI GetFirmwareEnvironmentVariableExW(LPCWSTR name, LPCWSTR guid, PVOID
 /***********************************************************************
  *           SetFirmwareEnvironmentVariableA     (KERNEL32.@)
  */
+BOOL WINAPI SetFirmwareEnvironmentVariableW(const WCHAR *name, const WCHAR *guid, void *buffer, DWORD size);
+
 BOOL WINAPI SetFirmwareEnvironmentVariableA(const char *name, const char *guid, void *buffer, DWORD size)
 {
-    FIXME("stub: %s %s %p %lu\n", debugstr_a(name), debugstr_a(guid), buffer, size);
-    SetLastError(ERROR_INVALID_FUNCTION);
-    return FALSE;
+    WCHAR *nameW = NULL, *guidW = NULL;
+    BOOL ret = FALSE;
+
+    TRACE("%s %s %p %lu\n", debugstr_a(name), debugstr_a(guid), buffer, size);
+
+    if ((!name || (nameW = strdupAW( name ))) && (!guid || (guidW = strdupAW( guid ))))
+        ret = SetFirmwareEnvironmentVariableW( nameW, guidW, buffer, size );
+    else
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+    HeapFree( GetProcessHeap(), 0, nameW );
+    HeapFree( GetProcessHeap(), 0, guidW );
+    return ret;
 }
 
 /***********************************************************************
diff --git a/dlls/kernel32/volume.c b/dlls/kernel32/volume.c
index 54fc653..1c7d54e 100644
--- a/dlls/kernel32/volume.c
+++ b/dlls/kernel32/volume.c
@@ -40,6 +40,14 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(volume);
 
+static WCHAR *strdupAW( const char *src )
+{
+    int len = MultiByteToWideChar( CP_ACP, 0, src, -1, NULL, 0 );
+    WCHAR *dst = HeapAlloc( GetProcessHeap(), 0, len * sizeof(WCHAR) );
+    if (dst) MultiByteToWideChar( CP_ACP, 0, src, -1, dst, len );
+    return dst;
+}
+
 #define BLOCK_SIZE 2048
 #define SUPERBLOCK_SIZE BLOCK_SIZE
 
@@ -506,9 +514,40 @@ BOOL WINAPI FindNextVolumeA( HANDLE handle, LPSTR volume, DWORD len )
  */
 HANDLE WINAPI FindFirstVolumeMountPointA(LPCSTR root, LPSTR mount_point, DWORD len)
 {
-    FIXME("(%s, %p, %ld), stub!\n", debugstr_a(root), mount_point, len);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return INVALID_HANDLE_VALUE;
+    WCHAR *rootW = NULL, *buffer;
+    HANDLE ret;
+    DWORD err;
+
+    TRACE("(%s, %p, %ld)\n", debugstr_a(root), mount_point, len);
+
+    if (!root || !mount_point || !len)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return INVALID_HANDLE_VALUE;
+    }
+    if (!(rootW = strdupAW( root )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return INVALID_HANDLE_VALUE;
+    }
+    if (!(buffer = HeapAlloc( GetProcessHeap(), 0, (len ? len : 1) * sizeof(WCHAR) )))
+    {
+        HeapFree( GetProcessHeap(), 0, rootW );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return INVALID_HANDLE_VALUE;
+    }
+    ret = FindFirstVolumeMountPointW( rootW, buffer, len );
+    err = GetLastError();
+    if (ret != INVALID_HANDLE_VALUE && len && !WideCharToMultiByte( CP_ACP, 0, buffer, -1, mount_point, len, NULL, NULL ))
+    {
+        FindVolumeMountPointClose( ret );
+        ret = INVALID_HANDLE_VALUE;
+        err = ERROR_FILENAME_EXCED_RANGE;
+    }
+    HeapFree( GetProcessHeap(), 0, buffer );
+    HeapFree( GetProcessHeap(), 0, rootW );
+    SetLastError( err );
+    return ret;
 }
 
 /***********************************************************************
@@ -516,8 +555,19 @@ HANDLE WINAPI FindFirstVolumeMountPointA(LPCSTR root, LPSTR mount_point, DWORD l
  */
 HANDLE WINAPI FindFirstVolumeMountPointW(LPCWSTR root, LPWSTR mount_point, DWORD len)
 {
-    FIXME("(%s, %p, %ld), stub!\n", debugstr_w(root), mount_point, len);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    WCHAR volume[MAX_PATH];
+
+    TRACE("(%s, %p, %ld)\n", debugstr_w(root), mount_point, len);
+
+    if (!root || !mount_point || !len)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return INVALID_HANDLE_VALUE;
+    }
+    /* the root must be that of a volume; nothing here has folder mount points (a volume is
+     * only ever mounted on a drive letter), so there is nothing to enumerate */
+    if (!GetVolumeNameForVolumeMountPointW( root, volume, ARRAY_SIZE(volume) )) return INVALID_HANDLE_VALUE;
+    SetLastError( ERROR_NO_MORE_FILES );
     return INVALID_HANDLE_VALUE;
 }
 
@@ -526,7 +576,9 @@ HANDLE WINAPI FindFirstVolumeMountPointW(LPCWSTR root, LPWSTR mount_point, DWORD
  */
 BOOL WINAPI FindVolumeMountPointClose(HANDLE h)
 {
-    FIXME("(%p), stub!\n", h);
+    TRACE("(%p)\n", h);
+    /* no enumeration ever hands out a handle */
+    SetLastError( ERROR_INVALID_HANDLE );
     return FALSE;
 }
 
@@ -544,9 +596,18 @@ BOOL WINAPI DeleteVolumeMountPointA(LPCSTR mountpoint)
  */
 BOOL WINAPI SetVolumeMountPointA(LPCSTR path, LPCSTR volume)
 {
-    FIXME("(%s, %s), stub!\n", debugstr_a(path), debugstr_a(volume));
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    WCHAR *pathW = NULL, *volumeW = NULL;
+    BOOL ret = FALSE;
+
+    TRACE("(%s, %s)\n", debugstr_a(path), debugstr_a(volume));
+
+    if ((!path || (pathW = strdupAW( path ))) && (!volume || (volumeW = strdupAW( volume ))))
+        ret = SetVolumeMountPointW( pathW, volumeW );
+    else
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+    HeapFree( GetProcessHeap(), 0, pathW );
+    HeapFree( GetProcessHeap(), 0, volumeW );
+    return ret;
 }
 
 /***********************************************************************
