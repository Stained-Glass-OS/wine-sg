 static HRESULT WINAPI MimeBody_CopyTo(
@@ -1796,8 +1910,39 @@
                                  LPCSTR pszFilePath)
 {
     MimeBody *This = impl_from_IMimeBody(iface);
-    FIXME("(%p)->(%d, %s) stub\n", This, ietEncoding, debugstr_a(pszFilePath));
-    return E_NOTIMPL;
+    IStream *data;
+    HANDLE file;
+    HRESULT hr;
+    char buf[4096];
+    ULONG read;
+
+    TRACE("(%p)->(%d, %s)\n", This, ietEncoding, debugstr_a(pszFilePath));
+
+    if (!pszFilePath)
+        return E_INVALIDARG;
+    if (!This->data)
+        return MIME_E_NO_DATA;
+    if (FAILED(hr = IMimeBody_GetData(iface, ietEncoding, &data)))
+        return hr;
+
+    file = CreateFileA(pszFilePath, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        IStream_Release(data);
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+    while (SUCCEEDED(hr = IStream_Read(data, buf, sizeof(buf), &read)) && read)
+    {
+        DWORD written;
+        if (!WriteFile(file, buf, read, &written, NULL) || written != read)
+        {
+            hr = HRESULT_FROM_WIN32(GetLastError());
+            break;
+        }
+    }
+    CloseHandle(file);
+    IStream_Release(data);
+    return FAILED(hr) ? hr : S_OK;
 }
 
