From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] inetcomm: IMimeBody data, charset, content type; MimeOleCreateBody (2033)

IMimeBody: MimeOleCreateBody is exported (it was a stub); the content type
follows SetData (application/octet-stream for what is not given);
GetCharset answers the charset parameter of Content-Type, else the default
charset, never null; SetCharset writes the parameter (untagged, all, tag
all); EmptyData drops the data and GetData then reports MIME_E_NO_DATA;
GetEstimatedSize, GetDataHere (any encoding GetData supports) and
SaveToFile are written. Four passing todo_wine marks removed in the
inetcomm mimeole test.
---
--- a/dlls/inetcomm/mimeole.c
+++ b/dlls/inetcomm/mimeole.c
@@ -1275,14 +1275,37 @@
     return E_NOTIMPL;
 }
 
+static const char *get_charset_param(MimeBody *body)
+{
+    header_t *header;
+    param_t *param;
+
+    if (find_prop(body, "Content-Type", &header) != S_OK) return NULL;
+    LIST_FOR_EACH_ENTRY(param, &header->params, param_t, entry)
+        if (!lstrcmpiA(param->name, "charset")) return param->value;
+    return NULL;
+}
+
 static HRESULT WINAPI MimeBody_GetCharset(
                                  IMimeBody* iface,
                                  LPHCHARSET phCharset)
 {
     MimeBody *This = impl_from_IMimeBody(iface);
-    FIXME("(%p)->(%p) stub\n", This, phCharset);
-    *phCharset = NULL;
-    return S_OK;
+    const char *name;
+
+    TRACE("(%p)->(%p)\n", This, phCharset);
+
+    if (!phCharset)
+        return E_INVALIDARG;
+
+    /* the charset parameter of the content type, else the default charset */
+    name = get_charset_param(This);
+#ifdef SG_MUTANT_BODY_CHARSET
+    name = NULL;
+#endif
+    if (name && SUCCEEDED(MimeOleFindCharset(name, phCharset)))
+        return S_OK;
+    return MimeOleGetDefaultCharset(phCharset);
 }
 
 static HRESULT WINAPI MimeBody_SetCharset(
@@ -1291,8 +1314,46 @@
                                  CSETAPPLYTYPE applytype)
 {
     MimeBody *This = impl_from_IMimeBody(iface);
-    FIXME("(%p)->(%p, %d) stub\n", This, hCharset, applytype);
-    return E_NOTIMPL;
+    INETCSETINFO info;
+    header_t *header;
+    param_t *param;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p, %d)\n", This, hCharset, applytype);
+
+    if (!hCharset || applytype > CSET_APPLY_TAG_ALL)
+        return E_INVALIDARG;
+    if (FAILED(hr = MimeOleGetCharsetInfo(hCharset, &info)))
+        return hr;
+
+    if (find_prop(This, "Content-Type", &header) != S_OK)
+    {
+        PROPVARIANT value;
+        char *text = strdup("text/plain");
+
+        PropVariantInit(&value);
+        value.vt = VT_LPSTR;
+        value.pszVal = text;
+        hr = IMimeBody_SetProp(iface, "Content-Type", 0, &value);
+        free(text);
+        if (FAILED(hr)) return hr;
+        if (FAILED(hr = find_prop(This, "Content-Type", &header))) return hr;
+    }
+
+    LIST_FOR_EACH_ENTRY(param, &header->params, param_t, entry)
+    {
+        if (lstrcmpiA(param->name, "charset")) continue;
+        if (applytype == CSET_APPLY_UNTAGGED) return S_OK;
+        free(param->value);
+        param->value = strdup(info.szName);
+        return S_OK;
+    }
+
+    param = malloc(sizeof(*param));
+    param->name = strdup("charset");
+    param->value = strdup(info.szName);
+    list_add_tail(&header->params, &param->entry);
+    return S_OK;
 }
 
 static HRESULT WINAPI MimeBody_GetParameters(
@@ -1514,8 +1575,30 @@
                                        ULONG* pcbSize)
 {
     MimeBody *This = impl_from_IMimeBody(iface);
-    FIXME("(%p)->(%d, %p) stub\n", This, ietEncoding, pcbSize);
-    return E_NOTIMPL;
+    ULARGE_INTEGER size;
+    ULONGLONG n;
+    HRESULT hr;
+
+    TRACE("(%p)->(%d, %p)\n", This, ietEncoding, pcbSize);
+
+    if (!pcbSize)
+        return E_INVALIDARG;
+    *pcbSize = 0;
+    if (!This->data)
+        return MIME_E_NO_DATA;
+    if (FAILED(hr = get_stream_size(This->data, &size)))
+        return hr;
+
+    /* an estimate: the size of the data as stored, moved to the other encoding's expansion */
+    n = size.QuadPart;
+    if (ietEncoding != This->encoding)
+    {
+        if (This->encoding == IET_BASE64) n = n / 4 * 3;
+        if (ietEncoding == IET_BASE64) n = (n + 2) / 3 * 4 + (n + 56) / 57 * 2;
+        else if (ietEncoding == IET_QP) n = n * 3;
+    }
+    *pcbSize = n;
+    return S_OK;
 }
 
 static HRESULT WINAPI MimeBody_GetDataHere(
@@ -1524,8 +1607,28 @@
                                   IStream* pStream)
 {
     MimeBody *This = impl_from_IMimeBody(iface);
-    FIXME("(%p)->(%d, %p) stub\n", This, ietEncoding, pStream);
-    return E_NOTIMPL;
+    IStream *data;
+    HRESULT hr;
+    char buf[4096];
+    ULONG read;
+
+    TRACE("(%p)->(%d, %p)\n", This, ietEncoding, pStream);
+
+    if (!pStream)
+        return E_INVALIDARG;
+    if (!This->data)
+        return MIME_E_NO_DATA;
+
+    if (FAILED(hr = IMimeBody_GetData(iface, ietEncoding, &data)))
+        return hr;
+    while (SUCCEEDED(hr = IStream_Read(data, buf, sizeof(buf), &read)) && read)
+    {
+        ULONG written;
+        if (FAILED(hr = IStream_Write(pStream, buf, read, &written)))
+            break;
+    }
+    IStream_Release(data);
+    return FAILED(hr) ? hr : S_OK;
 }
 
