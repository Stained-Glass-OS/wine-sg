+/* Stained Glass OS: the taskbar's Windows 10 appearance.
+ *
+ * This is the real Shell_TrayWnd, upgraded in place -- every part of the shell
+ * protocol (tray icons, taskbar buttons, position, ITaskbarList) is unchanged,
+ * only how the bar looks. A flat dark bar at the Windows 10 height, our
+ * stained-glass Start mark, flat task buttons, and a clock. The palette shares
+ * no colour with any operating system's logo. */
+#define SG_TASKBAR_HEIGHT 40
+#define SG_CLOCK_WIDTH    88
+#define SG_CLOCK_TIMER    0xC10C
+#define SG_COL_BAR        RGB(0x1F, 0x1F, 0x1F)
+#define SG_COL_HOVER      RGB(0x3A, 0x3A, 0x3A)
+#define SG_COL_ACTIVE     RGB(0x2B, 0x2B, 0x2B)
+#define SG_COL_TEXT       RGB(0xFF, 0xFF, 0xFF)
+static HBRUSH sg_bar_brush;
+
+/* The Start mark: four stained-glass tiles as a diamond, our own emblem. */
+static void sg_draw_start_mark( HDC dc, const RECT *area, BOOL hot )
+{
+    int cx = (area->left + area->right) / 2, cy = (area->top + area->bottom) / 2;
+    int half = 6, off = half + 2, i;
+    static const COLORREF glass[4] = {
+        RGB(0x7B, 0x2F, 0xBE), RGB(0xC4, 0x2E, 0x8E),
+        RGB(0xE8, 0xA2, 0x00), RGB(0x12, 0xB5, 0xB0),
+    };
+    const POINT at[4] = { { cx, cy - off }, { cx + off, cy }, { cx, cy + off }, { cx - off, cy } };
+
+    for (i = 0; i < 4; i++)
+    {
+        POINT pt[4] = {
+            { at[i].x, at[i].y - half }, { at[i].x + half, at[i].y },
+            { at[i].x, at[i].y + half }, { at[i].x - half, at[i].y },
+        };
+        HBRUSH b = CreateSolidBrush( hot ? SG_COL_HOVER : glass[i] );
+        HBRUSH ob = SelectObject( dc, b );
+        HPEN op = SelectObject( dc, GetStockObject( NULL_PEN ));
+        Polygon( dc, pt, 4 );
+        SelectObject( dc, op );
+        SelectObject( dc, ob );
+        DeleteObject( b );
+    }
+}
 static WCHAR start_label[50];
 
 static struct icon *balloon_icon;
