+/* Stained Glass OS: draw the clock at the right of the bar. */
+static void sg_draw_clock( HWND hwnd, HDC dc )
+{
+    RECT c, top, bottom;
+    WCHAR t[16], d[16];
+    SYSTEMTIME st;
+
+    GetClientRect( hwnd, &c );
+    top = bottom = c;
+    top.left = bottom.left = c.right - SG_CLOCK_WIDTH;
+    top.bottom = (c.top + c.bottom) / 2 + 1;
+    bottom.top = top.bottom;
+    GetLocalTime( &st );
+    GetTimeFormatEx( NULL, TIME_NOSECONDS, &st, NULL, t, ARRAY_SIZE(t) );
+    GetDateFormatEx( NULL, DATE_SHORTDATE, &st, NULL, d, ARRAY_SIZE(d), NULL );
+    SetBkMode( dc, TRANSPARENT );
+    SetTextColor( dc, SG_COL_TEXT );
+    DrawTextW( dc, t, -1, &top, DT_CENTER | DT_BOTTOM | DT_SINGLELINE );
+    DrawTextW( dc, d, -1, &bottom, DT_CENTER | DT_TOP | DT_SINGLELINE );
+}
+
 static LRESULT WINAPI shell_traywnd_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
 {
     switch (msg)
@@ -1104,6 +1202,32 @@
