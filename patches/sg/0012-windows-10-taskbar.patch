+/* Stained Glass OS: the taskbar clock -- time over date, right-aligned. */
+static void sg_draw_clock( HDC hdc, const RECT *rect )
+{
+    WCHAR buf[64];
+    SYSTEMTIME st;
+    RECT r = *rect;
+    HFONT font, old;
+    NONCLIENTMETRICSW ncm;
+    int half = (r.bottom - r.top) / 2;
+
+    GetLocalTime( &st );
+
+    ncm.cbSize = sizeof(ncm);
+    SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+    font = CreateFontIndirectW( &ncm.lfMenuFont );
+    old = SelectObject( hdc, font );
+    SetBkMode( hdc, TRANSPARENT );
+    SetTextColor( hdc, SG_COL_TEXT );
+
+    r.right -= 8;
+    r.top = rect->top;  r.bottom = rect->top + half;
+    if (GetTimeFormatW( LOCALE_USER_DEFAULT, TIME_NOSECONDS, &st, NULL, buf, ARRAY_SIZE(buf) ))
+        DrawTextW( hdc, buf, -1, &r, DT_RIGHT | DT_VCENTER | DT_SINGLELINE );
+    r.top = rect->top + half; r.bottom = rect->bottom;
+    if (GetDateFormatW( LOCALE_USER_DEFAULT, DATE_SHORTDATE, &st, NULL, buf, ARRAY_SIZE(buf) ))
+        DrawTextW( hdc, buf, -1, &r, DT_RIGHT | DT_VCENTER | DT_SINGLELINE );
+
+    SelectObject( hdc, old );
+    DeleteObject( font );
+}
