+            sg_draw_clock( hwnd, dc );
+            EndPaint( hwnd, &ps );
+            return 0;
+        }
+        break;
+
+    case WM_TIMER:
+        if (wparam == SG_CLOCK_TIMER) { InvalidateRect( hwnd, NULL, FALSE ); return 0; }
+        break;
+
     case WM_DISPLAYCHANGE:
         if (!show_systray) do_hide_systray();
         else if (!nb_displayed && !enable_taskbar) do_hide_systray();
