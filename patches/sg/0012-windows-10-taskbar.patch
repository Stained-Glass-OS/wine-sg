+/* Stained Glass OS: fill a rectangle with a solid colour. */
+static void sg_fill( HDC hdc, const RECT *rect, COLORREF color )
+{
+    HBRUSH brush = CreateSolidBrush( color );
+    FillRect( hdc, rect, brush );
+    DeleteObject( brush );
+}
+
+/* Stained Glass OS: the Start mark -- four tiles rotated 45 degrees into a
+ * diamond, in the project palette. Deliberately Windows-adjacent but neither
+ * the Windows logo nor its colours. */
+static void sg_draw_start_mark( HDC hdc, const RECT *rect )
+{
+    static const COLORREF tiles[4] =
+        { SG_COL_TILE1, SG_COL_TILE2, SG_COL_TILE3, SG_COL_TILE4 };
+    int cx = rect->left + (rect->right - rect->left) / 2;
+    int cy = rect->top  + (rect->bottom - rect->top) / 2;
+    int r = min( rect->right - rect->left, rect->bottom - rect->top ) / 2 - 4;
+    int gap = 1;                 /* leaded gap between the tiles */
+    int i;
+
+    if (r < 4) r = 4;
+    /* top, right, bottom, left tiles -- each a small diamond quadrant */
+    for (i = 0; i < 4; i++)
+    {
+        POINT p[4];
+        HBRUSH brush = CreateSolidBrush( tiles[i] );
+        HBRUSH old = SelectObject( hdc, brush );
+        HPEN oldpen = SelectObject( hdc, GetStockObject( NULL_PEN ));
+        int g = gap;
+        switch (i)
+        {
+        case 0: /* top    */
+            p[0].x = cx;         p[0].y = cy - r;
+            p[1].x = cx + r - g; p[1].y = cy - g;
+            p[2].x = cx;         p[2].y = cy - 2*g;
+            p[3].x = cx - r + g; p[3].y = cy - g; break;
+        case 1: /* right  */
+            p[0].x = cx + r;     p[0].y = cy;
+            p[1].x = cx + g;     p[1].y = cy + r - g;
+            p[2].x = cx + 2*g;   p[2].y = cy;
+            p[3].x = cx + g;     p[3].y = cy - r + g; break;
+        case 2: /* bottom */
+            p[0].x = cx;         p[0].y = cy + r;
+            p[1].x = cx - r + g; p[1].y = cy + g;
+            p[2].x = cx;         p[2].y = cy + 2*g;
+            p[3].x = cx + r - g; p[3].y = cy + g; break;
+        default: /* left  */
+            p[0].x = cx - r;     p[0].y = cy;
+            p[1].x = cx - g;     p[1].y = cy - r + g;
+            p[2].x = cx - 2*g;   p[2].y = cy;
+            p[3].x = cx - g;     p[3].y = cy + r - g; break;
+        }
+        Polygon( hdc, p, 4 );
+        SelectObject( hdc, old );
+        SelectObject( hdc, oldpen );
+        DeleteObject( brush );
+    }
+}
