+static HRESULT mesh_builder_add_faces(struct d3drm_mesh_builder *mb, DWORD vertex_count, D3DVECTOR *vertices,
+        DWORD normal_count, D3DVECTOR *normals, DWORD *face_data, IDirect3DRMFaceArray **array)
+{
+    DWORD first = mb->nb_faces;
+    HRESULT hr;
+
+    if (array)
+        *array = NULL;
+    if ((vertex_count && !vertices) || (normal_count && !normals) || !face_data)
+        return D3DRMERR_BADVALUE;
+
+    if (FAILED(hr = mesh_builder_add_face_data(mb, face_data, mb->nb_vertices, vertex_count, mb->nb_normals, normal_count)))
+        return hr;
+    /* the loop above checked and added the faces; now the points they use */
+    if (FAILED(hr = mesh_builder_append_arrays(mb, vertex_count, vertices, normal_count, normals)))
+        return hr;
+
+    return array ? mesh_builder_faces_array(mb, first, array) : D3DRM_OK;
 }
 
