+static HRESULT mesh_builder_add_mesh(struct d3drm_mesh_builder *mb, IDirect3DRMMesh *mesh)
+{
+    DWORD groups, g;
+    HRESULT hr = D3DRM_OK;
+
+    if (!mesh)
+        return D3DRMERR_BADOBJECT;
+    groups = IDirect3DRMMesh_GetGroupCount(mesh);
+    for (g = 0; g < groups && SUCCEEDED(hr); ++g)
+    {
+        unsigned int vertex_count, face_count, vertex_per_face;
+        DWORD data_size, i, vertex_base = mb->nb_vertices, normal_base = mb->nb_normals, words = 0, *face_data = NULL;
+        D3DRMVERTEX *vertices = NULL;
+        D3DVECTOR *positions = NULL, *normals = NULL;
+        unsigned int *data = NULL;
+
+        if (FAILED(hr = IDirect3DRMMesh_GetGroup(mesh, g, &vertex_count, &face_count, &vertex_per_face, &data_size, NULL)))
+            break;
+        vertices = calloc(vertex_count ? vertex_count : 1, sizeof(*vertices));
+        positions = calloc(vertex_count ? vertex_count : 1, sizeof(*positions));
+        normals = calloc(vertex_count ? vertex_count : 1, sizeof(*normals));
+        data = calloc(data_size ? data_size : 1, sizeof(*data));
+        face_data = calloc(face_count * (vertex_per_face ? vertex_per_face * 2 + 1 : 0) + data_size * 2 + 2, sizeof(*face_data));
+        if (!vertices || !positions || !normals || !data || !face_data)
+            hr = E_OUTOFMEMORY;
+        if (SUCCEEDED(hr))
+            hr = IDirect3DRMMesh_GetVertices(mesh, g, 0, vertex_count, vertices);
+        if (SUCCEEDED(hr))
+            hr = IDirect3DRMMesh_GetGroup(mesh, g, &vertex_count, &face_count, &vertex_per_face, &data_size, data);
+        if (SUCCEEDED(hr))
+        {
+            unsigned int *in = data;
+            DWORD *out = face_data;
+
+            for (i = 0; i < vertex_count; ++i)
+            {
+                positions[i] = vertices[i].position;
+                normals[i] = vertices[i].normal;
+            }
+            for (i = 0; i < face_count; ++i)
+            {
+                unsigned int n = vertex_per_face ? vertex_per_face : *in++, j;
+
+                *out++ = n;
+                for (j = 0; j < n; ++j, ++in)
+                {
+                    *out++ = *in;   /* the vertex; its normal is the vertex's own */
+                    *out++ = *in;
+                }
+            }
+            *out = 0;
+            words = out - face_data;
+            (void)words;
+            if (SUCCEEDED(hr = mesh_builder_add_face_data(mb, face_data, vertex_base, vertex_count, normal_base, vertex_count)))
+                hr = mesh_builder_append_arrays(mb, vertex_count, positions, vertex_count, normals);
+        }
+        free(vertices);
+        free(positions);
+        free(normals);
+        free(data);
+        free(face_data);
+    }
+    return hr;
+}
