+static HRESULT mesh_builder_add_face(struct d3drm_mesh_builder *mb, struct d3drm_face *face)
+{
+    SIZE_T i;
+    DWORD *data;
+    BOOL normals = FALSE;
+    HRESULT hr;
+
+    if (!face || !face->nb_vertices)
+        return D3DRMERR_BADOBJECT;
+    for (i = 0; i < face->nb_vertices; ++i)
+        normals |= face->vertices[i].has_normal;
+    if (!(data = malloc((1 + face->nb_vertices * 2) * sizeof(*data))))
+        return E_OUTOFMEMORY;
+    data[0] = face->nb_vertices;
+    for (i = 0; i < face->nb_vertices; ++i)
+    {
+        D3DVECTOR normal = face->vertices[i].normal;
+        DWORD vertex_index = mb->nb_vertices, normal_index = mb->nb_normals;
+
+        if (FAILED(hr = mesh_builder_append_arrays(mb, 1, &face->vertices[i].position, normals ? 1 : 0, &normal)))
+        {
+            free(data);
+            return hr;
+        }
+        data[1 + i * 2] = vertex_index;
+        data[2 + i * 2] = normals ? normal_index : 0;
+    }
+    hr = mesh_builder_append_face_data(mb, data, 1 + face->nb_vertices * 2);
+    free(data);
+    return hr;
+}
