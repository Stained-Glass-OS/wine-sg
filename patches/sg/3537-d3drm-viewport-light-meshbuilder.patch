+
+/* ---- adding to and generating from the data of a builder ---- */
+
+/* appends one face (count, then vertex and normal index pairs) in front of the terminating 0 of the face data */
+static HRESULT mesh_builder_append_face_data(struct d3drm_mesh_builder *mb, const DWORD *face, DWORD words)
+{
+    DWORD old = mb->face_data_size ? mb->face_data_size - 1 : 0;
+    DWORD *data;
+
+    if (!(data = realloc(mb->pFaceData, (old + words + 1) * sizeof(*data))))
+        return E_OUTOFMEMORY;
+    memcpy(data + old, face, words * sizeof(*data));
+    data[old + words] = 0;
+    mb->pFaceData = data;
+    mb->face_data_size = old + words + 1;
+    ++mb->nb_faces;
+    return D3DRM_OK;
+}
+
+static HRESULT mesh_builder_append_arrays(struct d3drm_mesh_builder *mb, DWORD vertex_count, const D3DVECTOR *vertices,
+        DWORD normal_count, const D3DVECTOR *normals)
+{
+    if (vertex_count && !d3drm_array_reserve((void **)&mb->vertices, &mb->vertices_size,
+            mb->nb_vertices + vertex_count, sizeof(*mb->vertices)))
+        return E_OUTOFMEMORY;
+    if (normal_count && !d3drm_array_reserve((void **)&mb->normals, &mb->normals_size,
+            mb->nb_normals + normal_count, sizeof(*mb->normals)))
+        return E_OUTOFMEMORY;
+    if (vertex_count)
+        memcpy(mb->vertices + mb->nb_vertices, vertices, vertex_count * sizeof(*vertices));
+    if (normal_count)
+        memcpy(mb->normals + mb->nb_normals, normals, normal_count * sizeof(*normals));
+    mb->nb_vertices += vertex_count;
+    mb->nb_normals += normal_count;
+    return D3DRM_OK;
+}
+
+/* the faces of face data (count, index pairs, ending with 0) are added with their indices moved up */
+static HRESULT mesh_builder_add_face_data(struct d3drm_mesh_builder *mb, const DWORD *face_data, DWORD vertex_base,
+        DWORD vertex_count, DWORD normal_base, DWORD normal_count)
+{
+    const DWORD *ptr;
+    DWORD n, j, *face;
+    HRESULT hr;
+
+    for (ptr = face_data; (n = *ptr); ptr += 1 + n * 2)
+        for (j = 0; j < n; ++j)
+            if (ptr[1 + j * 2] >= vertex_count || (normal_count && ptr[2 + j * 2] >= normal_count))
+                return D3DRMERR_BADVALUE;
+
+    for (ptr = face_data; (n = *ptr); ptr += 1 + n * 2)
+    {
+        if (!(face = malloc((1 + n * 2) * sizeof(*face))))
+            return E_OUTOFMEMORY;
+        face[0] = n;
+        for (j = 0; j < n; ++j)
+        {
+            face[1 + j * 2] = ptr[1 + j * 2] + vertex_base;
+            face[2 + j * 2] = normal_count ? ptr[2 + j * 2] + normal_base : ptr[2 + j * 2];
+        }
+        hr = mesh_builder_append_face_data(mb, face, 1 + n * 2);
+        free(face);
+        if (FAILED(hr))
+            return hr;
+    }
+    return D3DRM_OK;
+}
+
+static HRESULT mesh_builder_faces_array(struct d3drm_mesh_builder *mb, DWORD first, IDirect3DRMFaceArray **array)
+{
+    struct d3drm_face **faces;
+    DWORD count = mb->nb_faces - first, i;
+    HRESULT hr = D3DRM_OK;
+
+    if (!(faces = calloc(count ? count : 1, sizeof(*faces))))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < count && SUCCEEDED(hr); ++i)
+        hr = mesh_builder_get_face(mb, mb->nb_leading_extra_faces + first + i, &faces[i]);
+    if (SUCCEEDED(hr))
+        hr = d3drm_face_array_create(faces, count, array);
+    for (i = 0; i < count; ++i)
+        if (faces[i])
+            IDirect3DRMFace_Release(&faces[i]->IDirect3DRMFace_iface);
+    free(faces);
+    return hr;
+}
+
+/* a normal for each corner of each face: the (normalized) sum of the normals of the faces around the vertex,
+ * or with a crease angle only of those within that angle of the face; faces are clockwise as D3DRM draws them */
+static HRESULT mesh_builder_generate_normals(struct d3drm_mesh_builder *mb, D3DVALUE crease, DWORD flags)
+{
+    D3DVECTOR *face_normals, *new_normals = NULL;
+    DWORD *ptr, i, j, k, l, n, corner = 0, *face_start = NULL;
+    SIZE_T count = 0;
+    HRESULT hr = E_OUTOFMEMORY;
+    BOOL use_crease = flags & D3DRMGENERATENORMALS_USECREASEANGLE;
+
+    if (!mb->nb_faces)
+        return D3DRM_OK;
+    face_normals = calloc(mb->nb_faces, sizeof(*face_normals));
+    face_start = calloc(mb->nb_faces, sizeof(*face_start));
+    if (!face_normals || !face_start)
+        goto done;
+
+    for (ptr = mb->pFaceData, i = 0; i < mb->nb_faces; ++i, ptr += 1 + n * 2)
+    {
+        n = *ptr;
+        face_start[i] = ptr - (DWORD *)mb->pFaceData;
+        count += n;
+        if (n > 2 && ptr[1] < mb->nb_vertices && ptr[3] < mb->nb_vertices && ptr[5] < mb->nb_vertices)
+        {
+            D3DVECTOR a, b;
+
+            D3DRMVectorSubtract(&a, &mb->vertices[ptr[5]], &mb->vertices[ptr[3]]);
+            D3DRMVectorSubtract(&b, &mb->vertices[ptr[1]], &mb->vertices[ptr[3]]);
+            D3DRMVectorCrossProduct(&face_normals[i], &a, &b);
+            D3DRMVectorNormalize(&face_normals[i]);
+        }
+    }
+    if (!(new_normals = calloc(count ? count : 1, sizeof(*new_normals))))
+        goto done;
+
+    for (ptr = mb->pFaceData, i = 0; i < mb->nb_faces; ++i, ptr += 1 + n * 2)
+    {
+        n = *ptr;
+        for (j = 0; j < n; ++j, ++corner)
+        {
+            D3DVECTOR sum = {0};
+
+            /* the faces sharing this vertex */
+            for (k = 0; k < mb->nb_faces; ++k)
+            {
+                const DWORD *other = (DWORD *)mb->pFaceData + face_start[k];
+
+                for (l = 0; l < other[0]; ++l)
+                    if (other[1 + l * 2] == ptr[1 + j * 2])
+                        break;
+                if (l == other[0])
+                    continue;
+                if (use_crease && k != i && D3DRMVectorDotProduct(&face_normals[i], &face_normals[k]) < cosf(crease))
+                    continue;
+                D3DRMVectorAdd(&sum, &sum, &face_normals[k]);
+            }
+            D3DRMVectorNormalize(&sum);
+            new_normals[corner] = sum;
+        }
+    }
+
+    free(mb->normals);
+    mb->normals = new_normals;
+    new_normals = NULL;
+    mb->nb_normals = mb->normals_size = count;
+    for (ptr = mb->pFaceData, corner = 0, i = 0; i < mb->nb_faces; ++i, ptr += 1 + n * 2)
+    {
+        n = *ptr;
+        for (j = 0; j < n; ++j)
+            ptr[2 + j * 2] = corner++;
+    }
+    hr = D3DRM_OK;
+done:
+    free(new_normals);
+    free(face_normals);
+    free(face_start);
+    return hr;
+}
