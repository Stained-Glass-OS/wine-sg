+static HRESULT mesh_builder_add_builder(struct d3drm_mesh_builder *mb, struct d3drm_mesh_builder *src)
+{
+    DWORD vertex_base = mb->nb_vertices, normal_base = mb->nb_normals;
+    HRESULT hr;
+
+    if (src == mb)
+        return D3DRM_OK;
+    if (src->face_data_size)
