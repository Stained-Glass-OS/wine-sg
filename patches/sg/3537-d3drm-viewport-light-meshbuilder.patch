+static HRESULT mesh_builder_set_vertex_color(struct d3drm_mesh_builder *mb, DWORD index, D3DCOLOR color)
+{
+    SIZE_T i;
+
+    if (index >= mb->nb_vertices)
+        return D3DRMERR_BADVALUE;
+    if (index >= mb->nb_vertex_colors)
+    {
+        D3DCOLOR *colors = realloc(mb->vertex_colors, mb->nb_vertices * sizeof(*colors));
+
+        if (!colors)
+            return E_OUTOFMEMORY;
+        mb->vertex_colors = colors;
+        for (i = mb->nb_vertex_colors; i < mb->nb_vertices; ++i)
+            colors[i] = mb->color;
+        mb->nb_vertex_colors = mb->nb_vertices;
+    }
+    mb->vertex_colors[index] = color;
+    return D3DRM_OK;
+}
+
+static D3DCOLOR mesh_builder_get_vertex_color(struct d3drm_mesh_builder *mb, DWORD index)
+{
+    if (index < mb->nb_vertex_colors)
+        return mb->vertex_colors[index];
+    return mb->color;
+}
+
+static D3DCOLOR float_color(D3DVALUE red, D3DVALUE green, D3DVALUE blue)
