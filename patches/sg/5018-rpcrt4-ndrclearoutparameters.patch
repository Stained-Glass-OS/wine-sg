From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcrt4: Implement NdrClearOutParameters.

NdrClearOutParameters frees what an unmarshalling proxy put into an [out]
parameter and clears it, as documented ("frees resources of the out
parameter and clears its memory if the RPC call to the server fails"): an
interface pointer is released, unmarshalled memory freed with the stub
message's free routine, the parameter zeroed to its size. It never frees the
parameter itself, which is the caller's, and leaves it alone unless the
proxy is unmarshalling and has read something: before that, [out]
parameters are still zero and [in, out] ones the caller's (Wine's stubless
proxies raise CO_E_OBJNOTCONNECTED before zeroing them). It was a no-op, so
a failed call leaked what had been unmarshalled and left it in the caller's
variables.

Gate: test/rpcrt4-clearout-gate.sh (64/32).
---
 dlls/rpcrt4/ndr_marshall.c | 43 ++++++++++++++++++++++++++++++++++++++++++-
 dlls/rpcrt4/ndr_stubless.c |  2 +-
 dlls/rpcrt4/ndr_stubless.h |  1 +
 3 files changed, 44 insertions(+), 2 deletions(-)

diff --git a/dlls/rpcrt4/ndr_marshall.c b/dlls/rpcrt4/ndr_marshall.c
index c68eb0e..b5375b2 100644
--- a/dlls/rpcrt4/ndr_marshall.c
+++ b/dlls/rpcrt4/ndr_marshall.c
@@ -40,6 +40,7 @@
 #include "ndr_misc.h"
 #include "rpcndr.h"
 #include "ndrtypes.h"
+#include "ndr_stubless.h"
 
 #include "wine/debug.h"
 
@@ -4661,7 +4662,47 @@ void WINAPI NdrClearOutParameters(PMIDL_STUB_MESSAGE pStubMsg,
                                   PFORMAT_STRING pFormat,
                                   void *ArgAddr)
 {
-  FIXME("(%p,%p,%p): stub\n", pStubMsg, pFormat, ArgAddr);
+  NDR_FREE m;
+
+  TRACE("(%p,%p,%p)\n", pStubMsg, pFormat, ArgAddr);
+
+  /* an [out] parameter is a reference pointer, or an array or structure */
+  if (!ArgAddr || *pFormat == FC_UP || *pFormat == FC_OP || *pFormat == FC_FP) return;
+#ifndef SG_MUTANT_CLEAROUT_ANY_PHASE
+  /* Only an unmarshalling proxy has put anything there. Before that the
+   * [out] parameters are still zero and [in, out] ones still the caller's,
+   * and so they are when the send itself failed and nothing was read. */
+  if (pStubMsg->dwStubPhase != PROXY_UNMARSHAL) return;
+  if (pStubMsg->Buffer == pStubMsg->BufferStart) return;
+#endif
+
+  /* free what was unmarshalled into the parameter, never the parameter
+   * itself: that is the caller's */
+#ifdef SG_MUTANT_CLEAROUT_GENERIC_FREE
+  if (*pFormat == FC_RP) NdrPointerFree(pStubMsg, ArgAddr, pFormat);
+  else
+#endif
+  if (*pFormat == FC_RP)
+  {
+    unsigned char attr = pFormat[1], *pointee = ArgAddr;
+    PFORMAT_STRING desc = pFormat + 2;
+
+    if (!(attr & FC_SIMPLE_POINTER))
+    {
+      desc += *(const SHORT *)desc;
+      if (attr & FC_POINTER_DEREF) pointee = *(unsigned char **)ArgAddr;
+      m = NdrFreer[*desc & NDR_TABLE_MASK];
+      if (m && pointee) m(pStubMsg, pointee, desc);
+    }
+  }
+  else
+  {
+    m = NdrFreer[*pFormat & NDR_TABLE_MASK];
+    if (m) m(pStubMsg, ArgAddr, pFormat);
+  }
+#ifndef SG_MUTANT_CLEAROUT_NO_ZERO
+  memset(ArgAddr, 0, calc_arg_size(pStubMsg, pFormat));
+#endif
 }
 
 /***********************************************************************
diff --git a/dlls/rpcrt4/ndr_stubless.c b/dlls/rpcrt4/ndr_stubless.c
index 8cb0514..bcccade 100644
--- a/dlls/rpcrt4/ndr_stubless.c
+++ b/dlls/rpcrt4/ndr_stubless.c
@@ -146,7 +146,7 @@ static inline void call_freer(PMIDL_STUB_MESSAGE pStubMsg, unsigned char *pMemor
     if (m) m(pStubMsg, pMemory, pFormat);
 }
 
-static DWORD calc_arg_size(MIDL_STUB_MESSAGE *pStubMsg, PFORMAT_STRING pFormat)
+DWORD calc_arg_size(MIDL_STUB_MESSAGE *pStubMsg, PFORMAT_STRING pFormat)
 {
     DWORD size;
     switch(*pFormat)
diff --git a/dlls/rpcrt4/ndr_stubless.h b/dlls/rpcrt4/ndr_stubless.h
index fa8f9fc..9ea5636 100644
--- a/dlls/rpcrt4/ndr_stubless.h
+++ b/dlls/rpcrt4/ndr_stubless.h
@@ -253,6 +253,7 @@ enum stubless_phase
     STUBLESS_FREE
 };
 
+DWORD calc_arg_size(MIDL_STUB_MESSAGE *pStubMsg, PFORMAT_STRING pFormat);
 void client_do_args( PMIDL_STUB_MESSAGE pStubMsg, PFORMAT_STRING pFormat, enum stubless_phase phase,
                      BOOLEAN fpu_args, unsigned short number_of_params, unsigned char *pRetVal );
 PFORMAT_STRING convert_old_args( PMIDL_STUB_MESSAGE pStubMsg, PFORMAT_STRING pFormat,
