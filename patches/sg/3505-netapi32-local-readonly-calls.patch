@@ -415,8 +447,12 @@ NET_API_STATUS WINAPI NetScheduleJobGetInfo(LPCWSTR server, DWORD jobid, LPBYTE
 
 NET_API_STATUS WINAPI NetUseGetInfo(LMSTR server, LMSTR name, DWORD level, LPBYTE *bufptr)
 {
-    FIXME("stub (%p, %p, %ld, %p)\n", server, name, level, bufptr);
-    return ERROR_NOT_SUPPORTED;
+    TRACE("(%s, %s, %ld, %p)\n", debugstr_w(server), debugstr_w(name), level, bufptr);
+
+    if (!name || !bufptr) return ERROR_INVALID_PARAMETER;
+    if (level > 2) return ERROR_INVALID_LEVEL;
+    /* only the connections NetUseEnum lists are known */
+    return NERR_UseNotFound;
 
 }
 
@@ -450,10 +486,18 @@ NET_API_STATUS WINAPI NetSessionEnum(LMSTR servername, LMSTR UncClientName,
     LMSTR username, DWORD level, LPBYTE* bufptr, DWORD prefmaxlen, LPDWORD entriesread,
     LPDWORD totalentries, LPDWORD resume_handle)
 {
-    FIXME("Stub (%s %s %s %ld %p %ld %p %p %p)\n", debugstr_w(servername),
+    TRACE("(%s %s %s %ld %p %ld %p %p %p)\n", debugstr_w(servername),
         debugstr_w(UncClientName), debugstr_w(username),
         level, bufptr, prefmaxlen, entriesread, totalentries, resume_handle);
 
+    if (!bufptr || !entriesread || !totalentries) return ERROR_INVALID_PARAMETER;
+    if (level != 0 && level != 1 && level != 2 && level != 10 && level != 502) return ERROR_INVALID_LEVEL;
+
+    /* nobody is connected to this machine's shares */
+    *bufptr = NULL;
+    *entriesread = 0;
+    *totalentries = 0;
+    if (resume_handle) *resume_handle = 0;
     return NERR_Success;
 }
 
@@ -477,10 +521,23 @@ NET_API_STATUS WINAPI NetSessionEnum(LMSTR servername, LMSTR UncClientName,
 NET_API_STATUS WINAPI NetShareEnum( LMSTR servername, DWORD level, LPBYTE* bufptr,
     DWORD prefmaxlen, LPDWORD entriesread, LPDWORD totalentries, LPDWORD resume_handle)
 {
-    FIXME("Stub (%s %ld %p %ld %p %p %p)\n", debugstr_w(servername), level, bufptr,
+    TRACE("(%s %ld %p %ld %p %p %p)\n", debugstr_w(servername), level, bufptr,
         prefmaxlen, entriesread, totalentries, resume_handle);
 
-    return ERROR_NOT_SUPPORTED;
+    if (!bufptr || !entriesread || !totalentries) return ERROR_INVALID_PARAMETER;
+    if (level != 0 && level != 1 && level != 2 && level != 502 && level != 503) return ERROR_INVALID_LEVEL;
+    if (servername && servername[0] && !NETAPI_IsLocalComputer( servername ))
+    {
+        FIXME("remote computers not supported\n");
+        return ERROR_NOT_SUPPORTED;
+    }
+
+    /* no share is exported from here */
+    *bufptr = NULL;
+    *entriesread = 0;
+    *totalentries = 0;
+    if (resume_handle) *resume_handle = 0;
+    return NERR_Success;
 }
 
