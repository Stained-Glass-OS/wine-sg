From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] netapi32: local read-only calls that were stubs (3505)

netapi32: local read-only calls that were stubs

NetRemoteTOD, NetSessionEnum, NetShareEnum, NetFileEnum (empty for the local computer), NetServerDiskEnum
(the fixed drives), NetWkstaUserEnum (the current user), NetUseGetInfo, DsGetSiteNameA/W (no site outside a
domain), DsGetDcNameA (through DsGetDcNameW). Account and group management is left alone (ESCALATE.md).
---
--- a/dlls/netapi32/netapi32.c
+++ b/dlls/netapi32/netapi32.c
@@ -165,10 +165,42 @@ NET_API_STATUS WINAPI NetServerDiskEnum(
     LPDWORD totalentries,
     LPDWORD Resume_Handle)
 {
-    FIXME("Stub (%s %ld %p %ld %p %p %p)\n", debugstr_w(ServerName),
-     Level, Bufptr, PrefMaxlen, EntriesRead, totalentries, Resume_Handle);
+    WCHAR drives[256], *p;
+    DWORD count = 0, i = 0;
+    WCHAR *out;
 
-    return ERROR_NO_BROWSER_SERVERS_FOUND;
+    TRACE("(%s %ld %p %ld %p %p %p)\n", debugstr_w(ServerName), Level, Bufptr, PrefMaxlen, EntriesRead,
+          totalentries, Resume_Handle);
+
+    if (!Bufptr || !EntriesRead || !totalentries) return ERROR_INVALID_PARAMETER;
+    if (Level != 0) return ERROR_INVALID_LEVEL;
+    if (ServerName && ServerName[0] && !NETAPI_IsLocalComputer( ServerName ))
+    {
+        FIXME("remote computers not supported\n");
+        return ERROR_NOT_SUPPORTED;
+    }
+
+    if (!GetLogicalDriveStringsW( ARRAY_SIZE(drives), drives )) return GetLastError();
+    for (p = drives; *p; p += lstrlenW( p ) + 1)
+        if (GetDriveTypeW( p ) == DRIVE_FIXED) count++;
+
+    /* each disk is "X:" and a null, three characters, and an empty one ends the list */
+    if (NetApiBufferAllocate( (count + 1) * 3 * sizeof(WCHAR), (void **)&out )) return ERROR_NOT_ENOUGH_MEMORY;
+    for (p = drives; *p; p += lstrlenW( p ) + 1)
+    {
+        if (GetDriveTypeW( p ) != DRIVE_FIXED) continue;
+        out[i * 3] = p[0];
+        out[i * 3 + 1] = ':';
+        out[i * 3 + 2] = 0;
+        i++;
+    }
+    out[count * 3] = out[count * 3 + 1] = out[count * 3 + 2] = 0;
+
+    *Bufptr = (LPBYTE)out;
+    *EntriesRead = count;
+    *totalentries = count;
+    if (Resume_Handle) *Resume_Handle = 0;
+    return NERR_Success;
 }
 
