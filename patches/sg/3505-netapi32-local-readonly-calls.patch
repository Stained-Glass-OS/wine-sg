+    if (servername && servername[0] && !NETAPI_IsLocalComputer( servername ))
+    {
+        FIXME("remote computers not supported\n");
+        return ERROR_NOT_SUPPORTED;
+    }
+
+    /* the one user of this session */
+    if ((ret = NetWkstaUserGetInfo( NULL, level, bufptr ))) return ret;
+    *entriesread = 1;
+    *totalentries = 1;
+    if (resumehandle) *resumehandle = 0;
+    return NERR_Success;
 }
 
