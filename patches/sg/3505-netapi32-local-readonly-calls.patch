@@ -2967,8 +3125,51 @@ NET_API_STATUS NET_API_FUNCTION NetRemoteTOD(
     LPCWSTR servername,
     LPBYTE *buf)
 {
-    FIXME("(%s %p) stub!\n", debugstr_w(servername), buf);
-    return ERROR_NO_BROWSER_SERVERS_FOUND;
+    TIME_OF_DAY_INFO *tod;
+    TIME_ZONE_INFORMATION tz;
+    SYSTEMTIME st;
+    FILETIME ft;
+    ULONGLONG t;
+    DWORD ret;
+
+    TRACE("(%s %p)\n", debugstr_w(servername), buf);
+
+    if (!buf) return ERROR_INVALID_PARAMETER;
+    if (servername && servername[0] && !NETAPI_IsLocalComputer( servername ))
+    {
+        FIXME("remote computers not supported\n");
+        return ERROR_NO_BROWSER_SERVERS_FOUND;
+    }
+
+    if (NetApiBufferAllocate( sizeof(*tod), (void **)&tod )) return ERROR_NOT_ENOUGH_MEMORY;
+
+    GetSystemTime( &st );
+    SystemTimeToFileTime( &st, &ft );
+    t = ((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    tod->tod_elapsedt = (DWORD)((t - 116444736000000000ULL) / 10000000);
+    tod->tod_msecs = GetTickCount();
+    /* the fields are Greenwich time, the time zone says how far the clock here is from it */
+    tod->tod_hours = st.wHour;
+    tod->tod_mins = st.wMinute;
+    tod->tod_secs = st.wSecond;
+    tod->tod_hunds = st.wMilliseconds / 10;
+    ret = GetTimeZoneInformation( &tz );
+    if (ret == TIME_ZONE_ID_INVALID) tod->tod_timezone = -1;
+    else
+    {
+        LONG bias = tz.Bias;
+        if (ret == TIME_ZONE_ID_DAYLIGHT) bias += tz.DaylightBias;
+        else bias += tz.StandardBias;
+        tod->tod_timezone = bias;
+    }
+    tod->tod_tinterval = 310;
+    tod->tod_day = st.wDay;
+    tod->tod_month = st.wMonth;
+    tod->tod_year = st.wYear;
+    tod->tod_weekday = st.wDayOfWeek;
+
+    *buf = (LPBYTE)tod;
+    return NERR_Success;
 }
 
