@@ -2612,22 +2701,91 @@ DWORD WINAPI DsGetDcNameA(LPCSTR ComputerName, LPCSTR AvoidDCName,
  GUID* DomainGuid, LPCSTR SiteName, ULONG Flags,
  PDOMAIN_CONTROLLER_INFOA *DomainControllerInfo)
 {
-    FIXME("(%s, %s, %s, %s, %08lx, %p): stub\n", debugstr_a(ComputerName),
+    WCHAR *computer = NULL, *domain = NULL, *site = NULL;
+    DOMAIN_CONTROLLER_INFOW *infow = NULL;
+    DOMAIN_CONTROLLER_INFOA *infoa;
+    DWORD ret, size;
+    char *p;
+
+    TRACE("(%s, %s, %s, %s, %08lx, %p)\n", debugstr_a(ComputerName),
      debugstr_a(AvoidDCName), debugstr_guid(DomainGuid),
      debugstr_a(SiteName), Flags, DomainControllerInfo);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+
+    if (!DomainControllerInfo) return ERROR_INVALID_PARAMETER;
+
+#define TO_WIDE(dst, src) \
+    if (src) \
+    { \
+        int len = MultiByteToWideChar( CP_ACP, 0, src, -1, NULL, 0 ); \
+        if (!(dst = malloc( len * sizeof(WCHAR) ))) { ret = ERROR_NOT_ENOUGH_MEMORY; goto done; } \
+        MultiByteToWideChar( CP_ACP, 0, src, -1, dst, len ); \
+    }
+    ret = ERROR_SUCCESS;
+    TO_WIDE(computer, ComputerName)
+    TO_WIDE(domain, AvoidDCName)
+    TO_WIDE(site, SiteName)
+#undef TO_WIDE
+
+    /* the second argument is the name of the domain */
+    if ((ret = DsGetDcNameW( computer, domain, DomainGuid, site, Flags, &infow ))) goto done;
+
+#define NARROW_LEN(str) ((str) ? WideCharToMultiByte( CP_ACP, 0, str, -1, NULL, 0, NULL, NULL ) : 0)
+    size = sizeof(*infoa) + NARROW_LEN(infow->DomainControllerName) + NARROW_LEN(infow->DomainControllerAddress) +
+           NARROW_LEN(infow->DomainName) + NARROW_LEN(infow->DnsForestName) + NARROW_LEN(infow->DcSiteName) +
+           NARROW_LEN(infow->ClientSiteName);
+    if (NetApiBufferAllocate( size, (void **)&infoa ))
+    {
+        ret = ERROR_NOT_ENOUGH_MEMORY;
+        goto done;
+    }
+    p = (char *)(infoa + 1);
+#define NARROW(field) \
+    if (infow->field) \
+    { \
+        int len = NARROW_LEN(infow->field); \
+        infoa->field = p; \
+        WideCharToMultiByte( CP_ACP, 0, infow->field, -1, p, len, NULL, NULL ); \
+        p += len; \
+    } \
+    else infoa->field = NULL;
+    NARROW(DomainControllerName)
+    NARROW(DomainControllerAddress)
+    NARROW(DomainName)
+    NARROW(DnsForestName)
+    NARROW(DcSiteName)
+    NARROW(ClientSiteName)
+#undef NARROW
+#undef NARROW_LEN
+    infoa->DomainControllerAddressType = infow->DomainControllerAddressType;
+    infoa->DomainGuid = infow->DomainGuid;
+    infoa->Flags = infow->Flags;
+    *DomainControllerInfo = infoa;
+
+done:
+    if (infow) NetApiBufferFree( infow );
+    free( computer );
+    free( domain );
+    free( site );
+    return ret;
 }
 
 DWORD WINAPI DsGetSiteNameW(LPCWSTR ComputerName, LPWSTR *SiteName)
 {
-    FIXME("(%s, %p): stub\n", debugstr_w(ComputerName), SiteName);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    TRACE("(%s, %p)\n", debugstr_w(ComputerName), SiteName);
