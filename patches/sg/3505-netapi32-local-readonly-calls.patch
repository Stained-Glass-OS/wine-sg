+    return ERROR_NO_SITENAME;
 }
 
 DWORD WINAPI DsGetSiteNameA(LPCSTR ComputerName, LPSTR *SiteName)
 {
-    FIXME("(%s, %p): stub\n", debugstr_a(ComputerName), SiteName);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    TRACE("(%s, %p)\n", debugstr_a(ComputerName), SiteName);
+
+    if (!SiteName) return ERROR_INVALID_PARAMETER;
+    *SiteName = NULL;
+    return ERROR_NO_SITENAME;
 }
 
