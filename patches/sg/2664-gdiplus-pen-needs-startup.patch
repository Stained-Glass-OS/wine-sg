From: Stained Glass OS <ke7oxh@gmail.com>
gdiplus: GdipCreatePen1 needs GdiplusStartup

GdiplusStartup and GdiplusShutdown keep a count of startups in force and
GdipCreatePen1 returns GdiplusNotInitialized without one, as the Wine test
records from native. Removes the todo_wine mark of that test.
---
--- a/dlls/gdiplus/gdiplus.c
+++ b/dlls/gdiplus/gdiplus.c
@@ -80,6 +80,9 @@ BOOL WINAPI DllMain(HINSTANCE hinst, DWORD reason, LPVOID reserved)
 /*****************************************************
  *      GdiplusStartup [GDIPLUS.@]
  */
+/* Startups not yet shut down */
+LONG gdiplus_init_count;
+
 Status WINAPI GdiplusStartup(ULONG_PTR *token, const struct GdiplusStartupInput *input,
                              struct GdiplusStartupOutput *output)
 {
@@ -103,6 +106,7 @@ Status WINAPI GdiplusStartup(ULONG_PTR *token, const struct GdiplusStartupInput
     }
 
     *token = 0xdeadbeef;
+    InterlockedIncrement(&gdiplus_init_count);
 
     /* FIXME: DebugEventCallback ignored */
 
@@ -132,6 +136,9 @@ ULONG WINAPI GdiplusShutdown_wrapper(ULONG_PTR token)
 
     /* FIXME: no object tracking */
 
+    if (gdiplus_init_count > 0)
+        InterlockedDecrement(&gdiplus_init_count);
+
     /* "bricksntiles" expects a return value of 0, which native
      * coincidentally gives.
      */
--- a/dlls/gdiplus/gdiplus_private.h
+++ b/dlls/gdiplus/gdiplus_private.h
@@ -54,6 +54,7 @@
 
 COLORREF ARGB2COLORREF(ARGB color);
 HBITMAP ARGB2BMP(ARGB color);
+extern LONG gdiplus_init_count;
 extern INT arc2polybezier(GpPointF * points, REAL x1, REAL y1, REAL x2, REAL y2,
     REAL startAngle, REAL sweepAngle);
 extern REAL gdiplus_atan2(REAL dy, REAL dx);
--- a/dlls/gdiplus/pen.c
+++ b/dlls/gdiplus/pen.c
@@ -151,6 +151,11 @@ GpStatus WINGDIPAPI GdipCreatePen1(ARGB color, REAL width, GpUnit unit,
 
     TRACE("(%lx, %.2f, %d, %p)\n", color, width, unit, pen);
 
+#ifndef SG_MUTANT_GP_NO_INIT_CHECK
+    /* the pen needs GdiplusStartup to have been called (and not undone) */
+    if (!gdiplus_init_count)
+        return GdiplusNotInitialized;
+#endif
     GdipCreateSolidFill(color, (GpSolidFill **)(&brush));
     status = GdipCreatePen2(brush, width, unit, pen);
     GdipDeleteBrush(brush);
--- a/dlls/gdiplus/tests/pen.c
+++ b/dlls/gdiplus/tests/pen.c
@@ -62,8 +62,7 @@ static void test_startup(void)
 
     status = GdipCreatePen1((ARGB)0xffff00ff, 10.0f, UnitPixel, &pen);
 
-    todo_wine
-        expect(GdiplusNotInitialized, status);
+    expect(GdiplusNotInitialized, status);
 
     GdipDeletePen(pen);
 }
