From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: message behaviours recorded from Windows by Wine's tests (todo_wine removed)

Six todo_wine checks in crypt32's message tests record what real Windows does;
they pass now and the marks are gone.

- CryptVerifyDetachedMessageHash given nothing to hash and no computed hash to
  give back has nothing to check and succeeds; asking for the computed hash
  still checks it.
- CryptVerifyMessageHash of a hashed message that carries no content succeeds
  (CryptMsgControl(CMSG_CTRL_VERIFY_HASH) on the same message still fails).
- Once the hash or the signature of a detached message has been checked, the
  data can no longer be added: CRYPT_E_MSG_ERROR.
- CryptHashMessage sizes a one-piece (not detached) message from several
  pieces; making the message from them still fails with CRYPT_E_MSG_ERROR.
- CryptSignMessage without a signing certificate makes a signed message with
  no signers instead of returning an empty size.
---
--- a/dlls/crypt32/crypt32_private.h
+++ b/dlls/crypt32/crypt32_private.h
@@ -534,3 +534,7 @@ enum unix_funcs
 #define SG_CERT_STORE_CTRL_CHECK_RESYNC 0x53470001
 
 #endif
+
+/* msg.c, for message.c: the address passed as the control parameter of CMSG_CTRL_VERIFY_HASH
+ * when a hashed message without any content is to verify */
+extern const int crypt32_hash_may_lack_content;
--- a/dlls/crypt32/message.c
+++ b/dlls/crypt32/message.c
@@ -21,6 +21,7 @@
 #include "winbase.h"
 #include "wincrypt.h"
 
+#include "crypt32_private.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(crypt);
@@ -291,8 +292,37 @@ BOOL WINAPI CryptHashMessage(PCRYPT_HASH_MESSAGE_PARA pHashPara,
      &info, NULL, NULL);
     if (msg)
     {
-        for (i = 0, ret = TRUE; ret && i < cToBeHashed; i++)
-            ret = CryptMsgUpdate(msg, rgpbToBeHashed[i], rgcbToBeHashed[i], i == cToBeHashed - 1);
+#ifdef SG_MUTANT_MSG_HASHSIZE
+        if (0)
+#else
+        if (!pbHashedBlob && !fDetachedHash && cToBeHashed > 1)
+#endif
+        {
+            /* Windows sizes a one-piece message from all the pieces; only
+             * asking for the message itself fails (see the test). */
+            DWORD total = 0, off = 0;
+            BYTE *all;
+
+            for (i = 0; i < cToBeHashed; i++) total += rgcbToBeHashed[i];
+            if ((all = CryptMemAlloc(total ? total : 1)))
+            {
+                for (i = 0; i < cToBeHashed; i++)
+                {
+                    memcpy(all + off, rgpbToBeHashed[i], rgcbToBeHashed[i]);
+                    off += rgcbToBeHashed[i];
+                }
+                ret = CryptMsgUpdate(msg, all, total, TRUE);
+                CryptMemFree(all);
+            }
+            else
+            {
+                SetLastError(ERROR_OUTOFMEMORY);
+                ret = FALSE;
+            }
+        }
+        else
+            for (i = 0, ret = TRUE; ret && i < cToBeHashed; i++)
+                ret = CryptMsgUpdate(msg, rgpbToBeHashed[i], rgcbToBeHashed[i], i == cToBeHashed - 1);
         if (ret)
         {
             ret = CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, pbHashedBlob,
@@ -351,7 +381,12 @@ BOOL WINAPI CryptVerifyDetachedMessageHash(PCRYPT_HASH_MESSAGE_PARA pHashPara,
         }
         if (ret)
         {
-            ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_HASH, NULL);
+            /* Given no data to hash and no hash to give back, Windows has
+             * nothing to check and succeeds (test_verify_detached_message_hash). */
+#ifndef SG_MUTANT_MSG_DETACHEDCHK
+            if (cToBeHashed || pcbComputedHash)
+#endif
+                ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_HASH, NULL);
             if (ret && pcbComputedHash)
                 ret = CryptMsgGetParam(msg, CMSG_COMPUTED_HASH_PARAM, 0,
                  pbComputedHash, pcbComputedHash);
@@ -390,7 +425,7 @@ BOOL WINAPI CryptVerifyMessageHash(PCRYPT_HASH_MESSAGE_PARA pHashPara,
         ret = CryptMsgUpdate(msg, pbHashedBlob, cbHashedBlob, TRUE);
         if (ret)
         {
-            ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_HASH, NULL);
+            ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_HASH, (void *)&crypt32_hash_may_lack_content);
             if (ret && pcbToBeHashed)
                 ret = CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0,
                  pbToBeHashed, pcbToBeHashed);
@@ -427,30 +462,37 @@ BOOL WINAPI CryptSignMessage(PCRYPT_SIGN_MESSAGE_PARA pSignPara,
         SetLastError(E_INVALIDARG);
         return FALSE;
     }
-    if (!pSignPara->pSigningCert)
-        return TRUE;
-
-    ret = CryptAcquireCertificatePrivateKey(pSignPara->pSigningCert,
-     CRYPT_ACQUIRE_CACHE_FLAG, NULL, &hCryptProv, &keySpec, &freeProv);
-    if (!ret)
-        return FALSE;
-
     memset(&signer, 0, sizeof(signer));
-    signer.cbSize = sizeof(signer);
-    signer.pCertInfo = pSignPara->pSigningCert->pCertInfo;
-    signer.hCryptProv = hCryptProv;
-    signer.dwKeySpec = keySpec;
-    signer.HashAlgorithm = pSignPara->HashAlgorithm;
-    signer.pvHashAuxInfo = pSignPara->pvHashAuxInfo;
-    signer.cAuthAttr = pSignPara->cAuthAttr;
-    signer.rgAuthAttr = pSignPara->rgAuthAttr;
-    signer.cUnauthAttr = pSignPara->cUnauthAttr;
-    signer.rgUnauthAttr = pSignPara->rgUnauthAttr;
-
     memset(&signInfo, 0, sizeof(signInfo));
     signInfo.cbSize = sizeof(signInfo);
-    signInfo.cSigners = 1;
-    signInfo.rgSigners = &signer;
+    hCryptProv = 0;
+    ret = TRUE;
+    /* Without a signing certificate Windows still makes a message, one with
+     * no signers (and the certificates and CRLs asked for). */
+#ifdef SG_MUTANT_MSG_NOSIGNER
+    if (!pSignPara->pSigningCert) return TRUE;
+#endif
+    if (pSignPara->pSigningCert)
+    {
+        ret = CryptAcquireCertificatePrivateKey(pSignPara->pSigningCert,
+         CRYPT_ACQUIRE_CACHE_FLAG, NULL, &hCryptProv, &keySpec, &freeProv);
+        if (!ret)
+            return FALSE;
+
+        signer.cbSize = sizeof(signer);
+        signer.pCertInfo = pSignPara->pSigningCert->pCertInfo;
+        signer.hCryptProv = hCryptProv;
+        signer.dwKeySpec = keySpec;
+        signer.HashAlgorithm = pSignPara->HashAlgorithm;
+        signer.pvHashAuxInfo = pSignPara->pvHashAuxInfo;
+        signer.cAuthAttr = pSignPara->cAuthAttr;
+        signer.rgAuthAttr = pSignPara->rgAuthAttr;
+        signer.cUnauthAttr = pSignPara->cUnauthAttr;
+        signer.rgUnauthAttr = pSignPara->rgUnauthAttr;
+
+        signInfo.cSigners = 1;
+        signInfo.rgSigners = &signer;
+    }
 
     if (pSignPara->cMsgCert)
     {
--- a/dlls/crypt32/msg.c
+++ b/dlls/crypt32/msg.c
@@ -2084,6 +2084,8 @@ typedef struct _CDecodeMsg
     CRYPT_DATA_BLOB        msg_data;
     CRYPT_DATA_BLOB        detached_data;
     CONTEXT_PROPERTY_LIST *properties;
+    BOOL                   no_content;  /* a hashed message that carries no content to check */
+    BOOL                   verified;    /* a hash or signature check has been asked for */
 } CDecodeMsg;
 
 static void CDecodeMsg_Close(HCRYPTMSG hCryptMsg)
@@ -2226,8 +2228,11 @@ static BOOL CDecodeMsg_DecodeHashedContent(CDecodeMsg *msg,
                 CDecodeMsg_DecodeDataContent(msg,
                  &digestedData->ContentInfo.Content);
             else
+            {
                 ContextPropertyList_SetProperty(msg->properties,
                  CMSG_CONTENT_PARAM, NULL, 0);
+                msg->no_content = TRUE;
+            }
         }
         ContextPropertyList_SetProperty(msg->properties, CMSG_HASH_DATA_PARAM,
          digestedData->hash.pbData, digestedData->hash.cbData);
@@ -2469,6 +2474,11 @@ static BOOL CDecodeMsg_Update(HCRYPTMSG hCryptMsg, const BYTE *pbData,
 
     if (msg->base.state == MsgStateFinalized)
         SetLastError(CRYPT_E_MSG_ERROR);
+#ifndef SG_MUTANT_MSG_NOLATEUPDATE
+    /* the hash or signature has been checked: the data can no longer be added */
+    else if (msg->verified && msg->base.state == MsgStateDataFinalized)
+        SetLastError(CRYPT_E_MSG_ERROR);
+#endif
     else if (msg->base.streamed)
     {
         FIXME("(%p, %p, %ld, %d): streamed update stub\n", hCryptMsg, pbData,
@@ -3269,13 +3279,22 @@ static BOOL CDecodeMsg_GetParam(HCRYPTMSG hCryptMsg, DWORD dwParamType,
     return ret;
 }
 
-static BOOL CDecodeHashMsg_VerifyHash(CDecodeMsg *msg)
+const int crypt32_hash_may_lack_content = 0;
+
+static BOOL CDecodeHashMsg_VerifyHash(CDecodeMsg *msg, BOOL allow_no_content)
 {
     BOOL ret;
     CRYPT_DATA_BLOB hashBlob;
 
     ret = ContextPropertyList_FindProperty(msg->properties,
      CMSG_HASH_DATA_PARAM, &hashBlob);
+    /* CryptVerifyMessageHash passes crypt32_hash_may_lack_content: a hashed
+     * message that carries no content at all verifies there, as on Windows,
+     * while CryptMsgControl itself still fails it. */
+#ifndef SG_MUTANT_MSG_VERIFYEMPTY
+    if (ret && msg->no_content && allow_no_content)
+        return TRUE;
+#endif
     if (ret)
     {
         DWORD computedHashSize = 0;
@@ -3575,6 +3594,9 @@ static BOOL CDecodeMsg_Control(HCRYPTMSG hCryptMsg, DWORD dwFlags,
     CDecodeMsg *msg = hCryptMsg;
     BOOL ret = FALSE;
 
+    if (dwCtrlType == CMSG_CTRL_VERIFY_HASH || dwCtrlType == CMSG_CTRL_VERIFY_SIGNATURE ||
+        dwCtrlType == CMSG_CTRL_VERIFY_SIGNATURE_EX)
+        msg->verified = TRUE;
     switch (dwCtrlType)
     {
     case CMSG_CTRL_VERIFY_SIGNATURE:
@@ -3605,7 +3627,7 @@ static BOOL CDecodeMsg_Control(HCRYPTMSG hCryptMsg, DWORD dwFlags,
         switch (msg->type)
         {
         case CMSG_HASHED:
-            ret = CDecodeHashMsg_VerifyHash(msg);
+            ret = CDecodeHashMsg_VerifyHash(msg, pvCtrlPara == &crypt32_hash_may_lack_content);
             break;
         default:
             SetLastError(CRYPT_E_INVALID_MSG_TYPE);
@@ -3655,6 +3677,8 @@ HCRYPTMSG WINAPI CryptMsgOpenToDecode(DWORD dwMsgEncodingType, DWORD dwFlags,
         msg->msg_data.pbData = NULL;
         msg->detached_data.cbData = 0;
         msg->detached_data.pbData = NULL;
+        msg->no_content = FALSE;
+        msg->verified = FALSE;
         msg->properties = ContextPropertyList_Create();
     }
     return msg;
--- a/dlls/crypt32/tests/message.c
+++ b/dlls/crypt32/tests/message.c
@@ -138,7 +138,6 @@ static void test_verify_detached_message_hash(void)
     /* Curiously, passing no data to hash succeeds.. */
     ret = CryptVerifyDetachedMessageHash(&para, detachedHashContent,
      sizeof(detachedHashContent), 0, NULL, NULL, NULL, NULL);
-    todo_wine
     ok(ret, "CryptVerifyDetachedMessageHash failed: %08lx\n", GetLastError());
     /* as does passing the actual content of the message to hash.. */
     size = sizeof(msgData);
@@ -217,7 +216,6 @@ static void test_verify_message_hash(void)
     /* Verifying the hash of a detached message succeeds? */
     ret = CryptVerifyMessageHash(&para, detachedHashContent,
      sizeof(detachedHashContent), NULL, NULL, NULL, NULL);
-    todo_wine
     ok(ret, "CryptVerifyMessageHash failed: %08lx\n", GetLastError());
     /* As does verifying the hash of a regular message. */
     ret = CryptVerifyMessageHash(&para, hashContent, sizeof(hashContent),
@@ -681,7 +679,6 @@ static void test_hash_message(void)
     SetLastError(0xdeadbeef);
     ret = CryptHashMessage(&para, FALSE, 2, toHash, hashSize, NULL,
      &hashedBlobSize, NULL, NULL);
-    todo_wine
     ok(ret, "CryptHashMessage failed: 0x%08lx\n", GetLastError());
     if (ret)
     {
@@ -981,7 +978,6 @@ static void test_sign_message(void)
     signedBlobSize = 0;
     ret = CryptSignMessage(&para, FALSE, 0, NULL, NULL, NULL, &signedBlobSize);
     ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
-    todo_wine
     ok(signedBlobSize, "bad size\n");
 
     SetLastError(0xdeadbeef);
--- a/dlls/crypt32/tests/msg.c
+++ b/dlls/crypt32/tests/msg.c
@@ -3191,7 +3191,6 @@ static void test_msg_control(void)
      */
     SetLastError(0xdeadbeef);
     ret = CryptMsgUpdate(msg, msgData, sizeof(msgData), TRUE);
-    todo_wine
     ok(!ret && (GetLastError() == NTE_BAD_HASH_STATE || GetLastError() == CRYPT_E_MSG_ERROR), /* Vista */
      "Expected NTE_BAD_HASH_STATE or NTE_BAD_ALGID or CRYPT_E_MSG_ERROR, "
      "got %08lx\n", GetLastError());
@@ -3342,7 +3341,6 @@ static void test_msg_control(void)
     /* Now that the signature's been checked, can't do the final update */
     SetLastError(0xdeadbeef);
     ret = CryptMsgUpdate(msg, msgData, sizeof(msgData), TRUE);
-    todo_wine
     ok(!ret && (GetLastError() == NTE_BAD_HASH_STATE || GetLastError() == CRYPT_E_MSG_ERROR), /* Vista */
      "expected NTE_BAD_HASH_STATE or CRYPT_E_MSG_ERROR, got %08lx\n", GetLastError());
     CryptMsgClose(msg);
