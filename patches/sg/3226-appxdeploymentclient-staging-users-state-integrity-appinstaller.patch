+/* ---- what the list shows of an application ---------------------------------------- */
+
+struct display_info
+{
+    IAppDisplayInfo IAppDisplayInfo_iface;
+    LONG ref;
+    WCHAR *display_name, *description, *folder, *logo_small, *logo_large;
+};
+
+static inline struct display_info *impl_from_IAppDisplayInfo( IAppDisplayInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct display_info, IAppDisplayInfo_iface );
+}
+
+static HRESULT WINAPI display_QueryInterface( IAppDisplayInfo *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAppDisplayInfo ))
+    {
+        *out = iface;
+        IAppDisplayInfo_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI display_AddRef( IAppDisplayInfo *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppDisplayInfo( iface )->ref );
+}
+
+static ULONG WINAPI display_Release( IAppDisplayInfo *iface )
+{
+    struct display_info *impl = impl_from_IAppDisplayInfo( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        free( impl->display_name );
+        free( impl->description );
+        free( impl->folder );
+        free( impl->logo_small );
+        free( impl->logo_large );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI display_GetIids( IAppDisplayInfo *iface, ULONG *count, IID **iids )
