+/* The logo that fits: the small one for a size up to 44 pixels, the large one for more; the other
+ * when the manifest has only one.  The stream reference is the StorageFile of the image. */
+static HRESULT WINAPI display_GetLogo( IAppDisplayInfo *iface, Size size, IRandomAccessStreamReference **value )
+{
+    struct display_info *impl = impl_from_IAppDisplayInfo( iface );
+    const WCHAR *logo = (size.Width <= 44.0f && size.Height <= 44.0f) ? impl->logo_small : impl->logo_large;
+    IStorageFileStatics *statics;
+    IAsyncOperation_StorageFile *operation;
+    IAsyncInfo *info;
+    IStorageFile *file = NULL;
+    HSTRING path, class_name;
+    WCHAR full[MAX_PATH];
+    AsyncStatus status = Started;
+    HRESULT hr;
+    int i;
+
+    TRACE( "iface %p, size %fx%f, value %p.\n", iface, size.Width, size.Height, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!logo) logo = impl->logo_small ? impl->logo_small : impl->logo_large;
+    if (!logo || !impl->folder) return E_FAIL;
+    swprintf( full, ARRAY_SIZE(full), L"%s\\%s", impl->folder, logo );
+    for (i = 0; full[i]; i++) if (full[i] == '/') full[i] = '\\';
+#ifdef SG_MUTANT_AX_LOGO
+    return E_FAIL;
+#endif
+    if (GetFileAttributesW( full ) == INVALID_FILE_ATTRIBUTES) return HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+
+    if (FAILED(hr = WindowsCreateString( RuntimeClass_Windows_Storage_StorageFile,
+                                         wcslen( RuntimeClass_Windows_Storage_StorageFile ), &class_name ))) return hr;
+    hr = RoGetActivationFactory( class_name, &IID_IStorageFileStatics, (void **)&statics );
+    WindowsDeleteString( class_name );
+    if (FAILED(hr)) return hr;
+    if (SUCCEEDED(hr = WindowsCreateString( full, wcslen( full ), &path )))
+    {
+        hr = IStorageFileStatics_GetFileFromPathAsync( statics, path, &operation );
+        WindowsDeleteString( path );
+    }
+    IStorageFileStatics_Release( statics );
+    if (FAILED(hr)) return hr;
+
+    /* the file is opened by the time the call returns, or soon after */
+    if (SUCCEEDED(hr = IAsyncOperation_StorageFile_QueryInterface( operation, &IID_IAsyncInfo, (void **)&info )))
+    {
+        for (i = 0; i < 200 && SUCCEEDED(IAsyncInfo_get_Status( info, &status )) && status == Started; i++) Sleep( 10 );
+        IAsyncInfo_Release( info );
+    }
+    if (SUCCEEDED(hr) && status == Completed) hr = IAsyncOperation_StorageFile_GetResults( operation, &file );
+    else if (SUCCEEDED(hr)) hr = E_FAIL;
+    IAsyncOperation_StorageFile_Release( operation );
+    if (FAILED(hr)) return hr;
+
+    hr = IStorageFile_QueryInterface( file, &IID_IRandomAccessStreamReference, (void **)value );
+    IStorageFile_Release( file );
+    return hr;
+}
