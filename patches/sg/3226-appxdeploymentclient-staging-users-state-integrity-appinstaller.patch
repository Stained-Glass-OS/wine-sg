+static BOOL collect_dependent_folders( struct package_record *rec, void *context )
+{
+    struct dependent_folders *d = context;
+
+    if (multi_contains( rec->dependencies, d->full_name ) && rec->install_location) strlist_add( &d->folders, rec->install_location );
+    return TRUE;
