+HRESULT stage_user_data_work( const WCHAR *full_name, DeploymentOptions options, WCHAR **error_text )
+{
+    struct package_record rec;
+
+    TRACE( "package %s, options %#x\n", debugstr_w( full_name ), options );
+
+    if (!full_name[0] || wcschr( full_name, '\\' ))
+    {
+        set_error( error_text, L"Not a package full name", full_name );
+        return E_INVALIDARG;
+    }
+#ifndef SG_MUTANT_AX_STAGEUSER
+    if (!open_record( full_name, &rec, NULL ))
+    {
+        set_error( error_text, L"The package could not be found", full_name );
+        return 0x80073cf1; /* ERROR_INSTALL_PACKAGE_NOT_FOUND */
+    }
+    package_record_free( &rec );
+#endif
+    return S_OK;
