+struct find_users
+{
+    const WCHAR *full_name;
+    struct package_user *users;
+    UINT32 count;
+};
+
+static BOOL find_users_in_hive( const WCHAR *sid, HKEY packages, void *context )
+{
+    struct find_users *f = context;
+    struct package_user *grown;
+    DWORD value = 0, size = sizeof(value);
+    HKEY key;
+
+    if (RegOpenKeyExW( packages, f->full_name, 0, KEY_READ, &key )) return TRUE;
+    RegGetValueW( key, NULL, L"Staged", RRF_RT_REG_DWORD, NULL, &value, &size );
+    RegCloseKey( key );
+    if (!(grown = realloc( f->users, (f->count + 1) * sizeof(*grown) ))) return FALSE;
+    f->users = grown;
+    f->users[f->count].sid = wcsdup( sid );
+#ifdef SG_MUTANT_AX_USERSTATE
+    value = 0;
+#endif
+    f->users[f->count].state = value ? PackageInstallState_Staged : PackageInstallState_Installed;
+    f->count++;
+    return TRUE;
+}
+
+/* The users who have the package, from their profiles; an administrator's query. */
+HRESULT find_package_users( const WCHAR *full_name, struct package_user **users, UINT32 *count )
+{
+    struct find_users f = { full_name };
+
+    *users = NULL;
+    *count = 0;
+    if (!caller_is_admin()) return E_ACCESSDENIED;
+    if (full_name && full_name[0] && !wcschr( full_name, '\\' ) && wcslen( full_name ) <= 200)
+        for_each_hive( find_users_in_hive, &f );
+    *users = f.users;
+    *count = f.count;
+    return S_OK;
+}
