+static HRESULT WINAPI user_iterator_get_Current( IIterator_PackageUserInformation *iface, IPackageUserInformation **value )
+{
+    struct user_iterator *impl = impl_from_IIterator_PackageUserInformation( iface );
+    if (!value) return E_POINTER;
+    if (impl->index >= impl->list->count) { *value = NULL; return E_BOUNDS; }
+    IPackageUserInformation_AddRef( (*value = impl->list->users[impl->index]) );
+    return S_OK;
