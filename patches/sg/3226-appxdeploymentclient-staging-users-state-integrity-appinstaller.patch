+/* Clean up a package for a user whose profile is gone: the registration goes, and the files with
+ * it unless another user has the package. */
+HRESULT cleanup_user_work( const WCHAR *list, DeploymentOptions options, WCHAR **error_text )
+{
+    const WCHAR *sid = list + wcslen( list ) + 1;
+    WCHAR *mine = current_user_sid(), path[256];
+    struct strlist matches = { 0 };
+    BOOL is_me;
+    HKEY packages;
+    HRESULT hr = S_OK;
+    const WCHAR *p;
+
+    TRACE( "package %s, user %s\n", debugstr_w( list ), debugstr_w( sid ) );
+
+    if (!list[0] || wcschr( list, '\\' ))
+    {
+        set_error( error_text, L"Not a package name", list );
+        free( mine );
+        return E_INVALIDARG;
+    }
+    if (!sid[0]) sid = mine;
+    if (!sid ||
+#ifndef SG_MUTANT_AX_SIDCHECK
+        wcschr( sid, '\\' ) ||
+#endif
+        wcslen( sid ) > 100)
+    {
+        set_error( error_text, L"Not a user security identifier", sid );
+        free( mine );
+        return E_INVALIDARG;
+    }
+    is_me = mine && !wcsicmp( sid, mine );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", sid, packages_keyW );
+    if (is_me) { if (RegOpenKeyExW( HKEY_CURRENT_USER, packages_keyW, 0, KEY_READ | KEY_WRITE, &packages )) packages = NULL; }
+    else if (RegOpenKeyExW( HKEY_USERS, path, 0, KEY_READ | KEY_WRITE, &packages )) packages = NULL;
+
+    if (packages)
+    {
+        collect_user_records( packages, list, &matches );
+        for (p = matches.data; p && *p && SUCCEEDED(hr); p += wcslen( p ) + 1)
+        {
+            struct package_record rec = { 0 };
+            HKEY key;
+
+            if (is_me)
+            {
+                /* the caller's own: removed like RemovePackageAsync does it */
+                hr = remove_record( p, error_text );
+                continue;
+            }
+            if (!RegOpenKeyExW( packages, p, 0, KEY_READ, &key ))
+            {
+                read_record( key, p, &rec );
+                RegCloseKey( key );
+            }
+            RegDeleteTreeW( packages, p );
+#ifndef SG_MUTANT_AX_CLEANUPFILES
+            if (rec.install_location && !rec.development_mode && !other_users_have_besides( p, sid ))
+                delete_tree( rec.install_location );
+#endif
+            package_record_free( &rec );
+        }
+        RegCloseKey( packages );
+    }
+    free( matches.data );
+    free( mine );
+    return hr;
+}
