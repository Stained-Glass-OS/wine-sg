+/* The state of the package for every user; a tampered package's processes (and, for a framework,
+ * those of the packages that depend on it) are ended. */
+HRESULT set_package_state( const WCHAR *full_name, PackageState state )
+{
+    struct set_state st = { full_name, state };
+    struct package_record rec;
+
+    if (!full_name || !full_name[0] || wcschr( full_name, '\\' ) || wcslen( full_name ) > 200
+#ifndef SG_MUTANT_AX_STATEVAL
+        || (UINT32)state > PackageState_Tampered
+#endif
+        )
+        return E_INVALIDARG;
+    if (!caller_is_admin()) return E_ACCESSDENIED;
+    for_each_hive( set_state_in_hive, &st );
+    if (!st.found) return 0x80073cf1; /* ERROR_INSTALL_PACKAGE_NOT_FOUND */
+
+    if (state == PackageState_Tampered && open_record( full_name, &rec, NULL ))
+    {
+        struct dependent_folders d = { full_name };
+
+        if (rec.install_location) strlist_add( &d.folders, rec.install_location );
+        if (rec.framework) for_each_record( collect_dependent_folders, &d );
+        terminate_in_folders( &d.folders );
+        free( d.folders.data );
+        package_record_free( &rec );
+    }
+    return S_OK;
+}
