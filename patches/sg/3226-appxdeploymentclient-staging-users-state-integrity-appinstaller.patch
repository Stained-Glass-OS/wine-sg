+/* ---- the content of a package against its block map ----------------------------------------- */
+
+static int base64_value( WCHAR c )
+{
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '+') return 62;
+    if (c == '/') return 63;
+    return -1;
+}
+
+static int base64_decode( const WCHAR *str, BYTE *out, int size )
+{
+    int bits = 0, count = 0, n = 0, v;
+
+    for (; *str && *str != '='; str++)
+    {
+        if ((v = base64_value( *str )) < 0) return -1;
+        bits = (bits << 6) | v;
+        count += 6;
+        if (count >= 8)
+        {
+            count -= 8;
+            if (n >= size) return -1;
+            out[n++] = (bits >> count) & 0xff;
+        }
+    }
+    return n;
+}
+
+/* a file against the hashes of its blocks (SHA-256 of 64 KB each) */
+static BOOL verify_file( const WCHAR *root, const WCHAR *name, UINT64 size, const BYTE (*hashes)[32], UINT32 count )
+{
+    WCHAR path[MAX_PATH];
+    HCRYPTPROV prov = 0;
+    BYTE *buffer;
+    HANDLE file;
+    LARGE_INTEGER actual;
+    BOOL ok = FALSE;
+    UINT32 i;
+
+    if (!payload_path( root, name, path, ARRAY_SIZE(path) )) return FALSE;
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    if (!GetFileSizeEx( file, &actual ) ||
+#ifndef SG_MUTANT_AX_VERIFYSIZE
+        (UINT64)actual.QuadPart != size ||
+#endif
+        (UINT64)count != (size + 65535) / 65536)
+    {
+        CloseHandle( file );
+        return FALSE;
+    }
+    if (!(buffer = malloc( 65536 )) || !CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_AES, CRYPT_VERIFYCONTEXT ))
+    {
+        free( buffer );
+        CloseHandle( file );
+        return FALSE;
+    }
+    ok = TRUE;
+    for (i = 0; ok && i < count; i++)
+    {
+        HCRYPTHASH hash;
+        BYTE digest[32];
+        DWORD read = 0, len = sizeof(digest);
+
+        ok = ReadFile( file, buffer, 65536, &read, NULL ) && CryptCreateHash( prov, CALG_SHA_256, 0, 0, &hash );
+        if (!ok) break;
+#ifdef SG_MUTANT_AX_VERIFYHASH
+        CryptDestroyHash( hash );
+        continue;
+#endif
+        ok = CryptHashData( hash, buffer, read, 0 ) && CryptGetHashParam( hash, HP_HASHVAL, digest, &len, 0 ) &&
+             len == 32 && !memcmp( digest, hashes[i], 32 );
+        CryptDestroyHash( hash );
+    }
+    CryptReleaseContext( prov, 0 );
+    free( buffer );
+    CloseHandle( file );
+    return ok;
+}
+
+/* True when every file of the block map is there, as big as it says and with the hashes it has. */
+BOOL package_verify_content( const struct package_record *rec )
+{
+    WCHAR path[MAX_PATH];
+    IXmlReader *reader = NULL;
+    IStream *stream = NULL;
+    XmlNodeType type;
+    WCHAR *name = NULL;
+    BYTE (*hashes)[32] = NULL;
+    UINT32 count = 0, capacity = 0;
+    UINT64 size = 0;
+    BOOL ok = TRUE, in_file = FALSE;
+
+    if (!rec->install_location) return FALSE;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\AppxBlockMap.xml", rec->install_location );
+    /* a package registered from a folder has no block map: there is nothing to compare with */
+    if (GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES) return GetFileAttributesW( rec->install_location ) != INVALID_FILE_ATTRIBUTES;
+
+    if (FAILED(SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream ))) return FALSE;
+    if (FAILED(CreateXmlReader( &IID_IXmlReader, (void **)&reader, NULL )) ||
+        FAILED(IXmlReader_SetProperty( reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit )) ||
+        FAILED(IXmlReader_SetInput( reader, (IUnknown *)stream )))
+    {
+        if (reader) IXmlReader_Release( reader );
+        IStream_Release( stream );
+        return FALSE;
+    }
+
+    while (ok && IXmlReader_Read( reader, &type ) == S_OK)
+    {
+        const WCHAR *local, *value;
+
+        if (type == XmlNodeType_Element)
+        {
+            BOOL empty = IXmlReader_IsEmptyElement( reader );
+
+            IXmlReader_GetLocalName( reader, &local, NULL );
+            if (!wcscmp( local, L"File" ))
+            {
+                free( name );
+                name = NULL;
+                size = 0;
+                count = 0;
+                in_file = !empty;
+                if (SUCCEEDED(IXmlReader_MoveToAttributeByName( reader, L"Name", NULL )) &&
+                    SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL ))) name = wcsdup( value );
+                if (SUCCEEDED(IXmlReader_MoveToAttributeByName( reader, L"Size", NULL )) &&
+                    SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL ))) size = _wcstoui64( value, NULL, 10 );
+                if (empty) ok = name && verify_file( rec->install_location, name, size, hashes, 0 );
+            }
+            else if (!wcscmp( local, L"Block" ) && in_file)
+            {
+                BYTE hash[64];
+
+                if (count == capacity)
+                {
+                    BYTE (*grown)[32];
+                    capacity = capacity ? capacity * 2 : 16;
+                    if (!(grown = realloc( hashes, capacity * sizeof(*hashes) ))) { ok = FALSE; break; }
+                    hashes = grown;
+                }
+                if (FAILED(IXmlReader_MoveToAttributeByName( reader, L"Hash", NULL )) ||
+                    FAILED(IXmlReader_GetValue( reader, &value, NULL )) || base64_decode( value, hash, sizeof(hash) ) != 32)
+                {
+                    ok = FALSE;
+                    break;
+                }
+                memcpy( hashes[count++], hash, 32 );
+            }
+        }
+        else if (type == XmlNodeType_EndElement)
+        {
+            IXmlReader_GetLocalName( reader, &local, NULL );
+            if (!wcscmp( local, L"File" ) && in_file)
+            {
+                in_file = FALSE;
+                ok = name && verify_file( rec->install_location, name, size, (const BYTE (*)[32])hashes, count );
+                if (!ok) TRACE( "%s does not match the block map\n", debugstr_w( name ) );
+            }
+        }
+    }
+    free( name );
+    free( hashes );
+    IXmlReader_Release( reader );
+    IStream_Release( stream );
+    return ok;
+}
+
+/* ---- AddPackageByAppInstallerFileAsync ---------------------------------------------------- */
+
+/* The location a Uri attribute of an App Installer file stands for. */
+static BOOL appinstaller_location( const WCHAR *uri, WCHAR *out, DWORD size )
+{
+    if (!wcsnicmp( uri, L"file:", 5 )) return SUCCEEDED(PathCreateFromUrlW( uri, out, &size, 0 ));
+    if ((!wcsnicmp( uri, L"http://", 7 ) || !wcsnicmp( uri, L"https://", 8 )) && wcslen( uri ) < size)
+    {
+        wcscpy( out, uri );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* The packages of an .appinstaller file are installed: the dependencies, then the main package or
+ * bundle, then the optional packages. */
+HRESULT appinstaller_work( const WCHAR *location, DeploymentOptions options, WCHAR **error_text )
+{
+    struct strlist deps = { 0 }, optional = { 0 };
+    WCHAR path[MAX_PATH], target[2048], *main_uri = NULL, *list = NULL;
+    IXmlReader *reader = NULL;
+    IStream *stream = NULL;
+    XmlNodeType type;
+    BOOL temporary = FALSE, in_deps = FALSE, in_optional = FALSE, found_root = FALSE;
+    size_t used = 0, len;
+    const WCHAR *p;
+    HRESULT hr;
+
+    TRACE( "location %s\n", debugstr_w( location ) );
+
+    if (FAILED(hr = fetch( location, path, ARRAY_SIZE(path), &temporary, error_text ))) return hr;
+    if (FAILED(hr = SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream )))
+    {
+        set_error( error_text, L"The App Installer file could not be opened", location );
+        goto done;
+    }
+    if (FAILED(hr = CreateXmlReader( &IID_IXmlReader, (void **)&reader, NULL )) ||
+        FAILED(hr = IXmlReader_SetProperty( reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit )) ||
+        FAILED(hr = IXmlReader_SetInput( reader, (IUnknown *)stream )))
+        goto done;
+
+    while (IXmlReader_Read( reader, &type ) == S_OK)
+    {
+        const WCHAR *name, *value;
+
+        if (type == XmlNodeType_EndElement)
+        {
+            IXmlReader_GetLocalName( reader, &name, NULL );
+            if (!wcscmp( name, L"Dependencies" )) in_deps = FALSE;
+            else if (!wcscmp( name, L"Optional" ) || !wcscmp( name, L"OptionalPackages" )) in_optional = FALSE;
+            continue;
+        }
+        if (type != XmlNodeType_Element) continue;
+        IXmlReader_GetLocalName( reader, &name, NULL );
+        if (!wcscmp( name, L"AppInstaller" )) found_root = TRUE;
+#ifndef SG_MUTANT_AX_APPINST
+        else if (!wcscmp( name, L"Dependencies" )) in_deps = !IXmlReader_IsEmptyElement( reader );
+#endif
+        else if (!wcscmp( name, L"Optional" ) || !wcscmp( name, L"OptionalPackages" ))
+            in_optional = !IXmlReader_IsEmptyElement( reader );
+        else if (!wcscmp( name, L"MainPackage" ) || !wcscmp( name, L"MainBundle" ) || !wcscmp( name, L"Package" ) ||
+                 !wcscmp( name, L"Bundle" ))
+        {
+            BOOL is_main = name[0] == 'M';
+
+            if (FAILED(IXmlReader_MoveToAttributeByName( reader, L"Uri", NULL )) ||
+                FAILED(IXmlReader_GetValue( reader, &value, NULL )) || !appinstaller_location( value, target, ARRAY_SIZE(target) ))
+            {
+                set_error( error_text, L"A package of the App Installer file has no usable Uri", name );
+                hr = E_INVALIDARG;
+                goto done;
+            }
+            if (is_main) { free( main_uri ); main_uri = wcsdup( target ); }
+            else if (in_deps) strlist_add( &deps, target );
+            else if (in_optional) strlist_add( &optional, target );
+        }
+    }
+    if (!found_root || !main_uri)
+    {
+        set_error( error_text, L"The App Installer file does not name a main package", location );
+        hr = E_INVALIDARG;
+        goto done;
+    }
+
+    /* the main package, the dependencies given for it to depend on, then the optional packages */
+    len = wcslen( main_uri ) + 1;
+    if (!(list = malloc( (len + (deps.data ? deps.len : 0) + 1) * sizeof(WCHAR) ))) { hr = E_OUTOFMEMORY; goto done; }
+    memcpy( list, main_uri, len * sizeof(WCHAR) );
+    used = len;
+    if (deps.data) { memcpy( list + used, deps.data, deps.len * sizeof(WCHAR) ); used += deps.len; }
+    list[used] = 0;
+    if (SUCCEEDED(hr = add_package_work( list, options, error_text )))
+        for (p = optional.data; p && *p && SUCCEEDED(hr); p += wcslen( p ) + 1)
+            hr = add_one( p, options, error_text );
+
+done:
+    free( list );
+    free( main_uri );
+    free( deps.data );
+    free( optional.data );
+    if (reader) IXmlReader_Release( reader );
+    if (stream) IStream_Release( stream );
+    if (temporary) DeleteFileW( path );
+    return hr;
+}
