+static ULONG WINAPI user_list_AddRef( IIterable_PackageUserInformation *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterable_PackageUserInformation( iface )->ref );
+}
+
+static ULONG WINAPI user_list_Release( IIterable_PackageUserInformation *iface )
+{
+    struct user_list *impl = impl_from_IIterable_PackageUserInformation( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT32 i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++) IPackageUserInformation_Release( impl->users[i] );
+        free( impl->users );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI user_list_GetIids( IIterable_PackageUserInformation *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI user_list_GetRuntimeClassName( IIterable_PackageUserInformation *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI user_list_GetTrustLevel( IIterable_PackageUserInformation *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI user_list_First( IIterable_PackageUserInformation *iface, IIterator_PackageUserInformation **value )
+{
+    struct user_list *impl = impl_from_IIterable_PackageUserInformation( iface );
+    struct user_iterator *it;
+
+    if (!value) return E_POINTER;
+    if (!(it = calloc( 1, sizeof(*it) ))) return E_OUTOFMEMORY;
+    it->IIterator_PackageUserInformation_iface.lpVtbl = &user_iterator_vtbl;
+    it->ref = 1;
+    it->list = impl;
+    IIterable_PackageUserInformation_AddRef( iface );
+    *value = &it->IIterator_PackageUserInformation_iface;
+    return S_OK;
+}
+
+static const struct IIterable_PackageUserInformationVtbl user_list_vtbl =
+{
+    user_list_QueryInterface,
+    user_list_AddRef,
+    user_list_Release,
+    user_list_GetIids,
+    user_list_GetRuntimeClassName,
+    user_list_GetTrustLevel,
+    user_list_First,
+};
+
+/* Takes the SIDs of the array (and the array). */
+HRESULT package_users_create( struct package_user *users, UINT32 count, IIterable_PackageUserInformation **out )
+{
+    struct user_list *list;
+    UINT32 i;
+    HRESULT hr = S_OK;
+
+    if (!(list = calloc( 1, sizeof(*list) ))) hr = E_OUTOFMEMORY;
+    else if (!(list->users = calloc( count ? count : 1, sizeof(*list->users) )))
+    {
+        free( list );
+        hr = E_OUTOFMEMORY;
+    }
+    else
+    {
+        list->IIterable_PackageUserInformation_iface.lpVtbl = &user_list_vtbl;
+        list->ref = 1;
+        for (i = 0; i < count; i++)
+        {
+            struct user_information *user;
+
+            if (!(user = calloc( 1, sizeof(*user) ))) break;
+            user->IPackageUserInformation_iface.lpVtbl = &user_vtbl;
+            user->ref = 1;
+            user->state = users[i].state;
+            WindowsCreateString( users[i].sid, wcslen( users[i].sid ), &user->sid );
+            list->users[list->count++] = &user->IPackageUserInformation_iface;
+        }
+        *out = &list->IIterable_PackageUserInformation_iface;
+    }
+    for (i = 0; i < count; i++) free( users[i].sid );
+    free( users );
+    return hr;
+}
