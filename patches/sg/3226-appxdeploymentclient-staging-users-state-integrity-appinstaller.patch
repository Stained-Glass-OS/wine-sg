+    IID *list;
+
+    if (!count || !iids) return E_POINTER;
+    if (!(list = CoTaskMemAlloc( sizeof(*list) ))) return E_OUTOFMEMORY;
+    *list = IID_IAppDisplayInfo;
+    *count = 1;
+    *iids = list;
+    return S_OK;
+}
+
+static HRESULT WINAPI display_GetRuntimeClassName( IAppDisplayInfo *iface, HSTRING *name )
