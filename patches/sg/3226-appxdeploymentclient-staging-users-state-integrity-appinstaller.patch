+{
+    struct user_iterator *impl = impl_from_IIterator_PackageUserInformation( iface );
+    if (!value) return E_POINTER;
+    if (impl->index < impl->list->count) impl->index++;
+    *value = impl->index < impl->list->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI user_iterator_GetMany( IIterator_PackageUserInformation *iface, UINT32 size, IPackageUserInformation **items, UINT32 *count )
+{
+    struct user_iterator *impl = impl_from_IIterator_PackageUserInformation( iface );
+    UINT32 n = 0;
+
+    if (!count || (size && !items)) return E_POINTER;
+    while (n < size && impl->index < impl->list->count)
+    {
+        IPackageUserInformation_AddRef( (items[n] = impl->list->users[impl->index++]) );
+        n++;
+    }
+    *count = n;
+    return S_OK;
+}
