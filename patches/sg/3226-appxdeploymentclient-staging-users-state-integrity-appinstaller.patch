+    if (RegOpenKeyExW( packages, st->full_name, 0, KEY_SET_VALUE, &key )) return TRUE;
+    RegSetValueExW( key, L"State", 0, REG_DWORD, (const BYTE *)&st->state, sizeof(st->state) );
+    RegCloseKey( key );
+    st->found = TRUE;
+    return TRUE;
