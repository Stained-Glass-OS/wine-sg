+struct family_names
+{
+    const WCHAR *family_name;
+    struct strlist names;
+};
+
+static BOOL collect_family( struct package_record *rec, void *context )
+{
+    struct family_names *f = context;
+
+    if (rec->family_name && !wcsicmp( rec->family_name, f->family_name ) && !rec->resource_package)
+        strlist_add( &f->names, rec->full_name );
+    return TRUE;
+}
