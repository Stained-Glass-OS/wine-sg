+/* ---- the status of a package ---------------------------------------------- */
+
+struct package_status
+{
+    IPackageStatus IPackageStatus_iface;
+    LONG ref;
+    BOOL not_available, license_issue, modified, tampered, dependency_issue;
+};
+
+static inline struct package_status *impl_from_IPackageStatus( IPackageStatus *iface )
+{
+    return CONTAINING_RECORD( iface, struct package_status, IPackageStatus_iface );
+}
+
+static HRESULT WINAPI status_QueryInterface( IPackageStatus *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IPackageStatus ))
+    {
+        *out = iface;
+        IPackageStatus_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI status_AddRef( IPackageStatus *iface )
+{
+    return InterlockedIncrement( &impl_from_IPackageStatus( iface )->ref );
+}
+
+static ULONG WINAPI status_Release( IPackageStatus *iface )
+{
+    struct package_status *impl = impl_from_IPackageStatus( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI status_GetIids( IPackageStatus *iface, ULONG *count, IID **iids )
+{
+    IID *list;
+
+    if (!count || !iids) return E_POINTER;
+    if (!(list = CoTaskMemAlloc( sizeof(*list) ))) return E_OUTOFMEMORY;
+    *list = IID_IPackageStatus;
+    *count = 1;
+    *iids = list;
+    return S_OK;
+}
+
+static HRESULT WINAPI status_GetRuntimeClassName( IPackageStatus *iface, HSTRING *name )
+{
+    if (!name) return E_POINTER;
+    return WindowsCreateString( RuntimeClass_Windows_ApplicationModel_PackageStatus,
+                                wcslen( RuntimeClass_Windows_ApplicationModel_PackageStatus ), name );
+}
+
+static HRESULT WINAPI status_GetTrustLevel( IPackageStatus *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI status_VerifyIsOK( IPackageStatus *iface, boolean *value )
+{
+    struct package_status *impl = impl_from_IPackageStatus( iface );
+    if (!value) return E_POINTER;
+    *value = !(impl->not_available || impl->license_issue || impl->modified || impl->tampered || impl->dependency_issue);
+    return S_OK;
+}
+
+#define STATUS_FLAG( name, field ) \
+    static HRESULT WINAPI status_get_##name( IPackageStatus *iface, boolean *value ) \
+    { \
+        if (!value) return E_POINTER; \
+        *value = impl_from_IPackageStatus( iface )->field; \
+        return S_OK; \
+    }
+STATUS_FLAG( NotAvailable, not_available )
+STATUS_FLAG( LicenseIssue, license_issue )
+STATUS_FLAG( Modified, modified )
+STATUS_FLAG( Tampered, tampered )
+STATUS_FLAG( DependencyIssue, dependency_issue )
+#undef STATUS_FLAG
+
+/* nothing of this machine's packages is offline, disabled, being serviced or deployed or needs
+ * remediation */
+#define STATUS_NONE( name ) \
+    static HRESULT WINAPI status_get_##name( IPackageStatus *iface, boolean *value ) \
+    { \
+        if (!value) return E_POINTER; \
+        *value = FALSE; \
+        return S_OK; \
+    }
+STATUS_NONE( PackageOffline )
+STATUS_NONE( DataOffline )
+STATUS_NONE( Disabled )
+STATUS_NONE( NeedsRemediation )
+STATUS_NONE( Servicing )
+STATUS_NONE( DeploymentInProgress )
+#undef STATUS_NONE
+
+static const struct IPackageStatusVtbl status_vtbl =
+{
+    status_QueryInterface,
+    status_AddRef,
+    status_Release,
+    status_GetIids,
+    status_GetRuntimeClassName,
+    status_GetTrustLevel,
+    status_VerifyIsOK,
+    status_get_NotAvailable,
+    status_get_PackageOffline,
+    status_get_DataOffline,
+    status_get_Disabled,
+    status_get_NeedsRemediation,
+    status_get_LicenseIssue,
+    status_get_Modified,
+    status_get_Tampered,
+    status_get_DependencyIssue,
+    status_get_Servicing,
+    status_get_DeploymentInProgress,
+};
+
+/* The state set with SetPackageState, whether the files are there, and whether what it depends on is installed. */
+HRESULT package_status_create( const struct package_record *rec, IPackageStatus **out )
+{
+    struct package_status *impl;
+    const WCHAR *dep;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IPackageStatus_iface.lpVtbl = &status_vtbl;
+    impl->ref = 1;
+    impl->license_issue = rec->state == PackageState_LicenseInvalid;
+    impl->modified = rec->state == PackageState_Modified;
+#ifdef SG_MUTANT_AX_STATUS
+    impl->tampered = FALSE;
+#else
+    impl->tampered = rec->state == PackageState_Tampered;
+#endif
+    impl->not_available = !rec->install_location || GetFileAttributesW( rec->install_location ) == INVALID_FILE_ATTRIBUTES;
+    for (dep = rec->dependencies; dep && *dep; dep += wcslen( dep ) + 1)
+    {
+        IPackage *package = NULL;
+
+        if (FAILED(deployed_package_by_full_name( dep, &package )) || !package) impl->dependency_issue = TRUE;
+        if (package) IPackage_Release( package );
+    }
+    *out = &impl->IPackageStatus_iface;
+    return S_OK;
+}
