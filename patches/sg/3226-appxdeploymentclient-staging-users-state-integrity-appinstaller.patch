+/* ---- the users of a machine ------------------------------------------------------------------ */
+
+/* The SID of the calling user, as a string (allocated). */
+static WCHAR *current_user_sid(void)
+{
+    TOKEN_USER *user;
+    HANDLE token;
+    WCHAR *sid = NULL, *str = NULL;
+    DWORD size = 0;
+
+    if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return NULL;
+    GetTokenInformation( token, TokenUser, NULL, 0, &size );
+    if (size && (user = malloc( size )))
+    {
+        if (GetTokenInformation( token, TokenUser, user, size, &size ) && ConvertSidToStringSidW( user->User.Sid, &str ))
+        {
+            sid = wcsdup( str );
+            LocalFree( str );
+        }
+        free( user );
+    }
+    CloseHandle( token );
+    return sid;
+}
+
+static BOOL caller_is_admin(void)
+{
+    SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    BOOL member = FALSE;
+    PSID admins;
+
+    if (!AllocateAndInitializeSid( &nt, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS, 0, 0, 0, 0, 0, 0, &admins ))
+        return FALSE;
+    if (!CheckTokenMembership( NULL, admins, &member )) member = FALSE;
+    FreeSid( admins );
+    return member;
+}
+
+/* Calls func( sid, packages, context ) for each loaded user whose profile has a record of packages,
+ * until it returns FALSE. */
+typedef BOOL (*hive_func)( const WCHAR *sid, HKEY packages, void *context );
+
+static void for_each_hive( hive_func func, void *context )
+{
+    WCHAR sid[128];
+    DWORD len, index = 0;
+    HKEY users, packages;
+    BOOL more = TRUE;
+
+    if (RegOpenKeyExW( HKEY_USERS, L"", 0, KEY_READ, &users )) return;
+    while (more && (len = ARRAY_SIZE(sid), !RegEnumKeyExW( users, index++, sid, &len, NULL, NULL, NULL, NULL )))
+    {
+        WCHAR path[256];
+
+        if (len > 8 && !wcsicmp( sid + len - 8, L"_Classes" )) continue;
+        if (!wcsicmp( sid, L".DEFAULT" )) continue;
+        swprintf( path, ARRAY_SIZE(path), L"%s\\%s", sid, packages_keyW );
+        if (RegOpenKeyExW( HKEY_USERS, path, 0, KEY_READ | KEY_WRITE, &packages ) &&
+            RegOpenKeyExW( HKEY_USERS, path, 0, KEY_READ, &packages )) continue;
+        more = func( sid, packages, context );
+        RegCloseKey( packages );
+    }
+    RegCloseKey( users );
+}
+
+struct other_users
+{
+    const WCHAR *full_name;
+    WCHAR *mine;
+    BOOL found;
+};
+
+static BOOL find_other_user( const WCHAR *sid, HKEY packages, void *context )
+{
+    struct other_users *o = context;
+    HKEY key;
+
+    if (o->mine && !wcsicmp( sid, o->mine )) return TRUE;
+    if (RegOpenKeyExW( packages, o->full_name, 0, KEY_READ, &key )) return TRUE;
+    RegCloseKey( key );
+    o->found = TRUE;
+    return FALSE;
+}
+
+/* A user of the machine other than exclude (NULL: the caller) has the package. */
+static BOOL other_users_have_besides( const WCHAR *full_name, const WCHAR *exclude )
+{
+    struct other_users o = { full_name, exclude ? wcsdup( exclude ) : current_user_sid() };
+
+    for_each_hive( find_other_user, &o );
+    free( o.mine );
+    return o.found;
+}
+
+/* Another user of the machine has the package, so its files stay. */
+static BOOL other_users_have( const WCHAR *full_name )
+{
+#ifdef SG_MUTANT_AX_OTHERUSERS
+    return FALSE;
+#endif
+    return other_users_have_besides( full_name, NULL );
+}
