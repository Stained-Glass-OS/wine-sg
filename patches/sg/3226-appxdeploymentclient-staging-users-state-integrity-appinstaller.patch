+/* the operation the thread works for, so that the work can see a cancellation */
+static DWORD operation_tls = TLS_OUT_OF_INDEXES;
+static INIT_ONCE operation_tls_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK operation_tls_init( INIT_ONCE *once, void *param, void **context )
+{
+    operation_tls = TlsAlloc();
+    return TRUE;
+}
+
+BOOL deploy_cancelled(void)
+{
+    struct deploy_operation *op;
+
+    InitOnceExecuteOnce( &operation_tls_once, operation_tls_init, NULL, NULL );
+    if (operation_tls == TLS_OUT_OF_INDEXES || !(op = TlsGetValue( operation_tls ))) return FALSE;
+    return !!op->cancel;
+}
