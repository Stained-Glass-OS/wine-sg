+/* Provision: the staged package is registered for every user, the present one now.  An
+ * administrator's call; a package that was provisioned is registered again. */
+HRESULT provision_package_work( const WCHAR *family_name, DeploymentOptions options, WCHAR **error_text )
+{
+    struct family_names f = { family_name };
+    const WCHAR *p;
+    HRESULT hr = S_OK;
+
+    TRACE( "family %s\n", debugstr_w( family_name ) );
+
+    if (!family_name[0] || wcschr( family_name, '\\' ))
+    {
+        set_error( error_text, L"Not a package family name", family_name );
+        return E_INVALIDARG;
+    }
+    if (!caller_is_admin())
+    {
+        set_error( error_text, L"Provisioning needs an administrator", NULL );
+        return E_ACCESSDENIED;
+    }
+    for_each_record( collect_family, &f );
+    if (!f.names.data)
+    {
+        set_error( error_text, L"The package must be staged first", family_name );
+        return 0x80073cf1; /* ERROR_INSTALL_PACKAGE_NOT_FOUND */
+    }
+    for (p = f.names.data; *p && SUCCEEDED(hr); p += wcslen( p) + 1)
+    {
+        WCHAR path[MAX_PATH];
+        HKEY key;
+
+        swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, p );
+        if (!RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_WRITE, &key ))
+        {
+            DWORD one = 1;
+            RegSetValueExW( key, L"Provisioned", 0, REG_DWORD, (const BYTE *)&one, sizeof(one) );
+            RegCloseKey( key );
+        }
+#ifdef SG_MUTANT_AX_PROVISION
+        hr = S_OK;
+#else
+        hr = register_staged_one( p, error_text );
+#endif
+    }
+    free( f.names.data );
+    return hr;
+}
+
+/* The records of a user's hive that are the package (a full name or a package name). */
+static void collect_user_records( HKEY packages, const WCHAR *name, struct strlist *out )
+{
+    WCHAR full_name[256];
+    DWORD len, index = 0;
+
+    while (len = ARRAY_SIZE(full_name), !RegEnumKeyExW( packages, index++, full_name, &len, NULL, NULL, NULL, NULL ))
+    {
+        HKEY key;
+        WCHAR *package_name;
+
+        if (!wcsicmp( full_name, name ))
+        {
+            strlist_add( out, full_name );
+            continue;
+        }
+        if (RegOpenKeyExW( packages, full_name, 0, KEY_READ, &key )) continue;
+        if ((package_name = reg_string( key, L"Name" )))
+        {
+            if (!wcsicmp( package_name, name )) strlist_add( out, full_name );
+            free( package_name );
+        }
+        RegCloseKey( key );
+    }
+}
