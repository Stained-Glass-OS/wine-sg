+/* Register a staged package for the user: its applications get their shortcuts and aliases, the
+ * packages it came with (resources) are registered with it. */
+static HRESULT register_staged_one( const WCHAR *full_name, WCHAR **error_text )
+{
+    struct package_record rec;
+    struct strlist shortcuts = { 0 }, aliases = { 0 }, resources = { 0 };
+    IAppxFactory *factory = NULL;
+    IAppxManifestReader *manifest = NULL;
+    IStream *stream = NULL;
+    WCHAR path[MAX_PATH], *list, *p;
+    HKEY key;
+    HRESULT hr;
+
+    if (!open_record( full_name, &rec, &key ))
+    {
+        set_error( error_text, L"The package could not be found", full_name );
+        return 0x80073cf1; /* ERROR_INSTALL_PACKAGE_NOT_FOUND */
+    }
+    if (!rec.staged)
+    {
+        TRACE( "%s is registered already\n", debugstr_w( full_name ) );
+        RegCloseKey( key );
+        package_record_free( &rec );
+        return S_OK;
+    }
+    if ((list = reg_multi( key, L"ResourcePackages" )))
+    {
+        for (p = list; *p; p += wcslen( p ) + 1)
+        {
+            if (FAILED(hr = register_staged_one( p, error_text )))
+            {
+                free( list );
+                RegCloseKey( key );
+                package_record_free( &rec );
+                return hr;
+            }
+            strlist_add( &resources, p );
+        }
+        free( list );
+    }
+    RegCloseKey( key );
+
+    if (!rec.framework && !rec.resource_package)
+    {
+        swprintf( path, ARRAY_SIZE(path), L"%s\\AppxManifest.xml", rec.install_location );
+        if (FAILED(hr = SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream )))
+        {
+            set_error( error_text, L"The staged manifest could not be opened", path );
+            goto done;
+        }
+        if (FAILED(hr = CoCreateInstance( &CLSID_AppxFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IAppxFactory, (void **)&factory )) ||
+            FAILED(hr = IAppxFactory_CreateManifestReader( factory, stream, &manifest )))
+        {
+            set_error( error_text, L"The staged manifest is invalid", NULL );
+            goto done;
+        }
+        create_shortcuts( manifest, &rec, &shortcuts );
+        create_aliases( manifest, &rec, &aliases );
+    }
+#ifndef SG_MUTANT_AX_REGISTER
+    rec.staged = FALSE;
+#endif
+    if (FAILED(hr = write_record( &rec, &shortcuts, &aliases, &resources )))
+        set_error( error_text, L"The package could not be registered", NULL );
+    else TRACE( "registered %s\n", debugstr_w( full_name ) );
+
+done:
+    free( shortcuts.data );
+    free( aliases.data );
+    free( resources.data );
+    if (manifest) IAppxManifestReader_Release( manifest );
+    if (factory) IAppxFactory_Release( factory );
+    if (stream) IStream_Release( stream );
+    package_record_free( &rec );
+    return hr;
+}
+
+HRESULT register_staged_work( const WCHAR *list, DeploymentOptions options, WCHAR **error_text )
+{
+    const WCHAR *dep;
+    HRESULT hr;
+
+    TRACE( "package %s, options %#x\n", debugstr_w( list ), options );
+
+    if (!list[0] || wcschr( list, '\\' ))
+    {
+        set_error( error_text, L"Not a package full name", list );
+        return E_INVALIDARG;
+    }
+    /* the dependencies first, as installing does */
+    for (dep = list + wcslen( list ) + 1; *dep; dep += wcslen( dep ) + 1)
+        if (FAILED(hr = register_staged_one( dep, error_text ))) return hr;
+    return register_staged_one( list, error_text );
+}
