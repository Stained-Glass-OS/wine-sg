+HRESULT wma_encoder_create(IUnknown *outer, IUnknown **out)
+{
+    static const WAVEFORMATEX input_format =
+    {
+        .wFormatTag = WAVE_FORMAT_PCM, .wBitsPerSample = 16, .nSamplesPerSec = 44100, .nChannels = 2,
+        .nBlockAlign = 4, .nAvgBytesPerSec = 176400,
+    };
+    static const WMAUDIO2WAVEFORMAT output_format =
+    {
+        .wfx = {.wFormatTag = WAVE_FORMAT_WMAUDIO2, .wBitsPerSample = 16, .nSamplesPerSec = 44100, .nChannels = 2,
+                .nAvgBytesPerSec = 16000, .nBlockAlign = 743, .cbSize = sizeof(output_format) - sizeof(WAVEFORMATEX)},
+        .wEncodeOptions = 1,
+    };
+    struct wma_encoder *impl;
+    HRESULT hr;
+
+    TRACE("outer %p, out %p.\n", outer, out);
+
+    if (FAILED(hr = check_audio_transform_support(&input_format, &output_format.wfx)))
+    {
+        ERR_(winediag)("GStreamer doesn't support WMA encoding, please install appropriate plugins.\n");
+        return hr;
+    }
+
+    if (!(impl = calloc(1, sizeof(*impl))))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = wg_sample_queue_create(&impl->wg_sample_queue)))
+    {
+        free(impl);
+        return hr;
+    }
+
+    impl->IUnknown_inner.lpVtbl = &unknown_vtbl;
