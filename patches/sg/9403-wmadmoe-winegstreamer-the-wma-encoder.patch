+
+/* Stained Glass OS (wine-sg 9403): the Windows Media Audio encoder's DLL, as on Windows; the encoder
+ * itself is winegstreamer's. */
+
+#include <stddef.h>
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+
+#include "dmoreg.h"
+#include "dshow.h"
+#include "mfapi.h"
+#include "mfidl.h"
+#include "rpcproxy.h"
+#include "wmcodecdsp.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dmo);
+
+static HRESULT WINAPI wma_encoder_factory_CreateInstance(IClassFactory *iface, IUnknown *outer,
+        REFIID riid, void **out)
+{
+    static const GUID CLSID_wg_wma_encoder = {0x163a8cde,0x3b0e,0x4022,{0x84,0x27,0x60,0x8c,0xb7,0x91,0x7c,0xa0}};
+    return CoCreateInstance(&CLSID_wg_wma_encoder, outer, CLSCTX_INPROC_SERVER, riid, out);
+}
+
+static HRESULT WINAPI class_factory_QueryInterface(IClassFactory *iface, REFIID riid, void **out)
+{
+    *out = IsEqualGUID(riid, &IID_IClassFactory) || IsEqualGUID(riid, &IID_IUnknown) ? iface : NULL;
+    return *out ? S_OK : E_NOINTERFACE;
+}
+static ULONG WINAPI class_factory_AddRef(IClassFactory *iface)
+{
+    return 2;
+}
+static ULONG WINAPI class_factory_Release(IClassFactory *iface)
+{
+    return 1;
+}
+static HRESULT WINAPI class_factory_LockServer(IClassFactory *iface, BOOL dolock)
+{
+    return S_OK;
+}
+
+static const IClassFactoryVtbl wma_encoder_factory_vtbl =
+{
+    class_factory_QueryInterface,
+    class_factory_AddRef,
+    class_factory_Release,
+    wma_encoder_factory_CreateInstance,
+    class_factory_LockServer,
+};
+
+static IClassFactory wma_encoder_factory = {&wma_encoder_factory_vtbl};
+
+/***********************************************************************
+ *              DllGetClassObject (wmadmoe.@)
+ */
+HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID riid, void **out)
+{
+    if (IsEqualGUID(clsid, &CLSID_CWMAEncMediaObject))
+        return IClassFactory_QueryInterface(&wma_encoder_factory, riid, out);
+
+    *out = NULL;
+    FIXME("Unknown clsid %s.\n", debugstr_guid(clsid));
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
+
+/***********************************************************************
+ *              DllRegisterServer (wmadmoe.@)
+ */
+HRESULT WINAPI DllRegisterServer(void)
+{
+    MFT_REGISTER_TYPE_INFO wma_encoder_mft_inputs[] =
+    {
+        {MFMediaType_Audio, MFAudioFormat_PCM},
+        {MFMediaType_Audio, MFAudioFormat_Float},
+    };
+    MFT_REGISTER_TYPE_INFO wma_encoder_mft_outputs[] =
+    {
+        {MFMediaType_Audio, MFAudioFormat_WMAudioV8},
+    };
+    DMO_PARTIAL_MEDIATYPE wma_encoder_dmo_inputs[] =
+    {
+        {.type = MEDIATYPE_Audio, .subtype = MEDIASUBTYPE_PCM},
+        {.type = MEDIATYPE_Audio, .subtype = MEDIASUBTYPE_IEEE_FLOAT},
+    };
+    DMO_PARTIAL_MEDIATYPE wma_encoder_dmo_outputs[] =
+    {
+        {.type = MEDIATYPE_Audio, .subtype = MEDIASUBTYPE_WMAUDIO2},
+    };
+    HRESULT hr;
+
+    TRACE("\n");
+
+    if (FAILED(hr = __wine_register_resources()))
+        return hr;
+    if (FAILED(hr = MFTRegister(CLSID_CWMAEncMediaObject, MFT_CATEGORY_AUDIO_ENCODER,
+            (WCHAR *)L"WMAudio Encoder MFT", MFT_ENUM_FLAG_SYNCMFT,
+            ARRAY_SIZE(wma_encoder_mft_inputs), wma_encoder_mft_inputs,
+            ARRAY_SIZE(wma_encoder_mft_outputs), wma_encoder_mft_outputs, NULL)))
+        return hr;
+    if (FAILED(hr = DMORegister(L"WMAudio Encoder DMO", &CLSID_CWMAEncMediaObject, &DMOCATEGORY_AUDIO_ENCODER, 0,
+            ARRAY_SIZE(wma_encoder_dmo_inputs), wma_encoder_dmo_inputs,
+            ARRAY_SIZE(wma_encoder_dmo_outputs), wma_encoder_dmo_outputs)))
+        return hr;
+
+    return S_OK;
+}
+
+/***********************************************************************
+ *              DllUnregisterServer (wmadmoe.@)
+ */
+HRESULT WINAPI DllUnregisterServer(void)
+{
+    HRESULT hr;
+
+    TRACE("\n");
+
+    if (FAILED(hr = __wine_unregister_resources()))
+        return hr;
+    if (FAILED(hr = MFTUnregister(CLSID_CWMAEncMediaObject)))
+        return hr;
+    if (FAILED(hr = DMOUnregister(&CLSID_CWMAEncMediaObject, &DMOCATEGORY_AUDIO_ENCODER)))
+        return hr;
+
+    return S_OK;
+}
