+
+/*
+ * Stained Glass OS (wine-sg 9403): the Windows Media Audio encoder (CLSID_CWMAEncMediaObject, an MFT and
+ * a DMO, WMADMOE.DLL on Windows), as Microsoft documents it ("WMAudio Encoder") for its CBR mode: 16-bit
+ * PCM or float input, mono or stereo, set first; the encoder then offers Windows Media Audio 8 (WMA v2)
+ * output types for that input, and each output sample is one block (MF_MT_AUDIO_BLOCK_ALIGNMENT bytes)
+ * of one frame of samples. Encoding runs through wg_transform (GStreamer's libav WMA v2 encoder); the
+ * block sizes and the codec data in MF_MT_USER_DATA are the encoder's own (its output caps), the sample
+ * times are the transform's. WMA 9 Professional, Voice and Lossless have no encoder here and are refused.
+ */
+
+#include "gst_private.h"
+#include "dmo_transform.h"
+
+#include "mfapi.h"
+#include "mferror.h"
+#include "mfobjects.h"
+#include "mftransform.h"
+#include "wmcodecdsp.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
+WINE_DECLARE_DEBUG_CHANNEL(winediag);
+
+static const UINT32 wma_rates[] = {8000, 11025, 16000, 22050, 32000, 44100, 48000};
+/* the encoder (libav) takes 24 kbps and more */
+static const UINT32 wma_kbps[] = {24, 32, 40, 48, 64, 80, 96, 128, 160, 192};
+
+struct wma_encoder
+{
+    IUnknown IUnknown_inner;
+    IMFTransform IMFTransform_iface;
+    IMediaObject IMediaObject_iface;
+    IPropertyBag IPropertyBag_iface;
+    IPropertyStore IPropertyStore_iface;
+    IUnknown *outer;
+    LONG refcount;
+
+    IMFMediaType *input_type;
+    IMFMediaType *output_type;
+    UINT32 rate, channels, depth, block_align;
+
+    wg_transform_t wg_transform;
+    struct wg_sample_queue *wg_sample_queue;
+
+    BOOL have_time;
+    LONGLONG next_time;
+
+    struct dmo_state dmo;
+};
+
+/* samples per frame of WMA v2 (the frame length of the codec, by sample rate) */
+static UINT32 wma_frame_samples(UINT32 rate)
+{
+    if (rate <= 16000) return 512;
+    if (rate <= 22050) return 1024;
+    return 2048;
+}
+
+/* the block (one frame) of a CBR stream at a bit rate, and the byte rate it comes to */
+static UINT32 wma_block_align(UINT32 rate, UINT32 bits_per_second)
+{
+    /* rounded up, so the stream keeps at least the bit rate it is listed for */
+    UINT32 block = ((UINT64)bits_per_second * wma_frame_samples(rate) + 8 * rate - 1) / (8 * rate);
+    return min(max(block, 1), 32768);
+}
+
+/* rounded up: the encoder makes its block from the bit rate rounded down */
+static UINT32 wma_bytes_per_second(UINT32 rate, UINT32 block_align)
+{
+    UINT32 frame = wma_frame_samples(rate);
+    return ((UINT64)block_align * rate + frame - 1) / frame;
+}
+
+static inline struct wma_encoder *impl_from_IUnknown(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct wma_encoder, IUnknown_inner);
+}
+
+static void encoder_destroy_transform(struct wma_encoder *impl)
+{
+    if (impl->wg_transform)
+    {
+        wg_transform_destroy(impl->wg_transform);
+        impl->wg_transform = 0;
+    }
+    impl->have_time = FALSE;
+    impl->next_time = 0;
+}
+
+static HRESULT WINAPI unknown_QueryInterface(IUnknown *iface, REFIID iid, void **out)
+{
+    struct wma_encoder *impl = impl_from_IUnknown(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown))
+        *out = &impl->IUnknown_inner;
+    else if (IsEqualGUID(iid, &IID_IMFTransform))
+        *out = &impl->IMFTransform_iface;
+    else if (IsEqualGUID(iid, &IID_IMediaObject))
+        *out = &impl->IMediaObject_iface;
+    else if (IsEqualIID(iid, &IID_IPropertyBag))
+        *out = &impl->IPropertyBag_iface;
+    else if (IsEqualIID(iid, &IID_IPropertyStore))
+        *out = &impl->IPropertyStore_iface;
+    else
+    {
+        *out = NULL;
+        WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI unknown_AddRef(IUnknown *iface)
+{
+    struct wma_encoder *impl = impl_from_IUnknown(iface);
+    ULONG refcount = InterlockedIncrement(&impl->refcount);
+
+    TRACE("iface %p increasing refcount to %lu.\n", impl, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI unknown_Release(IUnknown *iface)
+{
+    struct wma_encoder *impl = impl_from_IUnknown(iface);
+    ULONG refcount = InterlockedDecrement(&impl->refcount);
+
+    TRACE("iface %p decreasing refcount to %lu.\n", impl, refcount);
+
+    if (!refcount)
+    {
+        encoder_destroy_transform(impl);
+        if (impl->input_type)
+            IMFMediaType_Release(impl->input_type);
+        if (impl->output_type)
+            IMFMediaType_Release(impl->output_type);
+        wg_sample_queue_destroy(impl->wg_sample_queue);
+        dmo_state_destroy(&impl->dmo);
+        free(impl);
+    }
+
+    return refcount;
+}
+
+static const IUnknownVtbl unknown_vtbl =
+{
+    unknown_QueryInterface,
+    unknown_AddRef,
+    unknown_Release,
+};
+
+static struct wma_encoder *impl_from_IMFTransform(IMFTransform *iface)
+{
+    return CONTAINING_RECORD(iface, struct wma_encoder, IMFTransform_iface);
+}
+
+static HRESULT WINAPI transform_QueryInterface(IMFTransform *iface, REFIID iid, void **out)
+{
+    return IUnknown_QueryInterface(impl_from_IMFTransform(iface)->outer, iid, out);
+}
+
+static ULONG WINAPI transform_AddRef(IMFTransform *iface)
+{
+    return IUnknown_AddRef(impl_from_IMFTransform(iface)->outer);
+}
+
+static ULONG WINAPI transform_Release(IMFTransform *iface)
+{
+    return IUnknown_Release(impl_from_IMFTransform(iface)->outer);
+}
+
+static HRESULT WINAPI transform_GetStreamLimits(IMFTransform *iface, DWORD *input_minimum,
+        DWORD *input_maximum, DWORD *output_minimum, DWORD *output_maximum)
+{
+    TRACE("iface %p, input_minimum %p, input_maximum %p, output_minimum %p, output_maximum %p.\n",
+            iface, input_minimum, input_maximum, output_minimum, output_maximum);
+    *input_minimum = *input_maximum = *output_minimum = *output_maximum = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetStreamCount(IMFTransform *iface, DWORD *inputs, DWORD *outputs)
+{
+    TRACE("iface %p, inputs %p, outputs %p.\n", iface, inputs, outputs);
+    *inputs = *outputs = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetStreamIDs(IMFTransform *iface, DWORD input_size, DWORD *inputs,
+        DWORD output_size, DWORD *outputs)
+{
+    TRACE("iface %p, input_size %lu, inputs %p, output_size %lu, outputs %p.\n", iface,
+            input_size, inputs, output_size, outputs);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_GetInputStreamInfo(IMFTransform *iface, DWORD id, MFT_INPUT_STREAM_INFO *info)
+{
+    struct wma_encoder *impl = impl_from_IMFTransform(iface);
+
+    TRACE("iface %p, id %#lx, info %p.\n", iface, id, info);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    if (!impl->input_type || !impl->output_type)
+    {
+        memset(info, 0, sizeof(*info));
+        return MF_E_TRANSFORM_TYPE_NOT_SET;
+    }
+    memset(info, 0, sizeof(*info));
+    /* up to a frame waits in the encoder, and two more for its look-ahead */
+    info->hnsMaxLatency = (LONGLONG)wma_frame_samples(impl->rate) * 3 * 10000000 / impl->rate;
+    info->cbSize = impl->channels * impl->depth / 8;
+    info->cbAlignment = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetOutputStreamInfo(IMFTransform *iface, DWORD id, MFT_OUTPUT_STREAM_INFO *info)
+{
+    struct wma_encoder *impl = impl_from_IMFTransform(iface);
+
+    TRACE("iface %p, id %#lx, info %p.\n", iface, id, info);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    if (!impl->input_type || !impl->output_type)
+    {
+        memset(info, 0, sizeof(*info));
+        return MF_E_TRANSFORM_TYPE_NOT_SET;
+    }
+    memset(info, 0, sizeof(*info));
+    info->cbSize = impl->block_align;
+    info->cbAlignment = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetAttributes(IMFTransform *iface, IMFAttributes **attributes)
+{
+    TRACE("iface %p, attributes %p.\n", iface, attributes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_GetInputStreamAttributes(IMFTransform *iface, DWORD id, IMFAttributes **attributes)
+{
+    TRACE("iface %p, id %#lx, attributes %p.\n", iface, id, attributes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_GetOutputStreamAttributes(IMFTransform *iface, DWORD id, IMFAttributes **attributes)
+{
+    TRACE("iface %p, id %#lx, attributes %p.\n", iface, id, attributes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_DeleteInputStream(IMFTransform *iface, DWORD id)
+{
+    TRACE("iface %p, id %#lx.\n", iface, id);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_AddInputStreams(IMFTransform *iface, DWORD streams, DWORD *ids)
+{
+    TRACE("iface %p, streams %lu, ids %p.\n", iface, streams, ids);
+    return E_NOTIMPL;
+}
+
+static HRESULT create_input_type(UINT32 rate, UINT32 channels, BOOL is_float, IMFMediaType **out)
+{
+    UINT32 depth = is_float ? 32 : 16;
+    IMFMediaType *type;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&type)))
+        return hr;
+    IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Audio);
+    IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, is_float ? &MFAudioFormat_Float : &MFAudioFormat_PCM);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BITS_PER_SAMPLE, depth);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, channels);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BLOCK_ALIGNMENT, channels * depth / 8);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, rate);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, rate * channels * depth / 8);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_CHANNEL_MASK, channels == 2 ? 3 : 4);
+    hr = IMFMediaType_SetUINT32(type, &MF_MT_ALL_SAMPLES_INDEPENDENT, 1);
+    if (FAILED(hr))
+    {
+        IMFMediaType_Release(type);
+        return hr;
+    }
+    *out = type;
+    return S_OK;
+}
+
+/* WMAUDIO2WAVEFORMAT after its WAVEFORMATEX: samples per block, encode options, super block alignment,
+ * as GStreamer's libav encoder writes it (exponent VLCs, no bit reservoir, fixed block length) */
+static void wma_codec_data(BYTE data[10])
+{
+    memset(data, 0, 10);
+    data[4] = 0x01;
+}
+
+static HRESULT create_output_type(UINT32 rate, UINT32 channels, UINT32 block_align, const BYTE *codec_data,
+        UINT32 codec_size, IMFMediaType **out)
+{
+    IMFMediaType *type;
+    BYTE data[10];
+    HRESULT hr;
+
+    if (!codec_data)
+    {
+        wma_codec_data(data);
+        codec_data = data;
+        codec_size = sizeof(data);
+    }
+    if (FAILED(hr = MFCreateMediaType(&type)))
+        return hr;
+    IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Audio);
+    IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, &MFAudioFormat_WMAudioV8);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, channels);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, rate);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, wma_bytes_per_second(rate, block_align));
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BLOCK_ALIGNMENT, block_align);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BITS_PER_SAMPLE, 16);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_PREFER_WAVEFORMATEX, 1);
+    hr = IMFMediaType_SetBlob(type, &MF_MT_USER_DATA, codec_data, codec_size);
+    if (FAILED(hr))
+    {
+        IMFMediaType_Release(type);
+        return hr;
+    }
+    *out = type;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetInputAvailableType(IMFTransform *iface, DWORD id, DWORD index,
+        IMFMediaType **type)
+{
+    struct wma_encoder *impl = impl_from_IMFTransform(iface);
+
+    TRACE("iface %p, id %#lx, index %#lx, type %p.\n", iface, id, index, type);
+
+    *type = NULL;
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    /* for an output type, 16-bit PCM and float of its rate and channels */
+    if (impl->output_type)
+        return index < 2 ? create_input_type(impl->rate, impl->channels, index == 1, type) : MF_E_NO_MORE_TYPES;
+    /* else float and 16-bit PCM, mono and stereo, at each rate */
+    if (index >= ARRAY_SIZE(wma_rates) * 4)
+        return MF_E_NO_MORE_TYPES;
+    return create_input_type(wma_rates[index / 4], 2 - (index / 2) % 2, !(index % 2), type);
+}
+
+static HRESULT WINAPI transform_GetOutputAvailableType(IMFTransform *iface, DWORD id, DWORD index,
+        IMFMediaType **type)
+{
+    struct wma_encoder *impl = impl_from_IMFTransform(iface);
+    UINT32 i, r, c, block;
+
+    TRACE("iface %p, id %#lx, index %#lx, type %p.\n", iface, id, index, type);
+
+    *type = NULL;
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    /* the output types for the input type set, else for every rate and channel count */
+    for (r = 0; r < ARRAY_SIZE(wma_rates); r++)
+        for (c = 2; c >= 1; c--)
+        {
+            if (impl->input_type && (wma_rates[r] != impl->rate || c != impl->channels))
+                continue;
+            for (i = 0; i < ARRAY_SIZE(wma_kbps); i++)
+            {
+                /* more than about 3 bits a sample is not offered */
+                if (wma_kbps[i] * 1000 > wma_rates[r] * c * 3)
+                    continue;
+                block = wma_block_align(wma_rates[r], wma_kbps[i] * 1000);
+                if (!index--)
+                    return create_output_type(wma_rates[r], c, block, NULL, 0, type);
+            }
+        }
+    return MF_E_NO_MORE_TYPES;
+}
+
+static HRESULT encoder_try_create_transform(struct wma_encoder *impl)
+{
+    struct wg_transform_attrs attrs = {.input_queue_length = 15};
+    IMFMediaType *actual, *output;
+    UINT8 *codec_data = NULL;
+    UINT32 size = 0, block;
+    HRESULT hr;
+
+    encoder_destroy_transform(impl);
+    if (FAILED(hr = wg_transform_create_mf(impl->input_type, impl->output_type, &attrs, &impl->wg_transform)))
+    {
+        ERR_(winediag)("GStreamer doesn't support WMA encoding, please install appropriate plugins\n");
+        return hr;
+    }
+    /* the encoder's own block size and codec data are the stream's */
+    if (SUCCEEDED(wg_transform_get_output_type(impl->wg_transform, &actual)))
+    {
+        if (SUCCEEDED(IMFMediaType_GetUINT32(actual, &MF_MT_AUDIO_BLOCK_ALIGNMENT, &block)) && block)
+            impl->block_align = block;
+        IMFMediaType_GetAllocatedBlob(actual, &MF_MT_USER_DATA, &codec_data, &size);
+        IMFMediaType_Release(actual);
+    }
+#ifdef SG_MUTANT_WMAENC_CODEC_DATA
+    CoTaskMemFree(codec_data);
+    codec_data = NULL;
+#endif
+    if (codec_data && SUCCEEDED(create_output_type(impl->rate, impl->channels, impl->block_align, codec_data,
+            size, &output)))
+    {
+        IMFMediaType_Release(impl->output_type);
+        impl->output_type = output;
+    }
+    CoTaskMemFree(codec_data);
+    return S_OK;
+}
+
+static HRESULT get_audio(IMFMediaType *type, GUID *subtype, UINT32 *rate, UINT32 *channels)
+{
+    GUID major;
+
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_MAJOR_TYPE, &major)) || !IsEqualGUID(&major, &MFMediaType_Audio))
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, subtype)))
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, rate)) || *rate < 8000 || *rate > 48000)
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, channels)) || !*channels || *channels > 2)
+        return MF_E_INVALIDMEDIATYPE;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_SetInputType(IMFTransform *iface, DWORD id, IMFMediaType *type, DWORD flags)
+{
+    struct wma_encoder *impl = impl_from_IMFTransform(iface);
+    UINT32 rate, channels, depth, block, bytes;
+    IMFMediaType *input;
+    GUID subtype;
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, type %p, flags %#lx.\n", iface, id, type, flags);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    if (!type)
+    {
+        if (flags & MFT_SET_TYPE_TEST_ONLY)
+            return S_OK;
+        if (impl->input_type)
+            IMFMediaType_Release(impl->input_type);
+        if (impl->output_type)
+            IMFMediaType_Release(impl->output_type);
+        impl->input_type = impl->output_type = NULL;
+        encoder_destroy_transform(impl);
+        return S_OK;
+    }
+
+    if (FAILED(hr = get_audio(type, &subtype, &rate, &channels)))
+        return hr;
+    if (IsEqualGUID(&subtype, &MFAudioFormat_Float))
+        depth = 32;
+    else if (IsEqualGUID(&subtype, &MFAudioFormat_PCM))
+        depth = 16;
+    else
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_BITS_PER_SAMPLE, &block)) || block != depth)
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_BLOCK_ALIGNMENT, &block)) || block != channels * depth / 8)
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, &bytes)) || bytes != rate * block)
+        return MF_E_INVALIDMEDIATYPE;
+    if (flags & MFT_SET_TYPE_TEST_ONLY)
+        return S_OK;
+
+    if (FAILED(hr = create_input_type(rate, channels, depth == 32, &input)))
+        return hr;
+    if (impl->input_type)
+        IMFMediaType_Release(impl->input_type);
+    impl->input_type = input;
+    impl->depth = depth;
+    encoder_destroy_transform(impl);
+    /* an output type of other rates or channels goes; one that fits is kept (a sink writer or a
+     * transcode topology sets the encoder's output type first) */
+    if (impl->output_type && (rate != impl->rate || channels != impl->channels))
+    {
+        IMFMediaType_Release(impl->output_type);
+        impl->output_type = NULL;
+    }
+    impl->rate = rate;
+    impl->channels = channels;
+    if (impl->output_type && FAILED(hr = encoder_try_create_transform(impl)))
+    {
+        IMFMediaType_Release(impl->output_type);
+        impl->output_type = NULL;
+    }
+    return hr;
+}
+
+static HRESULT WINAPI transform_SetOutputType(IMFTransform *iface, DWORD id, IMFMediaType *type, DWORD flags)
+{
+    struct wma_encoder *impl = impl_from_IMFTransform(iface);
+    UINT32 rate, channels, block, bytes, size;
+    IMFMediaType *output;
+    GUID subtype;
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, type %p, flags %#lx.\n", iface, id, type, flags);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    if (!type)
+    {
+        if (flags & MFT_SET_TYPE_TEST_ONLY)
+            return S_OK;
+        if (impl->output_type)
+            IMFMediaType_Release(impl->output_type);
+        impl->output_type = NULL;
+        encoder_destroy_transform(impl);
+        return S_OK;
+    }
+    if (FAILED(hr = get_audio(type, &subtype, &rate, &channels)))
+        return hr;
+    if (!IsEqualGUID(&subtype, &MFAudioFormat_WMAudioV8))
+    {
+        if (IsEqualGUID(&subtype, &MFAudioFormat_WMAudioV9) || IsEqualGUID(&subtype, &MFAudioFormat_WMAudio_Lossless))
+            FIXME("%s output is not supported.\n", debugstr_guid(&subtype));
+        return MF_E_INVALIDMEDIATYPE;
+    }
+    if (impl->input_type && (rate != impl->rate || channels != impl->channels))
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, &bytes)) || bytes * 8 < 24000)
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_BLOCK_ALIGNMENT, &block)) || !block)
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetBlobSize(type, &MF_MT_USER_DATA, &size)))
+        return MF_E_INVALIDMEDIATYPE;
+    if (flags & MFT_SET_TYPE_TEST_ONLY)
+        return S_OK;
+
+    /* the encoder is asked for the block's bit rate */
+    if (FAILED(hr = create_output_type(rate, channels, block, NULL, 0, &output)))
+        return hr;
+    if (impl->output_type)
+        IMFMediaType_Release(impl->output_type);
+    impl->output_type = output;
+    impl->block_align = block;
+    impl->rate = rate;
+    impl->channels = channels;
+    if (impl->input_type && FAILED(hr = encoder_try_create_transform(impl)))
+    {
+        IMFMediaType_Release(impl->output_type);
+        impl->output_type = NULL;
+    }
+    return hr;
+}
+
+static HRESULT copy_type(IMFMediaType *from, IMFMediaType **out)
+{
+    IMFMediaType *type;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&type)))
+        return hr;
+    if (SUCCEEDED(hr = IMFMediaType_CopyAllItems(from, (IMFAttributes *)type)))
+        IMFMediaType_AddRef(*out = type);
+    IMFMediaType_Release(type);
+    return hr;
+}
