From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cmd, wscript: SG Defender scans a script before it runs

SG Defender's real-time protection for scripts: cmd scans a batch file, and
wscript/cscript a script, before running it (through 9456's
__wine_sg_defender_scan, the open file passed). One that holds malware is not
run: cmd prints the error and its errorlevel is 225; the script host reports
it and exits 225. Gate test-defender-exec.
---
--- a/programs/cmd/batch.c
+++ b/programs/cmd/batch.c
@@ -72,11 +72,38 @@
  * a label to goto once opened.
  */
 
+/* Stained Glass OS: SG Defender's real-time protection -- a batch file is
+ * scanned before cmd runs it; one that holds malware is not run, and cmd
+ * says why (ERROR_VIRUS_INFECTED, the errorlevel too). */
+static BOOL batch_blocked(const WCHAR *file)
+{
+    static LONG (CDECL *scan)(HANDLE, const void *, ULONG, const WCHAR *, ULONG);
+    LONG status;
+    HANDLE h;
+
+    if (!scan) scan = (void *)GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "__wine_sg_defender_scan");
+    if (!scan) return FALSE;
+    h = CreateFileW(file, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                    NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h == INVALID_HANDLE_VALUE) return FALSE;
+    status = scan(h, NULL, 0, NULL, 2);
+    CloseHandle(h);
+    return status == (LONG)0xc0000906 /* STATUS_VIRUS_INFECTED */;
+}
+
 RETURN_CODE WCMD_call_batch(const WCHAR *file, WCHAR *command)
 {
     BATCH_CONTEXT *prev_context;
     RETURN_CODE return_code = NO_ERROR;
 
+    if (batch_blocked(file))
+    {
+        SetLastError(ERROR_VIRUS_INFECTED);
+        WCMD_print_error();
+        errorlevel = ERROR_VIRUS_INFECTED;
+        return ERROR_VIRUS_INFECTED;
+    }
+
     /* Create a context structure for this batch file. */
     prev_context = context;
     context = malloc(sizeof (BATCH_CONTEXT));
--- a/programs/wscript/main.c
+++ b/programs/wscript/main.c
@@ -978,6 +978,38 @@
     return TRUE;
 }
 
+/* Stained Glass OS: SG Defender's real-time protection -- the script is
+ * scanned before the host runs it (as Windows Defender, the script hosts'
+ * AMSI provider, does); one that holds malware is not run, and the host
+ * says why. */
+static BOOL script_blocked(const WCHAR *path)
+{
+    static LONG (CDECL *scan)(HANDLE, const void *, ULONG, const WCHAR *, ULONG);
+    WCHAR msg[MAX_PATH + 300], text[300];
+    LONG status;
+    HANDLE file;
+
+    if(!scan)
+        scan = (void *)GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "__wine_sg_defender_scan");
+    if(!scan)
+        return FALSE;
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                       OPEN_EXISTING, 0, NULL);
+    if(file == INVALID_HANDLE_VALUE)
+        return FALSE;
+    status = scan(file, NULL, 0, NULL, 2);
+    CloseHandle(file);
+    if(status != (LONG)0xc0000906 /* STATUS_VIRUS_INFECTED */)
+        return FALSE;
+    if(!FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL, ERROR_VIRUS_INFECTED, 0,
+                       text, ARRAY_SIZE(text), NULL))
+        lstrcpyW(text, L"The file contains a virus.");
+    swprintf(msg, ARRAY_SIZE(msg), L"%s: %s", path, text);
+    report_host_error(msg);
+    script_exit_code = ERROR_VIRUS_INFECTED;
+    return TRUE;
+}
+
 int WINAPI wWinMain(HINSTANCE hInst, HINSTANCE hPrevInst, LPWSTR cmdline, int cmdshow)
 {
     WCHAR *ext, *filepart, *filename = NULL;
@@ -1015,6 +1047,8 @@
         return 1;
 
     ext = wcsrchr(filepart, '.');
+    if(script_blocked(scriptFullName))
+        return ERROR_VIRUS_INFECTED;
 #ifndef SG_MUTANT_WSH_NO_WSF
     if(ext && !wcsicmp(ext, L".wsf")) {
         CoInitialize(NULL);
