From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: no handler info for the PNG text and gamma metadata readers

The Wine tests (todo) record that GetMetadataHandlerInfo of the readers of the PNG tEXt and gAMA chunks
fails with WINCODEC_ERR_COMPONENTNOTFOUND on Windows, while GetMetadataFormat still works. The
format no longer goes through the public method, so it keeps working for these two.
---
--- a/dlls/windowscodecs/metadatahandler.c
+++ b/dlls/windowscodecs/metadatahandler.c
@@ -145,15 +145,12 @@ static ULONG WINAPI MetadataHandler_Release(IWICMetadataWriter *iface)
     return ref;
 }
 
-static HRESULT WINAPI MetadataHandler_GetMetadataHandlerInfo(IWICMetadataWriter *iface,
-    IWICMetadataHandlerInfo **ppIHandler)
+static HRESULT metadata_handler_get_info(IWICMetadataWriter *iface, IWICMetadataHandlerInfo **ppIHandler)
 {
     HRESULT hr;
     IWICComponentInfo *component_info;
     MetadataHandler *This = impl_from_IWICMetadataWriter(iface);
 
-    TRACE("%p,%p\n", iface, ppIHandler);
-
     hr = CreateComponentInfo(This->vtable->clsid, &component_info);
     if (FAILED(hr)) return hr;
 
@@ -164,6 +161,23 @@ static HRESULT WINAPI MetadataHandler_GetMetadataHandlerInfo(IWICMetadataWriter
     return hr;
 }
 
+static HRESULT WINAPI MetadataHandler_GetMetadataHandlerInfo(IWICMetadataWriter *iface,
+    IWICMetadataHandlerInfo **ppIHandler)
+{
+    MetadataHandler *This = impl_from_IWICMetadataWriter(iface);
+
+    TRACE("%p,%p\n", iface, ppIHandler);
+
+    /* native has no handler info for the readers of the PNG text and gamma chunks */
+#ifndef SG_MUTANT_WICMD_PNG_INFO
+    if (IsEqualCLSID(This->vtable->clsid, &CLSID_WICPngTextMetadataReader)
+            || IsEqualCLSID(This->vtable->clsid, &CLSID_WICPngGamaMetadataReader))
+        return WINCODEC_ERR_COMPONENTNOTFOUND;
+#endif
+
+    return metadata_handler_get_info(iface, ppIHandler);
+}
+
 static HRESULT WINAPI MetadataHandler_GetMetadataFormat(IWICMetadataWriter *iface,
     GUID *pguidMetadataFormat)
 {
@@ -174,7 +188,7 @@ static HRESULT WINAPI MetadataHandler_GetMetadataFormat(IWICMetadataWriter *ifac
 
     if (!pguidMetadataFormat) return E_INVALIDARG;
 
-    hr = MetadataHandler_GetMetadataHandlerInfo(iface, &metadata_info);
+    hr = metadata_handler_get_info(iface, &metadata_info);
     if (FAILED(hr)) return hr;
 
     hr = IWICMetadataHandlerInfo_GetMetadataFormat(metadata_info, pguidMetadataFormat);
--- a/dlls/windowscodecs/tests/metadata.c
+++ b/dlls/windowscodecs/tests/metadata.c
@@ -690,7 +690,6 @@ static void test_metadata_tEXt(void)
     load_stream(reader, metadata_tEXt, sizeof(metadata_tEXt), WICPersistOptionDefault);
 
     hr = IWICMetadataReader_GetMetadataHandlerInfo(reader, &info);
-    todo_wine
     ok(hr == WINCODEC_ERR_COMPONENTNOTFOUND, "Unexpected hr %#lx.\n", hr);
     if (SUCCEEDED(hr))
         IWICMetadataHandlerInfo_Release(info);
@@ -831,7 +830,6 @@ static void test_metadata_gAMA(void)
     load_stream(reader, metadata_gAMA, sizeof(metadata_gAMA), WICPersistOptionDefault);
 
     hr = IWICMetadataReader_GetMetadataHandlerInfo(reader, &info);
-    todo_wine
     ok(hr == WINCODEC_ERR_COMPONENTNOTFOUND, "Unexpected hr %#lx.\n", hr);
     if (SUCCEEDED(hr))
         IWICMetadataHandlerInfo_Release(info);
