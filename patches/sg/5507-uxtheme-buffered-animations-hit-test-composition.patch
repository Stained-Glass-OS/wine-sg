+static void fill_dc(HDC hdc, const RECT *rect, COLORREF color)
+{
+    HBRUSH brush = CreateSolidBrush(color);
+
+    FillRect(hdc, rect, brush);
+    DeleteObject(brush);
+}
+
+static void test_buffered_animation(void)
+{
+    static const RECT rect = {0, 0, 16, 16};
+    BP_ANIMATIONPARAMS params = {sizeof(params), 0, BPAS_LINEAR, 0};
+    HDC target, hdc_from, hdc_to;
+    HANIMATIONBUFFER animation;
+    COLORREF color, color2;
+    HBITMAP bitmap, old;
+    HRESULT hr;
+    HWND hwnd;
+    BOOL ret;
+    RECT update;
+    int i;
+
+    if (!pBeginBufferedAnimation || !pBufferedPaintRenderAnimation || !pBufferedPaintStopAllAnimations
+            || !pEndBufferedAnimation)
+    {
+        win_skip("Buffered animation API is not supported.\n");
+        return;
+    }
+
+    hwnd = CreateWindowA("static", "animation", WS_POPUP | WS_VISIBLE, 0, 0, 100, 100, NULL, NULL, NULL, NULL);
+    ok(!!hwnd, "CreateWindow failed, error %lu.\n", GetLastError());
+    ValidateRect(hwnd, NULL);
+
+    target = CreateCompatibleDC(0);
+    bitmap = CreateCompatibleBitmap(GetDC(0), 32, 32);
+    old = SelectObject(target, bitmap);
+    fill_dc(target, &rect, RGB(0, 0, 0));
+
+    hr = pBufferedPaintStopAllAnimations(hwnd);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ret = pBufferedPaintRenderAnimation(hwnd, target);
+    ok(!ret, "Rendered a frame with no animation.\n");
+
+    /* no duration: only the final state is painted, as with a buffered paint */
+    hdc_from = hdc_to = (HDC)0xdeadbeef;
+    animation = pBeginBufferedAnimation(hwnd, target, &rect, BPBF_COMPATIBLEBITMAP, NULL, &params, &hdc_from, &hdc_to);
+    ok(!!animation, "Failed to begin the animation.\n");
+    ok(!hdc_from, "Got the initial state's DC %p.\n", hdc_from);
+    ok(!!hdc_to, "No DC for the final state.\n");
+    fill_dc(hdc_to, &rect, RGB(0, 0, 255));
+    hr = pEndBufferedAnimation(animation, TRUE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    color = GetPixel(target, 4, 4);
+    ok(color == RGB(0, 0, 255), "Got color %#lx.\n", color);
+    ret = pBufferedPaintRenderAnimation(hwnd, target);
+    ok(!ret, "Rendered a frame of an animation with no duration.\n");
+
+    /* not updated: nothing is started and the target is left alone */
+    fill_dc(target, &rect, RGB(0, 0, 0));
+    params.dwDuration = 400;
+    animation = pBeginBufferedAnimation(hwnd, target, &rect, BPBF_COMPATIBLEBITMAP, NULL, &params, &hdc_from, &hdc_to);
+    ok(!!animation, "Failed to begin the animation.\n");
+    ok(!!hdc_from && !!hdc_to && hdc_from != hdc_to, "Got DCs %p, %p.\n", hdc_from, hdc_to);
+    fill_dc(hdc_from, &rect, RGB(255, 0, 0));
+    fill_dc(hdc_to, &rect, RGB(0, 0, 255));
+    hr = pEndBufferedAnimation(animation, FALSE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    color = GetPixel(target, 4, 4);
+    ok(color == RGB(0, 0, 0), "Got color %#lx.\n", color);
+    ret = pBufferedPaintRenderAnimation(hwnd, target);
+    ok(!ret, "Rendered a frame of an animation that was not started.\n");
+
+    /* a fade from red to blue */
+    animation = pBeginBufferedAnimation(hwnd, target, &rect, BPBF_COMPATIBLEBITMAP, NULL, &params, &hdc_from, &hdc_to);
+    ok(!!animation, "Failed to begin the animation.\n");
+    fill_dc(hdc_from, &rect, RGB(255, 0, 0));
+    fill_dc(hdc_to, &rect, RGB(0, 0, 255));
+    ValidateRect(hwnd, NULL);
+    hr = pEndBufferedAnimation(animation, TRUE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    /* the timer asks the window to paint the frames */
+    for (i = 0; i < 20; i++)
+    {
+        Sleep(20);
+        if (GetUpdateRect(hwnd, &update, FALSE)) break;
+    }
+    ok(i < 20, "The window was never asked to paint.\n");
+
+    fill_dc(target, &rect, RGB(0, 255, 0));
+    ret = pBufferedPaintRenderAnimation(hwnd, target);
+    ok(ret, "No frame was rendered.\n");
+    color = GetPixel(target, 4, 4);
+    ok(GetRValue(color) > 0 && GetGValue(color) == 0, "Got color %#lx, expected a mix of red and blue.\n", color);
+    Sleep(600);
+    ret = pBufferedPaintRenderAnimation(hwnd, target);
+    ok(ret, "No frame was rendered after the duration.\n");
+    color = GetPixel(target, 4, 4);
+    ok(color == RGB(0, 0, 255), "Got color %#lx, expected the final state.\n", color);
+    ret = pBufferedPaintRenderAnimation(hwnd, target);
+    ok(!ret, "Rendered a frame after the end of the animation.\n");
+
+    /* the frames move from one state to the other */
+    params.dwDuration = 4000;
+    animation = pBeginBufferedAnimation(hwnd, target, &rect, BPBF_COMPATIBLEBITMAP, NULL, &params, &hdc_from, &hdc_to);
+    ok(!!animation, "Failed to begin the animation.\n");
+    fill_dc(hdc_from, &rect, RGB(255, 0, 0));
+    fill_dc(hdc_to, &rect, RGB(0, 0, 255));
+    hr = pEndBufferedAnimation(animation, TRUE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ret = pBufferedPaintRenderAnimation(hwnd, target);
+    ok(ret, "No frame was rendered.\n");
+    color = GetPixel(target, 4, 4);
+    Sleep(800);
+    ret = pBufferedPaintRenderAnimation(hwnd, target);
+    ok(ret, "No frame was rendered.\n");
+    color2 = GetPixel(target, 4, 4);
+    ok(GetBValue(color2) > GetBValue(color) && GetRValue(color2) < GetRValue(color),
+       "Got colors %#lx then %#lx, expected a move from red to blue.\n", color, color2);
+    ok(color2 != RGB(0, 0, 255), "The animation ended early.\n");
+
+    /* stopping it */
+    hr = pBufferedPaintStopAllAnimations(hwnd);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ret = pBufferedPaintRenderAnimation(hwnd, target);
+    ok(!ret, "Rendered a frame of a stopped animation.\n");
+
+    /* a new fade in the same window replaces the one running */
+    for (i = 0; i < 2; i++)
+    {
+        animation = pBeginBufferedAnimation(hwnd, target, &rect, BPBF_COMPATIBLEBITMAP, NULL, &params, &hdc_from, &hdc_to);
+        fill_dc(hdc_from, &rect, i ? RGB(0, 255, 0) : RGB(255, 0, 0));
+        fill_dc(hdc_to, &rect, RGB(0, 0, 255));
+        pEndBufferedAnimation(animation, TRUE);
+    }
+    ret = pBufferedPaintRenderAnimation(hwnd, target);
+    ok(ret, "No frame was rendered.\n");
+    color = GetPixel(target, 4, 4);
+    ok(GetRValue(color) < 30 && GetGValue(color) > 200, "Got color %#lx, expected the second fade's start.\n", color);
+    pBufferedPaintStopAllAnimations(hwnd);
+
+    SelectObject(target, old);
+    DeleteObject(bitmap);
+    DeleteDC(target);
+    DestroyWindow(hwnd);
+}
