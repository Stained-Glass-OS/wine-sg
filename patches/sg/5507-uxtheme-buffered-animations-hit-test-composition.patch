-    return NULL;
+    if (phdcFrom) *phdcFrom = NULL;
+    if (phdcTo) *phdcTo = NULL;
+
+    if (!rcTarget || !pAnimationParams || pAnimationParams->cbSize < sizeof(*pAnimationParams))
+        return NULL;
+
+    if (!(animation = calloc(1, sizeof(*animation)))) return NULL;
+    animation->hwnd = hwnd;
+    animation->rect = *rcTarget;
+    animation->style = pAnimationParams->style;
+    animation->duration = pAnimationParams->dwDuration;
+    if (!(animation->to = create_paintbuffer(hdcTarget, rcTarget, dwFormat, pPaintParams)))
+    {
+        free(animation);
+        return NULL;
+    }
+    /* "if the animation duration is zero, then only phdcTo is returned" */
+    if (animation->duration && animation->style != BPAS_NONE)
+    {
+        if (!IsWindow(hwnd) || !(animation->from = create_paintbuffer(hdcTarget, rcTarget, dwFormat, pPaintParams)))
+        {
+            free_animation(animation);
+            return NULL;
+        }
+        if (phdcFrom) *phdcFrom = animation->from->memorydc;
+    }
+    if (phdcTo) *phdcTo = animation->to->memorydc;
+    return animation;
 }
 
