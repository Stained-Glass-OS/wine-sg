 HRESULT WINAPI EndBufferedAnimation(HANIMATIONBUFFER hbpAnimation, BOOL fUpdateTarget)
 {
-    FIXME("Stub (%p %u)\n", hbpAnimation, fUpdateTarget);
+    struct animation *animation = hbpAnimation;
 
-    return E_NOTIMPL;
+    TRACE("(%p %u)\n", hbpAnimation, fUpdateTarget);
+
+    if (!animation) return E_INVALIDARG;
+
+    if (!fUpdateTarget)
+    {
+        free_animation(animation);
+        return S_OK;
+    }
+
+    if (!animation->from)
+    {
+        /* nothing to fade: the final state is shown at once */
+        if (!copy_paintbuffer(animation->to, animation->to->targetdc, -1))
+            WARN("copying the buffer back failed\n");
+        free_animation(animation);
+        return S_OK;
+    }
+
+    AcquireSRWLockExclusive(&animation_lock);
+    /* a new fade replaces one running in the same window */
+    remove_animations(animation->hwnd, 0);
+    animation->id = next_animation_id++;
+    animation->start = GetTickCount64();
+    list_add_tail(&animations, &animation->entry);
+    /* the window starts at the initial state */
+    copy_paintbuffer(animation->from, animation->from->targetdc, -1);
+#ifdef SG_MUTANT_ANIM_NO_TIMER
+    if (1)
+        animation->timer = NULL;
+    else
+#endif
+    if (!CreateTimerQueueTimer(&animation->timer, NULL, animation_timer, (void *)animation->id, 16, 16,
+                               WT_EXECUTEINTIMERTHREAD))
+        animation->timer = NULL;
+    ReleaseSRWLockExclusive(&animation_lock);
+    return S_OK;
 }
