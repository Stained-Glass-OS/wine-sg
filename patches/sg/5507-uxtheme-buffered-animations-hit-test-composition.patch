+static void test_IsCompositionActive(void)
+{
+    HRESULT (WINAPI *pDwmIsCompositionEnabled)(BOOL *);
+    HMODULE dwmapi = LoadLibraryA("dwmapi.dll");
+    BOOL enabled = FALSE, active;
+    HRESULT hr;
+
+    if (!pIsCompositionActive)
+    {
+        win_skip("IsCompositionActive is not supported.\n");
+        return;
+    }
+    pDwmIsCompositionEnabled = (void *)GetProcAddress(dwmapi, "DwmIsCompositionEnabled");
+    ok(!!pDwmIsCompositionEnabled, "DwmIsCompositionEnabled not found.\n");
+    hr = pDwmIsCompositionEnabled(&enabled);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    SetLastError(0xdeadbeef);
+    active = pIsCompositionActive();
+    ok(active == enabled, "Got %d, DWM says %d.\n", active, enabled);
+    ok(GetLastError() != ERROR_CALL_NOT_IMPLEMENTED, "Got error %lu.\n", GetLastError());
+    FreeLibrary(dwmapi);
+}
