+/* copy a buffer onto its target, with the painting parameters it was made with;
+ * alpha, when not -1, replaces the blend function's constant (a fade frame) */
+static BOOL copy_paintbuffer(const struct paintbuffer *buffer, HDC targetdc, int alpha)
+{
+    int saved = 0;
+    BOOL ret;
+
+    if (buffer->exclude)
+    {
+        saved = SaveDC(targetdc);
+        ExcludeClipRect(targetdc, buffer->exclude_rect.left, buffer->exclude_rect.top,
+                        buffer->exclude_rect.right, buffer->exclude_rect.bottom);
+    }
+    if (buffer->blend || alpha >= 0)
+    {
+        BLENDFUNCTION blend = buffer->blendfunc;
+
+        if (alpha >= 0)
+        {
+            blend.BlendOp = AC_SRC_OVER;
+            blend.BlendFlags = 0;
+            blend.SourceConstantAlpha = alpha;
+            blend.AlphaFormat = 0;
+        }
+        ret = GdiAlphaBlend(targetdc, buffer->rect.left, buffer->rect.top,
+                buffer->rect.right - buffer->rect.left, buffer->rect.bottom - buffer->rect.top,
+                buffer->memorydc, buffer->rect.left, buffer->rect.top,
+                buffer->rect.right - buffer->rect.left, buffer->rect.bottom - buffer->rect.top,
+                blend);
+    }
+    else
+        ret = BitBlt(targetdc, buffer->rect.left, buffer->rect.top,
+                buffer->rect.right - buffer->rect.left, buffer->rect.bottom - buffer->rect.top,
+                buffer->memorydc, buffer->rect.left, buffer->rect.top, SRCCOPY);
+    if (saved) RestoreDC(targetdc, saved);
+    return ret;
+}
