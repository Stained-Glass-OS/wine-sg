@@ -383,9 +541,43 @@ HANIMATIONBUFFER WINAPI BeginBufferedAnimation(HWND hwnd, HDC hdcTarget, const R
  */
 BOOL WINAPI BufferedPaintRenderAnimation(HWND hwnd, HDC hdcTarget)
 {
-    FIXME("Stub (%p %p)\n", hwnd, hdcTarget);
+    struct animation *animation;
+    BOOL ret = FALSE;
+
+    TRACE("(%p %p)\n", hwnd, hdcTarget);
+
+    if (!hdcTarget) return FALSE;
+
+    AcquireSRWLockExclusive(&animation_lock);
+    LIST_FOR_EACH_ENTRY(animation, &animations, struct animation, entry)
+    {
+        ULONGLONG elapsed;
 
-    return FALSE;
+        if (animation->hwnd != hwnd) continue;
+
+        elapsed = GetTickCount64() - animation->start;
+#ifdef SG_MUTANT_ANIM_NO_END
+        elapsed = min(elapsed, animation->duration - 1);
+#endif
+        if (elapsed >= animation->duration)
+        {
+            /* the last frame is the final state; the animation is over */
+            ret = copy_paintbuffer(animation->to, hdcTarget, -1);
+            list_remove(&animation->entry);
+            free_animation(animation);
+        }
+        else
+        {
+            copy_paintbuffer(animation->from, hdcTarget, -1);
+            ret = copy_paintbuffer(animation->to, hdcTarget,
+                                   animation_alpha(animation->style, elapsed, animation->duration));
+        }
+        /* painted: the program has nothing more to draw, whether or not the copy worked */
+        ret = TRUE;
+        break;
+    }
+    ReleaseSRWLockExclusive(&animation_lock);
+    return ret;
 }
 
