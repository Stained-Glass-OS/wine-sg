+static void test_HitTestThemeBackground(void)
+{
+    static const RECT rect = {0, 0, 50, 40};
+    POINT inside = {10, 10}, outside = {60, 10}, below = {10, 50};
+    HRGN hrgn;
+    WORD code;
+    HTHEME theme;
+    HRESULT hr;
+    HWND hwnd;
+
+    if (!pHitTestThemeBackground)
+    {
+        win_skip("HitTestThemeBackground is not supported.\n");
+        return;
+    }
+
+    hwnd = CreateWindowA("button", "hit", WS_POPUP, 0, 0, 100, 100, NULL, NULL, NULL, NULL);
+    theme = OpenThemeData(hwnd, L"Button");
+    if (!theme)
+    {
+        skip("No theme for buttons.\n");
+        DestroyWindow(hwnd);
+        return;
+    }
+
+    code = 0xdead;
+    hr = pHitTestThemeBackground(theme, NULL, BP_PUSHBUTTON, PBS_NORMAL, HTTB_BACKGROUNDSEG, &rect, NULL, inside, &code);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(code == HTCLIENT, "Got code %u.\n", code);
+    hr = pHitTestThemeBackground(theme, NULL, BP_PUSHBUTTON, PBS_NORMAL, HTTB_BACKGROUNDSEG, &rect, NULL, outside, &code);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(code == HTNOWHERE, "Got code %u.\n", code);
+    hr = pHitTestThemeBackground(theme, NULL, BP_PUSHBUTTON, PBS_NORMAL, HTTB_BACKGROUNDSEG, &rect, NULL, below, &code);
+    ok(hr == S_OK && code == HTNOWHERE, "Got hr %#lx, code %u.\n", hr, code);
+
+    hrgn = CreateRectRgn(0, 0, 20, 20);
+    hr = pHitTestThemeBackground(theme, NULL, BP_PUSHBUTTON, PBS_NORMAL, HTTB_BACKGROUNDSEG, &rect, hrgn, inside, &code);
+    ok(hr == S_OK && code == HTCLIENT, "Got hr %#lx, code %u.\n", hr, code);
+    hr = pHitTestThemeBackground(theme, NULL, BP_PUSHBUTTON, PBS_NORMAL, HTTB_BACKGROUNDSEG, &rect, hrgn, outside, &code);
+    ok(hr == S_OK && code == HTNOWHERE, "Got hr %#lx, code %u.\n", hr, code);
+    DeleteObject(hrgn);
+
+    hr = pHitTestThemeBackground(NULL, NULL, BP_PUSHBUTTON, PBS_NORMAL, HTTB_BACKGROUNDSEG, &rect, NULL, inside, &code);
+    ok(hr == E_HANDLE, "Got hr %#lx.\n", hr);
+
+    CloseThemeData(theme);
+    DestroyWindow(hwnd);
+}
