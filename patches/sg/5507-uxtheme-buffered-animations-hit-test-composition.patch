+/* A fade between two buffers the program painted: the initial state ("from")
+ * and the final one ("to"). Frames are drawn on request, in the program's
+ * WM_PAINT, by BufferedPaintRenderAnimation; a timer only asks the window to
+ * paint. */
+struct animation
+{
+    struct list entry;
+    ULONG_PTR id;
+    HWND hwnd;
+    RECT rect;
+    struct paintbuffer *from, *to;  /* from is NULL when there is no fade */
+    BP_ANIMATIONSTYLE style;
+    DWORD duration;
+    ULONGLONG start;
+    HANDLE timer;
+};
+
+static struct list animations = LIST_INIT(animations);
+static ULONG_PTR next_animation_id = 1;
+
+/* the share of the final state in a frame, 0 to 255 */
+static int animation_alpha(BP_ANIMATIONSTYLE style, DWORD elapsed, DWORD duration)
+{
+    double t = (double)elapsed / duration, f;
+
+    switch (style)
+    {
+    case BPAS_CUBIC:
+        f = t < 0.5 ? 4 * t * t * t : 1 - pow(-2 * t + 2, 3) / 2;
+        break;
+    case BPAS_SINE:
+        f = (1 - cos(M_PI * t)) / 2;
+        break;
+    default:
+        f = t;
+        break;
+    }
+#ifdef SG_MUTANT_ANIM_NO_BLEND
+    f = 1;
+#endif
+    return min(255, max(0, (int)(f * 255 + 0.5)));
+}
+
+static void free_animation(struct animation *animation)
+{
+    if (animation->timer) DeleteTimerQueueTimer(NULL, animation->timer, NULL);
+    if (animation->from) free_paintbuffer(animation->from);
+    free_paintbuffer(animation->to);
+    free(animation);
+}
+
+/* with the lock held */
+static void remove_animations(HWND hwnd, DWORD thread)
+{
+    struct animation *animation, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(animation, next, &animations, struct animation, entry)
+    {
+        if (hwnd && animation->hwnd != hwnd) continue;
+        if (thread && GetWindowThreadProcessId(animation->hwnd, NULL) != thread) continue;
+        list_remove(&animation->entry);
+        free_animation(animation);
+    }
+}
+
+static void CALLBACK animation_timer(void *param, BOOLEAN fired)
+{
+    ULONG_PTR id = (ULONG_PTR)param;
+    struct animation *animation;
+    HWND hwnd = NULL;
+    RECT rect;
+
+    AcquireSRWLockExclusive(&animation_lock);
+    LIST_FOR_EACH_ENTRY(animation, &animations, struct animation, entry)
+    {
+        if (animation->id != id) continue;
+        hwnd = animation->hwnd;
+        rect = animation->rect;
+        if (!IsWindow(hwnd))
+        {
+            /* nobody will ever ask for the frames */
+            list_remove(&animation->entry);
+            free_animation(animation);
+            hwnd = NULL;
+        }
+        break;
+    }
+    ReleaseSRWLockExclusive(&animation_lock);
+
+    if (hwnd) InvalidateRect(hwnd, &rect, FALSE);
+}
+
