From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msdasql: statistics and privilege schema rowsets

IDBSchemaRowset gives DBSCHEMA_STATISTICS (the table statistics row of SQLStatistics: CARDINALITY), DBSCHEMA_TABLE_PRIVILEGES (SQLTablePrivileges) and DBSCHEMA_COLUMN_PRIVILEGES (SQLColumnPrivileges); restrictions catalog, schema, table (and column); IS_GRANTABLE from ODBC's YES/NO. They were E_INVALIDARG (unknown schema), so ADO OpenSchema(adSchemaStatistics / adSchemaTablePrivileges / adSchemaColumnPrivileges) failed.
---
--- a/dlls/msdasql/session.c
+++ b/dlls/msdasql/session.c
@@ -845,7 +845,8 @@
  * function's columns they come from */
 enum schema_conv { SC_COPY, SC_NULL, SC_NULLABLE_BOOL, SC_SQLTYPE_TO_DBTYPE, SC_IF_CHAR, SC_IF_NUMERIC, SC_HAS_VALUE,
                    /* (wine-sg 8224) */ SC_RULE, SC_DEFERRABILITY, SC_BOOL, SC_NOT_BOOL, SC_EQ1_BOOL, SC_INDEX_TYPE,
-                   SC_COLLATION, SC_SEARCHABLE, SC_IS_LONG, /* (wine-sg 8230) */ SC_PARAM_TYPE };
+                   SC_COLLATION, SC_SEARCHABLE, SC_IS_LONG, /* (wine-sg 8230) */ SC_PARAM_TYPE,
+                   /* (wine-sg 8232) */ SC_YES_BOOL };
 
 struct schema_col
 {
@@ -3100,6 +3101,35 @@
 };
 #endif
 
+#ifndef SG_MUTANT_NO_STAT_PRIV_SCHEMAS
+/* (wine-sg 8232) statistics (SQLStatistics' table statistics row) and table and column privileges
+ * (SQLTablePrivileges, SQLColumnPrivileges); not in Wine's dbs.idl */
+static const GUID DBSCHEMA_STATISTICS_ = {0xc8b52227,0x5cf3,0x11ce,{0xad,0xe5,0x00,0xaa,0x00,0x44,0x77,0x3d}};
+static const GUID DBSCHEMA_TABLE_PRIVILEGES_ = {0xc8b52222,0x5cf3,0x11ce,{0xad,0xe5,0x00,0xaa,0x00,0x44,0x77,0x3d}};
+static const GUID DBSCHEMA_COLUMN_PRIVILEGES_ = {0xc8b52221,0x5cf3,0x11ce,{0xad,0xe5,0x00,0xaa,0x00,0x44,0x77,0x3d}};
+
+static const struct schema_col statistics_cols[] =
+{
+    { L"TABLE_CATALOG", DBTYPE_WSTR, 1 }, { L"TABLE_SCHEMA", DBTYPE_WSTR, 2 }, { L"TABLE_NAME", DBTYPE_WSTR, 3 },
+    { L"CARDINALITY", DBTYPE_UI8, 11 },
+};
+
+static const struct schema_col table_privileges_cols[] =
+{
+    { L"GRANTOR", DBTYPE_WSTR, 4 }, { L"GRANTEE", DBTYPE_WSTR, 5 }, { L"TABLE_CATALOG", DBTYPE_WSTR, 1 },
+    { L"TABLE_SCHEMA", DBTYPE_WSTR, 2 }, { L"TABLE_NAME", DBTYPE_WSTR, 3 }, { L"PRIVILEGE_TYPE", DBTYPE_WSTR, 6 },
+    { L"IS_GRANTABLE", DBTYPE_BOOL, 7, SC_YES_BOOL },
+};
+
+static const struct schema_col column_privileges_cols[] =
+{
+    { L"GRANTOR", DBTYPE_WSTR, 5 }, { L"GRANTEE", DBTYPE_WSTR, 6 }, { L"TABLE_CATALOG", DBTYPE_WSTR, 1 },
+    { L"TABLE_SCHEMA", DBTYPE_WSTR, 2 }, { L"TABLE_NAME", DBTYPE_WSTR, 3 }, { L"COLUMN_NAME", DBTYPE_WSTR, 4 },
+    { L"COLUMN_GUID", DBTYPE_GUID, 0, SC_NULL }, { L"COLUMN_PROPID", DBTYPE_UI4, 0, SC_NULL },
+    { L"PRIVILEGE_TYPE", DBTYPE_WSTR, 7 }, { L"IS_GRANTABLE", DBTYPE_BOOL, 8, SC_YES_BOOL },
+};
+#endif
+
 static const struct schema_desc schemas[] =
 {
     { &DBSCHEMA_TABLES, 0xf, ARRAY_SIZE(tables_cols), tables_cols },
@@ -3116,6 +3146,12 @@
     { &DBSCHEMA_VIEWS, 0x7, ARRAY_SIZE(views_cols), views_cols },
     { &DBSCHEMA_PROCEDURE_PARAMETERS_, 0xf, ARRAY_SIZE(procedure_parameters_cols), procedure_parameters_cols },
 #endif
+#ifndef SG_MUTANT_NO_STAT_PRIV_SCHEMAS
+    /* restrictions: catalog, schema, table (and the column); ODBC has none on grantor and grantee */
+    { &DBSCHEMA_STATISTICS_, 0x7, ARRAY_SIZE(statistics_cols), statistics_cols },
+    { &DBSCHEMA_TABLE_PRIVILEGES_, 0x7, ARRAY_SIZE(table_privileges_cols), table_privileges_cols },
+    { &DBSCHEMA_COLUMN_PRIVILEGES_, 0xf, ARRAY_SIZE(column_privileges_cols), column_privileges_cols },
+#endif
 };
 
 static BOOL is_char_sqltype( SQLSMALLINT type )
@@ -3193,6 +3229,14 @@
             if (!v->null && wcstol( v->text, NULL, 10 ) == SQL_TABLE_STAT) continue;
         }
 #endif
+#ifndef SG_MUTANT_NO_STAT_PRIV_SCHEMAS
+        /* the statistics schema is SQLStatistics' table statistics row alone */
+        if (desc->cols == statistics_cols)
+        {
+            v = schema_get( rowset->hstmt, cache, 7 );
+            if (v->null || wcstol( v->text, NULL, 10 ) != SQL_TABLE_STAT) continue;
+        }
+#endif
 #ifndef SG_MUTANT_NO_VIEW_PARAM_SCHEMAS
         /* a procedure's result-set columns are no parameters */
         if (desc->cols == procedure_parameters_cols)
@@ -3252,6 +3296,22 @@
         {
             if (col->conv == SC_HAS_VALUE) value = !v->null;
             else if (v->null) continue;
+#ifndef SG_MUTANT_NO_STAT_PRIV_SCHEMAS
+            else if (col->conv == SC_YES_BOOL) value = !wcsicmp( v->text, L"YES" );
+            else if (col->type == DBTYPE_UI8)
+            {
+                if (!(buf = calloc( 1, 8 )))
+                {
+                    hr = E_OUTOFMEMORY;
+                    break;
+                }
+                *(ULONGLONG *)buf = _wcstoui64( v->text, NULL, 10 );
+                cells[i].len = 8;
+                cells[i].data = buf;
+                cells[i].status = DBSTATUS_S_OK;
+                continue;
+            }
+#endif
 #ifndef SG_MUTANT_NO_MORE_SCHEMAS
             else if (col->conv == SC_COLLATION) value = v->text[0] == 'D' ? DB_COLLATION_DESC : DB_COLLATION_ASC;
 #endif
@@ -3341,6 +3401,7 @@
         case DBTYPE_GUID: info[i].ulColumnSize = sizeof(GUID); break;
         case DBTYPE_DATE: info[i].ulColumnSize = sizeof(DATE); break;
         case DBTYPE_BOOL: case DBTYPE_I2: case DBTYPE_UI2: info[i].ulColumnSize = 2; break;
+        case DBTYPE_UI8: info[i].ulColumnSize = 8; break;
         default: info[i].ulColumnSize = 4; break;
         }
         info[i].bPrecision = ~0;
@@ -3443,6 +3504,16 @@
         ret = SQLProcedureColumnsW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2],
                                     len[2], (SQLWCHAR *)r[3], len[3] );
 #endif
+#ifndef SG_MUTANT_NO_STAT_PRIV_SCHEMAS
+    else if (desc->cols == statistics_cols)
+        ret = SQLStatisticsW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2], len[2],
+                              SQL_INDEX_ALL, SQL_QUICK );
+    else if (desc->cols == table_privileges_cols)
+        ret = SQLTablePrivilegesW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2], len[2] );
+    else if (desc->cols == column_privileges_cols)
+        ret = SQLColumnPrivilegesW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2],
+                                    len[2], (SQLWCHAR *)r[3], len[3] );
+#endif
     else
         ret = SQLPrimaryKeysW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2], len[2] );
     if (!SQL_SUCCEEDED(ret))
