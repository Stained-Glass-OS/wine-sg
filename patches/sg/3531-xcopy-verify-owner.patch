From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] xcopy: /V /O /X, accept /Z /G /B /J (3531)

xcopy: /V /O /X, accept /Z /G /B /J

xcopy /V reads both files back and fails the copy on a difference (error 23); /O copies owner, group and DACL, /X also the audit settings; /Z /G /B /J are accepted (the copy is the same). Conformance xcopy 64/32: 23 tests, no failures.
---
--- a/programs/xcopy/xcopy.c
+++ b/programs/xcopy/xcopy.c
@@ -22,11 +22,7 @@
  * FIXME:
  * This should now support all options listed in the xcopy help from
  * windows XP except:
- *  /Z - Copy from network drives in restartable mode
- *  /X - Copy file audit settings (sets /O)
- *  /O - Copy file ownership + ACL info
- *  /G - Copy encrypted files to unencrypted destination
- *  /V - Verifies files
+ *  (/Z /G /B /J are accepted: they change how a copy is made, not its result here)
  */
 
 /*
@@ -45,6 +41,7 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <windows.h>
+#include <aclapi.h>
 #include <wine/debug.h>
 #include "xcopy.h"
 
@@ -325,6 +322,50 @@
     return FALSE;
 }
 
+
+/* =========================================================================
+   XCOPY_Verify - /V: read both files back and compare them
+   ========================================================================= */
+static BOOL XCOPY_Verify(const WCHAR *from, const WCHAR *to)
+{
+    HANDLE a, b;
+    char bufa[16384], bufb[16384];
+    DWORD na, nb;
+    BOOL same = TRUE;
+
+    a = CreateFileW(from, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, 0);
+    b = CreateFileW(to, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, 0);
+    if (a == INVALID_HANDLE_VALUE || b == INVALID_HANDLE_VALUE) same = FALSE;
+    while (same) {
+        if (!ReadFile(a, bufa, sizeof(bufa), &na, NULL) || !ReadFile(b, bufb, sizeof(bufb), &nb, NULL)) same = FALSE;
+        else if (na != nb || memcmp(bufa, bufb, na)) same = FALSE;
+        else if (!na) break;
+    }
+    if (a != INVALID_HANDLE_VALUE) CloseHandle(a);
+    if (b != INVALID_HANDLE_VALUE) CloseHandle(b);
+    return same;
+}
+
+/* =========================================================================
+   XCOPY_CopySecurity - /O: owner, group and ACL (and with /X the audit
+   settings) of the source go to the copy. Returns the error code or 0.
+   ========================================================================= */
+static DWORD XCOPY_CopySecurity(const WCHAR *from, const WCHAR *to, DWORD flags)
+{
+    SECURITY_INFORMATION info = OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION;
+    PSECURITY_DESCRIPTOR sd = NULL;
+    PSID owner = NULL, group = NULL;
+    PACL dacl = NULL, sacl = NULL;
+    DWORD err;
+
+    if (flags & OPT_AUDIT) info |= SACL_SECURITY_INFORMATION;
+    err = GetNamedSecurityInfoW(from, SE_FILE_OBJECT, info, &owner, &group, &dacl, &sacl, &sd);
+    if (err) return err;
+    err = SetNamedSecurityInfoW((WCHAR *)to, SE_FILE_OBJECT, info, owner, group, dacl, sacl);
+    LocalFree(sd);
+    return err;
+}
+
 /* =========================================================================
    XCOPY_DoCopy - Recursive function to copy files based on input parms
      of a stem and a spec
@@ -344,7 +385,7 @@
     BOOL            findres = TRUE;
     WCHAR           *inputpath, *outputpath;
     BOOL            copiedFile = FALSE;
-    DWORD           destAttribs, srcAttribs;
+    DWORD           destAttribs, srcAttribs, error;
     BOOL            skipFile;
     int             ret = 0;
 
@@ -545,7 +586,7 @@
                     /* Skip copy */
                 } else if (CopyFileW(copyFrom, copyTo, FALSE) == 0) {
 
-                    DWORD error = GetLastError();
+                    error = GetLastError();
                     XCOPY_wprintf(XCOPY_LoadMessage(STRING_COPYFAIL),
                            copyFrom, copyTo, error);
                     XCOPY_FailMessage(error);
@@ -556,6 +597,24 @@
                         ret = RC_WRITEERROR;
                         goto cleanup;
                     }
+                } else if ((flags & OPT_VERIFY) && !XCOPY_Verify(copyFrom, copyTo)) {
+                    XCOPY_wprintf(XCOPY_LoadMessage(STRING_COPYFAIL), copyFrom, copyTo, (DWORD)ERROR_CRC);
+                    XCOPY_FailMessage(ERROR_CRC);
+                    if (flags & OPT_IGNOREERRORS) {
+                        skipFile = TRUE;
+                    } else {
+                        ret = RC_WRITEERROR;
+                        goto cleanup;
+                    }
+                } else if ((flags & OPT_OWNER) && (error = XCOPY_CopySecurity(copyFrom, copyTo, flags))) {
+                    XCOPY_wprintf(XCOPY_LoadMessage(STRING_COPYFAIL), copyFrom, copyTo, error);
+                    XCOPY_FailMessage(error);
+                    if (flags & OPT_IGNOREERRORS) {
+                        skipFile = TRUE;
+                    } else {
+                        ret = RC_WRITEERROR;
+                        goto cleanup;
+                    }
                 } else {
 
                     if (!skipFile) {
@@ -839,9 +898,11 @@
                           break;
                 case '?': XCOPY_wprintf(XCOPY_LoadMessage(STRING_HELP));
                           exit(RC_OK);
-                case 'V':
-                    WINE_FIXME("ignoring /V\n");
-                    break;
+                case 'V': flags |= OPT_VERIFY;        break;
+                case 'O': flags |= OPT_OWNER;         break;
+                case 'X': flags |= OPT_OWNER | OPT_AUDIT; break;
+                /* restartable mode, decrypted copies, links and unbuffered I/O: same files either way */
+                case 'Z': case 'G': case 'B': case 'J': break;
                 default:
                     WINE_TRACE("Unhandled parameter '%s'\n", wine_dbgstr_w(p));
                     XCOPY_wprintf(XCOPY_LoadMessage(STRING_INVPARM), p);
--- a/programs/xcopy/xcopy.h
+++ b/programs/xcopy/xcopy.h
@@ -48,6 +48,9 @@
 #define OPT_DATERANGE    0x00040000
 #define OPT_DATENEWER    0x00080000
 #define OPT_KEEPATTRS    0x00100000
+#define OPT_VERIFY       0x00200000
+#define OPT_OWNER        0x00400000
+#define OPT_AUDIT        0x00800000
 
 #define MAXSTRING 8192
 
