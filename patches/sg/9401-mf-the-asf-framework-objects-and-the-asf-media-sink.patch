+/* stream configuration */
+
+struct payload_extension
+{
+    GUID system_id;
+    WORD data_size;
+    BYTE *info;
+    DWORD info_size;
+};
+
+struct stream_config
+{
+    IMFASFStreamConfig IMFASFStreamConfig_iface;
+    LONG refcount;
+    IMFAttributes *attributes;
+    IMFMediaType *media_type;
+    WORD number;
+    struct payload_extension *extensions;
+    WORD extension_count;
+};
+
+static struct stream_config *impl_from_IMFASFStreamConfig(IMFASFStreamConfig *iface)
+{
+    return CONTAINING_RECORD(iface, struct stream_config, IMFASFStreamConfig_iface);
+}
+
+static HRESULT WINAPI stream_config_QueryInterface(IMFASFStreamConfig *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFASFStreamConfig) || IsEqualIID(riid, &IID_IMFAttributes)
+            || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFASFStreamConfig_AddRef(iface);
+        return S_OK;
+    }
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI stream_config_AddRef(IMFASFStreamConfig *iface)
+{
+    struct stream_config *config = impl_from_IMFASFStreamConfig(iface);
+    return InterlockedIncrement(&config->refcount);
+}
+
+static void stream_config_clear_extensions(struct stream_config *config)
+{
+    WORD i;
+
+    for (i = 0; i < config->extension_count; i++)
+        free(config->extensions[i].info);
+    free(config->extensions);
+    config->extensions = NULL;
+    config->extension_count = 0;
+}
+
+static ULONG WINAPI stream_config_Release(IMFASFStreamConfig *iface)
+{
+    struct stream_config *config = impl_from_IMFASFStreamConfig(iface);
+    ULONG refcount = InterlockedDecrement(&config->refcount);
+
+    if (!refcount)
+    {
+        if (config->media_type)
+            IMFMediaType_Release(config->media_type);
+        IMFAttributes_Release(config->attributes);
+        stream_config_clear_extensions(config);
+        free(config);
+    }
+    return refcount;
+}
