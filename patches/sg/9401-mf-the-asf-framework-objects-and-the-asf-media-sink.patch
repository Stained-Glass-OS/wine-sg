+#define DATA_OBJECT_HEADER 50
+
+/* a growing byte buffer; failed is set once an allocation fails */
+struct buffer
+{
+    BYTE *data;
+    SIZE_T size, capacity;
+    BOOL failed;
+};
+
+static void put(struct buffer *buffer, const void *data, SIZE_T size)
+{
+    if (buffer->failed) return;
+    if (buffer->size + size > buffer->capacity)
+    {
+        SIZE_T capacity = max(buffer->capacity * 2, buffer->size + size + 256);
+        BYTE *new_data = realloc(buffer->data, capacity);
+        if (!new_data) { buffer->failed = TRUE; return; }
+        buffer->data = new_data;
+        buffer->capacity = capacity;
+    }
+    if (data) memcpy(buffer->data + buffer->size, data, size);
+    else memset(buffer->data + buffer->size, 0, size);
+    buffer->size += size;
+}
+
+static void put_word(struct buffer *buffer, WORD value) { put(buffer, &value, 2); }
+static void put_dword(struct buffer *buffer, DWORD value) { put(buffer, &value, 4); }
+static void put_qword(struct buffer *buffer, UINT64 value) { put(buffer, &value, 8); }
+
+static WORD get_word(const BYTE *p) { WORD v; memcpy(&v, p, 2); return v; }
+static DWORD get_dword(const BYTE *p) { DWORD v; memcpy(&v, p, 4); return v; }
+static UINT64 get_qword(const BYTE *p) { UINT64 v; memcpy(&v, p, 8); return v; }
+
+DWORD asf_profile_packet_size(IMFASFProfile *profile)
+{
+    UINT32 min_size = 0, max_size = 0;
+
+    if (SUCCEEDED(IMFASFProfile_GetUINT32(profile, &MF_ASFPROFILE_MAXPACKETSIZE, &max_size)) && max_size >= 100)
+        return max_size;
+    if (SUCCEEDED(IMFASFProfile_GetUINT32(profile, &MF_ASFPROFILE_MINPACKETSIZE, &min_size)) && min_size >= 100)
+        return min_size;
+    return ASF_DEFAULT_PACKET_SIZE;
+}
+
+void asf_stream_rate(IMFASFStreamConfig *stream, DWORD *bitrate, DWORD *window)
+{
+    DWORD bucket[3] = {0};
+    UINT32 size = 0, value;
+    IMFMediaType *type;
+
+    *bitrate = 0;
+    *window = MFASF_DEFAULT_BUFFER_WINDOW_MS;
+    if (SUCCEEDED(IMFASFStreamConfig_GetBlob(stream, &MF_ASFSTREAMCONFIG_LEAKYBUCKET1, (UINT8 *)bucket,
+            sizeof(bucket), &size)) && size >= 8)
+    {
+        *bitrate = bucket[0];
+        *window = bucket[1];
+    }
+    if (*bitrate || FAILED(IMFASFStreamConfig_GetMediaType(stream, &type)))
+        return;
+    if (SUCCEEDED(IMFMediaType_GetUINT32(type, &MF_MT_AVG_BITRATE, &value)) && value)
+        *bitrate = value;
+    else if (SUCCEEDED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, &value)))
+        *bitrate = value * 8;
+    IMFMediaType_Release(type);
+}
+
+/* the stream properties' type-specific data: a WAVEFORMATEX, or the encoded size and a BITMAPINFOHEADER
+ * (whose codec data follows it) */
+static HRESULT stream_type_data(IMFMediaType *type, BOOL *video, UINT64 *time_per_frame, struct buffer *out)
+{
+    GUID major, subtype;
+    HRESULT hr;
+
+    *video = FALSE;
+    *time_per_frame = 0;
+    if (FAILED(hr = IMFMediaType_GetMajorType(type, &major)))
+        return hr;
+    if (IsEqualGUID(&major, &MFMediaType_Audio))
+    {
+        WAVEFORMATEX *wfx;
+        UINT32 size;
+
+        if (FAILED(hr = MFCreateWaveFormatExFromMFMediaType(type, &wfx, &size, MFWaveFormatExConvertFlag_Normal)))
+            return hr;
+        put(out, wfx, 16);
+        put_word(out, size > sizeof(WAVEFORMATEX) ? size - sizeof(WAVEFORMATEX) : 0);
+        if (size > sizeof(WAVEFORMATEX))
+            put(out, wfx + 1, size - sizeof(WAVEFORMATEX));
+        CoTaskMemFree(wfx);
+    }
+    else if (IsEqualGUID(&major, &MFMediaType_Video))
+    {
+        UINT32 width = 0, height = 0, extra = 0, numerator = 0, denominator = 0;
+        BITMAPINFOHEADER bih = {0};
+        UINT64 frame_size, rate;
+        BYTE *user_data = NULL;
+
+        *video = TRUE;
+        if (FAILED(hr = IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)))
+            return hr;
+        if (SUCCEEDED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_SIZE, &frame_size)))
+        {
+            width = frame_size >> 32;
+            height = (UINT32)frame_size;
+        }
+        if (SUCCEEDED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_RATE, &rate)))
+        {
+            numerator = rate >> 32;
+            denominator = (UINT32)rate;
+            if (numerator)
+                *time_per_frame = (UINT64)10000000 * denominator / numerator;
+        }
+        IMFMediaType_GetAllocatedBlob(type, &MF_MT_USER_DATA, &user_data, &extra);
+        bih.biSize = sizeof(bih) + extra;
+        bih.biWidth = width;
+        bih.biHeight = height;
+        bih.biPlanes = 1;
+        bih.biBitCount = 24;
+        bih.biCompression = subtype.Data1;
+        put_dword(out, width);
+        put_dword(out, height);
+        put(out, "\x02", 1);
+        put_word(out, bih.biSize);
+        put(out, &bih, sizeof(bih));
+        if (extra)
+            put(out, user_data, extra);
+        CoTaskMemFree(user_data);
+    }
+    else
+    {
+        FIXME("Unsupported major type %s.\n", debugstr_guid(&major));
+        return MF_E_ASF_UNSUPPORTED_STREAM_TYPE;
+    }
+    return out->failed ? E_OUTOFMEMORY : S_OK;
+}
+
+/* a media type from the stream properties' type-specific data */
+static HRESULT media_type_from_type_data(const GUID *stream_type, const BYTE *data, DWORD size, UINT64 time_per_frame,
+        IMFMediaType **out)
+{
+    IMFMediaType *type;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&type)))
+        return hr;
+    if (IsEqualGUID(stream_type, &asf_audio_media) && size >= 16)
+    {
+        WAVEFORMATEX *wfx;
+        WORD extra = size >= 18 ? get_word(data + 16) : 0;
+        DWORD wfx_size = sizeof(WAVEFORMATEX) + min(extra, size > 18 ? size - 18 : 0);
+
+        if (!(wfx = calloc(1, max(wfx_size, sizeof(WAVEFORMATEX)))))
+            hr = E_OUTOFMEMORY;
+        else
+        {
+            memcpy(wfx, data, min(size, wfx_size));
+            wfx->cbSize = wfx_size - sizeof(WAVEFORMATEX);
+            hr = MFInitMediaTypeFromWaveFormatEx(type, wfx, wfx_size);
+            free(wfx);
+        }
+    }
+    else if (IsEqualGUID(stream_type, &asf_video_media) && size >= 11 + sizeof(BITMAPINFOHEADER))
+    {
+        const BYTE *bih_data = data + 11;
+        DWORD bih_size = min(get_word(data + 9), size - 11);
+        BITMAPINFOHEADER bih;
+        GUID subtype = MFVideoFormat_Base;
+
+        memcpy(&bih, bih_data, sizeof(bih));
+        subtype.Data1 = bih.biCompression;
+        IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Video);
+        IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, &subtype);
+        IMFMediaType_SetUINT64(type, &MF_MT_FRAME_SIZE, (UINT64)get_dword(data) << 32 | get_dword(data + 4));
+        IMFMediaType_SetUINT32(type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);
+        IMFMediaType_SetUINT64(type, &MF_MT_PIXEL_ASPECT_RATIO, (UINT64)1 << 32 | 1);
+        IMFMediaType_SetUINT32(type, &MF_MT_COMPRESSED, 1);
+        if (time_per_frame)
+        {
+            UINT64 numerator = 10000000, denominator = time_per_frame;
+            /* the common NTSC rates are kept exact */
+            if (time_per_frame == 333667) { numerator = 30000; denominator = 1001; }
+            else if (time_per_frame == 417083) { numerator = 24000; denominator = 1001; }
+            IMFMediaType_SetUINT64(type, &MF_MT_FRAME_RATE, numerator << 32 | denominator);
+        }
+        if (bih_size > sizeof(bih))
+            hr = IMFMediaType_SetBlob(type, &MF_MT_USER_DATA, bih_data + sizeof(bih), bih_size - sizeof(bih));
+    }
+    else
+    {
+        FIXME("Unsupported stream type %s.\n", debugstr_guid(stream_type));
+        hr = MF_E_ASF_UNSUPPORTED_STREAM_TYPE;
+    }
+    if (FAILED(hr))
+    {
+        IMFMediaType_Release(type);
+        return hr;
+    }
+    *out = type;
+    return S_OK;
+}
+
+/* content info */
+
+struct stream_extra
+{
+    WORD number;
+    DWORD max_object;
+    UINT64 time_per_frame;
+};
+
+struct content_info
+{
+    IMFASFContentInfo IMFASFContentInfo_iface;
+    LONG refcount;
+    IMFASFProfile *profile;
+    struct asf_file_info file;
+    struct stream_extra extras[MFASF_MAX_STREAM_NUMBER + 1];
+    IPropertyStore *stores[MFASF_MAX_STREAM_NUMBER + 1];
+};
+
+static struct content_info *impl_from_IMFASFContentInfo(IMFASFContentInfo *iface)
+{
+    return CONTAINING_RECORD(iface, struct content_info, IMFASFContentInfo_iface);
+}
+
+static HRESULT WINAPI content_info_QueryInterface(IMFASFContentInfo *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFASFContentInfo) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFASFContentInfo_AddRef(iface);
+        return S_OK;
+    }
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI content_info_AddRef(IMFASFContentInfo *iface)
+{
+    return InterlockedIncrement(&impl_from_IMFASFContentInfo(iface)->refcount);
+}
+
+static ULONG WINAPI content_info_Release(IMFASFContentInfo *iface)
+{
+    struct content_info *info = impl_from_IMFASFContentInfo(iface);
+    ULONG refcount = InterlockedDecrement(&info->refcount);
+    unsigned int i;
+
+    if (!refcount)
+    {
+        if (info->profile)
+            IMFASFProfile_Release(info->profile);
+        for (i = 0; i < ARRAY_SIZE(info->stores); i++)
+            if (info->stores[i])
+                IPropertyStore_Release(info->stores[i]);
+        free(info);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI content_info_GetHeaderSize(IMFASFContentInfo *iface, IMFMediaBuffer *buffer, QWORD *size)
+{
+    DWORD length;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p.\n", iface, buffer, size);
+
+    if (!buffer || !size)
+        return E_INVALIDARG;
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &length)))
+        return hr;
+    if (length < MFASF_MIN_HEADER_BYTES)
+        hr = MF_E_ASF_PARSINGINCOMPLETE;
+    else if (memcmp(data, &asf_header_object, sizeof(GUID)))
+        hr = MF_E_ASF_INVALIDDATA;
+    else
+        *size = get_qword(data + 16);
+    IMFMediaBuffer_Unlock(buffer);
+    return hr;
+}
+
+/* the profile's stream number -> index of extras (created on demand) */
+static struct stream_extra *content_info_extra(struct content_info *info, WORD number)
+{
+    if (number > MFASF_MAX_STREAM_NUMBER)
+        return NULL;
+    info->extras[number].number = number;
+    return &info->extras[number];
+}
+
+static HRESULT parse_extension(struct content_info *info, const BYTE *data, UINT64 size)
+{
+    UINT64 pos = 0;
+
+    while (pos + 24 <= size)
+    {
+        UINT64 object_size = get_qword(data + pos + 16);
+
+        if (object_size < 24 || object_size > size - pos)
+            return MF_E_ASF_INVALIDDATA;
+        if (!memcmp(data + pos, &asf_extended_stream_properties, sizeof(GUID)) && object_size >= 88)
+        {
+            const BYTE *esp = data + pos + 24;
+            struct stream_extra *extra = content_info_extra(info, get_word(esp + 48) & 0x7f);
+
+            if (extra)
+            {
+                extra->max_object = get_dword(esp + 40);
+                extra->time_per_frame = get_qword(esp + 52);
+            }
+        }
+        pos += object_size;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI content_info_ParseHeader(IMFASFContentInfo *iface, IMFMediaBuffer *buffer, QWORD offset)
+{
+    struct content_info *info = impl_from_IMFASFContentInfo(iface);
+    struct
+    {
+        WORD number;
+        GUID type;
+        const BYTE *data;
+        DWORD size;
+    } streams[MFASF_MAX_STREAM_NUMBER];
+    DWORD length, count, stream_count = 0, i;
+    UINT64 header_size, pos;
+    IMFASFProfile *profile;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("%p, %p, %s.\n", iface, buffer, wine_dbgstr_longlong(offset));
+
+    if (!buffer)
+        return E_INVALIDARG;
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &length)))
+        return hr;
+    if (offset || length < 30)
+    {
+        /* the whole header object is parsed in one buffer */
+        IMFMediaBuffer_Unlock(buffer);
+        return offset ? E_NOTIMPL : MF_E_ASF_PARSINGINCOMPLETE;
+    }
+    if (memcmp(data, &asf_header_object, sizeof(GUID)))
+    {
+        IMFMediaBuffer_Unlock(buffer);
+        return MF_E_ASF_INVALIDDATA;
+    }
+    header_size = get_qword(data + 16);
+    if (header_size > length)
+    {
+        IMFMediaBuffer_Unlock(buffer);
+        return MF_E_ASF_PARSINGINCOMPLETE;
+    }
+    count = get_dword(data + 24);
+    memset(&info->file, 0, sizeof(info->file));
+    memset(info->extras, 0, sizeof(info->extras));
+    info->file.data_offset = header_size + DATA_OBJECT_HEADER;
+
+    for (pos = 30, i = 0; i < count && pos + 24 <= header_size; i++)
+    {
+        const BYTE *object = data + pos;
+        UINT64 object_size = get_qword(object + 16);
+
+        if (object_size < 24 || object_size > header_size - pos)
+        {
+            hr = MF_E_ASF_INVALIDDATA;
+            break;
+        }
+        if (!memcmp(object, &asf_file_properties, sizeof(GUID)) && object_size >= 104)
+        {
+            const BYTE *p = object + 24;
+
+            memcpy(&info->file.file_id, p, sizeof(GUID));
+            info->file.creation_time = get_qword(p + 24);
+            info->file.packets = get_qword(p + 32);
+            info->file.play_duration = get_qword(p + 40);
+            info->file.send_duration = get_qword(p + 48);
+            info->file.preroll = get_qword(p + 56);
+            info->file.flags = get_dword(p + 64);
+            info->file.min_packet_size = get_dword(p + 68);
+            info->file.max_packet_size = get_dword(p + 72);
+            info->file.max_bitrate = get_dword(p + 76);
+        }
+        else if (!memcmp(object, &asf_stream_properties, sizeof(GUID)) && object_size >= 78
+                && stream_count < ARRAY_SIZE(streams))
+        {
+            const BYTE *p = object + 24;
+            DWORD type_size = get_dword(p + 40);
+
+            if (78 + (UINT64)type_size > object_size)
+            {
+                hr = MF_E_ASF_INVALIDDATA;
+                break;
+            }
+            memcpy(&streams[stream_count].type, p, sizeof(GUID));
+            streams[stream_count].number = get_word(p + 48) & 0x7f;
+            streams[stream_count].data = p + 54;
+            streams[stream_count].size = type_size;
+            stream_count++;
+        }
+        else if (!memcmp(object, &asf_header_extension, sizeof(GUID)) && object_size >= 46)
+        {
+            DWORD extension_size = get_dword(object + 42);
+
+            if (46 + (UINT64)extension_size <= object_size && FAILED(hr = parse_extension(info, object + 46, extension_size)))
+                break;
+        }
+        pos += object_size;
+    }
+
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = MFCreateASFProfile(&profile)))
+    {
+        for (i = 0; SUCCEEDED(hr) && i < stream_count; i++)
+        {
+            IMFASFStreamConfig *stream;
+            IMFMediaType *type;
+
+            if (FAILED(media_type_from_type_data(&streams[i].type, streams[i].data, streams[i].size,
+                    info->extras[streams[i].number].time_per_frame, &type)))
+            {
+                WARN("Skipping stream %u of type %s.\n", streams[i].number, debugstr_guid(&streams[i].type));
+                continue;
+            }
+            if (SUCCEEDED(hr = asf_stream_config_create(type, streams[i].number, &stream)))
+            {
+                hr = IMFASFProfile_SetStream(profile, stream);
+                IMFASFStreamConfig_Release(stream);
+            }
+            IMFMediaType_Release(type);
+        }
+        if (SUCCEEDED(hr) && info->file.max_packet_size)
+            hr = IMFASFProfile_SetUINT32(profile, &MF_ASFPROFILE_MAXPACKETSIZE, info->file.max_packet_size);
+        if (SUCCEEDED(hr) && info->file.min_packet_size)
+            hr = IMFASFProfile_SetUINT32(profile, &MF_ASFPROFILE_MINPACKETSIZE, info->file.min_packet_size);
+        if (SUCCEEDED(hr))
+        {
+            if (info->profile)
+                IMFASFProfile_Release(info->profile);
+            info->profile = profile;
+        }
+        else
+            IMFASFProfile_Release(profile);
+    }
+    /* the data object's size, when its header is in the buffer too */
+    if (SUCCEEDED(hr) && header_size + DATA_OBJECT_HEADER <= length
+            && !memcmp(data + header_size, &asf_data_object, sizeof(GUID)))
+        info->file.data_length = get_qword(data + header_size + 16);
+    IMFMediaBuffer_Unlock(buffer);
+    return hr;
+}
+
+static HRESULT build_header(struct content_info *info, struct buffer *out)
+{
+    DWORD count = 0, stream_count, i, bitrate = 0, max_window = 0, packet_size;
+    struct { WORD number; DWORD bitrate, window, max_object; UINT64 time_per_frame; } *streams;
+    struct buffer extension = {0};
+    UINT64 size, file_size;
+    HRESULT hr;
+
+    if (!info->profile)
+        return MF_E_NOT_INITIALIZED;
+    if (FAILED(hr = IMFASFProfile_GetStreamCount(info->profile, &stream_count)))
+        return hr;
+    if (!(streams = calloc(max(stream_count, 1), sizeof(*streams))))
+        return E_OUTOFMEMORY;
+    packet_size = asf_profile_packet_size(info->profile);
+
+    put(out, &asf_header_object, sizeof(GUID));
+    put_qword(out, 0);
+    put_dword(out, 0);
+    put(out, "\x01\x02", 2);
+
+    /* file properties: filled in below once the streams' rates are known */
+    put(out, &asf_file_properties, sizeof(GUID));
+    put_qword(out, 104);
+    put(out, NULL, 80);
+    count++;
+
+    for (i = 0; SUCCEEDED(hr) && i < stream_count; i++)
+    {
+        struct buffer type_data = {0};
+        IMFASFStreamConfig *stream;
+        struct stream_extra *extra;
+        IMFMediaType *type;
+        BOOL video;
+
+        if (FAILED(hr = IMFASFProfile_GetStream(info->profile, i, &streams[i].number, &stream)))
+            break;
+        asf_stream_rate(stream, &streams[i].bitrate, &streams[i].window);
+        if (SUCCEEDED(hr = IMFASFStreamConfig_GetMediaType(stream, &type)))
+        {
+            hr = stream_type_data(type, &video, &streams[i].time_per_frame, &type_data);
+            IMFMediaType_Release(type);
+        }
+        IMFASFStreamConfig_Release(stream);
+        if (FAILED(hr))
+        {
+            free(type_data.data);
+            break;
+        }
+        if ((extra = content_info_extra(info, streams[i].number)))
+            streams[i].max_object = extra->max_object;
+        bitrate += streams[i].bitrate;
+        max_window = max(max_window, streams[i].window);
+
+        put(out, &asf_stream_properties, sizeof(GUID));
+        put_qword(out, 78 + type_data.size);
+        put(out, video ? &asf_video_media : &asf_audio_media, sizeof(GUID));
+        put(out, &asf_no_error_correction, sizeof(GUID));
+        put_qword(out, 0);              /* time offset */
+        put_dword(out, type_data.size);
+        put_dword(out, 0);              /* error correction data */
+        put_word(out, streams[i].number & 0x7f);
+        put_dword(out, 0);
+        put(out, type_data.data, type_data.size);
+        free(type_data.data);
+        count++;
+    }
+    if (FAILED(hr))
+    {
+        free(streams);
+        return hr;
+    }
+
+    /* the header extension: an extended stream properties object per stream (readers time video
+     * frames by it) */
+    for (i = 0; i < stream_count; i++)
+    {
+        DWORD buffer_size = (DWORD)((UINT64)streams[i].bitrate * streams[i].window / 8000);
+
+        put(&extension, &asf_extended_stream_properties, sizeof(GUID));
+        put_qword(&extension, 88);
+        put_qword(&extension, 0);                   /* start time */
+        put_qword(&extension, 0);                   /* end time */
+        put_dword(&extension, streams[i].bitrate);
+        put_dword(&extension, buffer_size);
+        put_dword(&extension, buffer_size);         /* initial buffer fullness */
+        put_dword(&extension, streams[i].bitrate);
+        put_dword(&extension, buffer_size);
+        put_dword(&extension, buffer_size);
+        put_dword(&extension, streams[i].max_object);
+        put_dword(&extension, 0x2);                 /* seekable */
+        put_word(&extension, streams[i].number & 0x7f);
+        put_word(&extension, 0);                    /* language */
+        put_qword(&extension, streams[i].time_per_frame);
+        put_word(&extension, 0);                    /* stream names */
+        put_word(&extension, 0);                    /* payload extension systems */
+    }
+    put(out, &asf_header_extension, sizeof(GUID));
+    put_qword(out, 46 + extension.size);
+    put(out, &asf_reserved_1, sizeof(GUID));
+    put_word(out, 6);
+    put_dword(out, extension.size);
+    put(out, extension.data, extension.size);
+    free(extension.data);
+    count++;
+
+    if (!info->file.preroll)
+        info->file.preroll = max_window;
+    if (out->failed)
+    {
+        free(streams);
+        return E_OUTOFMEMORY;
+    }
+    size = out->size;
+    memcpy(out->data + 16, &size, 8);
+    memcpy(out->data + 24, &count, 4);
+
+    /* file properties */
+    {
+        BYTE *p = out->data + 30 + 24;
+        UINT64 data_size = info->file.data_length ? info->file.data_length
+                : DATA_OBJECT_HEADER + info->file.packets * packet_size;
+        DWORD flags = info->file.packets ? 0x2 /* seekable */ : 0x1 /* broadcast: sizes not known yet */;
+
+        if (IsEqualGUID(&info->file.file_id, &GUID_NULL))
+            CoCreateGuid(&info->file.file_id);
+        if (!info->file.creation_time)
+        {
+            FILETIME now;
+            GetSystemTimeAsFileTime(&now);
+            info->file.creation_time = (UINT64)now.dwHighDateTime << 32 | now.dwLowDateTime;
+        }
+        file_size = info->file.packets ? size + data_size : 0;
+        memcpy(p, &info->file.file_id, sizeof(GUID));
+        memcpy(p + 16, &file_size, 8);
+        memcpy(p + 24, &info->file.creation_time, 8);
+        memcpy(p + 32, &info->file.packets, 8);
+        memcpy(p + 40, &info->file.play_duration, 8);
+        memcpy(p + 48, &info->file.send_duration, 8);
+        memcpy(p + 56, &info->file.preroll, 8);
+        memcpy(p + 64, &flags, 4);
+        memcpy(p + 68, &packet_size, 4);
+        memcpy(p + 72, &packet_size, 4);
+        memcpy(p + 76, &bitrate, 4);
+        info->file.flags = flags;
+        info->file.min_packet_size = info->file.max_packet_size = packet_size;
+        info->file.max_bitrate = bitrate;
+
+        /* the data object's header */
+        put(out, &asf_data_object, sizeof(GUID));
+        put_qword(out, info->file.packets ? data_size : 0);
+        put(out, &info->file.file_id, sizeof(GUID));
+        put_qword(out, info->file.packets);
+        put(out, "\x01\x01", 2);
+        info->file.data_offset = size + DATA_OBJECT_HEADER;
+    }
+    free(streams);
+    return out->failed ? E_OUTOFMEMORY : S_OK;
+}
+
+static HRESULT WINAPI content_info_GenerateHeader(IMFASFContentInfo *iface, IMFMediaBuffer *buffer, DWORD *size)
+{
+    struct content_info *info = impl_from_IMFASFContentInfo(iface);
+    struct buffer header = {0};
+    DWORD max_length;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p.\n", iface, buffer, size);
+
+    if (!size)
+        return E_INVALIDARG;
+    if (FAILED(hr = build_header(info, &header)))
+    {
+        free(header.data);
+        return hr;
+    }
+#ifdef SG_MUTANT_ASF_NO_DATA_OBJECT
+    header.size -= DATA_OBJECT_HEADER;
+#endif
+    if (header.size > 10 * 1024 * 1024)
+        hr = MF_E_ASF_INVALIDDATA;
+    else if (!buffer)
+        *size = header.size;
+    else if (SUCCEEDED(hr = IMFMediaBuffer_Lock(buffer, &data, &max_length, NULL)))
+    {
+        if (max_length < header.size)
+        {
+            *size = header.size;
+            hr = MF_E_BUFFERTOOSMALL;
+        }
+        else
+        {
+            memcpy(data, header.data, header.size);
+            *size = header.size;
+        }
+        IMFMediaBuffer_Unlock(buffer);
+        if (SUCCEEDED(hr))
+            hr = IMFMediaBuffer_SetCurrentLength(buffer, header.size);
+    }
+    free(header.data);
+    return hr;
+}
+
+static HRESULT WINAPI content_info_GetProfile(IMFASFContentInfo *iface, IMFASFProfile **profile)
+{
+    struct content_info *info = impl_from_IMFASFContentInfo(iface);
+
+    TRACE("%p, %p.\n", iface, profile);
+
+    if (!profile)
+        return E_INVALIDARG;
+    if (!info->profile)
+    {
+        *profile = NULL;
+        return MF_E_NOT_INITIALIZED;
+    }
+    /* a copy: the caller changes the content info's profile through SetProfile */
+    return IMFASFProfile_Clone(info->profile, profile);
+}
+
+static HRESULT WINAPI content_info_SetProfile(IMFASFContentInfo *iface, IMFASFProfile *profile)
+{
+    struct content_info *info = impl_from_IMFASFContentInfo(iface);
+    IMFASFProfile *copy;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, profile);
+
+    if (!profile)
+        return E_INVALIDARG;
+    if (FAILED(hr = IMFASFProfile_Clone(profile, &copy)))
+        return hr;
+    if (info->profile)
+        IMFASFProfile_Release(info->profile);
+    info->profile = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI content_info_GeneratePresentationDescriptor(IMFASFContentInfo *iface,
+        IMFPresentationDescriptor **out)
+{
+    struct content_info *info = impl_from_IMFASFContentInfo(iface);
+    IMFPresentationDescriptor *pd;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, out);
+
+    if (!out)
+        return E_INVALIDARG;
+    if (!info->profile)
+        return MF_E_NOT_INITIALIZED;
+    if (FAILED(hr = MFCreatePresentationDescriptorFromASFProfile(info->profile, &pd)))
+        return hr;
+
+    IMFPresentationDescriptor_SetBlob(pd, &MF_PD_ASF_FILEPROPERTIES_FILE_ID, (const UINT8 *)&info->file.file_id, sizeof(GUID));
+    IMFPresentationDescriptor_SetBlob(pd, &MF_PD_ASF_FILEPROPERTIES_CREATION_TIME,
+            (const UINT8 *)&info->file.creation_time, sizeof(FILETIME));
+    IMFPresentationDescriptor_SetUINT64(pd, &MF_PD_ASF_FILEPROPERTIES_PACKETS, info->file.packets);
+    IMFPresentationDescriptor_SetUINT64(pd, &MF_PD_ASF_FILEPROPERTIES_PLAY_DURATION, info->file.play_duration);
+    IMFPresentationDescriptor_SetUINT64(pd, &MF_PD_ASF_FILEPROPERTIES_SEND_DURATION, info->file.send_duration);
+    IMFPresentationDescriptor_SetUINT64(pd, &MF_PD_ASF_FILEPROPERTIES_PREROLL, info->file.preroll);
+    IMFPresentationDescriptor_SetUINT32(pd, &MF_PD_ASF_FILEPROPERTIES_FLAGS, info->file.flags);
+    IMFPresentationDescriptor_SetUINT32(pd, &MF_PD_ASF_FILEPROPERTIES_MIN_PACKET_SIZE, info->file.min_packet_size);
+    IMFPresentationDescriptor_SetUINT32(pd, &MF_PD_ASF_FILEPROPERTIES_MAX_PACKET_SIZE, info->file.max_packet_size);
+    IMFPresentationDescriptor_SetUINT32(pd, &MF_PD_ASF_FILEPROPERTIES_MAX_BITRATE, info->file.max_bitrate);
+    IMFPresentationDescriptor_SetUINT64(pd, &MF_PD_ASF_DATA_START_OFFSET, info->file.data_offset);
+    IMFPresentationDescriptor_SetUINT64(pd, &MF_PD_ASF_DATA_LENGTH, info->file.data_length);
+    /* the presentation's duration: the play duration without the preroll */
+    if (info->file.play_duration > info->file.preroll * 10000)
+        IMFPresentationDescriptor_SetUINT64(pd, &MF_PD_DURATION, info->file.play_duration - info->file.preroll * 10000);
+    *out = pd;
+    return S_OK;
+}
+
+static HRESULT WINAPI content_info_GetEncodingConfigurationPropertyStore(IMFASFContentInfo *iface, WORD number,
+        IPropertyStore **store)
+{
+    struct content_info *info = impl_from_IMFASFContentInfo(iface);
+    HRESULT hr;
+
+    TRACE("%p, %u, %p.\n", iface, number, store);
+
+    if (!store)
+        return E_INVALIDARG;
+    if (number > MFASF_MAX_STREAM_NUMBER)
+        return MF_E_INVALIDSTREAMNUMBER;
+    /* stream 0 is the file's own; the others must be streams of the profile */
+    if (number && info->profile)
+    {
+        IMFASFStreamConfig *stream;
+
+        if (FAILED(hr = IMFASFProfile_GetStreamByNumber(info->profile, number, &stream)))
+            return MF_E_INVALIDSTREAMNUMBER;
+        IMFASFStreamConfig_Release(stream);
+    }
+    if (!info->stores[number] && FAILED(hr = PSCreateMemoryPropertyStore(&IID_IPropertyStore,
+            (void **)&info->stores[number])))
+        return hr;
+    IPropertyStore_AddRef(*store = info->stores[number]);
+    return S_OK;
+}
+
+static const IMFASFContentInfoVtbl content_info_vtbl =
+{
+    content_info_QueryInterface,
+    content_info_AddRef,
+    content_info_Release,
+    content_info_GetHeaderSize,
+    content_info_ParseHeader,
+    content_info_GenerateHeader,
+    content_info_GetProfile,
+    content_info_SetProfile,
+    content_info_GeneratePresentationDescriptor,
+    content_info_GetEncodingConfigurationPropertyStore,
+};
+
+HRESULT asf_content_info_get_file(IMFASFContentInfo *iface, struct asf_file_info *file)
+{
+    if (iface->lpVtbl != &content_info_vtbl)
+        return E_INVALIDARG;
+    *file = impl_from_IMFASFContentInfo(iface)->file;
+    return S_OK;
+}
+
+HRESULT asf_content_info_set_file(IMFASFContentInfo *iface, const struct asf_file_info *file,
+        const DWORD *max_object, const WORD *numbers, DWORD count)
+{
+    struct content_info *info;
+    struct stream_extra *extra;
+    DWORD i;
+
+    if (iface->lpVtbl != &content_info_vtbl)
+        return E_INVALIDARG;
+    info = impl_from_IMFASFContentInfo(iface);
+    info->file = *file;
+    for (i = 0; i < count; i++)
+        if ((extra = content_info_extra(info, numbers[i])))
+            extra->max_object = max_object[i];
+    return S_OK;
+}
+
+/***********************************************************************
+ *      MFCreateASFContentInfo (mf.@)
+ */
+HRESULT WINAPI MFCreateASFContentInfo(IMFASFContentInfo **out)
+{
+    struct content_info *info;
+
+    TRACE("%p.\n", out);
+
+    if (!out)
+        return E_INVALIDARG;
+    if (!(info = calloc(1, sizeof(*info))))
+        return E_OUTOFMEMORY;
+    info->IMFASFContentInfo_iface.lpVtbl = &content_info_vtbl;
+    info->refcount = 1;
+    *out = &info->IMFASFContentInfo_iface;
+    return S_OK;
+}
+
+/* multiplexer */
+
+#define PACKET_HEADER    13     /* error correction (3), flags (2), padding length, send time, duration */
+#define PAYLOADS_FLAGS   1      /* number of payloads and the payload length type */
+#define PAYLOAD_HEADER   17     /* stream, object number, offset, replicated data length, replicated data (8), length */
+
+struct mux_stream
+{
+    WORD number;
+    BYTE object_number;
+    DWORD max_object;
+    ASF_MUX_STATISTICS stats;
+};
+
+struct mux_packet
+{
+    struct list entry;
+    IMFSample *sample;
+};
+
+struct multiplexer
+{
+    IMFASFMultiplexer IMFASFMultiplexer_iface;
+    LONG refcount;
+    CRITICAL_SECTION cs;
+    DWORD flags, sync_tolerance;
+    struct mux_stream *streams;
+    DWORD stream_count;
+    DWORD packet_size;
+    UINT64 preroll;                 /* ms */
+
+    BYTE *packet;                   /* the packet being filled */
+    DWORD used, payloads;
+    DWORD send_time;                /* ms, of the packet being filled */
+    struct list packets;            /* ready */
+    UINT64 packet_count;
+    UINT64 end_time;                /* 100 ns: the latest sample end */
+    UINT64 last_send;               /* 100 ns */
+};
+
+static struct multiplexer *impl_from_IMFASFMultiplexer(IMFASFMultiplexer *iface)
+{
+    return CONTAINING_RECORD(iface, struct multiplexer, IMFASFMultiplexer_iface);
+}
+
+static HRESULT WINAPI multiplexer_QueryInterface(IMFASFMultiplexer *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFASFMultiplexer) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFASFMultiplexer_AddRef(iface);
+        return S_OK;
+    }
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI multiplexer_AddRef(IMFASFMultiplexer *iface)
+{
+    return InterlockedIncrement(&impl_from_IMFASFMultiplexer(iface)->refcount);
+}
+
+static void multiplexer_drop_packets(struct multiplexer *mux)
+{
+    struct mux_packet *packet, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(packet, next, &mux->packets, struct mux_packet, entry)
+    {
+        list_remove(&packet->entry);
+        IMFSample_Release(packet->sample);
+        free(packet);
+    }
+}
+
+static ULONG WINAPI multiplexer_Release(IMFASFMultiplexer *iface)
+{
+    struct multiplexer *mux = impl_from_IMFASFMultiplexer(iface);
+    ULONG refcount = InterlockedDecrement(&mux->refcount);
+
+    if (!refcount)
+    {
+        multiplexer_drop_packets(mux);
+        free(mux->packet);
+        free(mux->streams);
+        mux->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&mux->cs);
+        free(mux);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI multiplexer_Initialize(IMFASFMultiplexer *iface, IMFASFContentInfo *content_info)
+{
+    struct multiplexer *mux = impl_from_IMFASFMultiplexer(iface);
+    IMFASFProfile *profile;
+    DWORD count, i, bitrate, window, max_window = 0;
+    struct asf_file_info file;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, content_info);
+
+    if (!content_info)
+        return E_INVALIDARG;
+    if (FAILED(hr = IMFASFContentInfo_GetProfile(content_info, &profile)))
+        return hr;
+    if (FAILED(hr = IMFASFProfile_GetStreamCount(profile, &count)) || !count)
+    {
+        IMFASFProfile_Release(profile);
+        return FAILED(hr) ? hr : MF_E_INVALIDREQUEST;
+    }
+
+    EnterCriticalSection(&mux->cs);
+    free(mux->streams);
+    free(mux->packet);
+    multiplexer_drop_packets(mux);
+    mux->streams = calloc(count, sizeof(*mux->streams));
+    mux->stream_count = 0;
+    mux->packet_size = asf_profile_packet_size(profile);
+    mux->packet = calloc(1, mux->packet_size);
+    mux->used = mux->payloads = 0;
+    mux->packet_count = mux->end_time = mux->last_send = 0;
+    if (!mux->streams || !mux->packet)
+        hr = E_OUTOFMEMORY;
+    for (i = 0; SUCCEEDED(hr) && i < count; i++)
+    {
+        IMFASFStreamConfig *stream;
+
+        if (FAILED(hr = IMFASFProfile_GetStream(profile, i, &mux->streams[i].number, &stream)))
+            break;
+        asf_stream_rate(stream, &bitrate, &window);
+        max_window = max(max_window, window);
+        IMFASFStreamConfig_Release(stream);
+        mux->stream_count++;
+    }
+    mux->preroll = max_window;
+    if (SUCCEEDED(asf_content_info_get_file(content_info, &file)) && file.preroll)
+        mux->preroll = file.preroll;
+    LeaveCriticalSection(&mux->cs);
+    IMFASFProfile_Release(profile);
+    return hr;
+}
+
+static HRESULT WINAPI multiplexer_SetFlags(IMFASFMultiplexer *iface, DWORD flags)
+{
+    TRACE("%p, %#lx.\n", iface, flags);
+
+    if (flags & ~MFASF_MULTIPLEXER_AUTOADJUST_BITRATE)
+        return E_INVALIDARG;
+    impl_from_IMFASFMultiplexer(iface)->flags = flags;
+    return S_OK;
+}
+
+static HRESULT WINAPI multiplexer_GetFlags(IMFASFMultiplexer *iface, DWORD *flags)
+{
+    TRACE("%p, %p.\n", iface, flags);
+
+    if (!flags)
+        return E_INVALIDARG;
+    *flags = impl_from_IMFASFMultiplexer(iface)->flags;
+    return S_OK;
+}
+
+static struct mux_stream *multiplexer_find_stream(struct multiplexer *mux, WORD number)
+{
+    DWORD i;
+
+    for (i = 0; i < mux->stream_count; i++)
+        if (mux->streams[i].number == number)
+            return &mux->streams[i];
+    return NULL;
+}
+
+/* the packet being filled goes out, padded to the packet size */
+static HRESULT multiplexer_close_packet(struct multiplexer *mux)
+{
+    struct mux_packet *entry;
+    IMFMediaBuffer *buffer;
+    WORD padding;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!mux->payloads)
+        return S_OK;
+
+    padding = mux->packet_size - mux->used;
+    mux->packet[0] = 0x82;      /* error correction data present, two bytes */
+    mux->packet[1] = mux->packet[2] = 0;
+    mux->packet[3] = 0x11;      /* multiple payloads, a WORD padding length; fixed packet length */
+    mux->packet[4] = 0x5d;      /* replicated data length a BYTE, offset a DWORD, object number and stream BYTEs */
+    memcpy(mux->packet + 5, &padding, 2);
+    memcpy(mux->packet + 7, &mux->send_time, 4);
+    memset(mux->packet + 11, 0, 2);
+    mux->packet[13] = 0x80 | mux->payloads;     /* payload lengths are WORDs */
+    memset(mux->packet + mux->used, 0, padding);
+
+    if (FAILED(hr = MFCreateMemoryBuffer(mux->packet_size, &buffer)))
+        return hr;
+    if (SUCCEEDED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, NULL)))
+    {
+        memcpy(data, mux->packet, mux->packet_size);
+        IMFMediaBuffer_Unlock(buffer);
+        hr = IMFMediaBuffer_SetCurrentLength(buffer, mux->packet_size);
+    }
+    if (SUCCEEDED(hr) && !(entry = calloc(1, sizeof(*entry))))
+        hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = MFCreateSample(&entry->sample)))
+    {
+        IMFSample_AddBuffer(entry->sample, buffer);
+        IMFSample_SetSampleTime(entry->sample, (LONGLONG)mux->send_time * 10000);
+        IMFSample_SetSampleDuration(entry->sample, 0);
+        list_add_tail(&mux->packets, &entry->entry);
+        mux->packet_count++;
+    }
+    else if (SUCCEEDED(hr))
+        free(entry);
+    IMFMediaBuffer_Release(buffer);
+    mux->used = mux->payloads = 0;
+    return hr;
+}
+
+static HRESULT multiplexer_put_object(struct multiplexer *mux, struct mux_stream *stream, LONGLONG time,
+        BOOL key, const BYTE *data, DWORD size)
+{
+    DWORD offset = 0, presentation, send;
+    HRESULT hr;
+
+    send = time > 0 ? (DWORD)(time / 10000) : 0;
+    presentation = send + (DWORD)mux->preroll;
+    do
+    {
+        DWORD space, chunk;
+        BYTE *p;
+
+        if (mux->payloads == 63 || mux->packet_size - max(mux->used, PACKET_HEADER + PAYLOADS_FLAGS) < PAYLOAD_HEADER + 1)
+        {
+            if (FAILED(hr = multiplexer_close_packet(mux)))
+                return hr;
+        }
+        if (!mux->payloads)
+        {
+            mux->used = PACKET_HEADER + PAYLOADS_FLAGS;
+            mux->send_time = send;
+        }
+        space = mux->packet_size - mux->used - PAYLOAD_HEADER;
+        chunk = min(size - offset, space);
+        p = mux->packet + mux->used;
+        p[0] = (stream->number & 0x7f) | (key ? 0x80 : 0);
+        p[1] = stream->object_number;
+        memcpy(p + 2, &offset, 4);
+        p[6] = 8;
+        memcpy(p + 7, &size, 4);
+        memcpy(p + 11, &presentation, 4);
+        p[15] = chunk & 0xff;
+        p[16] = chunk >> 8;
+#ifndef SG_MUTANT_ASF_NO_PAYLOAD
+        memcpy(p + 17, data + offset, chunk);
+#endif
+        mux->used += PAYLOAD_HEADER + chunk;
+        mux->payloads++;
+        offset += chunk;
+        if (mux->used >= mux->packet_size - PAYLOAD_HEADER && FAILED(hr = multiplexer_close_packet(mux)))
+            return hr;
+    } while (offset < size);
+    return S_OK;
+}
+
+static HRESULT WINAPI multiplexer_ProcessSample(IMFASFMultiplexer *iface, WORD number, IMFSample *sample,
+        LONGLONG adjust)
+{
+    struct multiplexer *mux = impl_from_IMFASFMultiplexer(iface);
+    LONGLONG time = 0, duration = 0;
+    struct mux_stream *stream;
+    IMFMediaBuffer *buffer;
+    UINT32 clean = 0;
+    DWORD length;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("%p, %u, %p, %s.\n", iface, number, sample, wine_dbgstr_longlong(adjust));
+
+    if (!sample)
+        return E_INVALIDARG;
+    EnterCriticalSection(&mux->cs);
+    if (!mux->packet)
+        hr = MF_E_NOT_INITIALIZED;
+    else if (!(stream = multiplexer_find_stream(mux, number)))
+        hr = MF_E_INVALIDSTREAMNUMBER;
+    else if (SUCCEEDED(hr = IMFSample_ConvertToContiguousBuffer(sample, &buffer)))
+    {
+        IMFSample_GetSampleTime(sample, &time);
+        IMFSample_GetSampleDuration(sample, &duration);
+        time += adjust;
+        IMFSample_GetUINT32(sample, &MFSampleExtension_CleanPoint, &clean);
+        if (SUCCEEDED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &length)))
+        {
+            hr = multiplexer_put_object(mux, stream, time, clean, data, length);
+            IMFMediaBuffer_Unlock(buffer);
+        }
+        IMFMediaBuffer_Release(buffer);
+        if (SUCCEEDED(hr))
+        {
+            stream->object_number++;
+            stream->max_object = max(stream->max_object, length);
+            stream->stats.cFramesWritten++;
+            mux->end_time = max(mux->end_time, (UINT64)max(time + duration, 0));
+            mux->last_send = max(mux->last_send, (UINT64)max(time, 0));
+        }
+    }
+    LeaveCriticalSection(&mux->cs);
+    return hr;
+}
+
+static HRESULT WINAPI multiplexer_GetNextPacket(IMFASFMultiplexer *iface, DWORD *status, IMFSample **packet)
+{
+    struct multiplexer *mux = impl_from_IMFASFMultiplexer(iface);
+    struct mux_packet *entry;
+    struct list *head;
+
+    TRACE("%p, %p, %p.\n", iface, status, packet);
+
+    if (!status || !packet)
+        return E_INVALIDARG;
+    EnterCriticalSection(&mux->cs);
+    *packet = NULL;
+    *status = 0;
+    if ((head = list_head(&mux->packets)))
+    {
+        entry = LIST_ENTRY(head, struct mux_packet, entry);
+        list_remove(&entry->entry);
+        *packet = entry->sample;
+        free(entry);
+        if (!list_empty(&mux->packets))
+            *status = ASF_STATUSFLAGS_INCOMPLETE;
+    }
+    LeaveCriticalSection(&mux->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI multiplexer_Flush(IMFASFMultiplexer *iface)
+{
+    struct multiplexer *mux = impl_from_IMFASFMultiplexer(iface);
+    HRESULT hr;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&mux->cs);
+    hr = mux->packet ? multiplexer_close_packet(mux) : MF_E_NOT_INITIALIZED;
+    LeaveCriticalSection(&mux->cs);
+    return hr;
+}
+
+static HRESULT WINAPI multiplexer_End(IMFASFMultiplexer *iface, IMFASFContentInfo *content_info)
+{
+    struct multiplexer *mux = impl_from_IMFASFMultiplexer(iface);
+    struct asf_file_info file;
+    DWORD *max_object;
+    WORD *numbers;
+    HRESULT hr;
+    DWORD i;
+
+    TRACE("%p, %p.\n", iface, content_info);
+
+    if (!content_info)
+        return E_INVALIDARG;
+    EnterCriticalSection(&mux->cs);
+    if (!mux->packet)
+    {
+        LeaveCriticalSection(&mux->cs);
+        return MF_E_NOT_INITIALIZED;
+    }
+    hr = multiplexer_close_packet(mux);
+    if (SUCCEEDED(hr))
+        hr = asf_content_info_get_file(content_info, &file);
+    max_object = calloc(max(mux->stream_count, 1), sizeof(*max_object));
+    numbers = calloc(max(mux->stream_count, 1), sizeof(*numbers));
+    if (SUCCEEDED(hr) && (!max_object || !numbers))
+        hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr))
+    {
+        file.packets = mux->packet_count;
+        file.preroll = mux->preroll;
+#ifndef SG_MUTANT_ASF_NO_DURATION
+        file.play_duration = mux->end_time + mux->preroll * 10000;
+#endif
+        file.send_duration = mux->last_send;
+        file.data_length = DATA_OBJECT_HEADER + mux->packet_count * mux->packet_size;
+        file.min_packet_size = file.max_packet_size = mux->packet_size;
+        for (i = 0; i < mux->stream_count; i++)
+        {
+            numbers[i] = mux->streams[i].number;
+            max_object[i] = mux->streams[i].max_object;
+        }
+        hr = asf_content_info_set_file(content_info, &file, max_object, numbers, mux->stream_count);
+    }
+    free(max_object);
+    free(numbers);
+    LeaveCriticalSection(&mux->cs);
+    return hr;
+}
+
+static HRESULT WINAPI multiplexer_GetStatistics(IMFASFMultiplexer *iface, WORD number, ASF_MUX_STATISTICS *stats)
+{
+    struct multiplexer *mux = impl_from_IMFASFMultiplexer(iface);
+    struct mux_stream *stream;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %u, %p.\n", iface, number, stats);
+
+    if (!stats)
+        return E_INVALIDARG;
+    EnterCriticalSection(&mux->cs);
+    if (!(stream = multiplexer_find_stream(mux, number)))
+        hr = MF_E_INVALIDSTREAMNUMBER;
+    else
+        *stats = stream->stats;
+    LeaveCriticalSection(&mux->cs);
+    return hr;
+}
+
+static HRESULT WINAPI multiplexer_SetSyncTolerance(IMFASFMultiplexer *iface, DWORD tolerance)
+{
+    TRACE("%p, %lu.\n", iface, tolerance);
+
+    impl_from_IMFASFMultiplexer(iface)->sync_tolerance = tolerance;
+    return S_OK;
+}
