+static struct profile *impl_from_IMFASFProfile(IMFASFProfile *iface)
+{
+    return CONTAINING_RECORD(iface, struct profile, IMFASFProfile_iface);
+}
+
+static HRESULT WINAPI profile_QueryInterface(IMFASFProfile *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFASFProfile) || IsEqualIID(riid, &IID_IMFAttributes) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFASFProfile_AddRef(iface);
+        return S_OK;
+    }
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
