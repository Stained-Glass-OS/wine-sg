+static HRESULT create_sink_activate(const WCHAR *url, IMFActivate *bytestream_activate, IMFASFContentInfo *content_info,
+        IMFActivate **out)
+{
+    struct sink_activate *activate;
+    HRESULT hr;
+
+    if (!out)
+        return E_POINTER;
+    if (!content_info || (!url && !bytestream_activate))
+        return E_INVALIDARG;
+    if (!(activate = calloc(1, sizeof(*activate))))
+        return E_OUTOFMEMORY;
+    activate->IMFActivate_iface.lpVtbl = &sink_activate_vtbl;
+    activate->refcount = 1;
+    if (FAILED(hr = MFCreateAttributes(&activate->attributes, 0)))
+    {
+        free(activate);
+        return hr;
+    }
+    if (url && !(activate->url = wcsdup(url)))
+    {
+        IMFActivate_Release(&activate->IMFActivate_iface);
+        return E_OUTOFMEMORY;
+    }
+    if (bytestream_activate)
+        IMFActivate_AddRef((activate->bytestream_activate = bytestream_activate));
+    IMFASFContentInfo_AddRef((activate->content_info = content_info));
+    *out = &activate->IMFActivate_iface;
+    return S_OK;
+}
+
+/***********************************************************************
+ *      MFCreateASFMediaSinkActivate (mf.@)
+ */
+HRESULT WINAPI MFCreateASFMediaSinkActivate(const WCHAR *url, IMFASFContentInfo *content_info, IMFActivate **activate)
+{
+    TRACE("%s, %p, %p.\n", debugstr_w(url), content_info, activate);
+
+    if (!url)
+        return E_INVALIDARG;
+    return create_sink_activate(url, NULL, content_info, activate);
+}
+
+/***********************************************************************
+ *      MFCreateASFStreamingMediaSinkActivate (mf.@)
+ */
+HRESULT WINAPI MFCreateASFStreamingMediaSinkActivate(IMFActivate *bytestream_activate, IMFASFContentInfo *content_info,
+        IMFActivate **activate)
+{
+    TRACE("%p, %p, %p.\n", bytestream_activate, content_info, activate);
+
+    if (!bytestream_activate)
+        return E_INVALIDARG;
+    return create_sink_activate(NULL, bytestream_activate, content_info, activate);
+}
