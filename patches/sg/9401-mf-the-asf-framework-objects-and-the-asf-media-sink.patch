+static HRESULT stream_sink_check_type(struct stream_sink *stream_sink, IMFMediaType *type)
+{
+    GUID major, subtype, cur_major, cur_subtype;
+
+    if (FAILED(IMFMediaType_GetMajorType(type, &major)))
+        return MF_E_INVALIDMEDIATYPE;
+    if (!stream_sink->type)
+        return S_OK;
+
+    /* The stream keeps the kind of media it was added with. */
+    if (FAILED(IMFMediaType_GetMajorType(stream_sink->type, &cur_major)) || !IsEqualGUID(&major, &cur_major))
+        return MF_E_INVALIDMEDIATYPE;
+    if (SUCCEEDED(IMFMediaType_GetGUID(stream_sink->type, &MF_MT_SUBTYPE, &cur_subtype)))
+    {
+        if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)) || !IsEqualGUID(&subtype, &cur_subtype))
+            return MF_E_INVALIDMEDIATYPE;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_sink_type_handler_IsMediaTypeSupported(IMFMediaTypeHandler *iface,
+        IMFMediaType *in_type, IMFMediaType **out_type)
+{
+    struct stream_sink *stream_sink = impl_from_IMFMediaTypeHandler(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
+    HRESULT hr;
+
+    TRACE("iface %p, in_type %p, out_type %p.\n", iface, in_type, out_type);
+
+    if (!in_type)
+        return E_POINTER;
+    if (out_type)
+        *out_type = NULL; /* there is no closest type to offer */
+
+    EnterCriticalSection(&media_sink->cs);
+    hr = stream_sink_check_type(stream_sink, in_type);
+    LeaveCriticalSection(&media_sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI stream_sink_type_handler_GetMediaTypeCount(IMFMediaTypeHandler *iface, DWORD *count)
+{
+    struct stream_sink *stream_sink = impl_from_IMFMediaTypeHandler(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
+
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count)
+        return E_POINTER;
+
+    /* One type is accepted: the one the stream was added with. */
+    EnterCriticalSection(&media_sink->cs);
+    *count = stream_sink->type ? 1 : 0;
+#ifdef SG_MUTANT_TYPECOUNT
+    *count = 0;
+#endif
+    LeaveCriticalSection(&media_sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_sink_type_handler_GetMediaTypeByIndex(IMFMediaTypeHandler *iface, DWORD index,
+        IMFMediaType **type)
+{
+    struct stream_sink *stream_sink = impl_from_IMFMediaTypeHandler(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
+    IMFMediaType *copy;
+    HRESULT hr;
+
+    TRACE("iface %p, index %lu, type %p.\n", iface, index, type);
+
+    if (!type)
+        return E_POINTER;
+
+    EnterCriticalSection(&media_sink->cs);
+    if (index || !stream_sink->type)
+        hr = MF_E_NO_MORE_TYPES;
+    else if (SUCCEEDED(hr = MFCreateMediaType(&copy)))
+    {
+        if (SUCCEEDED(hr = IMFMediaType_CopyAllItems(stream_sink->type, (IMFAttributes *)copy)))
+            *type = copy;
+        else
+            IMFMediaType_Release(copy);
+    }
+    LeaveCriticalSection(&media_sink->cs);
+    return hr;
+}
+
+/* the content info's profile with a stream added, replaced (type) or removed (type NULL) */
+static HRESULT media_sink_update_profile(struct media_sink *media_sink, DWORD id, IMFMediaType *type, BOOL add)
+{
+    IMFASFStreamConfig *stream;
+    IMFASFProfile *profile;
+    HRESULT hr;
+
+    if (FAILED(IMFASFContentInfo_GetProfile(media_sink->content_info, &profile))
+            && FAILED(hr = MFCreateASFProfile(&profile)))
+        return hr;
+    if (!type)
+        hr = IMFASFProfile_RemoveStream(profile, id);
+    else if (SUCCEEDED(hr = IMFASFProfile_CreateStream(profile, type, &stream)))
+    {
+        if (SUCCEEDED(hr = IMFASFStreamConfig_SetStreamNumber(stream, id)))
+        {
+            IMFASFStreamConfig *old;
+
+            /* a new type keeps the stream's own settings (its leaky bucket) */
+            if (!add && SUCCEEDED(IMFASFProfile_GetStreamByNumber(profile, id, &old)))
+            {
+                IMFASFStreamConfig_CopyAllItems(old, (IMFAttributes *)stream);
+                IMFASFStreamConfig_Release(old);
+            }
+            hr = IMFASFProfile_SetStream(profile, stream);
+        }
+        IMFASFStreamConfig_Release(stream);
+    }
+    if (SUCCEEDED(hr))
+        hr = IMFASFContentInfo_SetProfile(media_sink->content_info, profile);
+    IMFASFProfile_Release(profile);
+    return hr;
+}
+
+static HRESULT WINAPI stream_sink_type_handler_SetCurrentMediaType(IMFMediaTypeHandler *iface, IMFMediaType *type)
+{
+    struct stream_sink *stream_sink = impl_from_IMFMediaTypeHandler(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
+    HRESULT hr;
+
+    TRACE("iface %p, type %p.\n", iface, type);
+
+    if (!type)
+        return E_POINTER;
+
+    EnterCriticalSection(&media_sink->cs);
+
+    if (stream_sink->removed || media_sink->state == STATE_SHUTDOWN)
+        hr = MF_E_STREAMSINK_REMOVED;
+    else if (media_sink->header_written)
+        hr = MF_E_INVALIDREQUEST; /* the header is already out with the old type */
+    else if (SUCCEEDED(hr = stream_sink_check_type(stream_sink, type))
+            && SUCCEEDED(hr = media_sink_update_profile(media_sink, stream_sink->id, type, FALSE)))
+    {
+        IMFMediaType_AddRef(type);
+        if (stream_sink->type)
+            IMFMediaType_Release(stream_sink->type);
+        stream_sink->type = type;
+    }
+
+    LeaveCriticalSection(&media_sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI stream_sink_type_handler_GetCurrentMediaType(IMFMediaTypeHandler *iface, IMFMediaType **type)
+{
+    struct stream_sink *stream_sink = impl_from_IMFMediaTypeHandler(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, type %p.\n", iface, type);
+
+    if (!type)
+        return E_POINTER;
+
+    EnterCriticalSection(&media_sink->cs);
+    if (!stream_sink->type)
+        hr = MF_E_NOT_INITIALIZED;
+    else
+        IMFMediaType_AddRef((*type = stream_sink->type));
+    LeaveCriticalSection(&media_sink->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI stream_sink_type_handler_GetMajorType(IMFMediaTypeHandler *iface, GUID *type)
+{
+    struct stream_sink *stream_sink = impl_from_IMFMediaTypeHandler(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
+    HRESULT hr = MF_E_NOT_INITIALIZED;
+
+    TRACE("iface %p, type %p.\n", iface, type);
+
+    if (!type)
+        return E_POINTER;
+
+    /* Still answered once the sink is shut down. */
+    EnterCriticalSection(&media_sink->cs);
+    if (stream_sink->type)
+        hr = IMFMediaType_GetMajorType(stream_sink->type, type);
+    LeaveCriticalSection(&media_sink->cs);
+    return hr;
+}
