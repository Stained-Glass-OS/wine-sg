+ASF_ATTRIBUTES_FORWARD(stream_config, IMFASFStreamConfig, struct stream_config, impl_from_IMFASFStreamConfig)
+
+static HRESULT WINAPI stream_config_GetStreamType(IMFASFStreamConfig *iface, GUID *type)
+{
+    struct stream_config *config = impl_from_IMFASFStreamConfig(iface);
+
+    TRACE("%p, %p.\n", iface, type);
+
+    if (!type)
+        return E_INVALIDARG;
+    if (!config->media_type)
+        return MF_E_NOT_INITIALIZED;
+    return IMFMediaType_GetMajorType(config->media_type, type);
+}
+
+static WORD WINAPI stream_config_GetStreamNumber(IMFASFStreamConfig *iface)
+{
+    struct stream_config *config = impl_from_IMFASFStreamConfig(iface);
+
+    TRACE("%p.\n", iface);
+
+    return config->number;
+}
+
+static HRESULT WINAPI stream_config_SetStreamNumber(IMFASFStreamConfig *iface, WORD number)
+{
+    struct stream_config *config = impl_from_IMFASFStreamConfig(iface);
+
+    TRACE("%p, %u.\n", iface, number);
+
+    /* ASF stream numbers are 1 to 127 */
+    if (!number || number > MFASF_MAX_STREAM_NUMBER)
+        return E_INVALIDARG;
+    config->number = number;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_GetMediaType(IMFASFStreamConfig *iface, IMFMediaType **media_type)
+{
+    struct stream_config *config = impl_from_IMFASFStreamConfig(iface);
+
+    TRACE("%p, %p.\n", iface, media_type);
+
+    if (!media_type)
+        return E_INVALIDARG;
+    if (!config->media_type)
+    {
+        *media_type = NULL;
+        return MF_E_NOT_INITIALIZED;
+    }
+    IMFMediaType_AddRef(*media_type = config->media_type);
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_SetMediaType(IMFASFStreamConfig *iface, IMFMediaType *media_type)
+{
+    struct stream_config *config = impl_from_IMFASFStreamConfig(iface);
+    IMFMediaType *copy;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, media_type);
+
+    if (!media_type)
+        return E_INVALIDARG;
+    if (FAILED(hr = clone_media_type(media_type, &copy)))
+        return hr;
+    if (config->media_type)
+        IMFMediaType_Release(config->media_type);
+    config->media_type = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_GetPayloadExtensionCount(IMFASFStreamConfig *iface, WORD *count)
+{
+    struct stream_config *config = impl_from_IMFASFStreamConfig(iface);
+
+    TRACE("%p, %p.\n", iface, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    *count = config->extension_count;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_GetPayloadExtension(IMFASFStreamConfig *iface, WORD index, GUID *system_id,
+        WORD *data_size, BYTE *info, DWORD *info_size)
+{
+    struct stream_config *config = impl_from_IMFASFStreamConfig(iface);
+    struct payload_extension *extension;
+
+    TRACE("%p, %u, %p, %p, %p, %p.\n", iface, index, system_id, data_size, info, info_size);
+
+    if (!info_size)
+        return E_INVALIDARG;
+    if (index >= config->extension_count)
+        return MF_E_INVALIDINDEX;
+    extension = &config->extensions[index];
+    if (system_id)
+        *system_id = extension->system_id;
+    if (data_size)
+        *data_size = extension->data_size;
+    if (!info)
+    {
+        *info_size = extension->info_size;
+        return S_OK;
+    }
+    if (*info_size < extension->info_size)
+    {
+        *info_size = extension->info_size;
+        return MF_E_BUFFERTOOSMALL;
+    }
+    memcpy(info, extension->info, extension->info_size);
+    *info_size = extension->info_size;
+    return S_OK;
+}
+
+static HRESULT stream_config_add_extension(struct stream_config *config, const GUID *system_id, WORD data_size,
+        const BYTE *info, DWORD info_size)
+{
+    struct payload_extension *extensions;
+
+    if (!(extensions = realloc(config->extensions, (config->extension_count + 1) * sizeof(*extensions))))
+        return E_OUTOFMEMORY;
+    config->extensions = extensions;
+    extensions += config->extension_count;
+    extensions->system_id = *system_id;
+    extensions->data_size = data_size;
+    extensions->info_size = info_size;
+    extensions->info = NULL;
+    if (info_size && !(extensions->info = malloc(info_size)))
+        return E_OUTOFMEMORY;
+    if (info_size)
+        memcpy(extensions->info, info, info_size);
+    config->extension_count++;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_AddPayloadExtension(IMFASFStreamConfig *iface, GUID system_id, WORD data_size,
+        BYTE *info, DWORD info_size)
+{
+    struct stream_config *config = impl_from_IMFASFStreamConfig(iface);
+
+    TRACE("%p, %s, %u, %p, %lu.\n", iface, debugstr_guid(&system_id), data_size, info, info_size);
+
+    if (info_size && !info)
+        return E_INVALIDARG;
+    return stream_config_add_extension(config, &system_id, data_size, info, info_size);
+}
+
+static HRESULT WINAPI stream_config_RemoveAllPayloadExtensions(IMFASFStreamConfig *iface)
+{
+    struct stream_config *config = impl_from_IMFASFStreamConfig(iface);
+
+    TRACE("%p.\n", iface);
+
+    stream_config_clear_extensions(config);
+    return S_OK;
+}
