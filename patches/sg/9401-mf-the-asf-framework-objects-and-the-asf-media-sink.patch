+/***********************************************************************
+ *      MFCreateASFMultiplexer (mf.@)
+ */
+HRESULT WINAPI MFCreateASFMultiplexer(IMFASFMultiplexer **out)
+{
+    struct multiplexer *mux;
+
+    TRACE("%p.\n", out);
+
+    if (!out)
+        return E_INVALIDARG;
+    if (!(mux = calloc(1, sizeof(*mux))))
+        return E_OUTOFMEMORY;
+    mux->IMFASFMultiplexer_iface.lpVtbl = &multiplexer_vtbl;
+    mux->refcount = 1;
+    mux->sync_tolerance = 3000;
+    list_init(&mux->packets);
+    InitializeCriticalSectionEx(&mux->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    mux->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": multiplexer.cs");
+    *out = &mux->IMFASFMultiplexer_iface;
+    return S_OK;
+}
+
+/* splitter */
+
+struct split_object
+{
+    WORD number;
+    BYTE object_number;
+    DWORD size, filled, presentation;
+    BOOL key;
+    BYTE *data;
+};
+
+struct split_sample
+{
+    struct list entry;
+    WORD number;
+    IMFSample *sample;
+};
+
+struct splitter
+{
+    IMFASFSplitter IMFASFSplitter_iface;
+    LONG refcount;
+    CRITICAL_SECTION cs;
+    DWORD flags;
+    BOOL initialized;
+    UINT64 preroll;                 /* ms */
+    DWORD packet_size;
+    WORD streams[MFASF_MAX_STREAM_NUMBER];
+    WORD stream_count;
+    BOOL selected[MFASF_MAX_STREAM_NUMBER + 1];
+    struct split_object objects[MFASF_MAX_STREAM_NUMBER + 1];
+    struct list samples;
+    DWORD last_send;
+    BYTE *pending;                  /* a packet split over ParseData calls */
+    DWORD pending_size;
+};
+
+static struct splitter *impl_from_IMFASFSplitter(IMFASFSplitter *iface)
+{
+    return CONTAINING_RECORD(iface, struct splitter, IMFASFSplitter_iface);
+}
+
+static HRESULT WINAPI splitter_QueryInterface(IMFASFSplitter *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFASFSplitter) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFASFSplitter_AddRef(iface);
+        return S_OK;
+    }
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI splitter_AddRef(IMFASFSplitter *iface)
+{
+    return InterlockedIncrement(&impl_from_IMFASFSplitter(iface)->refcount);
+}
+
+static void splitter_flush(struct splitter *splitter)
+{
+    struct split_sample *sample, *next;
+    unsigned int i;
+
+    LIST_FOR_EACH_ENTRY_SAFE(sample, next, &splitter->samples, struct split_sample, entry)
+    {
+        list_remove(&sample->entry);
+        IMFSample_Release(sample->sample);
+        free(sample);
+    }
+    for (i = 0; i < ARRAY_SIZE(splitter->objects); i++)
+    {
+        free(splitter->objects[i].data);
+        memset(&splitter->objects[i], 0, sizeof(splitter->objects[i]));
+    }
+    free(splitter->pending);
+    splitter->pending = NULL;
+    splitter->pending_size = 0;
+}
+
+static ULONG WINAPI splitter_Release(IMFASFSplitter *iface)
+{
+    struct splitter *splitter = impl_from_IMFASFSplitter(iface);
+    ULONG refcount = InterlockedDecrement(&splitter->refcount);
+
+    if (!refcount)
+    {
+        splitter_flush(splitter);
+        splitter->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&splitter->cs);
+        free(splitter);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI splitter_Initialize(IMFASFSplitter *iface, IMFASFContentInfo *content_info)
+{
+    struct splitter *splitter = impl_from_IMFASFSplitter(iface);
+    struct asf_file_info file = {0};
+    IMFASFProfile *profile;
+    DWORD count, i;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, content_info);
+
+    if (!content_info)
+        return E_INVALIDARG;
+    if (FAILED(hr = IMFASFContentInfo_GetProfile(content_info, &profile)))
+        return hr;
+    EnterCriticalSection(&splitter->cs);
+    splitter_flush(splitter);
+    splitter->stream_count = 0;
+    memset(splitter->selected, 0, sizeof(splitter->selected));
+    if (SUCCEEDED(hr = IMFASFProfile_GetStreamCount(profile, &count)))
+    {
+        for (i = 0; i < count && i < ARRAY_SIZE(splitter->streams); i++)
+        {
+            IMFASFStreamConfig *stream;
+            WORD number;
+
+            if (FAILED(IMFASFProfile_GetStream(profile, i, &number, &stream)))
+                continue;
+            IMFASFStreamConfig_Release(stream);
+            splitter->streams[splitter->stream_count++] = number;
+        }
+        /* documented: no stream is selected after Initialize */
+        asf_content_info_get_file(content_info, &file);
+        splitter->preroll = file.preroll;
+        splitter->packet_size = file.max_packet_size ? file.max_packet_size : asf_profile_packet_size(profile);
+        splitter->initialized = TRUE;
+    }
+    LeaveCriticalSection(&splitter->cs);
+    IMFASFProfile_Release(profile);
+    return hr;
+}
+
+static HRESULT WINAPI splitter_SetFlags(IMFASFSplitter *iface, DWORD flags)
+{
+    TRACE("%p, %#lx.\n", iface, flags);
+
+    if (flags & ~(MFASF_SPLITTER_REVERSE | MFASF_SPLITTER_WMDRM))
+        return E_INVALIDARG;
+    if (flags & MFASF_SPLITTER_WMDRM)
+        FIXME("WMDRM content is not supported.\n");
+    impl_from_IMFASFSplitter(iface)->flags = flags;
+    return S_OK;
+}
+
+static HRESULT WINAPI splitter_GetFlags(IMFASFSplitter *iface, DWORD *flags)
+{
+    TRACE("%p, %p.\n", iface, flags);
+
+    if (!flags)
+        return E_INVALIDARG;
+    *flags = impl_from_IMFASFSplitter(iface)->flags;
+    return S_OK;
+}
+
+static BOOL splitter_has_stream(struct splitter *splitter, WORD number)
+{
+    WORD i;
+
+    for (i = 0; i < splitter->stream_count; i++)
+        if (splitter->streams[i] == number)
+            return TRUE;
+    return FALSE;
+}
+
+static HRESULT WINAPI splitter_SelectStreams(IMFASFSplitter *iface, WORD *numbers, WORD count)
+{
+    struct splitter *splitter = impl_from_IMFASFSplitter(iface);
+    HRESULT hr = S_OK;
+    WORD i;
+
+    TRACE("%p, %p, %u.\n", iface, numbers, count);
+
+    if (count && !numbers)
+        return E_INVALIDARG;
+    EnterCriticalSection(&splitter->cs);
+    for (i = 0; i < count; i++)
+        if (numbers[i] > MFASF_MAX_STREAM_NUMBER || !splitter_has_stream(splitter, numbers[i]))
+            hr = MF_E_INVALIDSTREAMNUMBER;
+    if (SUCCEEDED(hr))
+    {
+        memset(splitter->selected, 0, sizeof(splitter->selected));
+        for (i = 0; i < count; i++)
+            splitter->selected[numbers[i]] = TRUE;
+    }
+    LeaveCriticalSection(&splitter->cs);
+    return hr;
+}
+
+static HRESULT WINAPI splitter_GetSelectedStreams(IMFASFSplitter *iface, WORD *numbers, WORD *count)
+{
+    struct splitter *splitter = impl_from_IMFASFSplitter(iface);
+    WORD selected = 0, i;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p, %p.\n", iface, numbers, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    EnterCriticalSection(&splitter->cs);
+    for (i = 0; i < splitter->stream_count; i++)
+        if (splitter->selected[splitter->streams[i]])
+        {
+            if (numbers && selected < *count)
+                numbers[selected] = splitter->streams[i];
+            selected++;
+        }
+    if (numbers && selected > *count)
+        hr = MF_E_BUFFERTOOSMALL;
+    *count = selected;
+    LeaveCriticalSection(&splitter->cs);
+    return hr;
+}
+
+static DWORD read_field(const BYTE **p, const BYTE *end, unsigned int type, BOOL *ok)
+{
+    DWORD value = 0;
+    unsigned int size = type == 3 ? 4 : type;
+
+    if (!size)
+        return 0;
+    if (end - *p < size)
+    {
+        *ok = FALSE;
+        return 0;
+    }
+    memcpy(&value, *p, size);
+    *p += size;
+    return value;
+}
+
+static HRESULT splitter_queue_sample(struct splitter *splitter, WORD number, const BYTE *data, DWORD size,
+        DWORD presentation, BOOL key)
+{
+    struct split_sample *entry;
+    IMFMediaBuffer *buffer;
+    BYTE *dst;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMemoryBuffer(max(size, 1), &buffer)))
+        return hr;
+    if (SUCCEEDED(hr = IMFMediaBuffer_Lock(buffer, &dst, NULL, NULL)))
+    {
+        memcpy(dst, data, size);
+        IMFMediaBuffer_Unlock(buffer);
+        hr = IMFMediaBuffer_SetCurrentLength(buffer, size);
+    }
+    if (SUCCEEDED(hr) && !(entry = calloc(1, sizeof(*entry))))
+        hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = MFCreateSample(&entry->sample)))
+    {
+        LONGLONG time = ((LONGLONG)presentation - (LONGLONG)splitter->preroll) * 10000;
+
+        IMFSample_AddBuffer(entry->sample, buffer);
+        IMFSample_SetSampleTime(entry->sample, time);
+        if (key)
+            IMFSample_SetUINT32(entry->sample, &MFSampleExtension_CleanPoint, 1);
+        entry->number = number;
+        list_add_tail(&splitter->samples, &entry->entry);
+    }
+    else if (SUCCEEDED(hr))
+        free(entry);
+    IMFMediaBuffer_Release(buffer);
+    return hr;
+}
+
+/* a payload of a media object: the object is complete once all its bytes have come */
+static HRESULT splitter_payload(struct splitter *splitter, BYTE stream_byte, BYTE object_number, DWORD offset,
+        DWORD object_size, DWORD presentation, const BYTE *data, DWORD size)
+{
+    WORD number = stream_byte & 0x7f;
+    struct split_object *object = &splitter->objects[number];
+    HRESULT hr;
+
+    if (!splitter->selected[number])
+        return S_OK;
+    if (!offset && size >= object_size)
+        return splitter_queue_sample(splitter, number, data, object_size, presentation, !!(stream_byte & 0x80));
+
+    if (!offset || !object->data || object->object_number != object_number)
+    {
+        free(object->data);
+        memset(object, 0, sizeof(*object));
+        if (offset)
+            return S_OK;    /* the start of this object was lost */
+        if (!(object->data = malloc(max(object_size, 1))))
+            return E_OUTOFMEMORY;
+        object->number = number;
+        object->object_number = object_number;
+        object->size = object_size;
+        object->presentation = presentation;
+        object->key = !!(stream_byte & 0x80);
+    }
+    if (offset + size > object->size)
+        return MF_E_ASF_INVALIDDATA;
+    memcpy(object->data + offset, data, size);
+    object->filled += size;
+    if (object->filled < object->size)
+        return S_OK;
+    hr = splitter_queue_sample(splitter, number, object->data, object->size, object->presentation, object->key);
+    free(object->data);
+    memset(object, 0, sizeof(*object));
+    return hr;
+}
+
+static HRESULT splitter_parse_packet(struct splitter *splitter, const BYTE *packet, DWORD packet_size)
+{
+    const BYTE *p = packet, *end = packet + packet_size;
+    BYTE length_flags, property_flags;
+    DWORD padding, payload_count = 1, i, packet_length;
+    unsigned int rep_type, offset_type, object_type, stream_type, payload_length_type = 2;
+    BOOL ok = TRUE, multiple;
+    HRESULT hr = S_OK;
+
+    if (packet_size < 2)
+        return MF_E_ASF_INVALIDDATA;
+    if (p[0] & 0x80)
+    {
+        /* error correction data */
+        if (p[0] & 0x60)
+            return MF_E_ASF_INVALIDDATA;
+        p += 1 + (p[0] & 0x0f);
+    }
+    if (end - p < 2)
+        return MF_E_ASF_INVALIDDATA;
+    length_flags = *p++;
+    property_flags = *p++;
+    multiple = length_flags & 0x01;
+    packet_length = read_field(&p, end, (length_flags >> 5) & 3, &ok);
+    read_field(&p, end, (length_flags >> 1) & 3, &ok);          /* sequence */
+    padding = read_field(&p, end, (length_flags >> 3) & 3, &ok);
+    if (!ok || end - p < 6)
+        return MF_E_ASF_INVALIDDATA;
+    splitter->last_send = get_dword(p);
+    p += 6;     /* send time, duration */
+    if (packet_length && packet_length <= packet_size)
+        end = packet + packet_length;
+    if (padding > end - p)
+        return MF_E_ASF_INVALIDDATA;
+    end -= padding;
+
+    rep_type = property_flags & 3;
+    offset_type = (property_flags >> 2) & 3;
+    object_type = (property_flags >> 4) & 3;
+    stream_type = (property_flags >> 6) & 3;
+    if (multiple)
+    {
+        if (p >= end)
+            return MF_E_ASF_INVALIDDATA;
+        payload_count = *p & 0x3f;
+        payload_length_type = (*p >> 6) & 3;
+        p++;
+    }
+
+    for (i = 0; i < payload_count && SUCCEEDED(hr); i++)
+    {
+        BYTE stream_byte, object_number;
+        DWORD offset, rep_length, length, object_size = 0, presentation = 0;
+        const BYTE *rep;
+
+        if (p >= end)
+            return MF_E_ASF_INVALIDDATA;
+        stream_byte = *p++;
+        if (!stream_type)
+            return MF_E_ASF_INVALIDDATA;
+        if (stream_type != 1)
+            p += (stream_type == 3 ? 4 : stream_type) - 1;
+        object_number = read_field(&p, end, object_type, &ok);
+        offset = read_field(&p, end, offset_type, &ok);
+        rep_length = read_field(&p, end, rep_type, &ok);
+        if (!ok || rep_length > end - p)
+            return MF_E_ASF_INVALIDDATA;
+        rep = p;
+        p += rep_length;
+        if (rep_length >= 8)
+        {
+            object_size = get_dword(rep);
+            presentation = get_dword(rep + 4);
+        }
+        if (multiple)
+            length = read_field(&p, end, payload_length_type, &ok);
+        else
+            length = end - p;
+        if (!ok || length > end - p)
+            return MF_E_ASF_INVALIDDATA;
+
+        if (rep_length == 1)
+        {
+            /* compressed payload: "offset" is the presentation time, then sub-payloads of a BYTE length each */
+            const BYTE *sub = p, *sub_end = p + length;
+            DWORD delta = rep[0];
+
+            presentation = offset;
+            while (sub < sub_end && SUCCEEDED(hr))
+            {
+                DWORD sub_size = *sub++;
+
+                if (sub_size > sub_end - sub)
+                    return MF_E_ASF_INVALIDDATA;
+                hr = splitter_payload(splitter, stream_byte, object_number++, 0, sub_size, presentation, sub, sub_size);
+                presentation += delta;
+                sub += sub_size;
+            }
+        }
+        else if (rep_length >= 8)
+            hr = splitter_payload(splitter, stream_byte, object_number, offset, object_size, presentation, p, length);
+        p += length;
+    }
+    return hr;
+}
+
+static HRESULT WINAPI splitter_ParseData(IMFASFSplitter *iface, IMFMediaBuffer *buffer, DWORD offset, DWORD length)
+{
+    struct splitter *splitter = impl_from_IMFASFSplitter(iface);
+    DWORD size, pos;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("%p, %p, %lu, %lu.\n", iface, buffer, offset, length);
+
+    if (!buffer)
+        return E_INVALIDARG;
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &size)))
+        return hr;
+    EnterCriticalSection(&splitter->cs);
+    if (!splitter->initialized)
+        hr = MF_E_NOT_INITIALIZED;
+    else if (offset > size)
+        hr = E_INVALIDARG;
+    else
+    {
+        if (!length || length > size - offset)
+            length = size - offset;
+        data += offset;
+        pos = 0;
+        /* a packet split over two buffers */
+        if (splitter->pending)
+        {
+            DWORD need = min(splitter->packet_size - splitter->pending_size, length);
+
+            memcpy(splitter->pending + splitter->pending_size, data, need);
+            splitter->pending_size += need;
+            pos = need;
+            if (splitter->pending_size == splitter->packet_size)
+            {
+                hr = splitter_parse_packet(splitter, splitter->pending, splitter->packet_size);
+                free(splitter->pending);
+                splitter->pending = NULL;
+                splitter->pending_size = 0;
+            }
+        }
+        while (SUCCEEDED(hr) && pos + splitter->packet_size <= length)
+        {
+            hr = splitter_parse_packet(splitter, data + pos, splitter->packet_size);
+            pos += splitter->packet_size;
+        }
+        if (SUCCEEDED(hr) && pos < length)
+        {
+            if (!(splitter->pending = malloc(splitter->packet_size)))
+                hr = E_OUTOFMEMORY;
+            else
+            {
+                memcpy(splitter->pending, data + pos, length - pos);
+                splitter->pending_size = length - pos;
+            }
+        }
+    }
+    LeaveCriticalSection(&splitter->cs);
+    IMFMediaBuffer_Unlock(buffer);
+    return hr;
+}
+
+static HRESULT WINAPI splitter_GetNextSample(IMFASFSplitter *iface, DWORD *status, WORD *number, IMFSample **sample)
+{
+    struct splitter *splitter = impl_from_IMFASFSplitter(iface);
+    struct split_sample *entry;
+    struct list *head;
+
+    TRACE("%p, %p, %p, %p.\n", iface, status, number, sample);
+
+    if (!status || !number || !sample)
+        return E_INVALIDARG;
+    EnterCriticalSection(&splitter->cs);
+    *sample = NULL;
+    *status = 0;
+    if ((head = list_head(&splitter->samples)))
+    {
+        entry = LIST_ENTRY(head, struct split_sample, entry);
+        list_remove(&entry->entry);
+        *sample = entry->sample;
+        *number = entry->number;
+        free(entry);
+        if (!list_empty(&splitter->samples))
+            *status = ASF_STATUSFLAGS_INCOMPLETE;
+    }
+    LeaveCriticalSection(&splitter->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI splitter_Flush(IMFASFSplitter *iface)
+{
+    struct splitter *splitter = impl_from_IMFASFSplitter(iface);
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&splitter->cs);
+    splitter_flush(splitter);
+    LeaveCriticalSection(&splitter->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI splitter_GetLastSendTime(IMFASFSplitter *iface, DWORD *send_time)
+{
+    TRACE("%p, %p.\n", iface, send_time);
+
+    if (!send_time)
+        return E_INVALIDARG;
+    *send_time = impl_from_IMFASFSplitter(iface)->last_send;
+    return S_OK;
+}
+
+static const IMFASFSplitterVtbl splitter_vtbl =
+{
+    splitter_QueryInterface,
+    splitter_AddRef,
+    splitter_Release,
+    splitter_Initialize,
+    splitter_SetFlags,
+    splitter_GetFlags,
+    splitter_SelectStreams,
+    splitter_GetSelectedStreams,
+    splitter_ParseData,
+    splitter_GetNextSample,
+    splitter_Flush,
+    splitter_GetLastSendTime,
+};
+
+/***********************************************************************
+ *      MFCreateASFSplitter (mf.@)
+ */
+HRESULT WINAPI MFCreateASFSplitter(IMFASFSplitter **out)
+{
+    struct splitter *splitter;
+
+    TRACE("%p.\n", out);
+
+    if (!out)
+        return E_INVALIDARG;
+    if (!(splitter = calloc(1, sizeof(*splitter))))
+        return E_OUTOFMEMORY;
+    splitter->IMFASFSplitter_iface.lpVtbl = &splitter_vtbl;
+    splitter->refcount = 1;
+    list_init(&splitter->samples);
+    InitializeCriticalSectionEx(&splitter->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    splitter->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": splitter.cs");
+    *out = &splitter->IMFASFSplitter_iface;
+    return S_OK;
+}
