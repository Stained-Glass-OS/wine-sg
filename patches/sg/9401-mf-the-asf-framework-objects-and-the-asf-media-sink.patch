+static HRESULT WINAPI media_sink_GetCharacteristics(IMFFinalizableMediaSink *iface, DWORD *flags)
+{
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, flags %p.\n", iface, flags);
+
+    if (!flags)
+        return E_POINTER;
+
+    EnterCriticalSection(&media_sink->cs);
+    if (media_sink->state == STATE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        /* Output is written as fast as the samples come in, whatever the clock
+         * rate; streams can be added and removed. */
+        *flags = MEDIASINK_RATELESS;
+#ifdef SG_MUTANT_CHARFLAGS
+        *flags |= MEDIASINK_FIXED_STREAMS;
+#endif
+    }
+    LeaveCriticalSection(&media_sink->cs);
+
+    return hr;
+}
