+/* mutual exclusion */
+
+struct mutex_record
+{
+    WORD *streams;
+    DWORD count;
+};
+
+struct mutual_exclusion
+{
+    IMFASFMutualExclusion IMFASFMutualExclusion_iface;
+    LONG refcount;
+    GUID type;
+    struct mutex_record *records;
+    DWORD record_count;
+};
+
+static struct mutual_exclusion *impl_from_IMFASFMutualExclusion(IMFASFMutualExclusion *iface)
+{
+    return CONTAINING_RECORD(iface, struct mutual_exclusion, IMFASFMutualExclusion_iface);
+}
+
+static HRESULT WINAPI mutex_QueryInterface(IMFASFMutualExclusion *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFASFMutualExclusion) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFASFMutualExclusion_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI mutex_AddRef(IMFASFMutualExclusion *iface)
+{
+    return InterlockedIncrement(&impl_from_IMFASFMutualExclusion(iface)->refcount);
+}
+
+static ULONG WINAPI mutex_Release(IMFASFMutualExclusion *iface)
+{
+    struct mutual_exclusion *mutex = impl_from_IMFASFMutualExclusion(iface);
+    ULONG refcount = InterlockedDecrement(&mutex->refcount);
+    DWORD i;
+
+    if (!refcount)
+    {
+        for (i = 0; i < mutex->record_count; i++)
+            free(mutex->records[i].streams);
+        free(mutex->records);
+        free(mutex);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI mutex_GetType(IMFASFMutualExclusion *iface, GUID *type)
+{
+    TRACE("%p, %p.\n", iface, type);
+
+    if (!type)
+        return E_INVALIDARG;
+    *type = impl_from_IMFASFMutualExclusion(iface)->type;
+    return S_OK;
+}
+
+static HRESULT WINAPI mutex_SetType(IMFASFMutualExclusion *iface, REFGUID type)
+{
+    TRACE("%p, %s.\n", iface, debugstr_guid(type));
+
+    impl_from_IMFASFMutualExclusion(iface)->type = *type;
+    return S_OK;
+}
+
+static HRESULT WINAPI mutex_GetRecordCount(IMFASFMutualExclusion *iface, DWORD *count)
+{
+    TRACE("%p, %p.\n", iface, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    *count = impl_from_IMFASFMutualExclusion(iface)->record_count;
+    return S_OK;
+}
+
+static HRESULT WINAPI mutex_GetStreamsForRecord(IMFASFMutualExclusion *iface, DWORD index, WORD *streams, DWORD *count)
+{
+    struct mutual_exclusion *mutex = impl_from_IMFASFMutualExclusion(iface);
+    struct mutex_record *record;
+
+    TRACE("%p, %lu, %p, %p.\n", iface, index, streams, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    if (index >= mutex->record_count)
+        return MF_E_INVALIDINDEX;
+    record = &mutex->records[index];
+    if (!streams)
+    {
+        *count = record->count;
+        return S_OK;
+    }
+    if (*count < record->count)
+    {
+        *count = record->count;
+        return MF_E_BUFFERTOOSMALL;
+    }
+    memcpy(streams, record->streams, record->count * sizeof(*streams));
+    *count = record->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI mutex_AddStreamForRecord(IMFASFMutualExclusion *iface, DWORD index, WORD number)
+{
+    struct mutual_exclusion *mutex = impl_from_IMFASFMutualExclusion(iface);
+    struct mutex_record *record;
+    WORD *streams;
+    DWORD i;
+
+    TRACE("%p, %lu, %u.\n", iface, index, number);
+
+    if (index >= mutex->record_count)
+        return MF_E_INVALIDINDEX;
+    record = &mutex->records[index];
+    for (i = 0; i < record->count; i++)
+        if (record->streams[i] == number)
+            return E_INVALIDARG;
+    if (!(streams = realloc(record->streams, (record->count + 1) * sizeof(*streams))))
+        return E_OUTOFMEMORY;
+    record->streams = streams;
+    record->streams[record->count++] = number;
+    return S_OK;
+}
+
+static HRESULT WINAPI mutex_RemoveStreamFromRecord(IMFASFMutualExclusion *iface, DWORD index, WORD number)
+{
+    struct mutual_exclusion *mutex = impl_from_IMFASFMutualExclusion(iface);
+    struct mutex_record *record;
+    DWORD i;
+
+    TRACE("%p, %lu, %u.\n", iface, index, number);
+
+    if (index >= mutex->record_count)
+        return MF_E_INVALIDINDEX;
+    record = &mutex->records[index];
+    for (i = 0; i < record->count; i++)
+        if (record->streams[i] == number)
+        {
+            memmove(&record->streams[i], &record->streams[i + 1], (record->count - i - 1) * sizeof(WORD));
+            record->count--;
+            return S_OK;
+        }
+    return MF_E_INVALIDSTREAMNUMBER;
+}
+
+static HRESULT WINAPI mutex_RemoveRecord(IMFASFMutualExclusion *iface, DWORD index)
+{
+    struct mutual_exclusion *mutex = impl_from_IMFASFMutualExclusion(iface);
+
+    TRACE("%p, %lu.\n", iface, index);
+
+    if (index >= mutex->record_count)
+        return MF_E_INVALIDINDEX;
+    free(mutex->records[index].streams);
+    memmove(&mutex->records[index], &mutex->records[index + 1], (mutex->record_count - index - 1) * sizeof(*mutex->records));
+    mutex->record_count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI mutex_AddRecord(IMFASFMutualExclusion *iface, DWORD *index)
+{
+    struct mutual_exclusion *mutex = impl_from_IMFASFMutualExclusion(iface);
+    struct mutex_record *records;
+
+    TRACE("%p, %p.\n", iface, index);
+
+    if (!index)
+        return E_INVALIDARG;
+    if (!(records = realloc(mutex->records, (mutex->record_count + 1) * sizeof(*records))))
+        return E_OUTOFMEMORY;
+    mutex->records = records;
+    memset(&records[mutex->record_count], 0, sizeof(*records));
+    *index = mutex->record_count++;
+    return S_OK;
+}
+
+static HRESULT mutex_create(struct mutual_exclusion **out);
+
+static HRESULT WINAPI mutex_Clone(IMFASFMutualExclusion *iface, IMFASFMutualExclusion **out)
+{
+    struct mutual_exclusion *mutex = impl_from_IMFASFMutualExclusion(iface), *clone;
+    DWORD i, record;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p.\n", iface, out);
+
+    if (!out)
+        return E_INVALIDARG;
+    if (FAILED(hr = mutex_create(&clone)))
+        return hr;
+    clone->type = mutex->type;
+    for (i = 0; SUCCEEDED(hr) && i < mutex->record_count; i++)
+    {
+        DWORD j;
+
+        if (FAILED(hr = mutex_AddRecord(&clone->IMFASFMutualExclusion_iface, &record)))
+            break;
+        for (j = 0; SUCCEEDED(hr) && j < mutex->records[i].count; j++)
+            hr = mutex_AddStreamForRecord(&clone->IMFASFMutualExclusion_iface, record, mutex->records[i].streams[j]);
+    }
+    if (FAILED(hr))
+    {
+        IMFASFMutualExclusion_Release(&clone->IMFASFMutualExclusion_iface);
+        return hr;
+    }
+    *out = &clone->IMFASFMutualExclusion_iface;
+    return S_OK;
+}
+
+static const IMFASFMutualExclusionVtbl mutex_vtbl =
+{
+    mutex_QueryInterface,
+    mutex_AddRef,
+    mutex_Release,
+    mutex_GetType,
+    mutex_SetType,
+    mutex_GetRecordCount,
+    mutex_GetStreamsForRecord,
+    mutex_AddStreamForRecord,
+    mutex_RemoveStreamFromRecord,
+    mutex_RemoveRecord,
+    mutex_AddRecord,
+    mutex_Clone,
+};
+
+static HRESULT mutex_create(struct mutual_exclusion **out)
+{
+    struct mutual_exclusion *mutex;
+
+    if (!(mutex = calloc(1, sizeof(*mutex))))
+        return E_OUTOFMEMORY;
+    mutex->IMFASFMutualExclusion_iface.lpVtbl = &mutex_vtbl;
+    mutex->refcount = 1;
+    mutex->type = MFASFMutexType_Unknown;
+    *out = mutex;
+    return S_OK;
+}
