+/* the activation objects: a sink of the content info's profile, on a byte stream of the URL or of
+ * another activation object */
+struct sink_activate
+{
+    IMFActivate IMFActivate_iface;
+    LONG refcount;
+    IMFAttributes *attributes;
+    WCHAR *url;
+    IMFActivate *bytestream_activate;
+    IMFASFContentInfo *content_info;
+    IMFMediaSink *sink;
+};
+
+static struct sink_activate *impl_from_IMFActivate(IMFActivate *iface)
+{
+    return CONTAINING_RECORD(iface, struct sink_activate, IMFActivate_iface);
+}
+
+static HRESULT WINAPI sink_activate_QueryInterface(IMFActivate *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFActivate) || IsEqualIID(riid, &IID_IMFAttributes) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFActivate_AddRef(iface);
+        return S_OK;
+    }
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI sink_activate_AddRef(IMFActivate *iface)
+{
+    return InterlockedIncrement(&impl_from_IMFActivate(iface)->refcount);
+}
+
+static ULONG WINAPI sink_activate_Release(IMFActivate *iface)
+{
+    struct sink_activate *activate = impl_from_IMFActivate(iface);
+    ULONG refcount = InterlockedDecrement(&activate->refcount);
+
+    if (!refcount)
+    {
+        if (activate->sink)
+            IMFMediaSink_Release(activate->sink);
+        if (activate->bytestream_activate)
+            IMFActivate_Release(activate->bytestream_activate);
+        if (activate->content_info)
+            IMFASFContentInfo_Release(activate->content_info);
+        IMFAttributes_Release(activate->attributes);
+        free(activate->url);
+        free(activate);
+    }
+    return refcount;
+}
