+static HRESULT media_sink_create(IMFByteStream *bytestream, BOOL streaming, struct media_sink **out)
+{
+    struct media_sink *media_sink;
+    DWORD caps = 0;
+    HRESULT hr;
+
+    TRACE("bytestream %p, out %p.\n", bytestream, out);
+
+    if (!bytestream)
+        return E_POINTER;
+    /* documented: the file sink's byte stream must be writable and seekable */
+    if (FAILED(hr = IMFByteStream_GetCapabilities(bytestream, &caps)))
+        return hr;
+    if (!(caps & MFBYTESTREAM_IS_WRITABLE) || (!streaming && !(caps & MFBYTESTREAM_IS_SEEKABLE)))
+        return E_FAIL;
+
+    if (!(media_sink = calloc(1, sizeof(*media_sink))))
+        return E_OUTOFMEMORY;
+
+    if (FAILED(hr = MFCreateASFContentInfo(&media_sink->content_info)))
+        goto fail;
+    if (FAILED(hr = MFCreateEventQueue(&media_sink->event_queue)))
+        goto fail;
+
+    media_sink->IMFFinalizableMediaSink_iface.lpVtbl = &media_sink_vtbl;
+    media_sink->IMFMediaEventGenerator_iface.lpVtbl = &media_sink_event_vtbl;
+    media_sink->IMFClockStateSink_iface.lpVtbl = &media_sink_clock_sink_vtbl;
+    media_sink->IMFGetService_iface.lpVtbl = &media_sink_get_service_vtbl;
+    media_sink->IMFASFContentInfo_iface.lpVtbl = &sink_content_info_vtbl;
+    media_sink->streaming = streaming;
+    media_sink->async_callback.lpVtbl = &media_sink_callback_vtbl;
+    media_sink->refcount = 1;
+    media_sink->state = STATE_OPENED;
+    InitializeCriticalSectionEx(&media_sink->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    media_sink->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": cs");
+    IMFByteStream_AddRef((media_sink->bytestream = bytestream));
+    list_init(&media_sink->stream_sinks);
+
+    *out = media_sink;
+    TRACE("Created media sink %p.\n", media_sink);
+
+    return S_OK;
+
+fail:
+    if (media_sink->content_info)
+        IMFASFContentInfo_Release(media_sink->content_info);
+    free(media_sink);
+    return hr;
+}
+
+static HRESULT create_asf_sink(IMFByteStream *bytestream, BOOL streaming, IMFMediaSink **out)
+{
+    struct media_sink *media_sink;
+    HRESULT hr;
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = media_sink_create(bytestream, streaming, &media_sink)))
+        return hr;
+    *out = (IMFMediaSink *)&media_sink->IMFFinalizableMediaSink_iface;
+    return S_OK;
+}
