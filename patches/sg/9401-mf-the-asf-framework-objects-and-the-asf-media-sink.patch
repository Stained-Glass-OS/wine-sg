+static HRESULT media_sink_queue_command(struct media_sink *media_sink, enum async_op op)
+{
+    struct async_command *command;
+    HRESULT hr;
+
+    if (media_sink->state == STATE_SHUTDOWN)
+        return MF_E_SHUTDOWN;
+
+    if (FAILED(hr = async_command_create(op, &command)))
+        return hr;
+
+    hr = MFPutWorkItem(MFASYNC_CALLBACK_QUEUE_STANDARD,
+            &media_sink->async_callback, &command->IUnknown_iface);
+    IUnknown_Release(&command->IUnknown_iface);
+
+    return hr;
+}
+
+static HRESULT media_sink_queue_stream_event(struct media_sink *media_sink, MediaEventType type)
+{
+    struct stream_sink *stream_sink;
+    HRESULT hr;
+
+    LIST_FOR_EACH_ENTRY(stream_sink, &media_sink->stream_sinks, struct stream_sink, entry)
+    {
+        if (FAILED(hr = IMFMediaEventQueue_QueueEventParamVar(stream_sink->event_queue, type, &GUID_NULL, S_OK, NULL)))
+            return hr;
+    }
+
+    return S_OK;
+}
+
+static HRESULT write_buffer(IMFByteStream *stream, IMFMediaBuffer *buffer)
+{
+    DWORD length;
+    ULONG written;
+    BYTE *data;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &length)))
+        return hr;
+    hr = IMFByteStream_Write(stream, data, length, &written);
+    IMFMediaBuffer_Unlock(buffer);
+    return hr;
+}
+
+/* the multiplexer's ready packets, appended to the file */
+static HRESULT media_sink_write_packets(struct media_sink *media_sink)
+{
+    IMFMediaBuffer *buffer;
+    IMFSample *packet;
+    DWORD status;
+    HRESULT hr;
+
+    do
+    {
+        if (FAILED(hr = IMFASFMultiplexer_GetNextPacket(media_sink->mux, &status, &packet)))
+            return hr;
+        if (!packet)
+            break;
+        if (SUCCEEDED(hr = IMFSample_ConvertToContiguousBuffer(packet, &buffer)))
+        {
+            hr = write_buffer(media_sink->bytestream, buffer);
+            IMFMediaBuffer_Release(buffer);
+        }
+        IMFSample_Release(packet);
+        if (FAILED(hr))
+            return hr;
+    } while (status & ASF_STATUSFLAGS_INCOMPLETE);
+    return S_OK;
+}
+
+/* the header at the start of the file; the packets follow it, so the position is kept */
+static HRESULT media_sink_write_header(struct media_sink *media_sink)
+{
+    IMFMediaBuffer *buffer;
+    QWORD position = 0;
+    DWORD size;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFASFContentInfo_GenerateHeader(media_sink->content_info, NULL, &size)))
+        return hr;
+    if (FAILED(hr = MFCreateMemoryBuffer(size, &buffer)))
+        return hr;
+    if (SUCCEEDED(hr = IMFASFContentInfo_GenerateHeader(media_sink->content_info, buffer, &size)))
+    {
+        if (media_sink->header_written && size != media_sink->header_size)
+        {
+            ERR("The header changed size, %I64u -> %lu.\n", media_sink->header_size, size);
+            hr = E_FAIL;
+        }
+        else
+        {
+            if (media_sink->header_written)
+                IMFByteStream_GetCurrentPosition(media_sink->bytestream, &position);
+            if (SUCCEEDED(hr = IMFByteStream_SetCurrentPosition(media_sink->bytestream, 0)))
+                hr = write_buffer(media_sink->bytestream, buffer);
+            if (SUCCEEDED(hr) && media_sink->header_written)
+                hr = IMFByteStream_SetCurrentPosition(media_sink->bytestream, position);
+        }
+        media_sink->header_size = size;
+    }
+    IMFMediaBuffer_Release(buffer);
+    return hr;
+}
+
+static HRESULT media_sink_start(struct media_sink *media_sink)
+{
+    HRESULT hr;
+
+    /* the first start writes the header and sets the multiplexer up for the profile as it is */
+    if (!media_sink->header_written)
+    {
+        if (!media_sink->mux && FAILED(hr = MFCreateASFMultiplexer(&media_sink->mux)))
+            return hr;
+        if (FAILED(hr = IMFASFMultiplexer_Initialize(media_sink->mux, media_sink->content_info)))
+            return hr;
+        if (FAILED(hr = media_sink_write_header(media_sink)))
+            return hr;
+        media_sink->header_written = TRUE;
+    }
+
+    media_sink->state = STATE_STARTED;
+
+    if (FAILED(hr = media_sink_queue_stream_event(media_sink, MEStreamSinkStarted)))
+        return hr;
+    return media_sink_queue_stream_event(media_sink, MEStreamSinkRequestSample);
+}
+
+static HRESULT media_sink_stop(struct media_sink *media_sink)
+{
+    media_sink->state = STATE_STOPPED;
+    return media_sink_queue_stream_event(media_sink, MEStreamSinkStopped);
+
+}
+
+static HRESULT media_sink_pause(struct media_sink *media_sink)
+{
+    media_sink->state = STATE_PAUSED;
+    return media_sink_queue_stream_event(media_sink, MEStreamSinkPaused);
+}
+
+static HRESULT media_sink_process(struct media_sink *media_sink, IMFSample *sample, UINT32 stream_id)
+{
+    struct stream_sink *stream_sink;
+    HRESULT hr;
+
+    TRACE("media_sink %p, sample %p, stream_id %u.\n", media_sink, sample, stream_id);
+
+    if (!media_sink->mux || !media_sink->header_written)
+        return MF_E_INVALIDREQUEST;
+    if (FAILED(hr = IMFASFMultiplexer_ProcessSample(media_sink->mux, stream_id, sample, 0)))
+        return hr;
+    if (FAILED(hr = media_sink_write_packets(media_sink)))
+        WARN("Failed to write packets, hr %#lx.\n", hr);
+    if (media_sink->state == STATE_STARTED && (stream_sink = media_sink_get_stream_sink_by_id(media_sink, stream_id)))
+        IMFMediaEventQueue_QueueEventParamVar(stream_sink->event_queue, MEStreamSinkRequestSample, &GUID_NULL, S_OK, NULL);
+    return hr;
+}
+
+static HRESULT media_sink_begin_finalize(struct media_sink *media_sink, IMFAsyncCallback *callback, IUnknown *state)
+{
+    struct async_command *command;
+    IMFAsyncResult *result;
+    HRESULT hr;
+
+    if (media_sink->state == STATE_SHUTDOWN)
+        return MF_E_SHUTDOWN;
+    if (!callback)
+        return S_OK;
+
+    if (FAILED(hr = async_command_create(ASYNC_FINALIZE, &command)))
+        return hr;
+
+    if (FAILED(hr = MFCreateAsyncResult(NULL, callback, state, &result)))
+    {
+        IUnknown_Release(&command->IUnknown_iface);
+        return hr;
+    }
+    IMFAsyncResult_AddRef((command->u.finalize.result = result));
+
+    hr = MFPutWorkItem(MFASYNC_CALLBACK_QUEUE_STANDARD,
+            &media_sink->async_callback, &command->IUnknown_iface);
+    IUnknown_Release(&command->IUnknown_iface);
+
+    return hr;
+}
+
+static HRESULT media_sink_finalize(struct media_sink *media_sink, IMFAsyncResult *result)
+{
+    HRESULT hr;
+
+    media_sink->state = STATE_FINALIZED;
+
+    hr = S_OK;
+    if (!media_sink->mux && SUCCEEDED(hr = MFCreateASFMultiplexer(&media_sink->mux)))
+        hr = IMFASFMultiplexer_Initialize(media_sink->mux, media_sink->content_info);
+    if (SUCCEEDED(hr) && !media_sink->header_written && SUCCEEDED(hr = media_sink_write_header(media_sink)))
+        media_sink->header_written = TRUE;
+    if (SUCCEEDED(hr))
+        hr = IMFASFMultiplexer_Flush(media_sink->mux);
+    if (SUCCEEDED(hr))
+        hr = media_sink_write_packets(media_sink);
+    if (SUCCEEDED(hr))
+        hr = IMFASFMultiplexer_End(media_sink->mux, media_sink->content_info);
+    /* the file sink's header again, with the counts and durations; it keeps its size */
+#ifndef SG_MUTANT_ASFSINK_NO_FINAL_HEADER
+    if (SUCCEEDED(hr) && !media_sink->streaming)
+        hr = media_sink_write_header(media_sink);
+#endif
+
+    IMFAsyncResult_SetStatus(result, hr);
+    MFInvokeCallback(result);
+
+    return hr;
+}
+
+static HRESULT WINAPI media_sink_QueryInterface(IMFFinalizableMediaSink *iface, REFIID riid, void **obj)
+{
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(iface);
+
+    TRACE("iface %p, riid %s, obj %p.\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualIID(riid, &IID_IMFFinalizableMediaSink) ||
+            IsEqualIID(riid, &IID_IMFMediaSink) ||
+            IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+    }
+    else if (IsEqualGUID(riid, &IID_IMFMediaEventGenerator))
+    {
+        *obj = &media_sink->IMFMediaEventGenerator_iface;
+    }
+    else if (IsEqualIID(riid, &IID_IMFClockStateSink))
+    {
+        *obj = &media_sink->IMFClockStateSink_iface;
+    }
+    else if (IsEqualIID(riid, &IID_IMFGetService))
+    {
+        *obj = &media_sink->IMFGetService_iface;
+    }
+    else if (IsEqualIID(riid, &IID_IMFASFContentInfo))
+    {
+        *obj = &media_sink->IMFASFContentInfo_iface;
+    }
+    else
+    {
+        WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*obj);
+
+    return S_OK;
+}
+
+static ULONG WINAPI media_sink_AddRef(IMFFinalizableMediaSink *iface)
+{
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(iface);
+    ULONG refcount = InterlockedIncrement(&media_sink->refcount);
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI media_sink_Release(IMFFinalizableMediaSink *iface)
+{
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(iface);
+    ULONG refcount = InterlockedDecrement(&media_sink->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        IMFFinalizableMediaSink_Shutdown(iface);
+        IMFMediaEventQueue_Release(media_sink->event_queue);
+        IMFByteStream_Release(media_sink->bytestream);
+        media_sink->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&media_sink->cs);
+        if (media_sink->mux)
+            IMFASFMultiplexer_Release(media_sink->mux);
+        IMFASFContentInfo_Release(media_sink->content_info);
+        free(media_sink);
+    }
+
+    return refcount;
+}
