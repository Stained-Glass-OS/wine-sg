+static ULONG WINAPI profile_AddRef(IMFASFProfile *iface)
+{
+    return InterlockedIncrement(&impl_from_IMFASFProfile(iface)->refcount);
+}
+
+static ULONG WINAPI profile_Release(IMFASFProfile *iface)
+{
+    struct profile *profile = impl_from_IMFASFProfile(iface);
+    ULONG refcount = InterlockedDecrement(&profile->refcount);
+    DWORD i;
+
+    if (!refcount)
+    {
+        for (i = 0; i < profile->stream_count; i++)
+            IMFASFStreamConfig_Release(profile->streams[i]);
+        free(profile->streams);
+        for (i = 0; i < profile->mutex_count; i++)
+            IMFASFMutualExclusion_Release(profile->mutexes[i]);
+        free(profile->mutexes);
+        if (profile->prioritization)
+            IMFASFStreamPrioritization_Release(profile->prioritization);
+        IMFAttributes_Release(profile->attributes);
+        free(profile);
+    }
+    return refcount;
+}
