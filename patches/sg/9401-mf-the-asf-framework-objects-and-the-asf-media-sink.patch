+static HRESULT media_sink_set_profile(struct media_sink *media_sink, IMFASFProfile *profile)
+{
+    struct stream_sink *stream_sink, *next;
+    DWORD count, i;
+    HRESULT hr;
+
+    if (media_sink->state == STATE_SHUTDOWN)
+        return MF_E_SHUTDOWN;
+    if (media_sink->header_written)
+        return MF_E_INVALIDREQUEST;
+    if (FAILED(hr = IMFASFContentInfo_SetProfile(media_sink->content_info, profile)))
+        return hr;
+
+    /* the stream sinks are the profile's streams */
+    LIST_FOR_EACH_ENTRY_SAFE(stream_sink, next, &media_sink->stream_sinks, struct stream_sink, entry)
+    {
+        list_remove(&stream_sink->entry);
+        stream_sink->removed = true;
+        ++stream_sink->generation;
+        IMFMediaEventQueue_Shutdown(stream_sink->event_queue);
+        IMFStreamSink_Release(&stream_sink->IMFStreamSink_iface);
+    }
+    if (FAILED(hr = IMFASFProfile_GetStreamCount(profile, &count)))
+        return hr;
+    for (i = 0; SUCCEEDED(hr) && i < count; i++)
+    {
+        IMFASFStreamConfig *stream;
+        IMFMediaType *type = NULL;
+        WORD number;
+
+        if (FAILED(hr = IMFASFProfile_GetStream(profile, i, &number, &stream)))
+            break;
+        IMFASFStreamConfig_GetMediaType(stream, &type);
+        IMFASFStreamConfig_Release(stream);
+        if (SUCCEEDED(hr = stream_sink_create(number, type, media_sink, &stream_sink)))
+            list_add_tail(&media_sink->stream_sinks, &stream_sink->entry);
+        if (type)
+            IMFMediaType_Release(type);
+    }
+    return hr;
+}
+
+static HRESULT WINAPI sink_content_info_SetProfile(IMFASFContentInfo *iface, IMFASFProfile *profile)
+{
+    struct media_sink *media_sink = impl_from_IMFASFContentInfo(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, profile %p.\n", iface, profile);
+
+    if (!profile)
+        return E_INVALIDARG;
+    EnterCriticalSection(&media_sink->cs);
+    hr = media_sink_set_profile(media_sink, profile);
+    LeaveCriticalSection(&media_sink->cs);
+    return hr;
+}
