+static HRESULT copy_attributes(IMFAttributes *from, IMFAttributes **out)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateAttributes(out, 0)))
+        return hr;
+    if (from && FAILED(hr = IMFAttributes_CopyAllItems(from, *out)))
+    {
+        IMFAttributes_Release(*out);
+        *out = NULL;
+    }
+    return hr;
+}
+
+static HRESULT clone_media_type(IMFMediaType *from, IMFMediaType **out)
+{
+    HRESULT hr;
+
+    *out = NULL;
+    if (!from)
+        return S_OK;
+    if (FAILED(hr = MFCreateMediaType(out)))
+        return hr;
+    if (FAILED(hr = IMFMediaType_CopyAllItems(from, (IMFAttributes *)*out)))
+    {
+        IMFMediaType_Release(*out);
+        *out = NULL;
+    }
+    return hr;
+}
