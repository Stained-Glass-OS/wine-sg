+static HRESULT stream_config_create(IMFMediaType *media_type, IMFAttributes *attributes, struct stream_config **out);
+
+static HRESULT stream_config_clone(struct stream_config *config, struct stream_config **out)
+{
+    struct stream_config *clone;
+    HRESULT hr;
+    WORD i;
+
+    if (FAILED(hr = stream_config_create(config->media_type, config->attributes, &clone)))
+        return hr;
+    clone->number = config->number;
+    for (i = 0; SUCCEEDED(hr) && i < config->extension_count; i++)
+        hr = stream_config_add_extension(clone, &config->extensions[i].system_id, config->extensions[i].data_size,
+                config->extensions[i].info, config->extensions[i].info_size);
+    if (FAILED(hr))
+    {
+        IMFASFStreamConfig_Release(&clone->IMFASFStreamConfig_iface);
+        return hr;
+    }
+    *out = clone;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_Clone(IMFASFStreamConfig *iface, IMFASFStreamConfig **out)
