+    if (!stream)
+        return E_INVALIDARG;
+    number = IMFASFStreamConfig_GetStreamNumber(stream);
+    if (!number || number > MFASF_MAX_STREAM_NUMBER)
+        return MF_E_INVALIDSTREAMNUMBER;
+    if (FAILED(hr = IMFASFStreamConfig_Clone(stream, &copy)))
+        return hr;
+
+    if ((index = profile_find_stream(profile, number)) >= 0)
+    {
+        IMFASFStreamConfig_Release(profile->streams[index]);
+        profile->streams[index] = copy;
+        return S_OK;
+    }
+    if (!(streams = realloc(profile->streams, (profile->stream_count + 1) * sizeof(*streams))))
+    {
+        IMFASFStreamConfig_Release(copy);
+        return E_OUTOFMEMORY;
+    }
+    profile->streams = streams;
+    profile->streams[profile->stream_count++] = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_RemoveStream(IMFASFProfile *iface, WORD number)
+{
+    struct profile *profile = impl_from_IMFASFProfile(iface);
+    int index;
+
+    TRACE("%p, %u.\n", iface, number);
+
+    if ((index = profile_find_stream(profile, number)) < 0)
+        return MF_E_NOT_FOUND;
+    IMFASFStreamConfig_Release(profile->streams[index]);
+    memmove(&profile->streams[index], &profile->streams[index + 1], (profile->stream_count - index - 1) * sizeof(*profile->streams));
+    profile->stream_count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_CreateStream(IMFASFProfile *iface, IMFMediaType *media_type, IMFASFStreamConfig **stream)
+{
+    TRACE("%p, %p, %p.\n", iface, media_type, stream);
+
+    if (!media_type || !stream)
+        return E_INVALIDARG;
+    return asf_stream_config_create(media_type, 0, stream);
+}
+
+static HRESULT WINAPI profile_GetMutualExclusionCount(IMFASFProfile *iface, DWORD *count)
+{
+    TRACE("%p, %p.\n", iface, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    *count = impl_from_IMFASFProfile(iface)->mutex_count;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_GetMutualExclusion(IMFASFProfile *iface, DWORD index, IMFASFMutualExclusion **mutex)
+{
+    struct profile *profile = impl_from_IMFASFProfile(iface);
+
+    TRACE("%p, %lu, %p.\n", iface, index, mutex);
+
+    if (!mutex)
+        return E_INVALIDARG;
+    if (index >= profile->mutex_count)
+        return MF_E_INVALIDINDEX;
+    IMFASFMutualExclusion_AddRef(*mutex = profile->mutexes[index]);
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_AddMutualExclusion(IMFASFProfile *iface, IMFASFMutualExclusion *mutex)
+{
+    struct profile *profile = impl_from_IMFASFProfile(iface);
+    IMFASFMutualExclusion *copy, **mutexes;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, mutex);
+
+    if (!mutex)
+        return E_INVALIDARG;
+    if (FAILED(hr = IMFASFMutualExclusion_Clone(mutex, &copy)))
+        return hr;
+    if (!(mutexes = realloc(profile->mutexes, (profile->mutex_count + 1) * sizeof(*mutexes))))
+    {
+        IMFASFMutualExclusion_Release(copy);
+        return E_OUTOFMEMORY;
+    }
+    profile->mutexes = mutexes;
+    profile->mutexes[profile->mutex_count++] = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_RemoveMutualExclusion(IMFASFProfile *iface, DWORD index)
+{
+    struct profile *profile = impl_from_IMFASFProfile(iface);
+
+    TRACE("%p, %lu.\n", iface, index);
+
+    if (index >= profile->mutex_count)
+        return MF_E_INVALIDINDEX;
+    IMFASFMutualExclusion_Release(profile->mutexes[index]);
+    memmove(&profile->mutexes[index], &profile->mutexes[index + 1], (profile->mutex_count - index - 1) * sizeof(*profile->mutexes));
+    profile->mutex_count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_CreateMutualExclusion(IMFASFProfile *iface, IMFASFMutualExclusion **out)
+{
+    struct mutual_exclusion *mutex;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, out);
+
+    if (!out)
+        return E_INVALIDARG;
+    if (FAILED(hr = mutex_create(&mutex)))
+        return hr;
+    *out = &mutex->IMFASFMutualExclusion_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_GetStreamPrioritization(IMFASFProfile *iface, IMFASFStreamPrioritization **out)
+{
+    struct profile *profile = impl_from_IMFASFProfile(iface);
+
+    TRACE("%p, %p.\n", iface, out);
+
+    if (!out)
+        return E_INVALIDARG;
+    if ((*out = profile->prioritization))
+        IMFASFStreamPrioritization_AddRef(*out);
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_AddStreamPrioritization(IMFASFProfile *iface, IMFASFStreamPrioritization *prioritization)
+{
+    struct profile *profile = impl_from_IMFASFProfile(iface);
+    IMFASFStreamPrioritization *copy;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, prioritization);
+
+    if (!prioritization)
+        return E_INVALIDARG;
+    if (FAILED(hr = IMFASFStreamPrioritization_Clone(prioritization, &copy)))
+        return hr;
+    if (profile->prioritization)
+        IMFASFStreamPrioritization_Release(profile->prioritization);
+    profile->prioritization = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_RemoveStreamPrioritization(IMFASFProfile *iface)
+{
+    struct profile *profile = impl_from_IMFASFProfile(iface);
+
+    TRACE("%p.\n", iface);
+
+    if (profile->prioritization)
+        IMFASFStreamPrioritization_Release(profile->prioritization);
+    profile->prioritization = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_CreateStreamPrioritization(IMFASFProfile *iface, IMFASFStreamPrioritization **out)
+{
+    struct prioritization *prioritization;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, out);
+
+    if (!out)
+        return E_INVALIDARG;
+    if (FAILED(hr = prioritization_create(&prioritization)))
+        return hr;
+    *out = &prioritization->IMFASFStreamPrioritization_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_Clone(IMFASFProfile *iface, IMFASFProfile **out)
+{
+    struct profile *profile = impl_from_IMFASFProfile(iface);
+    IMFASFProfile *clone;
+    HRESULT hr;
+    DWORD i;
+
+    TRACE("%p, %p.\n", iface, out);
+
+    if (!out)
+        return E_INVALIDARG;
+    if (FAILED(hr = MFCreateASFProfile(&clone)))
+        return hr;
+    hr = IMFAttributes_CopyAllItems(profile->attributes, (IMFAttributes *)clone);
+    for (i = 0; SUCCEEDED(hr) && i < profile->stream_count; i++)
+        hr = IMFASFProfile_SetStream(clone, profile->streams[i]);
+    for (i = 0; SUCCEEDED(hr) && i < profile->mutex_count; i++)
+        hr = IMFASFProfile_AddMutualExclusion(clone, profile->mutexes[i]);
+    if (SUCCEEDED(hr) && profile->prioritization)
+        hr = IMFASFProfile_AddStreamPrioritization(clone, profile->prioritization);
+    if (FAILED(hr))
+    {
+        IMFASFProfile_Release(clone);
+        return hr;
+    }
+    *out = clone;
+    return S_OK;
+}
+
+static const IMFASFProfileVtbl profile_vtbl =
+{
+    profile_QueryInterface,
+    profile_AddRef,
+    profile_Release,
+    ASF_ATTRIBUTES_VTBL(profile),
+    profile_GetStreamCount,
+    profile_GetStream,
+    profile_GetStreamByNumber,
+    profile_SetStream,
+    profile_RemoveStream,
+    profile_CreateStream,
+    profile_GetMutualExclusionCount,
+    profile_GetMutualExclusion,
+    profile_AddMutualExclusion,
+    profile_RemoveMutualExclusion,
+    profile_CreateMutualExclusion,
+    profile_GetStreamPrioritization,
+    profile_AddStreamPrioritization,
+    profile_RemoveStreamPrioritization,
+    profile_CreateStreamPrioritization,
+    profile_Clone,
+};
+
+/***********************************************************************
+ *      MFCreateASFProfile (mf.@)
+ */
+HRESULT WINAPI MFCreateASFProfile(IMFASFProfile **out)
+{
+    struct profile *profile;
+    HRESULT hr;
+
+    TRACE("%p.\n", out);
+
+    if (!out)
+        return E_INVALIDARG;
+    if (!(profile = calloc(1, sizeof(*profile))))
+        return E_OUTOFMEMORY;
+    profile->IMFASFProfile_iface.lpVtbl = &profile_vtbl;
+    profile->refcount = 1;
+    if (FAILED(hr = MFCreateAttributes(&profile->attributes, 0)))
+    {
+        free(profile);
+        return hr;
+    }
+    *out = &profile->IMFASFProfile_iface;
+    return S_OK;
+}
+
+/***********************************************************************
+ *      MFCreateASFProfileFromPresentationDescriptor (mf.@)
+ *
+ * A stream per stream descriptor, numbered by its identifier, of its current media type; the
+ * descriptor's attributes become the profile's.
+ */
+HRESULT WINAPI MFCreateASFProfileFromPresentationDescriptor(IMFPresentationDescriptor *descriptor, IMFASFProfile **out)
+{
+    IMFASFProfile *profile;
+    DWORD count, i;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", descriptor, out);
+
+    if (!descriptor || !out)
+        return E_INVALIDARG;
+    if (FAILED(hr = MFCreateASFProfile(&profile)))
+        return hr;
+    hr = IMFPresentationDescriptor_CopyAllItems(descriptor, (IMFAttributes *)profile);
+    if (SUCCEEDED(hr))
+        hr = IMFPresentationDescriptor_GetStreamDescriptorCount(descriptor, &count);
+    for (i = 0; SUCCEEDED(hr) && i < count; i++)
+    {
+        IMFStreamDescriptor *sd;
+        IMFMediaTypeHandler *handler;
+        IMFASFStreamConfig *stream;
+        IMFMediaType *type;
+        DWORD id;
+        BOOL selected;
+
+        if (FAILED(hr = IMFPresentationDescriptor_GetStreamDescriptorByIndex(descriptor, i, &selected, &sd)))
+            break;
+        if (SUCCEEDED(hr = IMFStreamDescriptor_GetStreamIdentifier(sd, &id))
+                && SUCCEEDED(hr = IMFStreamDescriptor_GetMediaTypeHandler(sd, &handler)))
+        {
+            if (SUCCEEDED(hr = IMFMediaTypeHandler_GetCurrentMediaType(handler, &type)))
+            {
+                if (SUCCEEDED(hr = asf_stream_config_create(type, id, &stream)))
+                {
+                    hr = IMFStreamDescriptor_CopyAllItems(sd, (IMFAttributes *)stream);
+                    if (SUCCEEDED(hr))
+                        hr = IMFASFProfile_SetStream(profile, stream);
+                    IMFASFStreamConfig_Release(stream);
+                }
+                IMFMediaType_Release(type);
+            }
+            IMFMediaTypeHandler_Release(handler);
+        }
+        IMFStreamDescriptor_Release(sd);
+    }
+    if (FAILED(hr))
+    {
+        IMFASFProfile_Release(profile);
+        return hr;
+    }
+    *out = profile;
+    return S_OK;
+}
+
+/***********************************************************************
+ *      MFCreatePresentationDescriptorFromASFProfile (mf.@)
+ */
+HRESULT WINAPI MFCreatePresentationDescriptorFromASFProfile(IMFASFProfile *profile, IMFPresentationDescriptor **out)
+{
+    IMFStreamDescriptor **descriptors;
+    IMFPresentationDescriptor *pd;
+    DWORD count, i, made = 0;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", profile, out);
+
+    if (!profile || !out)
+        return E_INVALIDARG;
+    if (FAILED(hr = IMFASFProfile_GetStreamCount(profile, &count)))
+        return hr;
+    if (!(descriptors = calloc(max(count, 1), sizeof(*descriptors))))
+        return E_OUTOFMEMORY;
+    for (i = 0; SUCCEEDED(hr) && i < count; i++)
+    {
+        IMFASFStreamConfig *stream;
+        IMFMediaType *type;
+        WORD number;
+
+        if (FAILED(hr = IMFASFProfile_GetStream(profile, i, &number, &stream)))
+            break;
+        if (SUCCEEDED(hr = IMFASFStreamConfig_GetMediaType(stream, &type)))
+        {
+            if (SUCCEEDED(hr = MFCreateStreamDescriptor(number, 1, &type, &descriptors[made])))
+            {
+                IMFMediaTypeHandler *handler;
+
+                if (SUCCEEDED(IMFStreamDescriptor_GetMediaTypeHandler(descriptors[made], &handler)))
+                {
+                    IMFMediaTypeHandler_SetCurrentMediaType(handler, type);
+                    IMFMediaTypeHandler_Release(handler);
+                }
+                hr = IMFASFStreamConfig_CopyAllItems(stream, (IMFAttributes *)descriptors[made]);
+                made++;
+            }
+            IMFMediaType_Release(type);
+        }
+        IMFASFStreamConfig_Release(stream);
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = MFCreatePresentationDescriptor(made, descriptors, &pd)))
+    {
+        hr = IMFASFProfile_CopyAllItems(profile, (IMFAttributes *)pd);
+        for (i = 0; SUCCEEDED(hr) && i < made; i++)
+            hr = IMFPresentationDescriptor_SelectStream(pd, i);
+        if (SUCCEEDED(hr))
+            *out = pd;
+        else
+            IMFPresentationDescriptor_Release(pd);
+    }
+    for (i = 0; i < made; i++)
+        IMFStreamDescriptor_Release(descriptors[i]);
+    free(descriptors);
+    return hr;
+}
