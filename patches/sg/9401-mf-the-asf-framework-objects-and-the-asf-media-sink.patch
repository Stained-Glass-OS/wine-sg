+#define ACTIVATE_FORWARD(name, args, call) \
+static HRESULT WINAPI sink_activate_##name args \
+{ return IMFAttributes_##name call; }
+
+ACTIVATE_FORWARD(GetItem, (IMFActivate *iface, REFGUID key, PROPVARIANT *value), (impl_from_IMFActivate(iface)->attributes, key, value))
+ACTIVATE_FORWARD(GetItemType, (IMFActivate *iface, REFGUID key, MF_ATTRIBUTE_TYPE *type), (impl_from_IMFActivate(iface)->attributes, key, type))
+ACTIVATE_FORWARD(CompareItem, (IMFActivate *iface, REFGUID key, REFPROPVARIANT value, BOOL *result), (impl_from_IMFActivate(iface)->attributes, key, value, result))
+ACTIVATE_FORWARD(Compare, (IMFActivate *iface, IMFAttributes *theirs, MF_ATTRIBUTES_MATCH_TYPE type, BOOL *result), (impl_from_IMFActivate(iface)->attributes, theirs, type, result))
+ACTIVATE_FORWARD(GetUINT32, (IMFActivate *iface, REFGUID key, UINT32 *value), (impl_from_IMFActivate(iface)->attributes, key, value))
+ACTIVATE_FORWARD(GetUINT64, (IMFActivate *iface, REFGUID key, UINT64 *value), (impl_from_IMFActivate(iface)->attributes, key, value))
+ACTIVATE_FORWARD(GetDouble, (IMFActivate *iface, REFGUID key, double *value), (impl_from_IMFActivate(iface)->attributes, key, value))
