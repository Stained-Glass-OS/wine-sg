+static HRESULT WINAPI sink_activate_ActivateObject(IMFActivate *iface, REFIID riid, void **out)
+{
+    struct sink_activate *activate = impl_from_IMFActivate(iface);
+    IMFByteStream *bytestream = NULL;
+    IMFASFContentInfo *info;
+    IMFASFProfile *profile;
+    IMFMediaSink *sink;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (!activate->sink)
+    {
+        if (activate->url)
+            hr = MFCreateFile(MF_ACCESSMODE_READWRITE, MF_OPENMODE_DELETE_IF_EXIST, MF_FILEFLAGS_NONE,
+                    activate->url, &bytestream);
+        else
+            hr = IMFActivate_ActivateObject(activate->bytestream_activate, &IID_IMFByteStream, (void **)&bytestream);
+        if (FAILED(hr))
+            return hr;
+        hr = create_asf_sink(bytestream, !activate->url, &sink);
+        IMFByteStream_Release(bytestream);
+        if (FAILED(hr))
+            return hr;
+        if (SUCCEEDED(hr = IMFMediaSink_QueryInterface(sink, &IID_IMFASFContentInfo, (void **)&info)))
+        {
+            if (SUCCEEDED(hr = IMFASFContentInfo_GetProfile(activate->content_info, &profile)))
+            {
+                hr = IMFASFContentInfo_SetProfile(info, profile);
+                IMFASFProfile_Release(profile);
+            }
+            IMFASFContentInfo_Release(info);
+        }
+        if (FAILED(hr))
+        {
+            IMFMediaSink_Shutdown(sink);
+            IMFMediaSink_Release(sink);
+            return hr;
+        }
+        activate->sink = sink;
+    }
+    return IMFMediaSink_QueryInterface(activate->sink, riid, out);
+}
+
+static HRESULT WINAPI sink_activate_ShutdownObject(IMFActivate *iface)
+{
+    struct sink_activate *activate = impl_from_IMFActivate(iface);
+
+    TRACE("%p.\n", iface);
+
+    if (activate->sink)
+    {
+        IMFMediaSink_Shutdown(activate->sink);
+        IMFMediaSink_Release(activate->sink);
+        activate->sink = NULL;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_activate_DetachObject(IMFActivate *iface)
+{
+    struct sink_activate *activate = impl_from_IMFActivate(iface);
+
+    TRACE("%p.\n", iface);
+
+    if (activate->sink)
+        IMFMediaSink_Release(activate->sink);
+    activate->sink = NULL;
+    return S_OK;
+}
