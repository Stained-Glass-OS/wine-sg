From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9_36: packed conversion sources (3643)

d3dx9_36: packed conversion sources (RGBG, GRGB, UYVY, YUY2)
---
diff --git a/dlls/d3dx9_36/surface.c b/dlls/d3dx9_36/surface.c
index 865abee..6ed2635 100644
--- a/dlls/d3dx9_36/surface.c
+++ b/dlls/d3dx9_36/surface.c
@@ -2809,6 +2809,98 @@ HRESULT d3dx_load_pixels_from_pixels(struct d3dx_pixels *dst_pixels,
         return S_OK;
     }
 
+    /* Packed sources (two pixels per 32 bit block) are expanded to B8G8R8A8 first. */
+    if (is_packed_format(src_desc) && src_desc->format != D3DX_PIXEL_FORMAT_A1_UNORM
+            && src_desc->block_width == 2)
+    {
+        const struct pixel_format_desc *expanded_desc = get_d3dx_pixel_format_info(D3DX_PIXEL_FORMAT_B8G8R8A8_UNORM);
+        uint32_t x, y, z, expanded_row_pitch = src_pixels->size.width * 4;
+        uint32_t expanded_slice_pitch = expanded_row_pitch * src_pixels->size.height;
+        struct d3dx_pixels expanded_pixels;
+        BYTE *expanded_mem;
+
+        if (!(expanded_mem = malloc((size_t)expanded_slice_pitch * src_pixels->size.depth)))
+        {
+            hr = E_OUTOFMEMORY;
+            goto exit;
+        }
+        for (z = 0; z < src_pixels->size.depth; ++z)
+        {
+            for (y = 0; y < src_pixels->size.height; ++y)
+            {
+                const BYTE *in = (const BYTE *)src_pixels->data + z * src_pixels->slice_pitch + y * src_pixels->row_pitch;
+                BYTE *out = expanded_mem + z * expanded_slice_pitch + y * expanded_row_pitch;
+
+                for (x = 0; x < src_pixels->size.width; x += 2, in += 4)
+                {
+                    BYTE rgb[2][3]; /* r, g, b of the two pixels */
+                    unsigned int p;
+
+                    switch (src_desc->format)
+                    {
+                        case D3DX_PIXEL_FORMAT_R8G8_B8G8_UNORM:
+                            rgb[0][0] = rgb[1][0] = in[0];
+#ifdef SG_MUTANT_PACKED_SWAP
+                            rgb[0][1] = in[3];
+                            rgb[1][1] = in[1];
+#else
+                            rgb[0][1] = in[1];
+                            rgb[1][1] = in[3];
+#endif
+                            rgb[0][2] = rgb[1][2] = in[2];
+                            break;
+                        case D3DX_PIXEL_FORMAT_G8R8_G8B8_UNORM:
+                            rgb[0][0] = rgb[1][0] = in[1];
+                            rgb[0][1] = in[0];
+                            rgb[1][1] = in[2];
+                            rgb[0][2] = rgb[1][2] = in[3];
+                            break;
+                        default:
+                        {
+                            /* UYVY: U Y0 V Y1, YUY2: Y0 U Y1 V; ITU-R BT.601, studio range */
+                            BYTE u, v, y_[2];
+                            int d, e;
+
+                            if (src_desc->format == D3DX_PIXEL_FORMAT_UYVY)
+                            {
+                                u = in[0]; y_[0] = in[1]; v = in[2]; y_[1] = in[3];
+                            }
+                            else
+                            {
+                                y_[0] = in[0]; u = in[1]; y_[1] = in[2]; v = in[3];
+                            }
+                            d = u - 128;
+                            e = v - 128;
+                            for (p = 0; p < 2; ++p)
+                            {
+                                int c = (y_[p] - 16) * 298, r = (c + 409 * e + 128) >> 8;
+                                int g = (c - 100 * d - 208 * e + 128) >> 8, b = (c + 516 * d + 128) >> 8;
+
+                                rgb[p][0] = r < 0 ? 0 : r > 255 ? 255 : r;
+                                rgb[p][1] = g < 0 ? 0 : g > 255 ? 255 : g;
+                                rgb[p][2] = b < 0 ? 0 : b > 255 ? 255 : b;
+                            }
+                            break;
+                        }
+                    }
+                    for (p = 0; p < 2 && x + p < src_pixels->size.width; ++p)
+                    {
+                        out[(x + p) * 4 + 0] = rgb[p][2];
+                        out[(x + p) * 4 + 1] = rgb[p][1];
+                        out[(x + p) * 4 + 2] = rgb[p][0];
+                        out[(x + p) * 4 + 3] = 0xff;
+                    }
+                }
+            }
+        }
+        d3dx_pixels_init(expanded_mem, expanded_row_pitch, expanded_slice_pitch, NULL, expanded_desc->format, 0, 0,
+                src_pixels->size.width, src_pixels->size.height, 0, src_pixels->size.depth, &expanded_pixels);
+        hr = d3dx_load_pixels_from_pixels(dst_pixels, dst_desc, &expanded_pixels, expanded_desc, filter_flags,
+                color_key);
+        free(expanded_mem);
+        goto exit;
+    }
+
     /* Stretching or format conversion. */
     if (!is_conversion_from_supported(src_desc)
             || !is_conversion_to_supported(dst_desc))
diff --git a/dlls/d3dx9_36/tests/surface.c b/dlls/d3dx9_36/tests/surface.c
index 2e8eda7..7a90b44 100644
--- a/dlls/d3dx9_36/tests/surface.c
+++ b/dlls/d3dx9_36/tests/surface.c
@@ -4142,6 +4142,38 @@ static void test_sg_gap4_surface(IDirect3DDevice9 *device)
         ok(a[i] == b[i], "Pixel %u: L6V5U5 gives %#lx, X8L8V8U8 %#lx.\n", i, a[i], b[i]);
     IDirect3DSurface9_Release(surf);
 
+    /* packed sources: two pixels share a block */
+    {
+        static const BYTE rgbg[4] = {10, 20, 30, 40}, grgb[4] = {20, 10, 40, 30};
+        static const BYTE yuy2_white_black[4] = {235, 128, 16, 128}, uyvy_white_black[4] = {128, 235, 128, 16};
+        static const struct { const BYTE *data; D3DFORMAT format; DWORD p0, p1; } packed[] =
+        {
+            {rgbg, D3DFMT_R8G8_B8G8, 0xff0a141e, 0xff0a281e},
+            {grgb, D3DFMT_G8R8_G8B8, 0xff0a141e, 0xff0a281e},
+            {yuy2_white_black, D3DFMT_YUY2, 0xffffffff, 0xff000000},
+            {uyvy_white_black, D3DFMT_UYVY, 0xffffffff, 0xff000000},
+        };
+        IDirect3DSurface9 *dst;
+        RECT r = {0, 0, 2, 1};
+
+        hr = IDirect3DDevice9_CreateOffscreenPlainSurface(device, 2, 1, D3DFMT_A8R8G8B8, D3DPOOL_SCRATCH, &dst, NULL);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        for (i = 0; i < ARRAY_SIZE(packed); ++i)
+        {
+            hr = D3DXLoadSurfaceFromMemory(dst, NULL, NULL, packed[i].data, packed[i].format, 4, NULL, &r,
+                    D3DX_FILTER_NONE, 0);
+            ok(hr == D3D_OK, "Format %#x: got hr %#lx.\n", packed[i].format, hr);
+            if (FAILED(hr))
+                continue;
+            IDirect3DSurface9_LockRect(dst, &lock, NULL, D3DLOCK_READONLY);
+            ok(((DWORD *)lock.pBits)[0] == packed[i].p0 && ((DWORD *)lock.pBits)[1] == packed[i].p1,
+                    "Format %#x: got %#lx, %#lx.\n", packed[i].format, ((DWORD *)lock.pBits)[0],
+                    ((DWORD *)lock.pBits)[1]);
+            IDirect3DSurface9_UnlockRect(dst);
+        }
+        IDirect3DSurface9_Release(dst);
+    }
+
     /* a palettized surface can be saved to the other file formats, with its palette */
     palette[0].peRed = 255; palette[0].peFlags = 255;
     palette[1].peGreen = 255; palette[1].peFlags = 255;
