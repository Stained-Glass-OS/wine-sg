+/* Stained Glass OS: reads one custom property, looking in the device's
+ * hardware key (Device Parameters) first and then its driver key. With
+ * DICUSTOMDEVPROP_MERGE_MULTISZ, multi-string values from both are joined. */
+static BOOL get_custom_device_property(HDEVINFO devinfo, SP_DEVINFO_DATA *data, const WCHAR *name, DWORD flags,
+        BOOL ansi, DWORD *reg_type, BYTE *buffer, DWORD bufsize, DWORD *required)
 {
-    FIXME("devinfo %p, data %p, name %s, flags %#lx, reg_type %p, buffer %p, bufsize %lu, required %p stub.\n",
-            devinfo, data, debugstr_a(name), flags, reg_type, buffer, bufsize, required);
+    static const DWORD which[2] = {DIREG_DEV, DIREG_DRV};
+    BYTE *values[2] = {NULL, NULL}, *out = NULL;
+    DWORD types[2] = {0, 0}, sizes[2] = {0, 0}, type, total = 0, i;
+    BOOL ret = FALSE;
+    LONG l;
 
-    SetLastError(ERROR_INVALID_DATA);
-    return FALSE;
+    if (!get_device(devinfo, data)) return FALSE;
+    if (!name || !*name || (bufsize && !buffer))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (flags & ~DICUSTOMDEVPROP_MERGE_MULTISZ)
+    {
+        SetLastError(ERROR_INVALID_FLAGS);
+        return FALSE;
+    }
+
+    for (i = 0; i < 2; ++i)
+    {
+        HKEY key = SetupDiOpenDevRegKey(devinfo, data, DICS_FLAG_GLOBAL, 0, which[i], KEY_READ);
+
+        if (key == INVALID_HANDLE_VALUE) continue;
+        if (!RegQueryValueExW(key, name, NULL, &types[i], NULL, &sizes[i]) && (values[i] = malloc(sizes[i] + 2)))
+        {
+            if ((l = RegQueryValueExW(key, name, NULL, &types[i], values[i], &sizes[i])))
+            {
+                free(values[i]);
+                values[i] = NULL;
+            }
+        }
+        RegCloseKey(key);
+        if (values[i] && !((flags & DICUSTOMDEVPROP_MERGE_MULTISZ) && types[i] == REG_MULTI_SZ)) break;
+    }
+
+    if (!values[0] && !values[1])
+    {
+        SetLastError(ERROR_INVALID_DATA);
+        return FALSE;
+    }
+
+    if (values[0] && values[1] && types[0] == REG_MULTI_SZ && types[1] == REG_MULTI_SZ)
+    {
+        /* each value ends in an empty string; join the strings, one terminator */
+        DWORD n0 = sizes[0] / sizeof(WCHAR), n1 = sizes[1] / sizeof(WCHAR), pos = 0;
+        WCHAR *joined;
+
+        while (n0 && !((WCHAR *)values[0])[n0 - 1]) --n0;
+        while (n1 && !((WCHAR *)values[1])[n1 - 1]) --n1;
+        joined = calloc(n0 + n1 + 3, sizeof(WCHAR));
+        if (n0) { memcpy(joined, values[0], n0 * sizeof(WCHAR)); pos = n0 + 1; }
+        if (n1) { memcpy(joined + pos, values[1], n1 * sizeof(WCHAR)); pos += n1 + 1; }
+        if (!pos) pos = 1;
+        out = (BYTE *)joined;
+        type = REG_MULTI_SZ;
+        total = (pos + 1) * sizeof(WCHAR);
+    }
+    else
+    {
+        i = values[0] ? 0 : 1;
+        out = values[i];
+        values[i] = NULL;
+        type = types[i];
+        total = sizes[i];
+    }
+
+    if (reg_type) *reg_type = type;
+    if (ansi)
