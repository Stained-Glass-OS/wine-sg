+/*
+ * Stained Glass OS: batch 2002.
+ *
+ * Machine connections, class enumeration, class registry properties, the
+ * selected device, destroying a driver list and ANSI device-node
+ * properties. Each was a stub that failed or pretended.
+ */
+
+struct machine
+{
+    struct list entry;
+};
+
+static struct list machines = LIST_INIT(machines);
+static CRITICAL_SECTION machines_cs;
+static CRITICAL_SECTION_DEBUG machines_cs_debug =
+{
+    0, 0, &machines_cs,
+    { &machines_cs_debug.ProcessLocksList, &machines_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": machines_cs") }
+};
+static CRITICAL_SECTION machines_cs = { &machines_cs_debug, -1, 0, 0, 0, 0 };
+
+/***********************************************************************
+ *      CM_Connect_MachineW (SETUPAPI.@)
+ *
+ * The local machine can be named ("\\NAME") or left empty; connecting to
+ * any other machine fails, as no remote PnP service is reachable.
+ */
+CONFIGRET WINAPI CM_Connect_MachineW(const WCHAR *name, HMACHINE *machine)
+{
+#ifdef SG_MUTANT_MACHINE
+    return CR_ACCESS_DENIED;
+#else
+    struct machine *m;
+
+    TRACE("%s, %p\n", debugstr_w(name), machine);
+
+    if (!machine) return CR_INVALID_POINTER;
+    *machine = NULL;
+
+    if (name && *name)
+    {
+        WCHAR local[MAX_COMPUTERNAME_LENGTH + 1];
+        DWORD size = ARRAY_SIZE(local);
+
+        if (name[0] != '\\' || name[1] != '\\' || !name[2]) return CR_INVALID_MACHINENAME;
+        if (!GetComputerNameW(local, &size) || wcsicmp(name + 2, local)) return CR_REMOTE_COMM_FAILURE;
+    }
+
+    if (!(m = calloc(1, sizeof(*m)))) return CR_OUT_OF_MEMORY;
+    EnterCriticalSection(&machines_cs);
+    list_add_tail(&machines, &m->entry);
+    LeaveCriticalSection(&machines_cs);
+    *machine = m;
+    return CR_SUCCESS;
+#endif
+}
+
+/***********************************************************************
+ *      CM_Connect_MachineA (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Connect_MachineA(const char *name, HMACHINE *machine)
+{
+    WCHAR *nameW = NULL;
+    CONFIGRET cr;
+
+    if (name && !(nameW = strdupAtoW(name))) return CR_OUT_OF_MEMORY;
+    cr = CM_Connect_MachineW(nameW, machine);
+    free(nameW);
+    return cr;
+}
+
+/***********************************************************************
+ *      CM_Disconnect_Machine (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Disconnect_Machine(HMACHINE handle)
+{
+    struct machine *m;
+
+    TRACE("%p\n", handle);
+
+    if (!handle) return CR_SUCCESS;
+    EnterCriticalSection(&machines_cs);
+    LIST_FOR_EACH_ENTRY(m, &machines, struct machine, entry)
+    {
+        if (m == handle)
+        {
+            list_remove(&m->entry);
+            LeaveCriticalSection(&machines_cs);
+            free(m);
+            return CR_SUCCESS;
+        }
+    }
+    LeaveCriticalSection(&machines_cs);
+    return CR_INVALID_MACHINENAME;
+}
+
+static BOOL parse_class_guid(const WCHAR *str, GUID *guid)
+{
+    WCHAR buf[37];
+
+    if (wcslen(str) != 38 || str[0] != '{' || str[37] != '}') return FALSE;
+    memcpy(buf, str + 1, 36 * sizeof(WCHAR));
+    buf[36] = 0;
+    return !UuidFromStringW(buf, guid);
+}
+
+/***********************************************************************
+ *      CM_Enumerate_Classes_Ex (SETUPAPI.@)
+ *
+ * The index-th class GUID under Control\Class (setup classes) or
+ * DeviceClasses (interface classes); keys that are not GUIDs are skipped.
+ */
+CONFIGRET WINAPI CM_Enumerate_Classes_Ex(ULONG index, GUID *class, ULONG flags, HMACHINE machine)
+{
+#ifdef SG_MUTANT_ENUMCLASSES
+    return CR_NO_SUCH_VALUE;
+#else
+    WCHAR name[64];
+    ULONG seen = 0;
+    HKEY root;
+    DWORD i;
+    LONG l;
+
+    TRACE("%lu, %p, %#lx, %p\n", index, class, flags, machine);
+
+    if (!class) return CR_INVALID_POINTER;
+    if (flags & ~CM_ENUMERATE_CLASSES_BITS) return CR_INVALID_FLAG;
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, (flags & CM_ENUMERATE_CLASSES_INTERFACE) ? DeviceClasses : ControlClass,
+            0, KEY_ENUMERATE_SUB_KEYS, &root))
+        return CR_REGISTRY_ERROR;
+
+    for (i = 0; ; ++i)
+    {
+        DWORD len = ARRAY_SIZE(name);
+        GUID guid;
+
+        l = RegEnumKeyExW(root, i, name, &len, NULL, NULL, NULL, NULL);
+        if (l == ERROR_NO_MORE_ITEMS) break;
+        if (l) continue;
+        if (!parse_class_guid(name, &guid)) continue;
+        if (seen++ == index)
+        {
+            *class = guid;
+            RegCloseKey(root);
+            return CR_SUCCESS;
+        }
+    }
+    RegCloseKey(root);
+    return CR_NO_SUCH_VALUE;
+#endif
+}
+
+/***********************************************************************
+ *      CM_Enumerate_Classes (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Enumerate_Classes(ULONG index, GUID *class, ULONG flags)
+{
+    return CM_Enumerate_Classes_Ex(index, class, flags, NULL);
+}
+
+static BOOL reg_type_is_string(DWORD type)
+{
+    return type == REG_SZ || type == REG_MULTI_SZ || type == REG_EXPAND_SZ;
+}
+
+/* Copies registry data into an ANSI caller's buffer. *size is the buffer's
+ * size on entry and the bytes needed (or written) on return. */
+static LONG copy_reg_data_to_ansi(DWORD type, const BYTE *data, DWORD data_size, BYTE *buf, DWORD *size)
+{
+    DWORD needed;
+
+    if (!reg_type_is_string(type))
+        needed = data_size;
+    else
+        needed = WideCharToMultiByte(CP_ACP, 0, (const WCHAR *)data, data_size / sizeof(WCHAR), NULL, 0, NULL, NULL);
+
+    if (!buf || *size < needed)
+    {
+        *size = needed;
+        return ERROR_MORE_DATA;
+    }
+    if (!reg_type_is_string(type))
+        memcpy(buf, data, data_size);
+    else
+        WideCharToMultiByte(CP_ACP, 0, (const WCHAR *)data, data_size / sizeof(WCHAR), (char *)buf, needed, NULL, NULL);
+    *size = needed;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *      CM_Get_DevNode_Registry_Property_ExA (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_DevNode_Registry_Property_ExA(DEVINST devnode, ULONG prop, ULONG *type,
+        void *buffer, ULONG *len, ULONG flags, HMACHINE machine)
+{
+#ifdef SG_MUTANT_DEVPROPA
+    return CR_FAILURE;
+#else
+    ULONG wtype, wlen = 0;
+    CONFIGRET cr;
+    BYTE *data;
+    LONG l;
+
+    TRACE("%lu, %lu, %p, %p, %p, %#lx, %p\n", devnode, prop, type, buffer, len, flags, machine);
+
+    if (!len) return CR_INVALID_POINTER;
+    if ((cr = CM_Get_DevNode_Registry_Property_ExW(devnode, prop, &wtype, NULL, &wlen, flags, machine))
+            != CR_BUFFER_SMALL)
+        return cr;
+    if (type) *type = wtype;
+
+    if (!(data = malloc(wlen + sizeof(WCHAR)))) return CR_OUT_OF_MEMORY;
+    if ((cr = CM_Get_DevNode_Registry_Property_ExW(devnode, prop, &wtype, data, &wlen, flags, machine)))
+    {
+        free(data);
+        return cr;
+    }
+    l = copy_reg_data_to_ansi(wtype, data, wlen, buffer, len);
+    free(data);
+    return l ? CR_BUFFER_SMALL : CR_SUCCESS;
+#endif
+}
+
+static const struct class_property
+{
+    DWORD prop;  /* SPCRP_*, which share the SPDRP_* numbers */
+    const WCHAR *name;
+    DWORD type;
+} class_properties[] =
+{
+    { SPDRP_UPPERFILTERS,    L"UpperFilters",          REG_MULTI_SZ },
+    { SPDRP_LOWERFILTERS,    L"LowerFilters",          REG_MULTI_SZ },
+    { SPDRP_SECURITY,        L"Security",              REG_BINARY },
+    { SPDRP_SECURITY_SDS,    L"Security",              REG_BINARY },
+    { SPDRP_DEVTYPE,         L"DeviceType",            REG_DWORD },
+    { SPDRP_EXCLUSIVE,       L"Exclusive",             REG_DWORD },
+    { SPDRP_CHARACTERISTICS, L"DeviceCharacteristics", REG_DWORD },
+};
+
+static const struct class_property *find_class_property(DWORD prop)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(class_properties); ++i)
+        if (class_properties[i].prop == prop) return &class_properties[i];
+    return NULL;
+}
+
+/* Reads a property of a setup class. Returns a Win32 error: ERROR_MORE_DATA
+ * (with *size set) if the buffer is small, ERROR_INVALID_REG_PROPERTY,
+ * ERROR_INVALID_CLASS if there is no such class, ERROR_FILE_NOT_FOUND if the
+ * class lacks the value. */
+static LONG get_class_property(const GUID *class, DWORD prop, BOOL ansi, DWORD *type, BYTE *buffer, DWORD *size)
+{
+    const struct class_property *entry = find_class_property(prop);
+    DWORD value_type, data_size = 0;
+    BYTE *data;
+    HKEY key;
+    LONG l;
+
+    /* the SDDL form can only be written */
+    if (!entry || prop == SPDRP_SECURITY_SDS) return ERROR_INVALID_REG_PROPERTY;
+
+    key = SetupDiOpenClassRegKeyExW(class, KEY_READ, DIOCR_INSTALLER, NULL, NULL);
+    if (key == INVALID_HANDLE_VALUE)
+    {
+        l = GetLastError();
+        return l == ERROR_FILE_NOT_FOUND ? ERROR_INVALID_CLASS : l;
+    }
+
+    if ((l = RegQueryValueExW(key, entry->name, NULL, &value_type, NULL, &data_size)))
+    {
+        RegCloseKey(key);
+        return l;
+    }
+    if (!(data = malloc(data_size + sizeof(WCHAR))))
+    {
+        RegCloseKey(key);
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    l = RegQueryValueExW(key, entry->name, NULL, &value_type, data, &data_size);
+    RegCloseKey(key);
+    if (!l)
+    {
+        if (type) *type = value_type;
+        if (ansi)
+            l = copy_reg_data_to_ansi(value_type, data, data_size, buffer, size);
+        else if (!buffer || *size < data_size)
+        {
+            *size = data_size;
+            l = ERROR_MORE_DATA;
+        }
+        else
+        {
+            memcpy(buffer, data, data_size);
+            *size = data_size;
+        }
+    }
+    free(data);
+    return l;
+}
+
+/* Writes a property of a setup class; a NULL buffer deletes it. */
+static LONG set_class_property(const GUID *class, DWORD prop, BOOL ansi, const BYTE *buffer, DWORD size)
+{
+    const struct class_property *entry = find_class_property(prop);
+    void *converted = NULL;
+    HKEY key;
+    LONG l;
+
+    if (!entry) return ERROR_INVALID_REG_PROPERTY;
+
+    if (buffer)
+    {
+        if (prop == SPDRP_SECURITY_SDS)
+        {
+            WCHAR *sddl = ansi ? strdupAtoW((const char *)buffer) : NULL;
+            PSECURITY_DESCRIPTOR sd;
+            ULONG sd_size;
+            BOOL ok;
+
+            ok = ConvertStringSecurityDescriptorToSecurityDescriptorW(ansi ? sddl : (const WCHAR *)buffer,
+                    SDDL_REVISION_1, &sd, &sd_size);
+            free(sddl);
+            if (!ok) return ERROR_INVALID_DATA;
+            converted = malloc(sd_size);
+            memcpy(converted, sd, sd_size);
+            LocalFree(sd);
+            buffer = converted;
+            size = sd_size;
+        }
+        else if (entry->type == REG_DWORD)
+        {
+            if (size != sizeof(DWORD)) return ERROR_INVALID_DATA;
+        }
+        else if (entry->type == REG_BINARY)
+        {
+            if (!size || !IsValidSecurityDescriptor((PSECURITY_DESCRIPTOR)buffer)) return ERROR_INVALID_DATA;
+        }
+        else if (ansi)
+        {
+            DWORD wchars = MultiByteToWideChar(CP_ACP, 0, (const char *)buffer, size, NULL, 0);
+
+            if (!(converted = malloc(wchars * sizeof(WCHAR)))) return ERROR_NOT_ENOUGH_MEMORY;
+            MultiByteToWideChar(CP_ACP, 0, (const char *)buffer, size, converted, wchars);
+            buffer = converted;
+            size = wchars * sizeof(WCHAR);
+        }
+    }
+
+    key = SetupDiOpenClassRegKeyExW(class, KEY_SET_VALUE, DIOCR_INSTALLER, NULL, NULL);
+    if (key == INVALID_HANDLE_VALUE)
+    {
+        l = GetLastError();
+        free(converted);
+        return l == ERROR_FILE_NOT_FOUND ? ERROR_INVALID_CLASS : l;
+    }
+
+    if (!buffer)
+    {
+        l = RegDeleteValueW(key, entry->name);
+        if (l == ERROR_FILE_NOT_FOUND) l = ERROR_SUCCESS;
+    }
+    else
+        l = RegSetValueExW(key, entry->name, 0, entry->type, buffer, size);
+    RegCloseKey(key);
+    free(converted);
+    return l;
+}
+
+static CONFIGRET class_error_to_cr(LONG l)
+{
+    switch (l)
+    {
+        case ERROR_SUCCESS:              return CR_SUCCESS;
+        case ERROR_MORE_DATA:            return CR_BUFFER_SMALL;
+        case ERROR_INVALID_REG_PROPERTY: return CR_INVALID_PROPERTY;
+        case ERROR_INVALID_CLASS:        return CR_NO_SUCH_REGISTRY_KEY;
+        case ERROR_FILE_NOT_FOUND:       return CR_NO_SUCH_VALUE;
+        case ERROR_INVALID_DATA:         return CR_INVALID_DATA;
+        case ERROR_ACCESS_DENIED:        return CR_ACCESS_DENIED;
+        case ERROR_NOT_ENOUGH_MEMORY:    return CR_OUT_OF_MEMORY;
+        default:                         return CR_REGISTRY_ERROR;
+    }
+}
+
+static CONFIGRET cm_get_class_property(GUID *class, ULONG prop, BOOL ansi, ULONG *type, void *buffer,
+        ULONG *len, ULONG flags)
+{
+#ifdef SG_MUTANT_CLASSPROP
+    return CR_FAILURE;
+#else
+    if (!class || !len) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    if (prop < CM_CRP_MIN || prop > CM_CRP_MAX) return CR_INVALID_PROPERTY;
+    return class_error_to_cr(get_class_property(class, prop - 1, ansi, type, buffer, len));
+#endif
+}
+
+static CONFIGRET cm_set_class_property(GUID *class, ULONG prop, BOOL ansi, const void *buffer, ULONG len,
+        ULONG flags)
+{
+    if (!class) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    if (!buffer && len) return CR_INVALID_POINTER;
+    if (prop < CM_CRP_MIN || prop > CM_CRP_MAX) return CR_INVALID_PROPERTY;
+    return class_error_to_cr(set_class_property(class, prop - 1, ansi, buffer, len));
+}
+
+/***********************************************************************
+ *      CM_Get_Class_Registry_PropertyW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Class_Registry_PropertyW(GUID *class, ULONG prop, ULONG *type, void *buffer,
+        ULONG *len, ULONG flags, HMACHINE machine)
+{
+    TRACE("%s, %lu, %p, %p, %p, %#lx, %p\n", debugstr_guid(class), prop, type, buffer, len, flags, machine);
+    return cm_get_class_property(class, prop, FALSE, type, buffer, len, flags);
+}
+
+/***********************************************************************
+ *      CM_Get_Class_Registry_PropertyA (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Class_Registry_PropertyA(GUID *class, ULONG prop, ULONG *type, void *buffer,
+        ULONG *len, ULONG flags, HMACHINE machine)
+{
+    TRACE("%s, %lu, %p, %p, %p, %#lx, %p\n", debugstr_guid(class), prop, type, buffer, len, flags, machine);
+    return cm_get_class_property(class, prop, TRUE, type, buffer, len, flags);
+}
+
+/***********************************************************************
+ *      CM_Set_Class_Registry_PropertyW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Set_Class_Registry_PropertyW(GUID *class, ULONG prop, const void *buffer, ULONG len,
+        ULONG flags, HMACHINE machine)
+{
+    TRACE("%s, %lu, %p, %lu, %#lx, %p\n", debugstr_guid(class), prop, buffer, len, flags, machine);
+    return cm_set_class_property(class, prop, FALSE, buffer, len, flags);
+}
+
+/***********************************************************************
+ *      CM_Set_Class_Registry_PropertyA (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Set_Class_Registry_PropertyA(GUID *class, ULONG prop, const void *buffer, ULONG len,
+        ULONG flags, HMACHINE machine)
+{
+    TRACE("%s, %lu, %p, %lu, %#lx, %p\n", debugstr_guid(class), prop, buffer, len, flags, machine);
+    return cm_set_class_property(class, prop, TRUE, buffer, len, flags);
+}
+
+static BOOL setupdi_get_class_property(const GUID *class, DWORD prop, BOOL ansi, DWORD *type, BYTE *buffer,
+        DWORD size, DWORD *required, BOOL remote, void *reserved)
+{
+    DWORD out = size;
+    LONG l;
+
+    if (!class || reserved)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (remote)
+    {
+        SetLastError(ERROR_INVALID_MACHINENAME);
+        return FALSE;
+    }
+    if (size && !buffer)
+    {
+        SetLastError(ERROR_INVALID_DATA);
+        return FALSE;
+    }
+
+    l = get_class_property(class, prop, ansi, type, buffer, &out);
+    if (l == ERROR_MORE_DATA)
+    {
+        if (required) *required = out;
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+    if (l == ERROR_FILE_NOT_FOUND) l = ERROR_INVALID_DATA;
+    if (l)
+    {
+        SetLastError(l);
+        return FALSE;
+    }
+    if (required) *required = out;
+    return TRUE;
+}
+
+/***********************************************************************
+ *      SetupDiGetClassRegistryPropertyW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiGetClassRegistryPropertyW(const GUID *class, DWORD prop, DWORD *type, BYTE *buffer, DWORD size,
+        DWORD *required, const WCHAR *machine, void *reserved)
+{
+    TRACE("%s, %lu, %p, %p, %lu, %p, %s, %p\n", debugstr_guid(class), prop, type, buffer, size, required,
+            debugstr_w(machine), reserved);
+    return setupdi_get_class_property(class, prop, FALSE, type, buffer, size, required,
+            machine && *machine, reserved);
+}
+
+/***********************************************************************
+ *      SetupDiGetClassRegistryPropertyA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiGetClassRegistryPropertyA(const GUID *class, DWORD prop, DWORD *type, BYTE *buffer, DWORD size,
+        DWORD *required, const char *machine, void *reserved)
+{
+    TRACE("%s, %lu, %p, %p, %lu, %p, %s, %p\n", debugstr_guid(class), prop, type, buffer, size, required,
+            debugstr_a(machine), reserved);
+    return setupdi_get_class_property(class, prop, TRUE, type, buffer, size, required,
+            machine && *machine, reserved);
+}
+
+static BOOL setupdi_set_class_property(const GUID *class, DWORD prop, BOOL ansi, const BYTE *buffer, DWORD size,
+        BOOL remote, void *reserved)
+{
+    LONG l;
+
+    if (!class || reserved || (!buffer && size))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (remote)
+    {
+        SetLastError(ERROR_INVALID_MACHINENAME);
+        return FALSE;
+    }
+    if ((l = set_class_property(class, prop, ansi, buffer, size)))
+    {
+        SetLastError(l);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *      SetupDiSetClassRegistryPropertyW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiSetClassRegistryPropertyW(const GUID *class, DWORD prop, const BYTE *buffer, DWORD size,
+        const WCHAR *machine, void *reserved)
+{
+    TRACE("%s, %lu, %p, %lu, %s, %p\n", debugstr_guid(class), prop, buffer, size, debugstr_w(machine), reserved);
+    return setupdi_set_class_property(class, prop, FALSE, buffer, size, machine && *machine, reserved);
+}
+
+/***********************************************************************
+ *      SetupDiSetClassRegistryPropertyA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiSetClassRegistryPropertyA(const GUID *class, DWORD prop, const BYTE *buffer, DWORD size,
+        const char *machine, void *reserved)
+{
+    TRACE("%s, %lu, %p, %lu, %s, %p\n", debugstr_guid(class), prop, buffer, size, debugstr_a(machine), reserved);
+    return setupdi_set_class_property(class, prop, TRUE, buffer, size, machine && *machine, reserved);
+}
+
+/***********************************************************************
+ *      SetupDiSetSelectedDevice (SETUPAPI.@)
+ *
+ * NULL device data clears the selection.
+ */
+BOOL WINAPI SetupDiSetSelectedDevice(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data)
+{
+    struct DeviceInfoSet *set;
+    struct device *device = NULL;
+
+    TRACE("devinfo %p, device_data %p.\n", devinfo, device_data);
+
+    if (!(set = get_device_set(devinfo)))
+        return FALSE;
+    if (device_data && !(device = get_device(devinfo, device_data)))
+        return FALSE;
+#ifndef SG_MUTANT_SELDEV
+    set->selected_device = device;
+#endif
+    return TRUE;
+}
+
+/***********************************************************************
+ *      SetupDiGetSelectedDevice (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiGetSelectedDevice(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data)
+{
+    struct DeviceInfoSet *set;
+
+    TRACE("devinfo %p, device_data %p.\n", devinfo, device_data);
+
+    if (!(set = get_device_set(devinfo)))
+        return FALSE;
+    if (!device_data || device_data->cbSize != sizeof(*device_data))
+    {
+        SetLastError(ERROR_INVALID_USER_BUFFER);
+        return FALSE;
+    }
+    if (!set->selected_device || set->selected_device->removed)
+    {
+        SetLastError(ERROR_NO_DEVICE_SELECTED);
+        return FALSE;
+    }
+    copy_device_data(device_data, set->selected_device);
+    return TRUE;
+}
+
+/***********************************************************************
+ *      SetupDiDestroyDriverInfoList (SETUPAPI.@)
+ *
+ * Only a device's compatible-driver list is ever built, so destroying a
+ * class list has nothing to free and is not an error.
+ */
+BOOL WINAPI SetupDiDestroyDriverInfoList(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data, DWORD type)
+{
+    struct device *device;
+
+    TRACE("devinfo %p, device_data %p, type %#lx.\n", devinfo, device_data, type);
+
+    if (!get_device_set(devinfo))
+        return FALSE;
+    if (type != SPDIT_CLASSDRIVER && type != SPDIT_COMPATDRIVER)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (type == SPDIT_CLASSDRIVER)
+        return TRUE;
+
+    if (!(device = get_device(devinfo, device_data)))
+        return FALSE;
+
+#ifndef SG_MUTANT_DRVDESTROY
+    free(device->drivers);
+    device->drivers = NULL;
+    device->driver_count = 0;
+    device->selected_driver = NULL;
+#endif
+    return TRUE;
+}
