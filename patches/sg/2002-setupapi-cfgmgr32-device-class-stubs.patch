+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+    else
+    {
+        if (!ansi && total) memcpy(buffer, out, total);
+        ret = TRUE;
+    }
+
+    free(values[0]);
+    free(values[1]);
+    free(out);
+    return ret;
