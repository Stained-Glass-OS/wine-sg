From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, wow64: SystemProcessorIdleInformation

NtQuerySystemInformation(SystemProcessorIdleInformation, 42) was not implemented
(a FIXME stub, STATUS_NOT_IMPLEMENTED); HWMonitor asks for it on every refresh. Each
processor's entry (48 bytes, SYSTEM_PROCESSOR_IDLE_INFORMATION, now in winternl.h)
has its idle time from /proc/stat, as SystemProcessorPerformanceInformation gives it,
and its C1/C2/C3 residency and entries from the kernel's cpuidle states (state 1 is
C1, state 2 C2, deeper ones count as C3; state 0 polls). A buffer short of 48 bytes
per processor gets STATUS_INFO_LENGTH_MISMATCH and the length needed. WoW64 passes
it through (same layout in 32-bit).

Gate: test/idleinfo-gate.sh; mutants SG_MUTANT_NO_IDLE_INFO, SG_MUTANT_NO_CSTATES.
---
--- a/include/winternl.h
+++ b/include/winternl.h
@@ -3032,6 +3032,19 @@
     ULONG Reserved2;
 } SYSTEM_PROCESSOR_PERFORMANCE_INFORMATION, *PSYSTEM_PROCESSOR_PERFORMANCE_INFORMATION;
 
+/* System Information Class 0x2a */
+
+typedef struct _SYSTEM_PROCESSOR_IDLE_INFORMATION {
+    ULONGLONG IdleTime;
+    ULONGLONG C1Time;
+    ULONGLONG C2Time;
+    ULONGLONG C3Time;
+    ULONG C1Transitions;
+    ULONG C2Transitions;
+    ULONG C3Transitions;
+    ULONG Padding;
+} SYSTEM_PROCESSOR_IDLE_INFORMATION, *PSYSTEM_PROCESSOR_IDLE_INFORMATION;
+
 /* System Information Class 0x0b */
 
 typedef struct _SYSTEM_DRIVER_INFORMATION {
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -2508,8 +2508,63 @@
 
     fclose( f );
 }
+
+/* Stained Glass OS: SystemProcessorIdleInformation. Each processor's idle time (100 ns, as
+ * SystemProcessorPerformanceInformation gives it) and its time and entries in the C1, C2 and deeper
+ * (C3) idle states, from the kernel's cpuidle states: state 1 is C1, state 2 C2, every deeper one
+ * counts as C3; state 0 (polling) is not an idle state. A processor without cpuidle has times 0. */
+static void get_cpu_idle_info( SYSTEM_PROCESSOR_IDLE_INFORMATION *info )
+{
+    unsigned int index, host_index, count, state;
+    char line[256], name[32], path[96];
+    unsigned long long idle, value;
+    FILE *f;
+
+    memset( info, 0, peb->NumberOfProcessors * sizeof(*info) );
+    if (!(f = fopen( "/proc/stat", "r" ))) return;
+    fgets( line, sizeof(line), f );  /* the combined line */
+    index = 0;
+    while (fgets( line, sizeof(line), f ) && index < peb->NumberOfProcessors)
+    {
+        count = sscanf( line, "%31s %*u %*u %*u %llu", name, &idle );
+        if (count < 2 || strncmp( name, "cpu", 3 )) break;
+        host_index = atoi( name + 3 );
+        if (system_cpu_mask && !(system_cpu_mask & ((ULONG_PTR)1 << host_index))) continue;
+        info[index].IdleTime = idle * 10000000 / sysconf( _SC_CLK_TCK );
+#ifndef SG_MUTANT_NO_CSTATES
+        for (state = 1; state < 16; state++)
+        {
+            ULONGLONG time = 0;
+            ULONG usage = 0;
+            FILE *g;
+
+            snprintf( path, sizeof(path), "/sys/devices/system/cpu/cpu%u/cpuidle/state%u/time", host_index, state );
+            if (!(g = fopen( path, "r" ))) break;
+            if (fscanf( g, "%llu", &value ) == 1) time = value * 10;  /* microseconds */
+            fclose( g );
+            snprintf( path, sizeof(path), "/sys/devices/system/cpu/cpu%u/cpuidle/state%u/usage", host_index, state );
+            if ((g = fopen( path, "r" )))
+            {
+                if (fscanf( g, "%llu", &value ) == 1) usage = value;
+                fclose( g );
+            }
+            if (state == 1) { info[index].C1Time += time; info[index].C1Transitions += usage; }
+            else if (state == 2) { info[index].C2Time += time; info[index].C2Transitions += usage; }
+            else { info[index].C3Time += time; info[index].C3Transitions += usage; }
+        }
+#endif
+        ++index;
+    }
+    fclose( f );
+}
+
 #else
 
+static void get_cpu_idle_info( SYSTEM_PROCESSOR_IDLE_INFORMATION *info )
+{
+    memset( info, 0, peb->NumberOfProcessors * sizeof(*info) );
+}
+
 static void get_cpu_idle_cycle_times( ULONG64 *times )
 {
     static int once;
@@ -3711,6 +3766,20 @@
         break;
     }
 
+#ifndef SG_MUTANT_NO_IDLE_INFO
+    case SystemProcessorIdleInformation:  /* 42 */
+    {
+        len = peb->NumberOfProcessors * sizeof(SYSTEM_PROCESSOR_IDLE_INFORMATION);
+        if (size >= len)
+        {
+            if (!info) ret = STATUS_ACCESS_VIOLATION;
+            else get_cpu_idle_info( info );
+        }
+        else ret = STATUS_INFO_LENGTH_MISMATCH;
+        break;
+    }
+#endif
+
     case SystemTimeAdjustmentInformation:  /* 28 */
     {
         SYSTEM_TIME_ADJUSTMENT_QUERY query = { 156250, 156250, TRUE };
--- a/dlls/wow64/system.c
+++ b/dlls/wow64/system.c
@@ -353,6 +353,7 @@
     case SystemRecommendedSharedDataAlignment:  /* ULONG */
     case SystemFirmwareTableInformation:  /* SYSTEM_FIRMWARE_TABLE_INFORMATION */
     case SystemProcessorIdleCycleTimeInformation:  /* ULONG64[] */
+    case SystemProcessorIdleInformation:  /* SYSTEM_PROCESSOR_IDLE_INFORMATION (wine-sg 9751) */
     case SystemDynamicTimeZoneInformation:  /* RTL_DYNAMIC_TIME_ZONE_INFORMATION */
     case SystemCodeIntegrityInformation:  /* SYSTEM_CODEINTEGRITY_INFORMATION */
 #ifndef SG_MUTANT_NO_LEAP_SECOND_INFO
