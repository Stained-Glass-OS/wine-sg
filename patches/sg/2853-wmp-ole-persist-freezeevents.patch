+/* The persisted state: the control's properties as a small binary record. */
+#define WMP_STREAM_MAGIC   0x53504d57 /* "WMPS" */
+#define WMP_STREAM_VERSION 1
+
+struct blob
+{
+    BYTE *data;
+    DWORD size, cap;
+    BOOL failed;
+};
+
+static void blob_put(struct blob *b, const void *data, DWORD size)
+{
+    if (b->failed)
+        return;
+    if (b->size + size > b->cap)
+    {
+        DWORD cap = max(b->cap * 2, b->size + size + 64);
+        BYTE *p = realloc(b->data, cap);
+        if (!p)
+        {
+            b->failed = TRUE;
+            return;
+        }
+        b->data = p;
+        b->cap = cap;
+    }
+    memcpy(b->data + b->size, data, size);
+    b->size += size;
+}
+
+static void blob_put_long(struct blob *b, LONG v)
+{
+    blob_put(b, &v, sizeof(v));
+}
+
+static void blob_put_bstr(struct blob *b, BSTR str)
+{
+    DWORD len = SysStringLen(str);
+
+    blob_put(b, &len, sizeof(len));
+    blob_put(b, str, len * sizeof(WCHAR));
+}
+
+static const WCHAR *const persisted_modes[] = {L"autoRewind", L"loop", L"showFrame", L"shuffle"};
+
+static HRESULT serialize_state(WindowsMediaPlayer *This, struct blob *b)
+{
+    IWMPSettings *settings = &This->IWMPSettings_iface;
+    IWMPPlayer4 *player = &This->IWMPPlayer4_iface;
+    DWORD header[3] = {WMP_STREAM_MAGIC, WMP_STREAM_VERSION, 0};
+    VARIANT_BOOL vb;
+    LONG l;
+    DOUBLE r;
+    BSTR str;
+    unsigned int i;
+
+    memset(b, 0, sizeof(*b));
+    blob_put(b, header, sizeof(header));
+
+    IWMPSettings_get_autoStart(settings, &vb);          blob_put_long(b, vb ? 1 : 0);
+    IWMPSettings_get_invokeURLs(settings, &vb);         blob_put_long(b, vb ? 1 : 0);
+    IWMPSettings_get_enableErrorDialogs(settings, &vb); blob_put_long(b, vb ? 1 : 0);
+    IWMPSettings_get_mute(settings, &vb);               blob_put_long(b, vb ? 1 : 0);
+    IWMPSettings_get_volume(settings, &l);              blob_put_long(b, l);
+    IWMPSettings_get_balance(settings, &l);             blob_put_long(b, l);
+    IWMPSettings_get_playCount(settings, &l);           blob_put_long(b, l);
+    IWMPSettings_get_rate(settings, &r);                blob_put(b, &r, sizeof(r));
+    for (i = 0; i < ARRAY_SIZE(persisted_modes); i++)
+    {
+        BSTR name = SysAllocString(persisted_modes[i]);
+        IWMPSettings_getMode(settings, name, &vb);
+        SysFreeString(name);
+        blob_put_long(b, vb ? 1 : 0);
+    }
+    IWMPPlayer4_get_enabled(player, &vb);               blob_put_long(b, vb ? 1 : 0);
+    IWMPPlayer4_get_enableContextMenu(player, &vb);     blob_put_long(b, vb ? 1 : 0);
+    IWMPPlayer4_get_stretchToFit(player, &vb);          blob_put_long(b, vb ? 1 : 0);
+    IWMPPlayer4_get_windowlessVideo(player, &vb);       blob_put_long(b, vb ? 1 : 0);
+
+    str = NULL; IWMPPlayer4_get_uiMode(player, &str);   blob_put_bstr(b, str); SysFreeString(str);
+    str = NULL; IWMPSettings_get_baseURL(settings, &str);      blob_put_bstr(b, str); SysFreeString(str);
+    str = NULL; IWMPSettings_get_defaultFrame(settings, &str); blob_put_bstr(b, str); SysFreeString(str);
+#ifdef SG_MUTANT_WMP_PERSIST_NO_URL
+    str = NULL;
+#else
+    str = NULL; IWMPPlayer4_get_URL(player, &str);
+#endif
+    blob_put_bstr(b, str); SysFreeString(str);
+
+    if (b->failed)
+    {
+        free(b->data);
+        return E_OUTOFMEMORY;
+    }
+    ((DWORD *)b->data)[2] = b->size - sizeof(header);
+    return S_OK;
+}
+
+static void take_clean_state(WindowsMediaPlayer *This)
+{
+    struct blob b;
+
+    if (FAILED(serialize_state(This, &b)))
+        return;
+    free(This->clean_state);
+    This->clean_state = b.data;
+    This->clean_size = b.size;
+}
+
+struct reader
+{
+    const BYTE *p;
+    DWORD left;
+    BOOL bad;
+};
+
+static LONG read_long(struct reader *r)
+{
+    LONG v = 0;
+
+    if (r->left < sizeof(v)) { r->bad = TRUE; return 0; }
+    memcpy(&v, r->p, sizeof(v));
+    r->p += sizeof(v);
+    r->left -= sizeof(v);
+    return v;
+}
+
+static BSTR read_bstr(struct reader *r)
+{
+    DWORD len = read_long(r);
+    BSTR str;
+
+    if (r->bad || len > r->left / sizeof(WCHAR)) { r->bad = TRUE; return NULL; }
+    str = SysAllocStringLen((const WCHAR *)r->p, len);
+    r->p += len * sizeof(WCHAR);
+    r->left -= len * sizeof(WCHAR);
+    return str;
+}
+
+static HRESULT deserialize_state(WindowsMediaPlayer *This, const BYTE *data, DWORD size)
+{
+    IWMPSettings *settings = &This->IWMPSettings_iface;
+    IWMPPlayer4 *player = &This->IWMPPlayer4_iface;
+    struct reader r = {data, size, FALSE};
+    LONG auto_start, invoke_urls, error_dialogs, mute, volume, balance, play_count, modes[4], enabled, menu, stretch, windowless;
+    BSTR ui_mode = NULL, base_url = NULL, default_frame = NULL, url = NULL;
+    DOUBLE rate = 1.0;
+    HRESULT hr = S_OK, hr2;
+    unsigned int i;
+
+    auto_start = read_long(&r); invoke_urls = read_long(&r); error_dialogs = read_long(&r); mute = read_long(&r);
+    volume = read_long(&r); balance = read_long(&r); play_count = read_long(&r);
+    if (r.left >= sizeof(rate)) { memcpy(&rate, r.p, sizeof(rate)); r.p += sizeof(rate); r.left -= sizeof(rate); }
+    else r.bad = TRUE;
+    for (i = 0; i < 4; i++) modes[i] = read_long(&r);
+    enabled = read_long(&r); menu = read_long(&r); stretch = read_long(&r); windowless = read_long(&r);
+    ui_mode = read_bstr(&r); base_url = read_bstr(&r); default_frame = read_bstr(&r); url = read_bstr(&r);
+
+    if (r.bad)
+    {
+        SysFreeString(ui_mode); SysFreeString(base_url); SysFreeString(default_frame); SysFreeString(url);
+        return E_FAIL;
+    }
+
+#define APPLY(call) do { if (FAILED(hr2 = (call)) && SUCCEEDED(hr)) hr = hr2; } while (0)
+    APPLY(IWMPSettings_put_invokeURLs(settings, invoke_urls ? VARIANT_TRUE : VARIANT_FALSE));
+    APPLY(IWMPSettings_put_enableErrorDialogs(settings, error_dialogs ? VARIANT_TRUE : VARIANT_FALSE));
+    APPLY(IWMPSettings_put_mute(settings, mute ? VARIANT_TRUE : VARIANT_FALSE));
+    APPLY(IWMPSettings_put_volume(settings, volume));
+    APPLY(IWMPSettings_put_balance(settings, balance));
+    APPLY(IWMPSettings_put_playCount(settings, play_count));
+    APPLY(IWMPSettings_put_rate(settings, rate));
+    for (i = 0; i < 4; i++)
+    {
+        BSTR name = SysAllocString(persisted_modes[i]);
+        APPLY(IWMPSettings_setMode(settings, name, modes[i] ? VARIANT_TRUE : VARIANT_FALSE));
+        SysFreeString(name);
+    }
+    APPLY(IWMPPlayer4_put_enabled(player, enabled ? VARIANT_TRUE : VARIANT_FALSE));
+    APPLY(IWMPPlayer4_put_enableContextMenu(player, menu ? VARIANT_TRUE : VARIANT_FALSE));
+    APPLY(IWMPPlayer4_put_stretchToFit(player, stretch ? VARIANT_TRUE : VARIANT_FALSE));
+    APPLY(IWMPPlayer4_put_windowlessVideo(player, windowless ? VARIANT_TRUE : VARIANT_FALSE));
+    APPLY(IWMPPlayer4_put_uiMode(player, ui_mode));
+    APPLY(IWMPSettings_put_baseURL(settings, base_url));
+    APPLY(IWMPSettings_put_defaultFrame(settings, default_frame));
+    /* autoStart goes before the address, which starts playing when it is on */
+    APPLY(IWMPSettings_put_autoStart(settings, auto_start ? VARIANT_TRUE : VARIANT_FALSE));
+    if (url && *url)
+        APPLY(IWMPPlayer4_put_URL(player, url));
+#undef APPLY
+
+    SysFreeString(ui_mode); SysFreeString(base_url); SysFreeString(default_frame); SysFreeString(url);
+    return hr;
+}
+
 static HRESULT WINAPI PersistStreamInit_GetClassID(IPersistStreamInit *iface, CLSID *pClassID)
