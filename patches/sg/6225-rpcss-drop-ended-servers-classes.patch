From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcss: a server's class objects go when it ends

A local server that ended without revoking its class objects (killed, crashed, or exiting when idle without CoRevokeClassObject) left them registered in rpcss. Activation was handed the dead server's object, failed with RPC_S_SERVER_UNAVAILABLE (0x800706ba) and never started the server again: a signed-in OneDrive could not reach FileCoAuth's notification class once FileCoAuth had exited, and said it could not sync its folder. rpcss now keeps the registering process and drops its classes when the process has ended, so the class's LocalServer32 is started again.
---
diff --git a/programs/rpcss/rpcss_main.c b/programs/rpcss/rpcss_main.c
index 3a6e94b..872aecb 100644
--- a/programs/rpcss/rpcss_main.c
+++ b/programs/rpcss/rpcss_main.c
@@ -26,6 +26,8 @@
 #include "winbase.h"
 #include "winnt.h"
 #include "winsvc.h"
+#include "rpc.h"
+#include "rpcdcep.h"
 #include "irot.h"
 #include "epm.h"
 #include "irpcss.h"
@@ -46,6 +48,7 @@ struct registered_class
     unsigned int cookie;
     PMInterfacePointer object;
     unsigned int single_use : 1;
+    HANDLE process;     /* the registering process: its classes go when it does */
 };
 
 static CRITICAL_SECTION registered_classes_cs = { NULL, -1, 0, 0, 0, 0 };
@@ -70,6 +73,16 @@ HRESULT __cdecl irpcss_server_register(handle_t h, const GUID *clsid, unsigned i
     entry->object->ulCntData = object->ulCntData;
     memcpy(&entry->object->abData, object->abData, object->ulCntData);
     *cookie = entry->cookie = InterlockedIncrement(&next_cookie);
+#ifndef SG_MUTANT_RPCSS_KEEPS_DEAD_SERVERS
+    {
+        /* Stained Glass OS (wine-sg 6225): a server that ends without revoking its classes (a
+         * crash, a kill, an idle exit) must not leave them registered: activation would hand out
+         * its object and fail (RPC_S_SERVER_UNAVAILABLE) instead of starting the server again */
+        ULONG pid;
+        if (!I_RpcBindingInqLocalClientPID(NULL, &pid))
+            entry->process = OpenProcess(SYNCHRONIZE, FALSE, pid);
+    }
+#endif
 
     EnterCriticalSection(&registered_classes_cs);
     list_add_tail(&registered_classes, &entry->entry);
@@ -81,6 +94,7 @@ HRESULT __cdecl irpcss_server_register(handle_t h, const GUID *clsid, unsigned i
 static void scm_revoke_class(struct registered_class *_class)
 {
     list_remove(&_class->entry);
+    if (_class->process) CloseHandle(_class->process);
     free(_class->object);
     free(_class);
 }
@@ -108,16 +122,22 @@ HRESULT __cdecl irpcss_server_revoke(handle_t h, unsigned int cookie)
 HRESULT __cdecl irpcss_get_class_object(handle_t h, const GUID *clsid,
         PMInterfacePointer *object)
 {
-    struct registered_class *cur;
+    struct registered_class *cur, *next;
 
     *object = NULL;
 
     EnterCriticalSection(&registered_classes_cs);
 
-    LIST_FOR_EACH_ENTRY(cur, &registered_classes, struct registered_class, entry)
+    LIST_FOR_EACH_ENTRY_SAFE(cur, next, &registered_classes, struct registered_class, entry)
     {
         if (!memcmp(clsid, &cur->clsid, sizeof(*clsid)))
         {
+            if (cur->process && !WaitForSingleObject(cur->process, 0))
+            {
+                WINE_TRACE("%s: its server has ended\n", wine_dbgstr_guid(clsid));
+                scm_revoke_class(cur);
+                continue;
+            }
             *object = MIDL_user_allocate(FIELD_OFFSET(MInterfacePointer, abData[cur->object->ulCntData]));
             if (*object)
             {
