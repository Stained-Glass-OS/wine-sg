+        if (V_VT( old ) != VT_EMPTY && V_VT( old ) != VT_NULL && V_VT( old ) != VT_BSTR)
+            return MAKE_ADO_HRESULT( adErrInvalidArgument );
+        if (!(joined = SysAllocStringLen( NULL, n1 + n2 ))) return E_OUTOFMEMORY;
+        if (n1) memcpy( joined, V_BSTR( old ), n1 * sizeof(WCHAR) );
+        if (n2) memcpy( joined + n1, V_BSTR( &val ), n2 * sizeof(WCHAR) );
+#ifdef SG_MUTANT_APPEND_REPLACES
+        memcpy( joined, V_BSTR( &val ), n2 * sizeof(WCHAR) ), joined[n2] = 0;
+#endif
+        VariantClear( old );
+        V_VT( old ) = VT_BSTR;
+        V_BSTR( old ) = joined;
+        return S_OK;
+    }
+    if (V_VT( &val ) == (VT_ARRAY | VT_UI1))
+    {
+        SAFEARRAY *chunk = V_ARRAY( &val ), *joined;
+        LONG l2, u2, l1 = 0, u1 = -1, n1, n2;
+        void *src, *dst;
+        HRESULT hr;
+
+        if (V_VT( old ) != VT_EMPTY && V_VT( old ) != VT_NULL && V_VT( old ) != (VT_ARRAY | VT_UI1))
+            return MAKE_ADO_HRESULT( adErrInvalidArgument );
+        if (!chunk || FAILED(SafeArrayGetLBound( chunk, 1, &l2 )) || FAILED(SafeArrayGetUBound( chunk, 1, &u2 )))
+            return MAKE_ADO_HRESULT( adErrInvalidArgument );
+        n2 = u2 - l2 + 1;
+        if (V_VT( old ) == (VT_ARRAY | VT_UI1) && V_ARRAY( old ))
+            SafeArrayGetUBound( V_ARRAY( old ), 1, &u1 ), SafeArrayGetLBound( V_ARRAY( old ), 1, &l1 );
+        n1 = u1 - l1 + 1;
+        if (!(joined = SafeArrayCreateVector( VT_UI1, 0, n1 + n2 ))) return E_OUTOFMEMORY;
+        SafeArrayAccessData( joined, &dst );
+        if (n1)
+        {
+            SafeArrayAccessData( V_ARRAY( old ), &src );
+            memcpy( dst, src, n1 );
+            SafeArrayUnaccessData( V_ARRAY( old ) );
+        }
+        if (SUCCEEDED(hr = SafeArrayAccessData( chunk, &src )))
+        {
+            memcpy( (BYTE *)dst + n1, src, n2 );
+            SafeArrayUnaccessData( chunk );
+        }
+        SafeArrayUnaccessData( joined );
+        if (FAILED(hr)) { SafeArrayDestroy( joined ); return hr; }
+        VariantClear( old );
+        V_VT( old ) = VT_ARRAY | VT_UI1;
+        V_ARRAY( old ) = joined;
+        return S_OK;
+    }
+    return MAKE_ADO_HRESULT( adErrInvalidArgument );
 }
 
