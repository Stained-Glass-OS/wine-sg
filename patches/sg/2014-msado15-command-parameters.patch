+/* an enumerator over a snapshot of the parameters */
+struct param_enum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    IDispatch **items;
+    ULONG count, pos;
+};
+
+static inline struct param_enum *impl_from_IEnumVARIANT( IEnumVARIANT *iface )
+{
+    return CONTAINING_RECORD( iface, struct param_enum, IEnumVARIANT_iface );
+}
+
+static HRESULT WINAPI param_enum_QueryInterface( IEnumVARIANT *iface, REFIID riid, void **obj )
+{
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IEnumVARIANT ))
+    {
+        *obj = iface;
+        IEnumVARIANT_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI param_enum_AddRef( IEnumVARIANT *iface )
+{
+    return InterlockedIncrement( &impl_from_IEnumVARIANT( iface )->ref );
+}
+
+static ULONG WINAPI param_enum_Release( IEnumVARIANT *iface )
+{
+    struct param_enum *impl = impl_from_IEnumVARIANT( iface );
+    LONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        ULONG i;
+        for (i = 0; i < impl->count; i++) IDispatch_Release( impl->items[i] );
+        free( impl->items );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI param_enum_Next( IEnumVARIANT *iface, ULONG count, VARIANT *vars, ULONG *fetched )
+{
+    struct param_enum *impl = impl_from_IEnumVARIANT( iface );
+    ULONG n = 0;
+
+    if (!vars || (!fetched && count != 1)) return E_POINTER;
+    while (n < count && impl->pos < impl->count)
+    {
+        V_VT( &vars[n] ) = VT_DISPATCH;
+        V_DISPATCH( &vars[n] ) = impl->items[impl->pos++];
+        IDispatch_AddRef( V_DISPATCH( &vars[n] ) );
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI param_enum_Skip( IEnumVARIANT *iface, ULONG count )
+{
+    struct param_enum *impl = impl_from_IEnumVARIANT( iface );
+    ULONG left = impl->count - impl->pos;
+
+    if (count > left) { impl->pos = impl->count; return S_FALSE; }
+    impl->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI param_enum_Reset( IEnumVARIANT *iface )
+{
+    impl_from_IEnumVARIANT( iface )->pos = 0;
+    return S_OK;
+}
+
+static HRESULT param_enum_create( struct command *command, IEnumVARIANT **out );
+
+static HRESULT WINAPI param_enum_Clone( IEnumVARIANT *iface, IEnumVARIANT **out )
+{
+    struct param_enum *impl = impl_from_IEnumVARIANT( iface ), *copy;
+    ULONG i;
+
+    if (!out) return E_POINTER;
+    if (!(copy = calloc( 1, sizeof(*copy) ))) return E_OUTOFMEMORY;
+    copy->IEnumVARIANT_iface = impl->IEnumVARIANT_iface;
+    copy->ref = 1;
+    copy->count = impl->count;
+    copy->pos = impl->pos;
+    if (impl->count && !(copy->items = malloc( impl->count * sizeof(*copy->items) )))
+    {
+        free( copy );
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < impl->count; i++)
+    {
+        copy->items[i] = impl->items[i];
+        IDispatch_AddRef( copy->items[i] );
+    }
+    *out = &copy->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl param_enum_vtbl =
+{
+    param_enum_QueryInterface,
+    param_enum_AddRef,
+    param_enum_Release,
+    param_enum_Next,
+    param_enum_Skip,
+    param_enum_Reset,
+    param_enum_Clone
+};
+
+static HRESULT param_enum_create( struct command *command, IEnumVARIANT **out )
+{
+    struct param_enum *impl;
+    struct param_item *item;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IEnumVARIANT_iface.lpVtbl = &param_enum_vtbl;
+    impl->ref = 1;
+    impl->count = list_count( &command->parameters );
+    if (impl->count && !(impl->items = malloc( impl->count * sizeof(*impl->items) )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    impl->count = 0;
+#ifndef SG_MUTANT_ENUM_EMPTY
+    LIST_FOR_EACH_ENTRY( item, &command->parameters, struct param_item, entry )
+    {
+        impl->items[impl->count] = item->param;
+        IDispatch_AddRef( item->param );
+        impl->count++;
+    }
+#endif
+    *out = &impl->IEnumVARIANT_iface;
+    return S_OK;
+}
+
