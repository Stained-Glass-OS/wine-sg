From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shlwapi: in-memory property bag and SHPropertyBag helpers (2040)

shlwapi: SHCreatePropertyBagOnMemory (an in-memory IPropertyBag, writable
only when created for writing; an empty write removes a value) and the typed
property bag helpers SHPropertyBag_ReadType / ReadStr / ReadBSTR / ReadInt /
ReadSHORT / ReadDWORD / ReadBOOL / ReadGUID / ReadPOINTL / ReadPOINTS /
ReadRECTL, the matching Write functions and SHPropertyBag_Delete, reading
and writing through any IPropertyBag. Points and rectangles are the values
name.x, name.y and name.left, .top, .right, .bottom. All were stubs.
---
--- a/dlls/shlwapi/ordinal.c
+++ b/dlls/shlwapi/ordinal.c
@@ -4736,6 +4736,576 @@
     return hr;
 }
 
+/* The property bag helpers: each reads or writes one typed value through IPropertyBag */
+
+static HRESULT propbag_read(IPropertyBag *ppb, const WCHAR *name, VARTYPE vt, VARIANT *var)
+{
+    HRESULT hr;
+
+    if (!ppb || !name) return E_INVALIDARG;
+    VariantInit(var);
+    V_VT(var) = vt;
+    if (FAILED(hr = IPropertyBag_Read(ppb, name, var, NULL))) return hr;
+    if (V_VT(var) != vt)
+    {
+        VariantClear(var);
+        return DISP_E_BADVARTYPE;
+    }
+    return S_OK;
+}
+
+static HRESULT propbag_write(IPropertyBag *ppb, const WCHAR *name, VARIANT *var)
+{
+    if (!ppb || !name) return E_INVALIDARG;
+    return IPropertyBag_Write(ppb, name, var);
+}
+
+/* name + "." + part, as the values of a point or rectangle are named */
+static HRESULT propbag_part_name(const WCHAR *name, const WCHAR *part, WCHAR **out)
+{
+    size_t len = lstrlenW(name) + 1 + lstrlenW(part) + 1;
+
+    if (!(*out = malloc(len * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+#ifdef SG_MUTANT_PROPBAG_POINT
+    swprintf(*out, len, L"%s", name);
+#else
+    swprintf(*out, len, L"%s.%s", name, part);
+#endif
+    return S_OK;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_ReadType (SHLWAPI.493)
+ */
+HRESULT WINAPI SHPropertyBag_ReadType(IPropertyBag *ppb, const WCHAR *name, VARIANT *var, VARTYPE vt)
+{
+    HRESULT hr;
+
+    TRACE("%p %s %p %d\n", ppb, debugstr_w(name), var, vt);
+
+    if (!ppb || !name || !var) return E_INVALIDARG;
+    VariantInit(var);
+    V_VT(var) = vt;
+    if (FAILED(hr = IPropertyBag_Read(ppb, name, var, NULL))) return hr;
+    if (V_VT(var) != vt)
+    {
+        VariantClear(var);
+        return DISP_E_BADVARTYPE;
+    }
+    return S_OK;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_ReadStr (SHLWAPI.494)
+ */
+HRESULT WINAPI SHPropertyBag_ReadStr(IPropertyBag *ppb, const WCHAR *name, WCHAR *value, int cch)
+{
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE("%p %s %p %d\n", ppb, debugstr_w(name), value, cch);
+
+    if (!value || cch <= 0) return E_INVALIDARG;
+    if (FAILED(hr = propbag_read(ppb, name, VT_BSTR, &var))) return hr;
+    /* a value that does not fit is cut and reported */
+    lstrcpynW(value, V_BSTR(&var) ? V_BSTR(&var) : L"", cch);
+    hr = V_BSTR(&var) && lstrlenW(V_BSTR(&var)) >= cch ? HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER) : S_OK;
+    VariantClear(&var);
+    return hr;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_ReadBSTR (SHLWAPI.520)
+ */
+HRESULT WINAPI SHPropertyBag_ReadBSTR(IPropertyBag *ppb, const WCHAR *name, BSTR *value)
+{
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), value);
+
+    if (!value) return E_INVALIDARG;
+    if (FAILED(hr = propbag_read(ppb, name, VT_BSTR, &var))) return hr;
+    *value = V_BSTR(&var);
+    return S_OK;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_ReadInt (SHLWAPI.529)
+ */
+HRESULT WINAPI SHPropertyBag_ReadInt(IPropertyBag *ppb, const WCHAR *name, INT *value)
+{
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), value);
+
+    if (!value) return E_INVALIDARG;
+    if (FAILED(hr = propbag_read(ppb, name, VT_I4, &var))) return hr;
+    *value = V_I4(&var);
+    return S_OK;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_ReadSHORT (SHLWAPI.527)
+ */
+HRESULT WINAPI SHPropertyBag_ReadSHORT(IPropertyBag *ppb, const WCHAR *name, SHORT *value)
+{
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), value);
+
+    if (!value) return E_INVALIDARG;
+    if (FAILED(hr = propbag_read(ppb, name, VT_I2, &var))) return hr;
+    *value = V_I2(&var);
+    return S_OK;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_ReadDWORD (SHLWAPI.507)
+ */
+HRESULT WINAPI SHPropertyBag_ReadDWORD(IPropertyBag *ppb, const WCHAR *name, DWORD *value)
+{
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), value);
+
+    if (!value) return E_INVALIDARG;
+    if (FAILED(hr = propbag_read(ppb, name, VT_UI4, &var))) return hr;
+    *value = V_UI4(&var);
+    return S_OK;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_ReadBOOL (SHLWAPI.534)
+ */
+HRESULT WINAPI SHPropertyBag_ReadBOOL(IPropertyBag *ppb, const WCHAR *name, BOOL *value)
+{
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), value);
+
+    if (!value) return E_INVALIDARG;
+    if (FAILED(hr = propbag_read(ppb, name, VT_BOOL, &var))) return hr;
+    *value = V_BOOL(&var) != VARIANT_FALSE;
+    return S_OK;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_ReadGUID (SHLWAPI.505)
+ */
+HRESULT WINAPI SHPropertyBag_ReadGUID(IPropertyBag *ppb, const WCHAR *name, GUID *guid)
+{
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), guid);
+
+    if (!guid) return E_INVALIDARG;
+    if (FAILED(hr = propbag_read(ppb, name, VT_BSTR, &var))) return hr;
+    hr = CLSIDFromString(V_BSTR(&var), guid);
+    VariantClear(&var);
+    return hr;
+}
+
+static HRESULT propbag_read_long_part(IPropertyBag *ppb, const WCHAR *name, const WCHAR *part, LONG *value)
+{
+    WCHAR *full;
+    HRESULT hr;
+
+    if (FAILED(hr = propbag_part_name(name, part, &full))) return hr;
+    hr = SHPropertyBag_ReadLONG(ppb, full, value);
+    free(full);
+    return hr;
+}
+
+static HRESULT propbag_write_long_part(IPropertyBag *ppb, const WCHAR *name, const WCHAR *part, LONG value);
+
+/*************************************************************************
+ *  SHPropertyBag_ReadPOINTL (SHLWAPI.521)
+ */
+HRESULT WINAPI SHPropertyBag_ReadPOINTL(IPropertyBag *ppb, const WCHAR *name, POINTL *pt)
+{
+    POINTL tmp;
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), pt);
+
+    if (!ppb || !name || !pt) return E_INVALIDARG;
+    if (FAILED(hr = propbag_read_long_part(ppb, name, L"x", &tmp.x))) return hr;
+    if (FAILED(hr = propbag_read_long_part(ppb, name, L"y", &tmp.y))) return hr;
+    *pt = tmp;
+    return S_OK;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_ReadPOINTS (SHLWAPI.525)
+ */
+HRESULT WINAPI SHPropertyBag_ReadPOINTS(IPropertyBag *ppb, const WCHAR *name, POINTS *pt)
+{
+    POINTL tmp;
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), pt);
+
+    if (!ppb || !name || !pt) return E_INVALIDARG;
+    if (FAILED(hr = propbag_read_long_part(ppb, name, L"x", &tmp.x))) return hr;
+    if (FAILED(hr = propbag_read_long_part(ppb, name, L"y", &tmp.y))) return hr;
+    pt->x = tmp.x;
+    pt->y = tmp.y;
+    return S_OK;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_ReadRECTL (SHLWAPI.523)
+ */
+HRESULT WINAPI SHPropertyBag_ReadRECTL(IPropertyBag *ppb, const WCHAR *name, RECTL *rect)
+{
+    RECTL tmp;
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), rect);
+
+    if (!ppb || !name || !rect) return E_INVALIDARG;
+    if (FAILED(hr = propbag_read_long_part(ppb, name, L"left", &tmp.left))) return hr;
+    if (FAILED(hr = propbag_read_long_part(ppb, name, L"top", &tmp.top))) return hr;
+    if (FAILED(hr = propbag_read_long_part(ppb, name, L"right", &tmp.right))) return hr;
+    if (FAILED(hr = propbag_read_long_part(ppb, name, L"bottom", &tmp.bottom))) return hr;
+    *rect = tmp;
+    return S_OK;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_WriteStr (SHLWAPI.495)
+ */
+HRESULT WINAPI SHPropertyBag_WriteStr(IPropertyBag *ppb, const WCHAR *name, const WCHAR *value)
+{
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE("%p %s %s\n", ppb, debugstr_w(name), debugstr_w(value));
+
+    if (!value) return E_INVALIDARG;
+    V_VT(&var) = VT_BSTR;
+    if (!(V_BSTR(&var) = SysAllocString(value))) return E_OUTOFMEMORY;
+    hr = propbag_write(ppb, name, &var);
+    VariantClear(&var);
+    return hr;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_WriteLONG (SHLWAPI.497)
+ */
+HRESULT WINAPI SHPropertyBag_WriteLONG(IPropertyBag *ppb, const WCHAR *name, LONG value)
+{
+    VARIANT var;
+
+    TRACE("%p %s %ld\n", ppb, debugstr_w(name), value);
+
+    V_VT(&var) = VT_I4;
+    V_I4(&var) = value;
+    return propbag_write(ppb, name, &var);
+}
+
+/*************************************************************************
+ *  SHPropertyBag_WriteInt (SHLWAPI.530)
+ */
+HRESULT WINAPI SHPropertyBag_WriteInt(IPropertyBag *ppb, const WCHAR *name, INT value)
+{
+    TRACE("%p %s %d\n", ppb, debugstr_w(name), value);
+    return SHPropertyBag_WriteLONG(ppb, name, value);
+}
+
+/*************************************************************************
+ *  SHPropertyBag_WriteSHORT (SHLWAPI.528)
+ */
+HRESULT WINAPI SHPropertyBag_WriteSHORT(IPropertyBag *ppb, const WCHAR *name, SHORT value)
+{
+    VARIANT var;
+
+    TRACE("%p %s %d\n", ppb, debugstr_w(name), value);
+
+    V_VT(&var) = VT_I2;
+    V_I2(&var) = value;
+    return propbag_write(ppb, name, &var);
+}
+
+/*************************************************************************
+ *  SHPropertyBag_WriteDWORD (SHLWAPI.508)
+ */
+HRESULT WINAPI SHPropertyBag_WriteDWORD(IPropertyBag *ppb, const WCHAR *name, DWORD value)
+{
+    VARIANT var;
+
+    TRACE("%p %s %lu\n", ppb, debugstr_w(name), value);
+
+    V_VT(&var) = VT_UI4;
+    V_UI4(&var) = value;
+    return propbag_write(ppb, name, &var);
+}
+
+/*************************************************************************
+ *  SHPropertyBag_WriteBOOL (SHLWAPI.499)
+ */
+HRESULT WINAPI SHPropertyBag_WriteBOOL(IPropertyBag *ppb, const WCHAR *name, BOOL value)
+{
+    VARIANT var;
+
+    TRACE("%p %s %d\n", ppb, debugstr_w(name), value);
+
+    V_VT(&var) = VT_BOOL;
+    V_BOOL(&var) = value ? VARIANT_TRUE : VARIANT_FALSE;
+    return propbag_write(ppb, name, &var);
+}
+
+/*************************************************************************
+ *  SHPropertyBag_WriteGUID (SHLWAPI.506)
+ */
+HRESULT WINAPI SHPropertyBag_WriteGUID(IPropertyBag *ppb, const WCHAR *name, const GUID *guid)
+{
+    WCHAR str[39];
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE("%p %s %s\n", ppb, debugstr_w(name), debugstr_guid(guid));
+
+    if (!guid) return E_INVALIDARG;
+    StringFromGUID2(guid, str, ARRAY_SIZE(str));
+    V_VT(&var) = VT_BSTR;
+    if (!(V_BSTR(&var) = SysAllocString(str))) return E_OUTOFMEMORY;
+    hr = propbag_write(ppb, name, &var);
+    VariantClear(&var);
+    return hr;
+}
+
+static HRESULT propbag_write_long_part(IPropertyBag *ppb, const WCHAR *name, const WCHAR *part, LONG value)
+{
+    WCHAR *full;
+    HRESULT hr;
+
+    if (FAILED(hr = propbag_part_name(name, part, &full))) return hr;
+    hr = SHPropertyBag_WriteLONG(ppb, full, value);
+    free(full);
+    return hr;
+}
+
+/*************************************************************************
+ *  SHPropertyBag_WritePOINTL (SHLWAPI.522)
+ */
+HRESULT WINAPI SHPropertyBag_WritePOINTL(IPropertyBag *ppb, const WCHAR *name, const POINTL *pt)
+{
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), pt);
+
+    if (!ppb || !name || !pt) return E_INVALIDARG;
+    if (FAILED(hr = propbag_write_long_part(ppb, name, L"x", pt->x))) return hr;
+    return propbag_write_long_part(ppb, name, L"y", pt->y);
+}
+
+/*************************************************************************
+ *  SHPropertyBag_WritePOINTS (SHLWAPI.526)
+ */
+HRESULT WINAPI SHPropertyBag_WritePOINTS(IPropertyBag *ppb, const WCHAR *name, const POINTS *pt)
+{
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), pt);
+
+    if (!ppb || !name || !pt) return E_INVALIDARG;
+    if (FAILED(hr = propbag_write_long_part(ppb, name, L"x", pt->x))) return hr;
+    return propbag_write_long_part(ppb, name, L"y", pt->y);
+}
+
+/*************************************************************************
+ *  SHPropertyBag_WriteRECTL (SHLWAPI.524)
+ */
+HRESULT WINAPI SHPropertyBag_WriteRECTL(IPropertyBag *ppb, const WCHAR *name, const RECTL *rect)
+{
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", ppb, debugstr_w(name), rect);
+
+    if (!ppb || !name || !rect) return E_INVALIDARG;
+    if (FAILED(hr = propbag_write_long_part(ppb, name, L"left", rect->left))) return hr;
+    if (FAILED(hr = propbag_write_long_part(ppb, name, L"top", rect->top))) return hr;
+    if (FAILED(hr = propbag_write_long_part(ppb, name, L"right", rect->right))) return hr;
+    return propbag_write_long_part(ppb, name, L"bottom", rect->bottom);
+}
+
+/*************************************************************************
+ *  SHPropertyBag_Delete (SHLWAPI.535)
+ *
+ * A property is deleted by writing an empty value to it.
+ */
+HRESULT WINAPI SHPropertyBag_Delete(IPropertyBag *ppb, const WCHAR *name)
+{
+    VARIANT var;
+
+    TRACE("%p %s\n", ppb, debugstr_w(name));
+
+#ifdef SG_MUTANT_PROPBAG_DELETE
+    return S_OK;
+#endif
+    VariantInit(&var);
+    return propbag_write(ppb, name, &var);
+}
+
+/* A property bag in memory */
+struct memory_bag
+{
+    IPropertyBag IPropertyBag_iface;
+    LONG ref;
+    BOOL writable;
+    struct memory_prop { WCHAR *name; VARIANT value; } *props;
+    unsigned int count;
+};
+
+static inline struct memory_bag *impl_from_memory_bag(IPropertyBag *iface)
+{
+    return CONTAINING_RECORD(iface, struct memory_bag, IPropertyBag_iface);
+}
+
+static HRESULT WINAPI memory_bag_QueryInterface(IPropertyBag *iface, REFIID iid, void **out)
+{
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IPropertyBag))
+    {
+        *out = iface;
+        IPropertyBag_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI memory_bag_AddRef(IPropertyBag *iface)
+{
+    return InterlockedIncrement(&impl_from_memory_bag(iface)->ref);
+}
+
+static ULONG WINAPI memory_bag_Release(IPropertyBag *iface)
+{
+    struct memory_bag *bag = impl_from_memory_bag(iface);
+    ULONG ref = InterlockedDecrement(&bag->ref);
+    unsigned int i;
+
+    if (!ref)
+    {
+        for (i = 0; i < bag->count; i++)
+        {
+            free(bag->props[i].name);
+            VariantClear(&bag->props[i].value);
+        }
+        free(bag->props);
+        free(bag);
+    }
+    return ref;
+}
+
+static struct memory_prop *memory_bag_find(struct memory_bag *bag, const WCHAR *name)
+{
+    unsigned int i;
+
+    for (i = 0; i < bag->count; i++)
+        if (!wcsicmp(bag->props[i].name, name)) return &bag->props[i];
+    return NULL;
+}
+
+static HRESULT WINAPI memory_bag_Read(IPropertyBag *iface, const WCHAR *name, VARIANT *var, IErrorLog *log)
+{
+    struct memory_bag *bag = impl_from_memory_bag(iface);
+    struct memory_prop *prop;
+    VARTYPE wanted;
+
+    TRACE("%p, %s, %p, %p\n", iface, debugstr_w(name), var, log);
+
+    if (!name || !var) return E_POINTER;
+    wanted = V_VT(var);
+    if (!(prop = memory_bag_find(bag, name))) return E_INVALIDARG;
+
+    VariantInit(var);
+    if (wanted == VT_EMPTY || wanted == V_VT(&prop->value)) return VariantCopy(var, &prop->value);
+    return VariantChangeType(var, &prop->value, 0, wanted);
+}
+
+static HRESULT WINAPI memory_bag_Write(IPropertyBag *iface, const WCHAR *name, VARIANT *var)
+{
+    struct memory_bag *bag = impl_from_memory_bag(iface);
+    struct memory_prop *prop;
+    unsigned int i;
+
+    TRACE("%p, %s, %p\n", iface, debugstr_w(name), var);
+
+    if (!name || !var) return E_POINTER;
+#ifndef SG_MUTANT_PROPBAG_READONLY
+    if (!bag->writable) return STG_E_ACCESSDENIED;
+#endif
+
+    prop = memory_bag_find(bag, name);
+    if (V_VT(var) == VT_EMPTY)
+    {
+        /* an empty value removes the property */
+        if (prop)
+        {
+            i = prop - bag->props;
+            free(prop->name);
+            VariantClear(&prop->value);
+            memmove(prop, prop + 1, (bag->count - i - 1) * sizeof(*prop));
+            bag->count--;
+        }
+        return S_OK;
+    }
+
+    if (!prop)
+    {
+        struct memory_prop *props = realloc(bag->props, (bag->count + 1) * sizeof(*props));
+        if (!props) return E_OUTOFMEMORY;
+        bag->props = props;
+        prop = &props[bag->count];
+        if (!(prop->name = wcsdup(name))) return E_OUTOFMEMORY;
+        VariantInit(&prop->value);
+        bag->count++;
+    }
+    VariantClear(&prop->value);
+    return VariantCopy(&prop->value, var);
+}
+
+static const IPropertyBagVtbl memory_bag_vtbl =
+{
+    memory_bag_QueryInterface,
+    memory_bag_AddRef,
+    memory_bag_Release,
+    memory_bag_Read,
+    memory_bag_Write,
+};
+
+/*************************************************************************
+ *  SHCreatePropertyBagOnMemory (SHLWAPI.477)
+ *
+ * A bag that keeps its values in memory; it can be written only when it was
+ * created for writing.
+ */
+HRESULT WINAPI SHCreatePropertyBagOnMemory(DWORD mode, REFIID riid, void **ret)
+{
+    struct memory_bag *bag;
+    HRESULT hr;
+
+    TRACE("%#lx, %s, %p\n", mode, debugstr_guid(riid), ret);
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    if (!(bag = calloc(1, sizeof(*bag)))) return E_OUTOFMEMORY;
+    bag->IPropertyBag_iface.lpVtbl = &memory_bag_vtbl;
+    bag->ref = 1;
+    bag->writable = (mode & (STGM_WRITE | STGM_READWRITE)) != 0;
+    hr = IPropertyBag_QueryInterface(&bag->IPropertyBag_iface, riid, ret);
+    IPropertyBag_Release(&bag->IPropertyBag_iface);
+    return hr;
+}
+
