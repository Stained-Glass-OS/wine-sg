 HRESULT WINAPI DwmExtendFrameIntoClientArea(HWND hwnd, const MARGINS* margins)
 {
-    FIXME("(%p, %p) stub\n", hwnd, margins);
+    BOOL glass;
 
+    TRACE("(%p, %p)\n", hwnd, margins);
+
+    if (!margins) return E_INVALIDARG;
+    if (!IsWindow(hwnd)) return E_HANDLE;
+
+    TRACE("margins %d,%d,%d,%d\n", margins->cxLeftWidth, margins->cxRightWidth,
+          margins->cyTopHeight, margins->cyBottomHeight);
+
+    /* Negative margins make the whole window a "sheet of glass": the program's
+     * own per-pixel alpha is what is shown.  The display driver picks this up
+     * when it next creates the window's surface. */
+    glass = margins->cxLeftWidth < 0 || margins->cxRightWidth < 0 ||
+            margins->cyTopHeight < 0 || margins->cyBottomHeight < 0;
+    if (!glass == !GetPropW(hwnd, L"__wine_dwm_glass")) return S_OK;
+    if (glass) SetPropW(hwnd, L"__wine_dwm_glass", (HANDLE)1);
+    else RemovePropW(hwnd, L"__wine_dwm_glass");
+
+    SetWindowPos(hwnd, 0, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE |
+                 SWP_NOOWNERZORDER | SWP_FRAMECHANGED);
+    RedrawWindow(hwnd, NULL, NULL, RDW_INVALIDATE | RDW_FRAME | RDW_ALLCHILDREN);
     return S_OK;
 }
 
