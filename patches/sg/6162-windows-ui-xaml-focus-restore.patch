From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: focus restored when the island's window is focused; TabFocusNavigation; Once remembers

When the host focuses an island's window -- as NanaZip does from its TakeFocusRequested handlers, and Mile.Xaml hosts on activation -- the island now gives the focus to the element it had last, else to its first stop (its last one on Shift+Tab), from the keyboard when Tab brought it there (with the focus rectangle), else programmatically. UIElement.TabFocusNavigation (Local, Cycle, Once; NanaZip sets it on its islands' content) is kept and drives Tab like a control's TabNavigation, also on panels. A Once container remembers the element last focused in it and gives that one when Tab comes back. Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/element.c b/dlls/windows.ui.xaml/element.c
index 72163c4..8df2311 100644
--- a/dlls/windows.ui.xaml/element.c
+++ b/dlls/windows.ui.xaml/element.c
@@ -35,7 +35,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(xaml);
 
 /* ---- properties ---- */
 
-static struct xaml_property *prop_context_flyout;
+static struct xaml_property *prop_context_flyout, *prop_tab_focus_navigation;
 static struct xaml_property *prop_visibility, *prop_opacity, *prop_is_hit_test_visible, *prop_allow_drop,
                             *prop_use_layout_rounding;
 static struct xaml_property *prop_width, *prop_height, *prop_min_width, *prop_min_height, *prop_max_width,
@@ -93,6 +93,8 @@ static BOOL WINAPI init_elements( INIT_ONCE *once, void *param, void **context )
     prop_allow_drop = xaml_property_register( ui, L"AllowDrop", L"Boolean", xbox_boolean( FALSE ), FALSE, NULL );
     prop_context_flyout = xaml_property_register( ui, L"ContextFlyout", L"Windows.UI.Xaml.Controls.Primitives.FlyoutBase", NULL,
                                                   FALSE, NULL );
+    prop_tab_focus_navigation = xaml_property_register( ui, L"TabFocusNavigation", L"Windows.UI.Xaml.Input.KeyboardNavigationMode",
+                                                        xbox_int32( 0 ), FALSE, NULL );
     prop_use_layout_rounding = xaml_property_register( ui, L"UseLayoutRounding", L"Boolean", xbox_boolean( TRUE ), FALSE, NULL );
 
     prop_width = xaml_property_register( fe, L"Width", L"Double", xbox_double( NAN ), FALSE, layout_changed );
@@ -670,7 +672,48 @@ static const void *uielement4_vtbl[] =
     [IUIElement4_ContextFlyout] = uielement4_get_ContextFlyout,
     [IUIElement4_SetContextFlyout] = uielement4_put_ContextFlyout,
 };
-static const void *uielement5_vtbl[] = { IUIElement5_STUBS };
+static HRESULT WINAPI uielement5_get_TabFocusNavigation( struct xiface *iface, INT32 *value )
+{
+    IInspectable *box = NULL;
+
+    if (!value) return E_POINTER;
+    dobj_get_value( &elem_from_iface( iface )->d, prop_tab_focus_navigation, &box );
+    *value = xunbox_enum( box, NULL, 0 );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+static HRESULT WINAPI uielement5_put_TabFocusNavigation( struct xiface *iface, INT32 value )
+{
+    IInspectable *box = xbox_int32( value );
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &elem_from_iface( iface )->d, prop_tab_focus_navigation, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static const void *uielement5_vtbl[] =
+{
+    IUIElement5_STUBS,
+    [IUIElement5_TabFocusNavigation] = uielement5_get_TabFocusNavigation,
+    [IUIElement5_SetTabFocusNavigation] = uielement5_put_TabFocusNavigation,
+};
+
+/* how Tab goes through an element's subtree: UIElement.TabFocusNavigation, else a control's
+ * TabNavigation (Local 0, Cycle 1, Once 2) */
+INT32 xaml_tab_navigation( struct uielem *elem )
+{
+    IInspectable *box = NULL;
+    INT32 mode;
+
+    xaml_elements_init();
+    dobj_get_value( &elem->d, prop_tab_focus_navigation, &box );
+    mode = xunbox_enum( box, NULL, 0 );
+    if (box) IInspectable_Release( box );
+    return mode;
+}
 static HRESULT WINAPI fe_add_PreviewKeyDown( struct xiface *iface, IUnknown *handler, INT64 *token );
 static HRESULT WINAPI fe_remove_PreviewKeyDown( struct xiface *iface, INT64 token );
 static HRESULT WINAPI fe_add_PreviewKeyUp( struct xiface *iface, IUnknown *handler, INT64 *token );
@@ -1234,6 +1277,8 @@ void uielem_cleanup( struct uielem *elem )
 
     if (elem->resources) IInspectable_Release( elem->resources );
     elem->resources = NULL;
+    if (elem->tab_last) IUnknown_Release( elem->tab_last->d.obj.outer );
+    elem->tab_last = NULL;
     LIST_FOR_EACH_ENTRY_SAFE( child, next, &elem->children, struct uielem, entry )
         uielem_remove_child( elem, child );
     handlers_clear( &elem->loaded );
diff --git a/dlls/windows.ui.xaml/focus.c b/dlls/windows.ui.xaml/focus.c
index e0436c6..6122fb8 100644
--- a/dlls/windows.ui.xaml/focus.c
+++ b/dlls/windows.ui.xaml/focus.c
@@ -258,6 +258,25 @@ void xaml_focus_element( struct uielem *elem, HWND hwnd )
     xaml_focus_element_state( elem, hwnd, hwnd ? 1 : 3 );
 }
 
+static INT32 control_int( struct uielem *elem, const WCHAR *name, INT32 def );
+
+/* the root and each Once container above a focused element remember it */
+static void remember_focus( struct uielem *elem )
+{
+    struct uielem *a;
+
+    for (a = elem->parent; a; a = a->parent)
+    {
+        INT32 mode = xaml_tab_navigation( a );
+        if (!mode) mode = control_int( a, L"TabNavigation", 0 );
+        if (a->parent && mode != 2) continue;
+        if (a->tab_last == elem) continue;
+        IUnknown_AddRef( elem->d.obj.outer );
+        if (a->tab_last) IUnknown_Release( a->tab_last->d.obj.outer );
+        a->tab_last = elem;
+    }
+}
+
 void xaml_focus_element_state( struct uielem *elem, HWND hwnd, INT32 state )
 {
     struct uielem *old = focus;
@@ -271,6 +290,7 @@ void xaml_focus_element_state( struct uielem *elem, HWND hwnd, INT32 state )
     return;
 #endif
     if (elem) IUnknown_AddRef( elem->d.obj.outer );
+    if (elem) remember_focus( elem );
     focus = elem;
     if (old)
     {
@@ -339,13 +359,17 @@ static void collect_tab( struct uielem *elem, struct tab_list *list )
     if (xaml_is_focus_target( elem ) && list->count < MAX_TAB) list->items[list->count++] = elem;
     start = list->count;
     collect_children( elem, list );
-    mode = control_int( elem, L"TabNavigation", 0 );
+    if (!(mode = xaml_tab_navigation( elem ))) mode = control_int( elem, L"TabNavigation", 0 );
 #ifdef SG_MUTANT_XAML_TAB_LOCAL_ONLY
     mode = 0;
 #endif
     if (mode == 2 && list->count > start + 1)   /* Once: one stop */
     {
         unsigned int i, keep = start;
+        /* the focused one inside, else the one focused last, else the first */
+#ifndef SG_MUTANT_XAML_ONCE_FORGETS
+        for (i = start; i < list->count; i++) if (list->items[i] == elem->tab_last) keep = i;
+#endif
         for (i = start; i < list->count; i++) if (list->items[i] == focus) keep = i;
         list->items[start] = list->items[keep];
         list->count = start + 1;
@@ -530,7 +554,22 @@ BOOL xaml_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspe
         if (focus && in_content( focus, content ) && xaml_is_text_box( focus )) xaml_text_box_focus( focus, FALSE );
         return FALSE;
     case WM_SETFOCUS:
-        if (focus && in_content( focus, content ) && xaml_is_text_box( focus )) xaml_text_box_focus( focus, TRUE );
+        if (focus && in_content( focus, content ))
+        {
+            if (xaml_is_text_box( focus )) xaml_text_box_focus( focus, TRUE );
+        }
+#ifndef SG_MUTANT_XAML_NO_FOCUS_RESTORE
+        else
+        {
+            /* the island's window takes the focus (the host's SetFocus): its last focused element
+             * again, else its first -- from the keyboard when Tab brought it */
+            struct uielem *root = uielem_from_inspectable( content ), *last = root ? root->tab_last : NULL;
+            INT32 state = GetKeyState( VK_TAB ) < 0 ? 2 : 3;
+            if (last && in_content( last, content ) && xaml_is_focus_target( last ) && last->arrange_valid)
+                xaml_focus_element_state( last, hwnd, state );
+            else if (root) xaml_focus_navigate( hwnd, content, state != 2 ? 0 : GetKeyState( VK_SHIFT ) < 0 ? 4 : 3 );
+        }
+#endif
         return FALSE;
     }
     return FALSE;
diff --git a/dlls/windows.ui.xaml/input.c b/dlls/windows.ui.xaml/input.c
index 38f4885..d6cc858 100644
--- a/dlls/windows.ui.xaml/input.c
+++ b/dlls/windows.ui.xaml/input.c
@@ -126,8 +126,8 @@ BOOL xaml_input_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IIns
             if (xaml_is_focus_target( elem )) break;
         if (elem)
         {
+            xaml_focus_element_state( elem, hwnd, 1 );   /* Pointer (before the window's focus: nothing to restore) */
             SetFocus( hwnd );
-            xaml_focus_element_state( elem, hwnd, 1 );   /* Pointer */
         }
     }
         button = button_at( content, lparam );
@@ -166,8 +166,8 @@ BOOL xaml_input_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IIns
             if (!flyout) continue;
             if (xaml_is_focus_target( elem ))
             {
-                SetFocus( hwnd );
                 xaml_focus_element( elem, hwnd );
+                SetFocus( hwnd );
             }
             xaml_flyout_show( flyout, elem, &pt );
             IInspectable_Release( flyout );
diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
index ea36fc2..0339e99 100644
--- a/dlls/windows.ui.xaml/private.h
+++ b/dlls/windows.ui.xaml/private.h
@@ -297,6 +297,7 @@ struct uielem
     struct handler_list key_down, key_up, got_focus, lost_focus, preview_key_down, preview_key_up;
     BOOL loading_raised, is_loaded;  /* Loading and Loaded raised: it is in a live tree */
     IInspectable *resources;        /* its Resources, when made */
+    struct uielem *tab_last;        /* the root's, a Once container's: its last focused element (a reference) */
     BOOL style_applied;             /* its implicit style looked for */
 };
 
@@ -351,6 +352,7 @@ BOOL xaml_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspe
 void xaml_focus_element( struct uielem *elem, HWND hwnd );
 void xaml_focus_element_state( struct uielem *elem, HWND hwnd, INT32 state );
 BOOL xaml_focus_navigate( HWND hwnd, IInspectable *content, INT32 reason );
+INT32 xaml_tab_navigation( struct uielem *elem );
 BOOL xaml_source_leave_focus( HWND island, BOOL back );
 extern IActivationFactory *xaml_source_focus_navigation_request_factory, *xaml_source_focus_navigation_result_factory;
 INT32 xaml_focus_state( struct uielem *elem );
