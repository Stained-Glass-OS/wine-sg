From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comctl32: toolbar separator width, style bits (2027)

Toolbar: a separator added with a width of 0 or less is given the default
width (8) in the button data TB_GETBUTTON returns; TB_GETSTYLE carries the
window's visible bit (CreateToolbarEx toolbars lacked it); setting
TBSTYLE_EX_VERTICAL also sets CCS_VERT. Three passing todo_wine marks
removed in the toolbar test.
---
--- a/dlls/comctl32/toolbar.c
+++ b/dlls/comctl32/toolbar.c
@@ -2081,6 +2081,11 @@
         ZeroMemory(btnPtr, sizeof(*btnPtr));
 
         btnPtr->iBitmap   = lpTbb[iButton].iBitmap;
+        /* a separator without a width gets the default one */
+#ifndef SG_MUTANT_TB_SEP_WIDTH
+        if ((lpTbb[iButton].fsStyle & BTNS_SEP) && btnPtr->iBitmap <= 0)
+            btnPtr->iBitmap = SEPARATOR_WIDTH;
+#endif
         btnPtr->idCommand = lpTbb[iButton].idCommand;
         btnPtr->fsState   = lpTbb[iButton].fsState;
         btnPtr->fsStyle   = lpTbb[iButton].fsStyle;
@@ -3849,7 +3854,12 @@
 static inline LRESULT
 TOOLBAR_GetStyle (const TOOLBAR_INFO *infoPtr)
 {
+    /* the visible bit is the window's own */
+#ifdef SG_MUTANT_TB_STYLE_VISIBLE
     return infoPtr->dwStyle;
+#else
+    return (infoPtr->dwStyle & ~WS_VISIBLE) | (GetWindowLongW(infoPtr->hwndSelf, GWL_STYLE) & WS_VISIBLE);
+#endif
 }
 
 
@@ -4800,6 +4810,12 @@
     else
 	infoPtr->dwExStyle = style;
 
+    /* the vertical extended style is also the vertical window style */
+#ifndef SG_MUTANT_TB_EX_VERTICAL
+    if (infoPtr->dwExStyle & TBSTYLE_EX_VERTICAL)
+        infoPtr->dwStyle |= CCS_VERT;
+#endif
+
     if (infoPtr->dwExStyle & ~TBSTYLE_EX_ALL)
         FIXME("Unknown Toolbar Extended Style %#lx. Please report.\n", (infoPtr->dwExStyle & ~TBSTYLE_EX_ALL));
 
--- a/dlls/comctl32/tests/toolbar.c
+++ b/dlls/comctl32/tests/toolbar.c
@@ -2155,7 +2155,6 @@
 
     style = SendMessageA(hToolbar, TB_GETSTYLE, 0, 0);
     style2 = GetWindowLongA(hToolbar, GWL_STYLE);
-    todo_wine
     ok(style == style2, "got 0x%08lx, expected 0x%08lx\n", style, style2);
 
     /* try to alter common window bits */
@@ -2766,7 +2765,6 @@
     memset(&button, 0, sizeof(button));
     ret = SendMessageA(hwnd, TB_GETBUTTON, 0, (LPARAM)&button);
     ok(ret == 1, "Unexpected return value.\n");
-    todo_wine
     ok(button.iBitmap == 8, "Unexpected iBitmap value %d.\n", button.iBitmap);
 
     rebuild_toolbar(&hwnd);
@@ -2827,7 +2825,6 @@
     memset(&button, 0, sizeof(button));
     ret = SendMessageA(hwnd, TB_GETBUTTON, 0, (LPARAM)&button);
     ok(ret == 1, "Unexpected return value.\n");
-    todo_wine
     ok(button.iBitmap == 8, "Unexpected iBitmap value %d.\n", button.iBitmap);
 
     DestroyWindow(hwnd);
