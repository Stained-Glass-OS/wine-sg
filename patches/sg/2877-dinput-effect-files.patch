From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dinput: implement EnumEffectsInFile and WriteEffectToFile

Force feedback effect files as RIFF 'FORC' files, one LIST 'fref' (NAME + DATA) per effect. The DATA layout is not documented and is private to this implementation; effects round trip with each other.
---
diff --git a/dlls/dinput/device.c b/dlls/dinput/device.c
index 199fb7d..d2dbaf5 100644
--- a/dlls/dinput/device.c
+++ b/dlls/dinput/device.c
@@ -1888,21 +1888,262 @@ static HRESULT WINAPI dinput_device_SendDeviceData( IDirectInputDevice8W *iface,
     return DI_OK;
 }
 
+/* Force feedback effect files are RIFF files: 'RIFF' <size> 'FORC', holding one 'LIST' 'fref'
+ * per effect with a 'NAME' chunk (the friendly name, ANSI, NUL terminated) and a 'DATA' chunk.
+ * The documentation does not give the layout of 'DATA'; ours is the effect GUID followed by
+ * the DIEFFECT members as 32-bit values (pointers replaced by presence markers) and then the
+ * axes, directions, envelope and type specific parameters that are present.  The files are
+ * therefore readable by this implementation only. */
+#define DIFEF_DEFAULT           0x00000000
+#define DIFEF_INCLUDENONSTANDARD 0x00000001
+#define DIFEF_MODIFYIFNEEDED    0x00000010
+#define DIFEF_ALL               (DIFEF_INCLUDENONSTANDARD | DIFEF_MODIFYIFNEEDED)
+
+#define FFE_FOURCC( a, b, c, d ) ((DWORD)(a) | ((DWORD)(b) << 8) | ((DWORD)(c) << 16) | ((DWORD)(d) << 24))
+#define FFE_MAX_AXES 32
+#define FFE_MAX_FILE_SIZE (16 * 1024 * 1024)
+
+struct ffe_data
+{
+    GUID guid;
+    DWORD size, flags, duration, sample_period, gain, trigger_button, trigger_repeat_interval;
+    DWORD axes, type_specific_size, start_delay;
+    DWORD has_axes, has_directions, has_envelope;
+};
+
+static BOOL ffe_valid_effect( const DIEFFECT *effect )
+{
+    if (!effect) return FALSE;
+    if (effect->dwSize != sizeof(DIEFFECT) && effect->dwSize != sizeof(DIEFFECT_DX5)) return FALSE;
+    if (effect->cAxes > FFE_MAX_AXES) return FALSE;
+    if (effect->cAxes && !effect->rgdwAxes && effect->rglDirection) return FALSE;
+    if (effect->cbTypeSpecificParams && !effect->lpvTypeSpecificParams) return FALSE;
+    if (effect->lpEnvelope && effect->lpEnvelope->dwSize != sizeof(DIENVELOPE)) return FALSE;
+    return TRUE;
+}
+
+static BOOL ffe_append( BYTE **buf, DWORD *len, DWORD *cap, const void *data, DWORD size )
+{
+    if (*len + size > *cap)
+    {
+        DWORD new_cap = max( *cap * 2, *len + size + 256 );
+        BYTE *tmp = realloc( *buf, new_cap );
+        if (!tmp) return FALSE;
+        *buf = tmp;
+        *cap = new_cap;
+    }
+    if (size) memcpy( *buf + *len, data, size );
+    *len += size;
+    return TRUE;
+}
+
+static BOOL ffe_append_chunk( BYTE **buf, DWORD *len, DWORD *cap, DWORD id, const void *data, DWORD size )
+{
+    static const BYTE pad;
+    return ffe_append( buf, len, cap, &id, 4 ) && ffe_append( buf, len, cap, &size, 4 ) &&
+           ffe_append( buf, len, cap, data, size ) && (!(size & 1) || ffe_append( buf, len, cap, &pad, 1 ));
+}
+
+static HRESULT ffe_serialize( const DIFILEEFFECT *file_effect, BYTE **buf, DWORD *len, DWORD *cap )
+{
+    const DIEFFECT *effect = file_effect->lpDiEffect;
+    BYTE *body = NULL, *list = NULL;
+    DWORD body_len = 0, body_cap = 0, list_len = 0, list_cap = 0, type;
+    struct ffe_data data = {0};
+    HRESULT hr = E_OUTOFMEMORY;
+    DWORD name_len = strnlen( file_effect->szFriendlyName, MAX_PATH - 1 ) + 1;
+    char name[MAX_PATH] = {0};
+
+    memcpy( name, file_effect->szFriendlyName, name_len - 1 );
+
+    data.guid = file_effect->GuidEffect;
+    data.size = effect->dwSize;
+    data.flags = effect->dwFlags;
+    data.duration = effect->dwDuration;
+    data.sample_period = effect->dwSamplePeriod;
+    data.gain = effect->dwGain;
+    data.trigger_button = effect->dwTriggerButton;
+    data.trigger_repeat_interval = effect->dwTriggerRepeatInterval;
+    data.axes = effect->cAxes;
+    data.type_specific_size = effect->cbTypeSpecificParams;
+    data.start_delay = effect->dwSize == sizeof(DIEFFECT) ? effect->dwStartDelay : 0;
+    data.has_axes = effect->rgdwAxes != NULL;
+    data.has_directions = effect->rglDirection != NULL;
+    data.has_envelope = effect->lpEnvelope != NULL;
+
+    if (!ffe_append( &body, &body_len, &body_cap, &data, sizeof(data) )) goto done;
+    if (data.has_axes && !ffe_append( &body, &body_len, &body_cap, effect->rgdwAxes, effect->cAxes * sizeof(DWORD) )) goto done;
+    if (data.has_directions && !ffe_append( &body, &body_len, &body_cap, effect->rglDirection, effect->cAxes * sizeof(LONG) )) goto done;
+#ifdef SG_MUTANT_DIL_FFE_ENV
+    data.has_envelope = 0;
+#endif
+    if (data.has_envelope && !ffe_append( &body, &body_len, &body_cap, effect->lpEnvelope, sizeof(DIENVELOPE) )) goto done;
+    if (!ffe_append( &body, &body_len, &body_cap, effect->lpvTypeSpecificParams, effect->cbTypeSpecificParams )) goto done;
+
+    type = FFE_FOURCC( 'f', 'r', 'e', 'f' );
+    if (!ffe_append( &list, &list_len, &list_cap, &type, 4 )) goto done;
+#ifdef SG_MUTANT_DIL_FFE_NAME
+    name[0] = 0;
+#endif
+    if (!ffe_append_chunk( &list, &list_len, &list_cap, FFE_FOURCC( 'N', 'A', 'M', 'E' ), name, name_len )) goto done;
+    if (!ffe_append_chunk( &list, &list_len, &list_cap, FFE_FOURCC( 'D', 'A', 'T', 'A' ), body, body_len )) goto done;
+    if (!ffe_append_chunk( buf, len, cap, FFE_FOURCC( 'L', 'I', 'S', 'T' ), list, list_len )) goto done;
+    hr = DI_OK;
+
+done:
+    free( body );
+    free( list );
+    return hr;
+}
+
 static HRESULT WINAPI dinput_device_EnumEffectsInFile( IDirectInputDevice8W *iface, const WCHAR *filename,
                                                        LPDIENUMEFFECTSINFILECALLBACK callback,
                                                        void *context, DWORD flags )
 {
-    FIXME( "iface %p, filename %s, callback %p, context %p, flags %#lx stub!\n", iface,
+    DWORD size, read, pos, riff_end, id, chunk_size;
+    BYTE *data = NULL;
+    HANDLE file;
+    HRESULT hr = DI_OK;
+
+    TRACE( "iface %p, filename %s, callback %p, context %p, flags %#lx.\n", iface,
            debugstr_w(filename), callback, context, flags );
-    return DI_OK;
+
+    if (!filename || !callback || (flags & ~DIFEF_ALL)) return DIERR_INVALIDPARAM;
+
+    file = CreateFileW( filename, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || size > FFE_MAX_FILE_SIZE || !(data = malloc( size + 8 )) ||
+        !ReadFile( file, data, size, &read, NULL ) || read != size)
+    {
+        CloseHandle( file );
+        free( data );
+        return DIERR_INVALIDPARAM;
+    }
+    CloseHandle( file );
+
+    if (size < 12 || memcmp( data, "RIFF", 4 ) || memcmp( data + 8, "FORC", 4 ))
+    {
+        free( data );
+        return DIERR_INVALIDPARAM;
+    }
+    memcpy( &riff_end, data + 4, 4 );
+    riff_end += 8;
+    if (riff_end > size || riff_end < 12) riff_end = size;
+
+    for (pos = 12; pos + 8 <= riff_end; pos += 8 + ((chunk_size + 1) & ~1))
+    {
+        DWORD list_pos, list_end, sub_size;
+        DIFILEEFFECT file_effect = {.dwSize = sizeof(file_effect)};
+        DIEFFECT effect = {0};
+        BOOL have_name = FALSE, have_data = FALSE;
+        DWORD axes[FFE_MAX_AXES];
+        LONG directions[FFE_MAX_AXES];
+        DIENVELOPE envelope;
+        BYTE *params = NULL;
+        struct ffe_data ffe;
+
+        memcpy( &id, data + pos, 4 );
+        memcpy( &chunk_size, data + pos + 4, 4 );
+        if (chunk_size > riff_end - pos - 8) { hr = DIERR_INVALIDPARAM; break; }
+        if (id != FFE_FOURCC( 'L', 'I', 'S', 'T' ) || chunk_size < 4 || memcmp( data + pos + 8, "fref", 4 )) continue;
+
+        list_end = pos + 8 + chunk_size;
+        for (list_pos = pos + 12; list_pos + 8 <= list_end; list_pos += 8 + ((sub_size + 1) & ~1))
+        {
+            memcpy( &id, data + list_pos, 4 );
+            memcpy( &sub_size, data + list_pos + 4, 4 );
+            if (sub_size > list_end - list_pos - 8) { hr = DIERR_INVALIDPARAM; goto done; }
+
+            if (id == FFE_FOURCC( 'N', 'A', 'M', 'E' ))
+            {
+                DWORD len = min( sub_size, MAX_PATH - 1 );
+                memset( file_effect.szFriendlyName, 0, sizeof(file_effect.szFriendlyName) );
+                memcpy( file_effect.szFriendlyName, data + list_pos + 8, len );
+                have_name = TRUE;
+            }
+            else if (id == FFE_FOURCC( 'D', 'A', 'T', 'A' ))
+            {
+                DWORD off = list_pos + 8, end = off + sub_size;
+
+                if (sub_size < sizeof(ffe)) { hr = DIERR_INVALIDPARAM; goto done; }
+                memcpy( &ffe, data + off, sizeof(ffe) );
+                off += sizeof(ffe);
+                if ((ffe.size != sizeof(DIEFFECT) && ffe.size != sizeof(DIEFFECT_DX5)) || ffe.axes > FFE_MAX_AXES ||
+                    (ffe.has_axes ? ffe.axes * 4 : 0) + (ffe.has_directions ? ffe.axes * 4 : 0) +
+                    (ffe.has_envelope ? sizeof(DIENVELOPE) : 0) + (ULONGLONG)ffe.type_specific_size > end - off)
+                { hr = DIERR_INVALIDPARAM; goto done; }
+
+                effect.dwSize = ffe.size;
+                effect.dwFlags = ffe.flags;
+                effect.dwDuration = ffe.duration;
+                effect.dwSamplePeriod = ffe.sample_period;
+                effect.dwGain = ffe.gain;
+                effect.dwTriggerButton = ffe.trigger_button;
+                effect.dwTriggerRepeatInterval = ffe.trigger_repeat_interval;
+                effect.cAxes = ffe.axes;
+                effect.dwStartDelay = ffe.start_delay;
+                if (ffe.has_axes) { memcpy( axes, data + off, ffe.axes * 4 ); off += ffe.axes * 4; effect.rgdwAxes = axes; }
+                if (ffe.has_directions) { memcpy( directions, data + off, ffe.axes * 4 ); off += ffe.axes * 4; effect.rglDirection = directions; }
+                if (ffe.has_envelope) { memcpy( &envelope, data + off, sizeof(envelope) ); off += sizeof(envelope); effect.lpEnvelope = &envelope; }
+                effect.cbTypeSpecificParams = ffe.type_specific_size;
+                if (ffe.type_specific_size) effect.lpvTypeSpecificParams = params = data + off;
+                file_effect.GuidEffect = ffe.guid;
+                have_data = TRUE;
+            }
+        }
+
+        if (!have_data) { hr = DIERR_INVALIDPARAM; break; }
+        if (!have_name) memset( file_effect.szFriendlyName, 0, sizeof(file_effect.szFriendlyName) );
+        file_effect.lpDiEffect = &effect;
+#ifdef SG_MUTANT_DIL_FFE_STOP
+        callback( &file_effect, context );
+        continue;
+#endif
+        if (!callback( &file_effect, context )) break;
+    }
+
+done:
+    free( data );
+    return hr;
 }
 
 static HRESULT WINAPI dinput_device_WriteEffectToFile( IDirectInputDevice8W *iface, const WCHAR *filename,
                                                        DWORD count, DIFILEEFFECT *effects, DWORD flags )
 {
-    FIXME( "iface %p, filename %s, count %lu, effects %p, flags %#lx stub!\n", iface,
+    BYTE *buf = NULL;
+    DWORD i, len = 0, cap = 0, riff_size, written;
+    HANDLE file;
+    HRESULT hr;
+
+    TRACE( "iface %p, filename %s, count %lu, effects %p, flags %#lx.\n", iface,
            debugstr_w(filename), count, effects, flags );
-    return DI_OK;
+
+#ifdef SG_MUTANT_DIL_FFE_ARGS
+    if (!filename || !effects) return DIERR_INVALIDPARAM;
+#else
+    if (!filename || !count || !effects || (flags & ~DIFEF_ALL)) return DIERR_INVALIDPARAM;
+#endif
+    for (i = 0; i < count; i++)
+        if (effects[i].dwSize != sizeof(DIFILEEFFECT) || !ffe_valid_effect( effects[i].lpDiEffect )) return DIERR_INVALIDPARAM;
+
+    if (!ffe_append( &buf, &len, &cap, "RIFF\0\0\0\0FORC", 12 )) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+        if (FAILED(hr = ffe_serialize( effects + i, &buf, &len, &cap ))) goto done;
+    riff_size = len - 8;
+    memcpy( buf + 4, &riff_size, 4 );
+
+    file = CreateFileW( filename, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) hr = HRESULT_FROM_WIN32( GetLastError() );
+    else
+    {
+        hr = WriteFile( file, buf, len, &written, NULL ) && written == len ? DI_OK : HRESULT_FROM_WIN32( GetLastError() );
+        CloseHandle( file );
+    }
+
+done:
+    free( buf );
+    return hr;
 }
 
 BOOL device_object_matches_semantic( const DIDEVICEINSTANCEW *instance, const DIOBJECTDATAFORMAT *object,
