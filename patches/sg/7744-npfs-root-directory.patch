From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, server: the named pipe root directory lists the pipes

FindFirstFile("\\.\pipe\*") and NtQueryDirectoryFile on \\.\pipe\ failed with
ERROR_BAD_DEV_TYPE. Windows lists the pipes there, and Visual Studio's
ServiceHub client checks for its controller's pipe with
Directory.GetFiles(@"\\.\pipe\", name), so it never found the controller.
The server answers a Wine-internal ioctl on the pipe root directory (an entry
by index, and the listing's position and mask kept with the open directory);
NtQueryDirectoryFile matches the names and fills every directory information
class, EndOfFile being the pipe's instances and AllocationSize its maximum.
---
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index a307021..4580dba 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -119,6 +119,7 @@
 #define WINE_MOUNTMGR_EXTENSIONS
 #include "ddk/mountmgr.h"
 #include "wine/server.h"
+#include "wine/npfs.h"
 #include "wine/list.h"
 #include "wine/debug.h"
 #include "unix_private.h"
@@ -3054,6 +3055,135 @@ static unsigned int get_cached_dir_data( HANDLE handle, struct dir_data **data_r
 }
 
 
+static NTSTATUS server_ioctl_file( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, PVOID apc_context,
+                                   IO_STATUS_BLOCK *io, UINT code, const void *in_buffer, UINT in_size,
+                                   PVOID out_buffer, UINT out_size );
+
+static NTSTATUS npfs_dir_request( HANDLE handle, const struct npfs_dir_request *req, const void *data,
+                                  ULONG data_size, void *out, ULONG out_size, ULONG_PTR *ret_size )
+{
+    char in[sizeof(*req) + 512 * sizeof(WCHAR)];
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+
+    if (data_size > sizeof(in) - sizeof(*req)) data_size = sizeof(in) - sizeof(*req);
+    memcpy( in, req, sizeof(*req) );
+    if (data_size) memcpy( in + sizeof(*req), data, data_size );
+    io.Information = 0;
+    status = server_ioctl_file( handle, NULL, NULL, NULL, &io, IOCTL_WINE_NPFS_DIRECTORY,
+                                in, sizeof(*req) + data_size, out, out_size );
+    if (ret_size) *ret_size = io.Information;
+    return status;
+}
+
+/* Stained Glass OS: the named pipe root directory (\\.\pipe\) lists the pipes, as NPFS does:
+ * EndOfFile is the pipe's current instances, AllocationSize its maximum. The server keeps the
+ * position and the mask of the first query with the open directory. */
+static NTSTATUS npfs_query_directory( HANDLE handle, IO_STATUS_BLOCK *io, void *buffer, ULONG length,
+                                      FILE_INFORMATION_CLASS class, BOOLEAN single_entry,
+                                      const UNICODE_STRING *mask, BOOLEAN restart_scan )
+{
+    struct { struct npfs_dir_state state; WCHAR mask[256]; } state;
+    struct { struct npfs_dir_entry entry; WCHAR name[256]; } entry;
+    struct npfs_dir_request req;
+    union file_directory_info *info, *last_info = NULL;
+    UNICODE_STRING use_mask;
+    ULONG_PTR size;
+    ULONG start, dir_size, name_len, used = 0;
+    unsigned int index;
+    BOOL first = FALSE;
+    NTSTATUS status;
+
+    req.op = NPFS_DIR_GET_STATE;
+    req.index = 0;
+    if ((status = npfs_dir_request( handle, &req, NULL, 0, &state, sizeof(state), &size )))
+        return status == STATUS_INVALID_PARAMETER ? STATUS_INVALID_DEVICE_REQUEST : status;
+
+    if (!state.state.started || restart_scan)
+    {
+        index = 0;
+        first = !state.state.started;
+        if (mask && mask->Length && mask->Length < sizeof(state.mask))
+        {
+            memcpy( state.mask, mask->Buffer, mask->Length );
+            use_mask.Length = mask->Length;
+        }
+        else if (!state.state.started || !mask)
+        {
+            if (state.state.started && !mask) use_mask.Length = size - sizeof(state.state);
+            else { state.mask[0] = '*'; use_mask.Length = sizeof(WCHAR); }
+        }
+        else { state.mask[0] = '*'; use_mask.Length = sizeof(WCHAR); }
+    }
+    else
+    {
+        index = state.state.index;
+        use_mask.Length = size - sizeof(state.state);
+        if (!use_mask.Length) { state.mask[0] = '*'; use_mask.Length = sizeof(WCHAR); }
+    }
+    use_mask.Buffer = state.mask;
+    use_mask.MaximumLength = sizeof(state.mask);
+
+    dir_size = dir_info_size( class, 0 );
+    for (;;)
+    {
+        req.op = NPFS_DIR_GET_ENTRY;
+        req.index = index;
+        status = npfs_dir_request( handle, &req, NULL, 0, &entry, sizeof(entry), &size );
+        if (status == STATUS_BUFFER_TOO_SMALL) { index++; continue; }  /* name too long to list */
+        if (status) break;
+        name_len = size - sizeof(entry.entry);
+#ifndef SG_MUTANT_NPFS_DIR_NO_MASK
+        if (!match_filename( entry.name, name_len / sizeof(WCHAR), &use_mask )) { index++; continue; }
+#endif
+
+        start = dir_info_align( used );
+        if (start + dir_size + name_len > length)
+        {
+            if (last_info) break;
+            /* the first entry is always returned, truncated */
+            if (start + dir_size > length) { status = STATUS_BUFFER_OVERFLOW; break; }
+        }
+        info = (union file_directory_info *)((char *)buffer + start);
+        memset( info, 0, dir_size );
+        if (class != FileNamesInformation)
+        {
+            info->dir.EndOfFile.QuadPart = entry.entry.instances;
+            info->dir.AllocationSize.QuadPart = entry.entry.max_instances;
+            info->dir.FileAttributes = FILE_ATTRIBUTE_NORMAL;
+        }
+        switch (class)
+        {
+        case FileDirectoryInformation: info->dir.FileNameLength = name_len; break;
+        case FileFullDirectoryInformation: info->full.FileNameLength = name_len; break;
+        case FileIdFullDirectoryInformation: info->id_full.FileNameLength = name_len; break;
+        case FileBothDirectoryInformation: info->both.FileNameLength = name_len; break;
+        case FileIdBothDirectoryInformation: info->id_both.FileNameLength = name_len; break;
+        case FileIdGlobalTxDirectoryInformation: info->id_tx.FileNameLength = name_len; break;
+        case FileNamesInformation: info->names.FileNameLength = name_len; break;
+        default: break;
+        }
+        memcpy( (char *)info + dir_size, entry.name, min( name_len, length - start - dir_size ) );
+        used = start + dir_size + min( name_len, length - start - dir_size );
+        if (last_info) last_info->next = (char *)info - (char *)last_info;
+        last_info = info;
+        index++;
+        if (name_len > length - start - dir_size) { status = STATUS_BUFFER_OVERFLOW; break; }
+        if (single_entry) break;
+    }
+    if (status == STATUS_NO_MORE_FILES) status = STATUS_SUCCESS;
+
+    req.op = NPFS_DIR_SET_STATE;
+    req.index = index;
+    npfs_dir_request( handle, &req, use_mask.Buffer, use_mask.Length, NULL, 0, NULL );
+
+    if (!status && !last_info) status = first ? STATUS_NO_SUCH_FILE : STATUS_NO_MORE_FILES;
+    io->Status = status;
+    io->Information = used;
+    return status;
+}
+
+
 /******************************************************************************
  *              NtQueryDirectoryFile   (NTDLL.@)
  */
@@ -3101,7 +3231,16 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
     if (!buffer) return STATUS_ACCESS_VIOLATION;
 
     if ((status = server_get_unix_fd( handle, FILE_LIST_DIRECTORY, &fd, &needs_close, &type, &options )))
+    {
+        /* the named pipe root directory lists the pipes */
+        if (status == STATUS_BAD_DEVICE_TYPE)
+        {
+            NTSTATUS ret = npfs_query_directory( handle, io, buffer, length, info_class, single_entry,
+                                                 mask, restart_scan );
+            if (ret != STATUS_INVALID_DEVICE_REQUEST) return ret;
+        }
         return status;
+    }
 
     if (type != FD_TYPE_DIR)
     {
diff --git a/include/Makefile.in b/include/Makefile.in
index 6dbf20c..9d488a1 100644
--- a/include/Makefile.in
+++ b/include/Makefile.in
@@ -965,6 +965,7 @@ SOURCES = \
 	wine/mmsystem16.h \
 	wine/mscvpdb.h \
 	wine/mssign.h \
+	wine/npfs.h \
 	wine/nsi.h \
 	wine/orpc.idl \
 	wine/plugplay.idl \
diff --git a/include/wine/npfs.h b/include/wine/npfs.h
new file mode 100644
index 0000000..2d2c6c5
--- /dev/null
+++ b/include/wine/npfs.h
@@ -0,0 +1,54 @@
+/*
+ * Named pipe file system: Wine-internal requests
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_WINE_NPFS_H
+#define __WINE_WINE_NPFS_H
+
+#include <winioctl.h>
+
+/* Stained Glass OS: listing the named pipe root directory (\\.\pipe\), which
+ * NtQueryDirectoryFile does over these requests on its handle. The server keeps the
+ * listing's position and mask with the open directory. */
+#define IOCTL_WINE_NPFS_DIRECTORY CTL_CODE(FILE_DEVICE_NAMED_PIPE, 0x7f0, METHOD_BUFFERED, FILE_ANY_ACCESS)
+
+enum npfs_directory_op
+{
+    NPFS_DIR_GET_STATE,   /* reply: struct npfs_dir_state, then the mask */
+    NPFS_DIR_SET_STATE,   /* in: struct npfs_dir_request with the mask after it */
+    NPFS_DIR_GET_ENTRY,   /* in: struct npfs_dir_request; reply: struct npfs_dir_entry, then the name */
+};
+
+struct npfs_dir_request
+{
+    unsigned int op;
+    unsigned int index;      /* SET_STATE: the new position; GET_ENTRY: the entry */
+};
+
+struct npfs_dir_state
+{
+    unsigned int index;      /* position of the next entry */
+    unsigned int started;    /* a listing was started on this handle */
+};
+
+struct npfs_dir_entry
+{
+    unsigned int instances;      /* current instances of the pipe */
+    unsigned int max_instances;  /* maximum instances, as the pipe was created */
+};
+
+#endif  /* __WINE_WINE_NPFS_H */
diff --git a/server/named_pipe.c b/server/named_pipe.c
index aebc204..292e683 100644
--- a/server/named_pipe.c
+++ b/server/named_pipe.c
@@ -34,6 +34,7 @@
 #include "windef.h"
 #include "winternl.h"
 #include "winioctl.h"
+#include "wine/npfs.h"
 
 #include "file.h"
 #include "handle.h"
@@ -102,6 +103,10 @@ struct named_pipe_device_file
     struct object             obj;         /* object header */
     struct fd                *fd;          /* pseudo-fd for ioctls */
     struct named_pipe_device *device;      /* named pipe device */
+    unsigned int              dir_index;   /* root directory: position of the listing */
+    unsigned int              dir_started; /* root directory: a listing was started */
+    WCHAR                    *dir_mask;    /* root directory: the listing's mask */
+    data_size_t               dir_mask_len;
 };
 
 static void named_pipe_dump( struct object *obj, int verbose );
@@ -562,6 +567,9 @@ static struct object *named_pipe_device_lookup_name( struct object *obj, struct
 
         dir->fd = NULL;  /* defer alloc_pseudo_fd() until after we have options */
         dir->device = (struct named_pipe_device *)grab_object( obj );
+        dir->dir_index = dir->dir_started = 0;
+        dir->dir_mask = NULL;
+        dir->dir_mask_len = 0;
 
         return &dir->obj;
     }
@@ -713,6 +721,7 @@ static void named_pipe_dir_destroy( struct object *obj )
     struct named_pipe_device_file *file = (struct named_pipe_device_file *)obj;
     assert( obj->ops == &named_pipe_dir_ops );
     if (file->fd) release_object( file->fd );
+    free( file->dir_mask );
     release_object( file->device );
 }
 
@@ -1585,6 +1594,83 @@ static void named_pipe_device_ioctl( struct fd *fd, ioctl_code_t code, struct as
     }
 }
 
+/* Stained Glass OS: the listing of the root directory (\\.\pipe\), for NtQueryDirectoryFile.
+ * The position and mask live with the open directory; ntdll matches the names. */
+static void named_pipe_dir_list( struct fd *fd, struct async *async )
+{
+    struct named_pipe_device_file *dir = get_fd_user( fd );
+    const struct npfs_dir_request *req_data = get_req_data();
+    data_size_t size = get_req_data_size();
+
+    if (dir->obj.ops != &named_pipe_dir_ops || size < sizeof(*req_data))
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+
+    switch (req_data->op)
+    {
+    case NPFS_DIR_GET_STATE:
+    {
+        struct npfs_dir_state *state;
+        data_size_t len = sizeof(*state) + dir->dir_mask_len;
+
+        if (get_reply_max_size() < len)
+        {
+            set_error( STATUS_BUFFER_TOO_SMALL );
+            return;
+        }
+        if (!(state = set_reply_data_size( len ))) return;
+        state->index = dir->dir_index;
+        state->started = dir->dir_started;
+        if (dir->dir_mask_len) memcpy( state + 1, dir->dir_mask, dir->dir_mask_len );
+        return;
+    }
+    case NPFS_DIR_SET_STATE:
+    {
+        data_size_t mask_len = (size - sizeof(*req_data)) & ~(sizeof(WCHAR) - 1);
+        WCHAR *mask = NULL;
+
+        if (mask_len && !(mask = memdup( req_data + 1, mask_len ))) return;
+        free( dir->dir_mask );
+        dir->dir_mask = mask;
+        dir->dir_mask_len = mask_len;
+        dir->dir_index = req_data->index;
+        dir->dir_started = 1;
+        return;
+    }
+    case NPFS_DIR_GET_ENTRY:
+    {
+        struct named_pipe *pipe;
+        struct npfs_dir_entry *entry;
+        const WCHAR *name;
+        data_size_t name_len = 0;
+
+#ifdef SG_MUTANT_NPFS_DIR_EMPTY
+        set_error( STATUS_NO_MORE_FILES );
+        return;
+#endif
+        if (!(pipe = (struct named_pipe *)find_object_index( dir->device->pipes, req_data->index )))
+        {
+            set_error( STATUS_NO_MORE_FILES );
+            return;
+        }
+        name = get_object_name( &pipe->obj, &name_len );
+        if (get_reply_max_size() < sizeof(*entry) + name_len) set_error( STATUS_BUFFER_TOO_SMALL );
+        else if ((entry = set_reply_data_size( sizeof(*entry) + name_len )))
+        {
+            entry->instances = pipe->instances;
+            entry->max_instances = pipe->maxinstances;
+            memcpy( entry + 1, name, name_len );
+        }
+        release_object( pipe );
+        return;
+    }
+    default:
+        set_error( STATUS_INVALID_PARAMETER );
+    }
+}
+
 static void named_pipe_dir_ioctl( struct fd *fd, ioctl_code_t code, struct async *async )
 {
     struct named_pipe_device *device = get_fd_user( fd );
@@ -1621,6 +1707,10 @@ static void named_pipe_dir_ioctl( struct fd *fd, ioctl_code_t code, struct async
             return;
         }
 
+    case IOCTL_WINE_NPFS_DIRECTORY:
+        named_pipe_dir_list( fd, async );
+        return;
+
     default:
         named_pipe_device_ioctl( fd, code, async );
     }
