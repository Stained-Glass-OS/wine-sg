From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comdlg32: CDM_SETDEFEXT in the classic file dialog (3602)

comdlg32: CDM_SETDEFEXT in the classic file dialog

A hook that sends CDM_SETDEFEXT changes the default extension the dialog
appends to a name typed without one. The string is copied; the one the
caller passed in the OPENFILENAME is left alone.
---
diff --git a/dlls/comdlg32/filedlg.c b/dlls/comdlg32/filedlg.c
index 96df1d3..ee36a3f 100644
--- a/dlls/comdlg32/filedlg.c
+++ b/dlls/comdlg32/filedlg.c
@@ -813,6 +813,8 @@ done:
         heap_free((void *)info->filter);
         heap_free((void *)info->customfilter);
     }
+    else if (info->defext_changed)
+        heap_free((void *)info->defext);
 
     heap_free(info->filename);
     heap_free(info->initdir);
@@ -1323,6 +1325,39 @@ static INT_PTR FILEDLG95_HandleCustomDialogMessages(HWND hwnd, UINT uMsg, WPARAM
             else retval = FALSE;
             break;
 
+        case CDM_SETDEFEXT:
+        {
+            WCHAR *ext = NULL;
+
+            TRACE("CDM_SETDEFEXT:\n");
+            if (lParam)
+            {
+                if (fodInfos->unicode)
+                {
+                    ext = heap_alloc((lstrlenW((LPCWSTR)lParam) + 1) * sizeof(WCHAR));
+                    if (ext) lstrcpyW(ext, (LPCWSTR)lParam);
+                }
+                else
+                    ext = heap_strdupAtoW((LPCSTR)lParam);
+                if (!ext)
+                {
+                    retval = FALSE;
+                    break;
+                }
+            }
+#ifdef SG_MUTANT_CDM_SETDEFEXT
+            heap_free(ext);
+#else
+            /* the extension that came with the OPENFILENAME is only ours to free when it was converted */
+            if (fodInfos->defext && (!fodInfos->unicode || fodInfos->defext_changed))
+                heap_free((void *)fodInfos->defext);
+            fodInfos->defext = ext;
+            fodInfos->defext_changed = TRUE;
+#endif
+            retval = TRUE;
+            break;
+        }
+
         default:
             if (uMsg >= CDM_FIRST && uMsg <= CDM_LAST)
                 FIXME("message CDM_FIRST+%04x not implemented\n", uMsg - CDM_FIRST);
diff --git a/dlls/comdlg32/filedlgbrowser.h b/dlls/comdlg32/filedlgbrowser.h
index 414eb2e..da285fc 100644
--- a/dlls/comdlg32/filedlgbrowser.h
+++ b/dlls/comdlg32/filedlgbrowser.h
@@ -56,6 +56,7 @@ typedef struct
     LPWSTR filename;
     LPCWSTR title;
     LPCWSTR defext;
+    BOOL defext_changed; /* defext was replaced by CDM_SETDEFEXT and is ours to free */
     LPCWSTR filter;
     LPCWSTR customfilter;
     SIZE sizedlg; /* remember the size of the dialog */
