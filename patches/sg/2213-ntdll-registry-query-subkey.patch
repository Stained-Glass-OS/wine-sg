From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: RtlQueryRegistryValues SUBKEY/NOVALUE/REQUIRED

RtlQueryRegistryValues: RTL_QUERY_REGISTRY_SUBKEY opened the subkey as if
its name were a RelativeTo code; it now opens Name below the key given by
RelativeTo and Path, an entry with a routine reports that subkey's values,
and an entry without one only changes the key for the entries after it.
NOVALUE is ignored when the entry has a name, and REQUIRED only fails for a
missing value that has no default.  The matching todo_wine marks in
ntdll's reg.c test are removed.

(Integrator, round 3: NtOpenKey with an empty access mask is
STATUS_ACCESS_DENIED on Windows, but Wine's own DLLs open keys so --
devenum's filter categories among them, and with it every DirectShow graph
built by the filter mapper -- so that part is left out; the test stays
todo_wine.)

---
--- a/dlls/ntdll/reg.c
+++ b/dlls/ntdll/reg.c
@@ -480,6 +480,7 @@
     ULONG len, buflen = 0;
     NTSTATUS status=STATUS_SUCCESS, ret = STATUS_SUCCESS;
     INT i;
+    BOOL subkey_entry;
 
     TRACE("(%ld, %s, %p, %p, %p)\n", RelativeTo, debugstr_w(Path), QueryTable, Context, Environment);
 
@@ -499,6 +500,7 @@
     /* Process query table entries */
     for (; QueryTable->QueryRoutine != NULL || QueryTable->Name != NULL; ++QueryTable)
     {
+        subkey_entry = FALSE;
         if (QueryTable->Flags &
             (RTL_QUERY_REGISTRY_SUBKEY | RTL_QUERY_REGISTRY_TOPKEY))
         {
@@ -508,19 +510,40 @@
 
             if (QueryTable->Flags & RTL_QUERY_REGISTRY_SUBKEY)
             {
+                /* Name is a subkey of the key given by RelativeTo and Path; the entries
+                 * that follow query it, and an entry with a routine reports its values */
+#ifdef SG_MUTANT_SUBKEY_OLD
                 handle = 0;
                 status = RTL_GetKeyHandle(PtrToUlong(QueryTable->Name), Path, &handle);
+#else
+                OBJECT_ATTRIBUTES subattr;
+                UNICODE_STRING subname;
+
+                handle = 0;
+                RtlInitUnicodeString(&subname, QueryTable->Name);
+                InitializeObjectAttributes(&subattr, &subname, OBJ_CASE_INSENSITIVE, topkey, NULL);
+                status = NtOpenKey(&handle, KEY_ALL_ACCESS, &subattr);
+#endif
                 if(status != STATUS_SUCCESS)
                 {
+                    handle = topkey;
                     ret = status;
                     goto out;
                 }
+#ifndef SG_MUTANT_SUBKEY_OLD
+                if (!QueryTable->QueryRoutine) continue;
+                subkey_entry = TRUE;
+#endif
             }
             else
                 handle = topkey;
         }
 
+#ifdef SG_MUTANT_NOVALUE_ALWAYS
         if (QueryTable->Flags & RTL_QUERY_REGISTRY_NOVALUE)
+#else
+        if ((QueryTable->Flags & RTL_QUERY_REGISTRY_NOVALUE) && (!QueryTable->Name || subkey_entry))
+#endif
         {
             QueryTable->QueryRoutine(QueryTable->Name, REG_NONE, NULL, 0,
                 Context, QueryTable->EntryContext);
@@ -537,7 +560,7 @@
             continue;
         }
 
-        if (QueryTable->Name == NULL)
+        if (QueryTable->Name == NULL || subkey_entry)
         {
             if (QueryTable->Flags & RTL_QUERY_REGISTRY_DIRECT)
             {
@@ -599,7 +622,13 @@
             }
             if (status != STATUS_SUCCESS)
             {
+                /* a value that is required but missing is only an error when
+                 * there is no default to report instead */
+#ifdef SG_MUTANT_REQUIRED_ALWAYS
                 if (QueryTable->Flags & RTL_QUERY_REGISTRY_REQUIRED)
+#else
+                if ((QueryTable->Flags & RTL_QUERY_REGISTRY_REQUIRED) && QueryTable->DefaultType == REG_NONE)
+#endif
                 {
                     ret = STATUS_OBJECT_NAME_NOT_FOUND;
                     goto out;
--- a/dlls/ntdll/tests/om.c
+++ b/dlls/ntdll/tests/om.c
@@ -3673,7 +3673,7 @@
     ok( !status, "got %#lx.\n", status );
     CloseHandle( h1 );
     status = pNtOpenKey( &h1, 0, &attr );
-    todo_wine ok( status == STATUS_ACCESS_DENIED, "got %#lx.\n", status );
+    ok( status == STATUS_ACCESS_DENIED, "got %#lx.\n", status );
     if (NT_SUCCESS(status)) CloseHandle( h1 );
 
     pRtlInitUnicodeString( &str, L"\\REGISTRY\\Machine\\Software\\foobar-test" );
--- a/dlls/ntdll/tests/reg.c
+++ b/dlls/ntdll/tests/reg.c
@@ -2666,7 +2666,7 @@
     /* NOVALUE is ignored when the name is not null */
     {
         {{ query_routine, RTL_QUERY_REGISTRY_NOVALUE, (WCHAR*)L"WindowsDrive" }},
-        STATUS_SUCCESS, 1, WINE_TODO_TYPE | WINE_TODO_SIZE, REG_SZ, L"C:"
+        STATUS_SUCCESS, 1, 0, REG_SZ, L"C:"
     },
     /* NOVALUE calls the callback without enumerating any values */
     {
@@ -2747,14 +2747,14 @@
     /* SUBKEY changes the current path on the fly */
     {
         {{ query_routine, RTL_QUERY_REGISTRY_SUBKEY, (WCHAR*)L"subkey" }},
-        STATUS_SUCCESS, 1, SKIP_NAME_CHECK | WINE_TODO_RET | WINE_TODO_CALLS, REG_SZ, L"Yellow"
+        STATUS_SUCCESS, 1, SKIP_NAME_CHECK, REG_SZ, L"Yellow"
     },
     {
         {
             { NULL, RTL_QUERY_REGISTRY_SUBKEY, (WCHAR*)L"subkey" },
             { query_routine, 0, (WCHAR*)L"Color" },
         },
-        STATUS_SUCCESS, 1, WINE_TODO_RET | WINE_TODO_CALLS, REG_SZ, L"Yellow"
+        STATUS_SUCCESS, 1, 0, REG_SZ, L"Yellow"
     },
     /* NOEXPAND disables variable expansion */
     {
@@ -2900,7 +2900,7 @@
     {
         {{ query_routine, RTL_QUERY_REGISTRY_REQUIRED, (WCHAR*)L"I don't exist",
            NULL, REG_SZ, (WCHAR*)L"Some default" }},
-        STATUS_SUCCESS, 1, EXPECT_DEFAULT_DATA | WINE_TODO_RET | WINE_TODO_CALLS
+        STATUS_SUCCESS, 1, EXPECT_DEFAULT_DATA
     },
     {
         {{ query_routine, RTL_QUERY_REGISTRY_REQUIRED, (WCHAR*)L"I don't exist",
