From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.gaming.ui.gamebar: Event handler lists and factory identity.

GameBar's VisibilityChanged/IsInputRedirectedChanged handlers are kept in
lists (add returns tokens, remove takes them), and the activation factory
answers GetIids, GetRuntimeClassName and GetTrustLevel.
---
 dlls/windows.gaming.ui.gamebar/main.c | 116 ++++++++++++++++++++++++++++------
 1 file changed, 96 insertions(+), 20 deletions(-)

diff --git a/dlls/windows.gaming.ui.gamebar/main.c b/dlls/windows.gaming.ui.gamebar/main.c
index ff44c6c..adc52a1 100644
--- a/dlls/windows.gaming.ui.gamebar/main.c
+++ b/dlls/windows.gaming.ui.gamebar/main.c
@@ -21,10 +21,72 @@
 #include "private.h"
 
 #include "wine/debug.h"
+#include "wine/list.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(gamebar);
 
-static EventRegistrationToken dummy_token = {.value = 0xdeadbeef};
+/* There is no game bar here, so Visible and IsInputRedirected never change and
+ * the registered handlers are kept until removed, never invoked. */
+struct event_handler
+{
+    struct list entry;
+    IEventHandler_IInspectable *handler;
+    EventRegistrationToken token;
+};
+
+static CRITICAL_SECTION handlers_cs;
+static CRITICAL_SECTION_DEBUG handlers_cs_debug =
+{
+    0, 0, &handlers_cs,
+    { &handlers_cs_debug.ProcessLocksList, &handlers_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": handlers_cs") }
+};
+static CRITICAL_SECTION handlers_cs = { &handlers_cs_debug, -1, 0, 0, 0, 0 };
+static struct list visibility_handlers = LIST_INIT( visibility_handlers );
+static struct list input_redirected_handlers = LIST_INIT( input_redirected_handlers );
+static LONGLONG next_token = 1;
+
+static HRESULT handlers_append( struct list *list, IEventHandler_IInspectable *handler, EventRegistrationToken *token )
+{
+    struct event_handler *entry;
+
+    if (!handler || !token) return E_POINTER;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+
+    entry->handler = handler;
+    IEventHandler_IInspectable_AddRef( handler );
+
+    EnterCriticalSection( &handlers_cs );
+    entry->token.value = next_token++;
+    list_add_tail( list, &entry->entry );
+    LeaveCriticalSection( &handlers_cs );
+
+    *token = entry->token;
+    return S_OK;
+}
+
+static HRESULT handlers_remove( struct list *list, EventRegistrationToken token )
+{
+    struct event_handler *entry, *found = NULL;
+
+    EnterCriticalSection( &handlers_cs );
+    LIST_FOR_EACH_ENTRY( entry, list, struct event_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    LeaveCriticalSection( &handlers_cs );
+
+    if (found)
+    {
+        IEventHandler_IInspectable_Release( found->handler );
+        free( found );
+    }
+    /* Removing an unknown token is not an error. */
+    return S_OK;
+}
 
 struct gamebar_statics
 {
@@ -61,7 +123,7 @@ static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID
         return S_OK;
     }
 
-    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
 }
@@ -84,25 +146,40 @@ static ULONG WINAPI factory_Release( IActivationFactory *iface )
 
 static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
 {
-    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
-    return E_NOTIMPL;
+    static const IID *factory_iids[] = {&IID_IActivationFactory, &IID_IGameBarStatics};
+    ULONG i;
+
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(factory_iids) / sizeof(*factory_iids) * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < sizeof(factory_iids) / sizeof(*factory_iids); i++) (*iids)[i] = *factory_iids[i];
+    *iid_count = i;
+    return S_OK;
 }
 
 static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
 {
-    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
-    return E_NOTIMPL;
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+
+    if (!class_name) return E_POINTER;
+    return WindowsCreateString( RuntimeClass_Windows_Gaming_UI_GameBar,
+                                wcslen( RuntimeClass_Windows_Gaming_UI_GameBar ), class_name );
 }
 
 static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
 {
-    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
-    return E_NOTIMPL;
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
 }
 
 static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
 {
-    FIXME( "iface %p, instance %p stub!\n", iface, instance );
+    /* GameBar only has static members, it cannot be instantiated. */
+    TRACE( "iface %p, instance %p.\n", iface, instance );
     return E_NOTIMPL;
 }
 
@@ -125,30 +202,28 @@ static HRESULT WINAPI statics_add_VisibilityChanged( IGameBarStatics *iface,
                                                      IEventHandler_IInspectable *handler,
                                                      EventRegistrationToken *token )
 {
-    FIXME( "iface %p, handler %p, token %p stub.\n", iface, handler, token );
-    *token = dummy_token;
-    return S_OK;
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    return handlers_append( &visibility_handlers, handler, token );
 }
 
 static HRESULT WINAPI statics_remove_VisibilityChanged( IGameBarStatics *iface, EventRegistrationToken token )
 {
-    FIXME( "iface %p, token %#I64x stub.\n", iface, token.value );
-    return S_OK;
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+    return handlers_remove( &visibility_handlers, token );
 }
 
 static HRESULT WINAPI statics_add_IsInputRedirectedChanged( IGameBarStatics *iface,
                                                             IEventHandler_IInspectable *handler,
                                                             EventRegistrationToken *token )
 {
-    FIXME( "iface %p, handler %p, token %p stub.\n", iface, handler, token );
-    *token = dummy_token;
-    return S_OK;
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    return handlers_append( &input_redirected_handlers, handler, token );
 }
 
 static HRESULT WINAPI statics_remove_IsInputRedirectedChanged( IGameBarStatics *iface, EventRegistrationToken token )
 {
-    FIXME( "iface %p, token %#I64x stub.\n", iface, token.value );
-    return S_OK;
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+    return handlers_remove( &input_redirected_handlers, token );
 }
 
 static HRESULT WINAPI statics_get_Visible( IGameBarStatics *iface, BOOLEAN *value)
@@ -198,7 +273,8 @@ static IActivationFactory *gamebar_factory = &gamebar_statics.IActivationFactory
 
 HRESULT WINAPI DllGetClassObject( REFCLSID clsid, REFIID riid, void **out )
 {
-    FIXME("clsid %s, riid %s, out %p stub!\n", debugstr_guid(clsid), debugstr_guid(riid), out);
+    /* Only WinRT activation factories live here, no COM classes. */
+    TRACE("clsid %s, riid %s, out %p.\n", debugstr_guid(clsid), debugstr_guid(riid), out);
 
     return CLASS_E_CLASSNOTAVAILABLE;
 }
