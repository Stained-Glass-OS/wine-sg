+#endif
+        return a > b ? 1 : a < b ? -1 : 0;
+    }
+
     if (propvar1->vt != propvar2->vt)
     {
         hr = PropVariantChangeType(&propvar2_static, propvar2, 0, propvar1->vt);
@@ -1410,16 +1421,28 @@
         case VT_R8:
             V_R8(var) = propvar->dblVal;
             break;
+        case VT_FILETIME:
+            hr = InitVariantFromFileTime(&propvar->filetime, var);
+            break;
         case VT_LPSTR:
         case VT_LPWSTR:
         case VT_BSTR:
         case VT_CLSID:
             var->vt = VT_BSTR;
             hr = PropVariantToBSTR(propvar, &V_BSTR(var));
+#ifndef SG_MUTANT_PV2V_CLSID
+            /* the class id comes back as its text, and the count of characters with the end as the result */
