+/* Serialized property storage ([MS-PROPSTORE]): per format id a block of values,
+ * each with its size, property id, a reserved byte and a typed value. */
+#define SPS_VERSION 0x53505331 /* "1SPS" */
+
+struct sps_buffer
+{
+    BYTE *data;
+    DWORD len, cap;
+    BOOL fail;
+};
+
+static void sps_put(struct sps_buffer *b, const void *src, DWORD n)
+{
+    if (b->fail) return;
+    if (b->len + n > b->cap)
+    {
+        DWORD cap = max(b->cap * 2, b->len + n + 64);
+        BYTE *p = CoTaskMemRealloc(b->data, cap);
+        if (!p) { b->fail = TRUE; return; }
+        b->data = p;
+        b->cap = cap;
+    }
+    if (src) memcpy(b->data + b->len, src, n);
+    else memset(b->data + b->len, 0, n);
+    b->len += n;
+}
+
+static HRESULT WINAPI PersistSerialized_QueryInterface(IPersistSerializedPropStorage *iface, REFIID iid, void **ppv)
+{
+    PropertyStore *This = impl_from_IPersistSerializedPropStorage(iface);
+    return IPropertyStoreCache_QueryInterface(&This->IPropertyStoreCache_iface, iid, ppv);
+}
+
+static ULONG WINAPI PersistSerialized_AddRef(IPersistSerializedPropStorage *iface)
+{
+    PropertyStore *This = impl_from_IPersistSerializedPropStorage(iface);
+    return IPropertyStoreCache_AddRef(&This->IPropertyStoreCache_iface);
+}
+
+static ULONG WINAPI PersistSerialized_Release(IPersistSerializedPropStorage *iface)
+{
+    PropertyStore *This = impl_from_IPersistSerializedPropStorage(iface);
+    return IPropertyStoreCache_Release(&This->IPropertyStoreCache_iface);
+}
+
+static HRESULT WINAPI PersistSerialized_SetFlags(IPersistSerializedPropStorage *iface, PERSIST_SPROPSTORE_FLAGS flags)
+{
+    PropertyStore *This = impl_from_IPersistSerializedPropStorage(iface);
+
+    TRACE("%p, %#x\n", iface, flags);
+    This->flags = flags;
+    return S_OK;
+}
+
+static HRESULT WINAPI PersistSerialized_SetPropertyStorage(IPersistSerializedPropStorage *iface,
+    PCUSERIALIZEDPROPSTORAGE psps, DWORD cb)
+{
+    PropertyStore *This = impl_from_IPersistSerializedPropStorage(iface);
+    const BYTE *p = (const BYTE *)psps;
+    propstore_format *format, *next;
+    HRESULT hr = S_OK;
+    DWORD left = cb;
+
+    TRACE("%p, %p, %lu\n", iface, psps, cb);
+
+    if (!psps && cb) return E_POINTER;
+
+    EnterCriticalSection(&This->lock);
+
+    /* what the storage holds replaces what the store has */
+    LIST_FOR_EACH_ENTRY_SAFE(format, next, &This->formats, propstore_format, entry)
+    {
+        list_remove(&format->entry);
+        destroy_format(format);
+    }
+
+    while (left >= 4)
+    {
+        DWORD storage_size, version, pos = 24;
+        GUID fmtid;
+
+        memcpy(&storage_size, p, 4);
+        if (!storage_size) break;
+        if (storage_size < 24 || storage_size > left) { hr = E_INVALIDARG; break; }
+        memcpy(&version, p + 4, 4);
+        if (version != SPS_VERSION) { hr = E_INVALIDARG; break; }
+        memcpy(&fmtid, p + 8, 16);
+
+        while (pos + 4 <= storage_size)
+        {
+            DWORD value_size, pid;
+            PROPVARIANT value;
+            PROPERTYKEY key;
+
+            memcpy(&value_size, p + pos, 4);
+            if (!value_size) break;
+            if (value_size < 13 || pos + value_size > storage_size) { hr = E_INVALIDARG; break; }
+            memcpy(&pid, p + pos + 4, 4);
+            if (FAILED(hr = StgDeserializePropVariant((const SERIALIZEDPROPERTYVALUE *)(p + pos + 9), value_size - 9, &value)))
+                break;
+            key.fmtid = fmtid;
+            key.pid = pid;
+            LeaveCriticalSection(&This->lock);
+            hr = IPropertyStoreCache_SetValueAndState(&This->IPropertyStoreCache_iface, &key, &value, PSC_NORMAL);
+            EnterCriticalSection(&This->lock);
+            PropVariantClear(&value);
+            if (FAILED(hr)) break;
+            pos += value_size;
+        }
+        if (FAILED(hr)) break;
+        p += storage_size;
+        left -= storage_size;
+    }
+
+    LeaveCriticalSection(&This->lock);
+    return hr;
+}
+
+static HRESULT WINAPI PersistSerialized_GetPropertyStorage(IPersistSerializedPropStorage *iface,
+    SERIALIZEDPROPSTORAGE **psps, DWORD *pcb)
+{
+    PropertyStore *This = impl_from_IPersistSerializedPropStorage(iface);
+    struct sps_buffer b = {0};
+    propstore_format *format;
+    propstore_value *value;
+    HRESULT hr = S_OK;
+    DWORD zero = 0;
+
+    TRACE("%p, %p, %p\n", iface, psps, pcb);
+
+    if (!psps || !pcb) return E_POINTER;
+    *psps = NULL;
+    *pcb = 0;
+#ifdef SG_MUTANT_SPS_STORAGE
+    return S_OK;
+#endif
+
+    EnterCriticalSection(&This->lock);
+
+    LIST_FOR_EACH_ENTRY(format, &This->formats, propstore_format, entry)
+    {
+        DWORD start = b.len, size, version = SPS_VERSION;
+
+        if (!format->count || IsEqualGUID(&format->fmtid, &FMTID_NamedProperties)) continue;
+        sps_put(&b, NULL, 4);                 /* the size, below */
+        sps_put(&b, &version, 4);
+        sps_put(&b, &format->fmtid, 16);
+        LIST_FOR_EACH_ENTRY(value, &format->values, propstore_value, entry)
+        {
+            SERIALIZEDPROPERTYVALUE *typed;
+            ULONG typed_size;
+            DWORD vstart = b.len, vsize;
+
+            if (FAILED(hr = StgSerializePropVariant(&value->propvar, &typed, &typed_size))) break;
+            sps_put(&b, NULL, 4);
+            sps_put(&b, &value->pid, 4);
+            sps_put(&b, NULL, 1);
+            sps_put(&b, typed, typed_size);
+            CoTaskMemFree(typed);
+            vsize = b.len - vstart;
+            if (!b.fail) memcpy(b.data + vstart, &vsize, 4);
+        }
+        if (FAILED(hr)) break;
+        sps_put(&b, &zero, 4);                /* the end of the values */
+        size = b.len - start;
+        if (!b.fail) memcpy(b.data + start, &size, 4);
+    }
+
+    LeaveCriticalSection(&This->lock);
+
+    if (SUCCEEDED(hr) && b.len) sps_put(&b, &zero, 4);   /* the end of the storages */
+    if (SUCCEEDED(hr) && b.fail) hr = E_OUTOFMEMORY;
+    if (FAILED(hr))
+    {
+        CoTaskMemFree(b.data);
+        return hr;
+    }
+    *psps = (SERIALIZEDPROPSTORAGE *)b.data;
+    *pcb = b.len;
+    return S_OK;
+}
+
+static const IPersistSerializedPropStorageVtbl PersistSerialized_Vtbl = {
+    PersistSerialized_QueryInterface,
+    PersistSerialized_AddRef,
+    PersistSerialized_Release,
+    PersistSerialized_SetFlags,
+    PersistSerialized_SetPropertyStorage,
+    PersistSerialized_GetPropertyStorage
+};
+
 static const IPropertyStoreCacheVtbl PropertyStore_Vtbl = {
     PropertyStore_QueryInterface,
     PropertyStore_AddRef,
@@ -468,6 +671,8 @@
     if (!This) return E_OUTOFMEMORY;
 
     This->IPropertyStoreCache_iface.lpVtbl = &PropertyStore_Vtbl;
+    This->IPersistSerializedPropStorage_iface.lpVtbl = &PersistSerialized_Vtbl;
+    This->flags = 0;
     This->ref = 1;
     InitializeCriticalSectionEx(&This->lock, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
     This->lock.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": PropertyStore.lock");
