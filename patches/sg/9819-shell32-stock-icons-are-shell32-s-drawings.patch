From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Sat, 28 Nov 2026 02:59:13 -0800
Subject: [PATCH] shell32: the stock icons are shell32's drawings of them -- the Print dialog's printers, folders, drives, the recycle bin (9819)

SHGetStockIconInfo gave the plain file icon for every stock icon but the
four message icons, so the Print dialog (PrintDlgEx's Select Printer list
uses SIID_PRINTER) showed each printer as a blank page, and programs asking
for a folder, drive, network, recycle bin or shortcut icon got the page
too. shell32 has drawn these at the resource ids Windows' shell32 gives
them -- the stock id + 1 for SIID_DOCNOASSOC..SIID_WORLD, SIID_SERVER,
SIID_PRINTER, SIID_MYNETWORK, SIID_FIND, SIID_LINK, SIID_RECYCLER and
SIID_RECYCLERFULL -- and those are given now (when the resource exists).

Gate test/stockmap-gate.sh.

--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -1940,6 +1940,23 @@
     default:           break;
     }
 #endif
+#ifndef SG_MUTANT_STOCK_PLAIN
+    /* wine-sg 9819: the other stock icons shell32 has drawn, at the resource ids Windows' shell32
+     * gives them (the stock id + 1): the Print dialog's printers (SIID_PRINTER), folders, drives,
+     * the network, the recycle bin, shortcuts -- every one of them was the plain file */
+    switch (id)
+    {
+    case 0: case 1: case 2: case 3: case 4:         /* documents, application, folder (closed, open) */
+    case 5: case 6: case 7: case 8: case 9:         /* drives: 5.25", 3.5", removable, fixed, network */
+    case 10: case 11: case 12: case 13:             /* network (disconnected), CD, RAM disk, world */
+    case SIID_SERVER: case SIID_PRINTER: case SIID_MYNETWORK: case SIID_FIND:
+    case SIID_LINK: case SIID_RECYCLER: case SIID_RECYCLERFULL:
+        if (FindResourceW(shell32_hInstance, MAKEINTRESOURCEW(id + 1), (LPCWSTR)RT_GROUP_ICON)) return id + 1;
+        break;
+    default:
+        break;
+    }
+#endif
     return IDI_SHELL_FILE;
 }
 
