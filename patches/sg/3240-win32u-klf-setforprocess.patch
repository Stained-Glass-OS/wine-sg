From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 13:10:00 -0700
Subject: [PATCH] user32: ActivateKeyboardLayout KLF_SETFORPROCESS (3240)

KLF_SETFORPROCESS now makes the layout the one of every thread of the
process: win32u keeps a process-wide layout and a generation number, and a
thread picks the new layout up the next time it reads or changes its own
(also threads created later). The X11 driver no longer refuses the flag
(layouts are switched on the display side), and its FIXME is gone.
CORE review: user32 input/msg and win32u 64/32 the same as stock (the
input.c pointer tests fail on this tree before and after, see ESCALATE.md).

diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index b3c72da..f1d20de 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -940,6 +940,28 @@ static HKL get_locale_kbd_layout(void)
     return ULongToHandle( layout );
 }
 
+/* layout set for the whole process with KLF_SETFORPROCESS: every thread
+ * picks it up the next time it asks for its layout */
+static HKL process_kbd_layout;
+static LONG process_kbd_layout_gen;
+
+static HKL get_thread_kbd_layout( struct user_thread_info *info )
+{
+    LONG gen = ReadNoFence( &process_kbd_layout_gen );
+
+#ifdef SG_MUTANT_KBD_NOSYNC
+    if (0)
+#else
+    if (info->kbd_layout_gen != gen)
+#endif
+    {
+        info->kbd_layout_gen = gen;
+        info->kbd_layout = process_kbd_layout;
+        info->kbd_layout_id = 0;
+    }
+    return info->kbd_layout;
+}
+
 /***********************************************************************
  *	     NtUserGetKeyboardLayout    (win32u.@)
  *
@@ -949,7 +971,7 @@ static HKL get_locale_kbd_layout(void)
 HKL WINAPI NtUserGetKeyboardLayout( DWORD thread_id )
 {
     struct user_thread_info *thread = get_user_thread_info();
-    HKL layout = thread->kbd_layout;
+    HKL layout = get_thread_kbd_layout( thread );
 
 #ifndef SG_MUTANT_NO_OTHER_THREAD_LAYOUT
     if (thread_id && thread_id != GetCurrentThreadId())
@@ -1287,7 +1309,7 @@ HKL WINAPI NtUserActivateKeyboardLayout( HKL layout, UINT flags )
 
     TRACE_(keyboard)( "layout %p, flags %x\n", layout, flags );
 
-    if (flags) FIXME_(keyboard)( "flags %x not supported\n", flags );
+    if (flags & ~KLF_SETFORPROCESS) FIXME_(keyboard)( "flags %x not supported\n", flags );
 
     if (layout == (HKL)HKL_NEXT || layout == (HKL)HKL_PREV)
     {
@@ -1307,7 +1329,16 @@ HKL WINAPI NtUserActivateKeyboardLayout( HKL layout, UINT flags )
     if (!user_driver->pActivateKeyboardLayout( layout, flags ))
         return 0;
 
-    old_layout = info->kbd_layout;
+    old_layout = get_thread_kbd_layout( info );
+#ifdef SG_MUTANT_KBD_NOPROC
+    if (0)
+#else
+    if (flags & KLF_SETFORPROCESS)
+#endif
+    {
+        process_kbd_layout = layout;
+        info->kbd_layout_gen = InterlockedIncrement( &process_kbd_layout_gen );
+    }
     if (old_layout != layout)
     {
         HWND ime_hwnd = get_default_ime_window( 0 );
diff --git a/dlls/win32u/ntuser_private.h b/dlls/win32u/ntuser_private.h
index 30ac9e8..9489c60 100644
--- a/dlls/win32u/ntuser_private.h
+++ b/dlls/win32u/ntuser_private.h
@@ -120,6 +120,7 @@ struct user_thread_info
     struct imm_thread_data       *imm_thread_data;        /* IMM thread data */
     HKL                           kbd_layout;             /* Current keyboard layout */
     UINT                          kbd_layout_id;          /* Current keyboard layout ID */
+    LONG                          kbd_layout_gen;         /* Last process-wide layout change (KLF_SETFORPROCESS) seen */
     struct hardware_msg_data     *rawinput;               /* Current rawinput message data */
     UINT                          spy_indent;             /* Current spy indent */
     UINT                          metrics_dpi;            /* Stained Glass OS: the DPI of a v2 window's frame, while it is laid out */
diff --git a/dlls/winex11.drv/keyboard.c b/dlls/winex11.drv/keyboard.c
index 2ef2282..80846be 100644
--- a/dlls/winex11.drv/keyboard.c
+++ b/dlls/winex11.drv/keyboard.c
@@ -1850,14 +1850,7 @@ void X11DRV_InitKeyboard( Display *display )
  */
 BOOL X11DRV_ActivateKeyboardLayout(HKL hkl, UINT flags)
 {
-    FIXME("%p, %04x: semi-stub!\n", hkl, flags);
-
-    if (flags & KLF_SETFORPROCESS)
-    {
-        RtlSetLastWin32Error( ERROR_CALL_NOT_IMPLEMENTED );
-        FIXME("KLF_SETFORPROCESS not supported\n");
-        return FALSE;
-    }
+    TRACE( "%p, %04x\n", hkl, flags );
 
     return TRUE;
 }
