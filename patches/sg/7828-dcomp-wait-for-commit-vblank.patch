From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dcomp: WaitForCommitCompletion returns at the next vertical
 blank

---
 dlls/dcomp/Makefile.in |  2 +-
 dlls/dcomp/device.c    | 28 +++++++++++++++++++++++++++-
 2 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/dlls/dcomp/Makefile.in b/dlls/dcomp/Makefile.in
index 5786903..3691ba1 100644
--- a/dlls/dcomp/Makefile.in
+++ b/dlls/dcomp/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = dcomp.dll
-IMPORTS   = combase d2d1 d3d11 dxguid uuid user32 gdi32
+IMPORTS   = combase d2d1 d3d11 dxguid uuid user32 gdi32 ntdll
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index e84b892..18a0ce6 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -37,8 +37,12 @@
 #include <stdarg.h>
 
 #define COBJMACROS
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
 #include "windef.h"
 #include "winbase.h"
+#include "winternl.h"
+#include "wingdi.h"
 #include "winuser.h"
 #include "objidl.h"
 #include "dxgi1_6.h"
@@ -876,9 +880,31 @@ static HRESULT STDMETHODCALLTYPE device_Commit(IDCompositionDevice *iface)
 
 static HRESULT STDMETHODCALLTYPE device_WaitForCommitCompletion(IDCompositionDevice *iface)
 {
+#ifndef SG_MUTANT_DCOMP_COMMIT_NO_WAIT
+    DEVMODEW mode = { .dmSize = sizeof(mode) };
+    LARGE_INTEGER frequency, qpc, delay;
+    LONGLONG period;
+    DWORD hz = 60;
+#endif
+
     TRACE("iface %p.\n", iface);
 
-    /* Commit is synchronous. */
+#ifndef SG_MUTANT_DCOMP_COMMIT_NO_WAIT
+    /* Stained Glass OS (wine-sg 7828): returns once the compositor has shown the commit, at the
+     * next vertical blank, as on Windows. Commit is synchronous here, but returning at once made
+     * a loop paced by it a busy loop: Avalonia's render timer (DwmRenderTimerLoop) drew its window
+     * as fast as it could -- Remote Desktop Manager 2026 at two cores of CPU, idle on its Quick
+     * start page, over 200 frames a second. */
+    if (EnumDisplaySettingsW( NULL, ENUM_CURRENT_SETTINGS, &mode ) && mode.dmDisplayFrequency > 1)
+        hz = mode.dmDisplayFrequency;
+    QueryPerformanceFrequency( &frequency );
+    period = frequency.QuadPart / hz;
+    if (period <= 0) return S_OK;
+    QueryPerformanceCounter( &qpc );
+    delay.QuadPart = -((((qpc.QuadPart / period) + 1) * period - qpc.QuadPart) * 10000000 / frequency.QuadPart);
+    if (!delay.QuadPart) delay.QuadPart = -1;
+    NtDelayExecution( FALSE, &delay );
+#endif
     return S_OK;
 }
 
