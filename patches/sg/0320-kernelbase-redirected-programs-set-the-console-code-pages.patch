From: Stained Glass OS <dev@stained-glass.example>
Subject: kernelbase: a program whose output is redirected from a Unix shell can set the console code pages

A program started from a Unix shell with no terminal (its output redirected
to a file or pipe: a build script, CI, our own tools) has the
CONSOLE_HANDLE_SHELL_NO_WINDOW console, and every console call failed with
ERROR_INVALID_ACCESS. On Windows such a program still has a console and can
read and choose its code pages. The .NET runtime throws IOException
("Invalid access") from Console.OutputEncoding's setter when
SetConsoleOutputCP fails, and the dotnet CLI sets it first thing: every
`dotnet ... > log` died at once.

Get/SetConsoleCP and Get/SetConsoleOutputCP now keep the code pages for the
process there (the OEM code page until set; an invalid one is refused with
ERROR_INVALID_PARAMETER).

Gate: test/devtools-gate.sh (conscp).
---
--- a/dlls/kernelbase/console.c
+++ b/dlls/kernelbase/console.c
@@ -57,6 +57,30 @@
 static HANDLE console_connection;
 static unsigned int console_flags;
 
+/* A program started from a Unix shell with no terminal (CONSOLE_HANDLE_SHELL_NO_WINDOW:
+ * its output redirected, as in a script or a build) is, on Windows, a program
+ * whose console output is redirected: it can still read and choose the
+ * console's code pages. .NET's Console.OutputEncoding setter throws when
+ * SetConsoleOutputCP fails -- the dotnet CLI sets it first thing. The code
+ * pages are kept for the process; 0 means not set yet (the OEM code page). */
+static UINT shell_input_cp, shell_output_cp;
+
+static BOOL shell_no_window(void)
+{
+    return RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle == CONSOLE_HANDLE_SHELL_NO_WINDOW;
+}
+
+static BOOL set_shell_cp( UINT *cp, UINT value )
+{
+    if (!IsValidCodePage( value ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *cp = value;
+    return TRUE;
+}
+
 #define CONSOLE_INPUT_HANDLE    0x01
 #define CONSOLE_OUTPUT_HANDLE   0x02
 #define CONSOLE_ERROR_HANDLE    0x04
@@ -822,6 +846,7 @@
 {
     struct condrv_input_info info;
 
+    if (shell_no_window()) return shell_input_cp ? shell_input_cp : GetOEMCP();
     if (!console_ioctl( RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle,
                          IOCTL_CONDRV_GET_INPUT_INFO, NULL, 0, &info, sizeof(info), NULL ))
         return 0;
@@ -958,6 +983,7 @@
 {
     struct condrv_input_info info;
 
+    if (shell_no_window()) return shell_output_cp ? shell_output_cp : GetOEMCP();
     if (!console_ioctl( RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle,
                          IOCTL_CONDRV_GET_INPUT_INFO, NULL, 0, &info, sizeof(info), NULL ))
         return 0;
@@ -1478,6 +1504,7 @@
 {
     struct condrv_input_info_params params = { SET_CONSOLE_INPUT_INFO_INPUT_CODEPAGE };
 
+    if (shell_no_window()) return set_shell_cp( &shell_input_cp, cp );
     params.info.input_cp = cp;
     return console_ioctl( RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle,
                           IOCTL_CONDRV_SET_INPUT_INFO, &params, sizeof(params), NULL, 0, NULL );
@@ -1632,6 +1659,7 @@
 {
     struct condrv_input_info_params params = { SET_CONSOLE_INPUT_INFO_OUTPUT_CODEPAGE };
 
+    if (shell_no_window()) return set_shell_cp( &shell_output_cp, cp );
     params.info.output_cp = cp;
     return console_ioctl( RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle,
                           IOCTL_CONDRV_SET_INPUT_INFO, &params, sizeof(params), NULL, 0, NULL );
