 GpStatus WINGDIPAPI GdipComment(GpGraphics *graphics, UINT sizeData, GDIPCONST BYTE *data)
 {
-    FIXME("(%p, %d, %p): stub\n", graphics, sizeData, data);
-    return NotImplemented;
+    TRACE("(%p, %d, %p)\n", graphics, sizeData, data);
+
+    if (!graphics || (sizeData && !data))
+        return InvalidParameter;
+    if (graphics->busy)
+        return ObjectBusy;
+    if (graphics->image && graphics->image->type == ImageTypeMetafile)
+        return METAFILE_Comment((GpMetafile *)graphics->image, sizeData, data);
+
+    /* a graphics that does not record has nowhere to keep it */
+    return Ok;
 }
 
