--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -1023,6 +1023,27 @@
     return Ok;
 }
 
+GpStatus METAFILE_Comment(GpMetafile *metafile, UINT size, const BYTE *data)
+{
+    if (metafile->metafile_type == MetafileTypeEmfPlusOnly || metafile->metafile_type == MetafileTypeEmfPlusDual)
+    {
+        /* the record carries the application's bytes, padded to a multiple of four */
+        UINT padded = (size + 3) & ~3u;
+        BYTE *record;
+        GpStatus stat;
+
+        stat = METAFILE_AllocateRecord(metafile, EmfPlusRecordTypeComment, sizeof(EmfPlusRecordHeader) + padded,
+                (void **)&record);
+        if (stat != Ok)
+            return stat;
+
+        memcpy(record + sizeof(EmfPlusRecordHeader), data, size);
+        METAFILE_WriteRecords(metafile);
+    }
+
+    return Ok;
+}
