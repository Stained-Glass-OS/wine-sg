From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: GdipBitmapConvertFormat, GdipComment (3516)

gdiplus: GdipBitmapConvertFormat, GdipComment

GdipBitmapConvertFormat converts the bitmap in place: to a direct format through the existing pixel
conversion, to a 1, 4 or 8 bit indexed format with the chosen palette (custom, black and white, the
halftone cubes, or a fixed spread for optimal), nearest colour matching, ordered or error diffusion
dithering and the alpha threshold for palettes that have a transparent entry. A locked bitmap is refused.
GdipComment writes an EMF+ comment record into a metafile being recorded and is accepted, with nothing
to keep, on any other graphics.
---
--- a/dlls/gdiplus/image.c
+++ b/dlls/gdiplus/image.c
@@ -19,6 +19,7 @@
 
 #include <stdarg.h>
 #include <assert.h>
+#include <limits.h>
 
 #include "windef.h"
 #include "winbase.h"
@@ -5932,14 +5933,191 @@
     return Ok;
 }
 
+static UINT build_cube_palette(ARGB *entries, UINT levels_r, UINT levels_g, UINT levels_b)
+{
+    UINT r, g, b, n = 0;
+
+    for (r = 0; r < levels_r; r++)
+        for (g = 0; g < levels_g; g++)
+            for (b = 0; b < levels_b; b++)
+                entries[n++] = 0xff000000 | ((r * 255 / (levels_r - 1)) << 16) | ((g * 255 / (levels_g - 1)) << 8)
+                        | (b * 255 / (levels_b - 1));
+    return n;
+}
+
+static UINT nearest_palette_index(const ARGB *entries, UINT count, int r, int g, int b)
+{
+    UINT i, best = 0;
+    int best_dist = INT_MAX;
+
+    for (i = 0; i < count; i++)
+    {
+        int dr = r - (int)((entries[i] >> 16) & 0xff), dg = g - (int)((entries[i] >> 8) & 0xff);
+        int db = b - (int)(entries[i] & 0xff), dist = dr * dr + dg * dg + db * db;
+
+        if (dist < best_dist)
+        {
+            best_dist = dist;
+            best = i;
+        }
+    }
+    return best;
+}
+
+static GpStatus convert_to_indexed(GpBitmap *bitmap, PixelFormat format, DitherType dithertype,
+    PaletteType palettetype, const ColorPalette *custom, REAL alphathreshold, GpBitmap **out)
+{
+    static const BYTE bayer4[16] = { 0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5 };
+    UINT bpp = PIXELFORMATBPP(format), max_colors = 1 << bpp, count = 0, x, y;
+    ARGB entries[256], *argb = NULL;
+    UINT palette_flags = 0;
+    int *errors = NULL;
+    GpBitmap *dst = NULL;
+    GpStatus status;
+    INT width = bitmap->width, height = bitmap->height;
+
+    memset(entries, 0, sizeof(entries));
+    switch (palettetype)
+    {
+    case PaletteTypeCustom:
+        if (!custom || !custom->Count || custom->Count > max_colors) return InvalidParameter;
+        count = custom->Count;
+        memcpy(entries, custom->Entries, count * sizeof(ARGB));
+        palette_flags = custom->Flags;
+        break;
+    case PaletteTypeFixedBW:
+        entries[0] = 0xff000000;
+        entries[1] = 0xffffffff;
+        count = 2;
+        palette_flags = PaletteFlagsGrayScale;
+        break;
+    case PaletteTypeFixedHalftone8:   count = build_cube_palette(entries, 2, 2, 2); palette_flags = PaletteFlagsHalftone; break;
+    case PaletteTypeFixedHalftone27:  count = build_cube_palette(entries, 3, 3, 3); palette_flags = PaletteFlagsHalftone; break;
+    case PaletteTypeFixedHalftone64:  count = build_cube_palette(entries, 4, 4, 4); palette_flags = PaletteFlagsHalftone; break;
+    case PaletteTypeFixedHalftone125: count = build_cube_palette(entries, 5, 5, 5); palette_flags = PaletteFlagsHalftone; break;
+    case PaletteTypeFixedHalftone216: count = build_cube_palette(entries, 6, 6, 6); palette_flags = PaletteFlagsHalftone; break;
+    case PaletteTypeFixedHalftone252: count = build_cube_palette(entries, 6, 7, 6); palette_flags = PaletteFlagsHalftone; break;
+    case PaletteTypeOptimal:
+        /* a fixed spread of colours that fits the format; no analysis of the image */
+        count = max_colors >= 252 ? build_cube_palette(entries, 6, 7, 6)
+              : max_colors >= 64 ? build_cube_palette(entries, 4, 4, 4)
+              : max_colors >= 8 ? build_cube_palette(entries, 2, 2, 2) : 0;
+        if (!count) { entries[0] = 0xff000000; entries[1] = 0xffffffff; count = 2; }
+        break;
+    default:
+        return InvalidParameter;
+    }
+    if (count > max_colors) count = max_colors;
+
+    if (!(argb = malloc((SIZE_T)width * height * sizeof(ARGB)))) return OutOfMemory;
+    if ((status = convert_pixels(width, height, width * 4, (BYTE *)argb, PixelFormat32bppARGB, NULL,
+            bitmap->stride, bitmap->bits, bitmap->format, bitmap->image.palette)) != Ok)
+    {
+        free(argb);
+        return status;
+    }
+    if (!(errors = calloc((SIZE_T)(width + 2) * 2 * 3, sizeof(int)))) { free(argb); return OutOfMemory; }
+
+    if ((status = GdipCreateBitmapFromScan0(width, height, 0, format, NULL, &dst)) != Ok) goto done;
+    memset(dst->bits, 0, (SIZE_T)abs(dst->stride) * height);
+    memset(dst->image.palette->Entries, 0, max_colors * sizeof(ARGB));
+    memcpy(dst->image.palette->Entries, entries, count * sizeof(ARGB));
+    dst->image.palette->Count = max_colors;
+    dst->image.palette->Flags = palette_flags;
+    {
+        UINT transparent = ~0u;
+        UINT i;
+        for (i = 0; i < count; i++)
+            if (!(entries[i] >> 24)) { transparent = i; dst->image.palette->Flags |= PaletteFlagsHasAlpha; break; }
+
+        for (y = 0; y < (UINT)height; y++)
+        {
+            int *cur = errors + ((y & 1) ? (width + 2) * 3 : 0), *next = errors + ((y & 1) ? 0 : (width + 2) * 3);
+            memset(next, 0, (width + 2) * 3 * sizeof(int));
+            for (x = 0; x < (UINT)width; x++)
+            {
+                ARGB c = argb[y * width + x];
+                int r = (c >> 16) & 0xff, g = (c >> 8) & 0xff, b = c & 0xff, a = c >> 24;
+                UINT idx;
+                BYTE *row = dst->bits + (SIZE_T)y * dst->stride;
+
+                if (transparent != ~0u && a < alphathreshold * 255.0f / 100.0f)
+                    idx = transparent;
+                else
+                {
+                    if (dithertype == DitherTypeErrorDiffusion)
+                    {
+                        r += cur[(x + 1) * 3] / 16; g += cur[(x + 1) * 3 + 1] / 16; b += cur[(x + 1) * 3 + 2] / 16;
+                    }
+                    else if (dithertype >= DitherTypeOrdered4x4 && dithertype != DitherTypeSolid)
+                    {
+                        int bias = (bayer4[(y & 3) * 4 + (x & 3)] - 8) * 2;
+                        r += bias; g += bias; b += bias;
+                    }
+                    r = max(0, min(255, r)); g = max(0, min(255, g)); b = max(0, min(255, b));
+                    idx = nearest_palette_index(entries, count, r, g, b);
+                    if (dithertype == DitherTypeErrorDiffusion)
+                    {
+                        int er = r - (int)((entries[idx] >> 16) & 0xff), eg = g - (int)((entries[idx] >> 8) & 0xff);
+                        int eb = b - (int)(entries[idx] & 0xff);
+                        int k[3] = { er, eg, eb }, ch;
+                        for (ch = 0; ch < 3; ch++)
+                        {
+                            cur[(x + 2) * 3 + ch] += k[ch] * 7;
+                            next[x * 3 + ch] += k[ch] * 3;
+                            next[(x + 1) * 3 + ch] += k[ch] * 5;
+                            next[(x + 2) * 3 + ch] += k[ch];
+                        }
+                    }
+                }
+                switch (bpp)
+                {
+                case 8: row[x] = idx; break;
+                case 4: row[x / 2] |= (x & 1) ? idx : idx << 4; break;
+                case 1: if (idx) row[x / 8] |= 0x80 >> (x & 7); break;
+                }
+            }
+        }
+    }
+    dst->image.xres = bitmap->image.xres;
+    dst->image.yres = bitmap->image.yres;
+    *out = dst;
+    status = Ok;
+
+done:
+    if (status != Ok && dst) GdipDisposeImage(&dst->image);
+    free(errors);
+    free(argb);
+    return status;
+}
+
 /*****************************************************************************
  * GdipBitmapConvertFormat [GDIPLUS.@]
  */
 GpStatus WINGDIPAPI GdipBitmapConvertFormat(GpBitmap *bitmap, PixelFormat format, DitherType dithertype,
     PaletteType palettetype, ColorPalette *palette, REAL alphathreshold)
 {
-    FIXME("(%p, 0x%08x, %d, %d, %p, %f): stub\n", bitmap, format, dithertype, palettetype, palette, alphathreshold);
-    return NotImplemented;
+    GpBitmap *converted = NULL;
+    GpStatus status;
+
+    TRACE("(%p, 0x%08x, %d, %d, %p, %f)\n", bitmap, format, dithertype, palettetype, palette, alphathreshold);
+
+    if (!bitmap || bitmap->image.type != ImageTypeBitmap || alphathreshold < 0.0f || alphathreshold > 100.0f)
+        return InvalidParameter;
+    if (bitmap->lockmode)
+        return WrongState;
+    if (format == PixelFormatDontCare || format == bitmap->format)
+        return Ok;
+
+    if (format == PixelFormat1bppIndexed || format == PixelFormat4bppIndexed || format == PixelFormat8bppIndexed)
+        status = convert_to_indexed(bitmap, format, dithertype, palettetype, palette, alphathreshold, &converted);
+    else
+        status = GdipCloneBitmapAreaI(0, 0, bitmap->width, bitmap->height, format, bitmap, &converted);
+    if (status != Ok)
+        return status;
+
+    move_bitmap(bitmap, converted, TRUE);
+    return Ok;
 }
 
 static void set_histogram_point_argb(ARGB color, UINT *ch0, UINT *ch1, UINT *ch2, UINT *ch3)
