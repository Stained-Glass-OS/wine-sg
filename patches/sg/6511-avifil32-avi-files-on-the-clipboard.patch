+/***********************************************************************
+ *		AVIPutFileOnClipboard	(AVIFIL32.@)
+ */
+HRESULT WINAPI AVIPutFileOnClipboard(PAVIFILE file)
+{
+    struct clip_object *object;
+    HRESULT hr;
+
+    TRACE("(%p)\n", file);
+
+    if (!file) return AVIERR_BADHANDLE;
+    if (!(object = calloc(1, sizeof(*object)))) return AVIERR_MEMORY;
+    object->IDataObject_iface.lpVtbl = &clip_object_vtbl;
+    object->ref = 1;
+    object->file = file;
+    IAVIFile_AddRef(file);
+
+    EnterCriticalSection(&clip_cs);
+    hr = OleSetClipboard(&object->IDataObject_iface);
+    if (SUCCEEDED(hr)) current_clip = object;
+    LeaveCriticalSection(&clip_cs);
+    IDataObject_Release(&object->IDataObject_iface);
+    if (FAILED(hr)) WARN("OleSetClipboard failed: %#lx\n", hr);
+    return FAILED(hr) ? hr : AVIERR_OK;
+}
+
+/***********************************************************************
+ *		AVIGetFromClipboard	(AVIFIL32.@)
+ */
+HRESULT WINAPI AVIGetFromClipboard(PAVIFILE *out)
+{
+    static const UINT formats[] = { CF_DIB, CF_WAVE };
+    IAVIStream *streams[ARRAY_SIZE(formats)];
+    IDataObject *data;
+    HRESULT hr;
+    int count = 0, i;
+
+    TRACE("(%p)\n", out);
+
+    if (!out) return AVIERR_BADPARAM;
+    *out = NULL;
+
+    /* this process's file: the file itself */
+    EnterCriticalSection(&clip_cs);
+    if (current_clip && OleIsCurrentClipboard(&current_clip->IDataObject_iface) == S_OK)
+    {
+        *out = current_clip->file;
+        IAVIFile_AddRef(*out);
+        LeaveCriticalSection(&clip_cs);
+        return AVIERR_OK;
+    }
+    LeaveCriticalSection(&clip_cs);
+
+    /* otherwise a file of the clipboard's picture and sound */
+    if (FAILED(hr = OleGetClipboard(&data))) return hr;
+    for (i = 0; i < ARRAY_SIZE(formats); i++)
+    {
+        FORMATETC fmt = { formats[i], NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+        STGMEDIUM medium;
+
+        if (FAILED(IDataObject_GetData(data, &fmt, &medium))) continue;
+        if (medium.tymed == TYMED_HGLOBAL && SUCCEEDED(AVIMakeStreamFromClipboard(formats[i], medium.hGlobal, &streams[count])))
+            count++;
+        ReleaseStgMedium(&medium);
+    }
+    IDataObject_Release(data);
+    if (!count) return AVIERR_NODATA;
+    hr = AVIMakeFileFromStreams(out, count, streams);
+    for (i = 0; i < count; i++) IAVIStream_Release(streams[i]);
+    return hr;
+}
+
+/***********************************************************************
+ *		AVIClearClipboard	(AVIFIL32.@)
+ */
+HRESULT WINAPI AVIClearClipboard(void)
+{
+    HRESULT hr = AVIERR_OK;
+
+    TRACE("()\n");
+
+    /* only a file this process put there */
+    EnterCriticalSection(&clip_cs);
+    if (current_clip && OleIsCurrentClipboard(&current_clip->IDataObject_iface) == S_OK)
+        hr = OleSetClipboard(NULL);
+    LeaveCriticalSection(&clip_cs);
+    return FAILED(hr) ? hr : AVIERR_OK;
+}
