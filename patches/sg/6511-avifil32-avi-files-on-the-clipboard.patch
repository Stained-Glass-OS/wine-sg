+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Stained Glass OS (wine-sg 6511): AVIPutFileOnClipboard, AVIGetFromClipboard,
+ * AVIMakeStreamFromClipboard and AVIClearClipboard were stubs (AVIERR_UNSUPPORTED), so the
+ * Edit menus of video editors built on AVIFile did nothing. A file goes on the OLE clipboard as
+ * a data object that renders its first video frame (CF_DIB) and its first audio stream (CF_WAVE)
+ * for every other program, and is the file itself for this process; clipboard DIBs and WAVEs
+ * come back as editable streams.
+ */
+
+#define COBJMACROS
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winerror.h"
+#include "ole2.h"
+#include "mmsystem.h"
+#include "vfw.h"
+
+#include "avifile_private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(avifile);
+
+/*
+ * A read-only stream of one clipboard object: a DIB (one video frame) or a WAVE (its samples).
+ */
+struct clip_stream
+{
+    IAVIStream IAVIStream_iface;
+    LONG ref;
+    AVISTREAMINFOW info;
+    void *format;
+    LONG format_size;
+    BYTE *data;
+    LONG data_size;
+};
+
+static inline struct clip_stream *impl_from_IAVIStream(IAVIStream *iface)
+{
+    return CONTAINING_RECORD(iface, struct clip_stream, IAVIStream_iface);
+}
+
+static HRESULT WINAPI clip_stream_QueryInterface(IAVIStream *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IAVIStream))
+    {
+        *out = iface;
+        IAVIStream_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI clip_stream_AddRef(IAVIStream *iface)
+{
+    return InterlockedIncrement(&impl_from_IAVIStream(iface)->ref);
+}
+
+static ULONG WINAPI clip_stream_Release(IAVIStream *iface)
+{
+    struct clip_stream *stream = impl_from_IAVIStream(iface);
+    ULONG ref = InterlockedDecrement(&stream->ref);
+
+    if (!ref)
+    {
+        free(stream->format);
+        free(stream->data);
+        free(stream);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI clip_stream_Create(IAVIStream *iface, LPARAM lParam1, LPARAM lParam2)
+{
+    return AVIERR_UNSUPPORTED;
+}
+
+static HRESULT WINAPI clip_stream_Info(IAVIStream *iface, AVISTREAMINFOW *info, LONG size)
+{
+    struct clip_stream *stream = impl_from_IAVIStream(iface);
+
+    if (!info) return AVIERR_BADPARAM;
+    if (size < 0) return AVIERR_BADSIZE;
+    memcpy(info, &stream->info, min((DWORD)size, sizeof(stream->info)));
+    return (DWORD)size < sizeof(stream->info) ? AVIERR_BUFFERTOOSMALL : AVIERR_OK;
+}
+
+static LONG WINAPI clip_stream_FindSample(IAVIStream *iface, LONG pos, LONG flags)
+{
+    struct clip_stream *stream = impl_from_IAVIStream(iface);
+    LONG length = stream->info.dwLength;
+
+    if (flags & FIND_FORMAT) return (flags & FIND_PREV) || pos <= 0 ? 0 : -1;
+    if (pos < 0 || pos >= length)
+    {
+        if ((flags & FIND_PREV) && pos >= length && length) return length - 1;
+        return -1;
+    }
+    /* every sample is a key frame */
+    return pos;
+}
+
+static HRESULT WINAPI clip_stream_ReadFormat(IAVIStream *iface, LONG pos, void *format, LONG *size)
+{
+    struct clip_stream *stream = impl_from_IAVIStream(iface);
+
+    if (!size) return AVIERR_BADPARAM;
+    if (!format)
+    {
+        *size = stream->format_size;
+        return AVIERR_OK;
+    }
+    memcpy(format, stream->format, min(*size, stream->format_size));
+    if (*size < stream->format_size)
+    {
+        *size = stream->format_size;
+        return AVIERR_BUFFERTOOSMALL;
+    }
+    *size = stream->format_size;
+    return AVIERR_OK;
+}
+
+static HRESULT WINAPI clip_stream_SetFormat(IAVIStream *iface, LONG pos, void *format, LONG size)
+{
+    return AVIERR_READONLY;
+}
+
+static HRESULT WINAPI clip_stream_Read(IAVIStream *iface, LONG start, LONG samples, void *buffer, LONG size,
+                                       LONG *bytes_read, LONG *samples_read)
+{
+    struct clip_stream *stream = impl_from_IAVIStream(iface);
+    LONG sample_size = stream->info.dwSampleSize, bytes;
+
+    if (bytes_read) *bytes_read = 0;
+    if (samples_read) *samples_read = 0;
+    if (start < 0 || (DWORD)start >= stream->info.dwLength) return AVIERR_BADPARAM;
+
+    if (!sample_size)
+    {
+        /* the one frame */
+        if (start) return AVIERR_BADPARAM;
+        bytes = stream->data_size;
+        samples = 1;
+    }
+    else
+    {
+        if (samples == AVISTREAMREAD_CONVENIENT || samples > (LONG)stream->info.dwLength - start)
+            samples = stream->info.dwLength - start;
+        if (buffer && samples * sample_size > size) samples = size / sample_size;
+        bytes = samples * sample_size;
+    }
+    if (buffer)
+    {
+        if (bytes > size) return AVIERR_BUFFERTOOSMALL;
+        memcpy(buffer, stream->data + (sample_size ? start * sample_size : 0), bytes);
+    }
+    if (bytes_read) *bytes_read = bytes;
+    if (samples_read) *samples_read = samples;
+    return AVIERR_OK;
+}
+
+static HRESULT WINAPI clip_stream_Write(IAVIStream *iface, LONG start, LONG samples, void *buffer, LONG size,
+                                        DWORD flags, LONG *samples_written, LONG *bytes_written)
+{
+    return AVIERR_READONLY;
+}
+
+static HRESULT WINAPI clip_stream_Delete(IAVIStream *iface, LONG start, LONG samples)
+{
+    return AVIERR_READONLY;
+}
+
+static HRESULT WINAPI clip_stream_ReadData(IAVIStream *iface, DWORD fcc, void *data, LONG *size)
+{
+    return AVIERR_NODATA;
+}
+
+static HRESULT WINAPI clip_stream_WriteData(IAVIStream *iface, DWORD fcc, void *data, LONG size)
+{
+    return AVIERR_READONLY;
+}
+
+static HRESULT WINAPI clip_stream_SetInfo(IAVIStream *iface, AVISTREAMINFOW *info, LONG size)
+{
+    return AVIERR_READONLY;
+}
+
+static const struct IAVIStreamVtbl clip_stream_vtbl =
+{
+    clip_stream_QueryInterface,
+    clip_stream_AddRef,
+    clip_stream_Release,
+    clip_stream_Create,
+    clip_stream_Info,
+    clip_stream_FindSample,
+    clip_stream_ReadFormat,
+    clip_stream_SetFormat,
+    clip_stream_Read,
+    clip_stream_Write,
+    clip_stream_Delete,
+    clip_stream_ReadData,
+    clip_stream_WriteData,
+    clip_stream_SetInfo,
+};
+
+static DWORD dib_colors_size(const BITMAPINFOHEADER *bih)
+{
+    DWORD colors = bih->biClrUsed;
+
+    if (!colors && bih->biBitCount <= 8) colors = 1u << bih->biBitCount;
+    if (bih->biCompression == BI_BITFIELDS && bih->biSize == sizeof(BITMAPINFOHEADER)) return 3 * sizeof(DWORD);
+    return colors * sizeof(RGBQUAD);
+}
+
+static DWORD dib_bits_size(const BITMAPINFOHEADER *bih)
+{
+    if (bih->biCompression != BI_RGB && bih->biCompression != BI_BITFIELDS && bih->biSizeImage)
+        return bih->biSizeImage;
+    return ((bih->biWidth * bih->biBitCount + 31) / 32) * 4 * abs(bih->biHeight);
+}
+
+static struct clip_stream *clip_stream_create(void)
+{
+    struct clip_stream *stream;
+
+    if (!(stream = calloc(1, sizeof(*stream)))) return NULL;
+    stream->IAVIStream_iface.lpVtbl = &clip_stream_vtbl;
+    stream->ref = 1;
+    return stream;
+}
+
+static HRESULT clip_stream_from_dib(const BYTE *mem, SIZE_T size, IAVIStream **out)
+{
+    const BITMAPINFOHEADER *bih = (const BITMAPINFOHEADER *)mem;
+    struct clip_stream *stream;
+    DWORD header, bits;
+
+    if (size < sizeof(*bih) || bih->biSize < sizeof(*bih) || bih->biSize > size || bih->biWidth <= 0 ||
+        !bih->biHeight || !bih->biBitCount)
+        return AVIERR_BADFORMAT;
+    header = bih->biSize + dib_colors_size(bih);
+    bits = dib_bits_size(bih);
+    if (header > size || bits > size - header) return AVIERR_BADFORMAT;
+
+    if (!(stream = clip_stream_create())) return AVIERR_MEMORY;
+    stream->format_size = header;
+    stream->data_size = bits;
+    if (!(stream->format = malloc(header)) || !(stream->data = malloc(max(bits, 1))))
+    {
+        IAVIStream_Release(&stream->IAVIStream_iface);
+        return AVIERR_MEMORY;
+    }
+    memcpy(stream->format, mem, header);
+    memcpy(stream->data, mem + header, bits);
+    stream->info.fccType = streamtypeVIDEO;
+    stream->info.fccHandler = mmioFOURCC('D','I','B',' ');
+    stream->info.dwScale = 1;
+    stream->info.dwRate = 15;
+    stream->info.dwLength = 1;
+    stream->info.dwSuggestedBufferSize = bits;
+    stream->info.dwQuality = (DWORD)-1;
+    SetRect(&stream->info.rcFrame, 0, 0, bih->biWidth, abs(bih->biHeight));
+    LoadStringW(AVIFILE_hModule, IDS_VIDEO, stream->info.szName, ARRAY_SIZE(stream->info.szName));
+    *out = &stream->IAVIStream_iface;
+    return AVIERR_OK;
+}
+
+static HRESULT clip_stream_from_wave(const BYTE *mem, SIZE_T size, IAVIStream **out)
+{
+    const WAVEFORMATEX *wfx = NULL;
+    const BYTE *data = NULL;
+    DWORD fmt_size = 0, data_size = 0, pos = 12, chunk;
+    struct clip_stream *stream;
+
+    if (size < 12 || memcmp(mem, "RIFF", 4) || memcmp(mem + 8, "WAVE", 4)) return AVIERR_BADFORMAT;
+    while (pos + 8 <= size)
+    {
+        chunk = *(const DWORD *)(mem + pos + 4);
+        if (chunk > size - pos - 8) chunk = size - pos - 8;
+        if (!memcmp(mem + pos, "fmt ", 4) && chunk >= sizeof(PCMWAVEFORMAT))
+        {
+            wfx = (const WAVEFORMATEX *)(mem + pos + 8);
+            fmt_size = chunk;
+        }
+        else if (!memcmp(mem + pos, "data", 4))
+        {
+            data = mem + pos + 8;
+            data_size = chunk;
+        }
+        pos += 8 + chunk + (chunk & 1);
+    }
+    if (!wfx || !data || !wfx->nBlockAlign || !wfx->nAvgBytesPerSec) return AVIERR_BADFORMAT;
+
+    if (!(stream = clip_stream_create())) return AVIERR_MEMORY;
+    stream->format_size = max(fmt_size, sizeof(WAVEFORMATEX));
+    stream->data_size = data_size - data_size % wfx->nBlockAlign;
+    if (!(stream->format = calloc(1, stream->format_size)) || !(stream->data = malloc(max(stream->data_size, 1))))
+    {
+        IAVIStream_Release(&stream->IAVIStream_iface);
+        return AVIERR_MEMORY;
+    }
+    memcpy(stream->format, wfx, fmt_size);
+    memcpy(stream->data, data, stream->data_size);
+    stream->info.fccType = streamtypeAUDIO;
+    stream->info.dwScale = wfx->nBlockAlign;
+    stream->info.dwRate = wfx->nAvgBytesPerSec;
+    stream->info.dwSampleSize = wfx->nBlockAlign;
+    stream->info.dwLength = stream->data_size / wfx->nBlockAlign;
+    stream->info.dwSuggestedBufferSize = wfx->nAvgBytesPerSec;
+    stream->info.dwQuality = (DWORD)-1;
+    LoadStringW(AVIFILE_hModule, IDS_AUDIO, stream->info.szName, ARRAY_SIZE(stream->info.szName));
+    *out = &stream->IAVIStream_iface;
+    return AVIERR_OK;
+}
+
+/***********************************************************************
+ *      AVIMakeStreamFromClipboard (AVIFIL32.@)
+ */
+HRESULT WINAPI AVIMakeStreamFromClipboard(UINT format, HANDLE global, PAVISTREAM *out)
+{
+    IAVIStream *stream = NULL;
+    const BYTE *mem;
+    SIZE_T size;
+    HRESULT hr;
+
+    TRACE("(0x%08x,%p,%p)\n", format, global, out);
+
+    if (!out) return AVIERR_BADHANDLE;
+    *out = NULL;
+    if (!global || !(size = GlobalSize(global)) || !(mem = GlobalLock(global))) return AVIERR_BADHANDLE;
+    if (format == CF_DIB) hr = clip_stream_from_dib(mem, size, &stream);
+    else if (format == CF_WAVE) hr = clip_stream_from_wave(mem, size, &stream);
+    else hr = AVIERR_UNSUPPORTED;
+    GlobalUnlock(global);
+    if (FAILED(hr)) return hr;
+
+    /* the stream is editable, as the clipboard's streams are */
+    hr = CreateEditableStream(out, stream);
+    IAVIStream_Release(stream);
+    return hr;
+}
+
+/*
+ * The clipboard object of AVIPutFileOnClipboard.
+ */
+struct clip_object
+{
+    IDataObject IDataObject_iface;
+    LONG ref;
+    IAVIFile *file;
+};
+
+static struct clip_object *current_clip; /* this process's object, while it is on the clipboard */
+static CRITICAL_SECTION clip_cs;
+static CRITICAL_SECTION_DEBUG clip_cs_debug =
+{
+    0, 0, &clip_cs,
+    { &clip_cs_debug.ProcessLocksList, &clip_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": clip_cs") }
+};
+static CRITICAL_SECTION clip_cs = { &clip_cs_debug, -1, 0, 0, 0, 0 };
+
+static inline struct clip_object *impl_from_IDataObject(IDataObject *iface)
+{
+    return CONTAINING_RECORD(iface, struct clip_object, IDataObject_iface);
+}
+
+static HRESULT WINAPI clip_object_QueryInterface(IDataObject *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDataObject))
+    {
+        IDataObject_AddRef((*out = iface));
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI clip_object_AddRef(IDataObject *iface)
+{
+    return InterlockedIncrement(&impl_from_IDataObject(iface)->ref);
+}
+
+static ULONG WINAPI clip_object_Release(IDataObject *iface)
+{
+    struct clip_object *object = impl_from_IDataObject(iface);
+    ULONG ref = InterlockedDecrement(&object->ref);
+
+    if (!ref)
+    {
+        EnterCriticalSection(&clip_cs);
+        if (current_clip == object) current_clip = NULL;
+        LeaveCriticalSection(&clip_cs);
+        IAVIFile_Release(object->file);
+        free(object);
+    }
+    return ref;
+}
+
+static IAVIStream *clip_object_stream(struct clip_object *object, DWORD type)
+{
+    IAVIStream *stream;
+
+    if (FAILED(IAVIFile_GetStream(object->file, &stream, type, 0))) return NULL;
+    return stream;
+}
+
+/* the first video frame, as a packed DIB */
+static HGLOBAL render_dib(struct clip_object *object)
+{
+    IAVIStream *stream = clip_object_stream(object, streamtypeVIDEO);
+    BITMAPINFOHEADER *bih;
+    HGLOBAL global = NULL;
+    PGETFRAME frame;
+    DWORD size;
+    BYTE *mem;
+
+    if (!stream) return NULL;
+    if ((frame = AVIStreamGetFrameOpen(stream, NULL)))
+    {
+        if ((bih = AVIStreamGetFrame(frame, AVIStreamStart(stream))))
+        {
+            size = bih->biSize + dib_colors_size(bih) + dib_bits_size(bih);
+            if ((global = GlobalAlloc(GMEM_MOVEABLE, size)) && (mem = GlobalLock(global)))
+            {
+                memcpy(mem, bih, size);
+                GlobalUnlock(global);
+            }
+        }
+        AVIStreamGetFrameClose(frame);
+    }
+    IAVIStream_Release(stream);
+    return global;
+}
+
+/* the bytes of samples start .. start + length (a stream may answer a size query for one sample) */
+static LONG stream_bytes(IAVIStream *stream, LONG start, LONG length)
+{
+    AVISTREAMINFOW info;
+    LONG bytes = 0, total = 0, samples, pos = start;
+
+    if (SUCCEEDED(AVIStreamInfoW(stream, &info, sizeof(info))) && info.dwSampleSize)
+        return length * info.dwSampleSize;
+    while (pos < start + length)
+    {
+        if (FAILED(AVIStreamRead(stream, pos, start + length - pos, NULL, 0, &bytes, &samples)) || samples <= 0)
+            return -1;
+        total += bytes;
+        pos += samples;
+    }
+    return total;
+}
+
+static void read_all(IAVIStream *stream, LONG start, LONG length, BYTE *buffer, LONG size)
+{
+    LONG bytes, samples, pos = start, done = 0;
+
+    while (pos < start + length && done < size)
+    {
+        if (FAILED(AVIStreamRead(stream, pos, start + length - pos, buffer + done, size - done, &bytes, &samples)) ||
+            samples <= 0)
+            break;
+        done += bytes;
+        pos += samples;
+    }
+}
+
+/* the first audio stream, as a RIFF/WAVE file */
+static HGLOBAL render_wave(struct clip_object *object)
+{
+    IAVIStream *stream = clip_object_stream(object, streamtypeAUDIO);
+    LONG format_size = 0, bytes = 0, start, length;
+    HGLOBAL global = NULL;
+    BYTE *mem;
+    DWORD v;
+
+    if (!stream) return NULL;
+    start = AVIStreamStart(stream);
+    length = AVIStreamLength(stream);
+    if (SUCCEEDED(AVIStreamReadFormat(stream, start, NULL, &format_size)) && format_size > 0 &&
+        (bytes = stream_bytes(stream, start, length)) >= 0 &&
+        (global = GlobalAlloc(GMEM_MOVEABLE | GMEM_ZEROINIT, 20 + format_size + (format_size & 1) + 8 + bytes)))
+    {
+        mem = GlobalLock(global);
+        memcpy(mem, "RIFF", 4);
+        v = 4 + 8 + format_size + (format_size & 1) + 8 + bytes;
+        memcpy(mem + 4, &v, 4);
+        memcpy(mem + 8, "WAVEfmt ", 8);
+        memcpy(mem + 16, &format_size, 4);
+        AVIStreamReadFormat(stream, start, mem + 20, &format_size);
+        mem += 20 + format_size + (format_size & 1);
+        memcpy(mem, "data", 4);
+        memcpy(mem + 4, &bytes, 4);
+        read_all(stream, start, length, mem + 8, bytes);
+        GlobalUnlock(global);
+    }
+    IAVIStream_Release(stream);
+    return global;
+}
+
+static BOOL clip_object_has(struct clip_object *object, CLIPFORMAT format)
+{
+    IAVIStream *stream;
+
+    if (format != CF_DIB && format != CF_WAVE) return FALSE;
+    if (!(stream = clip_object_stream(object, format == CF_DIB ? streamtypeVIDEO : streamtypeAUDIO))) return FALSE;
+    IAVIStream_Release(stream);
+    return TRUE;
+}
+
+static HRESULT WINAPI clip_object_GetData(IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium)
+{
+    struct clip_object *object = impl_from_IDataObject(iface);
+    HGLOBAL global;
+
+    TRACE("(%p, %p {%#x %#lx}, %p)\n", iface, fmt, fmt ? fmt->cfFormat : 0, fmt ? fmt->tymed : 0, medium);
+
+    if (!fmt || !medium) return E_INVALIDARG;
+    if (!(fmt->tymed & TYMED_HGLOBAL) || fmt->dwAspect != DVASPECT_CONTENT) return DV_E_TYMED;
+    if (!clip_object_has(object, fmt->cfFormat)) return DV_E_FORMATETC;
+#ifdef SG_MUTANT_AVICLIP_NO_RENDER
+    return DV_E_FORMATETC;
+#endif
+    global = fmt->cfFormat == CF_DIB ? render_dib(object) : render_wave(object);
+    if (!global) return E_OUTOFMEMORY;
+    medium->tymed = TYMED_HGLOBAL;
+    medium->hGlobal = global;
+    medium->pUnkForRelease = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI clip_object_GetDataHere(IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI clip_object_QueryGetData(IDataObject *iface, FORMATETC *fmt)
+{
+    struct clip_object *object = impl_from_IDataObject(iface);
+
+    if (!fmt) return E_INVALIDARG;
+    if (!(fmt->tymed & TYMED_HGLOBAL)) return DV_E_TYMED;
+    return clip_object_has(object, fmt->cfFormat) ? S_OK : DV_E_FORMATETC;
+}
