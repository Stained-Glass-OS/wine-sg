+struct format_enum
+{
+    IEnumFORMATETC IEnumFORMATETC_iface;
+    LONG ref;
+    UINT count, pos;
+    FORMATETC formats[2];
+};
+
+static inline struct format_enum *impl_from_IEnumFORMATETC(IEnumFORMATETC *iface)
+{
+    return CONTAINING_RECORD(iface, struct format_enum, IEnumFORMATETC_iface);
+}
+
+static HRESULT WINAPI format_enum_QueryInterface(IEnumFORMATETC *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IEnumFORMATETC))
+    {
+        IEnumFORMATETC_AddRef((*out = iface));
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI format_enum_AddRef(IEnumFORMATETC *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumFORMATETC(iface)->ref);
+}
+
+static ULONG WINAPI format_enum_Release(IEnumFORMATETC *iface)
+{
+    struct format_enum *e = impl_from_IEnumFORMATETC(iface);
+    ULONG ref = InterlockedDecrement(&e->ref);
+
+    if (!ref) free(e);
+    return ref;
+}
+
+static HRESULT WINAPI format_enum_Next(IEnumFORMATETC *iface, ULONG count, FORMATETC *out, ULONG *fetched)
+{
+    struct format_enum *e = impl_from_IEnumFORMATETC(iface);
+    ULONG n = 0;
+
+    if (!out || (count > 1 && !fetched)) return E_INVALIDARG;
+    while (n < count && e->pos < e->count) out[n++] = e->formats[e->pos++];
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI format_enum_Skip(IEnumFORMATETC *iface, ULONG count)
+{
+    struct format_enum *e = impl_from_IEnumFORMATETC(iface);
+
+    e->pos = min(e->count, e->pos + count);
+    return e->pos == e->count ? S_FALSE : S_OK;
+}
+
+static HRESULT WINAPI format_enum_Reset(IEnumFORMATETC *iface)
+{
+    impl_from_IEnumFORMATETC(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT format_enum_create(const FORMATETC *formats, UINT count, UINT pos, IEnumFORMATETC **out);
+
+static HRESULT WINAPI format_enum_Clone(IEnumFORMATETC *iface, IEnumFORMATETC **out)
+{
+    struct format_enum *e = impl_from_IEnumFORMATETC(iface);
+    return format_enum_create(e->formats, e->count, e->pos, out);
+}
+
+static const struct IEnumFORMATETCVtbl format_enum_vtbl =
+{
+    format_enum_QueryInterface,
+    format_enum_AddRef,
+    format_enum_Release,
+    format_enum_Next,
+    format_enum_Skip,
+    format_enum_Reset,
+    format_enum_Clone,
+};
+
+static HRESULT format_enum_create(const FORMATETC *formats, UINT count, UINT pos, IEnumFORMATETC **out)
+{
+    struct format_enum *e;
+
+    *out = NULL;
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
+    e->IEnumFORMATETC_iface.lpVtbl = &format_enum_vtbl;
+    e->ref = 1;
+    e->count = min(count, ARRAY_SIZE(e->formats));
+    e->pos = pos;
+    memcpy(e->formats, formats, e->count * sizeof(*formats));
+    *out = &e->IEnumFORMATETC_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI clip_object_EnumFormatEtc(IDataObject *iface, DWORD direction, IEnumFORMATETC **out)
+{
+    struct clip_object *object = impl_from_IDataObject(iface);
+    FORMATETC formats[2];
+    UINT count = 0;
+
+    if (direction != DATADIR_GET) return E_NOTIMPL;
+    if (clip_object_has(object, CF_DIB))
+    {
+        formats[count].cfFormat = CF_DIB;
+        formats[count].ptd = NULL;
+        formats[count].dwAspect = DVASPECT_CONTENT;
+        formats[count].lindex = -1;
+        formats[count++].tymed = TYMED_HGLOBAL;
+    }
+    if (clip_object_has(object, CF_WAVE))
+    {
+        formats[count].cfFormat = CF_WAVE;
+        formats[count].ptd = NULL;
+        formats[count].dwAspect = DVASPECT_CONTENT;
+        formats[count].lindex = -1;
+        formats[count++].tymed = TYMED_HGLOBAL;
+    }
+    return format_enum_create(formats, count, 0, out);
+}
+
