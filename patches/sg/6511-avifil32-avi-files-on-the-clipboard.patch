+static const struct IDataObjectVtbl clip_object_vtbl =
+{
+    clip_object_QueryInterface,
+    clip_object_AddRef,
+    clip_object_Release,
+    clip_object_GetData,
+    clip_object_GetDataHere,
+    clip_object_QueryGetData,
+    clip_object_GetCanonicalFormatEtc,
+    clip_object_SetData,
