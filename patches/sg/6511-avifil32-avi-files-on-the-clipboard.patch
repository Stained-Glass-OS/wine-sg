diff --git a/dlls/avifil32/clipboard.c b/dlls/avifil32/clipboard.c
new file mode 100644
index 0000000..f927a35
--- /dev/null
+++ b/dlls/avifil32/clipboard.c
@@ -0,0 +1,824 @@
