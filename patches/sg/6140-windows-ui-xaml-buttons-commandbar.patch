+static HRESULT commands_added( void *owner, IInspectable *item )
+{
+    struct uielem *child = uielem_from_inspectable( item );
+    struct button *bar = owner;
+
+    if (!child || (child->parent && (!bar || child->parent != &bar->c.e))) return E_INVALIDARG;
+    if (bar) uielem_add_child( &bar->c.e, child );
+    return S_OK;
+}
+
+static void commands_removed( void *owner, IInspectable *item )
+{
+    struct uielem *child = uielem_from_inspectable( item );
+    struct button *bar = owner;
+
+    if (bar && child) uielem_remove_child( &bar->c.e, child );
+}
+
+static void commands_changed( void *owner )
+{
+    struct button *bar = owner;
+    if (bar) uielem_invalidate_measure( &bar->c.e );
+}
