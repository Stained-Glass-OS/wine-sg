+static void button_destroy( struct xobj *obj )
+{
+    struct button *button = CONTAINING_RECORD( obj, struct button, c.e.d.obj );
+
+    set_part( button, &button->label, NULL );
+    set_part( button, &button->icon, NULL );
+    if (button->primary) xvector_detach( button->primary );
+    if (button->secondary) xvector_detach( button->secondary );
+    if (button->glyph) IUnknown_Release( button->glyph );
+    handlers_clear( &button->click );
+    handlers_clear( &button->opened );
+    handlers_clear( &button->closed );
+    control_cleanup( &button->c );
