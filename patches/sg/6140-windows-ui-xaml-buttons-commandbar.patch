+/* ---- the properties' changes ---- */
+
+static void set_part( struct button *button, struct uielem **part, struct uielem *elem )
+{
+    if (*part == elem) return;
+    if (*part)
+    {
+        uielem_remove_child( &button->c.e, *part );
+    }
+    *part = elem;
+    if (elem) uielem_add_child( &button->c.e, elem );
+}
+
+static void label_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct button *button = button_from_elem( CONTAINING_RECORD( obj, struct uielem, d ) );
+    WCHAR *str = xunbox_string( new_value );
+    IInspectable *text = (str && *str) ? xaml_text_block( str ) : NULL;
+    struct uielem *elem = text ? uielem_from_inspectable( text ) : NULL;
+
+    free( str );
+    if (button->kind != APP_BAR_BUTTON) return;
+    set_part( button, &button->label, elem );
+    if (elem) xaml_text_set_size( elem, 12 );
+    if (text) IInspectable_Release( text );   /* the button holds it as its child */
+    uielem_invalidate_measure( &button->c.e );
+}
+
+static void icon_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct button *button = button_from_elem( CONTAINING_RECORD( obj, struct uielem, d ) );
+    struct uielem *elem = uielem_from_inspectable( new_value );
+    INT32 symbol;
+    WCHAR *str;
+
+    if (button->kind != APP_BAR_BUTTON) return;
+#ifdef SG_MUTANT_BUTTON_NO_ICON
+    return;
+#endif
+    if (!elem && (str = xunbox_string( new_value )))
+    {
+        /* Icon="Add": a SymbolIcon */
+        if (xaml_symbol_value( str, &symbol ))
+        {
+            /* the property holds the SymbolIcon made for it (this change function runs again) */
+            IInspectable *icon = xaml_symbol_icon( symbol );
+            free( str );
+            if (icon)
+            {
+                dobj_set_value( obj, prop_icon, icon );
+                IInspectable_Release( icon );
+            }
+            return;
+        }
+        free( str );
+    }
+    set_part( button, &button->icon, elem );
+    uielem_invalidate_measure( &button->c.e );
+}
+
+static void symbol_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    uielem_invalidate_measure( CONTAINING_RECORD( obj, struct uielem, d ) );
+}
