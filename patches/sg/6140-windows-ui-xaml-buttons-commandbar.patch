+/* the theme it is drawn in: its own RequestedTheme or its parents', else the system's */
+static HRESULT WINAPI fe6_get_ActualTheme( struct xiface *iface, INT32 *value )
+{
+    struct uielem *elem;
+    IInspectable *box;
+    INT32 theme;
+
+    if (!value) return E_POINTER;
+    for (elem = elem_from_iface( iface ); elem; elem = elem->parent)
+    {
+        box = NULL;
+        dobj_get_value( &elem->d, prop_requested_theme, &box );
+        theme = xunbox_enum( box, &IID_IReference_ElementTheme, 0 );
+        if (box) IInspectable_Release( box );
+        if (theme) { *value = theme; return S_OK; }
+    }
+    *value = system_app_theme() ? 2 : 1;   /* ElementTheme Dark : Light */
+    return S_OK;
+}
