+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Buttons and command bars look like the desktop's own (its look's system colours), not like
+ * Microsoft's templates: a Button is a face with a border and its content; an AppBarButton an icon
+ * and its label; a CommandBar a row of them.  Symbols are drawn from the symbol font when it is
+ * installed, else as standard Unicode characters of the same meaning.  Click is raised by input
+ * (input.c).
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include "private.h"
+#include "symbols.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+const GUID IID_IRoutedEventArgs_x = { 0x5c985ac6, 0xd802, 0x4b38, { 0xa2, 0x23, 0xbf, 0x07, 0x0c, 0x43, 0xfe, 0xdf } };
+static const GUID IID_ICommand_x = { 0xe5af3542, 0xca67, 0x4081, { 0x99, 0x5b, 0x70, 0x9d, 0xd1, 0x37, 0x92, 0xdf } };
+static const GUID IID_IReference_Symbol = { 0xc3c5bea8, 0x6d48, 0x54e6, { 0x8a, 0xa9, 0x43, 0x46, 0xb3, 0xf0, 0x43, 0xe9 } };
+static const GUID IID_IReference_DefaultLabelPosition = { 0xa0a829b6, 0x4bff, 0x5021, { 0x9a, 0x65, 0x08, 0x47, 0x73, 0x20, 0x4c, 0x7f } };
+static const GUID IID_IReference_ClickMode = { 0x12c74f9c, 0xed2a, 0x5db3, { 0xa6, 0xca, 0x3e, 0x7c, 0xbf, 0x29, 0x77, 0x2a } };
+static const GUID IID_IVector_CommandBarElement = { 0x18ad7c66, 0xa127, 0x550f, { 0x83, 0x25, 0x8c, 0xf1, 0x78, 0x91, 0x76, 0xc1 } };
+static const GUID IID_IVectorView_CommandBarElement = { 0xa38e89ec, 0xf1a4, 0x5d7b, { 0x97, 0xc3, 0x8a, 0xef, 0xb6, 0x4a, 0x5f, 0x43 } };
+static const GUID IID_IIterable_CommandBarElement = { 0xd4c5a8e7, 0x0d5e, 0x5922, { 0xa7, 0xb4, 0x59, 0xb5, 0xe6, 0x34, 0xd3, 0x35 } };
+static const GUID IID_IIterator_CommandBarElement = { 0xcddb0380, 0xe9d7, 0x5264, { 0xab, 0x5c, 0xd7, 0x2b, 0x64, 0x28, 0x74, 0xc9 } };
+
+enum button_kind { BUTTON_BASE, BUTTON, APP_BAR_BUTTON, APP_BAR_SEPARATOR, APP_BAR, COMMAND_BAR, SYMBOL_ICON };
+
+struct button
+{
+    struct control c;
+    struct xiface IButtonBase_iface, IButton_iface, IButtonWithFlyout_iface;
+    struct xiface IAppBarButton_iface, ICommandBarElement_iface;
+    struct xiface IAppBarSeparator_iface;
+    struct xiface IAppBar_iface, ICommandBar_iface, ICommandBar3_iface;
+    struct xiface IIconElement_iface, ISymbolIcon_iface;
+    enum button_kind kind;
+    struct handler_list click, opened, closed;
+    BOOL pointer_over, pressed;
+    struct uielem *label;           /* an AppBarButton's label (a TextBlock of ours) */
+    struct uielem *icon;            /* an AppBarButton's icon */
+    struct xvector *primary, *secondary;
+    IUnknown *glyph;                /* a SymbolIcon's laid out glyph */
+};
+
+static struct xaml_property *prop_click_mode, *prop_command, *prop_command_parameter, *prop_flyout;
+static struct xaml_property *prop_label, *prop_icon, *prop_is_compact, *prop_label_position;
+static struct xaml_property *prop_is_open, *prop_is_sticky, *prop_default_label_position, *prop_dynamic_overflow,
+                            *prop_overflow_visibility;
+static struct xaml_property *prop_icon_foreground, *prop_symbol;
+static struct xaml_property *prop_automation_name, *prop_automation_id, *prop_help_text, *prop_tooltip;
+
+static struct button *button_from_elem( struct uielem *elem )
+{
+    return CONTAINING_RECORD( elem, struct button, c.e );
+}
+
+static struct button *button_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct button, c.e.d.obj );
+}
+
+static HRESULT put_boxed( struct dobj *obj, struct xaml_property *prop, IInspectable *box )
+{
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( obj, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static INT32 get_enum( struct dobj *obj, struct xaml_property *prop, const GUID *iid, INT32 def )
+{
+    IInspectable *box = NULL;
+    INT32 ret;
+
+    dobj_get_value( obj, prop, &box );
+    ret = xunbox_enum( box, iid, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static boolean get_bool( struct dobj *obj, struct xaml_property *prop, boolean def )
+{
+    IInspectable *box = NULL;
+    boolean ret;
+
+    dobj_get_value( obj, prop, &box );
+    ret = xunbox_boolean( box, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static void layout_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    uielem_invalidate_measure( CONTAINING_RECORD( obj, struct uielem, d ) );
+}
+
+/* ---- symbols ---- */
+
+BOOL xaml_symbol_value( const WCHAR *name, INT32 *value )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(symbols); i++)
+        if (!wcsicmp( symbols[i].name, name )) { *value = symbols[i].value; return TRUE; }
+    return FALSE;
+}
+
+UINT32 xaml_symbol_fallback( UINT32 code )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(symbols); i++) if (symbols[i].value == code) return symbols[i].fallback;
+    return 0;
+}
+
+/* the font symbols are drawn with: the symbol font, else one with the standard characters standing in */
+const WCHAR *xaml_symbol_font(void)
+{
+    if (xaml_font_installed( L"Segoe MDL2 Assets" )) return L"Segoe MDL2 Assets";
+    if (xaml_font_installed( L"DejaVu Sans" )) return L"DejaVu Sans";
+    return NULL;
+}
+
+/* ---- RoutedEventArgs ---- */
+
+struct routed_args
+{
+    struct xobj obj;
+    struct xiface IRoutedEventArgs_iface;
+    IInspectable *source;
+};
+
+static const struct xiface_entry routed_args_ifaces[] =
+{
+    { &IID_IRoutedEventArgs_x, offsetof(struct routed_args, IRoutedEventArgs_iface) },
+};
+
+static void routed_args_destroy( struct xobj *obj )
+{
+    struct routed_args *args = CONTAINING_RECORD( obj, struct routed_args, obj );
+    if (args->source) IInspectable_Release( args->source );
+}
+
+static const struct xclass routed_args_class =
+{
+    L"Windows.UI.Xaml.RoutedEventArgs", routed_args_ifaces, ARRAY_SIZE(routed_args_ifaces), routed_args_destroy,
+};
+
+static HRESULT WINAPI routed_args_get_OriginalSource( struct xiface *iface, IInspectable **value )
+{
+    struct routed_args *args = CONTAINING_RECORD( iface->obj, struct routed_args, obj );
+
+    if (!value) return E_POINTER;
+    if ((*value = args->source)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static const void *routed_args_vtbl[] = { XIFACE_COMMON, routed_args_get_OriginalSource };
+
+IInspectable *xaml_routed_args( IInspectable *source )
+{
+    struct routed_args *args = calloc( 1, sizeof(*args) );
+
+    if (!args) return NULL;
+    args->IRoutedEventArgs_iface.vtbl = routed_args_vtbl;
+    if ((args->source = source)) IInspectable_AddRef( source );
+    xobj_init( &args->obj, &routed_args_class, NULL );
+    return (IInspectable *)&args->IRoutedEventArgs_iface;
+}
+
+/* a RoutedEventHandler(sender, args) of each handler */
+void xaml_raise_routed( struct handler_list *list, IInspectable *sender, IInspectable *args )
+{
+    struct handler_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &list->entries, struct handler_entry, entry )
+    {
+        IUnknown *handler = entry->handler;
+        IUnknown_AddRef( handler );
+        ((HRESULT (WINAPI *)( IUnknown *, IInspectable *, IInspectable * ))((void **)handler->lpVtbl)[3])( handler, sender, args );
+        IUnknown_Release( handler );
+    }
+}
+
+/* a ButtonBase clicked: its Click handlers, then its Command */
+void xaml_button_click( struct uielem *elem )
+{
+    struct button *button;
+    IInspectable *sender = NULL, *args, *command = NULL, *param = NULL, *cmd;
+
+    if (!elem->d.obj.cls || !xaml_is_button( elem )) return;
+    button = button_from_elem( elem );
+    IUnknown_QueryInterface( elem->d.obj.outer, &IID_IInspectable, (void **)&sender );
+    if ((args = xaml_routed_args( sender )))
+    {
+        TRACE( "%p clicked\n", button );
+        xaml_raise_routed( &button->click, sender, args );
+        IInspectable_Release( args );
+    }
+    dobj_get_value( &elem->d, prop_command, &command );
+    if (command && SUCCEEDED(IInspectable_QueryInterface( command, &IID_ICommand_x, (void **)&cmd )))
+    {
+        boolean can = TRUE;
+        dobj_get_value( &elem->d, prop_command_parameter, &param );
+        ((HRESULT (WINAPI *)( IInspectable *, IInspectable *, boolean * ))((void **)cmd->lpVtbl)[8])( cmd, param, &can );
+        if (can) ((HRESULT (WINAPI *)( IInspectable *, IInspectable * ))((void **)cmd->lpVtbl)[9])( cmd, param );
+        IInspectable_Release( cmd );
+        if (param) IInspectable_Release( param );
+    }
+    if (command) IInspectable_Release( command );
+    if (sender) IInspectable_Release( sender );
+}
+
+BOOL xaml_is_button( struct uielem *elem )
+{
+    const struct xclass *cls = elem->d.obj.cls;
+    unsigned int i;
+
+    for (i = 0; i < cls->count; i++) if (cls->ifaces[i].iid == &IID_IButtonBase) return TRUE;
+    return FALSE;
+}
+
+void xaml_button_state( struct uielem *elem, BOOL over, BOOL pressed )
+{
+    struct button *button;
+
+    if (!xaml_is_button( elem )) return;
+    button = button_from_elem( elem );
+    if (button->pointer_over == over && button->pressed == pressed) return;
+    button->pointer_over = over;
+    button->pressed = pressed;
+    xaml_invalidate_visuals();
+}
+
+/* ---- looks ---- */
+
+static struct xcolor shade( struct xcolor c, int delta )
+{
+    c.r = max( 0, min( 255, c.r + delta ) );
+    c.g = max( 0, min( 255, c.g + delta ) );
+    c.b = max( 0, min( 255, c.b + delta ) );
+    return c;
+}
+
+/* a pressed or hovered face: darker on light faces, lighter on dark ones */
+static struct xcolor face( struct xcolor c, BOOL over, BOOL pressed )
+{
+    int light = (c.r * 299 + c.g * 587 + c.b * 114) / 1000 > 128;
+    if (pressed) return shade( c, light ? -40 : 40 );
+    if (over) return shade( c, light ? -20 : 20 );
+    return c;
+}
+
+static void button_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct button *button = button_from_elem( elem );
+    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
+    struct xthickness one = { 1, 1, 1, 1 };
+    struct xcolor color;
+    BOOL has_background = control_brush( &button->c, FALSE, &color );
+
+    if (button->kind == APP_BAR_BUTTON)
+    {
+        /* flat until the pointer is over it */
+        if (!has_background) color.a = 0;
+        if (button->pointer_over || button->pressed)
+        {
+            color = face( xaml_theme_color( XTHEME_CONTROL ), TRUE, button->pressed );
+            color.a = 255;
+        }
+        xdraw_fill( draw, &rect, color, NULL );
+        return;
+    }
+    if (!has_background) color = xaml_theme_color( XTHEME_CONTROL );
+    xdraw_fill( draw, &rect, face( color, button->pointer_over, button->pressed ), NULL );
+    xdraw_border( draw, &rect, &one, xaml_theme_color( XTHEME_BORDER ), NULL );
+}
+
+static const struct elem_ops button_ops = { control_measure, control_arrange, button_render };
+
+/* AppBarButton: its icon, its label under it unless labels are collapsed */
+static BOOL labels_shown( struct button *button )
+{
+    struct uielem *e;
+
+    if (get_enum( &button->c.e.d, prop_label_position, NULL, 0 ) == 1) return FALSE;   /* Collapsed */
+    for (e = button->c.e.parent; e; e = e->parent)
+    {
+        if (!xaml_is_command_bar( e )) continue;
+        return get_enum( &e->d, prop_default_label_position, &IID_IReference_DefaultLabelPosition, 0 ) != 2;
+    }
+    return TRUE;
+}
+
+/* its icon, or its content shown in the icon's place */
+static struct uielem *app_bar_button_icon( struct button *button )
+{
+    return button->icon ? button->icon : button->c.child;
+}
+
+static void app_bar_button_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct button *button = button_from_elem( elem );
+    struct xsize any = { INFINITY, INFINITY };
+    struct uielem *icon = app_bar_button_icon( button );
+
+    desired->width = 40;
+    desired->height = 40;
+    if (icon)
+    {
+        uielem_measure( icon, any );
+        desired->width = fmax( desired->width, icon->desired.width + 20 );
+    }
+    if (button->label)
+    {
+        if (labels_shown( button ))
+        {
+            uielem_measure( button->label, any );
+            desired->width = fmax( desired->width, button->label->desired.width + 8 );
+            desired->height = 40 + button->label->desired.height;
+        }
+        else uielem_measure( button->label, any );
+    }
+}
+
+static void app_bar_button_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct button *button = button_from_elem( elem );
+    struct uielem *icon = app_bar_button_icon( button );
+    BOOL shown = labels_shown( button );
+    struct xrect rect;
+
+    *used = final;
+    if (icon)
+    {
+        rect.width = icon->desired.width;
+        rect.height = icon->desired.height;
+        rect.x = (final.width - rect.width) / 2;
+        rect.y = shown ? 10 : (final.height - rect.height) / 2;
+        uielem_arrange( icon, rect );
+    }
+    if (button->label)
+    {
+        if (shown)
+        {
+            rect.width = fmin( button->label->desired.width, final.width );
+            rect.height = button->label->desired.height;
+            rect.x = (final.width - rect.width) / 2;
+            rect.y = 36;
+        }
+        else rect.x = rect.y = rect.width = rect.height = 0;
+        button->label->visibility = shown ? XVISIBLE : XCOLLAPSED;
+        uielem_arrange( button->label, rect );
+    }
+}
+
+static const struct elem_ops app_bar_button_ops = { app_bar_button_measure, app_bar_button_arrange, button_render };
+
+static void separator_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    desired->width = 9;
+    desired->height = 40;
+}
+
+static void separator_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct xrect line = { 4, 8, 1, fmax( 0, elem->render.height - 16 ) };
+    xdraw_fill( draw, &line, xaml_theme_color( XTHEME_BORDER ), NULL );
+}
+
+static const struct elem_ops separator_ops = { separator_measure, NULL, separator_render };
+
+/* CommandBar: its primary commands in a row */
+static void command_bar_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct button *bar = button_from_elem( elem );
+    struct xsize any = { INFINITY, INFINITY };
+    UINT32 i;
+
+    desired->width = 0;
+    desired->height = 40;
+    for (i = 0; i < xvector_size( bar->primary ); i++)
+    {
+        struct uielem *item = uielem_from_inspectable( xvector_item( bar->primary, i ) );
+        if (!item || item->visibility == XCOLLAPSED) continue;
+        uielem_measure( item, any );
+        desired->width += item->desired.width;
+        desired->height = fmax( desired->height, item->desired.height );
+    }
+}
+
+static void command_bar_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct button *bar = button_from_elem( elem );
+    DOUBLE x = 0;
+    UINT32 i;
+
+    *used = final;
+    for (i = 0; i < xvector_size( bar->primary ); i++)
+    {
+        struct uielem *item = uielem_from_inspectable( xvector_item( bar->primary, i ) );
+        struct xrect rect;
+        if (!item) continue;
+        rect.x = x;
+        rect.y = 0;
+        rect.width = item->desired.width;
+        rect.height = final.height;
+        uielem_arrange( item, rect );
+        x += rect.width;
+    }
+}
+
+static void command_bar_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct button *bar = button_from_elem( elem );
+    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
+    struct xcolor color;
+
+    if (!control_brush( &bar->c, FALSE, &color )) color = xaml_theme_color( XTHEME_CONTROL );
+    xdraw_fill( draw, &rect, color, NULL );
+}
+
+static const struct elem_ops command_bar_ops = { command_bar_measure, command_bar_arrange, command_bar_render };
+
+BOOL xaml_is_command_bar( struct uielem *elem )
+{
+    const struct xclass *cls = elem->d.obj.cls;
+    unsigned int i;
+
+    for (i = 0; i < cls->count; i++) if (cls->ifaces[i].iid == &IID_ICommandBar) return TRUE;
+    return FALSE;
+}
+
+/* SymbolIcon: its glyph, from the symbol font, else its standard character, in its Foreground */
+static void glyph_text( INT32 symbol, WCHAR *text )
+{
+    UINT32 code = symbol, fallback;
+
+    if (!xaml_font_installed( L"Segoe MDL2 Assets" ) && (fallback = xaml_symbol_fallback( code ))) code = fallback;
+    if (code >= 0x10000)
+    {
+        text[0] = 0xd800 | ((code - 0x10000) >> 10);
+        text[1] = 0xdc00 | ((code - 0x10000) & 0x3ff);
+        text[2] = 0;
+    }
+    else { text[0] = code; text[1] = 0; }
+}
+
+static void symbol_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct button *icon = button_from_elem( elem );
+    WCHAR text[3];
+
+    if (icon->glyph) IUnknown_Release( icon->glyph );
+    glyph_text( get_enum( &elem->d, prop_symbol, &IID_IReference_Symbol, 0xe109 ), text );
+    icon->glyph = xaml_make_text_layout( text, xaml_symbol_font(), 20, 400, desired );
+    desired->width = fmax( desired->width, 20 );
+    desired->height = fmax( desired->height, 20 );
+}
+
+static void symbol_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct button *icon = button_from_elem( elem );
+    IInspectable *brush = NULL;
+    struct xcolor color;
+    struct xsize size;
+
+    if (!icon->glyph) return;
+    dobj_get_value( &elem->d, prop_icon_foreground, &brush );
+    if (!brush || !xaml_brush_color( brush, &color ))
+    {
+        IInspectable *inherited = xaml_control_inherited( elem, XINHERIT_FOREGROUND );
+        if (!inherited || !xaml_brush_color( inherited, &color )) color = xaml_theme_color( XTHEME_CONTROL_TEXT );
+        if (inherited) IInspectable_Release( inherited );
+    }
+    if (brush) IInspectable_Release( brush );
+    xaml_text_layout_size( icon->glyph, &size );
+    xdraw_text( draw, icon->glyph, (elem->render.width - size.width) / 2, (elem->render.height - size.height) / 2, color );
+}
+
+static const struct elem_ops symbol_ops = { symbol_measure, NULL, symbol_render };
