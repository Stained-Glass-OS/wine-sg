+#define COMPOSABLE(name, kind, field) \
+static HRESULT WINAPI name( struct xfiface *iface, IInspectable *outer, IInspectable **inner, void **value ) \
+{ \
+    struct button *button; \
+    if (!value) return E_POINTER; \
+    if (outer && !inner) return E_INVALIDARG; \
+    if (!(button = new_button( kind, outer ))) return E_OUTOFMEMORY; \
+    if (outer) \
+    { \
+        *inner = &button->c.e.d.obj.IInspectable_inner; \
+        IUnknown_AddRef( button->c.e.d.obj.outer ); \
+    } \
+    *value = &button->field; \
+    return S_OK; \
+}
