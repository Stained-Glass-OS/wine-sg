+
+static struct button *new_button( enum button_kind kind, IInspectable *outer )
+{
+    static const struct { const struct xclass *cls; const struct elem_ops *ops; } kinds[] =
+    {
+        [BUTTON_BASE] = { &button_base_class, &button_ops },
+        [BUTTON] = { &button_class, &button_ops },
+        [APP_BAR_BUTTON] = { &app_bar_button_class, &app_bar_button_ops },
+        [APP_BAR_SEPARATOR] = { &separator_class, &separator_ops },
+        [APP_BAR] = { &app_bar_class, &command_bar_ops },
+        [COMMAND_BAR] = { &command_bar_class, &command_bar_ops },
+    };
+    struct button *button;
+
+    buttons_init();
+    if (!(button = calloc( 1, sizeof(*button) ))) return NULL;
+    button->kind = kind;
+    button->IButtonBase_iface.vtbl = base_vtbl;
+    button->IButton_iface.vtbl = button_vtbl;
+    button->IButtonWithFlyout_iface.vtbl = with_flyout_vtbl;
+    button->IAppBarButton_iface.vtbl = app_bar_button_vtbl;
+    button->ICommandBarElement_iface.vtbl = command_bar_element_vtbl;
+    button->IAppBarSeparator_iface.vtbl = separator_vtbl;
+    button->IAppBar_iface.vtbl = app_bar_vtbl;
+    button->ICommandBar_iface.vtbl = command_bar_vtbl;
+    button->ICommandBar3_iface.vtbl = command_bar3_vtbl;
+    button->IIconElement_iface.vtbl = icon_vtbl;
+    button->ISymbolIcon_iface.vtbl = symbol_vtbl;
+    handlers_init( &button->click );
+    handlers_init( &button->opened );
+    handlers_init( &button->closed );
+    if (kind == SYMBOL_ICON)
+    {
+        uielem_init( &button->c.e, &symbol_class, &symbol_ops, outer );
+        return button;
+    }
+    if (kind == COMMAND_BAR)
+    {
+        xvector_create( &commands_type, button, &button->primary );
+        xvector_create( &secondary_type, button, &button->secondary );
+    }
+    control_init( &button->c, KIND_OTHER, kinds[kind].cls, kinds[kind].ops, outer );
+    if (kind == BUTTON)
+    {
+        /* the desktop's button: its face, a little padding, its text centred */
+        struct xthickness padding = { 8, 4, 8, 4 };
+        IInspectable *box = xbox_ref( &IID_IReference_Thickness, &padding, sizeof(padding) );
+        if (box) xaml_control_set( &button->c, L"Padding", box );
+        if (box) IInspectable_Release( box );
+    }
+    return button;
+}
+
+IInspectable *xaml_symbol_icon( INT32 symbol )
+{
+    struct button *icon = new_button( SYMBOL_ICON, NULL );
+
+    if (!icon) return NULL;
+    put_boxed( &icon->c.e.d, prop_symbol, xbox_ref( &IID_IReference_Symbol, &symbol, sizeof(symbol) ) );
+    return (IInspectable *)&icon->ISymbolIcon_iface;
+}
