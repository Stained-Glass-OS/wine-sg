diff --git a/dlls/windows.ui.xaml/make_symbols.py b/dlls/windows.ui.xaml/make_symbols.py
new file mode 100644
index 0000000..e8a6ed8
--- /dev/null
+++ b/dlls/windows.ui.xaml/make_symbols.py
@@ -0,0 +1,11 @@
+#!/usr/bin/env python3
+# Stained Glass OS: generates symbols.h from symbols.txt -- Symbol names, their code points, and the
+# standard characters drawn in their place when the symbol font is missing.
+#   make_symbols.py symbols.txt symbols.h
+import sys
+rows = [l.split() for l in open(sys.argv[1]) if l.strip() and not l.startswith('#')]
+out = ['/* generated by make_symbols.py from symbols.txt -- do not edit */', '',
+       'static const struct { const WCHAR *name; UINT32 value; UINT32 fallback; } symbols[] =', '{']
+out += ['    { L"%s", 0x%x, 0x%s },' % (n, int(v), fb) for n, v, fb in rows]
+out += ['};', '']
+open(sys.argv[2], 'w').write('\n'.join(out))
