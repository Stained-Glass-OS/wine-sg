+/* private-use symbol code points replaced by their standard characters */
+static WCHAR *translate_symbols( WCHAR *str )
+{
+    size_t len = wcslen( str ), i, o = 0;
+    WCHAR *out = malloc( (len * 2 + 1) * sizeof(WCHAR) );
+    UINT32 fb;
+
+    if (!out) return str;
+    for (i = 0; i < len; i++)
+    {
+        if (str[i] >= 0xe000 && str[i] <= 0xf8ff && (fb = xaml_symbol_fallback( str[i] )))
+        {
+            if (fb >= 0x10000)
+            {
+                out[o++] = 0xd800 | ((fb - 0x10000) >> 10);
+                out[o++] = 0xdc00 | ((fb - 0x10000) & 0x3ff);
+            }
+            else out[o++] = fb;
+        }
+        else out[o++] = str[i];
+    }
+    out[o] = 0;
+    free( str );
+    return out;
+}
