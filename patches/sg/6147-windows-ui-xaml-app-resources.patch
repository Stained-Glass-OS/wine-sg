@@ -774,6 +830,64 @@ static void system_brush( struct resdict *dict, const WCHAR *key, struct xcolor
 
 static struct xcolor alpha( struct xcolor c, BYTE a ) { c.a = a; return c; }
 
+static void system_value( struct resdict *dict, const WCHAR *key, IInspectable *box )
+{
+    if (!box) return;
+    dict_insert( dict, key, box );
+    IInspectable_Release( box );
+}
+
+static void system_color( struct resdict *dict, const WCHAR *key, struct xcolor color )
+{
+    system_value( dict, key, xbox_ref( &IID_IReference_Color, &color, sizeof(color) ) );
+}
+
+/* a colour moved towards white (amount > 0) or black (< 0), amount in 1/10 */
+static struct xcolor shade( struct xcolor c, int amount )
+{
+    BYTE to = amount > 0 ? 255 : 0;
+    int n = abs( amount );
+    c.r += (to - c.r) * n / 10;
+    c.g += (to - c.g) * n / 10;
+    c.b += (to - c.b) * n / 10;
+    return c;
+}
+
+/* the desktop's colours by the names of the system colour resources (high contrast's among them) */
+static void system_colors( struct resdict *dict )
+{
+    static const struct { const WCHAR *key; int index; } colors[] =
+    {
+        { L"SystemColorButtonFaceColor", COLOR_BTNFACE },
+        { L"SystemColorButtonTextColor", COLOR_BTNTEXT },
+        { L"SystemColorGrayTextColor", COLOR_GRAYTEXT },
+        { L"SystemColorHighlightColor", COLOR_HIGHLIGHT },
+        { L"SystemColorHighlightTextColor", COLOR_HIGHLIGHTTEXT },
+        { L"SystemColorHotlightColor", COLOR_HOTLIGHT },
+        { L"SystemColorWindowColor", COLOR_WINDOW },
+        { L"SystemColorWindowTextColor", COLOR_WINDOWTEXT },
+    };
+    struct xcolor accent = xaml_theme_color( XTHEME_ACCENT );
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(colors); i++)
+    {
+        COLORREF ref = GetSysColor( colors[i].index );
+        struct xcolor c = { 0xff, GetRValue( ref ), GetGValue( ref ), GetBValue( ref ) };
+        system_color( dict, colors[i].key, c );
+    }
+    system_color( dict, L"SystemAccentColor", accent );
+    system_color( dict, L"SystemAccentColorLight1", shade( accent, 2 ) );
+    system_color( dict, L"SystemAccentColorLight2", shade( accent, 4 ) );
+    system_color( dict, L"SystemAccentColorLight3", shade( accent, 6 ) );
+    system_color( dict, L"SystemAccentColorDark1", shade( accent, -2 ) );
+    system_color( dict, L"SystemAccentColorDark2", shade( accent, -4 ) );
+    system_color( dict, L"SystemAccentColorDark3", shade( accent, -6 ) );
+    system_value( dict, L"UseSystemFocusVisuals", xbox_boolean( TRUE ) );
+    system_value( dict, L"IsApplicationFocusVisualKindReveal", xbox_boolean( FALSE ) );
+    system_value( dict, L"SymbolThemeFontFamily", xaml_font_family( L"Segoe MDL2 Assets" ) );
+}
+
 static BOOL rounded_look(void)
 {
     DWORD value = 0, size = sizeof(value);
@@ -793,6 +907,7 @@ static BOOL WINAPI init_system_resources( INIT_ONCE *once, void *param, void **c
