+static LONG source_depth;
+
+/* a dictionary's Source: the markup at the URI read into it -- ms-appx:///, or a path from the
+ * application's folder */
+static HRESULT load_source( struct resdict *dict, const WCHAR *uri, IInspectable *uri_obj )
+{
+    IInspectable *self = (IInspectable *)&dict->IResourceDictionary_iface;
+    WCHAR *full;
+    HRESULT hr;
+
+    if (!uri) return E_INVALIDARG;
+    if (!wcsnicmp( uri, L"ms-appx:///", 11 )) full = wcsdup( uri );
+    else if (wcsstr( uri, L"://" ))
+    {
+        FIXME( "%p: Source %s (another package or scheme) not loaded\n", dict, debugstr_w( uri ) );
+        return S_OK;
+    }
+    else
+    {
+        while (*uri == '/') uri++;
+        if ((full = malloc( (wcslen( uri ) + 12) * sizeof(WCHAR) ))) swprintf( full, wcslen( uri ) + 12, L"ms-appx:///%s", uri );
+    }
+    if (!full) return E_OUTOFMEMORY;
+    if (uri_obj) IInspectable_AddRef( uri_obj );
+    else uri_obj = xaml_make_uri( full );
+    if (dict->source) IInspectable_Release( dict->source );
+    dict->source = uri_obj;
+    /* a dictionary that is its own source, or a loop of them */
+    if (InterlockedIncrement( &source_depth ) > 8) hr = E_INVALIDARG;
+    else hr = xaml_load_uri( self, full );
+    InterlockedDecrement( &source_depth );
+    if (hr == S_FALSE)
+    {
+        FIXME( "%p: no markup for %s\n", dict, debugstr_w( full ) );
+        hr = S_OK;
+    }
+    else if (FAILED(hr)) WARN( "%p: %s not loaded: %#lx\n", dict, debugstr_w( full ), hr );
+    else TRACE( "%p: %s loaded\n", dict, debugstr_w( full ) );
+    free( full );
+    return hr;
+}
