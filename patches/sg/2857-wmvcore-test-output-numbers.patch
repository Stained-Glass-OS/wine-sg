From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmvcore tests: take the output numbers of native by media type

Native numbers the audio output 0 and the video one 1; Wine enumerates this
sample file the other way round (a pre-existing winegstreamer ordering issue,
see test_sync_reader_types). The async output-setting tests find the output
by its media type. Part of the 2855 work, kept as its own patch.

---
diff --git a/dlls/wmvcore/tests/wmvcore.c b/dlls/wmvcore/tests/wmvcore.c
index c20b113..516ee75 100644
--- a/dlls/wmvcore/tests/wmvcore.c
+++ b/dlls/wmvcore/tests/wmvcore.c
@@ -940,6 +940,32 @@ static void test_sync_reader_compressed(IWMSyncReader *reader)
     ok(hr == S_OK, "Got hr %#lx.\n", hr);
 }
 
+/* Native numbers the audio output 0 and the video one 1, this file's streams
+ * are enumerated the other way round in Wine (see test_sync_reader_types()). */
+static DWORD get_sync_output_for_type(IWMSyncReader *reader, DWORD windows_output)
+{
+    const GUID *expect = windows_output ? &MEDIATYPE_Video : &MEDIATYPE_Audio;
+    IWMOutputMediaProps *props;
+    DWORD i, count, ret = windows_output;
+    GUID type;
+    HRESULT hr;
+
+    hr = IWMSyncReader_GetOutputCount(reader, &count);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    for (i = 0; i < count; ++i)
+    {
+        hr = IWMSyncReader_GetOutputProps(reader, i, &props);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        hr = IWMOutputMediaProps_GetType(props, &type);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        IWMOutputMediaProps_Release(props);
+        if (IsEqualGUID(&type, expect))
+            ret = i;
+    }
+    return ret;
+}
+
 static void check_sync_get_output_setting(IWMSyncReader *reader, DWORD output, const WCHAR *name,
         WMT_ATTR_DATATYPE expect_type, DWORD expect_value, HRESULT expect_hr)
 {
@@ -959,7 +985,8 @@ static void check_sync_get_output_setting(IWMSyncReader *reader, DWORD output, c
     else
         size = sizeof(DWORD);
 
-    hr = IWMSyncReader_GetOutputSetting(reader, output, name, &type, (BYTE *)&value, &size);
+    hr = IWMSyncReader_GetOutputSetting(reader, get_sync_output_for_type(reader, output), name,
+            &type, (BYTE *)&value, &size);
     ok(hr == expect_hr, "Got hr %#lx.\n", hr);
 
     if (SUCCEEDED(hr))
@@ -992,7 +1019,8 @@ static void check_sync_set_output_setting(IWMSyncReader *reader, DWORD output, c
     else
         size = sizeof(DWORD);
 
-    hr = IWMSyncReader_SetOutputSetting(reader, output, name, type, (BYTE *)&value, size);
+    hr = IWMSyncReader_SetOutputSetting(reader, get_sync_output_for_type(reader, output), name,
+            type, (BYTE *)&value, size);
     ok(hr == expect_hr, "Got hr %#lx.\n", hr);
 
     winetest_pop_context();
