+/* Stained Glass OS: the view follows its folder. A file another program made,
+ * changed or deleted there (a download, a program saving into the folder, a
+ * file on a share) never showed until the folder was opened again: the
+ * shell's change notices reach only the process that sends them. As Windows'
+ * File Explorer watches the folder it shows, a thread waits on the folder's
+ * changes; a moment after they stop, the view reads the folder again and adds
+ * what is new, drops what is gone and takes the new size and date of what
+ * changed -- the selection and the scroll position stay. */
+struct dir_watch
+{
+    HWND hwnd;
+    HANDLE stop;
+    WCHAR path[MAX_PATH];
+};
+
+static DWORD WINAPI dir_watch_proc(void *arg)
+{
+    struct dir_watch *w = arg;
+    HANDLE change = FindFirstChangeNotificationW(w->path, FALSE, FILE_NOTIFY_CHANGE_FILE_NAME |
+            FILE_NOTIFY_CHANGE_DIR_NAME | FILE_NOTIFY_CHANGE_SIZE | FILE_NOTIFY_CHANGE_LAST_WRITE);
+
+    if (change != INVALID_HANDLE_VALUE)
+    {
+        HANDLE handles[2] = { w->stop, change };
+
+        while (WaitForMultipleObjects(2, handles, FALSE, INFINITE) == WAIT_OBJECT_0 + 1)
+        {
+            PostMessageW(w->hwnd, WM_SV_DIRCHANGED, 0, 0);
+            if (!FindNextChangeNotification(change)) break;
+        }
+        FindCloseChangeNotification(change);
+    }
+    CloseHandle(w->stop);
+    free(w);
+    return 0;
+}
+
+static void ShellView_WatchFolder(IShellViewImpl *This)
+{
+    struct dir_watch *w;
+    HANDLE thread;
+
+    if (!ShellView_FolderPidl(This) || !(w = calloc(1, sizeof(*w)))) return;
+    if (!SHGetPathFromIDListW(This->folder_pidl, w->path) || !w->path[0] ||
+        !(This->watch_stop = CreateEventW(NULL, TRUE, FALSE, NULL)) ||
+        !DuplicateHandle(GetCurrentProcess(), This->watch_stop, GetCurrentProcess(), &w->stop, 0, FALSE,
+                         DUPLICATE_SAME_ACCESS))
+    {
+        free(w);
+        return;
+    }
+    w->hwnd = This->hWnd;
+    if ((thread = CreateThread(NULL, 0, dir_watch_proc, w, 0, NULL))) CloseHandle(thread);
+    else
+    {
+        CloseHandle(w->stop);
+        free(w);
+    }
+}
+
+struct named_item
+{
+    WCHAR name[MAX_PATH];
+    LPITEMIDLIST pidl;
+    int index;          /* in the list, -1 for one read from the folder */
+    BOOL matched;
+};
+
+static int __cdecl named_item_cmp(const void *a, const void *b)
+{
+    return lstrcmpiW(((const struct named_item *)a)->name, ((const struct named_item *)b)->name);
+}
+
+static void ShellView_SyncFolder(IShellViewImpl *This)
+{
+    struct named_item *now = NULL, *shown = NULL, *found;
+    UINT n_now = 0, max_now = 256, n_shown, i;
+    SHELLFLAGSTATE settings = {0};
+    DWORD flags = SHCONTF_NONFOLDERS | SHCONTF_FOLDERS, fetched;
+    IEnumIDList *ids;
+    LPITEMIDLIST pidl;
+    BOOL added = FALSE;
+    int *gone = NULL, n_gone = 0;
+
+    SHGetSettings(&settings, SSF_SHOWALLOBJECTS);
+    if (settings.fShowAllObjects) flags |= SHCONTF_INCLUDEHIDDEN;
+    if (IShellFolder_EnumObjects(This->pSFParent, This->hWnd, flags, &ids) != S_OK) return;
+    if (!(now = malloc(max_now * sizeof(*now)))) { IEnumIDList_Release(ids); return; }
+    while (IEnumIDList_Next(ids, 1, &pidl, &fetched) == S_OK && fetched)
+    {
+        if (IncludeObject(This, pidl) != S_OK) { ILFree(pidl); continue; }
+        if (n_now == max_now)
+        {
+            struct named_item *tmp = realloc(now, (max_now *= 2) * sizeof(*now));
+            if (!tmp) { ILFree(pidl); break; }
+            now = tmp;
+        }
+        _ILSimpleGetTextW(pidl, now[n_now].name, MAX_PATH);
+        now[n_now].pidl = pidl;
+        now[n_now].index = -1;
+        now[n_now].matched = FALSE;
+        n_now++;
+    }
+    IEnumIDList_Release(ids);
+    qsort(now, n_now, sizeof(*now), named_item_cmp);
+
+    n_shown = SendMessageW(This->hWndList, LVM_GETITEMCOUNT, 0, 0);
+    shown = calloc(n_shown + 1, sizeof(*shown));
+    gone = calloc(n_shown + 1, sizeof(*gone));
+    if (!shown || !gone) goto done;
+    for (i = 0; i < n_shown; i++)
+    {
+        LVITEMW item = { LVIF_PARAM, i };
+        SendMessageW(This->hWndList, LVM_GETITEMW, 0, (LPARAM)&item);
+        shown[i].pidl = (LPITEMIDLIST)item.lParam;
+        shown[i].index = i;
+        _ILSimpleGetTextW(shown[i].pidl, shown[i].name, MAX_PATH);
+    }
+    for (i = 0; i < n_shown; i++)
+    {
+        if (!shown[i].name[0]) continue;
+        if (!(found = bsearch(&shown[i], now, n_now, sizeof(*now), named_item_cmp)))
+        {
+            gone[n_gone++] = shown[i].index;
+            continue;
+        }
+        found->matched = TRUE;
+        /* the same name: its size or date may have changed */
+        if (ILGetSize(found->pidl) != ILGetSize(shown[i].pidl) ||
+            memcmp(found->pidl, shown[i].pidl, ILGetSize(found->pidl)))
+        {
+            LVITEMW item = { LVIF_PARAM, shown[i].index };
+            item.lParam = (LPARAM)found->pidl;
+            if (SendMessageW(This->hWndList, LVM_SETITEMW, 0, (LPARAM)&item))
+            {
+                ILFree(shown[i].pidl);
+                found->pidl = NULL;
+                SendMessageW(This->hWndList, LVM_REDRAWITEMS, shown[i].index, shown[i].index);
+            }
+        }
+    }
+    /* what went, last first so the indices hold */
+    for (i = n_gone; i > 0; i--)
+        SendMessageW(This->hWndList, LVM_DELETEITEM, gone[i - 1], 0);
+    for (i = 0; i < n_now; i++)
+        if (!now[i].matched && now[i].pidl)
+        {
+            shellview_add_item(This, now[i].pidl);
+            now[i].pidl = NULL;
+            added = TRUE;
+        }
+    if (added)
+    {
+        if (This->pSF2Parent) ShellView_Sort(This);
+        else SendMessageW(This->hWndList, LVM_SORTITEMS, (WPARAM)This->pSFParent, (LPARAM)ShellView_CompareItems);
+    }
+    if (added || n_gone) ShellView_PostRegroup(This);
+    TRACE("folder read again: %u shown, %u there, %d gone, added %d\n", n_shown, n_now, n_gone, added);
+
+done:
+    for (i = 0; i < n_now; i++) if (now[i].pidl) ILFree(now[i].pidl);
+    free(now);
+    free(shown);
+    free(gone);
+}
+
