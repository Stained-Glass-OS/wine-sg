From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, explorer: a snapped window dragged away gets back its size from before the snap

A window snapped to half or a quarter of the screen (Win+Left/Right, or
dragged to an edge or a corner) kept that size when it was dragged away by
its title bar: a half-screen-tall window wherever it was dropped. Windows
gives it back the size it had before the snap as the drag starts, under the
pointer, and it is no longer snapped.

The shell (explorer's shellkeys.c), which snaps windows, now marks a
snapped window with the size it had before (SgSnapRestoreSize,
MAKELONG(width, height), a window property, so any program's window can
carry it) and takes the mark away when it puts the window back. win32u's
move loop, on a drag by the caption of a window with the mark, does what it
does for a maximized window dragged down (0750, 0852): once the pointer has
moved past the drag distance, the window takes that size, placed so the
pointer keeps its place along the caption, and the mark goes; the shell
then forgets the snap (Win+Right afterwards snaps it right, not "back").

Test: test/shellkeys-gate.sh ("a snapped window dragged away by its caption
gets back its size from before the snap, under the pointer"; "...and is no
longer snapped"), mutant SG_MUTANT_SNAP_DRAG_KEEPS_SIZE in
dlls/win32u/defwnd.c (the half's size kept).
---
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -661,7 +661,25 @@
  * pointer moves past the drag distance nothing happens, so a click (or a
  * double-click, which restores) is left alone. Returns FALSE when the button
  * comes up first; *msg_pos is then where the drag goes on from. */
-static BOOL drag_unmaximize( HWND hwnd, WPARAM wparam, UINT style, DWORD *msg_pos )
+/* Stained Glass OS: a window the shell snapped (half or quarter of the
+ * screen, explorer's shellkeys.c) carries the size it had before, as
+ * SgSnapRestoreSize, MAKELONG(width, height) */
+static const WCHAR snap_restore_sizeW[] = {'S','g','S','n','a','p','R','e','s','t','o','r','e','S','i','z','e',0};
+
+static BOOL get_snap_restore( HWND hwnd, SIZE *size )
+{
+    ULONG_PTR packed = (ULONG_PTR)NtUserGetProp( hwnd, snap_restore_sizeW );
+
+    if (!packed) return FALSE;
+    size->cx = LOWORD( packed );
+    size->cy = HIWORD( packed );
+    return size->cx > 0 && size->cy > 0;
+}
+
+/* UNSNAP: not a maximized window but a snapped one, to be given back its
+ * size from before the snap (as Windows does when a snapped window is
+ * dragged away by its title bar) */
+static BOOL drag_unmaximize( HWND hwnd, WPARAM wparam, UINT style, DWORD *msg_pos, const SIZE *unsnap )
 {
     int cx = get_system_metrics( SM_CXDRAG ), cy = get_system_metrics( SM_CYDRAG ), w, h, x, y;
     RECT max_rect, rect;
@@ -717,7 +735,12 @@
      * its frame (winex11 sg_embed.c), to the program -- and the move never
      * ended, the window following the pointer until a click */
     get_window_rect( hwnd, &max_rect, get_thread_dpi() );
-    NtUserShowWindow( hwnd, SW_RESTORE );
+    if (unsnap)
+    {
+        NtUserRemoveProp( hwnd, snap_restore_sizeW );
+        NtUserSetWindowPos( hwnd, 0, 0, 0, unsnap->cx, unsnap->cy, SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE );
+    }
+    else NtUserShowWindow( hwnd, SW_RESTORE );
     if (is_zoomed( hwnd ))
     {
         set_capture_window( 0, GUI_INMOVESIZE, NULL );
@@ -758,7 +781,22 @@
     MSG msg;
 
     if (!is_window_visible( hwnd )) return;
-    if (is_zoomed( hwnd ) && !drag_unmaximize( hwnd, wparam, style, &msg_pos )) return;
+    if (is_zoomed( hwnd ))
+    {
+        if (!drag_unmaximize( hwnd, wparam, style, &msg_pos, NULL )) return;
+    }
+#ifndef SG_MUTANT_SNAP_DRAG_KEEPS_SIZE
+    /* Stained Glass OS: a snapped window dragged by its title bar comes off
+     * at the size it had before the snap, under the pointer, as on Windows;
+     * it kept its half of the screen's size */
+    else
+    {
+        SIZE restore;
+        if ((wparam & 0xfff0) == SC_MOVE && (wparam & 0x0f) == HTCAPTION && !(style & WS_CHILD) &&
+            get_snap_restore( hwnd, &restore ) && !drag_unmaximize( hwnd, wparam, style, &msg_pos, &restore ))
+            return;
+    }
+#endif
 
     thickframe = (style & WS_THICKFRAME) && !((style & (WS_DLGFRAME | WS_BORDER)) == WS_DLGFRAME);
 
--- a/programs/explorer/shellkeys.c
+++ b/programs/explorer/shellkeys.c
@@ -157,8 +157,26 @@
     else SystemParametersInfoW( SPI_GETWORKAREA, 0, rc, 0 );
 }
 
+/* The size a snapped window had before, on the window itself: win32u's move
+ * loop gives it back when the window is dragged away by its title bar, as
+ * Windows does (dlls/win32u/defwnd.c) */
+static const WCHAR snap_restore_sizeW[] = L"SgSnapRestoreSize";
+
+static void mark_snapped( HWND hwnd, const RECT *restore )
+{
+    int w = restore->right - restore->left, h = restore->bottom - restore->top;
+    if (w > 0 && h > 0 && w < 0x8000 && h < 0x8000)
+        SetPropW( hwnd, snap_restore_sizeW, (HANDLE)(ULONG_PTR)MAKELONG( w, h ) );
+}
+
+static void unmark_snapped( HWND hwnd )
+{
+    RemovePropW( hwnd, snap_restore_sizeW );
+}
+
 static void unsnap( HWND hwnd, struct snap *s )
 {
+    unmark_snapped( hwnd );
     SetWindowPos( hwnd, 0, s->restore.left, s->restore.top, s->restore.right - s->restore.left,
                   s->restore.bottom - s->restore.top, SWP_NOZORDER | SWP_NOACTIVATE );
     s->side = 0;
@@ -189,6 +207,7 @@
     snap_rect( &work, side, &rc );
     SetWindowPos( hwnd, 0, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, SWP_NOZORDER );
     s->side = side;
+    mark_snapped( hwnd, &s->restore );
 }
 
 static void snap( int side )
@@ -239,7 +258,7 @@
         if (s->side == SNAP_BR) { snap_to( hwnd, s, 1 ); return; }
     }
     if (!(GetWindowLongW( hwnd, GWL_STYLE ) & WS_MAXIMIZEBOX)) return;
-    if (s) s->hwnd = 0;
+    if (s) { s->hwnd = 0; unmark_snapped( hwnd ); }
     ShowWindowAsync( hwnd, SW_MAXIMIZE );
 }
 
@@ -358,14 +377,24 @@
         drag_hwnd = 0;
         drag_target = 0;
         GetWindowRect( hwnd, &rc );
+        /* dragged away by its title bar, the window took back its size from
+         * before the snap (win32u took the mark): it is no longer snapped */
+        if ((s = get_snap( hwnd, FALSE )) && s->side && !GetPropW( hwnd, snap_restore_sizeW ))
+        {
+            s->side = 0;
+            s->hwnd = 0;
+            drag_size.cx = rc.right - rc.left;
+            drag_size.cy = rc.bottom - rc.top;
+        }
         /* a move, not a resize, ending at an edge */
         if (!target || rc.right - rc.left != drag_size.cx || rc.bottom - rc.top != drag_size.cy) return;
-        if (target == 2) { ShowWindowAsync( hwnd, SW_MAXIMIZE ); return; }
+        if (target == 2) { if (s) { s->hwnd = 0; s->side = 0; unmark_snapped( hwnd ); } ShowWindowAsync( hwnd, SW_MAXIMIZE ); return; }
         if (!(s = get_snap( hwnd, TRUE ))) return;
         if (!s->side) s->restore = rc;
         target_rect( hwnd, target, &rc );
         SetWindowPos( hwnd, 0, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, SWP_NOZORDER );
         s->side = target;
+        mark_snapped( hwnd, &s->restore );
     }
 }
 
