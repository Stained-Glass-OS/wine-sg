diff --git a/dlls/opengl32/unix_wgl.c b/dlls/opengl32/unix_wgl.c
index 6e6fcdf..b6fb42e 100644
--- a/dlls/opengl32/unix_wgl.c
+++ b/dlls/opengl32/unix_wgl.c
@@ -159,6 +159,30 @@ static BOOL has_extension( const char *list, const char *ext, size_t len )
     return FALSE;
 }
 
+/* Extensions whose entry points take or return host pointers that cannot be
+ * represented for a 32-bit client (client-side pointer lists read at draw
+ * time, driver-mapped memory, OpenCL / X11 / Vulkan interop handles). The wow64
+ * thunks for them are not implemented, so they are not advertised, as with
+ * GL_ARB_buffer_storage. */
+static BOOL is_wow64_unsupported_extension( const char *ext )
+{
+    static const char *const names[] =
+    {
+        "GL_ARB_buffer_storage", "GL_EXT_buffer_storage",
+        "GL_IBM_vertex_array_lists", "GL_INTEL_parallel_arrays", "GL_SUN_triangle_list",
+        "GL_ATI_map_object_buffer", "GL_INTEL_map_texture", "GL_ARB_cl_event",
+        "GL_EXT_x11_sync_object", "GL_NV_draw_vulkan_image",
+    };
+    unsigned int i;
+
+#ifdef SG_MUTANT_WOW64_EXT
+    return FALSE;
+#endif
+    if (!is_win64 || !is_wow64()) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(names); i++) if (!strcmp( ext, names[i] )) return TRUE;
+    return FALSE;
+}
+
 static GLubyte *filter_extensions_list( const char *extensions, const char *disabled )
 {
     const char *end;
@@ -179,8 +203,8 @@ static GLubyte *filter_extensions_list( const char *extensions, const char *disa
         p[end - extensions] = 0;
 
         /* We do not support GL_MAP_PERSISTENT_BIT, and hence
-         * ARB_buffer_storage, on wow64. */
-        if (is_win64 && is_wow64() && (!strcmp( p, "GL_ARB_buffer_storage" ) || !strcmp( p, "GL_EXT_buffer_storage" )))
+         * ARB_buffer_storage, on wow64 (see is_wow64_unsupported_extension). */
+        if (is_wow64_unsupported_extension( p ))
         {
             TRACE( "-- %s (disabled due to wow64)\n", p );
         }
@@ -250,8 +274,8 @@ static GLuint *filter_extensions_index( TEB *teb, const char *disabled )
         ext = (const char *)funcs->ext.p_glGetStringi( GL_EXTENSIONS, j );
 
         /* We do not support GL_MAP_PERSISTENT_BIT, and hence
-         * ARB_buffer_storage, on wow64. */
-        if (is_win64 && is_wow64() && (!strcmp( ext, "GL_ARB_buffer_storage" ) || !strcmp( ext, "GL_EXT_buffer_storage" )))
+         * ARB_buffer_storage, on wow64 (see is_wow64_unsupported_extension). */
+        if (is_wow64_unsupported_extension( ext ))
         {
             TRACE( "-- %s (disabled due to wow64)\n", ext );
             disabled_index[i++] = j;
@@ -2286,4 +2310,33 @@ NTSTATUS wow64_get_pixel_formats( void *args )
     return status;
 }
 
+/* WGL_NV_vertex_array_range: the memory comes from the driver and has to be
+ * addressable by the 32-bit client. When it is not, the allocation fails (NULL,
+ * the documented failure result) and the client falls back to plain vertex arrays. */
+NTSTATUS wow64_ext_wglAllocateMemoryNV( void *args )
+{
+    struct
+    {
+        PTR32 teb;
+        GLsizei size;
+        GLfloat readfreq;
+        GLfloat writefreq;
+        GLfloat priority;
+        PTR32 ret;
+    } *params32 = args;
+    TEB *teb = get_teb64( params32->teb );
+    const struct opengl_funcs *funcs = teb->glTable;
+    void *ptr;
+
+    ptr = funcs->ext.p_wglAllocateMemoryNV( params32->size, params32->readfreq, params32->writefreq,
+                                            params32->priority );
+    if (ptr && ULongToPtr( PtrToUlong( ptr )) != ptr)
+    {
+        funcs->ext.p_wglFreeMemoryNV( ptr );
+        ptr = NULL;
+    }
+    params32->ret = PtrToUlong( ptr );
+    return STATUS_SUCCESS;
+}
+
 #endif
