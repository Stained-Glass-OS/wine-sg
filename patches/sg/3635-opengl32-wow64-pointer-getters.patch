      "wglCreateContext" => 1,
      "wglCreateContextAttribsARB" => 1,
      "wglCreatePbufferARB" => 1,
@@ -254,8 +255,21 @@ my %pointer_is_offset =
     (
      "glGetPointerv" => "params",
      "glGetPointervEXT" => "params",
+     "glGetPointerIndexedvEXT" => "data",
+     "glGetPointeri_vEXT" => "params",
+     "glGetTexParameterPointervAPPLE" => "params",
+     "glGetVariantPointervEXT" => "data",
+     "glGetVertexArrayPointeri_vEXT" => "param",
+     "glGetVertexArrayPointervEXT" => "param",
      "glGetVertexAttribPointerv" => "pointer",
      "glGetVertexAttribPointervARB" => "pointer",
+     "glGetVertexAttribPointervNV" => "pointer",
+    );
+# functions returning an integer offset typed as a pointer-sized integer: the
+# offset always fits 32 bits, so the result is passed through
+my %wow64_ret_is_offset =
+    (
+     "glGetUniformOffsetEXT" => 1,
     );
 
 #
