From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comctl32: a toolbar button deleted and inserted again keeps its text (7007)

MFC's CToolBar changes a button by reading it (TB_GETBUTTON gives the
toolbar's own copy of the text), deleting it and inserting the TBBUTTON
it read with TB_INSERTBUTTONA. The text was freed with the deleted button
and then read back as an ANSI string: WinMerge's menu bar, an MFC
toolbar, showed no names. Deleted buttons' texts are kept until the
toolbar is destroyed (at most 256), and a string pointer that is one of
the toolbar's own texts is taken as Unicode whichever message brings it.
---
diff --git a/dlls/comctl32/toolbar.c b/dlls/comctl32/toolbar.c
index f98178e..3597029 100644
--- a/dlls/comctl32/toolbar.c
+++ b/dlls/comctl32/toolbar.c
@@ -177,6 +177,9 @@ typedef struct
     /* Stained Glass OS 1671 */
     SIZE     szBounding;        /* TB_SETBOUNDINGSIZE: the wrapping width */
     struct toolbar_drop *drop;  /* TBSTYLE_REGISTERDROP's drop target */
+    /* Stained Glass OS 7007: strings of deleted buttons, kept until the toolbar goes */
+    WCHAR  **retired_strings;
+    INT      nRetired;
 } TOOLBAR_INFO, *PTOOLBAR_INFO;
 
 
@@ -359,6 +362,52 @@ static void free_string( TBUTTON_INFO *btn )
 
 }
 
+/* Stained Glass OS (wine-sg 7007): MFC's CToolBar changes a button by reading it
+ * (TB_GETBUTTON: iString is the toolbar's own copy of the text), deleting it and inserting
+ * the TBBUTTON it read -- with TB_INSERTBUTTONA. The deleted button's text was freed and
+ * then read back as an ANSI string: WinMerge's menu bar showed no names. A deleted button's
+ * text is kept until the toolbar is destroyed, and a string pointer that is one of the
+ * toolbar's own texts is taken as the Unicode text it is, whichever message brings it. */
+#define MAX_RETIRED_STRINGS 256
+
+static void retire_string( TOOLBAR_INFO *infoPtr, TBUTTON_INFO *btn )
+{
+#ifndef SG_MUTANT_TB_RETIRED_STRING
+    WCHAR **list;
+
+    if (TOOLBAR_ButtonHasString( btn ))
+    {
+        if (infoPtr->nRetired == MAX_RETIRED_STRINGS)
+        {
+            Free( infoPtr->retired_strings[0] );
+            memmove( infoPtr->retired_strings, infoPtr->retired_strings + 1,
+                     (MAX_RETIRED_STRINGS - 1) * sizeof(WCHAR *) );
+            infoPtr->nRetired--;
+        }
+        if ((list = ReAlloc( infoPtr->retired_strings, (infoPtr->nRetired + 1) * sizeof(WCHAR *) )))
+        {
+            infoPtr->retired_strings = list;
+            list[infoPtr->nRetired++] = (WCHAR *)btn->iString;
+            btn->iString = 0;
+            return;
+        }
+    }
+#endif
+    free_string( btn );
+}
+
+static BOOL is_own_string( const TOOLBAR_INFO *infoPtr, INT_PTR str )
+{
+    INT i;
+
+    if (IS_INTRESOURCE( str ) || str == -1) return FALSE;
+    for (i = 0; i < infoPtr->nRetired; i++)
+        if ((INT_PTR)infoPtr->retired_strings[i] == str) return TRUE;
+    for (i = 0; i < infoPtr->nNumButtons; i++)
+        if (TOOLBAR_ButtonHasString( &infoPtr->buttons[i] ) && infoPtr->buttons[i].iString == str) return TRUE;
+    return FALSE;
+}
+
 /***********************************************************************
 * 		TOOLBAR_CheckStyle
 *
@@ -2095,7 +2144,7 @@ TOOLBAR_InternalInsertButtonsT(TOOLBAR_INFO *infoPtr, INT iIndex, UINT nAddButto
             str = -1;
         else
             str = lpTbb[iButton].iString;
-        set_string_index( btnPtr, str, fUnicode );
+        set_string_index( btnPtr, str, fUnicode || is_own_string( infoPtr, str ) );
         fHasString |= TOOLBAR_ButtonHasString( btnPtr );
 
         TOOLBAR_TooltipAddTool(infoPtr, btnPtr);
@@ -3479,7 +3528,7 @@ TOOLBAR_DeleteButton (TOOLBAR_INFO *infoPtr, INT nIndex)
     infoPtr->nHotItem = -1;
     if (infoPtr->nNumButtons == 1) {
 	TRACE(" simple delete\n");
-        free_string( infoPtr->buttons );
+        retire_string( infoPtr, infoPtr->buttons );
 	Free (infoPtr->buttons);
 	infoPtr->buttons = NULL;
 	infoPtr->nNumButtons = 0;
@@ -3500,7 +3549,7 @@ TOOLBAR_DeleteButton (TOOLBAR_INFO *infoPtr, INT nIndex)
                     (infoPtr->nNumButtons - nIndex) * sizeof(TBUTTON_INFO));
         }
 
-        free_string( oldButtons + nIndex );
+        retire_string( infoPtr, oldButtons + nIndex );
 	Free (oldButtons);
     }
 
@@ -5556,6 +5605,9 @@ TOOLBAR_Destroy (TOOLBAR_INFO *infoPtr)
     for (i = 0; i < infoPtr->nNumButtons; i++)
         free_string( infoPtr->buttons + i );
     Free (infoPtr->buttons);
+    for (i = 0; i < infoPtr->nRetired; i++)
+        Free( infoPtr->retired_strings[i] );
+    Free( infoPtr->retired_strings );
 
     /* delete strings */
     if (infoPtr->strings) {
