+/* Stained Glass OS: the audit alarm functions. They need SeAuditPrivilege enabled in the calling token
+ * (ERROR_PRIVILEGE_NOT_HELD otherwise). Nothing is written to an audit log: the security event log is not
+ * kept, so the calls validate and report what would be generated. */
+static BOOL audit_privilege_held(void)
+{
+    PRIVILEGE_SET set;
+    HANDLE token;
+    BOOL result = FALSE, ok;
+
+    if (!OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ) &&
+        !OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+        return FALSE;
+    set.PrivilegeCount = 1;
+    set.Control = PRIVILEGE_SET_ALL_NECESSARY;
+    set.Privilege[0].Luid.LowPart = 21; /* SE_AUDIT_PRIVILEGE */
+    set.Privilege[0].Luid.HighPart = 0;
+    set.Privilege[0].Attributes = 0;
+    ok = PrivilegeCheck( token, &set, &result );
+    CloseHandle( token );
+    return ok && result;
+}
+
+static BOOL require_audit_privilege(void)
+{
+    if (audit_privilege_held()) return TRUE;
+    SetLastError( ERROR_PRIVILEGE_NOT_HELD );
+    return FALSE;
+}
+
+/* is an audit ACE of the SACL for a user or group of the client, for this access and this outcome? */
+static BOOL sacl_audits_access( PSECURITY_DESCRIPTOR descr, HANDLE client, DWORD access, BOOL granted_access )
+{
+    ACL_SIZE_INFORMATION info;
+    BOOL present, defaulted, ret = FALSE;
+    HANDLE imp = NULL;
+    PACL sacl;
+    DWORD i;
+
+    if (!descr || !GetSecurityDescriptorSacl( descr, &present, &sacl, &defaulted ) || !present || !sacl) return FALSE;
+    if (RtlQueryInformationAcl( sacl, &info, sizeof(info), AclSizeInformation )) return FALSE;
+    if (client && !DuplicateTokenEx( client, TOKEN_QUERY | TOKEN_DUPLICATE, NULL, SecurityImpersonation,
+                                     TokenImpersonation, &imp ))
+        imp = NULL;
+    for (i = 0; i < info.AceCount && !ret; i++)
+    {
+        SYSTEM_AUDIT_ACE *ace;
+        BOOL member;
+
+        if (RtlGetAce( sacl, i, (void **)&ace ) || ace->Header.AceType != SYSTEM_AUDIT_ACE_TYPE) continue;
+        if (ace->Header.AceFlags & INHERIT_ONLY_ACE) continue;
+        if (!(ace->Header.AceFlags & (granted_access ? SUCCESSFUL_ACCESS_ACE_FLAG : FAILED_ACCESS_ACE_FLAG))) continue;
+        if (!(ace->Mask & access)) continue;
+        if (CheckTokenMembership( imp, (PSID)&ace->SidStart, &member ) && member) ret = TRUE;
+    }
+    if (imp) CloseHandle( imp );
+    return ret;
+}
+
