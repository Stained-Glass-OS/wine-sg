+/******************************************************************************
+ * RtlSetInformationAcl (NTDLL.@)
+ *
+ * Only the revision of an ACL can be set, and not below the one it has.
+ */
+NTSTATUS WINAPI RtlSetInformationAcl( PACL acl, void *info, DWORD len, ACL_INFORMATION_CLASS class )
+{
+    TRACE( "%p %p %lu %d\n", acl, info, len, class );
+
+    if (!RtlValidAcl( acl )) return STATUS_INVALID_ACL;
+    switch (class)
+    {
+    case AclRevisionInformation:
+    {
+        ACL_REVISION_INFORMATION *rev = info;
+
+        if (len < sizeof(*rev)) return STATUS_INVALID_PARAMETER;
+        if (rev->AclRevision < MIN_ACL_REVISION || rev->AclRevision > MAX_ACL_REVISION ||
+            rev->AclRevision < acl->AclRevision)
+            return STATUS_INVALID_PARAMETER;
+        acl->AclRevision = rev->AclRevision;
+        return STATUS_SUCCESS;
+    }
+    default:
+        return STATUS_INVALID_INFO_CLASS;
+    }
+}
+
+/******************************************************************************
+ * RtlSetSecurityObjectEx (NTDLL.@)
+ *
+ * Replace the parts of a private object's self-relative security descriptor selected by info with those of the
+ * modification descriptor; the result is a new self-relative descriptor on the process heap and the old one is
+ * freed. The token is not consulted (the owner and privilege checks of Windows are not made: GUESS).
+ */
+NTSTATUS WINAPI RtlSetSecurityObjectEx( SECURITY_INFORMATION info, PSECURITY_DESCRIPTOR mod,
+                                        PSECURITY_DESCRIPTOR *object, ULONG flags,
+                                        const GENERIC_MAPPING *mapping, HANDLE token )
+{
+    SECURITY_DESCRIPTOR_CONTROL old_control, mod_control, control;
+    SECURITY_DESCRIPTOR_RELATIVE *rel;
+    PSID owner = NULL, group = NULL, sid;
+    PACL dacl = NULL, sacl = NULL, acl;
+    BOOLEAN present, defaulted;
+    ULONG rev, size, owner_len = 0, group_len = 0, dacl_len = 0, sacl_len = 0, off;
+    BYTE *buffer;
+    NTSTATUS status;
+
+    TRACE( "%#lx %p %p %#lx %p %p\n", info, mod, object, flags, mapping, token );
+
+    if (!mod || !object || !*object) return STATUS_INVALID_PARAMETER;
+
+    if (!RtlValidSecurityDescriptor( mod )) return STATUS_INVALID_SECURITY_DESCR;
+    if (!RtlValidSecurityDescriptor( *object )) return STATUS_INVALID_SECURITY_DESCR;
+    if ((status = RtlGetControlSecurityDescriptor( *object, &old_control, &rev ))) return status;
+    if (!(old_control & SE_SELF_RELATIVE)) return STATUS_INVALID_SECURITY_DESCR;
+    RtlGetControlSecurityDescriptor( mod, &mod_control, &rev );
+
+    /* start from the old parts */
+    RtlGetOwnerSecurityDescriptor( *object, &owner, &defaulted );
+    RtlGetGroupSecurityDescriptor( *object, &group, &defaulted );
+    RtlGetDaclSecurityDescriptor( *object, &present, &dacl, &defaulted );
+    if (!present) dacl = NULL;
+    RtlGetSaclSecurityDescriptor( *object, &present, &sacl, &defaulted );
+    if (!present) sacl = NULL;
+    control = old_control & (SE_DACL_PRESENT | SE_SACL_PRESENT | SE_DACL_AUTO_INHERITED | SE_SACL_AUTO_INHERITED |
+                             SE_DACL_PROTECTED | SE_SACL_PROTECTED | SE_SELF_RELATIVE);
+
+    if (info & OWNER_SECURITY_INFORMATION)
+    {
+        RtlGetOwnerSecurityDescriptor( mod, &sid, &defaulted );
+        if (!sid) return STATUS_INVALID_OWNER;
+        owner = sid;
+    }
+    if (info & GROUP_SECURITY_INFORMATION)
+    {
+        RtlGetGroupSecurityDescriptor( mod, &sid, &defaulted );
+        if (!sid) return STATUS_INVALID_PRIMARY_GROUP;
+        group = sid;
+    }
+    if (info & DACL_SECURITY_INFORMATION)
+    {
+        RtlGetDaclSecurityDescriptor( mod, &present, &acl, &defaulted );
+        dacl = present ? acl : NULL;            /* no DACL in the modification: a NULL DACL */
+        control |= SE_DACL_PRESENT;
+        control &= ~(SE_DACL_PROTECTED | SE_DACL_AUTO_INHERITED);
+        control |= mod_control & SE_DACL_PROTECTED;
+        if (flags & 1 /* SEF_DACL_AUTO_INHERIT */) control |= SE_DACL_AUTO_INHERITED;
+    }
+    if (info & SACL_SECURITY_INFORMATION)
+    {
+        RtlGetSaclSecurityDescriptor( mod, &present, &acl, &defaulted );
+        sacl = present ? acl : NULL;
+        control |= SE_SACL_PRESENT;
+        control &= ~(SE_SACL_PROTECTED | SE_SACL_AUTO_INHERITED);
+        control |= mod_control & SE_SACL_PROTECTED;
+        if (flags & 2 /* SEF_SACL_AUTO_INHERIT */) control |= SE_SACL_AUTO_INHERITED;
+    }
+    if (info & 0x80000000 /* PROTECTED_DACL_SECURITY_INFORMATION */) control |= SE_DACL_PROTECTED;
+    if (info & 0x20000000 /* UNPROTECTED_DACL_SECURITY_INFORMATION */) control &= ~SE_DACL_PROTECTED;
+    if (info & 0x40000000 /* PROTECTED_SACL_SECURITY_INFORMATION */) control |= SE_SACL_PROTECTED;
+    if (info & 0x10000000 /* UNPROTECTED_SACL_SECURITY_INFORMATION */) control &= ~SE_SACL_PROTECTED;
+
+    size = sizeof(SECURITY_DESCRIPTOR_RELATIVE);
+    if (owner) size += owner_len = RtlLengthSid( owner );
+    if (group) size += group_len = RtlLengthSid( group );
+    if (dacl && (control & SE_DACL_PRESENT)) size += dacl_len = dacl->AclSize;
+    if (sacl && (control & SE_SACL_PRESENT)) size += sacl_len = sacl->AclSize;
+    if (!(buffer = RtlAllocateHeap( GetProcessHeap(), 0, size ))) return STATUS_NO_MEMORY;
+    rel = (SECURITY_DESCRIPTOR_RELATIVE *)buffer;
+    RtlCreateSecurityDescriptor( rel, SECURITY_DESCRIPTOR_REVISION );
+    rel->Control = control | SE_SELF_RELATIVE;
+    off = sizeof(*rel);
+    if (owner_len) { memcpy( buffer + off, owner, owner_len ); rel->Owner = off; off += owner_len; }
+    if (group_len) { memcpy( buffer + off, group, group_len ); rel->Group = off; off += group_len; }
+    if (dacl_len) { memcpy( buffer + off, dacl, dacl_len ); rel->Dacl = off; off += dacl_len; }
+    if (sacl_len) { memcpy( buffer + off, sacl, sacl_len ); rel->Sacl = off; off += sacl_len; }
+
+    RtlFreeHeap( GetProcessHeap(), 0, *object );
+    *object = rel;
+    return STATUS_SUCCESS;
+}
+
+/******************************************************************************
+ * RtlSetSecurityObject (NTDLL.@)
+ */
+NTSTATUS WINAPI RtlSetSecurityObject( SECURITY_INFORMATION info, PSECURITY_DESCRIPTOR mod,
+                                      PSECURITY_DESCRIPTOR *object, PGENERIC_MAPPING mapping, HANDLE token )
+{
+    return RtlSetSecurityObjectEx( info, mod, object, 0, mapping, token );
+}
