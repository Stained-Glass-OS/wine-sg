+/* Stained Glass OS: the object ACEs (ACCESS_ALLOWED_OBJECT_ACE and friends). The layout is documented:
+ * header, mask, flags, the object type GUID if flag 1, the inherited object type GUID if flag 2, then the
+ * SID. A GUID that is absent takes no room. They need an ACL of revision 4 (ACL_REVISION_DS). */
+static NTSTATUS add_object_ace( PACL acl, DWORD revision, DWORD ace_flags, DWORD mask, const GUID *object_type,
+                                const GUID *inherited_type, PSID sid, DWORD ace_type )
+{
+    ACE_HEADER *header;
+    DWORD size, flags = 0, *p;
+    BYTE *pos;
+
+    if (!RtlValidSid( sid )) return STATUS_INVALID_SID;
+    if (revision != 4 /* ACL_REVISION_DS */ || acl->AclRevision > MAX_ACL_REVISION) return STATUS_REVISION_MISMATCH;
+    if (!RtlValidAcl( acl )) return STATUS_INVALID_ACL;
+    if (!RtlFirstFreeAce( acl, &header )) return STATUS_INVALID_ACL;
+    if (!header) return STATUS_ALLOTTED_SPACE_EXCEEDED;
+
+    size = sizeof(ACE_HEADER) + 2 * sizeof(DWORD) + RtlLengthSid( sid );
+    if (object_type) { flags |= ACE_OBJECT_TYPE_PRESENT; size += sizeof(GUID); }
+    if (inherited_type) { flags |= ACE_INHERITED_OBJECT_TYPE_PRESENT; size += sizeof(GUID); }
+    if ((char *)header + size > (char *)acl + acl->AclSize) return STATUS_ALLOTTED_SPACE_EXCEEDED;
+
+    header->AceType = ace_type;
+    header->AceFlags = ace_flags;
+    header->AceSize = size;
+    p = (DWORD *)(header + 1);
+    p[0] = mask;
+    p[1] = flags;
+    pos = (BYTE *)(p + 2);
+    if (object_type) { memcpy( pos, object_type, sizeof(GUID) ); pos += sizeof(GUID); }
+    if (inherited_type) { memcpy( pos, inherited_type, sizeof(GUID) ); pos += sizeof(GUID); }
+    RtlCopySid( RtlLengthSid( sid ), pos, sid );
+
+    acl->AclRevision = max( acl->AclRevision, revision );
+    acl->AceCount++;
+    return STATUS_SUCCESS;
+}
+
