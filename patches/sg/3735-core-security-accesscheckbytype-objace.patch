 NTSTATUS WINAPI RtlDefaultNpAcl(PACL *pAcl)
 {
-    FIXME("%p - stub\n", pAcl);
+    /* the documented default of a named pipe: full control for LocalSystem, the administrators and the
+     * creator (the user of the token), read access for Everyone and the anonymous logon */
+    SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    SID_IDENTIFIER_AUTHORITY world = { SECURITY_WORLD_SID_AUTHORITY };
+    BYTE system_sid[SECURITY_MAX_SID_SIZE], admins_sid[SECURITY_MAX_SID_SIZE];
+    BYTE world_sid_buf[SECURITY_MAX_SID_SIZE], anon_sid[SECURITY_MAX_SID_SIZE];
+    BYTE buf[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE];
+    TOKEN_USER *user = (TOKEN_USER *)buf;
+    HANDLE token;
+    ULONG len, size;
+    NTSTATUS status;
+    ACL *acl;
+
+    TRACE( "%p\n", pAcl );
 
+    if (!pAcl) return STATUS_INVALID_PARAMETER;
     *pAcl = NULL;
+
+    RtlInitializeSid( system_sid, &nt, 1 );
+    *RtlSubAuthoritySid( system_sid, 0 ) = SECURITY_LOCAL_SYSTEM_RID;
+    RtlInitializeSid( admins_sid, &nt, 2 );
+    *RtlSubAuthoritySid( admins_sid, 0 ) = SECURITY_BUILTIN_DOMAIN_RID;
+    *RtlSubAuthoritySid( admins_sid, 1 ) = DOMAIN_ALIAS_RID_ADMINS;
+    RtlInitializeSid( world_sid_buf, &world, 1 );
+    *RtlSubAuthoritySid( world_sid_buf, 0 ) = SECURITY_WORLD_RID;
+    RtlInitializeSid( anon_sid, &nt, 1 );
+    *RtlSubAuthoritySid( anon_sid, 0 ) = SECURITY_ANONYMOUS_LOGON_RID;
+
+    if ((status = NtOpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token )))
+        status = NtOpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token );
+    if (status) return status;
+    status = NtQueryInformationToken( token, TokenUser, buf, sizeof(buf), &len );
+    NtClose( token );
+    if (status) return status;
+
+    size = sizeof(ACL) + 5 * (offsetof( ACCESS_ALLOWED_ACE, SidStart )) + RtlLengthSid( system_sid ) +
+           RtlLengthSid( admins_sid ) + RtlLengthSid( user->User.Sid ) + RtlLengthSid( world_sid_buf ) +
+           RtlLengthSid( anon_sid );
+    if (!(acl = RtlAllocateHeap( GetProcessHeap(), 0, size ))) return STATUS_NO_MEMORY;
+    RtlCreateAcl( acl, size, ACL_REVISION );
+    if ((status = RtlAddAccessAllowedAce( acl, ACL_REVISION, GENERIC_ALL, system_sid )) ||
+        (status = RtlAddAccessAllowedAce( acl, ACL_REVISION, GENERIC_ALL, admins_sid )) ||
+        (status = RtlAddAccessAllowedAce( acl, ACL_REVISION, GENERIC_ALL, user->User.Sid )) ||
+        (status = RtlAddAccessAllowedAce( acl, ACL_REVISION, GENERIC_READ, world_sid_buf )) ||
+        (status = RtlAddAccessAllowedAce( acl, ACL_REVISION, GENERIC_READ, anon_sid )))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, acl );
+        return status;
+    }
+    *pAcl = acl;
     return STATUS_SUCCESS;
 }
