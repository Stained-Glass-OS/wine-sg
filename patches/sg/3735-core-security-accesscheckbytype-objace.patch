@@ -1399,13 +1405,146 @@ BOOL WINAPI AccessCheckAndAuditAlarmW( LPCWSTR subsystem, LPVOID id, LPWSTR type
 /******************************************************************************
  * AccessCheckByType    (kernelbase.@)
  */
+/* Stained Glass OS: AccessCheckByType. The server evaluates plain ACLs (AccessCheck), so the object ACEs and
+ * PRINCIPAL_SELF of the DACL are resolved first, for the root of the object type list, into a plain DACL that
+ * the same check then runs on:
+ *  - an allow ACE for an object type applies to the root only when it names the root type (it grants that
+ *    element and its children, never its parents);
+ *  - a deny ACE for any type in the list applies (a deny on a child removes the right from the parents);
+ *  - without a list an allow object ACE grants nothing and a deny object ACE still denies (GUESS: the
+ *    conservative reading);
+ *  - an ACE for the PRINCIPAL_SELF SID (S-1-5-10) is made one for the sid argument;
+ *  - ACEs of other kinds (audit, callback) take no part. */
+static BOOL access_check_by_type_acl( const ACL *orig, PSID self, const OBJECT_TYPE_LIST *types, DWORD types_len,
+                                      PACL *ret )
+{
+    static const SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    ACL_SIZE_INFORMATION info;
+    PACL acl;
+    DWORD i, size;
+
+    if (RtlQueryInformationAcl( (PACL)orig, &info, sizeof(info), AclSizeInformation )) return FALSE;
+    size = orig->AclSize + info.AceCount * (self ? GetLengthSid( self ) : 0) + 64;
+    if (!(acl = LocalAlloc( LMEM_FIXED, size ))) { SetLastError( ERROR_NOT_ENOUGH_MEMORY ); return FALSE; }
+    if (!InitializeAcl( acl, size, ACL_REVISION ))
+    {
+        LocalFree( acl );
+        return FALSE;
+    }
+
+    for (i = 0; i < info.AceCount; i++)
+    {
+        ACE_HEADER *ace;
+        PSID sid;
+        DWORD mask, flags = 0, ace_flags;
+        const GUID *object = NULL;
+        BYTE *pos;
+        BOOL allow, ok = TRUE;
+
+        if (RtlGetAce( (PACL)orig, i, (void **)&ace )) continue;
+        ace_flags = ace->AceFlags & (OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE | NO_PROPAGATE_INHERIT_ACE |
+                                     INHERIT_ONLY_ACE);
+        switch (ace->AceType)
+        {
+        case ACCESS_ALLOWED_ACE_TYPE:
+        case ACCESS_DENIED_ACE_TYPE:
+            mask = ((ACCESS_ALLOWED_ACE *)ace)->Mask;
+            sid = (PSID)&((ACCESS_ALLOWED_ACE *)ace)->SidStart;
+            allow = ace->AceType == ACCESS_ALLOWED_ACE_TYPE;
+            break;
+        case ACCESS_ALLOWED_OBJECT_ACE_TYPE:
+        case ACCESS_DENIED_OBJECT_ACE_TYPE:
+            mask = ((ACCESS_ALLOWED_OBJECT_ACE *)ace)->Mask;
+            flags = ((ACCESS_ALLOWED_OBJECT_ACE *)ace)->Flags;
+            pos = (BYTE *)&((ACCESS_ALLOWED_OBJECT_ACE *)ace)->ObjectType;
+            if (flags & ACE_OBJECT_TYPE_PRESENT) { object = (const GUID *)pos; pos += sizeof(GUID); }
+            if (flags & ACE_INHERITED_OBJECT_TYPE_PRESENT) pos += sizeof(GUID);
+            sid = (PSID)pos;
+            allow = ace->AceType == ACCESS_ALLOWED_OBJECT_ACE_TYPE;
+            if (object)
+            {
+                if (allow)
+                    ok = types && !memcmp( object, types[0].ObjectType, sizeof(GUID) );
+                else if (types)
+                {
+                    DWORD k;
+                    ok = FALSE;
+                    for (k = 0; k < types_len && !ok; k++) ok = !memcmp( object, types[k].ObjectType, sizeof(GUID) );
+                }
+            }
+            break;
+        default:
+            continue;
+        }
+        if (!ok) continue;
+        if (self && *GetSidSubAuthorityCount( sid ) == 1 && *GetSidSubAuthority( sid, 0 ) == SECURITY_PRINCIPAL_SELF_RID &&
+            !memcmp( GetSidIdentifierAuthority( sid ), &nt, sizeof(nt) ))
+            sid = self;
+        if (!(allow ? AddAccessAllowedAceEx( acl, ACL_REVISION, ace_flags, mask, sid )
+                    : AddAccessDeniedAceEx( acl, ACL_REVISION, ace_flags, mask, sid )))
+        {
+            LocalFree( acl );
+            return FALSE;
+        }
+    }
+    *ret = acl;
+    return TRUE;
+}
+
 BOOL WINAPI AccessCheckByType( PSECURITY_DESCRIPTOR descr, PSID sid, HANDLE token, DWORD access,
                                POBJECT_TYPE_LIST types, DWORD types_len, PGENERIC_MAPPING mapping,
                                PPRIVILEGE_SET priv, LPDWORD priv_len, LPDWORD granted, LPBOOL status )
 {
-    FIXME("stub\n");
-    *status = TRUE;
-    return !*status;
+    SECURITY_DESCRIPTOR filtered;
+    BOOL present, defaulted, ret;
+    PACL dacl, plain = NULL;
+    PSID owner, group;
+    DWORD i;
+
+    TRACE( "%p %p %p %#lx %p %lu %p %p %p %p %p\n", descr, sid, token, access, types, types_len, mapping,
+           priv, priv_len, granted, status );
+
+    if (!descr || !granted || !status || !mapping)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if ((types != NULL) != (types_len != 0))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (sid && !IsValidSid( sid ))
+    {
+        SetLastError( ERROR_INVALID_SID );
+        return FALSE;
+    }
+    /* the list is a tree in depth-first order: level 0 first and only once, a level at most one deeper
+     * than the one before */
+    for (i = 0; i < types_len; i++)
+    {
+        if (!types[i].ObjectType || (i == 0 ? types[i].Level != 0 : (!types[i].Level || types[i].Level > types[i - 1].Level + 1)))
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+    }
+
+    if (!GetSecurityDescriptorDacl( descr, &present, &dacl, &defaulted ))
+        return FALSE;
+    if (!present || !dacl)  /* no DACL: nothing to resolve */
+        return AccessCheck( descr, token, access, mapping, priv, priv_len, granted, status );
+
+    if (!access_check_by_type_acl( dacl, sid, types, types_len, &plain )) return FALSE;
+    GetSecurityDescriptorOwner( descr, &owner, &defaulted );
+    GetSecurityDescriptorGroup( descr, &group, &defaulted );
+    InitializeSecurityDescriptor( &filtered, SECURITY_DESCRIPTOR_REVISION );
+    if (owner) SetSecurityDescriptorOwner( &filtered, owner, FALSE );
+    if (group) SetSecurityDescriptorGroup( &filtered, group, FALSE );
+    SetSecurityDescriptorDacl( &filtered, TRUE, plain, FALSE );
+    ret = AccessCheck( &filtered, token, access, mapping, priv, priv_len, granted, status );
+    LocalFree( plain );
+    return ret;
 }
 
