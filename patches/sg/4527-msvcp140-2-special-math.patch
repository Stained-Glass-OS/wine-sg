From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcp140_2: Implement the C++17 special math functions.

msvcp140_2's C++17 special math functions were spec stubs (42 exports and
their i386 stdcall names): assoc_laguerre, assoc_legendre, beta,
comp_ellint_1/2/3, cyl_bessel_i/j/k, cyl_neumann, ellint_1/2/3, expint,
hermite, laguerre, legendre, riemann_zeta, sph_bessel, sph_legendre and
sph_neumann, double and float. Written from the definitions in the C++
standard and published methods: the polynomials by their recurrences
(sph_legendre through the normalized one), beta from the gamma function,
the elliptic integrals through Carlson's R_F, R_D and R_J by duplication,
Ei by its series, asymptotic series and E1 continued fraction, zeta by
Borwein's alternating series with the reflection formula, and the Bessel
functions by power series, Schlaefli's integrals (adaptive Gauss-Kronrod
quadrature) and Hankel's expansion, negative orders by reflection.
Arguments outside a function's domain give NaN.
---
 dlls/msvcp140_2/math.c          | 795 ++++++++++++++++++++++++++++++++++++++++
 dlls/msvcp140_2/msvcp140_2.spec | 168 ++++-----
 2 files changed, 879 insertions(+), 84 deletions(-)

diff --git a/dlls/msvcp140_2/math.c b/dlls/msvcp140_2/math.c
index aa8726d..a20ec54 100644
--- a/dlls/msvcp140_2/math.c
+++ b/dlls/msvcp140_2/math.c
@@ -29,3 +29,798 @@ float __stdcall __std_smf_hypot3f(float x, float y, float z)
 {
     return hypotf(hypotf(x, y), z);
 }
+
+/* The C++17 special math functions, written from their definitions in the
+ * standard ([sf.cmath]) and from published numerical methods: recurrences
+ * for the polynomials, Carlson's symmetric forms for the elliptic integrals,
+ * power series, Schlaefli's integrals and Hankel's asymptotic expansion for
+ * the Bessel functions, Borwein's alternating series for zeta. Arguments
+ * outside the domain give a NaN. The float forms compute in double. */
+
+#include <float.h>
+#include <stddef.h>
+
+#define SMF_PI 3.14159265358979323846
+#define SMF_EULER 0.57721566490153286061
+
+static double smf_nan(void)
+{
+    return NAN;
+}
+
+/* Legendre, Laguerre and Hermite polynomials */
+
+static double smf_legendre(unsigned int l, double x)
+{
+    double p0 = 1.0, p1 = x, p2;
+    unsigned int k;
+
+    if (isnan(x)) return x;
+    if (fabs(x) > 1.0) return smf_nan();
+    if (!l) return 1.0;
+    for (k = 1; k < l; k++)
+    {
+        p2 = ((2 * k + 1) * x * p1 - k * p0) / (k + 1);
+        p0 = p1;
+        p1 = p2;
+    }
+    return p1;
+}
+
+/* P_l^m(x) without the Condon-Shortley phase, as C++ defines it */
+static double smf_assoc_legendre(unsigned int l, unsigned int m, double x)
+{
+    double pmm = 1.0, s, p0, p1, p2;
+    unsigned int k;
+
+    if (isnan(x)) return x;
+    if (fabs(x) > 1.0) return smf_nan();
+    if (m > l) return 0.0;
+    s = sqrt((1.0 - x) * (1.0 + x));
+    for (k = 1; k <= m; k++) pmm *= (2 * k - 1) * s;
+    if (l == m) return pmm;
+    p0 = pmm;
+    p1 = x * (2 * m + 1) * pmm;
+    for (k = m + 2; k <= l; k++)
+    {
+        p2 = ((2 * k - 1) * x * p1 - (k + m - 1) * p0) / (k - m);
+        p0 = p1;
+        p1 = p2;
+    }
+    return p1;
+}
+
+/* Y_l^m(theta, 0) through the recurrence of the normalized functions */
+static double smf_sph_legendre(unsigned int l, unsigned int m, double theta)
+{
+    double x, s, ymm, y0, y1, y2;
+    unsigned int k;
+
+    if (isnan(theta)) return theta;
+    if (m > l) return 0.0;
+    x = cos(theta);
+    s = fabs(sin(theta));
+    ymm = 1.0 / sqrt(4.0 * SMF_PI);
+    for (k = 1; k <= m; k++) ymm *= -s * sqrt((2.0 * k + 1.0) / (2.0 * k));
+    if (l == m) return ymm;
+    y0 = ymm;
+    y1 = x * sqrt(2.0 * m + 3.0) * ymm;
+    for (k = m + 2; k <= l; k++)
+    {
+        double kk = (double)k * k, mm = (double)m * m, k1 = (double)(k - 1) * (k - 1);
+        y2 = sqrt((4.0 * kk - 1.0) / (kk - mm)) * (x * y1 - sqrt((k1 - mm) / (4.0 * k1 - 1.0)) * y0);
+        y0 = y1;
+        y1 = y2;
+    }
+    return y1;
+}
+
+static double smf_assoc_laguerre(unsigned int n, unsigned int m, double x)
+{
+    double l0 = 1.0, l1, l2;
+    unsigned int k;
+
+    if (isnan(x)) return x;
+    if (!n) return 1.0;
+    l1 = 1.0 + m - x;
+    for (k = 1; k < n; k++)
+    {
+        l2 = ((2.0 * k + 1.0 + m - x) * l1 - (k + m) * l0) / (k + 1);
+        l0 = l1;
+        l1 = l2;
+    }
+    return l1;
+}
+
+static double smf_hermite(unsigned int n, double x)
+{
+    double h0 = 1.0, h1 = 2.0 * x, h2;
+    unsigned int k;
+
+    if (isnan(x)) return x;
+    if (!n) return 1.0;
+    for (k = 1; k < n; k++)
+    {
+        h2 = 2.0 * x * h1 - 2.0 * k * h0;
+        h0 = h1;
+        h1 = h2;
+    }
+    return h1;
+}
+
+/* beta */
+
+static double smf_beta(double x, double y)
+{
+    double r;
+
+    if (isnan(x) || isnan(y)) return x + y;
+    if (x <= 0 || y <= 0) return smf_nan();
+    if (x + y < 170.0)
+    {
+        r = tgamma(x) / tgamma(x + y) * tgamma(y);
+        if (isfinite(r) && r != 0.0) return r;
+    }
+    return exp(lgamma(x) + lgamma(y) - lgamma(x + y));
+}
+
+/* Carlson's symmetric elliptic integrals, by the duplication theorem */
+
+static double carlson_rf(double x, double y, double z)
+{
+    double xn = x, yn = y, zn = z, mu, dx, dy, dz, e2, e3;
+    int i;
+
+    for (i = 0; i < 100; i++)
+    {
+        double lambda = sqrt(xn) * sqrt(yn) + sqrt(xn) * sqrt(zn) + sqrt(yn) * sqrt(zn);
+        mu = (xn + yn + zn) / 3.0;
+        dx = 1.0 - xn / mu; dy = 1.0 - yn / mu; dz = 1.0 - zn / mu;
+        if (fmax(fabs(dx), fmax(fabs(dy), fabs(dz))) < 1e-4) break;
+        xn = (xn + lambda) / 4.0; yn = (yn + lambda) / 4.0; zn = (zn + lambda) / 4.0;
+    }
+    mu = (xn + yn + zn) / 3.0;
+    dx = 1.0 - xn / mu; dy = 1.0 - yn / mu; dz = -dx - dy;
+    e2 = dx * dy - dz * dz;
+    e3 = dx * dy * dz;
+    return (1.0 - e2 / 10.0 + e3 / 14.0 + e2 * e2 / 24.0 - 3.0 * e2 * e3 / 44.0
+            - 5.0 * e2 * e2 * e2 / 208.0 + 3.0 * e3 * e3 / 104.0 + e2 * e2 * e3 / 16.0) / sqrt(mu);
+}
+
+/* R_C(1, 1 + e) */
+static double carlson_rc1(double e)
+{
+    if (e > 0) return atan(sqrt(e)) / sqrt(e);
+    if (e < 0) return atanh(sqrt(-e)) / sqrt(-e);
+    return 1.0;
+}
+
+static double carlson_rd(double x, double y, double z)
+{
+    double sum = 0.0, fac = 1.0, a, dx, dy, dz, e2, e3, e4, e5;
+    int i;
+
+    for (i = 0; i < 100; i++)
+    {
+        double lambda = sqrt(x) * sqrt(y) + sqrt(x) * sqrt(z) + sqrt(y) * sqrt(z);
+
+        a = (x + y + 3.0 * z) / 5.0;
+        dx = 1.0 - x / a; dy = 1.0 - y / a; dz = 1.0 - z / a;
+        if (fmax(fabs(dx), fmax(fabs(dy), fabs(dz))) < 1e-3) break;
+        sum += fac / (sqrt(z) * (z + lambda));
+        fac /= 4.0;
+        x = (x + lambda) / 4.0; y = (y + lambda) / 4.0; z = (z + lambda) / 4.0;
+    }
+    dz = -(dx + dy) / 3.0;
+    e2 = dx * dy - 6.0 * dz * dz;
+    e3 = (3.0 * dx * dy - 8.0 * dz * dz) * dz;
+    e4 = 3.0 * (dx * dy - dz * dz) * dz * dz;
+    e5 = dx * dy * dz * dz * dz;
+    return fac / (a * sqrt(a)) * (1.0 - 3.0 * e2 / 14.0 + e3 / 6.0 + 9.0 * e2 * e2 / 88.0 - 3.0 * e4 / 22.0
+            - 9.0 * e2 * e3 / 52.0 + 3.0 * e5 / 26.0) + 3.0 * sum;
+}
+
+/* p > 0 */
+static double carlson_rj(double x, double y, double z, double p)
+{
+    double sum = 0.0, fac = 1.0, a, dx, dy, dz, dp, e2, e3, e4, e5, xyz;
+    double delta = (p - x) * (p - y) * (p - z);
+    int i;
+
+    for (i = 0; i < 100; i++)
+    {
+        double sx = sqrt(x), sy = sqrt(y), sz = sqrt(z), sp = sqrt(p);
+        double lambda = sx * sy + sx * sz + sy * sz, d = (sp + sx) * (sp + sy) * (sp + sz);
+
+        a = (x + y + z + 2.0 * p) / 5.0;
+        dx = 1.0 - x / a; dy = 1.0 - y / a; dz = 1.0 - z / a;
+        if (fmax(fmax(fabs(dx), fabs(dy)), fmax(fabs(dz), fabs(1.0 - p / a))) < 1e-3) break;
+        sum += fac / d * carlson_rc1(fac * fac * fac * delta / (d * d));
+        fac /= 4.0;
+        x = (x + lambda) / 4.0; y = (y + lambda) / 4.0; z = (z + lambda) / 4.0; p = (p + lambda) / 4.0;
+    }
+    dp = -(dx + dy + dz) / 2.0;
+    xyz = dx * dy * dz;
+    e2 = dx * dy + dx * dz + dy * dz - 3.0 * dp * dp;
+    e3 = xyz + 2.0 * e2 * dp + 4.0 * dp * dp * dp;
+    e4 = (2.0 * xyz + e2 * dp + 3.0 * dp * dp * dp) * dp;
+    e5 = xyz * dp * dp;
+    return fac / (a * sqrt(a)) * (1.0 - 3.0 * e2 / 14.0 + e3 / 6.0 + 9.0 * e2 * e2 / 88.0 - 3.0 * e4 / 22.0
+            - 9.0 * e2 * e3 / 52.0 + 3.0 * e5 / 26.0) + 6.0 * sum;
+}
+
+/* elliptic integrals: F, E and Pi for |phi| <= pi/2, then by periodicity */
+
+static double ell_f(double k, double phi)
+{
+    double s = sin(phi), c = cos(phi);
+    return s * carlson_rf(c * c, (1.0 - k * s) * (1.0 + k * s), 1.0);
+}
+
+static double ell_e(double k, double phi)
+{
+    double s = sin(phi), c = cos(phi), q = (1.0 - k * s) * (1.0 + k * s);
+    return s * carlson_rf(c * c, q, 1.0) - k * k * s * s * s / 3.0 * carlson_rd(c * c, q, 1.0);
+}
+
+static double ell_pi(double k, double nu, double phi)
+{
+    double s = sin(phi), c = cos(phi), q = (1.0 - k * s) * (1.0 + k * s);
+    return s * carlson_rf(c * c, q, 1.0) + nu * s * s * s / 3.0 * carlson_rj(c * c, q, 1.0, 1.0 - nu * s * s);
+}
+
+static double smf_comp_ellint_1(double k)
+{
+    if (isnan(k)) return k;
+    if (fabs(k) > 1.0) return smf_nan();
+    if (fabs(k) == 1.0) return INFINITY;
+    return carlson_rf(0.0, (1.0 - k) * (1.0 + k), 1.0);
+}
+
+static double smf_comp_ellint_2(double k)
+{
+    double q;
+
+    if (isnan(k)) return k;
+    if (fabs(k) > 1.0) return smf_nan();
+    if (fabs(k) == 1.0) return 1.0;
+    q = (1.0 - k) * (1.0 + k);
+#ifdef SG_MUTANT_ELLINT2_NO_RD
+    return carlson_rf(0.0, q, 1.0);
+#endif
+    return carlson_rf(0.0, q, 1.0) - k * k / 3.0 * carlson_rd(0.0, q, 1.0);
+}
+
+static double smf_comp_ellint_3(double k, double nu)
+{
+    double q;
+
+    if (isnan(k) || isnan(nu)) return k + nu;
+    if (fabs(k) > 1.0 || nu > 1.0) return smf_nan();
+    if (fabs(k) == 1.0 || nu == 1.0) return INFINITY;
+    q = (1.0 - k) * (1.0 + k);
+    return carlson_rf(0.0, q, 1.0) + nu / 3.0 * carlson_rj(0.0, q, 1.0, 1.0 - nu);
+}
+
+static double smf_ellint(int kind, double k, double nu, double phi)
+{
+    double n, rest, complete, part;
+
+    if (isnan(k) || isnan(nu) || isnan(phi)) return k + nu + phi;
+    if (fabs(k) > 1.0 || !isfinite(phi)) return smf_nan();
+    n = floor(phi / SMF_PI + 0.5);
+    rest = phi - n * SMF_PI;
+    if (kind == 3 && nu * sin(rest) * sin(rest) >= 1.0) return smf_nan();
+    if (kind == 1) part = ell_f(k, rest);
+    else if (kind == 2) part = ell_e(k, rest);
+    else part = ell_pi(k, nu, rest);
+    if (!n) return part;
+    if (kind == 1) complete = smf_comp_ellint_1(k);
+    else if (kind == 2) complete = smf_comp_ellint_2(k);
+    else complete = smf_comp_ellint_3(k, nu);
+    return 2.0 * n * complete + part;
+}
+
+/* exponential integral Ei */
+
+static double smf_expint(double x)
+{
+    double sum, term, z;
+    int k;
+
+    if (isnan(x)) return x;
+    if (x == 0.0) return -INFINITY;
+    if (x > 0)
+    {
+        if (x < 40.0)
+        {
+            sum = 0.0;
+            term = 1.0;
+            for (k = 1; k < 500; k++)
+            {
+                term *= x / k;
+                sum += term / k;
+                if (term / k < sum * DBL_EPSILON * 0.5) break;
+            }
+            return SMF_EULER + log(x) + sum;
+        }
+        if (x > 710.0) return INFINITY;
+        /* asymptotic: e^x/x sum k!/x^k, up to the smallest term */
+        sum = 1.0;
+        term = 1.0;
+        for (k = 1; k < 100; k++)
+        {
+            double next = term * k / x;
+            if (next >= term || next < DBL_EPSILON * sum) break;
+            term = next;
+            sum += term;
+        }
+        return exp(x) / x * sum;
+    }
+    /* Ei(x) = -E1(-x) */
+    z = -x;
+    if (z <= 1.0)
+    {
+        sum = 0.0;
+        term = 1.0;
+        for (k = 1; k < 100; k++)
+        {
+            term *= -z / k;
+            sum += term / k;
+            if (fabs(term / k) < fabs(sum) * DBL_EPSILON * 0.5) break;
+        }
+        return SMF_EULER + log(z) + sum;
+    }
+    if (z > 745.0) return -0.0;
+    /* E1 by its continued fraction (modified Lentz) */
+    {
+        double b = z + 1.0, c = 1.0 / DBL_MIN, d = 1.0 / b, h = d, an, del;
+        for (k = 1; k < 1000; k++)
+        {
+            an = -(double)k * k;
+            b += 2.0;
+            d = 1.0 / (an * d + b);
+            c = b + an / c;
+            del = c * d;
+            h *= del;
+            if (fabs(del - 1.0) < DBL_EPSILON) break;
+        }
+        return -h * exp(-z);
+    }
+}
+
+/* Riemann zeta */
+
+static double zeta_borwein(double s)
+{
+    /* eta(s) = (1 - 2^(1-s)) zeta(s), Borwein's algorithm 2 with n = 40 */
+    enum { N = 40 };
+    double d[N + 1], e = 1.0 / N, sum = 0.0, eta;
+    int i, k;
+
+    d[0] = N * e;
+    for (i = 1; i <= N; i++)
+    {
+        e *= 4.0 * (N + i - 1) * (N - i + 1) / ((2.0 * i - 1) * (2.0 * i));
+        d[i] = d[i - 1] + N * e;
+    }
+    for (k = 0; k < N; k++)
+        sum += (k & 1 ? -1.0 : 1.0) * (d[k] - d[N]) / pow(k + 1.0, s);
+    eta = -sum / d[N];
+    return eta / -expm1((1.0 - s) * log(2.0));
+}
+
+static double smf_riemann_zeta(double s)
+{
+    if (isnan(s)) return s;
+    if (s == 1.0) return smf_nan();
+    if (s == 0.0) return -0.5;
+    if (s > 56.0) return 1.0 + pow(2.0, -s) + pow(3.0, -s);
+    if (s >= 0.0) return zeta_borwein(s);
+    /* reflection: zeta(s) = 2^s pi^(s-1) sin(pi s/2) gamma(1-s) zeta(1-s) */
+    if (s == floor(s) && fmod(s, 2.0) == 0.0) return 0.0;  /* trivial zeros */
+    if (1.0 - s > 170.0)
+    {
+        double l = s * log(2.0) + (s - 1.0) * log(SMF_PI) + lgamma(1.0 - s), sn = sin(SMF_PI * fmod(s, 4.0) / 2.0);
+        return sn * exp(l) * zeta_borwein(1.0 - s);
+    }
+    return pow(2.0, s) * pow(SMF_PI, s - 1.0) * sin(SMF_PI * fmod(s, 4.0) / 2.0) * tgamma(1.0 - s)
+            * smf_riemann_zeta(1.0 - s);
+}
+
+/* Bessel functions */
+
+/* sin(pi v) and cos(pi v), exact at the multiples of 1/2 */
+static double smf_sinpi(double v)
+{
+    double r = fmod(v, 2.0);
+    if (r == 0.0 || r == 1.0 || r == -1.0) return 0.0;
+    if (r == 0.5 || r == -1.5) return 1.0;
+    if (r == -0.5 || r == 1.5) return -1.0;
+    return sin(SMF_PI * r);
+}
+
+static double smf_cospi(double v)
+{
+    return smf_sinpi(v + 0.5);
+}
+
+typedef double (*integrand_func)(double t, const double *prm);
+
+/* Gauss-Kronrod 7/15 nodes and weights */
+static const double gk_x[8] =
+{
+    0.991455371120812639206854697526329, 0.949107912342758524526189684047851,
+    0.864864423359769072789712788640926, 0.741531185599394439863864773280788,
+    0.586087235467691130294144845693013, 0.405845151377397166906606412076961,
+    0.207784955007898467600689403773245, 0.0,
+};
+static const double gk_wk[8] =
+{
+    0.022935322010529224963732008058970, 0.063092092629978553290700663189204,
+    0.104790010322250183839876322541518, 0.140653259715525918745189590510238,
+    0.169004726639267902826583426598550, 0.190350578064785409913256402421014,
+    0.204432940075298892414161999234649, 0.209482141084727828012999174891714,
+};
+static const double gk_wg[4] =
+{
+    0.129484966168869693270611432679082, 0.279705391489276667901467771423780,
+    0.381830050505118944950369775488975, 0.417959183673469387755102040816327,
+};
+
+static double gk15(integrand_func f, const double *prm, double a, double b, double *err)
+{
+    double c = (a + b) / 2.0, h = (b - a) / 2.0, fv[15], k, g, mean, asc;
+    int i;
+
+    fv[7] = f(c, prm);
+    k = fv[7] * gk_wk[7];
+    g = fv[7] * gk_wg[3];
+    for (i = 0; i < 7; i++)
+    {
+        fv[i] = f(c - h * gk_x[i], prm);
+        fv[14 - i] = f(c + h * gk_x[i], prm);
+        k += gk_wk[i] * (fv[i] + fv[14 - i]);
+        if (i & 1) g += gk_wg[i / 2] * (fv[i] + fv[14 - i]);
+    }
+    /* the error estimate of QUADPACK's qk15 */
+    mean = k / 2.0;
+    asc = gk_wk[7] * fabs(fv[7] - mean);
+    for (i = 0; i < 7; i++) asc += gk_wk[i] * (fabs(fv[i] - mean) + fabs(fv[14 - i] - mean));
+    asc *= fabs(h);
+    *err = fabs((k - g) * h);
+    if (asc != 0.0 && *err != 0.0) *err = asc * fmin(1.0, pow(200.0 * *err / asc, 1.5));
+    return k * h;
+}
+
+static double integrate(integrand_func f, const double *prm, double a, double b, double tol, int depth)
+{
+    double err, r = gk15(f, prm, a, b, &err);
+
+    if (err <= tol || err <= fabs(r) * 2e-16 || depth >= 20) return r;
+    return integrate(f, prm, a, (a + b) / 2.0, tol / 2.0, depth + 1) +
+           integrate(f, prm, (a + b) / 2.0, b, tol / 2.0, depth + 1);
+}
+
+/* the integral of a positive function to a relative precision */
+static double integrate_rel(integrand_func f, const double *prm, double a, double b)
+{
+    double err, r = gk15(f, prm, a, b, &err);
+    return integrate(f, prm, a, b, fabs(r) * 1e-15, 0);
+}
+
+/* the integral over [a, b] cut into n panels */
+static double integrate_panels(integrand_func f, const double *prm, double a, double b, int n, double tol)
+{
+    double sum = 0.0, h = (b - a) / n;
+    int i;
+
+    for (i = 0; i < n; i++) sum += integrate(f, prm, a + i * h, i == n - 1 ? b : a + (i + 1) * h, tol * h, 0);
+    return sum;
+}
+
+/* prm: nu, x, and an exponent to scale by */
+static double jy_osc_cos(double t, const double *prm) { return cos(prm[0] * t - prm[1] * sin(t)); }
+static double jy_osc_sin(double t, const double *prm) { return sin(prm[1] * sin(t) - prm[0] * t); }
+static double j_tail(double t, const double *prm) { return exp(-prm[1] * sinh(t) - prm[0] * t); }
+static double y_tail(double t, const double *prm)
+{
+    return exp(prm[0] * t - prm[1] * sinh(t) - prm[2]) * (1.0 + exp(-2.0 * prm[0] * t) * smf_cospi(prm[0]));
+}
+static double k_integrand(double t, const double *prm)
+{
+    return exp(prm[0] * t - prm[1] * cosh(t) - prm[2]) * (1.0 + exp(-2.0 * prm[0] * t)) / 2.0;
+}
+
+/* the end of [0, inf) past which exp(lg(t) - max) is negligible, lg concave */
+static double tail_end(double nu, double x, double tmax, double max, int k)
+{
+    double t = tmax + 1.0;
+    int i;
+
+    for (i = 0; i < 200; i++)
+    {
+        double lg = nu * t - x * (k ? cosh(t) : sinh(t));
+        if (lg - max < -60.0) break;
+        t = t * 1.5 + 0.5;
+    }
+    return t;
+}
+
+static int bessel_is_int(double nu)
+{
+    return nu == floor(nu);
+}
+
+/* Hankel's expansion for large x; returns 0 when it does not reach precision */
+static int bessel_hankel(double nu, double x, double *j, double *y)
+{
+    double mu = 4.0 * nu * nu, t = 1.0, p = 1.0, q = 0.0, phi, c, s, f;
+    int k;
+
+    for (k = 1; k < 200; k++)
+    {
+        double next = t * (mu - (2.0 * k - 1) * (2.0 * k - 1)) / (k * 8.0 * x);
+        if (fabs(next) >= fabs(t) && k > 1) return 0;
+        t = next;
+        if (k & 1) q += (k & 2 ? -t : t);
+        else p += (k & 2 ? -t : t);
+        if (fabs(t) < DBL_EPSILON * 0.25 * fmax(fabs(p), fabs(q))) break;
+    }
+    phi = (nu / 2.0 + 0.25) * SMF_PI;
+    c = cos(x) * cos(phi) + sin(x) * sin(phi);
+    s = sin(x) * cos(phi) - cos(x) * sin(phi);
+    f = sqrt(2.0 / (SMF_PI * x));
+    if (j) *j = f * (p * c - q * s);
+    if (y) *y = f * (p * s + q * c);
+    return 1;
+}
+
+static double bessel_j_series(double nu, double x)
+{
+    double term = nu ? exp(nu * log(x / 2.0) - lgamma(nu + 1.0)) : 1.0, sum = term, q = x * x / 4.0;
+    int k;
+
+    for (k = 1; k < 1000; k++)
+    {
+        term *= -q / (k * (k + nu));
+        sum += term;
+        if (fabs(term) < DBL_EPSILON * 0.25 * fabs(sum) && k > x / 2.0) break;
+    }
+    return sum;
+}
+
+/* J and Y for nu >= 0, x > 0 */
+static void bessel_jy(double nu, double x, double *j, double *y)
+{
+    double prm[3] = {nu, x, 0.0};
+    int panels;
+
+    if (x >= 30.0 && x >= nu * nu && bessel_hankel(nu, x, j, y)) return;
+
+    panels = (int)((x + nu) / 4.0) + 2;
+    if (j)
+    {
+        /* the series while its terms stay below 1 (no harmful cancellation),
+         * then Schlaefli's integral */
+        if (x < 4.0 || x * x < 4.0 * (nu + 1.0) ||
+                nu * log(x / 2.0) - lgamma(nu + 1.0) + x * x / (4.0 * (nu + 1.0)) < 0.0)
+            *j = bessel_j_series(nu, x);
+        else
+        {
+            *j = integrate_panels(jy_osc_cos, prm, 0.0, SMF_PI, panels, 1e-16) / SMF_PI;
+            if (!bessel_is_int(nu))
+                *j -= smf_sinpi(nu) / SMF_PI * integrate_rel(j_tail, prm, 0.0, tail_end(-nu, x, 0.0, 0.0, 0));
+        }
+    }
+    if (y)
+    {
+        double tmax = nu > x ? acosh(nu / x) : 0.0, max = nu * tmax - x * sinh(tmax), tail;
+
+        prm[2] = max;
+        tail = integrate_rel(y_tail, prm, 0.0, tail_end(nu, x, tmax, max, 0));
+        *y = integrate_panels(jy_osc_sin, prm, 0.0, SMF_PI, panels, 1e-16) / SMF_PI - tail * exp(max) / SMF_PI;
+    }
+}
+
+static double bessel_k_pos(double nu, double x)
+{
+    double prm[3] = {nu, x, 0.0}, tmax = asinh(nu / x), max = nu * tmax - x * cosh(tmax), r;
+
+    if (x >= 30.0 && x >= nu * nu)
+    {
+        /* Hankel's expansion */
+        double mu = 4.0 * nu * nu, t = 1.0, s = 1.0;
+        int k;
+
+        for (k = 1; k < 200; k++)
+        {
+            double next = t * (mu - (2.0 * k - 1) * (2.0 * k - 1)) / (k * 8.0 * x);
+            if (fabs(next) >= fabs(t) && k > 1) break;
+            t = next;
+            s += t;
+            if (fabs(t) < DBL_EPSILON * 0.25 * s) break;
+        }
+        return sqrt(SMF_PI / (2.0 * x)) * exp(-x) * s;
+    }
+    prm[2] = max;
+    r = integrate_rel(k_integrand, prm, 0.0, tail_end(nu, x, tmax, max, 1));
+#ifdef SG_MUTANT_BESSEL_K_NO_SCALE
+    return r;
+#endif
+    return r * exp(max);
+}
+
+static double bessel_i_pos(double nu, double x)
+{
+    double term, sum, q = x * x / 4.0;
+    int k;
+
+    if (x > 700.0)
+    {
+        double mu = 4.0 * nu * nu, t = 1.0, s = 1.0;
+        for (k = 1; k < 100; k++)
+        {
+            double next = -t * (mu - (2.0 * k - 1) * (2.0 * k - 1)) / (k * 8.0 * x);
+            if (fabs(next) >= fabs(t) || fabs(next) < DBL_EPSILON * 0.25) break;
+            t = next;
+            s += t;
+        }
+        return exp(x) / sqrt(2.0 * SMF_PI * x) * s;
+    }
+    term = nu ? exp(nu * log(x / 2.0) - lgamma(nu + 1.0)) : 1.0;
+    sum = term;
+    for (k = 1; k < 5000; k++)
+    {
+        term *= q / (k * (k + nu));
+        sum += term;
+        if (term < DBL_EPSILON * 0.25 * sum && k > x / 2.0) break;
+    }
+    return sum;
+}
+
+static double smf_cyl_bessel_j(double nu, double x)
+{
+    double j, y;
+
+    if (isnan(nu) || isnan(x)) return nu + x;
+    if (x < 0) return smf_nan();
+    if (x == 0) return nu == 0 ? 1.0 : (nu > 0 || bessel_is_int(nu) ? 0.0 : INFINITY);
+    if (nu >= 0)
+    {
+        bessel_jy(nu, x, &j, NULL);
+        return j;
+    }
+    if (bessel_is_int(nu))
+    {
+        bessel_jy(-nu, x, &j, NULL);
+        return fmod(-nu, 2.0) ? -j : j;
+    }
+    bessel_jy(-nu, x, &j, &y);
+    return smf_cospi(-nu) * j - smf_sinpi(-nu) * y;
+}
+
+static double smf_cyl_neumann(double nu, double x)
+{
+    double j, y;
+
+    if (isnan(nu) || isnan(x)) return nu + x;
+    if (x < 0) return smf_nan();
+    if (x == 0) return -INFINITY;
+    if (nu >= 0)
+    {
+        bessel_jy(nu, x, NULL, &y);
+        return y;
+    }
+    if (bessel_is_int(nu))
+    {
+        bessel_jy(-nu, x, NULL, &y);
+        return fmod(-nu, 2.0) ? -y : y;
+    }
+    bessel_jy(-nu, x, &j, &y);
+    return smf_sinpi(-nu) * j + smf_cospi(-nu) * y;
+}
+
+static double smf_cyl_bessel_i(double nu, double x)
+{
+    double i;
+
+    if (isnan(nu) || isnan(x)) return nu + x;
+    if (x < 0) return smf_nan();
+    if (x == 0) return nu == 0 ? 1.0 : (nu > 0 || bessel_is_int(nu) ? 0.0 : INFINITY);
+    i = bessel_i_pos(fabs(nu), x);
+    if (nu < 0 && !bessel_is_int(nu)) i += 2.0 / SMF_PI * smf_sinpi(-nu) * bessel_k_pos(-nu, x);
+    return i;
+}
+
+static double smf_cyl_bessel_k(double nu, double x)
+{
+    if (isnan(nu) || isnan(x)) return nu + x;
+    if (x < 0) return smf_nan();
+    if (x == 0) return INFINITY;
+    return bessel_k_pos(fabs(nu), x);
+}
+
+static double smf_sph_bessel(unsigned int n, double x)
+{
+    if (isnan(x)) return x;
+    if (x < 0) return smf_nan();
+    if (x == 0) return n ? 0.0 : 1.0;
+    if (!n) return sin(x) / x;
+    return sqrt(SMF_PI / (2.0 * x)) * smf_cyl_bessel_j(n + 0.5, x);
+}
+
+static double smf_sph_neumann(unsigned int n, double x)
+{
+    double y0, y1, y2;
+    unsigned int k;
+
+    if (isnan(x)) return x;
+    if (x < 0) return smf_nan();
+    if (x == 0) return -INFINITY;
+    y0 = -cos(x) / x;
+    if (!n) return y0;
+    y1 = (y0 - sin(x)) / x;
+    for (k = 1; k < n && isfinite(y1); k++)
+    {
+        y2 = (2.0 * k + 1.0) / x * y1 - y0;
+        y0 = y1;
+        y1 = y2;
+    }
+    return y1;
+}
+
+/* the exports */
+
+#define SMF1(name, call) \
+double __stdcall __std_smf_##name(double a) { return call; } \
+float __stdcall __std_smf_##name##f(float a) { return __std_smf_##name(a); }
+#define SMF2(name, t1, t2, call) \
+double __stdcall __std_smf_##name(t1 a, t2 b) { return call; }
+#define SMF2F(name, t1, t2, f1, f2) \
+float __stdcall __std_smf_##name##f(f1 a, f2 b) { return __std_smf_##name(a, b); }
+#define SMF3(name, t1, t2, t3, call) \
+double __stdcall __std_smf_##name(t1 a, t2 b, t3 c) { return call; }
+#define SMF3F(name, f1, f2, f3) \
+float __stdcall __std_smf_##name##f(f1 a, f2 b, f3 c) { return __std_smf_##name(a, b, c); }
+
+SMF1(comp_ellint_1, smf_comp_ellint_1(a))
+SMF1(comp_ellint_2, smf_comp_ellint_2(a))
+SMF1(expint, smf_expint(a))
+SMF1(riemann_zeta, smf_riemann_zeta(a))
+
+SMF2(beta, double, double, smf_beta(a, b))
+SMF2F(beta, double, double, float, float)
+SMF2(comp_ellint_3, double, double, smf_comp_ellint_3(a, b))
+SMF2F(comp_ellint_3, double, double, float, float)
+SMF2(cyl_bessel_i, double, double, smf_cyl_bessel_i(a, b))
+SMF2F(cyl_bessel_i, double, double, float, float)
+SMF2(cyl_bessel_j, double, double, smf_cyl_bessel_j(a, b))
+SMF2F(cyl_bessel_j, double, double, float, float)
+SMF2(cyl_bessel_k, double, double, smf_cyl_bessel_k(a, b))
+SMF2F(cyl_bessel_k, double, double, float, float)
+SMF2(cyl_neumann, double, double, smf_cyl_neumann(a, b))
+SMF2F(cyl_neumann, double, double, float, float)
+SMF2(ellint_1, double, double, smf_ellint(1, a, 0.0, b))
+SMF2F(ellint_1, double, double, float, float)
+SMF2(ellint_2, double, double, smf_ellint(2, a, 0.0, b))
+SMF2F(ellint_2, double, double, float, float)
+SMF2(hermite, unsigned int, double, smf_hermite(a, b))
+SMF2F(hermite, unsigned int, double, unsigned int, float)
+SMF2(laguerre, unsigned int, double, smf_assoc_laguerre(a, 0, b))
+SMF2F(laguerre, unsigned int, double, unsigned int, float)
+SMF2(legendre, unsigned int, double, smf_legendre(a, b))
+SMF2F(legendre, unsigned int, double, unsigned int, float)
+SMF2(sph_bessel, unsigned int, double, smf_sph_bessel(a, b))
+SMF2F(sph_bessel, unsigned int, double, unsigned int, float)
+SMF2(sph_neumann, unsigned int, double, smf_sph_neumann(a, b))
+SMF2F(sph_neumann, unsigned int, double, unsigned int, float)
+
+SMF3(assoc_laguerre, unsigned int, unsigned int, double, smf_assoc_laguerre(a, b, c))
+SMF3F(assoc_laguerre, unsigned int, unsigned int, float)
+SMF3(assoc_legendre, unsigned int, unsigned int, double, smf_assoc_legendre(a, b, c))
+SMF3F(assoc_legendre, unsigned int, unsigned int, float)
+SMF3(ellint_3, double, double, double, smf_ellint(3, a, b, c))
+SMF3F(ellint_3, float, float, float)
+SMF3(sph_legendre, unsigned int, unsigned int, double, smf_sph_legendre(a, b, c))
+SMF3F(sph_legendre, unsigned int, unsigned int, float)
