+
+static unsigned int mask_scale(ULONG pixel, ULONG mask)
+{
+    unsigned int shift = 0, bits = 0, value;
+
+    if (!mask)
+        return 255;
+    while (!((mask >> shift) & 1))
+        ++shift;
+    while ((mask >> (shift + bits)) & 1)
+        ++bits;
+    value = (pixel & mask) >> shift;
+    if (bits >= 8)
+        return value >> (bits - 8);
+    return value * 255 / ((1u << bits) - 1);
+}
+
+/* A surface the Direct3D device can draw with, made from the image of a texture that has no surface of its own
+ * (8 bit palettized, or 16, 24 and 32 bit with colour masks). Returned referenced. */
+IDirectDrawSurface *d3drm_texture_get_render_surface(IUnknown *unk, IDirectDraw *ddraw)
+{
+    IDirect3DRMTexture3 *texture3;
+    struct d3drm_texture *texture;
+    IDirectDrawSurface *surface = NULL;
+    DDSURFACEDESC desc;
+    D3DRMIMAGE *image;
+    int x, y;
+
+    if (!unk || FAILED(IUnknown_QueryInterface(unk, &IID_IDirect3DRMTexture3, (void **)&texture3)))
+        return NULL;
+    texture = impl_from_IDirect3DRMTexture3(texture3);
+    IDirect3DRMTexture3_Release(texture3);
+
+    if (texture->surface)
+    {
+        IDirectDrawSurface_AddRef(texture->surface);
+        return texture->surface;
+    }
+    if (!(image = texture->image) || !ddraw || image->width <= 0 || image->height <= 0)
+        return NULL;
+    if (texture->render_surface && texture->render_ddraw == ddraw && !texture->render_dirty)
+    {
+        IDirectDrawSurface_AddRef(texture->render_surface);
+        return texture->render_surface;
+    }
+    if (texture->render_surface)
+    {
+        IDirectDrawSurface_Release(texture->render_surface);
+        texture->render_surface = NULL;
+    }
+    if (image->rgb ? (image->depth != 16 && image->depth != 24 && image->depth != 32)
+            : (image->depth != 8 || !image->palette))
+        return NULL;
+
+    memset(&desc, 0, sizeof(desc));
+    desc.dwSize = sizeof(desc);
+    desc.dwFlags = DDSD_CAPS | DDSD_WIDTH | DDSD_HEIGHT | DDSD_PIXELFORMAT;
+    desc.dwWidth = image->width;
+    desc.dwHeight = image->height;
+    desc.ddsCaps.dwCaps = DDSCAPS_TEXTURE | DDSCAPS_SYSTEMMEMORY;
+    desc.ddpfPixelFormat.dwSize = sizeof(desc.ddpfPixelFormat);
+    desc.ddpfPixelFormat.dwFlags = DDPF_RGB | DDPF_ALPHAPIXELS;
+    desc.ddpfPixelFormat.dwRGBBitCount = 32;
+    desc.ddpfPixelFormat.dwRBitMask = 0x00ff0000;
+    desc.ddpfPixelFormat.dwGBitMask = 0x0000ff00;
+    desc.ddpfPixelFormat.dwBBitMask = 0x000000ff;
+    desc.ddpfPixelFormat.dwRGBAlphaBitMask = 0xff000000;
+    if (FAILED(IDirectDraw_CreateSurface(ddraw, &desc, &surface, NULL)))
+        return NULL;
+
+    memset(&desc, 0, sizeof(desc));
+    desc.dwSize = sizeof(desc);
+    if (FAILED(IDirectDrawSurface_Lock(surface, NULL, &desc, DDLOCK_WAIT, NULL)))
+    {
+        IDirectDrawSurface_Release(surface);
+        return NULL;
+    }
+    for (y = 0; y < image->height; ++y)
+    {
+        const BYTE *src = (const BYTE *)image->buffer1 + (SIZE_T)y * image->bytes_per_line;
+        DWORD *dst = (DWORD *)((BYTE *)desc.lpSurface + (SIZE_T)y * desc.lPitch);
+
+        for (x = 0; x < image->width; ++x)
+        {
+            unsigned int r, g, b, a = 255;
+
+            if (!image->rgb)
+            {
+                unsigned int idx = src[x];
+
+                if ((int)idx >= image->palette_size)
+                    idx = 0;
+                r = image->palette[idx].red;
+                g = image->palette[idx].green;
+                b = image->palette[idx].blue;
+            }
+            else
+            {
+                ULONG pixel = 0;
+
+                if (image->depth == 16)
+                    pixel = src[x * 2] | (src[x * 2 + 1] << 8);
+                else if (image->depth == 24)
+                    pixel = src[x * 3] | (src[x * 3 + 1] << 8) | (src[x * 3 + 2] << 16);
+                else
+                    pixel = src[x * 4] | (src[x * 4 + 1] << 8) | (src[x * 4 + 2] << 16) | ((ULONG)src[x * 4 + 3] << 24);
+                r = mask_scale(pixel, image->red_mask);
+                g = mask_scale(pixel, image->green_mask);
+                b = mask_scale(pixel, image->blue_mask);
+                if (image->alpha_mask)
+                    a = mask_scale(pixel, image->alpha_mask);
+            }
+            dst[x] = (a << 24) | (r << 16) | (g << 8) | b;
+        }
+    }
+    IDirectDrawSurface_Unlock(surface, NULL);
+
+    texture->render_surface = surface;
+    texture->render_ddraw = ddraw;
+    texture->render_dirty = FALSE;
+    IDirectDrawSurface_AddRef(surface);
+    return surface;
+}
