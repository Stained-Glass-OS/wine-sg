+
+/* Moller-Trumbore, both sides; u and v are the barycentric weights of the second and third vertex. */
+static BOOL ray_triangle(const D3DVECTOR *o, const D3DVECTOR *d, const D3DVECTOR *a, const D3DVECTOR *b,
+        const D3DVECTOR *c, float *t, float *bu, float *bv)
+{
+    D3DVECTOR e1 = vec_sub(b, a), e2 = vec_sub(c, a), pv = vec_cross(d, &e2), tv, qv;
+    float det = vec_dot(&e1, &pv), u, v;
+
+    if (fabsf(det) < 1e-12f)
+        return FALSE;
+    det = 1.0f / det;
+    tv = vec_sub(o, a);
+    u = vec_dot(&tv, &pv) * det;
+    if (u < 0.0f || u > 1.0f)
+        return FALSE;
+    qv = vec_cross(&tv, &e1);
+    v = vec_dot(d, &qv) * det;
+    if (v < 0.0f || u + v > 1.0f)
+        return FALSE;
+    *t = vec_dot(&e2, &qv) * det;
+    *bu = u;
+    *bv = v;
+    return *t > 0.0f;
+}
+
+struct pick_state
+{
+    D3DVECTOR origin, dir;           /* world space */
+    DWORD flags;
+    struct pick_entry *entries;
+    SIZE_T count, size;
+    HRESULT error;
+};
+
+struct pick_polygon
+{
+    LONG group;
+    ULONG face;
+    unsigned int n;
+    D3DVECTOR pos[8];                /* model space */
+    D3DVECTOR normal[8];
+    float uv[16];
+    D3DCOLOR color;
+};
+
+static void pick_visual_polygon(struct pick_state *s, IDirect3DRMVisual *visual, struct d3drm_frame *frame,
+        const struct d3drm_matrix *world, const struct d3drm_matrix *inverse, const struct pick_polygon *poly)
+{
+    D3DVECTOR w[8], origin, dir;
+    unsigned int i;
+    float t, bu, bv;
+
+    if (poly->n < 3 || poly->n > 8)
+        return;
+    (void)inverse;
+    for (i = 0; i < poly->n; ++i)
+        w[i] = vec_point(&poly->pos[i], world);
+    origin = s->origin;
+    dir = s->dir;
+    for (i = 1; i + 1 < poly->n; ++i)
+    {
+        if (ray_triangle(&origin, &dir, &w[0], &w[i], &w[i + 1], &t, &bu, &bv))
+        {
+            struct pick_entry *e = NULL;
+            D3DVECTOR hit, model_hit, n0, n1, n2;
+            float w0 = 1.0f - bu - bv;
+            SIZE_T k;
+
+            for (k = 0; k < s->count; ++k)
+                if (s->entries[k].visual == visual && s->entries[k].frame == &frame->IDirect3DRMFrame3_iface)
+                {
+                    e = &s->entries[k];
+                    break;
+                }
+            if (e && e->dist <= t)
+                return;
+            if (!e)
+            {
+                if (!array_reserve((void **)&s->entries, &s->size, s->count + 1, sizeof(*s->entries)))
+                {
+                    s->error = E_OUTOFMEMORY;
+                    return;
+                }
+                e = &s->entries[s->count++];
+                e->visual = visual;
+                IDirect3DRMVisual_AddRef(visual);
+                e->frame = &frame->IDirect3DRMFrame3_iface;
+                IDirect3DRMFrame3_AddRef(e->frame);
+            }
+            hit.x = origin.x + dir.x * t;
+            hit.y = origin.y + dir.y * t;
+            hit.z = origin.z + dir.z * t;
+            model_hit = vec_point(&hit, inverse);
+            memset(&e->desc, 0, sizeof(e->desc));
+            e->dist = t;
+            e->desc.ulFaceIdx = poly->face;
+            e->desc.lGroupIdx = poly->group;
+            e->desc.vPosition = model_hit;
+            if (s->flags & D3DRMRAYPICK_INTERPOLATEUV)
+            {
+                e->desc.tu = w0 * poly->uv[0] + bu * poly->uv[i * 2] + bv * poly->uv[(i + 1) * 2];
+                e->desc.tv = w0 * poly->uv[1] + bu * poly->uv[i * 2 + 1] + bv * poly->uv[(i + 1) * 2 + 1];
+            }
+            if (s->flags & D3DRMRAYPICK_INTERPOLATECOLOR)
+                e->desc.dcColor = poly->color;
+            if (s->flags & D3DRMRAYPICK_INTERPOLATENORMAL)
+            {
+                n0 = poly->normal[0];
+                n1 = poly->normal[i];
+                n2 = poly->normal[i + 1];
+                e->desc.dvNormal.x = w0 * n0.x + bu * n1.x + bv * n2.x;
+                e->desc.dvNormal.y = w0 * n0.y + bu * n1.y + bv * n2.y;
+                e->desc.dvNormal.z = w0 * n0.z + bu * n1.z + bv * n2.z;
+                e->desc.dvNormal = vec_normalize(e->desc.dvNormal);
+            }
+            return;
+        }
+    }
+}
+
+/* Slab test of the ray against the box of the visual, in model space. */
+static BOOL ray_box(const D3DVECTOR *o, const D3DVECTOR *d, const D3DRMBOX *box, float *tmin_out)
+{
+    float tmin = 0.0f, tmax = 1e30f;
+    const float *bmin = &box->min.x, *bmax = &box->max.x, *po = &o->x, *pd = &d->x;
+    int i;
+
+    for (i = 0; i < 3; ++i)
+    {
+        if (fabsf(pd[i]) < 1e-12f)
+        {
+            if (po[i] < bmin[i] || po[i] > bmax[i])
+                return FALSE;
+        }
+        else
+        {
+            float t1 = (bmin[i] - po[i]) / pd[i], t2 = (bmax[i] - po[i]) / pd[i], tmp;
+
+            if (t1 > t2)
+            {
+                tmp = t1;
+                t1 = t2;
+                t2 = tmp;
+            }
+            tmin = max(tmin, t1);
+            tmax = min(tmax, t2);
+            if (tmin > tmax)
+                return FALSE;
+        }
+    }
+    *tmin_out = tmin;
+    return TRUE;
+}
+
+static void pick_visual(struct pick_state *s, struct d3drm_frame *frame, const struct d3drm_matrix *world,
+        IDirect3DRMVisual *visual)
+{
+    struct d3drm_matrix inverse;
+    IDirect3DRMMeshBuilder3 *builder;
+    IDirect3DRMMesh *mesh;
+
+    if (!d3drm_matrix_invert_affine(world, &inverse))
+        return;
+
+    if (SUCCEEDED(IDirect3DRMVisual_QueryInterface(visual, &IID_IDirect3DRMMeshBuilder3, (void **)&builder)))
+    {
+        IDirect3DRMFaceArray *faces = NULL;
+        DWORD i, count;
+
+        if (s->flags & D3DRMRAYPICK_ONLYBOUNDINGBOXES)
+        {
+            D3DRMBOX box;
+            D3DVECTOR o = vec_point(&s->origin, &inverse), d = vec_dir(&s->dir, &inverse);
+            float t;
+
+            if (SUCCEEDED(IDirect3DRMMeshBuilder3_GetBox(builder, &box)) && ray_box(&o, &d, &box, &t))
+            {
+                struct pick_polygon poly = { -1 };
+                D3DVECTOR hit_model = vec3(o.x + d.x * t, o.y + d.y * t, o.z + d.z * t);
+                D3DVECTOR hit = vec_point(&hit_model, world);
+                struct pick_entry *e;
+
+                if (array_reserve((void **)&s->entries, &s->size, s->count + 1, sizeof(*s->entries)))
+                {
+                    e = &s->entries[s->count++];
+                    e->visual = visual;
+                    IDirect3DRMVisual_AddRef(visual);
+                    e->frame = &frame->IDirect3DRMFrame3_iface;
+                    IDirect3DRMFrame3_AddRef(e->frame);
+                    memset(&e->desc, 0, sizeof(e->desc));
+                    e->desc.lGroupIdx = poly.group;
+                    e->desc.vPosition = hit_model;
+                    {
+                        D3DVECTOR rel = vec3(hit.x - s->origin.x, hit.y - s->origin.y, hit.z - s->origin.z);
+
+                        e->dist = vec_dot(&rel, &s->dir);
+                    }
+                }
+                else
+                    s->error = E_OUTOFMEMORY;
+            }
+        }
+        else if (SUCCEEDED(IDirect3DRMMeshBuilder3_GetFaces(builder, &faces)) && faces)
+        {
+            count = IDirect3DRMFaceArray_GetSize(faces);
+            for (i = 0; i < count; ++i)
+            {
+                IDirect3DRMFace *face1 = NULL;
+                IDirect3DRMFace2 *face = NULL;
+                struct pick_polygon poly;
+                DWORD n = 0, k;
+
+                if (FAILED(IDirect3DRMFaceArray_GetElement(faces, i, &face1)) || !face1)
+                    continue;
+                if (FAILED(IDirect3DRMFace_QueryInterface(face1, &IID_IDirect3DRMFace2, (void **)&face)))
+                {
+                    IDirect3DRMFace_Release(face1);
+                    continue;
+                }
+                IDirect3DRMFace_Release(face1);
+                memset(&poly, 0, sizeof(poly));
+                if (SUCCEEDED(IDirect3DRMFace2_GetVertices(face, &n, NULL, NULL)) && n >= 3 && n <= 8
+                        && SUCCEEDED(IDirect3DRMFace2_GetVertices(face, &n, poly.pos, poly.normal)))
+                {
+                    poly.group = -1;
+                    poly.face = i;
+                    poly.n = n;
+                    poly.color = IDirect3DRMFace2_GetColor(face);
+                    for (k = 0; k < n; ++k)
+                        IDirect3DRMFace2_GetTextureCoordinates(face, k, &poly.uv[k * 2], &poly.uv[k * 2 + 1]);
+                    pick_visual_polygon(s, visual, frame, world, &inverse, &poly);
+                }
+                IDirect3DRMFace2_Release(face);
+            }
+            IDirect3DRMFaceArray_Release(faces);
+        }
+        IDirect3DRMMeshBuilder3_Release(builder);
+    }
+    else if (SUCCEEDED(IDirect3DRMVisual_QueryInterface(visual, &IID_IDirect3DRMMesh, (void **)&mesh)))
+    {
+        unsigned int groups = IDirect3DRMMesh_GetGroupCount(mesh), g;
+
+        for (g = 0; g < groups; ++g)
+        {
+            unsigned int vcount = 0, fcount = 0, vpf = 0, *fdata = NULL, pos = 0, f;
+            DWORD fdata_size = 0;
+            D3DRMVERTEX *vertices = NULL;
+
+            if (FAILED(IDirect3DRMMesh_GetGroup(mesh, g, &vcount, &fcount, &vpf, &fdata_size, NULL)) || !fcount)
+                continue;
+            fdata = malloc(fdata_size * sizeof(*fdata));
+            vertices = malloc(vcount * sizeof(*vertices));
+            if (fdata && vertices
+                    && SUCCEEDED(IDirect3DRMMesh_GetGroup(mesh, g, &vcount, &fcount, &vpf, &fdata_size, fdata))
+                    && SUCCEEDED(IDirect3DRMMesh_GetVertices(mesh, g, 0, vcount, vertices)))
+            {
+                for (f = 0; f < fcount && pos < fdata_size; ++f)
+                {
+                    struct pick_polygon poly;
+                    unsigned int n = vpf ? vpf : fdata[pos++], k;
+
+                    if (n < 3 || n > 8 || pos + n > fdata_size)
+                        break;
+                    memset(&poly, 0, sizeof(poly));
+                    for (k = 0; k < n && fdata[pos + k] < vcount; ++k)
+                    {
+                        const D3DRMVERTEX *v = &vertices[fdata[pos + k]];
+
+                        poly.pos[k] = v->position;
+                        poly.normal[k] = v->normal;
+                        poly.uv[k * 2] = v->tu;
+                        poly.uv[k * 2 + 1] = v->tv;
+                        if (!k)
+                            poly.color = v->color;
+                    }
+                    pos += n;
+                    if (k == n)
+                    {
+                        poly.group = g;
+                        poly.face = f;
+                        poly.n = n;
+                        pick_visual_polygon(s, visual, frame, world, &inverse, &poly);
+                    }
+                }
+            }
+            free(fdata);
+            free(vertices);
+        }
+        IDirect3DRMMesh_Release(mesh);
+    }
+}
+
+static void pick_frame(struct pick_state *s, struct d3drm_frame *frame)
+{
+    struct d3drm_matrix world;
+    SIZE_T i;
+
+    d3drm_frame_world_matrix(frame, &world);
+    for (i = 0; i < frame->nb_visuals; ++i)
+        pick_visual(s, frame, &world, frame->visuals[i]);
+    for (i = 0; i < frame->nb_children; ++i)
+    {
+        struct d3drm_frame *child = unsafe_impl_from_IDirect3DRMFrame3(frame->children[i]);
+
+        if (child)
+            pick_frame(s, child);
+    }
+}
+
+static int pick_entry_compare(const void *a, const void *b)
+{
+    float da = ((const struct pick_entry *)a)->dist, db = ((const struct pick_entry *)b)->dist;
+
+    return da < db ? -1 : da > db ? 1 : 0;
+}
+
+/* The visuals the ray (world space) crosses in the hierarchy below root, the nearest first. */
+HRESULT d3drm_pick_ray(struct d3drm_frame *root, const D3DVECTOR *origin, const D3DVECTOR *dir, DWORD flags,
+        IDirect3DRMPicked2Array **array2, IDirect3DRMPickedArray **array1)
+{
+    struct pick_state s;
+    struct picked_array *array;
+
+    memset(&s, 0, sizeof(s));
+    s.origin = *origin;
+    s.dir = vec_normalize(*dir);
+    s.flags = flags;
+    pick_frame(&s, root);
+    if (FAILED(s.error) || !(array = calloc(1, sizeof(*array))))
+    {
+        HRESULT hr = FAILED(s.error) ? s.error : E_OUTOFMEMORY;
+        SIZE_T i;
+
+        for (i = 0; i < s.count; ++i)
+        {
+            IDirect3DRMVisual_Release(s.entries[i].visual);
+            IDirect3DRMFrame3_Release(s.entries[i].frame);
+        }
+        free(s.entries);
+        return hr;
+    }
+#ifndef SG_MUTANT_DRM_PICKSORT
+    qsort(s.entries, s.count, sizeof(*s.entries), pick_entry_compare);
+#endif
+    array->IDirect3DRMPickedArray_iface.lpVtbl = &picked_array1_vtbl;
+    array->IDirect3DRMPicked2Array_iface.lpVtbl = &picked_array2_vtbl;
+    array->ref = 1;
+    array->entries = s.entries;
+    array->count = s.count;
+    if (array2)
+        *array2 = &array->IDirect3DRMPicked2Array_iface;
+    if (array1)
+        *array1 = &array->IDirect3DRMPickedArray_iface;
+    return D3DRM_OK;
+}
+
+/* The visuals under a pixel of the viewport, found in the hierarchy the camera is in. */
+HRESULT d3drm_viewport_pick(struct d3drm_viewport *viewport, LONG x, LONG y, IDirect3DRMPickedArray **array)
+{
+    struct projection p;
+    struct d3drm_frame *root;
+    D3DVECTOR origin, dir;
+    HRESULT hr;
+
+    if (!array)
+        return D3DRMERR_BADVALUE;
+    *array = NULL;
+    if (FAILED(hr = projection_init(viewport, &p)))
+        return hr;
+    pixel_ray(&p, x, y, &origin, &dir);
+    for (root = unsafe_impl_from_IDirect3DRMFrame(viewport->camera); root->parent; root = root->parent)
+        ;
+    return d3drm_pick_ray(root, &origin, &dir, 0, NULL, array);
+}
