diff --git a/dlls/d3drm/render.c b/dlls/d3drm/render.c
new file mode 100644
index 0000000..d9ee8c3
--- /dev/null
+++ b/dlls/d3drm/render.c
@@ -0,0 +1,1581 @@
+/*
+ * Direct3DRM rendering: viewport projection, scene rendering and picking
+ *
+ * Written from the Direct3D Retained Mode documentation; the scene is
+ * transformed and lit on the CPU and drawn as transformed-and-lit triangles
+ * through the Direct3D device the Direct3DRM device owns.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "d3drm_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3drm);
+
+/* The camera: view matrix and the projection of the viewport. */
+struct projection
+{
+    struct d3drm_matrix view;        /* world to camera */
+    struct d3drm_matrix camera;      /* camera to world */
+    D3DVECTOR eye;
+    float front, back;
+    float cx, cy, hw, hh;            /* clip box centre and half size */
+    BOOL ortho, right_handed;
+    float x0, y0, w, h;              /* viewport rectangle in pixels */
+    float scale;                     /* uniform scale: half of the larger side */
+};
+
+static D3DVECTOR vec3(float x, float y, float z)
+{
+    D3DVECTOR v;
+
+    v.x = x;
+    v.y = y;
+    v.z = z;
+    return v;
+}
+
+static float vec_dot(const D3DVECTOR *a, const D3DVECTOR *b)
+{
+    return a->x * b->x + a->y * b->y + a->z * b->z;
+}
+
+static D3DVECTOR vec_sub(const D3DVECTOR *a, const D3DVECTOR *b)
+{
+    return vec3(a->x - b->x, a->y - b->y, a->z - b->z);
+}
+
+static D3DVECTOR vec_cross(const D3DVECTOR *a, const D3DVECTOR *b)
+{
+    return vec3(a->y * b->z - a->z * b->y, a->z * b->x - a->x * b->z, a->x * b->y - a->y * b->x);
+}
+
+static D3DVECTOR vec_normalize(D3DVECTOR v)
+{
+    float len = sqrtf(vec_dot(&v, &v));
+
+    if (len > 1e-20f)
+    {
+        v.x /= len;
+        v.y /= len;
+        v.z /= len;
+    }
+    return v;
+}
+
+static D3DVECTOR vec_point(const D3DVECTOR *v, const struct d3drm_matrix *m)
+{
+    D3DVECTOR r;
+
+    r.x = v->x * m->_11 + v->y * m->_21 + v->z * m->_31 + m->_41;
+    r.y = v->x * m->_12 + v->y * m->_22 + v->z * m->_32 + m->_42;
+    r.z = v->x * m->_13 + v->y * m->_23 + v->z * m->_33 + m->_43;
+    return r;
+}
+
+static D3DVECTOR vec_dir(const D3DVECTOR *v, const struct d3drm_matrix *m)
+{
+    D3DVECTOR r;
+
+    r.x = v->x * m->_11 + v->y * m->_21 + v->z * m->_31;
+    r.y = v->x * m->_12 + v->y * m->_22 + v->z * m->_32;
+    r.z = v->x * m->_13 + v->y * m->_23 + v->z * m->_33;
+    return r;
+}
+
+/* Fills the projection from the viewport and its camera frame. */
+static HRESULT projection_init(struct d3drm_viewport *viewport, struct projection *p)
+{
+    struct d3drm_frame *camera;
+    D3DVECTOR origin = vec3(0.0f, 0.0f, 0.0f);
+
+    if (!viewport->d3d_viewport || !viewport->device || !viewport->camera)
+        return D3DRMERR_BADOBJECT;
+    if (!(camera = unsafe_impl_from_IDirect3DRMFrame(viewport->camera)))
+        return D3DRMERR_BADOBJECT;
+
+    d3drm_frame_world_matrix(camera, &p->camera);
+    if (!d3drm_matrix_invert_affine(&p->camera, &p->view))
+        return D3DRMERR_BADVALUE;
+    p->eye = vec_point(&origin, &p->camera);
+
+    p->front = viewport->clip.front;
+    p->back = viewport->clip.back;
+    p->cx = (viewport->clip.left + viewport->clip.right) * 0.5f;
+    p->cy = (viewport->clip.top + viewport->clip.bottom) * 0.5f;
+    p->hw = (viewport->clip.right - viewport->clip.left) * 0.5f;
+    p->hh = (viewport->clip.top - viewport->clip.bottom) * 0.5f;
+    p->ortho = viewport->projection == D3DRMPROJECT_ORTHOGRAPHIC
+            || viewport->projection == D3DRMPROJECT_RIGHTHANDORTHOGRAPHIC;
+    p->right_handed = viewport->projection == D3DRMPROJECT_RIGHTHANDPERSPECTIVE
+            || viewport->projection == D3DRMPROJECT_RIGHTHANDORTHOGRAPHIC;
+    p->x0 = viewport->x;
+    p->y0 = viewport->y;
+    p->w = viewport->width;
+    p->h = viewport->height;
+    p->scale = max(p->w, p->h) * 0.5f;
+    if (p->hw <= 0.0f || p->hh <= 0.0f || p->w <= 0.0f || p->h <= 0.0f)
+        return D3DRMERR_BADVALUE;
+    return D3DRM_OK;
+}
+
+/* A point of the camera space (z along the viewing direction) to the screen: x and y in pixels, z in [0, 1]
+ * between the front and back planes, and the depth the perspective division used. */
+static void project_camera_point(const struct projection *p, const D3DVECTOR *c, float *sx, float *sy, float *sz,
+        float *depth)
+{
+    float z = p->right_handed ? -c->z : c->z;
+    float nx, ny;
+
+    if (p->ortho)
+    {
+        nx = (c->x - p->cx) / p->hw;
+        ny = (c->y - p->cy) / p->hh;
+    }
+    else
+    {
+        float inv = z != 0.0f ? p->front / z : 0.0f;
+
+        nx = (c->x * inv - p->cx) / p->hw;
+        ny = (c->y * inv - p->cy) / p->hh;
+    }
+    *sx = p->x0 + p->w * 0.5f + nx * p->scale;
+#ifdef SG_MUTANT_DRM_PROJ
+    *sy = p->y0 + p->h * 0.5f + ny * p->scale;
+#else
+    *sy = p->y0 + p->h * 0.5f - ny * p->scale;
+#endif
+    *sz = (z - p->front) / (p->back - p->front);
+    *depth = z;
+}
+
+/* ----- scene collection ----- */
+
+struct light_info
+{
+    D3DRMLIGHTTYPE type;
+    float r, g, b;
+    D3DVECTOR pos, dir;              /* world space; dir is the way the light shines */
+    float range, c, l, q;
+    float umbra, penumbra;
+};
+
+struct draw_batch
+{
+    IDirectDrawSurface *texture;     /* referenced */
+    DWORD fill;                      /* D3DRMFILL_* */
+    BOOL flat, alpha, specular;
+    D3DTLVERTEX *vertices;
+    SIZE_T count, size;
+};
+
+struct render
+{
+    struct d3drm_viewport *viewport;
+    struct projection proj;
+    struct light_info *lights;
+    SIZE_T nb_lights, lights_size;
+    struct draw_batch *batches;
+    SIZE_T nb_batches, batches_size;
+    float ambient_r, ambient_g, ambient_b;
+    BOOL fog;
+    D3DCOLOR fog_color;
+    D3DRMFOGMODE fog_mode;
+    float fog_start, fog_end, fog_density;
+    D3DRMRENDERQUALITY device_quality;
+    HRESULT error;
+};
+
+static BOOL array_reserve(void **elements, SIZE_T *capacity, SIZE_T count, SIZE_T size)
+{
+    SIZE_T new_capacity;
+    void *new_elements;
+
+    if (count <= *capacity)
+        return TRUE;
+    new_capacity = max(*capacity * 2, max(count, 8));
+    if (!(new_elements = realloc(*elements, new_capacity * size)))
+        return FALSE;
+    *elements = new_elements;
+    *capacity = new_capacity;
+    return TRUE;
+}
+
+static void render_cleanup(struct render *r)
+{
+    SIZE_T i;
+
+    for (i = 0; i < r->nb_batches; ++i)
+    {
+        if (r->batches[i].texture)
+            IDirectDrawSurface_Release(r->batches[i].texture);
+        free(r->batches[i].vertices);
+    }
+    free(r->batches);
+    free(r->lights);
+}
+
+static void color_to_rgb(D3DCOLOR color, float *r, float *g, float *b)
+{
+    *r = ((color >> 16) & 0xff) / 255.0f;
+    *g = ((color >> 8) & 0xff) / 255.0f;
+    *b = (color & 0xff) / 255.0f;
+}
+
+static void render_add_light(struct render *r, IDirect3DRMLight *light, const struct d3drm_matrix *world)
+{
+    D3DVECTOR zero = vec3(0.0f, 0.0f, 0.0f), forward = vec3(0.0f, 0.0f, 1.0f);
+    D3DRMLIGHTTYPE type = IDirect3DRMLight_GetType(light);
+    D3DCOLOR color = IDirect3DRMLight_GetColor(light);
+    struct light_info *info;
+
+    if (type == D3DRMLIGHT_AMBIENT)
+    {
+        float lr, lg, lb;
+
+        color_to_rgb(color, &lr, &lg, &lb);
+        r->ambient_r += lr;
+        r->ambient_g += lg;
+        r->ambient_b += lb;
+        return;
+    }
+    if (!array_reserve((void **)&r->lights, &r->lights_size, r->nb_lights + 1, sizeof(*r->lights)))
+    {
+        r->error = E_OUTOFMEMORY;
+        return;
+    }
+    info = &r->lights[r->nb_lights++];
+    memset(info, 0, sizeof(*info));
+    info->type = type;
+    color_to_rgb(color, &info->r, &info->g, &info->b);
+    info->pos = vec_point(&zero, world);
+    info->dir = vec_normalize(vec_dir(&forward, world));
+    info->range = IDirect3DRMLight_GetRange(light);
+    info->c = IDirect3DRMLight_GetConstantAttenuation(light);
+    info->l = IDirect3DRMLight_GetLinearAttenuation(light);
+    info->q = IDirect3DRMLight_GetQuadraticAttenuation(light);
+    info->umbra = IDirect3DRMLight_GetUmbra(light);
+    info->penumbra = IDirect3DRMLight_GetPenumbra(light);
+}
+
+static struct draw_batch *render_batch(struct render *r, IDirectDrawSurface *texture, DWORD fill, BOOL flat,
+        BOOL alpha, BOOL specular)
+{
+    struct draw_batch *b;
+    SIZE_T i;
+
+    /* the last batches are the likely ones to match */
+    for (i = r->nb_batches; i--;)
+    {
+        b = &r->batches[i];
+        if (b->texture == texture && b->fill == fill && b->flat == flat && b->alpha == alpha
+                && b->specular == specular)
+            return b;
+        if (r->nb_batches - i > 4)
+            break;
+    }
+    if (!array_reserve((void **)&r->batches, &r->batches_size, r->nb_batches + 1, sizeof(*r->batches)))
+    {
+        r->error = E_OUTOFMEMORY;
+        return NULL;
+    }
+    b = &r->batches[r->nb_batches++];
+    memset(b, 0, sizeof(*b));
+    b->texture = texture;
+    if (texture)
+        IDirectDrawSurface_AddRef(texture);
+    b->fill = fill;
+    b->flat = flat;
+    b->alpha = alpha;
+    b->specular = specular;
+    return b;
+}
+
+struct material_info
+{
+    float er, eg, eb;                /* emissive */
+    float sr, sg, sb, power;         /* specular */
+    BOOL valid;
+};
+
+static void material_info_get(IDirect3DRMMaterial *material, struct material_info *m)
+{
+    D3DVALUE r, g, b;
+
+    memset(m, 0, sizeof(*m));
+    if (!material)
+        return;
+    if (SUCCEEDED(IDirect3DRMMaterial_GetEmissive(material, &r, &g, &b)))
+    {
+        m->er = r;
+        m->eg = g;
+        m->eb = b;
+    }
+    if (SUCCEEDED(IDirect3DRMMaterial_GetSpecular(material, &r, &g, &b)))
+    {
+        m->sr = r;
+        m->sg = g;
+        m->sb = b;
+    }
+    m->power = IDirect3DRMMaterial_GetPower(material);
+    m->valid = TRUE;
+}
+
+static float clamp01(float v)
+{
+    return v < 0.0f ? 0.0f : v > 1.0f ? 1.0f : v;
+}
+
+static DWORD pack_color(float r, float g, float b, DWORD alpha)
+{
+    return (alpha << 24) | ((DWORD)(clamp01(r) * 255.0f + 0.5f) << 16) | ((DWORD)(clamp01(g) * 255.0f + 0.5f) << 8)
+            | (DWORD)(clamp01(b) * 255.0f + 0.5f);
+}
+
+/* Lights one point: base is the surface colour, n its unit normal, pos where it is (both in world space).
+ * Returns the diffuse colour and sets *spec to the specular one. */
+static void light_point(const struct render *r, const D3DVECTOR *pos, D3DVECTOR n, D3DCOLOR base,
+        const struct material_info *mat, float *out, float *spec)
+{
+    float br, bg, bb;
+    float dr, dg, db;
+    D3DVECTOR to_eye;
+    SIZE_T i;
+
+    color_to_rgb(base, &br, &bg, &bb);
+    spec[0] = spec[1] = spec[2] = 0.0f;
+
+    /* two sided: the normal turns to the viewer */
+    to_eye = vec_normalize(vec_sub(&r->proj.eye, pos));
+    if (vec_dot(&n, &to_eye) < 0.0f)
+    {
+        n.x = -n.x;
+        n.y = -n.y;
+        n.z = -n.z;
+    }
+
+    dr = r->ambient_r;
+    dg = r->ambient_g;
+    db = r->ambient_b;
+    for (i = 0; i < r->nb_lights; ++i)
+    {
+        const struct light_info *light = &r->lights[i];
+        D3DVECTOR to_light;
+        float atten = 1.0f, ndl, dist = 0.0f;
+
+        if (light->type == D3DRMLIGHT_DIRECTIONAL || light->type == D3DRMLIGHT_PARALLELPOINT)
+        {
+            to_light.x = -light->dir.x;
+            to_light.y = -light->dir.y;
+            to_light.z = -light->dir.z;
+        }
+        else
+        {
+            to_light = vec_sub(&light->pos, pos);
+            dist = sqrtf(vec_dot(&to_light, &to_light));
+            if (light->range > 0.0f && dist > light->range)
+                continue;
+            to_light = vec_normalize(to_light);
+            atten = light->c + light->l * dist + light->q * dist * dist;
+            atten = atten > 1e-6f ? 1.0f / atten : 1.0f;
+            if (light->type == D3DRMLIGHT_SPOT)
+            {
+                float cos_angle = -vec_dot(&to_light, &light->dir);
+                float inner = cosf(light->umbra * 0.5f), outer = cosf(light->penumbra * 0.5f);
+
+                if (cos_angle <= outer)
+                    continue;
+                if (cos_angle < inner && inner > outer)
+                    atten *= (cos_angle - outer) / (inner - outer);
+            }
+        }
+        ndl = vec_dot(&n, &to_light);
+#ifdef SG_MUTANT_DRM_LIGHT
+        ndl = 1.0f;
+#endif
+        if (ndl <= 0.0f)
+            continue;
+        dr += light->r * atten * ndl;
+        dg += light->g * atten * ndl;
+        db += light->b * atten * ndl;
+
+        if (mat->valid && mat->power > 0.0f)
+        {
+            D3DVECTOR half = vec_normalize(vec3(to_light.x + to_eye.x, to_light.y + to_eye.y,
+                    to_light.z + to_eye.z));
+            float ndh = vec_dot(&n, &half), s;
+
+            if (ndh > 0.0f)
+            {
+                s = powf(ndh, mat->power) * atten;
+                spec[0] += light->r * mat->sr * s;
+                spec[1] += light->g * mat->sg * s;
+                spec[2] += light->b * mat->sb * s;
+            }
+        }
+    }
+    out[0] = br * dr + (mat->valid ? mat->er : 0.0f);
+    out[1] = bg * dg + (mat->valid ? mat->eg : 0.0f);
+    out[2] = bb * db + (mat->valid ? mat->eb : 0.0f);
+}
+
+struct cam_vertex
+{
+    D3DVECTOR pos;                   /* camera space */
+    float u, v;
+    float diffuse[3];
+    float spec[3];
+    DWORD alpha;
+};
+
+/* Clips a polygon against the front plane and appends the triangles that make it. */
+static void render_polygon(struct render *r, const struct cam_vertex *in, unsigned int n, IDirectDrawSurface *texture,
+        DWORD fill, BOOL flat, BOOL specular)
+{
+    struct cam_vertex clipped[16];
+    unsigned int count = 0, i;
+    float front = r->proj.front, back = r->proj.back;
+    BOOL alpha = FALSE;
+    struct draw_batch *batch;
+
+    if (n > 8)
+        return;
+    for (i = 0; i < n; ++i)
+    {
+        const struct cam_vertex *a = &in[i], *b = &in[(i + 1) % n];
+        float za = r->proj.right_handed ? -a->pos.z : a->pos.z;
+        float zb = r->proj.right_handed ? -b->pos.z : b->pos.z;
+        BOOL ina = za >= front, inb = zb >= front;
+
+        if (ina)
+            clipped[count++] = *a;
+        if (ina != inb)
+        {
+            struct cam_vertex c;
+            float t = (front - za) / (zb - za);
+            unsigned int k;
+
+            c.pos.x = a->pos.x + (b->pos.x - a->pos.x) * t;
+            c.pos.y = a->pos.y + (b->pos.y - a->pos.y) * t;
+            c.pos.z = a->pos.z + (b->pos.z - a->pos.z) * t;
+            c.u = a->u + (b->u - a->u) * t;
+            c.v = a->v + (b->v - a->v) * t;
+            for (k = 0; k < 3; ++k)
+            {
+                c.diffuse[k] = a->diffuse[k] + (b->diffuse[k] - a->diffuse[k]) * t;
+                c.spec[k] = a->spec[k] + (b->spec[k] - a->spec[k]) * t;
+            }
+            c.alpha = a->alpha;
+            clipped[count++] = c;
+        }
+    }
+    if (count < 3)
+        return;
+    for (i = 0; i < count; ++i)
+        if (clipped[i].alpha < 255)
+            alpha = TRUE;
+
+    if (!(batch = render_batch(r, texture, fill, flat, alpha, specular)))
+        return;
+    if (!array_reserve((void **)&batch->vertices, &batch->size, batch->count + (count - 2) * 3, sizeof(*batch->vertices)))
+    {
+        r->error = E_OUTOFMEMORY;
+        return;
+    }
+    for (i = 1; i + 1 < count; ++i)
+    {
+        const struct cam_vertex *tri[3] = { &clipped[0], &clipped[i], &clipped[i + 1] };
+        unsigned int k;
+
+        for (k = 0; k < 3; ++k)
+        {
+            D3DTLVERTEX *v = &batch->vertices[batch->count++];
+            float depth, fog = 1.0f;
+
+            memset(v, 0, sizeof(*v));
+            project_camera_point(&r->proj, &tri[k]->pos, &v->sx, &v->sy, &v->sz, &depth);
+            if (v->sz < 0.0f)
+                v->sz = 0.0f;
+            if (v->sz > 1.0f)
+                v->sz = 1.0f;
+            v->rhw = r->proj.ortho ? 1.0f : (depth != 0.0f ? 1.0f / depth : 1.0f);
+            v->tu = tri[k]->u;
+            v->tv = tri[k]->v;
+            v->color = pack_color(tri[k]->diffuse[0], tri[k]->diffuse[1], tri[k]->diffuse[2], tri[k]->alpha);
+            if (r->fog)
+            {
+                switch (r->fog_mode)
+                {
+                    case D3DRMFOG_LINEAR:
+                        fog = r->fog_end != r->fog_start ? (r->fog_end - depth) / (r->fog_end - r->fog_start) : 1.0f;
+                        break;
+                    case D3DRMFOG_EXPONENTIAL:
+                        fog = expf(-r->fog_density * depth);
+                        break;
+                    default:
+                        fog = expf(-(r->fog_density * depth) * (r->fog_density * depth));
+                        break;
+                }
+                fog = clamp01(fog);
+            }
+            v->specular = pack_color(tri[k]->spec[0], tri[k]->spec[1], tri[k]->spec[2],
+                    (DWORD)(fog * 255.0f + 0.5f));
+        }
+    }
+    (void)back;
+}
+
+/* The effective quality of a visual under the device quality: on each axis (fill, light, shade) the lower of the
+ * two. A device whose quality was never set renders as D3DRMRENDER_GOURAUD (UNVERIFIED default). */
+static void quality_flags(const struct render *r, D3DRMRENDERQUALITY visual, DWORD *fill, BOOL *lit, BOOL *flat)
+{
+    D3DRMRENDERQUALITY dev = r->device_quality ? r->device_quality : D3DRMRENDER_GOURAUD;
+    DWORD dev_fill = dev & D3DRMFILL_MASK, vis_fill = visual & D3DRMFILL_MASK;
+    DWORD dev_light = dev & D3DRMLIGHT_MASK, vis_light = visual & D3DRMLIGHT_MASK;
+    DWORD dev_shade = dev & D3DRMSHADE_MASK, vis_shade = visual & D3DRMSHADE_MASK;
+
+#ifdef SG_MUTANT_DRM_FILL
+    dev_fill = D3DRMFILL_SOLID;
+#endif
+    *fill = min(dev_fill, vis_fill);
+    *lit = min(dev_light, vis_light) != D3DRMLIGHT_OFF;
+    *flat = min(dev_shade, vis_shade) == D3DRMSHADE_FLAT;
+}
+
+struct visual_state
+{
+    D3DCOLOR color;
+    IDirectDrawSurface *texture;
+    struct material_info material;
+    D3DRMRENDERQUALITY quality;
+};
+
+/* Transforms and lights one face of nb vertices (world space positions and normals). */
+static void render_face(struct render *r, const struct d3drm_matrix *world, unsigned int n, const D3DVECTOR *positions,
+        const D3DVECTOR *normals, const float *uv, D3DCOLOR color, const struct visual_state *state)
+{
+    struct cam_vertex verts[8];
+    BOOL lit, flat;
+    DWORD fill;
+    D3DVECTOR face_normal, wpos[8];
+    unsigned int i;
+    DWORD alpha = color >> 24;
+    BOOL specular;
+
+    if (n < 3 || n > 8)
+        return;
+    quality_flags(r, state->quality, &fill, &lit, &flat);
+    specular = lit && state->material.valid && state->material.power > 0.0f;
+
+    for (i = 0; i < n; ++i)
+        wpos[i] = vec_point(&positions[i], world);
+    {
+        D3DVECTOR e1 = vec_sub(&wpos[1], &wpos[0]), e2 = vec_sub(&wpos[2], &wpos[0]);
+
+        face_normal = vec_normalize(vec_cross(&e1, &e2));
+    }
+    for (i = 0; i < n; ++i)
+    {
+        D3DVECTOR normal = face_normal;
+        float diffuse[3], spec[3] = { 0.0f, 0.0f, 0.0f };
+
+        if (!flat && (normals[i].x != 0.0f || normals[i].y != 0.0f || normals[i].z != 0.0f))
+            normal = vec_normalize(vec_dir(&normals[i], world));
+        if (lit)
+            light_point(r, &wpos[i], normal, color, &state->material, diffuse, spec);
+        else
+            color_to_rgb(color, &diffuse[0], &diffuse[1], &diffuse[2]);
+        verts[i].pos = vec_point(&wpos[i], &r->proj.view);
+        verts[i].u = uv ? uv[i * 2] : 0.0f;
+        verts[i].v = uv ? uv[i * 2 + 1] : 0.0f;
+        memcpy(verts[i].diffuse, diffuse, sizeof(diffuse));
+        memcpy(verts[i].spec, spec, sizeof(spec));
+        verts[i].alpha = alpha;
+    }
+    if (flat && lit)
+    {
+        /* flat shading: the colour of the first vertex for the whole face */
+        for (i = 1; i < n; ++i)
+        {
+            memcpy(verts[i].diffuse, verts[0].diffuse, sizeof(verts[0].diffuse));
+            memcpy(verts[i].spec, verts[0].spec, sizeof(verts[0].spec));
+        }
+    }
+    render_polygon(r, verts, n, state->texture, fill, flat, specular);
+}
+
+static void render_mesh_builder(struct render *r, const struct d3drm_matrix *world, IDirect3DRMMeshBuilder3 *builder)
+{
+    IDirect3DRMFaceArray *faces = NULL;
+    struct visual_state state;
+    IDirect3DRMTexture3 *texture = NULL;
+    IDirect3DRMMaterial2 *material = NULL;
+    DWORD i, count;
+
+    if (FAILED(IDirect3DRMMeshBuilder3_GetFaces(builder, &faces)) || !faces)
+        return;
+    memset(&state, 0, sizeof(state));
+    state.quality = IDirect3DRMMeshBuilder3_GetQuality(builder);
+    count = IDirect3DRMFaceArray_GetSize(faces);
+    for (i = 0; i < count; ++i)
+    {
+        IDirect3DRMFace *face1 = NULL;
+        IDirect3DRMFace2 *face = NULL;
+        D3DVECTOR positions[8], normals[8];
+        float uv[16];
+        DWORD n = 0, k;
+        struct visual_state fs;
+        IDirectDrawSurface *surface = NULL;
+
+        if (FAILED(IDirect3DRMFaceArray_GetElement(faces, i, &face1)) || !face1)
+            continue;
+        if (FAILED(IDirect3DRMFace_QueryInterface(face1, &IID_IDirect3DRMFace2, (void **)&face)))
+        {
+            IDirect3DRMFace_Release(face1);
+            continue;
+        }
+        IDirect3DRMFace_Release(face1);
+
+        if (FAILED(IDirect3DRMFace2_GetVertices(face, &n, NULL, NULL)) || n < 3 || n > 8)
+        {
+            IDirect3DRMFace2_Release(face);
+            continue;
+        }
+        IDirect3DRMFace2_GetVertices(face, &n, positions, normals);
+        for (k = 0; k < n; ++k)
+        {
+            float u = 0.0f, v = 0.0f;
+
+            IDirect3DRMFace2_GetTextureCoordinates(face, k, &u, &v);
+            uv[k * 2] = u;
+            uv[k * 2 + 1] = v;
+        }
+
+        fs = state;
+        fs.color = IDirect3DRMFace2_GetColor(face);
+        texture = NULL;
+        if (SUCCEEDED(IDirect3DRMFace2_GetTexture(face, &texture)) && texture)
+        {
+            surface = d3drm_texture_get_render_surface((IUnknown *)texture, r->viewport->device->ddraw);
+            IDirect3DRMTexture3_Release(texture);
+        }
+        fs.texture = surface;
+        material = NULL;
+        if (SUCCEEDED(face->lpVtbl->GetMaterial(face, &material)) && material)
+        {
+            material_info_get((IDirect3DRMMaterial *)material, &fs.material);
+            IDirect3DRMMaterial2_Release(material);
+        }
+        render_face(r, world, n, positions, normals, uv, fs.color, &fs);
+        if (surface)
+            IDirectDrawSurface_Release(surface);
+        IDirect3DRMFace2_Release(face);
+    }
+    IDirect3DRMFaceArray_Release(faces);
+}
+
+static void render_mesh(struct render *r, const struct d3drm_matrix *world, IDirect3DRMMesh *mesh)
+{
+    unsigned int groups = IDirect3DRMMesh_GetGroupCount(mesh), g;
+
+    for (g = 0; g < groups; ++g)
+    {
+        unsigned int vcount = 0, fcount = 0, vpf = 0, *fdata = NULL, pos = 0, f;
+        DWORD fdata_size = 0;
+        D3DRMVERTEX *vertices = NULL;
+        struct visual_state state;
+        IDirect3DRMTexture *texture = NULL;
+        IDirect3DRMMaterial *material = NULL;
+        IDirect3DRMTexture3 *texture3 = NULL;
+
+        if (FAILED(IDirect3DRMMesh_GetGroup(mesh, g, &vcount, &fcount, &vpf, &fdata_size, NULL)) || !fcount)
+            continue;
+        if (!(fdata = malloc(fdata_size * sizeof(*fdata))) || !(vertices = malloc(vcount * sizeof(*vertices))))
+            goto next;
+        if (FAILED(IDirect3DRMMesh_GetGroup(mesh, g, &vcount, &fcount, &vpf, &fdata_size, fdata))
+                || FAILED(IDirect3DRMMesh_GetVertices(mesh, g, 0, vcount, vertices)))
+            goto next;
+
+        memset(&state, 0, sizeof(state));
+        state.quality = IDirect3DRMMesh_GetGroupQuality(mesh, g);
+        state.color = IDirect3DRMMesh_GetGroupColor(mesh, g);
+        if (SUCCEEDED(IDirect3DRMMesh_GetGroupTexture(mesh, g, &texture)) && texture)
+        {
+            if (SUCCEEDED(IDirect3DRMTexture_QueryInterface(texture, &IID_IDirect3DRMTexture3, (void **)&texture3)))
+            {
+                state.texture = d3drm_texture_get_render_surface((IUnknown *)texture3, r->viewport->device->ddraw);
+                IDirect3DRMTexture3_Release(texture3);
+            }
+            IDirect3DRMTexture_Release(texture);
+        }
+        if (SUCCEEDED(IDirect3DRMMesh_GetGroupMaterial(mesh, g, &material)) && material)
+        {
+            material_info_get(material, &state.material);
+            IDirect3DRMMaterial_Release(material);
+        }
+
+        for (f = 0; f < fcount && pos < fdata_size; ++f)
+        {
+            D3DVECTOR positions[8], normals[8];
+            float uv[16];
+            unsigned int n = vpf ? vpf : fdata[pos++], k;
+            D3DCOLOR color = state.color;
+
+            if (n < 3 || n > 8 || pos + n > fdata_size)
+                break;
+            for (k = 0; k < n; ++k)
+            {
+                unsigned int idx = fdata[pos + k];
+
+                if (idx >= vcount)
+                    break;
+                positions[k] = vertices[idx].position;
+                normals[k] = vertices[idx].normal;
+                uv[k * 2] = vertices[idx].tu;
+                uv[k * 2 + 1] = vertices[idx].tv;
+                if (!k)
+                    color = vertices[idx].color ? vertices[idx].color : state.color;
+            }
+            pos += n;
+            if (k == n)
+                render_face(r, world, n, positions, normals, uv, color, &state);
+        }
+        if (state.texture)
+            IDirectDrawSurface_Release(state.texture);
+next:
+        free(fdata);
+        free(vertices);
+    }
+}
+
+static void render_visual(struct render *r, const struct d3drm_matrix *world, IDirect3DRMVisual *visual)
+{
+    IDirect3DRMMeshBuilder3 *builder;
+    IDirect3DRMMesh *mesh;
+
+    if (SUCCEEDED(IDirect3DRMVisual_QueryInterface(visual, &IID_IDirect3DRMMeshBuilder3, (void **)&builder)))
+    {
+        render_mesh_builder(r, world, builder);
+        IDirect3DRMMeshBuilder3_Release(builder);
+    }
+    else if (SUCCEEDED(IDirect3DRMVisual_QueryInterface(visual, &IID_IDirect3DRMMesh, (void **)&mesh)))
+    {
+        render_mesh(r, world, mesh);
+        IDirect3DRMMesh_Release(mesh);
+    }
+}
+
+/* Lights first (they are needed to light the visuals), then the visuals, down the whole hierarchy. */
+static void collect_lights(struct render *r, struct d3drm_frame *frame)
+{
+    struct d3drm_matrix world;
+    SIZE_T i;
+
+    d3drm_frame_world_matrix(frame, &world);
+    for (i = 0; i < frame->nb_lights; ++i)
+        render_add_light(r, frame->lights[i], &world);
+    for (i = 0; i < frame->nb_children; ++i)
+    {
+        struct d3drm_frame *child = unsafe_impl_from_IDirect3DRMFrame3(frame->children[i]);
+
+        if (child)
+            collect_lights(r, child);
+    }
+}
+
+static void collect_visuals(struct render *r, struct d3drm_frame *frame)
+{
+    struct d3drm_matrix world;
+    SIZE_T i;
+
+    d3drm_frame_world_matrix(frame, &world);
+    for (i = 0; i < frame->nb_visuals; ++i)
+        render_visual(r, &world, frame->visuals[i]);
+    for (i = 0; i < frame->nb_children; ++i)
+    {
+        struct d3drm_frame *child = unsafe_impl_from_IDirect3DRMFrame3(frame->children[i]);
+
+        if (child)
+            collect_visuals(r, child);
+    }
+}
+
+static HRESULT draw_batches(struct render *r, IDirect3DDevice2 *device2, BOOL zbuffer)
+{
+    SIZE_T i;
+
+    IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_ZENABLE, zbuffer ? D3DZB_TRUE : D3DZB_FALSE);
+    IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_ZWRITEENABLE, zbuffer);
+    IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_ZFUNC, D3DCMP_LESSEQUAL);
+    IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_CULLMODE, D3DCULL_NONE);
+    IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_LIGHTING, FALSE);
+    IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_FOGENABLE, r->fog);
+    if (r->fog)
+    {
+        IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_FOGCOLOR, r->fog_color & 0xffffff);
+        IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_FOGTABLEMODE, D3DFOG_NONE);
+    }
+    for (i = 0; i < r->nb_batches; ++i)
+    {
+        struct draw_batch *b = &r->batches[i];
+        D3DTEXTUREHANDLE handle = 0;
+
+        if (!b->count)
+            continue;
+        if (b->texture)
+        {
+            IDirect3DTexture2 *tex2;
+
+            if (SUCCEEDED(IDirectDrawSurface_QueryInterface(b->texture, &IID_IDirect3DTexture2, (void **)&tex2)))
+            {
+                IDirect3DTexture2_GetHandle(tex2, device2, &handle);
+                IDirect3DTexture2_Release(tex2);
+            }
+        }
+        IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_TEXTUREHANDLE, handle);
+        IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_TEXTUREMAPBLEND, D3DTBLEND_MODULATE);
+        IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_TEXTUREMAG, D3DFILTER_LINEAR);
+        IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_TEXTUREMIN, D3DFILTER_LINEAR);
+        IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_TEXTUREPERSPECTIVE, TRUE);
+        IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_SHADEMODE, b->flat ? D3DSHADE_FLAT : D3DSHADE_GOURAUD);
+        IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_FILLMODE, b->fill == D3DRMFILL_POINTS ? D3DFILL_POINT : b->fill == D3DRMFILL_WIREFRAME ? D3DFILL_WIREFRAME : D3DFILL_SOLID);
+        IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_SPECULARENABLE, b->specular);
+        IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_ALPHABLENDENABLE, b->alpha);
+        if (b->alpha)
+        {
+            IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_SRCBLEND, D3DBLEND_SRCALPHA);
+            IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_DESTBLEND, D3DBLEND_INVSRCALPHA);
+        }
+        IDirect3DDevice2_DrawPrimitive(device2, D3DPT_TRIANGLELIST, D3DVT_TLVERTEX, b->vertices, b->count, 0);
+    }
+    IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_TEXTUREHANDLE, 0);
+    IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_ALPHABLENDENABLE, FALSE);
+    IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_FILLMODE, D3DFILL_SOLID);
+    IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_SPECULARENABLE, FALSE);
+    IDirect3DDevice2_SetRenderState(device2, D3DRENDERSTATE_FOGENABLE, FALSE);
+    return D3DRM_OK;
+}
+
+/* Renders the hierarchy of scene as seen by the viewport's camera. Clearing is a separate call (Clear). */
+HRESULT d3drm_viewport_render(struct d3drm_viewport *viewport, struct d3drm_frame *scene)
+{
+    IDirect3DDevice2 *device2 = NULL;
+    IDirect3DViewport2 *viewport2 = NULL;
+    DDSCAPS caps = { DDSCAPS_ZBUFFER };
+    IDirectDrawSurface *zsurface = NULL;
+    struct render r;
+    HRESULT hr;
+
+    if (!scene)
+        return D3DRMERR_BADOBJECT;
+
+    memset(&r, 0, sizeof(r));
+    r.viewport = viewport;
+    if (FAILED(hr = projection_init(viewport, &r.proj)))
+        return hr;
+
+    r.device_quality = viewport->device->quality;
+    r.fog = scene->fog_enable;
+    r.fog_color = scene->fog_color;
+    r.fog_mode = scene->fog_mode;
+    r.fog_start = scene->fog_start;
+    r.fog_end = scene->fog_end;
+    r.fog_density = scene->fog_density;
+
+    collect_lights(&r, scene);
+    collect_visuals(&r, scene);
+    if (FAILED(r.error))
+    {
+        hr = r.error;
+        goto done;
+    }
+    if (!r.nb_batches)
+    {
+        hr = D3DRM_OK;
+        goto done;
+    }
+
+    if (FAILED(hr = IDirect3DDevice_QueryInterface(viewport->device->device, &IID_IDirect3DDevice2,
+            (void **)&device2)))
+        goto done;
+    if (FAILED(hr = IDirect3DViewport_QueryInterface(viewport->d3d_viewport, &IID_IDirect3DViewport2,
+            (void **)&viewport2)))
+        goto done;
+    IDirect3DDevice2_SetCurrentViewport(device2, viewport2);
+    if (SUCCEEDED(IDirectDrawSurface_GetAttachedSurface(viewport->device->render_target, &caps, &zsurface)))
+        IDirectDrawSurface_Release(zsurface);
+
+    IDirect3DDevice2_BeginScene(device2);
+    hr = draw_batches(&r, device2, !!zsurface);
+    IDirect3DDevice2_EndScene(device2);
+
+done:
+    if (viewport2)
+        IDirect3DViewport2_Release(viewport2);
+    if (device2)
+        IDirect3DDevice2_Release(device2);
+    render_cleanup(&r);
+    return hr;
+}
+
+/* ----- projection queries ----- */
+
+/* World space to the screen: x, y in pixels, z in [0, 1], and the camera depth as the homogeneous w; x and y
+ * are premultiplied by w, so that dividing by w gives the pixel position. */
+HRESULT d3drm_viewport_transform(struct d3drm_viewport *viewport, D3DRMVECTOR4D *dst, const D3DVECTOR *src)
+{
+    struct projection p;
+    D3DVECTOR c;
+    float sx, sy, sz, depth;
+    HRESULT hr;
+
+    if (!dst || !src)
+        return D3DRMERR_BADVALUE;
+    if (FAILED(hr = projection_init(viewport, &p)))
+        return hr;
+    c = vec_point(src, &p.view);
+    project_camera_point(&p, &c, &sx, &sy, &sz, &depth);
+    dst->x = sx * depth;
+    dst->y = sy * depth;
+    dst->z = sz * depth;
+    dst->w = depth;
+    return D3DRM_OK;
+}
+
+HRESULT d3drm_viewport_inverse_transform(struct d3drm_viewport *viewport, D3DVECTOR *dst, const D3DRMVECTOR4D *src)
+{
+    struct projection p;
+    D3DVECTOR c;
+    float sx, sy, sz, z, nx, ny;
+    HRESULT hr;
+
+    if (!dst || !src)
+        return D3DRMERR_BADVALUE;
+    if (FAILED(hr = projection_init(viewport, &p)))
+        return hr;
+    if (src->w == 0.0f)
+        return D3DRMERR_BADVALUE;
+    sx = src->x / src->w;
+    sy = src->y / src->w;
+    sz = src->z / src->w;
+    z = sz * (p.back - p.front) + p.front;
+    nx = (sx - p.x0 - p.w * 0.5f) / p.scale;
+    ny = -(sy - p.y0 - p.h * 0.5f) / p.scale;
+    if (p.ortho)
+    {
+        c.x = nx * p.hw + p.cx;
+        c.y = ny * p.hh + p.cy;
+    }
+    else
+    {
+        c.x = (nx * p.hw + p.cx) * z / p.front;
+        c.y = (ny * p.hh + p.cy) * z / p.front;
+    }
+    c.z = p.right_handed ? -z : z;
+    *dst = vec_point(&c, &p.camera);
+    return D3DRM_OK;
+}
+
+/* A ray through the pixel (x, y), in world space. */
+static BOOL pixel_ray(const struct projection *p, LONG x, LONG y, D3DVECTOR *origin, D3DVECTOR *dir)
+{
+    float nx = ((float)x - p->x0 - p->w * 0.5f) / p->scale;
+    float ny = -((float)y - p->y0 - p->h * 0.5f) / p->scale;
+    D3DVECTOR c0, c1;
+
+    if (p->ortho)
+    {
+        c0.x = nx * p->hw + p->cx;
+        c0.y = ny * p->hh + p->cy;
+        c0.z = p->right_handed ? -p->front : p->front;
+        c1 = c0;
+        c1.z += p->right_handed ? -1.0f : 1.0f;
+    }
+    else
+    {
+        c0.x = c0.y = c0.z = 0.0f;
+        c1.x = nx * p->hw + p->cx;
+        c1.y = ny * p->hh + p->cy;
+        c1.z = p->right_handed ? -p->front : p->front;
+    }
+    *origin = vec_point(&c0, &p->camera);
+    c1 = vec_point(&c1, &p->camera);
+    *dir = vec_normalize(vec_sub(&c1, origin));
+    return TRUE;
+}
+
+/* ----- picking ----- */
+
+struct pick_entry
+{
+    IDirect3DRMVisual *visual;       /* referenced */
+    IDirect3DRMFrame3 *frame;        /* referenced: the frame the visual is in */
+    D3DRMPICKDESC2 desc;
+    float dist;
+};
+
+struct picked_array
+{
+    IDirect3DRMPickedArray IDirect3DRMPickedArray_iface;
+    IDirect3DRMPicked2Array IDirect3DRMPicked2Array_iface;
+    LONG ref;
+    struct pick_entry *entries;
+    SIZE_T count;
+};
+
+static inline struct picked_array *impl_from_IDirect3DRMPickedArray(IDirect3DRMPickedArray *iface)
+{
+    return CONTAINING_RECORD(iface, struct picked_array, IDirect3DRMPickedArray_iface);
+}
+
+static inline struct picked_array *impl_from_IDirect3DRMPicked2Array(IDirect3DRMPicked2Array *iface)
+{
+    return CONTAINING_RECORD(iface, struct picked_array, IDirect3DRMPicked2Array_iface);
+}
+
+static HRESULT picked_array_query_interface(struct picked_array *array, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IDirect3DRMPickedArray) || IsEqualGUID(iid, &IID_IUnknown))
+        *out = &array->IDirect3DRMPickedArray_iface;
+    else if (IsEqualGUID(iid, &IID_IDirect3DRMPicked2Array))
+        *out = &array->IDirect3DRMPicked2Array_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&array->ref);
+    return S_OK;
+}
+
+static ULONG picked_array_release(struct picked_array *array)
+{
+    ULONG refcount = InterlockedDecrement(&array->ref);
+    SIZE_T i;
+
+    if (!refcount)
+    {
+        for (i = 0; i < array->count; ++i)
+        {
+            IDirect3DRMVisual_Release(array->entries[i].visual);
+            IDirect3DRMFrame3_Release(array->entries[i].frame);
+        }
+        free(array->entries);
+        free(array);
+    }
+    return refcount;
+}
+
+/* The frames from the root of the hierarchy down to the frame of the pick. */
+static HRESULT picked_array_get_pick(struct picked_array *array, DWORD index, IDirect3DRMVisual **visual,
+        IDirect3DRMFrameArray **frames, D3DRMPICKDESC2 *desc)
+{
+    struct pick_entry *entry;
+    IDirect3DRMFrame3 *path[64];
+    struct d3drm_frame *frame;
+    unsigned int depth = 0, i;
+    HRESULT hr;
+
+    if (index >= array->count)
+        return D3DRMERR_BADVALUE;
+    entry = &array->entries[index];
+    if (visual)
+    {
+        *visual = entry->visual;
+        IDirect3DRMVisual_AddRef(*visual);
+    }
+    if (desc)
+        *desc = entry->desc;
+    if (frames)
+    {
+        for (frame = unsafe_impl_from_IDirect3DRMFrame3(entry->frame); frame && depth < ARRAY_SIZE(path);
+                frame = frame->parent)
+            path[depth++] = &frame->IDirect3DRMFrame3_iface;
+        for (i = 0; i < depth / 2; ++i)
+        {
+            IDirect3DRMFrame3 *tmp = path[i];
+
+            path[i] = path[depth - 1 - i];
+            path[depth - 1 - i] = tmp;
+        }
+        if (FAILED(hr = d3drm_frame_array_from_frames(depth, path, frames)))
+        {
+            if (visual)
+                IDirect3DRMVisual_Release(*visual);
+            return hr;
+        }
+    }
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI picked_array1_QueryInterface(IDirect3DRMPickedArray *iface, REFIID iid, void **out)
+{
+    return picked_array_query_interface(impl_from_IDirect3DRMPickedArray(iface), iid, out);
+}
+
+static ULONG WINAPI picked_array1_AddRef(IDirect3DRMPickedArray *iface)
+{
+    return InterlockedIncrement(&impl_from_IDirect3DRMPickedArray(iface)->ref);
+}
+
+static ULONG WINAPI picked_array1_Release(IDirect3DRMPickedArray *iface)
+{
+    return picked_array_release(impl_from_IDirect3DRMPickedArray(iface));
+}
+
+static DWORD WINAPI picked_array1_GetSize(IDirect3DRMPickedArray *iface)
+{
+    return impl_from_IDirect3DRMPickedArray(iface)->count;
+}
+
+static HRESULT WINAPI picked_array1_GetPick(IDirect3DRMPickedArray *iface, DWORD index, IDirect3DRMVisual **visual,
+        IDirect3DRMFrameArray **frames, D3DRMPICKDESC *desc)
+{
+    struct picked_array *array = impl_from_IDirect3DRMPickedArray(iface);
+    D3DRMPICKDESC2 desc2;
+    HRESULT hr;
+
+    TRACE("iface %p, index %lu, visual %p, frames %p, desc %p.\n", iface, index, visual, frames, desc);
+
+    if (FAILED(hr = picked_array_get_pick(array, index, visual, frames, &desc2)))
+        return hr;
+    if (desc)
+    {
+        desc->ulFaceIdx = desc2.ulFaceIdx;
+        desc->lGroupIdx = desc2.lGroupIdx;
+        desc->vPosition = desc2.vPosition;
+    }
+    return D3DRM_OK;
+}
+
+static const IDirect3DRMPickedArrayVtbl picked_array1_vtbl =
+{
+    picked_array1_QueryInterface,
+    picked_array1_AddRef,
+    picked_array1_Release,
+    picked_array1_GetSize,
+    picked_array1_GetPick,
