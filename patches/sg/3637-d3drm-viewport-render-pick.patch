+
+/* A mesh builder with one triangle (or none), added to a frame of the scene. */
+static IDirect3DRMMeshBuilder3 *sg_add_triangle(struct sg_scene *s, IDirect3DRMFrame3 *frame, float z, float scale,
+        float r, float g, float b, IDirect3DRMTexture3 *texture)
+{
+    IDirect3DRMMeshBuilder3 *builder;
+    IDirect3DRMFace2 *face;
+    HRESULT hr;
+
+    hr = IDirect3DRM3_CreateMeshBuilder(s->d3drm, &builder);
+    ok(SUCCEEDED(hr), "Cannot create the mesh builder, hr %#lx.\n", hr);
+    hr = IDirect3DRM3_CreateFace(s->d3drm, &face);
+    ok(SUCCEEDED(hr), "Cannot create the face, hr %#lx.\n", hr);
+    IDirect3DRMFace2_AddVertex(face, -scale, -scale, z);
+    IDirect3DRMFace2_AddVertex(face, 0.0f, scale, z);
+    IDirect3DRMFace2_AddVertex(face, scale, -scale, z);
+    hr = IDirect3DRMMeshBuilder3_AddFace(builder, face);
+    ok(SUCCEEDED(hr), "Cannot add the face, hr %#lx.\n", hr);
+    IDirect3DRMFace2_Release(face);
+    IDirect3DRMMeshBuilder3_SetColorRGB(builder, r, g, b);
+    if (texture)
+    {
+        IDirect3DRMMeshBuilder3_SetTexture(builder, texture);
+        IDirect3DRMMeshBuilder3_SetTextureCoordinates(builder, 0, 0.0f, 1.0f);
+        IDirect3DRMMeshBuilder3_SetTextureCoordinates(builder, 1, 0.5f, 0.0f);
+        IDirect3DRMMeshBuilder3_SetTextureCoordinates(builder, 2, 1.0f, 1.0f);
+    }
+    hr = IDirect3DRMFrame3_AddVisual(frame, (IUnknown *)builder);
+    ok(SUCCEEDED(hr), "Cannot add the visual, hr %#lx.\n", hr);
+    return builder;
+}
+
+static void sg_add_light(struct sg_scene *s, D3DRMLIGHTTYPE type, float level)
+{
+    IDirect3DRMLight *light;
+    HRESULT hr;
+
+    hr = IDirect3DRM3_CreateLightRGB(s->d3drm, type, level, level, level, &light);
+    ok(SUCCEEDED(hr), "Cannot create the light, hr %#lx.\n", hr);
+    hr = IDirect3DRMFrame3_AddLight(s->scene, light);
+    ok(SUCCEEDED(hr), "Cannot add the light, hr %#lx.\n", hr);
+    IDirect3DRMLight_Release(light);
+}
+
+static void sg_clear(struct sg_scene *s, float r, float g, float b)
+{
+    HRESULT hr;
+
+    hr = IDirect3DRMFrame3_SetSceneBackgroundRGB(s->scene, r, g, b);
+    ok(SUCCEEDED(hr), "Cannot set the background, hr %#lx.\n", hr);
+    hr = IDirect3DRMViewport2_Clear(s->viewport, D3DRMCLEAR_ALL);
+    ok(SUCCEEDED(hr), "Cannot clear, hr %#lx.\n", hr);
+}
