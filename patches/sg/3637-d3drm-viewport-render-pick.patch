+    IDirect3DRMPickedArray_Release(picked);
+
+    hr = IDirect3DRMViewport2_Pick(s.viewport, 10, 10, &picked);
+    ok(SUCCEEDED(hr), "Cannot pick, hr %#lx.\n", hr);
+    ok(IDirect3DRMPickedArray_GetSize(picked) == 0, "Got %lu picks.\n", IDirect3DRMPickedArray_GetSize(picked));
+    IDirect3DRMPickedArray_Release(picked);
+
+    /* a ray from the camera */
+    ray.dvPos.x = 0.0f; ray.dvPos.y = 0.0f; ray.dvPos.z = 0.0f;
+    ray.dvDir.x = 0.0f; ray.dvDir.y = 0.0f; ray.dvDir.z = 1.0f;
+    hr = IDirect3DRMFrame3_RayPick(s.scene, NULL, &ray, D3DRMRAYPICK_INTERPOLATEUV | D3DRMRAYPICK_INTERPOLATECOLOR
+            | D3DRMRAYPICK_INTERPOLATENORMAL, &picked2);
+    ok(SUCCEEDED(hr), "Cannot ray pick, hr %#lx.\n", hr);
+    ok(IDirect3DRMPicked2Array_GetSize(picked2) == 2, "Got %lu picks.\n", IDirect3DRMPicked2Array_GetSize(picked2));
+    hr = IDirect3DRMPicked2Array_GetPick(picked2, 0, &visual, &frames, &desc2);
+    ok(SUCCEEDED(hr), "Cannot get the pick, hr %#lx.\n", hr);
+    ok(desc2.dcColor == 0xffff0000, "Got color %#lx.\n", desc2.dcColor);
+    ok(fabsf(fabsf(desc2.dvNormal.z) - 1.0f) < 0.001f, "Got normal %.8e.\n", desc2.dvNormal.z);
+    IDirect3DRMFrameArray_Release(frames);
+    IDirect3DRMVisual_Release(visual);
+    IDirect3DRMPicked2Array_Release(picked2);
+    ray.dvDir.x = 1.0f; ray.dvDir.z = 0.0f;
+    hr = IDirect3DRMFrame3_RayPick(s.scene, NULL, &ray, 0, &picked2);
+    ok(SUCCEEDED(hr), "Cannot ray pick, hr %#lx.\n", hr);
+    ok(IDirect3DRMPicked2Array_GetSize(picked2) == 0, "Got %lu picks.\n", IDirect3DRMPicked2Array_GetSize(picked2));
+    IDirect3DRMPicked2Array_Release(picked2);
+
+    /* ForceUpdate names the area the next Update reports */
+    memset(&rect, 0xff, sizeof(rect));
+    hr = IDirect3DRMDevice3_AddUpdateCallback(s.device, (D3DRMUPDATECALLBACK)sg_update_cb, &rect);
+    ok(SUCCEEDED(hr), "Cannot add the callback, hr %#lx.\n", hr);
+    hr = IDirect3DRMViewport2_ForceUpdate(s.viewport, 10, 20, 100, 120);
+    ok(SUCCEEDED(hr), "Cannot force the update, hr %#lx.\n", hr);
+    hr = IDirect3DRMViewport2_ForceUpdate(s.viewport, 50, 60, 200, 80);
+    ok(SUCCEEDED(hr), "Cannot force the update, hr %#lx.\n", hr);
+    IDirect3DRMDevice3_Update(s.device);
+    ok(rect.x1 == 10 && rect.y1 == 20 && rect.x2 == 200 && rect.y2 == 120, "Got rect %ld, %ld, %ld, %ld.\n", rect.x1,
+            rect.y1, rect.x2, rect.y2);
+    hr = IDirect3DRMViewport2_ForceUpdate(s.viewport, 100, 0, 50, 10);
+    ok(hr == D3DRMERR_BADVALUE, "Got hr %#lx.\n", hr);
+    IDirect3DRMDevice3_DeleteUpdateCallback(s.device, (D3DRMUPDATECALLBACK)sg_update_cb, &rect);
+
+    IDirect3DRMMeshBuilder3_Release(far_builder);
+    IDirect3DRMMeshBuilder3_Release(builder);
+    IDirect3DRMFrame3_Release(holder);
+    sg_scene_cleanup(&s);
+}
