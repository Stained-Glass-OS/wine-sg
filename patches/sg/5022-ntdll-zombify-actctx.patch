From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Implement RtlZombifyActivationContext.

RtlZombifyActivationContext (ZombifyActCtx) succeeds for a valid activation
context - also an active one, also twice - and fails with
STATUS_INVALID_PARAMETER otherwise, as the kernel32 actctx tests show on
Windows; the context stays active and queryable. It returned
STATUS_NOT_IMPLEMENTED. Removes three todo_wine.

Gate: test/kernel32-zombifyactctx-gate.sh (64/32).
---
 dlls/kernel32/tests/actctx.c |  3 ---
 dlls/ntdll/actctx.c          | 12 +++++++++---
 2 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/dlls/kernel32/tests/actctx.c b/dlls/kernel32/tests/actctx.c
index b6f43b1..beb9805 100644
--- a/dlls/kernel32/tests/actctx.c
+++ b/dlls/kernel32/tests/actctx.c
@@ -3106,7 +3106,6 @@ static void test_ZombifyActCtx(void)
 
     SetLastError(0xdeadbeef);
     ret = ZombifyActCtx(NULL);
-    todo_wine
     ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "got %d, error %ld\n", ret, GetLastError());
 
     handle = create_manifest("test.manifest", testdep_manifest3, __LINE__);
@@ -3136,7 +3135,6 @@ static void test_ZombifyActCtx(void)
     ok(basicinfo.dwFlags == 0, "got %lx\n", basicinfo.dwFlags);
 
     ret = ZombifyActCtx(handle);
-    todo_wine
     ok(ret, "got %d\n", ret);
 
     memset(&basicinfo, 0xff, sizeof(basicinfo));
@@ -3158,7 +3156,6 @@ static void test_ZombifyActCtx(void)
 
     /* one more time */
     ret = ZombifyActCtx(handle);
-    todo_wine
     ok(ret, "got %d\n", ret);
 
     ret = DeactivateActCtx(0, cookie);
diff --git a/dlls/ntdll/actctx.c b/dlls/ntdll/actctx.c
index 1a43de7..a49311c 100644
--- a/dlls/ntdll/actctx.c
+++ b/dlls/ntdll/actctx.c
@@ -5448,12 +5448,18 @@ void WINAPI RtlReleaseActivationContext( HANDLE handle )
 /******************************************************************
  *              RtlZombifyActivationContext (NTDLL.@)
  *
- * FIXME: function prototype might be wrong
+ * Windows succeeds for a valid context, also an active one and also twice,
+ * and the context stays queryable and active (kernel32 actctx tests): there
+ * is nothing to release early here.
  */
 NTSTATUS WINAPI RtlZombifyActivationContext( HANDLE handle )
 {
-    FIXME("%p: stub\n", handle);
-    return STATUS_NOT_IMPLEMENTED;
+    TRACE("%p\n", handle);
+
+#ifndef SG_MUTANT_ZOMBIFY_NO_CHECK
+    if (!check_actctx( handle )) return STATUS_INVALID_PARAMETER;
+#endif
+    return STATUS_SUCCESS;
 }
 
 /******************************************************************
