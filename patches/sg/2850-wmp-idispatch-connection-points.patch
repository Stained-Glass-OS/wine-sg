From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmp: IDispatch on the control's objects, connection point enumerators

Stubs, as documented now:

- IDispatch GetTypeInfoCount / GetTypeInfo / GetIDsOfNames / Invoke (E_NOTIMPL
  on all six objects) now go through the control's type library: the player
  (IWMPPlayer4, and IWMPPlayer through it), settings, controls, network,
  media and playlist. GetTypeInfoCount is 1, GetTypeInfo(0) returns the
  interface's type information, any other index is DISP_E_BADINDEX with a NULL
  result, names and Invoke are resolved by the type information.
- The control now answers QueryInterface(IDispatch) (it was refused), the
  settings object answers IDispatch with its own interface, and the network
  object answers IUnknown.
- IEnumConnections Skip / Reset / Clone (E_NOTIMPL): Skip steps over live
  connections and returns S_FALSE when fewer were left, Reset restarts, Clone
  keeps the position. Next returned the AddRef of the wrong slot and a
  cookie that was the running count instead of the one Advise returned; both
  fixed, and a count above one without pcFetched is E_INVALIDARG.
- IConnectionPointContainer::EnumConnectionPoints (E_NOTIMPL): an
  IEnumConnectionPoints over the control's single point (_WMPOCXEvents) with
  Next / Skip / Reset / Clone.

---
diff --git a/dlls/wmp/events.c b/dlls/wmp/events.c
index 9f2b1cb..3b0ebf2 100644
--- a/dlls/wmp/events.c
+++ b/dlls/wmp/events.c
@@ -52,12 +52,165 @@ static ULONG WINAPI ConnectionPointContainer_Release(IConnectionPointContainer *
     return IOleObject_Release(&This->IOleObject_iface);
 }
 
+typedef struct {
+    IEnumConnectionPoints IEnumConnectionPoints_iface;
+
+    LONG ref;
+
+    WindowsMediaPlayer *wmp;
+    DWORD iter;
+} EnumConnectionPoints;
+
+static inline EnumConnectionPoints *impl_from_IEnumConnectionPoints(IEnumConnectionPoints *iface)
+{
+    return CONTAINING_RECORD(iface, EnumConnectionPoints, IEnumConnectionPoints_iface);
+}
+
+/* The control has a single connection point, _WMPOCXEvents. */
+#define WMP_CONNECTION_POINT_COUNT 1
+
+static HRESULT WINAPI EnumConnectionPoints_QueryInterface(IEnumConnectionPoints *iface, REFIID riid, void **ppv)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+
+    if(IsEqualGUID(&IID_IUnknown, riid) || IsEqualGUID(&IID_IEnumConnectionPoints, riid)) {
+        TRACE("(%p)->(%s %p)\n", This, debugstr_guid(riid), ppv);
+        *ppv = &This->IEnumConnectionPoints_iface;
+        IUnknown_AddRef((IUnknown*)*ppv);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s\n", debugstr_guid(riid));
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EnumConnectionPoints_AddRef(IEnumConnectionPoints *iface)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+    LONG ref = InterlockedIncrement(&This->ref);
+
+    TRACE("(%p) ref=%ld\n", This, ref);
+
+    return ref;
+}
+
+static ULONG WINAPI EnumConnectionPoints_Release(IEnumConnectionPoints *iface)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    TRACE("(%p) ref=%ld\n", This, ref);
+
+    if(!ref) {
+        IConnectionPointContainer_Release(&This->wmp->IConnectionPointContainer_iface);
+        free(This);
+    }
+
+    return ref;
+}
+
+static HRESULT WINAPI EnumConnectionPoints_Next(IEnumConnectionPoints *iface, ULONG cPoints,
+        IConnectionPoint **ppCP, ULONG *pcFetched)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG cnt = 0;
+
+    TRACE("(%p)->(%lu %p %p)\n", This, cPoints, ppCP, pcFetched);
+
+    if(!ppCP)
+        return E_POINTER;
+    if(!pcFetched && cPoints > 1)
+        return E_INVALIDARG;
+
+    while(cnt < cPoints && This->iter < WMP_CONNECTION_POINT_COUNT) {
+        ppCP[cnt] = &This->wmp->wmpocx->IConnectionPoint_iface;
+        IConnectionPoint_AddRef(ppCP[cnt]);
+        This->iter++;
+        cnt++;
+    }
+
+    if(pcFetched)
+        *pcFetched = cnt;
+    return cnt == cPoints ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumConnectionPoints_Skip(IEnumConnectionPoints *iface, ULONG cPoints)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+
+    TRACE("(%p)->(%lu)\n", This, cPoints);
+
+    if(cPoints > WMP_CONNECTION_POINT_COUNT - This->iter) {
+        This->iter = WMP_CONNECTION_POINT_COUNT;
+        return S_FALSE;
+    }
+    This->iter += cPoints;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumConnectionPoints_Reset(IEnumConnectionPoints *iface)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+
+    TRACE("(%p)\n", This);
+
+#ifndef SG_MUTANT_WMP_CPENUM_NO_RESET
+    This->iter = 0;
+#endif
+    return S_OK;
+}
+
+static HRESULT create_enum_connection_points(WindowsMediaPlayer *wmp, DWORD iter, IEnumConnectionPoints **ret);
+
+static HRESULT WINAPI EnumConnectionPoints_Clone(IEnumConnectionPoints *iface, IEnumConnectionPoints **ppEnum)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+
+    TRACE("(%p)->(%p)\n", This, ppEnum);
+
+    if(!ppEnum)
+        return E_POINTER;
+    return create_enum_connection_points(This->wmp, This->iter, ppEnum);
+}
+
+static const IEnumConnectionPointsVtbl EnumConnectionPointsVtbl = {
+    EnumConnectionPoints_QueryInterface,
+    EnumConnectionPoints_AddRef,
+    EnumConnectionPoints_Release,
+    EnumConnectionPoints_Next,
+    EnumConnectionPoints_Skip,
+    EnumConnectionPoints_Reset,
+    EnumConnectionPoints_Clone
+};
+
+static HRESULT create_enum_connection_points(WindowsMediaPlayer *wmp, DWORD iter, IEnumConnectionPoints **ret)
+{
+    EnumConnectionPoints *enum_cp;
+
+    if(!(enum_cp = malloc(sizeof(*enum_cp))))
+        return E_OUTOFMEMORY;
+
+    enum_cp->IEnumConnectionPoints_iface.lpVtbl = &EnumConnectionPointsVtbl;
+    enum_cp->ref = 1;
+    enum_cp->wmp = wmp;
+    enum_cp->iter = iter;
+    IConnectionPointContainer_AddRef(&wmp->IConnectionPointContainer_iface);
+
+    *ret = &enum_cp->IEnumConnectionPoints_iface;
+    return S_OK;
+}
+
 static HRESULT WINAPI ConnectionPointContainer_EnumConnectionPoints(IConnectionPointContainer *iface,
         IEnumConnectionPoints **ppEnum)
 {
     WindowsMediaPlayer *This = impl_from_IConnectionPointContainer(iface);
-    FIXME("(%p)->(%p)\n", This, ppEnum);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, ppEnum);
+
+    if(!ppEnum)
+        return E_POINTER;
+    return create_enum_connection_points(This, 0, ppEnum);
 }
 
 static HRESULT WINAPI ConnectionPointContainer_FindConnectionPoint(IConnectionPointContainer *iface,
@@ -108,6 +261,8 @@ typedef struct {
     DWORD iter;
 } EnumConnections;
 
+static const IEnumConnectionsVtbl EnumConnectionsVtbl;
+
 static inline EnumConnections *impl_from_IEnumConnections(IEnumConnections *iface)
 {
     return CONTAINING_RECORD(iface, EnumConnections, IEnumConnections_iface);
@@ -165,43 +320,88 @@ static HRESULT WINAPI EnumConnections_Next(IEnumConnections *iface, ULONG cConne
 
     TRACE("(%p)->(%lu %p %p)\n", This, cConnections, pgcd, pcFetched);
 
-    while(cConnections--) {
+    if(!pgcd)
+        return E_POINTER;
+    if(!pcFetched && cConnections > 1)
+        return E_INVALIDARG;
+
+    while(cnt < cConnections) {
         while(This->iter < This->cp->sinks_size && !This->cp->sinks[This->iter])
             This->iter++;
         if(This->iter == This->cp->sinks_size)
             break;
 
         pgcd[cnt].pUnk = (IUnknown*)This->cp->sinks[This->iter];
+#ifdef SG_MUTANT_WMP_CONN_COOKIE
         pgcd[cnt].dwCookie = cnt+1;
+#else
+        pgcd[cnt].dwCookie = This->iter+1; /* the cookie Advise returned */
+#endif
         This->iter++;
-        cnt++;
         IUnknown_AddRef(pgcd[cnt].pUnk);
+        cnt++;
     }
 
     if(pcFetched)
         *pcFetched = cnt;
-    return cnt ? S_OK : S_FALSE;
+    return cnt == cConnections ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI EnumConnections_Skip(IEnumConnections *iface, ULONG cConnections)
 {
     EnumConnections *This = impl_from_IEnumConnections(iface);
-    FIXME("(%p)->(%lu)\n", This, cConnections);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%lu)\n", This, cConnections);
+
+#ifdef SG_MUTANT_WMP_CONN_SKIP_NOOP
+    return S_OK;
+#endif
+    while(cConnections) {
+        while(This->iter < This->cp->sinks_size && !This->cp->sinks[This->iter])
+            This->iter++;
+        if(This->iter == This->cp->sinks_size)
+            return S_FALSE;
+        This->iter++;
+        cConnections--;
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI EnumConnections_Reset(IEnumConnections *iface)
 {
     EnumConnections *This = impl_from_IEnumConnections(iface);
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+
+    TRACE("(%p)\n", This);
+
+    This->iter = 0;
+    return S_OK;
 }
 
 static HRESULT WINAPI EnumConnections_Clone(IEnumConnections *iface, IEnumConnections **ppEnum)
 {
     EnumConnections *This = impl_from_IEnumConnections(iface);
-    FIXME("(%p)->(%p)\n", This, ppEnum);
-    return E_NOTIMPL;
+    EnumConnections *ret;
+
+    TRACE("(%p)->(%p)\n", This, ppEnum);
+
+    if(!ppEnum)
+        return E_POINTER;
+
+    if(!(ret = malloc(sizeof(*ret))))
+        return E_OUTOFMEMORY;
+
+    ret->IEnumConnections_iface.lpVtbl = &EnumConnectionsVtbl;
+    ret->ref = 1;
+#ifdef SG_MUTANT_WMP_CONN_CLONE_RESET
+    ret->iter = 0;
+#else
+    ret->iter = This->iter;
+#endif
+    IConnectionPoint_AddRef(&This->cp->IConnectionPoint_iface);
+    ret->cp = This->cp;
+
+    *ppEnum = &ret->IEnumConnections_iface;
+    return S_OK;
 }
 
