+            b->size = max( b->size * 2, b->len + n + 1 );
+            if (!(p = realloc( b->data, b->size * sizeof(WCHAR) ))) { free( b->data ); b->data = NULL; return; }
+            b->data = p;
+        }
+        memcpy( b->data + b->len, rep, n * sizeof(WCHAR) );
+        b->len += n;
+        b->data[b->len] = 0;
+    }
