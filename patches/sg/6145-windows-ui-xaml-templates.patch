+/* an internal DependencyPropertyChangedCallback, kept as long as the object */
+void dobj_add_callback( struct dobj *obj, struct xaml_property *prop, IUnknown *callback )
+{
+    struct dcallback *cb;
+
+    if (!(cb = calloc( 1, sizeof(*cb) ))) return;
+    cb->prop = prop;
+    cb->token = ++obj->next_token;
+    cb->callback = callback;
+    IUnknown_AddRef( callback );
+    list_add_tail( &obj->callbacks, &cb->entry );
+}
+
 static HRESULT WINAPI dobj2_UnregisterPropertyChangedCallback( struct xiface *iface, IInspectable *dp, INT64 token )
 {
     struct dobj *obj = dobj_from_iface( iface );
