+/*
+ * A control with a Template is drawn by the elements its template makes for it: the template's
+ * markup is kept as it was read and made again for each control it is applied to, its
+ * {TemplateBinding X} members following the control's X; a ContentPresenter in it shows the
+ * control's Content.  Then the control's OnApplyTemplate runs (an application's control finds its
+ * parts with GetTemplateChild there).
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* ---- ControlTemplate ---- */
+
+struct templ
+{
+    struct dobj d;
+    struct xiface IControlTemplate_iface, IFrameworkTemplate_iface;
+    WCHAR *target_type;
+    WCHAR *markup;                  /* its content, as XAML text with its namespaces */
+};
+
+static struct templ *templ_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct templ, d.obj );
+}
+
+static HRESULT WINAPI templ_get_TargetType( struct xiface *iface, struct xaml_type_name *value )
+{
+    struct templ *t = templ_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    value->Kind = 1;
+    return xaml_hstring( t->target_type ? t->target_type : L"", &value->Name );
+}
+
+static HRESULT WINAPI templ_put_TargetType( struct xiface *iface, struct xaml_type_name value )
+{
+    struct templ *t = templ_from_iface( iface );
+    const WCHAR *name = WindowsGetStringRawBuffer( value.Name, NULL );
+
+    free( t->target_type );
+    t->target_type = wcsdup( name ? name : L"" );
+    return S_OK;
+}
+
+static const void *templ_vtbl[] =
+{
+    IControlTemplate_STUBS,
+    [IControlTemplate_TargetType] = templ_get_TargetType,
+    [IControlTemplate_SetTargetType] = templ_put_TargetType,
+};
+
+static const void *framework_templ_vtbl[] = { IFrameworkTemplate_STUBS };
+
+static const struct xiface_entry templ_ifaces[] =
+{
+    { &IID_IControlTemplate, offsetof(struct templ, IControlTemplate_iface) },
+    { &IID_IFrameworkTemplate, offsetof(struct templ, IFrameworkTemplate_iface) },
+    DOBJ_IFACES(struct dobj),
+};
+
+static void templ_destroy( struct xobj *obj )
+{
+    struct templ *t = CONTAINING_RECORD( obj, struct templ, d.obj );
+
+    free( t->target_type );
+    free( t->markup );
+    dobj_cleanup( &t->d );
+}
+
+static const struct xclass templ_class =
+{
+    L"Windows.UI.Xaml.Controls.ControlTemplate", templ_ifaces, ARRAY_SIZE(templ_ifaces), templ_destroy,
+};
+
+static struct templ *templ_from_inspectable( IInspectable *iface )
+{
+    struct dobj *obj = dobj_from_inspectable( iface );
+    return obj && obj->obj.cls == &templ_class ? CONTAINING_RECORD( obj, struct templ, d ) : NULL;
+}
+
+BOOL xaml_is_template( IInspectable *obj )
+{
+    return templ_from_inspectable( obj ) != NULL;
+}
+
+/* the markup its content is made from */
+void xaml_template_set_markup( IInspectable *obj, WCHAR *markup )
+{
+    struct templ *t = templ_from_inspectable( obj );
+
+    if (!t) { free( markup ); return; }
+    free( t->markup );
+    t->markup = markup;
+}
+
+static HRESULT activate_templ( IInspectable **out )
+{
+    struct templ *t = calloc( 1, sizeof(*t) );
+
+    if (!t) return E_OUTOFMEMORY;
+    t->IControlTemplate_iface.vtbl = templ_vtbl;
+    t->IFrameworkTemplate_iface.vtbl = framework_templ_vtbl;
+    dobj_init( &t->d, &templ_class, NULL );
+    *out = (IInspectable *)&t->IControlTemplate_iface;
+    return S_OK;
+}
+
+static struct xfactory templ_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Controls.ControlTemplate",
+                                             { NULL }, { { NULL } }, activate_templ };
+IActivationFactory *control_template_factory = &templ_factory_obj.IActivationFactory_iface;
+
+/* ---- TemplateBinding: a template element's member follows the control's ---- */
+
+struct tbinding
+{
+    IUnknown IUnknown_iface;        /* a DependencyPropertyChangedCallback: Invoke(sender, dp) */
+    LONG ref;
+    IUnknown *target;               /* the element's object (a reference) */
+    struct dobj *target_obj;
+    struct xaml_property *target_prop, *source_prop;
+};
+
+static struct tbinding *tbinding_from_iface( IUnknown *iface )
+{
+    return CONTAINING_RECORD( iface, struct tbinding, IUnknown_iface );
+}
+
+static HRESULT WINAPI tbinding_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ))
+    {
+        *out = iface;
+        IUnknown_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI tbinding_AddRef( IUnknown *iface )
+{
+    return InterlockedIncrement( &tbinding_from_iface( iface )->ref );
+}
+
+static ULONG WINAPI tbinding_Release( IUnknown *iface )
+{
+    struct tbinding *b = tbinding_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &b->ref );
+
+    if (!ref)
+    {
+        if (b->target) IUnknown_Release( b->target );
+        free( b );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI tbinding_Invoke( IUnknown *iface, IInspectable *sender, IInspectable *dp )
+{
+    struct tbinding *b = tbinding_from_iface( iface );
+    struct dobj *source = dobj_from_inspectable( sender );
+    IInspectable *value = NULL;
+
+    if (!source) return S_OK;
+    dobj_get_value( source, b->source_prop, &value );
+    dobj_set_value( b->target_obj, b->target_prop, value );
+    if (value) IInspectable_Release( value );
+    return S_OK;
+}
+
+static const void *tbinding_vtbl[] = { tbinding_QueryInterface, tbinding_AddRef, tbinding_Release, tbinding_Invoke };
+
+/* {TemplateBinding Source} on a template element's member: its value now and when it changes */
+HRESULT xaml_template_bind( struct uielem *templated_parent, IInspectable *target, const WCHAR *member, const WCHAR *source )
+{
+    struct dobj *target_obj = dobj_from_inspectable( target );
+    struct xaml_property *source_prop, *target_prop;
+    IInspectable *value = NULL;
+    struct tbinding *b;
+
+    if (!target_obj) return E_INVALIDARG;
+#ifdef SG_MUTANT_TEMPLATE_NO_BINDING
+    return S_OK;
+#endif
+    if (!(source_prop = xaml_find_member( &templated_parent->d, source )) ||
+        !(target_prop = xaml_find_member( target_obj, member )))
+    {
+        FIXME( "TemplateBinding %s to %s\n", debugstr_w( source ), debugstr_w( member ) );
+        return S_OK;
+    }
+    dobj_get_value( &templated_parent->d, source_prop, &value );
+    dobj_set_value( target_obj, target_prop, value );
+    if (value) IInspectable_Release( value );
+    if (!(b = calloc( 1, sizeof(*b) ))) return E_OUTOFMEMORY;
+    b->IUnknown_iface.lpVtbl = (void *)tbinding_vtbl;
+    b->ref = 1;
+    IUnknown_QueryInterface( target_obj->obj.outer, &IID_IUnknown, (void **)&b->target );
+    b->target_obj = target_obj;
+    b->target_prop = target_prop;
+    b->source_prop = source_prop;
+    dobj_add_callback( &templated_parent->d, source_prop, &b->IUnknown_iface );
+    IUnknown_Release( &b->IUnknown_iface );
+    return S_OK;
+}
+
+/* ---- a control's template applied ---- */
+
+static void bind_presenters( struct uielem *elem, struct uielem *templated_parent )
+{
+    struct uielem *child;
+
+    if (xaml_is_presenter( elem ) && !xaml_presenter_has_content( elem ))
+        xaml_template_bind( templated_parent, uielem_iface( elem ), L"Content", L"Content" );
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry )
+        if (child != templated_parent) bind_presenters( child, templated_parent );
+}
+
+/* the template's elements made for the control; NULL if it has none */
+struct uielem *xaml_template_apply( IInspectable *template, struct uielem *control )
+{
+    struct templ *t = templ_from_inspectable( template );
+    IInspectable *root = NULL;
+    struct uielem *elem;
+    HRESULT hr;
+
+    if (!t || !t->markup) return NULL;
+    if (FAILED(hr = xaml_load_template( t->markup, control, &root )) || !root)
+    {
+        WARN( "template not made: %#lx\n", hr );
+        return NULL;
+    }
+    if (!(elem = uielem_from_inspectable( root )))
+    {
+        IInspectable_Release( root );
+        return NULL;
+    }
+    bind_presenters( elem, control );
+    TRACE( "%p: template applied, root %p\n", control, elem );
+    /* the control holds its template's root as its visual child */
+    uielem_add_child( control, elem );
+    IInspectable_Release( root );
+    return elem;
+}
