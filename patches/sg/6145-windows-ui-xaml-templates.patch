+/* text of markup: escaped for an attribute or for element content */
+struct text_buffer { WCHAR *data; size_t len, size; };
+
+static void tb_add( struct text_buffer *b, const WCHAR *str, BOOL escape )
+{
+    for (; *str && b->data; str++)
+    {
+        const WCHAR *rep = NULL;
+        size_t n;
+        WCHAR one[2] = { *str, 0 };
+
+        if (escape)
+        {
+            if (*str == '&') rep = L"&amp;";
+            else if (*str == '<') rep = L"&lt;";
+            else if (*str == '>') rep = L"&gt;";
+            else if (*str == '"') rep = L"&quot;";
+        }
+        if (!rep) rep = one;
+        n = wcslen( rep );
+        if (b->len + n + 1 > b->size)
