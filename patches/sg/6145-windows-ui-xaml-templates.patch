+static void template_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct control *control = control_from_elem( CONTAINING_RECORD( obj, struct uielem, d ) );
+
+    if (control->template_root)
+    {
+        uielem_remove_child( &control->e, control->template_root );
+        control->template_root = NULL;
+    }
+    control->template_tried = FALSE;
+    uielem_invalidate_measure( &control->e );
+}
+
+/* its template's elements made, once; then its OnApplyTemplate (an application's control may override it) */
+static void apply_template( struct control *control )
+{
+    IInspectable *template = NULL, *overrides;
+
+    control->template_tried = TRUE;
+    dobj_get_value( &control->e.d, prop_template, &template );
+    if (!template) return;
+    if ((control->template_root = xaml_template_apply( template, &control->e )))
+    {
+        /* the content is shown by the template's ContentPresenter now */
+        if (control->child) set_child( control, NULL, FALSE );
+        if (SUCCEEDED(IUnknown_QueryInterface( control->e.d.obj.outer, &IID_IFrameworkElementOverrides, (void **)&overrides )))
+        {
+            ((HRESULT (WINAPI *)( IInspectable * ))((void **)overrides->lpVtbl)[IFrameworkElementOverrides_OnApplyTemplate])( overrides );
+            IInspectable_Release( overrides );
+        }
+    }
+    IInspectable_Release( template );
+}
+
 void control_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
 {
     struct control *control = control_from_elem( elem );
     struct xthickness t;
     struct xsize inner;
 
+    if (!control->template_tried && control->kind != KIND_PRESENTER) apply_template( control );
+    if (control->template_root)
+    {
+        uielem_measure( control->template_root, available );
+        *desired = control->template_root->desired;
+        return;
+    }
+
     insets( control, &t );
     desired->width = t.left + t.right;
     desired->height = t.top + t.bottom;
@@ -246,6 +291,12 @@ void control_arrange( struct uielem *elem, struct xsize final, struct xsize *use
