From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] secur32, sspicli: QueryContextAttributesExA/W (6021)

QueryContextAttributes with the size of the caller's buffer (sspicli had
stubs: Paint.NET imports it).
---
diff --git a/dlls/secur32/secur32.spec b/dlls/secur32/secur32.spec
index 4d7b54b..061f8c6 100644
--- a/dlls/secur32/secur32.spec
+++ b/dlls/secur32/secur32.spec
@@ -46,6 +46,8 @@
 @ stdcall MakeSignature(ptr long ptr long)
 @ stdcall QueryContextAttributesA(ptr long ptr)
 @ stdcall QueryContextAttributesW(ptr long ptr)
+@ stdcall QueryContextAttributesExA(ptr long ptr long)
+@ stdcall QueryContextAttributesExW(ptr long ptr long)
 @ stdcall QueryCredentialsAttributesA(ptr long ptr)
 @ stdcall QueryCredentialsAttributesW(ptr long ptr)
 @ stdcall QuerySecurityContextToken(ptr ptr)
diff --git a/dlls/secur32/wrapper.c b/dlls/secur32/wrapper.c
index 53fea29..7333bae 100644
--- a/dlls/secur32/wrapper.c
+++ b/dlls/secur32/wrapper.c
@@ -427,6 +427,79 @@ SECURITY_STATUS WINAPI QueryContextAttributesW(PCtxtHandle phContext,
     return ret;
 }
 
+/* Stained Glass OS: the size of the structure an attribute fills, or 0 when it is not known here */
+static ULONG context_attribute_size(ULONG attribute, BOOL unicode)
+{
+    switch (attribute)
+    {
+    case SECPKG_ATTR_SIZES:             return sizeof(SecPkgContext_Sizes);
+    case SECPKG_ATTR_NAMES:             return unicode ? sizeof(SecPkgContext_NamesW) : sizeof(SecPkgContext_NamesA);
+    case SECPKG_ATTR_LIFESPAN:          return sizeof(SecPkgContext_Lifespan);
+    case SECPKG_ATTR_DCE_INFO:          return sizeof(SecPkgContext_DceInfo);
+    case SECPKG_ATTR_STREAM_SIZES:      return sizeof(SecPkgContext_StreamSizes);
+    case SECPKG_ATTR_KEY_INFO:          return unicode ? sizeof(SecPkgContext_KeyInfoW) : sizeof(SecPkgContext_KeyInfoA);
+    case SECPKG_ATTR_AUTHORITY:         return unicode ? sizeof(SecPkgContext_AuthorityW) : sizeof(SecPkgContext_AuthorityA);
+    case SECPKG_ATTR_PROTO_INFO:        return unicode ? sizeof(SecPkgContext_ProtoInfoW) : sizeof(SecPkgContext_ProtoInfoA);
+    case SECPKG_ATTR_PASSWORD_EXPIRY:   return sizeof(SecPkgContext_PasswordExpiry);
+    case SECPKG_ATTR_SESSION_KEY:       return sizeof(SecPkgContext_SessionKey);
+    case SECPKG_ATTR_PACKAGE_INFO:      return unicode ? sizeof(SecPkgContext_PackageInfoW) : sizeof(SecPkgContext_PackageInfoA);
+    case SECPKG_ATTR_USER_FLAGS:        return sizeof(SecPkgContext_UserFlags);
+    case SECPKG_ATTR_NEGOTIATION_INFO:  return unicode ? sizeof(SecPkgContext_NegotiationInfoW) : sizeof(SecPkgContext_NegotiationInfoA);
+    case SECPKG_ATTR_NATIVE_NAMES:      return unicode ? sizeof(SecPkgContext_NativeNamesW) : sizeof(SecPkgContext_NativeNamesA);
+    case SECPKG_ATTR_FLAGS:             return sizeof(SecPkgContext_Flags);
+    case SECPKG_ATTR_ACCESS_TOKEN:      return sizeof(SecPkgContext_AccessToken);
+    case SECPKG_ATTR_TARGET_INFORMATION: return sizeof(SecPkgContext_TargetInformation);
+    case SECPKG_ATTR_UNIQUE_BINDINGS:
+    case SECPKG_ATTR_ENDPOINT_BINDINGS: return sizeof(SecPkgContext_Bindings);
+    case SECPKG_ATTR_APPLICATION_PROTOCOL: return sizeof(SecPkgContext_ApplicationProtocol);
+    default:                            return 0;
+    }
+}
+
+/* QueryContextAttributes with the size of the caller's buffer: what the attribute fills must fit;
+ * an attribute whose structure is not known here is filled in a buffer of ours and as much of it
+ * as fits is copied */
+static SECURITY_STATUS query_context_attributes_ex(PCtxtHandle context, ULONG attribute, void *buffer, ULONG size,
+                                                   BOOL unicode)
+{
+    ULONG need = context_attribute_size(attribute, unicode);
+    SECURITY_STATUS ret;
+    BYTE *tmp;
+
+    if (!buffer) return SEC_E_INVALID_PARAMETER;
+    if (need)
+    {
+#ifndef SG_MUTANT_QCAEX_NO_SIZE_CHECK
+        if (size < need) return SEC_E_INSUFFICIENT_MEMORY;
+#endif
+        return unicode ? QueryContextAttributesW(context, attribute, buffer)
+                       : QueryContextAttributesA(context, attribute, buffer);
+    }
+    if (!(tmp = calloc(1, 4096))) return SEC_E_INSUFFICIENT_MEMORY;
+    ret = unicode ? QueryContextAttributesW(context, attribute, tmp) : QueryContextAttributesA(context, attribute, tmp);
+    if (ret == SEC_E_OK) memcpy(buffer, tmp, min(size, 4096));
+    free(tmp);
+    return ret;
+}
+
+/***********************************************************************
+ *		QueryContextAttributesExA (SECUR32.@)
+ */
+SECURITY_STATUS WINAPI QueryContextAttributesExA(PCtxtHandle phContext, ULONG ulAttribute, void *pBuffer, ULONG cbBuffer)
+{
+    TRACE("%p %ld %p %lu\n", phContext, ulAttribute, pBuffer, cbBuffer);
+    return query_context_attributes_ex(phContext, ulAttribute, pBuffer, cbBuffer, FALSE);
+}
+
+/***********************************************************************
+ *		QueryContextAttributesExW (SECUR32.@)
+ */
+SECURITY_STATUS WINAPI QueryContextAttributesExW(PCtxtHandle phContext, ULONG ulAttribute, void *pBuffer, ULONG cbBuffer)
+{
+    TRACE("%p %ld %p %lu\n", phContext, ulAttribute, pBuffer, cbBuffer);
+    return query_context_attributes_ex(phContext, ulAttribute, pBuffer, cbBuffer, TRUE);
+}
+
 /***********************************************************************
  *		ImpersonateSecurityContext (SECUR32.@)
  */
diff --git a/dlls/sspicli/sspicli.spec b/dlls/sspicli/sspicli.spec
index ade061a..cb14a50 100644
--- a/dlls/sspicli/sspicli.spec
+++ b/dlls/sspicli/sspicli.spec
@@ -45,8 +45,8 @@
 @ stub LsaUnregisterPolicyChangeNotification
 @ stdcall MakeSignature(ptr long ptr long) secur32.MakeSignature
 @ stdcall QueryContextAttributesA(ptr long ptr) secur32.QueryContextAttributesA
-@ stub QueryContextAttributesExA
-@ stub QueryContextAttributesExW
+@ stdcall QueryContextAttributesExA(ptr long ptr long) secur32.QueryContextAttributesExA
+@ stdcall QueryContextAttributesExW(ptr long ptr long) secur32.QueryContextAttributesExW
 @ stdcall QueryContextAttributesW(ptr long ptr) secur32.QueryContextAttributesW
 @ stdcall QueryCredentialsAttributesA(ptr long ptr) secur32.QueryCredentialsAttributesA
 @ stub QueryCredentialsAttributesExA
diff --git a/include/sspi.h b/include/sspi.h
index 6d7ea5a..05f8d92 100644
--- a/include/sspi.h
+++ b/include/sspi.h
@@ -467,6 +467,12 @@ SECURITY_STATUS SEC_ENTRY QueryContextAttributesW(PCtxtHandle phContext,
  ULONG ulAttribute, void *pBuffer);
 #define QueryContextAttributes WINELIB_NAME_AW(QueryContextAttributes)
 
+SECURITY_STATUS SEC_ENTRY QueryContextAttributesExA(PCtxtHandle phContext,
+ ULONG ulAttribute, void *pBuffer, ULONG cbBuffer);
+SECURITY_STATUS SEC_ENTRY QueryContextAttributesExW(PCtxtHandle phContext,
+ ULONG ulAttribute, void *pBuffer, ULONG cbBuffer);
+#define QueryContextAttributesEx WINELIB_NAME_AW(QueryContextAttributesEx)
+
 typedef SECURITY_STATUS (SEC_ENTRY *QUERY_CONTEXT_ATTRIBUTES_FN_A)(PCtxtHandle,
  ULONG, void *);
 typedef SECURITY_STATUS (SEC_ENTRY *QUERY_CONTEXT_ATTRIBUTES_FN_W)(PCtxtHandle,
