+    0x7d, 0x4a, 0x4b, 0x4c, 0x4d, 0x4e, 0x4f, 0x50, 0x51, 0x52, 0xb9, 0xfb, 0xfc, 0xf9, 0xfa, 0xff,
+    0x5c, 0xf7, 0x53, 0x54, 0x55, 0x56, 0x57, 0x58, 0x59, 0x5a, 0xb2, 0xd4, 0xd6, 0xd2, 0xd3, 0xd5,
+    0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0xb3, 0xdb, 0xdc, 0xd9, 0xda, 0x9f,
+};
+
+/* a pointer whose referent follows the data which contains it */
+struct deferred
+{
+    const unsigned char *format;    /* the pointer's format: type, attributes, description */
+    ULONG id;
+};
+
+struct conv
+{
+    unsigned char *buf, *end;
+    BOOL big;                       /* integers are big-endian */
+    BOOL ebcdic;
+    unsigned int float_fmt;         /* NDR_*_FLOAT, NDR_IEEE_FLOAT, or 0x200 for Cray */
+    BOOL dry;                       /* only measure: change nothing, defer nothing */
+    BOOL nodefer;                   /* in a simple type: its pointer layout names the referents */
+    int depth;
+    SIZE_T max_count, actual_count, offset;
+    int corr_incr;                  /* CorrDespIncrement */
+    BOOL is_client;
+    struct deferred *def;           /* the stack of deferred pointers */
+    unsigned int ndef, defcap;
+    BOOL owner_active;              /* a construct is collecting deferred pointers */
+    ULONG *seen;                    /* ids of full pointers already met */
+    unsigned int nseen, seencap;
+};
+
+static void DECLSPEC_NORETURN bad_data(void)
+{
+    RpcRaiseException(RPC_X_BAD_STUB_DATA);
+    for (;;) ;
+}
+
+static inline void need(const struct conv *c, SIZE_T n)
+{
+    if (n > (SIZE_T)(c->end - c->buf)) bad_data();
+}
+
+static inline void align(struct conv *c, unsigned int a)
+{
+    ULONG_PTR mask = a - 1;
+    unsigned char *p = (unsigned char *)(((ULONG_PTR)c->buf + mask) & ~mask);
+    if (p > c->end || p < c->buf) bad_data();
+    c->buf = p;
+}
+
+/* the number of bytes to be consumed from the format of safe_multiply() in ndr_marshall.c */
+static inline SIZE_T mul(SIZE_T a, SIZE_T b)
+{
+    ULONGLONG r = (ULONGLONG)a * b;
+    if (r > 0xffffffff) RpcRaiseException(RPC_S_INVALID_BOUND);
+    return r;
+}
+
+static inline USHORT swap16(USHORT v) { return (v >> 8) | (v << 8); }
+static inline ULONG swap32(ULONG v) { return ((ULONG)swap16(v) << 16) | swap16(v >> 16); }
+static inline ULONGLONG swap64(ULONGLONG v) { return ((ULONGLONG)swap32(v) << 32) | swap32(v >> 32); }
+
+/* ---- floating point formats ---------------------------------------------------------------- */
+
+static int highest_bit(ULONGLONG v)
+{
+    int n = -1;
+    while (v) { n++; v >>= 1; }
+    return n;
+}
+
+/* packs sign, a binary exponent (value = 1.f * 2^e) and the bits of the fraction below the
+ * leading one (frac of fbits bits) into an IEEE number with ebits of exponent and mbits of
+ * mantissa; too small values become zero or denormals, too large ones infinity */
+static ULONGLONG pack_ieee(int sign, int e, ULONGLONG frac, int fbits, int ebits, int mbits)
+{
+    int bias = (1 << (ebits - 1)) - 1, E = e + bias;
+    ULONGLONG m;
+
+    if (fbits > mbits) m = frac >> (fbits - mbits);
+    else m = frac << (mbits - fbits);
+
+    if (E >= (1 << ebits) - 1)
+        return ((ULONGLONG)sign << (ebits + mbits)) | ((ULONGLONG)((1 << ebits) - 1) << mbits);
+    if (E <= 0)
+    {
+        int shift = 1 - E;
+        if (shift > mbits + 1) return (ULONGLONG)sign << (ebits + mbits);
+        m = ((ULONGLONG)1 << mbits) | m;
+        return ((ULONGLONG)sign << (ebits + mbits)) | (m >> shift);
+    }
+    return ((ULONGLONG)sign << (ebits + mbits)) | ((ULONGLONG)E << mbits) | m;
+}
+
+/* converts the 32 bit number v, read in the byte order of the label, to IEEE single */
+static ULONG float_to_ieee32(ULONG v, unsigned int fmt)
+{
+    int sign, e;
+    ULONG frac;
+
+    switch (fmt)
+    {
+    case NDR_VAX_FLOAT: /* F_floating: 16 bit words, sign, 8 bit exponent (excess 128), 0.1f */
+    {
+        ULONG w0 = v & 0xffff, w1 = v >> 16;
+#ifdef SG_MUTANT_CONVERT_VAXWORDS
+        w0 = v >> 16; w1 = v & 0xffff;
+#endif
+        sign = w0 >> 15;
+        e = (w0 >> 7) & 0xff;
+        frac = ((w0 & 0x7f) << 16) | w1;
+        if (!e) return 0;           /* zero (or the reserved operand) */
+        return pack_ieee(sign, e - 129, frac, 23, 8, 23);
+    }
+    case NDR_IBM_FLOAT: /* short: sign, 7 bit exponent (excess 64, base 16), 6 hex digits */
+    {
+        int p;
+        sign = v >> 31;
+        e = (v >> 24) & 0x7f;
+        frac = v & 0xffffff;
+        if (!frac) return (ULONG)sign << 31;
+        p = highest_bit(frac);
+        #ifdef SG_MUTANT_CONVERT_IBMBIAS
+        e++;
+#endif
+        return pack_ieee(sign, p - 24 + 4 * (e - 64), frac & ((1u << p) - 1), p, 8, 23);
+    }
+    default:    /* IEEE, and Cray single which is IEEE */
+        return v;
+    }
+}
+
+static ULONGLONG float_to_ieee64(ULONGLONG v, unsigned int fmt)
+{
+    int sign, e, p;
+    ULONGLONG frac;
+
+    switch (fmt)
+    {
+    case NDR_VAX_FLOAT: /* G_floating: 4 words, sign, 11 bit exponent (excess 1024), 0.1f */
+    {
+        ULONGLONG w0 = v & 0xffff, w1 = (v >> 16) & 0xffff, w2 = (v >> 32) & 0xffff, w3 = v >> 48;
+        sign = w0 >> 15;
+        e = (w0 >> 4) & 0x7ff;
+        frac = ((w0 & 0xf) << 48) | (w1 << 32) | (w2 << 16) | w3;
+        if (!e) return 0;
+        return pack_ieee(sign, e - 1025, frac, 52, 11, 52);
+    }
+    case NDR_IBM_FLOAT: /* long: 7 bit exponent (excess 64, base 16), 14 hex digits */
+        sign = v >> 63;
+        e = (v >> 56) & 0x7f;
+        frac = v & (((ULONGLONG)1 << 56) - 1);
+        if (!frac) return (ULONGLONG)sign << 63;
+        p = highest_bit(frac);
+        return pack_ieee(sign, p - 56 + 4 * (e - 64), frac & (((ULONGLONG)1 << p) - 1), p, 11, 52);
+    case 0x200: /* Cray: sign, 15 bit exponent (excess 16384), 48 bit fraction with the leading bit */
+        sign = v >> 63;
+        e = (v >> 48) & 0x7fff;
+        frac = v & (((ULONGLONG)1 << 48) - 1);
+        if (!frac) return (ULONGLONG)sign << 63;
+        p = highest_bit(frac);
+        #ifdef SG_MUTANT_CONVERT_CRAYBIAS
+        e--;
+#endif
+        return pack_ieee(sign, p - 48 + (e - 16384), frac & (((ULONGLONG)1 << p) - 1), p, 11, 52);
+    default:
+        return v;
+    }
+}
+
+/* ---- the primitives ------------------------------------------------------------------------ */
+
+static void cv16(struct conv *c, unsigned char *p)
+{
+    USHORT v;
+#ifdef SG_MUTANT_CONVERT_NOSWAP16
+    return;
+#endif
+    if (c->dry || !c->big) return;
+    memcpy(&v, p, 2);
+    v = swap16(v);
+    memcpy(p, &v, 2);
+}
+
+static void cv32(struct conv *c, unsigned char *p)
+{
+    ULONG v;
+#ifdef SG_MUTANT_CONVERT_NOSWAP32
+    return;
+#endif
+    if (c->dry || !c->big) return;
+    memcpy(&v, p, 4);
+    v = swap32(v);
+    memcpy(p, &v, 4);
+}
+
+static void cv64(struct conv *c, unsigned char *p)
+{
+    ULONGLONG v;
+#ifdef SG_MUTANT_CONVERT_NOSWAP64
+    return;
+#endif
+    if (c->dry || !c->big) return;
+    memcpy(&v, p, 8);
+    v = swap64(v);
+    memcpy(p, &v, 8);
+}
+
+static void cvf32(struct conv *c, unsigned char *p)
+{
+    ULONG v;
+    if (c->dry) return;
+    memcpy(&v, p, 4);
+    if (c->float_fmt == 0x200) v = swap32(v);   /* Cray single: IEEE big-endian */
+    else if (c->big) v = swap32(v);
+    v = float_to_ieee32(v, c->float_fmt);
+    memcpy(p, &v, 4);
+}
+
+static void cvf64(struct conv *c, unsigned char *p)
+{
+    ULONGLONG v;
+    if (c->dry) return;
+    memcpy(&v, p, 8);
+    if (c->big) v = swap64(v);
+    v = float_to_ieee64(v, c->float_fmt);
+    memcpy(p, &v, 8);
+}
+
+static void cvchar(struct conv *c, unsigned char *p)
+{
+#ifdef SG_MUTANT_CONVERT_NOEBCDIC
+    return;
+#endif
+    if (!c->dry && c->ebcdic) *p = ebcdic_to_latin1[*p];
+}
+
+static SIZE_T base_size(unsigned char fc)
+{
+    switch (fc)
+    {
+    case FC_BYTE: case FC_CHAR: case FC_SMALL: case FC_USMALL: return 1;
+    case FC_WCHAR: case FC_SHORT: case FC_USHORT: case FC_ENUM16: return 2;
+    case FC_LONG: case FC_ULONG: case FC_FLOAT: case FC_ENUM32: case FC_ERROR_STATUS_T:
+    case FC_INT3264: case FC_UINT3264: return 4;
+    case FC_HYPER: case FC_DOUBLE: return 8;
+    case FC_IGNORE: return 0;
+    default: return 0;
+    }
+}
+
+static BOOL is_base_type(unsigned char fc)
+{
+    return (fc >= FC_BYTE && fc <= FC_ERROR_STATUS_T) || fc == FC_INT3264 || fc == FC_UINT3264;
+}
+
+/* converts one value of a base type at p */
+static void conv_value(struct conv *c, unsigned char fc, unsigned char *p)
+{
+    switch (fc)
+    {
+    case FC_CHAR: cvchar(c, p); break;
+    case FC_WCHAR: case FC_SHORT: case FC_USHORT: case FC_ENUM16: cv16(c, p); break;
+    case FC_LONG: case FC_ULONG: case FC_ENUM32: case FC_ERROR_STATUS_T: case FC_INT3264:
+    case FC_UINT3264: cv32(c, p); break;
+    case FC_FLOAT: cvf32(c, p); break;
+    case FC_HYPER: cv64(c, p); break;
+    case FC_DOUBLE: cvf64(c, p); break;
+    default: break;
+    }
+}
+
+/* a base type as the unmarshallers read it: aligned, then its value */
+static void conv_base(struct conv *c, unsigned char fc)
+{
+    SIZE_T size = base_size(fc);
+
+    if (!is_base_type(fc) && fc != FC_IGNORE) bad_data();
+    if (!size) return;
+    align(c, size);
+    need(c, size);
+    conv_value(c, fc, c->buf);
+    c->buf += size;
+}
+
+/* n values of a base type, each of them aligned (they are, by the alignment of the first) */
+static void conv_values(struct conv *c, unsigned char fc, SIZE_T n)
+{
+    SIZE_T size = base_size(fc), i;
+
+    if (!size) return;
+    align(c, size);
+    if (n > (SIZE_T)(c->end - c->buf) / size) bad_data();
+    if (!c->dry)
+    {
+        BOOL needed;
+
+        if (fc == FC_CHAR) needed = c->ebcdic;
+        else if (fc == FC_FLOAT || fc == FC_DOUBLE) needed = c->big || c->float_fmt != NDR_IEEE_FLOAT;
+        else needed = size > 1 && c->big;
+        if (needed) for (i = 0; i < n; i++) conv_value(c, fc, c->buf + i * size);
+    }
+    c->buf += n * size;
+}
+
+static ULONG read_ulong(struct conv *c)
+{
+    ULONG v;
+    align(c, 4);
+    need(c, 4);
+    cv32(c, c->buf);
+    memcpy(&v, c->buf, 4);
+    c->buf += 4;
+    return v;
+}
+
+/* ---- deferred pointers --------------------------------------------------------------------- */
+
+static void conv_type(struct conv *c, const unsigned char *f);
+
+static void push_deferred(struct conv *c, const unsigned char *pfmt, ULONG id)
+{
+    if (c->dry || c->nodefer) return;
+    if (c->ndef == c->defcap)
+    {
+        unsigned int cap = c->defcap ? c->defcap * 2 : 16;
+        struct deferred *p = realloc(c->def, cap * sizeof(*p));
+        if (!p) RpcRaiseException(RPC_X_NO_MEMORY);
+        c->def = p;
+        c->defcap = cap;
+    }
+    c->def[c->ndef].format = pfmt;
+    c->def[c->ndef].id = id;
+    c->ndef++;
+}
+
+static BOOL seen_id(struct conv *c, ULONG id)
+{
+    unsigned int i;
+
+    for (i = 0; i < c->nseen; i++) if (c->seen[i] == id) return TRUE;
+    if (c->nseen == c->seencap)
+    {
+        unsigned int cap = c->seencap ? c->seencap * 2 : 16;
+        ULONG *p = realloc(c->seen, cap * sizeof(*p));
+        if (!p) RpcRaiseException(RPC_X_NO_MEMORY);
+        c->seen = p;
+        c->seencap = cap;
+    }
+    c->seen[c->nseen++] = id;
+    return FALSE;
+}
+
+static inline const unsigned char *pointee_format(const unsigned char *pfmt)
+{
+    if (pfmt[1] & FC_SIMPLE_POINTER) return pfmt + 2;
+    return pfmt + 2 + *(const SHORT *)(pfmt + 2);
+}
+
+/* converts the referent of a pointer */
+static void conv_referent(struct conv *c, const unsigned char *pfmt, ULONG id)
+{
+    if (pfmt[0] == FC_FP)
+    {
+#ifdef SG_MUTANT_CONVERT_NOSEEN
+        if (!id) return;
+#else
+        if (!id || seen_id(c, id)) return;
+#endif
+    }
+    else if (pfmt[0] != FC_RP && !id) return;
+    conv_type(c, pointee_format(pfmt));
+}
+
+/* opens a construct which may contain pointers: its pointers' referents follow it, or follow
+ * the construct which contains it */
+static unsigned int construct_begin(struct conv *c, BOOL *owner)
+{
+    *owner = !c->owner_active;
+    c->owner_active = TRUE;
+    return c->ndef;
+}
+
+static void construct_end(struct conv *c, BOOL owner, unsigned int base)
+{
+    unsigned int i, limit;
+
+    if (!owner) return;
+    limit = c->ndef;
+    c->owner_active = FALSE;
+    for (i = base; i < limit; i++)
+    {
+        struct deferred d = c->def[i];
+        conv_referent(c, d.format, d.id);
+        c->ndef = limit;
+    }
+    c->ndef = base;
+}
+
+/* a pointer inside a construct: its id here, its referent later */
+static void conv_member_pointer(struct conv *c, const unsigned char *pfmt)
+{
+    ULONG id = 0;
+
+    if (pfmt[0] != FC_RP) id = read_ulong(c);
+#ifdef SG_MUTANT_CONVERT_NODEFER
+    if (pfmt[0] == FC_RP || id) conv_referent(c, pfmt, id);
+    return;
+#endif
+    if (pfmt[0] == FC_RP || id) push_deferred(c, pfmt, id);
+}
+
+/* the pointer layout (FC_PP) of a simple structure or array: the referents of its pointers are
+ * deferred; mark is where the data the layout is about starts.  Returns the format after it. */
+static const unsigned char *conv_pointer_layout(struct conv *c, const unsigned char *f, unsigned char *mark)
+{
+    unsigned int rep, count, stride, i, u;
+
+    f += 2; /* FC_PP, FC_PAD */
+    while (*f != FC_END)
+    {
+        switch (*f)
+        {
+        case FC_FIXED_REPEAT:
+            rep = *(const WORD *)(f + 2);
+            stride = *(const WORD *)(f + 4);
+            count = *(const WORD *)(f + 8);
+            f += 10;
+            break;
+        case FC_VARIABLE_REPEAT:
+            rep = f[1] == FC_VARIABLE_OFFSET ? c->actual_count : c->max_count;
+            stride = *(const WORD *)(f + 2);
+            count = *(const WORD *)(f + 6);
+            f += 8;
+            break;
+        case FC_NO_REPEAT:
+        default:
+            rep = 1;
+            stride = 0;
+            count = 1;
+            f += 2;
+            break;
+        }
+        for (i = 0; i < rep; i++)
+        {
+            const unsigned char *info = f;
+            for (u = 0; u < count; u++, info += 8)
+            {
+                unsigned char *bufptr = mark + (SIZE_T)i * stride + *(const SHORT *)(info + 2);
+                const unsigned char *pfmt = info + 4;
+                ULONG id = 0;
+
+                if (c->dry) continue;
+#ifdef SG_MUTANT_CONVERT_NOLAYOUT
+                continue;
+#endif
+                if (pfmt[0] != FC_RP)
+                {
+                    if (bufptr < mark || bufptr + 4 > c->end) bad_data();
+                    memcpy(&id, bufptr, 4);     /* converted with the data */
+                    if (!id) continue;
+                }
+                push_deferred(c, pfmt, id);
+            }
+        }
+        f += 8 * count;
+    }
+    return f + 1;
+}
+
+static const unsigned char *skip_pointer_layout(const unsigned char *f)
+{
+    unsigned int count;
+
+    f += 2;
+    while (*f != FC_END)
+    {
+        switch (*f)
+        {
+        case FC_FIXED_REPEAT: count = *(const WORD *)(f + 8); f += 10; break;
+        case FC_VARIABLE_REPEAT: count = *(const WORD *)(f + 6); f += 8; break;
+        default: count = 1; f += 2; break;
+        }
+        f += 8 * count;
+    }
+    return f + 1;
+}
+
+/* ---- member lists -------------------------------------------------------------------------- */
+
+/* The members of a type whose wire image is its memory image, with the padding spelled out by the
+ * format (structures and arrays of "simple" types).  start is where the type starts; returns the
+ * number of bytes it takes. */
+static SIZE_T conv_simple_members(struct conv *c, const unsigned char *f, unsigned char *start)
+{
+    SIZE_T off = 0;
+    unsigned char *save = c->buf;
+
+    for (; *f != FC_END; f++)
+    {
+        SIZE_T size;
+
+        switch (*f)
+        {
+        case FC_BYTE: case FC_SMALL: case FC_USMALL:
+            off += 1;
+            break;
+        case FC_POINTER:
+            if (start + off + 4 > c->end) bad_data();
+            cv32(c, start + off);
+            off += 4;
+            break;
+        case FC_RP:
+            f += 3;
+            break;
+        case FC_UP: case FC_OP: case FC_FP:
+            if (start + off + 4 > c->end) bad_data();
+            cv32(c, start + off);
+            off += 4;
+            f += 3;
+            break;
+        case FC_ALIGNM2: off = (off + 1) & ~(SIZE_T)1; break;
+        case FC_ALIGNM4: off = (off + 3) & ~(SIZE_T)3; break;
+        case FC_ALIGNM8: off = (off + 7) & ~(SIZE_T)7; break;
+        case FC_STRUCTPAD1: case FC_STRUCTPAD2: case FC_STRUCTPAD3: case FC_STRUCTPAD4:
+        case FC_STRUCTPAD5: case FC_STRUCTPAD6: case FC_STRUCTPAD7:
+            off += *f - FC_STRUCTPAD1 + 1;
+            break;
+        case FC_PAD:
+            break;
+        case FC_EMBEDDED_COMPLEX:
+            off += f[1];
+            c->buf = start + off;
+            {
+                BOOL nodefer = c->nodefer;
+
+                c->nodefer = TRUE;
+                conv_type(c, f + 2 + *(const SHORT *)(f + 2));
+                c->nodefer = nodefer;
+            }
+            off = c->buf - start;
+            f += 3;
+            break;
+        default:
+            if (!is_base_type(*f)) bad_data();
+            size = base_size(*f);
+            if (start + off + size > c->end) bad_data();
+            conv_value(c, *f, start + off);
+            off += size;
+            break;
+        }
+    }
+    c->buf = save;
+    return off;
+}
+
+/* The members of a complex structure, or an element of a complex array, in the order the
+ * unmarshaller reads them.  The unmarshaller advances through the buffer without aligning the
+ * members to their natural alignment (the padding the format spells out is in memory only), and
+ * so does this. */
+static void conv_complex_members(struct conv *c, const unsigned char *f, const unsigned char *ptrs)
+{
+    for (; *f != FC_END; f++)
+    {
+        switch (*f)
+        {
+        case FC_BYTE: case FC_SMALL: case FC_USMALL: case FC_CHAR: case FC_WCHAR: case FC_SHORT:
+        case FC_USHORT: case FC_ENUM16: case FC_LONG: case FC_ULONG: case FC_ENUM32:
+        case FC_ERROR_STATUS_T: case FC_INT3264: case FC_UINT3264: case FC_FLOAT: case FC_HYPER:
+        case FC_DOUBLE:
+        {
+            SIZE_T size = base_size(*f);
+            need(c, size);
+            conv_value(c, *f, c->buf);
+            c->buf += size;
+            break;
+        }
+        case FC_POINTER:
+            if (!ptrs) bad_data();
+            if (ptrs[0] != FC_RP) align(c, 4);
+            conv_member_pointer(c, ptrs);
+            ptrs += 4;
+            break;
+        case FC_RP: case FC_UP: case FC_OP: case FC_FP:
+            if (f[0] != FC_RP) align(c, 4);
+            conv_member_pointer(c, f);
+            f += 3;
+            break;
+        case FC_ALIGNM2: case FC_ALIGNM4: case FC_ALIGNM8: case FC_PAD:
+        case FC_STRUCTPAD1: case FC_STRUCTPAD2: case FC_STRUCTPAD3: case FC_STRUCTPAD4:
+        case FC_STRUCTPAD5: case FC_STRUCTPAD6: case FC_STRUCTPAD7:
+            break;
+        case FC_EMBEDDED_COMPLEX:
+            conv_type(c, f + 2 + *(const SHORT *)(f + 2));
+            f += 3;
+            break;
+        case FC_IGNORE:
+            break;
+        default:
+            bad_data();
+        }
+    }
+}
+
+/* ---- arrays and strings -------------------------------------------------------------------- */
+
+static inline const unsigned char *skip_corr(const struct conv *c, const unsigned char *f)
+{
+    return f + 4 + c->corr_incr;
+}
+
+static inline BOOL has_corr(const unsigned char *f)
+{
+    return *(const ULONG *)f != (ULONG)-1;
+}
+
+static void read_conformance(struct conv *c)
+{
+    c->max_count = read_ulong(c);
+#ifdef SG_MUTANT_CONVERT_MAXCOUNT
+    c->max_count++;
+#endif
+}
+
+static void read_variance(struct conv *c)
+{
+    c->offset = read_ulong(c);
+    c->actual_count = read_ulong(c);
+}
+
+/* the member list after the descriptors of an array, past its pointer layout */
+static const unsigned char *array_elements(const unsigned char *f, const unsigned char **layout)
+{
+    *layout = NULL;
+    if (*f == FC_PP)
+    {
+        *layout = f;
+        f = skip_pointer_layout(f);
+    }
+    return f;
+}
+
+/* the size on the wire of one element of a simple member list */
+static SIZE_T element_size(struct conv *c, const unsigned char *elem, unsigned char *at)
+{
+    BOOL dry = c->dry;
+    SIZE_T n;
+
+    c->dry = TRUE;
+    n = conv_simple_members(c, elem, at);
+    c->dry = dry;
+    return n;
+}
+
+/* count elements of a simple member list, each esize bytes, from where the buffer is */
+static void conv_elements(struct conv *c, const unsigned char *elem, SIZE_T count, SIZE_T esize)
+{
+    unsigned char *start = c->buf;
+    SIZE_T i;
+
+    if (esize && count > (SIZE_T)(c->end - c->buf) / esize) bad_data();
+    if (!c->dry && esize)
+    {
+        if (is_base_type(elem[0]) && (elem[1] == FC_END || (elem[1] == FC_PAD && elem[2] == FC_END)))
+        {
+            conv_values(c, elem[0], count);
+            return;
+        }
+        for (i = 0; i < count; i++) conv_simple_members(c, elem, start + i * esize);
+    }
+    c->buf = start + count * esize;
+}
+
+/* the conformance of an array or string, read first; a structure with an array as last member
+ * has it before the structure */
+static void array_conformance(struct conv *c, const unsigned char *arr)
+{
+    const unsigned char *f;
+
+    switch (arr[0])
+    {
+    case FC_CARRAY:
+    case FC_CVARRAY:
+        read_conformance(c);
+        break;
+    case FC_C_CSTRING:
+    case FC_C_WSTRING:
+        read_conformance(c);
+        break;
+    case FC_BOGUS_ARRAY:
+        f = arr + 4;
+        if (has_corr(f)) read_conformance(c);
+        else c->max_count = *(const WORD *)(arr + 2);
+        break;
+    default:
+        bad_data();
+    }
+}
+
+/* the variance and the data of an array or string, after its conformance has been read;
+ * returns the number of bytes of data */
+static void array_data(struct conv *c, const unsigned char *arr)
+{
+    const unsigned char *f, *layout, *elem;
+    SIZE_T esize, count;
+    unsigned char *mark;
+    unsigned int align_to = arr[1] + 1;
+
+    switch (arr[0])
+    {
+    case FC_CARRAY:
+        esize = *(const WORD *)(arr + 2);
+        elem = array_elements(skip_corr(c, arr + 4), &layout);
+        align(c, align_to);
+        mark = c->buf;
+        count = mul(esize, c->max_count);
+        need(c, count);
+        conv_elements(c, elem, c->max_count, esize);
+        if (layout) conv_pointer_layout(c, layout, mark);
+        break;
+    case FC_CVARRAY:
+        esize = *(const WORD *)(arr + 2);
+        f = skip_corr(c, arr + 4);
+        if (has_corr(f)) read_variance(c);
+        else
+        {
+            c->offset = 0;
+            c->actual_count = c->max_count;
+        }
+        f = skip_corr(c, f);
+        elem = array_elements(f, &layout);
+        if (c->actual_count > c->max_count || c->actual_count + c->offset > c->max_count)
+            RpcRaiseException(RPC_S_INVALID_BOUND);
+        align(c, align_to);
+        mark = c->buf;
+        need(c, mul(esize, c->actual_count));
+        conv_elements(c, elem, c->actual_count, esize);
+        if (layout) conv_pointer_layout(c, layout, mark);
+        break;
+    case FC_C_CSTRING:
+    case FC_C_WSTRING:
+        read_variance(c);
+        esize = arr[0] == FC_C_CSTRING ? 1 : 2;
+        need(c, mul(esize, c->actual_count));
+#ifdef SG_MUTANT_CONVERT_WSTR
+        if (arr[0] == FC_C_WSTRING) { c->buf += esize * c->actual_count; break; }
+#endif
+        conv_values(c, arr[0] == FC_C_CSTRING ? FC_CHAR : FC_WCHAR, c->actual_count);
+        break;
+    case FC_BOGUS_ARRAY:
+    {
+        SIZE_T i;
+        f = skip_corr(c, arr + 4);
+        if (has_corr(f)) read_variance(c);
+        else
+        {
+            c->offset = 0;
+            c->actual_count = c->max_count;
+        }
+        f = skip_corr(c, f);
+        align(c, align_to);
+        count = c->actual_count;
+        for (i = 0; i < count; i++) conv_complex_members(c, f, NULL);
+        break;
+    }
+    default:
+        bad_data();
+    }
+}
+
+/* ---- unions -------------------------------------------------------------------------------- */
+
+static ULONG read_discriminant(struct conv *c, unsigned char fc)
+{
+    unsigned char *p;
+    ULONG v;
+
+    switch (fc)
+    {
+    case FC_BYTE: case FC_CHAR: case FC_SMALL: case FC_USMALL:
+        need(c, 1);
+        cvchar(c, c->buf);
+        v = *c->buf;
+        c->buf += 1;
+        return v;
+    case FC_WCHAR: case FC_SHORT: case FC_USHORT: case FC_ENUM16:
+    {
+        USHORT s;
+        align(c, 2);
+        need(c, 2);
+        p = c->buf;
+        cv16(c, p);
+        memcpy(&s, p, 2);
+        c->buf += 2;
+        return s;
+    }
+    case FC_LONG: case FC_ULONG: case FC_ENUM32:
+#ifdef SG_MUTANT_CONVERT_DISC
+    {
+        ULONG v;
+        align(c, 4);
+        memcpy(&v, c->buf, 4);
+        c->buf += 4;
+        return v;
+    }
+#endif
+        return read_ulong(c);
+    default:
+        bad_data();
+    }
+}
+
+/* f points at the memory size of the union description, which the arms follow */
+static void conv_union_arm(struct conv *c, ULONG disc, const unsigned char *f)
+{
+    unsigned short num_arms, arm, type;
+
+    f += 2; /* the memory size */
+    num_arms = *(const SHORT *)f & 0x0fff;
+    f += 2;
+    for (arm = 0; arm < num_arms; arm++)
+    {
+        if (disc == *(const ULONG *)f)
+        {
+            f += 4;
+            break;
+        }
+        f += 6;
+    }
+    type = *(const unsigned short *)f;
+    if (arm == num_arms)
+    {
+        if (type == 0xffff) RpcRaiseException(RPC_S_INVALID_TAG);
+        if (type == 0) return;
+    }
+    if ((type & 0xff00) == 0x8000)
+        conv_base(c, LOBYTE(type));
+    else
+    {
+        const unsigned char *desc = f + *(const SHORT *)f;
+
+        switch (*desc)
+        {
+        case FC_RP: case FC_UP: case FC_OP: case FC_FP:
+            align(c, 4);
+            conv_member_pointer(c, desc);
+            break;
+        default:
+            conv_type(c, desc);
+        }
+    }
+}
+
+/* ---- types --------------------------------------------------------------------------------- */
+
+static void conv_pointer(struct conv *c, const unsigned char *f)
+{
+    ULONG id = 0;
+
+    if (f[0] != FC_RP) id = read_ulong(c);
+    conv_referent(c, f, id);
+}
+
+static void conv_simple_struct(struct conv *c, const unsigned char *f)
+{
+    SIZE_T size = *(const WORD *)(f + 2);
+    const unsigned char *members = f + 4;
+    unsigned char *start;
+    BOOL owner;
+    unsigned int base;
+
+    align(c, f[1] + 1);
+    start = c->buf;
+    need(c, size);
+    base = construct_begin(c, &owner);
+    if (f[0] == FC_PSTRUCT)
+    {
+        const unsigned char *layout = members;
+        members = skip_pointer_layout(layout);
+        conv_simple_members(c, members, start);
+        c->buf = start + size;
+        conv_pointer_layout(c, layout, start);
+    }
+    else
+    {
+        conv_simple_members(c, members, start);
+        c->buf = start + size;
+    }
+    construct_end(c, owner, base);
+}
+
+static void conv_conformant_struct(struct conv *c, const unsigned char *f)
+{
+    SIZE_T size = *(const WORD *)(f + 2), esize, total;
+    const unsigned char *arr = f + 4 + *(const SHORT *)(f + 4), *members = f + 6, *elem, *layout, *alayout;
+    unsigned char *start;
+    BOOL owner;
+    unsigned int base;
+
+    if (arr[0] != FC_CARRAY) bad_data();
+    esize = *(const WORD *)(arr + 2);
+    read_conformance(c);
+    align(c, f[1] + 1);
+    start = c->buf;
+    total = size + mul(esize, c->max_count);
+    if (total < size) bad_data();
+    need(c, total);
+    base = construct_begin(c, &owner);
+    layout = NULL;
+    if (f[0] == FC_CPSTRUCT)
+    {
+        layout = members;
+        members = skip_pointer_layout(layout);
+    }
+    conv_simple_members(c, members, start);
+    elem = array_elements(skip_corr(c, arr + 4), &alayout);
+    c->buf = start + size;
+    conv_elements(c, elem, c->max_count, esize);
+    c->buf = start + total;
+    if (layout) conv_pointer_layout(c, layout, start);
+    construct_end(c, owner, base);
+}
+
+static void conv_conformant_varying_struct(struct conv *c, const unsigned char *f)
+{
+    SIZE_T size = *(const WORD *)(f + 2);
+    const unsigned char *arr = f + 4 + *(const SHORT *)(f + 4), *members = f + 6, *layout = NULL;
+    unsigned char *start;
+    BOOL owner;
+    unsigned int base;
+
+    array_conformance(c, arr);
+    align(c, f[1] + 1);
+    start = c->buf;
+    need(c, size);
+    base = construct_begin(c, &owner);
+    if (*members == FC_PP)
+    {
+        layout = members;
+        members = skip_pointer_layout(layout);
+    }
+    conv_simple_members(c, members, start);
+    c->buf = start + size;
+    array_data(c, arr);
+    if (layout) conv_pointer_layout(c, layout, start);
+    construct_end(c, owner, base);
+}
+
+static void conv_complex_struct(struct conv *c, const unsigned char *f)
+{
+    const unsigned char *arr = NULL, *ptrs = NULL, *members = f + 8;
+    BOOL owner;
+    unsigned int base;
+
+    align(c, f[1] + 1);
+    if (*(const SHORT *)(f + 4)) arr = f + 4 + *(const SHORT *)(f + 4);
+    if (*(const WORD *)(f + 6)) ptrs = f + 6 + *(const WORD *)(f + 6);
+    base = construct_begin(c, &owner);
+    if (arr)
+    {
+        SIZE_T max;
+
+        array_conformance(c, arr);
+        max = c->max_count;
+        conv_complex_members(c, members, ptrs);
+        c->max_count = max;
+        array_data(c, arr);
+    }
+    else conv_complex_members(c, members, ptrs);
+    construct_end(c, owner, base);
+}
+
+static void conv_fixed_array(struct conv *c, const unsigned char *f)
+{
+    const unsigned char *elem, *layout;
+    SIZE_T total, esize, count;
+    unsigned char *start;
+    BOOL owner;
+    unsigned int base;
+
+    if (f[0] == FC_SMFARRAY)
+    {
+        total = *(const WORD *)(f + 2);
+        elem = f + 4;
+    }
+    else
+    {
+        total = *(const DWORD *)(f + 2);
+        elem = f + 6;
+    }
+    align(c, f[1] + 1);
+    start = c->buf;
+    need(c, total);
+    elem = array_elements(elem, &layout);
+    base = construct_begin(c, &owner);
+    esize = element_size(c, elem, start);
+    count = esize ? total / esize : 0;
+    conv_elements(c, elem, count, esize);
+    c->buf = start + total;
+    if (layout) conv_pointer_layout(c, layout, start);
+    construct_end(c, owner, base);
+}
+
+static void conv_varying_array(struct conv *c, const unsigned char *f)
+{
+    const unsigned char *elem, *layout, *g;
+    SIZE_T total, elements, esize;
+    unsigned char *mark;
+    BOOL owner;
+    unsigned int base;
+
+    if (f[0] == FC_SMVARRAY)
+    {
+        total = *(const WORD *)(f + 2);
+        elements = *(const WORD *)(f + 4);
+        esize = *(const WORD *)(f + 6);
+        g = f + 8;
+    }
+    else
+    {
+        total = *(const DWORD *)(f + 2);
+        elements = *(const DWORD *)(f + 6);
+        esize = *(const WORD *)(f + 10);
+        g = f + 12;
+    }
+    (void)total;
+    c->max_count = elements;
+    if (has_corr(g)) read_variance(c);
+    else
+    {
+        c->offset = 0;
+        c->actual_count = elements;
+    }
+    g = skip_corr(c, g);
+    elem = array_elements(g, &layout);
+    if (c->actual_count > elements || c->actual_count + c->offset > elements)
+        RpcRaiseException(RPC_S_INVALID_BOUND);
+    align(c, f[1] + 1);
+    mark = c->buf;
+    base = construct_begin(c, &owner);
+    need(c, mul(esize, c->actual_count));
+    conv_elements(c, elem, c->actual_count, esize);
+    if (layout) conv_pointer_layout(c, layout, mark);
+    construct_end(c, owner, base);
+}
+
+static void conv_nonconformant_string(struct conv *c, const unsigned char *f)
+{
+    SIZE_T esize = f[0] == FC_CSTRING ? 1 : 2;
+
+    read_variance(c);
+    need(c, mul(esize, c->actual_count));
+    conv_values(c, f[0] == FC_CSTRING ? FC_CHAR : FC_WCHAR, c->actual_count);
+}
+
+static void conv_type(struct conv *c, const unsigned char *f)
+{
+    BOOL owner;
+    unsigned int base;
+
+    if (++c->depth > MAX_DEPTH) bad_data();
+
+    switch (f[0])
+    {
+    case FC_BYTE: case FC_CHAR: case FC_SMALL: case FC_USMALL: case FC_WCHAR: case FC_SHORT:
+    case FC_USHORT: case FC_LONG: case FC_ULONG: case FC_FLOAT: case FC_HYPER: case FC_DOUBLE:
+    case FC_ENUM16: case FC_ENUM32: case FC_IGNORE: case FC_ERROR_STATUS_T: case FC_INT3264:
+    case FC_UINT3264:
+        conv_base(c, f[0]);
+        break;
+    case FC_RP: case FC_UP: case FC_OP: case FC_FP:
+        conv_pointer(c, f);
+        break;
+    case FC_STRUCT: case FC_PSTRUCT:
+        conv_simple_struct(c, f);
+        break;
+    case FC_CSTRUCT: case FC_CPSTRUCT:
+        conv_conformant_struct(c, f);
+        break;
+    case FC_CVSTRUCT:
+        conv_conformant_varying_struct(c, f);
+        break;
+    case FC_BOGUS_STRUCT:
+        conv_complex_struct(c, f);
+        break;
+    case FC_CARRAY: case FC_CVARRAY: case FC_C_CSTRING: case FC_C_WSTRING:
+        base = construct_begin(c, &owner);
+        array_conformance(c, f);
+        array_data(c, f);
+        construct_end(c, owner, base);
+        break;
+    case FC_BOGUS_ARRAY:
+        base = construct_begin(c, &owner);
+        array_conformance(c, f);
+        array_data(c, f);
+        construct_end(c, owner, base);
+        break;
+    case FC_SMFARRAY: case FC_LGFARRAY:
+        conv_fixed_array(c, f);
+        break;
+    case FC_SMVARRAY: case FC_LGVARRAY:
+        conv_varying_array(c, f);
+        break;
+    case FC_CSTRING: case FC_WSTRING:
+        conv_nonconformant_string(c, f);
+        break;
+    case FC_ENCAPSULATED_UNION:
+    {
+        unsigned char switch_type = f[1] & 0xf, incr = (f[1] & 0xf0) >> 4;
+        ULONG disc;
+
+        base = construct_begin(c, &owner);
+        align(c, incr);
+        disc = read_discriminant(c, switch_type);
+        conv_union_arm(c, disc, f + 2);
+        construct_end(c, owner, base);
+        break;
+    }
+    case FC_NON_ENCAPSULATED_UNION:
+    {
+        ULONG disc;
+        const unsigned char *g = skip_corr(c, f + 2);
+
+        base = construct_begin(c, &owner);
+        disc = read_discriminant(c, f[1]);
+        conv_union_arm(c, disc, g + *(const SHORT *)g);
+        construct_end(c, owner, base);
+        break;
+    }
+    case FC_IP:
+    {
+        ULONG size = read_ulong(c);     /* then that many bytes of marshalled interface */
+        need(c, size);
+        c->buf += size;
+        break;
+    }
+    case FC_BIND_CONTEXT:
+        align(c, 4);
+        need(c, 20);
+        cv32(c, c->buf);        /* attributes */
+#ifdef SG_MUTANT_CONVERT_CTX
+    c->buf += 20; break;
+#endif
+        cv32(c, c->buf + 4);    /* GUID: Data1, Data2, Data3 */
+        cv16(c, c->buf + 8);
+        cv16(c, c->buf + 10);
+        c->buf += 20;
+        break;
+    case FC_RANGE:
+        conv_base(c, f[1] & 0xf);
+        break;
+    case FC_TRANSMIT_AS: case FC_REPRESENT_AS:
+        conv_type(c, f + 8 + *(const SHORT *)(f + 8));
+        break;
+    case FC_USER_MARSHAL:
+        /* the user's routines own the wire image; it can be converted only when its type is described */
+        if (!*(const WORD *)(f + 6)) bad_data();
+        align(c, (f[1] & 0xf) + 1);
+        conv_type(c, f + 8 + *(const SHORT *)(f + 8));
+        break;
+    default:
+        FIXME("type 0x%02x not supported\n", f[0]);
+        bad_data();
+    }
+    c->depth--;
+}
+
+/* ---- entry points -------------------------------------------------------------------------- */
+
+static void conv_init(struct conv *c, PMIDL_STUB_MESSAGE msg)
+{
+    ULONG drep = msg->RpcMsg->DataRepresentation;
+
+    memset(c, 0, sizeof(*c));
+    c->buf = msg->Buffer;
+    c->end = msg->BufferEnd;
+    if (!c->end || c->end < c->buf)     /* a message the caller did not complete */
+        c->end = (unsigned char *)msg->RpcMsg->Buffer + msg->RpcMsg->BufferLength;
+    c->big = !(drep & NDR_LITTLE_ENDIAN);
+    c->ebcdic = (drep & NDR_CHAR_REP_MASK) == NDR_EBCDIC_CHAR;
+    c->float_fmt = drep & NDR_FLOAT_REP_MASK;
+    if (c->float_fmt != NDR_IEEE_FLOAT && c->float_fmt != NDR_VAX_FLOAT && c->float_fmt != NDR_IBM_FLOAT
+        && c->float_fmt != 0x200)
+    {
+        WARN("unknown floating point format %#x\n", c->float_fmt);
+        RpcRaiseException(RPC_X_BAD_STUB_DATA);
+    }
+    c->corr_incr = msg->CorrDespIncrement;
+    c->is_client = msg->IsClient;
+}
+
+static void CALLBACK conv_free(BOOL normal, void *arg)
+{
+    struct conv *c = arg;
+    free(c->def);
+    free(c->seen);
+}
+
+/* the chunks of a pipe: the number of elements, aligned to 4, and the elements, each of the pipe's
+ * element type; a chunk of no elements ends the pipe (see ndr_pipe.c) */
+static void conv_pipe(struct conv *c, const unsigned char *pipe_format)
+{
+    const unsigned char *elem = pipe_format + 2 + *(const SHORT *)(pipe_format + 2);
+
+    for (;;)
+    {
+        ULONG count = read_ulong(c), i;
+
+        if (!count) break;
+        for (i = 0; i < count; i++) conv_type(c, elem);
+    }
+}
+
+static void conv_params(struct conv *c, PMIDL_STUB_MESSAGE msg, const NDR_PARAM_OIF *params, unsigned int n)
+{
+    unsigned int i;
+    BOOL pipes_first = c->is_client;   /* the [out] pipes of a response come before the other parameters */
+    int pass;
+
+    for (pass = 0; pass < 2; pass++)
+    {
+        BOOL pipe_pass = pipes_first ? pass == 0 : pass == 1;
+
+        for (i = 0; i < n; i++)
+        {
+            PARAM_ATTRIBUTES attr = params[i].attr;
+
+            if (!!attr.IsPipe != pipe_pass) continue;
+            /* the client receives the [out] parameters and the return value, the server the [in] ones */
+#ifdef SG_MUTANT_CONVERT_DIRECTION
+            if (!attr.IsIn) continue;
+#else
+            if (c->is_client ? !attr.IsOut : !attr.IsIn) continue;
+#endif
+#ifdef SG_MUTANT_CONVERT_NOPIPE
+            if (attr.IsPipe) continue;
+#endif
+            if (attr.IsPipe) conv_pipe(c, &msg->StubDesc->pFormatTypes[params[i].u.type_offset]);
+            else if (attr.IsBasetype) conv_base(c, params[i].u.type_format_char);
+            else conv_type(c, &msg->StubDesc->pFormatTypes[params[i].u.type_offset]);
+        }
+    }
+}
+
+/***********************************************************************
+ *           NdrConvert2 [RPCRT4.@]
+ *
+ * Converts the data of a call to the local data representation: pFormat is the
+ * parameter list of an interpreted procedure with NumberParams parameters.
+ */
+void WINAPI NdrConvert2( PMIDL_STUB_MESSAGE pStubMsg, PFORMAT_STRING pFormat, LONG NumberParams )
+{
+    struct conv c;
+
+    TRACE("(%p, %p, %ld)\n", pStubMsg, pFormat, NumberParams);
+
+    if (!pStubMsg->RpcMsg || !pStubMsg->Buffer) return;
+    if (pStubMsg->RpcMsg->DataRepresentation == NDR_LOCAL_DATA_REPRESENTATION) return;
+
+    conv_init(&c, pStubMsg);
+    __TRY
+    {
+        conv_params(&c, pStubMsg, (const NDR_PARAM_OIF *)pFormat, NumberParams);
+    }
+    __FINALLY_CTX(conv_free, &c)
+}
+
+/***********************************************************************
+ *           NdrConvert [RPCRT4.@]
+ *
+ * Like NdrConvert2 for a procedure of the original interpreter format: pFormat is its list of
+ * parameter descriptions, ending with FC_END.
+ */
+void WINAPI NdrConvert( PMIDL_STUB_MESSAGE pStubMsg, PFORMAT_STRING pFormat )
+{
+    NDR_PARAM_OIF params[256];
+    unsigned int n = 0;
+    PFORMAT_STRING f = pFormat;
+
+    TRACE("(%p, %p)\n", pStubMsg, pFormat);
+
+    while (*f != FC_END)
+    {
+        const NDR_PARAM_OI_BASETYPE *base = (const NDR_PARAM_OI_BASETYPE *)f;
+        const NDR_PARAM_OI_OTHER *other = (const NDR_PARAM_OI_OTHER *)f;
+
+        if (n == ARRAY_SIZE(params)) RpcRaiseException(RPC_S_INTERNAL_ERROR);
+        memset(&params[n], 0, sizeof(params[n]));
+        switch (*f)
+        {
+        case FC_IN_PARAM_BASETYPE:
+            params[n].attr.IsIn = 1;
+            params[n].attr.IsBasetype = 1;
+            break;
+        case FC_RETURN_PARAM_BASETYPE:
+            params[n].attr.IsOut = 1;
+            params[n].attr.IsReturn = 1;
+            params[n].attr.IsBasetype = 1;
+            break;
+        case FC_IN_PARAM: case FC_IN_PARAM_NO_FREE_INST:
+            params[n].attr.IsIn = 1;
+            break;
+        case FC_IN_OUT_PARAM:
+            params[n].attr.IsIn = 1;
+            params[n].attr.IsOut = 1;
+            break;
+        case FC_OUT_PARAM:
+            params[n].attr.IsOut = 1;
+            break;
+        case FC_RETURN_PARAM:
+            params[n].attr.IsOut = 1;
+            params[n].attr.IsReturn = 1;
+            break;
+        default:
+            RpcRaiseException(RPC_X_BAD_STUB_DATA);
+        }
+        if (params[n].attr.IsBasetype)
+        {
+            params[n].u.type_format_char = base->type_format_char;
+            f += sizeof(NDR_PARAM_OI_BASETYPE);
+        }
+        else
+        {
+            params[n].u.type_offset = other->type_offset;
+            f += sizeof(NDR_PARAM_OI_OTHER);
+        }
+        n++;
+    }
+    NdrConvert2(pStubMsg, (PFORMAT_STRING)params, n);
+}
