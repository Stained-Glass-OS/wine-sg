+/* The header fields of a packet are in the byte order its data representation names (the
+ * high nibble of the first byte of the label).  Requests, responses and faults of a peer with the
+ * other byte order are put into the local one when they are received, and out of it when we send
+ * them in such a representation: a server answering with data it has not converted. */
+static inline BOOL packet_has_foreign_header(const RpcPktCommonHdr *hdr)
+{
+    return !(hdr->drep[0] & 0x10) &&
+           (hdr->ptype == PKT_REQUEST || hdr->ptype == PKT_RESPONSE || hdr->ptype == PKT_FAULT);
+}
+
+static inline void swap_ushort(unsigned short *v) { *v = (*v >> 8) | (*v << 8); }
+static inline void swap_uint(unsigned int *v)
+{
+    *v = ((*v & 0xff) << 24) | ((*v & 0xff00) << 8) | ((*v >> 8) & 0xff00) | (*v >> 24);
+}
+
+/* the fields all the packet types share; it is an involution */
+static void swap_common_header(RpcPktCommonHdr *hdr)
+{
+    swap_ushort(&hdr->frag_len);
+    swap_ushort(&hdr->auth_len);
+    swap_uint(&hdr->call_id);
+}
+
+/* the fields of the type specific part of the header, including the object UUID */
+static void swap_header_body(RpcPktHdr *hdr)
+{
+    UUID *object = NULL;
+
+    switch (hdr->common.ptype)
+    {
+    case PKT_REQUEST:
+        swap_uint(&hdr->request.alloc_hint);
+        swap_ushort(&hdr->request.context_id);
+        swap_ushort(&hdr->request.opnum);
+        if (hdr->common.flags & RPC_FLG_OBJECT_UUID) object = (UUID *)(&hdr->request + 1);
+        break;
+    case PKT_RESPONSE:
+        swap_uint(&hdr->response.alloc_hint);
+        swap_ushort(&hdr->response.context_id);
+        break;
+    case PKT_FAULT:
+        swap_uint(&hdr->fault.alloc_hint);
+        swap_ushort(&hdr->fault.context_id);
+        swap_uint(&hdr->fault.status);
+        break;
+    }
+    if (object)
+    {
+        unsigned int d1;
+        memcpy(&d1, &object->Data1, sizeof(d1));
+        swap_uint(&d1);
+        memcpy(&object->Data1, &d1, sizeof(d1));
+        swap_ushort(&object->Data2);
+        swap_ushort(&object->Data3);
+    }
+}
