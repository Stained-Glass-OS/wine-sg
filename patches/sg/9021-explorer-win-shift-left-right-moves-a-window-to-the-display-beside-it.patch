-/* put HWND on SIDE of its work area (a half or a quarter), remembering where
- * it was the first time */
-static void snap_to( HWND hwnd, struct snap *s, int side )
+/* put HWND on SIDE of WORK (a half or a quarter), remembering where it was
+ * the first time */
+static void snap_on( HWND hwnd, struct snap *s, int side, const RECT *work )
 {
-    RECT work, rc;
+    RECT rc;
     if (!s->side)
     {
