     s->side = side;
     mark_snapped( hwnd, &s->restore );
 }
 
+/* on SIDE of its own display's work area */
+static void snap_to( HWND hwnd, struct snap *s, int side )
+{
+    RECT work;
+    work_area( hwnd, &work );
+    snap_on( hwnd, s, side, &work );
+}
+
+/* ---- the displays beside each other (GitHub #18) ------------------------- */
+
+struct mon_pick { HMONITOR from; RECT rc; int dir; HMONITOR next, round; LONG next_d, round_d; };
+
+static BOOL CALLBACK pick_proc( HMONITOR mon, HDC hdc, LPRECT rc, LPARAM lp )
+{
+    struct mon_pick *p = (struct mon_pick *)lp;
+    LONG d = ((rc->left + rc->right) / 2 - (p->rc.left + p->rc.right) / 2) * p->dir;
+
+    if (mon == p->from) return TRUE;
+    if (d > 0 && (!p->next || d < p->next_d)) { p->next = mon; p->next_d = d; }
+    if (d < 0 && (!p->round || -d > p->round_d)) { p->round = mon; p->round_d = -d; }
+    return TRUE;
+}
+
+/* The display beside FROM on side DIR (-1 left, 1 right): the nearest whose
+ * middle is that way; with ROUND, past the last one the farthest the other
+ * way, as Win+Shift+arrow goes round the displays on Windows. */
+static HMONITOR monitor_beside( HMONITOR from, int dir, BOOL round )
+{
+    struct mon_pick p = { from };
+    MONITORINFO mi = { sizeof(mi) };
+
+#ifdef SG_MUTANT_MOVE_NO_NEIGHBOUR
+    return NULL;
+#endif
+    if (!GetMonitorInfoW( from, &mi )) return NULL;
+    p.rc = mi.rcMonitor;
+    p.dir = dir;
+    EnumDisplayMonitors( 0, NULL, pick_proc, (LPARAM)&p );
+    return p.next ? p.next : round ? p.round : NULL;
+}
+
+/* R, a window on work area A, to the same place on work area B: as far
+ * across and down, in proportion, at its size (made smaller only to fit) */
+static void map_rect( const RECT *r, const RECT *a, const RECT *b, RECT *out )
+{
+    int w = min( r->right - r->left, b->right - b->left ), h = min( r->bottom - r->top, b->bottom - b->top );
+    int aw = (a->right - a->left) - (r->right - r->left), ah = (a->bottom - a->top) - (r->bottom - r->top);
+    int bw = (b->right - b->left) - w, bh = (b->bottom - b->top) - h;
+    int dx = r->left - a->left, dy = r->top - a->top;
+
+    if (aw > 0) dx = MulDiv( max( 0, min( dx, aw ) ), bw, aw ); else dx = 0;
+    if (ah > 0) dy = MulDiv( max( 0, min( dy, ah ) ), bh, ah ); else dy = 0;
+    SetRect( out, b->left + dx, b->top + dy, b->left + dx + w, b->top + dy + h );
+}
+
+static BOOL work_of( HMONITOR mon, RECT *work )
+{
+    MONITORINFO mi = { sizeof(mi) };
+    if (!mon || !GetMonitorInfoW( mon, &mi )) return FALSE;
+    *work = mi.rcWork;
+    return TRUE;
+}
+
+/* Win+Shift+Left/Right: the window in front to the display beside it, where
+ * it was on its own, at its size -- maximized stays maximized, snapped stays
+ * snapped -- going round past the last display (Windows' Win+Shift+arrow;
+ * David's reporter, GitHub #18) */
+static void move_to_display( int dir )
+{
+    HWND hwnd = active_app();
+    HMONITOR from, to;
+    RECT a, b, rc;
+    struct snap *s;
+
+    if (!hwnd || IsIconic( hwnd )) return;
+    from = MonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST );
+    if (!(to = monitor_beside( from, dir, TRUE )) || !work_of( from, &a ) || !work_of( to, &b )) return;
+    if ((s = get_snap( hwnd, FALSE )) && s->side)
+    {
+        map_rect( &s->restore, &a, &b, &rc );
+        s->restore = rc;
+        snap_on( hwnd, s, s->side, &b );
+        return;
+    }
+    if (IsZoomed( hwnd ))
+    {
+        /* restored on the other display (where it goes back to), maximized there */
+        ShowWindow( hwnd, SW_RESTORE );
+        GetWindowRect( hwnd, &rc );
+        map_rect( &rc, &a, &b, &rc );
+        SetWindowPos( hwnd, 0, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, SWP_NOZORDER | SWP_NOACTIVATE );
+        ShowWindow( hwnd, SW_MAXIMIZE );
+        return;
+    }
+    GetWindowRect( hwnd, &rc );
+    map_rect( &rc, &a, &b, &rc );
+    SetWindowPos( hwnd, 0, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, SWP_NOZORDER | SWP_NOACTIVATE );
+}
+
 static void snap( int side )
 {
     HWND hwnd = active_app();
@@ -226,7 +327,21 @@
     if (!hwnd || !(GetWindowLongW( hwnd, GWL_STYLE ) & WS_THICKFRAME)) return;  /* not resizable */
     s = get_snap( hwnd, TRUE );
     if (s && s->side == -side) { unsnap( hwnd, s ); return; }  /* back from the other side */
-    if (!s || s->side == side) return;
+    if (!s) return;
+    if (s->side == side)
+    {
+        /* on that half already: to the facing half of the display beside it that way, as
+         * Windows goes on across the displays (GitHub #18); the last one, nothing */
+        HMONITOR from = MonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST ), to;
+        RECT a, b, rc;
+        if ((to = monitor_beside( from, side, FALSE )) && work_of( from, &a ) && work_of( to, &b ))
+        {
+            map_rect( &s->restore, &a, &b, &rc );
+            s->restore = rc;
+            snap_on( hwnd, s, -side, &b );
+        }
+        return;
+    }
     /* from a quarter too: where it was before the first snap stays remembered */
     snap_to( hwnd, s, side );
 }
