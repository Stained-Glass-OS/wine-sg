From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] qdvd, xaudio2_7, evr: class factory LockServer

The class factories' LockServer returned S_OK already: it logged a FIXME
for the right answer (the factories are static and the objects they make
are counted by themselves). No FIXME now.

---
diff --git a/dlls/evr/main.c b/dlls/evr/main.c
index 5c2049a..25c27c7 100644
--- a/dlls/evr/main.c
+++ b/dlls/evr/main.c
@@ -130,8 +130,12 @@ static HRESULT WINAPI classfactory_CreateInstance(IClassFactory *iface, IUnknown
 
 static HRESULT WINAPI classfactory_LockServer(IClassFactory *iface, BOOL dolock)
 {
+    TRACE("%p, %d.\n", iface, dolock);
+#ifdef SG_MUTANT_LOCKSERVER_FIXME
     FIXME("%p, %d stub!\n", iface, dolock);
+#endif
 
+    /* the factories are static: there is nothing to keep loaded */
     return S_OK;
 }
 
diff --git a/dlls/qdvd/qdvd_main.c b/dlls/qdvd/qdvd_main.c
index 608a664..4816d60 100644
--- a/dlls/qdvd/qdvd_main.c
+++ b/dlls/qdvd/qdvd_main.c
@@ -84,7 +84,8 @@ static HRESULT WINAPI class_factory_CreateInstance(IClassFactory *iface,
 
 static HRESULT WINAPI class_factory_LockServer(IClassFactory *iface, BOOL lock)
 {
-    FIXME("lock %d, stub!\n", lock);
+    TRACE("lock %d.\n", lock);
+    /* the factories are static: there is nothing to keep loaded */
     return S_OK;
 }
 
diff --git a/dlls/xaudio2_7/xapo.c b/dlls/xaudio2_7/xapo.c
index 9a58108..db73cf2 100644
--- a/dlls/xaudio2_7/xapo.c
+++ b/dlls/xaudio2_7/xapo.c
@@ -408,7 +408,8 @@ static HRESULT WINAPI xapocf_CreateInstance(IClassFactory *iface, IUnknown *pOut
 static HRESULT WINAPI xapocf_LockServer(IClassFactory *iface, BOOL dolock)
 {
     struct xapo_cf *This = xapo_impl_from_IClassFactory(iface);
-    FIXME("(%p)->(%d): stub!\n", This, dolock);
+    TRACE("(%p)->(%d)\n", This, dolock);
+    /* the factory is made for the call and the objects it creates are counted by themselves */
     return S_OK;
 }
 
diff --git a/dlls/xaudio2_7/xaudio_dll.c b/dlls/xaudio2_7/xaudio_dll.c
index 4353758..cbb8225 100644
--- a/dlls/xaudio2_7/xaudio_dll.c
+++ b/dlls/xaudio2_7/xaudio_dll.c
@@ -1934,7 +1934,8 @@ static HRESULT WINAPI XAudio2CF_CreateInstance(IClassFactory *iface, IUnknown *p
 static HRESULT WINAPI XAudio2CF_LockServer(IClassFactory *iface, BOOL dolock)
 {
     struct xaudio2_cf *This = impl_from_IClassFactory(iface);
-    FIXME("(%p)->(%d): stub!\n", This, dolock);
+    TRACE("(%p)->(%d)\n", This, dolock);
+    /* the factory is made for the call and the objects it creates are counted by themselves */
     return S_OK;
 }
 
