+static void sbuf_add_number( struct sbuf *sb, DOUBLE v )
+{
+    WCHAR text[40];
+    int prec;
+
+    if (v == floor( v ) && fabs( v ) < 1e15)
+    {
+        if (v == 0 && signbit( v )) wcscpy( text, L"-0" );
+        else swprintf( text, ARRAY_SIZE(text), L"%.0f", v );
+    }
+    else
+    {
+        /* the shortest text that reads back as the same number */
+        for (prec = 1; prec <= 17; prec++)
+        {
+            swprintf( text, ARRAY_SIZE(text), L"%.*g", prec, v );
+            if (wcstod( text, NULL ) == v) break;
+        }
+    }
+    {
+        /* an exponent has at least two digits, no more */
+        WCHAR *e = wcschr( text, 'e' );
+        if (e)
+        {
+            WCHAR *digits = e + 2;
+            while (digits[0] == '0' && digits[1] && digits[2]) memmove( digits, digits + 1, (wcslen( digits ) + 1) * sizeof(WCHAR) );
+        }
     }
+    sbuf_add_str( sb, text );
