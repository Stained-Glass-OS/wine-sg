+
+static HRESULT json_add_item( struct json_value *array, IJsonValue *item )
+{
+    if (array->count == array->capacity)
+    {
+        ULONG cap = array->capacity ? array->capacity * 2 : 4;
+        IJsonValue **items = realloc( array->items, cap * sizeof(*items) );
+        if (!items) return E_OUTOFMEMORY;
+        array->items = items;
+        array->capacity = cap;
+    }
+    IJsonValue_AddRef( item );
+    array->items[array->count++] = item;
+    return S_OK;
+}
+
+/* the index of name among the sorted members, or where it would go */
+static ULONG json_member_find( struct json_value *object, const WCHAR *name, BOOL *found )
+{
+    ULONG lo = 0, hi = object->count;
+
+    while (lo < hi)
+    {
+        ULONG mid = (lo + hi) / 2;
+        int cmp = wcscmp( WindowsGetStringRawBuffer( object->members[mid].name, NULL ), name );
+        if (!cmp) { *found = TRUE; return mid; }
+        if (cmp < 0) lo = mid + 1; else hi = mid;
+    }
+    *found = FALSE;
+#ifdef SG_MUTANT_SORT_OFF
+    return object->count;
+#endif
+    return lo;
+}
+
+static HRESULT json_set_member( struct json_value *object, HSTRING name, IJsonValue *value )
+{
+    const WCHAR *text = WindowsGetStringRawBuffer( name, NULL );
+    BOOL found;
+    ULONG pos = json_member_find( object, text, &found );
+    HSTRING copy;
+    HRESULT hr;
+
+    if (found)
+    {
+#ifdef SG_MUTANT_SET_NOREPLACE
+        return S_OK;
+#endif
+        IJsonValue_AddRef( value );
+        IJsonValue_Release( object->members[pos].value );
+        object->members[pos].value = value;
         return S_OK;
     }
+    if (object->count == object->capacity)
+    {
+        ULONG cap = object->capacity ? object->capacity * 2 : 4;
+        struct json_member *members = realloc( object->members, cap * sizeof(*members) );
+        if (!members) return E_OUTOFMEMORY;
+        object->members = members;
+        object->capacity = cap;
+    }
+    if (FAILED(hr = WindowsDuplicateString( name, &copy ))) return hr;
+    memmove( object->members + pos + 1, object->members + pos, (object->count - pos) * sizeof(*object->members) );
+    IJsonValue_AddRef( value );
+    object->members[pos].name = copy;
+    object->members[pos].value = value;
+    object->count++;
+    return S_OK;
+}
 
