From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] setupapi: the device properties derived from the device node

CM_Get_DevNode_PropertyW and SetupDiGetDevicePropertyW only knew properties stored under the device's
Properties key: DEVPKEY_Device_InstanceId, which GTK 4 asks of every input device (Inkscape 1.4 warned
'Failed to get device node property {78C34FC8-...},256: Element not found'), and the DEVPKEY_Device_* forms
of the SPDRP_* registry properties were not found. They now come from the device node: the instance ID, and
the registry property whose SPDRP index is the pid minus 2, typed as a string, string list, UINT32 or (the
class) GUID, with the size asked for when the buffer is too small.
---
diff --git a/dlls/setupapi/devinst.c b/dlls/setupapi/devinst.c
index 64157c6..104e9e8 100644
--- a/dlls/setupapi/devinst.c
+++ b/dlls/setupapi/devinst.c
@@ -6005,9 +6005,81 @@ out:
 static LSTATUS get_key_property(HKEY base, const DEVPROPKEY *prop_key, DEVPROPTYPE *prop_type,
                 BYTE *prop_buff, DWORD prop_buff_size, DWORD *required_size, DWORD flags);
 
+/* hand back a computed property's value the way stored ones are */
+static LSTATUS put_property(DEVPROPTYPE type, const void *data, DWORD size, DEVPROPTYPE *prop_type,
+                BYTE *prop_buff, DWORD prop_buff_size, DWORD *required_size)
+{
+    *prop_type = type;
+    if (required_size) *required_size = size;
+    if (!prop_buff || prop_buff_size < size) return ERROR_INSUFFICIENT_BUFFER;
+    memcpy(prop_buff, data, size);
+    return NO_ERROR;
+}
+
+/* Stained Glass OS: the properties Windows derives from a device node rather
+ * than stores -- its instance ID, and the DEVPKEY_Device_* forms of the
+ * SPDRP_* registry properties (pid = SPDRP + 2). GTK 4 reads the instance ID
+ * of every input device; programs read names and IDs this way. */
+static LSTATUS get_computed_property(struct device *device, const DEVPROPKEY *prop_key, DEVPROPTYPE *prop_type,
+                BYTE *prop_buff, DWORD prop_buff_size, DWORD *required_size)
+{
+    static const GUID device_fmtid = {0xa45c254e,0xdf1c,0x4efd,{0x80,0x20,0x67,0xd1,0x46,0xa8,0x50,0xe0}};
+    static const GUID instance_id_fmtid = {0x78c34fc8,0x104a,0x4aca,{0x9e,0xa4,0x52,0x4d,0x52,0x99,0x6e,0x57}};
+    DWORD prop, type, size = 0;
+    LSTATUS ls;
+    BYTE *data;
+    GUID guid;
+
+#ifndef SG_MUTANT_DEVPROP_NO_INSTANCEID
+    if (IsEqualGUID(&prop_key->fmtid, &instance_id_fmtid) && prop_key->pid == 256)
+#else
+    if (0)
+#endif
+        return put_property(DEVPROP_TYPE_STRING, device->instanceId,
+                            (lstrlenW(device->instanceId) + 1) * sizeof(WCHAR),
+                            prop_type, prop_buff, prop_buff_size, required_size);
+#ifdef SG_MUTANT_DEVPROP_NO_SPDRP
+    return ERROR_NOT_FOUND;
+#endif
+    if (!IsEqualGUID(&prop_key->fmtid, &device_fmtid) || prop_key->pid < 2) return ERROR_NOT_FOUND;
+    prop = prop_key->pid - 2;
+    if (prop >= ARRAY_SIZE(PropertyMap) || !PropertyMap[prop].nameW || prop == SPDRP_BASE_CONTAINERID)
+        return ERROR_NOT_FOUND;
+    if ((ls = RegQueryValueExW(device->key, PropertyMap[prop].nameW, NULL, &type, NULL, &size)))
+        return ls == ERROR_FILE_NOT_FOUND ? ERROR_NOT_FOUND : ls;
+    if (!(data = malloc(size + sizeof(WCHAR) * 2))) return ERROR_OUTOFMEMORY;
+    memset(data, 0, size + sizeof(WCHAR) * 2);
+    if ((ls = RegQueryValueExW(device->key, PropertyMap[prop].nameW, NULL, &type, data, &size)))
+    {
+        free(data);
+        return ls == ERROR_FILE_NOT_FOUND ? ERROR_NOT_FOUND : ls;
+    }
+    if (prop == SPDRP_CLASSGUID && type == REG_SZ && ((WCHAR *)data)[0] == '{' && size >= 39 * sizeof(WCHAR) &&
+        (((WCHAR *)data)[37] = 0, UuidFromStringW((WCHAR *)data + 1, &guid) == RPC_S_OK))
+        ls = put_property(DEVPROP_TYPE_GUID, &guid, sizeof(guid), prop_type, prop_buff, prop_buff_size, required_size);
+    else if (type == REG_SZ || type == REG_EXPAND_SZ)
+        ls = put_property(DEVPROP_TYPE_STRING, data, (lstrlenW((WCHAR *)data) + 1) * sizeof(WCHAR),
+                          prop_type, prop_buff, prop_buff_size, required_size);
+    else if (type == REG_MULTI_SZ)
+        ls = put_property(DEVPROP_TYPE_STRING_LIST, data, size, prop_type, prop_buff, prop_buff_size, required_size);
+    else if (type == REG_DWORD && size == sizeof(DWORD))
+        ls = put_property(DEVPROP_TYPE_UINT32, data, size, prop_type, prop_buff, prop_buff_size, required_size);
+    else
+        ls = put_property(DEVPROP_TYPE_BINARY, data, size, prop_type, prop_buff, prop_buff_size, required_size);
+    free(data);
+    return ls;
+}
+
 static LSTATUS get_device_property(struct device *device, const DEVPROPKEY *prop_key, DEVPROPTYPE *prop_type,
                 BYTE *prop_buff, DWORD prop_buff_size, DWORD *required_size, DWORD flags)
 {
+    LSTATUS ls;
+
+    if (prop_key && prop_type && (prop_buff || !prop_buff_size) && !flags)
+    {
+        ls = get_computed_property(device, prop_key, prop_type, prop_buff, prop_buff_size, required_size);
+        if (ls != ERROR_NOT_FOUND) return ls;
+    }
     return get_key_property(device->key, prop_key, prop_type, prop_buff, prop_buff_size, required_size, flags);
 }
 
