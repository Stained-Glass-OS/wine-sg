+#include <stdarg.h>
+#include <stdlib.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "shellapi.h"
+#include "shlobj.h"
+#include "objbase.h"
+#include "wine/debug.h"
+#include "explorer_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(explorer);
+
+#define RUN_KEY      L"Software\\Microsoft\\Windows\\CurrentVersion\\Run"
+#define RUNONCE_KEY  L"Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce"
+#define APPROVED_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved"
+#define SESSION_KEY  L"Software\\Stained Glass\\Explorer\\Session"
+
+/* turned off in Task Manager's Startup tab: StartupApproved\SUB has the value
+ * with an odd first byte (Windows writes 02 on, 03 off); absent is on. The
+ * machine's entries are approved in HKLM, the person's in HKCU, as sg-shell's
+ * Task Manager keeps them. */
+static BOOL approved( HKEY root, const WCHAR *sub, const WCHAR *name )
+{
+    WCHAR path[MAX_PATH];
+    BYTE b[12];
+    DWORD cb = sizeof(b), type;
+    BOOL on = TRUE;
+    HKEY key;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", APPROVED_KEY, sub );
+    if (RegOpenKeyExW( root, path, 0, KEY_READ, &key )) return TRUE;
+    if (!RegQueryValueExW( key, name, NULL, &type, b, &cb ) && type == REG_BINARY && cb >= 1) on = !(b[0] & 1);
+    RegCloseKey( key );
+    return on;
+}
+
+static BOOL run_command( const WCHAR *cmd )
+{
+    WCHAR expanded[2048];
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+
+    if (!ExpandEnvironmentStringsW( cmd, expanded, ARRAY_SIZE(expanded) )) lstrcpynW( expanded, cmd, ARRAY_SIZE(expanded) );
+    if (!CreateProcessW( NULL, expanded, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ))
+    {
+        WARN( "could not start %s: %lu\n", debugstr_w(expanded), GetLastError() );
+        return FALSE;
+    }
+    TRACE( "started %s\n", debugstr_w(expanded) );
+    CloseHandle( pi.hThread );
+    CloseHandle( pi.hProcess );
+    return TRUE;
+}
+
+/* the values of a Run key, in its order */
+static void run_key( HKEY root, REGSAM view, const WCHAR *approved_sub )
+{
+    WCHAR name[256], data[2048];
+    DWORD i, cname, cdata, type;
+    HKEY key;
+
+    if (RegOpenKeyExW( root, RUN_KEY, 0, KEY_READ | view, &key )) return;
+    for (i = 0; ; i++)
+    {
+        cname = ARRAY_SIZE(name);
+        cdata = sizeof(data) - sizeof(WCHAR);
+        if (RegEnumValueW( key, i, name, &cname, NULL, &type, (BYTE *)data, &cdata )) break;
+        if (type != REG_SZ && type != REG_EXPAND_SZ) continue;
+        data[cdata / sizeof(WCHAR)] = 0;
+        if (!data[0]) continue;
+        if (!approved( root, approved_sub, name ))
+        {
+            TRACE( "%s is turned off\n", debugstr_w(name) );
+            continue;
+        }
+        run_command( data );
+    }
+    RegCloseKey( key );
+}
+
+/* the person's RunOnce: each value removed before it runs ("!name": after) */
+static void run_once(void)
+{
+    WCHAR name[256], data[2048];
+    DWORD cname, cdata, type;
+    HKEY key;
+
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, RUNONCE_KEY, 0, KEY_READ | KEY_SET_VALUE, &key )) return;
+    for (;;)
+    {
+        cname = ARRAY_SIZE(name);
+        cdata = sizeof(data) - sizeof(WCHAR);
+        if (RegEnumValueW( key, 0, name, &cname, NULL, &type, (BYTE *)data, &cdata )) break;
+        data[cdata / sizeof(WCHAR)] = 0;
+        if (name[0] != '!') RegDeleteValueW( key, name );
+        if ((type == REG_SZ || type == REG_EXPAND_SZ) && data[0]) run_command( data );
+        if (name[0] == '!') RegDeleteValueW( key, name );
+    }
+    RegCloseKey( key );
+}
+
+/* every item of a Startup folder (shortcuts, programs, scripts) */
+static void run_folder( int csidl, HKEY approved_root )
+{
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH + 4], path[MAX_PATH * 2];
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+
+    if (SHGetFolderPathW( NULL, csidl, NULL, SHGFP_TYPE_CURRENT, dir )) return;
+    swprintf( pattern, ARRAY_SIZE(pattern), L"%s\\*", dir );
+    if ((find = FindFirstFileW( pattern, &fd )) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (fd.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM)) continue;
+        if (!wcsicmp( fd.cFileName, L"desktop.ini" )) continue;
+        if (!approved( approved_root, L"StartupFolder", fd.cFileName ))
+        {
+            TRACE( "%s is turned off\n", debugstr_w(fd.cFileName) );
+            continue;
+        }
+        swprintf( path, ARRAY_SIZE(path), L"%s\\%s", dir, fd.cFileName );
+        if ((INT_PTR)ShellExecuteW( NULL, NULL, path, NULL, dir, SW_SHOWNORMAL ) <= 32)
+            WARN( "could not open %s\n", debugstr_w(path) );
+        else TRACE( "opened %s\n", debugstr_w(path) );
+    } while (FindNextFileW( find, &fd ));
+    FindClose( find );
+}
+
+/* whether this sign-in has had them already; marks it if not */
+static BOOL first_in_session(void)
+{
+    WCHAR id[64] = L"", seen[64] = L"";
+    DWORD cb = sizeof(seen);
+    HKEY key;
+    BOOL first;
+
+#ifdef SG_MUTANT_STARTUP_EVERY_TIME
+    return TRUE;
+#endif
+    if (!GetEnvironmentVariableW( L"XDG_SESSION_ID", id, ARRAY_SIZE(id) )) lstrcpyW( id, L"-" );
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, SESSION_KEY, 0, NULL, REG_OPTION_VOLATILE, KEY_READ | KEY_SET_VALUE,
+                         NULL, &key, NULL ))
+        return TRUE;
+    first = RegQueryValueExW( key, L"StartupRan", NULL, NULL, (BYTE *)seen, &cb ) || wcscmp( seen, id );
+    if (first) RegSetValueExW( key, L"StartupRan", 0, REG_SZ, (const BYTE *)id, (lstrlenW( id ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    return first;
+}
+
+static DWORD WINAPI startup_thread( void *arg )
+{
+    BOOL wow64 = FALSE;
+
+    /* the desktop and the taskbar first, as Windows starts them after the shell */
+    Sleep( 2000 );
+    CoInitializeEx( NULL, COINIT_APARTMENTTHREADED );
+    run_once();
+    run_key( HKEY_LOCAL_MACHINE, KEY_WOW64_64KEY, L"Run" );
+    if (sizeof(void *) == 8 || (IsWow64Process( GetCurrentProcess(), &wow64 ) && wow64))
+        run_key( HKEY_LOCAL_MACHINE, KEY_WOW64_32KEY, L"Run32" );
+    run_key( HKEY_CURRENT_USER, 0, L"Run" );
+    run_folder( CSIDL_COMMON_STARTUP, HKEY_LOCAL_MACHINE );
+    run_folder( CSIDL_STARTUP, HKEY_CURRENT_USER );
+    CoUninitialize();
+    return 0;
+}
+
+void run_startup_programs(void)
+{
+    HANDLE thread;
+
+#ifdef SG_MUTANT_NO_STARTUP
+    return;
+#endif
+    if (!first_in_session())
+    {
+        TRACE( "this sign-in's startup programs ran already\n" );
+        return;
+    }
+    if ((thread = CreateThread( NULL, 0, startup_thread, NULL, 0, NULL ))) CloseHandle( thread );
+}
