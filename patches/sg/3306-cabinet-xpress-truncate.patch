+      new_data_off += entry;
+    }
+    scan += entry;
+  }
+  new_size = new_data_off + (data_end - old_data_start);
+  if (new_data_off > old_data_start) goto corrupt;   /* the tables overlap the data */
+
+  for (k = 0; k < iFolderToDelete; k++)
+  {
+    cab_UBYTE *dst = out + out_pos;
+    cab_ULONG off;
+
+    memcpy( dst, folders + k * folder_size, folder_size );
+    off = EndGetI32(dst + cffold_DataOffset) - old_data_start + new_data_off;
+    dst[0] = off; dst[1] = off >> 8; dst[2] = off >> 16; dst[3] = off >> 24;
+    out_pos += folder_size;
+  }
+  for (scan = 0, i = 0; i < nfiles; i++)
+  {
+    cab_UWORD folder = EndGetI16(files + scan + cffile_FolderIndex);
+    cab_ULONG entry = cffile_SIZEOF;
+
+    while (files[scan + entry]) entry++;
+    entry++;
+    if (folder == 0xfffd || folder == 0xffff) folder = 0;
+    else if (folder == 0xfffe) folder = nfolders - 1;
+#ifdef SG_MUTANT_TRUNC_FILES
+    folder = 0;
+#endif
+    if (folder < iFolderToDelete)
+    {
+      memcpy( out + out_pos, files + scan, entry );
+      out_pos += entry;
+    }
+    scan += entry;
+  }
+
+  /* the numbers in the header: no link to a next cabinet is left, since the last folder is gone */
+  flags &= ~cfheadNEXT_CABINET;
+#ifdef SG_MUTANT_TRUNC_NEXT
+  flags |= EndGetI16(head + cfhead_Flags) & cfheadNEXT_CABINET;
+#endif
+  out[cfhead_Flags] = flags; out[cfhead_Flags + 1] = flags >> 8;
+  out[cfhead_NumFolders] = iFolderToDelete; out[cfhead_NumFolders + 1] = iFolderToDelete >> 8;
+  out[cfhead_NumFiles] = kept_files; out[cfhead_NumFiles + 1] = kept_files >> 8;
+  i = prefix_len + (cab_ULONG)iFolderToDelete * folder_size;
+  out[cfhead_FileOffset] = i; out[cfhead_FileOffset + 1] = i >> 8;
+  out[cfhead_FileOffset + 2] = i >> 16; out[cfhead_FileOffset + 3] = i >> 24;
+#ifdef SG_MUTANT_TRUNC_SIZE
+  new_size = cab_size;
+#endif
+  out[cfhead_CabinetSize] = new_size; out[cfhead_CabinetSize + 1] = new_size >> 8;
+  out[cfhead_CabinetSize + 2] = new_size >> 16; out[cfhead_CabinetSize + 3] = new_size >> 24;
+
+  /* the new beginning replaces the old one (it is not longer), the data of the folders that stay
+   * moves up to it, and the file ends there */
+  if (fdi->seek( hf, 0, SEEK_SET ) == -1 || fdi->write( hf, out, out_pos ) != out_pos) goto corrupt;
+#ifdef SG_MUTANT_TRUNC_NODATA
+  if (0)
+#else
+  if (new_data_off != old_data_start)
+#endif
+  {
+    copybuf = fdi->alloc( 32768 );
+    if (!copybuf) { set_error( fdi, FDIERROR_ALLOC_FAIL, ERROR_NOT_ENOUGH_MEMORY ); goto done; }
+    for (moved = 0; moved < data_end - old_data_start;)
+    {
+      cab_ULONG n = data_end - old_data_start - moved;
+
+      if (n > 32768) n = 32768;
+      if (fdi->seek( hf, old_data_start + moved, SEEK_SET ) == -1 || (cab_ULONG)fdi->read( hf, copybuf, n ) != n) goto corrupt;
+      if (fdi->seek( hf, new_data_off + moved, SEEK_SET ) == -1 || (cab_ULONG)fdi->write( hf, copybuf, n ) != n) goto corrupt;
+      moved += n;
+    }
+  }
+  /* a write of nothing truncates the file at the position */
+#ifndef SG_MUTANT_TRUNC_NOEND
+  if (fdi->seek( hf, new_size, SEEK_SET ) == -1 || fdi->write( hf, out, 0 ) != 0) goto corrupt;
+#endif
+  ok = TRUE;
+  goto done;
+
+corrupt:
+  set_error( fdi, FDIERROR_CORRUPT_CABINET, 0 );
+done:
+  fdi->close( hf );
+  if (folders) fdi->free( folders );
+  if (files) fdi->free( files );
+  if (out) fdi->free( out );
+  if (prefix) fdi->free( prefix );
+  if (copybuf) fdi->free( copybuf );
+  return ok;
 }
