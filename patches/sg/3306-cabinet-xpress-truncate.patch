  *   8  uncompressed size     64-bit
  *  16  chunk size            64-bit
  *
+ * An XPRESS chunk is the LZ77 stream of [MS-XCA] 2.4 ("plain LZ77") of the
+ * chunk, or the chunk itself when that is not smaller.
+ *
  * An MSZIP chunk is a series of blocks, each "CK" and a raw deflate stream of
  * at most 32 KiB of output, with the previous 32 KiB of the chunk as its
  * dictionary -- as MSZIP folders in cabinets. COMPRESS_RAW omits the header
- * and chunking: the data is the blocks alone. XPRESS, XPRESS_HUFF and LZMS
- * are not implemented yet.
+ * and chunking: the data is the blocks alone (for XPRESS, one LZ77 stream).
+ * XPRESS_HUFF and LZMS are not implemented yet.
  */
 
 #include <stdarg.h>
@@ -104,7 +107,7 @@ static BOOL create_handle( DWORD type, DWORD algorithm, HANDLE *out )
         SetLastError( ERROR_INVALID_PARAMETER );
         return FALSE;
     }
-    if (alg != COMPRESS_ALGORITHM_NULL && alg != COMPRESS_ALGORITHM_MSZIP)
+    if (alg != COMPRESS_ALGORITHM_NULL && alg != COMPRESS_ALGORITHM_MSZIP && alg != COMPRESS_ALGORITHM_XPRESS)
     {
         FIXME( "algorithm %lu is not implemented\n", alg );
         SetLastError( ERROR_NOT_SUPPORTED );
@@ -263,25 +266,325 @@ static BOOL mszip_encode( const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T out_
     return TRUE;
 }
 
+static UINT64 get64( const BYTE *p ) { UINT64 v; memcpy( &v, p, 8 ); return v; }
+static UINT32 get32( const BYTE *p ) { UINT32 v; memcpy( &v, p, 4 ); return v; }
+
+/* ---- XPRESS ([MS-XCA] "plain LZ77") ---------------------------------------- */
+
+/* A stream is groups of up to 32 items: a 32-bit flag word (the first item in
+ * the top bit; 0 a literal byte, 1 a match) and then the items. A match is a
+ * 16-bit value, ((offset - 1) << 3) | (length - 3) for lengths 3 to 9, in which
+ * a length field of 7 says the length goes on in a 4-bit field (shared two to a
+ * byte), then in a byte, then in 16 or 32 bits. The unused flags of the last
+ * word are 1. */
+
+#ifdef SG_MUTANT_XP_WINDOW
+#define XPRESS_WINDOW 16384
+#else
+#define XPRESS_WINDOW 8192
+#endif
+
+static SIZE_T xpress_bound( SIZE_T size )
+{
+    return size + size / 8 + 16;
+}
+
+static BOOL xpress_decode( const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T out_size, SIZE_T *produced )
+{
+    SIZE_T ip = 0, op = 0, nibble = 0;
+    UINT32 flags = 0;
+    int bits = 0;
+
+    while (ip < in_size)
+    {
+        if (!bits)
+        {
+            if (in_size - ip < 4) break;
+            flags = get32( in + ip );
+            ip += 4;
+            bits = 32;
+            if (ip >= in_size) break;
+        }
+        bits--;
+        if (!((flags >> bits) & 1))
+        {
+            if (ip >= in_size || op >= out_size) return FALSE;
+            out[op++] = in[ip++];
+        }
+        else
+        {
+            UINT32 seq, offset;
+            UINT64 length;
+
+            if (in_size - ip < 2) return FALSE;
+            seq = in[ip] | (in[ip + 1] << 8);
+            ip += 2;
+            offset = (seq >> 3) + 1;
+            length = seq & 7;
+            if (length == 7)
+            {
+#ifdef SG_MUTANT_XP_DECNIBBLE
+                nibble = 0;
+#endif
+                if (!nibble)
+                {
+                    /* a byte of two nibbles: this match takes the low one, the next one that needs it the high one */
+                    if (ip >= in_size) return FALSE;
+                    nibble = ip;
+                    length = in[ip] & 15;
+                    ip++;
+                }
+                else
+                {
+                    length = in[nibble] >> 4;
+                    nibble = 0;
+                }
+                if (length == 15)
+                {
+                    if (ip >= in_size) return FALSE;
+                    length = in[ip++];
+                    if (length == 255)
+                    {
+                        if (in_size - ip < 2) return FALSE;
+                        length = in[ip] | (in[ip + 1] << 8);
+                        ip += 2;
+                        if (!length)
+                        {
+                            if (in_size - ip < 4) return FALSE;
+                            length = get32( in + ip );
+                            ip += 4;
+                        }
+                        if (length < 15 + 7) return FALSE;
+                        length -= 15 + 7;
+                    }
+                    length += 15;
+                }
+                length += 7;
+            }
+            length += 3;
+#ifdef SG_MUTANT_XP_DECBOUNDS
+            if (length > out_size - op) return FALSE;
+#else
+            if (offset > op || length > out_size - op) return FALSE;
+#endif
+            while (length--) { out[op] = out[op - offset]; op++; }
+        }
+    }
+    *produced = op;
+    return TRUE;
+}
+
+struct xpress_writer
+{
+    BYTE *out;
+    SIZE_T size, pos;
+    SIZE_T flags_pos;     /* where the flag word of the current group goes */
+    UINT32 flags;
+    int count;            /* items in the group */
+    SIZE_T nibble_pos;    /* the byte holding a first nibble, 0 if none waiting */
+    BOOL failed;
+};
+
+static void xw_put( struct xpress_writer *w, const void *data, SIZE_T len )
+{
+    if (w->pos + len > w->size) { w->failed = TRUE; return; }
+    memcpy( w->out + w->pos, data, len );
+    w->pos += len;
+}
+
+static void xw_item( struct xpress_writer *w, int match )
+{
+    if (!w->count)
+    {
+        /* reserve the flag word */
+        w->flags_pos = w->pos;
+        w->pos += 4;
+        if (w->pos > w->size) { w->failed = TRUE; w->pos = w->size; return; }
+        w->flags = 0;
+    }
+    w->flags = (w->flags << 1) | !!match;
+    if (++w->count == 32)
+    {
+        if (!w->failed) memcpy( w->out + w->flags_pos, &w->flags, 4 );
+        w->count = 0;
+    }
+}
+
+static void xw_finish( struct xpress_writer *w )
+{
+    if (w->count)
+    {
+        /* the unused flags are 1 */
+#ifdef SG_MUTANT_XP_PAD
+        UINT32 flags = (w->flags << (32 - w->count));
+#else
+        UINT32 flags = (w->flags << (32 - w->count)) | ((1u << (32 - w->count)) - 1);
+#endif
+        if (!w->failed) memcpy( w->out + w->flags_pos, &flags, 4 );
+        w->count = 0;
+    }
+}
+
+static BOOL xpress_encode( const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T out_size, SIZE_T *written )
+{
+    struct xpress_writer w = { out, out_size };
+    SIZE_T *head, *prev, pos = 0;
+    const SIZE_T hash_size = 1 << 15;
+
+    head = malloc( hash_size * sizeof(*head) );
+    prev = malloc( (in_size ? in_size : 1) * sizeof(*prev) );
+    if (!head || !prev)
+    {
+        free( head );
+        free( prev );
+        return FALSE;
+    }
+    memset( head, 0xff, hash_size * sizeof(*head) );
+
+    while (pos < in_size)
+    {
+        SIZE_T best_len = 0, best_off = 0;
+
+        if (in_size - pos >= 3)
+        {
+            UINT32 h = ((in[pos] << 10) ^ (in[pos + 1] << 5) ^ in[pos + 2]) & (hash_size - 1);
+            SIZE_T cand = head[h];
+            int depth = 32;
+
+            while (cand != (SIZE_T)-1 && pos - cand <= XPRESS_WINDOW && depth--)
+            {
+                SIZE_T len = 0, max = in_size - pos;
+                while (len < max && in[cand + len] == in[pos + len]) len++;
+                if (len > best_len) { best_len = len; best_off = pos - cand; }
+                if (len == max) break;
+                cand = prev[cand];
+            }
+            prev[pos] = head[h];
+            head[h] = pos;
+        }
+
+        if (best_len >= 3)
+        {
+            SIZE_T l3 = best_len - 3;
+            UINT16 seq = ((best_off - 1) << 3) | (l3 < 7 ? l3 : 7);
+            SIZE_T i;
+
+            xw_item( &w, 1 );
+            xw_put( &w, &seq, 2 );
+            if (l3 >= 7)
+            {
+                SIZE_T rest = l3 - 7;
+                BYTE nib = rest < 15 ? rest : 15;
+
+                /* the 4-bit lengths go two to a byte, the first in the low half */
+#ifdef SG_MUTANT_XP_NIBBLE
+                if (1)
+#else
+                if (!w.nibble_pos)
+#endif
+                {
+                    w.nibble_pos = w.pos + 1;   /* position + 1 so that 0 means none */
+                    xw_put( &w, &nib, 1 );
+                }
+                else
+                {
+                    if (!w.failed) w.out[w.nibble_pos - 1] |= nib << 4;
+                    w.nibble_pos = 0;
+                }
+                if (rest >= 15)
+                {
+                    SIZE_T rest2 = rest - 15;
+                    BYTE b = rest2 < 255 ? rest2 : 255;
+
+                    xw_put( &w, &b, 1 );
+                    if (rest2 >= 255)
+                    {
+#ifdef SG_MUTANT_XP_U32
+                        if (1)
+#else
+                        if (l3 < 65536)
+#endif
+                        {
+                            UINT16 v = l3;
+                            xw_put( &w, &v, 2 );
+                        }
+                        else
+                        {
+                            UINT16 zero = 0;
+                            UINT32 v = l3;
+                            xw_put( &w, &zero, 2 );
+                            xw_put( &w, &v, 4 );
+                        }
+                    }
+                }
+            }
+            /* positions inside the match enter the hash chains too */
+            for (i = 1; i < best_len; i++)
+            {
+                SIZE_T p = pos + i;
+                if (in_size - p >= 3)
+                {
+                    UINT32 h = ((in[p] << 10) ^ (in[p + 1] << 5) ^ in[p + 2]) & (hash_size - 1);
+                    prev[p] = head[h];
+                    head[h] = p;
+                }
+            }
+            pos += best_len;
+        }
+        else
+        {
+            xw_item( &w, 0 );
+            xw_put( &w, in + pos, 1 );
+            pos++;
+        }
+        if (w.failed) break;
+    }
+    xw_finish( &w );
+    free( head );
+    free( prev );
+    if (w.failed) return FALSE;
+    *written = w.pos;
+    return TRUE;
+}
+
 /* ---- a chunk ------------------------------------------------------------ */
 
+static SIZE_T codec_bound( DWORD algorithm, SIZE_T size )
+{
+    if (algorithm == COMPRESS_ALGORITHM_NULL) return size;
+    if (algorithm == COMPRESS_ALGORITHM_XPRESS) return xpress_bound( size );
+    return mszip_bound( size );
+}
+
+static BOOL codec_decode( DWORD algorithm, const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T out_size, SIZE_T *produced )
+{
+    if (algorithm == COMPRESS_ALGORITHM_XPRESS) return xpress_decode( in, in_size, out, out_size, produced );
+    return mszip_decode( in, in_size, out, out_size, produced );
+}
+
+static BOOL codec_encode( DWORD algorithm, const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T out_size, DWORD level,
+                          SIZE_T *written )
+{
+    if (algorithm == COMPRESS_ALGORITHM_XPRESS) return xpress_encode( in, in_size, out, out_size, written );
+    return mszip_encode( in, in_size, out, out_size, level, written );
+}
+
 static BOOL decode_chunk( DWORD algorithm, const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T expect )
 {
     SIZE_T produced;
 
-    if (algorithm == COMPRESS_ALGORITHM_NULL || (in_size == expect && (in_size < 2 || in[0] != 'C' || in[1] != 'K')))
+    if (algorithm == COMPRESS_ALGORITHM_NULL
+            || (algorithm == COMPRESS_ALGORITHM_XPRESS && in_size == expect)
+            || (in_size == expect && (in_size < 2 || in[0] != 'C' || in[1] != 'K')))
     {
         /* stored */
         if (in_size != expect) return FALSE;
         memcpy( out, in, expect );
         return TRUE;
     }
-    return mszip_decode( in, in_size, out, expect, &produced ) && produced == expect;
+    return codec_decode( algorithm, in, in_size, out, expect, &produced ) && produced == expect;
 }
 
-static UINT64 get64( const BYTE *p ) { UINT64 v; memcpy( &v, p, 8 ); return v; }
-static UINT32 get32( const BYTE *p ) { UINT32 v; memcpy( &v, p, 4 ); return v; }
-
 static BYTE header_checksum( const BYTE *h )
 {
     BYTE copy[HEADER_SIZE - 1];
@@ -348,7 +651,7 @@ BOOL WINAPI Decompress( DECOMPRESSOR_HANDLE handle, LPCVOID compressed, SIZE_T c
             memcpy( uncompressed, in, compressed_size );
             produced = compressed_size;
         }
-        else if (!mszip_decode( in, compressed_size, uncompressed, uncompressed_size, &produced ))
+        else if (!codec_decode( h->algorithm, in, compressed_size, uncompressed, uncompressed_size, &produced ))
         {
             SetLastError( ERROR_BAD_COMPRESSION_BUFFER );
             return FALSE;
@@ -448,7 +751,7 @@ BOOL WINAPI Compress( COMPRESSOR_HANDLE handle, LPCVOID uncompressed, SIZE_T unc
 
     if (h->raw)
     {
-        bound = h->algorithm == COMPRESS_ALGORITHM_NULL ? uncompressed_size : mszip_bound( uncompressed_size );
+        bound = codec_bound( h->algorithm, uncompressed_size );
         if (!out || compressed_size < bound)
         {
             if (result_size) *result_size = bound;
@@ -456,7 +759,7 @@ BOOL WINAPI Compress( COMPRESSOR_HANDLE handle, LPCVOID uncompressed, SIZE_T unc
             return FALSE;
         }
         if (h->algorithm == COMPRESS_ALGORITHM_NULL) { memcpy( out, in, uncompressed_size ); written = uncompressed_size; }
-        else if (!mszip_encode( in, uncompressed_size, out, compressed_size, h->level, &written ))
+        else if (!codec_encode( h->algorithm, in, uncompressed_size, out, compressed_size, h->level, &written ))
         {
             SetLastError( ERROR_INTERNAL_ERROR );
             return FALSE;
@@ -470,7 +773,7 @@ BOOL WINAPI Compress( COMPRESSOR_HANDLE handle, LPCVOID uncompressed, SIZE_T unc
     for (pos = 0; pos < uncompressed_size; pos += chunk)
     {
         SIZE_T len = uncompressed_size - pos < chunk ? uncompressed_size - pos : chunk;
-        bound += 4 + (h->algorithm == COMPRESS_ALGORITHM_NULL ? len : mszip_bound( len ));
+        bound += 4 + codec_bound( h->algorithm, len );
     }
     if (!out || compressed_size < bound)
     {
@@ -494,11 +797,21 @@ BOOL WINAPI Compress( COMPRESSOR_HANDLE handle, LPCVOID uncompressed, SIZE_T unc
         UINT32 size32;
 
         if (h->algorithm == COMPRESS_ALGORITHM_NULL) { memcpy( out + o + 4, in + pos, len ); written = len; }
-        else if (!mszip_encode( in + pos, len, out + o + 4, compressed_size - o - 4, h->level, &written ))
+        else if (!codec_encode( h->algorithm, in + pos, len, out + o + 4, compressed_size - o - 4, h->level, &written ))
         {
             SetLastError( ERROR_INTERNAL_ERROR );
             return FALSE;
         }
+#ifdef SG_MUTANT_XP_STORED
+        else if (0)
+#else
+        else if (h->algorithm == COMPRESS_ALGORITHM_XPRESS && written >= len)
+#endif
+        {
+            /* not smaller: the chunk is kept as it is (its size says so) */
+            memcpy( out + o + 4, in + pos, len );
+            written = len;
+        }
         size32 = written;
         memcpy( out + o, &size32, 4 );
         o += 4 + written;
diff --git a/dlls/cabinet/fdi.c b/dlls/cabinet/fdi.c
index aae71d0..09bd23d 100644
--- a/dlls/cabinet/fdi.c
+++ b/dlls/cabinet/fdi.c
@@ -2853,12 +2853,232 @@ BOOL __cdecl FDITruncateCabinet(
 	USHORT  iFolderToDelete)
 {
   FDI_Int *fdi = get_fdi_ptr( hfdi );
+  cab_UBYTE head[cfhead_SIZEOF], resv[cfheadext_SIZEOF];
