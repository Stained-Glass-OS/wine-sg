From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: a certificate's enhanced key usage property limits its chains (7602)

Windows marks each root of its root program with what it is trusted for
(the enhanced key usage property): a code signing root only for code
signing and time stamping. Wine read only the extensions, so such a root
would be trusted for a web server too. The property now restricts the
chain for the requested usage as an extension does.
---
--- a/dlls/crypt32/chain.c
+++ b/dlls/crypt32/chain.c
@@ -2888,6 +2888,57 @@
                 }
             }
         }
+#ifndef SG_MUTANT_NO_ROOT_EKU_PROP
+        /* Stained Glass OS 7602: what a certificate's store says it may be
+         * trusted for -- its enhanced key usage property, which Windows' root
+         * program sets on every root (Code Signing and Time Stamping only for
+         * a code signing root) -- restricts the chain as an extension does.
+         * Without it such a root would be trusted for anything, a web
+         * server's certificate too. */
+        if (!(chain->TrustStatus.dwErrorStatus & CERT_TRUST_IS_NOT_VALID_FOR_USAGE))
+        {
+            PCERT_SIMPLE_CHAIN simple = chain->rgpChain[0];
+            DWORD e;
+
+            for (e = 0; e < simple->cElement; e++)
+            {
+                PCCERT_CONTEXT cert = simple->rgpElement[e]->pCertContext;
+                const CERT_ENHKEY_USAGE *requested = &pChainPara->RequestedUsage.Usage;
+                CERT_ENHKEY_USAGE *usage;
+                DWORD size = 0, i, j;
+                BYTE *prop;
+                BOOL all = TRUE, any = FALSE;
+
+                if (!CertGetCertificateContextProperty(cert, CERT_ENHKEY_USAGE_PROP_ID, NULL, &size) || !size ||
+                    !(prop = CryptMemAlloc(size)))
+                    continue;
+                if (!CertGetCertificateContextProperty(cert, CERT_ENHKEY_USAGE_PROP_ID, prop, &size) ||
+                    !CryptDecodeObjectEx(X509_ASN_ENCODING, X509_ENHANCED_KEY_USAGE, prop, size,
+                     CRYPT_DECODE_ALLOC_FLAG, NULL, &usage, &size))
+                    all = any = FALSE;
+                else
+                {
+                    for (i = 0; i < requested->cUsageIdentifier; i++)
+                    {
+                        BOOL match = FALSE;
+                        for (j = 0; !match && j < usage->cUsageIdentifier; j++)
+                            match = !strcmp(usage->rgpszUsageIdentifier[j], requested->rgpszUsageIdentifier[i]);
+                        if (match) any = TRUE;
+                        else all = FALSE;
+                    }
+                    LocalFree(usage);
+                }
+                CryptMemFree(prop);
+                if (pChainPara->RequestedUsage.dwType == USAGE_MATCH_TYPE_AND ? !all : !any)
+                {
+                    TRACE_(chain)("element %lu's enhanced key usage property excludes the requested usage\n", e);
+                    chain->TrustStatus.dwErrorStatus |= CERT_TRUST_IS_NOT_VALID_FOR_USAGE;
+                    simple->rgpElement[e]->TrustStatus.dwErrorStatus |= CERT_TRUST_IS_NOT_VALID_FOR_USAGE;
+                    break;
+                }
+            }
+        }
+#endif
     }
     if (pChainPara->cbSize >= sizeof(CERT_CHAIN_PARA) &&
      pChainPara->RequestedIssuancePolicy.Usage.cUsageIdentifier)
