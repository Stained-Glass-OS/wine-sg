+/* Stained Glass OS 1664. A program's jump list -- the categories of
+ * destinations and the tasks it commits with ICustomDestinationList, and
+ * the documents it opened (SHAddToRecentDocs) -- is kept per AppUserModelID
+ * (the program's explicit one, else its file's path) in files of our own
+ * format under the user's Recent folder:
+ *   CustomDestinations\<hash>.sg-customdest   the committed list
+ *   CustomDestinations\<hash>.sg-removed      what the user took off it
+ *   AutomaticDestinations\<hash>.sg-autodest  the documents, with their use
+ * The taskbar shows them on a program's button (SGJumpList* below). */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "shlobj.h"
+#include "shlwapi.h"
+#include "shobjidl.h"
+#include "objectarray.h"
+#include "propkey.h"
+#include "propvarutil.h"
+#include "wine/debug.h"
+
+#include "pidl.h"
+#include "shell32_main.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+#define JUMPLIST_MAGIC  0x4c4a4753  /* "SGJL" */
+#define AUTODEST_MAGIC  0x44414753  /* "SGAD" */
+#define REMOVED_MAGIC   0x4d524753  /* "SGRM" */
+#define FORMAT_VERSION  1
+#define MAX_RECENT      60
+
+enum category_kind { CAT_CUSTOM = 0, CAT_KNOWN = 1, CAT_TASKS = 2 };
+enum item_type { ITEM_LINK = 1, ITEM_SHELLITEM = 2 };
+
+/* ---- the enumerable object collection ------------------------------------ */
+
+struct object_collection
+{
+    IObjectCollection IObjectCollection_iface;
+    LONG ref;
+    IUnknown **objects;
+    UINT count, size;
+};
+
+static inline struct object_collection *impl_from_IObjectCollection( IObjectCollection *iface )
+{
+    return CONTAINING_RECORD( iface, struct object_collection, IObjectCollection_iface );
+}
+
+static HRESULT WINAPI collection_QueryInterface( IObjectCollection *iface, REFIID riid, void **obj )
+{
+    struct object_collection *This = impl_from_IObjectCollection( iface );
+
+    TRACE( "(%p, %s, %p)\n", This, debugstr_guid( riid ), obj );
+
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IObjectArray ) ||
+        IsEqualIID( riid, &IID_IObjectCollection ))
+    {
+        *obj = &This->IObjectCollection_iface;
+        IObjectCollection_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI collection_AddRef( IObjectCollection *iface )
+{
+    struct object_collection *This = impl_from_IObjectCollection( iface );
+    return InterlockedIncrement( &This->ref );
+}
+
+static ULONG WINAPI collection_Release( IObjectCollection *iface )
+{
+    struct object_collection *This = impl_from_IObjectCollection( iface );
+    ULONG ref = InterlockedDecrement( &This->ref ), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) IUnknown_Release( This->objects[i] );
+        free( This->objects );
+        free( This );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI collection_GetCount( IObjectCollection *iface, UINT *count )
+{
+    struct object_collection *This = impl_from_IObjectCollection( iface );
+
+    if (!count) return E_POINTER;
+    *count = This->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_GetAt( IObjectCollection *iface, UINT index, REFIID riid, void **obj )
+{
+    struct object_collection *This = impl_from_IObjectCollection( iface );
+
+    TRACE( "(%p, %u, %s, %p)\n", This, index, debugstr_guid( riid ), obj );
+
+    if (!obj) return E_POINTER;
+    *obj = NULL;
+    if (index >= This->count) return E_INVALIDARG;
+    return IUnknown_QueryInterface( This->objects[index], riid, obj );
+}
+
+static HRESULT WINAPI collection_AddObject( IObjectCollection *iface, IUnknown *object )
+{
+    struct object_collection *This = impl_from_IObjectCollection( iface );
+
+    TRACE( "(%p, %p)\n", This, object );
+
+    if (!object) return E_INVALIDARG;
+    if (This->count == This->size)
+    {
+        UINT size = This->size ? This->size * 2 : 8;
+        IUnknown **objects = realloc( This->objects, size * sizeof(*objects) );
+        if (!objects) return E_OUTOFMEMORY;
+        This->objects = objects;
+        This->size = size;
+    }
+    IUnknown_AddRef( object );
+    This->objects[This->count++] = object;
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_AddFromArray( IObjectCollection *iface, IObjectArray *array )
+{
+    UINT count, i;
+    IUnknown *object;
+    HRESULT hr;
+
+    TRACE( "(%p, %p)\n", iface, array );
+
+    if (!array) return E_INVALIDARG;
+    if (FAILED(hr = IObjectArray_GetCount( array, &count ))) return hr;
+    for (i = 0; i < count; i++)
+    {
+        if (FAILED(hr = IObjectArray_GetAt( array, i, &IID_IUnknown, (void **)&object ))) return hr;
+        hr = collection_AddObject( iface, object );
+        IUnknown_Release( object );
+        if (FAILED(hr)) return hr;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_RemoveObjectAt( IObjectCollection *iface, UINT index )
+{
+    struct object_collection *This = impl_from_IObjectCollection( iface );
+
+    TRACE( "(%p, %u)\n", This, index );
+
+    if (index >= This->count) return E_INVALIDARG;
+    IUnknown_Release( This->objects[index] );
+    memmove( This->objects + index, This->objects + index + 1, (This->count - index - 1) * sizeof(IUnknown *) );
+    This->count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_Clear( IObjectCollection *iface )
+{
+    struct object_collection *This = impl_from_IObjectCollection( iface );
+
+    TRACE( "(%p)\n", This );
+
+    while (This->count)
+    {
+        IUnknown *object = This->objects[--This->count];
+        IUnknown_Release( object );
+    }
+    return S_OK;
+}
+
+static const IObjectCollectionVtbl collection_vtbl =
+{
+    collection_QueryInterface,
+    collection_AddRef,
+    collection_Release,
+    collection_GetCount,
+    collection_GetAt,
+    collection_AddObject,
+    collection_AddFromArray,
+    collection_RemoveObjectAt,
+    collection_Clear,
+};
+
+static HRESULT create_collection( IObjectCollection **out )
+{
+    struct object_collection *This;
+
+    *out = NULL;
+    if (!(This = calloc( 1, sizeof(*This) ))) return E_OUTOFMEMORY;
+    This->IObjectCollection_iface.lpVtbl = &collection_vtbl;
+    This->ref = 1;
+    *out = &This->IObjectCollection_iface;
+    return S_OK;
+}
+
+HRESULT WINAPI EnumerableObjectCollection_Constructor( IUnknown *outer, REFIID riid, void **obj )
+{
+    IObjectCollection *collection;
+    HRESULT hr;
+
+    TRACE( "(%p, %s, %p)\n", outer, debugstr_guid( riid ), obj );
+
+    *obj = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (FAILED(hr = create_collection( &collection ))) return hr;
+    hr = IObjectCollection_QueryInterface( collection, riid, obj );
+    IObjectCollection_Release( collection );
+    return hr;
+}
+
+/* ---- where a program's lists are ------------------------------------------ */
+
+/* the program's AppUserModelID: its explicit one, else its file's path */
+static void current_app_id( WCHAR *id, DWORD size )
+{
+    static HRESULT (WINAPI *get_explicit_id)( WCHAR ** );
+    WCHAR *explicit_id = NULL;
+
+    if (!get_explicit_id)
+    {
+        HMODULE shcore = LoadLibraryW( L"shcore.dll" );
+        if (shcore) get_explicit_id = (void *)GetProcAddress( shcore, "GetCurrentProcessExplicitAppUserModelID" );
+    }
+    if (get_explicit_id && SUCCEEDED(get_explicit_id( &explicit_id )) && explicit_id)
+    {
+        lstrcpynW( id, explicit_id, size );
+        CoTaskMemFree( explicit_id );
+        return;
+    }
+    if (!GetModuleFileNameW( NULL, id, size )) id[0] = 0;
+}
+
+static BOOL list_path( const WCHAR *appid, const WCHAR *dir, const WCHAR *ext, WCHAR *path )
+{
+    ULONGLONG hash = 0xcbf29ce484222325ull;
+    WCHAR base[MAX_PATH];
+    const WCHAR *p;
+
+    if (!appid || !appid[0]) return FALSE;
+    /* FNV-1a over the ID, case-insensitively */
+    for (p = appid; *p; p++)
+    {
+        WCHAR c = towlower( *p );
+        hash = (hash ^ (c & 0xff)) * 0x100000001b3ull;
+        hash = (hash ^ (c >> 8)) * 0x100000001b3ull;
+    }
+    if (FAILED(SHGetFolderPathW( NULL, CSIDL_RECENT | CSIDL_FLAG_CREATE, NULL, SHGFP_TYPE_CURRENT, base ))) return FALSE;
+    swprintf( path, MAX_PATH, L"%s\\%s", base, dir );
+    CreateDirectoryW( path, NULL );
+    swprintf( path, MAX_PATH, L"%s\\%s\\%08lx%08lx.%s", base, dir, (DWORD)(hash >> 32), (DWORD)hash, ext );
+    return TRUE;
+}
+
+static BOOL custom_path( const WCHAR *appid, WCHAR *path )
+{
+    return list_path( appid, L"CustomDestinations", L"sg-customdest", path );
+}
+
+static BOOL removed_path( const WCHAR *appid, WCHAR *path )
+{
+    return list_path( appid, L"CustomDestinations", L"sg-removed", path );
+}
+
+static BOOL auto_path( const WCHAR *appid, WCHAR *path )
+{
+    return list_path( appid, L"AutomaticDestinations", L"sg-autodest", path );
+}
+
+/* ---- reading and writing ---------------------------------------------------- */
+
+static HRESULT write_dword( IStream *stream, DWORD value )
+{
+    return IStream_Write( stream, &value, sizeof(value), NULL );
+}
+
+static HRESULT read_dword( IStream *stream, DWORD *value )
+{
+    ULONG read;
+    HRESULT hr = IStream_Read( stream, value, sizeof(*value), &read );
+    if (SUCCEEDED(hr) && read != sizeof(*value)) hr = E_FAIL;
+    return hr;
+}
+
+static HRESULT write_string( IStream *stream, const WCHAR *str )
+{
+    DWORD len = str ? wcslen( str ) : 0;
+    HRESULT hr;
+
+    if (FAILED(hr = write_dword( stream, len ))) return hr;
+    return len ? IStream_Write( stream, str, len * sizeof(WCHAR), NULL ) : S_OK;
+}
+
+static HRESULT read_string( IStream *stream, WCHAR **str )
+{
+    DWORD len;
+    ULONG read;
+    HRESULT hr;
+
+    *str = NULL;
+    if (FAILED(hr = read_dword( stream, &len ))) return hr;
+    if (len > 32768) return E_FAIL;
+    if (!(*str = malloc( (len + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    hr = len ? IStream_Read( stream, *str, len * sizeof(WCHAR), &read ) : S_OK;
+    if (SUCCEEDED(hr) && len && read != len * sizeof(WCHAR)) hr = E_FAIL;
+    if (FAILED(hr))
+    {
+        free( *str );
+        *str = NULL;
+        return hr;
+    }
+    (*str)[len] = 0;
+    return S_OK;
+}
+
+/* a link (IShellLinkW, with its properties) or a shell item */
+static HRESULT write_item( IStream *stream, IUnknown *object )
+{
+    IPersistStream *persist;
+    IShellLinkW *link;
+    ITEMIDLIST *pidl;
+    HRESULT hr;
+
+    if (SUCCEEDED(IUnknown_QueryInterface( object, &IID_IShellLinkW, (void **)&link )))
+    {
+        hr = IShellLinkW_QueryInterface( link, &IID_IPersistStream, (void **)&persist );
+        IShellLinkW_Release( link );
+        if (FAILED(hr)) return hr;
+        if (SUCCEEDED(hr = write_dword( stream, ITEM_LINK ))) hr = OleSaveToStream( persist, stream );
+        IPersistStream_Release( persist );
+        return hr;
+    }
+    if (FAILED(hr = SHGetIDListFromObject( object, &pidl ))) return hr;
+    if (SUCCEEDED(hr = write_dword( stream, ITEM_SHELLITEM ))) hr = ILSaveToStream( stream, pidl );
+    ILFree( pidl );
+    return hr;
+}
+
+static HRESULT read_item( IStream *stream, IUnknown **object )
+{
+    ITEMIDLIST *pidl;
+    DWORD type;
+    HRESULT hr;
+
+    *object = NULL;
+    if (FAILED(hr = read_dword( stream, &type ))) return hr;
+    if (type == ITEM_LINK) return OleLoadFromStream( stream, &IID_IUnknown, (void **)object );
+    if (type != ITEM_SHELLITEM) return E_FAIL;
+    if (FAILED(hr = ILLoadFromStream( stream, &pidl ))) return hr;
+    hr = SHCreateItemFromIDList( pidl, &IID_IUnknown, (void **)object );
+    ILFree( pidl );
+    return hr;
+}
+
+/* what tells two destinations apart: a link's target and arguments, an
+ * item's parsing name */
+static BOOL item_key( IUnknown *object, WCHAR *key, DWORD size )
+{
+    IShellLinkW *link;
+    IShellItem *item;
+    WCHAR *name;
+    DWORD len;
+
+    key[0] = 0;
+    if (SUCCEEDED(IUnknown_QueryInterface( object, &IID_IShellLinkW, (void **)&link )))
+    {
+        IShellLinkW_GetPath( link, key, size, NULL, SLGP_RAWPATH );
+        len = wcslen( key );
+        if (len + 2 < size)
+        {
+            key[len++] = '|';
+            IShellLinkW_GetArguments( link, key + len, size - len );
+        }
+        IShellLinkW_Release( link );
+        return TRUE;
+    }
+    if (SUCCEEDED(IUnknown_QueryInterface( object, &IID_IShellItem, (void **)&item )))
+    {
+        if (SUCCEEDED(IShellItem_GetDisplayName( item, SIGDN_DESKTOPABSOLUTEPARSING, &name )))
+        {
+            lstrcpynW( key, name, size );
+            CoTaskMemFree( name );
+        }
+        IShellItem_Release( item );
+        return key[0] != 0;
+    }
+    return FALSE;
+}
+
+/* the removed destinations of a program */
+static HRESULT load_removed( const WCHAR *appid, IObjectCollection **out )
+{
+    WCHAR path[MAX_PATH];
+    IStream *stream;
+    IUnknown *object;
+    DWORD magic, version, count, i;
+    HRESULT hr;
+
+    if (FAILED(hr = create_collection( out ))) return hr;
+    if (!removed_path( appid, path ) ||
+        FAILED(SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream )))
+        return S_OK;
+    if (SUCCEEDED(read_dword( stream, &magic )) && magic == REMOVED_MAGIC &&
+        SUCCEEDED(read_dword( stream, &version )) && version == FORMAT_VERSION &&
+        SUCCEEDED(read_dword( stream, &count )))
+    {
+        for (i = 0; i < count && SUCCEEDED(read_item( stream, &object )); i++)
+        {
+            IObjectCollection_AddObject( *out, object );
+            IUnknown_Release( object );
+        }
+    }
+    IStream_Release( stream );
+    return S_OK;
+}
+
+static BOOL is_removed( IObjectArray *removed, IUnknown *object )
+{
+    WCHAR key[MAX_PATH * 2], other[MAX_PATH * 2];
+    IUnknown *entry;
+    UINT count = 0, i;
+    BOOL found = FALSE;
+
+    if (!removed || !item_key( object, key, ARRAY_SIZE(key) )) return FALSE;
+    IObjectArray_GetCount( removed, &count );
+    for (i = 0; i < count && !found; i++)
+    {
+        if (FAILED(IObjectArray_GetAt( removed, i, &IID_IUnknown, (void **)&entry ))) continue;
+        found = item_key( entry, other, ARRAY_SIZE(other) ) && !wcsicmp( key, other );
+        IUnknown_Release( entry );
+    }
+    return found;
+}
+
+/* the documents a program opened (SHAddToRecentDocs) */
+struct auto_entry
+{
+    WCHAR *path;
+    DWORD uses;
+    FILETIME last;
+};
+
+struct auto_list
+{
+    struct auto_entry *entries;
+    DWORD count;
+};
+
+static void free_auto( struct auto_list *list )
+{
+    DWORD i;
+    for (i = 0; i < list->count; i++) free( list->entries[i].path );
+    free( list->entries );
+    list->entries = NULL;
+    list->count = 0;
+}
+
+static void load_auto( const WCHAR *appid, struct auto_list *list )
+{
+    WCHAR path[MAX_PATH];
+    IStream *stream;
+    DWORD magic, version, count, i;
+
+    list->entries = NULL;
+    list->count = 0;
+    if (!auto_path( appid, path ) ||
+        FAILED(SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream )))
+        return;
+    if (SUCCEEDED(read_dword( stream, &magic )) && magic == AUTODEST_MAGIC &&
+        SUCCEEDED(read_dword( stream, &version )) && version == FORMAT_VERSION &&
+        SUCCEEDED(read_dword( stream, &count )) && count <= 4096 &&
+        (list->entries = calloc( count, sizeof(*list->entries) )))
+    {
+        for (i = 0; i < count; i++)
+        {
+            struct auto_entry *e = &list->entries[i];
+            if (FAILED(read_string( stream, &e->path )) || FAILED(read_dword( stream, &e->uses )) ||
+                FAILED(read_dword( stream, &e->last.dwLowDateTime )) ||
+                FAILED(read_dword( stream, &e->last.dwHighDateTime )))
+            {
+                free( e->path );
+                break;
+            }
+            list->count++;
+        }
+    }
+    IStream_Release( stream );
+}
+
+static void save_auto( const WCHAR *appid, const struct auto_list *list )
+{
+    WCHAR path[MAX_PATH];
+    IStream *stream;
+    DWORD i;
+
+    if (!auto_path( appid, path )) return;
+    if (!list->count)
+    {
+        DeleteFileW( path );
+        return;
+    }
+    if (FAILED(SHCreateStreamOnFileEx( path, STGM_WRITE | STGM_CREATE | STGM_SHARE_EXCLUSIVE, 0, TRUE, NULL,
+                                       &stream )))
+        return;
+    write_dword( stream, AUTODEST_MAGIC );
+    write_dword( stream, FORMAT_VERSION );
+    write_dword( stream, list->count );
+    for (i = 0; i < list->count; i++)
+    {
+        write_string( stream, list->entries[i].path );
+        write_dword( stream, list->entries[i].uses );
+        write_dword( stream, list->entries[i].last.dwLowDateTime );
+        write_dword( stream, list->entries[i].last.dwHighDateTime );
+    }
+    IStream_Release( stream );
+}
+
+/* SHAddToRecentDocs: the document goes on the program's own list too */
+void jumplist_add_recent( const WCHAR *appid, const WCHAR *doc )
+{
+    WCHAR id[MAX_PATH];
+    struct auto_list list;
+    DWORD i, oldest = 0;
+    FILETIME now;
+
+    if (!doc || !doc[0]) return;
+    if (!appid || !appid[0])
+    {
+        current_app_id( id, ARRAY_SIZE(id) );
+        appid = id;
+    }
+    GetSystemTimeAsFileTime( &now );
+    load_auto( appid, &list );
+    for (i = 0; i < list.count; i++)
+        if (!wcsicmp( list.entries[i].path, doc )) break;
+    if (i == list.count)
+    {
+        struct auto_entry *entries;
+
+        if (list.count >= MAX_RECENT)
+        {
+            /* the least recently used goes */
+            for (i = 1; i < list.count; i++)
+                if (CompareFileTime( &list.entries[i].last, &list.entries[oldest].last ) < 0) oldest = i;
+            free( list.entries[oldest].path );
+            list.entries[oldest] = list.entries[--list.count];
+        }
+        if (!(entries = realloc( list.entries, (list.count + 1) * sizeof(*entries) )))
+        {
+            free_auto( &list );
+            return;
+        }
+        list.entries = entries;
+        i = list.count++;
+        entries[i].path = wcsdup( doc );
+        entries[i].uses = 0;
+    }
+    list.entries[i].uses++;
+    list.entries[i].last = now;
+    save_auto( appid, &list );
+    free_auto( &list );
+}
+
+static int __cdecl cmp_recent( const void *a, const void *b )
+{
+    const struct auto_entry *x = a, *y = b;
+    return CompareFileTime( &y->last, &x->last );
+}
+
+static int __cdecl cmp_frequent( const void *a, const void *b )
+{
+    const struct auto_entry *x = a, *y = b;
+    if (x->uses != y->uses) return x->uses > y->uses ? -1 : 1;
+    return CompareFileTime( &y->last, &x->last );
+}
+
+/* the program's documents, most recent or most used first, that still exist */
+static HRESULT auto_items( const WCHAR *appid, BOOL frequent, UINT max, IObjectCollection **out )
+{
+    struct auto_list list;
+    IShellItem *item;
+    UINT added = 0;
+    DWORD i;
+    HRESULT hr;
+
+    if (FAILED(hr = create_collection( out ))) return hr;
+    load_auto( appid, &list );
+    if (list.count) qsort( list.entries, list.count, sizeof(*list.entries), frequent ? cmp_frequent : cmp_recent );
+    for (i = 0; i < list.count && (!max || added < max); i++)
+    {
+        if (GetFileAttributesW( list.entries[i].path ) == INVALID_FILE_ATTRIBUTES) continue;
+        if (FAILED(SHCreateItemFromParsingName( list.entries[i].path, NULL, &IID_IShellItem, (void **)&item )))
+            continue;
+        IObjectCollection_AddObject( *out, (IUnknown *)item );
+        IShellItem_Release( item );
+        added++;
+    }
+    free_auto( &list );
+    return S_OK;
+}
