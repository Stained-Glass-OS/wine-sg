+ *
+ * Stained Glass OS 1664: also SHARD_APPIDINFO, SHARD_APPIDINFOIDLIST,
+ * SHARD_LINK, SHARD_APPIDINFOLINK and SHARD_SHELLITEM, and the document goes
+ * on its program's own list (the jump list's Recent and Frequent) -- the
+ * AppUserModelID given, else the calling program's.
+ */
+void WINAPI SHAddToRecentDocs (UINT uFlags,LPCVOID pv)
+{
+    const WCHAR *appid = NULL;
+    IShellItem *item = NULL;
+    IShellLinkW *link = NULL;
+    ITEMIDLIST *pidl = NULL;
+    WCHAR path[MAX_PATH];
+
+    TRACE("%04x %p\n", uFlags, pv);
+
+    if (!pv)
+    {
+        SHADD_add_document(uFlags, NULL);
+        return;
+    }
+    path[0] = 0;
+    switch (uFlags)
+    {
+    case SHARD_PIDL:
+        SHGetPathFromIDListW(pv, path);
+        break;
+    case SHARD_PATHA:
+        MultiByteToWideChar(CP_ACP, 0, pv, -1, path, MAX_PATH);
+        break;
+    case SHARD_PATHW:
+        lstrcpynW(path, pv, MAX_PATH);
+        break;
+    case SHARD_APPIDINFO:
+        item = ((const SHARDAPPIDINFO *)pv)->psi;
+        appid = ((const SHARDAPPIDINFO *)pv)->pszAppID;
+        break;
+    case SHARD_APPIDINFOIDLIST:
+        SHGetPathFromIDListW(((const SHARDAPPIDINFOIDLIST *)pv)->pidl, path);
+        appid = ((const SHARDAPPIDINFOIDLIST *)pv)->pszAppID;
+        break;
+    case SHARD_LINK:
+        link = (IShellLinkW *)pv;
+        break;
+    case SHARD_APPIDINFOLINK:
+        link = ((const SHARDAPPIDINFOLINK *)pv)->psl;
+        appid = ((const SHARDAPPIDINFOLINK *)pv)->pszAppID;
+        break;
+    case SHARD_SHELLITEM:
+        item = (IShellItem *)pv;
+        break;
+    default:
+        FIXME("Unsupported flags: %u\n", uFlags);
+        return;
+    }
+    if (item && SUCCEEDED(SHGetIDListFromObject((IUnknown *)item, &pidl)))
+        SHGetPathFromIDListW(pidl, path);
+    if (link)
+    {
+        if (FAILED(IShellLinkW_GetPath(link, path, MAX_PATH, NULL, SLGP_RAWPATH)) || !path[0])
+        {
+            if (SUCCEEDED(IShellLinkW_GetIDList(link, &pidl))) SHGetPathFromIDListW(pidl, path);
+        }
+    }
+    ILFree(pidl);
+    if (!path[0]) return;
+    SHADD_add_document(SHARD_PATHW, path);
+#ifndef SG_MUTANT_NO_APP_RECENT
+    if (!SHRestricted(REST_NORECENTDOCSHISTORY)) jumplist_add_recent(appid, path);
+#endif
+}
