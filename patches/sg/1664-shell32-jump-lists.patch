+/* takes a document off the program's Recent and Frequent lists */
+static HRESULT WINAPI ApplicationDestinations_RemoveDestination( IApplicationDestinations *iface, IUnknown *punk )
+{
+    struct app_destinations *This = impl_from_IApplicationDestinations( iface );
+    WCHAR key[MAX_PATH * 2], *bar;
+    struct auto_list list;
+    BOOL removed = FALSE;
+    DWORD i;
+
+    TRACE( "(%p, %p)\n", This, punk );
+
+    if (!punk) return E_INVALIDARG;
+    if (!item_key( punk, key, ARRAY_SIZE(key) )) return E_INVALIDARG;
+    /* a link stands for its target */
+    if ((bar = wcschr( key, '|' ))) *bar = 0;
+    load_auto( destinations_app_id( This ), &list );
+    for (i = 0; i < list.count; )
+    {
+        if (wcsicmp( list.entries[i].path, key )) { i++; continue; }
+        free( list.entries[i].path );
+        list.entries[i] = list.entries[--list.count];
+        removed = TRUE;
+    }
+    if (removed) save_auto( This->appid, &list );
+    free_auto( &list );
+    return removed ? S_OK : E_INVALIDARG;
+}
+
