+/* the most items the taskbar shows in a list */
+static UINT max_slots(void)
+{
+    DWORD value = 10, size = sizeof(value);
+
+    RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
+                  L"JumpListItems_Maximum", RRF_RT_REG_DWORD, NULL, &value, &size );
+    return value ? value : 10;
+}
+
+static HRESULT WINAPI CustomDestinationList_BeginList( ICustomDestinationList *iface, UINT *min_slots, REFIID riid,
+                                                       void **obj )
+{
+    struct destination_list *This = impl_from_ICustomDestinationList( iface );
+    HRESULT hr;
+
+    TRACE( "(%p, %p, %s, %p)\n", This, min_slots, debugstr_guid( riid ), obj );
+
+    if (!min_slots || !obj) return E_POINTER;
+    *obj = NULL;
+    clear_categories( This );
+    if (FAILED(hr = load_removed( list_app_id( This ), &This->removed ))) return hr;
+    if (FAILED(hr = IObjectCollection_QueryInterface( This->removed, riid, obj )))
+    {
+        clear_categories( This );
+        return hr;
+    }
+    *min_slots = max_slots();
+    This->building = TRUE;
+    return S_OK;
+}
+
+static HRESULT add_category( struct destination_list *This, enum category_kind kind, DWORD known,
+                             const WCHAR *name, IObjectArray *items )
+{
+    struct category *categories, *cat;
+    HRESULT hr;
+
+    if (!(categories = realloc( This->categories, (This->count + 1) * sizeof(*categories) )))
+        return E_OUTOFMEMORY;
+    This->categories = categories;
+    cat = &categories[This->count];
+    memset( cat, 0, sizeof(*cat) );
+    cat->kind = kind;
+    cat->known = known;
+    if (name && !(cat->name = wcsdup( name ))) return E_OUTOFMEMORY;
+    if (items)
+    {
+        if (FAILED(hr = create_collection( &cat->items )) ||
+            FAILED(hr = IObjectCollection_AddFromArray( cat->items, items )))
+        {
+            if (cat->items) IObjectCollection_Release( cat->items );
+            free( cat->name );
+            return hr;
+        }
+    }
+    This->count++;
+    return S_OK;
+}
+
+/* destinations are links and shell items; tasks are links */
+static HRESULT check_items( IObjectArray *array, BOOL links_only, IObjectArray *removed )
+{
+    UINT count, i;
+    IUnknown *object, *probe;
+    HRESULT hr;
+
+    if (!array) return E_INVALIDARG;
+    if (FAILED(hr = IObjectArray_GetCount( array, &count ))) return hr;
+    for (i = 0; i < count; i++)
+    {
+        if (FAILED(hr = IObjectArray_GetAt( array, i, &IID_IUnknown, (void **)&object ))) return hr;
+        if (SUCCEEDED(IUnknown_QueryInterface( object, &IID_IShellLinkW, (void **)&probe )) ||
+            (!links_only && SUCCEEDED(IUnknown_QueryInterface( object, &IID_IShellItem, (void **)&probe ))))
+        {
+            IUnknown_Release( probe );
+            hr = S_OK;
+        }
+        else hr = E_INVALIDARG;
+        /* what the user removed stays off the list */
+        if (SUCCEEDED(hr) && is_removed( removed, object )) hr = E_ACCESSDENIED;
+        IUnknown_Release( object );
+        if (FAILED(hr)) return hr;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI CustomDestinationList_AppendCategory( ICustomDestinationList *iface, const WCHAR *category,
+                                                            IObjectArray *array )
+{
+    struct destination_list *This = impl_from_ICustomDestinationList( iface );
+    HRESULT hr;
+
+    TRACE( "(%p, %s, %p)\n", This, debugstr_w( category ), array );
+
+    if (!This->building) return E_UNEXPECTED;
+    if (!category || !category[0]) return E_INVALIDARG;
+    if (FAILED(hr = check_items( array, FALSE, (IObjectArray *)This->removed ))) return hr;
+    return add_category( This, CAT_CUSTOM, 0, category, array );
+}
+
+static HRESULT WINAPI CustomDestinationList_AppendKnownCategory( ICustomDestinationList *iface,
+                                                                 KNOWNDESTCATEGORY category )
+{
+    struct destination_list *This = impl_from_ICustomDestinationList( iface );
+    UINT i;
+
+    TRACE( "(%p, %d)\n", This, category );
+
+    if (!This->building) return E_UNEXPECTED;
+    if (category != KDC_FREQUENT && category != KDC_RECENT) return E_INVALIDARG;
+    for (i = 0; i < This->count; i++)
+        if (This->categories[i].kind == CAT_KNOWN && This->categories[i].known == category) return S_OK;
+    return add_category( This, CAT_KNOWN, category, NULL, NULL );
+}
+
+static HRESULT WINAPI CustomDestinationList_AddUserTasks( ICustomDestinationList *iface, IObjectArray *tasks )
+{
+    struct destination_list *This = impl_from_ICustomDestinationList( iface );
+    HRESULT hr;
+    UINT i;
+
+    TRACE( "(%p, %p)\n", This, tasks );
+
+    if (!This->building) return E_UNEXPECTED;
+    if (FAILED(hr = check_items( tasks, TRUE, NULL ))) return hr;
+    /* tasks added again are added to the tasks */
+    for (i = 0; i < This->count; i++)
+        if (This->categories[i].kind == CAT_TASKS) return IObjectCollection_AddFromArray( This->categories[i].items, tasks );
+    return add_category( This, CAT_TASKS, 0, NULL, tasks );
+}
+
+static HRESULT WINAPI CustomDestinationList_CommitList( ICustomDestinationList *iface )
+{
+    struct destination_list *This = impl_from_ICustomDestinationList( iface );
+    WCHAR path[MAX_PATH], temp[MAX_PATH];
+    IStream *stream;
+    IUnknown *object;
+    UINT i, j, count;
+    HRESULT hr;
+
+    TRACE( "(%p)\n", This );
+
+    if (!This->building) return E_UNEXPECTED;
+    if (!custom_path( list_app_id( This ), path )) return E_FAIL;
+    swprintf( temp, ARRAY_SIZE(temp), L"%s.new", path );
+    if (FAILED(hr = SHCreateStreamOnFileEx( temp, STGM_WRITE | STGM_CREATE | STGM_SHARE_EXCLUSIVE, 0, TRUE,
+                                            NULL, &stream )))
+        return hr;
+    write_dword( stream, JUMPLIST_MAGIC );
+    write_dword( stream, FORMAT_VERSION );
+    write_string( stream, This->appid );
+    write_dword( stream, This->count );
+    for (i = 0; i < This->count && SUCCEEDED(hr); i++)
+    {
+        struct category *cat = &This->categories[i];
+
+        count = 0;
+        if (cat->items) IObjectCollection_GetCount( cat->items, &count );
+        write_dword( stream, cat->kind );
+        write_dword( stream, cat->known );
+        write_string( stream, cat->name );
+        hr = write_dword( stream, count );
+        for (j = 0; j < count && SUCCEEDED(hr); j++)
+        {
+            if (FAILED(hr = IObjectCollection_GetAt( cat->items, j, &IID_IUnknown, (void **)&object ))) break;
+            hr = write_item( stream, object );
+            IUnknown_Release( object );
+        }
+    }
+    IStream_Release( stream );
+#ifdef SG_MUTANT_COMMIT_NOTHING
+    hr = E_FAIL;
+#endif
+    if (SUCCEEDED(hr) && !MoveFileExW( temp, path, MOVEFILE_REPLACE_EXISTING ))
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+    if (FAILED(hr))
+    {
+        DeleteFileW( temp );
+        return hr;
+    }
+    clear_categories( This );
+    return S_OK;
+}
+
+static HRESULT WINAPI CustomDestinationList_GetRemovedDestinations( ICustomDestinationList *iface, REFIID riid,
+                                                                    void **obj )
+{
+    struct destination_list *This = impl_from_ICustomDestinationList( iface );
+    IObjectCollection *removed;
+    HRESULT hr;
+
+    TRACE( "(%p, %s, %p)\n", This, debugstr_guid( riid ), obj );
+
+    if (!obj) return E_POINTER;
+    *obj = NULL;
+    if (FAILED(hr = load_removed( list_app_id( This ), &removed ))) return hr;
+    hr = IObjectCollection_QueryInterface( removed, riid, obj );
+    IObjectCollection_Release( removed );
+    return hr;
+}
+
+static HRESULT WINAPI CustomDestinationList_DeleteList( ICustomDestinationList *iface, const WCHAR *appid )
+{
+    struct destination_list *This = impl_from_ICustomDestinationList( iface );
+    WCHAR path[MAX_PATH];
+
+    TRACE( "(%p, %s)\n", This, debugstr_w( appid ) );
+
+    if (!appid) appid = list_app_id( This );
+    if (!custom_path( appid, path )) return E_INVALIDARG;
+    DeleteFileW( path );
+    return S_OK;
+}
+
+static HRESULT WINAPI CustomDestinationList_AbortList( ICustomDestinationList *iface )
+{
+    struct destination_list *This = impl_from_ICustomDestinationList( iface );
