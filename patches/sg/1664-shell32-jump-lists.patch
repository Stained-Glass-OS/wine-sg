+    hr = IApplicationDocumentLists_QueryInterface( &This->IApplicationDocumentLists_iface, riid, ppv );
+    IApplicationDocumentLists_Release( &This->IApplicationDocumentLists_iface );
+    return hr;
+}
+
+/* ---- the taskbar's view ---------------------------------------------------------- */
+
+/* A program's jump list as its taskbar button shows it: its categories (a
+ * heading, then its destinations), its tasks, and -- for a program that has
+ * not said otherwise -- the documents it opened recently. Private to
+ * explorer (GetProcAddress). */
+struct jump_entry
+{
+    int kind;           /* 0 a heading, 1 a destination or task, 2 a separator */
+    WCHAR *title;
+    IUnknown *object;   /* entries */
+};
+
+struct jump_view
+{
+    WCHAR exe[MAX_PATH];
+    struct jump_entry *entries;
+    UINT count;
+};
+
+static void view_add( struct jump_view *view, int kind, const WCHAR *title, IUnknown *object )
+{
+    struct jump_entry *entries = realloc( view->entries, (view->count + 1) * sizeof(*entries) );
+
+    if (!entries) return;
+    view->entries = entries;
+    entries[view->count].kind = kind;
+    entries[view->count].title = wcsdup( title ? title : L"" );
+    entries[view->count].object = object;
+    if (object) IUnknown_AddRef( object );
+    view->count++;
+}
+
+/* a link's Title property, else its description, else its target's name;
+ * an item's display name. Indirect strings (@file,-id) are loaded. */
+static void object_title( IUnknown *object, WCHAR *title, DWORD size, BOOL *separator )
+{
+    IPropertyStore *store;
+    IShellLinkW *link;
+    IShellItem *item;
+    PROPVARIANT value;
+    WCHAR *name, raw[MAX_PATH];
+
+    title[0] = 0;
+    *separator = FALSE;
+    if (SUCCEEDED(IUnknown_QueryInterface( object, &IID_IPropertyStore, (void **)&store )))
+    {
+        PropVariantInit( &value );
+        if (SUCCEEDED(IPropertyStore_GetValue( store, &PKEY_AppUserModel_IsDestListSeparator, &value )) &&
+            value.vt == VT_BOOL && value.boolVal)
+            *separator = TRUE;
+        PropVariantClear( &value );
+        if (SUCCEEDED(IPropertyStore_GetValue( store, &PKEY_Title, &value )) && value.vt == VT_LPWSTR && value.pwszVal)
+            lstrcpynW( title, value.pwszVal, size );
+        PropVariantClear( &value );
+        IPropertyStore_Release( store );
+    }
+    if (!title[0] && SUCCEEDED(IUnknown_QueryInterface( object, &IID_IShellLinkW, (void **)&link )))
+    {
+        IShellLinkW_GetDescription( link, title, size );
+        if (!title[0] && SUCCEEDED(IShellLinkW_GetPath( link, raw, ARRAY_SIZE(raw), NULL, 0 )) && raw[0])
+        {
+            lstrcpynW( title, PathFindFileNameW( raw ), size );
+            PathRemoveExtensionW( title );
+        }
+        IShellLinkW_Release( link );
+    }
+    if (!title[0] && SUCCEEDED(IUnknown_QueryInterface( object, &IID_IShellItem, (void **)&item )))
+    {
+        if (SUCCEEDED(IShellItem_GetDisplayName( item, SIGDN_NORMALDISPLAY, &name )))
+        {
+            lstrcpynW( title, name, size );
+            CoTaskMemFree( name );
+        }
+        IShellItem_Release( item );
+    }
+    if (title[0] == '@')
+    {
+        lstrcpynW( raw, title, ARRAY_SIZE(raw) );
+        SHLoadIndirectString( raw, title, size, NULL );
+    }
+}
+
+static void view_add_items( struct jump_view *view, IObjectArray *items, UINT max )
+{
+    WCHAR title[MAX_PATH];
+    IUnknown *object;
+    UINT count = 0, i, shown = 0;
+    BOOL separator;
+
+    IObjectArray_GetCount( items, &count );
+    for (i = 0; i < count && (!max || shown < max); i++)
+    {
+        if (FAILED(IObjectArray_GetAt( items, i, &IID_IUnknown, (void **)&object ))) continue;
+        object_title( object, title, ARRAY_SIZE(title), &separator );
+        if (separator) view_add( view, 2, NULL, NULL );
+        else
+        {
+            view_add( view, 1, title, object );
+            shown++;
+        }
+        IUnknown_Release( object );
+    }
+}
+
+static void view_add_auto( struct jump_view *view, const WCHAR *appid, BOOL frequent, UINT max )
+{
+    IObjectCollection *items;
+    UINT count = 0;
+
+    if (FAILED(auto_items( appid, frequent, max, &items ))) return;
+    IObjectCollection_GetCount( items, &count );
+    if (count)
+    {
+        view_add( view, 0, frequent ? L"Frequent" : L"Recent", NULL );
+        view_add_items( view, (IObjectArray *)items, max );
+    }
+    IObjectCollection_Release( items );
+}
+
+void WINAPI SGJumpListFree( struct jump_view *view )
+{
+    UINT i;
+
+    if (!view) return;
+    for (i = 0; i < view->count; i++)
+    {
+        free( view->entries[i].title );
+        if (view->entries[i].object) IUnknown_Release( view->entries[i].object );
+    }
+    free( view->entries );
+    free( view );
+}
+
+HRESULT WINAPI SGJumpListLoad( const WCHAR *appid, const WCHAR *exe, struct jump_view **out )
+{
+    struct jump_view *view;
+    WCHAR path[MAX_PATH], *name, *saved_id = NULL;
+    IObjectCollection *items, *tasks = NULL;
+    IUnknown *object;
+    IStream *stream;
+    DWORD magic, version, ncat, kind, known, count, i, j;
+    BOOL custom = FALSE;
+    UINT max = max_slots();
+
+    TRACE( "(%s, %s, %p)\n", debugstr_w( appid ), debugstr_w( exe ), out );
+
+    *out = NULL;
+    if (!appid || !appid[0]) appid = exe;
+    if (!appid || !appid[0]) return E_INVALIDARG;
+    if (!(view = calloc( 1, sizeof(*view) ))) return E_OUTOFMEMORY;
+    if (exe) lstrcpynW( view->exe, exe, ARRAY_SIZE(view->exe) );
+
+    if (custom_path( appid, path ) &&
+        SUCCEEDED(SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream )))
+    {
+        if (SUCCEEDED(read_dword( stream, &magic )) && magic == JUMPLIST_MAGIC &&
+            SUCCEEDED(read_dword( stream, &version )) && version == FORMAT_VERSION &&
+            SUCCEEDED(read_string( stream, &saved_id )) && SUCCEEDED(read_dword( stream, &ncat )))
+        {
+            custom = TRUE;
+            for (i = 0; i < ncat; i++)
+            {
+                name = NULL;
+                if (FAILED(read_dword( stream, &kind )) || FAILED(read_dword( stream, &known )) ||
+                    FAILED(read_string( stream, &name )) || FAILED(read_dword( stream, &count )))
+                {
+                    free( name );
+                    break;
+                }
+                if (FAILED(create_collection( &items )))
+                {
+                    free( name );
+                    break;
+                }
+                for (j = 0; j < count && SUCCEEDED(read_item( stream, &object )); j++)
+                {
+                    IObjectCollection_AddObject( items, object );
+                    IUnknown_Release( object );
+                }
+                if (kind == CAT_KNOWN) view_add_auto( view, appid, known == KDC_FREQUENT, max );
+                else if (kind == CAT_TASKS)
+                {
+                    if (tasks) IObjectCollection_Release( tasks );
+                    tasks = items;
+                    IObjectCollection_AddRef( tasks );
+                }
+                else if (j)
+                {
+                    WCHAR heading[MAX_PATH];
+
+                    lstrcpynW( heading, name ? name : L"", ARRAY_SIZE(heading) );
+                    if (heading[0] == '@') SHLoadIndirectString( name, heading, ARRAY_SIZE(heading), NULL );
+                    view_add( view, 0, heading, NULL );
+                    view_add_items( view, (IObjectArray *)items, max );
+                }
+                IObjectCollection_Release( items );
+                free( name );
+                if (j < count) break;
+            }
+        }
+        free( saved_id );
+        IStream_Release( stream );
+    }
+    /* a program without a list of its own has its recent documents */
+    if (!custom) view_add_auto( view, appid, FALSE, max );
+    if (tasks)
+    {
+        UINT ntasks = 0;
+
+        IObjectCollection_GetCount( tasks, &ntasks );
+        if (ntasks)
+        {
+            view_add( view, 0, L"Tasks", NULL );
+            view_add_items( view, (IObjectArray *)tasks, 0 );
+        }
+        IObjectCollection_Release( tasks );
+    }
+    *out = view;
+    return S_OK;
+}
+
+UINT WINAPI SGJumpListCount( struct jump_view *view )
+{
+    return view ? view->count : 0;
+}
+
+/* kind: 0 a heading, 1 an entry, 2 a separator */
+BOOL WINAPI SGJumpListEntry( struct jump_view *view, UINT index, int *kind, WCHAR *title, UINT size )
+{
+    if (!view || index >= view->count) return FALSE;
+    *kind = view->entries[index].kind;
+    lstrcpynW( title, view->entries[index].title, size );
+    return TRUE;
+}
+
+/* a task or destination link runs as the link says; a document opens in the
+ * program the list belongs to */
+HRESULT WINAPI SGJumpListInvoke( struct jump_view *view, UINT index, HWND hwnd )
+{
+    SHELLEXECUTEINFOW info = { sizeof(info) };
+    WCHAR file[MAX_PATH], args[2048], dir[MAX_PATH], *doc = NULL, *quoted = NULL;
+    ITEMIDLIST *pidl = NULL;
+    IShellLinkW *link;
+    IShellItem *item;
+    int show = SW_SHOWNORMAL;
+    HRESULT hr = S_OK;
+
+    if (!view || index >= view->count || !view->entries[index].object) return E_INVALIDARG;
+    info.hwnd = hwnd;
+    info.nShow = SW_SHOWNORMAL;
+    if (SUCCEEDED(IUnknown_QueryInterface( view->entries[index].object, &IID_IShellLinkW, (void **)&link )))
+    {
+        file[0] = args[0] = dir[0] = 0;
+        IShellLinkW_GetPath( link, file, ARRAY_SIZE(file), NULL, 0 );
+        IShellLinkW_GetArguments( link, args, ARRAY_SIZE(args) );
+        IShellLinkW_GetWorkingDirectory( link, dir, ARRAY_SIZE(dir) );
+        IShellLinkW_GetShowCmd( link, &show );
+        if (!file[0]) IShellLinkW_GetIDList( link, &pidl );
+        IShellLinkW_Release( link );
+        info.nShow = show;
+        if (file[0]) info.lpFile = file;
+        else if (pidl)
+        {
+            info.fMask = SEE_MASK_IDLIST;
+            info.lpIDList = pidl;
+        }
+        else return E_FAIL;
+        info.lpParameters = args[0] ? args : NULL;
+        info.lpDirectory = dir[0] ? dir : NULL;
+    }
+    else if (SUCCEEDED(IUnknown_QueryInterface( view->entries[index].object, &IID_IShellItem, (void **)&item )))
+    {
+        hr = IShellItem_GetDisplayName( item, SIGDN_FILESYSPATH, &doc );
+        if (FAILED(hr)) hr = SHGetIDListFromObject( (IUnknown *)item, &pidl );
+        IShellItem_Release( item );
+        if (FAILED(hr)) return hr;
+        if (doc && view->exe[0] && (quoted = malloc( (wcslen( doc ) + 3) * sizeof(WCHAR) )))
+        {
+            swprintf( quoted, wcslen( doc ) + 3, L"\"%s\"", doc );
+            info.lpFile = view->exe;
+            info.lpParameters = quoted;
+        }
+        else if (doc) info.lpFile = doc;
+        else
+        {
+            info.fMask = SEE_MASK_IDLIST;
+            info.lpIDList = pidl;
+        }
+    }
+    else return E_INVALIDARG;
+    info.fMask |= SEE_MASK_FLAG_NO_UI | SEE_MASK_NOASYNC;
+    if (!ShellExecuteExW( &info )) hr = HRESULT_FROM_WIN32( GetLastError() );
+    ILFree( pidl );
+    CoTaskMemFree( doc );
+    free( quoted );
+    return hr;
+}
