+
+static void clear_categories( struct destination_list *This )
+{
+    UINT i;
+
+    for (i = 0; i < This->count; i++)
+    {
+        free( This->categories[i].name );
+        if (This->categories[i].items) IObjectCollection_Release( This->categories[i].items );
+    }
+    free( This->categories );
+    This->categories = NULL;
+    This->count = 0;
+    if (This->removed) IObjectCollection_Release( This->removed );
+    This->removed = NULL;
+    This->building = FALSE;
+}
+
+static const WCHAR *list_app_id( struct destination_list *This )
+{
