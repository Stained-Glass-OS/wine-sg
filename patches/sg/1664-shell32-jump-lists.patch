+/* Stained Glass OS 1664: clearing the list deletes the shortcuts in the
+ * Recent folder and the programs' document lists (their jump lists) */
+static void SHADD_clear_recent(const char *link_dir)
+{
+    static const char *patterns[] = { "*.lnk", "AutomaticDestinations\\*.sg-autodest" };
+    char path[MAX_PATH];
+    WIN32_FIND_DATAA data;
+    HANDLE find;
+    unsigned int i;
+
+    if (!link_dir[0]) return;
+    for (i = 0; i < ARRAY_SIZE(patterns); i++)
+    {
+        snprintf(path, sizeof(path), "%s\\%s", link_dir, patterns[i]);
+        if ((find = FindFirstFileA(path, &data)) == INVALID_HANDLE_VALUE) continue;
+        do
+        {
+            char *slash;
+            if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+            snprintf(path, sizeof(path), "%s\\%s", link_dir, patterns[i]);
+            if ((slash = strrchr(path, '\\'))) slash[1] = 0;
+            if (strlen(path) + strlen(data.cFileName) < sizeof(path)) strcat(path, data.cFileName);
+            DeleteFileA(path);
+        } while (FindNextFileA(find, &data));
+        FindClose(find);
+    }
+}
