+/* Stained Glass OS 1664: a program's jump list on its button -- the
+ * categories and tasks it committed (ICustomDestinationList), else the
+ * documents it opened -- read through shell32's private SGJumpList* */
+#define SG_BTN_JUMP 0x1000
+
+struct sg_jump_api
+{
+    HRESULT (WINAPI *load)( const WCHAR *, const WCHAR *, void ** );
+    UINT (WINAPI *count)( void * );
+    BOOL (WINAPI *entry)( void *, UINT, int *, WCHAR *, UINT );
+    HRESULT (WINAPI *invoke)( void *, UINT, HWND );
+    void (WINAPI *release)( void * );
+};
+
+static const struct sg_jump_api *sg_jump_api(void)
+{
+    static struct sg_jump_api api;
+    static BOOL tried;
+    HMODULE shell32;
+
+    if (!tried)
+    {
+        tried = TRUE;
+        if ((shell32 = LoadLibraryW( L"shell32.dll" )))
+        {
+            api.load = (void *)GetProcAddress( shell32, "SGJumpListLoad" );
+            api.count = (void *)GetProcAddress( shell32, "SGJumpListCount" );
+            api.entry = (void *)GetProcAddress( shell32, "SGJumpListEntry" );
+            api.invoke = (void *)GetProcAddress( shell32, "SGJumpListInvoke" );
+            api.release = (void *)GetProcAddress( shell32, "SGJumpListFree" );
+        }
+    }
+    return api.load && api.count && api.entry && api.invoke && api.release ? &api : NULL;
+}
+
+/* the list's entries go first in the menu; returns the list (or NULL) */
+static void *sg_jump_menu( HMENU menu, const WCHAR *appid, const WCHAR *exe )
+{
+    const struct sg_jump_api *api = sg_jump_api();
+    WCHAR title[MAX_PATH];
+    void *view = NULL;
+    UINT count, i;
+    int kind;
+
+#ifdef SG_MUTANT_NO_JUMP_MENU
+    return NULL;
+#endif
+    if (!api || FAILED(api->load( appid, exe, &view )) || !view) return NULL;
+    if (!(count = api->count( view )))
+    {
+        api->release( view );
+        return NULL;
+    }
+    for (i = 0; i < count && i < 0x800; i++)
+    {
+        if (!api->entry( view, i, &kind, title, ARRAY_SIZE(title) )) continue;
+        if (kind == 2) AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+        else if (kind == 0) AppendMenuW( menu, MF_STRING | MF_DISABLED, 0, title );
+        else AppendMenuW( menu, MF_STRING, SG_BTN_JUMP + i, title[0] ? title : L"(untitled)" );
+    }
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    return view;
+}
+
+static void sg_jump_done( void *view, int cmd )
+{
+    const struct sg_jump_api *api = sg_jump_api();
+
+    if (!view || !api) return;
+    if (cmd >= SG_BTN_JUMP && cmd < SG_BTN_JUMP + 0x800) api->invoke( view, cmd - SG_BTN_JUMP, NULL );
+    api->release( view );
+}
