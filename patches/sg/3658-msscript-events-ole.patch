new file mode 100644
--- /dev/null
+++ b/dlls/msscript.ocx/tests/sgcalls.c
@@ -0,0 +1,396 @@
+/*
+ * Stained Glass OS additions: script control events, connection points and
+ * the OLE object methods that containers call.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define COBJMACROS
+#define CONST_VTABLE
+
+#include <ole2.h>
+#include <olectl.h>
+
+#include "msscript.h"
+#include "wine/test.h"
+
+struct sink {
+    IDispatch IDispatch_iface;
+    LONG ref;
+    int errors, timeouts;
+    BOOL clear_error;
+    IScriptControl *sc;
+    HRESULT err_number;
+};
+
+static struct sink *impl_sink(IDispatch *iface)
+{
+    return CONTAINING_RECORD(iface, struct sink, IDispatch_iface);
+}
+
+static HRESULT WINAPI sink_QI(IDispatch *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IDispatch) || IsEqualIID(riid, &IID_IUnknown)
+            || IsEqualIID(riid, &DIID_DScriptControlSource))
+    {
+        *obj = iface;
+        IDispatch_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI sink_AddRef(IDispatch *iface)
+{
+    return InterlockedIncrement(&impl_sink(iface)->ref);
+}
+
+static ULONG WINAPI sink_Release(IDispatch *iface)
+{
+    return InterlockedDecrement(&impl_sink(iface)->ref);
+}
+
+static HRESULT WINAPI sink_GetTypeInfoCount(IDispatch *iface, UINT *count)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI sink_GetTypeInfo(IDispatch *iface, UINT index, LCID lcid, ITypeInfo **ti)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI sink_GetIDsOfNames(IDispatch *iface, REFIID riid, LPOLESTR *names, UINT cnames,
+        LCID lcid, DISPID *dispid)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI sink_Invoke(IDispatch *iface, DISPID dispid, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *dp, VARIANT *res, EXCEPINFO *ei, UINT *arg_err)
+{
+    struct sink *This = impl_sink(iface);
+
+    ok(flags == DISPATCH_METHOD, "flags %#x\n", flags);
+    ok(dp && !dp->cArgs, "unexpected args\n");
+    if (dispid == 0xbb8)
+    {
+        IScriptError *err;
+
+        This->errors++;
+        if (This->sc && SUCCEEDED(IScriptControl_get_Error(This->sc, &err)))
+        {
+            LONG num = 0;
+            IScriptError_get_Number(err, &num);
+            This->err_number = num;
+            IScriptError_Release(err);
+        }
+    }
+    else if (dispid == 0xbb9)
+        This->timeouts++;
+    else
+        ok(0, "unexpected dispid %#lx\n", dispid);
+    return S_OK;
+}
+
+static const IDispatchVtbl sinkvtbl = {
+    sink_QI, sink_AddRef, sink_Release, sink_GetTypeInfoCount, sink_GetTypeInfo,
+    sink_GetIDsOfNames, sink_Invoke
+};
+
+static void test_events(void)
+{
+    IConnectionPointContainer *cpc;
+    IConnectionPoint *cp, *cp2;
+    IEnumConnectionPoints *ecp;
+    IEnumConnections *ec;
+    CONNECTDATA cd;
+    IScriptControl *sc;
+    struct sink s1 = { { &sinkvtbl }, 1 }, s2 = { { &sinkvtbl }, 1 };
+    DWORD c1, c2, fetched;
+    VARIANT res;
+    BSTR str;
+    HRESULT hr;
+    IOleControl *oc;
+
+    hr = CoCreateInstance(&CLSID_ScriptControl, NULL, CLSCTX_INPROC_SERVER, &IID_IScriptControl, (void **)&sc);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IScriptControl_QueryInterface(sc, &IID_IConnectionPointContainer, (void **)&cpc);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IConnectionPointContainer_FindConnectionPoint(cpc, &DIID_DScriptControlSource, &cp);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    /* enumerate the connection points */
+    hr = IConnectionPointContainer_EnumConnectionPoints(cpc, &ecp);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    fetched = 0;
+    hr = IEnumConnectionPoints_Next(ecp, 1, &cp2, &fetched);
+    ok(hr == S_OK && fetched == 1, "got %#lx %lu\n", hr, fetched);
+    IConnectionPoint_Release(cp2);
+    hr = IEnumConnectionPoints_Next(ecp, 1, &cp2, &fetched);
+    ok(hr == S_OK && fetched == 1, "got %#lx %lu\n", hr, fetched);
+    IConnectionPoint_Release(cp2);
+    hr = IEnumConnectionPoints_Next(ecp, 1, &cp2, &fetched);
+    ok(hr == S_FALSE && !fetched, "got %#lx %lu\n", hr, fetched);
+    hr = IEnumConnectionPoints_Reset(ecp);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IEnumConnectionPoints_Skip(ecp, 1);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IEnumConnectionPoints_Release(ecp);
+
+    /* Advise / Unadvise */
+    hr = IConnectionPoint_Advise(cp, NULL, &c1);
+    ok(hr == E_POINTER, "got %#lx\n", hr);
+    hr = IConnectionPoint_Advise(cp, (IUnknown *)&s1.IDispatch_iface, &c1);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(c1 != 0, "no cookie\n");
+    hr = IConnectionPoint_Advise(cp, (IUnknown *)&s2.IDispatch_iface, &c2);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(c2 != c1, "same cookie\n");
+    ok(s1.ref == 2 && s2.ref == 2, "refs %ld %ld\n", s1.ref, s2.ref);
+
+    hr = IConnectionPoint_EnumConnections(cp, &ec);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IEnumConnections_Next(ec, 1, &cd, &fetched);
+    ok(hr == S_OK && cd.dwCookie == c1, "got %#lx %lu\n", hr, cd.dwCookie);
+    IUnknown_Release(cd.pUnk);
+    hr = IEnumConnections_Next(ec, 1, &cd, &fetched);
+    ok(hr == S_OK && cd.dwCookie == c2, "got %#lx %lu\n", hr, cd.dwCookie);
+    IUnknown_Release(cd.pUnk);
+    hr = IEnumConnections_Next(ec, 1, &cd, &fetched);
+    ok(hr == S_FALSE, "got %#lx\n", hr);
+    IEnumConnections_Release(ec);
+
+    /* errors in script fire the Error event on every sink */
+    s1.sc = sc;
+    str = SysAllocString(L"JScript");
+    hr = IScriptControl_put_Language(sc, str);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    SysFreeString(str);
+    str = SysAllocString(L"1 +");
+    VariantInit(&res);
+    hr = IScriptControl_Eval(sc, str, &res);
+    ok(FAILED(hr), "got %#lx\n", hr);
+    SysFreeString(str);
+    ok(s1.errors == 1 && s2.errors == 1, "error events %d %d\n", s1.errors, s2.errors);
+    ok(s1.err_number != 0, "Error object not filled during the event\n");
+
+    /* frozen events are not delivered */
+    hr = IScriptControl_QueryInterface(sc, &IID_IOleControl, (void **)&oc);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IOleControl_FreezeEvents(oc, TRUE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    str = SysAllocString(L"1 +");
+    hr = IScriptControl_Eval(sc, str, &res);
+    ok(FAILED(hr), "got %#lx\n", hr);
+    ok(s1.errors == 1, "event delivered while frozen: %d\n", s1.errors);
+    hr = IOleControl_FreezeEvents(oc, FALSE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IScriptControl_Eval(sc, str, &res);
+    ok(FAILED(hr), "got %#lx\n", hr);
+    SysFreeString(str);
+    ok(s1.errors == 2 && s2.errors == 2, "error events %d %d\n", s1.errors, s2.errors);
+    IOleControl_Release(oc);
+
+    /* Unadvise */
+    hr = IConnectionPoint_Unadvise(cp, c1);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IConnectionPoint_Unadvise(cp, c1);
+    ok(hr == CONNECT_E_NOCONNECTION, "got %#lx\n", hr);
+    ok(s1.ref == 1, "ref %ld\n", s1.ref);
+    str = SysAllocString(L"1 +");
+    hr = IScriptControl_Eval(sc, str, &res);
+    SysFreeString(str);
+    ok(s1.errors == 2 && s2.errors == 3, "error events %d %d\n", s1.errors, s2.errors);
+
+    /* a sink without the outgoing interface is refused */
+    hr = IConnectionPoint_Advise(cp, (IUnknown *)cp, &c1);
+    ok(hr == CONNECT_E_CANNOTCONNECT, "got %#lx\n", hr);
+
+    IConnectionPoint_Unadvise(cp, c2);
+    IConnectionPoint_Release(cp);
+    IConnectionPointContainer_Release(cpc);
+    IScriptControl_Release(sc);
+    ok(s2.ref == 1, "ref %ld\n", s2.ref);
+}
+
+static HRESULT WINAPI site_QI(IOleClientSite *iface, REFIID riid, void **obj)
+{
+    *obj = NULL;
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IOleClientSite)) *obj = iface;
+    if (!*obj) return E_NOINTERFACE;
+    return S_OK;
+}
+static ULONG WINAPI site_AddRef(IOleClientSite *iface) { return 2; }
+static ULONG WINAPI site_Release(IOleClientSite *iface) { return 1; }
+static HRESULT WINAPI site_Nop(IOleClientSite *iface) { return E_NOTIMPL; }
+static HRESULT WINAPI site_GetMoniker(IOleClientSite *iface, DWORD a, DWORD w, IMoniker **m) { return E_NOTIMPL; }
+static HRESULT WINAPI site_GetContainer(IOleClientSite *iface, IOleContainer **c) { return E_NOTIMPL; }
+static HRESULT WINAPI site_ShowObject(IOleClientSite *iface) { return S_OK; }
+static HRESULT WINAPI site_OnShowWindow(IOleClientSite *iface, BOOL show) { return S_OK; }
+static const IOleClientSiteVtbl sitevtbl = {
+    site_QI, site_AddRef, site_Release, site_Nop, site_GetMoniker, site_GetContainer, site_ShowObject,
+    site_OnShowWindow, site_Nop
+};
+
+static LONG sink_changes, sink_closes;
+static HRESULT WINAPI adv_QI(IAdviseSink *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IAdviseSink)) { *obj = iface; return S_OK; }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI adv_AddRef(IAdviseSink *iface) { return 2; }
+static ULONG WINAPI adv_Release(IAdviseSink *iface) { return 1; }
+static void WINAPI adv_OnDataChange(IAdviseSink *iface, FORMATETC *f, STGMEDIUM *m) { }
+static void WINAPI adv_OnViewChange(IAdviseSink *iface, DWORD aspect, LONG index) { sink_changes++; }
+static void WINAPI adv_OnRename(IAdviseSink *iface, IMoniker *m) { }
+static void WINAPI adv_OnSave(IAdviseSink *iface) { }
+static void WINAPI adv_OnClose(IAdviseSink *iface) { sink_closes++; }
+static const IAdviseSinkVtbl advvtbl = {
+    adv_QI, adv_AddRef, adv_Release, adv_OnDataChange, adv_OnViewChange, adv_OnRename, adv_OnSave, adv_OnClose
+};
+
+static void test_oleobject(void)
+{
+    IOleClientSite site = { &sitevtbl };
+    IAdviseSink adv = { &advvtbl };
+    IOleObject *obj;
+    IViewObject *view;
+    IPersistStreamInit *psi;
+    IQuickActivate *qa;
+    IEnumOLEVERB *ev;
+    IEnumSTATDATA *esd;
+    IMoniker *mk;
+    LPOLESTR type;
+    CLSID clsid;
+    SIZEL ext;
+    DWORD cookie;
+    QACONTAINER qac;
+    QACONTROL qc;
+    struct sink qsink = { { &sinkvtbl }, 1 };
+    HRESULT hr;
+
+    hr = CoCreateInstance(&CLSID_ScriptControl, NULL, CLSCTX_INPROC_SERVER, &IID_IOleObject, (void **)&obj);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    hr = IOleObject_SetHostNames(obj, L"app", L"doc");
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IOleObject_Update(obj);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IOleObject_IsUpToDate(obj);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    memset(&clsid, 0, sizeof(clsid));
+    hr = IOleObject_GetUserClassID(obj, &clsid);
+    ok(hr == S_OK && IsEqualCLSID(&clsid, &CLSID_ScriptControl), "got %#lx %s\n", hr, wine_dbgstr_guid(&clsid));
+
+    hr = IOleObject_GetMoniker(obj, OLEGETMONIKER_ONLYIFTHERE, OLEWHICHMK_OBJFULL, &mk);
+    ok(hr == E_NOTIMPL || hr == E_FAIL || hr == OLE_E_NOTRUNNING, "got %#lx\n", hr);
+
+    hr = IOleObject_GetUserType(obj, USERCLASSTYPE_FULL, &type);
+    ok(hr == S_OK || hr == REGDB_E_CLASSNOTREG, "got %#lx\n", hr);
+    if (hr == S_OK) CoTaskMemFree(type);
+
+    hr = IOleObject_EnumVerbs(obj, &ev);
+    ok(hr == S_OK || hr == OLEOBJ_E_NOVERBS, "got %#lx\n", hr);
+    if (hr == S_OK) IEnumOLEVERB_Release(ev);
+
+    hr = IOleObject_DoVerb(obj, OLEIVERB_HIDE, NULL, &site, 0, NULL, NULL);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IOleObject_DoVerb(obj, 1234, NULL, &site, 0, NULL, NULL);
+    ok(hr == OLEOBJ_E_INVALIDVERB, "got %#lx\n", hr);
+
+    /* extent */
+    ext.cx = 1000; ext.cy = 2000;
+    hr = IOleObject_SetExtent(obj, DVASPECT_ICON, &ext);
+    ok(hr == DV_E_DVASPECT, "got %#lx\n", hr);
+    hr = IOleObject_SetExtent(obj, DVASPECT_CONTENT, &ext);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    memset(&ext, 0, sizeof(ext));
+    hr = IOleObject_GetExtent(obj, DVASPECT_CONTENT, &ext);
+    ok(hr == S_OK && ext.cx == 1000 && ext.cy == 2000, "got %#lx %ld %ld\n", hr, ext.cx, ext.cy);
+
+    hr = IOleObject_QueryInterface(obj, &IID_IPersistStreamInit, (void **)&psi);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IPersistStreamInit_GetClassID(psi, &clsid);
+    ok(hr == S_OK && IsEqualCLSID(&clsid, &CLSID_ScriptControl), "got %#lx\n", hr);
+    hr = IPersistStreamInit_IsDirty(psi);
+    ok(hr == S_OK, "dirty after SetExtent: %#lx\n", hr);
+    IPersistStreamInit_Release(psi);
+
+    /* the view sink is told about extent changes */
+    hr = IOleObject_QueryInterface(obj, &IID_IViewObject, (void **)&view);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IViewObject_SetAdvise(view, DVASPECT_CONTENT, 0, &adv);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    sink_changes = 0;
+    hr = IOleObject_SetExtent(obj, DVASPECT_CONTENT, &ext);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(sink_changes == 1, "OnViewChange %ld\n", sink_changes);
+    IViewObject_SetAdvise(view, DVASPECT_CONTENT, 0, NULL);
+    IViewObject_Release(view);
+
+    /* advise holder */
+    hr = IOleObject_Advise(obj, &adv, &cookie);
+    ok(hr == S_OK && cookie, "got %#lx %lu\n", hr, cookie);
+    hr = IOleObject_EnumAdvise(obj, &esd);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IEnumSTATDATA_Release(esd);
+    sink_closes = 0;
+    hr = IOleObject_Close(obj, OLECLOSE_NOSAVE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(sink_closes == 1, "OnClose %ld\n", sink_closes);
+    hr = IOleObject_Close(obj, 77);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    hr = IOleObject_Unadvise(obj, cookie);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IOleObject_Unadvise(obj, cookie);
+    ok(FAILED(hr), "got %#lx\n", hr);
+
+    /* quick activate */
+    hr = IOleObject_QueryInterface(obj, &IID_IQuickActivate, (void **)&qa);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    memset(&qac, 0, sizeof(qac));
+    memset(&qc, 0, sizeof(qc));
+    hr = IQuickActivate_QuickActivate(qa, &qac, &qc);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    qac.cbSize = sizeof(qac);
+    qc.cbSize = sizeof(qc);
+    qac.pClientSite = &site;
+    qac.pUnkEventSink = (IUnknown *)&qsink.IDispatch_iface;
+    hr = IQuickActivate_QuickActivate(qa, &qac, &qc);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(qc.dwEventCookie != 0, "no event cookie\n");
+    ok(qsink.ref == 2, "event sink ref %ld\n", qsink.ref);
+    ok(qc.dwViewStatus == VIEWSTATUS_OPAQUE, "view status %#lx\n", qc.dwViewStatus);
+    ok(qc.dwMiscStatus != 0, "no misc status\n");
+    {
+        IOleClientSite *got = NULL;
+
+        hr = IOleObject_GetClientSite(obj, &got);
+        ok(hr == S_OK && got == &site, "got %#lx %p\n", hr, got);
+    }
+    ext.cx = 3000; ext.cy = 4000;
+    hr = IQuickActivate_SetContentExtent(qa, &ext);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    memset(&ext, 0, sizeof(ext));
+    hr = IQuickActivate_GetContentExtent(qa, &ext);
+    ok(hr == S_OK && ext.cx == 3000 && ext.cy == 4000, "got %#lx %ld %ld\n", hr, ext.cx, ext.cy);
+    IQuickActivate_Release(qa);
+
+    IOleObject_Release(obj);
+    ok(qsink.ref == 1, "event sink leaked: %ld\n", qsink.ref);
+}
