+
+static HRESULT WINAPI conn_enum_QueryInterface(IEnumConnections *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumConnections))
+    {
+        *ppv = iface;
+        IEnumConnections_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI conn_enum_AddRef(IEnumConnections *iface)
+{
+    return InterlockedIncrement(&conn_enum_from_iface(iface)->ref);
+}
+
+static ULONG WINAPI conn_enum_Release(IEnumConnections *iface)
+{
+    struct conn_enum *This = conn_enum_from_iface(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    unsigned int i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) IUnknown_Release(This->conns[i].pUnk);
+        free(This->conns);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI conn_enum_Next(IEnumConnections *iface, ULONG count, CONNECTDATA *out, ULONG *fetched)
+{
+    struct conn_enum *This = conn_enum_from_iface(iface);
+    ULONG n = 0;
+
+    if (!out || (!fetched && count != 1)) return E_POINTER;
+    while (n < count && This->pos < This->count)
+    {
+        out[n] = This->conns[This->pos++];
+        IUnknown_AddRef(out[n].pUnk);
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI conn_enum_Skip(IEnumConnections *iface, ULONG count)
+{
+    struct conn_enum *This = conn_enum_from_iface(iface);
+
+    This->pos += count;
+    if (This->pos > This->count)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI conn_enum_Reset(IEnumConnections *iface)
+{
+    conn_enum_from_iface(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI conn_enum_Clone(IEnumConnections *iface, IEnumConnections **out)
+{
+    struct conn_enum *This = conn_enum_from_iface(iface), *e;
+    unsigned int i;
+
+    if (!out) return E_POINTER;
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
+    if (This->count && !(e->conns = malloc(This->count * sizeof(*e->conns))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    e->IEnumConnections_iface.lpVtbl = &conn_enum_vtbl;
+    e->ref = 1;
+    e->count = This->count;
+    e->pos = This->pos;
+    for (i = 0; i < e->count; i++)
+    {
+        e->conns[i] = This->conns[i];
+        IUnknown_AddRef(e->conns[i].pUnk);
+    }
+    *out = &e->IEnumConnections_iface;
+    return S_OK;
+}
