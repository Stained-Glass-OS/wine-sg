+struct sink {
+    IDispatch IDispatch_iface;
+    LONG ref;
+    int errors, timeouts;
+    BOOL clear_error;
+    IScriptControl *sc;
+    HRESULT err_number;
+};
+
+static struct sink *impl_sink(IDispatch *iface)
+{
+    return CONTAINING_RECORD(iface, struct sink, IDispatch_iface);
+}
+
+static HRESULT WINAPI sink_QI(IDispatch *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IDispatch) || IsEqualIID(riid, &IID_IUnknown)
+            || IsEqualIID(riid, &DIID_DScriptControlSource))
+    {
+        *obj = iface;
+        IDispatch_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI sink_AddRef(IDispatch *iface)
+{
+    return InterlockedIncrement(&impl_sink(iface)->ref);
+}
+
+static ULONG WINAPI sink_Release(IDispatch *iface)
+{
+    return InterlockedDecrement(&impl_sink(iface)->ref);
+}
+
+static HRESULT WINAPI sink_GetTypeInfoCount(IDispatch *iface, UINT *count)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI sink_GetTypeInfo(IDispatch *iface, UINT index, LCID lcid, ITypeInfo **ti)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI sink_GetIDsOfNames(IDispatch *iface, REFIID riid, LPOLESTR *names, UINT cnames,
+        LCID lcid, DISPID *dispid)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI sink_Invoke(IDispatch *iface, DISPID dispid, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *dp, VARIANT *res, EXCEPINFO *ei, UINT *arg_err)
+{
+    struct sink *This = impl_sink(iface);
+
+    ok(flags == DISPATCH_METHOD, "flags %#x\n", flags);
+    ok(dp && !dp->cArgs, "unexpected args\n");
+    if (dispid == 0xbb8)
+    {
+        IScriptError *err;
+
+        This->errors++;
+        if (This->sc && SUCCEEDED(IScriptControl_get_Error(This->sc, &err)))
+        {
+            LONG num = 0;
+            IScriptError_get_Number(err, &num);
+            This->err_number = num;
+            IScriptError_Release(err);
+        }
+    }
+    else if (dispid == 0xbb9)
+        This->timeouts++;
+    else
+        ok(0, "unexpected dispid %#lx\n", dispid);
+    return S_OK;
+}
+
+static const IDispatchVtbl sinkvtbl = {
+    sink_QI, sink_AddRef, sink_Release, sink_GetTypeInfoCount, sink_GetTypeInfo,
+    sink_GetIDsOfNames, sink_Invoke
+};
+
+static void test_events(void)
+{
+    IConnectionPointContainer *cpc;
+    IConnectionPoint *cp, *cp2;
+    IEnumConnectionPoints *ecp;
+    IEnumConnections *ec;
+    CONNECTDATA cd;
+    IScriptControl *sc;
+    struct sink s1 = { { &sinkvtbl }, 1 }, s2 = { { &sinkvtbl }, 1 };
+    DWORD c1, c2, fetched;
+    VARIANT res;
+    BSTR str;
+    HRESULT hr;
+    IOleControl *oc;
+
+    hr = CoCreateInstance(&CLSID_ScriptControl, NULL, CLSCTX_INPROC_SERVER, &IID_IScriptControl, (void **)&sc);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IScriptControl_QueryInterface(sc, &IID_IConnectionPointContainer, (void **)&cpc);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IConnectionPointContainer_FindConnectionPoint(cpc, &DIID_DScriptControlSource, &cp);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    /* enumerate the connection points */
+    hr = IConnectionPointContainer_EnumConnectionPoints(cpc, &ecp);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    fetched = 0;
+    hr = IEnumConnectionPoints_Next(ecp, 1, &cp2, &fetched);
+    ok(hr == S_OK && fetched == 1, "got %#lx %lu\n", hr, fetched);
+    IConnectionPoint_Release(cp2);
+    hr = IEnumConnectionPoints_Next(ecp, 1, &cp2, &fetched);
+    ok(hr == S_OK && fetched == 1, "got %#lx %lu\n", hr, fetched);
+    IConnectionPoint_Release(cp2);
+    hr = IEnumConnectionPoints_Next(ecp, 1, &cp2, &fetched);
+    ok(hr == S_FALSE && !fetched, "got %#lx %lu\n", hr, fetched);
+    hr = IEnumConnectionPoints_Reset(ecp);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IEnumConnectionPoints_Skip(ecp, 1);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IEnumConnectionPoints_Release(ecp);
+
+    /* Advise / Unadvise */
+    hr = IConnectionPoint_Advise(cp, NULL, &c1);
+    ok(hr == E_POINTER, "got %#lx\n", hr);
+    hr = IConnectionPoint_Advise(cp, (IUnknown *)&s1.IDispatch_iface, &c1);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(c1 != 0, "no cookie\n");
+    hr = IConnectionPoint_Advise(cp, (IUnknown *)&s2.IDispatch_iface, &c2);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(c2 != c1, "same cookie\n");
+    ok(s1.ref == 2 && s2.ref == 2, "refs %ld %ld\n", s1.ref, s2.ref);
+
+    hr = IConnectionPoint_EnumConnections(cp, &ec);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IEnumConnections_Next(ec, 1, &cd, &fetched);
+    ok(hr == S_OK && cd.dwCookie == c1, "got %#lx %lu\n", hr, cd.dwCookie);
+    IUnknown_Release(cd.pUnk);
+    hr = IEnumConnections_Next(ec, 1, &cd, &fetched);
+    ok(hr == S_OK && cd.dwCookie == c2, "got %#lx %lu\n", hr, cd.dwCookie);
+    IUnknown_Release(cd.pUnk);
+    hr = IEnumConnections_Next(ec, 1, &cd, &fetched);
+    ok(hr == S_FALSE, "got %#lx\n", hr);
+    IEnumConnections_Release(ec);
+
+    /* errors in script fire the Error event on every sink */
+    s1.sc = sc;
+    str = SysAllocString(L"JScript");
+    hr = IScriptControl_put_Language(sc, str);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    SysFreeString(str);
+    str = SysAllocString(L"1 +");
+    VariantInit(&res);
+    hr = IScriptControl_Eval(sc, str, &res);
+    ok(FAILED(hr), "got %#lx\n", hr);
+    SysFreeString(str);
+    ok(s1.errors == 1 && s2.errors == 1, "error events %d %d\n", s1.errors, s2.errors);
+    ok(s1.err_number != 0, "Error object not filled during the event\n");
+
+    /* frozen events are not delivered */
+    hr = IScriptControl_QueryInterface(sc, &IID_IOleControl, (void **)&oc);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IOleControl_FreezeEvents(oc, TRUE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    str = SysAllocString(L"1 +");
+    hr = IScriptControl_Eval(sc, str, &res);
+    ok(FAILED(hr), "got %#lx\n", hr);
+    ok(s1.errors == 1, "event delivered while frozen: %d\n", s1.errors);
+    hr = IOleControl_FreezeEvents(oc, FALSE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IScriptControl_Eval(sc, str, &res);
+    ok(FAILED(hr), "got %#lx\n", hr);
+    SysFreeString(str);
+    ok(s1.errors == 2 && s2.errors == 2, "error events %d %d\n", s1.errors, s2.errors);
+    IOleControl_Release(oc);
+
+    /* Unadvise */
+    hr = IConnectionPoint_Unadvise(cp, c1);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IConnectionPoint_Unadvise(cp, c1);
+    ok(hr == CONNECT_E_NOCONNECTION, "got %#lx\n", hr);
+    ok(s1.ref == 1, "ref %ld\n", s1.ref);
+    str = SysAllocString(L"1 +");
+    hr = IScriptControl_Eval(sc, str, &res);
+    SysFreeString(str);
+    ok(s1.errors == 2 && s2.errors == 3, "error events %d %d\n", s1.errors, s2.errors);
+
+    /* a sink without the outgoing interface is refused */
+    hr = IConnectionPoint_Advise(cp, (IUnknown *)cp, &c1);
+    ok(hr == CONNECT_E_CANNOTCONNECT, "got %#lx\n", hr);
+
+    IConnectionPoint_Unadvise(cp, c2);
+    IConnectionPoint_Release(cp);
+    IConnectionPointContainer_Release(cpc);
+    IScriptControl_Release(sc);
+    ok(s2.ref == 1, "ref %ld\n", s2.ref);
+}
