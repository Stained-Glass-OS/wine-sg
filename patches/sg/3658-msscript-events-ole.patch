+}
+static ULONG WINAPI adv_AddRef(IAdviseSink *iface) { return 2; }
+static ULONG WINAPI adv_Release(IAdviseSink *iface) { return 1; }
+static void WINAPI adv_OnDataChange(IAdviseSink *iface, FORMATETC *f, STGMEDIUM *m) { }
+static void WINAPI adv_OnViewChange(IAdviseSink *iface, DWORD aspect, LONG index) { sink_changes++; }
+static void WINAPI adv_OnRename(IAdviseSink *iface, IMoniker *m) { }
+static void WINAPI adv_OnSave(IAdviseSink *iface) { }
+static void WINAPI adv_OnClose(IAdviseSink *iface) { sink_closes++; }
+static const IAdviseSinkVtbl advvtbl = {
+    adv_QI, adv_AddRef, adv_Release, adv_OnDataChange, adv_OnViewChange, adv_OnRename, adv_OnSave, adv_OnClose
+};
+
+static void test_oleobject(void)
+{
+    IOleClientSite site = { &sitevtbl };
+    IAdviseSink adv = { &advvtbl };
+    IOleObject *obj;
+    IViewObject *view;
+    IPersistStreamInit *psi;
+    IQuickActivate *qa;
+    IEnumOLEVERB *ev;
+    IEnumSTATDATA *esd;
+    IMoniker *mk;
+    LPOLESTR type;
+    CLSID clsid;
+    SIZEL ext;
+    DWORD cookie;
+    QACONTAINER qac;
+    QACONTROL qc;
+    struct sink qsink = { { &sinkvtbl }, 1 };
+    HRESULT hr;
+
+    hr = CoCreateInstance(&CLSID_ScriptControl, NULL, CLSCTX_INPROC_SERVER, &IID_IOleObject, (void **)&obj);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    hr = IOleObject_SetHostNames(obj, L"app", L"doc");
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IOleObject_Update(obj);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IOleObject_IsUpToDate(obj);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    memset(&clsid, 0, sizeof(clsid));
+    hr = IOleObject_GetUserClassID(obj, &clsid);
+    ok(hr == S_OK && IsEqualCLSID(&clsid, &CLSID_ScriptControl), "got %#lx %s\n", hr, wine_dbgstr_guid(&clsid));
+
+    hr = IOleObject_GetMoniker(obj, OLEGETMONIKER_ONLYIFTHERE, OLEWHICHMK_OBJFULL, &mk);
+    ok(hr == E_NOTIMPL || hr == E_FAIL || hr == OLE_E_NOTRUNNING, "got %#lx\n", hr);
+
+    hr = IOleObject_GetUserType(obj, USERCLASSTYPE_FULL, &type);
+    ok(hr == S_OK || hr == REGDB_E_CLASSNOTREG, "got %#lx\n", hr);
+    if (hr == S_OK) CoTaskMemFree(type);
+
+    hr = IOleObject_EnumVerbs(obj, &ev);
+    ok(hr == S_OK || hr == OLEOBJ_E_NOVERBS, "got %#lx\n", hr);
+    if (hr == S_OK) IEnumOLEVERB_Release(ev);
+
+    hr = IOleObject_DoVerb(obj, OLEIVERB_HIDE, NULL, &site, 0, NULL, NULL);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IOleObject_DoVerb(obj, 1234, NULL, &site, 0, NULL, NULL);
+    ok(hr == OLEOBJ_E_INVALIDVERB, "got %#lx\n", hr);
+
+    /* extent */
+    ext.cx = 1000; ext.cy = 2000;
+    hr = IOleObject_SetExtent(obj, DVASPECT_ICON, &ext);
+    ok(hr == DV_E_DVASPECT, "got %#lx\n", hr);
+    hr = IOleObject_SetExtent(obj, DVASPECT_CONTENT, &ext);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    memset(&ext, 0, sizeof(ext));
+    hr = IOleObject_GetExtent(obj, DVASPECT_CONTENT, &ext);
+    ok(hr == S_OK && ext.cx == 1000 && ext.cy == 2000, "got %#lx %ld %ld\n", hr, ext.cx, ext.cy);
+
+    hr = IOleObject_QueryInterface(obj, &IID_IPersistStreamInit, (void **)&psi);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IPersistStreamInit_GetClassID(psi, &clsid);
+    ok(hr == S_OK && IsEqualCLSID(&clsid, &CLSID_ScriptControl), "got %#lx\n", hr);
+    hr = IPersistStreamInit_IsDirty(psi);
+    ok(hr == S_OK, "dirty after SetExtent: %#lx\n", hr);
+    IPersistStreamInit_Release(psi);
+
+    /* the view sink is told about extent changes */
+    hr = IOleObject_QueryInterface(obj, &IID_IViewObject, (void **)&view);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IViewObject_SetAdvise(view, DVASPECT_CONTENT, 0, &adv);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    sink_changes = 0;
+    hr = IOleObject_SetExtent(obj, DVASPECT_CONTENT, &ext);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(sink_changes == 1, "OnViewChange %ld\n", sink_changes);
+    IViewObject_SetAdvise(view, DVASPECT_CONTENT, 0, NULL);
+    IViewObject_Release(view);
+
+    /* advise holder */
+    hr = IOleObject_Advise(obj, &adv, &cookie);
+    ok(hr == S_OK && cookie, "got %#lx %lu\n", hr, cookie);
+    hr = IOleObject_EnumAdvise(obj, &esd);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IEnumSTATDATA_Release(esd);
+    sink_closes = 0;
+    hr = IOleObject_Close(obj, OLECLOSE_NOSAVE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(sink_closes == 1, "OnClose %ld\n", sink_closes);
+    hr = IOleObject_Close(obj, 77);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    hr = IOleObject_Unadvise(obj, cookie);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IOleObject_Unadvise(obj, cookie);
+    ok(FAILED(hr), "got %#lx\n", hr);
+
+    /* quick activate */
+    hr = IOleObject_QueryInterface(obj, &IID_IQuickActivate, (void **)&qa);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    memset(&qac, 0, sizeof(qac));
+    memset(&qc, 0, sizeof(qc));
+    hr = IQuickActivate_QuickActivate(qa, &qac, &qc);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    qac.cbSize = sizeof(qac);
+    qc.cbSize = sizeof(qc);
+    qac.pClientSite = &site;
+    qac.pUnkEventSink = (IUnknown *)&qsink.IDispatch_iface;
+    hr = IQuickActivate_QuickActivate(qa, &qac, &qc);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(qc.dwEventCookie != 0, "no event cookie\n");
+    ok(qsink.ref == 2, "event sink ref %ld\n", qsink.ref);
+    ok(qc.dwViewStatus == VIEWSTATUS_OPAQUE, "view status %#lx\n", qc.dwViewStatus);
+    ok(qc.dwMiscStatus != 0, "no misc status\n");
+    {
+        IOleClientSite *got = NULL;
+
+        hr = IOleObject_GetClientSite(obj, &got);
+        ok(hr == S_OK && got == &site, "got %#lx %p\n", hr, got);
+    }
+    ext.cx = 3000; ext.cy = 4000;
+    hr = IQuickActivate_SetContentExtent(qa, &ext);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    memset(&ext, 0, sizeof(ext));
+    hr = IQuickActivate_GetContentExtent(qa, &ext);
+    ok(hr == S_OK && ext.cx == 3000 && ext.cy == 4000, "got %#lx %ld %ld\n", hr, ext.cx, ext.cy);
+    IQuickActivate_Release(qa);
+
+    IOleObject_Release(obj);
+    ok(qsink.ref == 1, "event sink leaked: %ld\n", qsink.ref);
+}
+
+START_TEST(sgcalls)
+{
+    CoInitialize(NULL);
+    test_events();
+    test_oleobject();
+    CoUninitialize();
+}
