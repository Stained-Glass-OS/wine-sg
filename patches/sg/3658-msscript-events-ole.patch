+#define DISPID_SCRIPTCONTROL_ERROR   0x0bb8
+#define DISPID_SCRIPTCONTROL_TIMEOUT 0x0bb9
+
+static HRESULT cp_add_sink(ConnectionPoint *cp, IUnknown *sink, DWORD *cookie)
+{
+    struct cp_sink *new;
+
+    new = realloc(cp->sinks, (cp->sink_count + 1) * sizeof(*new));
+    if (!new) return E_OUTOFMEMORY;
+    cp->sinks = new;
+    IUnknown_AddRef(sink);
+    new[cp->sink_count].unk = sink;
+    new[cp->sink_count].cookie = ++cp->next_cookie;
+    *cookie = new[cp->sink_count].cookie;
+    cp->sink_count++;
+    return S_OK;
+}
+
+static void cp_free_sinks(ConnectionPoint *cp)
+{
+    unsigned int i;
+
+    for (i = 0; i < cp->sink_count; i++)
+        IUnknown_Release(cp->sinks[i].unk);
+    free(cp->sinks);
+    cp->sinks = NULL;
+    cp->sink_count = 0;
+}
+
+/* Calls a no-argument event of DScriptControlSource on every connected sink. */
+static void fire_event(ScriptControl *control, DISPID dispid)
+{
+    ConnectionPoint *cp = &control->cp_scsource;
+    DISPPARAMS dp = { 0 };
+    IDispatch **copy;
+    unsigned int i, count = cp->sink_count;
+
+#ifdef SG_MUTANT_MS_FREEZE
+    if (!count) return;
+#else
+    if (control->freeze_events > 0 || !count) return;
+#endif
+
+    /* the sink list may change while handlers run: work on a referenced copy */
+    if (!(copy = malloc(count * sizeof(*copy)))) return;
+    for (i = 0; i < count; i++)
+    {
+        copy[i] = (IDispatch *)cp->sinks[i].unk;
+        IDispatch_AddRef(copy[i]);
+    }
+    IScriptControl_AddRef(&control->IScriptControl_iface);
+    for (i = 0; i < count; i++)
+    {
+        VARIANT res;
+        HRESULT hr;
+
+        VariantInit(&res);
+        hr = IDispatch_Invoke(copy[i], dispid, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &dp, &res, NULL, NULL);
+        TRACE("event %#lx -> sink %p: %#lx\n", dispid, copy[i], hr);
+        VariantClear(&res);
+        IDispatch_Release(copy[i]);
+    }
+    free(copy);
+    IScriptControl_Release(&control->IScriptControl_iface);
+}
