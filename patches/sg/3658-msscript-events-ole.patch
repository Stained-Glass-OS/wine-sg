+struct cp_enum {
+    IEnumConnectionPoints IEnumConnectionPoints_iface;
+    LONG ref;
+    ScriptControl *control;
+    unsigned int pos;
+};
+
+static const IEnumConnectionPointsVtbl cp_enum_vtbl;
+
+static inline struct cp_enum *cp_enum_from_iface(IEnumConnectionPoints *iface)
+{
+    return CONTAINING_RECORD(iface, struct cp_enum, IEnumConnectionPoints_iface);
+}
+
+static HRESULT WINAPI cp_enum_QueryInterface(IEnumConnectionPoints *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumConnectionPoints))
+    {
+        *ppv = iface;
+        IEnumConnectionPoints_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI cp_enum_AddRef(IEnumConnectionPoints *iface)
+{
+    return InterlockedIncrement(&cp_enum_from_iface(iface)->ref);
+}
+
+static ULONG WINAPI cp_enum_Release(IEnumConnectionPoints *iface)
+{
+    struct cp_enum *This = cp_enum_from_iface(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        IScriptControl_Release(&This->control->IScriptControl_iface);
+        free(This);
+    }
+    return ref;
+}
+
+/* connection points in the order the control registered them */
+static ConnectionPoint *cp_enum_get(ScriptControl *control, unsigned int index)
+{
+    ConnectionPoint *cp;
+    unsigned int total = 0;
+
+    for (cp = control->cp_list; cp; cp = cp->next) total++;
+    if (index >= total) return NULL;
+    index = total - 1 - index;
+    for (cp = control->cp_list; cp && index; cp = cp->next) index--;
+    return cp;
+}
+
+static HRESULT WINAPI cp_enum_Next(IEnumConnectionPoints *iface, ULONG count, IConnectionPoint **cps, ULONG *fetched)
+{
+    struct cp_enum *This = cp_enum_from_iface(iface);
+    ULONG n = 0;
+    ConnectionPoint *cp;
+
+    TRACE("(%p)->(%lu %p %p)\n", This, count, cps, fetched);
+
+    if (!cps || (!fetched && count != 1)) return E_POINTER;
+    while (n < count && (cp = cp_enum_get(This->control, This->pos)))
+    {
+        cps[n] = &cp->IConnectionPoint_iface;
+        IConnectionPoint_AddRef(cps[n]);
+        n++;
+        This->pos++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI cp_enum_Skip(IEnumConnectionPoints *iface, ULONG count)
+{
+    struct cp_enum *This = cp_enum_from_iface(iface);
+
+    This->pos += count;
+    return cp_enum_get(This->control, This->pos) || !count ? S_OK : S_FALSE;
+}
