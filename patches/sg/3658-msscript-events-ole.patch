+++ b/dlls/msscript.ocx/msscript.c
@@ -708,13 +708,32 @@ static HRESULT WINAPI ActiveScriptSite_GetItemInfo(IActiveScriptSite *iface, LPC
     if (!item)
         return TYPE_E_ELEMENTNOTFOUND;
 
-    if (mask != SCRIPTINFO_IUNKNOWN) {
-        FIXME("mask %#lx is not supported\n", mask);
-        return E_NOTIMPL;
+    if (mask & ~(SCRIPTINFO_IUNKNOWN | SCRIPTINFO_ITYPEINFO)) {
+        WARN("mask %#lx is not supported\n", mask);
+        return E_INVALIDARG;
     }
 
-    *unk = (IUnknown*)item->disp;
-    IUnknown_AddRef(*unk);
+    if (mask & SCRIPTINFO_IUNKNOWN) {
+        if (!unk) return E_POINTER;
+        *unk = NULL;
+    }
+#ifndef SG_MUTANT_MS_TYPEINFO
+    if (mask & SCRIPTINFO_ITYPEINFO) {
+        HRESULT hr;
+
+        if (!ti) return E_POINTER;
+        *ti = NULL;
+        hr = IDispatch_GetTypeInfo(item->disp, 0, LOCALE_USER_DEFAULT, ti);
+        if (FAILED(hr)) {
+            *ti = NULL;
+            return TYPE_E_ELEMENTNOTFOUND;
+        }
+    }
+#endif
+    if (mask & SCRIPTINFO_IUNKNOWN) {
+        *unk = (IUnknown*)item->disp;
+        IUnknown_AddRef(*unk);
+    }
 
     return S_OK;
 }
