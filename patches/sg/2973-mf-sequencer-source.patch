+struct seq_topology
+{
+    struct list entry;
+    MFSequencerElementId id;
+    DWORD flags;
+    IMFTopology *topology;
 };
 
 static inline struct topology *impl_from_IMFTopology(IMFTopology *iface)
@@ -116,6 +133,11 @@ static struct seq_source *impl_from_IMFSequencerSource(IMFSequencerSource *iface
     return CONTAINING_RECORD(iface, struct seq_source, IMFSequencerSource_iface);
 }
 
+static struct seq_source *impl_from_IMFMediaSourceEx(IMFMediaSourceEx *iface)
+{
+    return CONTAINING_RECORD(iface, struct seq_source, IMFMediaSourceEx_iface);
+}
+
 static struct seq_source *impl_from_IMFMediaSourceTopologyProvider(IMFMediaSourceTopologyProvider *iface)
 {
     return CONTAINING_RECORD(iface, struct seq_source, IMFMediaSourceTopologyProvider_iface);
@@ -2075,6 +2097,32 @@ HRESULT WINAPI MFGetTopoNodeCurrentType(IMFTopologyNode *node, DWORD stream, BOO
     return hr;
 }
 
+/* MFSequencerTopologyFlags: SequencerTopologyFlags_Last is not in every header set. */
+#define SEQ_TOPOLOGY_FLAG_LAST 0x1
+
+/* Private attribute stored on presentation descriptors handed out by the sequencer source. */
+static const GUID SG_SEQUENCER_PD_ELEMENT_ID = {0x3a7d5b0e, 0x6c41, 0x4f9a, {0x8e, 0x12, 0x5d, 0x0b, 0x77, 0x2c, 0x91, 0x4a}};
+
+static struct seq_topology *seq_source_find_topology(struct seq_source *source, MFSequencerElementId id)
+{
+    struct seq_topology *entry;
+
+    LIST_FOR_EACH_ENTRY(entry, &source->topologies, struct seq_topology, entry)
+    {
+        if (entry->id == id)
+            return entry;
+    }
+
+    return NULL;
+}
+
+static void seq_source_free_topology(struct seq_topology *entry)
+{
+    list_remove(&entry->entry);
+    IMFTopology_Release(entry->topology);
+    free(entry);
+}
+
 static HRESULT WINAPI seq_source_QueryInterface(IMFSequencerSource *iface, REFIID riid, void **out)
 {
     struct seq_source *seq_source = impl_from_IMFSequencerSource(iface);
@@ -2092,6 +2140,12 @@ static HRESULT WINAPI seq_source_QueryInterface(IMFSequencerSource *iface, REFII
     {
         *out = &seq_source->IMFMediaSourceTopologyProvider_iface;
     }
+    else if (IsEqualIID(riid, &IID_IMFMediaSourceEx) ||
+            IsEqualIID(riid, &IID_IMFMediaSource) ||
+            IsEqualIID(riid, &IID_IMFMediaEventGenerator))
+    {
+        *out = &seq_source->IMFMediaSourceEx_iface;
+    }
     else
     {
         WARN("Unimplemented %s.\n", debugstr_guid(riid));
@@ -2118,51 +2172,196 @@ static ULONG WINAPI seq_source_Release(IMFSequencerSource *iface)
 {
     struct seq_source *seq_source = impl_from_IMFSequencerSource(iface);
     ULONG refcount = InterlockedDecrement(&seq_source->refcount);
+    struct seq_topology *entry, *next;
 
     TRACE("%p, refcount %lu.\n", iface, refcount);
 
     if (!refcount)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE(entry, next, &seq_source->topologies, struct seq_topology, entry)
+            seq_source_free_topology(entry);
+        if (seq_source->event_queue)
+            IMFMediaEventQueue_Release(seq_source->event_queue);
+        if (seq_source->attributes)
+            IMFAttributes_Release(seq_source->attributes);
+        seq_source->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&seq_source->cs);
         free(seq_source);
+    }
 
     return refcount;
 }
 
+/* Queue semantics (Microsoft documentation of IMFSequencerSource): topologies are played in the order
+ * they were appended; SEQ_TOPOLOGY_FLAG_LAST marks the final one. Element ids are opaque. */
 static HRESULT WINAPI seq_source_AppendTopology(IMFSequencerSource *iface, IMFTopology *topology,
         DWORD flags, MFSequencerElementId *id)
 {
-    FIXME("%p, %p, %lx, %p.\n", iface, topology, flags, id);
+    struct seq_source *source = impl_from_IMFSequencerSource(iface);
+    struct seq_topology *entry, *last;
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p, %lx, %p.\n", iface, topology, flags, id);
+
+    if (!topology)
+        return E_INVALIDARG;
+    if (!id)
+        return E_POINTER;
+    if (flags & ~SEQ_TOPOLOGY_FLAG_LAST)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else if (!list_empty(&source->topologies)
+            && (last = LIST_ENTRY(list_tail(&source->topologies), struct seq_topology, entry))
+            && (last->flags & SEQ_TOPOLOGY_FLAG_LAST)
+#ifdef SG_MUTANT_SEQ_APPEND_AFTER_LAST
+            && 0
+#endif
+            )
+        hr = MF_E_INVALIDREQUEST;
+    else if (!(entry = calloc(1, sizeof(*entry))))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+#ifdef SG_MUTANT_SEQ_ID_SAME
+        entry->id = source->next_id;
+#else
+        entry->id = source->next_id++;
+#endif
+        entry->flags = flags;
+        entry->topology = topology;
+        IMFTopology_AddRef(topology);
+        list_add_tail(&source->topologies, &entry->entry);
+        *id = entry->id;
+    }
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI seq_source_DeleteTopology(IMFSequencerSource *iface, MFSequencerElementId id)
 {
-    FIXME("%p, %#lx.\n", iface, id);
+    struct seq_source *source = impl_from_IMFSequencerSource(iface);
+    struct seq_topology *entry;
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p, %#lx.\n", iface, id);
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else if (!(entry = seq_source_find_topology(source, id)))
+        hr = MF_E_NOT_FOUND;
+    else
+        seq_source_free_topology(entry);
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT seq_source_lookup_pd(struct seq_source *source, IMFPresentationDescriptor *pd,
+        MFSequencerElementId *id, IMFTopology **topology)
+{
+    struct seq_topology *entry;
+    UINT32 value;
+
+    if (FAILED(IMFPresentationDescriptor_GetUINT32(pd, &SG_SEQUENCER_PD_ELEMENT_ID, &value)))
+        return MF_E_NOT_FOUND;
+    if (!(entry = seq_source_find_topology(source, value)))
+        return MF_E_NOT_FOUND;
+
+    *id = entry->id;
+    if (topology)
+    {
+        *topology = entry->topology;
+        IMFTopology_AddRef(*topology);
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI seq_source_GetPresentationContext(IMFSequencerSource *iface,
         IMFPresentationDescriptor *descriptor, MFSequencerElementId *id, IMFTopology **topology)
 {
-    FIXME("%p, %p, %p, %p.\n", iface, descriptor, id, topology);
+    struct seq_source *source = impl_from_IMFSequencerSource(iface);
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p, %p, %p.\n", iface, descriptor, id, topology);
+
+    if (!descriptor)
+        return E_INVALIDARG;
+    if (!id)
+        return E_POINTER;
+
+    if (topology)
+        *topology = NULL;
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else
+        hr = seq_source_lookup_pd(source, descriptor, id, topology);
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI seq_source_UpdateTopology(IMFSequencerSource *iface, MFSequencerElementId id,
         IMFTopology *topology)
 {
-    FIXME("%p, %#lx, %p.\n", iface, id, topology);
+    struct seq_source *source = impl_from_IMFSequencerSource(iface);
+    struct seq_topology *entry;
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p, %#lx, %p.\n", iface, id, topology);
+
+    if (!topology)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else if (!(entry = seq_source_find_topology(source, id)))
+        hr = MF_E_NOT_FOUND;
+    else
+    {
+#ifndef SG_MUTANT_SEQ_UPDATE_NOOP
+        IMFTopology_AddRef(topology);
+        IMFTopology_Release(entry->topology);
+        entry->topology = topology;
+#endif
+    }
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI seq_source_UpdateTopologyFlags(IMFSequencerSource *iface, MFSequencerElementId id, DWORD flags)
 {
-    FIXME("%p, %#lx, %#lx.\n", iface, id, flags);
+    struct seq_source *source = impl_from_IMFSequencerSource(iface);
+    struct seq_topology *entry;
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p, %#lx, %#lx.\n", iface, id, flags);
+
+    if (flags & ~SEQ_TOPOLOGY_FLAG_LAST)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else if (!(entry = seq_source_find_topology(source, id)))
+        hr = MF_E_NOT_FOUND;
+    else
+#ifdef SG_MUTANT_SEQ_FLAGS_IGNORED
+        entry->flags = entry->flags;
+#else
+        entry->flags = flags;
+#endif
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI seq_source_topology_provider_QueryInterface(IMFMediaSourceTopologyProvider *iface, REFIID riid,
@@ -2187,9 +2386,27 @@ static ULONG WINAPI seq_source_topology_provider_Release(IMFMediaSourceTopologyP
 static HRESULT WINAPI seq_source_topology_provider_GetMediaSourceTopology(IMFMediaSourceTopologyProvider *iface,
         IMFPresentationDescriptor *pd, IMFTopology **topology)
 {
-    FIXME("%p, %p, %p.\n", iface, pd, topology);
+    struct seq_source *source = impl_from_IMFMediaSourceTopologyProvider(iface);
+    MFSequencerElementId id;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p, %p.\n", iface, pd, topology);
+
+    if (!pd)
+        return E_INVALIDARG;
+    if (!topology)
+        return E_POINTER;
