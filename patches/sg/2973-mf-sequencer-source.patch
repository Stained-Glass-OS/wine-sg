+    struct list topologies;
+    MFSequencerElementId next_id;
+    IMFMediaEventQueue *event_queue;
+    IMFAttributes *attributes;
+    enum { SEQ_SOURCE_STOPPED, SEQ_SOURCE_STARTED, SEQ_SOURCE_PAUSED } state;
+    BOOL shutdown;
