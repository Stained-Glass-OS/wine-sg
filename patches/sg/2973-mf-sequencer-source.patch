+    return hr;
 }
 
 static const IMFMediaSourceTopologyProviderVtbl seq_source_topology_provider_vtbl =
@@ -2212,12 +2429,370 @@ static const IMFSequencerSourceVtbl seqsourcevtbl =
     seq_source_UpdateTopologyFlags,
 };
 
+static HRESULT WINAPI seq_source_ex_QueryInterface(IMFMediaSourceEx *iface, REFIID riid, void **out)
+{
+    return seq_source_QueryInterface(&impl_from_IMFMediaSourceEx(iface)->IMFSequencerSource_iface, riid, out);
+}
+
+static ULONG WINAPI seq_source_ex_AddRef(IMFMediaSourceEx *iface)
+{
+    return seq_source_AddRef(&impl_from_IMFMediaSourceEx(iface)->IMFSequencerSource_iface);
+}
+
+static ULONG WINAPI seq_source_ex_Release(IMFMediaSourceEx *iface)
+{
+    return seq_source_Release(&impl_from_IMFMediaSourceEx(iface)->IMFSequencerSource_iface);
+}
+
+static HRESULT WINAPI seq_source_ex_GetEvent(IMFMediaSourceEx *iface, DWORD flags, IMFMediaEvent **event)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    IMFMediaEventQueue *queue;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %#lx, %p.\n", iface, flags, event);
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        queue = source->event_queue;
+        IMFMediaEventQueue_AddRef(queue);
+    }
+    LeaveCriticalSection(&source->cs);
+    if (FAILED(hr))
+        return hr;
+
+    hr = IMFMediaEventQueue_GetEvent(queue, flags, event);
+    IMFMediaEventQueue_Release(queue);
+    return hr;
+}
+
+static HRESULT WINAPI seq_source_ex_BeginGetEvent(IMFMediaSourceEx *iface, IMFAsyncCallback *callback, IUnknown *state)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    HRESULT hr;
+
+    TRACE("%p, %p, %p.\n", iface, callback, state);
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else
+        hr = IMFMediaEventQueue_BeginGetEvent(source->event_queue, callback, state);
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI seq_source_ex_EndGetEvent(IMFMediaSourceEx *iface, IMFAsyncResult *result, IMFMediaEvent **event)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    HRESULT hr;
+
+    TRACE("%p, %p, %p.\n", iface, result, event);
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else
+        hr = IMFMediaEventQueue_EndGetEvent(source->event_queue, result, event);
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI seq_source_ex_QueueEvent(IMFMediaSourceEx *iface, MediaEventType event_type,
+        REFGUID ext_type, HRESULT hr, const PROPVARIANT *value)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    HRESULT ret;
+
+    TRACE("%p, %ld, %s, %#lx, %p.\n", iface, event_type, debugstr_guid(ext_type), hr, value);
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        ret = MF_E_SHUTDOWN;
+    else
+        ret = IMFMediaEventQueue_QueueEventParamVar(source->event_queue, event_type, ext_type, hr, value);
+    LeaveCriticalSection(&source->cs);
+
+    return ret;
+}
+
+static HRESULT WINAPI seq_source_ex_GetCharacteristics(IMFMediaSourceEx *iface, DWORD *characteristics)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p.\n", iface, characteristics);
+
+    if (!characteristics)
+        return E_POINTER;
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else
+        *characteristics = MFMEDIASOURCE_CAN_PAUSE | MFMEDIASOURCE_CAN_SEEK;
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+/* The descriptor of a topology is a copy of the one on its first source node (a descriptor cannot be
+ * empty), tagged with the element id so that the presentation context can be found again. */
+static HRESULT seq_source_create_pd(struct seq_topology *entry, IMFPresentationDescriptor **pd)
+{
+    IMFPresentationDescriptor *node_pd = NULL;
+    IMFCollection *nodes;
+    IMFTopologyNode *node;
+    IUnknown *unk = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFTopology_GetSourceNodeCollection(entry->topology, &nodes)))
+        return hr;
+    hr = IMFCollection_GetElement(nodes, 0, &unk);
+    IMFCollection_Release(nodes);
+    if (FAILED(hr))
+        return MF_E_INVALIDREQUEST;
+
+    hr = IUnknown_QueryInterface(unk, &IID_IMFTopologyNode, (void **)&node);
+    IUnknown_Release(unk);
+    if (FAILED(hr))
+        return MF_E_INVALIDREQUEST;
+    hr = IMFTopologyNode_GetUnknown(node, &MF_TOPONODE_PRESENTATION_DESCRIPTOR, &IID_IMFPresentationDescriptor,
+            (void **)&node_pd);
+    IMFTopologyNode_Release(node);
+    if (FAILED(hr))
+        return MF_E_INVALIDREQUEST;
+
+    hr = IMFPresentationDescriptor_Clone(node_pd, pd);
+    IMFPresentationDescriptor_Release(node_pd);
+    if (FAILED(hr))
+        return hr;
+    if (FAILED(hr = IMFPresentationDescriptor_SetUINT32(*pd, &SG_SEQUENCER_PD_ELEMENT_ID, entry->id)))
+    {
+        IMFPresentationDescriptor_Release(*pd);
+        *pd = NULL;
+    }
+    return hr;
+}
+
+static HRESULT WINAPI seq_source_ex_CreatePresentationDescriptor(IMFMediaSourceEx *iface,
+        IMFPresentationDescriptor **pd)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    struct seq_topology *first;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, pd);
+
+    if (!pd)
+        return E_POINTER;
+
+    *pd = NULL;
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else if (list_empty(&source->topologies))
+        hr = MF_E_NOT_INITIALIZED;
+    else
+    {
+        first = LIST_ENTRY(list_head(&source->topologies), struct seq_topology, entry);
+        hr = seq_source_create_pd(first, pd);
+    }
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI seq_source_ex_Start(IMFMediaSourceEx *iface, IMFPresentationDescriptor *pd,
+        const GUID *time_format, const PROPVARIANT *position)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    MFSequencerElementId id;
+    PROPVARIANT empty;
+    HRESULT hr;
+
+    TRACE("%p, %p, %s, %p.\n", iface, pd, debugstr_guid(time_format), position);
+
+    if (!pd || !position)
+        return E_INVALIDARG;
+    if (time_format && !IsEqualGUID(time_format, &GUID_NULL))
+        return MF_E_UNSUPPORTED_TIME_FORMAT;
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else if (FAILED(seq_source_lookup_pd(source, pd, &id, NULL)))
+        hr = E_INVALIDARG;
+    else
+    {
+        PropVariantInit(&empty);
+        /* No stream objects exist in this implementation: only the state change is reported. */
+        hr = IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourceStarted, &GUID_NULL, S_OK,
+                position->vt == VT_EMPTY ? &empty : position);
+        if (SUCCEEDED(hr))
+            source->state = SEQ_SOURCE_STARTED;
+    }
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI seq_source_ex_Stop(IMFMediaSourceEx *iface)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    HRESULT hr;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else if (source->state == SEQ_SOURCE_STOPPED
+#ifdef SG_MUTANT_SEQ_STOP_IDLE_OK
+            && 0
+#endif
+            )
+        hr = MF_E_INVALID_STATE_TRANSITION;
+    else if (SUCCEEDED(hr = IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourceStopped,
+            &GUID_NULL, S_OK, NULL)))
+        source->state = SEQ_SOURCE_STOPPED;
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI seq_source_ex_Pause(IMFMediaSourceEx *iface)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    HRESULT hr;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else if (source->state == SEQ_SOURCE_STOPPED)
+        hr = MF_E_INVALID_STATE_TRANSITION;
+    else if (SUCCEEDED(hr = IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourcePaused,
+            &GUID_NULL, S_OK, NULL)))
+        source->state = SEQ_SOURCE_PAUSED;
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI seq_source_ex_Shutdown(IMFMediaSourceEx *iface)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        source->shutdown = TRUE;
+        IMFMediaEventQueue_Shutdown(source->event_queue);
+    }
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI seq_source_ex_GetSourceAttributes(IMFMediaSourceEx *iface, IMFAttributes **attributes)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p.\n", iface, attributes);
+
+    if (!attributes)
+        return E_POINTER;
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        *attributes = source->attributes;
+        IMFAttributes_AddRef(*attributes);
+    }
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI seq_source_ex_GetStreamAttributes(IMFMediaSourceEx *iface, DWORD stream_id,
+        IMFAttributes **attributes)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    HRESULT hr;
+
+    TRACE("%p, %#lx, %p.\n", iface, stream_id, attributes);
+
+    if (!attributes)
+        return E_POINTER;
+
+    *attributes = NULL;
+
+    EnterCriticalSection(&source->cs);
+    /* This source exposes no streams of its own, so every identifier is unknown. */
+    hr = source->shutdown ? MF_E_SHUTDOWN : MF_E_INVALIDSTREAMNUMBER;
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI seq_source_ex_SetD3DManager(IMFMediaSourceEx *iface, IUnknown *manager)
+{
+    struct seq_source *source = impl_from_IMFMediaSourceEx(iface);
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, manager);
+
+    EnterCriticalSection(&source->cs);
+    /* Sources that do not decode do not use a DXGI/D3D manager and report it as unsupported. */
+    hr = source->shutdown ? MF_E_SHUTDOWN : E_NOTIMPL;
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
