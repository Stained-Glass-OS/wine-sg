+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "wincrypt.h"
+#include "corerror.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL( mscoree );
+
+/* hash the bytes with the algorithm *alg (0: SHA-1, and it is reported back) */
+static HRESULT hash_bytes( const BYTE *data, DWORD size, DWORD *alg, BYTE *out, DWORD out_size, DWORD *out_len )
+{
+    HCRYPTPROV prov;
+    HCRYPTHASH hash;
+    DWORD len = sizeof(DWORD), hash_size, id = *alg;
+    BYTE digest[64];
+    HRESULT hr = S_OK;
+
+#ifndef SG_MUTANT_HASH_DEFAULT
+    if (!id) id = CALG_SHA1;
+#endif
+
+    if (!CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_AES, CRYPT_VERIFYCONTEXT ))
+        return HRESULT_FROM_WIN32( GetLastError() );
+    if (!CryptCreateHash( prov, id, 0, 0, &hash ))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        CryptReleaseContext( prov, 0 );
+        return hr;
+    }
+
+    if (!CryptGetHashParam( hash, HP_HASHSIZE, (BYTE *)&hash_size, &len, 0 ) ||
+        !CryptHashData( hash, data, size, 0 ))
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+    else
+    {
+        *alg = id;
+        *out_len = hash_size;
+#ifndef SG_MUTANT_HASH_SIZE
+        if (out_size < hash_size) hr = HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+        else
+#else
+        if (0) hr = S_OK;
+        else
+#endif
+        {
+            len = sizeof(digest);
+            if (CryptGetHashParam( hash, HP_HASHVAL, digest, &len, 0 )) memcpy( out, digest, hash_size );
+            else hr = HRESULT_FROM_WIN32( GetLastError() );
+        }
+    }
+    CryptDestroyHash( hash );
+    CryptReleaseContext( prov, 0 );
+    return hr;
+}
+
+static HRESULT hash_handle( HANDLE file, DWORD *alg, BYTE *out, DWORD out_size, DWORD *out_len )
+{
+    LARGE_INTEGER size;
+    BYTE *data;
+    DWORD read;
+    HRESULT hr;
+
+    if (!GetFileSizeEx( file, &size ) || size.QuadPart > 0x7fffffff) return HRESULT_FROM_WIN32( GetLastError() );
+    if (!(data = malloc( size.u.LowPart ? size.u.LowPart : 1 ))) return E_OUTOFMEMORY;
+#ifndef SG_MUTANT_HASH_FILE
+    if (SetFilePointer( file, 0, NULL, FILE_BEGIN ) == INVALID_SET_FILE_POINTER ||
+#else
+    if (0 ||
+#endif
+        !ReadFile( file, data, size.u.LowPart, &read, NULL ) || read != size.u.LowPart)
+        hr = HRESULT_FROM_WIN32( GetLastError() ? GetLastError() : ERROR_READ_FAULT );
+    else
+        hr = hash_bytes( data, read, alg, out, out_size, out_len );
+    free( data );
+    return hr;
+}
+
+HRESULT WINAPI GetHashFromBlob( BYTE *blob, DWORD blob_len, DWORD *alg, BYTE *out, DWORD out_size, DWORD *out_len )
+{
+    TRACE( "(%p, %lu, %p, %p, %lu, %p)\n", blob, blob_len, alg, out, out_size, out_len );
+
+    if (!blob || !alg || !out_len) return E_POINTER;
+    return hash_bytes( blob, blob_len, alg, out, out_size, out_len );
+}
+
+HRESULT WINAPI GetHashFromHandle( HANDLE file, DWORD *alg, BYTE *out, DWORD out_size, DWORD *out_len )
+{
+    TRACE( "(%p, %p, %p, %lu, %p)\n", file, alg, out, out_size, out_len );
+
+    if (!alg || !out_len) return E_POINTER;
+    return hash_handle( file, alg, out, out_size, out_len );
+}
+
+HRESULT WINAPI GetHashFromFileW( const WCHAR *path, DWORD *alg, BYTE *out, DWORD out_size, DWORD *out_len )
+{
+    HANDLE file;
+    HRESULT hr;
+
+    TRACE( "(%s, %p, %p, %lu, %p)\n", debugstr_w(path), alg, out, out_size, out_len );
+
+    if (!path || !alg || !out_len) return E_POINTER;
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+    hr = hash_handle( file, alg, out, out_size, out_len );
+    CloseHandle( file );
+    return hr;
+}
+
+HRESULT WINAPI GetHashFromFile( const char *path, DWORD *alg, BYTE *out, DWORD out_size, DWORD *out_len )
+{
+    WCHAR *wpath;
+    int len;
+    HRESULT hr;
+
+    TRACE( "(%s, %p, %p, %lu, %p)\n", debugstr_a(path), alg, out, out_size, out_len );
+
+    if (!path || !alg || !out_len) return E_POINTER;
+    len = MultiByteToWideChar( CP_ACP, 0, path, -1, NULL, 0 );
+    if (!(wpath = malloc( len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    MultiByteToWideChar( CP_ACP, 0, path, -1, wpath, len );
+    hr = GetHashFromFileW( wpath, alg, out, out_size, out_len );
+    free( wpath );
+    return hr;
+}
+
+HRESULT WINAPI GetHashFromAssemblyFileW( const WCHAR *path, DWORD *alg, BYTE *out, DWORD out_size, DWORD *out_len )
+{
+    TRACE( "(%s, %p, %p, %lu, %p)\n", debugstr_w(path), alg, out, out_size, out_len );
+    return GetHashFromFileW( path, alg, out, out_size, out_len );
+}
+
+HRESULT WINAPI GetHashFromAssemblyFile( const char *path, DWORD *alg, BYTE *out, DWORD out_size, DWORD *out_len )
+{
+    TRACE( "(%s, %p, %p, %lu, %p)\n", debugstr_a(path), alg, out, out_size, out_len );
+    return GetHashFromFile( path, alg, out, out_size, out_len );
+}
