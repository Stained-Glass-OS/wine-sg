From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: every display's clock opens the calendar under it (9950)

As on Windows: a click on a taskbar clock opens the calendar under that
clock. The main bar's click (7603) now says which bar it came from
(SgCalendarToggle's lparam, or sg-calendar64.exe --show --bar N), and the
other displays' bars (7751) open it too: their clocks did nothing.
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -3956,18 +3956,28 @@
  * sg-shell's sg-calendar, which the session keeps running hidden, opens or
  * closes on SgCalendarToggle; when none runs yet it is started to show. The
  * flyout may take the foreground: the click was the person's. */
-static void sg_toggle_calendar(void)
+static void sg_toggle_calendar( HWND bar )
 {
     static UINT toggle;
     HWND host;
+    WCHAR args[64];
 
 #ifdef SG_MUTANT_CLOCK_NO_CALENDAR
     return;
 #endif
     if (!toggle) toggle = RegisterWindowMessageW( L"SgCalendarToggle" );
     AllowSetForegroundWindow( ASFW_ANY );
-    if ((host = FindWindowW( L"SgCalendarHost", NULL ))) PostMessageW( host, toggle, 0, 0 );
-    else ShellExecuteW( NULL, NULL, L"Z:\\usr\\libexec\\stained-glass\\shell\\sg-calendar64.exe", L"--show", NULL, SW_SHOWNORMAL );
+    /* 9950: the bar whose clock was clicked goes with it: the calendar opens
+     * under that clock, on that display and edge, as on Windows */
+#ifdef SG_MUTANT_CALENDAR_NO_BAR
+    bar = NULL;
+#endif
+    if ((host = FindWindowW( L"SgCalendarHost", NULL ))) PostMessageW( host, toggle, 0, (LPARAM)bar );
+    else
+    {
+        swprintf( args, ARRAY_SIZE(args), L"--show --bar %lu", HandleToUlong( bar ) );
+        ShellExecuteW( NULL, NULL, L"Z:\\usr\\libexec\\stained-glass\\shell\\sg-calendar64.exe", args, NULL, SW_SHOWNORMAL );
+    }
 }
 
 /* Stained Glass OS: the taskbar clock -- time over date, right-aligned;
@@ -5991,7 +6001,17 @@
         if (bar)
         {
             int i = sg_second_hit( bar, pt );
+            RECT clock;
             sg_hide_thumbnails();
+            /* Stained Glass OS 9950: this display's clock opens the calendar
+             * here, as the main bar's does there (7603) */
+            GetClientRect( hwnd, &clock );
+            if (sg_vertical()) clock.top = clock.bottom - sg_clock_len();
+            else clock.left = clock.right - sg_clock_len();
+#ifndef SG_MUTANT_SECOND_CLOCK_DEAD
+            if (i < 0 && PtInRect( &clock, pt )) sg_toggle_calendar( hwnd );
+            else
+#endif
             if (i == 64)
             {
                 /* Start opens on this display (sg-start places itself on the bar it is given) */
@@ -6655,7 +6675,7 @@
         GetClientRect( hwnd, &rc );
         if (sg_vertical()) rc.top = rc.bottom - sg_clock_len();
         else rc.left = rc.right - sg_clock_len();
-        if (PtInRect( &rc, pt )) sg_toggle_calendar();
+        if (PtInRect( &rc, pt )) sg_toggle_calendar( hwnd );
         break;
     }
 
