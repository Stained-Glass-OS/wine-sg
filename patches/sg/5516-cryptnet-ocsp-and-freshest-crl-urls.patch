From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cryptnet: CryptGetObjectUrl for OCSP and freshest CRL URLs

CryptGetObjectUrl logged "unimplemented" and failed with ERROR_FILE_NOT_FOUND
for most of the URL OIDs. The ones that read a certificate's extensions now
work, as the documentation describes them: URL_OID_CERTIFICATE_ONLY_OCSP (new
constant, value 13 from mingw-w64's wincrypt.h) and URL_OID_CERTIFICATE_OCSP give
the OCSP access locations of the authority information access extension;
URL_OID_CERTIFICATE_OCSP_AND_CRL_DIST_POINT and _CRL_DIST_POINT_AND_OCSP give
those and the CRL distribution point URLs, in that order or the reverse;
URL_OID_CERTIFICATE_FRESHEST_CRL gives the URLs of the freshest CRL extension.
OCSP URLs carry the "ocsp:" prefix the documentation tells callers to remove.
A certificate with none of the extensions is CRYPT_E_NOT_FOUND, only
CRYPT_GET_URL_FROM_EXTENSION (or no flag) selects the extension, a NULL size
pointer is E_INVALIDARG, as for the OIDs that already worked.
---
--- a/dlls/cryptnet/cryptnet_main.c
+++ b/dlls/cryptnet/cryptnet_main.c
@@ -88,6 +88,11 @@ static const char *url_oid_to_str(LPCSTR oid)
         _x(URL_OID_CERTIFICATE_FRESHEST_CRL);
         _x(URL_OID_CRL_FRESHEST_CRL);
         _x(URL_OID_CROSS_CERT_DIST_POINT);
+        _x(URL_OID_CERTIFICATE_OCSP);
+        _x(URL_OID_CERTIFICATE_OCSP_AND_CRL_DIST_POINT);
+        _x(URL_OID_CERTIFICATE_CRL_DIST_POINT_AND_OCSP);
+        _x(URL_OID_CROSS_CERT_SUBJECT_INFO_ACCESS);
+        _x(URL_OID_CERTIFICATE_ONLY_OCSP);
 #undef _x
         default:
             snprintf(buf, sizeof(buf), "%d", LOWORD(oid));
@@ -346,6 +351,205 @@ static BOOL WINAPI CRYPT_GetUrlFromCertificateCRLDistPoint(LPCSTR pszUrlOid,
     return ret;
 }
 
+/* The URLs of the OCSP responders and CRL distribution points of a
+ * certificate, which the OCSP, "freshest CRL" and combined URL OIDs name. */
+struct url_list
+{
+    WCHAR **urls;
+    DWORD count;
+    DWORD chars;        /* with the terminators */
+};
+
+static BOOL url_list_add(struct url_list *list, const WCHAR *prefix, const WCHAR *url)
+{
+    DWORD len = lstrlenW(prefix) + lstrlenW(url) + 1;
+    WCHAR **urls, *copy;
+
+    if (!(urls = realloc(list->urls, (list->count + 1) * sizeof(*urls)))) return FALSE;
+    list->urls = urls;
+    if (!(copy = malloc(len * sizeof(WCHAR)))) return FALSE;
+    lstrcpyW(copy, prefix);
+    lstrcatW(copy, url);
+    list->urls[list->count++] = copy;
+    list->chars += len;
+    return TRUE;
+}
+
+static void url_list_free(struct url_list *list)
+{
+    DWORD i;
+
+    for (i = 0; i < list->count; i++) free(list->urls[i]);
+    free(list->urls);
+}
+
+/* the URL access locations of one access method in the authority information
+ * access extension; ocsp: is put in front of them, as the documentation says
+ * the caller removes */
+static BOOL url_list_add_aia(struct url_list *list, PCCERT_CONTEXT cert, const char *method, const WCHAR *prefix,
+ BOOL *found)
+{
+    CERT_AUTHORITY_INFO_ACCESS *aia;
+    PCERT_EXTENSION ext;
+    DWORD size, i;
+    BOOL ret = TRUE;
+
+    if (!(ext = CertFindExtension(szOID_AUTHORITY_INFO_ACCESS, cert->pCertInfo->cExtension,
+     cert->pCertInfo->rgExtension)))
+        return TRUE;
+    if (!CryptDecodeObjectEx(X509_ASN_ENCODING, X509_AUTHORITY_INFO_ACCESS, ext->Value.pbData, ext->Value.cbData,
+     CRYPT_DECODE_ALLOC_FLAG, NULL, &aia, &size))
+        return FALSE;
+    *found = TRUE;
+    for (i = 0; ret && i < aia->cAccDescr; i++)
+        if (!strcmp(aia->rgAccDescr[i].pszAccessMethod, method) &&
+         aia->rgAccDescr[i].AccessLocation.dwAltNameChoice == CERT_ALT_NAME_URL &&
+         aia->rgAccDescr[i].AccessLocation.pwszURL)
+            ret = url_list_add(list, prefix, aia->rgAccDescr[i].AccessLocation.pwszURL);
+    LocalFree(aia);
+    return ret;
+}
+
+/* the URLs of the full names of a CRL distribution points extension (the
+ * freshest CRL extension is encoded the same way) */
+static BOOL url_list_add_crl_dist_points(struct url_list *list, PCCERT_CONTEXT cert, const char *oid, BOOL *found)
+{
+    CRL_DIST_POINTS_INFO *info;
+    PCERT_EXTENSION ext;
+    DWORD size, i, j;
+    BOOL ret = TRUE;
+
+    if (!(ext = CertFindExtension(oid, cert->pCertInfo->cExtension, cert->pCertInfo->rgExtension)))
+        return TRUE;
+    if (!CryptDecodeObjectEx(X509_ASN_ENCODING, X509_CRL_DIST_POINTS, ext->Value.pbData, ext->Value.cbData,
+     CRYPT_DECODE_ALLOC_FLAG, NULL, &info, &size))
+        return FALSE;
+    *found = TRUE;
+    for (i = 0; ret && i < info->cDistPoint; i++)
+    {
+        CERT_ALT_NAME_INFO *name;
+
+        if (info->rgDistPoint[i].DistPointName.dwDistPointNameChoice != CRL_DIST_POINT_FULL_NAME) continue;
+        name = &info->rgDistPoint[i].DistPointName.FullName;
+        for (j = 0; ret && j < name->cAltEntry; j++)
+            if (name->rgAltEntry[j].dwAltNameChoice == CERT_ALT_NAME_URL && name->rgAltEntry[j].pwszURL)
+                ret = url_list_add(list, L"", name->rgAltEntry[j].pwszURL);
+    }
+    LocalFree(info);
+    return ret;
+}
+
+static BOOL CRYPT_FillUrlArray(const struct url_list *list, PCRYPT_URL_ARRAY pUrlArray, DWORD *pcbUrlArray,
+ PCRYPT_URL_INFO pUrlInfo, DWORD *pcbUrlInfo)
+{
+    DWORD bytes_needed = sizeof(CRYPT_URL_ARRAY) + list->count * sizeof(WCHAR *) + list->chars * sizeof(WCHAR);
+    WCHAR *next;
+    DWORD i;
+
+    if (!pcbUrlArray)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!pUrlArray)
+        *pcbUrlArray = bytes_needed;
+    else if (*pcbUrlArray < bytes_needed)
+    {
+        SetLastError(ERROR_MORE_DATA);
+        *pcbUrlArray = bytes_needed;
+        return FALSE;
+    }
+    else
+    {
+        *pcbUrlArray = bytes_needed;
+        pUrlArray->cUrl = list->count;
+        pUrlArray->rgwszUrl = (WCHAR **)((BYTE *)pUrlArray + sizeof(CRYPT_URL_ARRAY));
+        next = (WCHAR *)((BYTE *)pUrlArray + sizeof(CRYPT_URL_ARRAY) + list->count * sizeof(WCHAR *));
+        for (i = 0; i < list->count; i++)
+        {
+            lstrcpyW(next, list->urls[i]);
+            pUrlArray->rgwszUrl[i] = next;
+            next += lstrlenW(next) + 1;
+        }
+    }
+    if (pcbUrlInfo)
+    {
+        /* what the info should hold (the sync time, the groups) is not documented: empty */
+        if (!pUrlInfo)
+            *pcbUrlInfo = sizeof(CRYPT_URL_INFO);
+        else if (*pcbUrlInfo < sizeof(CRYPT_URL_INFO))
+        {
+            *pcbUrlInfo = sizeof(CRYPT_URL_INFO);
+            SetLastError(ERROR_MORE_DATA);
+            return FALSE;
+        }
+        else
+        {
+            *pcbUrlInfo = sizeof(CRYPT_URL_INFO);
+            memset(pUrlInfo, 0, sizeof(CRYPT_URL_INFO));
+        }
+    }
+    return TRUE;
+}
+
+/* URL_OID_CERTIFICATE_ONLY_OCSP, _OCSP, _OCSP_AND_CRL_DIST_POINT, _CRL_DIST_POINT_AND_OCSP
+ * and URL_OID_CERTIFICATE_FRESHEST_CRL */
+static BOOL WINAPI CRYPT_GetUrlFromCertificateRevocation(LPCSTR pszUrlOid, LPVOID pvPara, DWORD dwFlags,
+ PCRYPT_URL_ARRAY pUrlArray, DWORD *pcbUrlArray, PCRYPT_URL_INFO pUrlInfo, DWORD *pcbUrlInfo, LPVOID pvReserved)
+{
+    PCCERT_CONTEXT cert = pvPara;
+    struct url_list list = {0};
+    BOOL found = FALSE, ocsp = FALSE, crl = FALSE, ocsp_first = FALSE, ret;
+    const char *crl_oid = szOID_CRL_DIST_POINTS;
+
+    /* The only applicable flag is CRYPT_GET_URL_FROM_EXTENSION */
+    if (dwFlags && !(dwFlags & CRYPT_GET_URL_FROM_EXTENSION))
+    {
+        SetLastError(CRYPT_E_NOT_FOUND);
+        return FALSE;
+    }
+    switch (LOWORD(pszUrlOid))
+    {
+    case LOWORD(URL_OID_CERTIFICATE_OCSP):
+    case LOWORD(URL_OID_CERTIFICATE_ONLY_OCSP):
+        ocsp = TRUE;
+        break;
+    case LOWORD(URL_OID_CERTIFICATE_OCSP_AND_CRL_DIST_POINT):
+        ocsp = crl = ocsp_first = TRUE;
+        break;
+    case LOWORD(URL_OID_CERTIFICATE_CRL_DIST_POINT_AND_OCSP):
+        ocsp = crl = TRUE;
+        break;
+    case LOWORD(URL_OID_CERTIFICATE_FRESHEST_CRL):
+        crl = TRUE;
+#ifndef SG_MUTANT_URLS_NO_FRESHEST
+        crl_oid = szOID_FRESHEST_CRL;
+#endif
+        break;
+    }
+
+    ret = TRUE;
+    if (ocsp && ocsp_first)
+#ifdef SG_MUTANT_URLS_NO_PREFIX
+        ret = url_list_add_aia(&list, cert, szOID_PKIX_OCSP, L"", &found);
+#else
+        ret = url_list_add_aia(&list, cert, szOID_PKIX_OCSP, L"ocsp:", &found);
+#endif
+    if (ret && crl)
+        ret = url_list_add_crl_dist_points(&list, cert, crl_oid, &found);
+    if (ret && ocsp && !ocsp_first)
+        ret = url_list_add_aia(&list, cert, szOID_PKIX_OCSP, L"ocsp:", &found);
+    if (ret && !found)
+    {
+        SetLastError(CRYPT_E_NOT_FOUND);
+        ret = FALSE;
+    }
+    if (ret)
+        ret = CRYPT_FillUrlArray(&list, pUrlArray, pcbUrlArray, pUrlInfo, pcbUrlInfo);
+    url_list_free(&list);
+    return ret;
+}
+
 /***********************************************************************
  *    CryptGetObjectUrl (CRYPTNET.@)
  */
@@ -370,6 +574,13 @@ BOOL WINAPI CryptGetObjectUrl(LPCSTR pszUrlOid, LPVOID pvPara, DWORD dwFlags,
         case LOWORD(URL_OID_CERTIFICATE_CRL_DIST_POINT):
             func = CRYPT_GetUrlFromCertificateCRLDistPoint;
             break;
+        case LOWORD(URL_OID_CERTIFICATE_OCSP):
+        case LOWORD(URL_OID_CERTIFICATE_ONLY_OCSP):
+        case LOWORD(URL_OID_CERTIFICATE_OCSP_AND_CRL_DIST_POINT):
+        case LOWORD(URL_OID_CERTIFICATE_CRL_DIST_POINT_AND_OCSP):
+        case LOWORD(URL_OID_CERTIFICATE_FRESHEST_CRL):
+            func = CRYPT_GetUrlFromCertificateRevocation;
+            break;
         default:
             FIXME("unimplemented for %s\n", url_oid_to_str(pszUrlOid));
             SetLastError(ERROR_FILE_NOT_FOUND);
--- a/dlls/cryptnet/tests/cryptnet.c
+++ b/dlls/cryptnet/tests/cryptnet.c
@@ -870,9 +870,194 @@ static void test_verifyRevocation(void)
     CertFreeCertificateContext(certs[0]);
 }
 
+static BYTE *encode_object(LPCSTR type, const void *data, DWORD *size)
+{
+    BYTE *buffer = NULL;
+    BOOL ret = CryptEncodeObjectEx(X509_ASN_ENCODING, type, data, CRYPT_ENCODE_ALLOC_FLAG, NULL, &buffer, size);
+
+    ok(ret, "CryptEncodeObjectEx failed: %08lx\n", GetLastError());
+    return buffer;
+}
+
+/* a certificate with the given extensions; the signature is nothing */
+static PCCERT_CONTEXT make_cert_with_extensions(CERT_EXTENSION *exts, DWORD count)
+{
+    CERT_SIGNED_CONTENT_INFO signed_info = {{0}};
+    CERT_NAME_BLOB name = {0};
+    CERT_INFO info = {0};
+    BYTE serial = 1, key = 0, sig = 0;
+    BYTE *tbs, *cert;
+    DWORD tbs_size, cert_size;
+    PCCERT_CONTEXT context;
+    BOOL ret;
+
+    ret = CertStrToNameA(X509_ASN_ENCODING, "CN=urls", 0, NULL, NULL, &name.cbData, NULL);
+    ok(ret, "CertStrToName failed: %08lx\n", GetLastError());
+    name.pbData = HeapAlloc(GetProcessHeap(), 0, name.cbData);
+    ret = CertStrToNameA(X509_ASN_ENCODING, "CN=urls", 0, NULL, name.pbData, &name.cbData, NULL);
+    ok(ret, "CertStrToName failed: %08lx\n", GetLastError());
+
+    info.dwVersion = CERT_V3;
+    info.SerialNumber.cbData = 1;
+    info.SerialNumber.pbData = &serial;
+    info.SignatureAlgorithm.pszObjId = (char *)szOID_RSA_SHA1RSA;
+    info.Issuer = name;
+    info.Subject = name;
+    info.NotBefore.dwLowDateTime = info.NotAfter.dwLowDateTime = 0;
+    info.NotBefore.dwHighDateTime = info.NotAfter.dwHighDateTime = 0x01c00000;
+    info.SubjectPublicKeyInfo.Algorithm.pszObjId = (char *)szOID_RSA_RSA;
+    info.SubjectPublicKeyInfo.PublicKey.cbData = 1;
+    info.SubjectPublicKeyInfo.PublicKey.pbData = &key;
+    info.cExtension = count;
+    info.rgExtension = exts;
+    tbs = encode_object(X509_CERT_TO_BE_SIGNED, &info, &tbs_size);
+
+    signed_info.ToBeSigned.cbData = tbs_size;
+    signed_info.ToBeSigned.pbData = tbs;
+    signed_info.SignatureAlgorithm.pszObjId = (char *)szOID_RSA_SHA1RSA;
+    signed_info.Signature.cbData = 1;
+    signed_info.Signature.pbData = &sig;
+    cert = encode_object(X509_CERT, &signed_info, &cert_size);
+    context = CertCreateCertificateContext(X509_ASN_ENCODING, cert, cert_size);
+    ok(!!context, "CertCreateCertificateContext failed: %08lx\n", GetLastError());
+    LocalFree(cert);
+    LocalFree(tbs);
+    HeapFree(GetProcessHeap(), 0, name.pbData);
+    return context;
+}
+
+static void check_urls(LPCSTR oid, PCCERT_CONTEXT cert, DWORD flags, const WCHAR *expected[], DWORD count, int line)
+{
+    DWORD size = 0, i;
+    CRYPT_URL_ARRAY *urls;
+    BOOL ret;
+
+    ret = CryptGetObjectUrl(oid, (void *)cert, flags, NULL, &size, NULL, NULL, NULL);
+    ok_(__FILE__, line)(ret, "CryptGetObjectUrl failed: %08lx\n", GetLastError());
+    if (!ret) return;
+    urls = HeapAlloc(GetProcessHeap(), 0, size);
+    ret = CryptGetObjectUrl(oid, (void *)cert, flags, urls, &size, NULL, NULL, NULL);
+    ok_(__FILE__, line)(ret, "CryptGetObjectUrl failed: %08lx\n", GetLastError());
+    if (ret)
+    {
+        ok_(__FILE__, line)(urls->cUrl == count, "Expected %lu URLs, got %lu\n", count, urls->cUrl);
+        for (i = 0; i < min(count, urls->cUrl); i++)
+            ok_(__FILE__, line)(!lstrcmpW(urls->rgwszUrl[i], expected[i]), "%lu: got %s, expected %s\n", i,
+                                wine_dbgstr_w(urls->rgwszUrl[i]), wine_dbgstr_w(expected[i]));
+    }
+    HeapFree(GetProcessHeap(), 0, urls);
+}
+
+static void test_getObjectUrl_revocation(void)
+{
+    static WCHAR crl_url[] = L"http://crl.example/a.crl", fresh_url[] = L"http://crl.example/delta.crl";
+    static WCHAR ocsp_url[] = L"http://ocsp.example/", issuer_url[] = L"http://ca.example/ca.crt";
+    CRL_DIST_POINTS_INFO crl_info, fresh_info;
+    CERT_AUTHORITY_INFO_ACCESS aia;
+    CERT_ACCESS_DESCRIPTION access[2];
+    CERT_ALT_NAME_ENTRY crl_entry, fresh_entry;
+    CRL_DIST_POINT crl_point, fresh_point;
+    CERT_EXTENSION exts[3];
+    BYTE *aia_data, *crl_data, *fresh_data;
+    DWORD size;
+    PCCERT_CONTEXT cert;
+    DWORD info_size;
+    BOOL ret;
+
+    access[0].pszAccessMethod = (char *)szOID_PKIX_CA_ISSUERS;
+    access[0].AccessLocation.dwAltNameChoice = CERT_ALT_NAME_URL;
+    access[0].AccessLocation.pwszURL = issuer_url;
+    access[1].pszAccessMethod = (char *)szOID_PKIX_OCSP;
+    access[1].AccessLocation.dwAltNameChoice = CERT_ALT_NAME_URL;
+    access[1].AccessLocation.pwszURL = ocsp_url;
+    aia.cAccDescr = 2;
+    aia.rgAccDescr = access;
+    aia_data = encode_object(X509_AUTHORITY_INFO_ACCESS, &aia, &size);
+    exts[0].pszObjId = (char *)szOID_AUTHORITY_INFO_ACCESS;
+    exts[0].fCritical = FALSE;
+    exts[0].Value.cbData = size;
+    exts[0].Value.pbData = aia_data;
+
+    crl_entry.dwAltNameChoice = CERT_ALT_NAME_URL;
+    crl_entry.pwszURL = crl_url;
+    memset(&crl_point, 0, sizeof(crl_point));
+    crl_point.DistPointName.dwDistPointNameChoice = CRL_DIST_POINT_FULL_NAME;
+    crl_point.DistPointName.FullName.cAltEntry = 1;
+    crl_point.DistPointName.FullName.rgAltEntry = &crl_entry;
+    crl_info.cDistPoint = 1;
+    crl_info.rgDistPoint = &crl_point;
+    crl_data = encode_object(X509_CRL_DIST_POINTS, &crl_info, &size);
+    exts[1].pszObjId = (char *)szOID_CRL_DIST_POINTS;
+    exts[1].fCritical = FALSE;
+    exts[1].Value.cbData = size;
+    exts[1].Value.pbData = crl_data;
+
+    fresh_entry.dwAltNameChoice = CERT_ALT_NAME_URL;
+    fresh_entry.pwszURL = fresh_url;
+    memset(&fresh_point, 0, sizeof(fresh_point));
+    fresh_point.DistPointName.dwDistPointNameChoice = CRL_DIST_POINT_FULL_NAME;
+    fresh_point.DistPointName.FullName.cAltEntry = 1;
+    fresh_point.DistPointName.FullName.rgAltEntry = &fresh_entry;
+    fresh_info.cDistPoint = 1;
+    fresh_info.rgDistPoint = &fresh_point;
+    fresh_data = encode_object(X509_CRL_DIST_POINTS, &fresh_info, &size);
+    exts[2].pszObjId = (char *)szOID_FRESHEST_CRL;
+    exts[2].fCritical = FALSE;
+    exts[2].Value.cbData = size;
+    exts[2].Value.pbData = fresh_data;
+
+    cert = make_cert_with_extensions(exts, 3);
+    if (cert)
+    {
+        const WCHAR *ocsp[] = { L"ocsp:http://ocsp.example/" };
+        const WCHAR *crl[] = { crl_url };
+        const WCHAR *fresh[] = { fresh_url };
+        const WCHAR *ocsp_crl[] = { L"ocsp:http://ocsp.example/", crl_url };
+        const WCHAR *crl_ocsp[] = { crl_url, L"ocsp:http://ocsp.example/" };
+
+        /* the certificate issuer URL still comes from the CA issuers method */
+        {
+            const WCHAR *issuer[] = { issuer_url };
+            check_urls(URL_OID_CERTIFICATE_ISSUER, cert, 0, issuer, 1, __LINE__);
+        }
+        check_urls(URL_OID_CERTIFICATE_ONLY_OCSP, cert, 0, ocsp, 1, __LINE__);
+        check_urls(URL_OID_CERTIFICATE_ONLY_OCSP, cert, CRYPT_GET_URL_FROM_EXTENSION, ocsp, 1, __LINE__);
+        check_urls(URL_OID_CERTIFICATE_CRL_DIST_POINT, cert, 0, crl, 1, __LINE__);
+        check_urls(URL_OID_CERTIFICATE_FRESHEST_CRL, cert, 0, fresh, 1, __LINE__);
+        check_urls(URL_OID_CERTIFICATE_OCSP_AND_CRL_DIST_POINT, cert, 0, ocsp_crl, 2, __LINE__);
+        check_urls(URL_OID_CERTIFICATE_CRL_DIST_POINT_AND_OCSP, cert, 0, crl_ocsp, 2, __LINE__);
+
+        SetLastError(0xdeadbeef);
+        ret = CryptGetObjectUrl(URL_OID_CERTIFICATE_ONLY_OCSP, (void *)cert, CRYPT_GET_URL_FROM_PROPERTY, NULL, &size,
+                                NULL, NULL, NULL);
+        ok(!ret && GetLastError() == CRYPT_E_NOT_FOUND, "got %d, %08lx\n", ret, GetLastError());
+        SetLastError(0xdeadbeef);
+        ret = CryptGetObjectUrl(URL_OID_CERTIFICATE_ONLY_OCSP, (void *)cert, 0, NULL, NULL, NULL, NULL, NULL);
+        ok(!ret && GetLastError() == E_INVALIDARG, "got %d, %08lx\n", ret, GetLastError());
+        info_size = 0;
+        ret = CryptGetObjectUrl(URL_OID_CERTIFICATE_ONLY_OCSP, (void *)cert, 0, NULL, &size, NULL, &info_size, NULL);
+        ok(ret && info_size >= sizeof(CRYPT_URL_INFO), "got %d, info size %lu\n", ret, info_size);
+        CertFreeCertificateContext(cert);
+    }
+    LocalFree(aia_data);
+    LocalFree(crl_data);
+    LocalFree(fresh_data);
+
+    /* none of the extensions */
+    cert = CertCreateCertificateContext(X509_ASN_ENCODING, bigCert, sizeof(bigCert));
+    SetLastError(0xdeadbeef);
+    ret = CryptGetObjectUrl(URL_OID_CERTIFICATE_ONLY_OCSP, (void *)cert, 0, NULL, &size, NULL, NULL, NULL);
+    ok(!ret && GetLastError() == CRYPT_E_NOT_FOUND, "got %d, %08lx\n", ret, GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = CryptGetObjectUrl(URL_OID_CERTIFICATE_FRESHEST_CRL, (void *)cert, 0, NULL, &size, NULL, NULL, NULL);
+    ok(!ret && GetLastError() == CRYPT_E_NOT_FOUND, "got %d, %08lx\n", ret, GetLastError());
+    CertFreeCertificateContext(cert);
+}
+
 START_TEST(cryptnet)
 {
     test_getObjectUrl();
+    test_getObjectUrl_revocation();
     test_retrieveObjectByUrl();
     test_verifyRevocation();
 }
--- a/include/wincrypt.h
+++ b/include/wincrypt.h
@@ -1500,6 +1500,7 @@ typedef struct _CRYPT_URL_INFO {
 #define URL_OID_CERTIFICATE_OCSP_AND_CRL_DIST_POINT ((LPCSTR)10)
 #define URL_OID_CERTIFICATE_CRL_DIST_POINT_AND_OCSP ((LPCSTR)11)
 #define URL_OID_CROSS_CERT_SUBJECT_INFO_ACCESS      ((LPCSTR)12)
+#define URL_OID_CERTIFICATE_ONLY_OCSP               ((LPCSTR)13)
 
 #define URL_OID_GET_OBJECT_URL_FUNC "UrlDllGetObjectUrl"
 
