diff --git a/dlls/hnetcfg/policy.c b/dlls/hnetcfg/policy.c
index e28a03c..886595a 100644
--- a/dlls/hnetcfg/policy.c
+++ b/dlls/hnetcfg/policy.c
@@ -1457,6 +1457,192 @@ static HRESULT WINAPI fw_policy_Invoke(
 }
 
 
+
+/* ---- the older interfaces' collections (INetFwAuthorizedApplications,
+ * INetFwOpenPorts) over the same stored rules: a program allowed is an
+ * inbound allow rule for its path without ports, a port opened one for a
+ * single port of TCP or UDP without a program ---- */
+
+void fw_legacy_free( struct fw_legacy *list, DWORD count )
+{
+    DWORD i;
+    for (i = 0; i < count; i++)
+    {
+        free( list[i].id ); free( list[i].name ); free( list[i].app );
+        free( list[i].ports ); free( list[i].raddrs );
+    }
+    free( list );
+}
+
+HRESULT fw_legacy_list( BOOL apps, struct fw_legacy **out, DWORD *count )
+{
+    struct stored_rule *rules;
+    struct fw_legacy *list;
+    DWORD n, i, k = 0;
+    HRESULT hr;
+
+    *out = NULL; *count = 0;
+    if (FAILED(hr = load_rules( &rules, &n ))) return hr;
+    if (!(list = calloc( n + 1, sizeof(*list) ))) { free_stored( rules, n ); return E_OUTOFMEMORY; }
+    for (i = 0; i < n; i++)
+    {
+        fw_rule *r = rules[i].rule;
+        WCHAR *end;
+        if (r->direction != NET_FW_RULE_DIR_IN || r->action != NET_FW_ACTION_ALLOW) continue;
+        if (apps)
+        {
+            if (!r->app || r->lports) continue;
+        }
+        else
+        {
+            if (r->app || !r->lports || r->rports) continue;
+            if (r->protocol != NET_FW_IP_PROTOCOL_TCP && r->protocol != NET_FW_IP_PROTOCOL_UDP) continue;
+            wcstol( r->lports, &end, 10 );
+            if (*end) continue;                       /* a list or a range */
+        }
+        list[k].id = str_dup( rules[i].id );
+        list[k].name = str_dup( r->name );
+        list[k].app = str_dup( r->app );
+        list[k].ports = str_dup( r->lports );
+        list[k].raddrs = str_dup( r->raddrs );
+        list[k].protocol = r->protocol;
+        list[k].enabled = r->enabled;
+        k++;
+    }
+    free_stored( rules, n );
+    *out = list; *count = k;
+    return S_OK;
+}
+
+HRESULT fw_legacy_remove( const WCHAR *id )
+{
+    HKEY key;
+    LSTATUS err;
+    HRESULT hr;
+
+    if (FAILED(hr = open_rules_key( KEY_SET_VALUE, &key ))) return hr;
+    err = RegDeleteValueW( key, id );
+    RegCloseKey( key );
+    if (err) return HRESULT_FROM_WIN32( err );
+    firewall_push( id, NULL );
+    return S_OK;
+}
+
+/* an enumeration of dispatch objects (the older collections' _NewEnum) */
+typedef struct fw_obj_enum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG refs;
+    IDispatch **items;
+    DWORD count, pos;
+} fw_obj_enum;
+
+static inline fw_obj_enum *impl_from_obj_enum( IEnumVARIANT *iface )
+{
+    return CONTAINING_RECORD(iface, fw_obj_enum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI obj_enum_QueryInterface( IEnumVARIANT *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IEnumVARIANT ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        IEnumVARIANT_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI obj_enum_AddRef( IEnumVARIANT *iface )
+{
+    return InterlockedIncrement( &impl_from_obj_enum( iface )->refs );
+}
+
+static ULONG WINAPI obj_enum_Release( IEnumVARIANT *iface )
+{
+    fw_obj_enum *This = impl_from_obj_enum( iface );
+    LONG refs = InterlockedDecrement( &This->refs );
+    if (!refs)
+    {
+        DWORD i;
+        for (i = 0; i < This->count; i++) IDispatch_Release( This->items[i] );
+        free( This->items );
+        free( This );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI obj_enum_Next( IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched )
+{
+    fw_obj_enum *This = impl_from_obj_enum( iface );
+    ULONG i = 0;
+
+    if (!var) return E_POINTER;
+    for (; i < celt && This->pos < This->count; i++, This->pos++)
+    {
+        IDispatch_AddRef( This->items[This->pos] );
+        V_VT(&var[i]) = VT_DISPATCH;
+        V_DISPATCH(&var[i]) = This->items[This->pos];
+    }
+    if (fetched) *fetched = i;
+    return i == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI obj_enum_Skip( IEnumVARIANT *iface, ULONG celt )
+{
+    fw_obj_enum *This = impl_from_obj_enum( iface );
+    This->pos = min( This->pos + celt, This->count );
+    return This->pos < This->count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI obj_enum_Reset( IEnumVARIANT *iface )
+{
+    impl_from_obj_enum( iface )->pos = 0;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl obj_enum_vtbl;
+
+HRESULT fw_obj_enum_create( IDispatch **items, DWORD count, DWORD pos, IUnknown **out )
+{
+    fw_obj_enum *e;
+    DWORD i;
+
+    if (!(e = calloc( 1, sizeof(*e) ))) return E_OUTOFMEMORY;
+    if (count && !(e->items = calloc( count, sizeof(*items) ))) { free( e ); return E_OUTOFMEMORY; }
+    e->IEnumVARIANT_iface.lpVtbl = &obj_enum_vtbl;
+    e->refs = 1;
+    e->count = count;
+    e->pos = pos;
+    for (i = 0; i < count; i++) { e->items[i] = items[i]; IDispatch_AddRef( items[i] ); }
+    *out = (IUnknown *)&e->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI obj_enum_Clone( IEnumVARIANT *iface, IEnumVARIANT **out )
+{
+    fw_obj_enum *This = impl_from_obj_enum( iface );
+    IUnknown *unk;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    if (FAILED(hr = fw_obj_enum_create( This->items, This->count, This->pos, &unk ))) return hr;
+    *out = (IEnumVARIANT *)unk;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl obj_enum_vtbl =
+{
+    obj_enum_QueryInterface,
+    obj_enum_AddRef,
+    obj_enum_Release,
+    obj_enum_Next,
+    obj_enum_Skip,
+    obj_enum_Reset,
+    obj_enum_Clone
+};
