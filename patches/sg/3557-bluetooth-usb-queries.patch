+/* ---- completed async operations ---- */
+
+/* An IAsyncOperation<BluetoothAdapter*> that has already completed: the result is known when it is created. */
+
+struct done_op
+{
+    IAsyncOperation_BluetoothAdapter IAsyncOperation_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    IUnknown *result;
+    IAsyncOperationCompletedHandler_BluetoothAdapter *handler;
+    BOOL closed;
+};
+
+static inline struct done_op *impl_from_op( IAsyncOperation_BluetoothAdapter *iface )
+{
+    return CONTAINING_RECORD( iface, struct done_op, IAsyncOperation_iface );
+}
+
+static inline struct done_op *impl_from_info( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct done_op, IAsyncInfo_iface );
+}
+
+static HRESULT done_op_query_interface( struct done_op *op, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncOperation_BluetoothAdapter ))
+    {
+        IAsyncOperation_BluetoothAdapter_AddRef( (*out = &op->IAsyncOperation_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+    {
+        IAsyncInfo_AddRef( (*out = &op->IAsyncInfo_iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG done_op_add_ref( struct done_op *op )
+{
+    return InterlockedIncrement( &op->ref );
+}
+
+static ULONG done_op_release( struct done_op *op )
+{
+    ULONG ref = InterlockedDecrement( &op->ref );
+
+    if (!ref)
+    {
+        if (op->handler) IAsyncOperationCompletedHandler_BluetoothAdapter_Release( op->handler );
+        if (op->result) IUnknown_Release( op->result );
+        free( op );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI op_QueryInterface( IAsyncOperation_BluetoothAdapter *iface, REFIID iid, void **out )
+{
+    return done_op_query_interface( impl_from_op( iface ), iid, out );
+}
+
+static ULONG WINAPI op_AddRef( IAsyncOperation_BluetoothAdapter *iface )
+{
+    return done_op_add_ref( impl_from_op( iface ) );
+}
+
+static ULONG WINAPI op_Release( IAsyncOperation_BluetoothAdapter *iface )
+{
+    return done_op_release( impl_from_op( iface ) );
+}
+
+static HRESULT WINAPI op_GetIids( IAsyncOperation_BluetoothAdapter *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = IID_IAsyncOperation_BluetoothAdapter;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI op_GetRuntimeClassName( IAsyncOperation_BluetoothAdapter *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Foundation.IAsyncOperation`1<Windows.Devices.Bluetooth.BluetoothAdapter>";
+    return WindowsCreateString( class_name, ARRAY_SIZE(class_name) - 1, name );
+}
+
+static HRESULT WINAPI op_GetTrustLevel( IAsyncOperation_BluetoothAdapter *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI op_put_Completed( IAsyncOperation_BluetoothAdapter *iface, IAsyncOperationCompletedHandler_BluetoothAdapter *handler )
+{
+    struct done_op *op = impl_from_op( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (op->closed) return E_ILLEGAL_METHOD_CALL;
+    if (op->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return S_OK;
+
+    IAsyncOperationCompletedHandler_BluetoothAdapter_AddRef( (op->handler = handler) );
+    /* already completed: the handler runs at once */
+    IAsyncOperationCompletedHandler_BluetoothAdapter_Invoke( handler, iface, Completed );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_get_Completed( IAsyncOperation_BluetoothAdapter *iface, IAsyncOperationCompletedHandler_BluetoothAdapter **handler )
+{
+    struct done_op *op = impl_from_op( iface );
+
+    if (op->closed) return E_ILLEGAL_METHOD_CALL;
+    if ((*handler = op->handler)) IAsyncOperationCompletedHandler_BluetoothAdapter_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_GetResults( IAsyncOperation_BluetoothAdapter *iface, IBluetoothAdapter **results )
+{
+    struct done_op *op = impl_from_op( iface );
+
+    if (!results) return E_POINTER;
+    if (op->closed) return E_ILLEGAL_METHOD_CALL;
+    *results = NULL;
+    if (op->result) return IUnknown_QueryInterface( op->result, &IID_IBluetoothAdapter, (void **)results );
+    return S_OK;
+}
+
+static const IAsyncOperation_BluetoothAdapterVtbl op_vtbl =
+{
+    op_QueryInterface, op_AddRef, op_Release, op_GetIids, op_GetRuntimeClassName, op_GetTrustLevel,
+    op_put_Completed, op_get_Completed, op_GetResults,
+};
+
+static HRESULT WINAPI info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )
