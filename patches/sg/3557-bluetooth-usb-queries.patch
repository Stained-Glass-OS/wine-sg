+}
+
+static HRESULT WINAPI info_GetIids( IAsyncInfo *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = IID_IAsyncInfo;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *name )
+{
+    return op_GetRuntimeClassName( &impl_from_info( iface )->IAsyncOperation_iface, name );
+}
+
+static HRESULT WINAPI info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    if (impl_from_info( iface )->closed) return E_ILLEGAL_METHOD_CALL;
+    *id = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct done_op *op = impl_from_info( iface );
+    *status = op->closed ? 4 : Completed;
+    return op->closed ? E_ILLEGAL_METHOD_CALL : S_OK;
+}
+
+static HRESULT WINAPI info_get_ErrorCode( IAsyncInfo *iface, HRESULT *code )
+{
+    struct done_op *op = impl_from_info( iface );
+    *code = op->closed ? E_ILLEGAL_METHOD_CALL : S_OK;
+    return *code;
+}
+
+static HRESULT WINAPI info_Cancel( IAsyncInfo *iface )
+{
+    return impl_from_info( iface )->closed ? E_ILLEGAL_METHOD_CALL : S_OK;
+}
+
+static HRESULT WINAPI info_Close( IAsyncInfo *iface )
+{
+    impl_from_info( iface )->closed = TRUE;
+    return S_OK;
+}
+
+static const IAsyncInfoVtbl info_vtbl =
+{
+    info_QueryInterface, info_AddRef, info_Release, info_GetIids, info_GetRuntimeClassName, info_GetTrustLevel,
+    info_get_Id, info_get_Status, info_get_ErrorCode, info_Cancel, info_Close,
+};
+
+/* "result" may be NULL: the operation then completes with a null object */
+static HRESULT async_BluetoothAdapter_create_completed( IUnknown *result, IAsyncOperation_BluetoothAdapter **out )
+{
+    struct done_op *op;
+
+    *out = NULL;
+    if (!(op = calloc( 1, sizeof(*op) ))) return E_OUTOFMEMORY;
+    op->IAsyncOperation_iface.lpVtbl = &op_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    op->ref = 1;
+    if ((op->result = result)) IUnknown_AddRef( result );
+    *out = &op->IAsyncOperation_iface;
+    return S_OK;
+}
+
