 /*********************************************************************
  *  BluetoothFindFirstDevice
  */
 HBLUETOOTH_DEVICE_FIND WINAPI BluetoothFindFirstDevice(BLUETOOTH_DEVICE_SEARCH_PARAMS *params,
                                                        BLUETOOTH_DEVICE_INFO *info)
 {
-    FIXME("(%p %p): stub!\n", params, info);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    TRACE("(%p %p)\n", params, info);
+
+    if (!params || !info || params->dwSize != sizeof(*params) || info->dwSize != sizeof(*info))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return NULL;
+    }
+
+    /* The radio driver does not list remote devices, so no search can find one:
+     * the same answer as a machine with a radio and no known device, or no radio at all. */
+    if (any_radio_present()) FIXME("remote device lists are not available from the radio driver\n");
+    SetLastError(ERROR_NO_MORE_ITEMS);
     return NULL;
 }
 
