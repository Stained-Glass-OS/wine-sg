+}
+
+static ULONG WINAPI info_AddRef( IAsyncInfo *iface )
+{
+    return done_op_add_ref( impl_from_info( iface ) );
+}
+
+static ULONG WINAPI info_Release( IAsyncInfo *iface )
+{
