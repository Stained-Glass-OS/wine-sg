+/* The first present radio interface (or the one named "id") as an adapter; NULL when there is none. */
+static HRESULT find_adapter( const WCHAR *id, struct adapter **out )
+{
+    char buffer[sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W) + MAX_PATH * sizeof(WCHAR)];
+    SP_DEVICE_INTERFACE_DETAIL_DATA_W *detail = (SP_DEVICE_INTERFACE_DETAIL_DATA_W *)buffer;
+    SP_DEVICE_INTERFACE_DATA data = { sizeof(data) };
+    HDEVINFO devinfo;
+    DWORD i;
+
+    *out = NULL;
+    devinfo = SetupDiGetClassDevsW( &GUID_BLUETOOTH_RADIO_INTERFACE, NULL, NULL, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE );
+    if (devinfo == INVALID_HANDLE_VALUE) return S_OK;
+
+    detail->cbSize = sizeof(*detail);
+    for (i = 0; SetupDiEnumDeviceInterfaces( devinfo, NULL, &GUID_BLUETOOTH_RADIO_INTERFACE, i, &data ); i++)
+    {
+        BTH_LOCAL_RADIO_INFO info;
+        struct adapter *adapter;
+        HANDLE device;
+        DWORD size;
+        BOOL ok;
+
+        if (!SetupDiGetDeviceInterfaceDetailW( devinfo, &data, detail, sizeof(buffer), NULL, NULL )) continue;
+        if (id && wcsicmp( id, detail->DevicePath )) continue;
+
+        device = CreateFileW( detail->DevicePath, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                              NULL, OPEN_EXISTING, 0, NULL );
+        if (device == INVALID_HANDLE_VALUE) continue;
+        ok = DeviceIoControl( device, IOCTL_BTH_GET_LOCAL_INFO, NULL, 0, &info, sizeof(info), &size, NULL );
+        CloseHandle( device );
+        if (!ok) continue;
+
+        if (!(adapter = calloc( 1, sizeof(*adapter) )) || !(adapter->id = wcsdup( detail->DevicePath )))
+        {
+            free( adapter );
+            SetupDiDestroyDeviceInfoList( devinfo );
+            return E_OUTOFMEMORY;
+        }
+        adapter->IBluetoothAdapter_iface.lpVtbl = &adapter_vtbl;
+        adapter->ref = 1;
+        /* the driver reports the address in the byte order of the BTH_ADDR type */
+        adapter->address = __builtin_bswap64( info.localInfo.address );
+        *out = adapter;
+        break;
+    }
+    SetupDiDestroyDeviceInfoList( devinfo );
+    return S_OK;
