+static DWORD get_local_info(HANDLE radio, BTH_LOCAL_RADIO_INFO *info)
+{
+    DWORD size;
+
+    if (!DeviceIoControl(radio, IOCTL_BTH_GET_LOCAL_INFO, NULL, 0, info, sizeof(*info), &size, NULL))
+        return GetLastError();
+    return ERROR_SUCCESS;
+}
+
 /*********************************************************************
  *  BluetoothGetRadioInfo
  */
 DWORD WINAPI BluetoothGetRadioInfo(HANDLE radio, PBLUETOOTH_RADIO_INFO info)
 {
-    FIXME("(%p, %p): stub!\n", radio, info);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    BTH_LOCAL_RADIO_INFO local;
+    DWORD ret;
+
+    TRACE("(%p, %p)\n", radio, info);
+
+    if (!info) return ERROR_INVALID_PARAMETER;
+    if (info->dwSize != sizeof(*info)) return ERROR_REVISION_MISMATCH;
+
+    if ((ret = get_local_info(radio, &local))) return ret;
+
+    memset(info, 0, sizeof(*info));
+    info->dwSize = sizeof(*info);
+    /* the driver reports the address in BTH_ADDR order, the reverse of BLUETOOTH_ADDRESS */
+    info->address.ullLong = __builtin_bswap64(local.localInfo.address);
+    MultiByteToWideChar(CP_UTF8, 0, local.localInfo.name, -1, info->szName, ARRAY_SIZE(info->szName));
+    info->szName[ARRAY_SIZE(info->szName) - 1] = 0;
+    info->ulClassofDevice = local.localInfo.classOfDevice;
+    info->lmpSubversion = local.radioInfo.lmpSubversion;
+    info->manufacturer = local.radioInfo.mfg;
+    return ERROR_SUCCESS;
+}
+
+static BOOL radio_flag(HANDLE radio, ULONG flag)
+{
+    BTH_LOCAL_RADIO_INFO local;
+    DWORD ret;
+
+    if (radio)
+    {
+        if ((ret = get_local_info(radio, &local)))
+        {
+            SetLastError(ret);
+            return FALSE;
+        }
+        return !!(local.flags & flag);
+    }
+    else
+    {
+        BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof(params) };
+        HBLUETOOTH_RADIO_FIND find;
+        BOOL result = FALSE;
+
+        /* no radio given: any radio will do */
+        if (!(find = BluetoothFindFirstRadio(&params, &radio))) return FALSE;
+        do
+        {
+            if (!get_local_info(radio, &local) && (local.flags & flag)) result = TRUE;
+            CloseHandle(radio);
+        } while (!result && BluetoothFindNextRadio(find, &radio));
+        BluetoothFindRadioClose(find);
+        return result;
+    }
+}
+
+/*********************************************************************
+ *  BluetoothIsConnectable
+ */
+BOOL WINAPI BluetoothIsConnectable(HANDLE radio)
+{
+    TRACE("(%p)\n", radio);
+    return radio_flag(radio, LOCAL_RADIO_CONNECTABLE);
+}
+
+/*********************************************************************
+ *  BluetoothIsDiscoverable
+ */
+BOOL WINAPI BluetoothIsDiscoverable(HANDLE radio)
+{
+    TRACE("(%p)\n", radio);
+    return radio_flag(radio, LOCAL_RADIO_DISCOVERABLE);
 }
 
