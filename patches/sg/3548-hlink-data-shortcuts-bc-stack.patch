+/***********************************************************************
+ *             HlinkTranslateURL (HLINK.@)
+ */
+HRESULT WINAPI HlinkTranslateURL(LPCWSTR url, DWORD flags, LPWSTR *translated)
+{
+    WCHAR buffer[INTERNET_MAX_URL_LENGTH];
+    DWORD len = ARRAY_SIZE(buffer), apply = URL_APPLY_GUESSFILE;
+    HRESULT hr;
+
+    TRACE("%s, %#lx, %p\n", debugstr_w(url), flags, translated);
+
+    if (!url || !translated) return E_INVALIDARG;
+    *translated = NULL;
+    if (flags & ~HLTRANSLATEF_DONT_APPLY_DEFAULT_PREFIX) return E_INVALIDARG;
+    if (!(flags & HLTRANSLATEF_DONT_APPLY_DEFAULT_PREFIX)) apply |= URL_APPLY_GUESSSCHEME | URL_APPLY_DEFAULT;
+
+    hr = UrlApplySchemeW(url, buffer, &len, apply);
+    if (hr != S_OK) return S_FALSE;     /* nothing to translate */
+    if (!(*translated = hlink_co_strdupW(buffer))) return E_OUTOFMEMORY;
+    return S_OK;
+}
