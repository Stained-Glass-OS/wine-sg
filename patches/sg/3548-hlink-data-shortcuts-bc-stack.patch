+    LONG ref;
+    ULONG pos;
+};
+
+static inline struct enum_formats *impl_from_IEnumFORMATETC(IEnumFORMATETC *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_formats, IEnumFORMATETC_iface);
+}
+
+static HRESULT WINAPI enum_formats_QueryInterface(IEnumFORMATETC *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumFORMATETC))
+    {
+        *out = iface;
+        IEnumFORMATETC_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_formats_AddRef(IEnumFORMATETC *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumFORMATETC(iface)->ref);
+}
+
+static ULONG WINAPI enum_formats_Release(IEnumFORMATETC *iface)
+{
+    struct enum_formats *e = impl_from_IEnumFORMATETC(iface);
+    ULONG ref = InterlockedDecrement(&e->ref);
+    if (!ref) free(e);
+    return ref;
+}
+
+static HRESULT WINAPI enum_formats_Next(IEnumFORMATETC *iface, ULONG celt, FORMATETC *fmt, ULONG *fetched)
+{
+    struct enum_formats *e = impl_from_IEnumFORMATETC(iface);
+    ULONG n = 0;
+
+    if (celt && e->pos == 0)
+    {
+        fmt->cfFormat = hlink_clipformat();
+        fmt->ptd = NULL;
+        fmt->dwAspect = DVASPECT_CONTENT;
+        fmt->lindex = -1;
+        fmt->tymed = TYMED_HGLOBAL | TYMED_ISTREAM;
+        e->pos = 1;
+        n = 1;
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_formats_Skip(IEnumFORMATETC *iface, ULONG celt)
+{
+    struct enum_formats *e = impl_from_IEnumFORMATETC(iface);
+
+    e->pos += celt;
+    if (e->pos > 1)
+    {
+        e->pos = 1;
+        return S_FALSE;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_formats_Reset(IEnumFORMATETC *iface)
+{
+    impl_from_IEnumFORMATETC(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_enum_formats(ULONG pos, IEnumFORMATETC **out);
+
+static HRESULT WINAPI enum_formats_Clone(IEnumFORMATETC *iface, IEnumFORMATETC **out)
+{
+    return create_enum_formats(impl_from_IEnumFORMATETC(iface)->pos, out);
+}
