+static BOOL data_has_format(IDataObject *data, CLIPFORMAT cf, DWORD tymed)
+{
+    FORMATETC fmt = { cf, NULL, DVASPECT_CONTENT, -1, tymed };
+    return IDataObject_QueryGetData(data, &fmt) == S_OK;
+}
+
+/* the bytes of a global memory block of a data object format */
+static HRESULT data_get_global(IDataObject *data, CLIPFORMAT cf, void **out, SIZE_T *size)
+{
+    FORMATETC fmt = { cf, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    STGMEDIUM med;
+    HRESULT hr;
+    void *p;
+
+    if (FAILED(hr = IDataObject_GetData(data, &fmt, &med))) return hr;
+    if (med.tymed != TYMED_HGLOBAL)
+    {
+        ReleaseStgMedium(&med);
+        return DV_E_TYMED;
+    }
+    *size = GlobalSize(med.hGlobal);
+    if ((p = GlobalLock(med.hGlobal)) && (*out = malloc(*size + sizeof(WCHAR))))
+    {
+        memcpy(*out, p, *size);
+        memset((char *)*out + *size, 0, sizeof(WCHAR));
+        hr = S_OK;
+    }
+    else hr = E_OUTOFMEMORY;
+    if (p) GlobalUnlock(med.hGlobal);
+    ReleaseStgMedium(&med);
+    return hr;
+}
+
+static CLIPFORMAT cf_hyperlink(void) { return RegisterClipboardFormatW(L"Hyperlink"); }
+static CLIPFORMAT cf_url_a(void)     { return RegisterClipboardFormatW(L"UniformResourceLocator"); }
+static CLIPFORMAT cf_url_w(void)     { return RegisterClipboardFormatW(L"UniformResourceLocatorW"); }
+
+/***********************************************************************
+ *             HlinkQueryCreateFromData (HLINK.@)
+ */
+HRESULT WINAPI HlinkQueryCreateFromData(IDataObject *data)
+{
+    TRACE("%p\n", data);
+
+    if (!data) return E_INVALIDARG;
+    if (data_has_format(data, cf_hyperlink(), TYMED_HGLOBAL | TYMED_ISTREAM) ||
+        data_has_format(data, cf_url_w(), TYMED_HGLOBAL) ||
+        data_has_format(data, cf_url_a(), TYMED_HGLOBAL) ||
+        data_has_format(data, CF_UNICODETEXT, TYMED_HGLOBAL) ||
+        data_has_format(data, CF_TEXT, TYMED_HGLOBAL))
+        return S_OK;
+    return S_FALSE;
+}
+
+/***********************************************************************
+ *             HlinkCreateFromData (HLINK.@)
+ */
+HRESULT WINAPI HlinkCreateFromData(IDataObject *data, IHlinkSite *site, DWORD site_data, IUnknown *outer,
+        REFIID riid, void **ppv)
+{
+    void *mem = NULL;
+    SIZE_T size;
+    IHlink *hl = NULL;
+    HRESULT hr;
+
+    TRACE("%p, %p, %ld, %p, %s, %p\n", data, site, site_data, outer, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_INVALIDARG;
+    *ppv = NULL;
+    if (!data) return E_INVALIDARG;
+    if (outer) return CLASS_E_NOAGGREGATION;
+
+    if (data_has_format(data, cf_hyperlink(), TYMED_HGLOBAL | TYMED_ISTREAM))
+    {
+        FORMATETC fmt = { cf_hyperlink(), NULL, DVASPECT_CONTENT, -1, TYMED_ISTREAM | TYMED_HGLOBAL };
+        STGMEDIUM med;
+
+        if (FAILED(hr = IDataObject_GetData(data, &fmt, &med))) return hr;
+        if (med.tymed == TYMED_ISTREAM)
+            hr = OleLoadFromStream(med.pstm, &IID_IHlink, (void **)&hl);
+        else if (med.tymed == TYMED_HGLOBAL)
+        {
+            IStream *stream;
+            if (SUCCEEDED(hr = CreateStreamOnHGlobal(med.hGlobal, FALSE, &stream)))
+            {
+                hr = OleLoadFromStream(stream, &IID_IHlink, (void **)&hl);
+                IStream_Release(stream);
+            }
+        }
+        else hr = DV_E_TYMED;
+        ReleaseStgMedium(&med);
+        if (FAILED(hr)) return hr;
+        if (site) IHlink_SetHlinkSite(hl, site, site_data);
+        hr = IHlink_QueryInterface(hl, riid, ppv);
+        IHlink_Release(hl);
+        return hr;
+    }
+
+    {
+        WCHAR *text = NULL;
+
+        if (SUCCEEDED(data_get_global(data, cf_url_w(), &mem, &size)) ||
+            SUCCEEDED(data_get_global(data, CF_UNICODETEXT, &mem, &size)))
+        {
+            text = mem;
+        }
+        else if (SUCCEEDED(data_get_global(data, cf_url_a(), &mem, &size)) ||
+                 SUCCEEDED(data_get_global(data, CF_TEXT, &mem, &size)))
+        {
+            int len = MultiByteToWideChar(CP_ACP, 0, mem, -1, NULL, 0);
+            text = malloc(len * sizeof(WCHAR));
+            if (text) MultiByteToWideChar(CP_ACP, 0, mem, -1, text, len);
+            free(mem);
+            if (!text) return E_OUTOFMEMORY;
+        }
+        else return DV_E_FORMATETC;
+
+        hr = HlinkCreateFromString(text, NULL, NULL, site, site_data, NULL, riid, ppv);
+        free(text);
+        return hr;
+    }
+}
