+    if (FAILED(hr = hlink_check_format(pformatetc))) return hr;
+
+    if (pmedium->tymed == TYMED_ISTREAM && pmedium->pstm)
+        return hlink_render_stream(This, pmedium->pstm);
+
+    if (pmedium->tymed == TYMED_HGLOBAL && pmedium->hGlobal)
+    {
+        /* render into a temporary stream and copy to the caller's block */
+        IStream *stream;
+        STATSTG stat;
+        HGLOBAL h;
+        void *src, *dst;
+        SIZE_T have = GlobalSize(pmedium->hGlobal);
+        LARGE_INTEGER zero = {{0}};
+        ULARGE_INTEGER size;
+
+        if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream))) return hr;
+        if (SUCCEEDED(hr = hlink_render_stream(This, stream)))
+        {
+            IStream_Seek(stream, zero, STREAM_SEEK_CUR, &size);
+            IStream_Stat(stream, &stat, STATFLAG_NONAME);
+            GetHGlobalFromStream(stream, &h);
+            if (size.LowPart > have) hr = STG_E_MEDIUMFULL;
+            else if ((src = GlobalLock(h)))
+            {
+                if ((dst = GlobalLock(pmedium->hGlobal)))
+                {
+                    memcpy(dst, src, size.LowPart);
+                    GlobalUnlock(pmedium->hGlobal);
+                }
+                else hr = E_FAIL;
+                GlobalUnlock(h);
+            }
+            else hr = E_FAIL;
+        }
+        IStream_Release(stream);
+        return hr;
+    }
+    return DV_E_TYMED;
 }
 
