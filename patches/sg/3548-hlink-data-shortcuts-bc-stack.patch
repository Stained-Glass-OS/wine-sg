+static CLIPFORMAT hlink_clipformat(void)
+{
+    return RegisterClipboardFormatW(L"Hyperlink");
+}
+
+/* the "Hyperlink" format: the hyperlink saved with OleSaveToStream */
+static HRESULT hlink_render_stream(HlinkImpl *This, IStream *stream)
+{
+    IPersistStream *ps = &This->IPersistStream_iface;
+    HRESULT hr;
+
+    if (FAILED(hr = WriteClassStm(stream, &CLSID_StdHlink))) return hr;
+    return IPersistStream_Save(ps, stream, FALSE);
+}
+
+static HRESULT hlink_check_format(const FORMATETC *fmt)
+{
+    if (!fmt) return E_INVALIDARG;
+    if (fmt->cfFormat != hlink_clipformat()) return DV_E_FORMATETC;
+    if (fmt->ptd) return DV_E_DVTARGETDEVICE;
+    if (!(fmt->dwAspect & DVASPECT_CONTENT)) return DV_E_DVASPECT;
+    if (fmt->lindex != -1 && fmt->lindex != 0) return DV_E_LINDEX;
+    if (!(fmt->tymed & (TYMED_HGLOBAL | TYMED_ISTREAM))) return DV_E_TYMED;
+    return S_OK;
+}
