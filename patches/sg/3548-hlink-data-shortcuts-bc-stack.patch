+            items[n].pwzFriendlyName = NULL;
+        n++;
+    }
+    hr = create_enum_hlitem(items, count, 0, ppienumhlitem);
+    for (i = 0; i < count; i++) CoTaskMemFree(items[i].pwzFriendlyName);
+    free(items);
+    return hr;
 }
 
