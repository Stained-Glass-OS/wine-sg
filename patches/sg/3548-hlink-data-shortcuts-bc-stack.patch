+    enum_formats_Release,
+    enum_formats_Next,
+    enum_formats_Skip,
+    enum_formats_Reset,
+    enum_formats_Clone,
+};
+
+static HRESULT create_enum_formats(ULONG pos, IEnumFORMATETC **out)
+{
+    struct enum_formats *e;
+
