+/* ---- Internet shortcut files ---- */
+
+static WCHAR *build_target_string(const WCHAR *target, const WCHAR *location)
+{
+    int tlen = target ? lstrlenW(target) : 0, llen = location ? lstrlenW(location) : 0;
+    WCHAR *s = malloc((tlen + llen + 2) * sizeof(WCHAR));
+
+    if (!s) return NULL;
+    if (target) memcpy(s, target, tlen * sizeof(WCHAR));
+    s[tlen] = 0;
+    if (location && *location)
+    {
+        s[tlen] = '#';
+        memcpy(s + tlen + 1, location, (llen + 1) * sizeof(WCHAR));
+    }
+    return s;
+}
+
+static void sanitize_file_name(WCHAR *name)
+{
+    for (; *name; name++)
+        if (wcschr(L"\\/:*?\"<>|", *name) || *name < ' ') *name = '_';
+}
+
+static HRESULT create_shortcut_file(DWORD flags, const WCHAR *target, const WCHAR *location, const WCHAR *friendly,
+        const WCHAR *dir, const WCHAR *filename, WCHAR **out)
+{
+    WCHAR base[MAX_PATH], path[MAX_PATH], *url;
+    const WCHAR *name = filename;
+    int n;
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+
+    if ((!name || !*name) && (flags & HLSHORTCUTF_USEFILENAMEFROMFRIENDLYNAME) && friendly && *friendly)
+        name = friendly;
+    if (!name || !*name)
+    {
+        /* a name from the target: host or last path element */
+        const WCHAR *p = target ? wcsstr(target, L"://") : NULL;
+        const WCHAR *start = p ? p + 3 : target, *end;
+
+        if (start && *start)
+        {
+            end = start + wcscspn(start, L"/?#");
+            if (end == start) end = start + lstrlenW(start);
+            n = min((int)(end - start), MAX_PATH - 8);
+            memcpy(base, start, n * sizeof(WCHAR));
+            base[n] = 0;
+            name = base;
+        }
+        else name = L"Internet Shortcut";
+    }
+    else
+    {
+        lstrcpynW(base, name, MAX_PATH - 8);
+        name = base;
+    }
+    /* drop a given extension, the shortcut gets .url */
+    if (name == base)
+    {
+        WCHAR *dot = wcsrchr(base, '.');
+        if (dot && !wcsicmp(dot, L".url")) *dot = 0;
+        sanitize_file_name(base);
+    }
+
+    if (dir && *dir)
+        lstrcpynW(path, dir, MAX_PATH);
+    else
+        GetCurrentDirectoryW(MAX_PATH, path);
+    n = lstrlenW(path);
+    if (n && path[n - 1] != '\\' && n + 1 < MAX_PATH) path[n++] = '\\';
+    if (n + lstrlenW(name) + 12 >= MAX_PATH) return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+    lstrcpyW(path + n, name);
+    lstrcatW(path, L".url");
+
+    /* do not overwrite an existing shortcut */
+    for (int i = 2; GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES && i < 1000; i++)
+        swprintf(path + n, MAX_PATH - n, L"%s (%d).url", name, i);
+
+    if (!(*out = hlink_co_strdupW(path))) return E_OUTOFMEMORY;
+    if (flags & HLSHORTCUTF_DONTACTUALLYCREATE) return S_OK;
+
+    if (!(url = build_target_string(target, location)))
+    {
+        CoTaskMemFree(*out);
+        *out = NULL;
+        return E_OUTOFMEMORY;
+    }
+    if (!WritePrivateProfileStringW(L"InternetShortcut", L"URL", url, path))
+    {
+        HRESULT hr = HRESULT_FROM_WIN32(GetLastError());
+        free(url);
+        CoTaskMemFree(*out);
+        *out = NULL;
+        return hr;
+    }
+    free(url);
+    return S_OK;
+}
+
+/***********************************************************************
+ *             HlinkCreateShortcutFromString (HLINK.@)
+ */
+HRESULT WINAPI HlinkCreateShortcutFromString(DWORD flags, LPCWSTR target, LPCWSTR location, LPCWSTR dir,
+        LPCWSTR filename, LPWSTR *shortcut, DWORD reserved)
+{
+    TRACE("%#lx, %s, %s, %s, %s, %p, %#lx\n", flags, debugstr_w(target), debugstr_w(location), debugstr_w(dir),
+            debugstr_w(filename), shortcut, reserved);
+
+    return create_shortcut_file(flags, target, location, NULL, dir, filename, shortcut);
+}
+
+/***********************************************************************
+ *             HlinkCreateShortcut (HLINK.@)
+ */
+HRESULT WINAPI HlinkCreateShortcut(DWORD flags, IHlink *hlink, LPCWSTR dir, LPCWSTR filename, LPWSTR *shortcut,
+        DWORD reserved)
+{
+    WCHAR *target = NULL, *location = NULL, *friendly = NULL;
+    HRESULT hr;
+
+    TRACE("%#lx, %p, %s, %s, %p, %#lx\n", flags, hlink, debugstr_w(dir), debugstr_w(filename), shortcut, reserved);
+
+    if (!hlink) return E_INVALIDARG;
+    if (FAILED(hr = IHlink_GetStringReference(hlink, HLINKGETREF_DEFAULT, &target, &location))) return hr;
+    IHlink_GetFriendlyName(hlink, HLFNAMEF_DEFAULT, &friendly);
+    hr = create_shortcut_file(flags, target, location, friendly, dir, filename, shortcut);
+    CoTaskMemFree(target);
+    CoTaskMemFree(location);
+    CoTaskMemFree(friendly);
+    return hr;
+}
+
+/***********************************************************************
+ *             HlinkCreateShortcutFromMoniker (HLINK.@)
+ */
+HRESULT WINAPI HlinkCreateShortcutFromMoniker(DWORD flags, IMoniker *target, LPCWSTR location, LPCWSTR dir,
+        LPCWSTR filename, LPWSTR *shortcut, DWORD reserved)
+{
+    IHlink *hlink;
+    HRESULT hr;
+
+    TRACE("%#lx, %p, %s, %s, %s, %p, %#lx\n", flags, target, debugstr_w(location), debugstr_w(dir),
+            debugstr_w(filename), shortcut, reserved);
+
+    if (FAILED(hr = HlinkCreateFromMoniker(target, location, NULL, NULL, 0, NULL, &IID_IHlink, (void **)&hlink)))
+        return hr;
+    hr = HlinkCreateShortcut(flags, hlink, dir, filename, shortcut, reserved);
+    IHlink_Release(hlink);
+    return hr;
+}
+
+/***********************************************************************
+ *             HlinkResolveShortcutToString (HLINK.@)
+ */
+HRESULT WINAPI HlinkResolveShortcutToString(LPCWSTR file, LPWSTR *target, LPWSTR *location)
+{
+    WCHAR url[INTERNET_MAX_URL_LENGTH], *hash;
+
+    TRACE("%s, %p, %p\n", debugstr_w(file), target, location);
+
+    if (!file || !target) return E_INVALIDARG;
+    *target = NULL;
+    if (location) *location = NULL;
+    if (GetFileAttributesW(file) == INVALID_FILE_ATTRIBUTES)
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    GetPrivateProfileStringW(L"InternetShortcut", L"URL", L"", url, ARRAY_SIZE(url), file);
+    if (!url[0]) return E_FAIL;
+
+    if ((hash = wcschr(url, '#')))
+    {
+        *hash++ = 0;
+        if (location && !(*location = hlink_co_strdupW(hash))) return E_OUTOFMEMORY;
+    }
+    if (!(*target = hlink_co_strdupW(url)))
+    {
+        if (location) { CoTaskMemFree(*location); *location = NULL; }
+        return E_OUTOFMEMORY;
+    }
+    return S_OK;
+}
+
+/***********************************************************************
+ *             HlinkResolveShortcut (HLINK.@)
+ */
+HRESULT WINAPI HlinkResolveShortcut(LPCWSTR file, IHlinkSite *site, DWORD site_data, IUnknown *outer, REFIID riid,
+        void **ppv)
+{
+    WCHAR *target, *location;
+    HRESULT hr;
+
+    TRACE("%s, %p, %ld, %p, %s, %p\n", debugstr_w(file), site, site_data, outer, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_INVALIDARG;
+    *ppv = NULL;
+    if (FAILED(hr = HlinkResolveShortcutToString(file, &target, &location))) return hr;
+    hr = HlinkCreateFromString(target, location, NULL, site, site_data, outer, riid, ppv);
+    CoTaskMemFree(target);
+    CoTaskMemFree(location);
+    return hr;
+}
+
+/***********************************************************************
+ *             HlinkResolveShortcutToMoniker (HLINK.@)
+ */
+HRESULT WINAPI HlinkResolveShortcutToMoniker(LPCWSTR file, IMoniker **target, LPWSTR *location)
+{
+    IHlink *hlink;
+    HRESULT hr;
+
+    TRACE("%s, %p, %p\n", debugstr_w(file), target, location);
+
+    if (!target) return E_INVALIDARG;
+    *target = NULL;
+    if (location) *location = NULL;
+    if (FAILED(hr = HlinkResolveShortcut(file, NULL, 0, NULL, &IID_IHlink, (void **)&hlink))) return hr;
+    hr = IHlink_GetMonikerReference(hlink, HLINKGETREF_DEFAULT, target, location);
+    IHlink_Release(hlink);
+    return hr;
+}
