+/***********************************************************************
+ *             HlinkSetSpecialReference (HLINK.@)
+ */
+HRESULT WINAPI HlinkSetSpecialReference(ULONG reference, LPCWSTR value)
+{
+    const WCHAR *name;
+    HKEY key;
+    LONG res;
+
+    TRACE("%lu, %s\n", reference, debugstr_w(value));
+
+    switch (reference)
+    {
+    case HLSR_HOME:       name = L"Start Page"; break;
+    case HLSR_SEARCHPAGE: name = L"Search Page"; break;
+    case HLSR_HISTORYFOLDER: return E_NOTIMPL;
+    default: return E_INVALIDARG;
+    }
+    if (!value) return E_INVALIDARG;
+
+    res = RegCreateKeyExW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Internet Explorer\\Main", 0, NULL, 0,
+            KEY_SET_VALUE, NULL, &key, NULL);
+    if (res) return HRESULT_FROM_WIN32(res);
+    res = RegSetValueExW(key, name, 0, REG_SZ, (const BYTE *)value, (lstrlenW(value) + 1) * sizeof(WCHAR));
+    RegCloseKey(key);
+    return res ? HRESULT_FROM_WIN32(res) : S_OK;
+}
+
+/***********************************************************************
+ *             OleSaveToStreamEx (HLINK.@)
+ */
+HRESULT WINAPI OleSaveToStreamEx(IUnknown *unk, IStream *stream, BOOL clear_dirty)
+{
+    IPersistStream *ps;
+    CLSID clsid;
+    HRESULT hr;
+
+    TRACE("%p, %p, %d\n", unk, stream, clear_dirty);
+
+    if (!unk || !stream) return E_INVALIDARG;
+    if (FAILED(hr = IUnknown_QueryInterface(unk, &IID_IPersistStream, (void **)&ps))) return hr;
+    if (SUCCEEDED(hr = IPersistStream_GetClassID(ps, &clsid)) &&
+        SUCCEEDED(hr = WriteClassStm(stream, &clsid)))
+        hr = IPersistStream_Save(ps, stream, clear_dirty);
+    IPersistStream_Release(ps);
+    return hr;
+}
