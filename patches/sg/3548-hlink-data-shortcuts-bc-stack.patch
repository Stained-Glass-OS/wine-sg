+struct enum_hlitem
+{
+    IEnumHLITEM IEnumHLITEM_iface;
+    LONG ref;
+    HLITEM *items;
+    ULONG count, pos;
+};
+
+static inline struct enum_hlitem *impl_from_IEnumHLITEM(IEnumHLITEM *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_hlitem, IEnumHLITEM_iface);
+}
+
+static HRESULT WINAPI enum_hlitem_QueryInterface(IEnumHLITEM *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumHLITEM))
+    {
+        *out = iface;
+        IEnumHLITEM_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_hlitem_AddRef(IEnumHLITEM *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumHLITEM(iface)->ref);
+}
+
+static ULONG WINAPI enum_hlitem_Release(IEnumHLITEM *iface)
+{
+    struct enum_hlitem *e = impl_from_IEnumHLITEM(iface);
+    ULONG ref = InterlockedDecrement(&e->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < e->count; i++) CoTaskMemFree(e->items[i].pwzFriendlyName);
+        free(e->items);
+        free(e);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_hlitem_Next(IEnumHLITEM *iface, ULONG celt, HLITEM *items, ULONG *fetched)
+{
+    struct enum_hlitem *e = impl_from_IEnumHLITEM(iface);
+    ULONG n = 0;
+
+    while (n < celt && e->pos < e->count)
+    {
+        items[n].uHLID = e->items[e->pos].uHLID;
+        items[n].pwzFriendlyName = hlink_co_strdupW(e->items[e->pos].pwzFriendlyName);
+        n++;
+        e->pos++;
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_hlitem_Skip(IEnumHLITEM *iface, ULONG celt)
+{
+    struct enum_hlitem *e = impl_from_IEnumHLITEM(iface);
+
+    e->pos += celt;
+    if (e->pos > e->count)
+    {
+        e->pos = e->count;
+        return S_FALSE;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_hlitem_Reset(IEnumHLITEM *iface)
+{
+    impl_from_IEnumHLITEM(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_enum_hlitem(const HLITEM *items, ULONG count, ULONG pos, IEnumHLITEM **out);
+
+static HRESULT WINAPI enum_hlitem_Clone(IEnumHLITEM *iface, IEnumHLITEM **out)
+{
+    struct enum_hlitem *e = impl_from_IEnumHLITEM(iface);
+    return create_enum_hlitem(e->items, e->count, e->pos, out);
+}
+
+static const IEnumHLITEMVtbl enum_hlitem_vtbl =
+{
+    enum_hlitem_QueryInterface,
+    enum_hlitem_AddRef,
+    enum_hlitem_Release,
+    enum_hlitem_Next,
+    enum_hlitem_Skip,
+    enum_hlitem_Reset,
+    enum_hlitem_Clone,
+};
+
+static HRESULT create_enum_hlitem(const HLITEM *items, ULONG count, ULONG pos, IEnumHLITEM **out)
+{
+    struct enum_hlitem *e;
+    ULONG i;
+
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
+    if (!(e->items = calloc(max(count, 1), sizeof(*e->items))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        e->items[i].uHLID = items[i].uHLID;
+        e->items[i].pwzFriendlyName = hlink_co_strdupW(items[i].pwzFriendlyName);
+    }
+    e->IEnumHLITEM_iface.lpVtbl = &enum_hlitem_vtbl;
+    e->ref = 1;
+    e->count = count;
+    e->pos = pos;
+    *out = &e->IEnumHLITEM_iface;
+    return S_OK;
+}
