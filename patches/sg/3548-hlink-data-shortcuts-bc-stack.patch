+static void context_remove_entry(HlinkBCImpl *ctxt, struct link_entry *link)
+{
+    if (ctxt->current == link) ctxt->current = NULL;
+    list_remove(&link->entry);
+    IHlink_Release(link->link);
+    free(link);
+}
+
+static HRESULT WINAPI IHlinkBC_OnNavigateHlink(IHlinkBrowseContext *iface,
+        DWORD grfHLNF, IMoniker* pmkTarget, LPCWSTR pwzLocation, LPCWSTR
+        pwzFriendlyName, ULONG *puHLID)
+{
+    HlinkBCImpl  *This = impl_from_IHlinkBrowseContext(iface);
+    struct link_entry *entry;
+    HRESULT hr;
+
+    TRACE("(%p)->(%#lx %p %s %s %p)\n", This, grfHLNF, pmkTarget,
+            debugstr_w(pwzLocation), debugstr_w(pwzFriendlyName), puHLID);
+
+    if (grfHLNF & (HLNF_NAVIGATINGBACK | HLNF_NAVIGATINGFORWARD | HLNF_NAVIGATINGTOSTACKITEM))
+    {
+        /* moving inside the stack: the entry exists already */
+        if (grfHLNF & HLNF_NAVIGATINGBACK)
+            entry = context_get_entry(This, HLID_PREVIOUS);
+        else if (grfHLNF & HLNF_NAVIGATINGFORWARD)
+            entry = context_get_entry(This, HLID_NEXT);
+        else
+            entry = puHLID ? context_get_entry(This, *puHLID) : NULL;
+        if (!entry) return E_FAIL;
+        This->current = entry;
+        if (puHLID) *puHLID = entry->id;
+        return S_OK;
+    }
+
+    if (grfHLNF & HLNF_CREATENOHISTORY)
+    {
+        /* the navigation is not recorded */
+        if (puHLID) *puHLID = This->current ? This->current->id : HLID_INVALID;
+        return S_OK;
+    }
+
+    /* a new navigation drops the entries after the current one and goes on top */
+    if (This->current)
+    {
+        struct list *next;
+        while ((next = list_next(&This->links, &This->current->entry)))
+            context_remove_entry(This, LIST_ENTRY(next, struct link_entry, entry));
+    }
+
+    entry = malloc(sizeof(*entry));
+    if (!entry) return E_OUTOFMEMORY;
+    hr = HlinkCreateFromMoniker(pmkTarget, pwzLocation, pwzFriendlyName, NULL, 0, NULL, &IID_IHlink,
+            (void **)&entry->link);
+    if (FAILED(hr))
+    {
+        free(entry);
+        return hr;
+    }
+    entry->id = ++This->next_id;
+    list_add_tail(&This->links, &entry->entry);
+    This->current = entry;
+    if (puHLID) *puHLID = entry->id;
+    return S_OK;
+}
