+    if (FAILED(hr = hlink_check_format(pformatetcIn))) return hr;
+
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, FALSE, &stream))) return hr;
+    hr = hlink_render_stream(This, stream);
+    if (FAILED(hr))
+    {
+        HGLOBAL h;
+        GetHGlobalFromStream(stream, &h);
+        IStream_Release(stream);
+        GlobalFree(h);
+        return hr;
+    }
+
+    if (pformatetcIn->tymed & TYMED_HGLOBAL)
+    {
+        HGLOBAL h;
+        LARGE_INTEGER zero = {{0}};
+        ULARGE_INTEGER size;
+
+        GetHGlobalFromStream(stream, &h);
+        IStream_Seek(stream, zero, STREAM_SEEK_CUR, &size);
+        IStream_Release(stream);
+        GlobalReAlloc(h, size.LowPart, GMEM_MOVEABLE);
+        pmedium->tymed = TYMED_HGLOBAL;
+        pmedium->hGlobal = h;
+        return S_OK;
+    }
+
+    {
+        LARGE_INTEGER zero = {{0}};
+        IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+        pmedium->tymed = TYMED_ISTREAM;
+        pmedium->pstm = stream;
+    }
+    return S_OK;
 }
 
