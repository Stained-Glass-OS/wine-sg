+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <windef.h>
+#include <winbase.h>
+#include <winreg.h>
+#include <winuser.h>
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(handoff);
+
+/* TRUE if path names a file in directory dir (no further separator) */
+static BOOL in_dir( const WCHAR *path, const WCHAR *dir )
+{
+    size_t len = wcslen( dir );
+    if (!len || wcsnicmp( path, dir, len )) return FALSE;
+    if (dir[len - 1] != '\\')
+    {
+        if (path[len] != '\\') return FALSE;
+        len++;
+    }
+    return !wcschr( path + len, '\\' );
+}
+
+int WINAPI wWinMain( HINSTANCE inst, HINSTANCE prev, WCHAR *args, int show )
+{
+    WCHAR self[MAX_PATH], key[MAX_PATH + 64], target[MAX_PATH], dir[MAX_PATH], msg[MAX_PATH + 128];
+    WCHAR *name, *cmd;
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    DWORD size = sizeof(target);
+    HKEY hkey;
+    LONG err;
+    size_t len;
+
+    if (!GetModuleFileNameW( NULL, self, MAX_PATH )) return 1;
+    name = wcsrchr( self, '\\' ) ? wcsrchr( self, '\\' ) + 1 : self;
+    swprintf( key, ARRAY_SIZE(key), L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\%s", name );
+
+    /* the 64-bit view, where App Paths are registered, from the 32-bit copy too;
+     * RRF_RT_REG_SZ also takes (and expands) REG_EXPAND_SZ */
+    err = RegOpenKeyExW( HKEY_LOCAL_MACHINE, key, 0, KEY_QUERY_VALUE | KEY_WOW64_64KEY, &hkey );
+    if (!err)
+    {
+        err = RegGetValueW( hkey, NULL, NULL, RRF_RT_REG_SZ, NULL, target, &size );
+        RegCloseKey( hkey );
+    }
+    if (!err && GetFileAttributesW( target ) != INVALID_FILE_ATTRIBUTES)
+    {
+        /* never ourselves, nor another of these in a system directory: no loop */
+        BOOL loop = !wcsicmp( target, self );
+        if (GetSystemDirectoryW( dir, MAX_PATH ) && in_dir( target, dir )) loop = TRUE;
+        if (GetSystemWow64DirectoryW( dir, MAX_PATH ) && in_dir( target, dir )) loop = TRUE;
+        if (!loop)
+        {
+            len = wcslen( target ) + wcslen( args ) + 4;
+            if (!(cmd = malloc( len * sizeof(WCHAR) ))) return 1;
+            swprintf( cmd, len, L"\"%s\"%s%s", target, *args ? L" " : L"", args );
+            si.dwFlags = STARTF_USESHOWWINDOW;
+            si.wShowWindow = show;
+            TRACE( "%s -> %s\n", debugstr_w(name), debugstr_w(cmd) );
+            if (CreateProcessW( target, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ))
+            {
+                CloseHandle( pi.hThread );
+                CloseHandle( pi.hProcess );
+                free( cmd );
+                return 0;
+            }
+            WARN( "could not start %s: %lu\n", debugstr_w(target), GetLastError() );
+            free( cmd );
+        }
+    }
+
+    swprintf( msg, ARRAY_SIZE(msg), L"Windows cannot find '%s'. The program it belongs to is not installed.", name );
+    MessageBoxW( NULL, msg, name, MB_OK | MB_ICONERROR );
+    return 1;
+}
