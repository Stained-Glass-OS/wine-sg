     TimelineImpl *This = impl_from_IAMTimeline(iface);
-    FIXME("(%p)->(%p,%p): not implemented!\n", This, start, stop);
-    return E_NOTIMPL;
+    REFERENCE_TIME dirty_start = 0, dirty_stop = 0;
+    BOOL found = FALSE;
+    LONG i;
+
+    TRACE("(%p)->(%p,%p)\n", This, start, stop);
+
+    if (!start || !stop)
+        return E_POINTER;
+
+    for (i = 0; i < This->group_count; ++i)
+    {
+        const TimelineObjImpl *group = This->groups[i];
+
+        if (!group->dirty)
+            continue;
+        if (!found || group->dirty_start < dirty_start) dirty_start = group->dirty_start;
+        if (!found || group->dirty_stop > dirty_stop) dirty_stop = group->dirty_stop;
+        found = TRUE;
+    }
+    *start = dirty_start;
+    *stop = dirty_stop;
+    return S_OK;
 }
 
