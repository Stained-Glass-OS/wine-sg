+
+static void obj_mark_dirty(TimelineObjImpl *obj, REFERENCE_TIME start, REFERENCE_TIME stop)
+{
+    if (obj->dirty)
+    {
+        if (start < obj->dirty_start) obj->dirty_start = start;
+        if (stop > obj->dirty_stop) obj->dirty_stop = stop;
+    }
+    else
+    {
+        obj->dirty = TRUE;
+        obj->dirty_start = start;
+        obj->dirty_stop = stop;
+    }
+}
+
+static HRESULT guid_to_bstr(const GUID *guid, BSTR *out)
+{
+    WCHAR buffer[40];
+
+    StringFromGUID2(guid, buffer, ARRAY_SIZE(buffer));
+    if (!(*out = SysAllocString(buffer)))
+        return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT bstr_to_guid(BSTR str, GUID *guid)
+{
+    if (!str)
+        return E_POINTER;
+    if (FAILED(CLSIDFromString(str, guid)))
+        return E_INVALIDARG;
+    return S_OK;
+}
+
+static REFERENCE_TIME round_to_frame(REFERENCE_TIME time, double fps)
+{
+    double frames = (double)time * fps / 10000000.0;
+    return (REFERENCE_TIME)(floor(frames + 0.5) * 10000000.0 / fps + 0.5);
+}
+
+static void detach_group(TimelineObjImpl *group)
+{
+    group->timeline = NULL;
+}
