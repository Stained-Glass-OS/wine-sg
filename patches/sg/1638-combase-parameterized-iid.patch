+/* Parameterized type instance IIDs, as the WinRT type system defines them:
+ * the IID is a name-based (version 5, SHA-1) UUID made in the namespace
+ * 11f47ad5-7b73-42c0-abae-878b1e16adee from the UTF-8 type signature. */
+
+typedef struct
+{
+    ULONG Unknown[6];
+    ULONG State[5];
+    ULONG Count[2];
+    UCHAR Buffer[64];
+} SHA_CTX;
+
+void WINAPI A_SHAInit(SHA_CTX *);
+void WINAPI A_SHAUpdate(SHA_CTX *, const unsigned char *, unsigned int);
+void WINAPI A_SHAFinal(SHA_CTX *, unsigned char *);
+
+#define PIID_EXTRA_MAGIC 0x44494950  /* "PIID" */
+#define PIID_MAX_DEPTH   64
+
+struct piid_extra
+{
+    DWORD magic;
+    char signature[1];
+};
+
+struct signature
+{
+    char *buf;
+    size_t len, size;
+    BOOL failed;
+};
+
+static void sig_append_len(struct signature *sig, const char *str, size_t len)
+{
+    if (sig->failed) return;
+    if (sig->len + len + 1 > sig->size)
+    {
+        size_t size = max(sig->size * 2, sig->len + len + 64);
+        char *buf = realloc(sig->buf, size);
+        if (!buf) { sig->failed = TRUE; return; }
+        sig->buf = buf;
+        sig->size = size;
+    }
+    memcpy(sig->buf + sig->len, str, len);
+    sig->len += len;
+    sig->buf[sig->len] = 0;
+}
+
+static void sig_append(struct signature *sig, const char *str)
+{
+    sig_append_len(sig, str, strlen(str));
+}
+
+static void sig_append_name(struct signature *sig, const WCHAR *name)
+{
+    int len = WideCharToMultiByte(CP_UTF8, 0, name, -1, NULL, 0, NULL, NULL);
+    char *str;
+
+    if (len <= 0 || !(str = malloc(len))) { sig->failed = TRUE; return; }
+    WideCharToMultiByte(CP_UTF8, 0, name, -1, str, len, NULL, NULL);
+    sig_append(sig, str);
+    free(str);
+}
+
+static void sig_append_guid(struct signature *sig, const GUID *guid)
+{
+    char str[40];
+
+    sprintf(str, "{%08lx-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x}", guid->Data1, guid->Data2, guid->Data3,
+            guid->Data4[0], guid->Data4[1], guid->Data4[2], guid->Data4[3], guid->Data4[4], guid->Data4[5],
+            guid->Data4[6], guid->Data4[7]);
+    sig_append(sig, str);
+}
+
+static const struct
+{
+    const WCHAR *name;
+    const char *signature;
+}
+fundamental_types[] =
+{
+    { L"Boolean", "b1" },
+    { L"Char16", "c2" },
+    { L"Double", "f8" },
+    { L"Guid", "g16" },
+    { L"Int16", "i2" },
+    { L"Int32", "i4" },
+    { L"Int64", "i8" },
+    { L"Int8", "i1" },
+    { L"Object", "cinterface(IInspectable)" },
+    { L"Single", "f4" },
+    { L"String", "string" },
+    { L"UInt16", "u2" },
+    { L"UInt32", "u4" },
+    { L"UInt64", "u8" },
+    { L"UInt8", "u1" },
+};
+
+static const char *fundamental_signature(const WCHAR *name)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(fundamental_types); i++)
+        if (!wcscmp(name, fundamental_types[i].name)) return fundamental_types[i].signature;
+    return NULL;
+}
+
+/* number of type arguments a name like "Windows.Foundation.IAsyncOperation`1" takes */
+static UINT32 generic_arity(const WCHAR *name)
+{
+    const WCHAR *tick = wcsrchr(name, '`');
+    return tick ? wcstoul(tick + 1, NULL, 10) : 0;
+}
+
+enum metadata_kind
+{
+    METADATA_NONE,
+    METADATA_INTERFACE,
+    METADATA_DELEGATE,
+    METADATA_INTERFACE_GROUP,
+    METADATA_RUNTIME_CLASS,
+    METADATA_STRUCT,
+    METADATA_ENUM,
+    METADATA_PINTERFACE,
+};
+
+/* what a locator told us about one type */
+struct metadata_builder
+{
+    IRoSimpleMetaDataBuilder IRoSimpleMetaDataBuilder_iface;
+    enum metadata_kind kind;
+    GUID iid;
+    BOOL has_iid;
+    WCHAR *name;
+    WCHAR *default_name;
+    UINT32 count;
+    WCHAR **elements;
+    UINT32 arg_count;
+    HRESULT error;
+};
+
+static inline struct metadata_builder *impl_from_IRoSimpleMetaDataBuilder(IRoSimpleMetaDataBuilder *iface)
+{
+    return CONTAINING_RECORD(iface, struct metadata_builder, IRoSimpleMetaDataBuilder_iface);
+}
+
+static HRESULT builder_set_kind(struct metadata_builder *builder, enum metadata_kind kind)
+{
+    /* a locator describes the type it was asked for exactly once */
+    if (builder->kind != METADATA_NONE) return builder->error = E_UNEXPECTED;
+    builder->kind = kind;
+    return S_OK;
+}
+
+static HRESULT builder_copy_name(struct metadata_builder *builder, WCHAR **dst, const WCHAR *src)
+{
+    if (!src || !src[0]) return builder->error = E_INVALIDARG;
+    if (!(*dst = wcsdup(src))) return builder->error = E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT builder_copy_elements(struct metadata_builder *builder, UINT32 count, const WCHAR **elements)
+{
+    UINT32 i;
+    HRESULT hr;
+
+    if (!count || !elements) return builder->error = E_INVALIDARG;
+    if (!(builder->elements = calloc(count, sizeof(*builder->elements)))) return builder->error = E_OUTOFMEMORY;
+    builder->count = count;
+    for (i = 0; i < count; i++)
+        if (FAILED(hr = builder_copy_name(builder, &builder->elements[i], elements[i]))) return hr;
+    return S_OK;
+}
+
+static HRESULT WINAPI builder_SetWinRtInterface(IRoSimpleMetaDataBuilder *iface, GUID iid)
+{
+    struct metadata_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+    HRESULT hr;
+
+    TRACE("%p, %s.\n", iface, debugstr_guid(&iid));
+
+    if (FAILED(hr = builder_set_kind(builder, METADATA_INTERFACE))) return hr;
+    builder->iid = iid;
+    builder->has_iid = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI builder_SetDelegate(IRoSimpleMetaDataBuilder *iface, GUID iid)
+{
+    struct metadata_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+    HRESULT hr;
+
+    TRACE("%p, %s.\n", iface, debugstr_guid(&iid));
+
+    if (FAILED(hr = builder_set_kind(builder, METADATA_DELEGATE))) return hr;
+    builder->iid = iid;
+    builder->has_iid = TRUE;
+    return S_OK;
+}
+
+static HRESULT builder_set_simple_default(struct metadata_builder *builder, enum metadata_kind kind,
+                                          const WCHAR *name, const WCHAR *default_name, const GUID *default_iid)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = builder_set_kind(builder, kind))) return hr;
+    if (FAILED(hr = builder_copy_name(builder, &builder->name, name))) return hr;
+    if (default_iid)
+    {
+        builder->iid = *default_iid;
+        builder->has_iid = TRUE;
+    }
+    else if (FAILED(hr = builder_copy_name(builder, &builder->default_name, default_name))) return hr;
+    return S_OK;
+}
+
+static HRESULT builder_set_parameterized_default(struct metadata_builder *builder, enum metadata_kind kind,
+                                                 const WCHAR *name, UINT32 count, const WCHAR **elements)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = builder_set_kind(builder, kind))) return hr;
+    if (FAILED(hr = builder_copy_name(builder, &builder->name, name))) return hr;
+    return builder_copy_elements(builder, count, elements);
+}
+
+static HRESULT WINAPI builder_SetInterfaceGroupSimpleDefault(IRoSimpleMetaDataBuilder *iface, const WCHAR *name,
+                                                             const WCHAR *default_name, const GUID *default_iid)
+{
+    TRACE("%p, %s, %s, %s.\n", iface, debugstr_w(name), debugstr_w(default_name), debugstr_guid(default_iid));
+    return builder_set_simple_default(impl_from_IRoSimpleMetaDataBuilder(iface), METADATA_INTERFACE_GROUP,
+                                      name, default_name, default_iid);
+}
+
+static HRESULT WINAPI builder_SetInterfaceGroupParameterizedDefault(IRoSimpleMetaDataBuilder *iface, const WCHAR *name,
+                                                                    UINT32 count, const WCHAR **elements)
+{
+    TRACE("%p, %s, %u, %p.\n", iface, debugstr_w(name), count, elements);
+    return builder_set_parameterized_default(impl_from_IRoSimpleMetaDataBuilder(iface), METADATA_INTERFACE_GROUP,
+                                             name, count, elements);
+}
+
+static HRESULT WINAPI builder_SetRuntimeClassSimpleDefault(IRoSimpleMetaDataBuilder *iface, const WCHAR *name,
+                                                           const WCHAR *default_name, const GUID *default_iid)
+{
+    TRACE("%p, %s, %s, %s.\n", iface, debugstr_w(name), debugstr_w(default_name), debugstr_guid(default_iid));
+    return builder_set_simple_default(impl_from_IRoSimpleMetaDataBuilder(iface), METADATA_RUNTIME_CLASS,
+                                      name, default_name, default_iid);
+}
+
+static HRESULT WINAPI builder_SetRuntimeClassParameterizedDefault(IRoSimpleMetaDataBuilder *iface, const WCHAR *name,
+                                                                  UINT32 count, const WCHAR **elements)
+{
+    TRACE("%p, %s, %u, %p.\n", iface, debugstr_w(name), count, elements);
+    return builder_set_parameterized_default(impl_from_IRoSimpleMetaDataBuilder(iface), METADATA_RUNTIME_CLASS,
+                                             name, count, elements);
+}
+
+static HRESULT WINAPI builder_SetStruct(IRoSimpleMetaDataBuilder *iface, const WCHAR *name,
+                                        UINT32 field_count, const WCHAR **fields)
+{
+    struct metadata_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+    HRESULT hr;
+
+    TRACE("%p, %s, %u, %p.\n", iface, debugstr_w(name), field_count, fields);
+
+    if (FAILED(hr = builder_set_kind(builder, METADATA_STRUCT))) return hr;
+    if (FAILED(hr = builder_copy_name(builder, &builder->name, name))) return hr;
+    return builder_copy_elements(builder, field_count, fields);
+}
+
+static HRESULT WINAPI builder_SetEnum(IRoSimpleMetaDataBuilder *iface, const WCHAR *name, const WCHAR *base_type)
+{
+    struct metadata_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+    HRESULT hr;
+
+    TRACE("%p, %s, %s.\n", iface, debugstr_w(name), debugstr_w(base_type));
+
+    if (FAILED(hr = builder_set_kind(builder, METADATA_ENUM))) return hr;
+    if (FAILED(hr = builder_copy_name(builder, &builder->name, name))) return hr;
+    /* enums are Int32, or UInt32 for flags */
+    if (!base_type || (wcscmp(base_type, L"Int32") && wcscmp(base_type, L"UInt32"))) return builder->error = E_INVALIDARG;
+    return builder_copy_name(builder, &builder->default_name, base_type);
+}
+
+static HRESULT builder_set_parameterized(struct metadata_builder *builder, const GUID *piid, UINT32 arg_count)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = builder_set_kind(builder, METADATA_PINTERFACE))) return hr;
+    if (!arg_count) return builder->error = E_INVALIDARG;
+    builder->iid = *piid;
+    builder->has_iid = TRUE;
+    builder->arg_count = arg_count;
+    return S_OK;
+}
+
+static HRESULT WINAPI builder_SetParameterizedInterface(IRoSimpleMetaDataBuilder *iface, GUID piid, UINT32 arg_count)
+{
+    TRACE("%p, %s, %u.\n", iface, debugstr_guid(&piid), arg_count);
+    return builder_set_parameterized(impl_from_IRoSimpleMetaDataBuilder(iface), &piid, arg_count);
+}
+
+static HRESULT WINAPI builder_SetParameterizedDelegate(IRoSimpleMetaDataBuilder *iface, GUID piid, UINT32 arg_count)
+{
+    /* parameterized delegates have the same signature form as parameterized interfaces */
+    TRACE("%p, %s, %u.\n", iface, debugstr_guid(&piid), arg_count);
+    return builder_set_parameterized(impl_from_IRoSimpleMetaDataBuilder(iface), &piid, arg_count);
+}
+
+static const IRoSimpleMetaDataBuilderVtbl metadata_builder_vtbl =
+{
+    builder_SetWinRtInterface,
+    builder_SetDelegate,
+    builder_SetInterfaceGroupSimpleDefault,
+    builder_SetInterfaceGroupParameterizedDefault,
+    builder_SetRuntimeClassSimpleDefault,
+    builder_SetRuntimeClassParameterizedDefault,
+    builder_SetStruct,
+    builder_SetEnum,
+    builder_SetParameterizedInterface,
+    builder_SetParameterizedDelegate,
+};
+
+static void builder_cleanup(struct metadata_builder *builder)
+{
+    UINT32 i;
+
+    free(builder->name);
+    free(builder->default_name);
+    for (i = 0; i < builder->count; i++) free(builder->elements[i]);
+    free(builder->elements);
+}
+
+static HRESULT append_type(struct signature *sig, UINT32 count, const WCHAR **elements, UINT32 *pos,
+                           const IRoMetaDataLocator *locator, unsigned int depth);
+
+/* the signature of a whole type name given as name elements, which must all be used */
+static HRESULT append_type_elements(struct signature *sig, UINT32 count, const WCHAR **elements,
+                                    const IRoMetaDataLocator *locator, unsigned int depth)
+{
+    UINT32 pos = 0;
+    HRESULT hr;
+
+    if (FAILED(hr = append_type(sig, count, elements, &pos, locator, depth))) return hr;
+    return pos == count ? S_OK : RO_E_METADATA_INVALID_TYPE_FORMAT;
+}
+
+static HRESULT append_type_name(struct signature *sig, const WCHAR *name, const IRoMetaDataLocator *locator,
+                                unsigned int depth)
+{
+    return append_type_elements(sig, 1, &name, locator, depth);
+}
+
+static HRESULT append_type(struct signature *sig, UINT32 count, const WCHAR **elements, UINT32 *pos,
+                           const IRoMetaDataLocator *locator, unsigned int depth)
+{
+    struct metadata_builder builder = {{&metadata_builder_vtbl}};
+    const WCHAR *name;
+    const char *fundamental;
+    UINT32 arity, i;
+    HRESULT hr;
+
+    if (*pos >= count) return RO_E_METADATA_INVALID_TYPE_FORMAT;
+    if (depth > PIID_MAX_DEPTH) return RO_E_METADATA_INVALID_TYPE_FORMAT;
+    name = elements[(*pos)++];
+    if (!name || !name[0]) return E_INVALIDARG;
+
+    arity = generic_arity(name);
+    if (!arity && (fundamental = fundamental_signature(name)))
+    {
+        sig_append(sig, fundamental);
+        return sig->failed ? E_OUTOFMEMORY : S_OK;
+    }
+
+    if (!locator) return RO_E_METADATA_NAME_NOT_FOUND;
+    hr = IRoMetaDataLocator_Locate((IRoMetaDataLocator *)locator, name, &builder.IRoSimpleMetaDataBuilder_iface);
+    if (SUCCEEDED(hr) && FAILED(builder.error)) hr = builder.error;
+    if (SUCCEEDED(hr) && builder.kind == METADATA_NONE) hr = RO_E_METADATA_NAME_NOT_FOUND;
+    if (FAILED(hr))
+    {
+        WARN("could not locate %s, hr %#lx.\n", debugstr_w(name), hr);
+        builder_cleanup(&builder);
+        return hr;
+    }
+
+    /* only generic types take type arguments, and they take as many as their name says */
+    if ((builder.kind == METADATA_PINTERFACE) != (arity != 0) || (arity && builder.arg_count != arity))
+    {
+        WARN("%s: kind %u with %u arguments, name says %u.\n", debugstr_w(name), builder.kind, builder.arg_count, arity);
+        builder_cleanup(&builder);
+        return RO_E_METADATA_INVALID_TYPE_FORMAT;
+    }
+
+    switch (builder.kind)
+    {
+    case METADATA_INTERFACE:
+        sig_append_guid(sig, &builder.iid);
+        break;
+
+    case METADATA_DELEGATE:
+        sig_append(sig, "delegate(");
+        sig_append_guid(sig, &builder.iid);
+        sig_append(sig, ")");
+        break;
+
+    case METADATA_INTERFACE_GROUP:
+    case METADATA_RUNTIME_CLASS:
+        sig_append(sig, builder.kind == METADATA_RUNTIME_CLASS ? "rc(" : "ig(");
+        sig_append_name(sig, builder.name);
+        sig_append(sig, ";");
+        /* followed by the signature of the default interface */
+        if (builder.count)
+            hr = append_type_elements(sig, builder.count, (const WCHAR **)builder.elements, locator, depth + 1);
+        else if (builder.has_iid)
+            sig_append_guid(sig, &builder.iid);
+        else
+            hr = append_type_name(sig, builder.default_name, locator, depth + 1);
+        sig_append(sig, ")");
+        break;
+
+    case METADATA_STRUCT:
+        sig_append(sig, "struct(");
+        sig_append_name(sig, builder.name);
+#ifndef SG_MUTANT_NO_STRUCT_FIELDS
+        for (i = 0; i < builder.count && SUCCEEDED(hr); i++)
+        {
+            sig_append(sig, ";");
+            hr = append_type_name(sig, builder.elements[i], locator, depth + 1);
+        }
+#endif
+        sig_append(sig, ")");
+        break;
+
+    case METADATA_ENUM:
+        sig_append(sig, "enum(");
+        sig_append_name(sig, builder.name);
+        sig_append(sig, wcscmp(builder.default_name, L"UInt32") ? ";i4)" : ";u4)");
+        break;
+
+    case METADATA_PINTERFACE:
+        sig_append(sig, "pinterface(");
+        sig_append_guid(sig, &builder.iid);
+        for (i = 0; i < builder.arg_count && SUCCEEDED(hr); i++)
+        {
+            sig_append(sig, ";");
+            hr = append_type(sig, count, elements, pos, locator, depth + 1);
+        }
+        sig_append(sig, ")");
+        break;
+
+    case METADATA_NONE:
+        break;
+    }
+
+    builder_cleanup(&builder);
+    if (SUCCEEDED(hr) && sig->failed) hr = E_OUTOFMEMORY;
+    return hr;
+}
+
+static void iid_from_signature(const char *signature, GUID *iid)
+{
+    static const BYTE namespace[16] =
+    {
+        0x11, 0xf4, 0x7a, 0xd5, 0x7b, 0x73, 0x42, 0xc0, 0xab, 0xae, 0x87, 0x8b, 0x1e, 0x16, 0xad, 0xee
+    };
+    BYTE hash[20];
+    SHA_CTX ctx;
+
+    A_SHAInit(&ctx);
+    A_SHAUpdate(&ctx, namespace, sizeof(namespace));
+    A_SHAUpdate(&ctx, (const unsigned char *)signature, strlen(signature));
+    A_SHAFinal(&ctx, hash);
+
+#ifndef SG_MUTANT_NO_UUID_VERSION
+    hash[6] = (hash[6] & 0x0f) | 0x50;  /* version 5 */
+    hash[8] = (hash[8] & 0x3f) | 0x80;  /* RFC 4122 variant */
+#endif
+
+    iid->Data1 = (hash[0] << 24) | (hash[1] << 16) | (hash[2] << 8) | hash[3];
+    iid->Data2 = (hash[4] << 8) | hash[5];
+    iid->Data3 = (hash[6] << 8) | hash[7];
+    memcpy(iid->Data4, hash + 8, sizeof(iid->Data4));
+}
+
