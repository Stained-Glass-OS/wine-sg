+    iid_from_signature(sig.buf, iid);
+
+    if (hiid)
+    {
+        if (!(extra = malloc(offsetof(struct piid_extra, signature[sig.len + 1]))))
+        {
+            free(sig.buf);
+            *iid = GUID_NULL;
+            return E_OUTOFMEMORY;
+        }
+        extra->magic = PIID_EXTRA_MAGIC;
+        memcpy(extra->signature, sig.buf, sig.len + 1);
+        *hiid = extra;
+    }
+    free(sig.buf);
+    return S_OK;
+}
+
+/***********************************************************************
+ *      RoFreeParameterizedTypeExtra (combase.@)
+ */
+void WINAPI RoFreeParameterizedTypeExtra(ROPARAMIIDHANDLE handle)
+{
+    struct piid_extra *extra = handle;
+
+    TRACE("%p.\n", handle);
+
+    if (!extra || extra->magic != PIID_EXTRA_MAGIC) return;
+    extra->magic = 0;
+    free(extra);
+}
+
+/***********************************************************************
+ *      RoParameterizedTypeExtraGetTypeSignature (combase.@)
+ */
+const char * WINAPI RoParameterizedTypeExtraGetTypeSignature(ROPARAMIIDHANDLE handle)
+{
+    struct piid_extra *extra = handle;
+
+    TRACE("%p.\n", handle);
+
+    if (!extra || extra->magic != PIID_EXTRA_MAGIC) return NULL;
+    return extra->signature;
 }
 
