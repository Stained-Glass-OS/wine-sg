From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ngen, aspnet_regiis, servicemodelreg: Say what they do instead of succeeding silently (6067)

ngen's actions succeed saying no native image is generated (the runtime
compiles on demand) and an unknown one fails; aspnet_regiis and
servicemodelreg list nothing and refuse to change the web server or the
machine configuration, with a message and exit code 1.
---
diff --git a/programs/aspnet_regiis/main.c b/programs/aspnet_regiis/main.c
index d1bf436..10659ae 100644
--- a/programs/aspnet_regiis/main.c
+++ b/programs/aspnet_regiis/main.c
@@ -16,18 +16,69 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
+/*
+ * Stained Glass OS: aspnet_regiis, the ASP.NET IIS registration tool, from its documented command
+ * line. There is no IIS here to register ASP.NET with, and the other options (granting accounts access
+ * to keys and folders, encrypting configuration sections with machine keys, changing scriptmaps) are
+ * machine-wide security changes that this tool does not make: they are refused with a message and exit
+ * code 1. -lv and -lk list what is registered, which is nothing.
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <windows.h>
+
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(aspnet_regiis);
 
-int __cdecl wmain(int argc, WCHAR *argv[])
+#define USAGE L"Administration utility to install and uninstall ASP.NET on the local machine.\r\n\r\n" \
+              L"aspnet_regiis.exe [-i[r] | -u[a] | -s path | -k path | -lv | -lk | -ga user | -pe | -pd ...]\r\n"
+#define REFUSAL L"aspnet_regiis: IIS is not installed on this system, and this tool does not change the machine's\r\n" \
+                L"web server, scriptmaps, key containers or access rights. Nothing was changed.\r\n"
+
+static void out( const WCHAR *fmt, ... )
 {
-    int i;
+    WCHAR buf[1024];
+    DWORD written;
+    va_list args;
+    int len, size;
+    char *str;
+
+    va_start( args, fmt );
+    len = vswprintf( buf, ARRAY_SIZE(buf), fmt, args );
+    va_end( args );
+    if (len <= 0) return;
+    if (WriteConsoleW( GetStdHandle( STD_OUTPUT_HANDLE ), buf, len, &written, NULL )) return;
+    size = WideCharToMultiByte( GetOEMCP(), 0, buf, len, NULL, 0, NULL, NULL );
+    if (!(str = malloc( size ))) return;
+    WideCharToMultiByte( GetOEMCP(), 0, buf, len, str, size, NULL, NULL );
+    WriteFile( GetStdHandle( STD_OUTPUT_HANDLE ), str, size, &written, NULL );
+    free( str );
+}
 
-    WINE_FIXME("stub:");
-    for (i = 0; i < argc; i++)
-        WINE_FIXME(" %s", wine_dbgstr_w(argv[i]));
-    WINE_FIXME("\n");
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    int i;
 
-    return 0;
+    TRACE( "%d arguments\n", argc );
+    if (argc < 2) { out( L"%ls", USAGE ); return 0; }
+    for (i = 1; i < argc; i++)
+    {
+        const WCHAR *a = argv[i];
+        if (a[0] != '-' && a[0] != '/') continue;
+        if (!wcscmp( a + 1, L"?" ) || !wcsicmp( a + 1, L"help" )) { out( L"%ls", USAGE ); return 0; }
+        if (!wcsicmp( a + 1, L"lv" ) || !wcsicmp( a + 1, L"lk" ))
+        {
+            /* the versions and scriptmaps registered with IIS: none */
+            return 0;
+        }
+#ifdef SG_MUTANT_REGIIS_ACCEPT
+        return 0;
+#endif
+    }
+    /* everything else changes the machine's web server or framework configuration */
+    out( L"%ls", REFUSAL );
+    return 1;
 }
diff --git a/programs/ngen/ngen_main.c b/programs/ngen/ngen_main.c
index 024d8b1..5fb1bdd 100644
--- a/programs/ngen/ngen_main.c
+++ b/programs/ngen/ngen_main.c
@@ -16,18 +16,114 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
+/*
+ * Stained Glass OS: ngen, the native image generator, from its documented command line. The runtime here
+ * compiles every assembly when it runs and keeps no native image cache, so there is nothing to generate:
+ * install, update and the queue's work succeed with that said (an installer's ngen step is an
+ * optimization, the assembly runs either way), display lists no native images, uninstall has none to
+ * remove. Anything else is refused with the usage.
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <windows.h>
+
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(ngen);
 
-int __cdecl wmain(int argc, WCHAR *argv[])
+static void out( const WCHAR *fmt, ... )
 {
-    int i;
+    WCHAR buf[1024];
+    DWORD written;
+    va_list args;
+    int len, size;
+    char *str;
+
+    va_start( args, fmt );
+    len = vswprintf( buf, ARRAY_SIZE(buf), fmt, args );
+    va_end( args );
+    if (len <= 0) return;
+    if (WriteConsoleW( GetStdHandle( STD_OUTPUT_HANDLE ), buf, len, &written, NULL )) return;
+    size = WideCharToMultiByte( GetOEMCP(), 0, buf, len, NULL, 0, NULL, NULL );
+    if (!(str = malloc( size ))) return;
+    WideCharToMultiByte( GetOEMCP(), 0, buf, len, str, size, NULL, NULL );
+    WriteFile( GetStdHandle( STD_OUTPUT_HANDLE ), str, size, &written, NULL );
+    free( str );
+}
+
+static int usage( void )
+{
+    out( L"Usage: ngen <action> [args] [/nologo] [/silent] [/verbose]\r\n"
+         L"    ngen install <assembly name | assembly path> [/queue[:{1|2|3}]]\r\n"
+         L"    ngen uninstall <assembly name | assembly path>\r\n"
+         L"    ngen update [/queue]\r\n"
+         L"    ngen display [assembly name | assembly path]\r\n"
+         L"    ngen executeQueuedItems [1|2|3]\r\n"
+         L"    ngen queue {pause|continue|status}\r\n" );
+    return -1;
+}
 
-    WINE_FIXME("stub:");
-    for (i = 0; i < argc; i++)
-        WINE_FIXME(" %s", wine_dbgstr_w(argv[i]));
-    WINE_FIXME("\n");
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    const WCHAR *action = NULL, *arg = NULL;
+    BOOL nologo = FALSE, silent = FALSE;
+    int i;
 
-    return 0;
+    TRACE( "%d arguments\n", argc );
+    for (i = 1; i < argc; i++)
+    {
+        if (argv[i][0] == '/' || argv[i][0] == '-')
+        {
+            if (!wcsicmp( argv[i] + 1, L"nologo" )) nologo = TRUE;
+            else if (!wcsicmp( argv[i] + 1, L"silent" )) silent = nologo = TRUE;
+            else if (!wcsicmp( argv[i] + 1, L"?" ) || !wcsicmp( argv[i] + 1, L"help" )) return usage(), 0;
+            /* /queue, /verbose, /debug, /profile, /AppBase: options of the actions */
+        }
+        else if (!action) action = argv[i];
+        else if (!arg) arg = argv[i];
+    }
+    if (!nologo) out( L"Native Image Generator (ngen)\r\n\r\n" );
+    if (!action) return usage();
+    if (!wcsicmp( action, L"install" ))
+    {
+        if (!arg) return usage();
+        if (!silent) out( L"Installing assembly %ls\r\n"
+                          L"No native image is generated: the runtime compiles the assembly when it runs.\r\n", arg );
+        return 0;
+    }
+    if (!wcsicmp( action, L"uninstall" ))
+    {
+        if (!arg) return usage();
+        if (!silent) out( L"Uninstalling assembly %ls\r\nThere is no native image of it to remove.\r\n", arg );
+        return 0;
+    }
+    if (!wcsicmp( action, L"update" ) || !wcsicmp( action, L"executeQueuedItems" ))
+    {
+#ifdef SG_MUTANT_NGEN_FAIL_UPDATE
+        return -1;
+#endif
+        if (!silent) out( L"All compilation targets are up to date.\r\n" );
+        return 0;
+    }
+    if (!wcsicmp( action, L"display" ))
+    {
+        out( L"NGEN Roots:\r\n\r\nNative Images:\r\n\r\n" );
+        return 0;
+    }
+    if (!wcsicmp( action, L"queue" ))
+    {
+        if (!arg) return usage();
+        if (!wcsicmp( arg, L"status" ))
+        {
+            out( L"Service name is: clr_optimization_service\r\nThe service has no queued work.\r\n" );
+            return 0;
+        }
+        if (!wcsicmp( arg, L"pause" ) || !wcsicmp( arg, L"continue" )) return 0;
+        return usage();
+    }
+    WINE_FIXME( "action %s\n", wine_dbgstr_w( action ) );
+    out( L"Unknown action: %ls\r\n\r\n", action );
+    return usage();
 }
diff --git a/programs/servicemodelreg/main.c b/programs/servicemodelreg/main.c
index a6b4443..b3eb331 100644
--- a/programs/servicemodelreg/main.c
+++ b/programs/servicemodelreg/main.c
@@ -16,18 +16,61 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
+/*
+ * Stained Glass OS: ServiceModelReg, the WCF registration tool, from its documented command line. It
