+/* The paging files of a Linux host are its swap areas: files, partitions and zram devices listed in /proc/swaps
+ * (Filename Type Size Used Priority, sizes in KB). Their names are shown as paths on the Z: drive. */
+struct swap_area
+{
+    WCHAR  *name;
+    UINT32  size_mb, used_mb;
+};
+
+static UINT read_swaps( struct swap_area **ret )
+{
+    HANDLE file = CreateFileW( L"\\\\?\\unix\\proc\\swaps", GENERIC_READ, FILE_SHARE_READ|FILE_SHARE_WRITE, NULL,
+                               OPEN_EXISTING, 0, 0 );
+    char *data = NULL, *line, *next;
+    DWORD size = 0, read, cap = 0;
+    struct swap_area *areas = NULL;
+    UINT count = 0;
+
+    *ret = NULL;
+    if (file == INVALID_HANDLE_VALUE) return 0;
+    for (;;)
+    {
+        char *new;
+        if (size + 4097 > cap)
+        {
+            cap = cap ? cap * 2 : 8192;
+            if (cap > 1024 * 1024 || !(new = realloc( data, cap ))) goto done;
+            data = new;
+        }
+        if (!ReadFile( file, data + size, cap - size - 1, &read, NULL ) || !read) break;
+        size += read;
+    }
+    if (!data) goto done;
+    data[size] = 0;
+    for (line = data, next = strchr( line, '\n' ); line && *line; line = next, next = next ? strchr( next, '\n' ) : NULL)
+    {
+        char path[1024], type[32];
+        unsigned long long kb, used_kb;
+        struct swap_area *new;
+        WCHAR *name;
+        int i, len;
+
+        if (next) *next++ = 0;
+        if (!strncmp( line, "Filename", 8 )) continue;
+        /* the file name may contain spaces: it ends where the type column begins (\\040 escapes are not decoded) */
+        if (sscanf( line, "%1023s %31s %llu %llu", path, type, &kb, &used_kb ) != 4) continue;
+        len = strlen( path );
+        if (path[0] != '/' || !(name = malloc( (len + 3) * sizeof(WCHAR) ))) continue;
+        name[0] = 'Z';
+        name[1] = ':';
+        for (i = 0; i < len; i++) name[i + 2] = path[i] == '/' ? '\\' : (unsigned char)path[i];
+        name[len + 2] = 0;
+        if (!(new = realloc( areas, (count + 1) * sizeof(*areas) ))) { free( name ); break; }
+        areas = new;
+        areas[count].name    = name;
+        areas[count].size_mb = kb / 1024;
+        areas[count].used_mb = used_kb / 1024;
+        count++;
+    }
+done:
+    free( data );
+    CloseHandle( file );
+    *ret = areas;
+    return count;
+}
+
+static void free_swaps( struct swap_area *areas, UINT count )
+{
+    UINT i;
+    for (i = 0; i < count; i++) free( areas[i].name );
+    free( areas );
+}
+
+static enum fill_status fill_pagefileusage( struct table *table, const struct expr *cond )
+{
+    struct record_pagefileusage *rec;
+    enum fill_status status = FILL_STATUS_UNFILTERED;
+    struct swap_area *areas;
+    UINT i, row = 0, count = read_swaps( &areas );
+
+    if (!count) { table->num_rows = 0; return status; }
+    if (!resize_table( table, count, sizeof(*rec) )) { free_swaps( areas, count ); return FILL_STATUS_FAILED; }
+    for (i = 0; i < count; i++)
+    {
+        rec = (struct record_pagefileusage *)(table->data + row * sizeof(*rec));
+        rec->allocatedbasesize = areas[i].size_mb;
+        rec->caption           = wcsdup( areas[i].name );
+        rec->currentusage      = areas[i].used_mb;
+        rec->description       = wcsdup( areas[i].name );
+        rec->name              = wcsdup( areas[i].name );
+        rec->peakusage         = areas[i].used_mb; /* the kernel does not keep a peak */
+        rec->status            = L"OK";
+        rec->temppagefile      = 0;
+        if (!match_row( table, row, cond, &status )) free_row_values( table, row );
+        else row++;
+    }
+    free_swaps( areas, count );
+    TRACE("created %u rows\n", row);
+    table->num_rows = row;
+    return status;
+}
+
+static enum fill_status fill_pagefilesetting( struct table *table, const struct expr *cond )
+{
+    struct record_pagefilesetting *rec;
+    enum fill_status status = FILL_STATUS_UNFILTERED;
+    struct swap_area *areas;
+    UINT i, row = 0, count = read_swaps( &areas );
+
+    if (!count) { table->num_rows = 0; return status; }
+    if (!resize_table( table, count, sizeof(*rec) )) { free_swaps( areas, count ); return FILL_STATUS_FAILED; }
+    for (i = 0; i < count; i++)
+    {
+        WCHAR *id = malloc( (wcslen( areas[i].name ) + 16) * sizeof(WCHAR) );
+        rec = (struct record_pagefilesetting *)(table->data + row * sizeof(*rec));
+        rec->caption     = wcsdup( areas[i].name );
+        rec->description = wcsdup( areas[i].name );
+        rec->initialsize = areas[i].size_mb; /* a swap area has a fixed size */
+        rec->maximumsize = areas[i].size_mb;
+        rec->name        = wcsdup( areas[i].name );
+        if (id) swprintf( id, wcslen( areas[i].name ) + 16, L"%s @ %u", areas[i].name, i );
+        rec->settingid   = id;
+        if (!match_row( table, row, cond, &status )) free_row_values( table, row );
+        else row++;
+    }
+    free_swaps( areas, count );
+    TRACE("created %u rows\n", row);
+    table->num_rows = row;
+    return status;
+}
