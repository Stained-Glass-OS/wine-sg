From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cabinet: FDITruncateCabinet drops the link to the next cabinet with the last folder (5913)

FDITruncateCabinet is stubs-6d 5611's (fast-a 3306's copy was dropped as a
duplicate). 3306 also took the link to the next cabinet away with the last
folder: what continues into the next cabinet belongs to the last folder, so
once that folder is gone the header must not name a next cabinet. 5611 kept
cfheadNEXT_CABINET and the next cabinet's names. Ported: when folders are
removed the flag is cleared and the two names leave the header (the folder
and file tables move up accordingly); the previous cabinet's names stay.

Integration patch (integ-2026-10): no behaviour of the dropped implementation
is lost (coordinator rule). Gates: fastcab (3306), the cabinet conformance
test of 5611. Mutant SG_MUTANT_CAB_KEEP_NEXT.
---
diff --git a/dlls/cabinet/fdi.c b/dlls/cabinet/fdi.c
--- a/dlls/cabinet/fdi.c
+++ b/dlls/cabinet/fdi.c
@@ -2858,7 +2858,7 @@ BOOL __cdecl FDITruncateCabinet(
   cab_ULONG file_size, cabsize, coff_files, data_start, hdr_len, folder_len, new_files_off, new_size;
   cab_UWORD flags, num_folders, num_files, kept_files = 0, header_resv = 0;
   cab_UBYTE folder_resv = 0, block_resv = 0;
-  cab_ULONG pos, written;
+  cab_ULONG pos, written, next_names = 0, next_len = 0;
   INT_PTR hf;
   BOOL ret = FALSE;
   unsigned int i, j;
@@ -2927,10 +2927,12 @@ BOOL __cdecl FDITruncateCabinet(
   {
     static const cab_UWORD names[4] = { cfheadPREV_CABINET, cfheadPREV_CABINET, cfheadNEXT_CABINET, cfheadNEXT_CABINET };
     if (!(flags & names[i])) continue;
+    if (i == 2) next_names = pos;
     while (pos < cabsize && old[pos]) pos++;
     if (pos >= cabsize) goto corrupt;
     pos++;
   }
+  if (flags & cfheadNEXT_CABINET) next_len = pos - next_names;
   hdr_len = pos;
   folder_len = cffold_SIZEOF + folder_resv;
   if (hdr_len + (cab_ULONG)num_folders * folder_len > cabsize) goto corrupt;
@@ -2939,6 +2941,13 @@ BOOL __cdecl FDITruncateCabinet(
   files = old + coff_files;
 
   if (iFolderToDelete > num_folders) iFolderToDelete = num_folders;
+  /* the link to the next cabinet goes with the last folder (what continues into it): once that is
+   * gone, the header names no next cabinet (fast-a 3306, ported in 5913) */
+#ifndef SG_MUTANT_CAB_KEEP_NEXT
+  if (iFolderToDelete == num_folders) next_len = 0;
+#else
+  next_len = 0;
+#endif
 
   /* the files that stay; they are listed after the folders, up to the first data block */
   data_start = cabsize;
@@ -2951,7 +2960,7 @@ BOOL __cdecl FDITruncateCabinet(
   if (data_start < coff_files) goto corrupt;
   if (!num_folders) data_start = cabsize;
 
-  new_files_off = hdr_len + (cab_ULONG)iFolderToDelete * folder_len;
+  new_files_off = hdr_len - next_len + (cab_ULONG)iFolderToDelete * folder_len;
   p = files;
   for (j = 0; j < num_files; j++)
   {
@@ -3023,15 +3032,22 @@ BOOL __cdecl FDITruncateCabinet(
     goto done;
   }
 
-  /* header and folders */
-  memcpy( out, old, hdr_len );
+  /* header (without the next cabinet's names when it is no longer continued) and folders */
+  if (next_len)
+  {
+    memcpy( out, old, next_names );
+    memcpy( out + next_names, old + next_names + next_len, hdr_len - next_names - next_len );
+    flags &= ~cfheadNEXT_CABINET;
+    out[cfhead_Flags] = flags; out[cfhead_Flags + 1] = flags >> 8;
+  }
+  else memcpy( out, old, hdr_len );
   out[cfhead_CabinetSize] = new_size; out[cfhead_CabinetSize + 1] = new_size >> 8;
   out[cfhead_CabinetSize + 2] = new_size >> 16; out[cfhead_CabinetSize + 3] = new_size >> 24;
   out[cfhead_FileOffset] = new_files_off; out[cfhead_FileOffset + 1] = new_files_off >> 8;
   out[cfhead_FileOffset + 2] = new_files_off >> 16; out[cfhead_FileOffset + 3] = new_files_off >> 24;
   out[cfhead_NumFolders] = iFolderToDelete; out[cfhead_NumFolders + 1] = iFolderToDelete >> 8;
   out[cfhead_NumFiles] = kept_files; out[cfhead_NumFiles + 1] = kept_files >> 8;
-  memcpy( out + hdr_len, folders, (cab_ULONG)iFolderToDelete * folder_len );
+  memcpy( out + hdr_len - next_len, folders, (cab_ULONG)iFolderToDelete * folder_len );
 
   /* files */
   written = new_files_off;
@@ -3056,7 +3072,7 @@ BOOL __cdecl FDITruncateCabinet(
   /* data, with the folders' offsets moved */
   for (i = 0; i < iFolderToDelete; i++)
   {
-    cab_UBYTE *fold = out + hdr_len + (cab_ULONG)i * folder_len;
+    cab_UBYTE *fold = out + hdr_len - next_len + (cab_ULONG)i * folder_len;
     cab_ULONG off = EndGetI32(fold + cffold_DataOffset), q = off;
     cab_UWORD blocks = EndGetI16(fold + cffold_NumBlocks);
 
