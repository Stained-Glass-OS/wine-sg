From: Stained Glass OS <dev@stained-glass.example>
Subject: win32u, gdi32: CJK Extensions B-G fall back to SimSun-ExtB, HanaMinB, BabelStone Han

The rarer CJK ideographs are beyond the BMP (Extension B, U+20000, and on);
Windows draws them from SimSun-ExtB through its font links. 0171 made GDI
draw characters beyond the BMP; its last-resort list now ends with the
fonts that have these: SimSun-ExtB (Windows'), HanaMinB (Debian's
fonts-hanazono, which Stained Glass installs) and BabelStone Han -- for GDI
text and for Uniscribe's Surrogates script (edit controls).

Gate: test/astral-gate.sh (U+20000 from Liberation Sans is HanaMinB's glyph).
---
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -1527,6 +1527,12 @@
     {'N','o','t','o',' ','S','a','n','s',' ','S','y','m','b','o','l','s','2',0};
 static const WCHAR noto_sans_symbolsW[] =
     {'N','o','t','o',' ','S','a','n','s',' ','S','y','m','b','o','l','s',0};
+static const WCHAR simsun_extbW[] =
+    {'S','i','m','S','u','n','-','E','x','t','B',0};
+static const WCHAR hanaminbW[] =
+    {'H','a','n','a','M','i','n','B',0};
+static const WCHAR babelstone_hanW[] =
+    {'B','a','b','e','l','S','t','o','n','e',' ','H','a','n',0};
 static const WCHAR ms_gothicW[] =
     {'M','S',' ','G','o','t','h','i','c',0};
 static const WCHAR ms_p_gothicW[] =
@@ -2923,12 +2929,15 @@
     }
     /* last, the emoji and symbol fonts: Windows' font links end with Segoe UI
      * Emoji and Segoe UI Symbol; these are the installed ones of those or of
-     * the free fonts that cover the same characters (most beyond the BMP) */
+     * the free fonts that cover the same characters (most beyond the BMP),
+     * then the fonts with the CJK extensions beyond the BMP */
     if (font->charset != OEM_CHARSET)
     {
         static const WCHAR * const symbol_fallbacks[] =
         {
-            segoe_ui_emojiW, segoe_ui_symbolW, noto_emojiW, symbolaW, noto_sans_symbols2W, noto_sans_symbolsW
+            segoe_ui_emojiW, segoe_ui_symbolW, noto_emojiW, symbolaW, noto_sans_symbols2W, noto_sans_symbolsW,
+            /* CJK beyond the BMP (Extensions B-G): Windows' SimSun-ExtB, then free fonts */
+            simsun_extbW, hanaminbW, babelstone_hanW
         };
         unsigned int i;
 
--- a/dlls/gdi32/uniscribe/usp10.c
+++ b/dlls/gdi32/uniscribe/usp10.c
@@ -1899,7 +1899,7 @@
     static const WCHAR * const faces[] =
     {
         L"Segoe UI Emoji", L"Segoe UI Symbol", L"Noto Emoji", L"Symbola",
-        L"Noto Sans Symbols2", L"Noto Sans Symbols", L"SimSun-ExtB",
+        L"Noto Sans Symbols2", L"Noto Sans Symbols", L"SimSun-ExtB", L"HanaMinB", L"BabelStone Han",
     };
     HFONT font, old;
     unsigned int i;
