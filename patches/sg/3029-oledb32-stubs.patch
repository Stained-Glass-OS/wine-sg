+static void free_dbpropinfoset(ULONG count, DBPROPINFOSET *propinfoset)
+{
+    ULONG i;
+
+    for (i = 0; i < count; i++)
+    {
+        ULONG p;
+
+        for (p = 0; p < propinfoset[i].cPropertyInfos; p++)
+            VariantClear(&propinfoset[i].rgPropertyInfos[p].vValues);
+
+        CoTaskMemFree(propinfoset[i].rgPropertyInfos);
+    }
+    CoTaskMemFree(propinfoset);
+}
+
+struct dbinit_prop
+{
+    GUID set;
+    DBPROP prop;
+};
+
+typedef struct
+{
+    IDBInitialize IDBInitialize_iface;
+    IDBProperties IDBProperties_iface;
+
+    LONG ref;
+    BOOL initialized;
+    struct dbinit_prop *props;
+    ULONG count;
+} dbinit;
+
+static inline dbinit *impl_from_IDBInitialize(IDBInitialize *iface)
+{
+    return CONTAINING_RECORD(iface, dbinit, IDBInitialize_iface);
+}
+
+static inline dbinit *impl_from_IDBProperties(IDBProperties *iface)
+{
+    return CONTAINING_RECORD(iface, dbinit, IDBProperties_iface);
+}
+
+static HRESULT WINAPI dbprops_QueryInterface(IDBProperties *iface, REFIID riid, void **ppvObject)
+{
+    dbinit *This = impl_from_IDBProperties(iface);
+
+    return IDBInitialize_QueryInterface(&This->IDBInitialize_iface, riid, ppvObject);
+}
+
+static ULONG WINAPI dbprops_AddRef(IDBProperties *iface)
+{
+    dbinit *This = impl_from_IDBProperties(iface);
+
+    return IDBInitialize_AddRef(&This->IDBInitialize_iface);
+}
+
+static ULONG WINAPI dbprops_Release(IDBProperties *iface)
+{
+    dbinit *This = impl_from_IDBProperties(iface);
+
+    return IDBInitialize_Release(&This->IDBInitialize_iface);
+}
+
+static BOOL is_dbinit_set(const GUID *guid)
+{
+    return IsEqualGUID(guid, &DBPROPSET_DBINIT) || IsEqualGUID(guid, &DBPROPSET_DBINITALL);
+}
+
+static const struct dbproperty *find_known_prop_id(DBPROPID id);
+
+static HRESULT WINAPI dbprops_GetProperties(IDBProperties *iface, ULONG cPropertyIDSets,
+            const DBPROPIDSET rgPropertyIDSets[], ULONG *pcPropertySets, DBPROPSET **prgPropertySets)
+{
+    dbinit *This = impl_from_IDBProperties(iface);
+    ULONG nsets, s, i, j, errors = 0, total = 0;
+    DBPROPSET *sets;
+
+    TRACE("(%p)->(%ld %p %p %p)\n", This, cPropertyIDSets, rgPropertyIDSets, pcPropertySets, prgPropertySets);
+
+    if (!pcPropertySets || !prgPropertySets) return E_INVALIDARG;
+    if (cPropertyIDSets && !rgPropertyIDSets) return E_INVALIDARG;
+
+    *pcPropertySets = 0;
+    *prgPropertySets = NULL;
+
+    for (s = 0; s < cPropertyIDSets; s++)
+        if (rgPropertyIDSets[s].cPropertyIDs && !rgPropertyIDSets[s].rgPropertyIDs)
+            return E_INVALIDARG;
+
+    if (!cPropertyIDSets)
+    {
+        /* all stored properties, grouped by set */
+        ULONG nsets_found = 0;
+        GUID *guids = calloc(This->count + 1, sizeof(*guids));
+
+        if (!guids) return E_OUTOFMEMORY;
+        for (i = 0; i < This->count; i++)
+        {
+            for (j = 0; j < nsets_found; j++)
+                if (IsEqualGUID(&guids[j], &This->props[i].set)) break;
+            if (j == nsets_found) guids[nsets_found++] = This->props[i].set;
+        }
+        if (!nsets_found)
+        {
+            free(guids);
+            return S_OK;
+        }
+        sets = CoTaskMemAlloc(nsets_found * sizeof(*sets));
+        if (!sets) { free(guids); return E_OUTOFMEMORY; }
+        for (s = 0; s < nsets_found; s++)
+        {
+            ULONG n = 0, k = 0;
+
+            for (i = 0; i < This->count; i++)
+                if (IsEqualGUID(&This->props[i].set, &guids[s])) n++;
+            sets[s].guidPropertySet = guids[s];
+            sets[s].cProperties = n;
+            sets[s].rgProperties = CoTaskMemAlloc(n * sizeof(DBPROP));
+            if (!sets[s].rgProperties)
+            {
+                free_dbpropset(s, sets);
+                free(guids);
+                return E_OUTOFMEMORY;
+            }
+            for (i = 0; i < This->count; i++)
+            {
+                if (!IsEqualGUID(&This->props[i].set, &guids[s])) continue;
+                sets[s].rgProperties[k] = This->props[i].prop;
+                VariantInit(&sets[s].rgProperties[k].vValue);
+                VariantCopy(&sets[s].rgProperties[k].vValue, &This->props[i].prop.vValue);
+                sets[s].rgProperties[k].dwStatus = DBPROPSTATUS_OK;
+                k++;
+            }
+        }
+        free(guids);
+        *pcPropertySets = nsets_found;
+        *prgPropertySets = sets;
+        return S_OK;
+    }
+
+    nsets = cPropertyIDSets;
+    sets = CoTaskMemAlloc(nsets * sizeof(*sets));
+    if (!sets) return E_OUTOFMEMORY;
+
+    for (s = 0; s < nsets; s++)
+    {
+        const DBPROPIDSET *req = &rgPropertyIDSets[s];
+        ULONG n = req->cPropertyIDs, k = 0;
+
+        if (!n)
+            for (i = 0; i < This->count; i++)
+                if (IsEqualGUID(&This->props[i].set, &req->guidPropertySet)) n++;
+
+        sets[s].guidPropertySet = req->guidPropertySet;
+        sets[s].cProperties = n;
+        sets[s].rgProperties = CoTaskMemAlloc((n ? n : 1) * sizeof(DBPROP));
+        if (!sets[s].rgProperties)
+        {
+            free_dbpropset(s, sets);
+            return E_OUTOFMEMORY;
+        }
+
+        if (!req->cPropertyIDs)
+        {
+            for (i = 0; i < This->count; i++)
+            {
+                if (!IsEqualGUID(&This->props[i].set, &req->guidPropertySet)) continue;
+                sets[s].rgProperties[k] = This->props[i].prop;
+                VariantInit(&sets[s].rgProperties[k].vValue);
+                VariantCopy(&sets[s].rgProperties[k].vValue, &This->props[i].prop.vValue);
+                sets[s].rgProperties[k].dwStatus = DBPROPSTATUS_OK;
+                k++;
+            }
+            total += n;
+            continue;
+        }
+
+        for (j = 0; j < req->cPropertyIDs; j++)
+        {
+            DBPROP *p = &sets[s].rgProperties[j];
+
+            memset(p, 0, sizeof(*p));
+            p->dwPropertyID = req->rgPropertyIDs[j];
+            p->dwOptions = DBPROPOPTIONS_REQUIRED;
+            VariantInit(&p->vValue);
+            p->dwStatus = DBPROPSTATUS_NOTSUPPORTED;
+            for (i = 0; i < This->count; i++)
+            {
+                if (IsEqualGUID(&This->props[i].set, &req->guidPropertySet) &&
+                    This->props[i].prop.dwPropertyID == p->dwPropertyID)
+                {
+                    p->dwOptions = This->props[i].prop.dwOptions;
+                    VariantCopy(&p->vValue, &This->props[i].prop.vValue);
+                    p->dwStatus = DBPROPSTATUS_OK;
+                    break;
+                }
+            }
+            /* a known but unset initialization property is supported and empty */
+            if (p->dwStatus != DBPROPSTATUS_OK && is_dbinit_set(&req->guidPropertySet))
+            {
+                const struct dbproperty *known = find_known_prop_id(p->dwPropertyID);
+                if (known)
+                {
+                    p->dwStatus = DBPROPSTATUS_OK;
+                    p->dwOptions = known->options;
+                }
+            }
+            if (p->dwStatus != DBPROPSTATUS_OK) errors++;
+        }
+        total += req->cPropertyIDs;
+    }
+
+    *pcPropertySets = nsets;
+    *prgPropertySets = sets;
+    if (errors == 0) return S_OK;
+    return errors == total ? DB_E_ERRORSOCCURRED : DB_S_ERRORSOCCURRED;
+}
+
+static HRESULT WINAPI dbprops_GetPropertyInfo(IDBProperties *iface, ULONG cPropertyIDSets,
+            const DBPROPIDSET rgPropertyIDSets[], ULONG *pcPropertyInfoSets,
+            DBPROPINFOSET **prgPropertyInfoSets, OLECHAR **ppDescBuffer)
+{
+    dbinit *This = impl_from_IDBProperties(iface);
+    DBPROPINFOSET *sets;
+    ULONG s, i, desc_len = 0, errors = 0, total = 0;
+    OLECHAR *desc = NULL, *pos;
+    ULONG nsets;
+    static const DBPROPIDSET all_set = { NULL, 0, { 0 } };
+
+    TRACE("(%p)->(%ld %p %p %p %p)\n", This, cPropertyIDSets, rgPropertyIDSets, pcPropertyInfoSets,
+                prgPropertyInfoSets, ppDescBuffer);
+
+    if (!pcPropertyInfoSets || !prgPropertyInfoSets) return E_INVALIDARG;
+    if (cPropertyIDSets && !rgPropertyIDSets) return E_INVALIDARG;
+
+    *pcPropertyInfoSets = 0;
+    *prgPropertyInfoSets = NULL;
+    if (ppDescBuffer) *ppDescBuffer = NULL;
+
+    (void)all_set;
+    nsets = cPropertyIDSets ? cPropertyIDSets : 1;
+    sets = CoTaskMemAlloc(nsets * sizeof(*sets));
+    if (!sets) return E_OUTOFMEMORY;
+
+    for (i = 0; i < ARRAY_SIZE(dbproperties); i++)
+        desc_len += lstrlenW(dbproperties[i].name) + 1;
+    if (ppDescBuffer)
+    {
+        desc = CoTaskMemAlloc(desc_len * sizeof(OLECHAR));
+        if (!desc) { CoTaskMemFree(sets); return E_OUTOFMEMORY; }
+        pos = desc;
+        for (i = 0; i < ARRAY_SIZE(dbproperties); i++)
+        {
+            lstrcpyW(pos, dbproperties[i].name);
+            pos += lstrlenW(pos) + 1;
+        }
+    }
+
+    for (s = 0; s < nsets; s++)
+    {
+        GUID guid = cPropertyIDSets ? rgPropertyIDSets[s].guidPropertySet : DBPROPSET_DBINIT;
+        ULONG n = cPropertyIDSets ? rgPropertyIDSets[s].cPropertyIDs : 0, j;
+
+        if (!is_dbinit_set(&guid))
+        {
+            sets[s].guidPropertySet = guid;
+            sets[s].cPropertyInfos = 0;
+            sets[s].rgPropertyInfos = NULL;
+            errors++;
+            total++;
+            continue;
+        }
+
+        if (!n) n = ARRAY_SIZE(dbproperties);
+        sets[s].guidPropertySet = guid;
+        sets[s].cPropertyInfos = n;
+        sets[s].rgPropertyInfos = CoTaskMemAlloc(n * sizeof(DBPROPINFO));
+        if (!sets[s].rgPropertyInfos)
+        {
+            free_dbpropinfoset(s, sets);
+            CoTaskMemFree(desc);
+            return E_OUTOFMEMORY;
+        }
+        total += n;
+
+        for (j = 0; j < n; j++)
+        {
+            DBPROPINFO *info = &sets[s].rgPropertyInfos[j];
+            const struct dbproperty *known;
+            ULONG idx;
+
+            memset(info, 0, sizeof(*info));
+            VariantInit(&info->vValues);
+            if (rgPropertyIDSets && rgPropertyIDSets[s].cPropertyIDs)
+                known = find_known_prop_id(rgPropertyIDSets[s].rgPropertyIDs[j]);
+            else
+                known = &dbproperties[j];
+
+            if (!known)
+            {
+                info->dwPropertyID = rgPropertyIDSets[s].rgPropertyIDs[j];
+                info->dwFlags = DBPROPFLAGS_NOTSUPPORTED;
+                errors++;
+                continue;
+            }
+            idx = known - dbproperties;
+            info->dwPropertyID = known->id;
+            info->dwFlags = DBPROPFLAGS_DBINIT | DBPROPFLAGS_READ | DBPROPFLAGS_WRITE;
+            info->vtType = known->type;
+            if (desc)
+            {
+                ULONG k;
+                OLECHAR *d = desc;
+                for (k = 0; k < idx; k++) d += lstrlenW(d) + 1;
+                info->pwszDescription = d;
+            }
+        }
+    }
+
+    *pcPropertyInfoSets = nsets;
+    *prgPropertyInfoSets = sets;
+    if (ppDescBuffer) *ppDescBuffer = desc;
+    if (errors == 0) return S_OK;
+    return errors == total ? DB_E_ERRORSOCCURRED : DB_S_ERRORSOCCURRED;
+}
+
+static HRESULT WINAPI dbprops_SetProperties(IDBProperties *iface, ULONG cPropertySets,
+            DBPROPSET rgPropertySets[])
+{
+    dbinit *This = impl_from_IDBProperties(iface);
+    ULONG s, p, i, errors = 0, total = 0;
+
+    TRACE("(%p)->(%ld %p)\n", This, cPropertySets, rgPropertySets);
+
+    if (cPropertySets && !rgPropertySets) return E_INVALIDARG;
+    for (s = 0; s < cPropertySets; s++)
+        if (rgPropertySets[s].cProperties && !rgPropertySets[s].rgProperties)
+            return E_INVALIDARG;
+
+    for (s = 0; s < cPropertySets; s++)
+    {
+        DBPROPSET *set = &rgPropertySets[s];
+
+        for (p = 0; p < set->cProperties; p++)
+        {
+            DBPROP *in = &set->rgProperties[p];
+            struct dbinit_prop *slot = NULL;
+
+            total++;
+
+            if (This->initialized && is_dbinit_set(&set->guidPropertySet))
+            {
+                in->dwStatus = DBPROPSTATUS_NOTSETTABLE;
+                errors++;
+                continue;
+            }
+            if (is_dbinit_set(&set->guidPropertySet) && !find_known_prop_id(in->dwPropertyID))
+            {
+                in->dwStatus = DBPROPSTATUS_NOTSUPPORTED;
+                errors++;
+                continue;
+            }
+
+            for (i = 0; i < This->count; i++)
+                if (IsEqualGUID(&This->props[i].set, &set->guidPropertySet) &&
+                    This->props[i].prop.dwPropertyID == in->dwPropertyID)
+                {
+                    slot = &This->props[i];
+                    break;
+                }
+
+            if (!slot)
+            {
+                struct dbinit_prop *n = realloc(This->props, (This->count + 1) * sizeof(*n));
+                if (!n) return E_OUTOFMEMORY;
+                This->props = n;
+                slot = &n[This->count++];
+                memset(slot, 0, sizeof(*slot));
+                VariantInit(&slot->prop.vValue);
+            }
+            else
+                VariantClear(&slot->prop.vValue);
+
+            slot->set = set->guidPropertySet;
+            slot->prop.dwPropertyID = in->dwPropertyID;
+            slot->prop.dwOptions = in->dwOptions;
+            slot->prop.dwStatus = DBPROPSTATUS_OK;
+            VariantCopy(&slot->prop.vValue, &in->vValue);
+            in->dwStatus = DBPROPSTATUS_OK;
+        }
+    }
+
+    if (!errors) return S_OK;
+    return errors == total ? DB_E_ERRORSOCCURRED : DB_S_ERRORSOCCURRED;
 }
 
