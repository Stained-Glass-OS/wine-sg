+            /* bring the value to the requested scale */
+            if (dec.scale > scale)
+            {
+                /* digits beyond the requested scale are truncated */
+                while (dec.scale > scale)
+                {
+                    ULONGLONG cur, rem;
+
+                    cur = dec.Hi32; dec.Hi32 = cur / 10; rem = cur % 10;
+                    cur = (rem << 32) | dec.Mid32; dec.Mid32 = cur / 10; rem = cur % 10;
+                    cur = (rem << 32) | dec.Lo32; dec.Lo32 = cur / 10;
+                    dec.scale--;
+                }
+            }
+            else if (dec.scale < scale)
+            {
+                DECIMAL mul;
+                int n = scale - dec.scale;
+
+                VarDecFromUI4(1, &mul);
+                while (n-- && hr == S_OK)
+                {
+                    DECIMAL ten;
+                    VarDecFromUI4(10, &ten);
+                    hr = VarDecMul(&mul, &ten, &mul);
+                }
+                if (hr == S_OK) hr = VarDecMul(&dec, &mul, &dec);
+                if (hr == S_OK) dec.scale = scale;
+            }
+
+            if (hr == S_OK)
