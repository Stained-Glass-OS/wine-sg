+                    cur = ((ULONGLONG)rem << 32) | hi; hi = cur / 10; rem = cur % 10;
+                    cur = (rem << 32) | mid;           mid = cur / 10; rem = cur % 10;
+                    cur = (rem << 32) | lo;            lo = cur / 10;
+                    digits++;
+                }
+                if (digits > prec)
+                    hr = DISP_E_OVERFLOW;
