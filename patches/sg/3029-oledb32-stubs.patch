+
+    file = CreateFileW(filename, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+            FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+
+    if (!GetFileSizeEx(file, &size) || size.QuadPart > 1024 * 1024)
+    {
+        CloseHandle(file);
+        return E_FAIL;
+    }
+
+    raw = malloc(size.LowPart + 4);
+    if (!raw) { CloseHandle(file); return E_OUTOFMEMORY; }
+    if (!ReadFile(file, raw, size.LowPart, &read, NULL))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        free(raw);
+        CloseHandle(file);
+        return hr;
+    }
+    CloseHandle(file);
+    memset(raw + read, 0, 4);
+
+    if (read >= 2 && (BYTE)raw[0] == 0xff && (BYTE)raw[1] == 0xfe)
+        text = wcsdup((WCHAR *)(raw + 2));
+    else
+    {
+        const char *src = raw;
+        UINT cp = CP_ACP;
+
+        if (read >= 3 && (BYTE)raw[0] == 0xef && (BYTE)raw[1] == 0xbb && (BYTE)raw[2] == 0xbf)
+        {
+            src += 3;
+            cp = CP_UTF8;
+        }
+        len = MultiByteToWideChar(cp, 0, src, -1, NULL, 0);
+        if (len && (text = malloc(len * sizeof(WCHAR))))
+            MultiByteToWideChar(cp, 0, src, -1, text, len);
+    }
+    free(raw);
+    if (!text) return E_OUTOFMEMORY;
+
+    /* skip to the [oledb] section, then over comment lines */
+    result = NULL;
+    for (line = text; *line; line = end)
+    {
+        WCHAR saved;
+
+        end = line;
+        while (*end && *end != '\r' && *end != '\n') end++;
+        saved = *end;
+        *end = 0;
+        if (!header)
+        {
+            if (!wcsicmp(line, L"[oledb]")) header = TRUE;
+        }
+        else if (*line != ';' && *line)
+        {
+            result = line;
+            break;
+        }
+        *end = saved;
+        while (*end == '\r' || *end == '\n') end++;
+    }
+
+    if (!result)
+    {
+        free(text);
+        return E_FAIL;
+    }
+
+    *initstring = CoTaskMemAlloc((lstrlenW(result) + 1) * sizeof(WCHAR));
+    if (*initstring) lstrcpyW(*initstring, result);
+    else hr = E_OUTOFMEMORY;
+    free(text);
+    return hr;
+}
+
+HRESULT data_init_write_string(LPCOLESTR filename, LPCOLESTR initstring, DWORD disposition)
+{
+    static const WORD bom = 0xfeff;
+    HANDLE file;
+    DWORD written;
+    HRESULT hr = S_OK;
+
+    if (!filename || !initstring) return E_INVALIDARG;
+
+    file = CreateFileW(filename, GENERIC_WRITE, 0, NULL, disposition, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+
+    if (!WriteFile(file, &bom, sizeof(bom), &written, NULL) ||
+        !WriteFile(file, udl_header, lstrlenW(udl_header) * sizeof(WCHAR), &written, NULL) ||
+        !WriteFile(file, initstring, lstrlenW(initstring) * sizeof(WCHAR), &written, NULL) ||
+        !WriteFile(file, L"\r\n", 2 * sizeof(WCHAR), &written, NULL))
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    SetEndOfFile(file);
+    CloseHandle(file);
+    return hr;
+}
