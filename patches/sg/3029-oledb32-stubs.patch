+        case DBTYPE_I1:          hr = VarDecFromI1(*(signed char*)src, &dec);    break;
+        case DBTYPE_I2:          hr = VarDecFromI2(*(short*)src, &dec);          break;
+        case DBTYPE_I4:          hr = VarDecFromI4(*(int*)src, &dec);            break;
