+                memcpy(d->val + 8, &dec.Hi32, 4);
+                d->precision = prec;
+                d->scale = scale;
+                d->sign = (dec.Lo32 | dec.Mid32 | dec.Hi32) ? sign : 1;
+            }
+        }
+        break;
+    }
 
