+/* integer type properties: returns size in bytes or 0 if not an integer type */
+static int int_type_info(DBTYPE type, BOOL *is_signed)
+{
+    switch (type)
+    {
+    case DBTYPE_I1:  *is_signed = TRUE;  return 1;
+    case DBTYPE_UI1: *is_signed = FALSE; return 1;
+    case DBTYPE_I2:  *is_signed = TRUE;  return 2;
+    case DBTYPE_UI2: *is_signed = FALSE; return 2;
+    case DBTYPE_I4:  *is_signed = TRUE;  return 4;
+    case DBTYPE_UI4: *is_signed = FALSE; return 4;
+    case DBTYPE_I8:  *is_signed = TRUE;  return 8;
+    case DBTYPE_UI8: *is_signed = FALSE; return 8;
+    default: return 0;
+    }
+}
+
+static BOOL int_value_negative(DBTYPE type, const void *src)
+{
+    switch (type)
+    {
+    case DBTYPE_I1: return *(const signed char *)src < 0;
+    case DBTYPE_I2: return *(const short *)src < 0;
+    case DBTYPE_I4: return *(const int *)src < 0;
+    case DBTYPE_I8: return *(const LONGLONG *)src < 0;
+    default: return FALSE;
+    }
+}
