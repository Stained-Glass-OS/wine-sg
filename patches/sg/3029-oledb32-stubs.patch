+/* generic snapshot enumerators for the connection point and its connections */
+struct enum_cp
+{
+    IEnumConnectionPoints IEnumConnectionPoints_iface;
+    LONG ref;
+    IConnectionPoint *point;
+    ULONG pos;
+};
+
+static inline struct enum_cp *impl_from_IEnumConnectionPoints(IEnumConnectionPoints *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_cp, IEnumConnectionPoints_iface);
+}
+
+static HRESULT WINAPI enum_cp_QueryInterface(IEnumConnectionPoints *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumConnectionPoints))
+    {
+        *obj = iface;
+        IEnumConnectionPoints_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_cp_AddRef(IEnumConnectionPoints *iface)
+{
+    struct enum_cp *This = impl_from_IEnumConnectionPoints(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI enum_cp_Release(IEnumConnectionPoints *iface)
+{
+    struct enum_cp *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        IConnectionPoint_Release(This->point);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_cp_Next(IEnumConnectionPoints *iface, ULONG count, IConnectionPoint **points, ULONG *fetched)
+{
+    struct enum_cp *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG n = 0;
+
+    if (!points) return E_POINTER;
+    if (!fetched && count != 1) return E_INVALIDARG;
+
+    if (count && !This->pos)
+    {
+        points[0] = This->point;
+        IConnectionPoint_AddRef(points[0]);
+        This->pos = 1;
+        n = 1;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_cp_Skip(IEnumConnectionPoints *iface, ULONG count)
+{
+    struct enum_cp *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG left = 1 - This->pos;
+
+    if (count > left)
+    {
+        This->pos = 1;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_cp_Reset(IEnumConnectionPoints *iface)
+{
+    struct enum_cp *This = impl_from_IEnumConnectionPoints(iface);
+    This->pos = 0;
+    return S_OK;
+}
+
+static const IEnumConnectionPointsVtbl enum_cp_vtbl;
+
+static HRESULT WINAPI enum_cp_Clone(IEnumConnectionPoints *iface, IEnumConnectionPoints **out)
+{
+    struct enum_cp *This = impl_from_IEnumConnectionPoints(iface), *e;
+
+    if (!out) return E_POINTER;
+    if (!(e = malloc(sizeof(*e)))) return E_OUTOFMEMORY;
+    e->IEnumConnectionPoints_iface.lpVtbl = &enum_cp_vtbl;
+    e->ref = 1;
+    e->point = This->point;
+    IConnectionPoint_AddRef(e->point);
+    e->pos = This->pos;
+    *out = &e->IEnumConnectionPoints_iface;
+    return S_OK;
+}
+
+static const IEnumConnectionPointsVtbl enum_cp_vtbl =
+{
+    enum_cp_QueryInterface,
+    enum_cp_AddRef,
+    enum_cp_Release,
+    enum_cp_Next,
+    enum_cp_Skip,
+    enum_cp_Reset,
+    enum_cp_Clone
+};
+
+static HRESULT create_enum_cp(IConnectionPoint *point, IEnumConnectionPoints **out)
+{
+    struct enum_cp *e;
+
+    if (!(e = malloc(sizeof(*e)))) return E_OUTOFMEMORY;
+    e->IEnumConnectionPoints_iface.lpVtbl = &enum_cp_vtbl;
+    e->ref = 1;
+    e->point = point;
+    IConnectionPoint_AddRef(point);
+    e->pos = 0;
+    *out = &e->IEnumConnectionPoints_iface;
+    return S_OK;
+}
+
+struct enum_conn
+{
+    IEnumConnections IEnumConnections_iface;
+    LONG ref;
+    CONNECTDATA *data;
+    ULONG count;
+    ULONG pos;
+};
+
+static inline struct enum_conn *impl_from_IEnumConnections(IEnumConnections *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_conn, IEnumConnections_iface);
+}
+
+static HRESULT WINAPI enum_conn_QueryInterface(IEnumConnections *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumConnections))
+    {
+        *obj = iface;
+        IEnumConnections_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_conn_AddRef(IEnumConnections *iface)
+{
+    struct enum_conn *This = impl_from_IEnumConnections(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI enum_conn_Release(IEnumConnections *iface)
+{
+    struct enum_conn *This = impl_from_IEnumConnections(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        ULONG i;
+        for (i = 0; i < This->count; i++)
+            IUnknown_Release(This->data[i].pUnk);
+        free(This->data);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_conn_Next(IEnumConnections *iface, ULONG count, CONNECTDATA *out, ULONG *fetched)
+{
+    struct enum_conn *This = impl_from_IEnumConnections(iface);
+    ULONG n = 0;
+
+    if (!out) return E_POINTER;
+    if (!fetched && count != 1) return E_INVALIDARG;
+
+    while (n < count && This->pos < This->count)
+    {
+        out[n] = This->data[This->pos++];
+        IUnknown_AddRef(out[n].pUnk);
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_conn_Skip(IEnumConnections *iface, ULONG count)
+{
+    struct enum_conn *This = impl_from_IEnumConnections(iface);
+
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_conn_Reset(IEnumConnections *iface)
+{
+    struct enum_conn *This = impl_from_IEnumConnections(iface);
+    This->pos = 0;
+    return S_OK;
+}
+
+static const IEnumConnectionsVtbl enum_conn_vtbl;
+
+static HRESULT create_enum_conn(const CONNECTDATA *src, ULONG count, ULONG pos, IEnumConnections **out)
+{
+    struct enum_conn *e;
+    ULONG i;
+
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
+    if (count && !(e->data = malloc(count * sizeof(*e->data))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    e->IEnumConnections_iface.lpVtbl = &enum_conn_vtbl;
+    e->ref = 1;
+    e->count = count;
+    e->pos = pos;
+    for (i = 0; i < count; i++)
+    {
+        e->data[i] = src[i];
+        IUnknown_AddRef(e->data[i].pUnk);
+    }
+    *out = &e->IEnumConnections_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_conn_Clone(IEnumConnections *iface, IEnumConnections **out)
+{
+    struct enum_conn *This = impl_from_IEnumConnections(iface);
+
+    if (!out) return E_POINTER;
+    return create_enum_conn(This->data, This->count, This->pos, out);
+}
+
+static const IEnumConnectionsVtbl enum_conn_vtbl =
+{
+    enum_conn_QueryInterface,
+    enum_conn_AddRef,
+    enum_conn_Release,
+    enum_conn_Next,
+    enum_conn_Skip,
+    enum_conn_Reset,
+    enum_conn_Clone
+};
