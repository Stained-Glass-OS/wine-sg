From: Stained Glass OS <dev@stained-glass.example>
Subject: explorer: elevated windows have taskbar buttons, and minimize

An elevated program's window lives on the Wine desktop
WinSta0\sg-elevated-<display> (ADR 0012, sg-elevated-run). The bar looked
there, but asked IsWindowVisible, which calls every window of a desktop
other than the caller's hidden: no elevated window ever had a button, and
one could not be minimized from the taskbar (QA: elevated windows stay on
top -- fine -- "but they should be minimizable"). The window's own style
(WS_VISIBLE) says whether it is shown.

Which elevated window is focused or minimized the compositor knows: the bar
asks for its WINDOWS list through sg-lockctl (WINDOWS --out FILE, read at
the next tick) while an elevated window has a button. A click brings the
window forward (ACTIVATE), minimizes it when it is in front (MINIMIZE,
sg-compositor sg14, sg-session 0.1.0-61), and brings it back once
minimized.

Gate: test/elevmin-gate.sh (make test-elevmin).

--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1006,11 +1006,15 @@
     LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
     {
         if (!win->hwnd) { start = win; continue; }
-        win->active = win->xwin ? win->xwin_focused : (win->hwnd == foreground);
+        win->active = (win->xwin || win->elevated) ? win->xwin_focused : (win->hwnd == foreground);
         /* Stained Glass OS: only the current virtual desktop's windows */
         /* as on Windows: no button for a tool window (Start, flyouts), unless
          * it asks for one with WS_EX_APPWINDOW */
-        win->visible = win->xwin ? TRUE : IsWindowVisible( win->hwnd ) && !GetWindow( win->hwnd, GW_OWNER ) &&
+        /* an elevated window is on another desktop, whose windows
+         * IsWindowVisible calls hidden: its own style says */
+        win->visible = win->xwin ? TRUE :
+                       (win->elevated ? (GetWindowLongW( win->hwnd, GWL_STYLE ) & WS_VISIBLE) != 0 : IsWindowVisible( win->hwnd )) &&
+                       !GetWindow( win->hwnd, GW_OWNER ) &&
                        ((GetWindowLongW( win->hwnd, GWL_EXSTYLE ) & (WS_EX_TOOLWINDOW | WS_EX_APPWINDOW)) != WS_EX_TOOLWINDOW) &&
                        (win->elevated || vd_on_current( win->hwnd ));
         if (win->visible) count++;
@@ -1362,6 +1366,56 @@
     return icon;
 }
 
+/* elevated windows' state (focused, minimized), from the compositor's
+ * WINDOWS list (display window x y w h shown|minimized|hidden focused|- title),
+ * written by sg-lockctl to a file and read at the next tick */
+static void sg_sync_elevated_state( const WCHAR *runtime )
+{
+    WCHAR unix_list[MAX_PATH], dos_list[MAX_PATH + 8], args[MAX_PATH + 32], *p;
+    struct taskbar_button *win;
+    char list[8192], *line, *next;
+    HANDLE file;
+    DWORD got = 0;
+    BOOL any = FALSE;
+
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry ) if (win->elevated) any = TRUE;
+    if (!any) return;
+    swprintf( unix_list, ARRAY_SIZE(unix_list), L"%s/sg-taskbar-windows-%lu", runtime, GetCurrentProcessId() );
+    swprintf( dos_list, ARRAY_SIZE(dos_list), L"\\\\?\\unix%s", unix_list );
+    for (p = dos_list; *p; p++) if (*p == '/') *p = '\\';
+    file = CreateFileW( dos_list, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL );
+    swprintf( args, ARRAY_SIZE(args), L"WINDOWS --out %s", unix_list );
+    sg_run_lockctl( args );
+    if (file == INVALID_HANDLE_VALUE) return;
+    if (!ReadFile( file, list, sizeof(list) - 1, &got, NULL )) got = 0;
+    list[got] = 0;
+    CloseHandle( file );
+    for (line = list; *line; line = next)
+    {
+        char state[16], focus[16];
+        unsigned long window;
+        int display, x, y, w, h;
+
+        if ((next = strchr( line, '\n' ))) *next++ = 0;
+        else next = line + strlen( line );
+        if (sscanf( line, "%d %lu %d %d %d %d %15s %15s", &display, &window, &x, &y, &w, &h, state, focus ) != 8) continue;
+        LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+        {
+            BOOL focused, minimized;
+            if (win->elevated != display + 1 || (ULONG_PTR)GetPropW( win->hwnd, L"__wine_x11_whole_window" ) != window)
+                continue;
+            focused = !strcmp( focus, "focused" );
+            minimized = !strcmp( state, "minimized" );
+            if (focused != win->xwin_focused || minimized != win->xwin_minimized)
+            {
+                win->xwin_focused = focused;
+                win->xwin_minimized = minimized;
+                InvalidateRect( win->button, NULL, FALSE );
+            }
+        }
+    }
+}
+
 static void sg_sync_xwindows(void)
 {
     static BOOL registered;
@@ -1391,6 +1445,7 @@
     }
     swprintf( args, ARRAY_SIZE(args), L"XWINDOWS --out %s", unix_list );
     sg_run_lockctl( args );
+    sg_sync_elevated_state( runtime );
     if (file == INVALID_HANDLE_VALUE) return;   /* the first tick: nothing yet */
     if (!registered)
     {
@@ -1479,7 +1534,9 @@
     struct sg_elevated_scan *scan = (struct sg_elevated_scan *)lparam;
     struct taskbar_button *win;
 
-    if (!IsWindowVisible( hwnd ) || GetWindow( hwnd, GW_OWNER ) ||
+    /* its desktop is not ours: IsWindowVisible calls every window on it
+     * hidden, so no elevated window had a button; its style says */
+    if (!(GetWindowLongW( hwnd, GWL_STYLE ) & WS_VISIBLE) || GetWindow( hwnd, GW_OWNER ) ||
         (GetWindowLongW( hwnd, GWL_EXSTYLE ) & (WS_EX_TOOLWINDOW | WS_EX_APPWINDOW)) == WS_EX_TOOLWINDOW)
         return TRUE;
     if (!(win = find_taskbar_button( hwnd )))
@@ -1541,21 +1598,18 @@
 }
 
