From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: monitor handles are user handles

Monitor handles were the small numbers 1, 2, ... and any handle whose low 16
bits matched was accepted.  They are now user-handle shaped (0x10001, ...)
and a 64-bit process must give the low 32 bits (a sign extension or other
high bits are fine); the 16-bit index alone, or with wrong bits above it, is
ERROR_INVALID_MONITOR_HANDLE.  A 32-bit process may also give the index
alone or with the 0xffff extension.  The todo_wine marks this satisfies are
removed from the user32 monitor test.

---
--- a/dlls/user32/tests/monitor.c
+++ b/dlls/user32/tests/monitor.c
@@ -2505,8 +2505,8 @@ static BOOL CALLBACK test_handle_proc(HMONITOR full_monitor, HDC hdc, LPRECT rec
     monitor = (HMONITOR)((ULONG_PTR)full_monitor & 0xffff);
     SetLastError(0xdeadbeef);
     ret = GetMonitorInfoW(monitor, &monitor_info);
-    todo_wine ok(!ret, "GetMonitorInfoW succeeded.\n");
-    todo_wine ok(GetLastError() == ERROR_INVALID_MONITOR_HANDLE, "Expected error code %#x, got %#lx.\n",
+    ok(!ret, "GetMonitorInfoW succeeded.\n");
+    ok(GetLastError() == ERROR_INVALID_MONITOR_HANDLE, "Expected error code %#x, got %#lx.\n",
             ERROR_INVALID_MONITOR_HANDLE, GetLastError());
 
     monitor = (HMONITOR)(((ULONG_PTR)full_monitor & 0xffff) | ((ULONG_PTR)0x9876 << 16));
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -2117,7 +2117,7 @@ static BOOL update_display_cache_from_registry( UINT64 serial )
 
             monitor->id = monitor_id;
             monitor->source = source_acquire( source );
-            monitor->handle = UlongToHandle( ++monitor_count );
+            monitor->handle = UlongToHandle( 0x10000 + ++monitor_count );  /* as a user handle: unique bits above the index */
             if (source->monitor_count++) monitor->is_clone = TRUE;
         }
 
@@ -2528,9 +2528,24 @@ static struct monitor *get_monitor_from_handle( HMONITOR handle )
 {
     struct monitor *monitor;
 
+    /* A monitor handle is a user handle: only its low 32 bits count (a 64-bit
+     * handle may be a sign extension). A 32-bit process may also give the
+     * 16-bit index alone, or with the 0xffff extension of it. */
+    UINT given = (UINT)(UINT_PTR)handle;
+
     LIST_FOR_EACH_ENTRY( monitor, &monitors, struct monitor, entry )
     {
-        if (monitor->handle != handle) continue;
+        UINT ref = (UINT)(UINT_PTR)monitor->handle;
+#ifdef SG_MUTANT_MONITOR_HANDLE_LOOSE
+        if ((given & 0xffff) != (ref & 0xffff)) continue;
+#else
+        if (given != ref)
+        {
+            if (sizeof(void *) == 8 && !NtCurrentTeb()->WowTebOffset) continue;
+            if ((given >> 16) != 0 && (given >> 16) != 0xffff) continue;
+            if ((given & 0xffff) != (ref & 0xffff)) continue;
+        }
+#endif
         if (!is_monitor_active( monitor )) continue;
         return monitor;
     }
