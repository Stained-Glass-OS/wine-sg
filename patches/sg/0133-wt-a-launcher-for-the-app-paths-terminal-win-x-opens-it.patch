From: Stained Glass OS <dev@stained-glass.example>
Subject: wt.exe: a launcher for the App Paths terminal; Win+X opens it

Windows Terminal is started as wt.exe -- from the Run box, from scripts and
by programs with CreateProcess, which never reads App Paths (on Windows it
is an app execution alias on the PATH). As 0120 does for calc.exe, wt.exe
(system32 and syswow64) now starts what App Paths registers for it --
sg-shell's Terminal -- with the same arguments.

Explorer's Win+X menu has Terminal and Terminal (Admin) where it had
Windows PowerShell, as Windows 11's does: wt.exe (with "runas" for the
second), else PowerShell, else cmd.

Gate: sg-shell's test/terminal-check.sh (wt.exe typed in cmd opens the
terminal) and wine-sg's make test-shellkeys (Win+X, T).
---
--- a/configure.ac
+++ b/configure.ac
@@ -3561,6 +3561,7 @@
 WINE_CONFIG_MAKEFILE(programs/write)
 WINE_CONFIG_MAKEFILE(programs/wscript)
 WINE_CONFIG_MAKEFILE(programs/wscript/tests)
+WINE_CONFIG_MAKEFILE(programs/wt)
 WINE_CONFIG_MAKEFILE(programs/wuauserv)
 WINE_CONFIG_MAKEFILE(programs/wusa)
 WINE_CONFIG_MAKEFILE(programs/xcopy)
--- a/configure
+++ b/configure
@@ -1764,6 +1764,7 @@
 enable_wordpad
 enable_write
 enable_wscript
+enable_wt
 enable_wuauserv
 enable_wusa
 enable_xcopy
@@ -23229,6 +23230,7 @@
 wine_fn_config_makefile programs/write enable_write
 wine_fn_config_makefile programs/wscript enable_wscript
 wine_fn_config_makefile programs/wscript/tests enable_tests
+wine_fn_config_makefile programs/wt enable_wt
 wine_fn_config_makefile programs/wuauserv enable_wuauserv
 wine_fn_config_makefile programs/wusa enable_wusa
 wine_fn_config_makefile programs/xcopy enable_xcopy
--- a/programs/calc/handoff.c
+++ b/programs/calc/handoff.c
@@ -1,11 +1,12 @@
 /*
- * Stained Glass OS: calc.exe, charmap.exe, mspaint.exe and snippingtool.exe
+ * Stained Glass OS: calc.exe, charmap.exe, mspaint.exe, snippingtool.exe and wt.exe
  *
- * Windows ships these in system32, so programs, scripts and the command line
- * start them by name with CreateProcess, which searches system32 and the PATH
- * but never App Paths. Wine has none of them. These are the system32 names;
- * each starts the program App Paths registers for its own file name (sg-shell's
- * Calculator, Character Map, Paint and Snipping Tool) with the same arguments
+ * Windows ships these in system32 (wt.exe as an app execution alias on the
+ * PATH), so programs, scripts and the command line start them by name with
+ * CreateProcess, which searches system32 and the PATH but never App Paths.
+ * Wine has none of them. These are the system32 names; each starts the
+ * program App Paths registers for its own file name (sg-shell's Calculator,
+ * Character Map, Paint, Snipping Tool and Terminal) with the same arguments
  * and exits, as Windows' own calc.exe is a launcher for the Calculator app.
  *
  * Copyright 2026 Stained Glass OS contributors
--- a/programs/explorer/shellkeys.c
+++ b/programs/explorer/shellkeys.c
@@ -342,7 +342,7 @@
 static void quick_link(void)
 {
     enum { QL_APPS = 1, QL_SYSTEM, QL_NETWORK, QL_POWERSHELL, QL_TASKMGR, QL_SETTINGS, QL_EXPLORER,
-           QL_RUN, QL_DESKTOP, QL_CONTROL, QL_EVENTS, QL_DEVICES, QL_DISKS, QL_COMPMGMT };
+           QL_RUN, QL_DESKTOP, QL_CONTROL, QL_EVENTS, QL_DEVICES, QL_DISKS, QL_COMPMGMT, QL_TERMINAL_ADMIN };
     HMENU menu = CreatePopupMenu();
     RECT work;
     int cmd;
@@ -355,7 +355,8 @@
     AppendMenuW( menu, MF_STRING, QL_DISKS, L"D&isk Management" );
     AppendMenuW( menu, MF_STRING, QL_COMPMGMT, L"Computer Mana&gement" );
     AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
-    AppendMenuW( menu, MF_STRING, QL_POWERSHELL, L"Windows Power&Shell" );
+    AppendMenuW( menu, MF_STRING, QL_POWERSHELL, L"&Terminal" );
+    AppendMenuW( menu, MF_STRING, QL_TERMINAL_ADMIN, L"Terminal (&Admin)" );
     AppendMenuW( menu, MF_STRING, QL_TASKMGR, L"Tas&k Manager" );
     AppendMenuW( menu, MF_STRING, QL_SETTINGS, L"Setti&ngs" );
     AppendMenuW( menu, MF_STRING, QL_CONTROL, L"Control &Panel" );
@@ -376,7 +377,10 @@
     case QL_DEVICES: run( L"devmgmt.msc", NULL ); break;
     case QL_DISKS: run( L"diskmgmt.msc", NULL ); break;
     case QL_COMPMGMT: run( L"compmgmt.msc", NULL ); break;
-    case QL_POWERSHELL:
+    case QL_POWERSHELL: case QL_TERMINAL_ADMIN:
+        /* Windows Terminal (wt.exe), as Windows 11's menu has it; else PowerShell, else cmd */
+        if ((INT_PTR)ShellExecuteW( NULL, cmd == QL_TERMINAL_ADMIN ? L"runas" : NULL, L"wt.exe", NULL, NULL, SW_SHOWNORMAL ) > 32)
+            break;
         if ((INT_PTR)ShellExecuteW( NULL, NULL, L"pwsh.exe", NULL, NULL, SW_SHOWNORMAL ) <= 32) run( L"cmd.exe", NULL );
         break;
     case QL_TASKMGR: run( L"taskmgr.exe", NULL ); break;
