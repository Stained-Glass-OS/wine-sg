From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 08:15:52 -0700
Subject: [PATCH] 3223 atl: container sites, MSHTML: and licensed controls,
 property map persistence

The ActiveX host (AtlAxWin) answers the container interfaces the way the
documentation describes them: IOleClientSite::SaveObject saves the control
through IPersistStreamInit (E_FAIL without it), ShowObject restores a minimized
container, GetMoniker clears *ppmk, IOleContainer::ParseDisplayName hands the
name to the control's IParseDisplayName (MK_E_NOOBJECT otherwise, E_INVALIDARG
for NULLs), ContextSensitiveHelp keeps the help mode, IOleInPlaceSite::Scroll
moves the object rectangle behind the unchanged clipping rectangle and calls
SetObjectRects (GetWindowContext sees the scroll), IOleInPlaceFrame keeps the
active object, InsertMenus adds no menu group, SetMenu/RemoveMenus check their
menu handle, GetExtendedControl clears *ppDisp and gives E_POINTER for NULL.

AtlAxCreateControl* with a name that starts with "MSHTML:" creates the HTML
document object and loads the text after the prefix into it as a stream (it
used to create the web browser and ignore the text); a license key makes
AtlAxCreateControlLic[Ex] create the control through
IClassFactory2::CreateInstanceLic.

AtlIPersistStreamInit_Load/Save and AtlIPersistPropertyBag_Load/Save walk the
property map of the object (properties by DISPID through IDispatch, data
members by offset, property page entries skipped) instead of returning S_OK.

diff --git a/dlls/atl/atl.c b/dlls/atl/atl.c
index ec4e790..fedcb4c 100644
--- a/dlls/atl/atl.c
+++ b/dlls/atl/atl.c
@@ -265,14 +265,234 @@ HRESULT WINAPI AtlInternalQueryInterface(void* this, const _ATL_INTMAP_ENTRY* pE
     return rc;
 }
 
+/* The persistence helpers of ATL objects walk the property map of the object.  An entry with
+ * a DISPID is read and written through the IDispatch of the object; an entry without one
+ * (PROP_DATA_ENTRY) names a data member of the object at dwOffsetData.  An entry that has no
+ * description (PROP_PAGE) only names a property page and is not persisted, and the map ends
+ * with the first entry that has no property page CLSID pointer (END_PROP_MAP). */
+
+#define ATL_STREAM_SIGNATURE 0x5354534cu  /* "LSTS" */
+#define ATL_STREAM_VERSION   1
+
+static inline BOOL propmap_end(const ATL_PROPMAP_ENTRY *e)
+{
+    return !e->pclsidPropPage;
+}
+
+static inline BOOL propmap_persisted(const ATL_PROPMAP_ENTRY *e)
+{
+#ifdef SG_MUTANT_ATLAX2_PAGE
+    return TRUE;
+#endif
+    return e->szDesc != NULL;
+}
+
+static UINT propmap_type_size(VARTYPE vt)
+{
+    switch (vt)
+    {
+    case VT_I1: case VT_UI1:             return 1;
+    case VT_I2: case VT_UI2: case VT_BOOL: return 2;
+    case VT_I4: case VT_UI4: case VT_INT: case VT_UINT: case VT_R4: case VT_ERROR: return 4;
+    case VT_I8: case VT_UI8: case VT_R8: case VT_CY: case VT_DATE: return 8;
+    case VT_BSTR:                        return sizeof(BSTR);
+    default:                             return 0;
+    }
+}
+
+/* the data member of the object, as a VARIANT */
+static HRESULT propmap_read_member(const ATL_PROPMAP_ENTRY *e, void *pThis, VARIANT *var)
+{
+    UINT size = propmap_type_size(e->vt);
+    BYTE *data = (BYTE *)pThis + e->dwOffsetData;
+
+    VariantInit(var);
+    if (!size) return DISP_E_BADVARTYPE;
+    if (e->dwSizeData < size) return E_INVALIDARG;
+
+    if (e->vt == VT_BSTR)
+    {
+        BSTR str = *(BSTR *)data;
+        if (str && !(V_BSTR(var) = SysAllocStringLen(str, SysStringLen(str)))) return E_OUTOFMEMORY;
+    }
+    else memcpy(&V_I1(var), data, size);
+    V_VT(var) = e->vt;
+    return S_OK;
+}
+
+static HRESULT propmap_write_member(const ATL_PROPMAP_ENTRY *e, void *pThis, VARIANT *src)
+{
+    UINT size = propmap_type_size(e->vt);
+    BYTE *data = (BYTE *)pThis + e->dwOffsetData;
+    VARIANT var;
+    HRESULT hr;
+
+    if (!size) return DISP_E_BADVARTYPE;
+    if (e->dwSizeData < size) return E_INVALIDARG;
+
+    VariantInit(&var);
+    if (FAILED(hr = VariantChangeType(&var, src, 0, e->vt))) return hr;
+    if (e->vt == VT_BSTR)
+    {
+        BSTR str = NULL;
+        if (V_BSTR(&var) && !(str = SysAllocStringLen(V_BSTR(&var), SysStringLen(V_BSTR(&var)))))
+        {
+            VariantClear(&var);
+            return E_OUTOFMEMORY;
+        }
+        SysFreeString(*(BSTR *)data);
+        *(BSTR *)data = str;
+    }
+    else memcpy(data, &V_I1(&var), size);
+    VariantClear(&var);
+    return S_OK;
+}
+
+static HRESULT propmap_get_dispatch(const ATL_PROPMAP_ENTRY *e, IUnknown *pUnk, IDispatch **disp)
+{
+    const IID *iid = e->piidDispatch && !IsEqualIID(e->piidDispatch, &IID_NULL) ? e->piidDispatch : &IID_IDispatch;
+
+    *disp = NULL;
+    if (!pUnk) return E_INVALIDARG;
+    return IUnknown_QueryInterface(pUnk, iid, (void **)disp);
+}
+
+/* get the value of a property of the object, by its DISPID or from the data member */
+static HRESULT propmap_get_value(const ATL_PROPMAP_ENTRY *e, void *pThis, IUnknown *pUnk, VARIANT *var)
+{
+    DISPPARAMS params = {0};
+    IDispatch *disp;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_ATLAX2_DATA
+    if (!e->dispid) return E_NOTIMPL;
+#endif
+    if (!e->dispid) return propmap_read_member(e, pThis, var);
+
+    if (FAILED(hr = propmap_get_dispatch(e, pUnk, &disp))) return hr;
+    VariantInit(var);
+    hr = IDispatch_Invoke(disp, e->dispid, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_PROPERTYGET,
+                          &params, var, NULL, NULL);
+    IDispatch_Release(disp);
+    return hr;
+}
+
+static HRESULT propmap_set_value(const ATL_PROPMAP_ENTRY *e, void *pThis, IUnknown *pUnk, VARIANT *var)
+{
+    DISPID put = DISPID_PROPERTYPUT;
+    DISPPARAMS params = { var, &put, 1, 1 };
+    IDispatch *disp;
+    HRESULT hr;
+
+    if (!e->dispid) return propmap_write_member(e, pThis, var);
+
+    if (FAILED(hr = propmap_get_dispatch(e, pUnk, &disp))) return hr;
+    hr = IDispatch_Invoke(disp, e->dispid, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_PROPERTYPUT,
+                          &params, NULL, NULL, NULL);
+    IDispatch_Release(disp);
+    return hr;
+}
+
+static HRESULT stream_write_all(IStream *stm, const void *data, ULONG size)
+{
+    ULONG written = 0;
+    HRESULT hr = IStream_Write(stm, data, size, &written);
+    if (SUCCEEDED(hr) && written != size) hr = STG_E_MEDIUMFULL;
+    return hr;
+}
+
+/* returns S_FALSE when the stream ended before the first byte */
+static HRESULT stream_read_all(IStream *stm, void *data, ULONG size)
+{
+    ULONG read = 0;
+    HRESULT hr = IStream_Read(stm, data, size, &read);
+    if (FAILED(hr)) return hr;
+    if (!read) return S_FALSE;
+    return read == size ? S_OK : STG_E_READFAULT;
+}
+
+/* A value in the stream is its VARTYPE followed by its data; a BSTR is its length in bytes
+ * (-1 for a null string) followed by the UTF-16 characters.  This is the layout of our own
+ * implementation: it is not the layout of the native library, and streams are not exchangeable. */
+static HRESULT stream_write_value(IStream *stm, const VARIANT *var)
+{
+    DWORD vt = V_VT(var), len;
+    UINT size = propmap_type_size(V_VT(var));
+    HRESULT hr;
+
+    if (!size) return DISP_E_BADVARTYPE;
+    if (FAILED(hr = stream_write_all(stm, &vt, sizeof(vt)))) return hr;
+    if (V_VT(var) == VT_BSTR)
+    {
+        len = V_BSTR(var) ? SysStringByteLen(V_BSTR(var)) : ~0u;
+        if (FAILED(hr = stream_write_all(stm, &len, sizeof(len)))) return hr;
+        return len == ~0u ? S_OK : stream_write_all(stm, V_BSTR(var), len);
+    }
+    return stream_write_all(stm, &V_I1(var), size);
+}
+
+static HRESULT stream_read_value(IStream *stm, VARIANT *var)
+{
+    DWORD vt, len;
+    UINT size;
+    HRESULT hr;
+
+    VariantInit(var);
+    if ((hr = stream_read_all(stm, &vt, sizeof(vt))) != S_OK) return hr == S_FALSE ? STG_E_READFAULT : hr;
+    if (!(size = propmap_type_size(vt))) return DISP_E_BADVARTYPE;
+    if (vt == VT_BSTR)
+    {
+        if ((hr = stream_read_all(stm, &len, sizeof(len))) != S_OK) return hr == S_FALSE ? STG_E_READFAULT : hr;
+        V_VT(var) = VT_BSTR;
+        V_BSTR(var) = NULL;
+        if (len == ~0u) return S_OK;
+        if (len > 0x1000000) return STG_E_READFAULT;
+        if (!(V_BSTR(var) = SysAllocStringByteLen(NULL, len))) return E_OUTOFMEMORY;
+        if (len && (hr = stream_read_all(stm, V_BSTR(var), len)) != S_OK)
+        {
+            VariantClear(var);
+            return hr == S_FALSE ? STG_E_READFAULT : hr;
+        }
+        return S_OK;
+    }
+    V_VT(var) = vt;
+    if ((hr = stream_read_all(stm, &V_I1(var), size)) != S_OK)
+    {
+        V_VT(var) = VT_EMPTY;
+        return hr == S_FALSE ? STG_E_READFAULT : hr;
+    }
+    return S_OK;
+}
+
 /***********************************************************************
  *           AtlIPersistStreamInit_Load      [atl100.@]
  */
 HRESULT WINAPI AtlIPersistStreamInit_Load( LPSTREAM pStm, ATL_PROPMAP_ENTRY *pMap,
                                            void *pThis, IUnknown *pUnk)
 {
-    FIXME("(%p, %p, %p, %p)\n", pStm, pMap, pThis, pUnk);
+    DWORD header[2];
+    HRESULT hr;
+    int i;
 
+    TRACE("(%p, %p, %p, %p)\n", pStm, pMap, pThis, pUnk);
+
+    if (!pStm || !pMap) return E_INVALIDARG;
+
+    if ((hr = stream_read_all(pStm, header, sizeof(header))) != S_OK) return hr == S_FALSE ? E_FAIL : hr;
+#ifndef SG_MUTANT_ATLAX2_STREAMSIG
+    if (header[0] != ATL_STREAM_SIGNATURE || header[1] != ATL_STREAM_VERSION) return E_FAIL;
+#endif
+
+    for (i = 0; !propmap_end(&pMap[i]); i++)
+    {
+        VARIANT var;
+
+        if (!propmap_persisted(&pMap[i])) continue;
+        if (FAILED(hr = stream_read_value(pStm, &var))) return hr;
+        hr = propmap_set_value(&pMap[i], pThis, pUnk, &var);
+        VariantClear(&var);
+        if (FAILED(hr)) WARN("property %s not set: %#lx\n", debugstr_w(pMap[i].szDesc), hr);
+    }
     return S_OK;
 }
 
@@ -283,8 +503,27 @@ HRESULT WINAPI AtlIPersistStreamInit_Save(LPSTREAM pStm, BOOL fClearDirty,
                                           ATL_PROPMAP_ENTRY *pMap, void *pThis,
                                           IUnknown *pUnk)
 {
-    FIXME("(%p, %d, %p, %p, %p)\n", pStm, fClearDirty, pMap, pThis, pUnk);
+    DWORD header[2] = { ATL_STREAM_SIGNATURE, ATL_STREAM_VERSION };
+    HRESULT hr;
+    int i;
+
+    TRACE("(%p, %d, %p, %p, %p)\n", pStm, fClearDirty, pMap, pThis, pUnk);
+
+    if (!pStm || !pMap) return E_INVALIDARG;
+
+    if (FAILED(hr = stream_write_all(pStm, header, sizeof(header)))) return hr;
 
+    for (i = 0; !propmap_end(&pMap[i]); i++)
+    {
+        VARIANT var;
+
+        if (!propmap_persisted(&pMap[i])) continue;
+        if (FAILED(hr = propmap_get_value(&pMap[i], pThis, pUnk, &var))) return hr;
+        hr = stream_write_value(pStm, &var);
+        VariantClear(&var);
+        if (FAILED(hr)) return hr;
+    }
+    /* the dirty flag is a member of the object, which clears it itself */
     return S_OK;
 }
 
@@ -295,8 +534,36 @@ HRESULT WINAPI AtlIPersistPropertyBag_Load(LPPROPERTYBAG pPropBag, LPERRORLOG pE
                                            ATL_PROPMAP_ENTRY *pMap, void *pThis,
                                            IUnknown *pUnk)
 {
-    FIXME("(%p, %p, %p, %p, %p)\n", pPropBag, pErrorLog, pMap, pThis, pUnk);
+    int i;
 
+    TRACE("(%p, %p, %p, %p, %p)\n", pPropBag, pErrorLog, pMap, pThis, pUnk);
+
+    if (!pPropBag || !pMap) return E_INVALIDARG;
+
+    for (i = 0; !propmap_end(&pMap[i]); i++)
+    {
+        const ATL_PROPMAP_ENTRY *e = &pMap[i];
+        VARIANT var;
+        HRESULT hr;
+
+        if (!propmap_persisted(e)) continue;
+
+        VariantInit(&var);
+        V_VT(&var) = e->vt;
+        /* a property that is not in the bag keeps the value of the object */
+        if (FAILED(hr = IPropertyBag_Read(pPropBag, e->szDesc, &var, pErrorLog)))
+        {
+            TRACE("property %s not in the bag: %#lx\n", debugstr_w(e->szDesc), hr);
+            VariantClear(&var);
+#ifdef SG_MUTANT_ATLAX2_BAGMISSING
+            return hr;
+#endif
+            continue;
+        }
+        hr = propmap_set_value(e, pThis, pUnk, &var);
+        VariantClear(&var);
+        if (FAILED(hr)) WARN("property %s not set: %#lx\n", debugstr_w(e->szDesc), hr);
+    }
     return S_OK;
 }
 
@@ -307,8 +574,24 @@ HRESULT WINAPI AtlIPersistPropertyBag_Save(LPPROPERTYBAG pPropBag, BOOL fClearDi
                                            BOOL fSaveAll, ATL_PROPMAP_ENTRY *pMap,
                                            void *pThis, IUnknown *pUnk)
 {
-    FIXME("(%p, %d, %d, %p, %p, %p)\n", pPropBag, fClearDirty, fSaveAll, pMap, pThis, pUnk);
+    int i;
+
+    TRACE("(%p, %d, %d, %p, %p, %p)\n", pPropBag, fClearDirty, fSaveAll, pMap, pThis, pUnk);
 
+    if (!pPropBag || !pMap) return E_INVALIDARG;
+
+    /* all the properties are saved, whatever fSaveAll says */
+    for (i = 0; !propmap_end(&pMap[i]); i++)
+    {
+        VARIANT var;
+        HRESULT hr;
+
+        if (!propmap_persisted(&pMap[i])) continue;
+        if (FAILED(hr = propmap_get_value(&pMap[i], pThis, pUnk, &var))) return hr;
+        hr = IPropertyBag_Write(pPropBag, pMap[i].szDesc, &var);
+        VariantClear(&var);
+        if (FAILED(hr)) return hr;
+    }
     return S_OK;
 }
 
