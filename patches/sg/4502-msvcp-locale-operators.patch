From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcp: std::locale assignment and comparison.

std::locale operator= was a FIXME stub returning NULL, operator== and !=
returned false. Assignment now shares the other locale's implementation
(as the copy constructor does, releasing the old one); locales compare
equal when they are the same, a copy, or have the same name other than
"*" (C++ [locale.operators]). msvcp60..msvcp90 export them; the
basic_streambuf assignment of 4500 uses operator= in every version.
---
 dlls/msvcp90/locale.c | 30 ++++++++++++++++++++++++------
 1 file changed, 24 insertions(+), 6 deletions(-)

diff --git a/dlls/msvcp90/locale.c b/dlls/msvcp90/locale.c
index 192ee8b..6d47052 100644
--- a/dlls/msvcp90/locale.c
+++ b/dlls/msvcp90/locale.c
@@ -12536,8 +12536,18 @@ void __thiscall locale_dtor(locale *this)
 DEFINE_THISCALL_WRAPPER(locale_operator_assign, 8)
 locale* __thiscall locale_operator_assign(locale *this, const locale *loc)
 {
-    FIXME("(%p %p) stub\n", this, loc);
-    return NULL;
+    TRACE("(%p %p)\n", this, loc);
+
+    /* share the other implementation, as the copy constructor does */
+    if (this->ptr != loc->ptr)
+    {
+        call_locale_facet__Incref(&loc->ptr->facet);
+#ifndef SG_MUTANT_LOCALE_ASSIGN_NOP
+        locale_dtor(this);
+        this->ptr = loc->ptr;
+#endif
+    }
+    return this;
 }
 
 /* ??8locale@std@@QBE_NABV01@@Z */
@@ -12545,8 +12555,16 @@ locale* __thiscall locale_operator_assign(locale *this, const locale *loc)
 DEFINE_THISCALL_WRAPPER(locale_operator_equal, 8)
 bool __thiscall locale_operator_equal(const locale *this, const locale *loc)
 {
-    FIXME("(%p %p) stub\n", this, loc);
-    return 0;
+    const char *name;
+
+    TRACE("(%p %p)\n", this, loc);
+
+    /* the same locale, a copy of it, or locales of the same name
+     * (unnamed locales, "*", only equal themselves) [locale.operators] */
+    if (this->ptr == loc->ptr)
+        return TRUE;
+    name = locale_string_char_c_str(&this->ptr->name);
+    return strcmp(name, "*") && !strcmp(name, locale_string_char_c_str(&loc->ptr->name));
 }
 
 /* ??9locale@std@@QBE_NABV01@@Z */
@@ -12554,8 +12572,8 @@ bool __thiscall locale_operator_equal(const locale *this, const locale *loc)
 DEFINE_THISCALL_WRAPPER(locale_operator_not_equal, 8)
 bool __thiscall locale_operator_not_equal(const locale *this, locale const *loc)
 {
-    FIXME("(%p %p) stub\n", this, loc);
-    return 0;
+    TRACE("(%p %p)\n", this, loc);
+    return !locale_operator_equal(this, loc);
 }
 
 /* ?_Addfac@locale@std@@QAEAAV12@PAVfacet@12@II@Z */
