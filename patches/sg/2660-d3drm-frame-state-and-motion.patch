+static D3DVECTOR vec3(float x, float y, float z)
+{
+    D3DVECTOR v;
+
+    v.x = x;
+    v.y = y;
+    v.z = z;
+    return v;
+}
+
+/* Frame state: world matrices, spaces of reference frames, velocities, fog and render modes. */
+
+static void frame_world_matrix(const struct d3drm_frame *frame, struct d3drm_matrix *m)
+{
+    *m = identity;
+    for (; frame; frame = frame->parent)
+        d3drm_matrix_multiply_affine(m, m, &frame->transform);
+}
+
+static BOOL matrix_invert_affine(const struct d3drm_matrix *m, struct d3drm_matrix *out)
+{
+    float c11 = m->_22 * m->_33 - m->_23 * m->_32;
+    float c12 = m->_23 * m->_31 - m->_21 * m->_33;
+    float c13 = m->_21 * m->_32 - m->_22 * m->_31;
+    float det = m->_11 * c11 + m->_12 * c12 + m->_13 * c13;
+    struct d3drm_matrix r;
+
+    if (fabsf(det) < 1e-12f)
+        return FALSE;
+    det = 1.0f / det;
+    r._11 = c11 * det;
+    r._21 = c12 * det;
+    r._31 = c13 * det;
+    r._12 = (m->_13 * m->_32 - m->_12 * m->_33) * det;
+    r._22 = (m->_11 * m->_33 - m->_13 * m->_31) * det;
+    r._32 = (m->_12 * m->_31 - m->_11 * m->_32) * det;
+    r._13 = (m->_12 * m->_23 - m->_13 * m->_22) * det;
+    r._23 = (m->_13 * m->_21 - m->_11 * m->_23) * det;
+    r._33 = (m->_11 * m->_22 - m->_12 * m->_21) * det;
+    r._14 = r._24 = r._34 = 0.0f;
+    r._44 = 1.0f;
+    r._41 = -(m->_41 * r._11 + m->_42 * r._21 + m->_43 * r._31);
+    r._42 = -(m->_41 * r._12 + m->_42 * r._22 + m->_43 * r._32);
+    r._43 = -(m->_41 * r._13 + m->_42 * r._23 + m->_43 * r._33);
+    *out = r;
+    return TRUE;
+}
+
+static void vector_through(D3DVECTOR *v, const struct d3drm_matrix *m, BOOL point)
+{
+    D3DVECTOR r;
+
+    r.x = v->x * m->_11 + v->y * m->_21 + v->z * m->_31 + (point ? m->_41 : 0.0f);
+    r.y = v->x * m->_12 + v->y * m->_22 + v->z * m->_32 + (point ? m->_42 : 0.0f);
+    r.z = v->x * m->_13 + v->y * m->_23 + v->z * m->_33 + (point ? m->_43 : 0.0f);
+    *v = r;
+}
+
+/* v is in the space of reference (the parent's space when there is none): bring it to the space the frame's
+ * own transform is in, the space of its parent. */
+static BOOL frame_into_parent_space(const struct d3drm_frame *frame, const struct d3drm_frame *reference,
+        D3DVECTOR *v, BOOL point)
+{
+    struct d3drm_matrix m, inverse;
+
+#ifdef SG_MUTANT_DRMFRAME_NO_REFSPACE
+    return TRUE;
+#endif
+    if (!reference)
+        return TRUE;
+    frame_world_matrix(reference, &m);
+    vector_through(v, &m, point);
+    if (!frame->parent)
+        return TRUE;
+    frame_world_matrix(frame->parent, &m);
+    if (!matrix_invert_affine(&m, &inverse))
+        return FALSE;
+    vector_through(v, &inverse, point);
+    return TRUE;
+}
+
+static BOOL frame_out_of_parent_space(const struct d3drm_frame *frame, const struct d3drm_frame *reference,
+        D3DVECTOR *v, BOOL point)
+{
+    struct d3drm_matrix m, inverse;
+
+#ifdef SG_MUTANT_DRMFRAME_NO_REFSPACE
+    return TRUE;
+#endif
+    if (!reference)
+        return TRUE;
+    if (frame->parent)
+    {
+        frame_world_matrix(frame->parent, &m);
+        vector_through(v, &m, point);
+    }
+    frame_world_matrix(reference, &m);
+    if (!matrix_invert_affine(&m, &inverse))
+        return FALSE;
+    vector_through(v, &inverse, point);
+    return TRUE;
+}
+
+static HRESULT frame_get_position(struct d3drm_frame *frame, struct d3drm_frame *reference, D3DVECTOR *position)
+{
+    if (!position)
+        return D3DRMERR_BADVALUE;
+    position->x = frame->transform._41;
+    position->y = frame->transform._42;
+    position->z = frame->transform._43;
+    return frame_out_of_parent_space(frame, reference, position, TRUE) ? D3DRM_OK : D3DRMERR_BADVALUE;
+}
+
+static HRESULT frame_set_position(struct d3drm_frame *frame, struct d3drm_frame *reference, float x, float y, float z)
+{
+    D3DVECTOR v = vec3(x, y, z);
+
+    if (!frame_into_parent_space(frame, reference, &v, TRUE))
+        return D3DRMERR_BADVALUE;
+    frame->transform._41 = v.x;
+    frame->transform._42 = v.y;
+    frame->transform._43 = v.z;
+    return D3DRM_OK;
+}
+
+static float vector_length(const D3DVECTOR *v)
+{
+    return sqrtf(v->x * v->x + v->y * v->y + v->z * v->z);
+}
+
+static HRESULT frame_set_orientation(struct d3drm_frame *frame, struct d3drm_frame *reference,
+        D3DVECTOR dir, D3DVECTOR up)
+{
+    D3DVECTOR x, y, z;
+    float scale_x, scale_y, scale_z;
+
+    if (!frame_into_parent_space(frame, reference, &dir, FALSE) || !frame_into_parent_space(frame, reference, &up, FALSE))
+        return D3DRMERR_BADVALUE;
+    if (vector_length(&dir) < 1e-6f || vector_length(&up) < 1e-6f)
+        return D3DRMERR_BADVALUE;
+
+    z = dir;
+    D3DRMVectorNormalize(&z);
+    D3DRMVectorCrossProduct(&x, &up, &z);
+    if (vector_length(&x) < 1e-6f)
+        return D3DRMERR_BADVALUE;
+    D3DRMVectorNormalize(&x);
+    D3DRMVectorCrossProduct(&y, &z, &x);
+
+    /* the scale of the frame stays */
+    scale_x = sqrtf(frame->transform._11 * frame->transform._11 + frame->transform._12 * frame->transform._12
+            + frame->transform._13 * frame->transform._13);
+    scale_y = sqrtf(frame->transform._21 * frame->transform._21 + frame->transform._22 * frame->transform._22
+            + frame->transform._23 * frame->transform._23);
+    scale_z = sqrtf(frame->transform._31 * frame->transform._31 + frame->transform._32 * frame->transform._32
+            + frame->transform._33 * frame->transform._33);
+    if (scale_x < 1e-6f) scale_x = 1.0f;
+    if (scale_y < 1e-6f) scale_y = 1.0f;
+    if (scale_z < 1e-6f) scale_z = 1.0f;
+
+    frame->transform._11 = x.x * scale_x; frame->transform._12 = x.y * scale_x; frame->transform._13 = x.z * scale_x;
+    frame->transform._21 = y.x * scale_y; frame->transform._22 = y.y * scale_y; frame->transform._23 = y.z * scale_y;
+    frame->transform._31 = z.x * scale_z; frame->transform._32 = z.y * scale_z; frame->transform._33 = z.z * scale_z;
+    return D3DRM_OK;
+}
+
+static HRESULT frame_get_orientation(struct d3drm_frame *frame, struct d3drm_frame *reference,
+        D3DVECTOR *dir, D3DVECTOR *up)
+{
+    D3DVECTOR z = vec3(frame->transform._31, frame->transform._32, frame->transform._33);
+    D3DVECTOR y = vec3(frame->transform._21, frame->transform._22, frame->transform._23);
+
+    if (!dir || !up)
+        return D3DRMERR_BADVALUE;
+    D3DRMVectorNormalize(&z);
+    D3DRMVectorNormalize(&y);
+    if (!frame_out_of_parent_space(frame, reference, &z, FALSE) || !frame_out_of_parent_space(frame, reference, &y, FALSE))
+        return D3DRMERR_BADVALUE;
+    *dir = z;
+    *up = y;
+    return D3DRM_OK;
+}
+
+static HRESULT frame_set_velocity(struct d3drm_frame *frame, struct d3drm_frame *reference,
+        float x, float y, float z, BOOL with_rotation)
+{
+    D3DVECTOR v = vec3(x, y, z);
+
+    if (!frame_into_parent_space(frame, reference, &v, FALSE))
+        return D3DRMERR_BADVALUE;
+    frame->velocity = v;
+    frame->velocity_with_rotation = !!with_rotation;
+    return D3DRM_OK;
+}
+
+static HRESULT frame_get_velocity(struct d3drm_frame *frame, struct d3drm_frame *reference,
+        D3DVECTOR *velocity, BOOL with_rotation)
+{
+    if (!velocity)
+        return D3DRMERR_BADVALUE;
+    *velocity = frame->velocity;
+    return frame_out_of_parent_space(frame, reference, velocity, FALSE) ? D3DRM_OK : D3DRMERR_BADVALUE;
+}
+
+static HRESULT frame_set_rotation(struct d3drm_frame *frame, struct d3drm_frame *reference,
+        float x, float y, float z, float theta)
+{
+    D3DVECTOR axis = vec3(x, y, z);
+
+    if (!frame_into_parent_space(frame, reference, &axis, FALSE))
+        return D3DRMERR_BADVALUE;
+    frame->rotation_axis = axis;
+    frame->rotation_theta = theta;
+    return D3DRM_OK;
+}
+
+static HRESULT frame_get_rotation(struct d3drm_frame *frame, struct d3drm_frame *reference,
+        D3DVECTOR *axis, float *theta)
+{
+    if (!axis || !theta)
+        return D3DRMERR_BADVALUE;
+    *axis = frame->rotation_axis;
+    *theta = frame->rotation_theta;
+    return frame_out_of_parent_space(frame, reference, axis, FALSE) ? D3DRM_OK : D3DRMERR_BADVALUE;
+}
+
+static void frame_move(struct d3drm_frame *frame, float delta)
+{
+    unsigned int i;
+
+    for (i = 0; i < frame->nb_move_callbacks; ++i)
+    {
+        const struct d3drm_move_callback *cb = &frame->move_callbacks[i];
+
+#ifndef SG_MUTANT_DRMFRAME_NO_POST
+        if (cb->flags & D3DRMCALLBACK_POSTORDER)
+            continue;
+#endif
+        if (cb->version3)
+            ((D3DRMFRAME3MOVECALLBACK)cb->cb)(&frame->IDirect3DRMFrame3_iface, cb->ctx, delta);
+        else
+            ((D3DRMFRAMEMOVECALLBACK)cb->cb)(&frame->IDirect3DRMFrame_iface, cb->ctx, delta);
+    }
+
+    frame->transform._41 += frame->velocity.x * delta;
+    frame->transform._42 += frame->velocity.y * delta;
+    frame->transform._43 += frame->velocity.z * delta;
+
+    if (frame->rotation_theta != 0.0f && vector_length(&frame->rotation_axis) > 1e-6f)
+    {
+        struct d3drm_matrix rotation = identity, result;
+        D3DVECTOR axis = frame->rotation_axis;
+
+        d3drm_matrix_set_rotation(&rotation, &axis, frame->rotation_theta * delta);
+        d3drm_matrix_multiply_affine(&result, &frame->transform, &rotation);
+        /* turning in place: the position stays */
+        result._41 = frame->transform._41;
+        result._42 = frame->transform._42;
+        result._43 = frame->transform._43;
+        frame->transform = result;
+    }
+
+#ifndef SG_MUTANT_DRMFRAME_NO_CHILD_MOVE
+    for (i = 0; i < frame->nb_children; ++i)
+        frame_move(unsafe_impl_from_IDirect3DRMFrame3(frame->children[i]), delta);
+#endif
+
+    for (i = 0; i < frame->nb_move_callbacks; ++i)
+    {
+        const struct d3drm_move_callback *cb = &frame->move_callbacks[i];
+
+        if (!(cb->flags & D3DRMCALLBACK_POSTORDER))
+            continue;
+        if (cb->version3)
+            ((D3DRMFRAME3MOVECALLBACK)cb->cb)(&frame->IDirect3DRMFrame3_iface, cb->ctx, delta);
+        else
+            ((D3DRMFRAMEMOVECALLBACK)cb->cb)(&frame->IDirect3DRMFrame_iface, cb->ctx, delta);
+    }
+}
+
+static HRESULT frame_add_move_callback(struct d3drm_frame *frame, void *cb, void *ctx, DWORD flags, BOOL version3)
+{
+    unsigned int i;
+
+    if (!cb)
+        return D3DRMERR_BADVALUE;
+    for (i = 0; i < frame->nb_move_callbacks; ++i)
+        if (frame->move_callbacks[i].cb == cb && frame->move_callbacks[i].ctx == ctx)
+            return D3DRM_OK;
+    if (!d3drm_array_reserve((void **)&frame->move_callbacks, &frame->move_callbacks_size,
+            frame->nb_move_callbacks + 1, sizeof(*frame->move_callbacks)))
+        return E_OUTOFMEMORY;
+    frame->move_callbacks[frame->nb_move_callbacks].cb = cb;
+    frame->move_callbacks[frame->nb_move_callbacks].ctx = ctx;
+    frame->move_callbacks[frame->nb_move_callbacks].flags = flags;
+    frame->move_callbacks[frame->nb_move_callbacks].version3 = version3;
+    ++frame->nb_move_callbacks;
+    return D3DRM_OK;
+}
+
+static HRESULT frame_delete_move_callback(struct d3drm_frame *frame, void *cb, void *ctx)
+{
+    unsigned int i;
+
+    for (i = 0; i < frame->nb_move_callbacks; ++i)
+    {
+        if (frame->move_callbacks[i].cb != cb || frame->move_callbacks[i].ctx != ctx)
+            continue;
+        memmove(&frame->move_callbacks[i], &frame->move_callbacks[i + 1],
+                (frame->nb_move_callbacks - i - 1) * sizeof(*frame->move_callbacks));
+        --frame->nb_move_callbacks;
+        return D3DRM_OK;
+    }
+    return D3DRMERR_NOTFOUND;
+}
+
+static HRESULT frame_look_at(struct d3drm_frame *frame, struct d3drm_frame *target,
+        struct d3drm_frame *reference, D3DRMFRAMECONSTRAINT constraint)
+{
+    D3DVECTOR from, to, up;
+
+    if (!target)
+        return D3DRMERR_BADOBJECT;
+    /* both positions in the space of the reference, the direction from one to the other */
+    from.x = from.y = from.z = 0.0f;
+    to = from;
+    {
+        struct d3drm_matrix m;
+
+        frame_world_matrix(frame, &m);
+        vector_through(&from, &m, TRUE);
+        frame_world_matrix(target, &m);
+        vector_through(&to, &m, TRUE);
+        if (reference)
+        {
+            struct d3drm_matrix inverse;
+
+            frame_world_matrix(reference, &m);
+            if (!matrix_invert_affine(&m, &inverse))
+                return D3DRMERR_BADVALUE;
+            vector_through(&from, &inverse, TRUE);
+            vector_through(&to, &inverse, TRUE);
+        }
+    }
+    to.x -= from.x;
+    to.y -= from.y;
+    to.z -= from.z;
+    if (vector_length(&to) < 1e-6f)
+        return D3DRMERR_BADVALUE;
+
+    /* the frame keeps its up direction unless that is along the new view direction */
+    up.x = frame->transform._21;
+    up.y = frame->transform._22;
+    up.z = frame->transform._23;
+    if (reference)
+        frame_out_of_parent_space(frame, reference, &up, FALSE);
+    if (vector_length(&up) < 1e-6f)
+    {
+        up.x = 0.0f; up.y = 1.0f; up.z = 0.0f;
+    }
+    {
+        D3DVECTOR cross, dir = to, up_n = up;
+
+        D3DRMVectorNormalize(&dir);
+        D3DRMVectorNormalize(&up_n);
+        D3DRMVectorCrossProduct(&cross, &up_n, &dir);
+        if (vector_length(&cross) < 1e-3f)
+        {
+            up.x = 0.0f; up.y = 1.0f; up.z = 0.0f;
+            D3DRMVectorCrossProduct(&cross, &up, &dir);
+            if (vector_length(&cross) < 1e-3f)
+            {
+                up.x = 0.0f; up.y = 0.0f; up.z = 1.0f;
+            }
+        }
+    }
+    return frame_set_orientation(frame, reference, to, up);
+}
+
+static HRESULT frame_set_texture(struct d3drm_frame *frame, IDirect3DRMTexture3 *texture)
+{
+    if (texture)
+        IDirect3DRMTexture3_AddRef(texture);
+    if (frame->texture)
+        IDirect3DRMTexture3_Release(frame->texture);
+    frame->texture = texture;
+    return D3DRM_OK;
+}
+
+static HRESULT frame_get_visuals(struct d3drm_frame *frame, DWORD *count, IUnknown **visuals)
+{
+    DWORD i;
+
+    if (!count)
+        return D3DRMERR_BADVALUE;
+    if (!visuals)
+    {
+        *count = frame->nb_visuals;
+        return D3DRM_OK;
+    }
+    for (i = 0; i < *count && i < frame->nb_visuals; ++i)
+    {
+        visuals[i] = (IUnknown *)frame->visuals[i];
+        IUnknown_AddRef(visuals[i]);
+    }
+    *count = i;
+    return D3DRM_OK;
+}
+
+static HRESULT frame_transform_vectors(struct d3drm_frame *frame, struct d3drm_frame *reference, DWORD count,
+        D3DVECTOR *dst, D3DVECTOR *src, BOOL inverse)
+{
+    struct d3drm_matrix m, other, other_inverse;
+    DWORD i;
+
+    if (!count)
+        return D3DRM_OK;
+    if (!dst || !src)
+        return D3DRMERR_BADVALUE;
+
+    /* from the frame's space to the reference's (the world's without one), or back */
+    other = identity;
+    other_inverse = identity;
+    if (reference)
+    {
+        frame_world_matrix(reference, &other);
+        if (!matrix_invert_affine(&other, &other_inverse))
+            return D3DRMERR_BADVALUE;
+    }
+    frame_world_matrix(frame, &m);
+    if (inverse)
+    {
+        struct d3drm_matrix m_inverse;
+
+        if (!matrix_invert_affine(&m, &m_inverse))
+            return D3DRMERR_BADVALUE;
+        d3drm_matrix_multiply_affine(&m, &other, &m_inverse);
+    }
+    else
+    {
+        d3drm_matrix_multiply_affine(&m, &m, &other_inverse);
+    }
+    for (i = 0; i < count; ++i)
+    {
+        D3DVECTOR v = src[i];
+
+        vector_through(&v, &m, TRUE);
+        dst[i] = v;
+    }
+    return D3DRM_OK;
+}
