From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ucrtbase: Implement the _dscale, _dexp, _dunscale, _dpoly, _dlog and _dsin helpers.

ucrtbase's corecrt_math.h helpers were spec stubs: _dscale (*x * 2^n),
_dexp (*x = y * e^(*x) * 2^eoff), _dunscale (the fraction in [0.5, 1)
and the exponent), _dpoly (Horner's rule, tab[0] the highest
coefficient), _dlog (natural or base 10) and _dsin (sin(x + qoff * pi/2)),
with their float (_fd) forms, the long double (_ld, which is double)
forms and _o_ forms; the classes they return are _dclass's.
---
 dlls/msvcrt/math.c          | 175 ++++++++++++++++++++++++++++++++++++++++++++
 dlls/ucrtbase/ucrtbase.spec |  68 ++++++++---------
 2 files changed, 209 insertions(+), 34 deletions(-)

diff --git a/dlls/msvcrt/math.c b/dlls/msvcrt/math.c
index bcb4981..7c7de8a 100644
--- a/dlls/msvcrt/math.c
+++ b/dlls/msvcrt/math.c
@@ -2718,6 +2718,181 @@ short CDECL _dtest(double *x)
     return _dclass(*x);
 }
 
+#if _MSVCR_VER>=140
+/* The library-internal helpers of corecrt_math.h (the Dinkumware library's
+ * _Dscale, _Exp, _Dunscale, _Poly, _Log and _Sin): classes as _dclass. */
+
+/*********************************************************************
+ *      _dscale (UCRTBASE.@)
+ */
+short CDECL _dscale(double *x, __msvcrt_long lexp)
+{
+    if (isfinite(*x) && *x)
+    {
+        if (lexp > 4000) lexp = 4000;
+        if (lexp < -4000) lexp = -4000;
+        *x = ldexp(*x, lexp);
+    }
+    return _dclass(*x);
+}
+
+/*********************************************************************
+ *      _fdscale (UCRTBASE.@)
+ */
+short CDECL _fdscale(float *x, __msvcrt_long lexp)
+{
+    if (isfinite(*x) && *x)
+    {
+        if (lexp > 400) lexp = 400;
+        if (lexp < -400) lexp = -400;
+        *x = ldexpf(*x, lexp);
+    }
+    return _fdclass(*x);
+}
+
+/*********************************************************************
+ *      _dexp (UCRTBASE.@)
+ *
+ * *x = y * e^(*x) * 2^eoff
+ */
+short CDECL _dexp(double *x, double y, __msvcrt_long eoff)
+{
+    double t, e;
+
+    if (isnan(*x) || isnan(y)) { *x = *x + y; return FP_NAN; }
+    if (y == 0 || *x == -INFINITY) { *x = 0; return FP_ZERO; }
+    if (*x == INFINITY) { *x = y * INFINITY; return FP_INFINITE; }
+    t = *x / M_LN2;
+    e = floor(t);
+    if (e > 5000) e = 5000;
+    if (e < -5000) e = -5000;
+    if (eoff > 5000) eoff = 5000;
+    if (eoff < -5000) eoff = -5000;
+#ifdef SG_MUTANT_DEXP_NO_SCALE
+    eoff = 0;
+#endif
+    *x = ldexp(y * exp2(t - e), (int)e + eoff);
+    return _dclass(*x);
+}
+
+/*********************************************************************
+ *      _fdexp (UCRTBASE.@)
+ */
+short CDECL _fdexp(float *x, float y, __msvcrt_long eoff)
+{
+    double d = *x;
+    _dexp(&d, y, eoff);
+    *x = d;
+    return _fdclass(*x);
+}
+
+/*********************************************************************
+ *      _dunscale (UCRTBASE.@)
+ *
+ * *x = fraction in [0.5, 1), *pex = the exponent
+ */
+short CDECL _dunscale(short *pex, double *x)
+{
+    short cls = _dclass(*x);
+    int e = 0;
+
+    if (cls == FP_NORMAL || cls == FP_SUBNORMAL)
+    {
+        *x = frexp(*x, &e);
+        cls = FP_NORMAL;
+    }
+    *pex = e;
+    return cls;
+}
+
+/*********************************************************************
+ *      _fdunscale (UCRTBASE.@)
+ */
+short CDECL _fdunscale(short *pex, float *x)
+{
+    short cls = _fdclass(*x);
+    int e = 0;
+
+    if (cls == FP_NORMAL || cls == FP_SUBNORMAL)
+    {
+        *x = frexpf(*x, &e);
+        cls = FP_NORMAL;
+    }
+    *pex = e;
+    return cls;
+}
+
+/*********************************************************************
+ *      _dpoly (UCRTBASE.@)
+ *
+ * tab[0] * x^n + tab[1] * x^(n-1) + ... + tab[n]
+ */
+double CDECL _dpoly(double x, const double *tab, int n)
+{
+    double y = *tab;
+
+    while (n-- > 0) y = y * x + *++tab;
+    return y;
+}
+
+/*********************************************************************
+ *      _fdpoly (UCRTBASE.@)
+ */
+float CDECL _fdpoly(float x, const float *tab, int n)
+{
+    float y = *tab;
+
+    while (n-- > 0) y = y * x + *++tab;
+    return y;
+}
+
+/*********************************************************************
+ *      _dlog (UCRTBASE.@)
+ */
+double CDECL _dlog(double x, int base10)
+{
+    return base10 ? log10(x) : log(x);
+}
+
+/*********************************************************************
+ *      _fdlog (UCRTBASE.@)
+ */
+float CDECL _fdlog(float x, int base10)
+{
+    return base10 ? log10f(x) : logf(x);
+}
+
+/*********************************************************************
+ *      _dsin (UCRTBASE.@)
+ *
+ * sin(x + qoff * pi/2)
+ */
+double CDECL _dsin(double x, unsigned int qoff)
+{
+    switch (qoff & 3)
+    {
+    case 0: return sin(x);
+    case 1: return cos(x);
+    case 2: return -sin(x);
+    default: return -cos(x);
+    }
+}
+
+/*********************************************************************
+ *      _fdsin (UCRTBASE.@)
+ */
+float CDECL _fdsin(float x, unsigned int qoff)
+{
+    switch (qoff & 3)
+    {
+    case 0: return sinf(x);
+    case 1: return cosf(x);
+    case 2: return -sinf(x);
+    default: return -cosf(x);
+    }
+}
+#endif
+
 /*********************************************************************
  *      _fdtest (MSVCR120.@)
  */
