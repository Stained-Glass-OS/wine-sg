+/* a file time (UTC) as a CIM date and time in the local zone */
+static WCHAR *filetime_to_cim( const FILETIME *ft )
+{
+    SYSTEMTIME utc, local;
+    FILETIME lft;
+    ULARGE_INTEGER a, b;
+    LONG bias;
+    WCHAR *ret;
+
+    if (!ft->dwLowDateTime && !ft->dwHighDateTime) return NULL;
+    if (!FileTimeToSystemTime( ft, &utc ) || !SystemTimeToTzSpecificLocalTime( NULL, &utc, &local )) return NULL;
+    SystemTimeToFileTime( &local, &lft );
+    a.LowPart = lft.dwLowDateTime; a.HighPart = lft.dwHighDateTime;
+    b.LowPart = ft->dwLowDateTime; b.HighPart = ft->dwHighDateTime;
+    bias = (LONG)(((LONGLONG)a.QuadPart - (LONGLONG)b.QuadPart) / 10000000 / 60);
+    if (!(ret = malloc( 26 * sizeof(WCHAR) ))) return NULL;
+    swprintf( ret, 26, L"%04u%02u%02u%02u%02u%02u.%06u%c%03d", local.wYear, local.wMonth, local.wDay, local.wHour,
+              local.wMinute, local.wSecond, local.wMilliseconds * 1000, bias < 0 ? '-' : '+', abs( bias ) );
+    return ret;
+}
+
+static UINT priority_from_class( DWORD class )
+{
+    switch (class)
+    {
+    case IDLE_PRIORITY_CLASS:         return 4;
+    case BELOW_NORMAL_PRIORITY_CLASS: return 6;
+    case NORMAL_PRIORITY_CLASS:       return 8;
+    case ABOVE_NORMAL_PRIORITY_CLASS: return 10;
+    case HIGH_PRIORITY_CLASS:         return 13;
+    case REALTIME_PRIORITY_CLASS:     return 24;
+    default:                          return 0;
+    }
+}
+
+static void fill_process_details( struct record_process *rec, DWORD process_id )
+{
+    HANDLE process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, process_id );
+    VM_COUNTERS_EX vm;
+    KERNEL_USER_TIMES times;
+    SIZE_T min_ws, max_ws;
+    ULONG handles, session;
+
+    if (!process) return;
+    if (!NtQueryInformationProcess( process, ProcessVmCounters, &vm, sizeof(vm), NULL ))
+    {
+        rec->pagefaults         = vm.PageFaultCount;
+        rec->pagefileusage      = vm.PagefileUsage / 1024;
+        rec->peakpagefileusage  = vm.PeakPagefileUsage / 1024;
+        rec->peakvirtualsize    = vm.PeakVirtualSize;
+        rec->peakworkingsetsize = vm.PeakWorkingSetSize / 1024;
+        rec->privatepagecount   = vm.PrivateUsage;
+        rec->virtualsize        = vm.VirtualSize;
+        rec->workingsetsize     = vm.WorkingSetSize;
+    }
+    if (!NtQueryInformationProcess( process, ProcessTimes, &times, sizeof(times), NULL ))
+    {
+        FILETIME ft;
+        ft.dwLowDateTime = times.CreateTime.LowPart; ft.dwHighDateTime = times.CreateTime.HighPart;
+        rec->creationdate   = filetime_to_cim( &ft );
+        rec->kernelmodetime = times.KernelTime.QuadPart;
+        rec->usermodetime   = times.UserTime.QuadPart;
+    }
+    if (!NtQueryInformationProcess( process, ProcessHandleCount, &handles, sizeof(handles), NULL ))
+        rec->handlecount = handles;
+    if (GetProcessWorkingSetSize( process, &min_ws, &max_ws ))
+    {
+        rec->minimumworkingsetsize = min_ws;
+        rec->maximumworkingsetsize = max_ws;
+    }
+    rec->priority = priority_from_class( GetPriorityClass( process ) );
+    if (ProcessIdToSessionId( process_id, (DWORD *)&session )) rec->sessionid = session;
+    CloseHandle( process );
+}
