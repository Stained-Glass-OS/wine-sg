+static WCHAR *get_windows_version_string(void)
+{
+    RTL_OSVERSIONINFOEXW ver;
+    WCHAR *ret;
+
+    ver.dwOSVersionInfoSize = sizeof(ver);
+    RtlGetVersion( &ver );
+    if ((ret = malloc( 33 * sizeof(WCHAR) )))
+        swprintf( ret, 33, L"%u.%u.%u", ver.dwMajorVersion, ver.dwMinorVersion, ver.dwBuildNumber );
+    return ret;
+}
