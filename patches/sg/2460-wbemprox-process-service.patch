+        status = NtQueryInformationProcess( process, ProcessCommandLineInformation, str, size, &needed );
+        if (!status)
+        {
+            if (str->Buffer && (ret = malloc( str->Length + sizeof(WCHAR) )))
+            {
+                memcpy( ret, str->Buffer, str->Length );
+                ret[str->Length / sizeof(WCHAR)] = 0;
+            }
+            free( str );
+            break;
+        }
+        free( str );
+        if (status != STATUS_INFO_LENGTH_MISMATCH && status != STATUS_BUFFER_OVERFLOW && status != STATUS_BUFFER_TOO_SMALL) break;
+        if (needed <= size) break;
+        size = needed;
+    }
+    CloseHandle( process );
+    return ret;
 }
 
