From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] localspl: a 32-bit program's job to a 64-bit monitor's port prints through the print host

The print provider runs in the calling process; a 32-bit program printing to the port of a 64-bit port monitor (CutePDF Writer, added through splwow64 by 6115) could not load the monitor and the job failed (EndDoc error 6). The job now goes whole to splwow64 (new verb sendjob), which spools it again and prints it through the monitor, as Windows' 64-bit spooler does.
---
diff --git a/dlls/localspl/provider.c b/dlls/localspl/provider.c
index 6afa969..a6d3aed 100644
--- a/dlls/localspl/provider.c
+++ b/dlls/localspl/provider.c
@@ -2250,7 +2250,8 @@ static BOOL myAddPrinterDriverEx(DWORD level, LPBYTE pDriverInfo, DWORD dwFileCo
  * (ERROR_BAD_EXE_FORMAT): no monitor, no port, no printer. Such calls go to
  * the 64-bit print host, splwow64. Returns the call's error, or -1 when the
  * call is ours to make. */
-static LONG sg_spl_host( const WCHAR *verb, const WCHAR *a1, const WCHAR *a2, const WCHAR *a3 )
+static LONG sg_spl_host( const WCHAR *verb, const WCHAR *a1, const WCHAR *a2, const WCHAR *a3,
+                         const WCHAR *a4, const WCHAR *a5 )
 {
 #ifdef __i386__
     STARTUPINFOW si = { sizeof(si) };
@@ -2266,9 +2267,11 @@ static LONG sg_spl_host( const WCHAR *verb, const WCHAR *a1, const WCHAR *a2, co
     if (!IsWow64Process( GetCurrentProcess(), &wow64 ) || !wow64) return -1;
     GetWindowsDirectoryW( host, MAX_PATH - 32 );
     lstrcatW( host, L"\\sysnative\\splwow64.exe" );
-    len = wcslen( host ) + wcslen( verb ) + 16 + (a1 ? wcslen( a1 ) : 0) + (a2 ? wcslen( a2 ) : 0) + (a3 ? wcslen( a3 ) : 0);
+    len = wcslen( host ) + wcslen( verb ) + 24 + (a1 ? wcslen( a1 ) : 0) + (a2 ? wcslen( a2 ) : 0) + (a3 ? wcslen( a3 ) : 0)
+          + (a4 ? wcslen( a4 ) : 0) + (a5 ? wcslen( a5 ) : 0);
     if (!(cmd = malloc( len * sizeof(WCHAR) ))) return ERROR_OUTOFMEMORY;
-    swprintf( cmd, len, L"\"%s\" %s \"%s\" \"%s\" \"%s\"", host, verb, a1 ? a1 : L"", a2 ? a2 : L"", a3 ? a3 : L"" );
+    swprintf( cmd, len, L"\"%s\" %s \"%s\" \"%s\" \"%s\" \"%s\" \"%s\"", host, verb, a1 ? a1 : L"", a2 ? a2 : L"",
+              a3 ? a3 : L"", a4 ? a4 : L"", a5 ? a5 : L"" );
     TRACE( "%s\n", debugstr_w(cmd) );
     if (CreateProcessW( host, cmd, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi ))
     {
@@ -2324,7 +2327,7 @@ static BOOL WINAPI fpAddMonitor(LPWSTR pName, DWORD Level, LPBYTE pMonitors)
     /* a monitor for the 64-bit spooler, added from a 32-bit process */
     if (env == &env_x64)
     {
-        LONG code = sg_spl_host( L"addmonitor", mi2w->pName, env->envname, mi2w->pDLLName );
+        LONG code = sg_spl_host( L"addmonitor", mi2w->pName, env->envname, mi2w->pDLLName, NULL, NULL );
         if (code != -1)
         {
             SetLastError( code );
@@ -2429,7 +2432,7 @@ static BOOL WINAPI fpAddPort(LPWSTR pName, HWND hWnd, LPWSTR pMonitorName)
     if (!pm && !hWnd)
     {
         /* a 64-bit monitor, from a 32-bit process: the 64-bit host adds the port */
-        LONG code = sg_spl_host( L"addport", pMonitorName, NULL, NULL );
+        LONG code = sg_spl_host( L"addport", pMonitorName, NULL, NULL, NULL, NULL );
         if (code != -1)
         {
             SetLastError( code );
@@ -4682,6 +4685,51 @@ static BOOL WINAPI fpEndPagePrinter(HANDLE hprinter)
     return TRUE;
 }
 
+/* Stained Glass OS: a 32-bit program printing to the port of a 64-bit port
+ * monitor (CutePDF Writer's, added through the print host by 6115). The
+ * spooler that runs the job is 64-bit on Windows; here the job runs in the
+ * caller, which cannot load the monitor: the job is handed whole to the
+ * 64-bit print host, which spools it again and prints it there. TRUE when
+ * the host printed it. */
+static BOOL sg_job_to_host(const WCHAR *printer, const WCHAR *port_name, const job_info_t *job,
+                           const WCHAR *datatype)
+{
+#ifdef __i386__
+    WCHAR dir[MAX_PATH], copy[MAX_PATH], *p;
+    BOOL wow64 = FALSE;
+    monitor_t *pm;
+    LONG code;
+
+#ifdef SG_MUTANT_SPL_JOB_IN_WOW64
+    return FALSE;
+#endif
+    if (!IsWow64Process(GetCurrentProcess(), &wow64) || !wow64) return FALSE;
+    if ((pm = monitor_load_by_port(port_name)))
+    {
+        /* the monitor runs here: the job is ours */
+        monitor_unload(pm);
+        return FALSE;
+    }
+    /* the host numbers its jobs, and names their spool files, as we do: it
+     * reads a copy of this one, whose name is its own */
+    lstrcpynW(dir, job->filename, MAX_PATH);
+    if ((p = wcsrchr(dir, '\\'))) *p = 0;
+    if (!GetTempFileNameW(dir, L"SGW", 0, copy)) return FALSE;
+    if (!CopyFileW(job->filename, copy, FALSE))
+    {
+        DeleteFileW(copy);
+        return FALSE;
+    }
+    code = sg_spl_host(L"sendjob", printer, copy, datatype,
+                       job->port && *job->port ? job->port : NULL, job->document_title);
+    DeleteFileW(copy);
+    TRACE("job %ld to the print host: %ld\n", job->id, code);
+    return !code;
+#else
+    return FALSE;
+#endif
+}
+
 static BOOL WINAPI fpScheduleJob(HANDLE hprinter, DWORD job_id)
 {
     printer_t *printer = (printer_t *)hprinter;
@@ -4762,6 +4810,31 @@ static BOOL WINAPI fpScheduleJob(HANDLE hprinter, DWORD job_id)
     else
         datatype = printer->info->datatype;
 
+    /* the port's monitor is 64-bit and we are not */
+    if (wcsicmp(port_name, L"FILE:"))
+    {
+        BOOL sent;
+
+        job->printing = TRUE;
+        LeaveCriticalSection(&printer->info->jobs_cs);
+        sent = sg_job_to_host(printer->name, port_name, job, datatype);
+        EnterCriticalSection(&printer->info->jobs_cs);
+        job->printing = FALSE;
+        if (sent)
+        {
+            ret = TRUE;
+            if ((job->status & JOB_STATUS_RETAINED) && !(job->status & JOB_STATUS_DELETING))
+            {
+                job->status |= JOB_STATUS_PRINTED;
+                goto cleanup;
+            }
+            if (!(printer->info->attributes & PRINTER_ATTRIBUTE_KEEPPRINTEDJOBS))
+                DeleteFileW(job->filename);
+            free_job(job);
+            goto cleanup;
+        }
+    }
+
     pp = print_proc_load(job->print_proc ? job->print_proc : printer->info->print_proc);
     if (!pp)
     {
diff --git a/programs/splwow64/main.c b/programs/splwow64/main.c
index 6d70d9f..222d8f8 100644
--- a/programs/splwow64/main.c
+++ b/programs/splwow64/main.c
@@ -617,6 +617,40 @@ static int add_port( WCHAR *monitor )
     return GetLastError() ? GetLastError() : 1;
 }
 
+/* Stained Glass OS: a 32-bit program's job to a 64-bit port monitor's port
+ * (localspl in that program cannot load the monitor): spooled again here, so
+ * that this process's spooler runs it through the monitor. */
+static int send_job( WCHAR *printer, WCHAR *spool_file, WCHAR *datatype, WCHAR *output, WCHAR *title )
+{
+    DOC_INFO_1W doc = { title && *title ? title : (WCHAR *)L"Document", output && *output ? output : NULL,
+                        datatype && *datatype ? datatype : NULL };
+    HANDLE file, h;
+    BYTE buf[65536];
+    DWORD got, written, err = 0;
+
+    file = CreateFileW( spool_file, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return GetLastError();
+    if (!OpenPrinterW( printer, &h, NULL ))
+    {
+        err = GetLastError();
+        CloseHandle( file );
+        return err ? err : 1;
+    }
+    if (!StartDocPrinterW( h, 1, (BYTE *)&doc )) err = GetLastError() ? GetLastError() : 1;
+    while (!err && ReadFile( file, buf, sizeof(buf), &got, NULL ) && got)
+        if (!WritePrinter( h, buf, got, &written ) || written != got) err = GetLastError() ? GetLastError() : 1;
+    if (!err)
+    {
+        if (!EndDocPrinter( h )) err = GetLastError() ? GetLastError() : 1;
+    }
+    else AbortPrinter( h );
+    ClosePrinter( h );
+    CloseHandle( file );
+    TRACE( "job %s on %s: %lu\n", debugstr_w(spool_file), debugstr_w(printer), err );
+    return err;
+}
+
 int __cdecl wmain( int argc, WCHAR *argv[] )
 {
     BOOL (WINAPI *render)( const WCHAR *, const WCHAR *, const WCHAR *, const WCHAR *, const WCHAR *, DWORD );
@@ -649,6 +683,7 @@ int __cdecl wmain( int argc, WCHAR *argv[] )
     if (argc >= 2 && !wcscmp( argv[1], L"list" )) return list_printers( argc > 2 ? argv[2] : NULL );
     if (argc >= 5 && !wcscmp( argv[1], L"addmonitor" )) return add_monitor( argv[2], argv[3], argv[4] );
     if (argc >= 3 && !wcscmp( argv[1], L"addport" )) return add_port( argv[2] );
+    if (argc >= 7 && !wcscmp( argv[1], L"sendjob" )) return send_job( argv[2], argv[3], argv[4], argv[5], argv[6] );
     WINE_MESSAGE( "usage: splwow64 render PRINTER SPOOLFILE DEVMODEFILE OUTFILE JOBID DOCNAME\n"
                   "       splwow64 caps PRINTER DEVMODEFILE OUTFILE\n"
                   "       splwow64 devprops PRINTER DEVMODEFILE OUTFILE MODE HWND\n"
@@ -659,6 +694,7 @@ int __cdecl wmain( int argc, WCHAR *argv[] )
                   "       splwow64 ppd PRINTER OUTFILE\n"
                   "       splwow64 print PRINTER PAPER COPIES TITLE PAGE.ppm...\n"
                   "       splwow64 addmonitor NAME ENVIRONMENT DLL\n"
-                  "       splwow64 addport MONITOR\n" );
+                  "       splwow64 addport MONITOR\n"
+                  "       splwow64 sendjob PRINTER SPOOLFILE DATATYPE OUTPUT DOCNAME\n" );
     return 2;
 }
