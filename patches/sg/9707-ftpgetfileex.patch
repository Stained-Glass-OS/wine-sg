From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wininet: FtpGetFileEx, FtpPutFileEx

Spec stubs. FtpGetFile/FtpPutFile with the local file name in Unicode and the remote name in the ANSI
code page. Gate: test/ftpex-gate.sh (a file up to and back from a small FTP server on 127.0.0.1).
Mutant: SG_MUTANT_FTPEX_STUB.
---
--- a/dlls/wininet/ftp.c
+++ b/dlls/wininet/ftp.c
@@ -1552,6 +1552,49 @@
 
 
 /***********************************************************************
+ *           FtpGetFileEx (WININET.@)
+ *
+ * Stained Glass OS (wine-sg 9707): FtpGetFile with the remote name in the ANSI code page and the local
+ * name in Unicode (any local path, whatever the code page), as Windows' wininet has it.
+ */
+BOOL WINAPI FtpGetFileEx(HINTERNET hInternet, LPCSTR lpszRemoteFile, LPCWSTR lpszNewFile,
+    BOOL fFailIfExists, DWORD dwLocalFlagsAttribute, DWORD dwInternetFlags, DWORD_PTR dwContext)
+{
+    LPWSTR remote;
+    BOOL ret;
+
+    TRACE("(%p,%s,%s,%d,%08lx,%08lx,%08Ix)\n", hInternet, debugstr_a(lpszRemoteFile), debugstr_w(lpszNewFile),
+          fFailIfExists, dwLocalFlagsAttribute, dwInternetFlags, dwContext);
+#ifdef SG_MUTANT_FTPEX_STUB
+    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    return FALSE;
+#endif
+    remote = strdupAtoW(lpszRemoteFile);
+    ret = FtpGetFileW(hInternet, remote, lpszNewFile, fFailIfExists, dwLocalFlagsAttribute, dwInternetFlags, dwContext);
+    free(remote);
+    return ret;
+}
+
+/***********************************************************************
+ *           FtpPutFileEx (WININET.@)
+ *
+ * FtpPutFile with the local name in Unicode and the remote name in the ANSI code page.
+ */
+BOOL WINAPI FtpPutFileEx(HINTERNET hConnect, LPCWSTR lpszLocalFile, LPCSTR lpszNewRemoteFile,
+    DWORD dwFlags, DWORD_PTR dwContext)
+{
+    LPWSTR remote;
+    BOOL ret;
+
+    TRACE("(%p,%s,%s,%08lx,%08Ix)\n", hConnect, debugstr_w(lpszLocalFile), debugstr_a(lpszNewRemoteFile),
+          dwFlags, dwContext);
+    remote = strdupAtoW(lpszNewRemoteFile);
+    ret = FtpPutFileW(hConnect, lpszLocalFile, remote, dwFlags, dwContext);
+    free(remote);
+    return ret;
+}
+
+/***********************************************************************
  *           FtpGetFileA (WININET.@)
  *
  * Retrieve file from the FTP server
--- a/dlls/wininet/wininet.spec
+++ b/dlls/wininet/wininet.spec
@@ -64,13 +64,13 @@
 @ stdcall FtpGetCurrentDirectoryA(ptr str ptr)
 @ stdcall FtpGetCurrentDirectoryW(ptr wstr ptr)
 @ stdcall FtpGetFileA(ptr str str long long long long)
-@ stub FtpGetFileEx
+@ stdcall FtpGetFileEx(ptr str wstr long long long long)
 @ stdcall FtpGetFileSize(long ptr)
 @ stdcall FtpGetFileW(ptr wstr wstr long long long long)
 @ stdcall FtpOpenFileA(ptr str long long long)
 @ stdcall FtpOpenFileW(ptr wstr long long long)
 @ stdcall FtpPutFileA(ptr str str long long)
-@ stub FtpPutFileEx
+@ stdcall FtpPutFileEx(ptr wstr str long long)
 @ stdcall FtpPutFileW(ptr wstr wstr long long)
 @ stdcall FtpRemoveDirectoryA(ptr str)
 @ stdcall FtpRemoveDirectoryW(ptr wstr)
--- a/include/wininet.h
+++ b/include/wininet.h
@@ -714,12 +714,14 @@
 
 BOOLAPI FtpGetFileA(HINTERNET ,LPCSTR ,LPCSTR ,BOOL ,DWORD ,DWORD ,DWORD_PTR);
 BOOLAPI FtpGetFileW(HINTERNET ,LPCWSTR ,LPCWSTR ,BOOL ,DWORD ,DWORD ,DWORD_PTR);
+BOOLAPI FtpGetFileEx(HINTERNET ,LPCSTR ,LPCWSTR ,BOOL ,DWORD ,DWORD ,DWORD_PTR);
 #define FtpGetFile  WINELIB_NAME_AW(FtpGetFile)
 
 DWORD WINAPI FtpGetFileSize(HINTERNET, LPDWORD);
 
 BOOLAPI FtpPutFileA(HINTERNET ,LPCSTR ,LPCSTR ,DWORD ,DWORD_PTR);
 BOOLAPI FtpPutFileW(HINTERNET ,LPCWSTR ,LPCWSTR ,DWORD ,DWORD_PTR);
+BOOLAPI FtpPutFileEx(HINTERNET ,LPCWSTR ,LPCSTR ,DWORD ,DWORD_PTR);
 #define FtpPutFile  WINELIB_NAME_AW(FtpPutFile)
 
 BOOLAPI FtpDeleteFileA(HINTERNET ,LPCSTR);
