+/* what a track hands to the style to have its notes and curves sent to the performance */
+struct style_play
+{
+    IDirectMusicPerformance *performance;
+    IDirectMusicSegmentState *segment_state;
+    DWORD track_id;
+    MUSIC_TIME start, end;  /* the range to play, relative to the segment */
+    MUSIC_TIME offset;      /* the segment start in performance music time */
+    MUSIC_TIME origin;      /* where the style (or the motif) starts in the segment */
+    const WCHAR *motif;     /* a motif name, NULL to follow the command track */
+    DWORD seed;             /* GUID_SeedVariations */
+};
+extern HRESULT style_play_range(IDirectMusicStyle8 *style, const struct style_play *play);
+
 /*****************************************************************************
  * Auxiliary definitions
  */
