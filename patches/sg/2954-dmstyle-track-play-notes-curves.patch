diff --git a/dlls/dmstyle/style.c b/dlls/dmstyle/style.c
index 351de69..880324e 100644
--- a/dlls/dmstyle/style.c
+++ b/dlls/dmstyle/style.c
@@ -966,6 +966,482 @@ static const IPersistStreamVtbl persiststream_vtbl = {
     unimpl_IPersistStream_GetSizeMax
 };
 
+/* Playing the patterns. The notes and curves of the parts of a pattern are sent to the
+ * performance as DMUS_NOTE_PMSG / DMUS_CURVE_PMSG messages in music time.
+ * Assumptions (the documentation does not give them): a groove level of 1 and a normal command
+ * without a command track, a C major chord (scale C major) without a chord track, the layout of
+ * a music value (bits 0-3 position, bits 4-7 signed accidental, bits 12-15 signed octave), the
+ * MIDI note of chord root 0 being 36, a variation being eligible when its variation choice is
+ * not zero, commands being looked at when a pattern starts, and the random choices coming from
+ * a linear congruential generator seeded with GUID_SeedVariations. */
+#define PLAY_DEFAULT_LEVEL 1
+#define PLAY_DEFAULT_ROOT_NOTE 36
+#define PLAY_MAX_CYCLES 100000
+
+static DWORD play_rand(DWORD *state)
+{
+    *state = *state * 1664525u + 1013904223u;
+    return *state >> 8;
+}
+
+static MUSIC_TIME play_beat_len(const DMUS_IO_TIMESIG *sig)
+{
+    return sig->bBeat ? DMUS_PPQ * 4 / sig->bBeat : DMUS_PPQ;
+}
+
+static MUSIC_TIME play_grid_len(const DMUS_IO_TIMESIG *sig)
+{
+#ifdef SG_MUTANT_GRID
+    return play_beat_len(sig) / 2;
+#else
+    return max(play_beat_len(sig) / max(sig->wGridsPerBeat, 1), 1);
+#endif
+}
+
+struct play_chord
+{
+    DMUS_CHORD_KEY key;
+    MUSIC_TIME from, until;
+    BOOL valid;
+};
+
+static HRESULT play_get_param(const struct style_play *play, REFGUID type, MUSIC_TIME time,
+        MUSIC_TIME *next, void *param)
+{
+    IDirectMusicSegment *segment;
+    HRESULT hr = DMUS_E_NOT_FOUND;
+
+    *next = 0;
+    if (play->segment_state
+            && SUCCEEDED(IDirectMusicSegmentState_GetSegment(play->segment_state, &segment)))
+    {
+        hr = IDirectMusicSegment_GetParam(segment, type, 0xffffffff, 0, time, next, param);
+        IDirectMusicSegment_Release(segment);
+    }
+    /* a motif has no chord track of its own: the chord of the performance applies */
+    if (FAILED(hr) && play->performance)
+        hr = IDirectMusicPerformance_GetParam(play->performance, type, 0xffffffff, 0,
+                time + play->offset, next, param);
+    return hr;
+}
+
+static void play_get_chord(const struct style_play *play, MUSIC_TIME time, struct play_chord *chord)
+{
+    MUSIC_TIME next;
+
+#ifdef SG_MUTANT_CHORDSPAN
+    if (chord->valid) return;
+#else
+    if (chord->valid && time >= chord->from && time < chord->until) return;
+#endif
+
+    memset(&chord->key, 0, sizeof(chord->key));
+    chord->from = time;
+    chord->until = MAXLONG;
+    chord->valid = TRUE;
+    if (SUCCEEDED(play_get_param(play, &GUID_ChordParam, time, &next, &chord->key))
+            && chord->key.bSubChordCount)
+    {
+        if (next > 0) chord->until = time + next;
+        return;
+    }
+
+    /* the default chord: C major */
+    memset(&chord->key, 0, sizeof(chord->key));
+    chord->key.bSubChordCount = 1;
+    chord->key.SubChordList[0].dwChordPattern = 0x91;
+    chord->key.SubChordList[0].dwScalePattern = 0xab5;
+    chord->key.SubChordList[0].dwLevels = 0xffffffff;
+}
+
+/* the index-th set bit of the pattern (bit i being the interval i semitones above the root),
+ * wrapping into the next octave */
+static int play_interval(DWORD pattern, int index, int *octave)
+{
+    int count = 0, bit, wrapped;
+
+    pattern &= 0xffffff;
+    for (bit = 0; bit < 24; bit++) if (pattern & (1u << bit)) count++;
+    if (!count) { *octave = 0; return 0; }
+
+    *octave = index / count;
+    if (index % count < 0) (*octave)--;
+    wrapped = ((index % count) + count) % count;
+    for (bit = 0; bit < 24; bit++)
+        if ((pattern & (1u << bit)) && !wrapped--) return bit;
+    return 0;
+}
+
+static int play_music_value_to_midi(WORD value, BYTE mode, const DMUS_SUBCHORD *sub)
+{
+    int degree = value & 0xf, accidental = (value >> 4) & 0xf, octave = (value >> 12) & 0xf;
+    int note, interval_octave;
+
+    if (accidental > 7) accidental -= 16;
+    if (octave > 7) octave -= 16;
+
+#ifdef SG_MUTANT_PLAYMODE
+    mode = 0;
+#endif
+    if (!mode) return value; /* DMUS_PLAYMODE_FIXED: the value is the MIDI note */
+
+    if (!(mode & (DMUS_PLAYMODE_SCALE_INTERVALS | DMUS_PLAYMODE_CHORD_INTERVALS)))
+    {
+        /* a fixed note moved by the root */
+        note = value;
+        if (mode & DMUS_PLAYMODE_CHORD_ROOT) note += sub->bChordRoot % 12;
+        else if (mode & DMUS_PLAYMODE_KEY_ROOT) note += sub->bScaleRoot % 12;
+        return note;
+    }
+
+    note = PLAY_DEFAULT_ROOT_NOTE;
+    if (mode & DMUS_PLAYMODE_CHORD_ROOT) note += sub->bChordRoot;
+    else if (mode & DMUS_PLAYMODE_KEY_ROOT) note += sub->bScaleRoot;
+
+    if (mode & DMUS_PLAYMODE_CHORD_INTERVALS)
+        note += play_interval(sub->dwChordPattern, degree, &interval_octave);
+    else
+        note += play_interval(sub->dwScalePattern, degree, &interval_octave);
+#ifdef SG_MUTANT_OCTAVE
+    return note + 12 * interval_octave + accidental;
+#else
+    return note + 12 * (octave + interval_octave) + accidental;
+#endif
+}
+
+static const DMUS_SUBCHORD *play_subchord(const DMUS_CHORD_KEY *chord, BYTE level)
+{
+    DWORD i;
+
+    for (i = 0; i < chord->bSubChordCount && i < DMUS_MAXSUBCHORD; i++)
+        if (chord->SubChordList[i].dwLevels & (1u << (level & 31))) return &chord->SubChordList[i];
+    return &chord->SubChordList[0];
+}
+
+/* the position (measure, beat, grid and the offset to it) of a time in the segment */
+static void play_position(const DMUS_IO_TIMESIG *sig, MUSIC_TIME time, WORD *measure, BYTE *beat,
+        BYTE *grid)
+{
+    MUSIC_TIME beat_len = play_beat_len(sig), measure_len = beat_len * max(sig->bBeatsPerMeasure, 1);
+    MUSIC_TIME in_measure;
+
+    if (time < 0) time = 0;
+    *measure = time / measure_len;
+    in_measure = time % measure_len;
+    *beat = in_measure / beat_len;
+    *grid = (in_measure % beat_len) / play_grid_len(sig);
+}
+
+static HRESULT play_send(const struct style_play *play, IDirectMusicGraph *graph, DMUS_PMSG *msg)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = IDirectMusicGraph_StampPMsg(graph, msg))
+            || FAILED(hr = IDirectMusicPerformance_SendPMsg(play->performance, msg)))
+        IDirectMusicPerformance_FreePMsg(play->performance, msg);
+    return hr;
+}
+
+static const struct style_part *style_find_part(struct style *This, const GUID *id)
+{
+    const struct style_part *part;
+
+    LIST_FOR_EACH_ENTRY(part, &This->parts, struct style_part, entry)
+        if (IsEqualGUID(&part->header.guidPartID, id)) return part;
+    return NULL;
+}
+
+struct play_cycle
+{
+    const struct style_play *play;
+    IDirectMusicGraph *graph;
+    const struct style_pattern *pattern;
+    MUSIC_TIME start;       /* where the pattern starts in the segment */
+    MUSIC_TIME length;
+    DWORD cycle_no;
+    DWORD rng;
+    int lock[256];          /* the variation chosen for a variation lock id, -1 when none */
+    struct play_chord chord;
+};
+
+static int play_select_variation(struct play_cycle *cycle, const struct style_part *part,
+        const struct style_part_ref *ref)
+{
+    int candidates[32], count = 0, i, chosen;
+
+    for (i = 0; i < 32; i++)
+        if (part->header.dwVariationChoices[i]) candidates[count++] = i;
+    if (!count) candidates[count++] = 0;
+
+#ifndef SG_MUTANT_NOLOCK
+    if (ref->header.bVariationLockID)
+    {
+        int locked = cycle->lock[ref->header.bVariationLockID];
+        for (i = 0; locked >= 0 && i < count; i++) if (candidates[i] == locked) return locked;
+    }
+#endif
+
+#ifdef SG_MUTANT_VARIATION
+    chosen = candidates[0];
+#else
+    if (ref->header.bRandomVariation) chosen = candidates[play_rand(&cycle->rng) % count];
+    else chosen = candidates[cycle->cycle_no % count];
+#endif
+    if (ref->header.bVariationLockID) cycle->lock[ref->header.bVariationLockID] = chosen;
+    return chosen;
+}
+
+static HRESULT play_part(struct play_cycle *cycle, const struct style_part_ref *ref,
+        const struct style_part *part, int variation)
+{
+    const struct style_play *play = cycle->play;
+    const DMUS_IO_TIMESIG *sig = &part->header.timeSig;
+    MUSIC_TIME part_len, grid_len, base, time;
+    UINT i;
+    HRESULT hr;
+
+    if (!sig->bBeatsPerMeasure) sig = &cycle->pattern->pattern.timeSig;
+    grid_len = play_grid_len(sig);
+    part_len = max(part->header.wNbrMeasures, 1) * sig->bBeatsPerMeasure * play_beat_len(sig);
+    if (part_len <= 0) return S_OK;
+
+    for (base = 0; base < cycle->length; base += part_len)
+    {
+        for (i = 0; i < part->notes_count; i++)
+        {
+            const DMUS_IO_STYLENOTE *note = &part->notes[i];
+            DMUS_NOTE_PMSG *msg;
+            const DMUS_SUBCHORD *sub;
+            BYTE mode;
+
+            if (!(note->dwVariation & (1u << variation))) continue;
+            time = base + note->mtGridStart * grid_len;
+            if (time < 0 || time >= cycle->length || time >= base + part_len) continue;
+            time += cycle->start;
+#ifdef SG_MUTANT_RANGE
+            if (time < play->start || time > play->end) continue;
+#else
+            if (time < play->start || time >= play->end) continue;
+#endif
+
+            play_get_chord(play, time, &cycle->chord);
+            sub = play_subchord(&cycle->chord.key, ref->header.bSubChordLevel);
+            mode = note->bPlayModeFlags;
+            if (mode & DMUS_PLAYMODE_NONE) mode = part->header.bPlayModeFlags;
+            if (mode & DMUS_PLAYMODE_NONE) mode = 0;
+
+            if (FAILED(hr = IDirectMusicPerformance_AllocPMsg(play->performance, sizeof(*msg),
+                    (DMUS_PMSG **)&msg)))
+                return hr;
+#ifdef SG_MUTANT_NOTEOFFSET
+            msg->mtTime = time + play->offset;
+#else
+            msg->mtTime = time + note->nTimeOffset + play->offset;
+#endif
+            msg->dwFlags = DMUS_PMSGF_MUSICTIME;
+            msg->dwPChannel = ref->header.dwPChannel;
+            msg->dwVirtualTrackID = play->track_id;
+            msg->dwType = DMUS_PMSGT_NOTE;
+            msg->dwGroupID = -1;
+            msg->mtDuration = note->mtDuration;
+            msg->wMusicValue = note->wMusicValue;
+            msg->nOffset = note->nTimeOffset;
+            play_position(sig, time, &msg->wMeasure, &msg->bBeat, &msg->bGrid);
+            msg->bVelocity = note->bVelocity;
+            msg->bFlags = DMUS_NOTEF_NOTEON;
+            msg->bTimeRange = note->bTimeRange;
+            msg->bDurRange = note->bDurRange;
+            msg->bVelRange = note->bVelRange;
+            msg->bPlayModeFlags = mode;
+            msg->bSubChordLevel = ref->header.bSubChordLevel;
+            msg->bMidiValue = min(max(play_music_value_to_midi(note->wMusicValue, mode, sub), 0), 127);
+            if (FAILED(hr = play_send(play, cycle->graph, (DMUS_PMSG *)msg))) return hr;
+        }
+
+        for (i = 0; i < part->curves_count; i++)
+        {
+            const DMUS_IO_STYLECURVE *curve = &part->curves[i];
+            DMUS_CURVE_PMSG *msg;
+
+            if (!(curve->dwVariation & (1u << variation))) continue;
+            time = base + curve->mtGridStart * grid_len;
+            if (time < 0 || time >= cycle->length || time >= base + part_len) continue;
+            time += cycle->start;
+            if (time < play->start || time >= play->end) continue;
+
+            if (FAILED(hr = IDirectMusicPerformance_AllocPMsg(play->performance, sizeof(*msg),
+                    (DMUS_PMSG **)&msg)))
+                return hr;
+#ifdef SG_MUTANT_PERFOFFSET
+            msg->mtTime = time + curve->nTimeOffset;
+#else
+            msg->mtTime = time + curve->nTimeOffset + play->offset;
+#endif
+            msg->dwFlags = DMUS_PMSGF_MUSICTIME;
+            msg->dwPChannel = ref->header.dwPChannel;
+            msg->dwVirtualTrackID = play->track_id;
+            msg->dwType = DMUS_PMSGT_CURVE;
+            msg->dwGroupID = -1;
+            msg->mtDuration = curve->mtDuration;
+            msg->mtOriginalStart = msg->mtTime;
+            msg->mtResetDuration = curve->mtResetDuration;
+            msg->nStartValue = curve->nStartValue;
+            msg->nEndValue = curve->nEndValue;
+            msg->nResetValue = curve->nResetValue;
+            play_position(sig, time, &msg->wMeasure, &msg->bBeat, &msg->bGrid);
+            msg->nOffset = curve->nTimeOffset;
+            msg->bType = curve->bEventType;
+            msg->bCurveShape = curve->bCurveShape;
+            msg->bCCData = curve->bCCData;
+            msg->bFlags = curve->bFlags;
+            msg->wParamType = curve->wParamType;
+            msg->wMergeIndex = curve->wMergeIndex;
+            if (FAILED(hr = play_send(play, cycle->graph, (DMUS_PMSG *)msg))) return hr;
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT play_pattern(struct style *This, struct play_cycle *cycle)
+{
+    const struct style_part_ref *ref;
+    HRESULT hr;
+
+    memset(cycle->lock, 0xff, sizeof(cycle->lock));
+    LIST_FOR_EACH_ENTRY(ref, &cycle->pattern->part_refs, struct style_part_ref, entry)
+    {
+        const struct style_part *part = style_find_part(This, &ref->header.guidPartID);
+        if (!part) continue;
+        if (FAILED(hr = play_part(cycle, ref, part, play_select_variation(cycle, part, ref))))
+            return hr;
+    }
+    return S_OK;
+}
+
+/* the normal pattern or the embellishment of a command for a groove level, one of the
+ * candidates being picked at random */
+static const struct style_pattern *style_select_pattern(struct style *This, BYTE command,
+        BYTE level, DWORD *rng)
+{
+    const struct style_pattern *pattern, *found = NULL;
+    WORD embellishment;
+    int count, pass;
+
+    switch (command)
+    {
+    case DMUS_COMMANDT_FILL: embellishment = DMUS_EMBELLISHT_FILL; break;
+    case DMUS_COMMANDT_INTRO: embellishment = DMUS_EMBELLISHT_INTRO; break;
+    case DMUS_COMMANDT_BREAK: embellishment = DMUS_EMBELLISHT_BREAK; break;
+    case DMUS_COMMANDT_END: embellishment = DMUS_EMBELLISHT_END; break;
+    case DMUS_COMMANDT_ENDANDINTRO: embellishment = DMUS_EMBELLISHT_END | DMUS_EMBELLISHT_INTRO; break;
+    default: embellishment = DMUS_EMBELLISHT_NORMAL; break;
+    }
+
+    /* the second pass: an embellishment the style does not have is replaced by a groove */
+    for (pass = 0; pass < 2 && !found; pass++)
+    {
+        WORD wanted = pass ? DMUS_EMBELLISHT_NORMAL : embellishment;
+        int pick;
+
+        if (pass && !embellishment) break;
+        count = 0;
+        LIST_FOR_EACH_ENTRY(pattern, &This->patterns, struct style_pattern, entry)
+        {
+            if (pattern_is_motif(pattern)) continue;
+            if (wanted ? !(pattern->pattern.wEmbellishment & wanted) : pattern->pattern.wEmbellishment)
+                continue;
+            if (level < pattern->pattern.bGrooveBottom || level > pattern->pattern.bGrooveTop) continue;
+            count++;
+        }
+        if (!count) continue;
+
+        pick = play_rand(rng) % count;
+        LIST_FOR_EACH_ENTRY(pattern, &This->patterns, struct style_pattern, entry)
+        {
+            if (pattern_is_motif(pattern)) continue;
+            if (wanted ? !(pattern->pattern.wEmbellishment & wanted) : pattern->pattern.wEmbellishment)
+                continue;
+            if (level < pattern->pattern.bGrooveBottom || level > pattern->pattern.bGrooveTop) continue;
+            if (!pick--) { found = pattern; break; }
+        }
+    }
+    return found;
+}
+
+HRESULT style_play_range(IDirectMusicStyle8 *iface, const struct style_play *play)
+{
+    struct style *This = impl_from_IDirectMusicStyle8(iface);
+    struct play_cycle cycle = {.play = play};
+    IDirectMusicGraph *graph;
+    MUSIC_TIME start;
+    HRESULT hr = S_OK;
+
+    if (iface->lpVtbl != &dmstyle8_vtbl) return E_INVALIDARG;
+    if (!play->performance) return E_POINTER;
+    if (play->end <= play->start) return S_OK;
+    if (FAILED(hr = IDirectMusicPerformance_QueryInterface(play->performance,
+            &IID_IDirectMusicGraph, (void **)&graph)))
+        return hr;
+    cycle.graph = graph;
+
+    if (play->motif)
+    {
+        const struct style_pattern *pattern;
+
+        LIST_FOR_EACH_ENTRY(pattern, &This->patterns, struct style_pattern, entry)
+        {
+            if (!pattern_is_motif(pattern) || !(pattern->desc.dwValidData & DMUS_OBJ_NAME)) continue;
+            if (!lstrcmpiW(play->motif, pattern->desc.wszName)) break;
+        }
+        if (&pattern->entry != &This->patterns)
+        {
+            cycle.pattern = pattern;
+            cycle.start = play->origin;
+            cycle.length = pattern_length(pattern);
+            cycle.rng = play->seed;
+            hr = play_pattern(This, &cycle);
+        }
+        IDirectMusicGraph_Release(graph);
+        return hr;
+    }
+
+#ifdef SG_MUTANT_ORIGIN
+    start = 0;
+#else
+    start = play->origin;
+#endif
+    for (; start < play->end && cycle.cycle_no < PLAY_MAX_CYCLES; cycle.cycle_no++)
+    {
+        DMUS_COMMAND_PARAM command = {DMUS_COMMANDT_GROOVE, PLAY_DEFAULT_LEVEL};
+        MUSIC_TIME next;
+
+#ifdef SG_MUTANT_COMMAND
+        if (1)
+#else
+        if (FAILED(play_get_param(play, &GUID_CommandParam, start, &next, &command)))
+#endif
+        {
+            command.bCommand = DMUS_COMMANDT_GROOVE;
+            command.bGrooveLevel = PLAY_DEFAULT_LEVEL;
+        }
+
+        cycle.rng = play->seed ^ (cycle.cycle_no * 2654435761u) ^ (DWORD)play->origin;
+        if (!(cycle.pattern = style_select_pattern(This, command.bCommand, command.bGrooveLevel,
+                &cycle.rng)))
+            break;
+        cycle.start = start;
+        cycle.length = pattern_length(cycle.pattern);
+        if (cycle.length <= 0) break;
+
+        if (start + cycle.length > play->start && FAILED(hr = play_pattern(This, &cycle))) break;
+        start += cycle.length;
+    }
+
+    IDirectMusicGraph_Release(graph);
+    return hr;
+}
