d3drm: search path and default texture colours/shades

IDirect3DRM, 2 and 3 keep a search path (Set, Add with a semicolon, Get with
the size query) and validate the default texture colour and shade counts.
---
--- a/dlls/d3drm/d3drm.c
+++ b/dlls/d3drm/d3drm.c
@@ -191,6 +191,8 @@ struct d3drm
     IDirect3DRM2 IDirect3DRM2_iface;
     IDirect3DRM3 IDirect3DRM3_iface;
     LONG ref1, ref2, ref3, iface_count;
+    char *search_path;
+    DWORD texture_colors, texture_shades;
 };
 
 static inline struct d3drm *impl_from_IDirect3DRM(IDirect3DRM *iface)
@@ -211,9 +213,71 @@ static inline struct d3drm *impl_from_IDirect3DRM3(IDirect3DRM3 *iface)
 static void d3drm_destroy(struct d3drm *d3drm)
 {
     TRACE("d3drm object %p is being destroyed.\n", d3drm);
+    free(d3drm->search_path);
     free(d3drm);
 }
 
+/* The search path is a list of directories separated by semicolons. */
+static HRESULT d3drm_set_search_path(struct d3drm *d3drm, const char *path, BOOL append)
+{
+    size_t old_len = append && d3drm->search_path ? strlen(d3drm->search_path) : 0;
+    char *new_path;
+
+    if (!path)
+        return D3DRMERR_BADVALUE;
+#ifdef SG_MUTANT_DRM_APPEND_REPLACE
+    old_len = 0;
+#endif
+    if (!(new_path = malloc(old_len + (old_len ? 1 : 0) + strlen(path) + 1)))
+        return E_OUTOFMEMORY;
+    if (old_len)
+    {
+        memcpy(new_path, d3drm->search_path, old_len);
+        new_path[old_len] = ';';
+        old_len++;
+    }
+    strcpy(new_path + old_len, path);
+    free(d3drm->search_path);
+    d3drm->search_path = new_path;
+    return D3DRM_OK;
+}
+
+static HRESULT d3drm_get_search_path(struct d3drm *d3drm, DWORD *size, char *path)
+{
+    const char *current = d3drm->search_path ? d3drm->search_path : "";
+    DWORD needed = strlen(current) + 1;
+
+    if (!size)
+        return D3DRMERR_BADVALUE;
+    if (!path || *size < needed)
+    {
+        /* the size needed, in characters with the terminator */
+        *size = needed;
+        return path ? D3DRMERR_BADVALUE : D3DRM_OK;
+    }
+    memcpy(path, current, needed);
+    *size = needed;
+    return D3DRM_OK;
+}
+
+static HRESULT d3drm_set_texture_colors(struct d3drm *d3drm, DWORD count)
+{
+#ifndef SG_MUTANT_DRM_ZERO_COLORS
+    if (!count)
+        return D3DRMERR_BADVALUE;
+#endif
+    d3drm->texture_colors = count;
+    return D3DRM_OK;
+}
+
+static HRESULT d3drm_set_texture_shades(struct d3drm *d3drm, DWORD count)
+{
+    if (!count)
+        return D3DRMERR_BADVALUE;
+    d3drm->texture_shades = count;
+    return D3DRM_OK;
+}
