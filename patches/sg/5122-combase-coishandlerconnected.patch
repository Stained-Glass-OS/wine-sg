From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] combase: CoIsHandlerConnected detects disconnected proxies

A proxy whose apartment ended or whose in-process server was
disconnected is reported not connected.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/combase/marshal.c b/dlls/combase/marshal.c
--- a/dlls/combase/marshal.c
+++ b/dlls/combase/marshal.c
@@ -1943,6 +1943,46 @@
     return hr;
 }
 
+/* Whether an object that CoIsHandlerConnected is asked about is still connected
+ * to what it stands for.  Only a proxy can be disconnected: its apartment has
+ * been torn down (channels dropped), or the object it stands for was
+ * disconnected in this process (its stub manager is gone).  A server in another
+ * process cannot be told without a call, so it counts as connected. */
+BOOL proxy_manager_is_connected(IUnknown *object)
+{
+    struct apartment *stub_apt;
+    struct stub_manager *stubmgr;
+    struct proxy_manager *pm;
+    struct ifproxy *ifproxy;
+    IClientSecurity *cs;
+    BOOL connected = TRUE;
+
+    if (FAILED(IUnknown_QueryInterface(object, &IID_IClientSecurity, (void **)&cs))) return TRUE;
+    if (cs->lpVtbl != &ProxyCliSec_Vtbl)
+    {
+        IClientSecurity_Release(cs);
+        return TRUE;
+    }
+    pm = impl_from_IClientSecurity(cs);
+
+    EnterCriticalSection(&pm->cs);
+    LIST_FOR_EACH_ENTRY(ifproxy, &pm->interfaces, struct ifproxy, entry)
+    {
+        if (!ifproxy->chan) connected = FALSE;
+    }
+    LeaveCriticalSection(&pm->cs);
+
+    if (connected && (stub_apt = apartment_findfromoxid(pm->oxid)))
+    {
+        if ((stubmgr = get_stub_manager(stub_apt, pm->oid))) stub_manager_int_release(stubmgr);
+        else connected = FALSE;
+        apartment_release(stub_apt);
+    }
+
+    IClientSecurity_Release(cs);
+    return connected;
+}
+
 static void proxy_manager_disconnect(struct proxy_manager * This)
 {
     struct ifproxy *ifproxy;
diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -3948,9 +3948,10 @@
  */
 BOOL WINAPI CoIsHandlerConnected(IUnknown *object)
 {
-    FIXME("%p\n", object);
+    TRACE("%p\n", object);
 
-    return TRUE;
+    if (!object) return TRUE;
+    return proxy_manager_is_connected(object);
 }
 
 /***********************************************************************
diff --git a/dlls/combase/combase_private.h b/dlls/combase/combase_private.h
--- a/dlls/combase/combase_private.h
+++ b/dlls/combase/combase_private.h
@@ -127,6 +127,7 @@
 void apartment_global_cleanup(void);
 OXID apartment_getoxid(const struct apartment *apt);
 HRESULT apartment_disconnectproxies(struct apartment *apt);
+BOOL proxy_manager_is_connected(IUnknown *object);
 
 /* RpcSs interface */
 HRESULT rpcss_get_next_seqid(DWORD *id);
