From: Stained Glass OS <ke7oxh@gmail.com>
d3dx9: saving an indexed surface as DDS without a palette

D3DXSaveSurfaceToFileInMemory(D3DXIFF_DDS) of a P8 or A8P8 surface with no
palette converts to 32-bit pixels through an all-black opaque default
palette instead of returning E_NOTIMPL. Removes the two todo_wine marks of
the DDS save tests.
---
--- a/dlls/d3dx9_36/surface.c
+++ b/dlls/d3dx9_36/surface.c
@@ -723,6 +723,7 @@ static HRESULT save_dds_surface_to_memory(ID3DXBuffer **dst_buffer, IDirect3DSur
     D3DLOCKED_RECT locked_rect;
     ID3DXBuffer *buffer;
     RECT src_rect_temp;
+    BOOL convert_indexed = FALSE;
     HRESULT hr;
 
     IDirect3DSurface9_GetDesc(src_surface, &src_surface_desc);
@@ -730,10 +731,21 @@ static HRESULT save_dds_surface_to_memory(ID3DXBuffer **dst_buffer, IDirect3DSur
     if (is_unknown_format(src_fmt_desc))
         return E_NOTIMPL;
 
+    /* Without a palette the indices are taken as entries of an all-black, opaque one, and
+     * the file gets 32-bit pixels. */
     if (!src_palette && is_index_format(src_fmt_desc))
     {
-        FIXME("Default palette unimplemented.\n");
+        static PALETTEENTRY default_palette[256];
+        unsigned int i;
+
+#ifdef SG_MUTANT_D3DXDDS_NO_DEFAULT_PALETTE
         return E_NOTIMPL;
+#endif
+        if (!default_palette[0].peFlags)
+            for (i = 0; i < ARRAY_SIZE(default_palette); ++i)
+                default_palette[i].peFlags = 0xff;
+        src_palette = default_palette;
+        convert_indexed = TRUE;
     }
 
     if (src_rect)
@@ -764,7 +776,29 @@ static HRESULT save_dds_surface_to_memory(ID3DXBuffer **dst_buffer, IDirect3DSur
         return hr;
     }
 
-    hr = d3dx_save_pixels_to_memory(&src_pixels, src_fmt_desc, D3DXIFF_DDS, &buffer);
+#ifdef SG_MUTANT_D3DXDDS_KEEP_INDEXED
+    convert_indexed = FALSE;
+#endif
+    if (convert_indexed)
+    {
+        const struct pixel_format_desc *argb_desc = get_format_info(D3DFMT_A8R8G8B8);
+        unsigned int width = src_rect->right - src_rect->left, height = src_rect->bottom - src_rect->top;
+        struct d3dx_pixels argb_pixels;
+        uint8_t *argb_data;
+
+        if (!(argb_data = calloc(height ? height : 1, (width ? width : 1) * 4)))
+            hr = E_OUTOFMEMORY;
+        else if (SUCCEEDED(hr = d3dx_pixels_init(argb_data, width * 4, 0, NULL, argb_desc->format, 0, 0, width,
+                height, 0, 1, &argb_pixels))
+                && SUCCEEDED(hr = d3dx_load_pixels_from_pixels(&argb_pixels, argb_desc, &src_pixels, src_fmt_desc,
+                D3DX_FILTER_NONE, 0)))
+            hr = d3dx_save_pixels_to_memory(&argb_pixels, argb_desc, D3DXIFF_DDS, &buffer);
+        free(argb_data);
+    }
+    else
+    {
+        hr = d3dx_save_pixels_to_memory(&src_pixels, src_fmt_desc, D3DXIFF_DDS, &buffer);
+    }
     if (FAILED(hr))
     {
         unlock_surface(src_surface, NULL, temp_surface, FALSE);
