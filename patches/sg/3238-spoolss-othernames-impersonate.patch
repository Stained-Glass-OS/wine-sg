From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:58:40 -0700
Subject: [PATCH] spoolss: BuildOtherNamesFromMachineName and
 RevertToPrinterSelf/ImpersonatePrinterClient (3238)

BuildOtherNamesFromMachineName returns the list the conformance test
records: "", the computer name, the IPv4/IPv6 address of every adapter and
"::1" (todo_wine removed). RevertToPrinterSelf returns the impersonated
thread token (NULL when not impersonating) and drops the impersonation;
ImpersonatePrinterClient resumes it with that token and consumes the handle.

diff --git a/dlls/spoolss/spoolss_main.c b/dlls/spoolss/spoolss_main.c
index 2b8f83a..36d64ff 100644
--- a/dlls/spoolss/spoolss_main.c
+++ b/dlls/spoolss/spoolss_main.c
@@ -24,6 +24,10 @@
 #include "winbase.h"
 #include "winerror.h"
 #include "winreg.h"
+#include "winsock2.h"
+#include "ws2tcpip.h"
+#include "iphlpapi.h"
+#include "ip2string.h"
 
 #include "wingdi.h"
 #include "winspool.h"
@@ -90,14 +94,113 @@ LPWSTR WINAPI AllocSplStr(LPCWSTR pwstr)
 
 /******************************************************************
  *   BuildOtherNamesFromMachineName   [SPOOLSS.@]
+ *
+ * Build the list of names the local machine answers to: an empty string,
+ * the computer name, the IPv4 address of every adapter, the IPv6 addresses
+ * and "::1" (the layout recorded in the conformance test).
+ *
+ * PARAMS
+ *  buffers [O] receives an array of string pointers (one block, released
+ *              with DllFreeSplMem or HeapFree)
+ *  count   [O] number of strings
  */
-BOOL WINAPI BuildOtherNamesFromMachineName(LPVOID * ptr1, LPVOID * ptr2)
+BOOL WINAPI BuildOtherNamesFromMachineName(LPWSTR **buffers, LPDWORD count)
 {
-    FIXME("(%p, %p) stub\n", ptr1, ptr2);
+    ULONG (WINAPI *pGetAdaptersAddresses)(ULONG, ULONG, void *, IP_ADAPTER_ADDRESSES *, ULONG *);
+    IP_ADAPTER_ADDRESSES *aa = NULL, *a;
+    IP_ADAPTER_UNICAST_ADDRESS *u;
+    WCHAR host[MAX_COMPUTERNAME_LENGTH + 1], tmp[64];
+    DWORD hostlen = ARRAY_SIZE(host), n, pass;
+    ULONG size = 0, ret;
+    HMODULE iphlp;
+    LPWSTR *array;
+    WCHAR *pos;
+    DWORD total, chars;
+
+    TRACE("(%p, %p)\n", buffers, count);
+
+    if (!buffers || !count)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    *buffers = NULL;
+    *count = 0;
 
-    *ptr1 = NULL;
-    *ptr2 = NULL;
-    return FALSE;
+    if (!GetComputerNameW(host, &hostlen)) return FALSE;
+
+    iphlp = LoadLibraryW(L"iphlpapi.dll");
+    pGetAdaptersAddresses = iphlp ? (void *)GetProcAddress(iphlp, "GetAdaptersAddresses") : NULL;
+    if (pGetAdaptersAddresses)
+    {
+        ULONG flags = GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER;
+        ret = pGetAdaptersAddresses(AF_UNSPEC, flags, NULL, NULL, &size);
+        if (ret == ERROR_BUFFER_OVERFLOW && (aa = HeapAlloc(GetProcessHeap(), 0, size)))
+        {
+            if (pGetAdaptersAddresses(AF_UNSPEC, flags, NULL, aa, &size))
+            {
+                HeapFree(GetProcessHeap(), 0, aa);
+                aa = NULL;
+            }
+        }
+    }
+
+    /* pass 0 counts, pass 1 fills: IPv4 of every adapter, then IPv6, then "::1" */
+    array = NULL; pos = NULL; total = 0; chars = 0;
+    for (pass = 0; pass < 2; pass++)
+    {
+        DWORD fam, idx = 0;
+
+        n = 0;
+        if (pass)
+        {
+            array = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, total * sizeof(*array) + chars * sizeof(WCHAR));
+            if (!array)
+            {
+                HeapFree(GetProcessHeap(), 0, aa);
+                if (iphlp) FreeLibrary(iphlp);
+                SetLastError(ERROR_OUTOFMEMORY);
+                return FALSE;
+            }
+            pos = (WCHAR *)(array + total);
+        }
+#define ADD(str) do { const WCHAR *_s = (str); DWORD _l = lstrlenW(_s) + 1; \
+            if (pass) { array[idx++] = pos; memcpy(pos, _s, _l * sizeof(WCHAR)); pos += _l; } \
+            else chars += _l; n++; } while (0)
+        ADD(L"");
+        ADD(host);
+        for (fam = AF_INET; fam <= AF_INET6; fam += AF_INET6 - AF_INET)
+        {
+            for (a = aa; a; a = a->Next)
+            {
+                if (a->IfType == IF_TYPE_SOFTWARE_LOOPBACK || a->OperStatus != IfOperStatusUp) continue;
+                for (u = a->FirstUnicastAddress; u; u = u->Next)
+                {
+                    if (u->Address.lpSockaddr->sa_family != fam) continue;
+                    if (fam == AF_INET)
+                        RtlIpv4AddressToStringW(&((SOCKADDR_IN *)u->Address.lpSockaddr)->sin_addr, tmp);
+                    else
+                    {
+                        IN6_ADDR *a6 = &((SOCKADDR_IN6 *)u->Address.lpSockaddr)->sin6_addr;
+                        if (IN6_IS_ADDR_LOOPBACK(a6)) continue;
+                        RtlIpv6AddressToStringW(a6, tmp);
+                    }
+                    ADD(tmp);
+                }
+            }
+        }
+#ifndef SG_MUTANT_SPOOL_NOLOOP
+        ADD(L"::1");
+#endif
+#undef ADD
+        if (!pass) total = n;
+    }
+
+    HeapFree(GetProcessHeap(), 0, aa);
+    if (iphlp) FreeLibrary(iphlp);
+    *buffers = array;
+    *count = total;
+    return TRUE;
 }
 
 /******************************************************************
@@ -171,11 +274,24 @@ BOOL WINAPI DllFreeSplStr(LPWSTR pwstr)
 
 /******************************************************************
  *   ImpersonatePrinterClient   [SPOOLSS.@]
+ *
+ * Resume impersonating the client; hToken is the value returned by
+ * RevertToPrinterSelf (NULL when the thread was not impersonating, which
+ * leaves the thread as it is). The token handle is consumed.
  */
 BOOL WINAPI ImpersonatePrinterClient(HANDLE hToken)
 {
-    FIXME("(%p) stub\n", hToken);
+    BOOL ret;
+
+    TRACE("(%p)\n", hToken);
+
+    if (!hToken) return TRUE;
+#ifdef SG_MUTANT_SPOOL_NOIMP
     return TRUE;
+#endif
+    ret = SetThreadToken(NULL, hToken);
+    CloseHandle(hToken);
+    return ret;
 }
 
 /******************************************************************
@@ -198,11 +314,27 @@ BOOL WINAPI IsLocalCall(void)
 
 /******************************************************************
  *   RevertToPrinterSelf   [SPOOLSS.@]
+ *
+ * Stop impersonating and return the token of the impersonated client, or
+ * NULL when the thread was not impersonating.
  */
 HANDLE WINAPI RevertToPrinterSelf(void)
 {
-    FIXME("() stub\n");
-    return (HANDLE) 0xdead0947;
+    HANDLE token = NULL;
+
+    TRACE("()\n");
+
+#ifdef SG_MUTANT_SPOOL_FAKEREVERT
+    return (HANDLE)0xdead0947;
+#endif
+    if (!OpenThreadToken(GetCurrentThread(), TOKEN_IMPERSONATE | TOKEN_QUERY, TRUE, &token))
+        return NULL;
+    if (!SetThreadToken(NULL, NULL))
+    {
+        CloseHandle(token);
+        return NULL;
+    }
+    return token;
 }
 
 /******************************************************************
diff --git a/dlls/spoolss/tests/spoolss.c b/dlls/spoolss/tests/spoolss.c
index 07af82e..556a28b 100644
--- a/dlls/spoolss/tests/spoolss.c
+++ b/dlls/spoolss/tests/spoolss.c
@@ -164,7 +164,6 @@ static void test_BuildOtherNamesFromMachineName(void)
       entry_#y: <ip-address> Tunnel adapter (string with a IPv6 ip-address)
     */
 
-    todo_wine
     ok( res && (buffers != NULL) && (numentries >= 3) && (buffers[0] != NULL) && (buffers[0][0] == '\0'),
         "got %lu with %lu and %p,%lu (%p:%d)\n", res, GetLastError(), buffers, numentries,
         ((numentries > 0) && buffers) ? buffers[0] : NULL,
