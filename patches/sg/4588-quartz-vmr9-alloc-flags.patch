From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: Accept the documented flag combinations in AllocateSurfaceHelper.

AllocateSurfaceHelper compared the allocation flags as a whole, so the
documented combinations failed with E_NOTIMPL: "The
VMR9AllocFlag_TextureSurface flag can be combined with the
VMR9AllocFlag_DXVATarget and VMR9AllocFlag_3DRenderTarget flags." Such a
texture is now created as a render-target texture, and the
VMR9AllocFlag_RGBDynamicSwitch hint (the format may switch between RGB and
YUV) no longer stops any surface type. A DXVA target that is not a texture
still has its FIXME: only a DXVA decoder service can make one.

Gate: test/quartz-vmr9-alloc-gate.sh (64/32, its own Xvfb).
---
 dlls/quartz/vmr9.c | 23 ++++++++++++++++++-----
 1 file changed, 18 insertions(+), 5 deletions(-)

diff --git a/dlls/quartz/vmr9.c b/dlls/quartz/vmr9.c
index 7c0f019..ce0abe6 100644
--- a/dlls/quartz/vmr9.c
+++ b/dlls/quartz/vmr9.c
@@ -1718,7 +1718,7 @@ static HRESULT WINAPI VMR9SurfaceAllocatorNotify_ChangeD3DDevice(IVMRSurfaceAllo
 static HRESULT WINAPI VMR9SurfaceAllocatorNotify_AllocateSurfaceHelper(IVMRSurfaceAllocatorNotify9 *iface, VMR9AllocationInfo *allocinfo, DWORD *numbuffers, IDirect3DSurface9 **surface)
 {
     struct quartz_vmr *This = impl_from_IVMRSurfaceAllocatorNotify9(iface);
-    DWORD i;
+    DWORD i, flags;
     HRESULT hr = S_OK;
 
     TRACE("filter %p, allocinfo %p, numbuffers %p, surface %p.\n", This, numbuffers, allocinfo, surface);
@@ -1762,7 +1762,14 @@ static HRESULT WINAPI VMR9SurfaceAllocatorNotify_AllocateSurfaceHelper(IVMRSurfa
         return VFW_E_WRONG_STATE;
     }
 
-    if (allocinfo->dwFlags == VMR9AllocFlag_OffscreenSurface)
+    /* RGBDynamicSwitch only says the format may change between RGB and YUV;
+     * a texture can also be a render target (3D or DXVA) */
+    flags = allocinfo->dwFlags & ~VMR9AllocFlag_RGBDynamicSwitch;
+#ifdef SG_MUTANT_VMR9_EXACT_FLAGS
+    flags = allocinfo->dwFlags;
+#endif
+
+    if (flags == VMR9AllocFlag_OffscreenSurface)
     {
         for (i = 0; i < *numbuffers; ++i)
         {
@@ -1772,13 +1779,17 @@ static HRESULT WINAPI VMR9SurfaceAllocatorNotify_AllocateSurfaceHelper(IVMRSurfa
                 break;
         }
     }
-    else if (allocinfo->dwFlags == VMR9AllocFlag_TextureSurface)
+    else if (flags == VMR9AllocFlag_TextureSurface
+            || flags == (VMR9AllocFlag_TextureSurface | VMR9AllocFlag_3DRenderTarget)
+            || flags == (VMR9AllocFlag_TextureSurface | VMR9AllocFlag_DXVATarget))
     {
+        DWORD usage = flags == VMR9AllocFlag_TextureSurface ? D3DUSAGE_DYNAMIC : D3DUSAGE_RENDERTARGET;
+
         for (i = 0; i < *numbuffers; ++i)
         {
             IDirect3DTexture9 *texture;
 
-            hr = IDirect3DDevice9_CreateTexture(This->allocator_d3d9_dev, allocinfo->dwWidth, allocinfo->dwHeight, 1, D3DUSAGE_DYNAMIC,
+            hr = IDirect3DDevice9_CreateTexture(This->allocator_d3d9_dev, allocinfo->dwWidth, allocinfo->dwHeight, 1, usage,
                                                 allocinfo->Format, allocinfo->Pool, &texture, NULL);
             if (FAILED(hr))
                 break;
@@ -1786,7 +1797,7 @@ static HRESULT WINAPI VMR9SurfaceAllocatorNotify_AllocateSurfaceHelper(IVMRSurfa
             IDirect3DTexture9_Release(texture);
         }
     }
-    else if (allocinfo->dwFlags == VMR9AllocFlag_3DRenderTarget)
+    else if (flags == VMR9AllocFlag_3DRenderTarget)
     {
         for (i = 0; i < *numbuffers; ++i)
         {
@@ -1798,6 +1809,8 @@ static HRESULT WINAPI VMR9SurfaceAllocatorNotify_AllocateSurfaceHelper(IVMRSurfa
     }
     else
     {
+        /* a DXVA target that is not a texture is a decoder surface, which only a
+         * DXVA decoder service could create */
         FIXME("Unhandled flags %#lx.\n", allocinfo->dwFlags);
         return E_NOTIMPL;
     }
