From: Stained Glass OS <ke7oxh@gmail.com>
Subject: powershell: the 32-bit stub finds the 64-bit PowerShell 7

Visual Studio 2022's installer could not add the C++ desktop workload
(1603): its VC++ redistributable package runs
"c:\windows\syswow64\windowspowershell\v1.0\powershell.exe -Command & ...ps1",
and the 32-bit stub did not hand the script to PowerShell 7 (0517): in a
32-bit process %ProgramFiles% is Program Files (x86) and App Paths is read
in the 32-bit view, while pwsh is 64-bit, in Program Files and the 64-bit
App Paths. The stub fell back to its own handling and the script failed.

The stub now also looks in the 64-bit App Paths (RRF_SUBKEY_WOW6464KEY) and
under %ProgramW6432%, before the 32-bit places.

Gate: test-powershell (the syswow64 powershell runs a stand-in pwsh in
Program Files\PowerShell\7). Mutant SG_MUTANT_PWSH_32BIT_VIEW.

--- a/programs/powershell/main.c
+++ b/programs/powershell/main.c
@@ -61,9 +61,24 @@
     DWORD len = size * sizeof(WCHAR);
     WCHAR *file;
 
+    /* the 64-bit view and %ProgramW6432% too: the 32-bit powershell (syswow64) sees the
+     * 32-bit App Paths and Program Files (x86), and PowerShell 7 is 64-bit. Visual Studio's
+     * installer runs its VC++ redistributable script with the 32-bit one, and it failed. */
+#ifndef SG_MUTANT_PWSH_32BIT_VIEW
+    if (!RegGetValueW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\pwsh.exe",
+                      NULL, RRF_RT_REG_SZ | RRF_SUBKEY_WOW6464KEY, NULL, out, &len) &&
+        GetFileAttributesW(out) != INVALID_FILE_ATTRIBUTES)
+        return TRUE;
+    len = size * sizeof(WCHAR);
+#endif
     if (!RegGetValueW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\pwsh.exe",
                       NULL, RRF_RT_REG_SZ, NULL, out, &len) && GetFileAttributesW(out) != INVALID_FILE_ATTRIBUTES)
         return TRUE;
+#ifndef SG_MUTANT_PWSH_32BIT_VIEW
+    if (ExpandEnvironmentStringsW(L"%ProgramW6432%\\PowerShell\\7\\pwsh.exe", out, size)
+        && out[0] != '%' && GetFileAttributesW(out) != INVALID_FILE_ATTRIBUTES)
+        return TRUE;
+#endif
     if (ExpandEnvironmentStringsW(L"%ProgramFiles%\\PowerShell\\7\\pwsh.exe", out, size)
         && GetFileAttributesW(out) != INVALID_FILE_ATTRIBUTES)
         return TRUE;
