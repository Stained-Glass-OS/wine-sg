From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui: Windows.Data.Xml.Dom calls give back their node (6545)

xmldom.c (0437) wrapped the MSXML node a call returned with the call in
the wrapper's own argument list: wrap_result( IXMLDOMNode_appendChild(
..., &node ), node, ... ). The order in which arguments are evaluated is
unspecified, and the node was read before the call filled it:
AppendChild succeeded and gave back no node. SnoreToast, KDE's toast
helper that digiKam and Kdenlive run, appends <audio> to a toast template
and uses the node at once: it crashed ("SnoreToast.exe has encountered a
serious problem") at digiKam's first start.

Such calls now pass the out variable's address (wrap_out, boxed_bstr_out),
which is read after the call: the parent, first/last child and sibling
getters, InsertBefore, ReplaceChild, RemoveChild, AppendChild, CloneNode,
the namespace/local name/prefix getters and SetNamedItem. A conformance
test does SnoreToast's sequence.
---
diff --git a/dlls/windows.ui/tests/xmldom.c b/dlls/windows.ui/tests/xmldom.c
index f10a9b9..602fd1c 100644
--- a/dlls/windows.ui/tests/xmldom.c
+++ b/dlls/windows.ui/tests/xmldom.c
@@ -451,6 +451,63 @@ done:
     IXmlDocument_Release( content );
 }
 
+/* SnoreToast (KDE's notification helper, digiKam): a template's <toast> gets
+ * an <audio> child; the appended node is used at once. */
+static void test_template_append(void)
+{
+    IToastNotificationManagerStatics *manager;
+    IXmlNamedNodeMap *attributes;
+    IXmlNodeList *list = NULL;
+    IXmlNode *root = NULL, *tmp = NULL, *appended = NULL;
+    IXmlElement *audio = NULL;
+    IXmlDocument *xml = NULL;
+    HSTRING name;
+    HRESULT hr;
+
+    name = hs( RuntimeClass_Windows_UI_Notifications_ToastNotificationManager );
+    hr = RoGetActivationFactory( name, &IID_IToastNotificationManagerStatics, (void **)&manager );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    WindowsDeleteString( name );
+    if (hr != S_OK) return;
+    hr = IToastNotificationManagerStatics_GetTemplateContent( manager, ToastTemplateType_ToastText02, &xml );
+    ok( hr == S_OK && xml, "got hr %#lx\n", hr );
+    IToastNotificationManagerStatics_Release( manager );
+    if (!xml) return;
+
+    name = hs( L"toast" );
+    hr = IXmlDocument_GetElementsByTagName( xml, name, &list );
+    ok( hr == S_OK && list, "got hr %#lx\n", hr );
+    WindowsDeleteString( name );
+    hr = IXmlNodeList_Item( list, 0, &root );
+    ok( hr == S_OK && root, "got hr %#lx\n", hr );
+    hr = IXmlNode_get_Attributes( root, &attributes );
+    ok( hr == S_OK && attributes, "got hr %#lx\n", hr );
+    if (attributes) IXmlNamedNodeMap_Release( attributes );
+
+    name = hs( L"audio" );
+    hr = IXmlDocument_CreateElement( xml, name, &audio );
+    ok( hr == S_OK && audio, "got hr %#lx\n", hr );
+    WindowsDeleteString( name );
+    hr = IXmlElement_QueryInterface( audio, &IID_IXmlNode, (void **)&tmp );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    hr = IXmlNode_AppendChild( root, tmp, &appended );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    ok( appended != NULL, "no appended node\n" );
+    if (appended)
+    {
+        attributes = NULL;
+        hr = IXmlNode_get_Attributes( appended, &attributes );
+        ok( hr == S_OK && attributes, "got hr %#lx\n", hr );
+        if (attributes) IXmlNamedNodeMap_Release( attributes );
+        IXmlNode_Release( appended );
+    }
+    IXmlNode_Release( tmp );
+    IXmlElement_Release( audio );
+    IXmlNode_Release( root );
+    IXmlNodeList_Release( list );
+    IXmlDocument_Release( xml );
+}
+
 START_TEST(xmldom)
 {
     HRESULT hr;
@@ -462,6 +519,7 @@ START_TEST(xmldom)
     test_node_kinds();
     test_prefix();
     test_schedule();
+    test_template_append();
 
     RoUninitialize();
 }
diff --git a/dlls/windows.ui/xmldom.c b/dlls/windows.ui/xmldom.c
index dbce42f..dbe7751 100644
--- a/dlls/windows.ui/xmldom.c
+++ b/dlls/windows.ui/xmldom.c
@@ -136,6 +136,21 @@ static HRESULT unbox_string( IInspectable *value, BSTR *out )
     return S_OK;
 }
 
+static HRESULT wrap_result( HRESULT hr, IXMLDOMNode *node, REFIID iid, void **out );
+
+/* Stained Glass OS: as wrap_result, for a call made in the argument list: its
+ * out value is read here, after the call, not alongside it (the order in
+ * which a call's arguments are evaluated is unspecified, and the node was
+ * read before the call filled it: AppendChild returned no node, SnoreToast
+ * crashed) */
+static HRESULT wrap_out( HRESULT hr, IXMLDOMNode **node, REFIID iid, void **out )
+{
+#ifdef SG_MUTANT_XML_OUT_BEFORE_CALL
+    if (iid == &IID_IXmlNode) { *out = NULL; return hr; }
+#endif
+    return wrap_result( hr, *node, iid, out );
+}
+
 static HRESULT wrap_result( HRESULT hr, IXMLDOMNode *node, REFIID iid, void **out )
 {
     *out = NULL;
@@ -415,7 +430,7 @@ static HRESULT WINAPI xml_node_get_ParentNode( IXmlNode *iface, IXmlNode **value
     struct xml_node *impl = impl_from_IXmlNode( iface );
     IXMLDOMNode *node = NULL;
     TRACE( "iface %p, value %p.\n", iface, value );
-    return wrap_result( IXMLDOMNode_get_parentNode( impl->node, &node ), node, &IID_IXmlNode, (void **)value );
+    return wrap_out( IXMLDOMNode_get_parentNode( impl->node, &node ), &node, &IID_IXmlNode, (void **)value );
 }
 
 static HRESULT WINAPI xml_node_get_ChildNodes( IXmlNode *iface, IXmlNodeList **value )
@@ -438,7 +453,7 @@ static HRESULT WINAPI xml_node_get_FirstChild( IXmlNode *iface, IXmlNode **value
     struct xml_node *impl = impl_from_IXmlNode( iface );
     IXMLDOMNode *node = NULL;
     TRACE( "iface %p, value %p.\n", iface, value );
-    return wrap_result( IXMLDOMNode_get_firstChild( impl->node, &node ), node, &IID_IXmlNode, (void **)value );
+    return wrap_out( IXMLDOMNode_get_firstChild( impl->node, &node ), &node, &IID_IXmlNode, (void **)value );
 }
 
 static HRESULT WINAPI xml_node_get_LastChild( IXmlNode *iface, IXmlNode **value )
@@ -446,7 +461,7 @@ static HRESULT WINAPI xml_node_get_LastChild( IXmlNode *iface, IXmlNode **value
     struct xml_node *impl = impl_from_IXmlNode( iface );
     IXMLDOMNode *node = NULL;
     TRACE( "iface %p, value %p.\n", iface, value );
-    return wrap_result( IXMLDOMNode_get_lastChild( impl->node, &node ), node, &IID_IXmlNode, (void **)value );
+    return wrap_out( IXMLDOMNode_get_lastChild( impl->node, &node ), &node, &IID_IXmlNode, (void **)value );
 }
 
 static HRESULT WINAPI xml_node_get_PreviousSibling( IXmlNode *iface, IXmlNode **value )
@@ -454,7 +469,7 @@ static HRESULT WINAPI xml_node_get_PreviousSibling( IXmlNode *iface, IXmlNode **
     struct xml_node *impl = impl_from_IXmlNode( iface );
     IXMLDOMNode *node = NULL;
     TRACE( "iface %p, value %p.\n", iface, value );
-    return wrap_result( IXMLDOMNode_get_previousSibling( impl->node, &node ), node, &IID_IXmlNode, (void **)value );
+    return wrap_out( IXMLDOMNode_get_previousSibling( impl->node, &node ), &node, &IID_IXmlNode, (void **)value );
 }
 
 static HRESULT WINAPI xml_node_get_NextSibling( IXmlNode *iface, IXmlNode **value )
@@ -462,7 +477,7 @@ static HRESULT WINAPI xml_node_get_NextSibling( IXmlNode *iface, IXmlNode **valu
     struct xml_node *impl = impl_from_IXmlNode( iface );
     IXMLDOMNode *node = NULL;
     TRACE( "iface %p, value %p.\n", iface, value );
-    return wrap_result( IXMLDOMNode_get_nextSibling( impl->node, &node ), node, &IID_IXmlNode, (void **)value );
+    return wrap_out( IXMLDOMNode_get_nextSibling( impl->node, &node ), &node, &IID_IXmlNode, (void **)value );
 }
 
 static const struct IXmlNamedNodeMapVtbl xml_named_node_map_vtbl;
@@ -528,7 +543,7 @@ static HRESULT WINAPI xml_node_InsertBefore( IXmlNode *iface, IXmlNode *new_chil
     if (!child) return E_INVALIDARG;
     V_VT( &var ) = ref ? VT_UNKNOWN : VT_NULL;
     V_UNKNOWN( &var ) = (IUnknown *)ref;
-    return wrap_result( IXMLDOMNode_insertBefore( impl->node, child, var, &node ), node, &IID_IXmlNode, (void **)inserted_child );
+    return wrap_out( IXMLDOMNode_insertBefore( impl->node, child, var, &node ), &node, &IID_IXmlNode, (void **)inserted_child );
 }
 
 static HRESULT WINAPI xml_node_ReplaceChild( IXmlNode *iface, IXmlNode *new_child, IXmlNode *reference_child,
@@ -540,7 +555,7 @@ static HRESULT WINAPI xml_node_ReplaceChild( IXmlNode *iface, IXmlNode *new_chil
     TRACE( "iface %p, new_child %p, reference_child %p, replaced_child %p.\n", iface, new_child, reference_child, replaced_child );
 
     if (!child || !ref) return E_INVALIDARG;
-    return wrap_result( IXMLDOMNode_replaceChild( impl->node, child, ref, &node ), node, &IID_IXmlNode, (void **)replaced_child );
+    return wrap_out( IXMLDOMNode_replaceChild( impl->node, child, ref, &node ), &node, &IID_IXmlNode, (void **)replaced_child );
 }
 
 static HRESULT WINAPI xml_node_RemoveChild( IXmlNode *iface, IXmlNode *child_node, IXmlNode **removed_child )
@@ -551,7 +566,7 @@ static HRESULT WINAPI xml_node_RemoveChild( IXmlNode *iface, IXmlNode *child_nod
     TRACE( "iface %p, child_node %p, removed_child %p.\n", iface, child_node, removed_child );
 
     if (!child) return E_INVALIDARG;
-    return wrap_result( IXMLDOMNode_removeChild( impl->node, child, &node ), node, &IID_IXmlNode, (void **)removed_child );
+    return wrap_out( IXMLDOMNode_removeChild( impl->node, child, &node ), &node, &IID_IXmlNode, (void **)removed_child );
 }
 
 static HRESULT WINAPI xml_node_AppendChild( IXmlNode *iface, IXmlNode *new_child, IXmlNode **appended_child )
@@ -562,7 +577,7 @@ static HRESULT WINAPI xml_node_AppendChild( IXmlNode *iface, IXmlNode *new_child
     TRACE( "iface %p, new_child %p, appended_child %p.\n", iface, new_child, appended_child );
 
     if (!child) return E_INVALIDARG;
-    return wrap_result( IXMLDOMNode_appendChild( impl->node, child, &node ), node, &IID_IXmlNode, (void **)appended_child );
+    return wrap_out( IXMLDOMNode_appendChild( impl->node, child, &node ), &node, &IID_IXmlNode, (void **)appended_child );
 }
 
 static HRESULT WINAPI xml_node_CloneNode( IXmlNode *iface, boolean deep, IXmlNode **new_node )
@@ -570,8 +585,15 @@ static HRESULT WINAPI xml_node_CloneNode( IXmlNode *iface, boolean deep, IXmlNod
     struct xml_node *impl = impl_from_IXmlNode( iface );
     IXMLDOMNode *node = NULL;
     TRACE( "iface %p, deep %d, new_node %p.\n", iface, deep, new_node );
-    return wrap_result( IXMLDOMNode_cloneNode( impl->node, deep ? VARIANT_TRUE : VARIANT_FALSE, &node ),
-                        node, &IID_IXmlNode, (void **)new_node );
+    return wrap_out( IXMLDOMNode_cloneNode( impl->node, deep ? VARIANT_TRUE : VARIANT_FALSE, &node ),
+                        &node, &IID_IXmlNode, (void **)new_node );
+}
+
+static HRESULT boxed_bstr_result( HRESULT hr, BSTR str, IInspectable **value );
+
+static HRESULT boxed_bstr_out( HRESULT hr, BSTR *str, IInspectable **value )
+{
+    return boxed_bstr_result( hr, *str, value );
 }
 
 static HRESULT boxed_bstr_result( HRESULT hr, BSTR str, IInspectable **value )
