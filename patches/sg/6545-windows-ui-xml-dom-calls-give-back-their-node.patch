@@ -2814,7 +2836,7 @@ static HRESULT WINAPI xml_named_node_map_SetNamedItem( IXmlNamedNodeMap *iface,
     struct xml_named_node_map *impl = impl_from_IXmlNamedNodeMap( iface );
     IXMLDOMNode *item = dom_node( (IUnknown *)node ), *old = NULL;
     if (!item) return E_INVALIDARG;
