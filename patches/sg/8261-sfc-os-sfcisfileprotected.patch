From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sfc_os: SfcIsFileProtected

SfcIsFileProtected says whether Windows Resource Protection guards a file: here, a file in the system directory (or the WoW64 one, or the Windows directory) that is one of Wine's own modules, a builtin or placeholder DLL or program. Anything else is not protected (FALSE, ERROR_FILE_NOT_FOUND). It said "not protected" for every file.
---
--- a/dlls/sfc_os/sfc_os.c
+++ b/dlls/sfc_os/sfc_os.c
@@ -57,26 +57,59 @@
  *           when the File is not Protected
  *
  *
- * BUGS
- *  We return always the Result for: "File is not Protected"
- *
+ * (wine-sg 8261) Windows Resource Protection guards the system's own files: here, a file in the system
+ * directory (or the WoW64 one, or the Windows directory) that is one of Wine's own modules -- a builtin
+ * or placeholder DLL or program. Anything else is not protected.
  */
+#ifndef SG_MUTANT_NO_SFC_PROTECTED
+static BOOL is_wine_module(const WCHAR *path)
+{
+    static const char builtin[] = "Wine builtin DLL", placeholder[] = "Wine placeholder DLL";
+    char buf[0x40 + sizeof(placeholder)];
+    DWORD got = 0;
+    HANDLE file;
+    BOOL ret;
+
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                       OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    ret = ReadFile(file, buf, sizeof(buf), &got, NULL) && got == sizeof(buf) && buf[0] == 'M' && buf[1] == 'Z' &&
+          (!memcmp(buf + 0x40, builtin, sizeof(builtin) - 1) || !memcmp(buf + 0x40, placeholder, sizeof(placeholder) - 1));
+    CloseHandle(file);
+    return ret;
+}
+
 BOOL WINAPI SfcIsFileProtected(HANDLE RpcHandle, LPCWSTR ProtFileName)
 {
-    static BOOL reported = FALSE;
+    WCHAR full[MAX_PATH], dir[MAX_PATH], *name;
+    UINT len;
+    int i;
+
+    TRACE("(%p, %s)\n", RpcHandle, debugstr_w(ProtFileName));
 
-    if (reported) {
-        TRACE("(%p, %s) stub\n", RpcHandle, debugstr_w(ProtFileName));
+    if (!ProtFileName || !GetFullPathNameW(ProtFileName, ARRAY_SIZE(full), full, &name) || !name)
+    {
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return FALSE;
     }
-    else
+    for (i = 0; i < 3; i++)
     {
-        FIXME("(%p, %s) stub\n", RpcHandle, debugstr_w(ProtFileName));
-        reported = TRUE;
+        len = i == 0 ? GetSystemDirectoryW(dir, ARRAY_SIZE(dir)) :
+              i == 1 ? GetSystemWow64DirectoryW(dir, ARRAY_SIZE(dir)) : GetWindowsDirectoryW(dir, ARRAY_SIZE(dir));
+        if (!len || len >= ARRAY_SIZE(dir)) continue;
+        if (name - full == len + 1 && !wcsnicmp(full, dir, len) && full[len] == '\\' && is_wine_module(full))
+            return TRUE;
     }
-
     SetLastError(ERROR_FILE_NOT_FOUND);
     return FALSE;
 }
+#else
+BOOL WINAPI SfcIsFileProtected(HANDLE RpcHandle, LPCWSTR ProtFileName)
+{
+    SetLastError(ERROR_FILE_NOT_FOUND);
+    return FALSE;
+}
+#endif
 
 /******************************************************************
  *              SfcIsKeyProtected     [sfc_os.@]
