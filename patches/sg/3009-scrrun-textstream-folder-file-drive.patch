+/* Renames path to a new leaf name in the same directory. Returns the new full path in *new_path. */
+static HRESULT path_rename(const WCHAR *path, const WCHAR *name, WCHAR **new_path)
+{
+    const WCHAR *leaf = wcsrchr(path, '\\');
+    size_t dirlen = leaf ? leaf - path + 1 : 0;
+    WCHAR *buf;
+
+    if (!name || !*name || wcspbrk(name, L"\\/:*?\"<>|")) return E_INVALIDARG;
+
+    if (!(buf = malloc((dirlen + wcslen(name) + 1) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    memcpy(buf, path, dirlen * sizeof(WCHAR));
+    wcscpy(buf + dirlen, name);
+
+    if (!MoveFileW(path, buf))
+    {
+        HRESULT hr = create_error(GetLastError());
+        free(buf);
+        return hr;
+    }
+    *new_path = buf;
+    return S_OK;
+}
+
+static HRESULT path_get_type(const WCHAR *path, BSTR *ret)
+{
+    const WCHAR *ext;
+
+    if (!ret) return E_POINTER;
+
+    if (GetFileAttributesW(path) & FILE_ATTRIBUTE_DIRECTORY)
+        *ret = SysAllocString(L"File Folder");
+    else if ((ext = wcsrchr(path, '.')) && ext[1] && !wcschr(ext, '\\'))
+    {
+        WCHAR buf[64];
+
+        WCHAR *ptr;
+
+        swprintf(buf, ARRAY_SIZE(buf), L"%s File", ext + 1);
+        for (ptr = buf; *ptr != ' '; ptr++) *ptr = towupper(*ptr);
+        *ret = SysAllocString(buf);
+    }
+    else
+        *ret = SysAllocString(L"File");
+    return *ret ? S_OK : E_OUTOFMEMORY;
+}
