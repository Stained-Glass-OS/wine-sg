+static BOOL path_is_root(const WCHAR *path)
+{
+    size_t len = wcslen(path);
+
+    if (len && (path[len - 1] == '\\' || path[len - 1] == '/')) len--;
+    return len == 2 && path[1] == ':';
+}
+
+static HRESULT path_get_short(const WCHAR *path, BOOL name_only, BSTR *ret)
+{
+    WCHAR *buf, *ptr;
+    DWORD len;
+
+    if (!ret) return E_POINTER;
+    *ret = NULL;
+
+    len = GetShortPathNameW(path, NULL, 0);
+    if (!len) return create_error(GetLastError());
+    if (!(buf = malloc(len * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    if (!GetShortPathNameW(path, buf, len))
+    {
+        free(buf);
+        return create_error(GetLastError());
+    }
+
+    ptr = buf;
+    if (name_only && (ptr = wcsrchr(buf, '\\'))) ptr++;
+    else if (name_only) ptr = buf;
+    *ret = SysAllocString(ptr);
+    free(buf);
+    return *ret ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT path_get_drive(const WCHAR *path, IDrive **drive)
+{
+    if (!drive) return E_POINTER;
+    *drive = NULL;
+
+    if (path[0] && path[1] == ':')
+        return create_drive(towupper(path[0]), drive);
+
+    /* UNC shares are not supported as drives */
+    return E_FAIL;
+}
+
+static HRESULT path_get_parent(const WCHAR *path, IFolder **parent)
+{
+    WCHAR *buf, *ptr;
+    HRESULT hr;
+    size_t len;
+
+    if (!parent) return E_POINTER;
+    *parent = NULL;
+
+    if (path_is_root(path)) return S_OK;
+
+    len = wcslen(path);
+    if (!(buf = malloc((len + 2) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    wcscpy(buf, path);
+    while (len > 3 && (buf[len - 1] == '\\' || buf[len - 1] == '/')) buf[--len] = 0;
+    if (!(ptr = wcsrchr(buf, '\\')))
+    {
+        free(buf);
+        return E_FAIL;
+    }
+    if (ptr == buf + 2 && buf[1] == ':') ptr++; /* keep root backslash */
+    *ptr = 0;
+    hr = create_folder(buf, parent);
+    free(buf);
+    return hr;
+}
