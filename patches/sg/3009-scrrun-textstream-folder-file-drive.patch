+static void textstream_advance(struct textstream *stream, const WCHAR *str, size_t len)
+{
+    while (len--)
+    {
+        if (*str == '\n')
+        {
+            stream->line++;
+            stream->column = 0;
+        }
+        else if (*str != '\r')
+            stream->column++;
+        str++;
+    }
+}
