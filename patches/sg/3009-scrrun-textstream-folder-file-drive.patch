+static HRESULT folder_tree_size(const WCHAR *path, ULARGE_INTEGER *size)
+{
+    WIN32_FIND_DATAW fd;
+    WCHAR *pattern, *child;
+    HANDLE find;
+    size_t len = wcslen(path);
+
+    pattern = malloc((len + 3) * sizeof(WCHAR));
+    if (!pattern) return E_OUTOFMEMORY;
+    wcscpy(pattern, path);
+    if (len && pattern[len - 1] != '\\') wcscat(pattern, L"\\");
+    len = wcslen(pattern);
+    wcscat(pattern, L"*");
+
+    find = FindFirstFileW(pattern, &fd);
+    if (find == INVALID_HANDLE_VALUE)
+    {
+        free(pattern);
+        return create_error(GetLastError());
+    }
+
+    do
+    {
+        if (is_dir_data(&fd))
+        {
+            HRESULT hr;
+
+            if (!(child = malloc((len + wcslen(fd.cFileName) + 1) * sizeof(WCHAR))))
+            {
+                FindClose(find);
+                free(pattern);
+                return E_OUTOFMEMORY;
+            }
+            memcpy(child, pattern, len * sizeof(WCHAR));
+            wcscpy(child + len, fd.cFileName);
+            hr = folder_tree_size(child, size);
+            free(child);
+            if (FAILED(hr))
+            {
+                FindClose(find);
+                free(pattern);
+                return hr;
+            }
+        }
+        else if (is_file_data(&fd))
+            size->QuadPart += ((ULONGLONG)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+    } while (FindNextFileW(find, &fd));
+
+    FindClose(find);
+    free(pattern);
+    return S_OK;
+}
