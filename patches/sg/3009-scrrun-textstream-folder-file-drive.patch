+static HRESULT path_get_attributes(const WCHAR *path, FileAttribute *attr)
+{
+    DWORD fa;
+
+    if (!attr) return E_POINTER;
+
+    fa = GetFileAttributesW(path);
+    if (fa == INVALID_FILE_ATTRIBUTES) return create_error(GetLastError());
+
+    *attr = fa & (FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM |
+            FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_ARCHIVE | FILE_ATTRIBUTE_REPARSE_POINT |
+            FILE_ATTRIBUTE_COMPRESSED);
+    return S_OK;
+}
+
+static HRESULT path_get_date(const WCHAR *path, int which, DATE *date)
+{
+    WIN32_FILE_ATTRIBUTE_DATA attrs;
+    const FILETIME *ft;
+    FILETIME local;
+    SYSTEMTIME st;
+
+    if (!date) return E_POINTER;
+
+    if (!GetFileAttributesExW(path, GetFileExInfoStandard, &attrs)) return E_FAIL;
+
+    ft = which == 0 ? &attrs.ftCreationTime : which == 1 ? &attrs.ftLastWriteTime : &attrs.ftLastAccessTime;
+    FileTimeToLocalFileTime(ft, &local);
+    FileTimeToSystemTime(&local, &st);
+    SystemTimeToVariantTime(&st, date);
+    return S_OK;
+}
