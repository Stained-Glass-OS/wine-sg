+/* Destination of a Move/Copy: a directory (or a name with a trailing separator) takes the source name. */
+static WCHAR *path_join_destination(const WCHAR *src, const WCHAR *dest)
+{
+    size_t dlen = wcslen(dest);
+    const WCHAR *name = wcsrchr(src, '\\');
+    DWORD attrs = GetFileAttributesW(dest);
+    WCHAR *ret;
+
+    name = name ? name + 1 : src;
+    ret = malloc((dlen + wcslen(name) + 2) * sizeof(WCHAR));
+    if (!ret) return NULL;
+    wcscpy(ret, dest);
+    if ((attrs != INVALID_FILE_ATTRIBUTES && (attrs & FILE_ATTRIBUTE_DIRECTORY)) ||
+            (dlen && (dest[dlen - 1] == '\\' || dest[dlen - 1] == '/')))
+    {
+        if (dlen && ret[dlen - 1] != '\\' && ret[dlen - 1] != '/') wcscat(ret, L"\\");
+        wcscat(ret, name);
+    }
+    return ret;
+}
