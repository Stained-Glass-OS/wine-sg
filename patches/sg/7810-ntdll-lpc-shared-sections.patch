+    REQ_set_port_view,
     REQ_complete_port_connect,
     REQ_send_port_message,
     REQ_receive_port_message,
@@ -7109,6 +7134,7 @@ union generic_request
     struct connect_port_request connect_port_request;
     struct get_port_connect_result_request get_port_connect_result_request;
     struct accept_port_connect_request accept_port_connect_request;
+    struct set_port_view_request set_port_view_request;
     struct complete_port_connect_request complete_port_connect_request;
     struct send_port_message_request send_port_message_request;
     struct receive_port_message_request receive_port_message_request;
@@ -7438,6 +7464,7 @@ union generic_reply
     struct connect_port_reply connect_port_reply;
     struct get_port_connect_result_reply get_port_connect_result_reply;
     struct accept_port_connect_reply accept_port_connect_reply;
+    struct set_port_view_reply set_port_view_reply;
     struct complete_port_connect_reply complete_port_connect_reply;
     struct send_port_message_reply send_port_message_reply;
     struct receive_port_message_reply receive_port_message_reply;
@@ -7446,6 +7473,6 @@ union generic_reply
     struct sg_chmod_fd_reply sg_chmod_fd_reply;
 };
 
-#define SERVER_PROTOCOL_VERSION 879
+#define SERVER_PROTOCOL_VERSION 880
 
 #endif /* __WINE_WINE_SERVER_PROTOCOL_H */
diff --git a/server/file.h b/server/file.h
index 0d96bcf..ebe4618 100644
--- a/server/file.h
+++ b/server/file.h
@@ -196,6 +196,7 @@ extern struct mapping *create_fd_mapping( struct object *root, const struct unic
                                           unsigned int attr, const struct security_descriptor *sd );
 extern struct object *create_user_data_mapping( struct object *root, const struct unicode_str *name,
                                                 unsigned int attr, const struct security_descriptor *sd );
+extern struct object *get_section_obj( struct process *process, obj_handle_t handle, unsigned int access );
 extern struct mapping *create_session_mapping( struct object *root, const struct unicode_str *name,
