diff --git a/server/mapping.c b/server/mapping.c
index 05eef19..5cd566a 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -1187,6 +1187,12 @@ static struct mapping *get_mapping_obj( struct process *process, obj_handle_t ha
     return (struct mapping *)get_handle_obj( process, handle, access, &mapping_ops );
 }
 
+/* Stained Glass OS: a section object, for the LPC ports' shared views (wine-sg 7810) */
+struct object *get_section_obj( struct process *process, obj_handle_t handle, unsigned int access )
+{
+    return get_handle_obj( process, handle, access, &mapping_ops );
+}
+
 /* open a new file for the file descriptor backing the view */
 struct file *get_view_file( const struct memory_view *view, unsigned int access, unsigned int sharing )
 {
diff --git a/server/port.c b/server/port.c
index 39dcc95..253af70 100644
--- a/server/port.c
+++ b/server/port.c
@@ -47,6 +47,7 @@
 #include "process.h"
 #include "request.h"
 #include "security.h"
+#include "file.h"
 
 #define PORT_CONNECT     0x0001
 #define PORT_ALL_ACCESS  (STANDARD_RIGHTS_REQUIRED | SYNCHRONIZE | PORT_CONNECT)
@@ -99,8 +100,16 @@ struct port
     struct sid        *server_sid;     /* connection port: the user of the process that created it */
     int                closed;         /* the last handle was closed */
     int                connect_done;   /* client port: accepted or refused, the client was not told yet */
+    /* client port: the shared sections of the connection (wine-sg 7810) */
+    struct object     *client_view;    /* the client's section, for the server to map (holds a ref) */
+    unsigned int       client_view_offset, client_view_size;
+    client_ptr_t       client_view_remote; /* where the server mapped it */
+    struct object     *server_view;    /* the server's section, for the client to map (holds a ref) */
+    unsigned int       server_view_offset, server_view_size;
 };
 
+#define PORT_SECTION_ACCESS  (SECTION_QUERY | SECTION_MAP_READ | SECTION_MAP_WRITE)
+
 struct port_msg
 {
     struct list    entry;
@@ -183,6 +192,9 @@ static void init_port( struct port *port, enum port_kind kind )
     port->server_sid = NULL;
     port->closed     = 0;
     port->connect_done = 0;
+    port->client_view = NULL;
+    port->client_view_remote = 0;
+    port->server_view = NULL;
 }
 
 static struct port *alloc_port( enum port_kind kind )
@@ -414,6 +426,8 @@ static void port_destroy( struct object *obj )
     if (port->connection) release_object( port->connection );
     free( port->info );
     free( port->server_sid );
+    if (port->client_view) release_object( port->client_view );
+    if (port->server_view) release_object( port->server_view );
 }
 
 static struct port *get_port_obj( struct process *process, obj_handle_t handle, unsigned int access )
@@ -519,6 +533,15 @@ DECL_HANDLER(connect_port)
     {
         client->connection = (struct port *)grab_object( connection );
         client->max_data   = connection->max_data;
+        if (req->section && !(client->client_view = get_section_obj( current->process, req->section,
+                                                                     PORT_SECTION_ACCESS )))
+        {
+            release_object( client );
+            release_object( connection );
+            return;
+        }
+        client->client_view_offset = req->section_offset;
+        client->client_view_size   = req->view_size;
         if ((msg = alloc_msg( LPC_CONNECTION_REQUEST, info, info_len )))
         {
             msg->id     = new_msg_id();
@@ -554,6 +577,17 @@ DECL_HANDLER(get_port_connect_result)
         break;
     case CLIENT_CONNECTED:
         reply->info_len = port->info_len;
+        reply->client_view_remote = port->client_view_remote;
+        if (port->server_view)
+        {
+            /* the server's section, once, for the client to map */
+            reply->server_section = alloc_handle_no_access_check( current->process, port->server_view,
+                                                                  PORT_SECTION_ACCESS, 0 );
+            reply->server_offset  = port->server_view_offset;
+            reply->server_size    = port->server_view_size;
+            release_object( port->server_view );
+            port->server_view = NULL;
+        }
         if (port->info_len) set_reply_data( port->info, min( port->info_len, get_reply_max_size() ));
         break;
     case CLIENT_REFUSED:
@@ -572,6 +606,7 @@ DECL_HANDLER(accept_port_connect)
 {
     struct port_msg *msg, *found = NULL;
     struct port *client, *server, *connection;
+    struct object *server_view = NULL;
 
     LIST_FOR_EACH_ENTRY( msg, &awaiting, struct port_msg, entry )
     {
@@ -610,7 +645,13 @@ DECL_HANDLER(accept_port_connect)
         set_error( STATUS_PORT_MESSAGE_TOO_LONG );
         return;
     }
-    if (!(server = alloc_port( PORT_KIND_SERVER ))) return;
+    if (req->section && !(server_view = get_section_obj( current->process, req->section, PORT_SECTION_ACCESS )))
+        return;
+    if (!(server = alloc_port( PORT_KIND_SERVER )))
+    {
+        if (server_view) release_object( server_view );
+        return;
+    }
     server->connection = (struct port *)grab_object( connection );
     server->max_data   = connection->max_data;
     server->context    = req->context;
@@ -621,13 +662,41 @@ DECL_HANDLER(accept_port_connect)
         client->info = client->info_len ? memdup( get_req_data(), client->info_len ) : NULL;
         server->peer = client;
         client->peer = server;
+        /* the shared sections: the client's for this process to map now, the server's for the client */
+        if (client->client_view)
+        {
+            reply->client_section = alloc_handle_no_access_check( current->process, client->client_view,
+                                                                  PORT_SECTION_ACCESS, 0 );
+            reply->client_offset  = client->client_view_offset;
+            reply->client_size    = client->client_view_size;
+        }
+        if (client->server_view) release_object( client->server_view );
+        client->server_view = server_view;
+        client->server_view_offset = req->section_offset;
+        client->server_view_size   = req->view_size;
+        server_view = NULL;
         list_add_tail( &connection->servers, &server->server_entry );
         list_remove( &found->entry );
         free_msg( found );
     }
+    if (server_view) release_object( server_view );
     release_object( server );
 }
 
+/* where the server mapped the client's section: the client's NtConnectPort reports it */
+DECL_HANDLER(set_port_view)
+{
+    struct port *port;
+
+    if (!(port = get_port_obj( current->process, req->handle, 0 ))) return;
+
+    if (port->kind != PORT_KIND_SERVER) set_error( STATUS_INVALID_PORT_HANDLE );
+    else if (!port->peer) set_error( STATUS_PORT_DISCONNECTED );
+    else if (port->peer->state != CLIENT_CONNECTING) set_error( STATUS_INVALID_PARAMETER );
+    else port->peer->client_view_remote = req->remote;
+    release_object( port );
+}
+
 /* the server is ready: the client's NtConnectPort returns */
 DECL_HANDLER(complete_port_connect)
 {
