From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: shared sections for LPC ports

K-LPC leftover (wine-sg 7810). NtConnectPort and NtAcceptConnectPort
refused a section with STATUS_NOT_SUPPORTED. Now each side maps a port's
shared section into its own process, the same range of it: a client's
section (LPC_SECTION_WRITE) is mapped by the client before connecting and
by the server in NtAcceptConnectPort (its LPC_SECTION_READ), which tells
the server where, for the client's TargetViewBase; a server's section is
mapped by the server on accepting and by the client once the connection
completes (its LPC_SECTION_READ). The wineserver holds the section objects
and hands each side a handle (connect_port, accept_port_connect and
get_port_connect_result carry them; new request set_port_view; protocol
880). A 32-bit process's views are mapped below 4 GB, and WoW64 copies the
mapped views back to its LPC_SECTION_WRITE. The server's own
TargetViewBase stays NULL: the client maps that view only after the server
has returned from NtAcceptConnectPort.
---
 dlls/ntdll/unix/sync.c         | 122 ++++++++++++++++++++++++++++++---
 dlls/wow64/sync.c              |  12 ++++
 include/wine/server_protocol.h |  37 ++++++++--
 server/file.h                  |   1 +
 server/mapping.c               |   6 ++
 server/port.c                  |  71 ++++++++++++++++++-
 server/protocol.def            |  20 ++++++
 server/request_handlers.h      |  26 +++++--
 server/request_trace.h         |  22 ++++++
 9 files changed, 297 insertions(+), 20 deletions(-)

diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index e28386e..8264e19 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -2511,26 +2511,58 @@ NTSTATUS WINAPI NtCreateWaitablePort( HANDLE *handle, OBJECT_ATTRIBUTES *attr, U
 }
 
 
+/* Stained Glass OS (wine-sg 7810): a port's shared section is mapped by each side into its own process,
+ * the same range of the section: the side that gives it, before the connection, the other once it gets
+ * a handle to it from the server */
+static NTSTATUS map_port_view( HANDLE section, ULONG offset, ULONG size, void **base, ULONG *mapped )
+{
+    LARGE_INTEGER off;
+    SIZE_T view_size = size;
+    NTSTATUS status;
+
+    off.QuadPart = offset;
+    *base = NULL;
+    /* (a 32-bit process's view must be where it can reach it) */
+    status = NtMapViewOfSection( section, GetCurrentProcess(), base, in_wow64_call() ? 0x7fffffff : 0, 0, &off,
+                                 &view_size, ViewShare, 0, PAGE_READWRITE );
+    if (!status) *mapped = view_size;
+    return status;
+}
+
 static NTSTATUS connect_port( HANDLE *handle, UNICODE_STRING *name, LPC_SECTION_WRITE *write, PSID sid,
                               LPC_SECTION_READ *read, ULONG *max_len, void *info, ULONG *info_len )
 {
     char sid_buffer[SECURITY_MAX_SID_SIZE];
     ULONG in_len = (info && info_len) ? *info_len : 0, sid_len = 0, out_len = 0;
+    ULONG server_offset = 0, server_size = 0;
+    client_ptr_t remote = 0;
+    HANDLE server_section = 0;
     NTSTATUS status;
     HANDLE port = 0;
+    void *view = NULL;
 
     if (!handle || !name) return STATUS_INVALID_PARAMETER;
     *handle = 0;
     if (write && write->SectionHandle)
     {
-        FIXME( "shared sections are not supported\n" );
-        return STATUS_NOT_SUPPORTED;
+        ULONG mapped = 0;
+        if ((status = map_port_view( write->SectionHandle, write->SectionOffset, write->ViewSize, &view, &mapped )))
+            return status;
+        write->ViewBase = view;
+        write->ViewSize = mapped;
+        write->TargetViewBase = NULL;
     }
 
     SERVER_START_REQ( connect_port )
     {
         req->rootdir  = 0;
         req->name_len = name->Length;
+        if (view)
+        {
+            req->section        = wine_server_obj_handle( write->SectionHandle );
+            req->section_offset = write->SectionOffset;
+            req->view_size      = write->ViewSize;
+        }
         wine_server_add_data( req, name->Buffer, name->Length );
         if (in_len) wine_server_add_data( req, info, in_len );
         wine_server_set_reply( req, sid_buffer, sizeof(sid_buffer) );
@@ -2540,7 +2572,11 @@ static NTSTATUS connect_port( HANDLE *handle, UNICODE_STRING *name, LPC_SECTION_
         sid_len = wine_server_reply_size( reply );
     }
     SERVER_END_REQ;
-    if (status) return status;
+    if (status)
+    {
+        if (view) NtUnmapViewOfSection( GetCurrentProcess(), view );
+        return status;
+    }
 
 #ifndef SG_MUTANT_LPC_NO_SID_CHECK
     if (sid && (sid_len < offsetof( SID, SubAuthority[0] ) ||
@@ -2548,6 +2584,7 @@ static NTSTATUS connect_port( HANDLE *handle, UNICODE_STRING *name, LPC_SECTION_
                 memcmp( sid, sid_buffer, sid_len )))
     {
         NtClose( port );
+        if (view) NtUnmapViewOfSection( GetCurrentProcess(), view );
         return STATUS_SERVER_SID_MISMATCH;
     }
 #endif
@@ -2560,6 +2597,10 @@ static NTSTATUS connect_port( HANDLE *handle, UNICODE_STRING *name, LPC_SECTION_
             if (in_len) wine_server_set_reply( req, info, in_len );
             status = wine_server_call( req );
             out_len = reply->info_len;
+            remote = reply->client_view_remote;
+            server_section = wine_server_ptr_handle( reply->server_section );
+            server_offset = reply->server_offset;
+            server_size = reply->server_size;
         }
         SERVER_END_REQ;
         if (status != STATUS_PENDING) break;
@@ -2568,14 +2609,28 @@ static NTSTATUS connect_port( HANDLE *handle, UNICODE_STRING *name, LPC_SECTION_
     if (status)
     {
         NtClose( port );
+        if (view) NtUnmapViewOfSection( GetCurrentProcess(), view );
         return status;
     }
     if (info_len) *info_len = min( out_len, in_len );
+    if (view) write->TargetViewBase = wine_server_get_ptr( remote );
     if (read)
     {
         read->ViewSize = 0;
         read->ViewBase = NULL;
     }
+    if (server_section)
+    {
+        /* the server's section: mapped here too */
+        void *base = NULL;
+        ULONG mapped = 0;
+        if (read && !map_port_view( server_section, server_offset, server_size, &base, &mapped ))
+        {
+            read->ViewBase = base;
+            read->ViewSize = mapped;
+        }
+        NtClose( server_section );
+    }
     *handle = port;
     return STATUS_SUCCESS;
 }
@@ -2624,36 +2679,83 @@ NTSTATUS WINAPI NtListenPort( HANDLE handle, LPC_MESSAGE *msg )
 NTSTATUS WINAPI NtAcceptConnectPort( HANDLE *handle, ULONG id, LPC_MESSAGE *msg, BOOLEAN accept,
                                      LPC_SECTION_WRITE *write, LPC_SECTION_READ *read )
 {
+    HANDLE port = 0, client_section = 0;
+    ULONG client_offset = 0, client_size = 0;
+    void *view = NULL;
     NTSTATUS status;
 
     TRACE( "(%p,%u,%p,%d,%p,%p)\n", handle, (int)id, msg, accept, write, read );
 
     if (!msg) return STATUS_INVALID_PARAMETER;
     if (accept && (status = check_lpc_message( msg ))) return status;
-    if (write && write->SectionHandle)
+    if (handle) *handle = 0;
+    if (accept && write && write->SectionHandle)
     {
-        FIXME( "shared sections are not supported\n" );
-        return STATUS_NOT_SUPPORTED;
+        ULONG mapped = 0;
+        if ((status = map_port_view( write->SectionHandle, write->SectionOffset, write->ViewSize, &view, &mapped )))
+            return status;
+        write->ViewBase = view;
+        write->ViewSize = mapped;
+        /* (where the client maps it is not known yet: it maps it when the connection completes) */
+        write->TargetViewBase = NULL;
     }
-    if (handle) *handle = 0;
 
     SERVER_START_REQ( accept_port_connect )
     {
         req->msg_id  = msg->MessageId;
         req->context = id;
         req->accept  = accept;
+        if (view)
+        {
+            req->section        = wine_server_obj_handle( write->SectionHandle );
+            req->section_offset = write->SectionOffset;
+            req->view_size      = write->ViewSize;
+        }
         if (accept) wine_server_add_data( req, msg->Data, msg->DataSize );
         status = wine_server_call( req );
-        if (handle) *handle = wine_server_ptr_handle( reply->handle );
-        else if (reply->handle) NtClose( wine_server_ptr_handle( reply->handle ));
+        port = wine_server_ptr_handle( reply->handle );
+        client_section = wine_server_ptr_handle( reply->client_section );
+        client_offset = reply->client_offset;
+        client_size = reply->client_size;
     }
     SERVER_END_REQ;
 
-    if (!status && read)
+    if (status)
+    {
+        if (view) NtUnmapViewOfSection( GetCurrentProcess(), view );
+        return status;
+    }
+    if (read)
     {
         read->ViewSize = 0;
         read->ViewBase = NULL;
     }
+    if (client_section)
+    {
+        /* the client's section: mapped here, and the client told where */
+        void *base = NULL;
+        ULONG mapped = 0;
+        if (!map_port_view( client_section, client_offset, client_size, &base, &mapped ))
+        {
+            if (read)
+            {
+                read->ViewBase = base;
+                read->ViewSize = mapped;
+            }
+#ifndef SG_MUTANT_LPC_NO_REMOTE_VIEW
+            SERVER_START_REQ( set_port_view )
+            {
+                req->handle = wine_server_obj_handle( port );
+                req->remote = wine_server_client_ptr( base );
+                wine_server_call( req );
+            }
+            SERVER_END_REQ;
+#endif
+        }
+        NtClose( client_section );
+    }
+    if (handle) *handle = port;
+    else if (port) NtClose( port );
     return status;
 }
 
diff --git a/dlls/wow64/sync.c b/dlls/wow64/sync.c
index 696ce53..2f0604d 100644
--- a/dlls/wow64/sync.c
+++ b/dlls/wow64/sync.c
@@ -60,6 +60,15 @@ static LPC_SECTION_WRITE *lpc_section_write_32to64( LPC_SECTION_WRITE *out, cons
     return out;
 }
 
+/* the views the call mapped (wine-sg 7810) */
+static void lpc_section_write_64to32( LPC_SECTION_WRITE32 *out, const LPC_SECTION_WRITE *in, NTSTATUS status )
+{
+    if (!out || status) return;
+    out->ViewSize       = in->ViewSize;
+    out->ViewBase       = PtrToUlong( in->ViewBase );
+    out->TargetViewBase = PtrToUlong( in->TargetViewBase );
+}
+
 static void lpc_section_read_64to32( LPC_SECTION_READ32 *out, const LPC_SECTION_READ *in, NTSTATUS status )
 {
     if (!out || status) return;
@@ -186,6 +195,7 @@ NTSTATUS WINAPI wow64_NtAcceptConnectPort( UINT *args )
     status = NtAcceptConnectPort( handle_ptr ? &handle : NULL, id, msg, accept,
                                   lpc_section_write_32to64( &write, write32 ), read32 ? &read : NULL );
     if (handle_ptr) put_handle( handle_ptr, handle );
+    lpc_section_write_64to32( write32, &write, status );
     lpc_section_read_64to32( read32, &read, status );
     return status;
 }
@@ -261,6 +271,7 @@ NTSTATUS WINAPI wow64_NtConnectPort( UINT *args )
                             lpc_section_write_32to64( &write, write32 ), read32 ? &read : NULL,
                             max_len, info, info_len );
     put_handle( handle_ptr, handle );
+    lpc_section_write_64to32( write32, &write, status );
     lpc_section_read_64to32( read32, &read, status );
     return status;
 }
@@ -1475,6 +1486,7 @@ NTSTATUS WINAPI wow64_NtSecureConnectPort( UINT *args )
                                   lpc_section_write_32to64( &write, write32 ), sid, read32 ? &read : NULL,
                                   max_len, info, info_len );
     put_handle( handle_ptr, handle );
+    lpc_section_write_64to32( write32, &write, status );
     lpc_section_read_64to32( read32, &read, status );
     return status;
 }
