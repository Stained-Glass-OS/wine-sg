+/* BC1..BC5 unorm: the formats a missing mip chain can be built for */
+static BOOL is_bc123_format(DXGI_FORMAT f)
+{
+    return (f >= DXGI_FORMAT_BC1_TYPELESS && f <= DXGI_FORMAT_BC3_UNORM_SRGB)
+            || (f >= DXGI_FORMAT_BC4_TYPELESS && f <= DXGI_FORMAT_BC4_UNORM)
+            || (f >= DXGI_FORMAT_BC5_TYPELESS && f <= DXGI_FORMAT_BC5_UNORM);
+}
+
+static unsigned int bc_block_size(DXGI_FORMAT f)
+{
+    return (f <= DXGI_FORMAT_BC1_UNORM_SRGB || (f >= DXGI_FORMAT_BC4_TYPELESS && f <= DXGI_FORMAT_BC4_UNORM)) ? 8 : 16;
+}
+
+static BOOL bc_is_dxt(DXGI_FORMAT f)
+{
+    return f >= DXGI_FORMAT_BC1_TYPELESS && f <= DXGI_FORMAT_BC3_UNORM_SRGB;
+}
+
+static void bc_color_endpoints(const BYTE *b, BYTE pal[4][4], BOOL dxt1)
+{
+    unsigned int c0 = b[0] | (b[1] << 8), c1 = b[2] | (b[3] << 8), i;
+    BYTE e[2][3];
+
+    for (i = 0; i < 2; ++i)
+    {
+        unsigned int c = i ? c1 : c0;
+        e[i][0] = ((c >> 11) & 0x1f) * 255 / 31;
+        e[i][1] = ((c >> 5) & 0x3f) * 255 / 63;
+        e[i][2] = (c & 0x1f) * 255 / 31;
+    }
+    for (i = 0; i < 3; ++i)
+    {
+        pal[0][i] = e[0][i];
+        pal[1][i] = e[1][i];
+        if (c0 > c1 || !dxt1)
+        {
+            pal[2][i] = (2 * e[0][i] + e[1][i]) / 3;
+            pal[3][i] = (e[0][i] + 2 * e[1][i]) / 3;
+        }
+        else
+        {
+            pal[2][i] = (e[0][i] + e[1][i]) / 2;
+            pal[3][i] = 0;
+        }
+    }
+    pal[0][3] = pal[1][3] = pal[2][3] = 255;
+    pal[3][3] = (c0 > c1 || !dxt1) ? 255 : 0;
+}
+
+static void bc4_palette(const BYTE *b, BYTE pal[8])
+{
+    unsigned int i;
+
+    pal[0] = b[0];
+    pal[1] = b[1];
+    if (b[0] > b[1])
+        for (i = 1; i < 7; ++i)
+            pal[1 + i] = ((7 - i) * b[0] + i * b[1]) / 7;
+    else
+    {
+        for (i = 1; i < 5; ++i)
+            pal[1 + i] = ((5 - i) * b[0] + i * b[1]) / 5;
+        pal[6] = 0;
+        pal[7] = 255;
+    }
+}
+
+static unsigned int bc4_index(const BYTE *b, unsigned int pixel)
+{
+    unsigned long long bits = 0;
+    unsigned int i;
+
+    for (i = 0; i < 6; ++i)
+        bits |= (unsigned long long)b[2 + i] << (8 * i);
+    return (bits >> (3 * pixel)) & 7;
+}
+
+/* Expands a block compressed level to R8G8B8A8. */
+static HRESULT bc_decode_level(DXGI_FORMAT f, const struct img *src, struct img *out)
+{
+    unsigned int bs = bc_block_size(f), bx, by, px, py, w = src->width, h = src->height;
+
+    memset(out, 0, sizeof(*out));
+    out->width = w;
+    out->height = h;
+    out->depth = 1;
+    out->pitch = w * 4;
+    out->slice_pitch = out->pitch * h;
+    if (!(out->data = calloc(1, out->slice_pitch)))
+        return E_OUTOFMEMORY;
+
+    for (by = 0; by < (h + 3) / 4; ++by)
+        for (bx = 0; bx < (w + 3) / 4; ++bx)
+        {
+            const BYTE *block = src->data + (SIZE_T)by * src->pitch + (SIZE_T)bx * bs;
+
+            for (py = 0; py < 4; ++py)
+                for (px = 0; px < 4; ++px)
+                {
+                    unsigned int x = bx * 4 + px, y = by * 4 + py, pixel = py * 4 + px;
+                    BYTE rgba[4] = {0, 0, 0, 255}, *dst;
+
+                    if (x >= w || y >= h)
+                        continue;
+                    if (bc_is_dxt(f))
+                    {
+                        const BYTE *cb = block + (bs == 16 ? 8 : 0);
+                        BYTE pal[4][4];
+                        unsigned int idx = (cb[4 + py] >> (2 * px)) & 3;
+
+                        bc_color_endpoints(cb, pal, bs == 8);
+                        memcpy(rgba, pal[idx], 4);
+                        if (f >= DXGI_FORMAT_BC2_TYPELESS && f <= DXGI_FORMAT_BC2_UNORM_SRGB)
+                            rgba[3] = ((block[(pixel >> 1)] >> ((pixel & 1) * 4)) & 0xf) * 17;
+                        else if (f >= DXGI_FORMAT_BC3_TYPELESS)
+                        {
+                            BYTE apal[8];
+
+                            bc4_palette(block, apal);
+                            rgba[3] = apal[bc4_index(block, pixel)];
+                        }
+                    }
+                    else
+                    {
+                        BYTE pal[8];
+
+                        bc4_palette(block, pal);
+                        rgba[0] = pal[bc4_index(block, pixel)];
+                        if (bs == 16)
+                        {
+                            bc4_palette(block + 8, pal);
+                            rgba[1] = pal[bc4_index(block + 8, pixel)];
+                        }
+                    }
+                    dst = out->data + (SIZE_T)y * out->pitch + (SIZE_T)x * 4;
+                    memcpy(dst, rgba, 4);
+                }
+        }
+    return S_OK;
+}
+
+static void bc4_encode(const BYTE *values, BYTE *block)
+{
+    BYTE lo = 255, hi = 0, pal[8];
+    unsigned long long bits = 0;
+    unsigned int i, j;
+
+    for (i = 0; i < 16; ++i)
+    {
+        lo = min(lo, values[i]);
+        hi = max(hi, values[i]);
+    }
+    block[0] = hi;
+    block[1] = lo;
+    bc4_palette(block, pal);
+    for (i = 0; i < 16; ++i)
+    {
+        unsigned int best = 0, err = ~0u;
+
+        for (j = 0; j < 8; ++j)
+        {
+            unsigned int d = abs((int)values[i] - pal[j]);
+            if (hi == lo)
+                d = (j == 0) ? 0 : 1;
+            if (d < err)
+            {
+                err = d;
+                best = j;
+            }
+        }
+        bits |= (unsigned long long)best << (3 * i);
+    }
+    for (i = 0; i < 6; ++i)
+        block[2 + i] = bits >> (8 * i);
+}
+
+/* Compresses an R8G8B8A8 level; the image is padded to whole blocks by repeating its edge. */
+static HRESULT compress_level(const struct img *rgba, DXGI_FORMAT format, struct img *out)
+{
+    unsigned int aw = (rgba->width + 3) & ~3u, ah = (rgba->height + 3) & ~3u, x, y, bs = bc_block_size(format);
+    GLenum gl_format = 0x83F1;  /* GL_COMPRESSED_RGBA_S3TC_DXT1_EXT */
+    BYTE *padded;
+
+    if (format >= DXGI_FORMAT_BC2_TYPELESS && format <= DXGI_FORMAT_BC2_UNORM_SRGB)
+        gl_format = 0x83F2;
+    else if (format >= DXGI_FORMAT_BC3_TYPELESS)
+        gl_format = 0x83F3;
+
+    if (!(padded = malloc((SIZE_T)aw * ah * 4)))
+        return E_OUTOFMEMORY;
+    for (y = 0; y < ah; ++y)
+        for (x = 0; x < aw; ++x)
+            memcpy(padded + ((SIZE_T)y * aw + x) * 4,
+                    rgba->data + (SIZE_T)min(y, rgba->height - 1) * rgba->pitch + (SIZE_T)min(x, rgba->width - 1) * 4, 4);
+
+    out->width = rgba->width;
+    out->height = rgba->height;
+    out->depth = 1;
+    out->pitch = aw / 4 * bs;
+    out->slice_pitch = out->pitch * (ah / 4);
+    if (!(out->data = malloc(out->slice_pitch)))
+    {
+        free(padded);
+        return E_OUTOFMEMORY;
+    }
+
+    if (bc_is_dxt(format))
+    {
+        tx_compress_dxtn(4, aw, ah, padded, gl_format, out->data, out->pitch);
+    }
+    else
+    {
+        unsigned int bx, by, i;
+
+        for (by = 0; by < ah / 4; ++by)
+            for (bx = 0; bx < aw / 4; ++bx)
+            {
+                BYTE values[16], *block = out->data + (SIZE_T)by * out->pitch + (SIZE_T)bx * bs;
+
+                for (i = 0; i < 16; ++i)
+                    values[i] = padded[((SIZE_T)(by * 4 + i / 4) * aw + bx * 4 + i % 4) * 4];
+                bc4_encode(values, block);
+                if (bs == 16)
+                {
+                    for (i = 0; i < 16; ++i)
+                        values[i] = padded[((SIZE_T)(by * 4 + i / 4) * aw + bx * 4 + i % 4) * 4 + 1];
+                    bc4_encode(values, block + 8);
+                }
+            }
+    }
+    free(padded);
+    return S_OK;
+}
+
+static unsigned int full_mip_count(unsigned int w, unsigned int h)
+{
+    unsigned int levels = 1, m = max(w, h);
+
+    while (m > 1)
+    {
+        m >>= 1;
+        ++levels;
+    }
+    return levels;
+}
