-    buffer = (void *)data;
-    size = datasize;
+    switch (p->kind)
+    {
+        case JOB_COMPILE:
+            return D3DCompile(data, size, p->filename, p->defines, include, p->entry, p->target,
+                    p->sflags, p->eflags, result, errors);
+
+        case JOB_PREPROCESS:
+            return D3DPreprocess(data, size, p->filename, p->defines, include, result, errors);
+
+        case JOB_EFFECT:
+        case JOB_EFFECT_POOL:
+            if (is_dxbc(data, size))
+            {
+                if (FAILED(hr = D3DCreateBlob(size, result)))
+                    return hr;
+                memcpy(ID3D10Blob_GetBufferPointer(*result), data, size);
+                return S_OK;
+            }
+            if (!p->target)
+            {
+                make_error_blob("The effect profile is not specified.\n", errors);
+                return D3DERR_INVALIDCALL;
