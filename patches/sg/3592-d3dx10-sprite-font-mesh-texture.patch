+    if (FAILED(hr = ID3D10Device_CreateBuffer(sprite->device, &buffer_desc, NULL, &sprite->vb)))
+        goto fail;
+
+    if (!(indices = malloc(SPRITE_BATCH_MAX * 6 * sizeof(*indices))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
+    for (i = 0; i < SPRITE_BATCH_MAX; ++i)
+    {
+        indices[i * 6 + 0] = i * 4 + 0;
+        indices[i * 6 + 1] = i * 4 + 1;
+        indices[i * 6 + 2] = i * 4 + 2;
+        indices[i * 6 + 3] = i * 4 + 2;
+        indices[i * 6 + 4] = i * 4 + 1;
+        indices[i * 6 + 5] = i * 4 + 3;
+    }
+    memset(&buffer_desc, 0, sizeof(buffer_desc));
+    buffer_desc.ByteWidth = SPRITE_BATCH_MAX * 6 * sizeof(*indices);
+    buffer_desc.Usage = D3D10_USAGE_IMMUTABLE;
+    buffer_desc.BindFlags = D3D10_BIND_INDEX_BUFFER;
+    data.pSysMem = indices;
+    data.SysMemPitch = data.SysMemSlicePitch = 0;
+    hr = ID3D10Device_CreateBuffer(sprite->device, &buffer_desc, &data, &sprite->ib);
+    free(indices);
+    if (FAILED(hr))
+        goto fail;
+
+    memset(&blend_desc, 0, sizeof(blend_desc));
+    blend_desc.BlendEnable[0] = TRUE;
+    blend_desc.SrcBlend = D3D10_BLEND_SRC_ALPHA;
+    blend_desc.DestBlend = D3D10_BLEND_INV_SRC_ALPHA;
+    blend_desc.BlendOp = D3D10_BLEND_OP_ADD;
+    blend_desc.SrcBlendAlpha = D3D10_BLEND_ONE;
+    blend_desc.DestBlendAlpha = D3D10_BLEND_INV_SRC_ALPHA;
+    blend_desc.BlendOpAlpha = D3D10_BLEND_OP_ADD;
+    for (i = 0; i < 8; ++i)
+        blend_desc.RenderTargetWriteMask[i] = D3D10_COLOR_WRITE_ENABLE_ALL;
+    if (FAILED(hr = ID3D10Device_CreateBlendState(sprite->device, &blend_desc, &sprite->blend)))
+        goto fail;
+
+    memset(&rs_desc, 0, sizeof(rs_desc));
+    rs_desc.FillMode = D3D10_FILL_SOLID;
+    rs_desc.CullMode = D3D10_CULL_NONE;
+    rs_desc.DepthClipEnable = TRUE;
+    if (FAILED(hr = ID3D10Device_CreateRasterizerState(sprite->device, &rs_desc, &sprite->rasterizer)))
+        goto fail;
+
+    memset(&ds_desc, 0, sizeof(ds_desc));
+    ds_desc.DepthEnable = FALSE;
+    ds_desc.DepthWriteMask = D3D10_DEPTH_WRITE_MASK_ZERO;
+    ds_desc.DepthFunc = D3D10_COMPARISON_ALWAYS;
+    if (FAILED(hr = ID3D10Device_CreateDepthStencilState(sprite->device, &ds_desc, &sprite->depth)))
+        goto fail;
+
+    memset(&smp_desc, 0, sizeof(smp_desc));
+    smp_desc.Filter = D3D10_FILTER_MIN_MAG_MIP_LINEAR;
+    smp_desc.AddressU = smp_desc.AddressV = smp_desc.AddressW = D3D10_TEXTURE_ADDRESS_CLAMP;
+    smp_desc.ComparisonFunc = D3D10_COMPARISON_NEVER;
+    smp_desc.MaxLOD = D3D10_FLOAT32_MAX;
+    if (FAILED(hr = ID3D10Device_CreateSamplerState(sprite->device, &smp_desc, &sprite->sampler)))
+        goto fail;
+
+    return S_OK;
+
+fail:
+    WARN("Failed to create sprite pipeline, hr %#lx.\n", hr);
+    if (vs_blob) ID3D10Blob_Release(vs_blob);
+    sprite_release_gfx(sprite);
+    sprite->gfx_failed = TRUE;
+    return hr;
+}
