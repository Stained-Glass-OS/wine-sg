+/* ---- operations on existing textures ---- */
+
+static unsigned int level_dim(unsigned int base, unsigned int level)
+{
+    return max(base >> level, 1);
+}
+
+static HRESULT read_region(ID3D10Device *device, ID3D10Resource *resource, UINT subresource, const D3D10_BOX *box,
+        DXGI_FORMAT format, unsigned int w, unsigned int h, struct img *out)
+{
+    D3D10_TEXTURE2D_DESC desc;
+    D3D10_MAPPED_TEXTURE2D map;
+    ID3D10Texture2D *staging;
+    unsigned int rows, row_bytes, y;
+    BOOL bc = is_block_compressed_format(format);
+    HRESULT hr;
+
+    memset(&desc, 0, sizeof(desc));
+    desc.Width = bc ? (w + 3) & ~3u : w;
+    desc.Height = bc ? (h + 3) & ~3u : h;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = format;
+    desc.SampleDesc.Count = 1;
+    desc.Usage = D3D10_USAGE_STAGING;
+    desc.CPUAccessFlags = D3D10_CPU_ACCESS_READ;
+    if (FAILED(hr = ID3D10Device_CreateTexture2D(device, &desc, NULL, &staging)))
+        return hr;
+
+    ID3D10Device_CopySubresourceRegion(device, (ID3D10Resource *)staging, 0, 0, 0, 0, resource, subresource, box);
+    if (FAILED(hr = ID3D10Texture2D_Map(staging, 0, D3D10_MAP_READ, 0, &map)))
+    {
+        ID3D10Texture2D_Release(staging);
+        return hr;
+    }
+
+    rows = bc ? desc.Height / 4 : h;
+    row_bytes = bc ? desc.Width / 4 * bc_block_size(format) : (w * get_bpp_from_format(format) + 7) / 8;
+    memset(out, 0, sizeof(*out));
+    out->width = w;
+    out->height = h;
+    out->depth = 1;
+    out->pitch = row_bytes;
+    out->slice_pitch = row_bytes * rows;
+    if (!(out->data = malloc(out->slice_pitch)))
+        hr = E_OUTOFMEMORY;
+    else
+        for (y = 0; y < rows; ++y)
+            memcpy(out->data + (SIZE_T)y * row_bytes, (BYTE *)map.pData + (SIZE_T)y * map.RowPitch, row_bytes);
+
+    ID3D10Texture2D_Unmap(staging, 0);
+    ID3D10Texture2D_Release(staging);
+    return hr;
+}
+
+static HRESULT get_texture2d(ID3D10Resource *resource, ID3D10Texture2D **texture)
+{
+    if (!resource)
+        return E_INVALIDARG;
+    return ID3D10Resource_QueryInterface(resource, &IID_ID3D10Texture2D, (void **)texture);
+}
