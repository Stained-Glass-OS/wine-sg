+            if (FAILED(hr = D3DCompile(data, size, p->filename, p->defines, include ? include : D3D_COMPILE_STANDARD_FILE_INCLUDE,
+                    "main", p->target, p->sflags, p->eflags, result, errors)))
+                WARN("Effect compilation failed, hr %#lx.\n", hr);
+            return hr;
