+            *object = code;
+            return S_OK;
+
+        case JOB_EFFECT:
+            return D3D10CreateEffectFromMemory(ID3D10Blob_GetBufferPointer(code), ID3D10Blob_GetBufferSize(code),
+                    p->eflags, p->device, p->pool, (ID3D10Effect **)object);
+
+        case JOB_EFFECT_POOL:
+            return D3D10CreateEffectPoolFromMemory(ID3D10Blob_GetBufferPointer(code), ID3D10Blob_GetBufferSize(code),
+                    p->eflags, p->device, (ID3D10EffectPool **)object);
+    }
+    return E_FAIL;
+}
