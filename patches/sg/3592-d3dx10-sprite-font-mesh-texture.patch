+
+static const float *mesh_position(const struct d3dx10_mesh *mesh, UINT vertex)
+{
+    const struct mesh_slot *slot = &mesh->slots[mesh->position_slot];
+
+    return (const float *)(slot->data + (SIZE_T)vertex * slot->stride + mesh->position_offset);
+}
+
+static void mesh_release_device(struct d3dx10_mesh *mesh)
+{
+    UINT i;
+
+    for (i = 0; i < mesh->slot_count; ++i)
+        if (mesh->slots[i].device_buffer)
+        {
+            ID3D10Buffer_Release(mesh->slots[i].device_buffer);
+            mesh->slots[i].device_buffer = NULL;
+        }
+    if (mesh->device_index_buffer)
+    {
+        ID3D10Buffer_Release(mesh->device_index_buffer);
+        mesh->device_index_buffer = NULL;
+    }
+}
+
+static void mesh_free_data(struct d3dx10_mesh *mesh)
+{
+    UINT i;
+
+    mesh_release_device(mesh);
+    for (i = 0; i < mesh->slot_count; ++i)
+        free(mesh->slots[i].data);
+    free(mesh->slots);
+    free(mesh->decl);
+    free(mesh->semantics);
+    free(mesh->position_semantic);
+    free(mesh->indices);
+    free(mesh->gs_indices);
+    free(mesh->attributes);
+    free(mesh->table);
+    free(mesh->adjacency);
+    free(mesh->pointreps);
+}
+
+struct sort_vertex
+{
+    float x;
+    UINT index;
+};
+
+static int sort_vertex_cmp(const void *a, const void *b)
+{
+    const struct sort_vertex *va = a, *vb = b;
+
+    if (va->x != vb->x)
+        return va->x < vb->x ? -1 : 1;
+    return va->index < vb->index ? -1 : va->index > vb->index;
+}
+
+static HRESULT mesh_compute_pointreps(struct d3dx10_mesh *mesh, float epsilon, UINT *reps)
+{
+    struct sort_vertex *sorted;
+    UINT i, j;
+
+    if (!(sorted = calloc(max(mesh->vertex_count, 1), sizeof(*sorted))))
+        return E_OUTOFMEMORY;
+
+    for (i = 0; i < mesh->vertex_count; ++i)
+    {
+        sorted[i].x = mesh_position(mesh, i)[0];
+        sorted[i].index = i;
+        reps[i] = i;
+    }
+    qsort(sorted, mesh->vertex_count, sizeof(*sorted), sort_vertex_cmp);
+
+    for (i = 0; i < mesh->vertex_count; ++i)
+    {
+        const float *a = mesh_position(mesh, sorted[i].index);
+
+        for (j = 0; j < i; ++j)
+        {
+            const float *b;
+
+            if (sorted[i].x - sorted[j].x > epsilon)
+                continue;
+            b = mesh_position(mesh, sorted[j].index);
+            if (fabsf(a[0] - b[0]) <= epsilon && fabsf(a[1] - b[1]) <= epsilon && fabsf(a[2] - b[2]) <= epsilon)
+            {
+                UINT rep = reps[sorted[j].index];
+
+                if (rep < reps[sorted[i].index])
+                    reps[sorted[i].index] = rep;
+            }
+        }
+    }
+    free(sorted);
+    return S_OK;
+}
+
+struct edge
+{
+    UINT lo, hi;
+    UINT face, slot;
+};
+
+static int edge_cmp(const void *a, const void *b)
+{
+    const struct edge *ea = a, *eb = b;
+
+    if (ea->lo != eb->lo) return ea->lo < eb->lo ? -1 : 1;
+    if (ea->hi != eb->hi) return ea->hi < eb->hi ? -1 : 1;
+    if (ea->face != eb->face) return ea->face < eb->face ? -1 : 1;
+    return ea->slot < eb->slot ? -1 : ea->slot > eb->slot;
+}
+
+static HRESULT mesh_compute_adjacency(struct d3dx10_mesh *mesh, const UINT *reps, UINT *adjacency)
+{
+    struct edge *edges;
+    UINT i, n = mesh->face_count * 3;
+
+    if (!(edges = calloc(max(n, 1), sizeof(*edges))))
+        return E_OUTOFMEMORY;
+
+    for (i = 0; i < n; ++i)
+    {
+        UINT f = i / 3, s = i % 3;
+        UINT a = reps[mesh_get_index(mesh, mesh->indices, f * 3 + s)];
+        UINT b = reps[mesh_get_index(mesh, mesh->indices, f * 3 + (s + 1) % 3)];
+
+        edges[i].lo = min(a, b);
+        edges[i].hi = max(a, b);
+        edges[i].face = f;
+        edges[i].slot = s;
+        adjacency[i] = SG_UNUSED_ATTR;
+    }
+    qsort(edges, n, sizeof(*edges), edge_cmp);
+
+    for (i = 0; i + 1 < n; ++i)
+    {
+        if (edges[i].lo != edges[i + 1].lo || edges[i].hi != edges[i + 1].hi || edges[i].lo == edges[i].hi)
+            continue;
+        if (edges[i].face == edges[i + 1].face)
+            continue;
+        if (adjacency[edges[i].face * 3 + edges[i].slot] == SG_UNUSED_ATTR)
+            adjacency[edges[i].face * 3 + edges[i].slot] = edges[i + 1].face;
+        if (adjacency[edges[i + 1].face * 3 + edges[i + 1].slot] == SG_UNUSED_ATTR)
+            adjacency[edges[i + 1].face * 3 + edges[i + 1].slot] = edges[i].face;
+    }
+    free(edges);
+    return S_OK;
+}
+
+static HRESULT mesh_alloc_extra(void **ptr, SIZE_T *size, SIZE_T new_size)
+{
+    if (*ptr)
+        return S_OK;
+    if (!(*ptr = calloc(1, max(new_size, 4))))
+        return E_OUTOFMEMORY;
+    *size = new_size;
+    return S_OK;
+}
+
+/* Builds the six index per face list for geometry shader adjacency. */
+static HRESULT mesh_build_gs_indices(struct d3dx10_mesh *mesh)
+{
+    UINT f, e, i;
+    BYTE *gs;
+
+    if (!mesh->adjacency || !mesh->pointreps)
+        return E_FAIL;
+
+    if (!(gs = calloc(max(mesh->face_count, 1), 6 * mesh_index_size(mesh))))
+        return E_OUTOFMEMORY;
+
+    for (f = 0; f < mesh->face_count; ++f)
+    {
+        UINT v[3];
+
+        for (i = 0; i < 3; ++i)
+            v[i] = mesh_get_index(mesh, mesh->indices, f * 3 + i);
+
+        for (e = 0; e < 3; ++e)
+        {
+            UINT adj_face = mesh->adjacency[f * 3 + e];
+            UINT adj_vertex = v[(e + 2) % 3];
+
+            if (adj_face != SG_UNUSED_ATTR && adj_face < mesh->face_count)
+            {
+                UINT ra = mesh->pointreps[v[e]], rb = mesh->pointreps[v[(e + 1) % 3]];
+
+                for (i = 0; i < 3; ++i)
+                {
+                    UINT nv = mesh_get_index(mesh, mesh->indices, adj_face * 3 + i);
+                    UINT rn = mesh->pointreps[nv];
+
+                    if (rn != ra && rn != rb)
+                    {
+                        adj_vertex = nv;
+                        break;
+                    }
+                }
+            }
+            mesh_set_index(mesh, gs, f * 6 + e * 2, v[e]);
+            mesh_set_index(mesh, gs, f * 6 + e * 2 + 1, adj_vertex);
+        }
+    }
+    free(mesh->gs_indices);
+    mesh->gs_indices = gs;
+    mesh->gs_size_bytes = (SIZE_T)mesh->face_count * 6 * mesh_index_size(mesh);
+    return S_OK;
+}
+
+static BOOL ray_triangle(const float *o, const float *d, const float *p0, const float *p1, const float *p2,
+        float *u, float *v, float *t)
+{
+    float e1[3], e2[3], p[3], s[3], q[3], det, inv;
+    unsigned int i;
+
+    for (i = 0; i < 3; ++i)
+    {
+        e1[i] = p1[i] - p0[i];
+        e2[i] = p2[i] - p0[i];
+    }
+    p[0] = d[1] * e2[2] - d[2] * e2[1];
+    p[1] = d[2] * e2[0] - d[0] * e2[2];
+    p[2] = d[0] * e2[1] - d[1] * e2[0];
+    det = e1[0] * p[0] + e1[1] * p[1] + e1[2] * p[2];
+    if (fabsf(det) < 1e-12f)
+        return FALSE;
+    inv = 1.0f / det;
+    for (i = 0; i < 3; ++i)
+        s[i] = o[i] - p0[i];
+    *u = (s[0] * p[0] + s[1] * p[1] + s[2] * p[2]) * inv;
+    if (*u < 0.0f || *u > 1.0f)
+        return FALSE;
+    q[0] = s[1] * e1[2] - s[2] * e1[1];
+    q[1] = s[2] * e1[0] - s[0] * e1[2];
+    q[2] = s[0] * e1[1] - s[1] * e1[0];
+    *v = (d[0] * q[0] + d[1] * q[1] + d[2] * q[2]) * inv;
+    if (*v < 0.0f || *u + *v > 1.0f)
+        return FALSE;
+    *t = (e2[0] * q[0] + e2[1] * q[1] + e2[2] * q[2]) * inv;
+    return *t >= 0.0f;
+}
+
+struct hit
+{
+    UINT face;
+    float u, v, dist;
+};
+
+static int hit_cmp(const void *a, const void *b)
+{
+    const struct hit *ha = a, *hb = b;
+
+    return ha->dist < hb->dist ? -1 : ha->dist > hb->dist;
+}
+
+static HRESULT mesh_intersect(struct d3dx10_mesh *mesh, BOOL subset, UINT attr_id, const float *pos, const float *dir,
+        UINT *hit_count, UINT *face_index, float *u, float *v, float *dist, ID3D10Blob **all_hits)
+{
+    struct hit *hits = NULL;
+    UINT count = 0, f, capacity = 0;
+    HRESULT hr;
+
+    if (!pos || !dir || !hit_count)
+        return E_FAIL;
+    if (mesh->position_slot == ~0u)
+        return E_FAIL;
+
+    for (f = 0; f < mesh->face_count; ++f)
+    {
+        const float *p[3];
+        float fu, fv, ft;
+        UINT i;
+
+        if (subset && mesh->attributes && mesh->attributes[f] != attr_id)
+            continue;
+        if (subset && !mesh->attributes && attr_id)
+            continue;
+        for (i = 0; i < 3; ++i)
+            p[i] = mesh_position(mesh, mesh_get_index(mesh, mesh->indices, f * 3 + i));
+        if (!ray_triangle(pos, dir, p[0], p[1], p[2], &fu, &fv, &ft))
+            continue;
+        if (count == capacity)
+        {
+            struct hit *nh = realloc(hits, (capacity = max(capacity * 2, 8)) * sizeof(*hits));
+            if (!nh)
+            {
+                free(hits);
+                return E_OUTOFMEMORY;
+            }
+            hits = nh;
+        }
+        hits[count].face = f;
+        hits[count].u = fu;
+        hits[count].v = fv;
+        hits[count].dist = ft;
+        ++count;
+    }
+
+    *hit_count = count;
+    if (count)
+    {
+        qsort(hits, count, sizeof(*hits), hit_cmp);
+        if (face_index) *face_index = hits[0].face;
+        if (u) *u = hits[0].u;
+        if (v) *v = hits[0].v;
+        if (dist) *dist = hits[0].dist;
+    }
+
+    hr = S_OK;
+    if (all_hits)
+    {
+        *all_hits = NULL;
+        if (count && SUCCEEDED(hr = D3DCreateBlob(count * sizeof(*hits), all_hits)))
+            memcpy(ID3D10Blob_GetBufferPointer(*all_hits), hits, count * sizeof(*hits));
+    }
+    free(hits);
+    return hr;
+}
