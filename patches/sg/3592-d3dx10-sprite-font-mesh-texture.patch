+static void sprite_save_state(struct d3dx10_sprite *sprite)
+{
+    struct sprite_saved_state *s = &sprite->state;
+    ID3D10Device *dev = sprite->device;
+
+    ID3D10Device_IAGetInputLayout(dev, &s->layout);
+    ID3D10Device_IAGetPrimitiveTopology(dev, &s->topology);
+    ID3D10Device_IAGetVertexBuffers(dev, 0, 1, &s->vb, &s->vb_stride, &s->vb_offset);
+    ID3D10Device_IAGetIndexBuffer(dev, &s->ib, &s->ib_format, &s->ib_offset);
+    ID3D10Device_VSGetShader(dev, &s->vs);
+    ID3D10Device_PSGetShader(dev, &s->ps);
+    ID3D10Device_PSGetShaderResources(dev, 0, 1, &s->srv);
+    ID3D10Device_PSGetSamplers(dev, 0, 1, &s->sampler);
+    ID3D10Device_OMGetBlendState(dev, &s->blend, s->blend_factor, &s->blend_mask);
+    ID3D10Device_RSGetState(dev, &s->rasterizer);
+    ID3D10Device_OMGetDepthStencilState(dev, &s->depth, &s->stencil_ref);
+    sprite->saved = TRUE;
+}
+
+static void sprite_restore_state(struct d3dx10_sprite *sprite)
+{
+    struct sprite_saved_state *s = &sprite->state;
+    ID3D10Device *dev = sprite->device;
+
+    if (!sprite->saved)
+        return;
+
+    ID3D10Device_IASetInputLayout(dev, s->layout);
+    ID3D10Device_IASetPrimitiveTopology(dev, s->topology);
+    ID3D10Device_IASetVertexBuffers(dev, 0, 1, &s->vb, &s->vb_stride, &s->vb_offset);
+    ID3D10Device_IASetIndexBuffer(dev, s->ib, s->ib_format, s->ib_offset);
+    ID3D10Device_VSSetShader(dev, s->vs);
+    ID3D10Device_PSSetShader(dev, s->ps);
+    ID3D10Device_PSSetShaderResources(dev, 0, 1, &s->srv);
+    ID3D10Device_PSSetSamplers(dev, 0, 1, &s->sampler);
+    ID3D10Device_OMSetBlendState(dev, s->blend, s->blend_factor, s->blend_mask);
+    ID3D10Device_RSSetState(dev, s->rasterizer);
+    ID3D10Device_OMSetDepthStencilState(dev, s->depth, s->stencil_ref);
+
+    SAFE_RELEASE(s->layout);
+    SAFE_RELEASE(s->vb);
+    SAFE_RELEASE(s->ib);
+    SAFE_RELEASE(s->vs);
+    SAFE_RELEASE(s->ps);
+    SAFE_RELEASE(s->srv);
+    SAFE_RELEASE(s->sampler);
+    SAFE_RELEASE(s->blend);
+    SAFE_RELEASE(s->rasterizer);
+    SAFE_RELEASE(s->depth);
+    sprite->saved = FALSE;
+}
+
+static void mat_mul(D3DXMATRIX *out, const D3DXMATRIX *a, const D3DXMATRIX *b)
+{
+    D3DXMATRIX r;
+    unsigned int i, j, k;
+
+    for (i = 0; i < 4; ++i)
+        for (j = 0; j < 4; ++j)
+        {
+            float v = 0.0f;
+            for (k = 0; k < 4; ++k)
+                v += a->m[i][k] * b->m[k][j];
+            r.m[i][j] = v;
+        }
+    *out = r;
+}
+
+static void vec_transform(float out[4], const float in[4], const D3DXMATRIX *m)
+{
+    unsigned int j, k;
+
+    for (j = 0; j < 4; ++j)
+    {
+        float v = 0.0f;
+        for (k = 0; k < 4; ++k)
+            v += in[k] * m->m[k][j];
+        out[j] = v;
+    }
+}
