+/* A memory loader that owns a copy of the data, for work that outlives the caller's buffer. */
+HRESULT create_copy_loader(const void *data, SIZE_T size, ID3DX10DataLoader **loader)
+{
+    struct asyncdataloader *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    if (!(object->data = malloc(max(size, 1))))
+    {
+        free(object);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(object->data, data, size);
+    object->size = size;
+    object->ID3DX10DataLoader_iface.lpVtbl = &copydataloadervtbl;
+    *loader = &object->ID3DX10DataLoader_iface;
+    return S_OK;
+}
