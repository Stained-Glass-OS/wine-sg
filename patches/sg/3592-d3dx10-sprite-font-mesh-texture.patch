+/* Draws sprites[count] (stride bytes apart) now. */
+static HRESULT sprite_draw(struct d3dx10_sprite *sprite, const BYTE *sprites, UINT count, UINT stride, UINT flags)
+{
+    const D3DX10_SPRITE **list;
+    float *depth = NULL;
+    unsigned int i, start, n;
+    HRESULT hr = S_OK;
+
+    if (!count)
+        return S_OK;
+
+    if (!(list = calloc(count, sizeof(*list))))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < count; ++i)
+        list[i] = (const D3DX10_SPRITE *)(sprites + (SIZE_T)i * stride);
+
+    if (flags & (D3DX10_SPRITE_SORT_DEPTH_BACK_TO_FRONT | D3DX10_SPRITE_SORT_DEPTH_FRONT_TO_BACK))
+    {
+        BOOL back = flags & D3DX10_SPRITE_SORT_DEPTH_BACK_TO_FRONT;
+        unsigned int j;
+
+        if ((depth = calloc(count, sizeof(*depth))))
+        {
+            const D3DX10_SPRITE *tmp;
+            float td;
+
+            for (i = 0; i < count; ++i)
+                depth[i] = sprite_depth(list[i], &sprite->view);
+            /* stable insertion sort */
+            for (i = 1; i < count; ++i)
+            {
+                tmp = list[i];
+                td = depth[i];
+                for (j = i; j > 0 && (back ? depth[j - 1] < td : depth[j - 1] > td); --j)
+                {
+                    list[j] = list[j - 1];
+                    depth[j] = depth[j - 1];
+                }
+                list[j] = tmp;
+                depth[j] = td;
+            }
+            free(depth);
+        }
+    }
+    else if (flags & D3DX10_SPRITE_SORT_TEXTURE)
+    {
+        qsort(list, count, sizeof(*list), sprite_cmp_texture);
+    }
+
+    if (FAILED(hr = sprite_init_gfx(sprite)))
+    {
+        free(list);
+        return hr;
+    }
+
+    for (start = 0; start < count; start += n)
+    {
+        /* Skip sprites without a texture. */
+        if (!list[start]->pTexture)
+        {
+            n = 1;
+            continue;
+        }
+        for (n = 1; start + n < count && n < SPRITE_BATCH_MAX && list[start + n]->pTexture == list[start]->pTexture; ++n)
+            ;
+        if (FAILED(hr = sprite_draw_run(sprite, &list[start], n)))
+            break;
+    }
+
+    free(list);
+    return hr;
+}
