+/* ---- pixel access and resampling for the formats the loader can filter ---- */
+
+struct img
+{
+    BYTE *data;
+    unsigned int width, height, depth, pitch, slice_pitch;
+};
+
+static float half_to_float(unsigned short h)
+{
+    unsigned int sign = (h >> 15) & 1, exp = (h >> 10) & 0x1f, mant = h & 0x3ff;
+    float v;
+
+    if (!exp)
+        v = ldexpf((float)mant, -24);
+    else if (exp == 31)
+        v = mant ? NAN : INFINITY;
+    else
+        v = ldexpf((float)(mant | 0x400), (int)exp - 25);
+    return sign ? -v : v;
+}
+
+static unsigned short float_to_half(float f)
+{
+    unsigned int sign = 0, exp, mant;
+    int e;
+    float m;
+
+    if (isnan(f))
+        return 0x7e00;
+    if (f < 0.0f)
+    {
+        sign = 0x8000;
+        f = -f;
+    }
+    if (f >= 65520.0f)
+        return sign | 0x7c00;
+    if (f < 6.103515625e-05f)
+        return sign | (unsigned short)lrintf(f * 16777216.0f);
+    m = frexpf(f, &e);          /* f = m * 2^e, m in [0.5, 1) */
+    exp = e + 14;
+    mant = (unsigned int)lrintf((m * 2.0f - 1.0f) * 1024.0f);
+    if (mant == 1024)
+    {
+        mant = 0;
+        ++exp;
+    }
+    return sign | (exp << 10) | mant;
+}
+
+static BOOL format_filterable(DXGI_FORMAT f)
+{
+    switch (f)
+    {
+        case DXGI_FORMAT_R8G8B8A8_UNORM: case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+        case DXGI_FORMAT_B8G8R8A8_UNORM: case DXGI_FORMAT_B8G8R8X8_UNORM:
+        case DXGI_FORMAT_R8_UNORM: case DXGI_FORMAT_A8_UNORM: case DXGI_FORMAT_R8G8_UNORM:
+        case DXGI_FORMAT_R16_UNORM: case DXGI_FORMAT_R16G16_UNORM: case DXGI_FORMAT_R16G16B16A16_UNORM:
+        case DXGI_FORMAT_R16_FLOAT: case DXGI_FORMAT_R16G16B16A16_FLOAT:
+        case DXGI_FORMAT_R32_FLOAT: case DXGI_FORMAT_R32G32_FLOAT: case DXGI_FORMAT_R32G32B32_FLOAT:
+        case DXGI_FORMAT_R32G32B32A32_FLOAT: case DXGI_FORMAT_R10G10B10A2_UNORM:
+        case DXGI_FORMAT_B5G6R5_UNORM: case DXGI_FORMAT_B5G5R5A1_UNORM:
+            return TRUE;
+        default:
+            return FALSE;
+    }
+}
+
+static void fmt_unpack(DXGI_FORMAT f, const BYTE *p, float *c)
+{
+    const unsigned short *w = (const unsigned short *)p;
+    const float *fl = (const float *)p;
+
+    c[0] = c[1] = c[2] = 0.0f;
+    c[3] = 1.0f;
+    switch (f)
+    {
+        case DXGI_FORMAT_R8G8B8A8_UNORM: case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+            c[0] = p[0] / 255.0f; c[1] = p[1] / 255.0f; c[2] = p[2] / 255.0f; c[3] = p[3] / 255.0f; break;
+        case DXGI_FORMAT_B8G8R8A8_UNORM:
+            c[2] = p[0] / 255.0f; c[1] = p[1] / 255.0f; c[0] = p[2] / 255.0f; c[3] = p[3] / 255.0f; break;
+        case DXGI_FORMAT_B8G8R8X8_UNORM:
+            c[2] = p[0] / 255.0f; c[1] = p[1] / 255.0f; c[0] = p[2] / 255.0f; break;
+        case DXGI_FORMAT_R8_UNORM: c[0] = p[0] / 255.0f; break;
+        case DXGI_FORMAT_A8_UNORM: c[3] = p[0] / 255.0f; break;
+        case DXGI_FORMAT_R8G8_UNORM: c[0] = p[0] / 255.0f; c[1] = p[1] / 255.0f; break;
+        case DXGI_FORMAT_R16_UNORM: c[0] = w[0] / 65535.0f; break;
+        case DXGI_FORMAT_R16G16_UNORM: c[0] = w[0] / 65535.0f; c[1] = w[1] / 65535.0f; break;
+        case DXGI_FORMAT_R16G16B16A16_UNORM:
+            c[0] = w[0] / 65535.0f; c[1] = w[1] / 65535.0f; c[2] = w[2] / 65535.0f; c[3] = w[3] / 65535.0f; break;
+        case DXGI_FORMAT_R16_FLOAT: c[0] = half_to_float(w[0]); break;
+        case DXGI_FORMAT_R16G16B16A16_FLOAT:
+            c[0] = half_to_float(w[0]); c[1] = half_to_float(w[1]); c[2] = half_to_float(w[2]); c[3] = half_to_float(w[3]);
+            break;
+        case DXGI_FORMAT_R32_FLOAT: c[0] = fl[0]; break;
+        case DXGI_FORMAT_R32G32_FLOAT: c[0] = fl[0]; c[1] = fl[1]; break;
+        case DXGI_FORMAT_R32G32B32_FLOAT: c[0] = fl[0]; c[1] = fl[1]; c[2] = fl[2]; break;
+        case DXGI_FORMAT_R32G32B32A32_FLOAT: c[0] = fl[0]; c[1] = fl[1]; c[2] = fl[2]; c[3] = fl[3]; break;
+        case DXGI_FORMAT_R10G10B10A2_UNORM:
+        {
+            unsigned int v = *(const unsigned int *)p;
+            c[0] = (v & 0x3ff) / 1023.0f; c[1] = ((v >> 10) & 0x3ff) / 1023.0f;
+            c[2] = ((v >> 20) & 0x3ff) / 1023.0f; c[3] = (v >> 30) / 3.0f;
+            break;
+        }
+        case DXGI_FORMAT_B5G6R5_UNORM:
+            c[0] = ((w[0] >> 11) & 0x1f) / 31.0f; c[1] = ((w[0] >> 5) & 0x3f) / 63.0f; c[2] = (w[0] & 0x1f) / 31.0f; break;
+        case DXGI_FORMAT_B5G5R5A1_UNORM:
+            c[0] = ((w[0] >> 10) & 0x1f) / 31.0f; c[1] = ((w[0] >> 5) & 0x1f) / 31.0f; c[2] = (w[0] & 0x1f) / 31.0f;
+            c[3] = (w[0] >> 15) ? 1.0f : 0.0f; break;
+        default: break;
+    }
+}
+
+static BYTE to_unorm8(float v) { return (BYTE)lrintf(max(0.0f, min(1.0f, v)) * 255.0f); }
+static unsigned short to_unorm16(float v) { return (unsigned short)lrintf(max(0.0f, min(1.0f, v)) * 65535.0f); }
+
+static void fmt_pack(DXGI_FORMAT f, const float *c, BYTE *p)
+{
+    unsigned short *w = (unsigned short *)p;
+    float *fl = (float *)p;
+
+    switch (f)
+    {
+        case DXGI_FORMAT_R8G8B8A8_UNORM: case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+            p[0] = to_unorm8(c[0]); p[1] = to_unorm8(c[1]); p[2] = to_unorm8(c[2]); p[3] = to_unorm8(c[3]); break;
+        case DXGI_FORMAT_B8G8R8A8_UNORM:
+            p[0] = to_unorm8(c[2]); p[1] = to_unorm8(c[1]); p[2] = to_unorm8(c[0]); p[3] = to_unorm8(c[3]); break;
+        case DXGI_FORMAT_B8G8R8X8_UNORM:
+            p[0] = to_unorm8(c[2]); p[1] = to_unorm8(c[1]); p[2] = to_unorm8(c[0]); p[3] = 0xff; break;
+        case DXGI_FORMAT_R8_UNORM: p[0] = to_unorm8(c[0]); break;
+        case DXGI_FORMAT_A8_UNORM: p[0] = to_unorm8(c[3]); break;
+        case DXGI_FORMAT_R8G8_UNORM: p[0] = to_unorm8(c[0]); p[1] = to_unorm8(c[1]); break;
+        case DXGI_FORMAT_R16_UNORM: w[0] = to_unorm16(c[0]); break;
+        case DXGI_FORMAT_R16G16_UNORM: w[0] = to_unorm16(c[0]); w[1] = to_unorm16(c[1]); break;
+        case DXGI_FORMAT_R16G16B16A16_UNORM:
+            w[0] = to_unorm16(c[0]); w[1] = to_unorm16(c[1]); w[2] = to_unorm16(c[2]); w[3] = to_unorm16(c[3]); break;
+        case DXGI_FORMAT_R16_FLOAT: w[0] = float_to_half(c[0]); break;
+        case DXGI_FORMAT_R16G16B16A16_FLOAT:
+            w[0] = float_to_half(c[0]); w[1] = float_to_half(c[1]); w[2] = float_to_half(c[2]); w[3] = float_to_half(c[3]);
+            break;
+        case DXGI_FORMAT_R32_FLOAT: fl[0] = c[0]; break;
+        case DXGI_FORMAT_R32G32_FLOAT: fl[0] = c[0]; fl[1] = c[1]; break;
+        case DXGI_FORMAT_R32G32B32_FLOAT: fl[0] = c[0]; fl[1] = c[1]; fl[2] = c[2]; break;
+        case DXGI_FORMAT_R32G32B32A32_FLOAT: fl[0] = c[0]; fl[1] = c[1]; fl[2] = c[2]; fl[3] = c[3]; break;
+        case DXGI_FORMAT_R10G10B10A2_UNORM:
+            *(unsigned int *)p = (unsigned int)lrintf(max(0.0f, min(1.0f, c[0])) * 1023.0f)
+                    | ((unsigned int)lrintf(max(0.0f, min(1.0f, c[1])) * 1023.0f) << 10)
+                    | ((unsigned int)lrintf(max(0.0f, min(1.0f, c[2])) * 1023.0f) << 20)
+                    | ((unsigned int)lrintf(max(0.0f, min(1.0f, c[3])) * 3.0f) << 30);
+            break;
+        case DXGI_FORMAT_B5G6R5_UNORM:
+            w[0] = ((unsigned)lrintf(max(0.0f, min(1.0f, c[0])) * 31.0f) << 11)
+                    | ((unsigned)lrintf(max(0.0f, min(1.0f, c[1])) * 63.0f) << 5)
+                    | (unsigned)lrintf(max(0.0f, min(1.0f, c[2])) * 31.0f);
+            break;
+        case DXGI_FORMAT_B5G5R5A1_UNORM:
+            w[0] = ((unsigned)lrintf(max(0.0f, min(1.0f, c[0])) * 31.0f) << 10)
+                    | ((unsigned)lrintf(max(0.0f, min(1.0f, c[1])) * 31.0f) << 5)
+                    | (unsigned)lrintf(max(0.0f, min(1.0f, c[2])) * 31.0f) | (c[3] >= 0.5f ? 0x8000 : 0);
+            break;
+        default: break;
+    }
+}
+
+static void img_pixel(DXGI_FORMAT f, const struct img *img, int x, int y, int z, float *c)
+{
+    unsigned int bpp = get_bpp_from_format(f) / 8;
+
+    x = max(0, min(x, (int)img->width - 1));
+    y = max(0, min(y, (int)img->height - 1));
+    z = max(0, min(z, (int)img->depth - 1));
+    fmt_unpack(f, img->data + (SIZE_T)z * img->slice_pitch + (SIZE_T)y * img->pitch + (SIZE_T)x * bpp, c);
+}
+
+/* Resamples one slice: area average when shrinking, bilinear when stretching, nearest with D3DX10_FILTER_POINT. */
+static HRESULT img_resample(DXGI_FORMAT src_fmt, const struct img *src, unsigned int src_z, DXGI_FORMAT dst_fmt,
+        struct img *dst, unsigned int dst_z, unsigned int filter)
+{
+    unsigned int dst_bpp = get_bpp_from_format(dst_fmt) / 8;
+    BOOL point = (filter != D3DX10_DEFAULT) && ((filter & 7) == D3DX10_FILTER_POINT || (filter & 7) == D3DX10_FILTER_NONE);
+    unsigned int x, y;
+
+    for (y = 0; y < dst->height; ++y)
+    {
+        double sy0 = (double)y * src->height / dst->height, sy1 = (double)(y + 1) * src->height / dst->height;
+
+        for (x = 0; x < dst->width; ++x)
+        {
+            double sx0 = (double)x * src->width / dst->width, sx1 = (double)(x + 1) * src->width / dst->width;
+            float acc[4] = {0}, c[4];
+            BYTE *out = dst->data + (SIZE_T)dst_z * dst->slice_pitch + (SIZE_T)y * dst->pitch + (SIZE_T)x * dst_bpp;
+            unsigned int i;
+
+            if (point || (src->width == dst->width && src->height == dst->height))
+            {
+                img_pixel(src_fmt, src, (int)((sx0 + sx1) * 0.5), (int)((sy0 + sy1) * 0.5), src_z, c);
