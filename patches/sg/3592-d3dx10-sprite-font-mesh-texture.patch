+HRESULT WINAPI D3DX10FilterTexture(ID3D10Resource *resource, UINT src_level, UINT filter)
+{
+    D3D10_TEXTURE2D_DESC desc;
+    ID3D10Texture2D *texture;
+    ID3D10Device *device;
+    unsigned int a, level;
+    BOOL bc;
+    HRESULT hr;
+
+    TRACE("resource %p, src_level %u, filter %#x.\n", resource, src_level, filter);
+
+    if (FAILED(hr = get_texture2d(resource, &texture)))
+    {
+        FIXME("Only 2D textures can be filtered.\n");
+        return hr == E_INVALIDARG ? hr : E_NOTIMPL;
+    }
+    ID3D10Texture2D_GetDesc(texture, &desc);
+    bc = is_bc123_format(desc.Format);
+    if (src_level >= desc.MipLevels)
+    {
+        ID3D10Texture2D_Release(texture);
+        return E_INVALIDARG;
+    }
+    if (!bc && !format_filterable(desc.Format))
+    {
+        FIXME("Format %#x cannot be filtered.\n", desc.Format);
+        ID3D10Texture2D_Release(texture);
+        return E_NOTIMPL;
+    }
+    ID3D10Resource_GetDevice(resource, &device);
+
+    for (a = 0; a < desc.ArraySize && SUCCEEDED(hr); ++a)
+    {
+        unsigned int w = level_dim(desc.Width, src_level), h = level_dim(desc.Height, src_level);
+        DXGI_FORMAT work_format = bc ? DXGI_FORMAT_R8G8B8A8_UNORM : desc.Format;
+        struct img raw, prev, cur;
+
+        if (FAILED(hr = read_region(device, resource, a * desc.MipLevels + src_level, NULL, desc.Format, w, h, &raw)))
+            break;
+        if (bc)
+        {
+            hr = bc_decode_level(desc.Format, &raw, &prev);
+            free(raw.data);
+            if (FAILED(hr))
+                break;
+        }
+        else
+        {
+            prev = raw;
+        }
+
+        for (level = src_level + 1; level < desc.MipLevels; ++level)
+        {
+            unsigned int bpp = get_bpp_from_format(work_format) / 8;
+
+            w = level_dim(desc.Width, level);
+            h = level_dim(desc.Height, level);
+            memset(&cur, 0, sizeof(cur));
+            cur.width = w;
+            cur.height = h;
+            cur.depth = 1;
+            cur.pitch = w * bpp;
+            cur.slice_pitch = cur.pitch * h;
+            if (!(cur.data = malloc(cur.slice_pitch)))
+            {
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+            img_resample(work_format, &prev, 0, work_format, &cur, 0, filter);
+            if (bc)
+            {
+                struct img packed;
+
+                if (FAILED(hr = compress_level(&cur, desc.Format, &packed)))
+                {
+                    free(cur.data);
+                    break;
+                }
+                ID3D10Device_UpdateSubresource(device, resource, a * desc.MipLevels + level, NULL,
+                        packed.data, packed.pitch, packed.slice_pitch);
+                free(packed.data);
+            }
+            else
+            {
+                ID3D10Device_UpdateSubresource(device, resource, a * desc.MipLevels + level, NULL,
+                        cur.data, cur.pitch, cur.slice_pitch);
+            }
+            free(prev.data);
+            prev = cur;
+        }
+        free(prev.data);
+    }
+
+    ID3D10Device_Release(device);
+    ID3D10Texture2D_Release(texture);
+    return hr;
+}
+
+HRESULT WINAPI D3DX10LoadTextureFromTexture(ID3D10Resource *src_resource, D3DX10_TEXTURE_LOAD_INFO *info,
+        ID3D10Resource *dst_resource)
+{
+    D3DX10_TEXTURE_LOAD_INFO defaults = {NULL, NULL, 0, 0, D3DX10_DEFAULT, 0, 0, D3DX10_DEFAULT, D3DX10_DEFAULT, D3DX10_DEFAULT};
+    D3D10_TEXTURE2D_DESC sdesc, ddesc;
+    ID3D10Texture2D *src, *dst;
+    ID3D10Device *device;
+    unsigned int mips, elements, e, m;
+    HRESULT hr;
+
+    TRACE("src_resource %p, info %p, dst_resource %p.\n", src_resource, info, dst_resource);
+
+    if (!src_resource || !dst_resource)
+        return E_INVALIDARG;
+    if (!info)
+        info = &defaults;
+
+    if (FAILED(get_texture2d(src_resource, &src)))
+    {
+        FIXME("Only 2D textures are supported.\n");
+        return E_NOTIMPL;
+    }
+    if (FAILED(get_texture2d(dst_resource, &dst)))
+    {
+        ID3D10Texture2D_Release(src);
+        FIXME("Only 2D textures are supported.\n");
+        return E_NOTIMPL;
+    }
+    ID3D10Texture2D_GetDesc(src, &sdesc);
+    ID3D10Texture2D_GetDesc(dst, &ddesc);
+    ID3D10Resource_GetDevice(dst_resource, &device);
+
+    if (info->SrcFirstMip >= sdesc.MipLevels || info->DstFirstMip >= ddesc.MipLevels
+            || info->SrcFirstElement >= sdesc.ArraySize || info->DstFirstElement >= ddesc.ArraySize)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    mips = min(sdesc.MipLevels - info->SrcFirstMip, ddesc.MipLevels - info->DstFirstMip);
+    if (info->NumMips != D3DX10_DEFAULT)
+        mips = min(mips, info->NumMips);
+    elements = min(sdesc.ArraySize - info->SrcFirstElement, ddesc.ArraySize - info->DstFirstElement);
+    if (info->NumElements != D3DX10_DEFAULT)
+        elements = min(elements, info->NumElements);
+
+    hr = S_OK;
+    for (e = 0; e < elements && SUCCEEDED(hr); ++e)
+    {
+        for (m = 0; m < mips && SUCCEEDED(hr); ++m)
+        {
+            unsigned int sl = info->SrcFirstMip + m, dl = info->DstFirstMip + m;
+            unsigned int ssub = (info->SrcFirstElement + e) * sdesc.MipLevels + sl;
+            unsigned int dsub = (info->DstFirstElement + e) * ddesc.MipLevels + dl;
+            unsigned int sw = level_dim(sdesc.Width, sl), sh = level_dim(sdesc.Height, sl);
+            unsigned int dw = level_dim(ddesc.Width, dl), dh = level_dim(ddesc.Height, dl);
+            D3D10_BOX sbox = {0, 0, 0, sw, sh, 1}, dbox = {0, 0, 0, dw, dh, 1};
+
+            if (info->pSrcBox)
+            {
+                sbox.left = info->pSrcBox->left >> m;
+                sbox.top = info->pSrcBox->top >> m;
+                sbox.right = max(info->pSrcBox->right >> m, sbox.left + 1);
+                sbox.bottom = max(info->pSrcBox->bottom >> m, sbox.top + 1);
+            }
+            if (info->pDstBox)
+            {
+                dbox.left = info->pDstBox->left >> m;
+                dbox.top = info->pDstBox->top >> m;
+                dbox.right = max(info->pDstBox->right >> m, dbox.left + 1);
+                dbox.bottom = max(info->pDstBox->bottom >> m, dbox.top + 1);
+            }
+
+            if (sdesc.Format == ddesc.Format && sbox.right - sbox.left == dbox.right - dbox.left
+                    && sbox.bottom - sbox.top == dbox.bottom - dbox.top)
+            {
+                ID3D10Device_CopySubresourceRegion(device, dst_resource, dsub, dbox.left, dbox.top, 0,
+                        src_resource, ssub, &sbox);
+            }
+            else if (format_filterable(sdesc.Format) && format_filterable(ddesc.Format))
+            {
+                struct img in, out;
+                unsigned int bpp = get_bpp_from_format(ddesc.Format) / 8;
+
+                if (FAILED(hr = read_region(device, src_resource, ssub, &sbox, sdesc.Format,
+                        sbox.right - sbox.left, sbox.bottom - sbox.top, &in)))
+                    break;
+                memset(&out, 0, sizeof(out));
+                out.width = dbox.right - dbox.left;
+                out.height = dbox.bottom - dbox.top;
+                out.depth = 1;
+                out.pitch = out.width * bpp;
+                out.slice_pitch = out.pitch * out.height;
+                if (!(out.data = malloc(out.slice_pitch)))
+                {
+                    free(in.data);
+                    hr = E_OUTOFMEMORY;
+                    break;
+                }
+                img_resample(sdesc.Format, &in, 0, ddesc.Format, &out, 0, info->Filter);
+                ID3D10Device_UpdateSubresource(device, dst_resource, dsub, &dbox, out.data, out.pitch, out.slice_pitch);
+                free(in.data);
+                free(out.data);
+            }
+            else
+            {
+                FIXME("Cannot convert %#x to %#x.\n", sdesc.Format, ddesc.Format);
+                hr = E_NOTIMPL;
+            }
+        }
+    }
+
+done:
+    ID3D10Device_Release(device);
+    ID3D10Texture2D_Release(dst);
+    ID3D10Texture2D_Release(src);
+    return hr;
+}
+
+/* ---- saving ---- */
+
+#define DDS_MAGIC 0x20534444
+
+static HRESULT save_dds(ID3D10Device *device, ID3D10Resource *resource, const D3D10_TEXTURE2D_DESC *desc,
+        ID3D10Blob **blob)
+{
+    unsigned int a, m, count = 0, i;
+    struct img *subs;
+    SIZE_T total = 4 + 124 + 20, offset;
+    BOOL bc = is_block_compressed_format(desc->Format);
+    UINT header[31 + 5] = {0};
+    BYTE *out;
+    HRESULT hr = S_OK;
+
+    if (!(subs = calloc((SIZE_T)desc->ArraySize * desc->MipLevels, sizeof(*subs))))
+        return E_OUTOFMEMORY;
+
+    for (a = 0; a < desc->ArraySize && SUCCEEDED(hr); ++a)
+        for (m = 0; m < desc->MipLevels && SUCCEEDED(hr); ++m)
+        {
+            hr = read_region(device, resource, a * desc->MipLevels + m, NULL, desc->Format,
+                    level_dim(desc->Width, m), level_dim(desc->Height, m), &subs[count]);
+            if (SUCCEEDED(hr))
+                total += subs[count].slice_pitch;
+            ++count;
+        }
+
+    if (SUCCEEDED(hr))
+        hr = D3DCreateBlob(total, blob);
+    if (SUCCEEDED(hr))
+    {
+        out = ID3D10Blob_GetBufferPointer(*blob);
+        *(UINT *)out = DDS_MAGIC;
+        header[0] = 124;
+        header[1] = 0x1 | 0x2 | 0x4 | 0x1000 | (desc->MipLevels > 1 ? 0x20000 : 0) | (bc ? 0x80000 : 0x8);
+        header[2] = desc->Height;
+        header[3] = desc->Width;
+        header[4] = subs[0].pitch;
+        if (bc)
+            header[4] = subs[0].slice_pitch;
+        header[6] = desc->MipLevels;
+        header[18] = 32;                    /* DDS_PIXELFORMAT size */
+        header[19] = 0x4;                   /* DDPF_FOURCC */
+        header[20] = 0x30315844;
+        header[26] = 0x1000 | (desc->MipLevels > 1 ? 0x400008 : 0);
+        if (desc->MiscFlags & D3D10_RESOURCE_MISC_TEXTURECUBE)
+            header[27] = 0xfe00;            /* DDSCAPS2_CUBEMAP | all faces */
+        memcpy(out + 4, header, 124);
+        {
+            UINT dx10[5] = {desc->Format, 3 /* TEXTURE2D */,
+                    (desc->MiscFlags & D3D10_RESOURCE_MISC_TEXTURECUBE) ? 4 : 0,
+                    (desc->MiscFlags & D3D10_RESOURCE_MISC_TEXTURECUBE) ? desc->ArraySize / 6 : desc->ArraySize, 0};
+            memcpy(out + 128, dx10, sizeof(dx10));
+        }
+        offset = 148;
+        for (i = 0; i < count; ++i)
+        {
+            memcpy(out + offset, subs[i].data, subs[i].slice_pitch);
+            offset += subs[i].slice_pitch;
+        }
+    }
+    free_levels(subs, desc->ArraySize * desc->MipLevels);
+    return hr;
+}
+
+static const GUID *file_format_to_container(D3DX10_IMAGE_FILE_FORMAT format)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(file_formats); ++i)
+        if (file_formats[i].d3dx_file_format == format)
+            return file_formats[i].wic_container_guid;
+    return NULL;
+}
+
+static HRESULT save_wic(const GUID *container, const struct img *rgba, ID3D10Blob **blob)
+{
+    IWICImagingFactory *factory = NULL;
+    IWICBitmapEncoder *encoder = NULL;
+    IWICBitmapFrameEncode *frame = NULL;
+    IPropertyBag2 *props = NULL;
+    IWICBitmap *bitmap = NULL;
+    IWICBitmapSource *source;
+    IWICFormatConverter *converter = NULL;
+    IStream *stream = NULL;
+    GUID format = GUID_WICPixelFormat32bppBGRA;
+    HGLOBAL global;
+    STATSTG stat;
+    void *mem;
+    BYTE *bgra = NULL;
+    unsigned int x, y;
+    HRESULT hr;
+
+    if (FAILED(hr = WICCreateImagingFactory_Proxy(WINCODEC_SDK_VERSION, &factory)))
+        return hr;
+    if (!(bgra = malloc((SIZE_T)rgba->width * rgba->height * 4)))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    for (y = 0; y < rgba->height; ++y)
+        for (x = 0; x < rgba->width; ++x)
+        {
+            const BYTE *s = rgba->data + (SIZE_T)y * rgba->pitch + x * 4;
+            BYTE *d = bgra + ((SIZE_T)y * rgba->width + x) * 4;
+
+            d[0] = s[2]; d[1] = s[1]; d[2] = s[0]; d[3] = s[3];
+        }
+
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream)))
+        goto done;
+    if (FAILED(hr = IWICImagingFactory_CreateEncoder(factory, container, NULL, &encoder)))
+        goto done;
+    if (FAILED(hr = IWICBitmapEncoder_Initialize(encoder, stream, WICBitmapEncoderNoCache)))
+        goto done;
+    if (FAILED(hr = IWICBitmapEncoder_CreateNewFrame(encoder, &frame, &props)))
+        goto done;
+    if (FAILED(hr = IWICBitmapFrameEncode_Initialize(frame, props)))
+        goto done;
+    if (FAILED(hr = IWICBitmapFrameEncode_SetSize(frame, rgba->width, rgba->height)))
+        goto done;
+    if (FAILED(hr = IWICBitmapFrameEncode_SetPixelFormat(frame, &format)))
+        goto done;
+    if (FAILED(hr = IWICImagingFactory_CreateBitmapFromMemory(factory, rgba->width, rgba->height,
+            &GUID_WICPixelFormat32bppBGRA, rgba->width * 4, rgba->width * rgba->height * 4, bgra, &bitmap)))
+        goto done;
+    source = (IWICBitmapSource *)bitmap;
+    if (!IsEqualGUID(&format, &GUID_WICPixelFormat32bppBGRA))
+    {
+        if (FAILED(hr = IWICImagingFactory_CreateFormatConverter(factory, &converter)))
+            goto done;
+        if (FAILED(hr = IWICFormatConverter_Initialize(converter, source, &format, WICBitmapDitherTypeNone, NULL, 0.0,
+                WICBitmapPaletteTypeCustom)))
+            goto done;
+        source = (IWICBitmapSource *)converter;
+    }
+    if (FAILED(hr = IWICBitmapFrameEncode_WriteSource(frame, source, NULL)))
+        goto done;
+    if (FAILED(hr = IWICBitmapFrameEncode_Commit(frame)))
+        goto done;
+    if (FAILED(hr = IWICBitmapEncoder_Commit(encoder)))
+        goto done;
+
+    if (FAILED(hr = IStream_Stat(stream, &stat, STATFLAG_NONAME)))
+        goto done;
+    if (FAILED(hr = GetHGlobalFromStream(stream, &global)))
+        goto done;
+    if (FAILED(hr = D3DCreateBlob(stat.cbSize.LowPart, blob)))
+        goto done;
+    mem = GlobalLock(global);
+    memcpy(ID3D10Blob_GetBufferPointer(*blob), mem, stat.cbSize.LowPart);
+    GlobalUnlock(global);
+
+done:
+    if (converter) IWICFormatConverter_Release(converter);
+    if (bitmap) IWICBitmap_Release(bitmap);
+    if (props) IPropertyBag2_Release(props);
+    if (frame) IWICBitmapFrameEncode_Release(frame);
+    if (encoder) IWICBitmapEncoder_Release(encoder);
+    if (stream) IStream_Release(stream);
+    IWICImagingFactory_Release(factory);
+    free(bgra);
+    return hr;
+}
+
+HRESULT WINAPI D3DX10SaveTextureToMemory(ID3D10Resource *resource, D3DX10_IMAGE_FILE_FORMAT format,
+        ID3D10Blob **buffer, UINT flags)
+{
+    D3D10_TEXTURE2D_DESC desc;
+    ID3D10Texture2D *texture;
+    ID3D10Device *device;
+    const GUID *container;
+    struct img level, rgba;
+    HRESULT hr;
+
+    TRACE("resource %p, format %u, buffer %p, flags %#x.\n", resource, format, buffer, flags);
+
+    if (!buffer)
+        return E_INVALIDARG;
+    if (FAILED(hr = get_texture2d(resource, &texture)))
+    {
+        FIXME("Only 2D textures can be saved.\n");
+        return hr == E_INVALIDARG ? hr : E_NOTIMPL;
+    }
+    ID3D10Texture2D_GetDesc(texture, &desc);
+    ID3D10Resource_GetDevice(resource, &device);
+    *buffer = NULL;
+
+    if (format == D3DX10_IFF_DDS)
+    {
+        hr = save_dds(device, resource, &desc, buffer);
+    }
+    else if (!(container = file_format_to_container(format)))
+    {
+        hr = E_INVALIDARG;
+    }
+    else if (!is_bc123_format(desc.Format) && !format_filterable(desc.Format))
+    {
+        FIXME("Cannot save format %#x as an image file.\n", desc.Format);
+        hr = E_NOTIMPL;
+    }
+    else if (SUCCEEDED(hr = read_region(device, resource, 0, NULL, desc.Format, desc.Width, desc.Height, &level)))
+    {
+        if (is_bc123_format(desc.Format))
+        {
+            hr = bc_decode_level(desc.Format, &level, &rgba);
+            free(level.data);
+        }
+        else
+        {
+            unsigned int x, y;
+
+            memset(&rgba, 0, sizeof(rgba));
+            rgba.width = level.width;
+            rgba.height = level.height;
+            rgba.depth = 1;
+            rgba.pitch = level.width * 4;
+            rgba.slice_pitch = rgba.pitch * level.height;
+            if (!(rgba.data = malloc(rgba.slice_pitch)))
+                hr = E_OUTOFMEMORY;
+            else
+                for (y = 0; y < level.height; ++y)
+                    for (x = 0; x < level.width; ++x)
+                    {
+                        float c[4];
+
+                        fmt_unpack(desc.Format, level.data + (SIZE_T)y * level.pitch
+                                + x * (get_bpp_from_format(desc.Format) / 8), c);
+                        fmt_pack(DXGI_FORMAT_R8G8B8A8_UNORM, c, rgba.data + (SIZE_T)y * rgba.pitch + x * 4);
+                    }
+            free(level.data);
+        }
+        if (SUCCEEDED(hr))
+        {
+            hr = save_wic(container, &rgba, buffer);
+            free(rgba.data);
+        }
+    }
+
+    ID3D10Device_Release(device);
+    ID3D10Texture2D_Release(texture);
+    return hr;
+}
+
+HRESULT WINAPI D3DX10SaveTextureToFileW(ID3D10Resource *resource, D3DX10_IMAGE_FILE_FORMAT format, const WCHAR *filename)
+{
+    ID3D10Blob *blob;
+    HANDLE file;
+    DWORD written;
+    HRESULT hr;
+
+    TRACE("resource %p, format %u, filename %s.\n", resource, format, debugstr_w(filename));
+
+    if (!filename)
+        return E_INVALIDARG;
+    if (FAILED(hr = D3DX10SaveTextureToMemory(resource, format, &blob, 0)))
+        return hr;
+
+    file = CreateFileW(filename, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    else
+    {
+        if (!WriteFile(file, ID3D10Blob_GetBufferPointer(blob), ID3D10Blob_GetBufferSize(blob), &written, NULL))
+            hr = HRESULT_FROM_WIN32(GetLastError());
+        CloseHandle(file);
+    }
+    ID3D10Blob_Release(blob);
+    return hr;
+}
+
+HRESULT WINAPI D3DX10SaveTextureToFileA(ID3D10Resource *resource, D3DX10_IMAGE_FILE_FORMAT format, const char *filename)
+{
+    WCHAR *wide;
+    HRESULT hr;
+    int len;
+
+    TRACE("resource %p, format %u, filename %s.\n", resource, format, debugstr_a(filename));
+
+    if (!filename)
+        return E_INVALIDARG;
+    len = MultiByteToWideChar(CP_ACP, 0, filename, -1, NULL, 0);
+    if (!(wide = malloc(len * sizeof(*wide))))
+        return E_OUTOFMEMORY;
+    MultiByteToWideChar(CP_ACP, 0, filename, -1, wide, len);
+    hr = D3DX10SaveTextureToFileW(resource, format, wide);
+    free(wide);
+    return hr;
+}
