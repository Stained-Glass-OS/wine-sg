+/* Compiles or preprocesses; for the effect kinds it produces the effect byte code (compiling the source when the
+ * data is not byte code already). */
+static HRESULT job_process(const struct job_params *p, const void *data, SIZE_T size,
+        ID3D10Blob **result, ID3D10Blob **errors)
+{
+    ID3D10Include *include = p->include;
+    HRESULT hr;
+
+    *result = NULL;
     if (errors)
