From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: CryptVerifyCertificateSignatureEx on OCSP responses, strong properties

crypt32: CryptVerifyCertificateSignatureEx on OCSP responses, strong properties

The OCSP basic signed response subject type verifies the response's
ToBeSigned against its SignatureInfo, and the RETURN_STRONG_PROPERTIES flag
returns the signature/hash algorithm pair and the issuer key's length in bits.
---
--- a/dlls/crypt32/cert.c
+++ b/dlls/crypt32/cert.c
@@ -3385,12 +3385,61 @@ static BOOL CRYPT_VerifyCertSignatureHash(const CERT_SIGNED_CONTENT_INFO *signed
 
 #define CRYPT_VERIFY_CERT_SIGN_DISABLE_MD2_MD4_FLAG_ 0x00000001
 
+#define CRYPT_VERIFY_CERT_SIGN_SUBJECT_OCSP_BASIC_SIGNED_RESPONSE_ 4
+#define CRYPT_VERIFY_CERT_SIGN_RETURN_STRONG_PROPERTIES_FLAG_ 0x00000004
+
+typedef struct
+{
+    CRYPT_DATA_BLOB CertSignHashCNGAlgPropData;
+    CRYPT_DATA_BLOB CertIssuerPubKeyBitLengthPropData;
+} CRYPT_VERIFY_CERT_SIGN_STRONG_PROPERTIES_INFO_;
+
+/* "RSA/SHA256" style name and the issuer key's length in bits, in one allocation for CryptMemFree.
+ * NULL if there is no memory: the call still succeeds. */
+static CRYPT_VERIFY_CERT_SIGN_STRONG_PROPERTIES_INFO_ *CRYPT_StrongSignatureProperties(
+        const CERT_SIGNED_CONTENT_INFO *signed_content, const CERT_PUBLIC_KEY_INFO *issuer_key)
+{
+    CRYPT_VERIFY_CERT_SIGN_STRONG_PROPERTIES_INFO_ *info;
+    const CRYPT_OID_INFO *oid_info;
+    const WCHAR *hash_name = L"", *key_name = L"";
+    DWORD bits = 0, len;
+    WCHAR *name;
+
+    oid_info = CryptFindOIDInfo(CRYPT_OID_INFO_OID_KEY, signed_content->SignatureAlgorithm.pszObjId,
+            CRYPT_SIGN_ALG_OID_GROUP_ID);
+    if (oid_info)
+    {
+        if (oid_info->pwszCNGAlgid) hash_name = oid_info->pwszCNGAlgid;
+        if (oid_info->pwszCNGExtraAlgid) key_name = oid_info->pwszCNGExtraAlgid;
+    }
+    if (issuer_key) bits = CertGetPublicKeyLength(X509_ASN_ENCODING, (CERT_PUBLIC_KEY_INFO *)issuer_key);
+
+    len = lstrlenW(key_name) + 1 + lstrlenW(hash_name) + 1;
+    if (!(info = CryptMemAlloc(sizeof(*info) + len * sizeof(WCHAR) + sizeof(DWORD)))) return NULL;
+    name = (WCHAR *)(info + 1);
+#ifndef SG_MUTANT_STRONG_NAME
+    lstrcpyW(name, key_name);
+    lstrcatW(name, L"/");
+    lstrcatW(name, hash_name);
+#else
+    lstrcpyW(name, hash_name);
+#endif
+    info->CertSignHashCNGAlgPropData.pbData = (BYTE *)name;
+    info->CertSignHashCNGAlgPropData.cbData = (lstrlenW(name) + 1) * sizeof(WCHAR);
+    info->CertIssuerPubKeyBitLengthPropData.pbData = (BYTE *)(name + len);
+    info->CertIssuerPubKeyBitLengthPropData.cbData = sizeof(DWORD);
+    *(DWORD *)info->CertIssuerPubKeyBitLengthPropData.pbData = bits;
+    return info;
+}
+
 BOOL WINAPI CryptVerifyCertificateSignatureEx(HCRYPTPROV_LEGACY hCryptProv,
  DWORD dwCertEncodingType, DWORD dwSubjectType, void *pvSubject,
  DWORD dwIssuerType, void *pvIssuer, DWORD dwFlags, void *pvReserved)
 {
     BOOL ret = TRUE;
     CRYPT_DATA_BLOB subjectBlob;
+    CERT_SIGNED_CONTENT_INFO ocspSigned;
+    CERT_PUBLIC_KEY_INFO *issuerKey = NULL;
 
     TRACE("(%08Ix, %ld, %ld, %p, %ld, %p, %08lx, %p)\n", hCryptProv,
      dwCertEncodingType, dwSubjectType, pvSubject, dwIssuerType, pvIssuer,
@@ -3422,6 +3471,18 @@ BOOL WINAPI CryptVerifyCertificateSignatureEx(HCRYPTPROV_LEGACY hCryptProv,
         subjectBlob.cbData = context->cbCrlEncoded;
         break;
     }
+    case CRYPT_VERIFY_CERT_SIGN_SUBJECT_OCSP_BASIC_SIGNED_RESPONSE_:
+    {
+        OCSP_BASIC_SIGNED_RESPONSE_INFO *response = pvSubject;
+
+        /* the signed part and the signature are already apart */
+        subjectBlob.pbData = NULL;
+        subjectBlob.cbData = 0;
+        ocspSigned.ToBeSigned = response->ToBeSigned;
+        ocspSigned.SignatureAlgorithm = response->SignatureInfo.SignatureAlgorithm;
+        ocspSigned.Signature = response->SignatureInfo.Signature;
+        break;
+    }
     default:
         SetLastError(E_INVALIDARG);
         ret = FALSE;
@@ -3432,20 +3493,25 @@ BOOL WINAPI CryptVerifyCertificateSignatureEx(HCRYPTPROV_LEGACY hCryptProv,
         PCERT_SIGNED_CONTENT_INFO signedCert = NULL;
         DWORD size = 0;
 
-        ret = CryptDecodeObjectEx(dwCertEncodingType, X509_CERT,
-         subjectBlob.pbData, subjectBlob.cbData,
-         CRYPT_DECODE_ALLOC_FLAG | CRYPT_DECODE_NOCOPY_FLAG, NULL,
-         &signedCert, &size);
+        if (dwSubjectType == CRYPT_VERIFY_CERT_SIGN_SUBJECT_OCSP_BASIC_SIGNED_RESPONSE_)
+            signedCert = &ocspSigned;
+        else
+            ret = CryptDecodeObjectEx(dwCertEncodingType, X509_CERT,
+             subjectBlob.pbData, subjectBlob.cbData,
+             CRYPT_DECODE_ALLOC_FLAG | CRYPT_DECODE_NOCOPY_FLAG, NULL,
+             &signedCert, &size);
         if (ret)
         {
             switch (dwIssuerType)
             {
             case CRYPT_VERIFY_CERT_SIGN_ISSUER_PUBKEY:
+                issuerKey = pvIssuer;
                 ret = CRYPT_VerifyCertSignatureFromPublicKeyInfo(hCryptProv,
                  dwCertEncodingType, pvIssuer,
                  signedCert);
                 break;
             case CRYPT_VERIFY_CERT_SIGN_ISSUER_CERT:
+                issuerKey = &((PCCERT_CONTEXT)pvIssuer)->pCertInfo->SubjectPublicKeyInfo;
                 ret = CRYPT_VerifyCertSignatureFromPublicKeyInfo(hCryptProv,
                  dwCertEncodingType,
                  &((PCCERT_CONTEXT)pvIssuer)->pCertInfo->SubjectPublicKeyInfo,
@@ -3466,6 +3532,7 @@ BOOL WINAPI CryptVerifyCertificateSignatureEx(HCRYPTPROV_LEGACY hCryptProv,
                 ret = TRUE;
                 break;
 #endif
+                issuerKey = &chain->rgpChain[0]->rgpElement[0]->pCertContext->pCertInfo->SubjectPublicKeyInfo;
                 ret = CRYPT_VerifyCertSignatureFromPublicKeyInfo(hCryptProv, dwCertEncodingType,
                  &chain->rgpChain[0]->rgpElement[0]->pCertContext->pCertInfo->SubjectPublicKeyInfo, signedCert);
                 break;
@@ -3500,7 +3567,14 @@ BOOL WINAPI CryptVerifyCertificateSignatureEx(HCRYPTPROV_LEGACY hCryptProv,
                 }
 #endif
             }
-            LocalFree(signedCert);
+#ifdef SG_MUTANT_OCSP_NOVERIFY
+            if (dwSubjectType == CRYPT_VERIFY_CERT_SIGN_SUBJECT_OCSP_BASIC_SIGNED_RESPONSE_) ret = TRUE;
+#endif
+            if (ret && (dwFlags & CRYPT_VERIFY_CERT_SIGN_RETURN_STRONG_PROPERTIES_FLAG_) && pvReserved &&
+                dwSubjectType == CRYPT_VERIFY_CERT_SIGN_SUBJECT_OCSP_BASIC_SIGNED_RESPONSE_)
+                *(CRYPT_VERIFY_CERT_SIGN_STRONG_PROPERTIES_INFO_ **)pvReserved =
+                    CRYPT_StrongSignatureProperties(signedCert, issuerKey);
+            if (signedCert != &ocspSigned) LocalFree(signedCert);
         }
     }
     return ret;
--- a/dlls/crypt32/tests/cert.c
+++ b/dlls/crypt32/tests/cert.c
@@ -2230,6 +2230,68 @@ static void testVerifyCertSigExMore(HCRYPTPROV csp, const CRYPT_DATA_BLOB *toBeS
         ok(!ret && GetLastError() == E_INVALIDARG, "got ret %d, error %#lx.\n", ret, GetLastError());
     }
 
+    /* an OCSP basic response: the signed part and the signature are separate */
+    {
+        struct strong_info { CRYPT_DATA_BLOB alg; CRYPT_DATA_BLOB bits; } *strong;
+        CERT_SIGNED_CONTENT_INFO *decoded;
+        OCSP_BASIC_SIGNED_RESPONSE_INFO response;
+        CERT_BLOB cert_blob2;
+        BYTE *tampered;
+
+        cert = encode_signed_cert(csp, toBeSigned, sha1rsa, &size);
+        cert_blob2.cbData = size;
+        cert_blob2.pbData = cert;
+        ret = CryptDecodeObjectEx(X509_ASN_ENCODING, X509_CERT, cert, size, CRYPT_DECODE_ALLOC_FLAG, NULL, &decoded, &size);
+        ok(ret, "CryptDecodeObjectEx failed: %08lx\n", GetLastError());
+
+        memset(&response, 0, sizeof(response));
+        response.ToBeSigned = decoded->ToBeSigned;
+        response.SignatureInfo.SignatureAlgorithm = decoded->SignatureAlgorithm;
+        response.SignatureInfo.Signature = decoded->Signature;
+        ret = CryptVerifyCertificateSignatureEx(csp, X509_ASN_ENCODING, 4 /* ..._OCSP_BASIC_SIGNED_RESPONSE */,
+                &response, CRYPT_VERIFY_CERT_SIGN_ISSUER_PUBKEY, pub_key, 0, NULL);
+        ok(ret, "CryptVerifyCertificateSignatureEx failed: %08lx\n", GetLastError());
+
+        tampered = malloc(response.ToBeSigned.cbData);
+        memcpy(tampered, response.ToBeSigned.pbData, response.ToBeSigned.cbData);
+        tampered[response.ToBeSigned.cbData - 1] ^= 1;
+        response.ToBeSigned.pbData = tampered;
+        SetLastError(0xdeadbeef);
+        ret = CryptVerifyCertificateSignatureEx(csp, X509_ASN_ENCODING, 4, &response,
+                CRYPT_VERIFY_CERT_SIGN_ISSUER_PUBKEY, pub_key, 0, NULL);
+        ok(!ret, "succeeded with a changed response.\n");
+        free(tampered);
+        response.ToBeSigned = decoded->ToBeSigned;
+
+        /* the strong signature properties: "RSA/SHA1" and the key's length in bits */
+        strong = (void *)0xdeadbeef;
+        ret = CryptVerifyCertificateSignatureEx(csp, X509_ASN_ENCODING, 4, &response,
+                CRYPT_VERIFY_CERT_SIGN_ISSUER_PUBKEY, pub_key, 4 /* ..._RETURN_STRONG_PROPERTIES_FLAG */, &strong);
+        ok(ret, "CryptVerifyCertificateSignatureEx failed: %08lx\n", GetLastError());
+        ok(strong && strong != (void *)0xdeadbeef, "got %p\n", strong);
+        if (strong && strong != (void *)0xdeadbeef)
+        {
+            ok(strong->alg.cbData == sizeof(L"RSA/SHA1") && !wcscmp((WCHAR *)strong->alg.pbData, L"RSA/SHA1"),
+                    "got %s, %lu\n", wine_dbgstr_w((WCHAR *)strong->alg.pbData), strong->alg.cbData);
+            ok(strong->bits.cbData == sizeof(DWORD) && *(DWORD *)strong->bits.pbData
+                    == CertGetPublicKeyLength(X509_ASN_ENCODING, pub_key), "got %lu bits\n",
+                    *(DWORD *)strong->bits.pbData);
+            CryptMemFree(strong);
+        }
+
+        /* nothing is returned for the other subject types, or without the flag */
+        strong = (void *)0xdeadbeef;
+        ret = CryptVerifyCertificateSignatureEx(csp, X509_ASN_ENCODING, CRYPT_VERIFY_CERT_SIGN_SUBJECT_BLOB,
+                &cert_blob2, CRYPT_VERIFY_CERT_SIGN_ISSUER_PUBKEY, pub_key, 4, &strong);
+        ok(ret && strong == (void *)0xdeadbeef, "got %d, %p\n", ret, strong);
+        ret = CryptVerifyCertificateSignatureEx(csp, X509_ASN_ENCODING, 4, &response,
+                CRYPT_VERIFY_CERT_SIGN_ISSUER_PUBKEY, pub_key, 0, &strong);
+        ok(ret && strong == (void *)0xdeadbeef, "got %d, %p\n", ret, strong);
+
+        LocalFree(decoded);
+        LocalFree(cert);
+    }
+
     /* CRYPT_VERIFY_CERT_SIGN_DISABLE_MD2_MD4_FLAG: the signature is good, but the algorithm is rejected */
     cert = encode_signed_cert(csp, toBeSigned, md2rsa, &size);
     cert_blob.cbData = size;
