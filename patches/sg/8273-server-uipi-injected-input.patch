From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: UIPI for injected input

Input a process injects (SendInput, keybd_event, mouse_event, and InjectSyntheticPointerInput, which goes the same way) no longer reaches a window of a process at high integrity or above unless the injecting process has at least that integrity, as UIPI has it on Windows. The injector is recorded on the hardware message and checked once the target window is known, both when the message is queued and when it is retrieved; a blocked event is dropped silently and SendInput still returns the count. Real hardware input from the drivers is not checked. Within the UIPI model of 0291 (which covers messages, AttachThreadInput and hooks); no exemptions and no uiAccess.
---
--- a/server/queue.c
+++ b/server/queue.c
@@ -88,6 +88,10 @@
     unsigned int           data_size; /* size of message data */
     unsigned int           unique_id; /* unique id for nested hw message waits */
     struct message_result *result;    /* result in sender queue */
+    /* Stained Glass OS (8273): who injected a hardware message (SendInput, InjectSyntheticPointerInput,
+     * keybd_event, mouse_event), for UIPI once its window is known; 0 for real hardware input */
+    process_id_t           injector;
+    unsigned int           injector_integrity;
 };
 
 struct timer
@@ -1898,6 +1902,28 @@
 }
 
 /* queue a hardware message into a given thread input */
+/* Stained Glass OS (8273): UIPI for injected input. Input a process injects (SendInput and the like) does
+ * not reach a window of a process at high integrity or above unless the injecting process has at least
+ * that integrity -- on Windows such input is dropped, and the call still reports it sent. Real hardware
+ * input (the drivers') is never held back. */
+static void mark_injected( struct message *msg )
+{
+    if (!current || !current->process) return;
+    msg->injector = current->process->id;
+    msg->injector_integrity = token_get_integrity( current->process->token );
+}
+
+static int injected_input_allowed( const struct message *msg, struct thread *target )
+{
+#ifdef SG_MUTANT_NO_INJECTED_UIPI
+    return 1;
+#endif
+    if (!msg->injector || !target || !target->process) return 1;
+    if (target->process->id == msg->injector) return 1;
+    if (token_get_integrity( target->process->token ) < SECURITY_MANDATORY_HIGH_RID) return 1;
+    return msg->injector_integrity >= token_get_integrity( target->process->token );
+}
+
 static void queue_hardware_message( struct desktop *desktop, struct message *msg, int always_queue )
 {
     const desktop_shm_t *desktop_shm = desktop->shared;
@@ -1946,6 +1972,13 @@
 
     win = find_hardware_message_window( desktop, input, msg, &msg_code, &thread );
     flags = thread ? get_rawinput_device_flags( thread->process, msg ) : 0;
+    if (win && thread && !injected_input_allowed( msg, thread ))
+    {
+        /* dropped as UIPI drops it */
+        free_message( msg );
+        release_object( thread );
+        return;
+    }
     if (!win || !thread || (flags & RIDEV_NOLEGACY))
     {
         if (input && !(flags & RIDEV_NOLEGACY)) update_thread_input_key_state( input, msg->msg, msg->wparam );
@@ -2307,6 +2340,7 @@
         msg->x         = x;
         msg->y         = y;
         if (origin == IMO_INJECTED) msg_data->flags = LLMHF_INJECTED;
+        if (origin == IMO_INJECTED) mark_injected( msg );
 
         /* specify a sender only when sending the last message */
         if (!(flags & ((1 << ARRAY_SIZE( messages )) - 1)))
@@ -2504,6 +2538,7 @@
     msg->win       = get_user_full_handle( win );
     msg->msg       = message_code;
     if (origin == IMO_INJECTED) msg_data->flags = LLKHF_INJECTED;
+    if (origin == IMO_INJECTED) mark_injected( msg );
 
     if (!unicode || input->kbd.vkey)
     {
@@ -3013,6 +3048,14 @@
 
         ptr = list_next( &input->msg_list, ptr );
         win = find_hardware_message_window( input->desktop, input, msg, &msg_code, &win_thread );
+        if (win && win_thread && !injected_input_allowed( msg, win_thread ))
+        {
+            /* injected from below a high-integrity window: dropped (UIPI) */
+            list_remove( &msg->entry );
+            free_message( msg );
+            release_object( win_thread );
+            continue;
+        }
         if (!win || !win_thread)
         {
             /* no window at all, remove it */
