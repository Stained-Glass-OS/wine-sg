+@ stdcall MagGetWindowTransform(long ptr)
 @ stdcall MagInitialize()
-@ stub MagSetColorEffect
+@ stdcall MagSetColorEffect(long ptr)
 @ stdcall MagSetFullscreenColorEffect(ptr)
 @ stdcall MagSetFullscreenTransform(float long long)
 @ stub MagSetImageScalingCallback
 @ stub MagSetInputTransform
-@ stub MagSetWindowFilterList
-@ stub MagSetWindowSource
-@ stub MagSetWindowTransform
