@@ -1,22 +1,22 @@
 @ stdcall MagSetFullscreenUseBitmapSmoothing(long)
-@ stub MagSetLensUseBitmapSmoothing
-@ stub MagGetColorEffect
+@ stdcall MagSetLensUseBitmapSmoothing(long)
+@ stdcall MagGetColorEffect(long ptr)
 @ stdcall MagGetFullscreenColorEffect(ptr)
 @ stdcall MagGetFullscreenTransform(ptr ptr ptr)
 @ stub MagGetImageScalingCallback
 @ stub MagGetInputTransform
-@ stub MagGetWindowFilterList
-@ stub MagGetWindowSource
-@ stub MagGetWindowTransform
+@ stdcall MagGetWindowFilterList(long ptr long ptr)
