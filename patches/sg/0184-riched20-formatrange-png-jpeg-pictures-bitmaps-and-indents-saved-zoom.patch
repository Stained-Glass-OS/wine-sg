+/* EM_FORMATRANGE: lay the text out for a device (a printer, or a preview
+ * that measures on one) and draw the part from fr->chrg.cpMin that fits in
+ * fr->rc, a page at a time. The text is re-wrapped for the target device's
+ * resolution and the page's width, the rows that fit are drawn with the
+ * selection hidden and no background, and the screen layout is restored.
+ * Returns the first character that did not fit (the next page's start), or
+ * the text's length + 1 (its final paragraph mark) when the rest fitted, and
+ * sets fr->rc.bottom to where the text ended, as Windows does; with no
+ * FORMATRANGE (freeing the cache) it returns the text's length. */
+LRESULT editor_format_range( ME_TextEditor *editor, BOOL render, FORMATRANGE *fr )
+{
+    RECT saved_format = editor->rcFormat, area;
+    int saved_avail = editor->nAvailWidth, saved_num = editor->nZoomNumerator, saved_den = editor->nZoomDenominator;
+    BOOL saved_wrap = editor->bWordWrap, saved_hide = editor->bHideSelection;
+    TXTBACKSTYLE saved_back = editor->back_style;
+    int tdpix, tdpiy, height, used = 0, start_y, len, next;
+    HDC target, host;
+    ME_Cursor cursor;
+    ME_Row *row, *first;
+
+    if (!fr) return ME_GetTextLength( editor );
+    if (!fr->hdc) return 0;
+    target = fr->hdcTarget ? fr->hdcTarget : fr->hdc;
+    tdpix = GetDeviceCaps( target, LOGPIXELSX );
+    tdpiy = GetDeviceCaps( target, LOGPIXELSY );
+    if (tdpix <= 0 || tdpiy <= 0) return 0;
+    len = ME_GetTextLength( editor );
+    if (fr->chrg.cpMin >= len) return len;
+
+    area.left = MulDiv( fr->rc.left, tdpix, 1440 );
+    area.top = MulDiv( fr->rc.top, tdpiy, 1440 );
+    area.right = MulDiv( fr->rc.right, tdpix, 1440 );
+    area.bottom = MulDiv( fr->rc.bottom, tdpiy, 1440 );
+    height = area.bottom - area.top;
+    if (area.right <= area.left || height <= 0) return fr->chrg.cpMin;
+
+    /* the page's layout */
+    SetRect( &editor->rcFormat, 0, 0, area.right - area.left, height );
+    editor->nAvailWidth = 0;
+    editor->bWordWrap = (editor->props & TXTBIT_MULTILINE) != 0;
+    editor->nZoomNumerator = editor->nZoomDenominator = 0;
+    editor_mark_rewrap_all( editor );
+    wrap_marked_paras_dc( editor, target, FALSE );
+
+    /* the rows from cpMin that fit */
+    cursor_from_char_ofs( editor, max( fr->chrg.cpMin, 0 ), &cursor );
+    first = row = row_from_cursor( &cursor );
+    start_y = row_para( row )->pt.y + row->pt.y;
+    next = len + 1;
+    while (row)
+    {
+        ME_Paragraph *para = row_para( row );
+        ME_Cursor rc;
+        int ofs, bottom = para->pt.y + row->pt.y + row->nHeight - start_y;
+
+        row_first_cursor( row, &rc );
+        ofs = ME_GetCursorOfs( &rc );
+        if (row != first && (bottom > height || (fr->chrg.cpMax >= 0 && ofs >= fr->chrg.cpMax)))
+        {
+            next = ofs;
+            break;
+        }
+        used = bottom;
+        row = row_next_all_paras( row );
+    }
+
+    if (render)
+    {
+        ME_Context c;
+        ME_Paragraph *para;
+        int dpix = GetDeviceCaps( fr->hdc, LOGPIXELSX ), dpiy = GetDeviceCaps( fr->hdc, LOGPIXELSY );
+        int saved_dc = SaveDC( fr->hdc );
+
+        if (fr->hdc != target && dpix > 0 && dpiy > 0 && (dpix != tdpix || dpiy != tdpiy))
+        {
+            /* measured on the target, drawn here: draw in the target's units */
+            SetMapMode( fr->hdc, MM_ANISOTROPIC );
+            SetWindowExtEx( fr->hdc, tdpix, tdpiy, NULL );
+            SetViewportExtEx( fr->hdc, dpix, dpiy, NULL );
+        }
+        ME_InitContext( &c, editor, fr->hdc );
+        c.dpi.cx = tdpix;
+        c.dpi.cy = tdpiy;
+        c.rcView = area;
+        c.pt.x = area.left;
+        c.pt.y = area.top - start_y;
+        IntersectClipRect( fr->hdc, area.left, area.top, area.right, area.top + max( used, 1 ) );
+        editor->bHideSelection = TRUE;
+        editor->back_style = TXTBACK_TRANSPARENT;
+        SetBkMode( fr->hdc, TRANSPARENT );
+        for (para = row_para( first ); para_next( para ); para = para_next( para ))
+        {
+            int ys = c.pt.y + para->pt.y;
+            if (ys >= area.top + used) break;
+            if (ys + para->nHeight <= area.top) continue;
+            draw_paragraph( &c, para );
+        }
+        ME_DestroyContext( &c );
+        editor->bHideSelection = saved_hide;
+        editor->back_style = saved_back;
+        RestoreDC( fr->hdc, saved_dc );
+    }
+
+    /* back to the screen's layout */
+    editor->rcFormat = saved_format;
+    editor->nAvailWidth = saved_avail;
+    editor->bWordWrap = saved_wrap;
+    editor->nZoomNumerator = saved_num;
+    editor->nZoomDenominator = saved_den;
+    editor_mark_rewrap_all( editor );
+    host = ITextHost_TxGetDC( editor->texthost );
+    wrap_marked_paras_dc( editor, host, FALSE );
+    ITextHost_TxReleaseDC( editor->texthost, host );
+    ME_UpdateScrollBar( editor );
+    fr->rc.bottom = fr->rc.top + MulDiv( used, 1440, tdpiy );
+    return next;
+}
