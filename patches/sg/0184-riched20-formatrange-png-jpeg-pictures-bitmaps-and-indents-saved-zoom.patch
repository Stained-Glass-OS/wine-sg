+static BOOL stream_out_bitmap( ME_OutStream *stream, IDataObject *data, ME_Run *run, const ME_Context *c )
+{
+    FORMATETC fmt = { CF_BITMAP, NULL, DVASPECT_CONTENT, -1, TYMED_GDI };
+    STGMEDIUM med = { TYMED_NULL };
+    BITMAP bm;
+    BITMAPINFOHEADER bih;
+    BYTE *bits = NULL;
+    SIZE goal;
+    DWORD stride;
+    BOOL ret = FALSE;
+    HDC hdc;
+
+    if (FAILED(IDataObject_GetData( data, &fmt, &med ))) return FALSE;
+    if (med.tymed != TYMED_GDI || !GetObjectW( med.hBitmap, sizeof(bm), &bm ) || bm.bmWidth <= 0 || bm.bmHeight <= 0)
+        goto done;
+    memset( &bih, 0, sizeof(bih) );
+    bih.biSize = sizeof(bih);
+    bih.biWidth = bm.bmWidth;
+    bih.biHeight = bm.bmHeight;
+    bih.biPlanes = 1;
+    bih.biBitCount = 24;
+    bih.biCompression = BI_RGB;
+    stride = (bm.bmWidth * 3 + 3) & ~3;
+    bih.biSizeImage = stride * bm.bmHeight;
+    if (!(bits = malloc( bih.biSizeImage ))) goto done;
+    hdc = GetDC( 0 );
+    if (!GetDIBits( hdc, med.hBitmap, 0, bm.bmHeight, bits, (BITMAPINFO *)&bih, DIB_RGB_COLORS ))
+    {
+        ReleaseDC( 0, hdc );
+        goto done;
+    }
+    ReleaseDC( 0, hdc );
+    bih.biSizeImage = stride * bm.bmHeight;
+
+    if (run->reobj->obj.sizel.cx || run->reobj->obj.sizel.cy)
+    {
+        goal.cx = MulDiv( run->reobj->obj.sizel.cx, 144, 254 );
+        goal.cy = MulDiv( run->reobj->obj.sizel.cy, 144, 254 );
+    }
+    else
+    {
+        goal.cx = MulDiv( bm.bmWidth, 1440, c->dpi.cx );
+        goal.cy = MulDiv( bm.bmHeight, 1440, c->dpi.cy );
+    }
+    if (!ME_StreamOutPrint( stream, "{\\*\\shppict{\\pict\\dibitmap0\\picw%d\\pich%d\\picwgoal%d\\pichgoal%d\n",
+                            bm.bmWidth, bm.bmHeight, goal.cx, goal.cy )) goto done;
+    if (!ME_StreamOutHexData( stream, (BYTE *)&bih, sizeof(bih) )) goto done;
+    if (!ME_StreamOutHexData( stream, bits, bih.biSizeImage )) goto done;
+    if (!ME_StreamOutPrint( stream, "}}\n" )) goto done;
+    ret = TRUE;
+done:
+    free( bits );
+    ReleaseStgMedium( &med );
+    return ret;
