+static HBITMAP decode_blip( const BYTE *data, DWORD size )
+{
+    HGLOBAL mem = GlobalAlloc( GMEM_MOVEABLE, size );
+    IStream *stream = NULL;
+    IPicture *pic = NULL;
+    HBITMAP ret = NULL;
+    OLE_HANDLE handle;
+    SHORT type;
+    void *p;
+
+    if (!mem) return NULL;
+    p = GlobalLock( mem );
+    memcpy( p, data, size );
+    GlobalUnlock( mem );
+    if (FAILED(CreateStreamOnHGlobal( mem, TRUE, &stream ))) { GlobalFree( mem ); return NULL; }
+    if (SUCCEEDED(OleLoadPicture( stream, size, FALSE, &IID_IPicture, (void **)&pic )))
+    {
+        if (SUCCEEDED(IPicture_get_Type( pic, &type )) && type == PICTYPE_BITMAP &&
+            SUCCEEDED(IPicture_get_Handle( pic, &handle )))
+            ret = CopyImage( ULongToHandle( handle ), IMAGE_BITMAP, 0, 0, LR_CREATEDIBSECTION );
+        IPicture_Release( pic );
+    }
+    IStream_Release( stream );
+    return ret;
+}
