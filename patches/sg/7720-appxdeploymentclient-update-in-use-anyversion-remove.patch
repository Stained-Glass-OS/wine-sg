From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxdeploymentclient: updates and removals of packages in use; ForceUpdateFromAnyVersion

---
--- a/dlls/appxdeploymentclient/deploy.c
+++ b/dlls/appxdeploymentclient/deploy.c
@@ -189,6 +189,8 @@
     list->data[list->len] = 0;
 }
 
+static unsigned int processes_in_folders( const struct strlist *folders, BOOL terminate );
+
 static BOOL multi_contains( const WCHAR *multi, const WCHAR *str )
 {
     for (; multi && *multi; multi += wcslen( multi ) + 1) if (!wcsicmp( multi, str )) return TRUE;
@@ -2259,7 +2261,21 @@
     unregister_integration( key, hive, content_root( &rec ) );
     /* a development registration is the developer's own folder; the files of the package stay while
      * another user has it */
-    if (!rec.development_mode && !other_users_have( full_name )) delete_tree( rec.install_location );
+    /* Stained Glass OS 7720: the package's running programs end with it (anyone's, when its files go:
+     * SYSTEM removing the machine's package ends another person's program of it, as Remove-AppxPackage
+     * -AllUsers does) */
+    if (!rec.development_mode && !other_users_have( full_name ))
+    {
+        struct strlist folders = { 0 };
+
+#ifndef SG_MUTANT_AX_REMOVE_KEEPS_RUNNING
+        if (rec.install_location && rec.install_location[0]) strlist_add( &folders, rec.install_location );
+        if (rec.external_location && rec.external_location[0]) strlist_add( &folders, rec.external_location );
+        if (folders.data) processes_in_folders( &folders, TRUE );
+#endif
+        free( folders.data );
+        delete_tree( rec.install_location );
+    }
     RegCloseKey( key );
     package_record_free( &rec );
     swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, full_name );
@@ -2377,8 +2393,21 @@
     const struct package_record *rec;
     UINT64 highest;
     struct strlist older;
+    DeploymentOptions options;
 };
 
+/* Stained Glass OS 7720: a package's folders, for its running programs: its own and its external
+ * content */
+static void add_package_folders( const WCHAR *full_name, struct strlist *folders )
+{
+    struct package_record rec;
+
+    if (!open_record( full_name, &rec, NULL )) return;
+    if (rec.install_location && rec.install_location[0]) strlist_add( folders, rec.install_location );
+    if (rec.external_location && rec.external_location[0]) strlist_add( folders, rec.external_location );
+    package_record_free( &rec );
+}
+
 static BOOL find_family( struct package_record *rec, void *context )
 {
     struct family_search *search = context;
@@ -2390,7 +2419,12 @@
                                           search->rec->resource_id ? search->rec->resource_id : L"" ))
         return TRUE;
     if (rec->version > search->highest) search->highest = rec->version;
-    if (rec->version < search->rec->version || rec->architecture != search->rec->architecture)
+    /* Stained Glass OS: ForceUpdateFromAnyVersion -- the version installed, higher too, makes way */
+    if (rec->version < search->rec->version || rec->architecture != search->rec->architecture
+#ifndef SG_MUTANT_AX_ANYVERSION_KEEPS
+        || (search->options & DeploymentOptions_ForceUpdateFromAnyVersion)
+#endif
+        )
         strlist_add( &search->older, rec->full_name );
     return TRUE;
 }
@@ -2534,6 +2568,7 @@
     /* versions of the same package: an update replaces older ones, a
      * downgrade is refused; frameworks of several versions live side by side */
     family.rec = &rec;
+    family.options = options;
     for_each_record( find_family, &family );
     if (!rec.framework && family.highest > rec.version &&
         !(options & DeploymentOptions_ForceUpdateFromAnyVersion))
@@ -2542,6 +2577,31 @@
         hr = 0x80073d06; /* ERROR_INSTALL_PACKAGE_DOWNGRADE */
         goto done;
     }
+    /* Stained Glass OS 7720: the version it replaces (or this very version, installed again) is not
+     * replaced under its running programs: they are ended with ForceApplicationShutdown /
+     * ForceTargetApplicationShutdown, else the update fails (ERROR_PACKAGES_IN_USE), as on Windows */
+    if (!rec.framework && !stage && !is_resource)
+    {
+        struct strlist in_use = { 0 };
+
+        for (p = family.older.data; p && *p; p += wcslen( p ) + 1) add_package_folders( p, &in_use );
+        if (record_in( own_hive(), rec.full_name )) add_package_folders( rec.full_name, &in_use );
+#ifndef SG_MUTANT_AX_UPDATE_IN_USE
+        if (in_use.data && processes_in_folders( &in_use, FALSE ))
+        {
+            if (options & (DeploymentOptions_ForceApplicationShutdown | DeploymentOptions_ForceTargetApplicationShutdown))
+                processes_in_folders( &in_use, TRUE );
+            else
+            {
+                free( in_use.data );
+                set_error( error_text, L"The package's applications are running; close them and try again", rec.family_name );
+                hr = 0x80073d02; /* ERROR_PACKAGES_IN_USE */
+                goto done;
+            }
+        }
+#endif
+        free( in_use.data );
+    }
     if (!is_resource && FAILED(hr = resolve_dependencies( manifest, &rec, error_text ))) goto done;
 
     if (FAILED(hr = staging_root( root, ARRAY_SIZE(root) ))) goto done;
@@ -3634,14 +3694,16 @@
     return TRUE;
 }
 
-/* End the processes whose program is in one of the folders (a list of NUL-terminated paths). */
-static void terminate_in_folders( const struct strlist *folders )
+/* The processes whose program is in one of the folders (a list of NUL-terminated paths): how many,
+ * and they end when TERMINATE. */
+static unsigned int processes_in_folders( const struct strlist *folders, BOOL terminate )
 {
     PROCESSENTRY32W entry = { sizeof(entry) };
     HANDLE snap = CreateToolhelp32Snapshot( TH32CS_SNAPPROCESS, 0 );
+    unsigned int count = 0;
     const WCHAR *f;
 
-    if (snap == INVALID_HANDLE_VALUE) return;
+    if (snap == INVALID_HANDLE_VALUE) return 0;
     if (Process32FirstW( snap, &entry )) do
     {
         WCHAR image[MAX_PATH];
@@ -3649,21 +3711,33 @@
         HANDLE process;
 
         if (entry.th32ProcessID == GetCurrentProcessId()) continue;
-        if (!(process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_TERMINATE, FALSE, entry.th32ProcessID ))) continue;
-        if (QueryFullProcessImageNameW( process, 0, image, &size ))
+        if (!(process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION | (terminate ? PROCESS_TERMINATE : 0) | SYNCHRONIZE,
+                                     FALSE, entry.th32ProcessID ))) continue;
+        if (WaitForSingleObject( process, 0 ) == WAIT_TIMEOUT && QueryFullProcessImageNameW( process, 0, image, &size ))
             for (f = folders->data; f && *f; f += wcslen( f ) + 1)
             {
                 size_t len = wcslen( f );
                 if (!wcsnicmp( image, f, len ) && image[len] == '\\')
                 {
-                    TRACE( "ending %s\n", debugstr_w( image ) );
-                    TerminateProcess( process, 1 );
+                    count++;
+                    if (terminate)
+                    {
+                        TRACE( "ending %s\n", debugstr_w( image ) );
+                        TerminateProcess( process, 1 );
+                        WaitForSingleObject( process, 5000 );
+                    }
                     break;
                 }
             }
         CloseHandle( process );
     } while (Process32NextW( snap, &entry ));
     CloseHandle( snap );
+    return count;
+}
+
+static void terminate_in_folders( const struct strlist *folders )
+{
+    processes_in_folders( folders, TRUE );
 }
 
 struct dependent_folders
