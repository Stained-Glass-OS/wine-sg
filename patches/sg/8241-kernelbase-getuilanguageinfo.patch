From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: GetUILanguageInfo

GetUILanguageInfo was a spec stub in kernelbase and missing from kernel32. Every specific locale is an installed, licensed, fully localized UI language (as EnumUILanguages lists them): the attributes say so and the fallback list is empty (two nulls); an unknown or neutral language is ERROR_OBJECT_NOT_FOUND, bad flags or a size without a buffer ERROR_INVALID_PARAMETER, too small a buffer ERROR_INSUFFICIENT_BUFFER with the size. winnls.h gains its prototype.
---
--- a/include/winnls.h
+++ b/include/winnls.h
@@ -950,6 +950,7 @@
 WINBASEAPI BOOL        WINAPI GetThreadPreferredUILanguages(DWORD,ULONG*,WCHAR*,ULONG*);
 WINBASEAPI LANGID      WINAPI GetThreadUILanguage(void);
 WINBASEAPI BOOL        WINAPI GetUserPreferredUILanguages(DWORD,ULONG*,WCHAR*,ULONG*);
+WINBASEAPI BOOL        WINAPI GetUILanguageInfo(DWORD,PCZZWSTR,PZZWSTR,PDWORD,PDWORD);
 WINBASEAPI INT         WINAPI GetTimeFormatA(LCID,DWORD,const SYSTEMTIME*,LPCSTR,LPSTR,INT);
 WINBASEAPI INT         WINAPI GetTimeFormatEx(LPCWSTR,DWORD,const SYSTEMTIME*,LPCWSTR,LPWSTR,INT);
 WINBASEAPI INT         WINAPI GetTimeFormatW(LCID,DWORD,const SYSTEMTIME*,LPCWSTR,LPWSTR,INT);
--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -9123,3 +9123,92 @@
     TRACE( "(%s,%lx,%p,%s,%p,%d)\n", debugstr_w(name), flags, systime, debugstr_w(format), buffer, len );
     return get_time_format( locale, flags, systime, format, buffer, len );
 }
+
+
+#ifndef SG_MUTANT_NO_UILANGINFO
+/* (wine-sg 8241) a UI language of GetUILanguageInfo: a specific (not neutral) locale, by name or by its
+ * 4-digit hexadecimal LANGID */
+static BOOL ui_language_valid( DWORD flags, const WCHAR *str )
+{
+    WCHAR *end;
+    DWORD neutral = 1;
+    LCID lcid;
+
+    if (flags & MUI_LANGUAGE_ID)
+    {
+        LANGID id;
+        if (wcslen( str ) != 4) return FALSE;
+        id = wcstoul( str, &end, 16 );
+        if (*end || id == LOCALE_CUSTOM_UNSPECIFIED) return FALSE;
+        lcid = MAKELCID( id, SORT_DEFAULT );
+        if (!IsValidLocale( lcid, LCID_INSTALLED )) return FALSE;
+        if (!GetLocaleInfoW( lcid, LOCALE_INEUTRAL | LOCALE_RETURN_NUMBER, (WCHAR *)&neutral, sizeof(neutral) / sizeof(WCHAR) ))
+            return FALSE;
+    }
+    else
+    {
+        if (!(lcid = LocaleNameToLCID( str, 0 )) || lcid == LOCALE_CUSTOM_UNSPECIFIED) return FALSE;
+        if (!GetLocaleInfoEx( str, LOCALE_INEUTRAL | LOCALE_RETURN_NUMBER, (WCHAR *)&neutral, sizeof(neutral) / sizeof(WCHAR) ))
+            return FALSE;
+    }
+    return !neutral;
+}
+
+/***********************************************************************
+ *	GetUILanguageInfo   (kernelbase.@)
+ *
+ * Every specific locale is an installed, licensed, fully localized UI language here (as EnumUILanguages lists
+ * them): its fallback list is empty, its attributes MUI_FULL_LANGUAGE | MUI_LANGUAGE_INSTALLED |
+ * MUI_LANGUAGE_LICENSED.
+ */
+BOOL WINAPI GetUILanguageInfo( DWORD flags, const WCHAR *languages, WCHAR *fallback, DWORD *count,
+                               DWORD *attributes )
+{
+    const WCHAR *p;
+
+    TRACE( "%#lx, %s, %p, %p, %p\n", flags, debugstr_w(languages), fallback, count, attributes );
+
+    if ((flags & ~(MUI_LANGUAGE_ID | MUI_LANGUAGE_NAME)) ||
+        (flags & (MUI_LANGUAGE_ID | MUI_LANGUAGE_NAME)) == (MUI_LANGUAGE_ID | MUI_LANGUAGE_NAME) ||
+        !languages || !languages[0] || !attributes || (count && *count && !fallback))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(flags & MUI_LANGUAGE_ID)) flags |= MUI_LANGUAGE_NAME;
+    for (p = languages; *p; p += wcslen( p ) + 1)
+    {
+        if (!ui_language_valid( flags, p ))
+        {
+            SetLastError( ERROR_OBJECT_NOT_FOUND );
+            return FALSE;
+        }
+        /* a fully localized language has no fallback: a second language in relation to it is not valid */
+        if (p != languages)
+        {
+            SetLastError( ERROR_OBJECT_NOT_FOUND );
+            return FALSE;
+        }
+    }
+    *attributes = MUI_FULL_LANGUAGE | MUI_LANGUAGE_INSTALLED | MUI_LANGUAGE_LICENSED;
+    if (count)
+    {
+        if (fallback && *count >= 2) fallback[0] = fallback[1] = 0;
+        else if (fallback || *count)
+        {
+            *count = 2;
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        *count = 2;
+    }
+    return TRUE;
+}
+#else
+BOOL WINAPI GetUILanguageInfo( DWORD flags, const WCHAR *languages, WCHAR *fallback, DWORD *count,
+                               DWORD *attributes )
+{
+    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    return FALSE;
+}
+#endif
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -778,7 +778,7 @@
 @ stdcall GetTraceEnableFlags(int64) ntdll.EtwGetTraceEnableFlags
 @ stdcall GetTraceEnableLevel(int64) ntdll.EtwGetTraceEnableLevel
 @ stdcall -ret64 GetTraceLoggerHandle(ptr) ntdll.EtwGetTraceLoggerHandle
-@ stub GetUILanguageInfo
+@ stdcall GetUILanguageInfo(long wstr ptr ptr ptr)
 # @ stub GetUnicodeStringToEightBitSizeRoutine
 # @ stub GetUnicodeStringToEightBitStringRoutine
 @ stdcall GetUserDefaultGeoName(ptr long)
--- a/dlls/kernel32/kernel32.spec
+++ b/dlls/kernel32/kernel32.spec
@@ -901,7 +901,7 @@
 @ stdcall -import GetTimeFormatW(long long ptr wstr ptr long)
 @ stdcall -import GetTimeZoneInformation(ptr)
 @ stdcall -import GetTimeZoneInformationForYear(long ptr ptr)
-# @ stub GetUILanguageInfo
+@ stdcall -import GetUILanguageInfo(long wstr ptr ptr ptr)
 @ stdcall -arch=win64 GetUmsCompletionListEvent(ptr ptr)
 # @ stub -arch=win64 GetUmsSystemThreadInformation
 @ stdcall -import GetUserDefaultLCID()
