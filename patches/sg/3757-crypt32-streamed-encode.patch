+/* Stained Glass OS 3757: streamed output of signed and enveloped messages.
+ * The output is BER with indefinite lengths for the containers: the header at the first update,
+ * the content octets (as chunks of an indefinite-length OCTET STRING, or one definite-length
+ * string when CMSG_STREAM_INFO.cbContent is known), the closing octets and the trailer (the
+ * certificates, CRLs and signer infos) at the final one. */
+static const BYTE sg_oid_signed_data[] = { 0x06,0x09,0x2a,0x86,0x48,0x86,0xf7,0x0d,0x01,0x07,0x02 };
+static const BYTE sg_oid_data[] = { 0x06,0x09,0x2a,0x86,0x48,0x86,0xf7,0x0d,0x01,0x07,0x01 };
+static const BYTE sg_oid_enveloped_data[] = { 0x06,0x09,0x2a,0x86,0x48,0x86,0xf7,0x0d,0x01,0x07,0x03 };
+
+/* the encoded length of a definite length */
+static DWORD sg_ber_length(BYTE *out, DWORD len)
+{
+    if (len < 0x80) { out[0] = len; return 1; }
+    if (len < 0x100) { out[0] = 0x81; out[1] = len; return 2; }
+    if (len < 0x10000) { out[0] = 0x82; out[1] = len >> 8; out[2] = len; return 3; }
+    if (len < 0x1000000) { out[0] = 0x83; out[1] = len >> 16; out[2] = len >> 8; out[3] = len; return 4; }
+    out[0] = 0x84; out[1] = len >> 24; out[2] = len >> 16; out[3] = len >> 8; out[4] = len;
+    return 5;
+}
+
+/* the header of the DER item at p: its size and content length */
+static BOOL sg_der_header(const BYTE *p, DWORD avail, DWORD *hdr, DWORD *len)
+{
+    DWORD n, i;
+
+    if (avail < 2) return FALSE;
+    if (p[1] < 0x80) { *hdr = 2; *len = p[1]; }
+    else
+    {
+        n = p[1] & 0x7f;
+        if (!n || n > 4 || avail < 2 + n) return FALSE;
+        *len = 0;
+        for (i = 0; i < n; i++) *len = (*len << 8) | p[2 + i];
+        *hdr = 2 + n;
+    }
+    return *hdr + *len <= avail;
+}
+
+/* BER that carries indefinite lengths or constructed strings, as streamed messages do, to DER:
+ * the decoders below only read DER.  Constructed OCTET STRINGs (24) become one primitive string,
+ * and so does the [0] of an encrypted content info (a SEQUENCE of an OID, an algorithm SEQUENCE
+ * and that [0]) when it is constructed.  Single-byte tags only. */
+typedef struct _CSgBer
+{
+    BYTE *p;
+    DWORD len, cap;
+    BOOL  fail;
+} CSgBer;
+
+static void sg_ber_add(CSgBer *o, const void *p, DWORD n)
+{
+    if (o->fail || !n) return;
+    if (o->len + n > o->cap)
+    {
+        DWORD cap = max(o->cap * 2, o->len + n + 256);
+        BYTE *d = CryptMemRealloc(o->p, cap);
+
+        if (!d) { o->fail = TRUE; return; }
+        o->p = d;
+        o->cap = cap;
+    }
+    memcpy(o->p + o->len, p, n);
+    o->len += n;
+}
+
+/* a BER header: tag, whether constructed, header size, content length (0xffffffff: indefinite) */
+static BOOL sg_ber_header(const BYTE *p, DWORD avail, BYTE *tag, DWORD *hdr, DWORD *len)
+{
+    DWORD n, i;
+
+    if (avail < 2 || (p[0] & 0x1f) == 0x1f) return FALSE;
+    *tag = p[0];
+    if (p[1] < 0x80) { *hdr = 2; *len = p[1]; }
+    else if (p[1] == 0x80) { *hdr = 2; *len = 0xffffffff; }
+    else
+    {
+        n = p[1] & 0x7f;
+        if (n > 4 || avail < 2 + n) return FALSE;
+        *len = 0;
+        for (i = 0; i < n; i++) *len = (*len << 8) | p[2 + i];
+        *hdr = 2 + n;
+    }
+    return TRUE;
+}
+
+/* the size of the item at p, headers only */
+static BOOL sg_ber_extent(const BYTE *p, DWORD avail, DWORD depth, DWORD *size)
+{
+    BYTE tag;
+    DWORD hdr, len, pos;
+
+    if (depth > 24 || !sg_ber_header(p, avail, &tag, &hdr, &len)) return FALSE;
+    if (len != 0xffffffff)
+    {
+        if (len > avail - hdr) return FALSE;
+        *size = hdr + len;
+        return TRUE;
+    }
+    if (!(tag & 0x20)) return FALSE;
+    for (pos = hdr;;)
+    {
+        DWORD n;
+
+        if (avail - pos >= 2 && !p[pos] && !p[pos + 1]) { *size = pos + 2; return TRUE; }
+        if (pos >= avail || !sg_ber_extent(p + pos, avail - pos, depth + 1, &n)) return FALSE;
+        pos += n;
+    }
+}
+
+static BOOL sg_ber_convert(const BYTE *p, DWORD avail, DWORD depth, BOOL implicit_string, CSgBer *o, DWORD *used, BOOL *indef)
+{
+    BYTE tag, lenbuf[8];
+    DWORD hdr, len, pos, end;
+    CSgBer body = { 0 };
+    BOOL strings, ret = FALSE;
+    DWORD index = 0;
+    BYTE tags[3] = { 0 };
+
+    if (depth > 24 || !sg_ber_header(p, avail, &tag, &hdr, &len)) return FALSE;
+    if (!(tag & 0x20))
+    {
+        if (len == 0xffffffff || len > avail - hdr) return FALSE;
+        sg_ber_add(o, p, hdr + len);
+        *used = hdr + len;
+        return !o->fail;
+    }
+    if (len == 0xffffffff) *indef = TRUE;
+    strings = tag == 0x24 || implicit_string;
+    end = len == 0xffffffff ? avail : hdr + len;
+    if (end > avail) return FALSE;
+
+    /* the third item of a SEQUENCE { OID, SEQUENCE, [0] } is the constructed string of an encrypted content info */
+    pos = hdr;
+    if (tag == 0x30 && !strings)
+    {
+        DWORD k, at = hdr;
+
+        for (k = 0; k < 3 && at < end; k++)
+        {
+            BYTE t;
+            DWORD h, l, sz;
+
+            if (!sg_ber_header(p + at, end - at, &t, &h, &l) || !sg_ber_extent(p + at, end - at, depth + 1, &sz)) break;
+            tags[k] = t;
+            at += sz;
+        }
+    }
+    while (!body.fail)
+    {
+        DWORD n;
+        BYTE ctag;
+        DWORD ch, cl;
+
+        if (end - pos >= 2 && len == 0xffffffff && !p[pos] && !p[pos + 1])
+        {
+            pos += 2;
+            ret = TRUE;
+            break;
+        }
+        if (len != 0xffffffff && pos >= end) { ret = TRUE; break; }
+        if (pos >= end) break;
+        if (!sg_ber_header(p + pos, end - pos, &ctag, &ch, &cl)) break;
+        if (strings)
+        {
+            CSgBer chunk = { 0 };
+            BOOL ok;
+
+            /* the chunks of a string: primitive or constructed OCTET STRINGs; the DER of each, its content kept */
+            ok = (ctag == 0x04 || ctag == 0x24) && sg_ber_convert(p + pos, end - pos, depth + 1, FALSE, &chunk, &n, indef);
+            if (ok)
+            {
+                DWORD h2, l2;
+                BYTE t2;
+
+                if (sg_ber_header(chunk.p, chunk.len, &t2, &h2, &l2)) sg_ber_add(&body, chunk.p + h2, l2);
+                else ok = FALSE;
+            }
+            CryptMemFree(chunk.p);
+            if (!ok) break;
+        }
+        else
+        {
+            BOOL implicit = tag == 0x30 && index == 2 && (ctag == 0xa0) && tags[0] == 0x06 && tags[1] == 0x30;
+
+            if (!sg_ber_convert(p + pos, end - pos, depth + 1, implicit, &body, &n, indef)) break;
+        }
+        pos += n;
+        index++;
+    }
+    if (ret && !body.fail)
+    {
+        {
+            BYTE out_tag = strings ? (tag & ~0x20) : tag;   /* a string is primitive in DER: 24 -> 04, a0 -> 80 */
+
+            sg_ber_add(o, &out_tag, 1);
+        }
+        sg_ber_add(o, lenbuf, sg_ber_length(lenbuf, body.len));
+        sg_ber_add(o, body.p, body.len);
+        *used = pos;
+        ret = !o->fail;
+    }
+    else
+        ret = FALSE;
+    CryptMemFree(body.p);
+    return ret;
+}
+
+/* msg_data with the BER turned into DER, when it has indefinite lengths; unchanged when it is not BER we know */
+static void sg_ber_normalize(CRYPT_DATA_BLOB *blob)
+{
+    CSgBer out = { 0 };
+    BOOL indef = FALSE;
+    DWORD used = 0;
+
+    if (blob->cbData < 4 || blob->pbData[0] != 0x30 || sg_ber_convert(blob->pbData, blob->cbData, 0, FALSE, &out, &used, &indef) == FALSE ||
+        !indef || out.fail)
+    {
+        CryptMemFree(out.p);
+        return;
+    }
+    CryptMemFree(blob->pbData);
+    blob->pbData = out.p;
+    blob->cbData = out.len;
+}
+
+/* calls the application's callback; a callback that is NULL or faults fails the update */
+static BOOL CryptMsgBase_StreamOut(CryptMsgBase *base, const BYTE *pb, DWORD cb, BOOL final)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        ret = base->stream_info.pfnStreamOutput(base->stream_info.pvArg, (BYTE *)pb, cb, final);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+        ret = FALSE;
+    }
+    __ENDTRY
+    return ret;
+}
+
+typedef struct _CSgOut
+{
+    BYTE *data;
+    DWORD len, cap;
+    BOOL  failed;
+} CSgOut;
+
+static void sg_out_add(CSgOut *out, const void *p, DWORD n)
+{
+    if (out->failed || !n) return;
+    if (out->len + n > out->cap)
+    {
+        DWORD cap = max(out->cap * 2, out->len + n + 256);
+        BYTE *d = CryptMemRealloc(out->data, cap);
+
+        if (!d) { out->failed = TRUE; return; }
+        out->data = d;
+        out->cap = cap;
+    }
+    memcpy(out->data + out->len, p, n);
+    out->len += n;
+}
+
+static void sg_out_free(CSgOut *out)
+{
+    CryptMemFree(out->data);
+    out->data = NULL;
+    out->len = out->cap = 0;
+}
+
+/* sends what out holds (even nothing, when final) and empties it */
+static BOOL sg_out_flush(CryptMsgBase *base, CSgOut *out, BOOL final)
+{
+    BOOL ret = !out->failed;
+
+    if (out->failed) SetLastError(ERROR_OUTOFMEMORY);
+    else if (out->len || final) ret = CryptMsgBase_StreamOut(base, out->data ? out->data : (BYTE *)"", out->len, final);
+    out->len = 0;
+    out->failed = FALSE;
+    return ret;
+}
+
+/* the byte range [*start, *end) of item "index" of the SEQUENCE at der, and the end of its content */
+static BOOL sg_der_item(const BYTE *der, DWORD size, DWORD index, DWORD *start, DWORD *end, DWORD *content_end)
+{
+    DWORD hdr, len, pos, i;
+
+    if (!sg_der_header(der, size, &hdr, &len) || der[0] != 0x30) return FALSE;
+    *content_end = hdr + len;
+    for (pos = hdr, i = 0; pos < *content_end; i++)
+    {
+        DWORD h, l;
+
+        if (!sg_der_header(der + pos, *content_end - pos, &h, &l)) return FALSE;
+        if (i == index)
+        {
+            *start = pos;
+            *end = pos + h + l;
+            return TRUE;
+        }
+        pos += h + l;
+    }
+    return FALSE;
+}
