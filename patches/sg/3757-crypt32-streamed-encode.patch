+/* The output of a streamed enveloped message: the version and recipient infos, then the
+ * encrypted content info with its content encryption algorithm, then the cipher text in chunks
+ * of an indefinite-length string (a block cipher's blocks, the padding with the last one). */
+static BOOL CEnvelopedEncodeMsg_StreamOut(CEnvelopedEncodeMsg *msg, const BYTE *pbData, DWORD cbData, BOOL fFinal)
+{
+    BOOL bare = msg->base.open_flags & CMSG_BARE_CONTENT_FLAG, ret = TRUE;
+    BYTE lenbuf[8], *buf = NULL;
+    CSgOut out = { 0 };
+    DWORD block = 0, n, avail, size, cap;
+
+    if (msg->base.state == MsgStateInit)
+    {
+        char oid_rsa_data[] = szOID_RSA_data;
+        CRYPT_ENVELOPED_DATA envelopedData = {
+         CMSG_ENVELOPED_DATA_PKCS_1_5_VERSION, msg->cRecipientInfo, msg->recipientInfo,
+         { oid_rsa_data, { msg->algo.pszObjId, { msg->algo.Parameters.cbData, msg->algo.Parameters.pbData } },
+           { 0, NULL } }
+        };
+        DWORD len = 0, s0, e0, s1, e1, s2, e2, content_end, hdr, clen;
+        BYTE *der = NULL;
+
+        ret = CRYPT_AsnEncodePKCSEnvelopedData(&envelopedData, NULL, &len);
+        if (ret && (der = CryptMemAlloc(len)))
+            ret = CRYPT_AsnEncodePKCSEnvelopedData(&envelopedData, der, &len);
+        else
+            ret = FALSE;
+        if (!ret || !sg_der_item(der, len, 0, &s0, &e0, &content_end) || !sg_der_item(der, len, 1, &s1, &e1, &content_end) ||
+            !sg_der_item(der, len, 2, &s2, &e2, &content_end) || !sg_der_header(der + s2, e2 - s2, &hdr, &clen))
+        {
+            if (ret) SetLastError(CRYPT_E_ASN1_INTERNAL);
+            CryptMemFree(der);
+            return FALSE;
+        }
+        if (!bare)
+        {
+            sg_out_add(&out, "\x30\x80", 2);
+            sg_out_add(&out, sg_oid_enveloped_data, sizeof(sg_oid_enveloped_data));
+            sg_out_add(&out, "\xa0\x80", 2);
+        }
+        sg_out_add(&out, "\x30\x80", 2);
+        sg_out_add(&out, der + s0, e1 - s0);                 /* version, recipient infos */
+        sg_out_add(&out, "\x30\x80", 2);
+        {
+            DWORD h0, l0, h1, l1;
+
+            /* content type, content encryption algorithm (not the empty encrypted content that follows) */
+            if (!sg_der_header(der + s2 + hdr, clen, &h0, &l0) ||
+                !sg_der_header(der + s2 + hdr + h0 + l0, clen - h0 - l0, &h1, &l1))
+            {
+                SetLastError(CRYPT_E_ASN1_INTERNAL);
+                CryptMemFree(der);
+                return FALSE;
+            }
+            sg_out_add(&out, der + s2 + hdr, h0 + l0 + h1 + l1);
+        }
+        sg_out_add(&out, "\xa0\x80", 2);                     /* the encrypted content */
+        CryptMemFree(der);
+        ret = sg_out_flush(&msg->base, &out, FALSE);
+    }
+
+    if (ret)
+    {
+        DWORD bits = 0, bsize = sizeof(bits);
+
