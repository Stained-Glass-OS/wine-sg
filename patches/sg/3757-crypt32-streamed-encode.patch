+/* The output of a streamed signed message: see sg_oid_signed_data above.  The pieces between
+ * the containers come from the encoding of the message with no content: its version and digest
+ * algorithms before the content, its certificates, CRLs and signer infos after it. */
+static BOOL CSignedEncodeMsg_StreamOut(CSignedEncodeMsg *msg, const BYTE *pbData, DWORD cbData, BOOL fFinal)
+{
+    BOOL detached = msg->base.open_flags & CMSG_DETACHED_FLAG, bare = msg->base.open_flags & CMSG_BARE_CONTENT_FLAG;
+    BOOL indefinite = msg->base.stream_info.cbContent == 0xffffffff;
+    CRYPT_SIGNED_INFO info = *msg->msg_data.info;
+    char oid_rsa_data[] = szOID_RSA_data;
+    BYTE *der = NULL, lenbuf[8];
+    DWORD size = 0, s0, e0, s1, e1, s2, e2, content_end, n;
+    CSgOut out = { 0 };
+    BOOL ret;
+
+    info.content.pszObjId = oid_rsa_data;
+    info.content.Content.cbData = 0;
+    info.content.Content.pbData = NULL;
+    if (msg->base.state == MsgStateInit || fFinal)   /* the pieces are needed at the first and the last update */
+    {
+        ret = CRYPT_AsnEncodeCMSSignedInfo(&info, NULL, &size);
+        if (ret && (der = CryptMemAlloc(size)))
+            ret = CRYPT_AsnEncodeCMSSignedInfo(&info, der, &size);
+        else
+            ret = FALSE;
+        if (!ret || !sg_der_item(der, size, 0, &s0, &e0, &content_end) ||
+            !sg_der_item(der, size, 1, &s1, &e1, &content_end) || !sg_der_item(der, size, 2, &s2, &e2, &content_end))
+        {
+            if (ret) SetLastError(CRYPT_E_ASN1_INTERNAL);
+            CryptMemFree(der);
+            return FALSE;
+        }
+    }
+    ret = TRUE;
+
+    if (msg->base.state == MsgStateInit)
+    {
+        if (!bare)
+        {
+            sg_out_add(&out, "\x30\x80", 2);
+            sg_out_add(&out, sg_oid_signed_data, sizeof(sg_oid_signed_data));
+            sg_out_add(&out, "\xa0\x80", 2);
+        }
+        sg_out_add(&out, "\x30\x80", 2);
+        sg_out_add(&out, der + s0, e1 - s0);   /* version, digest algorithms */
+        if (detached)
+        {
+            sg_out_add(&out, "\x30\x0b", 2);
+            sg_out_add(&out, sg_oid_data, sizeof(sg_oid_data));
+        }
+        else
+        {
+            sg_out_add(&out, "\x30\x80", 2);
+            sg_out_add(&out, sg_oid_data, sizeof(sg_oid_data));
+            sg_out_add(&out, "\xa0\x80", 2);
+            if (indefinite)
+                sg_out_add(&out, "\x24\x80", 2);
+            else
+            {
+                sg_out_add(&out, "\x04", 1);
+                n = sg_ber_length(lenbuf, msg->base.stream_info.cbContent);
+                sg_out_add(&out, lenbuf, n);
+            }
+        }
+        ret = sg_out_flush(&msg->base, &out, FALSE);
+    }
+    if (ret && !detached)
+    {
+        if (msg->streamed_total + cbData < msg->streamed_total ||
+            (!indefinite && msg->streamed_total + cbData > msg->base.stream_info.cbContent))
+        {
+            SetLastError(E_INVALIDARG);   /* more content than cbContent said */
+            ret = FALSE;
+        }
+        else if (cbData)
+        {
+            if (indefinite)
+            {
+                sg_out_add(&out, "\x04", 1);
+                n = sg_ber_length(lenbuf, cbData);
+                sg_out_add(&out, lenbuf, n);
+                ret = sg_out_flush(&msg->base, &out, FALSE);
+            }
+            if (ret) ret = CryptMsgBase_StreamOut(&msg->base, pbData, cbData, FALSE);
+            msg->streamed_total += cbData;
+        }
+    }
+    if (ret && fFinal)
+    {
+        if (!detached && !indefinite && msg->streamed_total != msg->base.stream_info.cbContent)
+        {
+            SetLastError(CRYPT_E_STREAM_INSUFFICIENT_DATA);   /* less than cbContent said */
+            ret = FALSE;
+        }
+        else
+        {
+            if (!detached)
+            {
+                if (indefinite) sg_out_add(&out, "\x00\x00", 2);   /* the OCTET STRING */
+                sg_out_add(&out, "\x00\x00\x00\x00", 4);           /* [0] and the content info */
+            }
+            sg_out_add(&out, der + e2, content_end - e2);          /* certificates, CRLs, signer infos */
+            sg_out_add(&out, "\x00\x00", 2);                       /* SignedData */
+            if (!bare) sg_out_add(&out, "\x00\x00\x00\x00", 4);    /* [0] and the outer content info */
+            ret = sg_out_flush(&msg->base, &out, TRUE);
+        }
+    }
+    sg_out_free(&out);
+    CryptMemFree(der);
+    return ret;
+}
