From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: IShellExtInit and IObjectWithSite of the context menus, help text (3702)

shell32: IShellExtInit and IObjectWithSite of the context menus, help text

The item context menu's IShellExtInit::Initialize takes a folder or a data
object with a shell id list and makes the menu for those items; its
IObjectWithSite keeps the site, passes it to the menu handlers it loads, and
GetSite answers E_FAIL without one. The New menu keeps its site too, validates
commands, gives their help text and answers the menu messages that need no
work. The folder background menu gives help text for Paste and Properties,
and the compressed folder's menu validates commands and gives verbs and help.
---
diff --git a/dlls/shell32/new_menu.c b/dlls/shell32/new_menu.c
index 95d0bd9..fa8e8b2 100644
--- a/dlls/shell32/new_menu.c
+++ b/dlls/shell32/new_menu.c
@@ -42,6 +42,7 @@ struct new_menu
     size_t item_count;
 
     ITEMIDLIST *pidl;
+    IUnknown *site;
 };
 
 static struct new_menu *impl_from_IShellExtInit(IShellExtInit *iface)
@@ -97,6 +98,7 @@ static ULONG WINAPI ext_init_Release(IShellExtInit *iface)
             free(menu->items[i].name);
         free(menu->items);
         ILFree(menu->pidl);
+        if (menu->site) IUnknown_Release(menu->site);
         free(menu);
     }
 
@@ -315,26 +317,66 @@ static HRESULT WINAPI context_menu_InvokeCommand(IContextMenu3 *iface, CMINVOKEC
 static HRESULT WINAPI context_menu_GetCommandString(IContextMenu3 *iface,
         UINT_PTR id, UINT type, UINT *reserved, char *string, UINT size)
 {
-    FIXME("iface %p, id %Iu, type %#x, reserved %p, string %p, size %u, stub!\n",
-            iface, id, type, reserved, string, size);
+    struct new_menu *menu = impl_from_IContextMenu3(iface);
+
+    TRACE("iface %p, id %Iu, type %#x, reserved %p, string %p, size %u.\n", iface, id, type, reserved, string, size);
+
+    /* command 0 is the New submenu itself; the items follow it */
+    switch (type)
+    {
+    case GCS_VALIDATEA:
+    case GCS_VALIDATEW:
+#ifdef SG_MUTANT_NM_VALID
+        return S_OK;
+#endif
+        return !HIWORD(id) && id >= 1 && id <= menu->item_count ? S_OK : S_FALSE;
+
+    case GCS_HELPTEXTA:
+    case GCS_HELPTEXTW:
+    {
+        const WCHAR *text;
+
+        if (HIWORD(id) || id < 1 || id > menu->item_count || !string) return E_INVALIDARG;
+        /* what the item makes: its name */
+        text = menu->items[id - 1].name;
+        if (type == GCS_HELPTEXTA) WideCharToMultiByte(CP_ACP, 0, text, -1, string, size, NULL, NULL);
+        else lstrcpynW((WCHAR *)string, text, size);
+        return S_OK;
+    }
 
-    return E_NOTIMPL;
+    case GCS_VERBA:
+    case GCS_VERBW:
+        /* the items have no named verb */
+        return E_NOTIMPL;
+    }
+    return E_INVALIDARG;
+}
+
+/* no item is owner-drawn: the menu has nothing to do for the menu messages */
+static BOOL new_menu_message(UINT msg)
+{
+    return msg == WM_INITMENUPOPUP || msg == WM_DRAWITEM || msg == WM_MEASUREITEM || msg == WM_MENUCHAR
+            || msg == WM_MENUSELECT;
 }
 
 static HRESULT WINAPI context_menu_HandleMenuMsg(IContextMenu3 *iface, UINT msg, WPARAM wparam, LPARAM lparam)
 {
-    FIXME("iface %p, msg %#x, wparam %#Ix, lparam %#Ix, stub!\n", iface, msg, wparam, lparam);
+    TRACE("iface %p, msg %#x, wparam %#Ix, lparam %#Ix.\n", iface, msg, wparam, lparam);
 
-    return E_NOTIMPL;
+    return new_menu_message(msg) ? S_OK : E_NOTIMPL;
 }
 
 static HRESULT WINAPI context_menu_HandleMenuMsg2(IContextMenu3 *iface,
         UINT msg, WPARAM wparam, LPARAM lparam, LRESULT *result)
 {
-    FIXME("iface %p, msg %#x, wparam %#Ix, lparam %#Ix, result %p, stub!\n",
-            iface, msg, wparam, lparam, result);
+    TRACE("iface %p, msg %#x, wparam %#Ix, lparam %#Ix, result %p.\n", iface, msg, wparam, lparam, result);
 
-    return E_NOTIMPL;
+    if (!new_menu_message(msg)) return E_NOTIMPL;
+    /* a mnemonic that is pressed finds no item here */
+#ifndef SG_MUTANT_NM_MSG
+    if (result) *result = msg == WM_MENUCHAR ? MAKELRESULT(0, MNC_IGNORE) : 0;
+#endif
+    return S_OK;
 }
 
 static const IContextMenu3Vtbl context_menu_vtbl =
@@ -377,16 +419,28 @@ static ULONG WINAPI object_with_site_Release(IObjectWithSite *iface)
 
 static HRESULT WINAPI object_with_site_SetSite(IObjectWithSite *iface, IUnknown *site)
 {
-    FIXME("iface %p, site %p, stub!\n", iface, site);
+    struct new_menu *menu = impl_from_IObjectWithSite(iface);
+
+    TRACE("iface %p, site %p.\n", iface, site);
 
-    return E_NOTIMPL;
+#ifndef SG_MUTANT_NM_SITE
+    if (site) IUnknown_AddRef(site);
+#endif
+    if (menu->site) IUnknown_Release(menu->site);
+    menu->site = site;
+    return S_OK;
 }
 
 static HRESULT WINAPI object_with_site_GetSite(IObjectWithSite *iface, REFIID iid, void **out)
 {
-    FIXME("iface %p, iid %s, out %p, stub!\n", iface, debugstr_guid(iid), out);
+    struct new_menu *menu = impl_from_IObjectWithSite(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
 
-    return E_NOTIMPL;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!menu->site) return E_FAIL;
+    return IUnknown_QueryInterface(menu->site, iid, out);
 }
 
 static const IObjectWithSiteVtbl object_with_site_vtbl =
diff --git a/dlls/shell32/shell32.rc b/dlls/shell32/shell32.rc
index ef83803..135ce06 100644
--- a/dlls/shell32/shell32.rc
+++ b/dlls/shell32/shell32.rc
@@ -241,6 +241,8 @@ the folder?"
         IDS_NEW_MENU_FOLDER         "New &Folder"
         IDS_RECYCLEBIN_RESTORE_HELP "Restores the selected items to their original locations."
         IDS_RECYCLEBIN_ERASE_HELP   "Permanently deletes the selected items."
+        IDS_CMENU_PASTE_HELP        "Inserts the contents of the Clipboard here."
+        IDS_CMENU_PROPERTIES_HELP   "Shows the properties of this folder."
 
 	IDS_CPANEL_TITLE            "Control Panel"
 	IDS_CPANEL_NAME             "Name"
diff --git a/dlls/shell32/shlview_cmenu.c b/dlls/shell32/shlview_cmenu.c
index aea73d9..b2bdb8a 100644
--- a/dlls/shell32/shlview_cmenu.c
+++ b/dlls/shell32/shlview_cmenu.c
@@ -94,6 +94,8 @@ typedef struct
      * each with the commands it took */
     struct ext_handler { IContextMenu *cm; UINT first, count; } ext[MAX_EXT];
     UINT ext_count;
+
+    IUnknown *site;      /* IObjectWithSite: the object the menu is shown for */
 } ContextMenu;
 
 static inline ContextMenu *impl_from_IContextMenu3(IContextMenu3 *iface)
@@ -177,6 +179,7 @@ static ULONG WINAPI ContextMenu_Release(IContextMenu3 *iface)
         SHELL_FreeSendToTargets(This->sendto);
         for (unsigned int i = 0; i < This->ext_count; ++i)
             IContextMenu_Release(This->ext[i].cm);
+        if (This->site) IUnknown_Release(This->site);
         free(This);
     }
 
@@ -310,6 +313,16 @@ static void ext_add_from(ContextMenu *This, const WCHAR *type, HMENU hmenu, UINT
         if (SUCCEEDED(hr)) hr = IShellExtInit_QueryInterface(init, &IID_IContextMenu, (void **)&cm);
         IShellExtInit_Release(init);
         if (FAILED(hr)) continue;
+        if (This->site)
+        {
+            IObjectWithSite *ows;
+
+            if (SUCCEEDED(IContextMenu_QueryInterface(cm, &IID_IObjectWithSite, (void **)&ows)))
+            {
+                IObjectWithSite_SetSite(ows, This->site);
+                IObjectWithSite_Release(ows);
+            }
+        }
         before = GetMenuItemCount(hmenu);
         hr = IContextMenu_QueryContextMenu(cm, hmenu, *pos, idCmdFirst + *next, idCmdLast, flags);
         if (FAILED(hr))
@@ -1734,6 +1747,8 @@ static const IContextMenu3Vtbl ItemContextMenuVtbl =
     ContextMenu_HandleMenuMsg2
 };
 
+static void build_verb_list(ContextMenu *menu);
+
 static HRESULT WINAPI ShellExtInit_QueryInterface(IShellExtInit *iface, REFIID riid, void **obj)
 {
     ContextMenu *This = impl_from_IShellExtInit(iface);
@@ -1756,10 +1771,66 @@ static HRESULT WINAPI ShellExtInit_Initialize(IShellExtInit *iface, LPCITEMIDLIS
     IDataObject *dataobj, HKEY progidkey)
 {
     ContextMenu *This = impl_from_IShellExtInit(iface);
+    LPITEMIDLIST pidl = NULL, *apidl = NULL;
+    IShellFolder *parent = NULL;
+    UINT cidl = 0, i;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p %p %p)\n", This, folder, dataobj, progidkey);
+
+    if (!folder && !dataobj) return E_INVALIDARG;
+
+    if (dataobj)
+    {
+        /* the items are the shell id list the data object carries: a folder and its items */
+        FORMATETC fmt = { 0, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+        STGMEDIUM med;
+        CIDA *cida;
+
+        fmt.cfFormat = RegisterClipboardFormatW(CFSTR_SHELLIDLISTW);
+        if (FAILED(hr = IDataObject_GetData(dataobj, &fmt, &med))) return hr;
+        if (!(cida = GlobalLock(med.hGlobal))) { ReleaseStgMedium(&med); return E_FAIL; }
+        pidl = ILClone((LPCITEMIDLIST)((BYTE *)cida + cida->aoffset[0]));
+        cidl = cida->cidl;
+        if (cidl && !(apidl = calloc(cidl, sizeof(*apidl)))) hr = E_OUTOFMEMORY;
+        for (i = 0; apidl && i < cidl; i++) apidl[i] = ILClone((LPCITEMIDLIST)((BYTE *)cida + cida->aoffset[i + 1]));
+        GlobalUnlock(med.hGlobal);
+        ReleaseStgMedium(&med);
+        if (hr == E_OUTOFMEMORY) { ILFree(pidl); return hr; }
+    }
+    else if (!(pidl = ILClone(folder))) return E_OUTOFMEMORY;
 
-    FIXME("(%p)->(%p %p %p): stub\n", This, folder, dataobj, progidkey);
+    if (!pidl || FAILED(hr = SHBindToObject(NULL, pidl, NULL, &IID_IShellFolder, (void **)&parent)))
+    {
+        ILFree(pidl);
+        _ILFreeaPidl(apidl, cidl);
+        return pidl ? hr : E_FAIL;
+    }
 
-    return E_NOTIMPL;
+#ifdef SG_MUTANT_CM_INIT
+    ILFree(pidl);
+    _ILFreeaPidl(apidl, cidl);
+    IShellFolder_Release(parent);
+    return S_OK;
+#endif
+    /* the menu is now for these items */
+    if (This->parent) IShellFolder_Release(This->parent);
+    SHFree(This->pidl);
+    _ILFreeaPidl(This->apidl, This->cidl);
+    This->parent = parent;
+    This->pidl = pidl;
+    This->apidl = apidl;
+    This->cidl = cidl;
+    for (i = 0; i < This->verb_count; ++i)
+    {
+        free(This->verbs[i].desc);
+        free(This->verbs[i].verb);
+    }
+    free(This->verbs);
+    This->verbs = NULL;
+    This->verb_count = 0;
+    build_verb_list(This);
+    return S_OK;
 }
 
 static const IShellExtInitVtbl ShellExtInitVtbl =
@@ -1791,19 +1862,40 @@ static ULONG WINAPI ObjectWithSite_Release(IObjectWithSite *iface)
 static HRESULT WINAPI ObjectWithSite_SetSite(IObjectWithSite *iface, IUnknown *site)
 {
     ContextMenu *This = impl_from_IObjectWithSite(iface);
+    UINT i;
 
-    FIXME("(%p)->(%p): stub\n", This, site);
+    TRACE("(%p)->(%p)\n", This, site);
 
-    return E_NOTIMPL;
+    if (site) IUnknown_AddRef(site);
+    if (This->site) IUnknown_Release(This->site);
+    This->site = site;
+    /* the handlers the menu has taken in work for the same site */
+    for (i = 0; i < This->ext_count; i++)
+    {
+        IObjectWithSite *ows;
+
+        if (SUCCEEDED(IContextMenu_QueryInterface(This->ext[i].cm, &IID_IObjectWithSite, (void **)&ows)))
+        {
+            IObjectWithSite_SetSite(ows, site);
+            IObjectWithSite_Release(ows);
+        }
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI ObjectWithSite_GetSite(IObjectWithSite *iface, REFIID riid, void **site)
 {
     ContextMenu *This = impl_from_IObjectWithSite(iface);
 
-    FIXME("(%p)->(%s %p): stub\n", This, debugstr_guid(riid), site);
+    TRACE("(%p)->(%s %p)\n", This, debugstr_guid(riid), site);
 
-    return E_NOTIMPL;
+    if (!site) return E_POINTER;
+    *site = NULL;
+#ifdef SG_MUTANT_CM_SITE
+    return E_FAIL;
+#endif
+    if (!This->site) return E_FAIL;
+    return IUnknown_QueryInterface(This->site, riid, site);
 }
 
 static const IObjectWithSiteVtbl ObjectWithSiteVtbl =
@@ -2274,8 +2366,25 @@ static HRESULT WINAPI BackgroundMenu_GetCommandString(
     {
     case GCS_HELPTEXTA:
     case GCS_HELPTEXTW:
-        hr = E_NOTIMPL;
+    {
+        UINT str = 0;
+        WCHAR help[128];
+
+        switch (idCommand + FCIDM_BASE)
+        {
+        case FCIDM_SHVIEW_INSERT: str = IDS_CMENU_PASTE_HELP; break;
+        case FCIDM_SHVIEW_PROPERTIES: str = IDS_CMENU_PROPERTIES_HELP; break;
+        }
+#ifdef SG_MUTANT_BG_HELP
+        str = 0;
+#endif
+        if (!str || !lpszName) { hr = E_INVALIDARG; break; }
+        if (!LoadStringW(shell32_hInstance, str, help, ARRAY_SIZE(help))) { hr = E_FAIL; break; }
+        if (uFlags == GCS_HELPTEXTA) WideCharToMultiByte(CP_ACP, 0, help, -1, lpszName, uMaxNameLen, NULL, NULL);
+        else lstrcpynW((WCHAR *)lpszName, help, uMaxNameLen);
+        hr = S_OK;
         break;
+    }
 
     case GCS_VERBA:
     case GCS_VERBW:
diff --git a/dlls/shell32/shresdef.h b/dlls/shell32/shresdef.h
index 4215682..09cf9f7 100644
--- a/dlls/shell32/shresdef.h
+++ b/dlls/shell32/shresdef.h
@@ -142,6 +142,8 @@
 #define IDS_NEW_MENU_FOLDER         180
 #define IDS_RECYCLEBIN_RESTORE_HELP 181
 #define IDS_RECYCLEBIN_ERASE_HELP   182
+#define IDS_CMENU_PASTE_HELP        183
+#define IDS_CMENU_PROPERTIES_HELP   184
 
 #define IDS_LICENSE                 256
 #define IDS_LICENSE_CAPTION         257
diff --git a/dlls/shell32/zipfolder.c b/dlls/shell32/zipfolder.c
index 1587e67..ef8ea57 100644
--- a/dlls/shell32/zipfolder.c
+++ b/dlls/shell32/zipfolder.c
@@ -1796,10 +1796,39 @@ static HRESULT WINAPI zipmenu_InvokeCommand( IContextMenu *iface, CMINVOKECOMMAN
 static HRESULT WINAPI zipmenu_GetCommandString( IContextMenu *iface, UINT_PTR cmd, UINT type, UINT *reserved,
                                                 char *name, UINT len )
 {
-    if (cmd >= ARRAY_SIZE(zipmenu_verbs)) return E_INVALIDARG;
-    if (type == GCS_VERBW) lstrcpynW( (WCHAR *)name, zipmenu_verbs[cmd], len );
-    else if (type == GCS_VERBA) WideCharToMultiByte( CP_ACP, 0, zipmenu_verbs[cmd], -1, name, len, NULL, NULL );
-    else return E_NOTIMPL;
+    static const WCHAR *helps[] = { L"Opens the selected item.", L"Copies the selected items.",
+                                    L"Deletes the selected items from the archive." };
+    const WCHAR *text;
+    UINT i;
+
+    switch (type)
+    {
+    case GCS_VALIDATEA:
+    case GCS_VALIDATEW:
+        if (!HIWORD( cmd )) return cmd < ARRAY_SIZE(zipmenu_verbs) ? S_OK : S_FALSE;
+        for (i = 0; i < ARRAY_SIZE(zipmenu_verbs); i++)
+        {
+            WCHAR verb[32];
+
+            if (type == GCS_VALIDATEA) MultiByteToWideChar( CP_ACP, 0, (const char *)cmd, -1, verb, ARRAY_SIZE(verb) );
+            else lstrcpynW( verb, (const WCHAR *)cmd, ARRAY_SIZE(verb) );
+            if (!lstrcmpiW( verb, zipmenu_verbs[i] )) return S_OK;
+        }
+        return S_FALSE;
+    case GCS_VERBA:
+    case GCS_VERBW:
+        text = cmd < ARRAY_SIZE(zipmenu_verbs) ? zipmenu_verbs[cmd] : NULL;
+        break;
+    case GCS_HELPTEXTA:
+    case GCS_HELPTEXTW:
+        text = cmd < ARRAY_SIZE(helps) ? helps[cmd] : NULL;
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    if (!text || !name) return E_INVALIDARG;
+    if (type == GCS_VERBW || type == GCS_HELPTEXTW) lstrcpynW( (WCHAR *)name, text, len );
+    else WideCharToMultiByte( CP_ACP, 0, text, -1, name, len, NULL, NULL );
     return S_OK;
 }
 
