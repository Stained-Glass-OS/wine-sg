From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] jscript, vbscript: a long-running script asks its host
 whether to go on

---
 dlls/jscript/engine.c    | 32 ++++++++++++++++++++++++++++++++
 dlls/jscript/jscript.c   |  7 +++++++
 dlls/jscript/jscript.h   |  5 +++++
 dlls/vbscript/interp.c   |  5 +++++
 dlls/vbscript/vbscript.c | 37 +++++++++++++++++++++++++++++++++++++
 dlls/vbscript/vbscript.h |  7 +++++++
 6 files changed, 93 insertions(+)

diff --git a/dlls/jscript/engine.c b/dlls/jscript/engine.c
index fc89801..655d0f0 100644
--- a/dlls/jscript/engine.c
+++ b/dlls/jscript/engine.c
@@ -3300,6 +3300,34 @@ static HRESULT take_interrupt(script_ctx_t *ctx)
     return ctx->interrupt_hres;
 }
 
+/* Stained Glass OS (wine-sg 7831): a long-running script asks its host whether to go on, as Windows'
+ * engines do: about once a second, IActiveScriptSiteInterruptPoll::QueryContinue on the site; S_FALSE
+ * stops the script as an interrupt without an exception does (a host's "stop this script?"). */
+static void poll_host(script_ctx_t *ctx)
+{
+    DWORD now = GetTickCount();
+    HRESULT hres;
+
+    if(now - ctx->poll_tick < 1000)
+        return;
+    ctx->poll_tick = now;
+    if(!ctx->interrupt_poll_queried) {
+        ctx->interrupt_poll_queried = TRUE;
+        if(!ctx->site || FAILED(IActiveScriptSite_QueryInterface(ctx->site, &IID_IActiveScriptSiteInterruptPoll,
+                                                                 (void**)&ctx->interrupt_poll)))
+            ctx->interrupt_poll = NULL;
+    }
+    if(!ctx->interrupt_poll)
+        return;
+    hres = IActiveScriptSiteInterruptPoll_QueryContinue(ctx->interrupt_poll);
+    TRACE("QueryContinue: %08lx\n", hres);
+    if(hres == S_FALSE) {
+        ctx->interrupt_hres = E_ABORT;
+        ctx->interrupt_flags = 0;
+        InterlockedExchange(&ctx->interrupt_pending, 1);
+    }
+}
+
 static HRESULT enter_bytecode(script_ctx_t *ctx, jsval_t *r)
 {
     call_frame_t *frame;
@@ -3311,6 +3339,10 @@ static HRESULT enter_bytecode(script_ctx_t *ctx, jsval_t *r)
     while(1) {
         frame = ctx->call_ctx;
         op = frame->bytecode->instrs[frame->ip].op;
+#ifndef SG_MUTANT_JS_NO_INTERRUPT_POLL
+        if(!(++ctx->poll_count & 0x3fff))
+            poll_host(ctx);
+#endif
         if(ctx->aborting || ctx->interrupt_pending)
             hres = take_interrupt(ctx);
         else
diff --git a/dlls/jscript/jscript.c b/dlls/jscript/jscript.c
index 36576d4..6693a04 100644
--- a/dlls/jscript/jscript.c
+++ b/dlls/jscript/jscript.c
@@ -361,6 +361,7 @@ void enter_script(script_ctx_t *ctx, jsexcept_t *ei)
         /* an interrupt only applies to scripts that are running; drop stale requests */
         ctx->interrupt_pending = 0;
         ctx->aborting = FALSE;
+        ctx->poll_tick = GetTickCount();   /* the host is asked once the script has run a second */
     }
     TRACE("ctx %p ei %p prev %p\n", ctx, ei, ei->prev);
 }
@@ -598,6 +599,11 @@ static void decrease_state(JScript *This, SCRIPTSTATE state)
                 IActiveScriptSite_Release(This->ctx->site);
                 This->ctx->site = NULL;
             }
+            if(This->ctx->interrupt_poll) {
+                IActiveScriptSiteInterruptPoll_Release(This->ctx->interrupt_poll);
+                This->ctx->interrupt_poll = NULL;
+            }
+            This->ctx->interrupt_poll_queried = FALSE;
 
             script_globals_release(This->ctx);
             gc_run(This->ctx);
@@ -912,6 +918,7 @@ static HRESULT WINAPI JScript_SetScriptSite(IActiveScript *iface,
 
     IActiveScriptSite_AddRef(This->site);
     This->ctx->site = This->site;
+    This->ctx->interrupt_poll_queried = FALSE;   /* asked of the new site when a script runs long */
 
     if(This->is_initialized)
         change_state(This, SCRIPTSTATE_INITIALIZED);
diff --git a/dlls/jscript/jscript.h b/dlls/jscript/jscript.h
index 0d131d0..773d8ec 100644
--- a/dlls/jscript/jscript.h
+++ b/dlls/jscript/jscript.h
@@ -404,6 +404,11 @@ struct _script_ctx_t {
     DWORD interrupt_flags;
     HRESULT interrupt_hres;
     BOOL aborting;                 /* an interrupt without SCRIPTINTERRUPT_RAISEEXCEPTION unwinds all handlers */
+    /* Stained Glass OS (wine-sg 7831): the host's IActiveScriptSiteInterruptPoll, asked about once a
+     * second while a script runs (QueryContinue) */
+    IActiveScriptSiteInterruptPoll *interrupt_poll;
+    BOOL interrupt_poll_queried;
+    DWORD poll_count, poll_tick;
     IActiveScriptSite *site;
     IInternetHostSecurityManager *secmgr;
     DWORD safeopt;
diff --git a/dlls/vbscript/interp.c b/dlls/vbscript/interp.c
index 595c264..e57479b 100644
--- a/dlls/vbscript/interp.c
+++ b/dlls/vbscript/interp.c
@@ -2717,11 +2717,16 @@ static HRESULT exec_script_scoped(script_ctx_t *ctx, BOOL extern_caller, functio
         /* an interrupt only applies to scripts that are running; drop stale requests */
         ctx->interrupt_pending = 0;
         ctx->aborting = FALSE;
+        ctx->poll_tick = GetTickCount();   /* the host is asked once the script has run a second */
     }
     ctx->exec_top = &exec;
 
     while(exec.instr) {
         op = exec.instr->op;
+#ifndef SG_MUTANT_VBS_NO_INTERRUPT_POLL
+        if(!(++ctx->poll_count & 0x3fff))
+            poll_host(ctx);
+#endif
         if(ctx->interrupt_pending)
             hres = take_interrupt(ctx);
         else
diff --git a/dlls/vbscript/vbscript.c b/dlls/vbscript/vbscript.c
index 2f2a1aa..eed10e9 100644
--- a/dlls/vbscript/vbscript.c
+++ b/dlls/vbscript/vbscript.c
@@ -431,6 +431,11 @@ static void release_script(script_ctx_t *ctx)
         IActiveScriptSite_Release(ctx->site);
         ctx->site = NULL;
     }
+    if(ctx->interrupt_poll) {
+        IActiveScriptSiteInterruptPoll_Release(ctx->interrupt_poll);
+        ctx->interrupt_poll = NULL;
+    }
+    ctx->interrupt_poll_queried = FALSE;
 
     if(ctx->script_obj) {
         ScriptDisp *script_obj = ctx->script_obj;
@@ -828,6 +833,7 @@ static HRESULT WINAPI VBScript_SetScriptSite(IActiveScript *iface, IActiveScript
 
     This->ctx->site = pass;
     IActiveScriptSite_AddRef(This->ctx->site);
+    This->ctx->interrupt_poll_queried = FALSE;   /* asked of the new site when a script runs long */
 
     IActiveScriptSite_GetLCID(This->ctx->site, &lcid);
     This->ctx->lcid = IsValidLocale(lcid, 0) ? lcid : GetUserDefaultLCID();
@@ -1123,6 +1129,37 @@ static HRESULT WINAPI VBScript_GetScriptThreadState(IActiveScript *iface,
     return S_OK;
 }
 
+/* Stained Glass OS (wine-sg 7831): a long-running script asks its host whether to go on, as Windows'
+ * engines do: about once a second, IActiveScriptSiteInterruptPoll::QueryContinue on the site; S_FALSE
+ * stops the script as an interrupt without an exception does (a host's "stop this script?"). */
+void poll_host(script_ctx_t *ctx)
+{
+    DWORD now = GetTickCount();
+    HRESULT hres;
+
+    if(now - ctx->poll_tick < 1000)
+        return;
+    ctx->poll_tick = now;
+    if(!ctx->interrupt_poll_queried) {
+        ctx->interrupt_poll_queried = TRUE;
+        if(!ctx->site || FAILED(IActiveScriptSite_QueryInterface(ctx->site, &IID_IActiveScriptSiteInterruptPoll,
+                                                                 (void**)&ctx->interrupt_poll)))
+            ctx->interrupt_poll = NULL;
+    }
+    if(!ctx->interrupt_poll)
+        return;
+    hres = IActiveScriptSiteInterruptPoll_QueryContinue(ctx->interrupt_poll);
+    TRACE("QueryContinue: %08lx\n", hres);
+    if(hres == S_FALSE) {
+        EnterCriticalSection(&ctx->interrupt_cs);
+        clear_ei(&ctx->interrupt_ei);
+        ctx->interrupt_ei.scode = E_ABORT;
+        ctx->interrupt_flags = 0;
+        InterlockedExchange(&ctx->interrupt_pending, 1);
+        LeaveCriticalSection(&ctx->interrupt_cs);
+    }
+}
+
 /* Takes the interrupt requested by InterruptScriptThread: the error to raise in the running script
  * is recorded in ctx->ei. Without SCRIPTINTERRUPT_RAISEEXCEPTION the script is aborted: On Error
  * Resume Next does not resume it. */
diff --git a/dlls/vbscript/vbscript.h b/dlls/vbscript/vbscript.h
index 48338cf..6dee033 100644
--- a/dlls/vbscript/vbscript.h
+++ b/dlls/vbscript/vbscript.h
@@ -229,8 +229,15 @@ struct _script_ctx_t {
     DWORD interrupt_flags;
     EXCEPINFO interrupt_ei;
     BOOL aborting;   /* an interrupt without SCRIPTINTERRUPT_RAISEEXCEPTION unwinds all On Error handlers */
+    /* Stained Glass OS (wine-sg 7831): the host's IActiveScriptSiteInterruptPoll, asked about once a
+     * second while a script runs (QueryContinue) */
+    IActiveScriptSiteInterruptPoll *interrupt_poll;
+    BOOL interrupt_poll_queried;
+    DWORD poll_count, poll_tick;
 };
 
+void poll_host(script_ctx_t*);
+
 HRESULT init_global(script_ctx_t*);
 HRESULT init_err(script_ctx_t*);
 
-- 
