From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ddrawex: surfaces report their ddrawex DirectDraw; the factory enumerates

IDirectDrawSurface4::GetDDInterface and IDirectDrawSurface3::GetDDInterface
failed with E_FAIL ("has to be implemented in ddrawex"). They now return the
ddrawex wrapper around the ddraw.dll object that created the surface
(IDirectDraw4 for a version 4 surface, IDirectDraw2 for a version 3 one, as
ddraw.dll numbers them), found through a list of the wrappers the factory
made; dd_get_outer, declared but never defined, is that lookup.
IDirectDrawFactory::DirectDrawEnumerate returned E_FAIL; it enumerates the
drivers through ddraw's ANSI enumeration (the wide one is not implemented on
Windows either) and widens the strings for the caller's wide callback.
---
--- a/dlls/ddrawex/ddraw.c
+++ b/dlls/ddrawex/ddraw.c
@@ -31,6 +31,11 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(ddrawex);
 
+/* The wrappers made by the factory, so that a ddraw.dll DirectDraw object can be
+ * mapped back to the wrapper around it (IDirectDrawSurface::GetDDInterface). */
+static struct list ddrawex_list = LIST_INIT(ddrawex_list);
+static CRITICAL_SECTION ddrawex_list_cs = { NULL, -1, 0, 0, 0, 0 };
+
 static struct ddrawex *impl_from_IDirectDraw(IDirectDraw *iface)
 {
     return CONTAINING_RECORD(iface, struct ddrawex, IDirectDraw_iface);
@@ -164,6 +169,9 @@ static ULONG WINAPI ddrawex4_Release(IDirectDraw4 *iface)
 
     if (!refcount)
     {
+        EnterCriticalSection(&ddrawex_list_cs);
+        list_remove(&ddrawex->entry);
+        LeaveCriticalSection(&ddrawex_list_cs);
         IDirectDraw4_Release(ddrawex->parent);
         free(ddrawex);
     }
@@ -1441,6 +1449,10 @@ HRESULT WINAPI ddrawex_factory_CreateDirectDraw(IDirectDrawFactory *iface, GUID
     if (FAILED(hr = IDirectDraw_SetCooperativeLevel(&object->IDirectDraw_iface, window, coop_level)))
         goto err;
 
+    EnterCriticalSection(&ddrawex_list_cs);
+    list_add_tail(&ddrawex_list, &object->entry);
+    LeaveCriticalSection(&ddrawex_list_cs);
+
     *ddraw = &object->IDirectDraw_iface;
     IDirectDraw_Release(parent);
     return DD_OK;
@@ -1463,3 +1475,22 @@ IDirectDraw4 *dd_get_inner(IDirectDraw4 *outer)
         return NULL;
     return ddrawex->parent;
 }
+
+/* The wrapper around a ddraw.dll DirectDraw4 object, a new reference to its
+ * IDirectDraw4 interface; NULL if the factory made none. */
+IDirectDraw4 *dd_get_outer(IDirectDraw4 *inner)
+{
+    struct ddrawex *ddrawex;
+    IDirectDraw4 *outer = NULL;
+
+    EnterCriticalSection(&ddrawex_list_cs);
+    LIST_FOR_EACH_ENTRY(ddrawex, &ddrawex_list, struct ddrawex, entry)
+    {
+        if (ddrawex->parent != inner) continue;
+        outer = &ddrawex->IDirectDraw4_iface;
+        IDirectDraw4_AddRef(outer);
+        break;
+    }
+    LeaveCriticalSection(&ddrawex_list_cs);
+    return outer;
+}
--- a/dlls/ddrawex/ddrawex_private.h
+++ b/dlls/ddrawex/ddrawex_private.h
@@ -19,6 +19,8 @@
 #ifndef __WINE_DLLS_DDRAWEX_DDRAWEX_PRIVATE_H
 #define __WINE_DLLS_DDRAWEX_DDRAWEX_PRIVATE_H
 
+#include "wine/list.h"
+
 DEFINE_GUID(CLSID_DirectDrawFactory, 0x4fd2a832, 0x86c8, 0x11d0, 0x8f, 0xca, 0x0, 0xc0, 0x4f, 0xd9, 0x18, 0x9d);
 DEFINE_GUID(IID_IDirectDrawFactory, 0x4fd2a833, 0x86c8, 0x11d0, 0x8f, 0xca, 0x0, 0xc0, 0x4f, 0xd9, 0x18, 0x9d);
 
@@ -53,6 +55,7 @@ void DDSD2_to_DDSD(const DDSURFACEDESC2 *in, DDSURFACEDESC *out);
 
 struct ddrawex
 {
+    struct list entry;     /* in the list dd_get_outer searches */
     IDirectDraw IDirectDraw_iface;
     IDirectDraw2 IDirectDraw2_iface;
     IDirectDraw3 IDirectDraw3_iface;
--- a/dlls/ddrawex/main.c
+++ b/dlls/ddrawex/main.c
@@ -166,12 +166,33 @@ static ULONG WINAPI ddrawex_factory_Release(IDirectDrawFactory *iface)
     return refcount;
 }
 
+struct enum_wrapper_ctx
+{
+    LPDDENUMCALLBACKW cb;
+    void *ctx;
+};
+
+/* ddraw.dll's wide enumeration is not implemented (as on Windows), so the
+ * ANSI one is used and its strings widened for the wide callback */
+static BOOL WINAPI enum_wrapper(GUID *guid, char *desc, char *name, void *ctx)
+{
+    struct enum_wrapper_ctx *wrapper = ctx;
+    WCHAR descW[256], nameW[256];
+
+    MultiByteToWideChar(CP_ACP, 0, desc, -1, descW, ARRAY_SIZE(descW));
+    MultiByteToWideChar(CP_ACP, 0, name, -1, nameW, ARRAY_SIZE(nameW));
+    return wrapper->cb(guid, descW, nameW, wrapper->ctx);
+}
+
 static HRESULT WINAPI ddrawex_factory_DirectDrawEnumerate(IDirectDrawFactory *iface,
         LPDDENUMCALLBACKW cb, void *ctx)
 {
-    FIXME("iface %p, cb %p, ctx %p stub!\n", iface, cb, ctx);
+    struct enum_wrapper_ctx wrapper = { cb, ctx };
+
+    TRACE("iface %p, cb %p, ctx %p.\n", iface, cb, ctx);
 
-    return E_FAIL;
+    if (!cb) return DDERR_INVALIDPARAMS;
+    return DirectDrawEnumerateA(enum_wrapper, &wrapper);
 }
 
 static const IDirectDrawFactoryVtbl ddrawex_factory_vtbl =
--- a/dlls/ddrawex/surface.c
+++ b/dlls/ddrawex/surface.c
@@ -930,27 +930,57 @@ static HRESULT WINAPI ddrawex_surface3_UpdateOverlayZOrder(IDirectDrawSurface3 *
             flags, reference_impl ? &reference_impl->IDirectDrawSurface4_iface : NULL);
 }
 
-static HRESULT WINAPI ddrawex_surface4_GetDDInterface(IDirectDrawSurface4 *iface, void **ddraw)
+/* The DirectDraw object that created the surface: the ddrawex wrapper, not the
+ * ddraw.dll object under it. A surface made through IDirectDraw4 (or 7) reports
+ * IDirectDraw4; one made through IDirectDraw2/3 reports IDirectDraw2, the way
+ * ddraw.dll numbers them. */
+static HRESULT surface_get_dd_interface(struct ddrawex_surface *surface, BOOL v4, void **ddraw)
 {
-    FIXME("iface %p, ddraw %p stub!\n", iface, ddraw);
+    IDirectDraw4 *inner, *outer;
+    HRESULT hr;
 
-    /* This has to be implemented in ddrawex, ddraw's interface can't be used
-     * because it is pretty hard to tell which version of the ddraw interface
-     * is returned. */
+    if (!ddraw) return DDERR_INVALIDPARAMS;
     *ddraw = NULL;
 
-    return E_FAIL;
+    if (FAILED(hr = IDirectDrawSurface4_GetDDInterface(surface->parent, (void **)&inner)))
+        return hr;
+    outer = dd_get_outer(inner);
+    IDirectDraw4_Release(inner);
+    if (!outer) return E_FAIL;
+
+    if (v4)
+    {
+#ifdef SG_MUTANT_DDRAWEX_GETDD_INNER
+        IDirectDraw4_Release(outer);
+        IDirectDraw4_AddRef(inner);
+        *ddraw = inner;
+        return DD_OK;
+#endif
+        *ddraw = outer;
+        return DD_OK;
+    }
+
+    hr = IDirectDraw4_QueryInterface(outer, &IID_IDirectDraw2, ddraw);
+    IDirectDraw4_Release(outer);
+    return hr;
+}
+
+static HRESULT WINAPI ddrawex_surface4_GetDDInterface(IDirectDrawSurface4 *iface, void **ddraw)
+{
+    struct ddrawex_surface *surface = impl_from_IDirectDrawSurface4(iface);
+
+    TRACE("iface %p, ddraw %p.\n", iface, ddraw);
+
+    return surface_get_dd_interface(surface, TRUE, ddraw);
 }
 
 static HRESULT WINAPI ddrawex_surface3_GetDDInterface(IDirectDrawSurface3 *iface, void **ddraw)
 {
-    FIXME("iface %p, ddraw %p stub!\n", iface, ddraw);
+    struct ddrawex_surface *surface = impl_from_IDirectDrawSurface3(iface);
 
-    /* A thunk it pretty pointless for the same reason that relaying to
-     * ddraw.dll works badly. */
-    *ddraw = NULL;
+    TRACE("iface %p, ddraw %p.\n", iface, ddraw);
 
-    return E_FAIL;
+    return surface_get_dd_interface(surface, FALSE, ddraw);
 }
 
 static HRESULT WINAPI ddrawex_surface4_PageLock(IDirectDrawSurface4 *iface, DWORD flags)
--- a/dlls/ddrawex/tests/surface.c
+++ b/dlls/ddrawex/tests/surface.c
@@ -403,6 +403,73 @@ static void test_surface_from_dc4(void)
     IDirectDraw4_Release(dd4);
 }
 
+static BOOL CALLBACK enum_cb(GUID *guid, WCHAR *desc, WCHAR *name, void *ctx)
+{
+    (*(int *)ctx)++;
+    return TRUE;
+}
+
+static void test_get_dd_interface_and_enumerate(void)
+{
+    IDirectDrawSurface3 *surf3;
+    IDirectDrawSurface4 *surf4;
+    DDSURFACEDESC2 ddsd2;
+    IDirectDraw2 *dd2, *got2;
+    IDirectDraw4 *dd4, *got4;
+    IDirectDraw *dd1;
+    int count = 0;
+    HRESULT hr;
+
+    hr = IDirectDrawFactory_DirectDrawEnumerate(factory, enum_cb, &count);
+    ok(hr == S_OK, "DirectDrawEnumerate returned %#lx.\n", hr);
+    ok(count > 0, "no driver enumerated.\n");
+    hr = IDirectDrawFactory_DirectDrawEnumerate(factory, NULL, NULL);
+    ok(hr == DDERR_INVALIDPARAMS, "got %#lx.\n", hr);
+
+    dd1 = createDDraw();
+    hr = IDirectDraw_QueryInterface(dd1, &IID_IDirectDraw4, (void **)&dd4);
+    if (FAILED(hr))
+    {
+        win_skip("DirectDraw4 is not supported\n");
+        IDirectDraw_Release(dd1);
+        return;
+    }
+    hr = IDirectDraw_QueryInterface(dd1, &IID_IDirectDraw2, (void **)&dd2);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    IDirectDraw_Release(dd1);
+
+    memset(&ddsd2, 0, sizeof(ddsd2));
+    ddsd2.dwSize = sizeof(ddsd2);
+    ddsd2.dwFlags = DDSD_CAPS | DDSD_WIDTH | DDSD_HEIGHT;
+    ddsd2.dwWidth = 16;
+    ddsd2.dwHeight = 16;
+    ddsd2.ddsCaps.dwCaps = DDSCAPS_OFFSCREENPLAIN | DDSCAPS_SYSTEMMEMORY;
+    hr = IDirectDraw4_CreateSurface(dd4, &ddsd2, &surf4, NULL);
+    ok(hr == S_OK, "CreateSurface returned %#lx.\n", hr);
+
+    got4 = NULL;
+    hr = IDirectDrawSurface4_GetDDInterface(surf4, (void **)&got4);
+    ok(hr == S_OK, "GetDDInterface returned %#lx.\n", hr);
+    ok(got4 == dd4, "got %p, expected the wrapper %p.\n", got4, dd4);
+    if (got4) IDirectDraw4_Release(got4);
+
+    hr = IDirectDrawSurface4_QueryInterface(surf4, &IID_IDirectDrawSurface3, (void **)&surf3);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    got2 = NULL;
+    hr = IDirectDrawSurface3_GetDDInterface(surf3, (void **)&got2);
+    ok(hr == S_OK, "GetDDInterface returned %#lx.\n", hr);
+    ok(got2 == dd2, "got %p, expected the wrapper %p.\n", got2, dd2);
+    if (got2) IDirectDraw2_Release(got2);
+
+    hr = IDirectDrawSurface4_GetDDInterface(surf4, NULL);
+    ok(hr == DDERR_INVALIDPARAMS, "got %#lx.\n", hr);
+
+    IDirectDrawSurface3_Release(surf3);
+    IDirectDrawSurface4_Release(surf4);
+    IDirectDraw2_Release(dd2);
+    IDirectDraw4_Release(dd4);
+}
+
 START_TEST(surface)
 {
     IClassFactory *classfactory = NULL;
@@ -438,6 +505,7 @@ START_TEST(surface)
     SysVidMemTest();
     test_surface_from_dc3();
     test_surface_from_dc4();
+    test_get_dd_interface_and_enumerate();
 
     ref = IDirectDrawFactory_Release(factory);
     ok(ref == 0, "IDirectDrawFactory not cleanly released\n");
