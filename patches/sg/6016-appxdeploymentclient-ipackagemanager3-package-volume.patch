--- a/dlls/appxdeploymentclient/package.c
+++ b/dlls/appxdeploymentclient/package.c
@@ -27,6 +27,7 @@ struct package_manager
 {
     IPackageManager IPackageManager_iface;
     IPackageManager2 IPackageManager2_iface;
