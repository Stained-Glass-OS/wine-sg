     IPackageManager5 IPackageManager5_iface;
     IPackageManager6 IPackageManager6_iface;
     LONG ref;
@@ -60,6 +61,15 @@ static HRESULT WINAPI package_manager_QueryInterface( IPackageManager *iface, RE
         return S_OK;
     }
 
+#ifndef SG_MUTANT_PM3_NOINTERFACE
+    if (IsEqualGUID( iid, &IID_IPackageManager3 ))
+    {
+        *out = &impl->IPackageManager3_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+#endif
+
     if (IsEqualGUID( iid, &IID_IPackageManager5 ))
     {
         *out = &impl->IPackageManager5_iface;
@@ -100,7 +110,8 @@ static ULONG WINAPI package_manager_Release( IPackageManager *iface )
 
 static HRESULT WINAPI package_manager_GetIids( IPackageManager *iface, ULONG *iid_count, IID **iids )
 {
-    static const IID *const ids[] = { &IID_IPackageManager, &IID_IPackageManager2, &IID_IPackageManager5, &IID_IPackageManager6 };
+    static const IID *const ids[] = { &IID_IPackageManager, &IID_IPackageManager2, &IID_IPackageManager3, &IID_IPackageManager5,
+                                      &IID_IPackageManager6 };
     IID *list;
     ULONG i;
 
@@ -564,6 +575,235 @@ static const struct IPackageManager2Vtbl package_manager2_vtbl =
     package_manager2_StageUserDataAsync,
 };
 
+DEFINE_IINSPECTABLE( package_manager3, IPackageManager3, struct package_manager, IPackageManager_iface );
+
+/* Stained Glass OS: the volume methods. Packages go to one volume here, the system drive's. */
+static HRESULT WINAPI package_manager3_AddPackageVolumeAsync( IPackageManager3 *iface, HSTRING path,
+    IAsyncOperation_PackageVolume **operation )
+{
+    FIXME( "iface %p, path %s, operation %p: packages are kept on the system volume only\n", iface,
+           debugstr_hstring( path ), operation );
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    return HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED );
+}
+
+static HRESULT WINAPI package_manager3_AddPackageToVolumeAsync( IPackageManager3 *iface, IUriRuntimeClass *uri,
+    IIterable_Uri *dependencies, DeploymentOptions options, IPackageVolume *volume,
+    IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, uri %p, dependencies %p, options %#x, volume %p, operation %p.\n", iface, uri, dependencies,
+           options, volume, operation );
+
+    if (!operation) return E_POINTER;
+    if (options & DeploymentOptions_DevelopmentMode) return E_INVALIDARG;
+    if (!is_package_volume( volume )) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    return start_add( uri, dependencies, options, operation );
+}
+
+static HRESULT WINAPI package_manager3_ClearPackageStatus( IPackageManager3 *iface, HSTRING full_name, PackageStatus status )
+{
+    IPackage *package;
+    HRESULT hr;
+
+    TRACE( "iface %p, full_name %s, status %#x.\n", iface, debugstr_hstring( full_name ), status );
+
+    /* no status is recorded here (no license or tamper checks): a package that is there is OK */
+    if (!full_name) return E_INVALIDARG;
+    if (FAILED(hr = deployed_package_by_full_name( WindowsGetStringRawBuffer( full_name, NULL ), &package ))) return hr;
+    if (package) IPackage_Release( package );
+    return package ? S_OK : HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+}
+
+static HRESULT WINAPI package_manager3_RegisterPackageWithAppDataVolumeAsync( IPackageManager3 *iface, IUriRuntimeClass *uri,
+    IIterable_Uri *dependencies, DeploymentOptions options, IPackageVolume *volume,
+    IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    struct package_manager *impl = impl_from_IPackageManager3( iface );
+
+    TRACE( "iface %p, uri %p, dependencies %p, options %#x, volume %p, operation %p.\n", iface, uri, dependencies,
+           options, volume, operation );
+
+    if (!is_package_volume( volume )) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    return package_manager_RegisterPackageAsync( &impl->IPackageManager_iface, uri, dependencies, options, operation );
+}
+
+static HRESULT WINAPI package_manager3_FindPackageVolumeByName( IPackageManager3 *iface, HSTRING name, IPackageVolume **volume )
+{
+    IPackageVolume *own;
+    HSTRING own_name, mount;
+    INT32 by_name = 1, by_mount = 1;
+    HRESULT hr;
+
+    TRACE( "iface %p, name %s, volume %p.\n", iface, debugstr_hstring( name ), volume );
+
+    if (!volume) return E_POINTER;
+    *volume = NULL;
+    if (FAILED(hr = package_volume_create( &own ))) return hr;
+    if (SUCCEEDED(IPackageVolume_get_Name( own, &own_name )))
+    {
+        WindowsCompareStringOrdinal( own_name, name, &by_name );
+        WindowsDeleteString( own_name );
+    }
+    if (SUCCEEDED(IPackageVolume_get_MountPoint( own, &mount )))
+    {
+        const WCHAR *a = WindowsGetStringRawBuffer( mount, NULL ), *b = WindowsGetStringRawBuffer( name, NULL );
+        by_mount = wcsnicmp( a, b, 2 ) || (b[2] && (b[2] != '\\' || b[3]));
+        WindowsDeleteString( mount );
+    }
+#ifdef SG_MUTANT_PM3_VOLUME_ANY_NAME
+    by_name = 0;
+#endif
+    if (by_name && by_mount)
+    {
+        IPackageVolume_Release( own );
+        return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    }
+    *volume = own;
+    return S_OK;
+}
+
+static HRESULT WINAPI package_manager3_FindPackageVolumes( IPackageManager3 *iface, IIterable_PackageVolume **volumes )
+{
+    TRACE( "iface %p, volumes %p.\n", iface, volumes );
+    return package_volumes_create( volumes );
+}
+
+static HRESULT WINAPI package_manager3_GetDefaultPackageVolume( IPackageManager3 *iface, IPackageVolume **volume )
+{
+    TRACE( "iface %p, volume %p.\n", iface, volume );
+    return package_volume_create( volume );
+}
+
+static HRESULT nothing_to_move_work( const WCHAR *arg, DeploymentOptions options, WCHAR **error_text )
+{
+    IPackage *package;
+    HRESULT hr;
+
+    /* the package is on the one volume already */
+    if (FAILED(hr = deployed_package_by_full_name( arg, &package ))) return hr;
+    if (!package) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    IPackage_Release( package );
+    return S_OK;
+}
+
+static HRESULT not_supported_work( const WCHAR *arg, DeploymentOptions options, WCHAR **error_text )
+{
+    return HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED );
+}
+
+static HRESULT nothing_work( const WCHAR *arg, DeploymentOptions options, WCHAR **error_text )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI package_manager3_MovePackageToVolumeAsync( IPackageManager3 *iface, HSTRING full_name,
+    DeploymentOptions options, IPackageVolume *volume, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, full_name %s, options %#x, volume %p, operation %p.\n", iface, debugstr_hstring( full_name ),
+           options, volume, operation );
+
+    if (!operation) return E_POINTER;
+    if (!full_name) return E_INVALIDARG;
+    if (!is_package_volume( volume )) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    return start_one( nothing_to_move_work, WindowsGetStringRawBuffer( full_name, NULL ), options, operation );
+}
+
+static HRESULT WINAPI package_manager3_RemovePackageVolumeAsync( IPackageManager3 *iface, IPackageVolume *volume,
+    IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, volume %p, operation %p.\n", iface, volume, operation );
+
+    /* the system volume is not removed */
+    if (!operation) return E_POINTER;
+    return start_one( not_supported_work, L"", 0, operation );
+}
+
+static HRESULT WINAPI package_manager3_SetDefaultPackageVolume( IPackageManager3 *iface, IPackageVolume *volume )
+{
+    TRACE( "iface %p, volume %p.\n", iface, volume );
+
+    if (!volume) return E_INVALIDARG;
+    return is_package_volume( volume ) ? S_OK : HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+}
+
+static HRESULT WINAPI package_manager3_SetPackageStatus( IPackageManager3 *iface, HSTRING full_name, PackageStatus status )
+{
+    TRACE( "iface %p, full_name %s, status %#x.\n", iface, debugstr_hstring( full_name ), status );
+    FIXME( "the status is not recorded\n" );
+    return package_manager3_ClearPackageStatus( iface, full_name, status );
+}
+
+static HRESULT WINAPI package_manager3_SetPackageVolumeOfflineAsync( IPackageManager3 *iface, IPackageVolume *volume,
+    IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, volume %p, operation %p.\n", iface, volume, operation );
+
+    /* the system volume stays online */
+    if (!operation) return E_POINTER;
+    return start_one( not_supported_work, L"", 0, operation );
+}
+
+static HRESULT WINAPI package_manager3_SetPackageVolumeOnlineAsync( IPackageManager3 *iface, IPackageVolume *volume,
+    IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, volume %p, operation %p.\n", iface, volume, operation );
+
+    if (!operation) return E_POINTER;
+    if (!is_package_volume( volume )) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    return start_one( nothing_work, L"", 0, operation );
+}
+
+static HRESULT WINAPI package_manager3_StagePackageToVolumeAsync( IPackageManager3 *iface, IUriRuntimeClass *uri,
+    IIterable_Uri *dependencies, DeploymentOptions options, IPackageVolume *volume,
+    IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, uri %p, dependencies %p, options %#x, volume %p, operation %p.\n", iface, uri, dependencies,
+           options, volume, operation );
+
+    if (!operation) return E_POINTER;
+    if (options & DeploymentOptions_DevelopmentMode) return E_INVALIDARG;
+    if (!is_package_volume( volume )) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    return start_add( uri, dependencies, options | DEPLOY_STAGE_ONLY, operation );
+}
+
+static HRESULT WINAPI package_manager3_StageUserDataWithOptionsAsync( IPackageManager3 *iface, HSTRING full_name,
+    DeploymentOptions options, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, full_name %s, options %#x, operation %p.\n", iface, debugstr_hstring( full_name ), options, operation );
+
+    if (!operation) return E_POINTER;
+    if (!full_name) return E_INVALIDARG;
+    return start_one( stage_user_data_work, WindowsGetStringRawBuffer( full_name, NULL ), options, operation );
+}
+
+static const struct IPackageManager3Vtbl package_manager3_vtbl =
+{
+    package_manager3_QueryInterface,
+    package_manager3_AddRef,
+    package_manager3_Release,
+    /* IInspectable methods */
+    package_manager3_GetIids,
+    package_manager3_GetRuntimeClassName,
+    package_manager3_GetTrustLevel,
+    /* IPackageManager3 methods */
+    package_manager3_AddPackageVolumeAsync,
+    package_manager3_AddPackageToVolumeAsync,
+    package_manager3_ClearPackageStatus,
+    package_manager3_RegisterPackageWithAppDataVolumeAsync,
+    package_manager3_FindPackageVolumeByName,
+    package_manager3_FindPackageVolumes,
+    package_manager3_GetDefaultPackageVolume,
+    package_manager3_MovePackageToVolumeAsync,
+    package_manager3_RemovePackageVolumeAsync,
+    package_manager3_SetDefaultPackageVolume,
+    package_manager3_SetPackageStatus,
+    package_manager3_SetPackageVolumeOfflineAsync,
+    package_manager3_SetPackageVolumeOnlineAsync,
+    package_manager3_StagePackageToVolumeAsync,
+    package_manager3_StageUserDataWithOptionsAsync,
+};
+
 DEFINE_IINSPECTABLE( package_manager5, IPackageManager5, struct package_manager, IPackageManager_iface );
 
 /* One volume here; optional packages are not deployed with the main one. */
@@ -812,6 +1052,7 @@ static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInsp
 
     impl->IPackageManager_iface.lpVtbl = &package_manager_vtbl;
     impl->IPackageManager2_iface.lpVtbl = &package_manager2_vtbl;
+    impl->IPackageManager3_iface.lpVtbl = &package_manager3_vtbl;
     impl->IPackageManager5_iface.lpVtbl = &package_manager5_vtbl;
     impl->IPackageManager6_iface.lpVtbl = &package_manager6_vtbl;
     impl->ref = 1;
diff --git a/dlls/appxdeploymentclient/private.h b/dlls/appxdeploymentclient/private.h
index abed48f..13d9290 100644
--- a/dlls/appxdeploymentclient/private.h
+++ b/dlls/appxdeploymentclient/private.h
@@ -90,6 +90,10 @@ HRESULT deployed_packages( const WCHAR *user_sid, const WCHAR *name, const WCHAR
                            const WCHAR *family_name, PackageTypes types, IIterable_Package **out );
 HRESULT package_dependencies( const WCHAR *dependencies, IVectorView_Package **out );
 HRESULT deployed_package_by_full_name( const WCHAR *full_name, IPackage **out );
+/* Stained Glass OS: the one package volume, the system drive's (volume.c) */
+HRESULT package_volume_create( IPackageVolume **out );
+HRESULT package_volumes_create( IIterable_PackageVolume **out );
+BOOL is_package_volume( IPackageVolume *volume );
 
 /* A deployed package, as recorded for the user (deploy.c). */
 struct package_record
diff --git a/dlls/appxdeploymentclient/volume.c b/dlls/appxdeploymentclient/volume.c
new file mode 100644
index 0000000..12e0359
--- /dev/null
+++ b/dlls/appxdeploymentclient/volume.c
@@ -0,0 +1,453 @@
+/* WinRT Windows.Management.Deployment.PackageVolume (Stained Glass OS)
+ *
+ * Packages are deployed to one volume here: the system drive, whose package
+ * store is %ProgramFiles%\WindowsApps. PackageManager's volume methods
+ * (IPackageManager3) find it, and keep packages on it.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(appx);
+
+struct package_volume
+{
+    IPackageVolume IPackageVolume_iface;
+    LONG ref;
+};
+
+static inline struct package_volume *impl_from_IPackageVolume( IPackageVolume *iface )
+{
+    return CONTAINING_RECORD( iface, struct package_volume, IPackageVolume_iface );
+}
+
+static HRESULT WINAPI volume_QueryInterface( IPackageVolume *iface, REFIID iid, void **out )
+{
+    struct package_volume *impl = impl_from_IPackageVolume( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IPackageVolume ))
+    {
+        *out = &impl->IPackageVolume_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI volume_AddRef( IPackageVolume *iface )
+{
+    struct package_volume *impl = impl_from_IPackageVolume( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI volume_Release( IPackageVolume *iface )
+{
+    struct package_volume *impl = impl_from_IPackageVolume( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI volume_GetIids( IPackageVolume *iface, ULONG *count, IID **iids )
+{
+    IID *list;
+
+    if (!count || !iids) return E_POINTER;
+    if (!(list = CoTaskMemAlloc( sizeof(*list) ))) return E_OUTOFMEMORY;
+    list[0] = IID_IPackageVolume;
+    *count = 1;
+    *iids = list;
+    return S_OK;
+}
+
+static HRESULT WINAPI volume_GetRuntimeClassName( IPackageVolume *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Management.Deployment.PackageVolume";
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI volume_GetTrustLevel( IPackageVolume *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI volume_get_IsOffline( IPackageVolume *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI volume_get_IsSystemVolume( IPackageVolume *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = TRUE;
+    return S_OK;
+}
+
+/* the system drive's root, "C:\" */
+static void system_root( WCHAR *root )
+{
+    WCHAR dir[MAX_PATH];
+
+    if (!GetWindowsDirectoryW( dir, ARRAY_SIZE(dir) ) || dir[1] != ':') wcscpy( dir, L"C:" );
+    root[0] = dir[0];
+    root[1] = ':';
+    root[2] = '\\';
+    root[3] = 0;
+}
+
+static HRESULT WINAPI volume_get_MountPoint( IPackageVolume *iface, HSTRING *value )
+{
+    WCHAR root[4];
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    system_root( root );
+    return WindowsCreateString( root, wcslen( root ), value );
+}
+
+/* the volume's name, \\?\Volume{...}\ */
+static HRESULT WINAPI volume_get_Name( IPackageVolume *iface, HSTRING *value )
+{
+    WCHAR root[4], name[MAX_PATH];
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    system_root( root );
+    if (!GetVolumeNameForVolumeMountPointW( root, name, ARRAY_SIZE(name) )) wcscpy( name, root );
+    return WindowsCreateString( name, wcslen( name ), value );
+}
+
+static HRESULT WINAPI volume_get_PackageStorePath( IPackageVolume *iface, HSTRING *value )
+{
+    WCHAR path[MAX_PATH];
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    if (!ExpandEnvironmentStringsW( L"%ProgramFiles%\\WindowsApps", path, ARRAY_SIZE(path) )) return E_FAIL;
+    return WindowsCreateString( path, wcslen( path ), value );
+}
+
+static HRESULT WINAPI volume_get_SupportsHardLinks( IPackageVolume *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = TRUE;
+    return S_OK;
+}
+
+/* The volume's packages are the packages: the queries give vectors, which are not made here yet. */
+#define VOLUME_FIND_NOTIMPL( name, ... ) \
+    static HRESULT WINAPI volume_##name( IPackageVolume *iface, __VA_ARGS__, IVector_Package **packages ) \
+    { \
+        FIXME( "iface %p, packages %p: not implemented, use PackageManager's queries\n", iface, packages ); \
+        if (packages) *packages = NULL; \
+        return E_NOTIMPL; \
+    }
+
+static HRESULT WINAPI volume_FindPackages( IPackageVolume *iface, IVector_Package **packages )
+{
+    FIXME( "iface %p, packages %p: not implemented, use PackageManager's queries\n", iface, packages );
+    if (packages) *packages = NULL;
+    return E_NOTIMPL;
+}
+VOLUME_FIND_NOTIMPL( FindPackagesByNamePublisher, HSTRING name, HSTRING publisher )
+VOLUME_FIND_NOTIMPL( FindPackagesByPackageFamilyName, HSTRING family_name )
+VOLUME_FIND_NOTIMPL( FindPackagesWithPackageTypes, PackageTypes types )
+VOLUME_FIND_NOTIMPL( FindPackagesByNamePublisherWithPackagesTypes, PackageTypes types, HSTRING name, HSTRING publisher )
+VOLUME_FIND_NOTIMPL( FindPackagesByPackageFamilyNameWithPackageTypes, PackageTypes types, HSTRING family_name )
+VOLUME_FIND_NOTIMPL( FindPackageByPackageFullName, HSTRING full_name )
+VOLUME_FIND_NOTIMPL( FindPackagesByUserSecurityId, HSTRING sid )
+VOLUME_FIND_NOTIMPL( FindPackagesByUserSecurityIdNamePublisher, HSTRING sid, HSTRING name, HSTRING publisher )
+VOLUME_FIND_NOTIMPL( FindPackagesByUserSecurityIdPackageFamilyName, HSTRING sid, HSTRING family_name )
+VOLUME_FIND_NOTIMPL( FindPackagesByUserSecurityIdWithPackageTypes, HSTRING sid, PackageTypes types )
+VOLUME_FIND_NOTIMPL( FindPackagesByUserSecurityIdNamePublisherWithPackageTypes, HSTRING sid, PackageTypes types,
+                     HSTRING name, HSTRING publisher )
+VOLUME_FIND_NOTIMPL( FindPackagesByUserSecurityIdPackageFamilyNameWithPackagesTypes, HSTRING sid, PackageTypes types,
+                     HSTRING family_name )
+VOLUME_FIND_NOTIMPL( FindPackageByUserSecurityIdPackageFullName, HSTRING sid, HSTRING full_name )
+
+static const struct IPackageVolumeVtbl volume_vtbl =
+{
+    volume_QueryInterface,
+    volume_AddRef,
+    volume_Release,
+    volume_GetIids,
+    volume_GetRuntimeClassName,
+    volume_GetTrustLevel,
+    volume_get_IsOffline,
+    volume_get_IsSystemVolume,
+    volume_get_MountPoint,
+    volume_get_Name,
+    volume_get_PackageStorePath,
+    volume_get_SupportsHardLinks,
+    volume_FindPackages,
+    volume_FindPackagesByNamePublisher,
+    volume_FindPackagesByPackageFamilyName,
+    volume_FindPackagesWithPackageTypes,
+    volume_FindPackagesByNamePublisherWithPackagesTypes,
+    volume_FindPackagesByPackageFamilyNameWithPackageTypes,
+    volume_FindPackageByPackageFullName,
+    volume_FindPackagesByUserSecurityId,
+    volume_FindPackagesByUserSecurityIdNamePublisher,
+    volume_FindPackagesByUserSecurityIdPackageFamilyName,
+    volume_FindPackagesByUserSecurityIdWithPackageTypes,
+    volume_FindPackagesByUserSecurityIdNamePublisherWithPackageTypes,
+    volume_FindPackagesByUserSecurityIdPackageFamilyNameWithPackagesTypes,
+    volume_FindPackageByUserSecurityIdPackageFullName,
+};
+
+HRESULT package_volume_create( IPackageVolume **out )
+{
+    struct package_volume *impl;
+
+    if (!out) return E_POINTER;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IPackageVolume_iface.lpVtbl = &volume_vtbl;
+    impl->ref = 1;
+    *out = &impl->IPackageVolume_iface;
+    return S_OK;
+}
+
+/* whether a volume is the one volume (another object of ours, or one with its name) */
+BOOL is_package_volume( IPackageVolume *volume )
+{
+    HSTRING mine = NULL, theirs = NULL;
+    INT32 order = 1;
+    IPackageVolume *own;
+
+    if (!volume) return TRUE; /* no volume: the default one */
+    if (volume->lpVtbl == &volume_vtbl) return TRUE;
+    if (FAILED(package_volume_create( &own ))) return FALSE;
+    if (SUCCEEDED(IPackageVolume_get_Name( own, &mine )) && SUCCEEDED(IPackageVolume_get_Name( volume, &theirs )))
+        WindowsCompareStringOrdinal( mine, theirs, &order );
+    WindowsDeleteString( mine );
+    WindowsDeleteString( theirs );
+    IPackageVolume_Release( own );
+    return !order;
+}
+
+/* The list of the volumes: the one volume. */
+struct volume_list
+{
+    IIterable_PackageVolume IIterable_PackageVolume_iface;
+    IIterator_PackageVolume IIterator_PackageVolume_iface;
+    LONG ref;
+    BOOL done;
+};
+
+static inline struct volume_list *impl_from_IIterable_PackageVolume( IIterable_PackageVolume *iface )
+{
+    return CONTAINING_RECORD( iface, struct volume_list, IIterable_PackageVolume_iface );
+}
+
+static inline struct volume_list *impl_from_IIterator_PackageVolume( IIterator_PackageVolume *iface )
+{
