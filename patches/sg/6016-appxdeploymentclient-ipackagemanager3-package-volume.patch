+}
+
+static ULONG WINAPI volume_it_Release( IIterator_PackageVolume *iface )
+{
+    return volumes_Release( &impl_from_IIterator_PackageVolume( iface )->IIterable_PackageVolume_iface );
+}
+
+static HRESULT WINAPI volume_it_GetIids( IIterator_PackageVolume *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI volume_it_GetRuntimeClassName( IIterator_PackageVolume *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Foundation.Collections.IIterator`1<Windows.Management.Deployment.PackageVolume>";
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI volume_it_GetTrustLevel( IIterator_PackageVolume *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI volume_it_get_Current( IIterator_PackageVolume *iface, IPackageVolume **value )
+{
+    struct volume_list *impl = impl_from_IIterator_PackageVolume( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (impl->done) return E_BOUNDS;
+    return package_volume_create( value );
+}
+
+static HRESULT WINAPI volume_it_get_HasCurrent( IIterator_PackageVolume *iface, boolean *value )
+{
+    struct volume_list *impl = impl_from_IIterator_PackageVolume( iface );
+
+    if (!value) return E_POINTER;
+    *value = !impl->done;
+    return S_OK;
+}
+
+static HRESULT WINAPI volume_it_MoveNext( IIterator_PackageVolume *iface, boolean *value )
+{
+    struct volume_list *impl = impl_from_IIterator_PackageVolume( iface );
+
+    impl->done = TRUE;
+    if (value) *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI volume_it_GetMany( IIterator_PackageVolume *iface, UINT32 size, IPackageVolume **items, UINT32 *count )
+{
+    struct volume_list *impl = impl_from_IIterator_PackageVolume( iface );
+    HRESULT hr;
+
+    if (!count) return E_POINTER;
+    *count = 0;
+    if (impl->done || !size) return S_OK;
+    if (FAILED(hr = package_volume_create( &items[0] ))) return hr;
+    *count = 1;
+    impl->done = TRUE;
+    return S_OK;
+}
+
+static const struct IIterator_PackageVolumeVtbl volume_it_vtbl =
+{
+    volume_it_QueryInterface,
+    volume_it_AddRef,
+    volume_it_Release,
+    volume_it_GetIids,
+    volume_it_GetRuntimeClassName,
+    volume_it_GetTrustLevel,
+    volume_it_get_Current,
+    volume_it_get_HasCurrent,
+    volume_it_MoveNext,
+    volume_it_GetMany,
+};
+
+static HRESULT volume_list_create( IIterable_PackageVolume **out )
+{
+    struct volume_list *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IIterable_PackageVolume_iface.lpVtbl = &volumes_vtbl;
+    impl->IIterator_PackageVolume_iface.lpVtbl = &volume_it_vtbl;
+    impl->ref = 1;
+    *out = &impl->IIterable_PackageVolume_iface;
+    return S_OK;
+}
+
+HRESULT package_volumes_create( IIterable_PackageVolume **out )
+{
+    if (!out) return E_POINTER;
+    return volume_list_create( out );
+}
