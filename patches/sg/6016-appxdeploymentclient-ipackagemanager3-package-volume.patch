+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI volumes_AddRef( IIterable_PackageVolume *iface )
+{
+    struct volume_list *impl = impl_from_IIterable_PackageVolume( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI volumes_Release( IIterable_PackageVolume *iface )
+{
+    struct volume_list *impl = impl_from_IIterable_PackageVolume( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
