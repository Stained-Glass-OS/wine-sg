+static HRESULT WINAPI volumes_GetRuntimeClassName( IIterable_PackageVolume *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Foundation.Collections.IIterable`1<Windows.Management.Deployment.PackageVolume>";
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI volumes_GetTrustLevel( IIterable_PackageVolume *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT volume_list_create( IIterable_PackageVolume **out );
+
+static HRESULT WINAPI volumes_First( IIterable_PackageVolume *iface, IIterator_PackageVolume **value )
+{
+    IIterable_PackageVolume *list;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    /* every iterator starts at the beginning */
+    if (FAILED(hr = volume_list_create( &list ))) return hr;
+    *value = &impl_from_IIterable_PackageVolume( list )->IIterator_PackageVolume_iface;
+    return S_OK;
+}
