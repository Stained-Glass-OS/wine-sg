index ec46828..06a784e 100644
--- a/dlls/appxdeploymentclient/Makefile.in
+++ b/dlls/appxdeploymentclient/Makefile.in
@@ -9,4 +9,5 @@ SOURCES = \
 	main.c \
 	package.c \
 	package_list.c \
-	package_obj.c
+	package_obj.c \
+	volume.c
