From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: words wider than the layout break between clusters, marks stay with their base

 - A word wider than the layout width, with nowhere to break, stayed on one line. As the Wine
   tests record from Windows, the line is broken before the cluster that does not fit
   (a line holds at least one cluster), so a layout one pixel wide has a line per character.
   Words kept whole (DWRITE_WORD_WRAPPING_WHOLE_WORD) and lines to be trimmed are not broken.
 - The breakpoint left over from a previous line was used for the next one; it is reset
   when a line is added.
 - The font fallback could end a mapped range between a character and the combining mark after
   it, so the two were shaped as separate runs and counted as two clusters. The boundary now
   moves to a character that is no mark (or takes the marks along when nothing else was mapped).
 - The tests for the factory references of IDWriteFontCollection1::GetFontSet are marked todo:
   the font set keeps a reference of the factory, native does not; removed the todo marks of
   the line count and the draw sequence of the narrow layout and of the cluster count of
   the combining mark.
---
--- a/dlls/dwrite/layout.c
+++ b/dlls/dwrite/layout.c
@@ -659,6 +659,40 @@ static HRESULT layout_itemize(struct dwrite_textlayout *layout)
     return hr;
 }
 
+static BOOL layout_is_diacritic(WCHAR ch)
+{
+    WORD type = 0;
+
+    GetStringTypeW(CT_CTYPE3, &ch, 1, &type);
+    return !!(type & C3_DIACRITIC);
+}
+
+/* A combining mark is mapped to the font of the character it follows; the boundary of a mapped
+   part moves to a character that is not a mark. */
+static unsigned int layout_adjust_mapped_length(const struct dwrite_textlayout *layout, const struct regular_layout_run *run,
+        unsigned int mapped_length)
+{
+    const WCHAR *str = run->descr.string;
+    unsigned int length = run->descr.stringLength, b = mapped_length;
+
+#ifdef SG_MUTANT_DWMARK_SPLIT
+    return mapped_length;
+#endif
+    if (b >= length || !layout_is_diacritic(str[b]))
+        return mapped_length;
+
+    while (b > 0 && layout_is_diacritic(str[b]))
+        --b;
+    if (b)
+        return b;
+
+    /* nothing but the mark's base was mapped: take the marks along */
+    b = mapped_length;
+    while (b < length && layout_is_diacritic(str[b]))
+        ++b;
+    return b;
+}
+
 static HRESULT layout_map_run_characters(struct dwrite_textlayout *layout, struct layout_run *r,
         IDWriteFontFallback *fallback, struct layout_run **remaining)
 {
@@ -710,6 +744,8 @@ static HRESULT layout_map_run_characters(struct dwrite_textlayout *layout, struc
 
         run->run.fontEmSize = range->fontsize * scale;
 
+        mapped_length = layout_adjust_mapped_length(layout, run, mapped_length);
+
         if (mapped_length < length)
         {
             struct regular_layout_run *nextrun;
@@ -2189,6 +2225,17 @@ static HRESULT layout_compute_effective_runs(struct dwrite_textlayout *layout)
                 i = last_breaking_point;
                 last_breaking_point = ~0u;
             }
+            else if (layout->format.wrapping != DWRITE_WORD_WRAPPING_WHOLE_WORD &&
+                    layout->format.trimming.granularity == DWRITE_TRIMMING_GRANULARITY_NONE
+#ifdef SG_MUTANT_DWWRAP_WHOLE_WORD
+                    && 0
+#endif
+                    ) {
+                /* A word wider than the layout is broken before the cluster that does not
+                   fit, unless the line is to be trimmed; a line holds at least one cluster. */
+                if (i > start)
+                    i--;
+            }
             else {
                 /* Otherwise proceed forward to next newline or breaking point */
                 for (; i < layout->cluster_count; i++)
@@ -2201,6 +2248,7 @@ static HRESULT layout_compute_effective_runs(struct dwrite_textlayout *layout)
         layout_add_line(layout, start, i, &textpos);
         start = i + 1;
         width = 0.0f;
+        last_breaking_point = ~0u;
     }
 
     if (FAILED(hr = layout_set_dummy_line_metrics(layout)))
