From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] qdvd: Implement IDvdInfo2::GetDiscID.

GetDiscID computes a 64-bit identifier of the disc from the VIDEO_TS file
names, sizes and times and the IFO headers (CRC-64), the scheme other DVD
software uses.
---
 dlls/qdvd/navigator.c | 126 +++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 124 insertions(+), 2 deletions(-)

diff --git a/dlls/qdvd/navigator.c b/dlls/qdvd/navigator.c
index 4329e38..1ae2bb8 100644
--- a/dlls/qdvd/navigator.c
+++ b/dlls/qdvd/navigator.c
@@ -892,6 +892,128 @@ static HRESULT WINAPI dvd_info2_IsAudioStreamEnabled(IDvdInfo2 *iface, ULONG str
     return nav_domain_check(filter);
 }
 
+/* The disc identifier: a CRC-64 (polynomial 0x92c64265d32139a4, reflected,
+ * initial value ~0) over the VIDEO_TS file list (for each file in name order:
+ * creation time, size, name with its terminator) followed by the first 64 KiB
+ * of VIDEO_TS.IFO and of VTS_01_0.IFO, as the scheme is publicly described. */
+static ULONGLONG crc64_update(ULONGLONG crc, const void *data, size_t size)
+{
+    static ULONGLONG table[256];
+    const BYTE *p = data;
+    unsigned int i, j;
+
+    if (!table[1])
+    {
+        for (i = 0; i < 256; ++i)
+        {
+            ULONGLONG v = i;
+            for (j = 0; j < 8; ++j)
+                v = (v & 1) ? (v >> 1) ^ 0x92c64265d32139a4ull : v >> 1;
+            table[i] = v;
+        }
+    }
+    while (size--)
+        crc = table[(crc ^ *p++) & 0xff] ^ (crc >> 8);
+    return crc;
+}
+
+struct disc_file
+{
+    char name[MAX_PATH];
+    FILETIME created;
+    DWORD size;
+};
+
+static int disc_file_compare(const void *a, const void *b)
+{
+    return strcmp(((const struct disc_file *)a)->name, ((const struct disc_file *)b)->name);
+}
+
+static ULONGLONG crc64_file(ULONGLONG crc, const WCHAR *dir, const WCHAR *name, BOOL *found)
+{
+    WCHAR buffer[MAX_PATH + 32];
+    BYTE *data;
+    HANDLE file;
+    DWORD read;
+
+    *found = FALSE;
+    swprintf(buffer, ARRAY_SIZE(buffer), L"%s\\%s", dir, name);
+    file = CreateFileW(buffer, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return crc;
+    if ((data = malloc(0x10000)))
+    {
+        if (ReadFile(file, data, 0x10000, &read, NULL))
+        {
+            crc = crc64_update(crc, data, read);
+            *found = TRUE;
+        }
+        free(data);
+    }
+    CloseHandle(file);
+    return crc;
+}
+
+static HRESULT dvd_compute_disc_id(const WCHAR *path, ULONGLONG *id)
+{
+    struct disc_file *files = NULL, *tmp;
+    size_t count = 0, capacity = 0, i;
+    WCHAR dir[MAX_PATH + 16];
+    WIN32_FIND_DATAW data;
+    ULONGLONG crc = ~0ull;
+    BOOL found;
+    HANDLE find;
+    size_t len;
+
+    wcscpy(dir, path);
+    len = wcslen(dir);
+    if (len && (dir[len - 1] == '\\' || dir[len - 1] == '/'))
+        dir[--len] = 0;
+    wcscat(dir, L"\\VIDEO_TS\\*");
+    if ((find = FindFirstFileW(dir, &data)) == INVALID_HANDLE_VALUE)
+        return VFW_E_DVD_INVALID_DISC;
+    dir[wcslen(dir) - 2] = 0;
+
+    do
+    {
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+            continue;
+        if (count == capacity)
+        {
+            capacity = max(16, capacity * 2);
+            if (!(tmp = realloc(files, capacity * sizeof(*files))))
+            {
+                free(files);
+                FindClose(find);
+                return E_OUTOFMEMORY;
+            }
+            files = tmp;
+        }
+        WideCharToMultiByte(CP_ACP, 0, data.cFileName, -1, files[count].name, sizeof(files[count].name), NULL, NULL);
+        files[count].created = data.ftCreationTime;
+        files[count].size = data.nFileSizeLow;
+        ++count;
+    } while (FindNextFileW(find, &data));
+    FindClose(find);
+
+    qsort(files, count, sizeof(*files), disc_file_compare);
+    for (i = 0; i < count; ++i)
+    {
+        crc = crc64_update(crc, &files[i].created, sizeof(files[i].created));
+        crc = crc64_update(crc, &files[i].size, sizeof(files[i].size));
+        crc = crc64_update(crc, files[i].name, strlen(files[i].name) + 1);
+    }
+    free(files);
+
+    crc = crc64_file(crc, dir, L"VIDEO_TS.IFO", &found);
+    if (!found)
+        return VFW_E_DVD_INVALID_DISC;
+    crc = crc64_file(crc, dir, L"VTS_01_0.IFO", &found);
+
+    *id = crc;
+    return S_OK;
+}
+
 static HRESULT WINAPI dvd_info2_GetDiscID(IDvdInfo2 *iface, const WCHAR *path, ULONGLONG *id)
 {
     struct navigator *filter = impl_from_IDvdInfo2(iface);
@@ -908,8 +1030,8 @@ static HRESULT WINAPI dvd_info2_GetDiscID(IDvdInfo2 *iface, const WCHAR *path, U
         return VFW_E_DVD_INVALID_DISC;
     }
     LeaveCriticalSection(&filter->filter.filter_cs);
-    FIXME("Disc identifier computation is not implemented.\n");
-    return E_NOTIMPL;
+
+    return dvd_compute_disc_id(path, id);
 }
 
 static HRESULT WINAPI dvd_info2_GetState(IDvdInfo2 *iface, IDvdState **state)
