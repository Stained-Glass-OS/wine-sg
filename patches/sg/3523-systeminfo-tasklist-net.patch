+/* ---- /v and /svc: who runs it, for how long, what window it has, which services it hosts ---- */
+
+struct window_search { DWORD pid; WCHAR *title; size_t size; };
+
+static BOOL CALLBACK find_window_title(HWND hwnd, LPARAM param)
+{
+    struct window_search *search = (struct window_search *)param;
+    DWORD pid;
+
+    GetWindowThreadProcessId(hwnd, &pid);
+    if (pid != search->pid || !IsWindowVisible(hwnd) || GetWindow(hwnd, GW_OWNER)) return TRUE;
+    if (GetWindowTextW(hwnd, search->title, search->size) > 0) return FALSE;
+    return TRUE;
+}
+
+static void tasklist_get_user_name(HANDLE process, WCHAR *out, size_t size)
+{
+    HANDLE token;
+    BYTE buffer[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE];
+    DWORD len = sizeof(buffer);
+    WCHAR name[128], domain[128];
+    DWORD nlen = ARRAY_SIZE(name), dlen = ARRAY_SIZE(domain);
+    SID_NAME_USE use;
+
+    wcscpy(out, L"N/A");
+    if (!process || !OpenProcessToken(process, TOKEN_QUERY, &token)) return;
+    if (GetTokenInformation(token, TokenUser, buffer, len, &len)
+            && LookupAccountSidW(NULL, ((TOKEN_USER *)buffer)->User.Sid, name, &nlen, domain, &dlen, &use))
+        swprintf(out, size, L"%s\\%s", domain, name);
+    CloseHandle(token);
+}
+
+static void tasklist_get_cpu_time(HANDLE process, WCHAR *out, size_t size)
+{
+    FILETIME create, exit, kernel, user;
+    ULARGE_INTEGER total;
+    ULONGLONG seconds;
+
+    wcscpy(out, L"N/A");
+    if (!process || !GetProcessTimes(process, &create, &exit, &kernel, &user)) return;
+    total.QuadPart = ((ULARGE_INTEGER){ .LowPart = kernel.dwLowDateTime, .HighPart = kernel.dwHighDateTime }).QuadPart
+            + ((ULARGE_INTEGER){ .LowPart = user.dwLowDateTime, .HighPart = user.dwHighDateTime }).QuadPart;
+    seconds = total.QuadPart / 10000000;
+    swprintf(out, size, L"%I64u:%02u:%02u", seconds / 3600, (unsigned)(seconds / 60 % 60), (unsigned)(seconds % 60));
+}
