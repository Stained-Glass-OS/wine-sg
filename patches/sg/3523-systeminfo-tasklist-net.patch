+static void tasklist_get_extended_info(const PROCESSENTRY32W *entry, struct tasklist_process_info *info)
+{
+    HANDLE process = OpenProcess(PROCESS_QUERY_INFORMATION, FALSE, entry->th32ProcessID);
+    struct window_search search = { entry->th32ProcessID, info->window_title, ARRAY_SIZE(info->window_title) };
+
+    wcscpy(info->status, L"Running");
+    tasklist_get_user_name(process, info->user_name, ARRAY_SIZE(info->user_name));
+    tasklist_get_cpu_time(process, info->cpu_time, ARRAY_SIZE(info->cpu_time));
+    info->window_title[0] = 0;
+    EnumWindows(find_window_title, (LPARAM)&search);
+    if (!info->window_title[0]) wcscpy(info->window_title, L"N/A");
+    tasklist_get_services(entry->th32ProcessID, info->services, ARRAY_SIZE(info->services));
+    if (process) CloseHandle(process);
+}
