+static void output_vm_in_use( IWbemServices *services, enum format_flags flags, UINT32 width )
+{
+    IWbemClassObject *obj = NULL;
+    VARIANT total, free_mem;
+    UINT64 total_kb = 0, free_kb = 0;
+    BSTR str = SysAllocString( L"Win32_OperatingSystem" );
+    HRESULT hr;
+
+    if (!str) return;
+    hr = IWbemServices_GetObject( services, str, 0, NULL, &obj, NULL );
+    SysFreeString( str );
+    if (FAILED( hr )) return;
+    VariantInit( &total );
+    VariantInit( &free_mem );
+    if (SUCCEEDED( IWbemClassObject_Get( obj, L"TotalVirtualMemorySize", 0, &total, NULL, NULL ) ) && V_VT( &total ) == VT_BSTR)
+        swscanf( V_BSTR( &total ), L"%I64u", &total_kb );
+    if (SUCCEEDED( IWbemClassObject_Get( obj, L"FreeVirtualMemory", 0, &free_mem, NULL, NULL ) ) && V_VT( &free_mem ) == VT_BSTR)
+        swscanf( V_BSTR( &free_mem ), L"%I64u", &free_kb );
+    fwprintf( out_file, L"Virtual Memory: In Use:%*s %I64u MB\n", width - wcslen( L"Virtual Memory: In Use" ), L" ",
+              (total_kb > free_kb ? total_kb - free_kb : 0) / 1024 );
+    VariantClear( &total );
+    VariantClear( &free_mem );
+    IWbemClassObject_Release( obj );
