+/* NET HELPMSG number: the text of a system error */
+static int net_helpmsg(const WCHAR *arg)
+{
+    WCHAR *end;
+    DWORD number = wcstoul(arg, &end, 10);
+    WCHAR *text = NULL;
+
+    if (*end || !*arg)
+    {
+        output_string(STRING_HELPMSG_USAGE);
+        return 1;
+    }
+    if (number < 2100 && FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS | FORMAT_MESSAGE_ALLOCATE_BUFFER,
+                                        NULL, number, 0, (WCHAR *)&text, 0, NULL))
+    {
+        output_write(L"\n", 1);
+        output_write(text, lstrlenW(text));
+        output_write(L"\n", 1);
+        LocalFree(text);
+        return 0;
+    }
+    output_string(STRING_HELPMSG_NOT_FOUND, number);
+    return 1;
+}
+
+/* NET SHARE: the resources this machine shares */
+static int net_share_list(void)
+{
+    SHARE_INFO_2 *shares = NULL;
+    DWORD read = 0, total = 0, i;
+    NET_API_STATUS status = NetShareEnum(NULL, 2, (BYTE **)&shares, MAX_PREFERRED_LENGTH, &read, &total, NULL);
+
+    if (status != NERR_Success)
+    {
+        output_string(STRING_SYSTEM_ERROR, status);
+        return 1;
+    }
+    if (!read)
+    {
+        output_string(STRING_NO_ENTRIES);
+        NetApiBufferFree(shares);
+        return 0;
+    }
+    output_string(STRING_SHARE_HEADER);
+    for (i = 0; i < read; i++)
+        output_string(STRING_SHARE_ENTRY, shares[i].shi2_netname, shares[i].shi2_path, shares[i].shi2_remark ? shares[i].shi2_remark : L"");
+    output_string(STRING_CMD_SUCCESS);
+    NetApiBufferFree(shares);
+    return 0;
+}
+
+static int net_share(int argc, const WCHAR *argv[])
+{
+    SHARE_INFO_2 *info = NULL;
+    NET_API_STATUS status;
+
+    if (argc == 2) return net_share_list();
+    /* a share is made or removed by an administrator, through the same calls on any other platform; asking only reads */
+    if (argc > 3 || wcschr(argv[2], '='))
+    {
+        output_string(STRING_SHARE_USAGE);
+        return 1;
+    }
+    status = NetShareGetInfo(NULL, (WCHAR *)argv[2], 2, (BYTE **)&info);
+    if (status != NERR_Success)
+    {
+        output_error_string(status == NERR_NetNameNotFound ? ERROR_BAD_NET_NAME : status);
+        return 2;
+    }
+    output_string(STRING_SHARE_DETAIL, info->shi2_netname, info->shi2_path, info->shi2_remark ? info->shi2_remark : L"");
+    NetApiBufferFree(info);
+    return 0;
+}
