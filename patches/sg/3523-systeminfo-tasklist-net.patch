+struct field
+{
+    WCHAR *name;
+    WCHAR *value;
+};
+
+/* The list output, read back as "Name: value" lines; a line that starts with a space continues the value above. */
+static struct field *parse_list( FILE *f, UINT32 *count )
+{
+    struct field *fields = NULL;
+    UINT32 n = 0, cap = 0;
+    WCHAR line[1024];
+
+    rewind( f );
+    while (fgetws( line, ARRAY_SIZE(line), f ))
+    {
+        size_t len = wcslen( line );
+
+        while (len && (line[len - 1] == '\n' || line[len - 1] == '\r')) line[--len] = 0;
+        if (line[0] == ' ')
+        {
+            WCHAR *text = line;
+            size_t old, add;
+
+            if (!n) continue;
+            while (*text == ' ') text++;
+            old = fields[n - 1].value ? wcslen( fields[n - 1].value ) : 0;
+            add = wcslen( text );
+            fields[n - 1].value = realloc( fields[n - 1].value, (old + add + 2) * sizeof(WCHAR) );
+            if (old) fields[n - 1].value[old++] = '\n';
+            wcscpy( fields[n - 1].value + old, text );
+            continue;
+        }
+        else
+        {
+            WCHAR *colon = wcschr( line, ':' ), *value;
+
+            if (!colon) continue;
+            /* "Virtual Memory: Max Size:   64728 MB" has a colon in the name: the value follows the last ": " run */
+            if (!wcsncmp( line, L"Virtual Memory:", 15 )) colon = wcschr( colon + 1, ':' );
+            if (!colon) continue;
+            *colon = 0;
+            value = colon + 1;
+            while (*value == ' ') value++;
+            if (n == cap)
+            {
+                cap = cap ? cap * 2 : 64;
+                fields = realloc( fields, cap * sizeof(*fields) );
+            }
+            fields[n].name = wcsdup( line );
+            fields[n].value = wcsdup( value );
+            n++;
+        }
+    }
+    *count = n;
+    return fields;
+}
+
+static void print_csv_field( const WCHAR *text )
+{
+    const WCHAR *p;
+
+    fputwc( '"', stdout );
+    for (p = text; *p; p++)
+    {
+        if (*p == '"') fputwc( '"', stdout );
+        fputwc( *p, stdout );
+    }
+    fputwc( '"', stdout );
+}
+
+static void print_fields( struct field *fields, UINT32 count, enum output_format format, BOOL noheader )
+{
+    UINT32 i;
+
+    if (format == OUTPUT_CSV)
+    {
+        if (!noheader)
+        {
+            for (i = 0; i < count; i++) { if (i) fputwc( ',', stdout ); print_csv_field( fields[i].name ); }
+            fputwc( '\n', stdout );
+        }
+        for (i = 0; i < count; i++) { if (i) fputwc( ',', stdout ); print_csv_field( fields[i].value ); }
+        fputwc( '\n', stdout );
+        return;
+    }
+    /* table: a column per field, as wide as its widest line */
+    {
+        UINT32 *widths = calloc( count, sizeof(*widths) ), line;
+        BOOL more = TRUE;
+
+        for (i = 0; i < count; i++)
+        {
+            const WCHAR *p = fields[i].value;
+
+            widths[i] = wcslen( fields[i].name );
+            while (p)
+            {
+                const WCHAR *nl = wcschr( p, '\n' );
+                UINT32 len = nl ? nl - p : wcslen( p );
+                if (len > widths[i]) widths[i] = len;
+                p = nl ? nl + 1 : NULL;
+            }
+        }
+        if (!noheader)
+        {
+            for (i = 0; i < count; i++) fwprintf( stdout, L"%-*s ", widths[i], fields[i].name );
+            fputwc( '\n', stdout );
+            for (i = 0; i < count; i++)
+            {
+                UINT32 k;
+                for (k = 0; k < widths[i]; k++) fputwc( '=', stdout );
+                fputwc( ' ', stdout );
+            }
+            fputwc( '\n', stdout );
+        }
+        for (line = 0; more; line++)
+        {
+            more = FALSE;
+            for (i = 0; i < count; i++)
+            {
+                const WCHAR *p = fields[i].value;
+                UINT32 k;
+
+                for (k = 0; k < line && p; k++) { p = wcschr( p, '\n' ); if (p) p++; }
+                if (p)
+                {
+                    const WCHAR *nl = wcschr( p, '\n' );
+                    UINT32 len = nl ? nl - p : wcslen( p );
+
+                    fwprintf( stdout, L"%.*s%*s ", len, p, widths[i] - len, L"" );
+                    if (nl) more = TRUE;
+                }
+                else fwprintf( stdout, L"%*s ", widths[i], L"" );
+            }
+            fputwc( '\n', stdout );
+        }
+        free( widths );
+    }
+}
