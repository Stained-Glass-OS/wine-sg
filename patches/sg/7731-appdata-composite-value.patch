+            free( impl->mem[i].blob );
+            impl->mem[i].blob = copy;
+            impl->mem[i].size = size;
+        }
+        else
+        {
+            struct mem_value *mem = realloc( impl->mem, (impl->mem_count + 1) * sizeof(*mem) );
+            WCHAR *dup = wcsdup( name );
+
+            if (!mem || !dup)
+            {
+                if (mem) impl->mem = mem;
+                free( dup );
+                free( copy );
+                hr = E_OUTOFMEMORY;
+            }
+            else
+            {
+                impl->mem = mem;
+                mem[impl->mem_count].name = dup;
+                mem[impl->mem_count].blob = copy;
+                mem[impl->mem_count].size = size;
+                impl->mem_count++;
+            }
+        }
+        LeaveCriticalSection( &impl->cs );
+        return hr;
+    }
+    if (!(reg = open_set_key( impl, TRUE, KEY_SET_VALUE ))) return HRESULT_FROM_WIN32( ERROR_ACCESS_DENIED );
