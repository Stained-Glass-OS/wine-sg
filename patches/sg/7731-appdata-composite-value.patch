+static HRESULT store_set( struct property_set *impl, const WCHAR *name, const BYTE *blob, DWORD size )
+{
+    HKEY reg;
+    LONG err;
+    int i;
+
+    if (!impl->path)
+    {
+        BYTE *copy = malloc( size ? size : 1 );
+        HRESULT hr = S_OK;
+
+        if (!copy) return E_OUTOFMEMORY;
+        memcpy( copy, blob, size );
+        EnterCriticalSection( &impl->cs );
+        if ((i = mem_find( impl, name )) >= 0)
