+
+/* ---- ApplicationDataCompositeValue: a property set in memory ---- */
+
+static HRESULT memory_set_create( struct property_set **out )
+{
+    struct property_set *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IPropertySet_iface.lpVtbl = &propset_vtbl;
+    impl->IObservableMap_iface.lpVtbl = &obs_vtbl;
+    impl->IMap_iface.lpVtbl = &map_vtbl;
+    impl->IIterable_iface.lpVtbl = &iterable_set_vtbl;
+    impl->ref = 1;
+    list_init( &impl->handlers );
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": composite.cs");
+    *out = impl;
+    return S_OK;
+}
+
+static HRESULT composite_to_blob( IInspectable *value, BYTE **blob, DWORD *size )
+{
+    struct property_set *impl;
+    IPropertySet *set;
+    struct stored_value *sv;
+    DWORD total;
+    BYTE *p;
+    UINT i;
+
+    if (FAILED( IInspectable_QueryInterface( value, &IID_IPropertySet, (void **)&set ) )) return E_NOINTERFACE;
+    impl = impl_from_IPropertySet( set );
+    if (set->lpVtbl != &propset_vtbl || impl->path)  /* only a composite value of ours */
+    {
+        IPropertySet_Release( set );
+        return E_NOINTERFACE;
+    }
+    EnterCriticalSection( &impl->cs );
+    total = offsetof(struct stored_value, data[sizeof(UINT32)]);
+    for (i = 0; i < impl->mem_count; i++)
+        total += sizeof(UINT32) + wcslen( impl->mem[i].name ) * sizeof(WCHAR) + sizeof(UINT32) + impl->mem[i].size;
+    if (!(sv = malloc( total )))
+    {
+        LeaveCriticalSection( &impl->cs );
+        IPropertySet_Release( set );
+        return E_OUTOFMEMORY;
+    }
+    sv->type = STORED_COMPOSITE;
+    p = sv->data;
+    *(UINT32 *)p = impl->mem_count; p += sizeof(UINT32);
+    for (i = 0; i < impl->mem_count; i++)
+    {
+        UINT32 len = wcslen( impl->mem[i].name );
+        *(UINT32 *)p = len; p += sizeof(UINT32);
+        memcpy( p, impl->mem[i].name, len * sizeof(WCHAR) ); p += len * sizeof(WCHAR);
+        *(UINT32 *)p = impl->mem[i].size; p += sizeof(UINT32);
+        memcpy( p, impl->mem[i].blob, impl->mem[i].size ); p += impl->mem[i].size;
+    }
+    LeaveCriticalSection( &impl->cs );
+    IPropertySet_Release( set );
+    *blob = (BYTE *)sv;
+    *size = total;
+    return S_OK;
+}
+
+static HRESULT composite_from_blob( const BYTE *data, DWORD size, IInspectable **out )
+{
+    const BYTE *p = data, *end = data + size;
+    struct property_set *impl;
+    UINT32 count, i;
+    HRESULT hr;
+
+    if (size < sizeof(UINT32)) return E_FAIL;
+    count = *(const UINT32 *)p; p += sizeof(UINT32);
+    if (FAILED( hr = memory_set_create( &impl ) )) return hr;
+    for (i = 0; i < count; i++)
+    {
+        UINT32 len, blob_size;
+        WCHAR *name;
+
+        if (end - p < sizeof(UINT32)) break;
+        len = *(const UINT32 *)p; p += sizeof(UINT32);
+        if ((end - p) / sizeof(WCHAR) < len) break;
+        if (!(name = malloc( (len + 1) * sizeof(WCHAR) ))) break;
+        memcpy( name, p, len * sizeof(WCHAR) ); name[len] = 0; p += len * sizeof(WCHAR);
+        if (end - p < sizeof(UINT32)) { free( name ); break; }
+        blob_size = *(const UINT32 *)p; p += sizeof(UINT32);
+        if (end - p < blob_size) { free( name ); break; }
+        store_set( impl, name, p, blob_size );
+        p += blob_size;
+        free( name );
+    }
+    *out = (IInspectable *)&impl->IPropertySet_iface;
+    return S_OK;
+}
+
+struct composite_factory
+{
