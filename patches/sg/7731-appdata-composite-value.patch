+    /* Stained Glass OS: settings grouped as one value (LanguageTool for Desktop's settings) */
+    if (!wcscmp( buffer, RuntimeClass_Windows_Storage_ApplicationDataCompositeValue ))
+        IActivationFactory_QueryInterface( composite_value_factory, &IID_IActivationFactory, (void **)factory );
 
