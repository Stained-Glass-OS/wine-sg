+/* the stored blob of NAME (the caller frees it); FALSE if there is none */
+static BOOL store_get( struct property_set *impl, const WCHAR *name, BYTE **data, DWORD *size )
+{
+    BOOL ret = FALSE;
+    DWORD type;
+    HKEY reg;
+    int i;
+
+    *data = NULL;
+    *size = 0;
+    if (!impl->path)
