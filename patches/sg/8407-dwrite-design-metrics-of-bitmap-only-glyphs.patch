From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: design glyph metrics of a bitmap-only font

A bitmap-only font (Noto Color Emoji: CBDT strikes, no outlines) has no scalable size, so
get_design_glyph_metrics failed to set the em size and returned without writing the metrics;
GetDesignGlyphMetrics then cached and returned its uninitialised stack (advance 32767, side
bearings in the millions). Qt 6 took that for a 805592x24980944 pixel glyph and SpeedCrunch
crashed in QRasterPaintEngine::alphaPenBlt drawing its autocomplete popup. Unscaled loading needs
no size: go on without one, start from zeroed metrics, and if the glyph still does not load give
its hmtx advance.
---
diff --git a/dlls/dwrite/freetype.c b/dlls/dwrite/freetype.c
--- a/dlls/dwrite/freetype.c
+++ b/dlls/dwrite/freetype.c
@@ -34,6 +34,7 @@
 #include FT_OUTLINE_H
 #include FT_TRUETYPE_TABLES_H
 #include FT_SIZES_H
+#include FT_ADVANCES_H
 #endif /* HAVE_FT2BUILD_H */
 
 #include "ntstatus.h"
@@ -63,6 +64,7 @@
 MAKE_FUNCPTR(FT_Done_FreeType);
 MAKE_FUNCPTR(FT_Done_Glyph);
 MAKE_FUNCPTR(FT_Done_Size);
+MAKE_FUNCPTR(FT_Get_Advance);
 MAKE_FUNCPTR(FT_Get_First_Char);
 MAKE_FUNCPTR(FT_Get_Glyph);
 MAKE_FUNCPTR(FT_Get_Kerning);
@@ -130,6 +132,7 @@
     LOAD_FUNCPTR(FT_Done_FreeType)
     LOAD_FUNCPTR(FT_Done_Glyph)
     LOAD_FUNCPTR(FT_Done_Size)
+    LOAD_FUNCPTR(FT_Get_Advance)
     LOAD_FUNCPTR(FT_Get_First_Char)
     LOAD_FUNCPTR(FT_Get_Glyph)
     LOAD_FUNCPTR(FT_Get_Kerning)
@@ -212,11 +215,35 @@
     FT_Face face = FaceFromObject(params->object);
     FT_Size size;
 
+#ifndef SG_MUTANT_DWRITE_BITMAP_METRICS_UNSET
+    /* Stained Glass OS (wine-sg 8407): a bitmap-only font (Noto Color Emoji: CBDT strikes, no
+     * outlines) has no scalable size, so setting the em size failed and this returned without writing
+     * the metrics; the caller cached its stack garbage (advance 32767, bearings in the millions) and Qt
+     * took that for a 805592x24980944 pixel glyph and crashed drawing it. Unscaled loading needs no
+     * size: go on without one, and if the glyph still does not load, give its hmtx advance. */
+    memset( params->metrics, 0, sizeof(*params->metrics) );
+    size = freetype_set_face_size(face, params->upem);
+    if (pFT_Load_Glyph(face, params->glyph, FT_LOAD_NO_SCALE))
+    {
+        FT_Fixed advance = 0;
+
+        if (!pFT_Get_Advance( face, params->glyph, FT_LOAD_NO_SCALE, &advance ))
+            params->metrics->advanceWidth = advance;
+        params->metrics->advanceHeight = params->upem;
+        params->metrics->verticalOriginY = params->ascent;
+        if (params->upem > params->ascent)
+            params->metrics->bottomSideBearing = params->upem - params->ascent;
+        if (size) pFT_Done_Size(size);
+        return STATUS_SUCCESS;
+    }
+    {
+#else
     if (!(size = freetype_set_face_size(face, params->upem)))
         return STATUS_UNSUCCESSFUL;
 
     if (!pFT_Load_Glyph(face, params->glyph, FT_LOAD_NO_SCALE))
     {
+#endif
         FT_Glyph_Metrics *metrics = &face->glyph->metrics;
 
         params->metrics->leftSideBearing = metrics->horiBearingX;
@@ -236,7 +263,7 @@
         }
     }
 
-    pFT_Done_Size(size);
+    if (size) pFT_Done_Size(size);
 
     return STATUS_SUCCESS;
 }
