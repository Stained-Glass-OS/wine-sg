From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 13:50:44 -0700
Subject: [PATCH] url: InetIsOffline reports the offline mode (3249)

InetIsOffline answered FALSE always. It now reports whether the user chose
"work offline", the connected state wininet keeps
(INTERNET_STATE_DISCONNECTED_BY_USER). The meaning of the export is
undocumented; this is the behaviour of IE's offline mode.

diff --git a/dlls/url/url_main.c b/dlls/url/url_main.c
index 8df88d6..85b9a0a 100644
--- a/dlls/url/url_main.c
+++ b/dlls/url/url_main.c
@@ -57,9 +57,24 @@ DWORD WINAPI AddMIMEFileTypesPS(VOID * unknown1, LPPROPSHEETHEADERA lppsh)
  */
 BOOL WINAPI InetIsOffline(DWORD flags)
 {
-    FIXME("(%08lx): stub!\n", flags);
+    /* "work offline": the connected state wininet keeps (disconnected by the user) */
+    BOOL (WINAPI *query)(HANDLE, DWORD, void *, DWORD *);
+    HMODULE wininet;
+    DWORD state = 0, size = sizeof(state);
+    BOOL ret = FALSE;
 
-    return FALSE;
+    TRACE("(%08lx)\n", flags);
+
+    if ((wininet = LoadLibraryW(L"wininet.dll")))
+    {
+        query = (void *)GetProcAddress(wininet, "InternetQueryOptionW");
+#ifndef SG_MUTANT_URL_ONLINE
+        if (query && query(NULL, 50 /* INTERNET_OPTION_CONNECTED_STATE */, &state, &size))
+            ret = !!(state & 0x10 /* INTERNET_STATE_DISCONNECTED_BY_USER */);
+#endif
+        FreeLibrary(wininet);
+    }
+    return ret;
 }
 
 /***********************************************************************
