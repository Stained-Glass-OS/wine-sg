From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msxml3: removeAttributeNode takes the attribute off the element

IXMLDOMElement::removeAttributeNode was a stub returning E_NOTIMPL.
Meedio (2.55) removes each attribute of its theme files as it reads
them through MSXML 4, and stopped at start with "Failed to load resource
file ...\themes\default\default.resources : Not implemented" (David's
compat sweep, 2026-09-29). The attribute now leaves the element, is
given back with its value, and the element is written without it; one
not on the element -- removed already, another element's, or none -- is
E_INVALIDARG.

Test: test/msxml-removeattr-gate.sh with test/msxml-removeattr-probe.c
(mutant SG_MUTANT_MSXML_REMOVEATTRNODE_STUB).
---
--- a/dlls/msxml3/element.c
+++ b/dlls/msxml3/element.c
@@ -1493,8 +1493,36 @@
     IXMLDOMAttribute** attributeNode)
 {
     domelem *This = impl_from_IXMLDOMElement( iface );
-    FIXME("(%p)->(%p %p)\n", This, domAttribute, attributeNode);
+    xmlNodePtr element = get_element( This );
+    xmlnode *attr_node;
+    xmlAttrPtr attr;
+
+    TRACE("(%p)->(%p %p)\n", This, domAttribute, attributeNode);
+
+    if (attributeNode) *attributeNode = NULL;
+#ifdef SG_MUTANT_MSXML_REMOVEATTRNODE_STUB
     return E_NOTIMPL;
+#endif
+    if (!domAttribute) return E_INVALIDARG;
+
+    /* Stained Glass OS: the attribute leaves the element and is given back
+     * (Meedio's theme loader removes attributes it has read: "Failed to load
+     * resource file ... Not implemented") */
+    attr_node = get_node_obj( (IXMLDOMNode *)domAttribute );
+    if (!attr_node || !element) return E_FAIL;
+    attr = (xmlAttrPtr)attr_node->node;
+    if (attr->type != XML_ATTRIBUTE_NODE || attr->parent != element) return E_INVALIDARG;
+
+    xmlUnlinkNode( (xmlNodePtr)attr );
+    xmldoc_add_orphan( attr->doc, (xmlNodePtr)attr );
+    attr_node->parent = NULL;
+
+    if (attributeNode)
+    {
+        *attributeNode = domAttribute;
+        IXMLDOMAttribute_AddRef( domAttribute );
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI domelem_getElementsByTagName(
