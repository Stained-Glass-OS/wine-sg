+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * DisplayInformation.GetForCurrentView: the display of the calling thread's view, one object per
+ * thread for its life (a XAML thread is a view's here: islands have no CoreApplicationView).  It
+ * reports the primary monitor: its DPI (logical, and raw from its physical size), the scale that DPI
+ * makes, its orientation and size in pixels.  The events are accepted; displays here do not change
+ * DPI or orientation under a running program.  Interface identity per windows-rs 0.30.0 (MIT).
+ */
+
+#include <math.h>
+#include <stdlib.h>
+#include "private.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ui);
+
+static const GUID IID_IDisplayInformation_sg = { 0xbed112ae, 0xadc3, 0x4dc9, { 0xae, 0x65, 0x85, 0x1f, 0x4d, 0x7d, 0x47, 0x99 } };
+static const GUID IID_IDisplayInformation2_sg = { 0x4dcd0021, 0xfad1, 0x4b8e, { 0x8e, 0xdf, 0x77, 0x58, 0x87, 0xb8, 0xbf, 0x19 } };
+static const GUID IID_IDisplayInformation3_sg = { 0xdb15011d, 0x0f09, 0x4466, { 0x8f, 0xf3, 0x11, 0xde, 0x9a, 0x3c, 0x92, 0x9a } };
+static const GUID IID_IDisplayInformation4_sg = { 0xc972ce2f, 0x1242, 0x46be, { 0xb5, 0x36, 0xe1, 0xaa, 0xfe, 0x9e, 0x7a, 0xcf } };
+static const GUID IID_IDisplayInformationStatics_sg = { 0xc6a02a6c, 0xd452, 0x44dc, { 0xba, 0x07, 0x96, 0xf3, 0xc6, 0xad, 0xf9, 0xd1 } };
+static const GUID IID_IWeakReferenceSource_di = { 0x00000038, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+static const GUID IID_IWeakReference_di = { 0x00000037, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+
+enum { ORIENTATION_LANDSCAPE = 1, ORIENTATION_PORTRAIT = 2 };   /* DisplayOrientations */
+
+struct display_info
+{
+    const void *vtbl;                  /* IDisplayInformation */
+    const void *info2_vtbl, *info3_vtbl, *info4_vtbl;
+    const void *weak_source_vtbl, *weak_vtbl;
+    LONG ref;
+};
+
+static DWORD display_tls = TLS_OUT_OF_INDEXES;
+static INT32 auto_rotation;            /* AutoRotationPreferences, the process's */
+static LONG next_token;
+
+static struct display_info *info_from( void *iface, size_t offset )
+{
+    return (struct display_info *)((char *)iface - offset);
+}
+
+#define FROM_I(iface) info_from( iface, offsetof(struct display_info, vtbl) )
+#define FROM_I2(iface) info_from( iface, offsetof(struct display_info, info2_vtbl) )
+#define FROM_I3(iface) info_from( iface, offsetof(struct display_info, info3_vtbl) )
+#define FROM_I4(iface) info_from( iface, offsetof(struct display_info, info4_vtbl) )
+#define FROM_WS(iface) info_from( iface, offsetof(struct display_info, weak_source_vtbl) )
+#define FROM_W(iface) info_from( iface, offsetof(struct display_info, weak_vtbl) )
+
+/* ---- what the primary monitor is ---- */
+
+static UINT logical_dpi(void)
+{
+    HDC dc = GetDC( 0 );
+    UINT dpi = GetDeviceCaps( dc, LOGPIXELSY );
+    ReleaseDC( 0, dc );
+    return dpi ? dpi : 96;
+}
+
+/* pixels per inch of the monitor itself, from its size in millimetres (its logical DPI if unknown) */
+static FLOAT raw_dpi( BOOL vertical )
+{
+    HDC dc = GetDC( 0 );
+    int mm = GetDeviceCaps( dc, vertical ? VERTSIZE : HORZSIZE );
+    int pixels = GetDeviceCaps( dc, vertical ? VERTRES : HORZRES );
+    ReleaseDC( 0, dc );
+    if (mm <= 0 || pixels <= 0) return logical_dpi();
+    return pixels * 25.4f / mm;
+}
+
+static INT32 orientation(void)
+{
+    return GetSystemMetrics( SM_CXSCREEN ) >= GetSystemMetrics( SM_CYSCREEN ) ? ORIENTATION_LANDSCAPE : ORIENTATION_PORTRAIT;
+}
+
+/* ResolutionScale: the largest documented scale not above the DPI's */
+static INT32 resolution_scale(void)
+{
+    static const INT32 scales[] = { 100, 120, 125, 140, 150, 160, 175, 180, 200, 225, 250, 300, 350, 400, 450, 500 };
+    INT32 percent = MulDiv( logical_dpi(), 100, 96 ), best = 100;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(scales); i++) if (scales[i] <= percent) best = scales[i];
+    return best;
+}
+
+/* ---- the object ---- */
+
+static HRESULT info_qi( struct display_info *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IDisplayInformation_sg ))
+        *out = &impl->vtbl;
+    else if (IsEqualGUID( iid, &IID_IDisplayInformation2_sg )) *out = &impl->info2_vtbl;
+    else if (IsEqualGUID( iid, &IID_IDisplayInformation3_sg )) *out = &impl->info3_vtbl;
+    else if (IsEqualGUID( iid, &IID_IDisplayInformation4_sg )) *out = &impl->info4_vtbl;
+    else if (IsEqualGUID( iid, &IID_IWeakReferenceSource_di )) *out = &impl->weak_source_vtbl;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG info_addref( struct display_info *impl ) { return InterlockedIncrement( &impl->ref ); }
+static ULONG info_release( struct display_info *impl ) { return InterlockedDecrement( &impl->ref ); }   /* the thread's for life */
+
+#define INFO_BASE(prefix, from) \
+static HRESULT WINAPI prefix##_QueryInterface( void *iface, REFIID iid, void **out ) { return info_qi( from( iface ), iid, out ); } \
+static ULONG WINAPI prefix##_AddRef( void *iface ) { return info_addref( from( iface ) ); } \
+static ULONG WINAPI prefix##_Release( void *iface ) { return info_release( from( iface ) ); } \
+static HRESULT WINAPI prefix##_GetIids( void *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; } \
+static HRESULT WINAPI prefix##_GetRuntimeClassName( void *iface, HSTRING *name ) \
+{ return inspectable_name( L"Windows.Graphics.Display.DisplayInformation", name ); } \
+static HRESULT WINAPI prefix##_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+#define BASE_METHODS(prefix) \
+    prefix##_QueryInterface, prefix##_AddRef, prefix##_Release, prefix##_GetIids, prefix##_GetRuntimeClassName, prefix##_GetTrustLevel
+
+INFO_BASE(di, FROM_I)
+INFO_BASE(di2, FROM_I2)
+INFO_BASE(di3, FROM_I3)
+INFO_BASE(di4, FROM_I4)
+
+static HRESULT WINAPI add_event( void *iface, IUnknown *handler, EventRegistrationToken *token )
+{
+    if (!handler || !token) return E_POINTER;
+    token->value = InterlockedIncrement( &next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI remove_event( void *iface, EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI di_get_CurrentOrientation( void *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = orientation();
+    return S_OK;
+}
+
+static HRESULT WINAPI di_get_ResolutionScale( void *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = resolution_scale();
+    return S_OK;
+}
+
+static HRESULT WINAPI di_get_LogicalDpi( void *iface, FLOAT *value )
+{
+    if (!value) return E_POINTER;
+    *value = logical_dpi();
+    return S_OK;
+}
+
+static HRESULT WINAPI di_get_RawDpiX( void *iface, FLOAT *value )
+{
+    if (!value) return E_POINTER;
+    *value = raw_dpi( FALSE );
+    return S_OK;
+}
+
+static HRESULT WINAPI di_get_RawDpiY( void *iface, FLOAT *value )
+{
+    if (!value) return E_POINTER;
+    *value = raw_dpi( TRUE );
+    return S_OK;
+}
+
+static HRESULT WINAPI di_get_StereoEnabled( void *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI di_GetColorProfileAsync( void *iface, IInspectable **operation )
+{
+    FIXME( "%p: no color profile\n", iface );
+    if (operation) *operation = NULL;
+    return E_NOTIMPL;
+}
+
+static const void *info_vtbl[] =
+{
+    BASE_METHODS(di),
+    di_get_CurrentOrientation,
+    di_get_CurrentOrientation,        /* NativeOrientation: a monitor's is how it stands */
+    add_event, remove_event,          /* OrientationChanged */
+    di_get_ResolutionScale,
+    di_get_LogicalDpi,
+    di_get_RawDpiX,
+    di_get_RawDpiY,
+    add_event, remove_event,          /* DpiChanged */
+    di_get_StereoEnabled,
+    add_event, remove_event,          /* StereoEnabledChanged */
+    di_GetColorProfileAsync,
+    add_event, remove_event,          /* ColorProfileChanged */
+};
+C_ASSERT( ARRAY_SIZE(info_vtbl) == 22 );
+
+static HRESULT WINAPI di2_get_RawPixelsPerViewPixel( void *iface, DOUBLE *value )
+{
+    if (!value) return E_POINTER;
+    *value = logical_dpi() / 96.0;
+    return S_OK;
+}
+static const void *info2_vtbl[] = { BASE_METHODS(di2), di2_get_RawPixelsPerViewPixel };
+
+static HRESULT WINAPI di3_get_DiagonalSizeInInches( void *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;   /* not known: null, as for a projector */
+    return S_OK;
+}
+static const void *info3_vtbl[] = { BASE_METHODS(di3), di3_get_DiagonalSizeInInches };
+
+static HRESULT WINAPI di4_get_ScreenWidthInRawPixels( void *iface, UINT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = GetSystemMetrics( SM_CXSCREEN );
+    return S_OK;
+}
+static HRESULT WINAPI di4_get_ScreenHeightInRawPixels( void *iface, UINT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = GetSystemMetrics( SM_CYSCREEN );
+    return S_OK;
+}
+static const void *info4_vtbl[] = { BASE_METHODS(di4), di4_get_ScreenWidthInRawPixels, di4_get_ScreenHeightInRawPixels };
+
+/* held weakly: always resolves, the object is never freed */
+static HRESULT WINAPI ws_QueryInterface( void *iface, REFIID iid, void **out ) { return info_qi( FROM_WS( iface ), iid, out ); }
+static ULONG WINAPI ws_AddRef( void *iface ) { return info_addref( FROM_WS( iface ) ); }
+static ULONG WINAPI ws_Release( void *iface ) { return info_release( FROM_WS( iface ) ); }
+static HRESULT WINAPI ws_GetWeakReference( void *iface, void **out )
+{
+    struct display_info *impl = FROM_WS( iface );
+
+    if (!out) return E_POINTER;
+    info_addref( impl );
+    *out = &impl->weak_vtbl;
+    return S_OK;
+}
+static const void *weak_source_vtbl[] = { ws_QueryInterface, ws_AddRef, ws_Release, ws_GetWeakReference };
+
+static HRESULT WINAPI w_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference_di ))
+    {
+        info_addref( FROM_W( iface ) );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI w_AddRef( void *iface ) { return info_addref( FROM_W( iface ) ); }
+static ULONG WINAPI w_Release( void *iface ) { return info_release( FROM_W( iface ) ); }
+static HRESULT WINAPI w_Resolve( void *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    return info_qi( FROM_W( iface ), iid, out );
+}
+static const void *weak_vtbl[] = { w_QueryInterface, w_AddRef, w_Release, w_Resolve };
+
+/* ---- the statics ---- */
+
+static HRESULT WINAPI statics_QueryInterface( void *iface, REFIID iid, void **out );
+static ULONG WINAPI statics_AddRef( void *iface ) { return 2; }
+static ULONG WINAPI statics_Release( void *iface ) { return 1; }
+static HRESULT WINAPI statics_GetIids( void *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI statics_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return inspectable_name( L"Windows.Graphics.Display.DisplayInformation", name );
+}
+static HRESULT WINAPI statics_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI statics_GetForCurrentView( void *iface, IInspectable **out )
+{
+    struct display_info *impl;
+
+    TRACE( "%p\n", out );
+    if (!out) return E_POINTER;
+#ifdef SG_MUTANT_NO_DISPLAY_INFORMATION
+    return E_NOTIMPL;
+#endif
+    if (display_tls == TLS_OUT_OF_INDEXES)
+    {
+        DWORD index = TlsAlloc();
+        if (InterlockedCompareExchange( (LONG *)&display_tls, index, TLS_OUT_OF_INDEXES ) != TLS_OUT_OF_INDEXES)
+            TlsFree( index );
+    }
+    if (!(impl = TlsGetValue( display_tls )))
+    {
+        if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+        impl->vtbl = info_vtbl;
+        impl->info2_vtbl = info2_vtbl;
+        impl->info3_vtbl = info3_vtbl;
+        impl->info4_vtbl = info4_vtbl;
+        impl->weak_source_vtbl = weak_source_vtbl;
+        impl->weak_vtbl = weak_vtbl;
+        impl->ref = 1;   /* the thread's */
+        TlsSetValue( display_tls, impl );
+    }
+    info_addref( impl );
+    *out = (IInspectable *)&impl->vtbl;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_get_AutoRotationPreferences( void *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = auto_rotation;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_put_AutoRotationPreferences( void *iface, INT32 value )
+{
+    auto_rotation = value;
+    return S_OK;
+}
+
+static const void *statics_vtbl[] =
+{
+    statics_QueryInterface, statics_AddRef, statics_Release, statics_GetIids, statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    statics_GetForCurrentView,
+    statics_get_AutoRotationPreferences,
+    statics_put_AutoRotationPreferences,
+    add_event, remove_event,          /* DisplayContentsInvalidated */
+};
+C_ASSERT( ARRAY_SIZE(statics_vtbl) == 11 );
+
+struct display_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    const void *statics_vtbl;
+};
+
+static struct display_factory *factory_from_statics( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct display_factory, statics_vtbl );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct display_factory *impl = CONTAINING_RECORD( iface, struct display_factory, IActivationFactory_iface );
+
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IDisplayInformationStatics_sg )) *out = &impl->statics_vtbl;
+    if (*out) return S_OK;
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI statics_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    return factory_QueryInterface( &factory_from_statics( iface )->IActivationFactory_iface, iid, out );
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return inspectable_name( L"Windows.Graphics.Display.DisplayInformation", name );
+}
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance ) { return E_NOTIMPL; }
+
+static const IActivationFactoryVtbl display_factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release, factory_GetIids, factory_GetRuntimeClassName,
+    factory_GetTrustLevel, factory_ActivateInstance,
+};
+
+static struct display_factory display_factory_obj = { { &display_factory_vtbl }, statics_vtbl };
+IActivationFactory *display_information_factory = &display_factory_obj.IActivationFactory_iface;
