+void object_changed_implicit( struct compositor *compositor, IUnknown *owner, animatable_fn animatable, void *impl,
+                              ICompositionPropertySet *properties, IImplicitAnimationCollection *collection,
+                              const WCHAR *name, const void *old, size_t size )
+{
+    ICompositionAnimationBase *base;
+    ICompositionAnimation *animation;
+    struct animation *anim;
+    float starting[4] = { 0 };
+    HSTRING target = NULL;
+    const WCHAR *target_text;
+    HRESULT hr;
+
+    if (!collection || !(base = implicit_collection_find( collection, name ))) return;
+    hr = ICompositionAnimationBase_QueryInterface( base, &IID_ICompositionAnimation, (void **)&animation );
+    ICompositionAnimationBase_Release( base );
+    if (FAILED(hr)) return;
+    if (animation->lpVtbl != &animation_vtbl)
+    {
+        ICompositionAnimation_Release( animation );
+        return;
+    }
+    anim = impl_from_ICompositionAnimation( animation );
+    /* it animates its Target, the changed property if none */
+    target_text = WindowsGetStringRawBuffer( anim->target_name, NULL );
+    if (!WindowsGetStringLen( anim->target_name )) target_text = name;
+    if (SUCCEEDED(WindowsCreateString( target_text, wcslen( target_text ), &target )))
+    {
+        memcpy( starting, old, min( size, sizeof(starting) ) );
+        /* from the old value when it animates the changed property itself */
+        hr = start_animation( compositor, owner, animatable, impl, properties, target, animation,
+                              wcsicmp( target_text, name ) ? NULL : starting );
+        if (FAILED(hr)) WARN( "implicit animation of %s: %#lx.\n", debugstr_w( target_text ), hr );
+        WindowsDeleteString( target );
+    }
+    ICompositionAnimation_Release( animation );
+}
