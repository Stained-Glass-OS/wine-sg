+}
+
+static HRESULT WINAPI pair_get_Value( IKeyValuePair_HSTRING_ICompositionAnimationBase *iface, ICompositionAnimationBase **value )
+{
+    struct implicit_pair *impl = impl_from_IKeyValuePair_HSTRING_ICompositionAnimationBase( iface );
+
+    if (!value) return E_POINTER;
+    if ((*value = impl->value)) ICompositionAnimationBase_AddRef( *value );
+    return S_OK;
+}
