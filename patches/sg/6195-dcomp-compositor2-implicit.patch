+/*
+ * An ImplicitAnimationCollection maps a property name ("Offset") to the
+ * animation that runs when that property of an object holding the collection
+ * (CompositionObject.ImplicitAnimations) is changed: it runs from the old
+ * value (this.StartingValue) to the new one (this.FinalValue). Views and
+ * iterators are snapshots taken when they are made.
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "objidl.h"
+#include "composition_private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+static const WCHAR class_implicit[] = L"Windows.UI.Composition.ImplicitAnimationCollection";
+
+struct implicit_entry
+{
+    struct list entry;
+    HSTRING key;
+    ICompositionAnimationBase *value;
+};
+
+struct implicit_collection
+{
+    IImplicitAnimationCollection IImplicitAnimationCollection_iface;
+    IMap_HSTRING_ICompositionAnimationBase IMap_HSTRING_ICompositionAnimationBase_iface;
+    IIterable_IKeyValuePair_HSTRING_ICompositionAnimationBase IIterable_IKeyValuePair_HSTRING_ICompositionAnimationBase_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    struct compositor *compositor;
+    ICompositionPropertySet *properties;
+    SRWLOCK lock;
+    struct list entries;
+    UINT32 count;
+};
+
+/* a snapshot: a map view, and what iterators walk */
+struct implicit_view
+{
+    IMapView_HSTRING_ICompositionAnimationBase IMapView_HSTRING_ICompositionAnimationBase_iface;
+    IIterable_IKeyValuePair_HSTRING_ICompositionAnimationBase IIterable_IKeyValuePair_HSTRING_ICompositionAnimationBase_iface;
+    LONG ref;
+    UINT32 count;
+    HSTRING *keys;
+    ICompositionAnimationBase **values;
+};
+
+struct implicit_iterator
+{
+    IIterator_IKeyValuePair_HSTRING_ICompositionAnimationBase IIterator_IKeyValuePair_HSTRING_ICompositionAnimationBase_iface;
+    LONG ref;
+    struct implicit_view *view;
+    UINT32 index;
+};
+
+struct implicit_pair
+{
+    IKeyValuePair_HSTRING_ICompositionAnimationBase IKeyValuePair_HSTRING_ICompositionAnimationBase_iface;
+    LONG ref;
+    HSTRING key;
+    ICompositionAnimationBase *value;
+};
+
+static HRESULT class_name( const WCHAR *name, HSTRING *out )
+{
+    if (!out) return E_POINTER;
+    return WindowsCreateString( name, wcslen( name ), out );
+}
+
+static HRESULT iid_list( ULONG *iid_count, IID **iids, const IID *const *list, ULONG count )
+{
+    ULONG i;
+
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( count * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++) (*iids)[i] = *list[i];
+    *iid_count = count;
+    return S_OK;
+}
+
+static int key_compare( HSTRING a, HSTRING b )
+{
+    INT32 order = 0;
+    WindowsCompareStringOrdinal( a, b, &order );
+    return order;
+}
+
+/***********************************************************************
+ *          Key/value pairs
+ */
+
+static struct implicit_pair *impl_from_IKeyValuePair_HSTRING_ICompositionAnimationBase( IKeyValuePair_HSTRING_ICompositionAnimationBase *iface )
+{
+    return CONTAINING_RECORD( iface, struct implicit_pair, IKeyValuePair_HSTRING_ICompositionAnimationBase_iface );
+}
+
+static HRESULT WINAPI pair_QueryInterface( IKeyValuePair_HSTRING_ICompositionAnimationBase *iface, REFIID iid, void **out )
+{
+    struct implicit_pair *impl = impl_from_IKeyValuePair_HSTRING_ICompositionAnimationBase( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IKeyValuePair_HSTRING_ICompositionAnimationBase ))
+    {
+        *out = &impl->IKeyValuePair_HSTRING_ICompositionAnimationBase_iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI pair_AddRef( IKeyValuePair_HSTRING_ICompositionAnimationBase *iface )
+{
+    return InterlockedIncrement( &impl_from_IKeyValuePair_HSTRING_ICompositionAnimationBase( iface )->ref );
+}
+
+static ULONG WINAPI pair_Release( IKeyValuePair_HSTRING_ICompositionAnimationBase *iface )
+{
+    struct implicit_pair *impl = impl_from_IKeyValuePair_HSTRING_ICompositionAnimationBase( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->key );
+        if (impl->value) ICompositionAnimationBase_Release( impl->value );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI pair_GetIids( IKeyValuePair_HSTRING_ICompositionAnimationBase *iface, ULONG *count, IID **iids )
+{
+    static const IID *const list[] = { &IID_IKeyValuePair_HSTRING_ICompositionAnimationBase };
+    return iid_list( count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI pair_GetRuntimeClassName( IKeyValuePair_HSTRING_ICompositionAnimationBase *iface, HSTRING *name )
+{
