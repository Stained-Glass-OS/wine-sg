+static HRESULT pair_create( HSTRING key, ICompositionAnimationBase *value, IKeyValuePair_HSTRING_ICompositionAnimationBase **out )
+{
+    struct implicit_pair *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = WindowsDuplicateString( key, &impl->key )))
