 struct easing
 {
     enum easing_type type;
     Vector2 p1, p2;
+    /* a step function's */
+    INT32 steps, initial_step, final_step;
+    boolean initial_single, final_single;
 };
 
+/* steps of 1 / StepCount from InitialStep to FinalStep; a "single frame" first or last step
+ * shows only at progress 0 or 1 */
+static float ease_steps( const struct easing *easing, float x )
+{
+    INT32 k;
+
+    if (easing->steps <= 0) return x >= 1.0f ? 1.0f : 0.0f;
+    if (x <= 0.0f) k = easing->initial_step;
+    else if (x >= 1.0f) k = easing->final_step;
+    else
+    {
+        k = easing->initial_single ? (INT32)ceilf( x * easing->steps ) : (INT32)floorf( x * easing->steps );
+#ifndef SG_MUTANT_STEP_NO_SINGLE_FRAME
+        if (easing->initial_single && k <= easing->initial_step) k = easing->initial_step + 1;
+        if (easing->final_single && k >= easing->final_step) k = easing->final_step - 1;
+#endif
+        if (k < min( easing->initial_step, easing->final_step )) k = min( easing->initial_step, easing->final_step );
+        if (k > max( easing->initial_step, easing->final_step )) k = max( easing->initial_step, easing->final_step );
+    }
+    return (float)k / (float)easing->steps;
+}
