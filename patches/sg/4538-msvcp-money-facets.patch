+/* the moneypunct facet of a locale, as use_facet does */
+static const mpunct *money_use_mpunct(const locale *loc, BOOL intl, int type)
+{
+    static locale_id *ids[3][2] = {
+        {&moneypunct_char_local_id, &moneypunct_char_intl_id},
+        {&moneypunct_wchar_local_id, &moneypunct_wchar_intl_id},
+        {&moneypunct_short_local_id, &moneypunct_short_intl_id},
+    };
+    static size_t (__cdecl *getcat[3][2])(const locale_facet**, const locale*) = {
+        {moneypunct_char_local__Getcat, moneypunct_char_intl__Getcat},
+        {moneypunct_wchar_local__Getcat, moneypunct_wchar_intl__Getcat},
+        {moneypunct_short_local__Getcat, moneypunct_short_intl__Getcat},
+    };
+    static const mpunct *cache[3][2];
+    const locale_facet *fac;
+    _Lockit lock;
+
+    intl = !!intl;
+    _Lockit_ctor_locktype(&lock, _LOCK_LOCALE);
+    fac = locale__Getfacet(loc, locale_id_operator_size_t(ids[type][intl]));
+    if (!fac)
+    {
+        if (!cache[type][intl])
+        {
+            fac = NULL;
+            getcat[type][intl](&fac, loc);
+            call_locale_facet__Incref((locale_facet *)fac);
+            locale_facet_register((locale_facet *)fac);
+            cache[type][intl] = (const mpunct *)fac;
+        }
+        fac = &cache[type][intl]->facet;
+    }
+    _Lockit_dtor(&lock);
+    return (const mpunct *)fac;
+}
