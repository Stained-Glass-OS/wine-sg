+/* the pattern of C99's cs_precedes, sep_by_space and sign_posn */
+static void mpunct_makpat(money_pattern *pat, unsigned int sep, unsigned int precedes, unsigned int posn)
+{
+    char p[5];
+    int n = 0, i, spacer = -1;
+
+    if (sep > 2 || precedes > 1 || posn > 4)
+    {
+        static const money_pattern def = {{MONEY_symbol, MONEY_sign, MONEY_none, MONEY_value}};
+        *pat = def;
+        return;
+    }
+    if (precedes) { p[n++] = MONEY_symbol; p[n++] = MONEY_value; }
+    else { p[n++] = MONEY_value; p[n++] = MONEY_symbol; }
+    switch (posn)
+    {
+    case 0: /* parentheses: the sign first */
+    case 1: memmove(p + 1, p, n); p[0] = MONEY_sign; n++; break;
+    case 2: p[n++] = MONEY_sign; break;
+    case 3: case 4:
+        for (i = 0; i < n; i++) if (p[i] == MONEY_symbol) break;
+        if (posn == 4) i++;
+        memmove(p + i + 1, p + i, n - i); p[i] = MONEY_sign; n++;
+        break;
+    }
+    /* where the space goes: between symbol and value, or sign and symbol */
+    for (i = 0; i + 1 < n; i++)
+    {
+        int a = p[i], b = p[i + 1];
+        if (sep == 2 && ((a == MONEY_sign && b == MONEY_symbol) || (a == MONEY_symbol && b == MONEY_sign))) { spacer = i + 1; break; }
+        if (sep != 2 && ((a == MONEY_symbol && b == MONEY_value) || (a == MONEY_value && b == MONEY_symbol))) { spacer = i + 1; break; }
+    }
+    if (spacer < 0)  /* not adjacent: next to the value, never last */
+    {
+        for (i = 0; i < n; i++) if (p[i] == MONEY_value) break;
+        spacer = i + 1 < n ? i + 1 : i;
+    }
+    memmove(p + spacer + 1, p + spacer, n - spacer);
+    p[spacer] = sep ? MONEY_space : MONEY_none;
+    memcpy(pat->field, p, 4);
+}
+
+static char *money_strdup(const char *s)
+{
+    size_t len = strlen(s) + 1;
+    char *ret = operator_new(len);
+    memcpy(ret, s, len);
+    return ret;
+}
+
+int __cdecl _Mbrtowc(wchar_t *, const char *, size_t, _Mbstatet *, const _Cvtvec *);
+
+static wchar_t *money_wcsdup_mb(const char *s, const _Locinfo *locinfo)
+{
+    size_t len = strlen(s) + 1, i;
+    wchar_t *ret = operator_new(len * sizeof(wchar_t));
+    _Cvtvec cvt;
+
+    _Locinfo__Getcvt(locinfo, &cvt);
+    for (i = 0; *s; i++)
+    {
+        int r = _Mbrtowc(ret + i, s, MB_LEN_MAX, NULL, &cvt);
+        if (r <= 0) { ret[i] = (unsigned char)*s; r = 1; }
+        s += r;
+    }
+    ret[i] = 0;
+    return ret;
+}
+
+static void mpunct_tidy(mpunct *this)
+{
+    operator_delete(this->grouping);
+    operator_delete(this->curr_symbol);
+    operator_delete(this->positive_sign);
+    operator_delete(this->negative_sign);
+    this->grouping = NULL;
+    this->curr_symbol = this->positive_sign = this->negative_sign = NULL;
+}
+
+static void mpunct_init(mpunct *this, const _Locinfo *locinfo, BOOL wide, BOOL isdef)
+{
+    const struct lconv *lc = _Locinfo__Getlconv(locinfo);
+    const char *curr = this->intl ? lc->int_curr_symbol : lc->currency_symbol;
+    int frac = this->intl ? lc->int_frac_digits : lc->frac_digits;
+
+    this->grouping = money_strdup(isdef ? "" : lc->mon_grouping);
+    if (wide)
+    {
+        this->curr_symbol = money_wcsdup_mb(isdef ? "" : curr, locinfo);
+        this->positive_sign = money_wcsdup_mb(isdef ? "" : lc->positive_sign, locinfo);
+        this->negative_sign = money_wcsdup_mb(isdef ? "-" : (*lc->negative_sign ? lc->negative_sign : "-"), locinfo);
+    }
+    else
+    {
+        this->curr_symbol = money_strdup(isdef ? "" : curr);
+        this->positive_sign = money_strdup(isdef ? "" : lc->positive_sign);
+        this->negative_sign = money_strdup(isdef ? "-" : (*lc->negative_sign ? lc->negative_sign : "-"));
+    }
+    this->frac_digits = isdef || frac < 0 || frac == CHAR_MAX ? 0 : frac;
+    this->decimal_point = !isdef && *lc->mon_decimal_point ? (unsigned char)*lc->mon_decimal_point : '.';
+    this->thousands_sep = !isdef && *lc->mon_thousands_sep ? (unsigned char)*lc->mon_thousands_sep : ',';
+    if (isdef)
+    {
+        mpunct_makpat(&this->pos_format, 9, 9, 9);
+        mpunct_makpat(&this->neg_format, 9, 9, 9);
+    }
+    else
+    {
+        mpunct_makpat(&this->pos_format, lc->p_sep_by_space, lc->p_cs_precedes, lc->p_sign_posn);
+        mpunct_makpat(&this->neg_format, lc->n_sep_by_space, lc->n_cs_precedes, lc->n_sign_posn);
+    }
+}
