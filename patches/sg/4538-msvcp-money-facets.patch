+/* ---- money_get and money_put ---- */
+static BOOL money_isspace(wchar_t c)
+{
+    return c == ' ' || (c >= '\t' && c <= '\r');
+}
+
+/* the digits of a monetary value; *neg tells its sign; FALSE when the
+ * input does not match. Reads according to neg_format(), as the standard
+ * says. */
+#define MONEY_GET_FIELD(T, CT, ISIT) \
+static BOOL money_get_##T##_field(const mpunct *mp, ISIT *first, ISIT *last, ios_base *base, \
+        char *digits, size_t size, BOOL *neg) \
+{ \
+    const CT *pos = mp->positive_sign, *negs = mp->negative_sign, *sign = NULL, *sym = mp->curr_symbol; \
+    size_t nd = 0, frac = 0; \
+    int i, seen_point = 0; \
+    BOOL ok = TRUE; \
+ \
+    *neg = FALSE; \
+    for (i = 0; i < 4 && ok; i++) \
+    { \
+        CT c; \
+        switch (mp->neg_format.field[i]) \
+        { \
+        case MONEY_none: case MONEY_space: \
+            if (i == 3) break; \
+            if (mp->neg_format.field[i] == MONEY_space && \
+                    (!first->strbuf || !money_isspace(ISIT##_val(first)))) ok = FALSE; \
+            while (first->strbuf && money_isspace(ISIT##_val(first))) ISIT##_inc(first); \
+            break; \
+        case MONEY_symbol: \
+        { \
+            const CT *s = sym; \
+            BOOL req = (base->fmtfl & FMTFLAG_showbase) != 0; \
+            if (!*s) break; \
+            if (first->strbuf && ISIT##_val(first) == *s) \
+            { \
+                for (; *s && first->strbuf && ISIT##_val(first) == *s; s++) ISIT##_inc(first); \
+                if (*s) ok = FALSE; \
+            } \
+            else if (req) ok = FALSE; \
+            break; \
+        } \
+        case MONEY_sign: \
+            if (first->strbuf && *pos && ISIT##_val(first) == *pos) { sign = pos; ISIT##_inc(first); } \
+            else if (first->strbuf && *negs && ISIT##_val(first) == *negs) { sign = negs; *neg = TRUE; ISIT##_inc(first); } \
+            else if (!*pos) sign = NULL; \
+            else if (!*negs) { *neg = TRUE; } \
+            else ok = FALSE; \
+            break; \
+        case MONEY_value: \
+        { \
+            size_t start; \
+            while (first->strbuf) \
+            { \
+                c = ISIT##_val(first); \
+                if (c >= '0' && c <= '9') \
+                { \
+                    if (!seen_point || frac < (size_t)mp->frac_digits) \
+                    { \
+                        if (nd + 1 < size) digits[nd++] = c; \
+                        if (seen_point) frac++; \
+                    } \
+                    ISIT##_inc(first); \
+                    continue; \
+                } \
+                if (!seen_point && mp->frac_digits > 0 && c == mp->decimal_point) { seen_point = 1; ISIT##_inc(first); continue; } \
+                if (!seen_point && nd && c == mp->thousands_sep && *mp->grouping) { ISIT##_inc(first); continue; } \
+                break; \
+            } \
+            if (!nd) { ok = FALSE; break; } \
+            for (; frac < (size_t)mp->frac_digits && nd + 1 < size; frac++) digits[nd++] = '0'; \
+            /* no leading zeros, one zero at least */ \
+            for (start = 0; start + 1 < nd && digits[start] == '0'; start++); \
+            memmove(digits, digits + start, nd - start); \
+            nd -= start; \
+            break; \
+        } \
+        } \
+    } \
+    digits[nd] = 0; \
+    if (ok && sign && sign[1]) \
+    { \
+        const CT *s = sign + 1; \
+        for (; *s && first->strbuf && ISIT##_val(first) == *s; s++) ISIT##_inc(first); \
+        if (*s) ok = FALSE; \
+    } \
+    return ok; \
+}
