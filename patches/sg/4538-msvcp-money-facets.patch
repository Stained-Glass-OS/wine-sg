+/* money_put: formats digits by pos_format() or neg_format() */
+#define MONEY_PUT_FMT(T, CT, OSIT) \
+static void money_put_##T##_out(const mpunct *mp, OSIT *s, ios_base *base, CT fill, const char *digits) \
+{ \
+    BOOL neg = *digits == '-'; \
+    const money_pattern *pat = neg ? &mp->neg_format : &mp->pos_format; \
+    const CT *sign = neg ? mp->negative_sign : mp->positive_sign, *sym = mp->curr_symbol; \
+    CT buf[512]; \
+    int len = 0, i, j, pad_at = -1, nd, frac = mp->frac_digits, intd; \
+    char num[400]; \
+ \
+    if (neg) digits++; \
+    while (*digits == '0' && digits[1]) digits++; \
+    nd = strlen(digits); \
+    if (nd > 300) nd = 300; \
+    /* at least one integral digit */ \
+    for (i = 0; i < frac + 1 - nd; i++) num[i] = '0'; \
+    memcpy(num + i, digits, nd); \
+    nd += i; \
+    num[nd] = 0; \
+    intd = nd - frac; \
+    for (i = 0; i < 4; i++) \
+    { \
+        switch (pat->field[i]) \
+        { \
+        case MONEY_symbol: \
+            if (base->fmtfl & FMTFLAG_showbase) \
+                for (j = 0; sym[j] && len < 500; j++) buf[len++] = sym[j]; \
+            break; \
+        case MONEY_sign: \
+            if (*sign && !SG_MONEY_PUT_NO_SIGN) buf[len++] = sign[0]; \
+            break; \
+        case MONEY_value: \
+        { \
+            const char *g = mp->grouping; \
+            int group = *g > 0 && *g != CHAR_MAX ? *g : 0, count = 0, start = len; \
+            /* the integral digits, grouped from the right */ \
+            for (j = intd - 1; j >= 0; j--) \
+            { \
+                if (group && count == group && len < 500) \
+                { \
+                    buf[len++] = mp->thousands_sep; \
+                    count = 0; \
+                    if (g[1] > 0 && g[1] != CHAR_MAX) group = *++g; \
+                } \
+                buf[len++] = num[j]; \
+                count++; \
+            } \
+            for (j = 0; j < (len - start) / 2; j++) \
+            { \
+                CT t = buf[start + j]; buf[start + j] = buf[len - 1 - j]; buf[len - 1 - j] = t; \
+            } \
+            if (frac > 0) \
+            { \
+                buf[len++] = mp->decimal_point; \
+                for (j = intd; j < nd && len < 510; j++) buf[len++] = num[j]; \
+            } \
+            break; \
+        } \
+        case MONEY_space: \
+            pad_at = len; \
+            buf[len++] = fill; \
+            break; \
+        case MONEY_none: \
+            pad_at = len; \
+            break; \
+        } \
+    } \
+    if (*sign) for (j = 1; sign[j] && len < 510; j++) buf[len++] = sign[j]; \
+    /* the width */ \
+    { \
+        int width = base->wide > len ? base->wide : len, padn = width - len; \
+        int adjust = base->fmtfl & FMTFLAG_adjustfield; \
+        if (adjust != FMTFLAG_left && adjust != FMTFLAG_internal) for (j = 0; j < padn; j++) OSIT##_put(s, fill); \
+        for (j = 0; j < len; j++) \
+        { \
+            if (adjust == FMTFLAG_internal && j == (pad_at < 0 ? len : pad_at)) { int k; for (k = 0; k < padn; k++) OSIT##_put(s, fill); padn = 0; } \
+            OSIT##_put(s, buf[j]); \
+        } \
+        if (adjust == FMTFLAG_internal) for (j = 0; j < padn; j++) OSIT##_put(s, fill); \
+        if (adjust == FMTFLAG_left) for (j = 0; j < padn; j++) OSIT##_put(s, fill); \
+        base->wide = 0; \
+    } \
+}
