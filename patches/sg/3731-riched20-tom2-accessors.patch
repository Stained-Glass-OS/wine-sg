+/* ---- ITextDocument2Old / ITextDocument2 host-backed accessors ---- */
+
+static HWND services_hwnd( struct text_services *services )
+{
+    HWND hwnd = NULL;
+
+    if (services->editor->have_texthost2
+            && FAILED( ITextHost2_TxGetWindow( services->editor->texthost, &hwnd ) ))
+        hwnd = NULL;
+    return hwnd;
+}
+
+/* Word's default underline colours for effect colour indexes 1..16 (documented). */
+static COLORREF default_effect_color( struct text_services *services, LONG index )
+{
+    static const COLORREF colors[] =
+    {
+        0, RGB(0,0,0), RGB(0,0,255), RGB(0,255,255), RGB(0,255,0), RGB(255,0,255), RGB(255,0,0),
+        RGB(255,255,0), RGB(255,255,255), RGB(0,0,128), RGB(0,128,128), RGB(0,128,0), RGB(128,0,128),
+        RGB(128,0,0), RGB(128,128,0), RGB(128,128,128), RGB(192,192,192)
+    };
+
+    if (!index) return ITextHost_TxGetSysColor( services->editor->texthost, COLOR_WINDOWTEXT );
+    return colors[index];
+}
+
+static HRESULT services_get_effect_color( struct text_services *services, LONG index, COLORREF *cr )
+{
+    if (!cr || index < 0 || index > 16) return E_INVALIDARG;
+#ifdef SG_MUTANT_TOM_EFFECT_DEFAULT
+    *cr = default_effect_color( services, index );
+    return S_OK;
+#endif
+    *cr = services->effect_color_set[index] ? services->effect_color[index]
+                                            : default_effect_color( services, index );
+    return S_OK;
+}
+
+static HRESULT services_set_effect_color( struct text_services *services, LONG index, COLORREF cr )
+{
+    if (index < 0 || index > 16) return E_INVALIDARG;
+    services->effect_color[index] = cr;
+    services->effect_color_set[index] = TRUE;
+    return S_OK;
+}
+
+static HRESULT services_get_client_rect( struct text_services *services, LONG type, LONG *left, LONG *top,
+                                         LONG *right, LONG *bottom )
+{
+    RECT rect, inset;
+    HRESULT hr;
+    HWND hwnd;
+
+    if (!left || !top || !right || !bottom) return E_INVALIDARG;
+    if (FAILED(hr = ITextHost_TxGetClientRect( services->editor->texthost, &rect ))) return hr;
+
+    if (type & tomIncludeInset)
+    {
+        HDC hdc = GetDC( NULL );
+        int dpix = GetDeviceCaps( hdc, LOGPIXELSX ), dpiy = GetDeviceCaps( hdc, LOGPIXELSY );
+
+        ReleaseDC( NULL, hdc );
+        SetRectEmpty( &inset );
+        ITextHost_TxGetViewInset( services->editor->texthost, &inset );
+        /* the host gives the inset in HIMETRIC units */
+        rect.left += MulDiv( inset.left, dpix, 2540 );
+        rect.top += MulDiv( inset.top, dpiy, 2540 );
+        rect.right -= MulDiv( inset.right, dpix, 2540 );
+        rect.bottom -= MulDiv( inset.bottom, dpiy, 2540 );
+    }
+#ifdef SG_MUTANT_TOM_CLIENT_SCREEN
+    if (0)
+#else
+    if (!(type & tomClientCoord))
+#endif
+    {
+        POINT tl = { rect.left, rect.top }, br = { rect.right, rect.bottom };
+
+        if ((hwnd = services_hwnd( services )))
+        {
+            ClientToScreen( hwnd, &tl );
+            ClientToScreen( hwnd, &br );
+        }
+        rect.left = tl.x; rect.top = tl.y; rect.right = br.x; rect.bottom = br.y;
+    }
+    *left = rect.left; *top = rect.top; *right = rect.right; *bottom = rect.bottom;
+    return S_OK;
+}
+
+static HRESULT services_check_text_limit( struct text_services *services, LONG cch, LONG *exceed )
+{
+    LONG over;
+
+    if (!exceed) return E_INVALIDARG;
+#ifdef SG_MUTANT_TOM_LIMIT
+    over = ME_GetTextLength( services->editor ) + cch - services->editor->nTextLimit - 1;
+#else
+    over = ME_GetTextLength( services->editor ) + cch - services->editor->nTextLimit;
+#endif
+    *exceed = max( over, 0 );
+    return S_OK;
+}
+
+static HRESULT services_update( struct text_services *services, LONG scroll )
+{
+    if (scroll) editor_ensure_visible( services->editor, &services->editor->pCursors[0] );
+    return S_OK;
+}
+
+static HRESULT services_update_window( struct text_services *services )
+{
+    ITextHost_TxViewChange( services->editor->texthost, TRUE );
+    return S_OK;
+}
+
+static HRESULT services_get_imm_context( struct text_services *services, INT64 *context )
+{
+    if (!context) return E_INVALIDARG;
+    *context = (INT64)(ULONG_PTR)ITextHost_TxImmGetContext( services->editor->texthost );
+    return S_OK;
+}
+
+static HRESULT services_release_imm_context( struct text_services *services, INT64 context )
+{
+    ITextHost_TxImmReleaseContext( services->editor->texthost, (HIMC)(ULONG_PTR)context );
+    return S_OK;
+}
+
+static HRESULT services_get_property( struct text_services *services, LONG type, LONG *value )
+{
+    ME_TextEditor *editor = services->editor;
+    LONG from, to;
+
+    if (!value) return E_INVALIDARG;
+    switch (type)
+    {
+    case tomCanCopy:
+        ME_GetSelectionOfs( editor, &from, &to );
+#ifdef SG_MUTANT_TOM_CANCOPY
+        *value = tomTrue;
+#else
+        *value = from != to ? tomTrue : tomFalse;
+#endif
+        return S_OK;
+    case tomCanRedo:
+        *value = list_empty( &editor->redo_stack ) ? tomFalse : tomTrue;
+        return S_OK;
+    case tomCanUndo:
+        *value = list_empty( &editor->undo_stack ) ? tomFalse : tomTrue;
+        return S_OK;
+    case tomUndoLimit:
+        *value = editor->nUndoLimit;
+        return S_OK;
+    }
+    FIXME( "property %#lx not implemented\n", type );
+    return E_INVALIDARG;
+}
+
+static HRESULT services_set_property( struct text_services *services, LONG type, LONG value )
+{
+    HRESULT res;
+
+    switch (type)
+    {
+    case tomUndoLimit:
+#ifndef SG_MUTANT_TOM_UNDOLIMIT
+        editor_handle_message( services->editor, EM_SETUNDOLIMIT, value, 0, &res );
+#endif
+        return S_OK;
+    case tomCanCopy:
+    case tomCanRedo:
+    case tomCanUndo:
+        return E_INVALIDARG;   /* read-only */
+    }
+    FIXME( "property %#lx not implemented\n", type );
+    return E_INVALIDARG;
+}
