+static HRESULT folder_from_path( WCHAR *path, IStorageFolder **value );
+
 /* %LOCALAPPDATA%\\Packages\\<family>\\<sub>, created, as a StorageFolder */
 static HRESULT get_folder( struct application_data *impl, const WCHAR *sub, IStorageFolder **value )
 {
-    IStorageFolderStatics *statics;
-    IAsyncOperation_StorageFolder *operation;
     WCHAR path[MAX_PATH * 2], *p;
-    HSTRING class_name, str;
     DWORD len;
-    HRESULT hr;
 
     if (!value) return E_POINTER;
     *value = NULL;
@@ -986,6 +1008,27 @@
     }
     if (!CreateDirectoryW( path, NULL ) && GetLastError() != ERROR_ALREADY_EXISTS)
         return HRESULT_FROM_WIN32( GetLastError() );
+    return folder_from_path( path, value );
+}
+
+/* PATH (made with its parents) as a StorageFolder */
+static HRESULT folder_from_path( WCHAR *path, IStorageFolder **value )
+{
+    IStorageFolderStatics *statics;
+    IAsyncOperation_StorageFolder *operation;
+    HSTRING class_name, str;
+    WCHAR *p;
+    HRESULT hr;
+
+    for (p = path + 3; *p; p++)
+    {
+        if (*p != '\\') continue;
+        *p = 0;
+        CreateDirectoryW( path, NULL );
+        *p = '\\';
+    }
+    if (!CreateDirectoryW( path, NULL ) && GetLastError() != ERROR_ALREADY_EXISTS)
+        return HRESULT_FROM_WIN32( GetLastError() );
 
     if (FAILED(hr = WindowsCreateString( RuntimeClass_Windows_Storage_StorageFolder,
                                          wcslen( RuntimeClass_Windows_Storage_StorageFolder ), &class_name ))) return hr;
@@ -1128,6 +1171,86 @@
     application_data_get_RoamingStorageQuota,
 };
 
+/* Stained Glass OS 7717: IApplicationData2, IApplicationData3 */
+DEFINE_IINSPECTABLE( application_data2, IApplicationData2, struct application_data, IApplicationData_iface )
+
+static HRESULT WINAPI application_data2_get_LocalCacheFolder( IApplicationData2 *iface, IStorageFolder **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return get_folder( impl_from_IApplicationData2( iface ), L"LocalCache", value );
+}
+
+static const struct IApplicationData2Vtbl application_data2_vtbl =
+{
+    application_data2_QueryInterface,
+    application_data2_AddRef,
+    application_data2_Release,
+    application_data2_GetIids,
+    application_data2_GetRuntimeClassName,
+    application_data2_GetTrustLevel,
+    application_data2_get_LocalCacheFolder,
+};
+
+DEFINE_IINSPECTABLE( application_data3, IApplicationData3, struct application_data, IApplicationData_iface )
+
+/* %LOCALAPPDATA%\Publishers\<publisher id>\<folder>: shared by the publisher's packages */
+static BOOL publisher_folder_path( struct application_data *impl, HSTRING name, WCHAR *path, DWORD size )
+{
+    const WCHAR *folder = WindowsGetStringRawBuffer( name, NULL ), *id = wcsrchr( impl->family, '_' );
+    DWORD len;
+
+    if (!id || !folder || !folder[0] || wcspbrk( folder, L"\\/:*?\"<>|" ) || !wcscmp( folder, L"." ) || !wcscmp( folder, L".." ))
+        return FALSE;
+    if (!(len = GetEnvironmentVariableW( L"LOCALAPPDATA", path, size )) || len >= size) return FALSE;
+    return swprintf( path + len, size - len, L"\\Publishers\\%ls\\%ls", id + 1, folder ) > 0;
+}
+
+static HRESULT WINAPI application_data3_GetPublisherCacheFolder( IApplicationData3 *iface, HSTRING name, IStorageFolder **value )
+{
+    struct application_data *impl = impl_from_IApplicationData3( iface );
+    WCHAR path[MAX_PATH * 2];
+
+    TRACE( "iface %p, name %s, value %p.\n", iface, debugstr_hstring( name ), value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!publisher_folder_path( impl, name, path, ARRAY_SIZE(path) )) return E_INVALIDARG;
+    return folder_from_path( path, value );
+}
+
+static HRESULT WINAPI application_data3_ClearPublisherCacheFolderAsync( IApplicationData3 *iface, HSTRING name, IAsyncAction **operation )
+{
+    struct application_data *impl = impl_from_IApplicationData3( iface );
+    WCHAR path[MAX_PATH * 2];
+
+    TRACE( "iface %p, name %s, operation %p.\n", iface, debugstr_hstring( name ), operation );
+    if (!operation) return E_POINTER;
+    if (!publisher_folder_path( impl, name, path, ARRAY_SIZE(path) )) return E_INVALIDARG;
+    clear_directory( path );
+    return async_action_create( S_OK, operation );
+}
+
+static HRESULT WINAPI application_data3_get_SharedLocalFolder( IApplicationData3 *iface, IStorageFolder **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    /* only when the AllowSharedLocalAppData policy is on, which it is not */
+    *value = NULL;
+    return S_OK;
+}
+
+static const struct IApplicationData3Vtbl application_data3_vtbl =
+{
+    application_data3_QueryInterface,
+    application_data3_AddRef,
+    application_data3_Release,
+    application_data3_GetIids,
+    application_data3_GetRuntimeClassName,
+    application_data3_GetTrustLevel,
+    application_data3_GetPublisherCacheFolder,
+    application_data3_ClearPublisherCacheFolderAsync,
+    application_data3_get_SharedLocalFolder,
+};
+
 DEFINE_IINSPECTABLE( application_data_statics, IApplicationDataStatics, struct application_data_statics, IActivationFactory_iface )
 
 static HRESULT WINAPI application_data_statics_get_Current( IApplicationDataStatics *iface, IApplicationData **value )
@@ -1147,6 +1270,8 @@
     {
         if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
         impl->IApplicationData_iface.lpVtbl = &application_data_vtbl;
+        impl->IApplicationData2_iface.lpVtbl = &application_data2_vtbl;
+        impl->IApplicationData3_iface.lpVtbl = &application_data3_vtbl;
         impl->ref = 1;
         wcscpy( impl->family, family );
         list_init( &impl->handlers );
