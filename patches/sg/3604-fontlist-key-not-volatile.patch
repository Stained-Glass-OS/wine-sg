                                     '1','1','C','E','-','B','F','C','1','-','0','8','0','0','2','B','E','1','0','3','1','8','}'};
     static const WCHAR classmW[] = {'\\','C','l','a','s','s','\\','{','4','D','3','6','E','9','6','E','-','E','3','2','5','-',
                                     '1','1','C','E','-','B','F','C','1','-','0','8','0','0','2','B','E','1','0','3','1','8','}'};
