         { videoW, ARRAY_SIZE(videoW) }, { gfxW, ARRAY_SIZE(gfxW) }, { mapW, ARRAY_SIZE(mapW) },
         { pciW, ARRAY_SIZE(pciW) }, { dispW, ARRAY_SIZE(dispW) },
         { classdW, ARRAY_SIZE(classdW) }, { classmW, ARRAY_SIZE(classmW) },
