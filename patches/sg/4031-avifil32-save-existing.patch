From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] avifil32: Save and append to existing AVI files without overwriting them.

A loaded AVI file left dwNextFramePos at 0, so frames written to an
existing file and the index saved on close went to the start of the file,
over its header (a file opened read/write and given new stream info came
back starting with idx1). It is now the end of the loaded 'movi' list.

When the header to save no longer fits in front of the existing 'movi'
data (a stream name or a larger format added, or a file written without
header padding), the 'movi' list is moved to the next AVI_HEADERSIZE
boundary and the index offsets with it; the mmio buffer is emptied around
the copy so stale buffered bytes are not written back over the moved data.
The header size counts the streams' extra chunks. With that, stream info
set with IAVIStream::SetInfo marks the file for saving again.
---
 dlls/avifil32/avifile.c | 80 +++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 77 insertions(+), 3 deletions(-)

diff --git a/dlls/avifil32/avifile.c b/dlls/avifil32/avifile.c
index 4e43169..6eed62a 100644
--- a/dlls/avifil32/avifile.c
+++ b/dlls/avifil32/avifile.c
@@ -1320,9 +1320,7 @@ static HRESULT WINAPI IAVIStream_fnSetInfo(IAVIStream *iface, AVISTREAMINFOW *in
   if (info->dwScale == 0 || info->dwRate == 0)
     return AVIERR_BADPARAM;
 
-  /* The members EditStreamSetInfo changes. They go into the header when the
-   * file is saved for written data; the change alone does not rewrite the
-   * file, whose header space may be smaller than the one written here. */
+  /* the members EditStreamSetInfo changes; the header is written on close */
   This->sInfo.wLanguage = info->wLanguage;
   This->sInfo.wPriority = info->wPriority;
   This->sInfo.dwStart   = info->dwStart;
@@ -1332,6 +1330,7 @@ static HRESULT WINAPI IAVIStream_fnSetInfo(IAVIStream *iface, AVISTREAMINFOW *in
   This->sInfo.rcFrame   = info->rcFrame;
   memcpy(This->sInfo.szName, info->szName, sizeof(info->szName));
   This->sInfo.dwEditCount++;
+  This->paf->fDirty = TRUE;
 
   return AVIERR_OK;
 }
@@ -1479,6 +1478,9 @@ static DWORD   AVIFILE_ComputeMoviStart(IAVIFileImpl *This)
       dwPos += 2 * sizeof(DWORD) + ((pStream->cbHandlerData + 1) & ~1U);
     if (pStream->sInfo.szName[0])
       dwPos += 2 * sizeof(DWORD) + ((lstrlenW(pStream->sInfo.szName) + 1) & ~1U);
+    /* the extra chunks are kept with their chunk headers */
+    if (pStream->extra.lp != NULL)
+      dwPos += pStream->extra.cb;
   }
 
   if (This->dwMoviChunkPos == 0) {
@@ -1833,6 +1835,9 @@ static HRESULT AVIFILE_LoadFile(IAVIFileImpl *This)
 
   This->dwMoviChunkPos = ckLIST1.dwDataOffset;
   This->dwIdxChunkPos  = ckLIST1.cksize + ckLIST1.dwDataOffset;
+  /* frames written to the file and the saved index go after the loaded data
+   * (this was 0, so writing to an existing file wrote over its header) */
+  This->dwNextFramePos = This->dwIdxChunkPos;
   if (mmioAscend(This->hmmio, &ckLIST1, 0) != S_OK)
     return AVIERR_FILEREAD;
 
@@ -2087,6 +2092,59 @@ static void AVIFILE_SamplesToBlock(const IAVIStreamImpl *This, LPLONG pos, LPLON
   *pos = block;
 }
 
+/* Move the 'movi' list of an existing file (LIST header, data and the free
+ * space up to dwNextFramePos) by delta bytes towards the end of the file, and
+ * the offsets that point into it. */
+static HRESULT AVIFILE_MoveMovi(IAVIFileImpl *This, DWORD delta)
+{
+  DWORD begin = This->dwMoviChunkPos - 2 * sizeof(DWORD);
+  DWORD end = This->dwNextFramePos, size, nStream, n;
+  BYTE *buffer;
+
+  TRACE("(%p) moving %#lx-%#lx by %#lx\n", This, begin, end, delta);
+
+  if (!(buffer = malloc(0x10000)))
+    return AVIERR_MEMORY;
+
+  /* Copy from the end, the ranges may overlap. The mmio buffer is emptied
+   * around the copy so that none of it is written back over the moved data. */
+  mmioFlush(This->hmmio, MMIO_EMPTYBUF);
+  while (end > begin) {
+    size = min(end - begin, 0x10000);
+    end -= size;
+    if (mmioSeek(This->hmmio, end, SEEK_SET) == -1 ||
+        mmioRead(This->hmmio, (HPSTR)buffer, size) != size ||
+        mmioSeek(This->hmmio, end + delta, SEEK_SET) == -1 ||
+        mmioWrite(This->hmmio, (HPSTR)buffer, size) != size) {
+      free(buffer);
+      return AVIERR_FILEWRITE;
+    }
+    mmioFlush(This->hmmio, MMIO_EMPTYBUF);
+  }
+  free(buffer);
+
+  This->dwMoviChunkPos += delta;
+  This->dwNextFramePos += delta;
+  if (This->ckLastRecord.dwDataOffset)
+    This->ckLastRecord.dwDataOffset += delta;
+  for (n = 0; n < This->nIdxRecords; n++)
+    This->idxRecords[n].dwChunkOffset += delta;
+
+  for (nStream = 0; nStream < This->fInfo.dwStreams; nStream++) {
+    IAVIStreamImpl *pStream = This->ppStreams[nStream];
+
+    /* the index holds absolute file offsets; unused entries are 0 */
+    for (n = 0; n < pStream->nIdxFrames; n++)
+      if (pStream->idxFrames[n].dwChunkOffset)
+        pStream->idxFrames[n].dwChunkOffset += delta;
+    for (n = 0; n < pStream->nIdxFmtChanges; n++)
+      if (pStream->idxFmtChanges[n].dwChunkOffset)
+        pStream->idxFmtChanges[n].dwChunkOffset += delta;
+  }
+
+  return AVIERR_OK;
+}
+
 static HRESULT AVIFILE_SaveFile(IAVIFileImpl *This)
 {
   MainAVIHeader   MainAVIHdr;
@@ -2112,6 +2170,22 @@ static HRESULT AVIFILE_SaveFile(IAVIFileImpl *This)
 
   AVIFILE_UpdateInfo(This);
 
+  /* An existing file has only the header space it was written with; when the
+   * header grew (a stream name, a larger format) the data has to move, or the
+   * header would run into it. The gap left must take a JUNK chunk. */
+  dwPos = AVIFILE_ComputeMoviStart(This);
+  if (dwPos > This->dwMoviChunkPos + sizeof(DWORD) ||
+      (dwPos < This->dwMoviChunkPos + sizeof(DWORD) &&
+       This->dwMoviChunkPos + sizeof(DWORD) - dwPos < 2 * sizeof(DWORD))) {
+    DWORD start = (dwPos + AVI_HEADERSIZE) & ~(AVI_HEADERSIZE - 1);
+
+    if (start - dwPos < 2 * sizeof(DWORD))
+      start += AVI_HEADERSIZE;
+    hr = AVIFILE_MoveMovi(This, start - (This->dwMoviChunkPos + sizeof(DWORD)));
+    if (FAILED(hr))
+      return hr;
+  }
+
   assert(This->fInfo.dwScale != 0);
 
   memset(&MainAVIHdr, 0, sizeof(MainAVIHdr));
