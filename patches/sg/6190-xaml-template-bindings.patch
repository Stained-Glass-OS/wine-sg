+
+/*
+ * A Binding made in markup -- {Binding Path, RelativeSource={RelativeSource TemplatedParent}} in a
+ * control template (WinUI 2's TabView shows its add button so) -- is set up where it is assigned:
+ * to the templated parent's property, as a TemplateBinding is, or to the element's own (Self).
+ * Bindings to a DataContext are not made yet: the member keeps its value.  Interface identity per
+ * windows-rs (MIT).
+ */
+
+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+enum bkind { B_BINDING, B_RELATIVE_SOURCE, B_PROPERTY_PATH, B_TEMPLATE_BINDING };
+
+struct bobj
+{
+    struct dobj d;
+    struct xiface if0, if1;
+    enum bkind kind;
+    WCHAR *path;                    /* a PropertyPath's */
+};
+
+static struct xaml_property *prop_path, *prop_mode, *prop_source, *prop_relative_source, *prop_element_name,
+                            *prop_converter, *prop_converter_parameter, *prop_converter_language, *prop_rs_mode,
+                            *prop_tb_property;
+
+static BOOL WINAPI init_bindings( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR b[] = L"Windows.UI.Xaml.Data.Binding", rs[] = L"Windows.UI.Xaml.Data.RelativeSource";
+
+    prop_path = xaml_property_register( b, L"Path", L"Windows.UI.Xaml.PropertyPath", NULL, FALSE, NULL );
+    prop_mode = xaml_property_register( b, L"Mode", L"Windows.UI.Xaml.Data.BindingMode", xbox_int32( 1 ), FALSE, NULL );
+    prop_source = xaml_property_register( b, L"Source", L"Object", NULL, FALSE, NULL );
+    prop_relative_source = xaml_property_register( b, L"RelativeSource", L"Windows.UI.Xaml.Data.RelativeSource", NULL, FALSE, NULL );
+    prop_element_name = xaml_property_register( b, L"ElementName", L"String", xbox_string( L"" ), FALSE, NULL );
+    prop_converter = xaml_property_register( b, L"Converter", L"Windows.UI.Xaml.Data.IValueConverter", NULL, FALSE, NULL );
+    prop_converter_parameter = xaml_property_register( b, L"ConverterParameter", L"Object", NULL, FALSE, NULL );
+    prop_converter_language = xaml_property_register( b, L"ConverterLanguage", L"String", xbox_string( L"" ), FALSE, NULL );
+    prop_rs_mode = xaml_property_register( rs, L"Mode", L"Windows.UI.Xaml.Data.RelativeSourceMode", xbox_int32( 0 ), FALSE, NULL );
+    /* compiled markup's {TemplateBinding X} as an object (for members of type Object: ContentPresenter.Content) */
+    prop_tb_property = xaml_property_register( L"Windows.UI.Xaml.Data.TemplateBinding", L"Property", L"String", NULL, FALSE, NULL );
+    return TRUE;
+}
+
+static void bindings_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_bindings, NULL, NULL );
+}
+
+static struct bobj *bobj_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct bobj, d.obj );
+}
+
+static HRESULT get_object( struct bobj *obj, struct xaml_property *prop, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    return dobj_get_value( &obj->d, prop, value );
+}
+
+static HRESULT get_int( struct bobj *obj, struct xaml_property *prop, INT32 *value )
+{
+    IInspectable *box = NULL;
+
+    if (!value) return E_POINTER;
+    dobj_get_value( &obj->d, prop, &box );
+    *value = xunbox_enum( box, NULL, 0 );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+static HRESULT get_string( struct bobj *obj, struct xaml_property *prop, HSTRING *value )
+{
+    IInspectable *box = NULL;
+    WCHAR *str;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    dobj_get_value( &obj->d, prop, &box );
+    str = xunbox_string( box );
+    if (box) IInspectable_Release( box );
+    hr = WindowsCreateString( str, str ? wcslen( str ) : 0, value );
+    free( str );
+    return hr;
+}
+
+static HRESULT put_boxed( struct bobj *obj, struct xaml_property *prop, IInspectable *box )
+{
+    HRESULT hr;
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &obj->d, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+/* Binding */
+static HRESULT WINAPI binding_get_Path( struct xiface *iface, IInspectable **value ) { return get_object( bobj_from_iface( iface ), prop_path, value ); }
+static HRESULT WINAPI binding_put_Path( struct xiface *iface, IInspectable *value ) { return dobj_set_value( &bobj_from_iface( iface )->d, prop_path, value ); }
+static HRESULT WINAPI binding_get_Mode( struct xiface *iface, INT32 *value ) { return get_int( bobj_from_iface( iface ), prop_mode, value ); }
+static HRESULT WINAPI binding_put_Mode( struct xiface *iface, INT32 value ) { return put_boxed( bobj_from_iface( iface ), prop_mode, xbox_int32( value ) ); }
+static HRESULT WINAPI binding_get_Source( struct xiface *iface, IInspectable **value ) { return get_object( bobj_from_iface( iface ), prop_source, value ); }
+static HRESULT WINAPI binding_put_Source( struct xiface *iface, IInspectable *value ) { return dobj_set_value( &bobj_from_iface( iface )->d, prop_source, value ); }
+static HRESULT WINAPI binding_get_RelativeSource( struct xiface *iface, IInspectable **value ) { return get_object( bobj_from_iface( iface ), prop_relative_source, value ); }
+static HRESULT WINAPI binding_put_RelativeSource( struct xiface *iface, IInspectable *value ) { return dobj_set_value( &bobj_from_iface( iface )->d, prop_relative_source, value ); }
+static HRESULT WINAPI binding_get_ElementName( struct xiface *iface, HSTRING *value ) { return get_string( bobj_from_iface( iface ), prop_element_name, value ); }
+static HRESULT WINAPI binding_put_ElementName( struct xiface *iface, HSTRING value ) { return put_boxed( bobj_from_iface( iface ), prop_element_name, xbox_string( WindowsGetStringRawBuffer( value, NULL ) ) ); }
+static HRESULT WINAPI binding_get_Converter( struct xiface *iface, IInspectable **value ) { return get_object( bobj_from_iface( iface ), prop_converter, value ); }
+static HRESULT WINAPI binding_put_Converter( struct xiface *iface, IInspectable *value ) { return dobj_set_value( &bobj_from_iface( iface )->d, prop_converter, value ); }
+static HRESULT WINAPI binding_get_ConverterParameter( struct xiface *iface, IInspectable **value ) { return get_object( bobj_from_iface( iface ), prop_converter_parameter, value ); }
+static HRESULT WINAPI binding_put_ConverterParameter( struct xiface *iface, IInspectable *value ) { return dobj_set_value( &bobj_from_iface( iface )->d, prop_converter_parameter, value ); }
+static HRESULT WINAPI binding_get_ConverterLanguage( struct xiface *iface, HSTRING *value ) { return get_string( bobj_from_iface( iface ), prop_converter_language, value ); }
+static HRESULT WINAPI binding_put_ConverterLanguage( struct xiface *iface, HSTRING value ) { return put_boxed( bobj_from_iface( iface ), prop_converter_language, xbox_string( WindowsGetStringRawBuffer( value, NULL ) ) ); }
+
+static const void *binding_vtbl[] =
+{
+    IDataBinding_STUBS,
+    [IDataBinding_Path] = binding_get_Path, [IDataBinding_SetPath] = binding_put_Path,
+    [IDataBinding_Mode] = binding_get_Mode, [IDataBinding_SetMode] = binding_put_Mode,
+    [IDataBinding_Source] = binding_get_Source, [IDataBinding_SetSource] = binding_put_Source,
+    [IDataBinding_RelativeSource] = binding_get_RelativeSource, [IDataBinding_SetRelativeSource] = binding_put_RelativeSource,
+    [IDataBinding_ElementName] = binding_get_ElementName, [IDataBinding_SetElementName] = binding_put_ElementName,
+    [IDataBinding_Converter] = binding_get_Converter, [IDataBinding_SetConverter] = binding_put_Converter,
+    [IDataBinding_ConverterParameter] = binding_get_ConverterParameter, [IDataBinding_SetConverterParameter] = binding_put_ConverterParameter,
+    [IDataBinding_ConverterLanguage] = binding_get_ConverterLanguage, [IDataBinding_SetConverterLanguage] = binding_put_ConverterLanguage,
+};
+static const void *binding_base_vtbl[] = { IBindingBase_STUBS };
+
+/* RelativeSource */
+static HRESULT WINAPI rs_get_Mode( struct xiface *iface, INT32 *value ) { return get_int( bobj_from_iface( iface ), prop_rs_mode, value ); }
+static HRESULT WINAPI rs_put_Mode( struct xiface *iface, INT32 value ) { return put_boxed( bobj_from_iface( iface ), prop_rs_mode, xbox_int32( value ) ); }
+static const void *rs_vtbl[] = { IRelativeSource_STUBS, [IRelativeSource_Mode] = rs_get_Mode, [IRelativeSource_SetMode] = rs_put_Mode };
+
+/* PropertyPath */
+static HRESULT WINAPI path_get_Path( struct xiface *iface, HSTRING *value )
+{
+    struct bobj *obj = bobj_from_iface( iface );
+    if (!value) return E_POINTER;
+    return WindowsCreateString( obj->path, obj->path ? wcslen( obj->path ) : 0, value );
+}
+static const void *path_vtbl[] = { IPropertyPath_STUBS, [IPropertyPath_Path] = path_get_Path };
+
+static void bobj_destroy( struct xobj *obj )
+{
+    struct bobj *b = CONTAINING_RECORD( obj, struct bobj, d.obj );
+    free( b->path );
+    dobj_cleanup( &b->d );
+}
+
+static const struct xiface_entry binding_ifaces[] =
+{
+    { &IID_IDataBinding, offsetof(struct bobj, if0) },
+    { &IID_IBindingBase, offsetof(struct bobj, if1) },
+    DOBJ_IFACES(struct dobj),
+};
+static const struct xiface_entry rs_ifaces[] = { { &IID_IRelativeSource, offsetof(struct bobj, if0) }, DOBJ_IFACES(struct dobj) };
+static const struct xiface_entry path_ifaces[] = { { &IID_IPropertyPath, offsetof(struct bobj, if0) }, DOBJ_IFACES(struct dobj) };
+static const struct xiface_entry tb_ifaces[] = { DOBJ_IFACES(struct dobj) };
+
+static const struct xclass binding_classes[] =
+{
+    [B_BINDING] = { L"Windows.UI.Xaml.Data.Binding", binding_ifaces, ARRAY_SIZE(binding_ifaces), bobj_destroy },
+    [B_RELATIVE_SOURCE] = { L"Windows.UI.Xaml.Data.RelativeSource", rs_ifaces, ARRAY_SIZE(rs_ifaces), bobj_destroy },
+    [B_PROPERTY_PATH] = { L"Windows.UI.Xaml.PropertyPath", path_ifaces, ARRAY_SIZE(path_ifaces), bobj_destroy },
+    [B_TEMPLATE_BINDING] = { L"Windows.UI.Xaml.Data.TemplateBinding", tb_ifaces, ARRAY_SIZE(tb_ifaces), bobj_destroy },
+};
+
+static struct bobj *new_bobj( enum bkind kind, IInspectable *outer )
+{
+    struct bobj *obj;
+
+    bindings_init();
+    if (!(obj = calloc( 1, sizeof(*obj) ))) return NULL;
+    obj->kind = kind;
+    obj->if0.vtbl = kind == B_BINDING ? binding_vtbl : kind == B_RELATIVE_SOURCE ? rs_vtbl : path_vtbl;
+    obj->if1.vtbl = binding_base_vtbl;
+    dobj_init( &obj->d, &binding_classes[kind], outer );
+    return obj;
+}
+
+static struct bobj *bobj_from_inspectable( IInspectable *iface, enum bkind kind )
+{
+    struct dobj *d = dobj_from_inspectable( iface );
+    if (!d || d->obj.cls != &binding_classes[kind]) return NULL;
+    return CONTAINING_RECORD( d, struct bobj, d );
+}
+
+/* a PropertyPath from markup's text (a reference) */
+IInspectable *xaml_property_path( const WCHAR *path )
+{
+    struct bobj *obj = new_bobj( B_PROPERTY_PATH, NULL );
+
+    if (!obj) return NULL;
+    obj->path = wcsdup( path ? path : L"" );
+    return (IInspectable *)&obj->if0;
+}
+
+/* ---- factories ---- */
+
+#define COMPOSE(name, kind) \
+static HRESULT WINAPI name( struct xfiface *iface, IInspectable *outer, IInspectable **inner, IInspectable **value ) \
+{ \
+    struct bobj *obj; \
+    if (!value) return E_POINTER; \
+    if (outer && !inner) return E_INVALIDARG; \
+    if (!(obj = new_bobj( kind, outer ))) return E_OUTOFMEMORY; \
+    if (outer) \
+    { \
+        *inner = &obj->d.obj.IInspectable_inner; \
+        IUnknown_AddRef( obj->d.obj.outer ); \
+    } \
+    *value = (IInspectable *)&obj->if0; \
+    return S_OK; \
+}
+COMPOSE(binding_new, B_BINDING)
+COMPOSE(rs_new, B_RELATIVE_SOURCE)
+
+static HRESULT WINAPI path_new( struct xfiface *iface, HSTRING path, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    return (*value = xaml_property_path( WindowsGetStringRawBuffer( path, NULL ) )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static const void *binding_factory_vtbl[] = { IBindingFactory_FSTUBS, [IBindingFactory_new] = binding_new };
+static const void *rs_factory_vtbl[] = { IRelativeSourceFactory_FSTUBS, [IRelativeSourceFactory_new] = rs_new };
+static const void *path_factory_vtbl[] = { IPropertyPathFactory_FSTUBS, [IPropertyPathFactory_CreateInstance] = path_new };
+
+static HRESULT activate_binding( IInspectable **out )
+{
+    struct bobj *obj = new_bobj( B_BINDING, NULL );
+    if (!obj) return E_OUTOFMEMORY;
+    *out = (IInspectable *)&obj->if0;
+    return S_OK;
+}
+static HRESULT activate_tb( IInspectable **out )
+{
+    struct bobj *obj = new_bobj( B_TEMPLATE_BINDING, NULL );
+    if (!obj) return E_OUTOFMEMORY;
+    IUnknown_QueryInterface( obj->d.obj.outer, &IID_IInspectable, (void **)out );
+    IUnknown_Release( obj->d.obj.outer );
+    return S_OK;
+}
+static HRESULT activate_rs( IInspectable **out )
+{
+    struct bobj *obj = new_bobj( B_RELATIVE_SOURCE, NULL );
+    if (!obj) return E_OUTOFMEMORY;
+    *out = (IInspectable *)&obj->if0;
+    return S_OK;
+}
+
+static struct xfactory binding_factory_obj =
+    { { &xfactory_vtbl }, L"Windows.UI.Xaml.Data.Binding", { &IID_IBindingFactory }, { { binding_factory_vtbl } }, activate_binding };
+static struct xfactory rs_factory_obj =
+    { { &xfactory_vtbl }, L"Windows.UI.Xaml.Data.RelativeSource", { &IID_IRelativeSourceFactory }, { { rs_factory_vtbl } }, activate_rs };
+static struct xfactory tb_factory_obj =
+    { { &xfactory_vtbl }, L"Windows.UI.Xaml.Data.TemplateBinding", { NULL }, { { NULL } }, activate_tb };
+static struct xfactory path_factory_obj =
+    { { &xfactory_vtbl }, L"Windows.UI.Xaml.PropertyPath", { &IID_IPropertyPathFactory }, { { path_factory_vtbl } }, NULL };
+
+IActivationFactory *xaml_binding_factory( const WCHAR *name )
+{
+    if (!wcscmp( name, binding_factory_obj.name )) return &binding_factory_obj.IActivationFactory_iface;
+    if (!wcscmp( name, rs_factory_obj.name )) return &rs_factory_obj.IActivationFactory_iface;
+    if (!wcscmp( name, path_factory_obj.name )) return &path_factory_obj.IActivationFactory_iface;
+    if (!wcscmp( name, tb_factory_obj.name )) return &tb_factory_obj.IActivationFactory_iface;
+    return NULL;
+}
+
+/* ---- a Binding assigned to a member ---- */
+
+/* TRUE when VALUE is a Binding: it is set up on OBJ's member NAME (or left, when it is not one we make) */
+BOOL xaml_binding_assign( IInspectable *value, IInspectable *obj, const WCHAR *name, struct uielem *templated_parent )
+{
+    struct bobj *binding = value ? bobj_from_inspectable( value, B_BINDING ) : NULL, *rs, *path;
+    IInspectable *rs_obj = NULL, *path_obj = NULL;
+    INT32 mode = 0;
+
+    if (!binding && value && (binding = bobj_from_inspectable( value, B_TEMPLATE_BINDING )))
+    {
+        /* {TemplateBinding Property} as an object */
+        IInspectable *box = NULL;
+        WCHAR *source;
+        dobj_get_value( &binding->d, prop_tb_property, &box );
+        source = xunbox_string( box );
+        if (box) IInspectable_Release( box );
+#ifndef SG_MUTANT_TEMPLATE_BINDING_OBJECT_IGNORED
+        if (source && templated_parent) xaml_template_bind( templated_parent, obj, name, source );
+#endif
+        free( source );
+        return TRUE;
+    }
+    if (!binding) return FALSE;
+    dobj_get_value( &binding->d, prop_relative_source, &rs_obj );
+    dobj_get_value( &binding->d, prop_path, &path_obj );
+    if ((rs = rs_obj ? bobj_from_inspectable( rs_obj, B_RELATIVE_SOURCE ) : NULL)) get_int( rs, prop_rs_mode, &mode );
+    path = path_obj ? bobj_from_inspectable( path_obj, B_PROPERTY_PATH ) : NULL;
+#ifdef SG_MUTANT_BINDING_IGNORED
+    mode = -1;
+#endif
+    if (mode == 1 && templated_parent && path && path->path)
+    {
+        TRACE( "%s: {Binding %s, RelativeSource TemplatedParent}\n", debugstr_w( name ), debugstr_w( path->path ) );
+        xaml_template_bind( templated_parent, obj, name, path->path );
+    }
+    else if (mode == 2 && uielem_from_inspectable( obj ) && path && path->path)
+    {
+        TRACE( "%s: {Binding %s, RelativeSource Self}\n", debugstr_w( name ), debugstr_w( path->path ) );
+        xaml_template_bind( uielem_from_inspectable( obj ), obj, name, path->path );
+    }
+    else FIXME( "%s: a Binding (relative source mode %d, path %s) not made yet\n", debugstr_w( name ), mode,
+                debugstr_w( path ? path->path : NULL ) );
+    if (rs_obj) IInspectable_Release( rs_obj );
+    if (path_obj) IInspectable_Release( path_obj );
+    return TRUE;
+}
