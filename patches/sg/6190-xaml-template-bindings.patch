+namespace Windows.UI.Xaml.Data {
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(3f7a0c6b-d00f-4730-8c1d-48e16c46f9ca)]
+    interface IBinding : IInspectable {}
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(ff42bb08-c39e-4f7e-8434-a1569083883c)]
+    interface IBindingFactory : IInspectable {}
+    /* composable on Windows; marked activatable so that widl registers it */
+    [activatable(Windows.Foundation.UniversalApiContract, 1.0), contract(Windows.Foundation.UniversalApiContract, 1.0),
