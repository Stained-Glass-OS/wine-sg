index b104f43..fe32b1c 100644
--- a/dlls/windows.ui.xaml/Makefile.in
+++ b/dlls/windows.ui.xaml/Makefile.in
@@ -5,6 +5,7 @@ IMPORTS = combase ole32 xmllite d2d1 dwrite windowscodecs user32 advapi32 uuid
 SOURCES = \
 	accel.c \
 	animation.c \
+	binding.c \
 	application.c \
 	automation.c \
 	bindinghelper.c \
