@@ -722,16 +725,55 @@ static HRESULT WINAPI wave_stream_sink_ProcessSample(IMFStreamSink *iface, IMFSa
 static HRESULT WINAPI wave_stream_sink_PlaceMarker(IMFStreamSink *iface, MFSTREAMSINK_MARKER_TYPE marker_type,
         const PROPVARIANT *marker_value, const PROPVARIANT *context_value)
 {
-    FIXME("%p, %d, %p, %p.\n", iface, marker_type, marker_value, context_value);
+    struct wave_sink *sink = impl_from_IMFStreamSink(iface);
+    HRESULT hr;
+
+    TRACE("%p, %d, %p, %p.\n", iface, marker_type, marker_value, context_value);
+
+#ifndef SG_MUTANT_SNK_MARKER_RANGE
+    if ((unsigned int)marker_type > MFSTREAMSINK_MARKER_EVENT)
+        return E_INVALIDARG;
+#endif
+
+    EnterCriticalSection(&sink->cs);
+
+    if (sink->flags & SINK_SHUT_DOWN)
+        hr = MF_E_STREAMSINK_REMOVED;
+    else
+    {
+        /* Samples are written as they are delivered, so nothing is pending
+         * ahead of the marker: it is reported right away, with its context. */
+        hr = IMFMediaEventQueue_QueueEventParamVar(sink->stream_event_queue, MEStreamSinkMarker, &GUID_NULL,
+#ifdef SG_MUTANT_SNK_MARKER_CONTEXT
+                S_OK, NULL);
+#else
+                S_OK, context_value);
+#endif
+    }
+
+    LeaveCriticalSection(&sink->cs);
 
-    return E_NOTIMPL;
+    return hr;
 }
 
 static HRESULT WINAPI wave_stream_sink_Flush(IMFStreamSink *iface)
 {
-    FIXME("%p.\n", iface);
+    struct wave_sink *sink = impl_from_IMFStreamSink(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&sink->cs);
 
-    return E_NOTIMPL;
+    /* Nothing is queued inside the sink: every sample was written as it arrived. */
+#ifndef SG_MUTANT_SNK_SHUTDOWN
+    if (sink->flags & SINK_SHUT_DOWN)
+        hr = MF_E_STREAMSINK_REMOVED;
+#endif
+
+    LeaveCriticalSection(&sink->cs);
+
+    return hr;
 }
 
 static const IMFStreamSinkVtbl wave_stream_sink_vtbl =
@@ -807,9 +849,18 @@ static HRESULT WINAPI wave_sink_clock_sink_OnClockRestart(IMFClockStateSink *ifa
 
 static HRESULT WINAPI wave_sink_clock_sink_OnClockSetRate(IMFClockStateSink *iface, MFTIME systime, float rate)
 {
-    FIXME("%p, %s, %f.\n", iface, debugstr_time(systime), rate);
+    struct wave_sink *sink = impl_from_IMFClockStateSink(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %s, %f.\n", iface, debugstr_time(systime), rate);
+
+    /* The sink is rateless: the samples are written as they come, at any rate. */
+    EnterCriticalSection(&sink->cs);
+    if (sink->flags & SINK_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    LeaveCriticalSection(&sink->cs);
 
-    return E_NOTIMPL;
+    return hr;
 }
 
 static const IMFClockStateSinkVtbl wave_sink_clock_sink_vtbl =
@@ -843,18 +894,77 @@ static ULONG WINAPI wave_sink_type_handler_Release(IMFMediaTypeHandler *iface)
     return IMFStreamSink_Release(&sink->IMFStreamSink_iface);
 }
 
+static HRESULT wave_sink_clone_media_type(IMFMediaType *src, IMFMediaType **ret)
+{
+    IMFMediaType *type;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&type)))
+        return hr;
+    if (SUCCEEDED(hr = IMFMediaType_CopyAllItems(src, (IMFAttributes *)type)))
+        *ret = type;
+    else
+        IMFMediaType_Release(type);
+
+    return hr;
+}
+
+/* The sink writes uncompressed audio that MFCreateWaveFormatExFromMFMediaType() can describe. */
+static HRESULT wave_sink_check_media_type(IMFMediaType *type, WAVEFORMATEX **fmt)
+{
+    UINT32 size, channels, rate, bits;
+    GUID major, subtype;
+
+#ifdef SG_MUTANT_SNK_TYPE_CHECK
+    if (!fmt)
+        return S_OK;
+#endif
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_MAJOR_TYPE, &major)) || !IsEqualGUID(&major, &MFMediaType_Audio))
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype))
+            || (!IsEqualGUID(&subtype, &MFAudioFormat_PCM) && !IsEqualGUID(&subtype, &MFAudioFormat_Float)))
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, &channels)) || !channels
+            || FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, &rate)) || !rate
+            || FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_BITS_PER_SAMPLE, &bits)) || !bits)
+        return MF_E_INVALIDMEDIATYPE;
+
+    if (fmt)
+        return MFCreateWaveFormatExFromMFMediaType(type, fmt, &size, 0);
+    return S_OK;
+}
+
 static HRESULT WINAPI wave_sink_type_handler_IsMediaTypeSupported(IMFMediaTypeHandler *iface,
         IMFMediaType *in_type, IMFMediaType **out_type)
 {
-    FIXME("%p, %p, %p.\n", iface, in_type, out_type);
+    struct wave_sink *sink = impl_from_IMFMediaTypeHandler(iface);
+
+    TRACE("%p, %p, %p.\n", iface, in_type, out_type);
 
-    return E_NOTIMPL;
+    if (out_type)
+        *out_type = NULL;
+
+    if (!in_type)
+        return E_POINTER;
+
+    if (sink->flags & SINK_SHUT_DOWN)
+        return MF_E_STREAMSINK_REMOVED;
+
+    return wave_sink_check_media_type(in_type, NULL);
 }
 
 static HRESULT WINAPI wave_sink_type_handler_GetMediaTypeCount(IMFMediaTypeHandler *iface, DWORD *count)
 {
+    struct wave_sink *sink = impl_from_IMFMediaTypeHandler(iface);
+
     TRACE("%p, %p.\n", iface, count);
 
+    if (!count)
+        return E_POINTER;
+
+    if (sink->flags & SINK_SHUT_DOWN)
+        return MF_E_STREAMSINK_REMOVED;
+
     *count = 1;
 
     return S_OK;
@@ -863,25 +973,91 @@ static HRESULT WINAPI wave_sink_type_handler_GetMediaTypeCount(IMFMediaTypeHandl
 static HRESULT WINAPI wave_sink_type_handler_GetMediaTypeByIndex(IMFMediaTypeHandler *iface, DWORD index,
         IMFMediaType **media_type)
 {
-    FIXME("%p, %lu, %p.\n", iface, index, media_type);
+    struct wave_sink *sink = impl_from_IMFMediaTypeHandler(iface);
+    HRESULT hr;
+
+    TRACE("%p, %lu, %p.\n", iface, index, media_type);
+
+    if (!media_type)
+        return E_POINTER;
+
+    EnterCriticalSection(&sink->cs);
 
-    return E_NOTIMPL;
+    if (sink->flags & SINK_SHUT_DOWN)
+        hr = MF_E_STREAMSINK_REMOVED;
+    else if (index)
+        hr = MF_E_NO_MORE_TYPES;
+    else
+        hr = wave_sink_clone_media_type(sink->media_type, media_type);
+
+    LeaveCriticalSection(&sink->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI wave_sink_type_handler_SetCurrentMediaType(IMFMediaTypeHandler *iface,
         IMFMediaType *media_type)
 {
-    FIXME("%p, %p.\n", iface, media_type);
+    struct wave_sink *sink = impl_from_IMFMediaTypeHandler(iface);
+    IMFMediaType *clone = NULL;
+    WAVEFORMATEX *fmt = NULL;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, media_type);
 
-    return E_NOTIMPL;
+    if (!media_type)
+        return E_POINTER;
+
+    EnterCriticalSection(&sink->cs);
+
+    if (sink->flags & SINK_SHUT_DOWN)
+        hr = MF_E_STREAMSINK_REMOVED;
+#ifndef SG_MUTANT_SNK_TYPE_LOCK
+    else if (sink->flags & SINK_HEADER_WRITTEN)
+        hr = MF_E_INVALIDREQUEST; /* the format is in the file already */
+#endif
+    else if (SUCCEEDED(hr = wave_sink_check_media_type(media_type, &fmt))
+            && SUCCEEDED(hr = wave_sink_clone_media_type(media_type, &clone)))
+    {
+        fmt->nAvgBytesPerSec = fmt->nSamplesPerSec * fmt->nChannels * fmt->wBitsPerSample / 8;
+        fmt->nBlockAlign = fmt->nChannels * fmt->wBitsPerSample / 8;
+#ifndef SG_MUTANT_SNK_TYPE_APPLY
+        CoTaskMemFree(sink->fmt);
+        sink->fmt = fmt;
+        fmt = NULL;
+#endif
+        IMFMediaType_Release(sink->media_type);
+        sink->media_type = clone;
+    }
+
+    LeaveCriticalSection(&sink->cs);
+
+    CoTaskMemFree(fmt);
+
+    return hr;
 }
 
 static HRESULT WINAPI wave_sink_type_handler_GetCurrentMediaType(IMFMediaTypeHandler *iface,
         IMFMediaType **media_type)
 {
-    FIXME("%p, %p.\n", iface, media_type);
+    struct wave_sink *sink = impl_from_IMFMediaTypeHandler(iface);
