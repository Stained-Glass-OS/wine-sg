From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfsrcsnk: WAVE sink stream sink markers/flush, media type handler, OnClockSetRate; media source rate control and byte stream handler

- Stream sink: PlaceMarker queues MEStreamSinkMarker with the context value at
  once (samples are written as delivered, nothing is pending), E_INVALIDARG for a
  marker type above MFSTREAMSINK_MARKER_EVENT; Flush is S_OK; both give
  MF_E_STREAMSINK_REMOVED after Shutdown.
- Media type handler: the sink keeps the media type it was created with;
  GetCurrentMediaType/GetMediaTypeByIndex(0) hand out copies, index 1 is
  MF_E_NO_MORE_TYPES, IsMediaTypeSupported accepts PCM/float audio with channels,
  rate and bit depth (MF_E_INVALIDMEDIATYPE otherwise), SetCurrentMediaType
  replaces the format written to the file header and is MF_E_INVALIDREQUEST once
  the header was written; E_POINTER checks, MF_E_STREAMSINK_REMOVED after Shutdown.
  The conformance test's todo_wine on GetCurrentMediaType is removed.
- OnClockSetRate: S_OK (the sink is rateless), MF_E_SHUTDOWN after Shutdown.
- Media source IMFRateControl::SetRate: no FIXME, MF_E_SHUTDOWN after Shutdown,
  MESourceRateChanged carries the new rate. Byte stream handler: only
  MF_RESOLUTION_MEDIASOURCE is required in BeginCreateObject (other flags steer
  plugin selection), GetMaxNumberOfBytesRequiredForResolution is S_OK with
  16 KiB, CancelObjectCreation is MF_E_UNEXPECTED (no cookie is handed out).

---
diff --git a/dlls/mfsrcsnk/media_source.c b/dlls/mfsrcsnk/media_source.c
index ac5f013..5259e4e 100644
--- a/dlls/mfsrcsnk/media_source.c
+++ b/dlls/mfsrcsnk/media_source.c
@@ -1040,7 +1040,7 @@ static HRESULT WINAPI media_source_IMFRateControl_SetRate(IMFRateControl *iface,
     struct media_source *source = media_source_from_IMFRateControl(iface);
     HRESULT hr;
 
-    FIXME("source %p, thin %d, rate %f, stub!\n", source, thin, rate);
+    TRACE("source %p, thin %d, rate %f.\n", source, thin, rate);
 
     if (rate < 0.0f)
         return MF_E_REVERSE_UNSUPPORTED;
@@ -1051,10 +1051,20 @@ static HRESULT WINAPI media_source_IMFRateControl_SetRate(IMFRateControl *iface,
         return hr;
 
     EnterCriticalSection(&source->cs);
-    source->rate = rate;
+    if (source->state == SOURCE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        PROPVARIANT value;
+
+        source->rate = rate;
+        value.vt = VT_R4;
+        value.fltVal = rate;
+        hr = IMFMediaEventQueue_QueueEventParamVar(source->queue, MESourceRateChanged, &GUID_NULL, S_OK, &value);
+    }
     LeaveCriticalSection(&source->cs);
 
-    return IMFMediaEventQueue_QueueEventParamVar(source->queue, MESourceRateChanged, &GUID_NULL, S_OK, NULL);
+    return hr;
 }
 
 static HRESULT WINAPI media_source_IMFRateControl_GetRate(IMFRateControl *iface, BOOL *thin, float *rate)
@@ -1800,8 +1810,9 @@ static HRESULT WINAPI byte_stream_handler_BeginCreateObject(IMFByteStreamHandler
         *cookie = NULL;
     if (!stream)
         return E_INVALIDARG;
-    if (flags != MF_RESOLUTION_MEDIASOURCE)
-        FIXME("Unimplemented flags %#lx\n", flags);
+    /* The other flags only steer plugin selection and are no concern of this handler. */
+    if (!(flags & MF_RESOLUTION_MEDIASOURCE))
+        return E_INVALIDARG;
 
     if (FAILED(hr = IMFByteStream_GetCapabilities(stream, &caps)))
         return hr;
@@ -1847,15 +1858,21 @@ static HRESULT WINAPI byte_stream_handler_EndCreateObject(IMFByteStreamHandler *
 static HRESULT WINAPI byte_stream_handler_CancelObjectCreation(IMFByteStreamHandler *iface, IUnknown *cookie)
 {
     struct byte_stream_handler *handler = byte_stream_handler_from_IMFByteStreamHandler(iface);
-    FIXME("handler %p, cookie %p, stub!\n", handler, cookie);
-    return E_NOTIMPL;
+    TRACE("handler %p, cookie %p.\n", handler, cookie);
+    /* No cookie is handed out by BeginCreateObject: the source is created and
+     * queued at once, so there is no creation left to cancel. */
+    return MF_E_UNEXPECTED;
 }
 
 static HRESULT WINAPI byte_stream_handler_GetMaxNumberOfBytesRequiredForResolution(IMFByteStreamHandler *iface, QWORD *bytes)
 {
     struct byte_stream_handler *handler = byte_stream_handler_from_IMFByteStreamHandler(iface);
-    FIXME("handler %p, bytes %p, stub!\n", handler, bytes);
-    return E_NOTIMPL;
+    TRACE("handler %p, bytes %p.\n", handler, bytes);
+    if (!bytes)
+        return E_POINTER;
+    /* Enough to recognize the container formats handled here. */
+    *bytes = 0x4000;
+    return S_OK;
 }
 
 static const IMFByteStreamHandlerVtbl byte_stream_handler_vtbl =
