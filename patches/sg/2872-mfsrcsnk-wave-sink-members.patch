@@ -133,6 +134,8 @@ static ULONG WINAPI wave_sink_Release(IMFFinalizableMediaSink *iface)
         if (sink->stream_event_queue)
             IMFMediaEventQueue_Release(sink->stream_event_queue);
         IMFByteStream_Release(sink->bytestream);
