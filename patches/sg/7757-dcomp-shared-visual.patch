index 682f312..91942c9 100644
--- a/dlls/dcomp/dcomp_private.h
+++ b/dlls/dcomp/dcomp_private.h
@@ -47,5 +47,6 @@ HRESULT dc_create_surface(IDXGIDevice *dxgi_device, UINT width, UINT height, DXG
 HRESULT dc_create_surface_from_handle(IDXGIDevice *dxgi_device, HANDLE handle, void **out);
 HRESULT dc_create_surface_from_hwnd(IDXGIDevice *dxgi_device, HWND window, void **out);
 IUnknown *dc_surface_get_presenter(IUnknown *content);
+HWND dc_surface_get_window(IUnknown *content);
 
 #endif
diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 4864828..e84b892 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -55,6 +55,24 @@ struct wined3d_device_parent;
 
 WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
 
+/* Stained Glass OS: a visual shared with another process (the desktop device's partner interface,
+ * below). The process that made it writes where it last committed it -- its window and the
+ * matrix to that window -- and wakes the process that opened it, which composes the visuals it
+ * put there into that window. */
+struct shared_visual_state
+{
+    LONG generation;
+    ULONG64 window;
+    D2D_MATRIX_3X2_F matrix;
+    WCHAR wake_name[64];
+};
+
+struct shared_watch;
+
+/* the desktop device's partner interface (below) */
+static const GUID IID_IDCompositionDesktopDevicePartner =
+        {0xd14b6158, 0xc3fa, 0x4bce, {0x9c, 0x1f, 0xb6, 0x1d, 0x86, 0x65, 0xea, 0xb0}};
+
 struct composition_visual
 {
     IDCompositionVisual2 IDCompositionVisual2_iface;
@@ -72,6 +90,8 @@ struct composition_visual
     IUnknown *content;
     struct composition_visual **children;
     unsigned int child_count, child_capacity;
+    struct shared_visual_state *shared;
+    HANDLE shared_section, shared_wake;
 };
 
 struct composition_target
@@ -82,6 +102,7 @@ struct composition_target
     HWND window;
     struct composition_visual *root;
     struct composition_target *next;
+    struct shared_watch *watch;   /* a target for a visual shared by another process */
 };
 
 struct composition_device
@@ -95,6 +116,19 @@ struct composition_device
     BOOL is_desktop;
 };
 
+/* A target for a visual another process shares (OpenSharedVisualTarget, below). Its visuals are
+ * composed by a thread of its own, woken when the sharing process commits the visual (or this
+ * process commits the target), into the window the shared visual was last committed to. */
+struct shared_watch
+{
+    struct composition_device *device;
+    struct composition_target *target;    /* cleared (under the device's lock) when it goes */
+    struct shared_visual_state *state;
+    HANDLE wake, kick;
+    LONG quit;
+    HWND container;
+};
+
 static const IDCompositionVisual2Vtbl composition_visual_vtbl;
 
 static struct composition_visual *unsafe_impl_from_IDCompositionVisual(IDCompositionVisual *iface)
@@ -157,6 +191,9 @@ static ULONG STDMETHODCALLTYPE visual_Release(IDCompositionVisual2 *iface)
         if (visual->clip_object) IDCompositionClip_Release(visual->clip_object);
         for (i = 0; i < visual->child_count; ++i)
             IDCompositionVisual2_Release(&visual->children[i]->IDCompositionVisual2_iface);
+        if (visual->shared) UnmapViewOfFile(visual->shared);
+        if (visual->shared_wake) CloseHandle(visual->shared_wake);
+        if (visual->shared_section) CloseHandle(visual->shared_section);
         free(visual->children);
         free(visual);
     }
@@ -513,6 +550,12 @@ static ULONG STDMETHODCALLTYPE target_Release(IDCompositionTarget *iface)
             *entry = target->next;
             break;
         }
+        if (target->watch)
+        {
+            target->watch->target = NULL;
+            target->watch->quit = 1;
+            SetEvent(target->watch->kick);
+        }
         LeaveCriticalSection(&device->cs);
         if (target->root)
             IDCompositionVisual2_Release(&target->root->IDCompositionVisual2_iface);
@@ -572,7 +615,11 @@ static HRESULT STDMETHODCALLTYPE device_QueryInterface(IDCompositionDevice *ifac
      * DCompositionCreateDevice2 makes); the original device is not. */
 #ifndef SG_MUTANT_DD_QI
     if (impl_from_IDCompositionDevice(iface)->is_desktop
-            && (IsEqualGUID(iid, &IID_IDCompositionDevice2) || IsEqualGUID(iid, &IID_IDCompositionDesktopDevice)))
+            && (IsEqualGUID(iid, &IID_IDCompositionDevice2) || IsEqualGUID(iid, &IID_IDCompositionDesktopDevice)
+#ifndef SG_MUTANT_DC_NO_PARTNER
+                || IsEqualGUID(iid, &IID_IDCompositionDesktopDevicePartner)
+#endif
+                ))
     {
         IDCompositionDevice_AddRef(iface);
         *out = &impl_from_IDCompositionDevice(iface)->IDCompositionDesktopDevice_iface;
@@ -623,12 +670,118 @@ static DWORD WINAPI glass_frame_changed(void *arg)
 }
 
 static void commit_visual(HWND window, struct composition_visual *visual, const D2D_MATRIX_3X2_F *parent_matrix,
-        LONGLONG now)
+        LONGLONG now, struct shared_watch *watch);
+
+static BOOL CALLBACK register_container_class(INIT_ONCE *once, void *param, void **context)
+{
+    WNDCLASSW class = {0};
+
+    class.lpfnWndProc = DefWindowProcW;
+    class.hInstance = GetModuleHandleW(L"dcomp.dll");
+    class.lpszClassName = L"__wine_dcomp_shared_visual";
+    RegisterClassW(&class);
+    return TRUE;
+}
+
+/* A window of this process shown through a visual of another process's window (a surface made
+ * with CreateSurfaceFromHwnd, in a shared visual's target). Windows redirects its pixels into the
+ * visual; here the window itself goes into the other process's window, as a child of a
+ * transparent container whose origin is the screen's: its process keeps it where the visual is on
+ * the screen (WebView2 does, for its host's pane), so it lands there, clipped to the window. */
+static void embed_window(struct shared_watch *watch, HWND window, HWND source)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    POINT origin;
+    LONG style;
+
+#ifdef SG_MUTANT_DC_SHARED_NO_EMBED
+    return;
+#endif
+    if (watch->container && GetAncestor(watch->container, GA_PARENT) != window)
+    {
+        DestroyWindow(watch->container);
+        watch->container = NULL;
+    }
+    if (!watch->container)
+    {
+        InitOnceExecuteOnce(&once, register_container_class, NULL, NULL);
+        if (!(watch->container = CreateWindowExW(WS_EX_TRANSPARENT | WS_EX_NOPARENTNOTIFY,
+                L"__wine_dcomp_shared_visual", NULL, WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN | WS_CLIPSIBLINGS,
+                0, 0, 1, 1, window, NULL, GetModuleHandleW(L"dcomp.dll"), NULL)))
+        {
+            WARN("No container in window %p, error %lu.\n", window, GetLastError());
+            return;
+        }
+    }
+    origin.x = origin.y = 0;
+    ClientToScreen(window, &origin);
+    SetWindowPos(watch->container, HWND_TOP, -origin.x, -origin.y,
+            GetSystemMetrics(SM_XVIRTUALSCREEN) + GetSystemMetrics(SM_CXVIRTUALSCREEN) + origin.x,
+            GetSystemMetrics(SM_YVIRTUALSCREEN) + GetSystemMetrics(SM_CYVIRTUALSCREEN) + origin.y,
+            SWP_NOACTIVATE);
+    if (GetAncestor(source, GA_PARENT) != watch->container)
+    {
+        style = GetWindowLongW(source, GWL_STYLE);
+        SetWindowLongW(source, GWL_STYLE, (style & ~WS_POPUP) | WS_CHILD);
+        SetParent(source, watch->container);
+    }
+    if (!IsWindowVisible(source))
+        ShowWindow(source, SW_SHOWNA);
+}
+
+static DWORD WINAPI shared_watch_thread(void *arg)
+{
+    struct shared_watch *watch = arg;
+    struct composition_device *device = watch->device;
+    HANDLE handles[2] = { watch->kick, watch->wake };
+    struct composition_visual *root;
+    D2D_MATRIX_3X2_F matrix;
+    LONG seen = -1, generation;
+    LARGE_INTEGER now;
+    HWND window;
+    DWORD ret;
+    MSG msg;
+
+    while (!watch->quit)
+    {
+        ret = MsgWaitForMultipleObjects(watch->wake ? 2 : 1, handles, FALSE, 1000, QS_ALLINPUT);
+        while (PeekMessageW(&msg, 0, 0, 0, PM_REMOVE)) DispatchMessageW(&msg);
+        if (watch->quit) break;
+        if (ret == WAIT_TIMEOUT && watch->state->generation == seen) continue;
+
+        EnterCriticalSection(&device->cs);
+        root = watch->target ? watch->target->root : NULL;
+        if (root) IDCompositionVisual2_AddRef(&root->IDCompositionVisual2_iface);
+        generation = watch->state->generation;
+        window = (HWND)(ULONG_PTR)watch->state->window;
+        matrix = watch->state->matrix;
+        LeaveCriticalSection(&device->cs);
+        seen = generation;
+        if (!root) continue;
+        if (window && IsWindow(window))
+        {
+            QueryPerformanceCounter(&now);
+            commit_visual(window, root, &matrix, now.QuadPart, watch);
+        }
+        IDCompositionVisual2_Release(&root->IDCompositionVisual2_iface);
+    }
+    if (watch->container) DestroyWindow(watch->container);
+    if (watch->wake) CloseHandle(watch->wake);
+    CloseHandle(watch->kick);
+    UnmapViewOfFile(watch->state);
+    IDCompositionDevice_Release(&device->IDCompositionDevice_iface);
+    free(watch);
+    return 0;
+}
+
+static void commit_visual(HWND window, struct composition_visual *visual, const D2D_MATRIX_3X2_F *parent_matrix,
+        LONGLONG now, struct shared_watch *watch)
 {
     D2D_MATRIX_3X2_F matrix, local;
     IWineDXGICompositionSwapChain *swapchain;
     IUnknown *presenter, *content;
     unsigned int i;
+    HWND source;
     float x, y;
 
     /* The visual's own transform, then its offset, then its parent's. */
@@ -646,6 +799,21 @@ static void commit_visual(HWND window, struct composition_visual *visual, const
     dc_matrix_multiply(&local, parent_matrix, &matrix);
     x = matrix.dx;
     y = matrix.dy;
+    if (visual->shared && !watch)
+    {
+        /* tell the process that opened it where it is now */
+        visual->shared->window = (ULONG_PTR)window;
+        visual->shared->matrix = matrix;
+        InterlockedIncrement(&visual->shared->generation);
+        if (visual->shared_wake) SetEvent(visual->shared_wake);
+    }
+    if (watch && visual->content && (source = dc_surface_get_window(visual->content)))
+    {
+        embed_window(watch, window, source);
+        for (i = 0; i < visual->child_count; ++i)
+            commit_visual(window, visual->children[i], &matrix, now, watch);
+        return;
+    }
     presenter = visual->content ? dc_surface_get_presenter(visual->content) : NULL;
     content = presenter ? presenter : visual->content;
     if (content && SUCCEEDED(IUnknown_QueryInterface(content,
@@ -681,7 +849,7 @@ static void commit_visual(HWND window, struct composition_visual *visual, const
     if (presenter)
         IUnknown_Release(presenter);
     for (i = 0; i < visual->child_count; ++i)
-        commit_visual(window, visual->children[i], &matrix, now);
+        commit_visual(window, visual->children[i], &matrix, now, watch);
 }
 
 static HRESULT STDMETHODCALLTYPE device_Commit(IDCompositionDevice *iface)
@@ -697,8 +865,10 @@ static HRESULT STDMETHODCALLTYPE device_Commit(IDCompositionDevice *iface)
     EnterCriticalSection(&device->cs);
     for (target = device->targets; target; target = target->next)
     {
-        if (target->root)
-            commit_visual(target->window, target->root, &identity, now.QuadPart);
+        if (target->watch)
+            SetEvent(target->watch->kick);
+        else if (target->root)
+            commit_visual(target->window, target->root, &identity, now.QuadPart, NULL);
     }
     LeaveCriticalSection(&device->cs);
     return S_OK;
@@ -1169,35 +1339,164 @@ static HRESULT STDMETHODCALLTYPE desktop_device_CreateSurfaceFromHwnd(IDComposit
     return device_CreateSurfaceFromHwnd(DD(iface), window, surface);
 }
 
-static const IDCompositionDesktopDeviceVtbl desktop_device_vtbl =
-{
-    desktop_device_QueryInterface,
-    desktop_device_AddRef,
-    desktop_device_Release,
-    desktop_device_Commit,
-    desktop_device_WaitForCommitCompletion,
-    desktop_device_GetFrameStatistics,
-    desktop_device_CreateVisual,
-    desktop_device_CreateSurfaceFactory,
-    desktop_device_CreateSurface,
-    desktop_device_CreateVirtualSurface,
-    desktop_device_CreateTranslateTransform,
-    desktop_device_CreateScaleTransform,
-    desktop_device_CreateRotateTransform,
-    desktop_device_CreateSkewTransform,
-    desktop_device_CreateMatrixTransform,
-    desktop_device_CreateTransformGroup,
-    desktop_device_CreateTranslateTransform3D,
-    desktop_device_CreateScaleTransform3D,
-    desktop_device_CreateRotateTransform3D,
-    desktop_device_CreateMatrixTransform3D,
-    desktop_device_CreateTransform3DGroup,
-    desktop_device_CreateEffectGroup,
-    desktop_device_CreateRectangleClip,
-    desktop_device_CreateAnimation,
-    desktop_device_CreateTargetForHwnd,
-    desktop_device_CreateSurfaceFromHandle,
-    desktop_device_CreateSurfaceFromHwnd,
+/* Stained Glass OS: the desktop device's partner interface. It is not documented; the WebView2
+ * runtime asks for it when its host composes it without a window of its own (Office's task panes,
+ * --enable-features=msAbydosForWindowlessWV2) and gives up on E_NOINTERFACE. It is the desktop
+ * device with three methods after it, as the runtime calls them (the names are ours):
+ *   CreateSharedVisual(REFIID, void **)             in the host: a visual to share
+ *   CreateSharedVisualHandle(IUnknown *, HANDLE *)  in the host: a handle to it for another process
+ *   OpenSharedVisualTarget(HANDLE, REFIID, void **) in the browser: a target whose root is shown
+ *                                                   in that visual */
+
+static HRESULT STDMETHODCALLTYPE partner_CreateSharedVisual(IDCompositionDesktopDevice *iface, REFIID iid, void **out)
+{
+    IDCompositionVisual *visual;
+    HRESULT hr;
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = device_CreateVisual(DD(iface), &visual))) return hr;
+    hr = IDCompositionVisual_QueryInterface(visual, iid, out);
+    IDCompositionVisual_Release(visual);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE partner_CreateSharedVisualHandle(IDCompositionDesktopDevice *iface,
+        IUnknown *object, HANDLE *handle)
+{
+    struct composition_visual *visual = unsafe_impl_from_IDCompositionVisual((IDCompositionVisual *)object);
+    static LONG counter;
+    HANDLE section;
+
+    TRACE("iface %p, object %p, handle %p.\n", iface, object, handle);
+
+    if (!handle) return E_POINTER;
+    *handle = NULL;
+    if (!visual) return E_INVALIDARG;
+    if (!visual->shared)
+    {
+        if (!(section = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0,
+                sizeof(struct shared_visual_state), NULL)))
+            return HRESULT_FROM_WIN32(GetLastError());
+        if (!(visual->shared = MapViewOfFile(section, FILE_MAP_WRITE, 0, 0, 0)))
+        {
+            CloseHandle(section);
+            return HRESULT_FROM_WIN32(GetLastError());
+        }
+        visual->shared_section = section;
+        swprintf(visual->shared->wake_name, ARRAY_SIZE(visual->shared->wake_name),
+                L"__wine_dcomp_shared_visual_%lx_%lx", GetCurrentProcessId(), InterlockedIncrement(&counter));
+        visual->shared_wake = CreateEventW(NULL, FALSE, FALSE, visual->shared->wake_name);
+    }
+    if (!DuplicateHandle(GetCurrentProcess(), visual->shared_section, GetCurrentProcess(), handle, 0, FALSE,
+            DUPLICATE_SAME_ACCESS))
+        return HRESULT_FROM_WIN32(GetLastError());
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE partner_OpenSharedVisualTarget(IDCompositionDesktopDevice *iface, HANDLE handle,
+        REFIID iid, void **out)
+{
+    struct composition_device *device = impl_from_IDCompositionDesktopDevice(iface);
+    struct composition_target *target;
+    struct shared_watch *watch;
+    HANDLE thread;
+    HRESULT hr;
+
+    TRACE("iface %p, handle %p, iid %s, out %p.\n", iface, handle, debugstr_guid(iid), out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(watch = calloc(1, sizeof(*watch)))) return E_OUTOFMEMORY;
+    if (!(watch->state = MapViewOfFile(handle, FILE_MAP_READ, 0, 0, sizeof(struct shared_visual_state))))
+    {
+        free(watch);
+        return E_INVALIDARG;
+    }
+    if (!(target = calloc(1, sizeof(*target))))
+    {
+        UnmapViewOfFile(watch->state);
+        free(watch);
+        return E_OUTOFMEMORY;
+    }
+    watch->wake = OpenEventW(SYNCHRONIZE, FALSE, watch->state->wake_name);
+    watch->kick = CreateEventW(NULL, FALSE, TRUE, NULL);
+    watch->device = device;
+    watch->target = target;
+    IDCompositionDevice_AddRef(&device->IDCompositionDevice_iface);
+
+    target->IDCompositionTarget_iface.lpVtbl = &composition_target_vtbl;
+    target->refcount = 1;
+    target->device = device;
+    target->watch = watch;
+    IDCompositionDevice_AddRef(&device->IDCompositionDevice_iface);
+
+    EnterCriticalSection(&device->cs);
+    target->next = device->targets;
+    device->targets = target;
+    LeaveCriticalSection(&device->cs);
+
+    if (!(thread = CreateThread(NULL, 0, shared_watch_thread, watch, 0, NULL)))
+    {
+        /* the target cannot be shown; nothing else uses the watch */
+        target->watch = NULL;
+        CloseHandle(watch->kick);
+        if (watch->wake) CloseHandle(watch->wake);
+        UnmapViewOfFile(watch->state);
+        IDCompositionDevice_Release(&device->IDCompositionDevice_iface);
+        free(watch);
+    }
+    else CloseHandle(thread);
+    hr = IDCompositionTarget_QueryInterface(&target->IDCompositionTarget_iface, iid, out);
+    IDCompositionTarget_Release(&target->IDCompositionTarget_iface);
+    return hr;
+}
+
+static const struct
+{
+    IDCompositionDesktopDeviceVtbl desktop;
+    HRESULT (STDMETHODCALLTYPE *CreateSharedVisual)(IDCompositionDesktopDevice *iface, REFIID iid, void **out);
+    HRESULT (STDMETHODCALLTYPE *CreateSharedVisualHandle)(IDCompositionDesktopDevice *iface, IUnknown *visual,
+            HANDLE *handle);
+    HRESULT (STDMETHODCALLTYPE *OpenSharedVisualTarget)(IDCompositionDesktopDevice *iface, HANDLE handle,
+            REFIID iid, void **out);
+}
+desktop_device_vtbl =
+{
+    {
+        desktop_device_QueryInterface,
+        desktop_device_AddRef,
+        desktop_device_Release,
+        desktop_device_Commit,
+        desktop_device_WaitForCommitCompletion,
+        desktop_device_GetFrameStatistics,
+        desktop_device_CreateVisual,
+        desktop_device_CreateSurfaceFactory,
+        desktop_device_CreateSurface,
+        desktop_device_CreateVirtualSurface,
+        desktop_device_CreateTranslateTransform,
+        desktop_device_CreateScaleTransform,
+        desktop_device_CreateRotateTransform,
+        desktop_device_CreateSkewTransform,
+        desktop_device_CreateMatrixTransform,
+        desktop_device_CreateTransformGroup,
+        desktop_device_CreateTranslateTransform3D,
+        desktop_device_CreateScaleTransform3D,
+        desktop_device_CreateRotateTransform3D,
+        desktop_device_CreateMatrixTransform3D,
+        desktop_device_CreateTransform3DGroup,
+        desktop_device_CreateEffectGroup,
+        desktop_device_CreateRectangleClip,
+        desktop_device_CreateAnimation,
+        desktop_device_CreateTargetForHwnd,
+        desktop_device_CreateSurfaceFromHandle,
+        desktop_device_CreateSurfaceFromHwnd,
+    },
+    partner_CreateSharedVisual,
+    partner_CreateSharedVisualHandle,
+    partner_OpenSharedVisualTarget,
 };
 
 #undef DD
@@ -1245,7 +1544,7 @@ static HRESULT create_device2(IUnknown *rendering_device, REFIID iid, void **out
         return hr;
     }
     device->IDCompositionDevice_iface.lpVtbl = &composition_device_vtbl;
-    device->IDCompositionDesktopDevice_iface.lpVtbl = &desktop_device_vtbl;
+    device->IDCompositionDesktopDevice_iface.lpVtbl = &desktop_device_vtbl.desktop;
     device->is_desktop = TRUE;
     device->refcount = 1;
     InitializeCriticalSectionEx(&device->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
diff --git a/dlls/dcomp/surface.c b/dlls/dcomp/surface.c
index 08ba317..98f37d7 100644
--- a/dlls/dcomp/surface.c
+++ b/dlls/dcomp/surface.c
@@ -66,6 +66,7 @@ struct composition_surface
     UINT chain_width, chain_height;
     enum surface_state state;
     BOOL dirty;
+    HWND window;    /* the window a surface made with CreateSurfaceFromHwnd shows */
 };
 
 static const IDCompositionVirtualSurfaceVtbl virtual_surface_vtbl;
@@ -614,6 +615,14 @@ HRESULT dc_create_surface_from_hwnd(IDXGIDevice *dxgi_device, HWND window, void
         IDXGISurface1_Release(dxgi);
         IDCompositionSurface_EndDraw(surface);
     }
+    unsafe_impl_from_surface((IUnknown *)surface)->window = window;
     *out = surface;
     return S_OK;
 }
+
+HWND dc_surface_get_window(IUnknown *content)
+{
+    struct composition_surface *surface = unsafe_impl_from_surface(content);
+
+    return surface ? surface->window : NULL;
+}
