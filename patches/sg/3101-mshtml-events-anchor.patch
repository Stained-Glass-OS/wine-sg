+static HRESULT anchor_set_part(IHTMLAnchorElement *iface, HTMLAnchorElement *This, enum sg_url_part part, BSTR v)
+{
+    nsAString href_str;
+    BSTR href = NULL;
+    nsresult nsres;
+    HRESULT hres;
+
+    nsAString_Init(&href_str, NULL);
+    nsres = nsIDOMHTMLAnchorElement_GetHref(This->nsanchor, &href_str);
+    if(NS_SUCCEEDED(nsres)) {
+        const PRUnichar *str;
+        nsAString_GetData(&href_str, &str);
+        hres = url_with_part(str, part, v, &href);
+    }else {
+        hres = E_FAIL;
+    }
+    nsAString_Finish(&href_str);
+    if(FAILED(hres))
+        return hres;
+
+    hres = IHTMLAnchorElement_put_href(iface, href);
+    SysFreeString(href);
+    return hres;
+}
+
 static HRESULT WINAPI HTMLAnchorElement_put_host(IHTMLAnchorElement *iface, BSTR v)
 {
     HTMLAnchorElement *This = impl_from_IHTMLAnchorElement(iface);
-    FIXME("(%p)->(%s)\n", This, debugstr_w(v));
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_w(v));
+
+    return anchor_set_part(iface, This, SG_URLPART_HOST, v);
 }
 
