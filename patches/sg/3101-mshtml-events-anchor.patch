From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 21:00:08 -0700
Subject: [PATCH] mshtml: element events, ready states, anchor and area address
 parts

onselect/onerror/onabort/onreadystatechange/onunload/onbeforeunload/onscroll/
onreset/onchange/onblur/onfocus of the elements that lacked them,
readyState of input, img, link and object, the anchor and area setters of
host, hostname, port, pathname, protocol, search and hash (through the
address), the area interface's missing hostname slot in nsiface.idl, and
Clone for the form and select enumerators.

diff --git a/dlls/mshtml/htmlanchor.c b/dlls/mshtml/htmlanchor.c
index df770ce..f2a085a 100644
--- a/dlls/mshtml/htmlanchor.c
+++ b/dlls/mshtml/htmlanchor.c
@@ -197,6 +197,126 @@ static IUri *get_anchor_uri(HTMLAnchorElement *anchor)
     return uri;
 }
 
+/* An address with one of its parts replaced (the setters of the host, port, ... of an
+ * anchor or an area), as the new address. */
+HRESULT url_with_part(const WCHAR *href, enum sg_url_part part, const WCHAR *value, BSTR *ret)
+{
+    BSTR scheme = NULL, user = NULL, host = NULL, path = NULL, query = NULL, fragment = NULL, abs = NULL;
+    DWORD port = 0;
+    BOOL has_port = FALSE;
+    WCHAR *out, *colon, *copy = NULL;
+    size_t len;
+    IUri *uri;
+    HRESULT hres;
+
+    *ret = NULL;
+    if(!href || !*href)
+        return E_FAIL;
+    hres = create_uri(href, 0, &uri);
+    if(FAILED(hres))
+        return hres;
+
+    IUri_GetSchemeName(uri, &scheme);
+    IUri_GetUserInfo(uri, &user);
+    IUri_GetHost(uri, &host);
+    IUri_GetPath(uri, &path);
+    IUri_GetQuery(uri, &query);
+    IUri_GetFragment(uri, &fragment);
+    IUri_GetAbsoluteUri(uri, &abs);
+    has_port = IUri_GetPort(uri, &port) == S_OK;
+    IUri_Release(uri);
+
+    if(!value) value = L"";
+    switch(part) {
+    case SG_URLPART_PORT:
+#ifdef SG_MUTANT_MSHTML_URL_NOPORT
+        break;
+#endif
+        has_port = *value != 0;
+        port = wcstoul(value, NULL, 10);
+        break;
+    case SG_URLPART_HOSTNAME:
+        SysFreeString(host);
+        host = SysAllocString(value);
+        break;
+    case SG_URLPART_HOST:
+        copy = wcsdup(value);
+        if(copy && (colon = wcsrchr(copy, ':'))) {
+            *colon = 0;
+            has_port = colon[1] != 0;
+            port = wcstoul(colon + 1, NULL, 10);
+        }
+        SysFreeString(host);
+        host = SysAllocString(copy ? copy : L"");
+        free(copy);
+        break;
+    case SG_URLPART_PATHNAME:
+        SysFreeString(path);
+        path = SysAllocString(*value == '/' ? value : L"");
+        if(*value && *value != '/') {
+            SysFreeString(path);
+            path = SysAllocStringLen(NULL, wcslen(value) + 1);
+            if(path) swprintf(path, wcslen(value) + 2, L"/%s", value);
+        }
+        break;
+    case SG_URLPART_PROTOCOL:
+        SysFreeString(scheme);
+        scheme = SysAllocString(value);
+        if(scheme && SysStringLen(scheme) && scheme[SysStringLen(scheme) - 1] == ':')
+            scheme[SysStringLen(scheme) - 1] = 0;
+        break;
+    case SG_URLPART_SEARCH:
+        SysFreeString(query);
+        query = SysAllocString(!*value || *value == '?' ? value : L"");
+        if(*value && *value != '?') {
+            SysFreeString(query);
+            query = SysAllocStringLen(NULL, wcslen(value) + 1);
+            if(query) swprintf(query, wcslen(value) + 2, L"?%s", value);
+        }
+        break;
+    case SG_URLPART_HASH:
+        SysFreeString(fragment);
+        fragment = SysAllocString(!*value || *value == '#' ? value : L"");
+        if(*value && *value != '#') {
+            SysFreeString(fragment);
+            fragment = SysAllocStringLen(NULL, wcslen(value) + 1);
+            if(fragment) swprintf(fragment, wcslen(value) + 2, L"#%s", value);
+        }
+        break;
+    }
+
+    /* scheme://[userinfo@]host[:port]path?query#fragment; the query and the fragment keep their marks */
+    len = SysStringLen(scheme) + SysStringLen(user) + SysStringLen(host) + SysStringLen(path)
+        + SysStringLen(query) + SysStringLen(fragment) + 32;
+    if((out = malloc(len * sizeof(WCHAR)))) {
+        const BOOL hierarchical = abs && wcsstr(abs, L"://");
+        const WCHAR *sep = hierarchical || (host && *host) ? L"//" : L"";
+        int n = swprintf(out, len, L"%s:%s", scheme ? scheme : L"", sep);
+
+        if(user && *user)
+            n += swprintf(out + n, len - n, L"%s@", user);
+        if(host)
+            n += swprintf(out + n, len - n, L"%s", host);
+        if(has_port && host && *host)
+            n += swprintf(out + n, len - n, L":%lu", port);
+        if(path)
+            n += swprintf(out + n, len - n, L"%s", path);
+        if(query)
+            n += swprintf(out + n, len - n, L"%s", query);
+        if(fragment)
+            swprintf(out + n, len - n, L"%s", fragment);
+        *ret = SysAllocString(out);
+        free(out);
+        hres = *ret ? S_OK : E_OUTOFMEMORY;
+    }else {
+        hres = E_OUTOFMEMORY;
+    }
+
+    SysFreeString(scheme); SysFreeString(user); SysFreeString(host); SysFreeString(path);
+    SysFreeString(query); SysFreeString(fragment); SysFreeString(abs);
+    return hres;
+}
