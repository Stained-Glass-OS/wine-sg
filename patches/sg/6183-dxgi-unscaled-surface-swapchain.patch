From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dxgi: unscaled swap chains for composition surface handles

Windows Terminal's renderer makes its swap chain for a composition surface handle unscaled (DXGI_SCALING_NONE): the frame is drawn at its size, the rest of the panel left as it is. Composition swap chains refused it ("Invalid description"), the renderer entered its error state and Windows Terminal showed nothing. Unscaled swap chains are now made for surface handles (IDXGIFactoryMedia); CreateSwapChainForComposition still requires stretching, as on Windows.
---
diff --git a/dlls/dxgi/composition.c b/dlls/dxgi/composition.c
index 323729d..a1aa624 100644
--- a/dlls/dxgi/composition.c
+++ b/dlls/dxgi/composition.c
@@ -1000,7 +1000,7 @@ static const struct IWineDXGICompositionSwapChainVtbl composition_target_vtbl =
 };
 
 HRESULT dxgi_composition_swapchain_create(IWineDXGIFactory *factory, IUnknown *device,
-        const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGISwapChain1 **ret)
+        const DXGI_SWAP_CHAIN_DESC1 *desc, BOOL for_surface, IDXGISwapChain1 **ret)
 {
     struct composition_swapchain *swapchain;
     ID3D11Device *d3d11_device;
@@ -1012,10 +1012,13 @@ HRESULT dxgi_composition_swapchain_create(IWineDXGIFactory *factory, IUnknown *d
         return E_NOTIMPL;
     }
 
-    /* Composition swap chains must use the flip model, and have no scaling
-     * that needs a window. */
+    /* Composition swap chains must use the flip model, and stretch: only those made for a surface
+     * handle may also be unscaled (the frame drawn at its size). */
+#ifdef SG_MUTANT_SURFACE_NOT_UNSCALED
+    for_surface = FALSE;
+#endif
     if ((desc->SwapEffect != DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL && desc->SwapEffect != DXGI_SWAP_EFFECT_FLIP_DISCARD)
-            || !desc->Width || !desc->Height || desc->Scaling == DXGI_SCALING_NONE)
+            || !desc->Width || !desc->Height || (desc->Scaling == DXGI_SCALING_NONE && !for_surface))
     {
         WARN("Invalid description for a composition swap chain.\n");
         ID3D11Device_Release(d3d11_device);
diff --git a/dlls/dxgi/dxgi_private.h b/dlls/dxgi/dxgi_private.h
index 8218041..5cbc855 100644
--- a/dlls/dxgi/dxgi_private.h
+++ b/dlls/dxgi/dxgi_private.h
@@ -263,7 +263,7 @@ HRESULT d3d11_swapchain_init(struct d3d11_swapchain *swapchain, struct dxgi_devi
 HRESULT dxgi_composition_handle_add(IDXGISwapChain1 *swapchain, HANDLE handle);
 HRESULT dxgi_composition_handle_find(HANDLE handle, IWineDXGICompositionSwapChain **swapchain);
 HRESULT dxgi_composition_swapchain_create(IWineDXGIFactory *factory, IUnknown *device,
-        const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGISwapChain1 **swapchain);
+        const DXGI_SWAP_CHAIN_DESC1 *desc, BOOL for_surface, IDXGISwapChain1 **swapchain);
 HRESULT d3d12_swapchain_create(IWineDXGIFactory *factory, ID3D12CommandQueue *queue, HWND window,
         const DXGI_SWAP_CHAIN_DESC1 *swapchain_desc, const DXGI_SWAP_CHAIN_FULLSCREEN_DESC *fullscreen_desc,
         IDXGISwapChain1 **swapchain);
diff --git a/dlls/dxgi/factory.c b/dlls/dxgi/factory.c
index d939de5..c5a495a 100644
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -562,7 +562,7 @@ static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForComposition(IWin
     if (output)
         FIXME("Ignoring output %p.\n", output);
 
-    return dxgi_composition_swapchain_create(iface, device, desc, swapchain);
+    return dxgi_composition_swapchain_create(iface, device, desc, FALSE, swapchain);
 }
 
 static UINT STDMETHODCALLTYPE dxgi_factory_GetCreationFlags(IWineDXGIFactory *iface)
@@ -802,8 +802,11 @@ static HRESULT STDMETHODCALLTYPE dxgi_factory_media_CreateSwapChainForCompositio
 
     if (!surface)
         return E_INVALIDARG;
-    if (FAILED(hr = dxgi_factory_CreateSwapChainForComposition(&factory->IWineDXGIFactory_iface,
-            device, desc, output, swapchain)))
+    if (!device || !desc || !swapchain)
+        return DXGI_ERROR_INVALID_CALL;
+    if (desc->Stereo || !dxgi_validate_swapchain_desc(desc))
+        return DXGI_ERROR_INVALID_CALL;
+    if (FAILED(hr = dxgi_composition_swapchain_create(&factory->IWineDXGIFactory_iface, device, desc, TRUE, swapchain)))
         return hr;
     if (FAILED(hr = dxgi_composition_handle_add(*swapchain, surface)))
     {
