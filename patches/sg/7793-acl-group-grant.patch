From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: a grant to the users reaches a folder's ACL group entry, not only its mask

David (2026-11-15): GOG GALAXY's game installs failed, "Could not create
directory for file 'C:\Program Files\GOG Galaxy\Dependencies-Temp\__redist\
...'". Its service (SYSTEM) gives the users its folder, as on Windows;
sg_users_group made the folder the users' group's and chmod'ed g+w. But the
folder had an ACL, inherited from Program Files' default ACL (which names
the system's account and gives the group r-x), and with an ACL chmod's group
bits are the mask: group:: stayed r-x under mask::rwx, default:group:: too,
and the client run by the user could make nothing in it.

The grant now also gives the ACL's owning-group entry (and mask) the rights,
in the access ACL and, for a directory, in the default ACL it already has
-- keeping its other entries, the system's account among them -- for the
folder and for what is in it already.
---
diff --git a/server/file.c b/server/file.c
index f01fafc..08f449a 100644
--- a/server/file.c
+++ b/server/file.c
@@ -530,6 +530,43 @@ static gid_t sg_tree_gid;
  * inherited ACE, as the file system has it. Setgid alone passed on the group,
  * not the right to write: Steam run as an administrator made package\ 0755,
  * and Steam run by a user again found it not writable. */
+/* An ACL the file has (inherited from a directory's default ACL: the system
+ * trees carry one for the system's account) makes chmod's group bits the
+ * ACL's mask, not the owning group's right: the users' group kept r-x under a
+ * mask of rwx, and the grant did nothing (David 2026-11-15: GOG GALAXY's
+ * service gave the users its folder, the client run by him could not create
+ * a directory in it). The owning group's entry gets PERM, and the mask lets it
+ * through (wine-sg 7793). NAME is the access or the default ACL; FALSE when
+ * the file has no such ACL. */
+static int sg_acl_grant_group( int fd, const char *path, const char *name, unsigned short perm )
+{
+    unsigned char buf[4 + 8 * 64];
+    ssize_t len, i;
+    int changed = 0;
+
+    len = fd != -1 ? fgetxattr( fd, name, buf, sizeof(buf) ) : getxattr( path, name, buf, sizeof(buf) );
+    if (len < 4 + 8 || (len - 4) % 8) return 0;
+#ifndef SG_MUTANT_ACL_GROUP_UNTOUCHED
+    for (i = 4; i < len; i += 8)
+    {
+        unsigned short tag, p;
+        memcpy( &tag, buf + i, 2 );
+        memcpy( &p, buf + i + 2, 2 );
+        if (tag != 0x04 && tag != 0x10) continue;   /* ACL_GROUP_OBJ, ACL_MASK */
+        if ((p & perm) == perm) continue;
+        p |= perm;
+        memcpy( buf + i + 2, &p, 2 );
+        changed = 1;
+    }
+    if (changed)
+    {
+        if (fd != -1) fsetxattr( fd, name, buf, len, 0 );
+        else setxattr( path, name, buf, len, 0 );
+    }
+#endif
+    return 1;
+}
+
 static void sg_default_acl( int fd, const char *path )
 {
     struct { unsigned short tag, perm; unsigned int id; } __attribute__((packed)) e[3] = {
@@ -540,6 +577,9 @@ static void sg_default_acl( int fd, const char *path )
     unsigned char buf[4 + sizeof(e)];
     unsigned int version = 2;   /* POSIX_ACL_XATTR_VERSION */
 
+    /* a default ACL there already (the system's account named in it) keeps its
+     * entries; its group and mask let the users' group write */
+    if (sg_acl_grant_group( fd, path, "system.posix_acl_default", 7 )) return;
     memcpy( buf, &version, 4 );
     memcpy( buf + 4, e, sizeof(e) );
     if (fd != -1) fsetxattr( fd, "system.posix_acl_default", buf, sizeof(buf), 0 );
@@ -553,9 +593,14 @@ static int sg_users_tree( const char *path, const struct stat *st, int type, str
     if (type == FTW_D)
     {
         chmod( path, (st->st_mode & 07777) | S_ISGID | S_IRGRP | S_IWGRP | S_IXGRP );
+        sg_acl_grant_group( -1, path, "system.posix_acl_access", 7 );
         sg_default_acl( -1, path );
     }
-    else if (type == FTW_F) chmod( path, (st->st_mode & 07777) | S_IRGRP | S_IWGRP );
+    else if (type == FTW_F)
+    {
+        chmod( path, (st->st_mode & 07777) | S_IRGRP | S_IWGRP );
+        sg_acl_grant_group( -1, path, "system.posix_acl_access", 6 );
+    }
     return 0;
 }
 
@@ -584,6 +629,7 @@ void sg_users_group( int unix_fd, const struct stat *st )
         ssize_t len;
 
         fchmod( unix_fd, (st->st_mode & 07777) | S_ISGID | S_IWGRP | S_IRGRP | S_IXGRP );
+        sg_acl_grant_group( unix_fd, NULL, "system.posix_acl_access", 7 );
         sg_default_acl( unix_fd, NULL );
         /* what is in it already gets the grant too, as SetNamedSecurityInfo
          * passes an inheritable grant on (an installer sets it after
@@ -596,7 +642,11 @@ void sg_users_group( int unix_fd, const struct stat *st )
             nftw( path, sg_users_tree, 16, FTW_PHYS );
         }
     }
-    else fchmod( unix_fd, (st->st_mode & 07777) | S_IWGRP | S_IRGRP );
+    else
+    {
+        fchmod( unix_fd, (st->st_mode & 07777) | S_IWGRP | S_IRGRP );
+        sg_acl_grant_group( unix_fd, NULL, "system.posix_acl_access", 6 );
+    }
 }
 
 mode_t sd_to_mode( const struct security_descriptor *sd, const struct sid *owner )
