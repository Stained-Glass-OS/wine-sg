+/***************************************************************************
+ *                              MCIQTZ_mciStep                  [internal]
+ */
+static DWORD MCIQTZ_mciStep(UINT wDevID, DWORD dwFlags, LPMCI_DGV_STEP_PARMS lpParms)
+{
+    WINE_MCIQTZ *wma = MCIQTZ_mciGetOpenDev(wDevID);
+    LONGLONG pos, duration;
+    REFTIME frame = 0.0;
+    LONG frames = 1;
+
+    TRACE("(%04x, %08lX, %p)\n", wDevID, dwFlags, lpParms);
+
+    if (!lpParms)
+        return MCIERR_NULL_PARAMETER_BLOCK;
+    if (!wma)
+        return MCIERR_INVALID_DEVICE_ID;
+    if (dwFlags & MCI_TEST)
+        return 0;
+
+    if (FAILED(IBasicVideo_get_AvgTimePerFrame(wma->vidbasic, &frame)) || frame <= 0.0)
+        return MCIERR_UNSUPPORTED_FUNCTION;
+    if (dwFlags & MCI_DGV_STEP_FRAMES)
+        frames = lpParms->dwFrames;
+    if (dwFlags & MCI_DGV_STEP_REVERSE)
+        frames = -frames;
+
+    /* stepping leaves the video paused on the new frame */
+    IMediaControl_Pause(wma->pmctrl);
+    IMediaSeeking_SetTimeFormat(wma->seek, &TIME_FORMAT_MEDIA_TIME);
+    if (FAILED(IMediaSeeking_GetCurrentPosition(wma->seek, &pos)))
+        return MCIERR_INTERNAL;
+    IMediaSeeking_GetDuration(wma->seek, &duration);
+    pos += (LONGLONG)(frames * frame * 10000000.0);
+    pos = max(0, min(pos, duration));
+    if (FAILED(IMediaSeeking_SetPositions(wma->seek, &pos, AM_SEEKING_AbsolutePositioning, NULL, AM_SEEKING_NoPositioning)))
+        return MCIERR_INTERNAL;
+
+    if (dwFlags & MCI_NOTIFY)
+        MCIQTZ_mciNotify(lpParms->dwCallback, wma, MCI_NOTIFY_SUCCESSFUL);
+    return 0;
+}
+
+/***************************************************************************
+ *                              MCIQTZ_mciCue                   [internal]
+ */
+static DWORD MCIQTZ_mciCue(UINT wDevID, DWORD dwFlags, LPMCI_DGV_CUE_PARMS lpParms)
+{
+    WINE_MCIQTZ *wma = MCIQTZ_mciGetOpenDev(wDevID);
+    LONGLONG pos;
+    REFTIME frame;
+
+    TRACE("(%04x, %08lX, %p)\n", wDevID, dwFlags, lpParms);
+
+    if (!lpParms)
+        return MCIERR_NULL_PARAMETER_BLOCK;
+    if (!wma)
+        return MCIERR_INVALID_DEVICE_ID;
+    /* there is nothing to record from */
+    if (dwFlags & MCI_DGV_CUE_INPUT)
+        return MCIERR_UNSUPPORTED_FUNCTION;
+    if (dwFlags & MCI_TEST)
+        return 0;
+
+    /* cueing for output: paused and ready to play, at the position asked for */
+    if (dwFlags & MCI_TO)
+    {
+        IMediaSeeking_SetTimeFormat(wma->seek, &TIME_FORMAT_MEDIA_TIME);
+        if (wma->time_format == MCI_FORMAT_FRAMES)
+        {
+            if (FAILED(IBasicVideo_get_AvgTimePerFrame(wma->vidbasic, &frame)) || frame <= 0.0)
+                return MCIERR_UNSUPPORTED_FUNCTION;
+            pos = (LONGLONG)(lpParms->dwTo * frame * 10000000.0 + 0.5);
+        }
+        else
+            pos = (LONGLONG)lpParms->dwTo * 10000;
+        IMediaSeeking_SetPositions(wma->seek, &pos, AM_SEEKING_AbsolutePositioning, NULL, AM_SEEKING_NoPositioning);
+    }
+    IMediaControl_Pause(wma->pmctrl);
+
+    if (dwFlags & MCI_NOTIFY)
+        MCIQTZ_mciNotify(lpParms->dwCallback, wma, MCI_NOTIFY_SUCCESSFUL);
+    return 0;
+}
+
+/***************************************************************************
+ *                              MCIQTZ_mciInfo                  [internal]
+ */
+static DWORD MCIQTZ_mciInfo(UINT wDevID, DWORD dwFlags, LPMCI_DGV_INFO_PARMSW lpParms)
+{
+    WINE_MCIQTZ *wma = MCIQTZ_mciGetOpenDev(wDevID);
+    WCHAR caption[256];
+    const WCHAR *str;
+
+    TRACE("(%04x, %08lX, %p)\n", wDevID, dwFlags, lpParms);
+
+    if (!lpParms || !lpParms->lpstrReturn)
+        return MCIERR_NULL_PARAMETER_BLOCK;
+    if (!wma)
+        return MCIERR_INVALID_DEVICE_ID;
+
+    if (dwFlags & MCI_INFO_PRODUCT)
+        str = L"DirectShow";
+    else if (dwFlags & MCI_INFO_FILE)
+        str = wma->file ? wma->file : L"";
+    else if (dwFlags & MCI_DGV_INFO_TEXT)
+    {
+        GetWindowTextW(wma->parent, caption, ARRAY_SIZE(caption));
+        str = caption;
+    }
+    else
+        return MCIERR_UNSUPPORTED_FUNCTION;
+
+    if (!lpParms->dwRetSize)
+        return MCIERR_PARAM_OVERFLOW;
+    lstrcpynW(lpParms->lpstrReturn, str, lpParms->dwRetSize);
+    if (wcslen(str) >= lpParms->dwRetSize)
+        return MCIERR_PARAM_OVERFLOW;
+
+    if (dwFlags & MCI_NOTIFY)
+        MCIQTZ_mciNotify(lpParms->dwCallback, wma, MCI_NOTIFY_SUCCESSFUL);
+    return 0;
+}
+
+/***************************************************************************
+ *                              MCIQTZ_mciSetVideo              [internal]
+ */
+static DWORD MCIQTZ_mciSetVideo(UINT wDevID, DWORD dwFlags, LPMCI_DGV_SETVIDEO_PARMSW lpParms)
+{
+    WINE_MCIQTZ *wma = MCIQTZ_mciGetOpenDev(wDevID);
+
+    TRACE("(%04x, %08lX, %p)\n", wDevID, dwFlags, lpParms);
+
+    if (!lpParms)
+        return MCIERR_NULL_PARAMETER_BLOCK;
+    if (!wma)
+        return MCIERR_INVALID_DEVICE_ID;
+
+    if (dwFlags & (MCI_SET_ON | MCI_SET_OFF))
+        IVideoWindow_put_Visible(wma->vidwin, (dwFlags & MCI_SET_ON) ? OATRUE : OAFALSE);
+
+    /* picture adjustments (brightness, colour, ...) need display hardware */
+    if (dwFlags & MCI_DGV_SETVIDEO_ITEM)
+        return MCIERR_UNSUPPORTED_FUNCTION;
+
+    if (dwFlags & MCI_NOTIFY)
+        MCIQTZ_mciNotify(lpParms->dwCallback, wma, MCI_NOTIFY_SUCCESSFUL);
+    return 0;
+}
+
 /*======================================================================*
  *                          MCI QTZ entry points                        *
  *======================================================================*/
@@ -1260,32 +1457,39 @@ LRESULT CALLBACK MCIQTZ_DriverProc(DWORD_PTR dwDevID, HDRVR hDriv, UINT wMsg,
             return MCIQTZ_mciWindow(dwDevID, dwParam1, (LPMCI_DGV_WINDOW_PARMSW)dwParam2);
         case MCI_PUT:
             return MCIQTZ_mciPut(dwDevID, dwParam1, (MCI_GENERIC_PARMS*)dwParam2);
-        case MCI_RECORD:
+        case MCI_STEP:
+            return MCIQTZ_mciStep(dwDevID, dwParam1, (LPMCI_DGV_STEP_PARMS)dwParam2);
+        case MCI_CUE:
+            return MCIQTZ_mciCue(dwDevID, dwParam1, (LPMCI_DGV_CUE_PARMS)dwParam2);
         case MCI_INFO:
+            return MCIQTZ_mciInfo(dwDevID, dwParam1, (LPMCI_DGV_INFO_PARMSW)dwParam2);
+        case MCI_SETVIDEO:
+            return MCIQTZ_mciSetVideo(dwDevID, dwParam1, (LPMCI_DGV_SETVIDEO_PARMSW)dwParam2);
+        case MCI_REALIZE:
+            /* the video renderer handles its own palette */
+            return MCIQTZ_mciGetOpenDev(dwDevID) ? 0 : MCIERR_INVALID_DEVICE_ID;
+        /* recording, editing and capture hardware: not a file player's job */
+        case MCI_RECORD:
         case MCI_LOAD:
         case MCI_SAVE:
         case MCI_FREEZE:
-        case MCI_REALIZE:
         case MCI_UNFREEZE:
-        case MCI_STEP:
         case MCI_COPY:
         case MCI_CUT:
         case MCI_DELETE:
         case MCI_PASTE:
-        case MCI_CUE:
         /* Digital Video specific */
         case MCI_CAPTURE:
         case MCI_MONITOR:
         case MCI_RESERVE:
         case MCI_SIGNAL:
-        case MCI_SETVIDEO:
         case MCI_QUALITY:
         case MCI_LIST:
         case MCI_UNDO:
         case MCI_CONFIGURE:
         case MCI_RESTORE:
-            FIXME("Unimplemented command [%08X]\n", wMsg);
-            break;
+            WARN("Unsupported command [%08X]\n", wMsg);
+            return MCIERR_UNSUPPORTED_FUNCTION;
         case MCI_SPIN:
         case MCI_ESCAPE:
             WARN("Unsupported command [%08X]\n", wMsg);
