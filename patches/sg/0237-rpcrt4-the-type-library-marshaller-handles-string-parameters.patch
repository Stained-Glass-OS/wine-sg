From: Stained Glass OS <dev@stained-glass.example>
Subject: rpcrt4: the type library marshaller handles [string] parameters (LPWSTR, LPSTR)

An interface marshalled through its type library (ProxyStubClsid32
{00020424-...}) with a VT_LPWSTR or VT_LPSTR parameter -- [in, string]
LPCWSTR, [out] LPWSTR* -- could not have a proxy or stub made ("unhandled
type 31", E_NOTIMPL, then E_NOINTERFACE from QueryInterface across
processes). Google's updater's IUpdaterSystem is such an interface. They are
now unique pointers to conformant strings (FC_UP FC_SIMPLE_POINTER
FC_C_WSTRING/FC_C_CSTRING), pointer-sized on the stack and in memory.

Gate: test/appfix-gate.sh (an interface built with ICreateTypeLib2 called
across apartments).
---
--- a/dlls/rpcrt4/ndr_typelib.c
+++ b/dlls/rpcrt4/ndr_typelib.c
@@ -179,6 +179,8 @@
     case VT_BSTR:
     case VT_SAFEARRAY:
     case VT_PTR:
+    case VT_LPSTR:
+    case VT_LPWSTR:
     case VT_UNKNOWN:
     case VT_DISPATCH:
         size = align = sizeof(void *);
@@ -804,6 +806,16 @@
     {
     case VT_PTR:
         return write_pointer_tfs(typeinfo, str, len, desc->lptdesc, toplevel, onstack);
+    case VT_LPSTR:
+    case VT_LPWSTR:
+        /* a [string] pointer: conformant, NUL-terminated; unique, as a type
+         * library cannot say otherwise and callers pass NULL */
+        off = *len;
+        WRITE_CHAR(str, *len, FC_UP);
+        WRITE_CHAR(str, *len, FC_SIMPLE_POINTER);
+        WRITE_CHAR(str, *len, desc->vt == VT_LPWSTR ? FC_C_WSTRING : FC_C_CSTRING);
+        WRITE_CHAR(str, *len, FC_PAD);
+        return off;
     case VT_CARRAY:
         return write_array_tfs(typeinfo, str, len, desc->lpadesc);
     case VT_USERDEFINED:
@@ -869,6 +881,8 @@
         size = 8;
         break;
     case VT_PTR:
+    case VT_LPSTR:
+    case VT_LPWSTR:
     case VT_UNKNOWN:
     case VT_DISPATCH:
     case VT_CARRAY:
@@ -1016,6 +1030,8 @@
     case VT_UNKNOWN:
     case VT_DISPATCH:
     case VT_CARRAY:
+    case VT_LPSTR:
+    case VT_LPWSTR:
         *flags |= MustFree;
         break;
     case VT_PTR:
