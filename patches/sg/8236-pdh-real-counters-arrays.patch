+/* ---- counter path parsing ---- */
+
+struct path_parts
+{
+    const WCHAR *machine;  DWORD machine_len;
+    const WCHAR *object;   DWORD object_len;
+    const WCHAR *inst;     DWORD inst_len;   /* text between the parentheses, NULL if none */
+    const WCHAR *counter;  DWORD counter_len;
+};
+
+static PDH_STATUS parse_path( const WCHAR *path, struct path_parts *parts );
+
+/* (wine-sg 8236) a counter of one source, or of every instance of a family for an instance of "*" */
+static PDH_STATUS add_counter( struct query *query, const WCHAR *path, DWORD_PTR userdata, PDH_HCOUNTER *hcounter )
+{
+    struct counter *counter;
+    struct path_parts want, src;
+    unsigned int i, n = 0, first = ~0u;
+    BOOL wildcard = FALSE;
+
+    ensure_sources();
+    if (!counter_sources) return PDH_MEMORY_ALLOCATION_FAILURE;
+#ifndef SG_MUTANT_PDH_OLD_SOURCES
+    if (!parse_path( path, &want ) && want.inst && want.inst_len == 1 && want.inst[0] == '*')
+        wildcard = TRUE;
+#endif
+    for (i = 0; i < counter_source_count; i++)
+    {
+        BOOL match;
+        if (wildcard)
+        {
+            parse_path( counter_sources[i].path, &src );
+            match = src.inst && src.object_len == want.object_len && !wcsnicmp( src.object, want.object, want.object_len ) &&
+                    src.counter_len == want.counter_len && !wcsnicmp( src.counter, want.counter, want.counter_len );
+        }
+        else match = pdh_match_path( counter_sources[i].path, path );
+        if (!match) continue;
+        if (first == ~0u) first = i;
+        n++;
+        if (!wildcard) break;
+    }
+    if (!n) return PDH_CSTATUS_NO_COUNTER;
+    if (!(counter = create_counter())) return PDH_MEMORY_ALLOCATION_FAILURE;
+    counter->src = calloc( n, sizeof(*counter->src) );
+    counter->cur = calloc( n, sizeof(*counter->cur) );
+    counter->prev = calloc( n, sizeof(*counter->prev) );
+    counter->path = wcsdup( wildcard ? path : counter_sources[first].path );
+    if (!counter->src || !counter->cur || !counter->prev || !counter->path)
+    {
+        destroy_counter( counter );
+        return PDH_MEMORY_ALLOCATION_FAILURE;
+    }
+    for (i = first, n = 0; i < counter_source_count; i++)
+    {
+        if (wildcard)
+        {
+            parse_path( counter_sources[i].path, &src );
+            if (!(src.inst && src.object_len == want.object_len && !wcsnicmp( src.object, want.object, want.object_len ) &&
+                  src.counter_len == want.counter_len && !wcsnicmp( src.counter, want.counter, want.counter_len )))
+                continue;
+        }
+        else if (i != first) break;
+        counter->src[n++] = i;
+    }
+    counter->inst_count   = n;
+    counter->type         = counter_sources[first].type;
+    counter->defaultscale = counter_sources[first].scale;
+    counter->base         = counter_sources[first].base;
+    counter->queryuser    = query->user;
+    counter->user         = userdata;
+    for (i = 0; i < n; i++) counter->cur[i].status = PDH_CSTATUS_INVALID_DATA;
+    /* a counter that needs no second sample is valid before the first collection, as it was */
+    if (!(counter->type & PERF_DELTA_COUNTER))
+    {
+        struct cpu_times cpus = { 0 };
+        for (i = 0; i < n; i++) sample_source( &counter_sources[counter->src[i]], &cpus, &counter->cur[i] );
+    }
+    list_add_tail( &query->counters, &counter->entry );
+    *hcounter = counter;
+    return ERROR_SUCCESS;
+}
