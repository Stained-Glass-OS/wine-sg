+/* ---- (wine-sg 8236) counter arrays, statistics, data source handles ---- */
+
+/* the instance name of a source: the text between the parentheses, "" when there is none */
+static const WCHAR *source_instance( unsigned int index, DWORD *len )
+{
+    struct path_parts parts;
+
+    parse_path( counter_sources[index].path, &parts );
+    *len = parts.inst ? parts.inst_len : 0;
+    return parts.inst ? parts.inst : L"";
+}
+
+static PDH_STATUS counter_array( PDH_HCOUNTER handle, BOOL raw, BOOL ansi, DWORD format, DWORD *size, DWORD *count,
+                                 void *items )
+{
+    struct counter *counter = handle;
+    size_t item_size = raw ? (ansi ? sizeof(PDH_RAW_COUNTER_ITEM_A) : sizeof(PDH_RAW_COUNTER_ITEM_W))
+                           : (ansi ? sizeof(PDH_FMT_COUNTERVALUE_ITEM_A) : sizeof(PDH_FMT_COUNTERVALUE_ITEM_W));
+    DWORD need, i, len;
+    PDH_STATUS ret = ERROR_SUCCESS;
+    char *names;
+
+    if (!size || !count) return PDH_INVALID_ARGUMENT;
+    EnterCriticalSection( &pdh_handle_cs );
+    if (!counter || counter->magic != PDH_MAGIC_COUNTER)
+    {
+        LeaveCriticalSection( &pdh_handle_cs );
+        return PDH_INVALID_HANDLE;
+    }
+    need = counter->inst_count * item_size;
+    for (i = 0; i < counter->inst_count; i++)
+    {
+        const WCHAR *name = source_instance( counter->src[i], &len );
+        need += ansi ? WideCharToMultiByte( CP_ACP, 0, name, len, NULL, 0, NULL, NULL ) + 1 : (len + 1) * sizeof(WCHAR);
+    }
+    *count = counter->inst_count;
+    if (!items || *size < need)
+    {
+        *size = need;
+        LeaveCriticalSection( &pdh_handle_cs );
+        return PDH_MORE_DATA;
+    }
+    *size = need;
+    names = (char *)items + counter->inst_count * item_size;
+    for (i = 0; i < counter->inst_count; i++)
+    {
+        const WCHAR *name = source_instance( counter->src[i], &len );
+        char *item = (char *)items + i * item_size;
+        char *dst = names;
+
+        if (ansi)
+        {
+            int n = WideCharToMultiByte( CP_ACP, 0, name, len, names, need, NULL, NULL );
+            names[n] = 0;
+            names += n + 1;
+        }
+        else
+        {
+            memcpy( names, name, len * sizeof(WCHAR) );
+            ((WCHAR *)names)[len] = 0;
+            names += (len + 1) * sizeof(WCHAR);
+        }
+        *(char **)item = dst;   /* szName is the first field of each item type */
+        if (raw)
+        {
+            PDH_RAW_COUNTER *v = ansi ? &((PDH_RAW_COUNTER_ITEM_A *)item)->RawValue
+                                      : &((PDH_RAW_COUNTER_ITEM_W *)item)->RawValue;
+            v->CStatus = counter->cur[i].status;
+            v->TimeStamp = counter->cur[i].stamp;
+            v->FirstValue = counter->cur[i].x;
+            v->SecondValue = counter->cur[i].y;
+            v->MultiCount = 1;
+        }
+        else
+        {
+            PDH_FMT_COUNTERVALUE *v = ansi ? &((PDH_FMT_COUNTERVALUE_ITEM_A *)item)->FmtValue
+                                           : &((PDH_FMT_COUNTERVALUE_ITEM_W *)item)->FmtValue;
+            PDH_STATUS r = counter_value( counter, i, format, v );
+            if (r == PDH_INVALID_ARGUMENT) ret = r;
+            else if (r && !i) ret = r;    /* no data yet (a rate before its second sample) */
+        }
+    }
+    LeaveCriticalSection( &pdh_handle_cs );
+    return ret;
+}
