+/***********************************************************************
+ *              PdhComputeCounterStatistics   (PDH.@)
+ *
+ * The minimum, maximum and mean of the values a circular buffer of raw samples gives, the oldest at first:
+ * one value per sample, or per pair of consecutive samples for a counter that needs two.
+ */
+PDH_STATUS WINAPI PdhComputeCounterStatistics( PDH_HCOUNTER handle, DWORD format, DWORD first, DWORD count,
+                                               PDH_RAW_COUNTER *raw, PDH_STATISTICS *stats )
+{
+    struct counter *counter = handle;
+    double v, lo = 0, hi = 0, sum = 0;
+    DWORD i, n = 0;
+    PDH_STATUS ret = ERROR_SUCCESS;
+
+    TRACE( "%p, %#lx, %lu, %lu, %p, %p\n", handle, format, first, count, raw, stats );
+
+    if (!raw || !stats || (count && first >= count)) return PDH_INVALID_ARGUMENT;
+    EnterCriticalSection( &pdh_handle_cs );
+    if (!counter || counter->magic != PDH_MAGIC_COUNTER)
+    {
+        LeaveCriticalSection( &pdh_handle_cs );
+        return PDH_INVALID_HANDLE;
+    }
+    memset( stats, 0, sizeof(*stats) );
+    stats->dwFormat = format;
+    for (i = 0; i < count; i++)
+    {
+        BOOL pair = !!(counter->type & PERF_DELTA_COUNTER);
+        struct sample cur, prev;
+        const PDH_RAW_COUNTER *c = &raw[(first + i) % count], *p = &raw[(first + i + count - 1) % count];
+
+        if (pair && !i) continue;
+        if (c->CStatus != PDH_CSTATUS_VALID_DATA && c->CStatus != PDH_CSTATUS_NEW_DATA) continue;
+        if (pair && p->CStatus != PDH_CSTATUS_VALID_DATA && p->CStatus != PDH_CSTATUS_NEW_DATA) continue;
+        sample_from_raw( c, &cur );
+        sample_from_raw( p, &prev );
+        if (compute_value( counter->type, counter->base, &cur, pair ? &prev : NULL, &v )) continue;
+        if (!n || v < lo) lo = v;
+        if (!n || v > hi) hi = v;
+        sum += v;
+        n++;
+    }
+    stats->count = n;
+    if (!n)
+    {
+        stats->min.CStatus = stats->max.CStatus = stats->mean.CStatus = PDH_CSTATUS_INVALID_DATA;
+    }
+    else if (!(ret = format_double( counter->type, counter->scale, lo, format, &stats->min )) &&
+             !(ret = format_double( counter->type, counter->scale, hi, format, &stats->max )))
+        ret = format_double( counter->type, counter->scale, sum / n, format, &stats->mean );
+    LeaveCriticalSection( &pdh_handle_cs );
+    return ret;
+}
+
+/* the data source a handle names: NULL for real-time (H_REALTIME_DATASOURCE), else a log's files */
+static PDH_STATUS handle_source( PDH_HLOG handle, const WCHAR **source )
+{
+    struct log *log = handle;
+
+    *source = NULL;
+    if (!handle) return ERROR_SUCCESS;
+    if (log->magic != PDH_MAGIC_LOG) return PDH_INVALID_HANDLE;
+    *source = log->files;
+    return ERROR_SUCCESS;
+}
+
+static PDH_STATUS handle_source_a( PDH_HLOG handle, char **source )
+{
+    const WCHAR *w;
+    PDH_STATUS ret;
+    int len;
+
+    *source = NULL;
+    if ((ret = handle_source( handle, &w )) || !w) return ret;
+    len = WideCharToMultiByte( CP_ACP, 0, w, -1, NULL, 0, NULL, NULL );
+    if (!(*source = malloc( len ))) return PDH_MEMORY_ALLOCATION_FAILURE;
+    WideCharToMultiByte( CP_ACP, 0, w, -1, *source, len, NULL, NULL );
+    return ERROR_SUCCESS;
+}
