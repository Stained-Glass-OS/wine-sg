+/* a source's raw sample now: x over y */
+static void sample_source( const struct source *src, const struct cpu_times *cpus, struct sample *out )
+{
+    LARGE_INTEGER now;
+    MEMORYSTATUSEX mem;
+
+    out->status = PDH_CSTATUS_VALID_DATA;
+    out->x = out->y = 0;
+    GetSystemTimeAsFileTime( (FILETIME *)&now );
+    switch (src->kind)
+    {
+    case SRC_CPU_BUSY: case SRC_CPU_USER: case SRC_CPU_PRIVILEGED: case SRC_CPU_IDLE:
+    {
+        unsigned int i, first = src->instance < 0 ? 0 : src->instance, last = src->instance < 0 ? cpus->count : src->instance + 1;
+        LONGLONG idle = 0, user = 0, kernel = 0;
+
+        if (last > cpus->count) { out->status = PDH_CSTATUS_NO_INSTANCE; return; }
+        for (i = first; i < last; i++)
+        {
+            idle += cpus->info[i].IdleTime.QuadPart;
+            user += cpus->info[i].UserTime.QuadPart;
+            kernel += cpus->info[i].KernelTime.QuadPart;   /* includes the idle time */
+        }
+        /* time: the processors' total time (one processor's, or all of them for _Total) */
+        out->y = user + kernel;
+        if (src->kind == SRC_CPU_BUSY || src->kind == SRC_CPU_IDLE) out->x = idle;
+        else if (src->kind == SRC_CPU_USER) out->x = user;
+        else out->x = kernel - idle;
+        break;
+    }
+    case SRC_UPTIME:
+        out->x = GetTickCount64();
+        out->y = 0;
+        break;
+    case SRC_PROCESSES: case SRC_THREADS:
+    {
+        SYSTEM_BASIC_INFORMATION basic;
+        ULONG size = 1 << 20, len;
+        BYTE *buf = NULL;
+        NTSTATUS status;
+
+        (void)basic;
+        for (;;)
+        {
+            free( buf );
+            if (!(buf = malloc( size ))) { out->status = PDH_CSTATUS_NO_INSTANCE; return; }
+            status = NtQuerySystemInformation( SystemProcessInformation, buf, size, &len );
+            if (status != STATUS_INFO_LENGTH_MISMATCH) break;
+            size *= 2;
+        }
+        if (!status)
+        {
+            SYSTEM_PROCESS_INFORMATION *spi = (SYSTEM_PROCESS_INFORMATION *)buf;
+            for (;;)
+            {
+                out->x += src->kind == SRC_PROCESSES ? 1 : spi->dwThreadCount;
+                if (!spi->NextEntryOffset) break;
+                spi = (SYSTEM_PROCESS_INFORMATION *)((BYTE *)spi + spi->NextEntryOffset);
+            }
+        }
+        free( buf );
+        break;
+    }
+    default:
+        mem.dwLength = sizeof(mem);
+        GlobalMemoryStatusEx( &mem );
+        switch (src->kind)
+        {
+        case SRC_MEM_AVAIL:        out->x = mem.ullAvailPhys; break;
+        case SRC_MEM_AVAIL_MB:     out->x = mem.ullAvailPhys >> 20; break;
+        case SRC_MEM_COMMITTED:    out->x = mem.ullTotalPageFile - mem.ullAvailPageFile; break;
+        case SRC_MEM_COMMIT_LIMIT: out->x = mem.ullTotalPageFile; break;
+        default:                   out->x = mem.ullTotalPageFile - mem.ullAvailPageFile; out->y = mem.ullTotalPageFile; break;
+        }
+        break;
+    }
+    out->stamp = *(FILETIME *)&now;
+}
+
+/* the displayable value of a counter type from two samples (prev may be NULL) */
+static PDH_STATUS compute_value( DWORD type, LONGLONG base, const struct sample *cur, const struct sample *prev,
+                                 double *out )
+{
+    switch (type)
+    {
+    case TYPE_PROCESSOR_TIME:
+    case TYPE_TIMER_100NS:
+    {
+        LONGLONG dx, dy;
+        if (!prev) return PDH_INVALID_DATA;     /* a rate needs two samples */
+        dx = cur->x - prev->x;
+        dy = cur->y - prev->y;
+        if (dy <= 0) { *out = 0.0; return ERROR_SUCCESS; }
+        *out = 100.0 * (double)dx / (double)dy;
+        if (type == TYPE_PROCESSOR_TIME) *out = 100.0 - *out;
+        return ERROR_SUCCESS;
+    }
+    case TYPE_UPTIME:
+        *out = base ? (double)cur->x / (double)base : (double)cur->x;
+        return ERROR_SUCCESS;
+    case TYPE_LARGE_FRACTION:
+        *out = cur->y ? 100.0 * (double)cur->x / (double)cur->y : 0.0;
+        return ERROR_SUCCESS;
+    case TYPE_RAWCOUNT:
+    case TYPE_LARGE_RAWCOUNT:
+        *out = (double)cur->x;
+        return ERROR_SUCCESS;
+    default:
+        FIXME( "counter type %#lx\n", type );
+        *out = (double)cur->x;
+        return ERROR_SUCCESS;
+    }
+}
+
+/* a displayable value in the format asked for */
+static PDH_STATUS format_double( DWORD type, LONG scale, double v, DWORD format, PDH_FMT_COUNTERVALUE *value )
+{
+    if ((type & PERF_DISPLAY_PERCENT) == PERF_DISPLAY_PERCENT && (type & 0xf0000000) == PERF_DISPLAY_PERCENT &&
+        !(format & PDH_FMT_NOCAP100))
+        v = min( max( v, 0.0 ), 100.0 );
+    if (scale && !(format & PDH_FMT_NOSCALE)) v *= pow( 10, scale );
+    if (format & PDH_FMT_1000) v *= 1000.0;
+    if (format & PDH_FMT_LONG) value->longValue = (LONG)v;
+    else if (format & PDH_FMT_LARGE) value->largeValue = (LONGLONG)v;
+    else if (format & PDH_FMT_DOUBLE) value->doubleValue = v;
+    else
+    {
+        WARN( "unknown format %lx\n", format );
+        return PDH_INVALID_ARGUMENT;
+    }
+    value->CStatus = ERROR_SUCCESS;
+    return ERROR_SUCCESS;
+}
