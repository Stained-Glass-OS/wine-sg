+static void get_cpu_times( struct cpu_times *t )
+{
+    ULONG size = cpu_count * sizeof(*t->info);
+
+    t->count = 0;
+    if (!cpu_count || !(t->info = calloc( cpu_count, sizeof(*t->info) ))) return;
+    if (!NtQuerySystemInformation( SystemProcessorPerformanceInformation, t->info, size, &size ))
