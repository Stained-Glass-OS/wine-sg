From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: a crashed File Explorer window is forgotten; network drives are not polled

- File Explorer asks the shell's list of its windows (IShellWindows)
  whether a window shows the folder already, and brings that one forward.
  A window whose program ended without leaving the list (killed, crashed)
  stayed in it: opening that folder again "brought forward" the dead
  window and quit, and the folder did not open until the next sign-in (on
  the lab machine a share's folder would not open again after its File
  Explorer had been killed). The list now drops a window that is gone when
  it is asked.
- Every two seconds File Explorer asked each drive letter what kind of
  drive it is, to notice discs and USB drives come and go. For a network
  drive the answer is a request to its server, on the window's thread; with
  the server out of reach (a laptop away from the office) each one waited,
  and the window froze every two seconds. A letter's kind is now asked when
  the letter appears; only removable drives and discs are looked at each
  time.

Test: test/smbview-gate.sh (mutants SG_MUTANT_STALE_SHELLWINDOW in
programs/explorer/desktop.c, SG_MUTANT_DRIVES_POLL_ALL in
programs/explorer/fileexplorer.c).
---
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -3520,6 +3520,21 @@
 
     for (i = 0; i < sw->count; ++i)
     {
+#ifndef SG_MUTANT_STALE_SHELLWINDOW
+        /* Stained Glass OS: a window whose program ended without revoking it
+         * (killed, crashed) is gone from the list. It was found here forever:
+         * File Explorer, asked to open that folder again, brought the dead
+         * window "forward" and quit, and the folder never opened again until
+         * the next sign-in. */
+        if (sw->windows[i].hwnd && !IsWindow(LongToHandle(sw->windows[i].hwnd)))
+        {
+            free(sw->windows[i].pidl);
+            --sw->count;
+            memmove(&sw->windows[i], &sw->windows[i + 1], (sw->count - i) * sizeof(*sw->windows));
+            --i;
+            continue;
+        }
+#endif
         if (sw->windows[i].class == class && ILIsEqual(V_ARRAY(location)->pvData, sw->windows[i].pidl))
         {
             *hwnd = sw->windows[i].hwnd;
--- a/programs/explorer/fileexplorer.c
+++ b/programs/explorer/fileexplorer.c
@@ -3096,6 +3096,13 @@
  * again; one taken out stayed with its name and size. */
 static DWORD drives_signature(void)
 {
+    /* Stained Glass OS: a letter's type is asked when it appears, not every
+     * two seconds: asking a network drive is a request to its server, made
+     * on the window's thread -- and while the server cannot be reached (a
+     * laptop away from the office) each one waited, so File Explorer froze
+     * every two seconds. Only a removable drive's or a disc's medium is
+     * looked at each time. */
+    static DWORD known, types[26];
     DWORD mask = GetLogicalDrives(), sig = mask, i;
 
     for (i = 0; i < 26; i++)
@@ -3104,7 +3111,16 @@
         DWORD serial = 0, type;
 
         if (!(mask & (1 << i))) continue;
+#ifdef SG_MUTANT_DRIVES_POLL_ALL
         type = GetDriveTypeW(root);
+#else
+        if (!(known & (1 << i)))
+        {
+            types[i] = GetDriveTypeW(root);
+            if (types[i] != DRIVE_NO_ROOT_DIR) known |= 1 << i;
+        }
+        type = types[i];
+#endif
         if (type != DRIVE_REMOVABLE && type != DRIVE_CDROM) continue;
         /* the device alone still answers with the last disc's serial */
         if (GetFileAttributesW(root) != INVALID_FILE_ATTRIBUTES &&
@@ -3113,6 +3129,7 @@
         else
             sig = (sig * 31) ^ (0x80000000 >> i);
     }
+    known &= mask;   /* a letter that went is asked again when it comes back */
     return sig;
 }
 
