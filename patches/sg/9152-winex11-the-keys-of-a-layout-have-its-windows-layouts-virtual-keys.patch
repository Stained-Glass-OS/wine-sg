@@ -1837,6 +1846,18 @@ void X11DRV_InitKeyboard( Display *display )
     } /* for */
 #undef VKEY_IF_NOT_USED
 
+    /* Stained Glass OS (9152): the character keys of the main block have the virtual keys of the
+     * Windows layout the X map is (kbdsw's Ö key is VK_OEM_3, kbduk's # key VK_OEM_7), not the US
+     * key's at that place; letters keep theirs, and so do the keys X gives no character */
+    for (keyc = min_keycode; keyc <= max_keycode; keyc++)
+    {
+        BYTE old = keyc2vkey[keyc] & 0xff, sc = keyc2scan[keyc] & 0xff, vk;
+        if ((keyc2scan[keyc] & 0x100) || sc >= 0x80 || !(vk = windows_vks[sc])) continue;
+        if (!is_character_vkey( old ) || !is_character_vkey( vk )) continue;
+        TRACE( "keycode %u (scan %02x): vkey %02x -> %02x (its layout's own)\n", keyc, sc, old, vk );
+        keyc2vkey[keyc] = (keyc2vkey[keyc] & 0xff00) | vk;
+    }
+
     /* If some keys still lack scancodes, assign some arbitrary ones to them now */
     for (scan = 0x60, keyc = min_keycode; keyc <= max_keycode; keyc++)
       if (keyc2vkey[keyc]&&!keyc2scan[keyc]) {
