+/* (9152) the Windows virtual keys of the X map's main block by scan code (0: the X map's own), for the X map's
+ * tables (X11DRV_InitKeyboard): the keys of a Windows layout are its kbd*.dll's, whatever X calls them */
+void x11drv_x_map_windows_vks( Display *display, BYTE vks[0x80] )
+{
+    const struct windows_vk *keys;
+    unsigned int i;
+
+    memset( vks, 0, 0x80 );
+    pthread_mutex_lock( &foreign_mutex );
+    read_x_layout_names( display );
+    keys = x_layout[0] ? windows_vks_for( x_layout, x_variant ) : NULL;
+    pthread_mutex_unlock( &foreign_mutex );
+    if (keys) for (i = 0; keys[i].scan; i++) vks[keys[i].scan] = keys[i].vk;
+}
