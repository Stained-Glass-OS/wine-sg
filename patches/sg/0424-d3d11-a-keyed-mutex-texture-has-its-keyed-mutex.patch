+/* IDXGIKeyedMutex methods, for textures created with
+ * D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX. The texture cannot be opened from
+ * another device yet, so the mutex only has to order this device's users. */
+
+static inline struct d3d_texture2d *impl_from_IDXGIKeyedMutex(IDXGIKeyedMutex *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3d_texture2d, IDXGIKeyedMutex_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_QueryInterface(IDXGIKeyedMutex *iface, REFIID riid, void **object)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+
+    TRACE("iface %p, riid %s, object %p.\n", iface, debugstr_guid(riid), object);
+
+    return d3d11_texture2d_QueryInterface(&texture->ID3D11Texture2D_iface, riid, object);
+}
+
+static ULONG STDMETHODCALLTYPE dxgi_keyed_mutex_AddRef(IDXGIKeyedMutex *iface)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+
+    return d3d11_texture2d_AddRef(&texture->ID3D11Texture2D_iface);
+}
+
+static ULONG STDMETHODCALLTYPE dxgi_keyed_mutex_Release(IDXGIKeyedMutex *iface)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+
+    return d3d11_texture2d_Release(&texture->ID3D11Texture2D_iface);
+}
+
+static HRESULT dxgi_keyed_mutex_get_resource(struct d3d_texture2d *texture, IDXGIResource **resource)
+{
+    return IUnknown_QueryInterface(texture->dxgi_resource, &IID_IDXGIResource, (void **)resource);
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_SetPrivateData(IDXGIKeyedMutex *iface,
+        REFGUID guid, UINT data_size, const void *data)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    IDXGIResource *resource;
+    HRESULT hr;
+
+    TRACE("iface %p, guid %s, data_size %u, data %p.\n", iface, debugstr_guid(guid), data_size, data);
+
+    if (SUCCEEDED(hr = dxgi_keyed_mutex_get_resource(texture, &resource)))
+    {
+        hr = IDXGIResource_SetPrivateData(resource, guid, data_size, data);
+        IDXGIResource_Release(resource);
+    }
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_SetPrivateDataInterface(IDXGIKeyedMutex *iface,
+        REFGUID guid, const IUnknown *object)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    IDXGIResource *resource;
+    HRESULT hr;
+
+    TRACE("iface %p, guid %s, object %p.\n", iface, debugstr_guid(guid), object);
+
+    if (SUCCEEDED(hr = dxgi_keyed_mutex_get_resource(texture, &resource)))
+    {
+        hr = IDXGIResource_SetPrivateDataInterface(resource, guid, object);
+        IDXGIResource_Release(resource);
+    }
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_GetPrivateData(IDXGIKeyedMutex *iface,
+        REFGUID guid, UINT *data_size, void *data)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    IDXGIResource *resource;
+    HRESULT hr;
+
+    TRACE("iface %p, guid %s, data_size %p, data %p.\n", iface, debugstr_guid(guid), data_size, data);
+
+    if (SUCCEEDED(hr = dxgi_keyed_mutex_get_resource(texture, &resource)))
+    {
+        hr = IDXGIResource_GetPrivateData(resource, guid, data_size, data);
+        IDXGIResource_Release(resource);
+    }
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_GetParent(IDXGIKeyedMutex *iface, REFIID riid, void **parent)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    IDXGIResource *resource;
+    HRESULT hr;
+
+    TRACE("iface %p, riid %s, parent %p.\n", iface, debugstr_guid(riid), parent);
+
+    if (SUCCEEDED(hr = dxgi_keyed_mutex_get_resource(texture, &resource)))
+    {
+        hr = IDXGIResource_GetParent(resource, riid, parent);
+        IDXGIResource_Release(resource);
+    }
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_GetDevice(IDXGIKeyedMutex *iface, REFIID riid, void **device)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    IDXGIResource *resource;
+    HRESULT hr;
+
+    TRACE("iface %p, riid %s, device %p.\n", iface, debugstr_guid(riid), device);
+
+    if (SUCCEEDED(hr = dxgi_keyed_mutex_get_resource(texture, &resource)))
+    {
+        hr = IDXGIResource_GetDevice(resource, riid, device);
+        IDXGIResource_Release(resource);
+    }
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_AcquireSync(IDXGIKeyedMutex *iface, UINT64 key, DWORD timeout)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    ULONGLONG start = GetTickCount64(), elapsed;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, key %s, timeout %lu.\n", iface, wine_dbgstr_longlong(key), timeout);
+
+    AcquireSRWLockExclusive(&texture->keyed_mutex_lock);
+    while (texture->keyed_mutex_owned || texture->keyed_mutex_key != key)
+    {
+        elapsed = GetTickCount64() - start;
+        if (timeout != INFINITE && elapsed >= timeout)
+        {
+            hr = WAIT_TIMEOUT;
+            break;
+        }
+        SleepConditionVariableSRW(&texture->keyed_mutex_released, &texture->keyed_mutex_lock,
+                timeout == INFINITE ? INFINITE : timeout - elapsed, 0);
+    }
+    if (hr == S_OK)
+        texture->keyed_mutex_owned = TRUE;
+    ReleaseSRWLockExclusive(&texture->keyed_mutex_lock);
+
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_ReleaseSync(IDXGIKeyedMutex *iface, UINT64 key)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, key %s.\n", iface, wine_dbgstr_longlong(key));
+
+    AcquireSRWLockExclusive(&texture->keyed_mutex_lock);
+    if (!texture->keyed_mutex_owned)
+    {
+        WARN("The mutex is not acquired.\n");
+        hr = E_FAIL;
+    }
+    else
+    {
+        texture->keyed_mutex_owned = FALSE;
+        texture->keyed_mutex_key = key;
+        WakeAllConditionVariable(&texture->keyed_mutex_released);
+    }
+    ReleaseSRWLockExclusive(&texture->keyed_mutex_lock);
+
+    return hr;
+}
