+    /* IDXGIDeviceSubObject methods */
+    dxgi_keyed_mutex_GetDevice,
+    /* IDXGIKeyedMutex methods */
+    dxgi_keyed_mutex_AcquireSync,
+    dxgi_keyed_mutex_ReleaseSync,
+};
