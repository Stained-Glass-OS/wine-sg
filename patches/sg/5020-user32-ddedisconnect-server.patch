From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: Let a DDE server disconnect, and tell the client.

DdeDisconnect called by the server of a conversation ends it, as
DdeNameService(DNS_UNREGISTER) does for each conversation: the client gets
WM_DDE_TERMINATE. The client's callback now gets XTYP_DISCONNECT when its
partner ends the conversation ("received when the application's partner in
a conversation uses DdeDisconnect"); it got nothing. A server's
DdeDisconnect returned FALSE.

Gate: test/user32-ddedisconnect-gate.sh (64/32, private Xvfb).
---
 dlls/user32/dde_client.c | 22 ++++++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/dlls/user32/dde_client.c b/dlls/user32/dde_client.c
index bdfb19e..e51ffa8 100644
--- a/dlls/user32/dde_client.c
+++ b/dlls/user32/dde_client.c
@@ -900,6 +900,12 @@ static WDML_QUEUE_STATE WDML_HandleIncomingTerminate(WDML_CONV* pConv, MSG* msg,
 	/* don't care about result code (if server exists or not) */
 	PostMessageW(pConv->hwndServer, WM_DDE_TERMINATE, (WPARAM)pConv->hwndClient, 0L);
 	pConv->wStatus &= ~ST_CONNECTED;
+#ifndef SG_MUTANT_DDE_CLIENT_NO_DISCONNECT_CB
+        /* the server ended the conversation (DdeDisconnect, DdeNameService) */
+        if (!(pConv->instance->CBFflags & CBF_SKIP_DISCONNECTS))
+            WDML_InvokeCallback(pConv->instance, XTYP_DISCONNECT, 0, (HCONV)pConv,
+                                0, 0, 0, 0, (pConv->wStatus & ST_ISSELF) ? 1 : 0);
+#endif
     }
     /* have to keep connection around to allow reconnection */
     return WDML_QS_HANDLED;
@@ -1377,6 +1383,18 @@ BOOL WINAPI DdeDisconnect(HCONV hConv)
     }
 
     pConv = WDML_GetConv(hConv, TRUE);
+#ifndef SG_MUTANT_DDE_SERVER_DISCONNECT_FAILS
+    if (pConv != NULL && !(pConv->wStatus & ST_CLIENT))
+    {
+        /* a server ends the conversation as on DdeNameService(DNS_UNREGISTER):
+         * the client gets WM_DDE_TERMINATE, and with it XTYP_DISCONNECT */
+        HWND client = pConv->hwndClient, server = pConv->hwndServer;
+
+        WDML_RemoveConv(pConv, WDML_SERVER_SIDE);
+        PostMessageW(client, WM_DDE_TERMINATE, (WPARAM)server, 0);
+        return TRUE;
+    }
+#endif
     if (pConv != NULL)
     {
         if (pConv->wStatus & ST_CLIENT)
@@ -1398,10 +1416,6 @@ BOOL WINAPI DdeDisconnect(HCONV hConv)
                 /* still have to destroy data associated with conversation */
                 WDML_RemoveConv(pConv, WDML_CLIENT_SIDE);
             }
-            else
-            {
-                FIXME("Not implemented yet for a server side conversation\n");
-            }
         }
     }
 
