+    data_size_t size = get_req_data_size(), caps_size;
+    struct sid low_label = { SID_REVISION, 1, SECURITY_MANDATORY_LABEL_AUTHORITY, { SECURITY_MANDATORY_LOW_RID } };
+    struct token *src_token, *token;
