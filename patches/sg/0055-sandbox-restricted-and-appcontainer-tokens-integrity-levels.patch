 /*************************************************************************
+ * CreateAppContainerToken    (kernelbase.@)
+ *
+ * An AppContainer token for the package and capabilities in caps, made from
+ * token (or, if NULL, the calling process's).
+ */
+BOOL WINAPI CreateAppContainerToken( HANDLE token, SECURITY_CAPABILITIES *caps, HANDLE *ret )
+{
+    HANDLE process_token = NULL;
+    NTSTATUS status;
+
+    TRACE( "token %p, caps %p, ret %p\n", token, caps, ret );
+
+    if (!caps || !ret)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!token)
+    {
+        if (!OpenProcessToken( GetCurrentProcess(), TOKEN_ALL_ACCESS, &process_token )) return FALSE;
+        token = process_token;
+    }
+    status = NtCreateLowBoxToken( ret, token, TOKEN_ALL_ACCESS, NULL, caps->AppContainerSid,
+                                  caps->CapabilityCount, caps->Capabilities, 0, NULL );
+    if (process_token) NtClose( process_token );
+    return set_ntstatus( status );
+}
