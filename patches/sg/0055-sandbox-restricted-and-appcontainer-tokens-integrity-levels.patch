+        package->sub_count < 1 || package->sub_auth[0] != 2)
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    caps = (const struct sid *)((const char *)package + sid_len( package ));
+    caps_size = size - sid_len( package );
+    for (i = 0, c = caps, size = caps_size; i < req->cap_count; i++)
+    {
+        if (!sid_valid_size( c, size ))
+        {
+            set_error( STATUS_INVALID_PARAMETER );
+            return;
+        }
+        size -= sid_len( c );
+        c = (const struct sid *)((const char *)c + sid_len( c ));
+    }
+    caps_size -= size;
+
+    if (!(src_token = (struct token *)get_handle_obj( current->process, req->handle, TOKEN_DUPLICATE, &token_ops )))
+        return;
+    token = token_duplicate( src_token, src_token->primary, src_token->impersonation_level, NULL, NULL, 0, NULL, 0 );
+    release_object( src_token );
+    if (!token) return;
+
+    if (!(token->package_sid = memdup( package, sid_len( package ))) ||
+        (caps_size && !(token->capabilities = memdup( caps, caps_size ))) ||
+        !token_assign_label( token, &low_label ))
+    {
+        set_error( STATUS_NO_MEMORY );
+        release_object( token );
+        return;
+    }
+    token->capability_count = req->cap_count;
+    token->capability_size = caps_size;
+
+    if (token->default_dacl)
+    {
+        const struct acl *old = token->default_dacl;
+        data_size_t acl_size = old->size + sizeof(struct ace) + sid_len( package );
