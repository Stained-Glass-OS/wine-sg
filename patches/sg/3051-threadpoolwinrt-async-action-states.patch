+/* The completion handler runs once, when the action has finished and a handler is set. */
+static void async_action_invoke_handler(struct async_action *action)
+{
+    IAsyncActionCompletedHandler *handler = NULL;
+    AsyncStatus status = Started;
+
+    EnterCriticalSection(&action->cs);
+    if (action->status != Started && action->handler && !action->handler_invoked)
+    {
+        action->handler_invoked = TRUE;
+        IAsyncActionCompletedHandler_AddRef((handler = action->handler));
+        status = action->status;
+    }
+    LeaveCriticalSection(&action->cs);
+
+    if (handler)
+    {
+        IAsyncActionCompletedHandler_Invoke(handler, &action->IAsyncAction_iface, status);
+        IAsyncActionCompletedHandler_Release(handler);
+    }
 }
 
 static HRESULT STDMETHODCALLTYPE async_action_put_Completed(IAsyncAction *iface, IAsyncActionCompletedHandler *handler)
 {
-    FIXME("iface %p, handler %p stub!\n", iface, handler);
+    struct async_action *action = impl_from_IAsyncAction(iface);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, handler %p.\n", iface, handler);
+
+    if (!handler)
+        return E_POINTER;
+
+    EnterCriticalSection(&action->cs);
+    if (action->closed)
+        hr = E_ILLEGAL_METHOD_CALL;
+    else if (action->handler)
+        hr = E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    else
+        IAsyncActionCompletedHandler_AddRef((action->handler = handler));
+    LeaveCriticalSection(&action->cs);
+
+    if (SUCCEEDED(hr))
+        async_action_invoke_handler(action);
+    return hr;
 }
 
 static HRESULT STDMETHODCALLTYPE async_action_get_Completed(IAsyncAction *iface, IAsyncActionCompletedHandler **handler)
 {
-    FIXME("iface %p, handler %p stub!\n", iface, handler);
+    struct async_action *action = impl_from_IAsyncAction(iface);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, handler %p.\n", iface, handler);
+
+    EnterCriticalSection(&action->cs);
+    if (action->closed)
+    {
+        hr = E_ILLEGAL_METHOD_CALL;
+        *handler = NULL;
+    }
+    else if ((*handler = action->handler))
+        IAsyncActionCompletedHandler_AddRef(*handler);
+    LeaveCriticalSection(&action->cs);
+    return hr;
 }
 
 static HRESULT STDMETHODCALLTYPE async_action_GetResults(IAsyncAction *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct async_action *action = impl_from_IAsyncAction(iface);
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&action->cs);
+    if (action->closed || action->status == Started || action->status == Canceled)
+        hr = E_ILLEGAL_METHOD_CALL;
+    else
+        hr = action->status == Error ? action->error : S_OK;
+    LeaveCriticalSection(&action->cs);
+    return hr;
 }
 
