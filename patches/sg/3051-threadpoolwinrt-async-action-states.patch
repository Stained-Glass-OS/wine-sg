     SetEvent(item->event);
@@ -246,6 +240,47 @@ static void test_RunAsync(void)
     check_interface(action, &IID_IAsyncInfo, TRUE);
     check_interface(action, &IID_IInspectable, TRUE);
 
+    {
+        IAsyncInfo *info;
+        IAsyncActionCompletedHandler *completed;
+        UINT32 id = 0;
+        AsyncStatus status = Started;
+        HRESULT error = E_FAIL;
+        ULONG count = 0;
+        IID *iids;
+        HSTRING name;
+
+        hr = IAsyncAction_QueryInterface(action, &IID_IAsyncInfo, (void **)&info);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IAsyncInfo_get_Id(info, &id);
+        ok(hr == S_OK && id, "Unexpected hr %#lx, id %u.\n", hr, id);
+        /* the work item cancelled itself */
+        Sleep(50);
+        hr = IAsyncInfo_get_Status(info, &status);
+        ok(hr == S_OK && status == Canceled, "Unexpected hr %#lx, status %d.\n", hr, status);
+        hr = IAsyncInfo_get_ErrorCode(info, &error);
+        ok(hr == S_OK && error == S_OK, "Unexpected hr %#lx, error %#lx.\n", hr, error);
+        hr = IAsyncAction_GetResults(action);
+        ok(hr == E_ILLEGAL_METHOD_CALL, "Unexpected hr %#lx.\n", hr);
+
+        hr = IAsyncAction_GetIids(action, &count, &iids);
+        ok(hr == S_OK && count == 2, "Unexpected hr %#lx, count %lu.\n", hr, count);
+        if (hr == S_OK) CoTaskMemFree(iids);
+        hr = IAsyncAction_GetRuntimeClassName(action, &name);
+        ok(hr == S_OK && !wcscmp(WindowsGetStringRawBuffer(name, NULL), L"Windows.Foundation.IAsyncAction"),
+                "Unexpected hr %#lx.\n", hr);
+        if (hr == S_OK) WindowsDeleteString(name);
+
+        hr = IAsyncAction_get_Completed(action, &completed);
+        ok(hr == S_OK && !completed, "Unexpected hr %#lx.\n", hr);
+
+        hr = IAsyncInfo_Close(info);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IAsyncInfo_get_Status(info, &status);
+        ok(hr == E_ILLEGAL_METHOD_CALL, "Unexpected hr %#lx.\n", hr);
+        IAsyncInfo_Release(info);
+    }
+
     IAsyncAction_Release(action);
 
     hr = IThreadPoolStatics_RunWithPriorityAsync(threadpool_statics, item_iface, WorkItemPriority_Normal, &action);
