 static HRESULT STDMETHODCALLTYPE async_info_Cancel(IAsyncInfo *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct async_action *action = impl_from_IAsyncInfo(iface);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&action->cs);
+    if (action->closed)
+        hr = E_ILLEGAL_METHOD_CALL;
+    else if (action->status == Started)
+        action->status = Canceled; /* a running handler cannot be interrupted */
+    LeaveCriticalSection(&action->cs);
+    return hr;
 }
 
 static HRESULT STDMETHODCALLTYPE async_info_Close(IAsyncInfo *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct async_action *action = impl_from_IAsyncInfo(iface);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&action->cs);
+    if (action->status == Started)
+        hr = E_ILLEGAL_STATE_CHANGE;
+    else
+        action->closed = TRUE;
+    LeaveCriticalSection(&action->cs);
+    return hr;
 }
 
 static const IAsyncInfoVtbl async_info_vtbl =
@@ -277,6 +405,10 @@ static HRESULT async_action_create(IAsyncAction **ret)
     object->IAsyncAction_iface.lpVtbl = &async_action_vtbl;
     object->IAsyncInfo_iface.lpVtbl = &async_info_vtbl;
     object->refcount = 1;
+    object->id = InterlockedIncrement(&next_async_id);
+    object->status = Started;
+    InitializeCriticalSectionEx(&object->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    object->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": async_action.cs");
 
     *ret = &object->IAsyncAction_iface;
 
@@ -321,7 +453,27 @@ static HRESULT alloc_work_item(IWorkItemHandler *handler, struct work_item **ret
 
 static void work_item_invoke_release(struct work_item *item)
 {
-    IWorkItemHandler_Invoke(item->handler, item->action);
+    struct async_action *action = impl_from_IAsyncAction(item->action);
+    BOOL cancelled;
+    HRESULT hr = S_OK;
+
+    /* a work item that was cancelled before it started is not run */
+    EnterCriticalSection(&action->cs);
+    cancelled = action->status == Canceled;
+    LeaveCriticalSection(&action->cs);
+
+    if (!cancelled)
+        hr = IWorkItemHandler_Invoke(item->handler, item->action);
+
+    EnterCriticalSection(&action->cs);
+    if (action->status == Started)
+    {
+        action->status = FAILED(hr) ? Error : Completed;
+        action->error = hr;
+    }
+    LeaveCriticalSection(&action->cs);
+    async_action_invoke_handler(action);
+
     release_work_item(item);
 }
 
