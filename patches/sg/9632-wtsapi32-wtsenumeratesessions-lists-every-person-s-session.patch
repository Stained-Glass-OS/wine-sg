From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wtsapi32: WTSEnumerateSessions lists every person's session

WTSEnumerateSessions listed two sessions whatever the machine had: session 0
("Services") and the caller's own as the active console. In a shared prefix
each person has a session of their own and the services have SYSTEM's, so a
service saw no person's session at all: a service that starts its program on
the desktop of each person signed in (WTSEnumerateSessions, WTSQueryUserToken,
CreateProcessAsUser) never started it. WireGuard for Windows' manager service
starts its window this way, and its installer waited for the window ("system
tray icon did not appear after 30 seconds"; i0977).

Now, as on Windows, the list has every person's session too, from the server
(each user's session, kept for the server's life): the console's active, the
others disconnected (switched away from), with session 0 as before. In a
prefix of one user's own nothing changes.

Test: test/svcsubscribe-gate.sh does not cover it (one Unix user); verified in
the QA VM: as SYSTEM the list is 0, the sign-in screen's session and alice's
(active), and WTSQueryUserToken gives alice's token (limited, with its linked
token); WireGuard's manager then starts its window in her session. Mutant
SG_MUTANT_WTS_OWN_SESSION_ONLY (dlls/wtsapi32/wtsapi32.c).
---
--- a/dlls/wtsapi32/wtsapi32.c
+++ b/dlls/wtsapi32/wtsapi32.c
@@ -1030,13 +1030,38 @@
     return TRUE;
 }
 
+/* Stained Glass OS (i0977): the people's sessions in a shared prefix, from the server: each
+ * user has a session of their own, numbered from 2 on (SYSTEM's is 1) and kept for the
+ * server's life (get_session_uid answers for each); none in a prefix of one user's own */
+static DWORD user_sessions( DWORD *ids, DWORD max )
+{
+    DWORD id, n = 0;
+
+#ifdef SG_MUTANT_WTS_OWN_SESSION_ONLY
+    return 0;
+#endif
+    for (id = 2; n < max && id < 2 + 4096; id++)
+    {
+        NTSTATUS status;
+        SERVER_START_REQ( get_session_uid )
+        {
+            req->session_id = id;
+            status = wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        if (status) break;
+        ids[n++] = id;
+    }
+    return n;
+}
+
 /************************************************************
  *                WTSEnumerateEnumerateSessionsW  (WTSAPI32.@)
  *
- * The two sessions a Windows machine with Terminal Services off still has:
- * session 0 ("Services", disconnected, non-interactive) and the console
- * session (active, this process's session). No listener session, since
- * there is no RDP stack to listen with.
+ * Session 0 ("Services", disconnected, non-interactive) and the console
+ * session (active), as a Windows machine with Terminal Services off has, and
+ * in a shared prefix every other person's session (disconnected). No
+ * listener session, since there is no RDP stack to listen with.
  */
 BOOL WINAPI WTSEnumerateSessionsW(HANDLE server, DWORD reserved, DWORD version,
         PWTS_SESSION_INFOW *session_info, DWORD *count)
@@ -1044,7 +1069,7 @@
     static const WCHAR services_name[] = L"Services";
     static const WCHAR console_name[] = L"Console";
     WTS_SESSION_INFOW *array;
-    DWORD session_id;
+    DWORD session_id, ids[256], users, console, i, n;
     char *p;
 
     TRACE("%p 0x%08lx 0x%08lx %p %p\n", server, reserved, version, session_info, count);
@@ -1062,26 +1087,43 @@
     }
     if (!ProcessIdToSessionId(GetCurrentProcessId(), &session_id)) return FALSE;
 
-    if (!(array = malloc(2 * sizeof(*array) + sizeof(services_name) + sizeof(console_name))))
+    /* Every session, as on Windows: the services' and each person's -- the console's active,
+     * the others' disconnected (switched away from). It listed the caller's own alone, so a
+     * service saw no person's session at all and never started its program on their desktop
+     * (WireGuard's manager service its window, which its installer waits for). */
+    users = user_sessions( ids, ARRAY_SIZE(ids) );
+    console = WTSGetActiveConsoleSessionId();
+    n = users ? 1 + users : 2;
+
+    if (!(array = malloc(n * sizeof(*array) + sizeof(services_name) + sizeof(console_name))))
     {
         SetLastError(ERROR_OUTOFMEMORY);
         return FALSE;
     }
-    p = (char *)(array + 2);
+    p = (char *)(array + n);
 
     array[0].SessionId = 0;
     array[0].State = WTSDisconnected;
     array[0].pWinStationName = (WCHAR *)p;
     memcpy(p, services_name, sizeof(services_name));
     p += sizeof(services_name);
-
-    array[1].SessionId = session_id;
-    array[1].State = WTSActive;
-    array[1].pWinStationName = (WCHAR *)p;
     memcpy(p, console_name, sizeof(console_name));
 
+    if (!users)
+    {
+        array[1].SessionId = session_id;
+        array[1].State = WTSActive;
+        array[1].pWinStationName = (WCHAR *)p;
+    }
+    for (i = 0; i < users; i++)
+    {
+        array[1 + i].SessionId = ids[i];
+        array[1 + i].State = ids[i] == console ? WTSActive : WTSDisconnected;
+        array[1 + i].pWinStationName = ids[i] == console ? (WCHAR *)p : (WCHAR *)(p + sizeof(console_name) - sizeof(WCHAR));
+    }
+
     *session_info = array;
-    *count = 2;
+    *count = n;
     return TRUE;
 }
 
