From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, server: Another process's swap chain keeps its window's area (6500)

Chromium's GPU process (Chrome, Edge, Opera, Electron and CEF programs)
presents into the browser's windows (0586): into a child window its
frames are copied into the browser's X window, into a top-level its
client window is shown in place (6046). The browser's window surface
was flushed over both whenever it painted there -- an expose, a lock,
a compositor starting, erasing its background -- and the page stayed
white until the next present, which a still page never makes. 1523's
reshow only knows the flushing process's own frames, and 6046's in-place
window was painted over too (the surface's GC includes inferiors).

As a window of the process's own with a pixel format is, such a window
is now left out of its window surface (the server's surface region):
the presenting process sends WM_WINE_CLIENT_SURFACE (its id, +1 for a
surface made, -1 for one destroyed) to the window's thread, which counts
them per process (a process that ended counts no more) and sends
SET_WINPOS_PIXEL_FORMAT while any is there. GDI drawing into such a
window still goes to the window surface, which leaves the area out, as
Windows' compositor shows a swap chain over whatever GDI drew. UIPI lets
the message through to a window of more integrity: Chromium's GPU process
is sandboxed at low integrity, and it presents into that window anyway.
---
diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index e2f5825..d294484 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -1047,7 +1047,9 @@ static void update_visible_region( struct dce *dce )
 #endif
 
     /* don't use a surface to paint the client area of OpenGL windows */
-    if (!(paint_flags & SET_WINPOS_PIXEL_FORMAT) || (flags & DCX_WINDOW))
+    /* (another process's swap chain, 6500: GDI paints the surface, which leaves it out) */
+    if (!(paint_flags & SET_WINPOS_PIXEL_FORMAT) || (flags & DCX_WINDOW) ||
+        has_foreign_client_surface( dce->hwnd, TRUE ))
     {
         win = get_win_ptr( top_win );
         if (win && win != WND_DESKTOP && win != WND_OTHER_PROCESS)
diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index 90bfe93..51fd49e 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2092,6 +2092,8 @@ static LRESULT handle_internal_message( HWND hwnd, UINT msg, WPARAM wparam, LPAR
         return print_window_to_section( hwnd, (HANDLE)wparam, lparam );
     case WM_WINE_GETPLACEMENT:
         return get_window_placement_part( hwnd, wparam );
+    case WM_WINE_CLIENT_SURFACE:
+        return set_foreign_client_surface( hwnd, wparam, lparam );
     case WM_WINE_SHOWWINDOW:
         if (is_desktop_window( hwnd )) return 0;
         return NtUserShowWindow( hwnd, wparam );
diff --git a/dlls/win32u/ntuser_private.h b/dlls/win32u/ntuser_private.h
index ceac0dc..2660304 100644
--- a/dlls/win32u/ntuser_private.h
+++ b/dlls/win32u/ntuser_private.h
@@ -82,6 +82,7 @@ typedef struct tagWND
     UINT               cloaked;       /* DWM_CLOAKED_* bits, as the server last reported them */
     UINT               cloak_request; /* SET_WINPOS_(UN)CLOAK* for the next set_window_pos */
     int                internal_pixel_format; /* Internal pixel format set via WGL_WINE_pixel_format_passthrough */
+    struct { DWORD pid; int count; } foreign_surfaces[4]; /* other processes' swap chains in it (6500) */
     int                cbWndExtra;    /* class cbWndExtra at window creation */
     DWORD_PTR          userdata;      /* User private data */
     DWORD              wExtra[1];     /* Window extra bytes */
diff --git a/dlls/win32u/spy.c b/dlls/win32u/spy.c
index 5cadfb5..02eef04 100644
--- a/dlls/win32u/spy.c
+++ b/dlls/win32u/spy.c
@@ -1127,7 +1127,7 @@ static const char * const CCMMessageTypeNames[SPY_MAX_CCMMSGNUM + 1] =
     "CCM_SETNOTIFYWINDOW"
 };
 
-#define SPY_MAX_WINEMSGNUM   (WM_WINE_GETPLACEMENT - WM_WINE_DESTROYWINDOW)
+#define SPY_MAX_WINEMSGNUM   (WM_WINE_CLIENT_SURFACE - WM_WINE_DESTROYWINDOW)
 static const char * const WINEMessageTypeNames[SPY_MAX_WINEMSGNUM + 1] =
 {
     "WM_WINE_DESTROYWINDOW",
@@ -1145,6 +1145,7 @@ static const char * const WINEMessageTypeNames[SPY_MAX_WINEMSGNUM + 1] =
     "WM_WINE_SETCLOAK",
     "WM_WINE_PRINTWINDOW",
     "WM_WINE_GETPLACEMENT",
+    "WM_WINE_CLIENT_SURFACE",
 };
 
 /* Virtual key names */
diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index 84657e4..e5ce25f 100644
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -51,6 +51,7 @@ struct surface
     struct vulkan_surface obj;
     void *driver_private;
     HWND hwnd;
+    BOOL foreign;   /* another process's window, told of it (6500) */
 
     struct list entry;
     struct rb_entry window_entry;
@@ -149,7 +150,13 @@ static VkResult win32u_vkCreateWin32SurfaceKHR( VkInstance client_instance, cons
     }
 
     if (!(win = get_win_ptr( surface->hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS)
+    {
         list_init( &surface->entry );
+        /* Stained Glass OS (6500): another process's window keeps its area for our frames */
+        if (win == WND_OTHER_PROCESS &&
+            send_notify_message( surface->hwnd, WM_WINE_CLIENT_SURFACE, GetCurrentProcessId(), 1, FALSE ))
+            surface->foreign = TRUE;
+    }
     else
     {
         list_add_tail( &win->vulkan_surfaces, &surface->entry );
@@ -184,6 +191,7 @@ static void win32u_vkDestroySurfaceKHR( VkInstance client_instance, VkSurfaceKHR
         list_remove( &surface->entry );
         release_win_ptr( win );
     }
+    if (surface->foreign) send_notify_message( surface->hwnd, WM_WINE_CLIENT_SURFACE, GetCurrentProcessId(), -1, FALSE );
 
     instance->p_vkDestroySurfaceKHR( instance->host.instance, surface->obj.host.surface, NULL /* allocator */ );
     driver_funcs->p_vulkan_surface_destroy( surface->hwnd, surface->driver_private );
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
index d9f8f4e..4d22dc0 100644
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -315,6 +315,8 @@ extern LONG_PTR set_window_long( HWND hwnd, INT offset, UINT size, LONG_PTR newv
 extern BOOL set_window_pos( WINDOWPOS *winpos, int parent_x, int parent_y );
 extern BOOL set_window_cloak( HWND hwnd, UINT flags );
 extern LRESULT print_window_to_section( HWND hwnd, HANDLE section, LPARAM lparam );
+extern LRESULT set_foreign_client_surface( HWND hwnd, DWORD pid, LPARAM delta );
+extern BOOL has_foreign_client_surface( HWND hwnd, BOOL only );
 extern LRESULT get_window_placement_part( HWND hwnd, UINT part );
 extern ULONG set_window_style( HWND hwnd, ULONG set_bits, ULONG clear_bits );
 extern BOOL show_owned_popups( HWND owner, BOOL show );
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index f225401..e05ed05 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -1513,6 +1513,94 @@ int win32u_get_window_pixel_format( HWND hwnd )
     return ret;
 }
 
+/* Stained Glass OS (wine-sg 6500): another process's swap chain in a window of ours.
+ * Chromium's GPU process (Chrome, Edge, Opera, Electron and CEF programs: Dropbox,
+ * Spotify, Steam) presents into the browser's windows (0586, 6046). As in a window of
+ * our own with a pixel format, its area is left out of the window surface: the browser's
+ * own painting there (an expose, a lock, a compositor starting, erasing its background)
+ * was flushed over the frames, white until the next present -- which a still page never
+ * makes. On Windows the compositor shows a swap chain over whatever GDI drew there. The
+ * presenting process tells the window's thread (WM_WINE_CLIENT_SURFACE: its id, +1 when
+ * it makes a surface, -1 when it destroys it); a process that ended counts no more. */
+static BOOL foreign_client_surface( const WND *win )
+{
+    unsigned int i;
+
+#ifdef SG_MUTANT_FOREIGN_SURFACE_PAINTED
+    return FALSE;
+#endif
+    for (i = 0; i < ARRAY_SIZE(win->foreign_surfaces); i++)
+        if (win->foreign_surfaces[i].count > 0) return TRUE;
+    return FALSE;
+}
+
+/* HWND has another process's swap chain; ONLY: and none of its own */
+BOOL has_foreign_client_surface( HWND hwnd, BOOL only )
+{
+    WND *win = get_win_ptr( hwnd );
+    BOOL ret;
+
+    if (!win || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return FALSE;
+    ret = foreign_client_surface( win );
+    if (only && (win->pixel_format || win->internal_pixel_format)) ret = FALSE;
+    release_win_ptr( win );
+    return ret;
+}
+
+static BOOL process_is_alive( DWORD pid )
+{
+    OBJECT_ATTRIBUTES attr = { sizeof(attr) };
+    CLIENT_ID cid = { ULongToHandle( pid ), 0 };
+    LARGE_INTEGER zero = { .QuadPart = 0 };
+    HANDLE process;
+    NTSTATUS status;
+
+    if (NtOpenProcess( &process, SYNCHRONIZE, &attr, &cid )) return FALSE;
+    status = NtWaitForSingleObject( process, FALSE, &zero );
+    NtClose( process );
+    return status == STATUS_TIMEOUT;
+}
+
+LRESULT set_foreign_client_surface( HWND hwnd, DWORD pid, LPARAM delta )
+{
+    DWORD pids[ARRAY_SIZE(((WND *)0)->foreign_surfaces)];
+    BOOL alive[ARRAY_SIZE(pids)], before, after;
+    unsigned int i, free_slot = ARRAY_SIZE(pids);
+    WND *win;
+
+    if (!pid || (delta != 1 && delta != -1)) return 0;
+    /* processes that ended keep no surface (looked at outside the user lock) */
+    if (!(win = get_win_ptr( hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return 0;
+    for (i = 0; i < ARRAY_SIZE(pids); i++)
+        pids[i] = win->foreign_surfaces[i].count > 0 ? win->foreign_surfaces[i].pid : 0;
+    release_win_ptr( win );
+    for (i = 0; i < ARRAY_SIZE(pids); i++) alive[i] = !pids[i] || pids[i] == pid || process_is_alive( pids[i] );
+
+    if (!(win = get_win_ptr( hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return 0;
+    before = foreign_client_surface( win );
+    for (i = 0; i < ARRAY_SIZE(pids); i++)
+        if (!alive[i] && win->foreign_surfaces[i].pid == pids[i]) win->foreign_surfaces[i].count = 0;
+    for (i = 0; i < ARRAY_SIZE(pids); i++)
+    {
+        if (win->foreign_surfaces[i].count > 0 && win->foreign_surfaces[i].pid == pid) break;
+        if (win->foreign_surfaces[i].count <= 0 && free_slot == ARRAY_SIZE(pids)) free_slot = i;
+    }
+    if (i == ARRAY_SIZE(pids) && delta > 0 && free_slot < ARRAY_SIZE(pids))
+    {
+        i = free_slot;
+        win->foreign_surfaces[i].pid = pid;
+        win->foreign_surfaces[i].count = 0;
+    }
+    if (i < ARRAY_SIZE(pids)) win->foreign_surfaces[i].count = max( 0, win->foreign_surfaces[i].count + (int)delta );
+    after = foreign_client_surface( win );
+    release_win_ptr( win );
+
+    TRACE( "%p: process %04x %s a surface; another process's swap chain: %d\n", hwnd, (int)pid,
+           delta > 0 ? "made" : "destroyed", after );
+    if (before != after) update_window_state( hwnd );
+    return 1;
+}
+
 static int window_has_client_surface( HWND hwnd )
 {
     WND *win = get_win_ptr( hwnd );
@@ -2258,7 +2346,7 @@ static BOOL apply_window_pos( HWND hwnd, HWND insert_after, UINT swp_flags, stru
         }
         if (new_surface) req->paint_flags |= SET_WINPOS_PAINT_SURFACE;
         if (is_layered) req->paint_flags |= SET_WINPOS_LAYERED_WINDOW;
-        if (win->pixel_format || win->internal_pixel_format)
+        if (win->pixel_format || win->internal_pixel_format || foreign_client_surface( win ))
             req->paint_flags |= SET_WINPOS_PIXEL_FORMAT;
         req->paint_flags |= win->cloak_request;
 
diff --git a/include/ntuser.h b/include/ntuser.h
index b4197e7..3911d2f 100644
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -618,6 +618,7 @@ enum wine_internal_message
     WM_WINE_SETCLOAK,
     WM_WINE_PRINTWINDOW,
     WM_WINE_GETPLACEMENT,   /* Stained Glass OS 1660 */
+    WM_WINE_CLIENT_SURFACE, /* Stained Glass OS 6500: another process's swap chain in the window */
     WM_WINE_FIRST_DRIVER_MSG = 0x80001000,  /* range of messages reserved for the USER driver */
     WM_WINE_CLIPCURSOR = 0x80001ff0, /* internal driver notification messages */
     WM_WINE_SETCURSOR,
diff --git a/server/queue.c b/server/queue.c
index f7c785b..a03a80b 100644
--- a/server/queue.c
+++ b/server/queue.c
@@ -3448,6 +3448,13 @@ int uipi_allows( struct process *sender, struct process *receiver, unsigned int
      * owner and viewers are sent whoever changed it */
     case WM_DESTROYCLIPBOARD: case WM_RENDERALLFORMATS: case WM_CLIPBOARDUPDATE:
         return 1;
+#ifndef SG_MUTANT_UIPI_CLIENT_SURFACE
+    /* Stained Glass OS (6500): a swap chain of a process with less integrity in the window
+     * (Chromium's sandboxed GPU process in the browser's): it only leaves the window's area
+     * to the frames, which that process presents into it anyway */
+    case WM_WINE_CLIENT_SURFACE:
+        return 1;
+#endif
     }
     return 0;
 }
