From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: x:Uid takes members from the application's string resources

x:Uid was ignored, so localized programs showed their markup's placeholder texts: NanaZip's dialogs said "[Cancel]". An element with x:Uid now takes its members from the application's string resources once it is made, over the markup's values: x:Uid="Name" reads Resources' Name.Content, Name.Text and the like, x:Uid="/File/Name" those of resource file File, through the ResourceLoader of the application's resources.pri; names without strings keep the markup's values. Compiled and text markup alike. Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/markup.c b/dlls/windows.ui.xaml/markup.c
index 216bbcf..967a783 100644
--- a/dlls/windows.ui.xaml/markup.c
+++ b/dlls/windows.ui.xaml/markup.c
@@ -942,6 +942,7 @@ struct text_state
     int depth;
     struct xmlns_entry ns[64];
     unsigned int nns;
+    WCHAR *uid;                     /* the x:Uid of the element whose attributes are read */
 };
 
 /* prefix:Name as a full type name: ours (presentation) or the application's (using:) */
@@ -1030,7 +1031,8 @@ static HRESULT read_attributes( struct text_state *state, IInspectable *obj, WCH
             if (!wcscmp( local, L"Name" )) xaml_writer_set( state->writer, obj, NULL, L"Name", value, NULL );
             else if (!wcscmp( local, L"ConnectionId" )) connection = wcstol( value, NULL, 10 );
             else if (!wcscmp( local, L"Key" ) && key && !*key) *key = wcsdup( value );
-            continue;   /* x:Class, x:Uid ... */
+            else if (!wcscmp( local, L"Uid" ) && !state->uid) state->uid = wcsdup( value );
+            continue;   /* x:Class ... */
         }
         if (ignorable( ns ) || !wcscmp( local, L"xmlns" ) || IXmlReader_IsDefault( state->reader )) continue;
         if (*ns && wcscmp( ns, ns_presentation ) && wcsncmp( ns, L"using:", 6 )) continue;
@@ -1254,6 +1256,85 @@ static HRESULT skip_element( struct text_state *state )
 }
 
 /* the reader is on an element's start: its object, made (or existing: a component's root) */
+/* ---- x:Uid: an element's members from the application's string resources ---- */
+
+static const GUID IID_IResourceLoaderFactory_x = { 0xc33a3603, 0x69dc, 0x4285, { 0xa0, 0x77, 0xd5, 0xc0, 0xe4, 0x7c, 0xcb, 0xe8 } };
+
+/* the members a string resource commonly localizes */
+static const WCHAR *uid_members[] = { L"Content", L"Text", L"Header", L"PlaceholderText", L"Label", L"Title", L"Description" };
+
+static IInspectable *uid_loader( const WCHAR *file )
+{
+    static WCHAR cached_file[256];
+    static IInspectable *cached;
+    IInspectable *factory = NULL, *loader = NULL;
+    HSTRING name;
+
+    if (cached && !wcscmp( cached_file, file )) return cached;
+    if (FAILED(WindowsCreateString( L"Windows.ApplicationModel.Resources.ResourceLoader",
+                                    wcslen( L"Windows.ApplicationModel.Resources.ResourceLoader" ), &name ))) return NULL;
+    RoGetActivationFactory( name, &IID_IResourceLoaderFactory_x, (void **)&factory );
+    WindowsDeleteString( name );
+    if (!factory) return NULL;
+    if (SUCCEEDED(WindowsCreateString( file, wcslen( file ), &name )))
+    {
+        CALL( factory, 6, HRESULT (WINAPI *)( IInspectable *, HSTRING, IInspectable ** ) )( factory, name, &loader );
+        WindowsDeleteString( name );
+    }
+    IInspectable_Release( factory );
+    if (!loader || wcslen( file ) >= ARRAY_SIZE(cached_file)) return loader;   /* not kept: the caller releases nothing */
+    if (cached) IInspectable_Release( cached );
+    cached = loader;
+    wcscpy( cached_file, file );
+    return cached;
+}
+
+/* x:Uid="Name" takes Resources' "Name.Member" strings, x:Uid="/File/Name" those of File */
+void xaml_apply_uid( struct xaml_writer *writer, IInspectable *obj, const WCHAR *uid )
+{
+    struct dobj *d = dobj_from_inspectable( obj );
+    const WCHAR *slash, *base;
+    WCHAR file[256], key[300];
+    IInspectable *loader;
+    unsigned int i;
+
+    if (!d || !uid || !*uid) return;
+#ifdef SG_MUTANT_XAML_NO_UID
+    return;
+#endif
+    if (uid[0] == '/' && (slash = wcsrchr( uid, '/' )) && slash > uid)
+    {
+        if (slash - uid - 1 >= ARRAY_SIZE(file)) return;
+        memcpy( file, uid + 1, (slash - uid - 1) * sizeof(WCHAR) );
+        file[slash - uid - 1] = 0;
+        base = slash + 1;
+    }
+    else
+    {
+        wcscpy( file, L"Resources" );
+        base = uid;
+    }
+    if (!(loader = uid_loader( file ))) return;
+    for (i = 0; i < ARRAY_SIZE(uid_members); i++)
+    {
+        HSTRING name = NULL, value = NULL;
+        const WCHAR *str;
+
+        if (!xaml_find_member( d, uid_members[i] )) continue;
+        swprintf( key, ARRAY_SIZE(key), L"%s/%s", base, uid_members[i] );
+        if (FAILED(WindowsCreateString( key, wcslen( key ), &name ))) continue;
+        if (SUCCEEDED(CALL( loader, 6, HRESULT (WINAPI *)( IInspectable *, HSTRING, HSTRING * ) )( loader, name, &value )) &&
+            (str = WindowsGetStringRawBuffer( value, NULL )) && *str)
+        {
+            TRACE( "%s: %s = %s\n", debugstr_w( uid ), debugstr_w( uid_members[i] ), debugstr_w( str ) );
+            xaml_writer_set( writer, obj, NULL, uid_members[i], str, NULL );
+        }
+        WindowsDeleteString( value );
+        WindowsDeleteString( name );
+    }
+    if (loader && wcslen( file ) >= 256) IInspectable_Release( loader );
+}
+
 /* a value element -- <Color x:Key="...">#AARRGGBB</Color>, <x:Double>12</x:Double> -- its value from its text */
 static const WCHAR *value_element_type( const WCHAR *ns, const WCHAR *name )
 {
@@ -1316,6 +1397,7 @@ static HRESULT read_element( struct text_state *state, IInspectable *existing, I
 {
     const WCHAR *local, *ns, *value_type;
     IInspectable *obj = NULL;
+    WCHAR *uid = NULL;
     BOOL empty;
     HRESULT hr;
 
@@ -1345,7 +1427,10 @@ static HRESULT read_element( struct text_state *state, IInspectable *existing, I
         return hr;
     }
     if (state->writer->depth < XAML_MAX_DEPTH) state->writer->scope[state->writer->depth++] = obj;
-    if (SUCCEEDED(hr = read_attributes( state, obj, key )) && !empty)
+    hr = read_attributes( state, obj, key );
+    uid = state->uid;
+    state->uid = NULL;
+    if (SUCCEEDED(hr) && !empty)
     {
         if (xaml_is_template( obj ))
         {
@@ -1355,6 +1440,9 @@ static HRESULT read_element( struct text_state *state, IInspectable *existing, I
         }
         else hr = read_content( state, obj, local );
     }
+    /* x:Uid: its localized members over those of the markup */
+    if (uid && SUCCEEDED(hr)) xaml_apply_uid( state->writer, obj, uid );
+    free( uid );
     if (state->writer->depth && state->writer->scope[state->writer->depth - 1] == obj) state->writer->depth--;
     pop_xmlns( state );
     state->depth--;
diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
index d1a1692..342363e 100644
--- a/dlls/windows.ui.xaml/private.h
+++ b/dlls/windows.ui.xaml/private.h
@@ -652,6 +652,7 @@ IInspectable *xaml_application_resources( IInspectable *app );
 /* markup.c, for styles */
 struct xaml_property *xaml_find_member( struct dobj *obj, const WCHAR *name );
 HRESULT xaml_value_from_string( const WCHAR *type, const WCHAR *str, IInspectable **value );
+void xaml_apply_uid( struct xaml_writer *writer, IInspectable *obj, const WCHAR *uid );
 extern IActivationFactory *resource_dictionary_factory, *style_factory, *setter_factory;
 
 /* ---- templates (templates.c), presenters (control.c) ---- */
diff --git a/dlls/windows.ui.xaml/xbf.c b/dlls/windows.ui.xaml/xbf.c
index 9ca9547..a0e7415 100644
--- a/dlls/windows.ui.xaml/xbf.c
+++ b/dlls/windows.ui.xaml/xbf.c
@@ -276,6 +276,7 @@ struct frame
     IInspectable *obj;             /* NULL: something we do not make (a resource reference ...) */
     BOOL root;
     BOOL scoped;                   /* in the writer's scope: {StaticResource} looks in it */
+    WCHAR *uid;                    /* its x:Uid: its localized members, set when it is complete */
 };
 
 struct collection
@@ -459,6 +460,7 @@ static HRESULT push_frame( struct xbf_state *s, IInspectable *obj, BOOL root )
     }
     s->frames[s->nframes].obj = obj;
     s->frames[s->nframes].root = root;
+    s->frames[s->nframes].uid = NULL;
     s->frames[s->nframes].scoped = obj && s->writer->depth < XAML_MAX_DEPTH;
     if (s->frames[s->nframes].scoped) s->writer->scope[s->writer->depth++] = obj;
     s->nframes++;
@@ -489,6 +491,12 @@ static IInspectable *pop_frame( struct xbf_state *s )
         break;
     }
     obj = s->frames[--s->nframes].obj;
+    if (s->frames[s->nframes].uid)
+    {
+        if (obj) xaml_apply_uid( s->writer, obj, s->frames[s->nframes].uid );
+        free( s->frames[s->nframes].uid );
+        s->frames[s->nframes].uid = NULL;
+    }
     if (s->frames[s->nframes].scoped && s->writer->depth) s->writer->depth--;
     return obj;
 }
@@ -992,8 +1000,12 @@ static HRESULT read_nodes( struct xbf_state *s, struct rd *r, enum read_mode mod
             if ((value = read_value( s, r )) && top_object( s ))
                 hr = xaml_writer_set( s->writer, top_object( s ), NULL, L"Name", value, NULL );
             break;
-        case 0x0e:                  /* x:Uid */
-            free( read_value( s, r ) );
+        case 0x0e:                  /* x:Uid: the localized members, once the object is complete */
+            if ((value = read_value( s, r )) && s->nframes && !s->frames[s->nframes - 1].uid)
+            {
+                s->frames[s->nframes - 1].uid = value;
+                value = NULL;
+            }
             break;
         case 0x04:                  /* text or a class modifier */
             if (!(value = read_value( s, r ))) break;
@@ -1204,6 +1216,7 @@ static HRESULT load_xbf( struct xbf_blob *blob, UINT32 section, IInspectable *co
     hr = section < xbf.nsections ? read_section( s, section, 0, READ_ALL ) : E_INVALIDARG;
     if (SUCCEEDED(hr) && s->nframes)
     {
+        if (s->frames[0].uid && s->frames[0].obj) xaml_apply_uid( s->writer, s->frames[0].obj, s->frames[0].uid );
         *out = s->frames[0].obj;
         s->frames[0].obj = NULL;
     }
