From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comctl32: a Walk program's toolbar, tab control and list view draw as on Windows

WireGuard's window (a Walk/lxn program over the common controls) drew its
Tunnels page without the Remove and Export buttons, a black strip beside the
tabs and a grey tunnel list (i1013). Three comctl32 differences from Windows:

- toolbar: a wrapping toolbar (TBSTYLE_WRAPABLE) wrapped at the width its last
  WM_SIZE told, and Walk answers WM_WINDOWPOSCHANGED itself (it sends
  TB_AUTOSIZE and passes nothing on), so it wrapped every button as at width
  0. It now wraps at its present client width, as Windows does, and an
  autosized button wraps at the width it is laid out at, not at the widest
  button's. TB_GETIDEALSIZE's width is the one-row width of all buttons,
  whatever the present width (Walk sizes the toolbar from it).
- tab control: WM_PRINTCLIENT with PRF_ERASEBKGND erases the client area first
  (class background, then the parent's when themed); Walk prints the tab
  control into a fresh bitmap and showed the unerased strip black.
- list view: a double-buffered list view (LVS_EX_DOUBLEBUFFER) paints its own
  background in every paint, whatever WM_ERASEBKGND did (Walk's TableView
  answers WM_ERASEBKGND itself), as Windows' buffered paint does.

Gate test/walkui-gate.sh (probe test/walkui-probe.c); mutants
SG_MUTANT_WRAP_CACHED_WIDTH, SG_MUTANT_WRAP_FIXED_WIDTH,
SG_MUTANT_IDEAL_WRAPPED, SG_MUTANT_TAB_PRINT_NO_ERASE,
SG_MUTANT_LV_DOUBLEBUFFER_NO_FILL.
---
--- a/dlls/comctl32/toolbar.c
+++ b/dlls/comctl32/toolbar.c
@@ -251,6 +251,7 @@
 static HIMAGELIST TOOLBAR_InsertImageList(PIMLENTRY **pies, INT *cies, HIMAGELIST himl, INT id);
 static LRESULT TOOLBAR_LButtonDown(TOOLBAR_INFO *infoPtr, WPARAM wParam, LPARAM lParam);
 static void TOOLBAR_LayoutToolbar(TOOLBAR_INFO *infoPtr);
+static SIZE TOOLBAR_MeasureButton(const TOOLBAR_INFO *infoPtr, SIZE sizeString, BOOL bHasBitmap, BOOL bValidImageList);
 static LRESULT TOOLBAR_AutoSize(TOOLBAR_INFO *infoPtr);
 static void TOOLBAR_CheckImageListIconSize(TOOLBAR_INFO *infoPtr);
 static void TOOLBAR_TooltipAddTool(const TOOLBAR_INFO *infoPtr, const TBUTTON_INFO *button);
@@ -1598,7 +1599,18 @@
 
     btnPtr = infoPtr->buttons;
     x  = infoPtr->nIndent;
+#ifndef SG_MUTANT_WRAP_CACHED_WIDTH
+    /* Stained Glass OS (vpn2, i1013): the toolbar's present width, as Windows wraps at -- not the
+     * width its last WM_SIZE told: a program that answers WM_WINDOWPOSCHANGED itself (Walk does,
+     * and sends TB_AUTOSIZE) never lets WM_SIZE through, and every button wrapped as at width 0 */
+    {
+        RECT rc;
+        GetClientRect(infoPtr->hwndSelf, &rc);
+        width = rc.right - rc.left;
+    }
+#else
     width = infoPtr->client_rect.right - infoPtr->client_rect.left;
+#endif
 #ifndef SG_MUTANT_NO_BOUNDING
     if (infoPtr->szBounding.cx > 0) width = infoPtr->szBounding.cx;
 #endif
@@ -1622,6 +1634,26 @@
 	else if ((btnPtr[i].fsStyle & BTNS_SEP) &&
             !(infoPtr->dwStyle & CCS_VERT))
             cx = (btnPtr[i].iBitmap > 0) ? btnPtr[i].iBitmap : SEPARATOR_WIDTH;
+#ifndef SG_MUTANT_WRAP_FIXED_WIDTH
+        /* Stained Glass OS (vpn2, i1013): an autosized button wraps at the width it is laid out
+         * at (TOOLBAR_LayoutToolbar), not at the widest button's: a list-style toolbar with one
+         * text button and icon-only ones (WireGuard's Add Tunnel, Remove, Export) put every button
+         * on a row of its own, in a toolbar wide enough for all of them */
+        else if (btnPtr[i].fsStyle & BTNS_AUTOSIZE)
+        {
+            SIZE sz, sizeButton;
+            HDC hdc = GetDC (infoPtr->hwndSelf);
+            HFONT hOldFont = SelectObject (hdc, infoPtr->hFont);
+
+            TOOLBAR_MeasureString(infoPtr, btnPtr + i, hdc, &sz);
+            SelectObject (hdc, hOldFont);
+            ReleaseDC (infoPtr->hwndSelf, hdc);
+            sizeButton = TOOLBAR_MeasureButton(infoPtr, sz,
+                TOOLBAR_IsValidBitmapIndex(infoPtr, btnPtr[i].iBitmap),
+                TOOLBAR_IsValidImageList(infoPtr, 0));
+            cx = sizeButton.cx;
+        }
+#endif
 	else
 	    cx = infoPtr->nButtonWidth;
 
@@ -5519,8 +5551,27 @@
 
     switch(wParam) {
     case 0:
+    {
+        /* Stained Glass OS (vpn2, i1013): the width at which all buttons are shown, as Windows
+         * gives it: in one row, whatever the toolbar's present width. A wrapping toolbar
+         * (TBSTYLE_WRAPABLE) laid out narrow gave its first row's width, so a layout that sizes a
+         * toolbar from its ideal width (Walk: WireGuard's Add Tunnel toolbar) kept it narrow, its
+         * other buttons wrapped out of sight. */
+        LONG ideal = infoPtr->rcBound.right - infoPtr->rcBound.left;
+#ifndef SG_MUTANT_IDEAL_WRAPPED
+        if (!(infoPtr->dwStyle & CCS_VERT))
+        {
+            const TBUTTON_INFO *btnPtr = infoPtr->buttons;
+            LONG row = 0;
+            INT i;
+
+            for (i = 0; i < infoPtr->nNumButtons; i++, btnPtr++)
+                if (!(btnPtr->fsState & TBSTATE_HIDDEN)) row += btnPtr->rect.right - btnPtr->rect.left;
+            ideal = max(ideal, row);
+        }
+#endif
 	if (lpsize->cx == -1) {
-	    lpsize->cx = infoPtr->rcBound.right - infoPtr->rcBound.left;
+	    lpsize->cx = ideal;
 	}
 	else if(HIWORD(lpsize->cx)) {
 	    RECT rc;
@@ -5529,13 +5580,13 @@
 	    GetWindowRect(infoPtr->hwndSelf, &rc);
 	    MapWindowPoints(0, hwndParent, (LPPOINT)&rc, 2);
             TRACE("mapped to (%s)\n", wine_dbgstr_rect(&rc));
-	    lpsize->cx = max(rc.right-rc.left,
-			     infoPtr->rcBound.right - infoPtr->rcBound.left);
+	    lpsize->cx = max(rc.right-rc.left, ideal);
 	}
 	else {
-	    lpsize->cx = infoPtr->rcBound.right - infoPtr->rcBound.left;
+	    lpsize->cx = ideal;
 	}
 	break;
+    }
     case 1:
 	lpsize->cy = infoPtr->rcBound.bottom - infoPtr->rcBound.top;
 	break;
--- a/dlls/comctl32/tab.c
+++ b/dlls/comctl32/tab.c
@@ -3618,6 +3618,20 @@
       return TAB_MouseMove (infoPtr, wParam, lParam);
 
     case WM_PRINTCLIENT:
+      /* Stained Glass OS (vpn2, i1013): PRF_ERASEBKGND -- the control erases its client area
+       * itself first, with its class background (the parent's, themed), as Windows' does: a
+       * program that prints the tab control into a fresh bitmap (Walk's TabWidget: WireGuard)
+       * kept the strip beside the tabs black */
+#ifndef SG_MUTANT_TAB_PRINT_NO_ERASE
+      if (lParam & PRF_ERASEBKGND)
+      {
+        RECT rc;
+        GetClientRect (hwnd, &rc);
+        FillRect ((HDC)wParam, &rc, GetSysColorBrush (COLOR_BTNFACE));
+        if (GetWindowTheme (hwnd)) DrawThemeParentBackground (hwnd, (HDC)wParam, &rc);
+      }
+#endif
+      return TAB_Paint (infoPtr, (HDC)wParam);
     case WM_PAINT:
       return TAB_Paint (infoPtr, (HDC)wParam);
 
--- a/dlls/comctl32/listview.c
+++ b/dlls/comctl32/listview.c
@@ -12243,6 +12243,8 @@
  */
 static LRESULT LISTVIEW_Paint(LISTVIEW_INFO *infoPtr, HDC hdc)
 {
+    BOOL own_bkgnd;
+
     TRACE("(hdc=%p)\n", hdc);
 
     if (infoPtr->bNoItemMetrics && infoPtr->nItemCount)
@@ -12256,15 +12258,29 @@
 
     if (infoPtr->hwndHeader)  UpdateWindow(infoPtr->hwndHeader);
 
-    if (hdc) 
-        LISTVIEW_Refresh(infoPtr, hdc, NULL);
+    /* Stained Glass OS (vpn2, i1013): a double-buffered list view paints its background itself,
+     * whatever WM_ERASEBKGND did, as Windows' buffered paint does: Walk's TableView (WireGuard's
+     * tunnel list) answers WM_ERASEBKGND itself, and the list showed what was behind it (grey) */
+#ifndef SG_MUTANT_LV_DOUBLEBUFFER_NO_FILL
+    own_bkgnd = !!(infoPtr->dwLvExStyle & LVS_EX_DOUBLEBUFFER);
+#else
+    own_bkgnd = FALSE;
+#endif
+
+    if (hdc)
+    {
+        RECT rc;
+
+        GetClientRect(infoPtr->hwndSelf, &rc);
+        LISTVIEW_Refresh(infoPtr, hdc, own_bkgnd ? &rc : NULL);
+    }
     else
     {
 	PAINTSTRUCT ps;
 
 	hdc = BeginPaint(infoPtr->hwndSelf, &ps);
 	if (!hdc) return 1;
-	LISTVIEW_Refresh(infoPtr, hdc, ps.fErase ? &ps.rcPaint : NULL);
+	LISTVIEW_Refresh(infoPtr, hdc, (ps.fErase || own_bkgnd) ? &ps.rcPaint : NULL);
 	EndPaint(infoPtr->hwndSelf, &ps);
     }
 
