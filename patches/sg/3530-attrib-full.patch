+                lstrcatW(buffer, fd.cFileName);
+                found = TRUE;
+                /* a system or hidden file is only changed when the command names that attribute */
+                if ((old & FILE_ATTRIBUTE_SYSTEM) && !(mentioned & FILE_ATTRIBUTE_SYSTEM)) {
+                    ATTRIB_wprintf(ATTRIB_LoadMessage(STRING_NOT_RESETTING_SYSTEM), buffer);
+                    continue;
+                }
+                if ((old & FILE_ATTRIBUTE_HIDDEN) && !(mentioned & FILE_ATTRIBUTE_HIDDEN)) {
+                    ATTRIB_wprintf(ATTRIB_LoadMessage(STRING_NOT_RESETTING_HIDDEN), buffer);
+                    continue;
+                }
                 fd.dwFileAttributes &= ~attrib_clear;
                 fd.dwFileAttributes |= attrib_set;
+                if (fd.dwFileAttributes == old) continue;
+                /* only the attributes SetFileAttributes takes; a directory keeps its own bit */
+                fd.dwFileAttributes &= ~(FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_COMPRESSED | FILE_ATTRIBUTE_ENCRYPTED |
+                                         FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_SPARSE_FILE);
                 if (!fd.dwFileAttributes)
                     fd.dwFileAttributes |= FILE_ATTRIBUTE_NORMAL;
-                lstrcpyW(buffer, rootdir);
-                lstrcatW(buffer, fd.cFileName);
-                SetFileAttributesW(buffer, fd.dwFileAttributes);
-                found = TRUE;
+                /* the read-only bit last: the other attributes are stored on the file, which it would deny */
+                if ((fd.dwFileAttributes & FILE_ATTRIBUTE_READONLY) && (fd.dwFileAttributes & ~FILE_ATTRIBUTE_READONLY))
+                    SetFileAttributesW(buffer, fd.dwFileAttributes & ~FILE_ATTRIBUTE_READONLY);
+                if (!SetFileAttributesW(buffer, fd.dwFileAttributes)) {
+                    DWORD err = GetLastError();
+                    ATTRIB_wprintf(ATTRIB_LoadMessage(err == ERROR_FILE_NOT_FOUND || err == ERROR_PATH_NOT_FOUND
+                                                      ? STRING_FILENOTFOUND : STRING_ACCESS_DENIED), buffer);
+                }
             } else {
                 if (fd.dwFileAttributes & FILE_ATTRIBUTE_HIDDEN) {
                     flags[4] = 'H';
@@ -221,6 +254,9 @@
                 if (fd.dwFileAttributes & FILE_ATTRIBUTE_COMPRESSED) {
                     flags[7] = 'C';
                 }
+                if (fd.dwFileAttributes & FILE_ATTRIBUTE_NOT_CONTENT_INDEXED) {
+                    flags[8] = 'I';
+                }
                 lstrcpyW(buffer, rootdir);
                 lstrcatW(buffer, fd.cFileName);
                 ATTRIB_wprintf(L"%1     %2\n", flags, buffer);
@@ -238,74 +274,91 @@
     WCHAR name[MAX_PATH];
     WCHAR *namepart;
