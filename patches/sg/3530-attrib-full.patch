     while (i < argc) {
         WCHAR *param = argv[i++];
         WINE_TRACE("Processing arg: '%s'\n", wine_dbgstr_w(param));
         if ((param[0] == '+') || (param[0] == '-')) {
             DWORD attrib = 0;
