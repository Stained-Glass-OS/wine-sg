-    return E_NOTIMPL;
+    IUnknown *pattern;
+    HRESULT hr;
+
+    TRACE("%p, %d, %s, %p\n", iface, pattern_id, debugstr_guid(riid), out_pattern);
+
+    if (!out_pattern)
+        return E_POINTER;
+    *out_pattern = NULL;
+    if (FAILED(hr = create_uia_pattern(impl_from_IUIAutomationElement9(iface), pattern_id, &pattern)) || !pattern)
+        return hr;
+    hr = IUnknown_QueryInterface(pattern, riid, out_pattern);
