-static HRESULT WINAPI uia_element_GetCurrentPatternAs(IUIAutomationElement9 *iface, PATTERNID pattern_id,
-        REFIID riid, void **out_pattern)
+/* ---- the pattern objects of the COM client (generated from a table by gen/genpat.py, then kept as source) ---- */
+
+struct uia_com_pattern
+{
+    const void *lpVtbl;
+    LONG ref;
+    struct uia_element *element;    /* referenced through its interface */
+    HUIAPATTERNOBJECT obj;
+    PATTERNID pattern_id;
+    const GUID *iid;
+};
+
+static inline struct uia_com_pattern *impl_from_pattern(void *iface)
+{
+    return (struct uia_com_pattern *)iface;
+}
+
+static HRESULT WINAPI uia_com_pattern_QueryInterface(IUnknown *iface, REFIID riid, void **ppv)
+{
+    struct uia_com_pattern *p = impl_from_pattern(iface);
+
+    TRACE("%p, %s, %p\n", iface, debugstr_guid(riid), ppv);
+
+#ifdef SG_MUTANT_UIACPAT_ANY_IID
+    if (1)
+#else
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, p->iid))
+#endif
+    {
+        IUnknown_AddRef(iface);
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI uia_com_pattern_AddRef(IUnknown *iface)
+{
+    struct uia_com_pattern *p = impl_from_pattern(iface);
+
+    return InterlockedIncrement(&p->ref);
+}
+
+static ULONG WINAPI uia_com_pattern_Release(IUnknown *iface)
+{
+    struct uia_com_pattern *p = impl_from_pattern(iface);
+    ULONG ref = InterlockedDecrement(&p->ref);
+
+    if (!ref)
+    {
+        UiaPatternRelease(p->obj);
+        IUIAutomationElement9_Release(&p->element->IUIAutomationElement9_iface);
+        free(p);
+    }
+    return ref;
+}
+
+static HRESULT element_get_double(struct uia_element *element, PROPERTYID prop_id, double *ret_val)
+{
+    VARIANT v;
+    HRESULT hr;
+
+    if (!ret_val)
+        return E_POINTER;
+    *ret_val = 0.0;
+    if (FAILED(hr = element_get_value(element, prop_id, &v)))
+        return hr;
+    if (V_VT(&v) == VT_R8)
+        *ret_val = V_R8(&v);
+    VariantClear(&v);
+    return S_OK;
+}
+
+static HRESULT cached_get_double(struct uia_element *element, PROPERTYID prop_id, double *ret_val)
+{
+    struct uia_cache_property *prop;
+
+    if (!ret_val)
+        return E_POINTER;
+    if (!(prop = element_find_cached(element, prop_id)))
+        return E_INVALIDARG;
+    *ret_val = V_VT(&prop->prop_val) == VT_R8 ? V_R8(&prop->prop_val) : 0.0;
+    return S_OK;
+}
+static HRESULT WINAPI uia_com_invoke_Invoke(IUnknown *iface)
+{
+    struct uia_com_pattern *p = impl_from_pattern(iface);
+
+    TRACE("%p\n", iface);
+#ifdef SG_MUTANT_UIACPAT_ERROR_DROPPED
+    InvokePattern_Invoke(p->obj);
+    return S_OK;
+#else
+    return InvokePattern_Invoke(p->obj);
+#endif
+}
+static const struct
+{
+    void *QueryInterface, *AddRef, *Release;
+    void *methods[1];
+}
+uia_com_invoke_vtbl =
+{
+    uia_com_pattern_QueryInterface, uia_com_pattern_AddRef, uia_com_pattern_Release,
+    {
+        uia_com_invoke_Invoke
+    }
+};
