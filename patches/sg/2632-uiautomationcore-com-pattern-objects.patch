+static HRESULT create_uia_pattern(struct uia_element *element, PATTERNID pattern_id, IUnknown **out)
+{
+    struct uia_com_pattern *p;
+    HUIAPATTERNOBJECT obj;
+    unsigned int i;
+    HRESULT hr;
+
+    *out = NULL;
+    for (i = 0; i < ARRAY_SIZE(uia_com_patterns); i++)
+    {
+        if (uia_com_patterns[i].pattern_id == pattern_id)
+            break;
+    }
+    if (i == ARRAY_SIZE(uia_com_patterns))
+    {
+        FIXME("Pattern %d has no client object yet.\n", pattern_id);
+        return E_NOTIMPL;
+    }
+
+    if (FAILED(hr = UiaGetPatternProvider(element->node, pattern_id, &obj)))
+        return hr;
+    /* a pattern the element does not support is no object */
+    if (!obj)
+#ifdef SG_MUTANT_UIACPAT_UNSUPPORTED_OBJECT
+        return E_NOINTERFACE;
+#else
+        return S_OK;
+#endif
+
+    if (!(p = calloc(1, sizeof(*p))))
+    {
+        UiaPatternRelease(obj);
+        return E_OUTOFMEMORY;
+    }
+    p->lpVtbl = uia_com_patterns[i].vtbl;
+    p->ref = 1;
+    p->element = element;
+    IUIAutomationElement9_AddRef(&element->IUIAutomationElement9_iface);
+    p->obj = obj;
+    p->pattern_id = pattern_id;
+    p->iid = uia_com_patterns[i].iid;
+    *out = (IUnknown *)p;
+    return S_OK;
+}
