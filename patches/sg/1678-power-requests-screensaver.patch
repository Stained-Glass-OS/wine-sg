From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, kernel32, wow64: power requests and execution state keep the screen on through org.freedesktop.ScreenSaver

PowerCreateRequest, PowerSetRequest and PowerClearRequest were stubs (an
event and "yes"), and SetThreadExecutionState only remembered its state:
a video player, a presentation or a long download let the screen turn off
and the machine sleep under it.

- PowerCreateRequest and PowerSetRequest/PowerClearRequest go through
  NtPowerInformation's PowerRequestCreate (43) and PowerRequestAction
  (44), as on Windows; ntdll keeps the process's requests and the types
  set on each (display, system, away mode, execution). Clearing a type
  that is not set fails with ERROR_INVALID_PARAMETER, as does an unknown
  type or no reason context. wow64 converts both for 32-bit programs.
- While any request is set, or a continuous execution state asks for the
  display or the system (ES_CONTINUOUS with ES_DISPLAY_REQUIRED,
  ES_SYSTEM_REQUIRED or ES_AWAYMODE_REQUIRED), ntdll holds an Inhibit on
  the session bus's org.freedesktop.ScreenSaver service (libdbus, loaded
  when first needed), named after the program; it is given back
  (UnInhibit) when nothing asks any more, and goes with the process's bus
  connection when the process ends. A one-off ES_DISPLAY_REQUIRED or
  ES_SYSTEM_REQUIRED restarts the idle time (SimulateUserActivity, at most
  every 10 seconds). Outside a session (no session bus) nothing is done.
- In Stained Glass the service is sg-session's sg-screensaverd, which holds
  the compositor's idle notifications off, and with them the screen-off
  and sleep timers -- the same path Linux programs take.

PowerRequestExecutionRequired and ES_AWAYMODE_REQUIRED are added to
winnt.h. Wine's kernel32 power test: as before.

Gate: test/powerreq-gate.sh (64- and 32-bit, a private session bus,
test/powerreq-probe.c against test/powerreq-fake.c).
Mutant SG_MUTANT_NO_SCREENSAVER_INHIBIT (ntdll/unix/system.c).
---
--- a/dlls/kernel32/powermgnt.c
+++ b/dlls/kernel32/powermgnt.c
@@ -139,14 +139,58 @@ EXECUTION_STATE WINAPI SetThreadExecutionState(EXECUTION_STATE flags)
     return old;
 }
 
+/* Stained Glass OS 1678: power requests keep the display and the machine
+ * awake while set (ntdll holds the session's idle off through the
+ * org.freedesktop.ScreenSaver service); NtPowerInformation's
+ * PowerRequestCreate and PowerRequestAction carry them, as on Windows */
+struct power_request_action
+{
+    HANDLE request;
+    ULONG type;
+    BOOLEAN set;   /* 0 clear, 1 set */
+};
+
 /***********************************************************************
  *           PowerCreateRequest      (KERNEL32.@)
  */
 HANDLE WINAPI PowerCreateRequest(REASON_CONTEXT *context)
 {
-    FIXME("(%p): stub\n", context);
+    HANDLE handle = INVALID_HANDLE_VALUE;
+    NTSTATUS status;
+
+    TRACE("(%p)\n", context);
+
+    if (!context)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return INVALID_HANDLE_VALUE;
+    }
+    status = NtPowerInformation(43 /* PowerRequestCreate */, context, sizeof(*context), &handle, sizeof(handle));
+    if (status)
+    {
+        SetLastError(RtlNtStatusToDosError(status));
+        return INVALID_HANDLE_VALUE;
+    }
+    return handle;
+}
+
+static BOOL power_request_action(HANDLE request, POWER_REQUEST_TYPE type, BOOLEAN set)
+{
+    struct power_request_action action = { request, type, set };
+    NTSTATUS status;
 
-    return CreateEventW(NULL, TRUE, FALSE, NULL);
+    if ((ULONG)type > PowerRequestExecutionRequired)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    status = NtPowerInformation(44 /* PowerRequestAction */, &action, sizeof(action), NULL, 0);
+    if (status)
+    {
+        SetLastError(RtlNtStatusToDosError(status));
+        return FALSE;
+    }
+    return TRUE;
 }
 
 /***********************************************************************
@@ -154,9 +198,8 @@ HANDLE WINAPI PowerCreateRequest(REASON_CONTEXT *context)
  */
 BOOL WINAPI PowerSetRequest(HANDLE request, POWER_REQUEST_TYPE type)
 {
-    FIXME("(%p, %u): stub\n", request, type);
-
-    return TRUE;
+    TRACE("(%p, %u)\n", request, type);
+    return power_request_action(request, type, 1);
 }
 
 /***********************************************************************
@@ -164,7 +207,6 @@ BOOL WINAPI PowerSetRequest(HANDLE request, POWER_REQUEST_TYPE type)
  */
 BOOL WINAPI PowerClearRequest(HANDLE request, POWER_REQUEST_TYPE type)
 {
-    FIXME("(%p, %u): stub\n", request, type);
-
-    return TRUE;
+    TRACE("(%p, %u)\n", request, type);
+    return power_request_action(request, type, 0);
 }
--- a/dlls/ntdll/Makefile.in
+++ b/dlls/ntdll/Makefile.in
@@ -3,7 +3,7 @@ MODULE    = ntdll.dll
 UNIXLIB   = ntdll.so
 IMPORTLIB = ntdll
 IMPORTS   = $(MUSL_PE_LIBS) winecrt0
-UNIX_CFLAGS  = $(UNWIND_CFLAGS)
+UNIX_CFLAGS  = $(UNWIND_CFLAGS) $(DBUS_CFLAGS)
 UNIX_LIBS    = $(IOKIT_LIBS) $(COREFOUNDATION_LIBS) $(CORESERVICES_LIBS) $(RT_LIBS) $(PTHREAD_LIBS) $(UNWIND_LIBS) $(I386_LIBS) $(PROCSTAT_LIBS)
 
 EXTRADLLFLAGS = -nodefaultlibs
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -36,6 +36,12 @@
 #include <sys/time.h>
 #include <time.h>
 #include <dirent.h>
+#include <dlfcn.h>
+#include <sys/stat.h>
+#include <pthread.h>
+#ifdef SONAME_LIBDBUS_1
+# include <dbus/dbus.h>
+#endif
 #ifdef HAVE_SYS_PARAM_H
 # include <sys/param.h>
 #endif
@@ -4301,12 +4307,284 @@ static BOOL dir_exists( const char *path )
 /******************************************************************************
  *              NtPowerInformation  (NTDLL.@)
  */
+/* Stained Glass OS 1678: keeping the screen and the machine awake. Windows
+ * programs ask with power requests (PowerSetRequest) and
+ * SetThreadExecutionState; on Linux the session's
+ * org.freedesktop.ScreenSaver service keeps the idle at bay (Inhibit), as for
+ * any Linux program. The hold belongs to the process's own D-Bus
+ * connection, so it goes with the process. */
+
+#define POWER_REQUEST_TYPES 4  /* display, system, away mode, execution */
+
+struct power_request
+{
+    HANDLE handle;
+    LONG count[POWER_REQUEST_TYPES];
+};
+
+static pthread_mutex_t power_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct power_request *power_requests;
+static unsigned int power_request_count, power_request_size;
+static BOOL execution_hold;
+
+#ifdef SONAME_LIBDBUS_1
+
+#define DBUS_FUNCS \
+    DO_FUNC(dbus_bus_get_private); \
+    DO_FUNC(dbus_connection_close); \
+    DO_FUNC(dbus_connection_send_with_reply_and_block); \
+    DO_FUNC(dbus_connection_set_exit_on_disconnect); \
+    DO_FUNC(dbus_connection_unref); \
+    DO_FUNC(dbus_error_free); \
+    DO_FUNC(dbus_error_init); \
+    DO_FUNC(dbus_error_is_set); \
+    DO_FUNC(dbus_message_append_args); \
+    DO_FUNC(dbus_message_get_args); \
+    DO_FUNC(dbus_message_new_method_call); \
+    DO_FUNC(dbus_message_unref)
+
+#define DO_FUNC(f) static typeof(f) * p_##f
+DBUS_FUNCS;
+#undef DO_FUNC
+
+static DBusConnection *screensaver_connection;
+static dbus_uint32_t screensaver_cookie;
+
+static BOOL load_dbus(void)
+{
+    static int loaded = -1;
+    void *handle;
+
+    if (loaded != -1) return loaded;
+    loaded = 0;
+    if (!(handle = dlopen( SONAME_LIBDBUS_1, RTLD_NOW ))) return FALSE;
+#define DO_FUNC(f) if (!(p_##f = dlsym( handle, #f ))) return FALSE
+    DBUS_FUNCS;
+#undef DO_FUNC
+    loaded = 1;
+    return TRUE;
+}
+
+static DBusMessage *screensaver_call( DBusConnection *connection, const char *method, int first_type, ... )
+{
+    DBusMessage *call, *reply;
+    DBusError error;
+    va_list args;
+
+    if (!(call = p_dbus_message_new_method_call( "org.freedesktop.ScreenSaver", "/org/freedesktop/ScreenSaver",
+                                                 "org.freedesktop.ScreenSaver", method )))
+        return NULL;
+    va_start( args, first_type );
+    if (first_type != DBUS_TYPE_INVALID)
+    {
+        /* the arguments: type, pointer pairs, ending with DBUS_TYPE_INVALID */
+        int type = first_type;
+        void *value = va_arg( args, void * );
+        p_dbus_message_append_args( call, type, value, DBUS_TYPE_INVALID );
+        while ((type = va_arg( args, int )) != DBUS_TYPE_INVALID)
+        {
+            value = va_arg( args, void * );
+            p_dbus_message_append_args( call, type, value, DBUS_TYPE_INVALID );
+        }
+    }
+    va_end( args );
+    p_dbus_error_init( &error );
+    reply = p_dbus_connection_send_with_reply_and_block( connection, call, 2000, &error );
+    if (p_dbus_error_is_set( &error ))
+        WARN( "%s: %s\n", method, error.message ? error.message : "failed" );
+    p_dbus_error_free( &error );
+    p_dbus_message_unref( call );
+    return reply;
+}
+
+static DBusConnection *screensaver_connect(void)
+{
+    DBusConnection *connection;
+    DBusError error;
+
+    if (!load_dbus()) return NULL;
+    /* only a session's bus: libdbus would otherwise start one of its own
+     * (X11 autolaunch) for a process outside any session */
+    {
+        const char *address = getenv( "DBUS_SESSION_BUS_ADDRESS" ), *runtime = getenv( "XDG_RUNTIME_DIR" );
+        char path[1024];
+        struct stat st;
+
+        if (!address || !address[0])
+        {
+            if (!runtime || snprintf( path, sizeof(path), "%s/bus", runtime ) >= (int)sizeof(path) ||
+                stat( path, &st ) || !S_ISSOCK( st.st_mode ))
+                return NULL;
+        }
+    }
+    p_dbus_error_init( &error );
+    connection = p_dbus_bus_get_private( DBUS_BUS_SESSION, &error );
+    p_dbus_error_free( &error );
+    if (connection) p_dbus_connection_set_exit_on_disconnect( connection, FALSE );
+    return connection;
+}
+
+static void screensaver_disconnect( DBusConnection *connection )
+{
+    p_dbus_connection_close( connection );
+    p_dbus_connection_unref( connection );
+}
+
+/* hold the idle off, or let it go; with power_mutex held */
+static void screensaver_hold( BOOL hold )
+{
+    DBusMessage *reply;
+
+#ifdef SG_MUTANT_NO_SCREENSAVER_INHIBIT
+    return;
+#endif
+    if (hold && !screensaver_connection)
+    {
+        const char *app = main_argv && main_argv[0] ? main_argv[0] : "wine";
+        const char *reason = "A program asked to keep the display on";
+        const char *slash = strrchr( app, '/' );
+        dbus_uint32_t cookie = 0;
+
+        if (slash) app = slash + 1;
+        if (!(screensaver_connection = screensaver_connect())) return;
+        if (!(reply = screensaver_call( screensaver_connection, "Inhibit", DBUS_TYPE_STRING, &app,
+                                        DBUS_TYPE_STRING, &reason, DBUS_TYPE_INVALID )) ||
+            !p_dbus_message_get_args( reply, NULL, DBUS_TYPE_UINT32, &cookie, DBUS_TYPE_INVALID ))
+        {
+            if (reply) p_dbus_message_unref( reply );
+            screensaver_disconnect( screensaver_connection );
+            screensaver_connection = NULL;
+            return;
+        }
+        p_dbus_message_unref( reply );
+        screensaver_cookie = cookie;
+        TRACE( "inhibited, cookie %u\n", cookie );
+    }
+    else if (!hold && screensaver_connection)
+    {
+        if ((reply = screensaver_call( screensaver_connection, "UnInhibit", DBUS_TYPE_UINT32,
+                                       &screensaver_cookie, DBUS_TYPE_INVALID )))
+            p_dbus_message_unref( reply );
+        screensaver_disconnect( screensaver_connection );
+        screensaver_connection = NULL;
+        TRACE( "released\n" );
+    }
+}
+
+/* the user's idle time starts again (a one-off ES_DISPLAY_REQUIRED) */
+static void screensaver_activity(void)
+{
+    static ULONG last;
+    DBusConnection *connection;
+    DBusMessage *reply;
+    ULONG now = NtGetTickCount();
+
+    if (last && now - last < 10000) return;
+    last = now;
+    if (!(connection = screensaver_connect())) return;
+    if ((reply = screensaver_call( connection, "SimulateUserActivity", DBUS_TYPE_INVALID )))
+        p_dbus_message_unref( reply );
+    screensaver_disconnect( connection );
+}
+
+#else
+
+static void screensaver_hold( BOOL hold ) { }
+static void screensaver_activity(void) { }
+
+#endif
+
+/* with power_mutex held: hold the idle off while any request asks it */
+static BOOL update_power_hold(void)
+{
+    BOOL hold = execution_hold;
+    unsigned int i, j;
+
+    for (i = 0; i < power_request_count && !hold; i++)
+        for (j = 0; j < POWER_REQUEST_TYPES; j++)
+            if (power_requests[i].count[j] > 0) hold = TRUE;
+    screensaver_hold( hold );
+    return hold;
+}
+
+static NTSTATUS power_request_create( HANDLE *ret )
+{
+    OBJECT_ATTRIBUTES attr;
+    NTSTATUS status;
+    HANDLE handle;
+
+    InitializeObjectAttributes( &attr, NULL, 0, NULL, NULL );
+    if ((status = NtCreateEvent( &handle, EVENT_ALL_ACCESS, &attr, NotificationEvent, FALSE ))) return status;
+    pthread_mutex_lock( &power_mutex );
+    if (power_request_count == power_request_size)
+    {
+        unsigned int size = power_request_size ? power_request_size * 2 : 8;
+        struct power_request *new = realloc( power_requests, size * sizeof(*new) );
+        if (!new)
+        {
+            pthread_mutex_unlock( &power_mutex );
+            NtClose( handle );
+            return STATUS_NO_MEMORY;
+        }
+        power_requests = new;
+        power_request_size = size;
+    }
+    memset( &power_requests[power_request_count], 0, sizeof(power_requests[0]) );
+    power_requests[power_request_count++].handle = handle;
+    pthread_mutex_unlock( &power_mutex );
+    *ret = handle;
+    return STATUS_SUCCESS;
+}
+
+/* set, clear, or forget (type -1) a request */
+static NTSTATUS power_request_action( HANDLE handle, int type, BOOL set )
+{
+    NTSTATUS status = STATUS_INVALID_HANDLE;
+    unsigned int i;
+
+    if (type >= POWER_REQUEST_TYPES) return STATUS_INVALID_PARAMETER;
+    pthread_mutex_lock( &power_mutex );
+    for (i = 0; i < power_request_count; i++)
+    {
+        if (power_requests[i].handle != handle) continue;
+        status = STATUS_SUCCESS;
+        if (type < 0)
+            power_requests[i] = power_requests[--power_request_count];
+        else if (set)
+            power_requests[i].count[type]++;
+        else if (power_requests[i].count[type] > 0)
+            power_requests[i].count[type]--;
+        else
+            status = STATUS_INVALID_PARAMETER;  /* not set */
+        break;
+    }
+    update_power_hold();
+    pthread_mutex_unlock( &power_mutex );
+    return status;
+}
+
 NTSTATUS WINAPI NtPowerInformation( POWER_INFORMATION_LEVEL level, void *input, ULONG in_size,
                                     void *output, ULONG out_size )
 {
     TRACE( "(%d,%p,%d,%p,%d)\n", level, input, (int)in_size, output, (int)out_size );
-    switch (level)
+    switch ((ULONG)level)
+    {
+    case 43: /* PowerRequestCreate: a REASON_CONTEXT in, the request's handle out */
+        if (!output || out_size < sizeof(HANDLE)) return STATUS_BUFFER_TOO_SMALL;
+        /* REASON_CONTEXT: its Version first */
+        if (!input || in_size < 2 * sizeof(ULONG)) return STATUS_INVALID_PARAMETER;
+        if (*(const ULONG *)input != POWER_REQUEST_CONTEXT_VERSION) return STATUS_INVALID_PARAMETER;
+        return power_request_create( (HANDLE *)output );
+
+    case 44: /* PowerRequestAction: set or clear one of a request's types */
     {
+        const struct { HANDLE request; ULONG type; BOOLEAN set; } *action = input;
+
+        if (!input || in_size < sizeof(*action)) return STATUS_INVALID_PARAMETER;
+        return power_request_action( action->request, action->set == 2 ? -1 : (int)action->type,
+                                     action->set == 1 );
+    }
+
     case SystemPowerCapabilities:
     {
         PSYSTEM_POWER_CAPABILITIES PowerCaps = output;
@@ -4622,9 +4900,21 @@ NTSTATUS WINAPI NtInitiatePowerAction( POWER_ACTION action, SYSTEM_POWER_STATE s
 NTSTATUS WINAPI NtSetThreadExecutionState( EXECUTION_STATE new_state, EXECUTION_STATE *old_state )
 {
     static EXECUTION_STATE current = ES_SYSTEM_REQUIRED | ES_DISPLAY_REQUIRED | ES_USER_PRESENT;
+    BOOL held;
+
+    TRACE( "(0x%x, %p)\n", (int)new_state, old_state );
 
-    WARN( "(0x%x, %p): stub, harmless.\n", (int)new_state, old_state );
+    pthread_mutex_lock( &power_mutex );
     *old_state = current;
     if (!(current & ES_CONTINUOUS) || (new_state & ES_CONTINUOUS)) current = new_state;
+    /* Stained Glass OS 1678: a continuous ES_DISPLAY_REQUIRED or
+     * ES_SYSTEM_REQUIRED keeps the screen and the machine awake until it is
+     * cleared; without ES_CONTINUOUS either only resets the idle timers */
+    execution_hold = (current & ES_CONTINUOUS) && (current & (ES_DISPLAY_REQUIRED | ES_SYSTEM_REQUIRED |
+                                                           ES_AWAYMODE_REQUIRED));
+    held = update_power_hold();
+    pthread_mutex_unlock( &power_mutex );
+    if (!held && !(new_state & ES_CONTINUOUS) && (new_state & (ES_DISPLAY_REQUIRED | ES_SYSTEM_REQUIRED)))
+        screensaver_activity();
     return STATUS_SUCCESS;
 }
--- a/dlls/wow64/system.c
+++ b/dlls/wow64/system.c
@@ -237,7 +237,7 @@ NTSTATUS WINAPI wow64_NtPowerInformation( UINT *args )
     void *out_buf = get_ptr( &args );
     ULONG out_len = get_ulong( &args );
 
-    switch (level)
+    switch ((ULONG)level)
     {
     case SystemPowerCapabilities:   /* SYSTEM_POWER_CAPABILITIES */
     case SystemBatteryState:   /* SYSTEM_BATTERY_STATE */
@@ -248,6 +248,29 @@ NTSTATUS WINAPI wow64_NtPowerInformation( UINT *args )
     case LastSleepTime:   /* ULONGLONG */
         return NtPowerInformation( level, in_buf, in_len, out_buf, out_len );
 
+    case 43:  /* PowerRequestCreate: REASON_CONTEXT (its Version is read) in, a handle out */
+    {
+        HANDLE handle = 0;
+        NTSTATUS status;
+
+        if (!out_buf || out_len < sizeof(ULONG)) return STATUS_BUFFER_TOO_SMALL;
+        status = NtPowerInformation( level, in_buf, in_len, &handle, sizeof(handle) );
+        if (!status) *(ULONG *)out_buf = HandleToULong( handle );
+        return status;
+    }
+
+    case 44:  /* PowerRequestAction: kernel32's request, type and action */
+    {
+        const struct { ULONG request; ULONG type; BOOLEAN set; } *action32 = in_buf;
+        struct { HANDLE request; ULONG type; BOOLEAN set; } action;
+
+        if (!in_buf || in_len < sizeof(*action32)) return STATUS_INVALID_PARAMETER;
+        action.request = LongToHandle( action32->request );
+        action.type = action32->type;
+        action.set = action32->set;
+        return NtPowerInformation( level, &action, sizeof(action), out_buf, out_len );
+    }
+
     default:
         FIXME( "unsupported level %u\n", level );
         return STATUS_NOT_IMPLEMENTED;
--- a/include/winnt.h
+++ b/include/winnt.h
@@ -1119,6 +1119,7 @@ typedef enum _HEAP_INFORMATION_CLASS {
 #define ES_SYSTEM_REQUIRED    0x00000001
 #define ES_DISPLAY_REQUIRED   0x00000002
 #define ES_USER_PRESENT       0x00000004
+#define ES_AWAYMODE_REQUIRED 0x00000040
 #define ES_CONTINUOUS         0x80000000
 
 #include <excpt.h>
@@ -5798,7 +5799,8 @@ typedef enum _POWER_REQUEST_TYPE
 {
     PowerRequestDisplayRequired,
     PowerRequestSystemRequired,
-    PowerRequestAwayModeRequired
+    PowerRequestAwayModeRequired,
+    PowerRequestExecutionRequired
 } POWER_REQUEST_TYPE, *PPOWER_REQUEST_TYPE;
 
 #define POWER_REQUEST_CONTEXT_VERSION           0
