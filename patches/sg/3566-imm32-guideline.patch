From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] imm32: ImmGetGuideLine, ImmUnlockIMCC of a freed handle (3566)

imm32: ImmGetGuideLineA/W, ImmUnlockIMCC of a freed handle

The guide line of the input context is read from its GUIDELINE block: the level, the index, the string
(converted for the ANSI form, counted in bytes) and the private data, truncated to the caller's buffer.
ImmUnlockIMCC uses LocalUnlock: GlobalUnlock answers TRUE for a handle that was freed (as Windows'
GlobalUnlock does), which made the conformance test's "unlock a destroyed IMCC returns FALSE" fail on
this tree (it passes on stock Wine).

Rebased at integration (integ-2026-10) onto 3224 (fast-a): both fixed ImmUnlockIMCC of a freed handle; 3224's GlobalFlags check (with mutant SG_MUTANT_IMM_UNLOCK) kept, 3566's LocalUnlock variant dropped; ImmGetGuideLine part unchanged.
---
diff --git a/dlls/imm32/imm.c b/dlls/imm32/imm.c
--- a/dlls/imm32/imm.c
+++ b/dlls/imm32/imm.c
@@ -1934,17 +1934,80 @@ UINT WINAPI ImmGetDescriptionW( HKL hkl, WCHAR *buffer, UINT length )
     return wcslen( buffer );
 }
 
+/* the guide line of the input context: its level, its index, its string or
+ * its private data; a wide string is counted in bytes, as the caller's buffer is */
+static DWORD get_guide_line( HIMC himc, DWORD index, void *buf, DWORD buf_len, BOOL ansi )
+{
+    INPUTCONTEXT *ctx;
+    GUIDELINE *line;
+    DWORD ret = 0;
+
+    if (!(ctx = ImmLockIMC( himc ))) return 0;
+    if ((line = ImmLockIMCC( ctx->hGuideLine )))
+    {
+        switch (index)
+        {
+        case GGL_LEVEL:
+            ret = line->dwLevel;
+            break;
+        case GGL_INDEX:
+            ret = line->dwIndex;
+            break;
+        case GGL_STRING:
+        {
+            const WCHAR *str = (const WCHAR *)((BYTE *)line + line->dwStrOffset);
+
+            if (!line->dwStrLen) break;
+            if (ansi)
+            {
+                ret = WideCharToMultiByte( CP_ACP, 0, str, line->dwStrLen, NULL, 0, NULL, NULL );
+                if (buf && buf_len)
+                {
+                    char *tmp = malloc( ret );
+                    if (!tmp) { ret = 0; break; }
+                    WideCharToMultiByte( CP_ACP, 0, str, line->dwStrLen, tmp, ret, NULL, NULL );
+                    if (ret > buf_len) ret = buf_len;
+                    memcpy( buf, tmp, ret );
+                    free( tmp );
+                }
+            }
+            else
+            {
+                ret = line->dwStrLen * sizeof(WCHAR);
+                if (buf && buf_len)
+                {
+                    if (ret > buf_len) ret = buf_len;
+                    memcpy( buf, str, ret );
+                }
+            }
+            break;
+        }
+        case GGL_PRIVATE:
+            ret = line->dwPrivateSize;
+            if (ret && buf && buf_len)
+            {
+                if (ret > buf_len) ret = buf_len;
+                memcpy( buf, (BYTE *)line + line->dwPrivateOffset, ret );
+            }
+            break;
+        default:
+            WARN( "unknown index %#lx\n", index );
+            break;
+        }
+        ImmUnlockIMCC( ctx->hGuideLine );
+    }
+    ImmUnlockIMC( himc );
+    return ret;
+}
+
 /***********************************************************************
  *		ImmGetGuideLineA (IMM32.@)
  */
 DWORD WINAPI ImmGetGuideLineA(
   HIMC hIMC, DWORD dwIndex, LPSTR lpBuf, DWORD dwBufLen)
 {
-  FIXME("(%p, %ld, %s, %ld): stub\n",
-    hIMC, dwIndex, debugstr_a(lpBuf), dwBufLen
-  );
-  SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-  return 0;
+    TRACE( "(%p, %ld, %p, %ld)\n", hIMC, dwIndex, lpBuf, dwBufLen );
+    return get_guide_line( hIMC, dwIndex, lpBuf, dwBufLen, TRUE );
 }
 
 /***********************************************************************
@@ -1952,11 +2015,8 @@ DWORD WINAPI ImmGetGuideLineA(
  */
 DWORD WINAPI ImmGetGuideLineW(HIMC hIMC, DWORD dwIndex, LPWSTR lpBuf, DWORD dwBufLen)
 {
-  FIXME("(%p, %ld, %s, %ld): stub\n",
-    hIMC, dwIndex, debugstr_w(lpBuf), dwBufLen
-  );
-  SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-  return 0;
+    TRACE( "(%p, %ld, %p, %ld)\n", hIMC, dwIndex, lpBuf, dwBufLen );
+    return get_guide_line( hIMC, dwIndex, lpBuf, dwBufLen, FALSE );
 }
 
 /***********************************************************************
