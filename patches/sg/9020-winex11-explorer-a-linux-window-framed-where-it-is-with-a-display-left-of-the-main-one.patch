From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, explorer: a Linux program's window is framed where it is, with a display left of the main one

The taskbar frames a Linux program's window (sg_embed) where the compositor
put it, and asked winex11 for that place in the X screen's coordinates. Those
count from the leftmost display; Wine's, as Windows', from the main display,
with a display on its left at negative coordinates. With a display moved left
of the main one the frame went that display's width further right: FileZilla
at the main display's right edge, its "Remember passwords?" dialog off the
screen (GitHub #19), the Linux terminal half off the screen and lost when
moved (GitHub #17). The place now goes through Wine's desktop window, which
covers every display from the virtual screen's corner (and may itself be away
from the X screen's corner after a display was unplugged); the frame is kept
whole on its display's work area instead of right of 0,0. A frame maximized
fills its own display's work area: the default maximized size in the shell's
own process is its desktop window, every display, and the frame spanned them.
---
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -276,6 +276,33 @@
 }
 
 /* a window the session may put in a frame: a top-level, shown, not a menu */
+/* A place in the X screen's coordinates (the program's, the compositor's) in Wine's: through
+ * Wine's desktop window, which covers every display from the virtual screen's corner -- the
+ * main display is at 0,0 for Wine, as on Windows, and a display left of it at negative
+ * coordinates, while X counts from the leftmost (GitHub #17, #19: a Linux program's window
+ * the compositor centred on the main display was framed that far to the right again, off
+ * the screen). The desktop window may itself be away from the X screen's corner (the
+ * display left of the main one unplugged). */
+static POINT root_to_wine( Display *display, int x, int y )
+{
+    Window child;
+    int dx = x, dy = y;
+
+#ifndef SG_MUTANT_EMBED_ROOT_COORDS
+    if (root_window != DefaultRootWindow( display ))
+    {
+        X11DRV_expect_error( display, ignore_error, NULL );
+        if (!XTranslateCoordinates( display, DefaultRootWindow( display ), root_window, x, y, &dx, &dy, &child ))
+            dx = x, dy = y;
+        if (sync_check_error( display )) dx = x, dy = y;
+    }
+    return root_to_virtual_screen( dx, dy );
+#else
+    POINT pt = { x, y };
+    return pt;
+#endif
+}
+
 static BOOL embeddable( Display *display, Window child, XWindowAttributes *attr )
 {
     Window root, parent, *children = NULL;
@@ -415,6 +442,11 @@
             attr.height -= ext[2] + ext[3];
         }
     }
+    {
+        POINT pt = root_to_wine( display, x, y );
+        x = pt.x;
+        y = pt.y;
+    }
     TRACE( "%p: %lx at %d,%d %dx%d\n", hwnd, child, x, y, attr.width, attr.height );
     return (LRESULT)((ULONGLONG)(USHORT)x | (ULONGLONG)(USHORT)y << 16 |
                      (ULONGLONG)(USHORT)min( attr.width, 0x7fff ) << 32 |
@@ -1300,7 +1332,7 @@
 
     if (moved)
     {
-        pt = root_to_virtual_screen( rx, ry );
+        pt = root_to_wine( display, rx, ry );
         rx = pt.x;
         ry = pt.y;
     }
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -3182,6 +3182,30 @@
     }
 #endif
 
+    /* maximized: its own display's work area, as any window. The default is the desktop
+     * window's size, and in the shell's own process that is every display (the virtual
+     * screen), not the main one: a framed Linux window maximized across all of them with a
+     * second display (GitHub #17) */
+#ifndef SG_MUTANT_FRAME_MAX_ALL_DISPLAYS
+    if (msg == WM_GETMINMAXINFO && !GetPropW( hwnd, L"SgOwnFrame" ))
+    {
+        MINMAXINFO *mmi = (MINMAXINFO *)lp;
+        MONITORINFO mi = { sizeof(mi) };
+        LONG style = GetWindowLongW( hwnd, GWL_STYLE );
+        RECT b = { 0, 0, 0, 0 };
+        DefWindowProcW( hwnd, msg, wp, lp );
+        if (GetMonitorInfoW( MonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST ), &mi ))
+        {
+            /* the border off the screen, as win32u's default (WS_CAPTION less WS_BORDER) */
+            AdjustWindowRectEx( &b, (style & WS_CAPTION) == WS_CAPTION ? style & ~WS_BORDER : style, FALSE,
+                                GetWindowLongW( hwnd, GWL_EXSTYLE ) );
+            mmi->ptMaxSize.x = mi.rcWork.right - mi.rcWork.left + b.right - b.left;
+            mmi->ptMaxSize.y = mi.rcWork.bottom - mi.rcWork.top + b.bottom - b.top;
+        }
+        return 0;
+    }
+#endif
+
     /* a frame for a program that draws its own title bar and edges (SG
      * Office, Firefox): no title bar or border of ours, the program's window
      * fills it; it is sizable (WS_THICKFRAME) only so it maximizes to the
@@ -3553,8 +3577,25 @@
         SetWindowPos( frame, 0, 0, 0, 0, 0, SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE );
     }
     else AdjustWindowRectEx( &rc, WS_OVERLAPPEDWINDOW, FALSE, WS_EX_APPWINDOW );
+#ifndef SG_MUTANT_EMBED_FRAME_ORIGIN_CLAMP
+    {
+        /* the title bar on the screen: whole on its display's work area (the display under
+         * most of it, else the nearest). Moved right of 0,0 it was, as if the main display
+         * were the leftmost: a display left of it is at negative coordinates, as on Windows
+         * (GitHub #17) */
+        MONITORINFO mi = { sizeof(mi) };
+        if (GetMonitorInfoW( MonitorFromRect( &rc, MONITOR_DEFAULTTONEAREST ), &mi ))
+        {
+            if (rc.right > mi.rcWork.right) OffsetRect( &rc, mi.rcWork.right - rc.right, 0 );
+            if (rc.bottom > mi.rcWork.bottom) OffsetRect( &rc, 0, mi.rcWork.bottom - rc.bottom );
+            if (rc.left < mi.rcWork.left) OffsetRect( &rc, mi.rcWork.left - rc.left, 0 );
+            if (rc.top < mi.rcWork.top) OffsetRect( &rc, 0, mi.rcWork.top - rc.top );
+        }
+    }
+#else
     if (rc.top < 0) OffsetRect( &rc, 0, -rc.top );   /* the title bar on the screen */
     if (rc.left < 0) OffsetRect( &rc, -rc.left, 0 );
+#endif
     if (icon)
     {
         SendMessageW( frame, WM_SETICON, ICON_BIG, (LPARAM)icon );
