+/* signal an event when the store changes: its key, or a key under it (the
+ * certificates, CRLs and CTLs are kept in subkeys) */
+static BOOL CRYPT_RegNotifyChange(WINE_REGSTOREINFO *store, HANDLE event)
+{
+    LSTATUS rc;
+    HKEY key;
+
+#ifdef SG_MUTANT_NO_STORE_NOTIFY
+    return TRUE;
+#endif
+    HKEY *keys;
+
+    /* a key of its own, open for notification, kept while the store is
+     * open: closing it would end the registration */
+    if ((rc = RegOpenKeyExW(store->key, NULL, 0, KEY_NOTIFY, &key)))
+    {
+        SetLastError(rc);
+        return FALSE;
+    }
+    rc = RegNotifyChangeKeyValue(key, TRUE, REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET,
+     event, TRUE);
+    if (rc)
+    {
+        RegCloseKey(key);
+        SetLastError(rc);
+        return FALSE;
+    }
+    EnterCriticalSection(&store->cs);
+    if (!(keys = CryptMemRealloc(store->notify_keys, (store->notify_count + 1) * sizeof(*keys))))
+    {
+        LeaveCriticalSection(&store->cs);
+        RegCloseKey(key);
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    keys[store->notify_count++] = key;
+    store->notify_keys = keys;
+    LeaveCriticalSection(&store->cs);
+    return TRUE;
+}
