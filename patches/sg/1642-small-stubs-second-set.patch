+/* the workgroup this computer is in: Samba's, when it is set up (Windows
+ * file sharing with this machine goes through it), else WORKGROUP, the
+ * default on Windows as in Samba */
+static void get_workgroup( WCHAR *name, DWORD size )
+{
+    HANDLE file;
+    char *data, *line, *next;
+    DWORD got = 0, len;
+    LARGE_INTEGER file_size;
+
+    lstrcpynW( name, L"WORKGROUP", size );
+#ifdef SG_MUTANT_FIXED_WORKGROUP
+    return;
+#endif
+    {
+        /* SG_SMB_CONF names another (a Unix path): the gate's stand-in */
+        WCHAR path[MAX_PATH + 8] = L"\\\\?\\unix\\etc\\samba\\smb.conf", other[MAX_PATH], *q;
+        if (GetEnvironmentVariableW( L"SG_SMB_CONF", other, ARRAY_SIZE(other) ) && other[0] == '/' &&
+            lstrlenW( other ) < MAX_PATH)
+        {
+            swprintf( path, ARRAY_SIZE(path), L"\\\\?\\unix%s", other );
+            for (q = path + 8; *q; q++) if (*q == '/') *q = '\\';
+        }
+        file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL );
+    }
+    if (file == INVALID_HANDLE_VALUE) return;
+    if (!GetFileSizeEx( file, &file_size ) || file_size.QuadPart > 1024 * 1024 ||
+        !(data = malloc( file_size.QuadPart + 1 )))
+    {
+        CloseHandle( file );
+        return;
+    }
+    if (!ReadFile( file, data, file_size.LowPart, &got, NULL )) got = 0;
+    CloseHandle( file );
+    data[got] = 0;
+
+    /* "workgroup = NAME" in the [global] section */
+    {
+        BOOL global = FALSE;
+        for (line = data; line && *line; line = next)
+        {
+            char *p, *end;
+
+            if ((next = strchr( line, '\n' ))) *next++ = 0;
+            while (*line == ' ' || *line == '\t') line++;
+            if (*line == '[') { global = !_strnicmp( line, "[global]", 8 ); continue; }
+            if (!global || *line == '#' || *line == ';') continue;
+            if (_strnicmp( line, "workgroup", 9 )) continue;
+            p = line + 9;
+            while (*p == ' ' || *p == '\t') p++;
+            if (*p++ != '=') continue;
+            while (*p == ' ' || *p == '\t') p++;
+            end = p + strlen( p );
+            while (end > p && (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r')) end--;
+            *end = 0;
+            if (!*p) continue;
+            len = MultiByteToWideChar( CP_UTF8, 0, p, -1, name, size );
+            if (!len) lstrcpynW( name, L"WORKGROUP", size );
+            break;
+        }
+    }
+    free( data );
+}
