From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] user32: DDEML conversation lists

DdeConnectList connects to every server that supports a service/topic pair
(through a client window per server) and returns a real list handle;
DdeQueryNextServer walks it and DdeDisconnectList ends its conversations.
CORE: integrator must review (patches/notes/5207.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/user32/dde_client.c b/dlls/user32/dde_client.c
--- a/dlls/user32/dde_client.c
+++ b/dlls/user32/dde_client.c
@@ -33,6 +33,138 @@
 const char WDML_szClientConvClassA[] = "WineDdeClientA";
 const WCHAR WDML_szClientConvClassW[] = L"WineDdeClientW";
 
+/* creates the window a client conversation talks through */
+static HWND WDML_CreateClientWindow(WDML_INSTANCE* pInstance)
+{
+    HWND hwndClient;
+
+    if (pInstance->unicode)
+    {
+        WNDCLASSEXW wndclass;
+
+        wndclass.cbSize        = sizeof(wndclass);
+        wndclass.style         = 0;
+        wndclass.lpfnWndProc   = WDML_ClientProc;
+        wndclass.cbClsExtra    = 0;
+        wndclass.cbWndExtra    = 2 * sizeof(ULONG_PTR);
+        wndclass.hInstance     = 0;
+        wndclass.hIcon         = 0;
+        wndclass.hCursor       = 0;
+        wndclass.hbrBackground = 0;
+        wndclass.lpszMenuName  = NULL;
+        wndclass.lpszClassName = WDML_szClientConvClassW;
+        wndclass.hIconSm       = 0;
+
+        RegisterClassExW(&wndclass);
+
+        hwndClient = CreateWindowW(WDML_szClientConvClassW, NULL, WS_POPUP, 0, 0, 0, 0, 0, 0, 0, 0);
+    }
+    else
+    {
+        WNDCLASSEXA wndclass;
+
+        wndclass.cbSize        = sizeof(wndclass);
+        wndclass.style         = 0;
+        wndclass.lpfnWndProc   = WDML_ClientProc;
+        wndclass.cbClsExtra    = 0;
+        wndclass.cbWndExtra    = 2 * sizeof(ULONG_PTR);
+        wndclass.hInstance     = 0;
+        wndclass.hIcon         = 0;
+        wndclass.hCursor       = 0;
+        wndclass.hbrBackground = 0;
+        wndclass.lpszMenuName  = NULL;
+        wndclass.lpszClassName = WDML_szClientConvClassA;
+        wndclass.hIconSm       = 0;
+
+        RegisterClassExA(&wndclass);
+
+        hwndClient = CreateWindowA(WDML_szClientConvClassA, NULL, WS_POPUP, 0, 0, 0, 0, 0, 0, 0, 0);
+    }
+
+    if (hwndClient) SetWindowLongPtrW(hwndClient, GWL_WDML_INSTANCE, (ULONG_PTR)pInstance);
+    return hwndClient;
+}
+
+/* the conversation context a connected client conversation starts with */
+static void WDML_SetClientContext(WDML_INSTANCE* pInstance, WDML_CONV* pConv, const CONVCONTEXT* pCC)
+{
+    if (pCC != NULL)
+    {
+	pConv->convContext = *pCC;
+    }
+    else
+    {
+	memset(&pConv->convContext, 0, sizeof(pConv->convContext));
+	pConv->convContext.cb = sizeof(pConv->convContext);
+	pConv->convContext.iCodePage = (pInstance->unicode) ? CP_WINUNICODE : CP_WINANSI;
+    }
+}
+
+static WDML_CONVLIST* WDML_ConvLists;
+
+static WDML_CONVLIST* WDML_FindConvList(HCONVLIST hConvList)
+{
+    WDML_CONVLIST* list;
+
+    for (list = WDML_ConvLists; list; list = list->next)
+	if (list == (WDML_CONVLIST*)hConvList && list->magic == WDML_CONVLIST_MAGIC) return list;
+    return NULL;
+}
+
+/* a conversation of the list that is still there */
+static BOOL WDML_ConvListEntryAlive(HCONV hConv)
+{
+    WDML_CONV* pConv = WDML_GetConv(hConv, FALSE);
+
+    return pConv != NULL && (pConv->wStatus & ST_CLIENT) && (pConv->wStatus & ST_CONNECTED);
+}
+
+struct WDML_ConnectListData
+{
+    HWND*	windows;
+    UINT	count, size;
+};
+
+static BOOL CALLBACK WDML_ConnectListEnumProc(HWND hwnd, LPARAM lParam)
+{
+    struct WDML_ConnectListData* data = (struct WDML_ConnectListData*)lParam;
+    WCHAR cls[64];
+
+    /* the windows of other clients take no part */
+    if (GetClassNameW(hwnd, cls, ARRAY_SIZE(cls)) && !wcsicmp(cls, WDML_szClientConvClassW)) return TRUE;
+    if (GetClassNameA(hwnd, (char*)cls, sizeof(cls)) && !lstrcmpiA((char*)cls, WDML_szClientConvClassA)) return TRUE;
+
+    if (data->count == data->size)
+    {
+	HWND* grown = realloc(data->windows, (data->size ? data->size * 2 : 32) * sizeof(HWND));
+	if (!grown) return FALSE;
+	data->windows = grown;
+	data->size = data->size ? data->size * 2 : 32;
+    }
+    data->windows[data->count++] = hwnd;
+    return TRUE;
+}
+
+/* the instance is going away: its conversation lists with it (the conversations are
+ * disconnected by the caller) */
+void WDML_FreeConvLists(DWORD idInst)
+{
+    WDML_CONVLIST** p = &WDML_ConvLists;
+
+    while (*p)
+    {
+	WDML_CONVLIST* list = *p;
+	if (list->idInst == idInst)
+	{
+	    *p = list->next;
+	    list->magic = 0;
+	    free(list->convs);
+	    free(list);
+	}
+	else p = &list->next;
+    }
+}
+
 /******************************************************************************
  * DdeConnectList [USER32.@]  Establishes conversation with DDE servers
  *
@@ -50,8 +182,149 @@
 HCONVLIST WINAPI DdeConnectList(DWORD idInst, HSZ hszService, HSZ hszTopic,
 				HCONVLIST hConvList, PCONVCONTEXT pCC)
 {
-    FIXME("(%ld,%p,%p,%p,%p): stub\n", idInst, hszService, hszTopic, hConvList, pCC);
-    return (HCONVLIST)1;
+    WDML_INSTANCE*	pInstance;
+    WDML_CONVLIST*	list = NULL, *oldList = NULL;
+    struct WDML_ConnectListData data = {NULL, 0, 0};
+    HCONV*		convs = NULL;
+    UINT		count = 0, i, j, capacity;
+    ATOM		aSrv = 0, aTpc = 0;
+
+    TRACE("(%ld,%p,%p,%p,%p)\n", idInst, hszService, hszTopic, hConvList, pCC);
+
+    pInstance = WDML_GetInstance(idInst);
+    if (!pInstance) return 0;
+
+    if (hConvList)
+    {
+	oldList = WDML_FindConvList(hConvList);
+	if (!oldList || oldList->idInst != idInst)
+	{
+	    pInstance->lastError = DMLERR_INVALIDPARAMETER;
+	    return 0;
+	}
+    }
+
+    if (hszService)
+    {
+	aSrv = WDML_MakeAtomFromHsz(hszService);
+	if (!aSrv) goto fail;
+    }
+    if (hszTopic)
+    {
+	aTpc = WDML_MakeAtomFromHsz(hszTopic);
+	if (!aTpc) goto fail;
+    }
+
+    capacity = (oldList ? oldList->count : 0) + 8;
+    if (!(convs = malloc(capacity * sizeof(*convs)))) goto fail;
+
+    /* an existing list keeps its conversations that are still alive */
+#ifndef SG_MUTANT_DDELIST_NOREFRESH
+    if (oldList)
+	for (i = 0; i < oldList->count; i++)
+	    if (WDML_ConvListEntryAlive(oldList->convs[i])) convs[count++] = oldList->convs[i];
+#endif
+
+    /* ask every top level window, each through a client window of its own, so that every server
+     * that answers gets a conversation of its own */
+    EnumWindows(WDML_ConnectListEnumProc, (LPARAM)&data);
+    for (i = 0; i < data.count; i++)
+    {
+	HWND		hwndClient;
+	WDML_CONV*	pConv;
+	BOOL		known = FALSE;
+
+	if (!IsWindow(data.windows[i])) continue;
+	if (!(hwndClient = WDML_CreateClientWindow(pInstance))) continue;
+
+	SendMessageTimeoutW(data.windows[i], WM_DDE_INITIATE, (WPARAM)hwndClient, MAKELPARAM(aSrv, aTpc),
+			    SMTO_ABORTIFHUNG, 2000, NULL);
+
+	if (!WDML_GetInstance(idInst))
+	{
+	    /* the instance went away while the servers were answering */
+	    free(data.windows);
+	    free(convs);
+	    return 0;
+	}
+	pConv = WDML_GetConvFromWnd(hwndClient);
+	if (pConv == NULL || pConv->hwndServer == 0)
+	{
+	    NtUserDestroyWindow(hwndClient);
+	    continue;
+	}
+	/* the same service and topic as one the list already holds is the same conversation */
+	for (j = 0; j < count; j++)
+	{
+	    WDML_CONV* old = WDML_GetConv(convs[j], FALSE);
+	    if (old && old != pConv && !DdeCmpStringHandles(old->hszService, pConv->hszService) &&
+		!DdeCmpStringHandles(old->hszTopic, pConv->hszTopic)) known = TRUE;
+	}
+	if (known)
+	{
+	    WDML_RemoveConv(pConv, WDML_CLIENT_SIDE);
+	    PostMessageW(pConv->hwndServer, WM_DDE_TERMINATE, (WPARAM)hwndClient, 0);
+	    NtUserDestroyWindow(hwndClient);
+	    continue;
+	}
+	pConv->wConvst = XST_CONNECTED;
+	WDML_SetClientContext(pInstance, pConv, pCC);
+	if (count == capacity)
+	{
+	    HCONV* grown = realloc(convs, (capacity *= 2) * sizeof(*convs));
+	    if (!grown) break;
+	    convs = grown;
+	}
+	convs[count++] = (HCONV)pConv;
+#ifdef SG_MUTANT_DDELIST_ONE
+	break;
+#endif
+    }
+    free(data.windows);
+    if (aSrv) GlobalDeleteAtom(aSrv);
+    if (aTpc) GlobalDeleteAtom(aTpc);
+    aSrv = aTpc = 0;
+
+    if (!count)
+    {
+	pInstance->lastError = DMLERR_NO_CONV_ESTABLISHED;
+	goto fail;
+    }
+
+    if (!(list = malloc(sizeof(*list)))) goto fail;
+    list->magic = WDML_CONVLIST_MAGIC;
+    list->idInst = idInst;
+    list->count = count;
+    list->convs = convs;
+    list->next = WDML_ConvLists;
+    WDML_ConvLists = list;
+
+    if (oldList)
+    {
+	WDML_CONVLIST** p;
+	for (p = &WDML_ConvLists; *p; p = &(*p)->next)
+	    if (*p == oldList) { *p = oldList->next; break; }
+	oldList->magic = 0;
+	free(oldList->convs);
+	free(oldList);
+    }
+    return (HCONVLIST)list;
+
+ fail:
+    if (aSrv) GlobalDeleteAtom(aSrv);
+    if (aTpc) GlobalDeleteAtom(aTpc);
+    free(convs);
+    if (oldList)
+    {
+	/* the old list is no longer valid after a failed call */
+	WDML_CONVLIST** p;
+	for (p = &WDML_ConvLists; *p; p = &(*p)->next)
+	    if (*p == oldList) { *p = oldList->next; break; }
+	oldList->magic = 0;
+	free(oldList->convs);
+	free(oldList);
+    }
+    return 0;
 }
 
 /*****************************************************************
@@ -59,7 +332,23 @@
  */
 HCONV WINAPI DdeQueryNextServer(HCONVLIST hConvList, HCONV hConvPrev)
 {
-    FIXME("(%p,%p): stub\n", hConvList, hConvPrev);
+    WDML_CONVLIST*	list = WDML_FindConvList(hConvList);
+    UINT		i = 0;
+
+    TRACE("(%p,%p)\n", hConvList, hConvPrev);
+
+    if (!list) return 0;
+#ifdef SG_MUTANT_DDELIST_STUB
+    return 0;
+#endif
+    if (hConvPrev)
+    {
+	for (i = 0; i < list->count; i++) if (list->convs[i] == hConvPrev) break;
+	if (i == list->count) return 0;
+	i++;
+    }
+    for (; i < list->count; i++)
+	if (WDML_ConvListEntryAlive(list->convs[i])) return list->convs[i];
     return 0;
 }
 
@@ -76,7 +365,20 @@
  */
 BOOL WINAPI DdeDisconnectList(HCONVLIST hConvList)
 {
-    FIXME("(%p): stub\n", hConvList);
+    WDML_CONVLIST*	list = WDML_FindConvList(hConvList);
+    WDML_CONVLIST**	p;
+    UINT		i;
+
+    TRACE("(%p)\n", hConvList);
+
+    if (!list) return FALSE;
+    for (p = &WDML_ConvLists; *p; p = &(*p)->next)
+	if (*p == list) { *p = list->next; break; }
+    list->magic = 0;
+    for (i = 0; i < list->count; i++)
+	if (WDML_ConvListEntryAlive(list->convs[i])) DdeDisconnect(list->convs[i]);
+    free(list->convs);
+    free(list);
     return TRUE;
 }
 
diff --git a/dlls/user32/dde_private.h b/dlls/user32/dde_private.h
--- a/dlls/user32/dde_private.h
+++ b/dlls/user32/dde_private.h
@@ -143,6 +143,17 @@
 
 #define WDML_CONV_MAGIC  0xbabe1234
 
+/* a conversation list (DdeConnectList): the client conversations it holds */
+#define WDML_CONVLIST_MAGIC 0x4c564e43
+typedef struct tagWDML_CONVLIST
+{
+    struct tagWDML_CONVLIST*	next;		/* all the lists of the process */
+    UINT			magic;
+    DWORD			idInst;
+    UINT			count;
+    HCONV*			convs;
+} WDML_CONVLIST;
+
 /* DDE_LINK struct defines hot, warm, and cold links */
 typedef struct tagWDML_LINK {
     struct tagWDML_LINK*	next;		/* to link all the active links */
@@ -229,6 +240,7 @@
 extern	HDDEDATA	WDML_Global2DataHandle(WDML_CONV* pConv, HGLOBAL hMem, WINE_DDEHEAD* da);
 extern  BOOL            WDML_IsAppOwned(HDDEDATA hDdeData);
 extern	WDML_INSTANCE*	WDML_GetInstance(DWORD InstId);
+extern	void		WDML_FreeConvLists(DWORD idInst);
 extern	WDML_INSTANCE*	WDML_GetInstanceFromWnd(HWND hWnd);
 /* broadcasting to DDE windows */
 extern	void		WDML_BroadcastDDEWindows(LPCWSTR clsName, UINT uMsg,
diff --git a/dlls/user32/dde_misc.c b/dlls/user32/dde_misc.c
--- a/dlls/user32/dde_misc.c
+++ b/dlls/user32/dde_misc.c
@@ -1130,6 +1130,9 @@
 	return FALSE;
     }
 
+    /* the conversation lists first: their conversations are closed just below */
+    WDML_FreeConvLists(idInst);
+
     /* first terminate all conversations client side
      * this shall close existing links...
      */
