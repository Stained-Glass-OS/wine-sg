+static void test_fragment_cache(void)
+{
+    static const WCHAR url[] = L"http://localhost:50124/frag";
+    HTTP_CACHE_POLICY policy = {HttpCachePolicyUserInvalidates, 0};
+    HTTP_DATA_CHUNK chunk = {HttpDataChunkFromMemory};
+    HTTP_BYTE_RANGE range;
+    ULONG ret, read;
+    char buffer[16];
+    HANDLE queue;
+
+    ret = HttpCreateHttpHandle(&queue, 0);
+    ok(!ret, "Got error %lu.\n", ret);
+
+    chunk.FromMemory.pBuffer = (void *)"fragment";
+    chunk.FromMemory.BufferLength = 8;
+    ret = HttpAddFragmentToCache(queue, url, &chunk, &policy, NULL);
+    ok(!ret, "Got error %lu.\n", ret);
+
+    memset(buffer, 0, sizeof(buffer));
+    ret = HttpReadFragmentFromCache(queue, url, NULL, buffer, sizeof(buffer), &read, NULL);
+    ok(!ret && read == 8 && !memcmp(buffer, "fragment", 8), "Got error %lu, read %lu.\n", ret, read);
+
+    range.StartingOffset.QuadPart = 2;
+    range.Length.QuadPart = 3;
+    memset(buffer, 0, sizeof(buffer));
+    ret = HttpReadFragmentFromCache(queue, url, &range, buffer, sizeof(buffer), &read, NULL);
+    ok(!ret && read == 3 && !memcmp(buffer, "agm", 3), "Got error %lu, read %lu.\n", ret, read);
+
+    ret = HttpReadFragmentFromCache(queue, url, NULL, buffer, 2, &read, NULL);
+    ok(ret == ERROR_MORE_DATA && read == 8, "Got error %lu, read %lu.\n", ret, read);
+
+    ret = HttpFlushResponseCache(queue, url, 0, NULL);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = HttpReadFragmentFromCache(queue, url, NULL, buffer, sizeof(buffer), &read, NULL);
+    ok(ret == ERROR_FILE_NOT_FOUND, "Got error %lu.\n", ret);
+    ret = HttpFlushResponseCache(queue, url, 0, NULL);
+    ok(ret == ERROR_FILE_NOT_FOUND, "Got error %lu.\n", ret);
+
+    CloseHandle(queue);
+}
