+static HKEY open_config_key(const WCHAR *subkey, BOOL create, REGSAM access, LONG *err)
+{
+    WCHAR path[256];
+    HKEY key = NULL;
+
+    if (*subkey)
+        swprintf(path, ARRAY_SIZE(path), L"%ls\\%ls", parameters_key, subkey);
+    else
+        wcscpy(path, parameters_key);
+    if (create)
+        *err = RegCreateKeyExW(HKEY_LOCAL_MACHINE, path, 0, NULL, 0, access, NULL, &key, NULL);
+    else
+        *err = RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, access, &key);
+    return key;
+}
+
+static ULONG check_config_args(HANDLE handle, HTTP_SERVICE_CONFIG_ID type, OVERLAPPED *ovl)
+{
+    if (handle || ovl) return ERROR_INVALID_PARAMETER;
+    if ((int)type < 0 || type >= HttpServiceConfigMax) return ERROR_INVALID_PARAMETER;
+    return ERROR_SUCCESS;
+}
+
+static BOOL is_valid_url_prefix(const WCHAR *url)
+{
+    const WCHAR *p;
+
+    if (!_wcsnicmp(url, L"http://", 7)) p = url + 7;
+    else if (!_wcsnicmp(url, L"https://", 8)) p = url + 8;
+    else return FALSE;
+    /* http://host:port/path/ */
+    if (!(p = wcschr(p, ':')) || !iswdigit(p[1])) return FALSE;
+    return wcschr(p, '/') != NULL && url[wcslen(url) - 1] == '/';
+}
