+{
+    static const HTTPAPI_VERSION version = {2, 0};
+    ULONG (WINAPI *pHttpQueryUrlGroupProperty)(HTTP_URL_GROUP_ID, HTTP_SERVER_PROPERTY, void *, ULONG, ULONG *);
+    ULONG (WINAPI *pHttpQueryServerSessionProperty)(HTTP_SERVER_SESSION_ID, HTTP_SERVER_PROPERTY, void *, ULONG, ULONG *);
+    ULONG (WINAPI *pHttpSetServerSessionProperty)(HTTP_SERVER_SESSION_ID, HTTP_SERVER_PROPERTY, void *, ULONG);
+    ULONG (WINAPI *pHttpQueryRequestQueueProperty)(HANDLE, HTTP_SERVER_PROPERTY, void *, ULONG, ULONG, ULONG *, void *);
+    ULONG (WINAPI *pHttpSetRequestQueueProperty)(HANDLE, HTTP_SERVER_PROPERTY, void *, ULONG, ULONG, void *);
+    HTTP_SERVER_SESSION_ID session;
+    HTTP_URL_GROUP_ID group;
+    HTTP_BINDING_INFO binding = {{1}}, got;
+    HMODULE mod = GetModuleHandleA("httpapi.dll");
+    ULONG ret, size, length;
+    HANDLE queue;
+
+    pHttpQueryUrlGroupProperty = (void *)GetProcAddress(mod, "HttpQueryUrlGroupProperty");
+    pHttpQueryServerSessionProperty = (void *)GetProcAddress(mod, "HttpQueryServerSessionProperty");
+    pHttpSetServerSessionProperty = (void *)GetProcAddress(mod, "HttpSetServerSessionProperty");
+    pHttpQueryRequestQueueProperty = (void *)GetProcAddress(mod, "HttpQueryRequestQueueProperty");
+    pHttpSetRequestQueueProperty = (void *)GetProcAddress(mod, "HttpSetRequestQueueProperty");
+
+    ret = pHttpCreateServerSession(version, &session, 0);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = pHttpCreateUrlGroup(session, &group, 0);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = pHttpCreateRequestQueue(version, NULL, NULL, 0, &queue);
+    ok(!ret, "Got error %lu.\n", ret);
+
+    /* several URLs per group */
+    ret = pHttpAddUrlToUrlGroup(group, L"http://localhost:50125/a/", 1, 0);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = pHttpAddUrlToUrlGroup(group, L"http://localhost:50125/b/", 2, 0);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = pHttpAddUrlToUrlGroup(group, L"http://localhost:50125/A/", 3, 0);
+    ok(ret == ERROR_ALREADY_EXISTS, "Got error %lu.\n", ret);
+    ret = pHttpAddUrlToUrlGroup(group, NULL, 3, 0);
+    ok(ret == ERROR_INVALID_PARAMETER, "Got error %lu.\n", ret);
+
+    ret = pHttpSetUrlGroupProperty(group, HttpServerBindingProperty, &binding, sizeof(binding));
+    ok(!ret, "Got error %lu.\n", ret);
+    binding.RequestQueueHandle = queue;
+    ret = pHttpSetUrlGroupProperty(group, HttpServerBindingProperty, &binding, sizeof(binding));
+    ok(!ret, "Got error %lu.\n", ret);
+
+    memset(&got, 0, sizeof(got));
+    size = 0;
+    ret = pHttpQueryUrlGroupProperty(group, HttpServerBindingProperty, &got, sizeof(got), &size);
+    ok(!ret && size == sizeof(got) && got.RequestQueueHandle == queue, "Got error %lu, size %lu.\n", ret, size);
+
+    ret = pHttpRemoveUrlFromUrlGroup(group, L"http://localhost:50125/a/", 0);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = pHttpRemoveUrlFromUrlGroup(group, L"http://localhost:50125/a/", 0);
+    ok(ret == ERROR_FILE_NOT_FOUND, "Got error %lu.\n", ret);
+    ret = pHttpRemoveUrlFromUrlGroup(group, NULL, HTTP_URL_FLAG_REMOVE_ALL);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = pHttpRemoveUrlFromUrlGroup(group, L"http://localhost:50125/b/", 0);
+    ok(ret == ERROR_FILE_NOT_FOUND, "Got error %lu.\n", ret);
+
+    /* the removed URLs can be used again */
+    ret = pHttpAddUrlToUrlGroup(group, L"http://localhost:50125/b/", 2, 0);
+    ok(!ret, "Got error %lu.\n", ret);
+
+    /* properties read back */
+    length = 55;
+    ret = pHttpSetRequestQueueProperty(queue, HttpServerQueueLengthProperty, &length, sizeof(length), 0, NULL);
+    ok(!ret, "Got error %lu.\n", ret);
+    length = 0;
+    ret = pHttpQueryRequestQueueProperty(queue, HttpServerQueueLengthProperty, &length, sizeof(length), 0, &size, NULL);
+    ok(!ret && length == 55, "Got error %lu, length %lu.\n", ret, length);
+
+    length = 7;
+    ret = pHttpSetServerSessionProperty(session, HttpServerStateProperty, &length, sizeof(length));
+    ok(!ret, "Got error %lu.\n", ret);
+    length = 0;
+    ret = pHttpQueryServerSessionProperty(session, HttpServerStateProperty, &length, sizeof(length), &size);
+    ok(!ret && length == 7, "Got error %lu, value %lu.\n", ret, length);
+    ret = pHttpQueryServerSessionProperty(session, HttpServerStateProperty, &length, 1, &size);
+    ok(ret == ERROR_MORE_DATA, "Got error %lu.\n", ret);
+
+    ret = pHttpCloseUrlGroup(group);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = pHttpCloseUrlGroup(group);
+    ok(ret == ERROR_INVALID_PARAMETER, "Got error %lu.\n", ret);
+    ret = pHttpCloseRequestQueue(queue);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = pHttpCloseServerSession(session);
+    ok(!ret, "Got error %lu.\n", ret);
+}
