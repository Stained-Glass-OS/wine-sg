+/* Properties set on a server object are kept so that they can be queried back. */
+enum prop_owner { OWNER_SESSION, OWNER_GROUP, OWNER_QUEUE };
+
+struct stored_property
+{
+    struct list entry;
+    enum prop_owner owner;
+    ULONGLONG key;
+    HTTP_SERVER_PROPERTY property;
+    ULONG length;
+    BYTE data[1];
 };
 
+static struct list stored_properties = LIST_INIT(stored_properties);
+
+static struct stored_property *find_property(enum prop_owner owner, ULONGLONG key, HTTP_SERVER_PROPERTY property)
+{
+    struct stored_property *prop;
+
+    LIST_FOR_EACH_ENTRY(prop, &stored_properties, struct stored_property, entry)
+    {
+        if (prop->owner == owner && prop->key == key && prop->property == property)
+            return prop;
+    }
+    return NULL;
+}
+
+static ULONG store_property(enum prop_owner owner, ULONGLONG key, HTTP_SERVER_PROPERTY property,
+        const void *value, ULONG length)
+{
+    struct stored_property *prop, *old;
+
+    if (!(prop = malloc(offsetof(struct stored_property, data[length]))))
+        return ERROR_OUTOFMEMORY;
+    prop->owner = owner;
+    prop->key = key;
+    prop->property = property;
+    prop->length = length;
+    memcpy(prop->data, value, length);
+
+    EnterCriticalSection(&httpapi_cs);
+    if ((old = find_property(owner, key, property)))
+    {
+        list_remove(&old->entry);
+        free(old);
+    }
+    list_add_tail(&stored_properties, &prop->entry);
+    LeaveCriticalSection(&httpapi_cs);
+    return ERROR_SUCCESS;
+}
+
+static void free_properties(enum prop_owner owner, ULONGLONG key)
+{
+    struct stored_property *prop, *next;
+
+    EnterCriticalSection(&httpapi_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(prop, next, &stored_properties, struct stored_property, entry)
+    {
+        if (prop->owner == owner && prop->key == key)
+        {
+            list_remove(&prop->entry);
+            free(prop);
+        }
+    }
+    LeaveCriticalSection(&httpapi_cs);
+}
+
+static ULONG query_property(enum prop_owner owner, ULONGLONG key, HTTP_SERVER_PROPERTY property,
+        void *value, ULONG length, ULONG *ret_length)
+{
+    struct stored_property *prop;
+    ULONG ret = ERROR_SUCCESS;
+
+    if (property >= HttpServerListenEndpointProperty + 3) return ERROR_INVALID_PARAMETER;
+
+    EnterCriticalSection(&httpapi_cs);
+    prop = find_property(owner, key, property);
