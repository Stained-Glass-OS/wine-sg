+        DWORD value;
+
+        if (!config || length < sizeof(*set) || set->KeyDesc >= ARRAY_SIZE(names)) return ERROR_INVALID_PARAMETER;
+        if (!(key = open_config_key( L"", TRUE, KEY_SET_VALUE, &err ))) return err;
+        value = set->ParamDesc;
+        err = RegSetValueExW( key, names[set->KeyDesc], 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+        RegCloseKey( key );
+        return err;
+    }
+    case HttpServiceConfigSSLCertInfo:
+        FIXME( "HTTPS certificate bindings are not supported.\n" );
+        return ERROR_CALL_NOT_IMPLEMENTED;
+    default:
+        return ERROR_INVALID_PARAMETER;
+    }
