+/* The response cache is private to the process that fills it. */
+struct cache_entry
+{
+    struct list entry;
+    WCHAR *url;
+    BYTE *data;
+    ULONG size;
+    ULONGLONG expires; /* GetTickCount64() value, 0 = never */
+};
+
+static struct list response_cache = LIST_INIT(response_cache);
+
+static struct cache_entry *find_cache_entry(const WCHAR *url)
+{
+    ULONGLONG now = GetTickCount64();
+    struct cache_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &response_cache, struct cache_entry, entry)
+    {
+        if (entry->expires && entry->expires <= now)
+        {
+            list_remove(&entry->entry);
+            free(entry->url);
+            free(entry->data);
+            free(entry);
+        }
+        else if (!wcsicmp(entry->url, url))
+            return entry;
+    }
+    return NULL;
+}
+
+/* Reads the bytes selected by a file chunk. The caller frees the buffer. */
+static ULONG read_file_chunk(const HTTP_DATA_CHUNK *chunk, BYTE **data, ULONG *size)
+{
+    LARGE_INTEGER file_size;
+    ULONGLONG start = chunk->FromFileHandle.ByteRange.StartingOffset.QuadPart;
+    ULONGLONG length = chunk->FromFileHandle.ByteRange.Length.QuadPart;
+    DWORD read = 0;
+    OVERLAPPED ovl = {};
+    BYTE *buf;
+
+    if (!GetFileSizeEx(chunk->FromFileHandle.FileHandle, &file_size))
+        return GetLastError();
+    if (start > (ULONGLONG)file_size.QuadPart)
+        return ERROR_INVALID_PARAMETER;
+    if (length == HTTP_BYTE_RANGE_TO_EOF)
+        length = file_size.QuadPart - start;
+    if (start + length > (ULONGLONG)file_size.QuadPart || length > 0x7fffffff)
+        return ERROR_INVALID_PARAMETER;
+
+    if (!(buf = malloc(length ? length : 1)))
+        return ERROR_OUTOFMEMORY;
+    ovl.Offset = (DWORD)start;
+    ovl.OffsetHigh = start >> 32;
+    ovl.hEvent = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (length && !ReadFile(chunk->FromFileHandle.FileHandle, buf, length, &read, &ovl))
+    {
+        DWORD err = GetLastError();
+        if (err == ERROR_IO_PENDING)
+            err = GetOverlappedResult(chunk->FromFileHandle.FileHandle, &ovl, &read, TRUE) ? 0 : GetLastError();
+        if (err)
+        {
+            CloseHandle(ovl.hEvent);
+            free(buf);
+            return err;
+        }
+    }
+    CloseHandle(ovl.hEvent);
+    if (read != length)
+    {
+        free(buf);
+        return ERROR_HANDLE_EOF;
+    }
+    *data = buf;
+    *size = length;
+    return ERROR_SUCCESS;
+}
+
+/* Resolves a data chunk to memory. *allocated is set when the caller must free *data. */
+static ULONG resolve_chunk(const HTTP_DATA_CHUNK *chunk, BYTE **data, ULONG *size, BOOL *allocated)
+{
+    *allocated = FALSE;
+    switch (chunk->DataChunkType)
+    {
+    case HttpDataChunkFromMemory:
+        *data = chunk->FromMemory.pBuffer;
+        *size = chunk->FromMemory.BufferLength;
+        return ERROR_SUCCESS;
+    case HttpDataChunkFromFileHandle:
+    {
+        ULONG ret = read_file_chunk(chunk, data, size);
+        *allocated = !ret;
+        return ret;
+    }
+    case HttpDataChunkFromFragmentCache:
+    {
+        struct cache_entry *entry;
+        WCHAR *name;
+        ULONG ret = ERROR_FILE_NOT_FOUND;
+
+        if (!chunk->FromFragmentCache.pFragmentName) return ERROR_INVALID_PARAMETER;
+        {
+            USHORT name_len = chunk->FromFragmentCache.FragmentNameLength / sizeof(WCHAR);
+            if (!(name = malloc((name_len + 1) * sizeof(WCHAR)))) return ERROR_OUTOFMEMORY;
+            memcpy(name, chunk->FromFragmentCache.pFragmentName, name_len * sizeof(WCHAR));
+            name[name_len] = 0;
+        }
+        EnterCriticalSection(&httpapi_cs);
+        if ((entry = find_cache_entry(name)))
+        {
+            if ((*data = malloc(entry->size ? entry->size : 1)))
+            {
+                memcpy(*data, entry->data, entry->size);
+                *size = entry->size;
+                *allocated = TRUE;
+                ret = ERROR_SUCCESS;
+            }
+            else ret = ERROR_OUTOFMEMORY;
+        }
+        LeaveCriticalSection(&httpapi_cs);
+        free(name);
+        return ret;
+    }
+    default:
+        FIXME("Unhandled data chunk type %u.\n", chunk->DataChunkType);
+        return ERROR_INVALID_PARAMETER;
+    }
+}
+
+/***********************************************************************
+ *        HttpAddFragmentToCache     (HTTPAPI.@)
+ */
+ULONG WINAPI HttpAddFragmentToCache(HANDLE queue, const WCHAR *url, HTTP_DATA_CHUNK *chunk,
+        HTTP_CACHE_POLICY *policy, OVERLAPPED *ovl)
+{
+    struct cache_entry *entry, *old;
+    BOOL allocated;
+    BYTE *data;
+    ULONG ret, size;
+
+    TRACE("queue %p, url %s, chunk %p, policy %p, ovl %p.\n", queue, debugstr_w(url), chunk, policy, ovl);
+
+    if (!queue || queue == INVALID_HANDLE_VALUE) return ERROR_INVALID_HANDLE;
+    if (!url || !chunk || !policy || policy->Policy >= HttpCachePolicyMaximum) return ERROR_INVALID_PARAMETER;
+    if (policy->Policy == HttpCachePolicyNocache) return ERROR_INVALID_PARAMETER;
+
+    if ((ret = resolve_chunk(chunk, &data, &size, &allocated))) return ret;
+    if (!(entry = calloc(1, sizeof(*entry))) || !(entry->url = wcsdup(url)) || !(entry->data = malloc(size ? size : 1)))
+    {
+        if (entry) { free(entry->url); free(entry); }
+        if (allocated) free(data);
+        return ERROR_OUTOFMEMORY;
+    }
+    memcpy(entry->data, data, size);
+    entry->size = size;
+    if (policy->Policy == HttpCachePolicyTimeToLive)
+        entry->expires = GetTickCount64() + (ULONGLONG)policy->SecondsToLive * 1000;
+    if (allocated) free(data);
+
+    EnterCriticalSection(&httpapi_cs);
+    if ((old = find_cache_entry(url)))
+    {
+        list_remove(&old->entry);
+        free(old->url);
+        free(old->data);
+        free(old);
+    }
+    list_add_tail(&response_cache, &entry->entry);
+    LeaveCriticalSection(&httpapi_cs);
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *        HttpReadFragmentFromCache     (HTTPAPI.@)
+ */
+ULONG WINAPI HttpReadFragmentFromCache(HANDLE queue, const WCHAR *url, HTTP_BYTE_RANGE *range,
+        void *buffer, ULONG size, ULONG *bytes_read, OVERLAPPED *ovl)
+{
+    struct cache_entry *entry;
+    ULONGLONG start = 0, length;
+    ULONG ret = ERROR_SUCCESS;
+
+    TRACE("queue %p, url %s, range %p, buffer %p, size %lu, bytes_read %p, ovl %p.\n",
+            queue, debugstr_w(url), range, buffer, size, bytes_read, ovl);
+
+    if (!queue || queue == INVALID_HANDLE_VALUE) return ERROR_INVALID_HANDLE;
+    if (!url) return ERROR_INVALID_PARAMETER;
+
+    EnterCriticalSection(&httpapi_cs);
+    if (!(entry = find_cache_entry(url)))
+    {
+        LeaveCriticalSection(&httpapi_cs);
+        return ERROR_FILE_NOT_FOUND;
+    }
+    length = entry->size;
+    if (range)
+    {
+        start = range->StartingOffset.QuadPart;
+        if (start > entry->size) ret = ERROR_INVALID_PARAMETER;
+        else if (range->Length.QuadPart == HTTP_BYTE_RANGE_TO_EOF) length = entry->size - start;
+        else if (start + range->Length.QuadPart > entry->size) ret = ERROR_INVALID_PARAMETER;
+        else length = range->Length.QuadPart;
+    }
+    if (!ret)
+    {
+        if (bytes_read) *bytes_read = length;
+        if (!buffer || size < length) ret = ERROR_MORE_DATA;
+        else memcpy(buffer, entry->data + start, length);
+    }
+    LeaveCriticalSection(&httpapi_cs);
+    return ret;
+}
+
+/***********************************************************************
+ *        HttpFlushResponseCache     (HTTPAPI.@)
+ */
+ULONG WINAPI HttpFlushResponseCache(HANDLE queue, const WCHAR *url, ULONG flags, OVERLAPPED *ovl)
+{
+    struct cache_entry *entry, *next;
+    size_t len;
+    BOOL found = FALSE;
+
+    TRACE("queue %p, url %s, flags %#lx, ovl %p.\n", queue, debugstr_w(url), flags, ovl);
+
+    if (!queue || queue == INVALID_HANDLE_VALUE) return ERROR_INVALID_HANDLE;
+    if (!url || (flags & ~1)) return ERROR_INVALID_PARAMETER;
+
+    len = wcslen(url);
+    EnterCriticalSection(&httpapi_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &response_cache, struct cache_entry, entry)
+    {
+        if (flags & 1 ? !_wcsnicmp(entry->url, url, len) : !wcsicmp(entry->url, url))
+        {
+            list_remove(&entry->entry);
+            free(entry->url);
+            free(entry->data);
+            free(entry);
+            found = TRUE;
+        }
+    }
+    LeaveCriticalSection(&httpapi_cs);
+    return found ? ERROR_SUCCESS : ERROR_FILE_NOT_FOUND;
+}
