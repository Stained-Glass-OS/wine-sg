+static void test_service_config(void)
+{
+    static WCHAR prefix[] = L"http://+:50123/wine-test/";
+    static WCHAR bad_prefix[] = L"http://+/wine-test/";
+    static WCHAR sddl[] = L"D:(A;;GX;;;WD)";
+    struct { WCHAR *prefix; WCHAR *sddl; } set;
+    struct { int type; WCHAR *prefix; DWORD token; } query;
+    BYTE buffer[512];
+    SOCKADDR_IN addr = {.sin_family = AF_INET};
+    struct { USHORT len; SOCKADDR *addr; } listen_param = {sizeof(addr), (SOCKADDR *)&addr};
+    struct { ULONG key; USHORT value; } timeout_set;
+    ULONG ret, size;
+
+    set.prefix = prefix;
+    set.sddl = sddl;
+    ret = HttpSetServiceConfiguration(NULL, HttpServiceConfigUrlAclInfo, &set, sizeof(set), NULL);
+    if (ret == ERROR_ACCESS_DENIED)
+    {
+        skip("Not enough permissions to change the HTTP configuration.\n");
+        return;
+    }
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = HttpSetServiceConfiguration(NULL, HttpServiceConfigUrlAclInfo, &set, sizeof(set), NULL);
+    ok(ret == ERROR_ALREADY_EXISTS, "Got error %lu.\n", ret);
+    set.prefix = bad_prefix;
+    ret = HttpSetServiceConfiguration(NULL, HttpServiceConfigUrlAclInfo, &set, sizeof(set), NULL);
+    ok(ret == ERROR_INVALID_PARAMETER, "Got error %lu.\n", ret);
+    ret = HttpSetServiceConfiguration((HANDLE)1, HttpServiceConfigUrlAclInfo, &set, sizeof(set), NULL);
+    ok(ret == ERROR_INVALID_PARAMETER, "Got error %lu.\n", ret);
+
+    query.type = 0;
+    query.prefix = prefix;
+    query.token = 0;
+    size = 0;
+    ret = HttpQueryServiceConfiguration(NULL, HttpServiceConfigUrlAclInfo, &query, sizeof(query), buffer, 1, &size, NULL);
+    ok(ret == ERROR_INSUFFICIENT_BUFFER, "Got error %lu.\n", ret);
+    ok(size > 1, "Got size %lu.\n", size);
+    ret = HttpQueryServiceConfiguration(NULL, HttpServiceConfigUrlAclInfo, &query, sizeof(query), buffer, sizeof(buffer), &size, NULL);
+    ok(!ret, "Got error %lu.\n", ret);
+    ok(!wcscmp(((WCHAR **)buffer)[0], prefix) && !wcscmp(((WCHAR **)buffer)[1], sddl), "Got %s, %s.\n",
+            wine_dbgstr_w(((WCHAR **)buffer)[0]), wine_dbgstr_w(((WCHAR **)buffer)[1]));
+
+    ret = HttpDeleteServiceConfiguration(NULL, HttpServiceConfigUrlAclInfo, &set, sizeof(set), NULL);
+    ok(ret == ERROR_INVALID_PARAMETER, "Got error %lu.\n", ret);
+    set.prefix = prefix;
+    ret = HttpDeleteServiceConfiguration(NULL, HttpServiceConfigUrlAclInfo, &set, sizeof(set), NULL);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = HttpDeleteServiceConfiguration(NULL, HttpServiceConfigUrlAclInfo, &set, sizeof(set), NULL);
+    ok(ret == ERROR_FILE_NOT_FOUND, "Got error %lu.\n", ret);
+    ret = HttpQueryServiceConfiguration(NULL, HttpServiceConfigUrlAclInfo, &query, sizeof(query), buffer, sizeof(buffer), &size, NULL);
+    ok(ret == ERROR_FILE_NOT_FOUND, "Got error %lu.\n", ret);
+
+    addr.sin_addr.S_un.S_addr = htonl(0x7f000001);
+    ret = HttpSetServiceConfiguration(NULL, HttpServiceConfigIPListenList, &listen_param, sizeof(listen_param), NULL);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = HttpSetServiceConfiguration(NULL, HttpServiceConfigIPListenList, &listen_param, sizeof(listen_param), NULL);
+    ok(ret == ERROR_ALREADY_EXISTS, "Got error %lu.\n", ret);
+    ret = HttpQueryServiceConfiguration(NULL, HttpServiceConfigIPListenList, NULL, 0, buffer, sizeof(buffer), &size, NULL);
+    ok(!ret, "Got error %lu.\n", ret);
+    ok(*(ULONG *)buffer == 1, "Got %lu addresses.\n", *(ULONG *)buffer);
+    ret = HttpDeleteServiceConfiguration(NULL, HttpServiceConfigIPListenList, &listen_param, sizeof(listen_param), NULL);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = HttpDeleteServiceConfiguration(NULL, HttpServiceConfigIPListenList, &listen_param, sizeof(listen_param), NULL);
+    ok(ret == ERROR_FILE_NOT_FOUND, "Got error %lu.\n", ret);
+
+    timeout_set.key = 0;
+    timeout_set.value = 77;
+    ret = HttpSetServiceConfiguration(NULL, HttpServiceConfigTimeout, &timeout_set, sizeof(timeout_set), NULL);
+    ok(!ret, "Got error %lu.\n", ret);
+    ret = HttpQueryServiceConfiguration(NULL, HttpServiceConfigTimeout, &timeout_set, sizeof(ULONG), buffer, sizeof(buffer), &size, NULL);
+    ok(!ret && *(USHORT *)buffer == 77, "Got error %lu, value %u.\n", ret, *(USHORT *)buffer);
+    ret = HttpDeleteServiceConfiguration(NULL, HttpServiceConfigTimeout, &timeout_set, sizeof(ULONG), NULL);
+    ok(!ret, "Got error %lu.\n", ret);
