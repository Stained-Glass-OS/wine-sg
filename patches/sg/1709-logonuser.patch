+/* Stained Glass OS (1709): LogonUser asks the elevation broker (sg-brokerd)
+ * to check a password and for a one-time logon ticket. No pointers: the same
+ * for 32- and 64-bit callers. The caller wipes the password. Returns
+ * STATUS_SUCCESS (ticket set), STATUS_LOGON_FAILURE, STATUS_NO_LOGON_SERVERS
+ * (no broker) or STATUS_UNSUCCESSFUL. */
+struct logon_ticket_params
+{
+    char user[260];       /* UTF-8 */
+    char password[260];   /* UTF-8 */
+    unsigned int type;    /* LOGON32_LOGON_* */
+    char ticket[40];      /* out: 32 hex digits */
+};
+
+extern NTSTATUS logon_ticket( void *args );
