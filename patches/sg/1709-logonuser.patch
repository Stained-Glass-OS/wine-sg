-    return LogonUserW( username, domain, password, type, provider, token );
+    if (!LogonUserW( username, domain, password, type, provider, token )) return FALSE;
+    /* the logon's SID, from the token's groups (LocalFree'd by the caller) */
+    if (logon_sid)
+    {
+        TOKEN_GROUPS *groups;
+        DWORD size = 0, i;
+
+        GetTokenInformation( *token, TokenGroups, NULL, 0, &size );
+        if (size && (groups = malloc( size )))
+        {
+            if (GetTokenInformation( *token, TokenGroups, groups, size, &size ))
+                for (i = 0; i < groups->GroupCount; i++)
+                    if ((groups->Groups[i].Attributes & SE_GROUP_LOGON_ID) &&
+                        (*logon_sid = LocalAlloc( 0, GetLengthSid( groups->Groups[i].Sid ) )))
+                    {
+                        CopySid( GetLengthSid( groups->Groups[i].Sid ), *logon_sid, groups->Groups[i].Sid );
+                        break;
+                    }
+            free( groups );
+        }
+    }
+    return TRUE;
 }
 
