+/* Stained Glass OS (1709): LogonUser. The elevation broker (sg-session's
+ * sg-brokerd) checks the account's password against PAM -- the password never
+ * comes here -- and leaves a one-time ticket in a directory only the SYSTEM
+ * account, which this server runs as, may read: which account, for which
+ * requester, until when. The requester names the ticket; it is taken once
+ * (unlinked) and becomes a token for that account, a primary token, or an
+ * impersonation token for a network logon, as on Windows. */
+DECL_HANDLER(logon_ticket_token)
+{
+    static const char *dir;
+    const char *ticket = get_req_data();
+    data_size_t len = get_req_data_size(), i;
+    char path[512], buf[256], *p;
+    unsigned int uid = ~0u, for_uid = ~0u;
+    long long expires = 0;
+    struct token *token, *tok2;
+    struct stat st;
+    ssize_t n;
+    int fd;
+
+    reply->token = 0;
+    if (!sg_system_prefix) { set_error( STATUS_NOT_SUPPORTED ); return; }
+    set_error( STATUS_LOGON_FAILURE );
+    if (len != 32) return;
+    for (i = 0; i < len; i++)
+        if (!((ticket[i] >= '0' && ticket[i] <= '9') || (ticket[i] >= 'a' && ticket[i] <= 'f'))) return;
+    if (!dir && !(dir = getenv( "SG_LOGON_TICKET_DIR" ))) dir = "/run/stained-glass-broker/tickets";
+    snprintf( path, sizeof(path), "%s/%.32s", dir, ticket );
+    if ((fd = open( path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK )) < 0) return;
+    /* the broker's, as the SYSTEM account (or root): nobody else's file is a ticket */
+#ifndef SG_MUTANT_TICKET_ANY_OWNER
+    if (fstat( fd, &st ) || !S_ISREG( st.st_mode ) || (st.st_mode & 077) ||
+        (st.st_uid != 0 && st.st_uid != sg_system_prefix_uid))
+    {
+        close( fd );
+        return;
+    }
+#endif
+    n = read( fd, buf, sizeof(buf) - 1 );
+    close( fd );
+    if (n <= 0) return;
+    buf[n] = 0;
+    for (p = buf; p && *p; p = strchr( p, '\n' ) ? strchr( p, '\n' ) + 1 : NULL)
+    {
+        if (!strncmp( p, "uid=", 4 )) uid = strtoul( p + 4, NULL, 10 );
+        else if (!strncmp( p, "for=", 4 )) for_uid = strtoul( p + 4, NULL, 10 );
+        else if (!strncmp( p, "expires=", 8 )) expires = strtoll( p + 8, NULL, 10 );
+    }
+    /* only for whoever asked the broker, once, while it is fresh */
+#ifndef SG_MUTANT_TICKET_ANY_REQUESTER
+    if (for_uid != current->process->peer_uid) return;
+#endif
+    unlink( path );
+    if (uid == ~0u || !uid || uid == sg_system_prefix_uid || expires < (long long)time( NULL )) return;
+    clear_error();
+    if (!(token = token_create_for_uid( TRUE, -1, TokenElevationTypeDefault, current->process->session_id, uid )))
+        return;
+    if (req->type == 3 /* LOGON32_LOGON_NETWORK */)
+    {
+        tok2 = token_duplicate( token, FALSE, SecurityImpersonation, NULL, NULL, 0, NULL, 0 );
+        release_object( token );
+        if (!(token = tok2)) return;
+    }
+    /* the caller's, with full access, whatever the account's token itself
+     * allows other users (as LogonUser's handle on Windows) */
+    reply->token = alloc_handle_no_access_check( current->process, token, TOKEN_ALL_ACCESS, 0 );
+    release_object( token );
+}
