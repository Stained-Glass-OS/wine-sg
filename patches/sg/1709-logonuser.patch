+/* Stained Glass OS (1709): LogonUser checks the password, through the
+ * elevation broker (sg-brokerd: PAM, in its root monitor), and gives a token
+ * for the account. The broker answers with a one-time ticket that the
+ * wineserver -- which never sees the password -- turns into the token. A
+ * Wine that is not a shared prefix has no broker to ask: there, as before,
+ * the caller's own account is taken on its word. */
+static INIT_ONCE logon_once = INIT_ONCE_STATIC_INIT;
+static BOOL logon_unix_ready;
+
+static BOOL CALLBACK logon_init( INIT_ONCE *once, void *param, void **context )
+{
+    logon_unix_ready = !__wine_init_unix_call();
+    return TRUE;
+}
+
+static NTSTATUS logon_ticket_to_token( const char *ticket, DWORD type, HANDLE *token )
+{
+    NTSTATUS status;
+
+    SERVER_START_REQ( logon_ticket_token )
+    {
+        req->type = type;
+        wine_server_add_data( req, ticket, strlen( ticket ) );
+        if (!(status = wine_server_call( req ))) *token = wine_server_ptr_handle( reply->token );
+    }
+    SERVER_END_REQ;
+    return status;
+}
+
+/* the name as the account's own: "name", "name@domain" or the domain given
+ * separately, the domain this machine's (or "."); FALSE for another domain */
+static BOOL logon_account_name( const WCHAR *user, const WCHAR *domain, WCHAR *name, DWORD len )
+{
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD size = ARRAY_SIZE(computer);
+    const WCHAR *at;
+
+    if (!user || !*user || wcslen( user ) >= len) return FALSE;
+    lstrcpynW( name, user, len );
+    if (!domain && (at = wcschr( user, '@' )))
+    {
+        name[at - user] = 0;
+        domain = at + 1;
+    }
+    if (!domain || !*domain || !wcscmp( domain, L"." )) return TRUE;
+    return GetComputerNameW( computer, &size ) && !wcsicmp( domain, computer );
+}
+
 BOOL WINAPI LogonUserW( LPCWSTR lpszUsername, LPCWSTR lpszDomain, LPCWSTR lpszPassword,
                         DWORD dwLogonType, DWORD dwLogonProvider, PHANDLE phToken )
 {
-    FIXME("%s %s %p 0x%08lx 0x%08lx %p - stub\n", debugstr_w(lpszUsername),
-          debugstr_w(lpszDomain), lpszPassword, dwLogonType, dwLogonProvider, phToken);
+    struct logon_ticket_params params;
+    WCHAR name[260], own[UNLEN + 1];
+    DWORD own_len = ARRAY_SIZE(own);
+    NTSTATUS status;
+    HANDLE token = 0;
+
+    TRACE( "%s %s %p 0x%08lx 0x%08lx %p\n", debugstr_w(lpszUsername), debugstr_w(lpszDomain), lpszPassword,
+           dwLogonType, dwLogonProvider, phToken );
 
-    *phToken = (HANDLE *)0xdeadbeef;
+    if (!phToken || !lpszUsername)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *phToken = NULL;
+    switch (dwLogonType)
+    {
+    case LOGON32_LOGON_INTERACTIVE:
+    case LOGON32_LOGON_NETWORK:
+    case LOGON32_LOGON_BATCH:
+    case LOGON32_LOGON_SERVICE:
+    case LOGON32_LOGON_UNLOCK:
+    case LOGON32_LOGON_NETWORK_CLEARTEXT:
+        break;
+    case LOGON32_LOGON_NEW_CREDENTIALS:
+        /* the caller's own token, with other credentials for the network
+         * only: nothing is checked here (Windows checks them when used) */
+        if (!DuplicateTokenEx( GetCurrentProcessToken(), 0, NULL, SecurityImpersonation, TokenPrimary, phToken ))
+            return FALSE;
+        return TRUE;
+    default:
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!logon_account_name( lpszUsername, lpszDomain, name, ARRAY_SIZE(name) ))
+    {
+        SetLastError( ERROR_LOGON_FAILURE );
+        return FALSE;
+    }
+
+    InitOnceExecuteOnce( &logon_once, logon_init, NULL, NULL );
+    memset( &params, 0, sizeof(params) );
+    params.type = dwLogonType;
+    status = STATUS_NO_LOGON_SERVERS;
+    /* for the gate: a ticket by its name, as if the broker had given it (the
+     * wineserver checks it as any other: its owner, its requester, its age) */
+    if (GetEnvironmentVariableA( "SG_LOGON_TICKET", params.ticket, sizeof(params.ticket) ) &&
+        strlen( params.ticket ) < sizeof(params.ticket) - 1)
+        status = STATUS_SUCCESS;
+    else if (logon_unix_ready &&
+        WideCharToMultiByte( CP_UTF8, 0, name, -1, params.user, sizeof(params.user), NULL, NULL ) &&
+        WideCharToMultiByte( CP_UTF8, 0, lpszPassword ? lpszPassword : L"", -1, params.password,
+                             sizeof(params.password), NULL, NULL ))
+        status = WINE_UNIX_CALL( unix_logon_ticket, &params );
+    SecureZeroMemory( params.password, sizeof(params.password) );
+
+    if (!status) status = logon_ticket_to_token( params.ticket, dwLogonType, &token );
+    else if (status == STATUS_NO_LOGON_SERVERS && logon_ticket_to_token( "", dwLogonType, &token ) == STATUS_NOT_SUPPORTED)
+    {
+        /* not a shared prefix: no broker, and one account */
+        if (GetUserNameW( own, &own_len ) && !wcsicmp( own, name ))
+            return DuplicateTokenEx( GetCurrentProcessToken(), 0, NULL, SecurityImpersonation,
+                                     dwLogonType == LOGON32_LOGON_NETWORK ? TokenImpersonation : TokenPrimary,
+                                     phToken );
+        status = STATUS_LOGON_FAILURE;
+    }
+    if (status)
+    {
+        SetLastError( status == STATUS_NO_LOGON_SERVERS ? ERROR_NO_LOGON_SERVERS :
+                      status == STATUS_UNSUCCESSFUL ? ERROR_LOGON_FAILURE : RtlNtStatusToDosError( status ) );
+        return FALSE;
+    }
+    *phToken = token;
     return TRUE;
 }
 
