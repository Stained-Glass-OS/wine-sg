+#include "cred_unix.h"
+
+static int write_all( int fd, const void *buf, size_t len )
+{
+    const char *p = buf;
+
+    while (len)
+    {
+        ssize_t n = write( fd, p, len );
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return -1;
+        p += n;
+        len -= n;
+    }
+    return 0;
+}
+
+static void wipe( volatile char *p, size_t len )
+{
+    while (len--) *p++ = 0;
+}
+
+/* The broker's request: the directory "@logon", the environment
+ * LOGON_USER, LOGON_PASSWORD and LOGON_TYPE, and an empty string -- no
+ * program (an older broker refuses such a request at once); its length
+ * first. The answer: a status byte (0 logged on, 1
+ * refused), then "TICKET <name>". The password goes over the broker's socket
+ * only: never to the wineserver, a log or a file. */
+NTSTATUS logon_ticket( void *args )
+{
+    struct logon_ticket_params *params = args;
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    const char *path = getenv( "SG_BROKER_SOCK" );
+    char blob[1024], line[64];
+    unsigned char status = 2;
+    uint32_t len;
+    size_t n = 0;
+    int fd, ret;
+
+    params->ticket[0] = 0;
+    if (!path || !*path) path = "/run/stained-glass-broker/broker.sock";
+    if (strlen( path ) >= sizeof(addr.sun_path)) return STATUS_NO_LOGON_SERVERS;
+    strcpy( addr.sun_path, path );
+    params->user[sizeof(params->user) - 1] = 0;
+    params->password[sizeof(params->password) - 1] = 0;
+
+    ret = snprintf( blob, sizeof(blob), "@logon%cLOGON_USER=%s%cLOGON_PASSWORD=%s%cLOGON_TYPE=%u%c",
+                    0, params->user, 0, params->password, 0, params->type, 0 );
+    if (ret < 0 || (size_t)ret + 1 > sizeof(blob)) { wipe( blob, sizeof(blob) ); return STATUS_LOGON_FAILURE; }
+    len = ret + 1;
+
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) < 0)
+    {
+        wipe( blob, sizeof(blob) );
+        return STATUS_NO_LOGON_SERVERS;
+    }
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) < 0)
+    {
+        close( fd );
+        wipe( blob, sizeof(blob) );
+        return STATUS_NO_LOGON_SERVERS;
+    }
+    ret = write_all( fd, &len, sizeof(len) ) || write_all( fd, blob, len );
+    wipe( blob, sizeof(blob) );
+    if (ret) { close( fd ); return STATUS_UNSUCCESSFUL; }
+
+    while ((ret = read( fd, &status, 1 )) < 0 && errno == EINTR) ;
+    if (ret != 1) { close( fd ); return STATUS_UNSUCCESSFUL; }
+    if (status)
+    {
+        close( fd );
+        return status == 1 ? STATUS_LOGON_FAILURE : STATUS_UNSUCCESSFUL;
+    }
+    while (n + 1 < sizeof(line))
+    {
+        char c;
+        ret = read( fd, &c, 1 );
+        if (ret < 0 && errno == EINTR) continue;
+        if (ret <= 0 || c == '\n') break;
+        line[n++] = c;
+    }
+    line[n] = 0;
+    close( fd );
+    if (strncmp( line, "TICKET ", 7 ) || strlen( line + 7 ) != 32) return STATUS_UNSUCCESSFUL;
+    strcpy( params->ticket, line + 7 );
+    return STATUS_SUCCESS;
+}
