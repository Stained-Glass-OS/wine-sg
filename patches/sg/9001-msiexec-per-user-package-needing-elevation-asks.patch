From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msiexec: a per-user package that needs elevation asks for an administrator, as Windows Installer does

Windows Installer asks for an administrator for every install, repair or uninstall unless the
package is installed per user (ALLUSERS empty once ALLUSERS=2 / MSIINSTALLPERUSER are resolved)
AND says elevated privileges are not required (bit 3 of the summary's word count) -- Microsoft's
"Authoring packages without the UAC dialog box" -- and it never asks in silent mode (/qn), where it
cannot. msiexec asked only for an all-users package (0590): Mixxx's and Bespoke Synth's MSIs (WiX,
ALLUSERS unset, bit 3 clear, INSTALLDIR under Program Files) ran as the person and failed with 1603
writing Program Files ("ended prematurely").

Such a package now gets 0590's runas relaunch (the consent prompt, then the install elevated -- the
person's, wine-sg 7601), unless the install is silent. A product code (repair, /x) of the person's
own product is judged by its cached package's word count. All-users packages behave as before
(they are still relaunched in silent mode, as 0590 did).

David 2026-11-23: as Windows Installer does it. Gate test-msineedadmin
(test/msineedadmin-gate.sh, test/msineedadmin.wxs); mutant SG_MUTANT_MSI_PERUSER_NOELEVATE.
QA: Mixxx 2.5.6 on qa5 asks, installs; its uninstall by product code asks and removes it.
---
--- a/programs/msiexec/msiexec.c
+++ b/programs/msiexec/msiexec.c
@@ -689,27 +689,59 @@
     return NULL;
 }
 
-static BOOL package_for_all_users(const WCHAR *package, const WCHAR *properties)
+/* Stained Glass OS 9001: which installs Windows Installer elevates. Every one, unless the package is
+ * installed per user (ALLUSERS empty after resolving ALLUSERS=2 / MSIINSTALLPERUSER) AND says
+ * elevated privileges are not required (the summary's word count, bit 3) -- Microsoft's "Authoring
+ * packages without the UAC dialog box". A per-user package without that bit (Mixxx, Bespoke Synth:
+ * WiX, ALLUSERS unset, INSTALLDIR under Program Files) ran as the person and failed 1603 writing
+ * Program Files. The elevated install is still the person's (wine-sg 7601: their HKCU and profile),
+ * as Windows' elevated per-user install is. As on Windows, a silent install (/qn) of a per-user
+ * package is not asked about (it cannot be: there is no UI) and runs as it is. */
+enum package_elevation { ELEVATION_NONE, ELEVATION_MACHINE, ELEVATION_PER_USER };
+
+static INT package_word_count(MSIHANDLE db)
+{
+    MSIHANDLE suminfo;
+    INT words = 0;
+
+    if (MsiGetSummaryInformationW(db, NULL, 0, &suminfo) == ERROR_SUCCESS)
+    {
+        MsiSummaryInfoGetPropertyW(suminfo, PIDSI_WORDCOUNT, NULL, &words, NULL, NULL, NULL);
+        MsiCloseHandle(suminfo);
+    }
+    return words;
+}
+
+static enum package_elevation package_elevation(const WCHAR *package, const WCHAR *properties)
 {
     WCHAR allusers[16] = L"", peruser[16] = L"";
-    MSIHANDLE db, view, rec, suminfo;
+    MSIHANDLE db, view, rec;
     DWORD len;
     INT words = 0;
 
     if (IsProductCode((WCHAR *)package))
     {
-        WCHAR state[16];
+        WCHAR state[16], local[MAX_PATH];
         len = ARRAY_SIZE(state);
-        return MsiGetProductInfoExW(package, NULL, MSIINSTALLCONTEXT_MACHINE, INSTALLPROPERTY_PRODUCTSTATEW,
-                                    state, &len) == ERROR_SUCCESS;
+        if (MsiGetProductInfoExW(package, NULL, MSIINSTALLCONTEXT_MACHINE, INSTALLPROPERTY_PRODUCTSTATEW,
+                                 state, &len) == ERROR_SUCCESS) return ELEVATION_MACHINE;
+#ifndef SG_MUTANT_MSI_PERUSER_NOELEVATE
+        /* the person's product: its cached package says whether it needs elevation */
+        len = ARRAY_SIZE(local);
+        if (MsiGetProductInfoExW(package, NULL, MSIINSTALLCONTEXT_USERUNMANAGED, INSTALLPROPERTY_LOCALPACKAGEW,
+                                 local, &len) == ERROR_SUCCESS && local[0] &&
+            MsiOpenDatabaseW(local, MSIDBOPEN_READONLY, &db) == ERROR_SUCCESS)
+        {
+            words = package_word_count(db);
+            MsiCloseHandle(db);
+            return (words & 8) ? ELEVATION_NONE : ELEVATION_PER_USER;
+        }
+#endif
+        return ELEVATION_NONE;
     }
-    if (MsiOpenDatabaseW(package, MSIDBOPEN_READONLY, &db) != ERROR_SUCCESS) return FALSE;
+    if (MsiOpenDatabaseW(package, MSIDBOPEN_READONLY, &db) != ERROR_SUCCESS) return ELEVATION_NONE;
     /* a package that says it needs no elevation (the summary's word count, 8) */
-    if (MsiGetSummaryInformationW(db, NULL, 0, &suminfo) == ERROR_SUCCESS)
-    {
-        MsiSummaryInfoGetPropertyW(suminfo, PIDSI_WORDCOUNT, NULL, &words, NULL, NULL, NULL);
-        MsiCloseHandle(suminfo);
-    }
+    words = package_word_count(db);
     if (MsiDatabaseOpenViewW(db, L"SELECT `Property`, `Value` FROM `Property`", &view) == ERROR_SUCCESS)
     {
         MsiViewExecute(view, 0);
@@ -728,11 +760,14 @@
         MsiCloseHandle(view);
     }
     MsiCloseHandle(db);
-    if (words & 8) return FALSE;
     property_value(properties, L"ALLUSERS", allusers, ARRAY_SIZE(allusers));
     property_value(properties, L"MSIINSTALLPERUSER", peruser, ARRAY_SIZE(peruser));
-    if (!wcscmp(allusers, L"1")) return TRUE;
-    return !wcscmp(allusers, L"2") && wcscmp(peruser, L"1");
+    if (!wcscmp(allusers, L"1") || (!wcscmp(allusers, L"2") && wcscmp(peruser, L"1")))
+        return (words & 8) ? ELEVATION_NONE : ELEVATION_MACHINE;   /* for all users (as before 9001) */
+#ifdef SG_MUTANT_MSI_PERUSER_NOELEVATE
+    return ELEVATION_NONE;
+#endif
+    return (words & 8) ? ELEVATION_NONE : ELEVATION_PER_USER;
 }
 
 /* the marker is this process's alone: taken out at once, so that nothing it starts (a custom action's
@@ -1230,8 +1265,14 @@
 	 * elevation could not be had (no consent broker, a token that cannot be used), each one started
 	 * the next, without end */
 	if ((FunctionInstall || FunctionRepair) && !FunctionInstallAdmin && package_unquoted &&
-	    !process_elevated() && !was_relaunched && package_for_all_users(package_unquoted, Properties))
-		ExitProcess(run_elevated());
+	    !process_elevated() && !was_relaunched)
+	{
+		enum package_elevation need = package_elevation(package_unquoted, Properties);
+
+		if (need == ELEVATION_MACHINE ||
+		    (need == ELEVATION_PER_USER && (InstallUILevel & 7) != INSTALLUILEVEL_NONE))
+			ExitProcess(run_elevated());
+	}
 
 	ReturnCode = 1;
 	if(FunctionInstall)
