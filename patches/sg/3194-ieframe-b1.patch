+/* The search page of the current user: IE keeps it in the Main key, machine default as fallback. */
+HRESULT go_search(DocHost *This)
+{
+    WCHAR page[INTERNET_MAX_URL_LENGTH];
+    HKEY roots[] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE };
+    unsigned int i;
+
+    for(i = 0; i < ARRAY_SIZE(roots); i++) {
+        DWORD type, size = sizeof(page) - sizeof(WCHAR);
+        HKEY hkey;
+        LONG res;
+
+        if(RegOpenKeyW(roots[i], L"Software\\Microsoft\\Internet Explorer\\Main", &hkey) != ERROR_SUCCESS)
+            continue;
+        res = RegQueryValueExW(hkey, L"Search Page", NULL, &type, (BYTE*)page, &size);
+        RegCloseKey(hkey);
+        if(res == ERROR_SUCCESS && type == REG_SZ && page[0]) {
+            page[size / sizeof(WCHAR)] = 0;
+            return navigate_url(This, page, NULL, NULL, NULL, NULL);
+        }
+    }
+    return navigate_url(This, L"about:blank", NULL, NULL, NULL, NULL);
+}
+
+/* The user type name of the hosted document object (IWebBrowser::Type). */
+HRESULT get_document_type(DocHost *This, BSTR *ret)
+{
+    IOleObject *oleobj;
+    WCHAR *name = NULL;
+    HRESULT hres = S_OK;
+
+    if(!ret)
+        return E_POINTER;
+    *ret = NULL;
+
+    if(This->document && SUCCEEDED(IUnknown_QueryInterface(This->document, &IID_IOleObject, (void**)&oleobj))) {
+        hres = IOleObject_GetUserType(oleobj, USERCLASSTYPE_FULL, &name);
+        IOleObject_Release(oleobj);
+    }
+    if(FAILED(hres))
+        return hres;
+
+    *ret = SysAllocString(name ? name : L"");
+    CoTaskMemFree(name);
+    return *ret ? S_OK : E_OUTOFMEMORY;
+}
+
+/* The moniker of the hosted document: its URL names both the container and the object. */
+HRESULT get_dochost_moniker(DocHost *This, DWORD assign, DWORD which, IMoniker **ppmk)
+{
+    if(!ppmk)
+        return E_POINTER;
+    *ppmk = NULL;
+
+    if(which == OLEWHICHMK_OBJREL)
+        return E_FAIL; /* the document is not a linked or embedded object of a container document */
+
+    if(!This->url || !*This->url)
+        return assign == OLEGETMONIKER_ONLYIFTHERE ? E_FAIL : MK_E_UNAVAILABLE;
