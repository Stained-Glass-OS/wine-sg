 WINE_DEFAULT_DEBUG_CHANNEL(ieframe);
 
+#define PERSIST_MAGIC 0x31425753 /* "SWB1" */
+#define PERSIST_STREAM L"\003WebBrowser"
+
+/* What of the control is kept when its container saves it: the extent and the user visible flags.
+ * Data written by other implementations is accepted but not interpreted. */
+static void get_persist_data(WebBrowser *This, struct persist_data *data)
+{
+    memset(data, 0, sizeof(*data));
+    data->magic = PERSIST_MAGIC;
+    data->size = sizeof(*data);
+    data->cx = This->extent.cx;
+    data->cy = This->extent.cy;
+    data->bools[0] = This->register_browser;
+    data->bools[1] = This->register_droptarget;
+    data->bools[2] = This->visible;
+    data->bools[3] = This->menu_bar;
+    data->bools[4] = This->address_bar;
+    data->bools[5] = This->status_bar;
+    data->bools[6] = This->tool_bar;
+    data->bools[7] = This->full_screen;
+    data->bools[8] = This->theater_mode;
+    data->bools[9] = This->doc_host.offline;
+    data->bools[10] = This->doc_host.silent;
+}
+
+static HRESULT load_persist_data(WebBrowser *This, const void *mem, SIZE_T size)
+{
+    const struct persist_data *data = mem;
+
+    if(size >= sizeof(*data) && data->magic == PERSIST_MAGIC && data->size == sizeof(*data)) {
+        This->extent.cx = data->cx;
+        This->extent.cy = data->cy;
+        This->register_browser = data->bools[0];
+        This->register_droptarget = data->bools[1];
+        This->visible = data->bools[2];
+        This->menu_bar = data->bools[3];
+        This->address_bar = data->bools[4];
+        This->status_bar = data->bools[5];
+        This->tool_bar = data->bools[6];
+        This->full_screen = data->bools[7];
+        This->theater_mode = data->bools[8];
+        This->doc_host.offline = data->bools[9];
+        This->doc_host.silent = data->bools[10];
+    }
+    get_persist_data(This, &This->persist_saved);
+    return S_OK;
+}
+
+static HRESULT persist_is_dirty(WebBrowser *This)
+{
+    struct persist_data data;
+
+    get_persist_data(This, &data);
+#ifdef SG_MUTANT_IEFRAME_NOPERSIST
+    return S_FALSE;
+#endif
+    return memcmp(&data, &This->persist_saved, sizeof(data)) ? S_OK : S_FALSE;
+}
+
+static HRESULT persist_save_memory(WebBrowser *This, void *mem, BOOL clear_dirty, SIZE_T size)
+{
+    struct persist_data data;
+
+    if(!mem)
+        return E_POINTER;
+    if(size < sizeof(data))
+        return E_INVALIDARG;
+
+    get_persist_data(This, &data);
+    memcpy(mem, &data, sizeof(data));
+    if(clear_dirty)
+        This->persist_saved = data;
+    return S_OK;
+}
+
