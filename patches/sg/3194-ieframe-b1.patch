 static HRESULT WINAPI ControlSite_TransformCoords(IOleControlSite *iface, POINTL *pPtlHimetric,
                                                   POINTF *pPtfContainer, DWORD dwFlags)
 {
     DocHost *This = impl_from_IOleControlSite(iface);
-    FIXME("(%p)->(%p, %p, %08lx)\n", This, pPtlHimetric, pPtfContainer, dwFlags);
-    return E_NOTIMPL;
+    IOleControlSite *site;
+    HRESULT hres = E_NOTIMPL;
+    HDC hdc;
+    int dpix, dpiy;
+
+    TRACE("(%p)->(%p, %p, %08lx)\n", This, pPtlHimetric, pPtfContainer, dwFlags);
+
+    if(!pPtlHimetric || !pPtfContainer)
+        return E_POINTER;
+
+    if((site = get_wb_control_site(This))) {
+        hres = IOleControlSite_TransformCoords(site, pPtlHimetric, pPtfContainer, dwFlags);
+        IOleControlSite_Release(site);
+        if(hres != E_NOTIMPL)
+            return hres;
+    }
+
+    /* the container units are pixels */
+    hdc = GetDC(NULL);
+    dpix = GetDeviceCaps(hdc, LOGPIXELSX);
+    dpiy = GetDeviceCaps(hdc, LOGPIXELSY);
+    ReleaseDC(NULL, hdc);
+
+    if(dwFlags & XFORMCOORDS_HIMETRICTOCONTAINER) {
+        pPtfContainer->x = (float)pPtlHimetric->x * dpix / 2540.0f;
+        pPtfContainer->y = (float)pPtlHimetric->y * dpiy / 2540.0f;
+    }else if(dwFlags & XFORMCOORDS_CONTAINERTOHIMETRIC) {
+        pPtlHimetric->x = (LONG)(pPtfContainer->x * 2540.0f / dpix + (pPtfContainer->x < 0 ? -0.5f : 0.5f));
+        pPtlHimetric->y = (LONG)(pPtfContainer->y * 2540.0f / dpiy + (pPtfContainer->y < 0 ? -0.5f : 0.5f));
+    }else {
+        return E_INVALIDARG;
+    }
+    return S_OK;
 }
 
