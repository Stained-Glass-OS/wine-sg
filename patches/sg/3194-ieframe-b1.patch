         if(This->sinks[i])
             IDispatch_Invoke(This->sinks[i], dispid, &IID_NULL, LOCALE_SYSTEM_DEFAULT,
@@ -647,7 +668,7 @@ void fire_new_window(ConnectionPoint *This, DWORD flags, const WCHAR *context_ur
