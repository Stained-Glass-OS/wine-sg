+}
+
+static HRESULT tf_get_src(HlinkFrame *This, WCHAR **ret)
+{
+    const WCHAR *url = This->doc_host->url ? This->doc_host->url : L"";
+
+    if(!ret)
+        return E_POINTER;
+    *ret = CoTaskMemAlloc((wcslen(url) + 1) * sizeof(WCHAR));
+    if(!*ret)
+        return E_OUTOFMEMORY;
+    wcscpy(*ret, url);
+    return S_OK;
+}
+
+static HRESULT tf_get_container(HlinkFrame *This, IOleContainer **ret)
+{
+    if(!ret)
