+/* Frame description shared by ITargetFrame and ITargetFrame2: the frame is the top level window of
+ * the hosted document, its name is the name of that window. */
+static HRESULT tf_set_name(HlinkFrame *This, const WCHAR *name)
+{
+    IHTMLWindow2 *window;
+    BSTR str;
+    HRESULT hres;
+
+    hres = get_window(This->doc_host, &window);
+    if(FAILED(hres))
+        return hres;
+    if(!window)
+        return E_FAIL; /* nothing is loaded */
+
+    str = SysAllocString(name ? name : L"");
+    hres = str ? IHTMLWindow2_put_name(window, str) : E_OUTOFMEMORY;
+    SysFreeString(str);
+    IHTMLWindow2_Release(window);
+    return hres;
+}
+
+static HRESULT tf_get_name(HlinkFrame *This, WCHAR **ret)
+{
+    IHTMLWindow2 *window;
+    BSTR name = NULL;
+    HRESULT hres;
+
+    if(!ret)
+        return E_POINTER;
+    *ret = NULL;
+
+    hres = get_window(This->doc_host, &window);
+    if(FAILED(hres) || !window)
+        return hres;
+    hres = IHTMLWindow2_get_name(window, &name);
+    IHTMLWindow2_Release(window);
+    if(FAILED(hres))
+        return hres;
+
+    if(name && *name) {
+        *ret = CoTaskMemAlloc((wcslen(name) + 1) * sizeof(WCHAR));
+        if(*ret)
+            wcscpy(*ret, name);
+        else
+            hres = E_OUTOFMEMORY;
+    }
+    SysFreeString(name);
+    return hres;
+}
+
+static HRESULT tf_get_parent(HlinkFrame *This, IUnknown **ret)
+{
+    if(!ret)
+        return E_POINTER;
+    *ret = NULL; /* the frame of a browser is a top level frame */
+    return S_OK;
+}
+
+static HRESULT tf_set_src(HlinkFrame *This, const WCHAR *src)
+{
+    if(!src)
+        return E_INVALIDARG;
