+    if(!enumerator)
+        return E_OUTOFMEMORY;
+    enumerator->IEnumSTATURL_iface.lpVtbl = &EnumStatUrlVtbl;
+    enumerator->ref = 1;
+    enumerator->count = count;
+    if(count && !(enumerator->items = calloc(count, sizeof(*items)))) {
+        free(enumerator);
+        return E_OUTOFMEMORY;
+    }
+    for(i = 0; i < count; i++) {
+        enumerator->items[i] = items[i];
+        enumerator->items[i].pwcsUrl = items[i].pwcsUrl ? co_strdup(items[i].pwcsUrl) : NULL;
+        enumerator->items[i].pwcsTitle = items[i].pwcsTitle ? co_strdup(items[i].pwcsTitle) : NULL;
+    }
+    *ret = &enumerator->IEnumSTATURL_iface;
