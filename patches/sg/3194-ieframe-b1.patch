+void freeze_events(ConnectionPointContainer *cps, BOOL freeze)
+{
+    ConnectionPoint *cp[] = { cps->wbe2, cps->wbe, cps->pns };
+    unsigned int i;
+
+    for(i = 0; i < ARRAY_SIZE(cp); i++) {
+        if(!cp[i])
+            continue;
+        if(freeze)
+            cp[i]->frozen++;
+        else if(cp[i]->frozen > 0)
+            cp[i]->frozen--;
+    }
+}
+
 void call_sink(ConnectionPoint *This, DISPID dispid, DISPPARAMS *dispparams)
 {
     DWORD i;
 
+    /* a frozen control discards its events */
+    if(This->frozen > 0)
+        return;
+
