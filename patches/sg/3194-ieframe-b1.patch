+/* The container of the WebBrowser control, if this DocHost belongs to one. */
+static IOleClientSite *get_wb_client_site(DocHost *This)
+{
+    IOleClientSite *client = NULL;
+    IOleObject *wb_obj;
+
+    if(This->wb && SUCCEEDED(IWebBrowser2_QueryInterface(This->wb, &IID_IOleObject, (void**)&wb_obj))) {
+        if(FAILED(IOleObject_GetClientSite(wb_obj, &client)))
+            client = NULL;
+        IOleObject_Release(wb_obj);
+    }
+    return client;
+}
+
+static IOleControlSite *get_wb_control_site(DocHost *This)
+{
+    IOleControlSite *site = NULL;
+    IOleClientSite *client = get_wb_client_site(This);
+
+    if(client) {
+        if(FAILED(IOleClientSite_QueryInterface(client, &IID_IOleControlSite, (void**)&site)))
+            site = NULL;
+        IOleClientSite_Release(client);
+    }
+    return site;
+}
+
+/* The document view fills the document window: lay it out again after the site was resized. */
+static void relayout_view(DocHost *This)
+{
+    RECT rect;
+
+    if(!This->view || !This->hwnd)
+        return;
+    GetClientRect(This->hwnd, &rect);
+    IOleDocumentView_SetRect(This->view, &rect);
+}
+
