+    ULONG n = 0;
+
+    TRACE("(%p)->(%lu %p %p)\n", This, celt, rgelt, fetched);
+
+    if(!rgelt)
+        return E_INVALIDARG;
+
+    while(n < celt && This->pos < This->count) {
+        STATURL *src = This->items + This->pos++;
+
+        *rgelt = *src;
+        rgelt->pwcsUrl = src->pwcsUrl ? co_strdup(src->pwcsUrl) : NULL;
+        rgelt->pwcsTitle = src->pwcsTitle ? co_strdup(src->pwcsTitle) : NULL;
+        rgelt++;
+        n++;
+    }
+    if(fetched)
+        *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
