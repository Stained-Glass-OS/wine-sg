+/* The history is the History container of the URL cache; its entries are named "Visited: user@url".
+ * The title of a page is kept in the header information of the entry. */
+static WCHAR *history_key(const WCHAR *url)
+{
+    WCHAR user[UNLEN + 1], *key;
+    DWORD len = ARRAY_SIZE(user);
+
+    if(!GetUserNameW(user, &len))
+        wcscpy(user, L"user");
+    key = malloc((9 + wcslen(user) + 1 + wcslen(url) + 1) * sizeof(WCHAR));
+    if(key)
+        swprintf(key, 9 + wcslen(user) + 1 + wcslen(url) + 1, L"Visited: %s@%s", user, url);
+    return key;
+}
+
+static const WCHAR *history_entry_url(const WCHAR *name)
+{
+    const WCHAR *at;
+
+    if(wcsnicmp(name, L"Visited:", 8))
+        return NULL;
+    at = wcschr(name + 8, '@');
+    return at ? at + 1 : NULL;
+}
+
+static WCHAR *co_strdup(const WCHAR *str)
+{
+    WCHAR *ret = CoTaskMemAlloc((wcslen(str) + 1) * sizeof(WCHAR));
+    if(ret)
+        wcscpy(ret, str);
+    return ret;
+}
+
+static HRESULT add_history_url(const WCHAR *url, const WCHAR *title)
+{
+    FILETIME zero = {0}, now;
+    WCHAR *key;
+    BOOL ret;
+
+    if(!url || !*url)
+        return E_INVALIDARG;
+#ifdef SG_MUTANT_IEFRAME_NOHIST
+    return S_OK;
+#endif
+    if(!(key = history_key(url)))
+        return E_OUTOFMEMORY;
+
+    GetSystemTimeAsFileTime(&now);
+
+    /* an existing entry is replaced */
+    DeleteUrlCacheEntryW(key);
+    ret = CommitUrlCacheEntryW(key, NULL, zero, now, URLHISTORY_CACHE_ENTRY,
+                               (WCHAR*)title, title ? wcslen(title) : 0, NULL, NULL);
+    free(key);
+    return ret ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+}
+
