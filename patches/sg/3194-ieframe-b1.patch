+    return ret ? S_OK : E_FAIL;
+}
+
+static HRESULT fill_staturl(const INTERNET_CACHE_ENTRY_INFOW *info, const WCHAR *url, DWORD flags,
+        STATURL *stat)
+{
+    memset(stat, 0, sizeof(*stat));
+    stat->cbSize = sizeof(*stat);
+    if(!(flags & STATURL_QUERYFLAG_NOURL)) {
+        if(!(stat->pwcsUrl = co_strdup(url)))
+            return E_OUTOFMEMORY;
+    }
+    if(!(flags & STATURL_QUERYFLAG_NOTITLE) && info->lpHeaderInfo && *(const WCHAR *)info->lpHeaderInfo) {
+        /* the wide version of the entry returns the header information as a wide string */
+        if(!(stat->pwcsTitle = co_strdup((const WCHAR *)info->lpHeaderInfo))) {
+            CoTaskMemFree(stat->pwcsUrl);
+            return E_OUTOFMEMORY;
+        }
+    }
+    stat->ftLastVisited = info->LastAccessTime;
+    stat->ftLastUpdated = info->LastModifiedTime;
+    stat->ftExpires = info->ExpireTime;
+    stat->dwFlags = STATURLFLAG_ISTOPLEVEL;
+    return S_OK;
 }
 
