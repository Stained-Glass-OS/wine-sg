From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a Vulkan glass popup keeps its see-through edge under the compositor

Firefox's menus on a GPU (WebRender through DXVK) and Chromium's bubbles
are glass popups presented with Vulkan; winex11 blends each frame over
the backdrop the popup's process took (0615) and puts it opaque. With
the desktop's compositor, sg-deskcomp, running there is no backdrop
(0611 takes none: the compositor blends real alpha) -- and the frame was
blended over nothing, its see-through edge and shadow opaque black
(David 2026-10-01, field report item 13: Firefox's menus had a black
border). With no backdrop and a popup window with alpha (depth 32, 0435)
the frame is now put as it is, for the compositor to blend.

Gates: test/glasspixel-gate.sh (glass_pixel() from the tree; mutant
SG_MUTANT_GLASS_VK_BLACK fails it), test/glassvk-gate.sh (the popup's X
window has alpha).
---
--- a/dlls/winex11.drv/vulkan.c
+++ b/dlls/winex11.drv/vulkan.c
@@ -93,6 +93,27 @@
     return NtUserGetProp( hwnd, glassW ) != NULL;
 }
 
+/* one pixel of a glass popup's frame (premultiplied ARGB), put into its X
+ * window: blended over the backdrop and opaque -- or, with no backdrop (the
+ * desktop's compositor, sg-deskcomp, is running: winex11 takes none) and a
+ * window with alpha, as it is, for the compositor to blend. Blended over
+ * nothing, the frame's see-through edge was black (David 2026-10-01: Firefox's
+ * menus had a black border). */
+static inline DWORD glass_pixel( DWORD p, const DWORD *under, BOOL keep_alpha )
+{
+    DWORD a = p >> 24, b = under ? *under : 0, r, g, bl;
+
+    if (a == 0xff) return p;
+#ifndef SG_MUTANT_GLASS_VK_BLACK
+    if (!under && keep_alpha) return p;
+#endif
+    /* premultiplied: out = src + under * (1 - alpha) */
+    r = min( 255, ((p >> 16) & 0xff) + ((b >> 16) & 0xff) * (255 - a) / 255 );
+    g = min( 255, ((p >> 8) & 0xff) + ((b >> 8) & 0xff) * (255 - a) / 255 );
+    bl = min( 255, (p & 0xff) + (b & 0xff) * (255 - a) / 255 );
+    return 0xff000000 | (r << 16) | (g << 8) | bl;
+}
+
 static int blend_error( Display *display, XErrorEvent *event, void *arg )
 {
     return 1;
@@ -143,19 +164,7 @@
     {
         const DWORD *s = (const DWORD *)(src->data + y * src->bytes_per_line);
         const DWORD *u = under ? (const DWORD *)(under->data + y * under->bytes_per_line) : NULL;
-        for (x = 0; x < width; x++)
-        {
-            DWORD p = s[x], a = p >> 24, b = u ? u[x] : 0;
-            if (a == 0xff) buf[y * width + x] = p;
-            else
-            {
-                /* premultiplied: out = src + under * (1 - alpha) */
-                DWORD r = min( 255, ((p >> 16) & 0xff) + ((b >> 16) & 0xff) * (255 - a) / 255 );
-                DWORD g = min( 255, ((p >> 8) & 0xff) + ((b >> 8) & 0xff) * (255 - a) / 255 );
-                DWORD bl = min( 255, (p & 0xff) + (b & 0xff) * (255 - a) / 255 );
-                buf[y * width + x] = 0xff000000 | (r << 16) | (g << 8) | bl;
-            }
-        }
+        for (x = 0; x < width; x++) buf[y * width + x] = glass_pixel( s[x], u ? &u[x] : NULL, depth == 32 );
     }
     XDestroyImage( src );
     if (under) XDestroyImage( under );
