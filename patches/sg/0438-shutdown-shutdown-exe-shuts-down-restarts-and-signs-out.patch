  * modify it under the terms of the GNU Lesser General Public
@@ -16,18 +17,106 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
+#include <stdio.h>
+#include <stdlib.h>
+#include <wchar.h>
+#include <windef.h>
+#include <winbase.h>
+#include <winternl.h>
+#include <winuser.h>
+#include <reason.h>
+#include <powrprof.h>
+
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(shutdown);
 
-int __cdecl wmain(int argc, WCHAR *argv[])
+static void usage( void )
+{
+    fputs( "Usage: shutdown [/s | /r | /p | /l | /h | /a] [/f] [/t xxx] [/c \"comment\"] [/d [p|u:]xx:yy]\n"
+           "  /s  shut down the computer        /r  restart it\n"
+           "  /p  turn it off now (no delay)    /l  sign out\n"
+           "  /h  hibernate                     /a  abort a pending shutdown\n"
+           "  /f  force programs to close       /t  delay in seconds (0-315360000)\n"
+           "  /c  comment                       /d  reason\n", stdout );
+}
+
+static BOOL is_switch( const WCHAR *arg, WCHAR c )
 {
+    return (arg[0] == '/' || arg[0] == '-') && towlower( arg[1] ) == c && !arg[2];
+}
+
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    enum { NONE, SHUTDOWN, RESTART, POWEROFF, LOGOFF, HIBERNATE, ABORT } action = NONE;
+    DWORD delay = 30, reason = SHTDN_REASON_MAJOR_OTHER | SHTDN_REASON_FLAG_PLANNED;
+    BOOL force = FALSE, delay_given = FALSE;
+    const WCHAR *comment = NULL;
+    UINT flags;
     int i;
 
-    WINE_FIXME("stub:");
-    for (i = 0; i < argc; i++)
-        WINE_FIXME(" %s", wine_dbgstr_w(argv[i]));
-    WINE_FIXME("\n");
+    for (i = 1; i < argc; i++)
+    {
+        if (is_switch( argv[i], 's' )) action = SHUTDOWN;
+        else if (is_switch( argv[i], 'r' ) || is_switch( argv[i], 'g' )) action = RESTART;
+        else if (is_switch( argv[i], 'p' )) action = POWEROFF;
+        else if (is_switch( argv[i], 'l' )) action = LOGOFF;
+        else if (is_switch( argv[i], 'h' )) action = HIBERNATE;
+        else if (is_switch( argv[i], 'a' )) action = ABORT;
+        else if (is_switch( argv[i], 'f' )) force = TRUE;
+        else if (is_switch( argv[i], 't' ) && i + 1 < argc)
+        {
+            delay = wcstoul( argv[++i], NULL, 10 );
+            delay_given = TRUE;
+            if (delay > 0) force = TRUE;    /* as on Windows: a delay implies /f */
+        }
+        else if (is_switch( argv[i], 'c' ) && i + 1 < argc) comment = argv[++i];
+        else if (is_switch( argv[i], 'd' ) && i + 1 < argc) i++;
+        else if (is_switch( argv[i], 'm' ) && i + 1 < argc)
+        {
+            WINE_FIXME( "remote computers are not supported: %s\n", wine_dbgstr_w(argv[i + 1]) );
+            return ERROR_NOT_SUPPORTED;
+        }
+        else if (is_switch( argv[i], '?' )) { usage(); return 0; }
+        else if (is_switch( argv[i], 'i' ) || is_switch( argv[i], 'e' ) || is_switch( argv[i], 'o' ) ||
+                 is_switch( argv[i], 'x' ) || is_switch( argv[i], 'y' ))
+            WINE_FIXME( "ignoring %s\n", wine_dbgstr_w(argv[i]) );
+        else
+        {
+            fprintf( stderr, "shutdown: invalid argument %ls\n", argv[i] );
+            usage();
+            return ERROR_INVALID_PARAMETER;
+        }
+    }
+
+    switch (action)
+    {
+    case NONE:
+        usage();
+        return 0;
+    case ABORT:
+        /* delays run in this process: there is nothing pending elsewhere */
+        fputs( "Unable to abort the system shutdown because no shutdown was in progress.(1116)\n", stderr );
+        return ERROR_NO_SHUTDOWN_IN_PROGRESS;
+    case HIBERNATE:
+        return SetSuspendState( TRUE, FALSE, FALSE ) ? 0 : GetLastError();
+    case LOGOFF:
+        if (delay_given && delay) WINE_FIXME( "/l takes no delay\n" );
+        return ExitWindowsEx( EWX_LOGOFF | (force ? EWX_FORCE : 0), reason ) ? 0 : GetLastError();
+    case POWEROFF:
+        delay = 0;
+        break;
+    default:
+        break;
+    }
 
-    return 0;
+    if (comment) printf( "%ls\n", comment );
+    if (delay)
+    {
+        TRACE( "waiting %lu s\n", delay );
+        Sleep( delay * 1000 );
+    }
+    flags = action == RESTART ? EWX_REBOOT : EWX_POWEROFF;
+    if (force) flags |= EWX_FORCE;
+    return ExitWindowsEx( flags, reason ) ? 0 : GetLastError();
 }
