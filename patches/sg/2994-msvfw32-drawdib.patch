From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvfw32: DrawDibStart/Stop, ChangePalette, GetBuffer, Time, ProfileDisplay

DrawDibStart/DrawDibStop check the handle (FALSE for an unknown one) and keep
the started state and rate. DrawDibChangePalette animates the palette set with
DrawDibSetPalette and updates the colour table of the buffered DIB (FALSE without
a palette, entries or a valid handle). DrawDibGetBuffer returns the
decompression buffer (and copies its format) once DrawDibBegin was called, NULL
otherwise. DrawDibTime reports the counters kept by DrawDibDraw (draw count,
draw/decompress/stretch/blt/SetDIBits milliseconds). DrawDibProfileDisplay asks
the display whether it stretches DIBs natively. DrawDibRealize no longer logs.
---
diff --git a/dlls/msvfw32/drawdib.c b/dlls/msvfw32/drawdib.c
index 0acb1c3..aa3baff 100644
--- a/dlls/msvfw32/drawdib.c
+++ b/dlls/msvfw32/drawdib.c
@@ -50,6 +50,9 @@ typedef struct tagWINE_HDD {
     HBITMAP             hDib;		/* DibSection */
     LPVOID              lpvbits;	/* Buffer for holding decompressed dib */
     HDRAWDIB            hSelf;
+    BOOL                started;	/* DrawDibStart has been called */
+    DWORD               rate;		/* Playback rate given to DrawDibStart */
+    DRAWDIBTIME         time;		/* Timings reported by DrawDibTime */
     struct tagWINE_HDD* next;
 } WINE_HDD;
 
@@ -316,12 +319,16 @@ BOOL VFWAPI DrawDibDraw(HDRAWDIB hdd, HDC hdc,
     BOOL ret;
     int reopen = 0;
 
+    DWORD tick_start, tick;
+
     TRACE("(%p,%p,%d,%d,%d,%d,%p,%p,%d,%d,%d,%d,0x%08x)\n",
           hdd, hdc, xDst, yDst, dxDst, dyDst, lpbi, lpBits, xSrc, ySrc, dxSrc, dySrc, wFlags);
 
     whdd = MSVIDEO_GetHddPtr(hdd);
     if (!whdd) return FALSE;
 
+    tick_start = GetTickCount();
+
     TRACE("whdd=%p\n", whdd);
 
     if (wFlags & ~(DDF_SAME_HDC | DDF_SAME_DRAW | DDF_NOTKEYFRAME | DDF_UPDATE | DDF_DONTDRAW | DDF_BACKGROUNDPAL))
@@ -386,13 +393,17 @@ BOOL VFWAPI DrawDibDraw(HDRAWDIB hdd, HDC hdc,
             if (wFlags & DDF_NOTKEYFRAME)
                 flags |= ICDECOMPRESS_NOTKEYFRAME;
 
+            tick = GetTickCount();
             ICDecompress(whdd->hic, flags, lpbi, lpBits, whdd->lpbiOut, whdd->lpvbits);
+            whdd->time.timeDecompress += GetTickCount() - tick;
         }
         else
         {
             /* BI_RGB: lpbi->biSizeImage isn't reliable */
             DWORD biSizeImage = ((lpbi->biWidth * lpbi->biBitCount + 31) / 32) * 4 * lpbi->biHeight;
+            tick = GetTickCount();
             memcpy(whdd->lpvbits, lpBits, biSizeImage);
+            whdd->time.timeSetDIBits += GetTickCount() - tick;
         }
     }
     if (!(wFlags & DDF_DONTDRAW) && whdd->hpal)
@@ -403,7 +414,12 @@ BOOL VFWAPI DrawDibDraw(HDRAWDIB hdd, HDC hdc,
          SelectPalette(hdc, whdd->hpal, FALSE);
     }
 
+    tick = GetTickCount();
     ret = StretchBlt(whdd->hdc, xDst, yDst, dxDst, dyDst, whdd->hMemDC, xSrc, ySrc, dxSrc, dySrc, SRCCOPY);
+    whdd->time.timeBlt += GetTickCount() - tick;
+    if (dxDst != dxSrc || dyDst != dySrc) whdd->time.timeStretch += GetTickCount() - tick;
+    whdd->time.timeCount++;
+    whdd->time.timeDraw += GetTickCount() - tick_start;
     TRACE("Painting %dx%d at %d,%d from %dx%d at %d,%d -> %d\n",
           dxDst, dyDst, xDst, yDst, dxSrc, dySrc, xSrc, ySrc, ret);
 
@@ -413,17 +429,34 @@ BOOL VFWAPI DrawDibDraw(HDRAWDIB hdd, HDC hdc,
 /*************************************************************************
  *		DrawDibStart		[MSVFW32.@]
  */
-BOOL VFWAPI DrawDibStart(HDRAWDIB hdd, DWORD rate) {
-	FIXME("(%p, %ld), stub\n", hdd, rate);
-	return TRUE;
+BOOL VFWAPI DrawDibStart(HDRAWDIB hdd, DWORD rate)
+{
+    WINE_HDD *whdd = MSVIDEO_GetHddPtr(hdd);
+
+    TRACE("(%p, %ld)\n", hdd, rate);
+
+#ifndef SG_MUTANT_VFW_START
+    if (!whdd) return FALSE;
+#endif
+
+    whdd->started = TRUE;
+    whdd->rate = rate;
+    return TRUE;
 }
 
 /*************************************************************************
  *		DrawDibStop		[MSVFW32.@]
  */
-BOOL VFWAPI DrawDibStop(HDRAWDIB hdd) {
-	FIXME("(%p), stub\n", hdd);
-	return TRUE;
+BOOL VFWAPI DrawDibStop(HDRAWDIB hdd)
+{
+    WINE_HDD *whdd = MSVIDEO_GetHddPtr(hdd);
+
+    TRACE("(%p)\n", hdd);
+
+    if (!whdd) return FALSE;
+
+    whdd->started = FALSE;
+    return TRUE;
 }
 
 /***********************************************************************
@@ -431,7 +464,34 @@ BOOL VFWAPI DrawDibStop(HDRAWDIB hdd) {
  */
 BOOL VFWAPI DrawDibChangePalette(HDRAWDIB hdd, int iStart, int iLen, LPPALETTEENTRY lppe)
 {
-    FIXME("(%p, 0x%08x, 0x%08x, %p), stub\n", hdd, iStart, iLen, lppe);
+    WINE_HDD *whdd = MSVIDEO_GetHddPtr(hdd);
+
+    TRACE("(%p, %d, %d, %p)\n", hdd, iStart, iLen, lppe);
+
+#ifdef SG_MUTANT_VFW_PALETTE
+    return TRUE;
+#endif
+    if (!whdd || !lppe || iStart < 0 || iLen < 0 || !whdd->hpal) return FALSE;
+
+    if (iLen) AnimatePalette(whdd->hpal, iStart, iLen, lppe);
+
+    /* Keep the buffered DIB's colour table in step with the palette. */
+    if (whdd->begun && whdd->hMemDC && whdd->lpbiOut && whdd->lpbiOut->biBitCount <= 8 && iLen)
+    {
+        RGBQUAD colors[256];
+        int i;
+
+        iLen = min(iLen, 256 - min(iStart, 256));
+        for (i = 0; i < iLen; i++)
+        {
+            colors[i].rgbRed = lppe[i].peRed;
+            colors[i].rgbGreen = lppe[i].peGreen;
+            colors[i].rgbBlue = lppe[i].peBlue;
+            colors[i].rgbReserved = 0;
+        }
+        if (iLen > 0) SetDIBColorTable(whdd->hMemDC, iStart, iLen, colors);
+    }
+
     return TRUE;
 }
 
@@ -463,8 +523,23 @@ BOOL VFWAPI DrawDibSetPalette(HDRAWDIB hdd, HPALETTE hpal)
  */
 LPVOID VFWAPI DrawDibGetBuffer(HDRAWDIB hdd, LPBITMAPINFOHEADER lpbi, DWORD dwSize, DWORD dwFlags)
 {
-    FIXME("(%p, %p, 0x%08lx, 0x%08lx), stub\n", hdd, lpbi, dwSize, dwFlags);
+    WINE_HDD *whdd = MSVIDEO_GetHddPtr(hdd);
+
+    TRACE("(%p, %p, 0x%08lx, 0x%08lx)\n", hdd, lpbi, dwSize, dwFlags);
+
+    /* The buffer only exists once DrawDibBegin() has been called. */
+    if (!whdd || !whdd->begun || !whdd->lpbiOut) return NULL;
+
+    if (lpbi && dwSize >= sizeof(BITMAPINFOHEADER))
+    {
+        DWORD size = whdd->lpbiOut->biSize + num_colours(whdd->lpbiOut) * sizeof(RGBQUAD);
+        memcpy(lpbi, whdd->lpbiOut, min(size, dwSize));
+    }
+
+#ifdef SG_MUTANT_VFW_BUFFER
     return NULL;
+#endif
+    return whdd->lpvbits;
 }
 
 /***********************************************************************
@@ -490,7 +565,7 @@ UINT VFWAPI DrawDibRealize(HDRAWDIB hdd, HDC hdc, BOOL fBackground)
     WINE_HDD *whdd;
     UINT ret = 0;
 
-    FIXME("(%p, %p, %d), stub\n", hdd, hdc, fBackground);
+    TRACE("(%p, %p, %d)\n", hdd, hdc, fBackground);
 
     whdd = MSVIDEO_GetHddPtr(hdd);
     if (!whdd) return FALSE;
@@ -517,8 +592,16 @@ UINT VFWAPI DrawDibRealize(HDRAWDIB hdd, HDC hdc, BOOL fBackground)
  */
 BOOL VFWAPI DrawDibTime(HDRAWDIB hdd, LPDRAWDIBTIME lpddtime)
 {
-    FIXME("(%p, %p) stub\n", hdd, lpddtime);
-    return FALSE;
+    WINE_HDD *whdd = MSVIDEO_GetHddPtr(hdd);
+
+    TRACE("(%p, %p)\n", hdd, lpddtime);
+
+    if (!whdd || !lpddtime) return FALSE;
+
+#ifndef SG_MUTANT_VFW_TIME
+    *lpddtime = whdd->time;
+#endif
+    return TRUE;
 }
 
 /***********************************************************************
@@ -526,7 +609,19 @@ BOOL VFWAPI DrawDibTime(HDRAWDIB hdd, LPDRAWDIBTIME lpddtime)
  */
 DWORD VFWAPI DrawDibProfileDisplay(LPBITMAPINFOHEADER lpbi)
 {
-    FIXME("(%p) stub\n", lpbi);
+    DWORD ret = PD_CAN_DRAW_DIB;
+    HDC hdc;
 
-    return PD_CAN_DRAW_DIB;
+    TRACE("(%p)\n", lpbi);
+
+    /* Drawing always goes through a memory DC and StretchBlt(); stretching
+     * is native when the display driver advertises it. */
+    if ((hdc = GetDC(NULL)))
+    {
+        if (GetDeviceCaps(hdc, RASTERCAPS) & RC_STRETCHDIB)
+            ret |= PD_CAN_STRETCHDIB | PD_STRETCHDIB_1_1_OK | PD_STRETCHDIB_1_2_OK | PD_STRETCHDIB_1_N_OK;
+        ReleaseDC(NULL, hdc);
+    }
+
+    return ret;
 }
