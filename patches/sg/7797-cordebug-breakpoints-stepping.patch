+/***************************************************************************
+ * Stained Glass OS: breakpoints, stepping and the events that report them (wine-sg 7797)
+ *
+ * A breakpoint is the agent's BREAKPOINT event request at a method's IL offset, a stepper its STEP request on
+ * a thread (an instruction, into or over calls, or out of the frame), all with the whole program suspended
+ * when they are hit. The agent's composite events come on the connection's reader thread; they are queued
+ * and a thread of the process delivers them as ICorDebugManagedCallback::Breakpoint and StepComplete, the
+ * process stopped (its stop count up by one, as after Stop) until the debugger continues it.
+ */
+static void put_be64(BYTE *p, UINT64 v) { put_be32(p, v >> 32); put_be32(p + 4, (UINT32)v); }
+
+typedef struct DebugAppDomain
+{
+    ICorDebugAppDomain ICorDebugAppDomain_iface;
+    LONG ref;
+    DebugProcess *process;
+} DebugAppDomain;
+
+static inline DebugAppDomain *impl_from_ICorDebugAppDomain(ICorDebugAppDomain *iface)
+{
+    return CONTAINING_RECORD(iface, DebugAppDomain, ICorDebugAppDomain_iface);
+}
+
+static HRESULT WINAPI appdomain_QueryInterface(ICorDebugAppDomain *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_ICorDebugAppDomain) || IsEqualGUID(riid, &IID_ICorDebugController) ||
+        IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *ppv = iface;
+        ICorDebugAppDomain_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI appdomain_AddRef(ICorDebugAppDomain *iface)
+{ return InterlockedIncrement(&impl_from_ICorDebugAppDomain(iface)->ref); }
+static ULONG WINAPI appdomain_Release(ICorDebugAppDomain *iface)
+{
+    DebugAppDomain *This = impl_from_ICorDebugAppDomain(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+    {
+        ICorDebugProcess_Release(&This->process->ICorDebugProcess_iface);
+        free(This);
+    }
+    return ref;
+}
+#define PROC(This) (&impl_from_ICorDebugAppDomain(This)->process->ICorDebugProcess_iface)
+static HRESULT WINAPI appdomain_Stop(ICorDebugAppDomain *iface, DWORD timeout)
+{ return ICorDebugProcess_Stop(PROC(iface), timeout); }
+static HRESULT WINAPI appdomain_Continue(ICorDebugAppDomain *iface, BOOL oob)
+{ return ICorDebugProcess_Continue(PROC(iface), oob); }
+static HRESULT WINAPI appdomain_IsRunning(ICorDebugAppDomain *iface, BOOL *running)
+{ return ICorDebugProcess_IsRunning(PROC(iface), running); }
+static HRESULT WINAPI appdomain_HasQueuedCallbacks(ICorDebugAppDomain *iface, ICorDebugThread *thread, BOOL *queued)
+{ return ICorDebugProcess_HasQueuedCallbacks(PROC(iface), thread, queued); }
+static HRESULT WINAPI appdomain_EnumerateThreads(ICorDebugAppDomain *iface, ICorDebugThreadEnum **threads)
+{ return ICorDebugProcess_EnumerateThreads(PROC(iface), threads); }
+static HRESULT WINAPI appdomain_SetAllThreadsDebugState(ICorDebugAppDomain *iface, CorDebugThreadState state, ICorDebugThread *except)
+{ return ICorDebugProcess_SetAllThreadsDebugState(PROC(iface), state, except); }
+static HRESULT WINAPI appdomain_Detach(ICorDebugAppDomain *iface)
+{ return ICorDebugProcess_Detach(PROC(iface)); }
+static HRESULT WINAPI appdomain_Terminate(ICorDebugAppDomain *iface, UINT code)
+{ return ICorDebugProcess_Terminate(PROC(iface), code); }
+static HRESULT WINAPI appdomain_CanCommitChanges(ICorDebugAppDomain *iface, ULONG n, ICorDebugEditAndContinueSnapshot *s[], ICorDebugErrorInfoEnum **e)
+{ return E_NOTIMPL; }
+static HRESULT WINAPI appdomain_CommitChanges(ICorDebugAppDomain *iface, ULONG n, ICorDebugEditAndContinueSnapshot *s[], ICorDebugErrorInfoEnum **e)
+{ return E_NOTIMPL; }
+static HRESULT WINAPI appdomain_GetProcess(ICorDebugAppDomain *iface, ICorDebugProcess **ppProcess)
+{
+    if (!ppProcess) return E_INVALIDARG;
+    *ppProcess = PROC(iface);
+    ICorDebugProcess_AddRef(*ppProcess);
+    return S_OK;
+}
+#undef PROC
+static HRESULT WINAPI appdomain_EnumerateAssemblies(ICorDebugAppDomain *iface, ICorDebugAssemblyEnum **e)
+{ FIXME("%p: assemblies not yet\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI appdomain_GetModuleFromMetaDataInterface(ICorDebugAppDomain *iface, IUnknown *md, ICorDebugModule **m)
+{ return E_NOTIMPL; }
+static HRESULT WINAPI appdomain_EnumerateBreakpoints(ICorDebugAppDomain *iface, ICorDebugBreakpointEnum **e)
+{ return E_NOTIMPL; }
+static HRESULT WINAPI appdomain_EnumerateSteppers(ICorDebugAppDomain *iface, ICorDebugStepperEnum **e)
+{ return E_NOTIMPL; }
+static HRESULT WINAPI appdomain_IsAttached(ICorDebugAppDomain *iface, BOOL *attached)
+{
+    if (!attached) return E_INVALIDARG;
+    *attached = TRUE;
+    return S_OK;
+}
+static HRESULT WINAPI appdomain_GetName(ICorDebugAppDomain *iface, ULONG32 cch, ULONG32 *pcch, WCHAR name[])
+{
+    static const WCHAR domain[] = L"DefaultDomain";
+    ULONG32 n = min(cch, ARRAY_SIZE(domain));
+
+    if (!pcch) return E_INVALIDARG;
+    *pcch = ARRAY_SIZE(domain);
+    if (name && n) { memcpy(name, domain, n * sizeof(WCHAR)); name[n - 1] = 0; }
+    return S_OK;
+}
+static HRESULT WINAPI appdomain_GetObject(ICorDebugAppDomain *iface, ICorDebugValue **v)
+{ return E_NOTIMPL; }
+static HRESULT WINAPI appdomain_Attach(ICorDebugAppDomain *iface)
+{ return S_OK; }
+static HRESULT WINAPI appdomain_GetID(ICorDebugAppDomain *iface, ULONG32 *id)
+{
+    if (!id) return E_INVALIDARG;
+    *id = 1;
+    return S_OK;
+}
+
+static const ICorDebugAppDomainVtbl appdomain_vtbl =
+{
+    appdomain_QueryInterface, appdomain_AddRef, appdomain_Release,
+    appdomain_Stop, appdomain_Continue, appdomain_IsRunning, appdomain_HasQueuedCallbacks,
+    appdomain_EnumerateThreads, appdomain_SetAllThreadsDebugState, appdomain_Detach, appdomain_Terminate,
+    appdomain_CanCommitChanges, appdomain_CommitChanges,
+    appdomain_GetProcess, appdomain_EnumerateAssemblies, appdomain_GetModuleFromMetaDataInterface,
+    appdomain_EnumerateBreakpoints, appdomain_EnumerateSteppers, appdomain_IsAttached, appdomain_GetName,
+    appdomain_GetObject, appdomain_Attach, appdomain_GetID,
+};
+
+/* the process's one application domain (Wine Mono runs programs in the default one) */
+static ICorDebugAppDomain *process_appdomain(DebugProcess *process)
+{
+    DebugAppDomain *domain;
+
+    EnterCriticalSection(&process->cs);
+    if (!process->appdomain && (domain = calloc(1, sizeof(*domain))))
+    {
+        domain->ICorDebugAppDomain_iface.lpVtbl = &appdomain_vtbl;
+        domain->ref = 1;
+        domain->process = process;
+        /* (no reference to the process: the process holds the domain until it goes) */
+        process->appdomain = &domain->ICorDebugAppDomain_iface;
+    }
+    if (process->appdomain) ICorDebugAppDomain_AddRef(process->appdomain);
+    LeaveCriticalSection(&process->cs);
+    return process->appdomain;
+}
+
+/* the agent's event request: its id, or 0 */
+static UINT32 event_request(DebugProcess *process, const BYTE *payload, UINT32 len)
+{
+    struct sdb_conn *sdb = process_agent(process);
+    BYTE *reply = NULL;
+    UINT32 rlen, id = 0;
+
+    if (!sdb) return 0;
+    if (!sdb_request(sdb, SDB_SET_EVENT_REQUEST, SDB_EVENT_REQUEST_SET, payload, len, &reply, &rlen) && rlen >= 4)
+        id = sdb_get32(reply);
+    free(reply);
+    return id;
+}
+
+static void event_request_clear(DebugProcess *process, BYTE kind, UINT32 id)
+{
+    struct sdb_conn *sdb = process_agent(process);
+    BYTE payload[5];
+
+    if (!sdb || !id) return;
+    payload[0] = kind;
+    put_be32(payload + 1, id);
+    sdb_request(sdb, SDB_SET_EVENT_REQUEST, SDB_EVENT_REQUEST_CLEAR, payload, 5, NULL, NULL);
+}
+
+/* ICorDebugFunctionBreakpoint */
+typedef struct DebugBreakpoint
+{
+    ICorDebugFunctionBreakpoint ICorDebugFunctionBreakpoint_iface;
+    LONG ref;
+    struct list entry;          /* in the process's list while active */
+    DebugProcess *process;
+    UINT32 method;
+    mdMethodDef token;
+    ULONG32 offset;
+    UINT32 request;             /* the agent's request, 0: not active */
+} DebugBreakpoint;
+
+static inline DebugBreakpoint *impl_from_ICorDebugFunctionBreakpoint(ICorDebugFunctionBreakpoint *iface)
+{
+    return CONTAINING_RECORD(iface, DebugBreakpoint, ICorDebugFunctionBreakpoint_iface);
+}
+
+static HRESULT WINAPI breakpoint_QueryInterface(ICorDebugFunctionBreakpoint *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_ICorDebugFunctionBreakpoint) || IsEqualGUID(riid, &IID_ICorDebugBreakpoint) ||
+        IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *ppv = iface;
+        ICorDebugFunctionBreakpoint_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI breakpoint_AddRef(ICorDebugFunctionBreakpoint *iface)
+{ return InterlockedIncrement(&impl_from_ICorDebugFunctionBreakpoint(iface)->ref); }
+static ULONG WINAPI breakpoint_Release(ICorDebugFunctionBreakpoint *iface)
+{
+    DebugBreakpoint *This = impl_from_ICorDebugFunctionBreakpoint(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+    {
+        ICorDebugProcess_Release(&This->process->ICorDebugProcess_iface);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI breakpoint_Activate(ICorDebugFunctionBreakpoint *iface, BOOL bActive)
+{
+    DebugBreakpoint *This = impl_from_ICorDebugFunctionBreakpoint(iface);
+    BYTE payload[3 + 1 + 4 + 8];
+    UINT32 id;
+
+    TRACE("%p, %d\n", iface, bActive);
+    if (bActive && !This->request)
+    {
+        payload[0] = SDB_EVENT_KIND_BREAKPOINT;
+        payload[1] = SDB_SUSPEND_POLICY_ALL;
+        payload[2] = 1;
+        payload[3] = SDB_MOD_LOCATION_ONLY;
+        put_be32(payload + 4, This->method);
+        put_be64(payload + 8, This->offset);
+#ifndef SG_MUTANT_CDB_BP_NOT_SET
+        if (!(id = event_request(This->process, payload, sizeof(payload)))) return CORDBG_E_CODE_NOT_AVAILABLE;
+#else
+        id = 0x7fffffff;
+#endif
+        EnterCriticalSection(&This->process->cs);
+        This->request = id;
+        list_add_tail(&This->process->breakpoints, &This->entry);
+        ICorDebugFunctionBreakpoint_AddRef(iface);   /* the list's */
+        LeaveCriticalSection(&This->process->cs);
+    }
+    else if (!bActive && This->request)
+    {
+        event_request_clear(This->process, SDB_EVENT_KIND_BREAKPOINT, This->request);
+        EnterCriticalSection(&This->process->cs);
+        This->request = 0;
+        list_remove(&This->entry);
+        LeaveCriticalSection(&This->process->cs);
+        ICorDebugFunctionBreakpoint_Release(iface);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI breakpoint_IsActive(ICorDebugFunctionBreakpoint *iface, BOOL *pbActive)
+{
+    if (!pbActive) return E_INVALIDARG;
+    *pbActive = impl_from_ICorDebugFunctionBreakpoint(iface)->request != 0;
+    return S_OK;
+}
+
+static HRESULT function_create(DebugProcess *process, UINT32 method, mdMethodDef token, ICorDebugFunction **ret);
+
+static HRESULT WINAPI breakpoint_GetFunction(ICorDebugFunctionBreakpoint *iface, ICorDebugFunction **ppFunction)
+{
+    DebugBreakpoint *This = impl_from_ICorDebugFunctionBreakpoint(iface);
+    if (!ppFunction) return E_INVALIDARG;
+    return function_create(This->process, This->method, This->token, ppFunction);
+}
+
+static HRESULT WINAPI breakpoint_GetOffset(ICorDebugFunctionBreakpoint *iface, ULONG32 *pnOffset)
+{
+    if (!pnOffset) return E_INVALIDARG;
+    *pnOffset = impl_from_ICorDebugFunctionBreakpoint(iface)->offset;
+    return S_OK;
+}
+
+static const ICorDebugFunctionBreakpointVtbl breakpoint_vtbl =
+{
+    breakpoint_QueryInterface, breakpoint_AddRef, breakpoint_Release,
+    breakpoint_Activate, breakpoint_IsActive, breakpoint_GetFunction, breakpoint_GetOffset,
+};
+
+/* an active breakpoint at METHOD's IL OFFSET (as on Windows, made active) */
+static HRESULT breakpoint_create(DebugProcess *process, UINT32 method, mdMethodDef token, ULONG32 offset,
+                                 ICorDebugFunctionBreakpoint **ret)
+{
+    DebugBreakpoint *This = calloc(1, sizeof(*This));
+    HRESULT hr;
+
+    if (!This) return E_OUTOFMEMORY;
+    This->ICorDebugFunctionBreakpoint_iface.lpVtbl = &breakpoint_vtbl;
+    This->ref = 1;
+    This->process = process;
+    ICorDebugProcess_AddRef(&process->ICorDebugProcess_iface);
+    This->method = method;
+    This->token = token;
+    This->offset = offset;
+    if (FAILED(hr = breakpoint_Activate(&This->ICorDebugFunctionBreakpoint_iface, TRUE)))
+    {
+        ICorDebugFunctionBreakpoint_Release(&This->ICorDebugFunctionBreakpoint_iface);
+        return hr;
+    }
+    *ret = &This->ICorDebugFunctionBreakpoint_iface;
+    return S_OK;
+}
+
+/* ICorDebugCode: a function's IL */
+typedef struct DebugCode
+{
+    ICorDebugCode ICorDebugCode_iface;
+    LONG ref;
+    DebugProcess *process;
+    UINT32 method;
+    mdMethodDef token;
+} DebugCode;
+
+static inline DebugCode *impl_from_ICorDebugCode(ICorDebugCode *iface)
+{
+    return CONTAINING_RECORD(iface, DebugCode, ICorDebugCode_iface);
+}
+
+static HRESULT WINAPI code_QueryInterface(ICorDebugCode *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_ICorDebugCode) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *ppv = iface;
+        ICorDebugCode_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI code_AddRef(ICorDebugCode *iface)
+{ return InterlockedIncrement(&impl_from_ICorDebugCode(iface)->ref); }
+static ULONG WINAPI code_Release(ICorDebugCode *iface)
+{
+    DebugCode *This = impl_from_ICorDebugCode(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+    {
+        ICorDebugProcess_Release(&This->process->ICorDebugProcess_iface);
+        free(This);
+    }
+    return ref;
+}
+static HRESULT WINAPI code_IsIL(ICorDebugCode *iface, BOOL *pbIL)
+{
+    if (!pbIL) return E_INVALIDARG;
+    *pbIL = TRUE;
+    return S_OK;
+}
+static HRESULT WINAPI code_GetFunction(ICorDebugCode *iface, ICorDebugFunction **ppFunction)
+{
+    DebugCode *This = impl_from_ICorDebugCode(iface);
+    if (!ppFunction) return E_INVALIDARG;
+    return function_create(This->process, This->method, This->token, ppFunction);
+}
+static HRESULT WINAPI code_GetAddress(ICorDebugCode *iface, CORDB_ADDRESS *pStart)
+{
+    if (!pStart) return E_INVALIDARG;
+    *pStart = 0;
+    return S_OK;
+}
