+static HRESULT stepper_create(DebugThread *thread, ICorDebugStepper **ret)
+{
+    DebugStepper *This = calloc(1, sizeof(*This));
+
+    if (!This) return E_OUTOFMEMORY;
+    This->ICorDebugStepper_iface.lpVtbl = &stepper_vtbl;
+    This->ref = 1;
+    This->thread = thread;
+    ICorDebugThread_AddRef(&thread->ICorDebugThread_iface);
+    *ret = &This->ICorDebugStepper_iface;
+    return S_OK;
+}
+
+/* the agent's events, from the reader thread: queued for the process's event thread */
+struct queued_event
+{
+    struct list entry;
+    BYTE *data;
+    UINT32 len;
+};
+
+static void process_event_func(void *ctx, BYTE *data, UINT32 len)
+{
+    DebugProcess *This = ctx;
+    struct queued_event *ev = malloc(sizeof(*ev));
+
+    if (!ev) { free(data); return; }
+    ev->data = data;
+    ev->len = len;
+    EnterCriticalSection(&This->cs);
+    list_add_tail(&This->events, &ev->entry);
+    LeaveCriticalSection(&This->cs);
+    SetEvent(This->event_ready);
+}
+
+/* one composite event: the process stopped, the callbacks */
+static void deliver_event(DebugProcess *This, const BYTE *p, UINT32 len)
+{
+    struct sdb_conn *sdb = process_agent(This);
+    ICorDebugManagedCallback *callback = This->cordebug ? This->cordebug->pCallback : NULL;
+    const BYTE *end = p + len;
+    UINT32 n, i, request, objid;
+    BYTE policy, kind;
+
+    if (len < 5) return;
+    policy = p[0];
+    n = sdb_get32(p + 1);
+    p += 5;
+    for (i = 0; i < n && end - p >= 9; i++)
+    {
+        kind = p[0];
+        request = sdb_get32(p + 1);
+        objid = sdb_get32(p + 5);
+        p += 9;
+        if (kind == SDB_EVENT_KIND_BREAKPOINT || kind == SDB_EVENT_KIND_STEP)
+        {
+            DebugBreakpoint *bp, *found_bp = NULL;
+            DebugStepper *st, *found_st = NULL;
+            ICorDebugAppDomain *domain;
+            DebugThread *thread;
+
+            if (end - p < 12) break;
+            p += 12;   /* method, IL offset */
+            EnterCriticalSection(&This->cs);
+            if (kind == SDB_EVENT_KIND_BREAKPOINT)
+            {
+                LIST_FOR_EACH_ENTRY(bp, &This->breakpoints, DebugBreakpoint, entry)
+                    if (bp->request == request) { found_bp = bp; ICorDebugFunctionBreakpoint_AddRef(&bp->ICorDebugFunctionBreakpoint_iface); break; }
+            }
+            else
+            {
+                LIST_FOR_EACH_ENTRY(st, &This->steppers, DebugStepper, entry)
+                    if (st->request == request) { found_st = st; ICorDebugStepper_AddRef(&st->ICorDebugStepper_iface); break; }
+            }
+            LeaveCriticalSection(&This->cs);
+            if (!found_bp && !found_st)
+            {
+                /* one gone meanwhile (deactivated as it hit): the agent suspended the program for nothing */
+                if (policy == SDB_SUSPEND_POLICY_ALL && sdb)
+                    sdb_request(sdb, SDB_SET_VM, SDB_VM_RESUME, NULL, 0, NULL, NULL);
+                policy = 0;
+                continue;
+            }
+            if (policy == SDB_SUSPEND_POLICY_ALL)
+            {
+                /* the agent suspended the program for it: synchronized, until continued. (VM_START, which
+                 * the agent sends suspended at the start, is not reported: the first Continue resumes it.) */
+                EnterCriticalSection(&This->cs);
+                This->stop_count++;
+                LeaveCriticalSection(&This->cs);
+                policy = 0;   /* once for the whole composite */
+            }
+#ifndef SG_MUTANT_CDB_STEP_KEEPS
+            if (found_st) stepper_end(found_st);   /* a step is done once it stops */
+#endif
+            if (!sdb || !(thread = new_thread(This, sdb, objid)))
+            {
+                if (found_bp) ICorDebugFunctionBreakpoint_Release(&found_bp->ICorDebugFunctionBreakpoint_iface);
+                if (found_st) ICorDebugStepper_Release(&found_st->ICorDebugStepper_iface);
+                continue;
+            }
+            domain = process_appdomain(This);
+            TRACE("%s, request %u, thread %#lx\n", kind == SDB_EVENT_KIND_BREAKPOINT ? "breakpoint" : "step done",
+                  request, thread->tid);
+            if (callback && found_bp)
+                ICorDebugManagedCallback_Breakpoint(callback, domain, &thread->ICorDebugThread_iface,
+                                                    (ICorDebugBreakpoint *)&found_bp->ICorDebugFunctionBreakpoint_iface);
+            else if (callback && found_st)
+                ICorDebugManagedCallback_StepComplete(callback, domain, &thread->ICorDebugThread_iface,
+                                                      &found_st->ICorDebugStepper_iface, STEP_NORMAL);
+            if (domain) ICorDebugAppDomain_Release(domain);
+            ICorDebugThread_Release(&thread->ICorDebugThread_iface);
+            if (found_bp) ICorDebugFunctionBreakpoint_Release(&found_bp->ICorDebugFunctionBreakpoint_iface);
+            if (found_st) ICorDebugStepper_Release(&found_st->ICorDebugStepper_iface);
+        }
+        else break;   /* (no other kinds are asked for) */
+    }
+}
+
+static DWORD WINAPI event_thread(void *arg)
+{
+    DebugProcess *This = arg;
+    struct queued_event *ev;
+
+    for (;;)
+    {
+        WaitForSingleObject(This->event_ready, INFINITE);
+        for (;;)
+        {
+            EnterCriticalSection(&This->cs);
+            if (This->events_closing)
+            {
+                LeaveCriticalSection(&This->cs);
+                return 0;
+            }
+            ev = list_empty(&This->events) ? NULL : LIST_ENTRY(list_head(&This->events), struct queued_event, entry);
+            if (ev) list_remove(&ev->entry);
+            LeaveCriticalSection(&This->cs);
+            if (!ev) break;
+            deliver_event(This, ev->data, ev->len);
+            free(ev->data);
+            free(ev);
+        }
+    }
+}
+
+/* the agent connected: its events are heard */
+static void process_start_events(DebugProcess *This)
+{
+    if (This->event_thread || !This->sdb) return;
+    if (!(This->event_ready = CreateEventW(NULL, FALSE, FALSE, NULL))) return;
+    if (!(This->event_thread = CreateThread(NULL, 0, event_thread, This, 0, NULL))) return;
+    sdb_set_event_handler(This->sdb, process_event_func, This);
+}
+
+static void process_stop_events(DebugProcess *This)
+{
+    struct queued_event *ev, *next;
+    DebugBreakpoint *bp, *bp2;
+    DebugStepper *st, *st2;
+
+    if (This->sdb) sdb_set_event_handler(This->sdb, NULL, NULL);
+    if (This->event_thread)
+    {
+        EnterCriticalSection(&This->cs);
+        This->events_closing = TRUE;
+        LeaveCriticalSection(&This->cs);
+        SetEvent(This->event_ready);
+        if (GetCurrentThreadId() != GetThreadId(This->event_thread)) WaitForSingleObject(This->event_thread, INFINITE);
+        CloseHandle(This->event_thread);
+        This->event_thread = NULL;
+    }
+    if (This->event_ready) CloseHandle(This->event_ready);
+    This->event_ready = NULL;
+    LIST_FOR_EACH_ENTRY_SAFE(ev, next, &This->events, struct queued_event, entry)
+    {
+        list_remove(&ev->entry);
+        free(ev->data);
+        free(ev);
+    }
+    /* the lists' references */
+    LIST_FOR_EACH_ENTRY_SAFE(bp, bp2, &This->breakpoints, DebugBreakpoint, entry)
+    {
+        list_remove(&bp->entry);
+        bp->request = 0;
+        ICorDebugFunctionBreakpoint_Release(&bp->ICorDebugFunctionBreakpoint_iface);
+    }
+    LIST_FOR_EACH_ENTRY_SAFE(st, st2, &This->steppers, DebugStepper, entry)
+    {
+        list_remove(&st->entry);
+        st->request = 0;
+        ICorDebugStepper_Release(&st->ICorDebugStepper_iface);
+    }
+    if (This->appdomain)
+    {
+        ICorDebugAppDomain_Release(This->appdomain);
+        This->appdomain = NULL;
+    }
+}
+
+static HRESULT function_create(DebugProcess *process, UINT32 method, mdMethodDef token, ICorDebugFunction **ret)
+{
+    DebugFunction *function = calloc(1, sizeof(*function));
+
+    if (!function) return E_OUTOFMEMORY;
+    function->ICorDebugFunction_iface.lpVtbl = &function_vtbl;
+    function->ref = 1;
+    function->process = process;
+    ICorDebugProcess_AddRef(&process->ICorDebugProcess_iface);
+    function->method = method;
+    function->token = token;
+    *ret = &function->ICorDebugFunction_iface;
+    return S_OK;
+}
