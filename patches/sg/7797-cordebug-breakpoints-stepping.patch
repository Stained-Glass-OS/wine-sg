+    stepper_QueryInterface, stepper_AddRef, stepper_Release,
+    stepper_IsActive, stepper_Deactivate, stepper_SetInterceptMask, stepper_SetUnmappedStopMask,
+    stepper_Step, stepper_StepRange, stepper_StepOut, stepper_SetRangeIL,
+};
