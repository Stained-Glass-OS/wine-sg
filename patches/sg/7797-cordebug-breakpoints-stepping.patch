 /* the managed threads now, from the agent (the process stopped) */
+/* a thread object for the agent's thread OBJID: its OS thread id and state */
+static DebugThread *new_thread(DebugProcess *This, struct sdb_conn *sdb, UINT32 objid)
+{
+    BYTE *info = NULL, id[4];
+    DebugThread *thread;
+    UINT32 ilen;
+
+    if (!(thread = calloc(1, sizeof(*thread)))) return NULL;
+    thread->ICorDebugThread_iface.lpVtbl = &cordebugthreadVtbl;
+    thread->ref = 1;
+    thread->process = This;
+    ICorDebugProcess_AddRef(&This->ICorDebugProcess_iface);
+    thread->objid = objid;
+    thread->debug_state = THREAD_RUN;
+    id[0] = objid >> 24; id[1] = objid >> 16; id[2] = objid >> 8; id[3] = objid;
+    if (!sdb_request(sdb, SDB_SET_THREAD, SDB_THREAD_GET_TID, id, 4, &info, &ilen) && ilen >= 8)
+#ifndef SG_MUTANT_CDB_THREAD_ID
+        thread->tid = sdb_get64(info);
+#else
+        thread->tid = thread->objid;
+#endif
+    free(info);
+    info = NULL;
+    if (!sdb_request(sdb, SDB_SET_THREAD, SDB_THREAD_GET_STATE, id, 4, &info, &ilen) && ilen >= 4)
+        thread->state = sdb_get32(info);
+    free(info);
+    return thread;
+}
