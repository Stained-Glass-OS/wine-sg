+/* ICorDebugStepper */
+typedef struct DebugStepper
+{
+    ICorDebugStepper ICorDebugStepper_iface;
+    LONG ref;
+    struct list entry;          /* in the process's list while stepping */
+    DebugThread *thread;
+    UINT32 request;
+} DebugStepper;
+
+static inline DebugStepper *impl_from_ICorDebugStepper(ICorDebugStepper *iface)
+{
+    return CONTAINING_RECORD(iface, DebugStepper, ICorDebugStepper_iface);
+}
+
+static HRESULT WINAPI stepper_QueryInterface(ICorDebugStepper *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_ICorDebugStepper) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *ppv = iface;
+        ICorDebugStepper_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI stepper_AddRef(ICorDebugStepper *iface)
+{ return InterlockedIncrement(&impl_from_ICorDebugStepper(iface)->ref); }
+static ULONG WINAPI stepper_Release(ICorDebugStepper *iface)
+{
+    DebugStepper *This = impl_from_ICorDebugStepper(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+    {
+        ICorDebugThread_Release(&This->thread->ICorDebugThread_iface);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI stepper_IsActive(ICorDebugStepper *iface, BOOL *pbActive)
+{
+    if (!pbActive) return E_INVALIDARG;
+    *pbActive = impl_from_ICorDebugStepper(iface)->request != 0;
+    return S_OK;
+}
+
+/* the step request gone: the stepper is done */
+static void stepper_end(DebugStepper *This)
+{
+    DebugProcess *process = This->thread->process;
+    UINT32 request;
+
+    EnterCriticalSection(&process->cs);
+    request = This->request;
+    This->request = 0;
+    if (request) list_remove(&This->entry);
+    LeaveCriticalSection(&process->cs);
+    if (!request) return;
+    event_request_clear(process, SDB_EVENT_KIND_STEP, request);
+    ICorDebugStepper_Release(&This->ICorDebugStepper_iface);
+}
+
+static HRESULT WINAPI stepper_Deactivate(ICorDebugStepper *iface)
+{
+    stepper_end(impl_from_ICorDebugStepper(iface));
+    return S_OK;
+}
+
+static HRESULT WINAPI stepper_SetInterceptMask(ICorDebugStepper *iface, CorDebugIntercept mask)
+{ return S_OK; }
+static HRESULT WINAPI stepper_SetUnmappedStopMask(ICorDebugStepper *iface, CorDebugUnmappedStop mask)
+{ return S_OK; }
+
+static HRESULT stepper_start(DebugStepper *This, int depth)
+{
+    DebugProcess *process = This->thread->process;
+    BYTE payload[3 + 1 + 4 + 4 + 4 + 4];
+    UINT32 id;
+
+    if (This->request) stepper_end(This);
+    payload[0] = SDB_EVENT_KIND_STEP;
+    payload[1] = SDB_SUSPEND_POLICY_ALL;
+    payload[2] = 1;
+    payload[3] = SDB_MOD_STEP;
+    put_be32(payload + 4, This->thread->objid);
+    put_be32(payload + 8, SDB_STEP_SIZE_MIN);   /* (to the next sequence point: needs no line table) */
+    put_be32(payload + 12, depth);
+    put_be32(payload + 16, 0);   /* no filter */
+    if (!(id = event_request(process, payload, sizeof(payload)))) return CORDBG_E_PROCESS_TERMINATED;
+    EnterCriticalSection(&process->cs);
+    This->request = id;
+    list_add_tail(&process->steppers, &This->entry);
+    ICorDebugStepper_AddRef(&This->ICorDebugStepper_iface);   /* the list's */
+    LeaveCriticalSection(&process->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI stepper_Step(ICorDebugStepper *iface, BOOL bStepIn)
+{
+    return stepper_start(impl_from_ICorDebugStepper(iface), bStepIn ? SDB_STEP_DEPTH_INTO : SDB_STEP_DEPTH_OVER);
+}
+
+static HRESULT WINAPI stepper_StepRange(ICorDebugStepper *iface, BOOL bStepIn, COR_DEBUG_STEP_RANGE ranges[],
+                                       ULONG32 cRangeCount)
+{
+    /* the agent steps by sequence points: a step leaves a statement's range */
+    return stepper_start(impl_from_ICorDebugStepper(iface), bStepIn ? SDB_STEP_DEPTH_INTO : SDB_STEP_DEPTH_OVER);
+}
+
+static HRESULT WINAPI stepper_StepOut(ICorDebugStepper *iface)
+{
+    return stepper_start(impl_from_ICorDebugStepper(iface), SDB_STEP_DEPTH_OUT);
+}
+
