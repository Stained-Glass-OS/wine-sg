From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: EM_SETMARGINS and EM_GETMARGINS

EM_SETMARGINS was an unsupported message in rich edit controls. The windowed host now keeps the left and right margins (in pixels; EC_USEFONTINFO gives the narrow ones), hands them to text services as its view inset (HIMETRIC, as ITextHost::TxGetViewInset is), and text services lays the text out inside them; EM_GETMARGINS returns them and EM_GETRECT the formatting rectangle inside them.
---
--- a/dlls/riched20/txthost.c
+++ b/dlls/riched20/txthost.c
@@ -51,6 +51,7 @@
     COLORREF back_colour;
     WCHAR password_char;
     unsigned int notify_level;
+    WORD margin_left, margin_right;   /* (wine-sg 8296) EM_SETMARGINS, in pixels */
 };
 
 static const ITextHost2Vtbl textHostVtbl;
@@ -372,7 +373,21 @@
 DEFINE_THISCALL_WRAPPER(ITextHostImpl_TxGetViewInset,8)
 HRESULT __thiscall ITextHostImpl_TxGetViewInset( ITextHost2 *iface, RECT *rect )
 {
+    struct host *host = impl_from_ITextHost( iface );
+
     SetRectEmpty( rect );
+#ifndef SG_MUTANT_NO_RICHEDIT_MARGINS
+    /* (wine-sg 8296) the margins EM_SETMARGINS set, in HIMETRIC as the view inset is */
+    if (host->margin_left || host->margin_right)
+    {
+        HDC dc = GetDC( host->window );
+        int dpi = GetDeviceCaps( dc, LOGPIXELSX );
+
+        ReleaseDC( host->window, dc );
+        rect->left = MulDiv( host->margin_left, 2540, dpi );
+        rect->right = MulDiv( host->margin_right, 2540, dpi );
+    }
+#endif
     return S_OK;
 }
 
@@ -1253,6 +1268,15 @@
 
     case EM_GETRECT:
         hr = ITextHost_TxGetClientRect( &host->ITextHost_iface, (RECT *)lparam );
+#ifndef SG_MUTANT_NO_RICHEDIT_MARGINS
+        /* (wine-sg 8296) the formatting rectangle: inside the margins, as text services lays it out */
+        if (SUCCEEDED(hr))
+        {
+            RECT *rc = (RECT *)lparam;
+            rc->left += host->margin_left;
+            rc->right = max( rc->left, rc->right - host->margin_right );
+        }
+#endif
         break;
 
     case EM_GETSELTEXT:
@@ -1432,6 +1456,27 @@
         hr = set_options( host, wparam, lparam, &res );
         break;
 
+#ifndef SG_MUTANT_NO_RICHEDIT_MARGINS
+    case EM_SETMARGINS:
+        /* (wine-sg 8296) left and right margins of the formatting rectangle, in pixels; EC_USEFONTINFO
+         * (in wParam, or as either value) takes the narrow margins the font gives: none here */
+        if (wparam == EC_USEFONTINFO)
+            host->margin_left = host->margin_right = 0;
+        else
+        {
+            if (wparam & EC_LEFTMARGIN)
+                host->margin_left = LOWORD( lparam ) == EC_USEFONTINFO ? 0 : LOWORD( lparam );
+            if (wparam & EC_RIGHTMARGIN)
+                host->margin_right = HIWORD( lparam ) == EC_USEFONTINFO ? 0 : HIWORD( lparam );
+        }
+        ITextServices_OnTxPropertyBitsChange( host->text_srv, TXTBIT_VIEWINSETCHANGE, TXTBIT_VIEWINSETCHANGE );
+        break;
+
+    case EM_GETMARGINS:
+        res = MAKELONG( host->margin_left, host->margin_right );
+        break;
+#endif
+
     case EM_SETPASSWORDCHAR:
         if (wparam == host->password_char) break;
         host->password_char = wparam;
--- a/dlls/riched20/txtsrv.c
+++ b/dlls/riched20/txtsrv.c
@@ -152,6 +152,27 @@
     }
     else rect = *client;
 
+#ifndef SG_MUTANT_NO_RICHEDIT_MARGINS
+    /* (wine-sg 8296) the host's view inset (EM_SETMARGINS), in HIMETRIC */
+    {
+        RECT inset;
+
+        if (ITextHost_TxGetViewInset( services->editor->texthost, &inset ) == S_OK && (inset.left || inset.top || inset.right || inset.bottom))
+        {
+            HDC dc = ITextHost_TxGetDC( services->editor->texthost );
+            int dpi_x = dc ? GetDeviceCaps( dc, LOGPIXELSX ) : 96, dpi_y = dc ? GetDeviceCaps( dc, LOGPIXELSY ) : 96;
+
+            if (dc) ITextHost_TxReleaseDC( services->editor->texthost, dc );
+
+            rect.left += MulDiv( inset.left, dpi_x, 2540 );
+            rect.right -= MulDiv( inset.right, dpi_x, 2540 );
+            rect.top += MulDiv( inset.top, dpi_y, 2540 );
+            rect.bottom -= MulDiv( inset.bottom, dpi_y, 2540 );
+            if (rect.right < rect.left) rect.right = rect.left;
+            if (rect.bottom < rect.top) rect.bottom = rect.top;
+        }
+    }
+#endif
     rect.left += services->editor->selofs;
 
     if (EqualRect( &rect, &services->editor->rcFormat )) return S_FALSE;
@@ -710,6 +731,9 @@
         }
     }
 
+#ifndef SG_MUTANT_NO_RICHEDIT_MARGINS
+    if (mask & TXTBIT_VIEWINSETCHANGE) mask |= TXTBIT_CLIENTRECTCHANGE;
+#endif
     if (mask & TXTBIT_CLIENTRECTCHANGE)
     {
         hr = update_client_rect( services, NULL );
