From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 13:06:09 -0700
Subject: [PATCH] clusapi: behave as a machine without a cluster

OpenCluster fails with RPC_S_SERVER_UNAVAILABLE instead of handing out a fake
0xdeadbeef handle; every handle based call (nodes, groups, resources, networks,
net interfaces, registry, notify ports, enumerations, control codes) fails with
ERROR_INVALID_HANDLE the way it does on a bad handle, with the prototypes' real
argument counts so the 32-bit stack stays balanced. GetNodeClusterState keeps
reporting "not installed" and now validates its output pointer.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/clusapi/clusapi.c b/dlls/clusapi/clusapi.c
index 28c5f63..16093a6 100644
--- a/dlls/clusapi/clusapi.c
+++ b/dlls/clusapi/clusapi.c
@@ -22,6 +22,7 @@
 
 #include "windef.h"
 #include "winbase.h"
+#include "winerror.h"
 #include "clusapi.h"
 #include "wine/debug.h"
 
@@ -29,16 +30,14 @@ WINE_DEFAULT_DEBUG_CHANNEL(clusapi);
 
 /***********************************************************************
  *             GetClusterInformation   (CLUSAPI.@)
- *
  */
 DWORD WINAPI GetClusterInformation(HCLUSTER hCluster, LPWSTR lpszClusterName,
                                    LPDWORD lpcchClusterName, LPCLUSTERVERSIONINFO lpClusterInfo)
 {
-    FIXME("(%p, %p, %p, %p) stub!\n", hCluster, lpszClusterName, lpcchClusterName, lpClusterInfo);
-
-    *lpcchClusterName = 0;
+    TRACE("(%p, %p, %p, %p)\n", hCluster, lpszClusterName, lpcchClusterName, lpClusterInfo);
 
-    return ERROR_SUCCESS;
+    /* handles can only come from OpenCluster, which never succeeds here */
+    return ERROR_INVALID_HANDLE;
 }
 
 /***********************************************************************
@@ -54,8 +53,9 @@ DWORD WINAPI GetClusterInformation(HCLUSTER hCluster, LPWSTR lpszClusterName,
  */
 DWORD WINAPI GetNodeClusterState(LPCWSTR lpszNodeName, LPDWORD pdwClusterState)
 {
-    FIXME("(%s,%p) stub!\n",debugstr_w(lpszNodeName),pdwClusterState);
+    TRACE("(%s,%p)\n",debugstr_w(lpszNodeName),pdwClusterState);
 
+    if (!pdwClusterState) return ERROR_INVALID_PARAMETER;
     *pdwClusterState = 0;
 
     return ERROR_SUCCESS;
@@ -67,9 +67,11 @@ DWORD WINAPI GetNodeClusterState(LPCWSTR lpszNodeName, LPDWORD pdwClusterState)
  */
 HCLUSTER WINAPI OpenCluster(LPCWSTR lpszClusterName)
 {
-    FIXME("(%s) stub!\n", debugstr_w(lpszClusterName));
+    TRACE("(%s)\n", debugstr_w(lpszClusterName));
 
-    return (HCLUSTER)0xdeadbeef;
+    /* there is no cluster service to connect to */
+    SetLastError(RPC_S_SERVER_UNAVAILABLE);
+    return NULL;
 }
 
 /***********************************************************************
@@ -78,9 +80,10 @@ HCLUSTER WINAPI OpenCluster(LPCWSTR lpszClusterName)
  */
 BOOL WINAPI CloseCluster(HCLUSTER hCluster)
 {
-    FIXME("(%p) stub!\n", hCluster);
+    TRACE("(%p)\n", hCluster);
 
-    return TRUE;
+    SetLastError(ERROR_INVALID_HANDLE);
+    return FALSE;
 }
 
 /***********************************************************************
@@ -89,9 +92,10 @@ BOOL WINAPI CloseCluster(HCLUSTER hCluster)
  */
 HCLUSENUM WINAPI ClusterOpenEnum(HCLUSTER hCluster, DWORD dwType)
 {
-    FIXME("(%p, %lu) stub!\n", hCluster,dwType);
+    TRACE("(%p, %lu)\n", hCluster,dwType);
 
-    return (HCLUSENUM)0xdeadbeef;
+    SetLastError(ERROR_INVALID_HANDLE);
+    return NULL;
 }
 
 /***********************************************************************
@@ -100,9 +104,9 @@ HCLUSENUM WINAPI ClusterOpenEnum(HCLUSTER hCluster, DWORD dwType)
  */
 DWORD WINAPI ClusterCloseEnum(HCLUSENUM hEnum)
 {
-    FIXME("(%p) stub!\n", hEnum);
+    TRACE("(%p)\n", hEnum);
 
-    return ERROR_SUCCESS;
+    return ERROR_INVALID_HANDLE;
 }
 
 /***********************************************************************
@@ -111,7 +115,693 @@ DWORD WINAPI ClusterCloseEnum(HCLUSENUM hEnum)
  */
 DWORD WINAPI ClusterEnum(HCLUSENUM hEnum, DWORD dwIndex, LPDWORD lpdwType, LPWSTR lpszName, LPDWORD lpcchName)
 {
-    FIXME("(%p, %lu, %p, %p, %lu) stub!\n", hEnum, dwIndex, lpdwType, lpszName, *lpcchName);
+    TRACE("(%p, %lu, %p, %p, %p)\n", hEnum, dwIndex, lpdwType, lpszName, lpcchName);
+
+    return ERROR_INVALID_HANDLE;
+}
