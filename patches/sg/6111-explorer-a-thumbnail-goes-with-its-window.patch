From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: a taskbar thumbnail goes with its window

A window destroyed while its thumbnail popup was up left the popup and its tiles pointing at the freed taskbar_button: a repaint read its icon from freed memory and titled the tile "(untitled)" until the next hover. The popup is hidden when one of its windows goes, and shown again for the button under the pointer when the button has others.
---
diff --git a/programs/explorer/systray.c b/programs/explorer/systray.c
index bc9addf..3dfa6fa 100644
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1894,11 +1894,14 @@ static struct taskbar_button *find_taskbar_button( HWND hwnd )
     return NULL;
 }
 
+static void sg_thumbs_window_gone( struct taskbar_button *win );
+
 static void remove_taskbar_button( HWND hwnd )
 {
     struct taskbar_button *win = find_taskbar_button( hwnd );
 
     if (!win) return;
+    sg_thumbs_window_gone( win );
     list_remove( &win->entry );
     DestroyWindow( win->button );
     if (win->exe_icon) DestroyIcon( win->exe_icon );
@@ -2024,6 +2027,7 @@ static void sg_repaint_progress(void)
 
 #define SG_THUMB_HOVER_MS     400
 #define SG_THUMB_HIDE_TIMER   0xC1B0
+#define SG_THUMB_RESHOW_TIMER 0xC1B1
 #define SG_THUMB_W            SG_PX(200)
 #define SG_THUMB_IMG_H        SG_PX(112)
 #define SG_THUMB_TITLE_H      SG_PX(24)
@@ -2704,6 +2708,47 @@ static void sg_thumb_hide_timer(void)
     sg_hide_thumbnails();
 }
 
+/* Stained Glass OS: a window whose thumbnail is up goes away. The popup and
+ * its tiles pointed at its taskbar_button, freed right after: a repaint read
+ * the freed button's icon, and the dead window's title came out as
+ * "(untitled)" until the next hover (DOSBox killed with its preview up). The
+ * popup goes; if another window of the button is left, it comes back for the
+ * pointer still on the button once the button bar is laid out again. */
+static void sg_thumbs_window_gone( struct taskbar_button *win )
+{
+    BOOL involved, others = FALSE;
+    UINT i;
+
+#ifdef SG_MUTANT_THUMB_OUTLIVES_WINDOW
+    return;
+#endif
+    if (!sg_thumb_popup) return;
+    involved = sg_thumb_leader == win;
+    for (i = 0; i < sg_tile_count; i++)
+    {
+        if (sg_tiles[i].win == win) involved = TRUE;
+        else others = TRUE;
+    }
+    if (!involved) return;
+    sg_hide_thumbnails();
+    if (others) SetTimer( tray_window, SG_THUMB_RESHOW_TIMER, 0, NULL );
+}
+
+static void sg_thumb_reshow_timer(void)
+{
+    struct taskbar_button *win;
+    POINT pt;
+    RECT rc;
+
+    GetCursorPos( &pt );
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+        if (win->button && IsWindowVisible( win->button ) && GetWindowRect( win->button, &rc ) && PtInRect( &rc, pt ))
+        {
+            sg_show_thumbnails( win->button );
+            return;
+        }
+}
+
 static LRESULT handle_taskbar_list( const COPYDATASTRUCT *cds )
 {
     const struct sg_taskbar_list_data *data = cds->lpData;
@@ -5609,6 +5654,12 @@ static LRESULT WINAPI shell_traywnd_proc( HWND hwnd, UINT msg, WPARAM wparam, LP
             sg_thumb_hide_timer();
             return 0;
         }
+        if (wparam == SG_THUMB_RESHOW_TIMER)
+        {
+            KillTimer( hwnd, SG_THUMB_RESHOW_TIMER );
+            sg_thumb_reshow_timer();
+            return 0;
+        }
         if (wparam == SG_PROGRESS_TIMER)
         {
             if (!sg_any_indeterminate()) KillTimer( hwnd, SG_PROGRESS_TIMER );
