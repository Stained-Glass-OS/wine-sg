diff --git a/dlls/kernelbase/version.c b/dlls/kernelbase/version.c
index 154c81a..072ff6d 100644
--- a/dlls/kernelbase/version.c
+++ b/dlls/kernelbase/version.c
@@ -1974,6 +1974,86 @@ LONG WINAPI DECLSPEC_HOTPATCH GetPackagesByPackageFamily(const WCHAR *family_nam
     return ret;
 }
 
+/* a deployed package's properties (PACKAGE_PROPERTY_*), from its record */
+static UINT32 package_properties( const WCHAR *full_name, BOOL *staged )
+{
+    static const struct { const WCHAR *value; UINT32 property; } map[] =
+    {
+        { L"Framework", PACKAGE_PROPERTY_FRAMEWORK },
+        { L"ResourcePackage", PACKAGE_PROPERTY_RESOURCE },
+        { L"DevelopmentMode", PACKAGE_PROPERTY_DEVELOPMENT_MODE },
+    };
+    WCHAR key[MAX_PATH];
+    UINT32 ret = 0;
+    DWORD value, bytes, i;
+    HKEY hive;
+
+    *staged = FALSE;
+    if (wcslen( full_name ) + ARRAY_SIZE(deployed_packagesW) + 1 >= ARRAY_SIZE(key)) return 0;
+    swprintf( key, ARRAY_SIZE(key), L"%s\\%s", deployed_packagesW, full_name );
+    hive = record_hive( key );
+    for (i = 0; i < ARRAY_SIZE(map); i++)
+    {
+        bytes = sizeof(value);
+        if (!RegGetValueW( hive, key, map[i].value, RRF_RT_REG_DWORD | RRF_SUBKEY_WOW6464KEY, NULL, &value, &bytes ) && value)
+            ret |= map[i].property;
+    }
+    bytes = sizeof(value);
+    if (!RegGetValueW( hive, key, L"Staged", RRF_RT_REG_DWORD | RRF_SUBKEY_WOW6464KEY, NULL, &value, &bytes ) && value)
+        *staged = TRUE;
+    return ret;
+}
+
+/***********************************************************************
+ *         FindPackagesByPackageFamily   (kernelbase.@)
+ *
+ * The deployed packages of a family the filters select: main packages and frameworks
+ * (PACKAGE_FILTER_HEAD), resource packages (PACKAGE_FILTER_RESOURCE); no filter selects them all.
+ * Bundles and optional packages are not recorded on their own. The names and their properties
+ * are returned as by GetPackagesByPackageFamily.
+ */
+LONG WINAPI FindPackagesByPackageFamily( const WCHAR *family_name, UINT32 filters, UINT32 *count,
+                                         WCHAR **full_names, UINT32 *buffer_len, WCHAR *buffer, UINT32 *properties )
+{
+    WCHAR name[256], family[256];
+    UINT32 n = 0, needed = 0, family_len, len, props;
+    DWORD index = 0;
+    BOOL staged;
+    LONG ret = ERROR_SUCCESS;
+
+    TRACE( "(%s %#x %p %p %p %p %p)\n", debugstr_w(family_name), filters, count, full_names, buffer_len, buffer, properties );
+
+    if (!family_name || !count || !buffer_len) return ERROR_INVALID_PARAMETER;
+
+    while (enum_deployed_package( index++, name, ARRAY_SIZE(name) ))
+    {
+        family_len = ARRAY_SIZE(family);
+        if (PackageFamilyNameFromFullName( name, &family_len, family ) || wcsicmp( family, family_name )) continue;
+        props = package_properties( name, &staged );
+        if (staged) continue;
+#ifndef SG_MUTANT_FINDPKG_NO_FILTER
+        if (filters & (PACKAGE_FILTER_HEAD | PACKAGE_FILTER_RESOURCE | PACKAGE_FILTER_BUNDLE | PACKAGE_FILTER_OPTIONAL))
+        {
+            if ((props & PACKAGE_PROPERTY_RESOURCE) ? !(filters & PACKAGE_FILTER_RESOURCE) : !(filters & PACKAGE_FILTER_HEAD))
+                continue;
+        }
+#endif
+        len = wcslen( name ) + 1;
+        if (n < *count && full_names && buffer && needed + len <= *buffer_len)
+        {
+            full_names[n] = buffer + needed;
+            memcpy( buffer + needed, name, len * sizeof(WCHAR) );
+            if (properties) properties[n] = props;
+        }
+        else ret = ERROR_INSUFFICIENT_BUFFER;
+        needed += len;
+        n++;
+    }
+    *count = n;
+    *buffer_len = needed;
+    return ret;
+}
+
 /***********************************************************************
  *         GetPackagePathByFullName   (kernelbase.@)
  */
