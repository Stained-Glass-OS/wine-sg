From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a folder moved to another filesystem arrives there

wine-sg 7815. SHFileOperation(FO_MOVE) renamed a folder; when the target
was on another filesystem (a USB disk, a home on its own partition) the
rename failed with ERROR_NOT_SAME_DEVICE, which went unnoticed: the
operation said it was done and left the folder where it was. As on
Windows, the folder is made on the other side, its contents are moved into
it (files copy, nested folders likewise), then the empty source goes; a
move that fails otherwise now reports itself aborted. Both a move to a new
name and a move into an existing folder take this path.
---
 dlls/shell32/shlfileop.c | 57 ++++++++++++++++++++++++++++------------
 1 file changed, 40 insertions(+), 17 deletions(-)

diff --git a/dlls/shell32/shlfileop.c b/dlls/shell32/shlfileop.c
index cd16f00..58f9f83 100644
--- a/dlls/shell32/shlfileop.c
+++ b/dlls/shell32/shlfileop.c
@@ -1535,26 +1535,37 @@ static int delete_files(LPSHFILEOPSTRUCTW lpFileOp, const FILE_LIST *flFrom)
     return ERROR_SUCCESS;
 }
 
-/* move a directory to another directory */
-static void move_dir_to_dir(LPSHFILEOPSTRUCTW lpFileOp, const FILE_ENTRY *feFrom, const FILE_ENTRY *feTo)
+/* move a directory to the path TO: renamed there, or merged into it when it exists */
+static void move_dir_to_path(LPSHFILEOPSTRUCTW lpFileOp, const WCHAR *src, const WCHAR *to_path)
 {
-    WCHAR from[MAX_PATH], to[MAX_PATH];
-
-    /* Windows doesn't combine path when FOF_MULTIDESTFILES is set */
-    if (lpFileOp->fFlags & FOF_MULTIDESTFILES)
-        lstrcpyW(to, feTo->szFullPath);
-    else
-        PathCombineW(to, feTo->szFullPath, feFrom->szFilename);
+    WCHAR from[MAX_PATH], to[MAX_PATH + 1];
 
+    lstrcpynW(to, to_path, MAX_PATH);
     to[lstrlenW(to) + 1] = '\0';
 
     /* If destination directory already exists, append source directory
        with wildcard and restart SHFileOperationW */
-    if (PathFileExistsW(to))
+    if (!PathFileExistsW(to))
+    {
+        DWORD err = SHNotifyMoveFileW(src, to);
+
+        /* (its last try may have been a copy, which a folder refuses with another error) */
+        if (err && !MoveFileExW(src, to, 0)) err = GetLastError();
+        /* Stained Glass OS (wine-sg 7815): a folder on another filesystem cannot be renamed there (a
+         * USB disk, a home on its own partition): as on Windows, the folder is made there and its
+         * contents are moved into it, then it goes. This said done and left everything where it was. */
+#ifndef SG_MUTANT_SHMOVE_NO_COPY
+        if (err != ERROR_NOT_SAME_DEVICE || !CreateDirectoryW(to, NULL))
+#endif
+        {
+            if (err) lpFileOp->fAnyOperationsAborted = TRUE;
+            return;
+        }
+    }
     {
         SHFILEOPSTRUCTW fileOp;
 
-        PathCombineW(from, feFrom->szFullPath, L"*.*");
+        PathCombineW(from, src, L"*.*");
         from[lstrlenW(from) + 1] = '\0';
 
         fileOp = *lpFileOp;
@@ -1567,14 +1578,24 @@ static void move_dir_to_dir(LPSHFILEOPSTRUCTW lpFileOp, const FILE_ENTRY *feFrom
            an additional confirmation for a nested folder */
         fileOp.fFlags |= FOF_NOCONFIRMATION;
 
-        if (!SHFileOperationW(&fileOp))
-            RemoveDirectoryW(feFrom->szFullPath);
-        return;
+        /* (an empty folder has nothing to move) */
+        if (PathIsDirectoryEmptyW(src) || (!SHFileOperationW(&fileOp) && !fileOp.fAnyOperationsAborted))
+            RemoveDirectoryW(src);
+        if (fileOp.fAnyOperationsAborted) lpFileOp->fAnyOperationsAborted = TRUE;
     }
+}
+
+/* move a directory to another directory */
+static void move_dir_to_dir(LPSHFILEOPSTRUCTW lpFileOp, const FILE_ENTRY *feFrom, const FILE_ENTRY *feTo)
+{
+    WCHAR to[MAX_PATH];
+
+    /* Windows doesn't combine path when FOF_MULTIDESTFILES is set */
+    if (lpFileOp->fFlags & FOF_MULTIDESTFILES)
+        lstrcpyW(to, feTo->szFullPath);
     else
-    {
-        SHNotifyMoveFileW(feFrom->szFullPath, to);
-    }
+        PathCombineW(to, feTo->szFullPath, feFrom->szFilename);
+    move_dir_to_path(lpFileOp, feFrom->szFullPath, to);
 }
 
 /* move a file to another directory */
@@ -1688,6 +1709,8 @@ static int move_files(LPSHFILEOPSTRUCTW lpFileOp, const FILE_LIST *flFrom, const
             else
                 move_file_to_dir(lpFileOp, entryToMove, fileDest);
         }
+        else if (IsAttribDir(entryToMove->attributes))
+            move_dir_to_path(lpFileOp, entryToMove->szFullPath, fileDest->szFullPath);
         else
             SHNotifyMoveFileW(entryToMove->szFullPath, fileDest->szFullPath);
     }
-- 
