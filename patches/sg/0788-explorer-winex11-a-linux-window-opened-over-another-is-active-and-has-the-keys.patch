From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer, winex11: a Linux window opened over another is active and has the keys

David 2026-10-03: Linux apps such as the terminal opened "behind other apps
and not in focus" (0778 brought the frame in front); a Linux Terminal
opened over PowerShell still got no keys until it was clicked.

Two things in the frame's first moments: explorer shows the frame -- active
-- before the program's window is taken into it, and taking it in
(reparenting) unmaps and maps it again: explorer hid the frame on the unmap,
which made the window behind active, and showed it again on the map without
activating it. Now a frame active when it is hidden is activated again when
it is shown (SgWasActive). And winex11 gave the X focus to the frame when it
was activated, before the program's window was in it: once it is attached,
and whenever it maps, the program's window gets the X focus if its frame is
in front (WM_X11DRV_SG_EMBED_FOCUS).

(sg-compositor 0.2.0+sg34 moves the Wayland keyboard on from the program's
window when it stops being a top-level of its own: the third part of it.)

Test: test/linuxembed-gate.sh 11 (mutants SG_MUTANT_FRAME_LOSES_ACTIVATION,
SG_MUTANT_EMBED_NO_FIRST_FOCUS); QA VM session: a Linux Terminal opened
from Start over Command Prompt takes the typing with no click.
---
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -695,6 +695,14 @@
         {
             d = data->display;
             set_title( hwnd, d, (Window)wp );
+            /* the frame was shown, and made active, before the program's
+             * window was in it: the X focus went to the frame, and the
+             * program opened in front without it -- typing went nowhere
+             * until it was clicked (David 2026-10-03, a Linux Terminal
+             * opened over PowerShell). In front, it has it now. */
+#ifndef SG_MUTANT_EMBED_NO_FIRST_FOCUS
+            if (NtUserGetForegroundWindow() == hwnd) sg_embed_focus( data );
+#endif
             X11DRV_expect_error( d, ignore_error, NULL );
             big = XGetWindowAttributes( d, (Window)wp, &attr );
             if (X11DRV_check_error()) big = FALSE;
@@ -734,6 +742,17 @@
 
     switch (msg)
     {
+    case WM_X11DRV_SG_EMBED_FOCUS:
+        /* the program's window mapped (it may map after it was attached): in
+         * front, its frame gives it the X focus, as when it is activated */
+#ifndef SG_MUTANT_EMBED_NO_FIRST_FOCUS
+        if (NtUserGetForegroundWindow() == hwnd && (data = get_win_data( hwnd )))
+        {
+            sg_embed_focus( data );
+            release_win_data( data );
+        }
+#endif
+        return 0;
     case WM_X11DRV_SG_EMBED_ACTIVATE:
         /* a click into the program: its frame comes in front, as a window
          * clicked does -- Wine saw no click on it (the press went on to the
@@ -990,7 +1009,11 @@
         if (event->xunmap.window == event->xunmap.event) NtUserPostMessage( hwnd, WM_SG_EMBED_SHOWN, 0, 0 );
         break;
     case MapNotify:
-        if (event->xmap.window == event->xmap.event) NtUserPostMessage( hwnd, WM_SG_EMBED_SHOWN, 1, 0 );
+        if (event->xmap.window == event->xmap.event)
+        {
+            NtUserPostMessage( hwnd, WM_SG_EMBED_SHOWN, 1, 0 );
+            NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_FOCUS, 0, 0 );
+        }
         break;
     case DestroyNotify:
         if (event->xdestroywindow.window == event->xdestroywindow.event) NtUserPostMessage( hwnd, WM_SG_EMBED_GONE, 0, 0 );
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3683,6 +3683,7 @@
     case WM_X11DRV_SG_EMBED_SIZE:
     case WM_X11DRV_SG_EMBED_FULLSCREEN:
     case WM_X11DRV_SG_EMBED_MAXIMIZE:
+    case WM_X11DRV_SG_EMBED_FOCUS:
         return sg_embed_message( hwnd, msg, wp, lp );
     default:
         FIXME( "got window msg %x hwnd %p wp %lx lp %lx\n", msg, hwnd, (long)wp, lp );
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -618,7 +618,8 @@
     WM_X11DRV_SG_EMBED_TITLE,
     WM_X11DRV_SG_EMBED_SIZE,
     WM_X11DRV_SG_EMBED_FULLSCREEN,
-    WM_X11DRV_SG_EMBED_MAXIMIZE
+    WM_X11DRV_SG_EMBED_MAXIMIZE,
+    WM_X11DRV_SG_EMBED_FOCUS
 };
 
 /* _NET_WM_STATE properties that we keep track of */
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1687,7 +1687,25 @@
             if ((wp & 0xfff0) == SC_RESTORE && !IsIconic( hwnd )) { SetForegroundWindow( hwnd ); return 0; }
             break;
         case WM_SG_EMBED_SHOWN:
-            ShowWindow( hwnd, wp ? SW_SHOWNA : SW_HIDE );
+            /* Taken into its frame, the program's window unmaps and maps again
+             * (reparented): the frame, active, was hidden -- the window behind
+             * it was made active -- and shown again without the focus. A
+             * Linux Terminal opened over PowerShell got no keys until clicked
+             * (David 2026-10-03). The frame active when it went is active
+             * when it comes back. */
+            if (!wp)
+            {
+#ifndef SG_MUTANT_FRAME_LOSES_ACTIVATION
+                if (GetForegroundWindow() == hwnd) SetPropW( hwnd, L"SgWasActive", (HANDLE)1 );
+#endif
+                ShowWindow( hwnd, SW_HIDE );
+            }
+            else if (RemovePropW( hwnd, L"SgWasActive" ))
+            {
+                ShowWindow( hwnd, SW_SHOW );
+                SetForegroundWindow( hwnd );
+            }
+            else ShowWindow( hwnd, SW_SHOWNA );
             return 0;
         case WM_SG_EMBED_GONE:
             sg_remove_xwin_button( win );
