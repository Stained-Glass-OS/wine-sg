+    SetTextAlign( hDC, TA_TOP | TA_LEFT );
+    ExtTextOutW( hDC, x, y, 0, NULL, editor->placeholder, lstrlenW( editor->placeholder ), NULL );
+    select_style( &c, NULL );
+  }
   if (editor_opaque( editor ))
   {
     if (c.pt.y + editor->nTotalLength < c.rcView.bottom)
