+++ b/dlls/riched20/paint.c
@@ -83,6 +83,22 @@
       draw_paragraph( &c, para );
     para = para_next( para );
   }
+  /* Stained Glass OS (wine-sg 1511): the placeholder text while the
+   * control is empty, greyed, where the first line starts */
+#ifndef SG_MUTANT_RICHED_PLACEHOLDER_NOT_DRAWN
+  if (editor->placeholder && editor->placeholder[0] && !ME_GetTextLength( editor ))
+#else
+  if (0)
+#endif
+  {
