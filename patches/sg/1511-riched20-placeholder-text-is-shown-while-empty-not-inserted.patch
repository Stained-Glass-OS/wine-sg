From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: placeholder text is shown while empty, not inserted

EM_SETTEXTEX with ST_PLACEHOLDERTEXT gives a RichEdit the text it shows,
greyed, while it is empty -- not its text. Office's React Native text
boxes set their placeholders so: Word's start screen box ("Describe the
document you'd like to write") and its "Search for a file" got the
placeholder inserted as text, and what the user typed went after it.

The placeholder is kept apart (freed with the editor), the control's text
is left as it was, and it is drawn in the grey text colour where the first
line starts whenever the text is empty. ST_PLACEHOLDERTEXT and
ST_PLAINTEXTONLY are added to include/richedit.h.

Wine's RichEdit editor tests: 10681, no failures, as before. In the QA VM
Word's start screen box shows its placeholder greyed and typing replaces
it.

Gate: test/richplaceholder-gate.sh. Mutants
SG_MUTANT_RICHED_PLACEHOLDER_AS_TEXT, SG_MUTANT_RICHED_PLACEHOLDER_NOT_DRAWN.
---
--- a/include/richedit.h
+++ b/include/richedit.h
@@ -1070,6 +1070,8 @@
 #define ST_SELECTION          0x00000002
 #define ST_NEWCHARS           0x00000004
 #define ST_UNICODE            0x00000008
+#define ST_PLACEHOLDERTEXT    0x00000010
+#define ST_PLAINTEXTONLY      0x00000020
 
 /* Flags for EM_AUTOURLDETECT message */
 #define AURL_ENABLEURL            0x00000001
--- a/dlls/riched20/editstr.h
+++ b/dlls/riched20/editstr.h
@@ -451,6 +451,7 @@
   struct list style_list;
   struct list reobj_list;
   struct wine_rb_tree marked_paras;
+  WCHAR *placeholder;   /* Stained Glass OS: EM_SETTEXTEX's ST_PLACEHOLDERTEXT, shown while empty */
 } ME_TextEditor;
 
 typedef struct tagME_Context
--- a/dlls/riched20/editor.c
+++ b/dlls/riched20/editor.c
@@ -3144,6 +3144,7 @@
 
   OleUninitialize();
 
+  free(editor->placeholder);
   free(editor->pBuffer);
   free(editor->pCursors);
   free(editor);
@@ -3471,6 +3472,32 @@
           bUnicode ? debugstr_w((LPCWSTR)lParam) : debugstr_a((LPCSTR)lParam),
           pStruct->flags, pStruct->codepage);
 
+#ifndef SG_MUTANT_RICHED_PLACEHOLDER_AS_TEXT
+    /* Stained Glass OS (wine-sg 1511): placeholder text is not the control's
+     * text -- it is shown, greyed, while the control is empty (Word's start
+     * screen box, "Describe the document you'd like to write": inserted as
+     * text, it stayed when the user typed and their words went after it) */
+    if (pStruct->flags & ST_PLACEHOLDERTEXT)
+    {
+      WCHAR *text = NULL;
+      free(editor->placeholder);
+      editor->placeholder = NULL;
+      if (lParam)
+      {
+        wszText = ME_ToUnicode(bUnicode ? CP_UNICODE : pStruct->codepage, (void *)lParam, &len);
+        if (len && (text = malloc((len + 1) * sizeof(WCHAR))))
+        {
+          memcpy(text, wszText, len * sizeof(WCHAR));
+          text[len] = 0;
+        }
+        ME_EndToUnicode(bUnicode ? CP_UNICODE : pStruct->codepage, wszText);
+      }
+      editor->placeholder = text;
+      if (!ME_GetTextLength(editor)) ITextHost_TxInvalidateRect(editor->texthost, NULL, TRUE);
+      return 1;
+    }
+#endif
+
     bSelection = (pStruct->flags & ST_SELECTION) != 0;
     if (bSelection) {
       int nStartCursor = ME_GetSelectionOfs(editor, &from, &to);
