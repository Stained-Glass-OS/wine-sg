From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: IWICMetadataWriterInfo::GetHeader returns the writer's header

GetHeader was E_NOTIMPL. A metadata writer's Containers\{container} key now carries Header, Position and DataOffset values, written at registration from the pattern its reader matches exactly (the last such pattern: GIF89a for the screen descriptor), and GetHeader returns them the way GetPatterns returns patterns: a WICMetadataHeader followed by the header bytes, WINCODEC_ERR_INSUFFICIENTBUFFER for a short buffer, WINCODEC_ERR_COMPONENTNOTFOUND for a container the writer does not support, E_INVALIDARG without a container or size pointer. A container with no exact pattern (IFD in TIFF) has an empty header.
---
--- a/dlls/windowscodecs/info.c
+++ b/dlls/windowscodecs/info.c
@@ -2182,11 +2182,59 @@
     return S_OK;
 }
 
+/* wine-sg 9501: the header a metadata writer puts in front of its data in a container format, from the
+ * writer's Containers\{container} key (Header, Position, DataOffset values), returned the way
+ * GetPatterns returns patterns: the structure followed by the header bytes. */
 static HRESULT WINAPI MetadataWriterInfo_GetHeader(IWICMetadataWriterInfo *iface,
     REFGUID container, UINT size, WICMetadataHeader *header, UINT *actual)
 {
+    MetadataReaderInfo *This = impl_from_IWICMetadataReaderInfo((IWICMetadataReaderInfo *)iface);
+    WCHAR keyname[11 + 39];
+    DWORD length = 0, valuesize;
+    ULARGE_INTEGER position, offset;
+    HKEY key;
+    LONG res;
+
+    TRACE("(%p,%s,%u,%p,%p)\n", iface, debugstr_guid(container), size, header, actual);
+
+    if (!container || !actual) return E_INVALIDARG;
+
+#ifndef SG_MUTANT_WIC_NO_HEADER
+    if (!get_metadata_container(This, container)) return WINCODEC_ERR_COMPONENTNOTFOUND;
+
+    lstrcpyW(keyname, L"Containers\\");
+    StringFromGUID2(container, keyname + lstrlenW(keyname), 39);
+    if (RegOpenKeyExW(This->classkey, keyname, 0, KEY_READ, &key)) return WINCODEC_ERR_COMPONENTNOTFOUND;
+
+    res = RegGetValueW(key, NULL, L"Header", RRF_RT_REG_BINARY, NULL, NULL, &length);
+    if (res) length = 0;
+    position.QuadPart = offset.QuadPart = 0;
+    valuesize = sizeof(position);
+    RegGetValueW(key, NULL, L"Position", RRF_RT_DWORD|RRF_RT_QWORD, NULL, &position, &valuesize);
+    valuesize = sizeof(offset);
+    RegGetValueW(key, NULL, L"DataOffset", RRF_RT_DWORD|RRF_RT_QWORD, NULL, &offset, &valuesize);
+
+    *actual = sizeof(*header) + length;
+    if (header)
+    {
+        if (size < *actual)
+        {
+            RegCloseKey(key);
+            return WINCODEC_ERR_INSUFFICIENTBUFFER;
+        }
+        header->Position = position;
+        header->Length = length;
+        header->Header = length ? (BYTE *)(header + 1) : NULL;
+        header->DataOffset = offset;
+        valuesize = length;
+        if (length) RegGetValueW(key, NULL, L"Header", RRF_RT_REG_BINARY, NULL, header->Header, &valuesize);
+    }
+    RegCloseKey(key);
+    return S_OK;
+#else
     FIXME("(%p,%s,%u,%p,%p): stub\n", iface, debugstr_guid(container), size, header, actual);
     return E_NOTIMPL;
+#endif
 }
 
 static HRESULT WINAPI MetadataWriterInfo_CreateInstance(IWICMetadataWriterInfo *iface,
--- a/dlls/windowscodecs/regsvr.c
+++ b/dlls/windowscodecs/regsvr.c
@@ -869,6 +869,33 @@
                     RegCloseKey(pattern_key);
                 }
 
+                /* wine-sg 9501: a writer's header in the container (IWICMetadataWriterInfo::GetHeader):
+                 * the bytes it writes are those its reader matches -- the last pattern that is matched
+                 * exactly (GIF89a rather than GIF87a for the screen descriptor) -- with that pattern's
+                 * position and data offset. */
+                if (res == ERROR_SUCCESS && IsEqualGUID(category, &CATID_WICMetadataWriter))
+                {
+                    const struct metadata_pattern *header = NULL;
+                    DWORD j;
+
+                    for (i=0; container->patterns[i].length; i++)
+                    {
+                        for (j = 0; j < container->patterns[i].length; j++)
+                            if (container->patterns[i].mask[j] != 0xff) break;
+                        if (j == container->patterns[i].length) header = &container->patterns[i];
+                    }
+                    if (header)
+                    {
+                        res = RegSetValueExA(format_key, "Header", 0, REG_BINARY, header->pattern, header->length);
+                        if (res == ERROR_SUCCESS)
+                            res = RegSetValueExA(format_key, position_valuename, 0, REG_DWORD,
+                                                 (const BYTE*)&header->position, 4);
+                        if (res == ERROR_SUCCESS)
+                            res = RegSetValueExA(format_key, dataoffset_valuename, 0, REG_DWORD,
+                                                 (const BYTE*)&header->data_offset, 4);
+                    }
+                }
+
                 RegCloseKey(format_key);
             }
             RegCloseKey(containers_key);
