+/* ---- times ------------------------------------------------------------------ */
+
+/* "2026-10-06T08:00:00[.fff][Z|+hh:mm|-hh:mm]": without a zone it is the
+ * machine's local time */
+static BOOL parse_boundary(const WCHAR *s, ULONGLONG *out)
+{
+    SYSTEMTIME st = { 0 }, utc;
+    FILETIME ft;
+    const WCHAR *p;
+    int sign = 0, oh = 0, om = 0;
+
+    if (swscanf(s, L"%hu-%hu-%huT%hu:%hu:%hu", &st.wYear, &st.wMonth, &st.wDay, &st.wHour, &st.wMinute,
+                &st.wSecond) < 5)
+        return FALSE;
+    p = wcschr(s, 'T');
+    if (p) p = wcspbrk(p, L"Z+-");
+    if (p && *p == 'Z') sign = 2;
+    else if (p && swscanf(p + 1, L"%d:%d", &oh, &om) >= 1) sign = *p == '+' ? 1 : -1;
+
+    if (sign)
+    {
+        if (!SystemTimeToFileTime(&st, &ft)) return FALSE;
+        *out = ((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+        if (sign == 1) *out -= (oh * 60ULL + om) * 60 * TICKS_PER_SECOND;
+        else if (sign == -1) *out += (oh * 60ULL + om) * 60 * TICKS_PER_SECOND;
+        return TRUE;
+    }
+    if (!TzSpecificLocalTimeToSystemTime(NULL, &st, &utc) || !SystemTimeToFileTime(&utc, &ft)) return FALSE;
+    *out = ((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    return TRUE;
+}
+
+/* an ISO 8601 duration, "P1DT2H3M4S"; years and months as 365 and 30 days */
+static ULONGLONG parse_duration(const WCHAR *s)
+{
+    ULONGLONG total = 0;
+    BOOL time = FALSE;
+    double n;
+    WCHAR *end;
+
+    if (!s || *s != 'P') return 0;
+    for (s++; *s; )
+    {
+        if (*s == 'T') { time = TRUE; s++; continue; }
+        n = wcstod(s, &end);
+        if (end == s) break;
+        s = end;
+        switch (*s)
+        {
+        case 'Y': total += n * 365 * TICKS_PER_DAY; break;
+        case 'M': total += time ? n * 60 * TICKS_PER_SECOND : n * 30 * TICKS_PER_DAY; break;
+        case 'W': total += n * 7 * TICKS_PER_DAY; break;
+        case 'D': total += n * TICKS_PER_DAY; break;
+        case 'H': total += n * 3600 * TICKS_PER_SECOND; break;
+        case 'S': total += n * TICKS_PER_SECOND; break;
+        default: return total;
+        }
+        s++;
+    }
+    return total;
+}
+
+/* The first time after "after" that comes from base and its repetitions;
+ * NEVER if none. */
+static ULONGLONG repeat_after(const struct run_trigger *t, ULONGLONG base, ULONGLONG after)
+{
+    ULONGLONG k, when;
+
+    if (base > after) return base;
+    if (!t->interval) return NEVER;
+    k = (after - base) / t->interval + 1;
+    when = base + k * t->interval;
+    if (t->duration && k * t->interval >= t->duration) return NEVER;
+    return when;
+}
+
+/* the last base of a calendar trigger at or before "at", and the first one
+ * after it */
+static void calendar_bases(const struct run_trigger *t, ULONGLONG at, ULONGLONG *last, ULONGLONG *next)
+{
+    ULONGLONG day = 0, period;
+    int i;
+
+    *last = NEVER;
+    *next = NEVER;
+    if (at < t->start)
+    {
+        *next = t->start;
+        if (t->kind == TRIGGER_WEEKLY) *next = NEVER;   /* found below */
+        else return;
+    }
+    else
+        day = (at - t->start) / TICKS_PER_DAY;
+
+    if (t->kind == TRIGGER_DAILY)
+    {
+        period = (ULONGLONG)max(1, t->days_interval);
+        *last = t->start + (day / period) * period * TICKS_PER_DAY;
+        *next = *last + period * TICKS_PER_DAY;
+        return;
+    }
+    /* weekly: the days of the week chosen, in every weeks_interval-th week
+     * counted from the start's */
+    {
+        SYSTEMTIME st;
+        FILETIME ft;
+        int start_wday, weeks = max(1, t->weeks_interval);
+        LONGLONG d, from = at < t->start ? 0 : (LONGLONG)day;
+
+        ft.dwLowDateTime = (DWORD)t->start;
+        ft.dwHighDateTime = (DWORD)(t->start >> 32);
+        FileTimeToSystemTime(&ft, &st);
+        start_wday = st.wDayOfWeek;
+        for (i = 0, d = from; i <= 7 * weeks + 7 && d >= 0; i++, d--)
+        {
+            int wday = (start_wday + d) % 7, week = (int)((d + start_wday) / 7);
+            ULONGLONG base = t->start + (ULONGLONG)d * TICKS_PER_DAY;
+
+            if ((t->days_of_week & (1 << wday)) && !(week % weeks) && base <= at) { *last = base; break; }
+        }
+        for (i = 0, d = from; i <= 7 * weeks + 7; i++, d++)
+        {
+            int wday = (start_wday + d) % 7, week = (int)((d + start_wday) / 7);
+            ULONGLONG base = t->start + (ULONGLONG)d * TICKS_PER_DAY;
+
+            if ((t->days_of_week & (1 << wday)) && !(week % weeks) && base > at) { *next = base; break; }
+        }
+    }
+}
+
+static ULONGLONG trigger_next(const struct run_trigger *t, ULONGLONG after)
+{
+    ULONGLONG when = NEVER, last, next;
+
+    if (!t->enabled) return NEVER;
+    switch (t->kind)
+    {
+    case TRIGGER_TIME:
+        if (!t->start) return NEVER;
+        when = repeat_after(t, t->start, after);
+        break;
+    case TRIGGER_DAILY:
+    case TRIGGER_WEEKLY:
+        if (!t->start) return NEVER;
+        calendar_bases(t, after, &last, &next);
+        if (last != NEVER) when = repeat_after(t, last, after);
+        if (next < when) when = next;
+        break;
+    case TRIGGER_BOOT:
+    case TRIGGER_LOGON:
+    case TRIGGER_REGISTRATION:
+        if (!t->event) return NEVER;
+        when = repeat_after(t, t->event, after);
+        break;
+    }
+    if (when != NEVER && t->end != NEVER && when > t->end) return NEVER;
+    if (when != NEVER && t->start && t->kind >= TRIGGER_BOOT && when < t->start) when = t->start;
+    return when;
+}
+
+/* the last time at or before "at" a trigger was due: for making up a missed run */
+static ULONGLONG trigger_last(const struct run_trigger *t, ULONGLONG at)
+{
+    ULONGLONG last = 0, next, base = 0, k;
+
+    if (!t->enabled || !t->start || t->kind >= TRIGGER_BOOT || t->start > at) return 0;
+    if (t->kind == TRIGGER_TIME) base = t->start;
+    else
+    {
+        calendar_bases(t, at, &last, &next);
+        if (last == NEVER) return 0;
+        base = last;
+    }
+    if (!t->interval) last = base;
+    else
+    {
+        k = (at - base) / t->interval;
+        if (t->duration && k * t->interval >= t->duration) k = (t->duration - 1) / t->interval;
+        last = base + k * t->interval;
+    }
+    if (t->end != NEVER && last > t->end) return 0;
+    return last;
+}
