+/*
+ * What runs here: tasks whose principal is the system's own accounts (SYSTEM,
+ * LOCAL SERVICE, NETWORK SERVICE) -- the service runs as SYSTEM. That is
+ * what browsers' and other programs' machine-wide updaters register (their
+ * installers run elevated), so they keep themselves up to date. A task of a
+ * particular user is that user's to run, in their session; it is left alone.
+ *
+ * Triggers: a time (once, or repeating every Interval for Duration), daily
+ * and weekly calendars (with their repetitions), at start (boot; the
+ * service starts with the system), at log-on for these accounts' tasks (the
+ * first log-on after start is taken as the service's start), and at
+ * registration. StartBoundary/EndBoundary, Delay, Enabled, the settings'
+ * Enabled, DisallowStartIfOnBatteries, StartWhenAvailable (a run missed
+ * while the machine was off is made up), MultipleInstancesPolicy and
+ * ExecutionTimeLimit are honoured. Exec actions run in order, each waited
+ * for; the last one's exit code is the task's result.
+ *
+ * Each task's last run time, result and whether it was disabled are kept in
+ * HKLM\Software\Wine\Task Scheduler\State, so they last across restarts.
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "objbase.h"
+#include "xmllite.h"
+#include "taskschd.h"
+#include "wine/debug.h"
+#include "wine/list.h"
+
+#include "schedsvc_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(schedsvc);
+
+#define TICKS_PER_SECOND 10000000ULL
+#define TICKS_PER_DAY    (86400ULL * TICKS_PER_SECOND)
+#define NEVER            (~0ULL)
+#define RUN_IGNORE_CONSTRAINTS 0x2   /* TASK_RUN_IGNORE_CONSTRAINTS */
+
+enum trigger_kind { TRIGGER_TIME, TRIGGER_DAILY, TRIGGER_WEEKLY, TRIGGER_BOOT, TRIGGER_LOGON, TRIGGER_REGISTRATION };
+
+struct run_trigger
+{
+    enum trigger_kind kind;
+    BOOL enabled;
+    ULONGLONG start, end;           /* UTC; end NEVER when there is none */
+    ULONGLONG interval, duration;   /* repetition; duration 0 = indefinitely */
+    ULONGLONG delay;
+    ULONGLONG event;                /* when a boot, log-on or registration trigger fired (+ delay); 0 = not */
+    int days_interval, weeks_interval, days_of_week;
+};
+
+struct run_action
+{
+    WCHAR *command, *arguments, *directory;
+};
+
+struct run_task
+{
+    struct list entry;
+    WCHAR *path;                    /* "\Folder\Name" */
+    FILETIME written;               /* the file's last write, to see changes */
+    BOOL ours;                      /* a system account's task */
+    BOOL enabled, allow_demand, start_when_available, on_batteries_no;
+    int policy;                     /* TASK_INSTANCES_POLICY */
+    ULONGLONG time_limit;           /* 0 = none */
+    struct run_trigger *triggers;
+    unsigned int trigger_count;
+    struct run_action *actions;
+    unsigned int action_count;
+    /* state */
+    HANDLE thread;                  /* runs the actions, while it runs */
+    HANDLE process;                 /* the action running now */
+    ULONGLONG started;
+    BOOL queued, seen;
+    ULONGLONG last_run;             /* UTC, 0 never */
+    DWORD last_result;
+    BOOL disabled;                  /* by EnableTask */
+    ULONGLONG next;                 /* next scheduled run */
+    WCHAR *run_args[32];            /* Run's parameters, for $(Arg0).. */
+    unsigned int run_arg_count;
+};
+
+static struct list tasks = LIST_INIT(tasks);
