+/* ---- the definitions -------------------------------------------------------------------- */
+
+static IXmlReader *xml_reader(const WCHAR *xml, IStream **stream)
+{
+    IXmlReader *reader;
+    HGLOBAL hmem;
+    void *buf;
+    SIZE_T size = wcslen(xml) * sizeof(WCHAR);
+
+    if (!(hmem = GlobalAlloc(0, size))) return NULL;
+    buf = GlobalLock(hmem);
+    memcpy(buf, xml, size);
+    GlobalUnlock(hmem);
+    if (FAILED(CreateStreamOnHGlobal(hmem, TRUE, stream)))
+    {
+        GlobalFree(hmem);
+        return NULL;
+    }
+    if (FAILED(CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL)))
+    {
+        IStream_Release(*stream);
+        return NULL;
+    }
+    if (FAILED(IXmlReader_SetInput(reader, (IUnknown *)*stream)))
+    {
+        IXmlReader_Release(reader);
+        IStream_Release(*stream);
+        return NULL;
+    }
+    return reader;
+}
+
+/* the text of the element the reader is on, copied; NULL for an empty one */
+static WCHAR *element_text(IXmlReader *reader)
+{
+    const WCHAR *value;
+    XmlNodeType type;
+
+    if (IXmlReader_IsEmptyElement(reader)) return NULL;
+    while (IXmlReader_Read(reader, &type) == S_OK)
+    {
+        if (type == XmlNodeType_Text && SUCCEEDED(IXmlReader_GetValue(reader, &value, NULL))) return wcsdup(value);
+        if (type == XmlNodeType_EndElement) return NULL;
+    }
+    return NULL;
+}
+
+static BOOL text_true(WCHAR *text, BOOL dflt)
+{
+    BOOL ret = dflt;
+
+    if (text) ret = !wcscmp(text, L"true") || !wcscmp(text, L"1");
+    free(text);
+    return ret;
+}
