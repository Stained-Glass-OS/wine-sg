+static ULONGLONG service_start;
+
+static const WCHAR state_key[] = L"Software\\Wine\\Task Scheduler\\State";
+
+struct saved_state
+{
+    FILETIME last_run;
+    DWORD last_result;
+    DWORD disabled;
+};
+
+static ULONGLONG now_utc(void)
+{
+    FILETIME ft;
+    GetSystemTimeAsFileTime(&ft);
+    return ((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+}
+
+static void save_state(const struct run_task *task)
+{
+    struct saved_state state;
+    HKEY key;
+
+    state.last_run.dwLowDateTime = (DWORD)task->last_run;
+    state.last_run.dwHighDateTime = (DWORD)(task->last_run >> 32);
+    state.last_result = task->last_result;
+    state.disabled = task->disabled;
+    if (RegCreateKeyExW(HKEY_LOCAL_MACHINE, state_key, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL)) return;
+    RegSetValueExW(key, task->path, 0, REG_BINARY, (const BYTE *)&state, sizeof(state));
+    RegCloseKey(key);
+}
+
+static void load_state(struct run_task *task)
+{
+    struct saved_state state;
+    DWORD size = sizeof(state);
+
+    task->last_run = 0;
+    task->last_result = SCHED_S_TASK_HAS_NOT_RUN;
+    task->disabled = FALSE;
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, state_key, task->path, RRF_RT_REG_BINARY, NULL, &state, &size) ||
+        size != sizeof(state))
+        return;
+    task->last_run = ((ULONGLONG)state.last_run.dwHighDateTime << 32) | state.last_run.dwLowDateTime;
+    task->last_result = state.last_result;
+    task->disabled = !!state.disabled;
+}
