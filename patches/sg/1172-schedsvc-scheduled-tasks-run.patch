+        L"S-1-5-18", L"S-1-5-19", L"S-1-5-20", L"SYSTEM", L"LocalSystem", L"NT AUTHORITY\\SYSTEM",
+        L"LOCAL SERVICE", L"NT AUTHORITY\\LOCAL SERVICE", L"LocalService", L"NETWORK SERVICE",
+        L"NT AUTHORITY\\NETWORK SERVICE", L"NetworkService",
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(names); i++) if (!wcsicmp(id, names[i])) return TRUE;
+    return FALSE;
+}
+
+struct parse
+{
+    struct run_task *task;
+    struct run_trigger *trigger;    /* the one being read */
+    struct run_action *action;
+    BOOL in_principal, in_settings, in_repetition, in_days_of_week, user_seen;
+};
+
+static void parse_element(IXmlReader *reader, const WCHAR *name, UINT depth, struct parse *p, UINT *trigger_depth)
+{
+    struct run_task *task = p->task;
+    struct run_trigger *t = p->trigger;
+    WCHAR *text;
+    ULONGLONG when;
+    static const WCHAR *const days[] = { L"Sunday", L"Monday", L"Tuesday", L"Wednesday", L"Thursday", L"Friday",
+                                         L"Saturday" };
+    unsigned int i;
+
+    if (t)
+    {
+        if (!wcscmp(name, L"Repetition")) { p->in_repetition = TRUE; return; }
+        if (!wcscmp(name, L"ScheduleByDay")) { t->kind = TRIGGER_DAILY; return; }
+        if (!wcscmp(name, L"ScheduleByWeek")) { t->kind = TRIGGER_WEEKLY; t->days_of_week = 0; return; }
+        if (!wcscmp(name, L"ScheduleByMonth") || !wcscmp(name, L"ScheduleByMonthDayOfWeek"))
+        {
+            FIXME("%s is not implemented; the trigger is off\n", debugstr_w(name));
+            t->enabled = FALSE;
+            return;
+        }
+        if (!wcscmp(name, L"DaysOfWeek")) { p->in_days_of_week = TRUE; return; }
+        if (p->in_days_of_week)
+        {
+            for (i = 0; i < ARRAY_SIZE(days); i++) if (!wcscmp(name, days[i])) t->days_of_week |= 1 << i;
+            return;
+        }
+        text = element_text(reader);
+        if (!text) return;
+        if (p->in_repetition && !wcscmp(name, L"Interval")) t->interval = parse_duration(text);
+        else if (p->in_repetition && !wcscmp(name, L"Duration")) t->duration = parse_duration(text);
+        else if (!wcscmp(name, L"StartBoundary") && parse_boundary(text, &when)) t->start = when;
+        else if (!wcscmp(name, L"EndBoundary") && parse_boundary(text, &when)) t->end = when;
+        else if (!wcscmp(name, L"Enabled")) t->enabled = !wcscmp(text, L"true") || !wcscmp(text, L"1");
+        else if (!wcscmp(name, L"Delay")) t->delay = parse_duration(text);
+        else if (!wcscmp(name, L"DaysInterval")) t->days_interval = max(1, wcstol(text, NULL, 10));
+        else if (!wcscmp(name, L"WeeksInterval")) t->weeks_interval = max(1, wcstol(text, NULL, 10));
+        free(text);
+        return;
+    }
+
+    if (!wcscmp(name, L"TimeTrigger") || !wcscmp(name, L"CalendarTrigger") || !wcscmp(name, L"BootTrigger") ||
+        !wcscmp(name, L"LogonTrigger") || !wcscmp(name, L"RegistrationTrigger"))
+    {
+        struct run_trigger *triggers = realloc(task->triggers, (task->trigger_count + 1) * sizeof(*triggers));
+
+        if (!triggers) return;
+        task->triggers = triggers;
+        t = p->trigger = &triggers[task->trigger_count++];
+        memset(t, 0, sizeof(*t));
+        t->enabled = TRUE;
+        t->end = NEVER;
+        t->days_interval = t->weeks_interval = 1;
+        t->days_of_week = 0x7f;
+        t->kind = !wcscmp(name, L"TimeTrigger") ? TRIGGER_TIME : !wcscmp(name, L"CalendarTrigger") ? TRIGGER_DAILY
+                : !wcscmp(name, L"BootTrigger") ? TRIGGER_BOOT : !wcscmp(name, L"LogonTrigger") ? TRIGGER_LOGON
+                : TRIGGER_REGISTRATION;
+        *trigger_depth = depth;
+        if (IXmlReader_IsEmptyElement(reader)) p->trigger = NULL;
+        return;
+    }
+    if (!wcscmp(name, L"IdleTrigger") || !wcscmp(name, L"EventTrigger") ||
+        !wcscmp(name, L"SessionStateChangeTrigger"))
+    {
+        FIXME("%s is not implemented\n", debugstr_w(name));
+        return;
+    }
+    if (!wcscmp(name, L"Principal")) { p->in_principal = TRUE; return; }
+    if (!wcscmp(name, L"Settings")) { p->in_settings = TRUE; return; }
+    if (!wcscmp(name, L"Exec"))
+    {
+        struct run_action *actions = realloc(task->actions, (task->action_count + 1) * sizeof(*actions));
+
+        if (!actions) return;
+        task->actions = actions;
+        p->action = &actions[task->action_count++];
+        memset(p->action, 0, sizeof(*p->action));
+        return;
+    }
+    if (p->action)
+    {
+        if (!wcscmp(name, L"Command")) { free(p->action->command); p->action->command = element_text(reader); }
+        else if (!wcscmp(name, L"Arguments")) { free(p->action->arguments); p->action->arguments = element_text(reader); }
+        else if (!wcscmp(name, L"WorkingDirectory")) { free(p->action->directory); p->action->directory = element_text(reader); }
+        return;
+    }
+    if (p->in_principal)
+    {
+        if (!wcscmp(name, L"UserId") || !wcscmp(name, L"GroupId"))
+        {
+            if ((text = element_text(reader)))
+            {
+                if (!p->user_seen) task->ours = is_system_account(text);
+                else task->ours = task->ours && is_system_account(text);
+                p->user_seen = TRUE;
+            }
+            free(text);
+        }
+        return;
+    }
+    if (p->in_settings)
+    {
+        if (!wcscmp(name, L"Enabled")) task->enabled = text_true(element_text(reader), TRUE);
+        else if (!wcscmp(name, L"AllowStartOnDemand")) task->allow_demand = text_true(element_text(reader), TRUE);
+        else if (!wcscmp(name, L"StartWhenAvailable")) task->start_when_available = text_true(element_text(reader), FALSE);
+        else if (!wcscmp(name, L"DisallowStartIfOnBatteries")) task->on_batteries_no = text_true(element_text(reader), TRUE);
+        else if (!wcscmp(name, L"ExecutionTimeLimit"))
+        {
+            text = element_text(reader);
+            task->time_limit = parse_duration(text);
+            free(text);
+        }
+        else if (!wcscmp(name, L"MultipleInstancesPolicy"))
+        {
+            text = element_text(reader);
+            if (text)
+                task->policy = !wcscmp(text, L"Parallel") ? TASK_INSTANCES_PARALLEL : !wcscmp(text, L"Queue")
+                        ? TASK_INSTANCES_QUEUE : !wcscmp(text, L"StopExisting") ? TASK_INSTANCES_STOP_EXISTING
+                        : TASK_INSTANCES_IGNORE_NEW;
+            free(text);
+        }
+        else if (!wcscmp(name, L"IdleSettings") || !wcscmp(name, L"NetworkSettings") ||
+                 !wcscmp(name, L"RestartOnFailure"))
+        {
+            UINT d, start;
+            XmlNodeType type;
+
+            /* their own Enabled-like children are not the task's */
+            if (IXmlReader_IsEmptyElement(reader)) return;
+            IXmlReader_GetDepth(reader, &start);
+            while (IXmlReader_Read(reader, &type) == S_OK)
+                if (type == XmlNodeType_EndElement && SUCCEEDED(IXmlReader_GetDepth(reader, &d)) && d <= start + 1) break;
+        }
+    }
+}
+
+static void parse_end(const WCHAR *name, UINT depth, struct parse *p, UINT trigger_depth)
+{
+    if (p->trigger)
+    {
+        if (!wcscmp(name, L"Repetition")) p->in_repetition = FALSE;
+        else if (!wcscmp(name, L"DaysOfWeek")) p->in_days_of_week = FALSE;
+        else if (depth == trigger_depth + 1) p->trigger = NULL;   /* an end element is a level below its element */
+        return;
+    }
+    if (!wcscmp(name, L"Exec")) p->action = NULL;
+    else if (!wcscmp(name, L"Principal")) p->in_principal = FALSE;
+    else if (!wcscmp(name, L"Settings")) p->in_settings = FALSE;
+}
+
+static void free_task_definition(struct run_task *task)
+{
+    unsigned int i;
+
+    for (i = 0; i < task->action_count; i++)
+    {
+        free(task->actions[i].command);
+        free(task->actions[i].arguments);
+        free(task->actions[i].directory);
+    }
+    free(task->actions);
+    free(task->triggers);
+    task->actions = NULL;
+    task->triggers = NULL;
+    task->action_count = task->trigger_count = 0;
+}
+
+/* reads (again) the task's definition from its file */
+static BOOL read_definition(struct run_task *task, const WCHAR *file)
+{
+    struct parse p = { task };
+    IXmlReader *reader;
+    IStream *stream;
+    const WCHAR *name;
+    XmlNodeType type;
+    UINT depth = 0, trigger_depth = 0;
+    WCHAR *xml;
+
+    free_task_definition(task);
+    task->ours = TRUE;   /* no principal: the registering account, the system's here */
+    task->enabled = TRUE;
+    task->allow_demand = TRUE;
+    task->start_when_available = FALSE;
+    task->on_batteries_no = TRUE;
+    task->policy = TASK_INSTANCES_IGNORE_NEW;
+    task->time_limit = 72 * 3600 * TICKS_PER_SECOND;
+
+    if (FAILED(sched_read_xml(file, &xml))) return FALSE;
+    if (!(reader = xml_reader(xml, &stream)))
+    {
+        free(xml);
+        return FALSE;
+    }
+    while (IXmlReader_Read(reader, &type) == S_OK)
+    {
+        if (type != XmlNodeType_Element && type != XmlNodeType_EndElement) continue;
+        if (FAILED(IXmlReader_GetLocalName(reader, &name, NULL))) break;
+        IXmlReader_GetDepth(reader, &depth);
+        if (type == XmlNodeType_Element)
+        {
+            BOOL empty = IXmlReader_IsEmptyElement(reader);
+
+            parse_element(reader, name, depth, &p, &trigger_depth);
+            if (empty && !wcscmp(name, L"Exec")) p.action = NULL;
+        }
+        else
+            parse_end(name, depth, &p, trigger_depth);
+    }
+    IXmlReader_Release(reader);
+    IStream_Release(stream);
+    free(xml);
+    return TRUE;
+}
+
+/* ---- running ----------------------------------------------------------------- */
+
+static WCHAR *expand(const WCHAR *s)
+{
+    DWORD len;
+    WCHAR *out;
+
+    if (!s) return NULL;
+    len = ExpandEnvironmentStringsW(s, NULL, 0);
+    if (!(out = malloc(len * sizeof(WCHAR)))) return NULL;
+    ExpandEnvironmentStringsW(s, out, len);
+    return out;
+}
+
+/* $(Arg0) .. $(Arg31): Run's parameters */
+static WCHAR *substitute_args(const WCHAR *s, WCHAR **args, unsigned int count)
+{
+    size_t len = wcslen(s) + 1, i;
+    WCHAR *out, *o;
+    unsigned int n;
+
+    for (n = 0; n < count; n++) len += wcslen(args[n]) * 4;
+    if (!(o = out = malloc(len * sizeof(WCHAR)))) return NULL;
+    for (i = 0; s[i]; )
+    {
+        int index = -1, used = 0;
+
+        if (!wcsncmp(s + i, L"$(Arg", 5) && swscanf(s + i + 5, L"%d)%n", &index, &used) >= 1 && used &&
+            index >= 0 && index < 32)
+        {
+            if ((unsigned int)index < count) { wcscpy(o, args[index]); o += wcslen(args[index]); }
+            i += 5 + used;
+            continue;
+        }
+        *o++ = s[i++];
+    }
+    *o = 0;
+    return out;
+}
+
+static DWORD run_action(struct run_task *task, const struct run_action *action, WCHAR **args,
+                        unsigned int arg_count)
+{
+    PROCESS_INFORMATION pi;
+    STARTUPINFOW si = { sizeof(si) };
+    WCHAR *command = expand(action->command), *arguments = NULL, *directory = expand(action->directory), *line;
+    DWORD code = ERROR_FILE_NOT_FOUND, wait;
+    ULONGLONG limit;
+    size_t len;
+
+    if (!command) goto done;
+    if (action->arguments)
+    {
+        WCHAR *subst = substitute_args(action->arguments, args, arg_count);
+        arguments = expand(subst);
+        free(subst);
+    }
+    len = wcslen(command) + (arguments ? wcslen(arguments) : 0) + 4;
+    if (!(line = malloc(len * sizeof(WCHAR)))) goto done;
+    if (command[0] != '"' && wcschr(command, ' ')) swprintf(line, len, L"\"%s\"", command);
+    else wcscpy(line, command);
+    if (arguments && *arguments)
+    {
+        wcscat(line, L" ");
+        wcscat(line, arguments);
+    }
+    TRACE("%s: %s\n", debugstr_w(task->path), debugstr_w(line));
+    if (!CreateProcessW(NULL, line, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL,
+                        directory && *directory ? directory : NULL, &si, &pi))
+    {
+        code = GetLastError();
+        WARN("%s: could not start %s, error %lu\n", debugstr_w(task->path), debugstr_w(line), code);
+        free(line);
+        goto done;
+    }
+    free(line);
+    CloseHandle(pi.hThread);
+    EnterCriticalSection(&cs);
+    task->process = pi.hProcess;
+    LeaveCriticalSection(&cs);
+
+    limit = task->time_limit ? task->time_limit / 10000 : INFINITE;
+    wait = WaitForSingleObject(pi.hProcess, limit > 0xfffffffe ? INFINITE : (DWORD)limit);
+    if (wait == WAIT_TIMEOUT)
+    {
+        WARN("%s: past its time limit, ended\n", debugstr_w(task->path));
+        TerminateProcess(pi.hProcess, SCHED_S_TASK_TERMINATED);
+        WaitForSingleObject(pi.hProcess, 5000);
+    }
+    GetExitCodeProcess(pi.hProcess, &code);
+    EnterCriticalSection(&cs);
+    task->process = NULL;
+    LeaveCriticalSection(&cs);
+    CloseHandle(pi.hProcess);
+done:
+    free(command);
+    free(arguments);
+    free(directory);
+    return code;
+}
+
+/* runs the task's actions in order, on a thread of its own */
+static DWORD WINAPI task_thread(void *arg)
+{
+    struct run_task *task = arg;
+    struct run_action *actions;
+    WCHAR *args[32];
+    unsigned int count, arg_count, i;
+    DWORD code = 0;
+
+    EnterCriticalSection(&cs);
+    count = task->action_count;
+    actions = calloc(count ? count : 1, sizeof(*actions));
+    for (i = 0; actions && i < count; i++)
+    {
+        actions[i].command = task->actions[i].command ? wcsdup(task->actions[i].command) : NULL;
+        actions[i].arguments = task->actions[i].arguments ? wcsdup(task->actions[i].arguments) : NULL;
+        actions[i].directory = task->actions[i].directory ? wcsdup(task->actions[i].directory) : NULL;
+    }
+    arg_count = task->run_arg_count;
+    memcpy(args, task->run_args, sizeof(args));
+    task->run_arg_count = 0;
+    memset(task->run_args, 0, sizeof(task->run_args));
+    LeaveCriticalSection(&cs);
+
+    for (i = 0; actions && i < count; i++)
+    {
+        code = run_action(task, &actions[i], args, arg_count);
+        free(actions[i].command);
+        free(actions[i].arguments);
+        free(actions[i].directory);
+    }
+    free(actions);
+    for (i = 0; i < arg_count; i++) free(args[i]);
+
+    EnterCriticalSection(&cs);
+    task->last_result = code;
+    save_state(task);
+    TRACE("%s: done, result %#lx\n", debugstr_w(task->path), code);
+    LeaveCriticalSection(&cs);
+    SetEvent(wake_event);
+    return 0;
+}
+
+static BOOL on_batteries(void)
+{
+    SYSTEM_POWER_STATUS power;
+
+    return GetSystemPowerStatus(&power) && power.ACLineStatus == 0;
+}
+
+/* starts the task now; with the lock held */
+static BOOL start_task(struct run_task *task, BOOL demand)
+{
+    if (task->thread)
+    {
+        if (WaitForSingleObject(task->thread, 0) == WAIT_TIMEOUT)
+        {
+            switch (task->policy)
+            {
+            case TASK_INSTANCES_QUEUE:
+                task->queued = TRUE;
+                return FALSE;
+            case TASK_INSTANCES_STOP_EXISTING:
+                if (task->process) TerminateProcess(task->process, SCHED_S_TASK_TERMINATED);
+                break;
+            case TASK_INSTANCES_PARALLEL:
+                break;   /* the thread handle of the newest is kept */
+            default:
+                TRACE("%s is running: not started again\n", debugstr_w(task->path));
+                return FALSE;
+            }
+        }
+        CloseHandle(task->thread);
+        task->thread = NULL;
+    }
+    if (!demand && task->on_batteries_no && on_batteries())
+    {
+        TRACE("%s: on batteries, not started\n", debugstr_w(task->path));
+        return FALSE;
+    }
+    task->last_run = now_utc();
+    task->last_result = SCHED_S_TASK_RUNNING;
+    task->started = task->last_run;
+    save_state(task);
+    TRACE("starting %s\n", debugstr_w(task->path));
+    if (!(task->thread = CreateThread(NULL, 0, task_thread, task, 0, NULL)))
+    {
+        task->last_result = HRESULT_FROM_WIN32(GetLastError());
+        save_state(task);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void compute_next(struct run_task *task, ULONGLONG now)
+{
+    ULONGLONG next = NEVER, when;
+    unsigned int i;
+
+    for (i = 0; i < task->trigger_count; i++)
+    {
+        when = trigger_next(&task->triggers[i], now);
+        if (when < next) next = when;
+    }
+    task->next = next;
+}
+
+/* ---- the list of tasks ----------------------------------------------------- */
+
+static struct run_task *find_task(const WCHAR *path)
+{
+    struct run_task *task;
+    const WCHAR *p = path;
+    WCHAR *norm;
+    size_t len;
+
+    while (*p == '\\' || *p == '/') p++;
+    len = wcslen(p) + 2;
+    if (!(norm = malloc(len * sizeof(WCHAR)))) return NULL;
+    swprintf(norm, len, L"\\%s", p);
+    LIST_FOR_EACH_ENTRY(task, &tasks, struct run_task, entry)
+    {
+        if (!wcsicmp(task->path, norm))
+        {
+            free(norm);
+            return task;
+        }
+    }
+    free(norm);
+    return NULL;
+}
+
+static void fire_event_triggers(struct run_task *task, enum trigger_kind kind, ULONGLONG when)
+{
+    unsigned int i;
+
+    for (i = 0; i < task->trigger_count; i++)
+        if (task->triggers[i].kind == kind && task->triggers[i].enabled)
+            task->triggers[i].event = when + task->triggers[i].delay;
+}
+
+static void scan_dir(const WCHAR *dir, const WCHAR *rel, ULONGLONG now, BOOL first)
+{
+    WIN32_FIND_DATAW data;
+    HANDLE find;
+    WCHAR *pattern, *file, *path;
+    size_t len;
+
+    len = wcslen(dir) + 3;
+    if (!(pattern = malloc(len * sizeof(WCHAR)))) return;
+    swprintf(pattern, len, L"%s\\*", dir);
+    find = FindFirstFileW(pattern, &data);
+    free(pattern);
+    if (find == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        struct run_task *task;
+
+        if (!wcscmp(data.cFileName, L".") || !wcscmp(data.cFileName, L"..")) continue;
+        len = wcslen(dir) + wcslen(data.cFileName) + 2;
+        if (!(file = malloc(len * sizeof(WCHAR)))) continue;
+        swprintf(file, len, L"%s\\%s", dir, data.cFileName);
+        len = wcslen(rel) + wcslen(data.cFileName) + 2;
+        if (!(path = malloc(len * sizeof(WCHAR)))) { free(file); continue; }
+        swprintf(path, len, L"%s\\%s", rel, data.cFileName);
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+        {
+            scan_dir(file, path, now, first);
+            free(file);
+            free(path);
+            continue;
+        }
+        if (!(task = find_task(path)))
+        {
+            if (!(task = calloc(1, sizeof(*task)))) { free(file); free(path); continue; }
+            task->path = path;
+            path = NULL;
+            load_state(task);
+            list_add_tail(&tasks, &task->entry);
+            read_definition(task, file);
+            task->written = data.ftLastWriteTime;
+            if (first) fire_event_triggers(task, TRIGGER_BOOT, service_start);
+            if (first) fire_event_triggers(task, TRIGGER_LOGON, service_start);
+            else fire_event_triggers(task, TRIGGER_REGISTRATION, now);
+            /* a run missed while the machine was off or the service stopped */
+            if (first && task->start_when_available)
+            {
+                unsigned int i;
+                for (i = 0; i < task->trigger_count; i++)
+                {
+                    ULONGLONG last = trigger_last(&task->triggers[i], now);
+                    if (last && last > task->last_run)
+                    {
+                        task->queued = TRUE;
+                        TRACE("%s missed a run: made up\n", debugstr_w(task->path));
+                        break;
+                    }
+                }
+            }
+        }
+        else if (CompareFileTime(&task->written, &data.ftLastWriteTime))
+        {
+            TRACE("%s changed\n", debugstr_w(task->path));
+            read_definition(task, file);
+            task->written = data.ftLastWriteTime;
+            fire_event_triggers(task, TRIGGER_REGISTRATION, now);
+        }
+        task->seen = TRUE;
+        compute_next(task, now);
+        free(file);
+        free(path);
+    } while (FindNextFileW(find, &data));
+    FindClose(find);
+}
+
+static void rescan(BOOL first)
+{
+    struct run_task *task, *next;
+    WCHAR dir[MAX_PATH];
+    ULONGLONG now = now_utc();
+
+    GetSystemDirectoryW(dir, MAX_PATH - 8);
+    wcscat(dir, L"\\tasks");
+    EnterCriticalSection(&cs);
+    LIST_FOR_EACH_ENTRY(task, &tasks, struct run_task, entry) task->seen = FALSE;
+    scan_dir(dir, L"", now, first);
+    LIST_FOR_EACH_ENTRY_SAFE(task, next, &tasks, struct run_task, entry)
+    {
+        if (task->seen) continue;
+        if (task->thread && WaitForSingleObject(task->thread, 0) == WAIT_TIMEOUT) continue;   /* gone when done */
+        TRACE("%s deleted\n", debugstr_w(task->path));
+        list_remove(&task->entry);
+        if (task->thread) CloseHandle(task->thread);
+        free_task_definition(task);
+        free(task->path);
+        free(task);
+    }
+    LeaveCriticalSection(&cs);
+}
+
+/* runs what is due; returns how long to sleep, in ms */
+static DWORD run_due(void)
+{
+    struct run_task *task;
+    ULONGLONG now = now_utc(), soonest = NEVER;
+    BOOL running = FALSE;
+
+    EnterCriticalSection(&cs);
+    LIST_FOR_EACH_ENTRY(task, &tasks, struct run_task, entry)
+    {
+        BOOL busy = task->thread && WaitForSingleObject(task->thread, 0) == WAIT_TIMEOUT;
+
+        if (busy) running = TRUE;
+        if (!task->ours || !task->enabled || task->disabled) continue;
+        if (task->queued && !busy)
+        {
+            task->queued = FALSE;
+            start_task(task, FALSE);
+        }
+#ifndef SG_MUTANT_TASK_NO_RUNNER
+        if (task->next != NEVER && task->next <= now)
+        {
+            start_task(task, FALSE);
+            compute_next(task, now);
+        }
+#endif
+        if (task->next < soonest) soonest = task->next;
+    }
+    LeaveCriticalSection(&cs);
+
+    if (soonest == NEVER) return running ? 5000 : 60000;
+    if (soonest <= now) return 0;
+    return (DWORD)min((soonest - now) / 10000 + 1, running ? 5000 : 60000);
+}
+
+static DWORD WINAPI scheduler_proc(void *arg)
+{
+    HANDLE done = arg, change;
+    WCHAR dir[MAX_PATH];
+    HANDLE handles[3];
+    DWORD count, timeout, ret;
+
+    GetSystemDirectoryW(dir, MAX_PATH - 8);
+    wcscat(dir, L"\\tasks");
+    CreateDirectoryW(dir, NULL);
+    change = FindFirstChangeNotificationW(dir, TRUE, FILE_NOTIFY_CHANGE_FILE_NAME | FILE_NOTIFY_CHANGE_DIR_NAME |
+                                          FILE_NOTIFY_CHANGE_LAST_WRITE | FILE_NOTIFY_CHANGE_SIZE);
+    rescan(TRUE);
+    for (;;)
+    {
+        timeout = run_due();
+        handles[0] = done;
+        handles[1] = wake_event;
+        count = 2;
+        if (change != INVALID_HANDLE_VALUE) handles[count++] = change;
+        ret = WaitForMultipleObjects(count, handles, FALSE, timeout);
+        if (ret == WAIT_OBJECT_0) break;
+        if (ret == WAIT_OBJECT_0 + 2)
+        {
+            Sleep(200);   /* the writer finishes */
+            rescan(FALSE);
+            FindNextChangeNotification(change);
+        }
+        else if (ret == WAIT_OBJECT_0 + 1)
+            rescan(FALSE);
+    }
+    if (change != INVALID_HANDLE_VALUE) FindCloseChangeNotification(change);
+    return 0;
+}
+
+void taskrun_start(HANDLE done_event)
+{
+    service_start = now_utc();
+    wake_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    scheduler_thread = CreateThread(NULL, 0, scheduler_proc, done_event, 0, NULL);
+}
+
+void taskrun_finish(void)
+{
+    if (!scheduler_thread) return;
+    WaitForSingleObject(scheduler_thread, 5000);
+    CloseHandle(scheduler_thread);
+    scheduler_thread = NULL;
+}
+
+void taskrun_changed(void)
+{
+    if (wake_event) SetEvent(wake_event);
+}
+
+/* ---- for the RPC calls -------------------------------------------------------- */
+
+HRESULT taskrun_run(const WCHAR *path, DWORD n_args, const WCHAR **args, DWORD flags)
+{
+    struct run_task *task;
+    HRESULT hr = S_OK;
+    unsigned int i;
+
+    rescan(FALSE);   /* one registered a moment ago */
+    EnterCriticalSection(&cs);
+    if (!(task = find_task(path))) hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    else if (!(flags & RUN_IGNORE_CONSTRAINTS) && (!task->enabled || task->disabled))
+        hr = SCHED_E_TASK_DISABLED;
+    else if (!(flags & RUN_IGNORE_CONSTRAINTS) && !task->allow_demand)
+        hr = SCHED_E_START_ON_DEMAND;
+    else if (!task->ours)
+    {
+        FIXME("%s runs as a user: not run by the service\n", debugstr_w(path));
+        hr = E_ACCESSDENIED;
+    }
+    else
+    {
+        for (i = 0; i < n_args && i < ARRAY_SIZE(task->run_args); i++)
+            task->run_args[i] = args[i] ? wcsdup(args[i]) : wcsdup(L"");
+        task->run_arg_count = i;
+        if (!start_task(task, TRUE) && !task->queued)
+        {
+            for (i = 0; i < task->run_arg_count; i++) free(task->run_args[i]);
+            task->run_arg_count = 0;
+        }
+    }
+    LeaveCriticalSection(&cs);
+    return hr;
+}
+
+HRESULT taskrun_stop(const WCHAR *path)
+{
+    struct run_task *task, *only = NULL;
+
+    EnterCriticalSection(&cs);
+    if (path && *path && !(only = find_task(path)))
+    {
+        LeaveCriticalSection(&cs);
+        return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    }
+    LIST_FOR_EACH_ENTRY(task, &tasks, struct run_task, entry)
+    {
+        if (only && task != only) continue;
+        task->queued = FALSE;
+        if (task->process) TerminateProcess(task->process, SCHED_S_TASK_TERMINATED);
+    }
+    LeaveCriticalSection(&cs);
+    return S_OK;
+}
+
+HRESULT taskrun_last_run(const WCHAR *path, SYSTEMTIME *st, DWORD *code)
+{
+    struct run_task *task;
+    HRESULT hr = S_OK;
+    FILETIME ft, local;
+
+    memset(st, 0, sizeof(*st));
+    *code = 0;
+    rescan(FALSE);
+    EnterCriticalSection(&cs);
+    if (!(task = find_task(path))) hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    else if (task->last_run)
+    {
+        ft.dwLowDateTime = (DWORD)task->last_run;
+        ft.dwHighDateTime = (DWORD)(task->last_run >> 32);
+        FileTimeToLocalFileTime(&ft, &local);
+        FileTimeToSystemTime(&local, st);
+        *code = task->last_result;
+    }
+    else
+        *code = SCHED_S_TASK_HAS_NOT_RUN;
+    LeaveCriticalSection(&cs);
+    return hr;
+}
+
+/* TASK_STATE of a task; FALSE when it is not known here */
+BOOL taskrun_state(const WCHAR *path, DWORD *state, BOOL *disabled)
+{
+    struct run_task *task;
+    BOOL ret = FALSE;
+
+    EnterCriticalSection(&cs);
+    if ((task = find_task(path)))
+    {
+        *disabled = task->disabled;
+        if (task->thread && WaitForSingleObject(task->thread, 0) == WAIT_TIMEOUT) *state = TASK_STATE_RUNNING;
+        else if (task->queued) *state = TASK_STATE_QUEUED;
+        else *state = (task->enabled && !task->disabled) ? TASK_STATE_READY : TASK_STATE_DISABLED;
+        ret = TRUE;
+    }
+    LeaveCriticalSection(&cs);
+    return ret;
+}
+
+HRESULT taskrun_enable(const WCHAR *path, BOOL enabled)
+{
+    struct run_task *task;
+    HRESULT hr = S_OK;
+
+    rescan(FALSE);
+    EnterCriticalSection(&cs);
+    if (!(task = find_task(path))) hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    else
+    {
+        task->disabled = !enabled;
+        save_state(task);
+    }
+    LeaveCriticalSection(&cs);
+    taskrun_changed();
+    return hr;
+}
