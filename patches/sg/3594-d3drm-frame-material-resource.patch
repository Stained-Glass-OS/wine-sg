+static HRESULT d3drm_texture_load(struct d3drm_texture *texture,
+        const char *path, BOOL flip, D3DRMIMAGE **image_out)
+{
+    BITMAPFILEHEADER *header;
+    HANDLE file, mapping;
+    LARGE_INTEGER size;
+    HRESULT hr;
+
+    if ((file = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, 0, OPEN_EXISTING, 0, 0)) == INVALID_HANDLE_VALUE)
+        return D3DRMERR_BADOBJECT;
+
+    mapping = CreateFileMappingW(file, NULL, PAGE_READONLY, 0, 0, NULL);
+    CloseHandle(file);
+    if (!mapping || mapping == INVALID_HANDLE_VALUE)
+        return D3DRMERR_BADVALUE;
+
+    if (!GetFileSizeEx(mapping, &size))
+    {
+        CloseHandle(mapping);
+        return D3DRMERR_BADVALUE;
+    }
+
+    header = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, 0);
+    CloseHandle(mapping);
+    if (!header)
+        return D3DRMERR_BADVALUE;
+
+    hr = d3drm_texture_load_data(texture, header, size.QuadPart, flip, image_out);
+    UnmapViewOfFile(header);
+    return hr;
+}
+
+/* A resource holds either a whole bitmap file or the bare DIB of RT_BITMAP resources. */
+static HRESULT d3drm_texture_init_resource(IDirect3DRMTexture3 *iface, HMODULE module, HRSRC rsrc)
+{
+    struct d3drm_texture *texture = impl_from_IDirect3DRMTexture3(iface);
+    BITMAPFILEHEADER *header;
+    D3DRMIMAGE *image;
+    HGLOBAL global;
+    DWORD size;
+    void *data;
+    HRESULT hr;
+
+    if (!rsrc)
+        return D3DRMERR_BADOBJECT;
+    if (!(global = LoadResource(module, rsrc)) || !(data = LockResource(global)))
+        return D3DRMERR_BADOBJECT;
+    size = SizeofResource(module, rsrc);
+
+    if (size >= 2 && ((WORD *)data)[0] == 0x4d42)
+    {
+        hr = d3drm_texture_load_data(texture, data, size, TRUE, &image);
+    }
+    else
+    {
+        if (!(header = calloc(1, sizeof(*header) + size)))
+            return D3DRMERR_BADALLOC;
+        header->bfType = 0x4d42;
+        header->bfSize = sizeof(*header) + size;
+        memcpy(header + 1, data, size);
+        hr = d3drm_texture_load_data(texture, header, sizeof(*header) + size, TRUE, &image);
+        /* the image is a copy of the pixels */
+        free(header);
+    }
+    if (FAILED(hr))
+        return hr;
+    return IDirect3DRMTexture3_InitFromImage(iface, image);
+}
