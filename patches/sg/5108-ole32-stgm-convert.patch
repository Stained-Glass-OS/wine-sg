From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ole32: STGM_CONVERT keeps the old file as the stream CONTENTS (patch 5108)

Gap-CORE item 499. Gate with two mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/ole32/storage32.c b/dlls/ole32/storage32.c
--- a/dlls/ole32/storage32.c
+++ b/dlls/ole32/storage32.c
@@ -420,7 +420,8 @@
   case STGM_CREATE:
     return CREATE_ALWAYS;
   case STGM_CONVERT:
-    FIXME("STGM_CONVERT not implemented!\n");
+    /* a file that is not there is created; one that is there is replaced by create_storagefile,
+     * which keeps its old contents in a stream */
     return CREATE_NEW;
   case STGM_FAILIFTHERE:
     return CREATE_NEW;
@@ -8444,6 +8445,50 @@
  * Miscellaneous storage functions
  ***********************************************************************/
 
+/* STGM_CONVERT: the contents of an existing file, read before the file is replaced */
+static HRESULT read_file_for_convert(const WCHAR *name, BYTE **data, DWORD *size, BOOL *exists)
+{
+  LARGE_INTEGER length;
+  HANDLE file;
+  DWORD read = 0;
+
+  *data = NULL;
+  *size = 0;
+  *exists = FALSE;
+
+  file = CreateFileW(name, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+                     FILE_ATTRIBUTE_NORMAL, 0);
+  if (file == INVALID_HANDLE_VALUE)
+  {
+    DWORD err = GetLastError();
+    if (err == ERROR_FILE_NOT_FOUND || err == ERROR_PATH_NOT_FOUND) return S_OK;
+    return HRESULT_FROM_WIN32(err);
+  }
+
+  if (!GetFileSizeEx(file, &length) || length.QuadPart > 0x7fffffff)
+  {
+    CloseHandle(file);
+    return STG_E_INSUFFICIENTMEMORY;
+  }
+  if (length.LowPart && !(*data = HeapAlloc(GetProcessHeap(), 0, length.LowPart)))
+  {
+    CloseHandle(file);
+    return STG_E_INSUFFICIENTMEMORY;
+  }
+  if (length.LowPart && (!ReadFile(file, *data, length.LowPart, &read, NULL) || read != length.LowPart))
+  {
+    DWORD err = GetLastError();
+    CloseHandle(file);
+    HeapFree(GetProcessHeap(), 0, *data);
+    *data = NULL;
+    return HRESULT_FROM_WIN32(err ? err : ERROR_READ_FAULT);
+  }
+  CloseHandle(file);
+  *size = length.LowPart;
+  *exists = TRUE;
+  return S_OK;
+}
+
 static HRESULT create_storagefile(
   LPCOLESTR pwcsName,
   DWORD       grfMode,
@@ -8460,6 +8505,9 @@
   DWORD          creationMode;
   DWORD          fileAttributes;
   WCHAR          tempFileName[MAX_PATH];
+  BYTE          *convertData = NULL;
+  DWORD          convertSize = 0;
+  BOOL           converted = FALSE;
 
   if (ppstgOpen == 0)
     return STG_E_INVALIDPOINTER;
@@ -8516,6 +8564,20 @@
   else
   {
     creationMode = GetCreationModeFromSTGM(grfMode);
+
+    /* STGM_CONVERT (0x20000) is outside STGM_CREATE_MODE's mask: it is a flag of its own here */
+    if (grfMode & STGM_CONVERT)
+    {
+      /* STGM_CONVERT with STGM_DELETEONRELEASE is not valid */
+      if (grfMode & STGM_DELETEONRELEASE)
+      {
+        hr = STG_E_INVALIDFLAG;
+        goto end;
+      }
+      hr = read_file_for_convert(pwcsName, &convertData, &convertSize, &converted);
+      if (FAILED(hr)) goto end;
+      if (converted) creationMode = CREATE_ALWAYS;
+    }
   }
 
   /*
@@ -8566,10 +8628,35 @@
     goto end;
   }
 
+  if (converted)
+  {
+    /* the old contents of the file, whatever they were, are now the stream "CONTENTS" */
+    IStream *stream;
+
+    hr = IStorage_CreateStream(&newStorage->IStorage_iface, L"CONTENTS",
+                               STGM_CREATE | STGM_WRITE | STGM_SHARE_EXCLUSIVE, 0, 0, &stream);
+    if (SUCCEEDED(hr))
+    {
+#ifndef SG_MUTANT_STG_CONVERT_DATA
+      if (convertSize) hr = IStream_Write(stream, convertData, convertSize, NULL);
+#endif
+      IStream_Release(stream);
+    }
+    if (FAILED(hr))
+    {
+      IStorage_Release(&newStorage->IStorage_iface);
+      goto end;
+    }
+  }
+
   hr = IStorage_QueryInterface(&newStorage->IStorage_iface, riid, ppstgOpen);
   IStorage_Release(&newStorage->IStorage_iface);
+#ifndef SG_MUTANT_STG_CONVERT_CODE
+  if (SUCCEEDED(hr) && converted) hr = STG_S_CONVERTED;
+#endif
 
 end:
+  HeapFree(GetProcessHeap(), 0, convertData);
   TRACE("<-- %p  r = %#lx\n", *ppstgOpen, hr);
 
   return hr;
-- 
