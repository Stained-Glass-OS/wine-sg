From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: an icon glyph with no stand-in draws nothing

Without the icon font (Segoe MDL2 Assets / Segoe Fluent Icons), its glyphs are drawn as standard characters where we have one; any other private-use glyph was drawn as is in the stand-in font and showed the missing-glyph box (Windows Terminal's tab icons and settings icons were boxes). Such a glyph now draws nothing, in a FontIcon and in text in the icon font.
---
diff --git a/dlls/windows.ui.xaml/buttons.c b/dlls/windows.ui.xaml/buttons.c
index 05952cd..7f24441 100644
--- a/dlls/windows.ui.xaml/buttons.c
+++ b/dlls/windows.ui.xaml/buttons.c
@@ -1162,6 +1162,14 @@ static void font_icon_measure( struct uielem *elem, struct xsize available, stru
             UINT32 fb = glyph[i] >= 0xe000 && glyph[i] <= 0xf8ff ? xaml_symbol_fallback( glyph[i] ) : 0;
 #ifdef SG_MUTANT_FONTICON_NO_STANDIN
             fb = 0;
+#endif
+#ifndef SG_MUTANT_ICON_GLYPH_TOFU
+            /* an icon glyph with no stand-in: nothing, not the missing-glyph box */
+            if (!fb && glyph[i] >= 0xe000 && glyph[i] <= 0xf8ff)
+            {
+                TRACE( "no stand-in for icon glyph %04x\n", glyph[i] );
+                continue;
+            }
 #endif
             if (fb >= 0x10000)
             {
diff --git a/dlls/windows.ui.xaml/text.c b/dlls/windows.ui.xaml/text.c
index 4929623..8d40b6c 100644
--- a/dlls/windows.ui.xaml/text.c
+++ b/dlls/windows.ui.xaml/text.c
@@ -253,6 +253,14 @@ static WCHAR *translate_symbols( WCHAR *str )
     if (!out) return str;
     for (i = 0; i < len; i++)
     {
+#ifndef SG_MUTANT_ICON_GLYPH_TOFU
+        /* an icon glyph with no stand-in: nothing, not the missing-glyph box */
+        if (str[i] >= 0xe000 && str[i] <= 0xf8ff && !xaml_symbol_fallback( str[i] ))
+        {
+            TRACE( "no stand-in for icon glyph %04x\n", str[i] );
+            continue;
+        }
+#endif
         if (str[i] >= 0xe000 && str[i] <= 0xf8ff && (fb = xaml_symbol_fallback( str[i] )))
         {
             if (fb >= 0x10000)
