From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: a file below a volume device opens by its NT name

On Windows a file opens by its volume's NT name, \Device\HarddiskVolume1\users\x\settings.json:
the volume device parses the rest. Wine gives such names itself (QueryDosDevice("C:"),
GetFinalPathNameByHandle with VOLUME_NAME_NT, a process's image file name) but could not open
them (STATUS_OBJECT_NAME_NOT_FOUND). System Informer keeps its settings at one; it said "Unable
to save application settings" each time it closed and started again with its first-run questions.

nt_to_unix_file_name maps a name below \Device\<volume>\ to the drive whose \??\X: link names
that device (only drives the prefix has), and \??\GLOBALROOT\Device\... (\\?\GLOBALROOT\ in a
Win32 name) the same way. The volume itself, and devices no drive names, go to the server as
before.
---
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -4119,6 +4119,82 @@
 /******************************************************************************
  *           nt_to_unix_file_name_no_root
  */
+/* Stained Glass OS (wine-sg 8401): a file below a volume device by its NT name,
+ * \Device\HarddiskVolume1\users\x.txt, as Windows opens it (the volume parses the rest).
+ * Wine's own NT names of files are such (GetFinalPathNameByHandle with VOLUME_NAME_NT, a
+ * process's image file name), and System Informer writes its settings there: "Unable to save
+ * application settings" each time it closed. The volume is the drive whose \??\X: link names
+ * that device; the name becomes \??\X:\rest. Returns the new name in a buffer to free, or
+ * NULL. */
+static WCHAR *sg_volume_dos_name( const WCHAR *name, int name_len, int *ret_len )
+{
+    static const WCHAR deviceW[] = {'\\','D','e','v','i','c','e','\\'};
+    WCHAR link[] = {'\\','?','?','\\','a',':',0}, target[MAX_PATH];
+    int dev_len, letter;
+    char *path;
+
+#ifdef SG_MUTANT_NO_VOLUME_PATHS
+    return NULL;
+#endif
+    if (name_len <= ARRAY_SIZE(deviceW) || wcsnicmp( name, deviceW, ARRAY_SIZE(deviceW) )) return NULL;
+    for (dev_len = ARRAY_SIZE(deviceW); dev_len < name_len && name[dev_len] != '\\'; dev_len++) ;
+    if (dev_len == ARRAY_SIZE(deviceW) || dev_len >= name_len) return NULL;  /* the volume itself */
+    if (!(path = malloc( strlen( config_dir ) + sizeof("/dosdevices/a:") ))) return NULL;
+    for (letter = 'a'; letter <= 'z'; letter++)
+    {
+        UNICODE_STRING str, value;
+        OBJECT_ATTRIBUTES attr;
+        struct stat st;
+        HANDLE handle;
+        WCHAR *ret;
+        BOOL same;
+
+        /* only the drives this prefix has */
+        sprintf( path, "%s/dosdevices/%c:", config_dir, letter );
+        if (lstat( path, &st ) == -1) continue;
+        link[4] = letter;
+        init_unicode_string( &str, link );
+        InitializeObjectAttributes( &attr, &str, OBJ_CASE_INSENSITIVE, 0, NULL );
+        if (NtOpenSymbolicLinkObject( &handle, SYMBOLIC_LINK_QUERY, &attr )) continue;
+        value.Buffer = target;
+        value.Length = 0;
+        value.MaximumLength = sizeof(target);
+        same = !NtQuerySymbolicLinkObject( handle, &value, NULL ) && value.Length == dev_len * sizeof(WCHAR) &&
+               !wcsnicmp( target, name, dev_len );
+        NtClose( handle );
+        if (!same) continue;
+        free( path );
+        *ret_len = 6 + name_len - dev_len;
+        if (!(ret = malloc( (*ret_len + 1) * sizeof(WCHAR) ))) return NULL;
+        memcpy( ret, link, 6 * sizeof(WCHAR) );
+        memcpy( ret + 6, name + dev_len, (name_len - dev_len) * sizeof(WCHAR) );
+        ret[*ret_len] = 0;
+        return ret;
+    }
+    free( path );
+    return NULL;
+}
+
+static NTSTATUS nt_to_unix_file_name_no_root( const UNICODE_STRING *nameW, char **unix_name_ret,
+                                              UINT disposition );
+
+/* a volume's file by its NT name (above), or through \??\GLOBALROOT, the root of the NT names */
+static NTSTATUS sg_volume_file_name( const WCHAR *native, int native_len, char **unix_name_ret,
+                                     UINT disposition )
+{
+    UNICODE_STRING str;
+    NTSTATUS status;
+    int len;
+    WCHAR *dos = sg_volume_dos_name( native, native_len, &len );
+
+    if (!dos) return STATUS_BAD_DEVICE_TYPE;
+    str.Buffer = dos;
+    str.Length = str.MaximumLength = len * sizeof(WCHAR);
+    status = nt_to_unix_file_name_no_root( &str, unix_name_ret, disposition );
+    free( dos );
+    return status;
+}
+
 static NTSTATUS nt_to_unix_file_name_no_root( const UNICODE_STRING *nameW, char **unix_name_ret,
                                               UINT disposition )
 {
@@ -4140,13 +4216,23 @@
 
     if (!name_len || name[0] != '\\') return STATUS_OBJECT_PATH_SYNTAX_BAD;
 
-    if (!(pos = get_dos_prefix_len( nameW )))
-        return STATUS_BAD_DEVICE_TYPE;  /* no DOS prefix, assume NT native name */
+    if (!(pos = get_dos_prefix_len( nameW )))  /* no DOS prefix, assume NT native name */
+        return sg_volume_file_name( name, name_len, unix_name_ret, disposition );
 
     name += pos;
     name_len -= pos;
 
     if (!name_len) return STATUS_OBJECT_NAME_INVALID;
+    /* \??\GLOBALROOT\Device\...: \\?\GLOBALROOT\ in a Win32 name */
+    {
+        static const WCHAR globalrootW[] = {'G','L','O','B','A','L','R','O','O','T','\\'};
+        if (name_len > ARRAY_SIZE(globalrootW) && !wcsnicmp( name, globalrootW, ARRAY_SIZE(globalrootW) ))
+        {
+            NTSTATUS st = sg_volume_file_name( name + ARRAY_SIZE(globalrootW) - 1,
+                                               name_len - ARRAY_SIZE(globalrootW) + 1, unix_name_ret, disposition );
+            if (st != STATUS_BAD_DEVICE_TYPE) return st;
+        }
+    }
 
     /* check for sub-directory */
     for (pos = 0; pos < name_len && pos <= MAX_DIR_ENTRY_LEN; pos++)
