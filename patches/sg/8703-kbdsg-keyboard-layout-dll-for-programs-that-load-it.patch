@@ -0,0 +1,219 @@
+/*
+ * Keyboard layout tables for programs that read them (Stained Glass OS, wine-sg 8703)
+ *
+ * On Windows each keyboard layout is a DLL (KBDUS.DLL, KBDGR.DLL, ...) named by
+ * HKLM\System\CurrentControlSet\Control\Keyboard Layouts\<KLID>\Layout File and exporting
+ * KbdLayerDescriptor, which returns the layout's KBDTABLES. GTK 3.24 (GIMP, Inkscape,
+ * darktable, Siril, ART...) and GTK 4 load that DLL themselves to map keys to keysyms; Wine had
+ * no layout DLLs and no "Layout File", so they warned "could not load the layout" and lost every
+ * key that is not typed text: Enter, Backspace, the arrows, Ctrl+A, every shortcut.
+ *
+ * Here one DLL serves every layout: the tables are built for the layout that is active when
+ * KbdLayerDescriptor is called (GTK activates each layout before it loads its DLL), from
+ * ToUnicodeEx -- so they follow whatever the display driver made of the X or Wayland keymap.
+ * A 32-bit copy lays the tables out with 64-bit pointers, as the DLLs in syswow64 do on Windows
+ * (KBD_LONG_POINTERS), which is what a 32-bit program on a 64-bit system expects.
+ */
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+
+#ifdef _WIN64
+#define KLP(type) type *
+#define KLP_SET(field, value) ((field) = (value))
+#else
+/* KBD_LONG_POINTERS: every pointer takes 64 bits */
+#define KLP(type) union { type *ptr; UINT64 align; }
+#define KLP_SET(field, value) ((field).align = 0, (field).ptr = (value))
+#endif
+
+#define KBDSHIFT     0x01
+#define KBDCTRL      0x02
+#define KBDALT       0x04
+#define SHFT_INVALID 0x0f
+#define CAPLOK       0x01
+#define WCH_NONE     0xf000
+#define WCH_DEAD     0xf001
+#define LEVELS       6
+
+typedef struct { BYTE Vk; BYTE ModBits; } SG_VK_TO_BIT;
+typedef struct { KLP(SG_VK_TO_BIT) pVkToBit; WORD wMaxModBits; BYTE ModNumber[8]; } SG_MODIFIERS;
+typedef struct { BYTE VirtualKey; BYTE Attributes; WCHAR wch[LEVELS]; } SG_VK_TO_WCHARS;
+typedef struct { KLP(SG_VK_TO_WCHARS) pVkToWchars; BYTE nModifications; BYTE cbSize; } SG_VK_TO_WCHAR_TABLE;
+typedef struct { DWORD dwBoth; WCHAR wchComposed; USHORT uFlags; } SG_DEADKEY;
+typedef struct
+{
+    KLP(SG_MODIFIERS)         pCharModifiers;
+    KLP(SG_VK_TO_WCHAR_TABLE) pVkToWcharTable;
+    KLP(SG_DEADKEY)           pDeadKey;
+    KLP(void)                 pKeyNames;
+    KLP(void)                 pKeyNamesExt;
+    KLP(void)                 pKeyNamesDead;
+    KLP(USHORT)               pusVSCtoVK;
+    BYTE                      bMaxVSCtoVK;
+    KLP(void)                 pVSCtoVK_E0;
+    KLP(void)                 pVSCtoVK_E1;
+    DWORD                     fLocaleFlags;
+    BYTE                      nLgMaxd;
+    BYTE                      cbLgEntry;
+    KLP(void)                 pLigature;
+} SG_KBDTABLES;
+
+struct layout
+{
+    HKL                  hkl;
+    SG_KBDTABLES         tables;
+    SG_MODIFIERS         modifiers;
+    SG_VK_TO_WCHAR_TABLE wchar_tables[2];
+    SG_DEADKEY           no_dead_keys[1];
+    USHORT               vsc_to_vk[128];
+    SG_VK_TO_WCHARS      entries[512];
+    struct layout       *next;
+};
+
+static const SG_VK_TO_BIT vk_to_bits[] =
+{
+    { VK_SHIFT, KBDSHIFT }, { VK_CONTROL, KBDCTRL }, { VK_MENU, KBDALT }, { 0, 0 }
+};
+
+static struct layout *layouts;
+static CRITICAL_SECTION layouts_cs;
+static CRITICAL_SECTION_DEBUG layouts_cs_debug =
+{
+    0, 0, &layouts_cs, { &layouts_cs_debug.ProcessLocksList, &layouts_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": layouts_cs") }
+};
+static CRITICAL_SECTION layouts_cs = { &layouts_cs_debug, -1, 0, 0, 0, 0 };
+
+/* the character VK gives with MODS (KBDSHIFT, KBDCTRL, KBDALT) held: WCH_NONE, or *dead set */
+static WCHAR key_char( HKL hkl, UINT vk, UINT scan, BYTE mods, BOOL *dead )
+{
+    BYTE state[256] = { 0 };
+    WCHAR buf[8];
+    int ret;
+
+    *dead = FALSE;
+    state[VK_NUMLOCK] = 0x01;
+    if (mods & KBDSHIFT) state[VK_SHIFT] = state[VK_LSHIFT] = 0x80;
+    if (mods & KBDCTRL) state[VK_CONTROL] = state[VK_LCONTROL] = 0x80;
+    if (mods & KBDALT) state[VK_MENU] = state[VK_RMENU] = 0x80;
+    /* flag 4: the keyboard state (a pending dead key) is left alone */
+    ret = ToUnicodeEx( vk, scan, state, buf, ARRAY_SIZE(buf), 4, hkl );
+    if (ret == -1) { *dead = TRUE; return buf[0]; }
+    if (ret != 1) return WCH_NONE;
+    return buf[0];
+}
+
+static BOOL skip_vk( UINT vk )
+{
+    switch (vk)
+    {
+    case VK_LBUTTON: case VK_RBUTTON: case VK_CANCEL: case VK_MBUTTON: case VK_XBUTTON1: case VK_XBUTTON2:
+    case VK_SHIFT: case VK_CONTROL: case VK_MENU: case VK_CAPITAL: case VK_LWIN: case VK_RWIN:
+    case VK_LSHIFT: case VK_RSHIFT: case VK_LCONTROL: case VK_RCONTROL: case VK_LMENU: case VK_RMENU:
+    case VK_NUMLOCK: case VK_SCROLL: case VK_PACKET: case 0xff:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void build_layout( struct layout *l )
+{
+    static const BYTE level_mods[LEVELS] = { 0, KBDSHIFT, KBDCTRL, KBDSHIFT | KBDCTRL,
+                                             KBDCTRL | KBDALT, KBDSHIFT | KBDCTRL | KBDALT };
+    unsigned int n = 0, vk, level, i;
+
+    KLP_SET( l->modifiers.pVkToBit, (SG_VK_TO_BIT *)vk_to_bits );
+    l->modifiers.wMaxModBits = 7;
+    /* none, Shift, Ctrl, Shift+Ctrl, -, -, Ctrl+Alt (AltGr), Shift+Ctrl+Alt: as KBDUS-style tables */
+    l->modifiers.ModNumber[0] = 0;
+    l->modifiers.ModNumber[1] = 1;
+    l->modifiers.ModNumber[2] = 2;
+    l->modifiers.ModNumber[3] = 3;
+    l->modifiers.ModNumber[4] = SHFT_INVALID;
+    l->modifiers.ModNumber[5] = SHFT_INVALID;
+    l->modifiers.ModNumber[6] = 4;
+    l->modifiers.ModNumber[7] = 5;
+
+    for (vk = 1; vk < 0xff && n + 2 < ARRAY_SIZE(l->entries); vk++)
+    {
+        SG_VK_TO_WCHARS entry = { vk, 0 }, dead_row = { 0xff, 0 };
+        BOOL dead, any = FALSE, any_dead = FALSE;
+        UINT scan;
+
+        if (skip_vk( vk )) continue;
+        scan = MapVirtualKeyExW( vk, MAPVK_VK_TO_VSC, l->hkl );
+        for (level = 0; level < LEVELS; level++)
+        {
+            WCHAR ch = WCH_NONE;
+            entry.wch[level] = dead_row.wch[level] = WCH_NONE;
+            /* Ctrl alone gives control characters, which user32 makes itself: no table level (KBDUS) */
+            if (level == 2 || level == 3) continue;
+            ch = key_char( l->hkl, vk, scan, level_mods[level], &dead );
+            if (ch == WCH_NONE) continue;
+            /* AltGr only where it gives a character of its own: no AltGr level, no Ctrl+Alt shortcuts eaten */
+            if (level >= 4 && (ch < 0x20 || (!dead && (ch == entry.wch[0] || ch == entry.wch[1])))) continue;
+            if (level < 4 && ch < 0x20 && vk != VK_BACK && vk != VK_RETURN && vk != VK_TAB && vk != VK_ESCAPE) continue;
+            if (dead)
+            {
+                entry.wch[level] = WCH_DEAD;
+                dead_row.wch[level] = ch;
+                any_dead = TRUE;
+            }
+            else entry.wch[level] = ch;
+            any = TRUE;
+        }
+        if (!any) continue;
+        if (entry.wch[0] != WCH_NONE && entry.wch[1] != WCH_NONE && entry.wch[0] != entry.wch[1] &&
+            IsCharLowerW( entry.wch[0] ) && (WCHAR)(UINT_PTR)CharUpperW( (WCHAR *)(UINT_PTR)entry.wch[0] ) == entry.wch[1])
+            entry.Attributes |= CAPLOK;
+        l->entries[n++] = entry;
+        if (any_dead) l->entries[n++] = dead_row;
+    }
+    memset( &l->entries[n], 0, sizeof(l->entries[n]) );   /* the end of the table */
+
+    KLP_SET( l->wchar_tables[0].pVkToWchars, l->entries );
+    l->wchar_tables[0].nModifications = LEVELS;
+    l->wchar_tables[0].cbSize = sizeof(SG_VK_TO_WCHARS);
+    memset( &l->wchar_tables[1], 0, sizeof(l->wchar_tables[1]) );
+
+    for (i = 0; i < ARRAY_SIZE(l->vsc_to_vk); i++)
+        l->vsc_to_vk[i] = MapVirtualKeyExW( i, MAPVK_VSC_TO_VK, l->hkl );
+
+    memset( &l->tables, 0, sizeof(l->tables) );
+    KLP_SET( l->tables.pCharModifiers, &l->modifiers );
+    KLP_SET( l->tables.pVkToWcharTable, l->wchar_tables );
+    KLP_SET( l->tables.pDeadKey, l->no_dead_keys );
+    KLP_SET( l->tables.pusVSCtoVK, l->vsc_to_vk );
+    l->tables.bMaxVSCtoVK = ARRAY_SIZE(l->vsc_to_vk);
+    l->tables.fLocaleFlags = MAKELONG( 0, 1 );   /* KBD_VERSION 1 */
+}
+
+/***********************************************************************
+ *      KbdLayerDescriptor (KBDSG.@)
+ *
+ * The tables of the keyboard layout active in the calling thread.
+ */
+void * WINAPI KbdLayerDescriptor(void)
+{
+    HKL hkl = GetKeyboardLayout( 0 );
+    struct layout *l;
+
+#ifdef SG_MUTANT_KBDSG_NO_TABLES
+    return NULL;
+#endif
+
+    EnterCriticalSection( &layouts_cs );
+    for (l = layouts; l; l = l->next) if (l->hkl == hkl) break;
+    if (!l && (l = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*l) )))
+    {
+        l->hkl = hkl;
+        build_layout( l );
+        l->next = layouts;
+        layouts = l;
+    }
+    LeaveCriticalSection( &layouts_cs );
+    return l ? &l->tables : NULL;
+}
