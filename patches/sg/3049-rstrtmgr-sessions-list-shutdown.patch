+BOOLEAN WINAPI SystemFunction036(void *, ULONG);
+
+#define MAX_SESSIONS 64
+
+#ifndef ERROR_MAX_SESSIONS_REACHED
+#define ERROR_MAX_SESSIONS_REACHED 353
+#endif
+#ifndef ERROR_FAIL_SHUTDOWN
+#define ERROR_FAIL_SHUTDOWN 351
+#endif
+#ifndef ERROR_FAIL_RESTART
+#define ERROR_FAIL_RESTART 352
+#endif
+#define RM_SHUTDOWN_FORCE 0x1
+#define RM_SHUTDOWN_ONLY_REGISTERED 0x10
+
+struct filter
+{
+    struct list entry;
+    WCHAR *module;
+    RM_UNIQUE_PROCESS process;
+    WCHAR *service;
+    RM_FILTER_ACTION action;
+};
+
+struct session
+{
+    struct list entry;
+    DWORD handle;
+    WCHAR key[CCH_RM_SESSION_KEY + 1];
+    WCHAR **files;
+    UINT file_count;
+    RM_UNIQUE_PROCESS *apps;
+    UINT app_count;
+    WCHAR **services;
+    UINT service_count;
+    struct list filters;
+    /* services stopped by RmShutdown(), started again by RmRestart() */
+    WCHAR **stopped;
+    UINT stopped_count;
+};
+
+static CRITICAL_SECTION rm_cs;
+static CRITICAL_SECTION_DEBUG rm_cs_debug =
+{
+    0, 0, &rm_cs,
+    { &rm_cs_debug.ProcessLocksList, &rm_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": rm_cs") }
+};
+static CRITICAL_SECTION rm_cs = { &rm_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct list sessions = LIST_INIT(sessions);
+static UINT session_count;
+static DWORD next_handle = 1;
+
+static struct session *find_session(DWORD handle)
+{
+    struct session *session;
+
+    LIST_FOR_EACH_ENTRY(session, &sessions, struct session, entry)
+        if (session->handle == handle) return session;
+    return NULL;
+}
+
+static void free_string_list(WCHAR **list, UINT count)
+{
+    UINT i;
+
+    for (i = 0; i < count; i++) free(list[i]);
+    free(list);
+}
+
+static BOOL append_string(WCHAR ***list, UINT *count, const WCHAR *str)
+{
+    WCHAR **new_list;
+    WCHAR *copy;
+    UINT i;
+
+    for (i = 0; i < *count; i++)
+        if (!wcsicmp((*list)[i], str)) return TRUE;
+
+    if (!(copy = wcsdup(str))) return FALSE;
+    if (!(new_list = realloc(*list, (*count + 1) * sizeof(**list))))
+    {
+        free(copy);
+        return FALSE;
+    }
+    new_list[(*count)++] = copy;
+    *list = new_list;
+    return TRUE;
+}
