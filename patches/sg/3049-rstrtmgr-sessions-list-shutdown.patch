+}
+
+/* One process that is affected by the registered resources. */
+struct affected
+{
+    RM_PROCESS_INFO *info;
+    UINT count, size;
+    DWORD reasons;
+};
+
+static BOOL get_process_times(HANDLE process, FILETIME *start)
+{
+    FILETIME exit, kernel, user;
+
+    return GetProcessTimes(process, start, &exit, &kernel, &user);
+}
+
+static BOOL add_affected(struct affected *affected, DWORD pid, const WCHAR *service, const WCHAR *display_name,
+        RM_APP_TYPE type)
+{
+    RM_PROCESS_INFO *info;
+    HANDLE process;
+    UINT i;
+
+    for (i = 0; i < affected->count; i++)
+        if (affected->info[i].Process.dwProcessId == pid &&
+            !wcscmp(affected->info[i].strServiceShortName, service ? service : L""))
+            return TRUE;
+
+    if (affected->count == affected->size)
+    {
+        UINT size = affected->size ? affected->size * 2 : 8;
+        if (!(info = realloc(affected->info, size * sizeof(*info)))) return FALSE;
+        affected->info = info;
+        affected->size = size;
+    }
+    info = &affected->info[affected->count];
+    memset(info, 0, sizeof(*info));
+    info->Process.dwProcessId = pid;
+    if ((process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid)))
+    {
+        WCHAR path[MAX_PATH];
+        DWORD len = ARRAY_SIZE(path);
+
+        get_process_times(process, &info->Process.ProcessStartTime);
+        if (!display_name && QueryFullProcessImageNameW(process, 0, path, &len))
+        {
+            const WCHAR *name = wcsrchr(path, '\\');
+            lstrcpynW(info->strAppName, name ? name + 1 : path, ARRAY_SIZE(info->strAppName));
+        }
+        CloseHandle(process);
+    }
+    if (display_name) lstrcpynW(info->strAppName, display_name, ARRAY_SIZE(info->strAppName));
+    if (service) lstrcpynW(info->strServiceShortName, service, ARRAY_SIZE(info->strServiceShortName));
+    info->ApplicationType = type;
+    info->AppStatus = 1; /* RmStatusRunning */
+    if (!ProcessIdToSessionId(pid, &info->TSSessionID)) info->TSSessionID = 0;
+    info->bRestartable = type == RmService;
+    affected->count++;
+    if (pid == GetCurrentProcessId()) affected->reasons |= RmRebootReasonDetectedSelf;
+    return TRUE;
+}
+
+/* Does the process have one of the files as its executable or as a loaded module? */
+static BOOL process_uses_file(DWORD pid, const WCHAR *file)
+{
+    MODULEENTRY32W module;
+    HANDLE snapshot;
+    BOOL found = FALSE;
+
+    snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPMODULE | 0x10 /* TH32CS_SNAPMODULE32 */, pid);
+    if (snapshot == INVALID_HANDLE_VALUE) return FALSE;
+
+    module.dwSize = sizeof(module);
+    if (Module32FirstW(snapshot, &module))
+    {
+        do
+        {
+            if (!wcsicmp(module.szExePath, file)) { found = TRUE; break; }
+        } while (Module32NextW(snapshot, &module));
+    }
+    CloseHandle(snapshot);
+    return found;
+}
+
+static DWORD collect_affected(struct session *session, struct affected *affected)
+{
+    PROCESSENTRY32W entry;
+    HANDLE snapshot;
+    UINT i;
+
+    memset(affected, 0, sizeof(*affected));
+
+    /* registered applications */
+    for (i = 0; i < session->app_count; i++)
+    {
+        const RM_UNIQUE_PROCESS *app = &session->apps[i];
+        FILETIME start;
+        HANDLE process;
+
+        if (!(process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, app->dwProcessId))) continue;
+        if (!get_process_times(process, &start) || CompareFileTime(&start, &app->ProcessStartTime))
+        {
+            CloseHandle(process);
+            continue;
+        }
+        CloseHandle(process);
+        if (!add_affected(affected, app->dwProcessId, NULL, NULL, RmOtherWindow)) return ERROR_OUTOFMEMORY;
+    }
+
+    /* processes that run or have loaded a registered file */
+    if (session->file_count)
+    {
+        snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+        if (snapshot != INVALID_HANDLE_VALUE)
+        {
+            entry.dwSize = sizeof(entry);
+            if (Process32FirstW(snapshot, &entry))
+            {
+                do
+                {
+                    if (!entry.th32ProcessID) continue;
+                    for (i = 0; i < session->file_count; i++)
+                    {
+                        if (process_uses_file(entry.th32ProcessID, session->files[i]))
+                        {
+                            if (!add_affected(affected, entry.th32ProcessID, NULL, NULL, RmOtherWindow))
+                            {
+                                CloseHandle(snapshot);
+                                return ERROR_OUTOFMEMORY;
+                            }
+                            break;
+                        }
+                    }
+                } while (Process32NextW(snapshot, &entry));
+            }
+            CloseHandle(snapshot);
+        }
+    }
+
+    /* registered services that are running */
+    if (session->service_count)
+    {
+        SC_HANDLE manager = OpenSCManagerW(NULL, NULL, SC_MANAGER_CONNECT);
+
+        if (manager)
+        {
+            for (i = 0; i < session->service_count; i++)
+            {
+                SERVICE_STATUS_PROCESS status;
+                DWORD needed;
+                SC_HANDLE service = OpenServiceW(manager, session->services[i], SERVICE_QUERY_STATUS);
+
+                if (!service) continue;
+                if (QueryServiceStatusEx(service, SC_STATUS_PROCESS_INFO, (BYTE *)&status, sizeof(status), &needed)
+                        && status.dwCurrentState != SERVICE_STOPPED)
+                {
+                    WCHAR display[CCH_RM_MAX_APP_NAME + 1];
+                    DWORD size = ARRAY_SIZE(display);
+
+                    if (!GetServiceDisplayNameW(manager, session->services[i], display, &size))
+                        wcscpy(display, session->services[i]);
+                    add_affected(affected, status.dwProcessId, session->services[i], display, RmService);
+                }
+                CloseServiceHandle(service);
+            }
+            CloseServiceHandle(manager);
+        }
+    }
+
     return ERROR_SUCCESS;
 }
 
 /***********************************************************************
- * RmStartSession (rstrtmgr.@)
+ * RmGetList (rstrtmgr.@)
  *
- * Start a new Restart Manager session
+ * Retrieve the list of all applications and services using resources registered with the Restart Manager session
  */
-DWORD WINAPI RmStartSession(DWORD *sessionhandle, DWORD flags, WCHAR sessionkey[])
+DWORD WINAPI RmGetList(DWORD dwSessionHandle, UINT *pnProcInfoNeeded, UINT *pnProcInfo,
+                                      RM_PROCESS_INFO *rgAffectedApps[], LPDWORD lpdwRebootReasons)
 {
-    FIXME("%p, %ld, %p stub!\n", sessionhandle, flags, sessionkey);
-    if (sessionhandle)
-        *sessionhandle = 0xdeadbeef;
-    return ERROR_SUCCESS;
+    RM_PROCESS_INFO *out = (RM_PROCESS_INFO *)rgAffectedApps;
+    struct session *session;
+    struct affected affected;
+    DWORD ret;
+
+    TRACE("%ld, %p, %p, %p, %p\n", dwSessionHandle, pnProcInfoNeeded, pnProcInfo, rgAffectedApps, lpdwRebootReasons);
+
+    if (!pnProcInfoNeeded || !pnProcInfo) return ERROR_INVALID_PARAMETER;
+
+    EnterCriticalSection(&rm_cs);
+    if (!(session = find_session(dwSessionHandle)))
+    {
+        LeaveCriticalSection(&rm_cs);
+        return ERROR_INVALID_HANDLE;
+    }
+    ret = collect_affected(session, &affected);
+    LeaveCriticalSection(&rm_cs);
+    if (ret) return ret;
+
+    *pnProcInfoNeeded = affected.count;
+    if (lpdwRebootReasons) *lpdwRebootReasons = affected.reasons;
+
+    if (!affected.count)
+    {
+        *pnProcInfo = 0;
+        free(affected.info);
+        return ERROR_SUCCESS;
+    }
+
+    if (!out || *pnProcInfo < affected.count)
+        ret = ERROR_MORE_DATA;
+    else
+    {
+        memcpy(out, affected.info, affected.count * sizeof(*out));
+        *pnProcInfo = affected.count;
+    }
+    free(affected.info);
+    return ret;
+}
+
+static BOOL is_filtered(struct session *session, const RM_PROCESS_INFO *info, RM_FILTER_ACTION action)
+{
+    struct filter *filter;
+
+    LIST_FOR_EACH_ENTRY(filter, &session->filters, struct filter, entry)
+    {
+        if (!(filter->action & action)) continue;
+        if (filter->service && info->strServiceShortName[0] && !wcsicmp(filter->service, info->strServiceShortName))
+            return TRUE;
+        if (!filter->service && !filter->module && filter->process.dwProcessId == info->Process.dwProcessId)
+            return TRUE;
+        if (filter->module)
+        {
+            WCHAR path[MAX_PATH];
+            DWORD len = ARRAY_SIZE(path);
+            HANDLE process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, info->Process.dwProcessId);
+            BOOL match = FALSE;
+
+            if (process)
+            {
+                if (QueryFullProcessImageNameW(process, 0, path, &len)) match = !wcsicmp(path, filter->module);
+                CloseHandle(process);
+            }
+            if (match) return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+struct close_data
+{
+    DWORD pid;
+    BOOL found;
+};
+
+static BOOL CALLBACK close_window(HWND hwnd, LPARAM lparam)
+{
+    struct close_data *data = (struct close_data *)lparam;
+    DWORD pid;
+
+    GetWindowThreadProcessId(hwnd, &pid);
+    if (pid == data->pid && !GetWindow(hwnd, GW_OWNER))
+    {
+        data->found = TRUE;
+        PostMessageW(hwnd, WM_CLOSE, 0, 0);
+    }
+    return TRUE;
 }
 
 /***********************************************************************
- * RmRestart (rstrtmgr.@)
+ * RmShutdown (rstrtmgr.@)
  */
-DWORD WINAPI RmRestart(DWORD handle, DWORD flags, RM_WRITE_STATUS_CALLBACK status)
+DWORD WINAPI RmShutdown(DWORD handle, ULONG flags, RM_WRITE_STATUS_CALLBACK status)
 {
-    FIXME("%lu, 0x%08lx, %p stub!\n", handle, flags, status);
-    return ERROR_SUCCESS;
+    struct session *session;
+    struct affected affected;
+    DWORD ret = ERROR_SUCCESS;
+    UINT i;
+
+    TRACE("%lu, 0x%08lx, %p\n", handle, flags, status);
+
+    if (flags & ~(RM_SHUTDOWN_FORCE | RM_SHUTDOWN_ONLY_REGISTERED | 0x1)) return ERROR_INVALID_PARAMETER;
+
+    EnterCriticalSection(&rm_cs);
+    if (!(session = find_session(handle)))
+    {
+        LeaveCriticalSection(&rm_cs);
+        return ERROR_INVALID_HANDLE;
+    }
+    if ((ret = collect_affected(session, &affected)))
+    {
+        LeaveCriticalSection(&rm_cs);
+        return ret;
+    }
+
+    if (status) status(0);
+    for (i = 0; i < affected.count && !ret; i++)
+    {
+        RM_PROCESS_INFO *info = &affected.info[i];
+        DWORD pid = info->Process.dwProcessId;
+
+        if (pid == GetCurrentProcessId() || is_filtered(session, info, RmNoShutdown))
+            continue;
+
+        if (info->ApplicationType == RmService)
+        {
+            SC_HANDLE manager = OpenSCManagerW(NULL, NULL, SC_MANAGER_CONNECT);
+            SC_HANDLE service = manager ? OpenServiceW(manager, info->strServiceShortName,
+                    SERVICE_STOP | SERVICE_QUERY_STATUS) : NULL;
+            SERVICE_STATUS service_status;
+
+            if (service && ControlService(service, SERVICE_CONTROL_STOP, &service_status))
+            {
+                DWORD wait;
+                for (wait = 0; wait < 50 && QueryServiceStatus(service, &service_status)
+                        && service_status.dwCurrentState != SERVICE_STOPPED; wait++)
+                    Sleep(100);
+                if (service_status.dwCurrentState == SERVICE_STOPPED)
+                    append_string(&session->stopped, &session->stopped_count, info->strServiceShortName);
+                else
+                    ret = ERROR_FAIL_SHUTDOWN;
+            }
+            else if (GetLastError() != ERROR_SERVICE_NOT_ACTIVE)
+                ret = ERROR_FAIL_SHUTDOWN;
+            if (service) CloseServiceHandle(service);
+            if (manager) CloseServiceHandle(manager);
+        }
+        else
+        {
+            struct close_data data = { pid, FALSE };
+            HANDLE process = OpenProcess(SYNCHRONIZE | PROCESS_TERMINATE, FALSE, pid);
+
+            if (!process) continue;
+            EnumWindows(close_window, (LPARAM)&data);
+            if (WaitForSingleObject(process, data.found ? 5000 : 0) != WAIT_OBJECT_0)
+            {
+                if ((flags & RM_SHUTDOWN_FORCE) && TerminateProcess(process, 1))
+                    WaitForSingleObject(process, 2000);
+                else
+                    ret = ERROR_FAIL_SHUTDOWN;
+            }
+            CloseHandle(process);
+        }
+        if (status) status((i + 1) * 100 / affected.count);
+    }
+    LeaveCriticalSection(&rm_cs);
+    free(affected.info);
+    if (!ret && status) status(100);
+    return ret;
 }
 
 /***********************************************************************
- * RmEndSession (rstrtmgr.@)
+ * RmRestart (rstrtmgr.@)
  */
-DWORD WINAPI RmEndSession(DWORD handle)
+DWORD WINAPI RmRestart(DWORD handle, DWORD flags, RM_WRITE_STATUS_CALLBACK status)
 {
-    FIXME("%lu stub!\n", handle);
-    return ERROR_SUCCESS;
+    struct session *session;
+    DWORD ret = ERROR_SUCCESS;
+    SC_HANDLE manager;
