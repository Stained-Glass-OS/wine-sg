+
+/***********************************************************************
+ * RmJoinSession (rstrtmgr.@)
+ */
+DWORD WINAPI RmJoinSession(DWORD *sessionhandle, const WCHAR sessionkey[])
+{
+    struct session *session;
+    DWORD ret = ERROR_INVALID_PARAMETER;
+
+    TRACE("%p, %s\n", sessionhandle, debugstr_w(sessionkey));
+
+    if (!sessionhandle || !sessionkey) return ERROR_INVALID_PARAMETER;
+
+    EnterCriticalSection(&rm_cs);
+    LIST_FOR_EACH_ENTRY(session, &sessions, struct session, entry)
+    {
+        if (!wcsicmp(session->key, sessionkey))
+        {
+            *sessionhandle = session->handle;
+            ret = ERROR_SUCCESS;
+            break;
+        }
+    }
+    LeaveCriticalSection(&rm_cs);
+    return ret;
+}
+
+/***********************************************************************
+ * RmEndSession (rstrtmgr.@)
+ */
+DWORD WINAPI RmEndSession(DWORD handle)
+{
+    struct session *session;
+    struct filter *filter, *next;
+
+    TRACE("%lu\n", handle);
+
+    EnterCriticalSection(&rm_cs);
+    if (!(session = find_session(handle)))
+    {
+        LeaveCriticalSection(&rm_cs);
+        return ERROR_INVALID_HANDLE;
+    }
+    list_remove(&session->entry);
+    session_count--;
+    LeaveCriticalSection(&rm_cs);
+
+    LIST_FOR_EACH_ENTRY_SAFE(filter, next, &session->filters, struct filter, entry)
+    {
+        list_remove(&filter->entry);
+        free(filter->module);
+        free(filter->service);
+        free(filter);
+    }
+    free_string_list(session->files, session->file_count);
+    free_string_list(session->services, session->service_count);
+    free_string_list(session->stopped, session->stopped_count);
+    free(session->apps);
+    free(session);
     return ERROR_SUCCESS;
 }
 
@@ -51,49 +240,460 @@ DWORD WINAPI RmRegisterResources(DWORD dwSessionHandle, UINT nFiles, LPCWSTR rgs
                                                      UINT nApplications, RM_UNIQUE_PROCESS *rgApplications,
                                                      UINT nServices, LPCWSTR rgsServiceNames[])
 {
