From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: a process whose new wineserver dies before answering it ends, it does not hang (9200)

A process kept its own copy of its reply pipe's write end until the server
answered the request that went with it (init_first_thread, init_thread). Only
the server writes replies, but with that copy open the pipe still had a
writer, so a server that died before answering -- "wineserver -k" while a
session started, a crash -- left the read waiting for ever: the process
hung, and its parent with it (bugs1, 2026-11-22). The copy is closed as soon
as it is sent; the server has its own (in flight or received), and the fd
number stays the key the server finds it under. A server that dies now gives
end-of-file, as on every later request.

While the process is still being started, a server that goes away is now an
error, not an orderly end: "wine: the wineserver exited before it finished
starting this process" and status 1 (it was status 0, or a hang). Later, a
closed connection ends the thread quietly as before. Mutant
SG_MUTANT_KEEP_REPLY_WRITER; gate test-srvdeath (a stand-in server that dies
after taking the first request).
---
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -101,6 +101,8 @@
 
 sigset_t server_block_set;  /* signals to block during server calls */
 static int fd_socket = -1;  /* socket to exchange file descriptors with the server */
+/* the server has not yet answered this process's first request (patches/sg/9200) */
+static BOOL server_starting;
 static int initial_cwd = -1;
 static pid_t server_pid;
 static pthread_mutex_t fd_cache_mutex = PTHREAD_MUTEX_INITIALIZER;
@@ -175,6 +177,21 @@
 
 
 /***********************************************************************
+ *           server_gone
+ *
+ * The server closed the connection.  While the process is still being started that is an
+ * error (a server killed or crashed mid-start), not an orderly end: say so and exit with 1
+ * rather than 0, so whoever started the process does not take it for a success.
+ */
+static void DECLSPEC_NORETURN server_gone(void)
+{
+    if (server_starting)
+        fatal_error( "the wineserver exited before it finished starting this process\n" );
+    abort_thread(0);
+}
+
+
+/***********************************************************************
  *           send_request
  *
  * Send a request to the server.
@@ -206,7 +223,7 @@
     }
 
     if (ret >= 0) server_protocol_error( "partial write %d\n", ret );
-    if (errno == EPIPE) abort_thread(0);
+    if (errno == EPIPE) server_gone();
     if (errno == EFAULT) return STATUS_ACCESS_VIOLATION;
     server_protocol_perror( "write" );
 }
@@ -235,7 +252,7 @@
         server_protocol_perror("read");
     }
     /* the server closed the connection; time to die... */
-    abort_thread(0);
+    server_gone();
 }
 
 
@@ -985,7 +1002,7 @@
         server_protocol_perror("recvmsg");
     }
     /* the server closed the connection; time to die... */
-    abort_thread(0);
+    server_gone();
 }
 
 
@@ -1591,6 +1608,13 @@
     wine_server_send_fd( reply_pipe[1] );
     wine_server_send_fd( ntdll_get_thread_data()->wait_fd[1] );
     ntdll_get_thread_data()->reply_fd = reply_pipe[0];
+    /* The server has its own copy now (in flight or received), and only the server writes
+     * replies.  Keeping ours open until the reply came meant that a server that died before
+     * answering left the read below waiting for ever: the pipe still had a writer -- us.
+     * The number stays the server's key for the fd it received (patches/sg/9200). */
+#ifndef SG_MUTANT_KEEP_REPLY_WRITER
+    close( reply_pipe[1] );
+#endif
     return reply_pipe[1];
 }
 
@@ -1655,6 +1679,7 @@
     pthread_sigmask( SIG_BLOCK, &server_block_set, NULL );
 
     /* receive the first thread request fd on the main socket */
+    server_starting = TRUE;
     ntdll_get_thread_data()->request_fd = receive_fd( &version );
 
 #ifdef SO_PASSCRED
@@ -1702,7 +1727,10 @@
         supported_machines_count = wine_server_reply_size( reply ) / sizeof(*supported_machines);
     }
     SERVER_END_REQ;
+    server_starting = FALSE;
+#ifdef SG_MUTANT_KEEP_REPLY_WRITER
     close( reply_pipe );
+#endif
 
     if (ret) server_protocol_error( "init_first_thread failed with status %x\n", ret );
 
@@ -1857,7 +1885,9 @@
         *suspend = reply->suspend;
     }
     SERVER_END_REQ;
+#ifdef SG_MUTANT_KEEP_REPLY_WRITER
     close( reply_pipe );
+#endif
 }
 
 NTSTATUS WINAPI NtAllocateReserveObject( HANDLE *handle, const OBJECT_ATTRIBUTES *attr,
