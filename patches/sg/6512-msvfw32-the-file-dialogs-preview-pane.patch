+                    WCHAR error_str[MAXERRORLENGTH];
 
-                mciGetErrorStringW(mwi->lasterror, error_str, MAXERRORLENGTH);
-                MessageBoxW(hWnd, error_str, caption, MB_ICONEXCLAMATION | MB_OK);
+                    mciGetErrorStringW(mwi->lasterror, error_str, MAXERRORLENGTH);
+                    MessageBoxW(hWnd, error_str, caption, MB_ICONEXCLAMATION | MB_OK);
+                }
                 MCIWND_notify_error(mwi);
