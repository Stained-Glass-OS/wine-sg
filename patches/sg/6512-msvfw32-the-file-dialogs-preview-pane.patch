From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvfw32: The file dialogs' preview pane (6512)

GetOpenFileNamePreview and GetSaveFileNamePreview were the plain file
dialogs. An MCI window beside the dialog's controls now plays the
selected file, with its size and length below; the program's own hook
still sees every message (WM_INITDIALOG with its own OPENFILENAME),
and a program's own template keeps the plain dialog. On the way:
MCIWnd took an uninitialised device ID after a failed open with
MCIWNDF_NOERRORDLG, and the AVI writer wrote the main header's frame
time inverted (a 10 fps file said 10 s per frame).
---
diff --git a/dlls/avifil32/avifile.c b/dlls/avifil32/avifile.c
index 89bc337..668f65c 100644
--- a/dlls/avifil32/avifile.c
+++ b/dlls/avifil32/avifile.c
@@ -1687,8 +1687,9 @@ static HRESULT AVIFILE_LoadFile(IAVIFileImpl *This)
 
   /* convert MainAVIHeader into AVIFILINFOW */
   memset(&This->fInfo, 0, sizeof(This->fInfo));
-  This->fInfo.dwRate                = MainAVIHdr.dwMicroSecPerFrame;
-  This->fInfo.dwScale               = 1000000;
+  /* frames per second, as AVIFileInfo gives it (and as the header is written back) */
+  This->fInfo.dwRate                = 1000000;
+  This->fInfo.dwScale               = MainAVIHdr.dwMicroSecPerFrame ? MainAVIHdr.dwMicroSecPerFrame : 1000000;
   This->fInfo.dwMaxBytesPerSec      = MainAVIHdr.dwMaxBytesPerSec;
   This->fInfo.dwFlags               = MainAVIHdr.dwFlags;
   This->fInfo.dwCaps                = AVIFILECAPS_CANREAD|AVIFILECAPS_CANWRITE;
@@ -2237,11 +2238,19 @@ static HRESULT AVIFILE_SaveFile(IAVIFileImpl *This)
       return hr;
   }
 
-  assert(This->fInfo.dwScale != 0);
+  assert(This->fInfo.dwRate != 0);
 
   memset(&MainAVIHdr, 0, sizeof(MainAVIHdr));
+  /* Stained Glass OS (wine-sg 6512): dwRate / dwScale is frames per second, so a frame lasts
+   * dwScale / dwRate seconds; this wrote the inverse (a 10 fps file said 10 s per frame, and
+   * players that time by the main header played it a hundred times too slowly). */
+#ifdef SG_MUTANT_AVI_FRAME_TIME_INVERTED
   MainAVIHdr.dwMicroSecPerFrame    = MulDiv(This->fInfo.dwRate, 1000000,
 					    This->fInfo.dwScale);
+#else
+  MainAVIHdr.dwMicroSecPerFrame    = MulDiv(This->fInfo.dwScale, 1000000,
+					    This->fInfo.dwRate);
+#endif
   MainAVIHdr.dwMaxBytesPerSec      = This->fInfo.dwMaxBytesPerSec;
   MainAVIHdr.dwPaddingGranularity  = AVI_HEADERSIZE;
   MainAVIHdr.dwFlags               = This->fInfo.dwFlags;
