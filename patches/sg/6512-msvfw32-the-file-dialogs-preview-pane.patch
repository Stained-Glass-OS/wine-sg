diff --git a/dlls/msvfw32/msvfw32.rc b/dlls/msvfw32/msvfw32.rc
index eded377..e5ffeb3 100644
--- a/dlls/msvfw32/msvfw32.rc
+++ b/dlls/msvfw32/msvfw32.rc
@@ -25,6 +25,18 @@ LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT
 STRINGTABLE
 {
     IDS_FULLFRAMES "Full Frames (Uncompressed)"
+    IDS_PREVIEW_INFO "%1!u! x %2!u!, %3!u!.%4!u! s"
+    IDS_PREVIEW_SOUND "%1!u!.%2!u! s"
+}
+
+/* the preview pane of GetOpenFileNamePreview and GetSaveFileNamePreview, beside the dialog's own controls (stc32) */
+FILE_PREVIEW_TEMPLATE DIALOG 0, 0, 280, 140
