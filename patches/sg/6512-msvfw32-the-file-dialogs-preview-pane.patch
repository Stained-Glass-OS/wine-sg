diff --git a/dlls/msvfw32/msvideo_main.c b/dlls/msvfw32/msvideo_main.c
index 03dca10..010a453 100644
--- a/dlls/msvfw32/msvideo_main.c
+++ b/dlls/msvfw32/msvideo_main.c
@@ -1620,14 +1620,142 @@ error:
     return FALSE;
 }
 
+/*
+ * Stained Glass OS (wine-sg 6512): the file dialogs show a preview. GetOpenFileNamePreview and
+ * GetSaveFileNamePreview were the plain dialogs ("The preview pane of the dialog is not
+ * implemented"); now an MCI window beside the dialog's controls plays the selected file, with its
+ * size and length below. The program's own hook still sees every message, and WM_INITDIALOG with
+ * its own OPENFILENAME; a program's own template keeps the plain dialog.
+ */
+struct preview
+{
+    void *app_ofn;          /* the program's OPENFILENAMEA/W */
+    LPOFNHOOKPROC hook;     /* the program's hook, if any */
+    BOOL unicode;
+    HWND mciwnd;
+};
+
+/* the MCI window fills the pane's group box (where the dialog arranged it) */
+static void preview_place(HWND dlg, struct preview *preview)
+{
+    RECT rect;
+
+    if (!preview->mciwnd) return;
+    GetWindowRect(GetDlgItem(dlg, IDC_PREVIEW_GROUP), &rect);
+    MapWindowPoints(NULL, dlg, (POINT *)&rect, 2);
+    InflateRect(&rect, -6, -6);
+    rect.top += 8;
+    SetWindowPos(preview->mciwnd, NULL, rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top,
+                 SWP_NOZORDER | SWP_NOACTIVATE);
+}
+
+static const WCHAR preview_prop[] = L"sg_msvfw_preview";
+
+static void preview_info(HWND dlg, struct preview *preview, BOOL opened)
+{
+    WCHAR text[128] = L"", fmt[64];
+    RECT rect;
+    LONG length;
+    DWORD_PTR args[4];
+
+    if (opened)
+    {
+        SendMessageW(preview->mciwnd, MCIWNDM_SETTIMEFORMATW, 0, (LPARAM)L"ms");
+        length = SendMessageW(preview->mciwnd, MCIWNDM_GETLENGTH, 0, 0);
+        SetRectEmpty(&rect);
+        SendMessageW(preview->mciwnd, MCIWNDM_GET_SOURCE, 0, (LPARAM)&rect);
+        if (!IsRectEmpty(&rect))
+        {
+            LoadStringW(MSVFW32_hModule, IDS_PREVIEW_INFO, fmt, ARRAY_SIZE(fmt));
+            args[0] = rect.right - rect.left;
+            args[1] = rect.bottom - rect.top;
+            args[2] = length / 1000;
+            args[3] = (length % 1000) / 100;
+        }
+        else
+        {
+            LoadStringW(MSVFW32_hModule, IDS_PREVIEW_SOUND, fmt, ARRAY_SIZE(fmt));
+            args[0] = length / 1000;
+            args[1] = (length % 1000) / 100;
+        }
+        FormatMessageW(FORMAT_MESSAGE_FROM_STRING | FORMAT_MESSAGE_ARGUMENT_ARRAY, fmt, 0, 0, text,
+                       ARRAY_SIZE(text), (va_list *)args);
+    }
+    SetDlgItemTextW(dlg, IDC_PREVIEW_INFO, text);
+}
+
+/* the selected file, in the MCI window */
+static void preview_file(HWND dlg, struct preview *preview)
+{
+    WCHAR path[MAX_PATH] = L"";
+    DWORD attributes;
+    BOOL opened = FALSE;
+
+    if (!preview->mciwnd) return;
+    if (preview->unicode)
+        SendMessageW(GetParent(dlg), CDM_GETFILEPATH, ARRAY_SIZE(path), (LPARAM)path);
+    else
+    {
+        char pathA[MAX_PATH] = "";
+        SendMessageA(GetParent(dlg), CDM_GETFILEPATH, ARRAY_SIZE(pathA), (LPARAM)pathA);
+        MultiByteToWideChar(CP_ACP, 0, pathA, -1, path, ARRAY_SIZE(path));
+    }
+    TRACE("%s\n", debugstr_w(path));
+    attributes = GetFileAttributesW(path);
+    SendMessageW(preview->mciwnd, MCI_CLOSE, 0, 0);
+#ifndef SG_MUTANT_PREVIEW_NO_OPEN
+    if (path[0] && attributes != INVALID_FILE_ATTRIBUTES && !(attributes & FILE_ATTRIBUTE_DIRECTORY))
+        opened = !SendMessageW(preview->mciwnd, MCIWNDM_OPENW, 0, (LPARAM)path);
+#endif
+    /* the window keeps the pane's place whatever it opened */
+    preview_place(dlg, preview);
+    preview_info(dlg, preview, opened);
+}
+
+static UINT_PTR CALLBACK preview_hook(HWND dlg, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct preview *preview = GetPropW(dlg, preview_prop);
+    UINT_PTR ret = 0;
+
+    if (msg == WM_INITDIALOG)
+    {
+        preview = (struct preview *)((OPENFILENAMEW *)lparam)->lCustData;
+        SetPropW(dlg, preview_prop, preview);
+        preview->mciwnd = MCIWndCreateW(dlg, MSVFW32_hModule,
+                                        WS_CHILD | WS_VISIBLE | WS_BORDER | MCIWNDF_NOMENU | MCIWNDF_NOOPEN |
+                                        MCIWNDF_NOERRORDLG | MCIWNDF_NOAUTOSIZEWINDOW | MCIWNDF_NOAUTOSIZEMOVIE, NULL);
+        preview_place(dlg, preview);
+        if (preview->hook) return preview->hook(dlg, msg, wparam, (LPARAM)preview->app_ofn);
+        return TRUE;
+    }
+    if (!preview) return 0;
+
+    if (msg == WM_NOTIFY)
+    {
+        NMHDR *hdr = (NMHDR *)lparam;
+        if (hdr->code == CDN_SELCHANGE || hdr->code == CDN_INITDONE) preview_file(dlg, preview);
+    }
+    if (preview->hook) ret = preview->hook(dlg, msg, wparam, lparam);
+    if (msg == WM_DESTROY)
+    {
+        if (preview->mciwnd) SendMessageW(preview->mciwnd, WM_CLOSE, 0, 0);
+        preview->mciwnd = NULL;
+        RemovePropW(dlg, preview_prop);
+    }
+    return ret;
+}
+
 /***********************************************************************
  *      GetFileNamePreview   [MSVFW32.@]
  */
 static BOOL GetFileNamePreview(LPVOID lpofn,BOOL bSave,BOOL bUnicode)
 {
   CHAR    szFunctionName[20];
-  BOOL    (*fnGetFileName)(LPVOID);
+  BOOL    (WINAPI *fnGetFileName)(LPVOID);
+  OPENFILENAMEW *app = lpofn, copy;
+  struct preview preview = { lpofn, NULL, bUnicode, NULL };
   HMODULE hComdlg32;
+  DWORD   size;
   BOOL    ret;
 
   TRACE("(%p,%d,%d)\n",lpofn,bSave,bUnicode);
@@ -1646,8 +1774,36 @@ static BOOL GetFileNamePreview(LPVOID lpofn,BOOL bSave,BOOL bUnicode)
     return FALSE;
   }
 
-  FIXME("The preview pane of the dialog is not implemented.\n");
-  ret = fnGetFileName(lpofn);
+  /* OPENFILENAMEA and OPENFILENAMEW have one layout of pointers and sizes */
+  size = app ? app->lStructSize : 0;
+  if (!app || size < OPENFILENAME_SIZE_VERSION_400W || size > sizeof(copy) ||
+      (app->Flags & (OFN_ENABLETEMPLATE | OFN_ENABLETEMPLATEHANDLE)) ||
+      ((app->Flags & OFN_ENABLEHOOK) && !(app->Flags & OFN_EXPLORER)))
+  {
+    /* the program's own template (or an old-style hook): its dialog as it made it */
+    ret = fnGetFileName(lpofn);
+    FreeLibrary(hComdlg32);
+    return ret;
+  }
+
+  memset(&copy, 0, sizeof(copy));
+  memcpy(&copy, app, size);
+  if (app->Flags & OFN_ENABLEHOOK) preview.hook = app->lpfnHook;
+  copy.Flags |= OFN_EXPLORER | OFN_ENABLEHOOK | OFN_ENABLETEMPLATE;
+  copy.hInstance = MSVFW32_hModule;
+  copy.lpTemplateName = MAKEINTRESOURCEW(FILE_PREVIEW_TEMPLATE);
+  copy.lpfnHook = preview_hook;
+  copy.lCustData = (LPARAM)&preview;
+
+  ret = fnGetFileName(&copy);
+
+  /* what the dialog wrote back */
+  app->Flags = (copy.Flags & ~(OFN_EXPLORER | OFN_ENABLEHOOK | OFN_ENABLETEMPLATE)) |
+               (app->Flags & (OFN_EXPLORER | OFN_ENABLEHOOK | OFN_ENABLETEMPLATE));
+  app->nFilterIndex = copy.nFilterIndex;
+  app->nFileOffset = copy.nFileOffset;
+  app->nFileExtension = copy.nFileExtension;
+  if (size >= sizeof(OPENFILENAMEW)) app->FlagsEx = copy.FlagsEx;
 
   FreeLibrary(hComdlg32);
   return ret;
diff --git a/dlls/msvfw32/msvideo_private.h b/dlls/msvfw32/msvideo_private.h
index 8bce5cd..d5b98d7 100644
--- a/dlls/msvfw32/msvideo_private.h
+++ b/dlls/msvfw32/msvideo_private.h
@@ -26,6 +26,13 @@
 #define IDC_COMP_LIST 880
 #define IDS_FULLFRAMES 901
 
+/* Stained Glass OS (wine-sg 6512): the file dialogs' preview pane */
+#define FILE_PREVIEW_TEMPLATE 2
+#define IDC_PREVIEW_GROUP 0x930
+#define IDC_PREVIEW_INFO 0x931
+#define IDS_PREVIEW_INFO 902
+#define IDS_PREVIEW_SOUND 903
+
 /* HIC struct (same layout as Win95 one) */
 typedef struct tagWINE_HIC {
     DWORD		magic;		/* 00: 'Smag' */
