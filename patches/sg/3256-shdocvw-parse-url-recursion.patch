From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:13:59 -0700
Subject: [PATCH] shdocvw: IEParseDisplayNameWithBCW no longer recurses on URLs
 (3256)

IEParseDisplayNameWithBCW (ordinal 218, added by 3167) passed every name
back to SHParseDisplayName. The desktop folder hands each name that has
a URL scheme to this function, so SHParseDisplayName of an http:, about:
or file: name called itself until the stack overflowed (explorer and
every Open dialog parse names this way). The culprit is 3167; origin/main
does not have it (stock Wine returns E_FAIL there).

- A name without a URL scheme is a file system name: SHParseDisplayName.
- file: goes through PathCreateFromUrlW and the path is parsed.
- Any other address (http:, about:, ftp:, ...) gets the private list
  that ieframe's browser service reads back (same layout as url_pidl).
- shell32's test_ParseDisplayName no longer expects http:, http:test,
  http:\test and xx: to fail (Windows returns S_OK; todo marks removed).

diff --git a/dlls/shdocvw/shdocvw_main.c b/dlls/shdocvw/shdocvw_main.c
index 4b113b6..f00f732 100644
--- a/dlls/shdocvw/shdocvw_main.c
+++ b/dlls/shdocvw/shdocvw_main.c
@@ -422,13 +422,35 @@ DWORD WINAPI ParseURLFromOutsideSourceA(LPCSTR url, LPSTR out, LPDWORD plen, LPD
     return res;
 }
 
+/* An address that is not a file system item has no shell item id list of its own; the
+ * browser (ieframe) represents it by a list holding the address, which only it can read back.
+ * This layout must match url_pidl in ieframe/shellbrowser.c. */
+#include <pshpack1.h>
+typedef struct {
+    USHORT cb;
+    BYTE type;
+    BYTE magic[3];
+    WCHAR url[1];
+} url_pidl;
+#include <poppack.h>
+
+static const BYTE url_pidl_magic[3] = {'S','G','U'};
+
 /******************************************************************
  *  IEParseDisplayNameWithBCW (SHDOCVW.218)
+ *
+ * The desktop folder hands every address with a URL scheme to this function, so it must
+ * never give such a string back to SHParseDisplayName: that parsed it by calling here again
+ * until the stack was gone.
  */
 HRESULT WINAPI IEParseDisplayNameWithBCW(DWORD codepage, LPCWSTR lpszDisplayName, LPBC pbc, LPITEMIDLIST *ppidl)
 {
     /* parameter 3 is the bind context of IShellFolder::ParseDisplayName; the string is already wide,
      * so the code page does not matter */
+    PARSEDURLW parsed;
+    url_pidl *pidl;
+    size_t size;
+
     TRACE("0x%lx %s %p %p\n", codepage, debugstr_w(lpszDisplayName), pbc, ppidl);
 
 #ifdef SG_MUTANT_SHDOCVWPARSE
@@ -438,7 +460,38 @@ HRESULT WINAPI IEParseDisplayNameWithBCW(DWORD codepage, LPCWSTR lpszDisplayName
     *ppidl = NULL;
     if (!lpszDisplayName || !*lpszDisplayName) return E_INVALIDARG;
 
+#ifdef SG_MUTANT_SHDOCVWRECURSE
     return SHParseDisplayName(lpszDisplayName, pbc, ppidl, 0, NULL);
+#endif
+    parsed.cbSize = sizeof(parsed);
+    if (FAILED(ParseURLW(lpszDisplayName, &parsed)))
+    {
+        /* not an address: a file system name */
+        return SHParseDisplayName(lpszDisplayName, pbc, ppidl, 0, NULL);
+    }
+
+    if (parsed.nScheme == URL_SCHEME_FILE)
+    {
+        /* items of the file system have real shell item id lists */
+        WCHAR path[MAX_PATH];
+        DWORD len = ARRAY_SIZE(path);
+        HRESULT hr = PathCreateFromUrlW(lpszDisplayName, path, &len, 0);
+
+        if (SUCCEEDED(hr)) return SHParseDisplayName(path, pbc, ppidl, 0, NULL);
+        return hr;
+    }
+
+    size = offsetof(url_pidl, url) + (wcslen(lpszDisplayName) + 1) * sizeof(WCHAR);
+    if (size + sizeof(USHORT) > 0xffff) return E_INVALIDARG;
+    pidl = CoTaskMemAlloc(size + sizeof(USHORT));
+    if (!pidl) return E_OUTOFMEMORY;
+    pidl->cb = size;
+    pidl->type = 0xcf;
+    memcpy(pidl->magic, url_pidl_magic, sizeof(url_pidl_magic));
+    lstrcpyW(pidl->url, lpszDisplayName);
+    *(USHORT *)((BYTE *)pidl + size) = 0;
+    *ppidl = (LPITEMIDLIST)pidl;
+    return S_OK;
 }
 
 /******************************************************************
diff --git a/dlls/shell32/tests/shlfolder.c b/dlls/shell32/tests/shlfolder.c
index 414fa08..35a8994 100644
--- a/dlls/shell32/tests/shlfolder.c
+++ b/dlls/shell32/tests/shlfolder.c
@@ -213,10 +213,10 @@ static struct
     {{'t','e','s','t','\\',0}, 0x80070002},
     {{'s','u','b','\\','d','i','r',0}, 0x80070002},
     {{'s','u','b','/','d','i','r',0}, E_INVALIDARG},
-    {{'h','t','t','p',':',0}, S_OK, 1},
-    {{'h','t','t','p',':','t','e','s','t',0}, S_OK, 1},
-    {{'h','t','t','p',':','\\','t','e','s','t',0}, S_OK, 1},
-    {{'x','x',':',0}, S_OK, 1},
+    {{'h','t','t','p',':',0}, S_OK},
+    {{'h','t','t','p',':','t','e','s','t',0}, S_OK},
+    {{'h','t','t','p',':','\\','t','e','s','t',0}, S_OK},
+    {{'x','x',':',0}, S_OK},
 };
 
 static void test_ParseDisplayName(void)
