From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] nsiproxy: an adapter keeps its GUID; interfaces that are gone leave the table (9253)

An adapter's GUID was its Linux interface index ({index-0000-0000-0000-4E6574446576}), which Linux hands out anew whenever an interface appears: a USB adapter plugged in again, a VPN's tunnel, a bridge made at another moment of start-up came back as a new adapter, and what Windows keys by the adapter GUID -- the Network List Manager's profiles (the network's category), the TCP/IP keys (9250), programs' own settings -- was lost. On Windows the GUID stays with the adapter. It now comes from the interface's name, which Linux keeps stable (predictable names, enx<MAC> for USB adapters, configured tunnel names), hashed into the first ten bytes; the tail stays "NetDev". Existing profiles keyed by the old GUIDs are not carried over (a network's category starts again from Public, Windows' default).

Interfaces that went away stayed in the table until the driver restarted: GetAdaptersAddresses kept listing an unplugged adapter, and one made again appeared twice. The table now drops an interface whose index is gone or belongs to another name; the entry itself is kept aside, as convert_luid_to_unix_name() hands out its name.

Gate: test-tcpipreg (GUIDs not the index; an interface made again under another index keeps its GUID and keys and is listed once; a gone interface's keys go while the driver runs). Mutants SG_MUTANT_GUID_BY_INDEX, SG_MUTANT_KEEP_GONE_INTERFACES.
---
--- a/dlls/nsiproxy.sys/ndis.c
+++ b/dlls/nsiproxy.sys/ndis.c
@@ -275,6 +275,35 @@
     return ret;
 }
 
+/* Stained Glass OS: an adapter keeps its GUID, as on Windows, where programs and the machine's own
+ * settings (the Network List Manager's profiles, the TCP/IP keys) are keyed by it. The GUID was the
+ * interface index, which Linux hands out anew whenever an interface appears: a USB adapter plugged
+ * in again, a VPN's tunnel, a bridge made at a different moment of start-up all came back as a new
+ * adapter. It now comes from the interface's name, which Linux keeps stable (enp4s0, wlp2s0,
+ * enx<MAC>, wg0); the tail stays "NetDev". */
+static void if_name_guid( const char *name, UINT index, GUID *guid )
+{
+    UINT64 h1 = 0xcbf29ce484222325ull, h2 = 0x6c62272e07bb0142ull;
+    const unsigned char *p;
+
+    memset( guid, 0, sizeof(*guid) );
+    memcpy( guid->Data4 + 2, "NetDev", 6 );
+#ifdef SG_MUTANT_GUID_BY_INDEX
+    guid->Data1 = index;
+    return;
+#endif
+    for (p = (const unsigned char *)name; *p; p++)
+    {
+        h1 = (h1 ^ *p) * 0x100000001b3ull;   /* FNV-1a */
+        h2 = (h2 + *p) * 0x5bd1e995ull ^ (h2 >> 29);
+    }
+    guid->Data1 = (UINT)h1;
+    guid->Data2 = (USHORT)(h1 >> 32);
+    guid->Data3 = (USHORT)(h1 >> 48);
+    guid->Data4[0] = (BYTE)h2;
+    guid->Data4[1] = (BYTE)(h2 >> 8);
+}
+
 static struct if_entry *add_entry( UINT index, char *name )
 {
     struct if_entry *entry;
@@ -299,19 +328,38 @@
     entry->if_luid.Info.NetLuidIndex = index;
     entry->if_luid.Info.IfType = entry->if_type;
 
-    memset( &entry->if_guid, 0, sizeof(entry->if_guid) );
-    entry->if_guid.Data1 = index;
-    memcpy( entry->if_guid.Data4 + 2, "NetDev", 6 );
+    if_name_guid( name, index, &entry->if_guid );
 
     list_add_tail( &if_list, &entry->entry );
     return entry;
 }
 
+/* Stained Glass OS: interfaces that are gone. Their entries are kept (convert_luid_to_unix_name()
+ * hands out their names), but not listed. */
+static struct list gone_list = LIST_INIT( gone_list );
+
 static unsigned int update_if_table( void )
 {
     struct if_nameindex *indices = if_nameindex(), *entry;
+    struct if_entry *cur, *next;
     unsigned int append_count = 0;
 
+    if (!indices) return 0;
+#ifndef SG_MUTANT_KEEP_GONE_INTERFACES
+    /* Stained Glass OS: an interface that went away (a USB adapter unplugged, a VPN's tunnel
+     * closed) left the table only when the driver restarted: GetAdaptersAddresses kept listing it,
+     * and made again it was there twice. Gone, or its index now another interface's: removed. */
+    LIST_FOR_EACH_ENTRY_SAFE( cur, next, &if_list, struct if_entry, entry )
+    {
+        for (entry = indices; entry->if_index; entry++)
+            if (entry->if_index == cur->if_index && !strcmp( entry->if_name, cur->if_unix_name )) break;
+        if (entry->if_index) continue;
+        TRACE( "interface %u %s is gone\n", cur->if_index, debugstr_a( cur->if_unix_name ) );
+        list_remove( &cur->entry );
+        list_add_tail( &gone_list, &cur->entry );
+    }
+#endif
+
     for (entry = indices; entry->if_index; entry++)
     {
         if (!find_entry_from_index( entry->if_index ) && add_entry( entry->if_index, entry->if_name ))
