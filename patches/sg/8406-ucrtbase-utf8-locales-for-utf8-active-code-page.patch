From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ucrtbase: UTF-8 locales for a program whose manifest asks for UTF-8

A program whose manifest sets activeCodePage to UTF-8 (Windows 10 1903) runs with GetACP() 65001,
and on Windows its UCRT locales are UTF-8 too: setlocale(LC_ALL, "") is
"English_United States.utf8", code page 65001. Wine's UCRT took the locale's own ANSI code page
(1252) for "" and ".ACP", so such a program's C runtime still spoke 1252. R 4.2 and later rely on
it: Rgui started with "Using locale code page other than 65001 (UTF-8) may cause problems" and
ran in 1252. The UCRT also names a UTF-8 locale ".utf8", as Windows' does (it said ".65001").
An explicit code page in the name still wins; programs without the manifest are unchanged.
---
--- a/dlls/msvcrt/locale.c
+++ b/dlls/msvcrt/locale.c
@@ -418,6 +418,14 @@
                 (WCHAR *)&locale_cp, sizeof(DWORD)/sizeof(WCHAR));
         if (!locale_cp)
             locale_cp = GetACP();
+#if _MSVCR_VER >= 140 && !defined(SG_MUTANT_UCRT_LOCALE_IGNORES_UTF8_ACP)
+        /* Stained Glass OS (wine-sg 8406): a program whose manifest asks for UTF-8 as its
+         * code page (activeCodePage, Windows 10 1903) gets UTF-8 locales from the UCRT too:
+         * setlocale(LC_ALL, "") is "<locale>.utf8", as on Windows. R 4.2+ builds on it and
+         * warned "Using locale code page other than 65001 (UTF-8) may cause problems" */
+        if (GetACP() == CP_UTF8)
+            locale_cp = CP_UTF8;
+#endif
     } else if (!_strnicmp(cp, ".OCP", 4)) {
         GetLocaleInfoEx(sname, LOCALE_IDEFAULTCODEPAGE | LOCALE_RETURN_NUMBER,
                 (WCHAR *)&locale_cp, sizeof(DWORD)/sizeof(WCHAR));
@@ -557,6 +565,11 @@
         len += GetLocaleInfoEx(sname, LOCALE_SENGCOUNTRY
                 |LOCALE_NOUSEROVERRIDE, &wbuf[len], ARRAY_SIZE(wbuf) - len);
         wbuf[len-1] = '.';
+#if _MSVCR_VER >= 140 && !defined(SG_MUTANT_UCRT_LOCALE_IGNORES_UTF8_ACP)
+        /* the UCRT names a UTF-8 locale "<language>_<country>.utf8" (8406) */
+        if (cp == CP_UTF8) wcscpy(wbuf+len, L"utf8");
+        else
+#endif
         swprintf(wbuf+len, ARRAY_SIZE(wbuf) - len,L"%d", cp);
         len += wcslen(wbuf+len);
 
