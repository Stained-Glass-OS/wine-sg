From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a program by its name from the user's App Paths

David 2026-10-04: "windows apps/command line can't seem to open firefox
for linux" -- start firefox in cmd, Start-Process firefox, Win+R firefox
found nothing: a program answers to its name through App Paths, and Linux
Firefox has no Windows program to put there.

ShellExecute now reads the user's App Paths (HKCU) too, as Windows does --
after the machine's, so a program installed for everyone keeps its name
over one the user's account has -- and an entry's SgArguments value goes
before the caller's parameters. sg-shell's sg-linuxapp gives each Linux app
an entry in the user's App Paths: NAME.exe -> sg-linuxapp64.exe,
SgArguments --launch "FILE.desktop"; start firefox URL then starts Linux
Firefox with the URL.

Test: test/userapppaths-gate.sh with test/userapppaths-probe.c (mutant
SG_MUTANT_NO_USER_APPPATHS).
---
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -666,7 +666,12 @@
  * On entry: szName is a filename (probably without path separators).
  * On exit: if szName found in "App Path", place full path in lpResult, and return true
  */
-static BOOL SHELL_TryAppPathW( LPCWSTR szName, LPWSTR lpResult, WCHAR **env)
+/* Stained Glass OS: App Paths of the user's own (HKCU) too, after the
+ * machine's -- a program installed for all wins over one for this user -- and
+ * an entry's SgArguments, put before the caller's parameters: a Linux app's
+ * name runs its launcher with the app (start firefox, Win+R gimp;
+ * sg-linuxapp keeps these entries). app_args (1024 WCHARs) may be NULL. */
+static BOOL SHELL_TryAppPathW( LPCWSTR szName, LPWSTR lpResult, WCHAR **env, WCHAR *app_args)
 {
     HKEY hkApp = 0;
     WCHAR buffer[1024];
@@ -675,6 +680,7 @@
     BOOL found = FALSE;
 
     if (env) *env = NULL;
+    if (app_args) *app_args = 0;
     wcscpy(buffer, L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\");
     if (wcslen(buffer) + wcslen(szName) + 1 > ARRAY_SIZE(buffer))
     {
@@ -686,8 +692,21 @@
     res = RegOpenKeyExW(HKEY_LOCAL_MACHINE, buffer, 0, KEY_READ, &hkApp);
     if (res)
     {
+        size_t at = wcslen(buffer);
         wcscat(buffer, L".exe");
         res = RegOpenKeyExW(HKEY_LOCAL_MACHINE, buffer, 0, KEY_READ, &hkApp);
+#ifndef SG_MUTANT_NO_USER_APPPATHS
+        if (res)
+        {
+            buffer[at] = 0;
+            res = RegOpenKeyExW(HKEY_CURRENT_USER, buffer, 0, KEY_READ, &hkApp);
+            if (res)
+            {
+                wcscat(buffer, L".exe");
+                res = RegOpenKeyExW(HKEY_CURRENT_USER, buffer, 0, KEY_READ, &hkApp);
+            }
+        }
+#endif
     }
     if (res)
         goto end;
@@ -696,6 +715,14 @@
     res = RegQueryValueW(hkApp, NULL, lpResult, &len);
     if (res) goto end;
     found = TRUE;
+    if (app_args)
+    {
+        DWORD count = 1024 * sizeof(WCHAR), type;
+        if (RegQueryValueExW(hkApp, L"SgArguments", NULL, &type, (LPBYTE)app_args, &count) || type != REG_SZ)
+            *app_args = 0;
+        else
+            app_args[1023] = 0;
+    }
 
     if (env)
     {
@@ -812,7 +839,8 @@
  *              on the operation)
  */
 static UINT SHELL_FindExecutable(LPCWSTR lpPath, LPCWSTR lpFile, LPCWSTR lpVerb,
-                                 LPWSTR lpResult, int resultLen, LPWSTR key, WCHAR **env, LPITEMIDLIST pidl, LPCWSTR args)
+                                 LPWSTR lpResult, int resultLen, LPWSTR key, WCHAR **env, LPITEMIDLIST pidl, LPCWSTR args,
+                                 WCHAR *app_args)
 {
     WCHAR *extension = NULL; /* pointer to file extension */
     WCHAR classname[256];     /* registry name for this file type */
@@ -843,7 +871,7 @@
         return ERROR_FILE_NOT_FOUND; /* File not found. Close enough, I guess. */
     }
 
-    if (SHELL_TryAppPathW( lpFile, lpResult, env ))
+    if (SHELL_TryAppPathW( lpFile, lpResult, env, app_args ))
     {
         TRACE("found %s via App Paths\n", debugstr_w(lpResult));
         return 33;
@@ -1385,7 +1413,7 @@
         SetCurrentDirectoryW(lpDirectory);
     }
 
-    retval = SHELL_FindExecutable(lpDirectory, lpFile, L"open", res, MAX_PATH, NULL, NULL, NULL, NULL);
+    retval = SHELL_FindExecutable(lpDirectory, lpFile, L"open", res, MAX_PATH, NULL, NULL, NULL, NULL, NULL);
 
     if (retval > 32)
         lstrcpyW(lpResult, res);
@@ -1904,6 +1932,7 @@
     WCHAR wszKeyname[256];
     LPCWSTR lpFile;
     UINT_PTR retval = SE_ERR_NOASSOC;
+    WCHAR app_args[1024] = L"";
 
     /* make a local copy of the LPSHELLEXECUTEINFO structure and work with this from now on */
     sei_tmp = *sei;
@@ -2138,12 +2167,21 @@
 
     /* try to find the executable */
     wcmd[0] = '\0';
-    retval = SHELL_FindExecutable(sei_tmp.lpDirectory, lpFile, sei_tmp.lpVerb, wcmd, wcmdLen, wszKeyname, &env, sei_tmp.lpIDList, sei_tmp.lpParameters);
+    retval = SHELL_FindExecutable(sei_tmp.lpDirectory, lpFile, sei_tmp.lpVerb, wcmd, wcmdLen, wszKeyname, &env, sei_tmp.lpIDList, sei_tmp.lpParameters, app_args);
     if (retval > 32)  /* Found */
     {
-        retval = SHELL_quote_and_execute( wcmd, wszParameters, wszKeyname,
+        WCHAR *params = wszParameters, *joined = NULL;
+        /* an App Paths entry's own arguments first (Stained Glass OS) */
+        if (app_args[0] && (joined = malloc( (lstrlenW( app_args ) + lstrlenW( wszParameters ) + 2) * sizeof(WCHAR) )))
+        {
+            lstrcpyW( joined, app_args );
+            if (wszParameters[0]) { lstrcatW( joined, L" " ); lstrcatW( joined, wszParameters ); }
+            params = joined;
+        }
+        retval = SHELL_quote_and_execute( wcmd, params, wszKeyname,
                                           wszApplicationName, env, &sei_tmp,
                                           sei, execfunc );
+        free( joined );
         free( env );
     }
     else if (PathIsDirectoryW(lpFile))
@@ -2155,7 +2193,7 @@
         {
             retval = SHELL_FindExecutable( sei_tmp.lpDirectory, L"explorer",
                                            L"open", wExec, MAX_PATH,
-                                           NULL, &env, NULL, NULL );
+                                           NULL, &env, NULL, NULL, NULL );
             if (retval > 32)
             {
                 lstrcpyW(lpQuotedFile, L"\"");
