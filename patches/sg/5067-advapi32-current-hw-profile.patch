From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: Implement GetCurrentHwProfileW from the registry.

GetCurrentHwProfileW reports the current hardware profile (it failed), and
GetCurrentHwProfileA converts its answer. The GUID and name are the
HwProfileGuid and FriendlyName values of the profile's key under
HKLM\System\CurrentControlSet\Control\IDConfigDB\Hardware Profiles\0001;
when they are missing the GUID and name Wine always reported are written
there, so a prefix keeps the GUID it had. A NULL pointer is
ERROR_INVALID_PARAMETER.

Gate: test/advapi32-hwprofile-gate.sh.
---
 dlls/advapi32/advapi.c | 66 ++++++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 59 insertions(+), 7 deletions(-)

diff --git a/dlls/advapi32/advapi.c b/dlls/advapi32/advapi.c
index 9c79830..e25bf58 100644
--- a/dlls/advapi32/advapi.c
+++ b/dlls/advapi32/advapi.c
@@ -116,22 +116,74 @@ BOOL WINAPI GetUserNameW( LPWSTR name, LPDWORD size )
  */
 BOOL WINAPI GetCurrentHwProfileA(LPHW_PROFILE_INFOA pInfo)
 {
-	FIXME("(%p) semi-stub\n", pInfo);
-	pInfo->dwDockInfo = DOCKINFO_DOCKED;
-	strcpy(pInfo->szHwProfileGuid,"{12340001-1234-1234-1234-123456789012}");
-	strcpy(pInfo->szHwProfileName,"Wine Profile");
-	return TRUE;
+    HW_PROFILE_INFOW infoW;
+
+    TRACE("(%p)\n", pInfo);
+
+    if (!pInfo)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!GetCurrentHwProfileW(&infoW)) return FALSE;
+    pInfo->dwDockInfo = infoW.dwDockInfo;
+    WideCharToMultiByte(CP_ACP, 0, infoW.szHwProfileGuid, -1, pInfo->szHwProfileGuid,
+                        sizeof(pInfo->szHwProfileGuid), NULL, NULL);
+    WideCharToMultiByte(CP_ACP, 0, infoW.szHwProfileName, -1, pInfo->szHwProfileName,
+                        sizeof(pInfo->szHwProfileName), NULL, NULL);
+    return TRUE;
 }
 
 /******************************************************************************
  * GetCurrentHwProfileW [ADVAPI32.@]
  *
  * See GetCurrentHwProfileA.
+ *
+ * The profile's GUID and name are the HwProfileGuid and FriendlyName values of the
+ * current hardware profile's key; the ones Wine always reported are written there
+ * the first time, so a prefix keeps answering with the same GUID.
  */
 BOOL WINAPI GetCurrentHwProfileW(LPHW_PROFILE_INFOW pInfo)
 {
-       FIXME("(%p)\n", pInfo);
-       return FALSE;
+    static const WCHAR key_name[] = L"System\\CurrentControlSet\\Control\\IDConfigDB\\Hardware Profiles\\0001";
+    static const WCHAR default_guid[] = L"{12340001-1234-1234-1234-123456789012}";
+    static const WCHAR default_name[] = L"Wine Profile";
+    DWORD size, type;
+    HKEY key;
+
+    TRACE("(%p)\n", pInfo);
+
+    if (!pInfo)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    pInfo->dwDockInfo = DOCKINFO_DOCKED;
+    lstrcpyW(pInfo->szHwProfileGuid, default_guid);
+    lstrcpyW(pInfo->szHwProfileName, default_name);
+    if (RegCreateKeyExW(HKEY_LOCAL_MACHINE, key_name, 0, NULL, 0, KEY_QUERY_VALUE | KEY_SET_VALUE, NULL, &key, NULL)
+        && RegOpenKeyExW(HKEY_LOCAL_MACHINE, key_name, 0, KEY_QUERY_VALUE, &key))
+        return TRUE;
+
+    size = sizeof(pInfo->szHwProfileGuid);
+    if (RegQueryValueExW(key, L"HwProfileGuid", NULL, &type, (BYTE *)pInfo->szHwProfileGuid, &size) || type != REG_SZ)
+    {
+        lstrcpyW(pInfo->szHwProfileGuid, default_guid);
+        RegSetValueExW(key, L"HwProfileGuid", 0, REG_SZ, (const BYTE *)default_guid, sizeof(default_guid));
+    }
+    pInfo->szHwProfileGuid[ARRAY_SIZE(pInfo->szHwProfileGuid) - 1] = 0;
+#ifndef SG_MUTANT_HWPROFILE_FIXED_NAME
+    size = sizeof(pInfo->szHwProfileName);
+    if (RegQueryValueExW(key, L"FriendlyName", NULL, &type, (BYTE *)pInfo->szHwProfileName, &size) || type != REG_SZ)
+#endif
+    {
+        lstrcpyW(pInfo->szHwProfileName, default_name);
+        RegSetValueExW(key, L"FriendlyName", 0, REG_SZ, (const BYTE *)default_name, sizeof(default_name));
+    }
+    pInfo->szHwProfileName[ARRAY_SIZE(pInfo->szHwProfileName) - 1] = 0;
+    RegCloseKey(key);
+    return TRUE;
 }
 
 
