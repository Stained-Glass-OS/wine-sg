Subject: [PATCH] rpcrt4: RpcMgmtInqIfIds (local) and RpcIfIdVectorFree (patch 5116)

The interfaces registered in this application; gap-CORE item 594 (remote part
escalated). Gate with two mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/rpcrt4/rpc_server.c b/dlls/rpcrt4/rpc_server.c
--- a/dlls/rpcrt4/rpc_server.c
+++ b/dlls/rpcrt4/rpc_server.c
@@ -1673,10 +1673,91 @@
 /***********************************************************************
  *             RpcMgmtInqIfIds (RPCRT4.@)
  */
+RPC_STATUS WINAPI RpcIfIdVectorFree(RPC_IF_ID_VECTOR **IfIdVector);
+
 RPC_STATUS WINAPI RpcMgmtInqIfIds(RPC_BINDING_HANDLE Binding, RPC_IF_ID_VECTOR **IfIdVector)
 {
-  FIXME("(%p,%p): stub\n", Binding, IfIdVector);
-  return RPC_S_INVALID_BINDING;
+  RPC_IF_ID_VECTOR *vector;
+  RpcServerInterface *cif;
+  ULONG count = 0, i = 0;
+
+  TRACE("(%p,%p)\n", Binding, IfIdVector);
+
+  if (!IfIdVector) return RPC_S_INVALID_ARG;
+  *IfIdVector = NULL;
+
+  if (Binding)
+  {
+    /* another application's interfaces are asked from its management interface, which is
+     * not offered here; a server binding is no way to reach it */
+    if (((RpcBinding *)Binding)->server) return RPC_S_WRONG_KIND_OF_BINDING;
+    FIXME("remote management interface not supported\n");
+    return RPC_S_CANNOT_SUPPORT;
+  }
+
+  /* this application's: the server has to be listening */
+  EnterCriticalSection(&listen_cs);
+#ifdef SG_MUTANT_IFIDS_LISTEN
+  if (0)
+#else
+  if (!std_listen)  /* RpcServerListen, or an interface registered with RPC_IF_AUTOLISTEN */
+#endif
+  {
+    LeaveCriticalSection(&listen_cs);
+    return RPC_S_NOT_LISTENING;
+  }
+  LeaveCriticalSection(&listen_cs);
+
+  EnterCriticalSection(&server_cs);
+  LIST_FOR_EACH_ENTRY(cif, &server_interfaces, RpcServerInterface, entry) count++;
+  vector = malloc(FIELD_OFFSET(RPC_IF_ID_VECTOR, IfId[count ? count : 1]));
+  if (vector)
+  {
+    vector->Count = 0;
+    LIST_FOR_EACH_ENTRY(cif, &server_interfaces, RpcServerInterface, entry)
+    {
+      RPC_IF_ID *id = malloc(sizeof(*id));
+      if (!id) break;
+      id->Uuid = cif->If->InterfaceId.SyntaxGUID;
+      id->VersMajor = cif->If->InterfaceId.SyntaxVersion.MajorVersion;
+#ifdef SG_MUTANT_IFIDS_VERSION
+      id->VersMinor = 0;
+#else
+      id->VersMinor = cif->If->InterfaceId.SyntaxVersion.MinorVersion;
+#endif
+      vector->IfId[i++] = id;
+      vector->Count = i;
+    }
+  }
+  LeaveCriticalSection(&server_cs);
+
+  if (!vector) return RPC_S_OUT_OF_RESOURCES;
+  if (vector->Count != count)
+  {
+    RpcIfIdVectorFree(&vector);
+    return RPC_S_OUT_OF_RESOURCES;
+  }
+  *IfIdVector = vector;
+  return RPC_S_OK;
+}
+
+/***********************************************************************
+ *             RpcIfIdVectorFree (RPCRT4.@)
+ */
+RPC_STATUS WINAPI RpcIfIdVectorFree(RPC_IF_ID_VECTOR **IfIdVector)
+{
+  ULONG i;
+
+  TRACE("(%p)\n", IfIdVector);
+
+  if (!IfIdVector) return RPC_S_INVALID_ARG;
+  if (*IfIdVector)
+  {
+    for (i = 0; i < (*IfIdVector)->Count; i++) free((*IfIdVector)->IfId[i]);
+    free(*IfIdVector);
+  }
+  *IfIdVector = NULL;
+  return RPC_S_OK;
 }
 
 /***********************************************************************
diff --git a/dlls/rpcrt4/rpcrt4.spec b/dlls/rpcrt4/rpcrt4.spec
--- a/dlls/rpcrt4/rpcrt4.spec
+++ b/dlls/rpcrt4/rpcrt4.spec
@@ -389,7 +389,7 @@
 @ stdcall RpcExceptionFilter(long)
 @ stub RpcFreeAuthorizationContext
 @ stdcall RpcGetAsyncCallStatus(ptr) RpcAsyncGetCallStatus
-@ stub RpcIfIdVectorFree
+@ stdcall RpcIfIdVectorFree(ptr)
 @ stdcall RpcIfInqId(ptr ptr)
 @ stdcall RpcImpersonateClient(ptr)
 @ stdcall RpcInitializeAsyncHandle(ptr long) RpcAsyncInitializeHandle
