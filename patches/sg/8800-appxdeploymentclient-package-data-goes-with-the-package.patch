From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxdeploymentclient: a package's user data goes with the package

RemovePackageAsync took the package's files, aliases, shortcuts and record, but the data its
programs kept for the user stayed: %LOCALAPPDATA%\Packages\<family> (LocalState, LocalCache,
TempState, ...) and the settings containers in HKCU\Software\Wine\ApplicationData\<family>.
Windows removes them with the package. An MSIX uninstall from the Store left LanguageTool's
LocalCache behind (store walk 2026-11-11).

They now go when the removal succeeds and no version of the family is left for the caller (an
update replaces a version through remove_record, not here, and keeps them), unless the caller
asks to keep them: RemovePackageWithOptionsAsync with RemovalOptions_PreserveApplicationData,
which was ignored.

---
--- a/dlls/appxdeploymentclient/deploy.c
+++ b/dlls/appxdeploymentclient/deploy.c
@@ -3241,16 +3241,78 @@
 
 /* ---- RemovePackageAsync ------------------------------------------------------------ */
 
+/* Stained Glass OS 8800: the data a package's programs kept for the user goes with the package, as on
+ * Windows: %LOCALAPPDATA%\Packages\<family> (LocalState, RoamingState, TempState, LocalCache, ...)
+ * and the settings containers (Software\Wine\ApplicationData\<family>). It stays while any version of
+ * the family is still there for the caller (an update, another version staged or registered), and
+ * when the caller asks to keep it (RemovalOptions_PreserveApplicationData). */
+struct family_left
+{
+    const WCHAR *family_name;
+    BOOL found;
+};
+
+static BOOL find_family_left( struct package_record *rec, void *context )
+{
+    struct family_left *f = context;
+
+    if (rec->family_name && !wcsicmp( rec->family_name, f->family_name ) && !rec->resource_package)
+    {
+        f->found = TRUE;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void remove_app_data( const WCHAR *family_name )
+{
+    struct family_left left = { family_name };
+    WCHAR dir[MAX_PATH], key[MAX_PATH];
+
+    if (!family_name || !family_name[0] || wcspbrk( family_name, L"\\/:*?\"<>|" ) ||
+        !wcscmp( family_name, L"." ) || !wcscmp( family_name, L".." ))
+        return;
+    for_each_record( find_family_left, &left );
+    if (left.found) return;
+    if (SUCCEEDED(SHGetFolderPathW( NULL, CSIDL_LOCAL_APPDATA, NULL, SHGFP_TYPE_CURRENT, dir )) &&
+        wcslen( dir ) + wcslen( family_name ) + 11 < ARRAY_SIZE(dir))
+    {
+        wcscat( dir, L"\\Packages\\" );
+        wcscat( dir, family_name );
+        TRACE( "removing the data of %s: %s\n", debugstr_w( family_name ), debugstr_w( dir ) );
+        delete_tree( dir );
+    }
+    if (wcslen( family_name ) + 32 < ARRAY_SIZE(key))
+    {
+        swprintf( key, ARRAY_SIZE(key), L"Software\\Wine\\ApplicationData\\%s", family_name );
+        RegDeleteTreeW( HKEY_CURRENT_USER, key );
+    }
+}
+
 HRESULT remove_package_work( const WCHAR *full_name, DeploymentOptions options, WCHAR **error_text )
 {
-    TRACE( "package %s\n", debugstr_w( full_name ) );
+    struct package_record rec;
+    WCHAR *family = NULL;
+    HRESULT hr;
+
+    TRACE( "package %s, options %#x\n", debugstr_w( full_name ), options );
 
     if (!full_name || !full_name[0] || wcschr( full_name, '\\' ))
     {
         set_error( error_text, L"Not a package full name", full_name );
         return E_INVALIDARG;
     }
-    return remove_record( full_name, error_text );
+    if (open_record( full_name, &rec, NULL ))
+    {
+        if (!rec.framework && !rec.resource_package && rec.family_name) family = wcsdup( rec.family_name );
+        package_record_free( &rec );
+    }
+    hr = remove_record( full_name, error_text );
+#ifndef SG_MUTANT_AX_REMOVE_KEEPS_DATA
+    if (SUCCEEDED(hr) && family && !(options & RemovalOptions_PreserveApplicationData)) remove_app_data( family );
+#endif
+    free( family );
+    return hr;
 }
 
 /* ---- RegisterPackageByFamilyNameAndOptionalPackagesAsync --------------------------- */
--- a/dlls/appxdeploymentclient/package.c
+++ b/dlls/appxdeploymentclient/package.c
@@ -491,10 +491,11 @@
 {
     TRACE( "iface %p, name %s, options %d, operation %p.\n", iface, debugstr_hstring(name), options, operation );
 
-    /* application data is not kept apart from the package, so there is nothing to preserve */
+    /* Stained Glass OS 8800: the user's data of the package goes with it unless kept */
     if (!operation) return E_POINTER;
     if (!name) return E_INVALIDARG;
-    return start_one( remove_package_work, WindowsGetStringRawBuffer( name, NULL ), 0, operation );
+    return start_one( remove_package_work, WindowsGetStringRawBuffer( name, NULL ),
+                      options & RemovalOptions_PreserveApplicationData, operation );
 }
 
 static HRESULT WINAPI package_manager2_StagePackageWithOptionsAsync( IPackageManager2 *iface, IUriRuntimeClass *uri, IIterable_Uri *dependencies,
