+    "  <method name=\"OpenUri\"><arg direction=\"in\" type=\"s\"/></method>\n"
+    "  <signal name=\"Seeked\"><arg type=\"x\"/></signal>\n"
+    "  <property name=\"PlaybackStatus\" type=\"s\" access=\"read\"/><property name=\"LoopStatus\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"Rate\" type=\"d\" access=\"read\"/><property name=\"Shuffle\" type=\"b\" access=\"read\"/>\n"
+    "  <property name=\"Metadata\" type=\"a{sv}\" access=\"read\"/><property name=\"Volume\" type=\"d\" access=\"read\"/>\n"
+    "  <property name=\"Position\" type=\"x\" access=\"read\"/><property name=\"MinimumRate\" type=\"d\" access=\"read\"/>\n"
+    "  <property name=\"MaximumRate\" type=\"d\" access=\"read\"/><property name=\"CanGoNext\" type=\"b\" access=\"read\"/>\n"
+    "  <property name=\"CanGoPrevious\" type=\"b\" access=\"read\"/><property name=\"CanPlay\" type=\"b\" access=\"read\"/>\n"
+    "  <property name=\"CanPause\" type=\"b\" access=\"read\"/><property name=\"CanSeek\" type=\"b\" access=\"read\"/>\n"
+    "  <property name=\"CanControl\" type=\"b\" access=\"read\"/>\n"
+    " </interface>\n"
+    "</node>\n";
+
+static void queue_button( struct session *s, UINT32 button )
+{
+    if (event_count < ARRAY_SIZE(events))
+    {
+        events[event_count].session = s->id;
+        events[event_count++].button = button;
+    }
+}
+
+/* a method call to the session's player */
+static void handle_call( struct session *s, DBusMessage *msg )
+{
+    const char *iface = p_dbus_message_get_interface( msg ), *member = p_dbus_message_get_member( msg );
+    const char *path = p_dbus_message_get_path( msg );
+    DBusMessage *reply = NULL;
+    DBusMessageIter iter;
+    DBusError err;
+
+    if (!member) return;
+    if (!path || strcmp( path, MPRIS_PATH ))
+    {
+        reply = p_dbus_message_new_error( msg, DBUS_ERROR_UNKNOWN_OBJECT, "no such object" );
+        goto done;
+    }
+    TRACE( "%s: %s.%s\n", s->name, iface ? iface : "", member );
+
+    if (iface && !strcmp( iface, "org.freedesktop.DBus.Introspectable" ) && !strcmp( member, "Introspect" ))
+    {
+        const char *data = introspection;
+        reply = p_dbus_message_new_method_return( msg );
+        p_dbus_message_iter_init_append( reply, &iter );
+        p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &data );
+    }
+    else if (iface && !strcmp( iface, PROPS_IFACE ))
+    {
+        const char *which = NULL, *name = NULL;
+
+        p_dbus_error_init( &err );
+        if (!strcmp( member, "Get" ) &&
+            p_dbus_message_get_args( msg, &err, DBUS_TYPE_STRING, &which, DBUS_TYPE_STRING, &name, DBUS_TYPE_INVALID ))
+        {
+            reply = p_dbus_message_new_method_return( msg );
+            p_dbus_message_iter_init_append( reply, &iter );
+            if (!append_property( &iter, s, which, name ))
+            {
+                p_dbus_message_unref( reply );
+                reply = p_dbus_message_new_error( msg, DBUS_ERROR_UNKNOWN_PROPERTY, "no such property" );
+            }
+        }
+        else if (!strcmp( member, "GetAll" ) &&
+                 p_dbus_message_get_args( msg, &err, DBUS_TYPE_STRING, &which, DBUS_TYPE_INVALID ))
+        {
+            reply = p_dbus_message_new_method_return( msg );
+            p_dbus_message_iter_init_append( reply, &iter );
+            if (!strcmp( which, ROOT_IFACE )) append_all( &iter, s, ROOT_IFACE, root_props );
+            else if (!strcmp( which, PLAYER_IFACE )) append_all( &iter, s, PLAYER_IFACE, player_props );
+            else
+            {
+                static const char *const none[] = { NULL };
+                append_all( &iter, s, which, none );
+            }
+        }
+        else if (!strcmp( member, "Set" ))
+            reply = p_dbus_message_new_error( msg, DBUS_ERROR_PROPERTY_READ_ONLY, "read only" );
+        else
+            reply = p_dbus_message_new_error( msg, DBUS_ERROR_INVALID_ARGS, "invalid arguments" );
+        p_dbus_error_free( &err );
+    }
+    else if (iface && !strcmp( iface, ROOT_IFACE ) && (!strcmp( member, "Raise" ) || !strcmp( member, "Quit" )))
+        reply = p_dbus_message_new_method_return( msg );
+    else if (!iface || !strcmp( iface, PLAYER_IFACE ))
+    {
+        /* the buttons; PlayPause by the status, as Windows' flyout does */
+        /* a button the program has not enabled does nothing (as the specification says) */
+        if (!strcmp( member, "Play" )) { if (s->state.can_play) queue_button( s, BUTTON_PLAY ); }
+        else if (!strcmp( member, "Pause" )) { if (s->state.can_pause) queue_button( s, BUTTON_PAUSE ); }
+        else if (!strcmp( member, "PlayPause" ))
+        {
+            if (s->state.status == MPRIS_PLAYING) { if (s->state.can_pause) queue_button( s, BUTTON_PAUSE ); }
+            else if (s->state.can_play) queue_button( s, BUTTON_PLAY );
+        }
+        else if (!strcmp( member, "Stop" )) { if (s->state.can_stop) queue_button( s, BUTTON_STOP ); }
+        else if (!strcmp( member, "Next" )) { if (s->state.can_next) queue_button( s, BUTTON_NEXT ); }
+        else if (!strcmp( member, "Previous" )) { if (s->state.can_previous) queue_button( s, BUTTON_PREVIOUS ); }
+        else if (strcmp( member, "Seek" ) && strcmp( member, "SetPosition" ) && strcmp( member, "OpenUri" ))
+        {
+            reply = p_dbus_message_new_error( msg, DBUS_ERROR_UNKNOWN_METHOD, "no such method" );
+            goto done;
+        }
+        reply = p_dbus_message_new_method_return( msg );
+    }
+    else reply = p_dbus_message_new_error( msg, DBUS_ERROR_UNKNOWN_INTERFACE, "no such interface" );
+
+done:
+    if (reply)
+    {
+        p_dbus_connection_send( s->conn, reply, NULL );
+        p_dbus_message_unref( reply );
+        p_dbus_connection_flush( s->conn );
+    }
+}
+
+static void dispatch_session( struct session *s )
+{
+    DBusMessage *msg;
+
+    p_dbus_connection_read_write( s->conn, 0 );
+    while ((msg = p_dbus_connection_pop_message( s->conn )))
+    {
+        if (p_dbus_message_get_type( msg ) == DBUS_MESSAGE_TYPE_METHOD_CALL) handle_call( s, msg );
+        p_dbus_message_unref( msg );
+    }
+}
+
+static void close_session( struct session *s )
+{
+    if (s->conn)
+    {
+        p_dbus_connection_close( s->conn );
+        p_dbus_connection_unref( s->conn );
+        s->conn = NULL;
+    }
+    if (s->art_path[0]) unlink( s->art_path );
+    s->art_path[0] = 0;
+}
+
+/* onto the bus, under its own name */
+static BOOL open_session( struct session *s )
+{
+    const char *address = getenv( "DBUS_SESSION_BUS_ADDRESS" ), *runtime = getenv( "XDG_RUNTIME_DIR" );
+    char path[1024];
+    struct stat st;
+    DBusError err;
+    int ret;
+
+    /* the user's own session bus, never one started for us (libdbus would autolaunch one) */
+    if (!address || !*address)
+    {
+        if (!runtime || !*runtime || snprintf( path, sizeof(path), "%s/bus", runtime ) >= (int)sizeof(path) ||
+            stat( path, &st ) || !S_ISSOCK( st.st_mode ))
+            return FALSE;
+    }
+    p_dbus_error_init( &err );
+    if (!(s->conn = p_dbus_bus_get_private( DBUS_BUS_SESSION, &err )))
+    {
+        TRACE( "no session bus: %s\n", err.message ? err.message : "" );
+        p_dbus_error_free( &err );
+        return FALSE;
+    }
+    p_dbus_connection_set_exit_on_disconnect( s->conn, FALSE );
+    /* the process's own id, as MPRIS players name their instances: unique on the bus */
+    snprintf( s->name, sizeof(s->name), "org.mpris.MediaPlayer2.%s.instance%d_%u", s->state.bus_suffix, (int)getpid(),
+              s->state.serial );
+    ret = p_dbus_bus_request_name( s->conn, s->name, DBUS_NAME_FLAG_DO_NOT_QUEUE, &err );
+    if (ret != DBUS_REQUEST_NAME_REPLY_PRIMARY_OWNER)
+    {
+        WARN( "could not own %s: %s\n", s->name, err.message ? err.message : "" );
+        p_dbus_error_free( &err );
+        close_session( s );
+        return FALSE;
+    }
+    TRACE( "%s on the session bus\n", s->name );
+    return TRUE;
+}
+
+static NTSTATUS mpris_init( void *args )
+{
+    return load_dbus() ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS mpris_update( void *args )
+{
+    struct mpris_update_params *params = args;
+    struct session *s, **prev;
+    BOOL changed_track;
+
+    params->result = 0;
+    if (!load_dbus()) return STATUS_NOT_SUPPORTED;
+    pthread_mutex_lock( &mpris_mutex );
+    s = find_session( params->session );
+    if (!params->enabled)
+    {
+        if (s)
+        {
+            for (prev = &sessions; *prev != s; prev = &(*prev)->next);
+            *prev = s->next;
+            close_session( s );
+            free( s );
+        }
+        pthread_mutex_unlock( &mpris_mutex );
+        return STATUS_SUCCESS;
+    }
+    if (!s)
+    {
+        if (!(s = calloc( 1, sizeof(*s) )))
+        {
+            pthread_mutex_unlock( &mpris_mutex );
+            return STATUS_NO_MEMORY;
+        }
+        s->id = params->session;
+        s->state = *params;
+        if (!open_session( s ))
+        {
+            free( s );
+            pthread_mutex_unlock( &mpris_mutex );
+            return STATUS_SUCCESS;
+        }
+        s->next = sessions;
+        sessions = s;
+    }
+    changed_track = strcmp( s->state.title, params->title ) || strcmp( s->state.artist, params->artist ) ||
+                    strcmp( s->state.album, params->album );
+    s->state = *params;
+    if (changed_track) s->track++;
+#ifndef SG_MUTANT_MPRIS_NO_SIGNAL
+    emit_changed( s );
+#endif
+    params->result = 1;
+    pthread_mutex_unlock( &mpris_mutex );
+    return STATUS_SUCCESS;
+}
+
+/* the user's cache: $XDG_CACHE_HOME or ~/.cache, stained-glass/mpris */
+static BOOL art_directory( char *dir, size_t size )
+{
+    const char *base = getenv( "XDG_CACHE_HOME" ), *home = getenv( "HOME" );
+    char cache[1024], parent[1024];
+
+    if (base && *base) snprintf( cache, sizeof(cache), "%s", base );
+    else if (home && *home) snprintf( cache, sizeof(cache), "%s/.cache", home );
+    else return FALSE;
+    if (snprintf( parent, sizeof(parent), "%s/stained-glass", cache ) >= (int)sizeof(parent)) return FALSE;
+    if (snprintf( dir, size, "%s/mpris", parent ) >= (int)size) return FALSE;
+    mkdir( cache, 0700 );   /* (the base directory specification's mode) */
+    mkdir( parent, 0700 );
+    return !mkdir( dir, 0700 ) || errno == EEXIST;
+}
+
+static NTSTATUS mpris_set_art( void *args )
+{
+    const struct mpris_art_params *params = args;
+    char dir[1024], ext[8];
+    struct session *s;
+    unsigned int i;
+    FILE *file;
+
+    if (!load_dbus()) return STATUS_NOT_SUPPORTED;
+    for (i = 0; i < sizeof(ext) - 1 && params->extension[i]; i++)
+        ext[i] = (params->extension[i] >= 'a' && params->extension[i] <= 'z') ? params->extension[i] : 'x';
+    ext[i] = 0;
+    pthread_mutex_lock( &mpris_mutex );
+    if ((s = find_session( params->session )))
+    {
+        if (s->art_path[0]) unlink( s->art_path );
+        s->art_path[0] = 0;
+        if (params->size && art_directory( dir, sizeof(dir) ))
+        {
+            if (snprintf( s->art_path, sizeof(s->art_path), "%s/%s.%s", dir, s->name + strlen( "org.mpris.MediaPlayer2." ),
+                          ext[0] ? ext : "img" ) >= (int)sizeof(s->art_path))
+                s->art_path[0] = 0;
+            else if ((file = fopen( s->art_path, "wb" )))
+            {
+                fwrite( (const void *)(ULONG_PTR)params->data, 1, params->size, file );
+                fclose( file );
+            }
+            else s->art_path[0] = 0;
+        }
+        emit_changed( s );
+    }
+    pthread_mutex_unlock( &mpris_mutex );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS mpris_wait( void *args )
+{
+    struct mpris_wait_params *params = args;
+    struct timespec start, now, pause = { 0, 20 * 1000 * 1000 };
+    struct session *s;
+
+    if (!load_dbus()) return STATUS_NOT_SUPPORTED;
+    clock_gettime( CLOCK_MONOTONIC, &start );
+    for (;;)
+    {
+        pthread_mutex_lock( &mpris_mutex );
+        for (s = sessions; s; s = s->next) if (s->conn) dispatch_session( s );
+        if (event_count)
+        {
+            params->session = events[0].session;
+            params->button = events[0].button;
+            memmove( events, events + 1, --event_count * sizeof(*events) );
+            pthread_mutex_unlock( &mpris_mutex );
+            return STATUS_SUCCESS;
+        }
+        pthread_mutex_unlock( &mpris_mutex );
+        clock_gettime( CLOCK_MONOTONIC, &now );
+        if ((now.tv_sec - start.tv_sec) * 1000 + (now.tv_nsec - start.tv_nsec) / 1000000 >= params->timeout_ms)
+            return STATUS_TIMEOUT;
+        nanosleep( &pause, NULL );
+    }
+}
+
+static NTSTATUS mpris_remove( void *args )
+{
+    const struct mpris_remove_params *params = args;
+    struct mpris_update_params update = { .session = params->session, .enabled = 0 };
+    return mpris_update( &update );
+}
+
+#else  /* SONAME_LIBDBUS_1 */
+
+static NTSTATUS mpris_init( void *args ) { return STATUS_NOT_SUPPORTED; }
+static NTSTATUS mpris_update( void *args ) { return STATUS_NOT_SUPPORTED; }
+static NTSTATUS mpris_set_art( void *args ) { return STATUS_NOT_SUPPORTED; }
+static NTSTATUS mpris_wait( void *args ) { return STATUS_NOT_SUPPORTED; }
+static NTSTATUS mpris_remove( void *args ) { return STATUS_NOT_SUPPORTED; }
+
+#endif
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    mpris_init,
+    mpris_update,
+    mpris_set_art,
+    mpris_wait,
+    mpris_remove,
+};
+
+C_ASSERT( ARRAY_SIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+/* the parameters hold no pointers: 32-bit callers use the same entry points */
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    mpris_init,
+    mpris_update,
+    mpris_set_art,
+    mpris_wait,
+    mpris_remove,
+};
+
+C_ASSERT( ARRAY_SIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif
diff --git a/dlls/windows.media.mediacontrol/unixlib.h b/dlls/windows.media.mediacontrol/unixlib.h
new file mode 100644
index 0000000..e1741a2
--- /dev/null
+++ b/dlls/windows.media.mediacontrol/unixlib.h
@@ -0,0 +1,85 @@
