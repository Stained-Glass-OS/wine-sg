+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_WINDOWS_MEDIA_MEDIACONTROL_UNIXLIB_H
+#define __WINE_WINDOWS_MEDIA_MEDIACONTROL_UNIXLIB_H
+
+#include "wine/unixlib.h"
+
+/* no pointers but UINT64 addresses: the same for 32- and 64-bit callers */
+
+enum mpris_status
+{
+    MPRIS_STOPPED,
+    MPRIS_PLAYING,
+    MPRIS_PAUSED,
+};
+
+/* the state of one transport controls session; enabled = FALSE takes it off the bus */
+struct mpris_update_params
+{
+    UINT64 session;
+    INT64 length_us, position_us;   /* -1: unknown */
+    double rate;
+    UINT32 enabled;
+    UINT32 status;                  /* enum mpris_status */
+    UINT32 can_play, can_pause, can_stop, can_next, can_previous;
+    UINT32 shuffle, loop;           /* loop: 0 None, 1 Track, 2 Playlist */
+    INT32 track_number;
+    UINT32 result;                  /* out: 1 when the session is on the bus */
+    UINT32 serial;                  /* the session's number in its process */
+    char identity[64];              /* the program's name */
+    char bus_suffix[64];            /* org.mpris.MediaPlayer2.<bus_suffix>.instance<unix pid>_<serial> */
+    char title[256], artist[256], album[256], album_artist[256];
+};
+
+/* the cover: written to the user's cache, its file:// URL in the metadata */
+struct mpris_art_params
+{
+    UINT64 session;
+    UINT64 data;                    /* address of the bytes */
+    UINT32 size;
+    char extension[8];
+};
+
+/* the next button an MPRIS client pressed, waited for up to timeout_ms */
+struct mpris_wait_params
+{
+    UINT64 session;                 /* out */
+    UINT32 timeout_ms;
+    UINT32 button;                  /* out: SystemMediaTransportControlsButton */
+};
+
+struct mpris_remove_params
+{
+    UINT64 session;
+};
+
+enum mediacontrol_funcs
+{
+    unix_mpris_init,
+    unix_mpris_update,
+    unix_mpris_set_art,
+    unix_mpris_wait,
+    unix_mpris_remove,
+    unix_funcs_count
+};
+
+#endif
diff --git a/dlls/windows.storage/stream.c b/dlls/windows.storage/stream.c
index dcfcae9..1410753 100644
--- a/dlls/windows.storage/stream.c
+++ b/dlls/windows.storage/stream.c
@@ -752,6 +752,72 @@ static HRESULT WINAPI reference_GetTrustLevel( IRandomAccessStreamReference *ifa
 /* A read-only stream at the start over a copy of the bytes the referenced stream holds, with the
  * content type of the stream (empty when it has none: GUESS).  A stream of another implementation
  * is returned as it is when it can already tell its content type. */
+/* Stained Glass OS (wine-sg 6523): another implementation's stream (a COM stream's wrapper, a
+ * managed one) without a content type of its own: a read snapshot of its bytes, read through its
+ * IInputStream, as for ours. A read not done in five seconds fails. */
+static HRESULT foreign_open_read( IRandomAccessStream *src, IRandomAccessStream **out )
+{
+    IAsyncOperationWithProgress_IBuffer_UINT32 *read = NULL;
+    struct stream_data *copy;
+    IRandomAccessStream *stream;
+    IBuffer *buffer = NULL, *result = NULL;
+    IInputStream *input = NULL;
+    AsyncStatus status = Started;
+    IAsyncInfo *info;
+    UINT32 length = 0;
+    UINT64 size = 0;
+    BYTE *bytes;
+    HRESULT hr;
+    int i;
+
+    if (FAILED(hr = IRandomAccessStream_get_Size( src, &size ))) return hr;
+    if (size > 0x7fffffff) return E_OUTOFMEMORY;
+    if (FAILED(hr = memory_stream_create( NULL, 0, &stream ))) return hr;
+    copy = impl_from_IRandomAccessStream( stream )->data;
+    if (size)
+    {
+        if (SUCCEEDED(hr = IRandomAccessStream_GetInputStreamAt( src, 0, &input )) &&
+            SUCCEEDED(hr = buffer_create( size, &buffer )) &&
+            SUCCEEDED(hr = IInputStream_ReadAsync( input, buffer, size, InputStreamOptions_None, &read )) &&
+            SUCCEEDED(hr = IAsyncOperationWithProgress_IBuffer_UINT32_QueryInterface( read, &IID_IAsyncInfo, (void **)&info )))
+        {
+            for (i = 0; i < 500; i++)
+            {
+                IAsyncInfo_get_Status( info, &status );
+                if (status != Started) break;
+                Sleep( 10 );
+            }
+            if (status == Error) IAsyncInfo_get_ErrorCode( info, &hr );
+            else if (status != Completed) hr = E_FAIL;
+            IAsyncInfo_Release( info );
+            if (SUCCEEDED(hr) && SUCCEEDED(hr = IAsyncOperationWithProgress_IBuffer_UINT32_GetResults( read, &result )) &&
+                SUCCEEDED(hr = buffer_get_bytes( result, &bytes, &length, NULL )) && length)
+            {
+                if (!(copy->bytes = malloc( length ))) hr = E_OUTOFMEMORY;
+                else memcpy( copy->bytes, bytes, length );
+            }
+        }
+        if (result) IBuffer_Release( result );
+        if (read) IAsyncOperationWithProgress_IBuffer_UINT32_Release( read );
+        if (buffer) IBuffer_Release( buffer );
+        if (input) IInputStream_Release( input );
+    }
+    if (SUCCEEDED(hr))
+    {
+        copy->size = copy->capacity = copy->bytes ? length : 0;
+        if (!(copy->content_type = wcsdup( L"" ))) hr = E_OUTOFMEMORY;
+    }
+    if (FAILED(hr))
+    {
+        WARN( "stream %p: %#lx\n", src, hr );
+        IRandomAccessStream_Release( stream );
+        return hr;
+    }
+    copy->read_only = TRUE;
+    *out = stream;
+    return S_OK;
+}
+
 static HRESULT reference_open_read( IRandomAccessStream *src, IRandomAccessStream **out )
 {
     struct memory_stream *mem;
@@ -764,7 +830,11 @@ static HRESULT reference_open_read( IRandomAccessStream *src, IRandomAccessStrea
     {
         if (SUCCEEDED(hr = IRandomAccessStream_QueryInterface( src, &IID_IRandomAccessStreamWithContentType, (void **)out )))
             return hr;
+#ifdef SG_MUTANT_REF_NO_FOREIGN
         return E_NOINTERFACE;
+#else
+        return foreign_open_read( src, out );
+#endif
     }
     mem = impl_from_IRandomAccessStream( src );
     if (mem->closed) return RO_E_CLOSED;
