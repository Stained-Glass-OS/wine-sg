+
+#define DO_FUNC(f) static typeof(f) * p_##f
+DBUS_FUNCS;
+#undef DO_FUNC
+
+static BOOL load_dbus(void)
+{
+    static int loaded = -1;
+    void *handle;
+
+    if (loaded != -1) return loaded;
+    loaded = 0;
+    if (!(handle = dlopen( SONAME_LIBDBUS_1, RTLD_NOW ))) return FALSE;
+#define DO_FUNC(f) if (!(p_##f = dlsym( handle, #f ))) return FALSE
+    DBUS_FUNCS;
+#undef DO_FUNC
+    p_dbus_threads_init_default();
+    loaded = 1;
+    return TRUE;
+}
+
+#define MPRIS_PATH   "/org/mpris/MediaPlayer2"
+#define ROOT_IFACE   "org.mpris.MediaPlayer2"
+#define PLAYER_IFACE "org.mpris.MediaPlayer2.Player"
+#define PROPS_IFACE  "org.freedesktop.DBus.Properties"
+
+/* SystemMediaTransportControlsButton */
+enum { BUTTON_PLAY = 0, BUTTON_PAUSE = 1, BUTTON_STOP = 2, BUTTON_NEXT = 6, BUTTON_PREVIOUS = 7 };
+
+struct session
+{
+    struct session *next;
+    UINT64 id;
+    DBusConnection *conn;
+    char name[160];
+    char art_path[1024];
+    UINT32 track;
+    struct mpris_update_params state;
+};
+
+struct button_event
+{
+    UINT64 session;
+    UINT32 button;
+};
+
+static pthread_mutex_t mpris_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct session *sessions;
+static struct button_event events[32];
+static unsigned int event_count;
+
+static struct session *find_session( UINT64 id )
+{
+    struct session *s;
+    for (s = sessions; s; s = s->next) if (s->id == id) return s;
+    return NULL;
+}
+
+static void append_variant( DBusMessageIter *iter, int type, const void *value )
+{
+    char sig[2] = { (char)type, 0 };
+    DBusMessageIter variant;
+
+    p_dbus_message_iter_open_container( iter, DBUS_TYPE_VARIANT, sig, &variant );
+    p_dbus_message_iter_append_basic( &variant, type, value );
+    p_dbus_message_iter_close_container( iter, &variant );
+}
+
+static void append_string_array_variant( DBusMessageIter *iter, const char *value )
+{
+    DBusMessageIter variant, array;
+
+    p_dbus_message_iter_open_container( iter, DBUS_TYPE_VARIANT, "as", &variant );
+    p_dbus_message_iter_open_container( &variant, DBUS_TYPE_ARRAY, "s", &array );
+    if (value && *value) p_dbus_message_iter_append_basic( &array, DBUS_TYPE_STRING, &value );
+    p_dbus_message_iter_close_container( &variant, &array );
+    p_dbus_message_iter_close_container( iter, &variant );
+}
+
+/* one dict entry {sv} */
+static void dict_entry( DBusMessageIter *dict, const char *key, int type, const void *value )
+{
+    DBusMessageIter entry;
+
+    p_dbus_message_iter_open_container( dict, DBUS_TYPE_DICT_ENTRY, NULL, &entry );
+    p_dbus_message_iter_append_basic( &entry, DBUS_TYPE_STRING, &key );
+    append_variant( &entry, type, value );
+    p_dbus_message_iter_close_container( dict, &entry );
+}
+
+static void dict_entry_strings( DBusMessageIter *dict, const char *key, const char *value )
+{
+    DBusMessageIter entry;
+
+    p_dbus_message_iter_open_container( dict, DBUS_TYPE_DICT_ENTRY, NULL, &entry );
+    p_dbus_message_iter_append_basic( &entry, DBUS_TYPE_STRING, &key );
+    append_string_array_variant( &entry, value );
+    p_dbus_message_iter_close_container( dict, &entry );
+}
+
+/* the Metadata dictionary, as a variant */
+static void append_metadata( DBusMessageIter *iter, struct session *s )
+{
+    DBusMessageIter variant, dict;
+    char track_path[96], art_url[1100];
+    const char *p;
+
+    snprintf( track_path, sizeof(track_path), "/org/stainedglass/mpris/track%u", s->track );
+    p_dbus_message_iter_open_container( iter, DBUS_TYPE_VARIANT, "a{sv}", &variant );
+    p_dbus_message_iter_open_container( &variant, DBUS_TYPE_ARRAY, "{sv}", &dict );
+    p = track_path;
+    dict_entry( &dict, "mpris:trackid", DBUS_TYPE_OBJECT_PATH, &p );
+    if (s->state.title[0]) { p = s->state.title; dict_entry( &dict, "xesam:title", DBUS_TYPE_STRING, &p ); }
+    if (s->state.artist[0]) dict_entry_strings( &dict, "xesam:artist", s->state.artist );
+    if (s->state.album[0]) { p = s->state.album; dict_entry( &dict, "xesam:album", DBUS_TYPE_STRING, &p ); }
+    if (s->state.album_artist[0]) dict_entry_strings( &dict, "xesam:albumArtist", s->state.album_artist );
+    if (s->state.track_number > 0) dict_entry( &dict, "xesam:trackNumber", DBUS_TYPE_INT32, &s->state.track_number );
+    if (s->state.length_us > 0) dict_entry( &dict, "mpris:length", DBUS_TYPE_INT64, &s->state.length_us );
+    if (s->art_path[0])
+    {
+        /* file:// with the characters a URL cannot hold escaped */
+        char *out = art_url;
+        const unsigned char *c;
+
+        out += sprintf( out, "file://" );
+        for (c = (const unsigned char *)s->art_path; *c && out < art_url + sizeof(art_url) - 4; c++)
+        {
+            if ((*c >= 'a' && *c <= 'z') || (*c >= 'A' && *c <= 'Z') || (*c >= '0' && *c <= '9') ||
+                strchr( "/-_.~", *c ))
+                *out++ = *c;
+            else out += sprintf( out, "%%%02X", *c );
+        }
+        *out = 0;
+        p = art_url;
+        dict_entry( &dict, "mpris:artUrl", DBUS_TYPE_STRING, &p );
+    }
+    p_dbus_message_iter_close_container( &variant, &dict );
+    p_dbus_message_iter_close_container( iter, &variant );
+}
+
+static const char *status_string( UINT32 status )
+{
+    switch (status)
+    {
+    case MPRIS_PLAYING: return "Playing";
+    case MPRIS_PAUSED: return "Paused";
+    }
+    return "Stopped";
+}
+
+static const char *loop_string( UINT32 loop )
+{
+    return loop == 1 ? "Track" : loop == 2 ? "Playlist" : "None";
+}
+
+/* one property of an interface, as a variant; FALSE when there is no such property */
+static BOOL append_property( DBusMessageIter *iter, struct session *s, const char *iface, const char *name )
+{
+    dbus_bool_t yes = TRUE, no = FALSE, flag;
+    const char *str;
+    double d;
+
+    if (!strcmp( iface, ROOT_IFACE ))
+    {
+        if (!strcmp( name, "CanQuit" ) || !strcmp( name, "CanRaise" ) || !strcmp( name, "HasTrackList" ) ||
+            !strcmp( name, "CanSetFullscreen" ) || !strcmp( name, "Fullscreen" ))
+            append_variant( iter, DBUS_TYPE_BOOLEAN, &no );
+        else if (!strcmp( name, "Identity" ))
+        {
+            str = s->state.identity[0] ? s->state.identity : "Program";
+            append_variant( iter, DBUS_TYPE_STRING, &str );
+        }
+        else if (!strcmp( name, "SupportedUriSchemes" ) || !strcmp( name, "SupportedMimeTypes" ))
+            append_string_array_variant( iter, NULL );
+        else return FALSE;
+        return TRUE;
+    }
+    if (strcmp( iface, PLAYER_IFACE )) return FALSE;
+    if (!strcmp( name, "PlaybackStatus" )) { str = status_string( s->state.status ); append_variant( iter, DBUS_TYPE_STRING, &str ); }
+    else if (!strcmp( name, "LoopStatus" )) { str = loop_string( s->state.loop ); append_variant( iter, DBUS_TYPE_STRING, &str ); }
+    else if (!strcmp( name, "Shuffle" )) { flag = !!s->state.shuffle; append_variant( iter, DBUS_TYPE_BOOLEAN, &flag ); }
+    else if (!strcmp( name, "Rate" )) { d = s->state.rate > 0 ? s->state.rate : 1.0; append_variant( iter, DBUS_TYPE_DOUBLE, &d ); }
+    else if (!strcmp( name, "MinimumRate" ) || !strcmp( name, "MaximumRate" ) || !strcmp( name, "Volume" ))
+    { d = 1.0; append_variant( iter, DBUS_TYPE_DOUBLE, &d ); }
+    else if (!strcmp( name, "Position" ))
+    { INT64 pos = s->state.position_us > 0 ? s->state.position_us : 0; append_variant( iter, DBUS_TYPE_INT64, &pos ); }
+    else if (!strcmp( name, "Metadata" )) append_metadata( iter, s );
+    else if (!strcmp( name, "CanPlay" )) { flag = !!s->state.can_play; append_variant( iter, DBUS_TYPE_BOOLEAN, &flag ); }
+    else if (!strcmp( name, "CanPause" )) { flag = !!s->state.can_pause; append_variant( iter, DBUS_TYPE_BOOLEAN, &flag ); }
+    else if (!strcmp( name, "CanGoNext" )) { flag = !!s->state.can_next; append_variant( iter, DBUS_TYPE_BOOLEAN, &flag ); }
+    else if (!strcmp( name, "CanGoPrevious" )) { flag = !!s->state.can_previous; append_variant( iter, DBUS_TYPE_BOOLEAN, &flag ); }
+    else if (!strcmp( name, "CanSeek" )) append_variant( iter, DBUS_TYPE_BOOLEAN, &no );
+    else if (!strcmp( name, "CanControl" )) append_variant( iter, DBUS_TYPE_BOOLEAN, &yes );
+    else return FALSE;
+    return TRUE;
+}
+
+static const char *const root_props[] = { "CanQuit", "CanRaise", "HasTrackList", "Identity", "SupportedUriSchemes",
+                                          "SupportedMimeTypes", NULL };
+static const char *const player_props[] = { "PlaybackStatus", "LoopStatus", "Shuffle", "Rate", "MinimumRate",
+                                            "MaximumRate", "Volume", "Position", "Metadata", "CanPlay", "CanPause",
+                                            "CanGoNext", "CanGoPrevious", "CanSeek", "CanControl", NULL };
+
+static void append_all( DBusMessageIter *iter, struct session *s, const char *iface, const char *const *names )
+{
+    DBusMessageIter dict, entry;
+
+    p_dbus_message_iter_open_container( iter, DBUS_TYPE_ARRAY, "{sv}", &dict );
+    for (; *names; names++)
+    {
+        p_dbus_message_iter_open_container( &dict, DBUS_TYPE_DICT_ENTRY, NULL, &entry );
+        p_dbus_message_iter_append_basic( &entry, DBUS_TYPE_STRING, names );
+        append_property( &entry, s, iface, *names );
+        p_dbus_message_iter_close_container( &dict, &entry );
+    }
+    p_dbus_message_iter_close_container( iter, &dict );
+}
+
+/* PropertiesChanged for the player's properties */
+static void emit_changed( struct session *s )
+{
+    static const char *const changed[] = { "PlaybackStatus", "LoopStatus", "Shuffle", "Rate", "Metadata", "CanPlay",
+                                           "CanPause", "CanGoNext", "CanGoPrevious", NULL };
+    DBusMessageIter iter, array;
+    const char *iface = PLAYER_IFACE;
+    DBusMessage *msg;
+
+    if (!(msg = p_dbus_message_new_signal( MPRIS_PATH, PROPS_IFACE, "PropertiesChanged" ))) return;
+    p_dbus_message_iter_init_append( msg, &iter );
+    p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &iface );
+    append_all( &iter, s, PLAYER_IFACE, changed );
+    p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "s", &array );
+    p_dbus_message_iter_close_container( &iter, &array );
+    p_dbus_connection_send( s->conn, msg, NULL );
+    p_dbus_message_unref( msg );
+    p_dbus_connection_flush( s->conn );
+}
+
+static const char introspection[] =
+    "<!DOCTYPE node PUBLIC \"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN\" "
+    "\"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd\">\n"
