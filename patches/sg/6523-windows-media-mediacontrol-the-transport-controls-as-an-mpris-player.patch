 };
 
 static inline struct media_control *impl_from_ISystemMediaTransportControls( ISystemMediaTransportControls *iface )
@@ -1288,6 +1304,490 @@ static inline struct media_control *impl_from_ISystemMediaTransportControls( ISy
     return CONTAINING_RECORD( iface, struct media_control, ISystemMediaTransportControls_iface );
 }
 
+/*
+ * Stained Glass OS (wine-sg 6523): the transport controls on the desktop. Every enabled session
+ * is an MPRIS player on the user's session bus (unixlib.c): its display updater's values, status
+ * and enabled buttons go there at each change and Update(); an MPRIS client's Play, Pause, Stop,
+ * Next and Previous come back as ButtonPressed, from a thread of ours. No libdbus or no session
+ * bus: nothing happens.
+ */
+static struct list mpris_controls = LIST_INIT( mpris_controls );
+static CRITICAL_SECTION mpris_cs;
+static CRITICAL_SECTION_DEBUG mpris_cs_debug =
+{
+    0, 0, &mpris_cs,
+    { &mpris_cs_debug.ProcessLocksList, &mpris_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": mpris_cs") }
+};
+static CRITICAL_SECTION mpris_cs = { &mpris_cs_debug, -1, 0, 0, 0, 0 };
+static BOOL mpris_available, mpris_thread_started;
+static LONG mpris_serial;
+
+static BOOL CALLBACK mpris_init_once( INIT_ONCE *once, void *param, void **context )
+{
+    mpris_available = !__wine_init_unix_call() && !WINE_UNIX_CALL( unix_mpris_init, NULL );
+    TRACE( "MPRIS %s\n", mpris_available ? "available" : "not available" );
+    return TRUE;
+}
+
+static BOOL mpris_init( void )
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, mpris_init_once, NULL, NULL );
+    return mpris_available;
+}
+
+static void hstring_to_utf8( HSTRING str, char *out, int size )
+{
+    UINT32 len;
+    const WCHAR *raw = WindowsGetStringRawBuffer( str, &len );
+
+    out[0] = 0;
+    if (!len) return;
+    len = WideCharToMultiByte( CP_UTF8, 0, raw, len, out, size - 1, NULL, NULL );
+    out[len] = 0;
+}
+
+/* the button-pressed arguments */
+struct button_args
+{
+    ISystemMediaTransportControlsButtonPressedEventArgs ISystemMediaTransportControlsButtonPressedEventArgs_iface;
+    LONG ref;
+    SystemMediaTransportControlsButton button;
+};
+
+static inline struct button_args *impl_from_ISystemMediaTransportControlsButtonPressedEventArgs( ISystemMediaTransportControlsButtonPressedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct button_args, ISystemMediaTransportControlsButtonPressedEventArgs_iface );
+}
+
+static HRESULT WINAPI button_args_QueryInterface( ISystemMediaTransportControlsButtonPressedEventArgs *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ISystemMediaTransportControlsButtonPressedEventArgs ))
+    {
+        *out = iface;
+        IInspectable_AddRef( (IInspectable *)iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI button_args_AddRef( ISystemMediaTransportControlsButtonPressedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_ISystemMediaTransportControlsButtonPressedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI button_args_Release( ISystemMediaTransportControlsButtonPressedEventArgs *iface )
+{
+    struct button_args *impl = impl_from_ISystemMediaTransportControlsButtonPressedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI button_args_GetIids( ISystemMediaTransportControlsButtonPressedEventArgs *iface, ULONG *iid_count, IID **iids )
+{
+    return SG_GET_IIDS( iid_count, iids, &IID_ISystemMediaTransportControlsButtonPressedEventArgs );
+}
+
+static HRESULT WINAPI button_args_GetRuntimeClassName( ISystemMediaTransportControlsButtonPressedEventArgs *iface, HSTRING *class_name )
+{
+    return sg_class_name( L"Windows.Media.SystemMediaTransportControlsButtonPressedEventArgs", class_name );
+}
+
+static HRESULT WINAPI button_args_GetTrustLevel( ISystemMediaTransportControlsButtonPressedEventArgs *iface, TrustLevel *trust_level )
+{
+    return sg_get_trust_level( trust_level );
+}
+
+static HRESULT WINAPI button_args_get_Button( ISystemMediaTransportControlsButtonPressedEventArgs *iface, SystemMediaTransportControlsButton *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ISystemMediaTransportControlsButtonPressedEventArgs( iface )->button;
+    return S_OK;
+}
+
+static const struct ISystemMediaTransportControlsButtonPressedEventArgsVtbl button_args_vtbl =
+{
+    button_args_QueryInterface,
+    button_args_AddRef,
+    button_args_Release,
+    button_args_GetIids,
+    button_args_GetRuntimeClassName,
+    button_args_GetTrustLevel,
+    button_args_get_Button,
+};
+
+/* ButtonPressed to every handler, outside the lock */
+static void raise_button_pressed( struct media_control *impl, SystemMediaTransportControlsButton button )
+{
+    struct button_args *args;
+    struct handler *entry;
+    IUnknown **handlers;
+    UINT count = 0, i;
+
+    if (!(args = calloc( 1, sizeof(*args) ))) return;
+    args->ISystemMediaTransportControlsButtonPressedEventArgs_iface.lpVtbl = &button_args_vtbl;
+    args->ref = 1;
+    args->button = button;
+
+    AcquireSRWLockShared( &event_lock );
+    LIST_FOR_EACH_ENTRY( entry, &impl->button_handlers, struct handler, entry ) count++;
+    if ((handlers = calloc( max( count, 1 ), sizeof(*handlers) )))
+    {
+        count = 0;
+        LIST_FOR_EACH_ENTRY( entry, &impl->button_handlers, struct handler, entry )
+        {
+            handlers[count] = entry->handler;
+            IUnknown_AddRef( handlers[count] );
+            count++;
+        }
+    }
+    else count = 0;
+    ReleaseSRWLockShared( &event_lock );
+
+    TRACE( "control %p, button %d, %u handlers\n", impl, button, count );
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_SystemMediaTransportControls_SystemMediaTransportControlsButtonPressedEventArgs_Invoke(
+            (ITypedEventHandler_SystemMediaTransportControls_SystemMediaTransportControlsButtonPressedEventArgs *)handlers[i],
+            &impl->ISystemMediaTransportControls_iface, &args->ISystemMediaTransportControlsButtonPressedEventArgs_iface );
+        IUnknown_Release( handlers[i] );
+    }
+    free( handlers );
+    ISystemMediaTransportControlsButtonPressedEventArgs_Release( &args->ISystemMediaTransportControlsButtonPressedEventArgs_iface );
+}
+
+/* an asynchronous operation's end, waited for */
+static HRESULT wait_async( IUnknown *operation )
+{
+    AsyncStatus status = Started;
+    IAsyncInfo *info;
+    HRESULT hr = E_FAIL;
+    int i;
+
+    if (FAILED(IUnknown_QueryInterface( operation, &IID_IAsyncInfo, (void **)&info ))) return E_NOINTERFACE;
+    for (i = 0; i < 500; i++)
+    {
+        IAsyncInfo_get_Status( info, &status );
+        if (status != Started) break;
+        Sleep( 10 );
+    }
+    if (status == Completed) hr = S_OK;
+    else if (status == Error) IAsyncInfo_get_ErrorCode( info, &hr );
+    IAsyncInfo_Release( info );
+    return hr;
+}
+
+/* IBufferByteAccess (robuffer.h) */
+static const GUID iid_buffer_byte_access = {0x905a0fef, 0xbc53, 0x11df, {0x8c, 0x49, 0x00, 0x1e, 0x4f, 0xc6, 0x86, 0xda}};
+typedef struct byte_access { const struct byte_access_vtbl *lpVtbl; } byte_access;
+struct byte_access_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( byte_access *, REFIID, void ** );
+    ULONG (WINAPI *AddRef)( byte_access * );
+    ULONG (WINAPI *Release)( byte_access * );
+    HRESULT (WINAPI *Buffer)( byte_access *, BYTE ** );
+};
+
+/* the bytes behind a stream reference (the thumbnail), and its content type */
+static BYTE *read_reference( IRandomAccessStreamReference *reference, UINT32 *size, char *extension )
+{
+    IAsyncOperation_IRandomAccessStreamWithContentType *open = NULL;
+    IAsyncOperationWithProgress_IBuffer_UINT32 *read = NULL;
+    IRandomAccessStreamWithContentType *stream = NULL;
+    IActivationFactory *factory;
+    IBufferFactory *buffers;
+    IRandomAccessStream *ras;
+    IContentTypeProvider *type;
+    IInputStream *input;
+    IBuffer *buffer = NULL, *result = NULL;
+    byte_access *access;
+    BYTE *bytes = NULL, *data;
+    UINT64 length = 0;
+    UINT32 got = 0;
+    HSTRING name;
+    HRESULT hr;
+
+    *size = 0;
+    strcpy( extension, "img" );
+    if (FAILED(hr = IRandomAccessStreamReference_OpenReadAsync( reference, &open )))
+    {
+        WARN( "OpenReadAsync failed, hr %#lx\n", hr );
+        return NULL;
+    }
+    if (FAILED(hr = wait_async( (IUnknown *)open )) || FAILED(hr = IAsyncOperation_IRandomAccessStreamWithContentType_GetResults( open, &stream )))
+    {
+        WARN( "opening the stream failed, hr %#lx\n", hr );
+        goto done;
+    }
+    if (SUCCEEDED(IRandomAccessStreamWithContentType_QueryInterface( stream, &IID_IContentTypeProvider, (void **)&type )))
+    {
+        HSTRING content = NULL;
+        if (SUCCEEDED(IContentTypeProvider_get_ContentType( type, &content )))
+        {
+            const WCHAR *raw = WindowsGetStringRawBuffer( content, NULL );
+            if (!wcsicmp( raw, L"image/png" )) strcpy( extension, "png" );
+            else if (!wcsicmp( raw, L"image/jpeg" ) || !wcsicmp( raw, L"image/jpg" )) strcpy( extension, "jpg" );
+            else if (!wcsicmp( raw, L"image/bmp" )) strcpy( extension, "bmp" );
+            WindowsDeleteString( content );
+        }
+        IContentTypeProvider_Release( type );
+    }
+    if (SUCCEEDED(IRandomAccessStreamWithContentType_QueryInterface( stream, &IID_IRandomAccessStream, (void **)&ras )))
+    {
+        IRandomAccessStream_get_Size( ras, &length );
+        IRandomAccessStream_Release( ras );
+    }
+    if (!length || length > 16 * 1024 * 1024) goto done;
+    if (FAILED(WindowsCreateString( RuntimeClass_Windows_Storage_Streams_Buffer, wcslen( RuntimeClass_Windows_Storage_Streams_Buffer ), &name )))
+        goto done;
+    if (SUCCEEDED(RoGetActivationFactory( name, &IID_IActivationFactory, (void **)&factory )))
+    {
+        if (SUCCEEDED(IActivationFactory_QueryInterface( factory, &IID_IBufferFactory, (void **)&buffers )))
+        {
+            IBufferFactory_Create( buffers, (UINT32)length, &buffer );
+            IBufferFactory_Release( buffers );
+        }
+        IActivationFactory_Release( factory );
+    }
+    WindowsDeleteString( name );
+    if (!buffer) goto done;
+    if (SUCCEEDED(IRandomAccessStreamWithContentType_QueryInterface( stream, &IID_IInputStream, (void **)&input )))
+    {
+        if (SUCCEEDED(IInputStream_ReadAsync( input, buffer, (UINT32)length, InputStreamOptions_None, &read )) &&
+            SUCCEEDED(wait_async( (IUnknown *)read )) &&
+            SUCCEEDED(IAsyncOperationWithProgress_IBuffer_UINT32_GetResults( read, &result )))
+        {
+            IBuffer_get_Length( result, &got );
+            if (got && SUCCEEDED(IBuffer_QueryInterface( result, &iid_buffer_byte_access, (void **)&access )))
+            {
+                if (SUCCEEDED(access->lpVtbl->Buffer( access, &data )) && (bytes = malloc( got )))
+                {
+                    memcpy( bytes, data, got );
+                    *size = got;
+                    /* no content type: the bytes say what they are */
+                    if (!strcmp( extension, "img" ) && got >= 4)
+                    {
+                        if (!memcmp( bytes, "\x89PNG", 4 )) strcpy( extension, "png" );
+                        else if (bytes[0] == 0xff && bytes[1] == 0xd8) strcpy( extension, "jpg" );
+                        else if (bytes[0] == 'B' && bytes[1] == 'M') strcpy( extension, "bmp" );
+                        else if (!memcmp( bytes, "GIF8", 4 )) strcpy( extension, "gif" );
+                    }
+                }
+                access->lpVtbl->Release( access );
+            }
+            IBuffer_Release( result );
+        }
+        if (read) IAsyncOperationWithProgress_IBuffer_UINT32_Release( read );
+        IInputStream_Release( input );
+    }
+    IBuffer_Release( buffer );
+
+done:
+    if (stream) IRandomAccessStreamWithContentType_Release( stream );
+    if (open) IAsyncOperation_IRandomAccessStreamWithContentType_Release( open );
+    return bytes;
+}
+
+/* the cover of a control, read and handed over (on our thread: reading waits) */
+static void send_art( struct media_control *impl )
+{
+    struct mpris_art_params params = { .session = (UINT64)(ULONG_PTR)impl };
+    IRandomAccessStreamReference *thumbnail = NULL;
+    BYTE *bytes = NULL;
+    UINT32 size = 0;
+
+    EnterCriticalSection( &mpris_cs );
+    if (impl->updater && (thumbnail = impl->updater->thumbnail)) IRandomAccessStreamReference_AddRef( thumbnail );
+    LeaveCriticalSection( &mpris_cs );
+    if (thumbnail)
+    {
+        bytes = read_reference( thumbnail, &size, params.extension );
+        IRandomAccessStreamReference_Release( thumbnail );
+    }
+    TRACE( "control %p: cover of %u bytes (%s)\n", impl, size, params.extension );
+    params.data = (UINT64)(ULONG_PTR)bytes;
+    params.size = size;
+    WINE_UNIX_CALL( unix_mpris_set_art, &params );
+    free( bytes );
+}
+
+/* a reference to a control not already being released (with mpris_cs held: its Release waits) */
+static BOOL media_control_try_addref( struct media_control *impl )
+{
+    LONG ref = impl->ref, prev;
+
+    while (ref)
+    {
+        if ((prev = InterlockedCompareExchange( &impl->ref, ref + 1, ref )) == ref)
+        {
+            IWeakReference_AddRef( &impl->IWeakReference_iface );   /* (as AddRef: Release drops both) */
+            return TRUE;
+        }
+        ref = prev;
+    }
+    return FALSE;
+}
+
+static DWORD WINAPI mpris_thread( void *arg )
+{
+    struct mpris_wait_params params;
+    struct media_control *impl, *found;
+
+    SetThreadDescription( GetCurrentThread(), L"sg_smtc_mpris" );
+    for (;;)
+    {
+        /* covers asked for since the last time */
+        do
+        {
+            found = NULL;
+            EnterCriticalSection( &mpris_cs );
+            LIST_FOR_EACH_ENTRY( impl, &mpris_controls, struct media_control, mpris_entry )
+                if (impl->art_pending)
+                {
+                    impl->art_pending = FALSE;
+                    if (!media_control_try_addref( impl )) continue;
+                    found = impl;
+                    break;
+                }
+            LeaveCriticalSection( &mpris_cs );
+            if (found)
+            {
+                send_art( found );
+                ISystemMediaTransportControls_Release( &found->ISystemMediaTransportControls_iface );
+            }
+        } while (found);
+
+        params.timeout_ms = 250;
+        if (WINE_UNIX_CALL( unix_mpris_wait, &params )) continue;
+
+        found = NULL;
+        EnterCriticalSection( &mpris_cs );
+        LIST_FOR_EACH_ENTRY( impl, &mpris_controls, struct media_control, mpris_entry )
+            if ((UINT64)(ULONG_PTR)impl == params.session)
+            {
+                if (media_control_try_addref( impl )) found = impl;
+                break;
+            }
+        LeaveCriticalSection( &mpris_cs );
+        if (found)
+        {
+#ifndef SG_MUTANT_MPRIS_NO_BUTTON
+            raise_button_pressed( found, params.button );
+#endif
+            ISystemMediaTransportControls_Release( &found->ISystemMediaTransportControls_iface );
+        }
+    }
+    return 0;
+}
+
+/* the program's name: the executable's, without its extension */
+static void program_name( char *name, int size )
+{
+    WCHAR path[MAX_PATH], *base, *dot;
+
+    GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) );
+    base = wcsrchr( path, '\\' );
+    base = base ? base + 1 : path;
+    if ((dot = wcsrchr( base, '.' ))) *dot = 0;
+    name[0] = 0;
+    WideCharToMultiByte( CP_UTF8, 0, base, -1, name, size, NULL, NULL );
+}
+
+static void media_control_publish( struct media_control *impl, BOOL art )
+{
+    struct mpris_update_params *params;
+    struct display_updater *updater;
+    char name[64], *p;
+    unsigned int i;
+
+    if (!mpris_init()) return;
+    if (!(params = calloc( 1, sizeof(*params) ))) return;
+    params->session = (UINT64)(ULONG_PTR)impl;
+    params->enabled = impl->is_enabled && impl->media_playback_status != MediaPlaybackStatus_Closed;
+    params->status = impl->media_playback_status == MediaPlaybackStatus_Playing ? MPRIS_PLAYING :
+                     impl->media_playback_status == MediaPlaybackStatus_Paused ? MPRIS_PAUSED : MPRIS_STOPPED;
+    params->can_play = impl->is_play_enabled;
+    params->can_pause = impl->is_pause_enabled;
+    params->can_stop = impl->is_stop_enabled;
+    params->can_next = impl->is_next_enabled;
+    params->can_previous = impl->is_previous_enabled;
+    params->shuffle = impl->shuffle_enabled;
+    params->loop = impl->auto_repeat_mode == MediaPlaybackAutoRepeatMode_Track ? 1 :
+                   impl->auto_repeat_mode == MediaPlaybackAutoRepeatMode_List ? 2 : 0;
+    params->rate = impl->playback_rate;
+    params->length_us = impl->length_us;
+    params->position_us = impl->position_us;
+
+    program_name( params->identity, sizeof(params->identity) );
+    /* a bus name element: letters, digits and _, not starting with a digit */
+    for (i = 0, p = name; params->identity[i] && p < name + 40; i++)
+    {
+        char c = params->identity[i];
+        *p++ = ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) ? c : '_';
+    }
+    *p = 0;
+    if (!name[0] || (name[0] >= '0' && name[0] <= '9')) memmove( name + 3, name, strlen( name ) + 1 ), memcpy( name, "app", 3 );
+    if (!impl->serial) impl->serial = InterlockedIncrement( &mpris_serial );
+    strcpy( params->bus_suffix, name );
+    params->serial = impl->serial;
+
+    if ((updater = impl->updater))
+    {
+        if (updater->playback_type == MediaPlaybackType_Music)
+        {
+            hstring_to_utf8( updater->music->title, params->title, sizeof(params->title) );
+            hstring_to_utf8( updater->music->artist, params->artist, sizeof(params->artist) );
+            hstring_to_utf8( updater->music->album_title, params->album, sizeof(params->album) );
+            hstring_to_utf8( updater->music->album_artist, params->album_artist, sizeof(params->album_artist) );
+            params->track_number = updater->music->track_number;
+        }
+        else
+        {
+            struct display_properties *props = updater->playback_type == MediaPlaybackType_Image ? updater->image : updater->video;
+            hstring_to_utf8( props->title, params->title, sizeof(params->title) );
+            hstring_to_utf8( props->subtitle, params->artist, sizeof(params->artist) );
+        }
+    }
+
+    EnterCriticalSection( &mpris_cs );
+    WINE_UNIX_CALL( unix_mpris_update, params );
+    list_remove( &impl->mpris_entry );
+    list_init( &impl->mpris_entry );
+    if (params->result)
+    {
+        list_add_tail( &mpris_controls, &impl->mpris_entry );
+        if (art && impl->updater) impl->art_pending = TRUE;
+        if (!mpris_thread_started)
+        {
+            HANDLE thread = CreateThread( NULL, 0, mpris_thread, NULL, 0, NULL );
+            if (thread)
+            {
+                CloseHandle( thread );
+                mpris_thread_started = TRUE;
+            }
+        }
+    }
+    LeaveCriticalSection( &mpris_cs );
+    TRACE( "control %p: %s %u, %s\n", impl, params->bus_suffix, params->serial, params->result ? "published" : "not published" );
+    free( params );
+}
+
+static void media_control_unpublish( struct media_control *impl )
+{
