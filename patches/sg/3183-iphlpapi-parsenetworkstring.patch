From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 10:12:08 -0700
Subject: [PATCH] iphlpapi: ParseNetworkString networks, no-scope forms and
 named addresses; GetPerTcpConnectionEStats

ParseNetworkString no longer answers ERROR_NOT_SUPPORTED for the other string
types of its documentation: IPv4/IPv6 networks (address/prefix, prefix range
checked), IPv6 addresses and services without a scope, and named addresses and
services (a DNS name, optionally :port, Format NET_ADDRESS_DNS_NAME). Anything
else is ERROR_INVALID_PARAMETER.
GetPerTcpConnectionEStats validates its arguments and the caller, then says
ERROR_NOT_SUPPORTED like SetPerTcpConnectionEStats (no extended statistics are kept).

Gate: test/fastiphlp-gate.sh (mutant SG_MUTANT_IPH_PARSE); iphlpapi tests 64/32 pass.
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/iphlpapi/iphlpapi_main.c b/dlls/iphlpapi/iphlpapi_main.c
index 65df3cf..32e9d74 100644
--- a/dlls/iphlpapi/iphlpapi_main.c
+++ b/dlls/iphlpapi/iphlpapi_main.c
@@ -62,6 +62,7 @@ DWORD net_enable_router(HANDLE *, OVERLAPPED *);
 DWORD net_unenable_router(OVERLAPPED *, DWORD *);
 DWORD net_set_tcp_entry(const MIB_TCPROW *);
 DWORD net_set_per_tcp_estats(const MIB_TCPROW *, TCP_ESTATS_TYPE, BYTE *, ULONG, ULONG, ULONG);
+DWORD net_get_per_tcp_estats(const MIB_TCPROW *, TCP_ESTATS_TYPE);
 DWORD net_create_proxy_arp(DWORD, DWORD, DWORD);
 DWORD net_delete_proxy_arp(DWORD, DWORD, DWORD);
 
@@ -4405,9 +4406,7 @@ ULONG WINAPI GetPerTcpConnectionEStats(MIB_TCPROW *row, TCP_ESTATS_TYPE stats, U
                                        ULONG ro_static_size, UCHAR *ro_dynamic, ULONG ro_dynamic_version,
                                        ULONG ro_dynamic_size)
 {
-    FIXME( "(%p, %d, %p, %ld, %ld, %p, %ld, %ld, %p, %ld, %ld): stub\n", row, stats, rw, rw_version, rw_size,
-           ro_static, ro_static_version, ro_static_size, ro_dynamic, ro_dynamic_version, ro_dynamic_size );
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    return net_get_per_tcp_estats( row, stats );
 }
 
 /******************************************************************
@@ -5197,14 +5196,118 @@ DWORD WINAPI ParseNetworkString(const WCHAR *str, DWORD type,
         }
     }
 
-    if (info) info->Format = NET_ADDRESS_FORMAT_UNSPECIFIED;
+    if (type & (NET_STRING_IPV4_NETWORK | NET_STRING_IPV6_NETWORK))
+    {
+        const WCHAR *slash = wcsrchr(str, '/');
+        WCHAR *end, copy[64];
+        ULONG bits;
 
-    if (type & ~(NET_STRING_IPV4_ADDRESS|NET_STRING_IPV4_SERVICE|NET_STRING_IPV6_ADDRESS|NET_STRING_IPV6_SERVICE))
+        if (slash && slash > str && wcslen(slash + 1) <= 3 && slash[1] >= '0' && slash[1] <= '9')
+        {
+            bits = wcstoul(slash + 1, &end, 10);
+            if (!*end && (size_t)(slash - str) < ARRAY_SIZE(copy))
+            {
+                memcpy(copy, str, (slash - str) * sizeof(WCHAR));
+                copy[slash - str] = 0;
+                #ifdef SG_MUTANT_IPH_PARSE
+                if ((type & NET_STRING_IPV4_NETWORK) && bits <= 99 &&
+#else
+                if ((type & NET_STRING_IPV4_NETWORK) && bits <= 32 &&
+#endif
+                    SUCCEEDED(RtlIpv4StringToAddressExW(copy, TRUE, &temp_addr4, &temp_port)) && !temp_port)
+                {
+                    if (info)
+                    {
+                        info->Format = NET_ADDRESS_IPV4;
+                        info->Ipv4Address.sin_addr = temp_addr4;
+                        info->Ipv4Address.sin_port = 0;
+                    }
+                    if (port) *port = 0;
+                    if (prefix_len) *prefix_len = bits;
+                    return ERROR_SUCCESS;
+                }
+                if ((type & NET_STRING_IPV6_NETWORK) && bits <= 128 &&
+                    SUCCEEDED(RtlIpv6StringToAddressExW(copy, &temp_addr6, &temp_scope, &temp_port)) && !temp_port)
+                {
+                    if (info)
+                    {
+                        info->Format = NET_ADDRESS_IPV6;
+                        info->Ipv6Address.sin6_addr = temp_addr6;
+                        info->Ipv6Address.sin6_scope_id = temp_scope;
+                        info->Ipv6Address.sin6_port = 0;
+                    }
+                    if (port) *port = 0;
+                    if (prefix_len) *prefix_len = bits;
+                    return ERROR_SUCCESS;
+                }
+            }
+        }
+    }
+    if (type & (NET_STRING_IPV6_ADDRESS_NO_SCOPE | NET_STRING_IPV6_SERVICE_NO_SCOPE))
     {
-        FIXME("Unimplemented type 0x%lx\n", type);
-        return ERROR_NOT_SUPPORTED;
+        status = RtlIpv6StringToAddressExW(str, &temp_addr6, &temp_scope, &temp_port);
+        if (SUCCEEDED(status) && !temp_scope &&
+            (temp_port ? !!(type & NET_STRING_IPV6_SERVICE_NO_SCOPE) : !!(type & NET_STRING_IPV6_ADDRESS_NO_SCOPE)))
+        {
+            if (info)
+            {
+                info->Format = NET_ADDRESS_IPV6;
+                info->Ipv6Address.sin6_addr = temp_addr6;
+                info->Ipv6Address.sin6_scope_id = 0;
+                info->Ipv6Address.sin6_port = temp_port;
+            }
+            if (port) *port = ntohs(temp_port);
+            if (prefix_len) *prefix_len = 255;
+            return ERROR_SUCCESS;
+        }
     }
+    if (type & (NET_STRING_NAMED_ADDRESS | NET_STRING_NAMED_SERVICE))
+    {
+        /* a DNS name, with a port for a service: labels of letters, digits, - and _ (63 at most), 255 in all */
+        size_t len = wcslen(str), host = len, label = 0, i;
+        const WCHAR *colon = wcsrchr(str, ':');
+        BOOL ok = len > 0;
+        ULONG nport = 0;
 
+        if (colon)
+        {
+            WCHAR *end;
+            if (!(type & NET_STRING_NAMED_SERVICE) || !colon[1] || wcslen(colon + 1) > 5) ok = FALSE;
+            else
+            {
+                nport = wcstoul(colon + 1, &end, 10);
+                if (*end || nport > 65535) ok = FALSE;
+            }
+            host = colon - str;
+        }
+        else if (!(type & NET_STRING_NAMED_ADDRESS)) ok = FALSE;
+        if (ok && (!host || host > 255)) ok = FALSE;
+        for (i = 0; ok && i < host; i++)
+        {
+            WCHAR c = str[i];
+            if (c == '.') { if (!label) ok = FALSE; label = 0; continue; }
+            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c > 127))
+                ok = FALSE;
+            if (++label > 63) ok = FALSE;
+        }
+        if (ok && str[host - 1] == '.' && host == 1) ok = FALSE;
+        if (ok)
+        {
+            if (info)
+            {
+                info->Format = NET_ADDRESS_DNS_NAME;
+                memcpy(info->NamedAddress.Address, str, host * sizeof(WCHAR));
+                info->NamedAddress.Address[host] = 0;
+                if (colon) swprintf(info->NamedAddress.Port, ARRAY_SIZE(info->NamedAddress.Port), L"%lu", nport);
+                else info->NamedAddress.Port[0] = 0;
+            }
+            if (port) *port = nport;
+            if (prefix_len) *prefix_len = 255;
+            return ERROR_SUCCESS;
+        }
+    }
+
+    if (info) info->Format = NET_ADDRESS_FORMAT_UNSPECIFIED;
     return ERROR_INVALID_PARAMETER;
 }
 
diff --git a/dlls/iphlpapi/netwrite.c b/dlls/iphlpapi/netwrite.c
index 0bf3fbe..d12ce38 100644
--- a/dlls/iphlpapi/netwrite.c
+++ b/dlls/iphlpapi/netwrite.c
@@ -749,3 +749,11 @@ static DWORD proxy_arp( DWORD address, DWORD mask, DWORD index, const WCHAR *ver
 
 DWORD net_create_proxy_arp( DWORD address, DWORD mask, DWORD index ) { return proxy_arp( address, mask, index, L"add" ); }
 DWORD net_delete_proxy_arp( DWORD address, DWORD mask, DWORD index ) { return proxy_arp( address, mask, index, L"del" ); }
+
+/* reading the extended statistics: none are kept (see net_set_per_tcp_estats) */
+DWORD net_get_per_tcp_estats( const MIB_TCPROW *row, TCP_ESTATS_TYPE type )
+{
+    if (!row || type < TcpConnectionEstatsSynOpts || type >= TcpConnectionEstatsMaximum) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    return ERROR_NOT_SUPPORTED;
+}
