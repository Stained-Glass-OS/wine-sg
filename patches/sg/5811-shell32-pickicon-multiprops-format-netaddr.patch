+static void test_netaddr(void)
+{
+    NET_ADDRESS_INFO info;
+    NC_ADDRESS addr;
+    HWND hwnd;
+    HRESULT hr;
+    WCHAR text[64];
+
+    ok(InitNetworkAddressControl(), "InitNetworkAddressControl failed\n");
+    ok(InitNetworkAddressControl(), "second InitNetworkAddressControl failed\n");
+
+    hwnd = CreateWindowExW(0, L"msctls_netaddress", L"", WS_VISIBLE | WS_CHILD, 0, 0, 200, 24,
+            CreateWindowW(L"static", NULL, WS_VISIBLE | WS_POPUP, 0, 0, 300, 100, NULL, NULL, NULL, NULL), NULL, NULL, NULL);
+    ok(hwnd != NULL, "no control: %lu\n", GetLastError());
+    if (!hwnd) return;
+
+    ok(NetAddr_GetAllowType(hwnd) == 0x3ff, "default allow %#lx\n", NetAddr_GetAllowType(hwnd));
+    hr = NetAddr_SetAllowType(hwnd, 0);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    hr = NetAddr_SetAllowType(hwnd, 0x400);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    ok(NetAddr_GetAllowType(hwnd) == 0x3ff, "allow changed by a refused mask\n");
+    hr = NetAddr_SetAllowType(hwnd, NET_STRING_IPV4_ADDRESS | NET_STRING_IPV4_SERVICE | NET_STRING_IPV6_ADDRESS);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(NetAddr_GetAllowType(hwnd) == (NET_STRING_IPV4_ADDRESS | NET_STRING_IPV4_SERVICE | NET_STRING_IPV6_ADDRESS),
+            "allow %#lx\n", NetAddr_GetAllowType(hwnd));
+
+    SetWindowTextW(hwnd, L"192.168.1.5");
+    GetWindowTextW(hwnd, text, ARRAY_SIZE(text));
+    ok(!wcscmp(text, L"192.168.1.5"), "edit text %s\n", wine_dbgstr_w(text));
+    memset(&info, 0, sizeof(info));
+    memset(&addr, 0, sizeof(addr));
+    addr.pAddrInfo = (void *)&info;
+    hr = NetAddr_GetAddress(hwnd, &addr);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(info.Format == NET_ADDRESS_IPV4, "format %d\n", info.Format);
+    ok(info.Ipv4Address.sin_addr.S_un.S_un_b.s_b1 == 192 && info.Ipv4Address.sin_addr.S_un.S_un_b.s_b2 == 168 &&
+            info.Ipv4Address.sin_addr.S_un.S_un_b.s_b3 == 1 && info.Ipv4Address.sin_addr.S_un.S_un_b.s_b4 == 5,
+            "address %#lx\n", info.Ipv4Address.sin_addr.S_un.S_addr);
+
+    SetWindowTextW(hwnd, L"10.0.0.1:8080");
+    hr = NetAddr_GetAddress(hwnd, &addr);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(addr.PortNumber == 8080, "port %u\n", addr.PortNumber);
+
+    SetWindowTextW(hwnd, L"::1");
+    hr = NetAddr_GetAddress(hwnd, &addr);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(info.Format == NET_ADDRESS_IPV6, "format %d\n", info.Format);
+
+    /* a type that is not allowed */
+    NetAddr_SetAllowType(hwnd, NET_STRING_IPV6_ADDRESS);
+    SetWindowTextW(hwnd, L"192.168.1.5");
+    hr = NetAddr_GetAddress(hwnd, &addr);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_INVALID_PARAMETER), "got %#lx\n", hr);
+    SetWindowTextW(hwnd, L"not an address");
+    NetAddr_SetAllowType(hwnd, NET_STRING_IPV4_ADDRESS);
+    hr = NetAddr_GetAddress(hwnd, &addr);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_INVALID_PARAMETER), "got %#lx\n", hr);
+
+    hr = NetAddr_GetAddress(hwnd, NULL);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    addr.pAddrInfo = NULL;
+    hr = NetAddr_GetAddress(hwnd, &addr);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+
+    hr = NetAddr_DisplayErrorTip(hwnd);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    DestroyWindow(GetParent(hwnd));
+}
