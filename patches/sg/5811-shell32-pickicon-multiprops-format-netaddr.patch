+static void test_format(void)
+{
+    WCHAR image[MAX_PATH], path[MAX_PATH], spool[MAX_PATH];
+    char buf[1024], *u_image, *u_spool, expect[MAX_PATH + 64];
+    struct run r = {0};
+    HANDLE thread, file;
+    DWORD len = 0;
+    HWND dlg;
+    UINT type;
+
+    /* nothing here may reach a real device: the target is a regular file and the requests go to a
+     * stand-in for sg-admind */
+    ok(SHFormatDrive(NULL, 26, 0xffff, 0) == SHFMT_ERROR, "invalid drive\n");
+    ok(SHFormatDrive(NULL, 2, 0xffff, SHFMT_OPT_SYSONLY) == SHFMT_NOFORMAT, "system files only\n");
+    ok(SHFormatDrive(NULL, 'Q' - 'A', 0xffff, 0) == SHFMT_NOFORMAT, "no such drive\n");
+    type = GetDriveTypeW(L"Z:\\");
+    if (type == DRIVE_FIXED)
+        ok(SHFormatDrive(NULL, 25, 0xffff, 0) == SHFMT_NOFORMAT, "the root file system\n");
+
+    if (GetDriveTypeW(L"C:\\") != DRIVE_FIXED)
+    {
+        skip("C: is not a fixed drive\n");
+        return;
+    }
+
+    swprintf(image, ARRAY_SIZE(image), L"%s\\disk.img", dir);
+    swprintf(spool, ARRAY_SIZE(spool), L"%s\\spool", dir);
+    CreateDirectoryW(spool, NULL);
+    swprintf(path, ARRAY_SIZE(path), L"%s\\requests", spool);
+    CreateDirectoryW(path, NULL);
+    swprintf(path, ARRAY_SIZE(path), L"%s\\replies", spool);
+    CreateDirectoryW(path, NULL);
+    wcscpy(spool_win, spool);
+    make_file(L"disk.img", "unformatted");
+
+    u_image = unix_path(image);
+    u_spool = unix_path(spool);
+    {
+        WCHAR w[MAX_PATH];
+
+        MultiByteToWideChar(CP_UTF8, 0, u_image, -1, w, ARRAY_SIZE(w));
+        SetEnvironmentVariableW(L"SG_FORMAT_TARGET", w);
+        MultiByteToWideChar(CP_UTF8, 0, u_spool, -1, w, ARRAY_SIZE(w));
+        SetEnvironmentVariableW(L"SG_ADMIN_SPOOL", w);
+    }
+    stop_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    thread = CreateThread(NULL, 0, admind_thread, image, 0, NULL);
+
+    /* cancelling the warning formats nothing */
+    r.drive = 2;
+    start_run(&r, 2);
+    dlg = wait_dialog(&r, L"Format ", NULL);
+    ok(dlg != NULL, "no Format dialog\n");
+    if (dlg)
+    {
+        press_async(dlg, 13225);
+        answer_box(&r, dlg, L"erase ALL data", IDCANCEL);
+        Sleep(300);
+        press(dlg, IDCANCEL);
+    }
+    finish_run(&r);
+    ok(r.result.fmt == SHFMT_CANCEL, "got %#lx\n", r.result.fmt);
+    file = CreateFileW(image, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    ReadFile(file, buf, sizeof(buf) - 1, &len, NULL);
+    CloseHandle(file);
+    buf[len] = 0;
+    ok(!strcmp(buf, "unformatted"), "the image was written: %s\n", buf);
+
+    /* a format: the options reach sg-admind */
+    r.drive = 2;
+    start_run(&r, 2);
+    dlg = wait_dialog(&r, L"Format ", NULL);
+    if (dlg)
+    {
+        ok(SendDlgItemMessageW(dlg, 13221, CB_GETCOUNT, 0, 0) == 3, "file systems\n");
+        ok(SendDlgItemMessageW(dlg, 13224, BM_GETCHECK, 0, 0) == BST_CHECKED, "quick format\n");
+        SendDlgItemMessageW(dlg, 13221, CB_SETCURSEL, 2, 0);
+        SendDlgItemMessageW(dlg, 13222, CB_SETCURSEL, 4, 0);
+        SetDlgItemTextW(dlg, 13223, L"SGTEST");
+        press_async(dlg, 13225);
+        answer_box(&r, dlg, L"erase ALL data", IDOK);
+        answer_box(&r, dlg, L"Format Complete", IDOK);
+        press(dlg, IDCANCEL);
+    }
+    finish_run(&r);
+    ok(r.result.fmt == SHFMT_ID_DEFAULT, "got %#lx\n", r.result.fmt);
+    file = CreateFileW(image, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    len = 0;
+    ReadFile(file, buf, sizeof(buf) - 1, &len, NULL);
+    CloseHandle(file);
+    buf[len] = 0;
+    sprintf(expect, "format\n%s\tntfs\tSGTEST\t1\t4096\n", u_image);
+    ok(!strcmp(buf, expect), "request %s, expected %s\n", wine_dbgstr_a(buf), wine_dbgstr_a(expect));
+
+    /* sg-admind refusing: the dialog reports it and nothing counts as formatted */
+    make_file(L"spool\\refuse", "x");
+    r.drive = 2;
+    start_run(&r, 2);
+    dlg = wait_dialog(&r, L"Format ", NULL);
+    if (dlg)
+    {
+        press_async(dlg, 13225);
+        answer_box(&r, dlg, L"erase ALL data", IDOK);
+        answer_box(&r, dlg, L"Unable to complete", IDOK);
+        press(dlg, IDCANCEL);
+    }
+    finish_run(&r);
+    ok(r.result.fmt == SHFMT_CANCEL, "a refused format: got %#lx\n", r.result.fmt);
+
+    /* no sg-admind spool at all: not an administrator */
+    SetEnvironmentVariableW(L"SG_ADMIN_SPOOL", L"/nonexistent/spool");
+    r.drive = 2;
+    start_run(&r, 2);
+    dlg = wait_dialog(&r, L"Format ", NULL);
+    if (dlg)
+    {
+        press_async(dlg, 13225);
+        answer_box(&r, dlg, L"erase ALL data", IDOK);
+        answer_box(&r, dlg, L"must be an administrator", IDOK);
+        press(dlg, IDCANCEL);
+    }
+    finish_run(&r);
+    ok(r.result.fmt == SHFMT_CANCEL, "no spool: got %#lx\n", r.result.fmt);
+    SetEnvironmentVariableW(L"SG_FORMAT_TARGET", NULL);
+    SetEnvironmentVariableW(L"SG_ADMIN_SPOOL", NULL);
+
+    SetEvent(stop_event);
+    WaitForSingleObject(thread, 5000);
+    CloseHandle(thread);
+    CloseHandle(stop_event);
+    HeapFree(GetProcessHeap(), 0, u_image);
+    HeapFree(GetProcessHeap(), 0, u_spool);
+}
