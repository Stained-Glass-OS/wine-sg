+static WCHAR *load_string_dup(UINT id)
+{
+    WCHAR buf[256];
+
+    if (!LoadStringW(shell32_hInstance, id, buf, ARRAY_SIZE(buf))) buf[0] = 0;
+    return wcsdup(buf);
+}
+
+/*************************************************************************
+ * SHMultiFileProperties [SHELL32.@]
+ *
+ * The Properties sheet of several file system objects: what they are in common
+ * (type, location), their total size and contents, and their attributes, which
+ * can be changed for all of them at once. A check box is indeterminate when the
+ * objects differ. Returns when the sheet is closed.
+ */
+struct multi_props
+{
+    WCHAR **paths;
+    UINT count;
+};
+
+static void count_tree(const WCHAR *dir, ULONGLONG *size, DWORD *files, DWORD *folders, int depth)
+{
+    WIN32_FIND_DATAW fd;
+    WCHAR pattern[MAX_PATH], path[MAX_PATH];
+    HANDLE find;
+
+    if (depth > 64 || !PathCombineW(pattern, dir, L"*")) return;
+    if ((find = FindFirstFileW(pattern, &fd)) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L"..")) continue;
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+        {
+            ++*folders;
+            if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) && PathCombineW(path, dir, fd.cFileName))
+                count_tree(path, size, files, folders, depth + 1);
+        }
+        else
+        {
+            ++*files;
+            *size += ((ULONGLONG)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+        }
+    } while (FindNextFileW(find, &fd));
+    FindClose(find);
+}
+
+static const struct { UINT id; DWORD attr; } multi_attrs[] =
+{
+    { IDC_MPROP_READONLY, FILE_ATTRIBUTE_READONLY },
+    { IDC_MPROP_HIDDEN, FILE_ATTRIBUTE_HIDDEN },
+    { IDC_MPROP_ARCHIVE, FILE_ATTRIBUTE_ARCHIVE },
+};
+
+static void init_multi_page(HWND dlg, struct multi_props *props)
+{
+    WCHAR *fmt, text[MAX_PATH + 64], bytes[64], exact[40], dir[MAX_PATH], first_dir[MAX_PATH];
+    SHFILEINFOW info, first_info;
+    BOOL same_type = TRUE, same_dir = TRUE;
+    DWORD top_files = 0, top_folders = 0, files = 0, folders = 0;
+    ULONGLONG size = 0;
+    DWORD set[ARRAY_SIZE(multi_attrs)] = {0}, known = 0;
+    UINT i, j;
+
+    for (i = 0; i < props->count; i++)
+    {
+        WIN32_FILE_ATTRIBUTE_DATA data;
+        WCHAR *slash;
+
+        if (!GetFileAttributesExW(props->paths[i], GetFileExInfoStandard, &data)) continue;
+        known++;
+        lstrcpyW(dir, props->paths[i]);
+        if ((slash = wcsrchr(dir, '\\'))) *slash = 0;
+        memset(&info, 0, sizeof(info));
+        SHGetFileInfoW(props->paths[i], 0, &info, sizeof(info), SHGFI_TYPENAME);
+
+        if (i == 0)
+        {
+            lstrcpyW(first_dir, dir);
+            first_info = info;
+        }
+        else
+        {
+            if (wcsicmp(first_dir, dir)) same_dir = FALSE;
+            if (wcsicmp(first_info.szTypeName, info.szTypeName)) same_type = FALSE;
+        }
+
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+        {
+            top_folders++;
+            count_tree(props->paths[i], &size, &files, &folders, 0);
+        }
+        else
+        {
+            top_files++;
+            size += ((ULONGLONG)data.nFileSizeHigh << 32) | data.nFileSizeLow;
+        }
+        for (j = 0; j < ARRAY_SIZE(multi_attrs); j++)
+            if (data.dwFileAttributes & multi_attrs[j].attr) set[j]++;
+    }
+
+    fmt = load_string_dup(IDS_MPROP_FILESFOLDERS);
+    swprintf(text, ARRAY_SIZE(text), fmt, top_files, top_folders);
+    SetDlgItemTextW(dlg, IDC_MPROP_NAME, text);
+    swprintf(text, ARRAY_SIZE(text), fmt, files, folders);
+    SetDlgItemTextW(dlg, IDC_MPROP_CONTAINS, text);
+    free(fmt);
+
+    if (same_type)
+    {
+        fmt = load_string_dup(IDS_MPROP_ALLOFTYPE);
+        swprintf(text, ARRAY_SIZE(text), fmt, first_info.szTypeName);
+    }
+    else
+    {
+        fmt = load_string_dup(IDS_MPROP_MULTITYPE);
+        lstrcpyW(text, fmt);
+    }
+    free(fmt);
+    SetDlgItemTextW(dlg, IDC_MPROP_TYPE, text);
+
+    if (same_dir)
+    {
+        fmt = load_string_dup(IDS_MPROP_ALLIN);
+        swprintf(text, ARRAY_SIZE(text), fmt, first_dir);
+    }
+    else
+    {
+        fmt = load_string_dup(IDS_MPROP_MULTILOC);
+        lstrcpyW(text, fmt);
+    }
+    free(fmt);
+    SetDlgItemTextW(dlg, IDC_MPROP_LOCATION, text);
+
+    StrFormatByteSizeW(size, bytes, ARRAY_SIZE(bytes));
+    swprintf(exact, ARRAY_SIZE(exact), L"%I64u", size);
+    fmt = load_string_dup(IDS_MPROP_SIZE);
+    swprintf(text, ARRAY_SIZE(text), fmt, bytes, exact);
+    free(fmt);
+    SetDlgItemTextW(dlg, IDC_MPROP_SIZE, text);
+
+    {
+        SHFILEINFOW icon = {0};
+        BOOL ok;
+
+        if (same_type && known)
+            ok = SHGetFileInfoW(props->paths[0], 0, &icon, sizeof(icon), SHGFI_ICON);
+        else
+            ok = SHGetFileInfoW(L"file", FILE_ATTRIBUTE_NORMAL, &icon, sizeof(icon),
+                    SHGFI_ICON | SHGFI_USEFILEATTRIBUTES);
+        if (ok && icon.hIcon)
+        {
+            SendDlgItemMessageW(dlg, IDC_MPROP_ICON, STM_SETICON, (WPARAM)icon.hIcon, 0);
+            DestroyIcon(icon.hIcon);
+        }
+    }
+
+    for (j = 0; j < ARRAY_SIZE(multi_attrs); j++)
+    {
+        WPARAM state = BST_UNCHECKED;
+
+        if (known && set[j] == known) state = BST_CHECKED;
+        else if (set[j]) state = BST_INDETERMINATE;
+        SendDlgItemMessageW(dlg, multi_attrs[j].id, BM_SETCHECK, state, 0);
+    }
+}
+
+static void apply_multi_page(HWND dlg, struct multi_props *props)
+{
+    UINT i, j;
+
+    for (i = 0; i < props->count; i++)
+    {
+        DWORD attrs = GetFileAttributesW(props->paths[i]), new_attrs;
+
+        if (attrs == INVALID_FILE_ATTRIBUTES) continue;
+        new_attrs = attrs;
+        for (j = 0; j < ARRAY_SIZE(multi_attrs); j++)
+        {
+            LRESULT state = SendDlgItemMessageW(dlg, multi_attrs[j].id, BM_GETCHECK, 0, 0);
+
+            if (state == BST_CHECKED) new_attrs |= multi_attrs[j].attr;
+            else if (state == BST_UNCHECKED) new_attrs &= ~multi_attrs[j].attr;
+        }
+        if (new_attrs != attrs && !SetFileAttributesW(props->paths[i], new_attrs))
+            WARN("failed to set the attributes of %s: %lu\n", debugstr_w(props->paths[i]), GetLastError());
+    }
+}
+
+static INT_PTR CALLBACK multi_props_proc(HWND dlg, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        PROPSHEETPAGEW *page = (PROPSHEETPAGEW *)lparam;
+
+        SetWindowLongPtrW(dlg, DWLP_USER, page->lParam);
+        init_multi_page(dlg, (struct multi_props *)page->lParam);
+        return TRUE;
+    }
+    case WM_COMMAND:
+        if (HIWORD(wparam) == BN_CLICKED && LOWORD(wparam) >= IDC_MPROP_READONLY && LOWORD(wparam) <= IDC_MPROP_ARCHIVE)
+            SendMessageW(GetParent(dlg), PSM_CHANGED, (WPARAM)dlg, 0);
+        break;
+    case WM_NOTIFY:
+        if (((NMHDR *)lparam)->code == PSN_APPLY)
+        {
+#ifndef SG_MUTANT_MPROP_NOAPPLY
+            apply_multi_page(dlg, (struct multi_props *)GetWindowLongPtrW(dlg, DWLP_USER));
+#endif
+            SetWindowLongPtrW(dlg, DWLP_MSGRESULT, PSNRET_NOERROR);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+static BOOL CALLBACK multi_add_page(HPROPSHEETPAGE page, LPARAM lparam)
+{
+    PROPSHEETHEADERW *psh = (PROPSHEETHEADERW *)lparam;
+
+    psh->phpage[psh->nPages++] = page;
+    return TRUE;
+}
+
+HRESULT WINAPI SHMultiFileProperties(IDataObject *pdtobj, DWORD flags)
+{
+    struct multi_props props = {0};
+    IShellItemArray *array;
+    PROPSHEETHEADERW psh = {0};
+    PROPSHEETPAGEW page = {0};
+    HPROPSHEETPAGE pages[32];
+    WCHAR caption[64];
+    DWORD count, i;
+    HRESULT hr;
+
+    TRACE("%p %#lx\n", pdtobj, flags);
+
+    if (!pdtobj) return E_INVALIDARG;
+    if (FAILED(hr = SHCreateShellItemArrayFromDataObject(pdtobj, &IID_IShellItemArray, (void **)&array)))
+        return hr;
+    if (FAILED(hr = IShellItemArray_GetCount(array, &count)) || !count)
+    {
+        IShellItemArray_Release(array);
+        return FAILED(hr) ? hr : E_FAIL;
+    }
+    if (!(props.paths = calloc(count, sizeof(*props.paths))))
+    {
+        IShellItemArray_Release(array);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        IShellItem *item;
+        WCHAR *path;
+
+        if (FAILED(IShellItemArray_GetItemAt(array, i, &item))) continue;
+        if (SUCCEEDED(IShellItem_GetDisplayName(item, SIGDN_FILESYSPATH, &path)))
+        {
+            props.paths[props.count++] = wcsdup(path);
+            CoTaskMemFree(path);
+        }
+        IShellItem_Release(item);
+    }
+    IShellItemArray_Release(array);
+    if (!props.count)
+    {
+        free(props.paths);
+        return E_FAIL;
+    }
+
+    page.dwSize = sizeof(page);
+    page.dwFlags = PSP_DEFAULT;
+    page.hInstance = shell32_hInstance;
+    page.pszTemplate = MAKEINTRESOURCEW(IDD_MULTI_PROPERTIES);
+    page.pfnDlgProc = multi_props_proc;
+    page.lParam = (LPARAM)&props;
+
+    psh.dwSize = sizeof(psh);
+    psh.dwFlags = PSH_DEFAULT;
+    psh.phpage = pages;
+    LoadStringW(shell32_hInstance, IDS_MPROP_CAPTION, caption, ARRAY_SIZE(caption));
+    psh.pszCaption = caption;
+    if ((pages[0] = CreatePropertySheetPageW(&page))) psh.nPages = 1;
+
+    {
+        HPSXA ext = SHCreatePropSheetExtArrayEx(HKEY_CLASSES_ROOT, L"*", ARRAY_SIZE(pages) - psh.nPages, pdtobj);
+
+        if (ext)
+        {
+            SHAddFromPropSheetExtArray(ext, multi_add_page, (LPARAM)&psh);
+            SHDestroyPropSheetExtArray(ext);
+        }
+    }
+
+    hr = S_OK;
+    if (psh.nPages) PropertySheetW(&psh);
+    else hr = E_FAIL;
+
+    for (i = 0; i < props.count; i++) free(props.paths[i]);
+    free(props.paths);
+    return hr;
+}
+
+/*************************************************************************
+ * SHFormatDrive [SHELL32.@]
+ *
+ * The Format dialog of a drive (0 is A:). Formatting erases the drive's volume
+ * and is the machine's: the request goes to sg-admind (its "format" verb) as
+ * a file in its spool, which only an elevated program can write, and the
+ * answer is read back. Returns the format ID of the last format (the default
+ * ID: hard disks have no physical formats), SHFMT_CANCEL when nothing was
+ * formatted and SHFMT_NOFORMAT when the drive cannot be formatted: not a
+ * fixed or removable drive, not backed by a block device, or the system's own
+ * volume.
+ */
+static const struct { const WCHAR *name; const WCHAR *id; UINT max_label; } format_fs[] =
+{
+    { L"FAT32", L"vfat", 11 },
+    { L"exFAT", L"exfat", 15 },
+    { L"NTFS", L"ntfs", 32 },
+};
+
+static const UINT format_units[] = { 0, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536 };
+
+#define WM_FORMAT_DONE (WM_APP + 1)
+
+struct format_dlg
+{
+    WCHAR root[4];
+    WCHAR *device;
+    DWORD options;
+    BOOL busy;
+    UINT formatted;
+    HWND dlg;
+    WCHAR request[MAX_PATH * 2 + 128];
+};
+
+/* the spool protocol of sg-admind: the verb and its argument as two lines in a file
+ * that appears whole, the answer in the replies directory */
+static DWORD sg_admin_call(const WCHAR *verb, const WCHAR *arg, DWORD timeout_ms)
+{
+    WCHAR spool[MAX_PATH], dir[MAX_PATH + 16], tmp[MAX_PATH + 80], req[MAX_PATH + 80], rep[MAX_PATH + 80], id[40];
+    char body[2048], answer[1024];
+    LARGE_INTEGER counter;
+    DWORD len, written, i, err, waited = 0;
+    HANDLE file;
+    WCHAR *p;
+
+    if (!GetEnvironmentVariableW(L"SG_ADMIN_SPOOL", spool, ARRAY_SIZE(spool)))
+        lstrcpyW(spool, L"/run/stained-glass-admin");
+    if (spool[0] != '/') return ERROR_PRIVILEGE_NOT_HELD;
+    swprintf(dir, ARRAY_SIZE(dir), L"\\\\?\\unix%s", spool);
+    for (p = dir; *p; p++) if (*p == '/') *p = '\\';
+
+    QueryPerformanceCounter(&counter);
+    swprintf(id, ARRAY_SIZE(id), L"%08lx%08lx%08lx%08lx", GetCurrentProcessId(), GetCurrentThreadId(),
+            counter.LowPart, GetTickCount() ^ counter.HighPart);
+    swprintf(tmp, ARRAY_SIZE(tmp), L"%s\\requests\\.%s", dir, id);
+    swprintf(req, ARRAY_SIZE(req), L"%s\\requests\\%s.req", dir, id);
+    swprintf(rep, ARRAY_SIZE(rep), L"%s\\replies\\%s.rep", dir, id);
+
+    len = WideCharToMultiByte(CP_UTF8, 0, verb, -1, body, sizeof(body) - 1, NULL, NULL);
+    if (!len) return ERROR_INVALID_PARAMETER;
+    body[len - 1] = '\n';
+    i = WideCharToMultiByte(CP_UTF8, 0, arg, -1, body + len, sizeof(body) - len - 1, NULL, NULL);
+    if (!i) return ERROR_INVALID_PARAMETER;
+    len += i;
+    body[len - 1] = '\n';
+
+    file = CreateFileW(tmp, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) return ERROR_PRIVILEGE_NOT_HELD;
+    err = WriteFile(file, body, len, &written, NULL) && written == len ? 0 : GetLastError();
+    CloseHandle(file);
+    if (err || !MoveFileExW(tmp, req, 0))
+    {
+        DeleteFileW(tmp);
+        return ERROR_PRIVILEGE_NOT_HELD;
+    }
+
+    while (waited < timeout_ms)
+    {
+        file = CreateFileW(rep, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            Sleep(50);
+            len = 0;
+            ReadFile(file, answer, sizeof(answer) - 1, &len, NULL);
+            CloseHandle(file);
+            answer[len] = 0;
+            if (!strncmp(answer, "OK", 2) && (answer[2] == '\n' || !answer[2])) return ERROR_SUCCESS;
+            WARN("%s: %s\n", debugstr_w(verb), debugstr_a(answer));
+            return ERROR_ACCESS_DENIED;
+        }
+        Sleep(100);
+        waited += 100;
+    }
+    WARN("%s: no answer\n", debugstr_w(verb));
+    return ERROR_TIMEOUT;
+}
+
+static void unescape_mountinfo(char *s)
+{
+    char *out = s;
+
+    while (*s)
+    {
+        if (s[0] == '\\' && s[1] >= '0' && s[1] <= '3' && s[2] >= '0' && s[2] <= '7' && s[3] >= '0' && s[3] <= '7')
+        {
+            *out++ = ((s[1] - '0') << 6) | ((s[2] - '0') << 3) | (s[3] - '0');
+            s += 4;
+        }
+        else *out++ = *s++;
+    }
+    *out = 0;
+}
+
+/* The device behind a drive: the mount whose mount point is the longest prefix of
+ * the drive root's Unix path (/proc/self/mountinfo). The root file system, and
+ * anything that is not a /dev node, is not formattable. */
+static WCHAR *format_find_device(const WCHAR *root)
+{
+    WCHAR test[MAX_PATH], spool[8];
+    char *unix_root = NULL, *data = NULL, *line, *next, best_src[512] = "";
+    size_t best_len = 0;
+    DWORD size = 0, read_size;
+    HANDLE file;
+    WCHAR *result = NULL;
+
+    if (GetEnvironmentVariableW(L"SG_FORMAT_TARGET", test, ARRAY_SIZE(test)) &&
+            GetEnvironmentVariableW(L"SG_ADMIN_SPOOL", spool, ARRAY_SIZE(spool)) != 0)
+        return wcsdup(test);
+
+    if (!(unix_root = wine_get_unix_file_name(root))) return NULL;
+
+    file = CreateFileW(L"\\\\?\\unix\\proc\\self\\mountinfo", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+            OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) goto done;
+    data = malloc(1 << 20);
+    while (data && size < (1 << 20) - 1 && ReadFile(file, data + size, (1 << 20) - 1 - size, &read_size, NULL) && read_size)
+        size += read_size;
+    CloseHandle(file);
+    if (!data) goto done;
+    data[size] = 0;
+
+    for (line = data; line && *line; line = next)
+    {
+        char *fields[16], *tok, *save, *dash;
+        int n = 0;
+        size_t mlen;
+
+        if ((next = strchr(line, '\n'))) *next++ = 0;
+        if (!(dash = strstr(line, " - "))) continue;
+        for (tok = strtok_s(line, " ", &save); tok && n < 5; tok = strtok_s(NULL, " ", &save)) fields[n++] = tok;
+        if (n < 5) continue;
+        unescape_mountinfo(fields[4]);
+        mlen = strlen(fields[4]);
+        if (strncmp(unix_root, fields[4], mlen)) continue;
+        if (mlen > 1 && unix_root[mlen] && unix_root[mlen] != '/') continue;
+        if (mlen < best_len) continue;
+        /* "<fstype> <source> <options>" after the dash */
+        {
+            char *rest = dash + 3, *fs, *src;
+
+            fs = strtok_s(rest, " ", &save);
+            src = fs ? strtok_s(NULL, " ", &save) : NULL;
+            if (!src) continue;
+            unescape_mountinfo(src);
+            best_len = mlen;
+            lstrcpynA(best_src, src, sizeof(best_src));
+            if (mlen == 1) best_src[0] = 0;   /* the root file system */
+        }
+    }
+    if (!strncmp(best_src, "/dev/", 5))
+    {
+        int len = MultiByteToWideChar(CP_UTF8, 0, best_src, -1, NULL, 0);
+
+        if ((result = malloc(len * sizeof(WCHAR)))) MultiByteToWideChar(CP_UTF8, 0, best_src, -1, result, len);
+    }
+
+done:
+    free(data);
+    HeapFree(GetProcessHeap(), 0, unix_root);
+    return result;
+}
+
+static DWORD WINAPI format_thread(void *param)
+{
+    struct format_dlg *fd = param;
+    DWORD err = sg_admin_call(L"format", fd->request, 15 * 60 * 1000);
+
+    PostMessageW(fd->dlg, WM_FORMAT_DONE, err, 0);
+    return 0;
+}
+
+static void format_update_label_limit(HWND dlg)
+{
+    LRESULT sel = SendDlgItemMessageW(dlg, IDC_FMT_FS, CB_GETCURSEL, 0, 0);
+
+    if (sel != CB_ERR) SendDlgItemMessageW(dlg, IDC_FMT_LABEL, EM_LIMITTEXT, format_fs[sel].max_label, 0);
+}
+
+static void format_set_busy(HWND dlg, struct format_dlg *fd, BOOL busy)
+{
+    static const UINT ids[] = { IDC_FMT_FS, IDC_FMT_ALLOC, IDC_FMT_LABEL, IDC_FMT_QUICK, IDC_FMT_START };
+    UINT i;
+
+    fd->busy = busy;
+    for (i = 0; i < ARRAY_SIZE(ids); i++) EnableWindow(GetDlgItem(dlg, ids[i]), !busy);
+    if (busy)
+    {
+        WCHAR *text = load_string_dup(IDS_FORMAT_WORKING);
+
+        SetDlgItemTextW(dlg, IDC_FMT_STATUS, text);
+        free(text);
+        SetWindowLongW(GetDlgItem(dlg, IDC_FMT_PROGRESS), GWL_STYLE,
+                GetWindowLongW(GetDlgItem(dlg, IDC_FMT_PROGRESS), GWL_STYLE) | PBS_MARQUEE);
+        SendDlgItemMessageW(dlg, IDC_FMT_PROGRESS, PBM_SETMARQUEE, TRUE, 50);
+    }
+    else
+    {
+        SendDlgItemMessageW(dlg, IDC_FMT_PROGRESS, PBM_SETMARQUEE, FALSE, 0);
+        SetDlgItemTextW(dlg, IDC_FMT_STATUS, L"");
+    }
+}
+
+static void format_message(HWND dlg, UINT id, UINT flags)
+{
+    WCHAR caption[128], *text = load_string_dup(id);
+
+    GetWindowTextW(dlg, caption, ARRAY_SIZE(caption));
+    MessageBoxW(dlg, text, caption, flags);
+    free(text);
+}
+
+static void format_start(HWND dlg, struct format_dlg *fd)
+{
+    WCHAR label[40], fs_id[16], *warning, caption[128];
+    LRESULT fs, unit;
+    int answer;
+    HANDLE thread;
+
+    warning = load_string_dup(IDS_FORMAT_WARNING);
+    GetWindowTextW(dlg, caption, ARRAY_SIZE(caption));
+    answer = MessageBoxW(dlg, warning, caption, MB_OKCANCEL | MB_ICONWARNING | MB_DEFBUTTON2);
+    free(warning);
+#ifndef SG_MUTANT_FORMAT_NOCONFIRM
+    if (answer != IDOK) return;
+#endif
+
+    fs = SendDlgItemMessageW(dlg, IDC_FMT_FS, CB_GETCURSEL, 0, 0);
+    unit = SendDlgItemMessageW(dlg, IDC_FMT_ALLOC, CB_GETCURSEL, 0, 0);
+    if (fs == CB_ERR) fs = 0;
+    if (unit == CB_ERR) unit = 0;
+    GetDlgItemTextW(dlg, IDC_FMT_LABEL, label, ARRAY_SIZE(label));
+    lstrcpyW(fs_id, format_fs[fs].id);
+    swprintf(fd->request, ARRAY_SIZE(fd->request), L"%s\t%s\t%s\t%d\t%u", fd->device, fs_id, label,
+            SendDlgItemMessageW(dlg, IDC_FMT_QUICK, BM_GETCHECK, 0, 0) == BST_CHECKED, format_units[unit]);
+    fd->dlg = dlg;
+
+    format_set_busy(dlg, fd, TRUE);
+    if (!(thread = CreateThread(NULL, 0, format_thread, fd, 0, NULL)))
+    {
+        format_set_busy(dlg, fd, FALSE);
+        format_message(dlg, IDS_FORMAT_FAILED, MB_OK | MB_ICONERROR);
+        return;
+    }
+    CloseHandle(thread);
+}
+
+static INT_PTR CALLBACK format_proc(HWND dlg, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct format_dlg *fd = (struct format_dlg *)GetWindowLongPtrW(dlg, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        WCHAR text[MAX_PATH], caption[128], *fmt, volname[MAX_PATH], fsname[32];
+        ULARGE_INTEGER total, avail, free_bytes;
+        SHFILEINFOW info;
+        UINT i, sel = 0;
+
+        fd = (struct format_dlg *)lparam;
+        SetWindowLongPtrW(dlg, DWLP_USER, lparam);
+
+        fmt = load_string_dup(IDS_FORMAT_CAPTION);
+        if (SHGetFileInfoW(fd->root, 0, &info, sizeof(info), SHGFI_DISPLAYNAME)) lstrcpyW(text, info.szDisplayName);
+        else lstrcpyW(text, fd->root);
+        swprintf(caption, ARRAY_SIZE(caption), fmt, text);
+        free(fmt);
+        SetWindowTextW(dlg, caption);
+
+        if (GetDiskFreeSpaceExW(fd->root, &avail, &total, &free_bytes)) StrFormatByteSizeW(total.QuadPart, text, ARRAY_SIZE(text));
+        else text[0] = 0;
+        SendDlgItemMessageW(dlg, IDC_FMT_CAPACITY, CB_ADDSTRING, 0, (LPARAM)text);
+        SendDlgItemMessageW(dlg, IDC_FMT_CAPACITY, CB_SETCURSEL, 0, 0);
+
+        fsname[0] = volname[0] = 0;
+        GetVolumeInformationW(fd->root, volname, ARRAY_SIZE(volname), NULL, NULL, NULL, fsname, ARRAY_SIZE(fsname));
+        for (i = 0; i < ARRAY_SIZE(format_fs); i++)
+        {
+            SendDlgItemMessageW(dlg, IDC_FMT_FS, CB_ADDSTRING, 0, (LPARAM)format_fs[i].name);
+            if (!wcsicmp(fsname, format_fs[i].name)) sel = i;
+        }
+        if (!fsname[0] || sel == 0) sel = (total.QuadPart > 32ull << 30) ? 1 : 0;
+        SendDlgItemMessageW(dlg, IDC_FMT_FS, CB_SETCURSEL, sel, 0);
+
+        fmt = load_string_dup(IDS_FORMAT_DEFAULT_ALLOC);
+        SendDlgItemMessageW(dlg, IDC_FMT_ALLOC, CB_ADDSTRING, 0, (LPARAM)fmt);
+        free(fmt);
+        for (i = 1; i < ARRAY_SIZE(format_units); i++)
+        {
+            swprintf(text, ARRAY_SIZE(text), L"%u", format_units[i]);
+            SendDlgItemMessageW(dlg, IDC_FMT_ALLOC, CB_ADDSTRING, 0, (LPARAM)text);
+        }
+        SendDlgItemMessageW(dlg, IDC_FMT_ALLOC, CB_SETCURSEL, 0, 0);
+
+        format_update_label_limit(dlg);
+        SetDlgItemTextW(dlg, IDC_FMT_LABEL, volname);
+        SendDlgItemMessageW(dlg, IDC_FMT_QUICK, BM_SETCHECK, (fd->options & SHFMT_OPT_FULL) ? BST_UNCHECKED : BST_CHECKED, 0);
+        return TRUE;
+    }
+    case WM_COMMAND:
+        switch (LOWORD(wparam))
+        {
+        case IDC_FMT_FS:
+            if (HIWORD(wparam) == CBN_SELCHANGE) format_update_label_limit(dlg);
+            return TRUE;
+        case IDC_FMT_START:
+            if (!fd->busy) format_start(dlg, fd);
+            return TRUE;
+        case IDCANCEL:
+            if (!fd->busy) EndDialog(dlg, fd->formatted);
+            return TRUE;
+        }
+        break;
+    case WM_FORMAT_DONE:
+        format_set_busy(dlg, fd, FALSE);
+        if (!wparam)
+        {
+            WCHAR *close = load_string_dup(IDS_FORMAT_CLOSE);
+
+            fd->formatted++;
+            SetDlgItemTextW(dlg, IDCANCEL, close);
+            free(close);
+            format_message(dlg, IDS_FORMAT_DONE, MB_OK | MB_ICONINFORMATION);
+        }
+        else
+            format_message(dlg, wparam == ERROR_PRIVILEGE_NOT_HELD ? IDS_FORMAT_NOADMIN : IDS_FORMAT_FAILED,
+                    MB_OK | MB_ICONERROR);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+DWORD WINAPI SHFormatDrive(HWND hwnd, UINT drive, UINT fmtID, UINT options)
+{
+    struct format_dlg fd = {0};
+    INT_PTR ret;
+    UINT type;
+
+    TRACE("%p, %u, %#x, %#x\n", hwnd, drive, fmtID, options);
+
+    if (drive > 25) return SHFMT_ERROR;
+    /* a system-files-only format makes a boot disk, which there is no such thing as here */
+    if (options & SHFMT_OPT_SYSONLY) return SHFMT_NOFORMAT;
+
+    fd.root[0] = 'A' + drive;
+    fd.root[1] = ':';
+    fd.root[2] = '\\';
+    type = GetDriveTypeW(fd.root);
+    if (type != DRIVE_REMOVABLE && type != DRIVE_FIXED) return SHFMT_NOFORMAT;
+    if (!(fd.device = format_find_device(fd.root))) return SHFMT_NOFORMAT;
+    fd.options = options;
+
+    ret = DialogBoxParamW(shell32_hInstance, MAKEINTRESOURCEW(IDD_FORMAT), hwnd, format_proc, (LPARAM)&fd);
+    free(fd.device);
+    if (ret == -1) return SHFMT_ERROR;
+    return ret ? SHFMT_ID_DEFAULT : SHFMT_CANCEL;
+}
