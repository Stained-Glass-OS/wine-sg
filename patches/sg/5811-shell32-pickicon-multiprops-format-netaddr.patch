+/*************************************************************************
+ * InitNetworkAddressControl [SHELL32.@]
+ *
+ * Registers "msctls_netaddress": an edit control that holds a network address
+ * (an IPv4 or IPv6 address, a service address with a port, a network with a
+ * prefix length, a host name). NCM_GETADDRESS parses the text as one of the
+ * allowed types (NCM_SETALLOWTYPE, a combination of NET_STRING_* values, all by
+ * default) into the caller's NET_ADDRESS_INFO; NCM_DISPLAYERRORTIP shows a
+ * balloon tip at the control.
+ */
+#define NET_STRING_ALL 0x3ff
+
+static WNDPROC netaddr_edit_proc;
+static LONG_PTR netaddr_extra;
+
+static LRESULT CALLBACK netaddr_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    switch (msg)
+    {
+    case WM_NCCREATE:
+        SetWindowLongPtrW(hwnd, netaddr_extra, NET_STRING_ALL);
+        break;
+
+    case NCM_SETALLOWTYPE:
+        if (!wparam || (wparam & ~(WPARAM)NET_STRING_ALL)) return E_INVALIDARG;
+        SetWindowLongPtrW(hwnd, netaddr_extra, wparam);
+        return S_OK;
+
+    case NCM_GETALLOWTYPE:
+        return GetWindowLongPtrW(hwnd, netaddr_extra);
+
+    case NCM_GETADDRESS:
+    {
+        DWORD (WINAPI *parse)(const WCHAR *, DWORD, struct NET_ADDRESS_INFO_ *, USHORT *, BYTE *);
+        NC_ADDRESS *addr = (NC_ADDRESS *)lparam;
+        WCHAR text[512];
+        HMODULE iphlpapi;
+        USHORT port = 0;
+        BYTE prefix = 0;
+        DWORD err;
+
+        if (!addr || !addr->pAddrInfo) return E_INVALIDARG;
+        if (!(iphlpapi = LoadLibraryW(L"iphlpapi.dll"))) return HRESULT_FROM_WIN32(GetLastError());
+        parse = (void *)GetProcAddress(iphlpapi, "ParseNetworkString");
+        GetWindowTextW(hwnd, text, ARRAY_SIZE(text));
+#ifdef SG_MUTANT_NETADDR_NOMASK
+        SetWindowLongPtrW(hwnd, netaddr_extra, NET_STRING_ALL);
+#endif
+        err = parse ? parse(text, GetWindowLongPtrW(hwnd, netaddr_extra), addr->pAddrInfo,
+                &port, &prefix) : ERROR_PROC_NOT_FOUND;
+        FreeLibrary(iphlpapi);
+        if (err) return HRESULT_FROM_WIN32(err);
+        addr->PortNumber = port;
+        addr->PrefixLength = prefix;
+        return S_OK;
+    }
+
+    case NCM_DISPLAYERRORTIP:
+    {
+        EDITBALLOONTIP tip = {0};
+        WCHAR *title = load_string_dup(IDS_NETADDR_ERROR_TITLE), *text = load_string_dup(IDS_NETADDR_ERROR_TEXT);
+
+        tip.cbStruct = sizeof(tip);
+        tip.pszTitle = title;
+        tip.pszText = text;
+        tip.ttiIcon = TTI_ERROR;
+        SendMessageW(hwnd, EM_SHOWBALLOONTIP, 0, (LPARAM)&tip);
+        free(title);
+        free(text);
+        return S_OK;
+    }
+    }
+    return CallWindowProcW(netaddr_edit_proc, hwnd, msg, wparam, lparam);
+}
+
+BOOL WINAPI InitNetworkAddressControl(void)
+{
+    static LONG registered;
+    WNDCLASSEXW wc = {0};
+
+    TRACE("\n");
+
+    if (!InterlockedCompareExchange(&registered, 1, 0))
+    {
+        if (!GetClassInfoExW(NULL, L"Edit", &wc))
+        {
+            registered = 0;
+            return FALSE;
+        }
+        netaddr_edit_proc = wc.lpfnWndProc;
+        netaddr_extra = wc.cbWndExtra;
+        wc.cbSize = sizeof(wc);
+        wc.cbWndExtra += sizeof(LONG_PTR);
+        wc.lpfnWndProc = netaddr_proc;
+        wc.hInstance = shell32_hInstance;
+        wc.lpszClassName = L"msctls_netaddress";
+        if (!RegisterClassExW(&wc) && GetLastError() != ERROR_CLASS_ALREADY_EXISTS)
+        {
+            registered = 0;
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
