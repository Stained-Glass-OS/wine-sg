 /*************************************************************************
  * PickIconDlg					[SHELL32.62]
  *
+ * The Change Icon dialog: the icons of a file (an environment variable in its
+ * name is expanded) in a list, to choose one from. The path buffer receives
+ * the file as typed and index the icon's position. Returns nonzero for OK,
+ * zero for Cancel. An empty path, or a file without icons, lists the icons of
+ * shell32.dll.
  */
+struct pickicon
+{
+    WCHAR *path;
+    UINT len;
+    INT *index;
+    WCHAR typed[MAX_PATH];
+    WCHAR file[MAX_PATH];
+    HICON *icons;
+    UINT count;
+};
+
+static void pickicon_free_icons(struct pickicon *p)
+{
+    UINT i;
+
+    for (i = 0; i < p->count; i++)
+        if (p->icons[i]) DestroyIcon(p->icons[i]);
+    free(p->icons);
+    p->icons = NULL;
+    p->count = 0;
+}
+
+static UINT pickicon_load(HWND dlg, struct pickicon *p, const WCHAR *text)
+{
+    UINT count, i;
+
+    pickicon_free_icons(p);
+    SendDlgItemMessageW(dlg, IDC_PICKICON_LIST, LB_RESETCONTENT, 0, 0);
+    wcscpy(p->typed, text);
+    if (!ExpandEnvironmentStringsW(text, p->file, ARRAY_SIZE(p->file))) lstrcpynW(p->file, text, ARRAY_SIZE(p->file));
+    count = *p->file ? ExtractIconExW(p->file, -1, NULL, NULL, 0) : 0;
+    if (count == ~0u) count = 0;
+    if (!count) return 0;
+    if (!(p->icons = calloc(count, sizeof(*p->icons)))) return 0;
+    p->count = count;
+    SendDlgItemMessageW(dlg, IDC_PICKICON_LIST, WM_SETREDRAW, FALSE, 0);
+    for (i = 0; i < count; i++) SendDlgItemMessageW(dlg, IDC_PICKICON_LIST, LB_ADDSTRING, 0, (LPARAM)L"");
+    SendDlgItemMessageW(dlg, IDC_PICKICON_LIST, WM_SETREDRAW, TRUE, 0);
+    return count;
+}
+
+static void pickicon_no_icons(HWND dlg, struct pickicon *p)
+{
+    WCHAR fmt[160], caption[64], msg[MAX_PATH + 180];
+
+    LoadStringW(shell32_hInstance, IDS_PICKICON_NOICONS, fmt, ARRAY_SIZE(fmt));
+    LoadStringW(shell32_hInstance, IDS_PICKICON_CAPTION, caption, ARRAY_SIZE(caption));
+    swprintf(msg, ARRAY_SIZE(msg), fmt, p->typed);
+    MessageBoxW(dlg, msg, caption, MB_OK | MB_ICONEXCLAMATION);
+}
+
+static void pickicon_browse(HWND dlg, struct pickicon *p)
+{
+    WCHAR filter[256] = {0}, file[MAX_PATH], *f = filter;
+    OPENFILENAMEW ofn = {0};
+    int n;
+
+    n = LoadStringW(shell32_hInstance, IDS_PICKICON_FILTER_ICONS, f, 120);
+    f += n + 1;
+    wcscpy(f, L"*.ico;*.exe;*.dll;*.icl");
+    f += wcslen(f) + 1;
+    n = LoadStringW(shell32_hInstance, IDS_PICKICON_FILTER_ALL, f, 60);
+    f += n + 1;
+    wcscpy(f, L"*.*");
+
+    GetDlgItemTextW(dlg, IDC_PICKICON_FILE, file, ARRAY_SIZE(file));
+    if (!ExpandEnvironmentStringsW(file, p->file, ARRAY_SIZE(p->file))) p->file[0] = 0;
+    wcscpy(file, p->file);
+    ofn.lStructSize = sizeof(ofn);
+    ofn.hwndOwner = dlg;
+    ofn.lpstrFilter = filter;
+    ofn.lpstrFile = file;
+    ofn.nMaxFile = ARRAY_SIZE(file);
+    ofn.Flags = OFN_FILEMUSTEXIST | OFN_PATHMUSTEXIST | OFN_HIDEREADONLY;
+    if (!GetOpenFileNameW(&ofn)) return;
+
+    SetDlgItemTextW(dlg, IDC_PICKICON_FILE, file);
+    if (!pickicon_load(dlg, p, file)) pickicon_no_icons(dlg, p);
+    else SendDlgItemMessageW(dlg, IDC_PICKICON_LIST, LB_SETCURSEL, 0, 0);
+}
+
+static void pickicon_draw(const DRAWITEMSTRUCT *di, struct pickicon *p)
+{
+    const RECT *rc = &di->rcItem;
+
+    if ((int)di->itemID < 0 || di->itemID >= p->count) return;
+    if (!p->icons[di->itemID]) ExtractIconExW(p->file, di->itemID, &p->icons[di->itemID], NULL, 1);
+
+    FillRect(di->hDC, rc, GetSysColorBrush((di->itemState & ODS_SELECTED) ? COLOR_HIGHLIGHT : COLOR_WINDOW));
+    if (p->icons[di->itemID])
+        DrawIconEx(di->hDC, (rc->left + rc->right - 32) / 2, (rc->top + rc->bottom - 32) / 2, p->icons[di->itemID],
+                32, 32, 0, NULL, DI_NORMAL);
+    if (di->itemState & ODS_FOCUS) DrawFocusRect(di->hDC, rc);
+}
+
+static INT_PTR CALLBACK pickicon_proc(HWND dlg, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct pickicon *p = (struct pickicon *)GetWindowLongPtrW(dlg, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        WCHAR text[MAX_PATH];
+        INT sel;
+
+        p = (struct pickicon *)lparam;
+        SetWindowLongPtrW(dlg, DWLP_USER, lparam);
+        SendDlgItemMessageW(dlg, IDC_PICKICON_LIST, LB_SETCOLUMNWIDTH, 48, 0);
+        SendDlgItemMessageW(dlg, IDC_PICKICON_LIST, LB_SETITEMHEIGHT, 0, 44);
+        SendDlgItemMessageW(dlg, IDC_PICKICON_FILE, EM_LIMITTEXT, MAX_PATH - 1, 0);
+        lstrcpynW(text, p->path, ARRAY_SIZE(text));
+        if (!text[0] || !pickicon_load(dlg, p, text))
+        {
+            wcscpy(text, L"%SystemRoot%\\system32\\shell32.dll");
+            pickicon_load(dlg, p, text);
+        }
+        SetDlgItemTextW(dlg, IDC_PICKICON_FILE, text);
+        sel = (p->index && *p->index >= 0 && (UINT)*p->index < p->count) ? *p->index : 0;
+        if (p->count) SendDlgItemMessageW(dlg, IDC_PICKICON_LIST, LB_SETCURSEL, sel, 0);
+        return TRUE;
+    }
+    case WM_MEASUREITEM:
+        ((MEASUREITEMSTRUCT *)lparam)->itemHeight = 44;
+        ((MEASUREITEMSTRUCT *)lparam)->itemWidth = 48;
+        return TRUE;
+    case WM_DRAWITEM:
+        pickicon_draw((const DRAWITEMSTRUCT *)lparam, p);
+        return TRUE;
+    case WM_DESTROY:
+        if (p) pickicon_free_icons(p);
+        return TRUE;
+    case WM_COMMAND:
+        switch (LOWORD(wparam))
+        {
+        case IDC_PICKICON_BROWSE:
+            pickicon_browse(dlg, p);
+            return TRUE;
+        case IDC_PICKICON_LIST:
+            if (HIWORD(wparam) == LBN_DBLCLK) PostMessageW(dlg, WM_COMMAND, IDOK, 0);
+            return TRUE;
+        case IDOK:
+        {
+            WCHAR text[MAX_PATH];
+            INT sel;
+
+            GetDlgItemTextW(dlg, IDC_PICKICON_FILE, text, ARRAY_SIZE(text));
+            if (wcscmp(text, p->typed))
+            {
+                /* the file was changed: show its icons first */
+                if (!pickicon_load(dlg, p, text)) pickicon_no_icons(dlg, p);
+                else SendDlgItemMessageW(dlg, IDC_PICKICON_LIST, LB_SETCURSEL, 0, 0);
+                return TRUE;
+            }
+            if (!p->count)
+            {
+                pickicon_no_icons(dlg, p);
+                return TRUE;
+            }
+            sel = SendDlgItemMessageW(dlg, IDC_PICKICON_LIST, LB_GETCURSEL, 0, 0);
+            if (sel == LB_ERR) sel = 0;
+            lstrcpynW(p->path, text, p->len);
+#ifndef SG_MUTANT_PICKICON_NOINDEX
+            *p->index = sel;
+#endif
+            EndDialog(dlg, 1);
+            return TRUE;
+        }
+        case IDCANCEL:
+            EndDialog(dlg, 0);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
 INT WINAPI PickIconDlg(HWND hwndOwner, WCHAR *path, UINT path_len, INT *index)
 {
-    FIXME("(%p,%s,%u,%p):stub.\n", hwndOwner, debugstr_w(path), path_len, index);
-    return 0xffffffff;
+    struct pickicon p = {0};
+    INT_PTR ret;
+
+    TRACE("(%p,%s,%u,%p)\n", hwndOwner, debugstr_w(path), path_len, index);
+
+    if (!path || !path_len || !index) return 0;
+    p.path = path;
+    p.len = path_len;
+    p.index = index;
+    ret = DialogBoxParamW(shell32_hInstance, MAKEINTRESOURCEW(IDD_PICKICON), hwndOwner, pickicon_proc, (LPARAM)&p);
+    return ret == 1;
 }
 
