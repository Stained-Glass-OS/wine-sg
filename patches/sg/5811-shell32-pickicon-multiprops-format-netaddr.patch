+static WCHAR dir[MAX_PATH];
+
+static void make_file(const WCHAR *name, const char *data)
+{
+    WCHAR path[MAX_PATH];
+    HANDLE file;
+    DWORD written;
+
+    swprintf(path, ARRAY_SIZE(path), L"%s\\%s", dir, name);
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "create %s: %lu\n", wine_dbgstr_w(path), GetLastError());
+    WriteFile(file, data, strlen(data), &written, NULL);
+    CloseHandle(file);
+}
+
+static IDataObject *make_data(const WCHAR **names, UINT count)
+{
+    PIDLIST_ABSOLUTE pidls[8];
+    IDataObject *data = NULL;
+    UINT i;
+    HRESULT hr;
+
+    for (i = 0; i < count; i++)
+    {
+        WCHAR path[MAX_PATH];
+
+        swprintf(path, ARRAY_SIZE(path), L"%s\\%s", dir, names[i]);
+        hr = SHParseDisplayName(path, NULL, &pidls[i], 0, NULL);
+        ok(hr == S_OK, "got %#lx for %s\n", hr, wine_dbgstr_w(path));
+    }
+    hr = SHCreateDataObject(NULL, count, (PCUITEMID_CHILD_ARRAY)pidls, NULL, &IID_IDataObject, (void **)&data);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    for (i = 0; i < count; i++) ILFree(pidls[i]);
+    return data;
+}
+
+static BOOL CALLBACK child_proc(HWND hwnd, LPARAM lparam)
+{
+    if (GetDlgCtrlID(hwnd) == 13211) *(HWND *)lparam = GetParent(hwnd);
+    return TRUE;
+}
+
+static HWND find_page(HWND sheet)
+{
+    HWND page = NULL;
+
+    EnumChildWindows(sheet, child_proc, (LPARAM)&page);
+    return page;
+}
+
+static DWORD attrs_of(const WCHAR *name)
+{
+    WCHAR path[MAX_PATH];
+
+    swprintf(path, ARRAY_SIZE(path), L"%s\\%s", dir, name);
+    return GetFileAttributesW(path);
+}
+
+static void test_multi_properties(void)
+{
+    static const WCHAR *names[] = { L"mp1.txt", L"mp2.txt", L"mpdir" };
+    struct run r = {0};
+    IDataObject *data;
+    WCHAR text[MAX_PATH + 64], expected[MAX_PATH + 64], path[MAX_PATH];
+    HWND sheet, page;
+    HRESULT hr;
+    int i;
+
+    hr = SHMultiFileProperties(NULL, 0);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+
+    make_file(L"mp1.txt", "12345");
+    make_file(L"mp2.txt", "1234567890");
+    swprintf(path, ARRAY_SIZE(path), L"%s\\mpdir", dir);
+    CreateDirectoryW(path, NULL);
+    make_file(L"mpdir\\in1.bin", "abc");
+    make_file(L"mpdir\\in2.bin", "defg");
+    swprintf(path, ARRAY_SIZE(path), L"%s\\mpdir\\sub", dir);
+    CreateDirectoryW(path, NULL);
+    swprintf(path, ARRAY_SIZE(path), L"%s\\mp1.txt", dir);
+    SetFileAttributesW(path, FILE_ATTRIBUTE_READONLY);
+
+    data = make_data(names, 3);
+    r.data = data;
+    start_run(&r, 1);
+    sheet = wait_dialog(&r, L"Properties", NULL);
+    ok(sheet != NULL, "no Properties sheet\n");
+    page = sheet ? find_page(sheet) : NULL;
+    ok(page != NULL, "no General page\n");
+    if (page)
+    {
+        GetDlgItemTextW(page, 13211, text, ARRAY_SIZE(text));
+        ok(!wcscmp(text, L"2 Files, 1 Folders"), "name: %s\n", wine_dbgstr_w(text));
+        GetDlgItemTextW(page, 13215, text, ARRAY_SIZE(text));
+        ok(!wcscmp(text, L"2 Files, 1 Folders"), "contains: %s\n", wine_dbgstr_w(text));
+        GetDlgItemTextW(page, 13213, text, ARRAY_SIZE(text));
+        swprintf(expected, ARRAY_SIZE(expected), L"All in %s", dir);
+        ok(!wcsicmp(text, expected), "location: %s\n", wine_dbgstr_w(text));
+        GetDlgItemTextW(page, 13214, text, ARRAY_SIZE(text));
+        ok(wcsstr(text, L"(22 bytes)") != NULL, "size: %s\n", wine_dbgstr_w(text));
+        GetDlgItemTextW(page, 13212, text, ARRAY_SIZE(text));
+        ok(!wcsncmp(text, L"Multiple types", 14), "type: %s\n", wine_dbgstr_w(text));
+
+        ok(SendDlgItemMessageW(page, 13216, BM_GETCHECK, 0, 0) == BST_INDETERMINATE, "read-only %Id\n",
+                SendDlgItemMessageW(page, 13216, BM_GETCHECK, 0, 0));
+        ok(SendDlgItemMessageW(page, 13217, BM_GETCHECK, 0, 0) == BST_UNCHECKED, "hidden %Id\n",
+                SendDlgItemMessageW(page, 13217, BM_GETCHECK, 0, 0));
+        SendDlgItemMessageW(page, 13217, BM_SETCHECK, BST_CHECKED, 0);
+        SendMessageW(sheet, PSM_CHANGED, (WPARAM)page, 0);
+        SendMessageW(sheet, WM_COMMAND, IDOK, 0);
+    }
+    else if (sheet) SendMessageW(sheet, WM_COMMAND, IDCANCEL, 0);
+    finish_run(&r);
+    ok(r.result.hr == S_OK, "got %#lx\n", r.result.hr);
+    for (i = 0; i < 3; i++)
+        ok(attrs_of(names[i]) != INVALID_FILE_ATTRIBUTES && (attrs_of(names[i]) & FILE_ATTRIBUTE_HIDDEN),
+                "%s not hidden: %#lx\n", wine_dbgstr_w(names[i]), attrs_of(names[i]));
+    ok(attrs_of(names[0]) & FILE_ATTRIBUTE_READONLY, "the unchanged read-only attribute was dropped\n");
+    ok(!(attrs_of(names[1]) & FILE_ATTRIBUTE_READONLY), "read-only was set on the second file\n");
+    IDataObject_Release(data);
+
+    /* the same type and place */
+    {
+        static const WCHAR *same[] = { L"mp1.txt", L"mp2.txt" };
+
+        data = make_data(same, 2);
+        r.data = data;
+        start_run(&r, 1);
+        sheet = wait_dialog(&r, L"Properties", NULL);
+        page = sheet ? find_page(sheet) : NULL;
+        if (page)
+        {
+            GetDlgItemTextW(page, 13212, text, ARRAY_SIZE(text));
+            ok(!wcsncmp(text, L"All of type ", 12), "type: %s\n", wine_dbgstr_w(text));
+            ok(SendDlgItemMessageW(page, 13217, BM_GETCHECK, 0, 0) == BST_CHECKED, "hidden %Id\n",
+                    SendDlgItemMessageW(page, 13217, BM_GETCHECK, 0, 0));
+        }
+        if (sheet) SendMessageW(sheet, WM_COMMAND, IDCANCEL, 0);
+        finish_run(&r);
+        IDataObject_Release(data);
+    }
+}
