+static BOOL CALLBACK enum_text(HWND hwnd, LPARAM lparam)
+{
+    WCHAR text[256];
+
+    GetWindowTextW(hwnd, text, ARRAY_SIZE(text));
+    if (wcsstr(text, (const WCHAR *)lparam)) found = hwnd;
+    return TRUE;
+}
