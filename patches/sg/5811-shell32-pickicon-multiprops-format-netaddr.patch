+static void press_async(HWND dlg, UINT id)
+{
+    PostMessageW(dlg, WM_COMMAND, MAKEWPARAM(id, BN_CLICKED), (LPARAM)GetDlgItem(dlg, id));
+}
+
+static void press(HWND dlg, UINT id)
+{
+    SendMessageW(dlg, WM_COMMAND, MAKEWPARAM(id, BN_CLICKED), (LPARAM)GetDlgItem(dlg, id));
+}
+
+static UINT count_icons(const WCHAR *path)
+{
+    WCHAR expanded[MAX_PATH];
+    UINT n;
+
+    ExpandEnvironmentStringsW(path, expanded, ARRAY_SIZE(expanded));
+    n = ExtractIconExW(expanded, -1, NULL, NULL, 0);
+    return n == ~0u ? 0 : n;
+}
+
+static void test_pickicon(void)
+{
+    static const WCHAR shell32_path[] = L"%SystemRoot%\\system32\\shell32.dll";
+    static const WCHAR *others[] = { L"%SystemRoot%\\explorer.exe", L"%SystemRoot%\\regedit.exe",
+        L"%SystemRoot%\\system32\\winefile.exe", L"%SystemRoot%\\system32\\notepad.exe" };
+    UINT total = count_icons(shell32_path), other_count = 0, i;
+    const WCHAR *other = NULL;
+    struct run r = {0};
+    HWND dlg;
+    WCHAR text[MAX_PATH];
+
+    ok(PickIconDlg(NULL, NULL, 0, NULL) == 0, "invalid arguments accepted\n");
+    if (total < 8)
+    {
+        skip("shell32.dll has %u icons\n", total);
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(others) && !other; i++)
+        if ((other_count = count_icons(others[i])) && other_count != total) other = others[i];
+
+    /* OK: the icon selected, and the file as it was typed */
+    wcscpy(r.path, shell32_path);
+    r.index = 3;
+    start_run(&r, 0);
+    dlg = wait_dialog(&r, L"Change Icon", NULL);
+    ok(dlg != NULL, "no Change Icon dialog\n");
+    if (dlg)
+    {
+        GetDlgItemTextW(dlg, 13200, text, ARRAY_SIZE(text));
+        ok(!wcscmp(text, shell32_path), "file: %s\n", wine_dbgstr_w(text));
+        ok(SendDlgItemMessageW(dlg, 13202, LB_GETCOUNT, 0, 0) == total, "list has %Id icons, expected %u\n",
+                SendDlgItemMessageW(dlg, 13202, LB_GETCOUNT, 0, 0), total);
+        ok(SendDlgItemMessageW(dlg, 13202, LB_GETCURSEL, 0, 0) == 3, "selected %Id\n",
+                SendDlgItemMessageW(dlg, 13202, LB_GETCURSEL, 0, 0));
+        SendDlgItemMessageW(dlg, 13202, LB_SETCURSEL, 5, 0);
+        press(dlg, IDOK);
+    }
+    finish_run(&r);
+    ok(r.result.pick == 1, "got %d\n", r.result.pick);
+    ok(r.index == 5, "index %d\n", r.index);
+    ok(!wcscmp(r.path, shell32_path), "path %s\n", wine_dbgstr_w(r.path));
+
+    /* Cancel changes nothing */
+    wcscpy(r.path, shell32_path);
+    r.index = 3;
+    start_run(&r, 0);
+    dlg = wait_dialog(&r, L"Change Icon", NULL);
+    if (dlg)
+    {
+        SendDlgItemMessageW(dlg, 13202, LB_SETCURSEL, 7, 0);
+        SetDlgItemTextW(dlg, 13200, L"nothing");
+        press(dlg, IDCANCEL);
+    }
+    finish_run(&r);
+    ok(r.result.pick == 0, "got %d\n", r.result.pick);
+    ok(r.index == 3, "index %d\n", r.index);
+    ok(!wcscmp(r.path, shell32_path), "path %s\n", wine_dbgstr_w(r.path));
+
+    /* an empty path lists the icons of shell32.dll */
+    r.path[0] = 0;
+    r.index = 0;
+    start_run(&r, 0);
+    dlg = wait_dialog(&r, L"Change Icon", NULL);
+    if (dlg)
+    {
+        ok(SendDlgItemMessageW(dlg, 13202, LB_GETCOUNT, 0, 0) == total, "default list has %Id icons\n",
+                SendDlgItemMessageW(dlg, 13202, LB_GETCOUNT, 0, 0));
+        SendDlgItemMessageW(dlg, 13202, LB_SETCURSEL, 2, 0);
+        press(dlg, IDOK);
+    }
+    finish_run(&r);
+    ok(r.result.pick == 1 && r.index == 2, "got %d, index %d\n", r.result.pick, r.index);
+    ok(!wcsicmp(r.path, shell32_path), "path %s\n", wine_dbgstr_w(r.path));
+
+    /* another file: its icons are listed first, a second OK takes the choice */
+    if (other)
+    {
+        wcscpy(r.path, shell32_path);
+        r.index = 4;
+        start_run(&r, 0);
+        dlg = wait_dialog(&r, L"Change Icon", NULL);
+        if (dlg)
+        {
+            SetDlgItemTextW(dlg, 13200, other);
+            press(dlg, IDOK);
+            ok(IsWindow(dlg), "the dialog closed before the icons were shown\n");
+            ok(SendDlgItemMessageW(dlg, 13202, LB_GETCOUNT, 0, 0) == other_count, "%Id icons, expected %u\n",
+                    SendDlgItemMessageW(dlg, 13202, LB_GETCOUNT, 0, 0), other_count);
+            press(dlg, IDOK);
+        }
+        finish_run(&r);
+        ok(r.result.pick == 1 && r.index == 0, "got %d, index %d\n", r.result.pick, r.index);
+        ok(!wcscmp(r.path, other), "path %s\n", wine_dbgstr_w(r.path));
+    }
+    else skip("no second file with icons\n");
+}
