+static char *unix_path(const WCHAR *path)
+{
+    return wine_get_unix_file_name(path);
+}
+
+static HANDLE stop_event;
+static WCHAR spool_win[MAX_PATH];
+
+/* stands in for sg-admind: records each request in the image file and answers OK, or, with
+ * the file 'refuse' in the spool, an error */
+static DWORD WINAPI admind_thread(void *param)
+{
+    const WCHAR *image = param;
+
+    while (WaitForSingleObject(stop_event, 50) == WAIT_TIMEOUT)
+    {
+        WCHAR pattern[MAX_PATH], req[MAX_PATH], rep[MAX_PATH], refuse[MAX_PATH];
+        WIN32_FIND_DATAW fd;
+        HANDLE find;
+
+        swprintf(pattern, ARRAY_SIZE(pattern), L"%s\\requests\\*.req", spool_win);
+        if ((find = FindFirstFileW(pattern, &fd)) == INVALID_HANDLE_VALUE) continue;
+        do
+        {
+            char body[1024] = "";
+            DWORD len = 0;
+            HANDLE file;
+            const char *answer = "OK\n";
+
+            swprintf(req, ARRAY_SIZE(req), L"%s\\requests\\%s", spool_win, fd.cFileName);
+            file = CreateFileW(req, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+            if (file == INVALID_HANDLE_VALUE) continue;
+            ReadFile(file, body, sizeof(body) - 1, &len, NULL);
+            CloseHandle(file);
+            body[len] = 0;
+            DeleteFileW(req);
+
+            swprintf(refuse, ARRAY_SIZE(refuse), L"%s\\refuse", spool_win);
+            if (GetFileAttributesW(refuse) != INVALID_FILE_ATTRIBUTES) answer = "FAILED nope\n";
+            else
+            {
+                HANDLE img = CreateFileW(image, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+                DWORD written;
+
+                if (img != INVALID_HANDLE_VALUE)
+                {
+                    WriteFile(img, body, len, &written, NULL);
+                    CloseHandle(img);
+                }
+            }
+            swprintf(rep, ARRAY_SIZE(rep), L"%s\\replies\\%.*s.rep", spool_win, (int)(wcslen(fd.cFileName) - 4),
+                    fd.cFileName);
+            file = CreateFileW(rep, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+            if (file != INVALID_HANDLE_VALUE)
+            {
+                WriteFile(file, answer, strlen(answer), &len, NULL);
+                CloseHandle(file);
+            }
+        } while (FindNextFileW(find, &fd));
+        FindClose(find);
+    }
+    return 0;
+}
