+/* a message box of the thread: dismiss it with the button */
+static BOOL answer_box(struct run *r, HWND dlg, const WCHAR *contains, UINT button)
+{
+    HWND box = wait_dialog(r, NULL, dlg);
+
+    found = NULL;
+    if (box) EnumChildWindows(box, enum_text, (LPARAM)contains);
+    ok(box && found, "no message box with %s\n", wine_dbgstr_w(contains));
+    if (box) SendMessageW(box, WM_COMMAND, button, 0);
+    return box != NULL;
+}
