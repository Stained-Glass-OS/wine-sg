+/* a modal dialog run from a thread, so that the test can drive it from outside */
+struct run
+{
+    HANDLE thread;
+    DWORD tid;
+    union { INT pick; HRESULT hr; DWORD fmt; } result;
+    int kind;
+    WCHAR path[MAX_PATH];
+    INT index;
+    IDataObject *data;
+    UINT drive;
+};
+
+static DWORD WINAPI run_thread(void *param)
+{
+    struct run *r = param;
+
+    CoInitialize(NULL);
+    switch (r->kind)
+    {
+    case 0: r->result.pick = PickIconDlg(NULL, r->path, ARRAY_SIZE(r->path), &r->index); break;
+    case 1: r->result.hr = SHMultiFileProperties(r->data, 0); break;
+    case 2: r->result.fmt = SHFormatDrive(NULL, r->drive, 0xffff, 0); break;
+    }
+    CoUninitialize();
+    return 0;
+}
+
+static void start_run(struct run *r, int kind)
+{
+    r->kind = kind;
+    r->thread = CreateThread(NULL, 0, run_thread, r, 0, &r->tid);
+}
+
+static void finish_run(struct run *r)
+{
+    DWORD wait = WaitForSingleObject(r->thread, 10000);
+
+    ok(wait == WAIT_OBJECT_0, "the dialog did not end\n");
+    CloseHandle(r->thread);
+}
+
+static HWND found;
+static const WCHAR *find_title;
+static BOOL CALLBACK find_proc(HWND hwnd, LPARAM lparam)
+{
+    WCHAR cls[32], title[128];
+
+    GetClassNameW(hwnd, cls, ARRAY_SIZE(cls));
+    GetWindowTextW(hwnd, title, ARRAY_SIZE(title));
+    if (!wcscmp(cls, L"#32770") && IsWindowVisible(hwnd) && hwnd != (HWND)lparam &&
+            (!find_title || !wcsncmp(title, find_title, wcslen(find_title))))
+    {
+        found = hwnd;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* a dialog of the thread whose title starts with the text, other than 'except' */
+static HWND wait_dialog(struct run *r, const WCHAR *title, HWND except)
+{
+    int i;
+
+    for (i = 0; i < 100; i++)
+    {
+        found = NULL;
+        find_title = title;
+        EnumThreadWindows(r->tid, find_proc, (LPARAM)except);
+        if (found) return found;
+        Sleep(100);
+    }
+    return NULL;
+}
