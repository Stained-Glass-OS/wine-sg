From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the desktop's mouse points with a display left of the main one

The desktop's mouse messages (and ScreenToClient) give screen coordinates, from the main display's
corner, while it paints from its window's top left, the leftmost and topmost monitor's corner. With a
display left of or above the main one, a rubber band dragged out on one display was drawn on the
other and a click on an icon missed it. Every point the desktop gets goes through
sg_desk_from_screen (and back through sg_desk_to_screen). The dump gains deskrect= and bandrect=.
---
diff --git a/programs/explorer/desktop.c b/programs/explorer/desktop.c
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -318,6 +318,34 @@
     return -GetSystemMetrics( SM_YVIRTUALSCREEN );
 }
 
+/* Stained Glass OS: the mouse's points on the desktop -- its messages' and ScreenToClient's -- are
+ * screen coordinates, from the main display's corner (the desktop window's client area is the
+ * screen, as on Windows), while it is painted from its window's top left, the leftmost and topmost
+ * monitor's corner. With a display left of or above the main one the two differ by that display:
+ * a rubber band dragged out on one display was drawn on the other, a click on an icon missed it
+ * (David 2026-11-13). Every point the desktop is given goes through these. */
+static POINT sg_desk_from_screen( POINT pt )
+{
+#ifndef SG_MUTANT_DESK_POINTS_AS_SCREEN
+    pt.x += sg_desk_ox();
+    pt.y += sg_desk_oy();
+#endif
+    return pt;
+}
+static POINT sg_desk_to_screen( POINT pt )
+{
+#ifndef SG_MUTANT_DESK_POINTS_AS_SCREEN
+    pt.x -= sg_desk_ox();
+    pt.y -= sg_desk_oy();
+#endif
+    return pt;
+}
+static POINT sg_desk_point( LPARAM lp )
+{
+    POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
+    return sg_desk_from_screen( pt );
+}
+
 static RECT get_icon_rect( unsigned int index )
 {
     RECT rect;
@@ -1766,8 +1794,12 @@
     for (i = 0; i < nb_launchers; i++)
         if (launchers[i]->selected) fprintf( f, "%u,", i );
     fprintf( f, " hot=%d tip=%d focus=%d focuscues=%d", sg_hot, sg_tip_index, sg_selected, sg_focus_cues );
-    fprintf( f, "%s", sg_band_active ? " band=1" : "" );
-    fprintf( f, " drop=%d\n", sg_drop_hilite );
+    if (sg_band_active) fprintf( f, " band=1 bandrect=%ld,%ld,%ld,%ld", sg_band.left, sg_band.top, sg_band.right, sg_band.bottom );
+    {
+        RECT dr;
+        GetWindowRect( sg_desktop_hwnd, &dr );
+        fprintf( f, " deskrect=%ld,%ld,%ld,%ld drop=%d\n", dr.left, dr.top, dr.right, dr.bottom, sg_drop_hilite );
+    }
     for (i = 0; i < nb_launchers; i++)
     {
         RECT r = get_icon_rect( i );
@@ -2305,7 +2337,7 @@
 
     if (!GetCursorPos( &pt )) return -1;
     if (WindowFromPoint( pt ) != hwnd) return -1;
-    ScreenToClient( hwnd, &pt );
+    pt = sg_desk_from_screen( pt );
     return launcher_index_from_point( pt.x, pt.y );
 }
 
@@ -2508,7 +2540,7 @@
     sg_drag_hot.y = sg_press_pt.y - bound.top;
     pos.x = bound.left;
     pos.y = bound.top;
-    ClientToScreen( hwnd, &pos );
+    pos = sg_desk_to_screen( pos );
     if (!(sg_drag_image = CreateWindowExW( WS_EX_LAYERED | WS_EX_TRANSPARENT | WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_NOACTIVATE,
                                            wc.lpszClassName, L"", WS_POPUP, pos.x, pos.y, size.cx, size.cy,
                                            NULL, NULL, wc.hInstance, NULL ))) return;
@@ -2684,7 +2716,7 @@
     POINT pt = { spt.x, spt.y };
     int index, want;
 
-    ScreenToClient( sg_desktop_hwnd, &pt );
+    pt = sg_desk_from_screen( pt );
     index = launcher_index_from_point( pt.x, pt.y );
     if (index >= 0 && ((sg_dragging && launchers[index]->selected) || (launchers[index]->is_file && !launchers[index]->is_dir)))
         index = -1;
@@ -2752,7 +2784,7 @@
     HRESULT hr = S_OK;
 
     sg_drop_over( keys, spt, effect, FALSE );
-    ScreenToClient( sg_desktop_hwnd, &pt );
+    pt = sg_desk_from_screen( pt );
     if (sg_drop_sub_index == -2)
     {
         TRACE( "moving the selected icons to %ld,%ld\n", pt.x, pt.y );
@@ -3106,7 +3138,7 @@
     case WM_LBUTTONDOWN:
         if (!using_root)
         {
-            POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
+            POINT pt = sg_desk_point( lp );
             int index = launcher_index_from_point( pt.x, pt.y );
             unsigned int i;
 
@@ -3143,12 +3175,13 @@
         if (!using_root && sg_press_index == -2 && !(wp & (MK_LBUTTON | MK_RBUTTON)))
         {
             /* Stained Glass OS: the icon under the pointer is lit */
-            sg_set_hot( hwnd, launcher_index_from_point( (short)LOWORD(lp), (short)HIWORD(lp) ) );
+            POINT pt = sg_desk_point( lp );
+            sg_set_hot( hwnd, launcher_index_from_point( pt.x, pt.y ) );
             return 0;
         }
         if (!using_root && sg_press_index != -2 && GetCapture() == hwnd)
         {
-            POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
+            POINT pt = sg_desk_point( lp );
 
             if (!(wp & MK_LBUTTON))
             {
@@ -3205,9 +3238,9 @@
     case WM_RBUTTONUP:
         if (!using_root)
         {
-            POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
+            POINT pt = sg_desk_point( lp );
             int index = launcher_index_from_point( pt.x, pt.y );
-            ClientToScreen( hwnd, &pt );
+            pt = sg_desk_to_screen( pt );
             /* the menu is for the selection when the icon is in it, else for the icon alone */
             if (index < 0 || !launchers[index]->selected)
             {
@@ -3262,7 +3295,8 @@
     case WM_LBUTTONDBLCLK:
         if (!using_root)
         {
-            const struct launcher *launcher = launcher_from_point( (short)LOWORD(lp), (short)HIWORD(lp) );
+            POINT pt = sg_desk_point( lp );
+            const struct launcher *launcher = launcher_from_point( pt.x, pt.y );
             if (launcher) open_launcher( launcher );
         }
         return 0;
