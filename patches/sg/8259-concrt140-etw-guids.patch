From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] concrt140: export the Concurrency Runtime ETW GUIDs

The Concurrency Runtime's ETW provider GUID and its event category GUIDs (ConcRT_ProviderGuid, PPLParallelForEventGuid and eleven more) are data exports of concrt140; they were missing, so a program importing one (Bambu Studio, Plex, nomacs import PPLParallelForEventGuid) got an unresolved data import. Values from the concurrency namespace constants documentation.
---
--- a/dlls/concrt140/concrt140.c
+++ b/dlls/concrt140/concrt140.c
@@ -134,6 +134,38 @@
     return TRUE;
 }
 
+/* (wine-sg 8259) the Concurrency Runtime's ETW provider and event category GUIDs, exported as data
+ * (values from the concurrency namespace constants documentation) */
+#ifndef SG_MUTANT_NO_CONCRT_GUIDS
+const GUID concrt_AgentEventGuid = { 0xb9b5b78c, 0x0713, 0x4898, { 0xa2, 0x1a, 0xc6, 0x79, 0x49, 0xdc, 0xed, 0x07 } };
+const GUID concrt_ChoreEventGuid = { 0x7e854ec7, 0xcdc4, 0x405a, { 0xb5, 0xb2, 0xaa, 0xf7, 0xc9, 0xe7, 0xd4, 0x0c } };
+const GUID concrt_ConcRTEventGuid = { 0x72b14a7d, 0x704c, 0x423e, { 0x92, 0xf8, 0x7e, 0x6d, 0x64, 0xbc, 0xb9, 0x2a } };
+const GUID concrt_ConcRT_ProviderGuid = { 0xf7b697a3, 0x4db5, 0x4d3b, { 0xbe, 0x71, 0xc4, 0xd2, 0x84, 0xe6, 0x59, 0x2f } };
+const GUID concrt_ContextEventGuid = { 0x5727a00f, 0x50be, 0x4519, { 0x82, 0x56, 0xf7, 0x69, 0x98, 0x71, 0xfe, 0xcb } };
+const GUID concrt_LockEventGuid = { 0x79a60dc6, 0x5fc8, 0x4952, { 0xa4, 0x1c, 0x11, 0x63, 0xae, 0xec, 0x5e, 0xb8 } };
+const GUID concrt_PPLParallelForEventGuid = { 0x31c8da6b, 0x6165, 0x4042, { 0x8b, 0x92, 0x94, 0x9e, 0x31, 0x5f, 0x4d, 0x84 } };
+const GUID concrt_PPLParallelForeachEventGuid = { 0x5cb7d785, 0x9d66, 0x465d, { 0xba, 0xe1, 0x46, 0x11, 0x06, 0x1b, 0x54, 0x34 } };
+const GUID concrt_PPLParallelInvokeEventGuid = { 0xd1b5b133, 0xec3d, 0x49f4, { 0x98, 0xa3, 0x46, 0x4d, 0x1a, 0x9e, 0x46, 0x82 } };
+const GUID concrt_ResourceManagerEventGuid = { 0x2718d25b, 0x5bf5, 0x4479, { 0x8e, 0x88, 0xba, 0xbc, 0x64, 0xbd, 0xbf, 0xca } };
+const GUID concrt_ScheduleGroupEventGuid = { 0xe8a3bf1f, 0xa86b, 0x4390, { 0x9c, 0x60, 0x53, 0x90, 0xb9, 0x69, 0xd2, 0x2c } };
+const GUID concrt_SchedulerEventGuid = { 0xe2091f8a, 0x1e0a, 0x4731, { 0x84, 0xa2, 0x0d, 0xd5, 0x7c, 0x8a, 0x52, 0x61 } };
+const GUID concrt_VirtualProcessorEventGuid = { 0x2f27805f, 0x1676, 0x4ecc, { 0x96, 0xfa, 0x7e, 0xb0, 0x9d, 0x44, 0x30, 0x2f } };
+#else
+const GUID concrt_AgentEventGuid;
+const GUID concrt_ChoreEventGuid;
+const GUID concrt_ConcRTEventGuid;
+const GUID concrt_ConcRT_ProviderGuid;
+const GUID concrt_ContextEventGuid;
+const GUID concrt_LockEventGuid;
+const GUID concrt_PPLParallelForEventGuid;
+const GUID concrt_PPLParallelForeachEventGuid;
+const GUID concrt_PPLParallelInvokeEventGuid;
+const GUID concrt_ResourceManagerEventGuid;
+const GUID concrt_ScheduleGroupEventGuid;
+const GUID concrt_SchedulerEventGuid;
+const GUID concrt_VirtualProcessorEventGuid;
+#endif
+
 BOOL WINAPI DllMain(HINSTANCE inst, DWORD reason, LPVOID reserved)
 {
    switch (reason)
--- a/dlls/concrt140/concrt140.spec
+++ b/dlls/concrt140/concrt140.spec
