+/*
+ * A program prints to a printer DC; gdi32 records each page as an enhanced
+ * metafile in the job.  For a printer whose driver is a printer graphics DLL
+ * (the printer maker's own, or Unidrv for GPD printers), we load that DLL
+ * here, as GDI would: DrvEnableDriver, DrvEnablePDEV, DrvEnableSurface, then
+ * per page DrvStartPage, draw the page's metafile into the driver's surface,
+ * DrvSendPage (or band by band with DrvStartBanding and DrvNextBand), and at
+ * the end DrvEndDoc.  What the driver writes with EngWritePrinter goes to the
+ * printer's port as the job's raw data.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "windows.h"
+#include "winspool.h"
+#include "ddk/winsplp.h"
+#include "ddk/winddi.h"
+#include "wine/printdrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(winprint);
+
+BOOL WINAPI SeekPrinter( HANDLE, LARGE_INTEGER, LARGE_INTEGER *, DWORD, BOOL );
+
+enum
+{
+    EMRI_METAFILE = 1,
+    EMRI_DEVMODE = 3,
+    EMRI_METAFILE_DATA = 12,
+    EMRI_METAFILE_EXT = 13,
+    EMRI_BW_METAFILE_EXT = 14,
+};
+
+struct spool_page
+{
+    BYTE     *emf;
+    DWORD     size;
+    DEVMODEW *devmode;   /* the devmode in force for this page */
+};
+
+struct driver
+{
+    HMODULE module;
+    DHPDEV  (WINAPI *enable_pdev)( DEVMODEW *, WCHAR *, ULONG, HSURF *, ULONG, ULONG *, ULONG, DEVINFO *,
+                                   HDEV, WCHAR *, HANDLE );
+    void    (WINAPI *complete_pdev)( DHPDEV, HDEV );
+    void    (WINAPI *disable_pdev)( DHPDEV );
+    HSURF   (WINAPI *enable_surface)( DHPDEV );
+    void    (WINAPI *disable_surface)( DHPDEV );
+    BOOL    (WINAPI *start_doc)( SURFOBJ *, WCHAR *, DWORD );
+    BOOL    (WINAPI *end_doc)( SURFOBJ *, FLONG );
+    BOOL    (WINAPI *start_page)( SURFOBJ * );
+    BOOL    (WINAPI *send_page)( SURFOBJ * );
+    BOOL    (WINAPI *start_banding)( SURFOBJ *, POINTL * );
+    BOOL    (WINAPI *next_band)( SURFOBJ *, POINTL * );
+    BOOL    (WINAPI *copy_bits)( SURFOBJ *, SURFOBJ *, CLIPOBJ *, XLATEOBJ *, RECTL *, POINTL * );
+    void    (WINAPI *disable_driver)( void );
+};
+
+static void free_pages( struct spool_page *pages, unsigned int count )
+{
+    unsigned int i;
+    for (i = 0; i < count; i++)
+    {
+        free( pages[i].emf );
+        /* devmodes are shared between pages; freed through the last owner */
+    }
+    free( pages );
+}
+
+/* reads the job's pages: each is a metafile, with the devmode that was in
+ * force when it was drawn */
+/* the job's data, from the spooler or from a file our 64-bit host was given */
+struct spool_reader
+{
+    HANDLE handle;
+    BOOL   file;
+};
+
+static BOOL spool_read( struct spool_reader *r, void *buf, DWORD size, DWORD *got )
+{
+    if (r->file) return ReadFile( r->handle, buf, size, got, NULL );
+    return ReadPrinter( r->handle, buf, size, got );
+}
+
+static BOOL spool_seek( struct spool_reader *r, LONGLONG offset, DWORD origin )
+{
+    LARGE_INTEGER pos;
+    pos.QuadPart = offset;
+    if (r->file) return SetFilePointerEx( r->handle, pos, NULL, origin );
+    return SeekPrinter( r->handle, pos, NULL, origin, FALSE );
+}
+
+static struct spool_page *read_spool( struct spool_reader *spool, unsigned int *count, DEVMODEW ***devmodes,
+                                      unsigned int *dm_count )
+{
+    struct { DWORD version, size, doc_name, output; } header;
+    struct { DWORD id, size; } record;
+    struct spool_page *pages = NULL;
+    DEVMODEW *current = NULL;
+    DWORD r;
+
+    *count = 0;
+    *dm_count = 0;
+    *devmodes = NULL;
+    if (!spool_read( spool, &header, sizeof(header), &r ) || r != sizeof(header)) return NULL;
+    if (header.version != 0x10000)
+    {
+        FIXME( "spool file version %#lx\n", header.version );
+        return NULL;
+    }
+    if (!spool_seek( spool, header.size, FILE_BEGIN )) return NULL;
+
+    while (spool_read( spool, &record, sizeof(record), &r ) && r == sizeof(record))
+    {
+        switch (record.id)
+        {
+        case EMRI_METAFILE:
+        case EMRI_METAFILE_DATA:
+        {
+            BYTE *emf = malloc( record.size );
+            if (!emf || !spool_read( spool, emf, record.size, &r ) || r != record.size)
+            {
+                free( emf );
+                return pages;
+            }
+            pages = realloc( pages, (*count + 1) * sizeof(*pages) );
+            pages[*count].emf = emf;
+            pages[*count].size = record.size;
+            pages[*count].devmode = current;
+            (*count)++;
+            break;
+        }
+        case EMRI_DEVMODE:
+        {
+            DEVMODEW *dm = NULL;
+            if (record.size)
+            {
+                dm = malloc( record.size );
+                if (!dm || !spool_read( spool, dm, record.size, &r ) || r != record.size)
+                {
+                    free( dm );
+                    return pages;
+                }
+                *devmodes = realloc( *devmodes, (*dm_count + 1) * sizeof(**devmodes) );
+                (*devmodes)[(*dm_count)++] = dm;
+            }
+            /* written after the page it was set for */
+            if (*count) pages[*count - 1].devmode = dm;
+            current = dm;
+            break;
+        }
+        default:
+            if (!spool_seek( spool, record.size, FILE_CURRENT )) return pages;
+            break;
+        }
+    }
+    return pages;
+}
+
+static BOOL load_driver( struct driver *drv, HANDLE printer )
+{
+    BOOL (WINAPI *enable_driver)( ULONG, ULONG, DRVENABLEDATA * );
+    DRIVER_INFO_3W *info;
+    DRVENABLEDATA ded;
+    DWORD needed = 0;
+    ULONG i;
+
+    GetPrinterDriverW( printer, NULL, 3, NULL, 0, &needed );
+    if (!needed || !(info = malloc( needed ))) return FALSE;
+    if (!GetPrinterDriverW( printer, NULL, 3, (BYTE *)info, needed, &needed ) || !info->pDriverPath)
+    {
+        free( info );
+        return FALSE;
+    }
+    drv->module = LoadLibraryW( info->pDriverPath );
+    if (!drv->module)
+    {
+        /* our own drivers are found by their plain names */
+        const WCHAR *base = wcsrchr( info->pDriverPath, '\\' );
+        drv->module = LoadLibraryW( base ? base + 1 : info->pDriverPath );
+    }
+    TRACE( "driver %s -> %p\n", debugstr_w(info->pDriverPath), drv->module );
+    free( info );
+    if (!drv->module) return FALSE;
+
+    enable_driver = (void *)GetProcAddress( drv->module, "DrvEnableDriver" );
+    drv->disable_driver = (void *)GetProcAddress( drv->module, "DrvDisableDriver" );
+    memset( &ded, 0, sizeof(ded) );
+    if (!enable_driver || !enable_driver( DDI_DRIVER_VERSION_NT5_01, sizeof(ded), &ded ))
+    {
+        WARN( "DrvEnableDriver failed\n" );
+        FreeLibrary( drv->module );
+        return FALSE;
+    }
+    for (i = 0; i < ded.c; i++)
+    {
+        PFN fn = ded.pdrvfn[i].pfn;
+        switch (ded.pdrvfn[i].iFunc)
+        {
+        case INDEX_DrvEnablePDEV: drv->enable_pdev = (void *)fn; break;
+        case INDEX_DrvCompletePDEV: drv->complete_pdev = (void *)fn; break;
+        case INDEX_DrvDisablePDEV: drv->disable_pdev = (void *)fn; break;
+        case INDEX_DrvEnableSurface: drv->enable_surface = (void *)fn; break;
+        case INDEX_DrvDisableSurface: drv->disable_surface = (void *)fn; break;
+        case INDEX_DrvStartDoc: drv->start_doc = (void *)fn; break;
+        case INDEX_DrvEndDoc: drv->end_doc = (void *)fn; break;
+        case INDEX_DrvStartPage: drv->start_page = (void *)fn; break;
+        case INDEX_DrvSendPage: drv->send_page = (void *)fn; break;
+        case INDEX_DrvStartBanding: drv->start_banding = (void *)fn; break;
+        case INDEX_DrvNextBand: drv->next_band = (void *)fn; break;
+        case INDEX_DrvCopyBits: drv->copy_bits = (void *)fn; break;
+        }
+    }
+    return drv->enable_pdev && drv->enable_surface;
+}
+
+static int format_bpp( ULONG format )
+{
+    switch (format)
+    {
+    case BMF_1BPP: return 1;
+    case BMF_4BPP: return 4;
+    case BMF_8BPP: return 8;
+    case BMF_16BPP: return 16;
+    case BMF_24BPP: return 24;
+    case BMF_32BPP: return 32;
+    }
+    return 0;
+}
+
+/* draws a page's metafile into a bitmap laid out as the driver's surface,
+ * with the band's origin at (origin.x, origin.y) of the page */
+static BOOL render_page( const struct spool_page *page, SURFOBJ *so, const DEVINFO *devinfo, POINTL origin )
+{
+    const ENHMETAHEADER *emh = (const ENHMETAHEADER *)page->emf;
+    int bpp = format_bpp( so->iBitmapFormat ), y;
+    int w = so->sizlBitmap.cx, h = so->sizlBitmap.cy;
+    struct { BITMAPINFOHEADER hdr; RGBQUAD colors[256]; } bmi;
+    HENHMETAFILE hemf;
+    HBITMAP dib, old;
+    BYTE *bits;
+    HDC hdc;
+    RECT rect;
+    int stride;
+    BOOL ret = FALSE;
+
+    if (!bpp || !so->pvScan0)
+    {
+        FIXME( "surface type %u format %lu not drawn\n", so->iType, so->iBitmapFormat );
+        return FALSE;
+    }
+    memset( &bmi, 0, sizeof(bmi) );
+    bmi.hdr.biSize = sizeof(bmi.hdr);
+    bmi.hdr.biWidth = w;
+    bmi.hdr.biHeight = -h;
+    bmi.hdr.biPlanes = 1;
+    bmi.hdr.biBitCount = bpp;
+    bmi.hdr.biCompression = BI_RGB;
+    if (bpp <= 8)
+    {
+        const struct wine_eng_palette *pal = (const struct wine_eng_palette *)devinfo->hpalDefault;
+        unsigned int i, n = 1u << bpp;
+        if (pal && pal->mode == PAL_INDEXED && pal->count)
+        {
+            for (i = 0; i < n && i < pal->count; i++)
+            {
+                bmi.colors[i].rgbRed = pal->colors[i] & 0xff;
+                bmi.colors[i].rgbGreen = (pal->colors[i] >> 8) & 0xff;
+                bmi.colors[i].rgbBlue = (pal->colors[i] >> 16) & 0xff;
+            }
+        }
+        else if (bpp == 1)
+        {
+            bmi.colors[1].rgbRed = bmi.colors[1].rgbGreen = bmi.colors[1].rgbBlue = 0xff;
+        }
+        else for (i = 0; i < n; i++)
+            bmi.colors[i].rgbRed = bmi.colors[i].rgbGreen = bmi.colors[i].rgbBlue = i * 255 / (n - 1);
+        bmi.hdr.biClrUsed = n;
+    }
+
+    hdc = CreateCompatibleDC( NULL );
+    dib = CreateDIBSection( hdc, (BITMAPINFO *)&bmi, DIB_RGB_COLORS, (void **)&bits, NULL, 0 );
+    if (!dib)
+    {
+        DeleteDC( hdc );
+        return FALSE;
+    }
+    old = SelectObject( hdc, dib );
+    stride = ((w * bpp + 31) / 32) * 4;
+
+    /* the page starts as paper */
+    rect.left = rect.top = 0;
+    rect.right = w;
+    rect.bottom = h;
+    FillRect( hdc, &rect, GetStockObject( WHITE_BRUSH ) );
+
+    if ((hemf = SetEnhMetaFileBits( page->size, page->emf )))
+    {
+        /* the metafile was recorded on the printer DC: one of its device units
+         * is one of the surface's pixels, and (0,0) is the printable origin */
+        double px = (double)emh->szlDevice.cx / (emh->szlMillimeters.cx * 100.0);
+        double py = (double)emh->szlDevice.cy / (emh->szlMillimeters.cy * 100.0);
+
+        rect.left = (int)(emh->rclFrame.left * px + 0.5) - origin.x;
+        rect.top = (int)(emh->rclFrame.top * py + 0.5) - origin.y;
+        rect.right = (int)(emh->rclFrame.right * px + 0.5) - origin.x;
+        rect.bottom = (int)(emh->rclFrame.bottom * py + 0.5) - origin.y;
+        TRACE( "emf bounds (%ld,%ld)-(%ld,%ld) frame (%ld,%ld)-(%ld,%ld) device %ldx%ld mm %ldx%ld\n",
+               emh->rclBounds.left, emh->rclBounds.top, emh->rclBounds.right, emh->rclBounds.bottom,
+               emh->rclFrame.left, emh->rclFrame.top, emh->rclFrame.right, emh->rclFrame.bottom,
+               emh->szlDevice.cx, emh->szlDevice.cy, emh->szlMillimeters.cx, emh->szlMillimeters.cy );
+        TRACE( "page frame %s on band %ld,%ld %dx%d\n", wine_dbgstr_rect(&rect), origin.x, origin.y, w, h );
+        SetGraphicsMode( hdc, GM_ADVANCED );
+        if (emh->rclFrame.right > emh->rclFrame.left && emh->rclFrame.bottom > emh->rclFrame.top)
+            ret = PlayEnhMetaFile( hdc, hemf, &rect );
+        else ret = TRUE;  /* nothing drawn */
+        DeleteEnhMetaFile( hemf );
+    }
+    GdiFlush();
+
+    /* into the driver's surface, whichever way up it is */
+    for (y = 0; y < h; y++)
+        memcpy( (BYTE *)so->pvScan0 + (LONG_PTR)y * so->lDelta, bits + (SIZE_T)y * stride,
+                min( stride, abs( so->lDelta ) ) );
+
+    SelectObject( hdc, old );
+    DeleteObject( dib );
+    DeleteDC( hdc );
+    return ret;
+}
+
+/* runs the job through the driver in this process; FALSE with
+ * ERROR_BAD_EXE_FORMAT when the driver (or a part of it) cannot load here */
+static BOOL render_job( HANDLE printer, const WCHAR *printer_name, DEVMODEW *job_devmode, const WCHAR *doc_name,
+                        const WCHAR *out_file, DWORD job_id, struct spool_page *pages, unsigned int page_count,
+                        HANDLE hport, HANDLE file )
+{
+    struct wine_eng_device dev;
+    unsigned int i, copy, copies;
+    DEVMODEW *devmode;
+    struct driver drv;
+    DOC_INFO_1W info;
+    GDIINFO gdiinfo;
+    DEVINFO devinfo;
+    SURFOBJ *so;
+    HSURF hsurf;
+    BOOL ret = FALSE;
+
+    memset( &drv, 0, sizeof(drv) );
+    if (!load_driver( &drv, printer ))
+    {
+        WARN( "the printer driver of %s did not load here\n", debugstr_w(printer_name) );
+        SetLastError( ERROR_BAD_EXE_FORMAT );
+        return FALSE;
+    }
+
+    devmode = page_count && pages[0].devmode ? pages[0].devmode : job_devmode;
+    copies = devmode && (devmode->dmFields & DM_COPIES) && devmode->dmCopies > 1 ? devmode->dmCopies : 1;
+
+    memset( &dev, 0, sizeof(dev) );
+    dev.magic = WINE_ENG_DEVICE_MAGIC;
+    dev.printer = printer;
+    dev.output = hport;
+    dev.file = file;
+    __wine_eng_register_device( &dev, TRUE );
+
+    memset( &gdiinfo, 0, sizeof(gdiinfo) );
+    memset( &devinfo, 0, sizeof(devinfo) );
+    dev.dhpdev = drv.enable_pdev( devmode, (WCHAR *)printer_name, 0, NULL, sizeof(gdiinfo), (ULONG *)&gdiinfo,
+                                  sizeof(devinfo), &devinfo, (HDEV)&dev, (WCHAR *)printer_name, printer );
+    if (!dev.dhpdev)
+    {
+        if (GetLastError() != ERROR_BAD_EXE_FORMAT) ERR( "DrvEnablePDEV failed\n" );
+        goto done;
+    }
+
+    if (hport)
+    {
+        info.pDocName = (WCHAR *)doc_name;
+        info.pOutputFile = (WCHAR *)out_file;
+        info.pDatatype = (WCHAR *)L"RAW";
+        if (!StartDocPrinterW( hport, 1, (BYTE *)&info ))
+        {
+            if (drv.disable_pdev) drv.disable_pdev( dev.dhpdev );
+            goto done;
+        }
+    }
+
+    if (drv.complete_pdev) drv.complete_pdev( dev.dhpdev, (HDEV)&dev );
+    hsurf = drv.enable_surface( dev.dhpdev );
+    if (!hsurf || !(so = EngLockSurface( hsurf )))
+    {
+        ERR( "DrvEnableSurface failed\n" );
+        goto done_pdev;
+    }
+    if (!so->dhpdev) so->dhpdev = dev.dhpdev;
+    TRACE( "surface %ldx%ld format %lu banding %d\n", so->sizlBitmap.cx, so->sizlBitmap.cy,
+           so->iBitmapFormat, dev.banding );
+
+    ret = !drv.start_doc || drv.start_doc( so, (WCHAR *)doc_name, job_id );
+    for (copy = 0; ret && copy < copies; copy++)
+    {
+        for (i = 0; ret && i < page_count; i++)
+        {
+            POINTL origin = { 0, 0 };
+
+            if (drv.start_page && !drv.start_page( so ))
+            {
+                ret = FALSE;
+                break;
+            }
+            if (dev.banding && drv.start_banding && drv.next_band)
+            {
+                if (!drv.start_banding( so, &origin )) { ret = FALSE; break; }
+                while (origin.x != -1)
+                {
+                    render_page( &pages[i], so, &devinfo, origin );
+                    if (!drv.next_band( so, &origin )) { ret = FALSE; break; }
+                }
+            }
+            else
+            {
+                render_page( &pages[i], so, &devinfo, origin );
+                if (drv.send_page && !drv.send_page( so )) ret = FALSE;
+            }
+        }
+    }
+    if (drv.end_doc) drv.end_doc( so, ret ? 0 : ED_ABORTDOC );
+    EngUnlockSurface( so );
+    if (drv.disable_surface) drv.disable_surface( dev.dhpdev );
+
+done_pdev:
+    if (drv.disable_pdev) drv.disable_pdev( dev.dhpdev );
+    if (hport) EndDocPrinter( hport );
+done:
+    __wine_eng_register_device( &dev, FALSE );
+    if (drv.disable_driver) drv.disable_driver();
+    FreeLibrary( drv.module );
+    return ret;
+}
+
+static WCHAR *temp_file( const WCHAR *prefix )
+{
+    WCHAR dir[MAX_PATH], *name = malloc( MAX_PATH * sizeof(WCHAR) );
+    GetTempPathW( MAX_PATH, dir );
+    if (!GetTempFileNameW( dir, prefix, 0, name ))
+    {
+        free( name );
+        return NULL;
+    }
+    return name;
+}
+
+/* a 32-bit program printing through a 64-bit driver: our 64-bit host runs
+ * the driver on a copy of the job, and we send what it wrote */
+static BOOL render_in_host( const WCHAR *printer_name, DEVMODEW *devmode, const WCHAR *doc_name,
+                            const WCHAR *out_file, const WCHAR *spool_name, DWORD job_id, HANDLE hport )
+{
+    WCHAR *spool_copy = temp_file( L"spl" ), *dm_file = temp_file( L"sdm" ), *output = temp_file( L"sout" );
+    WCHAR host[MAX_PATH], *cmd = NULL;
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    HANDLE spool = NULL, file = INVALID_HANDLE_VALUE;
+    DOC_INFO_1W info;
+    DWORD r, w, code = 1;
+    BYTE buf[0x10000];
+    BOOL ret = FALSE;
+    size_t len;
+
+    if (!spool_copy || !dm_file || !output) goto done;
+
+    /* the job, as it is */
+    if (!OpenPrinterW( (WCHAR *)spool_name, &spool, NULL )) goto done;
+    file = CreateFileW( spool_copy, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) goto done;
+    while (ReadPrinter( spool, buf, sizeof(buf), &r ) && r)
+        if (!WriteFile( file, buf, r, &w, NULL ) || w != r) goto done;
+    CloseHandle( file );
+    file = CreateFileW( dm_file, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) goto done;
+    if (devmode) WriteFile( file, devmode, devmode->dmSize + devmode->dmDriverExtra, &w, NULL );
+    CloseHandle( file );
+    file = INVALID_HANDLE_VALUE;
+
+    GetWindowsDirectoryW( host, MAX_PATH );
+    lstrcatW( host, L"\\sysnative\\splwow64.exe" );
+    len = wcslen( host ) + wcslen( printer_name ) + wcslen( spool_copy ) + wcslen( dm_file ) + wcslen( output ) +
+          (doc_name ? wcslen( doc_name ) : 0) + 64;
+    cmd = malloc( len * sizeof(WCHAR) );
+    swprintf( cmd, len, L"\"%s\" render \"%s\" \"%s\" \"%s\" \"%s\" %lu \"%s\"", host, printer_name, spool_copy,
+              dm_file, output, job_id, doc_name ? doc_name : L"" );
+    TRACE( "%s\n", debugstr_w(cmd) );
+    if (!CreateProcessW( host, cmd, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi ))
+    {
+        ERR( "the 64-bit print host did not start: %lu\n", GetLastError() );
+        goto done;
+    }
+    WaitForSingleObject( pi.hProcess, INFINITE );
+    GetExitCodeProcess( pi.hProcess, &code );
+    CloseHandle( pi.hProcess );
+    CloseHandle( pi.hThread );
+    if (code)
+    {
+        ERR( "the 64-bit print host failed (%lu)\n", code );
+        goto done;
+    }
+
+    /* what the driver wrote goes to the port */
+    file = CreateFileW( output, GENERIC_READ, 0, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) goto done;
+    info.pDocName = (WCHAR *)doc_name;
+    info.pOutputFile = (WCHAR *)out_file;
+    info.pDatatype = (WCHAR *)L"RAW";
+    if (!StartDocPrinterW( hport, 1, (BYTE *)&info )) goto done;
+    ret = TRUE;
+    while (ReadFile( file, buf, sizeof(buf), &r, NULL ) && r)
+        if (!WritePrinter( hport, buf, r, &w ) || w != r) { ret = FALSE; break; }
+    EndDocPrinter( hport );
+
+done:
+    if (file != INVALID_HANDLE_VALUE) CloseHandle( file );
+    if (spool) ClosePrinter( spool );
+    if (spool_copy) { DeleteFileW( spool_copy ); free( spool_copy ); }
+    if (dm_file) { DeleteFileW( dm_file ); free( dm_file ); }
+    if (output) { DeleteFileW( output ); free( output ); }
+    free( cmd );
+    return ret;
+}
+
+BOOL print_emf_job( HANDLE hport, const WCHAR *printer_name, DEVMODEW *job_devmode, const WCHAR *doc_name,
+                    const WCHAR *out_file, const WCHAR *spool_name, DWORD job_id )
+{
+    struct spool_reader reader = { NULL, FALSE };
+    struct spool_page *pages;
+    unsigned int page_count, dm_count, i;
+    DEVMODEW **devmodes;
+    HANDLE printer;
+    BOOL ret = FALSE;
+
+    TRACE( "%s %s\n", debugstr_w(printer_name), debugstr_w(spool_name) );
+
+    if (!OpenPrinterW( (WCHAR *)spool_name, &reader.handle, NULL )) return FALSE;
+    pages = read_spool( &reader, &page_count, &devmodes, &dm_count );
+    ClosePrinter( reader.handle );
+    TRACE( "%u pages\n", page_count );
+
+    if (OpenPrinterW( (WCHAR *)printer_name, &printer, NULL ))
+    {
+        ret = render_job( printer, printer_name, job_devmode, doc_name, out_file, job_id, pages, page_count,
+                          hport, NULL );
+        if (!ret && GetLastError() == ERROR_BAD_EXE_FORMAT)
+        {
+            BOOL wow64 = FALSE;
+#ifndef SG_MUTANT_WOWHOST
+            if (IsWow64Process( GetCurrentProcess(), &wow64 ) && wow64)
+#else
+            if (FALSE)
+#endif
+                ret = render_in_host( printer_name, page_count && pages[0].devmode ? pages[0].devmode : job_devmode,
+                                      doc_name, out_file, spool_name, job_id, hport );
+            else ERR( "the printer driver of %s does not load\n", debugstr_w(printer_name) );
+        }
+        ClosePrinter( printer );
+    }
+    free_pages( pages, page_count );
+    for (i = 0; i < dm_count; i++) free( devmodes[i] );
+    free( devmodes );
+    return ret;
+}
+
+/***********************************************************************
+ *           __wine_render_spool_file    (WINPRINT.@)
+ *
+ * Our 64-bit print host runs a 32-bit program's job through the printer's
+ * 64-bit driver: the job's data is in spool_file, the output goes to out_file.
+ */
+BOOL WINAPI __wine_render_spool_file( const WCHAR *printer_name, const WCHAR *spool_file, const WCHAR *dm_file,
+                                      const WCHAR *out_file, const WCHAR *doc_name, DWORD job_id )
+{
+    struct spool_reader reader = { NULL, TRUE };
+    struct spool_page *pages;
+    unsigned int page_count, dm_count, i;
+    DEVMODEW **devmodes, *devmode = NULL;
+    HANDLE printer, out, file;
+    DWORD size;
+    BOOL ret = FALSE;
+
+    reader.handle = CreateFileW( spool_file, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (reader.handle == INVALID_HANDLE_VALUE) return FALSE;
+    pages = read_spool( &reader, &page_count, &devmodes, &dm_count );
+    CloseHandle( reader.handle );
+
+    file = CreateFileW( dm_file, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        size = GetFileSize( file, NULL );
+        if (size >= FIELD_OFFSET(DEVMODEW, dmFields) && (devmode = malloc( size )) &&
+            (!ReadFile( file, devmode, size, &size, NULL ) || devmode->dmSize + devmode->dmDriverExtra > size))
+        {
+            free( devmode );
+            devmode = NULL;
+        }
+        CloseHandle( file );
+    }
+
+    out = CreateFileW( out_file, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    if (out != INVALID_HANDLE_VALUE && OpenPrinterW( (WCHAR *)printer_name, &printer, NULL ))
+    {
+        ret = render_job( printer, printer_name, devmode, doc_name, NULL, job_id, pages, page_count, NULL, out );
+        ClosePrinter( printer );
+    }
+    if (out != INVALID_HANDLE_VALUE) CloseHandle( out );
+    free_pages( pages, page_count );
+    for (i = 0; i < dm_count; i++) free( devmodes[i] );
+    free( devmodes );
+    free( devmode );
+    return ret;
+}
