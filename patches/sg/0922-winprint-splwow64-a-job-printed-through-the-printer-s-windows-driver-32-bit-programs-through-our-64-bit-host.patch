+/*
+ * Printer drivers are 64-bit on a 64-bit system; a 32-bit program cannot
+ * load them.  Its printing runs them here instead:
+ *
+ *   splwow64 render PRINTER SPOOLFILE DEVMODEFILE OUTFILE JOBID DOCNAME
+ *       runs a job's pages through the printer's driver into OUTFILE;
+ *   splwow64 caps PRINTER DEVMODEFILE OUTFILE
+ *       writes what the driver says the device measures.
+ *
+ * It also serves Linux programs printing to a Windows driver's CUPS queue
+ * (the sgwindrv backend):
+ *   splwow64 drivers              (SYSTEM) readies every printer's driver and
+ *                                 installs the makers' staged packages
+ *   splwow64 list [OUTFILE]       the printers that have a Windows driver
+ *   splwow64 ppd PRINTER OUTFILE  a PPD from the driver's capabilities
+ *   splwow64 print PRINTER PAPER COPIES TITLE PAGE.ppm...
+ *       prints page images (whole sheets) through the driver
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winspool.h"
+#include "winerror.h"
+#include "ddk/winddi.h"
+#include "wine/printdrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(splwow64);
+
+static DEVMODEW *read_devmode( const WCHAR *path )
+{
+    HANDLE file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    DEVMODEW *dm = NULL;
+    DWORD size;
+
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    size = GetFileSize( file, NULL );
+    if (size >= FIELD_OFFSET(DEVMODEW, dmFields) && (dm = malloc( size )) &&
+        (!ReadFile( file, dm, size, &size, NULL ) || dm->dmSize + dm->dmDriverExtra > size))
+    {
+        free( dm );
+        dm = NULL;
+    }
+    CloseHandle( file );
+    return dm;
+}
+
+static int caps( const WCHAR *name, const WCHAR *dm_file, const WCHAR *out_file )
+{
+    BOOL (WINAPI *enable_driver)( ULONG, ULONG, DRVENABLEDATA * );
+    DHPDEV (WINAPI *enable_pdev)( DEVMODEW *, WCHAR *, ULONG, HSURF *, ULONG, ULONG *, ULONG, DEVINFO *,
+                                  HDEV, WCHAR *, HANDLE ) = NULL;
+    void (WINAPI *disable_pdev)( DHPDEV ) = NULL;
+    struct wine_eng_device dev;
+    DRIVER_INFO_3W *info;
+    DRVENABLEDATA ded;
+    DEVMODEW *dm = read_devmode( dm_file );
+    HMODULE module;
+    HANDLE printer;
+    GDIINFO gi;
+    DEVINFO di;
+    DWORD needed = 0, i;
+    DHPDEV dhpdev;
+    FILE *out;
+
+    if (!OpenPrinterW( (WCHAR *)name, &printer, NULL )) return 1;
+    GetPrinterDriverW( printer, NULL, 3, NULL, 0, &needed );
+    if (!needed || !(info = malloc( needed )) || !GetPrinterDriverW( printer, NULL, 3, (BYTE *)info, needed, &needed ))
+        return 1;
+    if (!(module = LoadLibraryW( info->pDriverPath ))) return 1;
+    enable_driver = (void *)GetProcAddress( module, "DrvEnableDriver" );
+    memset( &ded, 0, sizeof(ded) );
+    if (!enable_driver || !enable_driver( DDI_DRIVER_VERSION_NT5_01, sizeof(ded), &ded )) return 1;
+    for (i = 0; i < ded.c; i++)
+    {
+        if (ded.pdrvfn[i].iFunc == INDEX_DrvEnablePDEV) enable_pdev = (void *)ded.pdrvfn[i].pfn;
+        if (ded.pdrvfn[i].iFunc == INDEX_DrvDisablePDEV) disable_pdev = (void *)ded.pdrvfn[i].pfn;
+    }
+    if (!enable_pdev) return 1;
+    memset( &dev, 0, sizeof(dev) );
+    dev.magic = WINE_ENG_DEVICE_MAGIC;
+    dev.printer = printer;
+    memset( &gi, 0, sizeof(gi) );
+    memset( &di, 0, sizeof(di) );
+    if (!(dhpdev = enable_pdev( dm, (WCHAR *)name, 0, NULL, sizeof(gi), (ULONG *)&gi, sizeof(di), &di, (HDEV)&dev,
+                                (WCHAR *)name, printer )))
+        return 1;
+    if (!(out = _wfopen( out_file, L"w" ))) return 1;
+    fprintf( out, "%ld %ld %lu %lu %lu %lu %ld %ld %ld %ld %lu %lu %lu %lu %lu %lu %lu\n",
+             (LONG)gi.ulHorzSize, (LONG)gi.ulVertSize, gi.ulHorzRes, gi.ulVertRes, gi.ulLogPixelsX,
+             gi.ulLogPixelsY, gi.szlPhysSize.cx, gi.szlPhysSize.cy, gi.ptlPhysOffset.x, gi.ptlPhysOffset.y,
+             gi.cBitsPixel * gi.cPlanes, gi.ulNumColors, gi.flTextCaps, gi.flRaster, gi.ulAspectX,
+             gi.ulAspectY, gi.ulAspectXY );
+    fclose( out );
+    if (disable_pdev) disable_pdev( dhpdev );
+    ClosePrinter( printer );
+    return 0;
+}
+
+
+/* ---- printing from Linux programs (the CUPS backend's side) ---- */
+
+static void ppd_string( FILE *out, const WCHAR *str )
+{
+    char buf[256];
+    WideCharToMultiByte( CP_UTF8, 0, str, -1, buf, sizeof(buf), NULL, NULL );
+    for (char *p = buf; *p; p++) if (*p == '"' || *p == '/' || *p == ':' || *p < ' ') *p = ' ';
+    fputs( buf, out );
+}
+
+/* a PPD for CUPS from what the Windows driver offers: its papers (with the
+ * printable area of each), resolutions and colour */
+static int make_ppd( const WCHAR *name, const WCHAR *out_file )
+{
+    int count = DeviceCapabilitiesW( name, NULL, DC_PAPERS, NULL, NULL ), i, def = 0;
+    LONG size = DocumentPropertiesW( NULL, NULL, (WCHAR *)name, NULL, NULL, 0 );
+    WORD *ids;
+    POINT *sizes;
+    WCHAR *names;
+    DEVMODEW *dm;
+    FILE *out;
+
+    if (count <= 0 || size <= 0) return 1;
+    ids = calloc( count, sizeof(*ids) );
+    sizes = calloc( count, sizeof(*sizes) );
+    names = calloc( count, 64 * sizeof(WCHAR) );
+    dm = calloc( 1, size );
+    DeviceCapabilitiesW( name, NULL, DC_PAPERS, (WCHAR *)ids, NULL );
+    DeviceCapabilitiesW( name, NULL, DC_PAPERSIZE, (WCHAR *)sizes, NULL );
+    DeviceCapabilitiesW( name, NULL, DC_PAPERNAMES, names, NULL );
+    DocumentPropertiesW( NULL, NULL, (WCHAR *)name, dm, NULL, DM_OUT_BUFFER );
+    for (i = 0; i < count; i++) if (ids[i] == dm->dmPaperSize) def = i;
+
+    if (!(out = _wfopen( out_file, L"w" ))) return 1;
+    fprintf( out, "*PPD-Adobe: \"4.3\"\n*FormatVersion: \"4.3\"\n*FileVersion: \"1.0\"\n*LanguageVersion: English\n"
+             "*LanguageEncoding: ISOLatin1\n*PCFileName: \"SGWINDRV.PPD\"\n*Manufacturer: \"Stained Glass OS\"\n" );
+    fputs( "*ModelName: \"", out ); ppd_string( out, name ); fputs( " (maker's driver)\"\n", out );
+    fputs( "*NickName: \"", out ); ppd_string( out, name ); fputs( " (maker's driver)\"\n", out );
+    fputs( "*ShortNickName: \"", out ); ppd_string( out, name ); fputs( "\"\n", out );
+    fprintf( out, "*PSVersion: \"(3010.000) 0\"\n*LanguageLevel: \"3\"\n*ColorDevice: %s\n*DefaultColorSpace: %s\n"
+             "*FileSystem: False\n*Throughput: \"1\"\n*LandscapeOrientation: Plus90\n*TTRasterizer: Type42\n",
+             DeviceCapabilitiesW( name, NULL, DC_COLORDEVICE, NULL, NULL ) == 1 ? "True" : "False",
+             DeviceCapabilitiesW( name, NULL, DC_COLORDEVICE, NULL, NULL ) == 1 ? "RGB" : "Gray" );
+    /* the job reaches our backend as PDF, untouched by CUPS' filters */
+    fprintf( out, "*cupsFilter2: \"application/pdf application/vnd.cups-pdf 0 -\"\n" );
+    fprintf( out, "*OpenUI *PageSize/Media Size: PickOne\n*OrderDependency: 10 AnySetup *PageSize\n"
+             "*DefaultPageSize: P%u\n", ids[def] );
+    for (i = 0; i < count; i++)
+    {
+        if (!sizes[i].x || !sizes[i].y) continue;
+        fprintf( out, "*PageSize P%u/", ids[i] ); ppd_string( out, names + i * 64 );
+        fprintf( out, ": \"<</PageSize[%.2f %.2f]/ImagingBBox null>>setpagedevice\"\n",
+                 sizes[i].x * 72.0 / 254, sizes[i].y * 72.0 / 254 );
+    }
+    fprintf( out, "*CloseUI: *PageSize\n*OpenUI *PageRegion: PickOne\n*OrderDependency: 10 AnySetup *PageRegion\n"
+             "*DefaultPageRegion: P%u\n", ids[def] );
+    for (i = 0; i < count; i++)
+    {
+        if (!sizes[i].x || !sizes[i].y) continue;
+        fprintf( out, "*PageRegion P%u/", ids[i] ); ppd_string( out, names + i * 64 );
+        fprintf( out, ": \"<</PageSize[%.2f %.2f]/ImagingBBox null>>setpagedevice\"\n",
+                 sizes[i].x * 72.0 / 254, sizes[i].y * 72.0 / 254 );
+    }
+    fprintf( out, "*CloseUI: *PageRegion\n*DefaultImageableArea: P%u\n", ids[def] );
+    for (i = 0; i < count; i++)
+    {
+        HDC hdc;
+        double l = 0, b = 0, r = sizes[i].x * 72.0 / 254, t = sizes[i].y * 72.0 / 254;
+
+        if (!sizes[i].x || !sizes[i].y) continue;
+        dm->dmFields = (dm->dmFields & ~DM_FORMNAME) | DM_PAPERSIZE;
+        dm->dmPaperSize = ids[i];
+        if ((hdc = CreateICW( NULL, name, NULL, dm )))
+        {
+            /* the printable area, in points from the sheet's lower left */
+            double dx = GetDeviceCaps( hdc, LOGPIXELSX ), dy = GetDeviceCaps( hdc, LOGPIXELSY );
+            double ph = GetDeviceCaps( hdc, PHYSICALHEIGHT );
+            l = GetDeviceCaps( hdc, PHYSICALOFFSETX ) * 72.0 / dx;
+            r = l + GetDeviceCaps( hdc, HORZRES ) * 72.0 / dx;
+            t = (ph - GetDeviceCaps( hdc, PHYSICALOFFSETY )) * 72.0 / dy;
+            b = t - GetDeviceCaps( hdc, VERTRES ) * 72.0 / dy;
+            DeleteDC( hdc );
+        }
+        fprintf( out, "*ImageableArea P%u: \"%.2f %.2f %.2f %.2f\"\n", ids[i], l, b, r, t );
+    }
+    fprintf( out, "*DefaultPaperDimension: P%u\n", ids[def] );
+    for (i = 0; i < count; i++)
+        if (sizes[i].x && sizes[i].y)
+            fprintf( out, "*PaperDimension P%u: \"%.2f %.2f\"\n", ids[i], sizes[i].x * 72.0 / 254,
+                     sizes[i].y * 72.0 / 254 );
+    count = DeviceCapabilitiesW( name, NULL, DC_ENUMRESOLUTIONS, NULL, NULL );
+    if (count > 0)
+    {
+        LONG *res = calloc( count, 2 * sizeof(LONG) );
+        DeviceCapabilitiesW( name, NULL, DC_ENUMRESOLUTIONS, (WCHAR *)res, NULL );
+        fprintf( out, "*OpenUI *Resolution/Resolution: PickOne\n*OrderDependency: 20 AnySetup *Resolution\n"
+                 "*DefaultResolution: %ldx%lddpi\n", res[0], res[1] );
+        for (i = 0; i < count; i++)
+            fprintf( out, "*Resolution %ldx%lddpi: \"\"\n", res[i * 2], res[i * 2 + 1] );
+        fprintf( out, "*CloseUI: *Resolution\n" );
+    }
+    fprintf( out, "*DefaultFont: Courier\n*Font Courier: Standard \"(002.004S)\" Standard ROM\n" );
+    fclose( out );
+    return 0;
+}
+
+/* reads a binary PPM (P6) page */
+static BYTE *read_ppm( const WCHAR *path, int *w, int *h )
+{
+    FILE *f = _wfopen( path, L"rb" );
+    int max, c;
+    BYTE *rgb;
+
+    if (!f) return NULL;
+    if (fscanf( f, "P6 %d %d %d", w, h, &max ) != 3 || *w <= 0 || *h <= 0 || max != 255)
+    {
+        fclose( f );
+        return NULL;
+    }
+    c = fgetc( f );  /* the one blank after the header */
+    (void)c;
+    rgb = malloc( (size_t)*w * *h * 3 );
+    if (fread( rgb, 3, (size_t)*w * *h, f ) != (size_t)*w * *h)
+    {
+        free( rgb );
+        rgb = NULL;
+    }
+    fclose( f );
+    return rgb;
+}
+
+/* prints page images (the PDF a Linux program sent, rendered by the backend
+ * at the printer's resolution) through the Windows driver */
+static int print_pages( const WCHAR *name, const WCHAR *paper, const WCHAR *copies, const WCHAR *title,
+                        int count, WCHAR **files )
+{
+    LONG size = DocumentPropertiesW( NULL, NULL, (WCHAR *)name, NULL, NULL, 0 );
+    DOCINFOW doc = { sizeof(doc) };
+    DEVMODEW *dm = NULL;
+    int i, ret = 0;
+    HDC hdc;
+
+    if (size > 0)
+    {
+        dm = calloc( 1, size );
+        DocumentPropertiesW( NULL, NULL, (WCHAR *)name, dm, NULL, DM_OUT_BUFFER );
+        if (paper && paper[0] == 'P' && iswdigit( paper[1] ))
+        {
+            dm->dmFields = (dm->dmFields & ~DM_FORMNAME) | DM_PAPERSIZE;
+            dm->dmPaperSize = wcstoul( paper + 1, NULL, 10 );
+        }
+        dm->dmFields |= DM_COPIES;
+        dm->dmCopies = max( 1, wcstoul( copies, NULL, 10 ) );
+        DocumentPropertiesW( NULL, NULL, (WCHAR *)name, dm, dm, DM_IN_BUFFER | DM_OUT_BUFFER );
+    }
+    if (!(hdc = CreateDCW( NULL, name, NULL, dm ))) return 1;
+    doc.lpszDocName = title && title[0] ? title : L"Linux print job";
+    if (StartDocW( hdc, &doc ) <= 0)
+    {
+        DeleteDC( hdc );
+        return 1;
+    }
+    for (i = 0; i < count; i++)
+    {
+        BITMAPINFO bmi = { { sizeof(BITMAPINFOHEADER) } };
+        int w, h, x, y;
+        BYTE *rgb = read_ppm( files[i], &w, &h ), *bgr;
+
+        if (!rgb) { ret = 1; continue; }
+        /* rows to the bottom-up BGR a DIB is */
+        bgr = malloc( (size_t)((w * 3 + 3) & ~3) * h );
+        for (y = 0; y < h; y++)
+        {
+            BYTE *dst = bgr + (size_t)(h - 1 - y) * ((w * 3 + 3) & ~3), *src = rgb + (size_t)y * w * 3;
+            for (x = 0; x < w; x++) { dst[x * 3] = src[x * 3 + 2]; dst[x * 3 + 1] = src[x * 3 + 1]; dst[x * 3 + 2] = src[x * 3]; }
+        }
+        bmi.bmiHeader.biWidth = w;
+        bmi.bmiHeader.biHeight = h;
+        bmi.bmiHeader.biPlanes = 1;
+        bmi.bmiHeader.biBitCount = 24;
+        bmi.bmiHeader.biCompression = BI_RGB;
+        StartPage( hdc );
+        /* the image is the whole sheet; the DC's origin is the printable area's */
+        SetStretchBltMode( hdc, COLORONCOLOR );
+#ifdef SG_MUTANT_HOSTPRINT
+        StretchDIBits( hdc, 0, 0,
+#else
+        StretchDIBits( hdc, -GetDeviceCaps( hdc, PHYSICALOFFSETX ), -GetDeviceCaps( hdc, PHYSICALOFFSETY ),
+#endif
+                       GetDeviceCaps( hdc, PHYSICALWIDTH ), GetDeviceCaps( hdc, PHYSICALHEIGHT ), 0, 0, w, h, bgr,
+                       &bmi, DIB_RGB_COLORS, SRCCOPY );
+        EndPage( hdc );
+        free( bgr );
+        free( rgb );
+    }
+    if (EndDoc( hdc ) <= 0) ret = 1;
+    DeleteDC( hdc );
+    free( dm );
+    return ret;
+}
+
+/* the printers that print through a Windows driver, for the CUPS side:
+ * "name<TAB>driver" per line */
+static int list_printers( const WCHAR *out_file )
+{
+    DWORD needed = 0, count = 0, i;
+    PRINTER_INFO_2W *pi;
+    FILE *out = out_file ? _wfopen( out_file, L"w" ) : stdout;
+
+    if (!out) return 1;
+    EnumPrintersW( PRINTER_ENUM_LOCAL, NULL, 2, NULL, 0, &needed, &count );
+    pi = malloc( needed ? needed : 1 );
+    if (!EnumPrintersW( PRINTER_ENUM_LOCAL, NULL, 2, (BYTE *)pi, needed, &needed, &count )) count = 0;
+    for (i = 0; i < count; i++)
+    {
+        HANDLE printer;
+        DRIVER_INFO_3W *info;
+        const WCHAR *base;
+        DWORD size = 0;
+
+        if (!OpenPrinterW( pi[i].pPrinterName, &printer, NULL )) continue;
+        GetPrinterDriverW( printer, NULL, 3, NULL, 0, &size );
+        if (size && (info = malloc( size )) && GetPrinterDriverW( printer, NULL, 3, (BYTE *)info, size, &size ))
+        {
+            base = wcsrchr( info->pDriverPath, '\\' );
+            base = base ? base + 1 : info->pDriverPath;
+            if (wcsicmp( base, L"wineps.drv" ))
+            {
+                char n[512], d[512];
+                WideCharToMultiByte( CP_UTF8, 0, pi[i].pPrinterName, -1, n, sizeof(n), NULL, NULL );
+                WideCharToMultiByte( CP_UTF8, 0, pi[i].pDriverName, -1, d, sizeof(d), NULL, NULL );
+                fprintf( out, "%s\t%s\n", n, d );
+            }
+            free( info );
+        }
+        ClosePrinter( printer );
+    }
+    if (out_file) fclose( out );
+    return 0;
+}
+
+/* run as SYSTEM, point-and-print style: every printer's driver is made
+ * ready for every user, and a printer whose model has a maker's package in
+ * the driver store gets its Windows driver (the package was staged by the
+ * maker's installer; a standard user's programs never install drivers) */
+static int install_drivers( void )
+{
+    DWORD needed = 0, count = 0, i;
+    PRINTER_INFO_2W *pi;
+
+    EnumPrintersW( PRINTER_ENUM_LOCAL, NULL, 2, NULL, 0, &needed, &count );
+    pi = malloc( needed ? needed : 1 );
+    if (!EnumPrintersW( PRINTER_ENUM_LOCAL, NULL, 2, (BYTE *)pi, needed, &needed, &count )) count = 0;
+    for (i = 0; i < count; i++)
+    {
+        HANDLE printer;
+        PRINTER_INFO_2W *info;
+        DWORD size = 0;
+
+        /* opened here, a printer's driver is brought up to date as SYSTEM
+         * (its PostScript driver from the queue's PPD), which a standard
+         * user may not do: every user then finds it ready */
+        if (OpenPrinterW( pi[i].pPrinterName, &printer, NULL )) ClosePrinter( printer );
+        if (!wcsicmp( pi[i].pPrintProcessor, L"winprint" )) continue;  /* has its Windows driver */
+        if (FAILED(InstallPrinterDriverFromPackageW( NULL, NULL, pi[i].pDriverName, NULL, 0 ))) continue;
+        WINE_TRACE( "%s: the maker's driver %s installed\n", debugstr_w(pi[i].pPrinterName), debugstr_w(pi[i].pDriverName) );
+        if (!OpenPrinterW( pi[i].pPrinterName, &printer, NULL )) continue;
+        GetPrinterW( printer, 2, NULL, 0, &size );
+        if (size && (info = malloc( size )) && GetPrinterW( printer, 2, (BYTE *)info, size, &size ))
+        {
+            info->pPrintProcessor = (WCHAR *)L"winprint";
+            info->pDevMode = NULL;
+            SetPrinterW( printer, 2, (BYTE *)info, 0 );
+            free( info );
+        }
+        ClosePrinter( printer );
+        printf( "%ls\n", pi[i].pPrinterName );
+    }
+    return 0;
+}
+
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    BOOL (WINAPI *render)( const WCHAR *, const WCHAR *, const WCHAR *, const WCHAR *, const WCHAR *, DWORD );
+    HMODULE winprint;
+
+    if (argc >= 8 && !wcscmp( argv[1], L"render" ))
+    {
+        WCHAR path[MAX_PATH];
+        DWORD size;
+
+        /* the print processor lives in its own directory */
+        if (!GetPrintProcessorDirectoryW( NULL, NULL, 1, (BYTE *)path, sizeof(path) - 32, &size ))
+            path[0] = 0;
+        lstrcatW( path, L"\\winprint.dll" );
+        if (!(winprint = LoadLibraryW( path )) && !(winprint = LoadLibraryW( L"winprint.dll" ))) return 2;
+        if (!(render = (void *)GetProcAddress( winprint, "__wine_render_spool_file" ))) return 2;
+        TRACE( "render %s\n", debugstr_w(argv[2]) );
+        return render( argv[2], argv[3], argv[4], argv[5], argv[7], wcstoul( argv[6], NULL, 10 ) ) ? 0 : 1;
+    }
+    if (argc >= 5 && !wcscmp( argv[1], L"caps" )) return caps( argv[2], argv[3], argv[4] );
+    if (argc >= 4 && !wcscmp( argv[1], L"ppd" )) return make_ppd( argv[2], argv[3] );
+    if (argc >= 7 && !wcscmp( argv[1], L"print" )) return print_pages( argv[2], argv[3], argv[4], argv[5], argc - 6, argv + 6 );
+    if (argc >= 2 && !wcscmp( argv[1], L"drivers" )) return install_drivers();
+    if (argc >= 2 && !wcscmp( argv[1], L"list" )) return list_printers( argc > 2 ? argv[2] : NULL );
+    WINE_MESSAGE( "usage: splwow64 render PRINTER SPOOLFILE DEVMODEFILE OUTFILE JOBID DOCNAME\n"
+                  "       splwow64 caps PRINTER DEVMODEFILE OUTFILE\n"
+                  "       splwow64 drivers\n"
+                  "       splwow64 list [OUTFILE]\n"
+                  "       splwow64 ppd PRINTER OUTFILE\n"
+                  "       splwow64 print PRINTER PAPER COPIES TITLE PAGE.ppm...\n" );
+    return 2;
+}
