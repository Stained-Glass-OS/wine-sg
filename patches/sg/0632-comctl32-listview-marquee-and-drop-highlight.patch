From: Stained Glass OS <ke7oxh@gmail.com>
Subject: comctl32: the list view's rubber band, drag and drop highlight as on Windows

The rubber band that selects items on a list view's empty space was a
dotted focus rectangle; Windows draws it in the selection colour,
translucent, in a solid frame. An item with LVIS_DROPHILITED (the folder a
drag would drop into) was not drawn differently; it is drawn highlighted.
A press on an item did not capture the mouse, so an item dragged quickly out
of the view (onto the desktop, into another window) was never dragged: the
list view no longer saw the mouse move. It is captured until the button
goes up, as Windows' list view watches for a drag.

Gate: make test-drag.
--- a/dlls/comctl32/listview.c
+++ b/dlls/comctl32/listview.c
@@ -4135,6 +4135,35 @@
 #define SCROLL_UP     0x4
 #define SCROLL_DOWN   0x8
 
+/* Stained Glass: the rubber band as Windows draws it -- the selection colour,
+ * translucent, in a solid frame -- not a dotted focus rectangle */
+static void LISTVIEW_DrawMarquee(HDC hdc, const RECT *rect)
+{
+    BITMAPINFO bi = {{ sizeof(bi.bmiHeader), 1, 1, 1, 32, BI_RGB }};
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 0x50, 0 };
+    COLORREF color = comctl32_color.clrHighlight;
+    HBITMAP bmp;
+    HBRUSH frame;
+    DWORD *px;
+    HDC mem;
+
+    if (rect->right <= rect->left || rect->bottom <= rect->top) return;
+    mem = CreateCompatibleDC(hdc);
+    if ((bmp = CreateDIBSection(hdc, &bi, DIB_RGB_COLORS, (void **)&px, NULL, 0)))
+    {
+        HGDIOBJ old = SelectObject(mem, bmp);
+        *px = (GetRValue(color) << 16) | (GetGValue(color) << 8) | GetBValue(color);
+        GdiAlphaBlend(hdc, rect->left, rect->top, rect->right - rect->left, rect->bottom - rect->top,
+                      mem, 0, 0, 1, 1, blend);
+        SelectObject(mem, old);
+        DeleteObject(bmp);
+    }
+    DeleteDC(mem);
+    frame = CreateSolidBrush(color);
+    FrameRect(hdc, rect, frame);
+    DeleteObject(frame);
+}
+
 /***
  * DESCRIPTION:
  * Utility routine to draw and highlight items within a marquee selection rectangle.
@@ -5524,7 +5553,7 @@
     /* get information needed for drawing the item */
     lvItem.mask = LVIF_TEXT | LVIF_IMAGE | LVIF_PARAM | LVIF_STATE;
     if (infoPtr->uView == LV_VIEW_DETAILS) lvItem.mask |= LVIF_INDENT;
-    lvItem.stateMask = LVIS_SELECTED | LVIS_FOCUSED | LVIS_STATEIMAGEMASK | LVIS_CUT | LVIS_OVERLAYMASK;
+    lvItem.stateMask = LVIS_SELECTED | LVIS_FOCUSED | LVIS_STATEIMAGEMASK | LVIS_CUT | LVIS_OVERLAYMASK | LVIS_DROPHILITED;
     lvItem.iItem = nItem;
     lvItem.iSubItem = 0;
     lvItem.state = 0;
@@ -5533,6 +5562,9 @@
     lvItem.pszText = szDispText;
     if (!LISTVIEW_GetItemW(infoPtr, &lvItem)) return FALSE;
     if (lvItem.pszText == LPSTR_TEXTCALLBACKW) lvItem.pszText = callbackW;
+    /* Stained Glass: the item a drag is over (a folder that takes the drop) is
+     * drawn highlighted */
+    if (lvItem.state & LVIS_DROPHILITED) lvItem.state |= LVIS_SELECTED;
     TRACE("   lvItem=%s\n", debuglvitem_t(&lvItem, TRUE));
 
     /* now check if we need to update the focus rectangle */
@@ -6137,7 +6169,7 @@
 
     /* Draw marquee rectangle if appropriate */
     if (infoPtr->bMarqueeSelect)
-        DrawFocusRect(hdc, &infoPtr->marqueeDrawRect);
+        LISTVIEW_DrawMarquee(hdc, &infoPtr->marqueeDrawRect);
 
     if (cdmode & CDRF_NOTIFYPOSTPAINT)
 	notify_postpaint(infoPtr, &nmlvcd);
@@ -11352,6 +11384,11 @@
 
     if (infoPtr->dwLvExStyle & LVS_EX_ONECLICKACTIVATE)
         if(lvHitTestInfo.iItem != -1) notify_itemactivate(infoPtr,&lvHitTestInfo);
+
+    /* Stained Glass: the mouse is ours until the button goes up, as Windows'
+     * list view watches for a drag: an item dragged quickly out of the view
+     * (onto the desktop, another window) was not dragged at all */
+    SetCapture(infoPtr->hwndSelf);
   }
   else
   {
@@ -11387,6 +11424,8 @@
 
     if (!infoPtr->bLButtonDown) return 0;
 
+    if (!infoPtr->bMarqueeSelect && GetCapture() == infoPtr->hwndSelf) ReleaseCapture();
+
     lvHitTestInfo.pt.x = x;
     lvHitTestInfo.pt.y = y;
 
