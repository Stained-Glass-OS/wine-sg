From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: a font that names no Windows code page gets those of its Unicode ranges

A TrueType font whose OS/2 table has an empty ulCodePageRange1 (Noto Kufi Arabic on Debian: only the Arabic Unicode range bit and ulCodePageRange2's ASMO 708 bit) had no character set at all: EnumFontFamiliesEx listed it as OEM_CHARSET (an empty fsCsb[0] is Wine's mark for an OEM bitmap font), so Qt programs, which create each family with its enumerated charset, asked for OEM_CHARSET ('Untranslated charset 255', 7 apps in the 2026-11-21 census), an ARABIC_CHARSET request picked another font, its ANSI text had no code page, and select_font logged 'returning DEFAULT_CHARSET' (5 Store apps in the 2026-11-21 census). opentype_get_properties now gives such a face the code pages of the scripts its Unicode ranges name (Latin-1, Latin Extended-A, Greek, Cyrillic, Hebrew, Arabic, Thai, Katakana, Hangul, CJK ideographs), and Latin 1 when it names none -- the rule the version 0 OS/2 table and the FreeType loader's Unicode cmap already follow. Sonic Visualiser (a census app) starts with neither FIXME now.
---
--- a/dlls/win32u/opentype.c
+++ b/dlls/win32u/opentype.c
@@ -723,6 +723,39 @@
     return FALSE;
 }
 
+/* wine-sg 9500: an OS/2 table that names no Windows code page (ulCodePageRange1 empty -- Noto Kufi
+ * Arabic ships so, with only the Arabic Unicode range and ulCodePageRange2's ASMO 708 bit) leaves the face
+ * with no character set: it is not enumerated, no charset request picks it, and its ANSI text has no code
+ * page. The code pages are then those of the scripts its Unicode ranges name, as a font tool fills an
+ * empty ulCodePageRange from the coverage; a face that names none of them is Latin 1, the same as a
+ * version 0 OS/2 table and the FreeType loader's rule for a Unicode cmap. */
+static DWORD codepages_from_unicode_ranges( const DWORD *usb )
+{
+    static const struct { BYTE bit; DWORD fs; } scripts[] =
+    {
+        {  1, FS_LATIN1 },      /* Latin-1 Supplement */
+        {  2, FS_LATIN2 },      /* Latin Extended-A */
+        {  7, FS_GREEK },
+        {  9, FS_CYRILLIC },
+        { 11, FS_HEBREW },
+        { 13, FS_ARABIC },
+        { 24, FS_THAI },
+        { 49, FS_JISJAPAN },    /* Katakana */
+        { 56, FS_WANSUNG },     /* Hangul syllables */
+    };
+    DWORD fs = 0;
+    unsigned int i;
+
+#ifndef SG_MUTANT_NO_USB_CHARSETS
+    for (i = 0; i < ARRAY_SIZE(scripts); i++)
+        if (usb[scripts[i].bit / 32] & (1u << (scripts[i].bit % 32))) fs |= scripts[i].fs;
+    /* CJK ideographs with neither kana nor Hangul: Chinese */
+    if (!(fs & (FS_JISJAPAN | FS_WANSUNG)) && (usb[1] & (1u << (59 - 32))))
+        fs |= FS_CHINESESIMP | FS_CHINESETRAD;
+#endif
+    return fs ? fs : FS_LATIN1;
+}
+
 BOOL opentype_get_properties( const void *data, size_t size, const struct ttc_sfnt_v1 *ttc_sfnt_v1,
                               DWORD *version, FONTSIGNATURE *fs, DWORD *ntm_flags, UINT *weight )
 {
@@ -754,6 +787,7 @@
     {
         fs->fsCsb[0] = GET_BE_DWORD( tt_os2_v1->ulCodePageRange1 );
         fs->fsCsb[1] = GET_BE_DWORD( tt_os2_v1->ulCodePageRange2 );
+        if (!fs->fsCsb[0]) fs->fsCsb[0] = codepages_from_unicode_ranges( fs->fsUsb );
     }
 
     selection = GET_BE_WORD( tt_os2_v1->fsSelection );
