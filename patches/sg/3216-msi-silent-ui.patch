From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 03:08:09 -0700
Subject: [PATCH] msi: no authored dialogs below the reduced UI level, Cancel
 disable applied at window creation (3216)

CORE review of 3215. INSTALLMESSAGE_SHOWDIALOG no longer shows a dialog at
NONE/BASIC/DEFAULT, COMMONDATA's Cancel-disable reaches the next dialog's
window. The fastmsib1 gate now installs a package of its own at NONE, BASIC
and FULL (file in use, SpawnWaitDialog, Cancel, FilesInUse messages) and
asserts that no window appears at the silent levels, in the process and on
the Xvfb; FULL is the positive control. ADVERTISE=ALL is observable.

CORE review: behaviour change, see patches/notes/3216.txt.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/msi/action.c b/dlls/msi/action.c
index 869ee90..22c5148 100644
--- a/dlls/msi/action.c
+++ b/dlls/msi/action.c
@@ -401,6 +401,9 @@ UINT msi_set_sourcedir_props(MSIPACKAGE *package, BOOL replace)
 
 static BOOL needs_ui_sequence(MSIPACKAGE *package)
 {
+#ifdef SG_MUTANT_MSIB1_UISEQ
+    return TRUE;
+#endif
     return (package->ui_level & INSTALLUILEVEL_MASK) >= INSTALLUILEVEL_REDUCED;
 }
 
diff --git a/dlls/msi/dialog.c b/dlls/msi/dialog.c
index 9055817..3ca8f71 100644
--- a/dlls/msi/dialog.c
+++ b/dlls/msi/dialog.c
@@ -914,7 +914,11 @@ static UINT dialog_control_event( MSIRECORD *rec, void *param )
     if (event && !wcscmp( event, L"SpawnWaitDialog" ))
     {
         /* this event fires when its condition is FALSE and holds until it is TRUE */
+#ifndef SG_MUTANT_MSIB1_SPAWN
         if (r == MSICONDITION_FALSE)
+#else
+        if (r == MSICONDITION_TRUE)
+#endif
             dialog_spawn_wait_dialog( dialog, MSI_RecordGetString( rec, 4 ), condition );
         return ERROR_SUCCESS;
     }
@@ -3928,6 +3932,8 @@ static void process_pending_messages( HWND hdlg )
     }
 }
 
+static void dialog_enable_cancel( msi_dialog *dialog, BOOL enable );
+
 static UINT dialog_run_message_loop( msi_dialog *dialog )
 {
     DWORD style;
@@ -3955,6 +3961,12 @@ static UINT dialog_run_message_loop( msi_dialog *dialog )
         return ERROR_FUNCTION_FAILED;
     }
 
+    /* COMMONDATA asked for the Cancel button to be disabled: the window of this dialog did not exist when
+     * event_do_dialog_wait looked at it */
+#ifndef SG_MUTANT_MSIB1_CANCEL
+    if (dialog->package->cancel_disabled) dialog_enable_cancel( dialog, FALSE );
+#endif
+
     ShowWindow( hwnd, SW_SHOW );
     /* UpdateWindow( hwnd ); - and causes the transparent static controls not to paint */
 
diff --git a/dlls/msi/files.c b/dlls/msi/files.c
index 3516678..0daea89 100644
--- a/dlls/msi/files.c
+++ b/dlls/msi/files.c
@@ -457,7 +457,9 @@ static UINT copy_install_file(MSIPACKAGE *package, MSIFILE *file, LPWSTR source)
             msi_move_file( package, file->TargetPath, NULL, MOVEFILE_DELAY_UNTIL_REBOOT ) &&
             msi_move_file( package, tmpfileW, file->TargetPath, MOVEFILE_DELAY_UNTIL_REBOOT ))
         {
+#ifndef SG_MUTANT_MSIB1_INUSE
             package->need_reboot_at_end = 1;
+#endif
             gle = ERROR_SUCCESS;
         }
         else
diff --git a/dlls/msi/package.c b/dlls/msi/package.c
index f848443..f140ecc 100644
--- a/dlls/msi/package.c
+++ b/dlls/msi/package.c
@@ -1744,7 +1744,11 @@ MSIHANDLE WINAPI MsiGetActiveDatabase( MSIHANDLE hInstall )
 
 static INT internal_ui_handler(MSIPACKAGE *package, INSTALLMESSAGE eMessageType, MSIRECORD *record, LPCWSTR message)
 {
+#ifndef SG_MUTANT_MSIB1_UINONE
     if (!package || (package->ui_level & INSTALLUILEVEL_MASK) == INSTALLUILEVEL_NONE)
+#else
+    if (!package)
+#endif
         return 0;
 
     /* todo: check if message needs additional styles (topmost/foreground/modality?) */
@@ -1776,8 +1780,16 @@ static INT internal_ui_handler(MSIPACKAGE *package, INSTALLMESSAGE eMessageType,
         return 0;
     case INSTALLMESSAGE_SHOWDIALOG:
     {
-        LPWSTR dialog = msi_dup_record_field(record, 0);
-        INT rc = ACTION_DialogBox(package, dialog);
+        LPWSTR dialog;
+        INT rc;
+
+        /* authored dialogs belong to the reduced and full UI levels (the UI sequence does not run below
+         * them either, see needs_ui_sequence); the basic UI shows progress and errors only */
+#ifndef SG_MUTANT_MSIB1_UIBASIC
+        if ((package->ui_level & INSTALLUILEVEL_MASK) < INSTALLUILEVEL_REDUCED) return 0;
+#endif
+        dialog = msi_dup_record_field(record, 0);
+        rc = ACTION_DialogBox(package, dialog);
         free(dialog);
         return rc;
     }
@@ -1842,7 +1854,9 @@ static INT internal_ui_handler(MSIPACKAGE *package, INSTALLMESSAGE eMessageType,
         const WCHAR *name = (eMessageType & 0xff000000) == INSTALLMESSAGE_FILESINUSE ? L"FilesInUse" : L"MsiRMFilesInUse";
         MSIRECORD *row;
 
+#ifndef SG_MUTANT_MSIB1_UIFILES
         if ((package->ui_level & INSTALLUILEVEL_MASK) != INSTALLUILEVEL_FULL) return 0;
+#endif
         if (!(row = MSI_QueryGetRecord(package->db, L"SELECT * FROM `Dialog` WHERE `Dialog` = '%s'", name)))
             return 0;
         msiobj_release(&row->hdr);
