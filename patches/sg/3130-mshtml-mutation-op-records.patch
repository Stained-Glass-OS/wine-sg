From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 00:33:51 -0700
Subject: [PATCH] mshtml: MutationObserver records per operation

innerHTML, innerText, outerHTML and replaceChild change the tree in several
steps; the steps of one call are now merged into one childList record per
observer (all removed and all added nodes, in document order; no sibling
links for a replace-all, the siblings of the old node for a replacement), as
browsers do. innerText removes the children from the first to the last.

diff --git a/dlls/mshtml/htmlelem.c b/dlls/mshtml/htmlelem.c
index c35a9cf..e8ccaed 100644
--- a/dlls/mshtml/htmlelem.c
+++ b/dlls/mshtml/htmlelem.c
@@ -2226,7 +2226,9 @@ static HRESULT WINAPI HTMLElement_put_innerHTML(IHTMLElement *iface, BSTR v)
     }
 
     nsAString_InitDepend(&html_str, v);
+    mo_op_begin(TRUE);
     nsres = nsIDOMHTMLElement_SetInnerHTML(This->html_element, &html_str);
+    mo_op_end();
     nsAString_Finish(&html_str);
     if(NS_FAILED(nsres)) {
         FIXME("SetInnerHtml failed %08lx\n", nsres);
@@ -2254,7 +2256,7 @@ static HRESULT WINAPI HTMLElement_get_innerHTML(IHTMLElement *iface, BSTR *p)
     return return_nsstr(nsres, &html_str, p);
 }
 
-static HRESULT WINAPI HTMLElement_put_innerText(IHTMLElement *iface, BSTR v)
+static HRESULT put_innerText_steps(IHTMLElement *iface, BSTR v)
 {
     HTMLElement *This = impl_from_IHTMLElement(iface);
     nsIDOMNode *nschild, *tmp;
@@ -2265,9 +2267,9 @@ static HRESULT WINAPI HTMLElement_put_innerText(IHTMLElement *iface, BSTR v)
     TRACE("(%p)->(%s)\n", This, debugstr_w(v));
 
     while(1) {
-        nsres = nsIDOMElement_GetLastChild(This->dom_element, &nschild);
+        nsres = nsIDOMElement_GetFirstChild(This->dom_element, &nschild);
         if(NS_FAILED(nsres)) {
-            ERR("GetLastChild failed: %08lx\n", nsres);
+            ERR("GetFirstChild failed: %08lx\n", nsres);
             return E_FAIL;
         }
         if(!nschild)
@@ -2301,6 +2303,16 @@ static HRESULT WINAPI HTMLElement_put_innerText(IHTMLElement *iface, BSTR v)
     return S_OK;
 }
 
+static HRESULT WINAPI HTMLElement_put_innerText(IHTMLElement *iface, BSTR v)
+{
+    HRESULT hres;
+
+    mo_op_begin(TRUE);
+    hres = put_innerText_steps(iface, v);
+    mo_op_end();
+    return hres;
+}
+
 static HRESULT WINAPI HTMLElement_get_innerText(IHTMLElement *iface, BSTR *p)
 {
     HTMLElement *This = impl_from_IHTMLElement(iface);
@@ -2313,10 +2325,14 @@ static HRESULT WINAPI HTMLElement_get_innerText(IHTMLElement *iface, BSTR *p)
 static HRESULT WINAPI HTMLElement_put_outerHTML(IHTMLElement *iface, BSTR v)
 {
     HTMLElement *This = impl_from_IHTMLElement(iface);
+    HRESULT hres;
 
     TRACE("(%p)->(%s)\n", This, debugstr_w(v));
 
-    return replace_node_by_html(This->node.doc->dom_document, This->node.nsnode, v);
+    mo_op_begin(FALSE);
+    hres = replace_node_by_html(This->node.doc->dom_document, This->node.nsnode, v);
+    mo_op_end();
+    return hres;
 }
 
 static HRESULT WINAPI HTMLElement_get_outerHTML(IHTMLElement *iface, BSTR *p)
