diff --git a/dlls/mshtml/mutation.c b/dlls/mshtml/mutation.c
index a42fb0e..add090f 100644
--- a/dlls/mshtml/mutation.c
+++ b/dlls/mshtml/mutation.c
@@ -1159,6 +1159,7 @@ struct mo_record {
     unsigned removed_cnt;
     WCHAR *attr_name;
     WCHAR *old_value;
+    unsigned op;  /* operation serial of a childList record, 0 when not made inside an operation */
 };
 
 struct mutation_observer {
@@ -1308,6 +1309,56 @@ static void mo_add_node(nsIDOMNode ***arr, unsigned *cnt, nsIDOMNode *node)
     tmp[(*cnt)++] = node;
 }
 
+/* A script call (innerHTML, replaceChild...) that changes the tree in several steps is one operation
+ * for observers: the steps of it are merged into one childList record, as browsers do. */
+static struct {
+    unsigned depth, serial;
+    BOOL replace_all;
+} mo_op;
+
+void mo_op_begin(BOOL replace_all)
+{
+    if(!mo_op.depth++) {
+        mo_op.serial++;
+        mo_op.replace_all = replace_all;
+    }
+}
+
+void mo_op_end(void)
+{
+    if(mo_op.depth)
+        mo_op.depth--;
+}
+
+static BOOL mo_merge_record(struct mutation_observer *obs, const struct mo_record *tmpl)
+{
+    struct mo_record *last;
+    struct list *tail;
+    unsigned i;
+
+#ifdef SG_MUTANT_MO_NOMERGE
+    return FALSE;
+#endif
+    if(!mo_op.depth || tmpl->type != MO_REC_CHILD_LIST || !(tail = list_tail(&obs->records)))
+        return FALSE;
+    last = LIST_ENTRY(tail, struct mo_record, entry);
+    if(last->type != MO_REC_CHILD_LIST || last->op != mo_op.serial || last->target != tmpl->target)
+        return FALSE;
+
+    for(i = 0; i < tmpl->added_cnt; i++) mo_add_node(&last->added, &last->added_cnt, tmpl->added[i]);
+    for(i = 0; i < tmpl->removed_cnt; i++) mo_add_node(&last->removed, &last->removed_cnt, tmpl->removed[i]);
+    if(mo_op.replace_all) {
+        if(last->prev) nsIDOMNode_Release(last->prev);
+        if(last->next) nsIDOMNode_Release(last->next);
+        last->prev = last->next = NULL;
+    }else if(tmpl->added_cnt && !tmpl->removed_cnt && !last->removed_cnt) {
+        /* consecutive insertions: the record spans all of them */
+        if(last->next) nsIDOMNode_Release(last->next);
+        if((last->next = tmpl->next)) nsIDOMNode_AddRef(last->next);
+    }
+    return TRUE;
+}
+
 /* Queues a record for every observer that has an interest in the node. The template is
  * not kept; each observer gets a copy of the parts it needs. */
 static void mo_queue(HTMLDocumentNode *doc, const struct mo_record *tmpl)
@@ -1342,8 +1393,12 @@ static void mo_queue(HTMLDocumentNode *doc, const struct mo_record *tmpl)
             continue;
         obs->mark = serial;
 
+        if(mo_merge_record(obs, tmpl))
+            continue;
         if(!(rec = calloc(1, sizeof(*rec))))
             continue;
+        if(tmpl->type == MO_REC_CHILD_LIST && mo_op.depth)
+            rec->op = mo_op.serial;
         rec->type = tmpl->type;
         rec->target = tmpl->target;
         nsIDOMNode_AddRef(rec->target);
