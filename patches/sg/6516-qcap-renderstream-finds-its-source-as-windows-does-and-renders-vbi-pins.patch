@@ -581,6 +594,69 @@ end:
 static HRESULT find_unconnected_source_from_filter(CaptureGraphImpl *capture_graph,
         const GUID *category, const GUID *majortype, IBaseFilter *filter, IPin **ret);
 
+/* Stained Glass OS (wine-sg 6516): the source to render is looked for breadth first, as
+ * Windows does: a filter's own unconnected output pins first, then (without a category) the
+ * filters its connected outputs lead to. With a category other than capture and preview the
+ * search stays on the given filter; capture and preview pins go through the smart tee. */
+static HRESULT find_unconnected_source_downstream(CaptureGraphImpl *capture_graph,
+        const GUID *majortype, IBaseFilter *filter, IPin **ret)
+{
+    IEnumPins *enumpins;
+    IPin *pin, *peer;
+    PIN_INFO info;
+    HRESULT hr;
+
+    if (FAILED(hr = IBaseFilter_EnumPins(filter, &enumpins)))
+        return hr;
+
+#ifndef SG_MUTANT_QCAP_DEPTH_FIRST
+    /* the filter's own pins */
+    while (IEnumPins_Next(enumpins, 1, &pin, NULL) == S_OK)
+    {
+        if (pin_matches(pin, PINDIR_OUTPUT, NULL, majortype, TRUE))
+        {
+            IEnumPins_Release(enumpins);
+            *ret = pin;
+            return S_OK;
+        }
+        IPin_Release(pin);
+    }
+    IEnumPins_Reset(enumpins);
+#endif
+
+    /* then downstream */
+    while (IEnumPins_Next(enumpins, 1, &pin, NULL) == S_OK)
+    {
+        PIN_DIRECTION dir;
+
+        IPin_QueryDirection(pin, &dir);
+#ifdef SG_MUTANT_QCAP_DEPTH_FIRST
+        if (dir == PINDIR_OUTPUT && pin_matches(pin, PINDIR_OUTPUT, NULL, majortype, TRUE))
+        {
+            IEnumPins_Release(enumpins);
+            *ret = pin;
+            return S_OK;
+        }
+#endif
+        if (dir == PINDIR_OUTPUT && SUCCEEDED(IPin_ConnectedTo(pin, &peer)))
+        {
+            IPin_QueryPinInfo(peer, &info);
+            IPin_Release(peer);
+            hr = info.pFilter ? find_unconnected_source_downstream(capture_graph, majortype, info.pFilter, ret) : E_FAIL;
+            if (info.pFilter) IBaseFilter_Release(info.pFilter);
+            if (SUCCEEDED(hr))
+            {
+                IPin_Release(pin);
+                IEnumPins_Release(enumpins);
+                return hr;
+            }
+        }
+        IPin_Release(pin);
+    }
+    IEnumPins_Release(enumpins);
+    return E_FAIL;
+}
+
 static HRESULT find_unconnected_source_from_pin(CaptureGraphImpl *capture_graph,
         const GUID *category, const GUID *majortype, IPin *pin, IPin **ret)
 {
@@ -604,25 +680,34 @@ static HRESULT find_unconnected_source_from_pin(CaptureGraphImpl *capture_graph,
             *ret = pin;
             return S_OK;
         }
+        IPin_QueryPinInfo(peer, &info);
+        hr = find_unconnected_source_from_filter(capture_graph, category, majortype, info.pFilter, ret);
+        IBaseFilter_Release(info.pFilter);
+        IPin_Release(peer);
+        IPin_Release(pin);
+        return hr;
     }
-    else
+
+    if (FAILED(IPin_ConnectedTo(pin, &peer)))
     {
-        if (FAILED(IPin_ConnectedTo(pin, &peer)))
-        {
-            if (!pin_matches(pin, PINDIR_OUTPUT, category, majortype, FALSE))
-                return E_FAIL;
+        if (!pin_matches(pin, PINDIR_OUTPUT, category, majortype, FALSE))
+            return E_FAIL;
 
-            IPin_AddRef(*ret = pin);
-            return S_OK;
-        }
-        IPin_AddRef(pin);
+        IPin_AddRef(*ret = pin);
+        return S_OK;
+    }
+
+    /* a connected pin of a category is not followed */
+    if (category)
+    {
+        IPin_Release(peer);
+        return E_INVALIDARG;
     }
 
     IPin_QueryPinInfo(peer, &info);
-    hr = find_unconnected_source_from_filter(capture_graph, category, majortype, info.pFilter, ret);
+    hr = find_unconnected_source_downstream(capture_graph, majortype, info.pFilter, ret);
     IBaseFilter_Release(info.pFilter);
     IPin_Release(peer);
-    IPin_Release(pin);
     return hr;
 }
 
