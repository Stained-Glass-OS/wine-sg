     if (category && IsEqualGUID(category, &PIN_CATEGORY_VBI))
-    {
-        FIXME("Tee/Sink-to-Sink filter not supported\n");
-        return E_NOTIMPL;
-    }
+        WARN("VBI: connecting without a Tee/Sink-to-Sink converter\n");
 
     if (IUnknown_QueryInterface(source, &IID_IPin, (void **)&pin) == S_OK)
     {
@@ -707,7 +795,12 @@ static HRESULT WINAPI fnCaptureGraphBuilder2_RenderStream(ICaptureGraphBuilder2
         return E_INVALIDARG;
     }
