-        if (SUCCEEDED(hr = find_unconnected_source_from_pin(capture_graph, category, majortype, pin, ret)))
+        if (pin_matches(pin, PINDIR_OUTPUT, category, majortype, TRUE))
         {
             IEnumPins_Release(enumpins);
