+/* IShellFolder2::GetDetailsEx for a folder with a column table: the value the item has by itself
+ * (file system items: typed sizes and dates), else the text of the column of that property */
+HRESULT shellfolder_get_details_ex(IShellFolder2 *iface, LPCITEMIDLIST root, LPCITEMIDLIST pidl, const shvheader *header,
+                                   UINT count, const SHCOLUMNID *scid, VARIANT *pv)
+{
+    SHELLDETAILS details = { 0 };
+    LPITEMIDLIST full;
+    HRESULT hr;
+    UINT i;
+
+    if (!pv) return E_INVALIDARG;
+    VariantInit(pv);
+    if (!pidl || !scid) return E_INVALIDARG;
+
+    if (root && (full = ILCombine(root, pidl)))
+    {
+#ifndef SG_MUTANT_DETAILSEX_VALUE
+        hr = SHELL32_GetItemValue(full, (const PROPERTYKEY *)scid, pv);
+#else
+        hr = S_OK;
+#endif
+        ILFree(full);
+        if (FAILED(hr)) return hr;
+        if (V_VT(pv) != VT_EMPTY) return S_OK;
+    }
+
+    for (i = 0; i < count; i++)
+        if (header[i].fmtid && IsEqualGUID(header[i].fmtid, &scid->fmtid) && header[i].pid == scid->pid) break;
+#ifdef SG_MUTANT_DETAILSEX_COLUMN
+    i = count;
+#endif
+    if (i == count) return E_FAIL;
+    if (FAILED(hr = IShellFolder2_GetDetailsOf(iface, pidl, i, &details))) return hr;
+    if (SUCCEEDED(hr = StrRetToBSTR(&details.str, pidl, &V_BSTR(pv)))) V_VT(pv) = VT_BSTR;
+    return hr;
+}
+
+/* IShellFolder::BindToStorage of a file system item: its file as a stream; a folder, or an item
+ * that is no file, has none */
+HRESULT SHELL32_BindFileToStream(LPCITEMIDLIST full, REFIID riid, void **ppv)
+{
+    WCHAR path[MAX_PATH];
+    IStream *stream;
+    HRESULT hr;
+
+    *ppv = NULL;
+    if (!IsEqualIID(riid, &IID_IStream) && !IsEqualIID(riid, &IID_ISequentialStream) && !IsEqualIID(riid, &IID_IUnknown))
+        return E_NOINTERFACE;
+    if (!SHGetPathFromIDListW(full, path) || (GetFileAttributesW(path) & FILE_ATTRIBUTE_DIRECTORY)) return E_FAIL;
+    if (FAILED(hr = SHCreateStreamOnFileEx(path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream))) return hr;
+    hr = IStream_QueryInterface(stream, riid, ppv);
+    IStream_Release(stream);
+    return hr;
+}
+
 HRESULT shellfolder_get_file_details(IShellFolder2 *iface, LPCITEMIDLIST pidl, const shvheader *header,
                                      int column, SHELLDETAILS *psd)
 {
