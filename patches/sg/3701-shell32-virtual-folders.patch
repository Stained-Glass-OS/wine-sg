+/* the value the item itself gives (a file system item's file, any item's names), as a variant;
+ * VT_EMPTY when there is none -- the folders use this for GetDetailsEx */
+HRESULT SHELL32_GetItemValue(LPCITEMIDLIST pidl, const PROPERTYKEY *key, VARIANT *v)
+{
+    struct shell_item item = { 0 };
+    PROPVARIANT pv;
+    HRESULT hr;
+
+    VariantInit(v);
+    item.pidl = (LPITEMIDLIST)pidl;
+    if (FAILED(hr = shellitem_get_value(&item, key, &pv))) return hr;
+    if (pv.vt != VT_EMPTY) hr = PropVariantToVariant(&pv, v);
+    PropVariantClear(&pv);
+    return FAILED(hr) ? hr : S_OK;
+}
+
