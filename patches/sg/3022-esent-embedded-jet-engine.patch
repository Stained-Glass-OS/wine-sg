+/* ---------------------------------------------------------------------- */
+/* creating a table with its columns and indexes in one call              */
+
+static JET_ERR create_table_full( JET_SESID sesid, JET_DBID dbid, const WCHAR *name, unsigned long pages,
+                                  unsigned long density, JET_COLUMNCREATE_W *cc, unsigned long ncc,
+                                  BYTE *ic, unsigned long nic, JET_TABLEID *ptable, unsigned long *pcreated )
+{
+    struct session *s;
+    struct table *t;
+    struct cursor *cur;
+    JET_ERR err, first = JET_errSuccess;
+    unsigned long i, created = 0;
+
+    lock();
+    if ((err = need_session( sesid, &s ))) { unlock(); return err; }
+    if ((err = create_table( s, dbid, name, &t ))) { unlock(); return err; }
+    if (!(cur = new_cursor( s, t ))) { t->deleted = TRUE; unlock(); return JET_errOutOfMemory; }
+    created++;
+    for (i = 0; i < ncc; i++)
+    {
+        JET_COLUMNCREATE_W *c = (JET_COLUMNCREATE_W *)((BYTE *)cc + i * cc->cbStruct);
+        JET_COLUMNID id = 0;
+        c->err = add_column( t, c->szColumnName, c->coltyp, c->cbMax, c->grbit, c->cp, 0x409, 1, 0, c->pvDefault,
+                             c->pvDefault ? c->cbDefault : 0, &id );
+        if (!c->err) { c->columnid = id; created++; }
+        else if (!first) first = c->err;
+    }
+    for (i = 0; i < nic && !first; i++)
+    {
+        JET_INDEXCREATE_W *x = (JET_INDEXCREATE_W *)(ic + i * ((JET_INDEXCREATE_W *)ic)->cbStruct);
+        WCHAR *keys = x->szKey ? key_to_multisz_w( x->szKey, x->cbKey ) : NULL;
+        x->err = keys ? add_index( t, x->szIndexName, x->grbit, keys, x->lcid ) : JET_errInvalidParameter;
+        free( keys );
+        if (!x->err) created++;
+        else if (!first) first = x->err;
+    }
+    if (first)
+    {
+        close_cursor( cur );
+        t->deleted = TRUE;
+        err = first;
+    }
+    else
+    {
+        cur->idx = table_default_index( t );
+        *ptable = (JET_TABLEID)cur;
+        if (pcreated) *pcreated = created;
+        table_touch( s, t );
+        err = JET_errSuccess;
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetCreateTableColumnIndexW( JET_SESID sesid, JET_DBID dbid, JET_TABLECREATE_W *tc )
+{
+    JET_ERR err;
+    TRACE( "%#Ix %lu %p\n", sesid, dbid, tc );
+    if (!tc || tc->cbStruct < sizeof(*tc)) return JET_errInvalidParameter;
+    err = create_table_full( sesid, dbid, tc->szTableName, tc->ulPages, tc->ulDensity, tc->rgcolumncreate, tc->cColumns,
+                             (BYTE *)tc->rgindexcreate, tc->cIndexes, &tc->tableid, &tc->cCreated );
+    return err;
+}
+
+JET_ERR JET_API JetCreateTableColumnIndex2W( JET_SESID sesid, JET_DBID dbid, JET_TABLECREATE2_W *tc )
+{
+    JET_ERR err;
+    TRACE( "%#Ix %lu %p\n", sesid, dbid, tc );
+    if (!tc || tc->cbStruct < sizeof(*tc)) return JET_errInvalidParameter;
+    err = create_table_full( sesid, dbid, tc->szTableName, tc->ulPages, tc->ulDensity, tc->rgcolumncreate, tc->cColumns,
+                             (BYTE *)tc->rgindexcreate, tc->cIndexes, &tc->tableid, &tc->cCreated );
+    return err;
+}
+
+
+static JET_ERR create_table_full_a( JET_SESID sesid, JET_DBID dbid, const char *name, unsigned long pages, unsigned long density,
+                                    JET_COLUMNCREATE_A *cc, unsigned long ncc, JET_INDEXCREATE_A *ic, unsigned long nic,
+                                    JET_TABLEID *ptable, unsigned long *pcreated )
+{
+    WCHAR *nameW = a2w( name );
+    JET_COLUMNCREATE_W *ccw = NULL;
+    JET_INDEXCREATE_W *icw = NULL;
+    WCHAR **keys = NULL;
+    unsigned long i;
+    JET_ERR err;
+
+    if (ncc && !(ccw = calloc( ncc, sizeof(*ccw) ))) { free( nameW ); return JET_errOutOfMemory; }
+    if (nic && (!(icw = calloc( nic, sizeof(*icw) )) || !(keys = calloc( nic, sizeof(*keys) )))) { free( nameW ); free( ccw ); free( icw ); return JET_errOutOfMemory; }
+    for (i = 0; i < ncc; i++)
+    {
+        JET_COLUMNCREATE_A *a = (JET_COLUMNCREATE_A *)((BYTE *)cc + i * cc->cbStruct);
+        ccw[i].cbStruct = sizeof(*ccw);
+        ccw[i].szColumnName = a2w( a->szColumnName );
+        ccw[i].coltyp = a->coltyp; ccw[i].cbMax = a->cbMax; ccw[i].grbit = a->grbit;
+        ccw[i].pvDefault = a->pvDefault; ccw[i].cbDefault = a->cbDefault; ccw[i].cp = a->cp;
+    }
+    for (i = 0; i < nic; i++)
+    {
+        JET_INDEXCREATE_A *a = (JET_INDEXCREATE_A *)((BYTE *)ic + i * ic->cbStruct);
+        unsigned long n = 0;
+        int wn;
+        while (a->szKey[n] || a->szKey[n + 1]) n++;
+        n += 2;
+        wn = MultiByteToWideChar( CP_ACP, 0, a->szKey, n, NULL, 0 );
+        keys[i] = calloc( wn + 2, sizeof(WCHAR) );
+        MultiByteToWideChar( CP_ACP, 0, a->szKey, n, keys[i], wn );
+        icw[i].cbStruct = sizeof(*icw);
+        icw[i].szIndexName = a2w( a->szIndexName );
+        icw[i].szKey = keys[i];
+        icw[i].cbKey = wn;
+        icw[i].grbit = a->grbit;
+        icw[i].ulDensity = a->ulDensity;
+        icw[i].lcid = a->lcid;
+    }
+    err = create_table_full( sesid, dbid, nameW, pages, density, ccw, ncc, (BYTE *)icw, nic, ptable, pcreated );
+    for (i = 0; i < ncc; i++)
+    {
+        JET_COLUMNCREATE_A *a = (JET_COLUMNCREATE_A *)((BYTE *)cc + i * cc->cbStruct);
+        a->err = ccw[i].err;
+        a->columnid = ccw[i].columnid;
+        free( ccw[i].szColumnName );
+    }
+    for (i = 0; i < nic; i++)
+    {
+        JET_INDEXCREATE_A *a = (JET_INDEXCREATE_A *)((BYTE *)ic + i * ic->cbStruct);
+        a->err = icw[i].err;
+        free( icw[i].szIndexName );
+        free( keys[i] );
+    }
+    free( ccw ); free( icw ); free( keys ); free( nameW );
+    return err;
+}
+
+JET_ERR JET_API JetCreateTableColumnIndexA( JET_SESID sesid, JET_DBID dbid, JET_TABLECREATE_A *tc )
+{
+    if (!tc || tc->cbStruct < sizeof(*tc)) return JET_errInvalidParameter;
+    return create_table_full_a( sesid, dbid, tc->szTableName, tc->ulPages, tc->ulDensity, tc->rgcolumncreate, tc->cColumns,
+                                tc->rgindexcreate, tc->cIndexes, &tc->tableid, &tc->cCreated );
+}
+
+JET_ERR JET_API JetCreateTableColumnIndex2A( JET_SESID sesid, JET_DBID dbid, JET_TABLECREATE2_A *tc )
+{
+    if (!tc || tc->cbStruct < sizeof(*tc)) return JET_errInvalidParameter;
+    return create_table_full_a( sesid, dbid, tc->szTableName, tc->ulPages, tc->ulDensity, tc->rgcolumncreate, tc->cColumns,
+                                tc->rgindexcreate, tc->cIndexes, &tc->tableid, &tc->cCreated );
+}
