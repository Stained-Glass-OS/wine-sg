+JET_ERR JET_API JetBeginTransaction2( JET_SESID sesid, JET_GRBIT grbit )
+{
+    struct session *s;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#lx\n", sesid, grbit );
+    lock();
+    if (!(err = need_session( sesid, &s ))) { if (s->level >= 7) err = JET_errTransTooDeep; else s->level++; }
+    unlock();
+    return err;
+}
+
