+static JET_ERR create_database( JET_SESID sesid, const WCHAR *path, JET_DBID *pdbid, JET_GRBIT grbit )
+{
+    struct session *s;
+    struct database *db;
+    JET_ERR err;
+
+    if (!path || !*path) return JET_errInvalidParameter;
+    if ((err = need_session( sesid, &s ))) return err;
+    if (find_db( s->inst, path )) return JET_errDatabaseDuplicate;
+    if (GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES && !(grbit & JET_bitDbOverwriteExisting))
+        return JET_errDatabaseDuplicate;
+    if (!(db = new_database( s->inst, path ))) return JET_errOutOfMemory;
+    db->state = JET_dbstateJustCreated;
+    if ((err = flush_db( db )))
+    {
+        free_database( db );
+        return err == JET_errDiskIO ? JET_errInvalidPath : err;
+    }
+    list_add_tail( &s->inst->databases, &db->entry );
+    if (pdbid)
+    {
+        if (!(*pdbid = session_open_db( s, db ))) return JET_errOutOfMemory;
+    }
+    else db->readonly = FALSE;
+    return JET_errSuccess;
+}
