+JET_ERR JET_API JetSetColumnDefaultValueW( JET_SESID sesid, JET_DBID dbid, const WCHAR *table, const WCHAR *column,
+                                           const void *data, const unsigned long cb, const JET_GRBIT grbit )
+{
+    struct session *s;
+    struct database *db;
+    struct table *t;
+    struct column *col;
+    JET_ERR err;
+
+    TRACE( "%#Ix %lu %s %s %p %lu\n", sesid, dbid, debugstr_w(table), debugstr_w(column), data, cb );
+    lock();
+    if (!(err = need_session( sesid, &s )))
+    {
+        if (!(db = session_db( s, dbid ))) err = JET_errInvalidDatabaseId;
+        else if (!table || !(t = db_find_table( db, table ))) err = JET_errObjectNotFound;
+        else if (!column || !(col = col_by_name( t, column, NULL ))) err = JET_errColumnNotFound;
+        else if (data && fixed_size( col->type ) && cb != fixed_size( col->type )) err = JET_errInvalidBufferSize;
+        else
+        {
+            free_value( &col->def );
+            col->has_def = FALSE;
+            if (data)
+            {
+                col->def.p = malloc( cb ? cb : 1 );
+                if (!col->def.p) err = JET_errOutOfMemory;
+                else
+                {
+                    memcpy( col->def.p, data, cb );
+                    col->def.len = cb;
+                    col->has_def = TRUE;
+                }
+            }
+            db->dirty = TRUE;
+        }
+    }
+    unlock();
+    return err;
+}
