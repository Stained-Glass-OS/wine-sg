+static JET_ERR copy_name_out( const WCHAR *name, BOOL ansi, void *result, unsigned long cb )
+{
+    return put_string( name, ansi, result, cb );
+}
+
+static struct tval str_val( BOOL ansi, const WCHAR *s )
+{
+    struct tval v;
+    if (ansi)
+    {
+        int n = WideCharToMultiByte( CP_ACP, 0, s, -1, NULL, 0, NULL, NULL );
+        char *p = malloc( n );
+        if (p) WideCharToMultiByte( CP_ACP, 0, s, -1, p, n, NULL, NULL );
+        v.p = p;
+        v.len = n ? n - 1 : 0;
+    }
+    else
+    {
+        WCHAR *p = wcsdup( s );
+        v.p = p;
+        v.len = p ? lstrlenW( p ) * sizeof(WCHAR) : 0;
+    }
+    return v;
+}
+
+static void fill_columndef( JET_COLUMNDEF *d, const struct column *c )
+{
+    memset( d, 0, sizeof(*d) );
+    d->cbStruct = sizeof(*d);
+    d->columnid = c->id;
+    d->coltyp = c->type;
+    d->wCountry = c->country;
+    d->langid = c->langid;
+    d->cp = c->cp;
+    d->wCollate = c->collate;
+    d->cbMax = c->cbmax;
+    d->grbit = c->grbit;
+}
+
+static int cmp_col_ptr( const void *a, const void *b )
+{
+    const struct column *x = *(struct column * const *)a, *y = *(struct column * const *)b;
+    return x->id < y->id ? -1 : x->id > y->id ? 1 : 0;
+}
+
+static JET_ERR build_column_list( struct session *s, struct table *t, BOOL ansi, JET_COLUMNLIST *cl, BOOL by_id )
+{
+    static const struct tspec spec[] =
+    {
+        { JET_coltypLong }, { JET_coltypText, 64 }, { JET_coltypLong }, { JET_coltypLong }, { JET_coltypShort },
+        { JET_coltypShort }, { JET_coltypShort }, { JET_coltypShort }, { JET_coltypLong }, { JET_coltypLong },
+        { JET_coltypLongBinary, 0, JET_bitColumnTagged }, { JET_coltypText, 64 }, { JET_coltypText, 64 }, { JET_coltypText, 64 }
+    };
+    JET_COLUMNID ids[14];
+    struct cursor *c;
+    struct column **list;
+    DWORD i, n = 0, rows = 0;
+
+    if (!(c = new_temp_cursor( s, spec, ARRAY_SIZE(spec), ids, !ansi ))) return JET_errOutOfMemory;
+    if (!(list = calloc( t->ncols + 1, sizeof(*list) ))) { close_cursor( c ); return JET_errOutOfMemory; }
+    for (i = 0; i < t->ncols; i++) if (!t->cols[i].deleted) list[n++] = &t->cols[i];
+    if (by_id) qsort( list, n, sizeof(*list), cmp_col_ptr );
+    for (i = 0; i < n; i++)
+    {
+        struct column *col = list[i];
+        DWORD order = i, id = col->id, ty = col->type, cb = col->cbmax, gr = col->grbit;
+        WORD country = col->country, lang = col->langid, cp = col->cp, coll = col->collate;
+        struct tval v[14], pn, cn;
+        JET_ERR err;
+
+        pn = str_val( ansi, col->name );
+        cn = str_val( ansi, t->name );
+        v[0].p = &order; v[0].len = 4;
+        v[1] = pn;
+        v[2].p = &id; v[2].len = 4;
+        v[3].p = &ty; v[3].len = 4;
+        v[4].p = &country; v[4].len = 2;
+        v[5].p = &lang; v[5].len = 2;
+        v[6].p = &cp; v[6].len = 2;
+        v[7].p = &coll; v[7].len = 2;
+        v[8].p = &cb; v[8].len = 4;
+        v[9].p = &gr; v[9].len = 4;
+        v[10].p = col->has_def ? (col->def.p ? (void *)col->def.p : (void *)"") : NULL; v[10].len = col->def.len;
+        v[11] = cn;
+        v[12] = pn;
+        v[13] = pn;
+        err = temp_push_row( c, ids, v, 14 );
+        free( (void *)pn.p );
+        free( (void *)cn.p );
+        if (err) { free( list ); close_cursor( c ); return err; }
+        rows++;
+    }
+    free( list );
+    memset( cl, 0, sizeof(*cl) );
+    cl->cbStruct = sizeof(*cl);
+    cl->tableid = (JET_TABLEID)c;
+    cl->cRecord = rows;
+    cl->columnidPresentationOrder = ids[0];
+    cl->columnidcolumnname = ids[1];
+    cl->columnidcolumnid = ids[2];
+    cl->columnidcoltyp = ids[3];
+    cl->columnidCountry = ids[4];
+    cl->columnidLangid = ids[5];
+    cl->columnidCp = ids[6];
+    cl->columnidCollate = ids[7];
+    cl->columnidcbMax = ids[8];
+    cl->columnidgrbit = ids[9];
+    cl->columnidDefault = ids[10];
+    cl->columnidBaseTableName = ids[11];
+    cl->columnidBaseColumnName = ids[12];
+    cl->columnidDefinitionName = ids[13];
+    return JET_errSuccess;
+}
+
+static JET_ERR build_index_list( struct session *s, struct table *t, const WCHAR *only, BOOL ansi, JET_INDEXLIST *il )
+{
+    static const struct tspec spec[] =
+    {
+        { JET_coltypText, 64 }, { JET_coltypLong }, { JET_coltypLong }, { JET_coltypLong }, { JET_coltypLong },
+        { JET_coltypLong }, { JET_coltypLong }, { JET_coltypLong }, { JET_coltypLong }, { JET_coltypShort },
+        { JET_coltypShort }, { JET_coltypShort }, { JET_coltypShort }, { JET_coltypLong }, { JET_coltypText, 64 },
+        { JET_coltypLong }
+    };
+    JET_COLUMNID ids[16];
+    struct cursor *c;
+    DWORD i, j, rows = 0;
+
+    if (!(c = new_temp_cursor( s, spec, ARRAY_SIZE(spec), ids, !ansi ))) return JET_errOutOfMemory;
+    for (i = 1; i < t->nidx; i++)
+    {
+        struct index *ix = t->idx[i];
+        if (only && wcsicmp( only, ix->name )) continue;
+        for (j = 0; j < ix->nkeys; j++)
+        {
+            struct column *col = &t->cols[ix->keys[j].slot];
+            DWORD grbit = ix->grbit, nkeys = ix->nkeys, nentries = ix->n, npages = 1, ncol = ix->nkeys, icol = j;
+            DWORD cid = col->id, ty = col->type, cgr = ix->keys[j].desc ? JET_bitKeyDescending : 0, lcflags = 0;
+            WORD country = col->country, lang = col->langid, cp = col->cp, coll = col->collate;
+            struct tval v[16], nm, cn;
+            JET_ERR err;
+
+            nm = str_val( ansi, ix->name );
+            cn = str_val( ansi, col->name );
+            v[0] = nm;
+            v[1].p = &grbit; v[1].len = 4;
+            v[2].p = &nkeys; v[2].len = 4;
+            v[3].p = &nentries; v[3].len = 4;
+            v[4].p = &npages; v[4].len = 4;
+            v[5].p = &ncol; v[5].len = 4;
+            v[6].p = &icol; v[6].len = 4;
+            v[7].p = &cid; v[7].len = 4;
+            v[8].p = &ty; v[8].len = 4;
+            v[9].p = &country; v[9].len = 2;
+            v[10].p = &lang; v[10].len = 2;
+            v[11].p = &cp; v[11].len = 2;
+            v[12].p = &coll; v[12].len = 2;
+            v[13].p = &cgr; v[13].len = 4;
+            v[14] = cn;
+            v[15].p = &lcflags; v[15].len = 4;
+            err = temp_push_row( c, ids, v, 16 );
+            free( (void *)nm.p );
+            free( (void *)cn.p );
+            if (err) { close_cursor( c ); return err; }
+            rows++;
+        }
+    }
+    memset( il, 0, sizeof(*il) );
+    il->cbStruct = sizeof(*il);
+    il->tableid = (JET_TABLEID)c;
+    il->cRecord = rows;
+    il->columnidindexname = ids[0];
+    il->columnidgrbitIndex = ids[1];
+    il->columnidcKey = ids[2];
+    il->columnidcEntry = ids[3];
+    il->columnidcPage = ids[4];
+    il->columnidcColumn = ids[5];
+    il->columnidiColumn = ids[6];
+    il->columnidcolumnid = ids[7];
+    il->columnidcoltyp = ids[8];
+    il->columnidCountry = ids[9];
+    il->columnidLangid = ids[10];
+    il->columnidCp = ids[11];
+    il->columnidCollate = ids[12];
+    il->columnidgrbitColumn = ids[13];
+    il->columnidcolumnname = ids[14];
+    il->columnidLCMapFlags = ids[15];
+    return JET_errSuccess;
+}
+
+static JET_ERR table_column_info( struct session *s, struct table *t, const WCHAR *name, void *result, unsigned long cb,
+                                  unsigned long level, BOOL ansi )
+{
+    struct column *col;
+    unsigned long base = level & 0xff;
+
+    if (!result) return JET_errInvalidParameter;
+    switch (base)
+    {
+    case JET_ColInfo:
+    case JET_ColInfoByColid:
+    {
+        JET_COLUMNDEF *d = result;
+        if (cb < sizeof(*d)) return JET_errInvalidBufferSize;
+        if (base == JET_ColInfoByColid) col = col_by_id( t, *(const DWORD *)name, NULL );
+        else if (!name) return JET_errInvalidParameter;
+        else col = col_by_name( t, name, NULL );
+        if (!col) return JET_errColumnNotFound;
+        fill_columndef( d, col );
+        return JET_errSuccess;
+    }
+    case JET_ColInfoList:
+    case JET_ColInfoListCompact:
+    case JET_ColInfoListSortColumnid:
+        if (cb < sizeof(JET_COLUMNLIST)) return JET_errBufferTooSmall;
+        return build_column_list( s, t, ansi, result, base == JET_ColInfoListSortColumnid || (level & JET_ColInfoGrbitSortByColumnid) );
+    case JET_ColInfoBase:
+    case JET_ColInfoBaseByColid:
+        if (base == JET_ColInfoBaseByColid) col = col_by_id( t, *(const DWORD *)name, NULL );
+        else if (!name) return JET_errInvalidParameter;
+        else col = col_by_name( t, name, NULL );
+        if (!col) return JET_errColumnNotFound;
+        if (ansi)
+        {
+            JET_COLUMNBASE_A *b = result;
+            if (cb < sizeof(*b)) return JET_errInvalidBufferSize;
+            memset( b, 0, sizeof(*b) );
+            b->cbStruct = sizeof(*b);
+            b->columnid = col->id; b->coltyp = col->type; b->wCountry = col->country; b->langid = col->langid;
+            b->cp = col->cp; b->cbMax = col->cbmax; b->grbit = col->grbit;
+            WideCharToMultiByte( CP_ACP, 0, t->name, -1, b->szBaseTableName, sizeof(b->szBaseTableName), NULL, NULL );
+            WideCharToMultiByte( CP_ACP, 0, col->name, -1, b->szBaseColumnName, sizeof(b->szBaseColumnName), NULL, NULL );
+        }
+        else
+        {
+            JET_COLUMNBASE_W *b = result;
+            if (cb < sizeof(*b)) return JET_errInvalidBufferSize;
+            memset( b, 0, sizeof(*b) );
+            b->cbStruct = sizeof(*b);
+            b->columnid = col->id; b->coltyp = col->type; b->wCountry = col->country; b->langid = col->langid;
+            b->cp = col->cp; b->cbMax = col->cbmax; b->grbit = col->grbit;
+            lstrcpynW( b->szBaseTableName, t->name, ARRAY_SIZE(b->szBaseTableName) );
+            lstrcpynW( b->szBaseColumnName, col->name, ARRAY_SIZE(b->szBaseColumnName) );
+        }
+        return JET_errSuccess;
+    default:
+        return JET_errInvalidParameter;
+    }
+}
+
+static JET_ERR table_index_info( struct session *s, struct table *t, const WCHAR *name, void *result, unsigned long cb,
+                                 unsigned long level, BOOL ansi )
+{
+    struct index *ix = NULL;
+
+    if (!result) return JET_errInvalidParameter;
+    if (name && *name && level != JET_IdxInfoList && !(ix = table_find_index( t, name ))) return JET_errIndexNotFound;
+    switch (level)
+    {
+    case JET_IdxInfo:
+    case JET_IdxInfoList:
+        if (cb < sizeof(JET_INDEXLIST)) return JET_errBufferTooSmall;
+        if (level == JET_IdxInfo && !ix) return JET_errIndexNotFound;
+        return build_index_list( s, t, level == JET_IdxInfo ? ix->name : NULL, ansi, result );
+    case JET_IdxInfoCount:
+        if (cb < 4) return JET_errInvalidBufferSize;
+        *(DWORD *)result = t->nidx - 1;
+        return JET_errSuccess;
+    case JET_IdxInfoLangid:
+        if (cb < 2) return JET_errInvalidBufferSize;
+        *(WORD *)result = 0x409;
+        return JET_errSuccess;
+    case JET_IdxInfoVarSegMac:
+    case JET_IdxInfoKeyMost:
+    case JET_IdxInfoSpaceAlloc:
+        if (cb < 4) return JET_errInvalidBufferSize;
+        *(DWORD *)result = level == JET_IdxInfoSpaceAlloc ? 1 : JET_cbKeyMost;
+        return JET_errSuccess;
+    default:
+        return JET_errInvalidParameter;
+    }
+}
+
+static void fill_objectinfo( JET_OBJECTINFO *oi, struct table *t )
+{
+    memset( oi, 0, sizeof(*oi) );
+    oi->cbStruct = sizeof(*oi);
+    oi->objtyp = JET_objtypTable;
+    oi->dtCreate = t->created;
+    oi->dtUpdate = t->updated;
+    oi->cRecord = t->idx[0]->n;
+    oi->cPage = 1 + t->idx[0]->n / 32;
+}
+
+static JET_ERR table_info( struct table *t, void *result, unsigned long cb, unsigned long level, BOOL ansi )
+{
+    if (!result) return JET_errInvalidParameter;
+    switch (level)
+    {
+    case JET_TblInfo:
+        if (cb < sizeof(JET_OBJECTINFO)) return JET_errInvalidBufferSize;
+        fill_objectinfo( result, t );
+        return JET_errSuccess;
+    case JET_TblInfoName:
+        return copy_name_out( t->name, ansi, result, cb );
+    case JET_TblInfoDbid:
+        return JET_errInvalidParameter;
+    default:
+        return JET_errInvalidParameter;
+    }
+}
+
+static JET_ERR build_object_list( struct session *s, struct database *db, BOOL ansi, JET_OBJECTLIST *ol )
+{
+    static const struct tspec spec[] =
+    {
+        { JET_coltypText, 64 }, { JET_coltypText, 64 }, { JET_coltypLong }, { JET_coltypIEEEDouble }, { JET_coltypIEEEDouble },
+        { JET_coltypLong }, { JET_coltypLong }, { JET_coltypLong }, { JET_coltypLong }
+    };
+    JET_COLUMNID ids[9];
+    struct cursor *c;
+    DWORD i, rows = 0;
+
+    if (!(c = new_temp_cursor( s, spec, ARRAY_SIZE(spec), ids, !ansi ))) return JET_errOutOfMemory;
+    for (i = 0; i < db->ntables; i++)
+    {
+        struct table *t = db->tables[i];
+        DWORD ty = JET_objtypTable, grbit = 0, flags = 0, nrec = t->idx[0]->n, npage = 1 + nrec / 32;
+        struct tval v[9], nm, cont;
+        JET_ERR err;
+        if (t->deleted) continue;
+        nm = str_val( ansi, t->name );
+        cont = str_val( ansi, L"Tables" );
+        v[0] = cont;
+        v[1] = nm;
+        v[2].p = &ty; v[2].len = 4;
+        v[3].p = &t->created; v[3].len = 8;
+        v[4].p = &t->updated; v[4].len = 8;
+        v[5].p = &grbit; v[5].len = 4;
+        v[6].p = &flags; v[6].len = 4;
+        v[7].p = &nrec; v[7].len = 4;
+        v[8].p = &npage; v[8].len = 4;
+        err = temp_push_row( c, ids, v, 9 );
+        free( (void *)nm.p );
+        free( (void *)cont.p );
+        if (err) { close_cursor( c ); return err; }
+        rows++;
+    }
+    memset( ol, 0, sizeof(*ol) );
+    ol->cbStruct = sizeof(*ol);
+    ol->tableid = (JET_TABLEID)c;
+    ol->cRecord = rows;
+    ol->columnidcontainername = ids[0];
+    ol->columnidobjectname = ids[1];
+    ol->columnidobjtyp = ids[2];
+    ol->columniddtCreate = ids[3];
+    ol->columniddtUpdate = ids[4];
+    ol->columnidgrbit = ids[5];
+    ol->columnidflags = ids[6];
+    ol->columnidcRecord = ids[7];
+    ol->columnidcPage = ids[8];
+    return JET_errSuccess;
+}
+
+static JET_ERR object_info( struct session *s, struct database *db, const WCHAR *name, void *result, unsigned long cb,
+                            unsigned long level, BOOL ansi )
+{
+    struct table *t;
+
+    if (!result) return JET_errInvalidParameter;
+    switch (level & 0x7fffffffu)
+    {
+    case JET_ObjInfo:
+        if (cb < sizeof(JET_OBJECTINFO)) return JET_errInvalidBufferSize;
+        if (!name || !(t = db_find_table( db, name ))) return JET_errObjectNotFound;
+        fill_objectinfo( result, t );
+        return JET_errSuccess;
+    case JET_ObjInfoListNoStats:
+    case JET_ObjInfoList:
+    case JET_ObjInfoNoStats:
+    case JET_ObjInfoListACM:
+        if (cb < sizeof(JET_OBJECTLIST)) return JET_errBufferTooSmall;
+        return build_object_list( s, db, ansi, result );
+    default:
+        return JET_errInvalidParameter;
+    }
+}
+
+#define INFO_PROLOGUE( cursorful ) \
+    struct session *s; struct cursor *c; JET_ERR err; \
+    lock(); \
+    if (!((err = need_cursor( sesid, tableid, &s, &c )))) {
+
+#define INFO_EPILOGUE  } unlock(); return err;
+
+JET_ERR JET_API JetGetTableColumnInfoW( JET_SESID sesid, JET_TABLEID tableid, const WCHAR *name, void *result,
+                                        unsigned long cb, unsigned long level )
+{
+    INFO_PROLOGUE(1)
+    TRACE( "%#Ix %#Ix %s %p %lu %lu\n", sesid, tableid, debugstr_w(name), result, cb, level );
+        err = table_column_info( s, c->table, name, result, cb, level, FALSE );
+    INFO_EPILOGUE
+}
+
+JET_ERR JET_API JetGetTableColumnInfoA( JET_SESID sesid, JET_TABLEID tableid, const char *name, void *result,
+                                        unsigned long cb, unsigned long level )
+{
+    WCHAR *nameW = NULL;
+    JET_ERR err;
+    struct session *s;
+    struct cursor *c;
+
+    if ((level & 0xff) != JET_ColInfoByColid && name) nameW = a2w( name );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+        err = table_column_info( s, c->table, (level & 0xff) == JET_ColInfoByColid ? (const WCHAR *)name : nameW, result, cb, level, TRUE );
+    unlock();
+    free( nameW );
+    return err;
+}
+
+JET_ERR JET_API JetGetTableIndexInfoW( JET_SESID sesid, JET_TABLEID tableid, const WCHAR *name, void *result,
+                                       unsigned long cb, unsigned long level )
+{
+    INFO_PROLOGUE(1)
+    TRACE( "%#Ix %#Ix %s %p %lu %lu\n", sesid, tableid, debugstr_w(name), result, cb, level );
+        err = table_index_info( s, c->table, name, result, cb, level, FALSE );
+    INFO_EPILOGUE
+}
+
+JET_ERR JET_API JetGetTableIndexInfoA( JET_SESID sesid, JET_TABLEID tableid, const char *name, void *result,
+                                       unsigned long cb, unsigned long level )
+{
+    WCHAR *nameW = a2w( name );
+    JET_ERR err;
+    struct session *s;
+    struct cursor *c;
+
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c ))) err = table_index_info( s, c->table, nameW, result, cb, level, TRUE );
+    unlock();
+    free( nameW );
+    return err;
+}
+
+JET_ERR JET_API JetGetTableInfoW( JET_SESID sesid, JET_TABLEID tableid, void *result, unsigned long cb, unsigned long level )
+{
+    INFO_PROLOGUE(1)
+    TRACE( "%#Ix %#Ix %p %lu %lu\n", sesid, tableid, result, cb, level );
+        if (level == JET_TblInfoDbid)
+        {
+            if (!result || cb < 4 || !c->table->db) err = JET_errInvalidParameter;
+            else
+            {
+                DWORD i;
+                err = JET_errInvalidParameter;
+                for (i = 0; i < s->ndbs; i++)
+                    if (s->dbs[i].open && s->dbs[i].db == c->table->db) { *(JET_DBID *)result = i + 2; err = 0; }
+            }
+        }
+        else err = table_info( c->table, result, cb, level, FALSE );
+    INFO_EPILOGUE
+}
+
+JET_ERR JET_API JetGetTableInfoA( JET_SESID sesid, JET_TABLEID tableid, void *result, unsigned long cb, unsigned long level )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    if (level == JET_TblInfoDbid) return JetGetTableInfoW( sesid, tableid, result, cb, level );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c ))) err = table_info( c->table, result, cb, level, TRUE );
+    unlock();
+    return err;
+}
