+/* ---- columns ---- */
+
+static BOOL valid_coltyp( DWORD t )
+{
+    return (t >= JET_coltypBit && t <= JET_coltypLongText) ||
+           (t >= JET_coltypUnsignedLong && t <= JET_coltypUnsignedShort);
+}
+
+static JET_ERR add_column( struct table *t, const WCHAR *name, DWORD type, DWORD cbmax, DWORD grbit,
+                           WORD cp, WORD langid, WORD country, WORD collate, const void *def, DWORD cbdef,
+                           JET_COLUMNID *pid )
+{
+    JET_COLUMNID id;
+    BOOL tagged = (grbit & JET_bitColumnTagged) != 0;
+
+    if (!valid_name( name )) return JET_errInvalidName;
+    if (!valid_coltyp( type )) return JET_errInvalidColumnType;
+    if (col_by_name( t, name, NULL )) return JET_errColumnDuplicate;
+    if ((grbit & JET_bitColumnFixed) && tagged) return JET_errInvalidParameter;
+    if (!tagged && is_lv_type( type )) tagged = TRUE;
+    if (tagged && (grbit & JET_bitColumnAutoincrement)) return JET_errInvalidParameter;
+    if ((grbit & JET_bitColumnMultiValued) && !tagged) return JET_errMultiValuedColumnMustBeTagged;
+    if ((grbit & JET_bitColumnFixed) && (type == JET_coltypText || type == JET_coltypBinary))
+        grbit &= ~JET_bitColumnFixed;
+    if ((grbit & JET_bitColumnAutoincrement) && type != JET_coltypLong && type != JET_coltypCurrency &&
+        type != JET_coltypLongLong && type != JET_coltypUnsignedLong)
+        return JET_errInvalidColumnType;
+    if ((grbit & JET_bitColumnEscrowUpdate) && type != JET_coltypLong && type != JET_coltypLongLong)
+        return JET_errInvalidColumnType;
+    if (type == JET_coltypText || type == JET_coltypBinary)
+    {
+        if (!cbmax) cbmax = JET_cbColumnMost;
+        if (cbmax > JET_cbColumnMost) return JET_errInvalidParameter;
+    }
+    if (is_text_type( type ) && cp != SG_CP_UNICODE) cp = SG_CP_ASCII;
+    if (def && !is_lv_type( type ) && cbdef > 255) return JET_errDefaultValueTooBig;
+    if (def && fixed_size( type ) && cbdef != fixed_size( type )) return JET_errInvalidBufferSize;
+    if (def && grbit & JET_bitColumnAutoincrement) return JET_errInvalidParameter;
+    if (!table_add_column( t, name, type, cbmax, grbit, cp, langid, country, collate, def, cbdef, &id ))
+        return JET_errOutOfMemory;
+    if (pid) *pid = id;
+    return JET_errSuccess;
+}
+
+static JET_ERR need_ddl_cursor( JET_SESID sesid, JET_TABLEID tableid, struct session **s, struct cursor **c )
+{
+    JET_ERR err = need_cursor( sesid, tableid, s, c );
+    if (err) return err;
+    if ((*c)->table->db && (*c)->table->db->readonly) return JET_errDatabaseFileReadOnly;
+    if ((*c)->table->refs > 1) return JET_errTableInUse;
+    return JET_errSuccess;
+}
+
+JET_ERR JET_API JetAddColumnW( JET_SESID sesid, JET_TABLEID tableid, const WCHAR *name, const JET_COLUMNDEF *def,
+                               const void *pvdef, unsigned long cbdef, JET_COLUMNID *pid )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %s %p %p %lu %p\n", sesid, tableid, debugstr_w(name), def, pvdef, cbdef, pid );
+    if (!def || def->cbStruct < sizeof(*def)) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_ddl_cursor( sesid, tableid, &s, &c )))
+    {
+        JET_COLUMNID id = 0;
+        err = add_column( c->table, name, def->coltyp, def->cbMax, def->grbit, def->cp, def->langid, def->wCountry,
+                          def->wCollate, pvdef, pvdef ? cbdef : 0, &id );
+        if (!err)
+        {
+            table_touch( s, c->table );
+            if (pid) *pid = id;
+        }
+    }
+    unlock();
+    return err;
+}
