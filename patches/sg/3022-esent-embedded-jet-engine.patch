+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wctype.h>
+
+#define JET_VERSION 0x0a00
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "esent.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(esent);
+
+#define SG_CP_UNICODE   1200
+#define SG_CP_ASCII     1252
+#define SG_FILETYPE_DATABASE 1
+#define SG_PAGE_SIZE    4096
+#define SG_MAX_KEY_COLS 16
+#define SG_DB_MAGIC     "SGESEDB1"
+
+static CRITICAL_SECTION esent_cs;
+static CRITICAL_SECTION_DEBUG esent_cs_debug =
+{
+    0, 0, &esent_cs,
+    { &esent_cs_debug.ProcessLocksList, &esent_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": esent_cs") }
+};
+static CRITICAL_SECTION esent_cs = { &esent_cs_debug, -1, 0, 0, 0, 0 };
+
+static void lock(void)   { EnterCriticalSection( &esent_cs ); }
+static void unlock(void) { LeaveCriticalSection( &esent_cs ); }
+
+static WCHAR *a2w( const char *s )
+{
+    int len;
+    WCHAR *ret;
+
+    if (!s) return NULL;
+    len = MultiByteToWideChar( CP_ACP, 0, s, -1, NULL, 0 );
+    if ((ret = malloc( len * sizeof(WCHAR) ))) MultiByteToWideChar( CP_ACP, 0, s, -1, ret, len );
+    return ret;
+}
+
+static WCHAR *wdup( const WCHAR *s )
+{
+    return s ? wcsdup( s ) : NULL;
+}
+
+/* ---------------------------------------------------------------------- */
+/* data model                                                             */
+
+struct value
+{
+    DWORD  len;
+    BYTE  *p;
+};
+
+struct cell
+{
+    DWORD         n;      /* number of values, 0 = NULL */
+    struct value *v;
+};
+
+struct row
+{
+    DWORD        rid;
+    DWORD        ncells;
+    struct cell *cells;
+};
+
+struct column
+{
+    DWORD        id;
+    WCHAR       *name;
+    DWORD        type;
+    DWORD        cbmax;
+    DWORD        grbit;
+    WORD         country, langid, cp, collate;
+    struct value def;
+    BOOL         has_def;
+    BOOL         deleted;
+};
+
+struct ientry
+{
+    BYTE       *key;
+    DWORD       keylen;
+    struct row *row;
+};
+
+struct idxkey
+{
+    DWORD slot;   /* column index in table->cols */
+    BOOL  desc;
+};
+
+struct index
+{
+    WCHAR        *name;
+    DWORD         grbit;
+    DWORD         nkeys;
+    struct idxkey keys[SG_MAX_KEY_COLS];
+    DWORD         lcid;
+    BOOL          sequential;   /* the hidden by-record-id index */
+    struct ientry *e;
+    DWORD         n, cap;
+};
+
+struct database;
+
+struct table
+{
+    WCHAR           *name;
+    struct database *db;
+    BOOL             temp;
+    BOOL             deleted;
+    DWORD            ncols, colcap;
+    struct column   *cols;
+    DWORD            nidx, idxcap;
+    struct index   **idx;       /* idx[0] is the sequential index */
+    struct index    *primary;
+    DWORD            next_rid;
+    DWORD            next_colid_fixed, next_colid_var, next_colid_tagged;
+    LONGLONG         autoinc[16];  /* per autoincrement column (by slot, see autoinc_slot) */
+    DWORD            autoinc_slot[16];
+    DWORD            nautoinc;
+    DWORD            refs;         /* open cursors */
+    double           created, updated;
+};
+
+struct database
+{
+    struct list      entry;
+    struct instance *inst;
+    WCHAR           *path;
+    DWORD            ntables, tablecap;
+    struct table   **tables;
+    BOOL             dirty;
+    BOOL             readonly;
+    DWORD            opens;
+    GUID             sig;
+    DWORD            state;
+};
+
+struct undo
+{
+    struct table *table;
+    DWORD         rid;
+    struct row   *old;    /* NULL for an insert */
+    DWORD         level;
+    LONG          escrow_delta;
+};
+
+struct sesdb
+{
+    struct database *db;
+    BOOL             open;
+};
+
+#define MAGIC_INSTANCE 0x4a494e53
+#define MAGIC_SESSION  0x4a534553
+#define MAGIC_CURSOR   0x4a435552
+
+struct param
+{
+    LONGLONG  value;
+    WCHAR    *str;
+    BOOL      set;
+};
+
+#define MAX_PARAM 200
+
+struct instance
+{
+    DWORD          magic;
+    struct list    entry;
+    WCHAR         *name;
+    BOOL           initialized;
+    struct param   params[MAX_PARAM];
+    struct list    sessions;
+    struct list    databases;
+    DWORD          nsessions;
+};
+
+struct session
+{
+    DWORD            magic;
+    struct list      entry;
+    struct instance *inst;
+    DWORD            level;
+    DWORD            nundo, undocap;
+    struct undo     *undo;
+    struct sesdb    *dbs;
+    DWORD            ndbs;
+    struct list      cursors;
+    JET_API_PTR      context;
+    JET_API_PTR      ls;
+};
+
+enum { CUR_BEFORE, CUR_AT, CUR_AFTER, CUR_DELETED };
+
+struct cursor
+{
+    DWORD            magic;
+    struct list      entry;
+    struct session  *ses;
+    struct table    *table;
+    struct index    *idx;
+    DWORD            state;
+    BYTE            *curkey;
+    DWORD            curkeylen;
+    DWORD            currid;
+    int              prep;        /* -1 = none, else JET_prep* */
+    struct row      *copy;
+    DWORD            copy_rid;
+    BOOL             copy_dirty;
+    BYTE            *mk;          /* key under construction */
+    DWORD            mklen, mkcols;
+    BOOL             mk_valid;
+    BYTE            *hi, *lo;     /* range limits */
+    DWORD            hilen, lolen;
+    BOOL             hi_incl, lo_incl;
+    BOOL             owns_table;  /* temporary table owned by the cursor */
+    JET_API_PTR      ls;
+    BOOL             temp_order;
+};
+
+static struct list instances = LIST_INIT( instances );
+static struct instance *default_instance;
+
+static struct instance *find_instance( JET_INSTANCE inst )
+{
+    struct instance *i;
+
+    if (!inst) return default_instance;
+    LIST_FOR_EACH_ENTRY( i, &instances, struct instance, entry )
+        if ((JET_INSTANCE)i == inst) return i;
+    return NULL;
+}
+
+static struct session *find_session( JET_SESID id )
+{
+    struct instance *i;
+    struct session *s;
+
+    LIST_FOR_EACH_ENTRY( i, &instances, struct instance, entry )
+        LIST_FOR_EACH_ENTRY( s, &i->sessions, struct session, entry )
+            if ((JET_SESID)s == id) return s;
+    return NULL;
+}
+
+static struct cursor *find_cursor( struct session *s, JET_TABLEID id )
+{
+    struct cursor *c;
+
+    if (!s) return NULL;
+    LIST_FOR_EACH_ENTRY( c, &s->cursors, struct cursor, entry )
+        if ((JET_TABLEID)c == id) return c;
+    return NULL;
+}
+
+static struct database *find_db( struct instance *inst, const WCHAR *path )
+{
+    struct database *db;
+    WCHAR full[MAX_PATH];
+
+    if (!GetFullPathNameW( path, MAX_PATH, full, NULL )) lstrcpynW( full, path, MAX_PATH );
+    LIST_FOR_EACH_ENTRY( db, &inst->databases, struct database, entry )
+        if (!wcsicmp( db->path, full )) return db;
+    return NULL;
+}
+
+/* ---------------------------------------------------------------------- */
+/* values, rows, keys                                                     */
+
+static void free_value( struct value *v ) { free( v->p ); v->p = NULL; v->len = 0; }
+
+static BOOL copy_value( struct value *dst, const struct value *src )
+{
+    dst->len = src->len;
+    dst->p = NULL;
+    if (src->len || src->p)
+    {
+        if (!(dst->p = malloc( src->len ? src->len : 1 ))) return FALSE;
+        if (src->len) memcpy( dst->p, src->p, src->len );
+    }
+    return TRUE;
+}
+
+static void free_cell( struct cell *c )
+{
+    DWORD i;
+    for (i = 0; i < c->n; i++) free_value( &c->v[i] );
+    free( c->v );
+    c->v = NULL;
+    c->n = 0;
+}
+
+static void free_row( struct row *r )
+{
+    DWORD i;
+    if (!r) return;
+    for (i = 0; i < r->ncells; i++) free_cell( &r->cells[i] );
+    free( r->cells );
+    free( r );
+}
+
+static BOOL copy_cell( struct cell *dst, const struct cell *src )
+{
+    DWORD i;
+
+    dst->n = 0;
+    dst->v = NULL;
+    if (!src->n) return TRUE;
+    if (!(dst->v = calloc( src->n, sizeof(*dst->v) ))) return FALSE;
+    for (i = 0; i < src->n; i++)
+    {
+        if (!copy_value( &dst->v[i], &src->v[i] )) { dst->n = i; free_cell( dst ); return FALSE; }
+    }
+    dst->n = src->n;
+    return TRUE;
+}
+
+static struct row *copy_row( const struct row *src )
+{
+    struct row *r;
+    DWORD i;
+
+    if (!(r = calloc( 1, sizeof(*r) ))) return NULL;
+    r->rid = src->rid;
+    r->ncells = src->ncells;
+    if (src->ncells && !(r->cells = calloc( src->ncells, sizeof(*r->cells) ))) { free( r ); return NULL; }
+    for (i = 0; i < src->ncells; i++)
+    {
+        if (!copy_cell( &r->cells[i], &src->cells[i] ))
+        {
+            r->ncells = i;
+            free_row( r );
+            return NULL;
+        }
+    }
+    return r;
+}
+
+static struct row *new_row( DWORD ncells )
+{
+    struct row *r = calloc( 1, sizeof(*r) );
+    if (!r) return NULL;
+    if (ncells && !(r->cells = calloc( ncells, sizeof(*r->cells) ))) { free( r ); return NULL; }
+    r->ncells = ncells;
+    return r;
+}
+
+/* make sure the row has a cell for every column of the table */
+static BOOL row_resize( struct row *r, DWORD ncells )
+{
+    struct cell *tmp;
+
+    if (r->ncells >= ncells) return TRUE;
+    if (!(tmp = realloc( r->cells, ncells * sizeof(*tmp) ))) return FALSE;
+    memset( tmp + r->ncells, 0, (ncells - r->ncells) * sizeof(*tmp) );
+    r->cells = tmp;
+    r->ncells = ncells;
+    return TRUE;
+}
+
+static DWORD fixed_size( DWORD type )
+{
+    switch (type)
+    {
+    case JET_coltypBit:
+    case JET_coltypUnsignedByte:  return 1;
+    case JET_coltypShort:
+    case JET_coltypUnsignedShort: return 2;
+    case JET_coltypLong:
+    case JET_coltypIEEESingle:
+    case JET_coltypUnsignedLong:  return 4;
+    case JET_coltypCurrency:
+    case JET_coltypIEEEDouble:
+    case JET_coltypDateTime:
+    case JET_coltypLongLong:      return 8;
+    case JET_coltypGUID:          return 16;
+    default: return 0;
+    }
+}
+
+static BOOL is_lv_type( DWORD type ) { return type == JET_coltypLongBinary || type == JET_coltypLongText; }
+static BOOL is_text_type( DWORD type ) { return type == JET_coltypText || type == JET_coltypLongText; }
+static BOOL is_unicode_col( const struct column *c ) { return is_text_type( c->type ) && c->cp == SG_CP_UNICODE; }
+
+static struct column *col_by_id( struct table *t, DWORD id, DWORD *slot )
+{
+    DWORD i;
+    for (i = 0; i < t->ncols; i++)
+        if (t->cols[i].id == id && !t->cols[i].deleted) { if (slot) *slot = i; return &t->cols[i]; }
+    return NULL;
+}
+
+static struct column *col_by_name( struct table *t, const WCHAR *name, DWORD *slot )
+{
+    DWORD i;
+    for (i = 0; i < t->ncols; i++)
+        if (!t->cols[i].deleted && !wcsicmp( t->cols[i].name, name )) { if (slot) *slot = i; return &t->cols[i]; }
+    return NULL;
+}
+
+/* key encoding: order preserving, each column segment prefix free */
+struct kbuf { BYTE *p; DWORD len, cap; };
+
+static BOOL kb_put( struct kbuf *k, const void *data, DWORD n )
+{
+    if (k->len + n > k->cap)
+    {
+        DWORD ncap = max( k->cap * 2, k->len + n + 32 );
+        BYTE *tmp = realloc( k->p, ncap );
+        if (!tmp) return FALSE;
+        k->p = tmp;
+        k->cap = ncap;
+    }
+    memcpy( k->p + k->len, data, n );
+    k->len += n;
+    return TRUE;
+}
+
+static BOOL kb_byte( struct kbuf *k, BYTE b ) { return kb_put( k, &b, 1 ); }
+
+static BOOL kb_escaped( struct kbuf *k, const BYTE *p, DWORD n, BOOL terminate )
+{
+    DWORD i;
+    for (i = 0; i < n; i++)
+    {
+        if (!kb_byte( k, p[i] )) return FALSE;
+        if (!p[i] && !kb_byte( k, 0xff )) return FALSE;
+    }
+    if (terminate) return kb_byte( k, 0 ) && kb_byte( k, 0 );
+    return TRUE;
+}
+
+static void load_be( BYTE *dst, const BYTE *src, DWORD n )
+{
+    DWORD i;
+    for (i = 0; i < n; i++) dst[i] = src[n - 1 - i];   /* little endian in, big endian out */
+}
+
+/* append the key segment for one column value (NULL = null) */
+static BOOL encode_segment( struct kbuf *k, const struct column *c, const struct value *v, BOOL desc,
+                            BOOL nulls_high, BOOL terminate )
+{
+    DWORD start = k->len, i;
+    BYTE tmp[16];
+
+    if (!v)
+    {
+        if (!kb_byte( k, nulls_high ? 0xff : 0x00 )) return FALSE;
+    }
+    else
+    {
+        if (!kb_byte( k, 0x7f )) return FALSE;
+        switch (c->type)
+        {
+        case JET_coltypBit:
+            if (!kb_byte( k, v->len && v->p[0] ? 1 : 0 )) return FALSE;
+            break;
+        case JET_coltypUnsignedByte:
+            if (!kb_byte( k, v->len ? v->p[0] : 0 )) return FALSE;
+            break;
+        case JET_coltypShort:
+        case JET_coltypLong:
+        case JET_coltypCurrency:
+        case JET_coltypLongLong:
+        {
+            DWORD n = fixed_size( c->type );
+            memset( tmp, 0, sizeof(tmp) );
+            memcpy( tmp, v->p, min( n, v->len ) );
+            load_be( tmp + 8, tmp, n );
+            tmp[8] ^= 0x80;
+            if (!kb_put( k, tmp + 8, n )) return FALSE;
+            break;
+        }
+        case JET_coltypUnsignedShort:
+        case JET_coltypUnsignedLong:
+        {
+            DWORD n = fixed_size( c->type );
+            memset( tmp, 0, sizeof(tmp) );
+            memcpy( tmp, v->p, min( n, v->len ) );
+            load_be( tmp + 8, tmp, n );
+            if (!kb_put( k, tmp + 8, n )) return FALSE;
+            break;
+        }
+        case JET_coltypIEEESingle:
+        case JET_coltypIEEEDouble:
+        case JET_coltypDateTime:
+        {
+            DWORD n = fixed_size( c->type );
+            memset( tmp, 0, sizeof(tmp) );
+            memcpy( tmp, v->p, min( n, v->len ) );
+            load_be( tmp + 8, tmp, n );
+            if (tmp[8] & 0x80) for (i = 0; i < n; i++) tmp[8 + i] ^= 0xff;
+            else tmp[8] ^= 0x80;
+            if (!kb_put( k, tmp + 8, n )) return FALSE;
+            break;
+        }
+        case JET_coltypGUID:
+            memset( tmp, 0, 16 );
+            memcpy( tmp, v->p, min( 16, v->len ) );
+            if (!kb_put( k, tmp, 16 )) return FALSE;
+            break;
+        case JET_coltypText:
+        case JET_coltypLongText:
+            if (is_unicode_col( c ))
+            {
+                DWORD nch = v->len / sizeof(WCHAR);
+                struct kbuf *t = k;
+                for (i = 0; i < nch; i++)
+                {
+                    WCHAR ch = towupper( ((const WCHAR *)v->p)[i] );
+                    BYTE be[2] = { ch >> 8, ch & 0xff };
+                    if (!kb_escaped( t, be, 2, FALSE )) return FALSE;
+                }
+            }
+            else
+            {
+                for (i = 0; i < v->len; i++)
+                {
+                    BYTE ch = v->p[i];
+                    if (ch >= 'a' && ch <= 'z') ch -= 32;
+                    if (!kb_escaped( k, &ch, 1, FALSE )) return FALSE;
+                }
+            }
+            if (terminate && !(kb_byte( k, 0 ) && kb_byte( k, 0 ))) return FALSE;
+            break;
+        default:
+            if (!kb_escaped( k, v->p, v->len, terminate )) return FALSE;
+            break;
+        }
+    }
+    if (desc) for (i = start; i < k->len; i++) k->p[i] ^= 0xff;
+    return TRUE;
+}
+
+static int cmp_keys( const BYTE *a, DWORD alen, const BYTE *b, DWORD blen )
+{
+    DWORD n = min( alen, blen );
+    int r = n ? memcmp( a, b, n ) : 0;
+    if (r) return r;
+    return alen < blen ? -1 : alen > blen ? 1 : 0;
+}
+
+/* compare an entry key against a (possibly partial) search key: 0 if the key is a prefix */
+static int cmp_prefix( const BYTE *e, DWORD elen, const BYTE *k, DWORD klen )
+{
+    DWORD n = min( elen, klen );
+    int r = n ? memcmp( e, k, n ) : 0;
+    if (r) return r;
+    return elen < klen ? -1 : 0;
+}
+
+/* The values of a column in a row for index purposes. */
+static const struct cell *row_cell( const struct row *r, DWORD slot )
+{
+    static const struct cell null_cell;
+    return slot < r->ncells ? &r->cells[slot] : &null_cell;
+}
+
+/* Compute the key tuples a row contributes to an index (cross product over multi-values). */
+static BOOL index_keys( struct table *t, struct index *ix, const struct row *r, struct kbuf **keys, DWORD *nkeys )
+{
+    DWORD i, combos = 1, total, c;
+    struct kbuf *out;
+    BOOL ignore_any = (ix->grbit & JET_bitIndexIgnoreAnyNull) != 0;
+    BOOL ignore_first = (ix->grbit & JET_bitIndexIgnoreFirstNull) != 0;
+    BOOL ignore_all = (ix->grbit & JET_bitIndexIgnoreNull) != 0;
+    DWORD nonnull = 0;
+    BOOL nulls_high = (ix->grbit & JET_bitIndexSortNullsHigh) != 0;
+
+    *keys = NULL;
+    *nkeys = 0;
+    if (ix->sequential)
+    {
+        BYTE be[4] = { r->rid >> 24, r->rid >> 16, r->rid >> 8, r->rid };
+        if (!(out = calloc( 1, sizeof(*out) ))) return FALSE;
+        kb_put( out, be, 4 );
+        *keys = out;
+        *nkeys = 1;
+        return TRUE;
+    }
+    for (i = 0; i < ix->nkeys; i++)
+    {
+        const struct cell *cell = row_cell( r, ix->keys[i].slot );
+        if (cell->n) { nonnull++; if (cell->n > 1) combos *= cell->n; }
+        else
+        {
+            if (ignore_any) return TRUE;
+            if (ignore_first && i == 0) return TRUE;
+        }
+    }
+    if (ignore_all && !nonnull) return TRUE;
+    total = combos;
+    if (!(out = calloc( total, sizeof(*out) ))) return FALSE;
+    for (c = 0; c < total; c++)
+    {
+        DWORD rem = c;
+        for (i = 0; i < ix->nkeys; i++)
+        {
+            const struct cell *cell = row_cell( r, ix->keys[i].slot );
+            const struct value *v = NULL;
+            if (cell->n) { v = &cell->v[rem % cell->n]; rem /= cell->n; }
+            if (!encode_segment( &out[c], &t->cols[ix->keys[i].slot], v, ix->keys[i].desc, nulls_high, TRUE ))
+            {
+                for (i = 0; i <= c; i++) free( out[i].p );
+                free( out );
+                return FALSE;
+            }
+        }
+    }
+    *keys = out;
+    *nkeys = total;
+    return TRUE;
+}
+
+static void free_keys( struct kbuf *keys, DWORD n )
+{
+    DWORD i;
+    for (i = 0; i < n; i++) free( keys[i].p );
+    free( keys );
+}
+
+/* binary search: first entry not less than (key,row) when row != NULL, else not less than key */
+static DWORD ix_lower_bound( const struct index *ix, const BYTE *key, DWORD keylen, DWORD rid, BOOL use_rid )
+{
+    DWORD lo = 0, hi = ix->n;
+
+    while (lo < hi)
+    {
+        DWORD mid = (lo + hi) / 2;
+        const struct ientry *e = &ix->e[mid];
+        int r = cmp_keys( e->key, e->keylen, key, keylen );
+        if (!r && use_rid) r = e->row->rid < rid ? -1 : e->row->rid > rid ? 1 : 0;
+        if (r < 0) lo = mid + 1; else hi = mid;
+    }
+    return lo;
+}
+
+/* first entry with prefix-compare >= 0 / > 0 */
+static DWORD ix_prefix_bound( const struct index *ix, const BYTE *key, DWORD keylen, BOOL upper )
+{
+    DWORD lo = 0, hi = ix->n;
+
+    while (lo < hi)
+    {
+        DWORD mid = (lo + hi) / 2;
+        int r = cmp_prefix( ix->e[mid].key, ix->e[mid].keylen, key, keylen );
+        if (upper ? r <= 0 : r < 0) lo = mid + 1; else hi = mid;
+    }
+    return lo;
+}
+
+static BOOL ix_insert_at( struct index *ix, DWORD pos, BYTE *key, DWORD keylen, struct row *row )
+{
+    if (ix->n == ix->cap)
+    {
+        DWORD ncap = ix->cap ? ix->cap * 2 : 16;
+        struct ientry *tmp = realloc( ix->e, ncap * sizeof(*tmp) );
+        if (!tmp) return FALSE;
+        ix->e = tmp;
+        ix->cap = ncap;
+    }
+    memmove( &ix->e[pos + 1], &ix->e[pos], (ix->n - pos) * sizeof(*ix->e) );
+    ix->e[pos].key = key;
+    ix->e[pos].keylen = keylen;
+    ix->e[pos].row = row;
+    ix->n++;
+    return TRUE;
+}
+
+static void ix_remove_at( struct index *ix, DWORD pos )
+{
+    free( ix->e[pos].key );
+    memmove( &ix->e[pos], &ix->e[pos + 1], (ix->n - pos - 1) * sizeof(*ix->e) );
+    ix->n--;
+}
+
+/* Does this row, as keyed, collide with another row in a unique index? */
+static BOOL ix_has_dup( struct index *ix, const BYTE *key, DWORD keylen, DWORD rid )
+{
+    DWORD p = ix_lower_bound( ix, key, keylen, 0, FALSE );
+    while (p < ix->n && ix->e[p].keylen == keylen && !memcmp( ix->e[p].key, key, keylen ))
+    {
+        if (ix->e[p].row->rid != rid) return TRUE;
+        p++;
+    }
+    return FALSE;
+}
+
+static BOOL index_unique( const struct index *ix )
+{
+    return ix->sequential || (ix->grbit & (JET_bitIndexUnique | JET_bitIndexPrimary));
+}
+
+/* add the row to one index; returns an error code */
+static JET_ERR ix_add_row( struct table *t, struct index *ix, struct row *r )
+{
+    struct kbuf *keys;
+    DWORD nk, i;
+
+    if (!index_keys( t, ix, r, &keys, &nk )) return JET_errOutOfMemory;
+    for (i = 0; i < nk; i++)
+    {
+        if (index_unique( ix ) && !ix->sequential && ix_has_dup( ix, keys[i].p, keys[i].len, r->rid ))
+        {
+            DWORD j;
+            for (j = 0; j < i; j++)
+            {
+                DWORD p = ix_lower_bound( ix, keys[j].p, keys[j].len, r->rid, TRUE );
+                if (p < ix->n && ix->e[p].row == r) ix_remove_at( ix, p );
+            }
+            free_keys( keys, nk );
+            return JET_errKeyDuplicate;
+        }
+        if (!ix_insert_at( ix, ix_lower_bound( ix, keys[i].p, keys[i].len, r->rid, TRUE ),
+                           keys[i].p, keys[i].len, r ))
+        {
+            free_keys( keys, nk );
+            return JET_errOutOfMemory;
+        }
+        keys[i].p = NULL;  /* ownership moved to the index */
+    }
+    free_keys( keys, nk );
+    return JET_errSuccess;
+}
+
+static void ix_remove_row( struct table *t, struct index *ix, const struct row *r )
+{
+    struct kbuf *keys;
+    DWORD nk, i;
+
+    if (!index_keys( t, ix, r, &keys, &nk )) return;
+    for (i = 0; i < nk; i++)
+    {
+        DWORD p = ix_lower_bound( ix, keys[i].p, keys[i].len, r->rid, TRUE );
+        if (p < ix->n && ix->e[p].row->rid == r->rid) ix_remove_at( ix, p );
+    }
+    free_keys( keys, nk );
+}
+
+static JET_ERR table_add_row( struct table *t, struct row *r )
+{
+    DWORD i;
+    JET_ERR err;
+
+    for (i = 0; i < t->nidx; i++)
+    {
+        if ((err = ix_add_row( t, t->idx[i], r )))
+        {
+            while (i--) ix_remove_row( t, t->idx[i], r );
+            return err;
+        }
+    }
+    return JET_errSuccess;
+}
+
+static void table_remove_row( struct table *t, const struct row *r )
+{
+    DWORD i;
+    for (i = 0; i < t->nidx; i++) ix_remove_row( t, t->idx[i], r );
+}
+
+static struct row *table_find_row( struct table *t, DWORD rid )
+{
+    struct index *seq = t->idx[0];
+    BYTE be[4] = { rid >> 24, rid >> 16, rid >> 8, rid };
+    DWORD p = ix_lower_bound( seq, be, 4, 0, FALSE );
+    if (p < seq->n && seq->e[p].row->rid == rid) return seq->e[p].row;
+    return NULL;
+}
+
+/* ---------------------------------------------------------------------- */
+/* tables and indexes                                                     */
+
+static struct index *new_index( const WCHAR *name, BOOL sequential )
+{
+    struct index *ix = calloc( 1, sizeof(*ix) );
+    if (!ix) return NULL;
+    ix->sequential = sequential;
+    ix->name = wdup( name );
+    return ix;
+}
+
+static void free_index( struct index *ix )
+{
+    DWORD i;
+    for (i = 0; i < ix->n; i++) free( ix->e[i].key );
+    free( ix->e );
+    free( ix->name );
+    free( ix );
+}
+
+static struct table *new_table( struct database *db, const WCHAR *name, BOOL temp )
+{
+    struct table *t = calloc( 1, sizeof(*t) );
+    FILETIME ft;
+    ULARGE_INTEGER u;
+
+    if (!t) return NULL;
+    t->db = db;
+    t->temp = temp;
+    t->name = wdup( name );
+    t->idxcap = 4;
+    t->idx = calloc( t->idxcap, sizeof(*t->idx) );
+    t->idx[0] = new_index( L"", TRUE );
+    t->nidx = 1;
+    t->next_rid = 1;
+    t->next_colid_fixed = 1;
+    t->next_colid_var = 128;
+    t->next_colid_tagged = 256;
+    GetSystemTimeAsFileTime( &ft );
+    u.LowPart = ft.dwLowDateTime; u.HighPart = ft.dwHighDateTime;
+    /* OLE date: days since 1899-12-30; FILETIME epoch 1601-01-01 is 109205 days earlier */
+    t->created = t->updated = (double)u.QuadPart / 864000000000.0 - 109205.0;
+    if (!t->name || !t->idx || !t->idx[0]) return NULL;
+    return t;
+}
+
+static void free_table( struct table *t )
+{
+    DWORD i;
+    if (!t) return;
+    for (i = 0; i < t->idx[0]->n; i++) free_row( t->idx[0]->e[i].row );
+    for (i = 0; i < t->nidx; i++) free_index( t->idx[i] );
+    free( t->idx );
+    for (i = 0; i < t->ncols; i++)
+    {
+        free( t->cols[i].name );
+        free_value( &t->cols[i].def );
+    }
+    free( t->cols );
+    free( t->name );
+    free( t );
+}
+
+static struct table *db_find_table( struct database *db, const WCHAR *name )
+{
+    DWORD i;
+    for (i = 0; i < db->ntables; i++)
+        if (!db->tables[i]->deleted && !wcsicmp( db->tables[i]->name, name )) return db->tables[i];
+    return NULL;
+}
+
+static BOOL db_add_table( struct database *db, struct table *t )
+{
+    if (db->ntables == db->tablecap)
+    {
+        DWORD ncap = db->tablecap ? db->tablecap * 2 : 8;
+        struct table **tmp = realloc( db->tables, ncap * sizeof(*tmp) );
+        if (!tmp) return FALSE;
+        db->tables = tmp;
+        db->tablecap = ncap;
+    }
+    db->tables[db->ntables++] = t;
+    return TRUE;
+}
+
+static struct index *table_find_index( struct table *t, const WCHAR *name )
+{
+    DWORD i;
+    for (i = 1; i < t->nidx; i++)
+        if (!wcsicmp( t->idx[i]->name, name )) return t->idx[i];
+    return NULL;
+}
+
+static struct index *table_default_index( struct table *t )
+{
+    return t->primary ? t->primary : t->idx[0];
+}
+
+static BOOL table_add_column( struct table *t, const WCHAR *name, DWORD type, DWORD cbmax, DWORD grbit,
+                              WORD cp, WORD langid, WORD country, WORD collate, const void *def, DWORD cbdef,
+                              JET_COLUMNID *id )
+{
+    struct column *c;
+    BOOL tagged = (grbit & JET_bitColumnTagged) || is_lv_type( type );
+
+    if (t->ncols == t->colcap)
+    {
+        DWORD ncap = t->colcap ? t->colcap * 2 : 8;
+        struct column *tmp = realloc( t->cols, ncap * sizeof(*tmp) );
+        if (!tmp) return FALSE;
+        t->cols = tmp;
+        t->colcap = ncap;
+    }
+    c = &t->cols[t->ncols];
+    memset( c, 0, sizeof(*c) );
+    if (!(c->name = wdup( name ))) return FALSE;
+    c->type = type;
+    c->cbmax = cbmax;
+    c->cp = cp;
+    c->langid = langid;
+    c->country = country;
+    c->collate = collate;
+    if (tagged) { c->id = t->next_colid_tagged++; grbit |= JET_bitColumnTagged; grbit &= ~JET_bitColumnFixed; }
+    else if (type == JET_coltypText || type == JET_coltypBinary) c->id = t->next_colid_var++;
+    else { c->id = t->next_colid_fixed++; grbit |= JET_bitColumnFixed; }
+    c->grbit = grbit;
+    if (def)
+    {
+        c->has_def = TRUE;
+        c->def.len = cbdef;
+        c->def.p = malloc( cbdef ? cbdef : 1 );
+        if (!c->def.p) { free( c->name ); return FALSE; }
+        if (cbdef) memcpy( c->def.p, def, cbdef );
+    }
+    if (grbit & JET_bitColumnAutoincrement)
+    {
+        if (t->nautoinc < ARRAY_SIZE(t->autoinc))
+        {
+            t->autoinc_slot[t->nautoinc] = t->ncols;
+            t->autoinc[t->nautoinc++] = 1;
+        }
+    }
+    *id = c->id;
+    t->ncols++;
+    return TRUE;
+}
+
+/* ---------------------------------------------------------------------- */
+/* instances and parameters                                               */
+
+static const struct { DWORD id; LONGLONG value; const WCHAR *str; } param_defaults[] =
+{
+    { JET_paramSystemPath, 0, L".\\" },
+    { JET_paramTempPath, 0, L".\\" },
+    { JET_paramLogFilePath, 0, L".\\" },
+    { JET_paramBaseName, 0, L"edb" },
+    { JET_paramEventSource, 0, L"" },
+    { JET_paramMaxSessions, 16 },
+    { JET_paramMaxOpenTables, 300 },
+    { JET_paramMaxCursors, 1024 },
+    { JET_paramMaxVerPages, 64 },
+    { JET_paramMaxTemporaryTables, 20 },
+    { JET_paramLogFileSize, 5120 },
+    { JET_paramLogBuffers, 84 },
+    { JET_paramCircularLog, 0 },
+    { JET_paramDbExtensionSize, 256 },
+    { JET_paramPageTempDBMin, 0 },
+    { JET_paramCacheSizeMin, 1 },
+    { JET_paramCacheSizeMax, 0x7fffffff },
+    { JET_paramCheckpointDepthMax, 20971520 },
+    { JET_paramMaxInstances, 10 },
+    { JET_paramCreatePathIfNotExist, 0 },
+    { JET_paramRecovery, 0, L"on" },
+    { JET_paramKeyMost, 255 },
+    { JET_paramEnableOnlineDefrag, 1 },
+};
+
+static void instance_defaults( struct instance *inst )
+{
+    DWORD i;
+    for (i = 0; i < ARRAY_SIZE(param_defaults); i++)
+    {
+        inst->params[param_defaults[i].id].value = param_defaults[i].value;
+        inst->params[param_defaults[i].id].str = param_defaults[i].str ? wcsdup( param_defaults[i].str ) : NULL;
+    }
+}
+
+static struct instance *create_instance( const WCHAR *name )
+{
+    struct instance *inst = calloc( 1, sizeof(*inst) );
+    if (!inst) return NULL;
+    inst->magic = MAGIC_INSTANCE;
+    inst->name = wdup( name );
+    list_init( &inst->sessions );
+    list_init( &inst->databases );
+    instance_defaults( inst );
+    list_add_tail( &instances, &inst->entry );
+    return inst;
+}
+
+/* ---------------------------------------------------------------------- */
+/* persistence                                                            */
+
+struct wbuf { BYTE *p; size_t len, cap; BOOL err; };
+
+static void wb_put( struct wbuf *w, const void *d, size_t n )
+{
+    if (w->err) return;
+    if (w->len + n > w->cap)
+    {
+        size_t ncap = max( w->cap * 2, w->len + n + 4096 );
+        BYTE *tmp = realloc( w->p, ncap );
+        if (!tmp) { w->err = TRUE; return; }
+        w->p = tmp;
+        w->cap = ncap;
+    }
+    if (n) memcpy( w->p + w->len, d, n );
+    w->len += n;
+}
+
+static void wb_u32( struct wbuf *w, DWORD v ) { wb_put( w, &v, 4 ); }
+static void wb_u64( struct wbuf *w, LONGLONG v ) { wb_put( w, &v, 8 ); }
+static void wb_str( struct wbuf *w, const WCHAR *s )
+{
+    DWORD n = s ? lstrlenW( s ) : 0;
+    wb_u32( w, s ? n + 1 : 0 );
+    if (s) wb_put( w, s, n * sizeof(WCHAR) );
+}
+
+static void serialize_db( struct database *db, struct wbuf *w )
+{
+    DWORD t, i, j, nlive = 0;
+
+    wb_put( w, SG_DB_MAGIC, 8 );
+    wb_u32( w, 1 );
+    wb_put( w, &db->sig, sizeof(db->sig) );
+    wb_u32( w, db->state );
+    for (t = 0; t < db->ntables; t++) if (!db->tables[t]->deleted) nlive++;
+    wb_u32( w, nlive );
+    for (t = 0; t < db->ntables; t++)
+    {
+        struct table *tb = db->tables[t];
+        if (tb->deleted) continue;
+        wb_str( w, tb->name );
+        wb_u32( w, tb->next_rid );
+        wb_u32( w, tb->next_colid_fixed );
+        wb_u32( w, tb->next_colid_var );
+        wb_u32( w, tb->next_colid_tagged );
+        wb_u64( w, *(LONGLONG *)&tb->created );
+        wb_u32( w, tb->nautoinc );
+        for (i = 0; i < tb->nautoinc; i++) { wb_u32( w, tb->autoinc_slot[i] ); wb_u64( w, tb->autoinc[i] ); }
+        wb_u32( w, tb->ncols );
+        for (i = 0; i < tb->ncols; i++)
+        {
+            struct column *c = &tb->cols[i];
+            wb_u32( w, c->id ); wb_str( w, c->name ); wb_u32( w, c->type ); wb_u32( w, c->cbmax );
+            wb_u32( w, c->grbit ); wb_u32( w, c->cp | (c->langid << 16) );
+            wb_u32( w, c->country | (c->collate << 16) );
+            wb_u32( w, c->deleted ); wb_u32( w, c->has_def ); wb_u32( w, c->def.len );
+            wb_put( w, c->def.p, c->has_def ? c->def.len : 0 );
+        }
+        wb_u32( w, tb->nidx - 1 );
+        for (i = 1; i < tb->nidx; i++)
+        {
+            struct index *ix = tb->idx[i];
+            wb_str( w, ix->name ); wb_u32( w, ix->grbit ); wb_u32( w, ix->lcid ); wb_u32( w, ix->nkeys );
+            for (j = 0; j < ix->nkeys; j++) { wb_u32( w, ix->keys[j].slot ); wb_u32( w, ix->keys[j].desc ); }
+            wb_u32( w, ix == tb->primary );
+        }
+        wb_u32( w, tb->idx[0]->n );
+        for (i = 0; i < tb->idx[0]->n; i++)
+        {
+            struct row *r = tb->idx[0]->e[i].row;
+            wb_u32( w, r->rid );
+            wb_u32( w, r->ncells );
+            for (j = 0; j < r->ncells; j++)
+            {
+                DWORD k;
+                wb_u32( w, r->cells[j].n );
+                for (k = 0; k < r->cells[j].n; k++)
+                {
+                    wb_u32( w, r->cells[j].v[k].len );
+                    wb_put( w, r->cells[j].v[k].p, r->cells[j].v[k].len );
+                }
+            }
+        }
+    }
+}
+
+static JET_ERR flush_db( struct database *db )
+{
+    struct wbuf w = { 0 };
+    WCHAR tmp[MAX_PATH + 8];
+    HANDLE file;
+    DWORD written;
+    BOOL ok;
+
+    if (db->readonly || !db->path) return JET_errSuccess;
+    serialize_db( db, &w );
+    if (w.err) { free( w.p ); return JET_errOutOfMemory; }
+    swprintf( tmp, ARRAY_SIZE(tmp), L"%s.tmp", db->path );
+    file = CreateFileW( tmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0 );
+    if (file == INVALID_HANDLE_VALUE) { free( w.p ); return JET_errDiskIO; }
+    ok = WriteFile( file, w.p, w.len, &written, NULL ) && written == w.len;
+    CloseHandle( file );
+    free( w.p );
+    if (!ok || !MoveFileExW( tmp, db->path, MOVEFILE_REPLACE_EXISTING ))
+    {
+        DeleteFileW( tmp );
+        return JET_errDiskIO;
+    }
+    db->dirty = FALSE;
+    return JET_errSuccess;
+}
+
+struct rbuf { const BYTE *p; size_t len, pos; BOOL err; };
+
+static DWORD rb_u32( struct rbuf *r )
+{
+    DWORD v = 0;
+    if (r->err || r->pos + 4 > r->len) { r->err = TRUE; return 0; }
+    memcpy( &v, r->p + r->pos, 4 );
+    r->pos += 4;
+    return v;
+}
+
+static LONGLONG rb_u64( struct rbuf *r )
+{
+    LONGLONG v = 0;
+    if (r->err || r->pos + 8 > r->len) { r->err = TRUE; return 0; }
+    memcpy( &v, r->p + r->pos, 8 );
+    r->pos += 8;
+    return v;
+}
+
+static BOOL rb_bytes( struct rbuf *r, void *dst, size_t n )
+{
+    if (r->err || n > r->len - r->pos) { r->err = TRUE; return FALSE; }
+    if (n) memcpy( dst, r->p + r->pos, n );
+    r->pos += n;
+    return TRUE;
+}
+
+static WCHAR *rb_str( struct rbuf *r )
+{
+    DWORD n = rb_u32( r );
+    WCHAR *s;
+    if (!n || r->err) return NULL;
+    if (n > 65536 || (size_t)(n - 1) * sizeof(WCHAR) > r->len - r->pos) { r->err = TRUE; return NULL; }
+    if (!(s = malloc( n * sizeof(WCHAR) ))) { r->err = TRUE; return NULL; }
+    rb_bytes( r, s, (n - 1) * sizeof(WCHAR) );
+    s[n - 1] = 0;
+    return s;
+}
+
+static JET_ERR load_db_buffer( struct database *db, const BYTE *data, size_t size )
+{
+    struct rbuf r = { data, size, 0, FALSE };
+    DWORD nt, t, i, j, nrows;
+    char magic[8];
+
+    if (!rb_bytes( &r, magic, 8 ) || memcmp( magic, SG_DB_MAGIC, 8 )) return JET_errDatabaseCorrupted;
+    if (rb_u32( &r ) != 1) return JET_errDatabaseCorrupted;
+    rb_bytes( &r, &db->sig, sizeof(db->sig) );
+    db->state = rb_u32( &r );
+    nt = rb_u32( &r );
+    for (t = 0; t < nt && !r.err; t++)
+    {
+        WCHAR *name = rb_str( &r );
+        struct table *tb;
+        DWORD ncols, nidx;
+        LONGLONG created;
+
+        if (!name) return JET_errDatabaseCorrupted;
+        tb = new_table( db, name, FALSE );
+        free( name );
+        if (!tb) return JET_errOutOfMemory;
+        if (!db_add_table( db, tb )) { free_table( tb ); return JET_errOutOfMemory; }
+        tb->next_rid = rb_u32( &r );
+        tb->next_colid_fixed = rb_u32( &r );
+        tb->next_colid_var = rb_u32( &r );
+        tb->next_colid_tagged = rb_u32( &r );
+        created = rb_u64( &r );
+        memcpy( &tb->created, &created, 8 );
+        tb->updated = tb->created;
+        tb->nautoinc = rb_u32( &r );
+        if (tb->nautoinc > ARRAY_SIZE(tb->autoinc)) return JET_errDatabaseCorrupted;
+        for (i = 0; i < tb->nautoinc; i++) { tb->autoinc_slot[i] = rb_u32( &r ); tb->autoinc[i] = rb_u64( &r ); }
+        ncols = rb_u32( &r );
+        if (ncols > 65536) return JET_errDatabaseCorrupted;
+        if (ncols && !(tb->cols = calloc( ncols, sizeof(*tb->cols) ))) return JET_errOutOfMemory;
+        tb->colcap = ncols;
+        for (i = 0; i < ncols && !r.err; i++)
+        {
+            struct column *c = &tb->cols[i];
+            DWORD v;
+            tb->ncols = i + 1;
+            c->id = rb_u32( &r ); c->name = rb_str( &r ); c->type = rb_u32( &r ); c->cbmax = rb_u32( &r );
+            c->grbit = rb_u32( &r );
+            v = rb_u32( &r ); c->cp = v & 0xffff; c->langid = v >> 16;
+            v = rb_u32( &r ); c->country = v & 0xffff; c->collate = v >> 16;
+            c->deleted = rb_u32( &r ); c->has_def = rb_u32( &r ); c->def.len = rb_u32( &r );
+            if (c->has_def)
+            {
+                if (c->def.len > r.len - r.pos) return JET_errDatabaseCorrupted;
+                c->def.p = malloc( c->def.len ? c->def.len : 1 );
+                if (!c->def.p) return JET_errOutOfMemory;
+                rb_bytes( &r, c->def.p, c->def.len );
+            }
+            if (!c->name) return JET_errDatabaseCorrupted;
+        }
+        nidx = rb_u32( &r );
+        if (nidx > 4096) return JET_errDatabaseCorrupted;
+        for (i = 0; i < nidx && !r.err; i++)
+        {
+            WCHAR *iname = rb_str( &r );
+            struct index *ix;
+            if (!iname || !(ix = new_index( iname, FALSE ))) { free( iname ); return JET_errOutOfMemory; }
+            free( iname );
+            ix->grbit = rb_u32( &r );
+            ix->lcid = rb_u32( &r );
+            ix->nkeys = rb_u32( &r );
+            if (ix->nkeys > SG_MAX_KEY_COLS) { free_index( ix ); return JET_errDatabaseCorrupted; }
+            for (j = 0; j < ix->nkeys; j++)
+            {
+                ix->keys[j].slot = rb_u32( &r );
+                ix->keys[j].desc = rb_u32( &r );
+                if (ix->keys[j].slot >= tb->ncols) { free_index( ix ); return JET_errDatabaseCorrupted; }
+            }
+            if (tb->nidx == tb->idxcap)
+            {
+                struct index **tmp = realloc( tb->idx, tb->idxcap * 2 * sizeof(*tmp) );
+                if (!tmp) { free_index( ix ); return JET_errOutOfMemory; }
+                tb->idx = tmp;
+                tb->idxcap *= 2;
+            }
+            tb->idx[tb->nidx++] = ix;
+            if (rb_u32( &r )) tb->primary = ix;
+        }
+        nrows = rb_u32( &r );
+        for (i = 0; i < nrows && !r.err; i++)
+        {
+            struct row *row;
+            DWORD rid = rb_u32( &r ), ncells = rb_u32( &r );
+            if (ncells > tb->ncols) return JET_errDatabaseCorrupted;
+            if (!(row = new_row( ncells ))) return JET_errOutOfMemory;
+            row->rid = rid;
+            for (j = 0; j < ncells && !r.err; j++)
+            {
+                DWORD k, n = rb_u32( &r );
+                if (n > r.len - r.pos) { free_row( row ); return JET_errDatabaseCorrupted; }
+                if (n && !(row->cells[j].v = calloc( n, sizeof(struct value) ))) { free_row( row ); return JET_errOutOfMemory; }
+                for (k = 0; k < n; k++)
+                {
+                    DWORD len = rb_u32( &r );
+                    struct value *v = &row->cells[j].v[k];
+                    if (r.err || len > r.len - r.pos) { r.err = TRUE; break; }
+                    v->len = len;
+                    if (!(v->p = malloc( len ? len : 1 ))) { free_row( row ); return JET_errOutOfMemory; }
+                    rb_bytes( &r, v->p, len );
+                    row->cells[j].n = k + 1;
+                }
+            }
+            if (r.err) { free_row( row ); return JET_errDatabaseCorrupted; }
+            if (table_add_row( tb, row )) { free_row( row ); return JET_errDatabaseCorrupted; }
+        }
+    }
+    return r.err ? JET_errDatabaseCorrupted : JET_errSuccess;
+}
+
+static void free_database( struct database *db )
+{
+    DWORD i;
+    for (i = 0; i < db->ntables; i++) free_table( db->tables[i] );
+    free( db->tables );
+    free( db->path );
+    free( db );
+}
+
+static struct database *new_database( struct instance *inst, const WCHAR *path )
+{
+    struct database *db = calloc( 1, sizeof(*db) );
+    WCHAR full[MAX_PATH];
+
+    if (!db) return NULL;
+    if (!GetFullPathNameW( path, MAX_PATH, full, NULL )) lstrcpynW( full, path, MAX_PATH );
+    db->path = wdup( full );
+    db->inst = inst;
+    {
+        static LONG counter;
+        DWORD tick = GetTickCount();
+        LONG c = InterlockedIncrement( &counter );
+        db->sig.Data1 = tick ^ (DWORD)(ULONG_PTR)db;
+        db->sig.Data2 = c;
+        db->sig.Data3 = GetCurrentProcessId();
+        memcpy( db->sig.Data4, &tick, 4 );
+    }
+    return db;
+}
+
+static JET_ERR load_db_file( struct instance *inst, const WCHAR *path, struct database **ret )
+{
+    HANDLE file;
+    LARGE_INTEGER size;
+    BYTE *data;
+    DWORD got;
+    struct database *db;
+    JET_ERR err;
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, 0 );
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        DWORD e = GetLastError();
+        return (e == ERROR_FILE_NOT_FOUND || e == ERROR_PATH_NOT_FOUND) ? JET_errFileNotFound : JET_errFileAccessDenied;
+    }
+    if (!GetFileSizeEx( file, &size ) || size.QuadPart > 0x7fffffff) { CloseHandle( file ); return JET_errDatabaseCorrupted; }
+    if (!(data = malloc( size.LowPart ? size.LowPart : 1 ))) { CloseHandle( file ); return JET_errOutOfMemory; }
+    if (!ReadFile( file, data, size.LowPart, &got, NULL ) || got != size.LowPart)
+    {
+        CloseHandle( file );
+        free( data );
+        return JET_errDiskIO;
+    }
+    CloseHandle( file );
+    if (!(db = new_database( inst, path ))) { free( data ); return JET_errOutOfMemory; }
+    err = load_db_buffer( db, data, size.LowPart );
+    free( data );
+    if (err) { free_database( db ); return err; }
+    *ret = db;
+    return JET_errSuccess;
+}
+
+
+/* ---------------------------------------------------------------------- */
+/* sessions, transactions, undo                                           */
+
+static struct param global_params[MAX_PARAM];
+
+static void undo_free_entries( struct session *s, DWORD from )
+{
+    DWORD i;
+    for (i = from; i < s->nundo; i++) free_row( s->undo[i].old );
+    s->nundo = from;
+}
+
+static JET_ERR undo_push( struct session *s, struct table *t, DWORD rid, struct row *old )
+{
+    struct undo *u;
+
+    if (!s->level || t->temp) { free_row( old ); return JET_errSuccess; }
+    if (s->nundo == s->undocap)
+    {
+        DWORD ncap = s->undocap ? s->undocap * 2 : 32;
+        struct undo *tmp = realloc( s->undo, ncap * sizeof(*tmp) );
+        if (!tmp) { free_row( old ); return JET_errOutOfMemory; }
+        s->undo = tmp;
+        s->undocap = ncap;
+    }
+    u = &s->undo[s->nundo++];
+    u->table = t;
+    u->rid = rid;
+    u->old = old;
+    u->level = s->level;
+    return JET_errSuccess;
+}
+
+static BOOL table_alive( struct table *t )
+{
+    DWORD i;
+    struct instance *inst;
+    struct database *db;
+
+    LIST_FOR_EACH_ENTRY( inst, &instances, struct instance, entry )
+        LIST_FOR_EACH_ENTRY( db, &inst->databases, struct database, entry )
+            for (i = 0; i < db->ntables; i++) if (db->tables[i] == t) return !t->deleted;
+    return FALSE;
+}
+
+static void undo_apply( struct session *s, DWORD level )
+{
+    while (s->nundo && s->undo[s->nundo - 1].level >= level)
+    {
+        struct undo *u = &s->undo[--s->nundo];
+        struct row *cur;
+
+        if (table_alive( u->table ))
+        {
+            if ((cur = table_find_row( u->table, u->rid )))
+            {
+                table_remove_row( u->table, cur );
+                free_row( cur );
+            }
+            if (u->old)
+            {
+                if (table_add_row( u->table, u->old )) free_row( u->old );
+                u->old = NULL;
+            }
+            if (u->table->db) u->table->db->dirty = TRUE;
+        }
+        free_row( u->old );
+        u->old = NULL;
+    }
+}
+
+/* writes the database out unless a big database is being batch-updated */
+static void commit_point( struct database *db )
+{
+    if (!db || !db->dirty) return;
+    flush_db( db );
+}
+
+static void session_commit_dbs( struct session *s )
+{
+    DWORD i;
+    for (i = 0; i < s->ndbs; i++)
+        if (s->dbs[i].open && s->dbs[i].db && s->dbs[i].db->dirty) commit_point( s->dbs[i].db );
+}
+
+static void close_cursor( struct cursor *c )
+{
+    list_remove( &c->entry );
+    if (c->table)
+    {
+        c->table->refs--;
+        if (c->owns_table) free_table( c->table );
+    }
+    free_row( c->copy );
+    free( c->curkey );
+    free( c->mk );
+    free( c->hi );
+    free( c->lo );
+    c->magic = 0;
+    free( c );
+}
+
+static void destroy_session( struct session *s )
+{
+    struct list *e;
+    DWORD i;
+
+    while ((e = list_head( &s->cursors ))) close_cursor( LIST_ENTRY( e, struct cursor, entry ) );
+    while (s->level) { undo_apply( s, s->level ); s->level--; }
+    undo_free_entries( s, 0 );
+    for (i = 0; i < s->ndbs; i++) if (s->dbs[i].open && s->dbs[i].db) s->dbs[i].db->opens--;
+    list_remove( &s->entry );
+    s->inst->nsessions--;
+    free( s->undo );
+    free( s->dbs );
+    s->magic = 0;
+    free( s );
+}
+
+static struct database *session_db( struct session *s, JET_DBID dbid )
+{
+    if (dbid < 2 || dbid - 2 >= s->ndbs || !s->dbs[dbid - 2].open) return NULL;
+    return s->dbs[dbid - 2].db;
+}
+
+static JET_DBID session_open_db( struct session *s, struct database *db )
+{
+    DWORD i;
+    struct sesdb *tmp;
+
+    for (i = 0; i < s->ndbs; i++)
+        if (s->dbs[i].open && s->dbs[i].db == db) return i + 2;
+    for (i = 0; i < s->ndbs; i++)
+        if (!s->dbs[i].open) goto found;
+    if (!(tmp = realloc( s->dbs, (s->ndbs + 1) * sizeof(*tmp) ))) return 0;
+    s->dbs = tmp;
+    i = s->ndbs++;
+found:
+    s->dbs[i].db = db;
+    s->dbs[i].open = TRUE;
+    db->opens++;
+    return i + 2;
+}
+
+static JET_ERR need_session( JET_SESID id, struct session **ses )
+{
+    *ses = find_session( id );
+    return *ses ? JET_errSuccess : JET_errInvalidSesid;
+}
