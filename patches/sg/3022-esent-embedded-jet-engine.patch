+JET_ERR JET_API JetGetColumnInfoA( JET_SESID sesid, JET_DBID dbid, const char *table, const char *column, void *result,
+                                   unsigned long cb, unsigned long level )
+{
+    WCHAR *tw = a2w( table ), *cw = NULL;
+    struct session *s;
+    struct table *t;
+    JET_ERR err;
+
+    if ((level & 0xff) != JET_ColInfoByColid) cw = a2w( column );
+    lock();
+    if (!(err = db_table_for_info( sesid, dbid, tw, &s, &t )))
+        err = table_column_info( s, t, (level & 0xff) == JET_ColInfoByColid ? (const WCHAR *)column : cw, result, cb, level, TRUE );
+    unlock();
+    free( tw );
+    free( cw );
+    return err;
+}
