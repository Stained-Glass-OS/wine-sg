+static JET_ERR init_instance( JET_INSTANCE *pinst )
+{
+    struct instance *inst;
+
+    if (!pinst || !*pinst)
+    {
+        if (!default_instance)
+        {
+            JET_INSTANCE h;
+            JET_ERR err = create_instance_api( &h, L"" );
+            if (err) return err;
+            default_instance = (struct instance *)h;
+        }
+        inst = default_instance;
+        if (pinst) *pinst = (JET_INSTANCE)inst;
+    }
+    else if (!(inst = find_instance( *pinst ))) return JET_errInvalidParameter;
+    if (inst->initialized) return JET_errAlreadyInitialized;
+    inst->initialized = TRUE;
+    return JET_errSuccess;
+}
+
+static JET_ERR term_instance( JET_INSTANCE h, JET_GRBIT grbit )
+{
+    struct instance *inst = find_instance( h );
+    struct list *e;
+    DWORD i;
+
+    if (!inst) return JET_errInvalidParameter;
+    if (!inst->initialized) return JET_errNotInitialized;
+    while ((e = list_head( &inst->sessions ))) destroy_session( LIST_ENTRY( e, struct session, entry ) );
+    while ((e = list_head( &inst->databases )))
+    {
+        struct database *db = LIST_ENTRY( e, struct database, entry );
+        if (db->dirty && !(grbit & (JET_bitTermAbrupt | JET_bitTermDirty))) flush_db( db );
+        list_remove( &db->entry );
+        free_database( db );
+    }
+    list_remove( &inst->entry );
+    for (i = 0; i < MAX_PARAM; i++) free( inst->params[i].str );
+    if (inst == default_instance) default_instance = NULL;
+    free( inst->name );
+    inst->magic = 0;
+    free( inst );
+    return JET_errSuccess;
+}
