+/* ---------------------------------------------------------------------- */
+/* cursors, tables, columns and indexes                                   */
+
+static struct cursor *new_cursor( struct session *s, struct table *t )
+{
+    struct cursor *c = calloc( 1, sizeof(*c) );
+
+    if (!c) return NULL;
+    c->magic = MAGIC_CURSOR;
+    c->ses = s;
+    c->table = t;
+    c->idx = table_default_index( t );
+    c->state = CUR_BEFORE;
+    c->prep = -1;
+    list_add_tail( &s->cursors, &c->entry );
+    t->refs++;
+    return c;
+}
+
+static JET_ERR need_cursor( JET_SESID sesid, JET_TABLEID tableid, struct session **ses, struct cursor **cur )
+{
+    *ses = find_session( sesid );
+    if (!*ses) return JET_errInvalidSesid;
+    *cur = find_cursor( *ses, tableid );
+    if (!*cur) return JET_errInvalidTableId;
+    return JET_errSuccess;
+}
+
+static BOOL valid_name( const WCHAR *name )
+{
+    DWORD len;
+
+    if (!name || !name[0]) return FALSE;
+    len = lstrlenW( name );
+    if (len > JET_cbNameMost) return FALSE;
+    if (name[0] == ' ' || name[len - 1] == ' ') return FALSE;
+    return TRUE;
+}
+
+static void table_touch( struct session *s, struct table *t )
+{
+    FILETIME ft;
+    ULARGE_INTEGER u;
+
+    GetSystemTimeAsFileTime( &ft );
+    u.LowPart = ft.dwLowDateTime; u.HighPart = ft.dwHighDateTime;
+    t->updated = (double)u.QuadPart / 864000000000.0 - 109205.0;
+    if (t->db) t->db->dirty = TRUE;
+}
+
+static JET_ERR create_table( struct session *s, JET_DBID dbid, const WCHAR *name, struct table **ret )
+{
+    struct database *db = session_db( s, dbid );
+    struct table *t;
+
+    if (!db) return JET_errInvalidDatabaseId;
+    if (db->readonly) return JET_errDatabaseFileReadOnly;
+    if (!valid_name( name )) return JET_errInvalidName;
+    if (db_find_table( db, name )) return JET_errTableDuplicate;
+    if (!(t = new_table( db, name, FALSE ))) return JET_errOutOfMemory;
+    if (!db_add_table( db, t )) { free_table( t ); return JET_errOutOfMemory; }
+    table_touch( s, t );
+    *ret = t;
+    return JET_errSuccess;
+}
