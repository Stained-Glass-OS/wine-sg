+    TRACE( "%#Ix %#Ix %p\n", sesid, tableid, ptableid );
+    if (!ptableid) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        if (!(n = new_cursor( s, c->table ))) err = JET_errOutOfMemory;
+        else
+        {
+            n->idx = c->idx;
+            n->state = c->state;
+            n->currid = c->currid;
+            if (c->curkey && (n->curkey = malloc( c->curkeylen ? c->curkeylen : 1 )))
+            {
+                memcpy( n->curkey, c->curkey, c->curkeylen );
+                n->curkeylen = c->curkeylen;
+            }
+            *ptableid = (JET_TABLEID)n;
+        }
+    }
+    unlock();
+    return err;
+}
