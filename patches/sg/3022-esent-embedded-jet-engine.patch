+/* ---------------------------------------------------------------------- */
+/* temporary tables, also used to return the "list" information           */
+
+struct tspec
+{
+    DWORD type;
+    DWORD cbmax;
+    DWORD grbit;
+};
+
+/* Build a table with the given columns that lives as long as its cursor. */
+static struct cursor *new_temp_cursor( struct session *s, const struct tspec *spec, DWORD n, JET_COLUMNID *ids,
+                                       BOOL unicode )
+{
+    struct table *t;
+    struct cursor *c;
+    DWORD i;
+    WCHAR name[16];
+
+    if (!(t = new_table( NULL, L"temp", TRUE ))) return NULL;
+    for (i = 0; i < n; i++)
+    {
+        swprintf( name, ARRAY_SIZE(name), L"c%u", i );
+        if (!table_add_column( t, name, spec[i].type, spec[i].cbmax, spec[i].grbit, unicode ? SG_CP_UNICODE : SG_CP_ASCII,
+                               0x409, 1, 0, NULL, 0, &ids[i] ))
+        {
+            free_table( t );
+            return NULL;
+        }
+    }
+    if (!(c = new_cursor( s, t ))) { free_table( t ); return NULL; }
+    c->owns_table = TRUE;
+    return c;
+}
+
+struct tval
+{
+    const void *p;
+    DWORD       len;
+};
+
+static JET_ERR temp_push_row( struct cursor *c, const JET_COLUMNID *ids, const struct tval *vals, DWORD n )
+{
+    struct table *t = c->table;
+    struct row *r;
+    DWORD i, slot;
+    JET_ERR err;
+
+    if (!(r = new_row( t->ncols ))) return JET_errOutOfMemory;
+    for (i = 0; i < n; i++)
+    {
+        if (!vals[i].p) continue;
+        if (!col_by_id( t, ids[i], &slot )) continue;
+        if (!(r->cells[slot].v = calloc( 1, sizeof(struct value) ))) { free_row( r ); return JET_errOutOfMemory; }
+        r->cells[slot].v[0].p = malloc( vals[i].len ? vals[i].len : 1 );
+        if (!r->cells[slot].v[0].p) { free_row( r ); return JET_errOutOfMemory; }
+        memcpy( r->cells[slot].v[0].p, vals[i].p, vals[i].len );
+        r->cells[slot].v[0].len = vals[i].len;
+        r->cells[slot].n = 1;
+    }
+    r->rid = t->next_rid++;
+    if ((err = table_add_row( t, r ))) { free_row( r ); return err; }
+    return JET_errSuccess;
+}
+
+static JET_ERR open_temp_table( JET_SESID sesid, const JET_COLUMNDEF *defs, DWORD n, JET_GRBIT grbit, JET_TABLEID *ptable,
+                                JET_COLUMNID *pids, DWORD lcid )
+{
+    struct session *s;
+    struct cursor *c;
+    struct table *t;
+    struct index *ix = NULL;
+    DWORD i, slot = 0;
+    JET_ERR err;
+    JET_COLUMNID tmp[256];
+    struct tspec *spec;
+
+    if (!ptable || !defs || !n || n > ARRAY_SIZE(tmp)) return JET_errInvalidParameter;
+    lock();
+    if ((err = need_session( sesid, &s ))) { unlock(); return err; }
+    if (!(spec = calloc( n, sizeof(*spec) ))) { unlock(); return JET_errOutOfMemory; }
+    for (i = 0; i < n; i++)
+    {
+        if (defs[i].cbStruct < sizeof(*defs) || !valid_coltyp( defs[i].coltyp )) { free( spec ); unlock(); return JET_errInvalidColumnType; }
+        spec[i].type = defs[i].coltyp;
+        spec[i].cbmax = defs[i].cbMax;
+        spec[i].grbit = defs[i].grbit & ~(JET_bitColumnTTKey | JET_bitColumnTTDescending);
+    }
+    if (!(c = new_temp_cursor( s, spec, n, tmp, TRUE ))) { free( spec ); unlock(); return JET_errOutOfMemory; }
+    t = c->table;
+    for (i = 0; i < n; i++)
+    {
+        col_by_id( t, tmp[i], &slot );
+        t->cols[slot].cp = defs[i].cp ? defs[i].cp : SG_CP_ASCII;
+        t->cols[slot].grbit |= defs[i].grbit & (JET_bitColumnTTKey | JET_bitColumnTTDescending | JET_bitColumnNotNULL);
+        if (defs[i].grbit & JET_bitColumnTTKey)
+        {
+            if (!ix)
+            {
+                ix = new_index( L"temp_key", FALSE );
+                if (!ix) { close_cursor( c ); free( spec ); unlock(); return JET_errOutOfMemory; }
+                ix->grbit = ((grbit & JET_bitTTUnique) ? JET_bitIndexUnique : 0) |
+                            ((grbit & JET_bitTTSortNullsHigh) ? JET_bitIndexSortNullsHigh : 0);
+            }
+            if (ix->nkeys < SG_MAX_KEY_COLS)
+            {
+                ix->keys[ix->nkeys].slot = slot;
+                ix->keys[ix->nkeys].desc = (defs[i].grbit & JET_bitColumnTTDescending) != 0;
+                ix->nkeys++;
+            }
+        }
+    }
+    if (ix)
+    {
+        if (t->nidx == t->idxcap)
+        {
+            struct index **p = realloc( t->idx, t->idxcap * 2 * sizeof(*p) );
+            if (!p) { free_index( ix ); close_cursor( c ); free( spec ); unlock(); return JET_errOutOfMemory; }
+            t->idx = p;
+            t->idxcap *= 2;
+        }
+        t->idx[t->nidx++] = ix;
+        c->idx = ix;
+        c->temp_order = TRUE;
+    }
+    if (pids) for (i = 0; i < n; i++) pids[i] = tmp[i];
+    *ptable = (JET_TABLEID)c;
+    free( spec );
+    unlock();
+    return JET_errSuccess;
+}
+
