+static JET_ERR db_table_for_info( JET_SESID sesid, JET_DBID dbid, const WCHAR *table, struct session **s, struct table **t )
+{
+    struct database *db;
+    JET_ERR err = need_session( sesid, s );
+
+    if (err) return err;
+    if (!(db = session_db( *s, dbid ))) return JET_errInvalidDatabaseId;
+    if (!table || !(*t = db_find_table( db, table ))) return JET_errObjectNotFound;
+    return JET_errSuccess;
+}
