+JET_ERR JET_API JetDeleteColumnW( JET_SESID sesid, JET_TABLEID tableid, const WCHAR *name )
+{
+    JET_ERR ret;
+    TRACE( "%#Ix %#Ix %s\n", sesid, tableid, debugstr_w(name) );
+    lock();
+    ret = delete_column( sesid, tableid, name );
+    unlock();
+    return ret;
+}
