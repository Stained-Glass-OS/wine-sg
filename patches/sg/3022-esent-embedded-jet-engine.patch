+/* ---------------------------------------------------------------------- */
+/* currency and navigation                                                */
+
+/* find the cursor's position in its index.  Returns the index of the entry; *exact tells if it is
+ * the current entry, otherwise it is where the current entry would be inserted. */
+static DWORD cursor_locate( struct cursor *c, BOOL *exact )
+{
+    struct index *ix = c->idx;
+    DWORD p = ix_lower_bound( ix, c->curkey, c->curkeylen, c->currid, TRUE );
+
+    *exact = p < ix->n && ix->e[p].row->rid == c->currid && ix->e[p].keylen == c->curkeylen &&
+             !memcmp( ix->e[p].key, c->curkey, c->curkeylen );
+    return p;
+}
+
+static BOOL entry_in_range( const struct cursor *c, const struct ientry *e )
+{
+    int r;
+
+    if (c->hi)
+    {
+        r = cmp_prefix( e->key, e->keylen, c->hi, c->hilen );
+        if (c->hi_incl ? r > 0 : r >= 0) return FALSE;
+    }
+    if (c->lo)
+    {
+        r = cmp_prefix( e->key, e->keylen, c->lo, c->lolen );
+        if (c->lo_incl ? r < 0 : r <= 0) return FALSE;
+        if (!c->lo_incl && r == 0) return FALSE;
+    }
+    return TRUE;
+}
+
+static JET_ERR cursor_move_to( struct cursor *c, LONGLONG target, BOOL forward )
+{
+    struct index *ix = c->idx;
+
+    if (target < 0)
+    {
+        c->state = CUR_BEFORE;
+        return JET_errNoCurrentRecord;
+    }
+    if (target >= ix->n)
+    {
+        c->state = CUR_AFTER;
+        return JET_errNoCurrentRecord;
+    }
+    if (!entry_in_range( c, &ix->e[target] ))
+    {
+        c->state = forward ? CUR_AFTER : CUR_BEFORE;
+        return JET_errNoCurrentRecord;
+    }
+    cursor_set_pos( c, &ix->e[target] );
+    return JET_errSuccess;
+}
+
+static JET_ERR cursor_move( struct cursor *c, int delta )
+{
+    struct index *ix = c->idx;
+    LONGLONG base, target;
+    BOOL exact;
+
+    if (delta == (int)JET_MoveFirst)
+    {
+        if (c->lo)
+        {
+            DWORD p = ix_prefix_bound( ix, c->lo, c->lolen, c->lo_incl ? FALSE : TRUE );
+            return cursor_move_to( c, p, TRUE );
+        }
+        return cursor_move_to( c, 0, TRUE );
+    }
+    if (delta == JET_MoveLast)
+    {
+        if (c->hi)
+        {
+            DWORD p = ix_prefix_bound( ix, c->hi, c->hilen, c->hi_incl );
+            return cursor_move_to( c, (LONGLONG)p - 1, FALSE );
+        }
+        return cursor_move_to( c, (LONGLONG)ix->n - 1, FALSE );
+    }
+    switch (c->state)
+    {
+    case CUR_BEFORE: base = -1; break;
+    case CUR_AFTER: base = ix->n; break;
+    case CUR_AT:
+    case CUR_DELETED:
+        base = cursor_locate( c, &exact );
+        if (!exact)
+        {
+            /* the entry is gone: positioned between its neighbours */
+            if (delta > 0) base--;
+        }
+        break;
+    default: base = -1; break;
+    }
+    target = base + delta;
+    if (target < 0 && delta < 0 && c->state == CUR_BEFORE) { c->state = CUR_BEFORE; return JET_errNoCurrentRecord; }
+    return cursor_move_to( c, target, delta > 0 );
+}
+
+JET_ERR JET_API JetMove( JET_SESID sesid, JET_TABLEID tableid, long crow, JET_GRBIT grbit )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %ld %#lx\n", sesid, tableid, crow, grbit );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c ))) err = cursor_move( c, crow );
+    unlock();
+    return err;
+}
+
+/* the row under the cursor, for reading */
+static JET_ERR cursor_row( struct cursor *c, struct row **row )
+{
+    switch (c->state)
+    {
+    case CUR_AT: break;
+    case CUR_DELETED: return JET_errRecordDeleted;
+    default: return JET_errNoCurrentRecord;
+    }
+    if (!(*row = table_find_row( c->table, c->currid ))) return JET_errRecordDeleted;
+    return JET_errSuccess;
+}
+
+/* ---- keys and seeks ---- */
+
+static void cursor_key_clear( struct cursor *c )
+{
+    free( c->mk );
+    c->mk = NULL; c->mklen = 0; c->mkcols = 0; c->mk_valid = FALSE;
+}
+
+static JET_ERR cursor_make_key( struct cursor *c, const void *data, DWORD cb, JET_GRBIT grbit )
+{
+    struct kbuf k;
+    struct index *ix = c->idx;
+    BOOL partial, end_limit, zero_len;
+
+    if ((grbit & JET_bitNewKey) || !c->mk_valid) cursor_key_clear( c );
+    if (grbit & JET_bitNormalizedKey)
+    {
+        free( c->mk );
+        if (!(c->mk = malloc( cb ? cb : 1 ))) return JET_errOutOfMemory;
+        if (cb) memcpy( c->mk, data, cb );
+        c->mklen = cb;
+        c->mk_valid = TRUE;
+        return JET_errSuccess;
+    }
+    if (ix->sequential)
+    {
+        BYTE be[4];
+        DWORD v = 0;
+        if (cb >= 4 && data) memcpy( &v, data, 4 );
+        be[0] = v >> 24; be[1] = v >> 16; be[2] = v >> 8; be[3] = v;
+        free( c->mk );
+        if (!(c->mk = malloc( 4 ))) return JET_errOutOfMemory;
+        memcpy( c->mk, be, 4 );
+        c->mklen = 4;
+        c->mkcols = 1;
+        c->mk_valid = TRUE;
+        return JET_errSuccess;
+    }
+    if (c->mkcols >= ix->nkeys) return JET_errInvalidParameter;
+
+    k.p = c->mk;
+    k.len = c->mklen;
+    k.cap = c->mklen;
+    {
+        const struct idxkey *ik = &ix->keys[c->mkcols];
+        const struct column *col = &c->table->cols[ik->slot];
+        struct value v;
+        BOOL nulls_high = (ix->grbit & JET_bitIndexSortNullsHigh) != 0;
+
+        zero_len = (grbit & JET_bitKeyDataZeroLength) != 0;
+        end_limit = (grbit & (JET_bitStrLimit | JET_bitSubStrLimit | JET_bitFullColumnEndLimit |
+                              JET_bitPartialColumnEndLimit)) != 0;
+        partial = (grbit & (JET_bitStrLimit | JET_bitSubStrLimit | JET_bitPartialColumnStartLimit |
+                            JET_bitPartialColumnEndLimit)) != 0 && (is_text_type( col->type ) || col->type == JET_coltypBinary || col->type == JET_coltypLongBinary);
+        v.p = (BYTE *)data;
+        v.len = cb;
+        if (fixed_size( col->type ) && data && cb < fixed_size( col->type ))
+        {
+            BYTE tmp[16] = { 0 };
+            memcpy( tmp, data, cb );
+            v.p = tmp;
+            v.len = fixed_size( col->type );
+            if (!encode_segment( &k, col, &v, ik->desc, nulls_high, !partial )) { c->mk = k.p; return JET_errOutOfMemory; }
+        }
+        else if ((!data || !cb) && !zero_len)
+        {
+            if (!encode_segment( &k, col, NULL, ik->desc, nulls_high, TRUE )) { c->mk = k.p; return JET_errOutOfMemory; }
+        }
+        else
+        {
+            if (fixed_size( col->type ) && cb > fixed_size( col->type )) v.len = fixed_size( col->type );
+            if (!encode_segment( &k, col, &v, ik->desc, nulls_high, !partial )) { c->mk = k.p; return JET_errOutOfMemory; }
+        }
+    }
+    if (end_limit) kb_byte( &k, 0xff );
+    c->mk = k.p;
+    c->mklen = k.len;
+    c->mkcols++;
+    c->mk_valid = TRUE;
+    return JET_errSuccess;
+}
+
+JET_ERR JET_API JetMakeKey( JET_SESID sesid, JET_TABLEID tableid, const void *data, unsigned long cb, JET_GRBIT grbit )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %p %lu %#lx\n", sesid, tableid, data, cb, grbit );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c ))) err = cursor_make_key( c, data, cb, grbit );
+    unlock();
+    return err;
+}
+
+static JET_ERR cursor_seek( struct cursor *c, JET_GRBIT grbit )
+{
+    struct index *ix = c->idx;
+    DWORD lb, ub, pos;
+    BOOL found = FALSE, equal = FALSE;
+    JET_ERR err;
+
+    if (!c->mk_valid) return JET_errKeyNotMade;
+    lb = ix_prefix_bound( ix, c->mk, c->mklen, FALSE );
+    ub = ix_prefix_bound( ix, c->mk, c->mklen, TRUE );
+    if (grbit & JET_bitSeekEQ) { if (lb < ub) { pos = lb; found = equal = TRUE; } }
+    else if (grbit & JET_bitSeekGE) { if (lb < ix->n) { pos = lb; found = TRUE; equal = lb < ub; } }
+    else if (grbit & JET_bitSeekGT) { if (ub < ix->n) { pos = ub; found = TRUE; } }
+    else if (grbit & JET_bitSeekLE)
+    {
+        if (ub > lb) { pos = ub - 1; found = equal = TRUE; }
+        else if (lb > 0) { pos = lb - 1; found = TRUE; }
+    }
+    else if (grbit & JET_bitSeekLT) { if (lb > 0) { pos = lb - 1; found = TRUE; } }
+    else return JET_errInvalidGrbit;
+
+    if (!found)
+    {
+        cursor_key_clear( c );
+        return JET_errRecordNotFound;
+    }
+    if (c->hi || c->lo)
+    {
+        if (!entry_in_range( c, &ix->e[pos] )) { cursor_key_clear( c ); return JET_errRecordNotFound; }
+    }
+    cursor_set_pos( c, &ix->e[pos] );
+    if (grbit & JET_bitSetIndexRange)
+    {
+        free( c->hi );
+        c->hi = malloc( c->mklen ? c->mklen : 1 );
+        if (c->hi) { memcpy( c->hi, c->mk, c->mklen ); c->hilen = c->mklen; c->hi_incl = TRUE; }
+        free( c->lo ); c->lo = NULL;
+    }
+    cursor_key_clear( c );
+    err = equal ? JET_errSuccess : JET_wrnSeekNotEqual;
+    return err;
+}
+
+JET_ERR JET_API JetSeek( JET_SESID sesid, JET_TABLEID tableid, JET_GRBIT grbit )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %#lx\n", sesid, tableid, grbit );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c ))) err = cursor_seek( c, grbit );
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetSetIndexRange( JET_SESID sesid, JET_TABLEID tableid, JET_GRBIT grbit )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %#lx\n", sesid, tableid, grbit );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        if (grbit & JET_bitRangeRemove)
+        {
+            free( c->hi ); c->hi = NULL;
+            free( c->lo ); c->lo = NULL;
+        }
+        else if (!c->mk_valid) err = JET_errKeyNotMade;
+        else
+        {
+            BYTE *copy = malloc( c->mklen ? c->mklen : 1 );
+            if (!copy) err = JET_errOutOfMemory;
+            else
+            {
+                BYTE *old_hi = c->hi, *old_lo = c->lo;
+                memcpy( copy, c->mk, c->mklen );
+                if (grbit & JET_bitRangeUpperLimit)
+                {
+                    c->hi = copy; c->hilen = c->mklen; c->hi_incl = (grbit & JET_bitRangeInclusive) != 0;
+                    free( old_hi );
+                }
+                else
+                {
+                    c->lo = copy; c->lolen = c->mklen; c->lo_incl = (grbit & JET_bitRangeInclusive) != 0;
+                    free( old_lo );
+                }
+                cursor_key_clear( c );
+                if (c->state == CUR_AT)
+                {
+                    BOOL exact;
+                    DWORD p = cursor_locate( c, &exact );
+                    if (!exact || !entry_in_range( c, &c->idx->e[p] )) err = JET_errNoCurrentRecord;
+                }
+                if (grbit & JET_bitRangeInstantDuration)
+                {
+                    free( c->hi ); c->hi = NULL;
+                    free( c->lo ); c->lo = NULL;
+                }
+            }
+        }
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetRetrieveKey( JET_SESID sesid, JET_TABLEID tableid, void *data, unsigned long cbmax,
+                                unsigned long *pcbactual, JET_GRBIT grbit )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %p %lu\n", sesid, tableid, data, cbmax );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        struct row *row;
+        struct kbuf *keys = NULL;
+        DWORD nk = 0;
+        struct row *src = NULL;
+
+        if (grbit & JET_bitRetrieveCopy) { src = c->copy; if (!src) err = JET_errUpdateNotPrepared; }
+        else err = cursor_row( c, &src );
+        row = src;
+        if (!err)
+        {
+            if (!index_keys( c->table, c->idx, row, &keys, &nk )) err = JET_errOutOfMemory;
+            else if (!nk) err = JET_errNoCurrentRecord;
+            else
+            {
+                DWORD n = keys[0].len;
+                if (pcbactual) *pcbactual = n;
+                if (data && cbmax) memcpy( data, keys[0].p, min( n, cbmax ) );
+                if (n > cbmax) err = JET_wrnBufferTruncated;
+            }
+            free_keys( keys, nk );
+        }
+    }
+    unlock();
+    return err;
+}
+
+/* ---- bookmarks and positions ---- */
+
+JET_ERR JET_API JetGetBookmark( JET_SESID sesid, JET_TABLEID tableid, void *pv, unsigned long cbmax, unsigned long *pcbactual )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %p %lu\n", sesid, tableid, pv, cbmax );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        struct row *row;
+        if (!(err = cursor_row( c, &row )))
+        {
+            DWORD rid = row->rid;
+            if (pcbactual) *pcbactual = 4;
+            if (!pv || cbmax < 4) err = JET_errBufferTooSmall;
+            else memcpy( pv, &rid, 4 );
+        }
+    }
+    unlock();
+    return err;
+}
+
+static JET_ERR cursor_goto_row( struct cursor *c, struct row *row )
+{
+    struct kbuf *keys;
+    DWORD nk;
+    struct index *ix = c->idx;
+
+    if (!index_keys( c->table, ix, row, &keys, &nk )) return JET_errOutOfMemory;
+    if (!nk) { free_keys( keys, nk ); return JET_errRecordNotFound; }
+    {
+        DWORD p = ix_lower_bound( ix, keys[0].p, keys[0].len, row->rid, TRUE );
+        if (p < ix->n) cursor_set_pos( c, &ix->e[p] );
+    }
+    free_keys( keys, nk );
+    return JET_errSuccess;
+}
+
+JET_ERR JET_API JetGotoBookmark( JET_SESID sesid, JET_TABLEID tableid, void *pv, unsigned long cb )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %p %lu\n", sesid, tableid, pv, cb );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        struct row *row;
+        DWORD rid;
+        if (!pv || cb != 4) err = JET_errInvalidBookmark;
+        else
+        {
+            memcpy( &rid, pv, 4 );
+            if (!(row = table_find_row( c->table, rid ))) err = JET_errRecordDeleted;
+            else err = cursor_goto_row( c, row );
+        }
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetGetSecondaryIndexBookmark( JET_SESID sesid, JET_TABLEID tableid, void *seckey, unsigned long seckeymax,
+                                              unsigned long *pseckey, void *prim, unsigned long primmax,
+                                              unsigned long *pprim, const JET_GRBIT grbit )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        struct row *row;
+        if ((err = cursor_row( c, &row ))) {}
+        else if (c->idx->sequential || c->idx == c->table->primary) err = JET_errNoCurrentIndex;
+        else
+        {
+            DWORD rid = row->rid;
+            if (pseckey) *pseckey = c->curkeylen;
+            if (pprim) *pprim = 4;
+            if (!seckey || seckeymax < c->curkeylen || !prim || primmax < 4) err = JET_errBufferTooSmall;
+            else { memcpy( seckey, c->curkey, c->curkeylen ); memcpy( prim, &rid, 4 ); }
+        }
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetGotoSecondaryIndexBookmark( JET_SESID sesid, JET_TABLEID tableid, void *seckey, unsigned long cbseckey,
+                                               void *prim, unsigned long cbprim, const JET_GRBIT grbit )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        DWORD rid = 0, p;
+        if (!seckey || !prim || cbprim != 4) err = JET_errInvalidBookmark;
+        else
+        {
+            memcpy( &rid, prim, 4 );
+            p = ix_lower_bound( c->idx, seckey, cbseckey, rid, TRUE );
+            if (p < c->idx->n && c->idx->e[p].row->rid == rid && c->idx->e[p].keylen == cbseckey &&
+                !memcmp( c->idx->e[p].key, seckey, cbseckey ))
+                cursor_set_pos( c, &c->idx->e[p] );
+            else err = JET_errRecordDeleted;
+        }
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetGetRecordPosition( JET_SESID sesid, JET_TABLEID tableid, JET_RECPOS *recpos, unsigned long cb )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    if (!recpos || cb < sizeof(*recpos)) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        BOOL exact;
+        if (c->state != CUR_AT) err = JET_errNoCurrentRecord;
+        else
+        {
+            DWORD p = cursor_locate( c, &exact );
+            recpos->cbStruct = sizeof(*recpos);
+            recpos->centriesLT = p;
+            recpos->centriesInRange = c->idx->n;
+            recpos->centriesTotal = c->idx->n;
+        }
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetGotoPosition( JET_SESID sesid, JET_TABLEID tableid, JET_RECPOS *recpos )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    if (!recpos) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        struct index *ix = c->idx;
+        if (!ix->n) err = JET_errRecordNotFound;
+        else
+        {
+            DWORD total = recpos->centriesTotal ? recpos->centriesTotal : 1;
+            DWORD p = (DWORD)((ULONGLONG)recpos->centriesLT * ix->n / total);
+            if (p >= ix->n) p = ix->n - 1;
+            cursor_set_pos( c, &ix->e[p] );
+        }
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetIndexRecordCount( JET_SESID sesid, JET_TABLEID tableid, unsigned long *pcrec, unsigned long max )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    if (!pcrec) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        BOOL exact;
+        DWORD p = 0, count = 0;
+        if (c->state == CUR_AT) p = cursor_locate( c, &exact );
+        else if (c->state == CUR_DELETED) p = cursor_locate( c, &exact );
+        else if (c->state == CUR_AFTER) p = c->idx->n;
+        while (p < c->idx->n && entry_in_range( c, &c->idx->e[p] ) && (!max || count < max)) { count++; p++; }
+        *pcrec = count;
+    }
+    unlock();
+    return err;
+}
