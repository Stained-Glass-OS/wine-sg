+JET_ERR JET_API JetBeginSessionW( JET_INSTANCE instance, JET_SESID *psesid, const WCHAR *user, const WCHAR *pw )
+{
+    struct instance *inst;
+    struct session *s;
+    JET_ERR err = JET_errSuccess;
+
+    TRACE( "%#Ix %p\n", instance, psesid );
+
+    if (!psesid) return JET_errInvalidParameter;
+    lock();
+    if (!(inst = find_instance( instance ))) err = instance ? JET_errInvalidParameter : JET_errNotInitialized;
+    else if (!inst->initialized) err = JET_errNotInitialized;
+    else if (inst->nsessions >= inst->params[JET_paramMaxSessions].value) err = JET_errOutOfSessions;
+    else if (!(s = calloc( 1, sizeof(*s) ))) err = JET_errOutOfMemory;
+    else
+    {
+        s->magic = MAGIC_SESSION;
+        s->inst = inst;
+        list_init( &s->cursors );
+        list_add_tail( &inst->sessions, &s->entry );
+        inst->nsessions++;
+        *psesid = (JET_SESID)s;
+    }
+    unlock();
+    return err;
+}
