+JET_ERR JET_API JetSetSystemParameterW( JET_INSTANCE *pinstance, JET_SESID sesid, unsigned long paramid,
+                                        JET_API_PTR value, const WCHAR *str )
+{
+    struct instance *inst = NULL;
+    struct param *p;
+
+    TRACE( "%p %#Ix %lu %#Ix %s\n", pinstance, sesid, paramid, value, debugstr_w(str) );
+
+    if (paramid >= MAX_PARAM) return JET_errInvalidParameter;
+    lock();
+    if (pinstance && *pinstance)
+    {
+        if (!(inst = find_instance( *pinstance ))) { unlock(); return JET_errInvalidParameter; }
+        if (inst->initialized && paramid != JET_paramMaxTemporaryTables && paramid != JET_paramCacheSizeMax
+            && paramid != JET_paramCacheSizeMin)
+        {
+            unlock();
+            return JET_errAlreadyInitialized;
+        }
+        p = &inst->params[paramid];
+    }
+    else
+    {
+        p = &global_params[paramid];
+        if (default_instance && !default_instance->initialized)
+        {
+            struct param *dp = &default_instance->params[paramid];
+            dp->value = value;
+            free( dp->str );
+            dp->str = str ? wcsdup( str ) : NULL;
+            dp->set = TRUE;
+        }
+    }
+    p->value = value;
+    if (str)
+    {
+        free( p->str );
+        p->str = wcsdup( str );
+    }
+    p->set = TRUE;
+    unlock();
+    return JET_errSuccess;
+}
