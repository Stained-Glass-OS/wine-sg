+static DWORD db_size_pages( struct database *db )
+{
+    struct wbuf w = { 0 };
+    DWORD pages;
+    serialize_db( db, &w );
+    pages = (w.len + SG_PAGE_SIZE - 1) / SG_PAGE_SIZE + 2;
+    free( w.p );
+    return pages;
+}
