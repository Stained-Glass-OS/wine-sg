+JET_ERR JET_API JetGetAttachInfoInstanceW( JET_INSTANCE instance, WCHAR *szz, unsigned long cbmax, unsigned long *pcbactual )
+{
+    struct instance *inst;
+    struct database *db;
+    unsigned long need = sizeof(WCHAR);
+    WCHAR *p = szz;
+    JET_ERR err = JET_errSuccess;
+
+    lock();
+    if (!(inst = find_instance( instance ))) { unlock(); return JET_errInvalidParameter; }
+    LIST_FOR_EACH_ENTRY( db, &inst->databases, struct database, entry )
+        need += (lstrlenW( db->path ) + 1) * sizeof(WCHAR);
+    if (pcbactual) *pcbactual = need;
+    if (szz)
+    {
+        if (cbmax < need) err = JET_wrnBufferTruncated;
+        else
+        {
+            LIST_FOR_EACH_ENTRY( db, &inst->databases, struct database, entry )
+            {
+                lstrcpyW( p, db->path );
+                p += lstrlenW( p ) + 1;
+            }
+            *p = 0;
+        }
+    }
+    unlock();
+    return err;
+}
