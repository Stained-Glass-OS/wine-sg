+static JET_ERR put_string( const WCHAR *str, BOOL ansi, void *result, unsigned long cbmax )
+{
+    if (ansi)
+    {
+        int n = WideCharToMultiByte( CP_ACP, 0, str, -1, NULL, 0, NULL, NULL );
+        if (cbmax < n) return JET_errBufferTooSmall;
+        WideCharToMultiByte( CP_ACP, 0, str, -1, result, cbmax, NULL, NULL );
+    }
+    else
+    {
+        if (cbmax < (lstrlenW( str ) + 1) * sizeof(WCHAR)) return JET_errBufferTooSmall;
+        lstrcpyW( result, str );
+    }
+    return JET_errSuccess;
+}
+
+static JET_ERR get_db_info( struct database *db, void *result, unsigned long cbmax, unsigned long level, BOOL ansi )
+{
+    switch (level)
+    {
+    case JET_DbInfoFilename:
+        return put_string( db->path, ansi, result, cbmax );
+    case JET_DbInfoConnect:
+        return put_string( L"", ansi, result, cbmax );
+    case JET_DbInfoCountry:
+    case JET_DbInfoLangid:
+    case JET_DbInfoCp:
+    case JET_DbInfoCollate:
+    case JET_DbInfoVersion:
+    case JET_DbInfoTransactions:
+    case JET_DbInfoOptions:
+    case JET_DbInfoSpaceAvailable:
+    case JET_DbInfoUpgrade:
+    case JET_DbInfoDBInUse:
+    case JET_DbInfoPageSize:
+    case JET_DbInfoFileType:
+    case JET_DbInfoFilesize:
+    case JET_DbInfoFilesizeOnDisk:
+    case JET_DbInfoSpaceOwned:
+    case JET_DbInfoIsam:
+    {
+        DWORD v = 0;
+        if (cbmax < sizeof(DWORD)) return JET_errInvalidParameter;
+        switch (level)
+        {
+        case JET_DbInfoCountry: v = 1; break;
+        case JET_DbInfoLangid: v = 0x409; break;
+        case JET_DbInfoCp: v = SG_CP_UNICODE; break;
+        case JET_DbInfoVersion: v = 0x620; break;
+        case JET_DbInfoTransactions: v = 7; break;
+        case JET_DbInfoPageSize: v = SG_PAGE_SIZE; break;
+        case JET_DbInfoFileType: v = SG_FILETYPE_DATABASE; break;
+        case JET_DbInfoFilesize:
+        case JET_DbInfoSpaceOwned: v = db_size_pages( db ); break;
+        case JET_DbInfoFilesizeOnDisk:
+        {
+            WIN32_FILE_ATTRIBUTE_DATA fad;
+            if (GetFileAttributesExW( db->path, GetFileExInfoStandard, &fad )) v = fad.nFileSizeLow;
+            break;
+        }
+        }
+        *(DWORD *)result = v;
+        return JET_errSuccess;
+    }
+    case JET_DbInfoMisc:
+    {
+        JET_DBINFOMISC *mi = result;
+        if (cbmax < sizeof(*mi)) return JET_errBufferTooSmall;
+        memset( mi, 0, sizeof(*mi) );
+        mi->ulVersion = 0x620;
+        mi->dbstate = db->state ? db->state : JET_dbstateCleanShutdown;
+        mi->cbPageSize = SG_PAGE_SIZE;
+        mi->signDb.ulRandom = db->sig.Data1;
+        return JET_errSuccess;
+    }
+    default:
+        return JET_errInvalidParameter;
+    }
+}
+
+static JET_ERR api_get_db_info( JET_SESID sesid, JET_DBID dbid, void *result, unsigned long cbmax, unsigned long level, BOOL ansi )
+{
+    struct session *s;
+    struct database *db;
+    JET_ERR err;
+
+    if (!result) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_session( sesid, &s )))
+    {
+        if (!(db = session_db( s, dbid ))) err = JET_errInvalidDatabaseId;
+        else err = get_db_info( db, result, cbmax, level, ansi );
+    }
+    unlock();
+    return err;
+}
