+JET_ERR JET_API JetGetDatabaseFileInfoW( const WCHAR *path, void *result, unsigned long cbmax, unsigned long level )
+{
+    struct database *db;
+    JET_ERR err;
+
+    TRACE( "%s %p %lu %lu\n", debugstr_w(path), result, cbmax, level );
+    if (!path || !result) return JET_errInvalidParameter;
+    if ((err = load_db_file( NULL, path, &db ))) return err;
+    switch (level)
+    {
+    case JET_DbInfoFilesize:
+    case JET_DbInfoFilesizeOnDisk:
+        if (cbmax >= sizeof(LONGLONG))
+        {
+            WIN32_FILE_ATTRIBUTE_DATA fad;
+            LONGLONG size = 0;
+            if (GetFileAttributesExW( path, GetFileExInfoStandard, &fad ))
+                size = ((LONGLONG)fad.nFileSizeHigh << 32) | fad.nFileSizeLow;
+            *(LONGLONG *)result = size;
+            err = JET_errSuccess;
+        }
+        else err = JET_errInvalidParameter;
+        break;
+    case JET_DbInfoPageSize:
+    case JET_DbInfoFileType:
+    case JET_DbInfoMisc:
+        err = get_db_info( db, result, cbmax, level, FALSE );
+        break;
+    default:
+        err = JET_errInvalidParameter;
+        break;
+    }
+    free_database( db );
+    return err;
+}
