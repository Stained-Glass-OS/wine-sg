+JET_ERR JET_API JetBeginSessionA( JET_INSTANCE instance, JET_SESID *psesid, const char *user, const char *pw )
+{
+    return JetBeginSessionW( instance, psesid, NULL, NULL );
+}
+
+JET_ERR JET_API JetEndSession( JET_SESID sesid, JET_GRBIT grbit )
+{
+    struct session *s;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#lx\n", sesid, grbit );
+    lock();
+    if (!(err = need_session( sesid, &s )))
+    {
+        struct database *dbs[16];
+        DWORD i, n = 0;
+        for (i = 0; i < s->ndbs && n < ARRAY_SIZE(dbs); i++) if (s->dbs[i].open) dbs[n++] = s->dbs[i].db;
+        destroy_session( s );
+        for (i = 0; i < n; i++) commit_point( dbs[i] );
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetDupSession( JET_SESID sesid, JET_SESID *psesid )
+{
+    struct session *s;
+    JET_ERR err;
+
+    TRACE( "%#Ix %p\n", sesid, psesid );
+    if (!psesid) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_session( sesid, &s )))
+    {
+        unlock();
+        err = JetBeginSessionW( (JET_INSTANCE)s->inst, psesid, NULL, NULL );
+        if (!err)
+        {
+            lock();
+            {
+                struct session *n = find_session( *psesid );
+                DWORD i;
+                for (i = 0; n && i < s->ndbs; i++)
+                    if (s->dbs[i].open) { n->dbs = realloc( n->dbs, (n->ndbs + 1) * sizeof(*n->dbs) );
+                                          n->dbs[n->ndbs] = s->dbs[i]; n->ndbs++; s->dbs[i].db->opens++; }
+            }
+            unlock();
+        }
+        return err;
+    }
+    unlock();
+    return err;
+}
