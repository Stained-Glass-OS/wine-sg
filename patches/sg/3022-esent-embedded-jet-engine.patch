+static JET_ERR detach_database( JET_SESID sesid, const WCHAR *path, JET_GRBIT grbit )
+{
+    struct session *s;
+    struct database *db;
+    JET_ERR err;
+
+    if ((err = need_session( sesid, &s ))) return err;
+    if (!path) return JET_errInvalidParameter;
+    if (!(db = find_db( s->inst, path ))) return JET_errDatabaseNotFound;
+    if (db->opens && !(grbit & (JET_bitForceDetach | JET_bitDetachForceClose))) return JET_errDatabaseInUse;
+    if (db->dirty && (err = flush_db( db ))) return err;
+    list_remove( &db->entry );
+    {
+        struct session *o;
+        DWORD i;
+        LIST_FOR_EACH_ENTRY( o, &s->inst->sessions, struct session, entry )
+            for (i = 0; i < o->ndbs; i++) if (o->dbs[i].db == db) { o->dbs[i].open = FALSE; o->dbs[i].db = NULL; }
+    }
+    free_database( db );
+    return JET_errSuccess;
+}
