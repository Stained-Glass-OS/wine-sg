+JET_ERR JET_API JetCreateTableW( JET_SESID sesid, JET_DBID dbid, const WCHAR *name, unsigned long pages,
+                                 unsigned long density, JET_TABLEID *ptableid )
+{
+    struct session *s;
+    struct table *t;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %lu %s %lu %lu %p\n", sesid, dbid, debugstr_w(name), pages, density, ptableid );
+    if (!ptableid) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_session( sesid, &s )) && !(err = create_table( s, dbid, name, &t )))
+    {
+        if (!(c = new_cursor( s, t ))) err = JET_errOutOfMemory;
+        else *ptableid = (JET_TABLEID)c;
+    }
+    unlock();
+    return err;
+}
