+JET_ERR JET_API JetGetColumnInfoW( JET_SESID sesid, JET_DBID dbid, const WCHAR *table, const WCHAR *column, void *result,
+                                   unsigned long cb, unsigned long level )
+{
+    struct session *s;
+    struct table *t;
+    JET_ERR err;
+
+    TRACE( "%#Ix %lu %s %s %p %lu %lu\n", sesid, dbid, debugstr_w(table), debugstr_w(column), result, cb, level );
+    lock();
+    if (!(err = db_table_for_info( sesid, dbid, table, &s, &t ))) err = table_column_info( s, t, column, result, cb, level, FALSE );
+    unlock();
+    return err;
+}
