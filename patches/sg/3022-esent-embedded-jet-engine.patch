+}
+
+JET_ERR JET_API JetPrepareToCommitTransaction( JET_SESID sesid, JET_GRBIT grbit )
+{
+    struct session *s;
+    JET_ERR err;
+    lock();
+    if (!(err = need_session( sesid, &s )) && !s->level) err = JET_errNotInTransaction;
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetCommitTransaction( JET_SESID sesid, JET_GRBIT grbit )
+{
+    struct session *s;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#lx\n", sesid, grbit );
+    lock();
+    if (!(err = need_session( sesid, &s )))
+    {
+        if (!s->level) err = JET_errNotInTransaction;
+        else
+        {
+            DWORD i;
+            for (i = 0; i < s->nundo; i++) if (s->undo[i].level == s->level) s->undo[i].level--;
+            s->level--;
+            if (!s->level)
+            {
+                undo_free_entries( s, 0 );
+                session_commit_dbs( s );
+            }
+        }
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetRollback( JET_SESID sesid, JET_GRBIT grbit )
+{
+    struct session *s;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#lx\n", sesid, grbit );
+    lock();
+    if (!(err = need_session( sesid, &s )))
+    {
+        if (!s->level) err = JET_errNotInTransaction;
+        else if (grbit & JET_bitRollbackAll)
+        {
+            undo_apply( s, 1 );
+            s->level = 0;
+        }
+        else
+        {
+            undo_apply( s, s->level );
+            s->level--;
+        }
+    }
+    unlock();
+    return err;
+}
