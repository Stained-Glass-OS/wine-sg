+JET_ERR JET_API JetAddColumnA( JET_SESID sesid, JET_TABLEID tableid, const char *name, const JET_COLUMNDEF *def,
+                               const void *pvdef, unsigned long cbdef, JET_COLUMNID *pid )
+{
+    WCHAR *nameW = a2w( name );
+    JET_ERR ret = JetAddColumnW( sesid, tableid, nameW, def, pvdef, cbdef, pid );
+    free( nameW );
+    return ret;
+}
