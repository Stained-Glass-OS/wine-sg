+JET_ERR JET_API JetCreateInstanceW( JET_INSTANCE *pinstance, const WCHAR *name )
+{
+    JET_ERR ret;
+    TRACE( "%p %s\n", pinstance, debugstr_w(name) );
+    lock();
+    ret = create_instance_api( pinstance, name );
+    unlock();
+    return ret;
+}
