+/* ---------------------------------------------------------------------- */
+/* record updates                                                         */
+
+static JET_ERR prepare_autoincrement( struct table *t, struct row *r )
+{
+    DWORD i;
+
+    for (i = 0; i < t->nautoinc; i++)
+    {
+        DWORD slot = t->autoinc_slot[i];
+        struct column *col = &t->cols[slot];
+        LONGLONG v;
+        struct value *val;
+
+        if (col->deleted) continue;
+        if (!row_resize( r, t->ncols )) return JET_errOutOfMemory;
+        free_cell( &r->cells[slot] );
+        if (!(r->cells[slot].v = calloc( 1, sizeof(struct value) ))) return JET_errOutOfMemory;
+        val = &r->cells[slot].v[0];
+        v = t->autoinc[i]++;
+        val->len = fixed_size( col->type );
+        if (!(val->p = malloc( val->len ))) return JET_errOutOfMemory;
+        memcpy( val->p, &v, val->len );
+        r->cells[slot].n = 1;
+    }
+    return JET_errSuccess;
+}
+
+static JET_ERR cursor_prepare( struct cursor *c, unsigned long prep )
+{
+    struct table *t = c->table;
+    struct row *r = NULL, *cur;
+    JET_ERR err;
+
+    if (prep == JET_prepCancel)
+    {
+        free_row( c->copy );
+        c->copy = NULL;
+        c->prep = -1;
+        return JET_errSuccess;
+    }
+    if (t->db && t->db->readonly) return JET_errDatabaseFileReadOnly;
+    if (c->prep >= 0) return JET_errAlreadyPrepared;
+    switch (prep)
+    {
+    case JET_prepInsert:
+        if (!(r = new_row( t->ncols ))) return JET_errOutOfMemory;
+        if ((err = prepare_autoincrement( t, r ))) { free_row( r ); return err; }
+        break;
+    case JET_prepReplace:
+    case JET_prepReplaceNoLock:
+        if ((err = cursor_row( c, &cur ))) return err;
+        if (!(r = copy_row( cur ))) return JET_errOutOfMemory;
+        c->copy_rid = cur->rid;
+        if (!row_resize( r, t->ncols )) { free_row( r ); return JET_errOutOfMemory; }
+        break;
+    case JET_prepInsertCopy:
+    case JET_prepInsertCopyDeleteOriginal:
+        if ((err = cursor_row( c, &cur ))) return err;
+        if (!(r = copy_row( cur ))) return JET_errOutOfMemory;
+        c->copy_rid = cur->rid;
+        if (!row_resize( r, t->ncols )) { free_row( r ); return JET_errOutOfMemory; }
+        if ((err = prepare_autoincrement( t, r ))) { free_row( r ); return err; }
+        break;
+    default:
+        return JET_errInvalidParameter;
+    }
+    c->copy = r;
+    c->prep = prep;
+    return JET_errSuccess;
+}
+
+JET_ERR JET_API JetPrepareUpdate( JET_SESID sesid, JET_TABLEID tableid, unsigned long prep )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %lu\n", sesid, tableid, prep );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c ))) err = cursor_prepare( c, prep );
+    unlock();
+    return err;
+}
+
+static JET_ERR cell_set( struct cell *cell, DWORD idx, const void *data, DWORD len, BOOL insert )
+{
+    struct value *nv;
+    BYTE *copy;
+
+    if (!(copy = malloc( len ? len : 1 ))) return JET_errOutOfMemory;
+    if (len) memcpy( copy, data, len );
+    if (insert || idx >= cell->n)
+    {
+        if (!(nv = realloc( cell->v, (cell->n + 1) * sizeof(*nv) ))) { free( copy ); return JET_errOutOfMemory; }
+        cell->v = nv;
+        if (insert && idx < cell->n) memmove( &nv[idx + 1], &nv[idx], (cell->n - idx) * sizeof(*nv) );
+        else idx = cell->n;
+        cell->n++;
+        nv[idx].p = copy;
+        nv[idx].len = len;
+    }
+    else
+    {
+        free( cell->v[idx].p );
+        cell->v[idx].p = copy;
+        cell->v[idx].len = len;
+    }
+    return JET_errSuccess;
+}
+
+static void cell_remove( struct cell *cell, DWORD idx )
+{
+    free( cell->v[idx].p );
+    memmove( &cell->v[idx], &cell->v[idx + 1], (cell->n - idx - 1) * sizeof(*cell->v) );
+    cell->n--;
+    if (!cell->n) { free( cell->v ); cell->v = NULL; }
+}
+
+static JET_ERR cursor_set_column( struct cursor *c, DWORD colid, const void *data, DWORD cb, JET_GRBIT grbit,
+                                  DWORD ib, DWORD itag )
+{
+    struct table *t = c->table;
+    struct column *col;
+    struct cell *cell;
+    DWORD slot, idx = 0;
+    BOOL multi, tagged;
+
+    if (c->prep < 0 || !c->copy) return JET_errUpdateNotPrepared;
+    if (!(col = col_by_id( t, colid, &slot ))) return JET_errBadColumnId;
+    if (col->grbit & JET_bitColumnAutoincrement) return JET_errColumnNotUpdatable;
+    if (!row_resize( c->copy, t->ncols )) return JET_errOutOfMemory;
+    cell = &c->copy->cells[slot];
+    tagged = (col->grbit & JET_bitColumnTagged) != 0;
+    multi = tagged && (col->grbit & JET_bitColumnMultiValued);
+
+    if (tagged)
+    {
+        if (multi)
+        {
+            if (itag > cell->n + 1) return JET_errBadItagSequence;
+            idx = itag ? itag - 1 : cell->n;
+        }
+        else
+        {
+            if (itag > 1) return JET_errBadItagSequence;
+            idx = 0;
+        }
+    }
+    else if (itag > 1) return JET_errBadItagSequence;
+
+    /* NULL */
+    if (!data && !cb && !(grbit & (JET_bitSetZeroLength | JET_bitSetSizeLV)))
+    {
+        if (idx < cell->n)
+        {
+            if (multi) cell_remove( cell, idx ); else free_cell( cell );
+        }
+        return JET_errSuccess;
+    }
+    if (!data && cb && !(grbit & JET_bitSetSizeLV)) return JET_errInvalidParameter;
+
+    if (grbit & JET_bitSetRevertToDefaultValue)
+    {
+        free_cell( cell );
+        return JET_errSuccess;
+    }
+    {
+        BYTE *buf = NULL;
+        DWORD len = 0, oldlen = (idx < cell->n) ? cell->v[idx].len : 0;
+        const BYTE *old = (idx < cell->n) ? cell->v[idx].p : NULL;
+        JET_ERR err;
+
+        if (fixed_size( col->type ))
+        {
+            if (cb != fixed_size( col->type )) return JET_errInvalidBufferSize;
+            len = cb;
+            buf = (BYTE *)data;
+        }
+        else
+        {
+            BOOL lv = is_lv_type( col->type );
+
+            if (is_unicode_col( col ) && (cb & 1) && !(grbit & JET_bitSetSizeLV)) return JET_errInvalidBufferSize;
+            if (lv && (grbit & JET_bitSetAppendLV))
+            {
+                len = oldlen + cb;
+                if (!(buf = malloc( len ? len : 1 ))) return JET_errOutOfMemory;
+                if (oldlen) memcpy( buf, old, oldlen );
+                if (cb) memcpy( buf + oldlen, data, cb );
+            }
+            else if (lv && (grbit & JET_bitSetOverwriteLV))
+            {
+                len = max( oldlen, ib + cb );
+                if (!(buf = calloc( 1, len ? len : 1 ))) return JET_errOutOfMemory;
+                if (oldlen) memcpy( buf, old, oldlen );
+                if (cb) memcpy( buf + ib, data, cb );
+            }
+            else if (lv && (grbit & JET_bitSetSizeLV))
+            {
+                len = cb;
+                if (!(buf = calloc( 1, len ? len : 1 ))) return JET_errOutOfMemory;
+                memcpy( buf, old, min( oldlen, len ) );
+            }
+            else
+            {
+                if (!lv && cb > col->cbmax) return JET_errColumnTooBig;
+                len = cb;
+                buf = (BYTE *)data;
+            }
+        }
+        if (multi && (grbit & (JET_bitSetUniqueMultiValues | JET_bitSetUniqueNormalizedMultiValues)))
+        {
+            DWORD i;
+            for (i = 0; i < cell->n; i++)
+                if (i != idx && cell->v[i].len == len && !memcmp( cell->v[i].p, buf, len ))
+                {
+                    if (buf != data) free( buf );
+                    return JET_errMultiValuedDuplicate;
+                }
+        }
+        err = cell_set( cell, idx, buf ? buf : (const BYTE *)"", len, multi && itag == 0 ? FALSE : FALSE );
+        if (buf != data) free( buf );
+        return err;
+    }
+}
+
+JET_ERR JET_API JetSetColumn( JET_SESID sesid, JET_TABLEID tableid, JET_COLUMNID columnid, const void *data, unsigned long cb,
+                              JET_GRBIT grbit, JET_SETINFO *info )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %lu %p %lu %#lx %p\n", sesid, tableid, columnid, data, cb, grbit, info );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+        err = cursor_set_column( c, columnid, data, cb, grbit, info ? info->ibLongValue : 0, info ? info->itagSequence : 1 );
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetSetColumns( JET_SESID sesid, JET_TABLEID tableid, JET_SETCOLUMN *sc, unsigned long count )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err, first = JET_errSuccess;
+    unsigned long i;
+
+    TRACE( "%#Ix %#Ix %p %lu\n", sesid, tableid, sc, count );
+    if (!sc) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        for (i = 0; i < count; i++)
+        {
+            sc[i].err = cursor_set_column( c, sc[i].columnid, sc[i].pvData, sc[i].cbData, sc[i].grbit,
+                                           sc[i].ibLongValue, sc[i].itagSequence );
+            if (sc[i].err && !first) first = sc[i].err;
+        }
+        err = first;
+    }
+    unlock();
+    return err;
+}
+
+static JET_ERR check_row_constraints( struct table *t, struct row *r )
+{
+    DWORD i, j;
+
+    for (i = 0; i < t->ncols; i++)
+    {
+        const struct column *col = &t->cols[i];
+        if (col->deleted) continue;
+        if ((col->grbit & JET_bitColumnNotNULL) && !row_cell( r, i )->n && !col->has_def) return JET_errNullInvalid;
+    }
+    for (i = 1; i < t->nidx; i++)
+    {
+        struct index *ix = t->idx[i];
+        if (!(ix->grbit & JET_bitIndexDisallowNull)) continue;
+        for (j = 0; j < ix->nkeys; j++)
+            if (!row_cell( r, ix->keys[j].slot )->n) return JET_errNullKeyDisallowed;
+    }
+    return JET_errSuccess;
+}
+
+static JET_ERR materialize_defaults( struct table *t, struct row *r )
+{
+    DWORD i;
+
+    if (!row_resize( r, t->ncols )) return JET_errOutOfMemory;
+    for (i = 0; i < t->ncols; i++)
+    {
+        struct column *col = &t->cols[i];
+        if (col->deleted || r->cells[i].n || !col->has_def) continue;
+        if (!(r->cells[i].v = calloc( 1, sizeof(struct value) ))) return JET_errOutOfMemory;
+        if (!copy_value( &r->cells[i].v[0], &col->def )) return JET_errOutOfMemory;
+        r->cells[i].n = 1;
+    }
+    return JET_errSuccess;
+}
+
+static JET_ERR cursor_update( struct cursor *c, void *bookmark, DWORD cbbookmark, unsigned long *pcb )
+{
+    struct table *t = c->table;
+    struct session *s = c->ses;
+    struct row *nr, *old;
+    DWORD rid;
+    JET_ERR err;
+
+    if (c->prep < 0 || !c->copy) return JET_errUpdateNotPrepared;
+    if ((err = materialize_defaults( t, c->copy ))) return err;
+    if ((err = check_row_constraints( t, c->copy ))) return err;
+
+    if (c->prep == JET_prepInsert || c->prep == JET_prepInsertCopy || c->prep == JET_prepInsertCopyDeleteOriginal)
+    {
+        if (!(nr = copy_row( c->copy ))) return JET_errOutOfMemory;
+        nr->rid = t->next_rid++;
+        if ((err = table_add_row( t, nr ))) { free_row( nr ); return err; }
+        rid = nr->rid;
+        if ((err = undo_push( s, t, rid, NULL ))) return err;
+        if (c->prep == JET_prepInsertCopyDeleteOriginal && (old = table_find_row( t, c->copy_rid )))
+        {
+            struct row *saved = copy_row( old );
+            table_remove_row( t, old );
+            free_row( old );
+            undo_push( s, t, c->copy_rid, saved );
+        }
+    }
+    else
+    {
+        struct row *saved;
+
+        if (!(old = table_find_row( t, c->copy_rid ))) return JET_errRecordDeleted;
+        if (t->primary)
+        {
+            struct kbuf *k1, *k2;
+            DWORD n1, n2;
+            BOOL same = FALSE;
+            if (index_keys( t, t->primary, old, &k1, &n1 ) && index_keys( t, t->primary, c->copy, &k2, &n2 ))
+            {
+                same = n1 && n2 && k1[0].len == k2[0].len && !memcmp( k1[0].p, k2[0].p, k1[0].len );
+                free_keys( k2, n2 );
+            }
+            free_keys( k1, n1 );
+            if (!same) return JET_errRecordPrimaryChanged;
+        }
+        if (!(nr = copy_row( c->copy ))) return JET_errOutOfMemory;
+        nr->rid = old->rid;
+        if (!(saved = copy_row( old ))) { free_row( nr ); return JET_errOutOfMemory; }
+        table_remove_row( t, old );
+        if ((err = table_add_row( t, nr )))
+        {
+            table_add_row( t, old );
+            free_row( nr );
+            free_row( saved );
+            return err;
+        }
+        rid = nr->rid;
+        free_row( old );
+        if ((err = undo_push( s, t, rid, saved ))) return err;
+        if (c->state != CUR_DELETED && c->currid == rid && !(c->idx->sequential))
+        {
+            struct kbuf *keys;
+            DWORD nk;
+            if (index_keys( t, c->idx, nr, &keys, &nk ) && nk)
+            {
+                DWORD p = ix_lower_bound( c->idx, keys[0].p, keys[0].len, rid, TRUE );
+                if (p < c->idx->n) cursor_set_pos( c, &c->idx->e[p] );
+            }
+            free_keys( keys, nk );
+        }
+    }
+    free_row( c->copy );
+    c->copy = NULL;
+    c->prep = -1;
+    table_touch( s, t );
+    if (pcb) *pcb = 4;
+    if (bookmark && cbbookmark >= 4) memcpy( bookmark, &rid, 4 );
+    if (!s->level && t->db) commit_point( t->db );
+    return JET_errSuccess;
+}
+
+JET_ERR JET_API JetUpdate2( JET_SESID sesid, JET_TABLEID tableid, void *bookmark, unsigned long cb, unsigned long *pcb, const JET_GRBIT grbit )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %p %lu\n", sesid, tableid, bookmark, cb );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c ))) err = cursor_update( c, bookmark, cb, pcb );
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetUpdate( JET_SESID sesid, JET_TABLEID tableid, void *bookmark, unsigned long cb, unsigned long *pcb )
+{
+    return JetUpdate2( sesid, tableid, bookmark, cb, pcb, 0 );
+}
+
+JET_ERR JET_API JetDelete( JET_SESID sesid, JET_TABLEID tableid )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix\n", sesid, tableid );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        struct row *row;
+        if (c->table->db && c->table->db->readonly) err = JET_errDatabaseFileReadOnly;
+        else if (!(err = cursor_row( c, &row )))
+        {
+            struct row *saved = copy_row( row );
+            DWORD rid = row->rid;
+            if (!saved) err = JET_errOutOfMemory;
+            else
+            {
+                table_remove_row( c->table, row );
+                free_row( row );
+                if (!(err = undo_push( s, c->table, rid, saved )))
+                {
+                    c->state = CUR_DELETED;
+                    table_touch( s, c->table );
+                    if (!s->level && c->table->db) commit_point( c->table->db );
+                }
+            }
+        }
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetEscrowUpdate( JET_SESID sesid, JET_TABLEID tableid, JET_COLUMNID columnid, void *pv, unsigned long cbmax,
+                                 void *pvold, unsigned long cbold, unsigned long *pcbold, JET_GRBIT grbit )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %lu %p %lu\n", sesid, tableid, columnid, pv, cbmax );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        struct row *row, *saved, *nr;
+        struct column *col;
+        DWORD slot;
+
+        if ((err = cursor_row( c, &row ))) goto done;
+        if (!(col = col_by_id( c->table, columnid, &slot )) ) { err = JET_errBadColumnId; goto done; }
+        if (!(col->grbit & JET_bitColumnEscrowUpdate)) { err = JET_errInvalidParameter; goto done; }
+        if (!pv || cbmax != fixed_size( col->type ) || (col->type != JET_coltypLong && col->type != JET_coltypLongLong))
+            { err = JET_errInvalidBufferSize; goto done; }
+        if (!(saved = copy_row( row )) || !(nr = copy_row( row ))) { free_row( saved ); err = JET_errOutOfMemory; goto done; }
+        if (!row_resize( nr, c->table->ncols )) { free_row( saved ); free_row( nr ); err = JET_errOutOfMemory; goto done; }
+        {
+            LONGLONG old = 0, delta = 0;
+            const struct cell *cell = row_cell( row, slot );
+            if (cell->n) memcpy( &old, cell->v[0].p, min( cell->v[0].len, fixed_size( col->type ) ) );
+            if (col->type == JET_coltypLong) { LONG l = old; old = l; memcpy( &l, pv, 4 ); delta = l; }
+            else memcpy( &delta, pv, 8 );
+            if (pvold && cbold >= cbmax) memcpy( pvold, &old, cbmax );
+            if (pcbold) *pcbold = cbmax;
+            old += delta;
+            free_cell( &nr->cells[slot] );
+            if (!(nr->cells[slot].v = calloc( 1, sizeof(struct value) ))) { free_row( saved ); free_row( nr ); err = JET_errOutOfMemory; goto done; }
+            nr->cells[slot].v[0].p = malloc( fixed_size( col->type ) );
+            nr->cells[slot].v[0].len = fixed_size( col->type );
+            nr->cells[slot].n = 1;
+            memcpy( nr->cells[slot].v[0].p, &old, fixed_size( col->type ) );
+        }
+        table_remove_row( c->table, row );
+        if ((err = table_add_row( c->table, nr )))
+        {
+            table_add_row( c->table, row );
+            free_row( nr );
+            free_row( saved );
+        }
+        else
+        {
+            free_row( row );
+            undo_push( s, c->table, nr->rid, saved );
+            table_touch( s, c->table );
+            if (!s->level && c->table->db) commit_point( c->table->db );
+        }
+    }
+done:
+    unlock();
+    return err;
+}
+
+/* ---------------------------------------------------------------------- */
+/* retrieving column data                                                 */
+
+struct retrieved
+{
+    const struct value *v;   /* NULL = null value */
+    DWORD count;
+    BOOL  is_default;
+};
+
+static JET_ERR get_column_value( struct table *t, struct row *row, DWORD colid, DWORD itag, JET_GRBIT grbit,
+                                 struct retrieved *ret, struct column **pcol )
+{
+    struct column *col;
+    DWORD slot;
+    const struct cell *cell;
+
+    if (!(col = col_by_id( t, colid, &slot ))) return JET_errBadColumnId;
+    if (pcol) *pcol = col;
+    cell = row_cell( row, slot );
+    ret->v = NULL;
+    ret->is_default = FALSE;
+    ret->count = cell->n;
+    if (!cell->n)
+    {
+        if (col->has_def && !(grbit & JET_bitRetrieveIgnoreDefault))
+        {
+            ret->v = &col->def;
+            ret->count = 1;
+            ret->is_default = TRUE;
+        }
+        return JET_errSuccess;
+    }
+    if (!(col->grbit & JET_bitColumnTagged)) itag = 1;
+    if (itag == 0) return JET_errSuccess;
+    if (itag <= cell->n) ret->v = &cell->v[itag - 1];
+    return JET_errSuccess;
+}
+
+static JET_ERR cursor_retrieve( struct cursor *c, DWORD colid, void *data, DWORD cb, unsigned long *pcb, JET_GRBIT grbit,
+                                DWORD ib, DWORD itag )
+{
+    struct row *row;
+    struct retrieved r;
+    struct column *col;
+    JET_ERR err;
+
+    if (grbit & JET_bitRetrieveCopy)
+    {
+        if (!c->copy) return JET_errUpdateNotPrepared;
+        row = c->copy;
+    }
+    else if ((err = cursor_row( c, &row ))) return err;
+
+    if ((err = get_column_value( c->table, row, colid, itag, grbit, &r, &col ))) return err;
+    if (!itag && (col->grbit & JET_bitColumnTagged))
+    {
+        if (pcb) *pcb = r.count;
+        return r.count ? JET_errSuccess : JET_wrnColumnNull;
+    }
+    if (!r.v)
+    {
+        if (pcb) *pcb = 0;
+        return JET_wrnColumnNull;
+    }
+    {
+        DWORD total = r.v->len, avail = total > ib ? total - ib : 0, n = min( avail, cb );
+
+        if (pcb) *pcb = avail;
+        if (n && data) memcpy( data, r.v->p + ib, n );
+        if (avail > cb) return JET_wrnBufferTruncated;
+        return r.is_default ? JET_wrnColumnDefault : JET_errSuccess;
+    }
+}
+
+JET_ERR JET_API JetRetrieveColumn( JET_SESID sesid, JET_TABLEID tableid, JET_COLUMNID columnid, void *data, unsigned long cb,
+                                   unsigned long *pcb, JET_GRBIT grbit, JET_RETINFO *info )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %lu %p %lu %p %#lx %p\n", sesid, tableid, columnid, data, cb, pcb, grbit, info );
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+        err = cursor_retrieve( c, columnid, data, cb, pcb, grbit, info ? info->ibLongValue : 0, info ? info->itagSequence : 1 );
+    unlock();
+    if (err == JET_wrnColumnDefault) err = JET_errSuccess;
+    return err;
+}
+
+JET_ERR JET_API JetRetrieveColumns( JET_SESID sesid, JET_TABLEID tableid, JET_RETRIEVECOLUMN *rc, unsigned long count )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err, first = JET_errSuccess;
+    unsigned long i;
+
+    TRACE( "%#Ix %#Ix %p %lu\n", sesid, tableid, rc, count );
+    if (!rc) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        for (i = 0; i < count; i++)
+        {
+            unsigned long actual = 0;
+            rc[i].err = cursor_retrieve( c, rc[i].columnid, rc[i].pvData, rc[i].cbData, &actual, rc[i].grbit,
+                                         rc[i].ibLongValue, rc[i].itagSequence );
+            rc[i].cbActual = actual;
+            if (rc[i].err == JET_wrnColumnDefault) rc[i].err = JET_errSuccess;
+            if (rc[i].err && !first) first = rc[i].err;
+        }
+        err = first;
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetEnumerateColumns( JET_SESID sesid, JET_TABLEID tableid, unsigned long cid, JET_ENUMCOLUMNID *ids,
+                                     unsigned long *pcenum, JET_ENUMCOLUMN **prgenum, JET_PFNREALLOC realloc_fn,
+                                     void *ctx, unsigned long cbmost, JET_GRBIT grbit )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %lu %p %p %p %p %lu %#lx\n", sesid, tableid, cid, ids, pcenum, prgenum, realloc_fn, cbmost, grbit );
+    if (!pcenum || !prgenum || !realloc_fn) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        struct row *row;
+        struct table *t = c->table;
+        DWORD ncol, i, j, nvals = 0, databytes = 0, req;
+        DWORD *colids = NULL;
+        BYTE *block, *dp;
+        JET_ENUMCOLUMN *out;
+        JET_ENUMCOLUMNVALUE *vals;
+
+        if (grbit & JET_bitEnumerateCopy) { row = c->copy; if (!row) err = JET_errUpdateNotPrepared; }
+        else err = cursor_row( c, &row );
+        if (err) goto done;
+        if (!cid)
+        {
+            ncol = 0;
+            colids = calloc( t->ncols + 1, sizeof(*colids) );
+            for (i = 0; i < t->ncols; i++) if (!t->cols[i].deleted) colids[ncol++] = t->cols[i].id;
+        }
+        else
+        {
+            ncol = cid;
+            colids = calloc( cid + 1, sizeof(*colids) );
+            for (i = 0; i < cid; i++) colids[i] = ids[i].columnid;
+        }
+        if (!colids) { err = JET_errOutOfMemory; goto done; }
+        for (i = 0; i < ncol; i++)
+        {
+            struct column *col = col_by_id( t, colids[i], NULL );
+            const struct cell *cell;
+            DWORD slot = 0;
+            if (!col) continue;
+            col_by_id( t, colids[i], &slot );
+            cell = row_cell( row, slot );
+            if (cid && ids[i].ctagSequence)
+                nvals += ids[i].ctagSequence;
+            else
+                nvals += cell->n ? cell->n : 1;
+            for (j = 0; j < cell->n; j++) databytes += min( cell->v[j].len, cbmost ? cbmost : cell->v[j].len );
+            if (!cell->n && col->has_def) databytes += col->def.len;
+        }
+        req = ncol * sizeof(JET_ENUMCOLUMN) + nvals * sizeof(JET_ENUMCOLUMNVALUE) + databytes + 16;
+        block = realloc_fn( ctx, NULL, req );
+        if (!block) { free( colids ); err = JET_errOutOfMemory; goto done; }
+        memset( block, 0, req );
+        out = (JET_ENUMCOLUMN *)block;
+        vals = (JET_ENUMCOLUMNVALUE *)(out + ncol);
+        dp = (BYTE *)(vals + nvals);
+        for (i = 0; i < ncol; i++)
+        {
+            struct column *col = col_by_id( t, colids[i], NULL );
+            const struct cell *cell;
+            DWORD slot = 0, k;
+            out[i].columnid = colids[i];
+            if (!col) { out[i].err = JET_errBadColumnId; continue; }
+            col_by_id( t, colids[i], &slot );
+            cell = row_cell( row, slot );
+            if (!cell->n && !(col->has_def && !(grbit & JET_bitEnumerateIgnoreDefault)))
+            {
+                out[i].err = JET_wrnColumnNull;
+                continue;
+            }
+            if (grbit & JET_bitEnumeratePresenceOnly)
+            {
+                out[i].err = JET_wrnColumnPresent;
+                continue;
+            }
+            out[i].cEnumColumnValue = 0;
+            out[i].rgEnumColumnValue = vals;
+            {
+                DWORD count = cell->n ? cell->n : 1;
+                DWORD want = (cid && ids[i].ctagSequence) ? ids[i].ctagSequence : count;
+                for (k = 0; k < want; k++)
+                {
+                    DWORD tag = (cid && ids[i].ctagSequence) ? ids[i].rgtagSequence[k] : k + 1;
+                    const struct value *v = NULL;
+                    if (cell->n) { if (tag >= 1 && tag <= cell->n) v = &cell->v[tag - 1]; }
+                    else v = &col->def;
+                    vals->itagSequence = tag;
+                    if (!v) { vals->err = JET_wrnColumnNull; }
+                    else
+                    {
+                        DWORD n = cbmost ? min( v->len, cbmost ) : v->len;
+                        vals->cbData = v->len;
+                        vals->pvData = dp;
+                        memcpy( dp, v->p, n );
+                        dp += n;
+                        vals->err = n < v->len ? JET_wrnColumnTruncated : (cell->n ? 0 : JET_wrnColumnDefault);
+                    }
+                    vals++;
+                    out[i].cEnumColumnValue++;
+                }
+            }
+            out[i].err = cell->n ? JET_errSuccess : JET_wrnColumnDefault;
+        }
+        free( colids );
+        *pcenum = ncol;
+        *prgenum = out;
+    }
+done:
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetGetRecordSize( JET_SESID sesid, JET_TABLEID tableid, JET_RECSIZE *rs, const JET_GRBIT grbit )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    if (!rs) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_cursor( sesid, tableid, &s, &c )))
+    {
+        struct row *row;
+        if (grbit & JET_bitRetrieveCopy) { row = c->copy; if (!row) err = JET_errUpdateNotPrepared; }
+        else err = cursor_row( c, &row );
+        if (!err)
+        {
+            DWORD i, j;
+            memset( rs, 0, sizeof(*rs) );
+            for (i = 0; i < row->ncells && i < c->table->ncols; i++)
+            {
+                const struct column *col = &c->table->cols[i];
+                if (col->deleted || !row->cells[i].n) continue;
+                if (col->grbit & JET_bitColumnTagged) rs->cTaggedColumns++; else rs->cNonTaggedColumns++;
+                if (row->cells[i].n > 1) rs->cMultiValues += row->cells[i].n - 1;
+                for (j = 0; j < row->cells[i].n; j++)
+                {
+                    if (is_lv_type( col->type )) { rs->cLongValues++; rs->cbLongValueData += row->cells[i].v[j].len; }
+                    else rs->cbData += row->cells[i].v[j].len;
+                }
+            }
+            rs->cbOverhead = 8 + 2 * (rs->cNonTaggedColumns + rs->cTaggedColumns);
+        }
+    }
+    unlock();
+    return err;
+}
