+/* ---- indexes ---- */
+
+static JET_ERR add_index( struct table *t, const WCHAR *name, JET_GRBIT grbit, const WCHAR *keys, DWORD lcid )
+{
+    struct index *ix;
+    const WCHAR *p = keys;
+    DWORD slot, i;
+    JET_ERR err;
+
+    if (!valid_name( name )) return JET_errInvalidName;
+    if (!keys || !*keys) return JET_errInvalidParameter;
+    if (table_find_index( t, name )) return JET_errIndexDuplicate;
+    if ((grbit & JET_bitIndexPrimary) && t->primary) return JET_errIndexHasPrimary;
+    if ((grbit & JET_bitIndexPrimary) && t->idx[0]->n) return JET_errTableNotEmpty;
+    if (!(ix = new_index( name, FALSE ))) return JET_errOutOfMemory;
+    ix->grbit = grbit;
+    ix->lcid = lcid;
+    while (*p)
+    {
+        BOOL desc = FALSE;
+        const WCHAR *cname = p;
+        if (ix->nkeys == SG_MAX_KEY_COLS) { free_index( ix ); return JET_errTooManyColumns; }
+        if (*cname == '+') cname++;
+        else if (*cname == '-') { cname++; desc = TRUE; }
+        if (!col_by_name( t, cname, &slot )) { free_index( ix ); return JET_errColumnNotFound; }
+        ix->keys[ix->nkeys].slot = slot;
+        ix->keys[ix->nkeys].desc = desc;
+        ix->nkeys++;
+        p += lstrlenW( p ) + 1;
+    }
+    if (t->nidx == t->idxcap)
+    {
+        struct index **tmp = realloc( t->idx, t->idxcap * 2 * sizeof(*tmp) );
+        if (!tmp) { free_index( ix ); return JET_errOutOfMemory; }
+        t->idx = tmp;
+        t->idxcap *= 2;
+    }
+    if (!(grbit & JET_bitIndexEmpty))
+    {
+        struct index *seq = t->idx[0];
+        for (i = 0; i < seq->n; i++)
+        {
+            if ((err = ix_add_row( t, ix, seq->e[i].row )))
+            {
+                free_index( ix );
+                return err;
+            }
+        }
+    }
+    t->idx[t->nidx++] = ix;
+    if (grbit & JET_bitIndexPrimary) t->primary = ix;
+    return JET_errSuccess;
+}
+
+static WCHAR *key_to_multisz_w( const WCHAR *key, DWORD cch )
+{
+    /* the key description ends with two nulls; copy defensively */
+    DWORD n = 0;
+    WCHAR *copy;
+
+    while (key[n] || key[n + 1]) { n++; if (n > 4096) return NULL; }
+    n += 2;
+    if (!(copy = malloc( (n + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( copy, key, n * sizeof(WCHAR) );
+    copy[n] = 0;
+    return copy;
+}
+
+JET_ERR JET_API JetCreateIndexW( JET_SESID sesid, JET_TABLEID tableid, const WCHAR *name, JET_GRBIT grbit,
+                                 const WCHAR *key, unsigned long cbkey, unsigned long density )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+    WCHAR *keys;
+
+    TRACE( "%#Ix %#Ix %s %#lx\n", sesid, tableid, debugstr_w(name), grbit );
+    if (!key) return JET_errInvalidParameter;
+    if (!(keys = key_to_multisz_w( key, cbkey ))) return JET_errInvalidParameter;
+    lock();
+    if (!(err = need_ddl_cursor( sesid, tableid, &s, &c )))
+    {
+        err = add_index( c->table, name, grbit, keys, 0 );
+        if (!err) table_touch( s, c->table );
+    }
+    unlock();
+    free( keys );
+    return err;
+}
+
+JET_ERR JET_API JetCreateIndexA( JET_SESID sesid, JET_TABLEID tableid, const char *name, JET_GRBIT grbit,
+                                 const char *key, unsigned long cbkey, unsigned long density )
+{
+    WCHAR *nameW = a2w( name ), *keyW;
+    JET_ERR ret;
+    unsigned long n = 0;
+    int wn;
+
+    if (!key) { free( nameW ); return JET_errInvalidParameter; }
+    while (key[n] || key[n + 1]) { n++; if (n > 8192) { free( nameW ); return JET_errInvalidParameter; } }
+    n += 2;
+    wn = MultiByteToWideChar( CP_ACP, 0, key, n, NULL, 0 );
+    keyW = malloc( (wn + 2) * sizeof(WCHAR) );
+    MultiByteToWideChar( CP_ACP, 0, key, n, keyW, wn );
+    keyW[wn] = keyW[wn + 1] = 0;
+    ret = JetCreateIndexW( sesid, tableid, nameW, grbit, keyW, wn, density );
+    free( nameW );
+    free( keyW );
+    return ret;
+}
+
+JET_ERR JET_API JetCreateIndex2W( JET_SESID sesid, JET_TABLEID tableid, JET_INDEXCREATE_W *ic, unsigned long count )
+{
+    unsigned long i;
+    JET_ERR first = JET_errSuccess;
+
+    TRACE( "%#Ix %#Ix %p %lu\n", sesid, tableid, ic, count );
+    if (!ic || !count) return JET_errInvalidParameter;
+    for (i = 0; i < count; i++)
+    {
+        /* the structure is variable sized by cbStruct; only the common header is used */
+        JET_INDEXCREATE_W *e = (JET_INDEXCREATE_W *)((BYTE *)ic + i * ic->cbStruct);
+        e->err = JetCreateIndexW( sesid, tableid, e->szIndexName, e->grbit, e->szKey, e->cbKey, e->ulDensity );
+        if (e->err && !first) first = e->err;
+    }
+    return first;
+}
+
+JET_ERR JET_API JetCreateIndex2A( JET_SESID sesid, JET_TABLEID tableid, JET_INDEXCREATE_A *ic, unsigned long count )
+{
+    unsigned long i;
+    JET_ERR first = JET_errSuccess;
+
+    if (!ic || !count) return JET_errInvalidParameter;
+    for (i = 0; i < count; i++)
+    {
+        JET_INDEXCREATE_A *e = (JET_INDEXCREATE_A *)((BYTE *)ic + i * ic->cbStruct);
+        e->err = JetCreateIndexA( sesid, tableid, e->szIndexName, e->grbit, e->szKey, e->cbKey, e->ulDensity );
+        if (e->err && !first) first = e->err;
+    }
+    return first;
+}
+
+JET_ERR JET_API JetDeleteIndexW( JET_SESID sesid, JET_TABLEID tableid, const WCHAR *name )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+
+    TRACE( "%#Ix %#Ix %s\n", sesid, tableid, debugstr_w(name) );
+    lock();
+    if (!(err = need_ddl_cursor( sesid, tableid, &s, &c )))
+    {
+        struct table *t = c->table;
+        struct index *ix = name ? table_find_index( t, name ) : NULL;
+        DWORD i;
+        if (!ix) err = JET_errIndexNotFound;
+        else if (ix == t->primary) err = JET_errIllegalOperation;
+        else
+        {
+            struct cursor *o;
+            LIST_FOR_EACH_ENTRY( o, &s->cursors, struct cursor, entry )
+                if (o->table == t && o->idx == ix) err = JET_errIndexInUse;
+            if (!err)
+            {
+                for (i = 1; i < t->nidx; i++) if (t->idx[i] == ix) break;
+                memmove( &t->idx[i], &t->idx[i + 1], (t->nidx - i - 1) * sizeof(*t->idx) );
+                t->nidx--;
+                free_index( ix );
+                table_touch( s, t );
+            }
+        }
+    }
+    unlock();
+    return err;
+}
+
+JET_ERR JET_API JetDeleteIndexA( JET_SESID sesid, JET_TABLEID tableid, const char *name )
+{
+    WCHAR *nameW = a2w( name );
+    JET_ERR ret = JetDeleteIndexW( sesid, tableid, nameW );
+    free( nameW );
+    return ret;
+}
+
+static void cursor_reset_position( struct cursor *c )
+{
+    free( c->curkey );
+    c->curkey = NULL;
+    c->curkeylen = 0;
+    c->state = CUR_BEFORE;
+}
+
+/* set the cursor onto the (key, row) entry of its current index */
+static void cursor_set_pos( struct cursor *c, const struct ientry *e )
+{
+    BYTE *key = malloc( e->keylen ? e->keylen : 1 );
+
+    if (!key) { cursor_reset_position( c ); return; }
+    memcpy( key, e->key, e->keylen );
+    free( c->curkey );
+    c->curkey = key;
+    c->curkeylen = e->keylen;
+    c->currid = e->row->rid;
+    c->state = CUR_AT;
+}
+
+static JET_ERR cursor_set_index( struct cursor *c, const WCHAR *name, unsigned long itag )
+{
+    struct table *t = c->table;
+    struct index *ix;
+    struct row *row = NULL;
+
+    if (!name || !*name) ix = table_default_index( t );
+    else if (!(ix = table_find_index( t, name ))) return JET_errIndexNotFound;
+    if (c->state == CUR_AT) row = table_find_row( t, c->currid );
+    c->idx = ix;
+    free( c->mk ); c->mk = NULL; c->mklen = 0; c->mkcols = 0; c->mk_valid = FALSE;
+    free( c->hi ); c->hi = NULL;
+    free( c->lo ); c->lo = NULL;
+    if (row)
+    {
+        struct kbuf *keys;
+        DWORD nk;
+        if (index_keys( t, ix, row, &keys, &nk ) && nk)
+        {
+            DWORD p = ix_lower_bound( ix, keys[0].p, keys[0].len, row->rid, TRUE );
+            if (p < ix->n) cursor_set_pos( c, &ix->e[p] ); else cursor_reset_position( c );
+            free_keys( keys, nk );
+            return JET_errSuccess;
+        }
+        free_keys( keys, nk );
+    }
+    cursor_reset_position( c );
+    return JET_errSuccess;
+}
