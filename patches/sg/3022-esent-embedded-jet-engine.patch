+static JET_ERR delete_column( JET_SESID sesid, JET_TABLEID tableid, const WCHAR *name )
+{
+    struct session *s;
+    struct cursor *c;
+    JET_ERR err;
+    DWORD slot, i, j;
+    struct table *t;
+
+    if (!name) return JET_errInvalidParameter;
+    if ((err = need_ddl_cursor( sesid, tableid, &s, &c ))) return err;
+    t = c->table;
+    if (!col_by_name( t, name, &slot )) return JET_errColumnNotFound;
+    for (i = 1; i < t->nidx; i++)
+        for (j = 0; j < t->idx[i]->nkeys; j++)
+            if (t->idx[i]->keys[j].slot == slot) return JET_errColumnInUse;
+    t->cols[slot].deleted = TRUE;
+    for (i = 0; i < t->idx[0]->n; i++)
+    {
+        struct row *r = t->idx[0]->e[i].row;
+        if (slot < r->ncells) free_cell( &r->cells[slot] );
+    }
+    table_touch( s, t );
+    return JET_errSuccess;
+}
