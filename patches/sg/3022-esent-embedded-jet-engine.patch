+static JET_ERR WINAPI create_instance_api( JET_INSTANCE *pinst, const WCHAR *name )
+{
+    struct instance *inst;
+    DWORD i;
+
+    if (!pinst) return JET_errInvalidParameter;
+    if (!(inst = create_instance( name ))) return JET_errOutOfMemory;
+    for (i = 0; i < MAX_PARAM; i++)
+    {
+        if (!global_params[i].set) continue;
+        inst->params[i].value = global_params[i].value;
+        if (global_params[i].str)
+        {
+            free( inst->params[i].str );
+            inst->params[i].str = wcsdup( global_params[i].str );
+        }
+    }
+    *pinst = (JET_INSTANCE)inst;
+    return JET_errSuccess;
+}
