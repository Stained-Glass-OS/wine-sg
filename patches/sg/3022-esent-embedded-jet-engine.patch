+    if (!name) return JET_errInvalidParameter;
+    if (!(tmp = malloc( (JET_cbNameMost + 2) * sizeof(WCHAR) ))) return JET_errOutOfMemory;
+    err = JetGetCurrentIndexW( sesid, tableid, tmp, JET_cbNameMost + 2 );
+    if (!err)
+    {
+        if (WideCharToMultiByte( CP_ACP, 0, tmp, -1, NULL, 0, NULL, NULL ) > cch) err = JET_errBufferTooSmall;
+        else WideCharToMultiByte( CP_ACP, 0, tmp, -1, name, cch, NULL, NULL );
+    }
+    free( tmp );
+    return err;
+}
