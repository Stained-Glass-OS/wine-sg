+JET_ERR JET_API JetCloseDatabase( JET_SESID sesid, JET_DBID dbid, JET_GRBIT grbit )
+{
+    struct session *s;
+    JET_ERR err;
+
+    TRACE( "%#Ix %lu %#lx\n", sesid, dbid, grbit );
+    lock();
+    if (!(err = need_session( sesid, &s )))
+    {
+        struct database *db = session_db( s, dbid );
+        if (!db) err = JET_errInvalidDatabaseId;
+        else
+        {
+            struct cursor *c, *next;
+            LIST_FOR_EACH_ENTRY_SAFE( c, next, &s->cursors, struct cursor, entry )
+                if (c->table && c->table->db == db) close_cursor( c );
+            s->dbs[dbid - 2].open = FALSE;
+            s->dbs[dbid - 2].db = NULL;
+            db->opens--;
+            commit_point( db );
+        }
+    }
+    unlock();
+    return err;
+}
