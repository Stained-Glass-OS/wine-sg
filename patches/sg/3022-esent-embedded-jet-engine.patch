+        else if (!name || !(col = col_by_name( c->table, name, NULL ))) err = JET_errColumnNotFound;
+        else if (wcsicmp( name, newname ) && col_by_name( c->table, newname, NULL )) err = JET_errColumnDuplicate;
+        else if (!(dup = wdup( newname ))) err = JET_errOutOfMemory;
