+
+static float anim_transition(D3DXTRANSITION_TYPE type, double fraction)
+{
+    if (fraction <= 0.0)
+        return 0.0f;
+    if (fraction >= 1.0)
+        return 1.0f;
+    if (type == D3DXTRANSITION_EASEINEASEOUT)
+        return (float)(fraction * fraction * (3.0 - 2.0 * fraction));
+    return (float)fraction;
+}
+
+/* Brings an event up to date with the time the controller has reached. */
+static void anim_event_update(struct d3dx9_animation_controller *animation, struct anim_event *event,
+        double time, struct anim_track *track)
+{
+    const D3DXEVENT_DESC *desc = &event->desc;
+    float *float_value = NULL;
+
+    if (event->finished || desc->StartTime > time)
+        return;
+
+    switch (desc->Type)
+    {
+        case D3DXEVENT_TRACKSPEED: float_value = &track->desc.Speed; break;
+        case D3DXEVENT_TRACKWEIGHT: float_value = &track->desc.Weight; break;
+        case D3DXEVENT_PRIORITYBLEND: float_value = &animation->priority_blend; break;
+        default: break;
+    }
+
+    if (!event->started)
+    {
+        event->started = TRUE;
+        if (float_value)
+            event->base_float = *float_value;
+    }
+
+    switch (desc->Type)
+    {
+        case D3DXEVENT_TRACKSPEED:
+        case D3DXEVENT_TRACKWEIGHT:
+        case D3DXEVENT_PRIORITYBLEND:
+        {
+            float target = desc->Type == D3DXEVENT_TRACKSPEED ? desc->Speed : desc->Weight;
+
+            if (desc->Duration > 0.0 && time < desc->StartTime + desc->Duration)
+            {
+                float f = anim_transition(desc->Transition, (time - desc->StartTime) / desc->Duration);
+
+                *float_value = event->base_float + (target - event->base_float) * f;
+            }
+            else
+            {
+                *float_value = target;
+                event->finished = TRUE;
+            }
+            break;
+        }
+
+        case D3DXEVENT_TRACKPOSITION:
+            track->desc.Position = desc->Position;
+            event->finished = TRUE;
+            break;
+
+        case D3DXEVENT_TRACKENABLE:
+            track->desc.Enable = desc->Enable;
+            event->finished = TRUE;
+            break;
+
+        default:
+            break;
+    }
+}
+
+static void anim_blend_quaternion(D3DXQUATERNION *acc, float *weight_sum, const D3DXQUATERNION *q, float weight)
+{
+    if (*weight_sum == 0.0f)
+    {
+        *acc = *q;
+    }
+    else
+    {
+        D3DXQUATERNION tmp;
+
+        D3DXQuaternionSlerp(&tmp, acc, q, weight / (*weight_sum + weight));
+        *acc = tmp;
+    }
+    *weight_sum += weight;
+}
+
+struct anim_pose
+{
+    D3DXVECTOR3 scale, translation;
+    D3DXQUATERNION rotation;
+    float weight;
+};
+
+/* The pose the tracks of one priority give an output. */
+static BOOL anim_group_pose(struct d3dx9_animation_controller *animation, const char *name,
+        D3DXPRIORITY_TYPE priority, struct anim_pose *pose)
+{
+    UINT t;
+
+    memset(pose, 0, sizeof(*pose));
+    for (t = 0; t < animation->max_tracks; ++t)
+    {
+        const struct anim_track *track = &animation->tracks[t];
+        D3DXVECTOR3 scale, translation;
+        D3DXQUATERNION rotation;
+        UINT index;
+        double position;
+        float weight;
+
+        if (!track->set || !track->desc.Enable || track->desc.Priority != priority || track->desc.Weight <= 0.0f)
+            continue;
+        if (FAILED(track->set->lpVtbl->GetAnimationIndexByName(track->set, name, &index)))
+            continue;
+
+        position = track->set->lpVtbl->GetPeriodicPosition(track->set, track->desc.Position);
+        if (FAILED(track->set->lpVtbl->GetSRT(track->set, position, index, &scale, &rotation, &translation)))
+            continue;
+
+        weight = track->desc.Weight;
+#ifdef SG_MUTANT_D3DXANIM_WEIGHT_IGNORED
+        weight = 1.0f;
+#endif
+        if (pose->weight == 0.0f)
+        {
+            pose->scale = scale;
+            pose->translation = translation;
+        }
+        else
+        {
+            float f = weight / (pose->weight + weight);
+
+            D3DXVec3Lerp(&pose->scale, &pose->scale, &scale, f);
+            D3DXVec3Lerp(&pose->translation, &pose->translation, &translation, f);
+        }
+        anim_blend_quaternion(&pose->rotation, &pose->weight, &rotation, weight);
+    }
+
+    return pose->weight != 0.0f;
+}
+
+static void anim_update_outputs(struct d3dx9_animation_controller *animation)
+{
+    UINT i;
+
+    for (i = 0; i < animation->output_count; ++i)
+    {
+        const struct anim_output *output = &animation->outputs[i];
+        struct anim_pose low, high, result;
+        BOOL has_low, has_high;
+
+        has_low = anim_group_pose(animation, output->name, D3DXPRIORITY_LOW, &low);
+        has_high = anim_group_pose(animation, output->name, D3DXPRIORITY_HIGH, &high);
+        if (!has_low && !has_high)
+            continue;
+
+        if (has_low && has_high)
+        {
+            float f = animation->priority_blend;
+
+            D3DXVec3Lerp(&result.scale, &low.scale, &high.scale, f);
+            D3DXVec3Lerp(&result.translation, &low.translation, &high.translation, f);
+            D3DXQuaternionSlerp(&result.rotation, &low.rotation, &high.rotation, f);
+        }
+        else
+        {
+            result = has_low ? low : high;
+        }
+
+        if (output->scale)
+            *output->scale = result.scale;
+        if (output->rotation)
+            *output->rotation = result.rotation;
+        if (output->translation)
+            *output->translation = result.translation;
+        if (output->matrix)
+            D3DXMatrixTransformation(output->matrix, NULL, NULL, &result.scale, NULL, &result.rotation,
+                    &result.translation);
+    }
 }
 
 static HRESULT WINAPI d3dx9_animation_controller_AdvanceTime(ID3DXAnimationController *iface, double time_delta,
         ID3DXAnimationCallbackHandler *callback_handler)
 {
-    FIXME("iface %p, time_delta %.16e, callback_handler %p stub.\n", iface, time_delta, callback_handler);
+    struct d3dx9_animation_controller *animation = impl_from_ID3DXAnimationController(iface);
+    double new_time;
+    UINT t, e;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, time_delta %.16e, callback_handler %p.\n", iface, time_delta, callback_handler);
+
+    if (time_delta < 0.0)
+        return D3DERR_INVALIDCALL;
+
+    new_time = animation->time + time_delta;
+
+    /* the events up to the new time, in the order of their start times */
+#ifdef SG_MUTANT_D3DXANIM_EVENTS_IGNORED
+    for (e = 0; e < animation->event_count && 0; ++e)
+#else
+    for (e = 0; e < animation->event_count; ++e)
+#endif
+    {
+        struct anim_event *event = &animation->events[e];
+        struct anim_track dummy = {0};
+
+        anim_event_update(animation, event, new_time,
+                event->desc.Type == D3DXEVENT_PRIORITYBLEND ? &dummy : &animation->tracks[event->desc.Track]);
+    }
+
+    for (t = 0; t < animation->max_tracks; ++t)
+    {
+        struct anim_track *track = &animation->tracks[t];
+        double old_position;
+
+        if (!track->set || !track->desc.Enable)
+            continue;
+
+        old_position = track->desc.Position;
+#ifdef SG_MUTANT_D3DXANIM_SPEED_IGNORED
+        track->desc.Position += time_delta;
+#else
+        track->desc.Position += time_delta * track->desc.Speed;
+#endif
+
+        /* the callback keys passed on the way */
+        if (callback_handler && track->set)
+        {
+            ID3DXAnimationSet *set = track->set;
+            double period = set->lpVtbl->GetPeriod(set);
+            double from = old_position, to = track->desc.Position, cb_position;
+            void *data;
+            DWORD flags = D3DXCALLBACK_SEARCH_EXCLUDING_INITIAL_POSITION;
+            double cursor = from;
+            unsigned int guard = 0;
+
+            if (to > from && period > 0.0)
+            {
+                while (guard++ < 64 && SUCCEEDED(set->lpVtbl->GetCallback(set, set->lpVtbl->GetPeriodicPosition(set, cursor),
+                        flags, &cb_position, &data)) && data)
+                {
+                    double base = floor(cursor / period) * period;
+                    double absolute = base + cb_position;
+
+                    if (absolute < cursor)
+                        absolute += period;
+                    if (absolute > to)
+                        break;
+                    if (FAILED(hr = callback_handler->lpVtbl->HandleCallback(callback_handler, t, data)))
+                        return hr;
+                    cursor = absolute;
+                }
+            }
+        }
+    }
+
+    animation->time = new_time;
+    anim_update_outputs(animation);
+
+    return D3D_OK;
 }
 
