+/* The animation of a frame: the keys of an Animation object of the file. */
+struct x_animation
+{
+    char *name;
+    D3DXKEY_VECTOR3 *scale, *translation;
+    D3DXKEY_QUATERNION *rotation;
+    UINT scale_count, rotation_count, translation_count;
+};
+
+static void x_animation_cleanup(struct x_animation *animation)
+{
+    free(animation->name);
+    free(animation->scale);
+    free(animation->translation);
+    free(animation->rotation);
+}
+
+static HRESULT x_animation_add_key(struct x_animation *animation, DWORD key_type, DWORD time, DWORD value_count,
+        const float *values)
+{
+    D3DXVECTOR3 scale, translation;
+    D3DXQUATERNION rotation;
+    D3DXMATRIX matrix;
+    void *new_array;
+
+    switch (key_type)
+    {
+        case 0: /* rotation, (w, x, y, z) */
+            if (value_count != 4)
+                return E_FAIL;
+            /* the stored rotation is the other way round than the one of D3DXQuaternion* */
+            rotation.x = -values[1]; rotation.y = -values[2]; rotation.z = -values[3]; rotation.w = values[0];
+            break;
+        case 1: /* scale */
+        case 2: /* position */
+            if (value_count != 3)
+                return E_FAIL;
+            break;
+        case 3: /* matrix */
+        case 4:
+            if (value_count != 16)
+                return E_FAIL;
+            memcpy(&matrix, values, sizeof(matrix));
+            if (FAILED(D3DXMatrixDecompose(&scale, &rotation, &translation, &matrix)))
+                return E_FAIL;
+            break;
+        default:
+            return E_FAIL;
+    }
+
+    if (key_type == 1 || key_type >= 3)
+    {
+        if (key_type == 1)
+            scale = *(const D3DXVECTOR3 *)values;
+        if (!(new_array = realloc(animation->scale, (animation->scale_count + 1) * sizeof(*animation->scale))))
+            return E_OUTOFMEMORY;
+        animation->scale = new_array;
+        animation->scale[animation->scale_count].Time = time;
+        animation->scale[animation->scale_count++].Value = scale;
+    }
+    if (key_type == 0 || key_type >= 3)
+    {
+        if (!(new_array = realloc(animation->rotation, (animation->rotation_count + 1) * sizeof(*animation->rotation))))
+            return E_OUTOFMEMORY;
+        animation->rotation = new_array;
+        animation->rotation[animation->rotation_count].Time = time;
+        animation->rotation[animation->rotation_count++].Value = rotation;
+    }
+    if (key_type == 2 || key_type >= 3)
+    {
+        if (key_type == 2)
+            translation = *(const D3DXVECTOR3 *)values;
+        if (!(new_array = realloc(animation->translation, (animation->translation_count + 1) * sizeof(*animation->translation))))
+            return E_OUTOFMEMORY;
+        animation->translation = new_array;
+        animation->translation[animation->translation_count].Time = time;
+        animation->translation[animation->translation_count++].Value = translation;
+    }
+
+    return D3D_OK;
+}
+
+static HRESULT x_animation_load(ID3DXFileData *filedata, struct x_animation *animation)
+{
+    SIZE_T i, count;
+    GUID type;
+    HRESULT hr;
+
+    memset(animation, 0, sizeof(*animation));
+
+    /* the name of an animation is the name of the frame it moves */
+    if (FAILED(hr = filedata->lpVtbl->GetChildren(filedata, &count)))
+        return hr;
+    for (i = 0; i < count; ++i)
+    {
+        ID3DXFileData *child;
+
+        if (FAILED(hr = filedata->lpVtbl->GetChild(filedata, i, &child)))
+            return hr;
+        if (SUCCEEDED(child->lpVtbl->GetType(child, &type)))
+        {
+            if (IsEqualGUID(&type, &TID_D3DRMFrame) && child->lpVtbl->IsReference(child))
+            {
+                hr = filedata_get_name(child, &animation->name);
+            }
+            else if (IsEqualGUID(&type, &TID_D3DRMAnimationKey))
+            {
+                SIZE_T size;
+                const DWORD *data;
+
+                if (SUCCEEDED(hr = child->lpVtbl->Lock(child, &size, (const void **)&data)))
+                {
+                    DWORD key_type = size >= 8 ? data[0] : ~0u, key_count = size >= 8 ? data[1] : 0, k;
+                    const DWORD *p = data + 2;
+
+                    for (k = 0; k < key_count && SUCCEEDED(hr); ++k)
+                    {
+                        if ((SIZE_T)((p - data + 2) * sizeof(*p)) > size
+                                || (SIZE_T)((p - data + 2 + p[1]) * sizeof(*p)) > size)
+                        {
+                            hr = E_FAIL;
+                            break;
+                        }
+                        hr = x_animation_add_key(animation, key_type, p[0], p[1], (const float *)(p + 2));
+                        p += 2 + p[1];
+                    }
+                    child->lpVtbl->Unlock(child);
+                }
+            }
+        }
+        child->lpVtbl->Release(child);
+        if (FAILED(hr))
+            return hr;
+    }
+
+    if (!animation->name && !(animation->name = strdup("")))
+        return E_OUTOFMEMORY;
+
+    return D3D_OK;
+}
+
+#define X_ANIMATION_TICKS_PER_SECOND 4800.0
+
+/* The animation sets of a file as a controller, with the frames' matrices as its outputs. */
+static HRESULT load_animation_controller(ID3DXFileEnumObject *enumobj, D3DXFRAME *root,
+        ID3DXAnimationController **controller)
+{
+    ID3DXKeyframedAnimationSet **sets = NULL;
+    UINT set_count = 0, animation_total = 0, i, j;
+    ID3DXAnimationController *ctrl = NULL;
+    SIZE_T count, k;
+    GUID type;
+    HRESULT hr = D3D_OK;
+
+    if (FAILED(hr = enumobj->lpVtbl->GetChildren(enumobj, &count)))
+        return hr;
+
+    /* first count what there is, then make the sets */
+    for (k = 0; k < count; ++k)
+    {
+        ID3DXFileData *child;
+        SIZE_T children;
+
+        if (FAILED(hr = enumobj->lpVtbl->GetChild(enumobj, k, &child)))
+            return hr;
+        if (SUCCEEDED(child->lpVtbl->GetType(child, &type)) && IsEqualGUID(&type, &TID_D3DRMAnimationSet))
+        {
+            ++set_count;
+            if (SUCCEEDED(child->lpVtbl->GetChildren(child, &children)))
+                animation_total += children;
+        }
+        child->lpVtbl->Release(child);
+    }
+
+    if (!set_count)
+        return D3D_OK;
+
+    if (!(sets = calloc(set_count, sizeof(*sets))))
+        return E_OUTOFMEMORY;
+
+    set_count = 0;
+    for (k = 0; k < count && SUCCEEDED(hr); ++k)
+    {
+        ID3DXFileData *child;
+        SIZE_T children;
+        char *set_name = NULL;
+
+        if (FAILED(hr = enumobj->lpVtbl->GetChild(enumobj, k, &child)))
+            break;
+        if (SUCCEEDED(child->lpVtbl->GetType(child, &type)) && IsEqualGUID(&type, &TID_D3DRMAnimationSet))
+        {
+            ID3DXKeyframedAnimationSet *set;
+            UINT animations = 0;
+
+            if (SUCCEEDED(hr = filedata_get_name(child, &set_name))
+                    && SUCCEEDED(hr = child->lpVtbl->GetChildren(child, &children))
+                    && SUCCEEDED(hr = D3DXCreateKeyframedAnimationSet(set_name, X_ANIMATION_TICKS_PER_SECOND, D3DXPLAY_LOOP,
+                            max(children, 1), 0, NULL, &set)))
+            {
+                for (i = 0; i < children && SUCCEEDED(hr); ++i)
+                {
+                    ID3DXFileData *animation_data;
+                    struct x_animation animation;
+
+                    if (FAILED(hr = child->lpVtbl->GetChild(child, i, &animation_data)))
+                        break;
+                    if (SUCCEEDED(animation_data->lpVtbl->GetType(animation_data, &type))
+                            && IsEqualGUID(&type, &TID_D3DRMAnimation))
+                    {
+                        if (SUCCEEDED(hr = x_animation_load(animation_data, &animation)))
+                        {
+                            if (animation.scale_count || animation.rotation_count || animation.translation_count)
+                            {
+                                hr = set->lpVtbl->RegisterAnimationSRTKeys(set, animation.name, animation.scale_count,
+                                        animation.rotation_count, animation.translation_count, animation.scale,
+                                        animation.rotation, animation.translation, NULL);
+                                ++animations;
+                            }
+                        }
+                        x_animation_cleanup(&animation);
+                    }
+                    animation_data->lpVtbl->Release(animation_data);
+                }
+                if (SUCCEEDED(hr))
+                    sets[set_count++] = set;
+                else
+                    set->lpVtbl->Release(set);
+            }
+            free(set_name);
+        }
+        child->lpVtbl->Release(child);
+    }
+
+    if (SUCCEEDED(hr))
+        hr = D3DXCreateAnimationController(max(animation_total, 1), set_count, set_count, 20, &ctrl);
+
+    for (i = 0; i < set_count && SUCCEEDED(hr); ++i)
+    {
+        const ID3DXKeyframedAnimationSet *set = sets[i];
+        UINT n = ((ID3DXAnimationSet *)set)->lpVtbl->GetNumAnimations((ID3DXAnimationSet *)set);
+
+        hr = ctrl->lpVtbl->RegisterAnimationSet(ctrl, (ID3DXAnimationSet *)sets[i]);
+        if (SUCCEEDED(hr))
+            hr = ctrl->lpVtbl->SetTrackAnimationSet(ctrl, i, (ID3DXAnimationSet *)sets[i]);
+        if (SUCCEEDED(hr))
+            hr = ctrl->lpVtbl->SetTrackEnable(ctrl, i, TRUE);
+
+        for (j = 0; j < n && SUCCEEDED(hr); ++j)
+        {
+            const char *name;
+            D3DXFRAME *frame;
+
+            if (FAILED(((ID3DXAnimationSet *)sets[i])->lpVtbl->GetAnimationNameByIndex((ID3DXAnimationSet *)sets[i], j, &name)))
+                continue;
+            if ((frame = D3DXFrameFind(root, name)))
+                hr = ctrl->lpVtbl->RegisterAnimationOutput(ctrl, name, &frame->TransformationMatrix, NULL, NULL, NULL);
+        }
+    }
+
+    for (i = 0; i < set_count; ++i)
+        sets[i]->lpVtbl->Release(sets[i]);
+    free(sets);
+
+    if (FAILED(hr))
+    {
+        if (ctrl)
+            ctrl->lpVtbl->Release(ctrl);
+        return hr;
+    }
+
+    *controller = ctrl;
+    return D3D_OK;
+}
