+/***********************************************************************
+ *           InternetSetCookieEx2 (WININET.@)
+ *
+ * A cookie given as its parts (7853: PotPlayer): set as the cookie line they make.
+ */
+DWORD WINAPI InternetSetCookieEx2(const WCHAR *url, const INTERNET_COOKIE2 *cookie, const WCHAR *p3p_policy,
+                                  DWORD flags, DWORD *state)
+{
+    WCHAR expires[INTERNET_RFC1123_BUFSIZE];
+    WCHAR *data;
+    size_t len;
+    DWORD ret;
+
+    TRACE("(%s, %p, %s, %#lx, %p)\n", debugstr_w(url), cookie, debugstr_w(p3p_policy), flags, state);
+
+    if (state) *state = COOKIE_STATE_UNKNOWN;
+    if (!url || !cookie || !cookie->pwszName || !cookie->pwszName[0]) return ERROR_INVALID_PARAMETER;
+
+    len = 64 + wcslen(cookie->pwszValue ? cookie->pwszValue : L"") + ARRAY_SIZE(expires);
+    if (cookie->pwszDomain) len += wcslen(cookie->pwszDomain);
+    if (cookie->pwszPath) len += wcslen(cookie->pwszPath);
+    if (!(data = malloc(len * sizeof(WCHAR)))) return ERROR_NOT_ENOUGH_MEMORY;
+    wcscpy(data, cookie->pwszValue ? cookie->pwszValue : L"");
+    if (cookie->pwszDomain && cookie->pwszDomain[0])
+    {
+        wcscat(data, L"; domain=");
+        wcscat(data, cookie->pwszDomain);
+    }
+    if (cookie->pwszPath && cookie->pwszPath[0])
+    {
+        wcscat(data, L"; path=");
+        wcscat(data, cookie->pwszPath);
+    }
+    if (cookie->fExpiresSet && !(cookie->dwFlags & INTERNET_COOKIE_IS_SESSION))
+    {
+        SYSTEMTIME st;
+        if (FileTimeToSystemTime(&cookie->ftExpires, &st) &&
+            InternetTimeFromSystemTimeW(&st, INTERNET_RFC1123_FORMAT, expires, sizeof(expires)))
+        {
+            wcscat(data, L"; expires=");
+            wcscat(data, expires);
+        }
+    }
+    if (cookie->dwFlags & INTERNET_COOKIE_IS_SECURE) wcscat(data, L"; secure");
+
+    ret = InternetSetCookieExW(url, cookie->pwszName, data,
+                               (flags | cookie->dwFlags) & INTERNET_COOKIE_HTTPONLY, 0);
+    free(data);
+    if (state) *state = ret;
+    if (ret == COOKIE_STATE_ACCEPT || ret == COOKIE_STATE_LEASH || ret == COOKIE_STATE_DOWNGRADE) return ERROR_SUCCESS;
+    return GetLastError() ? GetLastError() : ERROR_INVALID_OPERATION;
+}
