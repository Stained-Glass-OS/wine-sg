 }
+
+/***********************************************************************
+ *		SetCredentialsAttributesW (SECUR32.@)
+ *
+ * No package here takes credential attributes (7853: msquic sets some on its TLS credentials):
+ * a valid handle is told the function is not supported, as by a package without it.
+ */
+SECURITY_STATUS WINAPI SetCredentialsAttributesW(PCredHandle cred, ULONG attribute, void *buffer, ULONG size)
+{
+    SecurePackage *package;
+
+    TRACE("%p %lu %p %lu\n", cred, attribute, buffer, size);
+    if (!cred || !(package = (SecurePackage *)cred->dwUpper) || !package->provider) return SEC_E_INVALID_HANDLE;
+    return SEC_E_UNSUPPORTED_FUNCTION;
+}
+
+/***********************************************************************
+ *		SetCredentialsAttributesA (SECUR32.@)
+ */
+SECURITY_STATUS WINAPI SetCredentialsAttributesA(PCredHandle cred, ULONG attribute, void *buffer, ULONG size)
+{
+    return SetCredentialsAttributesW(cred, attribute, buffer, size);
+}
