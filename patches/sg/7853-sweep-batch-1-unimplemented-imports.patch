+/* a topology that encodes a source into a file: the transcode API is not built here; the caller
+ * (Zoom's media adapter) is told so instead of the program ending at a stub */
+HRESULT WINAPI MFCreateTranscodeTopology(IMFMediaSource *source, const WCHAR *url, IMFTranscodeProfile *profile,
+                                         IMFTopology **topology)
+{
+    FIXME("(%p, %s, %p, %p): not implemented\n", source, debugstr_w(url), profile, topology);
+    if (!topology) return E_POINTER;
+    *topology = NULL;
+    if (!source || !url || !profile) return E_INVALIDARG;
+    return E_NOTIMPL;
+}
