 }
 
+/* 7853: the BSS list of an adapter, one entry per network the scan sees -- the scan reports no
+ * BSSID, channel or rates, so those are left zero; signal quality and RSSI are the scan's */
+DWORD WINAPI WlanGetNetworkBssList(HANDLE handle, const GUID *guid, const DOT11_SSID *ssid, DOT11_BSS_TYPE bss_type,
+                                   BOOL security, void *reserved, WLAN_BSS_LIST **bss_list)
+{
+    WLAN_AVAILABLE_NETWORK_LIST *nets;
+    WLAN_BSS_LIST *list;
+    DWORD err, i, n = 0, size;
+
+    TRACE("(%p, %s, %p, %d, %d, %p, %p)\n", handle, wine_dbgstr_guid(guid), ssid, bss_type, security, reserved, bss_list);
+
+    if (!handle || !guid || reserved || !bss_list) return ERROR_INVALID_PARAMETER;
+    if (ssid && bss_type != dot11_BSS_type_infrastructure && bss_type != dot11_BSS_type_independent)
+        return ERROR_INVALID_PARAMETER;
+    if ((err = WlanGetAvailableNetworkList(handle, guid, 0, NULL, &nets))) return err;
+
+    size = offsetof(WLAN_BSS_LIST, wlanBssEntries[nets->dwNumberOfItems ? nets->dwNumberOfItems : 1]);
+    if (!(list = WlanAllocateMemory(size)))
+    {
+        WlanFreeMemory(nets);
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    memset(list, 0, size);
+    for (i = 0; i < nets->dwNumberOfItems; i++)
+    {
+        const WLAN_AVAILABLE_NETWORK *net = &nets->Network[i];
+        WLAN_BSS_ENTRY *e;
+
+        if (ssid && (ssid->uSSIDLength != net->dot11Ssid.uSSIDLength ||
+                     memcmp(ssid->ucSSID, net->dot11Ssid.ucSSID, ssid->uSSIDLength))) continue;
+        if (bss_type != dot11_BSS_type_any && bss_type != net->dot11BssType) continue;
+        if (ssid && security != net->bSecurityEnabled) continue;
+        e = &list->wlanBssEntries[n++];
+        e->dot11Ssid = net->dot11Ssid;
+        e->dot11BssType = net->dot11BssType;
+        e->dot11BssPhyType = dot11_phy_type_any;
+        e->uLinkQuality = net->wlanSignalQuality;
+        e->lRssi = (LONG)net->wlanSignalQuality / 2 - 100;   /* quality 0..100 is -100..-50 dBm */
+        e->bInRegDomain = TRUE;
+    }
+    WlanFreeMemory(nets);
+    list->dwTotalSize = size;
+    list->dwNumberOfItems = n;
+    *bss_list = list;
+    return ERROR_SUCCESS;
+}
