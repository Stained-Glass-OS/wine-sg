+/******************************************************************
+ *    ResolveIpNetEntry2 (IPHLPAPI.@)
+ *
+ * The neighbor (link-layer address) of ROW's address, from the neighbor table (7853: msquic). No
+ * solicitation is sent from here: an address not in the table yet is not found.
+ */
+DWORD WINAPI ResolveIpNetEntry2( MIB_IPNET_ROW2 *row, const SOCKADDR_INET *source )
+{
+    MIB_IPNET_TABLE2 *table;
+    DWORD err, i;
+
+    TRACE( "%p %p\n", row, source );
+
+    if (!row || !is_ip_family( row->Address.si_family )) return ERROR_INVALID_PARAMETER;
+    if ((err = GetIpNetTable2( row->Address.si_family, &table ))) return err;
+    err = ERROR_BAD_NET_NAME;
+    for (i = 0; i < table->NumEntries; i++)
+    {
+        const MIB_IPNET_ROW2 *r = table->Table + i;
+
+        if ((row->InterfaceLuid.Value || row->InterfaceIndex) &&
+            !same_interface( &row->InterfaceLuid, row->InterfaceIndex, &r->InterfaceLuid, r->InterfaceIndex )) continue;
+        if (!same_address( &r->Address, &row->Address )) continue;
+        if (r->State <= NlnsIncomplete || !r->PhysicalAddressLength) continue;
+        *row = *r;
+        err = NO_ERROR;
+        break;
+    }
+    FreeMibTable( table );
+    return err;
+}
+
 /* The groups the kernel says each interface has joined: /proc/net/igmp (IPv4) and
  * /proc/net/igmp6 (IPv6), read through the \\?\unix\ path so that a missing drive
  * mapping for / does not matter. The interface number in both is the one the
