+/***********************************************************************
+ *             I_RpcOpenClientProcess (RPCRT4.@)
+ *
+ * The process of the local client of the call (or of BINDING), opened with ACCESS by the server's
+ * own token, as OpenProcess would (7853: Chrome's and Brave's elevation services).
+ */
+RPC_STATUS WINAPI I_RpcOpenClientProcess(RPC_BINDING_HANDLE binding, ULONG access, void **process)
+{
+    RPC_STATUS status;
+    ULONG pid;
+
+    TRACE("%p %#lx %p\n", binding, access, process);
+
+    if (!process) return RPC_S_INVALID_ARG;
+    *process = NULL;
+    if ((status = I_RpcBindingInqLocalClientPID(binding, &pid))) return status;
+    if (!(*process = OpenProcess(access, FALSE, pid))) return GetLastError();
+    return RPC_S_OK;
+}
