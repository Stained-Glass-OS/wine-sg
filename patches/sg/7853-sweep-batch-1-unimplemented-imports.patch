+/* a key attestation claim (virtualization-based security keys, 7853): none here -- Chrome and its
+ * kin ask for one for their device-bound credentials and carry on without */
+SECURITY_STATUS WINAPI NCryptCreateClaim(NCRYPT_KEY_HANDLE subject, NCRYPT_KEY_HANDLE authority, DWORD type,
+                                         NCryptBufferDesc *params, BYTE *output, DWORD size, DWORD *result, DWORD flags)
+{
+    TRACE("(%#Ix, %#Ix, %#lx, %p, %p, %lu, %p, %#lx)\n", subject, authority, type, params, output, size, result, flags);
+    if (result) *result = 0;
+    return NTE_NOT_SUPPORTED;
+}
