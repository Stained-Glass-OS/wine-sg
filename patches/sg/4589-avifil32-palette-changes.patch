From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] avifil32: Apply palette changes in IAVIStream::ReadFormat.

IAVIStream::ReadFormat of a video stream with palette changes returned the
initial format for every frame: the 'pc' chunks were indexed but never
applied. The colour table now holds the changes recorded before the frame
asked for (a change written after frame n applies from frame n + 1 on),
each AVIPALCHANGE replacing bNumEntries colours from bFirstEntry
(0 entries meaning 256).

Gate: test/avifil32-palchange-gate.sh (64/32; the probe writes the AVI).
---
 dlls/avifil32/avifile.c | 61 +++++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 51 insertions(+), 10 deletions(-)

diff --git a/dlls/avifil32/avifile.c b/dlls/avifil32/avifile.c
index 6eed62a..0c88c45 100644
--- a/dlls/avifil32/avifile.c
+++ b/dlls/avifil32/avifile.c
@@ -841,6 +841,52 @@ static LONG WINAPI IAVIStream_fnFindSample(IAVIStream *iface, LONG pos, LONG fla
   return pos;
 }
 
+static void AVIFILE_ApplyPaletteChanges(IAVIStreamImpl *This, LONG pos, void *format)
+{
+  BITMAPINFOHEADER *bi = format;
+  RGBQUAD *colors;
+  DWORD n, ncolors;
+
+  if (This->cbFormat < sizeof(BITMAPINFOHEADER) || bi->biSize > This->cbFormat)
+    return;
+  ncolors = bi->biClrUsed ? bi->biClrUsed : (bi->biBitCount <= 8 ? 1u << bi->biBitCount : 0);
+  ncolors = min(ncolors, (This->cbFormat - bi->biSize) / sizeof(RGBQUAD));
+  colors = (RGBQUAD *)((BYTE *)bi + bi->biSize);
+
+  for (n = 0; n < This->nIdxFmtChanges; n++) {
+    const AVIINDEXENTRY *entry = &This->idxFmtChanges[n];
+    AVIPALCHANGE *change;
+    DWORD i, first, count;
+
+    if (!entry->dwChunkOffset || entry->dwChunkLength < sizeof(AVIPALCHANGE) - sizeof(PALETTEENTRY))
+      continue;
+#ifdef SG_MUTANT_AVI_PAL_INCLUSIVE
+    if ((LONG)entry->ckid > pos)
+#else
+    if ((LONG)entry->ckid >= pos)
+#endif
+      continue;
+    if (!(change = malloc(entry->dwChunkLength)))
+      return;
+    if (mmioSeek(This->paf->hmmio, entry->dwChunkOffset + 2 * sizeof(DWORD), SEEK_SET) == -1 ||
+        mmioRead(This->paf->hmmio, (HPSTR)change, entry->dwChunkLength) != entry->dwChunkLength) {
+      WARN(": cannot read the palette change at 0x%08lX\n", entry->dwChunkOffset);
+      free(change);
+      continue;
+    }
+    first = change->bFirstEntry;
+    count = change->bNumEntries ? change->bNumEntries : 256;
+    count = min(count, (entry->dwChunkLength - FIELD_OFFSET(AVIPALCHANGE, peNew)) / sizeof(PALETTEENTRY));
+    for (i = 0; i < count && first + i < ncolors; i++) {
+      colors[first + i].rgbRed      = change->peNew[i].peRed;
+      colors[first + i].rgbGreen    = change->peNew[i].peGreen;
+      colors[first + i].rgbBlue     = change->peNew[i].peBlue;
+      colors[first + i].rgbReserved = 0;
+    }
+    free(change);
+  }
+}
+
 static HRESULT WINAPI IAVIStream_fnReadFormat(IAVIStream *iface, LONG pos, void *format,
     LONG *formatsize)
 {
@@ -865,16 +911,11 @@ static HRESULT WINAPI IAVIStream_fnReadFormat(IAVIStream *iface, LONG pos, void
     return AVIERR_BUFFERTOOSMALL;
   }
 
-  /* Could format change? When yes will it change? */
-  if ((This->sInfo.dwFlags & AVISTREAMINFO_FORMATCHANGES) &&
-      pos > This->sInfo.dwStart) {
-    LONG lLastFmt;
-
-    lLastFmt = IAVIStream_fnFindSample(iface, pos, FIND_FORMAT|FIND_PREV);
-    if (lLastFmt > 0) {
-      FIXME(": need to read formatchange for %ld -- unimplemented!\n",lLastFmt);
-    }
-  }
+  /* Palette changes ('pc' chunks) up to pos change the colour table: a change
+   * recorded after frame n applies from frame n + 1 on. */
+  if ((This->sInfo.dwFlags & AVISTREAMINFO_FORMATCHANGES) && pos > (LONG)This->sInfo.dwStart
+      && This->sInfo.fccType == streamtypeVIDEO && This->idxFmtChanges != NULL)
+    AVIFILE_ApplyPaletteChanges(This, pos, format);
 
   *formatsize = This->cbFormat;
   return AVIERR_OK;
