From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msxml3: XMLHTTP and ServerXMLHTTP send any HTTP method (9613)

open() knew GET, PUT, POST, DELETE, HEAD and PROPFIND and failed with E_FAIL
for every other method, so scripts that call REST APIs with PATCH, ask a
server with OPTIONS, or do WebDAV (MKCOL, PROPPATCH, LOCK, MOVE, COPY) could
not. Any method that is an HTTP token now goes out as given (a custom bind
verb, with the request body), the way Windows' XMLHTTP and ServerXMLHTTP send
it; a name that is not a token (with a space) is still refused.
---
--- a/dlls/msxml3/httprequest.c
+++ b/dlls/msxml3/httprequest.c
@@ -872,6 +872,23 @@
     return hr;
 }
 
+/* an HTTP method is a token (RFC 9110: tchar) (wine-sg 9613) */
+static BOOL is_http_token(const WCHAR *method)
+{
+    const WCHAR *p;
+
+#ifdef SG_MUTANT_XMLHTTP_KNOWN_VERBS_ONLY
+    return FALSE;
+#endif
+    if (!*method) return FALSE;
+    for (p = method; *p; p++)
+    {
+        if ((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9')) continue;
+        if (!wcschr(L"!#$%&'*+-.^_`|~", *p)) return FALSE;
+    }
+    return TRUE;
+}
+
 static HRESULT httprequest_open(httprequest *This, BSTR method, BSTR url,
         VARIANT async, VARIANT user, VARIANT password)
 {
@@ -917,6 +934,13 @@
         This->verb = BINDVERB_CUSTOM;
         SysReAllocString(&This->custom, method);
     }
+    else if (is_http_token(method))
+    {
+        /* any other method -- PATCH, OPTIONS, MKCOL, PROPPATCH, LOCK, a server's own -- goes out as
+         * it is given, the way Windows' XMLHTTP and ServerXMLHTTP send it (REST APIs take PATCH) */
+        This->verb = BINDVERB_CUSTOM;
+        SysReAllocString(&This->custom, method);
+    }
     else
     {
         FIXME("unsupported request type %s\n", debugstr_w(method));
