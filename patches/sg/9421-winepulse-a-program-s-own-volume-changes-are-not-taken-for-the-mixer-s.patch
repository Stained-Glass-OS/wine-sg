From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winepulse: A program's own volume changes are not taken for the mixer's (9421)

The sound server answers each volume a program sets on its stream (9416)
with a change notice, and during a fade -- many SetMasterVolume calls in a
row -- the answers to the older steps arrive after newer steps were sent.
They were taken for a mixer's changes: the session jumped back to an older
step, the program was told of changes it had not made, and a fade could
end at 36% instead of 20%. The values sent in the last seconds are kept,
and a notice carrying one of them is the program's own.
---
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -25,6 +25,7 @@
 
 #include <stdarg.h>
 #include <pthread.h>
+#include <time.h>
 #include <math.h>
 #include <poll.h>
 
@@ -94,6 +95,10 @@
     uint32_t sink_input;
     float want_level, pa_level;
     BOOL want_mute, pa_mute;
+    /* wine-sg 9421: what was sent lately; the server's answers to them come back
+     * as changes, after newer ones may have been sent (a fade) */
+    struct { float level; BOOL mute; ULONGLONG time; } sent[64];
+    unsigned int sent_next;
 };
 
 typedef struct _ACPacket
@@ -427,6 +432,37 @@
     return NULL;
 }
 
+static ULONGLONG volume_now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (ULONGLONG)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static void volume_remember(struct pulse_stream *stream)
+{
+    unsigned int i = stream->sent_next++ % ARRAY_SIZE(stream->sent);
+    stream->sent[i].level = stream->pa_level;
+    stream->sent[i].mute = stream->pa_mute;
+    stream->sent[i].time = volume_now_ms();
+}
+
+/* a change the server reports that is one of ours, sent in the last 3 seconds */
+static BOOL volume_was_sent(struct pulse_stream *stream, float level, BOOL mute)
+{
+    ULONGLONG now = volume_now_ms();
+    unsigned int i;
+
+#ifdef SG_MUTANT_PULSE_ECHO_IS_EXTERNAL
+    return FALSE;
+#endif
+    for (i = 0; i < ARRAY_SIZE(stream->sent); i++)
+        if (stream->sent[i].time && now - stream->sent[i].time < 3000
+                && fabsf(stream->sent[i].level - level) < 0.002f && !stream->sent[i].mute == !mute)
+            return TRUE;
+    return FALSE;
+}
+
 /* the session's volume and mute to the sound server's stream */
 static void volume_push(struct pulse_stream *stream)
 {
@@ -448,6 +484,7 @@
             pa_operation_unref(o);
         stream->pa_mute = stream->want_mute;
     }
+    volume_remember(stream);
 }
 
 static void pulse_sink_input_info_cb(pa_context *c, const pa_sink_input_info *info, int eol, void *user)
@@ -486,6 +523,8 @@
 
     if (fabsf(level - stream->pa_level) < 0.002f && !info->mute == !stream->pa_mute)
         return;   /* ours, coming back */
+    if (volume_was_sent(stream, level, info->mute))
+        return;   /* an older one of ours: newer ones are on their way */
     TRACE("stream %p: the mixer set volume %.3f mute %d\n", stream, level, info->mute);
     stream->pa_level = stream->want_level = level;
     stream->pa_mute = stream->want_mute = !!info->mute;
