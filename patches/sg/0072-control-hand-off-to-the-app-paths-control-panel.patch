From: Stained Glass OS <dev@stained-glass.example>
Subject: control: hand off to the Control Panel App Paths names

sg-shell registers its Control Panel in App Paths for control.exe, which
ShellExecute and the Run box follow. A program that runs control.exe itself
with CreateProcess -- installers, scripts, support tools -- still got Wine's
bare Control Panel. Now control.exe, when App Paths names another existing
program, starts that one with the same arguments and exits. It sets
SG_CONTROL_HANDOFF for it, and does not hand off when that is set, so the
other Control Panel can run control.exe back (for Wine's own applets)
without a loop.

Gate: test/control-gate.sh.
---
--- a/programs/control/Makefile.in
+++ b/programs/control/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = control.exe
-IMPORTS   = shell32 user32 comctl32
+IMPORTS   = shell32 user32 comctl32 advapi32
 
 EXTRADLLFLAGS = -mwindows -municode
 
--- a/programs/control/control.c
+++ b/programs/control/control.c
@@ -36,8 +36,43 @@
   ExitProcess(0);
 }
 
+/* Stained Glass OS: when App Paths names another Control Panel for
+ * control.exe (sg-shell's), a program that runs control.exe itself -- not
+ * through ShellExecute, which already follows App Paths -- gets that one too,
+ * with its arguments. SG_CONTROL_HANDOFF marks the hand-off, so the other
+ * Control Panel may run this one back without a loop. */
+static void hand_off(LPCWSTR args)
+{
+    WCHAR target[MAX_PATH], self[MAX_PATH], *cmd;
+    DWORD size = sizeof(target);
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    size_t len;
+
+    if (GetEnvironmentVariableW(L"SG_CONTROL_HANDOFF", NULL, 0)) return;
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\control.exe",
+                     NULL, RRF_RT_REG_SZ, NULL, target, &size)) return;
+    if (GetFileAttributesW(target) == INVALID_FILE_ATTRIBUTES) return;
+    GetModuleFileNameW(NULL, self, MAX_PATH);
+    if (!lstrcmpiW(target, self)) return;
+
+    len = lstrlenW(target) + lstrlenW(args) + 4;
+    if (!(cmd = malloc(len * sizeof(WCHAR)))) return;
+    swprintf(cmd, len, L"\"%s\" %s", target, args);
+    SetEnvironmentVariableW(L"SG_CONTROL_HANDOFF", L"1");
+    if (CreateProcessW(target, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi))
+    {
+        CloseHandle(pi.hThread);
+        CloseHandle(pi.hProcess);
+        ExitProcess(0);
+    }
+    SetEnvironmentVariableW(L"SG_CONTROL_HANDOFF", NULL);
+    free(cmd);
+}
+
 int WINAPI wWinMain(HINSTANCE hInst, HINSTANCE hPrev, LPWSTR lpszCmdLine, INT nCmdShow)
 {
+    hand_off(lpszCmdLine);
     InitCommonControls();
 
     /* no parameters - pop up whole "Control Panel" by default */
