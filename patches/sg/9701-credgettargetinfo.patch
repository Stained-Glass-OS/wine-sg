From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32, sechost: CredGetTargetInfoA/W

Anki's pywin32 win32cred imports CredGetTargetInfoW and did not load (the export was missing). As
Windows' credential manager does, the target information CredReadDomainCredentials is asked to cache
(CRED_CACHE_TARGET_INFORMATION) is kept for the logon session (a volatile key of the user's) and
CredGetTargetInfo gives it back by target or server name; else ERROR_NOT_FOUND.
Gate: test/credtarget-gate.sh. Mutant: SG_MUTANT_NO_TARGET_INFO.
---
--- a/dlls/advapi32/cred.c
+++ b/dlls/advapi32/cred.c
@@ -1947,6 +1947,7 @@
 #define CRED_CACHE_TARGET_INFORMATION 0x1
 #endif
 
+static void cache_target_info( const CREDENTIAL_TARGET_INFORMATIONW *ti );
 /* defined after CredFindBestCredentialW */
 static DWORD cred_block_size(const CREDENTIALW *cred);
 static char *cred_block_copy(const CREDENTIALW *cred, char *dst);
@@ -1978,6 +1979,7 @@
         SetLastError(ERROR_INVALID_FLAGS);
         return FALSE;
     }
+    if (Flags & CRED_CACHE_TARGET_INFORMATION) cache_target_info( TargetInformation );
 
     /* the names the credentials are looked up by, the most specific first; the types are those the target
      * information lists, else the domain types */
@@ -2053,6 +2055,197 @@
     return TRUE;
 }
 
+/* Stained Glass OS (wine-sg 9701): the target information CredReadDomainCredentials caches when asked to
+ * (CRED_CACHE_TARGET_INFORMATION) for CredGetTargetInfo to give back, as Windows' credential manager keeps
+ * it for the logon session: a volatile key of the user's (gone when the session's registry goes), one
+ * REG_BINARY value per name the target is known by (its target name and its server names). */
+static const WCHAR target_info_key[] = L"Software\\Wine\\Credential Target Information";
+
+static DWORD target_info_field_size( const WCHAR *s )
+{
+    return sizeof(DWORD) + (s ? wcslen( s ) * sizeof(WCHAR) : 0);
+}
+
+static void cache_target_info( const CREDENTIAL_TARGET_INFORMATIONW *ti )
+{
+    const WCHAR *fields[7] = { ti->TargetName, ti->NetbiosServerName, ti->DnsServerName, ti->NetbiosDomainName,
+                               ti->DnsDomainName, ti->DnsTreeName, ti->PackageName };
+    const WCHAR *names[3] = { ti->TargetName, ti->DnsServerName, ti->NetbiosServerName };
+    DWORD size = 3 * sizeof(DWORD), i, types = ti->CredTypes ? ti->CredTypeCount : 0;
+    BYTE *blob, *p;
+    HKEY key;
+
+    for (i = 0; i < 7; i++) size += target_info_field_size( fields[i] );
+    size += types * sizeof(DWORD);
+    if (!(blob = malloc( size ))) return;
+    p = blob;
+    memcpy( p, &ti->Flags, sizeof(DWORD) ); p += sizeof(DWORD);
+    memcpy( p, &types, sizeof(DWORD) ); p += sizeof(DWORD);
+    if (types) memcpy( p, ti->CredTypes, types * sizeof(DWORD) );
+    p += types * sizeof(DWORD);
+    i = 7; memcpy( p, &i, sizeof(DWORD) ); p += sizeof(DWORD);
+    for (i = 0; i < 7; i++)
+    {
+        DWORD len = fields[i] ? wcslen( fields[i] ) : ~0u;
+        memcpy( p, &len, sizeof(DWORD) ); p += sizeof(DWORD);
+        if (fields[i]) { memcpy( p, fields[i], len * sizeof(WCHAR) ); p += len * sizeof(WCHAR); }
+    }
+    if (!RegCreateKeyExW( HKEY_CURRENT_USER, target_info_key, 0, NULL, REG_OPTION_VOLATILE,
+                          KEY_SET_VALUE, NULL, &key, NULL ))
+    {
+        for (i = 0; i < 3; i++)
+            if (names[i] && names[i][0]) RegSetValueExW( key, names[i], 0, REG_BINARY, blob, size );
+        RegCloseKey( key );
+    }
+    free( blob );
+}
+
+/* the cached target information known by this name, as one block for CredFree */
+static CREDENTIAL_TARGET_INFORMATIONW *read_target_info( const WCHAR *name )
+{
+    CREDENTIAL_TARGET_INFORMATIONW *ti = NULL;
+    DWORD size = 0, type, types, nfields, total, i;
+    BYTE *blob, *p, *end;
+    WCHAR *s;
+    WCHAR **fields;
+    HKEY key;
+
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, target_info_key, 0, KEY_QUERY_VALUE, &key )) return NULL;
+    if (RegQueryValueExW( key, name, NULL, &type, NULL, &size ) || type != REG_BINARY || size < 3 * sizeof(DWORD) ||
+        !(blob = malloc( size )))
+    {
+        RegCloseKey( key );
+        return NULL;
+    }
+    if (RegQueryValueExW( key, name, NULL, NULL, blob, &size )) goto done;
+    end = blob + size;
+    memcpy( &types, blob + sizeof(DWORD), sizeof(DWORD) );
+    p = blob + 2 * sizeof(DWORD);
+    if (types > (end - p) / sizeof(DWORD)) goto done;
+    p += types * sizeof(DWORD);
+    if (end - p < sizeof(DWORD)) goto done;
+    memcpy( &nfields, p, sizeof(DWORD) );
+    if (nfields != 7) goto done;
+    /* the strings come back NUL-terminated after the structure and the types */
+    total = sizeof(*ti) + types * sizeof(DWORD) + 7 * sizeof(WCHAR) + (size - 3 * sizeof(DWORD) - types * sizeof(DWORD));
+    if (!(ti = malloc( total ))) goto done;
+    memcpy( &ti->Flags, blob, sizeof(DWORD) );
+    ti->CredTypeCount = types;
+    ti->CredTypes = types ? (DWORD *)(ti + 1) : NULL;
+    if (types) memcpy( ti->CredTypes, blob + 2 * sizeof(DWORD), types * sizeof(DWORD) );
+    s = (WCHAR *)((DWORD *)(ti + 1) + types);
+    fields = &ti->TargetName;   /* the seven string fields come first, in order */
+    p += sizeof(DWORD);
+    for (i = 0; i < 7; i++)
+    {
+        DWORD len;
+        if (end - p < sizeof(DWORD)) { free( ti ); ti = NULL; goto done; }
+        memcpy( &len, p, sizeof(DWORD) ); p += sizeof(DWORD);
+        if (len == ~0u) { fields[i] = NULL; continue; }
+        if (len > (end - p) / sizeof(WCHAR)) { free( ti ); ti = NULL; goto done; }
+        fields[i] = s;
+        memcpy( s, p, len * sizeof(WCHAR) );
+        s[len] = 0;
+        s += len + 1;
+        p += len * sizeof(WCHAR);
+    }
+done:
+    free( blob );
+    RegCloseKey( key );
+    return ti;
+}
+
+/******************************************************************************
+ * CredGetTargetInfoW [ADVAPI32.@]
+ *
+ * The target information known for a target name: what CredReadDomainCredentials cached with
+ * CRED_CACHE_TARGET_INFORMATION (authentication packages cache it on Windows too). Without it,
+ * ERROR_NOT_FOUND ("target info for the named server is not available").
+ */
+BOOL WINAPI CredGetTargetInfoW( LPCWSTR TargetName, DWORD Flags, PCREDENTIAL_TARGET_INFORMATIONW *TargetInfo )
+{
+    CREDENTIAL_TARGET_INFORMATIONW *ti;
+
+    TRACE( "(%s, 0x%lx, %p)\n", debugstr_w(TargetName), Flags, TargetInfo );
+
+    if (!TargetName || !TargetName[0] || !TargetInfo)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *TargetInfo = NULL;
+    if (Flags & ~CRED_ALLOW_NAME_RESOLUTION)
+    {
+        SetLastError( ERROR_INVALID_FLAGS );
+        return FALSE;
+    }
+#ifndef SG_MUTANT_NO_TARGET_INFO
+    if (!(ti = read_target_info( TargetName )))
+#else
+    if (!(ti = NULL))
+#endif
+    {
+        SetLastError( ERROR_NOT_FOUND );
+        return FALSE;
+    }
+    *TargetInfo = ti;
+    return TRUE;
+}
+
+/******************************************************************************
+ * CredGetTargetInfoA [ADVAPI32.@]
+ */
+BOOL WINAPI CredGetTargetInfoA( LPCSTR TargetName, DWORD Flags, PCREDENTIAL_TARGET_INFORMATIONA *TargetInfo )
+{
+    CREDENTIAL_TARGET_INFORMATIONW *tiW;
+    CREDENTIAL_TARGET_INFORMATIONA *ti;
+    WCHAR *nameW = NULL, **fieldsW;
+    char **fields, *s;
+    DWORD len, i, total;
+    BOOL ret;
+
+    if (TargetName)
+    {
+        len = MultiByteToWideChar( CP_ACP, 0, TargetName, -1, NULL, 0 );
+        if (!(nameW = malloc( len * sizeof(WCHAR) )))
+        {
+            SetLastError( ERROR_OUTOFMEMORY );
+            return FALSE;
+        }
+        MultiByteToWideChar( CP_ACP, 0, TargetName, -1, nameW, len );
+    }
+    ret = CredGetTargetInfoW( nameW, Flags, TargetInfo ? &tiW : NULL );
+    free( nameW );
+    if (TargetInfo) *TargetInfo = NULL;
+    if (!ret) return FALSE;
+
+    fieldsW = &tiW->TargetName;
+    total = sizeof(*ti) + tiW->CredTypeCount * sizeof(DWORD);
+    for (i = 0; i < 7; i++)
+        if (fieldsW[i]) total += WideCharToMultiByte( CP_ACP, 0, fieldsW[i], -1, NULL, 0, NULL, NULL );
+    if (!(ti = malloc( total )))
+    {
+        CredFree( tiW );
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    ti->Flags = tiW->Flags;
+    ti->CredTypeCount = tiW->CredTypeCount;
+    ti->CredTypes = tiW->CredTypes ? (DWORD *)(ti + 1) : NULL;
+    if (ti->CredTypes) memcpy( ti->CredTypes, tiW->CredTypes, tiW->CredTypeCount * sizeof(DWORD) );
+    s = (char *)((DWORD *)(ti + 1) + tiW->CredTypeCount);
+    fields = &ti->TargetName;
+    for (i = 0; i < 7; i++)
+    {
+        if (!fieldsW[i]) { fields[i] = NULL; continue; }
+        fields[i] = s;
+        s += WideCharToMultiByte( CP_ACP, 0, fieldsW[i], -1, s, (char *)ti + total - s, NULL, NULL );
+    }
+    CredFree( tiW );
+    *TargetInfo = ti;
+    return TRUE;
+}
+
 /******************************************************************************
  * CredWriteA [ADVAPI32.@]
  */
--- a/dlls/advapi32/advapi32.spec
+++ b/dlls/advapi32/advapi32.spec
@@ -157,8 +157,8 @@
 @ stdcall CredFindBestCredentialW(wstr long long ptr)
 @ stdcall CredFree(ptr)
 @ stdcall CredGetSessionTypes(long ptr)
-# @ stub CredGetTargetInfoA
-# @ stub CredGetTargetInfoW
+@ stdcall CredGetTargetInfoA(str long ptr)
+@ stdcall CredGetTargetInfoW(wstr long ptr)
 @ stdcall CredIsMarshaledCredentialA(str)
 @ stdcall CredIsMarshaledCredentialW(wstr)
 @ stdcall CredIsProtectedA(ptr ptr)
--- a/dlls/sechost/sechost.spec
+++ b/dlls/sechost/sechost.spec
@@ -51,8 +51,8 @@
 @ stdcall CredFindBestCredentialW(wstr long long ptr) advapi32.CredFindBestCredentialW
 @ stdcall CredFree(ptr) advapi32.CredFree
 @ stdcall CredGetSessionTypes(long ptr) advapi32.CredGetSessionTypes
-@ stub CredGetTargetInfoA
-@ stub CredGetTargetInfoW
+@ stdcall CredGetTargetInfoA(str long ptr) advapi32.CredGetTargetInfoA
+@ stdcall CredGetTargetInfoW(wstr long ptr) advapi32.CredGetTargetInfoW
 @ stdcall CredIsMarshaledCredentialW(wstr) advapi32.CredIsMarshaledCredentialW
 @ stdcall CredIsProtectedA(ptr ptr) advapi32.CredIsProtectedA
 @ stdcall CredIsProtectedW(ptr ptr) advapi32.CredIsProtectedW
--- a/include/wincred.h
+++ b/include/wincred.h
@@ -230,6 +230,12 @@
 #define CRED_TI_DOMAIN_FORMAT_UNKNOWN               2
 #define CRED_TI_ONLY_PASSWORD_REQUIRED              4
 
+/* CredGetTargetInfo flags */
+#define CRED_ALLOW_NAME_RESOLUTION                  1
+
+/* CredReadDomainCredentials flags */
+#define CRED_CACHE_TARGET_INFORMATION               1
+
 #define CREDUI_FLAGS_INCORRECT_PASSWORD             0x00000001
 #define CREDUI_FLAGS_DO_NOT_PERSIST                 0x00000002
 #define CREDUI_FLAGS_REQUEST_ADMINISTRATOR          0x00000004
@@ -304,6 +310,9 @@
 WINADVAPI BOOL  WINAPI CredWriteDomainCredentialsW(PCREDENTIAL_TARGET_INFORMATIONW,PCREDENTIALW,DWORD);
 #define                CredWriteDomainCredentials WINELIB_NAME_AW(CredWriteDomainCredentials)
 WINADVAPI BOOL  WINAPI CredGetSessionTypes(DWORD,LPDWORD);
+WINADVAPI BOOL  WINAPI CredGetTargetInfoA(LPCSTR,DWORD,PCREDENTIAL_TARGET_INFORMATIONA *);
+WINADVAPI BOOL  WINAPI CredGetTargetInfoW(LPCWSTR,DWORD,PCREDENTIAL_TARGET_INFORMATIONW *);
+#define                CredGetTargetInfo WINELIB_NAME_AW(CredGetTargetInfo)
 WINADVAPI BOOL  WINAPI CredIsMarshaledCredentialA(LPCSTR);
 WINADVAPI BOOL  WINAPI CredIsMarshaledCredentialW(LPCWSTR);
 #define                CredIsMarshaledCredential WINELIB_NAME_AW(CredIsMarshaledCredential)
