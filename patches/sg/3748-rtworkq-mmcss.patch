-HRESULT WINAPI RtwqBeginRegisterWorkQueueWithMMCSS(DWORD queue, const WCHAR *class, DWORD taskid, LONG priority,
+static const IUnknownVtbl mmcss_op_vtbl = { mmcss_op_QueryInterface, mmcss_op_AddRef, mmcss_op_Release };
+
+static HRESULT mmcss_begin(struct queue *queue_or_null, DWORD queue_id, const WCHAR *class, DWORD taskid, LONG priority,
+        BOOL unregister, IRtwqAsyncCallback *callback, IUnknown *state)
+{
+    struct mmcss_op *op;
+    IRtwqAsyncResult *result;
+    HRESULT hr;
+
+    if (!callback) return E_INVALIDARG;
+    if (!(op = calloc(1, sizeof(*op)))) return E_OUTOFMEMORY;
+    op->IUnknown_iface.lpVtbl = &mmcss_op_vtbl;
+    op->refcount = 1;
+    op->unregister = unregister;
+
+    EnterCriticalSection(&queues_section);
+    if (!unregister)
+    {
+        /* task id 0 asks for a new task */
+        op->taskid = taskid ? taskid : InterlockedIncrement(&next_mmcss_taskid);
+        wcscpy(queue_or_null->mmcss_class, class);
+        queue_or_null->mmcss_taskid = op->taskid;
+        queue_or_null->mmcss_priority = priority;
+    }
+    else
+    {
+        queue_or_null->mmcss_class[0] = 0;
+        queue_or_null->mmcss_taskid = 0;
+        queue_or_null->mmcss_priority = 0;
+    }
+    LeaveCriticalSection(&queues_section);
+
+    hr = RtwqCreateAsyncResult(&op->IUnknown_iface, callback, state, &result);
+    IUnknown_Release(&op->IUnknown_iface);
+    if (FAILED(hr)) return hr;
+    hr = RtwqInvokeCallback(result);
+    IRtwqAsyncResult_Release(result);
+    return hr;
+}
+
+static HRESULT mmcss_end(IRtwqAsyncResult *result, BOOL unregister, DWORD *taskid)
+{
+    IUnknown *object;
+    struct mmcss_op *op;
+    HRESULT hr;
+
+    if (!result) return E_INVALIDARG;
+    if (FAILED(hr = IRtwqAsyncResult_GetObject(result, &object))) return hr;
+    if (!object || object->lpVtbl != &mmcss_op_vtbl)
+    {
+        if (object) IUnknown_Release(object);
+        return E_INVALIDARG;
+    }
+    op = CONTAINING_RECORD(object, struct mmcss_op, IUnknown_iface);
+    if (op->unregister != unregister) hr = E_INVALIDARG;
+    else if (taskid) *taskid = op->taskid;
+    IUnknown_Release(object);
+    return hr;
+}
+
+HRESULT WINAPI RtwqBeginRegisterWorkQueueWithMMCSS(DWORD queue_id, const WCHAR *class, DWORD taskid, LONG priority,
         IRtwqAsyncCallback *callback, IUnknown *state)
 {
-    FIXME("%#lx, %s, %lu, %ld, %p, %p.\n", queue, debugstr_w(class), taskid, priority, callback, state);
+    struct queue *queue;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%#lx, %s, %lu, %ld, %p, %p.\n", queue_id, debugstr_w(class), taskid, priority, callback, state);
+
+    if (!class || !*class || wcslen(class) >= ARRAY_SIZE(queue->mmcss_class)) return E_INVALIDARG;
+    if (FAILED(hr = grab_queue(queue_id, &queue))) return hr;
+    return mmcss_begin(queue, queue_id, class, taskid, priority, FALSE, callback, state);
 }
 
 HRESULT WINAPI RtwqEndRegisterWorkQueueWithMMCSS(IRtwqAsyncResult *result, DWORD *taskid)
 {
-    FIXME("%p, %p.\n", result, taskid);
+    TRACE("%p, %p.\n", result, taskid);
 
-    return E_NOTIMPL;
+    if (!taskid) return E_POINTER;
+    return mmcss_end(result, FALSE, taskid);
 }
 
-HRESULT WINAPI RtwqBeginUnregisterWorkQueueWithMMCSS(DWORD queue, IRtwqAsyncCallback *callback, IUnknown *state)
+HRESULT WINAPI RtwqBeginUnregisterWorkQueueWithMMCSS(DWORD queue_id, IRtwqAsyncCallback *callback, IUnknown *state)
 {
-    FIXME("%#lx, %p, %p.\n", queue, callback, state);
+    struct queue *queue;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%#lx, %p, %p.\n", queue_id, callback, state);
+
+    if (FAILED(hr = grab_queue(queue_id, &queue))) return hr;
+    return mmcss_begin(queue, queue_id, NULL, 0, 0, TRUE, callback, state);
 }
 
 HRESULT WINAPI RtwqEndUnregisterWorkQueueWithMMCSS(IRtwqAsyncResult *result)
 {
-    FIXME("%p.\n", result);
+    TRACE("%p.\n", result);
 
-    return E_NOTIMPL;
+    return mmcss_end(result, TRUE, NULL);
+}
+
+/* the platform queues of MFRegisterPlatformWithMMCSS: the system queues that run work */
+static const unsigned int platform_queues[] = { SYS_QUEUE_STANDARD, SYS_QUEUE_RT, SYS_QUEUE_IO, SYS_QUEUE_TIMER,
+                                                SYS_QUEUE_MULTITHREADED };
+
+HRESULT WINAPI RtwqRegisterPlatformWithMMCSS(const WCHAR *class, DWORD *taskid, LONG priority)
+{
+    unsigned int i;
+
+    TRACE("%s, %p, %ld.\n", debugstr_w(class), taskid, priority);
+
+    if (!class || !*class || wcslen(class) >= ARRAY_SIZE(system_queues[0].mmcss_class) || !taskid) return E_INVALIDARG;
+    if (!system_queues[SYS_QUEUE_STANDARD].pool) return RTWQ_E_SHUTDOWN;
+    EnterCriticalSection(&queues_section);
+    if (!*taskid) *taskid = InterlockedIncrement(&next_mmcss_taskid);
+    for (i = 0; i < ARRAY_SIZE(platform_queues); i++)
+    {
+        struct queue *queue = &system_queues[platform_queues[i]];
+        wcscpy(queue->mmcss_class, class);
+        queue->mmcss_taskid = *taskid;
+        queue->mmcss_priority = priority;
+    }
+    LeaveCriticalSection(&queues_section);
+    return S_OK;
+}
+
+HRESULT WINAPI RtwqUnregisterPlatformFromMMCSS(void)
+{
+    unsigned int i;
+
+    TRACE("\n");
+
+    EnterCriticalSection(&queues_section);
+    for (i = 0; i < ARRAY_SIZE(platform_queues); i++)
+    {
+        struct queue *queue = &system_queues[platform_queues[i]];
+        queue->mmcss_class[0] = 0;
+        queue->mmcss_taskid = 0;
+        queue->mmcss_priority = 0;
+    }
+    LeaveCriticalSection(&queues_section);
+    return S_OK;
 }
 
 HRESULT WINAPI RtwqRegisterPlatformEvents(IRtwqPlatformEvents *events)
