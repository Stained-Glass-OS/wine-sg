From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rtworkq: the MMCSS association of work queues (3748)

rtworkq: the MMCSS association of work queues

A work queue remembers the class, task id and priority it was registered
with (RtwqBegin/EndRegisterWorkQueueWithMMCSS and the unregister pair,
RtwqRegisterPlatformWithMMCSS) and RtwqGetWorkQueueMMCSS* report them.
---
diff --git a/dlls/rtworkq/queue.c b/dlls/rtworkq/queue.c
index 1c8f8d7..848f269 100644
--- a/dlls/rtworkq/queue.c
+++ b/dlls/rtworkq/queue.c
@@ -187,6 +187,10 @@ struct queue
     /* Data used for serial queues only. */
     PTP_SIMPLE_CALLBACK finalization_callback;
     DWORD target_queue;
+    /* The Multimedia Class Scheduler task the queue was associated with (bookkeeping: no scheduling follows) */
+    WCHAR mmcss_class[64];
+    DWORD mmcss_taskid;
+    LONG mmcss_priority;
 };
 
 static void shutdown_queue(struct queue *queue);
@@ -1631,68 +1635,244 @@ HRESULT WINAPI RtwqUnjoinWorkQueue(DWORD queue, HANDLE cookie)
     return E_NOTIMPL;
 }
 
-HRESULT WINAPI RtwqGetWorkQueueMMCSSClass(DWORD queue, WCHAR *class, DWORD *length)
+/* Stained Glass OS: the MMCSS association of a work queue.  A queue remembers the class, the task id and the
+ * priority it was registered with and reports them (the Media Foundation documentation of
+ * MFBeginRegisterWorkQueueWithMMCSS and MFGetWorkQueueMMCSS*); the threads are not scheduled differently. */
+static LONG next_mmcss_taskid;
+
+HRESULT WINAPI RtwqGetWorkQueueMMCSSClass(DWORD queue_id, WCHAR *class, DWORD *length)
 {
-    FIXME("%#lx, %p, %p.\n", queue, class, length);
+    struct queue *queue;
+    DWORD needed;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%#lx, %p, %p.\n", queue_id, class, length);
+
+    if (!length) return E_POINTER;
+    if (FAILED(hr = grab_queue(queue_id, &queue))) return hr;
+    EnterCriticalSection(&queues_section);
+    needed = wcslen(queue->mmcss_class);
+    if (!needed)
+        *length = 0;   /* no association: no class */
+    else if (!class || *length < needed + 1)
+    {
+        *length = needed + 1;
+        hr = HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    }
+    else
+    {
+        wcscpy(class, queue->mmcss_class);
+        *length = needed;
+    }
+    LeaveCriticalSection(&queues_section);
+    return hr;
 }
 
-HRESULT WINAPI RtwqGetWorkQueueMMCSSTaskId(DWORD queue, DWORD *taskid)
+HRESULT WINAPI RtwqGetWorkQueueMMCSSTaskId(DWORD queue_id, DWORD *taskid)
 {
-    FIXME("%#lx, %p.\n", queue, taskid);
+    struct queue *queue;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%#lx, %p.\n", queue_id, taskid);
+
+    if (!taskid) return E_POINTER;
+    if (FAILED(hr = grab_queue(queue_id, &queue))) return hr;
+    EnterCriticalSection(&queues_section);
+    *taskid = queue->mmcss_taskid;
+    LeaveCriticalSection(&queues_section);
+    return S_OK;
 }
 
-HRESULT WINAPI RtwqGetWorkQueueMMCSSPriority(DWORD queue, LONG *priority)
+HRESULT WINAPI RtwqGetWorkQueueMMCSSPriority(DWORD queue_id, LONG *priority)
 {
-    FIXME("%#lx, %p.\n", queue, priority);
+    struct queue *queue;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%#lx, %p.\n", queue_id, priority);
+
+    if (!priority) return E_POINTER;
+    if (FAILED(hr = grab_queue(queue_id, &queue))) return hr;
+    EnterCriticalSection(&queues_section);
+    *priority = queue->mmcss_priority;   /* AVRT_PRIORITY_NORMAL (0) until registered */
+    LeaveCriticalSection(&queues_section);
+    return S_OK;
 }
 
-HRESULT WINAPI RtwqRegisterPlatformWithMMCSS(const WCHAR *class, DWORD *taskid, LONG priority)
+/* the object an asynchronous MMCSS operation carries, so that the End call can tell its own results */
+struct mmcss_op
 {
-    FIXME("%s, %p, %ld.\n", debugstr_w(class), taskid, priority);
+    IUnknown IUnknown_iface;
+    LONG refcount;
