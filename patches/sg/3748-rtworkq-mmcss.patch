-HRESULT WINAPI RtwqUnregisterPlatformFromMMCSS(void)
+static ULONG WINAPI mmcss_op_AddRef(IUnknown *iface)
 {
-    FIXME("\n");
+    struct mmcss_op *op = CONTAINING_RECORD(iface, struct mmcss_op, IUnknown_iface);
+    return InterlockedIncrement(&op->refcount);
+}
 
-    return E_NOTIMPL;
+static ULONG WINAPI mmcss_op_Release(IUnknown *iface)
+{
+    struct mmcss_op *op = CONTAINING_RECORD(iface, struct mmcss_op, IUnknown_iface);
+    ULONG refcount = InterlockedDecrement(&op->refcount);
+    if (!refcount) free(op);
+    return refcount;
