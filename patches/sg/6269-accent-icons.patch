     }
-    hIcon = create_icon_from_bmi( (const BITMAPINFO *)bits, size, hInstance, name, hRsrc,
-                                  hotspot, !fCursor, width, height, loadflags );
+    hIcon = create_icon_from_bmi_tint( (const BITMAPINFO *)bits, size, hInstance, name, hRsrc,
+                                       hotspot, !fCursor, width, height, loadflags,
+                                       !fCursor && sg_module_is_ours( hInstance ), reuse );
     FreeResource( handle );
     if (hIcon && oem && fCursor && IS_INTRESOURCE(name)) apply_system_cursor( hIcon, LOWORD(name), loadflags & LR_SHARED );
     return hIcon;
@@ -1619,7 +1842,6 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetClipCursor( RECT *rect )
  * SG_CURSORICON_REPLACE), so its windows show the new image; processes that are running
