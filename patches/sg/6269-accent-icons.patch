From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32, shell32, explorer: the icons we draw follow the accent colour; File Explorer's own icon

Every icon we draw follows the accent colour Personalization sets: user32 re-hues the key-coloured parts of our own modules' icons as it makes them, shell32 makes its image list entries of ours again on a new accent, and the desktop, File Explorer and the taskbar take the new icons; programs' own icons never change. explorer.exe carries File Explorer's icon, so its windows' taskbar buttons show it.
---
diff --git a/dlls/shell32/iconcache.c b/dlls/shell32/iconcache.c
index 1e63e08..b2f04ab 100644
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -715,11 +715,92 @@ static INT CALLBACK sic_free( LPVOID ptr, LPVOID lparam );
  * Explorer's and the desktop's icons stayed the old scale's, small at 175%.
  * The old lists are kept (a view made before may still draw from them);
  * the cache starts again. */
+/* Stained Glass OS: the icons we draw follow the accent (wine-sg 6269). user32
+ * re-hues the icons of our own modules as it makes them; the image lists keep
+ * the ones made before, so on a new accent the entries that come from one of
+ * our modules are made again, in place: their indexes stay, a view that holds
+ * the lists draws the new ones once it repaints. */
+static COLORREF sic_accent;
+static BOOL sic_accent_known;
+
+static COLORREF sic_read_accent(void)
+{
+    DWORD value, size = sizeof(value);
+
+    if (!RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\DWM", L"AccentColor",
+                       RRF_RT_REG_DWORD, NULL, &value, &size ))
+        return value & 0xffffff;
+    return RGB(0x8a, 0x2b, 0xe2);
+}
+
+/* a Wine builtin carries this after its DOS header */
+static BOOL sic_file_is_ours( const WCHAR *file )
+{
+    static const char signature[] = "Wine builtin DLL";
+    char header[sizeof(IMAGE_DOS_HEADER) + sizeof(signature)];
+    HANDLE handle;
+    DWORD read = 0;
+
+    handle = CreateFileW( file, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                          OPEN_EXISTING, 0, NULL );
+    if (handle == INVALID_HANDLE_VALUE) return FALSE;
+    ReadFile( handle, header, sizeof(header), &read, NULL );
+    CloseHandle( handle );
+    return read == sizeof(header) && header[0] == 'M' && header[1] == 'Z' &&
+           !memcmp( header + sizeof(IMAGE_DOS_HEADER), signature, sizeof(signature) );
+}
+
+static INT CALLBACK sic_retint( void *ptr, void *param )
+{
+    SIC_ENTRY *entry = ptr;
+    HICON hicons[ARRAY_SIZE(shell_imagelists)] = { 0 }, overlaid;
+    unsigned int i;
+    SIZE size;
+
+    if (!sic_file_is_ours( entry->sSourceFile )) return TRUE;
+    for (i = 0; i < ARRAY_SIZE(hicons); i++)
+    {
+        if (!shell_imagelists[i] || !get_imagelist_icon_size( i, &size ) ||
+            !PrivateExtractIconsW( entry->sSourceFile, entry->dwSourceIndex, size.cx, size.cy, &hicons[i], 0, 1, 0 ) ||
+            !hicons[i])
+            continue;
+        if ((entry->dwFlags & GIL_FORSHORTCUT) && (overlaid = SIC_OverlayShortcutImage( hicons[i], i )))
+        {
+            DestroyIcon( hicons[i] );
+            hicons[i] = overlaid;
+        }
+        ImageList_ReplaceIcon( shell_imagelists[i], entry->dwListIndex, hicons[i] );
+        DestroyIcon( hicons[i] );
+    }
+    return TRUE;
+}
+
+static void sic_follow_accent(void)
+{
+    COLORREF accent = sic_read_accent();
+
+#ifdef SG_MUTANT_SHELL_ICONS_KEEP_ACCENT
+    return;
+#endif
+    if (sic_accent_known && accent == sic_accent) return;
+    EnterCriticalSection( &SHELL32_SicCS );
+    if (!sic_accent_known) sic_accent_known = TRUE;
+    else if (accent != sic_accent && sic_hdpa)
+    {
+        TRACE( "accent %06lx: our icons again\n", accent );
+        sic_accent = accent;
+        DPA_EnumCallback( sic_hdpa, sic_retint, NULL );
+    }
+    sic_accent = accent;
+    LeaveCriticalSection( &SHELL32_SicCS );
+}
+
 static void sic_init(void)
 {
     UINT dpi;
 
     InitOnceExecuteOnce( &sic_init_once, SIC_Initialize, NULL, NULL );
+    sic_follow_accent();
 #ifndef SG_MUTANT_SHELL_ICONS_FIXED
     if (!sic_dpi || !IsProcessDPIAware() || (dpi = GetDpiForSystem()) == sic_dpi) return;
     EnterCriticalSection( &SHELL32_SicCS );
diff --git a/dlls/user32/cursoricon.c b/dlls/user32/cursoricon.c
index 9693d3c..0a73cdd 100644
--- a/dlls/user32/cursoricon.c
+++ b/dlls/user32/cursoricon.c
@@ -26,6 +26,7 @@
 
 #include <png.h>
 #include <stdlib.h>
+#include <math.h>
 
 #include "user_private.h"
 #include "controls.h"
@@ -974,11 +975,221 @@ static HICON create_cursoricon_object( struct cursoricon_desc *desc, BOOL is_ico
     return handle;
 }
 
+/***********************************************************************
+ * Stained Glass OS: the icons we draw follow the accent colour (wine-sg 6269)
+ *
+ * Our own icons (wine-sg theme/icons.py) draw the parts that follow the accent
+ * in one hue, the default accent's (BlueViolet, 0x8A2BE2), at several shades.
+ * An icon of one of our own modules -- a Wine builtin, by the signature its
+ * header carries -- gets that hue turned into the accent's as it is made,
+ * each shade keeping its place: saturation and value scale by the accent's
+ * over the key's. Programs' icons, from their own files, are never touched.
+ * The accent is Personalization's, DWM AccentColor (0xAABBGGRR).
+ */
+#define SG_CURSORICON_REPLACE 0x40000000  /* win32u: a shared icon's frame replaced in place */
+#define SG_KEY_HUE   271.15
+#define SG_KEY_SAT   0.8097
+#define SG_KEY_VAL   0.8863
+#define SG_KEY_COLOR RGB(0x8a, 0x2b, 0xe2)
+
+COLORREF sg_icon_accent(void)
+{
+    DWORD value, size = sizeof(value);
+
+#ifdef SG_MUTANT_ICON_ACCENT_FIXED
+    return SG_KEY_COLOR;
+#endif
+    if (!RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\DWM", L"AccentColor",
+                       RRF_RT_REG_DWORD, NULL, &value, &size ))
+        return value & 0xffffff;
+    return SG_KEY_COLOR;
+}
+
+BOOL sg_module_is_ours( HMODULE module )
+{
+    static const char signature[] = "Wine builtin DLL";
+    const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)((ULONG_PTR)module & ~(ULONG_PTR)3);
+
+    if (!module) return TRUE;  /* user32's own */
+    __TRY
+    {
+        if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew < sizeof(*dos) + sizeof(signature)) return FALSE;
+        return !memcmp( dos + 1, signature, sizeof(signature) );
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        return FALSE;
+    }
+    __ENDTRY
+}
+
+static void rgb_to_hsv( double r, double g, double b, double *h, double *s, double *v )
+{
+    double max = max( r, max( g, b ) ), min = min( r, min( g, b ) ), d = max - min;
+
+    *v = max;
+    *s = max > 0 ? d / max : 0;
+    if (d <= 0) *h = 0;
+    else if (max == r) *h = 60 * ((g - b) / d);
+    else if (max == g) *h = 60 * ((b - r) / d + 2);
+    else *h = 60 * ((r - g) / d + 4);
+    if (*h < 0) *h += 360;
+}
+
+static void hsv_to_rgb( double h, double s, double v, double *r, double *g, double *b )
+{
+    double c = v * s, x, m = v - c, hh = h / 60;
+    int i = (int)hh % 6;
+
+    x = c * (1 - fabs( fmod( hh, 2 ) - 1 ));
+    switch (i)
+    {
+    case 0: *r = c; *g = x; *b = 0; break;
+    case 1: *r = x; *g = c; *b = 0; break;
+    case 2: *r = 0; *g = c; *b = x; break;
+    case 3: *r = 0; *g = x; *b = c; break;
+    case 4: *r = x; *g = 0; *b = c; break;
+    default: *r = c; *g = 0; *b = x; break;
+    }
+    *r += m; *g += m; *b += m;
+}
+
+/* re-hue the key-hued pixels of a 32-bpp bitmap; premultiplied: the alpha bounds each channel */
+static BOOL tint_bitmap( HDC hdc, HBITMAP bitmap, COLORREF accent, BOOL premultiplied )
+{
+    BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER) }};
+    double ah, as, av, h, sat, v, r, g, b;
+    BOOL changed = FALSE;
+    DWORD *bits, i, count;
+    BITMAP bm;
+
+    if (!bitmap || !GetObjectW( bitmap, sizeof(bm), &bm )) return FALSE;
+    info.bmiHeader.biWidth = bm.bmWidth;
+    info.bmiHeader.biHeight = -bm.bmHeight;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    count = bm.bmWidth * bm.bmHeight;
+    if (!count || !(bits = malloc( count * 4 ))) return FALSE;
+    if (!GetDIBits( hdc, bitmap, 0, bm.bmHeight, bits, &info, DIB_RGB_COLORS )) { free( bits ); return FALSE; }
+    rgb_to_hsv( GetRValue(accent) / 255.0, GetGValue(accent) / 255.0, GetBValue(accent) / 255.0, &ah, &as, &av );
+    for (i = 0; i < count; i++)
+    {
+        DWORD p = bits[i], a = p >> 24, top = premultiplied ? a : 255;
+        double dh;
+
+        if (premultiplied && !a) continue;
+        r = ((p >> 16) & 0xff) / 255.0; g = ((p >> 8) & 0xff) / 255.0; b = (p & 0xff) / 255.0;
+        if (premultiplied) { r = r * 255 / a; g = g * 255 / a; b = b * 255 / a; }
+        rgb_to_hsv( r, g, b, &h, &sat, &v );
+        dh = fabs( h - SG_KEY_HUE );
+        if (dh > 180) dh = 360 - dh;
+        if (dh > 22 || sat < 0.12 || v < 0.15) continue;
+        sat = min( 1.0, sat * as / SG_KEY_SAT );
+        v = min( 1.0, v * av / SG_KEY_VAL );
+        hsv_to_rgb( ah, sat, v, &r, &g, &b );
+        r *= top; g *= top; b *= top;
+        bits[i] = (p & 0xff000000) | ((DWORD)(min( r + 0.5, top )) << 16) |
+                  ((DWORD)(min( g + 0.5, top )) << 8) | (DWORD)(min( b + 0.5, top ));
+        changed = TRUE;
+    }
+    if (changed) SetDIBits( hdc, bitmap, 0, bm.bmHeight, bits, &info, DIB_RGB_COLORS );
+    free( bits );
+    return changed;
+}
+
+static void tint_frame( struct cursoricon_frame *frame, COLORREF accent )
+{
+    HDC hdc;
+
+    if (accent == SG_KEY_COLOR) return;
+    if (!(hdc = CreateCompatibleDC( 0 ))) return;
+    tint_bitmap( hdc, frame->color, accent, FALSE );
+    tint_bitmap( hdc, frame->alpha, accent, TRUE );
+    DeleteDC( hdc );
+}
+
+/* the shared icons we tinted, and with which accent: a new accent re-tints them in place */
+static struct { HICON icon; COLORREF accent; } sg_tinted[256];
+static unsigned int sg_tinted_count;
+static CRITICAL_SECTION sg_tint_cs;
+static CRITICAL_SECTION_DEBUG sg_tint_cs_debug =
+{
+    0, 0, &sg_tint_cs,
+    { &sg_tint_cs_debug.ProcessLocksList, &sg_tint_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": sg_tint_cs") }
+};
+static CRITICAL_SECTION sg_tint_cs = { &sg_tint_cs_debug, -1, 0, 0, 0, 0 };
+
+static int sg_tinted_find( HICON icon )
+{
+    unsigned int i;
+    for (i = 0; i < sg_tinted_count; i++) if (sg_tinted[i].icon == icon) return i;
+    return -1;
+}
+
+static void sg_tinted_note( HICON icon, COLORREF accent )
+{
+    int i;
+    EnterCriticalSection( &sg_tint_cs );
+    if ((i = sg_tinted_find( icon )) >= 0) sg_tinted[i].accent = accent;
+    else if (sg_tinted_count < ARRAY_SIZE(sg_tinted))
+    {
+        sg_tinted[sg_tinted_count].icon = icon;
+        sg_tinted[sg_tinted_count++].accent = accent;
+    }
+    LeaveCriticalSection( &sg_tint_cs );
+}
+
+/* was this shared icon tinted with another accent? */
+static BOOL sg_tinted_stale( HICON icon, COLORREF accent )
+{
+    BOOL stale = FALSE;
+    int i;
+    EnterCriticalSection( &sg_tint_cs );
+    if ((i = sg_tinted_find( icon )) >= 0) stale = sg_tinted[i].accent != accent;
+    LeaveCriticalSection( &sg_tint_cs );
+    return stale;
+}
+
 /***********************************************************************
  *          create_icon_from_bmi
  *
  * Create an icon from its BITMAPINFO.
  */
+static HICON create_icon_from_bmi_tint( const BITMAPINFO *bmi, DWORD maxsize, HMODULE module, LPCWSTR resname,
+                                        HRSRC rsrc, POINT hotspot, BOOL bIcon, INT width, INT height,
+                                        UINT flags, BOOL tint, HICON reuse )
+{
+    struct cursoricon_frame frame;
+    struct cursoricon_desc desc =
+    {
+        .flags = flags,
+        .frames = &frame,
+    };
+    COLORREF accent = 0;
+    HICON ret;
+
+    if (!create_icon_frame( bmi, maxsize, hotspot, bIcon, width, height, flags, &frame )) return 0;
+    if (tint && bIcon)
+    {
+        accent = sg_icon_accent();
+        tint_frame( &frame, accent );
+    }
+    if (reuse)
+    {
+        /* the shared icon again, in the new accent, in place: everyone who holds it sees it */
+        desc.flags |= SG_CURSORICON_REPLACE;
+        if (NtUserSetCursorIconData( reuse, NULL, NULL, &desc )) sg_tinted_note( reuse, accent );
+        else free_icon_frame( &frame );
+        return reuse;
+    }
+    ret = create_cursoricon_object( &desc, bIcon, module, resname, rsrc );
+    if (!ret) free_icon_frame( &frame );
+    else if (tint && bIcon && (flags & LR_SHARED)) sg_tinted_note( ret, accent );
+    return ret;
+}
+
 static HICON create_icon_from_bmi( const BITMAPINFO *bmi, DWORD maxsize, HMODULE module, LPCWSTR resname,
                                    HRSRC rsrc, POINT hotspot, BOOL bIcon, INT width, INT height,
                                    UINT flags )
@@ -1251,6 +1462,13 @@ HICON WINAPI CreateIconFromResourceEx( LPBYTE bits, UINT cbSize,
                                        BOOL bIcon, DWORD dwVersion,
                                        INT width, INT height,
                                        UINT cFlag )
+{
+    return sg_create_icon_from_resource( bits, cbSize, bIcon, dwVersion, width, height, cFlag, FALSE );
+}
+
+/* CreateIconFromResourceEx, and an icon of ours follows the accent (exticon.c) */
+HICON sg_create_icon_from_resource( LPBYTE bits, UINT cbSize, BOOL bIcon, DWORD dwVersion,
+                                    INT width, INT height, UINT cFlag, BOOL ours )
 {
     POINT hotspot;
     const BITMAPINFO *bmi;
@@ -1287,7 +1505,8 @@ HICON WINAPI CreateIconFromResourceEx( LPBYTE bits, UINT cbSize,
         cbSize -= 2 * sizeof(*pt);
     }
 
-    return create_icon_from_bmi( bmi, cbSize, NULL, NULL, NULL, hotspot, bIcon, width, height, cFlag );
+    return create_icon_from_bmi_tint( bmi, cbSize, NULL, NULL, NULL, hotspot, bIcon, width, height, cFlag,
+                                      ours, NULL );
 }
 
 
