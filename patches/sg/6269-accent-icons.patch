                              BOOL fCursor, UINT loadflags)
 {
     HANDLE handle = 0;
-    HICON hIcon = 0;
+    HICON hIcon = 0, reuse = 0;
     HRSRC hRsrc;
     DWORD size;
     const CURSORICONDIR *dir;
@@ -1431,7 +1650,10 @@ static HICON CURSORICON_Load(HINSTANCE hInstance, LPCWSTR name,
