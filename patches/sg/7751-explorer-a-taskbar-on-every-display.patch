+/* ---- a taskbar on every display (Windows' secondary taskbars, Shell_SecondaryTrayWnd) -----
+ *
+ * David 2026-11-12: "many monitors, more than two even ... which gets the task bar, or if all
+ * of them get the task bar". The main taskbar is on the main display (Settings: "Make this my
+ * main display"); with "Show taskbar on all displays" (MMTaskbarEnabled, on by default as on
+ * Windows) every other display has one too, on the same edge: Start, the buttons of the
+ * windows on that display (or all of them: MMTaskbarMode) and the clock. Each reserves its
+ * own display's work area, so what is maximized there stays clear of it. */
+struct sg_second
+{
+    struct list entry;
+    HWND   hwnd;
+    RECT   monitor;     /* its display */
+    RECT   bar;         /* the bar, in screen coordinates */
+    int    nbuttons;
+    HWND   button_hwnd[64];
+    RECT   button_rect[64];
+    int    hot;         /* the button under the pointer (-1: none; 64: Start) */
+};
+static struct list sg_seconds = LIST_INIT( sg_seconds );
+static const WCHAR sg_second_class[] = L"Shell_SecondaryTrayWnd";
+
+/* the display a window is on: where it is, or where it comes back to when minimized */
+static HMONITOR sg_window_monitor( HWND hwnd )
+{
+    WINDOWPLACEMENT wp = { sizeof(wp) };
+    if (IsIconic( hwnd ) && GetWindowPlacement( hwnd, &wp ))
+        return MonitorFromRect( &wp.rcNormalPosition, MONITOR_DEFAULTTONEAREST );
+    return MonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST );
+}
+
+static BOOL sg_on_main_bar( const struct taskbar_button *win )
+{
+    POINT origin = { 0, 0 };
+#ifdef SG_MUTANT_MM_MAIN_SHOWS_ALL
+    return TRUE;
+#endif
+    if (list_empty( &sg_seconds ) || sg_bar.mm_mode != SG_MM_WHERE || !win->hwnd || win->xwin) return TRUE;
+    return sg_window_monitor( win->hwnd ) == MonitorFromPoint( origin, MONITOR_DEFAULTTOPRIMARY );
+}
+
+static BOOL sg_on_second( const struct sg_second *bar, const struct taskbar_button *win )
+{
+    if (!win->hwnd || !win->visible || win->xwin || win->elevated) return FALSE;
+    if (sg_bar.mm_mode == SG_MM_ALL) return TRUE;
+    return sg_window_monitor( win->hwnd ) == MonitorFromRect( &bar->monitor, MONITOR_DEFAULTTONEAREST );
+}
+
+static int sg_second_thickness(void)
+{
+    if (sg_vertical()) return sg_bar.small ? SG_SMALL_VERTICAL : SG_VERTICAL_WIDTH;
+    return sg_bar_rect.bottom - sg_bar_rect.top > 0 ? sg_bar_rect.bottom - sg_bar_rect.top : SG_TASKBAR_HEIGHT;
+}
+
+static void sg_second_layout( struct sg_second *bar )
+{
+    struct taskbar_button *win;
+    int t = sg_second_thickness(), pos = t, end, len;
+    BOOL vertical = sg_vertical();
+
+    end = vertical ? bar->bar.bottom - bar->bar.top - sg_clock_len() : bar->bar.right - bar->bar.left - sg_clock_len();
+    len = vertical ? t : (sg_bar.glom == 0 ? SG_ICON_BUTTON : taskbar_button_width);
+    bar->nbuttons = 0;
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+    {
+        if (!sg_on_second( bar, win )) continue;
+        if (bar->nbuttons >= (int)ARRAY_SIZE(bar->button_hwnd) || pos + len > end) break;
+        bar->button_hwnd[bar->nbuttons] = win->hwnd;
+        if (vertical) SetRect( &bar->button_rect[bar->nbuttons], 0, pos, t, pos + len );
+        else SetRect( &bar->button_rect[bar->nbuttons], pos, 0, pos + len, t );
+        bar->nbuttons++;
+        pos += len;
+    }
+}
+
+static HICON sg_window_small_icon( HWND hwnd )
+{
+    struct taskbar_button *win = find_taskbar_button( hwnd );
+    HICON icon = NULL;
+    if (win && win->exe_icon) return win->exe_icon;
+    SendMessageTimeoutW( hwnd, WM_GETICON, ICON_SMALL2, 0, SMTO_ABORTIFHUNG, 100, (DWORD_PTR *)&icon );
+    if (!icon) icon = (HICON)GetClassLongPtrW( hwnd, GCLP_HICONSM );
+    if (!icon) icon = (HICON)GetClassLongPtrW( hwnd, GCLP_HICON );
+    return icon;
+}
+
+static void sg_second_paint( struct sg_second *bar, HDC target )
+{
+    RECT rc, start, clock;
+    HDC hdc;
+    HBITMAP bmp, oldbmp;
+    HFONT font, oldfont;
+    NONCLIENTMETRICSW ncm = { sizeof(ncm) };
+    HWND foreground = GetAncestor( GetForegroundWindow(), GA_ROOTOWNER );
+    int t = sg_second_thickness(), i;
+
+    GetClientRect( bar->hwnd, &rc );
+    hdc = CreateCompatibleDC( target );
+    bmp = CreateCompatibleBitmap( target, rc.right, rc.bottom );
+    oldbmp = SelectObject( hdc, bmp );
+    if (sg_look != SG_LOOK_FLAT) sg_paint_bar_under( hdc, bar->hwnd );
+    else sg_fill( hdc, &rc, SG_COL_BAR );
+
+    /* Start, as on the main bar */
+    SetRect( &start, 0, 0, t, t );
+    if (bar->hot == 64) sg_button_back( hdc, &start, SG_COL_HOVER );
+    sg_draw_start_mark( hdc, &start );
+
+    SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+    font = sg_bar_font( &ncm.lfMessageFont );
+    oldfont = SelectObject( hdc, font );
+    SetBkMode( hdc, TRANSPARENT );
+    SetTextColor( hdc, SG_COL_TEXT );
+    for (i = 0; i < bar->nbuttons; i++)
+    {
+        RECT r = bar->button_rect[i], label;
+        HWND hwnd = bar->button_hwnd[i];
+        HICON icon = sg_window_small_icon( hwnd );
+        WCHAR title[256];
+        BOOL active = hwnd == foreground, labels = !sg_vertical() && sg_bar.glom != 0;
+        int ix = labels ? r.left + SG_PX(8) : (r.left + r.right - SG_SMICON) / 2;
+
+        if (active || bar->hot == i) sg_button_back( hdc, &r, active ? SG_COL_ACTIVE : SG_COL_HOVER );
+        if (icon) DrawIconEx( hdc, ix, (r.top + r.bottom - SG_SMICON) / 2, icon, SG_SMICON, SG_SMICON, 0, 0, DI_NORMAL );
+        if (labels && InternalGetWindowText( hwnd, title, ARRAY_SIZE(title) ))
+        {
+            label = r;
+            label.left = ix + SG_SMICON + SG_PX(6);
+            label.right -= SG_PX(4);
+            DrawTextW( hdc, title, -1, &label, DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS | DT_NOPREFIX );
+        }
+        /* the running mark under the button, in the accent colour */
+        {
+            RECT mark = r;
+            if (sg_vertical()) { mark.right = mark.left + SG_PX(2); InflateRect( &mark, 0, -SG_PX(6) ); }
+            else { mark.top = mark.bottom - SG_PX(2); InflateRect( &mark, -SG_PX(6), 0 ); }
+            sg_fill( hdc, &mark, SG_COL_ACCENT );
+        }
+    }
+    SelectObject( hdc, oldfont );
+    DeleteObject( font );
+
+    clock = rc;
+    if (sg_vertical()) clock.top = rc.bottom - sg_clock_len();
+    else clock.left = rc.right - sg_clock_len();
+    sg_draw_clock( hdc, &clock );
+
+    BitBlt( target, 0, 0, rc.right, rc.bottom, hdc, 0, 0, SRCCOPY );
+    SelectObject( hdc, oldbmp );
+    DeleteObject( bmp );
+    DeleteDC( hdc );
+}
+
+static int sg_second_hit( struct sg_second *bar, POINT pt )
+{
+    RECT start;
+    int i, t = sg_second_thickness();
+    SetRect( &start, 0, 0, t, t );
+    if (PtInRect( &start, pt )) return 64;
+    for (i = 0; i < bar->nbuttons; i++) if (PtInRect( &bar->button_rect[i], pt )) return i;
+    return -1;
+}
+
+static struct sg_second *sg_second_from_hwnd( HWND hwnd )
+{
+    struct sg_second *bar;
+    LIST_FOR_EACH_ENTRY( bar, &sg_seconds, struct sg_second, entry ) if (bar->hwnd == hwnd) return bar;
+    return NULL;
+}
+
+static LRESULT CALLBACK sg_second_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    struct sg_second *bar = sg_second_from_hwnd( hwnd );
+    POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
+
+    switch (msg)
+    {
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint( hwnd, &ps );
+        if (bar) sg_second_paint( bar, hdc );
+        EndPaint( hwnd, &ps );
+        return 0;
+    }
+    case WM_MOUSEMOVE:
+        if (bar)
+        {
+            int hot = sg_second_hit( bar, pt );
+            TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd };
+            TrackMouseEvent( &tme );
+            if (hot != bar->hot) { bar->hot = hot; InvalidateRect( hwnd, NULL, FALSE ); }
+        }
+        return 0;
+    case WM_MOUSELEAVE:
+        if (bar && bar->hot != -1) { bar->hot = -1; InvalidateRect( hwnd, NULL, FALSE ); }
+        return 0;
+    case WM_LBUTTONUP:
+        if (bar)
+        {
+            int i = sg_second_hit( bar, pt );
+            if (i == 64)
+            {
+                /* Start opens on this display (sg-start places itself on the bar it is given) */
+                HWND sg = FindWindowW( L"SgStartPanel", NULL );
+                if (sg) PostMessageW( sg, WM_USER + 10, 0, (LPARAM)hwnd );
+                else do_startmenu( hwnd );
+            }
+            else if (i >= 0) activate_taskbar_window( bar->button_hwnd[i] );
+            InvalidateRect( hwnd, NULL, FALSE );
+        }
+        return 0;
+    case WM_RBUTTONUP:
+        if (bar)
+        {
+            int i = sg_second_hit( bar, pt );
+            ClientToScreen( hwnd, &pt );
+            if (i >= 0 && i < 64)
+            {
+                /* the window's own menu (Restore, Move, Size, Minimize, Maximize, Close) */
+                HWND target = bar->button_hwnd[i];
+                HMENU menu = GetSystemMenu( target, FALSE );
+                int cmd;
+                if (!menu) return 0;
+                SetForegroundWindow( hwnd );
+                cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_RIGHTBUTTON | TPM_BOTTOMALIGN, pt.x, pt.y, 0, hwnd, NULL );
+                if (cmd) PostMessageW( target, WM_SYSCOMMAND, cmd, 0 );
+            }
+            else if (i < 0) sg_taskbar_menu( MAKELPARAM( pt.x, pt.y ) );
+        }
+        return 0;
+    case WM_MOUSEACTIVATE:
+        return MA_NOACTIVATE;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+static void sg_second_set_work_area( const struct sg_second *bar, BOOL reserve )
+{
+    RECT work = bar->monitor;
+    if (reserve && !sg_bar.autohide)
+    {
+        switch (sg_bar.edge)
+        {
+        case ABE_TOP:   work.top = bar->bar.bottom; break;
+        case ABE_LEFT:  work.left = bar->bar.right; break;
+        case ABE_RIGHT: work.right = bar->bar.left; break;
+        default:        work.bottom = bar->bar.top; break;
+        }
+    }
+    SystemParametersInfoW( SPI_SETWORKAREA, 0, &work, SPIF_SENDCHANGE );
+}
+
+static void sg_second_destroy( struct sg_second *bar )
+{
+    list_remove( &bar->entry );
+    sg_second_set_work_area( bar, FALSE );
+    DestroyWindow( bar->hwnd );
+    free( bar );
+}
+
+struct sg_monitors { RECT rect[16]; int count; };
+
+static BOOL CALLBACK sg_collect_monitor( HMONITOR monitor, HDC hdc, RECT *rect, LPARAM lp )
+{
+    struct sg_monitors *m = (struct sg_monitors *)lp;
+    MONITORINFO mi = { sizeof(mi) };
+    RECT primary, overlap;
+    int i;
+
+    SetRect( &primary, 0, 0, GetSystemMetrics( SM_CXSCREEN ), GetSystemMetrics( SM_CYSCREEN ) );
+    if (!GetMonitorInfoW( monitor, &mi ) || (mi.dwFlags & MONITORINFOF_PRIMARY)) return TRUE;
+    /* a display showing the main one (Duplicate) has no bar of its own */
+    if (IntersectRect( &overlap, &mi.rcMonitor, &primary )) return TRUE;
+    for (i = 0; i < m->count; i++) if (IntersectRect( &overlap, &mi.rcMonitor, &m->rect[i] )) return TRUE;
+    if (m->count < (int)ARRAY_SIZE(m->rect)) m->rect[m->count++] = mi.rcMonitor;
+    return TRUE;
+}
+
+/* the other displays' bars, as the displays and the settings now are */
+static void sg_seconds_sync(void)
+{
+    static BOOL registered;
+    struct sg_monitors m = { .count = 0 };
+    struct sg_second *bar, *next;
+    int i, t = sg_second_thickness();
+
+    if (!enable_taskbar) return;
+#ifndef SG_MUTANT_NO_SECOND_BARS
+    if (sg_bar.all_displays) EnumDisplayMonitors( 0, NULL, sg_collect_monitor, (LPARAM)&m );
+#endif
+    if (!registered && m.count)
+    {
+        WNDCLASSEXW wc = { sizeof(wc) };
+        wc.lpfnWndProc = sg_second_proc;
+        wc.hCursor = LoadCursorW( 0, (LPCWSTR)IDC_ARROW );
+        wc.lpszClassName = sg_second_class;
+        registered = RegisterClassExW( &wc ) != 0;
+    }
+    /* the bars of displays gone (or all of them, when only the main display has one) */
+    LIST_FOR_EACH_ENTRY_SAFE( bar, next, &sg_seconds, struct sg_second, entry )
+    {
+        for (i = 0; i < m.count; i++) if (EqualRect( &m.rect[i], &bar->monitor )) break;
+        if (i == m.count) sg_second_destroy( bar );
+    }
+    for (i = 0; i < m.count; i++)
+    {
+        RECT r = m.rect[i];
+        BOOL found = FALSE;
+        LIST_FOR_EACH_ENTRY( bar, &sg_seconds, struct sg_second, entry )
+            if (EqualRect( &m.rect[i], &bar->monitor )) { found = TRUE; break; }
+        if (!found)
+        {
+            if (!(bar = calloc( 1, sizeof(*bar) ))) continue;
+            bar->monitor = m.rect[i];
+            bar->hot = -1;
+            bar->hwnd = CreateWindowExW( WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW | WS_EX_TOPMOST, sg_second_class, NULL,
+                                         WS_POPUP, r.left, r.top, 1, 1, 0, 0, 0, 0 );
+            if (!bar->hwnd) { free( bar ); continue; }
+            list_add_tail( &sg_seconds, &bar->entry );
+        }
+        switch (sg_bar.edge)
+        {
+        case ABE_TOP:   SetRect( &bar->bar, r.left, r.top, r.right, r.top + t ); break;
+        case ABE_LEFT:  SetRect( &bar->bar, r.left, r.top, r.left + t, r.bottom ); break;
+        case ABE_RIGHT: SetRect( &bar->bar, r.right - t, r.top, r.right, r.bottom ); break;
+        default:        SetRect( &bar->bar, r.left, r.bottom - t, r.right, r.bottom ); break;
+        }
+        SetWindowPos( bar->hwnd, HWND_TOPMOST, bar->bar.left, bar->bar.top, bar->bar.right - bar->bar.left,
+                      bar->bar.bottom - bar->bar.top, SWP_NOACTIVATE | SWP_SHOWWINDOW );
+        sg_second_set_work_area( bar, TRUE );
+        sg_second_layout( bar );
+        InvalidateRect( bar->hwnd, NULL, FALSE );
+    }
+}
+
+/* the windows or their titles changed: the other displays' bars show it */
+static void sg_seconds_changed(void)
+{
+    struct sg_second *bar;
+    LIST_FOR_EACH_ENTRY( bar, &sg_seconds, struct sg_second, entry )
+    {
+        sg_second_layout( bar );
+        InvalidateRect( bar->hwnd, NULL, FALSE );
+    }
+}
+
 static void do_show_systray(void)
 {
     SIZE size;
@@ -5660,6 +6024,8 @@
          * together with the appbars' (appbar.c) */
         update_work_area();
     }
+    /* and the other displays' bars (a taskbar on every display) */
+    sg_seconds_sync();
     /* Stained Glass OS: tick the clock once a second. */
     SetTimer( tray_window, SG_CLOCK_TIMER, 1000, NULL );
     SetTimer( tray_window, SG_ELEVATED_TIMER, 1000, NULL );
@@ -5738,6 +6104,16 @@
             if (sg_vertical()) rc.top = rc.bottom - sg_clock_len();
             else rc.left = rc.right - sg_clock_len();
             InvalidateRect( hwnd, &rc, FALSE );
+            {
+                struct sg_second *bar;
+                LIST_FOR_EACH_ENTRY( bar, &sg_seconds, struct sg_second, entry )
+                {
+                    GetClientRect( bar->hwnd, &rc );
+                    if (sg_vertical()) rc.top = rc.bottom - sg_clock_len();
+                    else rc.left = rc.right - sg_clock_len();
+                    InvalidateRect( bar->hwnd, &rc, FALSE );
+                }
+            }
             return 0;
         }
         if (wparam == SG_ELEVATED_TIMER)
