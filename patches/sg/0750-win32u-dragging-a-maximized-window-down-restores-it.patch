From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: dragging a maximized window down restores it

As on Windows, dragging a maximized window by its caption restores it
under the pointer (the pointer keeps its place across the caption, in
proportion) and goes on moving it; a click, or the first click of a
double-click, leaves it alone until the pointer passes the drag distance.
Wine ignored a drag on a maximized window (David 2026-10-01, field report
item 3).

And a window restored from maximized keeps its caption on the screen. A
window dragged to the top edge to maximize it (Snap, 0075) was saved where
the drag left it, its caption above the screen, and a double-click put it
back there with its buttons out of reach (field report item 12).

Gate: test/shellkeys-gate.sh (mutants SG_MUTANT_NO_DRAG_UNMAXIMIZE,
SG_MUTANT_RESTORE_OFFSCREEN fail it).
---
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -655,6 +655,76 @@
     return hit == HTBOTTOM || hit == HTBOTTOMLEFT || hit == HTBOTTOMRIGHT;
 }
 
+/* Stained Glass OS: dragging a maximized window by its caption restores it
+ * under the pointer -- the pointer keeps its place across the caption, in
+ * proportion -- and the drag goes on moving it, as on Windows. Until the
+ * pointer moves past the drag distance nothing happens, so a click (or a
+ * double-click, which restores) is left alone. Returns FALSE when the button
+ * comes up first; *msg_pos is then where the drag goes on from. */
+static BOOL drag_unmaximize( HWND hwnd, WPARAM wparam, UINT style, DWORD *msg_pos )
+{
+    int cx = get_system_metrics( SM_CXDRAG ), cy = get_system_metrics( SM_CYDRAG ), w, h, x, y;
+    RECT max_rect, rect;
+    POINT start, pt;
+    MSG msg;
+
+#ifdef SG_MUTANT_NO_DRAG_UNMAXIMIZE
+    return FALSE;
+#endif
+    if ((wparam & 0xfff0) != SC_MOVE || (wparam & 0x0f) != HTCAPTION || (style & WS_CHILD)) return FALSE;
+    if (!(NtUserGetKeyState( VK_LBUTTON ) & 0x8000)) return FALSE;
+
+    start.x = (short)LOWORD( *msg_pos );
+    start.y = (short)HIWORD( *msg_pos );
+    set_capture_window( hwnd, GUI_INMOVESIZE, NULL );
+    for (;;)
+    {
+        if (!NtUserGetMessage( &msg, 0, 0, 0 ))
+        {
+            post_quit_message( msg.wParam );
+            set_capture_window( 0, GUI_INMOVESIZE, NULL );
+            return FALSE;
+        }
+        if (NtUserCallMsgFilter( &msg, MSGF_SIZE )) continue;
+        if (msg.message == WM_LBUTTONUP || msg.message == WM_RBUTTONDOWN ||
+            (msg.message == WM_KEYDOWN && msg.wParam == VK_ESCAPE) || get_capture() != hwnd)
+        {
+            set_capture_window( 0, GUI_INMOVESIZE, NULL );
+            return FALSE;
+        }
+        if (msg.message == WM_MOUSEMOVE)
+        {
+            if (abs( msg.pt.x - start.x ) > cx || abs( msg.pt.y - start.y ) > cy) break;
+            continue;
+        }
+        if (msg.message == WM_KEYDOWN || msg.message == WM_KEYUP || msg.message == WM_CHAR) continue;
+        NtUserTranslateMessage( &msg, 0 );
+        NtUserDispatchMessage( &msg );
+        if (!(NtUserGetKeyState( VK_LBUTTON ) & 0x8000))
+        {
+            set_capture_window( 0, GUI_INMOVESIZE, NULL );
+            return FALSE;
+        }
+    }
+    pt = msg.pt;
+    set_capture_window( 0, GUI_INMOVESIZE, NULL );
+
+    get_window_rect( hwnd, &max_rect, get_thread_dpi() );
+    NtUserShowWindow( hwnd, SW_RESTORE );
+    if (is_zoomed( hwnd )) return FALSE;
+    get_window_rect( hwnd, &rect, get_thread_dpi() );
+    w = rect.right - rect.left;
+    h = rect.bottom - rect.top;
+    x = pt.x - (max_rect.right > max_rect.left ?
+                (int)((LONGLONG)(start.x - max_rect.left) * w / (max_rect.right - max_rect.left)) : w / 2);
+    /* the pointer stays as far below the top as it was in the caption */
+    if (start.y - max_rect.top < h) y = pt.y - (start.y - max_rect.top);
+    else y = pt.y - h / 2;
+    NtUserSetWindowPos( hwnd, 0, x, y, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE );
+    *msg_pos = MAKELONG( pt.x, pt.y );
+    return TRUE;
+}
+
 /***********************************************************************
  *           sys_command_size_move
  *
@@ -676,7 +746,8 @@
     HDC hdc;
     MSG msg;
 
-    if (is_zoomed( hwnd ) || !is_window_visible( hwnd )) return;
+    if (!is_window_visible( hwnd )) return;
+    if (is_zoomed( hwnd ) && !drag_unmaximize( hwnd, wparam, style, &msg_pos )) return;
 
     thickframe = (style & WS_THICKFRAME) && !((style & (WS_DLGFRAME | WS_BORDER)) == WS_DLGFRAME);
 
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -4736,6 +4736,16 @@
         /* Restore to normal position */
 
         *rect = wpl.rcNormalPosition;
+        /* Stained Glass OS: with its caption on the screen. A window dragged
+         * to the top edge to maximize it was above the screen then, and came
+         * back with its buttons out of reach. */
+#ifndef SG_MUTANT_RESTORE_OFFSCREEN
+        if (!(get_window_long( hwnd, GWL_STYLE ) & WS_CHILD))
+        {
+            MONITORINFO info = monitor_info_from_rect( *rect, get_thread_dpi() );
+            if (rect->top < info.rcWork.top) OffsetRect( rect, 0, info.rcWork.top - rect->top );
+        }
+#endif
         break;
     }
 
