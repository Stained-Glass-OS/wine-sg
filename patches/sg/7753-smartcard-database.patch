+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Stained Glass OS: the smart card database, as Windows keeps it, in
+ * HKLM\Software\Microsoft\Cryptography\Calais\SmartCards\<card name>: "ATR" and "ATRMask" (binary),
+ * "Primary Provider" (a GUID, binary), "Supported Interfaces" (GUIDs, binary), and the provider
+ * names "Crypto Provider", "Smart Card Key Storage Provider" and "80000001" (the card module, a
+ * minidriver). Programs look a card up by its ATR (SCardListCards), then find the CSP, KSP or
+ * minidriver that drives it (SCardGetCardTypeProviderName); installers of card middleware register
+ * their cards there (SCardIntroduceCardType). The functions were stubs. */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <wchar.h>
+#define WINSCARDAPI
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "winscard.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(winscard);
+
+static const WCHAR cards_keyW[] = L"Software\\Microsoft\\Cryptography\\Calais\\SmartCards";
+
+#define MAX_ATR 36
+
+struct card
+{
+    BYTE  atr[MAX_ATR];
+    BYTE  mask[MAX_ATR];
+    DWORD atr_len;
+    BOOL  has_mask;
+    GUID *interfaces;
+    DWORD interface_count;
+};
+
+static LONG reg_error( LONG err )
+{
+    return err == ERROR_FILE_NOT_FOUND ? SCARD_E_UNKNOWN_CARD : err;
+}
+
+static LONG open_card( const WCHAR *name, REGSAM access, BOOL create, HKEY *ret )
+{
+    HKEY cards;
+    LONG err;
+
+    if (create)
+    {
+        if ((err = RegCreateKeyExW( HKEY_LOCAL_MACHINE, cards_keyW, 0, NULL, 0, KEY_CREATE_SUB_KEY, NULL,
+                                    &cards, NULL ))) return err;
+        err = RegCreateKeyExW( cards, name, 0, NULL, 0, access, NULL, ret, NULL );
+    }
+    else
+    {
+        if ((err = RegOpenKeyExW( HKEY_LOCAL_MACHINE, cards_keyW, 0, KEY_ENUMERATE_SUB_KEYS, &cards )))
+            return reg_error( err );
+        err = reg_error( RegOpenKeyExW( cards, name, 0, access, ret ) );
+    }
+    RegCloseKey( cards );
+    return err;
+}
+
+static void read_card( HKEY key, struct card *card )
+{
+    DWORD size, type;
+
+    memset( card, 0, sizeof(*card) );
+    size = sizeof(card->atr);
+    if (RegQueryValueExW( key, L"ATR", NULL, &type, card->atr, &size ) || type != REG_BINARY) size = 0;
+    card->atr_len = size;
+    size = sizeof(card->mask);
+    card->has_mask = !RegQueryValueExW( key, L"ATRMask", NULL, &type, card->mask, &size ) &&
+                     type == REG_BINARY && size == card->atr_len;
+    size = 0;
+    if (!RegQueryValueExW( key, L"Supported Interfaces", NULL, NULL, NULL, &size ) && size >= sizeof(GUID) &&
+        (card->interfaces = malloc( size )))
+    {
+        if (RegQueryValueExW( key, L"Supported Interfaces", NULL, NULL, (BYTE *)card->interfaces, &size ))
+            size = 0;
+        card->interface_count = size / sizeof(GUID);
+    }
+}
+
+/* the card's ATR, under its mask, against a reader's or the caller's ATR */
+static BOOL atr_matches( const BYTE *atr, DWORD atr_len, const BYTE *card_atr, const BYTE *mask, DWORD card_len )
+{
+    DWORD i;
+
+    if (atr_len != card_len) return FALSE;
+    for (i = 0; i < card_len; i++)
+    {
+#ifdef SG_MUTANT_SCARD_ATR_MASK_IGNORED
+        mask = NULL;
+#endif
+        BYTE m = mask ? mask[i] : 0xff;
+        if ((atr[i] & m) != (card_atr[i] & m)) return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL card_matches( const struct card *card, const BYTE *atr, DWORD atr_len, const GUID *interfaces,
+                          DWORD count )
+{
+    DWORD i, j;
+
+    if (atr && !atr_matches( atr, atr_len, card->atr, card->has_mask ? card->mask : NULL, card->atr_len ))
+        return FALSE;
+#ifndef SG_MUTANT_SCARD_NO_INTERFACE_FILTER
+    for (i = 0; interfaces && i < count; i++)
+    {
+        for (j = 0; j < card->interface_count; j++)
+            if (IsEqualGUID( &interfaces[i], &card->interfaces[j] )) break;
+        if (j == card->interface_count) return FALSE;
+    }
+#endif
+    return TRUE;
+}
+
+/* an ATR's length as SCardListCards is given it: the ATR's own structure (T0's historical byte
+ * count, the interface bytes it announces), at most MAX_ATR */
+static DWORD atr_length( const BYTE *atr )
+{
+    DWORD len = 2, hist = atr[1] & 0x0f, y = atr[1] & 0xf0, tck = 0;
+
+    for (;;)
+    {
+        DWORD td_pos = 0;
+        if (y & 0x10) len++;
+        if (y & 0x20) len++;
+        if (y & 0x40) len++;
+        if (y & 0x80) td_pos = len++;
+        if (!td_pos || len > MAX_ATR) break;
+        if ((atr[td_pos] & 0x0f) != 0) tck = 1;
+        y = atr[td_pos] & 0xf0;
+    }
+    len += hist + tck;
+    return min( len, MAX_ATR );
+}
+
+static LONG put_string( const WCHAR *str, DWORD len, WCHAR *buf, DWORD *buf_len )
+{
+    if (!buf_len) return SCARD_E_INVALID_PARAMETER;
+    if (*buf_len == SCARD_AUTOALLOCATE)
+    {
+        WCHAR *mem;
+        if (!buf) return SCARD_E_INVALID_PARAMETER;
+        if (!(mem = malloc( len * sizeof(WCHAR) ))) return SCARD_E_NO_MEMORY;
+        memcpy( mem, str, len * sizeof(WCHAR) );
+        *(WCHAR **)buf = mem;
+    }
+    else if (buf)
+    {
+        if (*buf_len < len)
+        {
+            *buf_len = len;
+            return SCARD_E_INSUFFICIENT_BUFFER;
+        }
+        memcpy( buf, str, len * sizeof(WCHAR) );
+    }
+    *buf_len = len;
+    return SCARD_S_SUCCESS;
+}
+
+static BOOL valid_context( SCARDCONTEXT context )
+{
+    /* the database calls take a context or none; a context given is checked */
+    return !context || SCardIsValidContext( context ) == SCARD_S_SUCCESS;
+}
+
+LONG WINAPI SCardIntroduceCardTypeW( SCARDCONTEXT context, const WCHAR *name, const GUID *primary,
+                                     const GUID *interfaces, DWORD count, const BYTE *atr, const BYTE *mask,
+                                     DWORD atr_len )
+{
+    HKEY key;
+    LONG err;
+
+    TRACE( "%Ix, %s, %s, %p, %lu, %p, %p, %lu\n", context, debugstr_w(name), debugstr_guid(primary),
+           interfaces, count, atr, mask, atr_len );
+
+    if (!valid_context( context )) return ERROR_INVALID_HANDLE;
+    if (!name || !*name || !atr || !atr_len || atr_len > MAX_ATR || (count && !interfaces))
+        return SCARD_E_INVALID_PARAMETER;
+    if ((err = open_card( name, KEY_SET_VALUE, TRUE, &key ))) return err;
+    err = RegSetValueExW( key, L"ATR", 0, REG_BINARY, atr, atr_len );
+    if (!err && mask) err = RegSetValueExW( key, L"ATRMask", 0, REG_BINARY, mask, atr_len );
+    if (!err && primary) err = RegSetValueExW( key, L"Primary Provider", 0, REG_BINARY, (const BYTE *)primary,
+                                               sizeof(GUID) );
+    if (!err && count) err = RegSetValueExW( key, L"Supported Interfaces", 0, REG_BINARY,
+                                             (const BYTE *)interfaces, count * sizeof(GUID) );
+    RegCloseKey( key );
+    return err;
+}
+
+LONG WINAPI SCardForgetCardTypeW( SCARDCONTEXT context, const WCHAR *name )
+{
+    HKEY cards;
+    LONG err;
+
+    TRACE( "%Ix, %s\n", context, debugstr_w(name) );
+
+    if (!valid_context( context )) return ERROR_INVALID_HANDLE;
+    if (!name || !*name) return SCARD_E_INVALID_PARAMETER;
+    if ((err = RegOpenKeyExW( HKEY_LOCAL_MACHINE, cards_keyW, 0, KEY_ALL_ACCESS, &cards )))
+        return reg_error( err );
+    err = reg_error( RegDeleteTreeW( cards, name ) );
+    RegCloseKey( cards );
+    return err;
+}
+
+static const WCHAR *provider_value( DWORD id )
+{
+    switch (id)
+    {
+    case SCARD_PROVIDER_PRIMARY:     return L"Primary Provider";
+    case SCARD_PROVIDER_CSP:         return L"Crypto Provider";
+    case SCARD_PROVIDER_KSP:         return L"Smart Card Key Storage Provider";
+    case SCARD_PROVIDER_CARD_MODULE: return L"80000001";
+    default: return NULL;
+    }
+}
+
+LONG WINAPI SCardSetCardTypeProviderNameW( SCARDCONTEXT context, const WCHAR *card, DWORD id,
+                                           const WCHAR *provider )
+{
+    const WCHAR *value = provider_value( id );
+    HKEY key;
+    LONG err;
+
+    TRACE( "%Ix, %s, %#lx, %s\n", context, debugstr_w(card), id, debugstr_w(provider) );
+
+    if (!valid_context( context )) return ERROR_INVALID_HANDLE;
+    if (!card || !*card || !provider || !value) return SCARD_E_INVALID_PARAMETER;
+    if ((err = open_card( card, KEY_SET_VALUE, FALSE, &key ))) return err;
+    if (id == SCARD_PROVIDER_PRIMARY)
+    {
+        GUID guid;
+        unsigned int d[11];
+
+        if (swscanf( provider, L"{%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x}", &d[0], &d[1], &d[2], &d[3], &d[4],
+                     &d[5], &d[6], &d[7], &d[8], &d[9], &d[10] ) != 11)
+            err = SCARD_E_INVALID_PARAMETER;
+        else
+        {
+            int i;
+            guid.Data1 = d[0];
+            guid.Data2 = d[1];
+            guid.Data3 = d[2];
+            for (i = 0; i < 8; i++) guid.Data4[i] = d[3 + i];
+            err = RegSetValueExW( key, value, 0, REG_BINARY, (const BYTE *)&guid, sizeof(guid) );
+        }
+    }
+    else err = RegSetValueExW( key, value, 0, REG_SZ, (const BYTE *)provider,
+                               (wcslen( provider ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    return err;
+}
+
+LONG WINAPI SCardGetCardTypeProviderNameW( SCARDCONTEXT context, const WCHAR *card, DWORD id, WCHAR *provider,
+                                           DWORD *provider_len )
+{
+    const WCHAR *value = provider_value( id );
+    WCHAR buf[MAX_PATH];
+    DWORD size, type;
+    HKEY key;
+    LONG err;
+
+    TRACE( "%Ix, %s, %#lx, %p, %p\n", context, debugstr_w(card), id, provider, provider_len );
+
+    if (!valid_context( context )) return ERROR_INVALID_HANDLE;
+    if (!card || !*card || !value || !provider_len) return SCARD_E_INVALID_PARAMETER;
+    if ((err = open_card( card, KEY_QUERY_VALUE, FALSE, &key ))) return err;
+    if (id == SCARD_PROVIDER_PRIMARY)
+    {
+        GUID guid;
+        size = sizeof(guid);
+        if (!(err = RegQueryValueExW( key, value, NULL, &type, (BYTE *)&guid, &size )))
+            swprintf( buf, ARRAY_SIZE(buf), L"{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}", guid.Data1,
+                      guid.Data2, guid.Data3, guid.Data4[0], guid.Data4[1], guid.Data4[2], guid.Data4[3],
+                      guid.Data4[4], guid.Data4[5], guid.Data4[6], guid.Data4[7] );
+    }
+    else
+    {
+        size = sizeof(buf) - sizeof(WCHAR);
+        if (!(err = RegQueryValueExW( key, value, NULL, &type, (BYTE *)buf, &size )))
+        {
+            if (type != REG_SZ) err = ERROR_FILE_NOT_FOUND;
+            buf[size / sizeof(WCHAR)] = 0;
+        }
+    }
+    RegCloseKey( key );
+    if (err) return err;
+    return put_string( buf, wcslen( buf ) + 1, provider, provider_len );
+}
+
+LONG WINAPI SCardGetProviderIdW( SCARDCONTEXT context, const WCHAR *card, GUID *id )
+{
+    DWORD size = sizeof(*id);
+    HKEY key;
+    LONG err;
+
+    TRACE( "%Ix, %s, %p\n", context, debugstr_w(card), id );
+
+    if (!valid_context( context )) return ERROR_INVALID_HANDLE;
+    if (!card || !*card || !id) return SCARD_E_INVALID_PARAMETER;
+    if ((err = open_card( card, KEY_QUERY_VALUE, FALSE, &key ))) return err;
+    err = RegQueryValueExW( key, L"Primary Provider", NULL, NULL, (BYTE *)id, &size );
+    RegCloseKey( key );
+    return err;
+}
+
+LONG WINAPI SCardListInterfacesW( SCARDCONTEXT context, const WCHAR *card, GUID *interfaces, DWORD *count )
+{
+    struct card info;
+    HKEY key;
+    LONG err;
+
+    TRACE( "%Ix, %s, %p, %p\n", context, debugstr_w(card), interfaces, count );
+
+    if (!valid_context( context )) return ERROR_INVALID_HANDLE;
+    if (!card || !*card || !count) return SCARD_E_INVALID_PARAMETER;
+    if ((err = open_card( card, KEY_QUERY_VALUE, FALSE, &key ))) return err;
+    read_card( key, &info );
+    RegCloseKey( key );
+
+    if (*count == SCARD_AUTOALLOCATE)
+    {
+        GUID *mem;
+        if (!interfaces) err = SCARD_E_INVALID_PARAMETER;
+        else if (!(mem = malloc( max( 1, info.interface_count ) * sizeof(GUID) ))) err = SCARD_E_NO_MEMORY;
+        else
+        {
+            memcpy( mem, info.interfaces, info.interface_count * sizeof(GUID) );
+            *(GUID **)interfaces = mem;
+        }
+    }
+    else if (interfaces && *count < info.interface_count) err = SCARD_E_INSUFFICIENT_BUFFER;
+    else if (interfaces) memcpy( interfaces, info.interfaces, info.interface_count * sizeof(GUID) );
+    if (!err || err == SCARD_E_INSUFFICIENT_BUFFER) *count = info.interface_count;
+    free( info.interfaces );
+    return err;
+}
+
+LONG WINAPI SCardListCardsW( SCARDCONTEXT context, const BYTE *atr, const GUID *interfaces, DWORD count,
+                             WCHAR *cards, DWORD *cards_len )
+{
+    WCHAR name[256], *list = NULL, *tmp;
+    DWORD i, len = 0, name_len;
+    HKEY key, card_key;
+    struct card card;
+    LONG err;
+
+    TRACE( "%Ix, %p, %p, %lu, %p, %p\n", context, atr, interfaces, count, cards, cards_len );
+
+    if (!valid_context( context )) return ERROR_INVALID_HANDLE;
+    if (!cards_len || (count && !interfaces)) return SCARD_E_INVALID_PARAMETER;
+
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, cards_keyW, 0, KEY_ENUMERATE_SUB_KEYS, &key ))
+    {
+        for (i = 0; name_len = ARRAY_SIZE(name), !RegEnumKeyExW( key, i, name, &name_len, NULL, NULL, NULL, NULL ); i++)
+        {
+            if (RegOpenKeyExW( key, name, 0, KEY_QUERY_VALUE, &card_key )) continue;
+            read_card( card_key, &card );
+            RegCloseKey( card_key );
+            if (card.atr_len && card_matches( &card, atr, atr ? atr_length( atr ) : 0, interfaces, count ))
+            {
+                if (!(tmp = realloc( list, (len + name_len + 2) * sizeof(WCHAR) )))
+                {
+                    free( card.interfaces );
+                    free( list );
+                    RegCloseKey( key );
+                    return SCARD_E_NO_MEMORY;
+                }
+                list = tmp;
+                memcpy( list + len, name, (name_len + 1) * sizeof(WCHAR) );
+                len += name_len + 1;
+            }
+            free( card.interfaces );
+        }
+        RegCloseKey( key );
+    }
+    if (!(tmp = realloc( list, (len + 1) * sizeof(WCHAR) )))
+    {
+        free( list );
+        return SCARD_E_NO_MEMORY;
+    }
+    list = tmp;
+    list[len++] = 0;
+    err = put_string( list, len, cards, cards_len );
+    free( list );
+    return err;
+}
+
+/* SCardLocateCards[ByATR]: the readers' state as SCardGetStatusChange gives it at once, and
+ * SCARD_STATE_ATRMATCH where the card in the reader is one asked for */
+static BOOL atr_is_card( const BYTE *atr, DWORD atr_len, const WCHAR *cards )
+{
+    for (; cards && *cards; cards += wcslen( cards ) + 1)
+    {
+        struct card card;
+        BOOL match;
+        HKEY key;
+
+        if (open_card( cards, KEY_QUERY_VALUE, FALSE, &key )) continue;
+        read_card( key, &card );
+        RegCloseKey( key );
+        match = card.atr_len && atr_matches( atr, atr_len, card.atr, card.has_mask ? card.mask : NULL, card.atr_len );
+        free( card.interfaces );
+        if (match) return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL atr_in_masks( const BYTE *atr, DWORD atr_len, const SCARD_ATRMASK *masks, DWORD count )
+{
+    DWORD i;
+
+    for (i = 0; i < count; i++)
+        if (atr_matches( atr, atr_len, masks[i].rgbAtr, masks[i].rgbMask, masks[i].cbAtr )) return TRUE;
+    return FALSE;
+}
+
+#define LOCATE( name, state_type, status_fn ) \
+static LONG name( SCARDCONTEXT context, state_type *states, DWORD count, const WCHAR *cards, \
+                  const SCARD_ATRMASK *masks, DWORD mask_count ) \
+{ \
+    state_type *now; \
+    DWORD i; \
+    LONG err; \
+\
+    if (!context || !valid_context( context )) return ERROR_INVALID_HANDLE; \
+    if (!states && count) return SCARD_E_INVALID_PARAMETER; \
+    if (!count) return SCARD_S_SUCCESS; \
+    if (!(now = malloc( count * sizeof(*now) ))) return SCARD_E_NO_MEMORY; \
+    memcpy( now, states, count * sizeof(*now) ); \
+    for (i = 0; i < count; i++) now[i].dwCurrentState = SCARD_STATE_UNAWARE; \
+    err = status_fn( context, 0, now, count ); \
+    if (!err) \
+    { \
+        for (i = 0; i < count; i++) \
+        { \
+            DWORD event = now[i].dwEventState & ~(SCARD_STATE_ATRMATCH | SCARD_STATE_CHANGED); \
+            if ((event & SCARD_STATE_PRESENT) && \
+                (masks ? atr_in_masks( now[i].rgbAtr, now[i].cbAtr, masks, mask_count ) \
+                       : atr_is_card( now[i].rgbAtr, now[i].cbAtr, cards ))) \
+                event |= SCARD_STATE_ATRMATCH; \
+            if (event != (states[i].dwCurrentState & ~SCARD_STATE_CHANGED)) event |= SCARD_STATE_CHANGED; \
+            states[i].dwEventState = event; \
+            states[i].cbAtr = now[i].cbAtr; \
+            memcpy( states[i].rgbAtr, now[i].rgbAtr, sizeof(states[i].rgbAtr) ); \
+        } \
+    } \
+    free( now ); \
+    return err; \
+}
+
+LOCATE( locate_cards_w, SCARD_READERSTATEW, SCardGetStatusChangeW )
+LOCATE( locate_cards_a, SCARD_READERSTATEA, SCardGetStatusChangeA )
+
+LONG WINAPI SCardLocateCardsW( SCARDCONTEXT context, const WCHAR *cards, SCARD_READERSTATEW *states, DWORD count )
+{
+    TRACE( "%Ix, %s, %p, %lu\n", context, debugstr_w(cards), states, count );
+    if (!cards) return SCARD_E_INVALID_PARAMETER;
+    return locate_cards_w( context, states, count, cards, NULL, 0 );
+}
+
+LONG WINAPI SCardLocateCardsByATRW( SCARDCONTEXT context, SCARD_ATRMASK *masks, DWORD mask_count,
+                                    SCARD_READERSTATEW *states, DWORD count )
+{
+    TRACE( "%Ix, %p, %lu, %p, %lu\n", context, masks, mask_count, states, count );
+    if (!masks && mask_count) return SCARD_E_INVALID_PARAMETER;
+    return locate_cards_w( context, states, count, NULL, masks, mask_count );
+}
+
+LONG WINAPI SCardLocateCardsByATRA( SCARDCONTEXT context, SCARD_ATRMASK *masks, DWORD mask_count,
+                                    SCARD_READERSTATEA *states, DWORD count )
+{
+    TRACE( "%Ix, %p, %lu, %p, %lu\n", context, masks, mask_count, states, count );
+    if (!masks && mask_count) return SCARD_E_INVALID_PARAMETER;
+    return locate_cards_a( context, states, count, NULL, masks, mask_count );
+}
+
+/* the A forms */
+
+static WCHAR *strdupAW( const char *str )
+{
+    WCHAR *ret;
+    int len;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar( CP_ACP, 0, str, -1, NULL, 0 );
+    if ((ret = malloc( len * sizeof(WCHAR) ))) MultiByteToWideChar( CP_ACP, 0, str, -1, ret, len );
+    return ret;
+}
+
+static WCHAR *multiszAW( const char *str )
+{
+    const char *p = str;
+    WCHAR *ret;
+    int len;
+
+    if (!str) return NULL;
+    while (*p) p += strlen( p ) + 1;
+    len = MultiByteToWideChar( CP_ACP, 0, str, p - str + 1, NULL, 0 );
+    if ((ret = malloc( len * sizeof(WCHAR) ))) MultiByteToWideChar( CP_ACP, 0, str, p - str + 1, ret, len );
+    return ret;
+}
+
+/* a W result (string or multi-string, len characters) handed back in the ANSI code page */
+static LONG put_stringA( const WCHAR *str, DWORD len, char *buf, DWORD *buf_len )
+{
+    int alen = WideCharToMultiByte( CP_ACP, 0, str, len, NULL, 0, NULL, NULL );
+
+    if (*buf_len == SCARD_AUTOALLOCATE)
+    {
+        char *mem;
+        if (!buf) return SCARD_E_INVALID_PARAMETER;
+        if (!(mem = malloc( alen ))) return SCARD_E_NO_MEMORY;
+        WideCharToMultiByte( CP_ACP, 0, str, len, mem, alen, NULL, NULL );
+        *(char **)buf = mem;
+    }
+    else if (buf)
+    {
+        if (*buf_len < alen)
+        {
+            *buf_len = alen;
+            return SCARD_E_INSUFFICIENT_BUFFER;
+        }
+        WideCharToMultiByte( CP_ACP, 0, str, len, buf, alen, NULL, NULL );
+    }
+    *buf_len = alen;
+    return SCARD_S_SUCCESS;
+}
+
+LONG WINAPI SCardIntroduceCardTypeA( SCARDCONTEXT context, const char *name, const GUID *primary,
+                                     const GUID *interfaces, DWORD count, const BYTE *atr, const BYTE *mask,
+                                     DWORD atr_len )
+{
+    WCHAR *nameW = strdupAW( name );
+    LONG ret;
+
+    if (name && !nameW) return SCARD_E_NO_MEMORY;
+    ret = SCardIntroduceCardTypeW( context, nameW, primary, interfaces, count, atr, mask, atr_len );
+    free( nameW );
+    return ret;
+}
+
+LONG WINAPI SCardForgetCardTypeA( SCARDCONTEXT context, const char *name )
+{
+    WCHAR *nameW = strdupAW( name );
+    LONG ret;
+
+    if (name && !nameW) return SCARD_E_NO_MEMORY;
+    ret = SCardForgetCardTypeW( context, nameW );
+    free( nameW );
+    return ret;
+}
+
+LONG WINAPI SCardSetCardTypeProviderNameA( SCARDCONTEXT context, const char *card, DWORD id, const char *provider )
+{
+    WCHAR *cardW = strdupAW( card ), *providerW = strdupAW( provider );
+    LONG ret = SCARD_E_NO_MEMORY;
+
+    if ((!card || cardW) && (!provider || providerW))
+        ret = SCardSetCardTypeProviderNameW( context, cardW, id, providerW );
+    free( cardW );
+    free( providerW );
+    return ret;
+}
+
+LONG WINAPI SCardGetCardTypeProviderNameA( SCARDCONTEXT context, const char *card, DWORD id, char *provider,
+                                           DWORD *provider_len )
+{
+    WCHAR *cardW = strdupAW( card ), *providerW = NULL;
+    DWORD len = SCARD_AUTOALLOCATE;
+    LONG ret;
+
+    if (card && !cardW) return SCARD_E_NO_MEMORY;
+    if (!provider_len) ret = SCARD_E_INVALID_PARAMETER;
+    else if (!(ret = SCardGetCardTypeProviderNameW( context, cardW, id, (WCHAR *)&providerW, &len )))
+    {
+        ret = put_stringA( providerW, len, provider, provider_len );
+        free( providerW );
+    }
+    free( cardW );
+    return ret;
+}
+
+LONG WINAPI SCardGetProviderIdA( SCARDCONTEXT context, const char *card, GUID *id )
+{
+    WCHAR *cardW = strdupAW( card );
+    LONG ret;
+
+    if (card && !cardW) return SCARD_E_NO_MEMORY;
+    ret = SCardGetProviderIdW( context, cardW, id );
+    free( cardW );
+    return ret;
+}
+
+LONG WINAPI SCardListInterfacesA( SCARDCONTEXT context, const char *card, GUID *interfaces, DWORD *count )
+{
+    WCHAR *cardW = strdupAW( card );
+    LONG ret;
+
+    if (card && !cardW) return SCARD_E_NO_MEMORY;
+    ret = SCardListInterfacesW( context, cardW, interfaces, count );
+    free( cardW );
+    return ret;
+}
+
+LONG WINAPI SCardListCardsA( SCARDCONTEXT context, const BYTE *atr, const GUID *interfaces, DWORD count,
+                             char *cards, DWORD *cards_len )
+{
+    WCHAR *list = NULL;
+    DWORD len = SCARD_AUTOALLOCATE;
+    LONG ret;
+
+    TRACE( "%Ix, %p, %p, %lu, %p, %p\n", context, atr, interfaces, count, cards, cards_len );
+
+    if (!cards_len) return SCARD_E_INVALID_PARAMETER;
+    if ((ret = SCardListCardsW( context, atr, interfaces, count, (WCHAR *)&list, &len ))) return ret;
+    ret = put_stringA( list, len, cards, cards_len );
+    free( list );
+    return ret;
+}
+
+LONG WINAPI SCardLocateCardsA( SCARDCONTEXT context, const char *cards, SCARD_READERSTATEA *states, DWORD count )
+{
+    WCHAR *cardsW = multiszAW( cards );
+    LONG ret;
+
+    TRACE( "%Ix, %s, %p, %lu\n", context, debugstr_a(cards), states, count );
+
+    if (!cards) return SCARD_E_INVALID_PARAMETER;
+    if (!cardsW) return SCARD_E_NO_MEMORY;
+    ret = locate_cards_a( context, states, count, cardsW, NULL, 0 );
+    free( cardsW );
+    return ret;
+}
