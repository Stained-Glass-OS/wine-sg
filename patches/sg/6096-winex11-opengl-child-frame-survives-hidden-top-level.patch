From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a child window's OpenGL frame presented while its top-level is hidden is shown with it

A child window's OpenGL frames (wined3d's Direct3D included) are rendered offscreen and copied into the top-level's X window. A frame presented while the top-level was hidden went into an unmapped X window and was lost; a program that presents once and then waits (Electron's first frame, before ready-to-show) stayed black. Windows' compositor keeps a swap chain's last frame. When the top-level is exposed, child windows with an offscreen OpenGL drawable (marked with a window property, so another process's too) are posted a driver message, and the thread that owns each copies its last frame again.
---
diff --git a/dlls/winex11.drv/event.c b/dlls/winex11.drv/event.c
index bb38582..79404cf 100644
--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -1077,9 +1077,37 @@ static BOOL X11DRV_Expose( HWND hwnd, XEvent *xev )
     release_win_data( data );
 
     NtUserExposeWindowSurface( hwnd, flags, &rect, NtUserGetWinMonitorDpi( hwnd, MDT_RAW_DPI ) );
+#ifndef SG_MUTANT_GL_NO_RESHOW
+    if (!event->count && event->window != root_window) sg_gl_reshow_children( hwnd );
+#endif
     return TRUE;
 }
 
+/* Stained Glass OS (wine-sg 6096): HWND was exposed; the windows in it (of any process) whose
+ * OpenGL frames are copied into it offscreen are asked to show their last frame again */
+void sg_gl_reshow_children( HWND hwnd )
+{
+    HWND stack[16], child;
+    int depth = 0, count = 0;
+
+    if (!(child = NtUserGetWindowRelative( hwnd, GW_CHILD ))) return;
+    while (child && count++ < 4096)
+    {
+        HWND next;
+
+        if (NtUserGetProp( child, sg_gl_offscreenW ) && (NtUserGetWindowLongW( child, GWL_STYLE ) & WS_VISIBLE))
+            NtUserPostMessage( child, WM_X11DRV_SG_GL_RESHOW, 0, 0 );
+        if (depth < ARRAY_SIZE(stack) && (next = NtUserGetWindowRelative( child, GW_CHILD )))
+        {
+            stack[depth++] = child;
+            child = next;
+            continue;
+        }
+        while (!(next = NtUserGetWindowRelative( child, GW_HWNDNEXT )) && depth) child = stack[--depth];
+        child = next;
+    }
+}
+
 
 /**********************************************************************
  *		X11DRV_MapNotify
diff --git a/dlls/winex11.drv/opengl.c b/dlls/winex11.drv/opengl.c
index 74f7848..f084b67 100644
--- a/dlls/winex11.drv/opengl.c
+++ b/dlls/winex11.drv/opengl.c
@@ -233,6 +233,7 @@ struct gl_drawable
     BOOL                           mutable_pf;
     HDC                            hdc_src;
     HDC                            hdc_dst;
+    BOOL                           presented;    /* a frame was copied into the top-level (6096) */
 };
 
 struct wgl_pbuffer
@@ -1155,6 +1156,7 @@ static struct gl_drawable *create_gl_drawable( HWND hwnd, const struct glx_pixel
             gl->hdc_dst = NtGdiOpenDCW( &device_str, NULL, NULL, 0, TRUE, NULL, NULL, NULL );
             gl->hdc_src = NtGdiOpenDCW( &device_str, NULL, NULL, 0, TRUE, NULL, NULL, NULL );
             set_dc_drawable( gl->hdc_src, gl->window, &gl->rect, IncludeInferiors );
+            NtUserSetProp( hwnd, sg_gl_offscreenW, (HANDLE)1 );
         }
 
         TRACE( "%p created child %lx drawable %lx\n", hwnd, gl->window, gl->drawable );
@@ -1178,6 +1180,7 @@ static struct gl_drawable *create_gl_drawable( HWND hwnd, const struct glx_pixel
             gl->hdc_dst = NtGdiOpenDCW( &device_str, NULL, NULL, 0, TRUE, NULL, NULL, NULL );
             gl->hdc_src = NtGdiOpenDCW( &device_str, NULL, NULL, 0, TRUE, NULL, NULL, NULL );
             set_dc_drawable( gl->hdc_src, gl->pixmap, &gl->rect, IncludeInferiors );
+            NtUserSetProp( hwnd, sg_gl_offscreenW, (HANDLE)1 );
         }
     }
 
@@ -1917,10 +1920,35 @@ static void present_gl_drawable( HWND hwnd, HDC hdc, struct gl_drawable *gl, BOO
 
     NtGdiStretchBlt( gl->hdc_dst, 0, 0, rect_dst.right - rect_dst.left, rect_dst.bottom - rect_dst.top,
                      gl->hdc_src, 0, 0, gl->rect.right, gl->rect.bottom, SRCCOPY, 0 );
+    gl->presented = TRUE;
 
     if (region) NtGdiDeleteObjectApp( region );
 }
 
+/* Stained Glass OS (wine-sg 6096): a child window's frame is rendered offscreen and copied into
+ * its top-level's X window. A frame presented while the top-level was hidden was copied into an
+ * unmapped window, which X does not keep: Electron presents its first frame before it shows the
+ * window (ready-to-show), and Obsidian's start window stayed black until something in it moved.
+ * Windows' compositor keeps a swap chain's last frame and shows it with the window. When the
+ * top-level is exposed (shown, uncovered), the frame kept by the offscreen drawable is copied
+ * again, by the thread that owns the child -- another process's too (sg_gl_reshow_children). */
+LRESULT sg_gl_reshow( HWND hwnd )
+{
+    struct gl_drawable *gl;
+    HDC hdc;
+
+    if (!(gl = get_gl_drawable( hwnd, 0 ))) return 0;
+    if ((gl->type == DC_GL_CHILD_WIN || gl->type == DC_GL_PIXMAP_WIN) && gl->presented &&
+        (hdc = NtUserGetDCEx( hwnd, 0, DCX_CACHE | DCX_CLIPSIBLINGS )))
+    {
+        TRACE( "%p: the last frame shown again\n", hwnd );
+        present_gl_drawable( hwnd, hdc, gl, TRUE, FALSE );
+        NtUserReleaseDC( hwnd, hdc );
+    }
+    release_gl_drawable( gl );
+    return 0;
+}
+
 static void wglFinish(void)
 {
     struct gl_drawable *gl;
@@ -2942,4 +2970,9 @@ void destroy_gl_drawable( HWND hwnd )
 {
 }
 
+LRESULT sg_gl_reshow( HWND hwnd )
+{
+    return 0;
+}
+
 #endif /* defined(SONAME_LIBGL) */
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 8c03dd4..db2b08a 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3721,6 +3721,8 @@ LRESULT X11DRV_WindowMessage( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
     case WM_X11DRV_SG_EMBED_FOCUS:
     case WM_X11DRV_SG_EMBED_MOVESIZE_DONE:
         return sg_embed_message( hwnd, msg, wp, lp );
+    case WM_X11DRV_SG_GL_RESHOW:
+        return sg_gl_reshow( hwnd );
     default:
         FIXME( "got window msg %x hwnd %p wp %lx lp %lx\n", msg, hwnd, (long)wp, lp );
         return 0;
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 3e88a3f..48ab0af 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -675,9 +675,15 @@ enum x11drv_window_messages
     WM_X11DRV_SG_EMBED_FULLSCREEN,
     WM_X11DRV_SG_EMBED_MAXIMIZE,
     WM_X11DRV_SG_EMBED_FOCUS,
-    WM_X11DRV_SG_EMBED_MOVESIZE_DONE
+    WM_X11DRV_SG_EMBED_MOVESIZE_DONE,
+    WM_X11DRV_SG_GL_RESHOW         /* 6096: show the offscreen OpenGL frame again */
 };
 
+/* a window whose OpenGL frames are rendered offscreen and copied into its top-level (6096) */
+static const WCHAR sg_gl_offscreenW[] = {'_','_','w','i','n','e','_','s','g','_','g','l','_','o','f','f','s','c','r','e','e','n',0};
+extern LRESULT sg_gl_reshow( HWND hwnd );
+extern void sg_gl_reshow_children( HWND hwnd );
+
 /* _NET_WM_STATE properties that we keep track of */
 enum x11drv_net_wm_state
 {
