From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: a second thread waits for the desktop's shell another thread is starting

9061 let a process start a desktop's explorer only once. A second thread
that asked for the desktop window while the first was still starting that
explorer made the desktop window itself, with no shell and no display
driver behind it, and every window the program made then failed with "The
explorer process failed to start". It happened to the first program after
a new account's first sign-in or after an update restarted the server,
whenever explorer was slow to come up and two of the program's threads made
windows at once (the delete question's dialog and the thread looking for
it; a splash screen and a main window). On Windows the shell's desktop is
there before programs. The second thread now waits (up to 20 s) for the
first to finish starting the shell and then takes the shell's desktop
window; only if none came is it made without one, as before.

Gate: make test-firstwindow. Mutant: -DSG_MUTANT_SHELL_NO_WAIT.
---
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -830,36 +830,76 @@
 #endif
 
 static pthread_mutex_t sg_shell_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t sg_shell_cond = PTHREAD_COND_INITIALIZER;
+static HDESK sg_shell_tried[16];
+static BOOL sg_shell_busy[16];  /* that desktop's explorer is being started by another thread now */
+static unsigned int sg_shell_tried_count;
+
+enum sg_shell { SG_SHELL_START, SG_SHELL_NONE, SG_SHELL_STARTED };
 
 /* Stained Glass OS 9061: whether this process may start an explorer for its thread's desktop
  * (get_desktop_window): not if it is a desktop's explorer itself ("explorer.exe /desktop..."), and
- * once per desktop otherwise */
-static BOOL sg_may_start_desktop_shell(void)
+ * once per desktop otherwise.
+ * Stained Glass OS 9022: a second thread that asks while the first is still starting that explorer
+ * waits for it (SG_SHELL_STARTED) instead of making the desktop window itself with no shell behind it.
+ * A program whose threads all made windows at once -- the delete question's dialog and a thread
+ * looking for it, a splash screen and a main window -- got "The explorer process failed to start"
+ * whenever explorer was slow to come up: the first program after a new account's first sign-in or
+ * after an update restarted the server. On Windows the shell's desktop is there before programs. */
+static enum sg_shell sg_may_start_desktop_shell( HDESK desk )
 {
     static const WCHAR explorerW[] = {'\\','e','x','p','l','o','r','e','r','.','e','x','e'};
     static const WCHAR desktopW[] = {'/','d','e','s','k','t','o','p'};
-    static HDESK tried[16];
-    static unsigned int tried_count;
     RTL_USER_PROCESS_PARAMETERS *params = NtCurrentTeb()->Peb->ProcessParameters;
     const UNICODE_STRING *image = &params->ImagePathName, *cmd = &params->CommandLine;
-    HDESK desk = NtUserGetThreadDesktop( GetCurrentThreadId() );
     size_t n = ARRAY_SIZE(explorerW), m = ARRAY_SIZE(desktopW), i;
-    BOOL ret = TRUE;
+    enum sg_shell ret = SG_SHELL_START;
 
     if (image->Length >= n * sizeof(WCHAR) &&
         !wcsnicmp( image->Buffer + image->Length / sizeof(WCHAR) - n, explorerW, n ))
     {
         for (i = 0; i + m <= cmd->Length / sizeof(WCHAR); i++)
-            if (!wcsnicmp( cmd->Buffer + i, desktopW, m )) return FALSE;
+            if (!wcsnicmp( cmd->Buffer + i, desktopW, m )) return SG_SHELL_NONE;
     }
     pthread_mutex_lock( &sg_shell_mutex );
-    for (i = 0; i < tried_count; i++) if (tried[i] == desk) ret = FALSE;
-    if (ret && tried_count < ARRAY_SIZE(tried)) tried[tried_count++] = desk;
-    else if (ret) ret = FALSE;  /* sixteen desktops tried already */
+    for (i = 0; i < sg_shell_tried_count; i++) if (sg_shell_tried[i] == desk) break;
+    if (i < sg_shell_tried_count)
+    {
+        ret = SG_SHELL_NONE;
+#ifndef SG_MUTANT_SHELL_NO_WAIT
+        if (sg_shell_busy[i])
+        {
+            /* explorer's own start waits up to 10 s for it to be idle (NtUserWaitForInputIdle) */
+            struct timespec until;
+            clock_gettime( CLOCK_REALTIME, &until );
+            until.tv_sec += 20;
+            while (sg_shell_busy[i])
+                if (pthread_cond_timedwait( &sg_shell_cond, &sg_shell_mutex, &until )) break;
+            ret = SG_SHELL_STARTED;
+        }
+#endif
+    }
+    else if (sg_shell_tried_count < ARRAY_SIZE(sg_shell_tried))
+    {
+        sg_shell_busy[sg_shell_tried_count] = TRUE;
+        sg_shell_tried[sg_shell_tried_count++] = desk;
+    }
+    else ret = SG_SHELL_NONE;  /* sixteen desktops tried already */
     pthread_mutex_unlock( &sg_shell_mutex );
     return ret;
 }
 
+/* 9022: the explorer for this desktop has been started (or failed to start): wake the threads waiting */
+static void sg_desktop_shell_done( HDESK desk )
+{
+    unsigned int i;
+
+    pthread_mutex_lock( &sg_shell_mutex );
+    for (i = 0; i < sg_shell_tried_count; i++) if (sg_shell_tried[i] == desk) sg_shell_busy[i] = FALSE;
+    pthread_cond_broadcast( &sg_shell_cond );
+    pthread_mutex_unlock( &sg_shell_mutex );
+}
+
 HWND get_desktop_window(void)
 {
     static const WCHAR wine_service_station_name[] =
@@ -867,8 +907,11 @@
     struct ntuser_thread_info *thread_info = NtUserGetThreadInfo();
     WCHAR name[MAX_PATH];
     BOOL is_service, no_shell = FALSE;
+    enum sg_shell shell = SG_SHELL_NONE;
+    HDESK desk;
 
     if (thread_info->top_window) return UlongToHandle( thread_info->top_window );
+    desk = NtUserGetThreadDesktop( GetCurrentThreadId() );
 
     /* don't create an actual explorer desktop window for services */
     if (NtUserGetObjectInformation( NtUserGetProcessWindowStation(), UOI_NAME, name, sizeof(name), NULL )
@@ -909,12 +952,14 @@
      * renderer on such a desktop left tens of thousands of explorers that filled memory and swap.
      * On Windows win32k makes desktop windows and no process is started for them at all. */
 #ifndef SG_MUTANT_DESKTOP_SHELL_RESPAWNS
-    if (!thread_info->top_window && !sg_may_start_desktop_shell())
+    if (!thread_info->top_window && (shell = sg_may_start_desktop_shell( desk )) != SG_SHELL_START)
     {
         no_shell = TRUE;
         SERVER_START_REQ( get_desktop_window )
         {
-            req->force = 1;
+            /* 9022: after waiting for this process's other thread to start the shell, its desktop
+             * window is the shell's; made here only if it never came */
+            req->force = (shell != SG_SHELL_STARTED);
             if (!wine_server_call( req ))
             {
                 thread_info->top_window = reply->top_window;
@@ -922,6 +967,19 @@
             }
         }
         SERVER_END_REQ;
+        if (!thread_info->top_window && shell == SG_SHELL_STARTED)
+        {
+            SERVER_START_REQ( get_desktop_window )
+            {
+                req->force = 1;
+                if (!wine_server_call( req ))
+                {
+                    thread_info->top_window = reply->top_window;
+                    thread_info->msg_window = reply->msg_window;
+                }
+            }
+            SERVER_END_REQ;
+        }
     }
 #endif
     if (!thread_info->top_window && !no_shell)
@@ -1004,6 +1062,7 @@
             TRACE_(win)( "no shell for desktop %s: this process starts no others (%x)\n", debugstr_w(desktop), status );
 #endif
         else ERR_(win)( "failed to start explorer %x\n", status );
+        sg_desktop_shell_done( desk );
 
         SERVER_START_REQ( get_desktop_window )
         {
