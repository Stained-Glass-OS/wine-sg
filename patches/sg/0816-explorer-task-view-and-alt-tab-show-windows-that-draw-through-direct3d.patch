From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Task View and Alt+Tab show windows that draw through Direct3D

A window that draws through Direct3D, OpenGL or Vulkan presents straight
to its X window; what Wine keeps of it -- what PrintWindow gives Task
View's and Alt+Tab's pictures -- is black. Sonos (WPF, David 2026-10-05:
"task view seems to show it black. also in alt tab it's black"), games
and video players showed as black cards. A picture with nothing in it is
now taken from the screen instead while the window is in front, as
framed Linux windows' already are, and while it is not, the last good
picture is kept rather than replaced by black.

Test: test/glthumb-gate.sh with test/glthumb-probe.c (mutant
SG_MUTANT_D3D_THUMB_BLACK).
---
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -107,6 +107,26 @@
            GetClassNameW( hwnd, class, ARRAY_SIZE(class) ) && !wcscmp( class, L"SgLinuxWindow" );
 }
 
+/* Stained Glass OS: a picture with nothing in it. A window that draws
+ * through Direct3D, OpenGL or Vulkan (WPF: Sonos, David 2026-10-05; games,
+ * players) presents straight to its X window: what Wine kept of it, which
+ * PrintWindow gives, is black. Every 8th pixel of every 8th row looked at. */
+static BOOL all_black( HDC dc, HBITMAP bmp, int w, int h )
+{
+    BITMAPINFO bi = { { sizeof(BITMAPINFOHEADER), w, -h, 1, 32, BI_RGB } };
+    DWORD *px;
+    int x, y;
+    BOOL black = TRUE;
+
+    if (!(px = malloc( (size_t)w * h * 4 ))) return FALSE;
+    if (!GetDIBits( dc, bmp, 0, h, px, &bi, DIB_RGB_COLORS )) { free( px ); return FALSE; }
+    for (y = 0; y < h && black; y += 8)
+        for (x = 0; x < w; x += 8)
+            if (px[y * w + x] & 0xffffff) { black = FALSE; break; }
+    free( px );
+    return black;
+}
+
 static void capture_thumb( HWND hwnd )
 {
     struct thumb *t;
@@ -115,6 +135,7 @@
     HBITMAP bmp, whole;
     int w, h, tw, th;
     BOOL printed = FALSE, framed = sg_linux_framed( hwnd );
+    HGDIOBJ first;
 
 #ifdef SG_MUTANT_LINUX_THUMB_BLACK
     framed = FALSE;
@@ -142,11 +163,30 @@
      * covered (cross-process PrintWindow, wine-sg 0076) */
     full = CreateCompatibleDC( sdc );
     whole = CreateCompatibleBitmap( sdc, w, h );
-    SelectObject( full, whole );
+    first = SelectObject( full, whole );
     if (!framed && PrintWindow( hwnd, full, PW_RENDERFULLCONTENT ))
     {
-        StretchBlt( mdc, 0, 0, tw, th, full, 0, 0, w, h, SRCCOPY );
-        printed = TRUE;
+#ifndef SG_MUTANT_D3D_THUMB_BLACK
+        SelectObject( full, first );
+        if (all_black( full, whole, w, h ))
+        {
+            /* drawn through Direct3D or OpenGL: from the screen, while it is
+             * in front -- the last picture otherwise, not a black one */
+            if (GetForegroundWindow() != hwnd && find_thumb( hwnd ))
+            {
+                DeleteDC( full ); DeleteObject( whole );
+                DeleteDC( mdc ); DeleteObject( bmp ); ReleaseDC( 0, sdc );
+                return;
+            }
+            if (GetForegroundWindow() == hwnd) framed = TRUE;
+        }
+        SelectObject( full, whole );
+        if (!framed)
+#endif
+        {
+            StretchBlt( mdc, 0, 0, tw, th, full, 0, 0, w, h, SRCCOPY );
+            printed = TRUE;
+        }
     }
     DeleteDC( full );
     DeleteObject( whole );
