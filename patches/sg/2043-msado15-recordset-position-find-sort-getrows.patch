+/* Whole-recordset helpers for the position, search and fetch methods; a row is
+ * col_count variants in recordset->data. */
+static VARIANT *row_values( struct recordset *recordset, LONG row )
+{
+    return &recordset->data[row * get_column_count( recordset )];
+}
+
+static BOOL recordset_has_current( struct recordset *recordset )
+{
+    return recordset->index >= 0 && recordset->index < recordset->count;
+}
+
+/* a field named or numbered by a variant */
+static HRESULT recordset_find_field( struct recordset *recordset, const VARIANT *index, ULONG *col )
+{
+    VARIANT v = *index;
+    return map_index( recordset->fields, &v, col );
+}
+
+static int variant_compare_for_find( const VARIANT *a, const VARIANT *b, BOOL numeric )
+{
+    if (numeric)
+    {
+        VARIANT da, db;
+        double x, y;
+
+        VariantInit( &da );
+        VariantInit( &db );
+        if (VariantChangeType( &da, a, 0, VT_R8 ) == S_OK && VariantChangeType( &db, b, 0, VT_R8 ) == S_OK)
+        {
+            x = V_R8( &da );
+            y = V_R8( &db );
+            return x < y ? -1 : x > y ? 1 : 0;
+        }
+    }
+    {
+        VARIANT sa, sb;
+        int ret;
+
+        VariantInit( &sa );
+        VariantInit( &sb );
+        if (VariantChangeType( &sa, a, 0, VT_BSTR ) != S_OK) V_BSTR( &sa ) = SysAllocString( L"" );
+        if (VariantChangeType( &sb, b, 0, VT_BSTR ) != S_OK) V_BSTR( &sb ) = SysAllocString( L"" );
+        ret = wcsicmp( V_BSTR( &sa ), V_BSTR( &sb ) );
+        VariantClear( &sa );
+        VariantClear( &sb );
+        return ret;
+    }
+}
+
+/* the wildcard * (or %) for any text and ? (or _) for one character */
+static BOOL like_match( const WCHAR *pattern, const WCHAR *text )
+{
+    for (; *pattern; pattern++)
+    {
+        if (*pattern == '*' || *pattern == '%')
+        {
+            while (pattern[1] == '*' || pattern[1] == '%') pattern++;
+            if (!pattern[1]) return TRUE;
+            for (; *text; text++) if (like_match( pattern + 1, text )) return TRUE;
+            return like_match( pattern + 1, text );
+        }
+        if (!*text) return FALSE;
+        if (*pattern != '?' && *pattern != '_' && towlower( *pattern ) != towlower( *text )) return FALSE;
+        text++;
+    }
+    return !*text;
+}
+
+struct criteria
+{
+    ULONG col;
+    enum { OP_EQ, OP_NE, OP_LT, OP_GT, OP_LE, OP_GE, OP_LIKE } op;
+    VARIANT value;
+    BOOL numeric;
+};
+
+/* "field op value" with =, <>, <, >, <=, >= or LIKE; a value in quotes is a string, in # a date */
+static HRESULT parse_criteria( struct recordset *recordset, const WCHAR *text, struct criteria *c )
+{
+    const WCHAR *p = text, *start;
+    WCHAR *name, *value;
+    VARIANT index;
+    size_t len;
+
+    VariantInit( &c->value );
+    while (*p == ' ') p++;
+    start = p;
+    if (*p == '[')
+    {
+        start = ++p;
+        while (*p && *p != ']') p++;
+    }
+    else
+        while (*p && *p != ' ' && *p != '=' && *p != '<' && *p != '>') p++;
+    len = p - start;
+    if (!len) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    name = malloc( (len + 1) * sizeof(WCHAR) );
+    memcpy( name, start, len * sizeof(WCHAR) );
+    name[len] = 0;
+    if (*p == ']') p++;
+    while (*p == ' ') p++;
+
+    VariantInit( &index );
+    V_VT( &index ) = VT_BSTR;
+    V_BSTR( &index ) = SysAllocString( name );
+    free( name );
+    if (recordset_find_field( recordset, &index, &c->col ) != S_OK)
+    {
+        VariantClear( &index );
+        return MAKE_ADO_HRESULT( adErrItemNotFound );
+    }
+    VariantClear( &index );
+
+    if (p[0] == '<' && p[1] == '>') { c->op = OP_NE; p += 2; }
+    else if (p[0] == '<' && p[1] == '=') { c->op = OP_LE; p += 2; }
+    else if (p[0] == '>' && p[1] == '=') { c->op = OP_GE; p += 2; }
+    else if (*p == '<') { c->op = OP_LT; p++; }
+    else if (*p == '>') { c->op = OP_GT; p++; }
+    else if (*p == '=') { c->op = OP_EQ; p++; }
+    else if (!wcsnicmp( p, L"like", 4 )) { c->op = OP_LIKE; p += 4; }
+    else return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    while (*p == ' ') p++;
+
+    len = lstrlenW( p );
+    while (len && p[len - 1] == ' ') len--;
+    if (!len) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    value = malloc( (len + 1) * sizeof(WCHAR) );
+    if (p[0] == '\'' && len >= 2 && p[len - 1] == '\'')
+    {
+        size_t i, n = 0;
+        for (i = 1; i < len - 1; i++)
+        {
+            if (p[i] == '\'' && p[i + 1] == '\'') i++;
+            value[n++] = p[i];
+        }
+        value[n] = 0;
+        c->numeric = FALSE;
+    }
+    else
+    {
+        memcpy( value, p, len * sizeof(WCHAR) );
+        value[len] = 0;
+        c->numeric = c->op != OP_LIKE;
+    }
+    V_VT( &c->value ) = VT_BSTR;
+    V_BSTR( &c->value ) = SysAllocString( value );
+    free( value );
+
+    /* a text column compares as text even for a number */
+    switch (recordset->fields->field[c->col] ? impl_from_Field( recordset->fields->field[c->col] )->type : adEmpty)
+    {
+    case adBSTR: case adChar: case adVarChar: case adLongVarChar: case adWChar: case adVarWChar: case adLongVarWChar:
+        c->numeric = FALSE;
+        break;
+    default:
+        break;
+    }
+    return S_OK;
+}
+
+static BOOL criteria_matches( struct recordset *recordset, const struct criteria *c, LONG row )
+{
+    const VARIANT *cell = row_values( recordset, row ) + c->col;
+    int cmp;
+
+    if (c->op == OP_LIKE)
+    {
+        VARIANT text;
+        BOOL ret;
+
+        VariantInit( &text );
+        if (VariantChangeType( &text, cell, 0, VT_BSTR ) != S_OK) return FALSE;
+        ret = like_match( V_BSTR( &c->value ), V_BSTR( &text ) );
+        VariantClear( &text );
+        return ret;
+    }
+    cmp = variant_compare_for_find( cell, &c->value, c->numeric );
+    switch (c->op)
+    {
+    case OP_EQ: return cmp == 0;
+    case OP_NE: return cmp != 0;
+    case OP_LT: return cmp < 0;
+    case OP_GT: return cmp > 0;
+    case OP_LE: return cmp <= 0;
+    case OP_GE: return cmp >= 0;
+    default: return FALSE;
+    }
+}
+
