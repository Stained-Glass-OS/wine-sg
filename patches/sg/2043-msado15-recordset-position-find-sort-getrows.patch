+    if (recordset->lock_type == adLockReadOnly) return MAKE_ADO_HRESULT( adErrIllegalOperation );
+
+    if (affect_records == adAffectCurrent)
+    {
+        if (!recordset_has_current( recordset )) return MAKE_ADO_HRESULT( adErrNoCurrentRecord );
+        from = recordset->index;
+        to = from + 1;
+    }
+    else if (affect_records == adAffectAll || affect_records == adAffectAllChapters)
+    {
+        from = 0;
+        to = recordset->count;
+    }
+    else
+        return MAKE_ADO_HRESULT( adErrInvalidArgument );
+
+    for (i = from * cols; i < to * cols; i++) VariantClear( &recordset->data[i] );
+    memmove( recordset->data + from * cols, recordset->data + to * cols,
+             (recordset->count - to) * cols * sizeof(*recordset->data) );
+    memset( recordset->data + (recordset->count - (to - from)) * cols, 0, (to - from) * cols * sizeof(*recordset->data) );
+    recordset->count -= to - from;
+    if (recordset->index > recordset->count) recordset->index = recordset->count;
+    recordset->editmode = adEditNone;
+    return S_OK;
 }
 
