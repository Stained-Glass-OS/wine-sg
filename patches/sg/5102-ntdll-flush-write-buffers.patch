Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntdll: NtFlushProcessWriteBuffers is a real barrier (patch 5102)

membarrier(), with a page-protection fallback; gap-CORE item 446. Gate with a mutant.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -6482,10 +6482,91 @@
 /**********************************************************************
  *           NtFlushProcessWriteBuffers  (NTDLL.@)
  */
+#ifdef __linux__
+#include <sys/syscall.h>
+#ifndef __NR_membarrier
+# ifdef __x86_64__
+#  define __NR_membarrier 324
+# elif defined(__i386__)
+#  define __NR_membarrier 375
+# elif defined(__aarch64__)
+#  define __NR_membarrier 283
+# elif defined(__arm__)
+#  define __NR_membarrier 389
+# endif
+#endif
+#define MEMBARRIER_CMD_PRIVATE_EXPEDITED          (1 << 3)
+#define MEMBARRIER_CMD_REGISTER_PRIVATE_EXPEDITED (1 << 4)
+#endif
+
+/* Every processor that runs a thread of this process must go through a memory barrier before
+ * the call returns, so that a write made by any thread before it is seen by the others (the
+ * runtime's way of retiring a per-thread flag).  Linux has the membarrier system call for it;
+ * where the kernel lacks it, changing the protection of a page that was written makes the kernel
+ * interrupt those processors to flush their address translation, which is a barrier too. */
+static pthread_mutex_t flush_write_buffers_mutex = PTHREAD_MUTEX_INITIALIZER;
+static int flush_write_buffers_method;  /* 0: unknown, 1: membarrier, 2: protection change, -1: none */
+static void *flush_write_buffers_page;
+
+static void flush_write_buffers_init(void)
+{
+#if defined(__linux__) && defined(__NR_membarrier)
+    if (syscall( __NR_membarrier, MEMBARRIER_CMD_REGISTER_PRIVATE_EXPEDITED, 0, 0 ) == 0)
+    {
+        TRACE( "using membarrier\n" );
+        flush_write_buffers_method = 1;
+        return;
+    }
+#endif
+    flush_write_buffers_page = mmap( NULL, page_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0 );
+    if (flush_write_buffers_page != MAP_FAILED)
+    {
+        mlock( flush_write_buffers_page, page_size );
+        TRACE( "using page protection changes\n" );
+        flush_write_buffers_method = 2;
+        return;
+    }
+    flush_write_buffers_page = NULL;
+    flush_write_buffers_method = -1;
+}
+
+/**********************************************************************
+ *           NtFlushProcessWriteBuffers  (NTDLL.@)
+ */
 NTSTATUS WINAPI NtFlushProcessWriteBuffers(void)
 {
-    static int once = 0;
-    if (!once++) FIXME( "stub\n" );
+    static LONG calls;
+    int method, result = 0;
+
+    pthread_mutex_lock( &flush_write_buffers_mutex );
+    if (!flush_write_buffers_method) flush_write_buffers_init();
+    method = flush_write_buffers_method;
+
+    if (method == 2)
+    {
+        /* dirty the page, then drop and restore its protection */
+        *(volatile char *)flush_write_buffers_page = 1;
+        result = mprotect( flush_write_buffers_page, page_size, PROT_NONE );
+        result |= mprotect( flush_write_buffers_page, page_size, PROT_READ | PROT_WRITE );
+    }
+    pthread_mutex_unlock( &flush_write_buffers_mutex );
+
+#if defined(__linux__) && defined(__NR_membarrier)
+    if (method == 1)
+    {
+#ifdef SG_MUTANT_FLUSH_NOOP
+        result = -1;
+#else
+        result = syscall( __NR_membarrier, MEMBARRIER_CMD_PRIVATE_EXPEDITED, 0, 0 );
+#endif
+    }
+#endif
+    if (method < 0)
+    {
+        __sync_synchronize();
+        WARN( "no way to reach the other processors\n" );
+    }
+    if (InterlockedIncrement( &calls ) <= 3) TRACE( "flushed (method %d, result %d)\n", method, result );
     return STATUS_SUCCESS;
 }
 
