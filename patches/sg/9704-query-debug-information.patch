From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: RtlQueryProcessDebugInformation fills in modules, heaps and locks

CodeLite and WinMerge import RtlCreateQueryDebugBuffer/RtlQueryProcessDebugInformation; Wine gave
zeroed placeholders of a layout Windows never had. Now PDI_MODULES is an RTL_PROCESS_MODULES list,
PDI_HEAPS an RTL_PROCESS_HEAPS list with allocated/committed bytes and entry counts (PDI_HEAP_BLOCKS:
the blocks too), PDI_LOCKS an RTL_PROCESS_LOCKS list (empty: Wine keeps no list of critical sections).
Another process: its modules from its loader list; its heaps and locks need a thread inside it, as on
Windows -- STATUS_NOT_IMPLEMENTED. Gate: test/dbgbuf-gate.sh. Mutant: SG_MUTANT_DBGBUF_STUB.
---
--- a/dlls/ntdll/debugbuffer.c
+++ b/dlls/ntdll/debugbuffer.c
@@ -32,121 +32,359 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(debug_buffer);
 
-static void dump_DEBUG_MODULE_INFORMATION(const DEBUG_MODULE_INFORMATION *iBuf)
+/* Stained Glass OS (wine-sg 9704): RtlQueryProcessDebugInformation fills the debug buffer the way Windows
+ * does (undocumented; the layouts are the ones the Windows SDK-era headers and every native-API header set
+ * agree on): PDI_MODULES an RTL_PROCESS_MODULES list (the one NtQuerySystemInformation and
+ * LdrQueryProcessModuleInformation use), PDI_HEAPS an RTL_PROCESS_HEAPS list of the process's heaps with
+ * their allocated and committed bytes and entry counts, PDI_HEAP_BLOCKS each heap's blocks and regions too,
+ * PDI_LOCKS an RTL_PROCESS_LOCKS list. Wine's stub gave zeroed placeholder structures of the wrong layout.
+ * The information lives in memory of the buffer's own, freed by RtlDestroyQueryDebugBuffer (Windows puts it
+ * in the buffer's section). Another process: its modules are read from its loader list; its heaps and locks
+ * would need a thread run inside it (as Windows does), not done -- STATUS_NOT_IMPLEMENTED. Critical
+ * sections are not listed anywhere in Wine, so the lock list is empty. */
+
+typedef struct
+{
+    SIZE_T Size;
+    USHORT Flags;
+    USHORT AllocatorBackTraceIndex;
+    union
+    {
+        struct { SIZE_T Settable; ULONG Tag; } s1;
+        struct { SIZE_T CommittedSize; PVOID FirstBlock; } s2;
+    } u;
+} SG_RTL_HEAP_ENTRY;
+
+#define SG_RTL_HEAP_BUSY               0x0001
+#define SG_RTL_HEAP_SEGMENT            0x0002
+#define SG_RTL_HEAP_UNCOMMITTED_RANGE  0x0100
+
+typedef struct
+{
+    PVOID BaseAddress;
+    ULONG Flags;
+    USHORT EntryOverhead;
+    USHORT CreatorBackTraceIndex;
+    SIZE_T BytesAllocated;
+    SIZE_T BytesCommitted;
+    ULONG NumberOfTags;
+    ULONG NumberOfEntries;
+    ULONG NumberOfPseudoTags;
+    ULONG PseudoTagGranularity;
+    ULONG Reserved[5];
+    PVOID Tags;
+    SG_RTL_HEAP_ENTRY *Entries;
+} SG_RTL_HEAP_INFORMATION;
+
+typedef struct
+{
+    ULONG NumberOfHeaps;
+    SG_RTL_HEAP_INFORMATION Heaps[1];
+} SG_RTL_PROCESS_HEAPS;
+
+typedef struct
+{
+    PVOID Address;
+    USHORT Type;
+    USHORT CreatorBackTraceIndex;
+    HANDLE OwningThread;
+    LONG LockCount;
+    ULONG ContentionCount;
+    ULONG EntryCount;
+    LONG RecursionCount;
+    ULONG NumberOfWaitingShared;
+    ULONG NumberOfWaitingExclusive;
+} SG_RTL_PROCESS_LOCK_INFORMATION;
+
+typedef struct
+{
+    ULONG NumberOfLocks;
+    SG_RTL_PROCESS_LOCK_INFORMATION Locks[1];
+} SG_RTL_PROCESS_LOCKS;
+
+/* the RtlWalkHeap entry (heap.c) */
+struct walk_entry
+{
+    void *data;
+    SIZE_T size;
+    BYTE overhead;
+    BYTE region_index;
+    WORD flags;
+    union
+    {
+        struct { HANDLE mem; DWORD reserved[3]; } block;
+        struct { DWORD committed; DWORD uncommitted; void *first; void *last; } region;
+    };
+};
+#define WALK_BUSY    0x0001
+#define WALK_REGION  0x0002
+#define WALK_UNCOMMITTED 0x1000
+
+static void *dbg_alloc( SIZE_T size )
+{
+    void *ptr = NULL;
+    if (NtAllocateVirtualMemory( NtCurrentProcess(), &ptr, 0, &size, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE ))
+        return NULL;
+    return ptr;
+}
+
+static void dbg_free( void *ptr )
+{
+    SIZE_T size = 0;
+    if (ptr) NtFreeVirtualMemory( NtCurrentProcess(), &ptr, &size, MEM_RELEASE );
+}
+
+/***********************************************************************
+ *           RtlCreateQueryDebugBuffer   (NTDLL.@)
+ */
+PDEBUG_BUFFER WINAPI RtlCreateQueryDebugBuffer( ULONG size, BOOLEAN event_pair )
+{
+    DEBUG_BUFFER *buf;
+    SIZE_T alloc = max( size, sizeof(DEBUG_BUFFER) );
+
+    TRACE( "(%lu, %d)\n", size, event_pair );
+    if (!(buf = dbg_alloc( alloc ))) return NULL;
+    buf->SectionSize = alloc;
+    buf->AllocatedSize = alloc;
+    return buf;
+}
+
+/***********************************************************************
+ *           RtlDestroyQueryDebugBuffer   (NTDLL.@)
+ */
+NTSTATUS WINAPI RtlDestroyQueryDebugBuffer( PDEBUG_BUFFER buf )
+{
+    TRACE( "(%p)\n", buf );
+    if (!buf) return STATUS_SUCCESS;
+    dbg_free( buf->ModuleInformation );
+    dbg_free( buf->HeapInformation );
+    dbg_free( buf->LockInformation );
+    dbg_free( buf );
+    return STATUS_SUCCESS;
+}
+
+/* another process's modules, from its loader list */
+static NTSTATUS query_remote_modules( HANDLE process, RTL_PROCESS_MODULES **ret )
+{
+    PROCESS_BASIC_INFORMATION pbi;
+    PEB peb;
+    PEB_LDR_DATA ldr;
+    LDR_DATA_TABLE_ENTRY mod;
+    LIST_ENTRY *head, *entry;
+    RTL_PROCESS_MODULES *list;
+    ULONG count = 0, max = 0, i;
+    NTSTATUS status;
+
+    if ((status = NtQueryInformationProcess( process, ProcessBasicInformation, &pbi, sizeof(pbi), NULL ))) return status;
+    if ((status = NtReadVirtualMemory( process, pbi.PebBaseAddress, &peb, sizeof(peb), NULL ))) return status;
+    if ((status = NtReadVirtualMemory( process, peb.LdrData, &ldr, sizeof(ldr), NULL ))) return status;
+    head = &((PEB_LDR_DATA *)peb.LdrData)->InLoadOrderModuleList;
+    /* count first (bounded: a list that changes under us cannot loop forever) */
+    for (entry = ldr.InLoadOrderModuleList.Flink; entry != head && max < 4096; max++)
+    {
+        if (NtReadVirtualMemory( process, CONTAINING_RECORD( entry, LDR_DATA_TABLE_ENTRY, InLoadOrderLinks ),
+                                 &mod, sizeof(mod), NULL )) break;
+        entry = mod.InLoadOrderLinks.Flink;
+    }
+    if (!(list = dbg_alloc( offsetof( RTL_PROCESS_MODULES, Modules[max ? max : 1] ) ))) return STATUS_NO_MEMORY;
+    for (entry = ldr.InLoadOrderModuleList.Flink; entry != head && count < max; )
+    {
+        RTL_PROCESS_MODULE_INFORMATION *sm = &list->Modules[count];
+        WCHAR name[MAX_PATH];
+        UNICODE_STRING nameW;
+        ANSI_STRING str;
+        char *p;
+
+        if (NtReadVirtualMemory( process, CONTAINING_RECORD( entry, LDR_DATA_TABLE_ENTRY, InLoadOrderLinks ),
+                                 &mod, sizeof(mod), NULL )) break;
+        sm->MappedBaseAddress = sm->ImageBaseAddress = mod.DllBase;
+        sm->ImageSize = mod.SizeOfImage;
+        sm->Flags = mod.Flags;
+        sm->LoadOrderIndex = count;
+        sm->LoadCount = mod.LoadCount;
+        nameW.Length = min( mod.FullDllName.Length, sizeof(name) - sizeof(WCHAR) );
+        nameW.MaximumLength = sizeof(name);
+        nameW.Buffer = name;
+        if (NtReadVirtualMemory( process, mod.FullDllName.Buffer, name, nameW.Length, NULL )) nameW.Length = 0;
+        str.Length = 0;
+        str.MaximumLength = MAXIMUM_FILENAME_LENGTH;
+        str.Buffer = (char *)sm->Name;
+        RtlUnicodeStringToAnsiString( &str, &nameW, FALSE );
+        sm->Name[min( str.Length, MAXIMUM_FILENAME_LENGTH - 1 )] = 0;
+        p = strrchr( (char *)sm->Name, '\\' );
+        sm->NameOffset = p ? p - (char *)sm->Name + 1 : 0;
+        count++;
+        entry = mod.InLoadOrderLinks.Flink;
+    }
+    for (i = count; i < max; i++) memset( &list->Modules[i], 0, sizeof(list->Modules[i]) );
+    list->ModulesCount = count;
+    *ret = list;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS query_modules( RTL_PROCESS_MODULES **ret )
+{
+    RTL_PROCESS_MODULES *list;
+    ULONG size = 4096, needed;
+    NTSTATUS status;
+
+    for (;;)
+    {
+        if (!(list = dbg_alloc( size ))) return STATUS_NO_MEMORY;
+        status = LdrQueryProcessModuleInformation( list, size, &needed );
+        if (status != STATUS_INFO_LENGTH_MISMATCH) break;
+        dbg_free( list );
+        size = needed + 16 * sizeof(RTL_PROCESS_MODULE_INFORMATION);
+    }
+    if (status) { dbg_free( list ); return status; }
+    *ret = list;
+    return STATUS_SUCCESS;
+}
+
+static void walk_one_heap( HANDLE heap, SG_RTL_HEAP_INFORMATION *info, SG_RTL_HEAP_ENTRY *entries, ULONG max )
 {
-  TRACE( "MODULE_INFORMATION:%p\n", iBuf );
