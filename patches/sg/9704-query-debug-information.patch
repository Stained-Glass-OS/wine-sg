+    struct walk_entry e;
+
+    memset( &e, 0, sizeof(e) );
+    while (!RtlWalkHeap( heap, &e ))
+    {
+        if (e.flags & WALK_REGION)
+        {
+            info->BytesCommitted += e.region.committed;
+            if (entries && info->NumberOfEntries < max)
+            {
+                SG_RTL_HEAP_ENTRY *out = &entries[info->NumberOfEntries];
+                out->Size = e.size;
+                out->Flags = SG_RTL_HEAP_SEGMENT;
+                out->AllocatorBackTraceIndex = 0;
+                out->u.s2.CommittedSize = e.region.committed;
+                out->u.s2.FirstBlock = e.region.first;
+            }
+        }
+        else if (e.flags & WALK_UNCOMMITTED)
+        {
+            if (entries && info->NumberOfEntries < max)
+            {
+                SG_RTL_HEAP_ENTRY *out = &entries[info->NumberOfEntries];
+                memset( out, 0, sizeof(*out) );
+                out->Size = e.size;
+                out->Flags = SG_RTL_HEAP_UNCOMMITTED_RANGE;
+            }
+        }
+        else
+        {
+            if (e.flags & WALK_BUSY) info->BytesAllocated += e.size;
+            if (entries && info->NumberOfEntries < max)
+            {
+                SG_RTL_HEAP_ENTRY *out = &entries[info->NumberOfEntries];
+                memset( out, 0, sizeof(*out) );
+                out->Size = e.size;
+                out->Flags = (e.flags & WALK_BUSY) ? SG_RTL_HEAP_BUSY : 0;
+            }
+        }
+        info->NumberOfEntries++;
+    }
 }
 
-NTSTATUS WINAPI RtlQueryProcessDebugInformation(IN ULONG iProcessId, IN ULONG iDebugInfoMask, IN OUT PDEBUG_BUFFER iBuf) 
+static NTSTATUS query_heaps( ULONG mask, SG_RTL_PROCESS_HEAPS **ret )
+{
+    SG_RTL_PROCESS_HEAPS *list;
+    HANDLE *heaps = NULL;
+    ULONG count, alloc = 0, i;
+
+    for (;;)
+    {
+        count = RtlGetProcessHeaps( alloc, heaps );
+        if (count <= alloc) break;
+        dbg_free( heaps );
+        alloc = count + 8;
+        if (!(heaps = dbg_alloc( alloc * sizeof(HANDLE) ))) return STATUS_NO_MEMORY;
+    }
+    if (!(list = dbg_alloc( offsetof( SG_RTL_PROCESS_HEAPS, Heaps[count ? count : 1] ) )))
+    {
+        dbg_free( heaps );
+        return STATUS_NO_MEMORY;
+    }
+    list->NumberOfHeaps = count;
+    for (i = 0; i < count; i++)
+    {
+        SG_RTL_HEAP_INFORMATION *info = &list->Heaps[i];
+
+        info->BaseAddress = heaps[i];
+        info->EntryOverhead = 2 * sizeof(void *);
+        if (!RtlLockHeap( heaps[i] )) continue;
+        walk_one_heap( heaps[i], info, NULL, 0 );
+        if (mask & PDI_HEAP_BLOCKS)
+        {
+            ULONG max = info->NumberOfEntries;
+            if ((info->Entries = dbg_alloc( max * sizeof(SG_RTL_HEAP_ENTRY) + 1 )))
+            {
+                info->BytesAllocated = info->BytesCommitted = 0;
+                info->NumberOfEntries = 0;
+                walk_one_heap( heaps[i], info, info->Entries, max );
+                if (info->NumberOfEntries > max) info->NumberOfEntries = max;
+            }
+        }
+        RtlUnlockHeap( heaps[i] );
+    }
+    dbg_free( heaps );
+    *ret = list;
+    return STATUS_SUCCESS;
+}
