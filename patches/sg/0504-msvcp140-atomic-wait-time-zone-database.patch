+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <float.h>
+#include <stdint.h>
+#include "windef.h"
+#include "winbase.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msvcp);
+
+enum tzdb_error { tzdb_success = 0, tzdb_win_error = 1, tzdb_icu_error = 2 };
+
+struct tzdb_time_zones_info
+{
+    enum tzdb_error err;
+    const char *version;
+    size_t num_time_zones;
+    const char **names;
+    const char **links;
+};
+
+struct tzdb_current_zone_info
+{
+    enum tzdb_error err;
+    const char *tz_name;
+};
+
+struct tzdb_sys_info
+{
+    enum tzdb_error err;
+    double begin;           /* milliseconds since 1970, UTC */
+    double end;
+    INT32 offset;           /* milliseconds east of UTC */
+    INT32 save;             /* milliseconds of daylight saving */
+    const char *abbrev;
+};
+
+struct tzdb_leap_info
+{
+    UINT16 year, month, day, hour, negative, reserved;
+};
+
+#define ZONEINFO L"\\\\?\\unix\\usr\\share\\zoneinfo\\"
+
+/* a whole file of the system's zoneinfo; free() it */
+static char *read_zoneinfo(const WCHAR *name, DWORD *size)
+{
+    WCHAR path[MAX_PATH];
+    HANDLE file;
+    char *data = NULL;
+    DWORD len, got;
+
+    if (wcslen(ZONEINFO) + wcslen(name) >= MAX_PATH) return NULL;
+    wcscpy(path, ZONEINFO);
+    wcscat(path, name);
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    len = GetFileSize(file, NULL);
+    if (len != INVALID_FILE_SIZE && len < 64 * 1024 * 1024 && (data = malloc(len + 1)))
+    {
+        if (!ReadFile(file, data, len, &got, NULL) || got != len)
+        {
+            free(data);
+            data = NULL;
+        }
+        else
+        {
+            data[len] = 0;
+            *size = len;
+        }
+    }
+    CloseHandle(file);
+    return data;
+}
+
+/* ---- the names ---- */
+
+struct name_entry { const char *name, *link; };
+
+static int __cdecl compare_names(const void *a, const void *b)
+{
+    return strcmp(((const struct name_entry *)a)->name, ((const struct name_entry *)b)->name);
+}
+
+/* the next whitespace-separated word of a line, terminated in place */
+static char *next_word(char **p)
+{
+    char *w;
+
+    while (**p == ' ' || **p == '\t') (*p)++;
+    if (!**p || **p == '\n') return NULL;
+    w = *p;
+    while (**p && **p != ' ' && **p != '\t' && **p != '\n') (*p)++;
+    if (**p == ' ' || **p == '\t') *(*p)++ = 0;
+    return w;
+}
+
+struct tzdb_time_zones_info * __stdcall __std_tzdb_get_time_zones(void)
+{
+    struct tzdb_time_zones_info *info;
+    struct name_entry *entries = NULL, *grown;
+    size_t count = 0, max = 0, i;
+    DWORD size;
+    char *data, *line, *next;
+
+    TRACE("()\n");
+
+    if (!(info = calloc(1, sizeof(*info)))) return NULL;
+    if (!(data = read_zoneinfo(L"tzdata.zi", &size)))
+    {
+        WARN("no tzdata.zi\n");
+        info->err = tzdb_win_error;
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return info;
+    }
+    /* the block of text stays with the info: names point into it */
+    info->version = "";
+    for (line = data; *line; line = next)
+    {
+        char *p = line, *kind, *a, *b;
+
+        if ((next = strchr(line, '\n'))) *next++ = 0;
+        else next = line + strlen(line);
+
+        if (!strncmp(line, "# version ", 10))
+        {
+            info->version = line + 10;
+            continue;
+        }
+        if (!(kind = next_word(&p)) || kind[1]) continue;
+        if (kind[0] != 'Z' && kind[0] != 'L') continue;
+        if (!(a = next_word(&p))) continue;
+        b = kind[0] == 'L' ? next_word(&p) : NULL;
+        if (kind[0] == 'L' && !b) continue;
+        if (count == max)
+        {
+            max = max ? 2 * max : 512;
+            if (!(grown = realloc(entries, max * sizeof(*entries)))) break;
+            entries = grown;
+        }
+        /* a zone line names the zone; a link line names the target, then the link */
+        if (kind[0] == 'Z') entries[count].name = a, entries[count].link = NULL;
+        else entries[count].name = b, entries[count].link = a;
+        count++;
+    }
+    if (count) qsort(entries, count, sizeof(*entries), compare_names);
+
+    /* the names point into the text, which rides behind them: names[count] */
+    info->names = malloc((count + 1) * sizeof(*info->names));
+    info->links = malloc((count + 1) * sizeof(*info->links));
+    if (!info->names || !info->links)
+    {
+        free(info->names);
+        free(info->links);
+        free(entries);
+        free(data);
+        free(info);
+        return NULL;
+    }
+    for (i = 0; i < count; i++)
+    {
+        info->names[i] = entries[i].name;
+        info->links[i] = entries[i].link;
+    }
+    info->names[count] = data;
+    info->links[count] = NULL;
+    info->num_time_zones = count;
+    info->err = tzdb_success;
+    free(entries);
+    TRACE("%Iu zones and links, tzdata %s\n", info->num_time_zones, debugstr_a(info->version));
+    return info;
+}
+
+void __stdcall __std_tzdb_delete_time_zones(struct tzdb_time_zones_info *info)
+{
+    TRACE("(%p)\n", info);
+    if (!info) return;
+    if (info->names)
+    {
+        free((char *)info->names[info->num_time_zones]);
+        free(info->names);
+    }
+    free(info->links);
+    free(info);
+}
+
+/* ---- the current zone ---- */
+
+struct tzdb_current_zone_info * __stdcall __std_tzdb_get_current_zone(void)
+{
+    struct tzdb_current_zone_info *info;
+    HANDLE file;
+    char name[128], *p;
+    DWORD got = 0;
+
+    TRACE("()\n");
+
+    if (!(info = calloc(1, sizeof(*info) + sizeof(name)))) return NULL;
+    p = (char *)(info + 1);
+    /* the system's own setting: /etc/timezone holds the IANA name */
+    file = CreateFileW(L"\\\\?\\unix\\etc\\timezone", GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        if (!ReadFile(file, name, sizeof(name) - 1, &got, NULL)) got = 0;
+        CloseHandle(file);
+    }
+    name[got] = 0;
+    name[strcspn(name, "\r\n \t")] = 0;
+    strcpy(p, name[0] ? name : "Etc/UTC");
+    info->tz_name = p;
+    info->err = tzdb_success;
+    TRACE("%s\n", debugstr_a(p));
+    return info;
+}
+
+void __stdcall __std_tzdb_delete_current_zone(struct tzdb_current_zone_info *info)
+{
+    TRACE("(%p)\n", info);
+    free(info);
+}
+
+/* ---- a zone at an instant ---- */
+
+static INT64 be64(const unsigned char *p)
+{
+    return (INT64)(((UINT64)p[0] << 56) | ((UINT64)p[1] << 48) | ((UINT64)p[2] << 40) | ((UINT64)p[3] << 32) |
+                   ((UINT64)p[4] << 24) | ((UINT64)p[5] << 16) | ((UINT64)p[6] << 8) | p[7]);
+}
+
+static INT32 be32(const unsigned char *p)
+{
+    return (INT32)(((UINT32)p[0] << 24) | ((UINT32)p[1] << 16) | ((UINT32)p[2] << 8) | p[3]);
+}
+
+/* days since 1970-01-01 of a civil date */
+static INT64 days_from_civil(INT64 y, unsigned m, unsigned d)
+{
+    INT64 era;
+    unsigned yoe, doy, doe;
+
+    y -= m <= 2;
+    era = (y >= 0 ? y : y - 399) / 400;
+    yoe = (unsigned)(y - era * 400);
+    doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    return era * 146097 + (INT64)doe - 719468;
+}
+
+static INT64 year_of_seconds(INT64 t)
+{
+    INT64 z = (t >= 0 ? t / 86400 : (t - 86399) / 86400) + 719468, era, y;
+    unsigned doe, yoe, doy, mp;
+
+    era = (z >= 0 ? z : z - 146096) / 146097;
+    doe = (unsigned)(z - era * 146097);
+    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+    y = (INT64)yoe + era * 400;
+    doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    mp = (5 * doy + 2) / 153;
+    return y + (mp >= 10);
+}
+
+static BOOL is_leap(INT64 y)
+{
+    return !(y % 4) && ((y % 100) || !(y % 400));
+}
+
+/* a POSIX TZ rule, as a TZif file ends with ("EST5EDT,M3.2.0,M11.1.0") */
+struct posix_rule
+{
+    char kind;              /* 'M', 'J' (Jn, no Feb 29) or 'n' (zero-based day) */
+    int month, week, wday, day;
+    INT32 time;             /* seconds after local midnight */
+};
+
+struct posix_tz
+{
+    char std_name[16], dst_name[16];
+    INT32 std_off, dst_off; /* seconds east of UTC */
+    BOOL has_dst;
+    struct posix_rule start, end;
+};
+
+static const char *parse_tz_name(const char *p, char *out)
+{
+    size_t n = 0;
+
+    if (*p == '<')
+    {
+        for (p++; *p && *p != '>'; p++) if (n < 15) out[n++] = *p;
+        if (*p == '>') p++;
+    }
+    else
+        for (; *p && ((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z')); p++) if (n < 15) out[n++] = *p;
+    out[n] = 0;
+    return n ? p : NULL;
+}
+
+/* [+-]hh[:mm[:ss]], in seconds */
+static const char *parse_tz_time(const char *p, INT32 *secs)
+{
+    int sign = 1, h = 0, m = 0, s = 0;
+
+    if (*p == '+') p++;
+    else if (*p == '-') { sign = -1; p++; }
+    if (*p < '0' || *p > '9') return NULL;
+    while (*p >= '0' && *p <= '9') h = h * 10 + *p++ - '0';
+    if (*p == ':') { p++; while (*p >= '0' && *p <= '9') m = m * 10 + *p++ - '0'; }
+    if (*p == ':') { p++; while (*p >= '0' && *p <= '9') s = s * 10 + *p++ - '0'; }
+    *secs = sign * (h * 3600 + m * 60 + s);
+    return p;
+}
+
+static const char *parse_tz_rule(const char *p, struct posix_rule *rule)
+{
+    rule->time = 7200;
+    if (*p == 'M')
+    {
+        rule->kind = 'M';
+        rule->month = strtol(p + 1, (char **)&p, 10);
+        if (*p++ != '.') return NULL;
+        rule->week = strtol(p, (char **)&p, 10);
+        if (*p++ != '.') return NULL;
+        rule->wday = strtol(p, (char **)&p, 10);
+    }
+    else if (*p == 'J')
+    {
+        rule->kind = 'J';
+        rule->day = strtol(p + 1, (char **)&p, 10);
+    }
+    else if (*p >= '0' && *p <= '9')
+    {
+        rule->kind = 'n';
+        rule->day = strtol(p, (char **)&p, 10);
+    }
+    else return NULL;
+    if (*p == '/' && !(p = parse_tz_time(p + 1, &rule->time))) return NULL;
+    return p;
+}
+
+static BOOL parse_posix_tz(const char *p, struct posix_tz *tz)
+{
+    INT32 off;
+
+    memset(tz, 0, sizeof(*tz));
+    if (!(p = parse_tz_name(p, tz->std_name)) || !(p = parse_tz_time(p, &off))) return FALSE;
+    tz->std_off = -off;                 /* POSIX offsets are west of UTC */
+    if (!*p || *p == '\n') return TRUE;
+    if (!(p = parse_tz_name(p, tz->dst_name))) return FALSE;
+    tz->has_dst = TRUE;
+    tz->dst_off = tz->std_off + 3600;
+    if (*p && *p != ',')
+    {
+        if (!(p = parse_tz_time(p, &off))) return FALSE;
+        tz->dst_off = -off;
+    }
+    if (*p++ != ',' || !(p = parse_tz_rule(p, &tz->start))) return FALSE;
+    if (*p++ != ',' || !(p = parse_tz_rule(p, &tz->end))) return FALSE;
+    return TRUE;
+}
+
+/* the UTC second a rule takes effect in a year, given the offset in force before it */
+static INT64 rule_time(const struct posix_rule *rule, INT64 year, INT32 before_off)
+{
+    static const int mdays[12] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
+    INT64 day;
+
+    if (rule->kind == 'J')
+    {
+        day = days_from_civil(year, 1, 1) + rule->day - 1;
+        if (is_leap(year) && rule->day >= 60) day++;
+    }
+    else if (rule->kind == 'n')
+        day = days_from_civil(year, 1, 1) + rule->day;
+    else
+    {
+        INT64 first = days_from_civil(year, rule->month, 1);
+        int wday_first = (int)(((first % 7) + 7 + 4) % 7);   /* 1970-01-01 was a Thursday */
+        int d = (rule->wday - wday_first + 7) % 7;
+        int len = mdays[rule->month - 1] + (rule->month == 2 && is_leap(year));
+
+        d += (rule->week - 1) * 7;
+        if (rule->week == 5) while (d >= len) d -= 7;
+        day = first + d;
+    }
+    return day * 86400 + rule->time - before_off;
+}
+
+static char *dup_abbrev(const char *s)
+{
+    char *r = malloc(strlen(s) + 1);
+    if (r) strcpy(r, s);
+    return r;
+}
+
+/* the interval containing t under a POSIX rule; returns the abbreviation */
+static const char *posix_interval(const struct posix_tz *tz, INT64 t, INT64 *begin, INT64 *end, INT32 *off, BOOL *dst)
+{
+    INT64 y, s0, e0, s1, e1, sp, ep;
+
+    if (!tz->has_dst)
+    {
+        *begin = INT64_MIN;
+        *end = INT64_MAX;
+        *off = tz->std_off;
+        *dst = FALSE;
+        return tz->std_name;
+    }
+    y = year_of_seconds(t + tz->std_off);
+    sp = rule_time(&tz->start, y - 1, tz->std_off);
+    ep = rule_time(&tz->end, y - 1, tz->dst_off);
+    s0 = rule_time(&tz->start, y, tz->std_off);
+    e0 = rule_time(&tz->end, y, tz->dst_off);
+    s1 = rule_time(&tz->start, y + 1, tz->std_off);
+    e1 = rule_time(&tz->end, y + 1, tz->dst_off);
+    {
+        /* the year's transitions in order, with the previous and next years' around them */
+        INT64 times[6] = { sp, ep, s0, e0, s1, e1 };
+        BOOL isdst[6] = { TRUE, FALSE, TRUE, FALSE, TRUE, FALSE };
+        int i, j;
+
+        for (i = 0; i < 6; i++)
+            for (j = i + 1; j < 6; j++)
+                if (times[j] < times[i])
+                {
+                    INT64 tt = times[i]; BOOL td = isdst[i];
+                    times[i] = times[j]; isdst[i] = isdst[j];
+                    times[j] = tt; isdst[j] = td;
+                }
+        for (i = 5; i >= 0; i--)
+            if (times[i] <= t) break;
+        if (i < 0)
+        {
+            /* before the previous year's first change: a year earlier still */
+            return posix_interval(tz, t - 366 * 86400LL, begin, end, off, dst);
+        }
+        *begin = times[i];
+        *end = i < 5 ? times[i + 1] : INT64_MAX;
+        *dst = isdst[i];
+        *off = isdst[i] ? tz->dst_off : tz->std_off;
+        return isdst[i] ? tz->dst_name : tz->std_name;
+    }
+}
+
+static BOOL valid_zone_name(const char *name, size_t len)
+{
+    size_t i;
+
+    if (!len || len > 100 || name[0] == '/') return FALSE;
+    for (i = 0; i < len; i++)
+    {
+        char c = name[i];
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+              c == '_' || c == '-' || c == '+' || c == '/'))
+            return FALSE;
+        if (c == '.') return FALSE;
+    }
+    return TRUE;
+}
+
+struct tzdb_sys_info * __stdcall __std_tzdb_get_sys_info(const char *tz, size_t tz_len, double sys)
+{
+    struct tzdb_sys_info *info;
+    WCHAR wname[128];
+    unsigned char *data;
+    DWORD size;
+    INT64 t = (INT64)(sys >= 0 ? sys / 1000 : (sys - 999) / 1000);
+    INT64 begin = INT64_MIN, end = INT64_MAX;
+    INT32 off = 0, std_off = 0;
+    BOOL dst = FALSE, found = FALSE;
+    const char *abbrev = "";
+    char abbrev_buf[64] = "";
+    size_t i;
+
+    TRACE("(%s %f)\n", debugstr_an(tz, tz_len), sys);
+
+    if (!(info = calloc(1, sizeof(*info)))) return NULL;
+    if (!tz || !valid_zone_name(tz, tz_len))
+    {
+        info->err = tzdb_win_error;
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return info;
+    }
+    for (i = 0; i < tz_len; i++) wname[i] = tz[i] == '/' ? '\\' : tz[i];
+    wname[tz_len] = 0;
+    if (!(data = (unsigned char *)read_zoneinfo(wname, &size)) || size < 44 || memcmp(data, "TZif", 4))
+    {
+        free(data);
+        info->err = tzdb_win_error;
+        SetLastError(ERROR_NOT_FOUND);
+        return info;
+    }
+
+    {
+        const unsigned char *p = data, *limit = data + size;
+        UINT32 isut, isstd, leap, timecnt, typecnt, charcnt;
+        int width = 4;
+        const unsigned char *times, *idx, *types, *chars;
+
+        /* version 2 and later files repeat the data with 64-bit times: use that part */
+        isut = be32(p + 20); isstd = be32(p + 24); leap = be32(p + 28);
+        timecnt = be32(p + 32); typecnt = be32(p + 36); charcnt = be32(p + 40);
+        if (data[4] >= '2')
+        {
+            p += 44 + timecnt * 5 + typecnt * 6 + charcnt + leap * 8 + isstd + isut;
+            if (p + 44 > limit || memcmp(p, "TZif", 4)) goto bad;
+            isut = be32(p + 20); isstd = be32(p + 24); leap = be32(p + 28);
+            timecnt = be32(p + 32); typecnt = be32(p + 36); charcnt = be32(p + 40);
+            width = 8;
+        }
+        times = p + 44;
+        idx = times + timecnt * width;
+        types = idx + timecnt;
+        chars = types + typecnt * 6;
+        if (!typecnt || chars + charcnt > limit) goto bad;
+
+        {
+            /* the interval: the last transition at or before t */
+            INT64 lo = 0, hi = timecnt;
+            UINT32 type;
+
+            while (lo < hi)
+            {
+                INT64 mid = (lo + hi) / 2;
+                INT64 tt = width == 8 ? be64(times + mid * 8) : be32(times + mid * 4);
+                if (tt <= t) lo = mid + 1;
+                else hi = mid;
+            }
+            if (lo == 0)
+            {
+                /* before the first transition: the first standard type, or the first */
+                for (type = 0; type < typecnt && types[type * 6 + 4]; type++) ;
+                if (type == typecnt) type = 0;
+                end = timecnt ? (width == 8 ? be64(times) : be32(times)) : INT64_MAX;
+            }
+            else
+            {
+                type = idx[lo - 1];
+                begin = width == 8 ? be64(times + (lo - 1) * 8) : be32(times + (lo - 1) * 4);
+                if (lo < timecnt) end = width == 8 ? be64(times + lo * 8) : be32(times + lo * 4);
+            }
+            if (type >= typecnt) goto bad;
+            off = be32(types + type * 6);
+            dst = types[type * 6 + 4];
+            if (types[type * 6 + 5] < charcnt)
+                lstrcpynA(abbrev_buf, (const char *)chars + types[type * 6 + 5], sizeof(abbrev_buf));
+            abbrev = abbrev_buf;
+            found = TRUE;
+
+            /* daylight saving's size: against the standard offset in force before it */
+            std_off = off;
+            if (dst)
+            {
+                INT64 k;
+                for (k = lo - 2; k >= 0; k--)
+                {
+                    UINT32 ty = idx[k];
+                    if (ty < typecnt && !types[ty * 6 + 4]) { std_off = be32(types + ty * 6); break; }
+                }
+                if (k < 0) std_off = off - 3600;
+            }
+
+            /* past the last transition: the rule the file ends with */
+            if (lo == timecnt && width == 8)
+            {
+                const unsigned char *footer = chars + charcnt + leap * 12 + isstd + isut;
+                struct posix_tz ptz;
+                char rule[128];
+                size_t n = 0;
+
+                if (footer < limit && *footer == '\n')
+                {
+                    for (footer++; footer < limit && *footer != '\n' && n < sizeof(rule) - 1; footer++) rule[n++] = *footer;
+                    rule[n] = 0;
+                    if (n && parse_posix_tz(rule, &ptz))
+                    {
+                        INT64 rb, re;
+                        abbrev = posix_interval(&ptz, t, &rb, &re, &off, &dst);
+                        lstrcpynA(abbrev_buf, abbrev, sizeof(abbrev_buf));
+                        abbrev = abbrev_buf;
+                        std_off = ptz.std_off;
+                        if (rb > begin) begin = rb;
+                        end = re;
+                    }
+                }
+            }
+        }
+    }
+bad:
+    free(data);
+    if (!found)
+    {
+        info->err = tzdb_win_error;
+        SetLastError(ERROR_INVALID_DATA);
+        return info;
+    }
+    info->err = tzdb_success;
+    info->begin = begin == INT64_MIN ? -DBL_MAX : (double)begin * 1000;
+    info->end = end == INT64_MAX ? DBL_MAX : (double)end * 1000;
+    info->offset = off * 1000;
+    info->save = dst ? (off - std_off) * 1000 : 0;
+    info->abbrev = dup_abbrev(abbrev);
+    TRACE("offset %d save %d abbrev %s\n", info->offset, info->save, debugstr_a(info->abbrev));
+    return info;
+}
+
+void __stdcall __std_tzdb_delete_sys_info(struct tzdb_sys_info *info)
+{
+    TRACE("(%p)\n", info);
+    if (!info) return;
+    free((char *)info->abbrev);
+    free(info);
+}
+
+/* Leap seconds after 2018: Windows keeps any in the registry; none have
+ * been announced since 2016, and the library knows those already. */
+struct tzdb_leap_info * __stdcall __std_tzdb_get_leap_seconds(size_t prev_size, size_t *current_size)
+{
+    TRACE("(%Iu %p)\n", prev_size, current_size);
+    if (current_size) *current_size = 0;
+    return NULL;
+}
+
+void __stdcall __std_tzdb_delete_leap_seconds(struct tzdb_leap_info *info)
+{
+    TRACE("(%p)\n", info);
+    free(info);
+}
