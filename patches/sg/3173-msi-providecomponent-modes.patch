From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 07:58:37 -0700
Subject: [PATCH] msi: MsiProvideComponent install modes, registry key paths,
 MsiInstallMissingComponent, MsiRemovePatches checks

MsiProvideComponent handles EXISTING (key file must exist), DEFAULT (install on demand for an advertised
feature, reinstall when the key file is gone), NOSOURCERESOLUTION, NODETECTION_ANY and the REINSTALLMODE
flags; unknown modes are refused. MsiGetComponentPath now checks registry key paths ("01:\Key\Name").
MsiInstallMissingComponent finds the feature that owns the component and configures it. MsiRemovePatches
validates its arguments and the product and patches (documented error codes) and reports that removal is
not supported instead of claiming success.

diff --git a/dlls/msi/msi.c b/dlls/msi/msi.c
index 556daaa..67d0b6f 100644
--- a/dlls/msi/msi.c
+++ b/dlls/msi/msi.c
@@ -2933,6 +2933,53 @@ static BOOL open_userdata_comp_key( const WCHAR *comp, const WCHAR *usersid, MSI
     return FALSE;
 }
 
+/* a component key path is a file path, or a registry path "NN:\key\name" (NN: 00 HKCR, 01 HKCU,
+ * 02 HKLM, 03 HKU; 20..23 the 64-bit view) with a trailing backslash when it names a key */
+static BOOL msi_keypath_exists( const WCHAR *path )
+{
+    REGSAM sam = KEY_READ;
+    HKEY root, key;
+    WCHAR *copy, *name;
+    BOOL ret = FALSE;
+    int idx, len;
+
+    if (!path) return FALSE;
+#ifndef SG_MUTANT_MSI_NOREGKEY
+    if (path[0] >= '0' && path[0] <= '9' && path[1] >= '0' && path[1] <= '9' && path[2] == ':' && path[3] == '\\')
+    {
+        idx = (path[0] - '0') * 10 + path[1] - '0';
+        if (idx >= 20) { sam |= KEY_WOW64_64KEY; idx -= 20; }
+        switch (idx)
+        {
+        case 0: root = HKEY_CLASSES_ROOT; break;
+        case 1: root = HKEY_CURRENT_USER; break;
+        case 2: root = HKEY_LOCAL_MACHINE; break;
+        case 3: root = HKEY_USERS; break;
+        default: return FALSE;
+        }
+        if (!(copy = wcsdup( path + 4 ))) return FALSE;
+        len = lstrlenW( copy );
+        if (len && copy[len - 1] == '\\')
+        {
+            copy[len - 1] = 0;
+            if (!RegOpenKeyExW( root, copy, 0, sam, &key )) { RegCloseKey( key ); ret = TRUE; }
+        }
+        else if ((name = wcsrchr( copy, '\\' )))
+        {
+            *name++ = 0;
+            if (!RegOpenKeyExW( root, copy, 0, sam, &key ))
+            {
+                ret = !RegQueryValueExW( key, name, NULL, NULL, NULL, NULL );
+                RegCloseKey( key );
+            }
+        }
+        free( copy );
+        return ret;
+    }
+#endif
+    return GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES;
+}
+
 static INSTALLSTATE MSI_GetComponentPath( const WCHAR *szProduct, const WCHAR *szComponent,
                                           const WCHAR *szUserSid, MSIINSTALLCONTEXT ctx,
                                           awstring *lpPathBuf, DWORD *pcchBuf, BOOL report_size )
@@ -2976,7 +3023,7 @@ static INSTALLSTATE MSI_GetComponentPath( const WCHAR *szProduct, const WCHAR *s
         if ((!MSIREG_OpenInstallProps(szProduct, MSIINSTALLCONTEXT_MACHINE, NULL, &hkey, FALSE) ||
              !MSIREG_OpenUserDataProductKey(szProduct, MSIINSTALLCONTEXT_USERUNMANAGED, NULL, &hkey, FALSE)) &&
             msi_reg_get_val_dword(hkey, L"WindowsInstaller", &version) &&
-            GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES)
+            msi_keypath_exists(path))
         {
             RegCloseKey(hkey);
             state = INSTALLSTATE_LOCAL;
@@ -2997,7 +3044,7 @@ static INSTALLSTATE MSI_GetComponentPath( const WCHAR *szProduct, const WCHAR *s
 
             state = INSTALLSTATE_ABSENT;
 
-            if (GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES)
+            if (msi_keypath_exists(path))
                 state = INSTALLSTATE_LOCAL;
         }
     }
@@ -4474,10 +4521,57 @@ UINT WINAPI MsiInstallMissingComponentA( LPCSTR product, LPCSTR component, INSTA
 /***********************************************************************
  * MsiInstallMissingComponentW     [MSI.@]
  */
+static UINT find_component_feature( const WCHAR *product, const WCHAR *component, WCHAR *feature, DWORD len )
+{
+    MSIINSTALLCONTEXT ctx;
+    WCHAR packed[BASE85_SIZE + 1], name[MAX_FEATURE_CHARS + 1];
+    GUID guid;
+    HKEY key;
+    DWORD i;
+    UINT r;
+
+    if (CLSIDFromString( component, &guid ) || !encode_base85_guid( &guid, packed )) return ERROR_INVALID_PARAMETER;
+    if ((r = msi_locate_product( product, &ctx ))) return ERROR_UNKNOWN_PRODUCT;
+    if (MSIREG_OpenUserDataFeaturesKey( product, NULL, ctx, &key, FALSE )) return ERROR_BAD_CONFIGURATION;
+
+    r = ERROR_UNKNOWN_COMPONENT;
+    for (i = 0; r == ERROR_UNKNOWN_COMPONENT; i++)
+    {
+        DWORD namelen = ARRAY_SIZE(name);
+        WCHAR *list, *p;
+        if (RegEnumValueW( key, i, name, &namelen, NULL, NULL, NULL, NULL )) break;
+        if (!(list = reg_get_sz( key, name ))) continue;
+        for (p = list; lstrlenW( p ) >= BASE85_SIZE; p += BASE85_SIZE)
+        {
+            if (!wcsncmp( p, packed, BASE85_SIZE ))
+            {
+                if (wcslen( name ) < len) { wcscpy( feature, name ); r = ERROR_SUCCESS; }
+                break;
+            }
+        }
+        free( list );
+    }
+    RegCloseKey( key );
+    return r;
+}
+
 UINT WINAPI MsiInstallMissingComponentW(LPCWSTR szProduct, LPCWSTR szComponent, INSTALLSTATE eInstallState)
 {
-    FIXME("(%s %s %d\n", debugstr_w(szProduct), debugstr_w(szComponent), eInstallState);
-    return ERROR_SUCCESS;
+    WCHAR feature[MAX_FEATURE_CHARS + 1];
+    UINT r;
+
+    TRACE("(%s %s %d)\n", debugstr_w(szProduct), debugstr_w(szComponent), eInstallState);
+
+    if (!szProduct || !szComponent) return ERROR_INVALID_PARAMETER;
+    if (eInstallState != INSTALLSTATE_LOCAL && eInstallState != INSTALLSTATE_SOURCE &&
+        eInstallState != INSTALLSTATE_DEFAULT)
+        return ERROR_INVALID_PARAMETER;
+
+    /* the feature that owns the component is installed (documented: the one needing the least
+     * additional space; the first owner is used) */
+    if ((r = find_component_feature( szProduct, szComponent, feature, ARRAY_SIZE(feature) )))
+        return r;
+    return MsiConfigureFeatureW( szProduct, feature, eInstallState );
 }
 
 UINT WINAPI MsiProvideComponentA( const char *product, const char *feature, const char *component, DWORD mode,
@@ -4541,11 +4635,61 @@ UINT WINAPI MsiProvideComponentW( const WCHAR *product, const WCHAR *feature, co
     switch (mode)
     {
     case INSTALLMODE_NODETECTION:
+    case INSTALLMODE_NODETECTION_ANY:
+        break;
+
+    case INSTALLMODE_NOSOURCERESOLUTION:
+        if (state == INSTALLSTATE_SOURCE) return ERROR_INSTALL_SOURCE_ABSENT;
+        if (state != INSTALLSTATE_LOCAL) return ERROR_FILE_NOT_FOUND;
+        break;
+
+    case INSTALLMODE_EXISTING:
+    {
+        INSTALLSTATE cstate;
+        DWORD len = 0;
+
+        if (state != INSTALLSTATE_LOCAL && state != INSTALLSTATE_SOURCE) return ERROR_FILE_NOT_FOUND;
+        /* verifies that the key file exists */
+        cstate = MsiGetComponentPathW( product, component, NULL, &len );
+        if (cstate != INSTALLSTATE_LOCAL && cstate != INSTALLSTATE_SOURCE && cstate != INSTALLSTATE_MOREDATA)
+            return ERROR_FILE_NOT_FOUND;
+        break;
+    }
+
+    case INSTALLMODE_DEFAULT:
+    {
+        INSTALLSTATE cstate;
+        DWORD len = 0;
+        UINT r;
+
+        if (state == INSTALLSTATE_ADVERTISED)
+        {
+            if ((r = MsiConfigureFeatureW( product, feature, INSTALLSTATE_DEFAULT ))) return r;
+            break;
+        }
+        if (state != INSTALLSTATE_LOCAL && state != INSTALLSTATE_SOURCE) break;
+        cstate = MsiGetComponentPathW( product, component, NULL, &len );
+        if (cstate != INSTALLSTATE_LOCAL && cstate != INSTALLSTATE_SOURCE && cstate != INSTALLSTATE_MOREDATA)
+        {
+            /* the key file is missing: reinstall the feature */
+#ifndef SG_MUTANT_MSI_NOREINSTALL
+            r = MsiReinstallFeatureW( product, feature, REINSTALLMODE_FILEMISSING | REINSTALLMODE_FILEOLDERVERSION |
+                                      REINSTALLMODE_FILEVERIFY | REINSTALLMODE_MACHINEDATA |
+                                      REINSTALLMODE_USERDATA | REINSTALLMODE_SHORTCUT );
+            if (r) return r;
+#endif
+        }
         break;
+    }
 
     default:
-        FIXME( "mode %#lx not implemented\n", mode );
-        return ERROR_INSTALL_FAILURE;
+        if (mode > 0 && (mode & ~0x7ff) == 0)       /* a combination of the REINSTALLMODE flags */
+        {
+            UINT r = MsiReinstallFeatureW( product, feature, mode );
+            if (r) return r;
+            break;
+        }
+        return ERROR_INVALID_PARAMETER;
     }
 
     state = MsiGetComponentPathW( product, component, buf, buflen );
@@ -4558,6 +4702,14 @@ UINT WINAPI MsiProvideComponentW( const WCHAR *product, const WCHAR *feature, co
     case INSTALLSTATE_MOREDATA:
         return ERROR_MORE_DATA;
 
+    case INSTALLSTATE_ABSENT:
+        /* registered, but the key file is not there: only these modes do not look at it */
+        if (mode != INSTALLMODE_NODETECTION && mode != INSTALLMODE_NODETECTION_ANY &&
+            mode != INSTALLMODE_NOSOURCERESOLUTION)
+            return ERROR_INSTALL_FAILURE;
+        MsiUseFeatureW( product, feature );
+        return ERROR_SUCCESS;
+
     case INSTALLSTATE_ADVERTISED:
     case INSTALLSTATE_LOCAL:
     case INSTALLSTATE_SOURCE:
@@ -4697,10 +4849,24 @@ UINT WINAPI Migrate10CachedPackagesW( void *a, void *b, void *c, DWORD d )
 /***********************************************************************
  * MsiRemovePatchesA     [MSI.@]
  */
+UINT WINAPI MsiRemovePatchesW(LPCWSTR patchlist, LPCWSTR product, INSTALLTYPE type, LPCWSTR propertylist);
+
 UINT WINAPI MsiRemovePatchesA(LPCSTR patchlist, LPCSTR product, INSTALLTYPE type, LPCSTR propertylist)
 {
-    FIXME("(%s %s %d %s\n", debugstr_a(patchlist), debugstr_a(product), type, debugstr_a(propertylist));
-    return ERROR_SUCCESS;
+    WCHAR *patches = NULL, *productW = NULL, *props = NULL;
+    UINT r = ERROR_OUTOFMEMORY;
+
+    TRACE("(%s %s %d %s)\n", debugstr_a(patchlist), debugstr_a(product), type, debugstr_a(propertylist));
+
+    if (patchlist && !(patches = strdupAtoW( patchlist ))) goto done;
+    if (product && !(productW = strdupAtoW( product ))) goto done;
+    if (propertylist && !(props = strdupAtoW( propertylist ))) goto done;
+    r = MsiRemovePatchesW( patches, productW, type, props );
+done:
+    free( patches );
+    free( productW );
+    free( props );
+    return r;
 }
 
 /***********************************************************************
@@ -4708,6 +4874,41 @@ UINT WINAPI MsiRemovePatchesA(LPCSTR patchlist, LPCSTR product, INSTALLTYPE type
  */
 UINT WINAPI MsiRemovePatchesW(LPCWSTR patchlist, LPCWSTR product, INSTALLTYPE type, LPCWSTR propertylist)
 {
-    FIXME("(%s %s %d %s\n", debugstr_w(patchlist), debugstr_w(product), type, debugstr_w(propertylist));
-    return ERROR_SUCCESS;
+    MSIINSTALLCONTEXT context;
+    WCHAR *list, *p, *next;
+    UINT r;
+
+    TRACE("(%s %s %d %s)\n", debugstr_w(patchlist), debugstr_w(product), type, debugstr_w(propertylist));
+
+    if (!patchlist || !*patchlist || !product || type != INSTALLTYPE_SINGLE_INSTANCE) return ERROR_INVALID_PARAMETER;
+    if ((r = msi_locate_product( product, &context ))) return ERROR_UNKNOWN_PRODUCT;
+
+    if (!(list = wcsdup( patchlist ))) return ERROR_OUTOFMEMORY;
+    r = ERROR_SUCCESS;
+    for (p = list; p && *p && !r; p = next)
+    {
+        GUID guid;
+        WCHAR code[GUID_SIZE], *end;
+
+        if ((next = wcschr( p, ';' ))) *next++ = 0;
+        if (!*p) continue;
+        if (*p == '{' && !CLSIDFromString( p, &guid ))
+        {
+            DWORD len = ARRAY_SIZE(code);
+            /* the patch must have been applied to this product */
+            if (MsiGetPatchInfoExW( p, product, NULL, context, INSTALLPROPERTY_LOCALPACKAGEW, code, &len ))
+                r = ERROR_UNKNOWN_PATCH;
+        }
+        else
+        {
+            end = p + lstrlenW( p );
+            if (end == p || GetFileAttributesW( p ) == INVALID_FILE_ATTRIBUTES) r = ERROR_PATCH_PACKAGE_OPEN_FAILED;
+        }
+    }
+    free( list );
+    if (r) return r;
+
+    /* removing a patch means rebuilding the files it replaced, which is not implemented */
+    FIXME("patch removal is not supported\n");
+    return ERROR_PATCH_REMOVAL_UNSUPPORTED;
 }
