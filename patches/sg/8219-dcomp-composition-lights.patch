 COMPOSITOR2_NOT_MADE( CreateAnimationGroup )
 #else
@@ -5006,7 +5005,25 @@
     return animation_group_create( impl_from_compositor2( iface ), out );
 }
 #endif
+#ifdef SG_MUTANT_NO_LIGHTS
+COMPOSITOR2_NOT_MADE( CreateAmbientLight )
 COMPOSITOR2_NOT_MADE( CreateDistantLight )
+COMPOSITOR2_NOT_MADE( CreatePointLight )
+COMPOSITOR2_NOT_MADE( CreateSpotLight )
+#else
