+static const GUID IID_ICompositionLight2_sg = { 0xa7bcda72, 0xf35d, 0x425d, { 0x9b, 0x98, 0x23, 0xf4, 0x20, 0x5f, 0x66, 0x69 } };
+static const GUID IID_ICompositionLight3_sg = { 0x4b0b00e4, 0xdf07, 0x4959, { 0xb7, 0xa4, 0x4f, 0x7e, 0x42, 0x33, 0xf8, 0x38 } };
+static const GUID IID_IVisualUnorderedCollection_sg = { 0x338faa70, 0x54c8, 0x40a7, { 0x80, 0x29, 0xc9, 0xce, 0xeb, 0x0a, 0xa2, 0x50 } };
+
+static HRESULT class_name( const WCHAR *name, HSTRING *out )
+{
+    if (!out) return E_POINTER;
+    return WindowsCreateString( name, wcslen( name ), out );
+}
+
+static HRESULT iid_list( ULONG *iid_count, IID **iids, const IID *const *list, ULONG count )
+{
+    ULONG i;
+
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( count * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++) (*iids)[i] = *list[i];
+    *iid_count = count;
+    return S_OK;
+}
+
+/* the IInspectable part of an interface known by its vtable layout, forwarded to the object's primary one */
+#define VOID_IFACE( pfx, impl_type, field, base )                                                  \
+    static impl_type *pfx##_impl( void *iface ) { return CONTAINING_RECORD( iface, impl_type, field ); } \
+    static HRESULT WINAPI pfx##_QueryInterface( void *iface, REFIID iid, void **out )               \
+    { return base##_QueryInterface( &pfx##_impl( iface )->primary, iid, out ); }                     \
+    static ULONG WINAPI pfx##_AddRef( void *iface ) { return base##_AddRef( &pfx##_impl( iface )->primary ); } \
+    static ULONG WINAPI pfx##_Release( void *iface ) { return base##_Release( &pfx##_impl( iface )->primary ); } \
+    static HRESULT WINAPI pfx##_GetIids( void *iface, ULONG *count, IID **iids )                   \
+    { return base##_GetIids( &pfx##_impl( iface )->primary, count, iids ); }                         \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( void *iface, HSTRING *name )                  \
+    { return base##_GetRuntimeClassName( &pfx##_impl( iface )->primary, name ); }                    \
+    static HRESULT WINAPI pfx##_GetTrustLevel( void *iface, TrustLevel *level )                    \
+    { *level = BaseTrust; return S_OK; }
+
+#define VOID_IFACE_ENTRIES( pfx ) \
+    pfx##_QueryInterface, pfx##_AddRef, pfx##_Release, pfx##_GetIids, pfx##_GetRuntimeClassName, pfx##_GetTrustLevel
+
+/***********************************************************************
+ *          VisualUnorderedCollection
+ */
+
+struct visual_set
+{
+    struct { const void * const *vtbl; } primary;    /* IVisualUnorderedCollection */
+    IIterable_Visual IIterable_Visual_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    IInspectable ICompositionObject4_iface;
+    LONG ref;
+    struct compositor *compositor;
+    IVisual **items;
+    UINT count, size;
+    ICompositionPropertySet *properties;
+};
+
+struct visual_iterator
+{
+    IIterator_Visual IIterator_Visual_iface;
+    LONG ref;
+    IVisual **items;        /* a snapshot, referenced */
+    UINT count, index;
+};
+
+static struct visual_set *impl_from_set( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct visual_set, primary );
+}
+
+static HRESULT WINAPI set_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    struct visual_set *impl = impl_from_set( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IVisualUnorderedCollection_sg ))
+        *out = &impl->primary;
+    else if (IsEqualGUID( iid, &IID_IIterable_Visual ))
+        *out = &impl->IIterable_Visual_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject4_x ))
+        *out = &impl->ICompositionObject4_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI set_AddRef( void *iface )
+{
+    return InterlockedIncrement( &impl_from_set( iface )->ref );
+}
+
+static ULONG WINAPI set_Release( void *iface )
+{
+    struct visual_set *impl = impl_from_set( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++) IVisual_Release( impl->items[i] );
+        free( impl->items );
+        ICompositor_Release( (ICompositor *)impl->compositor );
+        object_release_properties( impl->properties );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI set_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    const IID *list[] = { &IID_IVisualUnorderedCollection_sg, &IID_IIterable_Visual, &IID_ICompositionObject, &IID_IClosable };
+    return iid_list( count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI set_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return class_name( L"Windows.UI.Composition.VisualUnorderedCollection", name );
+}
+
+static HRESULT WINAPI set_GetTrustLevel( void *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI set_get_Count( void *iface, INT32 *value )
+{
+    struct visual_set *impl = impl_from_set( iface );
+    if (!value) return E_POINTER;
+    compositor_lock( impl->compositor );
+    *value = impl->count;
+    compositor_unlock( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI set_Add( void *iface, IVisual *value )
+{
+    struct visual_set *impl = impl_from_set( iface );
+    IVisual *visual, **items;
+    UINT i;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value || FAILED(IVisual_QueryInterface( value, &IID_IVisual, (void **)&visual ))) return E_INVALIDARG;
+    compositor_lock( impl->compositor );
+    for (i = 0; i < impl->count; i++) if (impl->items[i] == visual) break;
+    if (i < impl->count)  /* an unordered set: once */
+    {
+        compositor_unlock( impl->compositor );
+        IVisual_Release( visual );
+        return S_OK;
+    }
+    if (impl->count == impl->size)
+    {
+        UINT size = max( 4, impl->size * 2 );
+        if (!(items = realloc( impl->items, size * sizeof(*items) )))
+        {
+            compositor_unlock( impl->compositor );
+            IVisual_Release( visual );
+            return E_OUTOFMEMORY;
+        }
+        impl->items = items;
+        impl->size = size;
+    }
+    impl->items[impl->count++] = visual;
+    compositor_unlock( impl->compositor );
+    compositor_changed( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI set_Remove( void *iface, IVisual *value )
+{
+    struct visual_set *impl = impl_from_set( iface );
+    IVisual *visual, *removed = NULL;
+    UINT i;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value || FAILED(IVisual_QueryInterface( value, &IID_IVisual, (void **)&visual ))) return E_INVALIDARG;
+    compositor_lock( impl->compositor );
+    for (i = 0; i < impl->count; i++)
+    {
+        if (impl->items[i] != visual) continue;
+        removed = impl->items[i];
+        memmove( impl->items + i, impl->items + i + 1, (impl->count - i - 1) * sizeof(*impl->items) );
+        impl->count--;
+        break;
+    }
+    compositor_unlock( impl->compositor );
+    IVisual_Release( visual );
+    if (removed)
+    {
+        IVisual_Release( removed );
+        compositor_changed( impl->compositor );
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI set_RemoveAll( void *iface )
+{
+    struct visual_set *impl = impl_from_set( iface );
+    IVisual **items;
+    UINT i, count;
+
+    compositor_lock( impl->compositor );
+    items = impl->items;
+    count = impl->count;
+    impl->items = NULL;
+    impl->count = impl->size = 0;
+    compositor_unlock( impl->compositor );
+    for (i = 0; i < count; i++) IVisual_Release( items[i] );
+    free( items );
+    compositor_changed( impl->compositor );
+    return S_OK;
+}
+
+static const void * const set_vtbl[] =
+{
+    set_QueryInterface, set_AddRef, set_Release, set_GetIids, set_GetRuntimeClassName, set_GetTrustLevel,
+    set_get_Count, set_Add, set_Remove, set_RemoveAll,
+};
+
+static struct visual_iterator *impl_from_IIterator_Visual( IIterator_Visual *iface )
+{
+    return CONTAINING_RECORD( iface, struct visual_iterator, IIterator_Visual_iface );
+}
+
+static HRESULT WINAPI viter_QueryInterface( IIterator_Visual *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IIterator_Visual ))
+    {
+        *out = iface;
+        IInspectable_AddRef( (IInspectable *)iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI viter_AddRef( IIterator_Visual *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterator_Visual( iface )->ref );
+}
+
+static ULONG WINAPI viter_Release( IIterator_Visual *iface )
+{
+    struct visual_iterator *impl = impl_from_IIterator_Visual( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++) IVisual_Release( impl->items[i] );
+        free( impl->items );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI viter_GetIids( IIterator_Visual *iface, ULONG *count, IID **iids )
+{
+    const IID *list[] = { &IID_IIterator_Visual };
+    return iid_list( count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI viter_GetRuntimeClassName( IIterator_Visual *iface, HSTRING *name )
+{
+    return class_name( L"Windows.Foundation.Collections.IIterator`1<Windows.UI.Composition.Visual>", name );
+}
+
+static HRESULT WINAPI viter_GetTrustLevel( IIterator_Visual *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI viter_get_Current( IIterator_Visual *iface, IVisual **value )
+{
+    struct visual_iterator *impl = impl_from_IIterator_Visual( iface );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (impl->index >= impl->count) return E_BOUNDS;
+    IVisual_AddRef( (*value = impl->items[impl->index]) );
+    return S_OK;
+}
+
+static HRESULT WINAPI viter_get_HasCurrent( IIterator_Visual *iface, boolean *value )
+{
+    struct visual_iterator *impl = impl_from_IIterator_Visual( iface );
+    if (!value) return E_POINTER;
+    *value = impl->index < impl->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI viter_MoveNext( IIterator_Visual *iface, boolean *value )
+{
+    struct visual_iterator *impl = impl_from_IIterator_Visual( iface );
+    if (impl->index < impl->count) impl->index++;
+    if (value) *value = impl->index < impl->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI viter_GetMany( IIterator_Visual *iface, UINT32 size, IVisual **items, UINT32 *count )
+{
+    struct visual_iterator *impl = impl_from_IIterator_Visual( iface );
+    UINT32 n = 0;
+
+    if (!count || (size && !items)) return E_POINTER;
+    while (n < size && impl->index < impl->count)
+        IVisual_AddRef( (items[n++] = impl->items[impl->index++]) );
+    *count = n;
+    return S_OK;
+}
+
+static const struct IIterator_VisualVtbl viter_vtbl =
+{
+    viter_QueryInterface, viter_AddRef, viter_Release, viter_GetIids, viter_GetRuntimeClassName, viter_GetTrustLevel,
+    viter_get_Current, viter_get_HasCurrent, viter_MoveNext, viter_GetMany,
+};
+
+DEFINE_IINSPECTABLE_( set_iterable, IIterable_Visual, struct visual_set, set_impl_from_iterable,
+                      IIterable_Visual_iface, &impl->primary )
+
+static HRESULT WINAPI set_iterable_First( IIterable_Visual *iface, IIterator_Visual **value )
+{
+    struct visual_set *impl = set_impl_from_iterable( iface );
+    struct visual_iterator *iter;
+    UINT i;
+
+    if (!value) return E_POINTER;
+    if (!(iter = calloc( 1, sizeof(*iter) ))) return E_OUTOFMEMORY;
+    iter->IIterator_Visual_iface.lpVtbl = &viter_vtbl;
+    iter->ref = 1;
+    compositor_lock( impl->compositor );
+    if (impl->count && (iter->items = malloc( impl->count * sizeof(*iter->items) )))
+    {
+        iter->count = impl->count;
+        for (i = 0; i < iter->count; i++) IVisual_AddRef( (iter->items[i] = impl->items[i]) );
+    }
+    compositor_unlock( impl->compositor );
+    *value = &iter->IIterator_Visual_iface;
+    return S_OK;
+}
+
+static const struct IIterable_VisualVtbl set_iterable_vtbl =
+{
+    set_iterable_QueryInterface, set_iterable_AddRef, set_iterable_Release, set_iterable_GetIids,
+    set_iterable_GetRuntimeClassName, set_iterable_GetTrustLevel, set_iterable_First,
+};
+
+DEFINE_COMPOSITION_OBJECT_( set, struct visual_set, primary, anim_none )
+DEFINE_COMPOSITION_OBJECT4( set, struct visual_set, primary )
+
+static HRESULT visual_set_create( struct compositor *compositor, struct visual_set **out )
+{
+    struct visual_set *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->primary.vtbl = set_vtbl;
+    impl->IIterable_Visual_iface.lpVtbl = &set_iterable_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &set_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &set_closable_vtbl;
+    impl->ICompositionObject4_iface.lpVtbl = (const IInspectableVtbl *)set_object4_vtbl;
+    impl->ref = 1;
+    impl->compositor = compositor;
+    ICompositor_AddRef( (ICompositor *)compositor );
+    *out = impl;
+    return S_OK;
+}
+
+/***********************************************************************
+ *          Lights
+ */
+
+enum light_kind { LIGHT_AMBIENT, LIGHT_DISTANT, LIGHT_POINT, LIGHT_SPOT };
+
+struct light
+{
+    struct { const void * const *vtbl; } primary;      /* ICompositionLight */
+    struct { const void * const *vtbl; } light2;       /* ICompositionLight2 */
+    struct { const void * const *vtbl; } light3;       /* ICompositionLight3 */
+    struct { const void * const *vtbl; } kind1;        /* IAmbientLight, IDistantLight, IPointLight, ISpotLight */
+    struct { const void * const *vtbl; } kind2;        /* ...2 */
+    struct { const void * const *vtbl; } kind3;        /* IPointLight3, ISpotLight3 */
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    IInspectable ICompositionObject4_iface;
+    LONG ref;
+    struct compositor *compositor;
+    enum light_kind kind;
+    ICompositionPropertySet *properties;
+    struct visual_set *targets, *exclusions;
+    IVisual *coordinate_space;
+    boolean enabled;
+    Color color, inner_color, outer_color;
+    FLOAT intensity, inner_intensity, outer_intensity;
+    FLOAT constant, linear, quadratic, min_cutoff, max_cutoff;
+    FLOAT inner_angle, outer_angle;         /* radians */
+    Vector3 direction, offset;
+};
+
+static const IID *const kind1_iids[] = { &IID_IAmbientLight_sg, &IID_IDistantLight_sg, &IID_IPointLight_sg, &IID_ISpotLight_sg };
+static const IID *const kind2_iids[] = { &IID_IAmbientLight2_sg, &IID_IDistantLight2_sg, &IID_IPointLight2_sg, &IID_ISpotLight2_sg };
+static const WCHAR *const light_classes[] =
+{
+    L"Windows.UI.Composition.AmbientLight", L"Windows.UI.Composition.DistantLight",
+    L"Windows.UI.Composition.PointLight", L"Windows.UI.Composition.SpotLight",
+};
+
+static struct light *impl_from_light( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct light, primary );
+}
+
+static HRESULT WINAPI light_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    struct light *impl = impl_from_light( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_ICompositionLight_sg ))
+        *out = &impl->primary;
+    else if (IsEqualGUID( iid, &IID_ICompositionLight2_sg ))
+        *out = &impl->light2;
+    else if (IsEqualGUID( iid, &IID_ICompositionLight3_sg ))
+        *out = &impl->light3;
+    else if (IsEqualGUID( iid, kind1_iids[impl->kind] ))
+        *out = &impl->kind1;
+    else if (IsEqualGUID( iid, kind2_iids[impl->kind] ))
+        *out = &impl->kind2;
+    else if ((impl->kind == LIGHT_POINT && IsEqualGUID( iid, &IID_IPointLight3_sg ))
+             || (impl->kind == LIGHT_SPOT && IsEqualGUID( iid, &IID_ISpotLight3_sg )))
+        *out = &impl->kind3;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject4_x ))
+        *out = &impl->ICompositionObject4_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI light_AddRef( void *iface )
+{
+    return InterlockedIncrement( &impl_from_light( iface )->ref );
+}
+
+static ULONG WINAPI light_Release( void *iface )
+{
+    struct light *impl = impl_from_light( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        set_Release( &impl->targets->primary );
+        set_Release( &impl->exclusions->primary );
+        if (impl->coordinate_space) IVisual_Release( impl->coordinate_space );
+        ICompositor_Release( (ICompositor *)impl->compositor );
+        object_release_properties( impl->properties );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI light_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    struct light *impl = impl_from_light( iface );
+    const IID *list[] = { kind1_iids[impl->kind], kind2_iids[impl->kind], &IID_ICompositionLight_sg,
+                          &IID_ICompositionLight2_sg, &IID_ICompositionLight3_sg, &IID_ICompositionObject, &IID_IClosable,
+                          impl->kind == LIGHT_POINT ? &IID_IPointLight3_sg : &IID_ISpotLight3_sg };
+    return iid_list( count, iids, list, impl->kind >= LIGHT_POINT ? ARRAY_SIZE(list) : ARRAY_SIZE(list) - 1 );
+}
+
+static HRESULT WINAPI light_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return class_name( light_classes[impl_from_light( iface )->kind], name );
+}
+
+static HRESULT WINAPI light_GetTrustLevel( void *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI light_get_Targets( void *iface, void **value )
+{
+    struct light *impl = impl_from_light( iface );
+    if (!value) return E_POINTER;
+    set_AddRef( (*value = &impl->targets->primary) );
+    return S_OK;
+}
