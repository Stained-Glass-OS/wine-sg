+/* a property's get and put on one of the kind interfaces */
+#define LIGHT_PROP( pfx, name, type, field )                                                        \
+    static HRESULT WINAPI pfx##_get_##name( void *iface, type *value )                             \
+    {                                                                                              \
+        if (!value) return E_POINTER;                                                              \
+        *value = pfx##_impl( iface )->field;                                                       \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_put_##name( void *iface, type value )                              \
+    {                                                                                              \
+        struct light *impl = pfx##_impl( iface );                                                  \
+        impl->field = value;                                                                       \
+        compositor_changed( impl->compositor );                                                    \
+        return S_OK;                                                                               \
+    }
+
+/* the same property in degrees */
+#define LIGHT_DEGREES( pfx, name, field )                                                           \
+    static HRESULT WINAPI pfx##_get_##name( void *iface, FLOAT *value )                            \
+    {                                                                                              \
+        if (!value) return E_POINTER;                                                              \
+        *value = pfx##_impl( iface )->field * 180.0f / (FLOAT)M_PI;                                \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_put_##name( void *iface, FLOAT value )                             \
+    {                                                                                              \
+        struct light *impl = pfx##_impl( iface );                                                  \
+        impl->field = value * (FLOAT)M_PI / 180.0f;                                                \
+        compositor_changed( impl->compositor );                                                    \
+        return S_OK;                                                                               \
+    }
+
+static HRESULT WINAPI kind1_get_CoordinateSpace( void *iface, IVisual **value )
+{
+    struct light *impl = kind1_impl( iface );
+    if (!value) return E_POINTER;
+    if ((*value = impl->coordinate_space)) IVisual_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI kind1_put_CoordinateSpace( void *iface, IVisual *value )
+{
+    struct light *impl = kind1_impl( iface );
+    if (value) IVisual_AddRef( value );
+    if (impl->coordinate_space) IVisual_Release( impl->coordinate_space );
+    impl->coordinate_space = value;
+    compositor_changed( impl->compositor );
+    return S_OK;
+}
