+
+/* a light of a kind, with Windows' defaults: white, intensity 1, constant attenuation 1, pointing down the
+ * negative z axis, enabled */
+HRESULT light_create( struct compositor *compositor, int kind, void **out )
+{
+    static const void * const *const kind1_vtbls[] = { ambient_vtbl, distant_vtbl, point_vtbl, spot_vtbl };
+    static const void * const *const kind2_vtbls[] = { ambient2_vtbl, distant2_vtbl, point2_vtbl, spot2_vtbl };
+    static const Color white = { 255, 255, 255, 255 };
+    struct light *impl;
+    HRESULT hr;
+
+    if (kind < LIGHT_AMBIENT || kind > LIGHT_SPOT) return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = visual_set_create( compositor, &impl->targets )))
+    {
+        free( impl );
+        return hr;
+    }
+    if (FAILED(hr = visual_set_create( compositor, &impl->exclusions )))
+    {
+        set_Release( &impl->targets->primary );
+        free( impl );
+        return hr;
+    }
+    impl->primary.vtbl = light_vtbl;
+    impl->light2.vtbl = light2_vtbl;
+    impl->light3.vtbl = light3_vtbl;
+    impl->kind1.vtbl = kind1_vtbls[kind];
+    impl->kind2.vtbl = kind2_vtbls[kind];
+    impl->kind3.vtbl = cutoff_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &light_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &light_closable_vtbl;
+    impl->ICompositionObject4_iface.lpVtbl = (const IInspectableVtbl *)light_object4_vtbl;
+    impl->ref = 1;
+    impl->compositor = compositor;
+    ICompositor_AddRef( (ICompositor *)compositor );
+    impl->kind = kind;
+    impl->enabled = TRUE;
+    impl->color = impl->inner_color = impl->outer_color = white;
+    impl->intensity = impl->inner_intensity = impl->outer_intensity = 1.0f;
+    impl->constant = 1.0f;
+    impl->max_cutoff = FLT_MAX;
+    impl->direction.Z = -1.0f;
+    *out = &impl->kind1;
+    return S_OK;
+}
