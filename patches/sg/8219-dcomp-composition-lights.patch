+/* what StartAnimation animates on a light */
+static BOOL light_animatable( void *impl, const WCHAR *name, struct anim_property *prop )
+{
+    static const struct anim_member members[] =
+    {
+        { L"Color", ANIM_COLOR, offsetof(struct light, color) },
+        { L"ConstantAttenuation", ANIM_SCALAR, offsetof(struct light, constant) },
+        { L"Direction", ANIM_VECTOR3, offsetof(struct light, direction) },
+        { L"InnerConeAngle", ANIM_SCALAR, offsetof(struct light, inner_angle) },
+        { L"InnerConeColor", ANIM_COLOR, offsetof(struct light, inner_color) },
+        { L"InnerConeIntensity", ANIM_SCALAR, offsetof(struct light, inner_intensity) },
+        { L"Intensity", ANIM_SCALAR, offsetof(struct light, intensity) },
+        { L"LinearAttenuation", ANIM_SCALAR, offsetof(struct light, linear) },
+        { L"Offset", ANIM_VECTOR3, offsetof(struct light, offset) },
+        { L"OuterConeAngle", ANIM_SCALAR, offsetof(struct light, outer_angle) },
+        { L"OuterConeColor", ANIM_COLOR, offsetof(struct light, outer_color) },
+        { L"OuterConeIntensity", ANIM_SCALAR, offsetof(struct light, outer_intensity) },
+        { L"QuadraticAttenuation", ANIM_SCALAR, offsetof(struct light, quadratic) },
+    };
+    return anim_resolve( impl, members, ARRAY_SIZE(members), name, prop );
+}
