From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase, ntdll, wow64, ws2_32, wofutil: ReplaceFile merges, power information, small stubs

- ReplaceFileW logged "Ignoring flags" (1103 times in the logs) and did
  not do what Windows does: give the replacement the replaced file's
  information before it takes its place. Its creation time, attributes
  (hidden, system, archive, not-indexed, temporary) and explicit DACL now
  go over -- a safe save (write a new file, ReplaceFile it over the old;
  Office and editors do) lost the hidden mark. A failed merge fails the
  call unless REPLACEFILE_IGNORE_MERGE_ERRORS or (for the DACL)
  REPLACEFILE_IGNORE_ACL_ERRORS; REPLACEFILE_WRITE_THROUGH flushes the
  replacement. (Linux file systems cannot take a creation time.)
- NtPowerInformation(SystemPowerInformation) was not implemented, and the
  wow64 thunk refused it (204 FIXMEs from 32-bit programs): it gives how
  idle the machine has been since boot. SystemPowerCapabilities was an XP
  desktop's canned answer -- no battery on a laptop, no lid, no suspend
  to RAM: it reports the battery and lid ACPI sees, the sleep states the
  kernel offers (/sys/power/state), thermal zones and frequency scaling.
- HeapSetInformation(HeapEnableTerminationOnCorruption) logged a FIXME
  (402 times); it and HeapOptimizeResources (version checked) are taken.
- SetProcessShutdownParameters, a "partial stub", refuses levels past
  0x4ff and flags other than SHUTDOWN_NORETRY, as Windows does.
- setsockopt(SO_RANDOMIZE_PORT) logged a FIXME (706 times): ports are
  random here already.
- WofIsExternalFile (672 FIXMEs, Edge's installer) asks the file system
  (FSCTL_GET_EXTERNAL_BACKING) and fails for a file that is not there;
  WofShouldCompressBinaries stops logging: no volume is compacted here.

Wine's kernel32 file and heap tests: the same results as before.

Gate: test/replacefile-gate.sh. Mutants SG_MUTANT_NO_REPLACE_MERGE
(kernelbase/file.c), SG_MUTANT_NO_POWER_CAPS (ntdll/unix/system.c).
---
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -3075,8 +3075,6 @@ BOOL WINAPI DECLSPEC_HOTPATCH ReplaceFileW( const WCHAR *replaced, const WCHAR *
     TRACE( "%s %s %s 0x%08lx %p %p\n", debugstr_w(replaced), debugstr_w(replacement), debugstr_w(backup),
            flags, exclude, reserved );
 
-    if (flags) FIXME("Ignoring flags %lx\n", flags);
-
     /* First two arguments are mandatory */
     if (!replaced || !replacement)
     {
@@ -3124,6 +3122,79 @@ BOOL WINAPI DECLSPEC_HOTPATCH ReplaceFileW( const WCHAR *replaced, const WCHAR *
                          &attr, &io, 0, FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE );
     RtlFreeUnicodeString(&nt_replacement_name);
     if (!set_ntstatus( status )) return FALSE;
+
+#ifndef REPLACEFILE_IGNORE_ACL_ERRORS
+#define REPLACEFILE_IGNORE_ACL_ERRORS 0x00000004
+#endif
+#ifndef SG_MUTANT_NO_REPLACE_MERGE
+    /* As Windows does, the replaced file's information goes to the
+     * replacement before it takes its place: its creation time and
+     * attributes, and its DACL. A safe save (write a new file, ReplaceFile
+     * it over the old one; Office and editors do) kept the new file's
+     * creation time and lost hidden/system marks. Failing to merge fails
+     * the call unless REPLACEFILE_IGNORE_MERGE_ERRORS (or, for the DACL,
+     * REPLACEFILE_IGNORE_ACL_ERRORS) says otherwise. REPLACEFILE_WRITE_THROUGH
+     * flushes the replacement first. */
+    {
+        static const DWORD merged_attributes = FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM | FILE_ATTRIBUTE_ARCHIVE |
+                                               FILE_ATTRIBUTE_NOT_CONTENT_INDEXED | FILE_ATTRIBUTE_TEMPORARY;
+        FILE_BASIC_INFORMATION basic;
+        SECURITY_DESCRIPTOR_CONTROL control;
+        PSECURITY_DESCRIPTOR sd = NULL;
+        DWORD sd_size = 0, revision, error = 0;
+        HANDLE hReplaced;
+        BOOL dacl_ok = TRUE;
+
+        hReplaced = CreateFileW( replaced, FILE_READ_ATTRIBUTES | READ_CONTROL,
+                                 FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,
+                                 FILE_FLAG_BACKUP_SEMANTICS, 0 );
+        if (hReplaced == INVALID_HANDLE_VALUE) error = GetLastError();
+        else
+        {
+            if (NtQueryInformationFile( hReplaced, &io, &basic, sizeof(basic), FileBasicInformation ))
+                error = ERROR_ACCESS_DENIED;
+            if (!GetKernelObjectSecurity( hReplaced, DACL_SECURITY_INFORMATION, NULL, 0, &sd_size ) &&
+                GetLastError() == ERROR_INSUFFICIENT_BUFFER && (sd = HeapAlloc( GetProcessHeap(), 0, sd_size )) &&
+                !GetKernelObjectSecurity( hReplaced, DACL_SECURITY_INFORMATION, sd, sd_size, &sd_size ))
+            {
+                HeapFree( GetProcessHeap(), 0, sd );
+                sd = NULL;
+            }
+            CloseHandle( hReplaced );
+        }
+        if (!error)
+        {
+            FILE_BASIC_INFORMATION merged, current;
+
+            memset( &merged, 0, sizeof(merged) );
+            merged.CreationTime = basic.CreationTime;
+            if (!NtQueryInformationFile( hReplacement, &io, &current, sizeof(current), FileBasicInformation ))
+                merged.FileAttributes = (current.FileAttributes & ~merged_attributes) |
+                                        (basic.FileAttributes & merged_attributes) | FILE_ATTRIBUTE_NORMAL;
+            if (merged.FileAttributes & ~FILE_ATTRIBUTE_NORMAL) merged.FileAttributes &= ~FILE_ATTRIBUTE_NORMAL;
+            if (NtSetInformationFile( hReplacement, &io, &merged, sizeof(merged), FileBasicInformation ))
+                error = ERROR_UNABLE_TO_MOVE_REPLACEMENT;
+        }
+        /* the DACL, unless it was inherited (then the folder gives it again) */
+        if (sd && GetSecurityDescriptorControl( sd, &control, &revision ) && !(control & SE_DACL_AUTO_INHERITED) &&
+            !SetKernelObjectSecurity( hReplacement, DACL_SECURITY_INFORMATION, sd ))
+            dacl_ok = FALSE;
+        HeapFree( GetProcessHeap(), 0, sd );
+        if (error && !(flags & REPLACEFILE_IGNORE_MERGE_ERRORS))
+        {
+            NtClose( hReplacement );
+            SetLastError( error );
+            return FALSE;
+        }
+        if (!dacl_ok && !(flags & (REPLACEFILE_IGNORE_ACL_ERRORS | REPLACEFILE_IGNORE_MERGE_ERRORS)))
+        {
+            NtClose( hReplacement );
+            SetLastError( ERROR_ACCESS_DENIED );
+            return FALSE;
+        }
+        if (flags & REPLACEFILE_WRITE_THROUGH) FlushFileBuffers( hReplacement );
+    }
+#endif
     NtClose( hReplacement );
 
     /* If the user wants a backup then that needs to be performed first */
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -1735,7 +1735,13 @@ BOOL WINAPI /* DECLSPEC_HOTPATCH */ SetProcessPriorityBoost( HANDLE process, BOO
  */
 BOOL WINAPI DECLSPEC_HOTPATCH SetProcessShutdownParameters( DWORD level, DWORD flags )
 {
-    FIXME( "(%08lx, %08lx): partial stub.\n", level, flags );
+    /* levels 0x000-0x4ff; SHUTDOWN_NORETRY is the one flag */
+    TRACE( "(%08lx, %08lx)\n", level, flags );
+    if (level > 0x4ff || (flags & ~SHUTDOWN_NORETRY))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
     shutdown_flags = flags;
     shutdown_priority = level;
     return TRUE;
--- a/dlls/ntdll/heap.c
+++ b/dlls/ntdll/heap.c
@@ -2585,7 +2585,7 @@ NTSTATUS WINAPI RtlSetHeapInformation( HANDLE handle, HEAP_INFORMATION_CLASS inf
 
     TRACE( "handle %p, info_class %u, info %p, size %Iu.\n", handle, info_class, info, size );
 
-    switch (info_class)
+    switch ((ULONG)info_class)
     {
     case HeapCompatibilityInformation:
     {
@@ -2606,6 +2606,22 @@ NTSTATUS WINAPI RtlSetHeapInformation( HANDLE handle, HEAP_INFORMATION_CLASS inf
         return STATUS_SUCCESS;
     }
 
+    case 1:  /* HeapEnableTerminationOnCorruption */
+        /* a corrupted heap here ends the process on the error anyway: taken
+         * as Windows takes it, for any heap and without data */
+        return STATUS_SUCCESS;
+
+    case 3:  /* HeapOptimizeResources */
+    {
+        /* HEAP_OPTIMIZE_RESOURCES_INFORMATION: its version must be the
+         * current one; free memory is given back as blocks are freed */
+        const struct { DWORD version; DWORD flags; } *optimize = info;
+
+        if (size < sizeof(*optimize)) return STATUS_BUFFER_TOO_SMALL;
+        if (optimize->version != 1) return STATUS_INVALID_PARAMETER;
+        return STATUS_SUCCESS;
+    }
+
     default:
         FIXME( "HEAP_INFORMATION_CLASS %u not implemented!\n", info_class );
         return STATUS_SUCCESS;
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -4214,6 +4214,31 @@ static NTSTATUS fill_battery_state( SYSTEM_BATTERY_STATE *bs )
 
 #endif
 
+#ifdef linux
+/* whether a sysfs/procfs file exists, and whether it holds a word */
+static BOOL sys_file_has( const char *path, const char *word )
+{
+    char line[256];
+    BOOL ret = FALSE;
+    FILE *f;
+
+    if (!(f = fopen( path, "r" ))) return FALSE;
+    if (!word) ret = TRUE;
+    else while (!ret && fgets( line, sizeof(line), f )) ret = strstr( line, word ) != NULL;
+    fclose( f );
+    return ret;
+}
+
+static BOOL dir_exists( const char *path )
+{
+    DIR *dir = opendir( path );
+
+    if (!dir) return FALSE;
+    closedir( dir );
+    return TRUE;
+}
+#endif
+
 /******************************************************************************
  *              NtPowerInformation  (NTDLL.@)
  */
@@ -4260,9 +4285,87 @@ NTSTATUS WINAPI NtPowerInformation( POWER_INFORMATION_LEVEL level, void *input,
         PowerCaps->RtcWake = PowerSystemSleeping1;
         PowerCaps->MinDeviceWakeState = PowerSystemUnspecified;
         PowerCaps->DefaultLowLatencyWake = PowerSystemUnspecified;
+#if defined(linux) && !defined(SG_MUTANT_NO_POWER_CAPS)
+        /* What this machine has (it was an XP desktop's canned answer: no
+         * battery on a laptop, no lid, no sleep): the battery and lid ACPI
+         * reports, the sleep states the kernel offers, thermal zones and
+         * frequency scaling. */
+        {
+            SYSTEM_BATTERY_STATE bs;
+            unsigned int min_khz = 0, max_khz = 0;
+            FILE *f;
+
+            memset( &bs, 0, sizeof(bs) );
+            fill_battery_state( &bs );
+            PowerCaps->SystemBatteriesPresent = bs.BatteryPresent;
+            PowerCaps->LidPresent = dir_exists( "/proc/acpi/button/lid" ) || sys_file_has( "/proc/acpi/button/lid/LID0/state", NULL );
+            PowerCaps->SystemS1 = sys_file_has( "/sys/power/state", "standby" ) || sys_file_has( "/sys/power/state", "freeze" );
+            PowerCaps->SystemS3 = sys_file_has( "/sys/power/state", "mem" );
+            PowerCaps->SystemS4 = sys_file_has( "/sys/power/state", "disk" );
+            PowerCaps->HiberFilePresent = PowerCaps->SystemS4;
+            PowerCaps->ThermalControl = dir_exists( "/sys/class/thermal/thermal_zone0" );
+            if ((f = fopen( "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_min_freq", "r" )))
+            {
+                if (fscanf( f, "%u", &min_khz ) != 1) min_khz = 0;
+                fclose( f );
+            }
+            if ((f = fopen( "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq", "r" )))
+            {
+                if (fscanf( f, "%u", &max_khz ) != 1) max_khz = 0;
+                fclose( f );
+            }
+            if (min_khz && max_khz > min_khz)
+            {
+                PowerCaps->ProcessorThrottle = TRUE;
+                PowerCaps->ProcessorMinThrottle = min_khz * 100ull / max_khz;
+            }
+            if (bs.BatteryPresent)
+            {
+                PowerCaps->BatteryScale[0].Granularity = 1;
+                PowerCaps->BatteryScale[0].Capacity = bs.MaxCapacity;
+            }
+        }
+#endif
         return STATUS_SUCCESS;
     }
 
+#ifndef SG_MUTANT_NO_POWER_CAPS
+    case SystemPowerInformation:
+    {
+        /* how idle the machine has been (CallNtPowerInformation, 204 FIXMEs
+         * in the logs from 32-bit programs, which got nothing) */
+        SYSTEM_POWER_INFORMATION *info = output;
+        ULONG64 idle = 0, total = 0;
+
+        if (input || in_size) return STATUS_INVALID_PARAMETER;
+        if (out_size < sizeof(*info)) return STATUS_BUFFER_TOO_SMALL;
+        memset( info, 0, sizeof(*info) );
+#ifdef linux
+        {
+            unsigned long long v[8] = { 0 };
+            FILE *f;
+            int i;
+
+            if ((f = fopen( "/proc/stat", "r" )))
+            {
+                if (fscanf( f, "cpu %llu %llu %llu %llu %llu %llu %llu %llu",
+                            &v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &v[6], &v[7] ) >= 4)
+                {
+                    for (i = 0; i < 8; i++) total += v[i];
+                    idle = v[3] + v[4];
+                }
+                fclose( f );
+            }
+        }
+#endif
+        info->MaxIdlenessAllowed = 100;
+        info->Idleness = total ? (ULONG)(idle * 100 / total) : 0;
+        info->TimeRemaining = 0;
+        info->CoolingMode = 2;  /* PO_TZ_INVALID_MODE: no thermal policy of ours */
+        return STATUS_SUCCESS;
+    }
+#endif
+
     case SystemBatteryState:
     {
         if (out_size < sizeof(SYSTEM_BATTERY_STATE)) return STATUS_BUFFER_TOO_SMALL;
--- a/dlls/wofutil/main.c
+++ b/dlls/wofutil/main.c
@@ -32,16 +32,45 @@ WINE_DEFAULT_DEBUG_CHANNEL(wofutil);
 
 HRESULT WINAPI WofIsExternalFile( const WCHAR *path, BOOL *result, ULONG *provider, void *ptr, ULONG *length )
 {
-    FIXME( "%s, %p, %p, %p, %p\n", debugstr_w(path), result, provider, ptr, length );
-    if (result) *result = FALSE;
-    if (provider) *provider = 0;
-    if (length) *length = 0;
+    struct { WOF_EXTERNAL_INFO wof; BYTE info[512]; } backing;
+    DWORD returned;
+    HANDLE file;
+    BOOL ret;
+
+    /* Whether a file is backed by a WOF provider: the overlay filter says
+     * so for FSCTL_GET_EXTERNAL_BACKING (Edge's installer asks of every
+     * file it lays down, 672 FIXMEs in the logs). A file system without
+     * the filter refuses, and the file is not external; a file that is not
+     * there is an error. */
+    TRACE( "%s, %p, %p, %p, %p\n", debugstr_w(path), result, provider, ptr, length );
+
+    file = CreateFileW( path, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                        NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+    ret = DeviceIoControl( file, FSCTL_GET_EXTERNAL_BACKING, NULL, 0, &backing, sizeof(backing), &returned, NULL );
+    CloseHandle( file );
+    if (!ret || returned < sizeof(backing.wof))
+    {
+        if (result) *result = FALSE;
+        if (provider) *provider = 0;
+        if (length) *length = 0;
+        return S_OK;
+    }
+    if (result) *result = TRUE;
+    if (provider) *provider = backing.wof.Provider;
+    if (length)
+    {
+        ULONG size = returned - sizeof(backing.wof);
+        if (ptr) memcpy( ptr, backing.info, min( size, *length ));
+        *length = size;
+    }
     return S_OK;
 }
 
 BOOL WINAPI WofShouldCompressBinaries( const WCHAR *volume, ULONG *alg )
 {
-    FIXME( "%s, %p\n", debugstr_w(volume), alg );
+    /* whether the volume is one Windows compacts (Compact OS): never here */
+    TRACE( "%s, %p\n", debugstr_w(volume), alg );
     return FALSE;
 }
 
--- a/dlls/wow64/system.c
+++ b/dlls/wow64/system.c
@@ -243,6 +243,9 @@ NTSTATUS WINAPI wow64_NtPowerInformation( UINT *args )
     case SystemBatteryState:   /* SYSTEM_BATTERY_STATE */
     case SystemExecutionState:   /* ULONG */
     case ProcessorInformation:   /* PROCESSOR_POWER_INFORMATION */
+    case SystemPowerInformation:   /* SYSTEM_POWER_INFORMATION */
+    case LastWakeTime:   /* ULONGLONG */
+    case LastSleepTime:   /* ULONGLONG */
         return NtPowerInformation( level, in_buf, in_len, out_buf, out_len );
 
     default:
--- a/dlls/ws2_32/socket.c
+++ b/dlls/ws2_32/socket.c
@@ -3309,7 +3309,8 @@ int WINAPI setsockopt( SOCKET s, int level, int optname, const char *optval, int
             return 0;
 
         case SO_RANDOMIZE_PORT:
-            FIXME("Ignoring SO_RANDOMIZE_PORT\n");
+            /* the system picks ephemeral ports at random already */
+            TRACE("SO_RANDOMIZE_PORT\n");
             return 0;
 
         case SO_PORT_SCALABILITY:
