+static void sg_look_paint_button( const DRAWITEMSTRUCT *dis )
+{
+    HDC hdc = dis->hDC;
+    struct taskbar_button *win;
+    RECT rect;
+    int state = (dis->itemState & ODS_SELECTED) ? SG_FRAME_ACTIVE : (dis->itemState & ODS_HOTLIGHT) ? SG_FRAME_HOVER : SG_FRAME_NONE;
+
+    GetClientRect( dis->hwndItem, &rect );
+    sg_paint_bar_under( hdc, dis->hwndItem );
+
+    if (dis->CtlID == SG_SEARCH_ID)
+    {
+        sg_look_frame( hdc, &rect, state );
+        if (sg_bar.search == 2 && !sg_vertical())
+        {
+            RECT box = rect, text;
+            NONCLIENTMETRICSW ncm;
+            HFONT font, old;
+
+            InflateRect( &box, -4, sg_bar.small || sg_look == SG_LOOK_HORIZON ? -4 : -7 );
+            sg_fill_round( hdc, &box, 3, RGB(0xFF,0xFF,0xFF) );
+            sg_draw_magnifier( hdc, box.left + 16, (box.top + box.bottom) / 2, RGB(0x33,0x33,0x33) );
+            ncm.cbSize = sizeof(ncm);
+            SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+            font = CreateFontIndirectW( &ncm.lfMenuFont );
+            old = SelectObject( hdc, font );
+            SetBkMode( hdc, TRANSPARENT );
+            SetTextColor( hdc, RGB(0x6E,0x6E,0x6E) );
+            text = box;
+            text.left += 32;
+            DrawTextW( hdc, L"Type here to search", -1, &text, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS );
+            SelectObject( hdc, old );
+            DeleteObject( font );
+        }
+        else sg_draw_magnifier( hdc, (rect.left + rect.right) / 2, (rect.top + rect.bottom) / 2, RGB(0xFF,0xFF,0xFF) );
+        return;
+    }
+    if (dis->CtlID == SG_TASKVIEW_ID)
+    {
+        sg_look_frame( hdc, &rect, state );
+        vd_paint_button( hdc, &rect, RGB(0xFF,0xFF,0xFF) );
+        return;
+    }
+    if (dis->CtlID >= SG_PIN_FIRST && dis->CtlID < SG_PIN_FIRST + SG_PIN_MAX)
+    {
+        /* a pinned program, not running: its icon, framed under the pointer */
+        int i = dis->CtlID - SG_PIN_FIRST, cx = sg_look == SG_LOOK_GLASS && !sg_bar.small && !sg_vertical() ? 32 : GetSystemMetrics( SM_CXSMICON );
+        sg_look_frame( hdc, &rect, state );
+        if (i < sg_npins)
+            DrawIconEx( hdc, rect.left + (rect.right - rect.left - cx) / 2, rect.top + (rect.bottom - rect.top - cx) / 2,
+                        sg_pins[i].icon ? sg_pins[i].icon : LoadIconW( 0, (const WCHAR *)IDI_APPLICATION ), cx, cx, 0, 0, DI_NORMAL );
+        return;
+    }
+    if (!(win = find_taskbar_button( LongToHandle( dis->CtlID )))) return;
+    if (!win->hwnd)
+    {
+        if (sg_look == SG_LOOK_HORIZON) sg_draw_horizon_start( dis, &rect );
+        else sg_draw_glass_orb( dis, &rect );
+        return;
+    }
+
+    /* a window's button: always framed, pressed-looking for the foreground one */
+    if (state != SG_FRAME_ACTIVE)
+        state = win->active || (win->combined && win->group_active) ? SG_FRAME_ACTIVE : state == SG_FRAME_HOVER ? SG_FRAME_HOVER : SG_FRAME_NORMAL;
+    if (win->combined && win->group_count > 1)
+    {
+        /* more windows behind it: a second frame peeks out at the far end */
+        RECT behind = rect;
+        if (sg_vertical()) OffsetRect( &behind, 0, 3 ); else OffsetRect( &behind, 3, 0 );
+        sg_look_frame( hdc, &behind, SG_FRAME_NORMAL );
+        if (sg_vertical()) rect.bottom -= 3; else rect.right -= 3;
+    }
+    sg_look_frame( hdc, &rect, state );
+    {
+        BOOL big = sg_look == SG_LOOK_GLASS && win->icon_only && !sg_bar.small && !sg_vertical();
+        HICON icon = big && win->exe_icon_big ? win->exe_icon_big : win->exe_icon;
+        int cx = big ? 32 : GetSystemMetrics( SM_CXSMICON ), cy = big ? 32 : GetSystemMetrics( SM_CYSMICON );
+        if (!icon) icon = LoadIconW( 0, (const WCHAR *)IDI_APPLICATION );
+        if (icon && win->icon_only)
+            DrawIconEx( hdc, rect.left + (rect.right - rect.left - cx) / 2, rect.top + (rect.bottom - rect.top - cy) / 2,
+                        icon, cx, cy, 0, 0, DI_NORMAL );
+        else if (icon)
+            DrawIconEx( hdc, rect.left + 8, rect.top + (rect.bottom - rect.top - cy) / 2, icon, cx, cy, 0, 0, DI_NORMAL );
+    }
+    if (!win->icon_only)
+    {
+        WCHAR title[256];
+        RECT tr = rect;
+        HFONT font, old;
+        NONCLIENTMETRICSW ncm;
+
+        ncm.cbSize = sizeof(ncm);
+        SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+        font = CreateFontIndirectW( &ncm.lfMenuFont );
+        old = SelectObject( hdc, font );
+        if (win->elevated) InternalGetWindowText( win->hwnd, title, ARRAY_SIZE(title) );
+        else GetWindowTextW( win->hwnd, title, ARRAY_SIZE(title) );
+        SetBkMode( hdc, TRANSPARENT );
+        SetTextColor( hdc, RGB(0xFF,0xFF,0xFF) );
+        tr.left += 8 + GetSystemMetrics( SM_CXSMICON ) + 6;
+        tr.right -= 6;
+        DrawTextW( hdc, title, -1, &tr, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS );
+        SelectObject( hdc, old );
+        DeleteObject( font );
+    }
+}
