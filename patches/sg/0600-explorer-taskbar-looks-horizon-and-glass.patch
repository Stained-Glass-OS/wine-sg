+/* Stained Glass OS: the Horizon and Glass looks (Taskbar Style 1, 2).
+ * Everything is our own drawing: GDI gradients, round rectangles and
+ * ellipses, and the Stained Glass mark. */
+struct sg_stop { int at; COLORREF color; };
+static COLORREF sg_mix( COLORREF a, COLORREF b, int percent_b );   /* a gradient's colour, at a percentage */
+
+/* a gradient across the bar's thickness -- top to bottom on a horizontal
+ * bar, left to right on a vertical one -- through its stops */
+static void sg_gradient( HDC hdc, const RECT *rect, const struct sg_stop *stops, int count )
+{
+    BOOL across = sg_vertical();
+    int len = across ? rect->right - rect->left : rect->bottom - rect->top, i;
+
+    for (i = 0; i + 1 < count; i++)
+    {
+        TRIVERTEX v[2];
+        GRADIENT_RECT gr = { 0, 1 };
+        int a = len * stops[i].at / 100, b = len * stops[i + 1].at / 100;
+
+        if (b <= a) continue;
+        v[0].x = across ? rect->left + a : rect->left;
+        v[0].y = across ? rect->top : rect->top + a;
+        v[1].x = across ? rect->left + b : rect->right;
+        v[1].y = across ? rect->bottom : rect->top + b;
+        v[0].Red = GetRValue( stops[i].color ) << 8; v[0].Green = GetGValue( stops[i].color ) << 8;
+        v[0].Blue = GetBValue( stops[i].color ) << 8; v[0].Alpha = 0;
+        v[1].Red = GetRValue( stops[i + 1].color ) << 8; v[1].Green = GetGValue( stops[i + 1].color ) << 8;
+        v[1].Blue = GetBValue( stops[i + 1].color ) << 8; v[1].Alpha = 0;
+        GdiGradientFill( hdc, v, 2, &gr, 1, across ? GRADIENT_FILL_RECT_H : GRADIENT_FILL_RECT_V );
+    }
+}
+
+/* the part of the bar where the notification icons and the clock are */
+static RECT sg_tray_panel( const RECT *bar )
+{
+    RECT r = *bar;
+    if (sg_vertical()) r.top = r.bottom - sg_clock_len() - nb_displayed * icon_cy - SG_HORIZON_TRAY_PAD;
+    else r.left = r.right - sg_clock_len() - nb_displayed * icon_cx - SG_HORIZON_TRAY_PAD;
+    return r;
+}
+
+static void sg_draw_bar_look( HDC hdc, const RECT *bar )
+{
+    if (sg_look == SG_LOOK_HORIZON)
+    {
+        /* bright blue with a glossy top edge, darker at the foot */
+        static const struct sg_stop blue[] = {
+            { 0, RGB(0x6A,0xA4,0xF6) }, { 6, RGB(0x3C,0x7E,0xEA) }, { 20, RGB(0x2E,0x6C,0xE0) },
+            { 70, RGB(0x26,0x5E,0xD4) }, { 92, RGB(0x1E,0x4E,0xBE) }, { 100, RGB(0x17,0x3F,0xA0) } };
+        /* the notification panel: a lighter, greener blue */
+        static const struct sg_stop panel[] = {
+            { 0, RGB(0x70,0xC6,0xF8) }, { 6, RGB(0x2C,0xA2,0xEC) }, { 50, RGB(0x1A,0x92,0xE2) },
+            { 92, RGB(0x12,0x7C,0xD0) }, { 100, RGB(0x0E,0x66,0xB6) } };
+        RECT p = sg_tray_panel( bar ), edge;
+
+        sg_gradient( hdc, bar, blue, ARRAY_SIZE(blue) );
+        sg_gradient( hdc, &p, panel, ARRAY_SIZE(panel) );
+        /* its edge: a dark line and a light one */
+        edge = p;
+        if (sg_vertical()) { edge.bottom = edge.top + 1; sg_fill( hdc, &edge, RGB(0x10,0x4C,0xA8) ); OffsetRect( &edge, 0, 1 ); }
+        else { edge.right = edge.left + 1; sg_fill( hdc, &edge, RGB(0x10,0x4C,0xA8) ); OffsetRect( &edge, 1, 0 ); }
+        sg_fill( hdc, &edge, RGB(0x8C,0xD6,0xFA) );
+    }
+    else
+    {
+        /* dark glass: a light rim at the top, a glossy upper half */
+        static const struct sg_stop glass[] = {
+            { 0, RGB(0x9A,0xA6,0xB6) }, { 3, RGB(0x52,0x60,0x72) }, { 48, RGB(0x34,0x40,0x50) },
+            { 52, RGB(0x22,0x2C,0x3A) }, { 100, RGB(0x16,0x1D,0x28) } };
+        sg_gradient( hdc, bar, glass, ARRAY_SIZE(glass) );
+    }
+}
+
+/* the bar under any of its parts: hwnd's client area, drawn as the part of
+ * the whole bar it covers (buttons and notification icons are windows of
+ * their own) */
+static void sg_paint_bar_under( HDC hdc, HWND hwnd )
+{
+    RECT bar;
+    POINT org = { 0, 0 }, old;
+
+    GetClientRect( tray_window, &bar );
+    if (hwnd != tray_window) MapWindowPoints( hwnd, tray_window, &org, 1 );
+    OffsetViewportOrgEx( hdc, -org.x, -org.y, &old );
+    sg_draw_bar_look( hdc, &bar );
+    SetViewportOrgEx( hdc, old.x, old.y, NULL );
+}
+
+/* a rounded shape filled with a gradient, and its outline */
+static void sg_round_gradient( HDC hdc, const RECT *r, int rx, int ry, const struct sg_stop *stops, int count,
+                               COLORREF border )
+{
+    HPEN pen, oldp;
+    HBRUSH oldb;
+    int saved = SaveDC( hdc );
+
+    BeginPath( hdc );
+    RoundRect( hdc, r->left, r->top, r->right, r->bottom, rx, ry );
+    EndPath( hdc );
+    SelectClipPath( hdc, RGN_AND );
+    sg_gradient( hdc, r, stops, count );
+    RestoreDC( hdc, saved );
+    if (border == CLR_INVALID) return;
+    pen = CreatePen( PS_SOLID, 1, border );
+    oldp = SelectObject( hdc, pen );
+    oldb = SelectObject( hdc, GetStockObject( NULL_BRUSH ));
+    RoundRect( hdc, r->left, r->top, r->right, r->bottom, rx, ry );
+    SelectObject( hdc, oldb );
+    SelectObject( hdc, oldp );
+    DeleteObject( pen );
+}
+
+enum { SG_FRAME_NONE, SG_FRAME_NORMAL, SG_FRAME_HOVER, SG_FRAME_ACTIVE };
+
+/* a button's frame: Horizon's raised blue button (pressed: darker), or a
+ * Glass pane (brighter under the pointer and for the foreground window) */
+static void sg_look_frame( HDC hdc, const RECT *rect, int state )
+{
+    static const struct sg_stop h_normal[] = { { 0, RGB(0x74,0xAA,0xF8) }, { 12, RGB(0x4C,0x8C,0xF2) }, { 100, RGB(0x30,0x70,0xE2) } };
+    static const struct sg_stop h_hover[]  = { { 0, RGB(0x9A,0xC4,0xFC) }, { 12, RGB(0x6C,0xA6,0xF8) }, { 100, RGB(0x48,0x88,0xEE) } };
+    static const struct sg_stop h_active[] = { { 0, RGB(0x14,0x3C,0x96) }, { 20, RGB(0x1C,0x48,0xAA) }, { 100, RGB(0x28,0x5A,0xC6) } };
+    static const struct sg_stop g_normal[] = { { 0, RGB(0x7A,0x88,0x9A) }, { 48, RGB(0x4E,0x5C,0x6E) }, { 52, RGB(0x36,0x42,0x52) }, { 100, RGB(0x2C,0x38,0x48) } };
+    static const struct sg_stop g_hover[]  = { { 0, RGB(0x9C,0xB0,0xC8) }, { 48, RGB(0x68,0x80,0x9C) }, { 52, RGB(0x4A,0x5E,0x78) }, { 100, RGB(0x3A,0x4E,0x68) } };
+    static const struct sg_stop g_active[] = { { 0, RGB(0xB4,0xC6,0xDC) }, { 48, RGB(0x7C,0x94,0xB2) }, { 52, RGB(0x58,0x70,0x8E) }, { 100, RGB(0x46,0x5E,0x7C) } };
+    RECT r = *rect;
+
+    if (state == SG_FRAME_NONE) return;
+    if (sg_vertical()) InflateRect( &r, -3, -1 ); else InflateRect( &r, -1, sg_look == SG_LOOK_HORIZON ? -3 : -2 );
+    if (sg_look == SG_LOOK_HORIZON)
+    {
+        if (state == SG_FRAME_ACTIVE) sg_round_gradient( hdc, &r, 6, 6, h_active, ARRAY_SIZE(h_active), RGB(0x10,0x34,0x86) );
+        else if (state == SG_FRAME_HOVER) sg_round_gradient( hdc, &r, 6, 6, h_hover, ARRAY_SIZE(h_hover), RGB(0x22,0x58,0xC8) );
+        else sg_round_gradient( hdc, &r, 6, 6, h_normal, ARRAY_SIZE(h_normal), RGB(0x1C,0x4C,0xB8) );
+    }
+    else
+    {
+        if (state == SG_FRAME_ACTIVE) sg_round_gradient( hdc, &r, 6, 6, g_active, ARRAY_SIZE(g_active), RGB(0xD8,0xE4,0xF0) );
+        else if (state == SG_FRAME_HOVER) sg_round_gradient( hdc, &r, 6, 6, g_hover, ARRAY_SIZE(g_hover), RGB(0xB0,0xC0,0xD4) );
+        else sg_round_gradient( hdc, &r, 6, 6, g_normal, ARRAY_SIZE(g_normal), RGB(0x86,0x94,0xA6) );
+    }
+}
+
+static COLORREF sg_shade( COLORREF c, int percent )   /* lighter (+) or darker (-) */
+{
+    if (percent >= 0)
+        return RGB( GetRValue(c) + (255 - GetRValue(c)) * percent / 100, GetGValue(c) + (255 - GetGValue(c)) * percent / 100,
+                    GetBValue(c) + (255 - GetBValue(c)) * percent / 100 );
+    return RGB( GetRValue(c) * (100 + percent) / 100, GetGValue(c) * (100 + percent) / 100, GetBValue(c) * (100 + percent) / 100 );
+}
+
+/* Horizon's Start: a green button with a round end, the mark and the label */
+static void sg_draw_horizon_start( const DRAWITEMSTRUCT *dis, const RECT *rect )
+{
+    static const struct sg_stop green[] = {
+        { 0, RGB(0x86,0xD2,0x7E) }, { 10, RGB(0x52,0xB2,0x4A) }, { 45, RGB(0x3C,0x9C,0x36) },
+        { 85, RGB(0x30,0x86,0x2C) }, { 100, RGB(0x24,0x6C,0x22) } };
+    struct sg_stop stops[ARRAY_SIZE(green)];
+    int shade = (dis->itemState & ODS_SELECTED) ? -18 : (dis->itemState & ODS_HOTLIGHT) ? 14 : 0, i;
+    RECT r = *rect, mark;
+
+    for (i = 0; i < ARRAY_SIZE(green); i++)
+    {
+        stops[i].at = green[i].at;
+        stops[i].color = sg_shade( green[i].color, shade );
+    }
+    if (sg_vertical()) sg_round_gradient( dis->hDC, &r, 14, 14, stops, ARRAY_SIZE(stops), RGB(0x1C,0x5C,0x1A) );
+    else
+    {
+        /* square at the screen's edge, round at the other end */
+        r.left -= 24;
+        sg_round_gradient( dis->hDC, &r, 26, r.bottom - r.top, stops, ARRAY_SIZE(stops), RGB(0x1C,0x5C,0x1A) );
+    }
+    mark = *rect;
+    if (!sg_vertical())
+    {
+        mark.left += 4;
+        mark.right = mark.left + (rect->bottom - rect->top);
+    }
+    sg_draw_start_mark( dis->hDC, &mark );
+    if (!sg_vertical())
+    {
+        NONCLIENTMETRICSW ncm;
+        LOGFONTW lf;
+        HFONT font, old;
+        RECT t = *rect;
+
+        ncm.cbSize = sizeof(ncm);
+        SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+        lf = ncm.lfCaptionFont;
+        lf.lfWeight = FW_BOLD;
+        lf.lfItalic = TRUE;
+        lf.lfHeight = -16;
+        font = CreateFontIndirectW( &lf );
+        old = SelectObject( dis->hDC, font );
+        SetBkMode( dis->hDC, TRANSPARENT );
+        t.left = mark.right;
+        t.right -= 8;
+        OffsetRect( &t, 1, 1 );
+        SetTextColor( dis->hDC, RGB(0x1A,0x4A,0x18) );
+        DrawTextW( dis->hDC, start_label, -1, &t, DT_LEFT | DT_VCENTER | DT_SINGLELINE );
+        OffsetRect( &t, -1, -1 );
+        SetTextColor( dis->hDC, RGB(0xFF,0xFF,0xFF) );
+        DrawTextW( dis->hDC, start_label, -1, &t, DT_LEFT | DT_VCENTER | DT_SINGLELINE );
+        SelectObject( dis->hDC, old );
+        DeleteObject( font );
+    }
+}
