+/* Glass's Start: a round orb, deep blue-green, lit from above, the mark in it */
+static void sg_draw_glass_orb( const DRAWITEMSTRUCT *dis, const RECT *rect )
+{
+    int cx = (rect->left + rect->right) / 2, cy = (rect->top + rect->bottom) / 2;
+    int d = min( rect->right - rect->left, rect->bottom - rect->top ) - 4, rad = d / 2, i;
+    int shade = (dis->itemState & ODS_SELECTED) ? -20 : (dis->itemState & ODS_HOTLIGHT) ? 22 : 0;
+    COLORREF rim = sg_shade( RGB(0x08,0x2A,0x3E), shade ), core = sg_shade( RGB(0x1C,0x8C,0xB4), shade );
+    HPEN oldp = SelectObject( dis->hDC, GetStockObject( NULL_PEN ));
+    RECT inner;
+    int saved;
+
+    /* from the rim in: a light core low in the orb, as if lit through it */
+    for (i = 0; i < rad; i++)
+    {
+        HBRUSH brush = CreateSolidBrush( sg_mix( rim, core, i * 100 / rad ) ), oldb = SelectObject( dis->hDC, brush );
+        int r = rad - i;
+        Ellipse( dis->hDC, cx - r, cy - r + i / 2, cx + r + 1, cy + r + 1 );
+        SelectObject( dis->hDC, oldb );
+        DeleteObject( brush );
+    }
+    SelectObject( dis->hDC, oldp );
+    /* the gloss over its upper half */
+    {
+        static const struct sg_stop gloss[] = { { 0, RGB(0xE6,0xF4,0xFA) }, { 100, RGB(0x3C,0x8C,0xAE) } };
+        struct sg_stop g[2] = { { 0, sg_shade( gloss[0].color, shade / 2 ) }, { 100, sg_shade( gloss[1].color, shade ) } };
+        RECT gr = { cx - rad * 3 / 4, cy - rad + 2, cx + rad * 3 / 4, cy + 1 };
+        saved = SaveDC( dis->hDC );
+        BeginPath( dis->hDC );
+        Ellipse( dis->hDC, gr.left, gr.top, gr.right, gr.bottom + (gr.bottom - gr.top) / 3 );
+        EndPath( dis->hDC );
+        SelectClipPath( dis->hDC, RGN_AND );
+        if (sg_vertical())
+        {
+            /* the gradient runs down the orb on either bar */
+            TRIVERTEX v[2] = { { gr.left, gr.top }, { gr.right, gr.bottom } };
+            GRADIENT_RECT r2 = { 0, 1 };
+            v[0].Red = GetRValue( g[0].color ) << 8; v[0].Green = GetGValue( g[0].color ) << 8; v[0].Blue = GetBValue( g[0].color ) << 8;
+            v[1].Red = GetRValue( g[1].color ) << 8; v[1].Green = GetGValue( g[1].color ) << 8; v[1].Blue = GetBValue( g[1].color ) << 8;
+            GdiGradientFill( dis->hDC, v, 2, &r2, 1, GRADIENT_FILL_RECT_V );
+        }
+        else sg_gradient( dis->hDC, &gr, g, 2 );
+        RestoreDC( dis->hDC, saved );
+    }
+    /* a thin light rim */
+    {
+        HPEN pen = CreatePen( PS_SOLID, 1, sg_shade( RGB(0x7C,0xB8,0xD0), shade ) );
+        HBRUSH oldb = SelectObject( dis->hDC, GetStockObject( NULL_BRUSH ));
+        oldp = SelectObject( dis->hDC, pen );
+        Ellipse( dis->hDC, cx - rad, cy - rad, cx + rad + 1, cy + rad + 1 );
+        SelectObject( dis->hDC, oldb );
+        SelectObject( dis->hDC, oldp );
+        DeleteObject( pen );
+    }
+    SetRect( &inner, cx - rad * 3 / 4 - 4, cy - rad * 3 / 4 - 4, cx + rad * 3 / 4 + 4, cy + rad * 3 / 4 + 4 );
+    sg_draw_start_mark( dis->hDC, &inner );
+}
