From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: ActivateKeyboardLayout's KLF_REORDER, KLF_RESET and KLF_SHIFTLOCK (9163)

ActivateKeyboardLayout printed a FIXME for every flag but
KLF_SETFORPROCESS and ignored them. On Windows:

- KLF_REORDER moves the layout to the front of the loaded layouts, which
  GetKeyboardLayoutList and HKL_NEXT go by: now the loaded list
  (LoadKeyboardLayout's, Software\Wine\Temporary System Parameters\Keyboard
  Layout\Loaded) is reordered, as LoadKeyboardLayout's KLF_REORDER already
  did. The session's own layouts (the display server's groups) keep the
  person's order.
- KLF_RESET sets how Caps Lock is turned off -- by Caps Lock again, or with
  KLF_SHIFTLOCK by either Shift key -- and Windows keeps it in the user's
  profile: HKCU\Keyboard Layout "Attributes" (KLF_SHIFTLOCK), where its
  Advanced Key Settings write it. It is written there now. The display
  server owns Caps Lock here; the keymap is the session's.
- KLF_NOTELLSHELL is 9160's; LoadKeyboardLayout's own flags (KLF_ACTIVATE,
  KLF_SUBSTITUTE_OK, KLF_UNLOADPREVIOUS, KLF_REPLACELANG) mean nothing here,
  as on Windows. Others are a WARN, not a FIXME.

Gate test/kbdklf-gate.sh. Mutant SG_MUTANT_KBD_KLF_FIXME.
---
 dlls/win32u/input.c | 56 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 56 insertions(+)

--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -1432,6 +1432,32 @@ static BOOL is_loaded_layout( HKL layout )
     return FALSE;
 }
 
+/* Stained Glass OS (9163): ActivateKeyboardLayout(KLF_REORDER) puts the layout first in the loaded list */
+static void reorder_loaded_layout( HKL layout )
+{
+    HKL list[128];
+    UINT i, count = get_loaded_layouts( ARRAY_SIZE(list), list );
+    HKEY hkey;
+
+    if (count == ~0u || count > ARRAY_SIZE(list)) return;
+    for (i = 0; i < count; i++) if (list[i] == layout) break;
+    if (!i || i == count) return;
+    memmove( list + 1, list, i * sizeof(*list) );
+    list[0] = layout;
+    if (!(hkey = reg_open_hkcu_key( "Software\\Wine\\Temporary System Parameters\\Keyboard Layout\\Loaded" ))) return;
+    for (i = 0; i < count; i++)
+    {
+        WCHAR name[16];
+        char num[16];
+        DWORD value = HandleToUlong( list[i] );
+
+        snprintf( num, sizeof(num), "%u", i + 1 );
+        asciiz_to_unicode( name, num );
+        set_reg_value( hkey, name, REG_DWORD, &value, sizeof(value) );
+    }
+    NtClose( hkey );
+}
+
 /* Stained Glass OS (9160): the shell is told the input language changed (HSHELL_LANGUAGE, the layout in
  * lParam): the input indicator beside the taskbar clock shows the layout the foreground window types with,
  * whether the person switched it (Windows logo key + Space, Left Alt + Shift, the indicator) or a program
@@ -1460,7 +1486,15 @@ HKL WINAPI NtUserActivateKeyboardLayout( HKL layout, UINT flags )
 
     TRACE_(keyboard)( "layout %p, flags %x\n", layout, flags );
 
+#ifdef SG_MUTANT_KBD_KLF_FIXME
     if (flags & ~KLF_SETFORPROCESS) FIXME_(keyboard)( "flags %x not supported\n", flags );
+#else
+    /* Stained Glass OS (9163): KLF_NOTELLSHELL (9160), KLF_REORDER, KLF_RESET and KLF_SHIFTLOCK are
+     * taken below; LoadKeyboardLayout's own flags mean nothing here, as on Windows */
+    if (flags & ~(KLF_SETFORPROCESS | KLF_NOTELLSHELL | KLF_REORDER | KLF_RESET | KLF_SHIFTLOCK |
+                  KLF_ACTIVATE | KLF_SUBSTITUTE_OK | KLF_UNLOADPREVIOUS | KLF_REPLACELANG))
+        WARN_(keyboard)( "flags %x ignored\n", flags );
+#endif
 
     if (layout == (HKL)HKL_NEXT || layout == (HKL)HKL_PREV)
     {
@@ -1493,6 +1527,28 @@ HKL WINAPI NtUserActivateKeyboardLayout( HKL layout, UINT flags )
         return 0;
     }
 
+#ifndef SG_MUTANT_KBD_KLF_FIXME
+    /* Stained Glass OS (9163): KLF_RESET sets how Caps Lock is turned off -- by Caps Lock again, or with
+     * KLF_SHIFTLOCK by either Shift key -- which Windows keeps in the person's profile, HKCU\Keyboard
+     * Layout "Attributes" (KLF_SHIFTLOCK, as the Advanced Key Settings write it). The display server
+     * owns Caps Lock here: the setting is kept, its keymap is the session's (sg-session). */
+    if (flags & KLF_RESET)
+    {
+        static const WCHAR attributesW[] = {'A','t','t','r','i','b','u','t','e','s',0};
+        HKEY key;
+        DWORD attributes = flags & KLF_SHIFTLOCK;
+
+        if ((key = reg_create_ascii_key( hkcu_key, "Keyboard Layout", 0, NULL )))
+        {
+            set_reg_value( key, attributesW, REG_DWORD, &attributes, sizeof(attributes) );
+            NtClose( key );
+        }
+    }
+    /* KLF_REORDER: the layout goes to the front of the loaded list (LoadKeyboardLayout's), which
+     * GetKeyboardLayoutList and HKL_NEXT go by; without it the list keeps its order */
+    if (flags & KLF_REORDER) reorder_loaded_layout( layout );
+#endif
+
     /* Stained Glass OS (9156): the layout before, taken before the driver may switch the session's
      * keyboard -- a thread that never activated one has the keyboard's, which is the new one after */
     old_layout = get_thread_kbd_layout( info );
