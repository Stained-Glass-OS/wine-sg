From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: pixel format colour context, class factory LockServer (3630)

windowscodecs: pixel format colour context, class factory LockServer

windowscodecs: IWICPixelFormatInfo::GetColorContext (Exif sRGB, uncalibrated for float formats); IClassFactory::LockServer S_OK. The 18 IStream E_NOTIMPL items are Windows behaviour (stream.c tests). Gate fastb-gapwic; mutants SG_MUTANT_WICLOCK, WICCTX. Conformance 64/32: 0 failures as stock. Unverified: the colour context returned on Windows for each format is not documented. Mutants WICLOCK and WICCTX shown caught.
---
diff --git a/dlls/windowscodecs/clsfactory.c b/dlls/windowscodecs/clsfactory.c
index 2dddad2..c6d0960 100644
--- a/dlls/windowscodecs/clsfactory.c
+++ b/dlls/windowscodecs/clsfactory.c
@@ -164,8 +164,13 @@ static HRESULT WINAPI ClassFactoryImpl_CreateInstance(IClassFactory *iface,
 
 static HRESULT WINAPI ClassFactoryImpl_LockServer(IClassFactory *iface, BOOL lock)
 {
-    TRACE("(%p, %i): stub\n", iface, lock);
+    /* The module has no unload logic (DllCanUnloadNow keeps it loaded), so
+     * a lock needs no bookkeeping. */
+    TRACE("(%p, %i)\n", iface, lock);
+#ifdef SG_MUTANT_WICLOCK
     return E_NOTIMPL;
+#endif
+    return S_OK;
 }
 
 static const IClassFactoryVtbl ClassFactoryImpl_Vtbl = {
diff --git a/dlls/windowscodecs/info.c b/dlls/windowscodecs/info.c
index a1fc6d4..40aef10 100644
--- a/dlls/windowscodecs/info.c
+++ b/dlls/windowscodecs/info.c
@@ -1461,8 +1461,36 @@ static HRESULT WINAPI PixelFormatInfo_GetFormatGUID(IWICPixelFormatInfo2 *iface,
 static HRESULT WINAPI PixelFormatInfo_GetColorContext(IWICPixelFormatInfo2 *iface,
     IWICColorContext **ppIColorContext)
 {
-    FIXME("(%p,%p): stub\n", iface, ppIColorContext);
-    return E_NOTIMPL;
+    WICPixelFormatNumericRepresentation representation;
+    IWICColorContext *context;
+    HRESULT hr;
+
+    TRACE("(%p,%p)\n", iface, ppIColorContext);
+
+    if (!ppIColorContext)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = ColorContext_Create(&context)))
+        return hr;
+
+    /* The default colour space of a pixel format is sRGB; floating point
+     * formats are linear (scRGB), which has no Exif code: uncalibrated. */
+    if (FAILED(IWICPixelFormatInfo2_GetNumericRepresentation(iface, &representation)))
+        representation = WICPixelFormatNumericRepresentationUnspecified;
+    hr = IWICColorContext_InitializeFromExifColorSpace(context,
+            #ifdef SG_MUTANT_WICCTX
+            1);
+#else
+            representation == WICPixelFormatNumericRepresentationFloat ? 0xffff : 1);
+#endif
+    if (FAILED(hr))
+    {
+        IWICColorContext_Release(context);
+        return hr;
+    }
+
+    *ppIColorContext = context;
+    return S_OK;
 }
 
 static HRESULT WINAPI PixelFormatInfo_GetBitsPerPixel(IWICPixelFormatInfo2 *iface,
