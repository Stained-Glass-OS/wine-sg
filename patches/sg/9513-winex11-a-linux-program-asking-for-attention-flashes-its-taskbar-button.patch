From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a Linux program asking for attention flashes its taskbar button

A Windows program asks for attention with FlashWindowEx and its taskbar
button flashes orange (9931); a Linux program in its shell frame
(sg_embed.c) asked and nothing showed it -- a chat's new message, a
download done while it was behind (David 2026-11-27: Linux programs first
class).

A Linux program asks with its urgency hint (ICCCM WM_HINTS XUrgencyHint:
GTK's gtk_window_set_urgency_hint) or by asking the window manager for
_NET_WM_STATE_DEMANDS_ATTENTION (Qt's QApplication::alert, Telegram,
Electron's flashFrame). The state thread notes the latter on the window
(_SG_EMBED_ATTENTION, as it does full screen); the frame's thread hears
either change and its frame flashes as by FlashWindowEx(FLASHW_TRAY |
FLASHW_TIMERNOFG) -- until it comes to the front -- or stops (FLASHW_STOP)
when the program no longer asks.

Gate: test/linuxattention-gate.sh (mutant SG_MUTANT_EMBED_NO_ATTENTION).
---
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -84,6 +84,7 @@
     BOOL     maximized;   /* the frame is maximized (as the program knows it) */
     BOOL     minimized;   /* ...minimized (as the program knows it: WM_STATE) */
     BOOL     focused;     /* it has the X focus (_NET_WM_STATE_FOCUSED) */
+    BOOL     attention;   /* it asks for attention (9513): its frame flashes on the taskbar */
     Time     click_time;  /* the click into it that activates its frame (its press's time) */
     unsigned long serial; /* our last request sizing the program's window: its
                            * ConfigureNotify from before that is stale */
@@ -101,6 +102,16 @@
     return atom;
 }
 
+/* Stained Glass OS 9513: the program asks for attention -- a new message in
+ * a chat, a download done while it is behind (_NET_WM_STATE_DEMANDS_ATTENTION
+ * asked of the window manager, from the state thread to the frame's) */
+static Atom attention_atom( Display *display )
+{
+    static Atom atom;
+    if (!atom) atom = XInternAtom( display, "_SG_EMBED_ATTENTION", False );
+    return atom;
+}
+
 /* a move or size the program asked for (_NET_WM_MOVERESIZE's direction + 1),
  * from the state thread to the frame's */
 static Atom moveresize_atom( Display *display )
@@ -564,6 +575,9 @@
         /* maximized: Firefox restores itself so, asking at once */
         else if (a1 == max_v || a1 == max_h || a2 == max_v || a2 == max_h) ours = ours_max;
 #endif
+        /* attention (Qt's QApplication::alert, Telegram, Electron's flashFrame) */
+        else if (a1 == XInternAtom( d, "_NET_WM_STATE_DEMANDS_ATTENTION", False ) ||
+                 a2 == XInternAtom( d, "_NET_WM_STATE_DEMANDS_ATTENTION", False )) ours = attention_atom( d );
         else return;
         /* only a window we framed: its parent is not the root */
         if (!XQueryTree( d, ev.xclient.window, &r, &parent, &children, &n )) return;
@@ -1621,6 +1635,36 @@
         frame_fullscreen( hwnd, on, FALSE );
         return 0;
     }
+    case WM_X11DRV_SG_EMBED_ATTENTION:
+    {
+        /* the program asks for attention (9513): its frame flashes on the
+         * taskbar as a Windows program's FlashWindowEx does, until it comes
+         * to the front (FLASHW_TIMERNOFG); no longer asking, it stops */
+        XWMHints *hints;
+        FLASHWINFO info = { sizeof(info), hwnd, 0, 0, 0 };
+        BOOL on = FALSE, was;
+
+        X11DRV_expect_error( display, ignore_error, NULL );
+        if ((hints = XGetWMHints( display, child )))
+        {
+            on = (hints->flags & XUrgencyHint) != 0;
+            XFree( hints );
+        }
+        if (get_cardinal( display, child, attention_atom( display ) )) on = TRUE;
+        sync_check_error( display );
+        pthread_mutex_lock( &embed_mutex );
+        if ((e = find_hwnd( hwnd )))
+        {
+            was = e->attention;
+            e->attention = on;
+        }
+        else was = on;
+        pthread_mutex_unlock( &embed_mutex );
+        if (on == was) return 0;
+        info.dwFlags = on ? FLASHW_TRAY | FLASHW_TIMERNOFG : FLASHW_STOP;
+        NtUserFlashWindowEx( &info );
+        return 0;
+    }
     case WM_X11DRV_SG_EMBED_MAXIMIZE:
     {
         /* the program asked to be maximized or restored: its frame is */
@@ -1877,6 +1921,12 @@
 #endif
         else if (event->xproperty.atom == maximized_atom( display ))
             NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_MAXIMIZE, 0, 0 );
+#ifndef SG_MUTANT_EMBED_NO_ATTENTION
+        /* its urgency (ICCCM WM_HINTS, GTK's gtk_window_set_urgency_hint) or its
+         * _NET_WM_STATE_DEMANDS_ATTENTION (the state thread's) changed */
+        else if (event->xproperty.atom == XA_WM_HINTS || event->xproperty.atom == attention_atom( display ))
+            NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_ATTENTION, 0, 0 );
+#endif
         else if (event->xproperty.atom == activate_atom( display ) && event->xproperty.state == PropertyNewValue)
         {
             X11DRV_expect_error( display, ignore_error, NULL );
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3950,6 +3950,7 @@
     case WM_X11DRV_SG_EMBED_MAXIMIZE:
     case WM_X11DRV_SG_EMBED_FOCUS:
     case WM_X11DRV_SG_EMBED_MOVESIZE_DONE:
+    case WM_X11DRV_SG_EMBED_ATTENTION:
         return sg_embed_message( hwnd, msg, wp, lp );
     case WM_X11DRV_SG_GL_RESHOW:
         return sg_gl_reshow( hwnd );
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -710,7 +710,8 @@
     WM_X11DRV_SG_EMBED_MAXIMIZE,
     WM_X11DRV_SG_EMBED_FOCUS,
     WM_X11DRV_SG_EMBED_MOVESIZE_DONE,
-    WM_X11DRV_SG_GL_RESHOW         /* 6096: show the offscreen OpenGL frame again */
+    WM_X11DRV_SG_GL_RESHOW,        /* 6096: show the offscreen OpenGL frame again */
+    WM_X11DRV_SG_EMBED_ATTENTION   /* 9513: the Linux program in it asks for attention, or no longer */
 };
 
 /* a window whose OpenGL frames are rendered offscreen and copied into its top-level (6096) */
