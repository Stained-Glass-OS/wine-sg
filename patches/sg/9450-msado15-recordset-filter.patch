+/* ---- Stained Glass OS (wine-sg 9450): Filter ------------------------------------------------------
+ *
+ * As ADO's client cursor does, a filter is a view: the rows it hides are kept aside with their
+ * places, and come back where they were when the filter changes or goes. Criteria are clauses
+ * "field op value" joined by AND and OR, grouped with parentheses; an array of bookmarks; or one of
+ * the FilterGroupEnum values. A bookmark is a row's place in the unfiltered recordset, so bookmarks
+ * stay valid while a filter comes and goes. */
+
+#define SG_FILTER_NONE        0   /* adFilterNone */
+#define SG_FILTER_PENDING     1   /* adFilterPendingRecords */
+#define SG_FILTER_AFFECTED    2   /* adFilterAffectedRecords */
+#define SG_FILTER_FETCHED     3   /* adFilterFetchedRecords */
+#define SG_FILTER_CONFLICTING 5   /* adFilterConflictingRecords */
+
+struct filter_node
+{
+    enum { FILTER_CLAUSE, FILTER_AND, FILTER_OR } kind;
+    struct criteria c;
+    struct filter_node *left, *right;
+};
+
+static void filter_node_free( struct filter_node *node )
+{
+    if (!node) return;
+    filter_node_free( node->left );
+    filter_node_free( node->right );
+    if (node->kind == FILTER_CLAUSE) VariantClear( &node->c.value );
+    free( node );
+}
+
+/* AND or OR at p, a word of its own */
+static int filter_keyword( const WCHAR *start, const WCHAR *p )
+{
+    if (p > start && p[-1] != ' ' && p[-1] != ')') return 0;
+    if (!wcsnicmp( p, L"AND", 3 ) && (p[3] == ' ' || p[3] == '(')) return FILTER_AND;
+    if (!wcsnicmp( p, L"OR", 2 ) && (p[2] == ' ' || p[2] == '(')) return FILTER_OR;
+    return 0;
+}
+
+static HRESULT filter_parse_or( struct recordset *recordset, const WCHAR *start, const WCHAR **p,
+                                struct filter_node **ret );
+
+static HRESULT filter_parse_primary( struct recordset *recordset, const WCHAR *start, const WCHAR **p,
+                                     struct filter_node **ret )
+{
+    const WCHAR *q = *p, *end;
+    struct filter_node *node;
+    WCHAR quote = 0, *text;
+    HRESULT hr;
+
+    while (*q == ' ') q++;
+    if (*q == '(')
+    {
+        q++;
+        if (FAILED(hr = filter_parse_or( recordset, start, &q, ret ))) return hr;
+        while (*q == ' ') q++;
+        if (*q != ')') { filter_node_free( *ret ); *ret = NULL; return MAKE_ADO_HRESULT( adErrInvalidArgument ); }
+        *p = q + 1;
+        return S_OK;
+    }
+
+    /* a clause runs to the next AND, OR or closing parenthesis outside quotes, dates and brackets */
+    for (end = q; *end; end++)
+    {
+        if (quote)
+        {
+            if (*end == quote && !(quote == '\'' && end[1] == '\'')) quote = 0;
+            else if (*end == '\'' && quote == '\'') end++;
+            continue;
+        }
+        if (*end == '\'' || *end == '#') { quote = *end; continue; }
+        if (*end == '[') { quote = ']'; continue; }
+        if (*end == ')' || (end > q && filter_keyword( start, end ))) break;
+    }
+    if (end == q) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    if (!(text = malloc( (end - q + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    memcpy( text, q, (end - q) * sizeof(WCHAR) );
+    text[end - q] = 0;
+    if (!(node = calloc( 1, sizeof(*node) ))) { free( text ); return E_OUTOFMEMORY; }
+    node->kind = FILTER_CLAUSE;
+    hr = parse_criteria( recordset, text, &node->c );
+    free( text );
+    if (FAILED(hr)) { free( node ); return hr; }
+    *ret = node;
+    *p = end;
+    return S_OK;
+}
+
+static HRESULT filter_parse_and( struct recordset *recordset, const WCHAR *start, const WCHAR **p,
+                                 struct filter_node **ret )
+{
+    struct filter_node *left, *right, *node;
+    HRESULT hr;
+
+    if (FAILED(hr = filter_parse_primary( recordset, start, p, &left ))) return hr;
+    for (;;)
+    {
+        const WCHAR *q = *p;
+        while (*q == ' ') q++;
+        if (filter_keyword( start, q ) != FILTER_AND) break;
+        q += 3;
+        if (FAILED(hr = filter_parse_primary( recordset, start, &q, &right ))) { filter_node_free( left ); return hr; }
+        if (!(node = calloc( 1, sizeof(*node) ))) { filter_node_free( left ); filter_node_free( right ); return E_OUTOFMEMORY; }
+        node->kind = FILTER_AND;
+        node->left = left;
+        node->right = right;
+        left = node;
+        *p = q;
+    }
+    *ret = left;
+    return S_OK;
+}
+
+static HRESULT filter_parse_or( struct recordset *recordset, const WCHAR *start, const WCHAR **p,
+                                struct filter_node **ret )
+{
+    struct filter_node *left, *right, *node;
+    HRESULT hr;
+
+    if (FAILED(hr = filter_parse_and( recordset, start, p, &left ))) return hr;
+    for (;;)
+    {
+        const WCHAR *q = *p;
+        while (*q == ' ') q++;
+        if (filter_keyword( start, q ) != FILTER_OR) break;
+        q += 2;
+        if (FAILED(hr = filter_parse_and( recordset, start, &q, &right ))) { filter_node_free( left ); return hr; }
+        if (!(node = calloc( 1, sizeof(*node) ))) { filter_node_free( left ); filter_node_free( right ); return E_OUTOFMEMORY; }
+        node->kind = FILTER_OR;
+        node->left = left;
+        node->right = right;
+        left = node;
+        *p = q;
+    }
+    *ret = left;
+    return S_OK;
+}
+
+static HRESULT filter_parse( struct recordset *recordset, const WCHAR *text, struct filter_node **ret )
+{
+    const WCHAR *p = text;
+    HRESULT hr;
+
+    *ret = NULL;
+    if (FAILED(hr = filter_parse_or( recordset, text, &p, ret ))) return hr;
+    while (*p == ' ') p++;
+    if (*p)
+    {
+        filter_node_free( *ret );
+        *ret = NULL;
+        return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    }
+    return S_OK;
+}
+
+static BOOL filter_node_matches( struct recordset *recordset, const struct filter_node *node, LONG row )
+{
+    switch (node->kind)
+    {
+    case FILTER_AND: return filter_node_matches( recordset, node->left, row ) && filter_node_matches( recordset, node->right, row );
+    case FILTER_OR:  return filter_node_matches( recordset, node->left, row ) || filter_node_matches( recordset, node->right, row );
+    default:         return criteria_matches( recordset, &node->c, row );
+    }
+}
+
+/* a row's change record, or none */
+static struct row_track recordset_track_of( struct recordset *recordset, LONG row )
+{
+    struct row_track none = { TRACK_NONE, NULL };
+    return recordset->track && row < recordset->track_allocated ? recordset->track[row] : none;
+}
+
+/* the rows the filter hides come back to their places */
+static HRESULT filter_remove( struct recordset *recordset )
+{
+    LONG cols, total, i = 0, j = 0, n = 0, index, edit_row = -1, pending = 0;
+    struct row_track *track;
+    VARIANT *data;
+
+    if (!recordset->filtered) return S_OK;
+    cols = get_column_count( recordset );
+    total = recordset->count + recordset->hidden_count;
+    data = calloc( max( total, 1 ) * max( cols, 1 ), sizeof(*data) );
+    track = calloc( max( total, 1 ), sizeof(*track) );
+    if (!data || !track) { free( data ); free( track ); return E_OUTOFMEMORY; }
+
+    index = recordset->index < 0 ? -1 : recordset->index >= recordset->count ? total : -2;
+    while (i < recordset->count || j < recordset->hidden_count)
+    {
+        if (j >= recordset->hidden_count || (i < recordset->count && recordset->visible_pos[i] <= recordset->hidden_pos[j]))
+        {
+            memcpy( data + n * cols, recordset->data + i * cols, cols * sizeof(*data) );
+            track[n] = recordset_track_of( recordset, i );
+            if (index == -2 && recordset->index == i) index = n;
+            if (recordset->edit_backup && recordset->edit_row == i) edit_row = n;
+            if (recordset->pending_add == i + 1) pending = n + 1;
+            i++;
+        }
+        else
+        {
+            memcpy( data + n * cols, recordset->hidden + j * cols, cols * sizeof(*data) );
+            track[n] = recordset->hidden_track[j];
+            j++;
+        }
+        n++;
+    }
+    free( recordset->data );
+    free( recordset->track );
+    recordset->data = data;
+    recordset->allocated = max( total, 1 );
+    recordset->count = total;
+    recordset->track = track;
+    recordset->track_allocated = max( total, 1 );
+    recordset->index = index;
+    if (recordset->edit_backup) recordset->edit_row = edit_row >= 0 ? edit_row : recordset->edit_row;
+    if (recordset->pending_add) recordset->pending_add = pending;
+
+    free( recordset->hidden );
+    free( recordset->hidden_track );
+    free( recordset->hidden_pos );
+    free( recordset->visible_pos );
+    recordset->hidden = NULL;
+    recordset->hidden_track = NULL;
+    recordset->hidden_pos = recordset->visible_pos = NULL;
+    recordset->hidden_count = recordset->visible_alloc = 0;
+    recordset->filtered = FALSE;
+    return S_OK;
+}
+
+/* the rows the filter hides go (the recordset is closing) */
+static void filter_discard( struct recordset *recordset )
+{
+    LONG i, c, cols;
+
+    if (!recordset->filtered) return;
+    cols = get_column_count( recordset );
+    for (i = 0; i < recordset->hidden_count; i++)
+    {
+        for (c = 0; c < cols; c++) VariantClear( &recordset->hidden[i * cols + c] );
+        free_row_values( recordset, recordset->hidden_track[i].original );
+    }
+    free( recordset->hidden );
+    free( recordset->hidden_track );
+    free( recordset->hidden_pos );
+    free( recordset->visible_pos );
+    recordset->hidden = NULL;
+    recordset->hidden_track = NULL;
+    recordset->hidden_pos = recordset->visible_pos = NULL;
+    recordset->hidden_count = recordset->visible_alloc = 0;
+    recordset->filtered = FALSE;
+}
+
+/* is the value a bookmark of one of the rows in the array */
+static BOOL filter_bookmark_listed( SAFEARRAY *array, LONG bookmark )
+{
+    LONG lo, hi, k;
+
+    if (FAILED(SafeArrayGetLBound( array, 1, &lo )) || FAILED(SafeArrayGetUBound( array, 1, &hi ))) return FALSE;
+    for (k = lo; k <= hi; k++)
+    {
+        VARIANT item, i4;
+        BOOL match;
+
+        VariantInit( &item );
+        VariantInit( &i4 );
+        if (FAILED(SafeArrayGetElement( array, &k, &item ))) continue;
+        match = VariantChangeType( &i4, &item, 0, VT_I4 ) == S_OK && V_I4( &i4 ) == bookmark;
+        VariantClear( &item );
+        if (match) return TRUE;
+    }
+    return FALSE;
+}
+
+/* the rows the filter in criteria (an unfiltered recordset) does not show are set aside */
+static HRESULT filter_apply( struct recordset *recordset, const VARIANT *criteria )
+{
+    struct filter_node *tree = NULL;
+    LONG cols, i, kept = 0, hidden = 0, group = -1, total = recordset->count;
+    struct row_track *visible_track = NULL;
+    SAFEARRAY *bookmarks = NULL;
+    BOOL *show;
+    HRESULT hr = S_OK;
+
+    if (recordset->filtered || !recordset->fields) return S_OK;
+    if (V_VT(criteria) == VT_BSTR)
+    {
+        if (!V_BSTR(criteria) || !*V_BSTR(criteria)) return S_OK;
+        if (FAILED(hr = filter_parse( recordset, V_BSTR(criteria), &tree ))) return hr;
+    }
+    else if (V_VT(criteria) == VT_I2 || V_VT(criteria) == VT_I4)
+    {
+        group = V_VT(criteria) == VT_I2 ? V_I2(criteria) : V_I4(criteria);
+        if (group == SG_FILTER_NONE) return S_OK;
+        if (group != SG_FILTER_PENDING && group != SG_FILTER_AFFECTED && group != SG_FILTER_FETCHED &&
+            group != SG_FILTER_CONFLICTING)
+            return MAKE_ADO_HRESULT( adErrInvalidArgument );
+        /* no row's last batch update conflicted: the updates stop at the first failure and say so */
+        if (group == SG_FILTER_AFFECTED) FIXME( "adFilterAffectedRecords: all rows shown\n" );
+    }
+    else if (V_VT(criteria) == (VT_ARRAY | VT_VARIANT) && V_ARRAY(criteria) && SafeArrayGetDim( V_ARRAY(criteria) ) == 1)
+        bookmarks = V_ARRAY(criteria);
+    else
+        return MAKE_ADO_HRESULT( adErrInvalidArgument );
+
+    cols = get_column_count( recordset );
+    if (!(show = calloc( max( total, 1 ), sizeof(*show) ))) { filter_node_free( tree ); return E_OUTOFMEMORY; }
+    for (i = 0; i < total; i++)
+    {
+        if (tree) show[i] = filter_node_matches( recordset, tree, i );
+        else if (bookmarks) show[i] = filter_bookmark_listed( bookmarks, i );
+        else if (group == SG_FILTER_PENDING) show[i] = recordset_track_of( recordset, i ).state != TRACK_NONE;
+        else if (group == SG_FILTER_CONFLICTING) show[i] = FALSE;
+        else show[i] = TRUE;
+        if (show[i]) kept++; else hidden++;
+    }
+    filter_node_free( tree );
+#ifdef SG_MUTANT_ADO_FILTER_NONE
+    for (i = 0; i < total; i++) show[i] = TRUE;
+    kept = total; hidden = 0;
+#endif
+
+    recordset->hidden = calloc( max( hidden, 1 ) * max( cols, 1 ), sizeof(*recordset->hidden) );
+    recordset->hidden_track = calloc( max( hidden, 1 ), sizeof(*recordset->hidden_track) );
+    recordset->hidden_pos = calloc( max( hidden, 1 ), sizeof(*recordset->hidden_pos) );
+    recordset->visible_pos = calloc( max( recordset->allocated, 1 ), sizeof(*recordset->visible_pos) );
+    visible_track = calloc( max( recordset->allocated, 1 ), sizeof(*visible_track) );
+    if (!recordset->hidden || !recordset->hidden_track || !recordset->hidden_pos || !recordset->visible_pos || !visible_track)
+    {
+        free( recordset->hidden ); free( recordset->hidden_track ); free( recordset->hidden_pos );
+        free( recordset->visible_pos ); free( visible_track ); free( show );
+        recordset->hidden = NULL; recordset->hidden_track = NULL;
+        recordset->hidden_pos = recordset->visible_pos = NULL;
+        return E_OUTOFMEMORY;
+    }
+    recordset->visible_alloc = max( recordset->allocated, 1 );
+    recordset->hidden_count = 0;
+    kept = 0;
+    for (i = 0; i < total; i++)
+    {
+        if (show[i])
+        {
+            if (kept != i) memcpy( recordset->data + kept * cols, recordset->data + i * cols, cols * sizeof(*recordset->data) );
+            visible_track[kept] = recordset_track_of( recordset, i );
+            recordset->visible_pos[kept] = i;
+            if (recordset->edit_backup && recordset->edit_row == i) recordset->edit_row = kept;
+            if (recordset->pending_add == i + 1) recordset->pending_add = kept + 1;
+            kept++;
+        }
+        else
+        {
