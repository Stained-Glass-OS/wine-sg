+/* ---- TileBrush, ImageBrush (wine-sg 6227) ---- */
+
+static HRESULT get_int_prop( struct brush *brush, struct xaml_property *prop, INT32 *value, INT32 def )
+{
+    IInspectable *box = NULL;
+
+    if (!value) return E_POINTER;
+    dobj_get_value( &brush->d, prop, &box );
+    *value = xunbox_enum( box, NULL, def );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
