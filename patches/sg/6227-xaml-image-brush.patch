+static HRESULT WINAPI tile_get_AlignmentX( struct xiface *iface, INT32 *value )
+{ return get_int_prop( brush_from_iface( iface ), prop_alignment_x, value, 1 ); }
+static HRESULT WINAPI tile_put_AlignmentX( struct xiface *iface, INT32 value )
+{ return put_box( brush_from_iface( iface ), prop_alignment_x, xbox_int32( value ) ); }
+static HRESULT WINAPI tile_get_AlignmentY( struct xiface *iface, INT32 *value )
+{ return get_int_prop( brush_from_iface( iface ), prop_alignment_y, value, 1 ); }
+static HRESULT WINAPI tile_put_AlignmentY( struct xiface *iface, INT32 value )
