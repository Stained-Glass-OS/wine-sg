From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: NtWriteVirtualMemory checks page protection

NtWriteVirtualMemory handed every write to the server, whose ptrace write
also changes read-only memory, and reported success.  As on Windows it now
writes only to committed, unguarded, writable pages (read-write, write copy
and their executable forms), writes nothing past the first page it may not
and answers STATUS_PARTIAL_COPY with the number of bytes before it; this
holds for the process itself and for another process (whose protections come
from a virtual query).  WriteProcessMemory still makes execute-read pages
writable first.  The todo_wine marks this satisfies are removed from the
kernel32 virtual test.

---
--- a/dlls/kernel32/tests/virtual.c
+++ b/dlls/kernel32/tests/virtual.c
@@ -210,10 +210,8 @@
     if (!b) ok( GetLastError() == ERROR_NOACCESS, "wrong error %lu\n", GetLastError() );
     ok( bytes_written == 0xdeadbeef, "%Iu bytes written\n", bytes_written );
     status = pNtWriteVirtualMemory( hProcess, addr1, src, alloc_size, &bytes_written );
-    todo_wine
     ok( status == STATUS_PARTIAL_COPY || broken(status == STATUS_ACCESS_VIOLATION),
         "wrong status %lx\n", status );
-    todo_wine
     ok( bytes_written == 0, "%Iu bytes written\n", bytes_written );
 
     b = VirtualProtectEx( hProcess, addr1, alloc_size, PAGE_EXECUTE_READ, &old_prot );
@@ -224,21 +222,17 @@
     ok( bytes_written == alloc_size, "%Iu bytes written\n", bytes_written );
     bytes_written = 0xdeadbeef;
     status = pNtWriteVirtualMemory( hProcess, addr1, src, alloc_size, &bytes_written );
-    todo_wine
     ok( status == STATUS_PARTIAL_COPY || broken(status == STATUS_ACCESS_VIOLATION),
         "wrong status %lx\n", status );
-    todo_wine
     ok( bytes_written == 0, "%Iu bytes written\n", bytes_written );
 
     b = VirtualProtectEx( hProcess, addr1, 0x2000, PAGE_EXECUTE_READWRITE, &old_prot );
     ok( b, "VirtualProtectEx, error %lu\n", GetLastError() );
     bytes_written = 0xdeadbeef;
     b = WriteProcessMemory(hProcess, addr1, src, alloc_size, &bytes_written);
-    todo_wine
     ok( !b || broken(b), /* <= win10 1507 */ "WriteProcessMemory succeeded\n" );
     bytes_written = 0xdeadbeef;
     status = pNtWriteVirtualMemory( hProcess, addr1, src, alloc_size, &bytes_written );
-    todo_wine
     ok( status == STATUS_PARTIAL_COPY || broken(status == STATUS_SUCCESS), /* <= win10 1507 */
         "wrong status %lx\n", status );
     ok( bytes_written == (status ? 0x2000 : alloc_size), "%Iu bytes written\n", bytes_written );
@@ -247,10 +241,8 @@
     ok( b, "VirtualProtectEx, error %lu\n", GetLastError() );
     bytes_written = 0xdeadbeef;
     b = WriteProcessMemory(hProcess, addr1, src, alloc_size, &bytes_written);
-    todo_wine
     ok( !b || broken(b), /* <= win10 1507 */ "WriteProcessMemory succeeded\n" );
     status = pNtWriteVirtualMemory( hProcess, addr1, src, alloc_size, &bytes_written );
-    todo_wine
     ok( status == STATUS_PARTIAL_COPY || broken(status == STATUS_SUCCESS), /* <= win10 1507 */
         "wrong status %lx\n", status );
     ok( bytes_written == (status ? 0x2000 : alloc_size), "%Iu bytes written\n", bytes_written );
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -6235,6 +6235,47 @@
 }
 
 
+/* Stained Glass OS: how much of the range, from its start, the process lets
+ * NtWriteVirtualMemory write -- committed and writable (read-write, write
+ * copy and their executable forms), not guarded. Windows writes nothing past
+ * the first page it may not and answers STATUS_PARTIAL_COPY; the server's
+ * write goes through ptrace and would also change read-only memory. */
+static SIZE_T get_writable_size( HANDLE process, char *addr, SIZE_T size )
+{
+    SIZE_T done = 0;
+
+#ifdef SG_MUTANT_WRITE_VM_NO_CHECK
+    return size;
+#endif
+    while (done < size)
+    {
+        MEMORY_BASIC_INFORMATION info;
+        char *region_end;
+        SIZE_T step;
+
+        /* what cannot be queried (a process not started yet answers no
+         * virtual queries) is left to the server's write, as before
+         * (integrator, round 3) */
+        if (get_basic_memory_info( process, addr + done, &info, sizeof(info), NULL )) return size;
+        if (info.State != MEM_COMMIT || (info.Protect & PAGE_GUARD)) break;
+        switch (info.Protect & ~(PAGE_NOCACHE | PAGE_WRITECOMBINE))
+        {
+        case PAGE_READWRITE:
+        case PAGE_WRITECOPY:
+        case PAGE_EXECUTE_READWRITE:
+        case PAGE_EXECUTE_WRITECOPY:
+            break;
+        default:
+            return done;
+        }
+        region_end = (char *)info.BaseAddress + info.RegionSize;
+        step = min( (SIZE_T)(region_end - (addr + done)), size - done );
+        if (!step) break;
+        done += step;
+    }
+    return done;
+}
+
 /***********************************************************************
  *             NtWriteVirtualMemory   (NTDLL.@)
  *             ZwWriteVirtualMemory   (NTDLL.@)
@@ -6243,17 +6284,26 @@
                                       SIZE_T size, SIZE_T *bytes_written )
 {
     unsigned int status;
+    SIZE_T writable = size;
 
     if (virtual_check_buffer_for_read( buffer, size ))
     {
-        SERVER_START_REQ( write_process_memory )
+        if (size && (char *)addr + size >= (char *)addr) writable = get_writable_size( process, addr, size );
+        else if (size) writable = 0;
+        if (writable)
         {
-            req->handle     = wine_server_obj_handle( process );
-            req->addr       = wine_server_client_ptr( addr );
-            wine_server_add_data( req, buffer, size );
-            if ((status = wine_server_call( req ))) size = 0;
+            SERVER_START_REQ( write_process_memory )
+            {
+                req->handle     = wine_server_obj_handle( process );
+                req->addr       = wine_server_client_ptr( addr );
+                wine_server_add_data( req, buffer, writable );
+                if ((status = wine_server_call( req ))) writable = 0;
+            }
+            SERVER_END_REQ;
+            if (!status && writable < size) status = STATUS_PARTIAL_COPY;
         }
-        SERVER_END_REQ;
+        else status = size ? STATUS_PARTIAL_COPY : STATUS_SUCCESS;
+        size = writable;
     }
     else
     {
