--- a/programs/explorer/fileexplorer.c
+++ b/programs/explorer/fileexplorer.c
@@ -1768,6 +1768,68 @@
 
 /* what the user typed in the address bar: a folder, a shell location, a
  * program or a document; a Unix path works too */
+/* Stained Glass OS: a network place that cannot be reached, as Windows' File Explorer tells it
+ * (wine-sg 9658): "Network Error" with the path, what to check, and the error code and its
+ * text under "See details"; Diagnose opens the network's status in Settings. A refused share
+ * says it needs permission. It said "can't find '\\server\share'. Check the spelling", or
+ * opened an empty folder for a computer that is not there. */
+static BOOL network_error(const WCHAR *path, HRESULT hr)
+{
+    WCHAR main[MAX_PATH + 64], details[512], text[400] = L"";
+    TASKDIALOGCONFIG tc = { sizeof(tc) };
+    TASKDIALOG_BUTTON buttons[] = { { 100, L"&Diagnose" } };
+    DWORD code = HRESULT_FACILITY(hr) == FACILITY_WIN32 ? HRESULT_CODE(hr) : 0;
+    int button = 0;
+
+#ifdef SG_MUTANT_NO_NETWORK_ERROR
+    return FALSE;
+#endif
+    if (path[0] != '\\' || path[1] != '\\') return FALSE;
+    switch (code)
+    {
+    case ERROR_BAD_NETPATH: case ERROR_BAD_NET_NAME: case ERROR_ACCESS_DENIED: case ERROR_LOGON_FAILURE:
+    case ERROR_NETWORK_UNREACHABLE: case ERROR_HOST_UNREACHABLE: case ERROR_UNEXP_NET_ERR: case ERROR_BAD_DEV_TYPE:
+        break;
+    default:
+        return FALSE;
+    }
+    FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL, code, 0, text, ARRAY_SIZE(text), NULL);
+    StrTrimW(text, L"\r\n ");
+    swprintf(details, ARRAY_SIZE(details), L"Error code: 0x%08lX\n%s", (unsigned long)hr, text);
+    tc.hwndParent = fe.hwnd;
+    tc.pszWindowTitle = L"Network Error";
+    tc.pszExpandedInformation = details;
+    tc.pszExpandedControlText = L"Hide details";
+    tc.pszCollapsedControlText = L"See details";
+    if (code == ERROR_ACCESS_DENIED || code == ERROR_LOGON_FAILURE)
+    {
+        swprintf(main, ARRAY_SIZE(main), L"You do not have permission to access %s.", path);
+        tc.pszMainIcon = TD_ERROR_ICON;
+        tc.pszMainInstruction = main;
+        tc.pszContent = L"Contact your network administrator to request access.";
+        tc.dwCommonButtons = TDCBF_CLOSE_BUTTON;
+    }
+    else
+    {
+        swprintf(main, ARRAY_SIZE(main), L"File Explorer cannot access %s", path);
+        tc.pszMainIcon = TD_ERROR_ICON;
+        tc.pszMainInstruction = main;
+        tc.pszContent = L"Check the spelling of the name. Otherwise, there might be a problem with your network. "
+                        L"To try to identify and resolve network problems, click Diagnose.";
+        tc.pButtons = buttons;
+        tc.cButtons = ARRAY_SIZE(buttons);
+        tc.dwCommonButtons = TDCBF_CANCEL_BUTTON;
+    }
+    if (FAILED(TaskDialogIndirect(&tc, &button, NULL, NULL)))
+    {
+        swprintf(details, ARRAY_SIZE(details), L"%s\n\nError code: 0x%08lX\n%s", main, (unsigned long)hr, text);
+        MessageBoxW(fe.hwnd, details, L"Network Error", MB_OK | MB_ICONERROR);
+    }
+    else if (button == 100)
+        ShellExecuteW(fe.hwnd, NULL, L"ms-settings:network-status", NULL, NULL, SW_SHOWNORMAL);
+    return TRUE;
+}
