+    case ENOENT: case ENXIO: return STATUS_BAD_NETWORK_NAME;
+    case EACCES: case EPERM: case EKEYREJECTED: return STATUS_ACCESS_DENIED;
+    default: return STATUS_BAD_DEVICE_TYPE;
+    }
+}
