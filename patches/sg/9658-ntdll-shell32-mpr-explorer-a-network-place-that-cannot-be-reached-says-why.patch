-/* Stained Glass OS: a share that refuses a guest -- a Windows PC's, as
- * Windows 10 and 11 set them -- asks for a name and password, as Windows'
- * "Enter network credentials" does, and connects with them for this user
- * (WNetAddConnection2 -> ntlanman -> sg-netmountd LOGON). It showed an empty
- * folder. A Cancel is remembered for a little while: a tree view binds to a
- * share more than once. */
-static void net_logon_if_needed(HWND owner, const WCHAR *server, const WCHAR *share)
+/* Stained Glass OS: whether a computer is there to be asked for its shares (wine-sg 9658).
+ * \\NOSUCHPC opened an empty folder; Windows says "The network path was not found."
+ * (0x80070035). The computer is looked up as a share is reached -- sg-netmountd's name
+ * lookup, a domain's controllers included, and whether SMB answers -- by asking for its IPC$
+ * share: ERROR_BAD_NETPATH means nothing is there, anything else (IPC$ is never a folder to
+ * mount) that a file server answered. Answers are kept for a little while: a path is parsed
+ * through its computer often. */
+static DWORD net_computer_error(const WCHAR *server)
+{
+    static struct { WCHAR name[64]; DWORD tick, err; } seen[8];
+    static unsigned int next;
+    WCHAR ipc[MAX_PATH];
+    DWORD err;
+    unsigned int i;
+
+#ifdef SG_MUTANT_NET_ANY_COMPUTER
+    return 0;
+#endif
+    for (i = 0; i < ARRAY_SIZE(seen); i++)
+        if (seen[i].name[0] && !wcsicmp(seen[i].name, server) && GetTickCount() - seen[i].tick < 30000) return seen[i].err;
+    swprintf(ipc, ARRAY_SIZE(ipc), L"\\\\%s\\IPC$", server);
+    SetLastError(0);
+    err = GetFileAttributesW(ipc) != INVALID_FILE_ATTRIBUTES ? 0 : GetLastError();
+    err = err == ERROR_BAD_NETPATH ? ERROR_BAD_NETPATH : 0;
+    i = next++ % ARRAY_SIZE(seen);
+    lstrcpynW(seen[i].name, server, ARRAY_SIZE(seen[i].name));
+    seen[i].tick = GetTickCount();
+    seen[i].err = err;
+    return err;
+}
+
+static BOOL net_refused(DWORD err)
+{
+    return err == ERROR_ACCESS_DENIED || err == ERROR_LOGON_FAILURE || err == ERROR_INVALID_PASSWORD ||
+           err == ERROR_BAD_USERNAME || err == ERROR_NOT_AUTHENTICATED;
+}
