+/* Copies the image on a surface to a bottom-up (or, for a negative height,
+ * top-down) 32-bit RGB bitmap, preceded by its header. */
+HRESULT vmr7_copy_surface_image(IDirectDrawSurface7 *surface,
+        const BITMAPINFOHEADER *src_bih, LONG *size, LONG *image)
+{
+    DDSURFACEDESC2 desc = {.dwSize = sizeof(desc)};
+    LONG i, rows, size_left;
+    BITMAPINFOHEADER bih;
+    HRESULT hr = S_OK;
+    DWORD *row;
+    char *dst;
+
+    /* The image is always returned as 32-bit RGB. */
+    bih = *src_bih;
+    bih.biBitCount = 32;
+    bih.biCompression = BI_RGB;
+    bih.biSizeImage = bih.biWidth * abs(bih.biHeight) * 4;
+
+    if (!image)
+    {
+        *size = sizeof(BITMAPINFOHEADER) + bih.biSizeImage;
+        return S_OK;
+    }
+
+    if (FAILED(hr = IDirectDrawSurface7_Lock(surface, NULL, &desc, DDLOCK_READONLY | DDLOCK_WAIT, NULL)))
+        return hr;
+
+    size_left = *size;
+    memcpy(image, &bih, min(size_left, sizeof(BITMAPINFOHEADER)));
+    size_left -= sizeof(BITMAPINFOHEADER);
+
+    dst = (char *)image + sizeof(BITMAPINFOHEADER);
+    rows = abs(bih.biHeight);
+    if (!(row = malloc(bih.biWidth * 4)))
+        hr = E_OUTOFMEMORY;
+
+    for (i = 0; SUCCEEDED(hr) && i < rows && size_left > 0; ++i)
+    {
+        /* Surfaces hold the frame top-down; a positive height asks for a bottom-up bitmap. */
+        LONG src_y = bih.biHeight > 0 ? rows - 1 - i : i;
+        LONG row_size = bih.biWidth * 4;
+
+        if (!convert_row(src_bih->biCompression, src_bih->biBitCount, desc.lpSurface,
+                desc.lPitch, desc.dwHeight, bih.biWidth, src_y, row))
+        {
+            FIXME("Unhandled format, compression %#lx, depth %u.\n",
+                    src_bih->biCompression, src_bih->biBitCount);
+            hr = E_NOTIMPL;
+            break;
+        }
+        memcpy(dst, row, min(row_size, size_left));
+        dst += row_size;
+        size_left -= row_size;
+    }
+
+    free(row);
+    IDirectDrawSurface7_Unlock(surface, NULL);
+    return hr;
+}
+
+static HRESULT present_surface(struct vmr7_presenter *presenter, IDirectDrawSurface7 *surface)
+{
+    POINT point;
+    HRESULT hr;
+    RECT rect;
+
+    GetClientRect(presenter->window, &rect);
+    point.x = point.y = 0;
+    ClientToScreen(presenter->window, &point);
+    OffsetRect(&rect, point.x, point.y);
+    if (FAILED(hr = IDirectDrawSurface7_Blt(presenter->primary, &rect, surface, NULL, DDBLT_WAIT, NULL)))
+        ERR("Failed to blit, hr %#lx.\n", hr);
+    return hr;
+}
