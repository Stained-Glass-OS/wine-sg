+static BYTE clamp_byte(int value)
+{
+    return value < 0 ? 0 : value > 255 ? 255 : value;
+}
+
+static DWORD yuv_to_rgb(int y, int u, int v)
+{
+    int c = y - 16, d = u - 128, e = v - 128;
+
+    return (clamp_byte((298 * c + 409 * e + 128) >> 8) << 16)
+            | (clamp_byte((298 * c - 100 * d - 208 * e + 128) >> 8) << 8)
+            | clamp_byte((298 * c + 516 * d + 128) >> 8);
+}
+
+/* Converts one row of a locked surface to 32-bit RGB. */
+static BOOL convert_row(DWORD fourcc, WORD depth, const BYTE *surface, LONG pitch, LONG surface_height,
+        LONG width, LONG y, DWORD *dst)
+{
+    const BYTE *row = surface + y * pitch;
+    LONG x;
+
+    if (fourcc == BI_RGB)
+    {
+        switch (depth)
+        {
+            case 32:
+                memcpy(dst, row, width * 4);
+                return TRUE;
+            case 24:
+                for (x = 0; x < width; ++x)
+                    dst[x] = row[x * 3] | (row[x * 3 + 1] << 8) | (row[x * 3 + 2] << 16);
+                return TRUE;
+            case 16:
+                for (x = 0; x < width; ++x)
+                {
+                    WORD pixel = ((const WORD *)row)[x];
+
+                    dst[x] = (((pixel >> 10) & 0x1f) * 255 / 31) << 16
+                            | (((pixel >> 5) & 0x1f) * 255 / 31) << 8 | ((pixel & 0x1f) * 255 / 31);
+                }
+                return TRUE;
+        }
+        return FALSE;
+    }
+
+    if (fourcc == mmioFOURCC('Y','U','Y','2') || fourcc == mmioFOURCC('U','Y','V','Y'))
+    {
+        BOOL uyvy = fourcc == mmioFOURCC('U','Y','V','Y');
+
+        for (x = 0; x < width; ++x)
+        {
+            const BYTE *pair = row + (x & ~1) * 2;
+            int luma = pair[uyvy ? 1 + (x & 1) * 2 : (x & 1) * 2];
+            int u = pair[uyvy ? 0 : 1], v = pair[uyvy ? 2 : 3];
+
+            dst[x] = yuv_to_rgb(luma, u, v);
+        }
+        return TRUE;
+    }
+
+    if (fourcc == mmioFOURCC('N','V','1','2'))
+    {
+        const BYTE *chroma = surface + surface_height * pitch + (y / 2) * pitch;
+
+        for (x = 0; x < width; ++x)
+            dst[x] = yuv_to_rgb(row[x], chroma[(x & ~1)], chroma[(x & ~1) + 1]);
+        return TRUE;
+    }
+
+    if (fourcc == mmioFOURCC('Y','V','1','2'))
+    {
+        const BYTE *v_plane = surface + surface_height * pitch;
+        const BYTE *u_plane = v_plane + (surface_height / 2) * (pitch / 2);
+
+        for (x = 0; x < width; ++x)
+            dst[x] = yuv_to_rgb(row[x], u_plane[(y / 2) * (pitch / 2) + x / 2],
+                    v_plane[(y / 2) * (pitch / 2) + x / 2]);
+        return TRUE;
+    }
+
+    return FALSE;
+}
