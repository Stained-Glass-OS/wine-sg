+static UINT get_monitor_count(void)
+{
+    struct get_available_monitors_args args = {0};
+
+    EnumDisplayMonitors(NULL, NULL, get_available_monitors_proc, (LPARAM)&args);
+    return args.count;
+}
+
+/* Monitor 0 is the default DirectDraw device (a NULL GUID pointer); the other
+ * monitors are identified by the GUIDs get_available_monitors_proc() builds. */
+static HRESULT guid_to_monitor(const VMRGUID *guid, UINT *monitor)
+{
+    static const GUID zero_guid;
+    GUID expect;
+    UINT index;
+
+    if (!guid->pGUID)
+    {
+        *monitor = 0;
+        return S_OK;
+    }
+
+    index = guid->pGUID->Data4[7];
+    expect = zero_guid;
+    expect.Data4[7] = index;
+#ifndef SG_MUTANT_VMR7_MONITOR
+    if (!index || !IsEqualGUID(guid->pGUID, &expect) || index >= get_monitor_count())
+        return E_INVALIDARG;
+#endif
+
+    *monitor = index;
+    return S_OK;
+}
+
+static void monitor_to_guid(UINT monitor, VMRGUID *guid)
+{
+    memset(guid, 0, sizeof(*guid));
+    if (monitor)
+    {
+        guid->pGUID = &guid->GUID;
+        guid->GUID.Data4[7] = monitor;
+    }
+}
+
