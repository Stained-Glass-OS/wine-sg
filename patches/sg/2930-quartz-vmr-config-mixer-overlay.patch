+static HRESULT validate_alpha_bitmap(const VMR9AlphaBitmap *bitmap)
+{
+    if (bitmap->dwFlags & ~(VMR9AlphaBitmap_Disable | VMR9AlphaBitmap_hDC | VMR9AlphaBitmap_EntireDDS
+            | VMR9AlphaBitmap_SrcColorKey | VMR9AlphaBitmap_SrcRect | VMR9AlphaBitmap_FilterMode))
+        return E_INVALIDARG;
+
+    if (bitmap->dwFlags & VMR9AlphaBitmap_Disable)
+        return S_OK;
+
+    if (!(bitmap->dwFlags & VMR9AlphaBitmap_hDC) && !bitmap->pDDS)
+        return E_INVALIDARG;
+    if ((bitmap->dwFlags & VMR9AlphaBitmap_hDC) && !bitmap->hdc)
+        return E_INVALIDARG;
+    if (!is_valid_normalized_rect(&bitmap->rDest))
+        return E_INVALIDARG;
+    if (!(bitmap->fAlpha >= 0.0f && bitmap->fAlpha <= 1.0f))
+        return E_INVALIDARG;
+    if ((bitmap->dwFlags & VMR9AlphaBitmap_SrcRect) && IsRectEmpty(&bitmap->rSrc))
+        return E_INVALIDARG;
+    return S_OK;
+}
