+static HRESULT get_ideal_video_size(struct vmr7_presenter *presenter, BOOL max, LONG *width, LONG *height)
+{
+    MONITORINFO info = {.cbSize = sizeof(info)};
+
+    if (!width || !height)
+        return E_POINTER;
+
+    if (!presenter->window)
+        return VFW_E_WRONG_STATE;
+
+    if (!max)
+    {
+        *width = *height = 1;
+    }
+    else
+    {
+        GetMonitorInfoW(MonitorFromWindow(presenter->window, MONITOR_DEFAULTTOPRIMARY), &info);
+        *width = info.rcMonitor.right + 1;
+        *height = info.rcMonitor.bottom + 1;
+    }
+    return S_OK;
+}
