+static HRESULT restore_surfaces(struct vmr7 *filter)
+{
+    HRESULT hr = S_OK;
+    DWORD i;
+
+    for (i = 0; i < filter->surface_count; ++i)
+    {
+        HRESULT lost = IDirectDrawSurface7_IsLost(filter->surfaces[i]);
+
+        if (lost == DDERR_SURFACELOST)
+            hr = IDirectDrawSurface7_Restore(filter->surfaces[i]);
+        if (FAILED(hr))
+            break;
+    }
+    return hr;
+}
