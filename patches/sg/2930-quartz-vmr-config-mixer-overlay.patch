+static HRESULT get_ideal_video_size(struct vmr7 *filter, BOOL max, LONG *width, LONG *height)
+{
+    MONITORINFO info = {.cbSize = sizeof(info)};
+    HMONITOR monitor;
+
+    if (!width || !height)
+        return E_POINTER;
+
+    EnterCriticalSection(&filter->renderer.filter.filter_cs);
+    if (!filter->renderer.sink.pin.peer)
+    {
+        LeaveCriticalSection(&filter->renderer.filter.filter_cs);
+        return VFW_E_NOT_CONNECTED;
+    }
+
+    if (!max)
+    {
+        *width = *height = 1;
+    }
+    else
+    {
+        monitor = MonitorFromWindow(filter->clipping_window, MONITOR_DEFAULTTOPRIMARY);
+        GetMonitorInfoW(monitor, &info);
+        *width = info.rcMonitor.right + 1;
+        *height = info.rcMonitor.bottom + 1;
+    }
+    LeaveCriticalSection(&filter->renderer.filter.filter_cs);
+    return S_OK;
+}
