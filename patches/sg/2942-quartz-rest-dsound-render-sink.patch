From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: DirectSound renderer IQualityControl::SetSink, IAMDirectSound, LockServer

quartz's DirectSound renderer: IQualityControl::SetSink keeps the sink
without referencing it and returns S_OK; Notify stays E_NOTIMPL (audio
cannot be thinned out). The IAMDirectSound methods are not supported by
the renderer (E_NOTIMPL is the documented answer), so their FIXMEs are
dropped; so is the one of the class factory's LockServer (S_OK).

---
diff --git a/dlls/quartz/dsoundrender.c b/dlls/quartz/dsoundrender.c
index 59609a3..3caee49 100644
--- a/dlls/quartz/dsoundrender.c
+++ b/dlls/quartz/dsoundrender.c
@@ -73,6 +73,8 @@ struct dsound_render
 
     LONG volume;
     LONG pan;
+
+    IQualityControl *quality_sink;
 };
 
 static struct dsound_render *impl_from_strmbase_pin(struct strmbase_pin *iface)
@@ -918,8 +920,10 @@ static HRESULT WINAPI direct_sound_GetDirectSoundInterface(IAMDirectSound *iface
 {
     struct dsound_render *filter = impl_from_IAMDirectSound(iface);
 
-    FIXME("(%p/%p)->(%p): stub\n", filter, iface, ds);
+    TRACE("(%p/%p)->(%p)\n", filter, iface, ds);
 
+    /* The DirectSound renderer does not hand out its DirectSound objects or
+     * take a focus window through this obsolete interface. */
     return E_NOTIMPL;
 }
 
@@ -927,8 +931,10 @@ static HRESULT WINAPI direct_sound_GetPrimaryBufferInterface(IAMDirectSound *ifa
 {
     struct dsound_render *filter = impl_from_IAMDirectSound(iface);
 
-    FIXME("(%p/%p)->(%p): stub\n", filter, iface, buf);
+    TRACE("(%p/%p)->(%p)\n", filter, iface, buf);
 
+    /* The DirectSound renderer does not hand out its DirectSound objects or
+     * take a focus window through this obsolete interface. */
     return E_NOTIMPL;
 }
 
@@ -936,8 +942,10 @@ static HRESULT WINAPI direct_sound_GetSecondaryBufferInterface(IAMDirectSound *i
 {
     struct dsound_render *filter = impl_from_IAMDirectSound(iface);
 
-    FIXME("(%p/%p)->(%p): stub\n", filter, iface, buf);
+    TRACE("(%p/%p)->(%p)\n", filter, iface, buf);
 
+    /* The DirectSound renderer does not hand out its DirectSound objects or
+     * take a focus window through this obsolete interface. */
     return E_NOTIMPL;
 }
 
@@ -945,8 +953,10 @@ static HRESULT WINAPI direct_sound_ReleaseDirectSoundInterface(IAMDirectSound *i
 {
     struct dsound_render *filter = impl_from_IAMDirectSound(iface);
 
-    FIXME("(%p/%p)->(%p): stub\n", filter, iface, ds);
+    TRACE("(%p/%p)->(%p)\n", filter, iface, ds);
 
+    /* The DirectSound renderer does not hand out its DirectSound objects or
+     * take a focus window through this obsolete interface. */
     return E_NOTIMPL;
 }
 
@@ -954,8 +964,10 @@ static HRESULT WINAPI direct_sound_ReleasePrimaryBufferInterface(IAMDirectSound
 {
     struct dsound_render *filter = impl_from_IAMDirectSound(iface);
 
-    FIXME("(%p/%p)->(%p): stub\n", filter, iface, buf);
+    TRACE("(%p/%p)->(%p)\n", filter, iface, buf);
 
+    /* The DirectSound renderer does not hand out its DirectSound objects or
+     * take a focus window through this obsolete interface. */
     return E_NOTIMPL;
 }
 
@@ -963,8 +975,10 @@ static HRESULT WINAPI direct_sound_ReleaseSecondaryBufferInterface(IAMDirectSoun
 {
     struct dsound_render *filter = impl_from_IAMDirectSound(iface);
 
-    FIXME("(%p/%p)->(%p): stub\n", filter, iface, buf);
+    TRACE("(%p/%p)->(%p)\n", filter, iface, buf);
 
+    /* The DirectSound renderer does not hand out its DirectSound objects or
+     * take a focus window through this obsolete interface. */
     return E_NOTIMPL;
 }
 
@@ -972,8 +986,10 @@ static HRESULT WINAPI direct_sound_SetFocusWindow(IAMDirectSound *iface, HWND hw
 {
     struct dsound_render *filter = impl_from_IAMDirectSound(iface);
 
-    FIXME("(%p/%p)->(%p,%d): stub\n", filter, iface, hwnd, bgaudible);
+    TRACE("(%p/%p)->(%p,%d)\n", filter, iface, hwnd, bgaudible);
 
+    /* The DirectSound renderer does not hand out its DirectSound objects or
+     * take a focus window through this obsolete interface. */
     return E_NOTIMPL;
 }
 
@@ -981,8 +997,10 @@ static HRESULT WINAPI direct_sound_GetFocusWindow(IAMDirectSound *iface, HWND *h
 {
     struct dsound_render *filter = impl_from_IAMDirectSound(iface);
 
-    FIXME("(%p/%p)->(%p,%p): stub\n", filter, iface, hwnd, bgaudible);
+    TRACE("(%p/%p)->(%p,%p)\n", filter, iface, hwnd, bgaudible);
 
+    /* The DirectSound renderer does not hand out its DirectSound objects or
+     * take a focus window through this obsolete interface. */
     return E_NOTIMPL;
 }
 
@@ -1030,9 +1048,10 @@ static HRESULT WINAPI quality_control_Notify(IQualityControl *iface,
 {
     struct dsound_render *filter = impl_from_IQualityControl(iface);
 
-    FIXME("filter %p, sender %p, type %#x, proportion %ld, late %s, timestamp %s, stub!\n",
+    TRACE("filter %p, sender %p, type %#x, proportion %ld, late %s, timestamp %s.\n",
             filter, sender, q.Type, q.Proportion, debugstr_time(q.Late), debugstr_time(q.TimeStamp));
 
+    /* Audio cannot be thinned out to catch up, so quality messages are not handled. */
     return E_NOTIMPL;
 }
 
@@ -1040,9 +1059,16 @@ static HRESULT WINAPI quality_control_SetSink(IQualityControl *iface, IQualityCo
 {
     struct dsound_render *filter = impl_from_IQualityControl(iface);
 
-    FIXME("filter %p, sink %p, stub!\n", filter, sink);
+    TRACE("filter %p, sink %p.\n", filter, sink);
 
+    /* The sink is not referenced, as the interface contract requires. */
+    EnterCriticalSection(&filter->filter.filter_cs);
+    filter->quality_sink = sink;
+    LeaveCriticalSection(&filter->filter.filter_cs);
+#ifdef SG_MUTANT_DS_SINK
     return E_NOTIMPL;
+#endif
+    return S_OK;
 }
 
 static const IQualityControlVtbl quality_control_vtbl =
diff --git a/dlls/quartz/main.c b/dlls/quartz/main.c
index d8da7bd..9f673aa 100644
--- a/dlls/quartz/main.c
+++ b/dlls/quartz/main.c
@@ -167,7 +167,7 @@ static HRESULT WINAPI DSCF_CreateInstance(IClassFactory *iface, IUnknown *pOuter
 
 static HRESULT WINAPI DSCF_LockServer(IClassFactory *iface, BOOL lock)
 {
-    FIXME("iface %p, lock %d, stub!\n", iface, lock);
+    TRACE("iface %p, lock %d.\n", iface, lock);
     return S_OK;
 }
 
