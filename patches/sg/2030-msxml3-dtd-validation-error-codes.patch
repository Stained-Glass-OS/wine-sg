From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msxml3: DTD validation error codes (2030)

IXMLDOMDocument::validate / validateNode report the msxml error code of
the first DTD violation instead of the generic invalid-document code:
undeclared element, unknown ID, empty where content is required, root
name mismatch, invalid content, undefined attribute, fixed attribute,
bad attribute value, illegal text in element content, missing required
attribute. Ten todo_wine marks in the domdoc DTD validation test removed.
---
--- a/dlls/msxml3/domdoc.c
+++ b/dlls/msxml3/domdoc.c
@@ -2915,6 +2915,53 @@
     va_end(ap);
 }
 
+/* The code of the first DTD validity error libxml2 raises, as msxml reports it */
+static BOOL xml_text_is_blank(const xmlChar *text)
+{
+    for (; *text; text++)
+        if (*text != ' ' && *text != '\t' && *text != '\r' && *text != '\n') return FALSE;
+    return TRUE;
+}
+
+static LONG dtd_error_code(const xmlError *err)
+{
+    const xmlNode *node = err->node, *child;
+
+    switch (err->code)
+    {
+    case XML_DTD_CONTENT_MODEL:
+#ifndef SG_MUTANT_DTD_REFINE
+        /* an element that has no content, or has text where only elements may be */
+        if (node && node->type == XML_ELEMENT_NODE)
+        {
+            if (!node->children) return E_XML_EMPTY_NOT_ALLOWED;
+            for (child = node->children; child; child = child->next)
+                if ((child->type == XML_TEXT_NODE || child->type == XML_CDATA_SECTION_NODE) &&
+                    child->content && !xml_text_is_blank(child->content))
+                    return E_XML_ILLEGAL_TEXT;
+        }
+#endif
+        return E_XML_INVALID_CONTENT;
+    case XML_DTD_UNKNOWN_ELEM:       return E_XML_ELEMENT_UNDECLARED;
+    case XML_DTD_UNKNOWN_ID:         return E_XML_ELEMENT_ID_NOT_FOUND;
+    case XML_DTD_NOT_EMPTY:          return E_XML_EMPTY_NOT_ALLOWED;
+    case XML_DTD_ROOT_NAME:          return E_XML_ROOT_NAME_MISMATCH;
+    case XML_DTD_UNKNOWN_ATTRIBUTE:  return E_XML_ATTRIBUTE_NOT_DEFINED;
+    case XML_DTD_ATTRIBUTE_DEFAULT:  return E_XML_ATTRIBUTE_FIXED;
+    case XML_DTD_ATTRIBUTE_VALUE:    return E_XML_ATTRIBUTE_VALUE;
+    case XML_DTD_NOT_PCDATA:         return E_XML_ILLEGAL_TEXT;
+    case XML_DTD_MISSING_ATTRIBUTE:  return E_XML_REQUIRED_ATTRIBUTE_MISSING;
+    default:                         return E_XML_INVALID;
+    }
+}
+
+static void validate_serror(void *ctx, const xmlError *err)
+{
+    LONG *code = ctx;
+    LIBXML2_CALLBACK_SERROR(domdoc_validateNode, err);
+    if (code && !*code && err && err->domain == XML_FROM_VALID) *code = dtd_error_code(err);
+}
+
 static HRESULT WINAPI domdoc_validateNode(
     IXMLDOMDocument3* iface,
     IXMLDOMNode* node,
@@ -2961,17 +3008,29 @@
     if (get_doc(This)->intSubset || get_doc(This)->extSubset)
     {
         xmlValidCtxtPtr vctx = xmlNewValidCtxt();
+        LONG xml_code = 0;
+        int ok;
+        void *old_ctx = xmlStructuredErrorContext;
+        xmlStructuredErrorFunc old_func = xmlStructuredError;
+
         vctx->error = validate_error;
         vctx->warning = validate_warning;
         ++validated;
 
-        if (!((node == (IXMLDOMNode*)iface)?
+        xmlSetStructuredErrorFunc(&xml_code, validate_serror);
+        ok = (node == (IXMLDOMNode*)iface) ?
               xmlValidateDocument(vctx, get_doc(This)) :
-              xmlValidateElement(vctx, get_doc(This), get_node_obj(node)->node)))
+              xmlValidateElement(vctx, get_doc(This), get_node_obj(node)->node);
+        xmlSetStructuredErrorFunc(old_ctx, old_func);
+
+        if (!ok)
         {
-            /* TODO: get a real error code here */
-            TRACE("DTD validation failed\n");
+            TRACE("DTD validation failed, error %#lx\n", xml_code);
+#ifdef SG_MUTANT_DTD_CODE
             err_code = E_XML_INVALID;
+#else
+            err_code = xml_code ? xml_code : E_XML_INVALID;
+#endif
             hr = S_FALSE;
         }
         xmlFreeValidCtxt(vctx);
