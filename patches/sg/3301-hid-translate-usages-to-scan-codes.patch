From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 02:12:51 -0700
Subject: [PATCH] hid: HidP_TranslateUsagesToI8042ScanCodes (3301)

CORE review: input (hid.dll and hidparse.sys, shared source).

HidP_TranslateUsagesToI8042ScanCodes returned STATUS_NOT_IMPLEMENTED.
Keyboard usages (page 7) now translate to scan code set 1 make and break
codes through the caller's insert routine, in list order up to a zero or
the length; the modifier state structure follows the modifiers and the
three lock keys; an unmapped usage is HIDP_STATUS_I8242_TRANS_UNKNOWN and
stops the translation. Print screen is e0 2a e0 37 (make) and e0 b7 e0 aa
(break), pause is e1 1d 45 e1 9d c5 with no break code. Adds
HidP_TranslateUsageAndPagesToI8042ScanCodes to hidparse.sys (keyboard page
only).

Test: test/fasthidtranslate-gate.sh (mutants SG_MUTANT_HIDT_*).

diff --git a/dlls/hid/hidp.c b/dlls/hid/hidp.c
index c24a981..0cdf217 100644
--- a/dlls/hid/hidp.c
+++ b/dlls/hid/hidp.c
@@ -682,15 +682,196 @@ NTSTATUS WINAPI HidP_UnsetUsages( HIDP_REPORT_TYPE report_type, USAGE usage_page
     return HIDP_STATUS_SUCCESS;
 }
 
+/* Scan code set 1 for the keyboard usages (page 7): the make code; 0x100 is the
+ * extended prefix (0xe0). Print screen and pause are longer and are special cased. */
+#define SC_EXT 0x100
+#define SC_PRINT_SCREEN 0x200
+#define SC_PAUSE 0x300
+
+static const WORD keyboard_usage_scan_codes[0x66 + 1] =
+{
+    /* 00 */ 0, 0, 0, 0, 0x1e, 0x30, 0x2e, 0x20, 0x12, 0x21, 0x22, 0x23, 0x17, 0x24, 0x25, 0x26,
+    /* 10 */ 0x32, 0x31, 0x18, 0x19, 0x10, 0x13, 0x1f, 0x14, 0x16, 0x2f, 0x11, 0x2d, 0x15, 0x2c, 0x02, 0x03,
+    /* 20 */ 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x1c, 0x01, 0x0e, 0x0f, 0x39, 0x0c, 0x0d, 0x1a,
+    /* 30 */ 0x1b, 0x2b, 0x2b, 0x27, 0x28, 0x29, 0x33, 0x34, 0x35, 0x3a, 0x3b, 0x3c, 0x3d, 0x3e, 0x3f, 0x40,
+    /* 40 */ 0x41, 0x42, 0x43, 0x44,
+#ifdef SG_MUTANT_HIDT_TABLE
+              0x56,
+#else
+              0x57,
+#endif
+              0x58, SC_PRINT_SCREEN, 0x46, SC_PAUSE, SC_EXT | 0x52, SC_EXT | 0x47,
+              SC_EXT | 0x49, SC_EXT | 0x53, SC_EXT | 0x4f, SC_EXT | 0x51, SC_EXT | 0x4d,
+    /* 50 */ SC_EXT | 0x4b, SC_EXT | 0x50, SC_EXT | 0x48, 0x45, SC_EXT | 0x35, 0x37, 0x4a, 0x4e,
+              SC_EXT | 0x1c, 0x4f, 0x50, 0x51, 0x4b, 0x4c, 0x4d, 0x47,
+    /* 60 */ 0x48, 0x49, 0x52, 0x53, 0x56, SC_EXT | 0x5d, SC_EXT | 0x5e,
+};
+
+static BOOL keyboard_usage_scan_code( USHORT usage, USHORT *code )
+{
+    /* modifiers */
+    static const WORD modifiers[8] = { 0x1d, 0x2a, 0x38, SC_EXT | 0x5b, SC_EXT | 0x1d, 0x36, SC_EXT | 0x38, SC_EXT | 0x5c };
+    /* the keypad equals sign, F13..F24, the international and language keys */
+    switch (usage)
+    {
+    case 0x67: *code = 0x59; return TRUE;
+    case 0x68: case 0x69: case 0x6a: case 0x6b: case 0x6c: case 0x6d: case 0x6e: case 0x6f:
+        *code = 0x64 + (usage - 0x68); return TRUE;           /* F13..F20 */
+    case 0x70: case 0x71: case 0x72:
+        *code = 0x6c + (usage - 0x70); return TRUE;           /* F21..F23 */
+    case 0x73: *code = 0x76; return TRUE;                     /* F24 */
+    case 0x87: *code = 0x73; return TRUE;
+    case 0x88: *code = 0x70; return TRUE;
+    case 0x89: *code = 0x7d; return TRUE;
+    case 0x8a: *code = 0x79; return TRUE;
+    case 0x8b: *code = 0x7b; return TRUE;
+    }
+    if (usage >= 0xe0 && usage <= 0xe7) { *code = modifiers[usage - 0xe0]; return TRUE; }
+    if (usage < ARRAY_SIZE(keyboard_usage_scan_codes) && keyboard_usage_scan_codes[usage])
+    {
+        *code = keyboard_usage_scan_codes[usage];
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* the state bit of a usage the modifier state structure follows */
+static ULONG keyboard_modifier_bit( USHORT usage )
+{
+    if (usage >= 0xe0 && usage <= 0xe7) return 1u << (usage - 0xe0);
+    switch (usage)
+    {
+    case 0x39: return 1u << 8;         /* caps lock */
+    case 0x47: return 1u << 9;         /* scroll lock */
+    case 0x53: return 1u << 10;        /* num lock */
+    }
+    return 0;
+}
+
+static NTSTATUS translate_keyboard_usage( USHORT usage, HIDP_KEYBOARD_DIRECTION action,
+                                          HIDP_KEYBOARD_MODIFIER_STATE *state,
+                                          PHIDP_INSERT_SCANCODES insert, void *context )
+{
+    CHAR codes[6];
+    USHORT code;
+    ULONG length = 0, bit;
+    BOOL make = action == HidP_Keyboard_Make;
+
+#ifdef SG_MUTANT_HIDT_UNKNOWN
+    if (!keyboard_usage_scan_code( usage, &code )) return HIDP_STATUS_SUCCESS;
+#else
+    if (!keyboard_usage_scan_code( usage, &code )) return HIDP_STATUS_I8242_TRANS_UNKNOWN;
+#endif
+
+#ifdef SG_MUTANT_HIDT_NOMOD
+    if (0)
+#else
+    if (state && (bit = keyboard_modifier_bit( usage )))
+#endif
+    {
+        if (make) state->ul |= bit;
+#ifndef SG_MUTANT_HIDT_MODCLR
+        else state->ul &= ~bit;
+#endif
+    }
+
+    if (code == SC_PRINT_SCREEN)
+    {
+        /* e0 2a e0 37 down, e0 b7 e0 aa up */
+#ifdef SG_MUTANT_HIDT_PRTSC
+        codes[length++] = 0xe0; codes[length++] = 0x2a;
+        codes[length++] = 0xe0; codes[length++] = 0x37;
+#else
+        codes[length++] = 0xe0; codes[length++] = make ? 0x2a : 0xb7;
+        codes[length++] = 0xe0; codes[length++] = make ? 0x37 : 0xaa;
+#endif
+    }
+    else if (code == SC_PAUSE)
+    {
+        /* e1 1d 45 e1 9d c5 down, nothing up */
+#ifndef SG_MUTANT_HIDT_PAUSEBRK
+        if (!make) return HIDP_STATUS_SUCCESS;
+#endif
+        codes[length++] = 0xe1; codes[length++] = 0x1d; codes[length++] = 0x45;
+        codes[length++] = 0xe1; codes[length++] = 0x9d; codes[length++] = 0xc5;
+    }
+    else
+    {
+#ifndef SG_MUTANT_HIDT_NOEXT
+        if (code & SC_EXT) codes[length++] = 0xe0;
+#endif
+#ifdef SG_MUTANT_HIDT_NOBRK
+        codes[length++] = (code & 0xff);
+#else
+        codes[length++] = (code & 0xff) | (make ? 0 : 0x80);
+#endif
+    }
+
+    /* a scan code is at most four bytes: the pause key goes in two pieces */
+#ifdef SG_MUTANT_HIDT_INSFAIL
+    insert( context, codes, length );
+    return HIDP_STATUS_SUCCESS;
+#endif
+    if (length > 4)
+    {
+        if (!insert( context, codes, 3 )) return HIDP_STATUS_BUFFER_TOO_SMALL;
+        if (!insert( context, codes + 3, length - 3 )) return HIDP_STATUS_BUFFER_TOO_SMALL;
+    }
+    else if (!insert( context, codes, length )) return HIDP_STATUS_BUFFER_TOO_SMALL;
+    return HIDP_STATUS_SUCCESS;
+}
+
 NTSTATUS WINAPI HidP_TranslateUsagesToI8042ScanCodes(USAGE *ChangedUsageList,
     ULONG UsageListLength, HIDP_KEYBOARD_DIRECTION KeyAction,
     HIDP_KEYBOARD_MODIFIER_STATE *ModifierState,
     PHIDP_INSERT_SCANCODES InsertCodesProcedure, VOID *InsertCodesContext)
 {
-    FIXME( "ChangedUsageList %p, UsageListLength %lu, KeyAction %u, ModifierState %p, InsertCodesProcedure %p, InsertCodesContext %p stub!\n",
+    NTSTATUS status;
+    ULONG i;
+
+    TRACE( "ChangedUsageList %p, UsageListLength %lu, KeyAction %u, ModifierState %p, InsertCodesProcedure %p, InsertCodesContext %p.\n",
+           ChangedUsageList, UsageListLength, KeyAction, ModifierState, InsertCodesProcedure, InsertCodesContext );
+
+    if (!ChangedUsageList || !InsertCodesProcedure) return HIDP_STATUS_NULL;
+
+    /* a zero usage ends the list */
+#if defined(SG_MUTANT_HIDT_NOZERO)
+    for (i = 0; i < UsageListLength; ++i)
+#elif defined(SG_MUTANT_HIDT_NOLEN)
+    for (i = 0; ChangedUsageList[i]; ++i)
+#else
+    for (i = 0; i < UsageListLength && ChangedUsageList[i]; ++i)
+#endif
+    {
+        status = translate_keyboard_usage( ChangedUsageList[i], KeyAction, ModifierState,
+                                           InsertCodesProcedure, InsertCodesContext );
+        if (status != HIDP_STATUS_SUCCESS) return status;
+    }
+    return HIDP_STATUS_SUCCESS;
+}
+
+NTSTATUS WINAPI HidP_TranslateUsageAndPagesToI8042ScanCodes(USAGE_AND_PAGE *ChangedUsageList,
+    ULONG UsageListLength, HIDP_KEYBOARD_DIRECTION KeyAction,
+    HIDP_KEYBOARD_MODIFIER_STATE *ModifierState,
+    PHIDP_INSERT_SCANCODES InsertCodesProcedure, VOID *InsertCodesContext)
+{
+    NTSTATUS status;
+    ULONG i;
+
+    TRACE( "ChangedUsageList %p, UsageListLength %lu, KeyAction %u, ModifierState %p, InsertCodesProcedure %p, InsertCodesContext %p.\n",
            ChangedUsageList, UsageListLength, KeyAction, ModifierState, InsertCodesProcedure, InsertCodesContext );
 
-    return STATUS_NOT_IMPLEMENTED;
+    if (!ChangedUsageList || !InsertCodesProcedure) return HIDP_STATUS_NULL;
+
+    for (i = 0; i < UsageListLength && ChangedUsageList[i].Usage; ++i)
+    {
+        /* only the keyboard page has scan codes here */
+        if (ChangedUsageList[i].UsagePage != HID_USAGE_PAGE_KEYBOARD) return HIDP_STATUS_I8242_TRANS_UNKNOWN;
+        status = translate_keyboard_usage( ChangedUsageList[i].Usage, KeyAction, ModifierState,
+                                           InsertCodesProcedure, InsertCodesContext );
+        if (status != HIDP_STATUS_SUCCESS) return status;
+    }
+    return HIDP_STATUS_SUCCESS;
 }
 
 static NTSTATUS get_button_caps( const struct hid_value_caps *caps, void *user )
