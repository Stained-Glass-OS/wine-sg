+    }
+    for (i = 0; i < count; i++) SysFreeString(strings[i]);
+    free(strings);
+    SysFreeString(delimiter);
+    if (!ret) return E_OUTOFMEMORY;
+    return return_bstr(res, ret);
 }
 
