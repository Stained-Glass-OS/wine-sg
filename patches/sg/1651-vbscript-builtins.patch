+        else if (vt == VT_BSTR) { V_VT(&v) = VT_BSTR; hres = SafeArrayGetElement(sa, &i, &V_BSTR(&v)); }
+        else
+        {
+            V_VT(&v) = vt;
+            hres = SafeArrayGetElement(sa, &i, &V_I8(&v));
+        }
+        if (SUCCEEDED(hres))
+        {
+            if (V_VT(&v) == VT_NULL || V_VT(&v) == VT_EMPTY) (*strings)[*count] = SysAllocString(L"");
+            else if (SUCCEEDED(hres = VariantChangeType(&str, &v, 0, VT_BSTR))) (*strings)[*count] = V_BSTR(&str);
+        }
+        VariantClear(&v);
+        if (FAILED(hres))
+        {
+            while (*count) SysFreeString((*strings)[--*count]);
+            free(*strings);
+            *strings = NULL;
+            return MAKE_VBSERROR(VBSE_TYPE_MISMATCH);
+        }
+        (*count)++;
+    }
+    return S_OK;
+}
