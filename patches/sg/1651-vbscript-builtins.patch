+/* Erase (Stained Glass OS 1651): a fixed-size array keeps its size and its
+ * elements are emptied; a dynamic array is left with no elements at all, so
+ * UBound on it raises "subscript out of range" until it is ReDim'd again. */
+static HRESULT interp_erase(exec_ctx_t *ctx)
+{
+    BSTR identifier = ctx->instr->arg1.bstr;
+    SAFEARRAY *sa;
+    VARIANT *v;
+    ref_t ref;
+    HRESULT hres;
+
+    TRACE("%s\n", debugstr_w(identifier));
+#ifdef SG_MUTANT_ERASE_NOOP
+    return S_OK;
+#endif
+
+    hres = lookup_identifier(ctx, identifier, VBDISP_LET, &ref);
+    if(FAILED(hres))
+        return hres;
+    if(ref.type != REF_VAR)
+        return MAKE_VBSERROR(VBSE_TYPE_MISMATCH);
+
+    v = ref.u.v;
+    if(V_VT(v) == (VT_VARIANT|VT_BYREF))
+        v = V_VARIANTREF(v);
+    if(!V_ISARRAY(v))
+        return MAKE_VBSERROR(VBSE_TYPE_MISMATCH);
+
+    sa = V_ISBYREF(v) ? *V_ARRAYREF(v) : V_ARRAY(v);
+    if(!sa)
+        return S_OK;
+
+    if(sa->fFeatures & FADF_FIXEDSIZE) {
+        ULONG i, count = 1;
+        VARIANT *data;
+        USHORT d;
+
+        for(d = 0; d < sa->cDims; d++)
+            count *= sa->rgsabound[d].cElements;
+        hres = SafeArrayAccessData(sa, (void**)&data);
+        if(FAILED(hres))
+            return hres;
+        for(i = 0; i < count; i++)
+            VariantClear(&data[i]);
+        SafeArrayUnaccessData(sa);
+        return S_OK;
+    }
+
+    if(V_ISBYREF(v)) {
+        SafeArrayDestroy(sa);
+        *V_ARRAYREF(v) = NULL;
+    }else {
+        VariantClear(v);
+        V_VT(v) = VT_ARRAY|VT_VARIANT;
+        V_ARRAY(v) = NULL;
+    }
+    return S_OK;
+}
