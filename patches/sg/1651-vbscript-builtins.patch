+/* Stained Glass OS (1651): the byte forms work on a string's bytes (the
+ * strings ChrB, LeftB, MidB and the like make, or Unicode strings' two
+ * bytes a character) */
+static HRESULT get_bytes(VARIANT *arg, BSTR *ret, BSTR *conv)
+{
+    *conv = NULL;
+    if (V_VT(arg) == VT_BSTR)
+    {
+        *ret = V_BSTR(arg);
+        return S_OK;
+    }
+    if (V_VT(arg) == (VT_BSTR | VT_BYREF))
+    {
+        *ret = *V_BSTRREF(arg);
+        return S_OK;
+    }
+    if (FAILED(to_string(arg, conv))) return MAKE_VBSERROR(VBSE_TYPE_MISMATCH);
+    *ret = *conv;
+    return S_OK;
+}
+
+static HRESULT return_bytes(VARIANT *res, const void *data, UINT len)
+{
+    BSTR str = SysAllocStringByteLen(data, len);
+
+    if (!str) return E_OUTOFMEMORY;
+    return return_bstr(res, str);
+}
+
