+/* Erase a[, b...] (Stained Glass OS 1651): one OP_erase per array */
+static HRESULT compile_erase_statement(compile_ctx_t *ctx, redim_statement_t *stat)
+{
+    redim_decl_t *decl;
+    HRESULT hres;
+
+    for(decl = stat->redim_decls; decl; decl = decl->next) {
+        hres = push_instr_bstr(ctx, OP_erase, decl->identifier);
+        if(FAILED(hres))
+            return hres;
+        if(!emit_catch(ctx, 0))
+            return E_OUTOFMEMORY;
+    }
+    return S_OK;
+}
+
