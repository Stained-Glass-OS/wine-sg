 {
     redim_decl_t *decl = stat->redim_decls;
@@ -1419,6 +1435,9 @@ static HRESULT compile_statement(compile_ctx_t *ctx, statement_ctx_t *stat_ctx,
         case STAT_REDIM:
             hres = compile_redim_statement(ctx, (redim_statement_t*)stat);
             break;
+        case STAT_ERASE:
+            hres = compile_erase_statement(ctx, (redim_statement_t*)stat);
+            break;
         case STAT_SELECT:
             hres = compile_select_statement(ctx, (select_statement_t*)stat);
             break;
