+static HRESULT Global_Filter(BuiltinDisp *This, VARIANT *args, unsigned args_cnt, VARIANT *res)
+{
+    BSTR *strings, value;
+    LONG count, i, n = 0;
+    int include = 1, mode = 0;
+    SAFEARRAYBOUND bound;
+    SAFEARRAY *sa, *out;
+    VARIANT *data;
+    HRESULT hres;
+
+    TRACE("(%s %s ...)\n", debugstr_variant(args), debugstr_variant(args+1));
+
+    if (V_VT(args) == VT_NULL || V_VT(args+1) == VT_NULL) return MAKE_VBSERROR(VBSE_ILLEGAL_NULL_USE);
+    if (!(sa = get_array(args))) return MAKE_VBSERROR(VBSE_TYPE_MISMATCH);
+    if (args_cnt >= 3 && V_VT(args+2) != VT_ERROR)
+    {
+        VARIANT b;
+        VariantInit(&b);
+        if (FAILED(hres = VariantChangeType(&b, args+2, 0, VT_BOOL))) return hres;
+        include = V_BOOL(&b) != VARIANT_FALSE;
+    }
+    if (args_cnt >= 4 && V_VT(args+3) != VT_ERROR)
+    {
+        if (FAILED(hres = to_int(args+3, &mode))) return hres;
+        if (mode != 0 && mode != 1) return MAKE_VBSERROR(VBSE_ILLEGAL_FUNC_CALL);
+    }
+    if (FAILED(hres = to_string(args+1, &value))) return hres;
+    if (FAILED(hres = array_strings(sa, &strings, &count)))
+    {
+        SysFreeString(value);
+        return hres;
+    }
+
+    /* the strings that contain the value (or that do not) */
+    for (i = 0; i < count; i++)
+    {
+        BOOL found = !SysStringLen(value) ||
+                     FindStringOrdinal(FIND_FROMSTART, strings[i], SysStringLen(strings[i]), value,
+                                       SysStringLen(value), mode) != -1;
+        if (found == include) strings[n++] = strings[i];
+        else SysFreeString(strings[i]);
+    }
+    SysFreeString(value);
+
+    bound.lLbound = 0;
+    bound.cElements = n;
+    if (!(out = SafeArrayCreate(VT_VARIANT, 1, &bound)))
+    {
+        for (i = 0; i < n; i++) SysFreeString(strings[i]);
+        free(strings);
+        return E_OUTOFMEMORY;
+    }
+    SafeArrayAccessData(out, (void **)&data);
+    for (i = 0; i < n; i++)
+    {
+        V_VT(&data[i]) = VT_BSTR;
+        V_BSTR(&data[i]) = strings[i];
+    }
+    SafeArrayUnaccessData(out);
+    free(strings);
+    if (!res)
+    {
+        SafeArrayDestroy(out);
+        return S_OK;
+    }
+    V_VT(res) = VT_ARRAY | VT_VARIANT;
+    V_ARRAY(res) = out;
+    return S_OK;
+}
