From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, msvcrt: a symbolic link to a file has no size of its own; stat follows it (6001)

GetFileAttributesEx (NtQueryFullAttributesFile) gave a symbolic link to a file
the size of its target. Windows gives the link's own, which is 0 (LINK-SIZE;
msvcp120 tr2 _Symlink then _File_size expects 0). Opening the link still
reaches the target and its size. msvcrt's stat (_wstat64 and the functions
built on it) read GetFileAttributesEx and would now see 0 for a link, so it
follows the link to its target as the UCRT's stat does. Directory links and
directory listings (FindFirstFile, NtQueryDirectoryFile) are unchanged.
---
 dlls/msvcrt/file.c     | 26 ++++++++++++++++++++++++++
 dlls/ntdll/unix/file.c | 14 +++++++++++++-
 2 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/dlls/msvcrt/file.c b/dlls/msvcrt/file.c
index 85f9292..07a43f9 100644
--- a/dlls/msvcrt/file.c
+++ b/dlls/msvcrt/file.c
@@ -3307,6 +3307,32 @@ int CDECL _wstat64(const wchar_t* path, struct _stat64 * buf)
       return -1;
   }
 
+  /* Stained Glass OS: stat follows a symbolic link to its target, as the
+   * UCRT does; the link itself has no size of its own (LINK-SIZE) */
+#ifndef SG_MUTANT_STAT_NO_FOLLOW
+  if ((hfi.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) &&
+      !(hfi.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+  {
+      BY_HANDLE_FILE_INFORMATION bhfi;
+      HANDLE h = CreateFileW(path, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                             NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+      if (h == INVALID_HANDLE_VALUE)
+      {
+          *_errno() = ENOENT;
+          return -1;
+      }
+      if (GetFileInformationByHandle(h, &bhfi))
+      {
+          hfi.dwFileAttributes = bhfi.dwFileAttributes;
+          hfi.ftLastAccessTime = bhfi.ftLastAccessTime;
+          hfi.ftLastWriteTime = bhfi.ftLastWriteTime;
+          hfi.nFileSizeHigh = bhfi.nFileSizeHigh;
+          hfi.nFileSizeLow = bhfi.nFileSizeLow;
+      }
+      CloseHandle(h);
+  }
+#endif
+
   memset(buf,0,sizeof(struct _stat64));
 
   /* FIXME: rdev isn't drive num, despite what the docs says-what is it? */
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 45b6a44..bfaecd3 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -4918,7 +4918,7 @@ NTSTATUS WINAPI NtQueryFullAttributesFile( const OBJECT_ATTRIBUTES *attr,
     if (!(status = nt_to_unix_file_name( &new_attr, &unix_name, FILE_OPEN )))
     {
         ULONG attributes;
-        struct stat st;
+        struct stat st, lst;
 
         if (get_file_info( unix_name, &st, &attributes ) == -1)
             status = errno_to_status( errno );
@@ -4939,6 +4939,18 @@ NTSTATUS WINAPI NtQueryFullAttributesFile( const OBJECT_ATTRIBUTES *attr,
             info->AllocationSize = std.AllocationSize;
             info->EndOfFile      = std.EndOfFile;
             info->FileAttributes = basic.FileAttributes;
+            /* Stained Glass OS: a symbolic link to a file is a reparse point of
+             * its own, with no data: GetFileAttributesEx gives it size 0, as on
+             * Windows; opening it (CreateFile) still reaches the target and its
+             * size (LINK-SIZE) */
+#ifndef SG_MUTANT_LINK_SIZE_TARGET
+            if ((attributes & FILE_ATTRIBUTE_REPARSE_POINT) && !S_ISDIR(st.st_mode) &&
+                !lstat( unix_name, &lst ) && S_ISLNK( lst.st_mode ))
+            {
+                info->AllocationSize.QuadPart = 0;
+                info->EndOfFile.QuadPart = 0;
+            }
+#endif
         }
         free( unix_name );
     }
