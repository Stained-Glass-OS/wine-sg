+/* a typed character */
+BOOL xaml_text_box_char( struct uielem *elem, WCHAR ch )
+{
+    struct text_box *box = box_from_elem( elem );
+    WCHAR str[2] = { ch, 0 };
+
+    if (GetKeyState( VK_CONTROL ) < 0 && GetKeyState( VK_MENU ) >= 0) return FALSE;   /* shortcuts */
+    if (get_bool( &box->c.e.d, prop_is_read_only )) return TRUE;
+    box_replace_selection( box, str );
+    return TRUE;
+}
