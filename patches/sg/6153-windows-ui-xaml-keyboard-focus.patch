+void xaml_text_box_focus( struct uielem *elem, BOOL focused )
+{
+    struct text_box *box = box_from_elem( elem );
+    WCHAR *text;
+
+    if (focused && !box->focused)
+    {
+        /* the caret at the end */
+        text = box_text( box );
+        box->caret = wcslen( text );
+        free( text );
+    }
+    box->focused = focused;
+    xaml_invalidate_visuals();
+}
 
