+/* a key nobody handled: TRUE when the box used it */
+BOOL xaml_text_box_key( struct uielem *elem, UINT vk )
+{
+    struct text_box *box = box_from_elem( elem );
+    BOOL read_only = get_bool( &box->c.e.d, prop_is_read_only ), ctrl = GetKeyState( VK_CONTROL ) < 0;
+    WCHAR *text = box_text( box );
+    UINT32 len = wcslen( text );
+
+    free( text );
+    if (box->caret > len) box->caret = len;
+#ifdef SG_MUTANT_TEXTBOX_NO_KEYS
+    return FALSE;
+#endif
+    switch (vk)
+    {
+    case VK_LEFT: if (box->caret) box_move( box, box->caret - 1 ); return TRUE;
+    case VK_RIGHT: if (box->caret < len) box_move( box, box->caret + 1 ); return TRUE;
+    case VK_HOME: box_move( box, 0 ); return TRUE;
+    case VK_END: box_move( box, len ); return TRUE;
+    case VK_BACK:
+        if (read_only) return TRUE;
+        if (box->selection_length) box_replace_selection( box, L"" );
+        else if (box->caret) box_edit( box, box->caret - 1, 1, L"" );
+        return TRUE;
+    case VK_DELETE:
+        if (read_only) return TRUE;
+        if (box->selection_length) box_replace_selection( box, L"" );
+        else if (box->caret < len) box_edit( box, box->caret, 1, L"" );
+        return TRUE;
+    case VK_RETURN:
+        if (read_only || !get_bool( &box->c.e.d, prop_accepts_return )) return FALSE;
+        box_replace_selection( box, L"\r" );
+        return TRUE;
+    }
+    if (!ctrl) return FALSE;
+    switch (vk)
+    {
+    case 'A':
+        box->selection_start = 0;
+        box->selection_length = len;
+        box->caret = len;
+        return TRUE;
+    case 'C': box_copy( box ); return TRUE;
+    case 'X':
+        box_copy( box );
+        if (!read_only) box_replace_selection( box, L"" );
+        return TRUE;
+    case 'V':
+        if (!read_only) box_paste( box );
+        return TRUE;
+    }
+    return FALSE;
+}
