+BOOL xaml_is_text_box( struct uielem *elem )
+{
+    return elem && elem->d.obj.cls == &text_box_class;
+}
+
+static WCHAR *box_text( struct text_box *box )
+{
+    IInspectable *value = NULL;
+    WCHAR *str;
+
+    dobj_get_value( &box->c.e.d, prop_text, &value );
+    str = xunbox_string( value );
+    if (value) IInspectable_Release( value );
+    return str ? str : wcsdup( L"" );
+}
+
+/* the text with [start, start + remove) replaced by insert; the caret after the insert */
+static void box_edit( struct text_box *box, UINT32 start, UINT32 remove, const WCHAR *insert )
+{
+    WCHAR *text = box_text( box ), *edited;
+    UINT32 len = text ? wcslen( text ) : 0, ins = wcslen( insert ), max = get_int( &box->c.e.d, prop_max_length );
+
+    if (!text) return;
+    if (start > len) start = len;
+    if (remove > len - start) remove = len - start;
+    if (max > 0 && len - remove + ins > (UINT32)max) ins = len - remove < (UINT32)max ? max - (len - remove) : 0;
+    if ((edited = malloc( (len - remove + ins + 1) * sizeof(WCHAR) )))
+    {
+        memcpy( edited, text, start * sizeof(WCHAR) );
+        memcpy( edited + start, insert, ins * sizeof(WCHAR) );
+        wcscpy( edited + start + ins, text + start + remove );
+        box->caret = start + ins;
+        box->selection_start = box->caret;
+        box->selection_length = 0;
+        put_box( &box->c.e.d, prop_text, xbox_string( edited ) );
+        free( edited );
+    }
+    free( text );
+}
+
+static void box_replace_selection( struct text_box *box, const WCHAR *insert )
+{
+    if (box->selection_length > 0) box_edit( box, box->selection_start, box->selection_length, insert );
+    else box_edit( box, box->caret, 0, insert );
+}
+
+static void box_move( struct text_box *box, UINT32 caret )
+{
+    box->caret = caret;
+    box->selection_start = caret;
+    box->selection_length = 0;
+    xaml_invalidate_visuals();
+}
+
+static void box_copy( struct text_box *box )
+{
+    WCHAR *text = box_text( box );
+    UINT32 len = wcslen( text ), start = box->selection_length ? box->selection_start : 0;
+    UINT32 count = box->selection_length ? box->selection_length : len;
+    HGLOBAL mem;
+
+    if (start > len) start = len;
+    if (count > len - start) count = len - start;
+    if (OpenClipboard( NULL ))
+    {
+        EmptyClipboard();
+        if ((mem = GlobalAlloc( GMEM_MOVEABLE, (count + 1) * sizeof(WCHAR) )))
+        {
+            WCHAR *p = GlobalLock( mem );
+            memcpy( p, text + start, count * sizeof(WCHAR) );
+            p[count] = 0;
+            GlobalUnlock( mem );
+            SetClipboardData( CF_UNICODETEXT, mem );
+        }
+        CloseClipboard();
+    }
+    free( text );
+}
+
+static void box_paste( struct text_box *box )
+{
+    HANDLE mem;
+    WCHAR *p, *line;
+
+    if (!OpenClipboard( NULL )) return;
+    if ((mem = GetClipboardData( CF_UNICODETEXT )) && (p = GlobalLock( mem )))
+    {
+        if ((line = wcsdup( p )))
+        {
+            /* one line unless the box takes returns */
+            if (!get_bool( &box->c.e.d, prop_accepts_return )) line[wcscspn( line, L"\r\n" )] = 0;
+            box_replace_selection( box, line );
+            free( line );
+        }
+        GlobalUnlock( mem );
+    }
+    CloseClipboard();
+}
