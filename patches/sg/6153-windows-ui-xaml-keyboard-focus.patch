diff --git a/dlls/windows.ui.xaml/text.c b/dlls/windows.ui.xaml/text.c
index 07f4e33..5973954 100644
--- a/dlls/windows.ui.xaml/text.c
+++ b/dlls/windows.ui.xaml/text.c
@@ -386,6 +386,31 @@ static void text_render( struct uielem *elem, struct xdraw *draw )
 
 static const struct elem_ops text_ops = { text_measure, text_arrange, text_render };
 
+/* where a caret before a character of a TextBlock goes (its laid out text) */
+BOOL xaml_text_caret( struct uielem *elem, UINT32 index, FLOAT *x, FLOAT *y, FLOAT *height )
+{
+    struct text_block *text;
+    DWRITE_HIT_TEST_METRICS metrics;
+    struct xthickness padding;
+    FLOAT px, py;
+
+    if (elem->d.obj.cls != &text_class) return FALSE;
+    text = text_from_elem( elem );
+    get_padding( elem, &padding );
+    if (!text->layout)
+    {
+        *x = padding.left;
+        *y = padding.top;
+        *height = 16;
+        return TRUE;
+    }
+    if (FAILED(IDWriteTextLayout_HitTestTextPosition( text->layout, index, FALSE, &px, &py, &metrics ))) return FALSE;
+    *x = padding.left + px;
+    *y = padding.top + py;
+    *height = metrics.height;
+    return TRUE;
+}
