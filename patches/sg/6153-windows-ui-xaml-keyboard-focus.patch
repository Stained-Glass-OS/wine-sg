diff --git a/dlls/windows.ui.xaml/focus.c b/dlls/windows.ui.xaml/focus.c
new file mode 100644
index 0000000..5f995e6
--- /dev/null
+++ b/dlls/windows.ui.xaml/focus.c
@@ -0,0 +1,276 @@
+/*
+ * Windows.UI.Xaml keyboard focus and keys: GotFocus, LostFocus, KeyDown, KeyUp
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * One element of an island has the keyboard focus: a text box clicked or focused from code.  It gets
+ * GotFocus and the one losing it LostFocus, both routed up the tree.  The island's key messages
+ * become KeyDown and KeyUp routed up from the focused element (the root when none is) until a
+ * handler sets Handled; keys and characters nobody handled edit a focused text box.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "winuser.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+static const GUID IID_IRoutedEventArgs_key = { 0x5c985ac6, 0xd802, 0x4b38, { 0xa2, 0x23, 0xbf, 0x07, 0x0c, 0x43, 0xfe, 0xdf } };
+static const GUID IID_IKeyRoutedEventArgs = { 0xd4cd3dfe, 0x4079, 0x42e9, { 0xa3, 0x9a, 0x30, 0x95, 0xd3, 0xf0, 0x49, 0xc6 } };
+static const GUID IID_IKeyRoutedEventArgs2 = { 0x1b02d57a, 0x9634, 0x4f14, { 0x91, 0xb2, 0x13, 0x3e, 0x42, 0xfd, 0xb3, 0xcd } };
+
+static struct uielem *focus;        /* a reference on its object */
+static HWND focus_hwnd;
+
+/* ---- KeyRoutedEventArgs ---- */
+
+struct key_args
+{
+    struct xobj obj;
+    struct xiface IRoutedEventArgs_iface, IKeyRoutedEventArgs_iface, IKeyRoutedEventArgs2_iface;
+    IInspectable *source;
+    INT32 key;
+    UINT32 repeat;
+    boolean handled, menu_down, released, was_down;
+    UINT32 scan;
+};
+
+static struct key_args *key_args_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct key_args, obj );
+}
+
+static HRESULT WINAPI key_get_OriginalSource( struct xiface *iface, IInspectable **value )
+{
+    struct key_args *args = key_args_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    if ((*value = args->source)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI key_get_Key( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = key_args_from_iface( iface )->key;
+    return S_OK;
+}
+
+/* CorePhysicalKeyStatus: RepeatCount, ScanCode, IsExtendedKey, IsMenuKeyDown, WasKeyDown, IsKeyReleased */
+struct key_status { UINT32 repeat, scan; boolean extended, menu_down, was_down, released; };
+
+static HRESULT WINAPI key_get_KeyStatus( struct xiface *iface, struct key_status *value )
+{
+    struct key_args *args = key_args_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    value->repeat = args->repeat;
+    value->scan = args->scan;
+    value->extended = FALSE;
+    value->menu_down = args->menu_down;
+    value->was_down = args->was_down;
+    value->released = args->released;
+    return S_OK;
+}
+
+static HRESULT WINAPI key_get_Handled( struct xiface *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = key_args_from_iface( iface )->handled;
+    return S_OK;
+}
+
+static HRESULT WINAPI key_put_Handled( struct xiface *iface, boolean value )
+{
+    key_args_from_iface( iface )->handled = value;
+    return S_OK;
+}
+
+static const void *key_routed_vtbl[] = { XIFACE_COMMON, key_get_OriginalSource };
+static const void *key_args_vtbl[] = { XIFACE_COMMON, key_get_Key, key_get_KeyStatus, key_get_Handled, key_put_Handled };
+static const void *key_args2_vtbl[] = { XIFACE_COMMON, key_get_Key };   /* OriginalKey */
+
+static const struct xiface_entry key_args_ifaces[] =
+{
+    { &IID_IKeyRoutedEventArgs, offsetof(struct key_args, IKeyRoutedEventArgs_iface) },
+    { &IID_IKeyRoutedEventArgs2, offsetof(struct key_args, IKeyRoutedEventArgs2_iface) },
+    { &IID_IRoutedEventArgs_key, offsetof(struct key_args, IRoutedEventArgs_iface) },
+};
+
+static void key_args_destroy( struct xobj *obj )
+{
+    struct key_args *args = CONTAINING_RECORD( obj, struct key_args, obj );
+    if (args->source) IInspectable_Release( args->source );
+}
+
+static const struct xclass key_args_class =
+{
+    L"Windows.UI.Xaml.Input.KeyRoutedEventArgs", key_args_ifaces, ARRAY_SIZE(key_args_ifaces), key_args_destroy,
+};
+
+static struct key_args *new_key_args( IInspectable *source, UINT vk, LPARAM lparam, BOOL up )
+{
+    struct key_args *args;
+
+    if (!(args = calloc( 1, sizeof(*args) ))) return NULL;
+    args->IRoutedEventArgs_iface.vtbl = key_routed_vtbl;
+    args->IKeyRoutedEventArgs_iface.vtbl = key_args_vtbl;
+    args->IKeyRoutedEventArgs2_iface.vtbl = key_args2_vtbl;
+    xobj_init( &args->obj, &key_args_class, NULL );
+    if ((args->source = source)) IInspectable_AddRef( source );
+    args->key = vk;
+    args->repeat = lparam & 0xffff;
+    args->scan = (lparam >> 16) & 0xff;
+    args->menu_down = (lparam >> 29) & 1;
+    args->was_down = (lparam >> 30) & 1;
+    args->released = up;
+    return args;
+}
+
+/* ---- routing ---- */
+
+static IInspectable *sender_of( struct uielem *elem )
+{
+    IInspectable *sender = NULL;
+    IUnknown_QueryInterface( elem->d.obj.outer, &IID_IInspectable, (void **)&sender );
+    return sender;
+}
+
+/* an event from an element up to the root, while not handled (key events) */
+static void raise_up( struct uielem *from, enum xaml_routed which, IInspectable *args, boolean *handled )
+{
+    struct uielem *elem, *chain[256];
+    unsigned int i, count = 0;
+
+    for (elem = from; elem && count < ARRAY_SIZE(chain); elem = elem->parent)
+    {
+        IUnknown_AddRef( elem->d.obj.outer );
+        chain[count++] = elem;
+    }
+    for (i = 0; i < count; i++)
+    {
+        struct handler_list *list = xaml_routed_list( chain[i], which );
+        IInspectable *sender;
+
+        if (handled && *handled) break;
+        if (!list || list_empty( &list->entries ) || !(sender = sender_of( chain[i] ))) continue;
+        xaml_raise_routed( list, sender, args );
+        IInspectable_Release( sender );
+    }
+    for (i = 0; i < count; i++) IUnknown_Release( chain[i]->d.obj.outer );
+}
+
+static void raise_focus_event( struct uielem *elem, enum xaml_routed which )
+{
+    IInspectable *source = sender_of( elem ), *args;
+
+    if (!source) return;
+    if ((args = xaml_routed_args( source )))
+    {
+        raise_up( elem, which, args, NULL );
+        IInspectable_Release( args );
+    }
+    IInspectable_Release( source );
+}
+
+/* ---- focus ---- */
+
+BOOL xaml_is_focus_target( struct uielem *elem )
+{
+    return xaml_is_text_box( elem );
+}
+
+struct uielem *xaml_focused(void)
+{
+    return focus;
+}
+
+/* the focus moved to an element (NULL: nowhere); its island has the keyboard */
+void xaml_focus_element( struct uielem *elem, HWND hwnd )
+{
+    struct uielem *old = focus;
+
+    if (hwnd) focus_hwnd = hwnd;
+    if (elem == old) return;
+    TRACE( "%p -> %p\n", old, elem );
+#ifdef SG_MUTANT_XAML_NO_FOCUS
+    return;
+#endif
+    if (elem) IUnknown_AddRef( elem->d.obj.outer );
+    focus = elem;
+    if (old)
+    {
+        if (xaml_is_text_box( old )) xaml_text_box_focus( old, FALSE );
+        raise_focus_event( old, XROUTED_LOST_FOCUS );
+        IUnknown_Release( old->d.obj.outer );
+    }
+    if (elem)
+    {
+        if (xaml_is_text_box( elem )) xaml_text_box_focus( elem, TRUE );
+        raise_focus_event( elem, XROUTED_GOT_FOCUS );
+    }
+    xaml_invalidate_visuals();
+}
+
+/* ---- the island's keyboard ---- */
+
+static BOOL in_content( struct uielem *elem, IInspectable *content )
+{
+    struct uielem *root = uielem_from_inspectable( content );
+
+    while (elem && elem->parent) elem = elem->parent;
+    return elem && elem == root;
+}
+
+BOOL xaml_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspectable *content )
+{
+    struct uielem *target = focus && in_content( focus, content ) ? focus : uielem_from_inspectable( content );
+    struct key_args *args;
+    IInspectable *source;
+    BOOL up = msg == WM_KEYUP || msg == WM_SYSKEYUP;
+
+    switch (msg)
+    {
+    case WM_KEYDOWN:
+    case WM_SYSKEYDOWN:
+    case WM_KEYUP:
+    case WM_SYSKEYUP:
+        if (!target || !(source = sender_of( target ))) return FALSE;
+        args = new_key_args( source, wparam, lparam, up );
+        IInspectable_Release( source );
+        if (!args) return FALSE;
+        raise_up( target, up ? XROUTED_KEY_UP : XROUTED_KEY_DOWN, (IInspectable *)&args->IKeyRoutedEventArgs_iface, &args->handled );
+        if (!args->handled && !up && target == focus && xaml_is_text_box( target ))
+            args->handled = xaml_text_box_key( target, wparam );
+        TRACE( "%p: key %#Ix %s, handled %d\n", target, wparam, up ? "up" : "down", args->handled );
+        IUnknown_Release( args->obj.outer );
+        return msg == WM_KEYDOWN || msg == WM_KEYUP;
+    case WM_CHAR:
+        if (focus && in_content( focus, content ) && xaml_is_text_box( focus ) && wparam >= 0x20)
+            return xaml_text_box_char( focus, wparam );
+        return FALSE;
+    case WM_KILLFOCUS:
+        if (focus && in_content( focus, content ) && xaml_is_text_box( focus )) xaml_text_box_focus( focus, FALSE );
+        return FALSE;
+    case WM_SETFOCUS:
+        if (focus && in_content( focus, content ) && xaml_is_text_box( focus )) xaml_text_box_focus( focus, TRUE );
+        return FALSE;
+    }
+    return FALSE;
+}
