From: Stained Glass OS <dev@stained-glass.example>
Subject: ntdll: RtlValidRelativeSecurityDescriptor checks the descriptor

The semi-stub compared RtlValidSecurityDescriptor's BOOLEAN with
STATUS_SUCCESS: it refused every valid descriptor (and accepted NULL). The
offline registry library (offreg), which Click-to-Run uses for Office's
virtual registry, checks each hive's security cells with it, so it could
open no hive -- not even one it had just written (ERROR_NOT_REGISTRY_FILE)
-- and Click-to-Run rebuilt the thirty package hives (root\vreg) as empty
skeletons; Office then could not find its own components.

A self-relative descriptor of the given length is valid when its revision
is right, it is self-relative, its owner and group SIDs and its SACL and
DACL lie within it and are valid, and the parts the caller requires are
present.

Gate: test/relsd-gate.sh (make test-relsd).

--- a/dlls/ntdll/sec.c
+++ b/dlls/ntdll/sec.c
@@ -544,11 +544,54 @@
 /**************************************************************************
  * RtlValidRelativeSecurityDescriptor		[NTDLL.@]
  */
+/* Stained Glass OS: a self-relative descriptor of LENGTH bytes is valid when
+ * its parts lie within it and are themselves valid, and the parts INFO asks
+ * for are there. It compared RtlValidSecurityDescriptor's BOOLEAN with
+ * STATUS_SUCCESS, so every valid descriptor was refused -- and the offline
+ * registry library (offreg), which checks each hive's security cells with
+ * it, could not open any hive: Click-to-Run rebuilt Office's virtual
+ * registry hives empty. */
+static BOOL relative_part( const SECURITY_DESCRIPTOR_RELATIVE *sd, ULONG length, DWORD offset, ULONG min )
+{
+    return offset >= sizeof(*sd) && offset <= length && length - offset >= min && !(offset & 3);
+}
+
+static BOOL relative_sid_valid( const SECURITY_DESCRIPTOR_RELATIVE *sd, ULONG length, DWORD offset )
+{
+    const SID *sid = (const SID *)((const BYTE *)sd + offset);
+
+    if (!relative_part( sd, length, offset, FIELD_OFFSET(SID, SubAuthority) )) return FALSE;
+    if (length - offset < FIELD_OFFSET(SID, SubAuthority[sid->SubAuthorityCount])) return FALSE;
+    return RtlValidSid( (PSID)sid );
+}
+
+static BOOL relative_acl_valid( const SECURITY_DESCRIPTOR_RELATIVE *sd, ULONG length, DWORD offset )
+{
+    const ACL *acl = (const ACL *)((const BYTE *)sd + offset);
+
+    if (!relative_part( sd, length, offset, sizeof(ACL) )) return FALSE;
+    if (acl->AclSize < sizeof(ACL) || acl->AclSize > length - offset) return FALSE;
+    return RtlValidAcl( (PACL)acl );
+}
+
 BOOLEAN WINAPI RtlValidRelativeSecurityDescriptor(PSECURITY_DESCRIPTOR descriptor,
     ULONG length, SECURITY_INFORMATION info)
 {
-    FIXME("%p,%lu,%ld: semi-stub\n", descriptor, length, info);
-    return RtlValidSecurityDescriptor(descriptor) == STATUS_SUCCESS;
+    const SECURITY_DESCRIPTOR_RELATIVE *sd = descriptor;
+
+    TRACE("%p,%lu,%ld\n", descriptor, length, info);
+
+    if (!sd || length < sizeof(*sd)) return FALSE;
+    if (sd->Revision != SECURITY_DESCRIPTOR_REVISION || !(sd->Control & SE_SELF_RELATIVE)) return FALSE;
+    if (sd->Owner ? !relative_sid_valid( sd, length, sd->Owner ) : (info & OWNER_SECURITY_INFORMATION) != 0)
+        return FALSE;
+    if (sd->Group ? !relative_sid_valid( sd, length, sd->Group ) : (info & GROUP_SECURITY_INFORMATION) != 0)
+        return FALSE;
+    if ((sd->Control & SE_DACL_PRESENT) && sd->Dacl && !relative_acl_valid( sd, length, sd->Dacl )) return FALSE;
+    if ((info & DACL_SECURITY_INFORMATION) && !(sd->Control & SE_DACL_PRESENT)) return FALSE;
+    if ((sd->Control & SE_SACL_PRESENT) && sd->Sacl && !relative_acl_valid( sd, length, sd->Sacl )) return FALSE;
+    if ((info & SACL_SECURITY_INFORMATION) && !(sd->Control & SE_SACL_PRESENT)) return FALSE;
+    return TRUE;
 }
 
 /**************************************************************************
