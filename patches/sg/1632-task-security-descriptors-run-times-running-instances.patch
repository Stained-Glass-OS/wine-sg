+/* ---- run times and instances, for the RPC calls ------------------------------ */
+
+static ULONGLONG systemtime_to_utc(const SYSTEMTIME *st)
+{
+    SYSTEMTIME utc;
+    FILETIME ft;
+
+    /* the times given and returned are the machine's local time, with the
+     * daylight saving of that day */
+    if (!TzSpecificLocalTimeToSystemTime(NULL, st, &utc) || !SystemTimeToFileTime(&utc, &ft)) return 0;
+    return ((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+}
+
+static void utc_to_systemtime(ULONGLONG t, SYSTEMTIME *st)
+{
+    SYSTEMTIME utc;
+    FILETIME ft;
+
+    ft.dwLowDateTime = (DWORD)t;
+    ft.dwHighDateTime = (DWORD)(t >> 32);
+    FileTimeToSystemTime(&ft, &utc);
+    SystemTimeToTzSpecificLocalTime(NULL, &utc, st);
+}
+
+/* the next time any of a task's calendar triggers fires after a moment */
+static ULONGLONG task_next_time(const struct run_task *task, ULONGLONG after)
+{
+    ULONGLONG next = NEVER, when;
+    unsigned int i;
+
+    for (i = 0; i < task->trigger_count; i++)
+    {
+        const struct run_trigger *t = &task->triggers[i];
+
+        if (!t->enabled || (t->kind != TRIGGER_TIME && t->kind != TRIGGER_DAILY && t->kind != TRIGGER_WEEKLY))
+            continue;
+        when = trigger_next(t, after);
+        if (when < next) next = when;
+    }
+    return next;
+}
+
+HRESULT taskrun_runtimes(const WCHAR *path, const SYSTEMTIME *start, const SYSTEMTIME *end, DWORD max,
+                         DWORD *count, SYSTEMTIME **times)
+{
+    ULONGLONG from = start ? systemtime_to_utc(start) : now_utc(), to = end ? systemtime_to_utc(end) : NEVER, when;
+    struct run_task *task;
+    HRESULT hr = S_OK;
+    DWORD n = 0, alloc = 0;
+    SYSTEMTIME *list = NULL, *tmp;
+
+    *count = 0;
+    *times = NULL;
+    if (!max) max = 1000;  /* every run in the range, within reason */
+    rescan(FALSE);
+    EnterCriticalSection(&cs);
+    if (!(task = find_task(path))) hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    else
+    {
+#ifndef SG_MUTANT_NO_RUN_TIMES
+        /* the moment given is a run time too */
+        when = task_next_time(task, from ? from - 1 : 0);
+#else
+        when = NEVER;
+#endif
+        while (when != NEVER && when <= to && n < max)
+        {
+            if (n == alloc)
+            {
+                alloc = alloc ? alloc * 2 : 16;
+                if (!(tmp = MIDL_user_allocate(alloc * sizeof(*tmp))))
+                {
+                    hr = E_OUTOFMEMORY;
+                    break;
+                }
+                if (list) memcpy(tmp, list, n * sizeof(*tmp));
+                MIDL_user_free(list);
+                list = tmp;
+            }
+            utc_to_systemtime(when, &list[n++]);
+            when = task_next_time(task, when);
+        }
+    }
+    LeaveCriticalSection(&cs);
+    if (FAILED(hr))
+    {
+        MIDL_user_free(list);
+        return hr;
+    }
+    *count = n;
+    *times = list;
+    return n ? S_OK : S_FALSE;
+}
+
+HRESULT taskrun_missed_runs(const WCHAR *path, DWORD *runs)
+{
+    struct run_task *task;
+    ULONGLONG when, since;
+    HRESULT hr = S_OK;
+
+    *runs = 0;
+    rescan(FALSE);
+    EnterCriticalSection(&cs);
+    if (!(task = find_task(path))) hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    else if (service_start)
+    {
+        /* the scheduled times that came while the scheduler was not running:
+         * from the last run (or the definition's writing) to its start */
+        since = task->last_run ? task->last_run :
+                ((ULONGLONG)task->written.dwHighDateTime << 32) | task->written.dwLowDateTime;
+        for (when = task_next_time(task, since); when != NEVER && when < service_start && *runs < 1000;
+             when = task_next_time(task, when))
+            (*runs)++;
+    }
+    LeaveCriticalSection(&cs);
+    return hr;
+}
+
+static BOOL task_is_running(const struct run_task *task)
+{
+    return task->thread && WaitForSingleObject(task->thread, 0) == WAIT_TIMEOUT;
+}
+
+static struct run_task *find_instance(const GUID *guid)
+{
+    struct run_task *task;
+
+    LIST_FOR_EACH_ENTRY(task, &tasks, struct run_task, entry)
+        if (task_is_running(task) && IsEqualGUID(&task->instance, guid)) return task;
+    return NULL;
+}
+
+/* the instances running of a task, of the tasks in a folder, or of all */
+HRESULT taskrun_instances(const WCHAR *path, DWORD *count, GUID **guids)
+{
+    struct run_task *task, *only = NULL;
+    const WCHAR *p = path;
+    size_t prefix = 0;
+    DWORD n = 0;
+
+    while (p && (*p == '\\' || *p == '/')) p++;
+    rescan(FALSE);
+    EnterCriticalSection(&cs);
+    if (p && *p && !(only = find_task(path))) prefix = wcslen(p);
+    LIST_FOR_EACH_ENTRY(task, &tasks, struct run_task, entry)
+        if (task_is_running(task)) n++;
+    if (n && !(*guids = MIDL_user_allocate(n * sizeof(GUID))))
+    {
+        LeaveCriticalSection(&cs);
+        return E_OUTOFMEMORY;
+    }
+    n = 0;
+    LIST_FOR_EACH_ENTRY(task, &tasks, struct run_task, entry)
+    {
+        if (!task_is_running(task)) continue;
+        if (only && task != only) continue;
+        if (prefix && (wcsnicmp(task->path + 1, p, prefix) || task->path[1 + prefix] != '\\')) continue;
+        (*guids)[n++] = task->instance;
+    }
+    LeaveCriticalSection(&cs);
+    *count = n;
+    return S_OK;
+}
+
+HRESULT taskrun_instance_info(const GUID *guid, WCHAR **path, DWORD *state, WCHAR **action, DWORD *pid)
+{
+    struct run_task *task;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&cs);
+    if (!(task = find_instance(guid))) hr = SCHED_E_TASK_NOT_RUNNING;
+    else
+    {
+        if (path && !(*path = MIDL_user_allocate((wcslen(task->path) + 1) * sizeof(WCHAR)))) hr = E_OUTOFMEMORY;
+        else if (path) wcscpy(*path, task->path);
+        if (state) *state = TASK_STATE_RUNNING;
+        if (action && task->current_action &&
+            (*action = MIDL_user_allocate((wcslen(task->current_action) + 1) * sizeof(WCHAR))))
+            wcscpy(*action, task->current_action);
+        if (pid) *pid = task->pid;
+    }
+    LeaveCriticalSection(&cs);
+    return hr;
+}
+
+HRESULT taskrun_stop_instance(const GUID *guid)
+{
+    struct run_task *task;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&cs);
+    if (!(task = find_instance(guid))) hr = SCHED_E_TASK_NOT_RUNNING;
+    else
+    {
+        task->queued = FALSE;
+        if (task->process) TerminateProcess(task->process, SCHED_S_TASK_TERMINATED);
+    }
+    LeaveCriticalSection(&cs);
+    return hr;
+}
+
+/* the instance a Run has just started */
+HRESULT taskrun_run_instance(const WCHAR *path, GUID *guid)
+{
+    struct run_task *task;
+
+    EnterCriticalSection(&cs);
+    if ((task = find_task(path)) && task_is_running(task)) *guid = task->instance;
+    LeaveCriticalSection(&cs);
+    return S_OK;
+}
