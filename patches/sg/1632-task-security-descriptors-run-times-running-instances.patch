+
+static HRESULT WINAPI runnings_get__NewEnum(IRunningTaskCollection *iface, IUnknown **penum)
+{
+    RunningTaskCollection *runnings = impl_from_IRunningTaskCollection(iface);
+    SAFEARRAY *array;
+    IEnumVARIANT *e;
+    HRESULT hr;
+    LONG i;
+
+    TRACE("%p,%p\n", iface, penum);
+
+    if (!penum) return E_POINTER;
+    /* the instances as VT_DISPATCH, through a VARIANT array's enumerator */
+    if (!(array = SafeArrayCreateVector(VT_VARIANT, 0, runnings->count))) return E_OUTOFMEMORY;
+    for (i = 0; i < runnings->count; i++)
+    {
+        IRunningTask *task;
+        VARIANT v;
+
+        if (FAILED(hr = RunningTask_create(runnings->paths[i], &runnings->instances[i], &task))) break;
+        V_VT(&v) = VT_DISPATCH;
+        V_DISPATCH(&v) = (IDispatch *)task;
+        hr = SafeArrayPutElement(array, &i, &v);
+        IRunningTask_Release(task);
+        if (FAILED(hr)) break;
+    }
+    if (SUCCEEDED(hr = variant_array_enum_create(array, &e))) *penum = (IUnknown *)e;
+    SafeArrayDestroy(array);
+    return hr;
+}
