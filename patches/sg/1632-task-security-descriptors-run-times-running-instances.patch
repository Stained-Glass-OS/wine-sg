+    while (i < count && e->pos < e->count)
+    {
+        VariantInit(&var[i]);
+        VariantCopy(&var[i], &e->items[e->pos]);
+        i++;
+        e->pos++;
+    }
+    if (fetched) *fetched = i;
+    return i == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI variant_enum_Skip(IEnumVARIANT *iface, ULONG count)
+{
+    struct variant_enum *e = impl_from_variant_enum(iface);
+
+    if (count > e->count - e->pos)
+    {
+        e->pos = e->count;
+        return S_FALSE;
+    }
+    e->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI variant_enum_Reset(IEnumVARIANT *iface)
+{
+    impl_from_variant_enum(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT variant_enum_create(const VARIANT *items, ULONG count, ULONG pos, IEnumVARIANT **ret);
+
+static HRESULT WINAPI variant_enum_Clone(IEnumVARIANT *iface, IEnumVARIANT **out)
+{
+    struct variant_enum *e = impl_from_variant_enum(iface);
+
+    if (!out) return E_POINTER;
+    return variant_enum_create(e->items, e->count, e->pos, out);
+}
+
+static const IEnumVARIANTVtbl variant_enum_vtbl =
+{
+    variant_enum_QueryInterface,
+    variant_enum_AddRef,
+    variant_enum_Release,
+    variant_enum_Next,
+    variant_enum_Skip,
+    variant_enum_Reset,
+    variant_enum_Clone
+};
+
+static HRESULT variant_enum_create(const VARIANT *items, ULONG count, ULONG pos, IEnumVARIANT **ret)
+{
+    struct variant_enum *e;
+    ULONG i;
+
+    *ret = NULL;
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
+    if (count && !(e->items = calloc(count, sizeof(VARIANT))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        VariantInit(&e->items[i]);
+        VariantCopy(&e->items[i], (VARIANT *)&items[i]);
+    }
+    e->IEnumVARIANT_iface.lpVtbl = &variant_enum_vtbl;
+    e->ref = 1;
+    e->count = count;
+    e->pos = pos;
+    *ret = &e->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+HRESULT variant_array_enum_create(SAFEARRAY *array, IEnumVARIANT **ret)
+{
+    VARIANT *items;
+    LONG lbound, ubound;
+    HRESULT hr;
+
+    SafeArrayGetLBound(array, 1, &lbound);
+    SafeArrayGetUBound(array, 1, &ubound);
+    if (FAILED(hr = SafeArrayAccessData(array, (void **)&items))) return hr;
+    hr = variant_enum_create(items, ubound - lbound + 1, 0, ret);
+    SafeArrayUnaccessData(array);
+    return hr;
+}
