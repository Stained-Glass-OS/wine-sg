+/* Stained Glass OS: a task's or folder's security descriptor, kept where
+ * Windows keeps it: the TaskCache\Tree key of its path, value SD */
+static const WCHAR task_tree_key[] = L"Software\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tree";
+static const WCHAR default_task_sddl[] = L"O:BAG:SYD:AI(A;;FA;;;BA)(A;;FA;;;SY)(A;;FRFX;;;AU)";
+
+static WCHAR *task_tree_path(const WCHAR *path)
+{
+    size_t len;
+    WCHAR *ret;
+
+    while (*path == '\\' || *path == '/') path++;
+    len = wcslen(task_tree_key) + wcslen(path) + 2;
+    if (!(ret = malloc(len * sizeof(WCHAR)))) return NULL;
+    swprintf(ret, len, *path ? L"%s\\%s" : L"%s%s", task_tree_key, path);
+    for (len = wcslen(task_tree_key); ret[len]; len++) if (ret[len] == '/') ret[len] = '\\';
+    return ret;
+}
+
+static BOOL task_path_exists(const WCHAR *path)
+{
+    WCHAR *full_name;
+    BOOL ret;
+
+    if (!(full_name = get_full_name(path, NULL))) return FALSE;
+    ret = GetFileAttributesW(full_name) != INVALID_FILE_ATTRIBUTES;
+    free(full_name);
+    return ret;
+}
+
+HRESULT store_task_security(const WCHAR *path, const WCHAR *sddl)
+{
+    PSECURITY_DESCRIPTOR sd;
+    WCHAR *key_path;
+    ULONG size;
+    LONG ret;
+    HKEY key;
+
+    if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl, SDDL_REVISION_1, &sd, &size))
+        return HRESULT_FROM_WIN32(ERROR_INVALID_SECURITY_DESCR);
+    if (!(key_path = task_tree_path(path)))
+    {
+        LocalFree(sd);
+        return E_OUTOFMEMORY;
+    }
+    if (!(ret = RegCreateKeyExW(HKEY_LOCAL_MACHINE, key_path, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL)))
+    {
+        ret = RegSetValueExW(key, L"SD", 0, REG_BINARY, sd, size);
+        RegCloseKey(key);
+    }
+    free(key_path);
+    LocalFree(sd);
+    return HRESULT_FROM_WIN32(ret);
+}
+
