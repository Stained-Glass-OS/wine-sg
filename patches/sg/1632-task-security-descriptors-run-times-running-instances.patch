+/* Stained Glass OS: the running instances of a task, of the tasks in a
+ * folder, or of all (IRunningTaskCollection) */
+typedef struct
+{
+    IRunningTaskCollection IRunningTaskCollection_iface;
+    LONG ref;
+    LONG count;
+    GUID *instances;
+    WCHAR **paths;
+} RunningTaskCollection;
+
+static inline RunningTaskCollection *impl_from_IRunningTaskCollection(IRunningTaskCollection *iface)
+{
+    return CONTAINING_RECORD(iface, RunningTaskCollection, IRunningTaskCollection_iface);
+}
+
+static HRESULT WINAPI runnings_QueryInterface(IRunningTaskCollection *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IRunningTaskCollection) || IsEqualGUID(riid, &IID_IDispatch) ||
+        IsEqualGUID(riid, &IID_IUnknown))
+    {
+        IRunningTaskCollection_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI runnings_AddRef(IRunningTaskCollection *iface)
+{
+    return InterlockedIncrement(&impl_from_IRunningTaskCollection(iface)->ref);
+}
+
+static ULONG WINAPI runnings_Release(IRunningTaskCollection *iface)
+{
+    RunningTaskCollection *runnings = impl_from_IRunningTaskCollection(iface);
+    LONG ref = InterlockedDecrement(&runnings->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < runnings->count; i++) free(runnings->paths[i]);
+        free(runnings->paths);
+        free(runnings->instances);
+        free(runnings);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI runnings_GetTypeInfoCount(IRunningTaskCollection *iface, UINT *count)
+{
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI runnings_GetTypeInfo(IRunningTaskCollection *iface, UINT index, LCID lcid, ITypeInfo **info)
+{
+    if (index) return DISP_E_BADINDEX;
+    return get_typeinfo(&IID_IRunningTaskCollection, info);
+}
+
+static HRESULT WINAPI runnings_GetIDsOfNames(IRunningTaskCollection *iface, REFIID riid, LPOLESTR *names, UINT count,
+                                             LCID lcid, DISPID *dispid)
+{
+    return dispatch_get_ids(&IID_IRunningTaskCollection, names, count, dispid);
+}
+
+static HRESULT WINAPI runnings_Invoke(IRunningTaskCollection *iface, DISPID dispid, REFIID riid, LCID lcid, WORD flags,
+                                      DISPPARAMS *params, VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr)
+{
+    return dispatch_invoke((IDispatch *)iface, &IID_IRunningTaskCollection, dispid, flags, params, result,
+                           excepinfo, argerr);
+}
+
+static HRESULT WINAPI runnings_get_Count(IRunningTaskCollection *iface, LONG *count)
+{
+    TRACE("%p,%p\n", iface, count);
+
+    if (!count) return E_POINTER;
+    *count = impl_from_IRunningTaskCollection(iface)->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI runnings_get_Item(IRunningTaskCollection *iface, VARIANT index, IRunningTask **task)
+{
+    RunningTaskCollection *runnings = impl_from_IRunningTaskCollection(iface);
+    VARIANT v;
+    LONG i;
+
+    TRACE("%p,%s,%p\n", iface, debugstr_variant(&index), task);
+
+    if (!task) return E_POINTER;
+    *task = NULL;
+    VariantInit(&v);
+    if (FAILED(VariantChangeType(&v, &index, 0, VT_I4))) return E_INVALIDARG;
+    i = V_I4(&v);
+    /* one-based, as the scripting collections are */
+    if (i < 1 || i > runnings->count) return E_INVALIDARG;
+    return RunningTask_create(runnings->paths[i - 1], &runnings->instances[i - 1], task);
