+HRESULT RunningTaskCollection_create(const WCHAR *path, LONG flags, IRunningTaskCollection **obj)
+{
+    RunningTaskCollection *runnings;
+    GUID *guids = NULL;
+    DWORD count = 0, i, n = 0;
+    HRESULT hr;
+
+    *obj = NULL;
+    if (FAILED(hr = SchRpcEnumInstances(path, flags, &count, &guids))) return hr;
+    if (!(runnings = calloc(1, sizeof(*runnings))) ||
+        (count && (!(runnings->instances = calloc(count, sizeof(GUID))) ||
+                   !(runnings->paths = calloc(count, sizeof(WCHAR *))))))
+    {
+        if (runnings) free(runnings->instances);
+        free(runnings);
+        MIDL_user_free(guids);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        WCHAR *task_path = NULL, *action = NULL, *info = NULL;
+        DWORD state, n_instances = 0, pid;
+        GUID *instances = NULL;
+
+        /* an instance that ended meanwhile is left out */
+        if (FAILED(SchRpcGetInstanceInfo(guids[i], &task_path, &state, &action, &info, &n_instances,
+                                         &instances, &pid)))
+            continue;
+        runnings->instances[n] = guids[i];
+        runnings->paths[n] = wcsdup(task_path ? task_path : L"");
+        n++;
+        MIDL_user_free(task_path);
+        MIDL_user_free(action);
+        MIDL_user_free(info);
+        MIDL_user_free(instances);
+    }
+    MIDL_user_free(guids);
+    runnings->IRunningTaskCollection_iface.lpVtbl = &RunningTaskCollection_vtbl;
+    runnings->ref = 1;
+    runnings->count = n;
+    *obj = &runnings->IRunningTaskCollection_iface;
+    return S_OK;
+}
