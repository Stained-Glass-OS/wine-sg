From: Stained Glass OS contributors
Subject: server: SYSTEM may change the permissions of a file another account owns

The .NET SDK's installer (WiX Burn) downloads into the user's Temp; its
elevated engine, SYSTEM, moves each payload into the Package Cache and resets
its DACL. The moved file is still the user's on the Unix side, the system
wineserver runs as sgsystem, and fchmod failed with EPERM: setup failed with
0x8000ffff. The system wineserver holds CAP_FOWNER as a permitted capability
only (sg-session's sg-wineserver.service gives it; the server clears ambient
and effective at start) and makes it effective for that one fchmod, on a
system prefix, after the Windows access check has granted WRITE_DAC.

--- a/server/file.c
+++ b/server/file.c
@@ -31,6 +31,11 @@
 #include <grp.h>
 #include <ftw.h>
 #include <sys/xattr.h>
+#ifdef __linux__
+#include <sys/prctl.h>
+#include <sys/syscall.h>
+#include <linux/capability.h>
+#endif
 #include <sys/time.h>
 #include <sys/types.h>
 #include <time.h>
@@ -619,14 +624,53 @@
  * kernel intends, and never through the server's ownership of system files. */
 int sg_client_chmod = -1;
 
+/* Stained Glass OS: CAP_FOWNER, held by the system prefix's wineserver as a
+ * permitted capability only (sg-wineserver.service), is made effective for
+ * one fchmod at a time: SYSTEM changing the DACL of a file another account
+ * owns -- a file an elevated installer moved from the user's Temp into the
+ * machine's folders (the .NET SDK's WiX Burn engine, its Package Cache) --
+ * which Windows' SYSTEM may always do. The Windows access check has already
+ * granted WRITE_DAC by then. */
+static int sg_fowner( int raise )
+{
+#ifdef __linux__
+    struct __user_cap_header_struct header = { _LINUX_CAPABILITY_VERSION_3, 0 };
+    struct __user_cap_data_struct data[2];
+
+    if (syscall( SYS_capget, &header, data )) return -1;
+    if (raise && !(data[0].permitted & (1u << CAP_FOWNER))) return -1;
+    if (raise) data[0].effective |= 1u << CAP_FOWNER;
+    else data[0].effective &= ~(1u << CAP_FOWNER);
+    return syscall( SYS_capset, &header, data );
+#else
+    return -1;
+#endif
+}
+
+/* at start: nothing effective, nothing handed on */
+void sg_init_capabilities(void)
+{
+#if defined(__linux__) && defined(PR_CAP_AMBIENT)
+    prctl( PR_CAP_AMBIENT, PR_CAP_AMBIENT_CLEAR_ALL, 0, 0, 0 );
+#endif
+    sg_fowner( 0 );
+}
+
 int sg_set_unix_mode( int unix_fd, mode_t mode )
 {
+    int ret, err;
+
     if (current && current->process->peer_uid != getuid())
     {
         sg_client_chmod = mode & 07777;
         return 0;
     }
-    return fchmod( unix_fd, mode );
+    if (!(ret = fchmod( unix_fd, mode )) || errno != EPERM || !sg_system_prefix || sg_fowner( 1 )) return ret;
+    ret = fchmod( unix_fd, mode );
+    err = errno;
+    sg_fowner( 0 );
+    errno = err;
+    return ret;
 }
 
 static int file_set_sd( struct object *obj, const struct security_descriptor *sd,
--- a/server/main.c
+++ b/server/main.c
@@ -34,6 +34,7 @@
 #include "file.h"
 #include "thread.h"
 #include "request.h"
+#include "handle.h"
 #include "unicode.h"
 
 /* command-line options */
@@ -248,6 +249,7 @@
     signal( SIGTERM, sigterm_handler );
     signal( SIGABRT, sigterm_handler );
 
+    sg_init_capabilities();   /* Stained Glass OS: CAP_FOWNER only when needed */
     raise_open_files_limit();
     sock_init();
     open_master_socket();
--- a/server/handle.h
+++ b/server/handle.h
@@ -45,6 +45,7 @@
 /* a file's Unix mode the client applies itself (set_security_object), in file.c */
 extern int sg_client_chmod;
 extern int sg_set_unix_mode( int unix_fd, mode_t mode );
