From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: the root import's guard survives its importer's death (7600)

The one-time import of the host's roots was guarded by a named semaphore
made at count 0: a process killed while importing never released it, and
the processes waiting kept it at 0, so every later program's HTTPS hung in
CertGetCertificateChain. A mutex is abandoned when its owner dies; the next
process imports instead.
---
--- a/dlls/crypt32/rootstore.c
+++ b/dlls/crypt32/rootstore.c
@@ -840,6 +840,28 @@
     if (root_certs_imported)
         return;
 
+#ifndef SG_MUTANT_ROOT_SEMAPHORE
+    /* Stained Glass OS 7600: one process imports, the others wait for it. The
+     * guard was a semaphore made at count 0, released when the import ended:
+     * a process killed or crashed in between (a program ended during its
+     * first HTTPS request) never released it, and the processes waiting held
+     * it open at 0 for good -- every new program's HTTPS then hung in
+     * CertGetCertificateChain (SG Store: "Installing..." for ever, qa4). A
+     * mutex is abandoned when its owner dies: the next one imports instead. */
+    hsem = CreateMutexW( NULL, TRUE, L"crypt32_root_mutex");
+    if (!hsem)
+    {
+        ERR("Failed to create mutex\n");
+        return;
+    }
+
+    if(GetLastError() == ERROR_ALREADY_EXISTS)
+    {
+        if (WaitForSingleObject(hsem, INFINITE) != WAIT_ABANDONED)
+            goto done;
+        WARN("the process importing the roots ended before it was done; importing here\n");
+    }
+#else
     hsem = CreateSemaphoreW( NULL, 0, 1, L"crypt32_root_semaphore");
     if (!hsem)
     {
@@ -852,6 +874,7 @@
         WaitForSingleObject(hsem, INFINITE);
         goto done;
     }
+#endif
 
     rc = RegCreateKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\SystemCertificates\\Root\\Certificates", 0, NULL, 0,
             KEY_ALL_ACCESS, NULL, &key, 0);
@@ -905,7 +928,11 @@
     CertCloseStore(reg, 0);
     CertCloseStore(admin, 0);
     root_certs_imported = TRUE;
+#ifndef SG_MUTANT_ROOT_SEMAPHORE
+    ReleaseMutex(hsem);
+#else
     ReleaseSemaphore(hsem, 1, NULL);
+#endif
     CloseHandle(hsem);
 }
 
