From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmvcore: the writer writes a script stream as ASF command media (9261)

A profile with a script stream (WMMEDIATYPE_Script: captions, URLs and
markers as type/command string pairs, as Windows Media Encoder and the
system profiles with script commands make) could not be written at all:
BeginWriting failed with NS_E_INVALID_STREAM and logged a FIXME, because
the muxer knew only audio and video stream properties. A script stream is
an ASF command media stream, which has no type-specific data; its samples
are written as they come, as Windows' writer writes them.

The wmvw-writer gate expected E_NOTIMPL from BeginWriting (from 2865, before
6517 implemented writing) and failed since; it now expects BeginWriting to
get past the streams (ledger i0549).

Gate: make test-wmscript (a file with a script stream only, two commands,
read back); test-wmvw-writer updated. Mutant: SG_MUTANT_WMVW_NO_SCRIPT.
---
--- a/dlls/wmvcore/asfmux.c
+++ b/dlls/wmvcore/asfmux.c
@@ -49,9 +49,11 @@
 static const GUID asf_simple_index = {0x33000890, 0xe5b1, 0x11cf, {0x89, 0xf4, 0x00, 0xa0, 0xc9, 0x03, 0x49, 0xcb}};
 static const GUID asf_audio_media = {0xf8699e40, 0x5b4d, 0x11cf, {0xa8, 0xfd, 0x00, 0x80, 0x5f, 0x5c, 0x44, 0x2b}};
 static const GUID asf_video_media = {0xbc19efc0, 0x5b4d, 0x11cf, {0xa8, 0xfd, 0x00, 0x80, 0x5f, 0x5c, 0x44, 0x2b}};
+static const GUID asf_command_media = {0x59dacfc0, 0x59e6, 0x11d0, {0xa3, 0xac, 0x00, 0xa0, 0xc9, 0x03, 0x48, 0xf6}};
 static const GUID asf_no_error_correction = {0x20fb5700, 0x5b55, 0x11cf, {0xa8, 0xfd, 0x00, 0x80, 0x5f, 0x5c, 0x44, 0x2b}};
 
 static const GUID media_audio = {0x73647561, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID media_script = {0x73636d64, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
 static const GUID media_video = {0x73646976, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
 static const GUID format_waveformatex = {0x05589f81, 0xc356, 0x11ce, {0xbf, 0x01, 0x00, 0xaa, 0x00, 0x55, 0x59, 0x5a}};
 static const GUID format_videoinfo = {0x05589f80, 0xc356, 0x11ce, {0xbf, 0x01, 0x00, 0xaa, 0x00, 0x55, 0x59, 0x5a}};
@@ -77,6 +79,7 @@
 {
     WORD number;
     BOOL video;
+    BOOL script;            /* a script (command) stream: no type-specific data */
     BYTE *type_data;        /* the stream properties' type-specific data */
     DWORD type_size;
     DWORD bitrate, buffer_window;
@@ -152,6 +155,19 @@
         /* the BITMAPINFOHEADER's own size field is the format data's size */
         if (!buffer.failed) *(DWORD *)(buffer.data + 11) = bih_size;
     }
+#ifndef SG_MUTANT_WMVW_NO_SCRIPT
+    /* Stained Glass OS (wine-sg 9261): a script stream (WMMEDIATYPE_Script: captions, URLs and
+     * markers as type/command string pairs) is an ASF command media stream, which has no
+     * type-specific data; its samples are written as they come, as Windows' writer does. A
+     * profile with one could not be written at all (BeginWriting NS_E_INVALID_STREAM). */
+    else if (IsEqualGUID(&mt->majortype, &media_script))
+    {
+        stream->script = TRUE;
+        stream->type_data = NULL;
+        stream->type_size = 0;
+        return S_OK;
+    }
+#endif
     else
     {
         FIXME("stream %u: major type %s, format %s not written\n", stream->number, debugstr_guid(&mt->majortype),
@@ -281,7 +297,7 @@
 
         asf_put(out, &asf_stream_properties, sizeof(GUID));
         asf_put_qword(out, 78 + stream->type_size);
-        asf_put(out, stream->video ? &asf_video_media : &asf_audio_media, sizeof(GUID));
+        asf_put(out, stream->video ? &asf_video_media : stream->script ? &asf_command_media : &asf_audio_media, sizeof(GUID));
         asf_put(out, &asf_no_error_correction, sizeof(GUID));
         asf_put_qword(out, 0);                      /* time offset */
         asf_put_dword(out, stream->type_size);
