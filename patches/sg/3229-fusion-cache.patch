+        }
+        dst->name = src->name;
+        IAssemblyName_AddRef(dst->name);
+        list_add_tail(&copy->assemblies, &dst->entry);
+        if (entry == asmenum->iter) copy->iter = &dst->entry;
+    }
+    if (!copy->iter) copy->iter = list_head(&copy->assemblies);
+#ifndef SG_MUTANT_FUS_ENUMPOS
+    if (asmenum->iter == NULL) copy->iter = NULL;
