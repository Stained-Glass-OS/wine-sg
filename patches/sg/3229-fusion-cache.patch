+static void remove_staging(IAssemblyCacheItemImpl *item)
+{
+    WIN32_FIND_DATAW fd;
+    WCHAR pattern[MAX_PATH], file[MAX_PATH];
+    HANDLE find;
+
+    if (!item->dir[0]) return;
+    swprintf(pattern, ARRAY_SIZE(pattern), L"%s\\*", item->dir);
+    if ((find = FindFirstFileW(pattern, &fd)) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+            swprintf(file, ARRAY_SIZE(file), L"%s\\%s", item->dir, fd.cFileName);
+            DeleteFileW(file);
+        } while (FindNextFileW(find, &fd));
+        FindClose(find);
+    }
+    RemoveDirectoryW(item->dir);
+    item->dir[0] = 0;
+}
