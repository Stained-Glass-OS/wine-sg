+/* the cache of the assemblies downloaded for the user: under the local application data */
+static BOOL get_download_cache_dir(WCHAR *path, DWORD size)
+{
+    static const WCHAR dl3[] = L"\\assembly\\dl3";
+    DWORD len = GetEnvironmentVariableW(L"LOCALAPPDATA", path, size);
+
+    if (!len || len >= size)
+    {
+        static const WCHAR local[] = L"\\Local Settings\\Application Data";
+
+        len = GetEnvironmentVariableW(L"USERPROFILE", path, size);
+        if (!len || len + ARRAY_SIZE(local) >= size) return FALSE;
+        lstrcpyW(path + len, local);
+        len += ARRAY_SIZE(local) - 1;
+    }
+    if (len + ARRAY_SIZE(dl3) >= size) return FALSE;
+    lstrcpyW(path + len, dl3);
+    return TRUE;
+}
+
+static void delete_tree_contents(const WCHAR *dir, int depth)
+{
+    WIN32_FIND_DATAW fd;
+    WCHAR pattern[MAX_PATH], child[MAX_PATH];
+    HANDLE find;
+
+    if (depth > 16 || lstrlenW(dir) + 3 >= MAX_PATH) return;
+    swprintf(pattern, ARRAY_SIZE(pattern), L"%s\\*", dir);
+    if ((find = FindFirstFileW(pattern, &fd)) == INVALID_HANDLE_VALUE) return;
+#ifdef SG_MUTANT_FUS_CLEARDEEP
+    if (depth > 0) { FindClose(find); return; }
+#endif
+    do
+    {
+        if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L"..")) continue;
+        if (lstrlenW(dir) + lstrlenW(fd.cFileName) + 2 >= MAX_PATH) continue;
+        swprintf(child, ARRAY_SIZE(child), L"%s\\%s", dir, fd.cFileName);
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+        {
+            /* a link is removed, not followed */
+            if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT)) delete_tree_contents(child, depth + 1);
+            RemoveDirectoryW(child);
+        }
+        else
+        {
+            SetFileAttributesW(child, FILE_ATTRIBUTE_NORMAL);
+            DeleteFileW(child);
+        }
+    } while (FindNextFileW(find, &fd));
+    FindClose(find);
+}
+
