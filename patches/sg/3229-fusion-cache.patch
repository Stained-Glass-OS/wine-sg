+static HRESULT set_string(WCHAR **dest, const void *value, DWORD size)
+{
+    const WCHAR *src = value;
+    DWORD len;
+    WCHAR *copy;
+
+    /* the size counts the terminator, in bytes */
+    if (!src || size < sizeof(WCHAR) || (size % sizeof(WCHAR))) return E_INVALIDARG;
+    len = size / sizeof(WCHAR);
+    if (src[len - 1]) return E_INVALIDARG;
+    if (!(copy = wcsdup(src))) return E_OUTOFMEMORY;
+    free(*dest);
+    *dest = copy;
+    return S_OK;
+}
+
+static HRESULT set_version(IAssemblyNameImpl *name, unsigned int part, const void *value, DWORD size)
+{
+    if (!value || size != sizeof(WORD)) return E_INVALIDARG;
+    name->version[part] = *(const WORD *)value;
+    /* the parts before this one are zero if they were not set */
+#ifndef SG_MUTANT_FUS_VERSIZE
+    if (name->versize < part + 1) name->versize = part + 1;
+#endif
+    return S_OK;
+}
+
 static HRESULT WINAPI IAssemblyNameImpl_SetProperty(IAssemblyName *iface,
                                                     DWORD PropertyId,
                                                     LPVOID pvProperty,
                                                     DWORD cbProperty)
 {
-    FIXME("(%p, %ld, %p, %ld) stub!\n", iface, PropertyId, pvProperty, cbProperty);
-    return E_NOTIMPL;
+    IAssemblyNameImpl *name = impl_from_IAssemblyName(iface);
+    HRESULT hr;
+
+    TRACE("(%p, %ld, %p, %ld)\n", iface, PropertyId, pvProperty, cbProperty);
+
+    if (name->finalized) return E_UNEXPECTED;
+
+    switch (PropertyId)
+    {
+        case ASM_NAME_NAME:
+            hr = set_string(&name->name, pvProperty, cbProperty);
+            break;
+
+        case ASM_NAME_CULTURE:
+            hr = set_string(&name->culture, pvProperty, cbProperty);
+            break;
+
+        case ASM_NAME_MAJOR_VERSION:
+            hr = set_version(name, 0, pvProperty, cbProperty);
+            break;
+
+        case ASM_NAME_MINOR_VERSION:
+            hr = set_version(name, 1, pvProperty, cbProperty);
+            break;
+
+        case ASM_NAME_BUILD_NUMBER:
+            hr = set_version(name, 2, pvProperty, cbProperty);
+            break;
+
+        case ASM_NAME_REVISION_NUMBER:
+            hr = set_version(name, 3, pvProperty, cbProperty);
+            break;
+
+        case ASM_NAME_PUBLIC_KEY_TOKEN:
+            /* a null token has no data: the name is not strong */
+            if (!pvProperty || !cbProperty)
+            {
+                name->haspubkey = FALSE;
+                hr = S_OK;
+                break;
+            }
+            if (cbProperty != sizeof(name->pubkey)) return E_INVALIDARG;
+            memcpy(name->pubkey, pvProperty, sizeof(name->pubkey));
+            name->haspubkey = TRUE;
+            hr = S_OK;
+            break;
+
+        case ASM_NAME_PUBLIC_KEY:
+        {
+            /* the token is the last 8 bytes of the SHA-1 of the key, reversed */
+            BYTE hash[20];
+            DWORD i;
+
+            if (!pvProperty || !cbProperty) return E_INVALIDARG;
+            if (BCryptHash(BCRYPT_SHA1_ALG_HANDLE, NULL, 0, pvProperty, cbProperty, hash, sizeof(hash)))
+                return E_FAIL;
+#ifdef SG_MUTANT_FUS_KEYORDER
+            for (i = 0; i < BYTES_PER_TOKEN; i++) name->pubkey[i] = hash[sizeof(hash) - 8 + i];
+#else
+            for (i = 0; i < BYTES_PER_TOKEN; i++) name->pubkey[i] = hash[sizeof(hash) - 1 - i];
+#endif
+            name->haspubkey = TRUE;
+            hr = S_OK;
+            break;
+        }
+
+        case ASM_NAME_ARCHITECTURE:
+        {
