 static HRESULT WINAPI IAssemblyCacheItemImpl_Commit(IAssemblyCacheItem *iface,
                                                   DWORD dwFlags,
                                                   ULONG *pulDisposition)
 {
-    FIXME("(%p, %ld, %p) stub!\n", iface, dwFlags, pulDisposition);
-    return E_NOTIMPL;
+    IAssemblyCacheItemImpl *item = impl_from_IAssemblyCacheItem(iface);
+    ULONG disp = 0;
+    HRESULT hr;
+
+    TRACE("(%p, %ld, %p)\n", iface, dwFlags, pulDisposition);
+
+    if (dwFlags & ~(IASSEMBLYCACHEITEM_COMMIT_FLAG_REFRESH | IASSEMBLYCACHEITEM_COMMIT_FLAG_FORCE_REFRESH))
+        return E_INVALIDARG;
+    if (item->done) return E_UNEXPECTED;
+    /* an item without the stream of the manifest has no identity */
+#ifndef SG_MUTANT_FUS_NOMANIFEST
+    if (!item->manifest) return E_FAIL;
+#else
+    if (!item->manifest) return S_OK;
+#endif
+
+    hr = install_file(item->cache, dwFlags | item->flags, item->manifest, NULL, FALSE, &disp);
+    if (SUCCEEDED(hr))
+    {
+        item->done = TRUE;
+        remove_staging(item);
+        if (pulDisposition) *pulDisposition = disp;
+    }
+    return hr;
 }
 
 static HRESULT WINAPI IAssemblyCacheItemImpl_AbortItem(IAssemblyCacheItem *iface)
 {
-    FIXME("(%p) stub!\n", iface);
-    return E_NOTIMPL;
+    IAssemblyCacheItemImpl *item = impl_from_IAssemblyCacheItem(iface);
+
+    TRACE("(%p)\n", iface);
+
+    if (item->done) return E_UNEXPECTED;
+#ifndef SG_MUTANT_FUS_ABORT
+    item->done = TRUE;
+#endif
+    remove_staging(item);
+    return S_OK;
 }
 
