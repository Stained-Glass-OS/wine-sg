+    if (!(copy = malloc(sizeof(*copy)))) return E_OUTOFMEMORY;
+    copy->IAssemblyEnum_iface.lpVtbl = &AssemblyEnumVtbl;
+    copy->ref = 1;
+    list_init(&copy->assemblies);
