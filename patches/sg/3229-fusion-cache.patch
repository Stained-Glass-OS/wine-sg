+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "ole2.h"
+#include "guiddef.h"
+#include "fusion.h"
+#include "corerror.h"
+#include "fusionpriv.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(fusion);
+
+/* The references of an assembly are kept beside it in a text file, one reference
+ * per line: the scheme GUID, the identifier and the non canonical data, separated
+ * by tabs. */
+static const WCHAR ref_file[] = L"install.ref";
+
+struct ref_entry
+{
+    GUID scheme;
+    WCHAR *identifier;
+    WCHAR *data;
+};
+
+struct ref_list
+{
+    struct ref_entry *entries;
+    unsigned int count;
+};
+
+static void ref_list_free(struct ref_list *list)
+{
+    unsigned int i;
+
+    for (i = 0; i < list->count; i++)
+    {
+        free(list->entries[i].identifier);
+        free(list->entries[i].data);
+    }
+    free(list->entries);
+    list->entries = NULL;
+    list->count = 0;
+}
+
+static WCHAR *ref_path(const WCHAR *dir)
+{
+    int len = lstrlenW(dir);
+    WCHAR *path = malloc((len + 1 + ARRAY_SIZE(ref_file)) * sizeof(WCHAR));
+
+    if (!path) return NULL;
+    lstrcpyW(path, dir);
+    if (len && path[len - 1] != '\\') path[len++] = '\\';
+    lstrcpyW(path + len, ref_file);
+    return path;
+}
+
+static BOOL ref_equal(const struct ref_entry *e, const GUID *scheme, const WCHAR *identifier, const WCHAR *data)
+{
+    return IsEqualGUID(&e->scheme, scheme) && !lstrcmpW(e->identifier, identifier) &&
+           !lstrcmpW(e->data, data ? data : L"");
+}
+
+static HRESULT ref_list_add(struct ref_list *list, const GUID *scheme, const WCHAR *identifier, const WCHAR *data)
+{
+    struct ref_entry *entries, *e;
+
+    if (!(entries = realloc(list->entries, (list->count + 1) * sizeof(*entries)))) return E_OUTOFMEMORY;
+    list->entries = entries;
+    e = &entries[list->count];
+    e->scheme = *scheme;
+    e->identifier = wcsdup(identifier);
+    e->data = wcsdup(data ? data : L"");
+    if (!e->identifier || !e->data)
+    {
+        free(e->identifier);
+        free(e->data);
+        return E_OUTOFMEMORY;
+    }
+    list->count++;
+    return S_OK;
+}
+
+static HRESULT ref_load(const WCHAR *dir, struct ref_list *list)
+{
+    HANDLE file;
+    WCHAR *path, *text, *line, *next;
+    DWORD size, read;
+    char *raw;
+    HRESULT hr = S_OK;
+
+    memset(list, 0, sizeof(*list));
+    if (!(path = ref_path(dir))) return E_OUTOFMEMORY;
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    free(path);
+    if (file == INVALID_HANDLE_VALUE) return S_OK;
+
+    size = GetFileSize(file, NULL);
+    raw = malloc(size + 1);
+    if (!raw || !ReadFile(file, raw, size, &read, NULL))
+    {
+        CloseHandle(file);
+        free(raw);
+        return E_FAIL;
+    }
+    CloseHandle(file);
+    raw[read] = 0;
+    size = MultiByteToWideChar(CP_UTF8, 0, raw, -1, NULL, 0);
+    text = malloc(size * sizeof(WCHAR));
+    if (text) MultiByteToWideChar(CP_UTF8, 0, raw, -1, text, size);
+    free(raw);
+    if (!text) return E_OUTOFMEMORY;
+
+    for (line = text; line && *line; line = next)
+    {
+        WCHAR *id, *data;
+        GUID scheme;
+
+        if ((next = wcschr(line, '\n'))) *next++ = 0;
+        if (!(id = wcschr(line, '\t'))) continue;
+        *id++ = 0;
+        data = wcschr(id, '\t');
+        if (data) *data++ = 0;
+        if (CLSIDFromString(line, &scheme) != S_OK) continue;
+        if (FAILED(hr = ref_list_add(list, &scheme, id, data))) break;
+    }
+    free(text);
+    if (FAILED(hr)) ref_list_free(list);
+    return hr;
+}
+
+static HRESULT ref_save(const WCHAR *dir, const struct ref_list *list)
+{
+    WCHAR *path = ref_path(dir), guid[40];
+    HANDLE file;
+    unsigned int i;
+    HRESULT hr = S_OK;
+
+    if (!path) return E_OUTOFMEMORY;
+    if (!list->count)
+    {
+        DeleteFileW(path);
+        free(path);
+        return S_OK;
+    }
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+    free(path);
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+
+    for (i = 0; i < list->count && hr == S_OK; i++)
+    {
+        const struct ref_entry *e = &list->entries[i];
+        int len = lstrlenW(e->identifier) + lstrlenW(e->data) + 64;
+        WCHAR *line = malloc(len * sizeof(WCHAR));
+        char *utf8;
+        DWORD written;
+
+        if (!line) { hr = E_OUTOFMEMORY; break; }
+        StringFromGUID2(&e->scheme, guid, ARRAY_SIZE(guid));
+        swprintf(line, len, L"%s\t%s\t%s\n", guid, e->identifier, e->data);
+        len = WideCharToMultiByte(CP_UTF8, 0, line, -1, NULL, 0, NULL, NULL);
+        utf8 = malloc(len);
+        if (utf8)
+        {
+            WideCharToMultiByte(CP_UTF8, 0, line, -1, utf8, len, NULL, NULL);
+            if (!WriteFile(file, utf8, len - 1, &written, NULL)) hr = HRESULT_FROM_WIN32(GetLastError());
+        }
+        else hr = E_OUTOFMEMORY;
+        free(utf8);
+        free(line);
+    }
+    CloseHandle(file);
+    return hr;
+}
+
+static BOOL ref_valid(const FUSION_INSTALL_REFERENCE *ref)
+{
+    const WCHAR *p;
+
+#ifdef SG_MUTANT_FUS_REFVALID
+    if (IsBadReadPtr(ref, sizeof(*ref)) || ref->dwFlags) return FALSE;
+#else
+    if (IsBadReadPtr(ref, sizeof(*ref)) || ref->cbSize != sizeof(*ref) || ref->dwFlags) return FALSE;
+#endif
+    if (!ref->szIdentifier || !*ref->szIdentifier) return FALSE;
+    /* the file keeps one line per reference */
+    for (p = ref->szIdentifier; *p; p++) if (*p == '\t' || *p == '\n' || *p == '\r') return FALSE;
+    if (ref->szNonCannonicalData)
+        for (p = ref->szNonCannonicalData; *p; p++) if (*p == '\t' || *p == '\n' || *p == '\r') return FALSE;
+    return TRUE;
+}
+
+/* does the assembly directory have any reference */
+HRESULT fusion_refs_count(const WCHAR *dir, unsigned int *count)
+{
+    struct ref_list list;
+    HRESULT hr = ref_load(dir, &list);
+
+    *count = list.count;
+    ref_list_free(&list);
+    return hr;
+}
+
+HRESULT fusion_refs_add(const WCHAR *dir, const FUSION_INSTALL_REFERENCE *ref)
+{
+    struct ref_list list;
+    unsigned int i;
+    HRESULT hr;
+
+    if (!ref_valid(ref)) return E_INVALIDARG;
+    if (FAILED(hr = ref_load(dir, &list))) return hr;
+    for (i = 0; i < list.count; i++)
+        if (ref_equal(&list.entries[i], &ref->guidScheme, ref->szIdentifier, ref->szNonCannonicalData)) break;
+#ifdef SG_MUTANT_FUS_REFDUP
+    i = list.count;
+#endif
+    if (i == list.count && SUCCEEDED(hr = ref_list_add(&list, &ref->guidScheme, ref->szIdentifier,
+                                                       ref->szNonCannonicalData)))
+        hr = ref_save(dir, &list);
+    ref_list_free(&list);
+    return hr;
+}
+
+/* remove the reference: S_OK if it was there, S_FALSE if not; REMAINING is the number left */
+HRESULT fusion_refs_remove(const WCHAR *dir, const FUSION_INSTALL_REFERENCE *ref, unsigned int *remaining)
+{
+    struct ref_list list;
+    unsigned int i;
+    HRESULT hr;
+
+    if (!ref_valid(ref)) return E_INVALIDARG;
+    if (FAILED(hr = ref_load(dir, &list))) return hr;
+    for (i = 0; i < list.count; i++)
+        if (ref_equal(&list.entries[i], &ref->guidScheme, ref->szIdentifier, ref->szNonCannonicalData)) break;
+    if (i == list.count) hr = S_FALSE;
+    else
+    {
+        free(list.entries[i].identifier);
+        free(list.entries[i].data);
+        memmove(&list.entries[i], &list.entries[i + 1], (list.count - i - 1) * sizeof(*list.entries));
+        list.count--;
+        hr = ref_save(dir, &list);
+        if (SUCCEEDED(hr)) hr = S_OK;
+    }
+    *remaining = list.count;
+    ref_list_free(&list);
+    return hr;
+}
+
+void fusion_refs_delete(const WCHAR *dir)
+{
+    WCHAR *path = ref_path(dir);
+
+    if (path) DeleteFileW(path);
+    free(path);
+}
+
+/* IInstallReferenceItem */
+struct ref_item
+{
+    IInstallReferenceItem IInstallReferenceItem_iface;
+    LONG ref;
+    FUSION_INSTALL_REFERENCE data;
+    WCHAR *identifier, *noncanonical;
+};
+
+static struct ref_item *item_from_iface(IInstallReferenceItem *iface)
+{
+    return CONTAINING_RECORD(iface, struct ref_item, IInstallReferenceItem_iface);
+}
+
+static HRESULT WINAPI item_QueryInterface(IInstallReferenceItem *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IInstallReferenceItem))
+    {
+        *obj = iface;
+        IInstallReferenceItem_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI item_AddRef(IInstallReferenceItem *iface)
+{
+    return InterlockedIncrement(&item_from_iface(iface)->ref);
+}
+
+static ULONG WINAPI item_Release(IInstallReferenceItem *iface)
+{
+    struct ref_item *item = item_from_iface(iface);
+    ULONG ref = InterlockedDecrement(&item->ref);
+
+    if (!ref)
+    {
+        free(item->identifier);
+        free(item->noncanonical);
+        free(item);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI item_GetReference(IInstallReferenceItem *iface, LPFUSION_INSTALL_REFERENCE *data,
+                                        DWORD flags, void *reserved)
+{
+    struct ref_item *item = item_from_iface(iface);
+
+    TRACE("(%p, %p, %#lx, %p)\n", iface, data, flags, reserved);
+
+    if (!data || flags || reserved) return E_INVALIDARG;
+    *data = &item->data;
+    return S_OK;
+}
+
+static const IInstallReferenceItemVtbl item_vtbl =
+{
+    item_QueryInterface,
+    item_AddRef,
+    item_Release,
+    item_GetReference
+};
+
+/* IInstallReferenceEnum */
+struct ref_enum
+{
+    IInstallReferenceEnum IInstallReferenceEnum_iface;
+    LONG ref;
+    struct ref_list list;
+    unsigned int pos;
+};
+
+static struct ref_enum *enum_from_iface(IInstallReferenceEnum *iface)
+{
+    return CONTAINING_RECORD(iface, struct ref_enum, IInstallReferenceEnum_iface);
+}
+
+static HRESULT WINAPI enum_QueryInterface(IInstallReferenceEnum *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IInstallReferenceEnum))
+    {
+        *obj = iface;
+        IInstallReferenceEnum_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_AddRef(IInstallReferenceEnum *iface)
+{
+    return InterlockedIncrement(&enum_from_iface(iface)->ref);
+}
+
+static ULONG WINAPI enum_Release(IInstallReferenceEnum *iface)
+{
+    struct ref_enum *e = enum_from_iface(iface);
+    ULONG ref = InterlockedDecrement(&e->ref);
+
+    if (!ref)
+    {
+        ref_list_free(&e->list);
+        free(e);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_GetNextInstallReferenceItem(IInstallReferenceEnum *iface, IInstallReferenceItem **ret,
+                                                       DWORD flags, void *reserved)
+{
+    struct ref_enum *e = enum_from_iface(iface);
+    struct ref_item *item;
+    const struct ref_entry *entry;
+
+    TRACE("(%p, %p, %#lx, %p)\n", iface, ret, flags, reserved);
+
+    if (!ret || flags || reserved) return E_INVALIDARG;
+    *ret = NULL;
+    if (e->pos >= e->list.count) return S_FALSE;
+    entry = &e->list.entries[e->pos];
+
+    if (!(item = calloc(1, sizeof(*item)))) return E_OUTOFMEMORY;
+    item->IInstallReferenceItem_iface.lpVtbl = &item_vtbl;
+    item->ref = 1;
+    item->identifier = wcsdup(entry->identifier);
+    item->noncanonical = wcsdup(entry->data);
+    if (!item->identifier || !item->noncanonical)
+    {
+        item_Release(&item->IInstallReferenceItem_iface);
+        return E_OUTOFMEMORY;
+    }
+    item->data.cbSize = sizeof(item->data);
+    item->data.guidScheme = entry->scheme;
+    item->data.szIdentifier = item->identifier;
+    item->data.szNonCannonicalData = item->noncanonical;
+    e->pos++;
+    *ret = &item->IInstallReferenceItem_iface;
+    return S_OK;
+}
+
+static const IInstallReferenceEnumVtbl enum_vtbl =
+{
+    enum_QueryInterface,
+    enum_AddRef,
+    enum_Release,
+    enum_GetNextInstallReferenceItem
+};
+
+/* the assembly NAME in the cache: the directory of its files */
+static HRESULT find_assembly_dir(IAssemblyName *name, WCHAR *dir, DWORD size)
+{
+    IAssemblyEnum *asmenum;
+    IAssemblyName *next;
+    WCHAR *p, path[MAX_PATH];
+    ULONG len;
+    HRESULT hr;
+
+    if (FAILED(hr = CreateAssemblyEnum(&asmenum, NULL, name, ASM_CACHE_GAC, NULL))) return hr;
+    for (;;)
+    {
+        hr = IAssemblyEnum_GetNextAssembly(asmenum, NULL, &next, 0);
+        if (hr != S_OK)
+        {
+            hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+            break;
+        }
+        if (IAssemblyName_IsEqual(name, next, ASM_CMPF_IL_ALL) == S_OK)
+        {
+            len = ARRAY_SIZE(path);
+            hr = IAssemblyName_GetPath(next, path, &len);
+            IAssemblyName_Release(next);
+            if (SUCCEEDED(hr))
+            {
+                if ((p = wcsrchr(path, '\\'))) *p = 0;
+                lstrcpynW(dir, path, size);
+            }
+            break;
+        }
+        IAssemblyName_Release(next);
+    }
+    IAssemblyEnum_Release(asmenum);
+    return hr;
+}
+
+HRESULT fusion_assembly_dir(IAssemblyName *name, WCHAR *dir, DWORD size)
+{
+    return find_assembly_dir(name, dir, size);
+}
+
+/******************************************************************
+ *  CreateInstallReferenceEnum   (FUSION.@)
+ */
+HRESULT WINAPI CreateInstallReferenceEnum(IInstallReferenceEnum **ret, IAssemblyName *name, DWORD flags,
+                                          LPVOID reserved)
+{
+    struct ref_enum *e;
+    WCHAR dir[MAX_PATH];
+    HRESULT hr;
+
+    TRACE("(%p, %p, %#lx, %p)\n", ret, name, flags, reserved);
+
+    if (!ret || !name || flags || reserved) return E_INVALIDARG;
+    *ret = NULL;
+
+    if (FAILED(hr = find_assembly_dir(name, dir, ARRAY_SIZE(dir)))) return hr;
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
+    e->IInstallReferenceEnum_iface.lpVtbl = &enum_vtbl;
+    e->ref = 1;
+    if (FAILED(hr = ref_load(dir, &e->list)))
+    {
+        free(e);
+        return hr;
+    }
+    *ret = &e->IInstallReferenceEnum_iface;
+    return S_OK;
+}
