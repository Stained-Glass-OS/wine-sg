From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] propsys: PropVariantChangeType vectors/arrays and VT_INT/VT_UINT (3659)

propsys: PropVariantChangeType vectors/arrays and VT_INT/VT_UINT

Implements the vector and array rows of the documented conversion table: a
single-valued vector converts to a plain value of any supported type, and a
vector and a one-dimensional array of the same plain element type convert
into each other. VT_INT and VT_UINT take part in the numeric conversions
like VT_I4 and VT_UI4. The "semi-stub" FIXME is gone.
---
diff --git a/dlls/propsys/propsys_main.c b/dlls/propsys/propsys_main.c
index fa3de1d..2fd1b2a 100644
--- a/dlls/propsys/propsys_main.c
+++ b/dlls/propsys/propsys_main.c
@@ -116,7 +116,7 @@ static HRESULT WINAPI propsys_QueryInterface(IPropertySystem *iface, REFIID riid
         return S_OK;
     }
 
-    FIXME("%s\n", debugstr_guid(riid));
+    WARN("%s\n", debugstr_guid(riid));
     return E_NOINTERFACE;
 }
 
diff --git a/dlls/propsys/propvar.c b/dlls/propsys/propvar.c
index 4e54c2f..c68496c 100644
--- a/dlls/propsys/propvar.c
+++ b/dlls/propsys/propvar.c
@@ -149,10 +149,14 @@ static HRESULT PROPVAR_ConvertNumber(REFPROPVARIANT pv, int dest_bits,
         *res = pv->uiVal;
         break;
     case VT_I4:
+#ifndef SG_MUTANT_PROPSYS_INT
+    case VT_INT:
+#endif
         src_signed = TRUE;
         *res = pv->lVal;
         break;
     case VT_UI4:
+    case VT_UINT:
         src_signed = FALSE;
         *res = pv->ulVal;
         break;
@@ -803,17 +807,96 @@ HRESULT WINAPI VariantToString(REFVARIANT var, PWSTR ret, UINT cch)
 /******************************************************************
  *  PropVariantChangeType   (PROPSYS.@)
  */
+static HRESULT propvar_get_element(const PROPVARIANT *pv, ULONG index, PROPVARIANT *elem);
+
+/* element sizes of the plain-data types a vector and a safe array can share */
+static ULONG propvar_array_element_size(VARTYPE vt)
+{
+    switch (vt)
+    {
+    case VT_I1: case VT_UI1: return 1;
+    case VT_I2: case VT_UI2: case VT_BOOL: return 2;
+    case VT_I4: case VT_UI4: case VT_R4: return 4;
+    case VT_I8: case VT_UI8: case VT_R8: return 8;
+    default: return 0;
+    }
+}
+
 HRESULT WINAPI PropVariantChangeType(PROPVARIANT *ppropvarDest, REFPROPVARIANT propvarSrc,
                                      PROPVAR_CHANGE_FLAGS flags, VARTYPE vt)
 {
     HRESULT hr;
 
-    FIXME("(%p, %p, %d, %d, %d): semi-stub!\n", ppropvarDest, propvarSrc,
-          propvarSrc->vt, flags, vt);
+    TRACE("(%p, %p, %d, %d, %d)\n", ppropvarDest, propvarSrc, propvarSrc->vt, flags, vt);
 
     if (vt == propvarSrc->vt)
         return PropVariantCopy(ppropvarDest, propvarSrc);
 
+    /* vectors and arrays: a single-valued vector converts to a plain value, a vector and an
+     * array of the same element type and count convert into each other */
+#ifndef SG_MUTANT_PROPSYS_VECTOR
+    if (propvarSrc->vt & VT_VECTOR)
+    {
+        if (vt & VT_VECTOR)
+            return DISP_E_TYPEMISMATCH;
+        if (vt & VT_ARRAY)
+        {
+            VARTYPE ev = vt & ~VT_ARRAY;
+            ULONG size = propvar_array_element_size(ev);
+            SAFEARRAY *sa;
+            void *data;
+
+            if (ev != (propvarSrc->vt & ~VT_VECTOR) || !size || !propvarSrc->caub.cElems)
+                return DISP_E_TYPEMISMATCH;
+            if (!(sa = SafeArrayCreateVector(ev, 0, propvarSrc->caub.cElems))) return E_OUTOFMEMORY;
+            if (FAILED(hr = SafeArrayAccessData(sa, &data)))
+            {
+                SafeArrayDestroy(sa);
+                return hr;
+            }
+            memcpy(data, propvarSrc->caub.pElems, propvarSrc->caub.cElems * size);
+            SafeArrayUnaccessData(sa);
+            ppropvarDest->vt = vt;
+            ppropvarDest->parray = sa;
+            return S_OK;
+        }
+        if (propvarSrc->caub.cElems != 1)
+            return DISP_E_TYPEMISMATCH;
+        {
+            PROPVARIANT elem;
+
+            if (FAILED(hr = propvar_get_element(propvarSrc, 0, &elem))) return DISP_E_TYPEMISMATCH;
+            return PropVariantChangeType(ppropvarDest, &elem, flags, vt);
+        }
+    }
+    if ((propvarSrc->vt & VT_ARRAY) && (vt & VT_VECTOR))
+    {
+        VARTYPE ev = vt & ~VT_VECTOR;
+        ULONG size = propvar_array_element_size(ev), count;
+        SAFEARRAY *sa = propvarSrc->parray;
+        void *data, *items;
+        LONG lb, ub;
+
+        if (ev != (propvarSrc->vt & ~VT_ARRAY) || !size || !sa || SafeArrayGetDim(sa) != 1)
+            return DISP_E_TYPEMISMATCH;
+        if (FAILED(hr = SafeArrayGetLBound(sa, 1, &lb)) || FAILED(hr = SafeArrayGetUBound(sa, 1, &ub))) return hr;
+        count = ub - lb + 1;
+        if (!count) return DISP_E_TYPEMISMATCH;
+        if (!(items = CoTaskMemAlloc(count * size))) return E_OUTOFMEMORY;
+        if (FAILED(hr = SafeArrayAccessData(sa, &data)))
+        {
+            CoTaskMemFree(items);
+            return hr;
+        }
+        memcpy(items, data, count * size);
+        SafeArrayUnaccessData(sa);
+        ppropvarDest->vt = vt;
+        ppropvarDest->caub.cElems = count;
+        ppropvarDest->caub.pElems = items;
+        return S_OK;
+    }
+#endif
+
     if (propvarSrc->vt == VT_FILETIME)
         return PROPVAR_ConvertFILETIME(&propvarSrc->filetime, ppropvarDest, vt);
 
@@ -868,23 +951,25 @@ HRESULT WINAPI PropVariantChangeType(PROPVARIANT *ppropvarDest, REFPROPVARIANT p
         return hr;
     }
     case VT_I4:
+    case VT_INT:
     {
         LONG res;
         hr = PropVariantToInt32(propvarSrc, &res);
         if (SUCCEEDED(hr))
         {
-            ppropvarDest->vt = VT_I4;
+            ppropvarDest->vt = vt;
             ppropvarDest->lVal = res;
         }
         return hr;
     }
     case VT_UI4:
+    case VT_UINT:
     {
         ULONG res;
         hr = PropVariantToUInt32(propvarSrc, &res);
         if (SUCCEEDED(hr))
         {
-            ppropvarDest->vt = VT_UI4;
+            ppropvarDest->vt = vt;
             ppropvarDest->ulVal = res;
         }
         return hr;
diff --git a/dlls/propsys/tests/Makefile.in b/dlls/propsys/tests/Makefile.in
index e58dd57..4ec1815 100644
--- a/dlls/propsys/tests/Makefile.in
+++ b/dlls/propsys/tests/Makefile.in
@@ -2,4 +2,5 @@ TESTDLL   = propsys.dll
 IMPORTS   = propsys ole32 oleaut32
 
 SOURCES = \
-	propsys.c
+	propsys.c \
+	sgcalls.c
diff --git a/dlls/propsys/tests/sgcalls.c b/dlls/propsys/tests/sgcalls.c
new file mode 100644
index 0000000..5ced109
--- /dev/null
+++ b/dlls/propsys/tests/sgcalls.c
@@ -0,0 +1,144 @@
+/*
+ * Stained Glass OS additions: propsys type conversions.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define COBJMACROS
+#include <windows.h>
+#include <propsys.h>
+#include <propvarutil.h>
+
+#include "wine/test.h"
+
+static void test_int_types(void)
+{
+    PROPVARIANT src, dst;
+    LONG l;
+    ULONG ul;
+    SHORT s;
+    HRESULT hr;
+
+    PropVariantInit(&src);
+    src.vt = VT_INT;
+    src.lVal = -12345;
+
+    hr = PropVariantToInt32(&src, &l);
+    ok(hr == S_OK && l == -12345, "got %#lx %ld\n", hr, l);
+    hr = PropVariantToInt16(&src, &s);
+    ok(hr == S_OK && s == -12345, "got %#lx %d\n", hr, s);
+    hr = PropVariantToUInt32(&src, &ul);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_ARITHMETIC_OVERFLOW), "got %#lx\n", hr);
+
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_I4);
+    ok(hr == S_OK && dst.vt == VT_I4 && dst.lVal == -12345, "got %#lx vt %d %ld\n", hr, dst.vt, dst.lVal);
+
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_I8);
+    ok(hr == S_OK && dst.vt == VT_I8 && dst.hVal.QuadPart == -12345, "got %#lx vt %d\n", hr, dst.vt);
+
+    src.vt = VT_I4;
+    src.lVal = 77;
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_INT);
+    ok(hr == S_OK && dst.vt == VT_INT && dst.lVal == 77, "got %#lx vt %d %ld\n", hr, dst.vt, dst.lVal);
+
+    src.vt = VT_UINT;
+    src.ulVal = 4000000000u;
+    hr = PropVariantToUInt32(&src, &ul);
+    ok(hr == S_OK && ul == 4000000000u, "got %#lx %lu\n", hr, ul);
+    hr = PropVariantToInt32(&src, &l);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_ARITHMETIC_OVERFLOW), "got %#lx\n", hr);
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_UINT);
+    ok(hr == S_OK && dst.vt == VT_UINT && dst.ulVal == 4000000000u, "got %#lx vt %d\n", hr, dst.vt);
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_UI8);
+    ok(hr == S_OK && dst.vt == VT_UI8 && dst.uhVal.QuadPart == 4000000000u, "got %#lx\n", hr);
+
+    /* unsupported target stays an error */
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_UINT | VT_VECTOR);
+    ok(FAILED(hr), "got %#lx\n", hr);
+}
+
+static HRESULT make_i4_vector(const LONG *vals, ULONG count, PROPVARIANT *pv)
+{
+    PropVariantInit(pv);
+    pv->cal.pElems = CoTaskMemAlloc(count * sizeof(LONG));
+    if (!pv->cal.pElems) return E_OUTOFMEMORY;
+    memcpy(pv->cal.pElems, vals, count * sizeof(LONG));
+    pv->cal.cElems = count;
+    pv->vt = VT_VECTOR | VT_I4;
+    return S_OK;
+}
+
+static void test_vectors(void)
+{
+    PROPVARIANT src, dst, back;
+    LONG vals[3] = { 5, -6, 7 }, one = 42, *data;
+    LONG l;
+    HRESULT hr;
+
+    hr = make_i4_vector(&one, 1, &src);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    /* a single-valued vector converts to a plain value */
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_I4);
+    ok(hr == S_OK && dst.vt == VT_I4 && dst.lVal == 42, "got %#lx vt %d %ld\n", hr, dst.vt, dst.lVal);
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_I8);
+    ok(hr == S_OK && dst.vt == VT_I8 && dst.hVal.QuadPart == 42, "got %#lx vt %d\n", hr, dst.vt);
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_LPWSTR);
+    ok(hr == S_OK && dst.vt == VT_LPWSTR && !wcscmp(dst.pwszVal, L"42"), "got %#lx vt %d\n", hr, dst.vt);
+    PropVariantClear(&dst);
+    PropVariantClear(&src);
+
+    /* a multi-valued vector does not */
+    hr = make_i4_vector(vals, 3, &src);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_I4);
+    ok(hr == DISP_E_TYPEMISMATCH, "got %#lx\n", hr);
+
+    /* vector to array and back */
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_ARRAY | VT_I4);
+    ok(hr == S_OK && dst.vt == (VT_ARRAY | VT_I4), "got %#lx vt %#x\n", hr, dst.vt);
+    if (hr == S_OK)
+    {
+        ok(SafeArrayGetDim(dst.parray) == 1, "dims\n");
+        hr = SafeArrayAccessData(dst.parray, (void **)&data);
+        ok(hr == S_OK && data[0] == 5 && data[1] == -6 && data[2] == 7, "got %#lx\n", hr);
+        SafeArrayUnaccessData(dst.parray);
+
+        PropVariantInit(&back);
+        hr = PropVariantChangeType(&back, &dst, 0, VT_VECTOR | VT_I4);
+        ok(hr == S_OK && back.vt == (VT_VECTOR | VT_I4) && back.cal.cElems == 3
+                && back.cal.pElems[0] == 5 && back.cal.pElems[1] == -6 && back.cal.pElems[2] == 7,
+                "got %#lx vt %#x\n", hr, back.vt);
+        PropVariantClear(&back);
+
+        PropVariantInit(&back);
+        hr = PropVariantChangeType(&back, &dst, 0, VT_VECTOR | VT_I2);
+        ok(hr == DISP_E_TYPEMISMATCH, "got %#lx\n", hr);
+        PropVariantClear(&dst);
+    }
+    PropVariantInit(&dst);
+    hr = PropVariantChangeType(&dst, &src, 0, VT_ARRAY | VT_I2);
+    ok(hr == DISP_E_TYPEMISMATCH, "got %#lx\n", hr);
+    PropVariantClear(&src);
+    (void)l;
+}
+
+START_TEST(sgcalls)
+{
+    test_int_types();
+    test_vectors();
+}
