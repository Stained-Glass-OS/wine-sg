+    if (!count || !get_pointer_data( id, &data )) return FALSE;
+    if (data.type != PT_TOUCH)
+    {
+        SetLastError(ERROR_DATATYPE_MISMATCH);
+        return FALSE;
+    }
+    if (info && *count) fill_touch_info( &data, info );
+    *count = 1;
+    return TRUE;
 }
 
