+
+/* ---- Stained Glass OS (wine-sg 1150): touches as touches ------------------
+ *
+ * A touch screen's touch reaches a program as WM_POINTER* of PT_TOUCH (the
+ * display driver's, to the window it went down on; here, to the child window
+ * under it). For each thread: the touches down, for GetPointerTouchInfo,
+ * GetPointerFrameTouchInfo and the like; whether the window took a touch's
+ * WM_POINTERDOWN itself (the server makes the first touch the mouse too, and
+ * those mouse messages are dropped for such a window, as Windows makes no
+ * mouse of a touch a program took); and, for windows leaving the pointer
+ * messages to DefWindowProc, what Windows makes of them there -- WM_TOUCH
+ * for a window registered for it (RegisterTouchWindow), WM_GESTURE for the
+ * others: two fingers moving together pan, spreading or closing zoom; and
+ * DefWindowProc's WM_GESTURE is the mouse wheel, and Ctrl+wheel for a zoom
+ * (the page follows the fingers, as on a phone). */
+
+#define SG_MAX_TRACKED 16
+
+struct sg_touch
+{
+    struct sg_pointer_data data;   /* its last message (type PT_TOUCH) */
+    UINT   hw_id;                  /* the hardware message it was last in */
+    BOOL   lifted;                 /* WM_POINTERUP retrieved */
+    BOOL   dispatching;            /* its WM_POINTERDOWN is being dispatched */
+    BOOL   defproc;                /* ... and reached DefWindowProc */
+    BOOL   aware;                  /* its window took its WM_POINTERDOWN itself */
+    UINT   defproc_frame;          /* the last of its messages DefWindowProc saw */
+    DWORD  age;
+};
+
+enum { GESTURE_NONE, GESTURE_PAN, GESTURE_ZOOM, GESTURE_DONE };
+
+struct sg_touch_state
+{
+    struct sg_touch touches[SG_MAX_TRACKED];
+    DWORD  age;
+    UINT   current_hw_id;
+    /* the gesture of two fingers */
+    int    mode;
+    HWND   gesture_hwnd;
+    double sx, sy, sdist;          /* when the second finger came down */
+    struct sg_gesture gesture;     /* the WM_GESTURE being sent */
+    UINT32 sequence, instance;
+    double last_x, last_y, last_dist; /* its last pan or zoom */
+    /* DefWindowProc's wheel for it */
+    double wheel_x, wheel_y, wheel_dist;
+    /* WM_TOUCH: the inputs of the last few */
+    struct sg_touch_input inputs[8];
+    UINT32 input_handle;
+};
+
+static struct sg_touch_state *get_touch_state( BOOL create )
+{
+    struct user_thread_info *info = get_user_thread_info();
+    if (!info->sg_touch && create) info->sg_touch = calloc( 1, sizeof(*info->sg_touch) );
+    return info->sg_touch;
+}
+
+void free_touch_state(void)
+{
+    struct user_thread_info *info = get_user_thread_info();
+    free( info->sg_touch );
+    info->sg_touch = NULL;
+}
+
+static struct sg_touch *find_touch( struct sg_touch_state *state, UINT32 id )
+{
+    struct sg_touch *found = NULL;
+    int i;
+
+    if (!state) return NULL;
+    for (i = 0; i < SG_MAX_TRACKED; i++)
+        if (state->touches[i].data.id == id && (!found || state->touches[i].age > found->age))
+            found = &state->touches[i];
+    return found;
+}
+
+static UINT count_touches_down( struct sg_touch_state *state )
+{
+    UINT i, count = 0;
+    for (i = 0; i < SG_MAX_TRACKED; i++)
+        if (state->touches[i].data.id && !state->touches[i].lifted) count++;
+    return count;
+}
+
+/* a touch going down on a window of a program in the background brings it
+ * to the front, as a click does (for a program taking touches itself no
+ * mouse click is made of them) -- unless the window says not to
+ * (WM_POINTERACTIVATE, PA_NOACTIVATE; a WS_EX_NOACTIVATE window, as a touch
+ * keyboard is) */
+static void touch_activate( HWND hwnd )
+{
+    HWND top = NtUserGetAncestor( hwnd, GA_ROOT );
+
+#ifdef SG_MUTANT_NO_TOUCH_ACTIVATE
+    return;
+#endif
+    if (!top || top == get_desktop_window() || top == NtUserGetForegroundWindow()) return;
+    if (get_window_long( top, GWL_EXSTYLE ) & WS_EX_NOACTIVATE) return;
+    if (send_message( hwnd, WM_POINTERACTIVATE, (WPARAM)top, MAKELPARAM( HTCLIENT, WM_POINTERDOWN ) ) == PA_NOACTIVATE)
+        return;
+    set_foreground_window( top, TRUE );
+}
+
+/* a touch's WM_POINTER* retrieved (process_pointer_message): where it is,
+ * the window it goes to, and its state */
+void sg_touch_retrieved( MSG *msg, UINT hw_id, UINT32 info )
+{
+    struct sg_touch_state *state = get_touch_state( TRUE );
+    struct sg_pointer_data *last = &get_user_thread_info()->sg_pointer;
+    UINT32 id = LOWORD( msg->wParam ), flags = HIWORD( msg->wParam );
+    struct sg_touch *touch;
+    INT hittest;
+    HWND child;
+    int i;
+
+    msg->pt.x = (short)LOWORD( msg->lParam );
+    msg->pt.y = (short)HIWORD( msg->lParam );
+    if (!state) return;
+    state->current_hw_id = hw_id;
+
+    touch = find_touch( state, id );
+    /* a new touch (its id may be an earlier one's) */
+    if (touch && touch->lifted && touch->hw_id != hw_id &&
+        (msg->message == WM_POINTERENTER || msg->message == WM_POINTERDOWN)) touch = NULL;
+    if (!touch)
+    {
+        struct sg_touch *slot = NULL;
+        /* a free slot, else the oldest lifted touch's, else the oldest's */
+        for (i = 0; i < SG_MAX_TRACKED; i++)
+        {
+            struct sg_touch *t = &state->touches[i];
+            if (!t->data.id) { slot = t; break; }
+            if (!slot || (t->lifted && !slot->lifted) || (t->lifted == slot->lifted && t->age < slot->age)) slot = t;
+        }
+        touch = slot;
+        memset( touch, 0, sizeof(*touch) );
+        touch->data.id = id;
+        touch->age = ++state->age;
+        /* when the screen was last touched, and the window touched, for the
+         * touch keyboard (sg-shell's sg-touchkbd shows itself for a text field
+         * focused by a touch) */
+        if (msg->message == WM_POINTERDOWN || msg->message == WM_POINTERENTER)
+        {
+            static const WCHAR touch_timeW[] = {'_','_','w','i','n','e','_','s','g','_','t','o','u','c','h','_','t','i','m','e',0};
+            static const WCHAR touch_hwndW[] = {'_','_','w','i','n','e','_','s','g','_','t','o','u','c','h','_','h','w','n','d',0};
+            NtUserSetProp( get_desktop_window(), touch_hwndW, msg->hwnd );
+            NtUserSetProp( get_desktop_window(), touch_timeW, ULongToHandle( NtGetTickCount() | 1 ) );
+        }
+    }
+
+    /* to the child window under it when it goes down, and there it stays */
+    if (msg->message == WM_POINTERDOWN || msg->message == WM_POINTERENTER || !touch->data.hwnd ||
+        !is_current_thread_window( UlongToHandle( touch->data.hwnd ) ))
+    {
+        if ((child = window_from_point( msg->hwnd, msg->pt, &hittest )) && is_current_thread_window( child ))
+            msg->hwnd = child;
+    }
+    else msg->hwnd = UlongToHandle( touch->data.hwnd );
+
+    if (msg->message == WM_POINTERDOWN) flags |= POINTER_FLAG_DOWN;
+    else if (msg->message == WM_POINTERUP) flags |= POINTER_FLAG_UP;
+    else if (msg->message == WM_POINTERUPDATE) flags |= POINTER_FLAG_UPDATE;
+
+    if (msg->message == WM_POINTERDOWN && touch->hw_id != hw_id) touch_activate( msg->hwnd );
+    touch->hw_id = hw_id;
+    touch->lifted = msg->message == WM_POINTERUP || msg->message == WM_POINTERLEAVE;
+    touch->data.type = PT_TOUCH;
+    touch->data.frame = hw_id;
+    touch->data.flags = flags;
+    touch->data.device = SG_TOUCH_DEVICE_HANDLE( SG_TOUCH_XI_DEVICE( info ) );
+    touch->data.hwnd = HandleToUlong( msg->hwnd );
+    touch->data.x = msg->pt.x;
+    touch->data.y = msg->pt.y;
+    touch->data.time = msg->time;
+    touch->data.button_change = msg->message == WM_POINTERDOWN ? POINTER_CHANGE_FIRSTBUTTON_DOWN :
+                                msg->message == WM_POINTERUP ? POINTER_CHANGE_FIRSTBUTTON_UP : POINTER_CHANGE_NONE;
+    *last = touch->data;
+    TRACE( "touch %u msg %#x hwnd %p at %d,%d flags %#x\n", id, msg->message, msg->hwnd,
+           (int)msg->pt.x, (int)msg->pt.y, flags );
+}
+
+/* the touches of the frame of touch ID's last message: those down, and it */
+BOOL sg_touch_frame( UINT32 id, struct sg_touch_frame *frame )
+{
+    struct sg_touch_state *state = get_touch_state( FALSE );
+    struct sg_touch *touch = find_touch( state, id );
+    UINT i;
+
+    if (!touch || !frame) return FALSE;
+    frame->count = 0;
+    frame->touches[frame->count++] = touch->data;
+    for (i = 0; i < SG_MAX_TRACKED && frame->count < SG_MAX_TOUCHES; i++)
+    {
+        struct sg_touch *t = &state->touches[i];
+        if (t == touch || !t->data.id || (t->lifted && t->hw_id != touch->hw_id)) continue;
+        frame->touches[frame->count] = t->data;
+        frame->touches[frame->count].frame = touch->data.frame;
+        frame->count++;
+    }
+    return TRUE;
+}
+
+/* GetPointerInfo and the like for a touch that is not the last message's */
+BOOL sg_touch_pointer_data( UINT32 id, struct sg_pointer_data *data )
+{
+    struct sg_touch *touch = find_touch( get_touch_state( FALSE ), id );
+    if (!touch) return FALSE;
+    *data = touch->data;
+    return TRUE;
+}
+
+/* whether a touch-made mouse message goes to the program: not when the
+ * window took that touch's WM_POINTERDOWN itself */
+BOOL sg_touch_mouse_wanted( ULONG_PTR extra_info )
+{
+    struct sg_touch_state *state = get_touch_state( FALSE );
+    struct sg_touch *found = NULL;
+    int i;
+
+    if (!state || !SG_IS_TOUCH_SIGNATURE( extra_info )) return TRUE;
+    for (i = 0; i < SG_MAX_TRACKED; i++)
+    {
+        struct sg_touch *t = &state->touches[i];
+        if (!t->data.id || (t->data.id & 0x7f) != (extra_info & 0x7f)) continue;
+        if (!found || t->age > found->age) found = t;
+    }
+#ifdef SG_MUTANT_TOUCH_MOUSE_ALWAYS
+    return TRUE;
+#endif
+    if (found && found->aware) TRACE( "touch %u: the window took it, no mouse\n", found->data.id );
+    return !found || !found->aware;
+}
+
+/* NtUserDispatchMessage of a touch's WM_POINTERDOWN: before and after */
+void sg_touch_dispatch( const MSG *msg, BOOL done )
+{
+    struct sg_touch *touch;
+
+    if (msg->message != WM_POINTERDOWN) return;
+    if (!(touch = find_touch( get_touch_state( FALSE ), LOWORD( msg->wParam ) ))) return;
+    if (!done)
+    {
+        touch->dispatching = TRUE;
+        touch->defproc = FALSE;
+        return;
+    }
+    if (!touch->dispatching) return;
+    touch->dispatching = FALSE;
+    touch->aware = !touch->defproc;
+    TRACE( "touch %u: %s\n", touch->data.id, touch->aware ? "the window takes touches" : "left to DefWindowProc" );
+}
+
+static POINTS screen_points( INT x, INT y )
+{
+    RECT rect = {x, y, x, y};
+    POINTS pts;
+    rect = map_rect_raw_to_virt( rect, get_thread_dpi() );
+    pts.x = rect.left;
+    pts.y = rect.top;
+    return pts;
+}
+
+static void send_gesture( struct sg_touch_state *state, UINT32 id, UINT32 flags, double x, double y,
+                          UINT64 arguments )
+{
+    POINTS pts = screen_points( lround( x ), lround( y ) );
+
+    if (id == GID_PAN || id == GID_ZOOM)
+    {
+        state->last_x = x;
+        state->last_y = y;
+        state->last_dist = (double)arguments;
+    }
+
+    state->gesture.handle = ++state->sequence | 0x10000;
+    state->gesture.id = id;
+    state->gesture.flags = flags;
+    state->gesture.hwnd = HandleToUlong( state->gesture_hwnd );
+    state->gesture.x = pts.x;
+    state->gesture.y = pts.y;
+    state->gesture.instance = state->instance;
+    state->gesture.sequence = state->sequence;
+    state->gesture.arguments = arguments;
+    TRACE( "WM_GESTURE %u flags %#x at %d,%d args %s to %p\n", id, flags, pts.x, pts.y,
+           wine_dbgstr_longlong( arguments ), state->gesture_hwnd );
+    send_message( state->gesture_hwnd, WM_GESTURE, id, (LPARAM)state->gesture.handle );
+}
+
+static void two_fingers( struct sg_touch_state *state, double *cx, double *cy, double *dist )
+{
+    const struct sg_pointer_data *a = NULL, *b = NULL;
+    int i;
+
+    for (i = 0; i < SG_MAX_TRACKED; i++)
+    {
+        const struct sg_touch *t = &state->touches[i];
+        if (!t->data.id || t->lifted) continue;
+        if (!a) a = &t->data;
+        else if (!b) b = &t->data;
+    }
+    if (!a || !b) return;
+    *cx = (a->x + b->x) / 2.0;
+    *cy = (a->y + b->y) / 2.0;
+    *dist = sqrt( (double)(a->x - b->x) * (a->x - b->x) + (double)(a->y - b->y) * (a->y - b->y) );
+}
+
+static void end_gesture( struct sg_touch_state *state, BOOL done )
+{
+    if (state->mode == GESTURE_PAN || state->mode == GESTURE_ZOOM)
+    {
+        /* where the gesture last was: a finger has lifted */
+        double cx = state->last_x, cy = state->last_y, dist = state->last_dist;
+#ifdef SG_MUTANT_GESTURE_END_WHEEL
+        dist = 0;
+#endif
+        send_gesture( state, state->mode == GESTURE_PAN ? GID_PAN : GID_ZOOM, GF_END, cx, cy, lround( dist ) );
+        send_gesture( state, GID_END, 0, cx, cy, 0 );
+    }
+    state->mode = done ? GESTURE_DONE : GESTURE_NONE;
+}
+
+static HWND touch_window_of( HWND hwnd )
+{
+    static const WCHAR touchW[] = {'_','_','w','i','n','e','_','s','g','_','t','o','u','c','h',0};
+    for (; hwnd; hwnd = (get_window_long( hwnd, GWL_STYLE ) & WS_CHILD) ? get_parent( hwnd ) : 0)
+        if (NtUserGetProp( hwnd, touchW )) return hwnd;
+    return 0;
+}
+
+/* WM_TOUCH: every touch down, the changed one with its change */
+static void post_touch_input( struct sg_touch_state *state, HWND hwnd, const struct sg_touch *changed, UINT msg )
+{
+    struct sg_touch_input *input;
+    UINT i;
+
+    state->input_handle = (state->input_handle + 1) & 0xffff;
+    input = &state->inputs[state->input_handle % ARRAY_SIZE(state->inputs)];
+    memset( input, 0, sizeof(*input) );
+    input->handle = state->input_handle | 0x20000;
+    for (i = 0; i < SG_MAX_TRACKED && input->count < SG_MAX_TOUCHES; i++)
+    {
+        const struct sg_touch *t = &state->touches[i];
+        UINT32 flags;
+
+        if (!t->data.id || (t->lifted && t != changed)) continue;
+        if (t != changed) flags = TOUCHEVENTF_MOVE;
+        else if (msg == WM_POINTERDOWN) flags = TOUCHEVENTF_DOWN;
+        else if (msg == WM_POINTERUP) flags = TOUCHEVENTF_UP;
+        else flags = TOUCHEVENTF_MOVE;
+        if (t->data.flags & POINTER_FLAG_PRIMARY) flags |= TOUCHEVENTF_PRIMARY;
+        if (!t->lifted) flags |= TOUCHEVENTF_INRANGE;
+        input->inputs[input->count].x = t->data.x * 100;
+        input->inputs[input->count].y = t->data.y * 100;
+        input->inputs[input->count].id = t->data.id;
+        input->inputs[input->count].flags = flags;
+        input->inputs[input->count].time = t->data.time;
+        input->inputs[input->count].device = t->data.device;
+        input->count++;
+    }
+    TRACE( "WM_TOUCH %u inputs to %p\n", input->count, hwnd );
+    NtUserPostMessage( hwnd, WM_TOUCH, input->count, (LPARAM)input->handle );
+}
+
+/* DefWindowProc of a WM_POINTERDOWN, UPDATE or UP */
+void sg_touch_defwindowproc( HWND hwnd, UINT msg, WPARAM wparam )
+{
+    struct sg_touch_state *state = get_touch_state( FALSE );
+    struct sg_touch *touch = find_touch( state, GET_POINTERID_WPARAM( wparam ) );
+    double cx = 0, cy = 0, dist = 0, moved, spread, step;
+    HWND target;
+    UINT count;
+
+    if (!touch || touch->data.type != PT_TOUCH) return;
+    if (touch->dispatching) touch->defproc = TRUE;
+    /* once per message (a window may hand it on to another's DefWindowProc) */
+    if (touch->defproc_frame == touch->data.frame && touch->data.frame) return;
+    touch->defproc_frame = touch->data.frame;
+
+    if ((target = touch_window_of( hwnd )))
+    {
+        post_touch_input( state, target, touch, msg );
+        return;
+    }
+
+#ifdef SG_MUTANT_NO_GESTURE
+    return;
+#endif
+    count = count_touches_down( state );
+    TRACE( "touch %u msg %#x: %u down, gesture %d\n", touch->data.id, msg, count, state->mode );
+    if (count > 2)
+    {
+        if (state->mode != GESTURE_DONE) end_gesture( state, TRUE );
+        return;
+    }
+    if (count < 2)
+    {
+        if (state->mode != GESTURE_NONE && state->mode != GESTURE_DONE) end_gesture( state, FALSE );
+        if (!count) state->mode = GESTURE_NONE;
+        return;
+    }
+    two_fingers( state, &cx, &cy, &dist );
+    if (msg == WM_POINTERDOWN)
+    {
+        HWND capture;
+
+        /* the second finger: a gesture, not a click; a button already held
+         * down by the first finger lets go without clicking */
+        if (state->mode == GESTURE_DONE) return;
+        state->mode = GESTURE_NONE;
+        state->sx = cx;
+        state->sy = cy;
+        state->sdist = dist;
+        if ((NtUserGetKeyState( VK_LBUTTON ) & 0x8000) && (capture = get_capture()))
+            send_message( capture, WM_CANCELMODE, 0, 0 );
+        return;
+    }
+    if (state->mode == GESTURE_DONE || msg != WM_POINTERUPDATE) return;
+    step = 48.0 * get_system_dpi() / 96;
+    if (state->mode == GESTURE_NONE)
+    {
+        moved = sqrt( (cx - state->sx) * (cx - state->sx) + (cy - state->sy) * (cy - state->sy) );
+        spread = fabs( dist - state->sdist );
+        if (moved < step / 3 && spread < step / 2) return;
+        state->mode = spread > moved ? GESTURE_ZOOM : GESTURE_PAN;
+        state->gesture_hwnd = hwnd;
+        state->instance++;
+        /* begun where the second finger came down; then where they are */
+        send_gesture( state, GID_BEGIN, GF_BEGIN, state->sx, state->sy, 0 );
+        send_gesture( state, state->mode == GESTURE_PAN ? GID_PAN : GID_ZOOM, GF_BEGIN, state->sx, state->sy,
+                      lround( state->sdist ) );
+    }
+    send_gesture( state, state->mode == GESTURE_PAN ? GID_PAN : GID_ZOOM, 0, cx, cy, lround( dist ) );
+}
+
+static void send_wheel( DWORD flags, int delta, BOOL ctrl )
+{
+    INPUT input = {.type = INPUT_MOUSE}, key = {.type = INPUT_KEYBOARD};
+
+    key.ki.wVk = VK_CONTROL;
+    key.ki.wScan = 0x1d;
+    if (ctrl)
+    {
+        int i;
+        send_hardware_message( 0, 0, &key, 0 );
+#ifndef SG_MUTANT_NO_CTRL_WAIT
+        /* a keyboard hook (the shell's) holds the key until it has seen it:
+         * the wheel waits for Ctrl to be down, or it is no zoom */
+        for (i = 0; i < 50 && !(NtUserGetAsyncKeyState( VK_CONTROL ) & 0x8000); i++)
+        {
+            LARGE_INTEGER delay = {.QuadPart = -20000};  /* 2 ms */
+            NtDelayExecution( FALSE, &delay );
+        }
+#endif
+    }
+    input.mi.dwFlags = flags;
+    input.mi.mouseData = delta;
+    input.mi.time = NtGetTickCount();
+    send_hardware_message( 0, 0, &input, 0 );
+    if (ctrl)
+    {
+        key.ki.dwFlags = KEYEVENTF_KEYUP;
