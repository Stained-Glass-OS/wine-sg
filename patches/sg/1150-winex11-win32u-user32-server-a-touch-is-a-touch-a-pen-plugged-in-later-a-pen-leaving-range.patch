+/* DefWindowProc of WM_GESTURE: a pan is the mouse wheel (the page follows
+ * the fingers: down shows what is above, one notch for every three lines'
+ * height at the display's scale; sideways the horizontal wheel), a zoom
+ * Ctrl+wheel, a step for every quarter more or less spread */
+void sg_gesture_defwindowproc( HWND hwnd, WPARAM wparam, LPARAM lparam )
+{
+    struct sg_touch_state *state = get_touch_state( FALSE );
+    const struct sg_gesture *g;
+    double step = 48.0 * get_system_dpi() / 96, x, y, dist;
+
+    int n = 0;  /* at most a page of notches for one message */
+
+    if (!state || (UINT32)lparam != state->gesture.handle) return;
+    g = &state->gesture;
+    x = g->x;
+    y = g->y;
+    dist = (double)(UINT32)g->arguments;
+    if (g->flags & GF_BEGIN)
+    {
+        state->wheel_x = x;
+        state->wheel_y = y;
+        state->wheel_dist = dist;
+        return;
+    }
+#ifndef SG_MUTANT_GESTURE_END_WHEEL
+    if (g->flags & GF_END) return;
+#endif
+    if (g->id == GID_PAN)
+    {
+        while (y - state->wheel_y >= step && n++ < 20) { send_wheel( MOUSEEVENTF_WHEEL, WHEEL_DELTA, FALSE ); state->wheel_y += step; }
+        while (state->wheel_y - y >= step && n++ < 20) { send_wheel( MOUSEEVENTF_WHEEL, -WHEEL_DELTA, FALSE ); state->wheel_y -= step; }
+        while (x - state->wheel_x >= step && n++ < 20) { send_wheel( MOUSEEVENTF_HWHEEL, -WHEEL_DELTA, FALSE ); state->wheel_x += step; }
+        while (state->wheel_x - x >= step && n++ < 20) { send_wheel( MOUSEEVENTF_HWHEEL, WHEEL_DELTA, FALSE ); state->wheel_x -= step; }
+    }
+#ifndef SG_MUTANT_GESTURE_END_WHEEL
+    else if (g->id == GID_ZOOM && state->wheel_dist > 1 && dist > 1)
+#else
+    else if (g->id == GID_ZOOM && state->wheel_dist > 0)
+#endif
+    {
+        while (dist >= state->wheel_dist * 1.25 && n++ < 20) { send_wheel( MOUSEEVENTF_WHEEL, WHEEL_DELTA, TRUE ); state->wheel_dist *= 1.25; }
+        while (dist <= state->wheel_dist / 1.25 && n++ < 20) { send_wheel( MOUSEEVENTF_WHEEL, -WHEEL_DELTA, TRUE ); state->wheel_dist /= 1.25; }
+    }
+}
+
+BOOL sg_get_gesture( UINT32 handle, struct sg_gesture *gesture )
+{
+    struct sg_touch_state *state = get_touch_state( FALSE );
+    if (!state || !gesture || handle != state->gesture.handle) return FALSE;
+    *gesture = state->gesture;
+    return TRUE;
+}
+
+BOOL sg_get_touch_input( UINT32 handle, struct sg_touch_input *input )
+{
+    struct sg_touch_state *state = get_touch_state( FALSE );
+    const struct sg_touch_input *found;
+
+    if (!state || !input) return FALSE;
+    found = &state->inputs[(handle & 0xffff) % ARRAY_SIZE(state->inputs)];
+    if (found->handle != handle) return FALSE;
+    *input = *found;
+    return TRUE;
+}
