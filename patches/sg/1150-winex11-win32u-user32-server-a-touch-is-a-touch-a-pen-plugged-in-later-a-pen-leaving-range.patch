+/* Stained Glass OS (wine-sg 1150): a touch screen's touches reach programs as
+ * touches -- WM_POINTER* of PT_TOUCH, a frame of every touch down, WM_TOUCH
+ * for a window registered for it, WM_GESTURE for the others -- and as the
+ * mouse (the server promotes the first touch) for a window that leaves the
+ * pointer messages to DefWindowProc */
+#define SG_MAX_TOUCHES 10
+/* a touch's state in the high half of its WM_POINTER* lparam from the
+ * display driver: the X input device it came from */
+#define SG_TOUCH_MARK         0x40000000u
+#define SG_TOUCH_XI_DEVICE(v) ((UINT32)(v) & 0xff)
+#define SG_TOUCH_DEVICE_HANDLE(xi_device) (0x5f00 | ((xi_device) & 0xff))
+/* the mouse messages promoted from a touch (GetMessageExtraInfo), as
+ * Windows marks them: the low 7 bits are the touch's pointer id */
+#define SG_TOUCH_SIGNATURE      0xff515780u
+#define SG_IS_TOUCH_SIGNATURE(v) (((UINT32)(v) & 0xffffff80u) == SG_TOUCH_SIGNATURE)
+
+/* the touches down when a touch's message was retrieved (GetPointerFrame-
+ * TouchInfo): fixed size, the same for 32- and 64-bit callers */
+struct sg_touch_frame
+{
+    UINT32 count;
+    struct sg_pointer_data touches[SG_MAX_TOUCHES];
+};
+
+/* a WM_GESTURE's GESTUREINFO, fixed size */
+struct sg_gesture
+{
+    UINT32 handle;
+    UINT32 id;            /* GID_* */
+    UINT32 flags;         /* GF_* */
+    UINT32 hwnd;
+    INT32  x, y;          /* screen pixels */
+    UINT32 instance, sequence;
+    UINT64 arguments;
+};
+
+/* a WM_TOUCH's TOUCHINPUTs, fixed size */
+struct sg_touch_input
+{
+    UINT32 handle;
+    UINT32 count;
+    struct
+    {
+        INT32  x, y;      /* screen pixels */
+        UINT32 id, flags, time, device;
+    } inputs[SG_MAX_TOUCHES];
+};
+
+static inline BOOL NtUserSgGetTouchFrame( UINT32 id, struct sg_touch_frame *frame )
+{
+    return NtUserCallTwoParam( id, (UINT_PTR)frame, NtUserCallTwoParam_SgGetTouchFrame );
+}
+
+static inline BOOL NtUserSgGetGesture( UINT32 handle, struct sg_gesture *gesture )
+{
+    return NtUserCallTwoParam( handle, (UINT_PTR)gesture, NtUserCallTwoParam_SgGetGesture );
+}
+
+static inline BOOL NtUserSgGetTouchInput( UINT32 handle, struct sg_touch_input *input )
+{
+    return NtUserCallTwoParam( handle, (UINT_PTR)input, NtUserCallTwoParam_SgGetTouchInput );
+}
+
