+/* Stained Glass OS (wine-sg 1150): a touch's frame -- every touch down --
+ * as POINTER_INFO or POINTER_TOUCH_INFO; COUNT is how many fit, set to how
+ * many there are */
+static void fill_touch_info( const struct sg_pointer_data *data, POINTER_TOUCH_INFO *info )
+{
+    fill_pointer_info( data, &info->pointerInfo );
+    info->touchFlags = TOUCH_FLAG_NONE;
+    info->touchMask = TOUCH_MASK_CONTACTAREA;
+    info->rcContact.left = data->x - 2;
+    info->rcContact.top = data->y - 2;
+    info->rcContact.right = data->x + 2;
+    info->rcContact.bottom = data->y + 2;
+    info->rcContactRaw = info->rcContact;
+    info->orientation = 0;
+    info->pressure = 0;
+}
+
+static BOOL get_touch_frame( UINT32 id, UINT32 *count, POINTER_INFO *pointers, POINTER_TOUCH_INFO *touches )
+{
+    struct sg_touch_frame frame;
+    UINT32 i;
+
+    if (!count || !NtUserSgGetTouchFrame( id, &frame ))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if ((pointers || touches) && *count < frame.count)
+    {
+        *count = frame.count;
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+    for (i = 0; i < frame.count; i++)
+    {
+        if (pointers) fill_pointer_info( &frame.touches[i], &pointers[i] );
+        if (touches) fill_touch_info( &frame.touches[i], &touches[i] );
+    }
+    *count = frame.count;
+    return TRUE;
+}
+
 static BOOL get_pointer_info_list( UINT32 id, UINT32 *entries, UINT32 *pointers, POINTER_INFO *info )
 {
     struct sg_pointer_data data;
 
     if (!entries || !get_pointer_data( id, &data )) return FALSE;
+    /* a touch's frame: one entry of every touch down */
+    if (data.type == PT_TOUCH && pointers)
+    {
+        if (info && !*entries)
+        {
+            *entries = 1;
+            SetLastError(ERROR_INSUFFICIENT_BUFFER);
+            return FALSE;
+        }
+        *entries = 1;
+        return get_touch_frame( id, pointers, info, NULL );
+    }
     if (info && *entries) fill_pointer_info( &data, info );
     *entries = 1;
     if (pointers) *pointers = 1;
@@ -741,7 +802,11 @@
