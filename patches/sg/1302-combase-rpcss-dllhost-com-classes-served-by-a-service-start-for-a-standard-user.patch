From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase, rpcss, dllhost: a class served by a service starts for a standard user, and no needless 30-second surrogate wait

Microsoft Edge on David's Latitude (2026-10-06) took about 30 seconds to
load pages. Edge's App-Bound cookie encryption activates the class of its
elevation service ({1fcbe96c-...}, AppID LocalService =
MicrosoftEdgeElevationService). Wine's COM started that service from the
caller's own process, and a standard user may not start services (the
SCM's default descriptor gives users no SERVICE_START), so the start
failed. Wine then ran a dllhost surrogate for the class although its AppID
asks for none; dllhost could not load a class with no in-process server,
exited with 0 -- which the caller takes for a launcher that left the work
to its child -- and the caller waited 30 seconds before giving up, on every
attempt ("class {1fcbe96c-...} not registered", syswow64\dllhost.exe in the
debug report).

On Windows the DCOM launcher, not the caller, starts the service of a
LocalService class, a class runs in a surrogate only when its AppID has a
DllSurrogate value, and a surrogate that cannot load its class fails at
once. Now:
- combase: when the caller may not start the service itself
  (ERROR_ACCESS_DENIED), rpcss -- which runs as SYSTEM -- starts it
  (irpcss_start_local_service). rpcss looks the service up itself, from the
  machine's classes (CLSID -> AppID -> LocalService, ServiceParameters),
  never from the caller.
- combase: no surrogate is started for a class whose AppID has no
  DllSurrogate value (REGDB_E_CLASSNOTREG at once).
- dllhost: a server it cannot load ends it with that error, not 0, so the
  caller stops waiting.

Test: test/comsvc-gate.sh with test/comsvc-probe.c, a standard user
(sgconf) in a shared system prefix (mutants SG_MUTANT_RPCSS_LOCAL_SERVICE,
SG_MUTANT_SURROGATE_WITHOUT_VALUE, SG_MUTANT_DLLHOST_EXIT_ZERO).
---
--- a/include/wine/irpcss.idl
+++ b/include/wine/irpcss.idl
@@ -47,4 +47,10 @@
     HRESULT irpcss_get_thread_seq_id(
         [in] handle_t handle,
         [out] DWORD *sequence_id);
+
+    /* Stained Glass OS: start the service a class is served by (its AppID's
+     * LocalService), for a caller not allowed to start it itself */
+    HRESULT irpcss_start_local_service(
+        [in] handle_t handle,
+        [in] const GUID *clsid);
 }
--- a/programs/rpcss/rpcss_main.c
+++ b/programs/rpcss/rpcss_main.c
@@ -144,6 +144,79 @@
     return S_OK;
 }
 
+/* Stained Glass OS: COM activation of a class served by a service (the
+ * AppID's LocalService value). On Windows the DCOM launcher, not the caller,
+ * starts that service, so a standard user's program activates it although
+ * the user may not start services (Edge's elevation service: the browser
+ * waited 30 seconds for a dllhost that could never serve it, on every
+ * attempt). rpcss runs as SYSTEM; the service is looked up here, in the
+ * machine's classes, never taken from the caller. */
+static BOOL machine_class_value(const WCHAR *key, const WCHAR *name, WCHAR *buf, DWORD size)
+{
+    static const REGSAM views[] = { KEY_WOW64_64KEY, KEY_WOW64_32KEY };
+    unsigned int i;
+    HKEY hkey;
+
+    for (i = 0; i < ARRAY_SIZE(views); i++)
+    {
+        DWORD type, len = size - sizeof(WCHAR);
+        LONG r;
+
+        if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, key, 0, KEY_READ | views[i], &hkey)) continue;
+        memset(buf, 0, size);
+        r = RegQueryValueExW(hkey, name, NULL, &type, (BYTE *)buf, &len);
+        RegCloseKey(hkey);
+        if (!r && (type == REG_SZ || type == REG_EXPAND_SZ) && buf[0]) return TRUE;
+    }
+    return FALSE;
+}
+
+HRESULT __cdecl irpcss_start_local_service(handle_t h, const GUID *clsid)
+{
+    WCHAR key[100], appid[40], service[257], params[1024], *args[64], *p;
+    DWORD nargs = 0, err;
+    SC_HANDLE scm, svc;
+
+    swprintf(key, ARRAY_SIZE(key), L"Software\\Classes\\CLSID\\{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}",
+             clsid->Data1, clsid->Data2, clsid->Data3, clsid->Data4[0], clsid->Data4[1], clsid->Data4[2],
+             clsid->Data4[3], clsid->Data4[4], clsid->Data4[5], clsid->Data4[6], clsid->Data4[7]);
+    if (!machine_class_value(key, L"AppID", appid, sizeof(appid))) return REGDB_E_CLASSNOTREG;
+    swprintf(key, ARRAY_SIZE(key), L"Software\\Classes\\AppID\\%s", appid);
+    if (!machine_class_value(key, L"LocalService", service, sizeof(service))) return REGDB_E_CLASSNOTREG;
+    if (machine_class_value(key, L"ServiceParameters", params, sizeof(params)))
+    {
+        for (p = params; *p && nargs < ARRAY_SIZE(args);)
+        {
+            while (*p == ' ' || *p == '\t') *p++ = 0;
+            if (!*p) break;
+            if (*p == '"')
+            {
+                args[nargs++] = ++p;
+                while (*p && *p != '"') p++;
+                if (*p) *p++ = 0;
+            }
+            else
+            {
+                args[nargs++] = p;
+                while (*p && *p != ' ' && *p != '\t') p++;
+            }
+        }
+    }
+
+    TRACE("%s: starting service %s for %s\n", debugstr_w(appid), debugstr_w(service), debugstr_guid(clsid));
+    if (!(scm = OpenSCManagerW(NULL, NULL, SC_MANAGER_CONNECT))) return HRESULT_FROM_WIN32(GetLastError());
+    if ((svc = OpenServiceW(scm, service, SERVICE_START)))
+    {
+        err = StartServiceW(svc, nargs, (const WCHAR **)args) ? ERROR_SUCCESS : GetLastError();
+        if (err == ERROR_SERVICE_ALREADY_RUNNING) err = ERROR_SUCCESS;
+        CloseServiceHandle(svc);
+    }
+    else err = GetLastError();
+    CloseServiceHandle(scm);
+    if (err) WARN("service %s for %s: error %lu\n", debugstr_w(service), debugstr_guid(clsid), err);
+    return HRESULT_FROM_WIN32(err);
+}
+
 static RPC_STATUS RPCSS_Initialize(void)
 {
     static unsigned short irot_protseq[] = IROT_PROTSEQ;
--- a/dlls/combase/rpc.c
+++ b/dlls/combase/rpc.c
@@ -382,6 +382,13 @@
     RPCSS_CALL_END
 }
 
+static HRESULT rpcss_start_local_service(REFCLSID rclsid)
+{
+    RPCSS_CALL_START
+    hr = irpcss_start_local_service(get_irpcss_handle(), rclsid);
+    RPCSS_CALL_END
+}
+
 static DWORD start_local_service(const WCHAR *name, DWORD num, LPCWSTR *params)
 {
     SC_HANDLE handle, hsvc;
@@ -471,6 +478,17 @@
             }
         }
         r = start_local_service(buf, num_args, (LPCWSTR *)args);
+#ifndef SG_MUTANT_RPCSS_LOCAL_SERVICE
+        /* A caller who may not start the service (a standard user, the
+         * service's default descriptor) has it started as Windows' DCOM
+         * launcher does, by rpcss, which runs as SYSTEM. */
+        if (r == ERROR_ACCESS_DENIED)
+        {
+            HRESULT hr2 = rpcss_start_local_service(rclsid);
+            TRACE("service %s started by rpcss: %#lx\n", debugstr_w(buf), hr2);
+            if (SUCCEEDED(hr2)) r = ERROR_SUCCESS;
+        }
+#endif
         if (r != ERROR_SUCCESS)
             hr = REGDB_E_CLASSNOTREG; /* FIXME: check retval */
         free(args);
@@ -610,6 +628,17 @@
     size = (MAX_PATH + 1) * sizeof(WCHAR);
     ret = RegQueryValueExW(key, L"DllSurrogate", NULL, NULL, (LPBYTE)command, &size);
     RegCloseKey(key);
+#ifndef SG_MUTANT_SURROGATE_WITHOUT_VALUE
+    /* Only a class whose AppID has a DllSurrogate value (an empty one: the
+     * system's dllhost) runs in a surrogate. Started for any class, dllhost
+     * could not load one with no in-process server -- Edge's service-only
+     * elevator -- and the caller waited 30 seconds for it every time. */
+    if (ret)
+    {
+        TRACE("No DllSurrogate value: not a surrogate class\n");
+        return REGDB_E_CLASSNOTREG;
+    }
+#endif
     if (ret || !size || !command[0])
     {
         TRACE("No value for DllSurrogate key\n");
--- a/programs/dllhost/dllhost.c
+++ b/programs/dllhost/dllhost.c
@@ -360,5 +360,12 @@
 cleanup:
     CoUninitialize();
 
+#ifndef SG_MUTANT_DLLHOST_EXIT_ZERO
+    /* Stained Glass OS: a server this surrogate could not load is a failed
+     * start: the caller stops waiting for a class that will never be
+     * registered (an exit code of 0 is a launcher that left the work to its
+     * child, and the caller waited 30 seconds for it) */
+    if (FAILED(hr)) return hr;
+#endif
     return 0;
 }
