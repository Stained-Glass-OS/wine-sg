         DWORD dwOptions)
 {
     FileProtocol *This = impl_from_IInternetProtocolEx(iface);
-    FIXME("(%p)->(%08lx %08lx)\n", This, hrReason, dwOptions);
+    TRACE("(%p)->(%08lx %08lx)\n", This, hrReason, dwOptions);
+    /* The file is opened and reported inside Start, there is nothing left to abort
+     * (the network protocols also return S_OK when nothing is in progress). */
