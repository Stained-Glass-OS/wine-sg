+/* IInternetProtocol::Seek for the protocols that read from the network. The
+ * data is not kept, so only moves forward are possible: they are done by reading
+ * and discarding the data in between. */
+HRESULT protocol_seek(Protocol *protocol, LARGE_INTEGER move, DWORD origin, ULARGE_INTEGER *new_pos)
+{
+    LONGLONG target;
+    BYTE buf[2048];
+
+    switch(origin) {
+    case FILE_BEGIN:
+        target = move.QuadPart;
+        break;
+    case FILE_CURRENT:
+        target = (LONGLONG)protocol->current_position + move.QuadPart;
+        break;
+    case FILE_END:
+        /* "This method fails if the content length is unknown." */
+        if(!protocol->content_length)
+            return E_FAIL;
+        target = (LONGLONG)protocol->content_length + move.QuadPart;
+        break;
+    default:
+        WARN("Invalid origin %lx\n", origin);
+        return E_FAIL;
+    }
+
+    if(target < 0 || target < (LONGLONG)protocol->current_position)
+        return E_FAIL;
+
+#ifdef SG_MUTANT_URLMON_SEEK
+    return E_NOTIMPL;
+#endif
+    while((LONGLONG)protocol->current_position < target) {
+        ULONG want = min(sizeof(buf), target - protocol->current_position), got = 0;
+        HRESULT hres = protocol_read(protocol, buf, want, &got);
+
+        if(FAILED(hres))
+            return hres;
+        if(!got)
+            return E_FAIL;  /* the data ends before the requested position */
+    }
+
+    if(new_pos)
+        new_pos->QuadPart = protocol->current_position;
+    return S_OK;
+}
