         hres = This->stgmed_obj->vtbl->fill_stgmed(This->stgmed_obj, &stgmed);
         if(FAILED(hres)) {
             stop_binding(This, hres, NULL);
@@ -1580,6 +1675,9 @@ static HRESULT Binding_Create(IMoniker *mon, Binding *binding_ctx, IUri *uri, IB
     }else if(IsEqualGUID(&IID_IUnknown, riid)) {
         ret->bindf |= BINDF_NEEDFILE;
         ret->stgmed_obj = create_stgmed_file(ret->stgmed_buf);
+    }else if(IsEqualGUID(&IID_IStorage, riid)) {
+        ret->bindf |= BINDF_NEEDFILE;
+        ret->stgmed_obj = create_stgmed_storage(ret->stgmed_buf);
     }else {
         FIXME("Unsupported riid %s\n", debugstr_guid(riid));
         IBinding_Release(&ret->IBinding_iface);
diff --git a/dlls/urlmon/bindprot.c b/dlls/urlmon/bindprot.c
index c4c14a1..97ee9b2 100644
--- a/dlls/urlmon/bindprot.c
+++ b/dlls/urlmon/bindprot.c
@@ -439,8 +439,10 @@ static HRESULT WINAPI BindProtocol_Seek(IInternetProtocolEx *iface, LARGE_INTEGE
         DWORD dwOrigin, ULARGE_INTEGER *plibNewPosition)
 {
     BindProtocol *This = impl_from_IInternetProtocolEx(iface);
-    FIXME("(%p)->(%ld %ld %p)\n", This, dlibMove.u.LowPart, dwOrigin, plibNewPosition);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%I64d %ld %p)\n", This, dlibMove.QuadPart, dwOrigin, plibNewPosition);
+
+    return IInternetProtocol_Seek(This->protocol_handler, dlibMove, dwOrigin, plibNewPosition);
 }
 
 static HRESULT WINAPI BindProtocol_LockRequest(IInternetProtocolEx *iface, DWORD dwOptions)
@@ -800,8 +802,39 @@ static HRESULT WINAPI ProtocolHandler_Seek(IInternetProtocol *iface, LARGE_INTEG
         DWORD dwOrigin, ULARGE_INTEGER *plibNewPosition)
 {
     BindProtocol *This = impl_from_IInternetProtocol(iface);
-    FIXME("(%p)->(%ld %ld %p)\n", This, dlibMove.u.LowPart, dwOrigin, plibNewPosition);
+    IInternetProtocol *protocol;
+    HRESULT hres;
+
+    TRACE("(%p)->(%I64d %ld %p)\n", This, dlibMove.QuadPart, dwOrigin, plibNewPosition);
+
+#ifdef SG_MUTANT_URLMON_BPSEEK
     return E_NOTIMPL;
+#endif
+    if(!This->protocol && This->protocol_unk) {
+        hres = IUnknown_QueryInterface(This->protocol_unk, &IID_IInternetProtocol, (void**)&protocol);
+        if(FAILED(hres))
+            return E_FAIL;
+    }else if(This->protocol) {
+        protocol = This->protocol;
+    }else {
+        return E_FAIL;
+    }
+
+    /* The bytes already read from the protocol but not yet handed out are
+     * behind the position the client sees: take them into account and drop them. */
+    if(This->buf_size) {
+        if(dwOrigin == FILE_CURRENT)
+            dlibMove.QuadPart -= This->buf_size;
+        free(This->buf);
+        This->buf = NULL;
+        This->buf_size = 0;
+    }
+
+    hres = IInternetProtocol_Seek(protocol, dlibMove, dwOrigin, plibNewPosition);
+
+    if(!This->protocol)
+        IInternetProtocol_Release(protocol);
+    return hres;
 }
 
 static HRESULT WINAPI ProtocolHandler_LockRequest(IInternetProtocol *iface, DWORD dwOptions)
@@ -915,7 +948,12 @@ static HRESULT WINAPI ProtocolSinkHandler_ReportProgress(IInternetProtocolSink *
         break;
 
     default:
-        FIXME("unsupported ulStatusCode %lu\n", status_code);
+        /* The other statuses (encoding, cookies, content disposition...) are for the client. */
+        TRACE("passing on status code %lu\n", status_code);
+#ifdef SG_MUTANT_URLMON_STATUS
+        break;
+#endif
+        IInternetProtocolSink_ReportProgress(This->protocol_sink, status_code, status_text);
     }
 
     return S_OK;
