     return E_NOTIMPL;
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI FileProtocol_Terminate(IInternetProtocolEx *iface, DWORD dwOptions)
@@ -226,8 +231,26 @@ static HRESULT WINAPI FileProtocol_Seek(IInternetProtocolEx *iface, LARGE_INTEGE
         DWORD dwOrigin, ULARGE_INTEGER *plibNewPosition)
 {
     FileProtocol *This = impl_from_IInternetProtocolEx(iface);
-    FIXME("(%p)->(%ld %ld %p)\n", This, dlibMove.u.LowPart, dwOrigin, plibNewPosition);
+    LARGE_INTEGER new_pos;
+
+    TRACE("(%p)->(%I64d %ld %p)\n", This, dlibMove.QuadPart, dwOrigin, plibNewPosition);
+
+    if(This->file == INVALID_HANDLE_VALUE)
+        return INET_E_DATA_NOT_AVAILABLE;
+
+    if(dwOrigin > FILE_END)
+        return E_FAIL;
+#ifdef SG_MUTANT_URLMON_FILESEEK
     return E_NOTIMPL;
+#endif
+    if(!SetFilePointerEx(This->file, dlibMove, &new_pos, dwOrigin)) {
+        WARN("SetFilePointerEx failed: %lu\n", GetLastError());
+        return E_FAIL;
+    }
+
+    if(plibNewPosition)
+        plibNewPosition->QuadPart = new_pos.QuadPart;
+    return S_OK;
 }
 
