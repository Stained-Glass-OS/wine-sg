 }
 
 static HRESULT WINAPI ProtocolStream_CopyTo(IStream *iface, IStream *pstm,
@@ -741,6 +747,7 @@ static stgmed_obj_t *create_stgmed_stream(stgmed_buf_t *buf)
     ProtocolStream *ret = malloc(sizeof(ProtocolStream));
 
     ret->stgmed_obj.vtbl = &stgmed_stream_vtbl;
+    ret->stgmed_obj.complete_only = FALSE;
     ret->IStream_iface.lpVtbl = &ProtocolStreamVtbl;
     ret->ref = 1;
 
@@ -794,6 +801,83 @@ static stgmed_obj_t *create_stgmed_file(stgmed_buf_t *buf)
     stgmed_file_obj_t *ret = malloc(sizeof(*ret));
 
     ret->stgmed_obj.vtbl = &stgmed_file_vtbl;
+    ret->stgmed_obj.complete_only = FALSE;
+
+    IUnknown_AddRef(&buf->IUnknown_iface);
+    ret->buf = buf;
+
+    return &ret->stgmed_obj;
+}
+
+/* IStorage binding: the downloaded file, when it is a compound file, is opened
+ * as a storage object (documented for IMoniker::BindToStorage of URL monikers). */
+static void stgmed_storage_release(stgmed_obj_t *obj)
+{
+    stgmed_file_obj_t *file_obj = (stgmed_file_obj_t*)obj;
+
+    IUnknown_Release(&file_obj->buf->IUnknown_iface);
+    free(file_obj);
+}
+
+static HRESULT open_buf_storage(stgmed_buf_t *buf, IStorage **stg)
+{
+    if(!buf->cache_file) {
+        WARN("cache_file not set\n");
+        return INET_E_DATA_NOT_AVAILABLE;
+    }
+
+    read_protocol_data(buf);
+#ifdef SG_MUTANT_URLMON_STORAGE
+    return STG_E_INVALIDFUNCTION;
+#endif
+    return StgOpenStorage(buf->cache_file, NULL, STGM_READ | STGM_SHARE_DENY_WRITE, NULL, 0, stg);
+}
+
+static HRESULT stgmed_storage_fill_stgmed(stgmed_obj_t *obj, STGMEDIUM *stgmed)
+{
+    stgmed_file_obj_t *file_obj = (stgmed_file_obj_t*)obj;
+    IStorage *stg;
+    HRESULT hres;
+
+    hres = open_buf_storage(file_obj->buf, &stg);
+    if(FAILED(hres))
+        return hres;
+
+    stgmed->tymed = TYMED_ISTORAGE;
+    stgmed->pstg = stg;
+    stgmed->pUnkForRelease = NULL;
+    return S_OK;
+}
+
+static HRESULT stgmed_storage_get_result(stgmed_obj_t *obj, DWORD bindf, void **result)
+{
+    stgmed_file_obj_t *file_obj = (stgmed_file_obj_t*)obj;
+    IStorage *stg;
+    HRESULT hres;
+
+    if(bindf & BINDF_ASYNCHRONOUS)
+        return MK_S_ASYNCHRONOUS;
+
+    hres = open_buf_storage(file_obj->buf, &stg);
+    if(FAILED(hres))
+        return hres;
+
+    *result = stg;
+    return S_OK;
+}
+
+static const stgmed_obj_vtbl stgmed_storage_vtbl = {
+    stgmed_storage_release,
+    stgmed_storage_fill_stgmed,
+    stgmed_storage_get_result
+};
+
+static stgmed_obj_t *create_stgmed_storage(stgmed_buf_t *buf)
+{
+    stgmed_file_obj_t *ret = malloc(sizeof(*ret));
+
+    ret->stgmed_obj.vtbl = &stgmed_storage_vtbl;
+    ret->stgmed_obj.complete_only = TRUE;
 
     IUnknown_AddRef(&buf->IUnknown_iface);
     ret->buf = buf;
@@ -937,28 +1021,32 @@ static HRESULT WINAPI Binding_Abort(IBinding *iface)
 static HRESULT WINAPI Binding_Suspend(IBinding *iface)
 {
     Binding *This = impl_from_IBinding(iface);
-    FIXME("(%p)\n", This);
+    TRACE("(%p)\n", This);
+    /* documented: not implemented by the default asynchronous pluggable protocols */
     return E_NOTIMPL;
 }
 
 static HRESULT WINAPI Binding_Resume(IBinding *iface)
 {
     Binding *This = impl_from_IBinding(iface);
-    FIXME("(%p)\n", This);
