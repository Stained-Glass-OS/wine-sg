diff --git a/dlls/urlmon/binding.c b/dlls/urlmon/binding.c
index 0c5bf9a..e644a86 100644
--- a/dlls/urlmon/binding.c
+++ b/dlls/urlmon/binding.c
@@ -50,6 +50,7 @@ typedef struct {
 
 struct _stgmed_obj_t {
