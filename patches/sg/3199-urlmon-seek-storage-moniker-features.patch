     return S_OK;
@@ -1168,6 +1260,9 @@ static void report_data(Binding *This, DWORD bscf, ULONG progress, ULONG progres
                 This->state |= BINDING_LOCKED;
         }
 
+        if(This->stgmed_obj->complete_only && This->download_state != END_DOWNLOAD)
+            return;
