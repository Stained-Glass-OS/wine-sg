 {
     Binding *This = impl_from_IBinding(iface);
-    FIXME("(%p)->(%p)\n", This, pnPriority);
+    TRACE("(%p)->(%p)\n", This, pnPriority);
+    /* documented: not implemented by the default asynchronous pluggable protocols */
     return E_NOTIMPL;
 }
 
@@ -1104,8 +1192,12 @@ static HRESULT WINAPI InternetProtocolSink_ReportProgress(IInternetProtocolSink
     case BINDSTATUS_ACCEPTRANGES:
         break;
     default:
-        FIXME("Unhandled status code %ld\n", ulStatusCode);
+        /* Every other BINDSTATUS value is only of interest to the client. */
+        TRACE("Forwarding status code %ld\n", ulStatusCode);
+#ifdef SG_MUTANT_URLMON_STATUS
