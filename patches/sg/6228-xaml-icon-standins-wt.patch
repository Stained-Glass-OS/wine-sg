+CaretLeftSolid8 EDD9 25C2
+CaretRightSolid8 EDDA 25B8
+CaretUpSolid8 EDDB 25B4
+CaretDownSolid8 EDDC 25BE
diff --git a/dlls/windows.ui.xaml/render.c b/dlls/windows.ui.xaml/render.c
index 302278b..04a8a29 100644
--- a/dlls/windows.ui.xaml/render.c
+++ b/dlls/windows.ui.xaml/render.c
@@ -452,6 +452,28 @@ static const char *debugstr_background( struct uielem *elem )
     return "";
 }
 
+/* its BorderBrush, as drawn: "" when none */
+static const char *debugstr_border( struct uielem *elem )
+{
+    static const WCHAR *owners[] = { L"Windows.UI.Xaml.Controls.Border", L"Windows.UI.Xaml.Controls.Control",
+                                     L"Windows.UI.Xaml.Controls.ContentPresenter", L"Windows.UI.Xaml.Controls.Grid" };
+    struct xaml_property *prop;
+    IInspectable *box;
+    struct xcolor c;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(owners); i++)
+    {
+        if (!(prop = xaml_property_find( owners[i], L"BorderBrush" ))) continue;
+        box = NULL;
+        if (FAILED(dobj_get_value( &elem->d, prop, &box )) || !box) continue;
+        if (!xaml_brush_color( box, &c )) { IInspectable_Release( box ); return " bd=(brush)"; }
+        IInspectable_Release( box );
+        return wine_dbg_sprintf( " bd=#%02x%02x%02x%02x", c.a, c.r, c.g, c.b );
+    }
+    return "";
+}
+
 static void dump_tree( struct uielem *elem, int depth )
 {
     struct uielem *child;
@@ -462,7 +484,8 @@ static void dump_tree( struct uielem *elem, int depth )
     TRACE_(xamltree)( "%*s%s %p at %.0f,%.0f %.0fx%.0f%s%s%s%s\n", depth * 2, "",
                       debugstr_hstring( name ), elem, elem->offset.x, elem->offset.y, elem->render.width,
                       elem->render.height, elem->visibility == XCOLLAPSED ? " collapsed" : "",
-                      elem->arrange_valid ? "" : " unarranged", debugstr_background( elem ),
+                      elem->arrange_valid ? "" : " unarranged",
+                      wine_dbg_sprintf( "%s%s", debugstr_background( elem ), debugstr_border( elem ) ),
                       opacity < 1 ? wine_dbg_sprintf( " opacity=%.2f", opacity ) : "" );
     WindowsDeleteString( name );
     LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry ) dump_tree( child, depth + 1 );
