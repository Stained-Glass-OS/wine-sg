From: Stained Glass OS <dev@stained-glass.example>
Subject: shell32, user32: the Run dialog and the system menu speak for our system

- The Run dialog (Win+R, RunFileDlg) said "...and Wine will open it for
  you" beside Wine's wine-glass icon, and opened without the keyboard focus:
  the shell shows it from a thread of its own, in the background, so what a
  person typed went nowhere until they clicked it (QA T7, B57). It says
  "Stained Glass will open it for you", shows shell32's own Run icon, and
  brings itself forward with the focus in its box once it is up.
- shell32: the shutdown prompt is "Do you want to shut down?" (was "...your
  Wine session?"), the Control Panel's title "Control Panel" (was "Wine
  Control Panel").
- user32: every window's system menu (Alt+Space) ended with "About Wine",
  which opened Wine's credits: gone -- Windows has no such item. The About
  box programs open with ShellAbout keeps Wine's credits and license, as
  attribution.

Gates: make test-rundialog (Win+R on the X keyboard over Notepad, then
typing with no click; stock fails 5 of 7), make lint (the trademark check
now also flags "Wine" as the speaker in shell32's, comdlg32's and user32's
dialogs).
---
--- a/dlls/shell32/dialogs.c
+++ b/dlls/shell32/dialogs.c
@@ -207,16 +207,28 @@
             if (prfdp->uFlags & RFF_CALCDIRECTORY)
                 FIXME("RFF_CALCDIRECTORY not supported\n");
 
+            /* Stained Glass OS: the shell's own Run picture, not Wine's glass */
             if (prfdp->hIcon == NULL)
-                prfdp->hIcon = LoadIconW(NULL, (LPCWSTR)IDI_WINLOGO);
+                prfdp->hIcon = LoadImageW(shell32_hInstance, MAKEINTRESOURCEW(IDI_SHELL_RUN), IMAGE_ICON, 0, 0, LR_DEFAULTSIZE);
+            if (prfdp->hIcon == NULL)
+                prfdp->hIcon = LoadIconW(NULL, (LPCWSTR)IDI_APPLICATION);
             SendMessageW(hwnd, WM_SETICON, ICON_BIG, (LPARAM)prfdp->hIcon);
             SendMessageW(hwnd, WM_SETICON, ICON_SMALL, (LPARAM)prfdp->hIcon);
             SendMessageW(GetDlgItem(hwnd, IDC_RUNDLG_ICON), STM_SETICON, (WPARAM)prfdp->hIcon, 0);
 
             FillList (GetDlgItem (hwnd, IDC_RUNDLG_EDITPATH), NULL, (prfdp->uFlags & RFF_NODEFAULT) == 0) ;
             SetFocus (GetDlgItem (hwnd, IDC_RUNDLG_EDITPATH)) ;
+            /* Stained Glass OS: the shell opens it (Win+R) from a thread of
+             * its own, in the background: bring it forward once it is up, so
+             * what is typed goes into the box without a click first */
+            PostMessageW(hwnd, WM_APP + 0x52, 0, 0);
             return TRUE ;
 
+        case WM_APP + 0x52:
+            SetForegroundWindow(hwnd);
+            SetFocus(GetDlgItem(hwnd, IDC_RUNDLG_EDITPATH));
+            return TRUE;
+
         case WM_COMMAND :
             switch (LOWORD (wParam))
                 {
