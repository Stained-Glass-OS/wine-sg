From: Stained Glass OS <ke7oxh@gmail.com>
Subject: powershell: hand the command to PowerShell 7 when it is installed

David, installing Claude Code in the OS: "irm is not recognized as a name of a
cmdlet". powershell.exe is Wine's stub; PowerShell 7 (pwsh) -- which
sg-session installs into every prefix -- has Invoke-RestMethod and the rest.
When pwsh is found (App Paths, Program Files\PowerShell\7, PATH), the stub
runs it with its own command line and returns its exit code; pwsh takes
Windows PowerShell's options. pwsh's ConsoleHost needs a console: ours is
inherited, or with none CREATE_NO_WINDOW is used, as sg-session found. Without
pwsh the stub behaves as before (0302).

Gate: make test-powershell.
--- a/programs/powershell/Makefile.in
+++ b/programs/powershell/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = powershell.exe
+IMPORTS   = advapi32
 
 EXTRADLLFLAGS = -mconsole -municode
 
--- a/programs/powershell/main.c
+++ b/programs/powershell/main.c
@@ -18,6 +18,7 @@
 
 #include <stdlib.h>
 #include <wctype.h>
+#include <windows.h>
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(powershell);
@@ -51,11 +52,73 @@
     return !*end;
 }
 
+/* Stained Glass OS: PowerShell 7 (pwsh), when it is installed -- sg-session
+ * puts it in every prefix -- runs what was asked of Windows PowerShell:
+ * "powershell -c irm https://... | iex" and installers' probes get a real
+ * shell instead of this stub. pwsh takes Windows PowerShell's options. */
+static BOOL find_pwsh(WCHAR *out, DWORD size)
+{
+    DWORD len = size * sizeof(WCHAR);
+    WCHAR *file;
+
+    if (!RegGetValueW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\pwsh.exe",
+                      NULL, RRF_RT_REG_SZ, NULL, out, &len) && GetFileAttributesW(out) != INVALID_FILE_ATTRIBUTES)
+        return TRUE;
+    if (ExpandEnvironmentStringsW(L"%ProgramFiles%\\PowerShell\\7\\pwsh.exe", out, size)
+        && GetFileAttributesW(out) != INVALID_FILE_ATTRIBUTES)
+        return TRUE;
+    return SearchPathW(NULL, L"pwsh.exe", NULL, size, out, &file) != 0;
+}
+
+/* our own command line after the program's name */
+static const WCHAR *arguments(void)
+{
+    const WCHAR *p = GetCommandLineW();
+
+    if (*p == '"') { for (p++; *p && *p != '"'; p++); if (*p) p++; }
+    else while (*p && *p != ' ' && *p != '\t') p++;
+    while (*p == ' ' || *p == '\t') p++;
+    return p;
+}
+
+static BOOL run_pwsh(int *code)
+{
+    WCHAR pwsh[MAX_PATH], *cmd;
+    const WCHAR *args = arguments();
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    DWORD mode, exit_code = 1, flags;
+    size_t len;
+
+    if (!find_pwsh(pwsh, ARRAY_SIZE(pwsh))) return FALSE;
+    len = wcslen(pwsh) + wcslen(args) + 4;
+    if (!(cmd = malloc(len * sizeof(WCHAR)))) return FALSE;
+    swprintf(cmd, len, L"\"%s\" %s", pwsh, args);
+    /* pwsh's ConsoleHost needs a console: inherit ours, or, with none (a GUI
+     * parent), CREATE_NO_WINDOW -- Windows would make it a new console and
+     * Wine does not (sg-session: "pwsh needs a console") */
+    flags = GetConsoleMode(GetStdHandle(STD_INPUT_HANDLE), &mode)
+            || GetConsoleMode(GetStdHandle(STD_OUTPUT_HANDLE), &mode) ? 0 : CREATE_NO_WINDOW;
+    if (!CreateProcessW(pwsh, cmd, NULL, NULL, TRUE, flags, NULL, NULL, &si, &pi))
+    {
+        free(cmd);
+        return FALSE;
+    }
+    free(cmd);
+    CloseHandle(pi.hThread);
+    WaitForSingleObject(pi.hProcess, INFINITE);
+    GetExitCodeProcess(pi.hProcess, &exit_code);
+    CloseHandle(pi.hProcess);
+    *code = exit_code;
+    return TRUE;
+}
+
 int __cdecl wmain(int argc, WCHAR *argv[])
 {
     BOOL script = FALSE;
     int i, code = 1;
 
+    if (run_pwsh(&code)) return code;
     WINE_FIXME("stub.\n");
