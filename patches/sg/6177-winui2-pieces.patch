+/*
+ * An IconSource describes an icon without being an element (a tab's, a menu item's icon); an
+ * IconSourceElement shows one: a FontIcon for a FontIconSource, a SymbolIcon for a SymbolIconSource,
+ * an Image for a BitmapIconSource (PathIconSource: kept, not drawn yet), in the source's Foreground.
+ * Interface identity per windows-rs 0.30.0 (MIT).
+ */
+
+#include <stdlib.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+enum source_kind { SOURCE_BASE, SOURCE_FONT, SOURCE_SYMBOL, SOURCE_BITMAP, SOURCE_PATH };
+
+struct icon_source
+{
+    struct dobj d;
+    struct xiface IIconSource_iface, IFontIconSource_iface, ISymbolIconSource_iface, IBitmapIconSource_iface,
+                  IPathIconSource_iface;
+    enum source_kind kind;
+};
+
+static struct xaml_property *prop_foreground, *prop_glyph, *prop_font_size, *prop_font_family, *prop_font_weight,
+                            *prop_font_style, *prop_scale_enabled, *prop_mirrored, *prop_symbol, *prop_uri,
+                            *prop_monochrome, *prop_data, *prop_icon_source, *prop_bitmap_uri, *prop_bitmap_monochrome;
+
+static void source_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value );
+static void bitmap_uri_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value );
+
+static BOOL WINAPI init_icons( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR is[] = L"Windows.UI.Xaml.Controls.IconSource", fis[] = L"Windows.UI.Xaml.Controls.FontIconSource",
+                       sis[] = L"Windows.UI.Xaml.Controls.SymbolIconSource", bis[] = L"Windows.UI.Xaml.Controls.BitmapIconSource",
+                       pis[] = L"Windows.UI.Xaml.Controls.PathIconSource", ise[] = L"Windows.UI.Xaml.Controls.IconSourceElement";
+    UINT16 normal = 400;
+    INT32 add = 0xe109;
+
+    prop_foreground = xaml_property_register( is, L"Foreground", L"Windows.UI.Xaml.Media.Brush", NULL, FALSE, NULL );
+    prop_glyph = xaml_property_register( fis, L"Glyph", L"String", xbox_string( L"" ), FALSE, NULL );
+    prop_font_size = xaml_property_register( fis, L"FontSize", L"Double", xbox_double( 20 ), FALSE, NULL );
+    prop_font_family = xaml_property_register( fis, L"FontFamily", L"Windows.UI.Xaml.Media.FontFamily",
+                                               xaml_font_family( L"Segoe MDL2 Assets" ), FALSE, NULL );
+    prop_font_weight = xaml_property_register( fis, L"FontWeight", L"Windows.UI.Text.FontWeight",
+            xbox_ref( &IID_IReference_FontWeight, &normal, sizeof(normal) ), FALSE, NULL );
+    prop_font_style = xaml_property_register( fis, L"FontStyle", L"Windows.UI.Text.FontStyle", xbox_int32( 0 ), FALSE, NULL );
+    prop_scale_enabled = xaml_property_register( fis, L"IsTextScaleFactorEnabled", L"Boolean", xbox_boolean( TRUE ), FALSE, NULL );
+    prop_mirrored = xaml_property_register( fis, L"MirroredWhenRightToLeft", L"Boolean", xbox_boolean( FALSE ), FALSE, NULL );
+    prop_symbol = xaml_property_register( sis, L"Symbol", L"Windows.UI.Xaml.Controls.Symbol", xbox_int32( add ), FALSE, NULL );
+    prop_uri = xaml_property_register( bis, L"UriSource", L"Windows.Foundation.Uri", NULL, FALSE, NULL );
+    prop_monochrome = xaml_property_register( bis, L"ShowAsMonochrome", L"Boolean", xbox_boolean( TRUE ), FALSE, NULL );
+    prop_data = xaml_property_register( pis, L"Data", L"Windows.UI.Xaml.Media.Geometry", NULL, FALSE, NULL );
+    prop_icon_source = xaml_property_register( ise, L"IconSource", L"Windows.UI.Xaml.Controls.IconSource", NULL, FALSE,
+                                               source_changed );
+    prop_bitmap_uri = xaml_property_register( L"Windows.UI.Xaml.Controls.BitmapIcon", L"UriSource", L"Windows.Foundation.Uri",
+                                              NULL, FALSE, bitmap_uri_changed );
+    prop_bitmap_monochrome = xaml_property_register( L"Windows.UI.Xaml.Controls.BitmapIcon", L"ShowAsMonochrome", L"Boolean",
+                                                     xbox_boolean( TRUE ), FALSE, NULL );
