+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A DispatcherTimer ticks on the thread that started it, from its message loop (a thread timer of
+ * user32): Tick is raised every Interval while it is enabled.  A running timer holds a reference to
+ * itself, as on Windows, so that a program may let go of it.  Interface identity per windows-rs
+ * 0.30.0 (MIT).
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "winuser.h"
+
+
+struct timer
+{
+    struct xobj obj;
+    struct xiface IDispatcherTimer_iface;
+    struct list entry;              /* in the running timers */
+    INT64 interval;                 /* 100 ns units */
+    UINT_PTR id;                    /* its thread timer, while running */
+    struct handler_list tick;
+};
+
+static struct list running = LIST_INIT( running );
+
+static struct timer *timer_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct timer, obj );
+}
+
+static void CALLBACK timer_proc( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
+{
+    struct timer *timer;
+    IInspectable *sender = NULL;
+
+    LIST_FOR_EACH_ENTRY( timer, &running, struct timer, entry )
+    {
+        if (timer->id != id) continue;
+#ifdef SG_MUTANT_TIMER_NO_TICK
+        return;
+#endif
+        IUnknown_QueryInterface( timer->obj.outer, &IID_IInspectable, (void **)&sender );
+        xaml_raise_routed( &timer->tick, sender, NULL );
+        if (sender) IInspectable_Release( sender );
+        return;
+    }
+}
+
+static HRESULT WINAPI timer_get_Interval( struct xiface *iface, INT64 *value )
+{
+    if (!value) return E_POINTER;
+    *value = timer_from_iface( iface )->interval;
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_put_Interval( struct xiface *iface, INT64 value )
+{
+    struct timer *timer = timer_from_iface( iface );
+
+    if (value < 0) return E_INVALIDARG;
+    timer->interval = value;
+    if (timer->id) timer->id = SetTimer( NULL, timer->id, max( 1, (UINT)(value / 10000) ), timer_proc );
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_get_IsEnabled( struct xiface *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = timer_from_iface( iface )->id != 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_add_Tick( struct xiface *iface, IUnknown *handler, INT64 *token )
+{
+    return handlers_add( &timer_from_iface( iface )->tick, handler, token );
+}
+
+static HRESULT WINAPI timer_remove_Tick( struct xiface *iface, INT64 token )
+{
+    return handlers_remove( &timer_from_iface( iface )->tick, token );
+}
+
+static HRESULT WINAPI timer_Start( struct xiface *iface )
+{
+    struct timer *timer = timer_from_iface( iface );
+    UINT ms = max( 1, (UINT)(timer->interval / 10000) );
+
+    if (timer->id)
+    {
+        timer->id = SetTimer( NULL, timer->id, ms, timer_proc );   /* restarted */
+        return S_OK;
+    }
+    if (!(timer->id = SetTimer( NULL, 0, ms, timer_proc ))) return HRESULT_FROM_WIN32( GetLastError() );
+    list_add_tail( &running, &timer->entry );
+    IUnknown_AddRef( timer->obj.outer );   /* kept while running */
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_Stop( struct xiface *iface )
+{
+    struct timer *timer = timer_from_iface( iface );
+
+    if (!timer->id) return S_OK;
+    KillTimer( NULL, timer->id );
+    timer->id = 0;
+    list_remove( &timer->entry );
+    IUnknown_Release( timer->obj.outer );
+    return S_OK;
+}
+
+static const void *timer_vtbl[] =
+{
+    IDispatcherTimer_STUBS,
+    [IDispatcherTimer_Interval] = timer_get_Interval, [IDispatcherTimer_SetInterval] = timer_put_Interval,
+    [IDispatcherTimer_IsEnabled] = timer_get_IsEnabled,
+    [IDispatcherTimer_Tick] = timer_add_Tick, [IDispatcherTimer_RemoveTick] = timer_remove_Tick,
+    [IDispatcherTimer_Start] = timer_Start, [IDispatcherTimer_Stop] = timer_Stop,
+};
+
+static void timer_destroy( struct xobj *obj )
+{
+    struct timer *timer = CONTAINING_RECORD( obj, struct timer, obj );
+    handlers_clear( &timer->tick );
+}
+
+static const struct xiface_entry timer_ifaces[] =
+{
+    { &IID_IDispatcherTimer, offsetof(struct timer, IDispatcherTimer_iface) },
+};
+
+static const struct xclass timer_class =
+{
+    L"Windows.UI.Xaml.DispatcherTimer", timer_ifaces, ARRAY_SIZE(timer_ifaces), timer_destroy,
+};
+
+static HRESULT WINAPI timer_factory_CreateInstance( struct xfiface *iface, IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct timer *timer;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(timer = calloc( 1, sizeof(*timer) ))) return E_OUTOFMEMORY;
+    timer->IDispatcherTimer_iface.vtbl = timer_vtbl;
+    handlers_init( &timer->tick );
+    xobj_init( &timer->obj, &timer_class, outer );
+    if (outer)
+    {
+        *inner = &timer->obj.IInspectable_inner;
+        IUnknown_AddRef( timer->obj.outer );
+    }
+    *value = &timer->IDispatcherTimer_iface;
+    return S_OK;
+}
+
+static HRESULT activate_timer( IInspectable **out )
+{
+    IInspectable *inner;
+    return timer_factory_CreateInstance( NULL, NULL, &inner, (void **)out );
+}
+
+static const void *timer_factory_vtbl[] = { IDispatcherTimerFactory_FSTUBS, [IDispatcherTimerFactory_new] = timer_factory_CreateInstance };
+
+static struct xfactory timer_factory_obj =
+{
+    { &xfactory_vtbl }, L"Windows.UI.Xaml.DispatcherTimer", { &IID_IDispatcherTimerFactory }, { { timer_factory_vtbl } },
+    activate_timer,
+};
+
+IActivationFactory *dispatcher_timer_factory = &timer_factory_obj.IActivationFactory_iface;
