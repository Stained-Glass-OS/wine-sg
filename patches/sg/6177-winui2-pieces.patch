+
+/*
+ * Static classes that make and test the XAML value structs for languages without constructors for
+ * them (C++/WinRT uses them for GridLength, CornerRadius, Thickness, ...). An empty Rect is
+ * (+inf, +inf, -inf, -inf), an empty Size (-inf, -inf), as on Windows.
+ * Interface identity per windows-rs 0.30.0 (MIT).
+ */
+
+#include <math.h>
+#include "private.h"
+
+enum { GRID_AUTO, GRID_PIXEL, GRID_STAR };
+struct xgridlength { DOUBLE value; INT32 type; };
+
+/* ---- GridLengthHelper ---- */
+
+static HRESULT WINAPI grid_Auto( struct xfiface *iface, struct xgridlength *value )
+{
+    if (!value) return E_POINTER;
+    value->value = 1;
+    value->type = GRID_AUTO;
+    return S_OK;
+}
+
+static HRESULT WINAPI grid_FromPixels( struct xfiface *iface, DOUBLE pixels, struct xgridlength *value )
+{
+    if (!value) return E_POINTER;
+    value->value = pixels;
+    value->type = GRID_PIXEL;
+    return S_OK;
+}
+
+static HRESULT WINAPI grid_FromValueAndType( struct xfiface *iface, DOUBLE length, INT32 type, struct xgridlength *value )
+{
+    if (!value) return E_POINTER;
+    if (type < GRID_AUTO || type > GRID_STAR) return E_INVALIDARG;
+#ifdef SG_MUTANT_GRIDLENGTH_TYPE_IGNORED
+    type = GRID_PIXEL;
+#endif
+    value->value = type == GRID_AUTO ? 1 : length;
+    value->type = type;
+    return S_OK;
+}
+
+#define GRID_IS(name, which) \
+static HRESULT WINAPI grid_GetIs##name( struct xfiface *iface, struct xgridlength length, boolean *value ) \
+{ if (!value) return E_POINTER; *value = length.type == which; return S_OK; }
+
+GRID_IS(Absolute, GRID_PIXEL)
+GRID_IS(Auto, GRID_AUTO)
+GRID_IS(Star, GRID_STAR)
+
+static HRESULT WINAPI grid_Equals( struct xfiface *iface, struct xgridlength a, struct xgridlength b, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = a.type == b.type && (a.type == GRID_AUTO || a.value == b.value);
+    return S_OK;
+}
+
+static const void *grid_vtbl[] =
+{
+    IGridLengthHelperStatics_FSTUBS,
+    [IGridLengthHelperStatics_Auto] = grid_Auto, [IGridLengthHelperStatics_FromPixels] = grid_FromPixels,
+    [IGridLengthHelperStatics_FromValueAndType] = grid_FromValueAndType,
+    [IGridLengthHelperStatics_GetIsAbsolute] = grid_GetIsAbsolute, [IGridLengthHelperStatics_GetIsAuto] = grid_GetIsAuto,
+    [IGridLengthHelperStatics_GetIsStar] = grid_GetIsStar, [IGridLengthHelperStatics_Equals] = grid_Equals,
+};
+
+/* ---- CornerRadiusHelper, ThicknessHelper ---- */
+
+static HRESULT WINAPI corner_FromRadii( struct xfiface *iface, DOUBLE tl, DOUBLE tr, DOUBLE br, DOUBLE bl, struct xcorner *value )
+{
+    if (!value) return E_POINTER;
+    value->top_left = tl;
+    value->top_right = tr;
+    value->bottom_right = br;
+    value->bottom_left = bl;
+    return S_OK;
+}
+
+static HRESULT WINAPI corner_FromUniformRadius( struct xfiface *iface, DOUBLE r, struct xcorner *value )
+{
+    return corner_FromRadii( iface, r, r, r, r, value );
+}
+
+static const void *corner_vtbl[] =
+{
+    ICornerRadiusHelperStatics_FSTUBS,
+    [ICornerRadiusHelperStatics_FromRadii] = corner_FromRadii, [ICornerRadiusHelperStatics_FromUniformRadius] = corner_FromUniformRadius,
+};
+
+static HRESULT WINAPI thickness_FromLengths( struct xfiface *iface, DOUBLE l, DOUBLE t, DOUBLE r, DOUBLE b, struct xthickness *value )
+{
+    if (!value) return E_POINTER;
+    value->left = l;
+    value->top = t;
+    value->right = r;
+    value->bottom = b;
+    return S_OK;
+}
+
+static HRESULT WINAPI thickness_FromUniformLength( struct xfiface *iface, DOUBLE u, struct xthickness *value )
+{
+    return thickness_FromLengths( iface, u, u, u, u, value );
+}
+
+static const void *thickness_vtbl[] =
+{
+    IThicknessHelperStatics_FSTUBS,
+    [IThicknessHelperStatics_FromLengths] = thickness_FromLengths,
+    [IThicknessHelperStatics_FromUniformLength] = thickness_FromUniformLength,
+};
+
+/* ---- PointHelper, SizeHelper, RectHelper ---- */
+
+static HRESULT WINAPI point_FromCoordinates( struct xfiface *iface, FLOAT x, FLOAT y, struct xpoint *value )
+{
+    if (!value) return E_POINTER;
+    value->x = x;
+    value->y = y;
+    return S_OK;
+}
+
+static const void *point_vtbl[] = { IPointHelperStatics_FSTUBS, [IPointHelperStatics_FromCoordinates] = point_FromCoordinates };
+
+static HRESULT WINAPI size_Empty( struct xfiface *iface, struct xsize *value )
+{
+    if (!value) return E_POINTER;
+    value->width = value->height = -INFINITY;
+    return S_OK;
+}
+
+static HRESULT WINAPI size_FromDimensions( struct xfiface *iface, FLOAT width, FLOAT height, struct xsize *value )
+{
+    if (!value) return E_POINTER;
+    if (width < 0 || height < 0) return E_INVALIDARG;
+    value->width = width;
+    value->height = height;
+    return S_OK;
+}
+
+static HRESULT WINAPI size_GetIsEmpty( struct xfiface *iface, struct xsize size, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = size.width < 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI size_Equals( struct xfiface *iface, struct xsize a, struct xsize b, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = a.width == b.width && a.height == b.height;
+    return S_OK;
+}
+
+static const void *size_vtbl[] =
+{
+    ISizeHelperStatics_FSTUBS,
+    [ISizeHelperStatics_Empty] = size_Empty, [ISizeHelperStatics_FromDimensions] = size_FromDimensions,
+    [ISizeHelperStatics_GetIsEmpty] = size_GetIsEmpty, [ISizeHelperStatics_Equals] = size_Equals,
+};
+
+static const struct xrect empty_rect = { INFINITY, INFINITY, -INFINITY, -INFINITY };
+
+static BOOL rect_empty( const struct xrect *r ) { return r->width < 0; }
+
+static HRESULT WINAPI rect_Empty( struct xfiface *iface, struct xrect *value )
+{
+    if (!value) return E_POINTER;
+    *value = empty_rect;
+    return S_OK;
+}
+
+static HRESULT WINAPI rect_FromCoordinatesAndDimensions( struct xfiface *iface, FLOAT x, FLOAT y, FLOAT w, FLOAT h, struct xrect *value )
+{
+    if (!value) return E_POINTER;
+    if (w < 0 || h < 0) return E_INVALIDARG;
+    value->x = x;
+    value->y = y;
+    value->width = w;
+    value->height = h;
+    return S_OK;
+}
+
+static HRESULT WINAPI rect_FromPoints( struct xfiface *iface, struct xpoint a, struct xpoint b, struct xrect *value )
+{
+    if (!value) return E_POINTER;
+    value->x = fminf( a.x, b.x );
+    value->y = fminf( a.y, b.y );
+    value->width = fabsf( a.x - b.x );
+    value->height = fabsf( a.y - b.y );
+    return S_OK;
+}
+
+static HRESULT WINAPI rect_FromLocationAndSize( struct xfiface *iface, struct xpoint location, struct xsize size, struct xrect *value )
+{
+    return rect_FromCoordinatesAndDimensions( iface, location.x, location.y, size.width, size.height, value );
+}
+
+static HRESULT WINAPI rect_GetIsEmpty( struct xfiface *iface, struct xrect r, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = rect_empty( &r );
+    return S_OK;
+}
+
+#define RECT_EDGE(name, expr, empty) \
+static HRESULT WINAPI rect_Get##name( struct xfiface *iface, struct xrect r, FLOAT *value ) \
+{ if (!value) return E_POINTER; *value = rect_empty( &r ) ? empty : (expr); return S_OK; }
+
+RECT_EDGE(Bottom, r.y + r.height, -INFINITY)
+RECT_EDGE(Left, r.x, INFINITY)
+RECT_EDGE(Right, r.x + r.width, -INFINITY)
+RECT_EDGE(Top, r.y, INFINITY)
+
+static HRESULT WINAPI rect_Contains( struct xfiface *iface, struct xrect r, struct xpoint p, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = !rect_empty( &r ) && p.x >= r.x && p.x <= r.x + r.width && p.y >= r.y && p.y <= r.y + r.height;
+    return S_OK;
+}
+
+static HRESULT WINAPI rect_Equals( struct xfiface *iface, struct xrect a, struct xrect b, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = (rect_empty( &a ) && rect_empty( &b )) ||
+             (a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height);
+    return S_OK;
+}
+
+static HRESULT WINAPI rect_Intersect( struct xfiface *iface, struct xrect a, struct xrect b, struct xrect *value )
+{
+    FLOAT left, top, right, bottom;
+
+    if (!value) return E_POINTER;
+    left = fmaxf( a.x, b.x );
+    top = fmaxf( a.y, b.y );
+    right = fminf( a.x + a.width, b.x + b.width );
+    bottom = fminf( a.y + a.height, b.y + b.height );
+#ifdef SG_MUTANT_RECT_INTERSECT_UNION
+    left = fminf( a.x, b.x ); top = fminf( a.y, b.y );
+    right = fmaxf( a.x + a.width, b.x + b.width ); bottom = fmaxf( a.y + a.height, b.y + b.height );
+#endif
+    if (rect_empty( &a ) || rect_empty( &b ) || right < left || bottom < top) *value = empty_rect;
+    else
+    {
+        value->x = left;
+        value->y = top;
+        value->width = right - left;
+        value->height = bottom - top;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI rect_UnionWithRect( struct xfiface *iface, struct xrect a, struct xrect b, struct xrect *value )
+{
+    FLOAT left, top, right, bottom;
+
+    if (!value) return E_POINTER;
+    if (rect_empty( &a )) { *value = b; return S_OK; }
+    if (rect_empty( &b )) { *value = a; return S_OK; }
+    left = fminf( a.x, b.x );
+    top = fminf( a.y, b.y );
+    right = fmaxf( a.x + a.width, b.x + b.width );
+    bottom = fmaxf( a.y + a.height, b.y + b.height );
+    value->x = left;
+    value->y = top;
+    value->width = right - left;
+    value->height = bottom - top;
+    return S_OK;
+}
+
+static HRESULT WINAPI rect_UnionWithPoint( struct xfiface *iface, struct xrect r, struct xpoint p, struct xrect *value )
+{
+    struct xrect point = { p.x, p.y, 0, 0 };
+    return rect_UnionWithRect( iface, r, point, value );
+}
+
+static const void *rect_vtbl[] =
+{
+    IRectHelperStatics_FSTUBS,
+    [IRectHelperStatics_Empty] = rect_Empty,
+    [IRectHelperStatics_FromCoordinatesAndDimensions] = rect_FromCoordinatesAndDimensions,
+    [IRectHelperStatics_FromPoints] = rect_FromPoints, [IRectHelperStatics_FromLocationAndSize] = rect_FromLocationAndSize,
+    [IRectHelperStatics_GetIsEmpty] = rect_GetIsEmpty, [IRectHelperStatics_GetBottom] = rect_GetBottom,
+    [IRectHelperStatics_GetLeft] = rect_GetLeft, [IRectHelperStatics_GetRight] = rect_GetRight,
+    [IRectHelperStatics_GetTop] = rect_GetTop, [IRectHelperStatics_Contains] = rect_Contains,
+    [IRectHelperStatics_Equals] = rect_Equals, [IRectHelperStatics_Intersect] = rect_Intersect,
+    [IRectHelperStatics_UnionWithPoint] = rect_UnionWithPoint, [IRectHelperStatics_UnionWithRect] = rect_UnionWithRect,
+};
+
+#define HELPER(var, name, iid, vtbl) \
+static struct xfactory var##_obj = { { &xfactory_vtbl }, name, { iid }, { { vtbl } }, NULL }; \
+IActivationFactory *var = &var##_obj.IActivationFactory_iface;
+
+HELPER(grid_length_helper_factory, L"Windows.UI.Xaml.GridLengthHelper", &IID_IGridLengthHelperStatics, grid_vtbl)
+HELPER(corner_radius_helper_factory, L"Windows.UI.Xaml.CornerRadiusHelper", &IID_ICornerRadiusHelperStatics, corner_vtbl)
+HELPER(thickness_helper_factory, L"Windows.UI.Xaml.ThicknessHelper", &IID_IThicknessHelperStatics, thickness_vtbl)
+HELPER(point_helper_factory, L"Windows.UI.Xaml.PointHelper", &IID_IPointHelperStatics, point_vtbl)
+HELPER(rect_helper_factory, L"Windows.UI.Xaml.RectHelper", &IID_IRectHelperStatics, rect_vtbl)
