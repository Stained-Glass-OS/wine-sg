+static struct icon_source *source_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct icon_source, d.obj );
+}
+
+static HRESULT put_box( struct dobj *d, struct xaml_property *prop, IInspectable *box )
+{
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( d, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static HRESULT get_string( struct dobj *d, struct xaml_property *prop, HSTRING *value )
+{
+    IInspectable *box = NULL;
+    WCHAR *str;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    dobj_get_value( d, prop, &box );
+    str = xunbox_string( box );
+    if (box) IInspectable_Release( box );
+    hr = xaml_hstring( str ? str : L"", value );
+    free( str );
+    return hr;
+}
+
+static HRESULT put_string( struct dobj *d, struct xaml_property *prop, HSTRING value )
+{
+    const WCHAR *str = WindowsGetStringRawBuffer( value, NULL );
+    return put_box( d, prop, xbox_string( str ? str : L"" ) );
+}
+
+static boolean get_bool( struct dobj *d, struct xaml_property *prop, boolean def )
+{
+    IInspectable *box = NULL;
+    boolean ret;
+
+    dobj_get_value( d, prop, &box );
+    ret = xunbox_boolean( box, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+#define OBJECT_MEMBER(prefix, name, prop) \
+static HRESULT WINAPI prefix##_get_##name( struct xiface *iface, IInspectable **value ) \
+{ if (!value) return E_POINTER; return dobj_get_value( &source_from_iface( iface )->d, prop, value ); } \
+static HRESULT WINAPI prefix##_put_##name( struct xiface *iface, IInspectable *value ) \
+{ return dobj_set_value( &source_from_iface( iface )->d, prop, value ); }
+
+#define BOOL_MEMBER(prefix, name, prop, def) \
+static HRESULT WINAPI prefix##_get_##name( struct xiface *iface, boolean *value ) \
+{ if (!value) return E_POINTER; *value = get_bool( &source_from_iface( iface )->d, prop, def ); return S_OK; } \
+static HRESULT WINAPI prefix##_put_##name( struct xiface *iface, boolean value ) \
+{ return put_box( &source_from_iface( iface )->d, prop, xbox_boolean( value ) ); }
+
+OBJECT_MEMBER(source, Foreground, prop_foreground)
+
+static const void *source_vtbl[] = { IIconSource_STUBS, [6] = source_get_Foreground, [7] = source_put_Foreground };
