index 091f51b..6503ad1 100644
--- a/dlls/windows.ui.xaml/input.c
+++ b/dlls/windows.ui.xaml/input.c
@@ -156,6 +156,15 @@ static void tooltip_show(void)
     POINT pt = tip.pt;
 
     if (!tip.owner || tip.window || !(value = tooltip_of( tip.owner ))) return;
+    {
+        /* a ToolTip: what it holds */
+        IInspectable *content = xaml_tooltip_content( value );
+        if (content)
+        {
+            IInspectable_Release( value );
+            value = content;
+        }
+    }
 #ifdef SG_MUTANT_NO_TOOLTIPS
     IInspectable_Release( value );
     return;
