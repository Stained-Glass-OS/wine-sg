+
+    if (!value) return E_POINTER;
+    dobj_get_value( &source_from_iface( iface )->d, prop_font_style, &box );
+    *value = xunbox_enum( box, NULL, 0 );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
