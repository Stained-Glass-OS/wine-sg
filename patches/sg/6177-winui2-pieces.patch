+    if (obj && foreground)
+    {
+        struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.Controls.IconElement", L"Foreground" );
+        struct dobj *d = dobj_from_inspectable( obj );
+        if (prop && d) dobj_set_value( d, prop, foreground );
