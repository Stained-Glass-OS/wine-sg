+/*
+ * The path mini-language of XAML (the documented Move and Draw commands: F0/F1 fill rule, M L H V C Q
+ * S T A Z, lower case relative) is read into absolute segments: moves, lines, cubic and quadratic
+ * Béziers, arcs and closes; the renderer draws them with Direct2D (render.c).  A geometry made from
+ * such a string is a PathGeometry of ours; its Figures collection is not kept yet.
+ * Interface identity per windows-rs 0.30.0 (MIT).
+ */
+
+#include <math.h>
+#include <stdlib.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+static void path_add( struct xpath *path, BYTE type, const FLOAT *p, int n )
+{
+    struct xpath_seg *seg;
+    int i;
+
+    if (path->count == path->size)
+    {
+        UINT size = path->size ? path->size * 2 : 16;
+        struct xpath_seg *segs = realloc( path->segs, size * sizeof(*segs) );
+        if (!segs) return;
+        path->segs = segs;
+        path->size = size;
+    }
+    seg = &path->segs[path->count++];
+    memset( seg, 0, sizeof(*seg) );
+    seg->type = type;
+    for (i = 0; i < n; i++) seg->p[i] = p[i];
+}
+
+static void bound( struct xpath *path, FLOAT x, FLOAT y )
+{
+    if (!path->has_bounds)
+    {
+        path->left = path->right = x;
+        path->top = path->bottom = y;
+        path->has_bounds = TRUE;
+        return;
+    }
+    path->left = fminf( path->left, x );
+    path->right = fmaxf( path->right, x );
+    path->top = fminf( path->top, y );
+    path->bottom = fmaxf( path->bottom, y );
+}
+
+static const WCHAR *skip( const WCHAR *s )
+{
+    while (*s == ' ' || *s == ',' || *s == '\t' || *s == '\r' || *s == '\n') s++;
+    return s;
+}
+
+static BOOL number( const WCHAR **s, FLOAT *value )
+{
+    WCHAR *end;
+    *s = skip( *s );
+    *value = wcstod( *s, &end );
+    if (end == *s) return FALSE;
+    *s = end;
+    return TRUE;
+}
+
+/* the segments of path markup, or NULL */
+struct xpath *xaml_path_parse( const WCHAR *str )
+{
+    struct xpath *path = calloc( 1, sizeof(*path) );
+    FLOAT x = 0, y = 0, sx = 0, sy = 0, cx = 0, cy = 0, v[7];
+    WCHAR cmd = 0, last = 0;
+    const WCHAR *s = str;
+    BOOL ok = TRUE;
+    int i;
+
+    if (!path) return NULL;
+    while (ok)
+    {
+        BOOL rel;
+        s = skip( s );
+        if (!*s) break;
+        if (iswalpha( *s ))
+        {
+            cmd = *s++;
+            if (cmd == 'F' || cmd == 'f')
+            {
+                FLOAT rule;
+                if (!number( &s, &rule )) { ok = FALSE; break; }
+                path->nonzero = rule != 0;
+                continue;
+            }
+        }
+        else if (!cmd) { ok = FALSE; break; }
+        rel = iswlower( cmd );
+        switch (towupper( cmd ))
+        {
+        case 'M':
+            if (!number( &s, &v[0] ) || !number( &s, &v[1] )) { ok = FALSE; break; }
+            if (rel) { v[0] += x; v[1] += y; }
+            path_add( path, 'M', v, 2 );
+            x = sx = v[0]; y = sy = v[1];
+            bound( path, x, y );
+            cmd = rel ? 'l' : 'L';   /* further pairs are lines */
+            break;
+        case 'L':
+            if (!number( &s, &v[0] ) || !number( &s, &v[1] )) { ok = FALSE; break; }
+            if (rel) { v[0] += x; v[1] += y; }
+            path_add( path, 'L', v, 2 );
+            x = v[0]; y = v[1];
+            bound( path, x, y );
+            break;
+        case 'H':
+            if (!number( &s, &v[0] )) { ok = FALSE; break; }
+            v[0] = rel ? x + v[0] : v[0];
+            v[1] = y;
+            path_add( path, 'L', v, 2 );
+            x = v[0];
+            bound( path, x, y );
+            break;
+        case 'V':
+            if (!number( &s, &v[1] )) { ok = FALSE; break; }
+            v[1] = rel ? y + v[1] : v[1];
+            v[0] = x;
+            path_add( path, 'L', v, 2 );
+            y = v[1];
+            bound( path, x, y );
+            break;
+        case 'C': case 'S':
+        {
+            int first = towupper( cmd ) == 'S' ? 2 : 0;
+            for (i = first; i < 6; i++) if (!number( &s, &v[i] )) { ok = FALSE; break; }
+            if (!ok) break;
+            if (rel) for (i = first; i < 6; i += 2) { v[i] += x; v[i + 1] += y; }
+            if (first)
+            {
+                /* the first control point: the last one reflected, if the last segment was a cubic */
+                BOOL cubic = towupper( last ) == 'C' || towupper( last ) == 'S';
+                v[0] = cubic ? 2 * x - cx : x;
+                v[1] = cubic ? 2 * y - cy : y;
+            }
+            path_add( path, 'C', v, 6 );
+            for (i = 0; i < 6; i += 2) bound( path, v[i], v[i + 1] );
+            cx = v[2]; cy = v[3]; x = v[4]; y = v[5];
+            break;
+        }
+        case 'Q': case 'T':
+        {
+            int first = towupper( cmd ) == 'T' ? 2 : 0;
+            for (i = first; i < 4; i++) if (!number( &s, &v[i] )) { ok = FALSE; break; }
+            if (!ok) break;
+            if (rel) for (i = first; i < 4; i += 2) { v[i] += x; v[i + 1] += y; }
+            if (first)
+            {
+                BOOL quad = towupper( last ) == 'Q' || towupper( last ) == 'T';
+                v[0] = quad ? 2 * x - cx : x;
+                v[1] = quad ? 2 * y - cy : y;
+            }
+            path_add( path, 'Q', v, 4 );
+            for (i = 0; i < 4; i += 2) bound( path, v[i], v[i + 1] );
+            cx = v[0]; cy = v[1]; x = v[2]; y = v[3];
+            break;
+        }
+        case 'A':
+            /* rx ry rotation large-arc sweep x y */
+            for (i = 0; i < 7; i++) if (!number( &s, &v[i] )) { ok = FALSE; break; }
+            if (!ok) break;
+            if (rel) { v[5] += x; v[6] += y; }
+            path_add( path, 'A', v, 7 );
+            bound( path, x - v[0], y - v[1] );   /* roughly: the arc stays within its radii */
+            x = v[5]; y = v[6];
+            bound( path, x, y );
+            break;
+        case 'Z':
+            path_add( path, 'Z', v, 0 );
+            x = sx; y = sy;
+            cmd = 0;
+            break;
+        default:
+            ok = FALSE;
+        }
+        last = cmd ? cmd : 'Z';
+    }
+#ifdef SG_MUTANT_PATH_NOT_PARSED
+    path->count = 0;
+#endif
+    if (!ok) WARN( "%s: path markup not read past %s\n", debugstr_w( str ), debugstr_w( s ) );
+    return path;
+}
+
+void xaml_path_free( struct xpath *path )
+{
+    if (!path) return;
+    free( path->segs );
+    free( path );
+}
+
+/* ---- PathGeometry ---- */
+
+struct geometry
+{
+    struct dobj d;
+    struct xiface IGeometry_iface, IPathGeometry_iface;
+    struct xpath *path;
+};
+
+static const struct xiface_entry geometry_ifaces[] =
+{
+    { &IID_IPathGeometry, offsetof(struct geometry, IPathGeometry_iface) },
+    { &IID_IGeometry, offsetof(struct geometry, IGeometry_iface) },
+    DOBJ_IFACES(struct dobj),
+};
+
+static void geometry_destroy( struct xobj *obj )
+{
+    struct geometry *geometry = CONTAINING_RECORD( obj, struct geometry, d.obj );
+    xaml_path_free( geometry->path );
+    dobj_cleanup( &geometry->d );
+}
+
+static const struct xclass geometry_class =
+{
+    L"Windows.UI.Xaml.Media.PathGeometry", geometry_ifaces, ARRAY_SIZE(geometry_ifaces), geometry_destroy,
+};
+
+static HRESULT WINAPI geometry_get_Bounds( struct xiface *iface, struct xrect *value )
+{
+    struct geometry *geometry = CONTAINING_RECORD( iface->obj, struct geometry, d.obj );
+    struct xpath *path = geometry->path;
+
+    if (!value) return E_POINTER;
+    memset( value, 0, sizeof(*value) );
+    if (path && path->has_bounds)
+    {
+        value->x = path->left;
+        value->y = path->top;
+        value->width = path->right - path->left;
+        value->height = path->bottom - path->top;
+    }
+    return S_OK;
+}
+
+static const void *geometry_vtbl[] = { IGeometry_STUBS, [IGeometry_Bounds] = geometry_get_Bounds };
+static const void *path_geometry_vtbl[] = { IPathGeometry_STUBS };
+
+static struct geometry *new_geometry( struct xpath *path )
+{
+    struct geometry *geometry;
+
+    if (!(geometry = calloc( 1, sizeof(*geometry) ))) return NULL;
+    geometry->IGeometry_iface.vtbl = geometry_vtbl;
+    geometry->IPathGeometry_iface.vtbl = path_geometry_vtbl;
+    geometry->path = path;
+    dobj_init( &geometry->d, &geometry_class, NULL );
+    return geometry;
+}
+
+/* a geometry from path markup (a property's string value) */
+IInspectable *xaml_geometry_from_string( const WCHAR *str )
+{
+    struct xpath *path = xaml_path_parse( str );
+    struct geometry *geometry;
+
+    if (!path) return NULL;
+    if (!(geometry = new_geometry( path )))
+    {
+        xaml_path_free( path );
+        return NULL;
+    }
+    return (IInspectable *)&geometry->IGeometry_iface;
+}
+
+/* the segments of a geometry of ours, or NULL */
+const struct xpath *xaml_geometry_path( IInspectable *obj )
+{
+    struct dobj *d = dobj_from_inspectable( obj );
+
+    if (!d || d->obj.cls != &geometry_class) return NULL;
+    return CONTAINING_RECORD( d, struct geometry, d )->path;
+}
+
+static HRESULT activate_path_geometry( IInspectable **out )
+{
+    struct xpath *path = calloc( 1, sizeof(*path) );
+    struct geometry *geometry;
+
+    if (!path) return E_OUTOFMEMORY;
+    if (!(geometry = new_geometry( path )))
+    {
+        free( path );
+        return E_OUTOFMEMORY;
+    }
+    *out = (IInspectable *)&geometry->IPathGeometry_iface;
+    return S_OK;
+}
+
+static struct xfactory path_geometry_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Media.PathGeometry",
+                                                     { NULL }, { { NULL } }, activate_path_geometry };
+IActivationFactory *path_geometry_factory = &path_geometry_factory_obj.IActivationFactory_iface;
