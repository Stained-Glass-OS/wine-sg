+/* ---- x:Load elements: made when the application finds them by name ---- */
+
+struct deferral
+{
+    struct list entry;
+    IWeakReference *parent;        /* where it goes */
+    WCHAR *name;
+    struct xbf_blob *blob;
+    INT32 section;
+    IInspectable *connector;       /* its x:ConnectionId go to the component that had it */
+    UINT32 index;                  /* its place among a panel's children, or ~0u */
+};
+
+static struct list deferrals = LIST_INIT( deferrals );
+static CRITICAL_SECTION deferral_cs;
+static CRITICAL_SECTION_DEBUG deferral_cs_debug =
+{
+    0, 0, &deferral_cs, { &deferral_cs_debug.ProcessLocksList, &deferral_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": deferral_cs") }
+};
+static CRITICAL_SECTION deferral_cs = { &deferral_cs_debug, -1, 0, 0, 0, 0 };
+
+static void free_deferral( struct deferral *d )
+{
+    if (d->parent) IWeakReference_Release( d->parent );
+    if (d->connector) IInspectable_Release( d->connector );
+    xaml_xbf_blob_release( d->blob );
+    free( d->name );
+    free( d );
+}
+
+/* a panel's Children (an IVector<UIElement>, a reference), or NULL */
+static IInspectable *panel_children( IInspectable *parent )
+{
+    IInspectable *panel = NULL, *children = NULL;
+
+    if (FAILED(IInspectable_QueryInterface( parent, &IID_IPanel, (void **)&panel ))) return NULL;
+    ((HRESULT (WINAPI *)(IInspectable *, IInspectable **))((void **)panel->lpVtbl)[IPanel_Children])( panel, &children );
+    IInspectable_Release( panel );
+    return children;
+}
+
+static UINT32 vector_size( IInspectable *vector )
+{
+    UINT32 size = 0;
+    ((HRESULT (WINAPI *)(IInspectable *, UINT32 *))((void **)vector->lpVtbl)[7])( vector, &size );   /* Size */
+    return size;
+}
+
+static void defer_element( struct xbf_state *s, IInspectable *parent, const WCHAR *name, INT32 section )
+{
+    IInspectable *children;
+    IWeakReferenceSource *source;
+    struct deferral *d;
+
+    if (!s->blob || !(d = calloc( 1, sizeof(*d) ))) return;
+    if (FAILED(IInspectable_QueryInterface( parent, &IID_IWeakReferenceSource, (void **)&source )))
+    {
+        free( d );
+        return;
+    }
+    IWeakReferenceSource_GetWeakReference( source, &d->parent );
+    IWeakReferenceSource_Release( source );
+    d->name = wcsdup( name );
+    d->blob = s->blob;
+    InterlockedIncrement( &s->blob->ref );
+    d->section = section;
+    d->index = ~0u;
+    if ((children = panel_children( parent )))
+    {
+        d->index = vector_size( children );   /* the children before it are made already */
+        IInspectable_Release( children );
+    }
+    if ((d->connector = s->writer->component)) IInspectable_AddRef( d->connector );
+    TRACE( "%s (section %d) deferred under %p\n", debugstr_w( name ), section, parent );
+    EnterCriticalSection( &deferral_cs );
+    list_add_tail( &deferrals, &d->entry );
+    LeaveCriticalSection( &deferral_cs );
+}
+
+/* whether a weak reference is to that object */
+static BOOL weak_same( IWeakReference *weak, IInspectable *obj )
+{
+    IInspectable *p = NULL;
+    BOOL same;
+
+    IWeakReference_Resolve( weak, &IID_IInspectable, &p );
+    same = p == obj;
+    if (p) IInspectable_Release( p );
+    return same;
+}
+
+static struct uielem *tree_root( struct uielem *elem )
+{
+    while (elem && elem->parent) elem = elem->parent;
+    return elem;
+}
+
+/* the x:Load element of that name in the tree of scope (an element), made now and put in its place;
+ * NULL if there is none */
+IInspectable *xaml_realize_deferred( struct uielem *scope, const WCHAR *name )
+{
+    struct deferral *d, *next, *found = NULL;
+    IInspectable *parent = NULL, *obj = NULL;
+    struct uielem *root = tree_root( scope ), *pe;
+
+#ifdef SG_MUTANT_XAML_NO_DEFER_REALIZE
+    return NULL;
+#endif
+    EnterCriticalSection( &deferral_cs );
+    LIST_FOR_EACH_ENTRY_SAFE( d, next, &deferrals, struct deferral, entry )
+    {
+        IInspectable *p = NULL;
+        IWeakReference_Resolve( d->parent, &IID_IInspectable, &p );
+        if (!p)   /* its parent is gone */
+        {
+            list_remove( &d->entry );
+            free_deferral( d );
+            continue;
+        }
+        if (!wcscmp( d->name, name ) && (pe = uielem_from_inspectable( p )) && tree_root( pe ) == root)
+        {
+            list_remove( &d->entry );
+            found = d;
+            parent = p;
+            break;
+        }
+        IInspectable_Release( p );
+    }
+    LeaveCriticalSection( &deferral_cs );
+    if (!found) return NULL;
+    if (SUCCEEDED(load_xbf( found->blob, found->section, NULL, found->connector, NULL, NULL, &obj )) && obj)
+    {
+        struct xaml_writer writer = { NULL, found->connector };
+        IInspectable *children = panel_children( parent ), *elem = NULL;
+        HRESULT hr = E_FAIL;
+
+#ifndef SG_MUTANT_XAML_DEFER_APPENDED
+        if (children && found->index < vector_size( children )
+            && SUCCEEDED(IInspectable_QueryInterface( obj, &IID_IUIElement, (void **)&elem )))
+        {
+            /* in its place: before the children that followed it in the markup */
+            hr = ((HRESULT (WINAPI *)(IInspectable *, UINT32, IInspectable *))((void **)children->lpVtbl)[11])(
+                    children, found->index, elem );   /* InsertAt */
+            IInspectable_Release( elem );
+        }
+        if (children && SUCCEEDED(hr))
+        {
+            /* the x:Load siblings after it move up one */
+            EnterCriticalSection( &deferral_cs );
+            LIST_FOR_EACH_ENTRY( d, &deferrals, struct deferral, entry )
+                if (d->parent == found->parent || weak_same( d->parent, parent ))
+                    if (d->index != ~0u && d->index >= found->index) d->index++;
+            LeaveCriticalSection( &deferral_cs );
+        }
+#endif
+        if (children) IInspectable_Release( children );
+        if (FAILED(hr)) hr = xaml_writer_add_content( &writer, parent, obj );
+        TRACE( "%s made: %p into %p, %#lx\n", debugstr_w( name ), obj, parent, hr );
+        if (FAILED(hr))
+        {
+            IInspectable_Release( obj );
+            obj = NULL;
+        }
+    }
+    else WARN( "%s not made\n", debugstr_w( name ) );
+    IInspectable_Release( parent );
+    free_deferral( found );
+    return obj;
+}
+
+/* the x:Name of a section's object (an x:Load element's), from the members it begins with */
+static WCHAR *section_name( struct xbf_state *s, INT32 section )
+{
+    struct rd r;
+    BYTE op;
+
+    r.data = s->xbf->data;
+    r.size = s->xbf->size;
+    r.pos = s->xbf->first_node + s->xbf->sections[section].nodes;
+    r.end = s->xbf->first_node + s->xbf->sections[section].positions;
+    r.bad = FALSE;
+    if (rd_u8( &r ) != 0x14) return NULL;
+    rd_u16( &r );
+    while (r.pos < r.end && !r.bad)
+    {
+        op = rd_u8( &r );
+        if (op == 0x0d) return read_value( s, &r );
+        if (op != 0x0c && op != 0x0e) break;   /* x:ConnectionId, x:Uid come first */
+        free( read_value( s, &r ) );
+    }
+    return NULL;
+}
