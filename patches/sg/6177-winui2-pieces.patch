+static struct icon_source *new_source( enum source_kind kind, IInspectable *outer )
+{
+    static const struct xclass *classes[] = { &base_class, &font_class, &symbol_class, &bitmap_class, &path_class };
+    struct icon_source *source;
+
+    icons_init();
+    if (!(source = calloc( 1, sizeof(*source) ))) return NULL;
+    source->kind = kind;
+    source->IIconSource_iface.vtbl = source_vtbl;
+    source->IFontIconSource_iface.vtbl = font_vtbl;
+    source->ISymbolIconSource_iface.vtbl = symbol_vtbl;
+    source->IBitmapIconSource_iface.vtbl = bitmap_vtbl;
+    source->IPathIconSource_iface.vtbl = path_vtbl;
+    dobj_init( &source->d, classes[kind], outer );
+    return source;
+}
+
+#define SOURCE_CREATE(name, kind, field) \
+static HRESULT WINAPI name( struct xfiface *iface, IInspectable *outer, IInspectable **inner, void **value ) \
+{ \
+    struct icon_source *source; \
+    if (!value) return E_POINTER; \
+    if (outer && !inner) return E_INVALIDARG; \
+    if (!(source = new_source( kind, outer ))) return E_OUTOFMEMORY; \
+    if (outer) \
+    { \
+        *inner = &source->d.obj.IInspectable_inner; \
+        IUnknown_AddRef( source->d.obj.outer ); \
+    } \
+    *value = &source->field; \
+    return S_OK; \
+}
+
+SOURCE_CREATE(font_create, SOURCE_FONT, IFontIconSource_iface)
+SOURCE_CREATE(symbol_create, SOURCE_SYMBOL, ISymbolIconSource_iface)
+SOURCE_CREATE(bitmap_create, SOURCE_BITMAP, IBitmapIconSource_iface)
+SOURCE_CREATE(path_create, SOURCE_PATH, IPathIconSource_iface)
+
+/* ---- IconSourceElement ---- */
+
+struct icon_element
+{
+    struct uielem e;
+    struct xiface IIconSourceElement_iface, IIconElement_iface, IBitmapIcon_iface, IBitmapIcon2_iface;
+    struct uielem *child;           /* what shows its icon source (a reference) */
+};
+
+static struct icon_element *element_from_elem( struct uielem *elem )
+{
+    return CONTAINING_RECORD( elem, struct icon_element, e );
+}
+
+static void set_child( struct icon_element *element, struct uielem *child )
+{
+    if (element->child)
+    {
+        uielem_remove_child( &element->e, element->child );
+        IUnknown_Release( element->child->d.obj.outer );
+    }
+    if ((element->child = child))
+    {
+        IUnknown_AddRef( child->d.obj.outer );
+        uielem_add_child( &element->e, child );
+    }
+    uielem_invalidate_measure( &element->e );
+}
+
+static void append_escaped( WCHAR *buf, size_t size, const WCHAR *str )
+{
+    size_t len = wcslen( buf );
+
+    for (; *str && len + 10 < size; str++)
+    {
+        if (*str == '"' || *str == '&' || *str == '<' || *str >= 0x80)
+            len += swprintf( buf + len, size - len, L"&#x%x;", *str );
+        else buf[len++] = *str;
+    }
+    buf[len] = 0;
+}
+
+/* an Image of a Uri's picture */
+static IInspectable *make_image( IInspectable *uri )
+{
+    IInspectable *obj = NULL;
+    WCHAR markup[512];
+    WCHAR *str;
+
+    if (!uri || !(str = xaml_uri_string( uri ))) return NULL;
+    wcscpy( markup, L"<Image xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\" Stretch=\"Uniform\" Source=\"" );
+    append_escaped( markup, ARRAY_SIZE(markup) - 8, str );
+    wcscat( markup, L"\"/>" );
+    free( str );
+    if (FAILED(xaml_load_text( markup, NULL, &obj ))) obj = NULL;
+    return obj;
+}
+
+/* the element that shows an icon source */
+static IInspectable *make_icon( struct icon_source *source )
+{
+    IInspectable *obj = NULL, *box = NULL, *foreground = NULL;
+    WCHAR markup[512];
+    WCHAR *str;
+
+    switch (source->kind)
+    {
+    case SOURCE_FONT:
+    {
+        IInspectable *family = NULL;
+        dobj_get_value( &source->d, prop_glyph, &box );
+        str = xunbox_string( box );
+        if (box) IInspectable_Release( box );
+        box = NULL;
+        wcscpy( markup, L"<FontIcon xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\" Glyph=\"" );
+        append_escaped( markup, ARRAY_SIZE(markup) - 64, str ? str : L"" );
+        free( str );
+        dobj_get_value( &source->d, prop_font_size, &box );
+        swprintf( markup + wcslen( markup ), 64, L"\" FontSize=\"%g\"/>", xunbox_double( box, 20 ) );
+        if (box) IInspectable_Release( box );
+        if (FAILED(xaml_load_text( markup, NULL, &obj ))) obj = NULL;
