+{
+    IFontIconSource_STUBS,
+    [IFontIconSource_Glyph] = font_get_Glyph, [IFontIconSource_SetGlyph] = font_put_Glyph,
+    [IFontIconSource_FontSize] = font_get_FontSize, [IFontIconSource_SetFontSize] = font_put_FontSize,
+    [IFontIconSource_FontFamily] = font_get_FontFamily, [IFontIconSource_SetFontFamily] = font_put_FontFamily,
+    [IFontIconSource_FontWeight] = font_get_FontWeight, [IFontIconSource_SetFontWeight] = font_put_FontWeight,
+    [IFontIconSource_FontStyle] = font_get_FontStyle, [IFontIconSource_SetFontStyle] = font_put_FontStyle,
+    [IFontIconSource_IsTextScaleFactorEnabled] = font_get_IsTextScaleFactorEnabled,
+    [IFontIconSource_SetIsTextScaleFactorEnabled] = font_put_IsTextScaleFactorEnabled,
+    [IFontIconSource_MirroredWhenRightToLeft] = font_get_MirroredWhenRightToLeft,
+    [IFontIconSource_SetMirroredWhenRightToLeft] = font_put_MirroredWhenRightToLeft,
+};
+
+/* SymbolIconSource */
+static HRESULT WINAPI symbol_get_Symbol( struct xiface *iface, INT32 *value )
+{
+    IInspectable *box = NULL;
+
+    if (!value) return E_POINTER;
+    dobj_get_value( &source_from_iface( iface )->d, prop_symbol, &box );
+    *value = xunbox_enum( box, NULL, 0xe109 );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+static HRESULT WINAPI symbol_put_Symbol( struct xiface *iface, INT32 value )
+{
+    return put_box( &source_from_iface( iface )->d, prop_symbol, xbox_int32( value ) );
+}
