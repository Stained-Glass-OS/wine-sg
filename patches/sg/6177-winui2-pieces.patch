+
+static void source_destroy( struct xobj *obj )
+{
+    dobj_cleanup( &CONTAINING_RECORD( obj, struct icon_source, d.obj )->d );
+}
+
+#define SOURCE_CLASS(var, name, first_iid, first_field) \
+static const struct xiface_entry var##_ifaces[] = \
+{ \
+    { first_iid, offsetof(struct icon_source, first_field) }, \
+    { &IID_IIconSource, offsetof(struct icon_source, IIconSource_iface) }, \
+    DOBJ_IFACES(struct dobj), \
+}; \
+static const struct xclass var = { name, var##_ifaces, ARRAY_SIZE(var##_ifaces), source_destroy };
+
+static const struct xiface_entry base_ifaces[] =
+{
+    { &IID_IIconSource, offsetof(struct icon_source, IIconSource_iface) },
+    DOBJ_IFACES(struct dobj),
+};
+static const struct xclass base_class = { L"Windows.UI.Xaml.Controls.IconSource", base_ifaces, ARRAY_SIZE(base_ifaces), source_destroy };
+SOURCE_CLASS(font_class, L"Windows.UI.Xaml.Controls.FontIconSource", &IID_IFontIconSource, IFontIconSource_iface)
+SOURCE_CLASS(symbol_class, L"Windows.UI.Xaml.Controls.SymbolIconSource", &IID_ISymbolIconSource, ISymbolIconSource_iface)
+SOURCE_CLASS(bitmap_class, L"Windows.UI.Xaml.Controls.BitmapIconSource", &IID_IBitmapIconSource, IBitmapIconSource_iface)
+SOURCE_CLASS(path_class, L"Windows.UI.Xaml.Controls.PathIconSource", &IID_IPathIconSource, IPathIconSource_iface)
