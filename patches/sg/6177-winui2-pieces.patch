+/* a XAML thread has a DispatcherQueue, as on Windows (programs throttle their work through it) */
+static void thread_dispatcher_queue(void)
+{
+    struct { DWORD size; INT32 thread_type; INT32 apartment; } options = { sizeof(options), 2 /* DQTYPE_THREAD_CURRENT */, 0 };
+    HRESULT (WINAPI *create)( typeof(options), void ** );
