+    dobj_get_value( &source_from_iface( iface )->d, prop_font_weight, &box );
+    if (box)
+    {
+        xunbox_ref( box, &IID_IReference_FontWeight, value, sizeof(*value) );
+        IInspectable_Release( box );
+    }
+    return S_OK;
+}
