+{
+    IInspectable *box = NULL;
+
+    if (!value) return E_POINTER;
+    dobj_get_value( &source_from_iface( iface )->d, prop_font_size, &box );
+    *value = xunbox_double( box, 20 );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+static HRESULT WINAPI font_put_FontSize( struct xiface *iface, DOUBLE value )
