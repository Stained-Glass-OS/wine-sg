index 56c89bf..ce0b79e 100644
--- a/dlls/windows.ui.xaml/Makefile.in
+++ b/dlls/windows.ui.xaml/Makefile.in
@@ -5,6 +5,7 @@ IMPORTS = combase ole32 xmllite d2d1 dwrite windowscodecs user32 advapi32 uuid
 SOURCES = \
 	accel.c \
 	application.c \
+	automation.c \
 	bindinghelper.c \
 	buttons.c \
 	classes.idl \
@@ -15,7 +16,10 @@ SOURCES = \
 	factory.c \
 	flyouts.c \
 	focus.c \
+	geometry.c \
+	helpers.c \
 	hosting.c \
+	icons.c \
 	imaging.c \
 	ifaces.c \
 	input.c \
@@ -32,6 +36,8 @@ SOURCES = \
 	shapes.c \
 	templates.c \
 	textinput.c \
+	timer.c \
+	tooltip.c \
 	text.c \
 	value.c \
 	vector.c \
