+/* ---- DurationHelper: Windows.UI.Xaml.Duration arithmetic ---- */
+
+enum { DURATION_AUTOMATIC, DURATION_TIMESPAN, DURATION_FOREVER };
+struct xduration { INT64 span; INT32 type; };
+
+static HRESULT WINAPI duration_Automatic( struct xfiface *iface, struct xduration *value )
+{
+    if (!value) return E_POINTER;
+    value->span = 0;
+    value->type = DURATION_AUTOMATIC;
+    return S_OK;
+}
+
+static HRESULT WINAPI duration_Forever( struct xfiface *iface, struct xduration *value )
+{
+    if (!value) return E_POINTER;
+    value->span = 0;
+    value->type = DURATION_FOREVER;
+    return S_OK;
+}
+
+/* Automatic before any time span, Forever after */
+static int duration_rank( struct xduration d )
+{
+    return d.type == DURATION_AUTOMATIC ? 0 : d.type == DURATION_TIMESPAN ? 1 : 2;
+}
+
+static HRESULT WINAPI duration_Compare( struct xfiface *iface, struct xduration a, struct xduration b, INT32 *value )
+{
+    int ra = duration_rank( a ), rb = duration_rank( b );
+
+    if (!value) return E_POINTER;
+#ifdef SG_MUTANT_DURATION_NO_COMPARE
+    *value = 0;
+    return S_OK;
+#endif
+    if (ra != rb) *value = ra < rb ? -1 : 1;
+    else if (ra == 1) *value = a.span < b.span ? -1 : a.span > b.span ? 1 : 0;
+    else *value = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI duration_FromTimeSpan( struct xfiface *iface, INT64 span, struct xduration *value )
+{
+    if (!value) return E_POINTER;
+    value->span = span;
+    value->type = DURATION_TIMESPAN;
+    return S_OK;
+}
+
+static HRESULT WINAPI duration_GetHasTimeSpan( struct xfiface *iface, struct xduration d, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = d.type == DURATION_TIMESPAN;
+    return S_OK;
+}
+
+/* two time spans: their sum (difference); otherwise Automatic if either is, else Forever */
+static HRESULT combine( struct xduration a, struct xduration b, int sign, struct xduration *value )
+{
+    if (!value) return E_POINTER;
+    value->span = 0;
+    if (a.type == DURATION_TIMESPAN && b.type == DURATION_TIMESPAN)
+    {
+        value->type = DURATION_TIMESPAN;
+        value->span = a.span + sign * b.span;
+    }
+    else value->type = a.type == DURATION_AUTOMATIC || b.type == DURATION_AUTOMATIC ? DURATION_AUTOMATIC : DURATION_FOREVER;
+    return S_OK;
+}
+
+static HRESULT WINAPI duration_Add( struct xfiface *iface, struct xduration a, struct xduration b, struct xduration *value )
+{
+    return combine( a, b, 1, value );
+}
+
+static HRESULT WINAPI duration_Subtract( struct xfiface *iface, struct xduration a, struct xduration b, struct xduration *value )
+{
+    return combine( a, b, -1, value );
+}
+
+static HRESULT WINAPI duration_Equals( struct xfiface *iface, struct xduration a, struct xduration b, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = a.type == b.type && (a.type != DURATION_TIMESPAN || a.span == b.span);
+    return S_OK;
+}
+
+static const void *duration_helper_vtbl[] =
+{
+    IDurationHelperStatics_FSTUBS,
+    [IDurationHelperStatics_Automatic] = duration_Automatic, [IDurationHelperStatics_Forever] = duration_Forever,
+    [IDurationHelperStatics_Compare] = duration_Compare, [IDurationHelperStatics_FromTimeSpan] = duration_FromTimeSpan,
+    [IDurationHelperStatics_GetHasTimeSpan] = duration_GetHasTimeSpan, [IDurationHelperStatics_Add] = duration_Add,
+    [IDurationHelperStatics_Equals] = duration_Equals, [IDurationHelperStatics_Subtract] = duration_Subtract,
+};
