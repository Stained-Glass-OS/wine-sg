From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdi32: CheckColorsInGamut, ColorCorrectPalette

CheckColorsInGamut reports every colour in gamut (one zero byte each) and ColorCorrectPalette leaves the entries as they are: GDI converts no colours (ICM modes are kept as state only), so there is no transform to take colours out of gamut or correct a palette with. Both check their arguments. They were spec stubs; wingdi.h gains their prototypes.
---
--- a/include/wingdi.h
+++ b/include/wingdi.h
@@ -3781,6 +3781,8 @@
 WINGDIAPI INT         WINAPI ChoosePixelFormat(HDC,const PIXELFORMATDESCRIPTOR*);
 WINGDIAPI BOOL        WINAPI Chord(HDC,INT,INT,INT,INT,INT,INT,INT,INT);
 WINGDIAPI HENHMETAFILE WINAPI CloseEnhMetaFile(HDC);
+WINGDIAPI BOOL      WINAPI CheckColorsInGamut(HDC,LPVOID,LPVOID,DWORD);
+WINGDIAPI BOOL      WINAPI ColorCorrectPalette(HDC,HPALETTE,DWORD,DWORD);
 WINGDIAPI BOOL        WINAPI CloseFigure(HDC);
 WINGDIAPI HMETAFILE   WINAPI CloseMetaFile(HDC);
 WINGDIAPI INT         WINAPI CombineRgn(HRGN,HRGN,HRGN,INT);
--- a/dlls/gdi32/icm.c
+++ b/dlls/gdi32/icm.c
@@ -359,3 +359,49 @@
     FIXME( "%p %p %lu: colours left as they are\n", hdc, target, action );
     return TRUE;
 }
+
+
+#ifndef SG_MUTANT_NO_GAMUT
+/***********************************************************************
+ *           CheckColorsInGamut    (GDI32.@)
+ *
+ * (wine-sg 8244) Whether colours are within the device's gamut: one byte per colour, 0 for in gamut. No colour
+ * transform maps colours out of gamut here (ICM converts nothing, see SetICMMode), so every colour is in it.
+ */
+BOOL WINAPI CheckColorsInGamut( HDC hdc, void *colors, void *buffer, DWORD count )
+{
+    TRACE( "%p, %p, %p, %lu\n", hdc, colors, buffer, count );
+
+    if (!hdc || !colors || !buffer || GetObjectType( hdc ) == 0)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    memset( buffer, 0, count );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           ColorCorrectPalette    (GDI32.@)
+ *
+ * The palette entries corrected with the DC's colour transform: with no transform here the entries stay as
+ * they are; the palette and range are checked.
+ */
+BOOL WINAPI ColorCorrectPalette( HDC hdc, HPALETTE palette, DWORD first, DWORD count )
+{
+    WORD entries = 0;
+
+    TRACE( "%p, %p, %lu, %lu\n", hdc, palette, first, count );
+
+    if (!hdc || GetObjectType( hdc ) == 0 || GetObjectType( palette ) != OBJ_PAL ||
+        !GetObjectW( palette, sizeof(entries), &entries ) || first + count > entries || first + count < first)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return TRUE;
+}
+#else
+BOOL WINAPI CheckColorsInGamut( HDC hdc, void *colors, void *buffer, DWORD count ) { return FALSE; }
+BOOL WINAPI ColorCorrectPalette( HDC hdc, HPALETTE palette, DWORD first, DWORD count ) { return FALSE; }
+#endif
--- a/dlls/gdi32/gdi32.spec
+++ b/dlls/gdi32/gdi32.spec
@@ -33,7 +33,7 @@
 @ stdcall BitBlt(long long long long long long long long long)
 @ stub ByeByeGDI
 @ stdcall CancelDC(long)
-@ stub CheckColorsInGamut
+@ stdcall CheckColorsInGamut(ptr ptr ptr long)
 @ stdcall ChoosePixelFormat(long ptr)
 @ stdcall Chord(long long long long long long long long long)
 # @ stub ClearBitmapAttributes
@@ -41,7 +41,7 @@
 @ stdcall CloseEnhMetaFile(long)
 @ stdcall CloseFigure(long)
 @ stdcall CloseMetaFile(long)
-@ stub ColorCorrectPalette
+@ stdcall ColorCorrectPalette(ptr ptr long long)
 @ stdcall ColorMatchToTarget(long long long)
 @ stdcall CombineRgn(long long long long) NtGdiCombineRgn
 @ stdcall CombineTransform(ptr ptr ptr)
