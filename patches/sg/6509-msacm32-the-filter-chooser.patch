From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msacm32: The filter chooser (6509)

acmFilterChooseA/W were stubs. The dialog lists the installed ACM
drivers' filter tags and the chosen tag's filters, honours the
program's hook, template, title, INITTOFILTERSTRUCT and the tag
restriction, and writes the chosen filter and its tag's and its own
names back (ACMERR_NOTPOSSIBLE and the size needed for a buffer too
small; ACMERR_CANCELED). acmFilterTagEnumW read through a NULL driver
when a callback stopped the enumeration.
---
diff --git a/dlls/msacm32/filter.c b/dlls/msacm32/filter.c
index bacb9c0..3c54fb9 100644
--- a/dlls/msacm32/filter.c
+++ b/dlls/msacm32/filter.c
@@ -29,21 +29,211 @@
 #include "mmsystem.h"
 #define NOBITMAP
 #include "mmreg.h"
+#include "winuser.h"
 #include "msacm.h"
+#include "msacmdlg.h"
 #include "msacmdrv.h"
 #include "wineacm.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(msacm);
 
-/***********************************************************************
- *           acmFilterChooseA (MSACM32.@)
- */
-MMRESULT WINAPI acmFilterChooseA(PACMFILTERCHOOSEA pafltrc)
+/* Stained Glass OS (wine-sg 6509): the filter chooser (a stub): the installed ACM drivers'
+ * filter tags, the chosen tag's filters, the program's hook and template; the chosen filter is
+ * written into the program's WAVEFILTER, its tag's and its own names into the structure. */
+struct filter_choose
+{
+    PACMFILTERCHOOSEW afc;
+    HWND hwnd;
+    WCHAR tag_name[ACMFILTERTAGDETAILS_FILTERTAG_CHARS];
+    DWORD tag;
+    HACMDRIVERID hadid;
+    MMRESULT ret;
+    int wanted;            /* the index of the filter wanted (for OK) */
+    int count;
+};
+
+static BOOL CALLBACK filter_choose_tags_cb(HACMDRIVERID hadid, PACMFILTERTAGDETAILSW paftd, DWORD_PTR instance,
+                                           DWORD support)
+{
+    struct filter_choose *fc = (struct filter_choose *)instance;
+    PACMFILTERCHOOSEW afc = fc->afc;
+    LRESULT index;
+
+    if (!paftd->cStandardFilters) return TRUE;
+    if ((afc->fdwEnum & ACM_FILTERENUMF_DWFILTERTAG) && afc->pwfltrEnum &&
+        paftd->dwFilterTag != afc->pwfltrEnum->dwFilterTag)
+        return TRUE;
+    if (SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTERTAG, CB_FINDSTRINGEXACT, -1,
+                            (LPARAM)paftd->szFilterTag) != CB_ERR)
+        return TRUE;
+    index = SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTERTAG, CB_ADDSTRING, 0, (LPARAM)paftd->szFilterTag);
+    if ((afc->fdwStyle & ACMFILTERCHOOSE_STYLEF_INITTOFILTERSTRUCT) && afc->pwfltr &&
+        paftd->dwFilterTag == afc->pwfltr->dwFilterTag)
+        SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTERTAG, CB_SETCURSEL, index, 0);
+    return TRUE;
+}
+
+/* the filters of the tag named fc->tag_name: listed (wanted < 0), or the wanted one written out */
+static BOOL CALLBACK filter_choose_filters_cb(HACMDRIVERID hadid, PACMFILTERTAGDETAILSW paftd, DWORD_PTR instance,
+                                              DWORD support)
+{
+    struct filter_choose *fc = (struct filter_choose *)instance;
+    PACMFILTERCHOOSEW afc = fc->afc;
+    ACMFILTERDETAILSW afd;
+    HACMDRIVER had;
+    DWORD i;
+
+    if (lstrcmpW(paftd->szFilterTag, fc->tag_name)) return TRUE;
+    if (acmDriverOpen(&had, hadid, 0) != MMSYSERR_NOERROR) return TRUE;
+
+    memset(&afd, 0, sizeof(afd));
+    afd.cbStruct = sizeof(afd);
+    afd.dwFilterTag = paftd->dwFilterTag;
+    afd.cbwfltr = paftd->cbFilterSize;
+    if (!(afd.pwfltr = HeapAlloc(MSACM_hHeap, HEAP_ZERO_MEMORY, max(paftd->cbFilterSize, sizeof(WAVEFILTER)))))
+    {
+        acmDriverClose(had, 0);
+        return FALSE;
+    }
+    for (i = 0; i < paftd->cStandardFilters; i++)
+    {
+        afd.dwFilterIndex = i;
+        afd.fdwSupport = 0;
+        afd.pwfltr->cbStruct = paftd->cbFilterSize;
+        afd.pwfltr->dwFilterTag = paftd->dwFilterTag;
+        if (acmFilterDetailsW(had, &afd, ACM_FILTERDETAILSF_INDEX) != MMSYSERR_NOERROR)
+            continue;
+        if (fc->wanted < 0)
+        {
+            LRESULT index = SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTER, CB_ADDSTRING, 0,
+                                                (LPARAM)afd.szFilter);
+            if ((afc->fdwStyle & ACMFILTERCHOOSE_STYLEF_INITTOFILTERSTRUCT) && afc->pwfltr &&
+                afc->cbwfltr >= paftd->cbFilterSize && !memcmp(afd.pwfltr, afc->pwfltr, paftd->cbFilterSize))
+                SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTER, CB_SETCURSEL, index, 0);
+        }
+        else if (fc->count++ == fc->wanted)
+        {
+            if (!afc->pwfltr || afc->cbwfltr < paftd->cbFilterSize)
+            {
+                afc->cbwfltr = paftd->cbFilterSize;
+                fc->ret = ACMERR_NOTPOSSIBLE;
+            }
+            else
+            {
+                memcpy(afc->pwfltr, afd.pwfltr, paftd->cbFilterSize);
+                lstrcpynW(afc->szFilterTag, paftd->szFilterTag, ARRAY_SIZE(afc->szFilterTag));
+                lstrcpynW(afc->szFilter, afd.szFilter, ARRAY_SIZE(afc->szFilter));
+                fc->ret = MMSYSERR_NOERROR;
+            }
+            HeapFree(MSACM_hHeap, 0, afd.pwfltr);
+            acmDriverClose(had, 0);
+            return FALSE;
+        }
+    }
+    HeapFree(MSACM_hHeap, 0, afd.pwfltr);
+    acmDriverClose(had, 0);
+    return TRUE;
+}
+
+static void filter_choose_fill_filters(struct filter_choose *fc)
+{
+    ACMFILTERTAGDETAILSW aftd;
+    LRESULT tag = SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTERTAG, CB_GETCURSEL, 0, 0);
+
+    SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTER, CB_RESETCONTENT, 0, 0);
+    if (tag == CB_ERR) return;
+    SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTERTAG, CB_GETLBTEXT, tag, (LPARAM)fc->tag_name);
+    memset(&aftd, 0, sizeof(aftd));
+    aftd.cbStruct = sizeof(aftd);
+    fc->wanted = -1;
+    acmFilterTagEnumW(NULL, &aftd, filter_choose_filters_cb, (DWORD_PTR)fc, 0);
+    if (SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTER, CB_GETCURSEL, 0, 0) == CB_ERR)
+        SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTER, CB_SETCURSEL, 0, 0);
+}
+
+static MMRESULT filter_choose_result(struct filter_choose *fc)
+{
+    ACMFILTERTAGDETAILSW aftd;
+    LRESULT filter = SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTER, CB_GETCURSEL, 0, 0);
+    WCHAR name[ACMFILTERDETAILS_FILTER_CHARS];
+    LRESULT tag = SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTERTAG, CB_GETCURSEL, 0, 0);
+
+    if (tag == CB_ERR || filter == CB_ERR) return ACMERR_NOTPOSSIBLE;
+    SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTERTAG, CB_GETLBTEXT, tag, (LPARAM)fc->tag_name);
+    SendDlgItemMessageW(fc->hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTER, CB_GETLBTEXT, filter, (LPARAM)name);
+    memset(&aftd, 0, sizeof(aftd));
+    aftd.cbStruct = sizeof(aftd);
+    /* the list is in the drivers' order: the index of the chosen name */
+    fc->wanted = filter;
+    fc->count = 0;
+    fc->ret = ACMERR_NOTPOSSIBLE;
+    acmFilterTagEnumW(NULL, &aftd, filter_choose_filters_cb, (DWORD_PTR)fc, 0);
+    return fc->ret;
+}
+
+static INT_PTR CALLBACK FilterChooseDlgProc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
 {
-    FIXME("(%p): stub\n", pafltrc);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return MMSYSERR_ERROR;
+    struct filter_choose *fc = (struct filter_choose *)GetPropW(hwnd, L"acmfilterprop");
+
+    if (msg == WM_INITDIALOG)
+    {
+        ACMFILTERTAGDETAILSW aftd;
+
+        fc = (struct filter_choose *)lparam;
+        fc->hwnd = hwnd;
+        SetPropW(hwnd, L"acmfilterprop", fc);
+        if (fc->afc->pszTitle) SetWindowTextW(hwnd, fc->afc->pszTitle);
+        memset(&aftd, 0, sizeof(aftd));
+        aftd.cbStruct = sizeof(aftd);
+        acmFilterTagEnumW(NULL, &aftd, filter_choose_tags_cb, (DWORD_PTR)fc, 0);
+        if (SendDlgItemMessageW(hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTERTAG, CB_GETCURSEL, 0, 0) == CB_ERR)
+            SendDlgItemMessageW(hwnd, IDD_ACMFILTERCHOOSE_CMB_FILTERTAG, CB_SETCURSEL, 0, 0);
+        filter_choose_fill_filters(fc);
+        if (!(fc->afc->fdwStyle & ACMFILTERCHOOSE_STYLEF_SHOWHELP))
+            ShowWindow(GetDlgItem(hwnd, IDD_ACMFILTERCHOOSE_BTN_HELP), SW_HIDE);
+        if ((fc->afc->fdwStyle & ACMFILTERCHOOSE_STYLEF_ENABLEHOOK) && fc->afc->pfnHook)
+            fc->afc->pfnHook(hwnd, msg, wparam, fc->afc->lCustData);
+        return TRUE;
+    }
+    if (!fc) return FALSE;
+    if ((fc->afc->fdwStyle & ACMFILTERCHOOSE_STYLEF_ENABLEHOOK) && fc->afc->pfnHook &&
+        fc->afc->pfnHook(hwnd, msg, wparam, lparam))
+        return TRUE;
+
+    switch (msg)
+    {
+    case WM_COMMAND:
+        switch (LOWORD(wparam))
+        {
+        case IDOK:
+#ifdef SG_MUTANT_ACM_FILTER_NOT_RETURNED
+            EndDialog(hwnd, MMSYSERR_NOERROR);
+#else
+            EndDialog(hwnd, filter_choose_result(fc));
+#endif
+            return TRUE;
+        case IDCANCEL:
+            EndDialog(hwnd, ACMERR_CANCELED);
+            return TRUE;
+        case IDD_ACMFILTERCHOOSE_CMB_FILTERTAG:
+            if (HIWORD(wparam) == CBN_SELCHANGE) filter_choose_fill_filters(fc);
+            return TRUE;
+        case IDD_ACMFILTERCHOOSE_BTN_HELP:
+            if (fc->afc->fdwStyle & ACMFILTERCHOOSE_STYLEF_SHOWHELP)
+                SendMessageW(fc->afc->hwndOwner, RegisterWindowMessageW(ACMHELPMSGSTRINGW), 0, 0);
+            return TRUE;
+        }
+        break;
+    case WM_CONTEXTMENU:
+        if (fc->afc->fdwStyle & ACMFILTERCHOOSE_STYLEF_CONTEXTHELP)
+            SendMessageW(fc->afc->hwndOwner, RegisterWindowMessageW(ACMHELPMSGCONTEXTMENUW), wparam, lparam);
+        break;
+    case WM_DESTROY:
+        RemovePropW(hwnd, L"acmfilterprop");
+        break;
+    }
+    return FALSE;
 }
 
 /***********************************************************************
@@ -51,9 +241,75 @@ MMRESULT WINAPI acmFilterChooseA(PACMFILTERCHOOSEA pafltrc)
  */
 MMRESULT WINAPI acmFilterChooseW(PACMFILTERCHOOSEW pafltrc)
 {
-    FIXME("(%p): stub\n", pafltrc);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return MMSYSERR_ERROR;
+    struct filter_choose fc;
+
+    TRACE("(%p)\n", pafltrc);
+
+    if (!pafltrc || pafltrc->cbStruct < sizeof(*pafltrc) || !pafltrc->pwfltr)
+        return MMSYSERR_INVALPARAM;
+    if ((pafltrc->fdwStyle & ACMFILTERCHOOSE_STYLEF_ENABLEHOOK) && !pafltrc->pfnHook)
+        return MMSYSERR_INVALPARAM;
+
+    memset(&fc, 0, sizeof(fc));
+    fc.afc = pafltrc;
+    if (pafltrc->fdwStyle & ACMFILTERCHOOSE_STYLEF_ENABLETEMPLATEHANDLE)
+        return DialogBoxIndirectParamW(MSACM_hInstance32, (LPCDLGTEMPLATEW)pafltrc->hInstance,
+                                       pafltrc->hwndOwner, FilterChooseDlgProc, (LPARAM)&fc);
+    if (pafltrc->fdwStyle & ACMFILTERCHOOSE_STYLEF_ENABLETEMPLATE)
+        return DialogBoxParamW(pafltrc->hInstance, pafltrc->pszTemplateName,
+                               pafltrc->hwndOwner, FilterChooseDlgProc, (LPARAM)&fc);
+    return DialogBoxParamW(MSACM_hInstance32, MAKEINTRESOURCEW(DLG_ACMFILTERCHOOSE_ID),
+                           pafltrc->hwndOwner, FilterChooseDlgProc, (LPARAM)&fc);
+}
+
+/***********************************************************************
+ *           acmFilterChooseA (MSACM32.@)
+ */
+MMRESULT WINAPI acmFilterChooseA(PACMFILTERCHOOSEA pafltrc)
+{
+    ACMFILTERCHOOSEW w;
+    WCHAR *title = NULL, *templ = NULL;
+    MMRESULT ret;
+
+    TRACE("(%p)\n", pafltrc);
+
+    if (!pafltrc || pafltrc->cbStruct < sizeof(*pafltrc)) return MMSYSERR_INVALPARAM;
+    memset(&w, 0, sizeof(w));
+    w.cbStruct = sizeof(w);
+    w.fdwStyle = pafltrc->fdwStyle;
+    w.hwndOwner = pafltrc->hwndOwner;
+    w.pwfltr = pafltrc->pwfltr;
+    w.cbwfltr = pafltrc->cbwfltr;
+    if (pafltrc->pszTitle)
+    {
+        int len = MultiByteToWideChar(CP_ACP, 0, pafltrc->pszTitle, -1, NULL, 0);
+        if ((title = HeapAlloc(MSACM_hHeap, 0, len * sizeof(WCHAR))))
+            MultiByteToWideChar(CP_ACP, 0, pafltrc->pszTitle, -1, title, len);
+        w.pszTitle = title;
+    }
+    w.fdwEnum = pafltrc->fdwEnum;
+    w.pwfltrEnum = pafltrc->pwfltrEnum;
+    w.hInstance = pafltrc->hInstance;
+    if (pafltrc->pszTemplateName && !IS_INTRESOURCE(pafltrc->pszTemplateName))
+    {
+        int len = MultiByteToWideChar(CP_ACP, 0, pafltrc->pszTemplateName, -1, NULL, 0);
+        if ((templ = HeapAlloc(MSACM_hHeap, 0, len * sizeof(WCHAR))))
+            MultiByteToWideChar(CP_ACP, 0, pafltrc->pszTemplateName, -1, templ, len);
+        w.pszTemplateName = templ;
+    }
+    else w.pszTemplateName = (LPCWSTR)pafltrc->pszTemplateName;
+    w.lCustData = pafltrc->lCustData;
+    w.pfnHook = (ACMFILTERCHOOSEHOOKPROCW)pafltrc->pfnHook;
+    ret = acmFilterChooseW(&w);
+    pafltrc->cbwfltr = w.cbwfltr;
+    if (ret == MMSYSERR_NOERROR)
+    {
+        WideCharToMultiByte(CP_ACP, 0, w.szFilterTag, -1, pafltrc->szFilterTag, sizeof(pafltrc->szFilterTag), NULL, NULL);
+        WideCharToMultiByte(CP_ACP, 0, w.szFilter, -1, pafltrc->szFilter, sizeof(pafltrc->szFilter), NULL, NULL);
+    }
+    HeapFree(MSACM_hHeap, 0, title);
+    HeapFree(MSACM_hHeap, 0, templ);
+    return ret;
 }
 
 /***********************************************************************
@@ -443,8 +699,9 @@ MMRESULT WINAPI acmFilterTagEnumW(HACMDRIVER had, PACMFILTERTAGDETAILSW paftd,
 		paftd->dwFilterTagIndex = i;
 		if (acmFilterTagDetailsW(had, paftd, ACM_FILTERTAGDETAILSF_INDEX) == MMSYSERR_NOERROR) {
 		    if (!(fnCallback)((HACMDRIVERID)padid, paftd, dwInstance, padid->fdwSupport)) {
-			padid = NULL;
-			break;
+			/* the callback is done: stop (the loop's next step read through a NULL driver, 6509) */
+			acmDriverClose(had, 0);
+			return MMSYSERR_NOERROR;
 		    }
 		}
 	    }
diff --git a/dlls/msacm32/msacm32.rc b/dlls/msacm32/msacm32.rc
index 06e1345..5c99883 100644
--- a/dlls/msacm32/msacm32.rc
+++ b/dlls/msacm32/msacm32.rc
@@ -53,3 +53,33 @@ BEGIN
     PUSHBUTTON      "Cancel", IDCANCEL, 170, 100, 50, 14
 
 END
+
+DLG_ACMFILTERCHOOSE_ID DIALOG  10, 20, 225, 118
+STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
+CAPTION "Filter Selection"
+FONT 8, "MS Shell Dlg"
+BEGIN
+
+    LTEXT           "&Name:", -1, 5, 5, 115, 8, NOT WS_GROUP
+
+    COMBOBOX        IDD_ACMFILTERCHOOSE_CMB_CUSTOM, 5, 15, 135, 60,
+                    CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
+
+    PUSHBUTTON      "&Save As...", IDD_ACMFILTERCHOOSE_BTN_SETNAME, 150, 14, 70, 14
+    PUSHBUTTON      "&Remove", IDD_ACMFILTERCHOOSE_BTN_DELNAME, 150, 32, 70, 14
+
+    LTEXT           "&Filter:", -1, 5, 56, 44, 8, NOT WS_GROUP
+
+    COMBOBOX        IDD_ACMFILTERCHOOSE_CMB_FILTERTAG, 50, 54, 170, 60,
+                    CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
+
+    LTEXT           "&Attributes:", -1, 5, 76, 44, 8, NOT WS_GROUP
+
+    COMBOBOX        IDD_ACMFILTERCHOOSE_CMB_FILTER, 50, 74, 170, 60,
+                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
+
+    PUSHBUTTON      "&Help", IDD_ACMFILTERCHOOSE_BTN_HELP, 5, 100, 50, 14
+    DEFPUSHBUTTON   "OK", IDOK, 115, 100, 50, 14
+    PUSHBUTTON      "Cancel", IDCANCEL, 170, 100, 50, 14
+
+END
