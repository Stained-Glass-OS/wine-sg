+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * A library is a named set of folders, stored as a .library-ms file (the
+ * documented Library Description Schema, namespace
+ * http://schemas.microsoft.com/windows/2009/library) under FOLDERID_Libraries.
+ * The four standard libraries (Documents, Music, Pictures, Videos) that a
+ * Windows profile is created with are synthesised from their known folders
+ * when their file does not exist yet.
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "objbase.h"
+#include "shlobj.h"
+#include "shobjidl.h"
+#include "shlwapi.h"
+#include "knownfolders.h"
+#include "sddl.h"
+#include "xmllite.h"
+
+#include "shell32_main.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+struct library
+{
+    IShellLibrary IShellLibrary_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    IShellItem **folders;
+    unsigned int count, size;
+    IShellItem *save_private;   /* default save location for the owner */
+    IShellItem *save_public;    /* default save location for other users */
+    LIBRARYOPTIONFLAGS options;
+    FOLDERTYPEID type;
+    WCHAR *icon;
+    WCHAR *name;
+    WCHAR *path;                /* the .library-ms file Commit writes */
+    DWORD mode;
+};
+
+/* IID_IXmlReader (xmllite has no import library to take it from) */
+static const GUID iid_xml_reader = {0x7279fc81,0x709d,0x4095,{0xb6,0x3d,0x69,0xfe,0x4b,0x0d,0x90,0x30}};
+
+static const WCHAR library_ns[] = L"http://schemas.microsoft.com/windows/2009/library";
+
+static inline struct library *impl_from_IShellLibrary(IShellLibrary *iface)
+{
+    return CONTAINING_RECORD(iface, struct library, IShellLibrary_iface);
+}
+
+static WCHAR *strdupW(const WCHAR *s)
+{
+    WCHAR *ret;
+    if (!s) return NULL;
+    if ((ret = malloc((wcslen(s) + 1) * sizeof(WCHAR)))) wcscpy(ret, s);
+    return ret;
+}
+
+static void set_item(IShellItem **slot, IShellItem *item)
+{
+    if (item) IShellItem_AddRef(item);
+    if (*slot) IShellItem_Release(*slot);
+    *slot = item;
+}
+
+static BOOL same_item(IShellItem *a, IShellItem *b)
+{
+    int order = 1;
+    if (!a || !b) return FALSE;
+    if (a == b) return TRUE;
+    return SUCCEEDED(IShellItem_Compare(a, b, SICHINT_CANONICAL | SICHINT_TEST_FILESYSPATH_IF_NOT_EQUAL, &order))
+           && !order;
+}
+
+static int find_folder(struct library *lib, IShellItem *item)
+{
+    unsigned int i;
+    for (i = 0; i < lib->count; i++) if (same_item(lib->folders[i], item)) return i;
+    return -1;
+}
+
+static HRESULT add_folder(struct library *lib, IShellItem *item)
+{
+    if (find_folder(lib, item) >= 0) return S_OK;
+    if (lib->count == lib->size)
+    {
+        unsigned int size = max(4, lib->size * 2);
+        IShellItem **folders = realloc(lib->folders, size * sizeof(*folders));
+        if (!folders) return E_OUTOFMEMORY;
+        lib->folders = folders;
+        lib->size = size;
+    }
+    IShellItem_AddRef(item);
+    lib->folders[lib->count++] = item;
+    /* the first folder of a library is where it saves until told otherwise */
+    if (!lib->save_private) set_item(&lib->save_private, item);
+    return S_OK;
+}
+
+static void clear_library(struct library *lib)
+{
+    unsigned int i;
+    for (i = 0; i < lib->count; i++) IShellItem_Release(lib->folders[i]);
+    lib->count = 0;
+    set_item(&lib->save_private, NULL);
+    set_item(&lib->save_public, NULL);
+    lib->options = LOF_DEFAULT;
+    lib->type = GUID_NULL;
+    free(lib->icon);
+    lib->icon = NULL;
+    free(lib->name);
+    lib->name = NULL;
+    free(lib->path);
+    lib->path = NULL;
+}
+
+static HRESULT item_path(IShellItem *item, WCHAR **path)
+{
+    return IShellItem_GetDisplayName(item, SIGDN_FILESYSPATH, path);
+}
+
+static HRESULT known_folder_path(REFKNOWNFOLDERID id, WCHAR **path)
+{
+    IKnownFolderManager *manager;
+    KNOWNFOLDER_DEFINITION def;
+    IKnownFolder *folder;
+    WCHAR *parent;
+    HRESULT hr;
+    size_t len;
+
+    /* the CSIDL-backed folders */
+    if (SUCCEEDED(hr = SHGetKnownFolderPath(id, KF_FLAG_DONT_VERIFY, NULL, path))) return hr;
+    /* the libraries and their parents are known folder definitions relative to a CSIDL-backed one */
+    if (FAILED(CoCreateInstance(&CLSID_KnownFolderManager, NULL, CLSCTX_INPROC_SERVER,
+                                &IID_IKnownFolderManager, (void **)&manager))) return hr;
+    if (SUCCEEDED(hr = IKnownFolderManager_GetFolder(manager, id, &folder)))
+    {
+        if (SUCCEEDED(hr = IKnownFolder_GetFolderDefinition(folder, &def)))
+        {
+            if (IsEqualGUID(&def.fidParent, &GUID_NULL) || !def.pszRelativePath)
+                hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+            else if (SUCCEEDED(hr = known_folder_path(&def.fidParent, &parent)))
+            {
+                len = wcslen(parent) + wcslen(def.pszRelativePath) + 2;
+                if (!(*path = CoTaskMemAlloc(len * sizeof(WCHAR)))) hr = E_OUTOFMEMORY;
+                else swprintf(*path, len, L"%s\\%s", parent, def.pszRelativePath);
+                CoTaskMemFree(parent);
+            }
+            FreeKnownFolderDefinitionFields(&def);
+        }
+        IKnownFolder_Release(folder);
+    }
+    IKnownFolderManager_Release(manager);
+    return hr;
+}
+
+static HRESULT item_from_path(const WCHAR *path, IShellItem **item)
+{
+    return SHCreateItemFromParsingName(path, NULL, &IID_IShellItem, (void **)item);
+}
+
+/* a <url> of a search connector: "knownfolder:{guid}", a file: URL or a path */
+static HRESULT item_from_url(const WCHAR *url, IShellItem **item)
+{
+    WCHAR buf[MAX_PATH], *path = NULL;
+    DWORD len = ARRAY_SIZE(buf);
+    HRESULT hr;
+    GUID id;
+
+    if (!wcsnicmp(url, L"knownfolder:", 12))
+    {
+        if (CLSIDFromString(url + 12, &id)) return E_INVALIDARG;
+        if (FAILED(hr = known_folder_path(&id, &path))) return hr;
+        hr = item_from_path(path, item);
+        CoTaskMemFree(path);
+        return hr;
+    }
+    if (!wcsnicmp(url, L"file:", 5))
+    {
+        if (FAILED(hr = PathCreateFromUrlW(url, buf, &len, 0))) return hr;
+        return item_from_path(buf, item);
+    }
+    return item_from_path(url, item);
+}
+
+/***********************************************************************
+ * Reading a .library-ms file
+ */
+
+struct connector
+{
+    WCHAR *url;
+    BOOL save_private, save_public;
+};
+
+static WCHAR *read_value(IXmlReader *reader)
+{
+    const WCHAR *value;
+    XmlNodeType type;
+    WCHAR *ret = NULL;
+    UINT len;
+
+    if (IXmlReader_IsEmptyElement(reader)) return strdupW(L"");
+    while (IXmlReader_Read(reader, &type) == S_OK)
+    {
+        if (type == XmlNodeType_Text || type == XmlNodeType_CDATA || type == XmlNodeType_Whitespace)
+        {
+            if (FAILED(IXmlReader_GetValue(reader, &value, &len))) break;
+            if (!ret) ret = strdupW(value);
+        }
+        else if (type == XmlNodeType_EndElement) break;
+        else if (type == XmlNodeType_Element) break; /* unexpected child, give up on this value */
+    }
+    if (ret) StrTrimW(ret, L" \t\r\n");
+    return ret ? ret : strdupW(L"");
+}
+
+static BOOL is_true(const WCHAR *s)
+{
+    return s && (!wcsicmp(s, L"true") || !wcscmp(s, L"1"));
+}
+
+static void end_connector(struct library *lib, struct connector *c)
+{
+    IShellItem *item;
+
+    if (c->url && SUCCEEDED(item_from_url(c->url, &item)))
+    {
+        add_folder(lib, item);
+#ifndef SG_MUTANT_SHLIB_FIRST_DEFAULT
+        if (c->save_private) set_item(&lib->save_private, item);
+#endif
+        if (c->save_public) set_item(&lib->save_public, item);
+        IShellItem_Release(item);
+    }
+    else if (c->url) WARN("dropping location %s\n", debugstr_w(c->url));
+    free(c->url);
+    memset(c, 0, sizeof(*c));
+}
+
+static HRESULT load_file(struct library *lib, const WCHAR *path)
+{
+    BOOL in_connector = FALSE, root = FALSE;
+    struct connector c = {0};
+    IXmlReader *reader;
+    const WCHAR *local, *uri;
+    XmlNodeType type;
+    IStream *stream;
+    WCHAR *value;
+    HRESULT hr;
+    GUID guid;
+
+    if (FAILED(hr = SHCreateStreamOnFileEx(path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream)))
+        return hr;
+    if (FAILED(hr = CreateXmlReader(&iid_xml_reader, (void **)&reader, NULL)))
+    {
+        IStream_Release(stream);
+        return hr;
+    }
+    IXmlReader_SetProperty(reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit);
+    if (FAILED(hr = IXmlReader_SetInput(reader, (IUnknown *)stream))) goto done;
+
+    while ((hr = IXmlReader_Read(reader, &type)) == S_OK)
+    {
+        if (type == XmlNodeType_EndElement)
+        {
+            IXmlReader_GetLocalName(reader, &local, NULL);
+            if (in_connector && !wcscmp(local, L"searchConnectorDescription"))
+            {
+                end_connector(lib, &c);
+                in_connector = FALSE;
+            }
+            continue;
+        }
+        if (type != XmlNodeType_Element) continue;
+        IXmlReader_GetLocalName(reader, &local, NULL);
+        IXmlReader_GetNamespaceUri(reader, &uri, NULL);
+        if (wcscmp(uri, library_ns)) continue;
+
+        if (!root)
+        {
+            if (wcscmp(local, L"libraryDescription")) { hr = E_FAIL; goto done; }
+            root = TRUE;
+            continue;
+        }
+        if (!wcscmp(local, L"searchConnectorDescription"))
+        {
+            if (in_connector) end_connector(lib, &c);
+            in_connector = !IXmlReader_IsEmptyElement(reader);
+            continue;
+        }
+        if (in_connector)
+        {
+            if (!wcscmp(local, L"url"))
+            {
+                free(c.url);
+                c.url = read_value(reader);
+            }
+            else if (!wcscmp(local, L"isDefaultSaveLocation"))
+            {
+                value = read_value(reader);
+                c.save_private = is_true(value);
+                free(value);
+            }
+            else if (!wcscmp(local, L"isDefaultNonOwnerSaveLocation"))
+            {
+                value = read_value(reader);
+                c.save_public = is_true(value);
+                free(value);
+            }
+            continue;
+        }
+        if (!wcscmp(local, L"name"))
+        {
+            free(lib->name);
+            lib->name = read_value(reader);
+        }
+        else if (!wcscmp(local, L"iconReference"))
+        {
+            free(lib->icon);
+            lib->icon = read_value(reader);
+        }
+        else if (!wcscmp(local, L"isLibraryPinned"))
+        {
+            value = read_value(reader);
+            lib->options = is_true(value) ? LOF_PINNEDTONAVPANE : LOF_DEFAULT;
+            free(value);
+        }
+        else if (!wcscmp(local, L"folderType"))
+        {
+            value = read_value(reader);
+            if (value && !CLSIDFromString(value, &guid)) lib->type = guid;
+            free(value);
+        }
+    }
+    if (in_connector) end_connector(lib, &c);
+    /* without an explicit default the first location is it (add_folder set it) */
+    hr = root ? S_OK : E_FAIL;
+
+done:
+    if (FAILED(hr)) WARN("%s: not a library description (%#lx)\n", debugstr_w(path), hr);
+    IXmlReader_Release(reader);
+    IStream_Release(stream);
+    return hr;
+}
+
+/***********************************************************************
+ * Writing a .library-ms file
+ */
+
+struct buffer
+{
+    WCHAR *data;
+    size_t len, size;
+    BOOL failed;
+};
+
+static void put(struct buffer *b, const WCHAR *s)
+{
+    size_t n = wcslen(s);
+    if (b->failed) return;
+    if (b->len + n + 1 > b->size)
+    {
+        size_t size = max(b->size * 2, b->len + n + 256);
+        WCHAR *data = realloc(b->data, size * sizeof(WCHAR));
+        if (!data) { b->failed = TRUE; return; }
+        b->data = data;
+        b->size = size;
+    }
+    memcpy(b->data + b->len, s, n * sizeof(WCHAR));
+    b->len += n;
+    b->data[b->len] = 0;
+}
+
+static void put_escaped(struct buffer *b, const WCHAR *s)
+{
+    WCHAR one[2] = {0};
+#ifdef SG_MUTANT_SHLIB_NO_ESCAPE
+    put(b, s);
+    return;
+#endif
+    for (; *s; s++)
+    {
+        switch (*s)
+        {
+        case '&': put(b, L"&amp;"); break;
+        case '<': put(b, L"&lt;"); break;
+        case '>': put(b, L"&gt;"); break;
+        case '"': put(b, L"&quot;"); break;
+        default: one[0] = *s; put(b, one); break;
+        }
+    }
+}
+
+static void put_element(struct buffer *b, const WCHAR *indent, const WCHAR *name, const WCHAR *value)
+{
+    put(b, indent);
+    put(b, L"<");
+    put(b, name);
+    put(b, L">");
+    put_escaped(b, value);
+    put(b, L"</");
+    put(b, name);
+    put(b, L">\r\n");
+}
+
+static WCHAR *user_sid(void)
+{
+    char buf[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE];
+    TOKEN_USER *user = (TOKEN_USER *)buf;
+    WCHAR *str = NULL, *ret;
+    HANDLE token;
+    DWORD len;
+
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return NULL;
+    if (GetTokenInformation(token, TokenUser, buf, sizeof(buf), &len))
+        ConvertSidToStringSidW(user->User.Sid, &str);
+    CloseHandle(token);
+    ret = strdupW(str);
+    LocalFree(str);
+    return ret;
+}
+
+static HRESULT write_file(struct library *lib, const WCHAR *path, BOOL fail_if_exists)
+{
+    struct buffer b = {0};
+    WCHAR guid[39], *sid, *folder;
+    IShellItem *private, *public;
+    HRESULT hr = S_OK;
+    unsigned int i;
+    HANDLE file;
+    char *utf8;
+    DWORD len, written;
+
+    private = lib->save_private ? lib->save_private : (lib->count ? lib->folders[0] : NULL);
+    public = lib->save_public ? lib->save_public : private;
+
+    put(&b, L"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<libraryDescription xmlns=\"");
+    put(&b, library_ns);
+    put(&b, L"\">\r\n");
+    if (lib->name) put_element(&b, L"  ", L"name", lib->name);
+    if ((sid = user_sid()))
+    {
+        put_element(&b, L"  ", L"ownerSID", sid);
+        free(sid);
+    }
+    put_element(&b, L"  ", L"version", L"1");
+    put_element(&b, L"  ", L"isLibraryPinned", lib->options & LOF_PINNEDTONAVPANE ? L"true" : L"false");
+    if (lib->icon) put_element(&b, L"  ", L"iconReference", lib->icon);
+    if (!IsEqualGUID(&lib->type, &GUID_NULL))
+    {
+        StringFromGUID2(&lib->type, guid, ARRAY_SIZE(guid));
+        put(&b, L"  <templateInfo>\r\n");
+        put_element(&b, L"    ", L"folderType", guid);
+        put(&b, L"  </templateInfo>\r\n");
+    }
+    put(&b, L"  <searchConnectorDescriptionList>\r\n");
+    for (i = 0; i < lib->count; i++)
+    {
+        if (FAILED(item_path(lib->folders[i], &folder))) continue;
+        put(&b, L"    <searchConnectorDescription>\r\n");
+        if (same_item(lib->folders[i], private))
+            put_element(&b, L"      ", L"isDefaultSaveLocation", L"true");
+        if (same_item(lib->folders[i], public))
+            put_element(&b, L"      ", L"isDefaultNonOwnerSaveLocation", L"true");
+        put(&b, L"      <simpleLocation>\r\n");
+        put_element(&b, L"        ", L"url", folder);
+        put(&b, L"      </simpleLocation>\r\n");
+        put(&b, L"    </searchConnectorDescription>\r\n");
+        CoTaskMemFree(folder);
+    }
+    put(&b, L"  </searchConnectorDescriptionList>\r\n</libraryDescription>\r\n");
+    if (b.failed)
+    {
+        free(b.data);
+        return E_OUTOFMEMORY;
+    }
+
+    len = WideCharToMultiByte(CP_UTF8, 0, b.data, b.len, NULL, 0, NULL, NULL);
+    if (!(utf8 = malloc(len + 1)))
+    {
+        free(b.data);
+        return E_OUTOFMEMORY;
+    }
+    WideCharToMultiByte(CP_UTF8, 0, b.data, b.len, utf8, len, NULL, NULL);
+    free(b.data);
+
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, fail_if_exists ? CREATE_NEW : CREATE_ALWAYS,
+                       FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) hr = HRESULT_FROM_WIN32(GetLastError());
+    else
+    {
+        if (!WriteFile(file, utf8, len, &written, NULL) || written != len)
+            hr = HRESULT_FROM_WIN32(GetLastError());
+        CloseHandle(file);
+    }
+    free(utf8);
+    TRACE("%s: %#lx\n", debugstr_w(path), hr);
+    return hr;
+}
+
+/***********************************************************************
+ * The standard libraries
+ */
+
+static const struct
+{
+    const KNOWNFOLDERID *library, *private, *public, *type;
+    const WCHAR *icon;
+}
+standard_libraries[] =
+{
+    { &FOLDERID_DocumentsLibrary, &FOLDERID_Documents, &FOLDERID_PublicDocuments, &FOLDERTYPEID_Documents,
+      L"imageres.dll,-1002" },
+    { &FOLDERID_MusicLibrary, &FOLDERID_Music, &FOLDERID_PublicMusic, &FOLDERTYPEID_Music,
+      L"imageres.dll,-1004" },
+    { &FOLDERID_PicturesLibrary, &FOLDERID_Pictures, &FOLDERID_PublicPictures, &FOLDERTYPEID_Pictures,
+      L"imageres.dll,-1003" },
+    { &FOLDERID_VideosLibrary, &FOLDERID_Videos, &FOLDERID_PublicVideos, &FOLDERTYPEID_Videos,
+      L"imageres.dll,-1005" },
+};
+
+static void add_known_folder(struct library *lib, REFKNOWNFOLDERID id, IShellItem **slot)
+{
+    IShellItem *item;
+    WCHAR *path;
+    DWORD attrs;
+
+    if (FAILED(known_folder_path(id, &path))) return;
+    attrs = GetFileAttributesW(path);
+    if (attrs != INVALID_FILE_ATTRIBUTES && (attrs & FILE_ATTRIBUTE_DIRECTORY) && SUCCEEDED(item_from_path(path, &item)))
+    {
+        add_folder(lib, item);
+        set_item(slot, item);
+        IShellItem_Release(item);
+    }
+    CoTaskMemFree(path);
+}
+
+static BOOL load_standard(struct library *lib, REFKNOWNFOLDERID id)
+{
+    IKnownFolderManager *manager;
+    KNOWNFOLDER_DEFINITION def;
+    IKnownFolder *folder;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(standard_libraries); i++)
+        if (IsEqualGUID(id, standard_libraries[i].library)) break;
+    if (i == ARRAY_SIZE(standard_libraries)) return FALSE;
+
+    add_known_folder(lib, standard_libraries[i].private, &lib->save_private);
+    add_known_folder(lib, standard_libraries[i].public, &lib->save_public);
+    lib->type = *standard_libraries[i].type;
+    lib->icon = strdupW(standard_libraries[i].icon);
+    lib->options = LOF_PINNEDTONAVPANE;
+
+    if (SUCCEEDED(CoCreateInstance(&CLSID_KnownFolderManager, NULL, CLSCTX_INPROC_SERVER,
+                                   &IID_IKnownFolderManager, (void **)&manager)))
+    {
+        if (SUCCEEDED(IKnownFolderManager_GetFolder(manager, id, &folder)))
+        {
+            if (SUCCEEDED(IKnownFolder_GetFolderDefinition(folder, &def)))
+            {
+                lib->name = strdupW(def.pszName);
+                FreeKnownFolderDefinitionFields(&def);
+            }
+            IKnownFolder_Release(folder);
+        }
+        IKnownFolderManager_Release(manager);
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ * IShellLibrary
+ */
+
+static HRESULT WINAPI library_QueryInterface(IShellLibrary *iface, REFIID riid, void **out)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+
+    TRACE("(%p, %s, %p)\n", lib, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IShellLibrary))
+    {
+        *out = &lib->IShellLibrary_iface;
+        IShellLibrary_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    TRACE("no interface %s\n", debugstr_guid(riid));
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI library_AddRef(IShellLibrary *iface)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    ULONG ref = InterlockedIncrement(&lib->ref);
+    TRACE("(%p) ref %lu\n", lib, ref);
+    return ref;
+}
+
+static ULONG WINAPI library_Release(IShellLibrary *iface)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    ULONG ref = InterlockedDecrement(&lib->ref);
+
+    TRACE("(%p) ref %lu\n", lib, ref);
+    if (!ref)
+    {
+        clear_library(lib);
+        free(lib->folders);
+        lib->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&lib->cs);
+        free(lib);
+    }
+    return ref;
+}
+
+static HRESULT load_path(struct library *lib, const WCHAR *path, DWORD mode)
+{
+    HRESULT hr;
+
+    clear_library(lib);
+    if (FAILED(hr = load_file(lib, path)))
+    {
+        clear_library(lib);
+        return hr;
+    }
+    lib->path = strdupW(path);
+    lib->mode = mode;
+    return S_OK;
+}
+
+static HRESULT WINAPI library_LoadLibraryFromItem(IShellLibrary *iface, IShellItem *item, DWORD mode)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    WCHAR *path;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %#lx)\n", lib, item, mode);
+
+    if (!item) return E_INVALIDARG;
+    if (FAILED(hr = item_path(item, &path))) return hr;
+    EnterCriticalSection(&lib->cs);
+    hr = load_path(lib, path, mode);
+    LeaveCriticalSection(&lib->cs);
+    CoTaskMemFree(path);
+    return hr;
+}
+
+static HRESULT WINAPI library_LoadLibraryFromKnownFolder(IShellLibrary *iface, REFKNOWNFOLDERID id, DWORD mode)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    WCHAR *path;
+    DWORD attrs;
+    HRESULT hr;
+
+    TRACE("(%p, %s, %#lx)\n", lib, debugstr_guid(id), mode);
+
+    if (!id) return E_INVALIDARG;
+    if (FAILED(hr = known_folder_path(id, &path))) return hr;
+    EnterCriticalSection(&lib->cs);
+    attrs = GetFileAttributesW(path);
+    if (attrs != INVALID_FILE_ATTRIBUTES && (attrs & FILE_ATTRIBUTE_DIRECTORY))
+        hr = E_INVALIDARG;  /* a folder, not a library */
+    else if (attrs != INVALID_FILE_ATTRIBUTES)
+        hr = load_path(lib, path, mode);
+    else
+    {
+        clear_library(lib);
+        if (load_standard(lib, id))
+        {
+            lib->path = strdupW(path);
+            lib->mode = mode;
+            hr = S_OK;
+        }
+        else hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    }
+    LeaveCriticalSection(&lib->cs);
+    CoTaskMemFree(path);
+    return hr;
+}
+
+static HRESULT WINAPI library_AddFolder(IShellLibrary *iface, IShellItem *item)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    HRESULT hr;
+
+    TRACE("(%p, %p)\n", lib, item);
+
+    if (!item) return E_INVALIDARG;
+    EnterCriticalSection(&lib->cs);
+    hr = add_folder(lib, item);
+    LeaveCriticalSection(&lib->cs);
+    return hr;
+}
+
+static HRESULT WINAPI library_RemoveFolder(IShellLibrary *iface, IShellItem *item)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    IShellItem *removed;
+    HRESULT hr = S_OK;
+    int i;
+
+    TRACE("(%p, %p)\n", lib, item);
+
+    if (!item) return E_INVALIDARG;
+    EnterCriticalSection(&lib->cs);
+    if ((i = find_folder(lib, item)) < 0) hr = HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    else
+    {
+        removed = lib->folders[i];
+        memmove(lib->folders + i, lib->folders + i + 1, (lib->count - i - 1) * sizeof(*lib->folders));
+        lib->count--;
+        if (same_item(lib->save_private, removed))
+            set_item(&lib->save_private, lib->count ? lib->folders[0] : NULL);
+        if (same_item(lib->save_public, removed))
+            set_item(&lib->save_public, NULL);
+        IShellItem_Release(removed);
+    }
+    LeaveCriticalSection(&lib->cs);
+    return hr;
+}
+
+static HRESULT WINAPI library_GetFolders(IShellLibrary *iface, LIBRARYFOLDERFILTER filter, REFIID riid, void **out)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    IShellItemArray *array;
+    IShellItem **items;
+    unsigned int i, n = 0;
+    SFGAOF attrs;
+    HRESULT hr;
+
+    TRACE("(%p, %d, %s, %p)\n", lib, filter, debugstr_guid(riid), out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (filter < LFF_FORCEFILESYSTEM || filter > LFF_ALLITEMS) return E_INVALIDARG;
+
+    EnterCriticalSection(&lib->cs);
+    if (!(items = malloc(max(lib->count, 1) * sizeof(*items))))
+    {
+        LeaveCriticalSection(&lib->cs);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < lib->count; i++)
+    {
+        if (filter != LFF_ALLITEMS)
+        {
+            attrs = 0;
+            IShellItem_GetAttributes(lib->folders[i], SFGAO_FILESYSTEM | SFGAO_STORAGE, &attrs);
+            if (filter == LFF_FORCEFILESYSTEM && !(attrs & SFGAO_FILESYSTEM)) continue;
+            if (filter == LFF_STORAGEITEMS && !(attrs & (SFGAO_FILESYSTEM | SFGAO_STORAGE))) continue;
+        }
+        items[n++] = lib->folders[i];
+    }
+    hr = shell_item_array_create(items, n, &array);
+    LeaveCriticalSection(&lib->cs);
+    free(items);
+    if (FAILED(hr)) return hr;
+    hr = IShellItemArray_QueryInterface(array, riid, out);
+    IShellItemArray_Release(array);
+    return hr;
+}
+
+static HRESULT WINAPI library_ResolveFolder(IShellLibrary *iface, IShellItem *item, DWORD timeout,
+                                            REFIID riid, void **out)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    IShellItem *found = NULL;
+    WCHAR *path;
+    HRESULT hr;
+    int i;
+
+    TRACE("(%p, %p, %lu, %s, %p)\n", lib, item, timeout, debugstr_guid(riid), out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!item) return E_INVALIDARG;
+
+    EnterCriticalSection(&lib->cs);
+    if ((i = find_folder(lib, item)) >= 0) IShellItem_AddRef(found = lib->folders[i]);
+    LeaveCriticalSection(&lib->cs);
+    if (!found) return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+
+    /* a location is resolved when it is there; nothing moves folders around for us to follow */
+    if (SUCCEEDED(hr = item_path(found, &path)))
+    {
+        if (GetFileAttributesW(path) == INVALID_FILE_ATTRIBUTES) hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+        CoTaskMemFree(path);
+    }
+    if (SUCCEEDED(hr)) hr = IShellItem_QueryInterface(found, riid, out);
+    IShellItem_Release(found);
+    return hr;
+}
+
+static HRESULT WINAPI library_GetDefaultSaveFolder(IShellLibrary *iface, DEFAULTSAVEFOLDERTYPE type,
+                                                   REFIID riid, void **out)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    IShellItem *item;
+    HRESULT hr;
+
+    TRACE("(%p, %d, %s, %p)\n", lib, type, debugstr_guid(riid), out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (type < DSFT_DETECT || type > DSFT_PUBLIC) return E_INVALIDARG;
+
+    EnterCriticalSection(&lib->cs);
+    /* the caller owns every library it opens here, so "detect" is the owner's location */
+    item = type == DSFT_PUBLIC && lib->save_public ? lib->save_public : lib->save_private;
+    if (item) IShellItem_AddRef(item);
+    LeaveCriticalSection(&lib->cs);
+    if (!item) return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    hr = IShellItem_QueryInterface(item, riid, out);
+    IShellItem_Release(item);
+    return hr;
+}
+
+static HRESULT WINAPI library_SetDefaultSaveFolder(IShellLibrary *iface, DEFAULTSAVEFOLDERTYPE type, IShellItem *item)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("(%p, %d, %p)\n", lib, type, item);
+
+    if (!item || type < DSFT_DETECT || type > DSFT_PUBLIC) return E_INVALIDARG;
+    EnterCriticalSection(&lib->cs);
+    if (find_folder(lib, item) < 0) hr = add_folder(lib, item);
+    if (SUCCEEDED(hr)) set_item(type == DSFT_PUBLIC ? &lib->save_public : &lib->save_private, item);
+    LeaveCriticalSection(&lib->cs);
+    return hr;
+}
+
+static HRESULT WINAPI library_GetOptions(IShellLibrary *iface, LIBRARYOPTIONFLAGS *options)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+
+    TRACE("(%p, %p)\n", lib, options);
+
+    if (!options) return E_POINTER;
+    *options = lib->options;
+    return S_OK;
+}
+
+static HRESULT WINAPI library_SetOptions(IShellLibrary *iface, LIBRARYOPTIONFLAGS mask, LIBRARYOPTIONFLAGS options)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+
+    TRACE("(%p, %#x, %#x)\n", lib, mask, options);
+
+    if ((mask | options) & ~LOF_MASK_ALL) return E_INVALIDARG;
+    EnterCriticalSection(&lib->cs);
+    lib->options = (lib->options & ~mask) | (options & mask);
+    LeaveCriticalSection(&lib->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI library_GetFolderType(IShellLibrary *iface, FOLDERTYPEID *type)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+
+    TRACE("(%p, %p)\n", lib, type);
+
+    if (!type) return E_POINTER;
+    *type = lib->type;
+    return S_OK;
+}
+
+static HRESULT WINAPI library_SetFolderType(IShellLibrary *iface, REFFOLDERTYPEID type)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+
+    TRACE("(%p, %s)\n", lib, debugstr_guid(type));
+
+    if (!type) return E_INVALIDARG;
+    lib->type = *type;
+    return S_OK;
+}
+
+static HRESULT WINAPI library_GetIcon(IShellLibrary *iface, LPWSTR *icon)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    HRESULT hr;
+
+    TRACE("(%p, %p)\n", lib, icon);
+
+    if (!icon) return E_POINTER;
+    EnterCriticalSection(&lib->cs);
+    hr = SHStrDupW(lib->icon ? lib->icon : L"", icon);
+    LeaveCriticalSection(&lib->cs);
+    return hr;
+}
+
+static HRESULT WINAPI library_SetIcon(IShellLibrary *iface, LPCWSTR icon)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    WCHAR *copy = NULL;
+
+    TRACE("(%p, %s)\n", lib, debugstr_w(icon));
+
+    if (icon && *icon && !(copy = strdupW(icon))) return E_OUTOFMEMORY;
+    EnterCriticalSection(&lib->cs);
+    free(lib->icon);
+    lib->icon = copy;
+    LeaveCriticalSection(&lib->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI library_Commit(IShellLibrary *iface)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    HRESULT hr;
+
+    TRACE("(%p)\n", lib);
+
+    EnterCriticalSection(&lib->cs);
+    if (!lib->path) hr = E_UNEXPECTED;  /* never loaded or saved: Save() names its file */
+    else if (!(lib->mode & (STGM_WRITE | STGM_READWRITE))) hr = STG_E_ACCESSDENIED;
+    else hr = write_file(lib, lib->path, FALSE);
+    LeaveCriticalSection(&lib->cs);
+    return hr;
+}
+
+static HRESULT save_in(struct library *lib, const WCHAR *dir, const WCHAR *name, LIBRARYSAVEFLAGS flags,
+                       IShellItem **saved)
+{
+    WCHAR *path;
+    size_t len;
+    HRESULT hr;
+    unsigned int n;
+
+    if (saved) *saved = NULL;
+    if (!name || !*name || wcspbrk(name, L"\\/:*?\"<>|")) return E_INVALIDARG;
+    if (flags & ~(LSF_OVERRIDEEXISTING | LSF_MAKEUNIQUENAME)) return E_INVALIDARG;
+
+    len = wcslen(dir) + wcslen(name) + 32;
+    if (!(path = malloc(len * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    CreateDirectoryW(dir, NULL);
+
+    EnterCriticalSection(&lib->cs);
+    swprintf(path, len, L"%s\\%s.library-ms", dir, name);
+    if (flags & LSF_MAKEUNIQUENAME)
+    {
+        for (n = 2; GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES && n < 10000; n++)
+            swprintf(path, len, L"%s\\%s (%u).library-ms", dir, name, n);
+    }
+    if (!lib->name) lib->name = strdupW(name);
+    hr = write_file(lib, path, !(flags & (LSF_OVERRIDEEXISTING | LSF_MAKEUNIQUENAME)));
+    if (hr == HRESULT_FROM_WIN32(ERROR_FILE_EXISTS)) hr = HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS);
+    if (SUCCEEDED(hr))
+    {
+        free(lib->path);
+        lib->path = strdupW(path);
+        lib->mode = STGM_READWRITE;
+    }
+    LeaveCriticalSection(&lib->cs);
+
+    if (SUCCEEDED(hr) && saved) hr = item_from_path(path, saved);
+    free(path);
+    return hr;
+}
+
+static HRESULT WINAPI library_Save(IShellLibrary *iface, IShellItem *folder, LPCWSTR name,
+                                   LIBRARYSAVEFLAGS flags, IShellItem **saved)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    WCHAR *dir;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %s, %#x, %p)\n", lib, folder, debugstr_w(name), flags, saved);
+
+    if (!folder) return IShellLibrary_SaveInKnownFolder(iface, &FOLDERID_Libraries, name, flags, saved);
+    if (FAILED(hr = item_path(folder, &dir))) return hr;
+    hr = save_in(lib, dir, name, flags, saved);
+    CoTaskMemFree(dir);
+    return hr;
+}
+
+static HRESULT WINAPI library_SaveInKnownFolder(IShellLibrary *iface, REFKNOWNFOLDERID id, LPCWSTR name,
+                                                LIBRARYSAVEFLAGS flags, IShellItem **saved)
+{
+    struct library *lib = impl_from_IShellLibrary(iface);
+    WCHAR *dir;
+    HRESULT hr;
+
+    TRACE("(%p, %s, %s, %#x, %p)\n", lib, debugstr_guid(id), debugstr_w(name), flags, saved);
+
+    if (!id) return E_INVALIDARG;
+    if (FAILED(hr = known_folder_path(id, &dir))) return hr;
+    if (IsEqualGUID(id, &FOLDERID_Libraries)) SHCreateDirectoryExW(NULL, dir, NULL);
+    hr = save_in(lib, dir, name, flags, saved);
+    CoTaskMemFree(dir);
+    return hr;
+}
+
+static const IShellLibraryVtbl library_vtbl =
+{
+    library_QueryInterface,
+    library_AddRef,
+    library_Release,
+    library_LoadLibraryFromItem,
+    library_LoadLibraryFromKnownFolder,
+    library_AddFolder,
+    library_RemoveFolder,
+    library_GetFolders,
+    library_ResolveFolder,
+    library_GetDefaultSaveFolder,
+    library_SetDefaultSaveFolder,
+    library_GetOptions,
+    library_SetOptions,
+    library_GetFolderType,
+    library_SetFolderType,
+    library_GetIcon,
+    library_SetIcon,
+    library_Commit,
+    library_Save,
+    library_SaveInKnownFolder,
+};
+
+HRESULT WINAPI ShellLibrary_Constructor(IUnknown *outer, REFIID riid, void **out)
+{
+    struct library *lib;
+    HRESULT hr;
+
+    TRACE("(%p, %s, %p)\n", outer, debugstr_guid(riid), out);
+
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!(lib = calloc(1, sizeof(*lib)))) return E_OUTOFMEMORY;
+    lib->IShellLibrary_iface.lpVtbl = &library_vtbl;
+    lib->ref = 1;
+    InitializeCriticalSectionEx(&lib->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    lib->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": library.cs");
+    hr = IShellLibrary_QueryInterface(&lib->IShellLibrary_iface, riid, out);
+    IShellLibrary_Release(&lib->IShellLibrary_iface);
+    return hr;
+}
