+    pointer_default(unique)
+]
+interface IShellLibrary : IUnknown
+{
+    HRESULT LoadLibraryFromItem([in] IShellItem *item, [in] DWORD mode);
+    HRESULT LoadLibraryFromKnownFolder([in] REFKNOWNFOLDERID id, [in] DWORD mode);
+    HRESULT AddFolder([in] IShellItem *location);
+    HRESULT RemoveFolder([in] IShellItem *location);
+    HRESULT GetFolders([in] LIBRARYFOLDERFILTER filter, [in] REFIID riid, [out, iid_is(riid)] void **ppv);
+    HRESULT ResolveFolder([in] IShellItem *folder, [in] DWORD timeout, [in] REFIID riid,
