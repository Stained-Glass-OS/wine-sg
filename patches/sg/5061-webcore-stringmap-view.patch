From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.security.authentication.web.core: Implement StringMap GetView.

IMap<String, String>::GetView on the StringMap that WebTokenRequest and
WebAccount Properties hand out returns a read-only snapshot of the pairs
(Lookup, Size, HasKey, First); later changes to the map do not reach it. It
returned E_NOTIMPL.

Gate: test/webcore-mapview-gate.sh.
---
 .../objects.c                                      | 125 ++++++++++++++++++++-
 1 file changed, 122 insertions(+), 3 deletions(-)

diff --git a/dlls/windows.security.authentication.web.core/objects.c b/dlls/windows.security.authentication.web.core/objects.c
index 5f680d3..8d23c1b 100644
--- a/dlls/windows.security.authentication.web.core/objects.c
+++ b/dlls/windows.security.authentication.web.core/objects.c
@@ -271,11 +271,14 @@ static HRESULT WINAPI strmap_HasKey( IMap_HSTRING_HSTRING *iface, HSTRING key, b
     return S_OK;
 }
 
+static HRESULT strmap_view_create( struct strmap *map, IMapView_HSTRING_HSTRING **out );
+
 static HRESULT WINAPI strmap_GetView( IMap_HSTRING_HSTRING *iface, IMapView_HSTRING_HSTRING **view )
 {
-    FIXME( "iface %p, view %p stub!\n", iface, view );
-    *view = NULL;
-    return E_NOTIMPL;
+    TRACE( "iface %p, view %p.\n", iface, view );
+
+    if (!view) return E_POINTER;
+    return strmap_view_create( strmap_from( iface ), view );
 }
 
 static HRESULT WINAPI strmap_Insert( IMap_HSTRING_HSTRING *iface, HSTRING key, HSTRING value, boolean *replaced )
@@ -512,6 +515,122 @@ static HRESULT strmap_first( struct strmap *map, IIterator_IKeyValuePair_HSTRING
     return S_OK;
 }
 
+/* IMap::GetView: a read-only snapshot of the map, a copy that later changes to the map do not reach */
+struct strmap_view
+{
+    IMapView_HSTRING_HSTRING IMapView_iface;
+    IIterable_IKeyValuePair_HSTRING_HSTRING IIterable_IKeyValuePair_HSTRING_HSTRING_iface;
+    LONG ref;
+    struct strmap *copy;
+};
+
+static const struct qi_entry strmap_view_qi[] =
+{
+    { &IID_IMapView_HSTRING_HSTRING, offsetof( struct strmap_view, IMapView_iface ) },
+    { &IID_IIterable_IKeyValuePair_HSTRING_HSTRING,
+      offsetof( struct strmap_view, IIterable_IKeyValuePair_HSTRING_HSTRING_iface ) },
+    { NULL }
+};
+
+BASE_METHODS( strmap_view, struct strmap_view, IMapView_HSTRING_HSTRING, IMapView_iface,
+              "Windows.Foundation.Collections.IMapView`2<String, String>", strmap_view_qi )
+
+static void strmap_view_destroy( struct strmap_view *impl )
+{
+    IMap_HSTRING_HSTRING_Release( &impl->copy->IMap_iface );
+    free( impl );
+}
+
+static HRESULT WINAPI strmap_view_Lookup( IMapView_HSTRING_HSTRING *iface, HSTRING key, HSTRING *value )
+{
+    return strmap_Lookup( &strmap_view_from( iface )->copy->IMap_iface, key, value );
+}
+
+static HRESULT WINAPI strmap_view_get_Size( IMapView_HSTRING_HSTRING *iface, UINT32 *size )
+{
+    return strmap_get_Size( &strmap_view_from( iface )->copy->IMap_iface, size );
+}
+
+static HRESULT WINAPI strmap_view_HasKey( IMapView_HSTRING_HSTRING *iface, HSTRING key, boolean *found )
+{
+    return strmap_HasKey( &strmap_view_from( iface )->copy->IMap_iface, key, found );
+}
+
+static HRESULT WINAPI strmap_view_Split( IMapView_HSTRING_HSTRING *iface, IMapView_HSTRING_HSTRING **first,
+                                         IMapView_HSTRING_HSTRING **second )
+{
+    TRACE( "iface %p, first %p, second %p.\n", iface, first, second );
+
+    /* the view is not split: both halves are empty */
+    *first = *second = NULL;
+    return S_OK;
+}
+
+static const IMapView_HSTRING_HSTRINGVtbl strmap_view_vtbl =
+{
+    IUNKNOWN_ENTRIES( strmap_view ),
+    strmap_view_Lookup,
+    strmap_view_get_Size,
+    strmap_view_HasKey,
+    strmap_view_Split,
+};
+
+DEFINE_IINSPECTABLE_( strmap_view_iterable, IIterable_IKeyValuePair_HSTRING_HSTRING, struct strmap_view,
+                      strmap_view_from_IIterable, IIterable_IKeyValuePair_HSTRING_HSTRING_iface, &impl->IMapView_iface )
+
+static HRESULT WINAPI strmap_view_iterable_First( IIterable_IKeyValuePair_HSTRING_HSTRING *iface,
+                                                  IIterator_IKeyValuePair_HSTRING_HSTRING **iterator )
+{
+    return strmap_first( strmap_view_from_IIterable( iface )->copy, iterator );
+}
+
+static const IIterable_IKeyValuePair_HSTRING_HSTRINGVtbl strmap_view_iterable_vtbl =
+{
+    strmap_view_iterable_QueryInterface,
+    strmap_view_iterable_AddRef,
+    strmap_view_iterable_Release,
+    strmap_view_iterable_GetIids,
+    strmap_view_iterable_GetRuntimeClassName,
+    strmap_view_iterable_GetTrustLevel,
+    strmap_view_iterable_First,
+};
+
+static HRESULT strmap_view_create( struct strmap *map, IMapView_HSTRING_HSTRING **out )
+{
+    IMap_HSTRING_HSTRING *copy_iface;
+    struct strmap_view *impl;
+    struct strmap *copy;
+    HRESULT hr = S_OK;
+    boolean replaced;
+    UINT32 i;
+
+    *out = NULL;
+    if (FAILED(hr = string_map_create( &copy_iface ))) return hr;
+    copy = strmap_from( copy_iface );
+    EnterCriticalSection( &map->cs );
+#ifndef SG_MUTANT_VIEW_LIVE
+    for (i = 0; i < map->count && SUCCEEDED(hr); i++)
+        hr = strmap_Insert( copy_iface, map->entries[i].key, map->entries[i].value, &replaced );
+#else
+    IMap_HSTRING_HSTRING_Release( copy_iface );
+    copy = map;
+    IMap_HSTRING_HSTRING_AddRef( (copy_iface = &map->IMap_iface) );
+#endif
+    LeaveCriticalSection( &map->cs );
+    if (SUCCEEDED(hr) && !(impl = calloc( 1, sizeof(*impl) ))) hr = E_OUTOFMEMORY;
+    if (FAILED(hr))
+    {
+        IMap_HSTRING_HSTRING_Release( copy_iface );
+        return hr;
+    }
+    impl->IMapView_iface.lpVtbl = &strmap_view_vtbl;
+    impl->IIterable_IKeyValuePair_HSTRING_HSTRING_iface.lpVtbl = &strmap_view_iterable_vtbl;
+    impl->ref = 1;
+    impl->copy = copy;
+    *out = &impl->IMapView_iface;
+    return S_OK;
+}
+
 static HRESULT map_get( struct strmap *map, HSTRING key, HSTRING *value )
 {
     return strmap_Lookup( &map->IMap_iface, key, value );
