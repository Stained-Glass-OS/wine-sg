+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+#define ROW_HEIGHT 44
+#define MAX_APPS   64
+
+enum { ROW_HEADING, ROW_APP, ROW_MORE, ROW_BROWSE };
+
+struct app
+{
+    WCHAR progid[MAX_PATH];   /* the class to open it with */
+    WCHAR exe[MAX_PATH];
+    WCHAR name[128];
+    HICON icon;
+};
+
+struct row
+{
+    int kind;
+    const WCHAR *text;        /* ROW_HEADING */
+    int app;                  /* ROW_APP */
+};
+
+struct openwith
+{
+    WCHAR ext[64];
+    struct app apps[MAX_APPS];
+    int count, first_other, first_more, current;
+    struct row rows[MAX_APPS + 8];
+    int nrows;
+    BOOL more;
+    HWND hwnd, list, always;
+    HFONT font, big;
+    int result;
+};
+
+static int ow_scale(int x)
+{
+    HDC dc = GetDC(NULL);
+    int dpi = GetDeviceCaps(dc, LOGPIXELSY);
+    ReleaseDC(NULL, dc);
+    return MulDiv(x, dpi, 96);
+}
+
+static HFONT ow_font(int points)
+{
+    NONCLIENTMETRICSW ncm = { sizeof(ncm) };
+    HDC dc = GetDC(NULL);
+    SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0);
+    if (points) ncm.lfMessageFont.lfHeight = -MulDiv(points, GetDeviceCaps(dc, LOGPIXELSY), 72);
+    ReleaseDC(NULL, dc);
+    return CreateFontIndirectW(&ncm.lfMessageFont);
+}
+
+/* the program a command line starts: its first word, or the quoted part */
+static BOOL command_exe(const WCHAR *command, WCHAR *exe)
+{
+    WCHAR expanded[1024];
+    const WCHAR *p = expanded, *end;
+
+    ExpandEnvironmentStringsW(command, expanded, ARRAY_SIZE(expanded));
+    while (*p == ' ') p++;
+    if (*p == '"') { p++; end = wcschr(p, '"'); }
+    else
+    {
+        /* an unquoted path with spaces: as far as ".exe" */
+        const WCHAR *dot = StrStrIW(p, L".exe");
+        end = dot ? dot + 4 : wcschr(p, ' ');
+    }
+    if (!end) end = p + lstrlenW(p);
+    if (end - p <= 0 || end - p >= MAX_PATH) return FALSE;
+    memcpy(exe, p, (end - p) * sizeof(WCHAR));
+    exe[end - p] = 0;
+    return TRUE;
+}
+
+static BOOL class_command(const WCHAR *progid, WCHAR *exe)
+{
+    WCHAR key[MAX_PATH + 32], command[1024];
+    DWORD size = sizeof(command);
+
+    swprintf(key, ARRAY_SIZE(key), L"%s\\shell\\open\\command", progid);
+    if (RegGetValueW(HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND,
+                     NULL, command, &size) || !command[0])
+        return FALSE;
+    return command_exe(command, exe);
+}
+
+/* what the program calls itself: its version resource's description */
+static void app_name(const WCHAR *exe, const WCHAR *progid, WCHAR *name, DWORD len)
+{
+    WCHAR full[MAX_PATH];
+    DWORD size, dummy;
+    void *data, *value;
+    UINT vlen;
+    struct { WORD lang, cp; } *trans;
+
+    name[0] = 0;
+    /* the name the application registered for itself */
+    {
+        WCHAR key[MAX_PATH + 16];
+        DWORD size = len * sizeof(WCHAR);
+        swprintf(key, ARRAY_SIZE(key), L"Applications\\%s", PathFindFileNameW(exe));
+        if (!RegGetValueW(HKEY_CLASSES_ROOT, key, L"FriendlyAppName", RRF_RT_REG_SZ, NULL, name, &size) &&
+            name[0] && name[0] != '@')
+            return;
+        name[0] = 0;
+    }
+    if (!SearchPathW(NULL, exe, L".exe", ARRAY_SIZE(full), full, NULL)) lstrcpynW(full, exe, MAX_PATH);
+    if ((size = GetFileVersionInfoSizeW(full, &dummy)) && (data = malloc(size)))
+    {
+        if (GetFileVersionInfoW(full, 0, size, data) &&
+            VerQueryValueW(data, L"\\VarFileInfo\\Translation", (void **)&trans, &vlen) && vlen >= sizeof(*trans))
+        {
+            WCHAR sub[64];
+            swprintf(sub, ARRAY_SIZE(sub), L"\\StringFileInfo\\%04x%04x\\FileDescription", trans->lang, trans->cp);
+            if (VerQueryValueW(data, sub, &value, &vlen) && vlen > 1) lstrcpynW(name, value, len);
+        }
+        free(data);
+    }
+    if (!name[0])
+    {
+        lstrcpynW(name, PathFindFileNameW(exe), len);
+        PathRemoveExtensionW(name);
+        if (name[0]) name[0] = towupper(name[0]);
+    }
+    if (!name[0]) lstrcpynW(name, progid, len);
+}
+
+static int find_app(struct openwith *ow, const WCHAR *exe)
+{
+    int i;
+    for (i = 0; i < ow->count; i++)
+        if (!lstrcmpiW(PathFindFileNameW(ow->apps[i].exe), PathFindFileNameW(exe))) return i;
+    return -1;
+}
+
+static int add_app(struct openwith *ow, const WCHAR *progid)
+{
+    struct app *a;
+    WCHAR exe[MAX_PATH], full[MAX_PATH];
+    int i;
+
+    if (ow->count >= MAX_APPS || !progid[0] || !class_command(progid, exe)) return -1;
+    if (!lstrcmpiW(PathFindFileNameW(exe), L"rundll32.exe")) return -1;
+    if ((i = find_app(ow, exe)) >= 0) return i;
+    a = &ow->apps[ow->count];
+    lstrcpynW(a->progid, progid, MAX_PATH);
+    lstrcpynW(a->exe, exe, MAX_PATH);
+    app_name(exe, progid, a->name, ARRAY_SIZE(a->name));
+    if (!SearchPathW(NULL, exe, L".exe", ARRAY_SIZE(full), full, NULL)) lstrcpynW(full, exe, MAX_PATH);
+    ExtractIconExW(full, 0, &a->icon, NULL, 1);
+    return ow->count++;
+}
+
+static void add_applications_key(struct openwith *ow, const WCHAR *exe_name)
+{
+    WCHAR progid[MAX_PATH];
+    swprintf(progid, ARRAY_SIZE(progid), L"Applications\\%s", exe_name);
+    add_app(ow, progid);
+}
+
+static void collect_apps(struct openwith *ow)
+{
+    WCHAR progid[MAX_PATH], name[MAX_PATH], key[MAX_PATH];
+    DWORD size, i;
+    HKEY hkey, sub;
+
+    /* the one that opens it now */
+    ow->current = -1;
+    if (SHELL_GetUserChoice(ow->ext, progid, ARRAY_SIZE(progid)) ||
+        HCR_MapTypeToValueW(ow->ext, progid, sizeof(progid), FALSE))
+        ow->current = add_app(ow, progid);
+    ow->first_other = ow->count;
+    /* the others registered for the type */
+    swprintf(key, ARRAY_SIZE(key), L"%s\\OpenWithProgids", ow->ext);
+    if (!RegOpenKeyExW(HKEY_CLASSES_ROOT, key, 0, KEY_READ, &hkey))
+    {
+        for (i = 0; size = ARRAY_SIZE(name), !RegEnumValueW(hkey, i, name, &size, NULL, NULL, NULL, NULL); i++)
+            add_app(ow, name);
+        RegCloseKey(hkey);
+    }
+    swprintf(key, ARRAY_SIZE(key), L"%s\\OpenWithList", ow->ext);
+    if (!RegOpenKeyExW(HKEY_CLASSES_ROOT, key, 0, KEY_READ, &hkey))
+    {
+        for (i = 0; size = ARRAY_SIZE(name), !RegEnumKeyExW(hkey, i, name, &size, NULL, NULL, NULL, NULL); i++)
+            add_applications_key(ow, name);
+        RegCloseKey(hkey);
+    }
+    /* Applications that say they take it */
+    if (!RegOpenKeyExW(HKEY_CLASSES_ROOT, L"Applications", 0, KEY_READ, &hkey))
+    {
+        for (i = 0; size = ARRAY_SIZE(name), !RegEnumKeyExW(hkey, i, name, &size, NULL, NULL, NULL, NULL); i++)
+        {
+            swprintf(key, ARRAY_SIZE(key), L"%s\\SupportedTypes", name);
+            if (!RegOpenKeyExW(hkey, key, 0, KEY_READ, &sub))
+            {
+                if (!RegQueryValueExW(sub, ow->ext, NULL, NULL, NULL, NULL)) add_applications_key(ow, name);
+                RegCloseKey(sub);
+            }
+        }
+        RegCloseKey(hkey);
+    }
+    ow->first_more = ow->count;
+    /* more apps: every application that can open a file */
+    if (!RegOpenKeyExW(HKEY_CLASSES_ROOT, L"Applications", 0, KEY_READ, &hkey))
+    {
+        for (i = 0; size = ARRAY_SIZE(name), !RegEnumKeyExW(hkey, i, name, &size, NULL, NULL, NULL, NULL); i++)
+        {
+            if (!RegOpenKeyExW(hkey, name, 0, KEY_READ, &sub))
+            {
+                BOOL hidden = !RegQueryValueExW(sub, L"NoOpenWith", NULL, NULL, NULL, NULL);
+                RegCloseKey(sub);
+                if (!hidden) add_applications_key(ow, name);
+            }
+        }
+        RegCloseKey(hkey);
+    }
+    if (find_app(ow, L"notepad.exe") < 0) add_app(ow, L"txtfile");
+}
+
+static void build_rows(struct openwith *ow)
+{
+    int i;
+
+    ow->nrows = 0;
+    if (ow->current >= 0)
+    {
+        ow->rows[ow->nrows++] = (struct row){ ROW_HEADING, L"Keep using this app" };
+        ow->rows[ow->nrows++] = (struct row){ ROW_APP, NULL, ow->current };
+    }
+    if (ow->first_other < (ow->more ? ow->count : ow->first_more))
+        ow->rows[ow->nrows++] = (struct row){ ROW_HEADING, ow->current >= 0 ? L"Other options" : L"Apps" };
+    for (i = ow->first_other; i < (ow->more ? ow->count : ow->first_more); i++)
+        if (i != ow->current && ow->nrows < ARRAY_SIZE(ow->rows) - 2)
+            ow->rows[ow->nrows++] = (struct row){ ROW_APP, NULL, i };
+    if (!ow->more && ow->first_more < ow->count) ow->rows[ow->nrows++] = (struct row){ ROW_MORE, L"More apps" };
+    ow->rows[ow->nrows++] = (struct row){ ROW_BROWSE, L"Look for another app on this PC" };
+
+    SendMessageW(ow->list, LB_RESETCONTENT, 0, 0);
+    for (i = 0; i < ow->nrows; i++) SendMessageW(ow->list, LB_ADDSTRING, 0, i);
+    for (i = 0; i < ow->nrows; i++)
+        if (ow->rows[i].kind == ROW_APP) { SendMessageW(ow->list, LB_SETCURSEL, i, 0); break; }
+}
+
+static void draw_row(struct openwith *ow, DRAWITEMSTRUCT *di)
+{
+    const struct row *r;
+    RECT rc = di->rcItem;
+    BOOL sel = (di->itemState & ODS_SELECTED) != 0;
+
+    if (di->itemID >= (UINT)ow->nrows) return;
+    r = &ow->rows[di->itemID];
+    FillRect(di->hDC, &rc, GetSysColorBrush(sel && r->kind != ROW_HEADING ? COLOR_HIGHLIGHT : COLOR_WINDOW));
+    SetBkMode(di->hDC, TRANSPARENT);
+    SelectObject(di->hDC, ow->font);
+    SetTextColor(di->hDC, GetSysColor(sel && r->kind != ROW_HEADING ? COLOR_HIGHLIGHTTEXT : COLOR_WINDOWTEXT));
+    rc.left += ow_scale(12);
+    switch (r->kind)
+    {
+    case ROW_HEADING:
+        SetTextColor(di->hDC, GetSysColor(COLOR_GRAYTEXT));
+        rc.top = rc.bottom - ow_scale(22);
+        DrawTextW(di->hDC, r->text, -1, &rc, DT_SINGLELINE | DT_VCENTER);
+        break;
+    case ROW_APP:
+    {
+        const struct app *a = &ow->apps[r->app];
+        if (a->icon) DrawIconEx(di->hDC, rc.left, rc.top + (rc.bottom - rc.top - ow_scale(32)) / 2, a->icon,
+                                ow_scale(32), ow_scale(32), 0, NULL, DI_NORMAL);
+        rc.left += ow_scale(44);
+        DrawTextW(di->hDC, a->name, -1, &rc, DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS);
+        break;
+    }
+    default:
+        if (!sel) SetTextColor(di->hDC, RGB(0x5f, 0x24, 0x96));
+        rc.left += ow_scale(44);
+        DrawTextW(di->hDC, r->kind == ROW_MORE ? L"More apps \x2193" : r->text, -1, &rc, DT_SINGLELINE | DT_VCENTER);
+        break;
+    }
+}
+
+static BOOL browse_for_app(struct openwith *ow)
+{
+    OPENFILENAMEW ofn = { sizeof(ofn) };
+    WCHAR file[MAX_PATH] = L"", key[MAX_PATH + 64], command[MAX_PATH + 16], progid[MAX_PATH];
+    const WCHAR *name;
+    int i, n;
+
+    ofn.hwndOwner = ow->hwnd;
+    ofn.lpstrFilter = L"Programs\0*.exe\0All files\0*.*\0";
+    ofn.lpstrFile = file;
+    ofn.nMaxFile = ARRAY_SIZE(file);
+    ofn.lpstrTitle = L"Open with...";
+    ofn.Flags = OFN_FILEMUSTEXIST | OFN_PATHMUSTEXIST | OFN_HIDEREADONLY;
+    if (!GetOpenFileNameW(&ofn)) return FALSE;
+    /* registered for the user, as Windows does: Applications\name.exe */
+    name = PathFindFileNameW(file);
+    swprintf(key, ARRAY_SIZE(key), L"Software\\Classes\\Applications\\%s\\shell\\open\\command", name);
+    swprintf(command, ARRAY_SIZE(command), L"\"%s\" \"%%1\"", file);
+    RegSetKeyValueW(HKEY_CURRENT_USER, key, NULL, REG_SZ, command, (lstrlenW(command) + 1) * sizeof(WCHAR));
+    swprintf(progid, ARRAY_SIZE(progid), L"Applications\\%s", name);
+    if ((i = find_app(ow, file)) < 0 && (i = add_app(ow, progid)) < 0) return FALSE;
+    /* shown among the others, chosen */
+    if (i >= ow->first_more && !ow->more)
+    {
+        struct app tmp = ow->apps[i];
+        memmove(&ow->apps[ow->first_more + 1], &ow->apps[ow->first_more], (i - ow->first_more) * sizeof(tmp));
+        ow->apps[ow->first_more] = tmp;
+        i = ow->first_more++;
+    }
+    build_rows(ow);
+    for (n = 0; n < ow->nrows; n++)
+        if (ow->rows[n].kind == ROW_APP && ow->rows[n].app == i) SendMessageW(ow->list, LB_SETCURSEL, n, 0);
+    return TRUE;
+}
+
+static LRESULT CALLBACK openwith_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct openwith *ow = (struct openwith *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+
+    switch (msg)
+    {
+    case WM_CREATE:
+        SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)((CREATESTRUCTW *)lp)->lpCreateParams);
+        return 0;
+    case WM_ERASEBKGND:
+    {
+        RECT rc;
+        GetClientRect(hwnd, &rc);
+        FillRect((HDC)wp, &rc, GetSysColorBrush(COLOR_WINDOW));
+        return 1;
+    }
+    case WM_CTLCOLORSTATIC:
+    case WM_CTLCOLORBTN:
+        SetBkColor((HDC)wp, GetSysColor(COLOR_WINDOW));
+        return (LRESULT)GetSysColorBrush(COLOR_WINDOW);
+    case WM_MEASUREITEM:
+        ((MEASUREITEMSTRUCT *)lp)->itemHeight = ow_scale(ROW_HEIGHT);
+        return TRUE;
+    case WM_DRAWITEM:
+        draw_row(ow, (DRAWITEMSTRUCT *)lp);
+        return TRUE;
+    case WM_COMMAND:
+        if (LOWORD(wp) == 100 && (HIWORD(wp) == LBN_SELCHANGE || HIWORD(wp) == LBN_DBLCLK))
+        {
+            int sel = SendMessageW(ow->list, LB_GETCURSEL, 0, 0);
+            if (sel < 0 || sel >= ow->nrows) return 0;
+            switch (ow->rows[sel].kind)
+            {
+            case ROW_HEADING:
+                SendMessageW(ow->list, LB_SETCURSEL, sel + 1 < ow->nrows ? sel + 1 : sel - 1, 0);
+                break;
+            case ROW_MORE:
+                ow->more = TRUE;
+                build_rows(ow);
+                break;
+            case ROW_BROWSE:
+                if (!browse_for_app(ow)) build_rows(ow);
+                break;
+            case ROW_APP:
+                if (HIWORD(wp) == LBN_DBLCLK) ow->result = IDOK;
+                break;
+            }
+            return 0;
+        }
+        if (LOWORD(wp) == IDOK || LOWORD(wp) == IDCANCEL) ow->result = LOWORD(wp);
+        return 0;
+    case WM_CLOSE:
+        ow->result = IDCANCEL;
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+static HWND ow_control(struct openwith *ow, const WCHAR *cls, const WCHAR *text, DWORD style, int x, int y, int w, int h,
+                       int id, HFONT font)
+{
+    HWND c = CreateWindowExW(0, cls, text, WS_CHILD | WS_VISIBLE | style, ow_scale(x), ow_scale(y), ow_scale(w),
+                             ow_scale(h), ow->hwnd, (HMENU)(INT_PTR)id, shell32_hInstance, NULL);
+    SendMessageW(c, WM_SETFONT, (WPARAM)font, FALSE);
+    return c;
+}
+
+/* the chosen app, or -1 */
+static int run_openwith(struct openwith *ow, HWND owner, BOOL *always)
+{
+    WNDCLASSW wc = { 0 };
+    WCHAR label[128];
+    RECT rc, orc;
+    MSG msg;
+    int sel, app = -1;
+
+    wc.lpfnWndProc = openwith_proc;
+    wc.hInstance = shell32_hInstance;
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW);
+    wc.lpszClassName = L"SGOpenWith";
+    RegisterClassW(&wc);
+    ow->font = ow_font(0);
+    ow->big = ow_font(14);
+    SetRect(&rc, 0, 0, ow_scale(420), ow_scale(520));
+    AdjustWindowRectEx(&rc, WS_CAPTION | WS_SYSMENU, FALSE, WS_EX_DLGMODALFRAME);
+    if (!owner || !GetWindowRect(owner, &orc)) SystemParametersInfoW(SPI_GETWORKAREA, 0, &orc, 0);
+    ow->hwnd = CreateWindowExW(WS_EX_DLGMODALFRAME, L"SGOpenWith", L"Open with", WS_POPUP | WS_CAPTION | WS_SYSMENU,
+                               max(0, orc.left + (orc.right - orc.left - (rc.right - rc.left)) / 2),
+                               max(0, orc.top + (orc.bottom - orc.top - (rc.bottom - rc.top)) / 3),
+                               rc.right - rc.left, rc.bottom - rc.top, owner, NULL, shell32_hInstance, ow);
+    ow_control(ow, L"Static", L"How do you want to open this file?", 0, 20, 16, 380, 32, 0, ow->big);
+    ow->list = ow_control(ow, L"ListBox", NULL, LBS_OWNERDRAWFIXED | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL |
+                          WS_TABSTOP, 12, 56, 396, 368, 100, ow->font);
+    swprintf(label, ARRAY_SIZE(label), L"&Always use this app to open %s files", ow->ext);
+    ow->always = ow_control(ow, L"Button", label, BS_AUTOCHECKBOX | WS_TABSTOP, 20, 434, 380, 24, 101, ow->font);
+    if (ow->current < 0) SendMessageW(ow->always, BM_SETCHECK, BST_CHECKED, 0);
+    ow_control(ow, L"Button", L"OK", BS_DEFPUSHBUTTON | WS_TABSTOP, 312, 474, 88, 30, IDOK, ow->font);
+    build_rows(ow);
+
+    if (owner) EnableWindow(owner, FALSE);
+    ShowWindow(ow->hwnd, SW_SHOWNORMAL);
+    SetForegroundWindow(ow->hwnd);
+    SetFocus(ow->list);
+    while (!ow->result && GetMessageW(&msg, NULL, 0, 0))
+    {
+        if (IsDialogMessageW(ow->hwnd, &msg)) continue;
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+    sel = SendMessageW(ow->list, LB_GETCURSEL, 0, 0);
+    if (ow->result == IDOK && sel >= 0 && sel < ow->nrows && ow->rows[sel].kind == ROW_APP) app = ow->rows[sel].app;
+    *always = SendMessageW(ow->always, BM_GETCHECK, 0, 0) == BST_CHECKED;
+    if (owner) EnableWindow(owner, TRUE);
+    DestroyWindow(ow->hwnd);
+    DeleteObject(ow->font);
+    DeleteObject(ow->big);
+    return app;
+}
+
+HRESULT WINAPI SHOpenWithDialog(HWND parent, const OPENASINFO *info)
+{
+    struct openwith *ow;
+    const WCHAR *dot;
+    BOOL always = FALSE;
+    HRESULT hr = HRESULT_FROM_WIN32(ERROR_CANCELLED);
+    int app, i;
+
+    TRACE("%p %s %#lx\n", parent, info ? debugstr_w(info->pcszFile) : "", info ? (DWORD)info->oaifInFlags : 0);
+    if (!info || !info->pcszFile) return E_INVALIDARG;
+    if (!(ow = calloc(1, sizeof(*ow)))) return E_OUTOFMEMORY;
+    dot = PathFindExtensionW(info->pcszFile);
+    lstrcpynW(ow->ext, *dot ? dot : L".", ARRAY_SIZE(ow->ext));
+    collect_apps(ow);
+    if ((app = run_openwith(ow, parent, &always)) >= 0)
+    {
+        const struct app *a = &ow->apps[app];
+        TRACE("chosen %s (%s) always %d\n", debugstr_w(a->progid), debugstr_w(a->exe), always);
+        if (always && (info->oaifInFlags & OAIF_ALLOW_REGISTRATION || info->oaifInFlags & OAIF_REGISTER_EXT || !info->oaifInFlags))
+        {
+            WCHAR key[MAX_PATH];
+            swprintf(key, ARRAY_SIZE(key), L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts\\%s\\UserChoice", ow->ext);
+            RegSetKeyValueW(HKEY_CURRENT_USER, key, L"ProgId", REG_SZ, a->progid, (lstrlenW(a->progid) + 1) * sizeof(WCHAR));
+            SHChangeNotify(SHCNE_ASSOCCHANGED, SHCNF_IDLIST, NULL, NULL);
+        }
+        hr = S_OK;
+        if (info->oaifInFlags & OAIF_EXEC || !info->oaifInFlags)
+        {
+            SHELLEXECUTEINFOW sei = { sizeof(sei) };
+            sei.fMask = SEE_MASK_CLASSNAME | SEE_MASK_FLAG_NO_UI;
+            sei.hwnd = parent;
+            sei.lpClass = a->progid;
+            sei.lpFile = info->pcszFile;
+            sei.nShow = SW_SHOWNORMAL;
+            if (!ShellExecuteExW(&sei)) hr = HRESULT_FROM_WIN32(GetLastError());
+        }
+    }
+    for (i = 0; i < ow->count; i++) if (ow->apps[i].icon) DestroyIcon(ow->apps[i].icon);
+    free(ow);
+    return hr;
+}
