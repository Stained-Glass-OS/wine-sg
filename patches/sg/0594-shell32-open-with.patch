+/* Stained Glass OS: "Open with..." -- the file's Open With dialog */
+static HRESULT open_with(ContextMenu *This, HWND hwnd)
+{
+    OPENASINFO info = { NULL, NULL, OAIF_ALLOW_REGISTRATION | OAIF_REGISTER_EXT | OAIF_EXEC };
+    ITEMIDLIST *full;
+    WCHAR path[MAX_PATH];
+    HRESULT hr = E_FAIL;
+
+    if (This->cidl != 1 || !(full = ILCombine(This->pidl, This->apidl[0]))) return E_INVALIDARG;
+    if (SHGetPathFromIDListW(full, path))
+    {
+        info.pcszFile = path;
+        hr = SHOpenWithDialog(hwnd, &info);
+        if (hr == HRESULT_FROM_WIN32(ERROR_CANCELLED)) hr = S_OK;
+    }
+    ILFree(full);
+    return hr;
+}
