+#include <stdio.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "shellapi.h"
+#include "shlobj.h"
+#include "shlwapi.h"
+#include "commdlg.h"
