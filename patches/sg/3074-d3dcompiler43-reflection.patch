From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 16:59:19 -0700
Subject: [PATCH] d3dcompiler_43: reflection counters from the STAT chunk,
 class-less type queries

GetMovcInstructionCount, GetBitwiseInstructionCount, GetGSInputPrimitive and the
cBarrier/cInterlocked/cTextureStore instruction counts of GetDesc come from the
STAT chunk fields that were skipped. Type IsOfType / ImplementsInterface answer
S_OK / S_FALSE, the class queries answer NULL / 0 without a FIXME.

diff --git a/dlls/d3dcompiler_43/reflection.c b/dlls/d3dcompiler_43/reflection.c
index a997be3..1da03ca 100644
--- a/dlls/d3dcompiler_43/reflection.c
+++ b/dlls/d3dcompiler_43/reflection.c
@@ -141,7 +141,12 @@ struct d3dcompiler_shader_reflection
     UINT constant_buffer_count;
 
     UINT mov_instruction_count;
+    UINT movc_instruction_count;
     UINT conversion_instruction_count;
+    UINT bitwise_instruction_count;
+    UINT barrier_instruction_count;
+    UINT interlocked_instruction_count;
+    UINT texture_store_instruction_count;
     UINT instruction_count;
     UINT emit_instruction_count;
     D3D_PRIMITIVE_TOPOLOGY gs_output_topology;
@@ -399,7 +404,7 @@ static HRESULT STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetDesc(ID3D11Sha
 {
     struct d3dcompiler_shader_reflection *reflection = impl_from_ID3D11ShaderReflection(iface);
 
-    FIXME("iface %p, desc %p partial stub!\n", iface, desc);
+    TRACE("iface %p, desc %p.\n", iface, desc);
 
     if (!desc)
     {
@@ -443,9 +448,9 @@ static HRESULT STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetDesc(ID3D11Sha
     desc->HSOutputPrimitive = reflection->hs_output_primitive;
     desc->HSPartitioning = reflection->hs_partitioning;
     desc->TessellatorDomain = reflection->tessellator_domain;
-    desc->cBarrierInstructions = 0;
-    desc->cInterlockedInstructions = 0;
-    desc->cTextureStoreInstructions = 0;
+    desc->cBarrierInstructions = reflection->barrier_instruction_count;
+    desc->cInterlockedInstructions = reflection->interlocked_instruction_count;
+    desc->cTextureStoreInstructions = reflection->texture_store_instruction_count;
 #endif
 
     return S_OK;
@@ -652,9 +657,11 @@ static UINT STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetMovInstructionCou
 static UINT STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetMovcInstructionCount(
         ID3D11ShaderReflection *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct d3dcompiler_shader_reflection *This = impl_from_ID3D11ShaderReflection(iface);
 
-    return 0;
+    TRACE("iface %p\n", iface);
+
+    return This->movc_instruction_count;
 }
 
 static UINT STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetConversionInstructionCount(
@@ -670,23 +677,28 @@ static UINT STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetConversionInstruc
 static UINT STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetBitwiseInstructionCount(
         ID3D11ShaderReflection *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct d3dcompiler_shader_reflection *This = impl_from_ID3D11ShaderReflection(iface);
 
-    return 0;
+    TRACE("iface %p\n", iface);
+
+    return This->bitwise_instruction_count;
 }
 
 static D3D_PRIMITIVE STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetGSInputPrimitive(
         ID3D11ShaderReflection *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct d3dcompiler_shader_reflection *This = impl_from_ID3D11ShaderReflection(iface);
 
-    return 0;
+    TRACE("iface %p\n", iface);
+
+    return This->input_primitive;
 }
 
 static BOOL STDMETHODCALLTYPE d3dcompiler_shader_reflection_IsSampleFrequencyShader(
         ID3D11ShaderReflection *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    /* the shader statistics do not record sample-frequency execution */
+    TRACE("iface %p\n", iface);
 
     return FALSE;
 }
@@ -694,7 +706,8 @@ static BOOL STDMETHODCALLTYPE d3dcompiler_shader_reflection_IsSampleFrequencySha
 static UINT STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetNumInterfaceSlots(
         ID3D11ShaderReflection *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    /* interface slots belong to class linkage, which the compiler does not produce */
+    TRACE("iface %p\n", iface);
 
     return 0;
 }
@@ -944,7 +957,8 @@ static ID3D11ShaderReflectionConstantBuffer * STDMETHODCALLTYPE d3dcompiler_shad
 static UINT STDMETHODCALLTYPE d3dcompiler_shader_reflection_variable_GetInterfaceSlot(
         ID3D11ShaderReflectionVariable *iface, UINT index)
 {
-    FIXME("iface %p, index %u stub!\n", iface, index);
+    /* no variable is an interface instance */
+    TRACE("iface %p, index %u\n", iface, index);
 
     return 0;
 }
@@ -1083,7 +1097,7 @@ static HRESULT STDMETHODCALLTYPE d3dcompiler_shader_reflection_type_IsEqual(
 static ID3D11ShaderReflectionType * STDMETHODCALLTYPE d3dcompiler_shader_reflection_type_GetSubType(
         ID3D11ShaderReflectionType *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    TRACE("iface %p\n", iface);
 
     return NULL;
 }
@@ -1091,7 +1105,7 @@ static ID3D11ShaderReflectionType * STDMETHODCALLTYPE d3dcompiler_shader_reflect
 static ID3D11ShaderReflectionType * STDMETHODCALLTYPE d3dcompiler_shader_reflection_type_GetBaseClass(
         ID3D11ShaderReflectionType *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    TRACE("iface %p\n", iface);
 
     return NULL;
 }
@@ -1099,7 +1113,7 @@ static ID3D11ShaderReflectionType * STDMETHODCALLTYPE d3dcompiler_shader_reflect
 static UINT STDMETHODCALLTYPE d3dcompiler_shader_reflection_type_GetNumInterfaces(
         ID3D11ShaderReflectionType *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    TRACE("iface %p\n", iface);
 
     return 0;
 }
@@ -1107,7 +1121,7 @@ static UINT STDMETHODCALLTYPE d3dcompiler_shader_reflection_type_GetNumInterface
 static ID3D11ShaderReflectionType * STDMETHODCALLTYPE d3dcompiler_shader_reflection_type_GetInterfaceByIndex(
         ID3D11ShaderReflectionType *iface, UINT index)
 {
-    FIXME("iface %p, index %u stub!\n", iface, index);
+    TRACE("iface %p, index %u\n", iface, index);
 
     return NULL;
 }
@@ -1115,17 +1129,18 @@ static ID3D11ShaderReflectionType * STDMETHODCALLTYPE d3dcompiler_shader_reflect
 static HRESULT STDMETHODCALLTYPE d3dcompiler_shader_reflection_type_IsOfType(
         ID3D11ShaderReflectionType *iface, ID3D11ShaderReflectionType *type)
 {
-    FIXME("iface %p, type %p stub!\n", iface, type);
+    TRACE("iface %p, type %p\n", iface, type);
 
-    return E_NOTIMPL;
+    return iface == type ? S_OK : S_FALSE;
 }
 
 static HRESULT STDMETHODCALLTYPE d3dcompiler_shader_reflection_type_ImplementsInterface(
         ID3D11ShaderReflectionType *iface, ID3D11ShaderReflectionType *base)
 {
-    FIXME("iface %p, base %p stub!\n", iface, base);
+    TRACE("iface %p, base %p\n", iface, base);
 
-    return E_NOTIMPL;
+    /* types implement no interfaces: only classes do */
+    return S_FALSE;
 }
 #endif
 
@@ -1214,12 +1229,14 @@ static HRESULT d3dcompiler_parse_stat(struct d3dcompiler_shader_reflection *r, c
     r->mov_instruction_count = read_u32(&ptr);
     TRACE("MovInstructionCount: %u.\n", r->mov_instruction_count);
 
-    skip_u32_unknown(&ptr, 1);
+    r->movc_instruction_count = read_u32(&ptr);
+    TRACE("MovcInstructionCount: %u.\n", r->movc_instruction_count);
 
     r->conversion_instruction_count = read_u32(&ptr);
     TRACE("ConversionInstructionCount: %u.\n", r->conversion_instruction_count);
 
-    skip_u32_unknown(&ptr, 1);
+    r->bitwise_instruction_count = read_u32(&ptr);
+    TRACE("BitwiseInstructionCount: %u.\n", r->bitwise_instruction_count);
 
     r->input_primitive = read_u32(&ptr);
     TRACE("InputPrimitive: %x.\n", r->input_primitive);
@@ -1254,7 +1271,14 @@ static HRESULT d3dcompiler_parse_stat(struct d3dcompiler_shader_reflection *r, c
     r->tessellator_domain = read_u32(&ptr);
     TRACE("TessellatorDomain: %x.\n", r->tessellator_domain);
 
-    skip_u32_unknown(&ptr, 3);
+    r->barrier_instruction_count = read_u32(&ptr);
+    TRACE("cBarrierInstructions: %u.\n", r->barrier_instruction_count);
+
+    r->interlocked_instruction_count = read_u32(&ptr);
+    TRACE("cInterlockedInstructions: %u.\n", r->interlocked_instruction_count);
+
+    r->texture_store_instruction_count = read_u32(&ptr);
+    TRACE("cTextureStoreInstructions: %u.\n", r->texture_store_instruction_count);
 
     /* dx11 stat size */
     if (size == 37) return S_OK;
