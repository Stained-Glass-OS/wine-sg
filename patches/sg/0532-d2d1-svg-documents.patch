+static HRESULT STDMETHODCALLTYPE d2d_svg_element_SetAttributeValue__(ID2D1SvgElement *iface,
+        const WCHAR *name, ID2D1SvgAttribute *value)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    struct d2d_svg_attribute *object;
+    struct svg_attr *attr;
+    HRESULT hr;
+
+    TRACE("iface %p, name %s, value %p.\n", iface, debugstr_w(name), value);
+
+    if (!name || !(object = unsafe_impl_from_ID2D1SvgAttribute(value)))
+        return E_INVALIDARG;
+    /* An attribute that belongs to another element is copied. */
+    if (object->element && object->element != element)
+    {
+        if (FAILED(hr = d2d_svg_attribute_clone(object, &object)))
+            return hr;
+    }
+    else
+    {
+        ID2D1SvgAttribute_AddRef(&object->ID2D1SvgAttribute_iface);
+    }
+    if (!(attr = svg_get_or_add_attr(element, name)))
+    {
+        ID2D1SvgAttribute_Release(&object->ID2D1SvgAttribute_iface);
+        return E_OUTOFMEMORY;
+    }
+    if (attr->object == object)
+    {
+        ID2D1SvgAttribute_Release(&object->ID2D1SvgAttribute_iface);
+        return S_OK;
+    }
+    svg_attr_clear_value(attr);
+    attr->object = object;
+    object->element = element;
+    return S_OK;
+}
+
+static const WCHAR *svg_enum_name(const WCHAR *const *names, unsigned int count, UINT32 value)
+{
+    return value < count ? names[value] : NULL;
+}
+
+static BOOL svg_enum_value(const WCHAR *const *names, unsigned int count, const WCHAR *str, UINT32 *value)
+{
+    unsigned int i;
+
+    str = svg_skip_space(str);
+    for (i = 0; i < count; ++i)
+    {
+        size_t len;
+
+        if (!names[i]) continue;
+        len = wcslen(names[i]);
+        if (!wcsncmp(str, names[i], len) && !*svg_skip_space(str + len))
+        {
+            *value = i;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static const WCHAR *const svg_fill_mode_names[] = {L"evenodd", L"nonzero"};
+static const WCHAR *const svg_display_names[] = {L"inline", L"none"};
+static const WCHAR *const svg_overflow_names[] = {L"visible", L"hidden"};
+static const WCHAR *const svg_line_cap_names[] = {L"butt", L"square", L"round"};
+static const WCHAR *const svg_line_join_names[] = {NULL, L"bevel", L"round", L"miter"};
+static const WCHAR *const svg_visibility_names[] = {L"visible", L"hidden"};
+static const WCHAR *const svg_unit_type_names[] = {L"userSpaceOnUse", L"objectBoundingBox"};
+static const WCHAR *const svg_extend_mode_names[] = {L"pad", L"repeat", L"reflect"};
+static const WCHAR *const svg_align_names[] =
+{
+    L"none", L"xMinYMin", L"xMidYMin", L"xMaxYMin", L"xMinYMid", L"xMidYMid",
+    L"xMaxYMid", L"xMinYMax", L"xMidYMax", L"xMaxYMax",
+};
+
+static UINT32 svg_pod_size(D2D1_SVG_ATTRIBUTE_POD_TYPE type)
+{
+    switch (type)
+    {
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_FLOAT: return sizeof(float);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_COLOR: return sizeof(D2D1_COLOR_F);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_FILL_MODE:
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_DISPLAY:
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_OVERFLOW:
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_LINE_CAP:
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_LINE_JOIN:
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_VISIBILITY:
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_UNIT_TYPE:
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_EXTEND_MODE: return sizeof(UINT32);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_MATRIX: return sizeof(D2D1_MATRIX_3X2_F);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_PRESERVE_ASPECT_RATIO: return sizeof(D2D1_SVG_PRESERVE_ASPECT_RATIO);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_VIEWBOX: return sizeof(D2D1_SVG_VIEWBOX);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_LENGTH: return sizeof(D2D1_SVG_LENGTH);
+        default: return 0;
+    }
+}
+
+/* Writes a typed value as SVG text. */
+static HRESULT svg_format_pod(struct svg_buf *buf, D2D1_SVG_ATTRIBUTE_POD_TYPE type, const void *value)
+{
+    const WCHAR *name = NULL;
+    WCHAR tmp[32];
+    UINT32 v = 0;
+
+    if (svg_pod_size(type) == sizeof(UINT32))
+        v = *(const UINT32 *)value;
+
+    switch (type)
+    {
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_FLOAT:
+            svg_buf_float(buf, *(const float *)value);
+            return S_OK;
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_COLOR:
+            svg_format_color(tmp, ARRAY_SIZE(tmp), value);
+            svg_buf_puts(buf, tmp);
+            return S_OK;
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_FILL_MODE:
+            name = svg_enum_name(svg_fill_mode_names, ARRAY_SIZE(svg_fill_mode_names), v); break;
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_DISPLAY:
+            name = svg_enum_name(svg_display_names, ARRAY_SIZE(svg_display_names), v); break;
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_OVERFLOW:
+            name = svg_enum_name(svg_overflow_names, ARRAY_SIZE(svg_overflow_names), v); break;
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_LINE_CAP:
+            name = svg_enum_name(svg_line_cap_names, ARRAY_SIZE(svg_line_cap_names), v); break;
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_LINE_JOIN:
+            name = svg_enum_name(svg_line_join_names, ARRAY_SIZE(svg_line_join_names), v); break;
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_VISIBILITY:
+            name = svg_enum_name(svg_visibility_names, ARRAY_SIZE(svg_visibility_names), v); break;
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_UNIT_TYPE:
+            name = svg_enum_name(svg_unit_type_names, ARRAY_SIZE(svg_unit_type_names), v); break;
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_EXTEND_MODE:
+            name = svg_enum_name(svg_extend_mode_names, ARRAY_SIZE(svg_extend_mode_names), v); break;
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_MATRIX:
+        {
+            const D2D1_MATRIX_3X2_F *m = value;
+            svg_buf_puts(buf, L"matrix(");
+            svg_buf_float(buf, m->_11); svg_buf_puts(buf, L" ");
+            svg_buf_float(buf, m->_12); svg_buf_puts(buf, L" ");
+            svg_buf_float(buf, m->_21); svg_buf_puts(buf, L" ");
+            svg_buf_float(buf, m->_22); svg_buf_puts(buf, L" ");
+            svg_buf_float(buf, m->_31); svg_buf_puts(buf, L" ");
+            svg_buf_float(buf, m->_32); svg_buf_puts(buf, L")");
+            return S_OK;
+        }
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_PRESERVE_ASPECT_RATIO:
+        {
+            const D2D1_SVG_PRESERVE_ASPECT_RATIO *par = value;
+            if (!(name = svg_enum_name(svg_align_names, ARRAY_SIZE(svg_align_names), par->align)))
+                return E_INVALIDARG;
+            if (par->defer) svg_buf_puts(buf, L"defer ");
+            svg_buf_puts(buf, name);
+            if (par->meetOrSlice == D2D1_SVG_ASPECT_SCALING_SLICE) svg_buf_puts(buf, L" slice");
+            return S_OK;
+        }
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_VIEWBOX:
+        {
+            const D2D1_SVG_VIEWBOX *vb = value;
+            svg_buf_float(buf, vb->x); svg_buf_puts(buf, L" ");
+            svg_buf_float(buf, vb->y); svg_buf_puts(buf, L" ");
+            svg_buf_float(buf, vb->width); svg_buf_puts(buf, L" ");
+            svg_buf_float(buf, vb->height);
+            return S_OK;
+        }
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_LENGTH:
+        {
+            const D2D1_SVG_LENGTH *length = value;
+            svg_buf_float(buf, length->value);
+            if (length->units == D2D1_SVG_LENGTH_UNITS_PERCENTAGE) svg_buf_puts(buf, L"%");
+            return S_OK;
+        }
+        default:
+            return E_INVALIDARG;
+    }
+    if (!name)
+        return E_INVALIDARG;
+    svg_buf_puts(buf, name);
+    return S_OK;
+}
+
+static BOOL svg_parse_preserve_aspect_ratio(const WCHAR *str, D2D1_SVG_PRESERVE_ASPECT_RATIO *par)
+{
+    const WCHAR *p = svg_skip_space(str);
+    unsigned int i;
+
+    par->defer = FALSE;
+    par->align = D2D1_SVG_ASPECT_ALIGN_X_MID_Y_MID;
+    par->meetOrSlice = D2D1_SVG_ASPECT_SCALING_MEET;
+    if (!wcsncmp(p, L"defer", 5)) { par->defer = TRUE; p = svg_skip_space(p + 5); }
+    for (i = 0; i < ARRAY_SIZE(svg_align_names); ++i)
+    {
+        size_t len = wcslen(svg_align_names[i]);
+        if (!wcsncmp(p, svg_align_names[i], len)) { par->align = i; p += len; break; }
+    }
+    if (i == ARRAY_SIZE(svg_align_names)) return FALSE;
+    p = svg_skip_space(p);
+    if (!wcsncmp(p, L"slice", 5)) { par->meetOrSlice = D2D1_SVG_ASPECT_SCALING_SLICE; p += 5; }
+    else if (!wcsncmp(p, L"meet", 4)) p += 4;
+    return !*svg_skip_space(p);
+}
+
+/* Reads SVG text as a typed value. */
+static BOOL svg_parse_pod(const WCHAR *str, D2D1_SVG_ATTRIBUTE_POD_TYPE type, void *value)
+{
+    switch (type)
+    {
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_FLOAT:
+            return svg_parse_number(&str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_COLOR:
+            return svg_parse_color(str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_FILL_MODE:
+            return svg_enum_value(svg_fill_mode_names, ARRAY_SIZE(svg_fill_mode_names), str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_DISPLAY:
+            return svg_enum_value(svg_display_names, ARRAY_SIZE(svg_display_names), str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_OVERFLOW:
+            return svg_enum_value(svg_overflow_names, ARRAY_SIZE(svg_overflow_names), str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_LINE_CAP:
+            return svg_enum_value(svg_line_cap_names, ARRAY_SIZE(svg_line_cap_names), str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_LINE_JOIN:
+            return svg_enum_value(svg_line_join_names, ARRAY_SIZE(svg_line_join_names), str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_VISIBILITY:
+            return svg_enum_value(svg_visibility_names, ARRAY_SIZE(svg_visibility_names), str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_UNIT_TYPE:
+            return svg_enum_value(svg_unit_type_names, ARRAY_SIZE(svg_unit_type_names), str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_EXTEND_MODE:
+            return svg_enum_value(svg_extend_mode_names, ARRAY_SIZE(svg_extend_mode_names), str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_MATRIX:
+            return svg_parse_transform(str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_PRESERVE_ASPECT_RATIO:
+            return svg_parse_preserve_aspect_ratio(str, value);
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_VIEWBOX:
+            return svg_parse_numbers(str, value, 4) == 4;
+        case D2D1_SVG_ATTRIBUTE_POD_TYPE_LENGTH:
+            return svg_parse_length(str, value);
+        default:
+            return FALSE;
+    }
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_SetAttributeValue_(ID2D1SvgElement *iface,
+        const WCHAR *name, D2D1_SVG_ATTRIBUTE_POD_TYPE type, const void *value, UINT32 size)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    struct svg_buf buf = {0};
+    HRESULT hr;
+
+    TRACE("iface %p, name %s, type %u, value %p, size %u.\n", iface, debugstr_w(name), type, value, size);
+
+    if (!name || !value || !svg_pod_size(type) || size != svg_pod_size(type))
+        return E_INVALIDARG;
+    if (FAILED(hr = svg_format_pod(&buf, type, value)))
+    {
+        free(buf.data);
+        return hr;
+    }
+    if (buf.failed)
+    {
+        free(buf.data);
+        return E_OUTOFMEMORY;
+    }
+    hr = svg_set_attr_string(element, name, buf.data ? buf.data : L"");
+    free(buf.data);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_SetAttributeValue(ID2D1SvgElement *iface,
+        const WCHAR *name, D2D1_SVG_ATTRIBUTE_STRING_TYPE type, const WCHAR *value)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p, name %s, type %u, value %s.\n", iface, debugstr_w(name), type, debugstr_w(value));
+
+    if (!name || !value || type > D2D1_SVG_ATTRIBUTE_STRING_TYPE_ID)
+        return E_INVALIDARG;
+    return svg_set_attr_string(element, name, value);
+}
+
+static HRESULT svg_attr_object(struct d2d_svg_element *element, const WCHAR *name, REFIID iid,
+        struct d2d_svg_attribute **out)
+{
+    enum svg_attr_kind kind;
+    struct d2d_svg_attribute *object;
+    struct svg_attr *attr;
+    HRESULT hr;
+
+    if (IsEqualGUID(iid, &IID_ID2D1SvgPaint)) kind = SVG_ATTR_PAINT;
+    else if (IsEqualGUID(iid, &IID_ID2D1SvgStrokeDashArray)) kind = SVG_ATTR_DASHES;
+    else if (IsEqualGUID(iid, &IID_ID2D1SvgPointCollection)) kind = SVG_ATTR_POINTS;
+    else if (IsEqualGUID(iid, &IID_ID2D1SvgPathData)) kind = SVG_ATTR_PATH;
+    else return E_NOINTERFACE;
+
+    if (!(attr = svg_find_attr(element, name)))
+        return E_INVALIDARG;
+    if (attr->object)
+    {
+        if (attr->object->kind != kind)
+            return E_NOINTERFACE;
+        ID2D1SvgAttribute_AddRef(&(*out = attr->object)->ID2D1SvgAttribute_iface);
+        return S_OK;
+    }
+    if (FAILED(hr = d2d_svg_attribute_create(element->factory, kind, &object)))
+        return hr;
+    if (!d2d_svg_attribute_parse(object, attr->value ? attr->value : L""))
+    {
+        ID2D1SvgAttribute_Release(&object->ID2D1SvgAttribute_iface);
+        return E_INVALIDARG;
+    }
+    svg_attr_clear_value(attr);
+    attr->object = object;
+    object->element = element;
+    ID2D1SvgAttribute_AddRef(&object->ID2D1SvgAttribute_iface);
+    *out = object;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetAttributeValue__(ID2D1SvgElement *iface,
+        const WCHAR *name, REFIID iid, void **value)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    struct d2d_svg_attribute *object;
+    HRESULT hr;
+
+    TRACE("iface %p, name %s, iid %s, value %p.\n", iface, debugstr_w(name), debugstr_guid(iid), value);
+
+    *value = NULL;
+    if (!name)
+        return E_INVALIDARG;
+    if (FAILED(hr = svg_attr_object(element, name, iid, &object)))
+    {
+        WARN("Attribute %s as %s: %#lx.\n", debugstr_w(name), debugstr_guid(iid), hr);
+        return hr;
+    }
+    *value = &object->ID2D1SvgAttribute_iface;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetAttributeValue_(ID2D1SvgElement *iface,
+        const WCHAR *name, D2D1_SVG_ATTRIBUTE_POD_TYPE type, void *value, UINT32 size)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    const WCHAR *str;
+    BYTE tmp[64];
+
+    TRACE("iface %p, name %s, type %u, value %p, size %u.\n", iface, debugstr_w(name), type, value, size);
+
+    if (!name || !value || !svg_pod_size(type) || size != svg_pod_size(type))
+        return E_INVALIDARG;
+    if (!(str = svg_get_attr(element, name)))
+    {
+        WARN("Attribute %s is not specified.\n", debugstr_w(name));
+        return E_INVALIDARG;
+    }
+    if (!svg_parse_pod(str, type, tmp))
+    {
+        WARN("Attribute %s value %s is not of type %u.\n", debugstr_w(name), debugstr_w(str), type);
+        return E_INVALIDARG;
+    }
+    memcpy(value, tmp, size);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetAttributeValue(ID2D1SvgElement *iface,
+        const WCHAR *name, D2D1_SVG_ATTRIBUTE_STRING_TYPE type, WCHAR *value, UINT32 count)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    const WCHAR *str;
+
+    TRACE("iface %p, name %s, type %u, value %p, count %u.\n", iface, debugstr_w(name), type, value, count);
+
+    if (!name || type > D2D1_SVG_ATTRIBUTE_STRING_TYPE_ID)
+        return E_INVALIDARG;
+    if (!(str = svg_get_attr(element, name)))
+    {
+        WARN("Attribute %s is not specified.\n", debugstr_w(name));
+        return E_INVALIDARG;
+    }
+    if (wcslen(str) + 1 > count)
+        return E_INVALIDARG;
+    wcscpy(value, str);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetAttributeValueLength(ID2D1SvgElement *iface,
+        const WCHAR *name, D2D1_SVG_ATTRIBUTE_STRING_TYPE type, UINT32 *length)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    const WCHAR *str;
+
+    TRACE("iface %p, name %s, type %u, length %p.\n", iface, debugstr_w(name), type, length);
+
+    if (!name || !length || type > D2D1_SVG_ATTRIBUTE_STRING_TYPE_ID)
+        return E_INVALIDARG;
+    if (!(str = svg_get_attr(element, name)))
+    {
+        WARN("Attribute %s is not specified.\n", debugstr_w(name));
+        return E_INVALIDARG;
+    }
+    *length = wcslen(str);
+    return S_OK;
+}
