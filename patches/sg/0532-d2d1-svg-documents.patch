+static HRESULT STDMETHODCALLTYPE d2d_svg_dashes_UpdateDashes(ID2D1SvgStrokeDashArray *iface,
+        const FLOAT *dashes, UINT32 count, UINT32 start)
+{
+    struct d2d_svg_attribute *attr = impl_from_ID2D1SvgStrokeDashArray(iface);
+    D2D1_SVG_LENGTH *lengths;
+    HRESULT hr;
+    UINT32 i;
+
+    TRACE("iface %p, dashes %p, count %u, start %u.\n", iface, dashes, count, start);
+
+    if (!(lengths = malloc(max(count, 1) * sizeof(*lengths))))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < count; ++i)
+    {
+        lengths[i].value = dashes[i];
+        lengths[i].units = D2D1_SVG_LENGTH_UNITS_NUMBER;
+    }
+    hr = svg_array_update(attr, lengths, count, start);
+    free(lengths);
+    return hr;
+}
