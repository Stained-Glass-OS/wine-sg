+static WCHAR *svg_strdupW(const WCHAR *s)
+{
+    WCHAR *ret;
+    size_t len;
+
+    if (!s) return NULL;
+    len = (wcslen(s) + 1) * sizeof(WCHAR);
+    if ((ret = malloc(len))) memcpy(ret, s, len);
+    return ret;
+}
+
+static WCHAR *svg_strndupW(const WCHAR *s, size_t n)
+{
+    WCHAR *ret;
+
+    if (!(ret = malloc((n + 1) * sizeof(WCHAR)))) return NULL;
+    memcpy(ret, s, n * sizeof(WCHAR));
+    ret[n] = 0;
+    return ret;
+}
+
+static BOOL svg_is_space(WCHAR c)
+{
+    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
+}
+
+static const WCHAR *svg_skip_space(const WCHAR *p)
+{
+    while (svg_is_space(*p)) ++p;
+    return p;
+}
+
+static const WCHAR *svg_skip_sep(const WCHAR *p)
+{
+    p = svg_skip_space(p);
+    if (*p == ',') p = svg_skip_space(p + 1);
+    return p;
+}
+
+/* Parses an SVG number without depending on the C locale. */
+static BOOL svg_parse_number(const WCHAR **str, float *out)
+{
+    const WCHAR *p = svg_skip_space(*str);
+    double value = 0.0, frac = 0.1;
+    BOOL negative = FALSE, digits = FALSE;
+    int exponent = 0, exp_sign = 1;
+
+    if (*p == '+' || *p == '-') negative = *p++ == '-';
+    while (*p >= '0' && *p <= '9') { value = value * 10.0 + (*p++ - '0'); digits = TRUE; }
+    if (*p == '.')
+    {
+        ++p;
+        while (*p >= '0' && *p <= '9') { value += (*p++ - '0') * frac; frac *= 0.1; digits = TRUE; }
+    }
+    if (!digits) return FALSE;
+    if ((*p == 'e' || *p == 'E') && (p[1] == '-' || p[1] == '+' || (p[1] >= '0' && p[1] <= '9')))
+    {
+        ++p;
+        if (*p == '+' || *p == '-') exp_sign = *p++ == '-' ? -1 : 1;
+        while (*p >= '0' && *p <= '9') exponent = exponent * 10 + (*p++ - '0');
+        value *= pow(10.0, exp_sign * exponent);
+    }
+    *out = negative ? -value : value;
+    *str = p;
+    return TRUE;
+}
+
+/* Parses a list of numbers separated by spaces and/or commas. */
+static UINT32 svg_parse_numbers(const WCHAR *str, float *out, UINT32 max)
+{
+    UINT32 count = 0;
+
+    str = svg_skip_space(str);
+    while (*str && count < max)
+    {
+        if (!svg_parse_number(&str, &out[count])) break;
+        ++count;
+        str = svg_skip_sep(str);
+    }
+    return count;
+}
+
+static BOOL svg_parse_length(const WCHAR *str, D2D1_SVG_LENGTH *length)
+{
+    if (!str || !svg_parse_number(&str, &length->value)) return FALSE;
+    length->units = *str == '%' ? D2D1_SVG_LENGTH_UNITS_PERCENTAGE : D2D1_SVG_LENGTH_UNITS_NUMBER;
+    return TRUE;
+}
+
+static void svg_format_float(WCHAR *buf, size_t size, float f)
+{
+    swprintf(buf, size, L"%g", f);
+}
+
+/* A growable string for serialization. */
+struct svg_buf
+{
+    WCHAR *data;
+    size_t len, size;
+    BOOL failed;
+};
+
+static void svg_buf_append(struct svg_buf *buf, const WCHAR *s, size_t n)
+{
+    if (buf->failed) return;
+    if (buf->len + n + 1 > buf->size)
+    {
+        size_t size = max(buf->size * 2, buf->len + n + 64);
+        WCHAR *data;
+
+        if (!(data = realloc(buf->data, size * sizeof(WCHAR))))
+        {
+            buf->failed = TRUE;
+            return;
+        }
+        buf->data = data;
+        buf->size = size;
+    }
+    memcpy(buf->data + buf->len, s, n * sizeof(WCHAR));
+    buf->len += n;
+    buf->data[buf->len] = 0;
+}
+
+static void svg_buf_puts(struct svg_buf *buf, const WCHAR *s)
+{
+    svg_buf_append(buf, s, wcslen(s));
+}
+
+static void svg_buf_float(struct svg_buf *buf, float f)
+{
+    WCHAR tmp[32];
+
+    svg_format_float(tmp, ARRAY_SIZE(tmp), f);
+    svg_buf_puts(buf, tmp);
+}
