+/* Builds geometry from path data.  Arcs use the sink's own arc segment,
+ * which takes SVG's endpoint parameters. */
+static void svg_path_to_sink(const struct d2d_svg_attribute *path, ID2D1GeometrySink *sink)
+{
+    const float *d = path->data;
+    D2D1_POINT_2F cur = {0.0f, 0.0f}, start = {0.0f, 0.0f}, ctrl = {0.0f, 0.0f};
+    D2D1_SVG_PATH_COMMAND prev = D2D1_SVG_PATH_COMMAND_CLOSE_PATH;
+    BOOL open = FALSE;
+    UINT32 i, k = 0;
+
+    for (i = 0; i < path->command_count; ++i)
+    {
+        D2D1_SVG_PATH_COMMAND command = path->commands[i];
+        unsigned int args = svg_path_command_args(command);
+        BOOL relative = command != D2D1_SVG_PATH_COMMAND_CLOSE_PATH && !(command & 1);
+        D2D1_POINT_2F base = relative ? cur : (D2D1_POINT_2F){0.0f, 0.0f};
+        D2D1_POINT_2F p1, p2, p3;
+
+        if (args == ~0u || k + args > path->count) break;
+
+        if (command != D2D1_SVG_PATH_COMMAND_MOVE_ABSOLUTE && command != D2D1_SVG_PATH_COMMAND_MOVE_RELATIVE
+                && command != D2D1_SVG_PATH_COMMAND_CLOSE_PATH && !open)
+        {
+            ID2D1GeometrySink_BeginFigure(sink, cur, D2D1_FIGURE_BEGIN_FILLED);
+            start = cur;
+            open = TRUE;
+        }
+
+        switch (command)
+        {
+            case D2D1_SVG_PATH_COMMAND_CLOSE_PATH:
+                if (open) ID2D1GeometrySink_EndFigure(sink, D2D1_FIGURE_END_CLOSED);
+                open = FALSE;
+                cur = start;
+                break;
+
+            case D2D1_SVG_PATH_COMMAND_MOVE_ABSOLUTE:
+            case D2D1_SVG_PATH_COMMAND_MOVE_RELATIVE:
+                if (open) ID2D1GeometrySink_EndFigure(sink, D2D1_FIGURE_END_OPEN);
+                cur.x = base.x + d[k];
+                cur.y = base.y + d[k + 1];
+                ID2D1GeometrySink_BeginFigure(sink, cur, D2D1_FIGURE_BEGIN_FILLED);
+                start = cur;
+                open = TRUE;
+                break;
+
+            case D2D1_SVG_PATH_COMMAND_LINE_ABSOLUTE:
+            case D2D1_SVG_PATH_COMMAND_LINE_RELATIVE:
+                cur.x = base.x + d[k];
+                cur.y = base.y + d[k + 1];
+                ID2D1GeometrySink_AddLine(sink, cur);
+                break;
+
+            case D2D1_SVG_PATH_COMMAND_HORIZONTAL_ABSOLUTE:
+            case D2D1_SVG_PATH_COMMAND_HORIZONTAL_RELATIVE:
+                cur.x = base.x + d[k];
+                ID2D1GeometrySink_AddLine(sink, cur);
+                break;
+
+            case D2D1_SVG_PATH_COMMAND_VERTICAL_ABSOLUTE:
+            case D2D1_SVG_PATH_COMMAND_VERTICAL_RELATIVE:
+                cur.y = (relative ? cur.y : 0.0f) + d[k];
+                ID2D1GeometrySink_AddLine(sink, cur);
+                break;
+
+            case D2D1_SVG_PATH_COMMAND_CUBIC_ABSOLUTE:
+            case D2D1_SVG_PATH_COMMAND_CUBIC_RELATIVE:
+            case D2D1_SVG_PATH_COMMAND_CUBIC_SMOOTH_ABSOLUTE:
+            case D2D1_SVG_PATH_COMMAND_CUBIC_SMOOTH_RELATIVE:
+            {
+                D2D1_BEZIER_SEGMENT bezier;
+                unsigned int j = 0;
+
+                if (command == D2D1_SVG_PATH_COMMAND_CUBIC_ABSOLUTE || command == D2D1_SVG_PATH_COMMAND_CUBIC_RELATIVE)
+                {
+                    p1.x = base.x + d[k]; p1.y = base.y + d[k + 1];
+                    j = 2;
+                }
+                else if (prev >= D2D1_SVG_PATH_COMMAND_CUBIC_ABSOLUTE && (prev <= D2D1_SVG_PATH_COMMAND_CUBIC_RELATIVE
+                        || prev == D2D1_SVG_PATH_COMMAND_CUBIC_SMOOTH_ABSOLUTE
+                        || prev == D2D1_SVG_PATH_COMMAND_CUBIC_SMOOTH_RELATIVE))
+                {
+                    p1.x = 2.0f * cur.x - ctrl.x; p1.y = 2.0f * cur.y - ctrl.y;
+                }
+                else p1 = cur;
+                p2.x = base.x + d[k + j]; p2.y = base.y + d[k + j + 1];
+                p3.x = base.x + d[k + j + 2]; p3.y = base.y + d[k + j + 3];
+                bezier.point1 = p1; bezier.point2 = p2; bezier.point3 = p3;
+                ID2D1GeometrySink_AddBezier(sink, &bezier);
+                ctrl = p2;
+                cur = p3;
+                break;
+            }
+
+            case D2D1_SVG_PATH_COMMAND_QUADRADIC_ABSOLUTE:
+            case D2D1_SVG_PATH_COMMAND_QUADRADIC_RELATIVE:
+            case D2D1_SVG_PATH_COMMAND_QUADRADIC_SMOOTH_ABSOLUTE:
+            case D2D1_SVG_PATH_COMMAND_QUADRADIC_SMOOTH_RELATIVE:
+            {
+                D2D1_QUADRATIC_BEZIER_SEGMENT quad;
+                unsigned int j = 0;
+
+                if (command == D2D1_SVG_PATH_COMMAND_QUADRADIC_ABSOLUTE
+                        || command == D2D1_SVG_PATH_COMMAND_QUADRADIC_RELATIVE)
+                {
+                    p1.x = base.x + d[k]; p1.y = base.y + d[k + 1];
+                    j = 2;
+                }
+                else if (prev == D2D1_SVG_PATH_COMMAND_QUADRADIC_ABSOLUTE
+                        || prev == D2D1_SVG_PATH_COMMAND_QUADRADIC_RELATIVE
+                        || prev == D2D1_SVG_PATH_COMMAND_QUADRADIC_SMOOTH_ABSOLUTE
+                        || prev == D2D1_SVG_PATH_COMMAND_QUADRADIC_SMOOTH_RELATIVE)
+                {
+                    p1.x = 2.0f * cur.x - ctrl.x; p1.y = 2.0f * cur.y - ctrl.y;
+                }
+                else p1 = cur;
+                p2.x = base.x + d[k + j]; p2.y = base.y + d[k + j + 1];
+                quad.point1 = p1; quad.point2 = p2;
+                ID2D1GeometrySink_AddQuadraticBezier(sink, &quad);
+                ctrl = p1;
+                cur = p2;
+                break;
+            }
+
+            case D2D1_SVG_PATH_COMMAND_ARC_ABSOLUTE:
+            case D2D1_SVG_PATH_COMMAND_ARC_RELATIVE:
+            {
+                D2D1_ARC_SEGMENT arc;
+
+                p1.x = base.x + d[k + 5]; p1.y = base.y + d[k + 6];
+                if (d[k] == 0.0f || d[k + 1] == 0.0f)
+                {
+                    ID2D1GeometrySink_AddLine(sink, p1);
+                }
+                else
+                {
+                    arc.point = p1;
+                    arc.size.width = fabsf(d[k]);
+                    arc.size.height = fabsf(d[k + 1]);
+                    arc.rotationAngle = d[k + 2];
+                    arc.arcSize = d[k + 3] != 0.0f ? D2D1_ARC_SIZE_LARGE : D2D1_ARC_SIZE_SMALL;
+                    arc.sweepDirection = d[k + 4] != 0.0f ? D2D1_SWEEP_DIRECTION_CLOCKWISE
+                            : D2D1_SWEEP_DIRECTION_COUNTER_CLOCKWISE;
+                    ID2D1GeometrySink_AddArc(sink, &arc);
+                }
+                cur = p1;
+                break;
+            }
+
+            default:
+                break;
+        }
+        k += args;
+        prev = command;
+    }
+    if (open) ID2D1GeometrySink_EndFigure(sink, D2D1_FIGURE_END_OPEN);
+}
+
+static HRESULT svg_path_create_geometry(const struct d2d_svg_attribute *path, ID2D1Factory *factory,
+        D2D1_FILL_MODE fill_mode, ID2D1PathGeometry1 **out)
+{
+    ID2D1GeometrySink *sink;
+    ID2D1Factory1 *factory1;
+    ID2D1PathGeometry1 *geometry;
+    HRESULT hr;
+
+    if (FAILED(hr = ID2D1Factory_QueryInterface(factory, &IID_ID2D1Factory1, (void **)&factory1)))
+        return hr;
+    hr = ID2D1Factory1_CreatePathGeometry(factory1, &geometry);
+    ID2D1Factory1_Release(factory1);
+    if (FAILED(hr))
+        return hr;
+    if (FAILED(hr = ID2D1PathGeometry1_Open(geometry, &sink)))
+    {
+        ID2D1PathGeometry1_Release(geometry);
+        return hr;
+    }
+    ID2D1GeometrySink_SetFillMode(sink, fill_mode);
+    svg_path_to_sink(path, sink);
+    hr = ID2D1GeometrySink_Close(sink);
+    ID2D1GeometrySink_Release(sink);
+    if (FAILED(hr))
+    {
+        ID2D1PathGeometry1_Release(geometry);
+        return hr;
+    }
+    *out = geometry;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_path_CreatePathGeometry(ID2D1SvgPathData *iface,
+        D2D1_FILL_MODE fill_mode, ID2D1PathGeometry1 **geometry)
+{
+    struct d2d_svg_attribute *path = impl_from_ID2D1SvgPathData(iface);
+
+    TRACE("iface %p, fill_mode %u, geometry %p.\n", iface, fill_mode, geometry);
+
+    return svg_path_create_geometry(path, path->factory, fill_mode, geometry);
+}
