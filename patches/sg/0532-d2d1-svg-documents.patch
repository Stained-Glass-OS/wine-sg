+/* Array helpers shared by dashes, points and segment data. */
+
+static HRESULT svg_array_remove_at_end(struct d2d_svg_attribute *attr, UINT32 count)
+{
+    if (count > attr->count)
+        return E_INVALIDARG;
+    attr->count -= count;
+    return S_OK;
+}
+
+static HRESULT svg_array_update(struct d2d_svg_attribute *attr, const void *src, UINT32 count, UINT32 start)
+{
+    if (start > attr->count)
+        return E_INVALIDARG;
+    if (!svg_array_reserve(&attr->data, &attr->capacity, start + count, attr->elem_size))
+        return E_OUTOFMEMORY;
+    memcpy((BYTE *)attr->data + (size_t)start * attr->elem_size, src, (size_t)count * attr->elem_size);
+    attr->count = max(attr->count, start + count);
+    return S_OK;
+}
+
+static HRESULT svg_array_get(const struct d2d_svg_attribute *attr, void *dst, UINT32 count, UINT32 start)
+{
+    if (start > attr->count || count > attr->count - start)
+        return E_INVALIDARG;
+    memcpy(dst, (BYTE *)attr->data + (size_t)start * attr->elem_size, (size_t)count * attr->elem_size);
+    return S_OK;
+}
