+static HRESULT d2d_svg_element_create(ID2D1Factory *factory, struct d2d_svg_document *document,
+        const WCHAR *tag, BOOL is_text, struct d2d_svg_element **out)
+{
+    struct d2d_svg_element *element;
+
+    if (!(element = calloc(1, sizeof(*element))))
+        return E_OUTOFMEMORY;
+    if (!(element->tag = svg_strdupW(tag)))
+    {
+        free(element);
+        return E_OUTOFMEMORY;
+    }
+    element->ID2D1SvgElement_iface.lpVtbl = &d2d_svg_element_vtbl;
+    element->refcount = 1;
+    element->is_text = is_text;
+    element->document = document;
+    list_init(&element->children);
+    list_init(&element->attrs);
+    list_init(&element->entry);
+    ID2D1Factory_AddRef(element->factory = factory);
+    *out = element;
+    return S_OK;
+}
