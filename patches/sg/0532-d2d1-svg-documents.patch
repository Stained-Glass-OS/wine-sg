+static int svg_hex(WCHAR c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static BOOL svg_parse_color(const WCHAR *str, D2D1_COLOR_F *color)
+{
+    unsigned int i, rgb = 0;
+    size_t len;
+
+    str = svg_skip_space(str);
+    for (len = wcslen(str); len && svg_is_space(str[len - 1]); --len);
+    color->a = 1.0f;
+
+    if (*str == '#')
+    {
+        if (len == 7)
+        {
+            for (i = 1; i < 7; ++i)
+            {
+                if (svg_hex(str[i]) < 0) return FALSE;
+                rgb = (rgb << 4) | svg_hex(str[i]);
+            }
+        }
+        else if (len == 4)
+        {
+            for (i = 1; i < 4; ++i)
+            {
+                if (svg_hex(str[i]) < 0) return FALSE;
+                rgb = (rgb << 8) | (svg_hex(str[i]) * 0x11);
+            }
+        }
+        else return FALSE;
+    }
+    else if (!wcsnicmp(str, L"rgb(", 4))
+    {
+        const WCHAR *p = str + 4;
+        float c[3];
+
+        for (i = 0; i < 3; ++i)
+        {
+            p = svg_skip_space(p);
+            if (!svg_parse_number(&p, &c[i])) return FALSE;
+            if (*p == '%') { c[i] = c[i] * 255.0f / 100.0f; ++p; }
+            c[i] = min(max(c[i], 0.0f), 255.0f);
+            p = svg_skip_sep(p);
+        }
+        if (*p != ')') return FALSE;
+        color->r = c[0] / 255.0f;
+        color->g = c[1] / 255.0f;
+        color->b = c[2] / 255.0f;
+        return TRUE;
+    }
+    else
+    {
+        for (i = 0; i < ARRAY_SIZE(svg_named_colors); ++i)
+        {
+            if (wcslen(svg_named_colors[i].name) == len && !wcsnicmp(str, svg_named_colors[i].name, len))
+                break;
+        }
+        if (i == ARRAY_SIZE(svg_named_colors)) return FALSE;
+        rgb = svg_named_colors[i].rgb;
+    }
+
+    color->r = ((rgb >> 16) & 0xff) / 255.0f;
+    color->g = ((rgb >> 8) & 0xff) / 255.0f;
+    color->b = (rgb & 0xff) / 255.0f;
+    return TRUE;
+}
+
+static void svg_format_color(WCHAR *buf, size_t size, const D2D1_COLOR_F *color)
+{
+    unsigned int r = lroundf(min(max(color->r, 0.0f), 1.0f) * 255.0f);
+    unsigned int g = lroundf(min(max(color->g, 0.0f), 1.0f) * 255.0f);
+    unsigned int b = lroundf(min(max(color->b, 0.0f), 1.0f) * 255.0f);
+
+    swprintf(buf, size, L"#%02X%02X%02X", r, g, b);
+}
