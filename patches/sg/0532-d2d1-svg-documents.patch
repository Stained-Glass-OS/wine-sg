+static HRESULT d2d_svg_element_create(ID2D1Factory *factory, struct d2d_svg_document *document,
+        const WCHAR *tag, BOOL is_text, struct d2d_svg_element **out);
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_QueryInterface(ID2D1SvgElement *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_ID2D1SvgElement)
+            || IsEqualGUID(iid, &IID_ID2D1Resource)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        ID2D1SvgElement_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_svg_element_AddRef(ID2D1SvgElement *iface)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    ULONG refcount = InterlockedIncrement(&element->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static void d2d_svg_element_detach(struct d2d_svg_element *child)
+{
+    list_remove(&child->entry);
+    child->parent = NULL;
+    ID2D1SvgElement_Release(&child->ID2D1SvgElement_iface);
+}
+
+static ULONG STDMETHODCALLTYPE d2d_svg_element_Release(ID2D1SvgElement *iface)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    ULONG refcount = InterlockedDecrement(&element->refcount);
+    struct d2d_svg_element *child, *next_child;
+    struct svg_attr *attr, *next_attr;
+
+    TRACE("%p decreasing refcount to %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE(child, next_child, &element->children, struct d2d_svg_element, entry)
+            d2d_svg_element_detach(child);
+        LIST_FOR_EACH_ENTRY_SAFE(attr, next_attr, &element->attrs, struct svg_attr, entry)
+            svg_attr_free(attr);
+        ID2D1Factory_Release(element->factory);
+        free(element->tag);
+        free(element->text);
+        free(element);
+    }
+
+    return refcount;
+}
+
+static void STDMETHODCALLTYPE d2d_svg_element_GetFactory(ID2D1SvgElement *iface, ID2D1Factory **factory)
