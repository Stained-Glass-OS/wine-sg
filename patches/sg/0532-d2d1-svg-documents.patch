+static BOOL svg_is_ancestor(const struct d2d_svg_element *ancestor, const struct d2d_svg_element *element)
+{
+    for (; element; element = element->parent)
+    {
+        if (element == ancestor) return TRUE;
+    }
+    return FALSE;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_InsertChildBefore(ID2D1SvgElement *iface,
+        ID2D1SvgElement *new_child, ID2D1SvgElement *reference)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface), *child, *ref = NULL;
+
+    TRACE("iface %p, new_child %p, reference %p.\n", iface, new_child, reference);
+
+    if (!(child = unsafe_impl_from_ID2D1SvgElement(new_child)) || svg_is_ancestor(child, element))
+        return E_INVALIDARG;
+    if (reference && !(ref = svg_child_of(element, reference)))
+        return E_INVALIDARG;
+    if (child == ref)
+        return S_OK;
+    if (element->is_text)
+        return E_INVALIDARG;
+
+    ID2D1SvgElement_AddRef(new_child);
+    if (child->parent)
+        d2d_svg_element_detach(child);
+    child->parent = element;
+    if (ref)
+        list_add_before(&ref->entry, &child->entry);
+    else
+        list_add_tail(&element->children, &child->entry);
+    d2d_svg_element_set_document(child, element->document);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_AppendChild(ID2D1SvgElement *iface, ID2D1SvgElement *new_child)
+{
+    TRACE("iface %p, new_child %p.\n", iface, new_child);
+
+    return d2d_svg_element_InsertChildBefore(iface, new_child, NULL);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_ReplaceChild(ID2D1SvgElement *iface,
+        ID2D1SvgElement *new_child, ID2D1SvgElement *old_child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface), *old;
+    HRESULT hr;
+
+    TRACE("iface %p, new_child %p, old_child %p.\n", iface, new_child, old_child);
+
+    if (!(old = svg_child_of(element, old_child)))
+        return E_INVALIDARG;
+    if (new_child == old_child)
+        return S_OK;
+    if (FAILED(hr = d2d_svg_element_InsertChildBefore(iface, new_child, old_child)))
+        return hr;
+    d2d_svg_element_detach(old);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_RemoveChild(ID2D1SvgElement *iface, ID2D1SvgElement *old_child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface), *old;
+
+    TRACE("iface %p, old_child %p.\n", iface, old_child);
+
+    if (!(old = svg_child_of(element, old_child)))
+        return E_INVALIDARG;
+    d2d_svg_element_set_document(old, NULL);
+    d2d_svg_element_detach(old);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_CreateChild(ID2D1SvgElement *iface,
+        const WCHAR *tag, ID2D1SvgElement **new_child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface), *child;
+    HRESULT hr;
+
+    TRACE("iface %p, tag %s, new_child %p.\n", iface, debugstr_w(tag), new_child);
+
+    *new_child = NULL;
+    if (!tag || !*tag || element->is_text)
+        return E_INVALIDARG;
+    if (FAILED(hr = d2d_svg_element_create(element->factory, element->document, tag, FALSE, &child)))
+        return hr;
+    child->parent = element;
+    list_add_tail(&element->children, &child->entry);
+    ID2D1SvgElement_AddRef(*new_child = &child->ID2D1SvgElement_iface);
+    return S_OK;
+}
