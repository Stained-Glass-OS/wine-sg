+
+WINE_DEFAULT_DEBUG_CHANNEL(d2d);
+
+#define SVG_PI 3.14159265358979323846f
+
+/* SVG documents (ID2D1DeviceContext5::CreateSvgDocument): a tree of
+ * elements with attributes, parsed from and written to XML, and drawn with
+ * the device context's own geometry and brush calls.  Attributes are kept
+ * as SVG strings; typed getters parse them, typed setters write them.  An
+ * attribute object (paint, dash array, points, path data) handed out by
+ * GetAttributeValue stays live: it becomes the attribute's value, so
+ * changing it changes the element, as on Windows. */
+
+struct d2d_svg_document;
+struct d2d_svg_element;
+
+enum svg_attr_kind
+{
+    SVG_ATTR_PAINT,
+    SVG_ATTR_DASHES,
+    SVG_ATTR_POINTS,
+    SVG_ATTR_PATH,
+};
+
+struct d2d_svg_attribute
+{
+    union
+    {
+        ID2D1SvgAttribute ID2D1SvgAttribute_iface;
+        ID2D1SvgPaint ID2D1SvgPaint_iface;
+        ID2D1SvgStrokeDashArray ID2D1SvgStrokeDashArray_iface;
+        ID2D1SvgPointCollection ID2D1SvgPointCollection_iface;
+        ID2D1SvgPathData ID2D1SvgPathData_iface;
+    };
+    LONG refcount;
+    enum svg_attr_kind kind;
+    ID2D1Factory *factory;
+    struct d2d_svg_element *element;    /* weak; the element that holds it */
+
+    /* paint */
+    D2D1_SVG_PAINT_TYPE paint_type;
+    D2D1_COLOR_F color;
+    WCHAR *id;
+    /* dashes, points, path segment data */
+    void *data;
+    UINT32 count, capacity, elem_size;
+    /* path commands */
