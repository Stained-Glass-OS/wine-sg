+
+static struct svg_attr *svg_find_attr(const struct d2d_svg_element *element, const WCHAR *name)
+{
+    struct svg_attr *attr;
+
+    LIST_FOR_EACH_ENTRY(attr, &element->attrs, struct svg_attr, entry)
+    {
+        if (!wcscmp(attr->name, name))
+            return attr;
+    }
+    return NULL;
+}
+
+static void svg_attr_clear_value(struct svg_attr *attr)
+{
+    free(attr->value);
+    attr->value = NULL;
+    if (attr->object)
+    {
+        attr->object->element = NULL;
+        ID2D1SvgAttribute_Release(&attr->object->ID2D1SvgAttribute_iface);
+        attr->object = NULL;
+    }
+}
+
+static void svg_attr_free(struct svg_attr *attr)
+{
+    list_remove(&attr->entry);
+    svg_attr_clear_value(attr);
+    free(attr->name);
+    free(attr);
+}
+
+static struct svg_attr *svg_get_or_add_attr(struct d2d_svg_element *element, const WCHAR *name)
+{
+    struct svg_attr *attr;
+
+    if ((attr = svg_find_attr(element, name)))
+        return attr;
+    if (!(attr = calloc(1, sizeof(*attr))))
+        return NULL;
+    if (!(attr->name = svg_strdupW(name)))
+    {
+        free(attr);
+        return NULL;
+    }
+    list_add_tail(&element->attrs, &attr->entry);
+    return attr;
+}
+
+/* Returns the attribute's value as a string, or NULL.  The string is owned by
+ * the attribute; objects are serialized into it. */
+static const WCHAR *svg_attr_string(struct svg_attr *attr)
+{
+    struct svg_buf buf = {0};
+
+    if (!attr->object)
+        return attr->value;
+    d2d_svg_attribute_serialize(attr->object, &buf);
+    if (buf.failed)
+    {
+        free(buf.data);
+        return NULL;
+    }
+    free(attr->value);
+    attr->value = buf.data ? buf.data : svg_strdupW(L"");
+    return attr->value;
+}
+
+static const WCHAR *svg_get_attr(struct d2d_svg_element *element, const WCHAR *name)
+{
+    struct svg_attr *attr;
+
+    if (!element || !(attr = svg_find_attr(element, name)))
+        return NULL;
+    return svg_attr_string(attr);
+}
+
+static HRESULT svg_set_attr_string(struct d2d_svg_element *element, const WCHAR *name, const WCHAR *value)
+{
+    struct svg_attr *attr;
+    WCHAR *copy;
+
+    if (!(copy = svg_strdupW(value)))
+        return E_OUTOFMEMORY;
+    if (!(attr = svg_get_or_add_attr(element, name)))
+    {
+        free(copy);
+        return E_OUTOFMEMORY;
+    }
+    svg_attr_clear_value(attr);
+    attr->value = copy;
+    return S_OK;
+}
