+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetPreviousChild(ID2D1SvgElement *iface,
+        ID2D1SvgElement *reference, ID2D1SvgElement **previous)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface), *child;
+
+    TRACE("iface %p, reference %p, previous %p.\n", iface, reference, previous);
+
+    *previous = NULL;
+    if (!(child = svg_child_of(element, reference)))
+        return E_INVALIDARG;
+    svg_return_element(list_prev(&element->children, &child->entry), previous);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetNextChild(ID2D1SvgElement *iface,
+        ID2D1SvgElement *reference, ID2D1SvgElement **next)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface), *child;
+
+    TRACE("iface %p, reference %p, next %p.\n", iface, reference, next);
+
+    *next = NULL;
+    if (!(child = svg_child_of(element, reference)))
+        return E_INVALIDARG;
+    svg_return_element(list_next(&element->children, &child->entry), next);
+    return S_OK;
+}
