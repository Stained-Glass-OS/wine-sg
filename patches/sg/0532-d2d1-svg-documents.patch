+/* XML                                                                    */
+
+static BOOL svg_is_blank(const WCHAR *s)
+{
+    return !*svg_skip_space(s);
+}
+
+/* Parses an SVG document or fragment into an element tree. */
+static HRESULT svg_parse_stream(IStream *stream, ID2D1Factory *factory, struct d2d_svg_document *document,
+        struct d2d_svg_element **out)
+{
+    struct d2d_svg_element *root = NULL, *current = NULL, *element;
+    XmlNodeType node_type;
+    IXmlReader *reader;
+    const WCHAR *name, *value;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL)))
+        return hr;
+    IXmlReader_SetProperty(reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Parse);
+    if (FAILED(hr = IXmlReader_SetInput(reader, (IUnknown *)stream)))
+        goto done;
+
+    while ((hr = IXmlReader_Read(reader, &node_type)) == S_OK)
+    {
+        switch (node_type)
+        {
+            case XmlNodeType_Element:
+            {
+                BOOL empty = IXmlReader_IsEmptyElement(reader);
+
+                if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL)))
+                    goto done;
+                if (!current && root)
+                {
+                    WARN("Content after the root element.\n");
+                    hr = E_INVALIDARG;
+                    goto done;
+                }
+                if (FAILED(hr = d2d_svg_element_create(factory, document, name, FALSE, &element)))
+                    goto done;
+                if (current)
+                {
+                    element->parent = current;
+                    list_add_tail(&current->children, &element->entry);
+                }
+                else root = element;
+
+                for (hr = IXmlReader_MoveToFirstAttribute(reader); hr == S_OK;
+                        hr = IXmlReader_MoveToNextAttribute(reader))
+                {
+                    const WCHAR *prefix;
+
+                    if (IXmlReader_IsDefault(reader)) continue;
+                    if (FAILED(IXmlReader_GetPrefix(reader, &prefix, NULL))) prefix = L"";
+                    if (FAILED(IXmlReader_GetQualifiedName(reader, &name, NULL))) continue;
+                    if (!wcscmp(prefix, L"xmlns") || !wcscmp(name, L"xmlns")) continue;
+                    if (FAILED(IXmlReader_GetValue(reader, &value, NULL))) continue;
+                    if (FAILED(hr = svg_set_attr_string(element, name, value)))
+                        goto done;
+                }
+                IXmlReader_MoveToElement(reader);
+                if (!empty) current = element;
+                break;
+            }
+
+            case XmlNodeType_EndElement:
+                if (current) current = current->parent;
+                break;
+
+            case XmlNodeType_Text:
+            case XmlNodeType_CDATA:
+            case XmlNodeType_Whitespace:
+                if (!current) break;
+                if (FAILED(IXmlReader_GetValue(reader, &value, NULL))) break;
+                if (node_type != XmlNodeType_CDATA && svg_is_blank(value)) break;
+                if (FAILED(hr = d2d_svg_element_create(factory, document, L"", TRUE, &element)))
+                    goto done;
+                element->text = svg_strdupW(value);
+                element->parent = current;
+                list_add_tail(&current->children, &element->entry);
+                break;
+
+            default:
+                break;
+        }
+    }
+    if (hr == S_FALSE) hr = S_OK;
+    if (SUCCEEDED(hr) && !root)
+    {
+        WARN("No root element.\n");
+        hr = E_INVALIDARG;
+    }
+
+done:
+    IXmlReader_Release(reader);
+    if (FAILED(hr))
+    {
+        WARN("Failed to parse the SVG, hr %#lx.\n", hr);
+        if (root) ID2D1SvgElement_Release(&root->ID2D1SvgElement_iface);
+        return hr;
+    }
+    *out = root;
+    return S_OK;
+}
+
+static void svg_buf_escaped(struct svg_buf *buf, const WCHAR *s, BOOL attribute)
+{
+    for (; *s; ++s)
+    {
+        switch (*s)
+        {
+            case '&': svg_buf_puts(buf, L"&amp;"); break;
+            case '<': svg_buf_puts(buf, L"&lt;"); break;
+            case '>': svg_buf_puts(buf, L"&gt;"); break;
+            case '"':
+                if (attribute) { svg_buf_puts(buf, L"&quot;"); break; }
+                /* fall through */
+            default: svg_buf_append(buf, s, 1); break;
+        }
+    }
+}
+
+static void svg_serialize_element(struct svg_buf *buf, struct d2d_svg_element *element, BOOL root)
+{
+    struct d2d_svg_element *child;
+    struct svg_attr *attr;
+
+    if (element->is_text)
+    {
+        svg_buf_escaped(buf, element->text ? element->text : L"", FALSE);
+        return;
+    }
+    svg_buf_puts(buf, L"<");
+    svg_buf_puts(buf, element->tag);
+    if (root && !wcscmp(element->tag, L"svg"))
+        svg_buf_puts(buf, L" xmlns=\"http://www.w3.org/2000/svg\"");
+    LIST_FOR_EACH_ENTRY(attr, &element->attrs, struct svg_attr, entry)
+    {
+        const WCHAR *value = svg_attr_string(attr);
+
+        svg_buf_puts(buf, L" ");
+        svg_buf_puts(buf, attr->name);
+        svg_buf_puts(buf, L"=\"");
+        svg_buf_escaped(buf, value ? value : L"", TRUE);
+        svg_buf_puts(buf, L"\"");
+    }
+    if (list_empty(&element->children))
+    {
+        svg_buf_puts(buf, L"/>");
+        return;
+    }
+    svg_buf_puts(buf, L">");
+    LIST_FOR_EACH_ENTRY(child, &element->children, struct d2d_svg_element, entry)
+        svg_serialize_element(buf, child, FALSE);
+    svg_buf_puts(buf, L"</");
+    svg_buf_puts(buf, element->tag);
+    svg_buf_puts(buf, L">");
+}
+
+static HRESULT svg_write_utf8(IStream *stream, const struct svg_buf *buf)
+{
+    int len;
+    char *utf8;
+    HRESULT hr;
+
+    len = WideCharToMultiByte(CP_UTF8, 0, buf->data, buf->len, NULL, 0, NULL, NULL);
+    if (!(utf8 = malloc(max(len, 1))))
+        return E_OUTOFMEMORY;
+    WideCharToMultiByte(CP_UTF8, 0, buf->data, buf->len, utf8, len, NULL, NULL);
+    hr = IStream_Write(stream, utf8, len, NULL);
+    free(utf8);
+    return hr;
+}
