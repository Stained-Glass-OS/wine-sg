+/* ---------------------------------------------------------------------- */
+/* Documents                                                              */
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_document_QueryInterface(ID2D1SvgDocument *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_ID2D1SvgDocument)
+            || IsEqualGUID(iid, &IID_ID2D1Resource)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        ID2D1SvgDocument_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_svg_document_AddRef(ID2D1SvgDocument *iface)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+    ULONG refcount = InterlockedIncrement(&document->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static void d2d_svg_document_drop_root(struct d2d_svg_document *document)
+{
+    if (!document->root)
+        return;
+    d2d_svg_element_set_document(document->root, NULL);
+    ID2D1SvgElement_Release(&document->root->ID2D1SvgElement_iface);
+    document->root = NULL;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_svg_document_Release(ID2D1SvgDocument *iface)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+    ULONG refcount = InterlockedDecrement(&document->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        d2d_svg_document_drop_root(document);
+        ID2D1Factory_Release(document->factory);
+        free(document);
+    }
+
+    return refcount;
+}
+
+static void STDMETHODCALLTYPE d2d_svg_document_GetFactory(ID2D1SvgDocument *iface, ID2D1Factory **factory)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+
+    TRACE("iface %p, factory %p.\n", iface, factory);
+
+    ID2D1Factory_AddRef(*factory = document->factory);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_document_SetViewportSize(ID2D1SvgDocument *iface, D2D1_SIZE_F size)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+
+    TRACE("iface %p, size %.8e x %.8e.\n", iface, size.width, size.height);
+
+    if (size.width < 0.0f || size.height < 0.0f)
+        return E_INVALIDARG;
+    document->viewport = size;
+    return S_OK;
+}
+
+static D2D1_SIZE_F * STDMETHODCALLTYPE d2d_svg_document_GetViewportSize(ID2D1SvgDocument *iface, D2D1_SIZE_F *size)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+
+    TRACE("iface %p, size %p.\n", iface, size);
+
+    *size = document->viewport;
+    return size;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_document_SetRoot(ID2D1SvgDocument *iface, ID2D1SvgElement *root)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+    struct d2d_svg_element *element = NULL;
+
+    TRACE("iface %p, root %p.\n", iface, root);
+
+    if (root)
+    {
+        if (!(element = unsafe_impl_from_ID2D1SvgElement(root)) || element->parent
+                || wcscmp(element->tag, L"svg"))
+            return E_INVALIDARG;
+        if (element == document->root)
+            return S_OK;
+        ID2D1SvgElement_AddRef(root);
+    }
+    d2d_svg_document_drop_root(document);
+    if ((document->root = element))
+        d2d_svg_element_set_document(element, document);
+    return S_OK;
+}
+
+static void STDMETHODCALLTYPE d2d_svg_document_GetRoot(ID2D1SvgDocument *iface, ID2D1SvgElement **root)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+
+    TRACE("iface %p, root %p.\n", iface, root);
+
+    if ((*root = document->root ? &document->root->ID2D1SvgElement_iface : NULL))
+        ID2D1SvgElement_AddRef(*root);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_document_FindElementById(ID2D1SvgDocument *iface,
+        const WCHAR *id, ID2D1SvgElement **element)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+    struct d2d_svg_element *found;
+
+    TRACE("iface %p, id %s, element %p.\n", iface, debugstr_w(id), element);
+
+    *element = NULL;
+    if (!id)
+        return E_INVALIDARG;
+    if (document->root && (found = svg_find_by_id(document->root, id)))
+        ID2D1SvgElement_AddRef(*element = &found->ID2D1SvgElement_iface);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_document_Serialize(ID2D1SvgDocument *iface,
+        IStream *stream, ID2D1SvgElement *subtree)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+    struct d2d_svg_element *element;
+    struct svg_buf buf = {0};
+    HRESULT hr;
+
+    TRACE("iface %p, stream %p, subtree %p.\n", iface, stream, subtree);
+
+    if (!stream)
+        return E_INVALIDARG;
+    if (subtree)
+    {
+        if (!(element = unsafe_impl_from_ID2D1SvgElement(subtree)))
+            return E_INVALIDARG;
+    }
+    else if (!(element = document->root))
+        return S_OK;
+
+    svg_serialize_element(&buf, element, TRUE);
+    if (buf.failed)
+        hr = E_OUTOFMEMORY;
+    else
+        hr = svg_write_utf8(stream, &buf);
+    free(buf.data);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_document_Deserialize(ID2D1SvgDocument *iface,
+        IStream *stream, ID2D1SvgElement **subtree)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+    struct d2d_svg_element *root;
+    HRESULT hr;
+
+    TRACE("iface %p, stream %p, subtree %p.\n", iface, stream, subtree);
+
+    *subtree = NULL;
+    if (!stream)
+        return E_INVALIDARG;
+    if (FAILED(hr = svg_parse_stream(stream, document->factory, NULL, &root)))
+        return hr;
+    *subtree = &root->ID2D1SvgElement_iface;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_document_CreatePaint(ID2D1SvgDocument *iface,
+        D2D1_SVG_PAINT_TYPE type, const D2D1_COLOR_F *color, const WCHAR *id, ID2D1SvgPaint **paint)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+    struct d2d_svg_attribute *attr;
+    HRESULT hr;
+
+    TRACE("iface %p, type %u, color %p, id %s, paint %p.\n", iface, type, color, debugstr_w(id), paint);
+
+    *paint = NULL;
+    if (type > D2D1_SVG_PAINT_TYPE_URI_CURRENT_COLOR)
+        return E_INVALIDARG;
+    if (FAILED(hr = d2d_svg_attribute_create(document->factory, SVG_ATTR_PAINT, &attr)))
+        return hr;
+    attr->paint_type = type;
+    attr->color.a = 1.0f;
+    if (color) attr->color = *color;
+    if (id && !(attr->id = svg_strdupW(id)))
+    {
+        ID2D1SvgAttribute_Release(&attr->ID2D1SvgAttribute_iface);
+        return E_OUTOFMEMORY;
+    }
+    *paint = &attr->ID2D1SvgPaint_iface;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_document_CreateStrokeDashArray(ID2D1SvgDocument *iface,
+        const D2D1_SVG_LENGTH *dashes, UINT32 count, ID2D1SvgStrokeDashArray **dash_array)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+    struct d2d_svg_attribute *attr;
+    HRESULT hr;
+
+    TRACE("iface %p, dashes %p, count %u, dash_array %p.\n", iface, dashes, count, dash_array);
+
+    *dash_array = NULL;
+    if (FAILED(hr = d2d_svg_attribute_create(document->factory, SVG_ATTR_DASHES, &attr)))
+        return hr;
+    if (count && FAILED(hr = svg_array_update(attr, dashes, count, 0)))
+    {
+        ID2D1SvgAttribute_Release(&attr->ID2D1SvgAttribute_iface);
+        return hr;
+    }
+    *dash_array = &attr->ID2D1SvgStrokeDashArray_iface;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_document_CreatePointCollection(ID2D1SvgDocument *iface,
+        const D2D1_POINT_2F *points, UINT32 count, ID2D1SvgPointCollection **collection)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+    struct d2d_svg_attribute *attr;
+    HRESULT hr;
+
+    TRACE("iface %p, points %p, count %u, collection %p.\n", iface, points, count, collection);
+
+    *collection = NULL;
+    if (FAILED(hr = d2d_svg_attribute_create(document->factory, SVG_ATTR_POINTS, &attr)))
+        return hr;
+    if (count && FAILED(hr = svg_array_update(attr, points, count, 0)))
+    {
+        ID2D1SvgAttribute_Release(&attr->ID2D1SvgAttribute_iface);
+        return hr;
+    }
+    *collection = &attr->ID2D1SvgPointCollection_iface;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_document_CreatePathData(ID2D1SvgDocument *iface,
+        const FLOAT *data, UINT32 data_count, const D2D1_SVG_PATH_COMMAND *commands, UINT32 command_count,
+        ID2D1SvgPathData **path_data)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+    struct d2d_svg_attribute *attr;
+    HRESULT hr;
+
+    TRACE("iface %p, data %p, data_count %u, commands %p, command_count %u, path_data %p.\n",
+            iface, data, data_count, commands, command_count, path_data);
+
+    *path_data = NULL;
+    if (FAILED(hr = d2d_svg_attribute_create(document->factory, SVG_ATTR_PATH, &attr)))
+        return hr;
+    if ((data_count && FAILED(hr = svg_array_update(attr, data, data_count, 0)))
+            || (command_count && FAILED(hr = d2d_svg_path_UpdateCommands(&attr->ID2D1SvgPathData_iface,
+            commands, command_count, 0))))
+    {
+        ID2D1SvgAttribute_Release(&attr->ID2D1SvgAttribute_iface);
+        return hr;
+    }
+    *path_data = &attr->ID2D1SvgPathData_iface;
+    return S_OK;
+}
+
+static const ID2D1SvgDocumentVtbl d2d_svg_document_vtbl =
+{
+    d2d_svg_document_QueryInterface,
+    d2d_svg_document_AddRef,
+    d2d_svg_document_Release,
+    d2d_svg_document_GetFactory,
+    d2d_svg_document_SetViewportSize,
+    d2d_svg_document_GetViewportSize,
+    d2d_svg_document_SetRoot,
+    d2d_svg_document_GetRoot,
+    d2d_svg_document_FindElementById,
+    d2d_svg_document_Serialize,
+    d2d_svg_document_Deserialize,
+    d2d_svg_document_CreatePaint,
+    d2d_svg_document_CreateStrokeDashArray,
+    d2d_svg_document_CreatePointCollection,
+    d2d_svg_document_CreatePathData,
+};
+
+HRESULT d2d_svg_document_create(ID2D1Factory *factory, IStream *stream, D2D1_SIZE_F viewport,
+        ID2D1SvgDocument **out)
+{
+    struct d2d_svg_document *document;
+    struct d2d_svg_element *root;
+    HRESULT hr;
+
+    *out = NULL;
+    if (viewport.width < 0.0f || viewport.height < 0.0f)
+        return E_INVALIDARG;
+    if (!(document = calloc(1, sizeof(*document))))
+        return E_OUTOFMEMORY;
+    document->ID2D1SvgDocument_iface.lpVtbl = &d2d_svg_document_vtbl;
+    document->refcount = 1;
+    document->viewport = viewport;
+    ID2D1Factory_AddRef(document->factory = factory);
+
+    /* Without a stream the document starts with an empty svg root. */
+    if (stream)
+        hr = svg_parse_stream(stream, factory, document, &root);
+    else
+        hr = d2d_svg_element_create(factory, document, L"svg", FALSE, &root);
+    if (SUCCEEDED(hr) && wcscmp(root->tag, L"svg"))
+    {
+        WARN("Root element is %s, not svg.\n", debugstr_w(root->tag));
+        ID2D1SvgElement_Release(&root->ID2D1SvgElement_iface);
+        hr = E_INVALIDARG;
+    }
+    if (FAILED(hr))
+    {
+        ID2D1SvgDocument_Release(&document->ID2D1SvgDocument_iface);
+        return hr;
+    }
+    document->root = root;
+    d2d_svg_element_set_document(root, document);
+
+    TRACE("Created SVG document %p.\n", document);
+    *out = &document->ID2D1SvgDocument_iface;
+    return S_OK;
+}
+
+void d2d_svg_document_draw(ID2D1DeviceContext6 *context, ID2D1Factory *factory, ID2D1SvgDocument *iface)
+{
+    struct d2d_svg_document *document = unsafe_impl_from_ID2D1SvgDocument(iface);
+    D2D1_MATRIX_3X2_F transform;
+    struct svg_style style;
+    struct svg_draw draw;
+
+    if (!document)
+    {
+        WARN("Invalid document %p.\n", iface);
+        return;
+    }
+    if (!document->root)
+        return;
+
+    memset(&style, 0, sizeof(style));
+    style.color.a = 1.0f;
+    style.fill_opacity = style.stroke_opacity = style.opacity = 1.0f;
+    style.stroke_width = 1.0f;
+    style.miter_limit = 4.0f;
+    style.fill_rule = D2D1_FILL_MODE_WINDING;
+    style.line_cap = D2D1_CAP_STYLE_FLAT;
+    style.line_join = D2D1_LINE_JOIN_MITER_OR_BEVEL;
+    style.visible = TRUE;
+
+    draw.context = context;
+    draw.factory = factory;
+    draw.document = document;
+    draw.viewport = document->viewport;
+    draw.depth = 0;
+
+    ID2D1DeviceContext6_GetTransform(context, &transform);
+    svg_draw_element(&draw, document->root, style, transform);
+    ID2D1DeviceContext6_SetTransform(context, &transform);
+}
