+static void d2d_svg_element_set_document(struct d2d_svg_element *element, struct d2d_svg_document *document)
+{
+    struct d2d_svg_element *child;
+
+    element->document = document;
+    LIST_FOR_EACH_ENTRY(child, &element->children, struct d2d_svg_element, entry)
+        d2d_svg_element_set_document(child, document);
+}
