+static struct d2d_svg_element *svg_child_of(struct d2d_svg_element *element, ID2D1SvgElement *iface)
+{
+    struct d2d_svg_element *child = unsafe_impl_from_ID2D1SvgElement(iface);
+
+    return child && child->parent == element ? child : NULL;
