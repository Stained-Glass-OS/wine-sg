From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHGetFileInfo fields and moving several files (2023)

shell32: SHGetFileInfo fields and moving several files (2023)

From Wine's todo_wine blocks, which record Windows: SHGetFileInfo (A and
W) clears hIcon and the two names whatever the flags, leaves the icon
index and attributes alone unless asked for them, sets the attributes to
0 for SHGFI_ICON, and ignores SHGFI_EXETYPE beside other flags;
SHFileOperation(FO_MOVE) of several things without FOF_MULTIDESTFILES
moves them all into the first destination, made a folder if need be, and
refuses to move a folder into itself with DE_DESTSUBTREE.
---
--- a/dlls/shell32/shell32_main.c
+++ b/dlls/shell32/shell32_main.c
@@ -199,12 +199,17 @@
     if (!path)
         return FALSE;
 
-    /* windows initializes these values regardless of the flags */
+    /* windows initializes these values regardless of the flags, but leaves
+     * the icon index and the attributes alone unless asked for them */
     if (psfi != NULL)
     {
+#ifndef SG_MUTANT_GFI_CLEAR
+        psfi->hIcon = NULL;
+#endif
         psfi->szDisplayName[0] = '\0';
         psfi->szTypeName[0] = '\0';
-        psfi->iIcon = 0;
+        /* an icon without attributes asked for sets them to nothing */
+        if ((flags & SHGFI_ICON) && !(flags & SHGFI_ATTRIBUTES)) psfi->dwAttributes = 0;
     }
 
     if (!(flags & SHGFI_PIDL))
@@ -221,12 +226,10 @@
         }
     }
 
-    if (flags & SHGFI_EXETYPE)
-    {
-        if (flags != SHGFI_EXETYPE)
-            return 0;
+    /* the executable type is only asked for on its own; with other flags it is ignored */
+    if (flags == SHGFI_EXETYPE)
         return shgfi_get_exe_type(szFullPath);
-    }
+    flags &= ~SHGFI_EXETYPE;
 
     /*
      * psfi is NULL normally to query EXE type. If it is NULL, none of the
@@ -548,6 +551,8 @@
     DWORD_PTR ret;
     SHFILEINFOW temppsfi;
 
+    if (!path) return 0;   /* nothing is touched */
+
     if (flags & SHGFI_PIDL)
     {
         /* path contains a pidl */
@@ -561,6 +566,7 @@
         pathW = temppath;
     }
 
+    memset(&temppsfi, 0, sizeof(temppsfi));
     if (psfi && (flags & SHGFI_ATTR_SPECIFIED))
         temppsfi.dwAttributes=psfi->dwAttributes;
 
@@ -571,22 +577,16 @@
 
     if (psfi)
     {
-        if(flags & SHGFI_ICON)
-            psfi->hIcon=temppsfi.hIcon;
+        /* hIcon and the two names are always set (cleared when not asked for) */
+        psfi->hIcon=temppsfi.hIcon;
         if(flags & (SHGFI_SYSICONINDEX|SHGFI_ICON|SHGFI_ICONLOCATION))
             psfi->iIcon=temppsfi.iIcon;
-        if(flags & SHGFI_ATTRIBUTES)
+        if(flags & (SHGFI_ATTRIBUTES|SHGFI_ICON))
             psfi->dwAttributes=temppsfi.dwAttributes;
-        if(flags & (SHGFI_DISPLAYNAME|SHGFI_ICONLOCATION))
-        {
-            WideCharToMultiByte(CP_ACP, 0, temppsfi.szDisplayName, -1,
-                  psfi->szDisplayName, sizeof(psfi->szDisplayName), NULL, NULL);
-        }
-        if(flags & SHGFI_TYPENAME)
-        {
-            WideCharToMultiByte(CP_ACP, 0, temppsfi.szTypeName, -1,
-                  psfi->szTypeName, sizeof(psfi->szTypeName), NULL, NULL);
-        }
+        WideCharToMultiByte(CP_ACP, 0, temppsfi.szDisplayName, -1,
+              psfi->szDisplayName, sizeof(psfi->szDisplayName), NULL, NULL);
+        WideCharToMultiByte(CP_ACP, 0, temppsfi.szTypeName, -1,
+              psfi->szTypeName, sizeof(psfi->szTypeName), NULL, NULL);
     }
 
     free(temppath);
--- a/dlls/shell32/shlfileop.c
+++ b/dlls/shell32/shlfileop.c
@@ -55,6 +55,7 @@
 #define FO_MASK         0xF
 
 #define DE_SAMEFILE      0x71
+#define DE_DESTSUBTREE   0x76
 #define DE_DESTSAMETREE  0x7D
 
 static DWORD SHNotifyCreateDirectoryA(LPCSTR path, LPSECURITY_ATTRIBUTES sec);
@@ -1585,20 +1586,36 @@
     if (!flTo->dwNumFiles)
         return ERROR_FILE_NOT_FOUND;
 
-    if (!(lpFileOp->fFlags & FOF_MULTIDESTFILES) &&
-        flTo->dwNumFiles > 1 && flFrom->dwNumFiles > 1)
+    /* a folder cannot be moved into itself */
+    for (i = 0; i < flFrom->dwNumFiles; i++)
     {
-        return ERROR_CANCELLED;
-    }
+        const FILE_ENTRY *src = &flFrom->feFiles[i];
+        size_t len = lstrlenW(src->szFullPath);
 
-    /* Stained Glass: files moved into a folder that exists go into it (two
-     * files dragged onto a folder were not moved at all) */
-    if (!(lpFileOp->fFlags & FOF_MULTIDESTFILES) &&
-        !flFrom->bAnyDirectories &&
-        flFrom->dwNumFiles > flTo->dwNumFiles &&
-        !(flTo->feFiles[0].bExists && IsAttribDir(flTo->feFiles[0].attributes)))
-    {
+        if (IsAttribDir(src->attributes) &&
+            !wcsnicmp(src->szFullPath, flTo->feFiles[0].szFullPath, len) &&
+            flTo->feFiles[0].szFullPath[len] == '\\')
+            return DE_DESTSUBTREE;
+    }
+
+    /* Stained Glass OS: several things moved without FOF_MULTIDESTFILES go
+     * into the first destination, made a folder when it does not exist, as
+     * Windows does (they were not moved at all) */
+    if (!(lpFileOp->fFlags & FOF_MULTIDESTFILES) && flFrom->dwNumFiles > 1)
+    {
+        FILE_ENTRY *dest = &flTo->feFiles[0];
+#ifndef SG_MUTANT_MOVE_MANY
+        if (!(dest->bExists && IsAttribDir(dest->attributes)))
+        {
+            ret = SHCreateDirectoryExW(NULL, dest->szFullPath, NULL);
+            if (ret && ret != ERROR_ALREADY_EXISTS)
+                return ret;
+            dest->bExists = TRUE;
+            dest->attributes = FILE_ATTRIBUTE_DIRECTORY;
+        }
+#else
         return ERROR_CANCELLED;
+#endif
     }
 
     ret = SHCreateDirectoryExW(NULL, flTo->feFiles[0].szDirectory, NULL);
