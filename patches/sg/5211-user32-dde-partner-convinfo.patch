From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] user32: DdeQueryConvInfo on partner handles

DdeQueryConvInfo answers for the CONVINFO.hConvPartner handle with the
information of the other side of the conversation instead of failing, and
DDEML no longer dereferences conversation handles it does not own. CORE:
integrator must review (patches/notes/5211.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/user32/dde_misc.c b/dlls/user32/dde_misc.c
--- a/dlls/user32/dde_misc.c
+++ b/dlls/user32/dde_misc.c
@@ -2225,6 +2225,22 @@
     return ret;
 }
 
+static BOOL WDML_IsKnownConv(const WDML_CONV* conv)
+{
+    WDML_INSTANCE*	inst;
+    WDML_CONV*		c;
+    int			side;
+
+#ifdef SG_MUTANT_DDE_NOCHECK
+    return TRUE;
+#endif
+    for (inst = WDML_InstanceList; inst; inst = inst->next)
+        for (side = 0; side < 2; side++)
+            for (c = inst->convs[side]; c; c = c->next)
+                if (c == conv) return TRUE;
+    return FALSE;
+}
+
 /******************************************************************
  *		WDML_GetConv
  *
@@ -2234,8 +2250,10 @@
 {
     WDML_CONV*	pConv = (WDML_CONV*)hConv;
 
-    /* FIXME: should do better checking */
-    if (pConv == NULL || pConv->magic != WDML_CONV_MAGIC) return NULL;
+    if (pConv == NULL) return NULL;
+    /* Stained Glass OS: a handle that is not one of ours is not dereferenced */
+    if (!WDML_IsKnownConv( pConv )) return NULL;
+    if (pConv->magic != WDML_CONV_MAGIC) return NULL;
 
     if (!pConv->instance)
     {
@@ -2421,6 +2439,48 @@
     return ret;
 }
 
+/* Stained Glass OS: the CONVINFO of the partner of a conversation.  A partner in this
+ * process is another conversation (same windows, other side); one in another process is
+ * not reachable, its information is what the conversation knows of it: the same windows
+ * seen from the other side. */
+static BOOL WDML_GetPartnerConvInfo(WDML_CONV* pConv, CONVINFO* ci)
+{
+    WDML_INSTANCE*	inst;
+    WDML_CONV*		pPartner = NULL;
+    int			side = (pConv->wStatus & ST_CLIENT) ? WDML_SERVER_SIDE : WDML_CLIENT_SIDE;
+
+    for (inst = WDML_InstanceList; inst && !pPartner; inst = inst->next)
+    {
+        WDML_CONV* c;
+        for (c = inst->convs[side]; c; c = c->next)
+        {
+            if (c != pConv && c->hwndClient == pConv->hwndClient && c->hwndServer == pConv->hwndServer)
+            {
+                pPartner = c;
+                break;
+            }
+        }
+    }
+    if (pPartner)
+    {
+#ifdef SG_MUTANT_DDE_PARTNER_SELF
+        pPartner = pConv;
+#endif
+        return WDML_GetLocalConvInfo(pPartner, ci, QID_SYNC);
+    }
+
+    if (!WDML_GetLocalConvInfo(pConv, ci, QID_SYNC)) return FALSE;
+#ifdef SG_MUTANT_DDE_NOFLIP
+    return TRUE;
+#endif
+    ci->wStatus = (ci->wStatus & ~(ST_CLIENT | ST_ADVISE)) | ((pConv->wStatus & ST_CLIENT) ? 0 : ST_CLIENT);
+    ci->hwnd = (pConv->wStatus & ST_CLIENT) ? pConv->hwndServer : pConv->hwndClient;
+    ci->hwndPartner = (pConv->wStatus & ST_CLIENT) ? pConv->hwndClient : pConv->hwndServer;
+    ci->hConvPartner = (HCONV)((ULONG_PTR)pConv | 1);
+    ci->hUser = 0;
+    return TRUE;
+}
+
 /******************************************************************
  *		DdeQueryConvInfo (USER32.@)
  *
@@ -2448,13 +2508,14 @@
     }
     else
     {
+        ret = 0;
         if ((ULONG_PTR)hConv & 1)
         {
+            /* the partner handle a CONVINFO hands out (DdeQueryConvInfo is the one function it
+             * may be passed to): the conversation of the other side */
             pConv = WDML_GetConv((HCONV)((ULONG_PTR)hConv & ~1), FALSE);
-            if (pConv != NULL)
-                FIXME("Request on remote conversation information is not implemented yet\n");
+            if (pConv != NULL && WDML_GetPartnerConvInfo(pConv, &ci)) ret = lpConvInfo->cb;
         }
-        ret = 0;
     }
 
     if (ret != 0)
