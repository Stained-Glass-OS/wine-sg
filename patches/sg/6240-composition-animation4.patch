From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dcomp: composition animations answer ICompositionAnimation4 (SetExpressionReferenceParameter)

A composition animation did not answer ICompositionAnimation4, the interface whose SetExpressionReferenceParameter lets an expression animation refer to an animatable object. React Native for Windows asks every animation it builds for it without checking the answer, so it crashed inside the window's paint callback, which Wine survives, and its windows stayed blank: OneDrive's tray flyout, where signing in starts, was a white rectangle. The interface now exists; a source that is a composition object is referenced as SetReferenceParameter does, another animatable object (a XAML element) is accepted though its properties are not read yet, and no source is refused.
---
diff --git a/dlls/dcomp/animation.c b/dlls/dcomp/animation.c
index a243584..a46b592 100644
--- a/dlls/dcomp/animation.c
+++ b/dlls/dcomp/animation.c
@@ -851,10 +851,14 @@ struct animation2_vtbl
     HRESULT (WINAPI *put_Target)( IInspectable *, HSTRING );
 };
 
+/* ICompositionAnimation4 (identity per windows-rs, MIT): not in our headers */
+static const GUID IID_ICompositionAnimation4_sg = { 0x770137be, 0x76bc, 0x4e23, { 0xbf, 0xed, 0xfe, 0x9c, 0xc2, 0x0f, 0x6e, 0xc9 } };
+
 struct animation
 {
     IInspectable typed_iface;   /* I*KeyFrameAnimation, or IExpressionAnimation */
     struct { const struct animation2_vtbl *lpVtbl; } ICompositionAnimation2_iface;
+    struct { const struct animation4_vtbl *lpVtbl; } ICompositionAnimation4_iface;
     HSTRING target_name;        /* ICompositionAnimation2.Target: kept */
     IKeyFrameAnimation IKeyFrameAnimation_iface;
     ICompositionAnimation ICompositionAnimation_iface;
@@ -935,6 +939,10 @@ static HRESULT WINAPI animation_QueryInterface( ICompositionAnimation *iface, RE
 #ifndef SG_MUTANT_NO_ANIMATION2
     else if (IsEqualGUID( iid, &IID_ICompositionAnimation2_sg ))
         *out = &impl->ICompositionAnimation2_iface;
+#endif
+#ifndef SG_MUTANT_NO_ANIMATION4
+    else if (IsEqualGUID( iid, &IID_ICompositionAnimation4_sg ))
+        *out = &impl->ICompositionAnimation4_iface;
 #endif
     else
     {
@@ -946,6 +954,17 @@ static HRESULT WINAPI animation_QueryInterface( ICompositionAnimation *iface, RE
     return S_OK;
 }
 
+struct animation4_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( IInspectable *, REFIID, void ** );
+    ULONG (WINAPI *AddRef)( IInspectable * );
+    ULONG (WINAPI *Release)( IInspectable * );
+    HRESULT (WINAPI *GetIids)( IInspectable *, ULONG *, IID ** );
+    HRESULT (WINAPI *GetRuntimeClassName)( IInspectable *, HSTRING * );
+    HRESULT (WINAPI *GetTrustLevel)( IInspectable *, TrustLevel * );
+    HRESULT (WINAPI *SetExpressionReferenceParameter)( IInspectable *, HSTRING, IInspectable * );
+};
+
 static struct animation *impl_from_animation2( IInspectable *iface )
 {
     return CONTAINING_RECORD( (void *)iface, struct animation, ICompositionAnimation2_iface );
@@ -1007,6 +1026,61 @@ static HRESULT WINAPI animation2_put_Target( IInspectable *iface, HSTRING value
     return S_OK;
 }
 
+static HRESULT set_parameter( struct animation *impl, HSTRING key, enum anim_kind kind, const void *value,
+                              size_t size, ICompositionObject *object );
+
+static struct animation *impl_from_animation4( IInspectable *iface )
+{
+    return CONTAINING_RECORD( (void *)iface, struct animation, ICompositionAnimation4_iface );
+}
+
+static HRESULT WINAPI animation4_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    return ICompositionAnimation_QueryInterface( &impl_from_animation4( iface )->ICompositionAnimation_iface, iid, out );
+}
+
+static ULONG WINAPI animation4_AddRef( IInspectable *iface )
+{
+    return ICompositionAnimation_AddRef( &impl_from_animation4( iface )->ICompositionAnimation_iface );
+}
+
+static ULONG WINAPI animation4_Release( IInspectable *iface )
+{
+    return ICompositionAnimation_Release( &impl_from_animation4( iface )->ICompositionAnimation_iface );
+}
+
+static HRESULT WINAPI animation4_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    return ICompositionAnimation_GetRuntimeClassName( &impl_from_animation4( iface )->ICompositionAnimation_iface, name );
+}
+
+/* an expression's reference to an animatable object: a composition object is referenced as
+ * SetReferenceParameter does; another IAnimationObject (a XAML element) has no properties to read here */
+static HRESULT WINAPI animation4_SetExpressionReferenceParameter( IInspectable *iface, HSTRING key, IInspectable *source )
+{
+    struct animation *impl = impl_from_animation4( iface );
+    ICompositionObject *object;
+    HRESULT hr;
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_hstring( key ), source );
+    if (!source) return E_INVALIDARG;
+    if (SUCCEEDED(IInspectable_QueryInterface( source, &IID_ICompositionObject, (void **)&object )))
+    {
+        hr = set_parameter( impl, key, ANIM_NONE, NULL, 0, object );
+        ICompositionObject_Release( object );
+        return hr;
+    }
+    FIXME( "%s: %p is no composition object, its properties are not read\n", debugstr_hstring( key ), source );
+    return S_OK;
+}
+
+static const struct animation4_vtbl animation4_vtbl =
+{
+    animation4_QueryInterface, animation4_AddRef, animation4_Release,
+    animation2_GetIids, animation4_GetRuntimeClassName, animation2_GetTrustLevel,
+    animation4_SetExpressionReferenceParameter,
+};
+
 static const struct animation2_vtbl animation2_vtbl =
 {
     animation2_QueryInterface, animation2_AddRef, animation2_Release, animation2_GetIids,
@@ -1468,6 +1542,7 @@ static HRESULT animation_create( struct compositor *compositor, enum anim_kind k
     impl->ICompositionObject_iface.lpVtbl = &animation_object_vtbl;
     impl->IClosable_iface.lpVtbl = &animation_closable_vtbl;
     impl->ICompositionAnimation2_iface.lpVtbl = &animation2_vtbl;
+    impl->ICompositionAnimation4_iface.lpVtbl = &animation4_vtbl;
     impl->ref = 1;
     impl->compositor = compositor;
     ICompositor_AddRef( (ICompositor *)compositor );
