+HRESULT http_request_headers_create( IHttpRequestHeaderCollection **out )
+{
+    struct header_collection *impl;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IHttpRequestHeaderCollection_iface.lpVtbl = &headers_vtbl;
+    impl->ref = 1;
+    *out = &impl->IHttpRequestHeaderCollection_iface;
+    return S_OK;
+}
+
+/* ---- accessors used by the transport and by header merging ------------- */
+static const struct IHttpRequestHeaderCollectionVtbl *headers_vtbl_addr = &headers_vtbl;
+
+unsigned int http_request_headers_count( IHttpRequestHeaderCollection *iface )
+{
+    struct header_collection *impl;
+    if (!iface || iface->lpVtbl != headers_vtbl_addr) return 0;
+    impl = impl_from_IHttpRequestHeaderCollection( iface );
+    return impl->count;
+}
+BOOL http_request_headers_at( IHttpRequestHeaderCollection *iface, unsigned int i,
+        const WCHAR **name, const WCHAR **value )
+{
+    struct header_collection *impl;
+    if (!iface || iface->lpVtbl != headers_vtbl_addr) return FALSE;
+    impl = impl_from_IHttpRequestHeaderCollection( iface );
+    if (i >= impl->count) return FALSE;
+    *name = impl->headers[i].name;
+    *value = impl->headers[i].value;
+    return TRUE;
+}
+void http_request_headers_merge( IHttpRequestHeaderCollection *dst, IHttpRequestHeaderCollection *src )
+{
+    struct header_collection *s;
+    unsigned int i;
+    if (!src || src->lpVtbl != headers_vtbl_addr || !dst || dst->lpVtbl != headers_vtbl_addr) return;
+    s = impl_from_IHttpRequestHeaderCollection( src );
+    for (i = 0; i < s->count; i++)
+    {
+        HSTRING n, v;
+        if (SUCCEEDED( WindowsCreateString( s->headers[i].name, wcslen( s->headers[i].name ), &n ) ))
+        {
+            if (SUCCEEDED( WindowsCreateString( s->headers[i].value, wcslen( s->headers[i].value ), &v ) ))
+            {
+                IHttpRequestHeaderCollection_Append( dst, n, v );
+                WindowsDeleteString( v );
+            }
+            WindowsDeleteString( n );
+        }
+    }
+}
