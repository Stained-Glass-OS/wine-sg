+/* Fold the client's default request headers into the outgoing request. */
+static void merge_default_headers( struct http_client *impl, IInspectable *request )
+{
+    IHttpRequestMessage *req;
+    IHttpRequestHeaderCollection *rh = NULL;
+    if (!impl->default_headers || !request) return;
+    if (FAILED( IInspectable_QueryInterface( request, &IID_IHttpRequestMessage, (void **)&req ) )) return;
+    IHttpRequestMessage_get_Headers( req, (IInspectable **)&rh );
+    if (rh) { http_request_headers_merge( rh, impl->default_headers ); IHttpRequestHeaderCollection_Release( rh ); }
+    IHttpRequestMessage_Release( req );
+}
+
+static HRESULT WINAPI client_SendRequestAsync( IHttpClient *iface, IInspectable *request, IInspectable **op )
+{
+    struct http_client *impl = impl_from_IHttpClient( iface );
+    TRACE( "iface %p, request %p, op %p.\n", iface, request, op );
+    /* HttpClient delegates the send to its filter, after merging its defaults. */
+    if (!impl->filter) { *op = NULL; return E_NOTIMPL; }
+    merge_default_headers( impl, request );
+    return IHttpFilter_SendRequestAsync( impl->filter, request, op );
+}
+static HRESULT WINAPI client_SendRequestWithOptionAsync( IHttpClient *iface, IInspectable *request,
+        HttpCompletionOption option, IInspectable **op )
+{
+    struct http_client *impl = impl_from_IHttpClient( iface );
+    TRACE( "iface %p, request %p, option %d, op %p.\n", iface, request, option, op );
+    if (!impl->filter) { *op = NULL; return E_NOTIMPL; }
+    merge_default_headers( impl, request );
+    return IHttpFilter_SendRequestAsync( impl->filter, request, op );
+}
+static HRESULT WINAPI client_get_DefaultRequestHeaders( IHttpClient *iface, IHttpRequestHeaderCollection **value )
+{
+    struct http_client *impl = impl_from_IHttpClient( iface );
+    HRESULT hr = S_OK;
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!impl->default_headers) hr = http_request_headers_create( &impl->default_headers );
+    if (SUCCEEDED( hr ))
+    {
+        IHttpRequestHeaderCollection_AddRef( impl->default_headers );
+        *value = impl->default_headers;
+    }
+    return hr;
+}
