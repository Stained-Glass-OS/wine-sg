+static HRESULT WINAPI http_filter_send_SendRequestAsync( IHttpFilter *iface, IInspectable *request_insp,
+        IInspectable **operation )
+{
+    IHttpRequestMessage *request = NULL;
+    IHttpMethod *method = NULL;
+    IInspectable *uri_insp = NULL;
+    IUriRuntimeClass *uri = NULL;
+    IHttpContent *content = NULL;
+    IHttpRequestHeaderCollection *headers = NULL;
+    IHttpContent *resp_content = NULL;
+    IHttpResponseMessage *response = NULL;
+    HSTRING method_hs = NULL, url_hs = NULL;
+    const WCHAR *method_str, *url_str;
+    const BYTE *body = NULL; UINT32 body_len = 0; const WCHAR *ctype = NULL;
+    BYTE *resp_data = NULL; DWORD resp_len = 0, status = 0;
+    HRESULT hr;
+
+    TRACE( "iface %p, request %p, operation %p.\n", iface, request_insp, operation );
+    *operation = NULL;
+
+    if (FAILED( hr = IInspectable_QueryInterface( request_insp, &IID_IHttpRequestMessage, (void **)&request ) ))
+        return hr;
+
+    if (FAILED( hr = IHttpRequestMessage_get_Method( request, &method ) ) || !method) { hr = E_INVALIDARG; goto done; }
+    if (FAILED( hr = IHttpMethod_get_Method( method, &method_hs ) )) goto done;
+    if (FAILED( hr = IHttpRequestMessage_get_RequestUri( request, &uri_insp ) ) || !uri_insp) { hr = E_INVALIDARG; goto done; }
+    if (FAILED( hr = IInspectable_QueryInterface( uri_insp, &IID_IUriRuntimeClass, (void **)&uri ) )) goto done;
+    if (FAILED( hr = IUriRuntimeClass_get_AbsoluteUri( uri, &url_hs ) )) goto done;
+    IHttpRequestMessage_get_Headers( request, (IInspectable **)&headers );
+    IHttpRequestMessage_get_Content( request, &content );
+    if (content) http_content_get_bytes( content, &body, &body_len, &ctype );
+
+    method_str = WindowsGetStringRawBuffer( method_hs, NULL );
+    url_str = WindowsGetStringRawBuffer( url_hs, NULL );
+    TRACE( "%ls %ls, %u body bytes.\n", method_str, url_str, body_len );
+
+    hr = filter_do_winhttp( method_str, url_str, headers, body, body_len, ctype, &status, &resp_data, &resp_len );
+    if (FAILED( hr )) goto done;
+
+    /* Wrap the response body and status in an HttpResponseMessage. */
+    if (FAILED( hr = http_content_create( resp_data, resp_len, NULL, &resp_content ) )) goto done;
+    resp_data = NULL;
+    if (FAILED( hr = http_response_create( status, resp_content, &response ) )) goto done;
+
+    hr = http_async_complete_iface( &IID_IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress,
+                                    (IInspectable *)response, operation );
+
+done:
+    free( resp_data );
+    if (response) IHttpResponseMessage_Release( response );
+    if (resp_content) IHttpContent_Release( resp_content );
+    if (content) IHttpContent_Release( content );
+    if (headers) IHttpRequestHeaderCollection_Release( headers );
+    if (uri) IUriRuntimeClass_Release( uri );
+    if (uri_insp) IInspectable_Release( uri_insp );
+    if (method) IHttpMethod_Release( method );
+    if (url_hs) WindowsDeleteString( url_hs );
+    if (method_hs) WindowsDeleteString( method_hs );
+    if (request) IHttpRequestMessage_Release( request );
+    return hr;
+}
