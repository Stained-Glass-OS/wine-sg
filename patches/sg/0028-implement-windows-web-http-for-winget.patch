+/* ---- IHttpFilter: the actual send (winhttp) ---------------------------- */
+DEFINE_IINSPECTABLE( http_filter_send, IHttpFilter, struct http_filter, IHttpBaseProtocolFilter_iface )
+
+/* Perform the request over winhttp, blocking until the body is read. */
+static HRESULT filter_do_winhttp( const WCHAR *method, const WCHAR *url,
+        IHttpRequestHeaderCollection *headers, const BYTE *body, DWORD body_len,
+        const WCHAR *content_type, DWORD *status_out, BYTE **data_out, DWORD *len_out )
+{
+    HINTERNET session = NULL, connect = NULL, request = NULL;
+    URL_COMPONENTS uc = { sizeof(uc) };
+    WCHAR host[256], path[2048];
+    DWORD status = 0, status_len = sizeof(status), flags = 0, avail, read, total = 0, cap = 0;
+    BYTE *data = NULL;
+    HRESULT hr = E_FAIL;
+    unsigned int i, count;
+
+    uc.lpszHostName = host; uc.dwHostNameLength = ARRAY_SIZE(host);
+    uc.lpszUrlPath = path; uc.dwUrlPathLength = ARRAY_SIZE(path);
+    if (!WinHttpCrackUrl( url, 0, 0, &uc )) return HRESULT_FROM_WIN32( GetLastError() );
+    if (uc.nScheme == INTERNET_SCHEME_HTTPS) flags |= WINHTTP_FLAG_SECURE;
+
+    if (!(session = WinHttpOpen( L"Stained Glass OS", WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY,
+                                 WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0 )))
+        return HRESULT_FROM_WIN32( GetLastError() );
+    if (!(connect = WinHttpConnect( session, host, uc.nPort, 0 ))) goto done;
+    if (!(request = WinHttpOpenRequest( connect, method, path, NULL, WINHTTP_NO_REFERER,
+                                        WINHTTP_DEFAULT_ACCEPT_TYPES, flags ))) goto done;
+
+    count = http_request_headers_count( headers );
+    for (i = 0; i < count; i++)
+    {
+        const WCHAR *name, *value;
+        WCHAR line[1024];
+        if (!http_request_headers_at( headers, i, &name, &value )) continue;
+        _snwprintf( line, ARRAY_SIZE(line), L"%ls: %ls", name, value );
+        WinHttpAddRequestHeaders( request, line, -1, WINHTTP_ADDREQ_FLAG_ADD );
+    }
+    if (body && body_len && content_type)
+    {
+        WCHAR line[512];
+        _snwprintf( line, ARRAY_SIZE(line), L"Content-Type: %ls", content_type );
+        WinHttpAddRequestHeaders( request, line, -1, WINHTTP_ADDREQ_FLAG_ADD );
+    }
+
+    if (!WinHttpSendRequest( request, WINHTTP_NO_ADDITIONAL_HEADERS, 0,
+                             (void *)body, body_len, body_len, 0 )) goto done;
+    if (!WinHttpReceiveResponse( request, NULL )) goto done;
+
+    WinHttpQueryHeaders( request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+                         WINHTTP_HEADER_NAME_BY_INDEX, &status, &status_len, WINHTTP_NO_HEADER_INDEX );
+
+    for (;;)
+    {
+        avail = 0;
+        if (!WinHttpQueryDataAvailable( request, &avail )) goto done;
+        if (!avail) break;
+        if (total + avail + 1 > cap)
+        {
+            DWORD ncap = cap ? cap * 2 : 8192;
+            BYTE *grown;
+            while (ncap < total + avail + 1) ncap *= 2;
+            if (!(grown = realloc( data, ncap ))) { hr = E_OUTOFMEMORY; goto done; }
+            data = grown; cap = ncap;
+        }
+        if (!WinHttpReadData( request, data + total, avail, &read )) goto done;
+        if (!read) break;
+        total += read;
+    }
+    if (data) data[total] = 0;
+
+    *status_out = status;
+    *data_out = data;
+    *len_out = total;
+    data = NULL;
+    hr = S_OK;
+
+done:
+    if (hr == E_FAIL) hr = HRESULT_FROM_WIN32( GetLastError() );
+    free( data );
+    if (request) WinHttpCloseHandle( request );
+    if (connect) WinHttpCloseHandle( connect );
+    if (session) WinHttpCloseHandle( session );
+    return hr;
+}
