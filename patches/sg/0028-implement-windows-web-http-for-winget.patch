+static HRESULT WINAPI headers_QueryInterface( IHttpRequestHeaderCollection *iface, REFIID iid, void **out )
+{
+    struct header_collection *impl = impl_from_IHttpRequestHeaderCollection( iface );
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IHttpRequestHeaderCollection ))
+    {
+        *out = &impl->IHttpRequestHeaderCollection_iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI headers_AddRef( IHttpRequestHeaderCollection *iface )
+{
+    struct header_collection *impl = impl_from_IHttpRequestHeaderCollection( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+static ULONG WINAPI headers_Release( IHttpRequestHeaderCollection *iface )
+{
+    struct header_collection *impl = impl_from_IHttpRequestHeaderCollection( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        unsigned int i;
+        for (i = 0; i < impl->count; i++) { free( impl->headers[i].name ); free( impl->headers[i].value ); }
+        free( impl->headers );
+        free( impl );
+    }
+    return ref;
+}
+static HRESULT WINAPI headers_GetIids( IHttpRequestHeaderCollection *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT WINAPI headers_GetRuntimeClassName( IHttpRequestHeaderCollection *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT WINAPI headers_GetTrustLevel( IHttpRequestHeaderCollection *iface, TrustLevel *t ) { *t = BaseTrust; return S_OK; }
+
+static WCHAR *dup_hstring( HSTRING s )
+{
+    UINT32 len = 0;
+    const WCHAR *buf = WindowsGetStringRawBuffer( s, &len );
+    WCHAR *out = malloc( (len + 1) * sizeof(WCHAR) );
+    if (out) { if (len) memcpy( out, buf, len * sizeof(WCHAR) ); out[len] = 0; }
+    return out;
+}
+
+static HRESULT headers_store( struct header_collection *impl, HSTRING name, HSTRING value )
+{
+    if (impl->count == impl->capacity)
+    {
+        unsigned int cap = impl->capacity ? impl->capacity * 2 : 8;
+        struct header *grown = realloc( impl->headers, cap * sizeof(*grown) );
+        if (!grown) return E_OUTOFMEMORY;
+        impl->headers = grown;
+        impl->capacity = cap;
+    }
+    impl->headers[impl->count].name = dup_hstring( name );
+    impl->headers[impl->count].value = dup_hstring( value );
+    impl->count++;
+    return S_OK;
+}
+
