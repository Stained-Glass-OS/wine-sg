+/* A generic string-valued HTTP header value collection.
+ *
+ * The typed request/response header accessors (Accept, Connection, UserAgent,
+ * ...) each return a small collection whose *default* interface is the typed
+ * IHttp*HeaderValueCollection (ParseAdd / TryParseAdd) and which also exposes
+ * IVector<T>, IIterable<T> and IStringable. Every one of these has the same
+ * ABI (the element type is always an interface pointer, and the typed interface
+ * is only ParseAdd/TryParseAdd), so one implementation backs them all: an
+ * ordered list of strings the transport reads back. The object is parameterised
+ * with the specific IIDs a caller QIs it for.
+ *
+ * Copyright (C) 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or modify it under
+ * the terms of the GNU Lesser General Public License as published by the Free
+ * Software Foundation; either version 2.1 of the License, or (at your option)
+ * any later version.
+ */
+
+#include <stdlib.h>
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(web);
+
+/* The shape shared by every IHttp*HeaderValueCollection: IInspectable plus
+ * ParseAdd and TryParseAdd. */
+typedef struct typed_collection typed_collection;
+struct typed_collection_vtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)( typed_collection *, REFIID, void ** );
+    ULONG   (STDMETHODCALLTYPE *AddRef)( typed_collection * );
+    ULONG   (STDMETHODCALLTYPE *Release)( typed_collection * );
+    HRESULT (STDMETHODCALLTYPE *GetIids)( typed_collection *, ULONG *, IID ** );
+    HRESULT (STDMETHODCALLTYPE *GetRuntimeClassName)( typed_collection *, HSTRING * );
+    HRESULT (STDMETHODCALLTYPE *GetTrustLevel)( typed_collection *, TrustLevel * );
+    HRESULT (STDMETHODCALLTYPE *ParseAdd)( typed_collection *, HSTRING );
+    HRESULT (STDMETHODCALLTYPE *TryParseAdd)( typed_collection *, HSTRING, boolean * );
+};
+struct typed_collection { const struct typed_collection_vtbl *lpVtbl; };
+
+struct header_values
+{
+    struct typed_collection typed_iface;   /* the default interface */
+    IVector_IInspectable IVector_IInspectable_iface;
+    IStringable IStringable_iface;
+    LONG ref;
+    GUID typed_iid;    /* the typed IHttp*HeaderValueCollection IID */
+    GUID vector_iid;   /* the parameterised IVector<T> IID */
+
+    WCHAR **values;
+    unsigned int count, capacity;
+};
+
+static inline struct header_values *impl_from_typed( typed_collection *iface )
+{
+    return CONTAINING_RECORD( iface, struct header_values, typed_iface );
+}
+static inline struct header_values *impl_from_IVector_IInspectable( IVector_IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct header_values, IVector_IInspectable_iface );
+}
+
+static HRESULT values_QI( struct header_values *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &impl->typed_iid ))
+    {
+        *out = &impl->typed_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IVector_IInspectable ) || IsEqualGUID( iid, &impl->vector_iid ))
+    {
+        *out = &impl->IVector_IInspectable_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IStringable ))
+    {
+        *out = &impl->IStringable_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG values_release( struct header_values *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        unsigned int i;
+        for (i = 0; i < impl->count; i++) free( impl->values[i] );
+        free( impl->values );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT store_value( struct header_values *impl, HSTRING s )
+{
+    UINT32 len = 0;
+    const WCHAR *buf = WindowsGetStringRawBuffer( s, &len );
+    WCHAR *copy;
+    if (impl->count == impl->capacity)
+    {
+        unsigned int cap = impl->capacity ? impl->capacity * 2 : 4;
+        WCHAR **grown = realloc( impl->values, cap * sizeof(*grown) );
+        if (!grown) return E_OUTOFMEMORY;
+        impl->values = grown;
+        impl->capacity = cap;
+    }
+    if (!(copy = malloc( (len + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    if (len) memcpy( copy, buf, len * sizeof(WCHAR) );
+    copy[len] = 0;
+    impl->values[impl->count++] = copy;
+    return S_OK;
+}
+
+/* ---- the default (typed) interface: ParseAdd / TryParseAdd ------------- */
+static HRESULT STDMETHODCALLTYPE typed_QueryInterface( typed_collection *iface, REFIID iid, void **out )
+{
+    struct header_values *impl = impl_from_typed( iface );
+    TRACE( "iface %p, iid %s.\n", iface, debugstr_guid( iid ) );
+    return values_QI( impl, iid, out );
+}
+static ULONG STDMETHODCALLTYPE typed_AddRef( typed_collection *iface )
+{
+    return InterlockedIncrement( &impl_from_typed( iface )->ref );
+}
+static ULONG STDMETHODCALLTYPE typed_Release( typed_collection *iface )
+{
+    return values_release( impl_from_typed( iface ) );
+}
+static HRESULT STDMETHODCALLTYPE typed_GetIids( typed_collection *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT STDMETHODCALLTYPE typed_GetRuntimeClassName( typed_collection *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT STDMETHODCALLTYPE typed_GetTrustLevel( typed_collection *iface, TrustLevel *t ) { *t = BaseTrust; return S_OK; }
+static HRESULT STDMETHODCALLTYPE typed_ParseAdd( typed_collection *iface, HSTRING value )
+{
+    struct header_values *impl = impl_from_typed( iface );
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+    return store_value( impl, value );
+}
+static HRESULT STDMETHODCALLTYPE typed_TryParseAdd( typed_collection *iface, HSTRING value, boolean *success )
+{
+    struct header_values *impl = impl_from_typed( iface );
+    HRESULT hr;
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+    hr = store_value( impl, value );
+    *success = SUCCEEDED( hr );
+    return S_OK;
+}
+static const struct typed_collection_vtbl typed_vtbl =
+{
+    typed_QueryInterface, typed_AddRef, typed_Release,
+    typed_GetIids, typed_GetRuntimeClassName, typed_GetTrustLevel,
+    typed_ParseAdd, typed_TryParseAdd,
+};
+
+/* ---- IVector<IInspectable> (secondary) --------------------------------- */
+static HRESULT WINAPI values_QueryInterface( IVector_IInspectable *iface, REFIID iid, void **out )
+{
+    return values_QI( impl_from_IVector_IInspectable( iface ), iid, out );
+}
+static ULONG WINAPI values_AddRef( IVector_IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_IVector_IInspectable( iface )->ref );
+}
+static ULONG WINAPI values_Release( IVector_IInspectable *iface )
+{
+    return values_release( impl_from_IVector_IInspectable( iface ) );
+}
+static HRESULT WINAPI values_GetIids( IVector_IInspectable *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT WINAPI values_GetRuntimeClassName( IVector_IInspectable *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT WINAPI values_GetTrustLevel( IVector_IInspectable *iface, TrustLevel *t ) { *t = BaseTrust; return S_OK; }
+static HRESULT WINAPI values_GetAt( IVector_IInspectable *iface, UINT32 index, IInspectable **value ) { *value = NULL; return E_BOUNDS; }
+static HRESULT WINAPI values_get_Size( IVector_IInspectable *iface, UINT32 *size )
+{
+    *size = impl_from_IVector_IInspectable( iface )->count;
+    return S_OK;
+}
+static HRESULT WINAPI values_GetView( IVector_IInspectable *iface, IVectorView_IInspectable **view ) { *view = NULL; return E_NOTIMPL; }
+static HRESULT WINAPI values_IndexOf( IVector_IInspectable *iface, IInspectable *value, UINT32 *index, boolean *found ) { *index = 0; *found = FALSE; return S_OK; }
+static HRESULT WINAPI values_SetAt( IVector_IInspectable *iface, UINT32 index, IInspectable *value ) { return S_OK; }
+static HRESULT WINAPI values_InsertAt( IVector_IInspectable *iface, UINT32 index, IInspectable *value ) { return S_OK; }
+static HRESULT WINAPI values_RemoveAt( IVector_IInspectable *iface, UINT32 index ) { return S_OK; }
+static HRESULT WINAPI values_Append( IVector_IInspectable *iface, IInspectable *value ) { return S_OK; }
+static HRESULT WINAPI values_RemoveAtEnd( IVector_IInspectable *iface ) { return S_OK; }
+static HRESULT WINAPI values_Clear( IVector_IInspectable *iface )
+{
+    struct header_values *impl = impl_from_IVector_IInspectable( iface );
+    unsigned int i;
+    TRACE( "iface %p.\n", iface );
+    for (i = 0; i < impl->count; i++) free( impl->values[i] );
+    impl->count = 0;
+    return S_OK;
+}
+static HRESULT WINAPI values_GetMany( IVector_IInspectable *iface, UINT32 start, UINT32 count, IInspectable **items, UINT32 *actual ) { *actual = 0; return S_OK; }
+static HRESULT WINAPI values_ReplaceAll( IVector_IInspectable *iface, UINT32 count, IInspectable **items ) { return S_OK; }
+
+static const struct IVector_IInspectableVtbl values_vtbl =
+{
+    values_QueryInterface, values_AddRef, values_Release,
+    values_GetIids, values_GetRuntimeClassName, values_GetTrustLevel,
+    values_GetAt, values_get_Size, values_GetView, values_IndexOf, values_SetAt,
+    values_InsertAt, values_RemoveAt, values_Append, values_RemoveAtEnd,
+    values_Clear, values_GetMany, values_ReplaceAll,
+};
+
+/* ---- IStringable (secondary) ------------------------------------------- */
+static HRESULT WINAPI str_QueryInterface( IStringable *iface, REFIID iid, void **out )
+{
+    return values_QI( CONTAINING_RECORD( iface, struct header_values, IStringable_iface ), iid, out );
+}
+static ULONG WINAPI str_AddRef( IStringable *iface )
+{
+    return InterlockedIncrement( &CONTAINING_RECORD( iface, struct header_values, IStringable_iface )->ref );
+}
+static ULONG WINAPI str_Release( IStringable *iface )
+{
+    return values_release( CONTAINING_RECORD( iface, struct header_values, IStringable_iface ) );
+}
+static HRESULT WINAPI str_GetIids( IStringable *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT WINAPI str_GetRuntimeClassName( IStringable *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT WINAPI str_GetTrustLevel( IStringable *iface, TrustLevel *t ) { *t = BaseTrust; return S_OK; }
+static HRESULT WINAPI str_ToString( IStringable *iface, HSTRING *value )
+{
+    /* Join the stored values with ", ", as the header line would read. */
+    struct header_values *impl = CONTAINING_RECORD( iface, struct header_values, IStringable_iface );
+    WCHAR *buf = NULL;
+    size_t total = 0, pos = 0;
+    unsigned int i;
+    HRESULT hr;
+    for (i = 0; i < impl->count; i++) total += wcslen( impl->values[i] ) + 2;
+    if (!(buf = malloc( (total + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < impl->count; i++)
+    {
+        size_t l = wcslen( impl->values[i] );
+        if (i) { buf[pos++] = ','; buf[pos++] = ' '; }
+        memcpy( buf + pos, impl->values[i], l * sizeof(WCHAR) );
+        pos += l;
+    }
+    buf[pos] = 0;
+    hr = WindowsCreateString( buf, pos, value );
+    free( buf );
+    return hr;
+}
+static const struct IStringableVtbl str_vtbl =
+{
+    str_QueryInterface, str_AddRef, str_Release,
+    str_GetIids, str_GetRuntimeClassName, str_GetTrustLevel,
+    str_ToString,
+};
+
+HRESULT http_header_values_create( const GUID *typed_iid, const GUID *vector_iid, IInspectable **out )
+{
+    struct header_values *impl;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->typed_iface.lpVtbl = &typed_vtbl;
+    impl->IVector_IInspectable_iface.lpVtbl = &values_vtbl;
+    impl->IStringable_iface.lpVtbl = &str_vtbl;
+    impl->ref = 1;
+    if (typed_iid) impl->typed_iid = *typed_iid;
+    if (vector_iid) impl->vector_iid = *vector_iid;
+    *out = (IInspectable *)&impl->typed_iface;   /* the default interface */
+    return S_OK;
+}
