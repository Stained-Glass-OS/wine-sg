+/* A pre-completed WinRT async operation.
+ *
+ * The HTTP work is done synchronously (winhttp blocks), so every async result
+ * handed back is already complete: an IAsyncOperationWithProgress<T,P> that
+ * reports Completed and yields a stored result. C++/WinRT's blocking get() sets
+ * a completion handler and waits for it; because we are already complete,
+ * put_Completed invokes the handler at once and get() returns immediately.
+ *
+ * The IAsyncOperationWithProgress<T,P> ABI is uniform across T,P (both are
+ * pointer-or-value slots), so one generic implementation serves every result
+ * type, parameterised with the specific interface IID a caller QIs it for.
+ *
+ * Copyright (C) 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or modify it under
+ * the terms of the GNU Lesser General Public License as published by the Free
+ * Software Foundation; either version 2.1 of the License, or (at your option)
+ * any later version.
+ */
+
+#include <stdlib.h>
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(web);
+
+/* Generic IAsyncOperationWithProgress<T,P> vtbl (pointer-uniform). */
+struct async_op;
+struct async_op_vtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)( struct async_op *, REFIID, void ** );
+    ULONG   (STDMETHODCALLTYPE *AddRef)( struct async_op * );
+    ULONG   (STDMETHODCALLTYPE *Release)( struct async_op * );
+    HRESULT (STDMETHODCALLTYPE *GetIids)( struct async_op *, ULONG *, IID ** );
+    HRESULT (STDMETHODCALLTYPE *GetRuntimeClassName)( struct async_op *, HSTRING * );
+    HRESULT (STDMETHODCALLTYPE *GetTrustLevel)( struct async_op *, TrustLevel * );
+    HRESULT (STDMETHODCALLTYPE *put_Progress)( struct async_op *, void * );
+    HRESULT (STDMETHODCALLTYPE *get_Progress)( struct async_op *, void ** );
+    HRESULT (STDMETHODCALLTYPE *put_Completed)( struct async_op *, void * );
+    HRESULT (STDMETHODCALLTYPE *get_Completed)( struct async_op *, void ** );
+    HRESULT (STDMETHODCALLTYPE *GetResults)( struct async_op *, void * );
+};
+
+/* Generic delegate (completed handler) vtbl: Invoke(sender, status). */
+struct async_delegate_vtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)( void *, REFIID, void ** );
+    ULONG   (STDMETHODCALLTYPE *AddRef)( void * );
+    ULONG   (STDMETHODCALLTYPE *Release)( void * );
+    HRESULT (STDMETHODCALLTYPE *Invoke)( void *, void *info, AsyncStatus status );
+};
+struct async_delegate { const struct async_delegate_vtbl *lpVtbl; };
+
+/* IAsyncInfo vtbl (secondary). */
+struct async_info_vtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)( void *, REFIID, void ** );
+    ULONG   (STDMETHODCALLTYPE *AddRef)( void * );
+    ULONG   (STDMETHODCALLTYPE *Release)( void * );
+    HRESULT (STDMETHODCALLTYPE *GetIids)( void *, ULONG *, IID ** );
+    HRESULT (STDMETHODCALLTYPE *GetRuntimeClassName)( void *, HSTRING * );
+    HRESULT (STDMETHODCALLTYPE *GetTrustLevel)( void *, TrustLevel * );
+    HRESULT (STDMETHODCALLTYPE *get_Id)( void *, UINT32 * );
+    HRESULT (STDMETHODCALLTYPE *get_Status)( void *, AsyncStatus * );
+    HRESULT (STDMETHODCALLTYPE *get_ErrorCode)( void *, HRESULT * );
+    HRESULT (STDMETHODCALLTYPE *Cancel)( void * );
+    HRESULT (STDMETHODCALLTYPE *Close)( void * );
+};
+
+struct async_op
+{
+    const struct async_op_vtbl *lpVtbl;
+    const struct async_info_vtbl *info_vtbl;
+    LONG ref;
+    GUID iid;              /* the parameterised IAsyncOperationWithProgress IID */
+    struct async_delegate *completed;
+    IInspectable *result; /* result when it is an interface */
+    HSTRING result_str;   /* result when it is a string */
+    BOOL is_string;
+};
+
+static struct async_op *impl_from_info( void *iface )
+{
+    return CONTAINING_RECORD( (const struct async_info_vtbl **)iface, struct async_op, info_vtbl );
+}
+
+static ULONG op_addref( struct async_op *impl ) { return InterlockedIncrement( &impl->ref ); }
+static ULONG op_release( struct async_op *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->completed) impl->completed->lpVtbl->Release( impl->completed );
+        if (impl->result) IInspectable_Release( impl->result );
+        if (impl->result_str) WindowsDeleteString( impl->result_str );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT op_qi( struct async_op *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &impl->iid ))
+    {
+        *out = &impl->lpVtbl;
+        op_addref( impl );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+    {
+        *out = &impl->info_vtbl;
+        op_addref( impl );
+        return S_OK;
+    }
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+/* ---- the async operation interface ------------------------------------- */
+static HRESULT STDMETHODCALLTYPE op_QueryInterface( struct async_op *iface, REFIID iid, void **out )
+{
+    return op_qi( iface, iid, out );
+}
+static ULONG STDMETHODCALLTYPE op_AddRef( struct async_op *iface ) { return op_addref( iface ); }
+static ULONG STDMETHODCALLTYPE op_Release( struct async_op *iface ) { return op_release( iface ); }
+static HRESULT STDMETHODCALLTYPE op_GetIids( struct async_op *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT STDMETHODCALLTYPE op_GetRuntimeClassName( struct async_op *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT STDMETHODCALLTYPE op_GetTrustLevel( struct async_op *iface, TrustLevel *t ) { *t = BaseTrust; return S_OK; }
+static HRESULT STDMETHODCALLTYPE op_put_Progress( struct async_op *iface, void *handler ) { return S_OK; }
+static HRESULT STDMETHODCALLTYPE op_get_Progress( struct async_op *iface, void **handler ) { *handler = NULL; return S_OK; }
+static HRESULT STDMETHODCALLTYPE op_put_Completed( struct async_op *iface, void *handler )
+{
+    struct async_delegate *del = handler;
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    if (iface->completed) iface->completed->lpVtbl->Release( iface->completed );
+    if ((iface->completed = del))
+    {
+        del->lpVtbl->AddRef( del );
+        /* Already complete: fire immediately. */
+        del->lpVtbl->Invoke( del, &iface->lpVtbl, Completed );
+    }
+    return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE op_get_Completed( struct async_op *iface, void **handler )
+{
+    if ((*handler = iface->completed)) iface->completed->lpVtbl->AddRef( iface->completed );
+    return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE op_GetResults( struct async_op *iface, void *results )
+{
+    TRACE( "iface %p, results %p.\n", iface, results );
+    if (iface->is_string)
+        return WindowsDuplicateString( iface->result_str, (HSTRING *)results );
+    if ((*(IInspectable **)results = iface->result)) IInspectable_AddRef( iface->result );
+    return S_OK;
+}
+
+static const struct async_op_vtbl async_op_vtbl =
+{
+    op_QueryInterface, op_AddRef, op_Release,
+    op_GetIids, op_GetRuntimeClassName, op_GetTrustLevel,
+    op_put_Progress, op_get_Progress, op_put_Completed, op_get_Completed, op_GetResults,
+};
+
+/* ---- IAsyncInfo -------------------------------------------------------- */
+static HRESULT STDMETHODCALLTYPE info_QueryInterface( void *iface, REFIID iid, void **out ) { return op_qi( impl_from_info( iface ), iid, out ); }
+static ULONG STDMETHODCALLTYPE info_AddRef( void *iface ) { return op_addref( impl_from_info( iface ) ); }
+static ULONG STDMETHODCALLTYPE info_Release( void *iface ) { return op_release( impl_from_info( iface ) ); }
+static HRESULT STDMETHODCALLTYPE info_GetIids( void *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT STDMETHODCALLTYPE info_GetRuntimeClassName( void *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT STDMETHODCALLTYPE info_GetTrustLevel( void *iface, TrustLevel *t ) { *t = BaseTrust; return S_OK; }
+static HRESULT STDMETHODCALLTYPE info_get_Id( void *iface, UINT32 *id ) { *id = 1; return S_OK; }
+static HRESULT STDMETHODCALLTYPE info_get_Status( void *iface, AsyncStatus *status ) { *status = Completed; return S_OK; }
+static HRESULT STDMETHODCALLTYPE info_get_ErrorCode( void *iface, HRESULT *code ) { *code = S_OK; return S_OK; }
+static HRESULT STDMETHODCALLTYPE info_Cancel( void *iface ) { return S_OK; }
+static HRESULT STDMETHODCALLTYPE info_Close( void *iface ) { return S_OK; }
+
+static const struct async_info_vtbl async_info_vtbl =
+{
+    info_QueryInterface, info_AddRef, info_Release,
+    info_GetIids, info_GetRuntimeClassName, info_GetTrustLevel,
+    info_get_Id, info_get_Status, info_get_ErrorCode, info_Cancel, info_Close,
+};
+
+static struct async_op *async_alloc( const GUID *iid )
+{
+    struct async_op *impl = calloc( 1, sizeof(*impl) );
+    if (!impl) return NULL;
+    impl->lpVtbl = &async_op_vtbl;
+    impl->info_vtbl = &async_info_vtbl;
+    impl->ref = 1;
+    impl->iid = *iid;
+    return impl;
+}
+
+/* A completed operation whose result is an interface (e.g. HttpResponseMessage). */
+HRESULT http_async_complete_iface( const GUID *iid, IInspectable *result, IInspectable **out )
+{
+    struct async_op *impl = async_alloc( iid );
+    if (!impl) return E_OUTOFMEMORY;
+    if ((impl->result = result)) IInspectable_AddRef( result );
+    *out = (IInspectable *)&impl->lpVtbl;
+    return S_OK;
+}
+
+/* A completed operation whose result is a string (e.g. ReadAsStringAsync). */
+HRESULT http_async_complete_string( const GUID *iid, HSTRING result, IInspectable **out )
+{
+    struct async_op *impl = async_alloc( iid );
+    if (!impl) return E_OUTOFMEMORY;
+    impl->is_string = TRUE;
+    WindowsDuplicateString( result, &impl->result_str );
+    *out = (IInspectable *)&impl->lpVtbl;
+    return S_OK;
+}
