+    WAVEFORMATEX wfx, *dup;
+
+    TRACE("(%p, %d).\n", iface, type);
+
+    if (type == SAFTText)
+    {
+        free(This->wfx);
+        This->wfx = NULL;
+        This->format = SPDFID_Text;
+        return S_OK;
+    }
+    if (type == SAFTDefault || type == SAFTNoAssignedFormat)
+    {
+        free(This->wfx);
+        This->wfx = NULL;
+        This->format = GUID_NULL;
+        return S_OK;
+    }
+    if (type == SAFTNonStandardFormat || type == SAFTExtendedAudioFormat) return E_INVALIDARG;
+    if (!type_to_wfx(type, &wfx)) return SPERR_UNSUPPORTED_FORMAT;
+    if (!(dup = wfx_dup(&wfx))) return E_OUTOFMEMORY;
+
+    free(This->wfx);
+    This->wfx = dup;
+    This->format = SPDFID_WaveFormatEx;
+    return S_OK;
+}
