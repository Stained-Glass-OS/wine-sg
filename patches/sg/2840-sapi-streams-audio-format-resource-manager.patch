+    WAVEFORMATEX default_wfx = { WAVE_FORMAT_PCM, 1, 11025, 22050, 2, 16, 0 };
+#else
+    WAVEFORMATEX default_wfx = { WAVE_FORMAT_PCM, 1, 22050, 44100, 2, 16, 0 };
+#endif
+    const WAVEFORMATEX *wfx = NULL;
+    const GUID *format = NULL;
+    BOOL create = mode == SSFMCreate || mode == SSFMCreateForWrite;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("(%p, %s, %d, %d).\n", iface, debugstr_w(filename), mode, events);
+
+    if (!filename) return E_INVALIDARG;
+
+    EnterCriticalSection(&This->cs);
+    if (This->has_format)
+    {
+        format = &This->format;
+        wfx = This->wfx;
+    }
+    else if (create)
+    {
+        /* A new file without a format set gets the default speech format, 22 kHz 16 bit mono. */
+        format = &SPDFID_WaveFormatEx;
+        wfx = &default_wfx;
+    }
+    This->events = !!events;
+    hr = ISpStream_BindToFile(This->stream, filename, (SPFILEMODE)mode, format, wfx, events ? ~0ull : 0);
+    LeaveCriticalSection(&This->cs);
+    return hr;
 }
 
