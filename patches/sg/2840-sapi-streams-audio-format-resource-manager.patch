+static HRESULT WINAPI wave_format_get_ExtraData(ISpeechWaveFormatEx *iface, VARIANT *data)
+{
+    struct wave_format *This = impl_from_ISpeechWaveFormatEx(iface);
+    SAFEARRAY *array;
+    void *ptr;
+
+    TRACE("(%p, %p).\n", iface, data);
+
+    if (!data) return E_POINTER;
+    if (!(array = SafeArrayCreateVector(VT_UI1, 0, This->wfx.cbSize))) return E_OUTOFMEMORY;
+    if (This->wfx.cbSize)
+    {
+        SafeArrayAccessData(array, &ptr);
+        memcpy(ptr, This->extra, This->wfx.cbSize);
+        SafeArrayUnaccessData(array);
+    }
+    V_VT(data) = VT_ARRAY | VT_UI1;
+    V_ARRAY(data) = array;
+    return S_OK;
+}
+
+static HRESULT WINAPI wave_format_put_ExtraData(ISpeechWaveFormatEx *iface, VARIANT data)
+{
+    struct wave_format *This = impl_from_ISpeechWaveFormatEx(iface);
+    VARIANT *src = &data;
+    BYTE *copy = NULL, *ptr;
+    LONG lower, upper;
+    SAFEARRAY *array;
+    ULONG size;
+
+    TRACE("(%p, %s).\n", iface, debugstr_variant(&data));
+
+    if (V_VT(src) == (VT_VARIANT | VT_BYREF)) src = V_VARIANTREF(src);
+    if (V_VT(src) == (VT_ARRAY | VT_UI1)) array = V_ARRAY(src);
+    else if (V_VT(src) == (VT_ARRAY | VT_UI1 | VT_BYREF)) array = *V_ARRAYREF(src);
+    else if (V_VT(src) == VT_EMPTY || V_VT(src) == VT_NULL) array = NULL;
+    else return DISP_E_TYPEMISMATCH;
+
+    if (!array) size = 0;
+    else
+    {
+        if (SafeArrayGetDim(array) != 1) return DISP_E_TYPEMISMATCH;
+        SafeArrayGetLBound(array, 1, &lower);
+        SafeArrayGetUBound(array, 1, &upper);
+        size = upper - lower + 1;
+        if (size > 0xffff) return E_INVALIDARG;
+        if (size)
+        {
+            if (!(copy = malloc(size))) return E_OUTOFMEMORY;
+            SafeArrayAccessData(array, (void **)&ptr);
+            memcpy(copy, ptr, size);
+            SafeArrayUnaccessData(array);
+        }
+    }
+
+    free(This->extra);
+    This->extra = copy;
+    This->wfx.cbSize = size;
+    return S_OK;
+}
