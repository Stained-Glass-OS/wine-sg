+static BOOL read_at(HANDLE file, ULONGLONG off, void *buf, DWORD size)
+{
+    OVERLAPPED ov = { 0 };
+    DWORD read;
+
+    ov.Offset = off;
+    ov.OffsetHigh = off >> 32;
+    return ReadFile(file, buf, size, &read, &ov) && read == size;
+}
+
+/* Looks for a RIFF/WAVE header. On success fills in the offset and size of the
+ * data chunk and returns the format as a malloc()ed block. */
+static WAVEFORMATEX *parse_wave_header(HANDLE file, ULONGLONG file_size, ULONGLONG *data_start, ULONGLONG *data_len)
+{
+    struct { DWORD id, size; } chunk;
+    DWORD riff[3];
+    WAVEFORMATEX *wfx = NULL;
+    ULONGLONG off = 12;
+
+    if (!read_at(file, 0, riff, sizeof(riff)) || riff[0] != FOURCC_RIFF || riff[2] != mmioFOURCC('W','A','V','E'))
+        return NULL;
+
+    while (off + sizeof(chunk) <= file_size && read_at(file, off, &chunk, sizeof(chunk)))
+    {
+        off += sizeof(chunk);
+        if (chunk.id == mmioFOURCC('f','m','t',' '))
+        {
+            if (chunk.size < sizeof(PCMWAVEFORMAT) || chunk.size > 0x10000 || wfx) return (free(wfx), NULL);
+            if (!(wfx = calloc(1, max(chunk.size, sizeof(WAVEFORMATEX))))) return NULL;
+            if (!read_at(file, off, wfx, chunk.size)) return (free(wfx), NULL);
+            if (wfx->wFormatTag == WAVE_FORMAT_PCM) wfx->cbSize = 0;
+            else if (chunk.size < sizeof(WAVEFORMATEX) || sizeof(WAVEFORMATEX) + wfx->cbSize > chunk.size)
+                return (free(wfx), NULL);
+        }
+        else if (chunk.id == mmioFOURCC('d','a','t','a'))
+        {
+            if (!wfx) return NULL;
+            *data_start = off;
+            *data_len = chunk.size;
+            if (off + chunk.size > file_size || chunk.size == 0xffffffffu) *data_len = file_size - off;
+            return wfx;
+        }
+        off += (ULONGLONG)chunk.size + (chunk.size & 1);
+    }
+    free(wfx);
+    return NULL;
+}
+
+static BOOL write_wave_header(HANDLE file, const WAVEFORMATEX *wfx, ULONGLONG *data_start)
+{
+    DWORD fmt_size = wfx->wFormatTag == WAVE_FORMAT_PCM ? sizeof(PCMWAVEFORMAT) : sizeof(WAVEFORMATEX) + wfx->cbSize;
+    DWORD hdr[5] = { FOURCC_RIFF, 0, mmioFOURCC('W','A','V','E'), mmioFOURCC('f','m','t',' '), fmt_size };
+    DWORD data_hdr[2] = { mmioFOURCC('d','a','t','a'), 0 }, written, pad = 0;
+    DWORD pad_len = fmt_size & 1;
+
+    hdr[1] = 4 + 8 + fmt_size + pad_len + 8;
+    if (!WriteFile(file, hdr, sizeof(hdr), &written, NULL) ||
+        !WriteFile(file, wfx, fmt_size, &written, NULL) ||
+        (pad_len && !WriteFile(file, &pad, pad_len, &written, NULL)) ||
+        !WriteFile(file, data_hdr, sizeof(data_hdr), &written, NULL))
+        return FALSE;
+    *data_start = sizeof(hdr) + fmt_size + pad_len + sizeof(data_hdr);
+    return TRUE;
+}
