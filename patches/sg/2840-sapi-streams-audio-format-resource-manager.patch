+    TRACE("(%p, %p).\n", iface, guid);
+
+    if (!guid) return E_POINTER;
+    StringFromGUID2(&This->format, buf, ARRAY_SIZE(buf));
+    return (*guid = SysAllocString(buf)) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI audio_format_put_Guid(ISpeechAudioFormat *iface, BSTR guid)
+{
+    struct audio_format *This = impl_from_ISpeechAudioFormat(iface);
+    GUID id;
+
+    TRACE("(%p, %s).\n", iface, debugstr_w(guid));
+
+    if (!guid || FAILED(CLSIDFromString(guid, &id))) return E_INVALIDARG;
+    This->format = id;
+    return S_OK;
+}
+
+static HRESULT WINAPI audio_format_GetWaveFormatEx(ISpeechAudioFormat *iface, ISpeechWaveFormatEx **speechwave)
+{
+    struct audio_format *This = impl_from_ISpeechAudioFormat(iface);
+
+    TRACE("(%p, %p).\n", iface, speechwave);
+
+    if (!speechwave) return E_POINTER;
+    *speechwave = NULL;
+    if (!This->wfx) return S_OK;
+    return wave_format_create(This->wfx, speechwave);
+}
+
+static HRESULT WINAPI audio_format_SetWaveFormatEx(ISpeechAudioFormat *iface, ISpeechWaveFormatEx *speechwave)
+{
+    struct audio_format *This = impl_from_ISpeechAudioFormat(iface);
+    WAVEFORMATEX wfx, *dup;
+    short s;
+    LONG l;
+    VARIANT extra;
+    HRESULT hr;
+
+    TRACE("(%p, %p).\n", iface, speechwave);
+
+    if (!speechwave) return E_INVALIDARG;
+
+    memset(&wfx, 0, sizeof(wfx));
+    if (FAILED(hr = ISpeechWaveFormatEx_get_FormatTag(speechwave, &s))) return hr;
+    wfx.wFormatTag = s;
+    if (FAILED(hr = ISpeechWaveFormatEx_get_Channels(speechwave, &s))) return hr;
+    wfx.nChannels = s;
+    if (FAILED(hr = ISpeechWaveFormatEx_get_SamplesPerSec(speechwave, &l))) return hr;
+    wfx.nSamplesPerSec = l;
+    if (FAILED(hr = ISpeechWaveFormatEx_get_AvgBytesPerSec(speechwave, &l))) return hr;
+    wfx.nAvgBytesPerSec = l;
+    if (FAILED(hr = ISpeechWaveFormatEx_get_BlockAlign(speechwave, &s))) return hr;
+    wfx.nBlockAlign = s;
+    if (FAILED(hr = ISpeechWaveFormatEx_get_BitsPerSample(speechwave, &s))) return hr;
+    wfx.wBitsPerSample = s;
+
+    VariantInit(&extra);
+    if (wfx.wFormatTag != WAVE_FORMAT_PCM && SUCCEEDED(ISpeechWaveFormatEx_get_ExtraData(speechwave, &extra)) &&
+        V_VT(&extra) == (VT_ARRAY | VT_UI1))
+    {
+        LONG lower, upper;
+        SafeArrayGetLBound(V_ARRAY(&extra), 1, &lower);
+        SafeArrayGetUBound(V_ARRAY(&extra), 1, &upper);
+        if (upper >= lower)
+        {
+            BYTE *ptr;
+            wfx.cbSize = upper - lower + 1;
+            if (!(dup = calloc(1, sizeof(WAVEFORMATEX) + wfx.cbSize)))
+            {
+                VariantClear(&extra);
+                return E_OUTOFMEMORY;
+            }
+            *dup = wfx;
+            SafeArrayAccessData(V_ARRAY(&extra), (void **)&ptr);
+            memcpy(dup + 1, ptr, wfx.cbSize);
+            SafeArrayUnaccessData(V_ARRAY(&extra));
+            VariantClear(&extra);
+            goto done;
+        }
+    }
+    VariantClear(&extra);
+    if (!(dup = wfx_dup(&wfx))) return E_OUTOFMEMORY;
+
+done:
+    free(This->wfx);
+    This->wfx = dup;
+    This->format = SPDFID_WaveFormatEx;
+    return S_OK;
+}
+
+static const ISpeechAudioFormatVtbl audio_format_vtbl =
+{
+    audio_format_QueryInterface,
+    audio_format_AddRef,
+    audio_format_Release,
+    audio_format_GetTypeInfoCount,
+    audio_format_GetTypeInfo,
+    audio_format_GetIDsOfNames,
+    audio_format_Invoke,
+    audio_format_get_Type,
+    audio_format_put_Type,
+    audio_format_get_Guid,
+    audio_format_put_Guid,
+    audio_format_GetWaveFormatEx,
+    audio_format_SetWaveFormatEx,
+};
+
+HRESULT audio_format_create(const GUID *format, const WAVEFORMATEX *wfx, ISpeechAudioFormat **out)
+{
+    struct audio_format *This;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->ISpeechAudioFormat_iface.lpVtbl = &audio_format_vtbl;
+    This->ref = 1;
+    This->format = format ? *format : GUID_NULL;
+    if (wfx && !(This->wfx = wfx_dup(wfx)))
+    {
+        free(This);
+        return E_OUTOFMEMORY;
+    }
+    *out = &This->ISpeechAudioFormat_iface;
+    return S_OK;
+}
+
+/* Reads the format out of any ISpeechAudioFormat. *wfx is NULL (and the GUID
+ * SPDFID_Text, say) when the object carries no wave format; otherwise it is a
+ * malloc()ed copy. */
+HRESULT audio_format_get(ISpeechAudioFormat *iface, GUID *format, WAVEFORMATEX **wfx)
+{
+    ISpeechWaveFormatEx *wave = NULL;
+    VARIANT extra;
+    WAVEFORMATEX tmp;
+    BSTR guid = NULL;
+    HRESULT hr;
+    short s;
+    LONG l;
+
+    *wfx = NULL;
+    if (FAILED(hr = ISpeechAudioFormat_get_Guid(iface, &guid))) return hr;
+    hr = CLSIDFromString(guid, format);
+    SysFreeString(guid);
+    if (FAILED(hr)) return hr;
+
+    if (FAILED(hr = ISpeechAudioFormat_GetWaveFormatEx(iface, &wave)) || !wave) return hr;
+
+    memset(&tmp, 0, sizeof(tmp));
+    ISpeechWaveFormatEx_get_FormatTag(wave, &s); tmp.wFormatTag = s;
+    ISpeechWaveFormatEx_get_Channels(wave, &s); tmp.nChannels = s;
+    ISpeechWaveFormatEx_get_SamplesPerSec(wave, &l); tmp.nSamplesPerSec = l;
+    ISpeechWaveFormatEx_get_AvgBytesPerSec(wave, &l); tmp.nAvgBytesPerSec = l;
+    ISpeechWaveFormatEx_get_BlockAlign(wave, &s); tmp.nBlockAlign = s;
+    ISpeechWaveFormatEx_get_BitsPerSample(wave, &s); tmp.wBitsPerSample = s;
+
+    VariantInit(&extra);
+    if (tmp.wFormatTag != WAVE_FORMAT_PCM && SUCCEEDED(ISpeechWaveFormatEx_get_ExtraData(wave, &extra)) &&
+        V_VT(&extra) == (VT_ARRAY | VT_UI1))
+    {
+        LONG lower, upper;
+        SafeArrayGetLBound(V_ARRAY(&extra), 1, &lower);
+        SafeArrayGetUBound(V_ARRAY(&extra), 1, &upper);
+        if (upper >= lower)
+        {
+            BYTE *ptr;
+            tmp.cbSize = upper - lower + 1;
+            if ((*wfx = calloc(1, sizeof(WAVEFORMATEX) + tmp.cbSize)))
+            {
+                **wfx = tmp;
+                SafeArrayAccessData(V_ARRAY(&extra), (void **)&ptr);
+                memcpy(*wfx + 1, ptr, tmp.cbSize);
+                SafeArrayUnaccessData(V_ARRAY(&extra));
+            }
+        }
+    }
+    VariantClear(&extra);
+    ISpeechWaveFormatEx_Release(wave);
+
+    if (!*wfx && !(*wfx = wfx_dup(&tmp))) return E_OUTOFMEMORY;
+    return S_OK;
+}
