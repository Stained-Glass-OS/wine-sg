+static SIZE_T wfx_size(const WAVEFORMATEX *wfx)
+{
+    if (wfx->wFormatTag == WAVE_FORMAT_PCM) return sizeof(PCMWAVEFORMAT) + sizeof(WORD);
+    return sizeof(WAVEFORMATEX) + wfx->cbSize;
+}
+
+static WAVEFORMATEX *wfx_dup(const WAVEFORMATEX *wfx)
+{
+    WAVEFORMATEX *ret;
+
+    if (!(ret = calloc(1, wfx_size(wfx)))) return NULL;
+    memcpy(ret, wfx, wfx->wFormatTag == WAVE_FORMAT_PCM ? sizeof(PCMWAVEFORMAT) : wfx_size(wfx));
+    if (wfx->wFormatTag == WAVE_FORMAT_PCM) ret->cbSize = 0;
+    return ret;
+}
+
+/* The format numbers of SpeechAudioFormatType and the formats they stand for.
+ * PCM comes in the order 8/16 bit, mono/stereo for each sampling rate. */
+static const DWORD pcm_rates[] = { 8000, 11025, 12000, 16000, 22050, 24000, 32000, 44100, 48000 };
+static const DWORD law_rates[] = { 8000, 11025, 22050, 44100 };
+
+#define SAFT_FIRST_PCM  SAFT8kHz8BitMono
+#define SAFT_FIRST_ALAW SAFTCCITT_ALaw_8kHzMono
+#define SAFT_FIRST_ULAW SAFTCCITT_uLaw_8kHzMono
+
+static BOOL type_to_wfx(SpeechAudioFormatType type, WAVEFORMATEX *wfx)
+{
+    DWORD rate;
+    WORD tag, bits, channels;
+    int i;
+
+    memset(wfx, 0, sizeof(*wfx));
+    if (type >= SAFT_FIRST_PCM && type < SAFT_FIRST_PCM + 4 * ARRAY_SIZE(pcm_rates))
+    {
+        i = type - SAFT_FIRST_PCM;
+        rate = pcm_rates[i / 4];
+        bits = (i & 2) ? 16 : 8;
+        channels = (i & 1) ? 2 : 1;
+        tag = WAVE_FORMAT_PCM;
+    }
+    else if ((type >= SAFT_FIRST_ALAW && type < SAFT_FIRST_ALAW + 2 * ARRAY_SIZE(law_rates)) ||
+             (type >= SAFT_FIRST_ULAW && type < SAFT_FIRST_ULAW + 2 * ARRAY_SIZE(law_rates)))
+    {
+        BOOL alaw = type < SAFT_FIRST_ULAW;
+        i = type - (alaw ? SAFT_FIRST_ALAW : SAFT_FIRST_ULAW);
+        rate = law_rates[i / 2];
+        channels = (i & 1) ? 2 : 1;
+        bits = 8;
+        tag = alaw ? WAVE_FORMAT_ALAW : WAVE_FORMAT_MULAW;
+    }
+    else return FALSE;
+
+    wfx->wFormatTag = tag;
+    wfx->nChannels = channels;
+    wfx->nSamplesPerSec = rate;
+    wfx->wBitsPerSample = bits;
+    wfx->nBlockAlign = channels * bits / 8;
+    wfx->nAvgBytesPerSec = rate * wfx->nBlockAlign;
+    return TRUE;
+}
+
+static SpeechAudioFormatType wfx_to_type(const WAVEFORMATEX *wfx)
+{
+    int i, ch;
+
+    if (wfx->nChannels < 1 || wfx->nChannels > 2) return SAFTExtendedAudioFormat;
+    ch = wfx->nChannels - 1;
+#ifdef SG_MUTANT_SAPIAUT_TYPE_STEREO
+    ch = 0;
+#endif
+
+    if (wfx->wFormatTag == WAVE_FORMAT_PCM && (wfx->wBitsPerSample == 8 || wfx->wBitsPerSample == 16))
+    {
+        for (i = 0; i < ARRAY_SIZE(pcm_rates); i++)
+            if (pcm_rates[i] == wfx->nSamplesPerSec)
+                return SAFT_FIRST_PCM + i * 4 + (wfx->wBitsPerSample == 16 ? 2 : 0) + ch;
+    }
+    else if ((wfx->wFormatTag == WAVE_FORMAT_ALAW || wfx->wFormatTag == WAVE_FORMAT_MULAW) &&
+             wfx->wBitsPerSample == 8)
+    {
+        for (i = 0; i < ARRAY_SIZE(law_rates); i++)
+            if (law_rates[i] == wfx->nSamplesPerSec)
+                return (wfx->wFormatTag == WAVE_FORMAT_ALAW ? SAFT_FIRST_ALAW : SAFT_FIRST_ULAW) + i * 2 + ch;
+    }
+    return SAFTExtendedAudioFormat;
+}
