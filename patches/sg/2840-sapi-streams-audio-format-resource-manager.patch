 static HRESULT WINAPI file_stream_Seek(ISpeechFileStream *iface, VARIANT position, SpeechStreamSeekPositionType origin,
                                        VARIANT *pos)
 {
-    FIXME("(%p, %s, %d, %p): stub.\n", iface, debugstr_variant(&position), origin, pos);
+    struct file_stream *This = impl_from_ISpeechFileStream(iface);
+    LARGE_INTEGER move;
+    ULARGE_INTEGER newpos;
+    VARIANT tmp;
+    HRESULT hr;
+
+    TRACE("(%p, %s, %d, %p).\n", iface, debugstr_variant(&position), origin, pos);
+
+    if (!pos) return E_POINTER;
+    if (origin < SSSPTRelativeToStart || origin > SSSPTRelativeToEnd) return E_INVALIDARG;
 
-    return E_NOTIMPL;
+    VariantInit(&tmp);
+    if (FAILED(hr = VariantChangeType(&tmp, &position, 0, VT_I8))) return hr;
+    move.QuadPart = V_I8(&tmp);
+
+#ifdef SG_MUTANT_SAPIAUT_SEEK_ORIGIN
+    origin = SSSPTRelativeToStart;
+#endif
+    if (FAILED(hr = ISpStream_Seek(This->stream, move, origin, &newpos))) return hr;
+
+    VariantInit(pos);
+    if (newpos.QuadPart <= 0x7fffffff)
+    {
+        V_VT(pos) = VT_I4;
+        V_I4(pos) = newpos.QuadPart;
+    }
+    else
+    {
+        V_VT(pos) = VT_R8;
+        V_R8(pos) = (double)newpos.QuadPart;
+    }
+    return S_OK;
 }
 
