+
+    if (!type) return E_POINTER;
+    if (IsEqualGUID(&This->format, &SPDFID_Text)) *type = SAFTText;
+    else if (!This->wfx) *type = SAFTNoAssignedFormat;
+    else *type = wfx_to_type(This->wfx);
