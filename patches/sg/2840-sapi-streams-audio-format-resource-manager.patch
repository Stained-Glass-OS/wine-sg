+/* A stream over a file that holds either raw data or a RIFF/WAVE file. Offsets
+ * seen through the stream start at the first byte of the wave data; the RIFF
+ * header is generated when the file is created, and its sizes are rewritten on
+ * Commit and when the last reference goes away. */
+struct file_state
+{
+    LONG ref;
+    HANDLE file;
+    ULONGLONG data_start;
+    ULONGLONG data_len;
+    BOOL writable;
+    BOOL has_header;
+    BOOL dirty;
+    WCHAR *name;
+    CRITICAL_SECTION cs;
+};
+
+struct file_stream_obj
+{
+    IStream IStream_iface;
+    LONG ref;
+    struct file_state *state;
+    ULONGLONG pos;
+};
+
+static inline struct file_stream_obj *impl_from_IStream(IStream *iface)
+{
+    return CONTAINING_RECORD(iface, struct file_stream_obj, IStream_iface);
+}
+
+static void file_state_flush_header(struct file_state *s)
+{
+    DWORD written, riff_size, data_size;
+    OVERLAPPED ov;
+
+    if (!s->has_header || !s->dirty || !s->writable) return;
+#ifdef SG_MUTANT_SAPISTR_NO_HEADER_FIX
+    return;
+#endif
+    s->dirty = FALSE;
+
+    riff_size = min(s->data_start + s->data_len - 8, 0xffffffffu);
+    data_size = min(s->data_len, 0xffffffffu);
+
+    memset(&ov, 0, sizeof(ov));
+    ov.Offset = 4;
+    WriteFile(s->file, &riff_size, sizeof(riff_size), &written, &ov);
+    ov.Offset = s->data_start - 4;
+    WriteFile(s->file, &data_size, sizeof(data_size), &written, &ov);
+}
+
+static void file_state_release(struct file_state *s)
+{
+    if (InterlockedDecrement(&s->ref)) return;
+    file_state_flush_header(s);
+    CloseHandle(s->file);
+    free(s->name);
+    DeleteCriticalSection(&s->cs);
+    free(s);
+}
+
+static HRESULT WINAPI file_stream_obj_QueryInterface(IStream *iface, REFIID iid, void **obj)
+{
+    TRACE("(%p, %s, %p).\n", iface, debugstr_guid(iid), obj);
+
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_ISequentialStream) ||
+        IsEqualIID(iid, &IID_IStream))
+    {
+        IStream_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    WARN("interface %s not implemented.\n", debugstr_guid(iid));
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI file_stream_obj_AddRef(IStream *iface)
+{
+    struct file_stream_obj *This = impl_from_IStream(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI file_stream_obj_Release(IStream *iface)
+{
+    struct file_stream_obj *This = impl_from_IStream(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        file_state_release(This->state);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI file_stream_obj_Read(IStream *iface, void *buf, ULONG size, ULONG *ret_read)
+{
+    struct file_stream_obj *This = impl_from_IStream(iface);
+    struct file_state *s = This->state;
+    DWORD read = 0;
+    OVERLAPPED ov;
+    ULONGLONG off;
+
+    TRACE("(%p, %p, %lu, %p).\n", iface, buf, size, ret_read);
+
+    if (!buf && size) return STG_E_INVALIDPOINTER;
+
+    EnterCriticalSection(&s->cs);
+    if (This->pos < s->data_len)
+    {
+        if (size > s->data_len - This->pos) size = s->data_len - This->pos;
+        off = s->data_start + This->pos;
+#ifdef SG_MUTANT_SAPISTR_RAW_OFFSET
+        off = This->pos;
+#endif
+        memset(&ov, 0, sizeof(ov));
+        ov.Offset = off;
+        ov.OffsetHigh = off >> 32;
+        if (size && !ReadFile(s->file, buf, size, &read, &ov))
+        {
+            DWORD err = GetLastError();
+            if (err != ERROR_HANDLE_EOF)
+            {
+                LeaveCriticalSection(&s->cs);
+                return HRESULT_FROM_WIN32(err);
+            }
+            read = 0;
+        }
+        This->pos += read;
+    }
+    LeaveCriticalSection(&s->cs);
+
+    if (ret_read) *ret_read = read;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_obj_Write(IStream *iface, const void *buf, ULONG size, ULONG *ret_written)
+{
+    struct file_stream_obj *This = impl_from_IStream(iface);
+    struct file_state *s = This->state;
+    DWORD written = 0;
+    OVERLAPPED ov;
+    ULONGLONG off;
+
+    TRACE("(%p, %p, %lu, %p).\n", iface, buf, size, ret_written);
+
+    if (!buf && size) return STG_E_INVALIDPOINTER;
+    if (!s->writable) return STG_E_ACCESSDENIED;
+
+    EnterCriticalSection(&s->cs);
+    /* A seek past the end followed by a write leaves a hole of zeros, as for files. */
+    off = s->data_start + This->pos;
+    memset(&ov, 0, sizeof(ov));
+    ov.Offset = off;
+    ov.OffsetHigh = off >> 32;
+    if (size && !WriteFile(s->file, buf, size, &written, &ov))
+    {
+        DWORD err = GetLastError();
+        LeaveCriticalSection(&s->cs);
+        return HRESULT_FROM_WIN32(err);
+    }
+    This->pos += written;
+    if (This->pos > s->data_len)
+    {
+        s->data_len = This->pos;
+        s->dirty = TRUE;
+    }
+    LeaveCriticalSection(&s->cs);
+
+    if (ret_written) *ret_written = written;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_obj_Seek(IStream *iface, LARGE_INTEGER move, DWORD origin, ULARGE_INTEGER *newpos)
+{
+    struct file_stream_obj *This = impl_from_IStream(iface);
+    struct file_state *s = This->state;
+    LONGLONG base, target;
+
+    TRACE("(%p, %s, %ld, %p).\n", iface, wine_dbgstr_longlong(move.QuadPart), origin, newpos);
+
+    switch (origin)
+    {
+        case STREAM_SEEK_SET: base = 0; break;
+        case STREAM_SEEK_CUR: base = This->pos; break;
+        case STREAM_SEEK_END: base = s->data_len; break;
+        default: return STG_E_INVALIDFUNCTION;
+    }
+    target = base + move.QuadPart;
+    if (target < 0) return STG_E_INVALIDFUNCTION;
+    This->pos = target;
+    if (newpos) newpos->QuadPart = target;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_obj_SetSize(IStream *iface, ULARGE_INTEGER size)
+{
+    struct file_stream_obj *This = impl_from_IStream(iface);
+    struct file_state *s = This->state;
+    LARGE_INTEGER end;
+    BOOL ok;
+
+    TRACE("(%p, %s).\n", iface, wine_dbgstr_longlong(size.QuadPart));
+
+    if (!s->writable) return STG_E_ACCESSDENIED;
+
+    EnterCriticalSection(&s->cs);
+    end.QuadPart = s->data_start + size.QuadPart;
+    ok = SetFilePointerEx(s->file, end, NULL, FILE_BEGIN) && SetEndOfFile(s->file);
+    if (ok)
+    {
+        s->data_len = size.QuadPart;
+        s->dirty = TRUE;
+    }
+    LeaveCriticalSection(&s->cs);
+    return ok ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+}
+
+static HRESULT WINAPI file_stream_obj_CopyTo(IStream *iface, IStream *dest, ULARGE_INTEGER size,
+                                             ULARGE_INTEGER *read, ULARGE_INTEGER *written)
+{
+    ULONGLONG total_read = 0, total_written = 0;
+    HRESULT hr = S_OK;
+    BYTE buf[4096];
+
+    TRACE("(%p, %p, %s, %p, %p).\n", iface, dest, wine_dbgstr_longlong(size.QuadPart), read, written);
+
+    if (!dest) return STG_E_INVALIDPOINTER;
+
+    while (size.QuadPart)
+    {
+        ULONG chunk = size.QuadPart > sizeof(buf) ? sizeof(buf) : size.QuadPart, got = 0, put = 0;
+
+        if (FAILED(hr = IStream_Read(iface, buf, chunk, &got)) || !got) break;
+        total_read += got;
+        hr = IStream_Write(dest, buf, got, &put);
+        total_written += put;
+        if (FAILED(hr)) break;
+        if (put != got)
+        {
+            hr = STG_E_MEDIUMFULL;
+            break;
+        }
+        size.QuadPart -= got;
+    }
+    if (read) read->QuadPart = total_read;
+    if (written) written->QuadPart = total_written;
+    return hr;
+}
+
+static HRESULT WINAPI file_stream_obj_Commit(IStream *iface, DWORD flags)
+{
+    struct file_stream_obj *This = impl_from_IStream(iface);
+    struct file_state *s = This->state;
+
+    TRACE("(%p, %#lx).\n", iface, flags);
+
+    EnterCriticalSection(&s->cs);
+    file_state_flush_header(s);
+    LeaveCriticalSection(&s->cs);
+    if (s->writable) FlushFileBuffers(s->file);
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_obj_Revert(IStream *iface)
+{
+    TRACE("(%p).\n", iface);
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_obj_LockRegion(IStream *iface, ULARGE_INTEGER offset, ULARGE_INTEGER cb, DWORD type)
+{
