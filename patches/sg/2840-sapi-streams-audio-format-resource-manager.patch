+/* Finds the bytes of a byte array held in a VARIANT; *copy is set when the
+ * array's elements had to be converted. Returns the number of bytes. */
+static HRESULT variant_get_bytes(const VARIANT *var, BYTE **data, ULONG *size, SAFEARRAY **locked)
+{
+    const VARIANT *v = var;
+    SAFEARRAY *array;
+    LONG lower, upper;
+    ULONG elem;
+    HRESULT hr;
+    VARTYPE vt;
+
+    if (V_VT(v) == (VT_VARIANT | VT_BYREF)) v = V_VARIANTREF(v);
+    if (!(V_VT(v) & VT_ARRAY)) return DISP_E_TYPEMISMATCH;
+    array = (V_VT(v) & VT_BYREF) ? *V_ARRAYREF(v) : V_ARRAY(v);
+    vt = V_VT(v) & VT_TYPEMASK;
+    if (vt != VT_UI1 && vt != VT_I1 && vt != VT_I2 && vt != VT_UI2 && vt != VT_I4 && vt != VT_UI4)
+        return DISP_E_TYPEMISMATCH;
+
+    *locked = NULL;
+    *data = NULL;
+    *size = 0;
+    if (!array) return S_OK;
+    if (SafeArrayGetDim(array) != 1) return DISP_E_TYPEMISMATCH;
+    if (FAILED(hr = SafeArrayGetLBound(array, 1, &lower)) || FAILED(hr = SafeArrayGetUBound(array, 1, &upper)))
+        return hr;
+    elem = SafeArrayGetElemsize(array);
+    *size = upper >= lower ? (upper - lower + 1) * elem : 0;
+    if (FAILED(hr = SafeArrayAccessData(array, (void **)data))) return hr;
+    *locked = array;
+    return S_OK;
 }
 
 static HRESULT WINAPI file_stream_Read(ISpeechFileStream *iface, VARIANT *buffer, LONG written, LONG *read)
 {
-    FIXME("(%p, %p, %ld, %p): stub.\n", iface, buffer, written, read);
+    struct file_stream *This = impl_from_ISpeechFileStream(iface);
+    SAFEARRAY *array;
+    ULONG got = 0;
+    BYTE *data, *ptr;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %ld, %p).\n", iface, buffer, written, read);
+
+    if (!buffer || !read) return E_POINTER;
+    if (written < 0) return E_INVALIDARG;
+
+    if (!(data = malloc(written ? written : 1))) return E_OUTOFMEMORY;
+    hr = ISpStream_Read(This->stream, data, written, &got);
+    if (FAILED(hr))
+    {
+        free(data);
+        return hr;
+    }
+
+    if (!(array = SafeArrayCreateVector(VT_UI1, 0, got)))
+    {
+        free(data);
+        return E_OUTOFMEMORY;
+    }
+    if (got)
+    {
+        SafeArrayAccessData(array, (void **)&ptr);
+        memcpy(ptr, data, got);
+        SafeArrayUnaccessData(array);
+    }
+    free(data);
 
-    return E_NOTIMPL;
+    VariantInit(buffer);
+    V_VT(buffer) = VT_ARRAY | VT_UI1;
+    V_ARRAY(buffer) = array;
+    *read = got;
+    return S_OK;
 }
 
