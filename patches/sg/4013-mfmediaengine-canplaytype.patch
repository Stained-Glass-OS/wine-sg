From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfmediaengine: CanPlayType checks supported MIME types, activation factory export.

CanPlayType answers MAYBE for types the platform reports through
MFGetSupportedMimeTypes and then by extension; DllGetActivationFactory is
exported.
---
 dlls/mfmediaengine/main.c             | 64 ++++++++++++++++++++++++++++++++---
 dlls/mfmediaengine/mfmediaengine.spec |  2 +-
 2 files changed, 60 insertions(+), 6 deletions(-)

diff --git a/dlls/mfmediaengine/main.c b/dlls/mfmediaengine/main.c
index f72d400..adfad2e 100644
--- a/dlls/mfmediaengine/main.c
+++ b/dlls/mfmediaengine/main.c
@@ -1875,6 +1875,36 @@ static HRESULT WINAPI media_engine_Load(IMFMediaEngineEx *iface)
     return hr;
 }
 
+/* A container type is playable when a byte stream handler is registered for it
+ * (codecs are not looked at, so the answer is "maybe" at best). */
+static BOOL media_engine_builtin_type(const WCHAR *mime_type)
+{
+    PROPVARIANT types;
+    size_t len;
+    const WCHAR *end;
+    BOOL found = FALSE;
+    ULONG i;
+
+    if (!mime_type)
+        return FALSE;
+    end = wcschr(mime_type, ';');
+    len = end ? end - mime_type : wcslen(mime_type);
+    while (len && mime_type[len - 1] == ' ') --len;
+    if (!len)
+        return FALSE;
+
+    PropVariantInit(&types);
+    if (FAILED(MFGetSupportedMimeTypes(&types)))
+        return FALSE;
+    if (types.vt == (VT_VECTOR | VT_LPWSTR))
+    {
+        for (i = 0; i < types.calpwstr.cElems && !found; ++i)
+            found = wcslen(types.calpwstr.pElems[i]) == len && !wcsnicmp(types.calpwstr.pElems[i], mime_type, len);
+    }
+    PropVariantClear(&types);
+    return found;
+}
+
 static HRESULT WINAPI media_engine_CanPlayType(IMFMediaEngineEx *iface, BSTR mime_type, MF_MEDIA_ENGINE_CANPLAY *answer)
 {
     struct media_engine *engine = impl_from_IMFMediaEngineEx(iface);
@@ -1888,11 +1918,21 @@ static HRESULT WINAPI media_engine_CanPlayType(IMFMediaEngineEx *iface, BSTR mim
         hr = MF_E_SHUTDOWN;
     else
     {
-        FIXME("Check builtin supported types.\n");
-
-        if (engine->extension)
-             hr = IMFMediaEngineExtension_CanPlayType(engine->extension, !!(engine->flags & MF_MEDIA_ENGINE_AUDIOONLY),
-                     mime_type, answer);
+        if (!answer)
+            hr = E_POINTER;
+        else if (media_engine_builtin_type(mime_type))
+        {
+            *answer = MF_MEDIA_ENGINE_CANPLAY_MAYBE;
+            hr = S_OK;
+        }
+        else if (engine->extension)
+            hr = IMFMediaEngineExtension_CanPlayType(engine->extension, !!(engine->flags & MF_MEDIA_ENGINE_AUDIOONLY),
+                    mime_type, answer);
+        else
+        {
+            *answer = MF_MEDIA_ENGINE_CANPLAY_NOT_SUPPORTED;
+            hr = S_OK;
+        }
     }
 
     LeaveCriticalSection(&engine->cs);
@@ -4066,3 +4106,17 @@ HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID riid, void **obj)
     *obj = NULL;
     return CLASS_E_CLASSNOTAVAILABLE;
 }
+
+/***********************************************************************
+ *      DllGetActivationFactory (mfmediaengine.@)
+ */
+HRESULT WINAPI DllGetActivationFactory(void *class_id, IUnknown **factory)
+{
+    TRACE("%p, %p.\n", class_id, factory);
+
+    /* No Windows Runtime class is provided by this module. */
+    if (!factory)
+        return E_POINTER;
+    *factory = NULL;
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
diff --git a/dlls/mfmediaengine/mfmediaengine.spec b/dlls/mfmediaengine/mfmediaengine.spec
index f216d23..20a8bfa 100644
--- a/dlls/mfmediaengine/mfmediaengine.spec
+++ b/dlls/mfmediaengine/mfmediaengine.spec
@@ -1,3 +1,3 @@
 @ stdcall -private DllCanUnloadNow()
-@ stub DllGetActivationFactory
+@ stdcall -private DllGetActivationFactory(ptr ptr)
 @ stdcall -private DllGetClassObject(ptr ptr ptr)
