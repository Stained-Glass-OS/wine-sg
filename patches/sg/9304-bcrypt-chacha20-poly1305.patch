From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: ChaCha20-Poly1305

BCRYPT_CHACHA20_POLY1305_ALGORITHM ("CHACHA20_POLY1305"): a 256-bit key, BCryptEncrypt/Decrypt
with BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO (12-byte nonce, 16-byte tag, authenticated data) on the
AES-GCM path, through GnuTLS's GNUTLS_CIPHER_CHACHA20_POLY1305; properties: key and tag lengths,
block length 1, chaining mode N/A. .NET's ChaCha20Poly1305.IsSupported opens it (Duplicati 2.4 logged
it unsupported). Gate: test/bcchacha-gate.sh (RFC 8439 2.8.2 vector).
---
--- a/dlls/bcrypt/bcrypt_internal.h
+++ b/dlls/bcrypt/bcrypt_internal.h
@@ -166,6 +166,9 @@
 
     /* secret agreement on a curve named by a property */
     ALG_ID_ECDH,
+
+    /* cipher: ChaCha20 with Poly1305, an AEAD (Stained Glass OS 9304) */
+    ALG_ID_CHACHA20_POLY1305,
 };
 
 enum chain_mode
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -86,6 +86,7 @@
     {  BCRYPT_SP80056A_CONCAT_ALGORITHM, BCRYPT_KEY_DERIVATION_INTERFACE,   0,      0,    0 },
     {  BCRYPT_SP800108_CTR_HMAC_ALGORITHM, BCRYPT_KEY_DERIVATION_INTERFACE, 0,      0,    0 },
     {  BCRYPT_ECDH_ALGORITHM,       BCRYPT_SECRET_AGREEMENT_INTERFACE,      0,      0,    0 },
+    {  L"CHACHA20_POLY1305",         BCRYPT_CIPHER_INTERFACE,                654,    0,    0 },
 };
 
 static inline BOOL is_kdf_alg( enum alg_id id )
@@ -384,7 +385,10 @@
 #endif
     }
 
-    if (!(alg = create_algorithm( alg_id, 0, flags ))) return STATUS_NO_MEMORY;
+    /* Stained Glass OS (9304): ChaCha20-Poly1305 takes the AEAD path AES-GCM takes
+     * (BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO: a 12-byte nonce, a 16-byte tag) */
+    if (!(alg = create_algorithm( alg_id, alg_id == ALG_ID_CHACHA20_POLY1305 ? CHAIN_MODE_GCM : 0, flags )))
+        return STATUS_NO_MEMORY;
     *handle = alg;
     TRACE( "returning handle %p\n", *handle );
     return STATUS_SUCCESS;
@@ -768,6 +772,41 @@
     return STATUS_NOT_IMPLEMENTED;
 }
 
+static NTSTATUS get_chacha_property( const WCHAR *prop, UCHAR *buf, ULONG size, ULONG *ret_size )
+{
+    if (!wcscmp( prop, BCRYPT_BLOCK_LENGTH ))
+    {
+        *ret_size = sizeof(ULONG);
+        if (size < sizeof(ULONG)) return STATUS_BUFFER_TOO_SMALL;
+        if (buf) *(ULONG *)buf = 1;   /* a stream cipher */
+        return STATUS_SUCCESS;
+    }
+    if (!wcscmp( prop, BCRYPT_CHAINING_MODE ))
+    {
+        *ret_size = 64;
+        if (size < *ret_size) return STATUS_BUFFER_TOO_SMALL;
+        memcpy( buf, BCRYPT_CHAIN_MODE_NA, sizeof(BCRYPT_CHAIN_MODE_NA) );
+        return STATUS_SUCCESS;
+    }
+    if (!wcscmp( prop, BCRYPT_KEY_LENGTHS ) || !wcscmp( prop, BCRYPT_AUTH_TAG_LENGTH ))
+    {
+        BCRYPT_KEY_LENGTHS_STRUCT *lengths = (void *)buf;   /* same layout as the tag lengths */
+        ULONG bits = !wcscmp( prop, BCRYPT_KEY_LENGTHS ) ? 256 : 16;
+
+        *ret_size = sizeof(*lengths);
+        if (lengths && size < *ret_size) return STATUS_BUFFER_TOO_SMALL;
+        if (lengths)
+        {
+            lengths->dwMinLength = bits;
+            lengths->dwMaxLength = bits;
+            lengths->dwIncrement = 0;
+        }
+        return STATUS_SUCCESS;
+    }
+    FIXME( "unsupported property %s\n", debugstr_w(prop) );
+    return STATUS_NOT_IMPLEMENTED;
+}
+
 static NTSTATUS get_rc4_property( enum chain_mode mode, const WCHAR *prop, UCHAR *buf, ULONG size, ULONG *ret_size )
 {
     if (!wcscmp( prop, BCRYPT_BLOCK_LENGTH ))
@@ -823,6 +862,9 @@
     case ALG_ID_RC4:
         return get_rc4_property( alg->mode, prop, buf, size, ret_size );
 
+    case ALG_ID_CHACHA20_POLY1305:
+        return get_chacha_property( prop, buf, size, ret_size );
+
     case ALG_ID_RSA:
         return get_rsa_property( alg->mode, prop, buf, size, ret_size );
 
@@ -1088,6 +1130,10 @@
         if (!wcscmp( prop, BCRYPT_AUTH_TAG_LENGTH )) return STATUS_NOT_SUPPORTED;
         return get_aes_property( key->u.s.mode, prop, buf, size, ret_size );
 
+    case ALG_ID_CHACHA20_POLY1305:
+        if (!wcscmp( prop, BCRYPT_AUTH_TAG_LENGTH )) return STATUS_NOT_SUPPORTED;
+        return get_chacha_property( prop, buf, size, ret_size );
+
     case ALG_ID_DH:
         return get_dh_property( key, prop, buf, size, ret_size );
 
@@ -1780,6 +1826,8 @@
         if (!auth_info->pbNonce) return STATUS_INVALID_PARAMETER;
         if (!auth_info->pbTag) return STATUS_INVALID_PARAMETER;
         if (auth_info->cbTag < 12 || auth_info->cbTag > 16) return STATUS_INVALID_PARAMETER;
+        if (key->alg_id == ALG_ID_CHACHA20_POLY1305 && (auth_info->cbTag != 16 || auth_info->cbNonce != 12))
+            return STATUS_INVALID_PARAMETER;
         chain = auth_info->dwFlags & BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG;
         continuing = auth_info->dwFlags & BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG;
 
@@ -1932,6 +1980,8 @@
         if (!auth_info->pbNonce) return STATUS_INVALID_PARAMETER;
         if (!auth_info->pbTag) return STATUS_INVALID_PARAMETER;
         if (auth_info->cbTag < 12 || auth_info->cbTag > 16) return STATUS_INVALID_PARAMETER;
+        if (key->alg_id == ALG_ID_CHACHA20_POLY1305 && (auth_info->cbTag != 16 || auth_info->cbNonce != 12))
+            return STATUS_INVALID_PARAMETER;
 
         chain = auth_info->dwFlags & BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG;
         continuing = auth_info->dwFlags & BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG;
--- a/dlls/bcrypt/gnutls.c
+++ b/dlls/bcrypt/gnutls.c
@@ -51,6 +51,9 @@
 WINE_DEFAULT_DEBUG_CHANNEL(bcrypt);
 WINE_DECLARE_DEBUG_CHANNEL(winediag);
 
+#if GNUTLS_VERSION_MAJOR < 3 || (GNUTLS_VERSION_MAJOR == 3 && GNUTLS_VERSION_MINOR < 4)
+#define GNUTLS_CIPHER_CHACHA20_POLY1305 23
+#endif
 #if GNUTLS_VERSION_MAJOR < 3
 #define GNUTLS_CIPHER_AES_192_CBC 92
 #define GNUTLS_CIPHER_AES_128_GCM 93
@@ -642,6 +645,13 @@
         FIXME( "AES mode %u with key length %u not supported\n", key->u.s.mode, key->u.s.secret_len );
         return GNUTLS_CIPHER_UNKNOWN;
 
+    case ALG_ID_CHACHA20_POLY1305:
+#ifndef SG_MUTANT_NO_CHACHA20
+        if (key->u.s.secret_len == 32) return GNUTLS_CIPHER_CHACHA20_POLY1305;
+#endif
+        FIXME( "ChaCha20-Poly1305 with key length %u not supported\n", key->u.s.secret_len );
+        return GNUTLS_CIPHER_UNKNOWN;
+
     default:
         FIXME( "algorithm %u not supported\n", key->alg_id );
         return GNUTLS_CIPHER_UNKNOWN;
