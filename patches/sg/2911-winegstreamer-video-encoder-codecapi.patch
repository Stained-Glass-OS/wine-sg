+static HRESULT codec_api_set_all_defaults(struct video_encoder *encoder, GUID **param, ULONG *count)
+{
+    const struct codec_param *changed[ARRAY_SIZE(codec_params)];
+    ULONG n = 0;
+    HRESULT hr;
+    UINT i;
+
+    EnterCriticalSection(&encoder->cs);
+    for (i = 0; i < ARRAY_SIZE(codec_params); ++i)
+    {
+        if (!encoder->codec_values[i].set)
+            continue;
+        if (encoder->codec_values[i].value != codec_param_default(encoder, &codec_params[i]))
+            changed[n++] = &codec_params[i];
+        encoder->codec_values[i].set = FALSE;
+    }
+    LeaveCriticalSection(&encoder->cs);
+
+    if (!param)
+        return S_OK;
+    if (FAILED(hr = codec_changed_list(changed, n, param, count)))
+        return hr;
+    return S_OK;
+}
