+static const struct codec_param *find_codec_param(const GUID *api)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(codec_params); ++i)
+        if (IsEqualGUID(api, codec_params[i].key))
+            return &codec_params[i];
+    return NULL;
+}
+
+static void codec_variant_init(const struct codec_param *param, ULONG64 value, VARIANT *var)
+{
+    VariantInit(var);
+    V_VT(var) = param->vt;
+    if (param->vt == VT_UI8)
+        V_UI8(var) = value;
+    else
+        V_UI4(var) = value;
+}
+
+/* The mean bit rate and the buffer size follow the output type unless they are set. */
+static ULONG64 codec_param_default(struct video_encoder *encoder, const struct codec_param *param)
+{
+    UINT32 bitrate = 0;
+
+#ifndef SG_MUTANT_ENC_DERIVED
+    if (param->derived == DERIVED_NONE)
+        return param->def;
+#else
+    return param->def;
+#endif
+
+    if (encoder->output_type)
+        IMFMediaType_GetUINT32(encoder->output_type, &MF_MT_AVG_BITRATE, &bitrate);
+    if (param->derived == DERIVED_BUFFER_SIZE)
+        return (ULONG64)bitrate * 3 / 8;
+    return bitrate;
+}
+
+static ULONG64 codec_param_current(struct video_encoder *encoder, const struct codec_param *param)
+{
+    unsigned int index = param - codec_params;
+
+    if (encoder->codec_values[index].set)
+        return encoder->codec_values[index].value;
+    return codec_param_default(encoder, param);
+}
+
+/* A value is valid when it has the type of the parameter and is one of its values. */
+static HRESULT codec_param_check(const struct codec_param *param, const VARIANT *var, ULONG64 *value)
+{
+    if (V_VT(var) != param->vt)
+        return E_INVALIDARG;
+    *value = param->vt == VT_UI8 ? V_UI8(var) : V_UI4(var);
+#ifndef SG_MUTANT_CODEC_RANGE
+    if (*value < param->min || *value > param->max)
+        return E_INVALIDARG;
+#endif
+    return S_OK;
+}
+
+static HRESULT codec_api_set(struct video_encoder *encoder, const struct codec_param *param, ULONG64 value,
+        BOOL *changed)
+{
+    unsigned int index = param - codec_params;
+
+    *changed = codec_param_current(encoder, param) != value;
+#ifndef SG_MUTANT_CODEC_SET
+    encoder->codec_values[index].set = TRUE;
+    encoder->codec_values[index].value = value;
+#endif
+    return S_OK;
+}
+
+static HRESULT codec_changed_list(const struct codec_param **changed, ULONG count, GUID **param, ULONG *out_count)
+{
+    GUID *list = NULL;
+    ULONG i;
+
+    if (count && !(list = CoTaskMemAlloc(count * sizeof(*list))))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < count; ++i)
+        list[i] = *changed[i]->key;
+    *param = list;
+    *out_count = count;
+    return S_OK;
+}
