+    if (!(param = find_codec_param(api)))
+        return E_NOTIMPL;
+    if (param->kind == PARAM_RANGE)
+        return VFW_E_CODECAPI_LINEAR_RANGE;
+
+    n = param->max - param->min + 1;
+    if (!(list = CoTaskMemAlloc(n * sizeof(*list))))
+        return E_OUTOFMEMORY;
