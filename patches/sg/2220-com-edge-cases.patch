From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ole32, combase: OleSetMenuDescriptor, CoUnmarshalInterface, GetClassFile, CoGetInstanceFromFile edge cases

Four COM results that Wine's conformance test (compobj.c, todo_wine) records
from Windows.  OleSetMenuDescriptor with a NULL menu succeeds when nothing was
installed.  CoUnmarshalInterface fails with CO_E_NOTINITIALIZED when the
thread has no apartment (before it reads the stream).  GetClassFile of a file
that does not exist is MK_E_CANTOPENFILE, whatever its name.
CoGetInstanceFromFile returns E_INVALIDARG, touching nothing, when a MULTI_QI
entry already holds an interface pointer.  The matching todo_wine marks are
removed.

---
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -1675,6 +1675,17 @@ HRESULT WINAPI DECLSPEC_HOTPATCH CoGetInstanceFromFile(COSERVERINFO *server_info
     if (!count || !results)
         return E_INVALIDARG;
 
+#ifndef SG_MUTANT_INSTANCE_NO_PITF_CHECK
+    /* the caller's interface pointers must start out NULL: nothing is touched otherwise */
+    {
+        DWORD i;
+
+        for (i = 0; i < count; i++)
+            if (results[i].pItf)
+                return E_INVALIDARG;
+    }
+#endif
+
     if (server_info)
         FIXME("() non-NULL server_info not supported\n");
 
--- a/dlls/combase/marshal.c
+++ b/dlls/combase/marshal.c
@@ -812,6 +812,17 @@ HRESULT WINAPI CoUnmarshalInterface(IStream *stream, REFIID riid, void **ppv)
     if (!stream || !ppv)
         return E_INVALIDARG;
 
+#ifndef SG_MUTANT_UNMARSHAL_NO_APT_CHECK
+    /* there must be an apartment to unmarshal into, before anything is read */
+    {
+        struct apartment *apt;
+
+        if (!(apt = apartment_get_current_or_mta()))
+            return CO_E_NOTINITIALIZED;
+        apartment_release(apt);
+    }
+#endif
+
     hr = get_unmarshaler_from_stream(stream, &marshal, &iid);
     if (hr == S_FALSE)
     {
--- a/dlls/ole32/moniker.c
+++ b/dlls/ole32/moniker.c
@@ -935,6 +935,16 @@ HRESULT WINAPI GetClassFile(LPCOLESTR filePathName,CLSID *pclsid)
 
     TRACE("%s, %p\n", debugstr_w(filePathName), pclsid);
 
+#ifndef SG_MUTANT_CLASSFILE_NO_OPEN_CHECK
+    /* a file that is not there cannot be examined, whatever its name */
+    if (filePathName && GetFileAttributesW(filePathName) == INVALID_FILE_ATTRIBUTES)
+    {
+        DWORD err = GetLastError();
+        if (err == ERROR_FILE_NOT_FOUND || err == ERROR_PATH_NOT_FOUND)
+            return MK_E_CANTOPENFILE;
+    }
+#endif
+
     /* if the file contain a storage object the return the CLSID written by IStorage_SetClass method*/
     if((StgIsStorageFile(filePathName))==S_OK){
 
--- a/dlls/ole32/ole2.c
+++ b/dlls/ole32/ole2.c
@@ -1907,8 +1907,13 @@ HRESULT WINAPI OleSetMenuDescriptor(
     }
     else  /* Want to uninstall dispatching code */
     {
-        /* Uninstall the hooks */
+        /* Uninstall the hooks; with none installed there is nothing to do */
+#ifdef SG_MUTANT_MENU_UNINSTALL_FAILS
         if ( !OLEMenu_UnInstallHooks( GetCurrentThreadId() ) )
+#else
+        if ( OLEMenu_IsHookInstalled( GetCurrentThreadId() ) &&
+             !OLEMenu_UnInstallHooks( GetCurrentThreadId() ) )
+#endif
             return E_FAIL;
 
         /* Remove the menu descriptor property from the frame window */
--- a/dlls/ole32/tests/compobj.c
+++ b/dlls/ole32/tests/compobj.c
@@ -912,7 +912,7 @@ static void test_ole_menu(void)
 
 	hwndFrame = CreateWindowA((LPCSTR)MAKEINTATOM(register_dummy_class()), "Test", 0, CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT, NULL, NULL, NULL, NULL);
 	hr = OleSetMenuDescriptor(NULL, hwndFrame, NULL, NULL, NULL);
-	todo_wine ok_ole_success(hr, "OleSetMenuDescriptor");
+	ok_ole_success(hr, "OleSetMenuDescriptor");
 
 	DestroyWindow(hwndFrame);
 }
@@ -1476,7 +1476,6 @@ static void test_CoUnmarshalInterface(void)
     ok_ole_success(hr, "CreateStreamOnHGlobal");
 
     hr = CoUnmarshalInterface(pStream, &IID_IUnknown, (void **)&pProxy);
-    todo_wine
     ok(hr == CO_E_NOTINITIALIZED, "CoUnmarshalInterface should have returned CO_E_NOTINITIALIZED instead of 0x%08lx\n", hr);
 
     CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
@@ -3817,7 +3816,6 @@ static void test_CoGetInstanceFromFile(void)
     mqi[0].pItf = NULL;
     mqi[0].hr = E_NOTIMPL;
     hr = CoGetInstanceFromFile(NULL, NULL, NULL, CLSCTX_INPROC_SERVER, STGM_READ, (OLECHAR*)filenameW, 1, mqi);
-    todo_wine
     ok(hr == MK_E_CANTOPENFILE, "got 0x%08lx\n", hr);
     ok(mqi[0].pItf == NULL, "got %p\n", mqi[0].pItf);
     ok(mqi[0].hr == E_NOINTERFACE, "got 0x%08lx\n", mqi[0].hr);
@@ -3839,21 +3837,17 @@ static void test_CoGetInstanceFromFile(void)
     mqi[0].pItf = (void*)0xdeadbeef;
     mqi[0].hr = S_OK;
     hr = CoGetInstanceFromFile(NULL, clsid, NULL, CLSCTX_INPROC_SERVER, STGM_READ, (OLECHAR*)filenameW, 1, mqi);
-todo_wine {
     ok(hr == E_INVALIDARG, "got 0x%08lx\n", hr);
     ok(mqi[0].pItf == (void*)0xdeadbeef, "got %p\n", mqi[0].pItf);
-}
     ok(mqi[0].hr == S_OK, "got 0x%08lx\n", mqi[0].hr);
 
     mqi[0].pIID = &IID_IUnknown;
     mqi[0].pItf = (void*)0xdeadbeef;
     mqi[0].hr = E_NOTIMPL;
     hr = CoGetInstanceFromFile(NULL, clsid, NULL, CLSCTX_INPROC_SERVER, STGM_READ, (OLECHAR*)filenameW, 1, mqi);
-todo_wine {
     ok(hr == E_INVALIDARG, "got 0x%08lx\n", hr);
     ok(mqi[0].pItf == (void*)0xdeadbeef, "got %p\n", mqi[0].pItf);
     ok(mqi[0].hr == E_NOTIMPL, "got 0x%08lx\n", mqi[0].hr);
-}
     mqi[0].pIID = &IID_IUnknown;
     mqi[0].pItf = NULL;
     mqi[0].hr = E_NOTIMPL;
