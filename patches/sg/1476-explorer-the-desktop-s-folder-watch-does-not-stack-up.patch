From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the desktop's folder watch does not stack up

The desktop watches the Desktop and the Public Desktop folders with
ReadDirectoryChangesW. After either answered, both were asked again, so
the other folder's still-pending request stacked up -- one more for
every change, each holding a buffer, never freed. A download into the
Desktop folder writes it thousands of times: a session's explorer had
grown to 1.3 GB, its glibc arenas full of FILE_NOTIFY records. Each
folder's watch is now asked again only once it has answered.

Gate: test/deskwatch-gate.sh (4000 writes in the Desktop folder;
explorer's and the server's memory stay put). Mutant:
SG_MUTANT_DESKWATCH_STACK.
---
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -735,7 +735,7 @@
     OVERLAPPED ovl0, ovl1;
     char *buf0 = NULL, *buf1 = NULL;
     DWORD count, size = 4096, error = ERROR_OUTOFMEMORY;
-    BOOL ret, redraw;
+    BOOL ret, redraw, pending0 = FALSE, pending1 = FALSE;
 
     dir0 = CreateFileW( desktop_folder, FILE_LIST_DIRECTORY|SYNCHRONIZE, FILE_SHARE_READ|FILE_SHARE_WRITE,
                         NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS|FILE_FLAG_OVERLAPPED, NULL );
@@ -752,21 +752,38 @@
     if (!(buf0 = malloc( size ))) goto error;
     if (!(buf1 = malloc( size ))) goto error;
 
+    /* Stained Glass OS (wine-sg 1476): a folder's watch is asked again only
+     * once it has answered. Both were asked again after either answered, so
+     * the other folder's request stacked up -- one more for every change, each
+     * holding a buffer in this process and in the server, never freed. A
+     * download into the Desktop folder writes it thousands of times: a
+     * session's explorer had grown to 1.3 GB, its server to 100 MB. */
     for (;;)
     {
-        ret = ReadDirectoryChangesW( dir0, buf0, size, FALSE, FILE_NOTIFY_CHANGE_FILE_NAME |
-                                     FILE_NOTIFY_CHANGE_DIR_NAME | FILE_NOTIFY_CHANGE_LAST_WRITE, NULL, &ovl0, NULL );
-        if (!ret)
+#ifdef SG_MUTANT_DESKWATCH_STACK
+        pending0 = pending1 = FALSE;
+#endif
+        if (!pending0)
         {
-            error = GetLastError();
-            goto error;
+            ret = ReadDirectoryChangesW( dir0, buf0, size, FALSE, FILE_NOTIFY_CHANGE_FILE_NAME |
+                                         FILE_NOTIFY_CHANGE_DIR_NAME | FILE_NOTIFY_CHANGE_LAST_WRITE, NULL, &ovl0, NULL );
+            if (!ret)
+            {
+                error = GetLastError();
+                goto error;
+            }
+            pending0 = TRUE;
         }
-        ret = ReadDirectoryChangesW( dir1, buf1, size, FALSE, FILE_NOTIFY_CHANGE_FILE_NAME |
-                                     FILE_NOTIFY_CHANGE_DIR_NAME | FILE_NOTIFY_CHANGE_LAST_WRITE, NULL, &ovl1, NULL );
-        if (!ret)
+        if (!pending1)
         {
-            error = GetLastError();
-            goto error;
+            ret = ReadDirectoryChangesW( dir1, buf1, size, FALSE, FILE_NOTIFY_CHANGE_FILE_NAME |
+                                         FILE_NOTIFY_CHANGE_DIR_NAME | FILE_NOTIFY_CHANGE_LAST_WRITE, NULL, &ovl1, NULL );
+            if (!ret)
+            {
+                error = GetLastError();
+                goto error;
+            }
+            pending1 = TRUE;
         }
 
         redraw = FALSE;
@@ -777,11 +794,13 @@
          * and folders and renames count, not only new shortcuts */
         case WAIT_OBJECT_0:
             GetOverlappedResult( dir0, &ovl0, &count, FALSE );
+            pending0 = FALSE;
             redraw = TRUE;
             break;
 
         case WAIT_OBJECT_0 + 1:
             GetOverlappedResult( dir1, &ovl1, &count, FALSE );
+            pending1 = FALSE;
             redraw = TRUE;
             break;
 
