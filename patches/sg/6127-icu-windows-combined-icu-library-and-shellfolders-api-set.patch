+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Stained Glass OS: Windows 10 1903 and later ship ICU as one library, icu.dll, and programs link
+ * to it by its plain function names (Windows Terminal: u_charType, u_countChar32, u_foldCase,
+ * u_strToUTF32; it would not load without them).  The functions here follow ICU's public API;
+ * their data comes from the Unicode Character Database (uchar_tables.h, make_tables.py).  The
+ * converters are icuuc's.
+ */
+
+#include <stdarg.h>
+#include <stdint.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+
+#include "uchar_tables.h"
+
+typedef WCHAR UChar;
+typedef int32_t UChar32;
+typedef int UErrorCode;
+
+#define U_ZERO_ERROR              0
+#define U_ILLEGAL_ARGUMENT_ERROR  1
+#define U_INVALID_CHAR_FOUND      10
+#define U_BUFFER_OVERFLOW_ERROR   15
+#define U_STRING_NOT_TERMINATED_WARNING (-124)
+
+#define U_FOLD_CASE_EXCLUDE_SPECIAL_I 1
+
+/***********************************************************************
+ *           u_charType   (icu.@)
+ *
+ * The general category (UCharCategory) of a code point.
+ */
+int8_t CDECL u_charType( UChar32 c )
+{
+    unsigned int lo = 0, hi = ARRAY_SIZE(category_ranges);
+
+    if (c < 0 || c > 0x10ffff) return 0;   /* U_UNASSIGNED */
+#ifdef SG_MUTANT_ICU_CHARTYPE_ZERO
+    return 0;
+#endif
+    while (lo < hi)
+    {
+        unsigned int mid = (lo + hi) / 2;
+        if ((unsigned int)c < category_ranges[mid].first) hi = mid;
+        else if ((unsigned int)c > category_ranges[mid].last) lo = mid + 1;
+        else return category_ranges[mid].category;
+    }
+    return 0;
+}
+
+static UChar32 fold_lookup( UChar32 c, const void *table, unsigned int count )
+{
+    const struct { unsigned int code, folded; } *map = table;
+    unsigned int lo = 0, hi = count;
+
+    while (lo < hi)
+    {
+        unsigned int mid = (lo + hi) / 2;
+        if ((unsigned int)c < map[mid].code) hi = mid;
+        else if ((unsigned int)c > map[mid].code) lo = mid + 1;
+        else return map[mid].folded;
+    }
+    return -1;
+}
+
+/***********************************************************************
+ *           u_foldCase   (icu.@)
+ *
+ * Simple case folding of a code point; with U_FOLD_CASE_EXCLUDE_SPECIAL_I, the Turkic mappings of
+ * I and dotted I are used instead of the default ones.
+ */
+UChar32 CDECL u_foldCase( UChar32 c, uint32_t options )
+{
+    UChar32 folded;
+
+    if (c < 0 || c > 0x10ffff) return c;
+    if ((options & U_FOLD_CASE_EXCLUDE_SPECIAL_I) &&
+        (folded = fold_lookup( c, case_folding_turkic, ARRAY_SIZE(case_folding_turkic) )) >= 0)
+        return folded;
+    if ((folded = fold_lookup( c, case_folding, ARRAY_SIZE(case_folding) )) >= 0) return folded;
+    return c;
+}
+
+/***********************************************************************
+ *           u_countChar32   (icu.@)
+ *
+ * Code points in UTF-16 text (length -1: up to the terminating zero); an unpaired surrogate counts
+ * as one.
+ */
+int32_t CDECL u_countChar32( const UChar *s, int32_t length )
+{
+    int32_t count = 0, i = 0;
+
+    if (!s || length < -1) return 0;
+    for (;;)
+    {
+        if (length >= 0 ? i >= length : !s[i]) break;
+        if (IS_HIGH_SURROGATE( s[i] ) && (length >= 0 ? i + 1 < length : s[i + 1] != 0) && IS_LOW_SURROGATE( s[i + 1] ))
+            i += 2;
+        else
+            i++;
+        count++;
+    }
+    return count;
+}
+
+/***********************************************************************
+ *           u_strToUTF32   (icu.@)
+ *
+ * UTF-16 to UTF-32.  The length needed is returned in *dest_length (without the terminator) even
+ * when the buffer is too small (U_BUFFER_OVERFLOW_ERROR); an unpaired surrogate is an error
+ * (U_INVALID_CHAR_FOUND), as ICU has it without a substitution character.
+ */
+UChar32 * CDECL u_strToUTF32( UChar32 *dest, int32_t capacity, int32_t *dest_length, const UChar *src,
+                              int32_t src_length, UErrorCode *error )
+{
+    int32_t i = 0, n = 0;
+
+    if (!error || *error > U_ZERO_ERROR) return NULL;
+    if ((!src && src_length != 0) || src_length < -1 || capacity < 0 || (!dest && capacity > 0))
+    {
+        *error = U_ILLEGAL_ARGUMENT_ERROR;
+        return NULL;
+    }
+    for (;;)
+    {
+        UChar32 c;
+
+        if (src_length >= 0 ? i >= src_length : !src[i]) break;
+        c = src[i++];
+        if (IS_HIGH_SURROGATE( c ))
+        {
+            if ((src_length >= 0 ? i < src_length : src[i] != 0) && IS_LOW_SURROGATE( src[i] ))
+                c = 0x10000 + ((c - 0xd800) << 10) + (src[i++] - 0xdc00);
+            else
+            {
+                *error = U_INVALID_CHAR_FOUND;
+                return NULL;
+            }
+        }
+        else if (IS_LOW_SURROGATE( c ))
+        {
+            *error = U_INVALID_CHAR_FOUND;
+            return NULL;
+        }
+        if (n < capacity) dest[n] = c;
+        n++;
+    }
+    if (dest_length) *dest_length = n;
+    if (n < capacity) dest[n] = 0;
+    else if (n == capacity) *error = U_STRING_NOT_TERMINATED_WARNING;
+    else *error = U_BUFFER_OVERFLOW_ERROR;
+    return dest;
+}
