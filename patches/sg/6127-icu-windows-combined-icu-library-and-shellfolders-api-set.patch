diff --git a/dlls/icu/make_tables.py b/dlls/icu/make_tables.py
new file mode 100644
index 0000000..dacf0b8
--- /dev/null
+++ b/dlls/icu/make_tables.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+# Stained Glass OS: writes uchar_tables.h for icu.dll from the Unicode Character Database
+# (UnicodeData.txt and CaseFolding.txt):
+#   python3 make_tables.py /usr/share/unicode > uchar_tables.h
+# General categories as ranges with ICU's UCharCategory numbers; simple case folding (status C and S)
+# as pairs, and the Turkic (T) entries apart.
+import sys, os
+
+ucd = sys.argv[1]
+GC = { 'Cn': 0, 'Lu': 1, 'Ll': 2, 'Lt': 3, 'Lm': 4, 'Lo': 5, 'Mn': 6, 'Me': 7, 'Mc': 8, 'Nd': 9,
+       'Nl': 10, 'No': 11, 'Zs': 12, 'Zl': 13, 'Zp': 14, 'Cc': 15, 'Cf': 16, 'Co': 17, 'Cs': 18,
+       'Pd': 19, 'Ps': 20, 'Pe': 21, 'Pc': 22, 'Po': 23, 'Sm': 24, 'Sc': 25, 'Sk': 26, 'So': 27,
+       'Pi': 28, 'Pf': 29 }
+cat = {}
+first = None
+for line in open(os.path.join(ucd, 'UnicodeData.txt'), encoding='utf-8'):
+    f = line.split(';')
+    cp = int(f[0], 16)
+    name, gc = f[1], f[2]
+    if name.endswith(', First>'):
+        first = cp
+        continue
+    if name.endswith(', Last>'):
+        for c in range(first, cp + 1): cat[c] = GC[gc]
+        continue
+    cat[cp] = GC[gc]
+ranges = []
+start, cur = 0, cat.get(0, 0)
+for c in range(1, 0x110000):
+    g = cat.get(c, 0)
+    if g != cur:
+        ranges.append((start, c - 1, cur))
+        start, cur = c, g
+ranges.append((start, 0x10ffff, cur))
+fold, turkic = [], []
+for line in open(os.path.join(ucd, 'CaseFolding.txt'), encoding='utf-8'):
+    line = line.split('#')[0].strip()
+    if not line: continue
+    code, status, mapping = [x.strip() for x in line.split(';')[:3]]
+    if status in ('C', 'S'): fold.append((int(code, 16), int(mapping, 16)))
+    elif status == 'T': turkic.append((int(code, 16), int(mapping, 16)))
+print('/* generated by make_tables.py from the Unicode Character Database -- do not edit */')
+print('static const struct { unsigned int first, last; unsigned char category; } category_ranges[] =\n{')
+for a, b, g in ranges: print('    { 0x%06x, 0x%06x, %d },' % (a, b, g))
+print('};\n')
+print('static const struct { unsigned int code, folded; } case_folding[] =\n{')
+for a, b in sorted(fold): print('    { 0x%06x, 0x%06x },' % (a, b))
+print('};\n')
+print('static const struct { unsigned int code, folded; } case_folding_turkic[] =\n{')
+for a, b in sorted(turkic): print('    { 0x%06x, 0x%06x },' % (a, b))
+print('};')
diff --git a/dlls/icu/uchar.c b/dlls/icu/uchar.c
new file mode 100644
index 0000000..1be4fe1
--- /dev/null
+++ b/dlls/icu/uchar.c
@@ -0,0 +1,176 @@
+/*
+ * icu.dll: character properties and strings
+ *
+ * Copyright 2026 Stained Glass OS
+ *
