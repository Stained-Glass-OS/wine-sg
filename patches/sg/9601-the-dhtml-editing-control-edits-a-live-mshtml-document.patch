+        *status = DECMDF_DISABLED;
+    else if (flags & OLECMDF_LATCHED)
+        *status = DECMDF_LATCHED;
+    else if (flags & OLECMDF_NINCHED)
+        *status = DECMDF_NINCHED;
+    else
+        *status = DECMDF_ENABLED;
