+/* the control's side */
+
+HRESULT doc_host_create(const struct doc_host_events *events, void *ctx, struct doc_host **ret)
+{
+    IConnectionPointContainer *cpc;
+    IConnectionPoint *cp;
+    IOleObject *oleobj;
+    struct doc_host *host;
+    HRESULT hr;
+
+    *ret = NULL;
+#ifdef SG_MUTANT_DH_NO_MSHTML
+    return E_NOTIMPL;
+#endif
+    if (!(host = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*host)))) return E_OUTOFMEMORY;
+    host->IOleClientSite_iface.lpVtbl = &ClientSiteVtbl;
+    host->IOleInPlaceSite_iface.lpVtbl = &InPlaceSiteVtbl;
+    host->IOleInPlaceFrame_iface.lpVtbl = &FrameVtbl;
+    host->IDocHostUIHandler_iface.lpVtbl = &UIHandlerVtbl;
+    host->IPropertyNotifySink_iface.lpVtbl = &PropertyNotifySinkVtbl;
+    host->ref = 1;
+    host->events = events;
+    host->ctx = ctx;
+    host->ui_flags = DOCHOSTUIFLAG_DISABLE_HELP_MENU;
+
+    hr = CoCreateInstance(&CLSID_HTMLDocument, NULL, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&host->doc);
+    if (FAILED(hr))
+    {
+        WARN("no MSHTML document: %08lx\n", hr);
+        HeapFree(GetProcessHeap(), 0, host);
+        return hr;
+    }
+    IUnknown_QueryInterface(host->doc, &IID_IHTMLDocument2, (void **)&host->doc2);
+    IUnknown_QueryInterface(host->doc, &IID_IOleCommandTarget, (void **)&host->cmdtrg);
+    if (!host->doc2 || !host->cmdtrg)
+    {
+        doc_host_destroy(host);
+        return E_NOINTERFACE;
+    }
+
+    if (SUCCEEDED(IUnknown_QueryInterface(host->doc, &IID_IOleObject, (void **)&oleobj)))
+    {
+        IOleObject_SetClientSite(oleobj, &host->IOleClientSite_iface);
+        IOleObject_Release(oleobj);
+    }
+    if (SUCCEEDED(IUnknown_QueryInterface(host->doc, &IID_IConnectionPointContainer, (void **)&cpc)))
+    {
+        if (SUCCEEDED(IConnectionPointContainer_FindConnectionPoint(cpc, &IID_IPropertyNotifySink, &cp)))
+        {
+            IConnectionPoint_Advise(cp, (IUnknown *)&host->IPropertyNotifySink_iface, &host->notify_cookie);
+            IConnectionPoint_Release(cp);
+        }
+        IConnectionPointContainer_Release(cpc);
+    }
+    *ret = host;
+    return S_OK;
+}
+
+void doc_host_destroy(struct doc_host *host)
+{
+    IConnectionPointContainer *cpc;
+    IConnectionPoint *cp;
+    IOleObject *oleobj;
+
+    host->events = NULL;
+    if (host->doc)
+    {
+        doc_host_deactivate(host);
+        if (host->notify_cookie &&
+            SUCCEEDED(IUnknown_QueryInterface(host->doc, &IID_IConnectionPointContainer, (void **)&cpc)))
+        {
+            if (SUCCEEDED(IConnectionPointContainer_FindConnectionPoint(cpc, &IID_IPropertyNotifySink, &cp)))
+            {
+                IConnectionPoint_Unadvise(cp, host->notify_cookie);
+                IConnectionPoint_Release(cp);
+            }
+            IConnectionPointContainer_Release(cpc);
+        }
+        if (SUCCEEDED(IUnknown_QueryInterface(host->doc, &IID_IOleObject, (void **)&oleobj)))
+        {
+            IOleObject_Close(oleobj, OLECLOSE_NOSAVE);
+            IOleObject_SetClientSite(oleobj, NULL);
+            IOleObject_Release(oleobj);
+        }
+    }
+    if (host->cmdtrg) IOleCommandTarget_Release(host->cmdtrg);
+    if (host->doc2) IHTMLDocument2_Release(host->doc2);
+    if (host->doc) IUnknown_Release(host->doc);
+    host->cmdtrg = NULL;
+    host->doc2 = NULL;
+    host->doc = NULL;
+    host_release(host);
+}
+
+/* starts loading the HTML source; ready() is called when the document is complete */
+HRESULT doc_host_load(struct doc_host *host, const WCHAR *html, BOOL edit)
+{
+    IPersistStreamInit *persist;
+    IStream *stream;
+    HGLOBAL mem;
+    char *data;
+    int len;
+    HRESULT hr;
+
+    if (!html) html = L"";
+    /* UTF-8 with its byte order mark, so the parser takes any character as it is */
+    len = WideCharToMultiByte(CP_UTF8, 0, html, -1, NULL, 0, NULL, NULL);
+    if (!(mem = GlobalAlloc(GMEM_MOVEABLE, len + 3))) return E_OUTOFMEMORY;
+    data = GlobalLock(mem);
+    data[0] = 0xef; data[1] = 0xbb; data[2] = 0xbf;
+    WideCharToMultiByte(CP_UTF8, 0, html, -1, data + 3, len, NULL, NULL);
+    GlobalUnlock(mem);
+    /* without the terminating null */
+    if (FAILED(hr = CreateStreamOnHGlobal(mem, TRUE, &stream)))
+    {
+        GlobalFree(mem);
+        return hr;
+    }
+    {
+        ULARGE_INTEGER size;
+        size.QuadPart = len + 2;
+        IStream_SetSize(stream, size);
+    }
+
+    host->edit = edit;
+    host->ready = FALSE;
+    host->loading = TRUE;
+    hr = IUnknown_QueryInterface(host->doc, &IID_IPersistStreamInit, (void **)&persist);
+    if (SUCCEEDED(hr))
+    {
+        hr = IPersistStreamInit_Load(persist, stream);
+        IPersistStreamInit_Release(persist);
+    }
+    IStream_Release(stream);
+    if (FAILED(hr))
+    {
+        host->loading = FALSE;
+        return hr;
+    }
+    check_ready(host);
+    return S_OK;
+}
+
+BOOL doc_host_ready(struct doc_host *host)
+{
+    return host->ready;
+}
+
+IHTMLDocument2 *doc_host_document(struct doc_host *host)
+{
+    return host->doc2;
+}
+
+/* the document's source as MSHTML has it now */
+HRESULT doc_host_get_html(struct doc_host *host, BSTR *ret)
+{
+    IHTMLDocument3 *doc3;
+    IHTMLElement *elem = NULL;
+    HRESULT hr;
+
+    *ret = NULL;
+    if (!host->ready) return E_PENDING;
+    if (FAILED(hr = IHTMLDocument2_QueryInterface(host->doc2, &IID_IHTMLDocument3, (void **)&doc3))) return hr;
+    hr = IHTMLDocument3_get_documentElement(doc3, &elem);
+    IHTMLDocument3_Release(doc3);
+    if (FAILED(hr) || !elem) return FAILED(hr) ? hr : E_FAIL;
+    hr = IHTMLElement_get_outerHTML(elem, ret);
+    IHTMLElement_Release(elem);
+    return hr;
+}
+
+BOOL doc_host_is_dirty(struct doc_host *host)
+{
+    IPersistStreamInit *persist;
+    HRESULT hr = S_FALSE;
+
+    if (!host->ready) return FALSE;
+    if (SUCCEEDED(IUnknown_QueryInterface(host->doc, &IID_IPersistStreamInit, (void **)&persist)))
+    {
+        hr = IPersistStreamInit_IsDirty(persist);
+        IPersistStreamInit_Release(persist);
+    }
+    return hr == S_OK;
+}
+
+HRESULT doc_host_exec(struct doc_host *host, DWORD id, DWORD options, VARIANT *in, VARIANT *out)
+{
+    if (!host->ready) return E_UNEXPECTED;
+    return IOleCommandTarget_Exec(host->cmdtrg, &CGID_MSHTML, id, options, in, out);
+}
+
+HRESULT doc_host_query(struct doc_host *host, DWORD id, DWORD *flags)
+{
+    OLECMD cmd;
+    HRESULT hr;
+
+    *flags = 0;
+    if (!host->ready) return S_OK;
+    cmd.cmdID = id;
+    cmd.cmdf = 0;
+    hr = IOleCommandTarget_QueryStatus(host->cmdtrg, &CGID_MSHTML, 1, &cmd, NULL);
+    if (SUCCEEDED(hr)) *flags = cmd.cmdf;
+    return hr;
+}
+
+void doc_host_set_ui_flags(struct doc_host *host, DWORD flags)
+{
+    host->ui_flags = flags;
+}
+
+/* shows the document in the container's window at the control's place */
+HRESULT doc_host_activate(struct doc_host *host, HWND parent, const RECT *pos, const RECT *clip)
+{
+    IOleObject *oleobj;
+    HRESULT hr;
+
+    host->parent = parent;
+    host->pos = *pos;
+    host->clip = clip ? *clip : *pos;
+    if (FAILED(hr = IUnknown_QueryInterface(host->doc, &IID_IOleObject, (void **)&oleobj))) return hr;
+    hr = IOleObject_DoVerb(oleobj, OLEIVERB_SHOW, NULL, &host->IOleClientSite_iface, 0, parent, &host->pos);
+    IOleObject_Release(oleobj);
+    TRACE("activated in %p: %08lx\n", parent, hr);
+    return hr;
+}
+
+void doc_host_deactivate(struct doc_host *host)
+{
+    IOleInPlaceObject *ipobj;
+
+    if (!host->in_place) return;
+    if (SUCCEEDED(IUnknown_QueryInterface(host->doc, &IID_IOleInPlaceObject, (void **)&ipobj)))
+    {
+        IOleInPlaceObject_InPlaceDeactivate(ipobj);
+        IOleInPlaceObject_Release(ipobj);
+    }
+    host->in_place = host->ui_active = FALSE;
+    host->parent = NULL;
+}
+
+void doc_host_set_rects(struct doc_host *host, const RECT *pos, const RECT *clip)
+{
+    IOleInPlaceObject *ipobj;
+
+    host->pos = *pos;
+    host->clip = *clip;
+    if (!host->in_place) return;
+    if (SUCCEEDED(IUnknown_QueryInterface(host->doc, &IID_IOleInPlaceObject, (void **)&ipobj)))
+    {
+        IOleInPlaceObject_SetObjectRects(ipobj, pos, clip);
+        IOleInPlaceObject_Release(ipobj);
+    }
+}
+
+HWND doc_host_window(struct doc_host *host)
+{
+    IOleWindow *window;
+    HWND hwnd = NULL;
+
+    if (!host->in_place) return NULL;
+    if (SUCCEEDED(IUnknown_QueryInterface(host->doc, &IID_IOleWindow, (void **)&window)))
+    {
+        if (FAILED(IOleWindow_GetWindow(window, &hwnd))) hwnd = NULL;
+        IOleWindow_Release(window);
+    }
+    return hwnd;
+}
+
+HRESULT doc_host_translate_accelerator(struct doc_host *host, MSG *msg)
+{
+    IOleInPlaceActiveObject *active;
+    HRESULT hr = S_FALSE;
+
+    if (!host->in_place) return S_FALSE;
+    if (SUCCEEDED(IUnknown_QueryInterface(host->doc, &IID_IOleInPlaceActiveObject, (void **)&active)))
+    {
+        hr = IOleInPlaceActiveObject_TranslateAccelerator(active, msg);
+        IOleInPlaceActiveObject_Release(active);
+    }
+    return hr;
+}
