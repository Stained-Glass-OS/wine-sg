+BOOL doc_host_is_dirty(struct doc_host *host);
+HRESULT doc_host_exec(struct doc_host *host, DWORD id, DWORD options, VARIANT *in, VARIANT *out);
+HRESULT doc_host_query(struct doc_host *host, DWORD id, DWORD *flags);
+void doc_host_set_ui_flags(struct doc_host *host, DWORD flags);
+HRESULT doc_host_activate(struct doc_host *host, HWND parent, const RECT *pos, const RECT *clip);
+void doc_host_deactivate(struct doc_host *host);
+void doc_host_set_rects(struct doc_host *host, const RECT *pos, const RECT *clip);
+HWND doc_host_window(struct doc_host *host);
+HRESULT doc_host_translate_accelerator(struct doc_host *host, MSG *msg);
