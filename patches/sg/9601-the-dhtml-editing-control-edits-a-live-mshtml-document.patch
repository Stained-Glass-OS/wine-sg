+
+static void free_menu(DHTMLEditImpl *This)
+{
+    DWORD i;
+
+    for (i = 0; i < This->menu_count; i++) SysFreeString(This->menu_items[i]);
+    HeapFree(GetProcessHeap(), 0, This->menu_items);
+    HeapFree(GetProcessHeap(), 0, This->menu_states);
+    This->menu_items = NULL;
+    This->menu_states = NULL;
+    This->menu_count = 0;
+}
+
+/* the items of a script array (a JScript Array object), a SAFEARRAY or a VBScript array */
+static HRESULT get_list_item(const VARIANT *list, LONG index, VARIANT *ret)
+{
+    VariantInit(ret);
+    if (V_VT(list) == VT_DISPATCH || V_VT(list) == VT_UNKNOWN)
+    {
+        DISPPARAMS dp = {0};
+        WCHAR name[16];
+        LPOLESTR names = name;
+        IDispatch *disp;
+        DISPID id;
+        HRESULT hr;
+
+        if (V_VT(list) == VT_DISPATCH) disp = V_DISPATCH(list);
+        else if (FAILED(IUnknown_QueryInterface(V_UNKNOWN(list), &IID_IDispatch, (void **)&disp))) return E_INVALIDARG;
+        else IDispatch_Release(disp);
+        if (!disp) return E_INVALIDARG;
+        swprintf(name, ARRAY_SIZE(name), L"%ld", index);
+        if (FAILED(hr = IDispatch_GetIDsOfNames(disp, &IID_NULL, &names, 1, LOCALE_USER_DEFAULT, &id))) return hr;
+        return IDispatch_Invoke(disp, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_PROPERTYGET, &dp, ret, NULL, NULL);
+    }
+    if (V_VT(list) & VT_ARRAY)
+    {
+        SAFEARRAY *sa = V_ARRAY(list);
+        LONG lbound;
+        VARTYPE vt;
+        HRESULT hr;
+
+        SafeArrayGetLBound(sa, 1, &lbound);
+        SafeArrayGetVartype(sa, &vt);
+        index += lbound;
+        if (vt == VT_VARIANT) return SafeArrayGetElement(sa, &index, ret);
+        if (vt == VT_BSTR)
+        {
+            BSTR str = NULL;
+            if (FAILED(hr = SafeArrayGetElement(sa, &index, &str))) return hr;
+            V_VT(ret) = VT_BSTR;
+            V_BSTR(ret) = str;
+            return S_OK;
+        }
+        if (vt == VT_I4 || vt == VT_INT || vt == VT_UI4)
+        {
+            V_VT(ret) = VT_I4;
+            return SafeArrayGetElement(sa, &index, &V_I4(ret));
+        }
+        if (vt == VT_I2)
+        {
+            V_VT(ret) = VT_I2;
+            return SafeArrayGetElement(sa, &index, &V_I2(ret));
+        }
+    }
+    return E_INVALIDARG;
+}
+
+static HRESULT get_list_length(const VARIANT *list, LONG *len)
+{
+    *len = 0;
+    if (V_VT(list) == VT_EMPTY || V_VT(list) == VT_NULL || V_VT(list) == VT_ERROR) return S_OK;
+    if (V_VT(list) == VT_DISPATCH || V_VT(list) == VT_UNKNOWN)
+    {
+        DISPPARAMS dp = {0};
+        LPOLESTR name = (LPOLESTR)L"length";
+        IDispatch *disp = NULL;
+        VARIANT v;
+        DISPID id;
+        HRESULT hr;
+
+        if (V_VT(list) == VT_DISPATCH) { disp = V_DISPATCH(list); if (disp) IDispatch_AddRef(disp); }
+        else if (V_UNKNOWN(list)) IUnknown_QueryInterface(V_UNKNOWN(list), &IID_IDispatch, (void **)&disp);
+        if (!disp) return E_INVALIDARG;
+        VariantInit(&v);
+        hr = IDispatch_GetIDsOfNames(disp, &IID_NULL, &name, 1, LOCALE_USER_DEFAULT, &id);
+        if (SUCCEEDED(hr))
+            hr = IDispatch_Invoke(disp, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_PROPERTYGET, &dp, &v, NULL, NULL);
+        IDispatch_Release(disp);
+        if (SUCCEEDED(hr) && SUCCEEDED(hr = VariantChangeType(&v, &v, 0, VT_I4))) *len = V_I4(&v);
+        VariantClear(&v);
+        return hr;
+    }
+    if ((V_VT(list) & VT_ARRAY) && V_ARRAY(list))
+    {
+        LONG lbound, ubound;
+        if (SafeArrayGetDim(V_ARRAY(list)) != 1) return E_INVALIDARG;
+        SafeArrayGetLBound(V_ARRAY(list), 1, &lbound);
+        SafeArrayGetUBound(V_ARRAY(list), 1, &ubound);
+        *len = ubound - lbound + 1;
+        return S_OK;
+    }
+    return E_INVALIDARG;
+}
+
+static const VARIANT *deref_variant(const VARIANT *v)
+{
+    while (v && V_VT(v) == (VT_VARIANT | VT_BYREF)) v = V_VARIANTREF(v);
+    return v;
 }
 
 static HRESULT WINAPI DHTMLEdit_SetContextMenu(IDHTMLEdit *iface, VARIANT *strings, VARIANT *states)
 {
     DHTMLEditImpl *This = impl_from_IDHTMLEdit(iface);
-    FIXME("(%p)->(%p, %p) stub\n", This, strings, states);
-    return E_NOTIMPL;
+    const VARIANT *str_list, *state_list;
+    VARIANT local_str, local_state;
+    LONG count, state_count, i;
+    HRESULT hr;
+
+    TRACE("(%p)->(%s, %s)\n", This, debugstr_variant(strings), debugstr_variant(states));
+
+    if (!strings || !states) return E_INVALIDARG;
+    str_list = deref_variant(strings);
+    state_list = deref_variant(states);
+    /* arrays passed by reference */
+    if ((V_VT(str_list) & VT_ARRAY) && (V_VT(str_list) & VT_BYREF))
+    {
+        V_VT(&local_str) = V_VT(str_list) & ~VT_BYREF;
+        V_ARRAY(&local_str) = *V_ARRAYREF(str_list);
+        str_list = &local_str;
+    }
+    if ((V_VT(state_list) & VT_ARRAY) && (V_VT(state_list) & VT_BYREF))
+    {
+        V_VT(&local_state) = V_VT(state_list) & ~VT_BYREF;
+        V_ARRAY(&local_state) = *V_ARRAYREF(state_list);
+        state_list = &local_state;
+    }
+    if (FAILED(hr = get_list_length(str_list, &count))) return hr;
+    if (FAILED(hr = get_list_length(state_list, &state_count))) return hr;
+    /* the two lists go together, item by item */
+    if (count != state_count) return E_INVALIDARG;
+
+    free_menu(This);
+    if (!count) return S_OK;    /* an empty list: no menu */
+    if (!(This->menu_items = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, count * sizeof(*This->menu_items))) ||
+        !(This->menu_states = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, count * sizeof(*This->menu_states))))
+    {
+        free_menu(This);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        VARIANT item, state;
+
+        if (FAILED(hr = get_list_item(str_list, i, &item))) break;
+        if (FAILED(hr = VariantChangeType(&item, &item, 0, VT_BSTR))) { VariantClear(&item); break; }
+        This->menu_items[i] = V_BSTR(&item);
+        This->menu_count = i + 1;
+        if (FAILED(hr = get_list_item(state_list, i, &state))) break;
+        if (FAILED(hr = VariantChangeType(&state, &state, 0, VT_I4))) { VariantClear(&state); break; }
+        This->menu_states[i] = V_I4(&state);
+    }
+    if (FAILED(hr)) free_menu(This);
+    return hr;
+}
+
+/* MSHTML finished loading the document */
+static void host_ready(void *ctx)
+{
+    DHTMLEditImpl *This = ctx;
+
+    dhtml_edit_addref(This);
+    fire_event(This, DISPID_DOCUMENTCOMPLETE);
+    fire_event(This, DISPID_DISPLAYCHANGED);
+    dhtml_edit_release(This);
+}
+
+static void host_changed(void *ctx)
+{
+    fire_event(ctx, DISPID_DISPLAYCHANGED);
+}
+
+/* Right click: ShowContextMenu(x, y) lets the program call SetContextMenu; the
+ * items it set are shown, and the one chosen is ContextMenuAction(index). */
+static void host_context_menu(void *ctx, const POINT *pt)
+{
+    DHTMLEditImpl *This = ctx;
+    VARIANT args[2];
+    POINT client = *pt;
+    HWND hwnd;
+    HMENU menu;
+    DWORD i;
+    int chosen;
+
+    dhtml_edit_addref(This);
+    hwnd = This->host ? doc_host_window(This->host) : NULL;
+    if (hwnd) ScreenToClient(hwnd, &client);
+    free_menu(This);
+    /* arguments in reverse order */
+    V_VT(&args[1]) = VT_I4; V_I4(&args[1]) = client.x;
+    V_VT(&args[0]) = VT_I4; V_I4(&args[0]) = client.y;
+    fire_event_args(This, DISPID_SHOWCONTEXTMENU, args, 2);
+    if (This->menu_count && (menu = CreatePopupMenu()))
+    {
+        for (i = 0; i < This->menu_count; i++)
+        {
+            UINT flags = MF_STRING;
+
+            if (!This->menu_items[i] || !*This->menu_items[i])
+            {
+                AppendMenuW(menu, MF_SEPARATOR, 0, NULL);
+                continue;
+            }
+            if (This->menu_states[i] == DECMDF_DISABLED || This->menu_states[i] == DECMDF_NOTSUPPORTED)
+                flags |= MF_GRAYED;
+            else if (This->menu_states[i] == DECMDF_LATCHED)
+                flags |= MF_CHECKED;
+            AppendMenuW(menu, flags, i + 1, This->menu_items[i]);
+        }
+        chosen = TrackPopupMenu(menu, TPM_LEFTALIGN | TPM_TOPALIGN | TPM_RETURNCMD | TPM_RIGHTBUTTON,
+                                pt->x, pt->y, 0, hwnd ? hwnd : GetActiveWindow(), NULL);
+        DestroyMenu(menu);
+        if (chosen > 0)
+        {
+            V_VT(&args[0]) = VT_I4;
+            V_I4(&args[0]) = chosen - 1;
+            fire_event_args(This, DISPID_CONTEXTMENUACTION, args, 1);
+        }
+    }
+    dhtml_edit_release(This);
 }
 
