+static void check_ready(struct doc_host *host)
+{
+    BSTR state = NULL;
+
+    if (!host->loading || !host->doc2) return;
+    if (FAILED(IHTMLDocument2_get_readyState(host->doc2, &state)) || !state) return;
+    if (!wcscmp(state, L"complete"))
+    {
+        host->loading = FALSE;
+        if (host->edit)
+        {
+            BSTR on = SysAllocString(L"On");
+            HRESULT hr = IHTMLDocument2_put_designMode(host->doc2, on);
+            if (FAILED(hr)) WARN("design mode failed %08lx\n", hr);
+            SysFreeString(on);
+        }
+        host->ready = TRUE;
+        TRACE("document ready\n");
+        if (host->events && host->events->ready)
+            host->events->ready(host->ctx);
+    }
+    SysFreeString(state);
+}
+
+static HRESULT WINAPI PropertyNotifySink_OnChanged(IPropertyNotifySink *iface, DISPID id)
+{
+    struct doc_host *host = impl_from_IPropertyNotifySink(iface);
+
+    if (id == DISPID_READYSTATE)
+    {
+        host_addref(host);
+        check_ready(host);
+        host_release(host);
+    }
+    return S_OK;
+}
