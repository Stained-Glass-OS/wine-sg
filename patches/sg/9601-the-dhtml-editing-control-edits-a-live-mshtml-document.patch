+static inline struct doc_host *impl_from_IPropertyNotifySink(IPropertyNotifySink *iface)
+{
+    return CONTAINING_RECORD(iface, struct doc_host, IPropertyNotifySink_iface);
+}
+
+static HRESULT host_qi(struct doc_host *host, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IOleClientSite))
+        *ppv = &host->IOleClientSite_iface;
+    else if (IsEqualGUID(riid, &IID_IOleWindow) || IsEqualGUID(riid, &IID_IOleInPlaceSite))
+        *ppv = &host->IOleInPlaceSite_iface;
+    else if (IsEqualGUID(riid, &IID_IDocHostUIHandler))
+        *ppv = &host->IDocHostUIHandler_iface;
+    else if (IsEqualGUID(riid, &IID_IPropertyNotifySink))
+        *ppv = &host->IPropertyNotifySink_iface;
+    else
+    {
+        *ppv = NULL;
+        TRACE("no %s\n", debugstr_guid(riid));
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&host->ref);
+    return S_OK;
+}
+
+static ULONG host_addref(struct doc_host *host)
+{
+    return InterlockedIncrement(&host->ref);
+}
+
+static ULONG host_release(struct doc_host *host)
+{
+    LONG ref = InterlockedDecrement(&host->ref);
+    if (!ref) HeapFree(GetProcessHeap(), 0, host);
+    return ref;
+}
