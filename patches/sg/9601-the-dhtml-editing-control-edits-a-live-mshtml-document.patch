+	docsite.c \
 	edit.c \
 	main.c
--- a/dlls/dhtmled.ocx/dhtmled_private.h
+++ b/dlls/dhtmled.ocx/dhtmled_private.h
@@ -17,4 +17,29 @@
  */
 
