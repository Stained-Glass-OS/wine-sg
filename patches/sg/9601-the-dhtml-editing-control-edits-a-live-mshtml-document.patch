+{
+    IOleClientSite IOleClientSite_iface;
+    IOleInPlaceSite IOleInPlaceSite_iface;
+    IOleInPlaceFrame IOleInPlaceFrame_iface;
+    IDocHostUIHandler IDocHostUIHandler_iface;
+    IPropertyNotifySink IPropertyNotifySink_iface;
+    LONG ref;
+
+    const struct doc_host_events *events;
+    void *ctx;
+
+    IUnknown *doc;                  /* the MSHTML document object */
+    IHTMLDocument2 *doc2;
+    IOleCommandTarget *cmdtrg;
+    DWORD notify_cookie;
+
+    BOOL edit;                      /* design mode once loaded */
+    BOOL loading, ready;
+    DWORD ui_flags;                 /* DOCHOSTUIFLAG_ for GetHostInfo */
+
+    HWND parent;                    /* the container's window while in place */
+    RECT pos, clip;
+    BOOL in_place, ui_active;
+};
+
+static inline struct doc_host *impl_from_IOleClientSite(IOleClientSite *iface)
+{
+    return CONTAINING_RECORD(iface, struct doc_host, IOleClientSite_iface);
+}
+
+static inline struct doc_host *impl_from_IOleInPlaceSite(IOleInPlaceSite *iface)
+{
+    return CONTAINING_RECORD(iface, struct doc_host, IOleInPlaceSite_iface);
+}
+
+static inline struct doc_host *impl_from_IOleInPlaceFrame(IOleInPlaceFrame *iface)
+{
