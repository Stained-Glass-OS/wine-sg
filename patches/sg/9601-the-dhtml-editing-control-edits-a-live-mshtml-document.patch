+/* the MSHTML document behind the control, made the first time it is needed */
+static struct doc_host *get_host(DHTMLEditImpl *This)
+{
+    if (!This->host && !This->no_host)
+    {
+        if (FAILED(doc_host_create(&host_events, This, &This->host)))
+        {
+            This->no_host = TRUE;
+            This->host = NULL;
