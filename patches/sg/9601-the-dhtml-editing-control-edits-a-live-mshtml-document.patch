+        if (V_VT(&in) != VT_EMPTY && V_VT(&in) != VT_ERROR) arg = &in;
+    }
+    switch (command_map[i].kind)
+    {
+    case CMD_GET:
+        if (!code_out) hr = E_INVALIDARG;
+        else
+        {
+            VariantClear(code_out);
+            hr = doc_host_exec(host, command_map[i].idm, OLECMDEXECOPT_DONTPROMPTUSER, NULL, code_out);
+        }
+        break;
+    case CMD_SET:
+        hr = arg ? doc_host_exec(host, command_map[i].idm, OLECMDEXECOPT_DONTPROMPTUSER, arg, NULL) : E_INVALIDARG;
+        break;
+    default:
+        hr = doc_host_exec(host, command_map[i].idm, options, arg, code_out);
+        break;
+    }
+    if (arg) VariantClear(arg);
+    if (SUCCEEDED(hr) && command_map[i].kind != CMD_GET)
+        fire_event(This, DISPID_DISPLAYCHANGED);
+    return hr;
 }
 
 static HRESULT WINAPI DHTMLEdit_QueryStatus(IDHTMLEdit *iface, DHTMLEDITCMDID cmd_id, DHTMLEDITCMDF *status)
 {
     DHTMLEditImpl *This = impl_from_IDHTMLEdit(iface);
-    FIXME("(%p)->(%u, %p) stub\n", This, cmd_id, status);
+    struct doc_host *host;
