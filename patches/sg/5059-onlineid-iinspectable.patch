From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.security.authentication.onlineid: Implement IInspectable on its objects.

IInspectable on Windows.Security.Authentication.OnlineId's objects: the
OnlineIdSystemAuthenticator and OnlineIdServiceTicketRequest factories list
their interfaces, answer GetRuntimeClassName with E_ILLEGAL_METHOD_CALL and are
BaseTrust; the authenticator is named OnlineIdSystemAuthenticatorForUser and is
BaseTrust; requests, results and GetTicketAsync's operation (also through its
IAsyncInfo) list their interfaces, and the operation is named
IAsyncOperation`1<...OnlineIdSystemTicketResult>. They returned E_NOTIMPL.

Gate: test/onlineid-inspectable-gate.sh.
---
 .../authenticator.c                                | 41 +++++++++++++++-------
 .../objects.c                                      | 18 ++++++----
 .../private.h                                      | 17 +++++++++
 .../ticket.c                                       | 20 +++++++----
 4 files changed, 72 insertions(+), 24 deletions(-)

diff --git a/dlls/windows.security.authentication.onlineid/authenticator.c b/dlls/windows.security.authentication.onlineid/authenticator.c
index 5854ab9..4676420 100644
--- a/dlls/windows.security.authentication.onlineid/authenticator.c
+++ b/dlls/windows.security.authentication.onlineid/authenticator.c
@@ -80,20 +80,28 @@ static ULONG WINAPI factory_Release( IActivationFactory *iface )
 
 static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
 {
-    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
-    return E_NOTIMPL;
+    static const IID *const list[] = { &IID_IActivationFactory, &IID_IOnlineIdSystemAuthenticatorStatics, &IID_IAgileObject };
+
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    return inspectable_iids( list, ARRAY_SIZE(list), iid_count, iids );
 }
 
 static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
 {
-    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
-    return E_NOTIMPL;
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+
+    /* a class factory or a static interface has no runtime class name of its own */
+    return E_ILLEGAL_METHOD_CALL;
 }
 
 static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
 {
-    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
-    return E_NOTIMPL;
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
 }
 
 static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
@@ -169,20 +177,29 @@ static ULONG WINAPI authenticator_Release( IOnlineIdSystemAuthenticatorForUser *
 
 static HRESULT WINAPI authenticator_GetIids( IOnlineIdSystemAuthenticatorForUser *iface, ULONG *iid_count, IID **iids )
