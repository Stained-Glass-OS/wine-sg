+/* IInspectable::GetIids: a CoTaskMemAlloc'd copy of the interfaces an object implements
+ * besides IUnknown and IInspectable */
+static inline HRESULT inspectable_iids( const IID *const *list, ULONG count, ULONG *iid_count, IID **iids )
+{
+    ULONG i;
+
+    if (!iid_count || !iids) return E_POINTER;
+#ifdef SG_MUTANT_NO_IIDS
+    return E_NOTIMPL;
+#endif
+    if (!(*iids = CoTaskMemAlloc( count * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++) (*iids)[i] = *list[i];
+    *iid_count = count;
+    return S_OK;
+}
+
 HRESULT ticket_request_create( HSTRING service, HSTRING policy, IOnlineIdServiceTicketRequest **out );
 HRESULT ticket_failed_operation( OnlineIdSystemTicketStatus status, HRESULT error,
                                  IAsyncOperation_OnlineIdSystemTicketResult **out );
