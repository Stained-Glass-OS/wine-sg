+    HRESULT ret;
+
+    TRACE("iface %p, name %s, guid %s.\n", iface, debugstr_a(name), debugstr_guid(guid));
+
+    if (!name && !guid)
+        return D3DXFERR_BADVALUE;
+    if ((ret = IDirectXFileData_AddDataReference(data->dxdata, name, guid)) != DXFILE_OK)
