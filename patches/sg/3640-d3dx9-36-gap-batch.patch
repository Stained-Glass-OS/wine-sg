+    if (!template_guid)
+        return E_POINTER;
+    if (data_size && !data)
+        return D3DXFERR_BADVALUE;
+    ret = IDirectXFileSaveObject_CreateDataObject(save->dxsave, template_guid, name, guid, data_size,
+            (void *)data, out);
+    if (ret != DXFILE_OK)
+        return error_dxfile_to_d3dxfile(ret);
+    return S_OK;
+}
