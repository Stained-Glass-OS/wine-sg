+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+
+    for (f = 0; f < nf; ++f)
+    {
+        DWORD set[64], nset = 0, c;
+
+        if (idx[f * 3] >= nv || idx[f * 3 + 1] >= nv || idx[f * 3 + 2] >= nv)
+        {
+            hr = D3DERR_INVALIDCALL;
+            goto done;
+        }
+        for (i = 0; i < 3; ++i)
+            for (j = 0; j < ninfl[idx[f * 3 + i]]; ++j)
