+
+static void test_sg_gap3_mesh(void)
+{
+    static const D3DVERTEXELEMENT9 decl[] =
+    {
+        {0, 0, D3DDECLTYPE_FLOAT3, D3DDECLMETHOD_DEFAULT, D3DDECLUSAGE_POSITION, 0},
+        {0, 12, D3DDECLTYPE_FLOAT3, D3DDECLMETHOD_DEFAULT, D3DDECLUSAGE_NORMAL, 0},
+        D3DDECL_END()
+    };
+    struct vertex { D3DXVECTOR3 p, n; } vertices[25];
+    DWORD indices[4 * 4 * 6], attrs[32], adjacency[32 * 3], face_remap[32], vertex_remap[25], i, j, count;
+    struct test_context *test_context;
+    ID3DXMesh *mesh = NULL, *out;
+    ID3DXBuffer *buffer;
+    IDirect3DIndexBuffer9 *ib;
+    BOOL seen[32] = {0};
+    HRESULT hr;
+
+    /* a 4x4 grid of quads cut into 32 triangles */
+    for (i = 0; i < 25; ++i)
+    {
+        vertices[i].p.x = i % 5; vertices[i].p.y = i / 5; vertices[i].p.z = 0.0f;
+        vertices[i].n.x = 0.0f; vertices[i].n.y = 0.0f; vertices[i].n.z = 1.0f;
+    }
+    for (i = 0; i < 16; ++i)
+    {
+        DWORD a = (i / 4) * 5 + i % 4;
+
+        indices[i * 6 + 0] = a; indices[i * 6 + 1] = a + 1; indices[i * 6 + 2] = a + 6;
+        indices[i * 6 + 3] = a; indices[i * 6 + 4] = a + 6; indices[i * 6 + 5] = a + 5;
+    }
+    for (i = 0; i < 32; ++i)
+        attrs[i] = 0;
+
+    /* the face order is a permutation, the vertex order is by first use */
+    hr = D3DXOptimizeFaces(indices, 32, 25, TRUE, face_remap);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    for (i = 0; i < 32; ++i)
+    {
+        ok(face_remap[i] < 32 && !seen[face_remap[i]], "Face %lu is used twice or out of range.\n", face_remap[i]);
+        seen[face_remap[i] % 32] = TRUE;
+    }
+    /* consecutive faces share vertices (the order follows the surface), the plain order does not need to */
+    count = 0;
+    for (i = 1; i < 32; ++i)
+    {
+        const DWORD *a = &indices[face_remap[i - 1] * 3], *b = &indices[face_remap[i] * 3];
+        BOOL shared = FALSE;
+
+        for (j = 0; j < 9; ++j)
+            shared |= a[j / 3] == b[j % 3];
+        count += shared;
+    }
+    ok(count >= 26, "Only %lu of 31 neighbours share a vertex.\n", count);
+    hr = D3DXOptimizeVertices(indices, 32, 25, TRUE, vertex_remap);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    ok(vertex_remap[0] == indices[0], "Got first vertex %lu.\n", vertex_remap[0]);
+
+    test_context = new_test_context();
+    if (!test_context)
+    {
+        skip("Couldn't create a test context.\n");
+        return;
+    }
+    hr = init_test_mesh(32, 25, D3DXMESH_32BIT | D3DXMESH_SYSTEMMEM, decl, test_context->device, &mesh, vertices,
+            sizeof(*vertices), indices, attrs);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    mesh->lpVtbl->GenerateAdjacency(mesh, 0.0f, adjacency);
+
+    /* OptimizeInplace with the vertex cache flag now reorders the faces and vertices */
+    hr = mesh->lpVtbl->OptimizeInplace(mesh, D3DXMESHOPT_VERTEXCACHE, adjacency, NULL, face_remap, &buffer);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        DWORD *vr = ID3DXBuffer_GetBufferPointer(buffer), *idx;
+
+        mesh->lpVtbl->LockIndexBuffer(mesh, D3DLOCK_READONLY, (void **)&idx);
+        for (i = 0; i < 32; ++i)
+        {
+            BOOL match = TRUE;
+
+            for (j = 0; j < 3; ++j)
+                match &= idx[i * 3 + j] < 25 && vr[idx[i * 3 + j]] == indices[face_remap[i] * 3 + j];
+            ok(match, "Face %lu does not match its remap.\n", i);
+        }
+        mesh->lpVtbl->UnlockIndexBuffer(mesh);
+        ID3DXBuffer_Release(buffer);
+    }
+    hr = mesh->lpVtbl->OptimizeInplace(mesh, D3DXMESHOPT_VERTEXCACHE | D3DXMESHOPT_STRIPREORDER, adjacency, NULL, NULL, NULL);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+    hr = mesh->lpVtbl->OptimizeInplace(mesh, D3DXMESHOPT_STRIPREORDER, adjacency, NULL, NULL, NULL);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+
+    /* a single strip of the faces: more indices than faces plus two, fewer than the list */
+    hr = D3DXConvertMeshSubsetToSingleStrip((ID3DXBaseMesh *)mesh, 0, D3DXMESH_SYSTEMMEM, &ib, &count);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(count >= 34 && count < 96, "Got %lu strip indices.\n", count);
+        IDirect3DIndexBuffer9_Release(ib);
+    }
+    hr = D3DXConvertMeshSubsetToSingleStrip((ID3DXBaseMesh *)mesh, 7, D3DXMESH_SYSTEMMEM, &ib, &count);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+
+    /* N-patches: every face becomes n * n faces, the corners stay where they were */
+    hr = D3DXTessellateNPatches(mesh, adjacency, 2.0f, FALSE, &out, &buffer);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(out->lpVtbl->GetNumFaces(out) == 32 * 4, "Got %lu faces.\n", out->lpVtbl->GetNumFaces(out));
+        ok(out->lpVtbl->GetNumVertices(out) == 32 * 6, "Got %lu vertices.\n", out->lpVtbl->GetNumVertices(out));
+        ok(ID3DXBuffer_GetBufferSize(buffer) == 32 * 4 * 3 * sizeof(DWORD), "Got size %lu.\n",
+                ID3DXBuffer_GetBufferSize(buffer));
+        out->lpVtbl->Release(out);
+        ID3DXBuffer_Release(buffer);
+    }
+    hr = D3DXTessellateNPatches(mesh, adjacency, 0.5f, FALSE, &out, NULL);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+
+    /* clean: a vertex shared by two separate fans (a bowtie) is split */
+    mesh->lpVtbl->Release(mesh);
+    {
+        struct vertex bow[5];
+        DWORD bidx[6] = {0, 1, 2, 2, 3, 4};
+
+        for (i = 0; i < 5; ++i)
+        {
+            bow[i].p.x = i; bow[i].p.y = i * i; bow[i].p.z = 0.0f;
+            bow[i].n = vertices[0].n;
+        }
+        hr = init_test_mesh(2, 5, D3DXMESH_SYSTEMMEM, decl, test_context->device, &mesh, bow, sizeof(*bow), NULL, NULL);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        {
+            WORD *w;
+
+            mesh->lpVtbl->LockIndexBuffer(mesh, 0, (void **)&w);
+            for (i = 0; i < 6; ++i)
+                w[i] = bidx[i];
+            mesh->lpVtbl->UnlockIndexBuffer(mesh);
+        }
+        {
+            DWORD adj[6] = {~0u, ~0u, ~0u, ~0u, ~0u, ~0u}, out_adj[6];
+
+            hr = D3DXCleanMesh(D3DXCLEAN_BOWTIES, mesh, adj, &out, out_adj, NULL);
+            ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                ok(out->lpVtbl->GetNumVertices(out) == 6, "Got %lu vertices.\n", out->lpVtbl->GetNumVertices(out));
+                out->lpVtbl->Release(out);
+            }
+            /* a mesh that needs no cleaning comes back as it is */
+            mesh->lpVtbl->Release(mesh);
+            hr = init_test_mesh(2, 5, D3DXMESH_SYSTEMMEM, decl, test_context->device, &mesh, bow, sizeof(*bow), NULL, NULL);
+            hr = D3DXCleanMesh(D3DXCLEAN_BACKFACING, mesh, adj, &out, out_adj, NULL);
+            ok(hr == D3D_OK && out == mesh, "Got hr %#lx, mesh %p.\n", hr, out);
+            if (SUCCEEDED(hr))
+                out->lpVtbl->Release(out);
+            hr = D3DXCleanMesh(0, mesh, adj, &out, out_adj, NULL);
+            ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+        }
+    }
+    mesh->lpVtbl->Release(mesh);
+
+    /* blended meshes: bone 0 owns the left columns of the grid, bone 1 the right ones; the faces that
+     * touch both need both */
+    {
+        ID3DXSkinInfo *skin;
+        ID3DXBuffer *vremap, *table_buf;
+        DWORD max_infl, combos, left[15], right[10], nl = 0, nr = 0, total = 0, out_adj[96];
+        float lw[15], rw[10];
+        D3DXBONECOMBINATION *table;
+        D3DVERTEXELEMENT9 out_decl[MAX_FVF_DECL_SIZE];
+
+        hr = init_test_mesh(32, 25, D3DXMESH_32BIT | D3DXMESH_SYSTEMMEM, decl, test_context->device, &mesh, vertices,
+                sizeof(*vertices), indices, attrs);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        hr = D3DXCreateSkinInfo(25, decl, 2, &skin);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        for (i = 0; i < 25; ++i)
+        {
+            if (i % 5 < 3) { left[nl] = i; lw[nl++] = 1.0f; }
+            else { right[nr] = i; rw[nr++] = 1.0f; }
+        }
+        skin->lpVtbl->SetBoneInfluence(skin, 0, nl, left, lw);
+        skin->lpVtbl->SetBoneInfluence(skin, 1, nr, right, rw);
+        mesh->lpVtbl->GenerateAdjacency(mesh, 0.0f, adjacency);
+
+        hr = skin->lpVtbl->ConvertToBlendedMesh(skin, mesh, 0, adjacency, out_adj, face_remap, &vremap, &max_infl,
+                &combos, &table_buf, &out);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            ok(max_infl == 2, "Got %lu influences.\n", max_infl);
+            ok(combos == 3, "Got %lu combinations.\n", combos);
+            table = ID3DXBuffer_GetBufferPointer(table_buf);
+            for (i = 0; i < combos; ++i)
+            {
+                total += table[i].FaceCount;
+                ok(table[i].FaceStart + table[i].FaceCount <= 32, "Bad face range %lu.\n", i);
+                ok(table[i].BoneId[0] < 2 || table[i].BoneId[0] == ~0u, "Bad bone %lu.\n", table[i].BoneId[0]);
+            }
+            ok(total == 32, "The combinations hold %lu faces.\n", total);
+            out->lpVtbl->GetDeclaration(out, out_decl);
+            ok(out_decl[1].Usage == D3DDECLUSAGE_BLENDWEIGHT && out_decl[1].Type == D3DDECLTYPE_FLOAT1,
+                    "Got blend weights %u %u.\n", out_decl[1].Usage, out_decl[1].Type);
+            ok(out->lpVtbl->GetNumVertices(out) >= 25, "Got %lu vertices.\n", out->lpVtbl->GetNumVertices(out));
+            ID3DXBuffer_Release(table_buf);
+            ID3DXBuffer_Release(vremap);
+            out->lpVtbl->Release(out);
+        }
+        hr = skin->lpVtbl->ConvertToIndexedBlendedMesh(skin, mesh, 0, 4, adjacency, out_adj, face_remap, &vremap,
+                &max_infl, &combos, &table_buf, &out);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            ok(combos == 1, "Got %lu combinations with a palette of 4.\n", combos);
+            out->lpVtbl->GetDeclaration(out, out_decl);
+            ok(out_decl[1].Usage == D3DDECLUSAGE_BLENDINDICES && out_decl[1].Type == D3DDECLTYPE_UBYTE4,
+                    "Got blend indices %u %u.\n", out_decl[1].Usage, out_decl[1].Type);
+            ID3DXBuffer_Release(table_buf);
+            ID3DXBuffer_Release(vremap);
+            out->lpVtbl->Release(out);
+        }
+        skin->lpVtbl->Release(skin);
+        mesh->lpVtbl->Release(mesh);
+    }
+    free_test_context(test_context);
+}
