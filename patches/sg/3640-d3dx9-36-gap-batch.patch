+static HRESULT WINAPI d3dx9_file_save_data_AddDataObject(ID3DXFileSaveData *iface, REFGUID template_guid,
+        const char *name, const GUID *guid, SIZE_T data_size, const void *data, ID3DXFileSaveData **obj)
+{
+    struct d3dx9_file_save_data *parent = impl_from_ID3DXFileSaveData(iface);
+    IDirectXFileData *child;
+    HRESULT ret;
+
+    TRACE("iface %p, template_guid %s, name %s, guid %s, data_size %Iu, data %p, obj %p.\n", iface,
+            debugstr_guid(template_guid), debugstr_a(name), debugstr_guid(guid), data_size, data, obj);
+
+    if (obj)
+        *obj = NULL;
+    if (FAILED(ret = d3dx9_file_save_make_object(parent->save, template_guid, name, guid, data_size, data,
+            &child)))
+        return ret;
+    if ((ret = IDirectXFileData_AddDataObject(parent->dxdata, child)) != DXFILE_OK)
+    {
+        IDirectXFileData_Release(child);
+        return error_dxfile_to_d3dxfile(ret);
+    }
+    if (obj)
+        ret = d3dx9_file_save_data_create(parent->save, child, obj);
+    else
+        ret = S_OK;
+    IDirectXFileData_Release(child);
+    return ret;
+}
