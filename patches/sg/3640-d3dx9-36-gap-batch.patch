+static void test_sg_gap3_save(void)
+{
+    static const GUID header_guid = {0x3D82AB43, 0x62DA, 0x11CF, {0xAB, 0x39, 0x00, 0x20, 0xAF, 0x71, 0xE4, 0x33}};
+    static const WORD data[] = {1, 2, 3, 0, 0, 0};
+    ID3DXFileEnumObject *enum_object, *enum2;
+    ID3DXFileSaveObject *save, *save2;
+    ID3DXFileSaveData *save_data;
+    ID3DXFileData *file_data;
+    ID3DXFile *file, *file2;
+    char path[MAX_PATH], tmp[MAX_PATH];
+    D3DXF_FILELOADMEMORY memory;
+    SIZE_T count;
+    HRESULT hr;
+    char *buffer;
+    DWORD size, read;
+    HANDLE handle;
+
+    GetTempPathA(sizeof(tmp), tmp);
+    snprintf(path, sizeof(path), "%ssg_gap3_xfile.x", tmp);
+
+    hr = D3DXFileCreate(&file);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = file->lpVtbl->RegisterTemplates(file, templates, sizeof(templates) - 1);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    hr = file->lpVtbl->CreateSaveObject(file, path, D3DXF_FILESAVE_TOFILE, D3DXF_FILEFORMAT_TEXT, &save);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = save->lpVtbl->GetFile(save, &file2);
+    ok(hr == S_OK && file2 == file, "Got hr %#lx.\n", hr);
+    file2->lpVtbl->Release(file2);
+    hr = save->lpVtbl->AddDataObject(save, &header_guid, "Saved", NULL, sizeof(data), data, &save_data);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = save_data->lpVtbl->GetSave(save_data, &save2);
+    ok(hr == S_OK && save2 == save, "Got hr %#lx.\n", hr);
+    save2->lpVtbl->Release(save2);
+    count = 16;
+    hr = save_data->lpVtbl->GetName(save_data, tmp, &count);
+    ok(hr == S_OK && !strcmp(tmp, "Saved"), "Got hr %#lx, name %s.\n", hr, tmp);
+    save_data->lpVtbl->Release(save_data);
+    hr = save->lpVtbl->AddDataObject(save, NULL, "Bad", NULL, 0, NULL, NULL);
+    ok(hr == E_POINTER, "Got hr %#lx.\n", hr);
+    hr = save->lpVtbl->Save(save);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    save->lpVtbl->Release(save);
+
+    handle = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    ok(handle != INVALID_HANDLE_VALUE, "Cannot open the saved file.\n");
+    size = GetFileSize(handle, NULL);
+    buffer = calloc(1, size + 1);
+    ReadFile(handle, buffer, size, &read, NULL);
+    CloseHandle(handle);
+    ok(!strncmp(buffer, "xof 0303txt 0032", 16) && strstr(buffer, "Saved"), "Unexpected file:\n%s\n", buffer);
+    free(buffer);
+
+    /* load it again: the data object knows the enumeration it is in */
+    memory.lpMemory = NULL;
+    hr = file->lpVtbl->CreateEnumObject(file, path, D3DXF_FILELOAD_FROMFILE, &enum_object);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = enum_object->lpVtbl->GetChild(enum_object, 0, &file_data);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = file_data->lpVtbl->GetEnum(file_data, &enum2);
+    ok(hr == S_OK && enum2 == enum_object, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+        enum2->lpVtbl->Release(enum2);
+    enum_object->lpVtbl->Release(enum_object);
+    hr = file_data->lpVtbl->GetEnum(file_data, &enum2);
+    ok(hr == D3DXFERR_NOTFOUND, "Got hr %#lx.\n", hr);
+    file_data->lpVtbl->Release(file_data);
+
+    /* templates of an enumeration go to another file object */
+    hr = D3DXFileCreate(&file2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = file->lpVtbl->CreateEnumObject(file, path, D3DXF_FILELOAD_FROMFILE, &enum_object);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = file2->lpVtbl->RegisterEnumTemplates(file2, enum_object);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    enum_object->lpVtbl->Release(enum_object);
+    memory.lpMemory = objects;
+    memory.dSize = sizeof(objects) - 1;
+    hr = file2->lpVtbl->CreateEnumObject(file2, &memory, D3DXF_FILELOAD_FROMMEMORY, &enum_object);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = enum_object->lpVtbl->GetChildren(enum_object, &count);
+    ok(hr == S_OK && count == 1, "Got hr %#lx, %Iu children.\n", hr, count);
+    enum_object->lpVtbl->Release(enum_object);
+    file2->lpVtbl->Release(file2);
+
+    hr = file->lpVtbl->CreateEnumObject(file, NULL, 0x55, &enum_object);
+    ok(hr == D3DXFERR_BADVALUE, "Got hr %#lx.\n", hr);
+    DeleteFileA(path);
+    file->lpVtbl->Release(file);
+}
+
 START_TEST(xfile)
 {
     test_templates();
     test_lock_unlock();
     test_getname();
     test_type_index_color();
+    test_sg_gap3_save();
 }
