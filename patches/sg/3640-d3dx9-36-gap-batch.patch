+    ULONG refcount = InterlockedDecrement(&data->ref);
+
+    TRACE("%p decreasing refcount to %lu.\n", data, refcount);
+
+    if (!refcount)
+    {
+        IDirectXFileData_Release(data->dxdata);
+        data->save->ID3DXFileSaveObject_iface.lpVtbl->Release(&data->save->ID3DXFileSaveObject_iface);
+        free(data);
+    }
+    return refcount;
