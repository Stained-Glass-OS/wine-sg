+static ULONG WINAPI d3dx9_file_save_data_AddRef(ID3DXFileSaveData *iface)
+{
+    struct d3dx9_file_save_data *data = impl_from_ID3DXFileSaveData(iface);
+    ULONG refcount = InterlockedIncrement(&data->ref);
+
+    TRACE("%p increasing refcount to %lu.\n", data, refcount);
