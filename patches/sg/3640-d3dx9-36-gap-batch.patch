+/* An effect object without techniques that serves the parameter methods for a store somebody else owns (the
+ * constants of a texture shader).  The store must outlive the object. */
+HRESULT d3dx_effect_create_for_store(const struct d3dx_parameters_store *store, ULONG64 *version_counter,
+        ID3DXEffect **out)
+{
+    struct d3dx_effect *effect;
+
+    if (!(effect = calloc(1, sizeof(*effect))))
+        return E_OUTOFMEMORY;
+    effect->ID3DXEffect_iface.lpVtbl = &ID3DXEffect_Vtbl;
+    effect->ref = 1;
+    list_init(&effect->parameter_block_list);
+    effect->params = *store;
+    effect->borrowed_params = TRUE;
+    effect->shared_version_counter = version_counter;
+    *out = &effect->ID3DXEffect_iface;
+    return D3D_OK;
+}
+
+/* ---- the parameters of a texture shader: one for every constant of its constant table ---- */
+
+static unsigned int ctab_param_bytes(const struct ctab_constant *c)
+{
+    unsigned int bytes = 0, i;
+
+    if (c->desc.Elements > 1)
+        return c->desc.Elements * ctab_param_bytes(&c->constants[0]);
+    if (c->desc.Class == D3DXPC_STRUCT)
+    {
+        for (i = 0; i < c->desc.StructMembers; ++i)
+            bytes += ctab_param_bytes(&c->constants[i]);
+        return bytes;
+    }
+    return max(c->desc.Rows, 1) * max(c->desc.Columns, 1) * sizeof(DWORD);
+}
+
+static void ctab_param_default(struct d3dx_parameter *param, const struct ctab_constant *c)
+{
+    unsigned int rows = max(c->desc.Rows, 1), cols = max(c->desc.Columns, 1), r, k;
+    const DWORD *src = c->desc.DefaultValue;
+    DWORD *dst = param->data;
+
+    if (!src)
+        return;
+    /* the default is the registers as they are laid out: one row (or column) per register of 4 */
+    for (r = 0; r < c->desc.RegisterCount; ++r)
+    {
+        if (c->desc.Class == D3DXPC_MATRIX_COLUMNS)
+        {
+            for (k = 0; k < rows && k < 4; ++k)
+                if (k * cols + r < rows * cols)
+                    dst[k * cols + r] = src[r * 4 + k];
+        }
+        else
+        {
+            for (k = 0; k < cols && k < 4; ++k)
+                if (r * cols + k < rows * cols)
+                    dst[r * cols + k] = src[r * 4 + k];
+        }
+    }
+}
+
+static HRESULT ctab_build_param(struct d3dx_parameter *param, struct d3dx_top_level_parameter *top,
+        const struct ctab_constant *c, const char *name, BYTE **data)
+{
+    unsigned int i;
+    HRESULT hr;
+
+    memcpy(param->magic_string, parameter_magic_string, sizeof(param->magic_string));
+    param->top_level_param = top;
+    if (!(param->name = strdup(name)))
+        return E_OUTOFMEMORY;
+    param->class = c->desc.Class;
+    param->type = c->desc.Type;
+    param->rows = c->desc.Rows;
+    param->columns = c->desc.Columns;
+    param->bytes = ctab_param_bytes(c);
+    param->data = *data;
+
+    if (c->desc.Elements > 1)
+    {
+        param->element_count = c->desc.Elements;
+        if (!(param->members = calloc(param->element_count, sizeof(*param->members))))
+            return E_OUTOFMEMORY;
+        for (i = 0; i < param->element_count; ++i)
+            if (FAILED(hr = ctab_build_param(&param->members[i], top, &c->constants[i], name, data)))
+                return hr;
+        return D3D_OK;
+    }
+    if (c->desc.Class == D3DXPC_STRUCT)
+    {
+        param->member_count = c->desc.StructMembers;
+        if (!(param->members = calloc(param->member_count, sizeof(*param->members))))
+            return E_OUTOFMEMORY;
+        for (i = 0; i < param->member_count; ++i)
+            if (FAILED(hr = ctab_build_param(&param->members[i], top, &c->constants[i],
+                    c->constants[i].desc.Name, data)))
+                return hr;
+        return D3D_OK;
+    }
+    ctab_param_default(param, c);
+    *data += param->bytes;
+    return D3D_OK;
+}
+
+HRESULT d3dx_parameters_store_from_ctab(struct d3dx_parameters_store *store, const struct ctab_constant *constants,
+        unsigned int count, ULONG64 *version_counter)
+{
+    unsigned int i;
+    HRESULT hr;
+
+    if (FAILED(hr = d3dx_init_parameters_store(store, count)))
+        return hr;
+    for (i = 0; i < count; ++i)
+    {
+        struct d3dx_top_level_parameter *top = &store->parameters[i];
+        BYTE *data, *cursor;
+
+        if (!(data = calloc(1, max(ctab_param_bytes(&constants[i]), 1))))
+            return E_OUTOFMEMORY;
+        cursor = data;
+        top->version_counter = version_counter;
+        if (FAILED(hr = ctab_build_param(&top->param, top, &constants[i], constants[i].desc.Name, &cursor)))
+        {
+            free(data);
+            return hr;
+        }
+        top->param.data = data;
+    }
+    for (i = 0; i < count; ++i)
+        add_param_to_tree(store, &store->parameters[i].param, NULL, 0, 0);
+    return D3D_OK;
+}
