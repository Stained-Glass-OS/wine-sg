+    if (FAILED(hr = mesh_in->lpVtbl->LockIndexBuffer(mesh_in, D3DLOCK_READONLY, &ib)))
+        goto done;
+    for (i = 0; i < nf * 3; ++i)
+        idx[i] = is32 ? ((DWORD *)ib)[i] : ((WORD *)ib)[i];
+    mesh_in->lpVtbl->UnlockIndexBuffer(mesh_in);
+    {
+        DWORD *ab;
+
+        if (FAILED(hr = mesh_in->lpVtbl->LockAttributeBuffer(mesh_in, D3DLOCK_READONLY, &ab)))
+            goto done;
+        memcpy(attrs, ab, nf * sizeof(*attrs));
+        mesh_in->lpVtbl->UnlockAttributeBuffer(mesh_in);
+    }
