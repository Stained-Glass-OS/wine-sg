+/* The templates of source this file does not know (by class id) are added; the indices of members that
+ * name another template are translated. */
+static HRESULT WINAPI SGTemplates_CopyTemplatesFrom(SGDirectXFileTemplates *iface, SGDirectXFileTemplates *source)
+{
+    IDirectXFileImpl *dst = impl_from_SGTemplates(iface), *src;
+    ULONG map[MAX_TEMPLATES], i, j, k;
+    BOOL added[MAX_TEMPLATES] = {FALSE};
+
+    if (!source || source->lpVtbl != &SGDirectXFileTemplates_Vtbl)
+        return DXFILEERR_BADVALUE;
+    src = impl_from_SGTemplates(source);
+    if (src == dst)
+        return DXFILE_OK;
+
+    map[0] = 0;
+    for (i = 1; i < src->nb_xtemplates; ++i)
+    {
+        for (j = 1; j < dst->nb_xtemplates; ++j)
+            if (IsEqualGUID(&dst->xtemplates[j].class_id, &src->xtemplates[i].class_id))
+                break;
+        if (j == dst->nb_xtemplates)
+        {
+            if (dst->nb_xtemplates >= MAX_TEMPLATES)
+                return DXFILEERR_BADALLOC;
+            dst->xtemplates[dst->nb_xtemplates++] = src->xtemplates[i];
+            added[i] = TRUE;
+        }
+        map[i] = j;
+    }
+    for (i = 1; i < src->nb_xtemplates; ++i)
+    {
+        xtemplate *t = &dst->xtemplates[map[i]];
+
+        if (!added[i])
+            continue;
+        for (k = 0; k < t->nb_members; ++k)
+            if (t->members[k].type == TOKEN_NAME && t->members[k].idx_template > 0
+                    && (ULONG)t->members[k].idx_template < src->nb_xtemplates)
+                t->members[k].idx_template = map[t->members[k].idx_template];
+    }
+    return DXFILE_OK;
+}
