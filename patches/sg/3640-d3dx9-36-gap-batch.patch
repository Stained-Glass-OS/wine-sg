+
+/* ---- face and vertex reordering (D3DXOptimizeFaces, D3DXOptimizeVertices, D3DXMESHOPT_VERTEXCACHE and
+ * D3DXMESHOPT_STRIPREORDER).  The face order is a greedy walk that keeps recently used vertices in a
+ * 32 entry cache (a linear-speed scoring of cache position and remaining valence); it starts at the last
+ * face, which makes a plain strip come out reversed like it does on Windows (the Wine tests record that). ---- */
+
+#define OPT_CACHE_SIZE 32
+
+struct opt_mesh
+{
+    UINT nf, nv;
+    const DWORD *idx;     /* 3 * nf */
+    DWORD *first, *list;  /* faces per vertex, CSR */
+    DWORD *live;          /* unemitted faces per vertex */
+    BYTE *done;
+};
+
+static HRESULT opt_mesh_init(struct opt_mesh *m, const DWORD *idx, UINT nf, UINT nv)
+{
+    UINT i;
+
+    memset(m, 0, sizeof(*m));
+    m->nf = nf;
+    m->nv = nv;
+    m->idx = idx;
+    m->first = calloc(nv + 1, sizeof(*m->first));
+    m->live = calloc(nv + 1, sizeof(*m->live));
+    m->list = malloc((nf * 3 + 1) * sizeof(*m->list));
+    m->done = calloc(nf + 1, 1);
+    if (!m->first || !m->live || !m->list || !m->done)
+        return E_OUTOFMEMORY;
+    for (i = 0; i < nf * 3; ++i)
+        if (idx[i] < nv)
+            ++m->first[idx[i] + 1];
+    for (i = 0; i < nv; ++i)
+        m->first[i + 1] += m->first[i];
+    for (i = 0; i < nf * 3; ++i)
+    {
+        DWORD v = idx[i];
+
+        if (v >= nv)
+            continue;
+        m->list[m->first[v] + m->live[v]++] = i / 3;
+    }
+    return S_OK;
+}
+
+static void opt_mesh_free(struct opt_mesh *m)
+{
+    free(m->first);
+    free(m->live);
+    free(m->list);
+    free(m->done);
+}
+
+static float opt_vertex_score(const struct opt_mesh *m, DWORD v, int cache_pos)
+{
+    float score = 0.0f;
+
+    if (!m->live[v])
+        return -1.0f;
+    if (cache_pos >= 0)
+        score = cache_pos < 3 ? 0.75f : powf(1.0f - (cache_pos - 3) / (float)(OPT_CACHE_SIZE - 3), 1.5f);
+    return score + 2.0f * powf(m->live[v], -0.5f);
+}
+
+/* new_to_old[position] = face */
+static HRESULT opt_face_order(const DWORD *idx, UINT nf, UINT nv, DWORD *new_to_old)
+{
+    struct opt_mesh m;
+    DWORD cache[OPT_CACHE_SIZE + 3];
+    UINT ncache = 0, emitted = 0, scan = nf, k, i, j;
+    HRESULT hr;
+
+    if (FAILED(hr = opt_mesh_init(&m, idx, nf, nv)))
+    {
+        opt_mesh_free(&m);
+        return hr;
+    }
+    while (emitted < nf)
+    {
+        DWORD best = ~0u, face;
+        float best_score = -1e30f;
+
+        for (k = 0; k < ncache; ++k)
+        {
+            DWORD v = cache[k];
+
+            for (i = m.first[v]; i < m.first[v] + m.live[v] + 0u; ++i)
+            {
+                float s = 0.0f;
+                DWORD f = m.list[i];
+
+                if (m.done[f])
+                    continue;
+                for (j = 0; j < 3; ++j)
+                {
+                    DWORD fv = idx[f * 3 + j];
+                    int pos = -1;
+                    UINT c;
+
+                    for (c = 0; c < ncache; ++c)
+                        if (cache[c] == fv)
+                        {
+                            pos = c;
+                            break;
+                        }
+                    s += opt_vertex_score(&m, fv, pos);
+                }
+                if (s > best_score || (s == best_score && f > best))
+                {
+                    best_score = s;
+                    best = f;
+                }
+            }
+        }
+        if (best == ~0u)
+        {
+            while (scan && m.done[scan - 1])
+                --scan;
+            best = scan - 1;
+        }
+#ifdef SG_MUTANT_D3DX_OPT
+        if (!m.done[(emitted * 5) % nf]) best = (emitted * 5) % nf;
+#endif
+        face = best;
+        m.done[face] = 1;
+        new_to_old[emitted++] = face;
+        /* the face leaves the vertex lists: compact them so that the first live entries are unemitted faces */
+        for (j = 0; j < 3; ++j)
+        {
+            DWORD v = idx[face * 3 + j], *l = &m.list[m.first[v]];
+            UINT n = m.first[v + 1] - m.first[v], a, b = 0;
+
+            for (a = 0; a < n; ++a)
+                if (!m.done[l[a]])
+                    l[b++] = l[a];
+            m.live[v] = b;
+        }
+        /* move the face's vertices to the front of the cache, the last corner first */
+        for (j = 0; j < 3; ++j)
+        {
+            DWORD v = idx[face * 3 + j];
+            UINT c;
+
+            for (c = 0; c < ncache; ++c)
+                if (cache[c] == v)
+                    break;
+            if (c == ncache)
+            {
+                if (ncache < OPT_CACHE_SIZE)
+                    ++ncache;
+                else
+                    c = ncache - 1;
+            }
+            memmove(&cache[1], &cache[0], c * sizeof(*cache));
+            cache[0] = v;
+        }
+    }
+    opt_mesh_free(&m);
+    return S_OK;
+}
+
+/* Face order that follows edges: from a face, go on to an unused face across one of its edges when there
+ * is one (the walk turns when it can), else start again at the last unused face. */
+static HRESULT opt_strip_order(const DWORD *idx, UINT nf, UINT nv, DWORD *new_to_old)
+{
+    struct opt_mesh m;
+    UINT emitted = 0, scan = nf, i, j;
+    DWORD face = ~0u;
+    HRESULT hr;
+
+    if (FAILED(hr = opt_mesh_init(&m, idx, nf, nv)))
+    {
+        opt_mesh_free(&m);
+        return hr;
+    }
+    while (emitted < nf)
+    {
+        DWORD next = ~0u;
+
+        if (face != ~0u)
+        {
+            /* an unused face sharing an edge with this one (highest index wins) */
+            for (j = 0; j < 3; ++j)
+            {
+                DWORD a = idx[face * 3 + j], b = idx[face * 3 + (j + 1) % 3];
+
+                if (a >= nv || b >= nv)
+                    continue;
+                for (i = m.first[a]; i < m.first[a + 1]; ++i)
+                {
+                    DWORD f = m.list[i], k;
+
+                    if (m.done[f])
+                        continue;
+                    for (k = 0; k < 3; ++k)
+                        if (idx[f * 3 + k] == b)
+                        {
+                            if (next == ~0u || f > next)
+                                next = f;
+                            break;
+                        }
+                }
+            }
+        }
