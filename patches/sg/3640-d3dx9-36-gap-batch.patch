+/* ---- blended meshes.  The vertices of the result carry blend weights (and, for the indexed form, palette
+ * indices) right behind the position, so the layout is the one fixed function vertex blending expects.  The
+ * faces are grouped in combinations of bones; the attribute of a face is the number of its combination, which
+ * is also its place in the bone combination table.  A vertex shared by faces of two combinations is stored
+ * once for each, since its weights are written against the combination's bone slots. ---- */
+
+struct blend_influence
+{
+    DWORD bone;
+    float weight;
+};
+
+struct blend_combo
+{
+    DWORD attr;
+    DWORD *bones;       /* slots, ~0 for an unused slot */
+    DWORD nbones;
+    DWORD *faces;
+    DWORD nfaces, faces_size;
+};
+
+static int __cdecl blend_dword_cmp(const void *a, const void *b)
+{
+    DWORD x = *(const DWORD *)a, y = *(const DWORD *)b;
+
+    return x < y ? -1 : x > y;
+}
+
+static void blend_free_combos(struct blend_combo *combos, DWORD count)
+{
+    DWORD i;
+
+    for (i = 0; i < count; ++i)
+    {
+        free(combos[i].bones);
+        free(combos[i].faces);
+    }
+    free(combos);
+}
+
+static HRESULT blend_add_face(struct blend_combo *combo, DWORD face)
+{
+    if (combo->nfaces == combo->faces_size)
+    {
+        DWORD *n = realloc(combo->faces, (combo->faces_size ? combo->faces_size * 2 : 16) * sizeof(*n));
+
+        if (!n)
+            return E_OUTOFMEMORY;
+        combo->faces = n;
+        combo->faces_size = combo->faces_size ? combo->faces_size * 2 : 16;
+    }
+    combo->faces[combo->nfaces++] = face;
+    return S_OK;
+}
+
+static HRESULT convert_to_blended(struct d3dx9_skin_info *skin, ID3DXMesh *mesh_in, BOOL indexed,
+        DWORD palette_size, const DWORD *adjacency_in, DWORD *adjacency_out, DWORD *face_remap_out,
+        ID3DXBuffer **vertex_remap_out, DWORD *max_influences_out, DWORD *combo_count_out,
+        ID3DXBuffer **table_out, ID3DXMesh **mesh_out)
+{
+    D3DVERTEXELEMENT9 in_decl[MAX_FVF_DECL_SIZE], out_decl[MAX_FVF_DECL_SIZE + 2];
+    DWORD nf, nv, in_options, stride, out_stride, *idx = NULL, *attrs = NULL, i, j, k, e, ncombos = 0;
+    DWORD pos_end = 0, insert_at = 0, nweights = 0, max_infl = 0, nout_vertices = 0;
+    struct blend_influence **infl = NULL;
+    DWORD *ninfl = NULL, *vmap = NULL, *vsrc = NULL, *new_face_to_old = NULL, *old_face_to_new = NULL;
+    struct blend_combo *combos = NULL;
+    D3DXBONECOMBINATION *table;
+    IDirect3DDevice9 *device;
+    ID3DXBuffer *table_buffer = NULL, *vremap_buffer = NULL;
+    ID3DXMesh *out = NULL;
+    BOOL is32;
+    BYTE *vin, *vout;
+    void *ib;
+    HRESULT hr = S_OK;
+    DWORD out_options, nout_faces, f;
+
+    if (!mesh_in || !mesh_out || !max_influences_out || !combo_count_out || !table_out)
+        return D3DERR_INVALIDCALL;
+    if (indexed && !palette_size)
+        return D3DERR_INVALIDCALL;
+    nf = mesh_in->lpVtbl->GetNumFaces(mesh_in);
+    nv = mesh_in->lpVtbl->GetNumVertices(mesh_in);
+    if (nv != skin->num_vertices)
+        return D3DERR_INVALIDCALL;
