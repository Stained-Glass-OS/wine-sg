+/* The constants of a texture shader: what they are (registers, elements, members) is the constant table in
+ * the shader; their values are parameters of the store, which the effect object serves.  A handle names a
+ * constant of the table; for the values it is turned into the name of the parameter. */
+
+/* Name of the parameter of the constant c below the constants list (path so far in prefix). */
+static BOOL ts_find_path(struct ctab_constant *list, unsigned int count, BOOL elements, const char *prefix,
+        const struct ctab_constant *target, char *out, size_t out_size)
+{
+    unsigned int i;
+
+    for (i = 0; i < count; ++i)
+    {
+        struct ctab_constant *c = &list[i];
+        char path[256];
+
+        if (elements)
+            snprintf(path, sizeof(path), "%s[%u]", prefix, i);
+        else if (prefix[0])
+            snprintf(path, sizeof(path), "%s.%s", prefix, c->desc.Name);
+        else
+            snprintf(path, sizeof(path), "%s", c->desc.Name);
+
+        if (c == target)
+        {
+            snprintf(out, out_size, "%s", path);
+            return TRUE;
+        }
+        if (c->constants)
+        {
+            if (c->desc.Elements > 1)
+            {
+                if (ts_find_path(c->constants, c->desc.Elements, TRUE, path, target, out, out_size))
+                    return TRUE;
+            }
+            else if (ts_find_path(c->constants, c->desc.StructMembers, FALSE, path, target, out, out_size))
+                return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static BOOL ts_handle_name(struct d3dx9_texture_shader *shader, D3DXHANDLE handle, char *name, size_t size)
+{
+    struct ID3DXConstantTableImpl *table;
+    struct ctab_constant *c;
+
+    if (!shader->table || !handle)
+        return FALSE;
+    table = CONTAINING_RECORD(shader->table, struct ID3DXConstantTableImpl, ID3DXConstantTable_iface);
+    if (!(c = get_valid_constant(table, handle)))
+        return FALSE;
+    return ts_find_path(table->constants, table->desc.Constants, FALSE, "", c, name, size);
+}
+
+/* The float registers of the constants, 16 bytes each: what the shader would be given. */
+static void ts_fill_registers(struct d3dx9_texture_shader *shader, struct ctab_constant *list,
+        unsigned int count, BOOL elements, const char *prefix, float *regs, unsigned int reg_count)
+{
+    unsigned int i;
+
+    for (i = 0; i < count; ++i)
+    {
+        struct ctab_constant *c = &list[i];
+        char path[256];
+
+        if (elements)
+            snprintf(path, sizeof(path), "%s[%u]", prefix, i);
+        else if (prefix[0])
+            snprintf(path, sizeof(path), "%s.%s", prefix, c->desc.Name);
+        else
+            snprintf(path, sizeof(path), "%s", c->desc.Name);
+
+        if (c->constants)
+        {
+            if (c->desc.Elements > 1)
+                ts_fill_registers(shader, c->constants, c->desc.Elements, TRUE, path, regs, reg_count);
+            else
+                ts_fill_registers(shader, c->constants, c->desc.StructMembers, FALSE, path, regs, reg_count);
+            continue;
+        }
+        if (c->desc.RegisterSet == D3DXRS_FLOAT4 && c->desc.RegisterIndex < reg_count)
+        {
+            float v[16] = {0};
+            unsigned int rows = max(c->desc.Rows, 1), cols = max(c->desc.Columns, 1), r, k;
+
+            if (SUCCEEDED(shader->constants->lpVtbl->GetFloatArray(shader->constants, path, v, 16)))
+            {
+                for (r = 0; r < c->desc.RegisterCount && c->desc.RegisterIndex + r < reg_count; ++r)
+                {
+                    float *reg = regs + (c->desc.RegisterIndex + r) * 4;
+
+                    if (c->desc.Class == D3DXPC_MATRIX_COLUMNS)
+                        for (k = 0; k < rows && k < 4; ++k)
+                            reg[k] = v[k * cols + r];
+                    else
+                        for (k = 0; k < cols && k < 4; ++k)
+                            reg[k] = v[r * cols + k];
+                }
+            }
+        }
+    }
+}
