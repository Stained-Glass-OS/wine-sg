+static HRESULT WINAPI d3dx9_file_save_data_QueryInterface(ID3DXFileSaveData *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_ID3DXFileSaveData) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        iface->lpVtbl->AddRef(iface);
+        *out = iface;
