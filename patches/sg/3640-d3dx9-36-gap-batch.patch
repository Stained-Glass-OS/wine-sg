+/* Strips of the faces in idx (3 per face, nf faces) joined by degenerate triangles; the result keeps the
+ * winding of every face.  Returns the number of indices; out must hold 3 * nf + 4 * nf. */
+static DWORD build_single_strip(const DWORD *idx, DWORD nf, DWORD nv, DWORD *out)
+{
+    BYTE *used = calloc(nf ? nf : 1, 1);
+    DWORD n = 0, i, f, k;
+
+    for (f = nf; f--;)
+    {
+        if (used[f])
+            continue;
+        used[f] = 1;
+        if (n)
+        {
+            /* degenerate triangles to get over: last, first (twice when the parity needs it) */
+            out[n] = out[n - 1];
+            ++n;
+            out[n++] = idx[f * 3];
+            if (!(n & 1))
+                out[n++] = idx[f * 3];
+            /* the real triangle starts at the last copy of the first index, at an even position */
+        }
+        else
+            out[n++] = idx[f * 3];
+        out[n++] = idx[f * 3 + 1];
+        out[n++] = idx[f * 3 + 2];
+
+        for (;;)
+        {
+            BOOL odd = (n - 2) & 1;
+            DWORD found = ~0u, r = 0, e0 = out[n - 2], e1 = out[n - 1];
+
+            if (odd)
+            {
+                DWORD t = e0; e0 = e1; e1 = t;
+            }
+            /* the next triangle is (e0, e1, r) in its own winding */
+            for (i = 0; i < nf && found == ~0u; ++i)
+            {
+                if (used[i])
+                    continue;
+                for (k = 0; k < 3; ++k)
+                {
+                    if (idx[i * 3 + k] == e0 && idx[i * 3 + (k + 1) % 3] == e1)
+                    {
+                        found = i;
+                        r = idx[i * 3 + (k + 2) % 3];
+                        break;
+                    }
+                }
+            }
+            if (found == ~0u)
+                break;
+            used[found] = 1;
+            out[n++] = r;
+        }
+    }
+#ifdef SG_MUTANT_D3DX_STRIP
+    for (n = 0; n < nf * 3; ++n)
+        out[n] = idx[n];
+    n = nf * 3 + 40;
+#endif
+    free(used);
+    (void)nv;
+    return n;
