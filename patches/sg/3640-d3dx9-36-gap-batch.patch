+                            if (combos[c].bones[slot] == infl[ov][k].bone)
+                                break;
+                        bi[k] = slot < combos[c].nbones ? slot : 0;
+                        if (k < nweights)
+                            w[k] = infl[ov][k].weight;
+                    }
+                }
+                memcpy(dst + pos_end, w, nweights * sizeof(float));
+                if (indexed)
+                    memcpy(dst + pos_end + nweights * 4, bi, 4);
+            }
+        }
+    }
+    out->lpVtbl->UnlockVertexBuffer(out);
+    mesh_in->lpVtbl->UnlockVertexBuffer(mesh_in);
+
+    /* faces, attributes (the number of the combination) and the table */
+    if (SUCCEEDED(hr = out->lpVtbl->LockIndexBuffer(out, 0, &ib)))
+    {
+        BOOL out32 = !!(out_options & D3DXMESH_32BIT);
+
+        for (i = 0; i < nf * 3; ++i)
+        {
+            if (out32)
+                ((DWORD *)ib)[i] = idx[i];
+            else
+                ((WORD *)ib)[i] = idx[i];
+        }
+        out->lpVtbl->UnlockIndexBuffer(out);
+    }
+    if (FAILED(hr))
+        goto done;
+    if (FAILED(hr = D3DXCreateBuffer(ncombos * sizeof(*table)
+            + (size_t)ncombos * (indexed ? palette_size : max_infl) * sizeof(DWORD), &table_buffer)))
+        goto done;
+    table = ID3DXBuffer_GetBufferPointer(table_buffer);
+    {
+        DWORD *attr_out, *bone_ids = (DWORD *)(table + ncombos), c, face_pos = 0;
+        D3DXATTRIBUTERANGE *ranges = calloc(ncombos + 1, sizeof(*ranges));
+        DWORD slots = indexed ? palette_size : max_infl;
+
+        if (!ranges)
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+        out->lpVtbl->LockAttributeBuffer(out, 0, &attr_out);
+        for (c = 0; c < ncombos; ++c)
+        {
+            DWORD vstart = combos[c].faces_size, vend = (c + 1 < ncombos) ? combos[c + 1].faces_size : nout_vertices;
+
+            for (i = 0; i < combos[c].nfaces; ++i)
+                attr_out[face_pos + i] = c;
+            table[c].AttribId = combos[c].attr;
+            table[c].FaceStart = face_pos;
+            table[c].FaceCount = combos[c].nfaces;
+            table[c].VertexStart = vstart;
+            table[c].VertexCout = vend - vstart;
+            table[c].BoneId = &bone_ids[c * slots];
+            for (k = 0; k < slots; ++k)
+                table[c].BoneId[k] = k < combos[c].nbones ? combos[c].bones[k] : ~0u;
+            ranges[c].AttribId = c;
+            ranges[c].FaceStart = face_pos;
+            ranges[c].FaceCount = combos[c].nfaces;
+            ranges[c].VertexStart = vstart;
+            ranges[c].VertexCount = vend - vstart;
+            face_pos += combos[c].nfaces;
+        }
+        out->lpVtbl->UnlockAttributeBuffer(out);
+        out->lpVtbl->SetAttributeTable(out, ranges, ncombos);
+        free(ranges);
+    }
+
+    if (face_remap_out)
+        memcpy(face_remap_out, new_face_to_old, nf * sizeof(*face_remap_out));
+    if (adjacency_out && adjacency_in)
+    {
+        for (f = 0; f < nf; ++f)
+            for (j = 0; j < 3; ++j)
+            {
+                DWORD a = adjacency_in[f * 3 + j];
+
+                adjacency_out[old_face_to_new[f] * 3 + j] = (a == ~0u || a >= nf) ? ~0u : old_face_to_new[a];
+            }
+    }
+    if (vertex_remap_out)
+    {
+        if (SUCCEEDED(hr = D3DXCreateBuffer(nout_vertices * sizeof(DWORD), &vremap_buffer)))
+        {
+            memcpy(ID3DXBuffer_GetBufferPointer(vremap_buffer), vsrc, nout_vertices * sizeof(DWORD));
+            *vertex_remap_out = vremap_buffer;
+            vremap_buffer = NULL;
+        }
+        else
+            goto done;
+    }
+    *max_influences_out = max_infl;
+    *combo_count_out = ncombos;
+    *table_out = table_buffer;
+    table_buffer = NULL;
+    *mesh_out = out;
+    out = NULL;
+    hr = D3D_OK;
+
+done:
+    if (out)
+        out->lpVtbl->Release(out);
+    if (table_buffer)
+        ID3DXBuffer_Release(table_buffer);
+    if (infl)
+        for (i = 0; i < nv; ++i)
+            free(infl[i]);
+    free(infl);
+    free(ninfl);
+    free(idx);
+    free(attrs);
+    free(vmap);
+    free(vsrc);
+    free(new_face_to_old);
+    free(old_face_to_new);
+    blend_free_combos(combos, ncombos);
+    return hr;
+}
