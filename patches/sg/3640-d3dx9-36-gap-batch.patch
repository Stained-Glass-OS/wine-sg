+        for (j = 0; j < bone->num_influences; ++j)
+            if (bone->vertices[j] < nv && bone->weights[j] > skin->min_influence)
+                ++ninfl[bone->vertices[j]];
+    }
+    for (i = 0; i < nv; ++i)
+    {
+        if (ninfl[i] && !(infl[i] = malloc(ninfl[i] * sizeof(**infl))))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+        ninfl[i] = 0;
+    }
+    for (i = 0; i < skin->num_bones; ++i)
+    {
+        const struct bone *bone = &skin->bones[i];
+
+        for (j = 0; j < bone->num_influences; ++j)
+        {
+            DWORD v = bone->vertices[j];
+
+            if (v < nv && bone->weights[j] > skin->min_influence)
+            {
