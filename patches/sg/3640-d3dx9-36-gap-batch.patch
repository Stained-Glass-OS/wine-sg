+static HRESULT d3dx9_file_save_data_create(struct d3dx9_file_save_object *save, IDirectXFileData *dxdata,
+        ID3DXFileSaveData **out)
+{
+    struct d3dx9_file_save_data *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    object->ID3DXFileSaveData_iface.lpVtbl = &d3dx9_file_save_data_vtbl;
+    object->ref = 1;
+    object->save = save;
+    save->ID3DXFileSaveObject_iface.lpVtbl->AddRef(&save->ID3DXFileSaveObject_iface);
+    object->dxdata = dxdata;
+    IDirectXFileData_AddRef(dxdata);
+    *out = &object->ID3DXFileSaveData_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI d3dx9_file_save_object_QueryInterface(ID3DXFileSaveObject *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_ID3DXFileSaveObject) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        iface->lpVtbl->AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    WARN("Interface %s not found.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI d3dx9_file_save_object_AddRef(ID3DXFileSaveObject *iface)
+{
+    struct d3dx9_file_save_object *save = impl_from_ID3DXFileSaveObject(iface);
+    ULONG refcount = InterlockedIncrement(&save->ref);
+
+    TRACE("%p increasing refcount to %lu.\n", save, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI d3dx9_file_save_object_Release(ID3DXFileSaveObject *iface)
+{
+    struct d3dx9_file_save_object *save = impl_from_ID3DXFileSaveObject(iface);
+    ULONG refcount = InterlockedDecrement(&save->ref);
+
+    TRACE("%p decreasing refcount to %lu.\n", save, refcount);
+
+    if (!refcount)
+    {
+        unsigned int i;
+
+        for (i = 0; i < save->count; ++i)
+            IDirectXFileData_Release(save->objects[i]);
+        free(save->objects);
+        IDirectXFileSaveObject_Release(save->dxsave);
+        save->file->ID3DXFile_iface.lpVtbl->Release(&save->file->ID3DXFile_iface);
+        free(save);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI d3dx9_file_save_object_GetFile(ID3DXFileSaveObject *iface, ID3DXFile **file)
+{
+    struct d3dx9_file_save_object *save = impl_from_ID3DXFileSaveObject(iface);
+
+    TRACE("iface %p, file %p.\n", iface, file);
+
+    if (!file)
+        return E_POINTER;
+    *file = &save->file->ID3DXFile_iface;
+    (*file)->lpVtbl->AddRef(*file);
+    return S_OK;
+}
+
+static HRESULT WINAPI d3dx9_file_save_object_AddDataObject(ID3DXFileSaveObject *iface, REFGUID template_guid,
+        const char *name, const GUID *guid, SIZE_T data_size, const void *data, ID3DXFileSaveData **obj)
+{
+    struct d3dx9_file_save_object *save = impl_from_ID3DXFileSaveObject(iface);
+    IDirectXFileData *dxdata;
+    HRESULT ret;
+
+    TRACE("iface %p, template_guid %s, name %s, guid %s, data_size %Iu, data %p, obj %p.\n", iface,
+            debugstr_guid(template_guid), debugstr_a(name), debugstr_guid(guid), data_size, data, obj);
+
+    if (obj)
+        *obj = NULL;
+    if (FAILED(ret = d3dx9_file_save_make_object(save, template_guid, name, guid, data_size, data, &dxdata)))
+        return ret;
+    if (save->count == save->size)
+    {
+        IDirectXFileData **n = realloc(save->objects, (save->size ? save->size * 2 : 4) * sizeof(*n));
+
+        if (!n)
+        {
+            IDirectXFileData_Release(dxdata);
+            return E_OUTOFMEMORY;
+        }
+        save->objects = n;
+        save->size = save->size ? save->size * 2 : 4;
+    }
+    if (obj && FAILED(ret = d3dx9_file_save_data_create(save, dxdata, obj)))
+    {
+        IDirectXFileData_Release(dxdata);
+        return ret;
+    }
+    save->objects[save->count++] = dxdata;
+    return S_OK;
+}
+
+/* The objects go to the file now: the children are in place by this time. */
+static HRESULT WINAPI d3dx9_file_save_object_Save(ID3DXFileSaveObject *iface)
+{
+    struct d3dx9_file_save_object *save = impl_from_ID3DXFileSaveObject(iface);
+    unsigned int i;
+    HRESULT ret;
+
+    TRACE("iface %p.\n", iface);
+
+    if (save->saved)
+        return S_OK;
+    for (i = 0; i < save->count; ++i)
+        if ((ret = IDirectXFileSaveObject_SaveData(save->dxsave, save->objects[i])) != DXFILE_OK)
+            return error_dxfile_to_d3dxfile(ret);
+    save->saved = TRUE;
+    return S_OK;
+}
