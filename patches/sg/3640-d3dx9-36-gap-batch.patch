+                combos[ncombos].nbones = nset;
+            }
+            ++ncombos;
+        }
+        if (indexed)
+        {
+            for (i = 0; i < nset; ++i)
+            {
+                for (k = 0; k < combos[c].nbones; ++k)
+                    if (combos[c].bones[k] == set[i])
+                        break;
+                if (k == combos[c].nbones)
