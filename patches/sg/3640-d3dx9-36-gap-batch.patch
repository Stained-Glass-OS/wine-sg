+    /* where the weights go: right behind the position */
+    for (e = 0; in_decl[e].Stream != 0xff; ++e)
+    {
+        if (in_decl[e].Usage == D3DDECLUSAGE_POSITION && !in_decl[e].UsageIndex
+                && in_decl[e].Type == D3DDECLTYPE_FLOAT3)
+        {
+            pos_end = in_decl[e].Offset + 12;
+            insert_at = e + 1;
+            break;
+        }
