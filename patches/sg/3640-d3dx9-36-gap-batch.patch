+                infl[v][ninfl[v]++].weight = bone->weights[j];
+            }
+        }
+    }
+    for (i = 0; i < nv; ++i)
+    {
+        /* strongest first (the order matters for the weights of the indexed form) */
+        for (j = 1; j < ninfl[i]; ++j)
+        {
+            struct blend_influence t = infl[i][j];
+
+            for (k = j; k && infl[i][k - 1].weight < t.weight; --k)
