From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.media: leftover FIXMEs of the caption factory and DllGetClassObject

The member stubs of captions.c were done by patch 1700; what was left:
the factory's QueryInterface logs a FIXME for every unknown IID (now a
WARN, like the other DLLs of the set) and DllGetClassObject logs a FIXME
and leaves its out pointer alone (it now clears it: CLASS_E_CLASSNOTAVAILABLE
with a NULL result). The caption factory is not agile (the conformance
test, from Windows, expects E_NOINTERFACE), so that stays.

---
diff --git a/dlls/windows.media/captions.c b/dlls/windows.media/captions.c
index 74c5307..9a5c1b1 100644
--- a/dlls/windows.media/captions.c
+++ b/dlls/windows.media/captions.c
@@ -44,6 +44,9 @@ static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID
 
     if (IsEqualGUID( iid, &IID_IUnknown ) ||
         IsEqualGUID( iid, &IID_IInspectable ) ||
+#ifdef SG_MUTANT_WM_AGILE
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+#endif
         IsEqualGUID( iid, &IID_IActivationFactory ))
     {
         *out = &impl->IActivationFactory_iface;
@@ -58,7 +61,7 @@ static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID
         return S_OK;
     }
 
-    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
 }
diff --git a/dlls/windows.media/main.c b/dlls/windows.media/main.c
index 7c0ea0e..cc25bf6 100644
--- a/dlls/windows.media/main.c
+++ b/dlls/windows.media/main.c
@@ -26,7 +26,11 @@ WINE_DEFAULT_DEBUG_CHANNEL(media);
 
 HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID riid, void **out)
 {
-    FIXME( "clsid %s, riid %s, out %p stub!\n", debugstr_guid(clsid), debugstr_guid(riid), out );
+    /* There are no COM classes here, only runtime classes. */
+    TRACE( "clsid %s, riid %s, out %p.\n", debugstr_guid(clsid), debugstr_guid(riid), out );
+#ifndef SG_MUTANT_WM_CLASSOBJECT
+    if (out) *out = NULL;
+#endif
     return CLASS_E_CLASSNOTAVAILABLE;
 }
 
