+/* ---- WS_XML_BUFFER_TYPE ---- */
+
+/* Write the buffer into the element that is being written: the attributes and the content of the root element
+ * of the buffer, whose own name is dropped (WS_ELEMENT_TYPE_MAPPING). */
+static HRESULT write_xml_buffer_content( struct writer *writer, WS_XML_BUFFER *buffer )
+{
+    WS_XML_READER *reader = NULL;
+    const WS_XML_NODE *node;
+    const WS_XML_ELEMENT_NODE *elem;
+    ULONG i;
+    int depth = 0;
+    HRESULT hr;
+
+    if ((hr = WsCreateReader( NULL, 0, &reader, NULL )) != S_OK) return hr;
+    if ((hr = WsSetInputToBuffer( reader, buffer, NULL, 0, NULL )) != S_OK) goto done;
+    if ((hr = WsReadToStartElement( reader, NULL, NULL, NULL, NULL )) != S_OK) goto done;
+    if ((hr = WsGetReaderNode( reader, &node, NULL )) != S_OK) goto done;
+    if (node->nodeType != WS_XML_NODE_TYPE_ELEMENT) { hr = WS_E_INVALID_FORMAT; goto done; }
+
+    elem = (const WS_XML_ELEMENT_NODE *)node;
+    for (i = 0; i < elem->attributeCount; i++)
+    {
+        const WS_XML_ATTRIBUTE *attr = elem->attributes[i];
+
+        if ((hr = WsWriteStartAttribute( (WS_XML_WRITER *)writer, attr->prefix, attr->localName, attr->ns,
+                                         attr->singleQuote, NULL )) != S_OK) goto done;
+        if (attr->value && (hr = WsWriteText( (WS_XML_WRITER *)writer, attr->value, NULL )) != S_OK) goto done;
+        if ((hr = WsWriteEndAttribute( (WS_XML_WRITER *)writer, NULL )) != S_OK) goto done;
+    }
+
+    if ((hr = WsReadStartElement( reader, NULL )) != S_OK) goto done;
+    for (;;)
+    {
+        if ((hr = WsGetReaderNode( reader, &node, NULL )) != S_OK) goto done;
+        if (node->nodeType == WS_XML_NODE_TYPE_EOF) { hr = WS_E_INVALID_FORMAT; goto done; }
+        if (node->nodeType == WS_XML_NODE_TYPE_END_ELEMENT && !depth) break;
+        if ((hr = WsWriteNode( (WS_XML_WRITER *)writer, node, NULL )) != S_OK) goto done;
+        if (node->nodeType == WS_XML_NODE_TYPE_ELEMENT) depth++;
+        else if (node->nodeType == WS_XML_NODE_TYPE_END_ELEMENT) depth--;
+        if ((hr = WsReadNode( reader, NULL )) != S_OK) goto done;
+    }
+
+done:
+    WsFreeReader( reader );
+    return hr;
+}
+
+static HRESULT write_type_xml_buffer( struct writer *writer, WS_TYPE_MAPPING mapping, WS_WRITE_OPTION option,
+                                      const void *value, ULONG size )
+{
+    WS_XML_BUFFER *buffer;
+    const void *ptr;
+    HRESULT hr;
+
+    if (!option) return E_INVALIDARG;
+    if ((hr = get_value_ptr( option, value, size, sizeof(WS_XML_BUFFER *), &ptr )) != S_OK) return hr;
+    if (option == WS_WRITE_NILLABLE_POINTER && !ptr) return write_add_nil_attribute( writer );
+    buffer = *(WS_XML_BUFFER * const *)ptr;
+    if (!buffer)
+    {
+        if (option == WS_WRITE_NILLABLE_VALUE || option == WS_WRITE_NILLABLE_POINTER) return write_add_nil_attribute( writer );
+        return E_INVALIDARG;
+    }
+
+    switch (mapping)
+    {
+    case WS_ELEMENT_TYPE_MAPPING:
+        return write_xml_buffer_content( writer, buffer );
+
+    case WS_ANY_ELEMENT_TYPE_MAPPING:
+#ifdef SG_MUTANT_WSX_ANY
+        return write_xml_buffer_content( writer, buffer );
+#endif
+        return WsWriteXmlBuffer( (WS_XML_WRITER *)writer, buffer, NULL );
+
+    default:
+        return WS_E_INVALID_OPERATION;
+    }
+}
+
+/* ---- xsd:duration ---- */
+
+static void duration_fraction( char *buf, ULONG frac )
+{
+    int n = sprintf( buf, "%07lu", frac );
+#ifndef SG_MUTANT_WSD_FRAC
+    while (n && buf[n - 1] == '0') buf[--n] = 0;
+#endif
+}
+
+static HRESULT duration_to_utf8( const WS_DURATION *d, WS_XML_UTF8_TEXT *text, BYTE *buf, ULONG size )
+{
+    char *p = (char *)buf;
+    BOOL zero = !d->years && !d->months && !d->days && !d->hours && !d->minutes && !d->seconds &&
+                !d->milliseconds && !d->ticks;
+
+    if (d->milliseconds > 999 || d->ticks > 9999) return WS_E_INVALID_FORMAT;
+#ifndef SG_MUTANT_WSD_NEG
+    if (d->negative && !zero) *p++ = '-';
+#endif
+    *p++ = 'P';
+    if (d->years) p += sprintf( p, "%luY", d->years );
+    if (d->months) p += sprintf( p, "%luM", d->months );
+    if (d->days) p += sprintf( p, "%luD", d->days );
+    if (d->hours || d->minutes || d->seconds || d->milliseconds || d->ticks || zero)
+    {
+        ULONG frac = d->milliseconds * 10000 + d->ticks;
+
+        *p++ = 'T';
+        if (d->hours) p += sprintf( p, "%luH", d->hours );
+        if (d->minutes) p += sprintf( p, "%luM", d->minutes );
+#ifdef SG_MUTANT_WSD_ZERO
+        if (d->seconds || frac)
+#else
+        if (d->seconds || frac || zero)
+#endif
+        {
+            p += sprintf( p, "%lu", d->seconds );
+            if (frac)
+            {
+                char digits[16];
+                duration_fraction( digits, frac );
+                p += sprintf( p, ".%s", digits );
+            }
+            *p++ = 'S';
+        }
+    }
+    text->text.textType = WS_XML_TEXT_TYPE_UTF8;
+    text->value.bytes   = buf;
+    text->value.length  = p - (char *)buf;
+    text->value.dictionary = NULL;
+    text->value.id = 0;
+    return S_OK;
+}
+
+static HRESULT write_type_duration( struct writer *writer, WS_TYPE_MAPPING mapping,
+                                    const WS_DURATION_DESCRIPTION *desc, WS_WRITE_OPTION option,
+                                    const void *value, ULONG size )
+{
+    WS_XML_UTF8_TEXT text;
+    BYTE buf[128];
+    const WS_DURATION *ptr;
+    HRESULT hr;
+
+    if (!option || option == WS_WRITE_NILLABLE_VALUE) return E_INVALIDARG;
+    if ((hr = get_value_ptr( option, value, size, sizeof(WS_DURATION), (const void **)&ptr )) != S_OK) return hr;
