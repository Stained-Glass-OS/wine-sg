From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:49:06 -0700
Subject: [PATCH] webservices: WS_DURATION_TYPE, WS_CUSTOM_TYPE and
 WS_XML_BUFFER_TYPE (3236)

xsd:duration for WS_DURATION (with the description's range and comparer),
custom types through their read and write callbacks, and XML buffers as
element content or whole elements. The header gains WS_TIMESPAN,
WS_DURATION and WS_CUSTOM_TYPE_DESCRIPTION with their callbacks.

diff --git a/dlls/webservices/reader.c b/dlls/webservices/reader.c
index 1522df7..5a0cd8c 100644
--- a/dlls/webservices/reader.c
+++ b/dlls/webservices/reader.c
@@ -6187,6 +6187,323 @@ static HRESULT read_type_guid( struct reader *reader, WS_TYPE_MAPPING mapping,
     return S_OK;
 }
 
+/* ---- xsd:duration ---- */
+
+/* the sign of a duration folded into months (years and months only) or ticks (the other components) */
+static BOOL duration_only_months( const WS_DURATION *d )
+{
+    return !d->days && !d->hours && !d->minutes && !d->seconds && !d->milliseconds && !d->ticks;
+}
+
+static BOOL duration_no_months( const WS_DURATION *d )
+{
+    return !d->years && !d->months;
+}
+
+/* The default comparison of WS_DURATION_DESCRIPTION: durations that specify years and months only, or no
+ * years and months, can be compared; a mix cannot (1 month and 30 days) */
+HRESULT duration_compare( const WS_DURATION *a, const WS_DURATION *b, int *result )
+{
+    LONGLONG va, vb;
+
+    if (duration_only_months( a ) && duration_only_months( b ))
+    {
+        va = (LONGLONG)a->years * 12 + a->months;
+        vb = (LONGLONG)b->years * 12 + b->months;
+    }
+    else if (duration_no_months( a ) && duration_no_months( b ))
+    {
+        va = ((((LONGLONG)a->days * 24 + a->hours) * 60 + a->minutes) * 60 + a->seconds) * 10000000 +
+             (LONGLONG)a->milliseconds * 10000 + a->ticks;
+        vb = ((((LONGLONG)b->days * 24 + b->hours) * 60 + b->minutes) * 60 + b->seconds) * 10000000 +
+             (LONGLONG)b->milliseconds * 10000 + b->ticks;
+    }
+#ifdef SG_MUTANT_WSD_MIX
+    else { *result = 0; return S_OK; }
+#else
+    else return WS_E_INVALID_FORMAT;
+#endif
+
+#ifndef SG_MUTANT_WSD_SIGN
+    if (a->negative) va = -va;
+    if (b->negative) vb = -vb;
+#endif
+    *result = va < vb ? -1 : va > vb ? 1 : 0;
+    return S_OK;
+}
+
+static HRESULT read_duration_number( const unsigned char **ptr, const unsigned char *end, ULONG *ret )
+{
+    ULONGLONG val = 0;
+    const unsigned char *p = *ptr;
+
+    if (p == end || !isdigit( *p )) return WS_E_INVALID_FORMAT;
+    while (p < end && isdigit( *p ))
+    {
+        val = val * 10 + (*p - '0');
+        if (val > MAX_UINT32) return WS_E_NUMERIC_OVERFLOW;
+        p++;
+    }
+    *ptr = p;
+    *ret = val;
+    return S_OK;
+}
+
+/* [-]P[nY][nM][nD][T[nH][nM][n[.f]S]], at least one component, nothing after the T alone */
+static HRESULT str_to_duration( const unsigned char *str, ULONG len, WS_DURATION *ret )
+{
+    const unsigned char *ptr = str, *end;
+    WS_DURATION d = {0};
+    BOOL time = FALSE, any = FALSE;
+    ULONG num;
+    HRESULT hr;
+
+    memset( ret, 0, sizeof(*ret) );
+    while (len && read_isspace( *ptr )) { ptr++; len--; }
+    while (len && read_isspace( ptr[len - 1] )) { len--; }
+    end = ptr + len;
+    if (ptr < end && *ptr == '-') { d.negative = TRUE; ptr++; }
+    if (ptr == end || *ptr != 'P') return WS_E_INVALID_FORMAT;
+    ptr++;
+
+    while (ptr < end)
+    {
+        if (*ptr == 'T')
+        {
+            if (time) return WS_E_INVALID_FORMAT;
+            time = TRUE;
+            ptr++;
+            if (ptr == end) return WS_E_INVALID_FORMAT;
+            continue;
+        }
+        if ((hr = read_duration_number( &ptr, end, &num )) != S_OK) return hr;
+        if (time && ptr < end && *ptr == '.')
+        {
+            /* fraction of the seconds: 7 digits are kept (milliseconds and ticks) */
+            ULONG frac = 0, digits = 0;
+
+            ptr++;
+            if (ptr == end || !isdigit( *ptr )) return WS_E_INVALID_FORMAT;
+            while (ptr < end && isdigit( *ptr ))
+            {
+                if (digits < 7) { frac = frac * 10 + (*ptr - '0'); digits++; }
+                ptr++;
+            }
+#ifndef SG_MUTANT_WSD_SCALE
+            while (digits++ < 7) frac *= 10;
+#endif
+            if (ptr == end || *ptr != 'S') return WS_E_INVALID_FORMAT;
+            d.seconds = num;
+            d.milliseconds = frac / 10000;
+            d.ticks = frac % 10000;
+            ptr++;
+            any = TRUE;
+            continue;
+        }
+        if (ptr == end) return WS_E_INVALID_FORMAT;
+        switch (*ptr)
+        {
+        case 'Y': if (time || d.years || d.months || d.days) return WS_E_INVALID_FORMAT; d.years = num; break;
+        case 'D': if (time || d.days) return WS_E_INVALID_FORMAT; d.days = num; break;
+#ifdef SG_MUTANT_WSD_NOT
+        case 'H': if (d.hours || d.minutes || d.seconds) return WS_E_INVALID_FORMAT; d.hours = num; break;
+#else
+        case 'H': if (!time || d.hours || d.minutes || d.seconds) return WS_E_INVALID_FORMAT; d.hours = num; break;
+#endif
+        case 'S': if (!time || d.seconds) return WS_E_INVALID_FORMAT; d.seconds = num; break;
+        case 'M':
+            if (time)
+            {
+                if (d.minutes || d.seconds) return WS_E_INVALID_FORMAT;
+                d.minutes = num;
+            }
+            else
+            {
+                if (d.months || d.days) return WS_E_INVALID_FORMAT;
+                d.months = num;
+            }
+            break;
+        default:
+            return WS_E_INVALID_FORMAT;
+        }
+        ptr++;
+        any = TRUE;
+    }
+    if (!any) return WS_E_INVALID_FORMAT;
+    *ret = d;
+    return S_OK;
+}
+
+static HRESULT text_to_duration( const WS_XML_TEXT *text, WS_DURATION *val )
+{
+    HRESULT hr;
+
+    switch (text->textType)
+    {
+    case WS_XML_TEXT_TYPE_UTF8:
+    {
+        const WS_XML_UTF8_TEXT *text_utf8 = (const WS_XML_UTF8_TEXT *)text;
+        return str_to_duration( text_utf8->value.bytes, text_utf8->value.length, val );
+    }
+    default:
+    {
+        WS_XML_UTF8_TEXT *utf8;
+
+        if ((hr = text_to_utf8text( text, NULL, NULL, &utf8 )) != S_OK) return hr;
+        hr = text_to_duration( &utf8->text, val );
+        free( utf8 );
+        return hr;
+    }
+    }
+}
+
+static HRESULT read_type_duration( struct reader *reader, WS_TYPE_MAPPING mapping,
+                                   const WS_XML_STRING *localname, const WS_XML_STRING *ns,
+                                   const WS_DURATION_DESCRIPTION *desc, WS_READ_OPTION option,
+                                   WS_HEAP *heap, void *ret, ULONG size, BOOL *found )
+{
+    const WS_XML_TEXT *text;
+    WS_DURATION val = {0};
+    HRESULT hr;
+
+    if ((hr = get_text( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
+    if (*found && (hr = text_to_duration( text, &val )) != S_OK) return hr;
+    if (*found && desc)
+    {
+        int cmp;
+
+#ifdef SG_MUTANT_WSD_RCMP
+        if ((hr = duration_compare( &val, &desc->minValue, &cmp )) != S_OK) return hr;
+#else
+        if ((hr = desc->comparer ? desc->comparer( &val, &desc->minValue, &cmp, NULL ) :
+                  duration_compare( &val, &desc->minValue, &cmp )) != S_OK) return hr;
+#endif
+        if (cmp < 0) return WS_E_INVALID_FORMAT;
+        if ((hr = desc->comparer ? desc->comparer( &val, &desc->maxValue, &cmp, NULL ) :
+                  duration_compare( &val, &desc->maxValue, &cmp )) != S_OK) return hr;
+#ifndef SG_MUTANT_WSD_RMAX
+        if (cmp > 0) return WS_E_INVALID_FORMAT;
+#endif
+    }
+
+    switch (option)
+    {
+    case WS_READ_REQUIRED_VALUE:
+        if (!*found) return WS_E_INVALID_FORMAT;
+        /* fall through */
+
+    case WS_READ_NILLABLE_VALUE:
+        if (size != sizeof(val)) return E_INVALIDARG;
+        *(WS_DURATION *)ret = val;
+        break;
+
+    case WS_READ_REQUIRED_POINTER:
+        if (!*found) return WS_E_INVALID_FORMAT;
+        /* fall through */
+
+    case WS_READ_OPTIONAL_POINTER:
+    case WS_READ_NILLABLE_POINTER:
+    {
+        WS_DURATION *heap_val = NULL;
+        if (size != sizeof(heap_val)) return E_INVALIDARG;
+        if (*found)
+        {
+            if (!(heap_val = ws_alloc( heap, sizeof(*heap_val) ))) return WS_E_QUOTA_EXCEEDED;
+            *heap_val = val;
+        }
+        *(WS_DURATION **)ret = heap_val;
+        break;
+    }
+    default:
+        WARN( "invalid read option %u\n", option );
+        return E_INVALIDARG;
+    }
+
+    return S_OK;
+}
+
+/* ---- WS_CUSTOM_TYPE: the callbacks read the value ---- */
+static HRESULT read_type_custom( struct reader *reader, WS_TYPE_MAPPING mapping,
+                                 const WS_XML_STRING *localname, const WS_XML_STRING *ns,
+                                 const WS_CUSTOM_TYPE_DESCRIPTION *desc, WS_READ_OPTION option,
+                                 WS_HEAP *heap, void *ret, ULONG size, BOOL *found )
+{
+    HRESULT hr;
+
+    if (!desc || !desc->readCallback || !desc->size) return E_INVALIDARG;
+    *found = TRUE;
+
+    switch (option)
+    {
+    case WS_READ_REQUIRED_VALUE:
+    case WS_READ_NILLABLE_VALUE:
+        if (size != desc->size) return E_INVALIDARG;
+        return desc->readCallback( (WS_XML_READER *)reader, mapping, desc->descriptionData, heap, ret, size, NULL );
+
+    case WS_READ_REQUIRED_POINTER:
+    case WS_READ_OPTIONAL_POINTER:
+    case WS_READ_NILLABLE_POINTER:
+    {
+        void *heap_val;
+
+        if (size != sizeof(heap_val)) return E_INVALIDARG;
+        if (!(heap_val = ws_alloc_zero( heap, desc->size ))) return WS_E_QUOTA_EXCEEDED;
+        if ((hr = desc->readCallback( (WS_XML_READER *)reader, mapping, desc->descriptionData, heap, heap_val,
+                                      desc->size, NULL )) != S_OK)
+        {
+            ws_free( heap, heap_val, desc->size );
+            return hr;
+        }
+        *(void **)ret = heap_val;
+        return S_OK;
+    }
+    default:
+        WARN( "invalid read option %u\n", option );
+        return E_INVALIDARG;
+    }
+}
+
+/* ---- WS_XML_BUFFER_TYPE: the element is read into a new buffer, whose root keeps the element's name ---- */
+static HRESULT WsReadXmlBuffer_impl( WS_XML_READER *, WS_HEAP *, WS_XML_BUFFER **, WS_ERROR * );
+
+static HRESULT read_type_xml_buffer( struct reader *reader, WS_TYPE_MAPPING mapping,
+                                     const WS_XML_STRING *localname, const WS_XML_STRING *ns, WS_READ_OPTION option,
+                                     WS_HEAP *heap, void *ret, ULONG size, BOOL *found )
+{
+    WS_XML_BUFFER *buffer = NULL;
+    HRESULT hr;
+
+    if (mapping != WS_ELEMENT_TYPE_MAPPING && mapping != WS_ANY_ELEMENT_TYPE_MAPPING) return WS_E_INVALID_OPERATION;
+    if (!heap) return E_INVALIDARG;
+    switch (option)
+    {
+    case WS_READ_REQUIRED_VALUE:
+    case WS_READ_NILLABLE_VALUE:
+        if (size != sizeof(buffer)) return E_INVALIDARG;
+        break;
+    case WS_READ_REQUIRED_POINTER:
+    case WS_READ_OPTIONAL_POINTER:
+    case WS_READ_NILLABLE_POINTER:
+        if (size != sizeof(void *)) return E_INVALIDARG;
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+
+    *found = TRUE;
+    if ((hr = WsReadXmlBuffer_impl( (WS_XML_READER *)reader, heap, &buffer, NULL )) != S_OK) return hr;
+    if (option == WS_READ_REQUIRED_VALUE || option == WS_READ_NILLABLE_VALUE)
+        *(WS_XML_BUFFER **)ret = buffer;
+    else
+    {
+        WS_XML_BUFFER **heap_val;
+        if (!(heap_val = ws_alloc( heap, sizeof(*heap_val) ))) return WS_E_QUOTA_EXCEEDED;
+        *heap_val = buffer;
+        *(WS_XML_BUFFER ***)ret = heap_val;
+    }
+    return S_OK;
+}
+
 static HRESULT text_to_unique_id( const WS_XML_TEXT *text, WS_HEAP *heap, WS_UNIQUE_ID *val )
 {
     HRESULT hr;
@@ -6756,6 +7073,21 @@ ULONG get_type_size( WS_TYPE type, const void *desc )
     case WS_DATETIME_TYPE:
         return sizeof(WS_DATETIME);
 
+    case WS_TIMESPAN_TYPE:
+        return sizeof(WS_TIMESPAN);
+
+    case WS_DURATION_TYPE:
+        return sizeof(WS_DURATION);
+
+    case WS_XML_BUFFER_TYPE:
+        return sizeof(WS_XML_BUFFER *);
+
+    case WS_CUSTOM_TYPE:
+    {
+        const WS_CUSTOM_TYPE_DESCRIPTION *desc_custom = desc;
+        return desc_custom->size;
+    }
+
     case WS_GUID_TYPE:
         return sizeof(GUID);
 
@@ -6824,6 +7156,8 @@ static WS_READ_OPTION get_field_read_option( WS_TYPE type, ULONG options )
     case WS_DECIMAL_TYPE:
     case WS_VOID_TYPE:
     case WS_DATETIME_TYPE:
+    case WS_DURATION_TYPE:
+    case WS_CUSTOM_TYPE:
     case WS_GUID_TYPE:
     case WS_UNIQUE_ID_TYPE:
     case WS_STRING_TYPE:
@@ -7592,6 +7926,21 @@ static HRESULT read_type( struct reader *reader, WS_TYPE_MAPPING mapping, WS_TYP
         return end_mapping( reader, mapping );
     }
 
+    /* a custom type reads the nodes of its mapping itself, as WsReadType would */
+#ifdef SG_MUTANT_WSC_END
+    if (type == WS_CUSTOM_TYPE)
+    {
+        hr = read_type_custom( reader, mapping, localname, ns, desc, option, heap, value, size, found );
+        return hr != S_OK ? hr : end_mapping( reader, mapping );
+    }
+#endif
+    if (type == WS_CUSTOM_TYPE)
+        return read_type_custom( reader, mapping, localname, ns, desc, option, heap, value, size, found );
+
+    /* the buffer copy stops at the end element of the copied element */
+    if (type == WS_XML_BUFFER_TYPE)
+        return read_type_xml_buffer( reader, mapping, localname, ns, option, heap, value, size, found );
+
     switch (type)
     {
     case WS_BOOL_TYPE:
@@ -7654,6 +8003,11 @@ static HRESULT read_type( struct reader *reader, WS_TYPE_MAPPING mapping, WS_TYP
         hr = read_type_guid( reader, mapping, localname, ns, desc, option, heap, value, size, found );
         break;
 
+    case WS_DURATION_TYPE:
+        hr = read_type_duration( reader, mapping, localname, ns, desc, option, heap, value, size, found );
+        break;
+
+
     case WS_UNIQUE_ID_TYPE:
         hr = read_type_unique_id( reader, mapping, localname, ns, desc, option, heap, value, size, found );
         break;
