+/* Stained Glass OS: the icon at the size it is drawn (icon_cx), from the
+ * file's own images, not the 32 px one stretched. FALLBACK when there is none. */
+static HICON sized_icon( const WCHAR *file, int index, HICON fallback )
+{
+    HICON icon = NULL;
+    int size = MulDiv( sg_icon_size, GetSystemMetrics( SM_CXICON ), 32 );
+
+    if (file && file[0] && size != GetSystemMetrics( SM_CXICON ) &&
+        PrivateExtractIconsW( file, index, size, size, &icon, NULL, 1, 0 ) == 1 && icon)
+    {
+        if (fallback) DestroyIcon( fallback );
+        return icon;
+    }
+    return fallback;
+}
+
+/* the same for what SHGetFileInfo found: its icon location, at the size */
+static HICON sized_file_icon( const WCHAR *path, UINT flags, HICON fallback )
+{
+    SHFILEINFOW info;
+
+    memset( &info, 0, sizeof(info) );
+    if (!SHGetFileInfoW( path, 0, &info, sizeof(info), flags | SHGFI_ICONLOCATION ) || !info.szDisplayName[0])
+        return fallback;
+    return sized_icon( info.szDisplayName, info.iIcon, fallback );
+}
