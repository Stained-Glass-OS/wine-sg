-static int sg_icon_size = 32;       /* Medium; Large 48, Small 24 */
+/* Windows 10's sizes, at 100%: Small 32, Medium 48 (the default), Large 96.
+ * They were 24/32/48 here: "Medium" looked small beside Windows' own. */
+static int sg_icon_size = 48;
 static BOOL sg_hide_icons;
