+    struct color_convert *impl = impl_from_IMFTransform(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, message %#x, param %p.\n", iface, message, (void *)param);
+
+    switch (message)
+    {
+    case MFT_MESSAGE_COMMAND_DRAIN:
+        return impl->wg_transform ? wg_transform_drain(impl->wg_transform) : MF_E_TRANSFORM_TYPE_NOT_SET;
+
+    case MFT_MESSAGE_COMMAND_FLUSH:
+#ifdef SG_MUTANT_CC_NOFLUSH
+        return S_OK;
+#endif
+        if (!impl->wg_transform)
+            return MF_E_TRANSFORM_TYPE_NOT_SET;
+        if (SUCCEEDED(hr = wg_transform_flush(impl->wg_transform)))
+            wg_sample_queue_flush(impl->wg_sample_queue, true);
+        return hr;
+
+    case MFT_MESSAGE_NOTIFY_BEGIN_STREAMING:
+    case MFT_MESSAGE_NOTIFY_END_STREAMING:
+    case MFT_MESSAGE_NOTIFY_END_OF_STREAM:
+    case MFT_MESSAGE_NOTIFY_START_OF_STREAM:
+        return S_OK;
+
+    default:
+        FIXME("Ignoring message %#x.\n", message);
+        return S_OK;
+    }
