From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 03:39:04 -0700
Subject: [PATCH] cabinet: XPRESS_HUFF through ntdll's codec (3307)

COMPRESS_ALGORITHM_XPRESS_HUFF (LZ77+Huffman, [MS-XCA] 2.3) is handled by
ntdll's RtlCompressBuffer and RtlDecompressBuffer (COMPRESSION_FORMAT_
XPRESS_HUFF), in buffer mode and raw mode, with a chunk that does not get
smaller stored as it is. CreateCompressor/CreateDecompressor still refuse
the algorithm with ERROR_NOT_SUPPORTED when ntdll has no codec for it, so
this applies fully after stubs-6 5105 (ntdll: XPRESS and XPRESS_HUFF).

Test: test/fastcab-gate.sh (the XPRESS_HUFF part runs when ntdll has the
codec: the two LZ77+Huffman examples of the specification decompress,
round trips, a table without codes is refused; mutants SG_MUTANT_HF_*).

diff --git a/dlls/cabinet/compressapi.c b/dlls/cabinet/compressapi.c
index 9ac5e87..2390692 100644
--- a/dlls/cabinet/compressapi.c
+++ b/dlls/cabinet/compressapi.c
@@ -38,7 +38,8 @@
  * at most 32 KiB of output, with the previous 32 KiB of the chunk as its
  * dictionary -- as MSZIP folders in cabinets. COMPRESS_RAW omits the header
  * and chunking: the data is the blocks alone (for XPRESS, one LZ77 stream).
- * XPRESS_HUFF and LZMS are not implemented yet.
+ * An XPRESS_HUFF chunk is the LZ77+Huffman stream of [MS-XCA] 2.3, made by
+ * ntdll's RtlCompressBuffer (when ntdll has it); LZMS is not implemented.
  */
 
 #include <stdarg.h>
@@ -48,6 +49,7 @@
 #include "windef.h"
 #include "winbase.h"
 #include "winerror.h"
+#include "winternl.h"
 #include "compressapi.h"
 #include "zlib.h"
 #include "wine/debug.h"
@@ -90,6 +92,74 @@ static void cmp_zfree( voidpf opaque, voidpf address )
     free( address );
 }
 
+/* ---- XPRESS_HUFF: ntdll's ---------------------------------------------------- */
+
+#ifdef SG_MUTANT_HF_FORMAT
+#define FORMAT_XPRESS_HUFF 3
+#else
+#define FORMAT_XPRESS_HUFF 4
+#endif
+
+static NTSTATUS (WINAPI *p_compress)( USHORT, UCHAR *, ULONG, UCHAR *, ULONG, ULONG, ULONG *, void * );
+static NTSTATUS (WINAPI *p_decompress)( USHORT, UCHAR *, ULONG, UCHAR *, ULONG, ULONG * );
+static NTSTATUS (WINAPI *p_workspace)( USHORT, ULONG *, ULONG * );
+
+static BOOL huff_available(void)
+{
+    static LONG state;   /* 0 unknown, 1 yes, -1 no */
+    UCHAR in[8] = { 'a','b','c','a','b','c','a','b' }, out[512];
+    ULONG final, ws = 0, frag = 0;
+    void *work;
+    HMODULE ntdll;
+    BOOL ok = FALSE;
+
+    if (state) return state > 0;
+    ntdll = GetModuleHandleW( L"ntdll.dll" );
+    p_compress = (void *)GetProcAddress( ntdll, "RtlCompressBuffer" );
+    p_decompress = (void *)GetProcAddress( ntdll, "RtlDecompressBuffer" );
+    p_workspace = (void *)GetProcAddress( ntdll, "RtlGetCompressionWorkSpaceSize" );
+    if (p_compress && p_decompress && p_workspace && !p_workspace( FORMAT_XPRESS_HUFF, &ws, &frag ) && (work = calloc( 1, ws + 16 )))
+    {
+        ok = !p_compress( FORMAT_XPRESS_HUFF, in, sizeof(in), out, sizeof(out), 4096, &final, work );
+        free( work );
+    }
+    InterlockedExchange( &state, ok ? 1 : -1 );
+    return ok;
+}
+
+static SIZE_T huff_bound( SIZE_T size )
+{
+#ifdef SG_MUTANT_HF_BOUND
+    return size;
+#endif
+    return size + size / 4 + 512 * (size / 65536 + 1);
+}
+
+static BOOL huff_encode( const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T out_size, SIZE_T *written )
+{
+    ULONG final = 0, ws = 0, frag = 0;
+    void *work;
+    NTSTATUS status;
+
+    if (in_size > 0x7fffffff || out_size > 0x7fffffff || p_workspace( FORMAT_XPRESS_HUFF, &ws, &frag )) return FALSE;
+    if (!(work = calloc( 1, ws + 16 ))) return FALSE;
+    status = p_compress( FORMAT_XPRESS_HUFF, (UCHAR *)in, in_size, out, out_size, 4096, &final, work );
+    free( work );
+    if (status) return FALSE;
+    *written = final;
+    return TRUE;
+}
+
+static BOOL huff_decode( const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T out_size, SIZE_T *produced )
+{
+    ULONG final = 0;
+
+    if (in_size > 0x7fffffff || out_size > 0x7fffffff) return FALSE;
+    if (p_decompress( FORMAT_XPRESS_HUFF, out, out_size, (UCHAR *)in, in_size, &final )) return FALSE;
+    *produced = final;
+    return TRUE;
+}
+
 static BOOL create_handle( DWORD type, DWORD algorithm, HANDLE *out )
 {
     struct compress_handle *h;
@@ -107,7 +177,14 @@ static BOOL create_handle( DWORD type, DWORD algorithm, HANDLE *out )
         SetLastError( ERROR_INVALID_PARAMETER );
         return FALSE;
     }
-    if (alg != COMPRESS_ALGORITHM_NULL && alg != COMPRESS_ALGORITHM_MSZIP && alg != COMPRESS_ALGORITHM_XPRESS)
+    if (alg == COMPRESS_ALGORITHM_XPRESS_HUFF && !huff_available())
+    {
+        /* ntdll does not have the LZ77+Huffman codec */
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+    if (alg != COMPRESS_ALGORITHM_NULL && alg != COMPRESS_ALGORITHM_MSZIP && alg != COMPRESS_ALGORITHM_XPRESS
+            && alg != COMPRESS_ALGORITHM_XPRESS_HUFF)
     {
         FIXME( "algorithm %lu is not implemented\n", alg );
         SetLastError( ERROR_NOT_SUPPORTED );
@@ -553,12 +630,14 @@ static SIZE_T codec_bound( DWORD algorithm, SIZE_T size )
 {
     if (algorithm == COMPRESS_ALGORITHM_NULL) return size;
     if (algorithm == COMPRESS_ALGORITHM_XPRESS) return xpress_bound( size );
+    if (algorithm == COMPRESS_ALGORITHM_XPRESS_HUFF) return huff_bound( size );
     return mszip_bound( size );
 }
 
 static BOOL codec_decode( DWORD algorithm, const BYTE *in, SIZE_T in_size, BYTE *out, SIZE_T out_size, SIZE_T *produced )
 {
     if (algorithm == COMPRESS_ALGORITHM_XPRESS) return xpress_decode( in, in_size, out, out_size, produced );
+    if (algorithm == COMPRESS_ALGORITHM_XPRESS_HUFF) return huff_decode( in, in_size, out, out_size, produced );
     return mszip_decode( in, in_size, out, out_size, produced );
 }
 
@@ -566,6 +645,7 @@ static BOOL codec_encode( DWORD algorithm, const BYTE *in, SIZE_T in_size, BYTE
                           SIZE_T *written )
 {
     if (algorithm == COMPRESS_ALGORITHM_XPRESS) return xpress_encode( in, in_size, out, out_size, written );
+    if (algorithm == COMPRESS_ALGORITHM_XPRESS_HUFF) return huff_encode( in, in_size, out, out_size, written );
     return mszip_encode( in, in_size, out, out_size, level, written );
 }
 
@@ -574,7 +654,7 @@ static BOOL decode_chunk( DWORD algorithm, const BYTE *in, SIZE_T in_size, BYTE
     SIZE_T produced;
 
     if (algorithm == COMPRESS_ALGORITHM_NULL
-            || (algorithm == COMPRESS_ALGORITHM_XPRESS && in_size == expect)
+            || ((algorithm == COMPRESS_ALGORITHM_XPRESS || algorithm == COMPRESS_ALGORITHM_XPRESS_HUFF) && in_size == expect)
             || (in_size == expect && (in_size < 2 || in[0] != 'C' || in[1] != 'K')))
     {
         /* stored */
@@ -805,7 +885,11 @@ BOOL WINAPI Compress( COMPRESSOR_HANDLE handle, LPCVOID uncompressed, SIZE_T unc
 #ifdef SG_MUTANT_XP_STORED
         else if (0)
 #else
+#ifdef SG_MUTANT_HF_STORED
         else if (h->algorithm == COMPRESS_ALGORITHM_XPRESS && written >= len)
+#else
+        else if ((h->algorithm == COMPRESS_ALGORITHM_XPRESS || h->algorithm == COMPRESS_ALGORITHM_XPRESS_HUFF) && written >= len)
+#endif
 #endif
         {
             /* not smaller: the chunk is kept as it is (its size says so) */
