+ */
+
+#define COBJMACROS
+
+#include <stdint.h>
+#include "zlib.h"
+#include "dwrite_private.h"
+
+/* The layout of a WOFF 1.0 file is the one of the W3C recommendation: a 44 byte header,
+ * a directory of 20 byte table entries sorted by tag, and the tables, each starting on a
+ * 4 byte boundary, zlib compressed when that makes them smaller. All values are big endian. */
+#define WOFF_HEADER_SIZE 44
+#define WOFF_ENTRY_SIZE 20
+#define SFNT_HEADER_SIZE 12
+#define SFNT_ENTRY_SIZE 16
+
+static inline UINT32 woff_be32(const BYTE *p)
+{
+    return ((UINT32)p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3];
+}
+
+static inline UINT16 woff_be16(const BYTE *p)
+{
+    return (p[0] << 8) | p[1];
+}
+
+static inline void woff_put_be32(BYTE *p, UINT32 v)
+{
+    p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v;
+}
+
+static inline void woff_put_be16(BYTE *p, UINT16 v)
+{
+    p[0] = v >> 8; p[1] = v;
+}
+
+static voidpf woff_zalloc(voidpf opaque, uInt items, uInt size)
+{
+    return (UINT64)items * size > 0x7fffffff ? NULL : malloc(items * size);
+}
+
+static void woff_zfree(voidpf opaque, voidpf address)
+{
+    free(address);
+}
+
+static BOOL woff_inflate(const BYTE *src, UINT32 src_size, BYTE *dst, UINT32 dst_size)
+{
+    z_stream z = { 0 };
+    int ret;
+
+    z.zalloc = woff_zalloc;
+    z.zfree = woff_zfree;
+    z.next_in = (Bytef *)src;
+    z.avail_in = src_size;
+    z.next_out = dst;
+    z.avail_out = dst_size;
+    if (inflateInit(&z) != Z_OK)
+        return FALSE;
+    ret = inflate(&z, Z_FINISH);
+    inflateEnd(&z);
+    /* the tables have to unpack to exactly the size the directory gives */
+    return ret == Z_STREAM_END && z.total_out == dst_size;
+}
+
+#ifdef SG_MUTANT_WOFF_RECOMPUTE_CHECKSUM
+static UINT32 woff_table_checksum(const BYTE *data, UINT32 size)
+{
+    UINT32 sum = 0, i;
+
+    for (i = 0; i + 4 <= size; i += 4)
+        sum += woff_be32(data + i);
+    if (i < size)
+    {
+        UINT32 last = 0, shift = 24;
+
+        for (; i < size; i++, shift -= 8)
+            last |= (UINT32)data[i] << shift;
+        sum += last;
+    }
+    return sum;
+}
+#endif
+
+/* Returns the font as an sfnt in a block the caller frees, or DWRITE_E_FILEFORMAT for a file
+ * that does not follow the format. */
+HRESULT woff_unpack(const void *data, UINT32 data_size, void **out, UINT32 *out_size)
+{
+    const BYTE *file = data;
+    UINT32 flavor, length, sfnt_size, num_tables, i, offset, total, entry_selector, search_range;
+    BYTE *sfnt;
+
+    *out = NULL;
+    *out_size = 0;
+
+    if (!file || data_size < WOFF_HEADER_SIZE || woff_be32(file) != 0x774f4646 /* wOFF */)
+        return DWRITE_E_FILEFORMAT;
+
+    flavor = woff_be32(file + 4);
+    length = woff_be32(file + 8);
+    num_tables = woff_be16(file + 12);
+    sfnt_size = woff_be32(file + 16);
+
+    if (length != data_size || !num_tables || woff_be16(file + 14) /* reserved */ ||
+            (UINT64)WOFF_HEADER_SIZE + (UINT64)num_tables * WOFF_ENTRY_SIZE > data_size)
+        return DWRITE_E_FILEFORMAT;
+
+    /* the size of the sfnt the tables make up */
+    total = SFNT_HEADER_SIZE + num_tables * SFNT_ENTRY_SIZE;
+    for (i = 0; i < num_tables; i++)
+    {
+        const BYTE *entry = file + WOFF_HEADER_SIZE + i * WOFF_ENTRY_SIZE;
+        UINT32 tag = woff_be32(entry), table_offset = woff_be32(entry + 4), comp = woff_be32(entry + 8);
+        UINT32 orig = woff_be32(entry + 12);
+
+        /* tables are sorted by tag, start at a multiple of four inside the file, are never
+         * longer packed than unpacked */
+        if ((i && tag <= woff_be32(entry - WOFF_ENTRY_SIZE)) || (table_offset & 3) || comp > orig ||
+                table_offset < WOFF_HEADER_SIZE + num_tables * WOFF_ENTRY_SIZE ||
+                (UINT64)table_offset + comp > data_size || (UINT64)total + orig + 3 > 0xffffffffu)
+            return DWRITE_E_FILEFORMAT;
+        total += (orig + 3) & ~3u;
+    }
+
+#ifndef SG_MUTANT_WOFF_NO_SIZE_CHECK
+    if (total != sfnt_size)
+        return DWRITE_E_FILEFORMAT;
+#endif
+
+    if (!(sfnt = calloc(1, sfnt_size)))
+        return E_OUTOFMEMORY;
+
+    for (entry_selector = 0; (2u << entry_selector) <= num_tables; entry_selector++)
+        ;
+    search_range = 16u << entry_selector;
+    woff_put_be32(sfnt, flavor);
+    woff_put_be16(sfnt + 4, num_tables);
+    woff_put_be16(sfnt + 6, search_range);
+    woff_put_be16(sfnt + 8, entry_selector);
+    woff_put_be16(sfnt + 10, num_tables * 16 - search_range);
+
+    offset = SFNT_HEADER_SIZE + num_tables * SFNT_ENTRY_SIZE;
+    for (i = 0; i < num_tables; i++)
+    {
+        const BYTE *entry = file + WOFF_HEADER_SIZE + i * WOFF_ENTRY_SIZE;
+        UINT32 table_offset = woff_be32(entry + 4), comp = woff_be32(entry + 8), orig = woff_be32(entry + 12);
+        BYTE *record = sfnt + SFNT_HEADER_SIZE + i * SFNT_ENTRY_SIZE;
+
+        if (comp == orig)
+            memcpy(sfnt + offset, file + table_offset, orig);
+        else if (!woff_inflate(file + table_offset, comp, sfnt + offset, orig))
+        {
+            free(sfnt);
+            return DWRITE_E_FILEFORMAT;
+        }
+
+        memcpy(record, entry, 4);
+#ifdef SG_MUTANT_WOFF_RECOMPUTE_CHECKSUM
+        woff_put_be32(record + 4, woff_table_checksum(sfnt + offset, orig));
+#else
+        /* the checksum of the head table is taken with its adjustment field zeroed, so it is not
+         * the sum of the table: keep the one the file carries */
+        woff_put_be32(record + 4, woff_be32(entry + 16));
+#endif
+        woff_put_be32(record + 8, offset);
+        woff_put_be32(record + 12, orig);
+        offset += (orig + 3) & ~3u;
+    }
+
+    *out = sfnt;
+    *out_size = sfnt_size;
+    return S_OK;
+}
