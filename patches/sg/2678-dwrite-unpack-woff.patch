From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: UnpackFontFile for WOFF

IDWriteFactory5::UnpackFontFile turns a WOFF 1.0 font into the sfnt it
packs, as a font file stream: the header, the table directory sorted by
tag, the tables unpacked with zlib where the file packed them (a table
stored as is stays as is) on four byte boundaries, with the checksums the
file carries. A file that is not WOFF 1.0, whose length or total size does
not match, with a reserved field set, tables out of order, not aligned or
longer packed than unpacked, or with damaged zlib data is refused with
DWRITE_E_FILEFORMAT; no output pointer or an unknown container type is
E_INVALIDARG. WOFF2 needs a Brotli decoder and stays E_NOTIMPL.
---
--- a/dlls/dwrite/Makefile.in
+++ b/dlls/dwrite/Makefile.in
@@ -1,7 +1,8 @@
 MODULE    = dwrite.dll
 IMPORTLIB = dwrite
 UNIXLIB   = dwrite.so
-IMPORTS   = user32 gdi32 advapi32
+IMPORTS   = $(ZLIB_PE_LIBS) user32 gdi32 advapi32
+EXTRAINCL = $(ZLIB_PE_CFLAGS)
 UNIX_CFLAGS = $(FREETYPE_CFLAGS)
 
 SOURCES = \
@@ -21,4 +22,5 @@ SOURCES = \
 	scripts.c \
 	shape.c \
 	shapers/arabic.c \
-	shapers/arabic_table.c
+	shapers/arabic_table.c \
+	woff.c
--- a/dlls/dwrite/dwrite_private.h
+++ b/dlls/dwrite/dwrite_private.h
@@ -530,6 +530,8 @@ extern HRESULT opentype_get_cpal_entries(const struct dwrite_fonttable *table, u
         unsigned int first_entry_index, unsigned int entry_count, DWRITE_COLOR_F *entries);
 extern UINT32 opentype_get_glyph_image_formats(IDWriteFontFace5 *fontface);
 extern DWRITE_CONTAINER_TYPE opentype_analyze_container_type(void const *, UINT32);
+extern HRESULT woff_unpack(const void *data, UINT32 data_size, void **out, UINT32 *out_size);
+extern HRESULT create_inmemory_filestream(void *data, UINT32 size, IDWriteFontFileStream **stream);
 extern HRESULT opentype_get_kerning_pairs(struct dwrite_fontface *fontface, unsigned int count,
         const UINT16 *glyphs, INT32 *values);
 extern BOOL opentype_has_kerning_pairs(struct dwrite_fontface *fontface);
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -7698,6 +7698,34 @@ static const IDWriteFontFileStreamVtbl inmemoryfilestreamvtbl = {
     inmemoryfilestream_GetLastWriteTime,
 };
 
+/* A stream over a block the stream owns from now on; it is freed with the stream. */
+HRESULT create_inmemory_filestream(void *data, UINT32 size, IDWriteFontFileStream **stream)
+{
+    struct dwrite_inmemory_stream_data *stream_data;
+    struct dwrite_inmemory_filestream *object;
+
+    *stream = NULL;
+
+    if (!(stream_data = calloc(1, sizeof(*stream_data))))
+        return E_OUTOFMEMORY;
+    if (!(object = calloc(1, sizeof(*object))))
+    {
+        free(stream_data);
+        return E_OUTOFMEMORY;
+    }
+
+    stream_data->refcount = 1;
+    stream_data->data = data;
+    stream_data->size = size;
+
+    object->IDWriteFontFileStream_iface.lpVtbl = &inmemoryfilestreamvtbl;
+    object->refcount = 1;
+    object->data = stream_data;
+
+    *stream = &object->IDWriteFontFileStream_iface;
+    return S_OK;
+}
+
 static HRESULT WINAPI inmemoryfontfileloader_QueryInterface(IDWriteInMemoryFontFileLoader *iface,
         REFIID riid, void **obj)
 {
--- a/dlls/dwrite/main.c
+++ b/dlls/dwrite/main.c
@@ -1879,9 +1879,30 @@ static DWRITE_CONTAINER_TYPE WINAPI dwritefactory5_AnalyzeContainerType(IDWriteF
 static HRESULT WINAPI dwritefactory5_UnpackFontFile(IDWriteFactory7 *iface, DWRITE_CONTAINER_TYPE container_type, void const *data,
         UINT32 data_size, IDWriteFontFileStream **stream)
 {
-    FIXME("%p, %d, %p, %u, %p: stub\n", iface, container_type, data, data_size, stream);
+    void *unpacked;
+    UINT32 size;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%p, %d, %p, %u, %p.\n", iface, container_type, data, data_size, stream);
+
+    if (!stream)
+        return E_INVALIDARG;
+    *stream = NULL;
+
+    switch (container_type)
+    {
+    case DWRITE_CONTAINER_TYPE_WOFF:
+        if (FAILED(hr = woff_unpack(data, data_size, &unpacked, &size)))
+            return hr;
+        if (FAILED(hr = create_inmemory_filestream(unpacked, size, stream)))
+            free(unpacked);
+        return hr;
+    case DWRITE_CONTAINER_TYPE_WOFF2:
+        FIXME("WOFF2 needs a Brotli decoder.\n");
+        return E_NOTIMPL;
+    default:
+        return E_INVALIDARG;
+    }
 }
 
