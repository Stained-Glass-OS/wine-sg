+                               wcslen(RuntimeClass_Windows_Globalization_Language), class_name);
+}
+
+static HRESULT STDMETHODCALLTYPE language_statics2_GetTrustLevel(ILanguageStatics2 *iface, TrustLevel *trust_level)
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+/* Switches the thread's keyboard layout to an installed one of that
+ * language; FALSE when none is installed. */
+static HRESULT STDMETHODCALLTYPE language_statics2_TrySetInputMethodLanguageTag(ILanguageStatics2 *iface, HSTRING tag, BOOLEAN *result)
+{
+    const WCHAR *name = WindowsGetStringRawBuffer(tag, NULL);
+    HKL layouts[64];
+    LCID lcid;
+    int i, count;
+
+    TRACE("iface %p, tag %s, result %p.\n", iface, debugstr_hstring(tag), result);
+
+    if (!result) return E_POINTER;
+    *result = FALSE;
+    if (!name || !*name || !(lcid = LocaleNameToLCID(name, 0))) return S_OK;
+    count = GetKeyboardLayoutList(ARRAY_SIZE(layouts), layouts);
+    for (i = 0; i < count; i++)
+    {
+        if (LOWORD(layouts[i]) != LANGIDFROMLCID(lcid)) continue;
+        *result = ActivateKeyboardLayout(layouts[i], 0) != NULL;
+        break;
+    }
+    return S_OK;
+}
+
+static const struct ILanguageStatics2Vtbl language_statics2_vtbl =
+{
+    language_statics2_QueryInterface,
+    language_statics2_AddRef,
+    language_statics2_Release,
+    /* IInspectable methods */
+    language_statics2_GetIids,
+    language_statics2_GetRuntimeClassName,
+    language_statics2_GetTrustLevel,
+    /* ILanguageStatics2 methods */
+    language_statics2_TrySetInputMethodLanguageTag,
+};
+
 static struct language_factory language_factory =
 {
     {&activation_factory_language_vtbl},
     {&language_factory_vtbl},
+    {&language_statics_vtbl},
+    {&language_statics2_vtbl},
     0
 };
 
