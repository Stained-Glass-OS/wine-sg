+/* Stained Glass OS (wine-sg 1529): Language's statics. Publisher asks for
+ * the input method's language as a text box takes the caret. */
+static void input_language_tag(WCHAR *buffer, int size)
+{
+    LANGID lang = LOWORD(GetKeyboardLayout(0));
+
+    if (!LCIDToLocaleName(MAKELCID(lang, SORT_DEFAULT), buffer, size, 0) &&
+        !GetUserDefaultLocaleName(buffer, size))
+        wcscpy(buffer, L"en-US");
+}
+
+static BOOL is_well_formed_tag(const WCHAR *tag)
+{
+    const WCHAR *p = tag;
+    unsigned int len, index = 0;
+    BOOL private_use = FALSE;
+
+    if (!tag || !*tag) return FALSE;
+    for (;;)
+    {
+        BOOL alpha = TRUE;
+
+        for (len = 0; p[len] && p[len] != '-'; len++)
+        {
+            WCHAR c = p[len];
+            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) continue;
+            if (c >= '0' && c <= '9') { alpha = FALSE; continue; }
+            return FALSE;
+        }
+        if (!len || len > 8) return FALSE;
+        if (!index)
+        {
+            if (!alpha) return FALSE;
+            if (len == 1)
+            {
+                if (p[0] != 'x' && p[0] != 'X' && p[0] != 'i' && p[0] != 'I') return FALSE;
+                private_use = TRUE;
+            }
+            else if (len == 4) return FALSE;
+        }
+        else if (len == 1 && !private_use && (p[0] == 'x' || p[0] == 'X')) private_use = TRUE;
+        index++;
+        if (!p[len]) break;
+        p += len + 1;
+    }
+    if (private_use && index == 1) return FALSE;
+    return TRUE;
+}
+
+static inline struct language_factory *impl_from_ILanguageStatics(ILanguageStatics *iface)
+{
+    return CONTAINING_RECORD(iface, struct language_factory, ILanguageStatics_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE language_statics_QueryInterface(ILanguageStatics *iface, REFIID iid, void **out)
+{
+    struct language_factory *factory = impl_from_ILanguageStatics(iface);
+    return IActivationFactory_QueryInterface(&factory->IActivationFactory_iface, iid, out);
+}
+
+static ULONG STDMETHODCALLTYPE language_statics_AddRef(ILanguageStatics *iface)
+{
+    struct language_factory *factory = impl_from_ILanguageStatics(iface);
+    return IActivationFactory_AddRef(&factory->IActivationFactory_iface);
+}
+
+static ULONG STDMETHODCALLTYPE language_statics_Release(ILanguageStatics *iface)
+{
+    struct language_factory *factory = impl_from_ILanguageStatics(iface);
+    return IActivationFactory_Release(&factory->IActivationFactory_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE language_statics_GetIids(ILanguageStatics *iface, ULONG *iid_count, IID **iids)
+{
+    FIXME("iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids);
+    return E_NOTIMPL;
+}
+
+static HRESULT STDMETHODCALLTYPE language_statics_GetRuntimeClassName(ILanguageStatics *iface, HSTRING *class_name)
+{
+    return WindowsCreateString(RuntimeClass_Windows_Globalization_Language,
+                               wcslen(RuntimeClass_Windows_Globalization_Language), class_name);
+}
+
+static HRESULT STDMETHODCALLTYPE language_statics_GetTrustLevel(ILanguageStatics *iface, TrustLevel *trust_level)
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE language_statics_IsWellFormed(ILanguageStatics *iface, HSTRING tag, BOOLEAN *result)
+{
+    TRACE("iface %p, tag %s, result %p.\n", iface, debugstr_hstring(tag), result);
+
+    if (!result) return E_POINTER;
+    *result = is_well_formed_tag(WindowsGetStringRawBuffer(tag, NULL));
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE language_statics_get_CurrentInputMethodLanguageTag(ILanguageStatics *iface, HSTRING *value)
+{
+    WCHAR buffer[LOCALE_NAME_MAX_LENGTH];
+
+    TRACE("iface %p, value %p.\n", iface, value);
+
+    if (!value) return E_POINTER;
+    input_language_tag(buffer, ARRAY_SIZE(buffer));
+    return WindowsCreateString(buffer, wcslen(buffer), value);
+}
+
+static const struct ILanguageStaticsVtbl language_statics_vtbl =
+{
+    language_statics_QueryInterface,
+    language_statics_AddRef,
+    language_statics_Release,
+    /* IInspectable methods */
+    language_statics_GetIids,
+    language_statics_GetRuntimeClassName,
+    language_statics_GetTrustLevel,
+    /* ILanguageStatics methods */
+    language_statics_IsWellFormed,
+    language_statics_get_CurrentInputMethodLanguageTag,
+};
+
