From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 15:05:37 -0700
Subject: [PATCH] windows.system.profile.systemmanufacturers: SmbiosInformation
 statics

- GetIids, GetRuntimeClassName and GetTrustLevel answer; ActivateInstance fails quietly (static class)
- SerialNumber gives the caller its own string: the BSTR from WMI was freed with its variant and then
  used, and an empty or missing serial crashed

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/windows.system.profile.systemmanufacturers/main.c b/dlls/windows.system.profile.systemmanufacturers/main.c
index ba30d84..33df5bd 100644
--- a/dlls/windows.system.profile.systemmanufacturers/main.c
+++ b/dlls/windows.system.profile.systemmanufacturers/main.c
@@ -59,7 +59,7 @@ static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID
         return S_OK;
     }
 
-    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
 }
@@ -82,25 +82,37 @@ static ULONG WINAPI factory_Release( IActivationFactory *iface )
 
 static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
 {
-    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
-    return E_NOTIMPL;
+    IID *list;
+
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    if (!(list = CoTaskMemAlloc( sizeof(*list) ))) return E_OUTOFMEMORY;
+    *list = IID_ISmbiosInformationStatics;
+    *iid_count = 1;
+    *iids = list;
+    return S_OK;
 }
 
 static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
 {
-    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
-    return E_NOTIMPL;
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_System_Profile_SystemManufacturers_SmbiosInformation,
+                                wcslen( RuntimeClass_Windows_System_Profile_SystemManufacturers_SmbiosInformation ),
+                                class_name );
 }
 
 static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
 {
-    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
-    return E_NOTIMPL;
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
 }
 
 static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
 {
-    FIXME( "iface %p, instance %p stub!\n", iface, instance );
+    /* SmbiosInformation only has static members */
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    *instance = NULL;
     return E_NOTIMPL;
 }
 
@@ -159,14 +171,19 @@ static HRESULT get_bios_serialnumber( BSTR *value )
     hr = IEnumWbemClassObject_Next( wbem_enum, 1000, 1, &wbem_class, &count );
     IEnumWbemClassObject_Release( wbem_enum );
     if (FAILED(hr)) return hr;
+    if (!count) return E_UNEXPECTED;
 
     hr = IWbemClassObject_Get( wbem_class, L"SerialNumber", 0, &serial, NULL, NULL );
     IWbemClassObject_Release( wbem_class );
     if (FAILED(hr)) return hr;
 
-    *value = V_BSTR( &serial );
+    /* the string is the caller's now, not the variant's */
+    if (V_VT( &serial ) == VT_BSTR && V_BSTR( &serial ))
+        *value = SysAllocStringLen( V_BSTR( &serial ), SysStringLen( V_BSTR( &serial ) ) );
+    else
+        *value = SysAllocString( L"" );
     VariantClear( &serial );
-    return hr;
+    return *value ? S_OK : E_OUTOFMEMORY;
 }
 
 static HRESULT WINAPI statics_get_SerialNumber( ISmbiosInformationStatics *iface, HSTRING *value )
@@ -177,9 +194,11 @@ static HRESULT WINAPI statics_get_SerialNumber( ISmbiosInformationStatics *iface
     TRACE( "iface %p, value %p.\n", iface, value );
 
     if (FAILED( hr = get_bios_serialnumber( &serial ) )) return hr;
-    if (FAILED( hr = WindowsCreateString( serial, wcslen(serial), value ) )) return hr;
+    if (!value) { SysFreeString( serial ); return E_POINTER; }
+    hr = WindowsCreateString( serial, SysStringLen( serial ), value );
 
     TRACE( "Returning serial number: %s.\n", debugstr_w( serial ) );
+    SysFreeString( serial );
     return hr;
 }
 
@@ -207,7 +226,7 @@ static IActivationFactory *smbios_factory = &smbios_statics.IActivationFactory_i
 
 HRESULT WINAPI DllGetClassObject( REFCLSID clsid, REFIID riid, void **out )
 {
-    FIXME( "clsid %s, riid %s, out %p stub!\n", debugstr_guid(clsid), debugstr_guid(riid), out );
+    WARN( "clsid %s, riid %s, out %p: no class objects.\n", debugstr_guid(clsid), debugstr_guid(riid), out );
     return CLASS_E_CLASSNOTAVAILABLE;
 }
 
