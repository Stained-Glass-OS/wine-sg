From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: Validate SetServiceBits arguments.

SetServiceBits refuses the bits Windows keeps for itself
(ERROR_INVALID_DATA) and a NULL status handle (ERROR_INVALID_HANDLE). Valid
bits still succeed without being announced: there is no browser service to
announce them to (the FIXME says so).

Gate: test/advapi32-servicebits-gate.sh (64/32).
---
 dlls/advapi32/service.c | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/dlls/advapi32/service.c b/dlls/advapi32/service.c
index 63308be..9d7b27f 100644
--- a/dlls/advapi32/service.c
+++ b/dlls/advapi32/service.c
@@ -462,8 +462,24 @@ BOOL WINAPI SetServiceBits( SERVICE_STATUS_HANDLE hServiceStatus,
         BOOL bSetBitsOn,
         BOOL bUpdateImmediately)
 {
-    FIXME("%p %08lx %x %x\n", hServiceStatus, dwServiceBits,
+    TRACE("%p %08lx %x %x\n", hServiceStatus, dwServiceBits,
           bSetBitsOn, bUpdateImmediately);
+
+    /* the bits Windows keeps for itself (SetServiceBits documentation) */
+#ifndef SG_MUTANT_SERVICEBITS_NO_CHECK
+    if (dwServiceBits & 0xc00f3f7b)
+    {
+        SetLastError( ERROR_INVALID_DATA );
+        return FALSE;
+    }
+#endif
+    if (!hServiceStatus)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    /* there is no browser service to announce the bits to */
+    FIXME("%p %08lx %x %x: bits not announced\n", hServiceStatus, dwServiceBits, bSetBitsOn, bUpdateImmediately);
     return TRUE;
 }
 
