From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msacm32: Implement ACM_METRIC_MAX_SIZE_FILTER and fix acmDriverAdd by name and DRV_CONFIGURE to an open driver.

acmMetrics answers ACM_METRIC_MAX_SIZE_FILTER: the size of the largest
WAVEFILTER of every enabled driver (hao NULL), of one driver identifier, or
of one open driver, from the drivers' filter tag details, as
ACM_METRIC_MAX_SIZE_FORMAT does for formats. The hardware wave metrics
return MMSYSERR_NOTSUPPORTED without a FIXME: no waveform-audio device is
associated with Wine's software drivers, which the documentation says is
MMSYSERR_NOTSUPPORTED.

acmDriverMessage(DRV_CONFIGURE) without configuration info to an open
driver now finds the driver identifier (and so the alias) of the open driver
for the DRVCONFIGINFO msacm supplies, as it did for a driver identifier.

acmDriverAdd(ACM_DRIVERADDF_NAME) registered the driver but returned
MMSYSERR_INVALPARAM: the registry helper never returned the identifier.

Gate: test/msacm32-metrics-gate.sh (64/32; the probe is its own ACM driver).
---
 dlls/msacm32/driver.c       | 11 ++++++--
 dlls/msacm32/internal.c     |  4 +++
 dlls/msacm32/msacm32_main.c | 62 ++++++++++++++++++++++++++++++++++++++++++++-
 3 files changed, 74 insertions(+), 3 deletions(-)

diff --git a/dlls/msacm32/driver.c b/dlls/msacm32/driver.c
index c01872d..d89ed9f 100644
--- a/dlls/msacm32/driver.c
+++ b/dlls/msacm32/driver.c
@@ -420,8 +420,15 @@ LRESULT WINAPI acmDriverMessage(HACMDRIVER had, UINT uMsg, LPARAM lParam1, LPARA
                     WARN("DRV_CONFIGURE: no alias for this driver, cannot self-supply alias\n");
                 }
             } else {
-                FIXME("DRV_CONFIGURE: reverse lookup HACMDRIVER -> HACMDRIVERID not implemented\n");
-                pAlias = NULL;
+                /* an open driver: its driver identifier, as acmDriverID gives it */
+                PWINE_ACMDRIVER pad = MSACM_GetDriver(had);
+
+#ifdef SG_MUTANT_ACM_NO_REVERSE_LOOKUP
+                pad = NULL;
+#endif
+                pAlias = pad ? pad->obj.pACMDriverID->pszDriverAlias : NULL;
+                if (!pAlias)
+                    WARN("DRV_CONFIGURE: no alias for driver %p, cannot self-supply alias\n", had);
             }
         
             if (pAlias != NULL) {
diff --git a/dlls/msacm32/internal.c b/dlls/msacm32/internal.c
index 7c2d3b5..1ac8ee9 100644
--- a/dlls/msacm32/internal.c
+++ b/dlls/msacm32/internal.c
@@ -81,7 +81,11 @@ PWINE_ACMDRIVERID MSACM_RegisterDriverFromRegistry(LPCWSTR pszRegEntry)
             if (lRet != ERROR_SUCCESS) {
                 WARN("unable to query requested subkey %s - 0x%08lx\n", debugstr_w(pszRegEntry), lRet);
             } else {
+#ifdef SG_MUTANT_ACM_ADDNAME_NULL
                 MSACM_RegisterDriver(pszRegEntry, buf, 0);
+#else
+                padid = MSACM_RegisterDriver(pszRegEntry, buf, 0);
+#endif
             }
             RegCloseKey( hKey );
         }
diff --git a/dlls/msacm32/msacm32_main.c b/dlls/msacm32/msacm32_main.c
index 5d36611..8c40b07 100644
--- a/dlls/msacm32/msacm32_main.c
+++ b/dlls/msacm32/msacm32_main.c
@@ -100,6 +100,36 @@ DWORD WINAPI acmGetVersion(void)
  *   No documentation found.
  */
 
+/* the largest WAVEFILTER of a driver's filter tags (the driver is opened when no
+ * open instance is given) */
+static DWORD max_filter_size(PWINE_ACMDRIVERID padid, HACMDRIVER had)
+{
+    ACMFILTERTAGDETAILSW aftd;
+    HACMDRIVER opened = NULL;
+    DWORD i, size = 0;
+
+    if (!padid->cFilterTags || (padid->fdwSupport & ACMDRIVERDETAILS_SUPPORTF_DISABLED))
+        return 0;
+    if (!had)
+    {
+        if (acmDriverOpen(&opened, (HACMDRIVERID)padid, 0))
+            return 0;
+        had = opened;
+    }
+    for (i = 0; i < padid->cFilterTags; i++)
+    {
+        memset(&aftd, 0, sizeof(aftd));
+        aftd.cbStruct = sizeof(aftd);
+        aftd.dwFilterTagIndex = i;
+        if (!MSACM_Message(had, ACMDM_FILTERTAG_DETAILS, (LPARAM)&aftd, ACM_FILTERTAGDETAILSF_INDEX)
+                && aftd.cbFilterSize > size)
+            size = aftd.cbFilterSize;
+    }
+    if (opened)
+        acmDriverClose(opened, 0);
+    return size;
+}
+
 /***********************************************************************
  *           acmMetrics (MSACM32.@)
  */
@@ -259,9 +289,39 @@ MMRESULT WINAPI acmMetrics(HACMOBJ hao, UINT uMetric, LPVOID pMetric)
         }
         break;
 
+    case ACM_METRIC_MAX_SIZE_FILTER:
+        if (hao == NULL) {
+            for (padid = MSACM_pFirstACMDriverID; padid; padid = padid->pNextACMDriverID)
+                val = max(val, max_filter_size(padid, NULL));
+        } else if (pao != NULL) {
+            switch (pao->dwType) {
+            case WINE_ACMOBJ_DRIVER:
+                val = max_filter_size(pao->pACMDriverID, (HACMDRIVER)hao);
+                break;
+            case WINE_ACMOBJ_DRIVERID:
+                val = max_filter_size(pao->pACMDriverID, NULL);
+                break;
+            default:
+                return MMSYSERR_INVALHANDLE;
+            }
+        } else {
+            return MMSYSERR_INVALHANDLE;
+        }
+        if (!pMetric) return MMSYSERR_INVALPARAM;
+#ifdef SG_MUTANT_ACM_FILTER_SIZE_ZERO
+        val = 0;
+#endif
+        *(LPDWORD)pMetric = val;
+        break;
+
+    /* Wine's ACM drivers are all software ones: no waveform-audio device is
+     * associated with any of them, which is MMSYSERR_NOTSUPPORTED */
     case ACM_METRIC_HARDWARE_WAVE_INPUT:
     case ACM_METRIC_HARDWARE_WAVE_OUTPUT:
-    case ACM_METRIC_MAX_SIZE_FILTER:
+        if (!pao) return MMSYSERR_INVALHANDLE;
+        mmr = MMSYSERR_NOTSUPPORTED;
+        break;
+
     default:
 	FIXME("(%p, %d, %p): stub\n", hao, uMetric, pMetric);
 	mmr = MMSYSERR_NOTSUPPORTED;
