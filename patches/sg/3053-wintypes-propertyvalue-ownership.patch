+static void test_property_value_ownership(void)
+{
+    static const WCHAR *class_name = L"Windows.Foundation.PropertyValue";
+    IPropertyValueStatics *statics;
+    IInspectable *inspectable, *objects[2], **got_objects = NULL, *boxed;
