+static BOOL is_contract_present_w(const WCHAR *name, UINT16 major, UINT16 minor)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(present_contracts); ++i)
+    {
+        if (wcsicmp(name, present_contracts[i].name)) continue;
+        /* the contracts provided are provided at .0 of their highest major version */
+        return major <= present_contracts[i].max_major && (!minor || major < present_contracts[i].max_major);
+    }
+    return FALSE;
+}
+
 HRESULT WINAPI RoIsApiContractMajorVersionPresent(const WCHAR *name, UINT16 major, BOOL *result)
 {
-    FIXME("name %s, major %u, result %p\n", debugstr_w(name), major, result);
-    *result = FALSE;
+    TRACE("name %s, major %u, result %p\n", debugstr_w(name), major, result);
+
+    if (!name || !result) return E_INVALIDARG;
+    *result = is_contract_present_w(name, major, 0);
+    return S_OK;
+}
+
+HRESULT WINAPI RoIsApiContractPresent(const WCHAR *name, UINT16 major, UINT16 minor, BOOL *result)
+{
+    TRACE("name %s, major %u, minor %u, result %p\n", debugstr_w(name), major, minor, result);
+
+    if (!name || !result) return E_INVALIDARG;
+    *result = is_contract_present_w(name, major, minor);
     return S_OK;
 }
 
