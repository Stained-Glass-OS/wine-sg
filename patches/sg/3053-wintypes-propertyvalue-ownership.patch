+static HRESULT return_iids(ULONG *iid_count, IID **iids, const IID *const *list, ULONG count)
+{
+    IID *copy;
+    ULONG i;
+
+    if (!(copy = CoTaskMemAlloc(count * sizeof(*copy))))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+        copy[i] = *list[i];
+    *iid_count = count;
+    *iids = copy;
+    return S_OK;
+}
