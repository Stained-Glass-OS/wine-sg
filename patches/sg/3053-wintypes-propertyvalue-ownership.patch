+    HSTRING str, class, name, got_str;
+    UINT32 count = 0, i;
+    HRESULT hr;
+    PropertyType type;
+    ULONG ref;
+
+    IActivationFactory *factory;
+
+    hr = RoInitialize(RO_INIT_MULTITHREADED);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    WindowsCreateString(class_name, wcslen(class_name), &class);
+    hr = RoGetActivationFactory(class, &IID_IActivationFactory, (void **)&factory);
+    WindowsDeleteString(class);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IActivationFactory_QueryInterface(factory, &IID_IPropertyValueStatics, (void **)&statics);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    IActivationFactory_Release(factory);
+
+    /* the value keeps its own copy of the string */
+    WindowsCreateString(L"owned", 5, &str);
+    hr = IPropertyValueStatics_CreateString(statics, str, &inspectable);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    WindowsDeleteString(str);
+    hr = IInspectable_QueryInterface(inspectable, &IID_IPropertyValue, (void **)&value);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IPropertyValue_GetString(value, &got_str);
+    ok(hr == S_OK && !wcscmp(WindowsGetStringRawBuffer(got_str, NULL), L"owned"), "Got unexpected hr %#lx.\n", hr);
+    WindowsDeleteString(got_str);
+    hr = IInspectable_GetRuntimeClassName(inspectable, &name);
+    ok(hr == S_OK && !wcscmp(WindowsGetStringRawBuffer(name, NULL), L"Windows.Foundation.IReference`1<String>"),
+            "Got unexpected hr %#lx, %s.\n", hr, hr == S_OK ? debugstr_w(WindowsGetStringRawBuffer(name, NULL)) : "");
+    if (hr == S_OK) WindowsDeleteString(name);
+    {
+        TrustLevel trust = 99;
+        IID *iids = NULL;
+        ULONG iid_count = 0;
+
+        hr = IInspectable_GetTrustLevel(inspectable, &trust);
+        ok(hr == S_OK && trust == BaseTrust, "Got unexpected hr %#lx.\n", hr);
+        hr = IInspectable_GetIids(inspectable, &iid_count, &iids);
+        ok(hr == S_OK && iid_count == 2 && IsEqualGUID(&iids[0], &IID_IPropertyValue), "Got unexpected hr %#lx, count %lu.\n",
+                hr, iid_count);
+        if (hr == S_OK) CoTaskMemFree(iids);
+    }
+    IPropertyValue_Release(value);
+    IInspectable_Release(inspectable);
+
+    /* inspectable values and arrays hold their objects */
+    hr = IPropertyValueStatics_CreateInt32(statics, 5, &boxed);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IPropertyValueStatics_CreateInspectable(statics, boxed, &inspectable);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IInspectable_QueryInterface(inspectable, &IID_IPropertyValue, (void **)&value);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IPropertyValue_get_Type(value, &type);
+    ok(hr == S_OK && type == PropertyType_Inspectable, "Got unexpected hr %#lx, type %d.\n", hr, type);
+    IPropertyValue_Release(value);
+    IInspectable_Release(inspectable);
+
+    objects[0] = boxed;
+    objects[1] = boxed;
+    IInspectable_AddRef(boxed);
+    IInspectable_AddRef(boxed);
+    hr = IPropertyValueStatics_CreateInspectableArray(statics, 2, objects, &inspectable);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    IInspectable_Release(boxed);
+    IInspectable_Release(boxed);
+    hr = IInspectable_QueryInterface(inspectable, &IID_IPropertyValue, (void **)&value);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IPropertyValue_GetInspectableArray(value, &count, &got_objects);
+    ok(hr == S_OK && count == 2 && got_objects && got_objects[0] == boxed, "Got unexpected hr %#lx, count %u.\n", hr, count);
+    for (i = 0; hr == S_OK && i < count; i++) IInspectable_Release(got_objects[i]);
+    CoTaskMemFree(got_objects);
+    IPropertyValue_Release(value);
+    IInspectable_Release(inspectable);
+    ref = IInspectable_Release(boxed);
+    ok(!ref, "Got unexpected refcount %lu.\n", ref);
+
+    IPropertyValueStatics_Release(statics);
+    RoUninitialize();
+}
+
+static void test_api_contract_exports(void)
+{
+    HRESULT (WINAPI *pRoIsApiContractPresent)(const WCHAR *, UINT16, UINT16, BOOL *);
+    HRESULT (WINAPI *pRoIsApiContractMajorVersionPresent)(const WCHAR *, UINT16, BOOL *);
+    HMODULE mod = GetModuleHandleA("wintypes.dll");
+    BOOL present;
+    HRESULT hr;
+
+    if (!mod) mod = LoadLibraryA("wintypes.dll");
+    pRoIsApiContractPresent = (void *)GetProcAddress(mod, "RoIsApiContractPresent");
+    pRoIsApiContractMajorVersionPresent = (void *)GetProcAddress(mod, "RoIsApiContractMajorVersionPresent");
+    if (!pRoIsApiContractPresent || !pRoIsApiContractMajorVersionPresent)
+    {
+        win_skip("The API contract exports are not available.\n");
+        return;
+    }
+
+    present = FALSE;
+    hr = pRoIsApiContractMajorVersionPresent(L"Windows.Foundation.UniversalApiContract", 1, &present);
+    ok(hr == S_OK && present, "Got unexpected hr %#lx, present %d.\n", hr, present);
+    present = TRUE;
+    hr = pRoIsApiContractMajorVersionPresent(L"Windows.Foundation.UniversalApiContract", 4000, &present);
+    ok(hr == S_OK && !present, "Got unexpected hr %#lx, present %d.\n", hr, present);
+    present = TRUE;
+    hr = pRoIsApiContractMajorVersionPresent(L"No.Such.Contract", 1, &present);
+    ok(hr == S_OK && !present, "Got unexpected hr %#lx, present %d.\n", hr, present);
+    present = FALSE;
+    hr = pRoIsApiContractPresent(L"Windows.Foundation.UniversalApiContract", 1, 0, &present);
+    ok(hr == S_OK && present, "Got unexpected hr %#lx, present %d.\n", hr, present);
+}
+
