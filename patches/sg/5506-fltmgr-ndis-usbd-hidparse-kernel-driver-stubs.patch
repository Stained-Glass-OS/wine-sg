+static void test_hid_delimiters(void)
+{
+    /* Each descriptor has one input item of two 8-bit fields. */
+    static UCHAR set_of_usages[] =
+    {
+        0x05, 0x01,             /* USAGE_PAGE (Generic Desktop) */
+        0x09, 0x02,             /* USAGE (Mouse) */
+        0xa1, 0x01,             /* COLLECTION (Application) */
+        0xa9, 0x01,             /*   DELIMITER (open) */
+        0x09, 0x30,             /*     USAGE (X) */
+        0x09, 0x31,             /*     USAGE (Y) */
+        0xa9, 0x00,             /*   DELIMITER (close) */
+        0x15, 0x00, 0x25, 0x7f, /*   LOGICAL_MIN 0, MAX 127 */
+        0x75, 0x08, 0x95, 0x02, /*   REPORT_SIZE 8, REPORT_COUNT 2 */
+        0x81, 0x02,             /*   INPUT (Data,Var,Abs) */
+        0xc0,                   /* END_COLLECTION */
+    };
+    static UCHAR set_of_ranges[] =
+    {
+        0x05, 0x09,             /* USAGE_PAGE (Button) */
+        0x09, 0x01,             /* USAGE (Button 1) */
+        0xa1, 0x01,             /* COLLECTION (Application) */
+        0xa9, 0x01,             /*   DELIMITER (open) */
+        0x19, 0x01,             /*     USAGE_MINIMUM (1) */
+        0x29, 0x02,             /*     USAGE_MAXIMUM (2) */
+        0x19, 0x05,             /*     USAGE_MINIMUM (5) */
+        0x29, 0x06,             /*     USAGE_MAXIMUM (6) */
+        0xa9, 0x00,             /*   DELIMITER (close) */
+        0x15, 0x00, 0x25, 0x01, /*   LOGICAL_MIN 0, MAX 1 */
+        0x75, 0x01, 0x95, 0x02, /*   REPORT_SIZE 1, REPORT_COUNT 2 */
+        0x81, 0x02,             /*   INPUT (Data,Var,Abs) */
+        0xc0,                   /* END_COLLECTION */
+    };
+    static UCHAR outside_a_set[] =
+    {
+        0x05, 0x01, 0x09, 0x02, 0xa1, 0x01,
+        0xa9, 0x01, 0x09, 0x30, 0xa9, 0x00,     /* a set with X ... */
+        0x09, 0x31,                             /* ... then Y on its own */
+        0x15, 0x00, 0x25, 0x7f, 0x75, 0x08, 0x95, 0x02, 0x81, 0x02,
+        0xc0,
+    };
+    HIDP_VALUE_CAPS caps[4];
+    HIDP_BUTTON_CAPS buttons[4];
+    HIDP_DEVICE_DESC desc;
+    NTSTATUS status;
+    USHORT count;
+
+    status = HidP_GetCollectionDescription(set_of_usages, sizeof(set_of_usages), PagedPool, &desc);
+    ok(status == HIDP_STATUS_SUCCESS, "HidP_GetCollectionDescription returned %#lx\n", status);
+    if (status == HIDP_STATUS_SUCCESS)
+    {
+        count = ARRAY_SIZE(caps);
+        status = HidP_GetValueCaps(HidP_Input, caps, &count, desc.CollectionDesc[0].PreparsedData);
+        ok(status == HIDP_STATUS_SUCCESS, "HidP_GetValueCaps returned %#lx\n", status);
+        ok(count == 1, "got %u value caps, expected the one alternative\n", count);
+        if (count)
+        {
+            ok(caps[0].UsagePage == HID_USAGE_PAGE_GENERIC, "got page %#x\n", caps[0].UsagePage);
+            ok(!caps[0].IsRange && caps[0].NotRange.Usage == HID_USAGE_GENERIC_X, "got usage %#x\n",
+               caps[0].NotRange.Usage);
+            ok(caps[0].ReportCount == 2, "got count %u\n", caps[0].ReportCount);
+        }
+        HidP_FreeCollectionDescription(&desc);
+    }
+
+    status = HidP_GetCollectionDescription(set_of_ranges, sizeof(set_of_ranges), PagedPool, &desc);
+    ok(status == HIDP_STATUS_SUCCESS, "HidP_GetCollectionDescription returned %#lx\n", status);
+    if (status == HIDP_STATUS_SUCCESS)
+    {
+        count = ARRAY_SIZE(buttons);
+        status = HidP_GetButtonCaps(HidP_Input, buttons, &count, desc.CollectionDesc[0].PreparsedData);
+        ok(status == HIDP_STATUS_SUCCESS, "HidP_GetButtonCaps returned %#lx\n", status);
+        ok(count == 1, "got %u button caps\n", count);
+        if (count)
+        {
+            ok(buttons[0].IsRange, "not a range\n");
+            ok(buttons[0].Range.UsageMin == 1 && buttons[0].Range.UsageMax == 2, "got range %u-%u\n",
+               buttons[0].Range.UsageMin, buttons[0].Range.UsageMax);
+        }
+        HidP_FreeCollectionDescription(&desc);
+    }
+
+    status = HidP_GetCollectionDescription(outside_a_set, sizeof(outside_a_set), PagedPool, &desc);
+    ok(status == HIDP_STATUS_SUCCESS, "HidP_GetCollectionDescription returned %#lx\n", status);
+    if (status == HIDP_STATUS_SUCCESS)
+    {
+        count = ARRAY_SIZE(caps);
+        status = HidP_GetValueCaps(HidP_Input, caps, &count, desc.CollectionDesc[0].PreparsedData);
+        ok(status == HIDP_STATUS_SUCCESS, "HidP_GetValueCaps returned %#lx\n", status);
+        ok(count == 2, "got %u value caps\n", count);
+        if (count == 2)
+            ok(caps[0].NotRange.Usage == HID_USAGE_GENERIC_Y || caps[1].NotRange.Usage == HID_USAGE_GENERIC_Y,
+               "usage after the set was lost\n");
+        HidP_FreeCollectionDescription(&desc);
+    }
+}
