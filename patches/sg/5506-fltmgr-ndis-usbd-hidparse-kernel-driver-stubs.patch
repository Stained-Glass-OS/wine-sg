+/* The push lock is opaque to callers (pointer sized, pointer aligned). Bit 0 is
+ * set while it is held exclusively; the other bits count the shared holders. */
+struct _EX_PUSH_LOCK
+{
+    volatile ULONG_PTR value;
+};
+
+#define PUSH_LOCK_EXCLUSIVE 1
+#define PUSH_LOCK_SHARED    2
+
 void WINAPI FltInitializePushLock( EX_PUSH_LOCK *lock )
 {
-    FIXME( "(%p): stub\n", lock );
+    TRACE( "(%p)\n", lock );
+
+    lock->value = 0;
 }
 
 void WINAPI FltDeletePushLock( EX_PUSH_LOCK *lock )
 {
-    FIXME( "(%p): stub\n", lock );
+    TRACE( "(%p)\n", lock );
 }
 
 void WINAPI FltAcquirePushLockExclusive( EX_PUSH_LOCK *lock )
 {
-    FIXME( "(%p): stub\n", lock );
+    TRACE( "(%p)\n", lock );
+
+    for (;;)
+    {
+        ULONG_PTR value = lock->value;
+
+#ifdef SG_MUTANT_PL_NOWAIT
+        if (1) { lock->value = PUSH_LOCK_EXCLUSIVE; return; }
+#endif
+        if (!value && InterlockedCompareExchangePointer( (void **)&lock->value, (void *)PUSH_LOCK_EXCLUSIVE, NULL ) == NULL)
+            return;
+        RtlWaitOnAddress( (void *)&lock->value, &value, sizeof(value), NULL );
+    }
 }
 
-void WINAPI FltReleasePushLock( EX_PUSH_LOCK *lock )
+void WINAPI FltAcquirePushLockShared( EX_PUSH_LOCK *lock )
 {
-    FIXME( "(%p): stub\n", lock );
+    TRACE( "(%p)\n", lock );
+
+    for (;;)
+    {
+        ULONG_PTR value = lock->value;
+
+#ifdef SG_MUTANT_PL_SHAREDEXCL
+        if (1 &&
+#else
+        if (!(value & PUSH_LOCK_EXCLUSIVE) &&
+#endif
+            InterlockedCompareExchangePointer( (void **)&lock->value, (void *)(value + PUSH_LOCK_SHARED),
+                                               (void *)value ) == (void *)value)
+            return;
+        RtlWaitOnAddress( (void *)&lock->value, &value, sizeof(value), NULL );
+    }
 }
 
-NTSTATUS WINAPI FltRegisterFilter( PDRIVER_OBJECT driver, const FLT_REGISTRATION *reg, PFLT_FILTER *filter )
+void WINAPI FltReleasePushLock( EX_PUSH_LOCK *lock )
 {
-    FIXME( "(%p,%p,%p): stub\n", driver, reg, filter );
+    TRACE( "(%p)\n", lock );
+
+    /* One routine releases either kind of hold. */
+    for (;;)
+    {
+        ULONG_PTR value = lock->value, new = (value & PUSH_LOCK_EXCLUSIVE) ? 0 : value - PUSH_LOCK_SHARED;
+
+        if (InterlockedCompareExchangePointer( (void **)&lock->value, (void *)new, (void *)value ) == (void *)value)
+            break;
+    }
+    RtlWakeAddressAll( (void *)&lock->value );
+}
 
-    if(filter)
-        *filter = UlongToHandle(0xdeadbeaf);
+struct _FLT_FILTER
+{
+    DRIVER_OBJECT *driver;
+    LONG started;
+};
 
+NTSTATUS WINAPI FltRegisterFilter( PDRIVER_OBJECT driver, const FLT_REGISTRATION *reg, PFLT_FILTER *ret )
+{
+    struct _FLT_FILTER *filter;
+
+    TRACE( "(%p,%p,%p)\n", driver, reg, ret );
+
+    if (!reg || !ret) return STATUS_INVALID_PARAMETER;
+    if (!(filter = ExAllocatePool( NonPagedPool, sizeof(*filter) ))) return STATUS_INSUFFICIENT_RESOURCES;
+    filter->driver = driver;
+    filter->started = 0;
+    *ret = filter;
+#ifdef SG_MUTANT_FLT_FIXED
+    *ret = UlongToHandle(0xdeadbeaf);
+#endif
+
+    /* There is no I/O stack to attach to: the filter is known to its driver and
+     * never offered a volume or an operation. */
+    WARN( "filter %p: no volumes will be attached, no operations passed to its callbacks\n", filter );
     return STATUS_SUCCESS;
 }
 
 NTSTATUS WINAPI FltStartFiltering( PFLT_FILTER filter )
 {
-    FIXME( "(%p): stub\n", filter );
+    TRACE( "(%p)\n", filter );
 
+    if (!filter) return STATUS_INVALID_PARAMETER;
+    if (InterlockedExchange( &filter->started, 1 )) return STATUS_INVALID_PARAMETER;
     return STATUS_SUCCESS;
 }
 
 void WINAPI FltUnregisterFilter( PFLT_FILTER filter )
 {
-    FIXME( "(%p): stub\n", filter );
+    TRACE( "(%p)\n", filter );
+
+    ExFreePool( filter );
 }
 
