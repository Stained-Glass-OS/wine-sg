--- a/dlls/usbd.sys/usbd.c
+++ b/dlls/usbd.sys/usbd.c
@@ -231,17 +231,80 @@ USBD_STATUS WINAPI USBD_ValidateConfigurationDescriptor(
         PUCHAR *offset,
         ULONG tag )
 {
-    FIXME( "(%p, %lu, %u, %p, %lu) partial stub!\n", descr, length, level, offset, tag );
+    UCHAR *start = (UCHAR *)descr, *pos, *end;
+    int interfaces = 0, last_interface = -1, endpoints_left = 0;
+    BOOL in_interface = FALSE;
+
+    TRACE( "(%p, %lu, %u, %p, %lu)\n", descr, length, level, offset, tag );
 
     if (offset) *offset = 0;
 
-    if (!descr ||
-        length < sizeof(USB_CONFIGURATION_DESCRIPTOR) ||
+    if (level < 1 || level > 3) return USBD_STATUS_INVALID_PARAMETER;
+
+    /* level 1: the header */
+    if (!descr || length < sizeof(USB_CONFIGURATION_DESCRIPTOR) ||
         descr->bLength < sizeof(USB_CONFIGURATION_DESCRIPTOR) ||
-        descr->wTotalLength < descr->bNumInterfaces * sizeof(USB_CONFIGURATION_DESCRIPTOR)
-       ) return USBD_STATUS_ERROR;
+        descr->bDescriptorType != USB_CONFIGURATION_DESCRIPTOR_TYPE ||
+        descr->wTotalLength < descr->bLength || descr->wTotalLength > length)
+    {
+        if (offset) *offset = start;
+        return USBD_STATUS_ERROR;
+    }
+#ifdef SG_MUTANT_USBD_L2_SKIP
+    return USBD_STATUS_SUCCESS;
+#endif
+#ifdef SG_MUTANT_USBD_L3_SKIP
+    if (level == 3) level = 2;
+#endif
+    if (level == 1) return USBD_STATUS_SUCCESS;
+
+    /* level 2: every descriptor in the set */
+    end = start + descr->wTotalLength;
+    for (pos = start + descr->bLength; pos < end; pos += ((USB_COMMON_DESCRIPTOR *)pos)->bLength)
+    {
+        USB_COMMON_DESCRIPTOR *common = (USB_COMMON_DESCRIPTOR *)pos;
+
+        if (end - pos < sizeof(*common) || common->bLength < sizeof(*common) || common->bLength > end - pos)
+            goto failed;
+
+        if (common->bDescriptorType == USB_INTERFACE_DESCRIPTOR_TYPE)
+        {
+            USB_INTERFACE_DESCRIPTOR *iface = (USB_INTERFACE_DESCRIPTOR *)pos;
 
+            if (iface->bLength < sizeof(*iface) || iface->bInterfaceNumber >= descr->bNumInterfaces) goto failed;
+            if (level == 3)
+            {
+                if (iface->bLength != sizeof(*iface) || endpoints_left) goto failed;
+                /* alternate settings repeat a number, new interfaces count up from 0 */
+                if (iface->bInterfaceNumber != last_interface && iface->bInterfaceNumber != last_interface + 1)
+                    goto failed;
+                endpoints_left = iface->bNumEndpoints;
+            }
+            if (iface->bInterfaceNumber != last_interface) interfaces++;
+            last_interface = iface->bInterfaceNumber;
+            in_interface = TRUE;
+        }
+        else if (common->bDescriptorType == USB_ENDPOINT_DESCRIPTOR_TYPE)
+        {
+            USB_ENDPOINT_DESCRIPTOR *ep = (USB_ENDPOINT_DESCRIPTOR *)pos;
+
+            if (!in_interface || ep->bLength < sizeof(*ep) || (ep->bEndpointAddress & 0x70)) goto failed;
+            if (level == 3)
+            {
+                /* audio endpoints carry two more bytes */
+                if (ep->bLength != sizeof(*ep) && ep->bLength != sizeof(*ep) + 2) goto failed;
+                if (!endpoints_left) goto failed;
+                endpoints_left--;
+            }
+        }
+    }
+    if (pos != end || interfaces > descr->bNumInterfaces) goto failed;
+    if (level == 3 && (endpoints_left || interfaces != descr->bNumInterfaces)) goto failed;
     return USBD_STATUS_SUCCESS;
+
+failed:
+    if (offset) *offset = pos < end ? pos : start;
+    return USBD_STATUS_ERROR;
 }
 
