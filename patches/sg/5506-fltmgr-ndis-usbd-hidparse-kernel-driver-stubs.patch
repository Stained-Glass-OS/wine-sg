+/* the real EX_PUSH_LOCK is opaque; fltmgr uses the same pointer-sized storage */
+struct _EX_PUSH_LOCK { ULONG_PTR value; };
+
+static EX_PUSH_LOCK push_lock;
+static LONG push_state;
+
+static void WINAPI push_lock_thread(void *arg)
+{
+    BOOLEAN exclusive = (BOOLEAN)(ULONG_PTR)arg;
+
+    if (exclusive) FltAcquirePushLockExclusive(&push_lock);
+    else FltAcquirePushLockShared(&push_lock);
+    InterlockedIncrement(&push_state);
+    FltReleasePushLock(&push_lock);
+    PsTerminateSystemThread(STATUS_SUCCESS);
+}
+
+static void test_push_lock(void)
+{
+    HANDLE thread;
+    int i;
+
+    FltInitializePushLock(&push_lock);
+    ok(!((struct _EX_PUSH_LOCK *)&push_lock)->value, "initialized lock is not zero\n");
+
+    /* shared holders do not exclude each other */
+    FltAcquirePushLockShared(&push_lock);
+    push_state = 0;
+    thread = create_thread(push_lock_thread, (void *)FALSE);
+    join_thread(thread);
+    ok(push_state == 1, "a second shared holder did not get in\n");
+
+    /* but they keep an exclusive one out until the last has gone */
+    push_state = 0;
+    thread = create_thread(push_lock_thread, (void *)TRUE);
+    for (i = 0; i < 5; i++) sleep();
+    ok(!push_state, "exclusive acquire succeeded under a shared hold\n");
+    FltReleasePushLock(&push_lock);
+    join_thread(thread);
+    ok(push_state == 1, "exclusive acquire did not follow the release\n");
+
+    /* an exclusive holder keeps out both kinds */
+    FltAcquirePushLockExclusive(&push_lock);
+    push_state = 0;
+    thread = create_thread(push_lock_thread, (void *)FALSE);
+    for (i = 0; i < 5; i++) sleep();
+    ok(!push_state, "shared acquire succeeded under an exclusive hold\n");
+    FltReleasePushLock(&push_lock);
+    join_thread(thread);
+    ok(push_state == 1, "shared acquire did not follow the release\n");
+
+    push_state = 0;
+    FltAcquirePushLockExclusive(&push_lock);
+    thread = create_thread(push_lock_thread, (void *)TRUE);
+    for (i = 0; i < 5; i++) sleep();
+    ok(!push_state, "exclusive acquire succeeded under an exclusive hold\n");
+    FltReleasePushLock(&push_lock);
+    join_thread(thread);
+    ok(push_state == 1, "second exclusive acquire did not follow the release\n");
+
+    FltDeletePushLock(&push_lock);
+}
+
+static void test_filter_registration(DRIVER_OBJECT *driver)
+{
+    FLT_REGISTRATION reg = {sizeof(reg), 0x0203};
+    PFLT_FILTER filter1 = NULL, filter2 = NULL;
+    NTSTATUS status;
+
+    status = FltRegisterFilter(driver, &reg, &filter1);
+    ok(!status, "FltRegisterFilter returned %#lx\n", status);
+    if (status) return;
+    ok(filter1 != NULL, "no filter returned\n");
+
+    status = FltRegisterFilter(driver, &reg, &filter2);
+    ok(!status, "second FltRegisterFilter returned %#lx\n", status);
+    ok(filter2 != filter1, "two registrations share filter %p\n", filter1);
+
+    status = FltStartFiltering(filter1);
+    ok(!status, "FltStartFiltering returned %#lx\n", status);
+    status = FltStartFiltering(filter1);
+    ok(status == STATUS_INVALID_PARAMETER, "second FltStartFiltering returned %#lx\n", status);
+    status = FltStartFiltering(filter2);
+    ok(!status, "FltStartFiltering of the other filter returned %#lx\n", status);
+
+    FltUnregisterFilter(filter1);
+    FltUnregisterFilter(filter2);
+}
+
+static NDIS_SPIN_LOCK ndis_lock;
+
+static void WINAPI ndis_lock_thread(void *arg)
+{
+    NdisAcquireSpinLock(&ndis_lock);
+    InterlockedIncrement(&push_state);
+    NdisReleaseSpinLock(&ndis_lock);
+    PsTerminateSystemThread(STATUS_SUCCESS);
+}
+
+static void test_ndis_memory_and_locks(void)
+{
+    NDIS_STATUS status;
+    unsigned char *buffer = NULL;
+    HANDLE thread;
+    int i;
+
+    status = NdisAllocateMemoryWithTag((void **)&buffer, 128, 0x74736554);
+    ok(status == NDIS_STATUS_SUCCESS, "NdisAllocateMemoryWithTag returned %#x\n", status);
+    ok(buffer != NULL, "no memory returned\n");
+    if (buffer)
+    {
+        memset(buffer, 0xa5, 128);
+        NdisFreeMemory(buffer, 128, 0);
+    }
+
+    NdisAllocateSpinLock(&ndis_lock);
+    NdisAcquireSpinLock(&ndis_lock);
+    push_state = 0;
+    thread = create_thread(ndis_lock_thread, NULL);
+    for (i = 0; i < 5; i++) sleep();
+    ok(!push_state, "second NdisAcquireSpinLock succeeded while the lock was held\n");
+    NdisReleaseSpinLock(&ndis_lock);
+    join_thread(thread);
+    ok(push_state == 1, "NdisAcquireSpinLock did not follow the release\n");
+    NdisFreeSpinLock(&ndis_lock);
+}
+
+static void test_usb_config_validation(void)
+{
+    static const UCHAR good[] =
+    {
+        9, 2, 32, 0, 1, 1, 0, 0x80, 50,         /* configuration: 1 interface */
+        9, 4, 0, 0, 2, 0xff, 0, 0, 0,           /* interface 0, 2 endpoints */
+        7, 5, 0x81, 3, 8, 0, 10,                /* endpoint */
+        7, 5, 0x02, 2, 64, 0, 0,                /* endpoint */
+    };
+    USB_CONFIGURATION_DESCRIPTOR *config;
+    UCHAR buffer[sizeof(good)];
+    USBD_STATUS ret;
+    PUCHAR offset;
+
+    config = (USB_CONFIGURATION_DESCRIPTOR *)buffer;
+
+    memcpy(buffer, good, sizeof(good));
+    offset = (PUCHAR)0xdead;
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 1, &offset, 0);
+    ok(ret == USBD_STATUS_SUCCESS, "level 1: got %#lx\n", ret);
+    ok(!offset, "offset %p on success\n", offset);
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 2, &offset, 0);
+    ok(ret == USBD_STATUS_SUCCESS, "level 2: got %#lx\n", ret);
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 3, &offset, 0);
+    ok(ret == USBD_STATUS_SUCCESS, "level 3: got %#lx\n", ret);
+
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 0, &offset, 0);
+    ok(ret == USBD_STATUS_INVALID_PARAMETER, "level 0: got %#lx\n", ret);
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 4, &offset, 0);
+    ok(ret == USBD_STATUS_INVALID_PARAMETER, "level 4: got %#lx\n", ret);
+
+    /* level 1: the header */
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good) - 1, 1, &offset, 0);
+    ok(ret != USBD_STATUS_SUCCESS, "total length beyond the buffer passed\n");
+    ret = USBD_ValidateConfigurationDescriptor(config, 4, 1, &offset, 0);
+    ok(ret != USBD_STATUS_SUCCESS, "buffer smaller than a header passed\n");
+    buffer[1] = 4;
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 1, &offset, 0);
+    ok(ret != USBD_STATUS_SUCCESS, "wrong descriptor type passed\n");
+    memcpy(buffer, good, sizeof(good));
+
+    /* level 2: reserved bits of an endpoint address; passes level 1 */
+    buffer[18 + 2] = 0x91;
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 1, &offset, 0);
+    ok(ret == USBD_STATUS_SUCCESS, "level 1: got %#lx\n", ret);
+    offset = NULL;
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 2, &offset, 0);
+    ok(ret != USBD_STATUS_SUCCESS, "reserved endpoint address bits passed level 2\n");
+    ok(offset == buffer + 18, "offset %p, expected %p\n", offset, buffer + 18);
+    memcpy(buffer, good, sizeof(good));
+
+    /* an interface number the configuration does not have */
+    buffer[9 + 2] = 1;
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 2, &offset, 0);
+    ok(ret != USBD_STATUS_SUCCESS, "interface number 1 of 1 passed level 2\n");
+    memcpy(buffer, good, sizeof(good));
+
+    /* a descriptor running past the end */
+    buffer[25] = 20;
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 2, &offset, 0);
+    ok(ret != USBD_STATUS_SUCCESS, "descriptor past the end passed level 2\n");
+    memcpy(buffer, good, sizeof(good));
+
+    /* a descriptor that cannot be stepped over */
+    buffer[18] = 0;
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 2, &offset, 0);
+    ok(ret != USBD_STATUS_SUCCESS, "zero bLength passed level 2\n");
+    memcpy(buffer, good, sizeof(good));
+
+    /* level 3: the interface promises three endpoints and has two */
+    buffer[9 + 4] = 3;
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 2, &offset, 0);
+    ok(ret == USBD_STATUS_SUCCESS, "level 2 with a wrong endpoint count: got %#lx\n", ret);
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 3, &offset, 0);
+    ok(ret != USBD_STATUS_SUCCESS, "wrong endpoint count passed level 3\n");
+    memcpy(buffer, good, sizeof(good));
+
+    /* an interface descriptor padded beyond the specified size */
+    {
+        UCHAR padded[sizeof(good) + 1];
+
+        memcpy(padded, good, 9 + 9);
+        padded[18] = 0;
+        memcpy(padded + 19, good + 18, sizeof(good) - 18);
+        padded[2] = sizeof(padded);
+        padded[9] = 10;
+        ret = USBD_ValidateConfigurationDescriptor((USB_CONFIGURATION_DESCRIPTOR *)padded, sizeof(padded), 2, &offset, 0);
+        ok(ret == USBD_STATUS_SUCCESS, "padded interface at level 2: got %#lx\n", ret);
+        ret = USBD_ValidateConfigurationDescriptor((USB_CONFIGURATION_DESCRIPTOR *)padded, sizeof(padded), 3, &offset, 0);
+        ok(ret != USBD_STATUS_SUCCESS, "padded interface passed level 3\n");
+    }
+
+    /* the configuration promises two interfaces and has one */
+    buffer[4] = 2;
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 2, &offset, 0);
+    ok(ret == USBD_STATUS_SUCCESS, "level 2 with a missing interface: got %#lx\n", ret);
+    ret = USBD_ValidateConfigurationDescriptor(config, sizeof(good), 3, &offset, 0);
+    ok(ret != USBD_STATUS_SUCCESS, "missing interface passed level 3\n");
+}
