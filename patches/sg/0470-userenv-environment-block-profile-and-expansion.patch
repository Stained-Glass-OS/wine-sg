From: Stained Glass OS contributors
Subject: userenv: an environment block's USERPROFILE and TEMP, as Windows makes them

CreateEnvironmentBlock set USERPROFILE to "<profiles>\<account name>" -- for
SYSTEM, C:\users\SYSTEM, not the profile the ProfileList names -- and a value
read before the variable it names was defined stayed unexpanded. With a
Default User template (TEMP=%USERPROFILE%\AppData\Local\Temp) the block
services.exe gives every service had TEMP "%USERPROFILE%\AppData\Local\Temp",
a relative path: Office's Click-to-Run service exited at start and Microsoft
365 setup failed with 30068-44 (1053). USERPROFILE is now the ProfileList's
ProfileImagePath for the token's SID when there is one, and a last pass
expands any value still naming a variable.

--- a/dlls/userenv/userenv_main.c
+++ b/dlls/userenv/userenv_main.c
@@ -307,6 +307,21 @@
             if (len) set_env_var(&env, L"USERPROFILE", buf);
         }
 
+        /* Stained Glass OS: the profile is where the ProfileList says it is,
+         * as on Windows (SYSTEM's is not "<profiles>\\SYSTEM") */
+        {
+            HKEY pkey;
+            WCHAR key[128], path[MAX_PATH];
+
+            swprintf(key, ARRAY_SIZE(key), L"%s\\%s", profile_keyW, sidW);
+            if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, key, 0, KEY_READ, &pkey))
+            {
+                if (get_reg_value(env, pkey, L"ProfileImagePath", path, sizeof(path)) && path[0])
+                    set_env_var(&env, L"USERPROFILE", path);
+                RegCloseKey(pkey);
+            }
+        }
+
         HeapFree(GetProcessHeap(), 0, token_user);
         lstrcpyW(buf, sidW);
         LocalFree(sidW);
@@ -330,6 +345,36 @@
         RegCloseKey(hkey);
     }
 
+    /* Stained Glass OS: a value read before the variable it names was
+     * defined (TEMP=%USERPROFILE%\\... from a Default User template) is
+     * expanded now, as Windows' block never holds a literal %USERPROFILE% --
+     * a service's TEMP was "C:\\windows\\%USERPROFILE%\\...", and Office's
+     * Click-to-Run service exited at start */
+    {
+        WCHAR *p, *eq, *copy, expanded[UNICODE_STRING_MAX_CHARS];
+        UNICODE_STRING src, dst, name, value;
+
+        for (p = env; *p; p += lstrlenW(p) + 1)
+        {
+            if (!(eq = wcschr(p + 1, '=')) || !wcschr(eq + 1, '%')) continue;
+            if (!(copy = HeapAlloc(GetProcessHeap(), 0, (lstrlenW(p) + 1) * sizeof(WCHAR)))) break;
+            lstrcpyW(copy, p);
+            copy[eq - p] = 0;
+            RtlInitUnicodeString(&src, copy + (eq - p) + 1);
+            dst.Buffer = expanded;
+            dst.Length = 0;
+            dst.MaximumLength = sizeof(expanded);
+            if (!RtlExpandEnvironmentStrings_U(env, &src, &dst, NULL) && wcscmp(expanded, copy + (eq - p) + 1))
+            {
+                RtlInitUnicodeString(&name, copy);
+                RtlInitUnicodeString(&value, expanded);
+                RtlSetEnvironmentVariable(&env, &name, &value);
+                p = env;   /* the block may have moved: start again */
+            }
+            HeapFree(GetProcessHeap(), 0, copy);
+        }
+    }
+
     *lpEnvironment = env;
     return TRUE;
 }
