From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: a cloaked window is still painted

0067 took a cloaked window off the screen and also out of painting: the
server treated it as hidden for its own update region, so a window cloaked
before it was shown got no WM_NCPAINT and no WM_PAINT. Brave cloaks each new
window in WM_NCCREATE (against a white flash) and uncloaks it in WM_NCPAINT,
so its windows never appeared: the taskbar showed "Welcome to Brave", the
screen nothing. On Windows a cloaked window is painted and composed, only
not shown. Now cloaking decides what a window covers -- it does not clip
other windows or its parent, crop their update regions or take clicks, and
the driver unmaps it -- while its own painting goes by WS_VISIBLE alone.
---
--- a/server/window.c
+++ b/server/window.c
@@ -862,8 +862,11 @@
 }
 
 /* A cloaked window keeps WS_VISIBLE -- the program sees it visible, as with
- * DWM cloaking on Windows (virtual desktops, DWMWA_CLOAK) -- but it is not
- * drawn, does not clip, and is not hit-tested. */
+ * DWM cloaking on Windows (virtual desktops, DWMWA_CLOAK) -- and is painted
+ * as any visible window is, but it is not on the screen (the driver takes it
+ * off): it does not clip other windows or its parent, and is not hit-tested.
+ * So is_shown() is for what a window covers, WS_VISIBLE for its own painting:
+ * Brave cloaks its new windows and uncloaks them in WM_NCPAINT. */
 static inline int is_shown( const struct window *win )
 {
     return (win->style & WS_VISIBLE) && !win->cloaked;
@@ -874,7 +877,7 @@
 {
     while (win)
     {
-        if (!is_shown( win )) return 0;
+        if (!(win->style & WS_VISIBLE)) return 0;
         win = win->parent;
         /* if parent is minimized children are not visible */
         if (win && (win->style & WS_MINIMIZE)) return 0;
@@ -1113,7 +1116,7 @@
 
     LIST_FOR_EACH_ENTRY( ptr, &parent->children, struct window, entry )
     {
-        if (!is_shown( ptr )) continue;
+        if (!(ptr->style & WS_VISIBLE)) continue;
         if (ptr->thread == thread && win_needs_repaint( ptr ))
             ret = ptr;
         else if (!(ptr->style & WS_MINIMIZE)) /* explore its children */
@@ -1126,7 +1129,7 @@
         /* transparent window, check for non-transparent sibling to paint first */
         for (ptr = get_next_window(ret); ptr; ptr = get_next_window(ptr))
         {
-            if (!is_shown( ptr )) continue;
+            if (!(ptr->style & WS_VISIBLE)) continue;
             if (ptr->ex_style & WS_EX_TRANSPARENT) continue;
             if (ptr->thread != thread) continue;
             if (win_needs_repaint( ptr )) return ptr;
@@ -1425,13 +1428,13 @@
 
     *rect = frame ? win->window_rect : win->client_rect;
 
-    if (!is_shown( win )) return 0;
+    if (!(win->style & WS_VISIBLE)) return 0;
     if (is_desktop_window( win )) return 1;
 
     while (!is_desktop_window( win->parent ))
     {
         win = win->parent;
-        if (!is_shown( win ) || win->style & WS_MINIMIZE) return 0;
+        if (!(win->style & WS_VISIBLE) || win->style & WS_MINIMIZE) return 0;
         offset_x += win->client_rect.left;
         offset_y += win->client_rect.top;
         offset_rect( rect, win->client_rect.left, win->client_rect.top );
@@ -1596,7 +1599,7 @@
 
     LIST_FOR_EACH_ENTRY( child, &win->children, struct window, entry )
     {
-        if (!is_shown( child )) continue;
+        if (!(child->style & WS_VISIBLE)) continue;
         validate_children(child);
         validate_whole_window(child);
     }
@@ -1705,7 +1708,7 @@
 
     LIST_FOR_EACH_ENTRY( child, &win->children, struct window, entry )
     {
-        if (!is_shown( child )) continue;
+        if (!(child->style & WS_VISIBLE)) continue;
         if (!(child_rgn = create_empty_region())) continue;
         if (copy_region( child_rgn, tmp ))
         {
@@ -1780,7 +1783,7 @@
             if (ptr == from_child) from_child = NULL;
             continue;
         }
-        if (!is_shown( ptr )) continue;
+        if (!(ptr->style & WS_VISIBLE)) continue;
         if ((ret = get_update_flags( ptr, flags )) != 0)
         {
             *child = ptr;
@@ -1803,7 +1806,7 @@
     if (!is_visible( win )) return 0;
     for (ptr = from_child; ptr; ptr = ptr->parent)
     {
-        if (!is_shown( ptr ) || (ptr->style & WS_MINIMIZE)) from_sibling = ptr;
+        if (!(ptr->style & WS_VISIBLE) || (ptr->style & WS_MINIMIZE)) from_sibling = ptr;
         if (ptr == win) break;
     }
 
@@ -1931,7 +1934,10 @@
     const struct rectangle old_client_rect = win->client_rect;
     struct rectangle rect;
     int client_changed, frame_changed;
-    int visible = is_shown( win ) || (((win->style & WS_VISIBLE) || (swp_flags & SWP_SHOWWINDOW)) && !cloaked);
+    int visible = (win->style & WS_VISIBLE) || (swp_flags & SWP_SHOWWINDOW);
+#ifdef SG_MUTANT_CLOAKNOPAINT
+    if (cloaked) visible = 0;
+#endif
     int zorder_changed = 0;
 
     if (win->parent && !is_visible( win->parent )) visible = 0;
@@ -1977,7 +1983,7 @@
     if (!(swp_flags & SWP_NOREDRAW))
         exposed_rgn = expose_window( win, &old_window_rect, old_vis_rgn, zorder_changed );
 
-    if (!is_shown( win ))
+    if (!(win->style & WS_VISIBLE))
     {
         /* clear the update region since the window is no longer visible */
         validate_whole_window( win );
