From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, user32: shell hook windows (RegisterShellHookWindow, SHELLHOOK messages)

RegisterShellHookWindow and DeregisterShellHookWindow were stubs that
always failed, so task switchers and launchers never heard about
top-level windows.  A registered window is now posted
RegisterWindowMessage("SHELLHOOK") with the HSHELL_* code in wParam for
window created/destroyed, activated (or RUDEAPPACTIVATED when the window
fills the screen), title/redraw, flash, and unhandled app commands; the
same events also reach WH_SHELL hooks.  Registrations are desktop-window
properties (32 slots), so no wineserver protocol or header change;
slots of destroyed windows are pruned on the next event.

---
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -239,13 +239,68 @@ void WINAPI RegisterSystemThread(DWORD flags, DWORD reserved)
     FIXME("(%08lx, %08lx)\n", flags, reserved);
 }
 
+/* The shell hook windows are listed as properties of the desktop window, where
+ * win32u (which posts the SHELLHOOK messages) finds them: slot i is the
+ * property "SgShellHookNN" (NN is i in two hex digits) and "SgShellHookCount"
+ * is how many slots have ever been used (at most SHELL_HOOK_SLOTS).  Keep in step with
+ * shell_hook_notify in win32u's hook.c. */
+#define SHELL_HOOK_SLOTS 32
+static const WCHAR shell_hook_count_prop[] = L"SgShellHookCount";
+
+static void shell_hook_slot_name( WCHAR *buf, UINT i )
+{
+    static const char hex[] = "0123456789abcdef";
+
+    lstrcpyW( buf, L"SgShellHook" );
+    buf[11] = hex[(i >> 4) & 15];
+    buf[12] = hex[i & 15];
+    buf[13] = 0;
+}
+
 /***********************************************************************
  *           RegisterShellHookWindow			[USER32.@]
  */
 BOOL WINAPI RegisterShellHookWindow(HWND hWnd)
 {
-    FIXME("(%p): stub\n", hWnd);
-    return FALSE;
+    UINT i, count, slot = ~0u;
+    WCHAR name[16];
+    HWND desktop, other;
+
+    TRACE("(%p)\n", hWnd);
+
+    if (!IsWindow( hWnd ))
+    {
+        SetLastError( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    desktop = GetDesktopWindow();
+    count = HandleToUlong( GetPropW( desktop, shell_hook_count_prop ));
+    if (count > SHELL_HOOK_SLOTS) count = SHELL_HOOK_SLOTS;
+    for (i = 0; i < count; i++)
+    {
+        shell_hook_slot_name( name, i );
+        other = GetPropW( desktop, name );
+        if (other == hWnd) return TRUE;  /* already registered */
+        if (other && !IsWindow( other ))
+        {
+            RemovePropW( desktop, name );
+            other = NULL;
+        }
+        if (!other && slot == ~0u) slot = i;
+    }
+    if (slot == ~0u)
+    {
+        if (count >= SHELL_HOOK_SLOTS)
+        {
+            SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+            return FALSE;
+        }
+        slot = count;
+    }
+    shell_hook_slot_name( name, slot );
+    if (!SetPropW( desktop, name, hWnd )) return FALSE;
+    if (slot >= count && !SetPropW( desktop, shell_hook_count_prop, ULongToHandle( slot + 1 ))) return FALSE;
+    return TRUE;
 }
 
 
@@ -254,7 +309,21 @@ BOOL WINAPI RegisterShellHookWindow(HWND hWnd)
  */
 BOOL WINAPI DeregisterShellHookWindow(HWND hWnd)
 {
-    FIXME("(%p): stub\n", hWnd);
+    HWND desktop = GetDesktopWindow();
+    UINT i, count = HandleToUlong( GetPropW( desktop, shell_hook_count_prop ));
+    WCHAR name[16];
+
+    TRACE("(%p)\n", hWnd);
+
+    if (count > SHELL_HOOK_SLOTS) count = SHELL_HOOK_SLOTS;
+    for (i = 0; i < count; i++)
+    {
+        shell_hook_slot_name( name, i );
+        if (GetPropW( desktop, name ) != hWnd) continue;
+        RemovePropW( desktop, name );
+        return TRUE;
+    }
+    SetLastError( ERROR_INVALID_WINDOW_HANDLE );
     return FALSE;
 }
 
