+++ b/dlls/win32u/window.c
@@ -5190,6 +5190,20 @@ BOOL WINAPI NtUserFlashWindowEx( FLASHWINFO *info )
     }
     FIXME( "%p - semi-stub\n", info );
 
+    /* the shell flashes the taskbar button of a window that is not in front,
