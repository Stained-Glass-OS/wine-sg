+/***********************************************************************
+ * Stained Glass OS 2207: shell hook windows (RegisterShellHookWindow)
+ *
+ * A program that registers a window here is posted a "SHELLHOOK" message
+ * for the same events a WH_SHELL hook sees: wParam is the HSHELL_* code,
+ * lParam the window it is about.  The registrations are kept on the
+ * desktop window, which the wineserver owns, so every process on the
+ * desktop sees them and a process that dies leaves nothing but a slot
+ * whose window no longer exists.  user32 keeps the same names (shell hook
+ * slot i is the property "SgShellHookNN", NN two hex digits of i, the
+ * high-water mark of used slots is the property "SgShellHookCount").
+ */
+#define SHELL_HOOK_SLOTS 32
+
+static void shell_hook_slot_name( WCHAR *buf, UINT i )
+{
+    static const WCHAR prefixW[] = { 'S','g','S','h','e','l','l','H','o','o','k' };
+    static const char hex[] = "0123456789abcdef";
+
+    memcpy( buf, prefixW, sizeof(prefixW) );
+    buf[ARRAYSIZE(prefixW)] = hex[(i >> 4) & 15];
+    buf[ARRAYSIZE(prefixW) + 1] = hex[i & 15];
+    buf[ARRAYSIZE(prefixW) + 2] = 0;
+}
+
+/* post a shell event to the registered shell hook windows; WH_SHELL hooks
+ * are called by the callers, which know what their wParam and lParam are */
+void shell_hook_notify( UINT code, HWND hwnd, LPARAM lparam )
+{
+    static const WCHAR countW[] = { 'S','g','S','h','e','l','l','H','o','o','k','C','o','u','n','t',0 };
+    static const WCHAR messageW[] = { 'S','H','E','L','L','H','O','O','K' };
+    static UINT message;
+    HWND desktop = get_desktop_window();
+    WCHAR name[16];
+    UINT i, count;
+    HWND target;
+
+    if (!desktop) return;
+    count = HandleToUlong( NtUserGetProp( desktop, countW ));
+    if (!count) return;
+    if (count > SHELL_HOOK_SLOTS) count = SHELL_HOOK_SLOTS;
+    if (!message)
+    {
+        RTL_ATOM atom;
+        if (NtAddAtom( messageW, sizeof(messageW), &atom )) return;
+        message = atom;
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        shell_hook_slot_name( name, i );
+        if (!(target = NtUserGetProp( desktop, name ))) continue;
+        if (!is_window( target ))
+        {
+#ifndef SG_MUTANT_NO_SHELL_PRUNE
+            NtUserRemoveProp( desktop, name );
+#endif
+            continue;
+        }
+        if (target == hwnd && code == HSHELL_WINDOWDESTROYED)
+        {
+            /* a registered window going away takes its registration with it */
+#ifndef SG_MUTANT_NO_SHELL_PRUNE
+            NtUserRemoveProp( desktop, name );
+#endif
+            continue;
+        }
+#ifndef SG_MUTANT_NO_SHELL_POST
+        NtUserPostMessage( target, message, code, lparam );
+#endif
+    }
+}
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -1931,6 +1931,35 @@ static HWND set_focus_window( HWND hwnd )
 /*******************************************************************
  *		set_active_window
  */
+/* Stained Glass OS 2207: the shell learns which window is active, as
+ * HSHELL_WINDOWACTIVATED (the taskbar entry the activated window belongs to,
+ * so a dialog counts for its root owner), or HSHELL_RUDEAPPACTIVATED when
+ * that window fills the screen; 0 when nothing is active any more */
+static void shell_activation_notify( HWND hwnd )
+{
+    HWND top = hwnd ? NtUserGetAncestor( hwnd, GA_ROOTOWNER ) : 0;
+    UINT code = HSHELL_WINDOWACTIVATED;
+    DWORD style;
+    UINT dpi;
+    RECT rect;
+
+    if (top == get_desktop_window()) top = 0;
+    if (top)
+    {
+        style = NtUserGetWindowLongW( top, GWL_STYLE );
+        dpi = get_dpi_for_window( top );
+        if ((style & WS_VISIBLE) && !((style & WS_MAXIMIZE) && (style & WS_CAPTION) == WS_CAPTION) &&
+            get_window_rect( top, &rect, dpi ) && is_window_rect_full_screen( &rect, dpi ))
+        {
+#ifndef SG_MUTANT_NO_SHELL_RUDE
+            code = HSHELL_RUDEAPPACTIVATED;
+#endif
+        }
+    }
+    call_hooks( WH_SHELL, code, (WPARAM)top, 0, 0 );
+    shell_hook_notify( code, top, (LPARAM)top );
+}
+
 BOOL set_active_window( HWND hwnd, HWND *prev, BOOL mouse, BOOL focus, DWORD new_active_thread_id )
 {
     HWND previous = get_active_window();
@@ -2033,6 +2062,8 @@ BOOL set_active_window( HWND hwnd, HWND *prev, BOOL mouse, BOOL focus, DWORD new
         }
     }
 
+    shell_activation_notify( hwnd );
+
 done:
     if (hwnd) clip_fullscreen_window( hwnd, FALSE );
     return TRUE;
