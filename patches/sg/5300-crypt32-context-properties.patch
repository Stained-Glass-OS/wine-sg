+}
+
+static void check_blob_properties(const char *what, BOOL (WINAPI *set_prop)(const void *, DWORD, DWORD, const void *),
+        BOOL (WINAPI *get_prop)(const void *, DWORD, void *, DWORD *), const void *context,
+        const DWORD *ids, unsigned int count)
+{
+    static const BYTE data[] = { 1, 2, 3, 4, 5 };
+    CRYPT_DATA_BLOB blob = { sizeof(data), (BYTE *)data };
+    unsigned int i;
