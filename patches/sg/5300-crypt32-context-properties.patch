From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: documented context properties of certificates, CRLs and CTLs

crypt32: properties the documentation of CertSetCertificateContextProperty,
CertSetCRLContextProperty and CertSetCTLContextProperty gives a
CRYPT_DATA_BLOB (or a DWORD) failed with a "stub" FIXME: the archive flag,
the archived key hash, CA disable CRL, the OCSP and subject access
information, the smart card properties, the signing and public key length
strings and so on. They are kept now and read back as set, a NULL removes
them. The user-defined range (CERT_FIRST_USER_PROP_ID to CERT_LAST_USER_PROP_ID)
works for CRLs and CTLs as it already did for certificates. The properties
documented as reserved still fail.
---
--- a/dlls/crypt32/cert.c
+++ b/dlls/crypt32/cert.c
@@ -749,6 +749,24 @@ static BOOL CertContext_SetProperty(cert_t *cert, DWORD dwPropId,
         case CERT_CROSS_CERT_DIST_POINTS_PROP_ID:
         case CERT_OCSP_RESPONSE_PROP_ID:
         case CERT_RENEWAL_PROP_ID:
+#ifndef SG_MUTANT_PROP_BLOB
+        /* the other properties the documentation of CertSetCertificateContextProperty
+         * gives a CRYPT_DATA_BLOB (or CRYPT_HASH_BLOB) to */
+        case CERT_ARCHIVED_KEY_HASH_PROP_ID:
+        case CERT_ARCHIVED_PROP_ID:
+        case CERT_CA_DISABLE_CRL_PROP_ID:
+        case CERT_CA_OCSP_AUTHORITY_INFO_ACCESS_PROP_ID:
+        case CERT_ISSUER_SERIAL_NUMBER_MD5_HASH_PROP_ID:
+        case CERT_PUB_KEY_CNG_ALG_BIT_LENGTH_PROP_ID:
+        case CERT_REQUEST_ORIGINATOR_PROP_ID:
+        case CERT_ROOT_PROGRAM_CERT_POLICIES_PROP_ID:
+        case CERT_ROOT_PROGRAM_NAME_CONSTRAINTS_PROP_ID:
+        case CERT_SIGN_HASH_CNG_ALG_PROP_ID:
+        case CERT_SMART_CARD_DATA_PROP_ID:
+        case CERT_SMART_CARD_ROOT_INFO_PROP_ID:
+        case CERT_SUBJECT_INFO_ACCESS_PROP_ID:
+        case CERT_SUBJECT_PUB_KEY_BIT_LENGTH_PROP_ID:
+#endif
         {
             if (pvData)
             {
@@ -764,6 +782,16 @@ static BOOL CertContext_SetProperty(cert_t *cert, DWORD dwPropId,
             }
             break;
         }
+        case CERT_KEY_SPEC_PROP_ID:
+            if (pvData)
+                ret = ContextPropertyList_SetProperty(cert->base.properties, dwPropId,
+                 pvData, sizeof(DWORD));
+            else
+            {
+                ContextPropertyList_RemoveProperty(cert->base.properties, dwPropId);
+                ret = TRUE;
+            }
+            break;
         case CERT_DATE_STAMP_PROP_ID:
             if (pvData)
                 ret = ContextPropertyList_SetProperty(cert->base.properties, dwPropId,
--- a/dlls/crypt32/crl.c
+++ b/dlls/crypt32/crl.c
@@ -617,6 +617,14 @@ static BOOL CRLContext_SetProperty(crl_t *crl, DWORD dwPropId,
         ContextPropertyList_RemoveProperty(crl->base.properties, dwPropId);
         ret = TRUE;
     }
+#ifndef SG_MUTANT_PROP_USER
+    else if (dwPropId >= CERT_FIRST_USER_PROP_ID && dwPropId <= CERT_LAST_USER_PROP_ID)
+    {
+        const CRYPT_DATA_BLOB *blob = pvData;
+
+        ret = ContextPropertyList_SetProperty(crl->base.properties, dwPropId, blob->pbData, blob->cbData);
+    }
+#endif
     else
     {
         switch (dwPropId)
@@ -637,6 +645,11 @@ static BOOL CRLContext_SetProperty(crl_t *crl, DWORD dwPropId,
         case CERT_SUBJECT_PUBLIC_KEY_MD5_HASH_PROP_ID:
         case CERT_ENROLLMENT_PROP_ID:
         case CERT_CROSS_CERT_DIST_POINTS_PROP_ID:
+        case CERT_ARCHIVED_PROP_ID:
+        case CERT_ISSUER_CHAIN_PUB_KEY_CNG_ALG_BIT_LENGTH_PROP_ID:
+        case CERT_ISSUER_CHAIN_SIGN_HASH_CNG_ALG_PROP_ID:
+        case CERT_ISSUER_PUB_KEY_BIT_LENGTH_PROP_ID:
+        case CERT_SIGN_HASH_CNG_ALG_PROP_ID:
         case CERT_RENEWAL_PROP_ID:
         {
             PCRYPT_DATA_BLOB blob = (PCRYPT_DATA_BLOB)pvData;
--- a/dlls/crypt32/crypt32_private.h
+++ b/dlls/crypt32/crypt32_private.h
@@ -22,6 +22,17 @@
 #include "wine/list.h"
 #include "wine/unixlib.h"
 
+/* property ids the documentation of CertSetCertificateContextProperty and the CRL
+ * and CTL variants lists, which include/wincrypt.h does not define yet */
+#ifndef CERT_SIGN_HASH_CNG_ALG_PROP_ID
+#define CERT_SIGN_HASH_CNG_ALG_PROP_ID                          89
+#define CERT_SUBJECT_PUB_KEY_BIT_LENGTH_PROP_ID                 92
+#define CERT_PUB_KEY_CNG_ALG_BIT_LENGTH_PROP_ID                 93
+#define CERT_ISSUER_PUB_KEY_BIT_LENGTH_PROP_ID                  94
+#define CERT_ISSUER_CHAIN_SIGN_HASH_CNG_ALG_PROP_ID             95
+#define CERT_ISSUER_CHAIN_PUB_KEY_CNG_ALG_BIT_LENGTH_PROP_ID    96
+#endif
+
 BOOL CNG_ImportPubKey(CERT_PUBLIC_KEY_INFO *pubKeyInfo, BCRYPT_KEY_HANDLE *key);
 BOOL cng_prepare_signature(const char *alg_oid, BYTE *encoded_sig, DWORD encoded_sig_len,
     BYTE **sig_value, DWORD *sig_len);
--- a/dlls/crypt32/ctl.c
+++ b/dlls/crypt32/ctl.c
@@ -782,6 +782,14 @@ static BOOL CTLContext_SetProperty(ctl_t *ctl, DWORD dwPropId,
         ContextPropertyList_RemoveProperty(ctl->base.properties, dwPropId);
         ret = TRUE;
     }
+#ifndef SG_MUTANT_PROP_USER
+    else if (dwPropId >= CERT_FIRST_USER_PROP_ID && dwPropId <= CERT_LAST_USER_PROP_ID)
+    {
+        const CRYPT_DATA_BLOB *blob = pvData;
+
+        ret = ContextPropertyList_SetProperty(ctl->base.properties, dwPropId, blob->pbData, blob->cbData);
+    }
+#endif
     else
     {
         switch (dwPropId)
@@ -802,6 +810,7 @@ static BOOL CTLContext_SetProperty(ctl_t *ctl, DWORD dwPropId,
         case CERT_SUBJECT_PUBLIC_KEY_MD5_HASH_PROP_ID:
         case CERT_ENROLLMENT_PROP_ID:
         case CERT_CROSS_CERT_DIST_POINTS_PROP_ID:
+        case CERT_ARCHIVED_PROP_ID:
         case CERT_RENEWAL_PROP_ID:
         {
             PCRYPT_DATA_BLOB blob = (PCRYPT_DATA_BLOB)pvData;
--- a/dlls/crypt32/tests/cert.c
+++ b/dlls/crypt32/tests/cert.c
@@ -360,6 +360,55 @@ static const BYTE selfSignedCert[] = {
 static const BYTE selfSignedSignatureHash[] = { 0x07,0x5a,0x3e,0xfd,0x0d,0xf6,
  0x88,0xeb,0x00,0x64,0xbd,0xc9,0xd6,0xea,0x0a,0x7c,0xcc,0x24,0xdb,0x5d };
 
+static BOOL WINAPI set_cert_prop(const void *context, DWORD id, DWORD flags, const void *data)
+{
+    return CertSetCertificateContextProperty(context, id, flags, data);
+}
+
+static BOOL WINAPI get_cert_prop(const void *context, DWORD id, void *data, DWORD *size)
+{
+    return CertGetCertificateContextProperty(context, id, data, size);
+}
+
+static void check_blob_properties(const char *what, BOOL (WINAPI *set_prop)(const void *, DWORD, DWORD, const void *),
+        BOOL (WINAPI *get_prop)(const void *, DWORD, void *, DWORD *), const void *context,
+        const DWORD *ids, unsigned int count)
+{
+    static const BYTE data[] = { 1, 2, 3, 4, 5 };
+    CRYPT_DATA_BLOB blob = { sizeof(data), (BYTE *)data };
+    unsigned int i;
+
+    for (i = 0; i < count; ++i)
+    {
+        BYTE buf[16];
+        DWORD size;
+        BOOL ret;
+
+        SetLastError(0xdeadbeef);
+        ret = set_prop(context, ids[i], 0, &blob);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
+        if (!ret) continue;
+
+        size = 0;
+        ret = get_prop(context, ids[i], NULL, &size);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
+        ok(size == sizeof(data), "%s property %lu: got size %lu.\n", what, ids[i], size);
+        memset(buf, 0xcc, sizeof(buf));
+        size = sizeof(buf);
+        ret = get_prop(context, ids[i], buf, &size);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
+        ok(size == sizeof(data) && !memcmp(buf, data, sizeof(data)), "%s property %lu: unexpected value.\n", what, ids[i]);
+
+        ret = set_prop(context, ids[i], 0, NULL);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
+        size = 0;
+        SetLastError(0xdeadbeef);
+        ret = get_prop(context, ids[i], NULL, &size);
+        ok(!ret && GetLastError() == CRYPT_E_NOT_FOUND, "%s property %lu: got ret %d, error %#lx.\n",
+                what, ids[i], ret, GetLastError());
+    }
+}
+
 static void testCertProperties(void)
 {
     PCCERT_CONTEXT context = CertCreateCertificateContext(X509_ASN_ENCODING,
@@ -586,6 +635,34 @@ static void testCertProperties(void)
     ok(size == sizeof(value), "got size %lu.\n", size);
     ok(value == 1, "got value %u.\n", value);
 
+    /* the documented properties that hold a CRYPT_DATA_BLOB */
+    {
+        static const DWORD ids[] =
+        {
+            CERT_FIRST_USER_PROP_ID + 1, CERT_ARCHIVED_PROP_ID, CERT_ARCHIVED_KEY_HASH_PROP_ID,
+            CERT_CA_DISABLE_CRL_PROP_ID, CERT_CA_OCSP_AUTHORITY_INFO_ACCESS_PROP_ID,
+            CERT_REQUEST_ORIGINATOR_PROP_ID,
+            CERT_ROOT_PROGRAM_CERT_POLICIES_PROP_ID, CERT_ROOT_PROGRAM_NAME_CONSTRAINTS_PROP_ID,
+            CERT_SMART_CARD_DATA_PROP_ID, CERT_SMART_CARD_ROOT_INFO_PROP_ID, CERT_SUBJECT_INFO_ACCESS_PROP_ID,
+            89 /* CERT_SIGN_HASH_CNG_ALG_PROP_ID */, 92 /* CERT_SUBJECT_PUB_KEY_BIT_LENGTH_PROP_ID */,
+            93 /* CERT_PUB_KEY_CNG_ALG_BIT_LENGTH_PROP_ID */,
+        };
+        DWORD spec = AT_SIGNATURE;
+
+        check_blob_properties("certificate", set_cert_prop, get_cert_prop, context, ids, ARRAY_SIZE(ids));
+
+        /* the key specification is a DWORD */
+        ret = CertSetCertificateContextProperty(context, CERT_KEY_SPEC_PROP_ID, 0, &spec);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        spec = 0xdeadbeef;
+        size = sizeof(spec);
+        ret = CertGetCertificateContextProperty(context, CERT_KEY_SPEC_PROP_ID, &spec, &size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ok(size == sizeof(spec) && spec == AT_SIGNATURE, "got size %lu, spec %lu.\n", size, spec);
+        ret = CertSetCertificateContextProperty(context, CERT_KEY_SPEC_PROP_ID, 0, NULL);
+        ok(ret, "got error %#lx.\n", GetLastError());
+    }
+
     CertFreeCertificateContext(context);
 
     context = CertCreateCertificateContext(X509_ASN_ENCODING,
--- a/dlls/crypt32/tests/crl.c
+++ b/dlls/crypt32/tests/crl.c
@@ -827,6 +827,55 @@ static void checkCRLHash(const BYTE *data, DWORD dataLen, ALG_ID algID,
      propID);
 }
 
+static BOOL WINAPI set_crl_prop(const void *context, DWORD id, DWORD flags, const void *data)
+{
+    return CertSetCRLContextProperty(context, id, flags, data);
+}
+
+static BOOL WINAPI get_crl_prop(const void *context, DWORD id, void *data, DWORD *size)
+{
+    return CertGetCRLContextProperty(context, id, data, size);
+}
+
+static void check_blob_properties(const char *what, BOOL (WINAPI *set_prop)(const void *, DWORD, DWORD, const void *),
+        BOOL (WINAPI *get_prop)(const void *, DWORD, void *, DWORD *), const void *context,
+        const DWORD *ids, unsigned int count)
+{
+    static const BYTE data[] = { 1, 2, 3, 4, 5 };
+    CRYPT_DATA_BLOB blob = { sizeof(data), (BYTE *)data };
+    unsigned int i;
+
+    for (i = 0; i < count; ++i)
+    {
+        BYTE buf[16];
+        DWORD size;
+        BOOL ret;
+
+        SetLastError(0xdeadbeef);
+        ret = set_prop(context, ids[i], 0, &blob);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
+        if (!ret) continue;
+
+        size = 0;
+        ret = get_prop(context, ids[i], NULL, &size);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
+        ok(size == sizeof(data), "%s property %lu: got size %lu.\n", what, ids[i], size);
+        memset(buf, 0xcc, sizeof(buf));
+        size = sizeof(buf);
+        ret = get_prop(context, ids[i], buf, &size);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
+        ok(size == sizeof(data) && !memcmp(buf, data, sizeof(data)), "%s property %lu: unexpected value.\n", what, ids[i]);
+
+        ret = set_prop(context, ids[i], 0, NULL);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
+        size = 0;
+        SetLastError(0xdeadbeef);
+        ret = get_prop(context, ids[i], NULL, &size);
+        ok(!ret && GetLastError() == CRYPT_E_NOT_FOUND, "%s property %lu: got ret %d, error %#lx.\n",
+                what, ids[i], ret, GetLastError());
+    }
+}
+
 static void testCRLProperties(void)
 {
     PCCRL_CONTEXT context = CertCreateCRLContext(X509_ASN_ENCODING,
@@ -929,6 +978,21 @@ static void testCRLProperties(void)
         checkCRLHash(CRL, sizeof(CRL), CALG_MD5, context,
          CERT_MD5_HASH_PROP_ID);
 
+        /* the user-defined range and the documented properties that hold a CRYPT_DATA_BLOB */
+        {
+            static const DWORD ids[] =
+            {
+                CERT_FIRST_USER_PROP_ID, CERT_FIRST_USER_PROP_ID + 1, CERT_LAST_USER_PROP_ID,
+                CERT_ARCHIVED_PROP_ID, CERT_FRIENDLY_NAME_PROP_ID, CERT_DESCRIPTION_PROP_ID,
+                89 /* CERT_SIGN_HASH_CNG_ALG_PROP_ID */, 94 /* CERT_ISSUER_PUB_KEY_BIT_LENGTH_PROP_ID */,
+                95 /* CERT_ISSUER_CHAIN_SIGN_HASH_CNG_ALG_PROP_ID */,
+                96 /* CERT_ISSUER_CHAIN_PUB_KEY_CNG_ALG_BIT_LENGTH_PROP_ID */,
+            };
+
+            check_blob_properties("CRL", set_crl_prop, get_crl_prop,
+                    context, ids, ARRAY_SIZE(ids));
+        }
+
         CertFreeCRLContext(context);
     }
 }
