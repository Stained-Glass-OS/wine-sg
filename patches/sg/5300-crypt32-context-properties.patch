      CERT_MD5_HASH_PROP_ID);
 
+    /* the user-defined range and the documented properties that hold a CRYPT_DATA_BLOB */
+    {
+        static const DWORD ids[] =
+        {
+            CERT_FIRST_USER_PROP_ID, CERT_FIRST_USER_PROP_ID + 1, CERT_LAST_USER_PROP_ID,
