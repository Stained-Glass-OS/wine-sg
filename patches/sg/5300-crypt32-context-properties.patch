+        SetLastError(0xdeadbeef);
+        ret = set_prop(context, ids[i], 0, &blob);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
+        if (!ret) continue;
+
+        size = 0;
+        ret = get_prop(context, ids[i], NULL, &size);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
+        ok(size == sizeof(data), "%s property %lu: got size %lu.\n", what, ids[i], size);
+        memset(buf, 0xcc, sizeof(buf));
+        size = sizeof(buf);
+        ret = get_prop(context, ids[i], buf, &size);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
+        ok(size == sizeof(data) && !memcmp(buf, data, sizeof(data)), "%s property %lu: unexpected value.\n", what, ids[i]);
+
+        ret = set_prop(context, ids[i], 0, NULL);
+        ok(ret, "%s property %lu: got error %#lx.\n", what, ids[i], GetLastError());
