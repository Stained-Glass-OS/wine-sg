From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, kernelbase: LdrLoadDll takes the Windows arguments that LoadLibrary hooks pass on

On Windows, LdrLoadDll's second parameter points to DllCharacteristics, and
its first is a search path or -- below 64K, which is never a string -- a set
of LOAD_LIBRARY_SEARCH_* flags (bit 0 is a tag). Wine took a DWORD of
LOAD_LIBRARY_* flags and always a string. Programs that hook LdrLoadDll to keep
system DLLs to System32 (Parsec's client) read the second parameter as a
pointer and call the original with LOAD_LIBRARY_SEARCH_SYSTEM32 as the path:
the hook read Wine's flags as an address, and Wine ran wcslen(0x800); the
client crashed and was restarted every second.
kernelbase now passes DllCharacteristics (IMAGE_FILE_EXECUTABLE_IMAGE for
DONT_RESOLVE_DLL_REFERENCES). LdrLoadDll takes a characteristics pointer, a
search-flags path (resolved with LdrGetDllPath), and still the small flags its
other callers pass.
---
diff --git a/dlls/kernelbase/loader.c b/dlls/kernelbase/loader.c
index 1ca210b..de579e8 100644
--- a/dlls/kernelbase/loader.c
+++ b/dlls/kernelbase/loader.c
@@ -168,7 +168,14 @@ static HMODULE load_library( const UNICODE_STRING *libname, DWORD flags )
     }
     else
     {
+        /* as Windows does: hooks of LdrLoadDll read a DllCharacteristics pointer here */
+        ULONG characteristics = (flags & DONT_RESOLVE_DLL_REFERENCES) ? IMAGE_FILE_EXECUTABLE_IMAGE : 0;
+
+#ifdef SG_MUTANT_LDR_FLAGS_PATH
         status = LdrLoadDll( load_path, flags, libname, &module );
+#else
+        status = LdrLoadDll( load_path, (ULONG_PTR)&characteristics, libname, &module );
+#endif
         if (!set_ntstatus( status ))
         {
             module = 0;
diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 45c6e15..7414628 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -3487,13 +3487,36 @@ NTSTATUS CDECL wine_server_handle_to_fd( HANDLE handle, unsigned int access, int
 /******************************************************************
  *		LdrLoadDll (NTDLL.@)
  */
-NTSTATUS WINAPI DECLSPEC_HOTPATCH LdrLoadDll(LPCWSTR path_name, DWORD flags,
+NTSTATUS WINAPI DECLSPEC_HOTPATCH LdrLoadDll(LPCWSTR path_name, ULONG_PTR flags,
                                              const UNICODE_STRING *libname, HMODULE* hModule)
 {
     WINE_MODREF *wm;
     NTSTATUS nts;
-    WCHAR *dllname = append_dll_ext( libname->Buffer );
+    WCHAR *dllname, *search_path = NULL, *dummy;
+
+    /* On Windows the second parameter is a pointer to DllCharacteristics, and
+     * the first is either a search path or -- any value below 64K, which can
+     * never be a string -- a set of LOAD_LIBRARY_SEARCH_* flags (bit 0 is a
+     * tag). Programs that hook LdrLoadDll to keep system DLLs to System32
+     * (Parsec's client asks for mfplat.dll with LOAD_LIBRARY_SEARCH_SYSTEM32)
+     * call the original that way, and read the second parameter as a pointer;
+     * Wine read the flags as a string (wcslen(0x800)) and its own kernelbase
+     * passed flags where the hook expected a pointer. kernelbase now passes
+     * DllCharacteristics; a small value is still taken as Wine's
+     * LOAD_LIBRARY_* flags for the callers that pass 0. */
+#ifndef SG_MUTANT_LDR_FLAGS_PATH
+    if (flags >> 16)  /* a DllCharacteristics pointer: IMAGE_FILE_EXECUTABLE_IMAGE = don't resolve */
+        flags = (*(const ULONG *)flags & IMAGE_FILE_EXECUTABLE_IMAGE) ? DONT_RESOLVE_DLL_REFERENCES : 0;
+    if (path_name && !((ULONG_PTR)path_name >> 16))
+    {
+        ULONG search = (ULONG_PTR)path_name & ~1u;
+
+        if ((nts = LdrGetDllPath( libname->Buffer, search, &search_path, &dummy ))) return nts;
+        path_name = search_path;
+    }
+#endif
 
+    dllname = append_dll_ext( libname->Buffer );
     RtlEnterCriticalSection( &loader_section );
 
     nts = load_dll( path_name, dllname ? dllname : libname->Buffer, flags, &wm, FALSE );
@@ -3511,6 +3534,7 @@ NTSTATUS WINAPI DECLSPEC_HOTPATCH LdrLoadDll(LPCWSTR path_name, DWORD flags,
 
     RtlLeaveCriticalSection( &loader_section );
     RtlFreeHeap( GetProcessHeap(), 0, dllname );
+    if (search_path) RtlReleasePath( search_path );
     return nts;
 }
 
diff --git a/dlls/ntdll/ntdll.spec b/dlls/ntdll/ntdll.spec
index f214ff0..38b647a 100644
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -100,7 +100,7 @@
 @ stub LdrInitShimEngineDynamic
 @ stdcall LdrInitializeThunk(ptr long long long)
 @ stub LdrLoadAlternateResourceModule
-@ stdcall LdrLoadDll(wstr long ptr ptr)
+@ stdcall LdrLoadDll(ptr ptr ptr ptr)
 @ stdcall LdrLockLoaderLock(long ptr ptr)
 @ stdcall LdrProcessRelocationBlock(ptr long ptr long)
 @ stdcall LdrQueryImageFileExecutionOptions(ptr wstr long ptr long ptr)
diff --git a/include/winternl.h b/include/winternl.h
index c15f9ba..85f57ed 100644
--- a/include/winternl.h
+++ b/include/winternl.h
@@ -4565,7 +4565,7 @@ NTSYSAPI NTSTATUS  WINAPI LdrGetDllHandle(LPCWSTR, ULONG, const UNICODE_STRING*,
 NTSYSAPI NTSTATUS  WINAPI LdrGetDllHandleEx(ULONG, LPCWSTR, ULONG *, const UNICODE_STRING*, HMODULE*);
 NTSYSAPI NTSTATUS  WINAPI LdrGetDllPath(PCWSTR,ULONG,PWSTR*,PWSTR*);
 NTSYSAPI NTSTATUS  WINAPI LdrGetProcedureAddress(HMODULE, const ANSI_STRING*, ULONG, void**);
-NTSYSAPI NTSTATUS  WINAPI LdrLoadDll(LPCWSTR, DWORD, const UNICODE_STRING*, HMODULE*);
+NTSYSAPI NTSTATUS  WINAPI LdrLoadDll(LPCWSTR, ULONG_PTR, const UNICODE_STRING*, HMODULE*);
 NTSYSAPI NTSTATUS  WINAPI LdrLockLoaderLock(ULONG,ULONG*,ULONG_PTR*);
 IMAGE_BASE_RELOCATION * WINAPI LdrProcessRelocationBlock(void*,UINT,USHORT*,INT_PTR);
 NTSYSAPI NTSTATUS  WINAPI LdrQueryImageFileExecutionOptions(const UNICODE_STRING*,LPCWSTR,ULONG,void*,ULONG,ULONG*);
