+    TRACE("(%p)->(%f)\n", This, v);
+    This->value = v;
+    return S_OK;
+}
+
+static HRESULT WINAPI SVGAngle_get_valueInSpecifiedUnits(ISVGAngle *iface, float *p)
+{
+    SVGAngle *This = impl_from_ISVGAngle(iface);
+    TRACE("(%p)->(%p)\n", This, p);
+    *p = This->value;
+    return S_OK;
+}
+
+static HRESULT WINAPI SVGAngle_put_valueAsString(ISVGAngle *iface, BSTR v)
+{
+    SVGAngle *This = impl_from_ISVGAngle(iface);
+    float val;
+    unsigned unit;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_w(v));
+    if(!v || !svg_parse_number_unit(v, svg_angle_suffix, SVG_ANGLETYPE_UNSPECIFIED, 4, &val, &unit))
+        return E_INVALIDARG;
+    This->value = val;
+    This->unit = unit;
+    return S_OK;
+}
+
+static HRESULT WINAPI SVGAngle_get_valueAsString(ISVGAngle *iface, BSTR *p)
+{
+    SVGAngle *This = impl_from_ISVGAngle(iface);
+    TRACE("(%p)->(%p)\n", This, p);
+    *p = svg_format_number_unit(This->value, svg_angle_suffix[This->unit]);
+    return *p ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI SVGAngle_newValueSpecifiedUnits(ISVGAngle *iface, short unitType, float v)
+{
+    SVGAngle *This = impl_from_ISVGAngle(iface);
+    TRACE("(%p)->(%d %f)\n", This, unitType, v);
+    if(unitType < SVG_ANGLETYPE_UNSPECIFIED || unitType > SVG_ANGLETYPE_GRAD) return E_INVALIDARG;
+    This->unit = unitType;
+    This->value = v;
+    return S_OK;
+}
+
+static HRESULT WINAPI SVGAngle_convertToSpecifiedUnits(ISVGAngle *iface, short unitType)
+{
+    SVGAngle *This = impl_from_ISVGAngle(iface);
+    float deg;
+
+    TRACE("(%p)->(%d)\n", This, unitType);
+    if(unitType < SVG_ANGLETYPE_UNSPECIFIED || unitType > SVG_ANGLETYPE_GRAD) return E_INVALIDARG;
+    deg = svg_angle_deg(This);
+    This->unit = unitType;
+    This->value = svg_deg_to_unit(unitType, deg);
+    return S_OK;
+}
