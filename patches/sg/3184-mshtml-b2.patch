 WINE_DEFAULT_DEBUG_CHANNEL(mshtml);
 
+
+/* ---- SVG value objects (lengths, numbers, angles, points, rects, matrices, transforms) ---- */
+
+enum { SVG_LENGTHTYPE_UNKNOWN, SVG_LENGTHTYPE_NUMBER, SVG_LENGTHTYPE_PERCENTAGE, SVG_LENGTHTYPE_EMS,
+       SVG_LENGTHTYPE_EXS, SVG_LENGTHTYPE_PX, SVG_LENGTHTYPE_CM, SVG_LENGTHTYPE_MM, SVG_LENGTHTYPE_IN,
+       SVG_LENGTHTYPE_PT, SVG_LENGTHTYPE_PC };
+enum { SVG_ANGLETYPE_UNKNOWN, SVG_ANGLETYPE_UNSPECIFIED, SVG_ANGLETYPE_DEG, SVG_ANGLETYPE_RAD, SVG_ANGLETYPE_GRAD };
+
+static const WCHAR *const svg_length_suffix[] = { L"", L"", L"%", L"em", L"ex", L"px", L"cm", L"mm", L"in", L"pt", L"pc" };
+static const float svg_px_per_unit[] = { 0.0f, 1.0f, 0.0f, 16.0f, 8.0f, 1.0f, 96.0f / 2.54f, 96.0f / 25.4f, 96.0f, 96.0f / 72.0f, 16.0f };
+
+
+/* parses "<number><unit>"; returns FALSE when the string is not a valid length */
+static BOOL svg_parse_number_unit(const WCHAR *str, const WCHAR *const *suffixes, unsigned first, unsigned count,
+                                  float *value, unsigned *unit)
+{
+    WCHAR *end;
+    unsigned i;
+    double d;
+
+    while(*str == ' ' || *str == '\t' || *str == '\n' || *str == '\r') str++;
+    if(!*str) return FALSE;
+    d = wcstod(str, &end);
+    if(end == str) return FALSE;
+    while(*end == ' ' || *end == '\t') end++;
+    for(i = first; i < first + count; i++) {
+        size_t l = wcslen(suffixes[i]);
+        if(!l) continue;
+        if(!wcsnicmp(end, suffixes[i], l)) {
+            const WCHAR *rest = end + l;
+            while(*rest == ' ' || *rest == '\t' || *rest == '\n' || *rest == '\r') rest++;
+            if(*rest) return FALSE;
+            *value = d;
+            *unit = i;
+            return TRUE;
+        }
+    }
+    if(*end) return FALSE;
+    *value = d;
+    *unit = first;
+    return TRUE;
+}
+
+static BSTR svg_format_number_unit(float value, const WCHAR *suffix)
+{
+    WCHAR buf[64];
+    swprintf(buf, ARRAY_SIZE(buf), L"%g%s", (double)value, suffix);
+    return SysAllocString(buf);
+}
+
+#define SVG_OBJECT_COMMON(type, iface_type)                                                    \
+    static inline type *impl_from_##iface_type(iface_type *iface)                              \
+    { return CONTAINING_RECORD(iface, type, iface_type##_iface); }                             \
+    DISPEX_IDISPATCH_IMPL(type, iface_type, impl_from_##iface_type(iface)->dispex)
+
+/* SVGLength ------------------------------------------------------------------------------ */
+typedef struct {
+    DispatchEx dispex;
+    ISVGLength ISVGLength_iface;
+    unsigned unit;
+    float value;                 /* in 'unit' */
+    HTMLElement *elem;           /* bound attribute, or NULL */
+    const WCHAR *attr;
+    BOOL is_default_px;          /* unit of an absent attribute */
+} SVGLength;
+
+SVG_OBJECT_COMMON(SVGLength, ISVGLength)
+
+static void SVGLength_load(SVGLength *This)
+{
+    BSTR str;
+    float v;
+    unsigned u;
+
+    if(!This->elem) return;
+    if(FAILED(elem_string_attr_getter(This->elem, This->attr, FALSE, &str)) || !str) return;
+    if(*str && svg_parse_number_unit(str, svg_length_suffix, SVG_LENGTHTYPE_NUMBER, 10, &v, &u)) {
+        This->value = v;
+        This->unit = u;
+    }else {
+        This->value = 0.0f;
+        This->unit = SVG_LENGTHTYPE_NUMBER;
+    }
+    SysFreeString(str);
+}
+
+static HRESULT SVGLength_store(SVGLength *This)
+{
+    BSTR str;
+    HRESULT hres;
+
+    if(!This->elem) return S_OK;
+#ifdef SG_MUTANT_B2_SVGLEN
+    return S_OK;
+#endif
+    str = svg_format_number_unit(This->value, svg_length_suffix[This->unit]);
+    if(!str) return E_OUTOFMEMORY;
+    hres = elem_string_attr_setter(This->elem, This->attr, str);
+    SysFreeString(str);
+    return hres;
+}
+
+static float SVGLength_px(const SVGLength *This)
+{
+    if(This->unit == SVG_LENGTHTYPE_PERCENTAGE) return This->value;
+    return This->value * svg_px_per_unit[This->unit];
+}
+
+static HRESULT WINAPI SVGLength_put_unitType(ISVGLength *iface, short v)
+{
+    SVGLength *This = impl_from_ISVGLength(iface);
+    TRACE("(%p)->(%d)\n", This, v);
+    return E_ACCESSDENIED;
+}
+
+static HRESULT WINAPI SVGLength_get_unitType(ISVGLength *iface, short *p)
+{
+    SVGLength *This = impl_from_ISVGLength(iface);
+    TRACE("(%p)->(%p)\n", This, p);
+    SVGLength_load(This);
+    *p = This->unit;
+    return S_OK;
+}
+
+static HRESULT WINAPI SVGLength_put_value(ISVGLength *iface, float v)
+{
+    SVGLength *This = impl_from_ISVGLength(iface);
+    TRACE("(%p)->(%f)\n", This, v);
+    SVGLength_load(This);
+    if(This->unit == SVG_LENGTHTYPE_PERCENTAGE || !svg_px_per_unit[This->unit]) This->value = v;
+    else This->value = v / svg_px_per_unit[This->unit];
+    return SVGLength_store(This);
+}
+
+static HRESULT WINAPI SVGLength_get_value(ISVGLength *iface, float *p)
+{
+    SVGLength *This = impl_from_ISVGLength(iface);
+    TRACE("(%p)->(%p)\n", This, p);
+    SVGLength_load(This);
+    *p = SVGLength_px(This);
+    return S_OK;
+}
+
+static HRESULT WINAPI SVGLength_put_valueInSpecifiedUnits(ISVGLength *iface, float v)
+{
+    SVGLength *This = impl_from_ISVGLength(iface);
+    TRACE("(%p)->(%f)\n", This, v);
+    SVGLength_load(This);
+    This->value = v;
+    return SVGLength_store(This);
+}
+
+static HRESULT WINAPI SVGLength_get_valueInSpecifiedUnits(ISVGLength *iface, float *p)
+{
+    SVGLength *This = impl_from_ISVGLength(iface);
+    TRACE("(%p)->(%p)\n", This, p);
+    SVGLength_load(This);
+    *p = This->value;
+    return S_OK;
+}
+
+static HRESULT WINAPI SVGLength_put_valueAsString(ISVGLength *iface, BSTR v)
+{
+    SVGLength *This = impl_from_ISVGLength(iface);
+    float val;
+    unsigned unit;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_w(v));
+
+    if(!v || !svg_parse_number_unit(v, svg_length_suffix, SVG_LENGTHTYPE_NUMBER, 10, &val, &unit))
+        return E_INVALIDARG;
+    This->value = val;
+    This->unit = unit;
+    return SVGLength_store(This);
+}
+
+static HRESULT WINAPI SVGLength_get_valueAsString(ISVGLength *iface, BSTR *p)
+{
+    SVGLength *This = impl_from_ISVGLength(iface);
+    TRACE("(%p)->(%p)\n", This, p);
+    SVGLength_load(This);
+    *p = svg_format_number_unit(This->value, svg_length_suffix[This->unit]);
+    return *p ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI SVGLength_newValueSpecifiedUnits(ISVGLength *iface, short unitType, float v)
+{
+    SVGLength *This = impl_from_ISVGLength(iface);
+    TRACE("(%p)->(%d %f)\n", This, unitType, v);
+    if(unitType < SVG_LENGTHTYPE_NUMBER || unitType > SVG_LENGTHTYPE_PC) return E_INVALIDARG;
+    This->unit = unitType;
+    This->value = v;
+    return SVGLength_store(This);
+}
+
+static HRESULT WINAPI SVGLength_convertToSpecifiedUnits(ISVGLength *iface, short unitType)
+{
+    SVGLength *This = impl_from_ISVGLength(iface);
+    float px;
+
+    TRACE("(%p)->(%d)\n", This, unitType);
+    if(unitType < SVG_LENGTHTYPE_NUMBER || unitType > SVG_LENGTHTYPE_PC) return E_INVALIDARG;
+    SVGLength_load(This);
+    if(unitType == SVG_LENGTHTYPE_PERCENTAGE || This->unit == SVG_LENGTHTYPE_PERCENTAGE) return E_INVALIDARG;
+    px = SVGLength_px(This);
+    This->unit = unitType;
+    This->value = px / svg_px_per_unit[unitType];
+    return SVGLength_store(This);
+}
+
+static const ISVGLengthVtbl SVGLengthVtbl = {
+    SVGLength_QueryInterface, SVGLength_AddRef, SVGLength_Release,
+    SVGLength_GetTypeInfoCount, SVGLength_GetTypeInfo, SVGLength_GetIDsOfNames, SVGLength_Invoke,
+    SVGLength_put_unitType, SVGLength_get_unitType, SVGLength_put_value, SVGLength_get_value,
+    SVGLength_put_valueInSpecifiedUnits, SVGLength_get_valueInSpecifiedUnits,
+    SVGLength_put_valueAsString, SVGLength_get_valueAsString,
+    SVGLength_newValueSpecifiedUnits, SVGLength_convertToSpecifiedUnits
+};
+
+static void *SVGLength_query_interface(DispatchEx *dispex, REFIID riid)
+{
+    SVGLength *This = CONTAINING_RECORD(dispex, SVGLength, dispex);
+    if(IsEqualGUID(&IID_ISVGLength, riid)) return &This->ISVGLength_iface;
+    return NULL;
+}
+
+static void SVGLength_destructor(DispatchEx *dispex)
+{
+    SVGLength *This = CONTAINING_RECORD(dispex, SVGLength, dispex);
+    if(This->elem) IHTMLElement_Release(&This->elem->IHTMLElement_iface);
+    free(This);
+}
+
+static const dispex_static_data_vtbl_t SVGLength_dispex_vtbl = {
+    .query_interface = SVGLength_query_interface,
+    .destructor      = SVGLength_destructor
+};
+static const tid_t SVGLength_iface_tids[] = { ISVGLength_tid, 0 };
+dispex_static_data_t SVGLength_dispex = {
+    .id         = PROT_SVGLength,
+    .vtbl       = &SVGLength_dispex_vtbl,
+    .disp_tid   = ISVGLength_tid,
+    .iface_tids = SVGLength_iface_tids,
+};
+
+static HRESULT create_svg_length(DispatchEx *owner, HTMLElement *elem, const WCHAR *attr, ISVGLength **ret)
+{
+    SVGLength *obj;
+
+    if(!(obj = calloc(1, sizeof(*obj)))) return E_OUTOFMEMORY;
+    obj->ISVGLength_iface.lpVtbl = &SVGLengthVtbl;
+    obj->unit = SVG_LENGTHTYPE_NUMBER;
+    if(elem) {
+        obj->elem = elem;
+        IHTMLElement_AddRef(&elem->IHTMLElement_iface);
+        obj->attr = attr;
+    }
+    init_dispatch_with_owner(&obj->dispex, &SVGLength_dispex, owner);
+    *ret = &obj->ISVGLength_iface;
+    return S_OK;
+}
+
+/* SVGAnimatedLength ----------------------------------------------------------------------- */
+typedef struct {
+    DispatchEx dispex;
+    ISVGAnimatedLength ISVGAnimatedLength_iface;
+    ISVGLength *base;
+    ISVGLength *anim;
+} SVGAnimatedLength;
+
+SVG_OBJECT_COMMON(SVGAnimatedLength, ISVGAnimatedLength)
+
