+SVG_OBJECT_COMMON(SVGAngle, ISVGAngle)
+
+static const WCHAR *const svg_angle_suffix[] = { L"", L"", L"deg", L"rad", L"grad" };
+
+static float svg_angle_deg(const SVGAngle *This)
+{
+    switch(This->unit) {
+    case SVG_ANGLETYPE_RAD:  return This->value * 180.0f / (float)M_PI;
+    case SVG_ANGLETYPE_GRAD: return This->value * 0.9f;
+    default:                 return This->value;
+    }
+}
+
+static float svg_deg_to_unit(unsigned unit, float deg)
+{
+    switch(unit) {
+    case SVG_ANGLETYPE_RAD:  return deg * (float)M_PI / 180.0f;
+    case SVG_ANGLETYPE_GRAD: return deg / 0.9f;
+    default:                 return deg;
+    }
+}
+
+static HRESULT WINAPI SVGAngle_put_unitType(ISVGAngle *iface, short v)
+{
+    SVGAngle *This = impl_from_ISVGAngle(iface);
+    TRACE("(%p)->(%d)\n", This, v);
+    return E_ACCESSDENIED;
+}
+
+static HRESULT WINAPI SVGAngle_get_unitType(ISVGAngle *iface, short *p)
+{
+    SVGAngle *This = impl_from_ISVGAngle(iface);
+    TRACE("(%p)->(%p)\n", This, p);
+    *p = This->unit;
+    return S_OK;
+}
+
+static HRESULT WINAPI SVGAngle_put_value(ISVGAngle *iface, float v)
+{
+    SVGAngle *This = impl_from_ISVGAngle(iface);
+    TRACE("(%p)->(%f)\n", This, v);
+    This->value = svg_deg_to_unit(This->unit, v);
+    return S_OK;
+}
+
+static HRESULT WINAPI SVGAngle_get_value(ISVGAngle *iface, float *p)
+{
+    SVGAngle *This = impl_from_ISVGAngle(iface);
+    TRACE("(%p)->(%p)\n", This, p);
+    *p = svg_angle_deg(This);
+    return S_OK;
+}
