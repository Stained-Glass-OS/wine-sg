+/* SVGMatrix -------------------------------------------------------------------------------- */
+typedef struct {
+    DispatchEx dispex;
+    ISVGMatrix ISVGMatrix_iface;
+    float m[6];   /* a b c d e f */
+} SVGMatrix;
+
+SVG_OBJECT_COMMON(SVGMatrix, ISVGMatrix)
+
+SVG_FLOAT_ACCESSORS(SVGMatrix, ISVGMatrix, a, m[0])
+SVG_FLOAT_ACCESSORS(SVGMatrix, ISVGMatrix, b, m[1])
+SVG_FLOAT_ACCESSORS(SVGMatrix, ISVGMatrix, c, m[2])
+SVG_FLOAT_ACCESSORS(SVGMatrix, ISVGMatrix, d, m[3])
+SVG_FLOAT_ACCESSORS(SVGMatrix, ISVGMatrix, e, m[4])
+SVG_FLOAT_ACCESSORS(SVGMatrix, ISVGMatrix, f, m[5])
+
+static HRESULT create_svg_matrix(DispatchEx *owner, const float *m, ISVGMatrix **ret);
+static const ISVGMatrixVtbl SVGMatrixVtbl;
+
+/* result = a * b (a applied first in the SVG convention: M = A x B) */
+static void svg_matrix_mul(float *r, const float *a, const float *b)
+{
+    float t[6];
+    t[0] = a[0] * b[0] + a[2] * b[1];
+    t[1] = a[1] * b[0] + a[3] * b[1];
+    t[2] = a[0] * b[2] + a[2] * b[3];
+    t[3] = a[1] * b[2] + a[3] * b[3];
+    t[4] = a[0] * b[4] + a[2] * b[5] + a[4];
+    t[5] = a[1] * b[4] + a[3] * b[5] + a[5];
+    memcpy(r, t, sizeof(t));
+}
+
+static HRESULT svg_matrix_post(SVGMatrix *This, const float *op, ISVGMatrix **p)
+{
+    float r[6];
+#ifdef SG_MUTANT_B2_SVGMAT
+    svg_matrix_mul(r, op, This->m);
+#else
+    svg_matrix_mul(r, This->m, op);
+#endif
+    return create_svg_matrix(&This->dispex, r, p);
+}
+
+static HRESULT WINAPI SVGMatrix_multiply(ISVGMatrix *iface, ISVGMatrix *second, ISVGMatrix **p)
+{
+    SVGMatrix *This = impl_from_ISVGMatrix(iface), *other;
+    TRACE("(%p)->(%p %p)\n", This, second, p);
+    if(!second) return E_INVALIDARG;
+    other = impl_from_ISVGMatrix(second);
+    if(other->ISVGMatrix_iface.lpVtbl != &SVGMatrixVtbl) return E_INVALIDARG;
+    return svg_matrix_post(This, other->m, p);
+}
+
+static HRESULT WINAPI SVGMatrix_inverse(ISVGMatrix *iface, ISVGMatrix **p)
+{
+    SVGMatrix *This = impl_from_ISVGMatrix(iface);
+    const float *m = This->m;
+    float det = m[0] * m[3] - m[1] * m[2], r[6];
+
+    TRACE("(%p)->(%p)\n", This, p);
+    if(det == 0.0f) return E_INVALIDARG;   /* SVG_MATRIX_NOT_INVERTABLE */
+    r[0] =  m[3] / det;
+    r[1] = -m[1] / det;
+    r[2] = -m[2] / det;
+    r[3] =  m[0] / det;
+    r[4] = (m[2] * m[5] - m[3] * m[4]) / det;
+    r[5] = (m[1] * m[4] - m[0] * m[5]) / det;
+    return create_svg_matrix(&This->dispex, r, p);
+}
+
+static HRESULT WINAPI SVGMatrix_translate(ISVGMatrix *iface, float x, float y, ISVGMatrix **p)
+{
+    SVGMatrix *This = impl_from_ISVGMatrix(iface);
+    float op[6] = { 1, 0, 0, 1, x, y };
+    TRACE("(%p)->(%f %f %p)\n", This, x, y, p);
+    return svg_matrix_post(This, op, p);
+}
+
+static HRESULT WINAPI SVGMatrix_scale(ISVGMatrix *iface, float s, ISVGMatrix **p)
