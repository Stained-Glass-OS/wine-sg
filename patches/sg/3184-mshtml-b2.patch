+
+/* text metrics: character positions come from layout rectangles of ranges over the text nodes */
+static BOOL svg_text_locate(nsIDOMNode *node, LONG *index, nsIDOMNode **ret_node, LONG *ret_off)
+{
+    nsIDOMNode *child, *next;
+    UINT16 type = 0;
+    nsAString str;
+    const PRUnichar *data;
+    LONG len;
+
+    nsIDOMNode_GetNodeType(node, &type);
+    if(type == 3 /* TEXT_NODE */) {
+        nsAString_Init(&str, NULL);
+        nsIDOMNode_GetNodeValue(node, &str);
+        nsAString_GetData(&str, &data);
+        len = wcslen(data);
+        nsAString_Finish(&str);
+        if(*index < len) {
+            nsIDOMNode_AddRef(node);
+            *ret_node = node;
+            *ret_off = *index;
+            return TRUE;
+        }
+        *index -= len;
+        return FALSE;
+    }
+    nsIDOMNode_GetFirstChild(node, &child);
+    while(child) {
+        BOOL found = svg_text_locate(child, index, ret_node, ret_off);
+        nsIDOMNode_GetNextSibling(child, &next);
+        nsIDOMNode_Release(child);
+        if(found) {
+            if(next) nsIDOMNode_Release(next);
+            return TRUE;
+        }
+        child = next;
+    }
+    return FALSE;
+}
+
+static LONG svg_text_length(SVGElement *svg)
+{
+    nsAString str;
+    const PRUnichar *data;
+    LONG len = 0;
+
+    nsAString_Init(&str, NULL);
+    if(NS_SUCCEEDED(nsIDOMNode_GetTextContent((nsIDOMNode*)svg->element.dom_element, &str))) {
+        nsAString_GetData(&str, &data);
+        len = wcslen(data);
+    }
+    nsAString_Finish(&str);
+    return len;
+}
+
+/* bounding rectangle of [charnum, charnum+nchars) relative to the owner svg element, in px */
+static HRESULT svg_text_extent(SVGElement *svg, LONG charnum, LONG nchars, float *x, float *y, float *w, float *h)
+{
+    nsIDOMNode *start = NULL, *end = NULL;
+    LONG soff = 0, eoff = 0, idx;
+    nsIDOMClientRect *rect = NULL, *root = NULL;
+    nsIDOMRange *range;
+    nsresult nsres;
+    float l = 0, t = 0, r = 0, b = 0, rl = 0, rt = 0;
+    LONG total = svg_text_length(svg);
+
+    if(charnum < 0 || charnum >= total || nchars < 0 || charnum + nchars > total) return E_INVALIDARG;
+
+    idx = charnum;
+    svg_text_locate((nsIDOMNode*)svg->element.dom_element, &idx, &start, &soff);
+    idx = charnum + nchars;
+    if(nchars) {
+        idx--;
+        svg_text_locate((nsIDOMNode*)svg->element.dom_element, &idx, &end, &eoff);
+        eoff++;
+    }else {
+        end = start;
+        if(end) nsIDOMNode_AddRef(end);
+        eoff = soff;
+    }
+    if(!start || !end) {
+        if(start) nsIDOMNode_Release(start);
+        if(end) nsIDOMNode_Release(end);
+        return E_FAIL;
+    }
+
+    nsres = nsIDOMDocument_CreateRange(svg->element.node.doc->dom_document, &range);
+    if(NS_SUCCEEDED(nsres)) {
+        nsIDOMRange_SetStart(range, start, soff);
+        nsIDOMRange_SetEnd(range, end, eoff);
+        nsres = nsIDOMRange_GetBoundingClientRect(range, &rect);
+        nsIDOMRange_Release(range);
+    }
+    nsIDOMNode_Release(start);
+    nsIDOMNode_Release(end);
+    if(NS_FAILED(nsres) || !rect) return E_FAIL;
+    nsIDOMClientRect_GetLeft(rect, &l);
+    nsIDOMClientRect_GetTop(rect, &t);
+    nsIDOMClientRect_GetRight(rect, &r);
+    nsIDOMClientRect_GetBottom(rect, &b);
+    nsIDOMClientRect_Release(rect);
+
+    /* origin: the outermost svg element (user space == px; viewBox scaling is not applied) */
+    {
+        nsIDOMSVGElement *nssvg, *nsroot = NULL;
+        if(NS_SUCCEEDED(nsIDOMElement_QueryInterface(svg->element.dom_element, &IID_nsIDOMSVGElement, (void**)&nssvg))) {
+            nsIDOMSVGElement_GetOwnerSVGElement(nssvg, &nsroot);
+            nsIDOMSVGElement_Release(nssvg);
+        }
+        if(nsroot) {
+            if(NS_SUCCEEDED(nsIDOMElement_GetBoundingClientRect((nsIDOMElement*)nsroot, &root)) && root) {
+                nsIDOMClientRect_GetLeft(root, &rl);
+                nsIDOMClientRect_GetTop(root, &rt);
+                nsIDOMClientRect_Release(root);
+            }
+            nsIDOMSVGElement_Release(nsroot);
+        }
+    }
+    *x = l - rl; *y = t - rt; *w = r - l; *h = b - t;
+    return S_OK;
+}
+
+static HRESULT svg_text_pos(SVGElement *svg, LONG charnum, BOOL end, ISVGPoint **p)
+{
+    float x, y, w, h;
+    HRESULT hres = svg_text_extent(svg, charnum, 1, &x, &y, &w, &h);
+    if(FAILED(hres)) return hres;
+    /* baseline: the y attribute of the element when set, else the bottom of the line box less the descent */
+    {
+        BSTR ys;
+        float yv;
+        unsigned unit;
+        if(SUCCEEDED(elem_string_attr_getter(&svg->element, L"y", FALSE, &ys)) && ys) {
+            if(*ys && svg_parse_number_unit(ys, svg_length_suffix, SVG_LENGTHTYPE_NUMBER, 10, &yv, &unit))
+                y = yv * svg_px_per_unit[unit];
+            else y += h * 0.8f;
+            SysFreeString(ys);
+        }else y += h * 0.8f;
+    }
+    return create_svg_point(&svg->element.node.event_target.dispex, end ? x + w : x, y, p);
+}
