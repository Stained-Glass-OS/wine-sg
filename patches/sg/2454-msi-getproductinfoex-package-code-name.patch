From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msi: MsiGetProductInfoEx package code and package name

Ground truth from Wine's msi tests (18 todo_wine marks removed): MsiGetProductInfoEx for the package code reads a squashed GUID from the product's registry key and returns it as a GUID; anything else there is ERROR_BAD_CONFIGURATION and the caller's buffer and size are left alone. The package name is kept in the product's SourceList key: without that key it is ERROR_UNKNOWN_PRODUCT, buffer untouched. (MsiGetProductInfo did both already.)
---
--- a/dlls/msi/msi.c
+++ b/dlls/msi/msi.c
@@ -1528,10 +1528,43 @@ UINT WINAPI MsiGetProductInfoExW(LPCWSTR szProductCode, LPCWSTR szUserSid,
         else if (dwContext == MSIINSTALLCONTEXT_MACHINE)
             hkey = classes;
 
-        val = reg_get_value(hkey, szProperty, &type);
+#ifndef SG_MUTANT_MSI_PRODINFO_EX
+        if (hkey && !wcscmp( szProperty, INSTALLPROPERTY_PACKAGENAMEW ))
+        {
+            /* the name of the package is kept with the source list */
+            HKEY source;
+
+            if (RegOpenKeyW( hkey, L"SourceList", &source ))
+            {
+                r = ERROR_UNKNOWN_PRODUCT;
+                goto done;
+            }
+            val = reg_get_value( source, szProperty, &type );
+            RegCloseKey( source );
+        }
+        else
+#endif
+            val = reg_get_value(hkey, szProperty, &type);
         if (!val)
             val = wcsdup(L"");
 
+#ifndef SG_MUTANT_MSI_PRODINFO_EX
+        if (val[0] && type != REG_DWORD && !wcscmp( szProperty, INSTALLPROPERTY_PACKAGECODEW ))
+        {
+            /* a package code is a squashed GUID; shown as a GUID */
+            WCHAR packagecode[GUID_SIZE];
+
+            if (lstrlenW( val ) != SQUASHED_GUID_SIZE - 1)
+            {
+                r = ERROR_BAD_CONFIGURATION;
+                goto done;
+            }
+            unsquash_guid( val, packagecode );
+            free( val );
+            val = wcsdup( packagecode );
+        }
+#endif
+
         r = copy_outval(val, szValue, pcchValue);
     }
     else if (!wcscmp( szProperty, INSTALLPROPERTY_PRODUCTSTATEW ))
