-/* The key from a PKCS #8 blob as a BCRYPT_RSAFULLPRIVATE_BLOB, which NCryptImportKey knows how to import */
+static const char oid_ec_public_key[] = "1.2.840.10045.2.1";
+static const char oid_p256[] = "1.2.840.10045.3.1.7";
+static const char oid_p384[] = "1.3.132.0.34";
+
+/* Stained Glass OS: an EC key's ECPrivateKey (RFC 5915) as a BCRYPT_ECCPRIVATE_BLOB; the curve from the
+ * AlgorithmIdentifier's parameters or the key's own [0], the public point from its [1] */
+static SECURITY_STATUS ec_private_key_to_blob(const struct pkcs8_private_key_info *info, BYTE **blob, DWORD *blob_len)
+{
+    const BYTE *p = info->PrivateKey.pbData, *end = p + info->PrivateKey.cbData, *seq, *c, *d = NULL, *pub = NULL;
+    DWORD seq_len, len, d_len = 0, pub_len = 0, size, magic;
+    char curve[64] = "";
+    BCRYPT_ECCKEY_BLOB *hdr;
+    BYTE tag, *out;
+
+    if (info->Algorithm.Parameters.cbData)
+    {
+        /* der_oid_string takes the whole OBJECT IDENTIFIER */
+        if (info->Algorithm.Parameters.pbData[0] != 0x06 ||
+            !der_oid_string(info->Algorithm.Parameters.pbData, info->Algorithm.Parameters.cbData, curve, sizeof(curve)))
+            curve[0] = 0;
+    }
+    if (!der_next(&p, end, &tag, &seq, &seq_len) || tag != 0x30) return NTE_BAD_DATA;
+    p = seq;
+    end = seq + seq_len;
+    if (!der_next(&p, end, &tag, &c, &len) || tag != 0x02 || len != 1 || c[0] != 1) return NTE_BAD_DATA;
+    if (!der_next(&p, end, &tag, &d, &d_len) || tag != 0x04) return NTE_BAD_DATA;
+    while (p < end)
+    {
+        if (!der_next(&p, end, &tag, &c, &len)) return NTE_BAD_DATA;
+        if (tag == 0xa0 && !curve[0])
+        {
+            const BYTE *q = c, *oid;
+            DWORD oid_len;
+            if (der_next(&q, c + len, &tag, &oid, &oid_len) && tag == 0x06) der_oid_string(c, q - c, curve, sizeof(curve));
+        }
+        else if (tag == 0xa1)
+        {
+            const BYTE *q = c;
+            if (!der_next(&q, c + len, &tag, &pub, &pub_len) || tag != 0x03) return NTE_BAD_DATA;
+        }
+    }
+    if (!strcmp(curve, oid_p256)) { size = 32; magic = BCRYPT_ECDSA_PRIVATE_P256_MAGIC; }
+    else if (!strcmp(curve, oid_p384)) { size = 48; magic = BCRYPT_ECDSA_PRIVATE_P384_MAGIC; }
+    else
+    {
+        WARN("curve %s is not supported\n", debugstr_a(curve));
+        return NTE_NOT_SUPPORTED;
+    }
+    /* the public point is needed for the blob: an uncompressed point after the BIT STRING's unused-bits byte */
+    if (!pub || pub_len != 2 + 2 * size || pub[0] != 0 || pub[1] != 0x04)
+    {
+        WARN("no uncompressed public point in the key\n");
+        return NTE_NOT_SUPPORTED;
+    }
+    while (d_len > size && !d[0]) { d++; d_len--; }
+    if (d_len > size) return NTE_BAD_DATA;
+    if (!(out = calloc(1, sizeof(*hdr) + 3 * size))) return NTE_NO_MEMORY;
+    hdr = (BCRYPT_ECCKEY_BLOB *)out;
+    hdr->dwMagic = magic;
+    hdr->cbKey = size;
+    memcpy(out + sizeof(*hdr), pub + 2, 2 * size);
+    memcpy(out + sizeof(*hdr) + 2 * size + (size - d_len), d, d_len);
+    *blob = out;
+    *blob_len = sizeof(*hdr) + 3 * size;
+    return ERROR_SUCCESS;
+}
+
+/* The key from a PKCS #8 blob as a BCRYPT_RSAFULLPRIVATE_BLOB, or (Stained Glass OS) an EC key's as a
+ * BCRYPT_ECCPRIVATE_BLOB, which NCryptImportKey knows how to import; *type says which */
 SECURITY_STATUS pkcs8_to_rsa_blob(BCRYPT_ALG_HANDLE rsa_alg, const BYTE *data, DWORD data_len,
-                                  const NCryptBufferDesc *desc, BYTE **blob, DWORD *blob_len)
+                                  const NCryptBufferDesc *desc, BYTE **blob, DWORD *blob_len, const WCHAR **type)
 {
     struct pkcs8_private_key_info *info = NULL;
     struct pkcs8_encrypted_info *enc = NULL;
@@ -671,6 +758,15 @@ SECURITY_STATUS pkcs8_to_rsa_blob(BCRYPT_ALG_HANDLE rsa_alg, const BYTE *data, D
             goto done;
         }
     }
+    *type = BCRYPT_RSAFULLPRIVATE_BLOB;
+#ifndef SG_MUTANT_PKCS8_NO_EC
+    if (!strcmp(info->Algorithm.pszObjId, oid_ec_public_key))
+    {
+        *type = BCRYPT_ECCPRIVATE_BLOB;
+        ret = ec_private_key_to_blob(info, blob, blob_len);
+        goto done;
+    }
+#endif
     if (strcmp(info->Algorithm.pszObjId, oid_rsa))
     {
         ret = NTE_NOT_SUPPORTED;
