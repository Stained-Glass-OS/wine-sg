From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: saving a 24/32bpp bitmap as GIF writes the picture

WIC's GIF encoder takes only 8bpp indexed pixels. GDI+ asked for the
bitmap's own format, was given 8bpp indexed, could not lock a 24/32bpp
bitmap as an indexed one and committed no frame: Image.Save as GIF wrote a
24-byte file with no image, and reading it back failed (Cyberduck 9.6 died
re-saving a GIF icon). As Windows' GDI+, a bitmap with more colours is now
reduced to the halftone palette (error diffusion; 4bpp and 1bpp encoders get
the 8-colour halftone and black and white) and that frame, with its palette,
is written. GIF keeps no alpha: translucent pixels are drawn over black.

Gate: test/gdipgifsave-gate.sh; mutant SG_MUTANT_GDIP_GIF_NO_REDUCE.
---
--- a/dlls/gdiplus/image.c
+++ b/dlls/gdiplus/image.c
@@ -4917,10 +4917,46 @@
     IWICMetadataQueryWriter_Release(writer);
 }
 
+static GpStatus convert_to_indexed(GpBitmap *bitmap, PixelFormat format, DitherType dithertype,
+    PaletteType palettetype, const ColorPalette *custom, REAL alphathreshold, GpBitmap **out);
+
+/* An encoder that takes only an indexed format (GIF: 8bpp indexed) given a bitmap with more colours:
+ * as Windows' GDI+ the picture is reduced to the halftone palette (error diffusion) and that frame is
+ * written; translucent pixels are drawn over black, GIF keeps no alpha. Wine used to fail the frame and
+ * write a GIF with no image at all. */
+static GpStatus reduce_for_indexed_encoder(GpBitmap *bitmap, PixelFormat format, GpBitmap **out)
+{
+    GpBitmap *opaque = NULL;
+    ColorPalette *halftone = NULL;
+    PaletteType type = PaletteTypeCustom;
+    GpStatus status;
+
+    *out = NULL;
+    if (format == PixelFormat8bppIndexed)
+    {
+        if (!(halftone = get_palette(NULL, WICBitmapPaletteTypeFixedHalftone256))) return OutOfMemory;
+    }
+    else
+        type = format == PixelFormat4bppIndexed ? PaletteTypeFixedHalftone8 : PaletteTypeFixedBW;
+
+    if (bitmap->format & PixelFormatAlpha)
+    {
+        /* premultiplied colour read as opaque colour = the picture over black */
+        status = GdipCloneBitmapAreaI(0, 0, bitmap->width, bitmap->height, PixelFormat32bppPARGB, bitmap, &opaque);
+        if (status != Ok) { free(halftone); return status; }
+        opaque->format = PixelFormat32bppRGB;
+        bitmap = opaque;
+    }
+    status = convert_to_indexed(bitmap, format, DitherTypeErrorDiffusion, type, halftone, 0.0f, out);
+    if (opaque) GdipDisposeImage(&opaque->image);
+    free(halftone);
+    return status;
+}
+
 static GpStatus encode_frame_wic(IWICBitmapEncoder *encoder, GpImage *image)
 {
     GpStatus stat;
-    GpBitmap *bitmap;
+    GpBitmap *bitmap, *reduced = NULL, *src;
     IWICBitmapFrameEncode *frameencode;
     IPropertyBag2 *encoderoptions;
     GUID container_format;
@@ -5011,8 +5047,19 @@
             }
         }
 
-        if (SUCCEEDED(hr) && IsIndexedPixelFormat(gdipformat) && image->palette)
-            hr = set_palette(frameencode, image->palette);
+        src = bitmap;
+#ifndef SG_MUTANT_GDIP_GIF_NO_REDUCE
+        if (SUCCEEDED(hr) && IsIndexedPixelFormat(gdipformat) && !IsIndexedPixelFormat(bitmap->format))
+        {
+            if (reduce_for_indexed_encoder(bitmap, gdipformat, &reduced) == Ok)
+                src = reduced;
+            else
+                hr = E_FAIL;
+        }
+#endif
+
+        if (SUCCEEDED(hr) && IsIndexedPixelFormat(gdipformat) && src->image.palette)
+            hr = set_palette(frameencode, src->image.palette);
 
 #ifndef SG_MUTANT_GDIP_SAVE_NO_PROPS
         if (SUCCEEDED(hr))
@@ -5021,7 +5068,7 @@
 
         if (SUCCEEDED(hr))
         {
-            stat = GdipBitmapLockBits(bitmap, &rc, ImageLockModeRead, gdipformat,
+            stat = GdipBitmapLockBits(src, &rc, ImageLockModeRead, gdipformat,
                 &lockeddata);
 
             if (stat == Ok)
@@ -5038,12 +5085,14 @@
                     row += lockeddata.Stride;
                 }
 
-                GdipBitmapUnlockBits(bitmap, &lockeddata);
+                GdipBitmapUnlockBits(src, &lockeddata);
             }
             else
                 hr = E_FAIL;
         }
 
+        if (reduced) GdipDisposeImage(&reduced->image);
+
         if (SUCCEEDED(hr))
             hr = IWICBitmapFrameEncode_Commit(frameencode);
 
