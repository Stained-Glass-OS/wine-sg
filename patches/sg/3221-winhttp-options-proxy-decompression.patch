+/* WINHTTP_OPTION_PROXY query: the strings go to the caller in the buffer's tail, a WINHTTP_PROXY_INFO is written
+ * first; the documentation says they are GlobalAlloc'ed, so those are what the caller gets */
+static BOOL return_proxy_option( DWORD access, const WCHAR *server, const WCHAR *bypass, void *buffer, DWORD *buflen )
+{
+    WINHTTP_PROXY_INFO *info = buffer;
+
+    if (!validate_buffer( buffer, buflen, sizeof(*info) )) return FALSE;
+    info->dwAccessType = access;
+    info->lpszProxy = info->lpszProxyBypass = NULL;
+    if (server && !(info->lpszProxy = GlobalAlloc( GPTR, (lstrlenW( server ) + 1) * sizeof(WCHAR) ))) return FALSE;
+    if (bypass && !(info->lpszProxyBypass = GlobalAlloc( GPTR, (lstrlenW( bypass ) + 1) * sizeof(WCHAR) )))
+    {
+        free_proxy_info( info );
+        return FALSE;
+    }
+    if (server) lstrcpyW( info->lpszProxy, server );
+    if (bypass) lstrcpyW( info->lpszProxyBypass, bypass );
+    *buflen = sizeof(*info);
+    return TRUE;
