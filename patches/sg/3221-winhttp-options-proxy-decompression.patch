+/* the options that act on no handle at all (WinHttpOpen is not needed for them) */
+static BOOL query_global_option( DWORD option, void *buffer, DWORD *buflen )
+{
+    switch (option)
+    {
+    case WINHTTP_OPTION_PROXY:
+    {
+        WINHTTP_PROXY_INFO info;
+        BOOL ret;
+
+        if (!buflen)
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+        if (!validate_buffer( buffer, buflen, sizeof(info) )) return FALSE;
+        if (!(ret = WinHttpGetDefaultProxyConfiguration( &info ))) return FALSE;
+        *(WINHTTP_PROXY_INFO *)buffer = info;
+        *buflen = sizeof(info);
+        return TRUE;
+    }
+    case WINHTTP_OPTION_ENABLETRACING:
+        if (!buflen)
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+        if (!validate_buffer( buffer, buflen, sizeof(DWORD) )) return FALSE;
+        *(DWORD *)buffer = tracing_enabled;
+        *buflen = sizeof(DWORD);
+        return TRUE;
+
+    default:
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+}
