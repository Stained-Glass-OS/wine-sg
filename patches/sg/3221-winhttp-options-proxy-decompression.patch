+/* the value of name=value in a comma separated challenge, percent decoded */
+static WCHAR *get_challenge_param( const WCHAR *challenge, const WCHAR *name )
+{
+    size_t len = wcslen( name );
+    const WCHAR *p = challenge, *end;
+    WCHAR *ret, *dst;
+
+    while (*p)
+    {
+        while (*p == ' ' || *p == ',') p++;
+        if (!wcsnicmp( p, name, len ) && p[len] == '=')
+        {
+            p += len + 1;
+            if (*p == '"') p++;
+            for (end = p; *end && *end != ',' && *end != '"'; end++) ;
+            if (!(ret = malloc( (end - p + 1) * sizeof(WCHAR) ))) return NULL;
+            for (dst = ret; p < end; p++)
+            {
+                if (*p == '%' && p + 2 < end && iswxdigit( p[1] ) && iswxdigit( p[2] ))
+                {
+                    WCHAR hex[3] = { p[1], p[2], 0 };
+                    *dst++ = wcstoul( hex, NULL, 16 );
+                    p += 2;
+                }
+                else *dst++ = *p;
+            }
+            *dst = 0;
+            return ret;
+        }
+        while (*p && *p != ',') p++;
+    }
+    return NULL;
+}
