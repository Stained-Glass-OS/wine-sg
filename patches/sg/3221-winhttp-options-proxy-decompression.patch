+static BOOL same_address( const struct sockaddr_storage *a, const struct sockaddr_storage *b )
+{
+    if (a->ss_family != b->ss_family) return FALSE;
+    if (a->ss_family == AF_INET)
+        return ((const struct sockaddr_in *)a)->sin_addr.s_addr == ((const struct sockaddr_in *)b)->sin_addr.s_addr;
+    return !memcmp( &((const struct sockaddr_in6 *)a)->sin6_addr, &((const struct sockaddr_in6 *)b)->sin6_addr,
+                    sizeof(struct in6_addr) );
+}
+
+#define MAX_HOST_ADDRESSES 32
+
+/* Try the addresses of a host one after the other, at most max_attempts connections in all (the one
+ * that is already known to have failed counts). With ipv6_fast the order is the IPv6 fast fallback one:
+ * the first IPv6 address with a short timeout, then the first IPv4 address, then the first IPv6 address
+ * again, then the others. */
+DWORD netconn_connect_multi( struct hostdata *host, INTERNET_PORT port, const struct sockaddr_storage *tried,
+                             DWORD max_attempts, BOOL ipv6_fast, int timeout, struct netconn **ret_conn )
+{
+    struct sockaddr_storage v4[MAX_HOST_ADDRESSES], v6[MAX_HOST_ADDRESSES];
+    struct { const struct sockaddr_storage *addr; int timeout; } order[2 * MAX_HOST_ADDRESSES + 2];
+    unsigned int n4 = 0, n6 = 0, count = 0, i;
+    DWORD attempts = tried ? 1 : 0, err = ERROR_WINHTTP_CANNOT_CONNECT;
+    ADDRINFOW *res, *ptr, hints;
+
+    winsock_init();
+    memset( &hints, 0, sizeof(hints) );
+    hints.ai_family = AF_UNSPEC;
+    if (GetAddrInfoW( host->hostname, NULL, &hints, &res )) return ERROR_WINHTTP_NAME_NOT_RESOLVED;
+    for (ptr = res; ptr; ptr = ptr->ai_next)
+    {
+        if (ptr->ai_family == AF_INET && n4 < MAX_HOST_ADDRESSES)
+        {
+            memset( &v4[n4], 0, sizeof(v4[n4]) );
+            memcpy( &v4[n4], ptr->ai_addr, min( ptr->ai_addrlen, sizeof(struct sockaddr_in) ) );
+            ((struct sockaddr_in *)&v4[n4])->sin_port = htons( port );
+            n4++;
+        }
+        else if (ptr->ai_family == AF_INET6 && n6 < MAX_HOST_ADDRESSES)
+        {
+            memset( &v6[n6], 0, sizeof(v6[n6]) );
+            memcpy( &v6[n6], ptr->ai_addr, min( ptr->ai_addrlen, sizeof(struct sockaddr_in6) ) );
+            ((struct sockaddr_in6 *)&v6[n6])->sin6_port = htons( port );
+            n6++;
+        }
+    }
+    FreeAddrInfoW( res );
+
+    if (ipv6_fast && n4 && n6)
+    {
+        order[count].addr = &v6[0]; order[count++].timeout = 300;
+        order[count].addr = &v4[0]; order[count++].timeout = timeout;
+        order[count].addr = &v6[0]; order[count++].timeout = timeout;
+        for (i = 1; i < n4; i++) { order[count].addr = &v4[i]; order[count++].timeout = timeout; }
+        for (i = 1; i < n6; i++) { order[count].addr = &v6[i]; order[count++].timeout = timeout; }
+    }
+    else
+    {
+        for (i = 0; i < n4; i++) { order[count].addr = &v4[i]; order[count++].timeout = timeout; }
+        for (i = 0; i < n6; i++) { order[count].addr = &v6[i]; order[count++].timeout = timeout; }
+    }
+
+    for (i = 0; i < count && attempts < max_attempts; i++)
+    {
+        if (tried && same_address( order[i].addr, tried )) continue;
+        attempts++;
+        if (!(err = netconn_create( host, order[i].addr, order[i].timeout, ret_conn ))) return ERROR_SUCCESS;
+    }
+    return err;
+}
+
 void netconn_addref( struct netconn *conn )
 {
     InterlockedIncrement( &conn->refs );
