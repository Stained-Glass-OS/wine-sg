+#ifdef SG_MUTANT_WH_NODEFAULTS
+    return;
+#endif
+    opts->connect_retries = 5;
+    opts->max_redirects = 10;
+    opts->max_status_continue = 10;
+    opts->max_header_size = 64 * 1024;
+    opts->max_drain_size = 1024 * 1024;
+    opts->codepage = CP_UTF8;
