+/* "[location\\[store\\]]subject": location CURRENT_USER (default) or LOCAL_MACHINE, store "MY" (default, also
+ * called Personal), a blank subject picks the first certificate of the store */
+static HRESULT select_client_certificate( struct winhttp_request *request, const WCHAR *certificate )
+{
+    WCHAR *copy, *parts[3], *p;
+    unsigned int count = 0;
+    const WCHAR *store_name = L"MY", *subject;
+    DWORD location = CERT_SYSTEM_STORE_CURRENT_USER;
+    HCERTSTORE store;
+    const CERT_CONTEXT *cert;
+    HRESULT hr = S_OK;
+
+    if (!request->hrequest) return HRESULT_FROM_WIN32( ERROR_WINHTTP_CANNOT_CALL_BEFORE_OPEN );
+    if (!(copy = wcsdup( certificate ))) return E_OUTOFMEMORY;
+
+    for (p = copy; p && count < 3; )
+    {
+        parts[count++] = p;
+        if ((p = wcschr( p, '\\' ))) *p++ = 0;
+    }
+    if (p) /* the subject itself may contain backslashes */
+    {
+        p[-1] = '\\';
+    }
+    subject = parts[count - 1];
+    if (count > 1)
+    {
+        if (!wcsicmp( parts[0], L"LOCAL_MACHINE" )) location = CERT_SYSTEM_STORE_LOCAL_MACHINE;
+        else if (wcsicmp( parts[0], L"CURRENT_USER" ))
+        {
+            free( copy );
+            return E_INVALIDARG;
+        }
+#ifdef SG_MUTANT_WH_CERTSTORE
+        if (count > 2) store_name = parts[1];
+#else
+        if (count > 2) store_name = wcsicmp( parts[1], L"Personal" ) ? parts[1] : L"MY";
+#endif
+    }
+
+    if (!(store = CertOpenStore( CERT_STORE_PROV_SYSTEM_W, 0, 0, location | CERT_STORE_OPEN_EXISTING_FLAG |
+                                 CERT_STORE_READONLY_FLAG, store_name )))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        free( copy );
+        return hr;
+    }
+#ifdef SG_MUTANT_WH_CERTSUBJECT
+    if (1) cert = CertEnumCertificatesInStore( store, NULL );
+#else
+    if (!*subject) cert = CertEnumCertificatesInStore( store, NULL );
+#endif
