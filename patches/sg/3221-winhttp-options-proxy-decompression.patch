+    return !RegGetValueW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings",
+                          L"ShareCredsWithWinHttp", RRF_RT_REG_DWORD, NULL, &value, &size ) && value;
