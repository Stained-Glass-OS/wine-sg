+/* a connection that is in use counts against WINHTTP_OPTION_MAX_CONNS_PER_SERVER; waits for a free slot */
+static DWORD reserve_connection_slot( struct request *request, struct hostdata *host )
+{
+    struct session *session = request->connect->session;
+    DWORD limit, timeout = request->connect_timeout > 0 ? request->connect_timeout : INFINITE;
+    ULONGLONG end = GetTickCount64() + timeout;
+
+    EnterCriticalSection( &connection_pool_cs );
+    for (;;)
+    {
+#ifdef SG_MUTANT_WH_MAXCONNS
+        break;
+#endif
+        limit = host->http10 ? session->opts.max_conns_per_1_0_server : session->opts.max_conns_per_server;
+        if (host->active < limit) break;
+        if (timeout == INFINITE) SleepConditionVariableCS( &connection_slot_cv, &connection_pool_cs, INFINITE );
+        else
+        {
+            ULONGLONG now = GetTickCount64();
+            if (now >= end || !SleepConditionVariableCS( &connection_slot_cv, &connection_pool_cs, end - now ))
+            {
+                LeaveCriticalSection( &connection_pool_cs );
+                return ERROR_WINHTTP_TIMEOUT;
+            }
+        }
+    }
+    host->active++;
+    LeaveCriticalSection( &connection_pool_cs );
+    return ERROR_SUCCESS;
+#ifdef SG_MUTANT_WH_MAXCONNS
+    /* dead */
+#endif
+}
+
+void release_slot( struct hostdata *host )
+{
+    EnterCriticalSection( &connection_pool_cs );
+    host->active--;
+    LeaveCriticalSection( &connection_pool_cs );
+    WakeAllConditionVariable( &connection_slot_cv );
+}
