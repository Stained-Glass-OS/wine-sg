+static BOOL set_global_option( DWORD option, void *buffer, DWORD buflen )
+{
+    switch (option)
+    {
+    case WINHTTP_OPTION_PROXY:
+    {
+        DWORD access;
+        WCHAR *server, *bypass;
+        WINHTTP_PROXY_INFO info;
+        BOOL ret;
+
+        if (!parse_proxy_option( buffer, buflen, &access, &server, &bypass )) return FALSE;
+        info.dwAccessType = access;
+        info.lpszProxy = server;
+        info.lpszProxyBypass = bypass;
+        ret = WinHttpSetDefaultProxyConfiguration( &info );
+        free( server );
+        free( bypass );
+        return ret;
+    }
+    case WINHTTP_OPTION_ENABLETRACING:
+        if (buflen != sizeof(DWORD))
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        tracing_enabled = *(DWORD *)buffer;
+        return TRUE;
+
+    case WINHTTP_OPTION_HTTP_VERSION:
+    {
+        HTTP_VERSION_INFO *info = buffer;
+
+        if (buflen != sizeof(*info))
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        http_version = *info;
+        return TRUE;
+    }
+    case WINHTTP_OPTION_WORKER_THREAD_COUNT:
+        if (buflen != sizeof(DWORD))
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        /* settable once */
+        if (worker_thread_count_set)
+        {
+            SetLastError( ERROR_WINHTTP_INCORRECT_HANDLE_STATE );
+            return FALSE;
+        }
+        worker_thread_count = *(DWORD *)buffer;
+        worker_thread_count_set = TRUE;
+        return TRUE;
+
+    case WINHTTP_OPTION_GLOBAL_PROXY_CREDS:
+    case WINHTTP_OPTION_GLOBAL_SERVER_CREDS:
+        return set_global_creds( option, buffer, buflen );
+
+    default:
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+}
