+static const struct dword_option *find_dword_option( DWORD option )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(dword_options); i++)
+        if (dword_options[i].option == option) return &dword_options[i];
+    return NULL;
+}
