+    { &global_creds_debug.ProcessLocksList, &global_creds_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": global_creds_cs") }
+};
+static CRITICAL_SECTION global_creds_cs = { &global_creds_debug, -1, 0, 0, 0, 0 };
+static struct list global_creds_list = LIST_INIT( global_creds_list );
+
+/* the fields of WINHTTP_CREDS_EX (WINHTTP_CREDS stops after dwPort) */
+struct winhttp_creds_ex
+{
+    char *lpszUserName;
+    char *lpszPassword;
+    char *lpszRealm;
+    DWORD dwAuthScheme;
+    char *lpszHostName;
+    DWORD dwPort;
+    char *lpszUrl;
+};
+
+static WCHAR *strdupAW_opt( const char *str )
+{
+    int len;
+    WCHAR *ret;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar( CP_ACP, 0, str, -1, NULL, 0 );
+    if ((ret = malloc( len * sizeof(WCHAR) ))) MultiByteToWideChar( CP_ACP, 0, str, -1, ret, len );
+    return ret;
+}
+
+static BOOL set_global_creds( DWORD option, void *buffer, DWORD buflen )
+{
+    const struct winhttp_creds_ex *in = buffer;
+    struct global_creds *creds;
+
+    if (!shared_creds_enabled())
+    {
+        SetLastError( ERROR_WINHTTP_INVALID_OPTION );
+        return FALSE;
+    }
+    if (!buffer || buflen < offsetof(struct winhttp_creds_ex, lpszUrl))
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    if (!(creds = calloc( 1, sizeof(*creds) )))
+    {
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    creds->proxy = option == WINHTTP_OPTION_GLOBAL_PROXY_CREDS;
+    creds->username = strdupAW_opt( in->lpszUserName );
+    creds->password = strdupAW_opt( in->lpszPassword );
+    creds->realm = strdupAW_opt( in->lpszRealm );
+    creds->host = strdupAW_opt( in->lpszHostName );
+    creds->scheme = in->dwAuthScheme;
+    creds->port = in->dwPort;
+
+    EnterCriticalSection( &global_creds_cs );
+    list_add_head( &global_creds_list, &creds->entry );
+    LeaveCriticalSection( &global_creds_cs );
+    return TRUE;
+}
+
+/* find shared credentials for a challenge; the strings are copies for the caller to free */
+BOOL find_global_creds( BOOL proxy, const WCHAR *host, DWORD port, DWORD scheme, WCHAR **username, WCHAR **password )
+{
+    struct global_creds *creds;
+    BOOL ret = FALSE;
+
+    EnterCriticalSection( &global_creds_cs );
+    LIST_FOR_EACH_ENTRY( creds, &global_creds_list, struct global_creds, entry )
+    {
+        if (creds->proxy != proxy || !creds->username || !creds->password) continue;
+        if (creds->host && wcsicmp( creds->host, host )) continue;
+        if (creds->port && creds->port != port) continue;
+        if (creds->scheme && creds->scheme != scheme) continue;
+        *username = wcsdup( creds->username );
+        *password = wcsdup( creds->password );
+        ret = *username && *password;
+        break;
+    }
+    LeaveCriticalSection( &global_creds_cs );
+    return ret;
+}
+
+BOOL global_server_creds_allowed( struct request *request )
+{
+    return request->opts.use_global_server_creds;
+}
