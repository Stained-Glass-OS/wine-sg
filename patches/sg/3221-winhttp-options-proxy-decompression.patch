+/* Query a stored option. Returns FALSE if the option is not one of the stored ones, with *handled FALSE. */
+static BOOL query_dword_option( struct http_opts *opts, DWORD handle_flag, DWORD option, void *buffer, DWORD *buflen,
+                                BOOL *handled )
+{
+    const struct dword_option *opt = find_dword_option( option );
+
+    *handled = opt != NULL;
+    if (!opt) return FALSE;
+    /* an option that is not for this kind of handle, or not to be queried, is ERROR_INVALID_PARAMETER (on a
+     * connection ERROR_WINHTTP_INCORRECT_HANDLE_TYPE), like the options of the websocket ones in the tests */
+    if (!(opt->flags & handle_flag) || !(opt->flags & OPT_QUERY))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!validate_buffer( buffer, buflen, sizeof(DWORD) )) return FALSE;
+    *(DWORD *)buffer = *(DWORD *)((char *)opts + opt->offset);
+    *buflen = sizeof(DWORD);
+    return TRUE;
