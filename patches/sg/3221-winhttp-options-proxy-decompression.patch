+    {
+    case WINHTTP_OPTION_DECOMPRESSION:
+        if (value & ~WINHTTP_DECOMPRESSION_FLAG_ALL) goto invalid;
+        break;
+    case WINHTTP_OPTION_ENABLE_HTTP_PROTOCOL:
