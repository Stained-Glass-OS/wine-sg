From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: the RGB To Hue and Hue To RGB effects are drawn

Both were drawn as their input ('Built-in effect {23f3e5ec-...} is drawn as its input', seen from Paint.NET 5.2). RGB To Hue puts hue, saturation and value (HSV) or lightness (HSL, OutputColorSpace 1) in the colour channels, each 0 to 1, alpha kept; Hue To RGB is its inverse (InputColorSpace). On straight colour, premultiplied out.
---
--- a/dlls/d2d1/effect_render.c
+++ b/dlls/d2d1/effect_render.c
@@ -1059,6 +1059,27 @@
     "    }\n"
     /* wine-sg 9509: the component transfers of the Filter Effects spec (feComponentTransfer), which the
      * Linear, Gamma, Table and Discrete Transfer effects are: on straight colour, per channel */
+    /* wine-sg 9352: RGB To Hue and Hue To RGB: hue, saturation and value or lightness in the colour
+     * channels, each 0 to 1 (v0.x: 0 HSV, 1 HSL) */
+    "    if (mode == 15) {\n"                                         /* RGB to hue */
+    "        float4 u = saturate(unpremul(c)); float mx = max(u.r, max(u.g, u.b)), mn = min(u.r, min(u.g, u.b));\n"
+    "        float d = mx - mn, h = 0.0, s, l;\n"
+    "        if (d > 0.0) {\n"
+    "            if (mx == u.r) h = (u.g - u.b) / d; else if (mx == u.g) h = 2.0 + (u.b - u.r) / d;\n"
+    "            else h = 4.0 + (u.r - u.g) / d;\n"
+    "            h = frac(h / 6.0 + 1.0);\n"
+    "        }\n"
+    "        if (v0.x < 0.5) { l = mx; s = mx > 0.0 ? d / mx : 0.0; }\n"
+    "        else { l = (mx + mn) * 0.5; s = d > 0.0 ? d / (1.0 - abs(2.0 * l - 1.0)) : 0.0; }\n"
+    "        return premul(float4(h, saturate(s), l, u.a));\n"
+    "    }\n"
+    "    if (mode == 16) {\n"                                         /* hue to RGB */
+    "        float4 u = saturate(unpremul(c)); float h = frac(u.r) * 6.0, ch, m;\n"
+    "        if (v0.x < 0.5) { ch = u.b * u.g; m = u.b - ch; }\n"
+    "        else { ch = (1.0 - abs(2.0 * u.b - 1.0)) * u.g; m = u.b - ch * 0.5; }\n"
+    "        float3 k = saturate(float3(abs(h - 3.0) - 1.0, 2.0 - abs(h - 2.0), 2.0 - abs(h - 4.0)));\n"
+    "        return premul(float4(k * ch + m, u.a));\n"
+    "    }\n"
     "    if (mode == 13) {\n"                                         /* gamma/linear: v0 * u^v1 + v2 */
     "        float4 r = v0 * pow(max(unpremul(c), 0.0), v1) + v2;\n"
     "        if (m[0][0] > 0.5) r = saturate(r);\n"
@@ -1578,6 +1599,17 @@
         c.m[1 * 4 + 3] = 0.7154f;
         c.m[2 * 4 + 3] = 0.0721f;
     }
+#ifndef SG_MUTANT_D2D_HUE_STUB
+    else if (IsEqualGUID(id, &CLSID_D2D1RgbToHue) || IsEqualGUID(id, &CLSID_D2D1HueToRgb))
+    {
+        /* wine-sg 9352: OutputColorSpace / InputColorSpace: 0 HSV, 1 HSL */
+        UINT32 space = 0;
+
+        get_uint(effect, 0, D2D1_PROPERTY_TYPE_ENUM, &space);
+        c.mode = IsEqualGUID(id, &CLSID_D2D1RgbToHue) ? 15 : 16;
+        c.v0[0] = space ? 1.0f : 0.0f;
+    }
+#endif
     else if (IsEqualGUID(id, &CLSID_D2D1Exposure))
     {
         /* the colour times 2 to the ExposureValue */
