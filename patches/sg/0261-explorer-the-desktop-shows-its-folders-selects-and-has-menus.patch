+/* Stained Glass OS: a file or folder -- its own icon and type from the
+ * shell, its name as Explorer shows it (a shortcut without .lnk / .url) */
+static BOOL add_file_launcher( const WCHAR *folder, const WCHAR *filename, const WIN32_FIND_DATAW *data )
+{
+    struct launcher *launcher;
+    SHFILEINFOW info;
+    const WCHAR *ext = wcsrchr( filename, '.' );
+    BOOL hide_ext = ext && (!wcsicmp( ext, L".lnk" ) || !wcsicmp( ext, L".url" ));
+
+    if (nb_launchers == nb_allocated)
+    {
+        unsigned int count = nb_allocated * 2;
+        struct launcher **tmp = realloc( launchers, count * sizeof(*tmp) );
+        if (!tmp) return FALSE;
+        launchers = tmp;
+        nb_allocated = count;
+    }
+    if (!(launcher = calloc( 1, sizeof(*launcher) ))) return FALSE;
+    if (!(launcher->path = append_path( folder, filename, -1 ))) goto error;
+    memset( &info, 0, sizeof(info) );
+    SHGetFileInfoW( launcher->path, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON | SHGFI_TYPENAME );
+    if (!(launcher->icon = info.hIcon)) goto error;
+    launcher->title = hide_ext ? build_title( filename, -1 ) : wcsdup( filename );
+    launcher->type = wcsdup( (data->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) ? L"" : info.szTypeName );
+    launcher->is_file = TRUE;
+    launcher->is_dir = (data->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+    launcher->size = ((ULONGLONG)data->nFileSizeHigh << 32) | data->nFileSizeLow;
+    launcher->mtime = data->ftLastWriteTime;
+    if (!launcher->title || !launcher->type) goto error;
+    launchers[nb_launchers++] = launcher;
+    return TRUE;
+
+error:
+    if (launcher->icon) DestroyIcon( launcher->icon );
+    free( launcher->title );
+    free( launcher->type );
+    free( launcher->path );
+    free( launcher );
+    return FALSE;
+}
