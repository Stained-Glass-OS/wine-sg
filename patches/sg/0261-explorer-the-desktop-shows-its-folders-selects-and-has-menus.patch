+static void sg_new_item( HWND hwnd, BOOL folder )
+{
+    WCHAR path[MAX_PATH];
+    int n;
+
+    if (!desktop_folder) return;
+    for (n = 1; n < 1000; n++)
+    {
+        if (folder)
+        {
+            if (n == 1) swprintf( path, ARRAY_SIZE(path), L"%s\\New folder", desktop_folder );
+            else swprintf( path, ARRAY_SIZE(path), L"%s\\New folder (%d)", desktop_folder, n );
+            if (CreateDirectoryW( path, NULL )) break;
+        }
+        else
+        {
+            HANDLE h;
+            if (n == 1) swprintf( path, ARRAY_SIZE(path), L"%s\\New Text Document.txt", desktop_folder );
+            else swprintf( path, ARRAY_SIZE(path), L"%s\\New Text Document (%d).txt", desktop_folder, n );
+            if ((h = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_NEW, 0, NULL )) != INVALID_HANDLE_VALUE)
+            {
+                CloseHandle( h );
+                break;
+            }
+        }
+        if (GetLastError() != ERROR_ALREADY_EXISTS && GetLastError() != ERROR_FILE_EXISTS) return;
+    }
+    sg_rescan( hwnd, path );
+}
+
+enum { SG_CMD_LARGE = 1, SG_CMD_MEDIUM, SG_CMD_SMALL, SG_CMD_SHOWICONS, SG_CMD_SORT_NAME, SG_CMD_SORT_SIZE,
+       SG_CMD_SORT_TYPE, SG_CMD_SORT_DATE, SG_CMD_REFRESH, SG_CMD_NEW_FOLDER, SG_CMD_NEW_TEXT,
+       SG_CMD_DISPLAY, SG_CMD_PERSONALIZE };
+
+/* the desktop's own menu, Windows 10's */
+static void sg_desktop_menu( HWND hwnd, POINT pt )
+{
+    HMENU menu = CreatePopupMenu(), view = CreatePopupMenu(), sort = CreatePopupMenu(), new = CreatePopupMenu();
+    UINT cmd;
+
+    AppendMenuW( view, MF_STRING | (sg_icon_size == 48 ? MF_CHECKED : 0), SG_CMD_LARGE, L"&Large icons" );
+    AppendMenuW( view, MF_STRING | (sg_icon_size == 32 ? MF_CHECKED : 0), SG_CMD_MEDIUM, L"&Medium icons" );
+    AppendMenuW( view, MF_STRING | (sg_icon_size == 24 ? MF_CHECKED : 0), SG_CMD_SMALL, L"&Small icons" );
+    AppendMenuW( view, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( view, MF_STRING | (sg_hide_icons ? 0 : MF_CHECKED), SG_CMD_SHOWICONS, L"Show &desktop icons" );
+    AppendMenuW( sort, MF_STRING | (sg_sort_by == 0 ? MF_CHECKED : 0), SG_CMD_SORT_NAME, L"&Name" );
+    AppendMenuW( sort, MF_STRING | (sg_sort_by == 1 ? MF_CHECKED : 0), SG_CMD_SORT_SIZE, L"&Size" );
+    AppendMenuW( sort, MF_STRING | (sg_sort_by == 2 ? MF_CHECKED : 0), SG_CMD_SORT_TYPE, L"&Item type" );
+    AppendMenuW( sort, MF_STRING | (sg_sort_by == 3 ? MF_CHECKED : 0), SG_CMD_SORT_DATE, L"&Date modified" );
+    AppendMenuW( new, MF_STRING, SG_CMD_NEW_FOLDER, L"&Folder" );
+    AppendMenuW( new, MF_STRING, SG_CMD_NEW_TEXT, L"&Text Document" );
+    AppendMenuW( menu, MF_POPUP, (UINT_PTR)view, L"&View" );
+    AppendMenuW( menu, MF_POPUP, (UINT_PTR)sort, L"S&ort by" );
+    AppendMenuW( menu, MF_STRING, SG_CMD_REFRESH, L"R&efresh" );
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( menu, MF_POPUP, (UINT_PTR)new, L"Ne&w" );
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( menu, MF_STRING, SG_CMD_DISPLAY, L"&Display settings" );
+    AppendMenuW( menu, MF_STRING, SG_CMD_PERSONALIZE, L"Pe&rsonalize" );
+    SetForegroundWindow( sg_keys_hwnd ? sg_keys_hwnd : hwnd );
+    cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_RIGHTBUTTON, pt.x, pt.y, 0, sg_keys_hwnd ? sg_keys_hwnd : hwnd, NULL );
+    DestroyMenu( menu );
+
+    switch (cmd)
+    {
+    case SG_CMD_LARGE: case SG_CMD_MEDIUM: case SG_CMD_SMALL:
+        sg_set_dword( sg_bags_key, L"IconSize", cmd == SG_CMD_LARGE ? 48 : cmd == SG_CMD_MEDIUM ? 32 : 24 );
+        sg_rescan( hwnd, NULL );
+        break;
+    case SG_CMD_SHOWICONS:
+        sg_set_dword( sg_advanced_key, L"HideIcons", !sg_hide_icons );
+        sg_rescan( hwnd, NULL );
+        break;
+    case SG_CMD_SORT_NAME: case SG_CMD_SORT_SIZE: case SG_CMD_SORT_TYPE: case SG_CMD_SORT_DATE:
+        sg_set_dword( sg_desktop_key, L"SortBy", cmd - SG_CMD_SORT_NAME );
+        sg_rescan( hwnd, NULL );
+        break;
+    case SG_CMD_REFRESH: sg_rescan( hwnd, NULL ); break;
+    case SG_CMD_NEW_FOLDER: sg_new_item( hwnd, TRUE ); break;
+    case SG_CMD_NEW_TEXT: sg_new_item( hwnd, FALSE ); break;
+    case SG_CMD_DISPLAY: ShellExecuteW( NULL, NULL, L"ms-settings:display", NULL, NULL, SW_SHOWNORMAL ); break;
+    case SG_CMD_PERSONALIZE: ShellExecuteW( NULL, NULL, L"ms-settings:personalization", NULL, NULL, SW_SHOWNORMAL ); break;
+    }
+}
+
+/* SG_DESKTOP_DUMP=<file>: what the desktop shows, for the gate */
+static void sg_dump(void)
+{
+    WCHAR path[MAX_PATH];
+    unsigned int i;
+    FILE *f;
+
+    if (!GetEnvironmentVariableW( L"SG_DESKTOP_DUMP", path, ARRAY_SIZE(path) ) || !(f = _wfopen( path, L"w" ))) return;
+    fprintf( f, "icons=%u size=%d hidden=%d sort=%lu selected=%d\n", nb_launchers, sg_icon_size, sg_hide_icons,
+             sg_sort_by, sg_selected );
+    for (i = 0; i < nb_launchers; i++)
+    {
+        RECT r = get_icon_rect( i );
+        fprintf( f, "item %u %ld,%ld %s %ls\n", i, (r.left + r.right) / 2, (r.top + r.bottom) / 2,
+                 launchers[i]->is_file ? "file" : "shell", launchers[i]->title );
+    }
+    fclose( f );
+}
+
+/* draw the desktop now, before a menu's loop: UpdateWindow gives the desktop window
+ * only WM_ERASEBKGND, and its WM_PAINT would wait for the menu to close */
+static void sg_draw_now( HWND hwnd )
+{
+    HDC hdc = GetDCEx( hwnd, 0, DCX_CACHE | DCX_CLIPCHILDREN );
+    RECT rc;
+
+    GetClientRect( hwnd, &rc );
+    PaintDesktop( hdc );
+    draw_launchers( hdc, rc );
+    ReleaseDC( hwnd, hdc );
+    ValidateRect( hwnd, NULL );
+    sg_dump();
+}
+
+static LRESULT CALLBACK sg_keys_proc( HWND hwnd, UINT message, WPARAM wp, LPARAM lp )
+{
+    switch (message)
+    {
+    case WM_KEYDOWN:
+        /* the desktop's own keys */
+        if (wp == VK_F5 || wp == VK_RETURN) return SendMessageW( sg_desktop_hwnd, message, wp, lp );
+        if (wp == VK_APPS || (wp == VK_F10 && GetKeyState( VK_SHIFT ) < 0))
+        {
+            POINT pt = { 200, 200 };
+            if (sg_selected >= 0 && sg_selected < (int)nb_launchers)
+            {
+                RECT r = get_icon_rect( sg_selected );
+                pt.x = r.right; pt.y = r.bottom;
+                sg_item_menu( sg_desktop_hwnd, launchers[sg_selected], pt );
+            }
+            else sg_desktop_menu( sg_desktop_hwnd, pt );
+            return 0;
+        }
+        break;
+    case WM_CONTEXTMENU:
+        return 0;
+    }
+    return DefWindowProcW( hwnd, message, wp, lp );
+}
+
+static void sg_create_keys_window(void)
+{
+    WNDCLASSW wc = { 0 };
+
+    wc.lpfnWndProc = sg_keys_proc;
+    wc.hInstance = GetModuleHandleW( NULL );
+    wc.lpszClassName = L"SgDesktopKeys";
+    RegisterClassW( &wc );
+    /* on the screen (X gives the keyboard only to a window it shows), but one
+     * pixel, fully transparent and click-through */
+    sg_keys_hwnd = CreateWindowExW( WS_EX_TOOLWINDOW | WS_EX_LAYERED | WS_EX_TRANSPARENT, L"SgDesktopKeys", L"Desktop",
+                                    WS_POPUP, 0, 0, 1, 1, NULL, NULL, wc.hInstance, NULL );
+    if (sg_keys_hwnd)
+    {
+        SetLayeredWindowAttributes( sg_keys_hwnd, 0, 0, LWA_ALPHA );
+        ShowWindow( sg_keys_hwnd, SW_SHOWNOACTIVATE );
+    }
+}
