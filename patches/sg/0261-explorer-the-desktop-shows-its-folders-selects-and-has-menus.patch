+        (v == 24 || v == 32 || v == 48)) sg_icon_size = v;
+    size = sizeof(v); v = 0;
+    RegGetValueW( HKEY_CURRENT_USER, sg_advanced_key, L"HideIcons", RRF_RT_REG_DWORD, NULL, &v, &size );
+    sg_hide_icons = v != 0;
+    size = sizeof(v); v = 0;
+    RegGetValueW( HKEY_CURRENT_USER, sg_desktop_key, L"SortBy", RRF_RT_REG_DWORD, NULL, &v, &size );
+    sg_sort_by = v <= 3 ? v : 0;
+}
