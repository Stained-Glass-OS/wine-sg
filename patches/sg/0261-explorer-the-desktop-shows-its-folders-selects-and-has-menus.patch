+/* Sort by: the shell icons first, as they were added; then the files */
+static int __cdecl sg_compare( const void *a, const void *b )
+{
+    const struct launcher *l = *(const struct launcher **)a, *r = *(const struct launcher **)b;
+    LONG c = 0;
+
+    if (l->is_file != r->is_file) return l->is_file ? 1 : -1;
+    if (!l->is_file) return 0;
+    if (l->is_dir != r->is_dir) return l->is_dir ? -1 : 1;    /* folders first, as Windows sorts */
+    switch (sg_sort_by)
+    {
+    case 1: c = l->size < r->size ? -1 : l->size > r->size; break;
+    case 2: c = wcsicmp( l->type ? l->type : L"", r->type ? r->type : L"" ); break;
+    case 3: c = -CompareFileTime( &l->mtime, &r->mtime ); break;   /* newest first */
+    }
+    return c ? c : CompareStringW( LOCALE_USER_DEFAULT, NORM_IGNORECASE | SORT_DIGITSASNUMBERS,
+                                   l->title, -1, r->title, -1 ) - 2;
+}
