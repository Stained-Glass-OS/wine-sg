+/* an icon's own shell menu (Open, Cut, Copy, Delete, Properties, ...) */
+static void sg_item_menu( HWND hwnd, const struct launcher *l, POINT pt )
+{
+    const WCHAR *name = (l->args && l->args[0] == ':') ? l->args : l->path;
+    IShellFolder *parent = NULL;
+    IContextMenu *cm = NULL;
+    LPCITEMIDLIST child;
+    LPITEMIDLIST pidl = NULL;
+    HRESULT init = CoInitialize( NULL );
+    HMENU menu;
+    UINT cmd;
+
+    if (!wcsicmp( l->path, L"control.exe" )) name = L"::{5399E694-6CE5-4D6C-8FCE-1D8870FDCBA0}";
+    if (SUCCEEDED(SHParseDisplayName( name, NULL, &pidl, 0, NULL )) &&
+        SUCCEEDED(SHBindToParent( pidl, &IID_IShellFolder, (void **)&parent, &child )) &&
+        SUCCEEDED(IShellFolder_GetUIObjectOf( parent, hwnd, 1, &child, &IID_IContextMenu, NULL, (void **)&cm )) &&
+        (menu = CreatePopupMenu()))
+    {
+        IContextMenu_QueryContextMenu( cm, menu, 0, 1, 0x7fff, CMF_NORMAL );
+        if (sg_keys_hwnd) SetForegroundWindow( sg_keys_hwnd );
+        cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_RIGHTBUTTON, pt.x, pt.y, 0, sg_keys_hwnd ? sg_keys_hwnd : hwnd, NULL );
+        if (cmd)
+        {
+            CMINVOKECOMMANDINFO info = { sizeof(info) };
+            info.hwnd = hwnd;
+            info.lpVerb = MAKEINTRESOURCEA( cmd - 1 );
+            info.nShow = SW_SHOWNORMAL;
+            IContextMenu_InvokeCommand( cm, &info );
+        }
+        DestroyMenu( menu );
+    }
+    if (cm) IContextMenu_Release( cm );
+    if (parent) IShellFolder_Release( parent );
+    CoTaskMemFree( pidl );
+    if (SUCCEEDED( init )) CoUninitialize();
+    PostMessageW( hwnd, WM_SG_DESKTOP_RESCAN, 0, 0 );
+}
