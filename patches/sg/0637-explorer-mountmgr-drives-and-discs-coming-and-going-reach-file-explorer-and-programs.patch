From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer, mountmgr: drives and discs coming and going reach File Explorer and programs

David: a disc put in did not show in This PC until it was opened again, an
ejected drive disappeared until the next boot, and a disc taken out stayed
with its name and size. Mount manager's notices go to the SYSTEM account's
desktop, and the shell's change notices do not cross processes.
- File Explorer looks at the drive letters and, for each removable or
  optical drive, whether its root can be read and its serial number, every
  two seconds, and reads This PC and the navigation pane's drives again when
  they change.
- The session's desktop broadcasts WM_DEVICECHANGE to programs
  (DBT_DEVICEARRIVAL / DBT_DEVICEREMOVECOMPLETE of a volume, DBTF_MEDIA for
  a disc), sent (a notify message cannot carry the volume to another
  process).
- Mount manager: a disc taken out removes only its filesystem from UDisks2;
  the drive is added again, empty, and keeps its letter, as on Windows.
---
--- a/dlls/mountmgr.sys/dbus.c
+++ b/dlls/mountmgr.sys/dbus.c
@@ -520,6 +520,13 @@
              p_dbus_message_get_args( msg, &error, DBUS_TYPE_OBJECT_PATH, &path, DBUS_TYPE_INVALID ))
     {
         udisks_removed_device( path );
+        /* Stained Glass: a disc taken out removes only its filesystem; the
+         * drive stays, empty, with its letter, as on Windows (it went from
+         * File Explorer until the next boot). A device that is gone is not
+         * found again. */
+#ifndef SG_MUTANT_NOREADD
+        udisks2_add_devices( path );
+#endif
     }
     else if (p_dbus_message_is_signal( msg, "org.freedesktop.DBus.Properties", "PropertiesChanged" ))
     {
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -28,6 +28,7 @@
 #include <rpc.h>
 #include <shlobj.h>
 #include <shellapi.h>
+#include <dbt.h>
 #include <ntuser.h>
 #include "exdisp.h"
 
@@ -2791,6 +2792,74 @@
     if (thread) CloseHandle( thread );
 }
 
+/* Stained Glass OS: drives and media coming and going, told to the session
+ * as Windows' shell hardware detection tells it: SHChangeNotify (File
+ * Explorer's This PC re-reads its drives) and WM_DEVICECHANGE to the
+ * programs (DBT_DEVICEARRIVAL / DBT_DEVICEREMOVECOMPLETE of a volume, with
+ * DBTF_MEDIA for a disc). Mount manager's own notices go to the SYSTEM
+ * account's desktop, not this one: a disc put in did not show until This
+ * PC was opened again. A look every two seconds: the drive letters, and
+ * each removable or optical drive's volume serial number. */
+static DWORD WINAPI device_watch_thread( void *arg )
+{
+    DWORD serials[26] = {0}, mask = GetLogicalDrives(), i;
+
+    for (i = 0; i < 26; i++)
+    {
+        WCHAR root[] = { 'A' + i, ':', '\\', 0 };
+        if ((mask & (1 << i)) && GetFileAttributesW( root ) != INVALID_FILE_ATTRIBUTES)
+            GetVolumeInformationW( root, NULL, 0, &serials[i], NULL, NULL, NULL, 0 );
+    }
+    for (;;)
+    {
+        DWORD now;
+
+        Sleep( 2000 );
+        now = GetLogicalDrives();
+        for (i = 0; i < 26; i++)
+        {
+            WCHAR root[] = { 'A' + i, ':', '\\', 0 };
+            DWORD serial = 0, type, event = 0, dbt = 0, flags = 0;
+
+            if (!(now & (1 << i)) && !(mask & (1 << i))) continue;
+            type = (now & (1 << i)) ? GetDriveTypeW( root ) : DRIVE_UNKNOWN;
+            /* a medium is there when the drive's root can be read (the device
+             * alone still answers with the last disc's serial number) */
+            if ((now & (1 << i)) && (type == DRIVE_REMOVABLE || type == DRIVE_CDROM || type == DRIVE_UNKNOWN) &&
+                GetFileAttributesW( root ) != INVALID_FILE_ATTRIBUTES)
+                GetVolumeInformationW( root, NULL, 0, &serial, NULL, NULL, NULL, 0 );
+            else if (now & (1 << i)) serial = serials[i];   /* fixed and network drives: letters only */
+
+            if ((now & (1 << i)) && !(mask & (1 << i))) { event = SHCNE_DRIVEADD; dbt = DBT_DEVICEARRIVAL; }
+            else if (!(now & (1 << i)) && (mask & (1 << i))) { event = SHCNE_DRIVEREMOVED; dbt = DBT_DEVICEREMOVECOMPLETE; }
+            else if (serial != serials[i] && serial)
+            {
+                if (serials[i]) SHChangeNotify( SHCNE_MEDIAREMOVED, SHCNF_PATHW, root, NULL );
+                event = SHCNE_MEDIAINSERTED; dbt = DBT_DEVICEARRIVAL; flags = DBTF_MEDIA;
+            }
+            else if (serial != serials[i]) { event = SHCNE_MEDIAREMOVED; dbt = DBT_DEVICEREMOVECOMPLETE; flags = DBTF_MEDIA; }
+            serials[i] = serial;
+#ifdef SG_MUTANT_NODEVWATCH
+            event = 0;
+#endif
+            if (!event) continue;
+            WINE_TRACE( "drive %c: event %#lx\n", (int)('A' + i), event );
+            SHChangeNotify( event, SHCNF_PATHW | SHCNF_FLUSHNOWAIT, root, NULL );
+            if (dbt)
+            {
+                DEV_BROADCAST_VOLUME vol = { sizeof(vol), DBT_DEVTYP_VOLUME, 0, 1 << i, flags };
+                DWORD to = BSM_APPLICATIONS;
+                /* sent, as the system sends it: a notify message cannot carry
+                 * the volume to another process */
+                BroadcastSystemMessageW( BSF_QUERY | BSF_FORCEIFHUNG | BSF_NOHANG | BSF_IGNORECURRENTTASK, &to,
+                                         WM_DEVICECHANGE, dbt, (LPARAM)&vol );
+            }
+        }
+        mask = now;
+    }
+    return 0;
+}
+
 /* Stained Glass OS: winspool loads the system's (CUPS) printers when it is
  * first loaded, once per session -- a named mutex says it was done, and the
  * mutex lives as long as some process holds it. Programs that link winspool
@@ -2977,6 +3046,8 @@
         if (thread) CloseHandle( thread );
         thread = CreateThread( NULL, 0, spooler_thread, NULL, 0, NULL );
         if (thread) CloseHandle( thread );
+        if (enable_shell && (thread = CreateThread( NULL, 0, device_watch_thread, NULL, 0, NULL )))
+            CloseHandle( thread );
         SystemParametersInfoW( SPI_SETDESKWALLPAPER, 0, NULL, FALSE );
         ClipCursor( NULL );
         initialize_display_settings( width, height );
--- a/programs/explorer/fileexplorer.c
+++ b/programs/explorer/fileexplorer.c
@@ -145,6 +145,7 @@
 #define TIMER_SEARCH  1
 #define TIMER_NEWITEM 2
 #define TIMER_COUNT   3   /* Stained Glass OS: the status bar follows the view's items */
+#define TIMER_DRIVES  4   /* Stained Glass OS: This PC follows its drives and discs */
 
 enum content { CONTENT_FOLDER, CONTENT_THISPC, CONTENT_SEARCH, CONTENT_QUICK };
 /* This PC and Quick access are pages of ours */
@@ -281,6 +282,7 @@
     IDropTarget *tree_drop;
     HTREEITEM tree_drop_item;
     IDataObject *tree_drag_data;
+    DWORD drives_sig;              /* Stained Glass OS: This PC's drives and media, last seen */
 } fe;
 
 static int S(int x) { return MulDiv(x, fe.dpi, 96); }
@@ -3073,6 +3075,7 @@
                     it->total = total.QuadPart;
                     it->free = avail.QuadPart;
                 }
+                TRACE("this pc drive %s %s\n", debugstr_w(it->root), debugstr_w(it->name));
             }
             IEnumIDList_Release(ids);
         }
@@ -3081,6 +3084,35 @@
     IShellFolder_Release(desktop);
 }
 
+/* Stained Glass OS: This PC follows its drives and discs -- a disc put in or
+ * taken out, a stick plugged in. The drive letters and, for each removable or
+ * optical drive, whether its root can be read and its volume serial number;
+ * looked at every two seconds while the page shows This PC (the system's
+ * notices of it go to the SYSTEM account's desktop, and change notices do not
+ * cross processes). A disc put in did not show until the page was opened
+ * again; one taken out stayed with its name and size. */
+static DWORD drives_signature(void)
+{
+    DWORD mask = GetLogicalDrives(), sig = mask, i;
+
+    for (i = 0; i < 26; i++)
+    {
+        WCHAR root[] = { 'A' + i, ':', '\\', 0 };
+        DWORD serial = 0, type;
+
+        if (!(mask & (1 << i))) continue;
+        type = GetDriveTypeW(root);
+        if (type != DRIVE_REMOVABLE && type != DRIVE_CDROM) continue;
+        /* the device alone still answers with the last disc's serial */
+        if (GetFileAttributesW(root) != INVALID_FILE_ATTRIBUTES &&
+            GetVolumeInformationW(root, NULL, 0, &serial, NULL, NULL, NULL, 0))
+            sig = (sig * 31) ^ serial ^ (1 << i);
+        else
+            sig = (sig * 31) ^ (0x80000000 >> i);
+    }
+    return sig;
+}
+
 /* Quick access's page: the pinned and frequent folders, then the recent files */
 static void load_quick(void)
 {
@@ -4926,6 +4958,23 @@
         /* items the view added or removed by itself (a paste, a program
          * writing into the folder): the status bar said "0 items" beside
          * a file */
+        if (wp == TIMER_DRIVES)
+        {
+            DWORD sig = drives_signature();
+#ifndef SG_MUTANT_NODRIVEREFRESH
+            if (sig != fe.drives_sig)
+            {
+                reload_pc_tree();   /* the navigation pane's drives too */
+                if (fe.content == CONTENT_THISPC)
+                {
+                    load_thispc();
+                    thispc_layout();
+                    InvalidateRect(fe.page, NULL, FALSE);
+                }
+            }
+#endif
+            fe.drives_sig = sig;
+        }
         if (wp == TIMER_COUNT && fe.content == CONTENT_FOLDER)
         {
             HWND list = get_view_list();
@@ -5213,6 +5262,8 @@
     if (fe.sw) IShellWindows_Register(fe.sw, NULL, (LONG_PTR)fe.hwnd, SWC_EXPLORER, &fe.sw_cookie);
     AddClipboardFormatListener(fe.hwnd);
     SetTimer(fe.hwnd, TIMER_COUNT, 500, NULL);
+    fe.drives_sig = drives_signature();
+    SetTimer(fe.hwnd, TIMER_DRIVES, 2000, NULL);
 
     fe.tooltip = CreateWindowExW(WS_EX_TOPMOST, TOOLTIPS_CLASSW, NULL, TTS_ALWAYSTIP | TTS_NOPREFIX,
                                  0, 0, 0, 0, fe.hwnd, NULL, NULL, NULL);
