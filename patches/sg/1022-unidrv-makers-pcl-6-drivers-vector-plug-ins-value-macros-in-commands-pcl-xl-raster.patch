+/* the page as a picture, from the print processor: to the plug-in when it
+ * draws (a vector printer language), else onto our page bitmap */
+BOOL WINAPI DrvCopyBits( SURFOBJ *dst, SURFOBJ *src, CLIPOBJ *clip, XLATEOBJ *xlate, RECTL *rect, POINTL *pt )
+{
+    struct unidrv_pdev *pdev = surf_pdev( dst );
+    BOOL (WINAPI *hook)( SURFOBJ *, SURFOBJ *, CLIPOBJ *, XLATEOBJ *, RECTL *, POINTL * );
+    if (pdev && (hook = (void *)oem_hook( pdev, INDEX_DrvCopyBits ))) return hook( dst, src, clip, xlate, rect, pt );
+    return core_CopyBits( dst, src, clip, xlate, rect, pt );
+}
