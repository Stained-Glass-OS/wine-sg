+/* a printer language that takes the raster in blocks (PCL XL's BeginImage,
+ * ReadImage and EndImage, in Microsoft's pclxl.gpd terms CmdBeginRaster,
+ * CmdSendBlockData and CmdEndRaster): the band at once, its rows padded to
+ * whole DWORDs as PCL XL reads them */
+static BOOL send_block( struct unidrv_pdev *pdev, const BYTE *data, int stride, int bytes, int rows, int y0 )
+{
+    struct gpd_command cmd;
+    int y, padded = (bytes + 3) & ~3;
+    BYTE *block;
+
+    if (!gpd_command( pdev->gpd, pdev->sel, "CmdBeginRaster", &cmd )) return FALSE;
+    if (!(block = calloc( rows, padded ))) return TRUE;
+    for (y = 0; y < rows; y++) memcpy( block + (SIZE_T)y * padded, data + (SIZE_T)y * stride, bytes );
+    pdev->cur_x = 0;
+    pdev->cur_y = y0;
+    send_named( pdev, "CmdXMoveAbsolute" );
+    send_named( pdev, "CmdYMoveAbsolute" );
+    pdev->width_bytes = padded;
+    pdev->height_pixels = rows;
+    pdev->data_bytes = padded * rows;
+    send_command( pdev, &cmd );
+    send_named( pdev, "CmdSendBlockData" );
+    unidrv_write( pdev, block, padded * rows );
+    send_named( pdev, "CmdEndRaster" );
+    pdev->cur_y = y0 + rows;
+    free( block );
+    return TRUE;
+}
+
 /* sends a band's rows as the GPD describes (no plug-in filter) */
 static void send_rows( struct unidrv_pdev *pdev, const BYTE *data, int stride, int bytes, int rows, int y0 )
 {
     int y;
 
+#ifndef SG_MUTANT_BLOCKRASTER
+    if (pdev->vector && send_block( pdev, data, stride, bytes, rows, y0 )) return;
+#endif
+
     for (y = 0; y < rows; y++)
     {
         const BYTE *row = data + y * stride;
