From: Stained Glass OS contributors
Subject: explorer: a program's taskbar button has Windows 10's menu

Right-clicking a program's taskbar button showed the window's system menu
(Restore, Move, Size...). Windows 10 shows the program -- another window of
it -- and Close window (Close all windows for a group). Stained Glass OS adds
Report a problem when sg-bugreport is installed: testers report on the
program they are looking at (sg-bugreport64.exe --window HWND).
Shift+right-click keeps the system menu. The program's name is its
FileDescription, as Windows shows it.

--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1682,6 +1682,90 @@
 
 static void sg_taskbar_menu( LPARAM lparam );
 
+/* Stained Glass OS: a program's button has Windows 10's menu -- the program
+ * (another window of it), Report a problem (sg-bugreport, for testers) and
+ * Close window; Shift+right-click keeps the window's own system menu. */
+enum { SG_BTN_LAUNCH = 1, SG_BTN_REPORT, SG_BTN_CLOSE };
+
+/* the name a program gives itself (its FileDescription), else its file's */
+static void sg_exe_display_name( const WCHAR *exe, WCHAR *name, int size )
+{
+    static DWORD (WINAPI *size_of)(const WCHAR *, DWORD *);
+    static BOOL (WINAPI *get_info)(const WCHAR *, DWORD, DWORD, void *);
+    static BOOL (WINAPI *query)(const void *, const WCHAR *, void **, UINT *);
+    struct { WORD lang, cp; } *tr;
+    WCHAR key[64], *value;
+    DWORD handle, len;
+    UINT n;
+    void *data;
+
+    lstrcpynW( name, wcsrchr( exe, '\\' ) ? wcsrchr( exe, '\\' ) + 1 : exe, size );
+    if (wcsrchr( name, '.' )) *wcsrchr( name, '.' ) = 0;
+    if (!size_of)
+    {
+        HMODULE version = LoadLibraryW( L"version.dll" );
+        if (!version) return;
+        get_info = (void *)GetProcAddress( version, "GetFileVersionInfoW" );
+        query = (void *)GetProcAddress( version, "VerQueryValueW" );
+        size_of = (void *)GetProcAddress( version, "GetFileVersionInfoSizeW" );
+    }
+    if (!size_of || !get_info || !query || !(len = size_of( exe, &handle )) || !(data = malloc( len ))) return;
+    if (get_info( exe, 0, len, data ) && query( data, L"\\VarFileInfo\\Translation", (void **)&tr, &n ) && n >= sizeof(*tr))
+    {
+        swprintf( key, ARRAY_SIZE(key), L"\\StringFileInfo\\%04x%04x\\FileDescription", tr->lang, tr->cp );
+        if (query( data, key, (void **)&value, &n ) && n > 1 && *value) lstrcpynW( name, value, size );
+    }
+    free( data );
+}
+
+static BOOL sg_button_menu( struct taskbar_button *win, HWND button, LPARAM lparam )
+{
+    static const WCHAR report[] = L"Z:\\usr\\libexec\\stained-glass\\shell\\sg-bugreport64.exe";
+    struct taskbar_button *leader = win->group ? win->group : win, *other;
+    BOOL group = win->combined && leader->group_count > 1;
+    POINT pt = { (short)LOWORD(lparam), (short)HIWORD(lparam) };
+    WCHAR name[MAX_PATH], args[32];
+    HMENU menu;
+    int cmd;
+
+    if (GetKeyState( VK_SHIFT ) < 0) return FALSE;
+    if (lparam == -1) { RECT rc; GetWindowRect( button, &rc ); pt.x = rc.left; pt.y = rc.top; }
+    menu = CreatePopupMenu();
+    if (win->exe[0])
+    {
+        sg_exe_display_name( win->exe, name, ARRAY_SIZE(name) );
+        AppendMenuW( menu, MF_STRING, SG_BTN_LAUNCH, name );
+        AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    }
+    if (GetFileAttributesW( report ) != INVALID_FILE_ATTRIBUTES)
+        AppendMenuW( menu, MF_STRING, SG_BTN_REPORT, L"&Report a problem..." );
+    AppendMenuW( menu, MF_STRING, SG_BTN_CLOSE, group ? L"C&lose all windows" : L"C&lose window" );
+
+    SetForegroundWindow( tray_window );
+    cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_NONOTIFY | TPM_RIGHTBUTTON |
+                          (sg_bar.edge == ABE_TOP ? TPM_TOPALIGN : TPM_BOTTOMALIGN),
+                          pt.x, pt.y, 0, tray_window, NULL );
+    DestroyMenu( menu );
+
+    switch (cmd)
+    {
+    case SG_BTN_LAUNCH:
+        ShellExecuteW( NULL, NULL, win->exe, NULL, NULL, SW_SHOWNORMAL );
+        break;
+    case SG_BTN_REPORT:
+        swprintf( args, ARRAY_SIZE(args), L"--window %Iu", (ULONG_PTR)win->hwnd );
+        ShellExecuteW( NULL, NULL, report, args, NULL, SW_SHOWNORMAL );
+        break;
+    case SG_BTN_CLOSE:
+        if (!group) PostMessageW( win->hwnd, WM_SYSCOMMAND, SC_CLOSE, 0 );
+        else LIST_FOR_EACH_ENTRY( other, &taskbar_buttons, struct taskbar_button, entry )
+            if (other->hwnd && other->visible && other->group == leader)
+                PostMessageW( other->hwnd, WM_SYSCOMMAND, SC_CLOSE, 0 );
+        break;
+    }
+    return TRUE;
+}
+
 static void show_taskbar_contextmenu( HWND button, LPARAM lparam )
 {
     ULONG_PTR id = GetWindowLongPtrW( button, GWLP_ID );
@@ -1689,6 +1773,7 @@
 
     /* an elevated program is not driven from the session (UIPI) */
     if (win && win->elevated) return;
+    if (win && sg_button_menu( win, button, lparam )) return;
     if (win) SendNotifyMessageW( (HWND)id, WM_POPUPSYSTEMMENU, 0, lparam );
     /* Stained Glass OS: Start's is the quick link menu (Win+X); the bar
      * itself, its search and Task View buttons have the taskbar's */
