From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: XY focus strategies and per-direction targets

Where an arrow key moves the focus can now be steered as XAML allows: a control's XYFocusLeft, XYFocusRight, XYFocusUp and XYFocusDown send that key straight to the element they name, and the XYFocusUp/Down/Left/RightNavigationStrategy of an element (Auto takes its container's) chooses how the nearest one is found -- Projection only looks at elements in line, NavigationDirectionDistance takes the nearest edge to edge, RectilinearDistance the shortest distance along and across. Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/control.c b/dlls/windows.ui.xaml/control.c
index bf58b31..d3f8840 100644
--- a/dlls/windows.ui.xaml/control.c
+++ b/dlls/windows.ui.xaml/control.c
@@ -39,7 +39,7 @@ static struct xaml_property *prop_font_size, *prop_font_family, *prop_font_weigh
                             *prop_tab_index, *prop_tab_navigation, *prop_template, *prop_padding, *prop_hcontent,
                             *prop_vcontent, *prop_background, *prop_border_thickness, *prop_border_brush,
                             *prop_default_style_key, *prop_is_text_scale_factor_enabled, *prop_use_system_focus_visuals,
-                            *prop_corner_radius;
+                            *prop_corner_radius, *prop_xy_left, *prop_xy_right, *prop_xy_up, *prop_xy_down;
 static struct xaml_property *prop_content, *prop_content_template, *prop_content_template_selector,
                             *prop_content_transitions, *prop_user_content;
 static struct xaml_property *prop_frame, *prop_top_app_bar, *prop_bottom_app_bar, *prop_navigation_cache_mode;
@@ -507,7 +507,38 @@ static const void *control3_vtbl[] =
     [IControl3_SetUseSystemFocusVisuals] = control3_put_UseSystemFocusVisuals,
 };
 
-static const void *control4_vtbl[] = { IControl4_STUBS };
+OBJECT_PROP(control4, XYFocusLeft, prop_xy_left)
+OBJECT_PROP(control4, XYFocusRight, prop_xy_right)
+OBJECT_PROP(control4, XYFocusUp, prop_xy_up)
+OBJECT_PROP(control4, XYFocusDown, prop_xy_down)
+
+static const void *control4_vtbl[] =
+{
+    IControl4_STUBS,
+    [IControl4_XYFocusLeft] = control4_get_XYFocusLeft,
+    [IControl4_SetXYFocusLeft] = control4_put_XYFocusLeft,
+    [IControl4_XYFocusRight] = control4_get_XYFocusRight,
+    [IControl4_SetXYFocusRight] = control4_put_XYFocusRight,
+    [IControl4_XYFocusUp] = control4_get_XYFocusUp,
+    [IControl4_SetXYFocusUp] = control4_put_XYFocusUp,
+    [IControl4_XYFocusDown] = control4_get_XYFocusDown,
+    [IControl4_SetXYFocusDown] = control4_put_XYFocusDown,
+};
+
+/* where an arrow key goes from a control, when its XYFocusLeft/Right/Up/Down says (no reference) */
+struct uielem *xaml_xy_focus_override( struct uielem *elem, UINT vk )
+{
+    struct xaml_property *prop = vk == VK_LEFT ? prop_xy_left : vk == VK_RIGHT ? prop_xy_right :
+                                 vk == VK_UP ? prop_xy_up : prop_xy_down;
+    IInspectable *target = NULL;
+    struct uielem *ret;
+
+    if (!prop || !is_control( &elem->d )) return NULL;
+    dobj_get_value( &elem->d, prop, &target );
+    ret = target ? uielem_from_inspectable( target ) : NULL;
+    if (target) IInspectable_Release( target );
+    return ret;
+}
 static const void *control5_vtbl[] = { IControl5_STUBS };
 
 static HRESULT WINAPI control7_get_CornerRadius( struct xiface *iface, struct xcorner *value )
@@ -1024,6 +1055,10 @@ static BOOL WINAPI init_controls( INIT_ONCE *once, void *param, void **context )
     prop_is_tab_stop = xaml_property_register( ctl, L"IsTabStop", L"Boolean", xbox_boolean( TRUE ), FALSE, NULL );
     prop_is_enabled = xaml_property_register( ctl, L"IsEnabled", L"Boolean", xbox_boolean( TRUE ), FALSE, visual_changed );
     prop_tab_index = xaml_property_register( ctl, L"TabIndex", L"Int32", xbox_int32( INT_MAX ), FALSE, NULL );
+    prop_xy_left = xaml_property_register( ctl, L"XYFocusLeft", L"Windows.UI.Xaml.DependencyObject", NULL, FALSE, NULL );
+    prop_xy_right = xaml_property_register( ctl, L"XYFocusRight", L"Windows.UI.Xaml.DependencyObject", NULL, FALSE, NULL );
+    prop_xy_up = xaml_property_register( ctl, L"XYFocusUp", L"Windows.UI.Xaml.DependencyObject", NULL, FALSE, NULL );
+    prop_xy_down = xaml_property_register( ctl, L"XYFocusDown", L"Windows.UI.Xaml.DependencyObject", NULL, FALSE, NULL );
     prop_tab_navigation = xaml_property_register( ctl, L"TabNavigation", L"Windows.UI.Xaml.Input.KeyboardNavigationMode",
                                                   xbox_int32( 0 ), FALSE, NULL );
     prop_template = xaml_property_register( ctl, L"Template", L"Windows.UI.Xaml.Controls.ControlTemplate", NULL, FALSE, template_changed );
diff --git a/dlls/windows.ui.xaml/element.c b/dlls/windows.ui.xaml/element.c
index 94cec62..2bc39b2 100644
--- a/dlls/windows.ui.xaml/element.c
+++ b/dlls/windows.ui.xaml/element.c
@@ -36,6 +36,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(xaml);
 /* ---- properties ---- */
 
 static struct xaml_property *prop_context_flyout, *prop_tab_focus_navigation, *prop_xy_keyboard, *prop_access_key;
+static struct xaml_property *prop_xy_strategy[4];   /* Up, Down, Left, Right */
 static struct xaml_property *prop_access_key_scope, *prop_access_key_owner, *prop_exit_on_invoked, *prop_key_tip_placement,
                             *prop_key_tip_hoffset, *prop_key_tip_voffset;
 static struct xaml_property *prop_visibility, *prop_opacity, *prop_is_hit_test_visible, *prop_allow_drop,
@@ -106,6 +107,14 @@ static BOOL WINAPI init_elements( INIT_ONCE *once, void *param, void **context )
                                                      xbox_int32( 0 ), FALSE, NULL );
     prop_key_tip_hoffset = xaml_property_register( ui, L"KeyTipHorizontalOffset", L"Double", xbox_double( 0 ), FALSE, NULL );
     prop_key_tip_voffset = xaml_property_register( ui, L"KeyTipVerticalOffset", L"Double", xbox_double( 0 ), FALSE, NULL );
+    prop_xy_strategy[0] = xaml_property_register( ui, L"XYFocusUpNavigationStrategy", L"Windows.UI.Xaml.Input.XYFocusNavigationStrategy",
+                                                  xbox_int32( 0 ), FALSE, NULL );
+    prop_xy_strategy[1] = xaml_property_register( ui, L"XYFocusDownNavigationStrategy", L"Windows.UI.Xaml.Input.XYFocusNavigationStrategy",
+                                                  xbox_int32( 0 ), FALSE, NULL );
+    prop_xy_strategy[2] = xaml_property_register( ui, L"XYFocusLeftNavigationStrategy", L"Windows.UI.Xaml.Input.XYFocusNavigationStrategy",
+                                                  xbox_int32( 0 ), FALSE, NULL );
+    prop_xy_strategy[3] = xaml_property_register( ui, L"XYFocusRightNavigationStrategy", L"Windows.UI.Xaml.Input.XYFocusNavigationStrategy",
+                                                  xbox_int32( 0 ), FALSE, NULL );
     prop_xy_keyboard = xaml_property_register( ui, L"XYFocusKeyboardNavigation", L"Windows.UI.Xaml.Input.XYFocusKeyboardNavigationMode",
                                                xbox_int32( 0 ), FALSE, NULL );
     prop_use_layout_rounding = xaml_property_register( ui, L"UseLayoutRounding", L"Boolean", xbox_boolean( TRUE ), FALSE, NULL );
@@ -774,6 +783,30 @@ static HRESULT WINAPI uie_put_##n( struct xiface *iface, INT32 value ) \
   hr = dobj_set_value( &elem_from_iface( iface )->d, prop, box ); IInspectable_Release( box ); return hr; }
 
 UIE_BOOL(IsAccessKeyScope, prop_access_key_scope, FALSE)
+UIE_ENUM(XYFocusUpNavigationStrategy, prop_xy_strategy[0])
+UIE_ENUM(XYFocusDownNavigationStrategy, prop_xy_strategy[1])
+UIE_ENUM(XYFocusLeftNavigationStrategy, prop_xy_strategy[2])
+UIE_ENUM(XYFocusRightNavigationStrategy, prop_xy_strategy[3])
+
+/* XYFocusNavigationStrategy for an arrow key: Auto (0) takes the parent's; Projection 1,
+ * NavigationDirectionDistance 2, RectilinearDistance 3 */
+INT32 xaml_xy_strategy( struct uielem *elem, UINT vk )
+{
+    int i = vk == VK_UP ? 0 : vk == VK_DOWN ? 1 : vk == VK_LEFT ? 2 : 3;
+    IInspectable *box;
+    INT32 mode;
+
+    xaml_elements_init();
+    for (; elem; elem = elem->parent)
+    {
+        box = NULL;
+        dobj_get_value( &elem->d, prop_xy_strategy[i], &box );
+        mode = xunbox_enum( box, NULL, 0 );
+        if (box) IInspectable_Release( box );
+        if (mode) return mode;
+    }
+    return 0;
+}
 UIE_BOOL(ExitDisplayModeOnAccessKeyInvoked, prop_exit_on_invoked, TRUE)
 UIE_ENUM(KeyTipPlacementMode, prop_key_tip_placement)
 UIE_DOUBLE(KeyTipHorizontalOffset, prop_key_tip_hoffset)
@@ -922,6 +955,14 @@ static const void *uielement5_vtbl[] =
     [IUIElement5_SetKeyTipHorizontalOffset] = uie_put_KeyTipHorizontalOffset,
     [IUIElement5_KeyTipVerticalOffset] = uie_get_KeyTipVerticalOffset,
     [IUIElement5_SetKeyTipVerticalOffset] = uie_put_KeyTipVerticalOffset,
+    [IUIElement5_XYFocusUpNavigationStrategy] = uie_get_XYFocusUpNavigationStrategy,
+    [IUIElement5_SetXYFocusUpNavigationStrategy] = uie_put_XYFocusUpNavigationStrategy,
+    [IUIElement5_XYFocusDownNavigationStrategy] = uie_get_XYFocusDownNavigationStrategy,
+    [IUIElement5_SetXYFocusDownNavigationStrategy] = uie_put_XYFocusDownNavigationStrategy,
+    [IUIElement5_XYFocusLeftNavigationStrategy] = uie_get_XYFocusLeftNavigationStrategy,
+    [IUIElement5_SetXYFocusLeftNavigationStrategy] = uie_put_XYFocusLeftNavigationStrategy,
+    [IUIElement5_XYFocusRightNavigationStrategy] = uie_get_XYFocusRightNavigationStrategy,
+    [IUIElement5_SetXYFocusRightNavigationStrategy] = uie_put_XYFocusRightNavigationStrategy,
     [IUIElement5_XYFocusKeyboardNavigation] = uielement5_get_XYFocusKeyboardNavigation,
     [IUIElement5_SetXYFocusKeyboardNavigation] = uielement5_put_XYFocusKeyboardNavigation,
     [IUIElement5_TabFocusNavigation] = uielement5_get_TabFocusNavigation,
diff --git a/dlls/windows.ui.xaml/focus.c b/dlls/windows.ui.xaml/focus.c
index b68e6be..d48dada 100644
--- a/dlls/windows.ui.xaml/focus.c
+++ b/dlls/windows.ui.xaml/focus.c
@@ -547,10 +547,23 @@ static BOOL move_focus_xy( HWND hwnd, UINT vk )
     unsigned int count = 0, i;
     struct uielem *best = NULL;
     FLOAT best_score = 0;
+    INT32 strategy;
 
     if (!focus || xaml_is_text_box( focus ) || !(scope = xy_scope( focus, vk ))) return FALSE;
 #ifdef SG_MUTANT_XAML_NO_XY_FOCUS
     return FALSE;
+#endif
+    /* the control's own XYFocusLeft/Right/Up/Down first */
+    if ((best = xaml_xy_focus_override( focus, vk )) && xaml_is_focus_target( best ) && tab_visible( best ))
+    {
+        TRACE( "arrow %#x to %p (its XYFocus)\n", vk, best );
+        xaml_focus_element_state( best, hwnd, 2 );
+        return TRUE;
+    }
+    best = NULL;
+    strategy = xaml_xy_strategy( focus, vk );
+#ifdef SG_MUTANT_XAML_XY_AUTO_ONLY
+    strategy = 0;
 #endif
     if (!(targets = malloc( MAX_TAB * sizeof(*targets) ))) return FALSE;
     collect_xy( scope, targets, &count, MAX_TAB );
@@ -583,8 +596,25 @@ static BOOL move_focus_xy( HWND hwnd, UINT vk )
             overlap = fminf( t->x + t->w, cur.x + cur.w ) - fmaxf( t->x, cur.x );
             cross = fabsf( (t->x + t->w / 2) - (cur.x + cur.w / 2) );
         }
-        /* those in line first, then the nearest */
-        score = fmaxf( primary, 0 ) + (overlap > 0 ? 0 : 10000) + cross * 2;
+        switch (strategy)
+        {
+        case 1:   /* Projection: only those in line, the nearest */
+            if (overlap <= 0) continue;
+            score = fmaxf( primary, 0 );
+            break;
+        case 2:   /* NavigationDirectionDistance: the nearest edge to edge */
+        {
+            FLOAT gap = overlap > 0 ? 0 : -overlap;
+            score = sqrtf( fmaxf( primary, 0 ) * fmaxf( primary, 0 ) + gap * gap );
+            break;
+        }
+        case 3:   /* RectilinearDistance: along it plus across, centre to centre */
+            score = fmaxf( primary, 0 ) + cross;
+            break;
+        default:  /* Auto: those in line first, then the nearest */
+            score = fmaxf( primary, 0 ) + (overlap > 0 ? 0 : 10000) + cross * 2;
+            break;
+        }
         if (!best || score < best_score)
         {
             best = t->elem;
