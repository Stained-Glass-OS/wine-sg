From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: generic public and private key blob types

bcrypt: BCryptExportKey and BCryptImportKeyPair handle the generic blob types
of the documentation. BCRYPT_PUBLIC_KEY_BLOB and BCRYPT_PRIVATE_KEY_BLOB export
the key's own public or private blob, whatever its algorithm (RSA, DSA, DH and
the ECDSA/ECDH curves), and a BCRYPT_PRIVATE_KEY_BLOB is imported by the magic
in its header, as a BCRYPT_PUBLIC_KEY_BLOB already was.
---
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -1395,6 +1395,38 @@ static NTSTATUS key_export( struct key *key, const WCHAR *type, UCHAR *output, U
         return UNIX_CALL( key_asymmetric_export, &params );
     }
 
+    else if (!wcscmp( type, BCRYPT_PUBLIC_KEY_BLOB ) || !wcscmp( type, BCRYPT_PRIVATE_KEY_BLOB ))
+    {
+        /* the generic blob types are the key's own, whatever its algorithm */
+        BOOL pub = !wcscmp( type, BCRYPT_PUBLIC_KEY_BLOB );
+        const WCHAR *own = NULL;
+
+#ifndef SG_MUTANT_BCRYPT_GENERIC_BLOB
+        switch (key->alg_id)
+        {
+        case ALG_ID_RSA:
+        case ALG_ID_RSA_SIGN:
+            own = pub ? BCRYPT_RSAPUBLIC_BLOB : BCRYPT_RSAPRIVATE_BLOB;
+            break;
+        case ALG_ID_DSA:
+            own = pub ? BCRYPT_DSA_PUBLIC_BLOB : BCRYPT_DSA_PRIVATE_BLOB;
+            break;
+        case ALG_ID_DH:
+            own = pub ? BCRYPT_DH_PUBLIC_BLOB : BCRYPT_DH_PRIVATE_BLOB;
+            break;
+        case ALG_ID_ECDH_P256:
+        case ALG_ID_ECDH_P384:
+        case ALG_ID_ECDSA_P256:
+        case ALG_ID_ECDSA_P384:
+            own = pub ? BCRYPT_ECCPUBLIC_BLOB : BCRYPT_ECCPRIVATE_BLOB;
+            break;
+        default:
+            break;
+        }
+#endif
+        if (own) return key_export( key, own, output, output_len, size );
+    }
+
     FIXME( "unsupported key type %s\n", debugstr_w(type) );
     return STATUS_NOT_IMPLEMENTED;
 }
@@ -2258,6 +2290,31 @@ static const WCHAR *resolve_blob_type( const WCHAR *type, UCHAR *input, ULONG in
     BCRYPT_KEY_BLOB *blob = (BCRYPT_KEY_BLOB *)input;
 
     if (!type) return NULL;
+#ifndef SG_MUTANT_BCRYPT_GENERIC_IMPORT
+    if (!wcscmp( type, BCRYPT_PRIVATE_KEY_BLOB ))
+    {
+        if (input_len < sizeof(*blob)) return NULL;
+        switch (blob->Magic)
+        {
+        case BCRYPT_ECDH_PRIVATE_P256_MAGIC:
+        case BCRYPT_ECDH_PRIVATE_P384_MAGIC:
+        case BCRYPT_ECDSA_PRIVATE_P256_MAGIC:
+        case BCRYPT_ECDSA_PRIVATE_P384_MAGIC:
+            return BCRYPT_ECCPRIVATE_BLOB;
+        case BCRYPT_RSAPRIVATE_MAGIC:
+            return BCRYPT_RSAPRIVATE_BLOB;
+        case BCRYPT_RSAFULLPRIVATE_MAGIC:
+            return BCRYPT_RSAFULLPRIVATE_BLOB;
+        case BCRYPT_DSA_PRIVATE_MAGIC:
+            return BCRYPT_DSA_PRIVATE_BLOB;
+        case BCRYPT_DH_PRIVATE_MAGIC:
+            return BCRYPT_DH_PRIVATE_BLOB;
+        default:
+            FIXME( "unsupported key magic %#lx\n", blob->Magic );
+            return NULL;
+        }
+    }
+#endif
     if (wcscmp( type, BCRYPT_PUBLIC_KEY_BLOB )) return type;
     if (input_len < sizeof(*blob)) return NULL;
 
--- a/dlls/bcrypt/tests/bcrypt.c
+++ b/dlls/bcrypt/tests/bcrypt.c
@@ -4323,6 +4323,74 @@ static void test_RC4(void)
     ok(status == STATUS_SUCCESS, "got %#lx\n", status);
 }
 
+static void test_generic_key_blobs(void)
+{
+    static const struct
+    {
+        const WCHAR *alg;
+        ULONG bits;
+        const WCHAR *public_blob;
+        const WCHAR *private_blob;
+    } tests[] =
+    {
+        { BCRYPT_RSA_ALGORITHM, 512, BCRYPT_RSAPUBLIC_BLOB, BCRYPT_RSAPRIVATE_BLOB },
+        { BCRYPT_ECDSA_P256_ALGORITHM, 256, BCRYPT_ECCPUBLIC_BLOB, BCRYPT_ECCPRIVATE_BLOB },
+        { BCRYPT_ECDH_P384_ALGORITHM, 384, BCRYPT_ECCPUBLIC_BLOB, BCRYPT_ECCPRIVATE_BLOB },
+        { BCRYPT_DSA_ALGORITHM, 512, BCRYPT_DSA_PUBLIC_BLOB, NULL },
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        BCRYPT_ALG_HANDLE alg;
+        BCRYPT_KEY_HANDLE key, imported;
+        UCHAR own[1024], generic[1024];
+        ULONG own_size, generic_size;
+        NTSTATUS ret;
+
+        ret = BCryptOpenAlgorithmProvider(&alg, tests[i].alg, NULL, 0);
+        ok(!ret, "%s: got %#lx.\n", debugstr_w(tests[i].alg), ret);
+        ret = BCryptGenerateKeyPair(alg, &key, tests[i].bits, 0);
+        ok(!ret, "%s: got %#lx.\n", debugstr_w(tests[i].alg), ret);
+        ret = BCryptFinalizeKeyPair(key, 0);
+        ok(!ret, "%s: got %#lx.\n", debugstr_w(tests[i].alg), ret);
+
+        /* the generic public blob is the key's own public blob */
+        ret = BCryptExportKey(key, NULL, tests[i].public_blob, own, sizeof(own), &own_size, 0);
+        ok(!ret, "%s: got %#lx.\n", debugstr_w(tests[i].alg), ret);
+        ret = BCryptExportKey(key, NULL, BCRYPT_PUBLIC_KEY_BLOB, generic, sizeof(generic), &generic_size, 0);
+        ok(!ret, "%s: got %#lx.\n", debugstr_w(tests[i].alg), ret);
+        ok(generic_size == own_size && !memcmp(generic, own, own_size), "%s: blobs differ.\n",
+                debugstr_w(tests[i].alg));
+        generic_size = 0;
+        ret = BCryptExportKey(key, NULL, BCRYPT_PUBLIC_KEY_BLOB, NULL, 0, &generic_size, 0);
+        ok(!ret && generic_size == own_size, "%s: got %#lx, size %lu.\n", debugstr_w(tests[i].alg), ret, generic_size);
+
+        if (tests[i].private_blob)
+        {
+            ret = BCryptExportKey(key, NULL, tests[i].private_blob, own, sizeof(own), &own_size, 0);
+            ok(!ret, "%s: got %#lx.\n", debugstr_w(tests[i].alg), ret);
+            ret = BCryptExportKey(key, NULL, BCRYPT_PRIVATE_KEY_BLOB, generic, sizeof(generic), &generic_size, 0);
+            ok(!ret, "%s: got %#lx.\n", debugstr_w(tests[i].alg), ret);
+            ok(generic_size == own_size && !memcmp(generic, own, own_size), "%s: blobs differ.\n",
+                    debugstr_w(tests[i].alg));
+
+            /* and the generic private blob is imported by its magic */
+            ret = BCryptImportKeyPair(alg, NULL, BCRYPT_PRIVATE_KEY_BLOB, &imported, generic, generic_size, 0);
+            ok(!ret, "%s: got %#lx.\n", debugstr_w(tests[i].alg), ret);
+            if (!ret)
+            {
+                ret = BCryptExportKey(imported, NULL, tests[i].private_blob, own, sizeof(own), &own_size, 0);
+                ok(!ret && own_size == generic_size && !memcmp(own, generic, own_size), "%s: got %#lx.\n",
+                        debugstr_w(tests[i].alg), ret);
+                BCryptDestroyKey(imported);
+            }
+        }
+        BCryptDestroyKey(key);
+        BCryptCloseAlgorithmProvider(alg, 0);
+    }
+}
+
 START_TEST(bcrypt)
 {
     HMODULE module;
@@ -4352,6 +4420,7 @@ START_TEST(bcrypt)
     test_RSA_SIGN();
     test_ECDH();
     test_DH();
+    test_generic_key_blobs();
     test_BCryptEnumContextFunctions();
     test_BCryptSignHash();
     test_BCryptEnumAlgorithms();
