-static HRESULT create_uia_pattern(struct uia_element *element, PATTERNID pattern_id, IUnknown **out)
+/*
+ * A cached pattern object (cached = TRUE) holds no pattern from the provider:
+ * its Cached* values come from the element's cache, and the calls that would
+ * act on the element fail.
+ */
