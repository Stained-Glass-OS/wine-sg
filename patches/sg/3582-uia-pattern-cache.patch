+/*
+ * A cached pattern is only there for a pattern the element was cached with; the
+ * result is NULL if the node did not support it.
+ */
+static HRESULT uia_element_get_cached_pattern(struct uia_element *element, PATTERNID pattern_id, IUnknown **out)
+{
+    const struct uia_cache_pattern_info *info = uia_cache_pattern_info_from_id(pattern_id);
+    int i;
+
+    *out = NULL;
+    for (i = 0; i < element->cached_patterns_count; i++)
+    {
+        if (element->cached_patterns[i] == pattern_id)
+            break;
+    }
+    if (i == element->cached_patterns_count)
+        return UIA_E_NOTSUPPORTED;
+
+    if (info)
+    {
+        struct uia_cache_property *prop;
+        int prop_id = info->avail_prop_id;
+
+        prop = bsearch(&prop_id, element->cached_props, element->cached_props_count, sizeof(*prop),
+                uia_cached_property_id_compare);
+        if (!prop || V_VT(&prop->prop_val) != VT_BOOL || !V_BOOL(&prop->prop_val))
+            return S_OK;
+    }
+    return create_uia_pattern(element, pattern_id, out, TRUE);
 }
 
