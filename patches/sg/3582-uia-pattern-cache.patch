+static void test_Element_cached_patterns(IUIAutomation *uia_iface)
+{
+    HWND hwnd = create_test_hwnd("test_Element_cached_patterns class");
+    IUIAutomationValuePattern *value_pattern;
+    IUIAutomationCacheRequest *cache_req;
+    IUIAutomationElement *element, *element2;
+    IUnknown *unk;
+    BOOL tmp_bool;
+    BSTR tmp_bstr;
+    HRESULT hr;
+
+    element = create_test_element_from_hwnd(uia_iface, hwnd, TRUE);
+    Provider.value_pattern_data.is_supported = TRUE;
+    Provider.value_pattern_data.is_read_only = TRUE;
+
+    hr = IUIAutomation_CreateCacheRequest(uia_iface, &cache_req);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IUIAutomationCacheRequest_AddPattern(cache_req, 1);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomationCacheRequest_AddPattern(cache_req, UIA_ValuePatternId);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomationCacheRequest_AddPattern(cache_req, UIA_InvokePatternId);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    flush_method_sequence();
+
+    /* An element that was not cached has no cached patterns. */
+    unk = (void *)0xdeadbeef;
+    hr = IUIAutomationElement_GetCachedPattern(element, UIA_ValuePatternId, &unk);
+    ok(hr == UIA_E_NOTSUPPORTED, "Unexpected hr %#lx.\n", hr);
+    ok(!unk, "unk != NULL\n");
+    hr = IUIAutomationElement_GetCachedPattern(element, UIA_ValuePatternId, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+
+    element2 = NULL;
+    hr = IUIAutomationElement_BuildUpdatedCache(element, cache_req, &element2);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!!element2, "element2 == NULL\n");
+    flush_method_sequence();
+
+    /* Value is supported by the provider: its properties were cached too. */
+    value_pattern = NULL;
+    hr = IUIAutomationElement_GetCachedPatternAs(element2, UIA_ValuePatternId, &IID_IUIAutomationValuePattern,
+            (void **)&value_pattern);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!!value_pattern, "value_pattern == NULL\n");
+    if (value_pattern)
+    {
+        tmp_bool = FALSE;
+        hr = IUIAutomationValuePattern_get_CachedIsReadOnly(value_pattern, &tmp_bool);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(tmp_bool == TRUE, "Unexpected IsReadOnly %d\n", tmp_bool);
+
+        tmp_bstr = NULL;
+        hr = IUIAutomationValuePattern_get_CachedValue(value_pattern, &tmp_bstr);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(tmp_bstr && !wcscmp(tmp_bstr, L"cached value"), "Unexpected value %s\n", wine_dbgstr_w(tmp_bstr));
+        SysFreeString(tmp_bstr);
+        IUIAutomationValuePattern_Release(value_pattern);
+    }
+    flush_method_sequence();
+
+    /* Invoke was requested but is not supported: no object. */
+    unk = (void *)0xdeadbeef;
+    hr = IUIAutomationElement_GetCachedPattern(element2, UIA_InvokePatternId, &unk);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!unk, "unk != NULL\n");
+
+    /* Toggle was never requested. */
+    unk = (void *)0xdeadbeef;
+    hr = IUIAutomationElement_GetCachedPattern(element2, UIA_TogglePatternId, &unk);
+    ok(hr == UIA_E_NOTSUPPORTED, "Unexpected hr %#lx.\n", hr);
+    ok(!unk, "unk != NULL\n");
+    flush_method_sequence();
+
+    /* AutomationElementMode_None: only cached values are available. */
+    IUIAutomationElement_Release(element2);
+    hr = IUIAutomationCacheRequest_put_AutomationElementMode(cache_req, AutomationElementMode_None);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomationCacheRequest_AddProperty(cache_req, UIA_IsKeyboardFocusablePropertyId);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    element2 = NULL;
+    hr = IUIAutomationElement_BuildUpdatedCache(element, cache_req, &element2);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    flush_method_sequence();
+    if (element2)
+    {
+        VARIANT v;
+
+        VariantInit(&v);
+        hr = IUIAutomationElement_GetCachedPropertyValueEx(element2, UIA_IsKeyboardFocusablePropertyId, TRUE, &v);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        VariantClear(&v);
+        hr = IUIAutomationElement_GetCurrentPropertyValueEx(element2, UIA_IsKeyboardFocusablePropertyId, TRUE, &v);
+        ok(hr == UIA_E_NOTSUPPORTED, "Unexpected hr %#lx.\n", hr);
+        unk = (void *)0xdeadbeef;
+        hr = IUIAutomationElement_GetCurrentPattern(element2, UIA_ValuePatternId, &unk);
+        ok(hr == UIA_E_NOTSUPPORTED, "Unexpected hr %#lx.\n", hr);
+        hr = IUIAutomationElement_GetCachedPattern(element2, UIA_ValuePatternId, &unk);
+        ok(hr == S_OK && !!unk, "Unexpected hr %#lx, unk %p.\n", hr, unk);
+        if (unk) IUnknown_Release(unk);
+        IUIAutomationElement_Release(element2);
+    }
+    flush_method_sequence();
+
+    IUIAutomationElement_Release(element);
+    IUIAutomationCacheRequest_Release(cache_req);
+    ok(Provider.ref == 1, "Unexpected refcnt %ld\n", Provider.ref);
+    initialize_provider(&Provider, ProviderOptions_ServerSideProvider, NULL, FALSE);
+    DestroyWindow(hwnd);
+    UnregisterClassA("test_Element_cached_patterns class", NULL);
+}
