+const struct uia_cache_pattern_info *uia_cache_pattern_info_from_id(PATTERNID pattern_id)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(uia_cache_patterns); i++)
+    {
+        if (uia_cache_patterns[i].pattern_id == pattern_id)
+            return &uia_cache_patterns[i];
+    }
+    return NULL;
+}
+
+/*
+ * The cell of a cached pattern: empty when the node does not support the
+ * pattern, else an array holding the values of the properties the pattern
+ * caches (in the order of the pattern's property list).
+ */
+static HRESULT uia_cache_pattern_value(HUIANODE node, PATTERNID pattern_id, VARIANT *ret)
+{
+    const struct uia_cache_pattern_info *info = uia_cache_pattern_info_from_id(pattern_id);
+    SAFEARRAYBOUND sabound;
+    SAFEARRAY *sa;
+    HRESULT hr;
+    VARIANT v;
+    LONG idx;
+    int i;
+
+    VariantInit(ret);
+#ifdef SG_MUTANT_UIA_PATTERN_CACHE
+    return S_OK;
+#endif
+    {
+        HUIAPATTERNOBJECT obj;
+
+        /* Ask the providers for the pattern itself. */
+        if (FAILED(UiaGetPatternProvider(node, pattern_id, &obj)) || !obj)
+            return S_OK;
+        UiaPatternRelease(obj);
+    }
+
+    sabound.lLbound = 0;
+    sabound.cElements = info ? info->props_count : 0;
+    if (!(sa = SafeArrayCreate(VT_VARIANT, 1, &sabound)))
+        return E_OUTOFMEMORY;
+    for (i = 0; info && i < info->props_count; i++)
+    {
+        idx = i;
+        if (FAILED(UiaGetPropertyValue(node, info->props[i], &v)))
+            VariantInit(&v);
+        hr = SafeArrayPutElement(sa, &idx, &v);
+        VariantClear(&v);
+        if (FAILED(hr))
+        {
+            SafeArrayDestroy(sa);
+            return hr;
+        }
+    }
+    V_VT(ret) = VT_ARRAY | VT_VARIANT;
+    V_ARRAY(ret) = sa;
+    return S_OK;
+}
