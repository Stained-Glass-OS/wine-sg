+static HRESULT uia_cache_props_append(struct uia_cache_property **props, int *count, int *size, int prop_id,
+        const VARIANT *val)
+{
+    if (*count == *size)
+    {
+        struct uia_cache_property *new_props;
+        int new_size = max(*size * 2, 8);
+
+        if (!(new_props = realloc(*props, new_size * sizeof(*new_props))))
+            return E_OUTOFMEMORY;
+        *props = new_props;
+        *size = new_size;
+    }
+    (*props)[*count].prop_id = prop_id;
+    VariantInit(&(*props)[*count].prop_val);
+    if (val)
+        VariantCopy(&(*props)[*count].prop_val, val);
+    (*count)++;
+    return S_OK;
+}
