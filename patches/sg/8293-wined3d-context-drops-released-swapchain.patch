From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wined3d: contexts drop a released swapchain

A context that drew to an additional swapchain moves to it and kept pointing at it, and at its draw buffers, after it was released: the next draw read the window of the freed swapchain ("Failed to get a device context for window" with a heap address). Sweet Home 3D's Java2D drops a Direct3D 9 swapchain per resized component. When a swapchain goes, the contexts on it go back to the device's first swapchain and forget its draw buffers.
---
--- a/dlls/wined3d/swapchain.c
+++ b/dlls/wined3d/swapchain.c
@@ -158,6 +158,32 @@
             wined3d_device_uninit_3d(device);
         wined3d_cs_finish(device->cs, WINED3D_CS_QUEUE_DEFAULT);
 
+#ifndef SG_MUTANT_CONTEXT_KEEPS_SWAPCHAIN
+        /* (wine-sg 8293) a context that drew to this swapchain moved to it (wined3d_context_gl_activate) and
+         * kept pointing at it: the next offscreen draw read the window of the freed swapchain ("Failed to
+         * get a device context for window" with a heap address; Sweet Home 3D's Java2D drops a swapchain per
+         * resized component).  It goes back to the device's first swapchain.  The command stream is idle. */
+        {
+            struct wined3d_swapchain *primary = device->swapchain_count && device->swapchains[0] != swapchain
+                    ? device->swapchains[0] : NULL;
+            unsigned int i;
+
+            for (i = 0; i < device->context_count; ++i)
+            {
+                struct wined3d_context *context = device->contexts[i];
+
+                if (context->swapchain == swapchain)
+                    context->swapchain = primary;
+                /* its draw buffers go with it: the context would move back to it through them */
+                if (context->current_rt.texture && context->current_rt.texture->swapchain == swapchain)
+                {
+                    context->current_rt.texture = NULL;
+                    context->current_rt.sub_resource_idx = 0;
+                }
+            }
+        }
+#endif
+
         swapchain->parent_ops->wined3d_object_destroyed(swapchain->parent);
         swapchain->device->adapter->adapter_ops->adapter_destroy_swapchain(swapchain);
 
