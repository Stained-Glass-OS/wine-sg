From: Stained Glass OS <dev@stained-glass.example>
Subject: vcruntime140: __C_specific_handler_noexcept

The exception handler Microsoft's compiler gives a noexcept function that
holds __try blocks. It was a stub: every exception passing such a frame
called the stub, which raised another exception into the same frame, until
the stack overflowed -- Word died as its sign-in began.

Its __except and __finally scopes run as __C_specific_handler runs them; an
exception that would leave the function ends the program (std::terminate),
as nothing may leave a noexcept function. Unwinds pass through.

Gate: test/noexcept-gate.sh (make test-noexcept).

--- a/dlls/vcruntime140/misc.c
+++ b/dlls/vcruntime140/misc.c
@@ -54,3 +54,36 @@
 {
     return *__processing_throw();
 }
+
+#ifndef __i386__
+EXCEPTION_DISPOSITION WINAPI __C_specific_handler( EXCEPTION_RECORD *rec, void *frame, CONTEXT *context,
+                                                   DISPATCHER_CONTEXT *dispatch );
+
+/*********************************************************************
+ *              __C_specific_handler_noexcept
+ *
+ * Stained Glass OS: the handler of a noexcept function holding __try
+ * blocks. Its __except and __finally scopes run as __C_specific_handler
+ * runs them; an exception that would leave the function ends the program
+ * (std::terminate), as a noexcept function allows no exception out. It was
+ * a stub: each exception passing such a frame raised another one into the
+ * same frame, until the stack overflowed (Word, signing in to Office).
+ */
+EXCEPTION_DISPOSITION WINAPI __C_specific_handler_noexcept( EXCEPTION_RECORD *rec, void *frame,
+                                                            CONTEXT *context, DISPATCHER_CONTEXT *dispatch )
+{
+    EXCEPTION_DISPOSITION ret;
+
+    TRACE( "%p %p %p %p code %lx flags %lx\n", rec, frame, context, dispatch, rec->ExceptionCode, rec->ExceptionFlags );
+
+    ret = __C_specific_handler( rec, frame, context, dispatch );
+    if (ret == ExceptionContinueSearch && !(rec->ExceptionFlags & (EXCEPTION_UNWINDING | EXCEPTION_EXIT_UNWIND)))
+    {
+        void (CDECL *terminate)(void) = (void *)GetProcAddress( GetModuleHandleW( L"ucrtbase.dll" ), "terminate" );
+        ERR( "exception %lx leaves a noexcept function: terminating\n", rec->ExceptionCode );
+        if (terminate) terminate();
+        TerminateProcess( GetCurrentProcess(), 3 );
+    }
+    return ret;
+}
+#endif
--- a/dlls/vcruntime140/vcruntime140.spec
+++ b/dlls/vcruntime140/vcruntime140.spec
@@ -11,7 +11,7 @@
 @ stub __BuildCatchObject
 @ stub __BuildCatchObjectHelper
 @ stdcall -arch=!i386 __C_specific_handler(ptr long ptr ptr) ucrtbase.__C_specific_handler
-@ stub __C_specific_handler_noexcept
+@ stdcall -arch=!i386 __C_specific_handler_noexcept(ptr long ptr ptr)
 @ cdecl __CxxDetectRethrow(ptr) ucrtbase.__CxxDetectRethrow
 @ cdecl __CxxExceptionFilter(ptr ptr long ptr) ucrtbase.__CxxExceptionFilter
 @ cdecl -norelay __CxxFrameHandler(ptr ptr ptr ptr) ucrtbase.__CxxFrameHandler
--- a/dlls/vcruntime140/Makefile.in
+++ b/dlls/vcruntime140/Makefile.in
@@ -1,5 +1,6 @@
 MODULE    = vcruntime140.dll
 IMPORTLIB = vcruntime140
+IMPORTS   = ntdll
 
 SOURCES = \
 	misc.c
