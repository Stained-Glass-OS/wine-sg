index 67ea5df..fac0f53 100644
--- a/dlls/concrt140/details.c
+++ b/dlls/concrt140/details.c
@@ -339,6 +339,133 @@ bool __thiscall _Concurrent_queue_base_v4__Internal_pop_if_present(
     return TRUE;
 }
 
+/* the iterator: a position between the queue's head and tail */
+typedef struct
+{
+    const _Concurrent_queue_base_v4 *queue;
+    size_t pos;
+} queue_iterator_rep;
+
+typedef struct
+{
+    queue_iterator_rep *rep;
+    void *item;
+} _Concurrent_queue_iterator_base_v4;
+
+/* the item at a position: in sub-queue pos % QUEUES_NO, slot pos / QUEUES_NO;
+ * the items of a page follow its header */
+static void *queue_iterator_item(const queue_iterator_rep *rep)
+{
+    const _Concurrent_queue_base_v4 *queue = rep->queue;
+    const threadsafe_queue *q;
+    size_t id, page_id, first;
+    _Page *p;
+
+    if (rep->pos >= queue->data->tail_pos) return NULL;
+    q = queue->data->queues + rep->pos % QUEUES_NO;
+    id = rep->pos / QUEUES_NO;
+    page_id = id & ~(queue->alloc_count - 1);
+    first = q->head_pos & ~(queue->alloc_count - 1);
+    for (p = q->head; p && first < page_id; first += queue->alloc_count) p = p->_Next;
+    if (!p) return NULL;
+    return (char *)p + offsetof(_Page, data) + (id - page_id) * queue->item_size;
+}
+
+/* ??0_Concurrent_queue_iterator_base_v4@details@Concurrency@@IAE@ABV_Concurrent_queue_base_v4@12@@Z */
+/* ??0_Concurrent_queue_iterator_base_v4@details@Concurrency@@IEAA@AEBV_Concurrent_queue_base_v4@12@@Z */
+DEFINE_THISCALL_WRAPPER(_Concurrent_queue_iterator_base_v4_ctor, 8)
+_Concurrent_queue_iterator_base_v4* __thiscall _Concurrent_queue_iterator_base_v4_ctor(
+        _Concurrent_queue_iterator_base_v4 *this, const _Concurrent_queue_base_v4 *queue)
+{
+    TRACE("(%p %p)\n", this, queue);
+
+    this->rep = operator_new(sizeof(*this->rep));
+    this->rep->queue = queue;
+    this->rep->pos = queue->data->head_pos;
+    this->item = queue_iterator_item(this->rep);
+    return this;
+}
+
+/* ??1_Concurrent_queue_iterator_base_v4@details@Concurrency@@IAE@XZ */
+/* ??1_Concurrent_queue_iterator_base_v4@details@Concurrency@@IEAA@XZ */
+DEFINE_THISCALL_WRAPPER(_Concurrent_queue_iterator_base_v4_dtor, 4)
+void __thiscall _Concurrent_queue_iterator_base_v4_dtor(_Concurrent_queue_iterator_base_v4 *this)
+{
+    TRACE("(%p)\n", this);
+    operator_delete(this->rep);
+    this->rep = NULL;
+}
+
+/* ?_Assign@_Concurrent_queue_iterator_base_v4@details@Concurrency@@IAEXABV123@@Z */
+/* ?_Assign@_Concurrent_queue_iterator_base_v4@details@Concurrency@@IEAAXAEBV123@@Z */
+DEFINE_THISCALL_WRAPPER(_Concurrent_queue_iterator_base_v4__Assign, 8)
+void __thiscall _Concurrent_queue_iterator_base_v4__Assign(
+        _Concurrent_queue_iterator_base_v4 *this, const _Concurrent_queue_iterator_base_v4 *rhs)
+{
+    TRACE("(%p %p)\n", this, rhs);
+
+    if (this == rhs) return;
+    if (rhs->rep)
+    {
+        if (!this->rep) this->rep = operator_new(sizeof(*this->rep));
+        *this->rep = *rhs->rep;
+    }
+    else
+    {
+        operator_delete(this->rep);
+        this->rep = NULL;
+    }
+    this->item = rhs->item;
+}
+
+/* ?_Advance@_Concurrent_queue_iterator_base_v4@details@Concurrency@@IAEXXZ */
+/* ?_Advance@_Concurrent_queue_iterator_base_v4@details@Concurrency@@IEAAXXZ */
+DEFINE_THISCALL_WRAPPER(_Concurrent_queue_iterator_base_v4__Advance, 4)
+void __thiscall _Concurrent_queue_iterator_base_v4__Advance(_Concurrent_queue_iterator_base_v4 *this)
+{
+    TRACE("(%p)\n", this);
+
+    if (!this->rep || !this->item) return;
+#ifndef SG_MUTANT_QUEUE_ITER_NO_ADVANCE
+    this->rep->pos++;
+#endif
+    this->item = queue_iterator_item(this->rep);
+}
+
+/* The allocator of the concurrent containers: blocks that start on a cache
+ * line of their own (no false sharing). */
+#define NFS_LINE_SIZE 128
+
+/* ?NFS_GetLineSize@details@Concurrency@@YAIXZ */
+/* ?NFS_GetLineSize@details@Concurrency@@YA_KXZ */
+size_t __cdecl NFS_GetLineSize(void)
+{
+    return NFS_LINE_SIZE;
+}
+
+/* ?NFS_Allocate@details@Concurrency@@YAPAXIIPAX@Z */
+/* ?NFS_Allocate@details@Concurrency@@YAPEAX_K0PEAX@Z */
+void * __cdecl NFS_Allocate(size_t count, size_t size, void *hint)
+{
+    char *block, *ret;
+
+    TRACE("(%Iu %Iu %p)\n", count, size, hint);
+
+    if (size && count > (~(size_t)0 - NFS_LINE_SIZE - sizeof(void *)) / size) _Xmem();
+    block = operator_new(count * size + NFS_LINE_SIZE + sizeof(void *));
+    ret = (char *)(((ULONG_PTR)block + sizeof(void *) + NFS_LINE_SIZE - 1) & ~(ULONG_PTR)(NFS_LINE_SIZE - 1));
+    ((void **)ret)[-1] = block;
+    return ret;
+}
+
+/* ?NFS_Free@details@Concurrency@@YAXPAX@Z */
+/* ?NFS_Free@details@Concurrency@@YAXPEAX@Z */
+void __cdecl NFS_Free(void *p)
+{
+    TRACE("(%p)\n", p);
+    if (p) operator_delete(((void **)p)[-1]);
+}
+
 /* ?_Internal_swap@_Concurrent_queue_base_v4@details@Concurrency@@IAEXAAV123@@Z */
 /* ?_Internal_swap@_Concurrent_queue_base_v4@details@Concurrency@@IEAAXAEAV123@@Z */
 DEFINE_THISCALL_WRAPPER(_Concurrent_queue_base_v4__Internal_swap, 8)
