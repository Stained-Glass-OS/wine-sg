From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winegstreamer: sync reader WMT_CLEANPOINT_ONLY selection, open-ended SetRange

IWMSyncReader::SetStreamsSelected accepts WMT_OFF, WMT_CLEANPOINT_ONLY and WMT_ON (anything else is E_INVALIDARG, nothing changed): a CLEANPOINT_ONLY stream is enabled and GetNextSample delivers only its key samples (compressed streams carry the key/delta flag). Streams re-enabled after SetReadStreamSamples keep any non-OFF selection. SetRange with a zero duration now reads to the end of the file instead of keeping the end set by an earlier range (SetRangeByFrame). The FIXMEs for missing PTS/duration on a buffer become WARNs: zero is the answer.
---
diff --git a/dlls/winegstreamer/wm_reader.c b/dlls/winegstreamer/wm_reader.c
index 89ca4ba..3332c7b 100644
--- a/dlls/winegstreamer/wm_reader.c
+++ b/dlls/winegstreamer/wm_reader.c
@@ -3195,7 +3195,7 @@ static HRESULT reinit_stream(struct wm_reader *reader, bool read_compressed)
         stream->wg_stream = wg_parser_get_stream(reader->wg_parser, i);
         stream->reader = reader;
         wg_parser_stream_get_current_format(stream->wg_stream, &format);
-        if (stream->selection == WMT_ON)
+        if (stream->selection != WMT_OFF)
             wg_parser_stream_enable(stream->wg_stream, read_compressed ? &format : &stream->format);
     }
 
@@ -3345,12 +3345,12 @@ static HRESULT wm_reader_read_stream_sample(struct wm_reader *reader, struct wg_
 
     if (!buffer->has_pts)
     {
-        FIXME("Missing PTS.\n");
+        WARN("Missing PTS.\n");
         *pts = 0;
     }
     if (!buffer->has_duration)
     {
-        FIXME("Missing duration.\n");
+        WARN("Missing duration.\n");
         *duration = 0;
     }
 
@@ -3613,7 +3613,24 @@ static HRESULT WINAPI reader_GetNextSample(IWMSyncReader2 *iface,
         }
 
         if (SUCCEEDED(hr) && SUCCEEDED(hr = wm_reader_read_stream_sample(reader, &wg_buffer, sample, pts, duration, flags)))
+        {
+            struct wm_stream *got = wm_reader_get_stream_by_stream_number(reader, wg_buffer.stream + 1);
+
             stream_number = wg_buffer.stream + 1;
+#ifndef SG_MUTANT_WG_CLEANPOINT
+            if (got && got->selection == WMT_CLEANPOINT_ONLY && !(*flags & WM_SF_CLEANPOINT))
+            {
+                /* only key samples are wanted on this stream */
+                INSSBuffer_Release(*sample);
+                *sample = NULL;
+                hr = S_FALSE;
+                if (stream)
+                    stream_number = stream->index + 1;
+                else
+                    stream_number = 0;
+            }
+#endif
+        }
     }
 
     if (stream && hr == NS_E_NO_MORE_SAMPLES)
@@ -4269,6 +4286,8 @@ static HRESULT WINAPI reader_SetOutputSetting(IWMSyncReader2 *iface, DWORD outpu
 static HRESULT WINAPI reader_SetRange(IWMSyncReader2 *iface, QWORD start, LONGLONG duration)
 {
     struct wm_reader *reader = impl_from_IWMSyncReader2(iface);
+    DWORD stop_flags;
+    QWORD stop;
     WORD i;
 
     TRACE("reader %p, start %I64u, duration %I64d.\n", reader, start, duration);
@@ -4277,8 +4296,23 @@ static HRESULT WINAPI reader_SetRange(IWMSyncReader2 *iface, QWORD start, LONGLO
 
     reader->start_time = start;
 
-    wg_parser_stream_seek(reader->streams[0].wg_stream, 1.0, start, start + duration,
-            AM_SEEKING_AbsolutePositioning, duration ? AM_SEEKING_AbsolutePositioning : AM_SEEKING_NoPositioning);
+    stop = start + duration;
+    stop_flags = AM_SEEKING_AbsolutePositioning;
+    if (!duration)
+    {
+        /* a zero duration reads to the end of the file, also when an earlier
+         * range had set an earlier end */
+        QWORD total = wg_parser_stream_get_duration(reader->streams[0].wg_stream);
+#ifdef SG_MUTANT_WG_RANGEEND
+        total = 0;
+#endif
+        if (total > start)
+            stop = total;
+        else
+            stop_flags = AM_SEEKING_NoPositioning;
+    }
+    wg_parser_stream_seek(reader->streams[0].wg_stream, 1.0, start, stop,
+            AM_SEEKING_AbsolutePositioning, stop_flags);
 
     for (i = 0; i < reader->stream_count; ++i)
         reader->streams[i].eos = false;
@@ -4394,6 +4428,16 @@ static HRESULT WINAPI reader_SetStreamsSelected(IWMSyncReader2 *iface,
         }
     }
 
+    for (i = 0; i < count; ++i)
+    {
+        if (selections[i] != WMT_OFF && selections[i] != WMT_CLEANPOINT_ONLY && selections[i] != WMT_ON)
+        {
+            LeaveCriticalSection(&reader->cs);
+            WARN("Invalid selection %#x for stream %u.\n", selections[i], stream_numbers[i]);
+            return E_INVALIDARG;
+        }
+    }
+
     for (i = 0; i < count; ++i)
     {
         stream = wm_reader_get_stream_by_stream_number(reader, stream_numbers[i]);
@@ -4405,9 +4449,8 @@ static HRESULT WINAPI reader_SetStreamsSelected(IWMSyncReader2 *iface,
         }
         else
         {
-            if (selections[i] != WMT_ON)
-                FIXME("Ignoring selection %#x for stream %u; treating as enabled.\n",
-                        selections[i], stream_numbers[i]);
+            /* WMT_CLEANPOINT_ONLY enables the stream; GetNextSample then
+             * delivers its key samples only. */
             TRACE("Enabling stream %u.\n", stream_numbers[i]);
             if (stream->read_compressed)
             {
