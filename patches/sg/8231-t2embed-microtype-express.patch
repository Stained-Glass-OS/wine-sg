From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] t2embed: MicroType Express compressed EOT fonts

TTLoadEmbeddedFont of an EOT whose font data is MicroType Express compressed (TTEMBED_TTCOMPRESSED, most IE-era web fonts) was E_ERRORDECOMPRESSINGFONTDATA. New mtx.c, written from the W3C Member Submission MicroType Express (MTX) Font Format: the three LZCOMP blocks (adaptive Huffman symbols, copy items over a preloaded history, optional run-length layer) and the Compact Table Format back to TrueType: glyf (triplet-coded points, computed bounding boxes, composite glyphs) with the glyph programs rebuilt from the push data and instruction blocks, loca rebuilt, cvt, hdmx and VDMX from their predictions and magnitude-coded surprises, table checksums and the head checksum adjustment. XOR encryption is undone first. Every read is bounds-checked; corrupt data gives E_ERRORDECOMPRESSINGFONTDATA.
---
--- a/dlls/t2embed/Makefile.in
+++ b/dlls/t2embed/Makefile.in
@@ -5,4 +5,5 @@
 EXTRADLLFLAGS = -Wb,--prefer-native
 
 SOURCES = \
-	main.c
+	main.c \
+	mtx.c
--- a/dlls/t2embed/main.c
+++ b/dlls/t2embed/main.c
@@ -28,6 +28,8 @@
 #include "t2embapi.h"
 #include "wine/debug.h"
 
+#include "t2embed_private.h"
+
 WINE_DEFAULT_DEBUG_CHANNEL(t2embed);
 
 /* Stained Glass OS: fonts embedded in documents, in the Embedded OpenType
@@ -358,14 +360,41 @@
     }
     eot->fstype = *(USHORT *)(eot->header + 32);
     eot->font = eot->header + eot->size - eot->font_size;
+    if (eot->flags & TTEMBED_XORENCRYPTDATA)
+        for (i = 0; i < eot->font_size; i++) eot->font[i] ^= 0x50;
     if (eot->flags & TTEMBED_TTCOMPRESSED)
     {
+#ifndef SG_MUTANT_NO_MTX
+        /* (wine-sg 8231) MicroType Express: the font data (decrypted first: XOR applies to the compressed
+         * data) decompressed into a TrueType font, which then replaces it after the header */
+        ULONG prefix = eot->size - eot->font_size, ttf_size;
+        BYTE *ttf, *header;
+
+        if (!mtx_decompress( eot->font, eot->font_size, &ttf, &ttf_size ))
+        {
+            free( eot->header );
+            return E_ERRORDECOMPRESSINGFONTDATA;
+        }
+        if (!(header = malloc( prefix + ttf_size )))
+        {
+            free( ttf );
+            free( eot->header );
+            return E_NOFREEMEMORY;
+        }
+        memcpy( header, eot->header, prefix );
+        memcpy( header + prefix, ttf, ttf_size );
+        free( ttf );
+        free( eot->header );
+        eot->header = header;
+        eot->size = prefix + ttf_size;
+        eot->font = header + prefix;
+        eot->font_size = ttf_size;
+#else
         FIXME( "MicroType Express compressed font data\n" );
         free( eot->header );
         return E_ERRORDECOMPRESSINGFONTDATA;
+#endif
     }
-    if (eot->flags & TTEMBED_XORENCRYPTDATA)
-        for (i = 0; i < eot->font_size; i++) eot->font[i] ^= 0x50;
     return E_NONE;
 }
 
