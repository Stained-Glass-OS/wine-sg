+/*
+ * ntlanman: the Windows network provider -- Unix side
+ *
+ * Asks Stained Glass OS's sg-netmountd (sg-session) to mount shares and map
+ * drive letters, over its Unix socket, and reads a user's drive mappings.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "unixlib.h"
+
+#define SG_NET_ROOT "/run/stained-glass-net"
+
+static NTSTATUS request( void *args )
+{
+    struct request_params *params = args;
+    struct sockaddr_un addr = { .sun_family = AF_UNIX, .sun_path = SG_NET_ROOT "/netmount.sock" };
+    struct timeval tv = { 60, 0 };
+    size_t len = strnlen( params->request, sizeof(params->request) ), got = 0;
+    ssize_t r;
+    int fd;
+
+    params->reply[0] = 0;
+    if (len >= sizeof(params->request)) return STATUS_INVALID_PARAMETER;
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) == -1) return STATUS_NOT_SUPPORTED;
+    setsockopt( fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv) );
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) || write( fd, params->request, len ) != len)
+    {
+        close( fd );
+        return STATUS_NOT_SUPPORTED;
+    }
+    while (got < sizeof(params->reply) - 1 &&
+           (r = read( fd, params->reply + got, sizeof(params->reply) - 1 - got )) > 0)
+    {
+        got += r;
+        if (memchr( params->reply, '\n', got )) break;
+    }
+    close( fd );
+    params->reply[got] = 0;
+    params->reply[strcspn( params->reply, "\n" )] = 0;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS get_drive( void *args )
+{
+    struct get_drive_params *params = args;
+    char link[64];
+    ssize_t len;
+
+    params->target[0] = 0;
+    if (params->letter < 'a' || params->letter > 'z') return STATUS_INVALID_PARAMETER;
+    snprintf( link, sizeof(link), SG_NET_ROOT "/drives/%u/%c:", (unsigned int)getuid(), params->letter );
+    if ((len = readlink( link, params->target, sizeof(params->target) - 1 )) < 0) return STATUS_OBJECT_NAME_NOT_FOUND;
+    params->target[len] = 0;
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    request,
+    get_drive,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    request,
+    get_drive,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif  /* _WIN64 */
