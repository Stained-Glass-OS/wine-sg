+/*
+ * ntlanman: the Windows network provider ("Microsoft Windows Network")
+ *
+ * The network provider mpr.dll calls for WNetAddConnection2/3,
+ * WNetCancelConnection2 and WNetGetConnection -- and so for "net use" and
+ * logon scripts. A share is a CIFS mount made by Stained Glass OS's
+ * sg-netmountd with the user's own Kerberos ticket; a drive letter is the
+ * user's own (ntdll finds it). Explicit credentials are not supported: the
+ * connection is always made as the signed-in user, as with single sign-on.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "winnetwk.h"
+#include "npapi.h"
+#include "winerror.h"
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mpr);
+
+static const char unc_root[] = "/run/stained-glass-net/unc/";
+
+static BOOL WINAPI init_unix( INIT_ONCE *once, void *param, void **context )
+{
+    return !__wine_init_unix_call();
+}
+
+static BOOL unix_ready(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    return InitOnceExecuteOnce( &once, init_unix, NULL, NULL );
+}
+
+/* One request line to sg-netmountd; a WN_* result. */
+static DWORD netmount( struct request_params *params )
+{
+    int err;
+
+    if (!unix_ready() || WINE_UNIX_CALL( unix_request, params ) || !params->reply[0]) return WN_NO_NETWORK;
+    TRACE( "%s -> %s\n", debugstr_a(params->request), debugstr_a(params->reply) );
+    if (!strncmp( params->reply, "OK", 2 )) return WN_SUCCESS;
+    err = atoi( params->reply + 4 );
+    switch (err)
+    {
+    case 22:  return WN_BAD_NETNAME;          /* EINVAL */
+    case 113: return ERROR_BAD_NETPATH;       /* EHOSTUNREACH */
+    case 13:  return WN_ACCESS_DENIED;        /* EACCES: no ticket, or refused */
+    default:  return ERROR_UNEXP_NET_ERR;
+    }
+}
+
+/* Append one name, UTF-8, to a request; names hold no tabs or newlines. */
+static BOOL append( char *buf, size_t size, const WCHAR *name, int len )
+{
+    size_t pos = strlen( buf );
+    int i, n;
+
+    for (i = 0; i < len; i++) if (name[i] < 32) return FALSE;
+    if (pos + 1 >= size) return FALSE;
+    buf[pos++] = '\t';
+    if (!(n = WideCharToMultiByte( CP_UTF8, 0, name, len, buf + pos, size - pos - 1, NULL, NULL ))) return FALSE;
+    buf[pos + n] = 0;
+    return TRUE;
+}
+
+/* \\server\share\dir -> "\tserver\tshare\tdir"; the share is required */
+static BOOL append_unc( char *buf, size_t size, const WCHAR *remote )
+{
+    const WCHAR *p = remote, *start;
+    int count = 0;
+
+    if (!remote || remote[0] != '\\' || remote[1] != '\\') return FALSE;
+    p += 2;
+    while (*p)
+    {
+        start = p;
+        while (*p && *p != '\\') p++;
+        if (p > start)
+        {
+            if (!append( buf, size, start, p - start )) return FALSE;
+            count++;
+        }
+        while (*p == '\\') p++;
+    }
+    return count >= 2;
+}
+
+static BOOL drive_letter( const WCHAR *local, char *letter )
+{
+    if (!local || !local[0] || local[1] != ':' || local[2]) return FALSE;
+    if (local[0] >= 'a' && local[0] <= 'z') *letter = local[0];
+    else if (local[0] >= 'A' && local[0] <= 'Z') *letter = local[0] - 'A' + 'a';
+    else return FALSE;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           NPGetCaps   (ntlanman.@)
+ */
+DWORD WINAPI NPGetCaps( DWORD index )
+{
+    switch (index)
+    {
+    case WNNC_SPEC_VERSION: return WNNC_SPEC_VERSION51;
+    case WNNC_NET_TYPE:     return WNNC_NET_LANMAN;
+    case WNNC_DRIVER_VERSION: return 1;
+    case WNNC_CONNECTION:
+        return WNNC_CON_ADDCONNECTION | WNNC_CON_ADDCONNECTION3 | WNNC_CON_CANCELCONNECTION |
+               WNNC_CON_GETCONNECTIONS;
+    default: return 0;
+    }
+}
+
+/***********************************************************************
+ *           NPAddConnection3   (ntlanman.@)
+ */
+DWORD WINAPI NPAddConnection3( HWND owner, NETRESOURCEW *resource, WCHAR *password, WCHAR *user, DWORD flags )
+{
+    struct request_params params;
+    char letter;
+
+    TRACE( "%p %p %p %s %#lx\n", owner, resource, password, debugstr_w(user), flags );
+    if (!resource) return WN_BAD_POINTER;
+    TRACE( "%s -> %s\n", debugstr_w(resource->lpLocalName), debugstr_w(resource->lpRemoteName) );
+    if (resource->dwType != RESOURCETYPE_ANY && resource->dwType != RESOURCETYPE_DISK) return WN_BAD_DEV_TYPE;
+    if (user || password) FIXME( "explicit credentials are not supported; connecting as the signed-in user\n" );
+
+    memset( &params, 0, sizeof(params) );
+    if (resource->lpLocalName && resource->lpLocalName[0])
+    {
+        if (!drive_letter( resource->lpLocalName, &letter )) return WN_BAD_LOCALNAME;
+        if (GetLogicalDrives() & (1u << (letter - 'a'))) return WN_ALREADY_CONNECTED;
+        snprintf( params.request, sizeof(params.request), "MAP\t%c", letter );
+    }
+    else strcpy( params.request, "MOUNT" );
+
+    if (!append_unc( params.request, sizeof(params.request) - 1, resource->lpRemoteName )) return WN_BAD_NETNAME;
+    /* MOUNT takes the share alone; a directory below it needs a letter */
+    if (!strcmp( params.request, "MOUNT" ) || !strncmp( params.request, "MOUNT\t", 6 ))
+    {
+        char *tab = strchr( params.request + 6, '\t' );
+        if (tab && (tab = strchr( tab + 1, '\t' ))) *tab = 0;
+    }
+    strcat( params.request, "\n" );
+    return netmount( &params );
+}
+
+/***********************************************************************
+ *           NPAddConnection   (ntlanman.@)
+ */
+DWORD WINAPI NPAddConnection( NETRESOURCEW *resource, WCHAR *password, WCHAR *user )
+{
+    return NPAddConnection3( NULL, resource, password, user, 0 );
+}
+
+/***********************************************************************
+ *           NPCancelConnection   (ntlanman.@)
+ */
+DWORD WINAPI NPCancelConnection( WCHAR *name, BOOL force )
+{
+    struct request_params params;
+    struct get_drive_params drive;
+    char letter;
+
+    TRACE( "%s %d\n", debugstr_w(name), force );
+    if (!name) return WN_BAD_POINTER;
+    /* a connection without a letter: the share stays mounted for the others
+     * using it, and this user simply stops using it */
+    if (name[0] == '\\' && name[1] == '\\') return WN_SUCCESS;
+    if (!drive_letter( name, &letter )) return WN_BAD_LOCALNAME;
+
+    drive.letter = letter;
+    if (!unix_ready() || WINE_UNIX_CALL( unix_get_drive, &drive )) return WN_NOT_CONNECTED;
+    memset( &params, 0, sizeof(params) );
+    snprintf( params.request, sizeof(params.request), "UNMAP\t%c\n", letter );
+    return netmount( &params );
+}
+
+/***********************************************************************
+ *           NPGetConnection   (ntlanman.@)
+ */
+DWORD WINAPI NPGetConnection( WCHAR *local, WCHAR *remote, DWORD *size )
+{
+    struct get_drive_params drive;
+    char unc[1024], *p;
+    DWORD len;
+
+    TRACE( "%s %p %p\n", debugstr_w(local), remote, size );
+    if (!drive_letter( local, &drive.letter )) return WN_NOT_CONNECTED;
+    if (!unix_ready() || WINE_UNIX_CALL( unix_get_drive, &drive )) return WN_NOT_CONNECTED;
+    if (strncmp( drive.target, unc_root, strlen(unc_root) )) return WN_NOT_CONNECTED;
+
+    /* /run/stained-glass-net/unc/server/share/dir -> \\server\share\dir */
+    snprintf( unc, sizeof(unc), "\\\\%s", drive.target + strlen(unc_root) );
+    for (p = unc; *p; p++) if (*p == '/') *p = '\\';
+    len = MultiByteToWideChar( CP_UTF8, 0, unc, -1, NULL, 0 );
+    if (!remote || *size < len)
+    {
+        *size = len;
+        return WN_MORE_DATA;
+    }
+    MultiByteToWideChar( CP_UTF8, 0, unc, -1, remote, *size );
+    return WN_SUCCESS;
+}
