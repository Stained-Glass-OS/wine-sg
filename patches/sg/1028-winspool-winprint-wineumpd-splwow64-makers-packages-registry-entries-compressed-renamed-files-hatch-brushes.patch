From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winspool, winprint, wineumpd, splwow64: makers' packages' registry entries, compressed renamed files, hatch brushes

Three things kept makers' packages from running whole:

- The install section's AddReg and DelReg entries were not made (Epson's
  packages, among others, create their keys so); they are, as Windows
  installs them with the driver.
- OKI's INF (B930, its own PostScript driver) installs OKAACSG.DLL from "OKAACSG.DLL,OKAACSG.DL_", a source
  file that is itself compressed (a cabinet of one file, ui.dll). A file
  installed under another name was copied as it was; it is now expanded
  (SetupDecompressOrCopyFile), and the configuration DLL loads.
- GDI asks DrvEnablePDEV to make the six hatch brushes: cPat is
  HS_DDI_MAX and phsurfPatterns an array for them. We passed 0 and NULL;
  OKI's driver fills the array in without looking and crashed. The print
  processor, the device-measure probe and the 32-bit host pass the array.

OKI's driver now starts a job (its PostScript header); its pages are an
open item (docs/printer-drivers.md).

Test: test/drvpkg-gate.sh -- an AddReg entry, a renamed file from a
one-file cabinet, and the test driver now refuses a DrvEnablePDEV without
the hatch array (mutants SG_MUTANT_RENAMEEXPAND, HATCH, ADDREG).
---
--- a/dlls/wineumpd.drv/init.c
+++ b/dlls/wineumpd.drv/init.c
@@ -43,6 +43,7 @@
 
 static BOOL get_caps( const WCHAR *device, const DEVMODEW *devmode, struct umpd_caps *caps )
 {
+    HSURF patterns[HS_DDI_MAX];
     BOOL (WINAPI *enable_driver)( ULONG, ULONG, DRVENABLEDATA * );
     void (WINAPI *disable_driver)( void );
     DHPDEV (WINAPI *enable_pdev)( DEVMODEW *, WCHAR *, ULONG, HSURF *, ULONG, ULONG *, ULONG, DEVINFO *,
@@ -91,7 +92,9 @@
     dev.printer = printer;
     memset( &gi, 0, sizeof(gi) );
     memset( &di, 0, sizeof(di) );
-    dhpdev = enable_pdev( (DEVMODEW *)devmode, (WCHAR *)device, 0, NULL, sizeof(gi), (ULONG *)&gi, sizeof(di), &di,
+    /* drivers fill in their hatch brushes, as GDI asks of them */
+    memset( patterns, 0, sizeof(patterns) );
+    dhpdev = enable_pdev( (DEVMODEW *)devmode, (WCHAR *)device, HS_DDI_MAX, patterns, sizeof(gi), (ULONG *)&gi, sizeof(di), &di,
                           (HDEV)&dev, (WCHAR *)device, printer );
     if (dhpdev)
     {
--- a/dlls/winprint/emf.c
+++ b/dlls/winprint/emf.c
@@ -444,6 +444,7 @@
                         const WCHAR *out_file, DWORD job_id, struct spool_page *pages, unsigned int page_count,
                         HANDLE hport, HANDLE file )
 {
+    HSURF patterns[HS_DDI_MAX];
     struct wine_eng_device dev;
     unsigned int i, copy, copies;
     DEVMODEW *devmode;
@@ -477,8 +478,17 @@
 
     memset( &gdiinfo, 0, sizeof(gdiinfo) );
     memset( &devinfo, 0, sizeof(devinfo) );
-    dev.dhpdev = drv.enable_pdev( devmode, (WCHAR *)printer_name, 0, NULL, sizeof(gdiinfo), (ULONG *)&gdiinfo,
-                                  sizeof(devinfo), &devinfo, (HDEV)&dev, (WCHAR *)printer_name, printer );
+    /* drivers fill in their hatch brushes, as GDI asks of them */
+    memset( patterns, 0, sizeof(patterns) );
+#ifndef SG_MUTANT_HATCH
+    dev.dhpdev = drv.enable_pdev( devmode, (WCHAR *)printer_name, HS_DDI_MAX, patterns, sizeof(gdiinfo),
+                                  (ULONG *)&gdiinfo, sizeof(devinfo), &devinfo, (HDEV)&dev, (WCHAR *)printer_name,
+                                  printer );
+#else
+    dev.dhpdev = drv.enable_pdev( devmode, (WCHAR *)printer_name, 0, NULL, sizeof(gdiinfo),
+                                  (ULONG *)&gdiinfo, sizeof(devinfo), &devinfo, (HDEV)&dev, (WCHAR *)printer_name,
+                                  printer );
+#endif
     if (!dev.dhpdev)
     {
         if (GetLastError() != ERROR_BAD_EXE_FORMAT) ERR( "DrvEnablePDEV failed\n" );
--- a/dlls/winspool.drv/install.c
+++ b/dlls/winspool.drv/install.c
@@ -437,7 +437,13 @@
         return FALSE;
     swprintf( path, size, L"%s\\%s", ic->st.dir, name );
     TRACE( "%s is %s\n", debugstr_w(name), debugstr_w(src) );
+    /* the source may itself be compressed (OKI's OKAACSG.DLL,OKAACSG.DL_ is a
+     * cabinet of one file) */
+#ifndef SG_MUTANT_RENAMEEXPAND
+    return SetupDecompressOrCopyFileW( src, path, NULL ) == ERROR_SUCCESS;
+#else
     return CopyFileW( src, path, FALSE );
+#endif
 }
 
 /* copies a package file to a directory other than the driver's, as setup
@@ -723,6 +729,13 @@
         if (!ret) WARN( "AddPrinterDriverEx failed %lu\n", GetLastError() );
     }
     free( deps );
+    /* the install section's registry entries (AddReg, DelReg), as Windows
+     * installs them with the driver */
+#ifndef SG_MUTANT_ADDREG
+    if (ret && !SetupInstallFromInfSectionW( NULL, ic.inf, section, SPINST_REGISTRY, NULL, NULL, 0, NULL, NULL,
+                                             NULL, NULL ))
+        WARN( "%s: registry entries: %lu\n", debugstr_w(section), GetLastError() );
+#endif
     if (ret && ic.processor[0])
     {
         /* the driver's print processor: the printers given this driver use it */
--- a/include/ddk/winddi.h
+++ b/include/ddk/winddi.h
@@ -19,6 +19,7 @@
  */
 
 #ifndef _WINDDI_
+#define HS_DDI_MAX 6   /* the hatch brushes a driver makes in DrvEnablePDEV */
 #define _WINDDI_
 
 typedef LONG PTRDIFF;
--- a/programs/splwow64/main.c
+++ b/programs/splwow64/main.c
@@ -73,6 +73,7 @@
 
 static int caps( const WCHAR *name, const WCHAR *dm_file, const WCHAR *out_file )
 {
+    HSURF patterns[HS_DDI_MAX];
     BOOL (WINAPI *enable_driver)( ULONG, ULONG, DRVENABLEDATA * );
     DHPDEV (WINAPI *enable_pdev)( DEVMODEW *, WCHAR *, ULONG, HSURF *, ULONG, ULONG *, ULONG, DEVINFO *,
                                   HDEV, WCHAR *, HANDLE ) = NULL;
@@ -108,7 +109,9 @@
     dev.printer = printer;
     memset( &gi, 0, sizeof(gi) );
     memset( &di, 0, sizeof(di) );
-    if (!(dhpdev = enable_pdev( dm, (WCHAR *)name, 0, NULL, sizeof(gi), (ULONG *)&gi, sizeof(di), &di, (HDEV)&dev,
+    /* drivers fill in their hatch brushes, as GDI asks of them */
+    memset( patterns, 0, sizeof(patterns) );
+    if (!(dhpdev = enable_pdev( dm, (WCHAR *)name, HS_DDI_MAX, patterns, sizeof(gi), (ULONG *)&gi, sizeof(di), &di, (HDEV)&dev,
                                 (WCHAR *)name, printer )))
         return 1;
     if (!(out = _wfopen( out_file, L"w" ))) return 1;
