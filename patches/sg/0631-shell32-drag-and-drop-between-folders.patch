+/* Stained Glass: 1 if the item PIDL is in this view's folder, 0 if it is
+ * elsewhere, -1 when either has no path */
+static int shellview_in_folder(IShellViewImpl *This, LPCITEMIDLIST pidl)
+{
+    WCHAR item[MAX_PATH], folder[MAX_PATH];
+    IPersistFolder2 *pf;
+    LPITEMIDLIST cur = NULL;
+    BOOL ok = FALSE;
+
+    if (!pidl || !SHGetPathFromIDListW(pidl, item)) return -1;
+    if (SUCCEEDED(IShellFolder_QueryInterface(This->pSFParent, &IID_IPersistFolder2, (void **)&pf)))
+    {
+        if (SUCCEEDED(IPersistFolder2_GetCurFolder(pf, &cur))) ok = SHGetPathFromIDListW(cur, folder);
+        ILFree(cur);
+        IPersistFolder2_Release(pf);
+    }
+    if (!ok) return -1;
+    PathRemoveFileSpecW(item);
+    PathRemoveBackslashW(item);
+    PathRemoveBackslashW(folder);
+    return !wcsicmp(item, folder);
+}
