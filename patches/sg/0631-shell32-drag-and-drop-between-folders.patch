+/* Stained Glass: the paths of the files a drag carries, each with its folder
+ * flag in front ('D' or 'F'), in a double-null-terminated list */
+static WCHAR *drag_source_paths(IDataObject *data)
+{
+    FORMATETC format = { CF_HDROP, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    STGMEDIUM medium;
+    WCHAR *list = NULL, path[MAX_PATH];
+    size_t len = 0;
+    UINT i, n;
+    HDROP drop;
+
+    if (FAILED(IDataObject_GetData(data, &format, &medium))) return NULL;
+    if ((drop = GlobalLock(medium.hGlobal)))
+    {
+        n = DragQueryFileW(drop, ~0u, NULL, 0);
+        if ((list = calloc(n * (MAX_PATH + 1) + 1, sizeof(WCHAR))))
+            for (i = 0; i < n; i++)
+            {
+                DWORD attrs;
+                if (!DragQueryFileW(drop, i, path, MAX_PATH)) continue;
+                attrs = GetFileAttributesW(path);
+                list[len++] = attrs != INVALID_FILE_ATTRIBUTES && (attrs & FILE_ATTRIBUTE_DIRECTORY) ? 'D' : 'F';
+                lstrcpyW(list + len, path);
+                len += lstrlenW(path) + 1;
+            }
+        GlobalUnlock(medium.hGlobal);
+    }
+    ReleaseStgMedium(&medium);
+    return list;
+}
+
+/* Stained Glass: after a drag, the files that are no longer there were moved
+ * -- by a drop in another process, whose change notices never reach this
+ * one -- and go from the view */
+static void drag_source_gone(WCHAR *list)
+{
+    WCHAR *p;
+
+    for (p = list; p && *p; p += lstrlenW(p) + 1)
+        if (GetFileAttributesW(p + 1) == INVALID_FILE_ATTRIBUTES)
+            SHChangeNotify(*p == 'D' ? SHCNE_RMDIR : SHCNE_DELETE, SHCNF_PATHW, p + 1, NULL);
+    free(list);
+}
