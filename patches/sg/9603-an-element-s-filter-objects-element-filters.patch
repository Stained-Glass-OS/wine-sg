@@ -9066,6 +9279,495 @@
 DISPEX_IDISPATCH_IMPL(HTMLFiltersCollection, IHTMLFiltersCollection,
                       impl_from_IHTMLFiltersCollection(iface)->dispex)
 
+#ifndef SG_MUTANT_NO_FILTER_OBJECTS
+/* Stained Glass OS (wine-sg 9603): the filter objects of an element (element.filters), as Internet
+ * Explorer's legacy document modes have them. The element's filter list ("alpha(opacity=50)
+ * progid:DXImageTransform.Microsoft.Blur(pixelRadius=2)") is the truth: a filter object reads its
+ * parameters from it, and setting one writes the list back through style.filter, which renders what
+ * MSHTML can (Alpha's opacity). Transitions (apply, play, stop) finish at once: there is no animation. */
+struct filter_span
+{
+    const WCHAR *start, *end;           /* the whole filter, name to ')' */
+    const WCHAR *name, *name_end;       /* without "progid:" */
+    const WCHAR *args, *args_end;       /* between the parentheses */
+};
+
+static BOOL next_filter(const WCHAR **pos, struct filter_span *f)
+{
+    const WCHAR *p = *pos;
+    int depth;
+
+    while(*p && (iswspace(*p) || *p == ','))
+        p++;
+    if(!*p)
+        return FALSE;
+    f->start = p;
+    if(!wcsnicmp(p, L"progid:", 7))
+        p += 7;
+    f->name = p;
+    while(*p && (iswalnum(*p) || *p == '.' || *p == '_'))
+        p++;
+    f->name_end = p;
+    while(iswspace(*p))
+        p++;
+    if(f->name == f->name_end || *p != '(')
+        return FALSE;
+    f->args = ++p;
+    for(depth = 1; *p; p++) {
+        if(*p == '\'' || *p == '"') {
+            WCHAR q = *p;
+            while(p[1] && p[1] != q) p++;
+            if(p[1]) p++;
+        }else if(*p == '(') depth++;
+        else if(*p == ')' && !--depth) break;
+    }
+    f->args_end = p;
+    if(*p) p++;
+    f->end = p;
+    *pos = p;
+    return TRUE;
+}
+
+/* the element's filter list: what a script set, else what its style attribute says */
+static WCHAR *get_filter_text(HTMLElement *elem)
+{
+    const WCHAR *p, *start;
+    WCHAR *ret = NULL;
+    BSTR attr = NULL;
+    int depth = 0;
+
+    if(elem->filter)
+        return wcsdup(elem->filter);
+    if(!elem->dom_element || FAILED(elem_string_attr_getter(elem, L"style", TRUE, &attr)) || !attr)
+        return NULL;
+    for(p = attr; *p; p++) {
+        if((p == attr || p[-1] == ';' || iswspace(p[-1])) && !wcsnicmp(p, L"filter", 6)) {
+            const WCHAR *q = p + 6;
+            while(iswspace(*q)) q++;
+            if(*q != ':') continue;
+            start = ++q;
+            for(; *q && (depth || *q != ';'); q++) {
+                if(*q == '(') depth++;
+                else if(*q == ')' && depth) depth--;
+            }
+            ret = malloc((q - start + 1) * sizeof(WCHAR));
+            if(ret) {
+                memcpy(ret, start, (q - start) * sizeof(WCHAR));
+                ret[q - start] = 0;
+            }
+            break;
+        }
+    }
+    SysFreeString(attr);
+    return ret;
+}
+
+static BOOL filter_name_matches(const struct filter_span *f, const WCHAR *name)
+{
+    const WCHAR *last = f->name, *p;
+    size_t len = f->name_end - f->name;
+
+    if(wcslen(name) == len && !wcsnicmp(f->name, name, len))
+        return TRUE;
+    for(p = f->name; p < f->name_end; p++)
+        if(*p == '.') last = p + 1;
+    len = f->name_end - last;
+    return wcslen(name) == len && !wcsnicmp(last, name, len);
+}
+
+static int find_filter(const WCHAR *text, const WCHAR *name, LONG index, struct filter_span *ret)
+{
+    const WCHAR *pos = text;
+    struct filter_span f;
+    int i = 0;
+
+    while(text && next_filter(&pos, &f)) {
+        if(name ? filter_name_matches(&f, name) : i == index) {
+            if(ret) *ret = f;
+            return i;
+        }
+        i++;
+    }
+    return -1;
+}
+
+static LONG count_filters(const WCHAR *text)
+{
+    const WCHAR *pos = text;
+    struct filter_span f;
+    LONG n = 0;
+
+    while(text && next_filter(&pos, &f))
+        n++;
+    return n;
+}
+
+/* the value of a parameter in the filter's arguments ("opacity=50, style=1") */
+static BOOL find_param(const struct filter_span *f, const WCHAR *name, const WCHAR **value, const WCHAR **value_end)
+{
+    const WCHAR *p = f->args, *key, *key_end;
+
+    while(p < f->args_end) {
+        while(p < f->args_end && (iswspace(*p) || *p == ',')) p++;
+        key = p;
+        while(p < f->args_end && *p != '=' && *p != ',') p++;
+        key_end = p;
+        while(key_end > key && iswspace(key_end[-1])) key_end--;
+        if(p < f->args_end && *p == '=') {
+            p++;
+            while(p < f->args_end && iswspace(*p)) p++;
+            *value = p;
+            if(*p == '\'' || *p == '"') {
+                WCHAR q = *p++;
+                while(p < f->args_end && *p != q) p++;
+                if(p < f->args_end) p++;
+            }else {
+                while(p < f->args_end && *p != ',') p++;
+            }
+            *value_end = p;
+            while(*value_end > *value && iswspace((*value_end)[-1])) (*value_end)--;
+            if(key_end - key == wcslen(name) && !wcsnicmp(key, name, key_end - key))
+                return TRUE;
+        }
+        if(p < f->args_end) p++;
+    }
+    return FALSE;
+}
+
+static HRESULT param_variant(const WCHAR *value, const WCHAR *end, VARIANT *ret)
+{
+    WCHAR *str, *stop;
+    double d;
+    LONG l;
+
+    if(end > value && (*value == '\'' || *value == '"')) {
+        value++;
+        if(end > value && (end[-1] == '\'' || end[-1] == '"')) end--;
+    }
+    if(!(str = malloc((end - value + 1) * sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+    memcpy(str, value, (end - value) * sizeof(WCHAR));
+    str[end - value] = 0;
+    if(*str && (l = wcstol(str, &stop, 10), !*stop)) {
+        V_VT(ret) = VT_I4;
+        V_I4(ret) = l;
+    }else if(*str && (d = wcstod(str, &stop), !*stop)) {
+        V_VT(ret) = VT_R8;
+        V_R8(ret) = d;
+    }else if(!wcsicmp(str, L"true") || !wcsicmp(str, L"false")) {
+        V_VT(ret) = VT_BOOL;
+        V_BOOL(ret) = variant_bool(!wcsicmp(str, L"true"));
+    }else {
+        V_VT(ret) = VT_BSTR;
+        V_BSTR(ret) = SysAllocString(str);
+    }
+    free(str);
+    return S_OK;
+}
+
+typedef struct
+{
+    IDispatch IDispatch_iface;
+    LONG ref;
+    HTMLElement *elem;
+    LONG index;             /* which filter of the element's list */
+    LONG status;            /* a transition's: 0 stopped, 1 applied, 2 playing */
+    WCHAR **names;          /* the names handed out as DISPIDs */
+    unsigned names_cnt;
+} HTMLFilter;
+
+#define FILTER_DISPID_APPLY  1
+#define FILTER_DISPID_PLAY   2
+#define FILTER_DISPID_STOP   3
+#define FILTER_DISPID_STATUS 4
+#define FILTER_DISPID_PARAM  100
+
+static inline HTMLFilter *impl_from_filter_IDispatch(IDispatch *iface)
+{
+    return CONTAINING_RECORD(iface, HTMLFilter, IDispatch_iface);
+}
+
+static HRESULT WINAPI HTMLFilter_QueryInterface(IDispatch *iface, REFIID riid, void **ppv)
+{
+    HTMLFilter *This = impl_from_filter_IDispatch(iface);
+
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch)) {
+        *ppv = &This->IDispatch_iface;
+        IDispatch_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI HTMLFilter_AddRef(IDispatch *iface)
+{
+    return InterlockedIncrement(&impl_from_filter_IDispatch(iface)->ref);
+}
+
+static ULONG WINAPI HTMLFilter_Release(IDispatch *iface)
+{
+    HTMLFilter *This = impl_from_filter_IDispatch(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    unsigned i;
+
+    if(!ref) {
+        IHTMLElement_Release(&This->elem->IHTMLElement_iface);
+        for(i = 0; i < This->names_cnt; i++)
+            free(This->names[i]);
+        free(This->names);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI HTMLFilter_GetTypeInfoCount(IDispatch *iface, UINT *count)
+{
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLFilter_GetTypeInfo(IDispatch *iface, UINT index, LCID lcid, ITypeInfo **ti)
+{
+    *ti = NULL;
+    return DISP_E_BADINDEX;
+}
+
+static HRESULT WINAPI HTMLFilter_GetIDsOfNames(IDispatch *iface, REFIID riid, LPOLESTR *names, UINT count,
+        LCID lcid, DISPID *ids)
+{
+    HTMLFilter *This = impl_from_filter_IDispatch(iface);
+    static const struct { const WCHAR *name; DISPID id; } methods[] = {
+        { L"apply", FILTER_DISPID_APPLY }, { L"play", FILTER_DISPID_PLAY },
+        { L"stop", FILTER_DISPID_STOP }, { L"status", FILTER_DISPID_STATUS },
+    };
+    unsigned i;
+    WCHAR **new_names;
+
+    if(!count)
+        return S_OK;
+    for(i = 0; i < count; i++)
+        ids[i] = DISPID_UNKNOWN;
+    for(i = 0; i < ARRAY_SIZE(methods); i++)
+        if(!wcsicmp(names[0], methods[i].name)) {
+            ids[0] = methods[i].id;
+            return count > 1 ? DISP_E_UNKNOWNNAME : S_OK;
+        }
+    /* any other name is one of the filter's parameters */
+    for(i = 0; i < This->names_cnt; i++)
+        if(!wcsicmp(This->names[i], names[0])) {
+            ids[0] = FILTER_DISPID_PARAM + i;
+            return count > 1 ? DISP_E_UNKNOWNNAME : S_OK;
+        }
+    if(!(new_names = realloc(This->names, (This->names_cnt + 1) * sizeof(*new_names))))
+        return E_OUTOFMEMORY;
+    This->names = new_names;
+    if(!(This->names[This->names_cnt] = wcsdup(names[0])))
+        return E_OUTOFMEMORY;
+    ids[0] = FILTER_DISPID_PARAM + This->names_cnt++;
+    return count > 1 ? DISP_E_UNKNOWNNAME : S_OK;
+}
+
+/* the documented defaults of parameters a filter is often written without */
+static BOOL filter_param_default(const struct filter_span *f, const WCHAR *name, VARIANT *ret)
+{
+    if(!wcsicmp(name, L"enabled")) {
+        V_VT(ret) = VT_BOOL;
+        V_BOOL(ret) = VARIANT_TRUE;
+        return TRUE;
+    }
+    if(filter_name_matches(f, L"alpha")) {
+        if(!wcsicmp(name, L"opacity")) { V_VT(ret) = VT_I4; V_I4(ret) = 100; return TRUE; }
+        if(!wcsicmp(name, L"finishOpacity") || !wcsicmp(name, L"style")) { V_VT(ret) = VT_I4; V_I4(ret) = 0; return TRUE; }
+    }
+    if(!wcsicmp(name, L"duration")) { V_VT(ret) = VT_R8; V_R8(ret) = 1.0; return TRUE; }
+    return FALSE;
+}
+
+/* writes the filter list back with the parameter set */
+static HRESULT set_filter_param(HTMLFilter *This, const WCHAR *name, VARIANT *value)
+{
+    const WCHAR *val = NULL, *val_end = NULL;
+    struct filter_span f;
+    WCHAR *text, *new_text, *p;
+    IHTMLStyle *style;
+    VARIANT str;
+    size_t len;
+    HRESULT hres;
+    BSTR bstr;
+
+    if(!(text = get_filter_text(This->elem)))
+        return E_FAIL;
+    if(find_filter(text, NULL, This->index, &f) < 0) {
+        free(text);
+        return E_FAIL;
+    }
+    V_VT(&str) = VT_EMPTY;
+    if(V_VT(value) == VT_BOOL) {
+        V_VT(&str) = VT_BSTR;
+        V_BSTR(&str) = SysAllocString(V_BOOL(value) ? L"true" : L"false");
+    }else if(FAILED(hres = VariantChangeType(&str, value, 0, VT_BSTR))) {
+        free(text);
+        return hres;
+    }
+    len = wcslen(text) + wcslen(name) + SysStringLen(V_BSTR(&str)) + 8;
+    if(!(new_text = malloc(len * sizeof(WCHAR)))) {
+        VariantClear(&str);
+        free(text);
+        return E_OUTOFMEMORY;
+    }
+    if(find_param(&f, name, &val, &val_end)) {
+        /* replace the value */
+        p = new_text;
+        memcpy(p, text, (val - text) * sizeof(WCHAR)); p += val - text;
+        wcscpy(p, V_BSTR(&str)); p += wcslen(p);
+        wcscpy(p, val_end);
+    }else {
+        /* add the parameter */
+        const WCHAR *args_end = f.args_end;
+        BOOL empty = TRUE;
+        const WCHAR *q;
+
+        for(q = f.args; q < args_end; q++)
+            if(!iswspace(*q)) empty = FALSE;
+        p = new_text;
+        memcpy(p, text, (args_end - text) * sizeof(WCHAR)); p += args_end - text;
+        if(!empty) { *p++ = ','; *p++ = ' '; }
+        wcscpy(p, name); p += wcslen(p);
+        *p++ = '=';
+        wcscpy(p, V_BSTR(&str)); p += wcslen(p);
+        wcscpy(p, args_end);
+    }
+    VariantClear(&str);
+    free(text);
+
+    hres = IHTMLElement_get_style(&This->elem->IHTMLElement_iface, &style);
+    if(SUCCEEDED(hres)) {
+        if((bstr = SysAllocString(new_text))) {
+            hres = IHTMLStyle_put_filter(style, bstr);
+            SysFreeString(bstr);
+        }else {
+            hres = E_OUTOFMEMORY;
+        }
+        IHTMLStyle_Release(style);
+    }
+    free(new_text);
+    return hres;
+}
+
+static HRESULT WINAPI HTMLFilter_Invoke(IDispatch *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *params, VARIANT *res, EXCEPINFO *ei, UINT *argerr)
+{
+    HTMLFilter *This = impl_from_filter_IDispatch(iface);
+    const WCHAR *val, *val_end;
+    struct filter_span f;
+    const WCHAR *name;
+    WCHAR *text;
+    HRESULT hres;
+
+    TRACE("(%p)->(%ld %x)\n", This, id, flags);
+
+    switch(id) {
+    case FILTER_DISPID_APPLY:
+        This->status = 1;
+        return S_OK;
+    case FILTER_DISPID_PLAY:
+    case FILTER_DISPID_STOP:
+        /* the transition is done at once */
+        This->status = 0;
+        return S_OK;
+    case FILTER_DISPID_STATUS:
+        if(!(flags & DISPATCH_PROPERTYGET) || !res)
+            return DISP_E_MEMBERNOTFOUND;
+        V_VT(res) = VT_I4;
+        V_I4(res) = This->status;
+        return S_OK;
+    }
+    if(id < FILTER_DISPID_PARAM || id - FILTER_DISPID_PARAM >= This->names_cnt)
+        return DISP_E_MEMBERNOTFOUND;
+    name = This->names[id - FILTER_DISPID_PARAM];
+
+    if(flags & (DISPATCH_PROPERTYPUT | DISPATCH_PROPERTYPUTREF)) {
+        if(!params || params->cArgs < 1)
+            return DISP_E_PARAMNOTOPTIONAL;
+        return set_filter_param(This, name, &params->rgvarg[0]);
+    }
+    if(!(flags & DISPATCH_PROPERTYGET))
+        return DISP_E_MEMBERNOTFOUND;
+    if(!res)
+        return S_OK;
+    V_VT(res) = VT_EMPTY;
+    text = get_filter_text(This->elem);
+    if(!text || find_filter(text, NULL, This->index, &f) < 0) {
+        free(text);
+        return S_OK;
+    }
+    if(find_param(&f, name, &val, &val_end))
+        hres = param_variant(val, val_end, res);
+    else {
+        filter_param_default(&f, name, res);
+        hres = S_OK;
+    }
+    free(text);
+    return hres;
+}
+
+static const IDispatchVtbl HTMLFilterVtbl = {
+    HTMLFilter_QueryInterface,
+    HTMLFilter_AddRef,
+    HTMLFilter_Release,
+    HTMLFilter_GetTypeInfoCount,
+    HTMLFilter_GetTypeInfo,
+    HTMLFilter_GetIDsOfNames,
+    HTMLFilter_Invoke
+};
+
+static HRESULT create_filter(HTMLElement *elem, LONG index, IDispatch **ret)
+{
+    HTMLFilter *filter;
+
+    if(!(filter = calloc(1, sizeof(*filter))))
+        return E_OUTOFMEMORY;
+    filter->IDispatch_iface.lpVtbl = &HTMLFilterVtbl;
+    filter->ref = 1;
+    filter->elem = elem;
+    IHTMLElement_AddRef(&elem->IHTMLElement_iface);
+    filter->index = index;
+    *ret = &filter->IDispatch_iface;
+    return S_OK;
+}
+
+static LONG elem_filter_count(HTMLElement *elem)
+{
+    WCHAR *text;
+    LONG n;
+
+    if(!elem)
+        return 0;
+    text = get_filter_text(elem);
+    n = count_filters(text);
+    free(text);
+    return n;
+}
+
+/* the filter an index or a name gives, -1 for none */
+static LONG elem_filter_index(HTMLElement *elem, const WCHAR *name)
+{
+    WCHAR *text;
+    LONG i;
+
+    if(!elem || !(text = get_filter_text(elem)))
+        return -1;
+    i = find_filter(text, name, 0, NULL);
+    free(text);
+    return i;
+}
+#else
+static LONG elem_filter_count(HTMLElement *elem) { return 0; }
+static LONG elem_filter_index(HTMLElement *elem, const WCHAR *name) { return -1; }
+static HRESULT create_filter(HTMLElement *elem, LONG index, IDispatch **ret) { return E_NOTIMPL; }
+#endif
