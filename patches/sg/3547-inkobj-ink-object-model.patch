+static HRESULT get_typeinfo(REFIID iid, ITypeInfo **ret)
+{
+    HRESULT hr;
+
+    if (!ink_typelib)
+    {
+        WCHAR path[MAX_PATH];
+        ITypeLib *lib;
+        HMODULE module;
+
+        GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                (const WCHAR *)get_typeinfo, &module);
+        GetModuleFileNameW(module, path, ARRAY_SIZE(path));
+        if (FAILED(hr = LoadTypeLibEx(path, REGKIND_NONE, &lib)))
+        {
+            ERR("LoadTypeLibEx failed: %#lx\n", hr);
+            return hr;
+        }
+        if (InterlockedCompareExchangePointer((void **)&ink_typelib, lib, NULL)) ITypeLib_Release(lib);
+    }
+    return ITypeLib_GetTypeInfoOfGuid(ink_typelib, iid, ret);
+}
