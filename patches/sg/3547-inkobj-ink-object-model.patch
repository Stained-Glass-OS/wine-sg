+    custom_Release,
+    custom_GetTypeInfoCount,
+    custom_GetTypeInfo,
+    custom_GetIDsOfNames,
+    custom_Invoke,
+    custom_get_Count,
+    custom_get__NewEnum,
+    custom_Item,
+    custom_Add,
+    custom_Remove,
+    custom_Clear,
+};
