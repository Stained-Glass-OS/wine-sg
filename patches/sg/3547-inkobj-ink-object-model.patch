+/* Catmull-Rom spline through the points, as Bezier control points */
+static LONG *stroke_bezier(struct stroke *s, LONG *count)
+{
+    LONG n = s->npackets, i, *res, k = 0;
+    const LONG *d = s->data;
+    int ps = s->psize;
+
+    if (n < 2)
+    {
+        if (!(res = malloc(2 * sizeof(LONG)))) return NULL;
+        res[0] = n ? d[0] : 0;
+        res[1] = n ? d[1] : 0;
+        *count = n;
+        return res;
+    }
+    if (!(res = malloc((3 * (n - 1) + 1) * 2 * sizeof(LONG)))) return NULL;
+    res[k++] = d[0];
+    res[k++] = d[1];
+    for (i = 0; i + 1 < n; i++)
+    {
+        LONG p0 = i ? i - 1 : i, p3 = i + 2 < n ? i + 2 : i + 1, c;
+
+        for (c = 0; c < 2; c++) res[k + c] = round_long(d[i * ps + c] + (d[(i + 1) * ps + c] - d[p0 * ps + c]) / 6.0);
+        k += 2;
+        for (c = 0; c < 2; c++) res[k + c] = round_long(d[(i + 1) * ps + c] - (d[p3 * ps + c] - d[i * ps + c]) / 6.0);
+        k += 2;
+        res[k++] = d[(i + 1) * ps];
+        res[k++] = d[(i + 1) * ps + 1];
+    }
+    *count = 3 * (n - 1) + 1;
+    return res;
+}
+
+static HRESULT WINAPI stroke_get_BezierPoints(IInkStrokeDisp *iface, VARIANT *points)
+{
