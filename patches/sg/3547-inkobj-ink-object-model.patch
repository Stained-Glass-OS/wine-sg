+/* the bytes of a Load / paste argument: a byte array or a string holding base64 */
+static HRESULT variant_bytes(const VARIANT *var, BYTE **out, size_t *len)
+{
+    const VARIANT *v = var;
+    BYTE *data;
+    char *tmp;
+    size_t n;
+    HRESULT hr = S_OK;
+
+    while (V_VT(v) == (VT_VARIANT | VT_BYREF)) v = V_VARIANTREF(v);
+    *out = NULL;
+    if (V_VT(v) == VT_BSTR && V_BSTR(v))
+    {
+        UINT l = SysStringLen(V_BSTR(v)), i;
+        if (!(tmp = malloc(l + 1))) return E_OUTOFMEMORY;
+        for (i = 0; i < l; i++) tmp[i] = V_BSTR(v)[i] < 128 ? (char)V_BSTR(v)[i] : '!';
+        *out = base64_decode(tmp, l, len);
+        free(tmp);
+        return *out ? S_OK : E_INVALIDARG;
+    }
+    if (V_VT(v) == (VT_ARRAY | VT_UI1) || V_VT(v) == (VT_ARRAY | VT_UI1 | VT_BYREF))
+    {
+        SAFEARRAY *sa = (V_VT(v) & VT_BYREF) ? *V_ARRAYREF(v) : V_ARRAY(v);
+        LONG lb, ub;
+        void *p;
+
+        if (!sa || SafeArrayGetDim(sa) != 1) return E_INVALIDARG;
+        SafeArrayGetLBound(sa, 1, &lb);
+        SafeArrayGetUBound(sa, 1, &ub);
+        n = ub - lb + 1;
+        if (!(data = malloc(max(n, 1)))) return E_OUTOFMEMORY;
+        if (FAILED(hr = SafeArrayAccessData(sa, &p))) { free(data); return hr; }
+        memcpy(data, p, n);
+        SafeArrayUnaccessData(sa);
+        if (n >= 4 && *(LONG *)data != SGINK_MAGIC)
+        {
+            /* maybe base64 text in a byte array */
+            BYTE *dec = base64_decode((char *)data, n, len);
+            free(data);
+            if (!dec) return E_INVALIDARG;
+            *out = dec;
+            return S_OK;
+        }
+        *out = data;
+        *len = n;
+        return S_OK;
+    }
+    return E_INVALIDARG;
 }
 
