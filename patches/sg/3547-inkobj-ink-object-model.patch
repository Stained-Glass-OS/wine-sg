+    if (!points) return E_POINTER;
+    LIVE(s);
+    if (!(pts = stroke_bezier(s, &count))) return E_OUTOFMEMORY;
+    hr = make_long_array(pts, count * 2, points);
+    free(pts);
+    return hr;
+}
