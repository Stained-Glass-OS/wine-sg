+/* ---- enumerator over a copy of a VARIANT list ---- */
+
+struct enumvar
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    VARIANT *items;
+    ULONG count, pos;
+};
+
+static inline struct enumvar *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, struct enumvar, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI enumvar_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumVARIANT))
+    {
+        *out = iface;
+        IEnumVARIANT_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enumvar_AddRef(IEnumVARIANT *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumVARIANT(iface)->ref);
+}
+
+static ULONG WINAPI enumvar_Release(IEnumVARIANT *iface)
+{
+    struct enumvar *e = impl_from_IEnumVARIANT(iface);
+    ULONG ref = InterlockedDecrement(&e->ref);
+    ULONG i;
+
+    if (!ref)
+    {
+        for (i = 0; i < e->count; i++) VariantClear(&e->items[i]);
+        free(e->items);
+        free(e);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enumvar_Next(IEnumVARIANT *iface, ULONG count, VARIANT *vars, ULONG *fetched)
+{
+    struct enumvar *e = impl_from_IEnumVARIANT(iface);
+    ULONG n = 0;
+
+    while (n < count && e->pos < e->count)
+    {
+        VariantInit(&vars[n]);
+        VariantCopy(&vars[n], &e->items[e->pos]);
+        n++;
+        e->pos++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enumvar_Skip(IEnumVARIANT *iface, ULONG count)
+{
+    struct enumvar *e = impl_from_IEnumVARIANT(iface);
+    e->pos += count;
+    if (e->pos > e->count) { e->pos = e->count; return S_FALSE; }
+    return S_OK;
+}
+
+static HRESULT WINAPI enumvar_Reset(IEnumVARIANT *iface)
+{
+    impl_from_IEnumVARIANT(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_enumvar(VARIANT *items, ULONG count, ULONG pos, IEnumVARIANT **out);
+
+static HRESULT WINAPI enumvar_Clone(IEnumVARIANT *iface, IEnumVARIANT **out)
+{
+    struct enumvar *e = impl_from_IEnumVARIANT(iface);
+    return create_enumvar(e->items, e->count, e->pos, out);
+}
+
+static const IEnumVARIANTVtbl enumvar_vtbl =
+{
+    enumvar_QueryInterface,
+    enumvar_AddRef,
+    enumvar_Release,
+    enumvar_Next,
+    enumvar_Skip,
+    enumvar_Reset,
+    enumvar_Clone,
+};
+
+static HRESULT create_enumvar(VARIANT *items, ULONG count, ULONG pos, IEnumVARIANT **out)
+{
+    struct enumvar *e;
+    ULONG i;
+
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
+    if (!(e->items = calloc(max(count, 1), sizeof(VARIANT)))) { free(e); return E_OUTOFMEMORY; }
+    for (i = 0; i < count; i++) VariantCopy(&e->items[i], &items[i]);
+    e->IEnumVARIANT_iface.lpVtbl = &enumvar_vtbl;
+    e->ref = 1;
+    e->count = count;
+    e->pos = pos;
+    *out = &e->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+#define DISP_QI(type, iid_) \
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IDispatch) || IsEqualIID(riid, &iid_)) \
+    { \
+        *out = iface; \
+        type##_AddRef(iface); \
+        return S_OK; \
+    } \
+    WARN("%s not implemented\n", debugstr_guid(riid)); \
+    *out = NULL; \
+    return E_NOINTERFACE;
