+static HRESULT WINAPI stroke_FindIntersections(IInkStrokeDisp *iface, IInkStrokes *strokes, VARIANT *res)
+{
+    struct stroke *s = impl_from_IInkStrokeDisp(iface);
+    struct strokes *o = strokes_from_iface(strokes);
+    float *vals = NULL;
+    LONG n = 0, cap = 0, i, j, k;
+    HRESULT hr;
+
+    if (!res) return E_POINTER;
+    LIVE(s);
+    if (!o) return E_INVALIDARG;
+    for (k = 0; k < o->count; k++)
+    {
+        struct stroke *t = o->items[k];
+        if (t == s || t->deleted) continue;
+        for (i = 0; i + 1 < s->npackets; i++)
+            for (j = 0; j + 1 < t->npackets; j++)
+            {
+                double ta, tb;
+                if (!seg_intersect(s->data[i * s->psize], s->data[i * s->psize + 1],
+                        s->data[(i + 1) * s->psize], s->data[(i + 1) * s->psize + 1],
+                        t->data[j * t->psize], t->data[j * t->psize + 1],
+                        t->data[(j + 1) * t->psize], t->data[(j + 1) * t->psize + 1], &ta, &tb)) continue;
+                if (n + 1 > cap)
+                {
+                    float *nv = realloc(vals, (cap = cap ? cap * 2 : 16) * sizeof(float));
+                    if (!nv) { free(vals); return E_OUTOFMEMORY; }
+                    vals = nv;
+                }
+                vals[n++] = (float)(i + ta);
+            }
+    }
+    hr = make_float_array(vals, n, res);
+    free(vals);
+    return hr;
+}
+
+static HRESULT WINAPI stroke_GetRectangleIntersections(IInkStrokeDisp *iface, IInkRectangle *rect, VARIANT *res)
+{
+    struct stroke *s = impl_from_IInkStrokeDisp(iface);
+    float *vals = NULL;
+    LONG n = 0, cap = 0, i, e;
+    RECT r;
+    HRESULT hr;
+
+    if (!res) return E_POINTER;
+    LIVE(s);
+    if (FAILED(hr = get_rect(rect, &r))) return hr;
+    normalize_rect(&r);
+    for (i = 0; i + 1 < s->npackets; i++)
+    {
+        double x1 = s->data[i * s->psize], y1 = s->data[i * s->psize + 1];
+        double x2 = s->data[(i + 1) * s->psize], y2 = s->data[(i + 1) * s->psize + 1];
+        double ts[4]; int nt = 0, k;
+        double ex[4][4] = { { r.left, r.top, r.right, r.top }, { r.right, r.top, r.right, r.bottom },
+                { r.right, r.bottom, r.left, r.bottom }, { r.left, r.bottom, r.left, r.top } };
+
+        for (e = 0; e < 4; e++)
+        {
+            double ta, tb;
+            if (seg_intersect(x1, y1, x2, y2, ex[e][0], ex[e][1], ex[e][2], ex[e][3], &ta, &tb)) ts[nt++] = ta;
+        }
+        /* sort the crossings along the segment */
+        for (e = 0; e < nt; e++) for (k = e + 1; k < nt; k++) if (ts[k] < ts[e]) { double t = ts[e]; ts[e] = ts[k]; ts[k] = t; }
+        for (e = 0; e < nt; e++)
+        {
+            if (n + 1 > cap)
+            {
+                float *nv = realloc(vals, (cap = cap ? cap * 2 : 16) * sizeof(float));
+                if (!nv) { free(vals); return E_OUTOFMEMORY; }
+                vals = nv;
+            }
+            vals[n++] = (float)(i + ts[e]);
+        }
+    }
+    hr = make_float_array(vals, n, res);
+    free(vals);
+    return hr;
+}
