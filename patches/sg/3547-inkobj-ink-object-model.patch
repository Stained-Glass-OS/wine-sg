+static HRESULT WINAPI stroke_Split(IInkStrokeDisp *iface, float at, IInkStrokeDisp **out)
+{
+    struct stroke *s = impl_from_IInkStrokeDisp(iface), *n;
+    LONG idx, ps, rest, c;
+    double frac;
+    LONG *buf;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    LIVE(s);
+    if (!s->ink || at <= 0.0f || at >= (float)(s->npackets - 1)) return E_INVALIDARG;
+    idx = (LONG)floorf(at);
+    frac = at - idx;
+    ps = s->psize;
+    if (frac == 0.0)
+    {
+        /* split at an existing point: the new stroke starts with it, the old one ends with it */
+        rest = s->npackets - idx;
+        if (!(buf = malloc(rest * ps * sizeof(LONG)))) return E_OUTOFMEMORY;
+        memcpy(buf, s->data + idx * ps, rest * ps * sizeof(LONG));
+        if (FAILED(hr = stroke_create(s->ink, s->ink->next_id, rest, ps, buf, s->desc, &n))) { free(buf); return hr; }
+        s->npackets = idx + 1;
+    }
+    else
+    {
+        rest = s->npackets - idx;       /* interpolated point + points idx+1 .. end */
+        if (!(buf = malloc(rest * ps * sizeof(LONG)))) return E_OUTOFMEMORY;
+        for (c = 0; c < ps; c++)
+            buf[c] = round_long(s->data[idx * ps + c] + frac * (s->data[(idx + 1) * ps + c] - s->data[idx * ps + c]));
+        memcpy(buf + ps, s->data + (idx + 1) * ps, (rest - 1) * ps * sizeof(LONG));
+        if (FAILED(hr = stroke_create(s->ink, s->ink->next_id, rest, ps, buf, s->desc, &n))) { free(buf); return hr; }
+        for (c = 0; c < ps; c++) s->data[(idx + 1) * ps + c] = buf[c];
+        s->npackets = idx + 2;
+    }
+    free(buf);
+    attrs_assign(n->attrs, &s->attrs->IInkDrawingAttributes_iface);
+    props_copy(n->props, s->props);
+    if (FAILED(hr = ink_add_stroke(s->ink, n))) { stroke_free(n); return hr; }
+    s->ink->dirty = VARIANT_TRUE;
+    *out = &n->IInkStrokeDisp_iface;
+    IInkStrokeDisp_AddRef(*out);
+    IInkStrokeDisp_Release(&n->IInkStrokeDisp_iface); /* the ink's reference */
+    return S_OK;
+}
+
+static HRESULT WINAPI stroke_GetPacketDescriptionPropertyMetrics(IInkStrokeDisp *iface, BSTR name, LONG *min,
+        LONG *max, TabletPropertyMetricUnit *units, float *resolution)
+{
+    struct stroke *s = impl_from_IInkStrokeDisp(iface);
+    LONG i, c = -1;
+
+    if (!name || !min || !max || !units || !resolution) return E_POINTER;
+    LIVE(s);
+    for (i = 0; i < s->psize; i++)
+        if (!wcsicmp(s->desc[i], name)) { c = i; break; }
+    if (c < 0) return E_INVALIDARG;
+    if (c > 1) return E_INVALIDARG;     /* only the coordinates have known metrics */
+    *min = 0x7fffffff;
+    *max = -0x7fffffff - 1;
+    for (i = 0; i < s->npackets; i++)
+    {
+        *min = min(*min, s->data[i * s->psize + c]);
+        *max = max(*max, s->data[i * s->psize + c]);
+    }
+    *units = TPMU_Centimeters;
+    *resolution = 1000.0f;      /* ink space is 0.01 mm: 1000 units per centimetre */
+    return S_OK;
+}
+
+static HRESULT check_range(struct stroke *s, LONG index, LONG *count)
+{
+    if (index < 0 || index >= s->npackets) return E_INVALIDARG;
+    if (*count == -1) *count = s->npackets - index;
+    if (*count <= 0 || index + *count > s->npackets) return E_INVALIDARG;
+    return S_OK;
+}
+
+static HRESULT WINAPI stroke_GetPoints(IInkStrokeDisp *iface, LONG index, LONG count, VARIANT *points)
+{
+    struct stroke *s = impl_from_IInkStrokeDisp(iface);
+    LONG *buf, i;
+    HRESULT hr;
+
+    if (!points) return E_POINTER;
+    LIVE(s);
+    if (FAILED(hr = check_range(s, index, &count))) return hr;
+    if (!(buf = malloc(count * 2 * sizeof(LONG)))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        buf[2 * i] = s->data[(index + i) * s->psize];
+        buf[2 * i + 1] = s->data[(index + i) * s->psize + 1];
+    }
+    hr = make_long_array(buf, count * 2, points);
+    free(buf);
+    return hr;
+}
+
+static HRESULT WINAPI stroke_SetPoints(IInkStrokeDisp *iface, VARIANT points, LONG index, LONG count, LONG *set)
+{
+    struct stroke *s = impl_from_IInkStrokeDisp(iface);
+    LONG *pts, n, newn, i, ps = s->psize, *nd;
+    HRESULT hr;
+
+    if (!set) return E_POINTER;
+    *set = 0;
+    LIVE(s);
+    if (FAILED(hr = variant_to_longs(&points, &pts, &n)) || hr == S_FALSE) return hr == S_FALSE ? E_INVALIDARG : hr;
+    if (n < 2 || (n & 1)) { free(pts); return E_INVALIDARG; }
+    n /= 2;
+    if (FAILED(hr = check_range(s, index, &count))) { free(pts); return hr; }
+    newn = s->npackets - count + n;
+    if (!(nd = malloc(newn * ps * sizeof(LONG)))) { free(pts); return E_OUTOFMEMORY; }
+    memcpy(nd, s->data, index * ps * sizeof(LONG));
+    for (i = 0; i < n; i++)
+    {
+        memset(nd + (index + i) * ps, 0, ps * sizeof(LONG));
+        nd[(index + i) * ps] = pts[2 * i];
+        nd[(index + i) * ps + 1] = pts[2 * i + 1];
+        if (i < count) /* keep the other properties of a replaced packet */
+            memcpy(nd + (index + i) * ps + 2, s->data + (index + i) * ps + 2, (ps - 2) * sizeof(LONG));
+    }
+    memcpy(nd + (index + n) * ps, s->data + (index + count) * ps, (s->npackets - index - count) * ps * sizeof(LONG));
+    free(pts);
+    free(s->data);
+    s->data = nd;
+    s->npackets = newn;
+    stroke_touch(s);
+    *set = n;
+    return S_OK;
+}
+
+static HRESULT WINAPI stroke_GetPacketData(IInkStrokeDisp *iface, LONG index, LONG count, VARIANT *data)
+{
+    struct stroke *s = impl_from_IInkStrokeDisp(iface);
+    HRESULT hr;
+
+    if (!data) return E_POINTER;
+    LIVE(s);
+    if (FAILED(hr = check_range(s, index, &count))) return hr;
+    return make_long_array(s->data + index * s->psize, count * s->psize, data);
+}
