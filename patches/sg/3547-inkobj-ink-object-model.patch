+/* ---- IInkCustomStrokes ---- */
+
+struct custom
+{
+    IInkCustomStrokes IInkCustomStrokes_iface;
+    LONG ref;
+    BSTR *names;
+    IInkStrokes **sets;
+    LONG count, size;
+};
+
+static inline struct custom *impl_from_IInkCustomStrokes(IInkCustomStrokes *iface)
+{
+    return CONTAINING_RECORD(iface, struct custom, IInkCustomStrokes_iface);
+}
+
+static HRESULT WINAPI custom_QueryInterface(IInkCustomStrokes *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p\n", iface, debugstr_guid(riid), out);
+    DISP_QI(IInkCustomStrokes, IID_IInkCustomStrokes)
+}
+
+static ULONG WINAPI custom_AddRef(IInkCustomStrokes *iface)
+{
+    return InterlockedIncrement(&impl_from_IInkCustomStrokes(iface)->ref);
+}
+
+static void custom_remove_at(struct custom *c, LONG i)
+{
+    SysFreeString(c->names[i]);
+    IInkStrokes_Release(c->sets[i]);
+    memmove(&c->names[i], &c->names[i + 1], (c->count - i - 1) * sizeof(*c->names));
+    memmove(&c->sets[i], &c->sets[i + 1], (c->count - i - 1) * sizeof(*c->sets));
+    c->count--;
+}
+
+static ULONG WINAPI custom_Release(IInkCustomStrokes *iface)
+{
+    struct custom *c = impl_from_IInkCustomStrokes(iface);
+    ULONG ref = InterlockedDecrement(&c->ref);
+
+    if (!ref)
+    {
+        while (c->count) custom_remove_at(c, c->count - 1);
+        free(c->names);
+        free(c->sets);
+        free(c);
+    }
+    return ref;
+}
+
+DISPATCH_IMPL(custom, IInkCustomStrokes, IID_IInkCustomStrokes)
+
+static HRESULT WINAPI custom_get_Count(IInkCustomStrokes *iface, LONG *count)
+{
+    if (!count) return E_POINTER;
+    *count = impl_from_IInkCustomStrokes(iface)->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI custom_get__NewEnum(IInkCustomStrokes *iface, IUnknown **out)
+{
+    struct custom *c = impl_from_IInkCustomStrokes(iface);
+    IEnumVARIANT *e;
+    VARIANT *vars;
+    HRESULT hr;
+    LONG i;
+
+    if (!out) return E_POINTER;
+    if (!(vars = calloc(max(c->count, 1), sizeof(*vars)))) return E_OUTOFMEMORY;
+    for (i = 0; i < c->count; i++)
+    {
+        V_VT(&vars[i]) = VT_DISPATCH;
+        V_DISPATCH(&vars[i]) = (IDispatch *)c->sets[i];
+        IDispatch_AddRef(V_DISPATCH(&vars[i]));
+    }
+    hr = create_enumvar(vars, c->count, 0, &e);
+    for (i = 0; i < c->count; i++) VariantClear(&vars[i]);
+    free(vars);
+    if (FAILED(hr)) return hr;
+    *out = (IUnknown *)e;
+    return S_OK;
+}
+
+static HRESULT custom_find(struct custom *c, const VARIANT *id, LONG *index)
+{
+    VARIANT v;
+
+    while (V_VT(id) == (VT_VARIANT | VT_BYREF)) id = V_VARIANTREF(id);
+    if (V_VT(id) == VT_BSTR)
+    {
+        LONG i;
+        for (i = 0; i < c->count; i++)
+            if (V_BSTR(id) && !wcscmp(c->names[i], V_BSTR(id))) { *index = i; return S_OK; }
+        return E_INVALIDARG;
+    }
+    VariantInit(&v);
+    if (FAILED(VariantChangeType(&v, (VARIANT *)id, 0, VT_I4))) return E_INVALIDARG;
+    if (V_I4(&v) < 0 || V_I4(&v) >= c->count) return E_INVALIDARG;
+    *index = V_I4(&v);
+    return S_OK;
+}
+
+static HRESULT WINAPI custom_Item(IInkCustomStrokes *iface, VARIANT id, IInkStrokes **out)
+{
+    struct custom *c = impl_from_IInkCustomStrokes(iface);
+    LONG i;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = custom_find(c, &id, &i))) return hr;
+    *out = c->sets[i];
+    IInkStrokes_AddRef(*out);
+    return S_OK;
+}
+
+static HRESULT WINAPI custom_Add(IInkCustomStrokes *iface, BSTR name, IInkStrokes *strokes)
+{
+    struct custom *c = impl_from_IInkCustomStrokes(iface);
+    VARIANT id;
+    LONG i;
+
+    if (!name || !strokes_from_iface(strokes)) return E_INVALIDARG;
+    V_VT(&id) = VT_BSTR;
+    V_BSTR(&id) = name;
+    if (SUCCEEDED(custom_find(c, &id, &i)))
+    {
+        IInkStrokes_AddRef(strokes);
+        IInkStrokes_Release(c->sets[i]);
+        c->sets[i] = strokes;
+        return S_OK;
+    }
+    if (c->count == c->size)
+    {
+        LONG ns = c->size ? c->size * 2 : 4;
+        BSTR *nn = realloc(c->names, ns * sizeof(*nn));
+        IInkStrokes **nset;
+        if (!nn) return E_OUTOFMEMORY;
+        c->names = nn;
+        if (!(nset = realloc(c->sets, ns * sizeof(*nset)))) return E_OUTOFMEMORY;
+        c->sets = nset;
+        c->size = ns;
+    }
+    if (!(c->names[c->count] = SysAllocString(name))) return E_OUTOFMEMORY;
+    c->sets[c->count] = strokes;
+    IInkStrokes_AddRef(strokes);
+    c->count++;
+    return S_OK;
+}
+
+static HRESULT WINAPI custom_Remove(IInkCustomStrokes *iface, VARIANT id)
+{
+    struct custom *c = impl_from_IInkCustomStrokes(iface);
+    LONG i;
+    HRESULT hr;
+
+    if (FAILED(hr = custom_find(c, &id, &i))) return hr;
+    custom_remove_at(c, i);
+    return S_OK;
+}
+
+static HRESULT WINAPI custom_Clear(IInkCustomStrokes *iface)
+{
+    struct custom *c = impl_from_IInkCustomStrokes(iface);
+    while (c->count) custom_remove_at(c, c->count - 1);
+    return S_OK;
+}
+
+static const IInkCustomStrokesVtbl custom_vtbl =
