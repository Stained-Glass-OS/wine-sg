+/* ---- helpers ---- */
+
+static LONG round_long(double v)
+{
+    if (v >= 2147483647.0) return 0x7fffffff;
+    if (v <= -2147483648.0) return (-0x7fffffff - 1);
+    return (LONG)floor(v + 0.5);
+}
+
+static HRESULT make_long_array(const LONG *data, LONG count, VARIANT *var)
+{
+    SAFEARRAY *sa;
+    LONG *p;
+
+    if (!(sa = SafeArrayCreateVector(VT_I4, 0, count))) return E_OUTOFMEMORY;
+    if (count)
+    {
+        SafeArrayAccessData(sa, (void **)&p);
+        memcpy(p, data, count * sizeof(LONG));
+        SafeArrayUnaccessData(sa);
+    }
+    V_VT(var) = VT_ARRAY | VT_I4;
+    V_ARRAY(var) = sa;
+    return S_OK;
+}
+
+static HRESULT make_float_array(const float *data, LONG count, VARIANT *var)
+{
+    SAFEARRAY *sa;
+    float *p;
+
+    if (!(sa = SafeArrayCreateVector(VT_R4, 0, count))) return E_OUTOFMEMORY;
+    if (count)
+    {
+        SafeArrayAccessData(sa, (void **)&p);
+        memcpy(p, data, count * sizeof(float));
+        SafeArrayUnaccessData(sa);
+    }
+    V_VT(var) = VT_ARRAY | VT_R4;
+    V_ARRAY(var) = sa;
+    return S_OK;
+}
+
+/* Reads a one dimensional array of numbers from a VARIANT (VT_I4 / VT_I2 /
+ * VT_UI1 / VT_VARIANT elements, optionally by reference). */
+static HRESULT variant_to_longs(const VARIANT *var, LONG **out, LONG *count)
+{
+    const VARIANT *v = var;
+    SAFEARRAY *sa;
+    VARTYPE vt;
+    LONG lb, ub, i;
+    LONG *res;
+    void *data;
+    HRESULT hr;
+
+    *out = NULL;
+    *count = 0;
+    while (V_VT(v) == (VT_VARIANT | VT_BYREF)) v = V_VARIANTREF(v);
+    if (V_VT(v) == VT_EMPTY || V_VT(v) == VT_NULL || V_VT(v) == VT_ERROR) return S_FALSE;
+    if (!(V_VT(v) & VT_ARRAY)) return E_INVALIDARG;
+    sa = (V_VT(v) & VT_BYREF) ? *V_ARRAYREF(v) : V_ARRAY(v);
+    if (!sa || SafeArrayGetDim(sa) != 1) return E_INVALIDARG;
+    if (FAILED(hr = SafeArrayGetVartype(sa, &vt))) return hr;
+    SafeArrayGetLBound(sa, 1, &lb);
+    SafeArrayGetUBound(sa, 1, &ub);
+    *count = ub - lb + 1;
+    if (!(res = malloc(max(*count, 1) * sizeof(LONG)))) return E_OUTOFMEMORY;
+    if (FAILED(hr = SafeArrayAccessData(sa, &data))) { free(res); return hr; }
+    for (i = 0; i < *count; i++)
+    {
+        switch (vt)
+        {
+        case VT_I4: case VT_INT: res[i] = ((LONG *)data)[i]; break;
+        case VT_UI4: case VT_UINT: res[i] = ((ULONG *)data)[i]; break;
+        case VT_I2: res[i] = ((SHORT *)data)[i]; break;
+        case VT_UI1: res[i] = ((BYTE *)data)[i]; break;
+        case VT_R4: res[i] = round_long(((float *)data)[i]); break;
+        case VT_R8: res[i] = round_long(((double *)data)[i]); break;
+        case VT_VARIANT:
+        {
+            VARIANT t;
+            VariantInit(&t);
+            if (FAILED(hr = VariantChangeType(&t, &((VARIANT *)data)[i], 0, VT_I4)))
+            {
+                SafeArrayUnaccessData(sa);
+                free(res);
+                return hr;
+            }
+            res[i] = V_I4(&t);
+            break;
+        }
+        default:
+            SafeArrayUnaccessData(sa);
+            free(res);
+            return E_INVALIDARG;
+        }
+    }
+    SafeArrayUnaccessData(sa);
+    *out = res;
+    return S_OK;
+}
+
+static BOOL variant_is_missing(const VARIANT *v)
+{
+    while (V_VT(v) == (VT_VARIANT | VT_BYREF)) v = V_VARIANTREF(v);
+    return V_VT(v) == VT_EMPTY || V_VT(v) == VT_NULL || V_VT(v) == VT_ERROR;
+}
