+static void stroke_bbox(struct stroke *s, InkBoundingBoxMode mode, BOOL *any, RECT *rect)
+{
+    LONG i, x, y;
+    RECT r;
+
+    r.left = r.top = 0x7fffffff;
+    r.right = r.bottom = -0x7fffffff - 1;
+    for (i = 0; i < s->npackets; i++)
+    {
+        x = s->data[i * s->psize];
+        y = s->data[i * s->psize + 1];
+        if (x < r.left) r.left = x;
+        if (x > r.right) r.right = x;
+        if (y < r.top) r.top = y;
+        if (y > r.bottom) r.bottom = y;
+    }
+    if (!s->npackets) return;
+    if (mode != IBBM_PointsOnly)
+    {
+        LONG hw = (LONG)ceil(s->attrs->width / 2.0f), hh = (LONG)ceil(s->attrs->height / 2.0f);
+        r.left -= hw; r.right += hw; r.top -= hh; r.bottom += hh;
+    }
+    if (!*any) *rect = r;
+    else
+    {
+        rect->left = min(rect->left, r.left);
+        rect->right = max(rect->right, r.right);
+        rect->top = min(rect->top, r.top);
+        rect->bottom = max(rect->bottom, r.bottom);
+    }
+    *any = TRUE;
+}
+
+static void stroke_apply_matrix(struct stroke *s, const double m[6])
+{
+    LONG i;
+
+    for (i = 0; i < s->npackets; i++)
+    {
+        double x = s->data[i * s->psize], y = s->data[i * s->psize + 1];
+        s->data[i * s->psize] = round_long(m[0] * x + m[2] * y + m[4]);
+        s->data[i * s->psize + 1] = round_long(m[1] * x + m[3] * y + m[5]);
+    }
+}
+
+static void stroke_touch(struct stroke *s);
+
+static double stroke_nearest(struct stroke *s, double x, double y, double *pos)
+{
+    double best = 1e300, t, d;
+    LONG i;
+
+    if (s->npackets == 1)
+    {
+        *pos = 0.0;
+        return hypot(x - s->data[0], y - s->data[1]);
+    }
+    for (i = 0; i + 1 < s->npackets; i++)
+    {
+        d = point_seg_dist(x, y, s->data[i * s->psize], s->data[i * s->psize + 1],
+                s->data[(i + 1) * s->psize], s->data[(i + 1) * s->psize + 1], &t);
+        if (d < best) { best = d; *pos = i + t; }
+    }
+    return best;
+}
+
+/* fraction of the stroke length inside the rectangle */
+static double stroke_fraction_in_rect(struct stroke *s, const RECT *r)
+{
+    double total = 0.0, inside = 0.0, t0, t1, len;
+    LONG i;
+
+    if (s->npackets == 1)
+        return (s->data[0] >= r->left && s->data[0] <= r->right && s->data[1] >= r->top && s->data[1] <= r->bottom)
+                ? 1.0 : 0.0;
+    for (i = 0; i + 1 < s->npackets; i++)
+    {
+        double x1 = s->data[i * s->psize], y1 = s->data[i * s->psize + 1];
+        double x2 = s->data[(i + 1) * s->psize], y2 = s->data[(i + 1) * s->psize + 1];
+        len = hypot(x2 - x1, y2 - y1);
+        total += len;
+        if (clip_segment(x1, y1, x2, y2, r, &t0, &t1)) inside += (t1 - t0) * len;
+    }
+    if (total == 0.0)
+        return (s->data[0] >= r->left && s->data[0] <= r->right && s->data[1] >= r->top && s->data[1] <= r->bottom)
+                ? 1.0 : 0.0;
+    return inside / total;
+}
+
+static double stroke_fraction_in_polygon(struct stroke *s, const LONG *poly, LONG n)
+{
+    double total = 0.0, inside = 0.0, len;
+    LONG i;
+
+    if (s->npackets == 1) return point_in_polygon(s->data[0], s->data[1], poly, n) ? 1.0 : 0.0;
+    for (i = 0; i + 1 < s->npackets; i++)
+    {
+        double x1 = s->data[i * s->psize], y1 = s->data[i * s->psize + 1];
+        double x2 = s->data[(i + 1) * s->psize], y2 = s->data[(i + 1) * s->psize + 1];
+        len = hypot(x2 - x1, y2 - y1);
+        total += len;
+        if (point_in_polygon((x1 + x2) / 2, (y1 + y2) / 2, poly, n)) inside += len;
+    }
+    if (total == 0.0) return point_in_polygon(s->data[0], s->data[1], poly, n) ? 1.0 : 0.0;
+    return inside / total;
+}
+
+static BOOL hit_percent(double fraction, float percent)
+{
+    if (percent <= 0.0f) return fraction > 0.0;
+    return fraction * 100.0 + 1e-9 >= percent;
+}
+
+/* ---- IInkStrokes ---- */
+
+struct strokes
+{
+    IInkStrokes IInkStrokes_iface;
+    LONG ref;
+    struct ink *ink;       /* strong */
+    struct stroke **items;
+    LONG count, size;
+};
+
+static inline struct strokes *impl_from_IInkStrokes(IInkStrokes *iface)
+{
+    return CONTAINING_RECORD(iface, struct strokes, IInkStrokes_iface);
+}
+
+static struct strokes *strokes_from_iface(IInkStrokes *iface)
+{
+    if (!iface || iface->lpVtbl != &strokes_vtbl) return NULL;
+    return impl_from_IInkStrokes(iface);
+}
+
+static HRESULT strokes_create(struct ink *ink, struct strokes **out)
+{
+    struct strokes *s;
+
+    if (!(s = calloc(1, sizeof(*s)))) return E_OUTOFMEMORY;
+    s->IInkStrokes_iface.lpVtbl = &strokes_vtbl;
+    s->ref = 1;
+    s->ink = ink;
+    if (ink) IInkDisp_AddRef(&ink->IInkDisp_iface);
+    *out = s;
+    return S_OK;
+}
+
+static HRESULT strokes_append(struct strokes *s, struct stroke *stroke)
+{
+    LONG i;
+
+    for (i = 0; i < s->count; i++)
+        if (s->items[i] == stroke) return S_OK;
+    if (s->count == s->size)
+    {
+        LONG ns = s->size ? s->size * 2 : 8;
+        struct stroke **ni = realloc(s->items, ns * sizeof(*ni));
+        if (!ni) return E_OUTOFMEMORY;
+        s->items = ni;
+        s->size = ns;
+    }
+    IInkStrokeDisp_AddRef(&stroke->IInkStrokeDisp_iface);
+    s->items[s->count++] = stroke;
+    return S_OK;
+}
+
+static BOOL strokes_remove(struct strokes *s, struct stroke *stroke)
+{
+    LONG i;
+
+    for (i = 0; i < s->count; i++)
+    {
+        if (s->items[i] != stroke) continue;
+        IInkStrokeDisp_Release(&stroke->IInkStrokeDisp_iface);
+        memmove(&s->items[i], &s->items[i + 1], (s->count - i - 1) * sizeof(*s->items));
+        s->count--;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static HRESULT WINAPI strokes_QueryInterface(IInkStrokes *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p\n", iface, debugstr_guid(riid), out);
+    DISP_QI(IInkStrokes, IID_IInkStrokes)
+}
+
+static ULONG WINAPI strokes_AddRef(IInkStrokes *iface)
+{
+    return InterlockedIncrement(&impl_from_IInkStrokes(iface)->ref);
+}
+
+static ULONG WINAPI strokes_Release(IInkStrokes *iface)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    ULONG ref = InterlockedDecrement(&s->ref);
+    LONG i;
+
+    if (!ref)
+    {
+        for (i = 0; i < s->count; i++) IInkStrokeDisp_Release(&s->items[i]->IInkStrokeDisp_iface);
+        free(s->items);
+        if (s->ink) IInkDisp_Release(&s->ink->IInkDisp_iface);
+        free(s);
+    }
+    return ref;
+}
+
+DISPATCH_IMPL(strokes, IInkStrokes, IID_IInkStrokes)
+
+static HRESULT WINAPI strokes_get_Count(IInkStrokes *iface, LONG *count)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    LONG i, n = 0;
+
+    if (!count) return E_POINTER;
+    for (i = 0; i < s->count; i++) if (!s->items[i]->deleted) n++;
+    *count = n;
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_get__NewEnum(IInkStrokes *iface, IUnknown **out)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    IEnumVARIANT *e;
+    VARIANT *vars;
+    HRESULT hr;
+    LONG i, n = 0;
+
+    if (!out) return E_POINTER;
+    if (!(vars = calloc(max(s->count, 1), sizeof(*vars)))) return E_OUTOFMEMORY;
+    for (i = 0; i < s->count; i++)
+    {
+        if (s->items[i]->deleted) continue;
+        V_VT(&vars[n]) = VT_DISPATCH;
+        V_DISPATCH(&vars[n]) = (IDispatch *)&s->items[i]->IInkStrokeDisp_iface;
+        IDispatch_AddRef(V_DISPATCH(&vars[n]));
+        n++;
+    }
+    hr = create_enumvar(vars, n, 0, &e);
+    for (i = 0; i < n; i++) VariantClear(&vars[i]);
+    free(vars);
+    if (FAILED(hr)) return hr;
+    *out = (IUnknown *)e;
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_get_Ink(IInkStrokes *iface, IInkDisp **ink)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    if (!ink) return E_POINTER;
+    *ink = s->ink ? &s->ink->IInkDisp_iface : NULL;
+    if (*ink) IInkDisp_AddRef(*ink);
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_get_RecognitionResult(IInkStrokes *iface, IInkRecognitionResult **result)
+{
+    TRACE("%p, %p\n", iface, result);
+    if (!result) return E_POINTER;
+    *result = NULL; /* no recognizer has been run on these strokes */
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_ToString(IInkStrokes *iface, BSTR *str)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    WCHAR *buf, *p;
+    LONG i;
+
+    if (!str) return E_POINTER;
+    if (!(buf = malloc((s->count * 12 + 1) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    p = buf;
+    *p = 0;
+    for (i = 0; i < s->count; i++)
+    {
+        if (s->items[i]->deleted) continue;
+        if (p != buf) *p++ = ' ';
+        p += swprintf(p, 12, L"%ld", s->items[i]->id);
+    }
+    *str = SysAllocString(buf);
+    free(buf);
+    return *str ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI strokes_Item(IInkStrokes *iface, LONG index, IInkStrokeDisp **stroke)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    LONG i, n = 0;
+
+    TRACE("%p, %ld, %p\n", iface, index, stroke);
+    if (!stroke) return E_POINTER;
+    *stroke = NULL;
+    if (index < 0) return E_INVALIDARG;
+    for (i = 0; i < s->count; i++)
+    {
+        if (s->items[i]->deleted) continue;
+        if (n++ != index) continue;
+        *stroke = &s->items[i]->IInkStrokeDisp_iface;
+        IInkStrokeDisp_AddRef(*stroke);
+        return S_OK;
+    }
+    return E_INVALIDARG;
+}
+
+static HRESULT WINAPI strokes_Add(IInkStrokes *iface, IInkStrokeDisp *stroke)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    struct stroke *st = stroke_from_iface(stroke);
+
+    TRACE("%p, %p\n", iface, stroke);
+    if (!st) return E_INVALIDARG;
+    if (st->deleted || st->ink != s->ink) return E_INVALIDARG;
+    return strokes_append(s, st);
+}
+
+static HRESULT WINAPI strokes_AddStrokes(IInkStrokes *iface, IInkStrokes *other)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface), *o = strokes_from_iface(other);
+    LONG i;
+    HRESULT hr;
+
+    if (!o) return E_INVALIDARG;
+    if (o->ink != s->ink) return E_INVALIDARG;
+    for (i = 0; i < o->count; i++)
+        if (!o->items[i]->deleted && FAILED(hr = strokes_append(s, o->items[i]))) return hr;
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_Remove(IInkStrokes *iface, IInkStrokeDisp *stroke)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    struct stroke *st = stroke_from_iface(stroke);
+
+    if (!st) return E_INVALIDARG;
+    return strokes_remove(s, st) ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI strokes_RemoveStrokes(IInkStrokes *iface, IInkStrokes *other)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface), *o = strokes_from_iface(other);
+    LONG i;
+
+    if (!o) return E_INVALIDARG;
+    for (i = 0; i < o->count; i++) strokes_remove(s, o->items[i]);
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_ModifyDrawingAttributes(IInkStrokes *iface, IInkDrawingAttributes *attrs)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    LONG i;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", iface, attrs);
+    if (!attrs) return E_INVALIDARG;
+    for (i = 0; i < s->count; i++)
+    {
+        if (s->items[i]->deleted) continue;
+        if (FAILED(hr = attrs_assign(s->items[i]->attrs, attrs))) return hr;
+        if (s->ink) s->ink->dirty = VARIANT_TRUE;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_GetBoundingBox(IInkStrokes *iface, InkBoundingBoxMode mode, IInkRectangle **out)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    RECT r = {0};
+    BOOL any = FALSE;
+    LONG i;
+
+    TRACE("%p, %d, %p\n", iface, mode, out);
+    if (!out) return E_POINTER;
+    if (mode < IBBM_Default || mode > IBBM_Union) return E_INVALIDARG;
+    for (i = 0; i < s->count; i++)
+        if (!s->items[i]->deleted) stroke_bbox(s->items[i], mode, &any, &r);
+    return create_rect(&r, out);
+}
+
+static void stroke_matrix_for(struct stroke *s, const double m[6], BOOL pen)
+{
+    stroke_apply_matrix(s, m);
+    if (pen)
+    {
+        double sx = hypot(m[0], m[1]), sy = hypot(m[2], m[3]);
+        s->attrs->width = (float)(s->attrs->width * sx);
+        s->attrs->height = (float)(s->attrs->height * sy);
+    }
+}
+
+static void strokes_matrix(struct strokes *s, const double m[6], BOOL pen)
+{
+    LONG i;
+    for (i = 0; i < s->count; i++)
+    {
+        if (s->items[i]->deleted) continue;
+        stroke_matrix_for(s->items[i], m, pen);
+    }
+    if (s->ink) s->ink->dirty = VARIANT_TRUE;
+}
+
+static HRESULT get_transform_matrix(IInkTransform *t, double m[6])
+{
+    float a[6];
+    HRESULT hr;
+
+    if (!t) return E_INVALIDARG;
+    if (FAILED(hr = IInkTransform_GetTransform(t, &a[0], &a[1], &a[2], &a[3], &a[4], &a[5]))) return hr;
+    m[0] = a[0]; m[1] = a[1]; m[2] = a[2]; m[3] = a[3]; m[4] = a[4]; m[5] = a[5];
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_Transform(IInkStrokes *iface, IInkTransform *t, VARIANT_BOOL pen)
+{
+    double m[6];
+    HRESULT hr;
+
+    if (FAILED(hr = get_transform_matrix(t, m))) return hr;
+    strokes_matrix(impl_from_IInkStrokes(iface), m, pen != 0);
+    return S_OK;
+}
+
+static void rotate_matrix(double deg, double cx, double cy, double m[6])
+{
+    double r = deg * M_PI / 180.0, c = cos(r), s = sin(r);
+
+    m[0] = c; m[1] = s; m[2] = -s; m[3] = c;
+    m[4] = cx - c * cx + s * cy;
+    m[5] = cy - s * cx - c * cy;
+}
+
+static BOOL strokes_bounds(struct strokes *s, RECT *r)
+{
+    BOOL any = FALSE;
+    LONG i;
+    for (i = 0; i < s->count; i++)
+        if (!s->items[i]->deleted) stroke_bbox(s->items[i], IBBM_PointsOnly, &any, r);
+    return any;
+}
+
+static BOOL scale_to_rect_matrix(const RECT *from, const RECT *to, double m[6])
+{
+    double fw = from->right - from->left, fh = from->bottom - from->top;
+    double sx = fw ? (double)(to->right - to->left) / fw : 1.0;
+    double sy = fh ? (double)(to->bottom - to->top) / fh : 1.0;
+
+    m[0] = sx; m[1] = 0; m[2] = 0; m[3] = sy;
+    m[4] = to->left - from->left * sx;
+    m[5] = to->top - from->top * sy;
+    return TRUE;
+}
+
+static HRESULT WINAPI strokes_ScaleToRectangle(IInkStrokes *iface, IInkRectangle *rect)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    RECT from, to;
+    double m[6];
+    HRESULT hr;
+
+    if (FAILED(hr = get_rect(rect, &to))) return hr;
+    normalize_rect(&to);
+    if (!strokes_bounds(s, &from)) return S_OK;
+    scale_to_rect_matrix(&from, &to, m);
+    strokes_matrix(s, m, FALSE);
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_Move(IInkStrokes *iface, float dx, float dy)
+{
+    double m[6] = { 1, 0, 0, 1, dx, dy };
+    strokes_matrix(impl_from_IInkStrokes(iface), m, FALSE);
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_Rotate(IInkStrokes *iface, float deg, float x, float y)
+{
+    double m[6];
+    rotate_matrix(deg, x, y, m);
+    strokes_matrix(impl_from_IInkStrokes(iface), m, FALSE);
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_Shear(IInkStrokes *iface, float h, float v)
+{
+    double m[6] = { 1, v, h, 1, 0, 0 };
+    strokes_matrix(impl_from_IInkStrokes(iface), m, FALSE);
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_ScaleTransform(IInkStrokes *iface, float h, float v)
+{
+    double m[6] = { h, 0, 0, v, 0, 0 };
+    strokes_matrix(impl_from_IInkStrokes(iface), m, FALSE);
+    return S_OK;
+}
+
+static HRESULT ink_clip_stroke(struct ink *ink, struct stroke *s, const RECT *r);
+
+static HRESULT WINAPI strokes_Clip(IInkStrokes *iface, IInkRectangle *rect)
+{
+    struct strokes *s = impl_from_IInkStrokes(iface);
+    RECT r;
+    LONG i;
+    HRESULT hr;
+
+    if (FAILED(hr = get_rect(rect, &r))) return hr;
+    normalize_rect(&r);
+    for (i = s->count - 1; i >= 0; i--)
+    {
+        struct stroke *st = s->items[i];
+        if (st->deleted || !st->ink) continue;
+        IInkStrokeDisp_AddRef(&st->IInkStrokeDisp_iface);
+        if (FAILED(hr = ink_clip_stroke(st->ink, st, &r))) { IInkStrokeDisp_Release(&st->IInkStrokeDisp_iface); return hr; }
+        if (st->deleted) strokes_remove(s, st);
+        IInkStrokeDisp_Release(&st->IInkStrokeDisp_iface);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_RemoveRecognitionResult(IInkStrokes *iface)
+{
+    TRACE("%p\n", iface);
+    return S_OK;
+}
