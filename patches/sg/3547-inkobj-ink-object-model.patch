+static HRESULT WINAPI stroke_GetPacketValuesByProperty(IInkStrokeDisp *iface, BSTR name, LONG index, LONG count,
+        VARIANT *values)
+{
+    struct stroke *s = impl_from_IInkStrokeDisp(iface);
+    LONG c, i, *buf;
+    HRESULT hr;
+
+    if (!values) return E_POINTER;
+    LIVE(s);
+    if ((c = find_property(s, name)) < 0) return E_INVALIDARG;
+    if (FAILED(hr = check_range(s, index, &count))) return hr;
+    if (!(buf = malloc(count * sizeof(LONG)))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++) buf[i] = s->data[(index + i) * s->psize + c];
+    hr = make_long_array(buf, count, values);
+    free(buf);
+    return hr;
+}
+
+static HRESULT WINAPI stroke_SetPacketValuesByProperty(IInkStrokeDisp *iface, BSTR name, VARIANT values,
+        LONG index, LONG count, LONG *set)
+{
+    struct stroke *s = impl_from_IInkStrokeDisp(iface);
+    LONG c, i, n, *vals;
+    HRESULT hr;
+
+    if (!set) return E_POINTER;
+    *set = 0;
+    LIVE(s);
+    if ((c = find_property(s, name)) < 0) return E_INVALIDARG;
+    if (FAILED(hr = variant_to_longs(&values, &vals, &n)) || hr == S_FALSE) return hr == S_FALSE ? E_INVALIDARG : hr;
+    if (count == -1) count = min(n, s->npackets - index);
+    if (FAILED(hr = check_range(s, index, &count))) { free(vals); return hr; }
+    if (n < count) { free(vals); return E_INVALIDARG; }
+    for (i = 0; i < count; i++) s->data[(index + i) * s->psize + c] = vals[i];
+    free(vals);
+    stroke_touch(s);
+    *set = count;
+    return S_OK;
+}
+
+static HRESULT WINAPI stroke_GetFlattenedBezierPoints(IInkStrokeDisp *iface, LONG error, VARIANT *points)
+{
+    /* the fitted curve is a Catmull-Rom spline through the polyline points, which the
+       polyline itself already approximates */
+    return stroke_GetPoints(iface, 0, -1, points);
+}
