+static void normalize_rect(RECT *r)
+{
+    LONG t;
+    if (r->left > r->right) { t = r->left; r->left = r->right; r->right = t; }
+    if (r->top > r->bottom) { t = r->top; r->top = r->bottom; r->bottom = t; }
+}
+
+/* distance from (px,py) to the segment, with the position along it in [0,1] */
+static double point_seg_dist(double px, double py, double x1, double y1, double x2, double y2, double *pos)
+{
+    double dx = x2 - x1, dy = y2 - y1, len2 = dx * dx + dy * dy, t = 0.0, cx, cy;
+
+    if (len2 > 0.0)
+    {
+        t = ((px - x1) * dx + (py - y1) * dy) / len2;
+        if (t < 0.0) t = 0.0;
+        if (t > 1.0) t = 1.0;
+    }
+    cx = x1 + t * dx;
+    cy = y1 + t * dy;
+    if (pos) *pos = t;
+    return sqrt((px - cx) * (px - cx) + (py - cy) * (py - cy));
+}
+
+/* intersection of two segments: parameters on each, FALSE if parallel / disjoint */
+static BOOL seg_intersect(double ax, double ay, double bx, double by, double cx, double cy, double dx, double dy,
+        double *ta, double *tb)
+{
+    double r_x = bx - ax, r_y = by - ay, s_x = dx - cx, s_y = dy - cy;
+    double den = r_x * s_y - r_y * s_x, t, u;
+
+    if (fabs(den) < 1e-12) return FALSE;
+    t = ((cx - ax) * s_y - (cy - ay) * s_x) / den;
+    u = ((cx - ax) * r_y - (cy - ay) * r_x) / den;
+    if (t < 0.0 || t > 1.0 || u < 0.0 || u > 1.0) return FALSE;
+    *ta = t;
+    *tb = u;
+    return TRUE;
+}
+
+/* Liang-Barsky: the part [t0,t1] of the segment inside the rectangle */
+static BOOL clip_segment(double x1, double y1, double x2, double y2, const RECT *r, double *t0, double *t1)
+{
+    double p[4] = { x1 - x2, x2 - x1, y1 - y2, y2 - y1 };
+    double q[4] = { x1 - r->left, r->right - x1, y1 - r->top, r->bottom - y1 };
+    double a = 0.0, b = 1.0, t;
+    int i;
+
+    for (i = 0; i < 4; i++)
+    {
+        if (p[i] == 0.0)
+        {
+            if (q[i] < 0.0) return FALSE;
+            continue;
+        }
+        t = q[i] / p[i];
+        if (p[i] < 0.0) { if (t > b) return FALSE; if (t > a) a = t; }
+        else            { if (t < a) return FALSE; if (t < b) b = t; }
+    }
+    *t0 = a;
+    *t1 = b;
+    return TRUE;
+}
+
+static BOOL point_in_polygon(double x, double y, const LONG *pts, LONG n)
+{
+    BOOL in = FALSE;
+    LONG i, j;
+
+    for (i = 0, j = n - 1; i < n; j = i++)
+    {
+        double xi = pts[2 * i], yi = pts[2 * i + 1], xj = pts[2 * j], yj = pts[2 * j + 1];
+        if (((yi > y) != (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi)) in = !in;
+    }
+    return in;
+}
