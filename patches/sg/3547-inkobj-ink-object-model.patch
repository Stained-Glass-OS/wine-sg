+static HRESULT WINAPI stroke_get_PolylineCusps(IInkStrokeDisp *iface, VARIANT *cusps)
+{
+    struct stroke *s = impl_from_IInkStrokeDisp(iface);
+    LONG *idx, n = 0, i;
+    HRESULT hr;
+
+    if (!cusps) return E_POINTER;
+    LIVE(s);
+    if (!(idx = malloc((s->npackets + 1) * sizeof(LONG)))) return E_OUTOFMEMORY;
+    idx[n++] = 0;
+    for (i = 1; i + 1 < s->npackets; i++)
+    {
+        double ax = s->data[i * s->psize] - s->data[(i - 1) * s->psize];
+        double ay = s->data[i * s->psize + 1] - s->data[(i - 1) * s->psize + 1];
+        double bx = s->data[(i + 1) * s->psize] - s->data[i * s->psize];
+        double by = s->data[(i + 1) * s->psize + 1] - s->data[i * s->psize + 1];
+        double la = hypot(ax, ay), lb = hypot(bx, by);
+        /* a turn of more than 90 degrees makes a cusp */
+        if (la > 0 && lb > 0 && (ax * bx + ay * by) / (la * lb) < 0.0) idx[n++] = i;
+    }
+    if (s->npackets > 1) idx[n++] = s->npackets - 1;
+    hr = make_long_array(idx, n, cusps);
+    free(idx);
+    return hr;
+}
+
+static HRESULT WINAPI stroke_get_BezierCusps(IInkStrokeDisp *iface, VARIANT *cusps)
+{
+    VARIANT poly;
+    LONG *idx, n, i;
+    HRESULT hr;
+
+    if (!cusps) return E_POINTER;
+    VariantInit(&poly);
+    if (FAILED(hr = stroke_get_PolylineCusps(iface, &poly))) return hr;
+    if (FAILED(hr = variant_to_longs(&poly, &idx, &n))) { VariantClear(&poly); return hr; }
+    VariantClear(&poly);
+    for (i = 0; i < n; i++) idx[i] *= 3;
+    hr = make_long_array(idx, n, cusps);
+    free(idx);
+    return hr;
+}
+
+static HRESULT WINAPI stroke_get_SelfIntersections(IInkStrokeDisp *iface, VARIANT *res)
+{
+    struct stroke *s = impl_from_IInkStrokeDisp(iface);
+    float *vals = NULL;
+    LONG n = 0, cap = 0, i, j;
+    HRESULT hr;
+
+    if (!res) return E_POINTER;
+    LIVE(s);
+    for (i = 0; i + 1 < s->npackets; i++)
+    {
+        for (j = i + 2; j + 1 < s->npackets; j++)
+        {
+            double ta, tb;
+            if (!seg_intersect(s->data[i * s->psize], s->data[i * s->psize + 1],
+                    s->data[(i + 1) * s->psize], s->data[(i + 1) * s->psize + 1],
+                    s->data[j * s->psize], s->data[j * s->psize + 1],
+                    s->data[(j + 1) * s->psize], s->data[(j + 1) * s->psize + 1], &ta, &tb)) continue;
+            if (n + 2 > cap)
+            {
+                float *nv = realloc(vals, (cap = cap ? cap * 2 : 16) * sizeof(float));
+                if (!nv) { free(vals); return E_OUTOFMEMORY; }
+                vals = nv;
+            }
+            vals[n++] = (float)(i + ta);
+            vals[n++] = (float)(j + tb);
+        }
+    }
+    hr = make_float_array(vals, n, res);
+    free(vals);
+    return hr;
+}
