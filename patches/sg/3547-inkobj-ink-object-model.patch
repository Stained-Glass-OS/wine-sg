+/* ---- ink: stroke management ---- */
+
+static HRESULT ink_add_stroke(struct ink *ink, struct stroke *s)
+{
+    if (ink->count == ink->size)
+    {
+        LONG ns = ink->size ? ink->size * 2 : 16;
+        struct stroke **ni = realloc(ink->items, ns * sizeof(*ni));
+        if (!ni) return E_OUTOFMEMORY;
+        ink->items = ni;
+        ink->size = ns;
+    }
+    IInkStrokeDisp_AddRef(&s->IInkStrokeDisp_iface);
+    ink->items[ink->count++] = s;
+    s->ink = ink;
+    if (s->id >= ink->next_id) ink->next_id = s->id + 1;
+    return S_OK;
+}
+
+static void ink_delete_stroke(struct ink *ink, struct stroke *s)
+{
+    LONG i;
+
+    for (i = 0; i < ink->count; i++)
+    {
+        if (ink->items[i] != s) continue;
+        memmove(&ink->items[i], &ink->items[i + 1], (ink->count - i - 1) * sizeof(*ink->items));
+        ink->count--;
+        s->deleted = TRUE;
+        s->ink = NULL;
+        ink->dirty = VARIANT_TRUE;
+        IInkStrokeDisp_Release(&s->IInkStrokeDisp_iface);
+        return;
+    }
+}
+
+static BOOL ink_has_stroke(struct ink *ink, struct stroke *s)
+{
+    LONG i;
+    for (i = 0; i < ink->count; i++) if (ink->items[i] == s) return TRUE;
+    return FALSE;
+}
+
+/* new stroke in 'dst' with the data, drawing attributes and properties of 'src' */
+static HRESULT ink_copy_stroke(struct ink *dst, struct stroke *src, struct stroke **out)
+{
+    struct stroke *n;
+    HRESULT hr;
+
+    if (FAILED(hr = stroke_create(dst, dst->next_id, src->npackets, src->psize, src->data, src->desc, &n))) return hr;
+    attrs_assign(n->attrs, &src->attrs->IInkDrawingAttributes_iface);
+    props_copy(n->props, src->props);
+    if (FAILED(hr = ink_add_stroke(dst, n))) { stroke_free(n); return hr; }
+    if (out) { *out = n; IInkStrokeDisp_AddRef(&n->IInkStrokeDisp_iface); }
+    IInkStrokeDisp_Release(&n->IInkStrokeDisp_iface);
+    return S_OK;
+}
+
+struct run { LONG *data; LONG n, cap; };
+
+static HRESULT run_append(struct run *run, int ps, const LONG *a, const LONG *b, double t)
+{
+    int c;
+
+    if (run->n == run->cap)
+    {
+        LONG nc = run->cap ? run->cap * 2 : 16;
+        LONG *nd = realloc(run->data, nc * ps * sizeof(LONG));
+        if (!nd) return E_OUTOFMEMORY;
+        run->data = nd;
+        run->cap = nc;
+    }
+    for (c = 0; c < ps; c++)
+        run->data[run->n * ps + c] = b ? round_long(a[c] + t * (b[c] - a[c])) : a[c];
+    run->n++;
+    return S_OK;
+}
+
+static void free_runs(struct run *runs, LONG n)
+{
+    LONG i;
+    for (i = 0; i < n; i++) free(runs[i].data);
+    free(runs);
+}
+
+/* parts of the stroke inside (or outside) the rectangle, as separate polylines */
+static HRESULT split_runs(struct stroke *s, const RECT *r, BOOL inside, struct run **out_runs, LONG *out_n)
+{
+    struct run *runs = NULL;
+    LONG n = 0, i;
+    BOOL open = FALSE;
+    int ps = s->psize;
+    HRESULT hr = S_OK;
+
+#define NEW_RUN() do { struct run *nr = realloc(runs, (n + 1) * sizeof(*runs)); \
+        if (!nr) { hr = E_OUTOFMEMORY; goto done; } runs = nr; memset(&runs[n], 0, sizeof(*runs)); n++; open = TRUE; } while (0)
+
+    *out_runs = NULL;
+    *out_n = 0;
+    if (s->npackets == 1)
+    {
+        BOOL in = s->data[0] >= r->left && s->data[0] <= r->right && s->data[1] >= r->top && s->data[1] <= r->bottom;
+        if (in == inside)
+        {
+            NEW_RUN();
+            if (FAILED(hr = run_append(&runs[0], ps, s->data, NULL, 0))) goto done;
+        }
+        goto done;
+    }
+    for (i = 0; i + 1 < s->npackets; i++)
+    {
+        const LONG *p1 = s->data + i * ps, *p2 = p1 + ps;
+        double t0, t1, iv[2][2];
+        int niv = 0, k;
+
+        if (clip_segment(p1[0], p1[1], p2[0], p2[1], r, &t0, &t1))
+        {
+            if (inside) { iv[0][0] = t0; iv[0][1] = t1; niv = 1; }
+            else
+            {
+                if (t0 > 0.0) { iv[niv][0] = 0.0; iv[niv][1] = t0; niv++; }
+                if (t1 < 1.0) { iv[niv][0] = t1; iv[niv][1] = 1.0; niv++; }
+            }
+        }
+        else if (!inside) { iv[0][0] = 0.0; iv[0][1] = 1.0; niv = 1; }
+        if (!niv) { open = FALSE; continue; }
+        for (k = 0; k < niv; k++)
+        {
+            if (!(open && iv[k][0] == 0.0))
+            {
+                NEW_RUN();
+                if (FAILED(hr = run_append(&runs[n - 1], ps, p1, p2, iv[k][0]))) goto done;
+            }
+            if (FAILED(hr = run_append(&runs[n - 1], ps, p1, p2, iv[k][1]))) goto done;
+            if (iv[k][1] < 1.0) open = FALSE;
+        }
+    }
+done:
+    if (FAILED(hr)) { free_runs(runs, n); return hr; }
+    *out_runs = runs;
+    *out_n = n;
+    return S_OK;
+#undef NEW_RUN
+}
+
+static HRESULT stroke_replace_data(struct stroke *s, LONG *data, LONG n)
+{
+    free(s->data);
+    s->data = data;
+    s->npackets = n;
+    return S_OK;
+}
+
+/* ---- persistence ---- */
+
+struct wbuf { BYTE *p; size_t len, cap; BOOL fail; };
+
+static void wb_put(struct wbuf *b, const void *data, size_t len)
+{
+    if (b->fail) return;
+    if (b->len + len > b->cap)
+    {
+        size_t nc = max(b->cap * 2, b->len + len + 256);
+        BYTE *np = realloc(b->p, nc);
+        if (!np) { b->fail = TRUE; return; }
+        b->p = np;
+        b->cap = nc;
+    }
+    memcpy(b->p + b->len, data, len);
+    b->len += len;
+}
+
+static void wb_u32(struct wbuf *b, LONG v) { wb_put(b, &v, 4); }
+static void wb_float(struct wbuf *b, float v) { wb_put(b, &v, 4); }
+
+static void serialize_stroke(struct wbuf *b, struct stroke *s)
+{
+    LONG i;
+
+    wb_u32(b, s->id);
+    wb_u32(b, s->psize);
+    wb_u32(b, s->npackets);
+    for (i = 0; i < s->psize; i++)
+    {
+        UINT len = SysStringLen(s->desc[i]);
+        wb_u32(b, len);
+        wb_put(b, s->desc[i], len * sizeof(WCHAR));
+    }
+    wb_put(b, s->data, s->npackets * s->psize * sizeof(LONG));
+    wb_u32(b, s->attrs->color);
+    wb_float(b, s->attrs->width);
+    wb_float(b, s->attrs->height);
+    wb_u32(b, (s->attrs->fit_to_curve ? 1 : 0) | (s->attrs->ignore_pressure ? 2 : 0) | (s->attrs->antialiased ? 4 : 0));
+    wb_u32(b, s->attrs->transparency);
+    wb_u32(b, s->attrs->rop);
+    wb_u32(b, s->attrs->pen_tip);
+}
+
+static HRESULT serialize_strokes(struct stroke **items, LONG count, struct wbuf *b)
+{
+    LONG i, n = 0;
+
+    for (i = 0; i < count; i++) if (!items[i]->deleted) n++;
+    wb_u32(b, SGINK_MAGIC);
+    wb_u32(b, 1);
+    wb_u32(b, n);
+    for (i = 0; i < count; i++) if (!items[i]->deleted) serialize_stroke(b, items[i]);
+    return b->fail ? E_OUTOFMEMORY : S_OK;
+}
+
+struct rbuf { const BYTE *p; size_t len, pos; BOOL fail; };
+
+static BOOL rb_get(struct rbuf *b, void *out, size_t len)
+{
+    if (b->fail || len > b->len - b->pos) { b->fail = TRUE; return FALSE; }
+    memcpy(out, b->p + b->pos, len);
+    b->pos += len;
+    return TRUE;
+}
+
+static LONG rb_u32(struct rbuf *b)
+{
+    LONG v = 0;
+    rb_get(b, &v, 4);
+    return v;
+}
+
+/* appends the strokes of a serialized buffer to the ink; the new strokes are listed in 'added' when given */
+static HRESULT deserialize_strokes(struct ink *ink, const BYTE *data, size_t size, LONG dx, LONG dy,
+        struct strokes *added)
+{
+    struct rbuf b = { data, size, 0, FALSE };
+    LONG n, i, j;
+    HRESULT hr;
+
+    if (rb_u32(&b) != SGINK_MAGIC || rb_u32(&b) != 1) return E_INVALIDARG;
+    n = rb_u32(&b);
+    if (b.fail || n < 0) return E_INVALIDARG;
+    for (i = 0; i < n; i++)
+    {
+        LONG id = rb_u32(&b), ps = rb_u32(&b), np = rb_u32(&b), color, tr, rop, tip, flags;
+        float w, h;
+        BSTR *desc;
+        LONG *pk;
+        struct stroke *s;
+
+        if (b.fail || ps < 2 || ps > 64 || np < 1 || (size_t)np * ps * 4 > b.len - b.pos) return E_INVALIDARG;
+        if (!(desc = calloc(ps, sizeof(BSTR)))) return E_OUTOFMEMORY;
+        for (j = 0; j < ps && !b.fail; j++)
+        {
+            LONG len = rb_u32(&b);
+            if (len < 0 || (size_t)len * sizeof(WCHAR) > b.len - b.pos) { b.fail = TRUE; break; }
+            desc[j] = SysAllocStringLen((const WCHAR *)(b.p + b.pos), len);
+            b.pos += len * sizeof(WCHAR);
+        }
+        if (b.fail || !(pk = malloc((size_t)np * ps * sizeof(LONG))))
+        {
+            for (j = 0; j < ps; j++) SysFreeString(desc[j]);
+            free(desc);
+            return E_INVALIDARG;
+        }
+        rb_get(&b, pk, (size_t)np * ps * sizeof(LONG));
+        color = rb_u32(&b);
+        rb_get(&b, &w, 4);
+        rb_get(&b, &h, 4);
+        flags = rb_u32(&b);
+        tr = rb_u32(&b);
+        rop = rb_u32(&b);
+        tip = rb_u32(&b);
+        if (b.fail) hr = E_INVALIDARG;
+        else
+        {
+            for (j = 0; j < np; j++) { pk[j * ps] += dx; pk[j * ps + 1] += dy; }
+            hr = stroke_create(ink, ink->next_id, np, ps, pk, desc, &s);
+        }
+        for (j = 0; j < ps; j++) SysFreeString(desc[j]);
+        free(desc);
+        free(pk);
+        if (FAILED(hr)) return hr;
+        (void)id;
+        s->attrs->color = color;
+        s->attrs->width = w;
+        s->attrs->height = h;
+        s->attrs->fit_to_curve = (flags & 1) ? VARIANT_TRUE : VARIANT_FALSE;
+        s->attrs->ignore_pressure = (flags & 2) ? VARIANT_TRUE : VARIANT_FALSE;
+        s->attrs->antialiased = (flags & 4) ? VARIANT_TRUE : VARIANT_FALSE;
+        s->attrs->transparency = tr;
+        s->attrs->rop = rop;
+        s->attrs->pen_tip = tip;
+        if (FAILED(hr = ink_add_stroke(ink, s))) { stroke_free(s); return hr; }
+        if (added) strokes_append(added, s);
+        IInkStrokeDisp_Release(&s->IInkStrokeDisp_iface);
+    }
+    return S_OK;
+}
+
+static const char b64chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static char *base64_encode(const BYTE *in, size_t len, size_t *outlen)
+{
+    char *out = malloc((len + 2) / 3 * 4 + 1), *p = out;
+    size_t i;
+
+    if (!out) return NULL;
+    for (i = 0; i < len; i += 3)
+    {
+        ULONG v = in[i] << 16 | (i + 1 < len ? in[i + 1] << 8 : 0) | (i + 2 < len ? in[i + 2] : 0);
+        *p++ = b64chars[v >> 18 & 63];
+        *p++ = b64chars[v >> 12 & 63];
+        *p++ = i + 1 < len ? b64chars[v >> 6 & 63] : '=';
+        *p++ = i + 2 < len ? b64chars[v & 63] : '=';
+    }
+    *p = 0;
+    *outlen = p - out;
+    return out;
+}
+
+static BYTE *base64_decode(const char *in, size_t len, size_t *outlen)
+{
+    BYTE *out = malloc(len / 4 * 3 + 3), *p = out;
+    ULONG acc = 0;
+    int bits = 0;
+    size_t i;
+
+    if (!out) return NULL;
+    for (i = 0; i < len; i++)
+    {
+        const char *c;
+        if (in[i] == '=' || in[i] == '\r' || in[i] == '\n' || in[i] == ' ') continue;
+        if (!(c = memchr(b64chars, in[i], 64)) || !in[i]) { free(out); return NULL; }
+        acc = acc << 6 | (c - b64chars);
+        bits += 6;
+        if (bits >= 8) { bits -= 8; *p++ = (acc >> bits) & 0xff; }
+    }
+    *outlen = p - out;
+    return out;
+}
