+static void wined3d_sampler_gl_cs_init(void *object)
+{
+    struct wined3d_sampler_gl *sampler_gl = object;
+    const struct wined3d_sampler_desc *desc;
+    const struct wined3d_gl_info *gl_info;
+    struct wined3d_context *context;
+    GLuint name;
+
+    TRACE("sampler_gl %p.\n", sampler_gl);
+
+    context = context_acquire(sampler_gl->s.device, NULL, 0);
+    gl_info = wined3d_context_gl(context)->gl_info;
+
+    desc = &sampler_gl->s.desc;
+    GL_EXTCALL(glGenSamplers(1, &name));
+    wined3d_sampler_gl_set_params(name, desc, desc->min_lod, context, gl_info);
     checkGLcall("sampler creation");
 
     TRACE("Created sampler %u.\n", name);
@@ -317,6 +323,42 @@
 }
 
 /* This function relies on the correct texture being bound and loaded. */
+/* (wine-sg 8254) bind the sampler with its minimum LOD raised to min_lod (a texture's SetResourceMinLOD,
+ * relative to the view's most detailed level): a second GL sampler object, the same but for that */
+void wined3d_sampler_gl_bind_min_lod(struct wined3d_sampler_gl *sampler_gl, unsigned int unit,
+        struct wined3d_texture_gl *texture_gl, float min_lod, const struct wined3d_context_gl *context_gl)
+{
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+
+    if (gl_info->supported[ARB_SAMPLER_OBJECTS])
+    {
+        if (!sampler_gl->clamp_name)
+        {
+            GL_EXTCALL(glGenSamplers(1, &sampler_gl->clamp_name));
+            wined3d_sampler_gl_set_params(sampler_gl->clamp_name, &sampler_gl->s.desc, min_lod,
+                    &context_gl->c, gl_info);
+            sampler_gl->clamp_min_lod = min_lod;
+        }
+        else if (sampler_gl->clamp_min_lod != min_lod)
+        {
+            GL_EXTCALL(glSamplerParameterf(sampler_gl->clamp_name, GL_TEXTURE_MIN_LOD, min_lod));
+            sampler_gl->clamp_min_lod = min_lod;
+        }
+        GL_EXTCALL(glBindSampler(unit, sampler_gl->clamp_name));
+        checkGLcall("bind clamped sampler");
+    }
+    else if (texture_gl)
+    {
+        struct wined3d_sampler_desc desc = sampler_gl->s.desc;
+
+        desc.min_lod = min_lod;
+        wined3d_texture_gl_apply_sampler_desc(texture_gl, &desc, context_gl);
+    }
+
+    if (texture_gl)
+        texture_gl_apply_base_level(texture_gl, &sampler_gl->s.desc, gl_info);
+}
+
 void wined3d_sampler_gl_bind(struct wined3d_sampler_gl *sampler_gl, unsigned int unit,
         struct wined3d_texture_gl *texture_gl, const struct wined3d_context_gl *context_gl)
 {
--- a/dlls/wined3d/view.c
+++ b/dlls/wined3d/view.c
@@ -1276,13 +1276,28 @@
 {
     const struct wined3d_gl_info *gl_info = context_gl->gl_info;
     struct wined3d_texture_gl *texture_gl;
+    float min_lod = -1000.0f;
 
     wined3d_context_gl_active_texture(context_gl, gl_info, unit);
 
+#ifndef SG_MUTANT_NO_MINLOD_CLAMP
+    /* (wine-sg 8254) the texture's minimum LOD, in the view's levels, when it is above the sampler's */
+    if (view_gl->v.resource->type != WINED3D_RTYPE_BUFFER)
+    {
+        struct wined3d_texture *texture = wined3d_texture_from_resource(view_gl->v.resource);
+
+        if (texture->min_lod > 0.0f)
+            min_lod = texture->min_lod - (float)view_gl->v.desc.u.texture.level_idx;
+    }
+#endif
+
     if (view_gl->gl_view.name)
     {
         wined3d_context_gl_bind_texture(context_gl, view_gl->gl_view.target, view_gl->gl_view.name);
-        wined3d_sampler_gl_bind(sampler_gl, unit, NULL, context_gl);
+        if (min_lod > sampler_gl->s.desc.min_lod)
+            wined3d_sampler_gl_bind_min_lod(sampler_gl, unit, NULL, min_lod, context_gl);
+        else
+            wined3d_sampler_gl_bind(sampler_gl, unit, NULL, context_gl);
         return;
     }
 
@@ -1294,7 +1309,10 @@
 
     texture_gl = wined3d_texture_gl(wined3d_texture_from_resource(view_gl->v.resource));
     wined3d_texture_gl_bind(texture_gl, context_gl, sampler_gl->s.desc.srgb_decode);
-    wined3d_sampler_gl_bind(sampler_gl, unit, texture_gl, context_gl);
+    if (min_lod > sampler_gl->s.desc.min_lod)
+        wined3d_sampler_gl_bind_min_lod(sampler_gl, unit, texture_gl, min_lod, context_gl);
+    else
+        wined3d_sampler_gl_bind(sampler_gl, unit, texture_gl, context_gl);
 }
 
