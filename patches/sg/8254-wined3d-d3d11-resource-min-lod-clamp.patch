From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wined3d, d3d11: sample a texture no finer than its minimum LOD

ID3D11DeviceContext::SetResourceMinLOD now reaches wined3d (a command in the context's order, wined3d_device_context_set_texture_min_lod) and the GL backend samples the texture no finer than that level: when a shader resource view is bound, the texture's minimum LOD, in the view's levels, raises the sampler's minimum LOD through a second GL sampler object (or the texture's sampler state without sampler objects). 8248 only kept the value for GetResourceMinLOD.
---
--- a/dlls/wined3d/cs.c
+++ b/dlls/wined3d/cs.c
@@ -140,6 +140,7 @@
     WINED3D_CS_OP_CLEAR_UNORDERED_ACCESS_VIEW,
     WINED3D_CS_OP_COPY_UAV_COUNTER,
     WINED3D_CS_OP_GENERATE_MIPMAPS,
+    WINED3D_CS_OP_SET_TEXTURE_MIN_LOD,
     WINED3D_CS_OP_EXECUTE_COMMAND_LIST,
     WINED3D_CS_OP_STOP,
 };
@@ -532,6 +533,13 @@
     struct wined3d_shader_resource_view *view;
 };
 
+struct wined3d_cs_set_texture_min_lod
+{
+    enum wined3d_cs_op opcode;
+    struct wined3d_texture *texture;
+    float min_lod;
+};
+
