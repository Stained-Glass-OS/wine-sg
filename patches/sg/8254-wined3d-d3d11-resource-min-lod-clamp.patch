 }
 
+/* (wine-sg 8254) ID3D11DeviceContext::SetResourceMinLOD: a texture is never sampled at a more detailed level
+ * than this (a level number, fractions allowed), in the context's command order */
+void CDECL wined3d_device_context_set_texture_min_lod(struct wined3d_device_context *context,
+        struct wined3d_texture *texture, float min_lod)
+{
+    TRACE("context %p, texture %p, min_lod %.8e.\n", context, texture, min_lod);
+
+    wined3d_device_context_emit_set_texture_min_lod(context, texture, min_lod);
+}
