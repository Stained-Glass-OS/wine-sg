From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a Linux window full screen before it is framed stays so

Extreme Tux Racer (SFML) ran but never showed a window. SFML asks for full
screen as it maps its window; the compositor's window manager sets
_NET_WM_STATE_FULLSCREEN on it, and only then does 0762 take it into a
Wine frame. Attach looked at _NET_WM_STATE for maximized only, and the
window, bigger than the work area, was framed maximized: resized to the
work area. SFML reported the resize, the game made its full-screen window
again at that size -- not a video mode, so SFML picked another -- and so
for ever ("The requested video mode is not available" without end).

A window already full screen when it is framed gets a full-screen frame,
as one asking after (0764): attach sets _SG_EMBED_FULLSCREEN, and the
frame goes popup over its monitor. Until it has, the window keeps its
size: sized to the frame's client area for the moment between (1280x785
on a 1280x800 screen), the game took that too for a new video mode.

Test: test/linuxembed-gate.sh 12 (an xterm the size of the screen with
_NET_WM_STATE_FULLSCREEN set before it is listed: a full-screen frame, and
no other size given to it meanwhile -- netwm-fullscreen preset-fullscreen
and watch); mutants SG_MUTANT_EMBED_PRE_FULLSCREEN_LOST and
SG_MUTANT_EMBED_PRE_FULLSCREEN_RESIZED fail it. VM-checked with an SFML
probe and Extreme Tux Racer (its menus, Esc quits).
---
diff --git a/dlls/winex11.drv/sg_embed.c b/dlls/winex11.drv/sg_embed.c
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -80,6 +80,7 @@
     long     ext[4];      /* its own shadow (_GTK_FRAME_EXTENTS: left, right, top,
                            * bottom), kept outside the frame */
     BOOL     fullscreen;  /* the program asked for the whole screen */
+    BOOL     fs_pending;  /* full screen before it was framed: not sized to the frame until its full screen is made */
     BOOL     maximized;   /* the frame is maximized (as the program knows it) */
     BOOL     minimized;   /* ...minimized (as the program knows it: WM_STATE) */
     BOOL     focused;     /* it has the X focus (_NET_WM_STATE_FOCUSED) */
@@ -514,12 +515,32 @@
  *
  * The program's window into the Wine window's client area.
  */
+/* the window manager left it full screen (_NET_WM_STATE): it asked as it was mapped */
+static BOOL net_state_fullscreen( Display *d, Window w )
+{
+    Atom type, *atoms = NULL, fs = XInternAtom( d, "_NET_WM_STATE_FULLSCREEN", False );
+    int format;
+    unsigned long count = 0, remaining, i;
+    BOOL ret = FALSE;
+
+    X11DRV_expect_error( d, ignore_error, NULL );
+    if (!XGetWindowProperty( d, w, XInternAtom( d, "_NET_WM_STATE", False ), 0, 32, False, XA_ATOM,
+                             &type, &format, &count, &remaining, (unsigned char **)&atoms ) && atoms)
+    {
+        for (i = 0; i < count; i++) if (atoms[i] == fs) ret = TRUE;
+        XFree( atoms );
+    }
+    X11DRV_check_error();
+    return ret;
+}
+
 LRESULT sg_embed_attach( HWND hwnd, Window child )
 {
     struct x11drv_win_data *data;
     XWindowAttributes attr;
     struct sg_embed *e;
     int x, y, w, h;
+    BOOL full = FALSE;
 
     if (!(data = get_win_data( hwnd ))) return 0;
     if (!client_in_frame( data, &x, &y, &w, &h ) || !embeddable( data->display, child, &attr ))
@@ -527,6 +548,9 @@
         release_win_data( data );
         return 0;
     }
+#ifndef SG_MUTANT_EMBED_PRE_FULLSCREEN_LOST
+    full = net_state_fullscreen( data->display, child );
+#endif
     pthread_mutex_lock( &embed_mutex );
     if ((e = find_hwnd( hwnd )) || embed_count == MAX_EMBEDS)
     {
@@ -544,6 +568,7 @@
     x -= e->ext[0]; y -= e->ext[2];
     w += e->ext[0] + e->ext[1]; h += e->ext[2] + e->ext[3];
     e->x = x; e->y = y; e->w = w; e->h = h;
+    e->fs_pending = full;
     e->serial = NextRequest( data->display );
     pthread_mutex_unlock( &embed_mutex );
 
@@ -555,7 +580,13 @@
     XSelectInput( data->display, child, StructureNotifyMask | PropertyChangeMask );
 #endif
     XReparentWindow( data->display, child, data->whole_window, x, y );
+    /* full screen already: kept at its size -- sized to the frame first, an
+     * SFML game took that for a new video mode and began again */
+#ifdef SG_MUTANT_EMBED_PRE_FULLSCREEN_RESIZED
     XResizeWindow( data->display, child, w, h );
+#else
+    if (!full) XResizeWindow( data->display, child, w, h );
+#endif
     XMapRaised( data->display, child );
 #ifndef SG_MUTANT_EMBED_REPARENT_HIDES
     /* What the program's window does from now on is heard (and whether it
@@ -615,7 +646,17 @@
                     atoms[i] == XInternAtom( data->display, "_NET_WM_STATE_MAXIMIZED_HORZ", False )) max++;
             XFree( atoms );
         }
-        if (max == 2)
+        if (full)
+        {
+            /* full screen already -- an SFML game (Extreme Tux Racer) asks
+             * as it maps its window, before it is framed: framed maximized
+             * instead, it was resized to the work area, took that for a new
+             * video mode, made its window again, and so for ever */
+            long on = 1;
+            XChangeProperty( data->display, child, fullscreen_atom( data->display ), XA_CARDINAL, 32,
+                             PropModeReplace, (unsigned char *)&on, 1 );
+        }
+        else if (max == 2)
         {
             long on = 1;
             XChangeProperty( data->display, child, maximized_atom( data->display ), XA_CARDINAL, 32,
@@ -664,6 +705,15 @@
 
     if (!embed_count || !client_in_frame( data, &x, &y, &w, &h )) return;
     pthread_mutex_lock( &embed_mutex );
+#ifndef SG_MUTANT_EMBED_PRE_FULLSCREEN_RESIZED
+    if ((e = find_hwnd( data->hwnd )) && e->fs_pending)
+    {
+        /* full screen before it was framed: left as it is until its frame
+         * is (WM_X11DRV_SG_EMBED_FULLSCREEN) */
+        pthread_mutex_unlock( &embed_mutex );
+        return;
+    }
+#endif
 #ifndef SG_MUTANT_EMBED_MAX_UNTOLD
     /* (minimized, it is neither: what it was is told again when restored) */
     if ((e = find_hwnd( data->hwnd )) && !e->fullscreen && !(style & WS_MINIMIZE) &&
@@ -1077,6 +1127,7 @@
         X11DRV_check_error();
         pthread_mutex_lock( &embed_mutex );
         e = find_hwnd( hwnd );
+        if (e) e->fs_pending = FALSE;
         if (!e || e->fullscreen == on) { pthread_mutex_unlock( &embed_mutex ); return 0; }
         e->fullscreen = on;
         if (on)
