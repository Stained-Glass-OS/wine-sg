     TRACE("(%s, %s, %s, %lu)\n", debugstr_w(ServerName), debugstr_w(BasePath),
         debugstr_w(UserName), Level);
 
     if (!BufPtr || !EntriesRead || !TotalEntries) return ERROR_INVALID_PARAMETER;
     if (Level != 2 && Level != 3) return ERROR_INVALID_LEVEL;
-    if (ServerName && ServerName[0] && !NETAPI_IsLocalComputer( ServerName ))
-    {
-        FIXME("remote computers not supported\n");
-        return ERROR_NOT_SUPPORTED;
-    }
+    if ((status = check_local_admin_call( ServerName ))) return status;
 
     /* no file here is open through a share */
