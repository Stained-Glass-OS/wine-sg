     if (level != 0 && level != 1 && level != 2 && level != 10 && level != 502) return ERROR_INVALID_LEVEL;
+    if ((status = check_local_admin_call( servername ))) return status;
 
     /* nobody is connected to this machine's shares */
     *bufptr = NULL;
@@ -608,16 +613,14 @@
     DWORD Level, LPBYTE* BufPtr, DWORD PrefMaxLen,
     LPDWORD EntriesRead, LPDWORD TotalEntries, PDWORD_PTR ResumeHandle)
 {
+    NET_API_STATUS status;
