 }
 
+/* The calls that read or change what is connected to this machine need an administrator, as they do
+ * on Windows. This machine exports no share, so there is never anything connected to find. */
+static BOOL caller_is_administrator(void)
+{
+    BYTE sid[SECURITY_MAX_SID_SIZE];
+    DWORD size = sizeof(sid);
+    BOOL member;
+
+    if (!CreateWellKnownSid( WinBuiltinAdministratorsSid, NULL, sid, &size )) return FALSE;
+    if (!CheckTokenMembership( NULL, sid, &member )) return FALSE;
+    return member;
+}
+
+/* returns ERROR_SUCCESS when the call may go on */
+static NET_API_STATUS check_local_admin_call( LMSTR server )
+{
+    if (server && server[0] && !NETAPI_IsLocalComputer( server ))
+    {
+        FIXME( "remote computers not supported\n" );
+        return ERROR_NOT_SUPPORTED;
+    }
+    return caller_is_administrator() ? ERROR_SUCCESS : ERROR_ACCESS_DENIED;
+}
+
+NET_API_STATUS WINAPI NetConnectionEnum( LMSTR server, LMSTR qualifier, DWORD level, LPBYTE *bufptr,
+        DWORD prefmaxlen, LPDWORD entriesread, LPDWORD totalentries, LPDWORD resume_handle )
+{
+    NET_API_STATUS status;
+
+    TRACE( "(%s %s %lu %p %lu %p %p %p)\n", debugstr_w(server), debugstr_w(qualifier), level, bufptr, prefmaxlen,
+            entriesread, totalentries, resume_handle );
+
+    if (!qualifier || !qualifier[0] || !bufptr || !entriesread || !totalentries) return ERROR_INVALID_PARAMETER;
+    if (level != 0 && level != 1) return ERROR_INVALID_LEVEL;
+    if ((status = check_local_admin_call( server ))) return status;
+
+    *bufptr = NULL;
+    *entriesread = 0;
+    *totalentries = 0;
+    if (resume_handle) *resume_handle = 0;
+    return NERR_Success;
+}
+
+NET_API_STATUS WINAPI NetFileClose( LMSTR server, DWORD fileid )
+{
+    NET_API_STATUS status;
+
+    TRACE( "(%s %lu)\n", debugstr_w(server), fileid );
+
+    if ((status = check_local_admin_call( server ))) return status;
+    return NERR_FileIdNotFound;
+}
+
+NET_API_STATUS WINAPI NetFileGetInfo( LMSTR server, DWORD fileid, DWORD level, LPBYTE *bufptr )
+{
+    NET_API_STATUS status;
+
+    TRACE( "(%s %lu %lu %p)\n", debugstr_w(server), fileid, level, bufptr );
+
+    if (!bufptr) return ERROR_INVALID_PARAMETER;
+    if (level != 2 && level != 3) return ERROR_INVALID_LEVEL;
+    if ((status = check_local_admin_call( server ))) return status;
+    *bufptr = NULL;
+    return NERR_FileIdNotFound;
+}
+
+NET_API_STATUS WINAPI NetSessionDel( LMSTR server, LMSTR client, LMSTR user )
+{
+    NET_API_STATUS status;
+
+    TRACE( "(%s %s %s)\n", debugstr_w(server), debugstr_w(client), debugstr_w(user) );
+
+    if (!client && !user) return ERROR_INVALID_PARAMETER;
+    if ((status = check_local_admin_call( server ))) return status;
+    return NERR_ClientNameNotFound;
+}
+
+NET_API_STATUS WINAPI NetSessionGetInfo( LMSTR server, LMSTR client, LMSTR user, DWORD level, LPBYTE *bufptr )
+{
+    NET_API_STATUS status;
+
+    TRACE( "(%s %s %s %lu %p)\n", debugstr_w(server), debugstr_w(client), debugstr_w(user), level, bufptr );
+
+    if (!client || !client[0] || !user || !bufptr) return ERROR_INVALID_PARAMETER;
+    if (level != 0 && level != 1 && level != 2 && level != 10) return ERROR_INVALID_LEVEL;
+    if ((status = check_local_admin_call( server ))) return status;
+    *bufptr = NULL;
+    return NERR_ClientNameNotFound;
+}
+
+NET_API_STATUS WINAPI NetShareCheck( LMSTR server, LMSTR device, LPDWORD type )
+{
+    TRACE( "(%s %s %p)\n", debugstr_w(server), debugstr_w(device), type );
+
+    if (!device || !device[0] || !type) return ERROR_INVALID_PARAMETER;
+    if (server && server[0] && !NETAPI_IsLocalComputer( server ))
+    {
+        FIXME( "remote computers not supported\n" );
+        return ERROR_NOT_SUPPORTED;
+    }
+    *type = 0;
+    return NERR_DeviceNotShared;
+}
+
+NET_API_STATUS WINAPI NetShareSetInfo( LMSTR server, LMSTR netname, DWORD level, LPBYTE buf, LPDWORD parm_err )
+{
+    NET_API_STATUS status;
+
+    TRACE( "(%s %s %lu %p %p)\n", debugstr_w(server), debugstr_w(netname), level, buf, parm_err );
+
+    if (!netname || !netname[0] || !buf) return ERROR_INVALID_PARAMETER;
+    if (level != 1 && level != 2 && level != 502 && level != 1004 && level != 1005 && level != 1006
+            && level != 1501)
+        return ERROR_INVALID_LEVEL;
+    if ((status = check_local_admin_call( server ))) return status;
+    return NERR_NetNameNotFound;
+}
+
+NET_API_STATUS WINAPI NetShareEnumSticky( LMSTR server, DWORD level, LPBYTE *bufptr, DWORD prefmaxlen,
+        LPDWORD entriesread, LPDWORD totalentries, LPDWORD resume_handle )
+{
+    NET_API_STATUS status;
+
+    TRACE( "(%s %lu %p %lu %p %p %p)\n", debugstr_w(server), level, bufptr, prefmaxlen, entriesread, totalentries,
+            resume_handle );
+
+    if (!bufptr || !entriesread || !totalentries) return ERROR_INVALID_PARAMETER;
+    if (level != 502) return ERROR_INVALID_LEVEL;
+    if ((status = check_local_admin_call( server ))) return status;
+
+    *bufptr = NULL;
+    *entriesread = 0;
+    *totalentries = 0;
+    if (resume_handle) *resume_handle = 0;
+    return NERR_Success;
+}
+
+NET_API_STATUS WINAPI NetShareDelSticky( LMSTR server, LMSTR netname, DWORD reserved )
+{
+    NET_API_STATUS status;
+
+    TRACE( "(%s %s %lu)\n", debugstr_w(server), debugstr_w(netname), reserved );
+
+    if (!netname || !netname[0]) return ERROR_INVALID_PARAMETER;
+    if ((status = check_local_admin_call( server ))) return status;
+    return NERR_NetNameNotFound;
+}
+
