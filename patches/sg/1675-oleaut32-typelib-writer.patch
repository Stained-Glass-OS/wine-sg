+/* Stained Glass OS 1675: the classes of this user (HKCU\Software\Classes),
+ * where RegisterTypeLibForUser registers; Windows' HKEY_CLASSES_ROOT shows
+ * them before the machine's, Wine's holds only the machine's. */
+static HKEY user_classes_key(BOOL create)
+{
+    HKEY key;
+
+    if (create ? RegCreateKeyExW(HKEY_CURRENT_USER, L"Software\\Classes", 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL)
+               : RegOpenKeyExW(HKEY_CURRENT_USER, L"Software\\Classes", 0, KEY_READ, &key))
+        return NULL;
+    return key;
+}
