+ * registration first, then the machine's.
  */
 static BOOL find_typelib_key( REFGUID guid, WORD *wMaj, WORD *wMin )
+{
+    WORD maj = *wMaj, min = *wMin;
+    HKEY user = user_classes_key(FALSE);
+    BOOL found = FALSE;
+
+    if (user)
+    {
+        found = find_typelib_key_in( user, guid, wMaj, wMin );
+        RegCloseKey( user );
+        if (found) return TRUE;
+        *wMaj = maj;
+        *wMin = min;
+    }
+    return find_typelib_key_in( HKEY_CLASSES_ROOT, guid, wMaj, wMin );
+}
