+/* a help string from the library's help string DLL: its
+ * DLLGetDocumentation (documented) for the library or a type info, the
+ * locale and the help string context */
+static HRESULT dll_help_string(ITypeLibImpl *lib, ITypeInfo *info, LCID lcid, DWORD context, BSTR *out)
+{
+    HRESULT (WINAPI *get_doc)(ITypeLib *, ITypeInfo *, LCID, DWORD, BSTR *);
+    const WCHAR *name = TLB_get_bstr(lib->HelpStringDll);
+    WCHAR path[MAX_PATH], *slash;
+    HMODULE module;
+    HRESULT hr = S_FALSE;
+
+    *out = NULL;
+    if (!name || !*name) return S_FALSE;
+    module = LoadLibraryExW(name, NULL, 0);
+    if (!module && lib->path && lstrlenW(lib->path) < MAX_PATH)
+    {
+        /* beside the type library */
+        lstrcpyW(path, lib->path);
+        if ((slash = wcsrchr(path, '\\')) && (slash - path) + 1 + lstrlenW(name) < MAX_PATH)
+        {
+            lstrcpyW(slash + 1, name);
+            module = LoadLibraryExW(path, NULL, 0);
+        }
+    }
+    if (!module) return S_FALSE;
+    if ((get_doc = (void *)GetProcAddress(module, "DLLGetDocumentation")))
+    {
+        hr = get_doc((ITypeLib *)&lib->ITypeLib2_iface, info, lcid, context, out);
+        if (hr != S_OK || !*out)
+        {
+            SysFreeString(*out);
+            *out = NULL;
+            hr = S_FALSE;
+        }
+    }
+    FreeLibrary(module);
+    return hr;
+}
