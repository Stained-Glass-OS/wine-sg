+/* an hreftype of a type info of the library after one taken out at "gone" */
+static HREFTYPE moved_href(HREFTYPE href, HREFTYPE gone)
+{
+    if (!(href % sizeof(MSFT_TypeInfoBase)) && href > gone && href != (HREFTYPE)-1)
+        return href - sizeof(MSFT_TypeInfoBase);
+    return href;
+}
+
+static void moved_tdesc(TYPEDESC *tdesc, HREFTYPE gone)
+{
+    while (tdesc)
+    {
+        if (tdesc->vt == VT_USERDEFINED)
+        {
+            tdesc->hreftype = moved_href(tdesc->hreftype, gone);
+            return;
+        }
+        if (tdesc->vt == VT_PTR || tdesc->vt == VT_SAFEARRAY) tdesc = tdesc->lptdesc;
+        else if (tdesc->vt == VT_CARRAY) tdesc = &tdesc->lpadesc->tdescElem;
+        else return;
+    }
+}
+
 static HRESULT WINAPI ICreateTypeLib2_fnDeleteTypeInfo(ICreateTypeLib2 *iface,
         LPOLESTR name)
 {
     ITypeLibImpl *This = impl_from_ICreateTypeLib2(iface);
-    FIXME("%p %s - stub\n", This, wine_dbgstr_w(name));
-    return E_NOTIMPL;
+    ITypeInfoImpl *info;
+    HREFTYPE gone;
+    TLBGuid *guid;
+    int i, j, k;
+
+    TRACE("%p %s\n", This, wine_dbgstr_w(name));
+
+    if (!name) return E_INVALIDARG;
+    if (!(info = TLB_get_typeinfo_by_name(This, name))) return TYPE_E_ELEMENTNOTFOUND;
+
+    /* the type infos after it move down a place: their indexes and
+     * hreftypes (offsets of their records), and the references to them */
+    gone = info->hreftype;
+    for (i = info->index; i < This->TypeInfoCount - 1; i++)
+    {
+        This->typeinfos[i] = This->typeinfos[i + 1];
+        This->typeinfos[i]->index = i;
+        This->typeinfos[i]->hreftype -= sizeof(MSFT_TypeInfoBase);
+    }
+    This->TypeInfoCount--;
+    for (i = 0; i < This->TypeInfoCount; i++)
+    {
+        ITypeInfoImpl *other = This->typeinfos[i];
+
+        for (j = 0; j < other->typeattr.cImplTypes; j++)
+            other->impltypes[j].hRef = moved_href(other->impltypes[j].hRef, gone);
+        for (j = 0; j < other->typeattr.cFuncs; j++)
+        {
+            FUNCDESC *desc = &other->funcdescs[j].funcdesc;
+            moved_tdesc(&desc->elemdescFunc.tdesc, gone);
+            for (k = 0; k < desc->cParams; k++) moved_tdesc(&desc->lprgelemdescParam[k].tdesc, gone);
+        }
+        for (j = 0; j < other->typeattr.cVars; j++)
+        {
+            moved_tdesc(&other->vardescs[j].vardesc.elemdescVar.tdesc, gone);
+            if (other->vardescs[j].vardesc_create)
+                moved_tdesc(&other->vardescs[j].vardesc_create->elemdescVar.tdesc, gone);
+        }
+        if (other->tdescAlias) moved_tdesc(other->tdescAlias, gone);
+    }
+    LIST_FOR_EACH_ENTRY(guid, &This->guid_list, TLBGuid, entry)
+    {
+        if (guid->hreftype >= 0 && guid->hreftype == gone && guid == info->guid) guid->hreftype = -1;
+        else if (guid->hreftype >= 0) guid->hreftype = moved_href(guid->hreftype, gone);
+    }
+
+    /* it goes when nobody holds it any more */
+    info->deleted = TRUE;
+    if (!info->ref)
+    {
+        free(info->tdescAlias);
+        ITypeInfoImpl_Destroy(info);
+    }
+    return S_OK;
 }
 
