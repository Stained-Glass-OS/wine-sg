+/* Stained Glass OS 1675: Invoke of a variable rather than a function:
+ * a constant's value, or an instance variable read or written at its
+ * offset in the instance (it was E_NOTIMPL) */
+static HRESULT invoke_variable(const VARDESC *desc, void *instance, WORD flags, DISPPARAMS *params,
+                               VARIANT *result)
+{
+    VARTYPE vt = desc->elemdescVar.tdesc.vt;
+    VARIANT value;
+    BYTE *field;
+    unsigned int size;
+    HRESULT hr;
+
+    if (desc->varkind == VAR_CONST)
+    {
+        if (!(flags & (DISPATCH_PROPERTYGET | DISPATCH_METHOD))) return DISP_E_MEMBERNOTFOUND;
+        if (params->cArgs) return DISP_E_BADPARAMCOUNT;
+        return result ? VariantCopy(result, desc->lpvarValue) : S_OK;
+    }
+    if (desc->varkind != VAR_PERINSTANCE || !instance) return DISP_E_MEMBERNOTFOUND;
+#ifdef SG_MUTANT_NO_VAR_INVOKE
+    return E_NOTIMPL;
+#endif
+
+    field = (BYTE *)instance + desc->oInst;
+    if (flags & DISPATCH_PROPERTYGET)
+    {
+        if (params->cArgs) return DISP_E_BADPARAMCOUNT;
+        if (!result) return S_OK;
+        if (vt == VT_VARIANT) return VariantCopy(result, (VARIANT *)field);
+        if (vt == VT_DECIMAL)
+        {
+            V_VT(result) = VT_DECIMAL;
+            V_DECIMAL(result) = *(DECIMAL *)field;
+            V_VT(result) = VT_DECIMAL;
+            return S_OK;
+        }
+        if (!(size = variable_size(vt))) return DISP_E_BADVARTYPE;
+        V_VT(&value) = vt;
+        memcpy(&V_UI1(&value), field, size);
+        return VariantCopy(result, &value);
+    }
+    if (flags & (DISPATCH_PROPERTYPUT | DISPATCH_PROPERTYPUTREF))
+    {
+        if (params->cArgs != 1) return DISP_E_BADPARAMCOUNT;
+        if (desc->wVarFlags & VARFLAG_FREADONLY) return DISP_E_MEMBERNOTFOUND;
+        if (vt == VT_VARIANT) return VariantCopy((VARIANT *)field, &params->rgvarg[0]);
+        if (!(size = variable_size(vt))) return DISP_E_BADVARTYPE;
+        VariantInit(&value);
+        if (FAILED(hr = VariantChangeType(&value, &params->rgvarg[0], 0, vt))) return hr;
+        /* the old value goes, the new one is the instance's now */
+        if (vt == VT_BSTR) SysFreeString(*(BSTR *)field);
+        else if ((vt == VT_UNKNOWN || vt == VT_DISPATCH) && *(IUnknown **)field)
+            IUnknown_Release(*(IUnknown **)field);
+        memcpy(field, &V_UI1(&value), size);
+        return S_OK;
+    }
+    return DISP_E_MEMBERNOTFOUND;
+}
