From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: a 64-bit debugger's break-in thread runs in a 32-bit process (7002)

DbgUiIssueRemoteBreakin asks the debuggee for a thread at the 64-bit
ntdll's DbgUiRemoteBreakin. A wow64 process starts every thread in 32-bit
code, so the address was cut to 32 bits and the thread faulted: attaching
winedbg (or any 64-bit debugger) to a running 32-bit program killed it.
The debuggee starts that thread at its 32-bit ntdll's DbgUiRemoteBreakin
instead, found with the other wow64 ntdll entry points.
---
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 68cd4f5..c424135 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -109,6 +109,7 @@ static const char so_dir[] = "";
 #endif
 
 void *pDbgUiRemoteBreakin = NULL;
+ULONG pDbgUiRemoteBreakin32 = 0;  /* the 32-bit ntdll's, in a wow64 process */
 void *pKiRaiseUserExceptionDispatcher = NULL;
 void *pKiUserExceptionDispatcher = NULL;
 void *pKiUserApcDispatcher = NULL;
@@ -1618,6 +1619,8 @@ static void load_ntdll_wow64_functions( HMODULE module )
 #undef GET_FUNC
 
     p__wine_ctrl_routine = (void *)find_named_export( module, exports, "__wine_ctrl_routine" );
+    /* Stained Glass OS (wine-sg 7002): where a debugger's break-in thread starts */
+    pDbgUiRemoteBreakin32 = (ULONG_PTR)find_named_export( module, exports, "DbgUiRemoteBreakin" );
 
 #ifdef _WIN64
     {
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index b5fd6c1..df825ad 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -641,6 +641,15 @@ static void invoke_system_apc( const union apc_call *call, union apc_result *res
         {
             /* FIXME: hack for debugging 32-bit process without a 64-bit ntdll */
             if (is_old_wow64() && func == (void *)0x7ffe1000) func = pDbgUiRemoteBreakin;
+#ifndef SG_MUTANT_BREAKIN_64BIT_IN_WOW64
+            /* Stained Glass OS (wine-sg 7002): a 64-bit debugger's DbgUiIssueRemoteBreakin
+             * asks a 32-bit (wow64) process for a thread at the 64-bit ntdll's
+             * DbgUiRemoteBreakin. A wow64 process starts every thread in 32-bit code, so the
+             * address was cut to 32 bits and the thread faulted: attaching winedbg killed the
+             * program. It starts at the 32-bit ntdll's DbgUiRemoteBreakin instead. */
+            if (is_wow64() && func == pDbgUiRemoteBreakin && pDbgUiRemoteBreakin32)
+                func = ULongToPtr( pDbgUiRemoteBreakin32 );
+#endif
             attr->TotalLength = sizeof(buffer);
             attr->Attributes[0].Attribute    = PS_ATTRIBUTE_CLIENT_ID;
             attr->Attributes[0].Size         = sizeof(id);
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
index e2daa82..4ed585f 100644
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -150,6 +150,7 @@ static const LONG teb_offset = 0x2000;
 
 /* callbacks to PE ntdll from the Unix side */
 extern void *pDbgUiRemoteBreakin;
+extern ULONG pDbgUiRemoteBreakin32;
 extern void *pKiRaiseUserExceptionDispatcher;
 extern void *pKiUserExceptionDispatcher;
 extern void *pKiUserApcDispatcher;
