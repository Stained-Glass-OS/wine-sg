From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: a packaged program's application user model ID from its manifest

GetCurrentApplicationUserModelId and GetApplicationUserModelId found a
packaged program's application only through an app execution alias. They
now also take it from the package's AppxManifest.xml (the Application whose
Executable is the program) and, for a program in a sparse package's external
location, from the applicationId of its own manifest's msix element. Office's
aimgr.exe is such a program: the Windows App SDK runtime it loads stopped it
(c0000409) on APPMODEL_ERROR_NO_APPLICATION, so Word's AI manager never came
up.
---
diff --git a/dlls/kernelbase/version.c b/dlls/kernelbase/version.c
index 4399dce..9789c9c 100644
--- a/dlls/kernelbase/version.c
+++ b/dlls/kernelbase/version.c
@@ -1727,6 +1727,110 @@ LONG WINAPI /* DECLSPEC_HOTPATCH */ GetCurrentPackageFullName( UINT32 *length, W
 }
 
 
+/* Stained Glass OS: a packaged program's application when no alias names it -- the Application
+ * element of the package's AppxManifest.xml whose Executable is the program, or, for a program in a
+ * package's external location, the applicationId its own manifest gives (wine/sparseid.h). Office's
+ * aimgr.exe (a sparse package): the Windows App SDK runtime it loads stopped the process
+ * (c0000409) when GetCurrentApplicationUserModelId said APPMODEL_ERROR_NO_APPLICATION. */
+static BOOL manifest_application( const WCHAR *install, const WCHAR *relative, WCHAR *id, DWORD size )
+{
+    WCHAR path[MAX_PATH], exe[MAX_PATH], *p;
+    LARGE_INTEGER file_size;
+    DWORD read = 0;
+    SIZE_T i, end;
+    HANDLE file;
+    char *xml;
+    BOOL ret = FALSE;
+
+    if (wcslen( install ) + 20 >= ARRAY_SIZE(path)) return FALSE;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\AppxManifest.xml", install );
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, 0 );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    if (!GetFileSizeEx( file, &file_size ) || file_size.QuadPart > 4 * 1024 * 1024 ||
+        !(xml = HeapAlloc( GetProcessHeap(), 0, file_size.u.LowPart + 1 )))
+    {
+        CloseHandle( file );
+        return FALSE;
+    }
+    ReadFile( file, xml, file_size.u.LowPart, &read, NULL );
+    CloseHandle( file );
+    for (i = 0; !ret && i + 13 < read; i++)
+    {
+        if (xml[i] != '<' || memcmp( xml + i + 1, "Application", 11 ) ||
+            (xml[i + 12] != ' ' && xml[i + 12] != '\t' && xml[i + 12] != '\r' && xml[i + 12] != '\n'))
+            continue;
+        for (end = i; end < read && xml[end] != '>'; end++);
+        if (end >= read) break;
+        if (!sparseid_attribute( xml, i + 11, end, "Executable", exe, ARRAY_SIZE(exe) )) continue;
+        for (p = exe; *p; p++) if (*p == '/') *p = '\\';
+#ifdef SG_MUTANT_AUMID_NO_MANIFEST
+        continue;
+#endif
+        if (!sparseid_equal( exe, relative )) continue;
+        ret = sparseid_attribute( xml, i + 11, end, "Id", id, size ) && id[0];
+    }
+    HeapFree( GetProcessHeap(), 0, xml );
+    return ret;
+}
+
+static BOOL external_application( const WCHAR *image, const WCHAR *full_name, WCHAR *id, DWORD size )
+{
+    WCHAR key[MAX_PATH], name[256], publisher[512];
+    HMODULE module;
+    DWORD bytes;
+    HRSRC res;
+    HGLOBAL data;
+    BOOL ret = FALSE;
+
+    if (wcslen( full_name ) + ARRAY_SIZE(deployed_packagesW) + 1 >= ARRAY_SIZE(key)) return FALSE;
+    swprintf( key, ARRAY_SIZE(key), L"%s\\%s", deployed_packagesW, full_name );
+    bytes = sizeof(name);
+    if (RegGetValueW( record_hive( key ), key, L"Name", RRF_RT_REG_SZ | RRF_SUBKEY_WOW6464KEY, NULL, name, &bytes )) return FALSE;
+    bytes = sizeof(publisher);
+    if (RegGetValueW( record_hive( key ), key, L"Publisher", RRF_RT_REG_SZ | RRF_SUBKEY_WOW6464KEY, NULL, publisher, &bytes )) return FALSE;
+#ifdef SG_MUTANT_AUMID_NO_SPARSE
+    return FALSE;
+#endif
+    if (!(module = LoadLibraryExW( image, 0, LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE ))) return FALSE;
+    if ((res = FindResourceW( module, MAKEINTRESOURCEW(1), (const WCHAR *)RT_MANIFEST )) && (data = LoadResource( module, res )))
+        ret = sparseid_manifest_application( LockResource( data ), SizeofResource( module, res ), name, publisher, id, size ) && id[0];
+    FreeLibrary( module );
+    return ret;
+}
+
+static LONG package_application_id( const WCHAR *image, UINT32 *length, WCHAR *aumid )
+{
+    WCHAR name[256], path[MAX_PATH], key[MAX_PATH], app[256], family[256], result[512];
+    UNICODE_STRING str;
+    UINT32 family_len;
+    DWORD index = 0, plen, bytes;
+
+    RtlInitUnicodeString( &str, image );
+    while (enum_deployed_package( index++, name, ARRAY_SIZE(name) ))
+    {
+        app[0] = 0;
+        if (package_location( name, path, ARRAY_SIZE(path) ) && image_in_folder( &str, path ))
+        {
+            plen = wcslen( path );
+            if (path[plen - 1] == '\\') plen--;
+            if (!manifest_application( path, image + plen + 1, app, ARRAY_SIZE(app) )) continue;
+        }
+        else
+        {
+            swprintf( key, ARRAY_SIZE(key), L"%s\\%s", deployed_packagesW, name );
+            bytes = sizeof(path);
+            if (RegGetValueW( record_hive( key ), key, L"ExternalLocation", RRF_RT_REG_SZ | RRF_SUBKEY_WOW6464KEY, NULL, path, &bytes )) continue;
+            if (!image_in_folder( &str, path ) || !external_application( image, name, app, ARRAY_SIZE(app) )) continue;
+        }
+        family_len = ARRAY_SIZE(family);
+        if (PackageFamilyNameFromFullName( name, &family_len, family )) continue;
+        if (wcslen( family ) + wcslen( app ) + 2 > ARRAY_SIZE(result)) continue;
+        swprintf( result, ARRAY_SIZE(result), L"%s!%s", family, app );
+        return copy_package_string( result, length, aumid );
+    }
+    return APPMODEL_ERROR_NO_APPLICATION;
+}
+
 /* An application's user model ID is its package family and its
  * application's id. The package's app execution aliases record both for an
  * executable, so the one whose target is this image names it. */
@@ -1763,6 +1867,7 @@ static LONG application_user_model_id( const WCHAR *image, UINT32 *length, WCHAR
                 ret = copy_package_string( aumid, length, id );
         }
     }
+    if (ret == APPMODEL_ERROR_NO_APPLICATION) ret = package_application_id( image, length, id );
     return ret;
 }
 
diff --git a/include/wine/sparseid.h b/include/wine/sparseid.h
index 2a475ea..9638149 100644
--- a/include/wine/sparseid.h
+++ b/include/wine/sparseid.h
@@ -125,9 +125,10 @@ static inline BOOL sparseid_equal( const WCHAR *a, const WCHAR *b )
     return !*a && !*b;
 }
 
-/* Whether a manifest (UTF-8 XML) names the package of this name and publisher in an msix element. */
-static inline BOOL sparseid_manifest_names_package( const char *xml, SIZE_T size, const WCHAR *name,
-                                                    const WCHAR *publisher )
+/* Whether a manifest (UTF-8 XML) names the package of this name and publisher in an msix element,
+ * and the application it names (its applicationId, the program's application in the package). */
+static inline BOOL sparseid_manifest_application( const char *xml, SIZE_T size, const WCHAR *name,
+                                                  const WCHAR *publisher, WCHAR *app, SIZE_T app_size )
 {
     WCHAR value[512];
     SIZE_T i, end;
@@ -146,9 +147,17 @@ static inline BOOL sparseid_manifest_names_package( const char *xml, SIZE_T size
         if (!sparseid_attribute( xml, i + 4, end, "publisher", value, ARRAY_SIZE(value) ) ||
             !sparseid_equal( value, publisher ))
             continue;
+        if (app && !sparseid_attribute( xml, i + 4, end, "applicationId", app, app_size )) app[0] = 0;
         return TRUE;
     }
     return FALSE;
 }
 
+/* Whether a manifest (UTF-8 XML) names the package of this name and publisher in an msix element. */
+static inline BOOL sparseid_manifest_names_package( const char *xml, SIZE_T size, const WCHAR *name,
+                                                    const WCHAR *publisher )
+{
+    return sparseid_manifest_application( xml, size, name, publisher, NULL, 0 );
+}
+
 #endif  /* __WINE_WINE_SPARSEID_H */
