index b82bc32..ee7f520 100644
--- a/dlls/windows.ui.xaml/Makefile.in
+++ b/dlls/windows.ui.xaml/Makefile.in
@@ -23,6 +23,7 @@ SOURCES = \
 	render.c \
 	resfile.c \
 	resources.c \
+	shapes.c \
 	templates.c \
 	text.c \
 	value.c \
