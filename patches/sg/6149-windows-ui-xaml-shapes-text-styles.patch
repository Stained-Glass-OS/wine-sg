@@ -126,6 +126,50 @@ void xdraw_border( struct xdraw *draw, const struct xrect *rect, const struct xt
     xdraw_fill( draw, &side, color, NULL );
 }
 
+/* a rectangle (corners of radii rx, ry) or an ellipse in a rectangle: filled, outlined inside it */
+void xdraw_shape( struct xdraw *draw, BOOL ellipse, const struct xrect *rect, FLOAT rx, FLOAT ry,
+                  const struct xcolor *fill, const struct xcolor *stroke, FLOAT width )
+{
+    FLOAT half = stroke ? width / 2 : 0;
+    D2D1_RECT_F r = { draw->x + rect->x + half, draw->y + rect->y + half,
+                      draw->x + rect->x + rect->width - half, draw->y + rect->y + rect->height - half };
+    ID2D1SolidColorBrush *brush;
+    unsigned int pass;
+
+    if (r.right <= r.left || r.bottom <= r.top) return;
+    for (pass = 0; pass < 2; pass++)
+    {
+        const struct xcolor *color = pass ? stroke : fill;
+
+        if (!color || !color->a || (pass && width <= 0) || !(brush = solid( draw, *color ))) continue;
+        if (ellipse)
+        {
+            D2D1_ELLIPSE e = { { (r.left + r.right) / 2, (r.top + r.bottom) / 2 }, (r.right - r.left) / 2, (r.bottom - r.top) / 2 };
+            if (pass) ID2D1RenderTarget_DrawEllipse( draw->target, &e, (ID2D1Brush *)brush, width, NULL );
+            else ID2D1RenderTarget_FillEllipse( draw->target, &e, (ID2D1Brush *)brush );
+        }
+        else if (rx > 0 || ry > 0)
+        {
+            D2D1_ROUNDED_RECT rr = { r, rx, ry };
+            if (pass) ID2D1RenderTarget_DrawRoundedRectangle( draw->target, &rr, (ID2D1Brush *)brush, width, NULL );
+            else ID2D1RenderTarget_FillRoundedRectangle( draw->target, &rr, (ID2D1Brush *)brush );
+        }
+        else if (pass) ID2D1RenderTarget_DrawRectangle( draw->target, &r, (ID2D1Brush *)brush, width, NULL );
+        else ID2D1RenderTarget_FillRectangle( draw->target, &r, (ID2D1Brush *)brush );
+        ID2D1SolidColorBrush_Release( brush );
+    }
+}
+
+void xdraw_line( struct xdraw *draw, FLOAT x1, FLOAT y1, FLOAT x2, FLOAT y2, struct xcolor color, FLOAT width )
+{
+    D2D1_POINT_2F a = { draw->x + x1, draw->y + y1 }, b = { draw->x + x2, draw->y + y2 };
+    ID2D1SolidColorBrush *brush;
+
+    if (!color.a || width <= 0 || !(brush = solid( draw, color ))) return;
+    ID2D1RenderTarget_DrawLine( draw->target, a, b, (ID2D1Brush *)brush, width, NULL );
+    ID2D1SolidColorBrush_Release( brush );
+}
+
 void xdraw_text( struct xdraw *draw, IUnknown *layout, FLOAT x, FLOAT y, struct xcolor color )
 {
     ID2D1SolidColorBrush *brush;
