+/*
+ * A shape fills (Fill) and outlines (Stroke, StrokeThickness) its geometry: a Rectangle (with
+ * RadiusX/RadiusY) or an Ellipse filling the space it is given (Stretch Fill, its Width and Height
+ * when set; no size of its own), a Line from X1,Y1 to X2,Y2 (its size: the far end and the stroke).
+ * Caps, joins, dashes and the miter limit are kept; strokes are drawn plain.
+ */
+
+#include <math.h>
+#include <stdlib.h>
+#include "private.h"
+
+
+enum shape_kind { SHAPE_RECTANGLE, SHAPE_ELLIPSE, SHAPE_LINE };
+
+static struct xaml_property *prop_fill, *prop_stroke, *prop_stroke_miter_limit, *prop_stroke_thickness,
+                            *prop_stroke_start_cap, *prop_stroke_end_cap, *prop_stroke_join, *prop_stroke_dash_offset,
+                            *prop_stroke_dash_cap, *prop_stroke_dash_array, *prop_stretch;
+static struct xaml_property *prop_radius_x, *prop_radius_y, *prop_x1, *prop_y1, *prop_x2, *prop_y2;
+
+struct shape
+{
+    struct uielem e;
+    struct xiface IShape_iface, IShape2_iface, IKind_iface;   /* IRectangle, IEllipse or ILine */
+    enum shape_kind kind;
+};
+
+static void shapes_init(void);
+
+static struct shape *shape_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct shape, e.d.obj );
+}
+
+static DOUBLE get_dbl( struct shape *shape, struct xaml_property *prop, DOUBLE def )
+{
+    IInspectable *box = NULL;
+    DOUBLE ret;
+
+    dobj_get_value( &shape->e.d, prop, &box );
+    ret = xunbox_double( box, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static HRESULT put_box( struct shape *shape, struct xaml_property *prop, IInspectable *box )
+{
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &shape->e.d, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static BOOL brush_color( struct shape *shape, struct xaml_property *prop, struct xcolor *color )
+{
+    IInspectable *brush = NULL;
+    BOOL ret;
+
+    dobj_get_value( &shape->e.d, prop, &brush );
+    ret = brush && xaml_brush_color( brush, color );
+    if (brush) IInspectable_Release( brush );
+    return ret;
+}
+
+/* ---- layout and drawing ---- */
+
+static void shape_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct shape *shape = CONTAINING_RECORD( elem, struct shape, e );
+    DOUBLE thickness = get_dbl( shape, prop_stroke_thickness, 1 );
+
+    desired->width = desired->height = 0;
+    if (shape->kind == SHAPE_LINE)
+    {
+        desired->width = fmax( get_dbl( shape, prop_x1, 0 ), get_dbl( shape, prop_x2, 0 ) ) + thickness / 2;
+        desired->height = fmax( get_dbl( shape, prop_y1, 0 ), get_dbl( shape, prop_y2, 0 ) ) + thickness / 2;
+    }
+    /* a rectangle or an ellipse has no size of its own: its Width and Height, or what it is given */
+}
+
+static void shape_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    *used = final;
+}
+
+static void shape_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct shape *shape = CONTAINING_RECORD( elem, struct shape, e );
+    struct xcolor fill, stroke;
+    BOOL has_fill = brush_color( shape, prop_fill, &fill ), has_stroke = brush_color( shape, prop_stroke, &stroke );
+    FLOAT thickness = has_stroke ? get_dbl( shape, prop_stroke_thickness, 1 ) : 0;
+    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
+
+#ifdef SG_MUTANT_SHAPE_NO_FILL
+    has_fill = FALSE;
+#endif
+    switch (shape->kind)
+    {
+    case SHAPE_LINE:
+        if (has_stroke)
+            xdraw_line( draw, get_dbl( shape, prop_x1, 0 ), get_dbl( shape, prop_y1, 0 ), get_dbl( shape, prop_x2, 0 ),
+                        get_dbl( shape, prop_y2, 0 ), stroke, thickness );
+        break;
+    case SHAPE_RECTANGLE:
+        xdraw_shape( draw, FALSE, &rect, get_dbl( shape, prop_radius_x, 0 ), get_dbl( shape, prop_radius_y, 0 ),
+                     has_fill ? &fill : NULL, has_stroke ? &stroke : NULL, thickness );
+        break;
+    case SHAPE_ELLIPSE:
+        xdraw_shape( draw, TRUE, &rect, 0, 0, has_fill ? &fill : NULL, has_stroke ? &stroke : NULL, thickness );
+        break;
+    }
+}
+
+static const struct elem_ops shape_ops = { shape_measure, shape_arrange, shape_render };
+
+/* ---- IShape ---- */
+
+#define OBJECT_MEMBER(name, prop) \
+static HRESULT WINAPI shape_get_##name( struct xiface *iface, IInspectable **value ) \
+{ if (!value) return E_POINTER; return dobj_get_value( &shape_from_iface( iface )->e.d, prop, value ); } \
+static HRESULT WINAPI shape_put_##name( struct xiface *iface, IInspectable *value ) \
+{ return dobj_set_value( &shape_from_iface( iface )->e.d, prop, value ); }
+
+#define DOUBLE_MEMBER(prefix, name, prop, def) \
+static HRESULT WINAPI prefix##_get_##name( struct xiface *iface, DOUBLE *value ) \
+{ if (!value) return E_POINTER; *value = get_dbl( shape_from_iface( iface ), prop, def ); return S_OK; } \
+static HRESULT WINAPI prefix##_put_##name( struct xiface *iface, DOUBLE value ) \
+{ return put_box( shape_from_iface( iface ), prop, xbox_double( value ) ); }
+
+#define ENUM_MEMBER(name, prop, def) \
+static HRESULT WINAPI shape_get_##name( struct xiface *iface, INT32 *value ) \
+{ \
+    IInspectable *box = NULL; \
+    if (!value) return E_POINTER; \
+    dobj_get_value( &shape_from_iface( iface )->e.d, prop, &box ); \
+    *value = xunbox_enum( box, NULL, def ); \
+    if (box) IInspectable_Release( box ); \
+    return S_OK; \
+} \
+static HRESULT WINAPI shape_put_##name( struct xiface *iface, INT32 value ) \
+{ return put_box( shape_from_iface( iface ), prop, xbox_int32( value ) ); }
+
+OBJECT_MEMBER(Fill, prop_fill)
+OBJECT_MEMBER(Stroke, prop_stroke)
+OBJECT_MEMBER(StrokeDashArray, prop_stroke_dash_array)
+DOUBLE_MEMBER(shape, StrokeMiterLimit, prop_stroke_miter_limit, 10)
+DOUBLE_MEMBER(shape, StrokeThickness, prop_stroke_thickness, 1)
+DOUBLE_MEMBER(shape, StrokeDashOffset, prop_stroke_dash_offset, 0)
+ENUM_MEMBER(StrokeStartLineCap, prop_stroke_start_cap, 0)
+ENUM_MEMBER(StrokeEndLineCap, prop_stroke_end_cap, 0)
+ENUM_MEMBER(StrokeLineJoin, prop_stroke_join, 0)
+ENUM_MEMBER(StrokeDashCap, prop_stroke_dash_cap, 0)
+ENUM_MEMBER(Stretch, prop_stretch, 0)
+
+static HRESULT WINAPI shape_get_GeometryTransform( struct xiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;   /* no transform: the geometry as it is */
+    return S_OK;
+}
+
+static const void *shape_vtbl[] =
+{
+    IShape_STUBS,
+    [IShape_Fill] = shape_get_Fill, [IShape_SetFill] = shape_put_Fill,
+    [IShape_Stroke] = shape_get_Stroke, [IShape_SetStroke] = shape_put_Stroke,
+    [IShape_StrokeMiterLimit] = shape_get_StrokeMiterLimit, [IShape_SetStrokeMiterLimit] = shape_put_StrokeMiterLimit,
+    [IShape_StrokeThickness] = shape_get_StrokeThickness, [IShape_SetStrokeThickness] = shape_put_StrokeThickness,
+    [IShape_StrokeStartLineCap] = shape_get_StrokeStartLineCap, [IShape_SetStrokeStartLineCap] = shape_put_StrokeStartLineCap,
+    [IShape_StrokeEndLineCap] = shape_get_StrokeEndLineCap, [IShape_SetStrokeEndLineCap] = shape_put_StrokeEndLineCap,
+    [IShape_StrokeLineJoin] = shape_get_StrokeLineJoin, [IShape_SetStrokeLineJoin] = shape_put_StrokeLineJoin,
+    [IShape_StrokeDashOffset] = shape_get_StrokeDashOffset, [IShape_SetStrokeDashOffset] = shape_put_StrokeDashOffset,
+    [IShape_StrokeDashCap] = shape_get_StrokeDashCap, [IShape_SetStrokeDashCap] = shape_put_StrokeDashCap,
+    [IShape_StrokeDashArray] = shape_get_StrokeDashArray, [IShape_SetStrokeDashArray] = shape_put_StrokeDashArray,
+    [IShape_Stretch] = shape_get_Stretch, [IShape_SetStretch] = shape_put_Stretch,
+    [IShape_GeometryTransform] = shape_get_GeometryTransform,
+};
+
+static const void *shape2_vtbl[] = { IShape2_STUBS };
+
+/* ---- Rectangle, Ellipse, Line ---- */
+
+DOUBLE_MEMBER(rect, RadiusX, prop_radius_x, 0)
+DOUBLE_MEMBER(rect, RadiusY, prop_radius_y, 0)
+
+static const void *rectangle_vtbl[] =
+{
+    IRectangle_STUBS,
+    [IRectangle_RadiusX] = rect_get_RadiusX, [IRectangle_SetRadiusX] = rect_put_RadiusX,
+    [IRectangle_RadiusY] = rect_get_RadiusY, [IRectangle_SetRadiusY] = rect_put_RadiusY,
+};
+
+static const void *ellipse_vtbl[] = { IEllipse_STUBS };
+
+DOUBLE_MEMBER(line, X1, prop_x1, 0)
+DOUBLE_MEMBER(line, Y1, prop_y1, 0)
+DOUBLE_MEMBER(line, X2, prop_x2, 0)
+DOUBLE_MEMBER(line, Y2, prop_y2, 0)
+
+static const void *line_vtbl[] =
+{
+    ILine_STUBS,
+    [ILine_X1] = line_get_X1, [ILine_SetX1] = line_put_X1, [ILine_Y1] = line_get_Y1, [ILine_SetY1] = line_put_Y1,
+    [ILine_X2] = line_get_X2, [ILine_SetX2] = line_put_X2, [ILine_Y2] = line_get_Y2, [ILine_SetY2] = line_put_Y2,
+};
+
+static const struct xiface_entry rectangle_ifaces[] =
+{
+    { &IID_IRectangle, offsetof(struct shape, IKind_iface) },
+    { &IID_IShape, offsetof(struct shape, IShape_iface) },
+    { &IID_IShape2, offsetof(struct shape, IShape2_iface) },
+    UIELEM_IFACES,
+};
+
+static const struct xiface_entry ellipse_ifaces[] =
+{
+    { &IID_IEllipse, offsetof(struct shape, IKind_iface) },
+    { &IID_IShape, offsetof(struct shape, IShape_iface) },
+    { &IID_IShape2, offsetof(struct shape, IShape2_iface) },
+    UIELEM_IFACES,
+};
+
+static const struct xiface_entry line_ifaces[] =
+{
+    { &IID_ILine, offsetof(struct shape, IKind_iface) },
+    { &IID_IShape, offsetof(struct shape, IShape_iface) },
+    { &IID_IShape2, offsetof(struct shape, IShape2_iface) },
+    UIELEM_IFACES,
+};
+
+static void shape_destroy( struct xobj *obj )
+{
+    uielem_cleanup( &CONTAINING_RECORD( obj, struct shape, e.d.obj )->e );
+}
+
+static const struct xclass rectangle_class =
+{
+    L"Windows.UI.Xaml.Shapes.Rectangle", rectangle_ifaces, ARRAY_SIZE(rectangle_ifaces), shape_destroy,
+};
+static const struct xclass ellipse_class =
+{
+    L"Windows.UI.Xaml.Shapes.Ellipse", ellipse_ifaces, ARRAY_SIZE(ellipse_ifaces), shape_destroy,
+};
+static const struct xclass line_class =
+{
+    L"Windows.UI.Xaml.Shapes.Line", line_ifaces, ARRAY_SIZE(line_ifaces), shape_destroy,
+};
+
+static HRESULT activate_shape( enum shape_kind kind, IInspectable **out )
+{
+    static const struct xclass *classes[] = { &rectangle_class, &ellipse_class, &line_class };
+    static const void **vtbls[] = { rectangle_vtbl, ellipse_vtbl, line_vtbl };
+    struct shape *shape;
+
+    shapes_init();
+    if (!(shape = calloc( 1, sizeof(*shape) ))) return E_OUTOFMEMORY;
+    shape->kind = kind;
+    shape->IShape_iface.vtbl = shape_vtbl;
+    shape->IShape2_iface.vtbl = shape2_vtbl;
+    shape->IKind_iface.vtbl = vtbls[kind];
+    uielem_init( &shape->e, classes[kind], &shape_ops, NULL );
+    *out = (IInspectable *)&shape->IKind_iface;
+    return S_OK;
+}
+
+static HRESULT activate_rectangle( IInspectable **out ) { return activate_shape( SHAPE_RECTANGLE, out ); }
+static HRESULT activate_ellipse( IInspectable **out ) { return activate_shape( SHAPE_ELLIPSE, out ); }
+static HRESULT activate_line( IInspectable **out ) { return activate_shape( SHAPE_LINE, out ); }
+
+#define DEF_STATIC(name, prop) \
+static HRESULT WINAPI name( struct xfiface *iface, IInspectable **value ) \
+{ \
+    shapes_init(); \
+    if (!value) return E_POINTER; \
+    IInspectable_AddRef( (*value = xaml_property_iface( prop )) ); \
+    return S_OK; \
+}
+
+DEF_STATIC(rect_statics_RadiusXProperty, prop_radius_x)
+DEF_STATIC(rect_statics_RadiusYProperty, prop_radius_y)
+DEF_STATIC(line_statics_X1Property, prop_x1)
+DEF_STATIC(line_statics_Y1Property, prop_y1)
+DEF_STATIC(line_statics_X2Property, prop_x2)
+DEF_STATIC(line_statics_Y2Property, prop_y2)
+
+static const void *rect_statics_vtbl[] =
+{
+    IRectangleStatics_FSTUBS,
+    [IRectangleStatics_RadiusXProperty] = rect_statics_RadiusXProperty,
+    [IRectangleStatics_RadiusYProperty] = rect_statics_RadiusYProperty,
+};
+
+static const void *line_statics_vtbl[] =
+{
+    ILineStatics_FSTUBS,
+    [ILineStatics_X1Property] = line_statics_X1Property, [ILineStatics_Y1Property] = line_statics_Y1Property,
+    [ILineStatics_X2Property] = line_statics_X2Property, [ILineStatics_Y2Property] = line_statics_Y2Property,
+};
+
+static struct xfactory rectangle_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Shapes.Rectangle",
+                                                 { &IID_IRectangleStatics }, { { rect_statics_vtbl } }, activate_rectangle };
+static struct xfactory ellipse_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Shapes.Ellipse",
+                                               { NULL }, { { NULL } }, activate_ellipse };
+static struct xfactory line_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Shapes.Line",
+                                            { &IID_ILineStatics }, { { line_statics_vtbl } }, activate_line };
+
+IActivationFactory *rectangle_factory = &rectangle_factory_obj.IActivationFactory_iface;
+IActivationFactory *ellipse_factory = &ellipse_factory_obj.IActivationFactory_iface;
+IActivationFactory *line_factory = &line_factory_obj.IActivationFactory_iface;
+
+/* ---- the properties ---- */
+
+static void visual_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    xaml_invalidate_visuals();
+}
+
+static void layout_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    uielem_invalidate_measure( CONTAINING_RECORD( obj, struct uielem, d ) );
+}
+
+static BOOL WINAPI init_shapes( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR shape[] = L"Windows.UI.Xaml.Shapes.Shape", rect[] = L"Windows.UI.Xaml.Shapes.Rectangle",
+                       line[] = L"Windows.UI.Xaml.Shapes.Line";
+    static const WCHAR cap[] = L"Windows.UI.Xaml.Media.PenLineCap";
+
+    xaml_elements_init();
+    xaml_media_init();
+    prop_fill = xaml_property_register( shape, L"Fill", L"Windows.UI.Xaml.Media.Brush", NULL, FALSE, visual_changed );
+    prop_stroke = xaml_property_register( shape, L"Stroke", L"Windows.UI.Xaml.Media.Brush", NULL, FALSE, layout_changed );
+    prop_stroke_miter_limit = xaml_property_register( shape, L"StrokeMiterLimit", L"Double", xbox_double( 10 ), FALSE, NULL );
+    prop_stroke_thickness = xaml_property_register( shape, L"StrokeThickness", L"Double", xbox_double( 1 ), FALSE, layout_changed );
+    prop_stroke_start_cap = xaml_property_register( shape, L"StrokeStartLineCap", cap, xbox_int32( 0 ), FALSE, NULL );
+    prop_stroke_end_cap = xaml_property_register( shape, L"StrokeEndLineCap", cap, xbox_int32( 0 ), FALSE, NULL );
+    prop_stroke_join = xaml_property_register( shape, L"StrokeLineJoin", L"Windows.UI.Xaml.Media.PenLineJoin",
+                                               xbox_int32( 0 ), FALSE, NULL );
+    prop_stroke_dash_offset = xaml_property_register( shape, L"StrokeDashOffset", L"Double", xbox_double( 0 ), FALSE, NULL );
+    prop_stroke_dash_cap = xaml_property_register( shape, L"StrokeDashCap", cap, xbox_int32( 0 ), FALSE, NULL );
+    prop_stroke_dash_array = xaml_property_register( shape, L"StrokeDashArray",
+                                                     L"Windows.UI.Xaml.Media.DoubleCollection", NULL, FALSE, NULL );
+    prop_stretch = xaml_property_register( shape, L"Stretch", L"Windows.UI.Xaml.Media.Stretch", xbox_int32( 0 ), FALSE,
+                                           layout_changed );
+    prop_radius_x = xaml_property_register( rect, L"RadiusX", L"Double", xbox_double( 0 ), FALSE, visual_changed );
+    prop_radius_y = xaml_property_register( rect, L"RadiusY", L"Double", xbox_double( 0 ), FALSE, visual_changed );
+    prop_x1 = xaml_property_register( line, L"X1", L"Double", xbox_double( 0 ), FALSE, layout_changed );
+    prop_y1 = xaml_property_register( line, L"Y1", L"Double", xbox_double( 0 ), FALSE, layout_changed );
+    prop_x2 = xaml_property_register( line, L"X2", L"Double", xbox_double( 0 ), FALSE, layout_changed );
+    prop_y2 = xaml_property_register( line, L"Y2", L"Double", xbox_double( 0 ), FALSE, layout_changed );
+    return TRUE;
+}
+
+static void shapes_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_shapes, NULL, NULL );
+}
