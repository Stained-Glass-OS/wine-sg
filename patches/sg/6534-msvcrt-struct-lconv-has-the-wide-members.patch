From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcrt: struct lconv has the wide members (6534)

localeconv() in msvcrt.dll returns a struct lconv that also has the
wide members (_W_decimal_point to _W_negative_sign) after the narrow
ones, as the mingw-w64 headers declare it for msvcrt.dll since Windows
7. Wine gave them only to msvcr100 and later. Programs built for
msvcrt.dll that read them got whatever followed the struct in memory.
Python 3.8 built that way (OpenShot's) reads them in
locale.localeconv(), and OpenShot crashed when it exported a video
(wcslen on a byte of narrow data).

msvcrt.dll now fills them as msvcr100 does. crtdll keeps the old,
shorter struct.
---
 dlls/msvcrt/locale.c       | 20 +++++++++----------
 dlls/msvcrt/msvcrt.h       |  7 +++++++
 dlls/msvcrt/tests/locale.c | 39 ++++++++++++++++++++++++++++++++++++++
 include/msvcrt/locale.h    |  3 ++-
 4 files changed, 58 insertions(+), 11 deletions(-)

diff --git a/dlls/msvcrt/locale.c b/dlls/msvcrt/locale.c
index ca70b9c..8869a6c 100644
--- a/dlls/msvcrt/locale.c
+++ b/dlls/msvcrt/locale.c
@@ -156,7 +156,7 @@ static const unsigned char cloc_cumap[256] =
 
 static char empty[] = "";
 static char cloc_dec_point[] = ".";
-#if _MSVCR_VER >= 100
+#if LCONV_WIDE
 static wchar_t emptyW[] = L"";
 static wchar_t cloc_dec_pointW[] = L".";
 #endif
@@ -164,7 +164,7 @@ static struct lconv cloc_lconv =
 {
     cloc_dec_point, empty, empty, empty, empty, empty, empty, empty, empty, empty,
     CHAR_MAX, CHAR_MAX, CHAR_MAX, CHAR_MAX, CHAR_MAX, CHAR_MAX, CHAR_MAX, CHAR_MAX,
-#if _MSVCR_VER >= 100
+#if LCONV_WIDE
     cloc_dec_pointW, emptyW, emptyW, emptyW, emptyW, emptyW, emptyW, emptyW
 #endif
 };
@@ -1094,7 +1094,7 @@ void free_locinfo(pthreadlocinfo locinfo)
         free(locinfo->lconv->decimal_point);
         free(locinfo->lconv->thousands_sep);
         free(locinfo->lconv->grouping);
-#if _MSVCR_VER >= 100
+#if LCONV_WIDE
         free(locinfo->lconv->_W_decimal_point);
         free(locinfo->lconv->_W_thousands_sep);
 #endif
@@ -1109,7 +1109,7 @@ void free_locinfo(pthreadlocinfo locinfo)
         free(locinfo->lconv->mon_grouping);
         free(locinfo->lconv->positive_sign);
         free(locinfo->lconv->negative_sign);
-#if _MSVCR_VER >= 100
+#if LCONV_WIDE
         free(locinfo->lconv->_W_int_curr_symbol);
         free(locinfo->lconv->_W_currency_symbol);
         free(locinfo->lconv->_W_mon_decimal_point);
@@ -1619,7 +1619,7 @@ static pthreadlocinfo create_locinfo(int category,
             locinfo->lconv->n_sep_by_space = old_locinfo->lconv->n_sep_by_space;
             locinfo->lconv->p_sign_posn = old_locinfo->lconv->p_sign_posn;
             locinfo->lconv->n_sign_posn = old_locinfo->lconv->n_sign_posn;
-#if _MSVCR_VER >= 100
+#if LCONV_WIDE
             locinfo->lconv->_W_int_curr_symbol = old_locinfo->lconv->_W_int_curr_symbol;
             locinfo->lconv->_W_currency_symbol = old_locinfo->lconv->_W_currency_symbol;
             locinfo->lconv->_W_mon_decimal_point = old_locinfo->lconv->_W_mon_decimal_point;
@@ -1766,7 +1766,7 @@ static pthreadlocinfo create_locinfo(int category,
             goto fail;
         }
 
-#if _MSVCR_VER >= 100
+#if LCONV_WIDE
         i = GetLocaleInfoEx(locale_sname[LC_MONETARY], LOCALE_SINTLSYMBOL
                 |LOCALE_NOUSEROVERRIDE, wbuf, 256);
         if(i && (locinfo->lconv->_W_int_curr_symbol = malloc(i * sizeof(wchar_t))))
@@ -1833,7 +1833,7 @@ static pthreadlocinfo create_locinfo(int category,
             locinfo->lconv->p_sign_posn = cloc_lconv.p_sign_posn;
             locinfo->lconv->n_sign_posn = cloc_lconv.n_sign_posn;
 
-#if _MSVCR_VER >= 100
+#if LCONV_WIDE
             locinfo->lconv->_W_int_curr_symbol = cloc_lconv._W_int_curr_symbol;
             locinfo->lconv->_W_currency_symbol = cloc_lconv._W_currency_symbol;
             locinfo->lconv->_W_mon_decimal_point = cloc_lconv._W_mon_decimal_point;
@@ -1864,7 +1864,7 @@ static pthreadlocinfo create_locinfo(int category,
             locinfo->lconv->decimal_point = old_locinfo->lconv->decimal_point;
             locinfo->lconv->thousands_sep = old_locinfo->lconv->thousands_sep;
             locinfo->lconv->grouping = old_locinfo->lconv->grouping;
-#if _MSVCR_VER >= 100
+#if LCONV_WIDE
             locinfo->lconv->_W_decimal_point = old_locinfo->lconv->_W_decimal_point;
             locinfo->lconv->_W_thousands_sep = old_locinfo->lconv->_W_thousands_sep;
 #endif
@@ -1915,7 +1915,7 @@ static pthreadlocinfo create_locinfo(int category,
             goto fail;
         }
 
-#if _MSVCR_VER >= 100
+#if LCONV_WIDE
         i = GetLocaleInfoEx(locale_sname[LC_NUMERIC], LOCALE_SDECIMAL
                 |LOCALE_NOUSEROVERRIDE, wbuf, 256);
         if(i && (locinfo->lconv->_W_decimal_point = malloc(i * sizeof(wchar_t))))
@@ -1938,7 +1938,7 @@ static pthreadlocinfo create_locinfo(int category,
             locinfo->lconv->thousands_sep = cloc_lconv.thousands_sep;
             locinfo->lconv->grouping = cloc_lconv.grouping;
 
-#if _MSVCR_VER >= 100
+#if LCONV_WIDE
             locinfo->lconv->_W_decimal_point = cloc_lconv._W_decimal_point;
             locinfo->lconv->_W_thousands_sep = cloc_lconv._W_thousands_sep;
 #endif
diff --git a/dlls/msvcrt/msvcrt.h b/dlls/msvcrt/msvcrt.h
index 62bbbb0..04840cd 100644
--- a/dlls/msvcrt/msvcrt.h
+++ b/dlls/msvcrt/msvcrt.h
@@ -81,6 +81,13 @@ typedef void (__cdecl *MSVCRT_security_error_handler)(int, void *);
 
 typedef struct {ULONG x80[3];} MSVCRT__LDOUBLE; /* Intel 80 bit FP format has sizeof() 12 */
 
+/* struct lconv has the _W_ members (see locale.h) */
+#if (_MSVCR_VER >= 100 || (_MSVCR_VER == 0 && !defined(_CRTDLL))) && !defined(SG_MUTANT_LCONV_NARROW)
+#define LCONV_WIDE 1
+#else
+#define LCONV_WIDE 0
+#endif
+
 typedef struct __lc_time_data {
     union {
         const char *str[43];
diff --git a/dlls/msvcrt/tests/locale.c b/dlls/msvcrt/tests/locale.c
index 62632ce..f97374a 100644
--- a/dlls/msvcrt/tests/locale.c
+++ b/dlls/msvcrt/tests/locale.c
@@ -977,6 +977,44 @@ static void test_locale_info(void)
     p_free_locale(locale);
 }
 
+static void test_localeconv_wide(void)
+{
+    struct lconv *lc;
+    char *ret;
+
+    /* msvcrt.dll's lconv has the wide members too; programs built for it
+     * (Python's _locale module, for one) read them */
+    ret = setlocale(LC_ALL, "C");
+    ok(ret != NULL, "setlocale failed\n");
+    lc = localeconv();
+    ok(lc->_W_decimal_point != NULL && !wcscmp(lc->_W_decimal_point, L"."),
+       "_W_decimal_point = %s\n", wine_dbgstr_w(lc->_W_decimal_point));
+    ok(lc->_W_thousands_sep != NULL && !lc->_W_thousands_sep[0],
+       "_W_thousands_sep = %s\n", wine_dbgstr_w(lc->_W_thousands_sep));
+    ok(lc->_W_currency_symbol != NULL && !lc->_W_currency_symbol[0],
+       "_W_currency_symbol = %s\n", wine_dbgstr_w(lc->_W_currency_symbol));
+    ok(lc->_W_negative_sign != NULL && !lc->_W_negative_sign[0],
+       "_W_negative_sign = %s\n", wine_dbgstr_w(lc->_W_negative_sign));
+
+    ret = setlocale(LC_ALL, "German");
+    if (!ret)
+    {
+        win_skip("no German locale\n");
+        return;
+    }
+    lc = localeconv();
+    ok(!strcmp(lc->decimal_point, ","), "decimal_point = %s\n", lc->decimal_point);
+    ok(lc->_W_decimal_point != NULL && !wcscmp(lc->_W_decimal_point, L","),
+       "_W_decimal_point = %s\n", wine_dbgstr_w(lc->_W_decimal_point));
+    ok(lc->_W_thousands_sep != NULL && !wcscmp(lc->_W_thousands_sep, L"."),
+       "_W_thousands_sep = %s\n", wine_dbgstr_w(lc->_W_thousands_sep));
+    ok(lc->_W_currency_symbol != NULL && !wcscmp(lc->_W_currency_symbol, L"\x20ac"),
+       "_W_currency_symbol = %s\n", wine_dbgstr_w(lc->_W_currency_symbol));
+    ok(lc->_W_mon_decimal_point != NULL && !wcscmp(lc->_W_mon_decimal_point, L","),
+       "_W_mon_decimal_point = %s\n", wine_dbgstr_w(lc->_W_mon_decimal_point));
+    setlocale(LC_ALL, "C");
+}
+
 START_TEST(locale)
 {
     init();
@@ -988,4 +1026,5 @@ START_TEST(locale)
     test__wcsicmp_l();
     test_thread_setlocale();
     test_locale_info();
+    test_localeconv_wide();
 }
diff --git a/include/msvcrt/locale.h b/include/msvcrt/locale.h
index 8186f17..f5fefdf 100644
--- a/include/msvcrt/locale.h
+++ b/include/msvcrt/locale.h
@@ -53,7 +53,8 @@ struct lconv
     char n_sep_by_space;
     char p_sign_posn;
     char n_sign_posn;
-#if _MSVCR_VER >= 100
+/* msvcrt.dll has the wide members too (as since Windows 7); crtdll does not */
+#if _MSVCR_VER >= 100 || (_MSVCR_VER == 0 && !defined(_CRTDLL))
     wchar_t* _W_decimal_point;
     wchar_t* _W_thousands_sep;
     wchar_t* _W_int_curr_symbol;
