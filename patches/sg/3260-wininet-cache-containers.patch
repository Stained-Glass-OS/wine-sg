From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:36:33 -0700
Subject: [PATCH] wininet: CreateUrlCacheContainer and DeleteUrlCacheContainer
 (3260)

CreateUrlCacheContainer and DeleteUrlCacheContainer were stubs that took
eight and two DWORDs and returned TRUE.

- CreateUrlCacheContainerA/W make a container with the given name and URL
  prefix in the given directory (a directory of its own beside the content
  cache when none is given), with the size limit and type; the options,
  buffer and size parameters are reserved (ERROR_INVALID_PARAMETER when not
  0/NULL). A name already in use gives ERROR_ALREADY_EXISTS. URLs with the
  prefix are kept in the container and FindFirst/NextUrlCacheContainer list
  it under its name. The containers are kept in HKCU\Software\Wine\WinInet\
  CacheContainers and made again when wininet starts.
- DeleteUrlCacheContainerA/W remove such a container by name
  (ERROR_FILE_NOT_FOUND for an unknown name, the three default containers
  included). The cache files are left in place.
- The exports have their real signatures (strings, not DWORDs).

diff --git a/dlls/wininet/urlcache.c b/dlls/wininet/urlcache.c
index 998f78a..e0d7f8a 100644
--- a/dlls/wininet/urlcache.c
+++ b/dlls/wininet/urlcache.c
@@ -182,6 +182,8 @@ typedef struct
     DWORD file_size; /* size of file when mapping was opened */
     HANDLE mutex; /* handle of mutex */
     DWORD default_entry_type;
+    char *name; /* name of a container made by CreateUrlCacheContainer, NULL for the three default ones */
+    DWORD limit_kb; /* its size limit in kilobytes, 0: default */
 } cache_container;
 
 typedef struct
@@ -692,6 +694,8 @@ static BOOL cache_containers_add(const char *cache_prefix, LPCWSTR path,
     pContainer->mapping = NULL;
     pContainer->file_size = 0;
     pContainer->default_entry_type = default_entry_type;
+    pContainer->name = NULL;
+    pContainer->limit_kb = 0;
 
     pContainer->path = wcsdup(path);
     if (!pContainer->path)
@@ -734,6 +738,7 @@ static void cache_container_delete_container(cache_container *pContainer)
     CloseHandle(pContainer->mutex);
     free(pContainer->path);
     free(pContainer->cache_prefix);
+    free(pContainer->name);
     free(pContainer);
 }
 
@@ -3333,38 +3338,231 @@ BOOL WINAPI DeleteUrlCacheEntryW(LPCWSTR lpszUrlName)
     return ret;
 }
 
-BOOL WINAPI DeleteUrlCacheContainerA(DWORD d1, DWORD d2)
+/* Containers made by CreateUrlCacheContainer are kept per user under
+ * HKCU\Software\Wine\WinInet\CacheContainers\<name>: values Prefix, Path, Type, Limit. */
+static const WCHAR container_key_name[] = L"Software\\Wine\\WinInet\\CacheContainers";
+
+static cache_container *find_named_container(const char *name)
+{
+    cache_container *container;
+
+    LIST_FOR_EACH_ENTRY(container, &UrlContainers, cache_container, entry)
+        if (container->name && !_stricmp(container->name, name)) return container;
+    return NULL;
+}
+
+static BOOL create_cache_container(const WCHAR *name, const WCHAR *prefix, const WCHAR *path, DWORD limit_kb,
+        DWORD type, DWORD options, void *buffer, DWORD *size, BOOL persist)
+{
+    WCHAR full[MAX_PATH], mutex_name[MAX_PATH];
+    cache_container *container;
+    char *name_a, *prefix_a;
+    BOOL ret = FALSE;
+    size_t len;
+
+    if (!name || !*name || !prefix || options || buffer || size)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    name_a = strdupWtoUTF8(name);
+    prefix_a = strdupWtoUTF8(prefix);
+    if (!name_a || !prefix_a)
+    {
+        free(name_a);
+        free(prefix_a);
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    if (find_named_container(name_a) || !strcmp(name_a, "Content") || !strcmp(name_a, "History")
+            || !strcmp(name_a, "Cookies"))
+    {
+        SetLastError(ERROR_ALREADY_EXISTS);
+        goto done;
+    }
+
+    if (path && *path)
+        lstrcpynW(full, path, MAX_PATH);
+    else
+    {
+        /* GUESS: a directory of its own beside the content cache */
+        if (!SHGetSpecialFolderPathW(NULL, full, CSIDL_INTERNET_CACHE, TRUE))
+        {
+            SetLastError(ERROR_PATH_NOT_FOUND);
+            goto done;
+        }
+        len = lstrlenW(full);
+        if (len + lstrlenW(name) + 2 > MAX_PATH) { SetLastError(ERROR_FILENAME_EXCED_RANGE); goto done; }
+        full[len++] = '\\';
+        lstrcpyW(full + len, name);
+    }
+    len = lstrlenW(full);
+    if (len + 2 > MAX_PATH) { SetLastError(ERROR_FILENAME_EXCED_RANGE); goto done; }
+    if (full[len - 1] != '\\') { full[len++] = '\\'; full[len] = 0; }
+    if (!CreateDirectoryW(full, NULL) && GetLastError() != ERROR_ALREADY_EXISTS) goto done;
+
+    lstrcpyW(mutex_name, full);
+    if (!cache_containers_add(prefix_a, full, type, mutex_name)) { SetLastError(ERROR_OUTOFMEMORY); goto done; }
+    container = LIST_ENTRY(list_head(&UrlContainers), cache_container, entry);
+    container->name = name_a;
+    name_a = NULL;
+    container->limit_kb = limit_kb;
+    ret = TRUE;
+
+    if (persist)
+    {
+        HKEY root, key;
+
+        if (!RegCreateKeyExW(HKEY_CURRENT_USER, container_key_name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &root, NULL))
+        {
+            if (!RegCreateKeyExW(root, name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL))
+            {
+                RegSetValueExW(key, L"Prefix", 0, REG_SZ, (const BYTE *)prefix, (lstrlenW(prefix) + 1) * sizeof(WCHAR));
+                RegSetValueExW(key, L"Path", 0, REG_SZ, (const BYTE *)full, (lstrlenW(full) + 1) * sizeof(WCHAR));
+                RegSetValueExW(key, L"Type", 0, REG_DWORD, (const BYTE *)&type, sizeof(type));
+                RegSetValueExW(key, L"Limit", 0, REG_DWORD, (const BYTE *)&limit_kb, sizeof(limit_kb));
+                RegCloseKey(key);
+            }
+            RegCloseKey(root);
+        }
+    }
+done:
+    free(name_a);
+    free(prefix_a);
+    return ret;
+}
+
+/* the containers a user made earlier */
+static void load_cache_containers(void)
 {
-    FIXME("(0x%08lx, 0x%08lx) stub\n", d1, d2);
+    WCHAR name[MAX_PATH], prefix[MAX_PATH], path[MAX_PATH];
+    HKEY root, key;
+    DWORD i, size, type, limit;
+
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, container_key_name, 0, KEY_READ, &root)) return;
+    for (i = 0; !RegEnumKeyW(root, i, name, ARRAY_SIZE(name)); i++)
+    {
+        if (RegOpenKeyExW(root, name, 0, KEY_READ, &key)) continue;
+        size = sizeof(prefix);
+        if (RegQueryValueExW(key, L"Prefix", NULL, NULL, (BYTE *)prefix, &size)) goto next;
+        size = sizeof(path);
+        if (RegQueryValueExW(key, L"Path", NULL, NULL, (BYTE *)path, &size)) goto next;
+        size = sizeof(type);
+        if (RegQueryValueExW(key, L"Type", NULL, NULL, (BYTE *)&type, &size)) type = NORMAL_CACHE_ENTRY;
+        size = sizeof(limit);
+        if (RegQueryValueExW(key, L"Limit", NULL, NULL, (BYTE *)&limit, &size)) limit = 0;
+        create_cache_container(name, prefix, path, limit, type, 0, NULL, NULL, FALSE);
+    next:
+        RegCloseKey(key);
+    }
+    RegCloseKey(root);
+}
+
+static BOOL delete_cache_container(const WCHAR *name, DWORD options)
+{
+    cache_container *container;
+    char *name_a;
+    HKEY root;
+
+    if (!name || !*name || options)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(name_a = strdupWtoUTF8(name)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    container = find_named_container(name_a);
+    free(name_a);
+    if (!container)
+    {
+        /* the three default containers cannot be deleted either */
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return FALSE;
+    }
+    cache_container_delete_container(container);
+    if (!RegOpenKeyExW(HKEY_CURRENT_USER, container_key_name, 0, KEY_ALL_ACCESS, &root))
+    {
+        RegDeleteKeyW(root, name);
+        RegCloseKey(root);
+    }
     return TRUE;
 }
 
-BOOL WINAPI DeleteUrlCacheContainerW(DWORD d1, DWORD d2)
+/***********************************************************************
+ *           DeleteUrlCacheContainerA (WININET.@)
+ */
+BOOL WINAPI DeleteUrlCacheContainerA(const char *name, DWORD options)
 {
-    FIXME("(0x%08lx, 0x%08lx) stub\n", d1, d2);
+    WCHAR *nameW = NULL;
+    BOOL ret;
+
+    TRACE("(%s, 0x%08lx)\n", debugstr_a(name), options);
+#ifdef SG_MUTANT_WININET_CONTAINER
     return TRUE;
+#endif
+    if (name && !(nameW = strdupAtoW(name)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    ret = delete_cache_container(nameW, options);
+    free(nameW);
+    return ret;
 }
 
 /***********************************************************************
- *           CreateCacheContainerA (WININET.@)
+ *           DeleteUrlCacheContainerW (WININET.@)
  */
-BOOL WINAPI CreateUrlCacheContainerA(DWORD d1, DWORD d2, DWORD d3, DWORD d4,
-                                     DWORD d5, DWORD d6, DWORD d7, DWORD d8)
+BOOL WINAPI DeleteUrlCacheContainerW(const WCHAR *name, DWORD options)
 {
-    FIXME("(0x%08lx, 0x%08lx, 0x%08lx, 0x%08lx, 0x%08lx, 0x%08lx, 0x%08lx, 0x%08lx) stub\n",
-          d1, d2, d3, d4, d5, d6, d7, d8);
+    TRACE("(%s, 0x%08lx)\n", debugstr_w(name), options);
+#ifdef SG_MUTANT_WININET_CONTAINER
     return TRUE;
+#endif
+    return delete_cache_container(name, options);
 }
 
 /***********************************************************************
- *           CreateCacheContainerW (WININET.@)
+ *           CreateUrlCacheContainerA (WININET.@)
  */
-BOOL WINAPI CreateUrlCacheContainerW(DWORD d1, DWORD d2, DWORD d3, DWORD d4,
-                                     DWORD d5, DWORD d6, DWORD d7, DWORD d8)
+BOOL WINAPI CreateUrlCacheContainerA(const char *name, const char *prefix, const char *path, DWORD limit_kb,
+                                     DWORD type, DWORD options, void *buffer, DWORD *size)
 {
-    FIXME("(0x%08lx, 0x%08lx, 0x%08lx, 0x%08lx, 0x%08lx, 0x%08lx, 0x%08lx, 0x%08lx) stub\n",
-          d1, d2, d3, d4, d5, d6, d7, d8);
+    WCHAR *nameW = NULL, *prefixW = NULL, *pathW = NULL;
+    BOOL ret = FALSE;
+
+    TRACE("(%s, %s, %s, %lu, 0x%08lx, 0x%08lx, %p, %p)\n", debugstr_a(name), debugstr_a(prefix), debugstr_a(path),
+          limit_kb, type, options, buffer, size);
+#ifdef SG_MUTANT_WININET_CONTAINER
     return TRUE;
+#endif
+    if ((name && !(nameW = strdupAtoW(name))) || (prefix && !(prefixW = strdupAtoW(prefix)))
+            || (path && !(pathW = strdupAtoW(path))))
+        SetLastError(ERROR_OUTOFMEMORY);
+    else
+        ret = create_cache_container(nameW, prefixW, pathW, limit_kb, type, options, buffer, size, TRUE);
+    free(nameW);
+    free(prefixW);
+    free(pathW);
+    return ret;
+}
+
+/***********************************************************************
+ *           CreateUrlCacheContainerW (WININET.@)
+ */
+BOOL WINAPI CreateUrlCacheContainerW(const WCHAR *name, const WCHAR *prefix, const WCHAR *path, DWORD limit_kb,
+                                     DWORD type, DWORD options, void *buffer, DWORD *size)
+{
+    TRACE("(%s, %s, %s, %lu, 0x%08lx, 0x%08lx, %p, %p)\n", debugstr_w(name), debugstr_w(prefix), debugstr_w(path),
+          limit_kb, type, options, buffer, size);
+#ifdef SG_MUTANT_WININET_CONTAINER
+    return TRUE;
+#endif
+    return create_cache_container(name, prefix, path, limit_kb, type, options, buffer, size, TRUE);
 }
 
 /* INTERNET_CACHE_CONTAINER_INFO of the documentation */
@@ -3390,6 +3588,7 @@ typedef struct
 
 static const char *container_name(const cache_container *container)
 {
+    if (container->name) return container->name;
     if (container->default_entry_type & COOKIE_CACHE_ENTRY) return "Cookies";
     if (container->default_entry_type & URLHISTORY_CACHE_ENTRY) return "History";
     return "Content";
@@ -4788,6 +4987,7 @@ BOOL init_urlcache(void)
     }
 
     cache_containers_init();
+    load_cache_containers();
     return TRUE;
 }
 
