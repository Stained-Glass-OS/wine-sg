-@ stdcall CreateUrlCacheContainerW(long long long long long long long long)
+@ stdcall CreateUrlCacheContainerA(str str str long long long ptr ptr)
+@ stdcall CreateUrlCacheContainerW(wstr wstr wstr long long long ptr ptr)
 @ stdcall CreateUrlCacheEntryA(str long str ptr long)
