 @ stdcall CommitUrlCacheEntryA(str str int64 int64 long str long str str)
 @ stdcall CommitUrlCacheEntryW(wstr wstr int64 int64 long wstr long wstr wstr)
 @ stdcall CreateMD5SSOHash(wstr wstr wstr ptr)
