From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: the DirectSound renderer catches up when its samples run late

A sound device a little slower than the system clock made every sample late
and, taken as continuous, the lag grew all through a long film: the audio
fell behind the picture until a seek. Past 80 ms late, as much of a sample
as it is late (less 20 ms) is left out. Field report 2026-10-17.
---
--- a/dlls/quartz/dsoundrender.c
+++ b/dlls/quartz/dsoundrender.c
@@ -162,12 +162,13 @@
 }
 
 static HRESULT get_write_pos(struct dsound_render *filter,
-        DWORD *ret_writepos, REFERENCE_TIME write_at, DWORD *pfree)
+        DWORD *ret_writepos, REFERENCE_TIME write_at, DWORD *pfree, REFERENCE_TIME *late)
 {
     DWORD writepos, min_writepos, playpos;
     REFERENCE_TIME max_lag = 50 * 10000;
     REFERENCE_TIME cur, writepos_t, delta_t;
 
+    *late = 0;
     update_positions(filter, &writepos, &min_writepos);
     playpos = filter->last_playpos;
     if (filter->filter.clock)
@@ -209,6 +210,7 @@
         TRACE("Difference %s is less than threshold %s; treating sample as continuous.\n",
                 debugstr_time(delta_t), debugstr_time(max_lag));
         *ret_writepos = writepos;
+        if (delta_t < 0) *late = -delta_t;
     }
     else
     {
@@ -244,11 +246,32 @@
         DWORD writepos, free, size1, size2;
         BYTE *buf1, *buf2;
 
+        REFERENCE_TIME late = 0;
+
         if (filter->filter.state == State_Running)
-            hr = get_write_pos(filter, &writepos, tStart, &free);
+            hr = get_write_pos(filter, &writepos, tStart, &free, &late);
         else
             hr = S_FALSE;
 
+        /* Stained Glass: the sample is late against the clock -- the sound
+         * device plays a little slower than the system clock the graph runs
+         * on, and taking every late sample as continuous let the lag grow
+         * all through a long film (audio behind the picture until a seek).
+         * Past 80 ms late, as much of the sample as it is late (less 20 ms)
+         * is left out, and the sound is back in time. */
+#ifndef SG_MUTANT_AUDIO_DRIFTS
+        if (hr == S_OK && data && late > 80 * 10000)
+        {
+            DWORD skip = pos_from_time(filter, late - 20 * 10000);
+            TRACE("Sample %s late; skipping %lu bytes.\n", debugstr_time(late), skip);
+            if (skip >= size) return S_OK;
+            data += skip;
+            size -= skip;
+            tStart += time_from_pos(filter, skip);
+            continue;
+        }
+#endif
+
         if (hr != S_OK)
         {
             if (!WaitForSingleObject(filter->flush_event, 10))
