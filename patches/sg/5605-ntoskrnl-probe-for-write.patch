From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntoskrnl.exe: ProbeForWrite and ProbeForRead

ntoskrnl.exe: ProbeForWrite, ProbeForRead, ExRaiseAccessViolation, ExRaiseDatatypeMisalignment

The probe routines check alignment and the user-mode address range and touch
every page of the buffer, raising STATUS_DATATYPE_MISALIGNMENT or
STATUS_ACCESS_VIOLATION as documented.
---
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -4197,12 +4197,59 @@ void WINAPI KeBugCheckEx(ULONG code, ULONG_PTR param1, ULONG_PTR param2, ULONG_P
     ExitProcess( code );
 }
 
+/***********************************************************************
+ *           ExRaiseAccessViolation   (NTOSKRNL.EXE.@)
+ */
+void WINAPI ExRaiseAccessViolation(void)
+{
+    RtlRaiseStatus( STATUS_ACCESS_VIOLATION );
+}
+
+/***********************************************************************
+ *           ExRaiseDatatypeMisalignment   (NTOSKRNL.EXE.@)
+ */
+void WINAPI ExRaiseDatatypeMisalignment(void)
+{
+    RtlRaiseStatus( STATUS_DATATYPE_MISALIGNMENT );
+}
+
+/* a buffer handed in by user mode: aligned as asked, wholly inside the user
+ * address range, and every page of it accessible */
+static void probe_user_buffer( void *address, SIZE_T length, ULONG alignment, BOOL write )
+{
+    static ULONG_PTR user_limit;
+    ULONG_PTR start = (ULONG_PTR)address, end;
+    volatile char *page;
+
+    if (!length) return;
+    if (alignment && (start & (alignment - 1))) ExRaiseDatatypeMisalignment();
+    if (!user_limit)
+    {
+        SYSTEM_BASIC_INFORMATION info;
+        if (!NtQuerySystemInformation( SystemBasicInformation, &info, sizeof(info), NULL ))
+            user_limit = (ULONG_PTR)info.HighestUserAddress;
+    }
+    end = start + length;
+    if (end < start || end - 1 > user_limit) ExRaiseAccessViolation();
+
+#ifdef SG_MUTANT_PROBE_NO_TOUCH
+    return;
+#endif
+    for (page = (volatile char *)address;; page = (volatile char *)(((ULONG_PTR)page & ~(ULONG_PTR)0xfff) + 0x1000))
+    {
+        char value = *page;
+        if (write) *page = value;
+        if ((ULONG_PTR)page >= ((end - 1) & ~(ULONG_PTR)0xfff)) break;
+    }
+}
+
 /***********************************************************************
  *           ProbeForRead   (NTOSKRNL.EXE.@)
  */
 void WINAPI ProbeForRead(void *address, SIZE_T length, ULONG alignment)
 {
-    FIXME("(%p %Iu %lu) stub\n", address, length, alignment);
+    TRACE( "(%p %Iu %lu)\n", address, length, alignment );
+    probe_user_buffer( address, length, alignment, FALSE );
 }
 
 /***********************************************************************
@@ -4210,7 +4257,8 @@ void WINAPI ProbeForRead(void *address, SIZE_T length, ULONG alignment)
  */
 void WINAPI ProbeForWrite(void *address, SIZE_T length, ULONG alignment)
 {
-    FIXME("(%p %Iu %lu) stub\n", address, length, alignment);
+    TRACE( "(%p %Iu %lu)\n", address, length, alignment );
+    probe_user_buffer( address, length, alignment, TRUE );
 }
 
 /***********************************************************************
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -181,8 +181,8 @@
 @ stdcall ExNotifyCallback(ptr ptr ptr)
 @ stub ExQueryPoolBlockSize
 @ stub ExQueueWorkItem
-@ stub ExRaiseAccessViolation
-@ stub ExRaiseDatatypeMisalignment
+@ stdcall ExRaiseAccessViolation()
+@ stdcall ExRaiseDatatypeMisalignment()
 @ stub ExRaiseException
 @ stub ExRaiseHardError
 @ stub ExRaiseStatus
--- a/dlls/ntoskrnl.exe/tests/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/tests/ntoskrnl.c
@@ -45,6 +45,7 @@
 #include "ddk/hidpi.h"
 #include "wine/test.h"
 #include "wine/mssign.h"
+#include "wine/exception.h"
 
 #include "driver.h"
 
@@ -1879,6 +1880,136 @@ static void test_pnp_driver(struct testsign_context *ctx)
     SetCurrentDirectoryA(cwd);
 }
 
+static DWORD probe_code;
+
+static LONG WINAPI probe_filter(EXCEPTION_POINTERS *info)
+{
+    probe_code = info->ExceptionRecord->ExceptionCode;
+    return EXCEPTION_EXECUTE_HANDLER;
+}
+
+#define call_probe(func, addr, len, align) \
+    do { probe_code = 0; __TRY { func((addr), (len), (align)); } __EXCEPT(probe_filter) { } __ENDTRY } while (0)
+
+static void test_ProbeForWrite(void)
+{
+    void (WINAPI *pProbeForRead)(void *, SIZE_T, ULONG);
+    void (WINAPI *pProbeForWrite)(void *, SIZE_T, ULONG);
+    void (WINAPI *pExRaiseAccessViolation)(void);
+    void (WINAPI *pExRaiseDatatypeMisalignment)(void);
+    SYSTEM_INFO si;
+    HMODULE module;
+    char *rw, *ro, *mixed;
+    DWORD old;
+    unsigned int i;
+
+    module = LoadLibraryA("ntoskrnl.exe");
+    if (!module)
+    {
+        win_skip("ntoskrnl.exe cannot be loaded\n");
+        return;
+    }
+    pProbeForRead = (void *)GetProcAddress(module, "ProbeForRead");
+    pProbeForWrite = (void *)GetProcAddress(module, "ProbeForWrite");
+    pExRaiseAccessViolation = (void *)GetProcAddress(module, "ExRaiseAccessViolation");
+    pExRaiseDatatypeMisalignment = (void *)GetProcAddress(module, "ExRaiseDatatypeMisalignment");
+    if (!pProbeForWrite || !pProbeForRead)
+    {
+        win_skip("no probe functions\n");
+        return;
+    }
+    GetSystemInfo(&si);
+
+    rw = VirtualAlloc(NULL, 3 * si.dwPageSize, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+    ok(!!rw, "VirtualAlloc failed: %lu\n", GetLastError());
+    for (i = 0; i < 3 * si.dwPageSize; i++) rw[i] = i * 7;
+
+    /* a buffer that can be written, and is left as it was */
+    call_probe(pProbeForWrite, rw, 3 * si.dwPageSize, 1);
+    ok(!probe_code, "got exception %#lx\n", probe_code);
+    for (i = 0; i < 3 * si.dwPageSize; i++) if (rw[i] != (char)(i * 7)) break;
+    ok(i == 3 * si.dwPageSize, "the buffer changed at %u\n", i);
+    call_probe(pProbeForWrite, rw + 8, 100, 8);
+    ok(!probe_code, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForRead, rw + 8, 100, 8);
+    ok(!probe_code, "got exception %#lx\n", probe_code);
+
+    /* nothing to check */
+    call_probe(pProbeForWrite, NULL, 0, 1);
+    ok(!probe_code, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForWrite, (void *)~(ULONG_PTR)0, 0, 8);
+    ok(!probe_code, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForWrite, rw + 1, 0, 8);
+    ok(!probe_code, "got exception %#lx\n", probe_code);
+
+    /* alignment */
+    call_probe(pProbeForWrite, rw + 1, 4, 4);
+    ok(probe_code == STATUS_DATATYPE_MISALIGNMENT, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForWrite, rw + 2, 4, 2);
+    ok(!probe_code, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForWrite, rw + 4, 4, 8);
+    ok(probe_code == STATUS_DATATYPE_MISALIGNMENT, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForRead, rw + 1, 4, 4);
+    ok(probe_code == STATUS_DATATYPE_MISALIGNMENT, "got exception %#lx\n", probe_code);
+
+    /* outside the user address range, or wrapping */
+    call_probe(pProbeForWrite, (char *)~(ULONG_PTR)0 - 0xff, 0x100, 1);
+    ok(probe_code == STATUS_ACCESS_VIOLATION, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForWrite, (char *)~(ULONG_PTR)0 - 0xf, 0x100, 1);
+    ok(probe_code == STATUS_ACCESS_VIOLATION, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForWrite, rw, ~(SIZE_T)0, 1);
+    ok(probe_code == STATUS_ACCESS_VIOLATION, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForRead, (char *)si.lpMaximumApplicationAddress + 1, 1, 1);
+    ok(probe_code == STATUS_ACCESS_VIOLATION, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForWrite, (char *)si.lpMaximumApplicationAddress - 0x10, 0x20, 1);
+    ok(probe_code == STATUS_ACCESS_VIOLATION, "got exception %#lx\n", probe_code);
+
+    /* pages that cannot be written (reading is not enough to write) */
+    ro = VirtualAlloc(NULL, si.dwPageSize, MEM_COMMIT | MEM_RESERVE, PAGE_READONLY);
+    ok(!!ro, "VirtualAlloc failed: %lu\n", GetLastError());
+    call_probe(pProbeForWrite, ro, 16, 1);
+    ok(probe_code == STATUS_ACCESS_VIOLATION, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForRead, ro, 16, 1);
+    ok(!probe_code, "got exception %#lx\n", probe_code);
+
+    /* every page of the buffer counts, the first and the last too */
+    mixed = VirtualAlloc(NULL, 3 * si.dwPageSize, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+    ok(VirtualProtect(mixed + 2 * si.dwPageSize, si.dwPageSize, PAGE_NOACCESS, &old), "VirtualProtect failed\n");
+    call_probe(pProbeForWrite, mixed, 2 * si.dwPageSize, 1);
+    ok(!probe_code, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForWrite, mixed + si.dwPageSize + 0x10, si.dwPageSize - 0x10, 1);
+    ok(!probe_code, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForWrite, mixed, 2 * si.dwPageSize + 1, 1);
+    ok(probe_code == STATUS_ACCESS_VIOLATION, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForRead, mixed + 0x10, 3 * si.dwPageSize - 0x20, 1);
+    ok(probe_code == STATUS_ACCESS_VIOLATION, "got exception %#lx\n", probe_code);
+    ok(VirtualProtect(mixed, si.dwPageSize, PAGE_READONLY, &old), "VirtualProtect failed\n");
+    call_probe(pProbeForWrite, mixed, 2 * si.dwPageSize, 1);
+    ok(probe_code == STATUS_ACCESS_VIOLATION, "got exception %#lx\n", probe_code);
+    call_probe(pProbeForWrite, mixed + si.dwPageSize, si.dwPageSize, 1);
+    ok(!probe_code, "got exception %#lx\n", probe_code);
+
+    /* the exceptions themselves */
+    if (pExRaiseAccessViolation)
+    {
+        probe_code = 0;
+        __TRY { pExRaiseAccessViolation(); } __EXCEPT(probe_filter) { } __ENDTRY
+        ok(probe_code == STATUS_ACCESS_VIOLATION, "got exception %#lx\n", probe_code);
+    }
+    if (pExRaiseDatatypeMisalignment)
+    {
+        probe_code = 0;
+        __TRY { pExRaiseDatatypeMisalignment(); } __EXCEPT(probe_filter) { } __ENDTRY
+        ok(probe_code == STATUS_DATATYPE_MISALIGNMENT, "got exception %#lx\n", probe_code);
+    }
+
+    VirtualFree(rw, 0, MEM_RELEASE);
+    VirtualFree(ro, 0, MEM_RELEASE);
+    VirtualFree(mixed, 0, MEM_RELEASE);
+    FreeLibrary(module);
+}
+
+
 START_TEST(ntoskrnl)
 {
     WCHAR filename[MAX_PATH], filename2[MAX_PATH];
@@ -1888,6 +2019,8 @@ START_TEST(ntoskrnl)
     HANDLE mapping;
     DWORD written;
 
+    test_ProbeForWrite();
+
     pRtlDosPathNameToNtPathName_U = (void *)GetProcAddress(GetModuleHandleA("ntdll"), "RtlDosPathNameToNtPathName_U");
     pRtlFreeUnicodeString = (void *)GetProcAddress(GetModuleHandleA("ntdll"), "RtlFreeUnicodeString");
     pCancelIoEx = (void *)GetProcAddress(GetModuleHandleA("kernel32.dll"), "CancelIoEx");
