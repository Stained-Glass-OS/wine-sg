+/* the bytes, shared by a stream and its clones */
+struct stream_data
+{
+    LONG ref;
+    CRITICAL_SECTION cs;
+    BYTE *bytes;
+    UINT64 size;
+    UINT64 capacity;
+};
+
+static void stream_data_release( struct stream_data *data )
+{
+    if (InterlockedDecrement( &data->ref )) return;
+    data->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &data->cs );
+    free( data->bytes );
+    free( data );
+}
+
+/* the caller holds data->cs */
+static BOOL stream_data_reserve( struct stream_data *data, UINT64 size )
+{
+    UINT64 capacity = max( data->capacity * 2, 256 );
+    BYTE *bytes;
+
+    if (size <= data->capacity) return TRUE;
+    if (size > 0x7fffffff) return FALSE;
+    while (capacity < size) capacity *= 2;
+    if (!(bytes = realloc( data->bytes, capacity ))) return FALSE;
+    memset( bytes + data->capacity, 0, capacity - data->capacity );
+    data->bytes = bytes;
+    data->capacity = capacity;
+    return TRUE;
+}
