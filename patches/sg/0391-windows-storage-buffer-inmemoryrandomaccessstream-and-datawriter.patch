+/* the string in the writer's encoding; its length in code units */
+static HRESULT encode_string( struct data_writer *impl, HSTRING value, BOOL write, UINT32 *count )
+{
+    UINT32 length, i;
+    const WCHAR *str = WindowsGetStringRawBuffer( value, &length );
+    HRESULT hr = S_OK;
+    char *utf8;
+    int size;
+
+    if (impl->encoding != UnicodeEncoding_Utf8)
+    {
+        *count = length;
+        if (!write) return S_OK;
+        if (impl->encoding == UnicodeEncoding_Utf16LE) return append( impl, str, length * sizeof(WCHAR) );
+        for (i = 0; i < length && SUCCEEDED(hr); ++i)
+        {
+            BYTE be[2] = { str[i] >> 8, str[i] & 0xff };
+            hr = append( impl, be, 2 );
+        }
+        return hr;
+    }
+
+    size = length ? WideCharToMultiByte( CP_UTF8, 0, str, length, NULL, 0, NULL, NULL ) : 0;
+    *count = size;
+    if (!write || !size) return S_OK;
+    if (!(utf8 = malloc( size ))) return E_OUTOFMEMORY;
+    WideCharToMultiByte( CP_UTF8, 0, str, length, utf8, size, NULL, NULL );
+    hr = append( impl, utf8, size );
+    free( utf8 );
+    return hr;
+}
+
+static HRESULT WINAPI writer_WriteString( IDataWriter *iface, HSTRING value, UINT32 *code_unit_count )
+{
+    TRACE( "iface %p, value %s, code_unit_count %p.\n", iface, debugstr_hstring( value ), code_unit_count );
+    if (!code_unit_count) return E_POINTER;
+    return encode_string( impl_from_IDataWriter( iface ), value, TRUE, code_unit_count );
+}
