+/* waits for another stream's write to finish */
+struct write_wait
+{
+    IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 iface;
+    LONG ref;
+    HANDLE event;
+};
+
+static struct write_wait *impl_from_write_wait( IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *iface )
+{
+    return CONTAINING_RECORD( iface, struct write_wait, iface );
+}
+
+static HRESULT WINAPI write_wait_QueryInterface( IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *iface,
+                                                 REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 ))
+    {
+        InterlockedIncrement( &impl_from_write_wait( iface )->ref );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI write_wait_AddRef( IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *iface )
+{
+    return InterlockedIncrement( &impl_from_write_wait( iface )->ref );
+}
+
+static ULONG WINAPI write_wait_Release( IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *iface )
+{
+    struct write_wait *impl = impl_from_write_wait( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        CloseHandle( impl->event );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI write_wait_Invoke( IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *iface,
+                                         IAsyncOperationWithProgress_UINT32_UINT32 *operation, AsyncStatus status )
+{
+    SetEvent( impl_from_write_wait( iface )->event );
+    return S_OK;
+}
+
+static const struct IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32Vtbl write_wait_vtbl =
+{
+    write_wait_QueryInterface,
+    write_wait_AddRef,
+    write_wait_Release,
+    write_wait_Invoke,
+};
+
+static HRESULT store( struct data_writer *impl, UINT32 *stored )
+{
+    IAsyncOperationWithProgress_UINT32_UINT32 *operation;
+    struct write_wait *wait;
+    IBuffer *buffer;
+    BYTE *bytes;
+    HRESULT hr;
+
+    *stored = 0;
+    if (!impl->length) return S_OK;
+    if (FAILED(hr = buffer_create( impl->length, &buffer ))) return hr;
+    buffer_get_bytes( buffer, &bytes, NULL, NULL );
+    memcpy( bytes, impl->bytes, impl->length );
+    IBuffer_put_Length( buffer, impl->length );
+
+    hr = IOutputStream_WriteAsync( impl->stream, buffer, &operation );
+    IBuffer_Release( buffer );
+    if (FAILED(hr)) return hr;
+
+    if (!(wait = calloc( 1, sizeof(*wait) )))
+    {
+        IAsyncOperationWithProgress_UINT32_UINT32_Release( operation );
+        return E_OUTOFMEMORY;
+    }
+    wait->iface.lpVtbl = &write_wait_vtbl;
+    wait->ref = 1;
+    wait->event = CreateEventW( NULL, TRUE, FALSE, NULL );
+    if (SUCCEEDED(hr = IAsyncOperationWithProgress_UINT32_UINT32_put_Completed( operation, &wait->iface )))
+    {
+        WaitForSingleObject( wait->event, INFINITE );
+        hr = IAsyncOperationWithProgress_UINT32_UINT32_GetResults( operation, stored );
+    }
+    IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32_Release( &wait->iface );
+    IAsyncOperationWithProgress_UINT32_UINT32_Release( operation );
+    if (FAILED(hr)) return hr;
+
+    /* what was stored leaves the buffer */
+    if (*stored > impl->length) *stored = impl->length;
+    memmove( impl->bytes, impl->bytes + *stored, impl->length - *stored );
+    impl->length -= *stored;
+    return S_OK;
+}
+
+static HRESULT WINAPI writer_StoreAsync( IDataWriter *iface, IAsyncOperation_UINT32 **operation )
+{
+    struct data_writer *impl = impl_from_IDataWriter( iface );
+    UINT32 stored;
+    HRESULT hr;
+
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    if (!operation) return E_POINTER;
+    /* a writer without a stream has nowhere to store to */
+    if (!impl->stream) return E_ILLEGAL_METHOD_CALL;
+    hr = store( impl, &stored );
+    return async_uint32_create( stored, hr, operation );
+}
+
+static HRESULT WINAPI writer_FlushAsync( IDataWriter *iface, IAsyncOperation_boolean **operation )
+{
+    struct data_writer *impl = impl_from_IDataWriter( iface );
+
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    if (!operation) return E_POINTER;
+    if (!impl->stream) return E_ILLEGAL_METHOD_CALL;
+    return IOutputStream_FlushAsync( impl->stream, operation );
+}
+
+static HRESULT WINAPI writer_DetachBuffer( IDataWriter *iface, IBuffer **buffer )
+{
+    struct data_writer *impl = impl_from_IDataWriter( iface );
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE( "iface %p, buffer %p.\n", iface, buffer );
+
+    if (!buffer) return E_POINTER;
+    if (FAILED(hr = buffer_create( impl->length, buffer ))) return hr;
+    buffer_get_bytes( *buffer, &bytes, NULL, NULL );
+    memcpy( bytes, impl->bytes, impl->length );
+    IBuffer_put_Length( *buffer, impl->length );
+    impl->length = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI writer_DetachStream( IDataWriter *iface, IOutputStream **output_stream )
+{
+    struct data_writer *impl = impl_from_IDataWriter( iface );
+
+    TRACE( "iface %p, output_stream %p.\n", iface, output_stream );
+
+    if (!output_stream) return E_POINTER;
+    *output_stream = impl->stream;
+    impl->stream = NULL;
+    return S_OK;
+}
