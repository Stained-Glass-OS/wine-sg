+static HRESULT memory_stream_create( struct stream_data *data, UINT64 position, IRandomAccessStream **out )
+{
+    struct memory_stream *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (!data)
+    {
+        if (!(data = calloc( 1, sizeof(*data) )))
+        {
+            free( impl );
+            return E_OUTOFMEMORY;
+        }
+        data->ref = 1;
+        InitializeCriticalSectionEx( &data->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+        data->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": stream_data.cs");
+    }
+    else InterlockedIncrement( &data->ref );
+
+    impl->IRandomAccessStream_iface.lpVtbl = &stream_vtbl;
+    impl->IInputStream_iface.lpVtbl = &input_stream_vtbl;
+    impl->IOutputStream_iface.lpVtbl = &output_stream_vtbl;
+    impl->IClosable_iface.lpVtbl = &stream_closable_vtbl;
+    impl->ref = 1;
+    impl->data = data;
+    impl->position = position;
+    *out = &impl->IRandomAccessStream_iface;
+    return S_OK;
+}
