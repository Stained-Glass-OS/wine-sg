+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(storage);
+
+/*
+ * The operations here are done by the time they are handed out (the data
+ * is in memory), so each one starts Completed (or Error) and a Completed
+ * handler set on it is called at once, as WinRT does for an operation that
+ * has already finished.
+ */
+
+enum async_kind { ASYNC_UINT32, ASYNC_BOOLEAN, ASYNC_WRITE, ASYNC_READ };
+
+struct async
+{
+    IInspectable op_iface;         /* the kind's IAsyncOperation[WithProgress] */
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    enum async_kind kind;
+    HRESULT hr;
+    UINT32 u32;
+    boolean b;
+    IBuffer *buffer;
+    IUnknown *handler;
+    BOOL closed;
+};
+
+static const GUID *async_iid( enum async_kind kind )
+{
+    switch (kind)
+    {
+    case ASYNC_UINT32: return &IID_IAsyncOperation_UINT32;
+    case ASYNC_BOOLEAN: return &IID_IAsyncOperation_boolean;
+    case ASYNC_WRITE: return &IID_IAsyncOperationWithProgress_UINT32_UINT32;
+    case ASYNC_READ: return &IID_IAsyncOperationWithProgress_IBuffer_UINT32;
+    }
+    return &IID_IUnknown;
+}
+
+static struct async *impl_from_op( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct async, op_iface );
+}
+
+static HRESULT WINAPI op_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct async *impl = impl_from_op( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, async_iid( impl->kind ) ))
+    {
+        IInspectable_AddRef( (*out = &impl->op_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+    {
+        IAsyncInfo_AddRef( (*out = &impl->IAsyncInfo_iface) );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI op_AddRef( IInspectable *iface )
+{
+    struct async *impl = impl_from_op( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI op_Release( IInspectable *iface )
+{
+    struct async *impl = impl_from_op( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->handler) IUnknown_Release( impl->handler );
+        if (impl->buffer) IBuffer_Release( impl->buffer );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI op_GetIids( IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI op_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI op_GetTrustLevel( IInspectable *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static AsyncStatus async_status( struct async *impl )
+{
+    return SUCCEEDED(impl->hr) ? Completed : Error;
+}
+
+/* every Completed handler's Invoke is (this, operation, status) */
+typedef HRESULT (WINAPI *handler_invoke)( IUnknown *handler, void *operation, AsyncStatus status );
+
+static HRESULT op_put_Completed( IInspectable *iface, IUnknown *handler )
+{
+    struct async *impl = impl_from_op( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return S_OK;
+    impl->handler = handler;
+    IUnknown_AddRef( handler );
+    ((handler_invoke)(*(void ***)handler)[3])( handler, &impl->op_iface, async_status( impl ) );
+    return S_OK;
+}
+
+static HRESULT op_get_Completed( IInspectable *iface, IUnknown **handler )
+{
+    struct async *impl = impl_from_op( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if ((*handler = impl->handler)) IUnknown_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT op_check_results( struct async *impl )
+{
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    return impl->hr;
+}
+
+/* IAsyncOperation<UINT32> */
+static HRESULT WINAPI u32_put_Completed( IAsyncOperation_UINT32 *iface, IAsyncOperationCompletedHandler_UINT32 *handler )
+{
+    return op_put_Completed( (IInspectable *)iface, (IUnknown *)handler );
+}
+static HRESULT WINAPI u32_get_Completed( IAsyncOperation_UINT32 *iface, IAsyncOperationCompletedHandler_UINT32 **handler )
+{
+    return op_get_Completed( (IInspectable *)iface, (IUnknown **)handler );
+}
+static HRESULT WINAPI u32_GetResults( IAsyncOperation_UINT32 *iface, UINT32 *results )
+{
+    struct async *impl = impl_from_op( iface );
+    HRESULT hr = op_check_results( impl );
+    TRACE( "iface %p, results %p.\n", iface, results );
+    *results = SUCCEEDED(hr) ? impl->u32 : 0;
+    return hr;
+}
+static const struct IAsyncOperation_UINT32Vtbl u32_vtbl =
+{
+    (void *)op_QueryInterface, (void *)op_AddRef, (void *)op_Release,
+    (void *)op_GetIids, (void *)op_GetRuntimeClassName, (void *)op_GetTrustLevel,
+    u32_put_Completed, u32_get_Completed, u32_GetResults,
+};
+
+/* IAsyncOperation<boolean> */
+static HRESULT WINAPI bool_put_Completed( IAsyncOperation_boolean *iface, IAsyncOperationCompletedHandler_boolean *handler )
+{
+    return op_put_Completed( (IInspectable *)iface, (IUnknown *)handler );
+}
+static HRESULT WINAPI bool_get_Completed( IAsyncOperation_boolean *iface, IAsyncOperationCompletedHandler_boolean **handler )
+{
+    return op_get_Completed( (IInspectable *)iface, (IUnknown **)handler );
+}
+static HRESULT WINAPI bool_GetResults( IAsyncOperation_boolean *iface, boolean *results )
+{
+    struct async *impl = impl_from_op( iface );
+    HRESULT hr = op_check_results( impl );
+    TRACE( "iface %p, results %p.\n", iface, results );
+    *results = SUCCEEDED(hr) ? impl->b : FALSE;
+    return hr;
+}
+static const struct IAsyncOperation_booleanVtbl bool_vtbl =
+{
+    (void *)op_QueryInterface, (void *)op_AddRef, (void *)op_Release,
+    (void *)op_GetIids, (void *)op_GetRuntimeClassName, (void *)op_GetTrustLevel,
+    bool_put_Completed, bool_get_Completed, bool_GetResults,
+};
+
+/* IAsyncOperationWithProgress<UINT32, UINT32>: nothing is in progress */
+static HRESULT WINAPI write_put_Progress( IAsyncOperationWithProgress_UINT32_UINT32 *iface,
+                                          IAsyncOperationProgressHandler_UINT32_UINT32 *handler )
+{
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    return S_OK;
+}
+static HRESULT WINAPI write_get_Progress( IAsyncOperationWithProgress_UINT32_UINT32 *iface,
+                                          IAsyncOperationProgressHandler_UINT32_UINT32 **handler )
+{
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    *handler = NULL;
+    return S_OK;
+}
+static HRESULT WINAPI write_put_Completed( IAsyncOperationWithProgress_UINT32_UINT32 *iface,
+                                           IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *handler )
+{
+    return op_put_Completed( (IInspectable *)iface, (IUnknown *)handler );
+}
+static HRESULT WINAPI write_get_Completed( IAsyncOperationWithProgress_UINT32_UINT32 *iface,
+                                           IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 **handler )
+{
+    return op_get_Completed( (IInspectable *)iface, (IUnknown **)handler );
+}
+static HRESULT WINAPI write_GetResults( IAsyncOperationWithProgress_UINT32_UINT32 *iface, UINT32 *results )
+{
+    struct async *impl = impl_from_op( iface );
+    HRESULT hr = op_check_results( impl );
+    TRACE( "iface %p, results %p.\n", iface, results );
+    *results = SUCCEEDED(hr) ? impl->u32 : 0;
+    return hr;
+}
+static const struct IAsyncOperationWithProgress_UINT32_UINT32Vtbl write_vtbl =
+{
+    (void *)op_QueryInterface, (void *)op_AddRef, (void *)op_Release,
+    (void *)op_GetIids, (void *)op_GetRuntimeClassName, (void *)op_GetTrustLevel,
+    write_put_Progress, write_get_Progress, write_put_Completed, write_get_Completed, write_GetResults,
+};
+
+/* IAsyncOperationWithProgress<IBuffer *, UINT32> */
+static HRESULT WINAPI read_put_Progress( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+                                         IAsyncOperationProgressHandler_IBuffer_UINT32 *handler )
+{
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    return S_OK;
+}
+static HRESULT WINAPI read_get_Progress( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+                                         IAsyncOperationProgressHandler_IBuffer_UINT32 **handler )
+{
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    *handler = NULL;
+    return S_OK;
+}
+static HRESULT WINAPI read_put_Completed( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+                                          IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 *handler )
+{
+    return op_put_Completed( (IInspectable *)iface, (IUnknown *)handler );
+}
+static HRESULT WINAPI read_get_Completed( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+                                          IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 **handler )
+{
+    return op_get_Completed( (IInspectable *)iface, (IUnknown **)handler );
+}
+static HRESULT WINAPI read_GetResults( IAsyncOperationWithProgress_IBuffer_UINT32 *iface, IBuffer **results )
+{
+    struct async *impl = impl_from_op( iface );
+    HRESULT hr = op_check_results( impl );
+    TRACE( "iface %p, results %p.\n", iface, results );
+    *results = NULL;
+    if (SUCCEEDED(hr) && (*results = impl->buffer)) IBuffer_AddRef( *results );
+    return hr;
+}
+static const struct IAsyncOperationWithProgress_IBuffer_UINT32Vtbl read_vtbl =
+{
+    (void *)op_QueryInterface, (void *)op_AddRef, (void *)op_Release,
+    (void *)op_GetIids, (void *)op_GetRuntimeClassName, (void *)op_GetTrustLevel,
+    read_put_Progress, read_get_Progress, read_put_Completed, read_get_Completed, read_GetResults,
+};
+
+/* IAsyncInfo */
+static struct async *impl_from_IAsyncInfo( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct async, IAsyncInfo_iface );
+}
+static HRESULT WINAPI info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )
+{
+    return op_QueryInterface( &impl_from_IAsyncInfo( iface )->op_iface, iid, out );
+}
+static ULONG WINAPI info_AddRef( IAsyncInfo *iface )
+{
+    return op_AddRef( &impl_from_IAsyncInfo( iface )->op_iface );
+}
+static ULONG WINAPI info_Release( IAsyncInfo *iface )
+{
+    return op_Release( &impl_from_IAsyncInfo( iface )->op_iface );
+}
+static HRESULT WINAPI info_GetIids( IAsyncInfo *iface, ULONG *iid_count, IID **iids )
+{
+    return op_GetIids( &impl_from_IAsyncInfo( iface )->op_iface, iid_count, iids );
+}
+static HRESULT WINAPI info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *class_name )
+{
+    return op_GetRuntimeClassName( &impl_from_IAsyncInfo( iface )->op_iface, class_name );
+}
+static HRESULT WINAPI info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *trust_level )
+{
+    return op_GetTrustLevel( &impl_from_IAsyncInfo( iface )->op_iface, trust_level );
+}
+static HRESULT WINAPI info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    TRACE( "iface %p, id %p.\n", iface, id );
+    *id = 1;
+    return S_OK;
+}
+static HRESULT WINAPI info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct async *impl = impl_from_IAsyncInfo( iface );
+    TRACE( "iface %p, status %p.\n", iface, status );
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    *status = async_status( impl );
+    return S_OK;
+}
+static HRESULT WINAPI info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error_code )
+{
+    struct async *impl = impl_from_IAsyncInfo( iface );
+    TRACE( "iface %p, error_code %p.\n", iface, error_code );
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    *error_code = impl->hr;
+    return S_OK;
+}
+static HRESULT WINAPI info_Cancel( IAsyncInfo *iface )
+{
+    TRACE( "iface %p.\n", iface );
+    return S_OK;
+}
+static HRESULT WINAPI info_Close( IAsyncInfo *iface )
+{
+    TRACE( "iface %p.\n", iface );
+    impl_from_IAsyncInfo( iface )->closed = TRUE;
+    return S_OK;
+}
+static const struct IAsyncInfoVtbl info_vtbl =
+{
+    info_QueryInterface, info_AddRef, info_Release,
+    info_GetIids, info_GetRuntimeClassName, info_GetTrustLevel,
+    info_get_Id, info_get_Status, info_get_ErrorCode, info_Cancel, info_Close,
+};
+
+static HRESULT async_create( enum async_kind kind, const void *vtbl, HRESULT hr, struct async **out )
+{
+    struct async *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->op_iface.lpVtbl = (void *)vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    impl->ref = 1;
+    impl->kind = kind;
+    impl->hr = hr;
+    *out = impl;
+    return S_OK;
+}
+
+HRESULT async_uint32_create( UINT32 result, HRESULT hr, IAsyncOperation_UINT32 **out )
+{
+    struct async *impl;
+    HRESULT ret;
+
+    if (FAILED(ret = async_create( ASYNC_UINT32, &u32_vtbl, hr, &impl ))) return ret;
+    impl->u32 = result;
+    *out = (IAsyncOperation_UINT32 *)&impl->op_iface;
+    return S_OK;
+}
+
+HRESULT async_boolean_create( boolean result, HRESULT hr, IAsyncOperation_boolean **out )
+{
+    struct async *impl;
+    HRESULT ret;
+
+    if (FAILED(ret = async_create( ASYNC_BOOLEAN, &bool_vtbl, hr, &impl ))) return ret;
+    impl->b = result;
+    *out = (IAsyncOperation_boolean *)&impl->op_iface;
+    return S_OK;
+}
+
+HRESULT async_write_create( UINT32 result, HRESULT hr, IAsyncOperationWithProgress_UINT32_UINT32 **out )
+{
+    struct async *impl;
+    HRESULT ret;
+
+    if (FAILED(ret = async_create( ASYNC_WRITE, &write_vtbl, hr, &impl ))) return ret;
+    impl->u32 = result;
+    *out = (IAsyncOperationWithProgress_UINT32_UINT32 *)&impl->op_iface;
+    return S_OK;
+}
+
+HRESULT async_read_create( IBuffer *result, HRESULT hr, IAsyncOperationWithProgress_IBuffer_UINT32 **out )
+{
+    struct async *impl;
+    HRESULT ret;
+
+    if (FAILED(ret = async_create( ASYNC_READ, &read_vtbl, hr, &impl ))) return ret;
+    if ((impl->buffer = result)) IBuffer_AddRef( result );
+    *out = (IAsyncOperationWithProgress_IBuffer_UINT32 *)&impl->op_iface;
+    return S_OK;
+}
