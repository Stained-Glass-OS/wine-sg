+static HRESULT WINAPI stream_get_Size( IRandomAccessStream *iface, UINT64 *value )
+{
+    struct memory_stream *impl = impl_from_IRandomAccessStream( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (impl->closed) return RO_E_CLOSED;
+    EnterCriticalSection( &impl->data->cs );
+    *value = impl->data->size;
+    LeaveCriticalSection( &impl->data->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_put_Size( IRandomAccessStream *iface, UINT64 value )
+{
+    struct memory_stream *impl = impl_from_IRandomAccessStream( iface );
+    struct stream_data *data = impl->data;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, value %I64u.\n", iface, value );
+
+    if (impl->closed) return RO_E_CLOSED;
+    EnterCriticalSection( &data->cs );
+    if (!stream_data_reserve( data, value )) hr = E_OUTOFMEMORY;
+    else
+    {
+        if (value < data->size) memset( data->bytes + value, 0, data->size - value );
+        data->size = value;
+    }
+    LeaveCriticalSection( &data->cs );
+    return hr;
+}
