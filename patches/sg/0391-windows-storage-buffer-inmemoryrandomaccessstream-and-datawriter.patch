+static HRESULT append( struct data_writer *impl, const void *data, UINT32 size )
+{
+    if (size > impl->capacity - impl->length)
+    {
+        UINT32 capacity = max( impl->capacity * 2, 64 );
+        BYTE *bytes;
+
+        if (size > 0x7fffffff - impl->length) return E_OUTOFMEMORY;
+        while (capacity - impl->length < size) capacity *= 2;
+        if (!(bytes = realloc( impl->bytes, capacity ))) return E_OUTOFMEMORY;
+        impl->bytes = bytes;
+        impl->capacity = capacity;
+    }
+    memcpy( impl->bytes + impl->length, data, size );
+    impl->length += size;
+    return S_OK;
+}
+
+/* an integer in the writer's byte order */
+static HRESULT append_number( struct data_writer *impl, const void *data, UINT32 size )
+{
+    BYTE bytes[8];
+    UINT32 i;
+
+    if (impl->byte_order == ByteOrder_LittleEndian) return append( impl, data, size );
+    for (i = 0; i < size; ++i) bytes[i] = ((const BYTE *)data)[size - 1 - i];
+    return append( impl, bytes, size );
+}
