+        if (!(V_BSTR(&source) = SysAllocString( recordset->source ))) return E_OUTOFMEMORY;
+    }
+    if (FAILED(hr = VariantCopy( &conn, &recordset->active_connection )))
+    {
+        VariantClear( &source );
+        return hr;
+    }
+
+    close_recordset( recordset );
+    recordset->state = adStateClosed;
+    hr = recordset_Open( &recordset->Recordset_iface, source, conn, cursor_type, lock_type,
+                         options >= 0 ? (options & ~0xff) | (recordset->open_options & 0xff) : recordset->open_options );
+    if (SUCCEEDED(hr) && keep_position && recordset->count)
+        recordset->index = index >= 0 && index < recordset->count ? index : recordset->count - 1;
+    VariantClear( &source );
+    VariantClear( &conn );
+    return hr;
+}
