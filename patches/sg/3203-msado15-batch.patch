+            name = SysAllocString( generated );
+        }
+        VariantInit( &empty );
+        hr = command_CreateParameter( &command->Command_iface, name, info[i].wType, dir, info[i].ulParamSize, empty, &param );
+        SysFreeString( name );
+        if (SUCCEEDED(hr))
+        {
+            _Parameter_put_Precision( param, info[i].bPrecision );
+            _Parameter_put_NumericScale( param, info[i].bScale );
+            hr = Parameters_Append( iface, (IDispatch *)param );
+            _Parameter_Release( param );
+        }
+    }
+    CoTaskMemFree( info );
+    CoTaskMemFree( names );
+    return hr;
 }
 
