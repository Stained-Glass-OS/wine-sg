+/* one element of a one dimensional array of variants or of a plain scalar type */
+static HRESULT get_array_element( SAFEARRAY *sa, LONG index, VARIANT *var )
+{
+    VARTYPE vt;
+    HRESULT hr;
+
+    VariantInit( var );
+    if (FAILED(hr = SafeArrayGetVartype( sa, &vt ))) return hr;
+    if (vt == VT_VARIANT) return SafeArrayGetElement( sa, &index, var );
+    if (vt == VT_DECIMAL || vt == VT_RECORD || (vt & VT_ARRAY)) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    V_VT(var) = vt;
+    if (FAILED(hr = SafeArrayGetElement( sa, &index, &V_I4(var) ))) V_VT(var) = VT_EMPTY;
+    return hr;
+}
+
+/* Sets fields of the current row from a name/number and a value, or from two arrays of the same length */
+static HRESULT recordset_set_fields( struct recordset *recordset, const VARIANT *fields, const VARIANT *values )
+{
+    SAFEARRAY *fa = NULL, *va = NULL;
+    LONG flo, fhi, vlo, vhi, k;
+    HRESULT hr = S_OK;
+
+#ifdef SG_MUTANT_ADO2_FIELDLIST
+    if (V_ISARRAY( fields )) return S_OK;
+#endif
+
+    if (V_ISARRAY( fields ))
+        fa = V_ISBYREF( fields ) ? *V_ARRAYREF( fields ) : V_ARRAY( fields );
+    if (V_ISARRAY( values ))
+        va = V_ISBYREF( values ) ? *V_ARRAYREF( values ) : V_ARRAY( values );
+
+    if (!fa)
+    {
+        if (va) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+        return recordset_set_field( recordset, fields, values );
+    }
+    if (!va || SafeArrayGetDim( fa ) != 1 || SafeArrayGetDim( va ) != 1) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    if (FAILED(SafeArrayGetLBound( fa, 1, &flo )) || FAILED(SafeArrayGetUBound( fa, 1, &fhi )) ||
+        FAILED(SafeArrayGetLBound( va, 1, &vlo )) || FAILED(SafeArrayGetUBound( va, 1, &vhi )))
+        return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    if (fhi - flo != vhi - vlo) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+
+    for (k = 0; k <= fhi - flo && SUCCEEDED(hr); k++)
+    {
+        VARIANT f, v;
+
+        hr = get_array_element( fa, flo + k, &f );
+        if (SUCCEEDED(hr)) hr = get_array_element( va, vlo + k, &v );
+        if (FAILED(hr)) { VariantClear( &f ); VariantClear( &v ); break; }
+        hr = recordset_set_field( recordset, &f, &v );
+        VariantClear( &f );
+        VariantClear( &v );
+    }
+    return hr;
+}
