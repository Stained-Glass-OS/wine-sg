+/* the text sent to the provider for a source of the given ADO command type (the low byte of the Open options) */
+static BSTR translate_source( const WCHAR *text, LONG options )
+{
+    static const WCHAR select[] = L"select * from ", call[] = L"{ call ";
+    WCHAR *ret;
+
+    switch (options & 0xff)
+    {
+    case adCmdTable:
+    case adCmdTableDirect:
+        if (!(ret = malloc( (wcslen( select ) + wcslen( text ) + 1) * sizeof(WCHAR) ))) return NULL;
+        wcscpy( ret, select );
+        wcscat( ret, text );
+        break;
+    case adCmdStoredProc:
+        if (!(ret = malloc( (wcslen( call ) + wcslen( text ) + 3) * sizeof(WCHAR) ))) return NULL;
+        wcscpy( ret, call );
+        wcscat( ret, text );
+        wcscat( ret, L" }" );
+        break;
+    default:
+        return SysAllocString( text );
+    }
+    {
+        BSTR bstr = SysAllocString( ret );
+        free( ret );
+        return bstr;
+    }
+}
