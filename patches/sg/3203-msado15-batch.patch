+    IDispatch_Release( conn_disp );
+    if (FAILED(hr)) return hr;
+    hr = ADOConnectionConstruction15_get_Session( construct, &session );
+    ADOConnectionConstruction15_Release( construct );
+    if (FAILED(hr)) return hr;
+    if (!session) return MAKE_ADO_HRESULT( adErrObjectClosed );
+
+    hr = IUnknown_QueryInterface( session, &IID_IDBCreateCommand, (void **)&create );
+    IUnknown_Release( session );
+    if (FAILED(hr)) return MAKE_ADO_HRESULT( adErrFeatureNotAvailable );
+    hr = IDBCreateCommand_CreateCommand( create, NULL, &IID_ICommandText, (IUnknown **)&text );
+    IDBCreateCommand_Release( create );
+    if (FAILED(hr)) return hr;
+    if (SUCCEEDED(hr = ICommandText_SetCommandText( text, &DBGUID_DEFAULT, command->text )) &&
+        SUCCEEDED(ICommandText_QueryInterface( text, &IID_ICommandPrepare, (void **)&prepare )))
+    {
+        hr = ICommandPrepare_Prepare( prepare, 0 );
+        ICommandPrepare_Release( prepare );
+    }
+    if (FAILED(hr) || FAILED(ICommandText_QueryInterface( text, &IID_ICommandWithParameters, (void **)&with_params )))
+    {
+        ICommandText_Release( text );
+        return FAILED(hr) ? hr : MAKE_ADO_HRESULT( adErrFeatureNotAvailable );
+    }
+    ICommandText_Release( text );
+
+    hr = ICommandWithParameters_GetParameterInfo( with_params, &count, &info, &names );
+    ICommandWithParameters_Release( with_params );
+    if (FAILED(hr)) return hr;
+
+    /* what the provider reports replaces the parameters the command had */
+    LIST_FOR_EACH_ENTRY_SAFE( item, next, &command->parameters, struct param_item, entry )
+    {
+        list_remove( &item->entry );
+        if (item->param) IDispatch_Release( item->param );
+        free( item );
+    }
+    for (i = 0; i < count && SUCCEEDED(hr); i++)
+    {
+        ParameterDirectionEnum dir = adParamUnknown;
+        WCHAR generated[16];
+        BSTR name;
+        _Parameter *param;
+        VARIANT empty;
+
+        if (info[i].dwFlags & DBPARAMFLAGS_ISINPUT) dir = adParamInput;
+        if (info[i].dwFlags & DBPARAMFLAGS_ISOUTPUT) dir = dir == adParamInput ? adParamInputOutput : adParamOutput;
+        if (info[i].pwszName) name = SysAllocString( info[i].pwszName );
+        else
