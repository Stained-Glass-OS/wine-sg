+/* The dynamic Properties collection of the ADO objects: Property objects with a name, a type, attributes and a value. */
+
+struct property
+{
+    Property Property_iface;
+    LONG refs;
+    WCHAR *name;
+    DataTypeEnum type;
+    LONG attrs;
+    BOOL hidden;     /* found by name only: not counted, enumerated or numbered */
+    VARIANT value;
+};
+
+struct properties
+{
+    Properties Properties_iface;
+    LONG refs;
+    struct property **items;
+    LONG count, allocated;
+};
+
+static LONG visible_count( const struct properties *props )
+{
+    LONG i, n = 0;
+
+    for (i = 0; i < props->count; i++) if (!props->items[i]->hidden) n++;
+    return n;
+}
+
+static inline struct property *impl_from_Property( Property *iface )
+{
+    return CONTAINING_RECORD( iface, struct property, Property_iface );
+}
+
+static HRESULT WINAPI property_QueryInterface( Property *iface, REFIID riid, void **obj )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_Property ) || IsEqualGUID( riid, &IID_IDispatch ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        Property_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI property_AddRef( Property *iface )
+{
+    return InterlockedIncrement( &impl_from_Property( iface )->refs );
+}
+
+static ULONG WINAPI property_Release( Property *iface )
+{
+    struct property *property = impl_from_Property( iface );
+    LONG refs = InterlockedDecrement( &property->refs );
+
+    if (!refs)
+    {
+        VariantClear( &property->value );
+        free( property->name );
+        free( property );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI property_GetTypeInfoCount( Property *iface, UINT *count )
+{
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI property_GetTypeInfo( Property *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    return get_typeinfo( Property_tid, info );
+}
+
+static HRESULT WINAPI property_GetIDsOfNames( Property *iface, REFIID riid, LPOLESTR *names, UINT count, LCID lcid,
+                                              DISPID *dispid )
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (SUCCEEDED(hr = get_typeinfo( Property_tid, &info )))
+    {
+        hr = ITypeInfo_GetIDsOfNames( info, names, count, dispid );
+        ITypeInfo_Release( info );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI property_Invoke( Property *iface, DISPID member, REFIID riid, LCID lcid, WORD flags,
+                                       DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (SUCCEEDED(hr = get_typeinfo( Property_tid, &info )))
+    {
+        hr = ITypeInfo_Invoke( info, iface, member, flags, params, result, excep, arg_err );
+        ITypeInfo_Release( info );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI property_get_Value( Property *iface, VARIANT *val )
+{
+    struct property *property = impl_from_Property( iface );
+
+    TRACE( "%p, %p\n", property, val );
+
+    if (!val) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    VariantInit( val );
+    return VariantCopy( val, &property->value );
+}
+
+static HRESULT WINAPI property_put_Value( Property *iface, VARIANT val )
+{
+    struct property *property = impl_from_Property( iface );
+    VARIANT copy;
+    HRESULT hr;
+
+    TRACE( "%p, %s\n", property, debugstr_variant(&val) );
+
+    /* a property without write access cannot be changed */
+    if (!(property->attrs & adPropWrite)) return MAKE_ADO_HRESULT( adErrIllegalOperation );
+
+    VariantInit( &copy );
+    if (FAILED(hr = VariantCopy( &copy, &val ))) return hr;
+    VariantClear( &property->value );
+    property->value = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI property_get_Name( Property *iface, BSTR *str )
+{
+    struct property *property = impl_from_Property( iface );
+
+    TRACE( "%p, %p\n", property, str );
+
+    if (!str) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    if (!(*str = SysAllocString( property->name ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT WINAPI property_get_Type( Property *iface, DataTypeEnum *type )
+{
+    struct property *property = impl_from_Property( iface );
+
+    TRACE( "%p, %p\n", property, type );
+
+    if (!type) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    *type = property->type;
+    return S_OK;
+}
+
+static HRESULT WINAPI property_get_Attributes( Property *iface, LONG *attributes )
+{
+    struct property *property = impl_from_Property( iface );
+
+    TRACE( "%p, %p\n", property, attributes );
+
+    if (!attributes) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    *attributes = property->attrs;
+    return S_OK;
+}
+
+static HRESULT WINAPI property_put_Attributes( Property *iface, LONG attributes )
+{
+    struct property *property = impl_from_Property( iface );
+
+    TRACE( "%p, %ld\n", property, attributes );
+
+    property->attrs = attributes;
+    return S_OK;
+}
+
+static const struct PropertyVtbl property_vtbl =
+{
+    property_QueryInterface,
+    property_AddRef,
+    property_Release,
+    property_GetTypeInfoCount,
+    property_GetTypeInfo,
+    property_GetIDsOfNames,
+    property_Invoke,
+    property_get_Value,
+    property_put_Value,
+    property_get_Name,
+    property_get_Type,
+    property_get_Attributes,
+    property_put_Attributes
+};
+
+static inline struct properties *impl_from_Properties( Properties *iface )
+{
+    return CONTAINING_RECORD( iface, struct properties, Properties_iface );
+}
+
+static HRESULT WINAPI properties_QueryInterface( Properties *iface, REFIID riid, void **obj )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_Properties ) || IsEqualGUID( riid, &IID__Collection ) ||
+        IsEqualGUID( riid, &IID_IDispatch ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        Properties_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI properties_AddRef( Properties *iface )
+{
+    return InterlockedIncrement( &impl_from_Properties( iface )->refs );
+}
+
+static void properties_clear( struct properties *props )
+{
+    LONG i;
+
+    for (i = 0; i < props->count; i++) Property_Release( &props->items[i]->Property_iface );
+    props->count = 0;
+}
+
+static ULONG WINAPI properties_Release( Properties *iface )
+{
+    struct properties *props = impl_from_Properties( iface );
+    LONG refs = InterlockedDecrement( &props->refs );
+
+    if (!refs)
+    {
+        properties_clear( props );
+        free( props->items );
+        free( props );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI properties_GetTypeInfoCount( Properties *iface, UINT *count )
+{
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI properties_GetTypeInfo( Properties *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    return get_typeinfo( Properties_tid, info );
+}
+
+static HRESULT WINAPI properties_GetIDsOfNames( Properties *iface, REFIID riid, LPOLESTR *names, UINT count, LCID lcid,
+                                                DISPID *dispid )
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (SUCCEEDED(hr = get_typeinfo( Properties_tid, &info )))
+    {
+        hr = ITypeInfo_GetIDsOfNames( info, names, count, dispid );
+        ITypeInfo_Release( info );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI properties_Invoke( Properties *iface, DISPID member, REFIID riid, LCID lcid, WORD flags,
+                                         DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (SUCCEEDED(hr = get_typeinfo( Properties_tid, &info )))
+    {
+        hr = ITypeInfo_Invoke( info, iface, member, flags, params, result, excep, arg_err );
+        ITypeInfo_Release( info );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI properties_get_Count( Properties *iface, LONG *count )
+{
+    struct properties *props = impl_from_Properties( iface );
+
+    TRACE( "%p, %p\n", props, count );
+
+    if (!count) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+#ifdef SG_MUTANT_ADO2_PROPCOUNT
+    *count = props->count;
+#else
+    *count = visible_count( props );
+#endif
+    return S_OK;
+}
+
+struct prop_enum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG refs;
+    struct properties *props;
+    LONG pos;
+};
+
+static inline struct prop_enum *impl_from_enum( IEnumVARIANT *iface )
+{
+    return CONTAINING_RECORD( iface, struct prop_enum, IEnumVARIANT_iface );
+}
+
+static HRESULT WINAPI prop_enum_QueryInterface( IEnumVARIANT *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IEnumVARIANT ))
+    {
+        *obj = iface;
+        IEnumVARIANT_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI prop_enum_AddRef( IEnumVARIANT *iface )
+{
+    return InterlockedIncrement( &impl_from_enum( iface )->refs );
+}
+
+static ULONG WINAPI prop_enum_Release( IEnumVARIANT *iface )
+{
+    struct prop_enum *e = impl_from_enum( iface );
+    LONG refs = InterlockedDecrement( &e->refs );
+
+    if (!refs)
+    {
+        Properties_Release( &e->props->Properties_iface );
+        free( e );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI prop_enum_Next( IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched )
+{
+    struct prop_enum *e = impl_from_enum( iface );
+    ULONG n = 0;
+
+    while (n < celt && e->pos < e->props->count)
+    {
+        struct property *p = e->props->items[e->pos++];
+
+        if (p->hidden) continue;
+
+        V_VT( &var[n] ) = VT_DISPATCH;
+        V_DISPATCH( &var[n] ) = (IDispatch *)&p->Property_iface;
+        Property_AddRef( &p->Property_iface );
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI prop_enum_Skip( IEnumVARIANT *iface, ULONG celt )
+{
+    struct prop_enum *e = impl_from_enum( iface );
+
+    if (e->pos + (LONG)celt > e->props->count)
+    {
+        e->pos = e->props->count;
+        return S_FALSE;
+    }
+    e->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI prop_enum_Reset( IEnumVARIANT *iface )
+{
+    impl_from_enum( iface )->pos = 0;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl prop_enum_vtbl;
+
+static HRESULT WINAPI prop_enum_Clone( IEnumVARIANT *iface, IEnumVARIANT **ret )
+{
+    struct prop_enum *e = impl_from_enum( iface ), *copy;
+
+    if (!(copy = calloc( 1, sizeof(*copy) ))) return E_OUTOFMEMORY;
+    copy->IEnumVARIANT_iface.lpVtbl = &prop_enum_vtbl;
+    copy->refs = 1;
+    copy->props = e->props;
+    copy->pos = e->pos;
+    Properties_AddRef( &copy->props->Properties_iface );
+    *ret = &copy->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl prop_enum_vtbl =
+{
+    prop_enum_QueryInterface,
+    prop_enum_AddRef,
+    prop_enum_Release,
+    prop_enum_Next,
+    prop_enum_Skip,
+    prop_enum_Reset,
+    prop_enum_Clone,
+};
+
+static HRESULT WINAPI properties__NewEnum( Properties *iface, IUnknown **obj )
+{
+    struct properties *props = impl_from_Properties( iface );
+    struct prop_enum *e;
+
+    TRACE( "%p, %p\n", props, obj );
+
+    if (!obj) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    if (!(e = calloc( 1, sizeof(*e) ))) return E_OUTOFMEMORY;
+    e->IEnumVARIANT_iface.lpVtbl = &prop_enum_vtbl;
+    e->refs = 1;
+    e->props = props;
+    Properties_AddRef( iface );
+    *obj = (IUnknown *)&e->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI properties_Refresh( Properties *iface )
+{
+    TRACE( "%p\n", iface );
+
+    /* values are kept in the collection; there is no provider state to re-read for the ones added by hand */
+    return S_OK;
+}
+
+static HRESULT WINAPI properties_get_Item( Properties *iface, VARIANT index, Property **obj )
+{
+    struct properties *props = impl_from_Properties( iface );
+    LONG i;
+
+    TRACE( "%p, %s, %p\n", props, debugstr_variant(&index), obj );
+
+    if (!obj) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    *obj = NULL;
+
+    if (V_VT(&index) == (VT_VARIANT | VT_BYREF)) index = *V_VARIANTREF( &index );
+    if (V_VT(&index) == VT_BSTR)
+    {
+        for (i = 0; i < props->count; i++)
+        {
+            if (V_BSTR(&index) && !wcsicmp( props->items[i]->name, V_BSTR(&index) ))
+            {
+                *obj = &props->items[i]->Property_iface;
+                Property_AddRef( *obj );
+                return S_OK;
+            }
+        }
+        return MAKE_ADO_HRESULT( adErrItemNotFound );
+    }
+    else
+    {
+        VARIANT num;
+        HRESULT hr;
+
+        V_VT(&num) = VT_EMPTY;
+        if (FAILED(hr = VariantChangeType( &num, &index, 0, VT_I4 ))) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+        {
+            LONG i2, seen = 0;
+
+            if (V_I4(&num) < 0) return MAKE_ADO_HRESULT( adErrItemNotFound );
+            for (i2 = 0; i2 < props->count; i2++)
+            {
+                if (props->items[i2]->hidden) continue;
+                if (seen++ == V_I4(&num)) break;
+            }
+            if (i2 == props->count) return MAKE_ADO_HRESULT( adErrItemNotFound );
+            i = i2;
+        }
+        *obj = &props->items[i]->Property_iface;
+        Property_AddRef( *obj );
+        return S_OK;
+    }
+}
+
+static const struct PropertiesVtbl properties_vtbl =
+{
+    properties_QueryInterface,
+    properties_AddRef,
+    properties_Release,
+    properties_GetTypeInfoCount,
+    properties_GetTypeInfo,
+    properties_GetIDsOfNames,
+    properties_Invoke,
+    properties_get_Count,
+    properties__NewEnum,
+    properties_Refresh,
+    properties_get_Item
+};
+
+HRESULT Properties_create( Properties **obj )
+{
+    struct properties *props;
+
+    if (!(props = calloc( 1, sizeof(*props) ))) return E_OUTOFMEMORY;
+    props->Properties_iface.lpVtbl = &properties_vtbl;
+    props->refs = 1;
+    *obj = &props->Properties_iface;
+    return S_OK;
+}
+
+/* adds a property, or replaces the value and attributes of the one with the same name */
+HRESULT Properties_add( Properties *iface, const WCHAR *name, DataTypeEnum type, LONG attrs, const VARIANT *value )
+{
+    struct properties *props = impl_from_Properties( iface );
+    struct property *p;
+    BOOL hidden = !!(attrs & PROPERTY_HIDDEN);
+    LONG i;
+
+    attrs &= ~PROPERTY_HIDDEN;
+    for (i = 0; i < props->count; i++)
+    {
+        if (!wcsicmp( props->items[i]->name, name ))
+        {
+            p = props->items[i];
+            p->type = type;
+            p->attrs = attrs;
+            VariantClear( &p->value );
+            return VariantCopy( &p->value, value );
+        }
+    }
+
+    if (props->count == props->allocated)
+    {
+        LONG size = props->allocated ? props->allocated * 2 : 8;
+        struct property **tmp = realloc( props->items, size * sizeof(*tmp) );
+        if (!tmp) return E_OUTOFMEMORY;
+        props->items = tmp;
+        props->allocated = size;
+    }
+    if (!(p = calloc( 1, sizeof(*p) ))) return E_OUTOFMEMORY;
+    p->Property_iface.lpVtbl = &property_vtbl;
+    p->refs = 1;
+    if (!(p->name = wcsdup( name )))
+    {
+        free( p );
+        return E_OUTOFMEMORY;
+    }
+    p->type = type;
+    p->attrs = attrs;
+    p->hidden = hidden;
+    VariantInit( &p->value );
+    VariantCopy( &p->value, value );
+    props->items[props->count++] = p;
+    return S_OK;
+}
+
+/* fills the collection from the properties of the data source a session was created from */
+HRESULT Properties_load_session( Properties *iface, IUnknown *session )
+{
+    struct properties *props = impl_from_Properties( iface );
+    IGetDataSource *getsource = NULL;
+    IDBProperties *dbprops = NULL;
+    DBPROPINFOSET *infosets = NULL;
+    OLECHAR *strings = NULL;
+    ULONG nsets = 0, i, j;
+    HRESULT hr;
+
+    if (!session) return S_OK;
+    if (FAILED(hr = IUnknown_QueryInterface( session, &IID_IGetDataSource, (void **)&getsource ))) return S_OK;
+    hr = IGetDataSource_GetDataSource( getsource, &IID_IDBProperties, (IUnknown **)&dbprops );
+    IGetDataSource_Release( getsource );
+    if (FAILED(hr)) return S_OK;
+
+    if (SUCCEEDED(hr = IDBProperties_GetPropertyInfo( dbprops, 0, NULL, &nsets, &infosets, &strings )))
+    {
+        properties_clear( props );
+        for (i = 0; i < nsets; i++)
+        {
+            DBPROPIDSET idset;
+            DBPROPSET *sets = NULL;
+            ULONG nvals = 0;
+            DBPROPID *ids = malloc( infosets[i].cPropertyInfos * sizeof(*ids) );
+
+            if (!ids) break;
+            for (j = 0; j < infosets[i].cPropertyInfos; j++) ids[j] = infosets[i].rgPropertyInfos[j].dwPropertyID;
+            idset.rgPropertyIDs = ids;
+            idset.cPropertyIDs = infosets[i].cPropertyInfos;
+            idset.guidPropertySet = infosets[i].guidPropertySet;
+            IDBProperties_GetProperties( dbprops, 1, &idset, &nvals, &sets );
+
+            for (j = 0; j < infosets[i].cPropertyInfos; j++)
+            {
+                DBPROPINFO *info = &infosets[i].rgPropertyInfos[j];
+                VARIANT v;
+                LONG attrs = 0;
+                ULONG k;
+
+                VariantInit( &v );
+                if (sets && nvals)
+                {
+                    for (k = 0; k < sets[0].cProperties; k++)
+                        if (sets[0].rgProperties[k].dwPropertyID == info->dwPropertyID)
+                            VariantCopy( &v, &sets[0].rgProperties[k].vValue );
+                }
+                if (info->dwFlags & DBPROPFLAGS_READ) attrs |= adPropRead;
+                if (info->dwFlags & DBPROPFLAGS_WRITE) attrs |= adPropWrite;
+                if (info->dwFlags & DBPROPFLAGS_REQUIRED) attrs |= adPropRequired;
+                if (!(info->dwFlags & DBPROPFLAGS_REQUIRED)) attrs |= adPropOptional;
+                if (info->pwszDescription)
+                    Properties_add( iface, info->pwszDescription, info->vtType, attrs, &v );
+                VariantClear( &v );
+            }
+            if (sets)
+            {
+                for (j = 0; j < nvals; j++)
+                {
+                    for (ULONG k = 0; k < sets[j].cProperties; k++) VariantClear( &sets[j].rgProperties[k].vValue );
+                    CoTaskMemFree( sets[j].rgProperties );
+                }
+                CoTaskMemFree( sets );
+            }
+            free( ids );
+        }
+        for (i = 0; i < nsets; i++) CoTaskMemFree( infosets[i].rgPropertyInfos );
+        CoTaskMemFree( infosets );
+        CoTaskMemFree( strings );
+    }
+    IDBProperties_Release( dbprops );
+    return S_OK;
+}
