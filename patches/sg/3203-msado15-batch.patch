+struct sbuf
+{
+    char *data;
+    size_t len, size;
+};
+
+static BOOL sbuf_put( struct sbuf *buf, const char *str, size_t len )
+{
+    if (buf->len + len + 1 > buf->size)
+    {
+        size_t size = max( buf->size * 2, buf->len + len + 1 + 256 );
+        char *tmp = realloc( buf->data, size );
+        if (!tmp) return FALSE;
+        buf->data = tmp;
+        buf->size = size;
+    }
+    memcpy( buf->data + buf->len, str, len );
+    buf->len += len;
+    buf->data[buf->len] = 0;
+    return TRUE;
+}
+
+static BOOL sbuf_puts( struct sbuf *buf, const char *str ) { return sbuf_put( buf, str, strlen( str ) ); }
+
+/* an attribute value: UTF-8 with the XML special characters escaped */
+static BOOL sbuf_put_attr( struct sbuf *buf, const WCHAR *str, int len )
+{
+    char utf8[8], tmp[16];
+    int i;
+
+    for (i = 0; i < len; i++)
+    {
+        WCHAR ch = str[i];
+        int n;
+
+        switch (ch)
+        {
+        case '&': if (!sbuf_puts( buf, "&amp;" )) return FALSE; continue;
+        case '<': if (!sbuf_puts( buf, "&lt;" )) return FALSE; continue;
+        case '>': if (!sbuf_puts( buf, "&gt;" )) return FALSE; continue;
+        case '\'': if (!sbuf_puts( buf, "&apos;" )) return FALSE; continue;
+        case '"': if (!sbuf_puts( buf, "&quot;" )) return FALSE; continue;
+        }
+        if (ch < 0x20)
+        {
+            sprintf( tmp, "&#x%X;", ch );
+            if (!sbuf_puts( buf, tmp )) return FALSE;
+            continue;
+        }
+        if (IS_HIGH_SURROGATE( ch ) && i + 1 < len && IS_LOW_SURROGATE( str[i + 1] ))
+        {
+            n = WideCharToMultiByte( CP_UTF8, 0, str + i, 2, utf8, sizeof(utf8), NULL, NULL );
+            i++;
+        }
+        else n = WideCharToMultiByte( CP_UTF8, 0, &ch, 1, utf8, sizeof(utf8), NULL, NULL );
+        if (n <= 0 || !sbuf_put( buf, utf8, n )) return FALSE;
+    }
+    return TRUE;
+}
