+static HRESULT recordset_reopen( struct recordset *recordset, LONG options, BOOL keep_position )
+{
+    VARIANT source, conn;
+    CursorTypeEnum cursor_type = recordset->cursor_type;
+    LockTypeEnum lock_type = recordset->lock_type;
+    LONG index = recordset->index;
+    HRESULT hr;
