+/* the XML Schema data type ADO persists for a field type, with the size and attribute text that goes with it */
+static const char *persist_type( DataTypeEnum type, LONG defined_size, char *extra, size_t extra_size )
+{
+    const char *name = "string";
+    int size = 0, precision = 0;
+    BOOL fixed = FALSE;
+
+    switch (type)
+    {
+    case adTinyInt: name = "i1"; size = 1; precision = 3; fixed = TRUE; break;
+    case adSmallInt: name = "i2"; size = 2; precision = 5; fixed = TRUE; break;
+    case adInteger: name = "int"; size = 4; precision = 10; fixed = TRUE; break;
+    case adBigInt: name = "i8"; size = 8; precision = 19; fixed = TRUE; break;
+    case adUnsignedTinyInt: name = "ui1"; size = 1; precision = 3; fixed = TRUE; break;
+    case adUnsignedSmallInt: name = "ui2"; size = 2; precision = 5; fixed = TRUE; break;
+    case adUnsignedInt: name = "ui4"; size = 4; precision = 10; fixed = TRUE; break;
+    case adUnsignedBigInt: name = "ui8"; size = 8; precision = 20; fixed = TRUE; break;
+    case adSingle: name = "float"; size = 4; precision = 7; fixed = TRUE; break;
+    case adDouble: name = "float"; size = 8; precision = 15; fixed = TRUE; break;
+    case adCurrency: name = "i8"; size = 8; precision = 19; fixed = TRUE; break;
+    case adDate: name = "dateTime"; size = 16; fixed = TRUE; break;
+    case adBoolean: name = "boolean"; size = 2; fixed = TRUE; break;
+    case adGUID: name = "uuid"; size = 16; fixed = TRUE; break;
+    case adBinary: case adVarBinary: case adLongVarBinary: name = "bin.hex"; size = defined_size > 0 ? defined_size : 2147483647; break;
+    default: size = defined_size > 0 ? defined_size : (type == adBSTR ? 2147483647 : 255); break;
+    }
+    snprintf( extra, extra_size, " dt:maxLength='%d'%s%s", size, precision ? " rs:precision='" : "", "" );
+    if (precision) snprintf( extra + strlen( extra ), extra_size - strlen( extra ), "%d'", precision );
+    if (fixed) strncat( extra, " rs:fixedlength='true'", extra_size - strlen( extra ) - 1 );
+    return name;
+}
