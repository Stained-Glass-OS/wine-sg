+    /* only a recordset that came from a provider has something to run again */
+#ifdef SG_MUTANT_ADO2_REQUERY
+    return S_OK;
+#endif
+    if (V_VT(&recordset->active_connection) != VT_DISPATCH || !V_DISPATCH(&recordset->active_connection) ||
+        (!recordset->active_command && !recordset->source))
+        return MAKE_ADO_HRESULT( adErrInvalidConnection );
+
+    VariantInit( &source );
+    VariantInit( &conn );
+    if (recordset->active_command)
+    {
+        V_VT(&source) = VT_DISPATCH;
+        V_DISPATCH(&source) = recordset->active_command;
+        IDispatch_AddRef( recordset->active_command );
+    }
+    else
