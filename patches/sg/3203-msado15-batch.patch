+static HRESULT persist_value( struct sbuf *buf, DataTypeEnum type, const VARIANT *value )
+{
+    VARIANT str;
+    HRESULT hr = S_OK;
+    WCHAR tmp[64];
+
+    VariantInit( &str );
+    if (V_VT(value) == VT_BOOL)
+    {
+        sbuf_puts( buf, V_BOOL(value) ? "1" : "0" );
+        return S_OK;
+    }
+    if (V_VT(value) == VT_DATE)
+    {
+        SYSTEMTIME st;
+
+        if (!VariantTimeToSystemTime( V_DATE(value), &st )) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+        swprintf( tmp, ARRAY_SIZE(tmp), L"%04u-%02u-%02uT%02u:%02u:%02u", st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond );
+        return sbuf_put_attr( buf, tmp, wcslen( tmp ) ) ? S_OK : E_OUTOFMEMORY;
+    }
+    if (V_VT(value) == (VT_ARRAY | VT_UI1) && V_ARRAY(value))
+    {
+        LONG lo, hi, i;
+        BYTE *bytes;
+        char hex[3];
+
+        SafeArrayGetLBound( V_ARRAY(value), 1, &lo );
+        SafeArrayGetUBound( V_ARRAY(value), 1, &hi );
+        SafeArrayAccessData( V_ARRAY(value), (void **)&bytes );
+        for (i = 0; i <= hi - lo; i++)
+        {
+            sprintf( hex, "%02x", bytes[i] );
+            if (!sbuf_puts( buf, hex )) hr = E_OUTOFMEMORY;
+        }
+        SafeArrayUnaccessData( V_ARRAY(value) );
+        return hr;
+    }
+    if (FAILED(hr = VariantChangeTypeEx( &str, (VARIANT *)value, MAKELCID( MAKELANGID( LANG_ENGLISH, SUBLANG_ENGLISH_US ), SORT_DEFAULT ), 0, VT_BSTR )))
+        return hr;
+    hr = sbuf_put_attr( buf, V_BSTR(&str), SysStringLen( V_BSTR(&str) ) ) ? S_OK : E_OUTOFMEMORY;
+    VariantClear( &str );
+    return hr;
+}
