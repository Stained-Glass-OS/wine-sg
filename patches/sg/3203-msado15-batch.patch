+/* enumerators over snapshots: the one connection point of a connection and the sinks of a point */
+struct enum_points
+{
+    IEnumConnectionPoints IEnumConnectionPoints_iface;
+    LONG refs;
+    IConnectionPoint *point;
+    ULONG pos;
+};
+
+static inline struct enum_points *impl_from_IEnumConnectionPoints( IEnumConnectionPoints *iface )
+{
+    return CONTAINING_RECORD( iface, struct enum_points, IEnumConnectionPoints_iface );
+}
+
+static HRESULT WINAPI enum_points_QueryInterface( IEnumConnectionPoints *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IEnumConnectionPoints ))
+    {
+        *obj = iface;
+        IEnumConnectionPoints_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_points_AddRef( IEnumConnectionPoints *iface )
+{
+    return InterlockedIncrement( &impl_from_IEnumConnectionPoints( iface )->refs );
+}
+
+static ULONG WINAPI enum_points_Release( IEnumConnectionPoints *iface )
+{
+    struct enum_points *e = impl_from_IEnumConnectionPoints( iface );
+    LONG refs = InterlockedDecrement( &e->refs );
+
+    if (!refs)
+    {
+        IConnectionPoint_Release( e->point );
+        free( e );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI enum_points_Next( IEnumConnectionPoints *iface, ULONG count, IConnectionPoint **points, ULONG *fetched )
+{
+    struct enum_points *e = impl_from_IEnumConnectionPoints( iface );
+    ULONG n = 0;
+
+    if (!points || (!fetched && count > 1)) return E_POINTER;
+    if (count && e->pos == 0)
+    {
+        points[n++] = e->point;
+        IConnectionPoint_AddRef( e->point );
+        e->pos = 1;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_points_Skip( IEnumConnectionPoints *iface, ULONG count )
+{
+    struct enum_points *e = impl_from_IEnumConnectionPoints( iface );
+
+    if (e->pos + count > 1)
+    {
+        e->pos = 1;
+        return S_FALSE;
+    }
+    e->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_points_Reset( IEnumConnectionPoints *iface )
+{
+    impl_from_IEnumConnectionPoints( iface )->pos = 0;
+    return S_OK;
+}
+
+static const IEnumConnectionPointsVtbl enum_points_vtbl;
+
+static HRESULT enum_points_create( IConnectionPoint *point, ULONG pos, IEnumConnectionPoints **ret )
+{
+    struct enum_points *e;
+
+    if (!(e = calloc( 1, sizeof(*e) ))) return E_OUTOFMEMORY;
+    e->IEnumConnectionPoints_iface.lpVtbl = &enum_points_vtbl;
+    e->refs = 1;
+    e->point = point;
+    e->pos = pos;
+    IConnectionPoint_AddRef( point );
+    *ret = &e->IEnumConnectionPoints_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_points_Clone( IEnumConnectionPoints *iface, IEnumConnectionPoints **ret )
+{
+    struct enum_points *e = impl_from_IEnumConnectionPoints( iface );
+
+    if (!ret) return E_POINTER;
+    return enum_points_create( e->point, e->pos, ret );
+}
+
+static const IEnumConnectionPointsVtbl enum_points_vtbl =
+{
+    enum_points_QueryInterface,
+    enum_points_AddRef,
+    enum_points_Release,
+    enum_points_Next,
+    enum_points_Skip,
+    enum_points_Reset,
+    enum_points_Clone
+};
+
+struct enum_conns
+{
+    IEnumConnections IEnumConnections_iface;
+    LONG refs;
+    CONNECTDATA *items;
+    ULONG count, pos;
+};
+
+static inline struct enum_conns *impl_from_IEnumConnections( IEnumConnections *iface )
+{
+    return CONTAINING_RECORD( iface, struct enum_conns, IEnumConnections_iface );
+}
+
+static HRESULT WINAPI enum_conns_QueryInterface( IEnumConnections *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IEnumConnections ))
+    {
+        *obj = iface;
+        IEnumConnections_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_conns_AddRef( IEnumConnections *iface )
+{
+    return InterlockedIncrement( &impl_from_IEnumConnections( iface )->refs );
+}
+
+static ULONG WINAPI enum_conns_Release( IEnumConnections *iface )
+{
+    struct enum_conns *e = impl_from_IEnumConnections( iface );
+    LONG refs = InterlockedDecrement( &e->refs );
+
+    if (!refs)
+    {
+        ULONG i;
+        for (i = 0; i < e->count; i++) IUnknown_Release( e->items[i].pUnk );
+        free( e->items );
+        free( e );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI enum_conns_Next( IEnumConnections *iface, ULONG count, CONNECTDATA *data, ULONG *fetched )
+{
+    struct enum_conns *e = impl_from_IEnumConnections( iface );
+    ULONG n = 0;
+
+    if (!data || (!fetched && count > 1)) return E_POINTER;
+    while (n < count && e->pos < e->count)
+    {
+        data[n] = e->items[e->pos++];
+        IUnknown_AddRef( data[n].pUnk );
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_conns_Skip( IEnumConnections *iface, ULONG count )
+{
+    struct enum_conns *e = impl_from_IEnumConnections( iface );
+
+    if (e->pos + count > e->count)
+    {
+        e->pos = e->count;
+        return S_FALSE;
+    }
+    e->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_conns_Reset( IEnumConnections *iface )
+{
+    impl_from_IEnumConnections( iface )->pos = 0;
+    return S_OK;
+}
+
