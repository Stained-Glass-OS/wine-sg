+/* the whole content of an object that offers a COM stream */
+static HRESULT load_object( struct stream *stream, IUnknown *unk )
+{
+    IStream *source;
+    BYTE *data = NULL;
+    ULONG size = 0, allocated = 0, read;
+    HRESULT hr;
+
+    if (FAILED(IUnknown_QueryInterface( unk, &IID_IStream, (void **)&source ))) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+
+    for (;;)
+    {
+        BYTE *tmp;
+
+        if (size + 4096 > allocated)
+        {
+            allocated = max( 8192, allocated * 2 );
+            if (!(tmp = realloc( data, allocated )))
+            {
+                free( data );
+                IStream_Release( source );
+                return E_OUTOFMEMORY;
+            }
+            data = tmp;
+        }
+        read = 0;
+        hr = IStream_Read( source, data + size, allocated - size, &read );
+        size += read;
+        if (FAILED(hr) || !read || size > MAXLONG) break;
+    }
+    IStream_Release( source );
+    if (FAILED(hr) || size > MAXLONG)
+    {
+        free( data );
+        return MAKE_ADO_HRESULT( adErrReadFile );
+    }
+
+    free( stream->buf );
+    stream->buf = data;
+    stream->size = size;
+    stream->allocated = allocated;
+    stream->pos = 0;
+    return S_OK;
+}
