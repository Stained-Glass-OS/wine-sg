From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: image effects (3517)

gdiplus: image effects

GdipSetEffectParameters and the new GdipGetEffectParameters keep the parameters of an effect (size
checked, red-eye areas copied, brightness and contrast range checked). GdipBitmapApplyEffect,
GdipBitmapCreateApplyEffect and GdipDrawImageFX now apply colour matrix, colour lookup tables,
brightness and contrast, hue/saturation/lightness, colour balance, levels, tint, blur, sharpen and
red-eye correction to a bitmap (or a region of it), through straight ARGB. The colour curve effect
still returns NotImplemented.
---
--- /dev/null
+++ b/dlls/gdiplus/effects.c
@@ -0,0 +1,530 @@
+/*
+ * GDI+ image effects: parameter storage and the pixel work behind GdipBitmapApplyEffect,
+ * GdipBitmapCreateApplyEffect and GdipDrawImageFX.
+ *
+ * Stained Glass OS: written from the documented parameters of each effect. The colour matrix and the
+ * colour lookup tables are exact; the other effects follow the documented ranges and meaning but their
+ * numbers are our own.
+ */
+#include <math.h>
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+
+#include "objbase.h"
+
+#include "gdiplus.h"
+#include "gdiplus_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(gdiplus);
+
+static UINT effect_params_size(EffectType type)
+{
+    switch (type)
+    {
+    case BlurEffect:                  return sizeof(struct BlurParams);
+    case SharpenEffect:               return sizeof(struct SharpenParams);
+    case TintEffect:                  return sizeof(struct TintParams);
+    case RedEyeCorrectionEffect:      return sizeof(struct RedEyeCorrectionParams);
+    case ColorMatrixEffect:           return sizeof(ColorMatrix);
+    case ColorLUTEffect:              return sizeof(struct ColorLUTParams);
+    case BrightnessContrastEffect:    return sizeof(struct BrightnessContrastParams);
+    case HueSaturationLightnessEffect: return sizeof(struct HueSaturationLightnessParams);
+    case ColorBalanceEffect:          return sizeof(struct ColorBalanceParams);
+    case LevelsEffect:                return sizeof(struct LevelsParams);
+    case ColorCurveEffect:            return sizeof(struct ColorCurveParams);
+    default:                          return 0;
+    }
+}
+
+GpStatus effect_init_params(CGpEffect *effect)
+{
+    UINT size = effect_params_size(effect->type);
+
+    effect->params = calloc(1, size ? size : 1);
+    effect->size = size;
+    if (!effect->params)
+        return OutOfMemory;
+    return Ok;
+}
+
+void effect_free_params(CGpEffect *effect)
+{
+    if (effect->type == RedEyeCorrectionEffect && effect->params)
+        free(((struct RedEyeCorrectionParams *)effect->params)->areas);
+    free(effect->params);
+    effect->params = NULL;
+}
+
+GpStatus WINGDIPAPI GdipSetEffectParameters(CGpEffect *effect, const VOID *params, const UINT size)
+{
+    TRACE("(%p,%p,%u)\n", effect, params, size);
+
+    if (!effect || !params || size != effect->size)
+        return InvalidParameter;
+
+    if (effect->type == RedEyeCorrectionEffect)
+    {
+        const struct RedEyeCorrectionParams *in = params;
+        struct RedEyeCorrectionParams *out = effect->params;
+        RECT *areas = NULL;
+
+        if (in->numberOfAreas)
+        {
+            if (!in->areas) return InvalidParameter;
+            if (!(areas = malloc(in->numberOfAreas * sizeof(RECT)))) return OutOfMemory;
+            memcpy(areas, in->areas, in->numberOfAreas * sizeof(RECT));
+        }
+        free(out->areas);
+        out->areas = areas;
+        out->numberOfAreas = in->numberOfAreas;
+        return Ok;
+    }
+
+    if (effect->type == BrightnessContrastEffect)
+    {
+        const struct BrightnessContrastParams *p = params;
+        if (p->brightnessLevel < -255 || p->brightnessLevel > 255 || p->contrastLevel < -100 || p->contrastLevel > 100)
+            return InvalidParameter;
+    }
+
+    memcpy(effect->params, params, size);
+    return Ok;
+}
+
+/* The size is both a limit and a result, as on Windows. */
+GpStatus WINGDIPAPI GdipGetEffectParameters(CGpEffect *effect, UINT *size, VOID *params)
+{
+    TRACE("(%p,%p,%p)\n", effect, size, params);
+
+    if (!effect || !size || !params || *size < effect->size)
+        return InvalidParameter;
+
+    memcpy(params, effect->params, effect->size);
+    if (effect->type == RedEyeCorrectionEffect)
+    {
+        struct RedEyeCorrectionParams *out = params, *in = effect->params;
+
+        out->areas = NULL;
+        if (in->numberOfAreas)
+        {
+            if (!(out->areas = malloc(in->numberOfAreas * sizeof(RECT)))) return OutOfMemory;
+            memcpy(out->areas, in->areas, in->numberOfAreas * sizeof(RECT));
+        }
+    }
+    *size = effect->size;
+    return Ok;
+}
+
+/* ---- pixel work, on straight (not premultiplied) ARGB ---- */
+
+static inline BYTE clamp8(float v)
+{
+    return v <= 0.0f ? 0 : v >= 255.0f ? 255 : (BYTE)(v + 0.5f);
+}
+
+static void rgb_to_hsl(float r, float g, float b, float *h, float *s, float *l)
+{
+    float mx = max(r, max(g, b)), mn = min(r, min(g, b)), d = mx - mn;
+
+    *l = (mx + mn) / 2.0f;
+    if (d == 0.0f) { *h = 0.0f; *s = 0.0f; return; }
+    *s = *l > 0.5f ? d / (2.0f - mx - mn) : d / (mx + mn);
+    if (mx == r)      *h = (g - b) / d + (g < b ? 6.0f : 0.0f);
+    else if (mx == g) *h = (b - r) / d + 2.0f;
+    else              *h = (r - g) / d + 4.0f;
+    *h *= 60.0f;
+}
+
+static float hue_to_channel(float p, float q, float t)
+{
+    if (t < 0.0f) t += 1.0f;
+    if (t > 1.0f) t -= 1.0f;
+    if (t < 1.0f / 6.0f) return p + (q - p) * 6.0f * t;
+    if (t < 0.5f) return q;
+    if (t < 2.0f / 3.0f) return p + (q - p) * (2.0f / 3.0f - t) * 6.0f;
+    return p;
+}
+
+static void hsl_to_rgb(float h, float s, float l, float *r, float *g, float *b)
+{
+    float q, p;
+
+    if (s == 0.0f) { *r = *g = *b = l; return; }
+    h = fmodf(h, 360.0f);
+    if (h < 0.0f) h += 360.0f;
+    h /= 360.0f;
+    q = l < 0.5f ? l * (1.0f + s) : l + s - l * s;
+    p = 2.0f * l - q;
+    *r = hue_to_channel(p, q, h + 1.0f / 3.0f);
+    *g = hue_to_channel(p, q, h);
+    *b = hue_to_channel(p, q, h - 1.0f / 3.0f);
+}
+
+typedef void (*pixel_op)(ARGB *pixel, const void *params);
+
+static void op_color_matrix(ARGB *px, const void *params)
+{
+    const ColorMatrix *m = params;
+    float in[5] = { (*px >> 16) & 0xff, (*px >> 8) & 0xff, *px & 0xff, *px >> 24, 255.0f }, out[4];
+    int i, j;
+
+    for (j = 0; j < 4; j++)
+    {
+        out[j] = 0.0f;
+        for (i = 0; i < 5; i++)
+            out[j] += in[i] * m->m[i][j];
+    }
+    *px = (clamp8(out[3]) << 24) | (clamp8(out[0]) << 16) | (clamp8(out[1]) << 8) | clamp8(out[2]);
+}
+
+static void op_color_lut(ARGB *px, const void *params)
+{
+    const struct ColorLUTParams *p = params;
+
+    *px = (p->lutA[*px >> 24] << 24) | (p->lutR[(*px >> 16) & 0xff] << 16) | (p->lutG[(*px >> 8) & 0xff] << 8)
+            | p->lutB[*px & 0xff];
+}
+
+static void op_brightness_contrast(ARGB *px, const void *params)
+{
+    const struct BrightnessContrastParams *p = params;
+    float contrast = p->contrastLevel, k = contrast >= 0.0f ? 100.0f / (100.0f - min(contrast, 99.0f)) : (100.0f + contrast) / 100.0f;
+    float c[3] = { (*px >> 16) & 0xff, (*px >> 8) & 0xff, *px & 0xff };
+    int i;
+
+    for (i = 0; i < 3; i++)
+        c[i] = (c[i] - 127.5f) * k + 127.5f + p->brightnessLevel;
+    *px = (*px & 0xff000000) | (clamp8(c[0]) << 16) | (clamp8(c[1]) << 8) | clamp8(c[2]);
+}
+
+static void op_hsl(ARGB *px, const void *params)
+{
+    const struct HueSaturationLightnessParams *p = params;
+    float r = ((*px >> 16) & 0xff) / 255.0f, g = ((*px >> 8) & 0xff) / 255.0f, b = (*px & 0xff) / 255.0f, h, s, l;
+
+    rgb_to_hsl(r, g, b, &h, &s, &l);
+    h += p->hueLevel;
+    s = p->saturationLevel >= 0 ? s + (1.0f - s) * p->saturationLevel / 100.0f : s * (100 + p->saturationLevel) / 100.0f;
+    l = p->lightnessLevel >= 0 ? l + (1.0f - l) * p->lightnessLevel / 100.0f : l * (100 + p->lightnessLevel) / 100.0f;
+    hsl_to_rgb(h, s, l, &r, &g, &b);
+    *px = (*px & 0xff000000) | (clamp8(r * 255.0f) << 16) | (clamp8(g * 255.0f) << 8) | clamp8(b * 255.0f);
+}
+
+static void op_color_balance(ARGB *px, const void *params)
+{
+    const struct ColorBalanceParams *p = params;
+    float r = (*px >> 16) & 0xff, g = (*px >> 8) & 0xff, b = *px & 0xff;
+
+    r += p->cyanRed * 1.275f;
+    g += p->magentaGreen * 1.275f;
+    b += p->yellowBlue * 1.275f;
+    *px = (*px & 0xff000000) | (clamp8(r) << 16) | (clamp8(g) << 8) | clamp8(b);
+}
+
+static void op_levels(ARGB *px, const void *params)
+{
+    const struct LevelsParams *p = params;
+    float low = p->shadow * 2.55f, high = p->highlight * 2.55f, gamma = powf(3.0f, -p->midtone / 100.0f);
+    float c[3] = { (*px >> 16) & 0xff, (*px >> 8) & 0xff, *px & 0xff };
+    int i;
+
+    if (high <= low) return;
+    for (i = 0; i < 3; i++)
+    {
+        float t = (c[i] - low) / (high - low);
+        t = t < 0.0f ? 0.0f : t > 1.0f ? 1.0f : t;
+        c[i] = powf(t, gamma) * 255.0f;
+    }
+    *px = (*px & 0xff000000) | (clamp8(c[0]) << 16) | (clamp8(c[1]) << 8) | clamp8(c[2]);
+}
+
+static void op_tint(ARGB *px, const void *params)
+{
+    const struct TintParams *p = params;
+    float r = (*px >> 16) & 0xff, g = (*px >> 8) & 0xff, b = *px & 0xff, tr, tg, tb;
+    float lum = 0.299f * r + 0.587f * g + 0.114f * b, tlum;
+
+    /* a colour of the chosen hue, moved to the pixel's brightness, mixed in by the amount */
+    hsl_to_rgb(p->hue + 180.0f, 1.0f, 0.5f, &tr, &tg, &tb);
+    tr *= 255.0f; tg *= 255.0f; tb *= 255.0f;
+    tlum = 0.299f * tr + 0.587f * tg + 0.114f * tb;
+    r += (tr - tlum) * p->amount / 100.0f * (lum / 255.0f + 0.25f);
+    g += (tg - tlum) * p->amount / 100.0f * (lum / 255.0f + 0.25f);
+    b += (tb - tlum) * p->amount / 100.0f * (lum / 255.0f + 0.25f);
+    *px = (*px & 0xff000000) | (clamp8(r) << 16) | (clamp8(g) << 8) | clamp8(b);
+}
+
+/* Box blur of a plane of floats, rows then columns, edges repeat the border pixel. */
+static void box_blur_plane(float *plane, float *tmp, int width, int height, int radius)
+{
+    int x, y, i, n = radius * 2 + 1;
+
+    for (y = 0; y < height; y++)
+    {
+        float *row = plane + (SIZE_T)y * width, sum = 0.0f;
+
+        for (i = -radius; i <= radius; i++) sum += row[min(max(i, 0), width - 1)];
+        for (x = 0; x < width; x++)
+        {
+            tmp[x] = sum / n;
+            sum += row[min(x + radius + 1, width - 1)] - row[max(x - radius, 0)];
+        }
+        memcpy(row, tmp, width * sizeof(float));
+    }
+    for (x = 0; x < width; x++)
+    {
+        float sum = 0.0f;
+
+        for (i = -radius; i <= radius; i++) sum += plane[(SIZE_T)min(max(i, 0), height - 1) * width + x];
+        for (y = 0; y < height; y++)
+        {
+            tmp[y] = sum / n;
+            sum += plane[(SIZE_T)min(y + radius + 1, height - 1) * width + x] - plane[(SIZE_T)max(y - radius, 0) * width + x];
+        }
+        for (y = 0; y < height; y++) plane[(SIZE_T)y * width + x] = tmp[y];
+    }
+}
+
+/* Three box passes approximate a gaussian. Colour is blurred premultiplied so transparent pixels do not bleed. */
+static GpStatus blur_pixels(ARGB *pixels, int width, int height, float radius, ARGB *out_pixels)
+{
+    float *planes[4] = {0}, *tmp;
+    int ch, pass, box = (int)(radius / 2.0f + 0.5f), i;
+    SIZE_T count = (SIZE_T)width * height;
+    GpStatus status = Ok;
+
+    tmp = malloc(max(width, height) * sizeof(float));
+    for (ch = 0; ch < 4; ch++) planes[ch] = malloc(count * sizeof(float));
+    if (!tmp || !planes[0] || !planes[1] || !planes[2] || !planes[3]) { status = OutOfMemory; goto done; }
+
+    for (i = 0; i < count; i++)
+    {
+        float a = (pixels[i] >> 24) / 255.0f;
+
+        planes[0][i] = ((pixels[i] >> 16) & 0xff) * a;
+        planes[1][i] = ((pixels[i] >> 8) & 0xff) * a;
+        planes[2][i] = (pixels[i] & 0xff) * a;
+        planes[3][i] = a * 255.0f;
+    }
+    if (box > 0)
+        for (ch = 0; ch < 4; ch++)
+            for (pass = 0; pass < 3; pass++)
+                box_blur_plane(planes[ch], tmp, width, height, box);
+    for (i = 0; i < count; i++)
+    {
+        float a = planes[3][i] / 255.0f;
+
+        if (a <= 0.0f) { out_pixels[i] = 0; continue; }
+        out_pixels[i] = (clamp8(planes[3][i]) << 24) | (clamp8(planes[0][i] / a) << 16)
+                | (clamp8(planes[1][i] / a) << 8) | clamp8(planes[2][i] / a);
+    }
+done:
+    for (ch = 0; ch < 4; ch++) free(planes[ch]);
+    free(tmp);
+    return status;
+}
+
+static GpStatus sharpen_pixels(ARGB *pixels, int width, int height, float radius, float amount)
+{
+    ARGB *blurred = malloc((SIZE_T)width * height * sizeof(ARGB));
+    SIZE_T i, count = (SIZE_T)width * height;
+    GpStatus status;
+
+    if (!blurred) return OutOfMemory;
+    if ((status = blur_pixels(pixels, width, height, radius, blurred)) == Ok)
+    {
+        for (i = 0; i < count; i++)
+        {
+            int shift;
+            ARGB out = pixels[i] & 0xff000000;
+
+            for (shift = 0; shift <= 16; shift += 8)
+            {
+                float orig = (pixels[i] >> shift) & 0xff, soft = (blurred[i] >> shift) & 0xff;
+                out |= (ARGB)clamp8(orig + (orig - soft) * amount / 100.0f * 2.0f) << shift;
+            }
+            pixels[i] = out;
+        }
+    }
+    free(blurred);
+    return status;
+}
+
+static GpStatus apply_to_pixels(CGpEffect *effect, ARGB *pixels, int width, int height, const RECT *roi)
+{
+    ARGB *copy = NULL;
+    pixel_op op = NULL;
+    GpStatus status = Ok;
+    int x, y;
+
+    switch (effect->type)
+    {
+    case ColorMatrixEffect:        op = op_color_matrix; break;
+    case ColorLUTEffect:           op = op_color_lut; break;
+    case BrightnessContrastEffect: op = op_brightness_contrast; break;
+    case HueSaturationLightnessEffect: op = op_hsl; break;
+    case ColorBalanceEffect:       op = op_color_balance; break;
+    case LevelsEffect:             op = op_levels; break;
+    case TintEffect:               op = op_tint; break;
+    case BlurEffect:
+    case SharpenEffect:
+    case RedEyeCorrectionEffect:
+        break;
+    default:
+        FIXME("effect type %d is not implemented\n", effect->type);
+        return NotImplemented;
+    }
+
+    if (op)
+    {
+        for (y = roi->top; y < roi->bottom; y++)
+            for (x = roi->left; x < roi->right; x++)
+                op(&pixels[(SIZE_T)y * width + x], effect->params);
+        return Ok;
+    }
+
+    if (effect->type == RedEyeCorrectionEffect)
+    {
+        const struct RedEyeCorrectionParams *p = effect->params;
+        UINT i;
+
+        for (i = 0; i < p->numberOfAreas; i++)
+        {
+            RECT area = p->areas[i];
+
+            area.left = max(area.left, roi->left); area.top = max(area.top, roi->top);
+            area.right = min(area.right, roi->right); area.bottom = min(area.bottom, roi->bottom);
+            for (y = area.top; y < area.bottom; y++)
+                for (x = area.left; x < area.right; x++)
+                {
+                    ARGB *px = &pixels[(SIZE_T)y * width + x];
+                    int r = (*px >> 16) & 0xff, g = (*px >> 8) & 0xff, b = *px & 0xff;
+
+                    if (r > g && r > b)
+                        *px = (*px & 0xff00ffff) | (((g + b) / 2) << 16);
+                }
+        }
+        return Ok;
+    }
+
+    /* blur and sharpen look at the whole picture and only the region is replaced */
+    if (!(copy = malloc((SIZE_T)width * height * sizeof(ARGB))))
+        return OutOfMemory;
+    memcpy(copy, pixels, (SIZE_T)width * height * sizeof(ARGB));
+    if (effect->type == BlurEffect)
+    {
+        ARGB *blurred = malloc((SIZE_T)width * height * sizeof(ARGB));
+
+        if (!blurred) { free(copy); return OutOfMemory; }
+        status = blur_pixels(copy, width, height, ((struct BlurParams *)effect->params)->radius, blurred);
+        free(copy);
+        copy = blurred;
+    }
+    else
+    {
+        const struct SharpenParams *p = effect->params;
+        status = sharpen_pixels(copy, width, height, p->radius, p->amount);
+    }
+    if (status == Ok)
+        for (y = roi->top; y < roi->bottom; y++)
+            memcpy(&pixels[(SIZE_T)y * width + roi->left], &copy[(SIZE_T)y * width + roi->left],
+                    (roi->right - roi->left) * sizeof(ARGB));
+    free(copy);
+    return status;
+}
+
+GpStatus effect_apply_bitmap(GpBitmap *bitmap, CGpEffect *effect, const RECT *roi_in)
+{
+    RECT roi = { 0, 0, bitmap->width, bitmap->height };
+    ARGB *pixels;
+    GpStatus status;
+
+    if (roi_in)
+    {
+        roi.left = max(roi_in->left, 0); roi.top = max(roi_in->top, 0);
+        roi.right = min(roi_in->right, bitmap->width); roi.bottom = min(roi_in->bottom, bitmap->height);
+        if (roi.left >= roi.right || roi.top >= roi.bottom) return InvalidParameter;
+    }
+    if (PIXELFORMATBPP(bitmap->format) <= 8 || (bitmap->format & PixelFormatIndexed))
+        return InvalidParameter;
+
+    if (!(pixels = malloc((SIZE_T)bitmap->width * bitmap->height * sizeof(ARGB)))) return OutOfMemory;
+    if ((status = convert_pixels(bitmap->width, bitmap->height, bitmap->width * 4, (BYTE *)pixels,
+            PixelFormat32bppARGB, NULL, bitmap->stride, bitmap->bits, bitmap->format, bitmap->image.palette)) == Ok
+            && (status = apply_to_pixels(effect, pixels, bitmap->width, bitmap->height, &roi)) == Ok)
+        status = convert_pixels(bitmap->width, bitmap->height, bitmap->stride, bitmap->bits, bitmap->format,
+                bitmap->image.palette, bitmap->width * 4, (BYTE *)pixels, PixelFormat32bppARGB, NULL);
+    free(pixels);
+    return status;
+}
+
+GpStatus WINGDIPAPI GdipBitmapApplyEffect(GpBitmap *bitmap, CGpEffect *effect, RECT *roi, BOOL use_aux_data,
+        VOID **aux_data, INT *aux_data_size)
+{
+    TRACE("(%p %p %p %d %p %p)\n", bitmap, effect, roi, use_aux_data, aux_data, aux_data_size);
+
+    if (!bitmap || bitmap->image.type != ImageTypeBitmap || !effect)
+        return InvalidParameter;
+    if (bitmap->lockmode)
+        return WrongState;
+    if (use_aux_data && (!aux_data || !aux_data_size))
+        return InvalidParameter;
+    if (use_aux_data)
+    {
+        *aux_data = NULL;
+        *aux_data_size = 0;
+    }
+    return effect_apply_bitmap(bitmap, effect, roi);
+}
+
+GpStatus WINGDIPAPI GdipBitmapCreateApplyEffect(GpBitmap **inputs, INT count, CGpEffect *effect, RECT *roi,
+        RECT *output_rect, GpBitmap **output, BOOL use_aux_data, VOID **aux_data, INT *aux_data_size)
+{
+    GpBitmap *src, *result = NULL;
+    RECT area;
+    GpStatus status;
+
+    TRACE("(%p %d %p %p %p %p %d %p %p)\n", inputs, count, effect, roi, output_rect, output, use_aux_data,
+            aux_data, aux_data_size);
+
+    if (!inputs || count != 1 || !inputs[0] || inputs[0]->image.type != ImageTypeBitmap || !effect || !output)
+        return InvalidParameter;
+    if (use_aux_data && (!aux_data || !aux_data_size))
+        return InvalidParameter;
+    src = inputs[0];
+    *output = NULL;
+
+    area.left = area.top = 0;
+    area.right = src->width;
+    area.bottom = src->height;
+    if (roi)
+    {
+        area.left = max(roi->left, 0); area.top = max(roi->top, 0);
+        area.right = min(roi->right, src->width); area.bottom = min(roi->bottom, src->height);
+        if (area.left >= area.right || area.top >= area.bottom) return InvalidParameter;
+    }
+
+    /* the result is the region, made a new bitmap */
+    if ((status = GdipCloneBitmapAreaI(area.left, area.top, area.right - area.left, area.bottom - area.top,
+            PixelFormat32bppARGB, src, &result)) != Ok)
+        return status;
+    if ((status = effect_apply_bitmap(result, effect, NULL)) != Ok)
+    {
+        GdipDisposeImage(&result->image);
+        return status;
+    }
+    if (output_rect)
+        *output_rect = area;
+    if (use_aux_data)
+    {
+        *aux_data = NULL;
+        *aux_data_size = 0;
+    }
+    *output = result;
