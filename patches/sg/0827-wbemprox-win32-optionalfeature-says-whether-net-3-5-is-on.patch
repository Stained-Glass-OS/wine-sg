From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wbemprox: Win32_OptionalFeature says whether the .NET Framework 3.5 is on

On Windows 8 and later the .NET Framework 3.5 is an optional feature
("Turn Windows features on or off", NetFx3), and installers of .NET 3.5
programs ask WMI about it: SELECT * FROM Win32_OptionalFeature WHERE
Name='NetFx3', InstallState 1 meaning enabled. The class did not exist, so
the query found nothing, 3.5 was taken for missing and Microsoft's 3.5
setup ran -- which on this system only says to use "Turn Windows features
on or off" (Meedio and MeediOS's installers, David 2026-10-05).

Win32_OptionalFeature now lists NetFx3 and NetFx4-AdvSrvs (Caption,
Description, InstallState, Name). A feature is enabled (1) when its .NET
Framework is registered as installed -- HKLM NDP\v3.5, NDP\v4\Full
Install=1, which Wine Mono's support package writes -- and disabled (2)
otherwise.

Test: test/netfx3-gate.sh (mutant SG_MUTANT_OPTIONALFEATURE).
---
--- a/dlls/wbemprox/builtin.c
+++ b/dlls/wbemprox/builtin.c
@@ -228,6 +228,13 @@
     { L"MACAddress",           CIM_STRING|COL_FLAG_DYNAMIC },
     { L"SettingID",            CIM_STRING|COL_FLAG_DYNAMIC },
 };
+static const struct column col_optionalfeature[] =
+{
+    { L"Caption",      CIM_STRING },
+    { L"Description",  CIM_STRING },
+    { L"InstallState", CIM_UINT32 },
+    { L"Name",         CIM_STRING|COL_FLAG_KEY },
+};
 static const struct column col_operatingsystem[] =
 {
     { L"BootDevice",              CIM_STRING },
@@ -721,6 +728,13 @@
     const WCHAR        *mac_address;
     const WCHAR        *settingid;
 };
+struct record_optionalfeature
+{
+    const WCHAR *caption;
+    const WCHAR *description;
+    UINT32       installstate;
+    const WCHAR *name;
+};
 struct record_operatingsystem
 {
     const WCHAR *bootdevice;
@@ -3787,6 +3801,67 @@
     return wcsdup( L"20230101000000.000000+000" );
 }
 
+/* Stained Glass OS: Win32_OptionalFeature, the features "Turn Windows
+ * features on or off" lists, for the ones programs ask about: the .NET
+ * Framework 3.5 (NetFx3) and 4.x Advanced Services. Installers of .NET 3.5
+ * programs query "Win32_OptionalFeature WHERE Name='NetFx3'" and look for
+ * InstallState 1 (enabled); the class did not exist, so they took 3.5 for
+ * missing and ran Microsoft's 3.5 setup, which only says to use "Turn Windows
+ * features on or off". A feature is enabled when its .NET Framework is
+ * registered as installed (Wine Mono's support package writes NDP\v3.5 and
+ * NDP\v4\Full Install=1), disabled otherwise. */
+static const struct
+{
+    const WCHAR *name;
+    const WCHAR *caption;
+    const WCHAR *ndp_key;
+}
+optional_features[] =
+{
+    { L"NetFx3", L".NET Framework 3.5 (includes .NET 2.0 and 3.0)",
+      L"Software\\Microsoft\\NET Framework Setup\\NDP\\v3.5" },
+    { L"NetFx4-AdvSrvs", L".NET Framework 4.8 Advanced Services",
+      L"Software\\Microsoft\\NET Framework Setup\\NDP\\v4\\Full" },
+};
+
+static UINT32 get_optionalfeature_state( const WCHAR *ndp_key )
+{
+    DWORD installed = 0, size = sizeof(installed);
+
+    if (!RegGetValueW( HKEY_LOCAL_MACHINE, ndp_key, L"Install", RRF_RT_REG_DWORD, NULL, &installed, &size ) &&
+        installed == 1)
+        return 1; /* enabled */
+    return 2; /* disabled */
+}
+
+static enum fill_status fill_optionalfeature( struct table *table, const struct expr *cond )
+{
+    struct record_optionalfeature *rec;
+    enum fill_status status = FILL_STATUS_UNFILTERED;
+    UINT i, row = 0;
+
+    if (!resize_table( table, ARRAY_SIZE(optional_features), sizeof(*rec) )) return FILL_STATUS_FAILED;
+
+    for (i = 0; i < ARRAY_SIZE(optional_features); i++)
+    {
+        rec = (struct record_optionalfeature *)(table->data + row * sizeof(*rec));
+        rec->caption      = optional_features[i].caption;
+        rec->description  = optional_features[i].caption;
+        rec->installstate = get_optionalfeature_state( optional_features[i].ndp_key );
+        rec->name         = optional_features[i].name;
+        if (!match_row( table, row, cond, &status ))
+        {
+            free_row_values( table, row );
+            continue;
+        }
+        row++;
+    }
+
+    TRACE("created %u rows\n", row);
+    table->num_rows = row;
+    return status;
+}
+
 static enum fill_status fill_operatingsystem( struct table *table, const struct expr *cond )
 {
     struct record_operatingsystem *rec;
@@ -4385,6 +4460,9 @@
     { L"Win32_NetworkAdapter", C(col_networkadapter), 0, 0, NULL, fill_networkadapter },
     { L"Win32_NetworkAdapterConfiguration", C(col_networkadapterconfig), 0, 0, NULL, fill_networkadapterconfig },
     { L"Win32_OperatingSystem", C(col_operatingsystem), 0, 0, NULL, fill_operatingsystem },
+#ifndef SG_MUTANT_OPTIONALFEATURE
+    { L"Win32_OptionalFeature", C(col_optionalfeature), 0, 0, NULL, fill_optionalfeature },
+#endif
     { L"Win32_PageFileUsage", C(col_pagefileusage), D(data_pagefileusage) },
     { L"Win32_PhysicalMedia", C(col_physicalmedia), D(data_physicalmedia) },
     { L"Win32_PhysicalMemory", C(col_physicalmemory), 0, 0, NULL, fill_physicalmemory },
