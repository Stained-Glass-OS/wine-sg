+
+/* a computed property's value, a copy */
+static WCHAR *css_value(nsIDOMCSSStyleDeclaration *style, const WCHAR *name)
+{
+    nsAString name_str, value_str;
+    const PRUnichar *value;
+    WCHAR *ret = NULL;
+
+    nsAString_InitDepend(&name_str, name);
+    nsAString_Init(&value_str, NULL);
+    if(NS_SUCCEEDED(nsIDOMCSSStyleDeclaration_GetPropertyValue(style, &name_str, &value_str))) {
+        nsAString_GetData(&value_str, &value);
+        ret = wcsdup(value);
+    }
+    nsAString_Finish(&value_str);
+    nsAString_Finish(&name_str);
+    return ret;
+}
+
+/* "rgb(r, g, b)" or "rgba(r, g, b, a)": a COLORREF, and whether it shows */
+static BOOL parse_color(const WCHAR *value, DWORD *color)
+{
+    int r = 0, g = 0, b = 0;
+    float a = 1.0f;
+
+    *color = 0;
+    if(!value)
+        return FALSE;
+    if(!wcsicmp(value, L"transparent"))
+        return FALSE;
+    if(swscanf(value, L"rgba(%d, %d, %d, %f)", &r, &g, &b, &a) == 4
+       || swscanf(value, L"rgb(%d, %d, %d)", &r, &g, &b) == 3) {
+        *color = RGB(r, g, b);
+        return a > 0.0f;
+    }
+    return FALSE;
+}
+
+static nsIDOMCSSStyleDeclaration *element_computed_style(HTMLDocumentNode *doc, HTMLElement *elem)
+{
+    nsIDOMCSSStyleDeclaration *style = NULL;
+    nsAString pseudo;
+
+    if(!doc->window || !doc->window->base.outer_window || !doc->window->base.outer_window->nswindow
+       || !elem->dom_element)
+        return NULL;
+    nsAString_Init(&pseudo, NULL);
+    nsIDOMWindow_GetComputedStyle(doc->window->base.outer_window->nswindow, elem->dom_element, &pseudo, &style);
+    nsAString_Finish(&pseudo);
+    return style;
+}
+
+static void fill_computed_style(HTMLDocumentNode *doc, IHTMLElement *start, ComputedStyle *cs)
+{
+    IHTMLElement *elem, *parent;
+    nsIDOMCSSStyleDeclaration *style;
+    HTMLElement *impl;
+    WCHAR *v;
+    BOOL first = TRUE;
+
+    IHTMLElement_AddRef(elem = start);
+    while(elem) {
+        BSTR tag = NULL;
+
+        if((impl = unsafe_impl_from_IHTMLElement(elem)) && (style = element_computed_style(doc, impl))) {
+            if(first) {
+                /* what the element's text looks like */
+                if((v = css_value(style, L"font-weight"))) {
+                    cs->weight = !wcsicmp(v, L"bold") ? 700 : !wcsicmp(v, L"normal") ? 400 : wcstol(v, NULL, 10);
+                    free(v);
+                }
+                cs->bold = cs->weight >= 600 ? VARIANT_TRUE : VARIANT_FALSE;
+                if((v = css_value(style, L"font-style"))) {
+                    cs->italic = !wcsicmp(v, L"italic") || !wcsicmp(v, L"oblique") ? VARIANT_TRUE : VARIANT_FALSE;
+                    free(v);
+                }
+                if((v = css_value(style, L"font-size"))) {
+                    /* px, as twips */
+                    cs->size = lroundf(wcstof(v, NULL) * 15.0f);
+                    free(v);
+                }
+                if((v = css_value(style, L"font-family"))) {
+                    WCHAR *s = v, *e;
+                    while(*s == ' ' || *s == '"' || *s == '\'') s++;
+                    for(e = s; *e && *e != ',' && *e != '"' && *e != '\''; e++) ;
+                    *e = 0;
+                    lstrcpynW(cs->face, s, ARRAY_SIZE(cs->face));
+                    free(v);
+                }
+                if((v = css_value(style, L"color"))) {
+                    parse_color(v, &cs->text_color);
+                    free(v);
+                }
+                if((v = css_value(style, L"white-space"))) {
+                    cs->preformatted = !wcsnicmp(v, L"pre", 3) ? VARIANT_TRUE : VARIANT_FALSE;
+                    free(v);
+                }
+                if((v = css_value(style, L"direction"))) {
+                    cs->rtl = cs->block_rtl = !wcsicmp(v, L"rtl") ? VARIANT_TRUE : VARIANT_FALSE;
+                    free(v);
+                }
+            }
+            /* decorations and offsets are drawn by ancestors too */
+            if((v = css_value(style, L"text-decoration-line")) || (v = css_value(style, L"text-decoration"))) {
+                if(wcsstr(v, L"underline")) cs->underline = VARIANT_TRUE;
+                if(wcsstr(v, L"overline")) cs->overline = VARIANT_TRUE;
+                if(wcsstr(v, L"line-through")) cs->strikeout = VARIANT_TRUE;
+                free(v);
+            }
+            if((v = css_value(style, L"vertical-align"))) {
+                if(!wcsicmp(v, L"sub")) cs->subscript = VARIANT_TRUE;
+                if(!wcsicmp(v, L"super")) cs->superscript = VARIANT_TRUE;
+                free(v);
+            }
+            /* the nearest background drawn behind it */
+            if(!cs->has_bg && (v = css_value(style, L"background-color"))) {
+                if(parse_color(v, &cs->bg_color))
+                    cs->has_bg = VARIANT_TRUE;
+                free(v);
+            }
+            nsIDOMCSSStyleDeclaration_Release(style);
+        }
+        if(SUCCEEDED(IHTMLElement_get_tagName(elem, &tag)) && tag) {
+            if(!wcsicmp(tag, L"OL"))
+                cs->ol = VARIANT_TRUE;
+            /* a face given by markup or style, not inherited from the document's default */
+            if(!wcsicmp(tag, L"FONT") || !wcsicmp(tag, L"BODY") || !wcsicmp(tag, L"HTML")) {
+                if(!wcsicmp(tag, L"FONT")) {
+                    VARIANT face;
+                    BSTR attr = SysAllocString(L"face");
+
+                    V_VT(&face) = VT_EMPTY;
+                    if(SUCCEEDED(IHTMLElement_getAttribute(elem, attr, 0, &face)) && V_VT(&face) == VT_BSTR
+                       && V_BSTR(&face) && *V_BSTR(&face))
+                        cs->explicit_face = VARIANT_TRUE;
+                    VariantClear(&face);
+                    SysFreeString(attr);
+                }
+            }else {
+                IHTMLStyle *inline_style = NULL;
+                BSTR family = NULL;
+                if(SUCCEEDED(IHTMLElement_get_style(elem, &inline_style)) && inline_style) {
+                    if(SUCCEEDED(IHTMLStyle_get_fontFamily(inline_style, &family)) && family && *family)
+                        cs->explicit_face = VARIANT_TRUE;
+                    SysFreeString(family);
+                    IHTMLStyle_Release(inline_style);
+                }
+            }
+            SysFreeString(tag);
+        }
+        first = FALSE;
+        parent = NULL;
+        IHTMLElement_get_parentElement(elem, &parent);
+        IHTMLElement_Release(elem);
+        elem = parent;
+    }
+    if(!cs->has_bg)
+        cs->bg_color = RGB(255, 255, 255);
+}
+
+HRESULT create_computed_style_at(HTMLDocumentNode *doc, IMarkupPointer *pointer, IHTMLComputedStyle **ret)
+{
+    IMarkupPointer2 *pointer2;
+    IHTMLElement *elem = NULL;
+    ComputedStyle *cs;
+    HRESULT hres;
+
+    if(FAILED(hres = IMarkupPointer_QueryInterface(pointer, &IID_IMarkupPointer2, (void**)&pointer2)))
+        return E_INVALIDARG;
+    hres = IMarkupPointer2_CurrentScope(pointer2, &elem);
+    IMarkupPointer2_Release(pointer2);
+    if(FAILED(hres) || !elem)
+        return FAILED(hres) ? hres : E_INVALIDARG;
+    if(!(cs = calloc(1, sizeof(*cs)))) {
+        IHTMLElement_Release(elem);
+        return E_OUTOFMEMORY;
+    }
+    cs->IHTMLComputedStyle_iface.lpVtbl = &ComputedStyleVtbl;
+    cs->ref = 1;
+    cs->weight = 400;
+#ifndef SG_MUTANT_COMPSTYLE_DEFAULTS
+    fill_computed_style(doc, elem, cs);
+#endif
+    IHTMLElement_Release(elem);
+    *ret = &cs->IHTMLComputedStyle_iface;
+    return S_OK;
+}
