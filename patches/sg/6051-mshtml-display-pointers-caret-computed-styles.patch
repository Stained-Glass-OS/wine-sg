+    DisplayPointer_PositionMarkupPointer,
+    DisplayPointer_MoveToPointer,
+    DisplayPointer_SetPointerGravity,
+    DisplayPointer_GetPointerGravity,
+    DisplayPointer_SetDisplayGravity,
+    DisplayPointer_GetDisplayGravity,
+    DisplayPointer_IsPositioned,
+    DisplayPointer_Unposition,
+    DisplayPointer_IsEqualTo,
+    DisplayPointer_IsLeftOf,
+    DisplayPointer_IsRightOf,
+    DisplayPointer_IsAtBOL,
+    DisplayPointer_MoveToMarkupPointer,
+    DisplayPointer_ScrollIntoView,
+    DisplayPointer_GetLineInfo,
+    DisplayPointer_GetFlowElement,
+    DisplayPointer_QueryBreaks
+};
+
+HRESULT create_display_pointer(HTMLDocumentNode *doc, IDisplayPointer **ret)
+{
+    DisplayPointer *pointer;
+    HRESULT hres;
+
+    if(!(pointer = calloc(1, sizeof(*pointer))))
+        return E_OUTOFMEMORY;
+    if(FAILED(hres = create_markup_pointer(doc, &pointer->pointer))) {
+        free(pointer);
+        return hres;
+    }
+    pointer->IDisplayPointer_iface.lpVtbl = &DisplayPointerVtbl;
+    pointer->ref = 1;
+    pointer->doc = doc;
+    IHTMLDOMNode_AddRef(&doc->node.IHTMLDOMNode_iface);
+    pointer->gravity = POINTER_GRAVITY_Left;
+    pointer->display_gravity = DISPLAY_GRAVITY_PreviousLine;
+    *ret = &pointer->IDisplayPointer_iface;
+    return S_OK;
+}
