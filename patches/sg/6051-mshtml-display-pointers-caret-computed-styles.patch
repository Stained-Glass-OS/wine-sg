+
+static HRESULT WINAPI HTMLCaret_InsertText(IHTMLCaret *iface, OLECHAR *text, LONG len)
+{
+    HTMLCaret *This = impl_from_IHTMLCaret(iface);
+    IMarkupPointer *mp;
+    nsIDOMNode *node, *child;
+    LONG off;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s %ld)\n", This, debugstr_wn(text, len < 0 ? -1 : len), len);
+
+    if(!text)
+        return E_INVALIDARG;
+    if(len < 0)
+        len = lstrlenW(text);
+    if(!caret_get(This, &node, &off))
+        return E_FAIL;
+    if(FAILED(hres = create_markup_pointer(This->doc, &mp))) {
+        nsIDOMNode_Release(node);
+        return hres;
+    }
+    hres = markup_pointer_set_position(mp, node, off);
+    if(SUCCEEDED(hres))
+        hres = markup_insert_text(text, len, mp);
+    if(SUCCEEDED(hres)) {
+        /* the caret goes after what was inserted: the pointer stayed before it */
+        MARKUP_CONTEXT_TYPE ctx;
+        LONG cch = len;
+        nsIDOMNode *after;
+        LONG after_off;
+
+        if(SUCCEEDED(IMarkupPointer_Right(mp, TRUE, &ctx, NULL, &cch, NULL)) && cch == len
+           && markup_pointer_get_position(mp, &after, &after_off)) {
+            caret_set(This, after, after_off);
+            nsIDOMNode_Release(after);
+            IMarkupPointer_Release(mp);
+            nsIDOMNode_Release(node);
+            return S_OK;
+        }
+    }
+    IMarkupPointer_Release(mp);
+    if(SUCCEEDED(hres)) {
+        /* the caret goes after what was inserted */
+        if(node_type(node) == TEXT_NODE)
+            caret_set(This, node, off + len);
+        else if((child = child_at(node, off)) && node_type(child) == TEXT_NODE && text_length(child) >= (UINT32)len) {
+            caret_set(This, child, len);
+            nsIDOMNode_Release(child);
+        }else {
+            if(child)
+                nsIDOMNode_Release(child);
+            if((child = child_at(node, off - 1)) && node_type(child) == TEXT_NODE)
+                caret_set(This, child, text_length(child));
+            if(child)
+                nsIDOMNode_Release(child);
+        }
+    }
+    nsIDOMNode_Release(node);
+    return hres;
+}
+
+static HRESULT WINAPI HTMLCaret_ScrollIntoView(IHTMLCaret *iface)
+{
+    HTMLCaret *This = impl_from_IHTMLCaret(iface);
+    nsIDOMNode *node;
+    LONG off;
+    HRESULT hres;
+
+    if(!caret_get(This, &node, &off))
+        return S_OK;
+    hres = scroll_to_node(node);
+    nsIDOMNode_Release(node);
+    return hres;
+}
+
+static HRESULT WINAPI HTMLCaret_GetLocation(IHTMLCaret *iface, POINT *pt, BOOL translate)
+{
+    HTMLCaret *This = impl_from_IHTMLCaret(iface);
+    struct frect r;
+    nsIDOMNode *node;
+    LONG off;
+    BOOL ok;
+
+    TRACE("(%p)->(%p %x)\n", This, pt, translate);
+
+    if(!pt) return E_POINTER;
+    if(!caret_get(This, &node, &off))
+        return E_FAIL;
+    ok = position_rect(This->doc, node, off, &r);
+    nsIDOMNode_Release(node);
+    if(!ok)
+        return E_FAIL;
+    pt->x = lroundf(r.left);
+    pt->y = lroundf(r.top);
+    /* the content's coordinates, or the screen's */
+    return display_transform_point(This->doc, pt, COORD_SYSTEM_FRAME,
+                                   translate ? COORD_SYSTEM_GLOBAL : COORD_SYSTEM_CONTENT, NULL);
+}
