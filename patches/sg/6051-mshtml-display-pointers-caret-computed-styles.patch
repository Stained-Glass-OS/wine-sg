+static const IHTMLComputedStyleVtbl ComputedStyleVtbl;
+
+static inline ComputedStyle *impl_from_IHTMLComputedStyle(IHTMLComputedStyle *iface)
+{
+    return CONTAINING_RECORD(iface, ComputedStyle, IHTMLComputedStyle_iface);
+}
+
+static HRESULT WINAPI ComputedStyle_QueryInterface(IHTMLComputedStyle *iface, REFIID riid, void **ppv)
+{
+    ComputedStyle *This = impl_from_IHTMLComputedStyle(iface);
+
+    if(IsEqualGUID(&IID_IUnknown, riid) || IsEqualGUID(&IID_IHTMLComputedStyle, riid)) {
+        *ppv = &This->IHTMLComputedStyle_iface;
+        IHTMLComputedStyle_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ComputedStyle_AddRef(IHTMLComputedStyle *iface)
+{
+    return InterlockedIncrement(&impl_from_IHTMLComputedStyle(iface)->ref);
+}
+
+static ULONG WINAPI ComputedStyle_Release(IHTMLComputedStyle *iface)
+{
+    ComputedStyle *This = impl_from_IHTMLComputedStyle(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    if(!ref)
+        free(This);
+    return ref;
+}
+
+#define STYLE_GETTER(name, type, field) \
+    static HRESULT WINAPI ComputedStyle_get_##name(IHTMLComputedStyle *iface, type *p) \
+    { \
+        if(!p) return E_POINTER; \
+        *p = impl_from_IHTMLComputedStyle(iface)->field; \
+        return S_OK; \
+    }
+
