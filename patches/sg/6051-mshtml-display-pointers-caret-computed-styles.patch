+static HRESULT WINAPI ComputedStyle_get_fontName(IHTMLComputedStyle *iface, WCHAR *p)
+{
+    if(!p) return E_POINTER;
+    lstrcpyW(p, impl_from_IHTMLComputedStyle(iface)->face);
+    return S_OK;
+}
+
+static HRESULT WINAPI ComputedStyle_IsEqual(IHTMLComputedStyle *iface, IHTMLComputedStyle *other, VARIANT_BOOL *equal)
+{
+    ComputedStyle *This = impl_from_IHTMLComputedStyle(iface), *that;
+
+    if(!other || !equal) return E_INVALIDARG;
+    if(other->lpVtbl != &ComputedStyleVtbl) return E_INVALIDARG;
+    that = impl_from_IHTMLComputedStyle(other);
+    *equal = This->bold == that->bold && This->italic == that->italic && This->underline == that->underline
+        && This->overline == that->overline && This->strikeout == that->strikeout
+        && This->subscript == that->subscript && This->superscript == that->superscript
+        && This->explicit_face == that->explicit_face && This->has_bg == that->has_bg
+        && This->preformatted == that->preformatted && This->rtl == that->rtl
+        && This->block_rtl == that->block_rtl && This->ol == that->ol && This->weight == that->weight
+        && This->size == that->size && !wcsicmp(This->face, that->face) && This->text_color == that->text_color
+        && This->bg_color == that->bg_color ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
