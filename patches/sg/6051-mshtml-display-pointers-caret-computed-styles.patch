+/*
+ * A display pointer is a markup pointer placed by layout: hit testing a
+ * point finds the character it is on, from the characters' boxes (Gecko's
+ * ranges' client rects), and lines are found the same way, above and below
+ * a position's box. The caret is the document's selection, collapsed. A
+ * computed style is the Gecko computed style of the element a markup
+ * pointer is in.
+ */
+
+#include <stdarg.h>
+#include <math.h>
+
+#define COBJMACROS
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "ole2.h"
+
+#include "wine/debug.h"
+
+#include "mshtml_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mshtml);
+
+struct frect
+{
+    float left, top, right, bottom;
+};
+
+static UINT16 node_type(nsIDOMNode *node)
+{
+    UINT16 type = 0;
+    if(node)
+        nsIDOMNode_GetNodeType(node, &type);
+    return type;
+}
+
+static UINT32 text_length(nsIDOMNode *node)
+{
+    nsIDOMText *nstext;
+    UINT32 ret = 0;
+
+    if(NS_FAILED(nsIDOMNode_QueryInterface(node, &IID_nsIDOMText, (void**)&nstext)))
+        return 0;
+    nsIDOMText_GetLength(nstext, &ret);
+    nsIDOMText_Release(nstext);
+    return ret;
+}
+
+static nsIDOMNode *child_at(nsIDOMNode *node, LONG off)
+{
+    nsIDOMNodeList *list = NULL;
+    nsIDOMNode *ret = NULL;
+
+    if(off < 0 || NS_FAILED(nsIDOMNode_GetChildNodes(node, &list)) || !list)
+        return NULL;
+    nsIDOMNodeList_Item(list, off, &ret);
+    nsIDOMNodeList_Release(list);
+    return ret;
+}
+
+static LONG child_index(nsIDOMNode *parent, nsIDOMNode *child)
+{
+    nsIDOMNodeList *list = NULL;
+    nsIDOMNode *node;
+    UINT32 count = 0, i;
+    LONG ret = -1;
+
+    if(NS_FAILED(nsIDOMNode_GetChildNodes(parent, &list)) || !list)
+        return -1;
+    nsIDOMNodeList_GetLength(list, &count);
+    for(i = 0; i < count && ret < 0; i++) {
+        if(NS_FAILED(nsIDOMNodeList_Item(list, i, &node)) || !node)
+            continue;
+        if(node == child)
+            ret = i;
+        nsIDOMNode_Release(node);
+    }
+    nsIDOMNodeList_Release(list);
+    return ret;
+}
+
+static BOOL range_rect(nsIDOMRange *range, struct frect *r)
+{
+    nsIDOMClientRect *rect = NULL;
+    BOOL ret = FALSE;
+
+    if(NS_SUCCEEDED(nsIDOMRange_GetBoundingClientRect(range, &rect)) && rect) {
+        nsIDOMClientRect_GetLeft(rect, &r->left);
+        nsIDOMClientRect_GetTop(rect, &r->top);
+        nsIDOMClientRect_GetRight(rect, &r->right);
+        nsIDOMClientRect_GetBottom(rect, &r->bottom);
+        nsIDOMClientRect_Release(rect);
+        ret = r->bottom > r->top || r->right > r->left;
+    }
+    return ret;
+}
+
+/* the box of a text node's character, in the view's (client) coordinates */
+static BOOL char_rect(HTMLDocumentNode *doc, nsIDOMNode *text, UINT32 i, struct frect *r)
+{
+    nsIDOMRange *range = NULL;
+    BOOL ret = FALSE;
+
+    if(NS_FAILED(nsIDOMDocument_CreateRange(doc->dom_document, &range)) || !range)
+        return FALSE;
+    if(NS_SUCCEEDED(nsIDOMRange_SetStart(range, text, i)) && NS_SUCCEEDED(nsIDOMRange_SetEnd(range, text, i + 1)))
+        ret = range_rect(range, r);
+    nsIDOMRange_Release(range);
+    return ret;
+}
+
+static BOOL node_rect(HTMLDocumentNode *doc, nsIDOMNode *node, struct frect *r)
+{
+    nsIDOMRange *range = NULL;
+    BOOL ret = FALSE;
+
+    if(NS_FAILED(nsIDOMDocument_CreateRange(doc->dom_document, &range)) || !range)
+        return FALSE;
+    if(NS_SUCCEEDED(nsIDOMRange_SelectNode(range, node)))
+        ret = range_rect(range, r);
+    nsIDOMRange_Release(range);
+    return ret;
+}
+
+/* a position's caret box: zero wide, as tall as the character next to it */
+static BOOL position_rect(HTMLDocumentNode *doc, nsIDOMNode *node, LONG off, struct frect *r)
+{
+    nsIDOMNode *child;
+    UINT32 len;
+    BOOL ret = FALSE;
+
+    if(node_type(node) == TEXT_NODE) {
+        len = text_length(node);
+        if((UINT32)off < len && char_rect(doc, node, off, r)) {
+            r->right = r->left;
+            return TRUE;
+        }
+        if(off > 0 && char_rect(doc, node, off - 1, r)) {
+            r->left = r->right;
+            return TRUE;
+        }
+        return node_rect(doc, node, r);
+    }
+    if((child = child_at(node, off))) {
+        if(node_type(child) == TEXT_NODE && text_length(child))
+            ret = position_rect(doc, child, 0, r);
+        else if((ret = node_rect(doc, child, r)))
+            r->right = r->left;
+        nsIDOMNode_Release(child);
+        if(ret)
+            return TRUE;
+    }
+    if(off > 0 && (child = child_at(node, off - 1))) {
+        if(node_type(child) == TEXT_NODE && text_length(child))
+            ret = position_rect(doc, child, text_length(child), r);
+        else if((ret = node_rect(doc, child, r)))
+            r->left = r->right;
+        nsIDOMNode_Release(child);
+        if(ret)
+            return TRUE;
+    }
+    if((ret = node_rect(doc, node, r)))
+        r->right = r->left;
+    return ret;
+}
+
+/* hit testing: the character nearest a point among an element's text */
+struct hit
+{
+    nsIDOMNode *node;   /* referenced */
+    LONG off;
+    float dy, dx;       /* distances from the line, and along it */
+    BOOL glyph;
+};
+
+static void hit_text(HTMLDocumentNode *doc, nsIDOMNode *text, float x, float y, struct hit *best)
+{
+    UINT32 len = text_length(text), i;
+    struct frect r;
+
+    for(i = 0; i < len; i++) {
+        float dy, dx;
+
+        if(!char_rect(doc, text, i, &r) || r.right <= r.left)
+            continue;
+        TRACE("char %u: %f,%f-%f,%f (point %f,%f)\n", i, r.left, r.top, r.right, r.bottom, x, y);
+        dy = y < r.top ? r.top - y : y >= r.bottom ? y - r.bottom + 1 : 0;
+        dx = x < r.left ? r.left - x : x >= r.right ? x - r.right + 1 : 0;
+#ifdef SG_MUTANT_DISPLAY_FIRST_CHAR
+        dy = dx = 0;
+        if(best->node) continue;
+#endif
+        if(best->node && (dy > best->dy || (dy == best->dy && dx >= best->dx)))
+            continue;
+        if(best->node)
+            nsIDOMNode_Release(best->node);
+        nsIDOMNode_AddRef(best->node = text);
+        /* the position before the character, or after it past its middle */
+        best->off = x < (r.left + r.right) / 2 ? i : i + 1;
+        best->dy = dy;
+        best->dx = dx;
+        best->glyph = !dx && !dy;
+    }
+}
+
+static void hit_tree(HTMLDocumentNode *doc, nsIDOMNode *node, float x, float y, struct hit *best)
+{
+    nsIDOMNode *child = NULL, *next;
+
+    if(node_type(node) == TEXT_NODE) {
+        hit_text(doc, node, x, y, best);
+        return;
+    }
+    nsIDOMNode_GetFirstChild(node, &child);
+    while(child) {
+        hit_tree(doc, child, x, y, best);
+        next = NULL;
+        nsIDOMNode_GetNextSibling(child, &next);
+        nsIDOMNode_Release(child);
+        child = next;
+    }
+}
+
+static HRESULT hit_test(HTMLDocumentNode *doc, float x, float y, nsIDOMNode **node, LONG *off, BOOL *glyph)
+{
+    nsIDOMElement *nselem = NULL;
+    nsIDOMHTMLElement *body = NULL;
+    nsIDOMNode *scope = NULL, *parent;
+    struct hit best = { 0 };
+    int depth;
+
+    nsIDOMDocument_ElementFromPoint(doc->dom_document, x, y, &nselem);
+    if(nselem) {
+        nsIDOMElement_QueryInterface(nselem, &IID_nsIDOMNode, (void**)&scope);
+        nsIDOMElement_Release(nselem);
+    }
+    if(!scope && doc->html_document && NS_SUCCEEDED(nsIDOMHTMLDocument_GetBody(doc->html_document, &body)) && body) {
+        nsIDOMHTMLElement_QueryInterface(body, &IID_nsIDOMNode, (void**)&scope);
+        nsIDOMHTMLElement_Release(body);
+    }
+    if(!scope)
+        return E_FAIL;
+
+    /* the element's text, else its parents' (a point past a line's end is on the block) */
+    for(depth = 0; depth < 64; depth++) {
+        hit_tree(doc, scope, x, y, &best);
+        if(best.node)
+            break;
+        parent = NULL;
+        nsIDOMNode_GetParentNode(scope, &parent);
+        if(!parent || node_type(parent) == DOCUMENT_NODE) {
+            if(parent)
+                nsIDOMNode_Release(parent);
+            break;
+        }
+        nsIDOMNode_Release(scope);
+        scope = parent;
+    }
+    if(best.node) {
+        nsIDOMNode_Release(scope);
+        *node = best.node;
+        *off = best.off;
+        *glyph = best.glyph;
+        return S_OK;
+    }
+    /* no text: the start of the element */
+    *node = scope;
+    *off = 0;
+    *glyph = FALSE;
+    return S_OK;
+}
+
+/***********************************************************************
+ *          ILineInfo
+ */
+
+typedef struct {
+    ILineInfo ILineInfo_iface;
+    LONG ref;
+    LONG x, baseline, descent, height;
+} LineInfo;
+
+static inline LineInfo *impl_from_ILineInfo(ILineInfo *iface)
+{
+    return CONTAINING_RECORD(iface, LineInfo, ILineInfo_iface);
+}
+
+static HRESULT WINAPI LineInfo_QueryInterface(ILineInfo *iface, REFIID riid, void **ppv)
+{
+    LineInfo *This = impl_from_ILineInfo(iface);
+
+    if(IsEqualGUID(&IID_IUnknown, riid) || IsEqualGUID(&IID_ILineInfo, riid)) {
+        *ppv = &This->ILineInfo_iface;
+        ILineInfo_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI LineInfo_AddRef(ILineInfo *iface)
+{
+    return InterlockedIncrement(&impl_from_ILineInfo(iface)->ref);
+}
+
+static ULONG WINAPI LineInfo_Release(ILineInfo *iface)
+{
+    LineInfo *This = impl_from_ILineInfo(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    if(!ref)
+        free(This);
+    return ref;
+}
+
+static HRESULT WINAPI LineInfo_get_x(ILineInfo *iface, LONG *p)
+{
+    if(!p) return E_POINTER;
+    *p = impl_from_ILineInfo(iface)->x;
+    return S_OK;
+}
+
+static HRESULT WINAPI LineInfo_get_baseLine(ILineInfo *iface, LONG *p)
+{
+    if(!p) return E_POINTER;
+    *p = impl_from_ILineInfo(iface)->baseline;
+    return S_OK;
+}
+
+static HRESULT WINAPI LineInfo_get_textDescent(ILineInfo *iface, LONG *p)
+{
+    if(!p) return E_POINTER;
+    *p = impl_from_ILineInfo(iface)->descent;
+    return S_OK;
+}
+
+static HRESULT WINAPI LineInfo_get_textHeight(ILineInfo *iface, LONG *p)
+{
+    if(!p) return E_POINTER;
+    *p = impl_from_ILineInfo(iface)->height;
+    return S_OK;
+}
+
+static HRESULT WINAPI LineInfo_get_lineDirection(ILineInfo *iface, LONG *p)
+{
+    if(!p) return E_POINTER;
+    *p = LINE_DIRECTION_LeftToRight;
+    return S_OK;
+}
+
+static const ILineInfoVtbl LineInfoVtbl = {
+    LineInfo_QueryInterface,
+    LineInfo_AddRef,
+    LineInfo_Release,
+    LineInfo_get_x,
+    LineInfo_get_baseLine,
+    LineInfo_get_textDescent,
+    LineInfo_get_textHeight,
+    LineInfo_get_lineDirection
+};
+
+/***********************************************************************
+ *          IDisplayPointer
+ */
+
+typedef struct {
+    IDisplayPointer IDisplayPointer_iface;
+    LONG ref;
+    HTMLDocumentNode *doc;
+    IMarkupPointer *pointer;    /* where it is, if positioned */
+    POINTER_GRAVITY gravity;
+    DISPLAY_GRAVITY display_gravity;
+} DisplayPointer;
+
+static const IDisplayPointerVtbl DisplayPointerVtbl;
+
+static inline DisplayPointer *impl_from_IDisplayPointer(IDisplayPointer *iface)
+{
+    return CONTAINING_RECORD(iface, DisplayPointer, IDisplayPointer_iface);
+}
+
+static DisplayPointer *unsafe_display_pointer(IDisplayPointer *iface)
+{
+    return iface && iface->lpVtbl == &DisplayPointerVtbl ? impl_from_IDisplayPointer(iface) : NULL;
+}
+
+static BOOL dp_get(DisplayPointer *This, nsIDOMNode **node, LONG *off)
+{
+    return markup_pointer_get_position(This->pointer, node, off);
+}
+
+static HRESULT dp_set(DisplayPointer *This, nsIDOMNode *node, LONG off)
+{
+    return markup_pointer_set_position(This->pointer, node, off);
+}
+
+static BOOL dp_rect(DisplayPointer *This, struct frect *r)
+{
+    nsIDOMNode *node;
+    LONG off;
+    BOOL ret;
+
+    if(!dp_get(This, &node, &off))
+        return FALSE;
+    ret = position_rect(This->doc, node, off, r);
+    nsIDOMNode_Release(node);
+    return ret;
+}
+
+static HRESULT WINAPI DisplayPointer_QueryInterface(IDisplayPointer *iface, REFIID riid, void **ppv)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface);
+
+    if(IsEqualGUID(&IID_IUnknown, riid) || IsEqualGUID(&IID_IDisplayPointer, riid)) {
+        *ppv = &This->IDisplayPointer_iface;
+        IDisplayPointer_AddRef(iface);
+        return S_OK;
+    }
+    WARN("(%p)->(%s)\n", This, debugstr_mshtml_guid(riid));
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI DisplayPointer_AddRef(IDisplayPointer *iface)
+{
+    return InterlockedIncrement(&impl_from_IDisplayPointer(iface)->ref);
+}
+
+static ULONG WINAPI DisplayPointer_Release(IDisplayPointer *iface)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        IMarkupPointer_Release(This->pointer);
+        IHTMLDOMNode_Release(&This->doc->node.IHTMLDOMNode_iface);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI DisplayPointer_MoveToPoint(IDisplayPointer *iface, POINT pt, COORD_SYSTEM system,
+        IHTMLElement *context, DWORD options, DWORD *results)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface);
+    nsIDOMNode *node;
+    LONG off;
+    BOOL glyph;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s %d %p %#lx %p)\n", This, wine_dbgstr_point(&pt), system, context, options, results);
+
+    if(FAILED(hres = display_transform_point(This->doc, &pt, system, COORD_SYSTEM_FRAME, context)))
+        return hres;
+    if(FAILED(hres = hit_test(This->doc, pt.x, pt.y, &node, &off, &glyph)))
+        return hres;
+    hres = dp_set(This, node, off);
+    nsIDOMNode_Release(node);
+    if(results)
+        *results = glyph ? HT_RESULTS_Glyph : 0;
+    return hres;
+}
+
+/* the position on the line above or below, or at a line's ends, or a window's edge */
+static HRESULT WINAPI DisplayPointer_MoveUnit(IDisplayPointer *iface, DISPLAY_MOVEUNIT unit, LONG xpos)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface);
+    struct frect r;
+    float x, y;
+    nsIDOMNode *node;
+    LONG off;
+    BOOL glyph;
+    HRESULT hres;
+    RECT client = { 0 };
+
+    TRACE("(%p)->(%d %ld)\n", This, unit, xpos);
+
+    if(!dp_rect(This, &r))
+        return E_FAIL;
+    if(This->doc->doc_obj && This->doc->doc_obj->hwnd)
+        GetClientRect(This->doc->doc_obj->hwnd, &client);
+    x = r.left;
+    if(xpos != -1) {
+        /* xpos is in the content's coordinates */
+        POINT pt = { xpos, 0 };
+        display_transform_point(This->doc, &pt, COORD_SYSTEM_CONTENT, COORD_SYSTEM_FRAME, NULL);
+        x = pt.x;
+    }
+    y = (r.top + r.bottom) / 2;
+    switch(unit) {
+    case DISPLAY_MOVEUNIT_PreviousLine:
+        y = r.top - (r.bottom - r.top) / 2;
+        break;
+    case DISPLAY_MOVEUNIT_NextLine:
+        y = r.bottom + (r.bottom - r.top) / 2;
+        break;
+    case DISPLAY_MOVEUNIT_CurrentLineStart:
+        x = -100000;
+        break;
+    case DISPLAY_MOVEUNIT_CurrentLineEnd:
+        x = 100000;
+        break;
+    case DISPLAY_MOVEUNIT_TopOfWindow:
+        y = 1;
+        break;
+    case DISPLAY_MOVEUNIT_BottomOfWindow:
+        y = client.bottom > 1 ? client.bottom - 2 : r.bottom;
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    if(unit == DISPLAY_MOVEUNIT_CurrentLineStart || unit == DISPLAY_MOVEUNIT_CurrentLineEnd) {
+        /* along the line, within its block's text */
+        struct hit best = { 0 };
+        nsIDOMNode *cur, *scope = NULL;
+        IHTMLElement *flow = NULL;
+        HTMLElement *elem;
+
+        if(SUCCEEDED(IDisplayPointer_GetFlowElement(iface, &flow)) && flow
+           && (elem = unsafe_impl_from_IHTMLElement(flow)) && elem->dom_element)
+            nsIDOMElement_QueryInterface(elem->dom_element, &IID_nsIDOMNode, (void**)&scope);
+        if(flow)
+            IHTMLElement_Release(flow);
+        if(!scope) {
+            if(!dp_get(This, &cur, &off))
+                return E_FAIL;
+            scope = cur;
+        }
+        hit_tree(This->doc, scope, x, y, &best);
+        nsIDOMNode_Release(scope);
+        if(!best.node)
+            return S_OK;
+        hres = dp_set(This, best.node, best.off);
+        nsIDOMNode_Release(best.node);
+        return hres;
+    }
+    if(y < 0)
+        return S_FALSE;
+    if(FAILED(hres = hit_test(This->doc, x, y, &node, &off, &glyph)))
+        return hres;
+    hres = dp_set(This, node, off);
+    nsIDOMNode_Release(node);
+    return hres;
+}
+
+static HRESULT WINAPI DisplayPointer_PositionMarkupPointer(IDisplayPointer *iface, IMarkupPointer *pointer)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface);
+
+    TRACE("(%p)->(%p)\n", This, pointer);
+
+    if(!pointer)
+        return E_INVALIDARG;
+    return IMarkupPointer_MoveToPointer(pointer, This->pointer);
+}
+
+static HRESULT WINAPI DisplayPointer_MoveToPointer(IDisplayPointer *iface, IDisplayPointer *other)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface), *that = unsafe_display_pointer(other);
+
+    TRACE("(%p)->(%p)\n", This, other);
+
+    if(!that)
+        return E_INVALIDARG;
+    This->display_gravity = that->display_gravity;
+    return IMarkupPointer_MoveToPointer(This->pointer, that->pointer);
+}
+
+static HRESULT WINAPI DisplayPointer_SetPointerGravity(IDisplayPointer *iface, POINTER_GRAVITY gravity)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface);
+    This->gravity = gravity;
+    return IMarkupPointer_SetGravity(This->pointer, gravity);
+}
+
+static HRESULT WINAPI DisplayPointer_GetPointerGravity(IDisplayPointer *iface, POINTER_GRAVITY *gravity)
+{
+    if(!gravity) return E_POINTER;
+    *gravity = impl_from_IDisplayPointer(iface)->gravity;
+    return S_OK;
+}
+
+static HRESULT WINAPI DisplayPointer_SetDisplayGravity(IDisplayPointer *iface, DISPLAY_GRAVITY gravity)
+{
+    if(gravity != DISPLAY_GRAVITY_PreviousLine && gravity != DISPLAY_GRAVITY_NextLine)
+        return E_INVALIDARG;
+    impl_from_IDisplayPointer(iface)->display_gravity = gravity;
+    return S_OK;
+}
+
+static HRESULT WINAPI DisplayPointer_GetDisplayGravity(IDisplayPointer *iface, DISPLAY_GRAVITY *gravity)
+{
+    if(!gravity) return E_POINTER;
+    *gravity = impl_from_IDisplayPointer(iface)->display_gravity;
+    return S_OK;
+}
+
