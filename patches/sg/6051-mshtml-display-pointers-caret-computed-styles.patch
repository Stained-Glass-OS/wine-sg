+}
+
+static HRESULT dp_compare(IDisplayPointer *iface, IDisplayPointer *other, int *cmp)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface), *that = unsafe_display_pointer(other);
+
+    if(!that)
+        return E_INVALIDARG;
+    return markup_pointer_compare(This->pointer, that->pointer, cmp);
+}
+
+static HRESULT WINAPI DisplayPointer_IsEqualTo(IDisplayPointer *iface, IDisplayPointer *other, BOOL *ret)
+{
+    int cmp;
+    HRESULT hres;
+
+    if(!ret) return E_POINTER;
+    if(FAILED(hres = dp_compare(iface, other, &cmp))) return hres;
+    *ret = !cmp;
+    return S_OK;
+}
+
+static HRESULT WINAPI DisplayPointer_IsLeftOf(IDisplayPointer *iface, IDisplayPointer *other, BOOL *ret)
+{
+    int cmp;
+    HRESULT hres;
+
+    if(!ret) return E_POINTER;
+    if(FAILED(hres = dp_compare(iface, other, &cmp))) return hres;
+    *ret = cmp < 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI DisplayPointer_IsRightOf(IDisplayPointer *iface, IDisplayPointer *other, BOOL *ret)
+{
+    int cmp;
+    HRESULT hres;
+
+    if(!ret) return E_POINTER;
+    if(FAILED(hres = dp_compare(iface, other, &cmp))) return hres;
+    *ret = cmp > 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI DisplayPointer_IsAtBOL(IDisplayPointer *iface, BOOL *bol)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface);
+    IDisplayPointer *start;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, bol);
+
+    if(!bol) return E_POINTER;
+    /* at the line's start: where CurrentLineStart would move it */
+    if(FAILED(hres = create_display_pointer(This->doc, &start)))
+        return hres;
+    hres = IDisplayPointer_MoveToPointer(start, iface);
+    if(SUCCEEDED(hres))
+        hres = IDisplayPointer_MoveUnit(start, DISPLAY_MOVEUNIT_CurrentLineStart, -1);
+    if(SUCCEEDED(hres))
+        hres = IDisplayPointer_IsEqualTo(start, iface, bol);
+    IDisplayPointer_Release(start);
+    return hres;
+}
+
+static HRESULT WINAPI DisplayPointer_MoveToMarkupPointer(IDisplayPointer *iface, IMarkupPointer *pointer,
+        IDisplayPointer *line_context)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface), *context = unsafe_display_pointer(line_context);
+
+    TRACE("(%p)->(%p %p)\n", This, pointer, line_context);
+
+    if(!pointer)
+        return E_INVALIDARG;
+    if(context)
+        This->display_gravity = context->display_gravity;
+    return IMarkupPointer_MoveToPointer(This->pointer, pointer);
+}
+
+static HRESULT scroll_to_node(nsIDOMNode *node)
+{
+    HTMLDOMNode *dom_node;
+    IHTMLElement *elem;
+    nsIDOMNode *parent = NULL;
+    VARIANT top;
+    HRESULT hres;
+
+    if(node_type(node) == TEXT_NODE) {
+        nsIDOMNode_GetParentNode(node, &parent);
+        node = parent;
+    }
+    if(!node)
+        return E_FAIL;
+    hres = get_node(node, TRUE, &dom_node);
+    if(parent)
+        nsIDOMNode_Release(parent);
+    if(FAILED(hres))
+        return hres;
+    hres = IHTMLDOMNode_QueryInterface(&dom_node->IHTMLDOMNode_iface, &IID_IHTMLElement, (void**)&elem);
+    node_release(dom_node);
+    if(FAILED(hres))
+        return S_OK;
+    V_VT(&top) = VT_BOOL;
+    V_BOOL(&top) = VARIANT_FALSE;
+    hres = IHTMLElement_scrollIntoView(elem, top);
+    IHTMLElement_Release(elem);
+    return hres;
+}
+
+static HRESULT WINAPI DisplayPointer_ScrollIntoView(IDisplayPointer *iface)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface);
+    nsIDOMNode *node;
+    LONG off;
+    HRESULT hres;
+
+    TRACE("(%p)\n", This);
+
+    if(!dp_get(This, &node, &off))
+        return E_UNEXPECTED;
+    hres = scroll_to_node(node);
+    nsIDOMNode_Release(node);
+    return hres;
+}
+
+static HRESULT line_info_create(HTMLDocumentNode *doc, const struct frect *r, ILineInfo **ret)
+{
+    LineInfo *info;
+    POINT pt = { lroundf(r->left), lroundf(r->bottom) };
+
+    if(!(info = calloc(1, sizeof(*info))))
+        return E_OUTOFMEMORY;
+    info->ILineInfo_iface.lpVtbl = &LineInfoVtbl;
+    info->ref = 1;
+    /* in the content's coordinates; the descent a fifth of the text's height */
+    display_transform_point(doc, &pt, COORD_SYSTEM_FRAME, COORD_SYSTEM_CONTENT, NULL);
+    info->height = lroundf(r->bottom - r->top);
+    info->descent = (info->height + 2) / 5;
+    info->x = pt.x;
+    info->baseline = pt.y - info->descent;
+    *ret = &info->ILineInfo_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI DisplayPointer_GetLineInfo(IDisplayPointer *iface, ILineInfo **ret)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface);
+    struct frect r;
+
+    TRACE("(%p)->(%p)\n", This, ret);
+
+    if(!ret) return E_POINTER;
+    if(!dp_rect(This, &r))
+        return E_UNEXPECTED;
+    return line_info_create(This->doc, &r, ret);
+}
+
+static HRESULT WINAPI DisplayPointer_GetFlowElement(IDisplayPointer *iface, IHTMLElement **ret)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface);
+    IMarkupPointer2 *pointer2;
+    IHTMLElement *elem = NULL, *parent;
+    BOOL flow = FALSE;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, ret);
+
+    if(!ret) return E_POINTER;
+    *ret = NULL;
+    if(FAILED(hres = IMarkupPointer_QueryInterface(This->pointer, &IID_IMarkupPointer2, (void**)&pointer2)))
+        return hres;
+    hres = IMarkupPointer2_CurrentScope(pointer2, &elem);
+    IMarkupPointer2_Release(pointer2);
+    if(FAILED(hres) || !elem)
+        return FAILED(hres) ? hres : E_UNEXPECTED;
+    /* the nearest element laying out a flow of its own */
+    while(elem) {
+        if(SUCCEEDED(element_has_flow_layout(elem, &flow)) && flow) {
+            *ret = elem;
+            return S_OK;
+        }
+        parent = NULL;
+        IHTMLElement_get_parentElement(elem, &parent);
+        IHTMLElement_Release(elem);
+        elem = parent;
+    }
+    return S_FALSE;
+}
+
+static HRESULT WINAPI DisplayPointer_QueryBreaks(IDisplayPointer *iface, DWORD *breaks)
+{
+    DisplayPointer *This = impl_from_IDisplayPointer(iface);
+    nsIDOMNode *node, *prev = NULL, *parent = NULL;
+    IDisplayPointer *start;
+    LONG off;
+    BOOL bol = FALSE;
+
+    TRACE("(%p)->(%p)\n", This, breaks);
+
+    if(!breaks) return E_POINTER;
+    *breaks = DISPLAY_BREAK_None;
+    if(!dp_get(This, &node, &off))
+        return E_UNEXPECTED;
+    /* right after a line break, or at the start of a block's line */
+    if(node_type(node) == TEXT_NODE && off == 0) {
+        nsIDOMNode_GetParentNode(node, &parent);
+        if(parent) {
+            prev = child_at(parent, child_index(parent, node) - 1);
+            nsIDOMNode_Release(parent);
+        }
+    }else if(node_type(node) != TEXT_NODE) {
+        prev = child_at(node, off - 1);
+    }
+    if(prev) {
+        nsIDOMElement *elem;
+        if(NS_SUCCEEDED(nsIDOMNode_QueryInterface(prev, &IID_nsIDOMElement, (void**)&elem))) {
+            nsAString tag_str;
+            const PRUnichar *tag;
+
+            nsAString_Init(&tag_str, NULL);
+            nsIDOMElement_GetTagName(elem, &tag_str);
+            nsAString_GetData(&tag_str, &tag);
+            if(!wcsicmp(tag, L"br"))
+                *breaks |= DISPLAY_BREAK_Break;
+            nsAString_Finish(&tag_str);
+            nsIDOMElement_Release(elem);
+        }
+        nsIDOMNode_Release(prev);
+    }
+    nsIDOMNode_Release(node);
+    if(!(*breaks & DISPLAY_BREAK_Break) && SUCCEEDED(create_display_pointer(This->doc, &start))) {
+        /* the first position of its flow element's text */
+        IHTMLElement *flow = NULL;
+        IMarkupPointer *mp;
+
+        if(DisplayPointer_GetFlowElement(iface, &flow) == S_OK && SUCCEEDED(create_markup_pointer(This->doc, &mp))) {
+            if(SUCCEEDED(IMarkupPointer_MoveAdjacentToElement(mp, flow, ELEM_ADJ_AfterBegin))
+               && SUCCEEDED(IDisplayPointer_MoveToMarkupPointer(start, mp, NULL)))
+                DisplayPointer_IsEqualTo(start, iface, &bol);
+            IMarkupPointer_Release(mp);
+        }
+        if(flow)
+            IHTMLElement_Release(flow);
+        IDisplayPointer_Release(start);
+        if(bol)
+            *breaks |= DISPLAY_BREAK_Block;
+    }
+    return S_OK;
+}
+
