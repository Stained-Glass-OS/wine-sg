+/***********************************************************************
+ *          IHTMLCaret
+ */
+
+typedef struct {
+    IHTMLCaret IHTMLCaret_iface;
+    LONG ref;
+    HTMLDocumentNode *doc;
+    BOOL visible;
+    CARET_DIRECTION direction;
+} HTMLCaret;
+
+static inline HTMLCaret *impl_from_IHTMLCaret(IHTMLCaret *iface)
+{
+    return CONTAINING_RECORD(iface, HTMLCaret, IHTMLCaret_iface);
+}
+
+static nsISelection *caret_selection(HTMLCaret *This)
+{
+    nsISelection *sel = NULL;
+
+    if(!This->doc->window || !This->doc->window->dom_window)
+        return NULL;
+    nsIDOMWindow_GetSelection(This->doc->window->dom_window, &sel);
+    return sel;
+}
+
+/* where the caret is: the selection's focus */
+static BOOL caret_get(HTMLCaret *This, nsIDOMNode **node, LONG *off)
+{
+    nsISelection *sel = caret_selection(This);
+    LONG offset = 0;
+
+    *node = NULL;
+    if(!sel)
+        return FALSE;
+    nsISelection_GetFocusNode(sel, node);
+    nsISelection_GetFocusOffset(sel, &offset);
+    nsISelection_Release(sel);
+    *off = offset;
+    return *node != NULL;
+}
+
+static HRESULT caret_set(HTMLCaret *This, nsIDOMNode *node, LONG off)
+{
+    nsISelection *sel = caret_selection(This);
+    nsresult nsres;
+
+    if(!sel)
+        return E_FAIL;
+#ifdef SG_MUTANT_CARET_NO_MOVE
+    nsres = NS_OK;
+#else
+    nsres = nsISelection_Collapse(sel, node, off);
+#endif
+    nsISelection_Release(sel);
+    return NS_SUCCEEDED(nsres) ? S_OK : E_FAIL;
+}
+
+static HRESULT WINAPI HTMLCaret_QueryInterface(IHTMLCaret *iface, REFIID riid, void **ppv)
+{
+    HTMLCaret *This = impl_from_IHTMLCaret(iface);
+
+    if(IsEqualGUID(&IID_IUnknown, riid) || IsEqualGUID(&IID_IHTMLCaret, riid)) {
+        *ppv = &This->IHTMLCaret_iface;
+        IHTMLCaret_AddRef(iface);
+        return S_OK;
+    }
+    WARN("(%p)->(%s)\n", This, debugstr_mshtml_guid(riid));
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI HTMLCaret_AddRef(IHTMLCaret *iface)
+{
+    return InterlockedIncrement(&impl_from_IHTMLCaret(iface)->ref);
+}
+
+static ULONG WINAPI HTMLCaret_Release(IHTMLCaret *iface)
+{
+    HTMLCaret *This = impl_from_IHTMLCaret(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        IHTMLDOMNode_Release(&This->doc->node.IHTMLDOMNode_iface);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT caret_to_pointer(HTMLCaret *This, IDisplayPointer *pointer, BOOL scroll, CARET_DIRECTION dir)
+{
+    DisplayPointer *dp = unsafe_display_pointer(pointer);
+    nsIDOMNode *node;
+    LONG off;
+    HRESULT hres;
+
+    if(!dp)
+        return E_INVALIDARG;
+    if(!dp_get(dp, &node, &off))
+        return E_INVALIDARG;
+    hres = caret_set(This, node, off);
+    if(SUCCEEDED(hres) && scroll)
+        scroll_to_node(node);
+    nsIDOMNode_Release(node);
+    if(dir != CARET_DIRECTION_SAME)
+        This->direction = dir;
+    return hres;
+}
+
+static HRESULT WINAPI HTMLCaret_MoveCaretToPointer(IHTMLCaret *iface, IDisplayPointer *pointer, BOOL scroll,
+        CARET_DIRECTION dir)
+{
+    HTMLCaret *This = impl_from_IHTMLCaret(iface);
+    TRACE("(%p)->(%p %x %d)\n", This, pointer, scroll, dir);
+    return caret_to_pointer(This, pointer, scroll, dir);
+}
+
+static HRESULT WINAPI HTMLCaret_MoveCaretToPointerEx(IHTMLCaret *iface, IDisplayPointer *pointer, BOOL visible,
+        BOOL scroll, CARET_DIRECTION dir)
+{
+    HTMLCaret *This = impl_from_IHTMLCaret(iface);
+    HRESULT hres;
+
+    TRACE("(%p)->(%p %x %x %d)\n", This, pointer, visible, scroll, dir);
+    if(SUCCEEDED(hres = caret_to_pointer(This, pointer, scroll, dir)))
+        This->visible = visible;
+    return hres;
+}
+
+static HRESULT WINAPI HTMLCaret_MoveMarkupPointerToCaret(IHTMLCaret *iface, IMarkupPointer *pointer)
+{
+    HTMLCaret *This = impl_from_IHTMLCaret(iface);
+    nsIDOMNode *node;
+    LONG off;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, pointer);
+
+    if(!pointer)
+        return E_INVALIDARG;
+    if(!caret_get(This, &node, &off))
+        return E_FAIL;
+    hres = markup_pointer_set_position(pointer, node, off);
+    nsIDOMNode_Release(node);
+    return hres;
+}
+
+static HRESULT WINAPI HTMLCaret_MoveDisplayPointerToCaret(IHTMLCaret *iface, IDisplayPointer *pointer)
+{
+    HTMLCaret *This = impl_from_IHTMLCaret(iface);
+    DisplayPointer *dp = unsafe_display_pointer(pointer);
+    nsIDOMNode *node;
+    LONG off;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, pointer);
+
+    if(!dp)
+        return E_INVALIDARG;
+    if(!caret_get(This, &node, &off))
+        return E_FAIL;
+    hres = dp_set(dp, node, off);
+    nsIDOMNode_Release(node);
+    return hres;
+}
