From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: entering another apartment's context

IContextCallback::ContextCallback ran the function only for a caller already in the context and returned E_NOTIMPL otherwise. C++/WinRT's co_await of an apartment_context (Windows Terminal's control coming back to its UI thread from its connection's threads) needs the other case: the function is now run in the context's apartment, the caller waiting, as for a call to an object there. An STA's context is entered through its apartment window (made when the thread's context is first asked for; the STA's thread runs the function from its message loop); the MTA's on a thread of its own in the MTA. An STA caller keeps dispatching its messages while it waits.
---
diff --git a/dlls/combase/apartment.c b/dlls/combase/apartment.c
index a070afe..231de16 100644
--- a/dlls/combase/apartment.c
+++ b/dlls/combase/apartment.c
@@ -1133,6 +1133,13 @@ static LRESULT CALLBACK apartment_wndproc(HWND hWnd, UINT msg, WPARAM wParam, LP
         return 0;
     case DM_HOSTOBJECT:
         return apartment_hostobject(com_get_current_apt(), (const struct host_object_params *)lParam);
+    case DM_CONTEXTCALL:
+    {
+        struct context_call *call = (struct context_call *)lParam;
+        call->hr = call->callback(call->param);
+        SetEvent(call->done);
+        return 0;
+    }
     default:
         return DefWindowProcW(hWnd, msg, wParam, lParam);
     }
diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index 96628b4..f12fa98 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -2877,6 +2877,65 @@ static BOOL thread_context_is_current(const struct thread_context *context)
     return ret;
 }
 
+static DWORD WINAPI context_call_mta_thread(void *arg)
+{
+    struct context_call *call = arg;
+
+    CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    call->hr = call->callback(call->param);
+    CoUninitialize();
+    SetEvent(call->done);
+    return 0;
+}
+
+/* the function run in the context's apartment, the caller waiting (and, in an STA, still
+ * dispatching its messages, as for a call to an object there): an STA's thread runs it from its
+ * apartment window, the MTA's on a thread of its own */
+static HRESULT context_call_elsewhere(struct thread_context *context, PFNCONTEXTCALL callback, ComCallData *param)
+{
+    struct context_call call = { (void *)callback, param, E_FAIL, NULL };
+    struct apartment *apt = NULL;
+    HANDLE thread = NULL;
+    DWORD index;
+    HWND hwnd = NULL;
+    HRESULT hr;
+
+    if (!context->mta)
+    {
+        if (!(apt = apartment_findfromtid(context->tid)))
+        {
+            WARN("the apartment of thread %04lx is gone\n", context->tid);
+            return RPC_E_DISCONNECTED;
+        }
+        if (!apt->multi_threaded) hwnd = apartment_getwindow(apt);
+        apartment_release(apt);
+        if (!hwnd)
+        {
+            FIXME("thread %04lx has no apartment window to enter its context by\n", context->tid);
+            return E_NOTIMPL;
+        }
+    }
+    if (!(call.done = CreateEventW(NULL, TRUE, FALSE, NULL))) return HRESULT_FROM_WIN32(GetLastError());
+    if (hwnd)
+    {
+        if (!PostMessageW(hwnd, DM_CONTEXTCALL, 0, (LPARAM)&call))
+        {
+            CloseHandle(call.done);
+            return RPC_E_DISCONNECTED;
+        }
+    }
+    else if (!(thread = CreateThread(NULL, 0, context_call_mta_thread, &call, 0, NULL)))
+    {
+        CloseHandle(call.done);
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+    hr = CoWaitForMultipleHandles(0, INFINITE, 1, &call.done, &index);
+    if (thread) CloseHandle(thread);
+    CloseHandle(call.done);
+    TRACE("ran in the context of thread %04lx: %#lx (wait %#lx)\n", context->tid, call.hr, hr);
+    return FAILED(hr) ? hr : call.hr;
+}
+
 static HRESULT WINAPI thread_context_callback_ContextCallback(IContextCallback *iface,
         PFNCONTEXTCALL callback, ComCallData *param, REFIID riid, int method, IUnknown *punk)
 {
@@ -2891,8 +2950,11 @@ static HRESULT WINAPI thread_context_callback_ContextCallback(IContextCallback *
     if (thread_context_is_current(context))
         return callback(param);
 #endif
+#ifdef SG_MUTANT_CTXCALLBACK_NO_CROSS
     FIXME("entering the context of thread %04lx from another apartment is not supported\n", context->tid);
     return E_NOTIMPL;
+#endif
+    return context_call_elsewhere(context, callback, param);
 }
 
 static const IContextCallbackVtbl thread_context_callback_vtbl =
@@ -3275,6 +3337,12 @@ HRESULT WINAPI CoGetContextToken(ULONG_PTR *token)
         tlsdata->context_token = &context->IObjContext_iface;
     }
 
+    /* other apartments enter an STA's context through its apartment window */
+    {
+        struct apartment *apt = com_get_current_apt();
+        if (apt && !apt->multi_threaded) apartment_createwindowifneeded(apt);
+    }
+
     /* the thread's context lasts across CoUninitialize: it is the MTA's
      * while the thread is in the MTA */
     {
diff --git a/dlls/combase/combase_private.h b/dlls/combase/combase_private.h
index c1e3096..ce817b2 100644
--- a/dlls/combase/combase_private.h
+++ b/dlls/combase/combase_private.h
@@ -69,6 +69,16 @@ HRESULT open_appidkey_from_clsid(REFCLSID clsid, REGSAM access, HKEY *subkey);
 /* DCOM messages used by the apartment window (not compatible with native) */
 #define DM_EXECUTERPC   (WM_USER + 0) /* WPARAM = 0, LPARAM = (struct dispatch_params *) */
 #define DM_HOSTOBJECT   (WM_USER + 1) /* WPARAM = 0, LPARAM = (struct host_object_params *) */
+#define DM_CONTEXTCALL  (WM_USER + 2) /* WPARAM = 0, LPARAM = (struct context_call *) */
+
+/* IContextCallback::ContextCallback run in another apartment's thread */
+struct context_call
+{
+    HRESULT (__stdcall *callback)( void *param );   /* PFNCONTEXTCALL */
+    void *param;                                    /* ComCallData */
+    HRESULT hr;
+    HANDLE done;
+};
 
 #define CHARS_IN_GUID 39
 
