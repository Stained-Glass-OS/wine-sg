From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 09:54:32 -0700
Subject: [PATCH] d3d11: a shared fence made with a name keeps its value in
 that name (3325)

CORE review: graphics. ID3D11Fence::CreateSharedHandle with a name made a
second section with a copy of the fence's value at that moment, so a process
that opened the name never saw the fence move. The fence's value now moves to
the named section and stays there (the mapping it had stays for threads that
wait on it), so the name and every handle made after it show one value; handles
made before the name keep the old one. Gate g-shared-fence: two processes, an
inherited handle and a name, Signal, SetEventOnCompletion, GetCompletedValue.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/d3d11/fence.c b/dlls/d3d11/fence.c
index 21c4a43..b17cd80 100644
--- a/dlls/d3d11/fence.c
+++ b/dlls/d3d11/fence.c
@@ -42,6 +42,10 @@ struct d3d11_fence
     HANDLE section;
     struct fence_data *data;
     D3D11_FENCE_FLAG flags;
+    /* a name moves the value to a section of that name: what a thread that waits on it has mapped stays */
+    struct fence_data *old_data[4];
+    HANDLE old_section[4];
+    unsigned int old_count;
 };
 
 static inline struct d3d11_fence *impl_from_ID3D11Fence(ID3D11Fence *iface)
@@ -89,6 +93,12 @@ static ULONG STDMETHODCALLTYPE d3d11_fence_Release(ID3D11Fence *iface)
         wined3d_private_store_cleanup(&fence->private_store);
         UnmapViewOfFile(fence->data);
         CloseHandle(fence->section);
+        while (fence->old_count)
+        {
+            --fence->old_count;
+            UnmapViewOfFile(fence->old_data[fence->old_count]);
+            CloseHandle(fence->old_section[fence->old_count]);
+        }
         free(fence);
         ID3D11Device5_Release(device);
     }
@@ -146,7 +156,7 @@ static HRESULT STDMETHODCALLTYPE d3d11_fence_CreateSharedHandle(ID3D11Fence *ifa
         return E_INVALIDARG;
     if (name)
     {
-        /* a named handle: a second section view of the same value under the name */
+        /* a named handle: the value moves to a section of that name, which is the fence's from now on */
         HANDLE named = CreateFileMappingW(INVALID_HANDLE_VALUE, (SECURITY_ATTRIBUTES *)attributes, PAGE_READWRITE,
                 0, sizeof(struct fence_data), name);
         struct fence_data *data;
@@ -158,16 +168,28 @@ static HRESULT STDMETHODCALLTYPE d3d11_fence_CreateSharedHandle(ID3D11Fence *ifa
             CloseHandle(named);
             return HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS);
         }
-        if (!(data = MapViewOfFile(named, FILE_MAP_WRITE, 0, 0, sizeof(*data))))
+        if (fence->old_count == ARRAY_SIZE(fence->old_data)
+                || !(data = MapViewOfFile(named, FILE_MAP_WRITE, 0, 0, sizeof(*data))))
         {
             CloseHandle(named);
             return E_OUTOFMEMORY;
         }
         data->magic = FENCE_MAGIC;
+#ifndef SG_MUTANT_FENCE_NAME_SNAPSHOT
+        data->value = InterlockedCompareExchange64(&fence->data->value, 0, 0);
+        fence->old_data[fence->old_count] = fence->data;
+        fence->old_section[fence->old_count++] = fence->section;
+        fence->data = data;
+        fence->section = named;
+        if (!DuplicateHandle(GetCurrentProcess(), named, GetCurrentProcess(), &dup, 0,
+                attributes && attributes->bInheritHandle, DUPLICATE_SAME_ACCESS))
+            return HRESULT_FROM_WIN32(GetLastError());
+        *handle = dup;
+#else
         data->value = fence->data->value;
         UnmapViewOfFile(data);
-        /* only the starting value is carried over: the named section is a snapshot */
         *handle = named;
+#endif
         return S_OK;
     }
     if (!DuplicateHandle(GetCurrentProcess(), fence->section, GetCurrentProcess(), &dup, 0,
