From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: AVIF images through the HEIF decoder (6540)

AVIF is AV1 in the HEIF container. The HEIF decoder (6539) now also takes
.avif files (the avif and avis ftyp brands): libheif decodes them with
its AV1 plugin (libheif-plugin-dav1d). The decoder plugin is now required
per file: an AVIF file needs the AV1 one, a HEIC file the HEVC one, and
without it the decoder declines that file
(WINCODEC_ERR_COMPONENTNOTFOUND). wine.inf gives .avif the image
thumbnail handler, a content type and an image perceived type.
---
 dlls/windowscodecs/heifformat.c |  3 ++-
 dlls/windowscodecs/regsvr.c     | 10 ++++++++--
 dlls/windowscodecs/unixlib.c    | 28 +++++++++++++++++++++++-----
 loader/wine.inf.in              |  3 +++
 4 files changed, 36 insertions(+), 8 deletions(-)

diff --git a/dlls/windowscodecs/heifformat.c b/dlls/windowscodecs/heifformat.c
index 06f6032..0151ae2 100644
--- a/dlls/windowscodecs/heifformat.c
+++ b/dlls/windowscodecs/heifformat.c
@@ -36,7 +36,8 @@
 WINE_DEFAULT_DEBUG_CHANNEL(wincodecs);
 
 /* HEIF images (iPhone photos, HEIC) come from the HEIF Image Extensions on Windows; here libheif and
- * its HEVC decoder plugin decode them when they are installed. Without them the decoder declines
+ * its HEVC decoder plugin decode them when they are installed, and AVIF images (AV1 in the same
+ * container: wine-sg 6540) with its dav1d plugin. Without them the decoder declines
  * every image, and WIC finds no component for the file (WINCODEC_ERR_COMPONENTNOTFOUND). */
 
 struct heif_decoder
diff --git a/dlls/windowscodecs/regsvr.c b/dlls/windowscodecs/regsvr.c
index 549efdb..3fe5b97 100644
--- a/dlls/windowscodecs/regsvr.c
+++ b/dlls/windowscodecs/regsvr.c
@@ -1238,6 +1238,8 @@ static const BYTE heif_magic_heim[] = {'f','t','y','p','h','e','i','m'};
 static const BYTE heif_magic_heis[] = {'f','t','y','p','h','e','i','s'};
 static const BYTE heif_magic_mif1[] = {'f','t','y','p','m','i','f','1'};
 static const BYTE heif_magic_msf1[] = {'f','t','y','p','m','s','f','1'};
+static const BYTE heif_magic_avif[] = {'f','t','y','p','a','v','i','f'};
+static const BYTE heif_magic_avis[] = {'f','t','y','p','a','v','i','s'};
 
 static GUID const * const heif_formats[] = {
     &GUID_WICPixelFormat32bppBGR,
@@ -1254,6 +1256,10 @@ static struct decoder_pattern const heif_patterns[] = {
     {8,4,heif_magic_heis,mask_all,0},
     {8,4,heif_magic_mif1,mask_all,0},
     {8,4,heif_magic_msf1,mask_all,0},
+#ifndef SG_MUTANT_AVIF_NOT_REGISTERED
+    {8,4,heif_magic_avif,mask_all,0},
+    {8,4,heif_magic_avis,mask_all,0},
+#endif
     {0}
 };
 
@@ -1428,8 +1434,8 @@ static struct regsvr_decoder const decoder_list[] = {
 	"1.0.0.0",
 	&GUID_VendorMicrosoft,
 	&GUID_ContainerFormatHeif,
-	"image/heic,image/heif",
-	".heic,.heif,.hif",
+	"image/heic,image/heif,image/avif",
+	".heic,.heif,.hif,.avif",
 	heif_formats,
 	heif_patterns
     },
diff --git a/dlls/windowscodecs/unixlib.c b/dlls/windowscodecs/unixlib.c
index 37d9d5a..e7ad35d 100644
--- a/dlls/windowscodecs/unixlib.c
+++ b/dlls/windowscodecs/unixlib.c
@@ -29,6 +29,7 @@
 #include <stdarg.h>
 #include <stdint.h>
 #include <stdlib.h>
+#include <string.h>
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
@@ -69,6 +70,27 @@ static const uint8_t *(*p_heif_image_get_plane_readonly)( const struct heif_imag
 static void (*p_heif_image_release)( const struct heif_image * );
 static int (*p_heif_have_decoder_for_format)( int );
 #define HEIF_COMPRESSION_HEVC 1
+#define HEIF_COMPRESSION_AV1  4
+
+/* the brand of the file's ftyp box: AVIF (AV1) or HEIC (HEVC) */
+static BOOL is_avif( const BYTE *data, UINT64 size )
+{
+    return size >= 12 && !memcmp( data + 4, "ftyp", 4 ) && (!memcmp( data + 8, "avif", 4 ) || !memcmp( data + 8, "avis", 4 ));
+}
+
+/* the decoder plugin the file needs: libheif-plugin-dav1d for AVIF, libheif-plugin-libde265 for HEIC */
+static BOOL have_decoder( const BYTE *data, UINT64 size )
+{
+    int format = is_avif( data, size ) ? HEIF_COMPRESSION_AV1 : HEIF_COMPRESSION_HEVC;
+
+#ifdef SG_MUTANT_HEIF_NO_AV1
+    if (format == HEIF_COMPRESSION_AV1) return FALSE;
+#endif
+    if (!p_heif_have_decoder_for_format) return TRUE;
+    if (p_heif_have_decoder_for_format( format )) return TRUE;
+    WARN( "libheif has no %s decoder plugin\n", format == HEIF_COMPRESSION_AV1 ? "AV1 (dav1d)" : "HEVC (libde265)" );
+    return FALSE;
+}
 
 static pthread_once_t init_once = PTHREAD_ONCE_INIT;
 static BOOL heif_ready;
@@ -104,11 +126,6 @@ static void load_libheif(void)
         WARN( "heif_init failed\n" );
         return;
     }
-    if (p_heif_have_decoder_for_format && !p_heif_have_decoder_for_format( HEIF_COMPRESSION_HEVC ))
-    {
-        WARN( "libheif has no HEVC decoder (libheif-plugin-libde265): no HEIC images\n" );
-        return;
-    }
     heif_ready = TRUE;
 }
 
@@ -128,6 +145,7 @@ static NTSTATUS heif_open( void *args )
 
     params->image = 0;
     if (heif_init( NULL )) return STATUS_NOT_SUPPORTED;
+    if (!have_decoder( (const BYTE *)(ULONG_PTR)params->data, params->size )) return STATUS_NOT_SUPPORTED;
     if (!(ctx = p_heif_context_alloc())) return STATUS_NO_MEMORY;
 
     err = p_heif_context_read_from_memory_without_copy( ctx, (const void *)(ULONG_PTR)params->data,
diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index 4590060..0678f89 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -362,6 +362,9 @@ HKCR,.heic,"PerceivedType",,"image"
 HKCR,.heif,"Content Type",,"image/heif"
 HKCR,.heif,"PerceivedType",,"image"
 HKCR,.hif,"PerceivedType",,"image"
+HKCR,.avif\ShellEx\{e357fccd-a995-4576-b01f-234630154e96},,,"{8b9284a6-ab7a-41df-bcfa-c80995441db9}"
+HKCR,.avif,"Content Type",,"image/avif"
+HKCR,.avif,"PerceivedType",,"image"
 HKCR,.mp4\ShellEx\{e357fccd-a995-4576-b01f-234630154e96},,,"{a3d8b0f2-6c1e-4d57-9b8a-2f4e7c9d1a60}"
 HKCR,.m4v\ShellEx\{e357fccd-a995-4576-b01f-234630154e96},,,"{a3d8b0f2-6c1e-4d57-9b8a-2f4e7c9d1a60}"
 HKCR,.mkv\ShellEx\{e357fccd-a995-4576-b01f-234630154e96},,,"{a3d8b0f2-6c1e-4d57-9b8a-2f4e7c9d1a60}"
