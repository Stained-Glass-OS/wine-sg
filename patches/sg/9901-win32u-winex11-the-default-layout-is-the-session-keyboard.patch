     .pDestroyCursorIcon = X11DRV_DestroyCursorIcon,
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -204,6 +204,7 @@ extern void X11DRV_Beep(void);
 extern INT X11DRV_GetKeyNameText( LONG lparam, LPWSTR buffer, INT size );
 extern const KBDTABLES *X11DRV_KbdLayerDescriptor( HKL hkl );
 extern void X11DRV_ReleaseKbdTables( const KBDTABLES *tables );
+extern UINT X11DRV_GetKeyboardLayoutDevice(void);
 extern const KBDTABLES *x11drv_foreign_kbd_tables( HKL hkl );
 extern void x11drv_foreign_kbd_reset(void);
 extern UINT X11DRV_MapVirtualKeyEx( UINT code, UINT map_type, HKL hkl );
--- a/dlls/winex11.drv/xkbtables.c
+++ b/dlls/winex11.drv/xkbtables.c
@@ -261,6 +261,69 @@ static struct list foreign_layouts = LIST_INIT( foreign_layouts );
 static struct xkb_context *xkb_context;
 static char x_layout[64], x_variant[64];
 static BOOL x_names_known;
+static UINT x_device;  /* the high word of the X map's Windows layout (HKL), 0 if it has none */
+
+#ifndef SG_MUTANT_KBD_NO_KLID
+/* the "Layout Id" of KLID klid, 0 if it has none */
+static UINT layout_id_from_klid( DWORD klid )
+{
+    static const WCHAR layout_idW[] = {'L','a','y','o','u','t',' ','I','d',0};
+    char path[128], buffer[256];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    WCHAR pathW[128], *end;
+    UINT id = 0, len;
+    HKEY hkey;
+
+    snprintf( path, sizeof(path), "\\Registry\\Machine\\System\\CurrentControlSet\\Control\\Keyboard Layouts\\%08X",
+              (UINT)klid );
+    for (len = 0; path[len]; len++) pathW[len] = (unsigned char)path[len];
+    if (!(hkey = reg_open_key( NULL, pathW, len * sizeof(WCHAR) ))) return 0;
+    if (query_reg_value( hkey, layout_idW, value, sizeof(buffer) - sizeof(WCHAR) ) && value->Type == REG_SZ)
+    {
+        ((WCHAR *)value->Data)[value->DataLength / sizeof(WCHAR)] = 0;
+        id = ntdll_wcstoul( (const WCHAR *)value->Data, &end, 16 ) & 0xfff;
+    }
+    NtClose( hkey );
+    return id;
+}
+#endif
+
+/* Stained Glass OS: which Windows layout the X map is, as the high word of an HKL -- the layout id
+ * (0xf000 | id) of the KLID with the X map's XKB variant, else the language of a layout with its XKB
+ * name (the user locale's own if it has that name: "us" is en-US, en-AU and en-NZ), else that of a
+ * layout with its XKB layout and no variant (de(nodeadkeys) is German); 0 when none fits. */
+static UINT device_for_x_map(void)
+{
+    LCID locale;
+    LANGID lang;
+    int pass, best;
+    unsigned int i;
+
+    if (!x_layout[0]) return 0;
+#ifndef SG_MUTANT_KBD_NO_KLID
+    for (i = 0; i < ARRAY_SIZE(xkb_klids); i++)
+    {
+        UINT id;
+        if (strcmp( xkb_klids[i].layout, x_layout ) || strcmp( xkb_klids[i].variant, x_variant )) continue;
+        if ((id = layout_id_from_klid( xkb_klids[i].klid ))) return 0xf000 | id;
+    }
+#endif
+    NtQueryDefaultLocale( TRUE, &locale );
+    lang = LANGIDFROMLCID( locale );
+    for (pass = 0; pass < 2; pass++)
+    {
+        for (i = 0, best = -1; i < ARRAY_SIZE(xkb_names); i++)
+        {
+            if (strcmp( xkb_names[i].layout, x_layout )) continue;
+            if (pass == 0 && strcmp( xkb_names[i].variant ? xkb_names[i].variant : "", x_variant )) continue;
+            if (pass == 1 && xkb_names[i].variant) continue;
+            if (xkb_names[i].lang == lang) return lang;
+            if (best < 0) best = i;
+        }
+        if (best >= 0) return xkb_names[best].lang;
+    }
+    return 0;
+}
 
 /* the X map's own layout, from the XKB rules names on the root window */
 static void read_x_layout_names(void)
@@ -273,6 +336,7 @@ static void read_x_layout_names(void)
     int format, i;
 
     x_layout[0] = x_variant[0] = 0;
+    x_device = 0;
     x_names_known = TRUE;
     if (!prop) return;
     if (XGetWindowProperty( display, DefaultRootWindow( display ), prop, 0, 1024, False,
@@ -293,7 +357,8 @@ static void read_x_layout_names(void)
         }
     }
     XFree( data );
-    TRACE( "X keyboard map: layout %s variant %s\n", debugstr_a(x_layout), debugstr_a(x_variant) );
+    x_device = device_for_x_map();
+    TRACE( "X keyboard map: layout %s variant %s, layout %04x\n", debugstr_a(x_layout), debugstr_a(x_variant), x_device );
 }
 
 static WORD vkey_for_key( struct xkb_state *state, xkb_keycode_t keyc, BYTE scan, const USHORT *base, BOOL by_char )
@@ -596,9 +661,15 @@ const KBDTABLES *x11drv_foreign_kbd_tables( HKL hkl )
     const char *xkb_layout, *xkb_variant;
     DWORD key;
     LCID locale;
+    UINT device;
     int name;
 
     if (!hkl) return NULL;
+    pthread_mutex_lock( &foreign_mutex );
+    if (!x_names_known) read_x_layout_names();
+    device = x_device;
+    pthread_mutex_unlock( &foreign_mutex );
+    if (device && lang == device) return NULL; /* the X map's own layout */
     if ((lang & 0xf000) == 0xf000)
     {
 #ifndef SG_MUTANT_KBD_NO_KLID
@@ -615,7 +686,13 @@ const KBDTABLES *x11drv_foreign_kbd_tables( HKL hkl )
     else
     {
         NtQueryDefaultLocale( TRUE, &locale );
-        if (lang == LANGIDFROMLCID( locale )) return NULL; /* the session's own layout is the X map */
+        /* the session's own layout is the X map: with a known X layout, only its own HKL (above), so
+         * a program that activates US English on a German map gets US answers, as on Windows */
+#ifndef SG_MUTANT_KBD_LOCALE_DEVICE
+        if (!device && lang == LANGIDFROMLCID( locale )) return NULL;
+#else
+        if (lang == LANGIDFROMLCID( locale )) return NULL;
+#endif
         if ((name = find_xkb_name( lang )) < 0) return NULL;
         key = xkb_names[name].lang;
         xkb_layout = xkb_names[name].layout;
@@ -656,6 +733,18 @@ void x11drv_foreign_kbd_reset(void)
     pthread_mutex_unlock( &foreign_mutex );
 }
 
+/* the high word of the X map's Windows layout, 0 if it has none (win32u: the default HKL) */
+UINT X11DRV_GetKeyboardLayoutDevice(void)
+{
+    UINT device;
+
+    pthread_mutex_lock( &foreign_mutex );
+    if (!x_names_known) read_x_layout_names();
+    device = x_device;
+    pthread_mutex_unlock( &foreign_mutex );
+    return device;
+}
+
 #else  /* HAVE_XKBCOMMON_XKBCOMMON_H */
 
 const KBDTABLES *x11drv_foreign_kbd_tables( HKL hkl )
@@ -667,6 +756,11 @@ void x11drv_foreign_kbd_reset(void)
 {
 }
 
+UINT X11DRV_GetKeyboardLayoutDevice(void)
+{
+    return 0;
+}
+
 #endif  /* HAVE_XKBCOMMON_XKBCOMMON_H */
 
 /***********************************************************************
--- a/include/wine/gdi_driver.h
+++ b/include/wine/gdi_driver.h
@@ -219,7 +219,7 @@ struct gdi_dc_funcs
 };
 
 /* increment this when you change the DC function table */
-#define WINE_GDI_DRIVER_VERSION 102
+#define WINE_GDI_DRIVER_VERSION 103
 
 #define GDI_PRIORITY_NULL_DRV        0  /* null driver */
 #define GDI_PRIORITY_FONT_DRV      100  /* any font driver */
@@ -338,6 +338,7 @@ struct user_driver_funcs
     SHORT   (*pVkKeyScanEx)(WCHAR, HKL);
     const KBDTABLES *(*pKbdLayerDescriptor)(HKL);
     void    (*pReleaseKbdTables)(const KBDTABLES *);
+    UINT    (*pGetKeyboardLayoutDevice)(void);
     /* IME functions */
     UINT    (*pImeProcessKey)(HIMC,UINT,UINT,const BYTE*);
     void    (*pNotifyIMEStatus)(HWND,UINT);
