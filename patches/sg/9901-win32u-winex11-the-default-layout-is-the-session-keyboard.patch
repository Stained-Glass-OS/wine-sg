--- a/dlls/win32u/driver.c
+++ b/dlls/win32u/driver.c
@@ -677,6 +677,11 @@ static void nulldrv_ReleaseKbdTables( const KBDTABLES *tables )
 {
 }
 
+static UINT nulldrv_GetKeyboardLayoutDevice(void)
+{
+    return 0; /* the user locale's layout */
+}
+
 static UINT nulldrv_ImeProcessKey( HIMC himc, UINT wparam, UINT lparam, const BYTE *state )
 {
     return 0;
@@ -1099,6 +1104,11 @@ static void loaderdrv_ReleaseKbdTables( const KBDTABLES *tables )
     return load_driver()->pReleaseKbdTables( tables );
 }
 
+static UINT loaderdrv_GetKeyboardLayoutDevice(void)
+{
+    return load_driver()->pGetKeyboardLayoutDevice();
+}
+
 static UINT loaderdrv_ImeProcessKey( HIMC himc, UINT wparam, UINT lparam, const BYTE *state )
 {
     return load_driver()->pImeProcessKey( himc, wparam, lparam, state );
@@ -1246,6 +1256,7 @@ static const struct user_driver_funcs lazy_load_driver =
     loaderdrv_VkKeyScanEx,
     loaderdrv_KbdLayerDescriptor,
     loaderdrv_ReleaseKbdTables,
+    loaderdrv_GetKeyboardLayoutDevice,
     loaderdrv_ImeProcessKey,
     loaderdrv_NotifyIMEStatus,
     loaderdrv_SetIMECompositionRect,
@@ -1348,6 +1359,7 @@ void __wine_set_user_driver( const struct user_driver_funcs *funcs, UINT version
     SET_USER_FUNC(VkKeyScanEx);
     SET_USER_FUNC(KbdLayerDescriptor);
     SET_USER_FUNC(ReleaseKbdTables);
+    SET_USER_FUNC(GetKeyboardLayoutDevice);
     SET_USER_FUNC(ImeProcessKey);
     SET_USER_FUNC(NotifyIMEStatus);
     SET_USER_FUNC(SetIMECompositionRect);
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -958,6 +958,10 @@ DWORD get_last_input_time(void)
 /***********************************************************************
  *           get_locale_kbd_layout
  */
+/* Stained Glass OS: set while sysparams_init writes Preload: every process does that at startup,
+ * and asking the display driver for its keyboard would load it in every process */
+BOOL kbd_device_deferred;
+
 static HKL get_locale_kbd_layout(void)
 {
     LCID layout;
@@ -974,6 +978,16 @@ static HKL get_locale_kbd_layout(void)
      */
 
     NtQueryDefaultLocale( TRUE, &layout );
+#ifndef SG_MUTANT_KBD_LOCALE_DEVICE
+    {
+        /* Stained Glass OS: the layout half is the session's keyboard, as Windows' default input
+         * layout (Preload) is the one the person types with: an English (US) session typing with
+         * a German map is 0x04070409, with US Dvorak 0xf0020409 (the display driver knows which
+         * Windows layout its keyboard map is; 0 when it does not, or has not loaded yet) */
+        UINT device = kbd_device_deferred ? 0 : user_driver->pGetKeyboardLayoutDevice();
+        if (device) return ULongToHandle( MAKELONG( layout, device ) );
+    }
+#endif
     layout = MAKELONG( layout, layout );
     return ULongToHandle( layout );
 }
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -5831,7 +5831,13 @@ void sysparams_init(void)
 
     if ((hkey = reg_create_ascii_key( hkcu_key, "Keyboard Layout\\Preload", 0, NULL )))
     {
-        if (NtUserGetKeyboardLayoutName( layout ))
+        BOOL got;
+
+        kbd_device_deferred = TRUE;
+        got = NtUserGetKeyboardLayoutName( layout );
+        kbd_device_deferred = FALSE;
+        get_user_thread_info()->kbd_layout_id = 0;  /* asked again, with the display's keyboard */
+        if (got)
             set_reg_value( hkey, oneW, REG_SZ, (const BYTE *)layout,
                            (lstrlenW(layout) + 1) * sizeof(WCHAR) );
         NtClose( hkey );
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -39,6 +39,7 @@ extern void release_clipboard_owner( HWND hwnd );
 
 /* cursoricon.c */
 extern BOOL process_wine_setcursor( HWND hwnd, HWND window, HCURSOR handle );
+extern BOOL kbd_device_deferred;
 extern HICON alloc_cursoricon_handle( BOOL is_icon );
 extern ULONG_PTR get_icon_param( HICON handle );
 extern ULONG_PTR set_icon_param( HICON handle, const struct free_icon_params *params );
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -639,6 +639,7 @@ static const struct user_driver_funcs x11drv_funcs =
     .pVkKeyScanEx = X11DRV_VkKeyScanEx,
