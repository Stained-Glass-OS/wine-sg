+{
+    return bool_operation_GetIids( &impl_from_IAsyncInfo( iface )->IAsyncOperation_boolean_iface, iid_count, iids );
+}
+
+static HRESULT WINAPI bool_info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *class_name )
