+static const struct IAsyncInfoVtbl bool_info_vtbl =
+{
+    bool_info_QueryInterface,
+    bool_info_AddRef,
+    bool_info_Release,
+    bool_info_GetIids,
+    bool_info_GetRuntimeClassName,
+    bool_info_GetTrustLevel,
