+/* the WinRT form of an endpoint ID: \\?\SWD#MMDEVAPI#<endpoint>#<interface class> */
+static HRESULT format_device_id(EDataFlow direction, const WCHAR *devid, HSTRING *out)
+{
+    WCHAR *s;
+    HRESULT hr;
+    size_t len;
+
+    *out = NULL;
+    if (!devid || !devid[0]) return WindowsCreateString(NULL, 0, out);
+    len = wcslen(id_fmt_pre) + wcslen(devid) + 1 + 39;
+    if (!(s = malloc(len * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    wcscpy(s, id_fmt_pre);
+    wcscat(s, devid);
+    wcscat(s, L"#");
