+static HRESULT completed_bool_operation( boolean result, IAsyncOperation_boolean **out )
+{
+    struct bool_operation *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAsyncOperation_boolean_iface.lpVtbl = &bool_operation_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &bool_info_vtbl;
+    impl->ref = 1;
+    impl->result = result;
+    *out = &impl->IAsyncOperation_boolean_iface;
+    return S_OK;
+}
+
+static void replace_string( HSTRING *field, const WCHAR *value )
+{
+    HSTRING old = *field;
+    *field = NULL;
+    if (value) WindowsCreateString( value, wcslen( value ), field );
+    WindowsDeleteString( old );
+}
+
+static void add_genre( IVector_HSTRING *genres, const WCHAR *genre )
+{
+    HSTRING str;
+
+    if (!genres) return;
+    IVector_HSTRING_Clear( genres );
+    if (!genre) return;
+    if (SUCCEEDED(WindowsCreateString( genre, wcslen( genre ), &str )))
+    {
+        IVector_HSTRING_Append( genres, str );
+        WindowsDeleteString( str );
+    }
+}
+
+/* the cover as a RandomAccessStreamReference */
+static IRandomAccessStreamReference *picture_reference( const BYTE *data, SIZE_T size )
+{
