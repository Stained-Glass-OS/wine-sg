+    "Retro", "Musical", "Rock & Roll", "Hard Rock",
+};
+
+void media_tags_free(struct media_tags *tags)
+{
+    free(tags->title);
+    free(tags->artist);
+    free(tags->album);
+    free(tags->album_artist);
+    free(tags->genre);
+    free(tags->picture);
+    memset(tags, 0, sizeof(*tags));
+}
+
+static WCHAR *from_codepage(UINT cp, const char *s, int len)
+{
+    int n;
+    WCHAR *w;
+
+    while (len > 0 && !s[len - 1]) len--;
+    if (len <= 0) return NULL;
+    n = MultiByteToWideChar(cp, 0, s, len, NULL, 0);
+    if (!n || !(w = malloc((n + 1) * sizeof(WCHAR)))) return NULL;
+    MultiByteToWideChar(cp, 0, s, len, w, n);
+    w[n] = 0;
+    while (n && (w[n - 1] == ' ' || !w[n - 1])) w[--n] = 0;
+    if (!n) { free(w); return NULL; }
+    return w;
+}
+
+static WCHAR *from_utf16(const BYTE *s, int len, BOOL big_endian)
+{
+    WCHAR *w;
+    int n = len / 2, i;
+
+    if (n >= 1 && ((s[0] == 0xff && s[1] == 0xfe) || (s[0] == 0xfe && s[1] == 0xff)))
+    {
+        big_endian = s[0] == 0xfe;
+        s += 2;
+        n--;
+    }
+    if (n <= 0 || !(w = malloc((n + 1) * sizeof(WCHAR)))) return NULL;
+    for (i = 0; i < n; i++) w[i] = big_endian ? (s[2 * i] << 8) | s[2 * i + 1] : s[2 * i] | (s[2 * i + 1] << 8);
+    w[n] = 0;
+    while (n && (!w[n - 1] || w[n - 1] == ' ')) w[--n] = 0;
+    if (!n) { free(w); return NULL; }
+    return w;
+}
+
+static void set_string(WCHAR **field, WCHAR *value)
+{
+    if (!value) return;
+    if (*field) { free(value); return; }  /* the first tag found wins */
+    *field = value;
+}
+
+static void set_picture(struct media_tags *tags, const BYTE *data, SIZE_T size)
+{
+    if (tags->picture || !size || size > MAX_READ) return;
+    if (!(tags->picture = malloc(size))) return;
+    memcpy(tags->picture, data, size);
+    tags->picture_size = size;
+}
+
+/* "(13)Pop", "(13)", "13" -> the genre's name */
+static WCHAR *id3_genre(WCHAR *genre)
+{
+    WCHAR *p = genre, *end;
+    unsigned long n;
+    char name[32];
+
+    if (!genre) return NULL;
+    if (*p == '(') p++;
+    n = wcstoul(p, &end, 10);
+    if (end == p) return genre;
+    if (*end == ')') end++;
+    if (*end) { memmove(genre, end, (wcslen(end) + 1) * sizeof(WCHAR)); return genre; }
+    free(genre);
+    if (n >= ARRAY_SIZE(id3_genres)) return NULL;
+    strcpy(name, id3_genres[n]);
+    return from_codepage(CP_ACP, name, strlen(name));
+}
+
+static WCHAR *id3_text(const BYTE *data, DWORD size)
+{
+    if (!size) return NULL;
+    switch (data[0])
+    {
+    case 0: return from_codepage(28591, (const char *)data + 1, size - 1);
+    case 1: return from_utf16(data + 1, size - 1, FALSE);
+    case 2: return from_utf16(data + 1, size - 1, TRUE);
+    case 3: return from_codepage(CP_UTF8, (const char *)data + 1, size - 1);
+    }
+    return NULL;
+}
+
+/* the end of a terminated string in a frame (one or two zero bytes by encoding) */
+static DWORD id3_skip_string(const BYTE *data, DWORD size, DWORD pos, BYTE encoding)
+{
+    if (encoding == 1 || encoding == 2)
+    {
+        while (pos + 1 < size && (data[pos] || data[pos + 1])) pos += 2;
+        return min(pos + 2, size);
+    }
+    while (pos < size && data[pos]) pos++;
+    return min(pos + 1, size);
+}
+
+static DWORD syncsafe(const BYTE *b)
+{
+    return (b[0] & 0x7f) << 21 | (b[1] & 0x7f) << 14 | (b[2] & 0x7f) << 7 | (b[3] & 0x7f);
+}
+
+static void parse_id3v2(const BYTE *data, SIZE_T size, struct media_tags *tags)
+{
+    BYTE version, flags;
+    DWORD tag_size, pos = 10;
+
+    if (size < 10 || memcmp(data, "ID3", 3)) return;
+    version = data[3];
+    flags = data[5];
+    tag_size = syncsafe(data + 6);
+    if (version < 2 || version > 4) return;
+    if (flags & 0x80) { FIXME("unsynchronised ID3v2 tag\n"); return; }
+    if (tag_size > size - 10) tag_size = size - 10;
+    if ((flags & 0x40) && version >= 3 && tag_size >= 4)
+        pos += version == 4 ? syncsafe(data + 10) : (DWORD)(data[10] << 24 | data[11] << 16 | data[12] << 8 | data[13]) + 4;
+
+    while (pos < 10 + tag_size)
+    {
+        char id[5] = { 0 };
+        DWORD frame_size, header = version == 2 ? 6 : 10;
+        const BYTE *frame;
+
+        if (pos + header > 10 + tag_size) break;
+        if (version == 2)
+        {
+            memcpy(id, data + pos, 3);
+            frame_size = data[pos + 3] << 16 | data[pos + 4] << 8 | data[pos + 5];
+        }
+        else
+        {
+            memcpy(id, data + pos, 4);
+            frame_size = version == 4 ? syncsafe(data + pos + 4)
+                                      : (DWORD)(data[pos + 4] << 24 | data[pos + 5] << 16 | data[pos + 6] << 8 | data[pos + 7]);
+        }
+        if (!id[0]) break;  /* padding */
+        pos += header;
+        if (frame_size > 10 + tag_size - pos) break;
+        frame = data + pos;
+        pos += frame_size;
+
+        if (!strcmp(id, "TIT2") || !strcmp(id, "TT2")) set_string(&tags->title, id3_text(frame, frame_size));
+        else if (!strcmp(id, "TPE1") || !strcmp(id, "TP1")) set_string(&tags->artist, id3_text(frame, frame_size));
+        else if (!strcmp(id, "TALB") || !strcmp(id, "TAL")) set_string(&tags->album, id3_text(frame, frame_size));
+        else if (!strcmp(id, "TPE2") || !strcmp(id, "TP2")) set_string(&tags->album_artist, id3_text(frame, frame_size));
+        else if (!strcmp(id, "TCON") || !strcmp(id, "TCO")) set_string(&tags->genre, id3_genre(id3_text(frame, frame_size)));
+        else if ((!strcmp(id, "TRCK") || !strcmp(id, "TRK")) && !tags->track)
+        {
+            WCHAR *text = id3_text(frame, frame_size);
+            if (text) { tags->track = wcstoul(text, NULL, 10); free(text); }
+        }
+        else if ((!strcmp(id, "APIC") || !strcmp(id, "PIC")) && frame_size > 4)
+        {
+            BYTE encoding = frame[0];
+            DWORD p = 1;
+
+            if (version == 2) p += 3;                      /* image format, 3 chars */
+            else p = id3_skip_string(frame, frame_size, p, 0); /* MIME type */
+            p++;                                          /* picture type */
+            p = id3_skip_string(frame, frame_size, p, encoding);
+            if (p < frame_size) set_picture(tags, frame + p, frame_size - p);
+        }
+    }
+}
+
+static void parse_id3v1(const BYTE *data, SIZE_T size, struct media_tags *tags)
+{
+    const BYTE *tag;
+
+    if (size < 128) return;
+    tag = data + size - 128;
+    if (memcmp(tag, "TAG", 3)) return;
+    set_string(&tags->title, from_codepage(28591, (const char *)tag + 3, 30));
+    set_string(&tags->artist, from_codepage(28591, (const char *)tag + 33, 30));
+    set_string(&tags->album, from_codepage(28591, (const char *)tag + 63, 30));
+    if (!tag[125] && tag[126] && !tags->track) tags->track = tag[126];
+    if (tag[127] < ARRAY_SIZE(id3_genres))
+        set_string(&tags->genre, from_codepage(CP_ACP, id3_genres[tag[127]], strlen(id3_genres[tag[127]])));
+}
+
+static DWORD be32(const BYTE *b)
+{
+    return (DWORD)b[0] << 24 | b[1] << 16 | b[2] << 8 | b[3];
+}
+
+static DWORD le32(const BYTE *b)
+{
+    return (DWORD)b[3] << 24 | b[2] << 16 | b[1] << 8 | b[0];
+}
+
+/* an MP4 box's children */
+static BOOL mp4_find(const BYTE *data, SIZE_T size, const char *type, const BYTE **child, SIZE_T *child_size)
+{
+    SIZE_T pos = 0;
+
+    while (pos + 8 <= size)
+    {
+        UINT64 box = be32(data + pos);
+        DWORD header = 8;
+
+        if (box == 1 && pos + 16 <= size)
+        {
+            box = (UINT64)be32(data + pos + 8) << 32 | be32(data + pos + 12);
+            header = 16;
+        }
+        else if (!box) box = size - pos;
+        if (box < header || box > size - pos) return FALSE;
+        if (!memcmp(data + pos + 4, type, 4))
+        {
+            *child = data + pos + header;
+            *child_size = box - header;
+            return TRUE;
+        }
+        pos += box;
+    }
+    return FALSE;
+}
+
+static void parse_mp4(const BYTE *data, SIZE_T size, struct media_tags *tags)
+{
+    const BYTE *moov, *udta, *meta, *ilst;
+    SIZE_T moov_size, udta_size, meta_size, ilst_size, pos = 0;
+
+    if (size < 12 || memcmp(data + 4, "ftyp", 4)) return;
+    if (!mp4_find(data, size, "moov", &moov, &moov_size) || !mp4_find(moov, moov_size, "udta", &udta, &udta_size) ||
+        !mp4_find(udta, udta_size, "meta", &meta, &meta_size) || meta_size < 4 ||
+        !mp4_find(meta + 4, meta_size - 4, "ilst", &ilst, &ilst_size))
+        return;
+
+    while (pos + 8 <= ilst_size)
+    {
+        DWORD item_size = be32(ilst + pos), type, kind;
+        const BYTE *item = ilst + pos, *value;
+        SIZE_T value_size;
+
+        if (item_size < 8 || item_size > ilst_size - pos) break;
+        pos += item_size;
+        if (!mp4_find(item + 8, item_size - 8, "data", &value, &value_size) || value_size < 8) continue;
+        kind = be32(value) & 0xffffff;
+        value += 8;
+        value_size -= 8;
+        type = be32(item + 4);
+        if (type == 0xa96e616d /* ©nam */) set_string(&tags->title, from_codepage(CP_UTF8, (const char *)value, value_size));
+        else if (type == 0xa9415254 /* ©ART */) set_string(&tags->artist, from_codepage(CP_UTF8, (const char *)value, value_size));
+        else if (type == 0xa9616c62 /* ©alb */) set_string(&tags->album, from_codepage(CP_UTF8, (const char *)value, value_size));
+        else if (!memcmp(item + 4, "aART", 4)) set_string(&tags->album_artist, from_codepage(CP_UTF8, (const char *)value, value_size));
+        else if (type == 0xa967656e /* ©gen */) set_string(&tags->genre, from_codepage(CP_UTF8, (const char *)value, value_size));
+        else if (!memcmp(item + 4, "gnre", 4) && value_size >= 2 && !tags->genre)
+        {
+            UINT n = (value[0] << 8 | value[1]) - 1;
+            if (n < ARRAY_SIZE(id3_genres))
+                set_string(&tags->genre, from_codepage(CP_ACP, id3_genres[n], strlen(id3_genres[n])));
+        }
+        else if (!memcmp(item + 4, "trkn", 4) && value_size >= 4 && !tags->track) tags->track = value[2] << 8 | value[3];
+        else if (!memcmp(item + 4, "covr", 4) && (kind == 13 || kind == 14 || kind == 27 || kind == 0))
+            set_picture(tags, value, value_size);
+    }
+}
+
+/* KEY=value comments (little-endian lengths), as FLAC and Ogg carry them */
+static void parse_vorbis_comments(const BYTE *data, SIZE_T size, struct media_tags *tags)
+{
+    DWORD vendor, count, i, len;
+    SIZE_T pos = 0;
+
+    if (size < 8) return;
+    vendor = le32(data);
+    if (vendor > size - 8) return;
+    pos = 4 + vendor;
+    count = le32(data + pos);
+    pos += 4;
+    for (i = 0; i < count && pos + 4 <= size; i++)
+    {
+        const char *comment, *eq;
+
+        len = le32(data + pos);
+        pos += 4;
+        if (len > size - pos) break;
+        comment = (const char *)data + pos;
+        pos += len;
+        if (!(eq = memchr(comment, '=', len))) continue;
+#define KEY(name) ((size_t)(eq - comment) == sizeof(name) - 1 && !_strnicmp(comment, name, sizeof(name) - 1))
+        if (KEY("TITLE")) set_string(&tags->title, from_codepage(CP_UTF8, eq + 1, len - (eq + 1 - comment)));
+        else if (KEY("ARTIST")) set_string(&tags->artist, from_codepage(CP_UTF8, eq + 1, len - (eq + 1 - comment)));
+        else if (KEY("ALBUM")) set_string(&tags->album, from_codepage(CP_UTF8, eq + 1, len - (eq + 1 - comment)));
+        else if (KEY("ALBUMARTIST")) set_string(&tags->album_artist, from_codepage(CP_UTF8, eq + 1, len - (eq + 1 - comment)));
+        else if (KEY("GENRE")) set_string(&tags->genre, from_codepage(CP_UTF8, eq + 1, len - (eq + 1 - comment)));
+        else if (KEY("TRACKNUMBER") && !tags->track) tags->track = strtoul(eq + 1, NULL, 10);
+#undef KEY
+    }
+}
+
+static void parse_flac(const BYTE *data, SIZE_T size, struct media_tags *tags)
+{
+    SIZE_T pos = 4;
+
+    if (size < 8 || memcmp(data, "fLaC", 4)) return;
+    while (pos + 4 <= size)
+    {
+        BYTE header = data[pos];
+        DWORD len = data[pos + 1] << 16 | data[pos + 2] << 8 | data[pos + 3];
+        const BYTE *block = data + pos + 4;
+
+        pos += 4;
+        if (len > size - pos) break;
+        if ((header & 0x7f) == 4) parse_vorbis_comments(block, len, tags);
+        else if ((header & 0x7f) == 6 && len >= 32)
+        {
+            DWORD p = 4, n;
+            n = be32(block + p); p += 4 + n;                  /* MIME type */
+            if (p + 4 > len) goto next;
+            n = be32(block + p); p += 4 + n;                  /* description */
+            if (p + 20 > len) goto next;
+            p += 16;                                          /* width, height, depth, colours */
+            n = be32(block + p); p += 4;
+            if (n <= len - p) set_picture(tags, block + p, n);
+        }
+    next:
+        pos += len;
+        if (header & 0x80) break;
+    }
+}
+
+/* the first packets of an Ogg stream, joined, and their comment header */
+static void parse_ogg(const BYTE *data, SIZE_T size, struct media_tags *tags)
+{
+    BYTE *packets;
+    SIZE_T pos = 0, len = 0, limit = min(size, 1024 * 1024);
+    const BYTE *p;
+
+    if (size < 27 || memcmp(data, "OggS", 4)) return;
+    if (!(packets = malloc(limit))) return;
+    while (pos + 27 <= limit)
+    {
+        BYTE segments;
+        SIZE_T body = 0, i;
+
+        if (memcmp(data + pos, "OggS", 4)) break;
+        segments = data[pos + 26];
+        if (pos + 27 + segments > limit) break;
+        for (i = 0; i < segments; i++) body += data[pos + 27 + i];
+        if (pos + 27 + segments + body > limit) break;
+        memcpy(packets + len, data + pos + 27 + segments, body);
+        len += body;
+        pos += 27 + segments + body;
+        if (len > 256 * 1024) break;
+    }
+    for (p = packets; p + 8 < packets + len; p++)
+    {
+        if (!memcmp(p, "\x03vorbis", 7)) { parse_vorbis_comments(p + 7, packets + len - p - 7, tags); break; }
+        if (!memcmp(p, "OpusTags", 8)) { parse_vorbis_comments(p + 8, packets + len - p - 8, tags); break; }
+    }
+    free(packets);
+}
+
+HRESULT media_tags_read(const WCHAR *path, struct media_tags *tags)
+{
+    LARGE_INTEGER file_size;
+    const WCHAR *name, *dot;
+    DWORD read, head_size;
+    BYTE *data;
+    HANDLE file;
+
+    memset(tags, 0, sizeof(*tags));
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                       OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+    if (!GetFileSizeEx(file, &file_size)) file_size.QuadPart = 0;
+    head_size = (DWORD)min(file_size.QuadPart, MAX_READ);
+    if (!(data = malloc(max(head_size, 1))))
+    {
+        CloseHandle(file);
+        return E_OUTOFMEMORY;
+    }
+    if (!ReadFile(file, data, head_size, &read, NULL)) read = 0;
+
+#ifndef SG_MUTANT_MC_NO_TAGS
+    parse_id3v2(data, read, tags);
+    parse_mp4(data, read, tags);
+    parse_flac(data, read, tags);
+    parse_ogg(data, read, tags);
+    if (file_size.QuadPart >= 128)
+    {
+        BYTE tail[128];
+        LARGE_INTEGER at;
+        at.QuadPart = file_size.QuadPart - 128;
+        if (SetFilePointerEx(file, at, NULL, FILE_BEGIN) && ReadFile(file, tail, 128, &read, NULL) && read == 128)
+            parse_id3v1(tail, 128, tags);
+    }
+#endif
+    free(data);
+    CloseHandle(file);
+
+    /* no title: the file's name */
+    if (!tags->title)
+    {
+        name = wcsrchr(path, '\\');
+        name = name ? name + 1 : path;
+        if (!(dot = wcsrchr(name, '.'))) dot = name + wcslen(name);
+        if ((tags->title = malloc((dot - name + 1) * sizeof(WCHAR))))
+        {
+            memcpy(tags->title, name, (dot - name) * sizeof(WCHAR));
+            tags->title[dot - name] = 0;
+        }
+    }
+    TRACE("%s: title %s, artist %s, album %s, track %u, picture %Iu bytes\n", debugstr_w(path),
+          debugstr_w(tags->title), debugstr_w(tags->artist), debugstr_w(tags->album), tags->track, tags->picture_size);
+    return S_OK;
+}
