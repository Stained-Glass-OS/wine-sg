+    *id = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI bool_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    if (!status) return E_POINTER;
+    *status = Completed;
+    return S_OK;
+}
+
+static HRESULT WINAPI bool_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error_code )
+{
+    if (!error_code) return E_POINTER;
+    *error_code = S_OK;
+    return S_OK;
+}
+
+static HRESULT WINAPI bool_info_Cancel( IAsyncInfo *iface )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI bool_info_Close( IAsyncInfo *iface )
