+/* the handlers of a list, called outside the lock */
+static void raise_device_changed(EDataFlow flow, AudioDeviceRole role, const WCHAR *devid)
+{
+    struct list *list = flow == eRender ? &render_handlers : &capture_handlers;
+    struct device_changed_args *args;
+    struct handler *entry;
+    IUnknown **handlers;
+    UINT count = 0, i;
+
+    if (!(args = calloc(1, sizeof(*args)))) return;
+    args->IDefaultAudioDeviceChangedEventArgs_iface.lpVtbl = &device_changed_args_vtbl;
+    args->ref = 1;
+    args->role = role;
+    args->render = flow == eRender;
+    format_device_id(flow, devid, &args->id);
+
+    AcquireSRWLockShared(&event_lock);
+    LIST_FOR_EACH_ENTRY(entry, list, struct handler, entry) count++;
+    if ((handlers = calloc(max(count, 1), sizeof(*handlers))))
+    {
+        count = 0;
+        LIST_FOR_EACH_ENTRY(entry, list, struct handler, entry)
+        {
+            handlers[count] = entry->handler;
+            IUnknown_AddRef(handlers[count]);
+            count++;
+        }
+    }
+    else count = 0;
+    ReleaseSRWLockShared(&event_lock);
+
+    TRACE("flow %d, role %d, id %s, %u handlers\n", flow, role, debugstr_w(devid), count);
+    for (i = 0; i < count; i++)
+    {
+        /* both handler types have the one Invoke(sender, args) */
+        if (flow == eRender)
+            ITypedEventHandler_IInspectable_DefaultAudioRenderDeviceChangedEventArgs_Invoke(
+                (ITypedEventHandler_IInspectable_DefaultAudioRenderDeviceChangedEventArgs *)handlers[i], NULL,
+                &args->IDefaultAudioDeviceChangedEventArgs_iface);
+        else
+            ITypedEventHandler_IInspectable_DefaultAudioCaptureDeviceChangedEventArgs_Invoke(
+                (ITypedEventHandler_IInspectable_DefaultAudioCaptureDeviceChangedEventArgs *)handlers[i], NULL,
+                &args->IDefaultAudioDeviceChangedEventArgs_iface);
+        IUnknown_Release(handlers[i]);
+    }
+    free(handlers);
+    IDefaultAudioDeviceChangedEventArgs_Release(&args->IDefaultAudioDeviceChangedEventArgs_iface);
+}
+
+static HRESULT WINAPI notification_client_QueryInterface(IMMNotificationClient *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IMMNotificationClient))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI notification_client_AddRef(IMMNotificationClient *iface) { return 2; }
+static ULONG WINAPI notification_client_Release(IMMNotificationClient *iface) { return 1; }
+
+static HRESULT WINAPI notification_client_OnDeviceStateChanged(IMMNotificationClient *iface, const WCHAR *id, DWORD state)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI notification_client_OnDeviceAdded(IMMNotificationClient *iface, const WCHAR *id)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI notification_client_OnDeviceRemoved(IMMNotificationClient *iface, const WCHAR *id)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI notification_client_OnDefaultDeviceChanged(IMMNotificationClient *iface, EDataFlow flow, ERole role,
+                                                                 const WCHAR *id)
+{
+#ifdef SG_MUTANT_MD_NO_DEVICE_EVENTS
+    return S_OK;
+#endif
+    /* eConsole is also reported as eMultimedia: one event for the Default role */
+    if (role == eMultimedia) raise_device_changed(flow, AudioDeviceRole_Default, id);
+    else if (role == eCommunications) raise_device_changed(flow, AudioDeviceRole_Communications, id);
+    return S_OK;
+}
+
+static HRESULT WINAPI notification_client_OnPropertyValueChanged(IMMNotificationClient *iface, const WCHAR *id,
+                                                                 const PROPERTYKEY key)
+{
+    return S_OK;
+}
+
+static const struct IMMNotificationClientVtbl notification_client_vtbl =
+{
+    notification_client_QueryInterface,
+    notification_client_AddRef,
+    notification_client_Release,
+    notification_client_OnDeviceStateChanged,
+    notification_client_OnDeviceAdded,
+    notification_client_OnDeviceRemoved,
+    notification_client_OnDefaultDeviceChanged,
+    notification_client_OnPropertyValueChanged,
+};
+
+static IMMNotificationClient notification_client = { &notification_client_vtbl };
+static IMMDeviceEnumerator *notification_enumerator;
+static INIT_ONCE notification_once = INIT_ONCE_STATIC_INIT;
+
+/* registered once, for the life of the process */
+static BOOL CALLBACK register_notification(INIT_ONCE *once, void *param, void **context)
+{
+    IMMDeviceEnumerator *devenum;
+    HRESULT hr, init = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+
+    hr = CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL, CLSCTX_INPROC_SERVER, &IID_IMMDeviceEnumerator, (void **)&devenum);
+    if (SUCCEEDED(hr))
+    {
+        if (SUCCEEDED(hr = IMMDeviceEnumerator_RegisterEndpointNotificationCallback(devenum, &notification_client)))
+            notification_enumerator = devenum;
+        else
+            IMMDeviceEnumerator_Release(devenum);
+    }
+    if (FAILED(hr)) WARN("no default-device notifications: %#lx\n", hr);
+    if (SUCCEEDED(init)) CoUninitialize();
+    return TRUE;
 }
 
 static HRESULT WINAPI media_device_statics_QueryInterface(IMediaDeviceStatics *iface,
@@ -419,6 +644,7 @@ static HRESULT WINAPI media_device_statics_add_DefaultAudioCaptureDeviceChanged(
         EventRegistrationToken *token)
 {
     TRACE("iface %p, handler %p token %p\n", iface, handler, token);
+    InitOnceExecuteOnce(&notification_once, register_notification, NULL, NULL);
     return event_add(&capture_handlers, (IUnknown *)handler, token);
 }
 
@@ -436,6 +662,7 @@ static HRESULT WINAPI media_device_statics_add_DefaultAudioRenderDeviceChanged(
         EventRegistrationToken *token)
 {
     TRACE("iface %p, handler %p token %p\n", iface, handler, token);
+    InitOnceExecuteOnce(&notification_once, register_notification, NULL, NULL);
     return event_add(&render_handlers, (IUnknown *)handler, token);
 }
 
