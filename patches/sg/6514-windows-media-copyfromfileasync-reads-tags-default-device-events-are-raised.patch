+/*
+ * Stained Glass OS (wine-sg 6514): CopyFromFileAsync reads the file's own tags (metadata.c:
+ * ID3, MP4, FLAC, Ogg) into the music, video or image properties and the thumbnail (its cover
+ * picture). It was a stub, so players that fill the overlay from the file showed nothing.
+ * The work is done at the call; the operation is returned completed.
+ */
+struct bool_operation
+{
+    IAsyncOperation_boolean IAsyncOperation_boolean_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    boolean result;
+    IAsyncOperationCompletedHandler_boolean *handler;
+    BOOL handler_set;
+};
+
+static inline struct bool_operation *impl_from_IAsyncOperation_boolean( IAsyncOperation_boolean *iface )
+{
+    return CONTAINING_RECORD( iface, struct bool_operation, IAsyncOperation_boolean_iface );
+}
+
+static HRESULT WINAPI bool_operation_QueryInterface( IAsyncOperation_boolean *iface, REFIID iid, void **out )
+{
+    struct bool_operation *impl = impl_from_IAsyncOperation_boolean( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncOperation_boolean ))
+        *out = &impl->IAsyncOperation_boolean_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI bool_operation_AddRef( IAsyncOperation_boolean *iface )
+{
+    return InterlockedIncrement( &impl_from_IAsyncOperation_boolean( iface )->ref );
+}
+
+static ULONG WINAPI bool_operation_Release( IAsyncOperation_boolean *iface )
+{
+    struct bool_operation *impl = impl_from_IAsyncOperation_boolean( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->handler) IAsyncOperationCompletedHandler_boolean_Release( impl->handler );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI bool_operation_GetIids( IAsyncOperation_boolean *iface, ULONG *iid_count, IID **iids )
+{
+    return SG_GET_IIDS( iid_count, iids, &IID_IAsyncOperation_boolean, &IID_IAsyncInfo );
+}
+
+static HRESULT WINAPI bool_operation_GetRuntimeClassName( IAsyncOperation_boolean *iface, HSTRING *class_name )
+{
+    return sg_class_name( L"Windows.Foundation.IAsyncOperation`1<Boolean>", class_name );
+}
+
+static HRESULT WINAPI bool_operation_GetTrustLevel( IAsyncOperation_boolean *iface, TrustLevel *trust_level )
+{
+    return sg_get_trust_level( trust_level );
+}
+
+static HRESULT WINAPI bool_operation_put_Completed( IAsyncOperation_boolean *iface, IAsyncOperationCompletedHandler_boolean *handler )
+{
+    struct bool_operation *impl = impl_from_IAsyncOperation_boolean( iface );
+
+    if (!handler) return E_POINTER;
+    if (InterlockedExchange( (LONG *)&impl->handler_set, TRUE )) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    IAsyncOperationCompletedHandler_boolean_AddRef( (impl->handler = handler) );
+    /* already complete: the handler runs now */
+    return IAsyncOperationCompletedHandler_boolean_Invoke( handler, iface, Completed );
+}
+
+static HRESULT WINAPI bool_operation_get_Completed( IAsyncOperation_boolean *iface, IAsyncOperationCompletedHandler_boolean **handler )
+{
+    struct bool_operation *impl = impl_from_IAsyncOperation_boolean( iface );
+
+    if (!handler) return E_POINTER;
+    if ((*handler = impl->handler)) IAsyncOperationCompletedHandler_boolean_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI bool_operation_GetResults( IAsyncOperation_boolean *iface, boolean *results )
+{
+    if (!results) return E_POINTER;
+    *results = impl_from_IAsyncOperation_boolean( iface )->result;
+    return S_OK;
+}
+
+static const struct IAsyncOperation_booleanVtbl bool_operation_vtbl =
+{
+    bool_operation_QueryInterface,
+    bool_operation_AddRef,
+    bool_operation_Release,
+    bool_operation_GetIids,
+    bool_operation_GetRuntimeClassName,
+    bool_operation_GetTrustLevel,
+    bool_operation_put_Completed,
+    bool_operation_get_Completed,
+    bool_operation_GetResults,
+};
+
