+static HRESULT WINAPI device_changed_args_GetRuntimeClassName(IDefaultAudioDeviceChangedEventArgs *iface, HSTRING *class_name)
+{
+    struct device_changed_args *impl = impl_from_IDefaultAudioDeviceChangedEventArgs(iface);
