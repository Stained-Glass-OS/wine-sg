From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcrt4: Add FC_WSTRING to the NDR dispatch tables.

FC_WSTRING (a non-conformant wide string) gets its entries in the NDR
marshal, unmarshal, buffer-size and memory-size tables, as FC_CSTRING has:
NdrNonConformantString* already handle both. With the slots empty a
pointer to one failed with "no marshaller", and stubless calls raised
RPC_X_BAD_STUB_DATA.

Gate: test/rpcrt4-fcwstring-gate.sh (64/32).
---
 dlls/rpcrt4/ndr_marshall.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/dlls/rpcrt4/ndr_marshall.c b/dlls/rpcrt4/ndr_marshall.c
index b5375b2..c12d52a 100644
--- a/dlls/rpcrt4/ndr_marshall.c
+++ b/dlls/rpcrt4/ndr_marshall.c
@@ -194,7 +194,12 @@ const NDR_MARSHALL NdrMarshaller[NDR_TABLE_SIZE] = {
   /* 0x22 */
   NdrConformantStringMarshall, 0, 0,
   NdrConformantStringMarshall,
+#ifndef SG_MUTANT_NDR_NO_FC_WSTRING
+  /* FC_CSTRING, FC_BSTRING, FC_SSTRING, FC_WSTRING */
+  NdrNonConformantStringMarshall, 0, 0, NdrNonConformantStringMarshall,
+#else
   NdrNonConformantStringMarshall, 0, 0, 0,
+#endif
   /* 0x2a */
   NdrEncapsulatedUnionMarshall,
   NdrNonEncapsulatedUnionMarshall,
@@ -238,7 +243,12 @@ const NDR_UNMARSHALL NdrUnmarshaller[NDR_TABLE_SIZE] = {
   /* 0x22 */
   NdrConformantStringUnmarshall, 0, 0,
   NdrConformantStringUnmarshall,
+#ifndef SG_MUTANT_NDR_NO_FC_WSTRING
+  /* FC_CSTRING, FC_BSTRING, FC_SSTRING, FC_WSTRING */
+  NdrNonConformantStringUnmarshall, 0, 0, NdrNonConformantStringUnmarshall,
+#else
   NdrNonConformantStringUnmarshall, 0, 0, 0,
+#endif
   /* 0x2a */
   NdrEncapsulatedUnionUnmarshall,
   NdrNonEncapsulatedUnionUnmarshall,
@@ -282,7 +292,12 @@ const NDR_BUFFERSIZE NdrBufferSizer[NDR_TABLE_SIZE] = {
   /* 0x22 */
   NdrConformantStringBufferSize, 0, 0,
   NdrConformantStringBufferSize,
+#ifndef SG_MUTANT_NDR_NO_FC_WSTRING
+  /* FC_CSTRING, FC_BSTRING, FC_SSTRING, FC_WSTRING */
+  NdrNonConformantStringBufferSize, 0, 0, NdrNonConformantStringBufferSize,
+#else
   NdrNonConformantStringBufferSize, 0, 0, 0,
+#endif
   /* 0x2a */
   NdrEncapsulatedUnionBufferSize,
   NdrNonEncapsulatedUnionBufferSize,
@@ -326,7 +341,12 @@ const NDR_MEMORYSIZE NdrMemorySizer[NDR_TABLE_SIZE] = {
   /* 0x22 */
   NdrConformantStringMemorySize, 0, 0,
   NdrConformantStringMemorySize,
+#ifndef SG_MUTANT_NDR_NO_FC_WSTRING
+  /* FC_CSTRING, FC_BSTRING, FC_SSTRING, FC_WSTRING */
+  NdrNonConformantStringMemorySize, 0, 0, NdrNonConformantStringMemorySize,
+#else
   NdrNonConformantStringMemorySize, 0, 0, 0,
+#endif
   /* 0x2a */
   NdrEncapsulatedUnionMemorySize,
   NdrNonEncapsulatedUnionMemorySize,
