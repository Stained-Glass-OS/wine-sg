From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ole32: OleCreateEx

OleCreateEx creates an embedded object as OleCreate does, with any number of formats: for OLERENDER_FORMAT the first is cached as OleCreate caches it and each further one is cached too; with an advise sink each format is advised to it through IDataObject::DAdvise (the connections returned), or for OLERENDER_DRAW the view through IViewObject::SetAdvise. It was a spec stub. ole2.h gains it.
---
--- a/include/ole2.h
+++ b/include/ole2.h
@@ -103,6 +103,7 @@
                                                    DWORD *conns, LPOLECLIENTSITE client_site, LPSTORAGE storage, LPVOID* obj);
 WINOLE32API HRESULT     WINAPI OleCreateLink(LPMONIKER pmkLinkSrc, REFIID riid, DWORD renderopt, LPFORMATETC lpFormatEtc,LPOLECLIENTSITE pClientSite, LPSTORAGE pStg, LPVOID* ppvObj);
 WINOLE32API HRESULT     WINAPI OleCreate(REFCLSID rclsid, REFIID riid, DWORD renderopt, LPFORMATETC pFormatEtc, LPOLECLIENTSITE pClientSite,LPSTORAGE pStg, LPVOID* ppvObj);
+HRESULT     WINAPI OleCreateEx(REFCLSID,REFIID,DWORD,DWORD,ULONG,DWORD*,LPFORMATETC,IAdviseSink*,DWORD*,LPOLECLIENTSITE,LPSTORAGE,LPVOID*);
 WINOLE32API HRESULT     WINAPI OleFlushClipboard(void);
 WINOLE32API HRESULT     WINAPI GetConvertStg(LPSTORAGE pStg);
 WINOLE32API HRESULT     WINAPI SetConvertStg(LPSTORAGE pStg, BOOL fConvert);
--- a/dlls/ole32/ole2.c
+++ b/dlls/ole32/ole2.c
@@ -2772,6 +2772,92 @@
     return hres;
 }
 
+#ifndef SG_MUTANT_NO_OLECREATEEX
+/******************************************************************************
+ *              OleCreateEx        [OLE32.@]
+ *
+ * (wine-sg 8275) OleCreate with any number of formats: the object is created as OleCreate creates it (for
+ * OLERENDER_FORMAT with the first format cached), each further format is cached too, and with an advise sink
+ * each format is advised to it (IDataObject::DAdvise, connections in rgdwConnection) -- or, for
+ * OLERENDER_DRAW, the view is (IViewObject::SetAdvise).
+ */
+HRESULT WINAPI OleCreateEx(REFCLSID clsid, REFIID riid, DWORD flags, DWORD renderopt, ULONG count, DWORD *advf,
+                           FORMATETC *formats, IAdviseSink *sink, DWORD *connections, IOleClientSite *site,
+                           IStorage *stg, void **obj)
+{
+    IUnknown *unk;
+    ULONG i;
+    HRESULT hr;
+
+    TRACE("%s, %s, %#lx, %lu, %lu, %p, %p, %p, %p, %p, %p, %p\n", debugstr_guid(clsid), debugstr_guid(riid), flags,
+          renderopt, count, advf, formats, sink, connections, site, stg, obj);
+
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+    if (renderopt == OLERENDER_FORMAT && (!count || !formats)) return E_INVALIDARG;
+    if (count && !formats) return E_INVALIDARG;
+    if (sink && count && !connections) return E_INVALIDARG;
+
+    hr = OleCreate(clsid, riid, renderopt, renderopt == OLERENDER_FORMAT ? &formats[0] : NULL, site, stg, (void **)&unk);
+    if (FAILED(hr)) return hr;
+
+    if (renderopt == OLERENDER_FORMAT && count > 1)
+    {
+        IOleCache *cache;
+
+        if (SUCCEEDED(hr = IUnknown_QueryInterface(unk, &IID_IOleCache, (void **)&cache)))
+        {
+            for (i = 1; i < count && SUCCEEDED(hr); i++)
+            {
+                DWORD conn;
+                hr = IOleCache_Cache(cache, &formats[i], advf ? advf[i] : ADVF_PRIMEFIRST, &conn);
+                if (hr == CACHE_S_SAMECACHE || hr == CACHE_S_FORMATETC_NOTSUPPORTED) hr = S_OK;
+            }
+            IOleCache_Release(cache);
+        }
+    }
+    if (SUCCEEDED(hr) && sink)
+    {
+        if (renderopt == OLERENDER_DRAW)
+        {
+            IViewObject *view;
+
+            if (SUCCEEDED(hr = IUnknown_QueryInterface(unk, &IID_IViewObject, (void **)&view)))
+            {
+                hr = IViewObject_SetAdvise(view, formats ? formats[0].dwAspect : DVASPECT_CONTENT,
+                                           advf ? advf[0] : 0, sink);
+                IViewObject_Release(view);
+            }
+        }
+        else if (count)
+        {
+            IDataObject *data;
+
+            if (SUCCEEDED(hr = IUnknown_QueryInterface(unk, &IID_IDataObject, (void **)&data)))
+            {
+                for (i = 0; i < count && SUCCEEDED(hr); i++)
+                    hr = IDataObject_DAdvise(data, &formats[i], advf ? advf[i] : 0, sink, &connections[i]);
+                IDataObject_Release(data);
+            }
+        }
+    }
+    if (FAILED(hr))
+    {
+        IUnknown_Release(unk);
+        return hr;
+    }
+    *obj = unk;
+    return S_OK;
+}
+#else
+HRESULT WINAPI OleCreateEx(REFCLSID clsid, REFIID riid, DWORD flags, DWORD renderopt, ULONG count, DWORD *advf,
+                           FORMATETC *formats, IAdviseSink *sink, DWORD *connections, IOleClientSite *site,
+                           IStorage *stg, void **obj)
+{
+    return E_NOTIMPL;
+}
+#endif
+
 /******************************************************************************
  *              OleGetAutoConvert        [OLE32.@]
  */
