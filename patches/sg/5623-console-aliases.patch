+DWORD WINAPI GetConsoleAliasesW( LPWSTR buffer, DWORD len, LPWSTR exename )
+{
+    return get_console_alias_list( FALSE, exename, buffer, len, TRUE, FALSE );
+}
+
+/******************************************************************
+ *	GetConsoleAliasesA   (kernelbase.@)
+ */
+DWORD WINAPI GetConsoleAliasesA( LPSTR buffer, DWORD len, LPSTR exename )
+{
+    WCHAR *e = exename ? alias_strAtoW( exename ) : NULL;
+    DWORD ret = 0;
+
+    if (exename && !e) SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+    else ret = get_console_alias_list( FALSE, e, buffer, len, FALSE, FALSE );
+    HeapFree( GetProcessHeap(), 0, e );
+    return ret;
+}
 
