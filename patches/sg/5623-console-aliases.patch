+static void test_console_aliases(void)
+{
+    static WCHAR ls[] = L"ls", lsval[] = L"dir /w $*", ll[] = L"ll", llval[] = L"dir /s", exe1[] = L"alias1.exe",
+                 exe1_up[] = L"ALIAS1.EXE", exe2[] = L"alias2.exe", lsup[] = L"LS", empty[] = L"", nope[] = L"nope", other[] = L"other.exe";
+    static char dira[] = "dir", lsa[] = "ls", lsvala[] = "dir /w $*", exe1a[] = "alias1.exe";
+    WCHAR buf[128];
+    char bufa[128];
+    DWORD ret, size;
+    BOOL bret;
+
+    SetLastError( 0xdeadbeef );
+    ret = GetConsoleAliasesLengthW( exe1 );
+    ok( !ret, "got %lu\n", ret );
+    ret = GetConsoleAliasExesLengthW();
+    ok( !ret, "got %lu\n", ret );
+
+    bret = AddConsoleAliasW( ls, lsval, exe1 );
+    ok( bret, "AddConsoleAliasW failed: %lu\n", GetLastError() );
+    bret = AddConsoleAliasW( ll, llval, exe1 );
+    ok( bret, "AddConsoleAliasW failed: %lu\n", GetLastError() );
+    bret = AddConsoleAliasW( ls, lsval, exe2 );
+    ok( bret, "AddConsoleAliasW failed: %lu\n", GetLastError() );
+
+    memset( buf, 0x55, sizeof(buf) );
+    ret = GetConsoleAliasW( ls, buf, sizeof(buf), exe1 );
+    ok( ret == sizeof(lsval), "got %lu\n", ret );
+    ok( !wcscmp( buf, lsval ), "got %s\n", wine_dbgstr_w( buf ));
+
+    /* names are matched without regard to case */
+    ret = GetConsoleAliasW( lsup, buf, sizeof(buf), exe1_up );
+    ok( ret == sizeof(lsval), "got %lu, error %lu\n", ret, GetLastError() );
+    ok( !wcscmp( buf, lsval ), "got %s\n", wine_dbgstr_w( buf ));
+
+    SetLastError( 0xdeadbeef );
+    ret = GetConsoleAliasW( ls, buf, sizeof(lsval) - sizeof(WCHAR), exe1 );
+    ok( !ret, "got %lu\n", ret );
+    ok( GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got error %lu\n", GetLastError() );
+
+    SetLastError( 0xdeadbeef );
+    ret = GetConsoleAliasW( nope, buf, sizeof(buf), exe1 );
+    ok( !ret, "got %lu\n", ret );
+    ok( GetLastError() == ERROR_NOT_FOUND, "got error %lu\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    ret = GetConsoleAliasW( ls, buf, sizeof(buf), other );
+    ok( !ret, "got %lu\n", ret );
+    ok( GetLastError() == ERROR_NOT_FOUND, "got error %lu\n", GetLastError() );
+
+    SetLastError( 0xdeadbeef );
+    ret = GetConsoleAliasW( empty, buf, sizeof(buf), exe1 );
+    ok( !ret && GetLastError() == ERROR_INVALID_PARAMETER, "got %lu, error %lu\n", ret, GetLastError() );
+
+    /* lengths are in bytes, "source=target" each ended by a NUL */
+    size = (wcslen( ls ) + 1 + wcslen( lsval ) + 1 + wcslen( ll ) + 1 + wcslen( llval ) + 1) * sizeof(WCHAR);
+    ret = GetConsoleAliasesLengthW( exe1 );
+    ok( ret == size, "got %lu, expected %lu\n", ret, size );
+    memset( buf, 0x55, sizeof(buf) );
+    ret = GetConsoleAliasesW( buf, sizeof(buf), exe1 );
+    ok( ret == size, "got %lu, expected %lu\n", ret, size );
+    ok( !memcmp( buf, L"ls=dir /w $*\0ll=dir /s\0", size ), "got %s\n", wine_dbgstr_wn( buf, size / sizeof(WCHAR) ));
+    SetLastError( 0xdeadbeef );
+    ret = GetConsoleAliasesW( buf, size - 2, exe1 );
+    ok( !ret && GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %lu, error %lu\n", ret, GetLastError() );
+
+    size = (wcslen( exe1 ) + 1 + wcslen( exe2 ) + 1) * sizeof(WCHAR);
+    ret = GetConsoleAliasExesLengthW();
+    ok( ret == size, "got %lu, expected %lu\n", ret, size );
+    memset( buf, 0x55, sizeof(buf) );
+    ret = GetConsoleAliasExesW( buf, sizeof(buf) );
+    ok( ret == size, "got %lu\n", ret );
+    ok( !memcmp( buf, L"alias1.exe\0alias2.exe\0", size ), "got %s\n", wine_dbgstr_wn( buf, size / sizeof(WCHAR) ));
+
+    /* the ANSI forms count bytes of the console code page */
+    ret = GetConsoleAliasA( lsa, bufa, sizeof(bufa), exe1a );
+    ok( ret == sizeof(lsvala), "got %lu\n", ret );
+    ok( !strcmp( bufa, lsvala ), "got %s\n", debugstr_a( bufa ));
+    ret = GetConsoleAliasesLengthA( exe1a );
+    ok( ret == strlen( "ls=dir /w $*" ) + 1 + strlen( "ll=dir /s" ) + 1, "got %lu\n", ret );
+    ret = GetConsoleAliasExesLengthA();
+    ok( ret == strlen( "alias1.exe" ) + 1 + strlen( "alias2.exe" ) + 1, "got %lu\n", ret );
+    ret = GetConsoleAliasesA( bufa, sizeof(bufa), exe1a );
+    ok( !memcmp( bufa, "ls=dir /w $*\0ll=dir /s\0", ret ), "got %s\n", debugstr_an( bufa, ret ));
+    bret = AddConsoleAliasA( lsa, dira, exe1a );
+    ok( bret, "AddConsoleAliasA failed: %lu\n", GetLastError() );
+    ret = GetConsoleAliasA( lsa, bufa, sizeof(bufa), exe1a );
+    ok( ret == 4 && !strcmp( bufa, "dir" ), "got %lu %s\n", ret, debugstr_a( bufa ));
+
+    /* a new target replaces the old one and keeps the order */
+    ret = GetConsoleAliasesW( buf, sizeof(buf), exe1 );
+    ok( !memcmp( buf, L"ls=dir\0ll=dir /s\0", ret ), "got %s\n", wine_dbgstr_wn( buf, ret / sizeof(WCHAR) ));
+
+    /* no target removes the alias; the last alias takes its executable along */
+    bret = AddConsoleAliasW( ls, NULL, exe1 );
+    ok( bret, "AddConsoleAliasW failed: %lu\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    ret = GetConsoleAliasW( ls, buf, sizeof(buf), exe1 );
+    ok( !ret && GetLastError() == ERROR_NOT_FOUND, "got %lu, error %lu\n", ret, GetLastError() );
+    bret = AddConsoleAliasW( ll, NULL, exe1 );
+    ok( bret, "AddConsoleAliasW failed: %lu\n", GetLastError() );
+    ok( !GetConsoleAliasesLengthW( exe1 ), "aliases left\n" );
+    size = (wcslen( exe2 ) + 1) * sizeof(WCHAR);
+    ret = GetConsoleAliasExesLengthW();
+    ok( ret == size, "got %lu, expected %lu\n", ret, size );
+
+    SetLastError( 0xdeadbeef );
+    bret = AddConsoleAliasW( empty, lsval, exe2 );
+    ok( !bret && GetLastError() == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", bret, GetLastError() );
+    bret = AddConsoleAliasW( ls, NULL, exe2 );
+    ok( bret, "AddConsoleAliasW failed: %lu\n", GetLastError() );
+    ok( !GetConsoleAliasExesLengthW(), "executables left\n" );
+}
