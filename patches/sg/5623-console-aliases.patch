+/******************************************************************
+ *	GetConsoleAliasA   (kernelbase.@)
+ */
+DWORD WINAPI GetConsoleAliasA( LPSTR source, LPSTR buffer, DWORD len, LPSTR exename )
+{
+    WCHAR *s = source ? alias_strAtoW( source ) : NULL, *e = exename ? alias_strAtoW( exename ) : NULL;
+    DWORD ret = 0;
+
+    TRACE( "(%s,%p,%ld,%s)\n", debugstr_a(source), buffer, len, debugstr_a(exename) );
+    if ((source && !s) || (exename && !e)) SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+    else ret = get_console_alias( s, e, buffer, len, FALSE );
+    HeapFree( GetProcessHeap(), 0, s );
+    HeapFree( GetProcessHeap(), 0, e );
+    return ret;
+}
+
+/* the aliases of an executable, or the executables: bytes needed, or copied when there is a buffer */
+static DWORD get_console_alias_list( BOOL exes, const WCHAR *exename, void *buffer, DWORD len, BOOL wide,
+                                     BOOL want_length )
+{
+    WCHAR *text;
+    DWORD length, size = 0, ret;
+    void *in = NULL;
+
+    if (!exes)
+    {
+        if (!exename || !exename[0]) { SetLastError( ERROR_INVALID_PARAMETER ); return 0; }
+        if (!(in = alias_input( exename, NULL, &size, FALSE ))) { SetLastError( ERROR_NOT_ENOUGH_MEMORY ); return 0; }
+    }
+    if (!get_alias_text( exes ? IOCTL_CONDRV_GET_ALIAS_EXES : IOCTL_CONDRV_GET_ALIASES, in, size, &text, &length ))
+        ret = 0;
+    else
+    {
+        if (want_length) ret = alias_bytes( text, length, wide );
+        else ret = alias_copy_out( text, length, buffer, len, wide, FALSE );
+        HeapFree( GetProcessHeap(), 0, text );
+    }
+    HeapFree( GetProcessHeap(), 0, in );
+    return ret;
+}
 
