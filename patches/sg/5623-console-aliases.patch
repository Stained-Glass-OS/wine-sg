+/* ask for one of the texts; returns the number of characters it has (without the buffer limit), or -1 */
+static BOOL get_alias_text( DWORD code, const void *in, DWORD in_size, WCHAR **text, DWORD *length )
+{
+    NTSTATUS status;
+    DWORD total;
+
+    if (!alias_ioctl( code, in, in_size, NULL, 0, &total, &status )) return FALSE;
+    if (status)
+    {
+        SetLastError( status == STATUS_NOT_FOUND ? ERROR_NOT_FOUND : RtlNtStatusToDosError( status ));
+        return FALSE;
+    }
+    if (!(*text = HeapAlloc( GetProcessHeap(), 0, (total + 1) * sizeof(WCHAR) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    /* the table may change between the two calls: use what the second one says */
+    if (!alias_ioctl( code, in, in_size, *text, total, length, &status ))
+    {
+        HeapFree( GetProcessHeap(), 0, *text );
+        return FALSE;
+    }
+    if (*length > total) *length = total;
+    return TRUE;
+}
+
+static void *alias_input( const WCHAR *a, const WCHAR *b, DWORD *size, BOOL pair )
+{
+    DWORD alen = lstrlenW( a ), blen = b ? lstrlenW( b ) : 0;
+    DWORD *in;
+
+    if (!pair)
+    {
+        if (!(in = HeapAlloc( GetProcessHeap(), 0, (alen + 1) * sizeof(WCHAR) ))) return NULL;
+        memcpy( in, a, alen * sizeof(WCHAR) );
+        *size = alen * sizeof(WCHAR);
+        return in;
+    }
+    *size = offsetof( struct condrv_get_alias_params, buffer ) + (alen + blen) * sizeof(WCHAR);
+    if (!(in = HeapAlloc( GetProcessHeap(), 0, *size ))) return NULL;
+    in[0] = alen;
+    in[1] = blen;
+    memcpy( in + 2, a, alen * sizeof(WCHAR) );
+    memcpy( (WCHAR *)(in + 2) + alen, b, blen * sizeof(WCHAR) );
+    return in;
+}
+
+/* copy text of (length) characters into an output buffer (len bytes); the text ends with a NUL when
+ * nul is set; wide selects the character width. returns bytes, 0 and the error otherwise */
+static DWORD alias_copy_out( const WCHAR *text, DWORD length, void *buffer, DWORD len, BOOL wide, BOOL nul )
+{
+    DWORD need;
+
+    if (wide)
+    {
+        need = (length + (nul ? 1 : 0)) * sizeof(WCHAR);
+        if (len < need) { SetLastError( ERROR_INSUFFICIENT_BUFFER ); return 0; }
+        memcpy( buffer, text, length * sizeof(WCHAR) );
+        if (nul) ((WCHAR *)buffer)[length] = 0;
+        return need;
+    }
+    else
+    {
+        UINT cp = GetConsoleCP();
+        int n = WideCharToMultiByte( cp, 0, text, length, NULL, 0, NULL, NULL );
+
+        need = n + (nul ? 1 : 0);
+        if (len < need) { SetLastError( ERROR_INSUFFICIENT_BUFFER ); return 0; }
+        WideCharToMultiByte( cp, 0, text, length, buffer, n, NULL, NULL );
+        if (nul) ((char *)buffer)[n] = 0;
+        return need;
+    }
+}
+
+/* the size in bytes a text has once converted */
+static DWORD alias_bytes( const WCHAR *text, DWORD length, BOOL wide )
+{
+#ifdef SG_MUTANT_ALIAS_LEN_CHARS
+    return length;
+#endif
+    if (wide) return length * sizeof(WCHAR);
+    return WideCharToMultiByte( GetConsoleCP(), 0, text, length, NULL, 0, NULL, NULL );
+}
+
+static DWORD get_console_alias( const WCHAR *source, const WCHAR *exename, void *buffer, DWORD len, BOOL wide )
+{
+    WCHAR *text;
+    DWORD length, size, ret;
+    void *in;
+
+    if (!source || !exename || !source[0] || !exename[0] || (len && !buffer))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    if (!(in = alias_input( source, exename, &size, TRUE ))) { SetLastError( ERROR_NOT_ENOUGH_MEMORY ); return 0; }
+    if (!get_alias_text( IOCTL_CONDRV_GET_ALIAS, in, size, &text, &length)) ret = 0;
+    else
+    {
+        ret = alias_copy_out( text, length, buffer, len, wide, TRUE );
+        HeapFree( GetProcessHeap(), 0, text );
+    }
+    HeapFree( GetProcessHeap(), 0, in );
+    return ret;
+}
 
