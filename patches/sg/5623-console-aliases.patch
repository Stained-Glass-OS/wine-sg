+/* console aliases: per executable, matched without regard to case */
+static struct alias_exe *find_alias_exe( struct console *console, const WCHAR *name, size_t len )
+{
+    struct alias_exe *exe;
+
+    for (exe = console->alias_exes; exe; exe = exe->next)
+        if (wcslen( exe->name ) == len && !wcsnicmp( exe->name, name, len )) return exe;
+    return NULL;
+}
+
+static struct alias *find_alias( struct alias_exe *exe, const WCHAR *source, size_t len )
+{
+    struct alias *alias;
+
+    for (alias = exe->aliases; alias; alias = alias->next)
+#ifdef SG_MUTANT_ALIAS_CASE
+        if (wcslen( alias->source ) == len && !wcsncmp( alias->source, source, len )) return alias;
+#else
+        if (wcslen( alias->source ) == len && !wcsnicmp( alias->source, source, len )) return alias;
+#endif
+    return NULL;
+}
+
+static WCHAR *dup_alias_string( const WCHAR *str, size_t len )
+{
+    WCHAR *ret = malloc( (len + 1) * sizeof(WCHAR) );
+
+    if (!ret) return NULL;
+    memcpy( ret, str, len * sizeof(WCHAR) );
+    ret[len] = 0;
+    return ret;
+}
+
+static NTSTATUS add_alias( struct console *console, const struct condrv_alias_params *params, size_t in_size )
+{
+    const WCHAR *source = params->buffer, *target, *exe_name;
+    struct alias_exe *exe, **exe_link;
+    struct alias *alias, **link;
+    size_t total;
+
+    if (in_size < offsetof( struct condrv_alias_params, buffer )) return STATUS_INVALID_PARAMETER;
+    total = (size_t)params->source_len + params->target_len + params->exe_len;
+    if (in_size != offsetof( struct condrv_alias_params, buffer ) + total * sizeof(WCHAR))
+        return STATUS_INVALID_PARAMETER;
+    if (!params->source_len || !params->exe_len) return STATUS_INVALID_PARAMETER;
+    target = source + params->source_len;
+    exe_name = target + params->target_len;
+
+    exe = find_alias_exe( console, exe_name, params->exe_len );
+#ifdef SG_MUTANT_ALIAS_NO_REMOVE
+    if (params->remove) return STATUS_SUCCESS;
+#endif
+    if (params->remove)
+    {
+        if (!exe || !(alias = find_alias( exe, source, params->source_len ))) return STATUS_SUCCESS;
+        for (link = &exe->aliases; *link != alias; link = &(*link)->next) ;
+        *link = alias->next;
+        free( alias->source );
+        free( alias->target );
+        free( alias );
+        if (!exe->aliases)
+        {
+            for (exe_link = &console->alias_exes; *exe_link != exe; exe_link = &(*exe_link)->next) ;
+            *exe_link = exe->next;
+            free( exe->name );
+            free( exe );
+        }
+        return STATUS_SUCCESS;
+    }
+
+    if (!exe)
+    {
+        if (!(exe = calloc( 1, sizeof(*exe) ))) return STATUS_NO_MEMORY;
+        if (!(exe->name = dup_alias_string( exe_name, params->exe_len )))
+        {
+            free( exe );
+            return STATUS_NO_MEMORY;
+        }
+        for (exe_link = &console->alias_exes; *exe_link; exe_link = &(*exe_link)->next) ;
+        *exe_link = exe;
+    }
+    if ((alias = find_alias( exe, source, params->source_len )))
+    {
+        WCHAR *new_target = dup_alias_string( target, params->target_len );
+
+        if (!new_target) return STATUS_NO_MEMORY;
+        free( alias->target );
+        alias->target = new_target;
+        return STATUS_SUCCESS;
+    }
+    if (!(alias = calloc( 1, sizeof(*alias) ))) return STATUS_NO_MEMORY;
+    alias->source = dup_alias_string( source, params->source_len );
+    alias->target = dup_alias_string( target, params->target_len );
+    if (!alias->source || !alias->target)
+    {
+        free( alias->source );
+        free( alias->target );
+        free( alias );
+        return STATUS_NO_MEMORY;
+    }
+    for (link = &exe->aliases; *link; link = &(*link)->next) ;
+    *link = alias;
+    return STATUS_SUCCESS;
+}
+
+/* the answer of the alias ioctls: status and length, then as much of the text as the output holds */
+static NTSTATUS alias_result( NTSTATUS status, const WCHAR *text, size_t length, size_t *out_size )
+{
+    struct condrv_alias_result *result;
+    size_t room;
+
+    if (*out_size < offsetof( struct condrv_alias_result, buffer )) return STATUS_INVALID_PARAMETER;
+    room = (*out_size - offsetof( struct condrv_alias_result, buffer )) / sizeof(WCHAR);
+    if (room > length) room = length;
+    *out_size = offsetof( struct condrv_alias_result, buffer ) + room * sizeof(WCHAR);
+    if (!(result = alloc_ioctl_buffer( *out_size ))) return STATUS_NO_MEMORY;
+    result->status = status;
+    result->length = length;
+    if (room) memcpy( result->buffer, text, room * sizeof(WCHAR) );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS get_alias( struct console *console, const void *in_data, size_t in_size, size_t *out_size )
+{
+    const struct condrv_get_alias_params *params = in_data;
+    struct alias_exe *exe;
+    struct alias *alias;
+
+    if (in_size < offsetof( struct condrv_get_alias_params, buffer )) return STATUS_INVALID_PARAMETER;
+    if (in_size != offsetof( struct condrv_get_alias_params, buffer ) +
+                   ((size_t)params->source_len + params->exe_len) * sizeof(WCHAR))
+        return STATUS_INVALID_PARAMETER;
+    if (!params->source_len || !params->exe_len) return alias_result( STATUS_INVALID_PARAMETER, NULL, 0, out_size );
+    if (!(exe = find_alias_exe( console, params->buffer + params->source_len, params->exe_len )) ||
+        !(alias = find_alias( exe, params->buffer, params->source_len )))
+        return alias_result( STATUS_NOT_FOUND, NULL, 0, out_size );
+    return alias_result( STATUS_SUCCESS, alias->target, wcslen( alias->target ), out_size );
+}
+
+static NTSTATUS get_aliases( struct console *console, const void *in_data, size_t in_size, size_t *out_size )
+{
+    struct alias_exe *exe;
+    struct alias *alias;
+    size_t length = 0, pos = 0;
+    WCHAR *text;
+    NTSTATUS status;
+
+    if (in_size % sizeof(WCHAR) || !in_size) return STATUS_INVALID_PARAMETER;
+    if (!(exe = find_alias_exe( console, in_data, in_size / sizeof(WCHAR) )))
+        return alias_result( STATUS_SUCCESS, NULL, 0, out_size );
+    for (alias = exe->aliases; alias; alias = alias->next)
+        length += wcslen( alias->source ) + 1 + wcslen( alias->target ) + 1;
+    if (!(text = malloc( length * sizeof(WCHAR) ))) return STATUS_NO_MEMORY;
+    for (alias = exe->aliases; alias; alias = alias->next)
+    {
+        size_t n = wcslen( alias->source );
+
+        memcpy( text + pos, alias->source, n * sizeof(WCHAR) );
+        pos += n;
+        text[pos++] = '=';
+        n = wcslen( alias->target );
+        memcpy( text + pos, alias->target, n * sizeof(WCHAR) );
+        pos += n;
+        text[pos++] = 0;
+    }
+    status = alias_result( STATUS_SUCCESS, text, length, out_size );
+    free( text );
+    return status;
+}
+
+static NTSTATUS get_alias_exes( struct console *console, size_t *out_size )
+{
+    struct alias_exe *exe;
+    size_t length = 0, pos = 0;
+    WCHAR *text;
+    NTSTATUS status;
+
+    for (exe = console->alias_exes; exe; exe = exe->next) length += wcslen( exe->name ) + 1;
+    if (!(text = malloc( (length + 1) * sizeof(WCHAR) ))) return STATUS_NO_MEMORY;
+    for (exe = console->alias_exes; exe; exe = exe->next)
+    {
+        size_t n = wcslen( exe->name ) + 1;
+
+        memcpy( text + pos, exe->name, n * sizeof(WCHAR) );
+        pos += n;
+    }
+    status = alias_result( STATUS_SUCCESS, text, length, out_size );
+    free( text );
+    return status;
+}
