+/* console aliases are kept by conhost, per executable name */
+static BOOL alias_ioctl( DWORD code, const void *in, DWORD in_size, WCHAR *text, DWORD text_chars,
+                         DWORD *length, NTSTATUS *status )
+{
+    struct condrv_alias_result *result;
+    DWORD size = offsetof( struct condrv_alias_result, buffer ) + text_chars * sizeof(WCHAR), got;
+    BOOL ret;
+
+    if (!(result = HeapAlloc( GetProcessHeap(), 0, size )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    ret = console_ioctl( RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle, code,
+                         (void *)in, in_size, result, size, &got );
+    if (ret && got >= offsetof( struct condrv_alias_result, buffer ))
+    {
+        *status = result->status;
+        *length = result->length;
+        if (text) memcpy( text, result->buffer, got - offsetof( struct condrv_alias_result, buffer ));
+    }
+    else if (ret) { SetLastError( ERROR_INVALID_DATA ); ret = FALSE; }
+    HeapFree( GetProcessHeap(), 0, result );
+    return ret;
+}
+
+static WCHAR *alias_strAtoW( const char *str )
+{
+    UINT cp = GetConsoleCP();
+    int len = MultiByteToWideChar( cp, 0, str, -1, NULL, 0 );
+    WCHAR *ret = HeapAlloc( GetProcessHeap(), 0, max( len, 1 ) * sizeof(WCHAR) );
+
+    if (ret && len) MultiByteToWideChar( cp, 0, str, -1, ret, len );
+    return ret;
+}
+
+/* the (possibly absent) target of an alias; remove is set when there is none */
+static BOOL add_console_alias( const WCHAR *source, const WCHAR *target, const WCHAR *exename )
+{
+    struct condrv_alias_params *params;
+    DWORD slen, tlen, elen, size;
+    BOOL ret;
+
+    if (!source || !exename || !source[0] || !exename[0])
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    slen = lstrlenW( source );
+    tlen = target ? lstrlenW( target ) : 0;
+    elen = lstrlenW( exename );
+    size = offsetof( struct condrv_alias_params, buffer ) + (slen + tlen + elen) * sizeof(WCHAR);
+    if (!(params = HeapAlloc( GetProcessHeap(), 0, size )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    params->source_len = slen;
+    params->target_len = tlen;
+    params->exe_len = elen;
+    params->remove = !target || !target[0];
+    memcpy( params->buffer, source, slen * sizeof(WCHAR) );
+    memcpy( params->buffer + slen, target, tlen * sizeof(WCHAR) );
+    memcpy( params->buffer + slen + tlen, exename, elen * sizeof(WCHAR) );
+    ret = console_ioctl( RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle, IOCTL_CONDRV_ADD_ALIAS,
+                         params, size, NULL, 0, NULL );
+    HeapFree( GetProcessHeap(), 0, params );
+    return ret;
+}
+
+/******************************************************************
+ *	AddConsoleAliasW   (kernelbase.@)
+ */
+BOOL WINAPI AddConsoleAliasW( LPWSTR source, LPWSTR target, LPWSTR exename )
+{
+    TRACE( "(%s, %s, %s)\n", debugstr_w(source), debugstr_w(target), debugstr_w(exename) );
+    return add_console_alias( source, target, exename );
+}
