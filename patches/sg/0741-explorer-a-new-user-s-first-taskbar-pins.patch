From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: a new user's first taskbar pins

David wanted SG Store pinned to the taskbar out of the box. The system's
taskbar layout is HKLM\Software\Stained Glass\Taskbar DefaultPins, a
REG_MULTI_SZ of "Name|program" (environment variables expanded; sg-shell
ships File Explorer and SG Store), as Windows' default layout file. When
the taskbar starts for a user who has no PinOrder yet, it pins them in
that order through pins_add, leaving out a program that is not there, and
writes PinOrder even when none was pinned -- so it happens once, and a pin
the user removes stays removed.
---
--- a/programs/explorer/taskpins.c
+++ b/programs/explorer/taskpins.c
@@ -247,6 +247,40 @@
     return ret;
 }
 
+/* a new user's first pins: HKLM\Software\Stained Glass\Taskbar DefaultPins,
+ * a REG_MULTI_SZ of "Name|program" (environment variables expanded) -- the
+ * system's taskbar layout, as Windows' default layout file. Pinned once, while
+ * the user has no PinOrder (any pinning or unpinning writes one, so pins a
+ * user removed stay removed); a program that is not there is left out. */
+void pins_seed_defaults(void)
+{
+    WCHAR *list, *entry, name[MAX_PATH], exe[MAX_PATH], *bar;
+    DWORD size = 0;
+
+    if (!RegGetValueW( HKEY_CURRENT_USER, pins_key, L"PinOrder", RRF_RT_REG_MULTI_SZ, NULL, NULL, &size )) return;
+    size = 0;
+    if (RegGetValueW( HKEY_LOCAL_MACHINE, pins_key, L"DefaultPins", RRF_RT_REG_MULTI_SZ, NULL, NULL, &size ) ||
+        !(list = calloc( 1, size + 2 * sizeof(WCHAR) )))
+        return;
+    if (!RegGetValueW( HKEY_LOCAL_MACHINE, pins_key, L"DefaultPins", RRF_RT_REG_MULTI_SZ, NULL, list, &size ))
+    {
+        for (entry = list; *entry; entry += lstrlenW( entry ) + 1)
+        {
+            if (!(bar = wcschr( entry, '|' )) || bar == entry) continue;
+            lstrcpynW( name, entry, min( bar - entry + 1, MAX_PATH ) );
+            if (!ExpandEnvironmentStringsW( bar + 1, exe, MAX_PATH ) ||
+                GetFileAttributesW( exe ) == INVALID_FILE_ATTRIBUTES) continue;
+            TRACE( "default pin %s: %s\n", debugstr_w(name), debugstr_w(exe) );
+            pins_add( exe, name );
+        }
+    }
+    free( list );
+    /* done, even if none was there: an empty order */
+    size = 0;
+    if (RegGetValueW( HKEY_CURRENT_USER, pins_key, L"PinOrder", RRF_RT_REG_MULTI_SZ, NULL, NULL, &size ))
+        pins_save_order( NULL, 0 );
+}
+
 /* unpin: the shortcut goes, and its place in the order */
 BOOL pins_remove( const WCHAR *lnk )
 {
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -3504,6 +3504,9 @@
         sg_load_settings();
         sg_apply_app_mode();
         sg_watch_windows();
+#ifndef SG_MUTANT_NODEFAULTPINS
+        pins_seed_defaults();
+#endif
         sg_reload_pins();
     }
     if (enable_taskbar) do_show_systray();
--- a/programs/explorer/explorer_private.h
+++ b/programs/explorer/explorer_private.h
@@ -53,6 +53,7 @@
 extern int pins_find( const struct taskbar_pin *pins, int count, const WCHAR *exe );
 extern BOOL pins_add( const WCHAR *exe, const WCHAR *name );
 extern BOOL pins_remove( const WCHAR *lnk );
+extern void pins_seed_defaults(void);
 extern void taskbar_windows_changed(void);
 /* Stained Glass OS: the taskbar's settings, for SHAppBarMessage (appbar.c) */
 extern UINT taskbar_state( RECT *rect, UINT *edge );
