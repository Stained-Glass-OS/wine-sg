From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uiautomationcore: non-client tree known by the providers, no role queries elsewhere

5917 asked IAccessible objects for their role to tell a window object (for
its parts' parent and to skip the client object), on every MSAA tree; the
uiautomation conformance test's mock IAccessibles fail on unexpected
get_accRole calls (3 failures). The non-client provider now knows it holds
the window object, its parts carry that they belong to a non-client tree
and whether their parent is the window object, and roles are asked only
inside a non-client tree when that is not known.
---
diff --git a/dlls/uiautomationcore/uia_provider.c b/dlls/uiautomationcore/uia_provider.c
--- a/dlls/uiautomationcore/uia_provider.c
+++ b/dlls/uiautomationcore/uia_provider.c
@@ -333,7 +333,13 @@ static BOOL msaa_acc_is_window_object(IAccessible *acc)
     return msaa_acc_get_role(acc, cid) == ROLE_SYSTEM_WINDOW;
 }
 
-static BOOL msaa_acc_is_client_child(IAccessible *parent, IAccessible *acc, VARIANT cid)
+/* how the children of an IAccessible are filtered for the client object: not at all (outside a
+ * non-client tree), parent known to be a window object, or parent to be asked for its role */
+#define NC_SKIP_NONE  0
+#define NC_SKIP_KNOWN 1
+#define NC_SKIP_CHECK 2
+
+static BOOL msaa_acc_is_client_child(IAccessible *parent, IAccessible *acc, VARIANT cid, int skip)
 {
     IAccessible *client = NULL;
     HWND hwnd = NULL;
@@ -344,7 +350,9 @@ static BOOL msaa_acc_is_client_child(IAccessible *parent, IAccessible *acc, VARI
 #endif
     /* the client object is a full object of its own (a button's has the push
      * button role), so it is told by identity, not by role */
-    if (V_I4(&cid) != CHILDID_SELF || acc == parent || !msaa_acc_is_window_object(parent))
+    if (skip == NC_SKIP_NONE || V_I4(&cid) != CHILDID_SELF || acc == parent)
+        return FALSE;
+    if (skip == NC_SKIP_CHECK && !msaa_acc_is_window_object(parent))
         return FALSE;
     if (FAILED(WindowFromAccessibleObject(parent, &hwnd)) || !hwnd)
         return FALSE;
@@ -357,8 +365,8 @@ static BOOL msaa_acc_is_client_child(IAccessible *parent, IAccessible *acc, VARI
 
 #define DIR_FORWARD 0
 #define DIR_REVERSE 1
-static HRESULT msaa_acc_get_next_child(IAccessible *acc, LONG start_pos, LONG direction,
-        IAccessible **child, LONG *child_id, LONG *child_pos, BOOL check_visible)
+static HRESULT msaa_acc_get_next_child_nc(IAccessible *acc, LONG start_pos, LONG direction,
+        IAccessible **child, LONG *child_id, LONG *child_pos, BOOL check_visible, int skip)
 {
     LONG child_count, cur_pos;
     IDispatch *disp;
@@ -382,7 +390,7 @@ static HRESULT msaa_acc_get_next_child(IAccessible *acc, LONG start_pos, LONG di
         if (hr == S_FALSE)
         {
             if (!check_visible || (!msaa_check_acc_state(acc, cid, STATE_SYSTEM_INVISIBLE) &&
-                    !msaa_acc_is_client_child(acc, acc, cid)))
+                    !msaa_acc_is_client_child(acc, acc, cid, skip)))
             {
                 *child = acc;
                 *child_id = *child_pos = cur_pos;
@@ -401,7 +409,7 @@ static HRESULT msaa_acc_get_next_child(IAccessible *acc, LONG start_pos, LONG di
 
             variant_init_i4(&cid, CHILDID_SELF);
             if (!check_visible || (!msaa_check_acc_state(acc_child, cid, STATE_SYSTEM_INVISIBLE) &&
-                    !msaa_acc_is_client_child(acc, acc_child, cid)))
+                    !msaa_acc_is_client_child(acc, acc_child, cid, skip)))
             {
                 *child = acc_child;
                 *child_id = CHILDID_SELF;
@@ -424,6 +432,12 @@ static HRESULT msaa_acc_get_next_child(IAccessible *acc, LONG start_pos, LONG di
     return hr;
 }
 
+static HRESULT msaa_acc_get_next_child(IAccessible *acc, LONG start_pos, LONG direction,
+        IAccessible **child, LONG *child_id, LONG *child_pos, BOOL check_visible)
+{
+    return msaa_acc_get_next_child_nc(acc, start_pos, direction, child, child_id, child_pos, check_visible, NC_SKIP_NONE);
+}
+
 static HRESULT msaa_acc_get_child_pos(IAccessible *acc, IAccessible **out_parent,
         LONG *out_child_pos)
 {
@@ -603,6 +617,9 @@ struct msaa_provider {
     BOOL root_acc_check_ran;
     BOOL is_root_acc;
     BOOL nonclient;
+    BOOL window_obj;        /* the window object (OBJID_WINDOW) of a non-client provider */
+    BOOL nc_tree;           /* a part of a non-client provider's tree */
+    BOOL parent_is_window;  /* its parent (msaa_prov->parent) is that window object */
     int identity; /* 0: not probed, 1: IAccIdentity supported, 2: not supported */
 
     IAccessible *parent;
@@ -774,7 +791,7 @@ HRESULT WINAPI msaa_provider_GetPropertyValue(IRawElementProviderSimple *iface,
     case UIA_ControlTypePropertyId:
         /* the window object behind a window's non-client provider: the window's
          * control type (window or pane, by its style) is the HWND provider's */
-        if (msaa_prov->nonclient && V_I4(&msaa_prov->cid) == CHILDID_SELF && msaa_acc_is_window_object(msaa_prov->acc)
+        if (msaa_prov->window_obj
 #ifdef SG_MUTANT_NC_CONTROL_TYPE
                 && 0
 #endif
@@ -1090,6 +1107,7 @@ static HRESULT WINAPI msaa_fragment_Navigate(IRawElementProviderFragment *iface,
     struct msaa_provider *msaa_prov = impl_from_msaa_fragment(iface);
     LONG child_count, child_id, child_pos;
     IRawElementProviderSimple *elprov;
+    int skip;
     IAccessible *acc;
     HRESULT hr;
 
@@ -1112,8 +1130,9 @@ static HRESULT WINAPI msaa_fragment_Navigate(IRawElementProviderFragment *iface,
             acc = msaa_prov->acc;
 
         /* a window object's part: its parent is the window's non-client provider, whose
-         * node links the parts up with the window's other children */
-        if (msaa_acc_is_window_object(acc)
+         * node links the parts up with the window's other children (only asked inside a
+         * non-client tree) */
+        if (msaa_prov->nc_tree && (msaa_prov->parent_is_window || msaa_acc_is_window_object(acc))
 #ifdef SG_MUTANT_NC_PARENT_LINK
                 && 0
 #endif
@@ -1137,6 +1156,7 @@ static HRESULT WINAPI msaa_fragment_Navigate(IRawElementProviderFragment *iface,
         {
             struct msaa_provider *prov = impl_from_msaa_provider(elprov);
             *ret_val = &prov->IRawElementProviderFragment_iface;
+            prov->nc_tree = msaa_prov->nc_tree;
         }
 
         if (acc != msaa_prov->acc)
@@ -1153,12 +1173,13 @@ static HRESULT WINAPI msaa_fragment_Navigate(IRawElementProviderFragment *iface,
         if (FAILED(hr) || !child_count)
             break;
 
+        skip = msaa_prov->window_obj ? NC_SKIP_KNOWN : (msaa_prov->nc_tree ? NC_SKIP_CHECK : NC_SKIP_NONE);
         if (direction == NavigateDirection_FirstChild)
-            hr = msaa_acc_get_next_child(msaa_prov->acc, 1, DIR_FORWARD, &acc, &child_id,
-                    &child_pos, TRUE);
+            hr = msaa_acc_get_next_child_nc(msaa_prov->acc, 1, DIR_FORWARD, &acc, &child_id,
+                    &child_pos, TRUE, skip);
         else
-            hr = msaa_acc_get_next_child(msaa_prov->acc, child_count, DIR_REVERSE, &acc, &child_id,
-                    &child_pos, TRUE);
+            hr = msaa_acc_get_next_child_nc(msaa_prov->acc, child_count, DIR_REVERSE, &acc, &child_id,
+                    &child_pos, TRUE, skip);
 
         if (FAILED(hr) || !acc)
             break;
@@ -1170,6 +1191,8 @@ static HRESULT WINAPI msaa_fragment_Navigate(IRawElementProviderFragment *iface,
 
             *ret_val = &prov->IRawElementProviderFragment_iface;
             prov->parent = msaa_prov->acc;
+            prov->nc_tree = msaa_prov->nc_tree;
+            prov->parent_is_window = msaa_prov->window_obj;
             IAccessible_AddRef(msaa_prov->acc);
             if (acc != msaa_prov->acc)
                 prov->child_pos = child_pos;
@@ -1203,12 +1226,13 @@ static HRESULT WINAPI msaa_fragment_Navigate(IRawElementProviderFragment *iface,
             }
         }
 
+        skip = msaa_prov->parent_is_window ? NC_SKIP_KNOWN : (msaa_prov->nc_tree ? NC_SKIP_CHECK : NC_SKIP_NONE);
         if (direction == NavigateDirection_NextSibling)
-            hr = msaa_acc_get_next_child(msaa_prov->parent, msaa_prov->child_pos + 1, DIR_FORWARD,
-                    &acc, &child_id, &child_pos, TRUE);
+            hr = msaa_acc_get_next_child_nc(msaa_prov->parent, msaa_prov->child_pos + 1, DIR_FORWARD,
+                    &acc, &child_id, &child_pos, TRUE, skip);
         else
-            hr = msaa_acc_get_next_child(msaa_prov->parent, msaa_prov->child_pos - 1, DIR_REVERSE,
-                    &acc, &child_id, &child_pos, TRUE);
+            hr = msaa_acc_get_next_child_nc(msaa_prov->parent, msaa_prov->child_pos - 1, DIR_REVERSE,
+                    &acc, &child_id, &child_pos, TRUE, skip);
 
         if (FAILED(hr) || !acc)
             break;
@@ -1220,6 +1244,8 @@ static HRESULT WINAPI msaa_fragment_Navigate(IRawElementProviderFragment *iface,
 
             *ret_val = &prov->IRawElementProviderFragment_iface;
             prov->parent = msaa_prov->parent;
+            prov->nc_tree = msaa_prov->nc_tree;
+            prov->parent_is_window = msaa_prov->parent_is_window;
             IAccessible_AddRef(msaa_prov->parent);
             if (acc != msaa_prov->acc)
                 prov->child_pos = child_pos;
@@ -2055,6 +2081,8 @@ HRESULT WINAPI UiaProviderForNonClient(HWND hwnd, LONG obj_id, LONG child_id, IR
     {
         msaa_prov = impl_from_msaa_provider(*elprov);
         msaa_prov->nonclient = TRUE;
+        msaa_prov->nc_tree = TRUE;
+        msaa_prov->window_obj = obj_id == OBJID_WINDOW && child_id == CHILDID_SELF;
     }
     return hr;
 }
