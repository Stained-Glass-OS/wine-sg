From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a request about a window gone does not end the shell

The shell (explorer) on David's ThinkPad X1 ended and was restarted
(2026-10-03): "X Error of failed request: BadWindow, X_ChangeProperty". The
thread hearing Linux programs' requests to the window manager (0764's full
screen and maximize, 0803's move and size) asked the X server about the
window on its own connection with no error expected -- a window already
gone (a program closing a popup as it asks) made an X error, which went on
to Xlib's own handler, and that exits the process: the shell.

Each request is now handled with errors expected (X11DRV_expect_error,
synced and checked), so one about a window gone does nothing.

Test: test/linuxembed-gate.sh 10 (a full-screen request for a window that
is not there: the shell stays -- wine-sg 148 ends; mutant
SG_MUTANT_EMBED_UNGUARDED).
---
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -286,6 +286,9 @@
  * its own, this thread hears those about framed windows and says so with
  * _SG_EMBED_FULLSCREEN on the window, which the frame's thread watches
  * (sg_embed_event), and in _NET_WM_STATE, which the program waits for. */
+static void handle_wm_request( Display *d, Window root, XEvent *evp, Atom net_moveresize, Atom ours_moveresize,
+                               Atom wm_state, Atom fs, Atom max_v, Atom max_h, Atom ours_fs, Atom ours_max );
+
 static void *state_thread( void *arg )
 {
     Display *d = arg;
@@ -301,29 +304,52 @@
     XSelectInput( d, root, SubstructureNotifyMask );
     for (;;)
     {
-        Window r, parent, *children = NULL;
-        unsigned int n;
-        Atom a1, a2, ours;
-        long on, now;
-
         XNextEvent( d, &ev );
+        if (ev.type != ClientMessage || ev.xclient.format != 32 ||
+            (ev.xclient.message_type != net_moveresize && ev.xclient.message_type != wm_state)) continue;
+        /* Stained Glass OS: the window may be gone already (a program closing
+         * a popup as it asks): every request about it is let fail -- an X error
+         * here went to Xlib's own handler, which ended explorer, the shell
+         * (David's X1, 2026-10-03: BadWindow on X_ChangeProperty) */
+#ifndef SG_MUTANT_EMBED_UNGUARDED
+        X11DRV_expect_error( d, ignore_error, NULL );
+#endif
+        handle_wm_request( d, root, &ev, net_moveresize, ours_moveresize, wm_state, fs, max_v, max_h, ours_fs, ours_max );
+#ifndef SG_MUTANT_EMBED_UNGUARDED
+        XSync( d, False );
+        X11DRV_check_error();
+#else
+        XFlush( d );
+#endif
+    }
+    return NULL;
+}
+
+static void handle_wm_request( Display *d, Window root, XEvent *evp, Atom net_moveresize, Atom ours_moveresize,
+                               Atom wm_state, Atom fs, Atom max_v, Atom max_h, Atom ours_fs, Atom ours_max )
+{
+    XEvent ev = *evp;
+    Window r, parent, *children = NULL;
+    unsigned int n;
+    Atom a1, a2, ours;
+    long on, now;
+    {
 #ifndef SG_MUTANT_EMBED_NO_MOVERESIZE
         if (ev.type == ClientMessage && ev.xclient.message_type == net_moveresize && ev.xclient.format == 32 &&
             ev.xclient.data.l[2] >= 0 && ev.xclient.data.l[2] <= 8)
         {
             /* the program's own title bar or edge dragged (its frame has
              * none): the frame moves or sizes, as Wine's own drag does */
-            if (!XQueryTree( d, ev.xclient.window, &r, &parent, &children, &n )) continue;
+            if (!XQueryTree( d, ev.xclient.window, &r, &parent, &children, &n )) return;
             if (children) XFree( children );
-            if (parent == root) continue;
+            if (parent == root) return;
             on = ev.xclient.data.l[2] + 1;
             XChangeProperty( d, ev.xclient.window, ours_moveresize, XA_CARDINAL, 32, PropModeReplace,
                              (unsigned char *)&on, 1 );
-            XFlush( d );
-            continue;
+            return;
         }
 #endif
-        if (ev.type != ClientMessage || ev.xclient.message_type != wm_state || ev.xclient.format != 32) continue;
+        if (ev.type != ClientMessage || ev.xclient.message_type != wm_state || ev.xclient.format != 32) return;
         a1 = ev.xclient.data.l[1];
         a2 = ev.xclient.data.l[2];
         if (a1 == fs || a2 == fs) ours = ours_fs;
@@ -331,19 +357,17 @@
         /* maximized: Firefox restores itself so, asking at once */
         else if (a1 == max_v || a1 == max_h || a2 == max_v || a2 == max_h) ours = ours_max;
 #endif
-        else continue;
+        else return;
         /* only a window we framed: its parent is not the root */
-        if (!XQueryTree( d, ev.xclient.window, &r, &parent, &children, &n )) continue;
+        if (!XQueryTree( d, ev.xclient.window, &r, &parent, &children, &n )) return;
         if (children) XFree( children );
-        if (parent == root) continue;
+        if (parent == root) return;
         now = get_cardinal( d, ev.xclient.window, ours );
         on = ev.xclient.data.l[0] == 2 ? !now : ev.xclient.data.l[0] == 1;   /* toggle, add, remove */
         XChangeProperty( d, ev.xclient.window, ours, XA_CARDINAL, 32, PropModeReplace, (unsigned char *)&on, 1 );
         set_net_state( d, ev.xclient.window, get_cardinal( d, ev.xclient.window, ours_fs ),
                        get_cardinal( d, ev.xclient.window, ours_max ) );
-        XFlush( d );
     }
-    return NULL;
 }
 
 static Display *state_owner;   /* the frame's display, whose server the thread joins */
