+/*************************************************************************
+ * D3DXComputeTangentFrame    (D3DX9_36.@)
+ */
+HRESULT WINAPI D3DXComputeTangentFrame(ID3DXMesh *mesh, DWORD options)
+{
+    TRACE("mesh %p, options %#lx.\n", mesh, options);
+
+    /* texture coordinates 0 in, tangent, binormal and normal out, all in place */
+    return D3DXComputeTangentFrameEx(mesh, D3DDECLUSAGE_TEXCOORD, 0, D3DDECLUSAGE_TANGENT, 0,
+            D3DDECLUSAGE_BINORMAL, 0, D3DDECLUSAGE_NORMAL, 0, options | D3DXTANGENT_GENERATE_IN_PLACE, NULL,
+            -1.01f, -0.01f, -1.01f, NULL, NULL);
+}
+
+/*************************************************************************
+ * D3DXComputeTangent    (D3DX9_36.@)
+ */
+HRESULT WINAPI D3DXComputeTangent(ID3DXMesh *mesh, DWORD stage, DWORD tangent_index, DWORD binormal_index,
+        DWORD wrap, const DWORD *adjacency)
+{
+    TRACE("mesh %p, stage %lu, tangent_index %lu, binormal_index %lu, wrap %lu, adjacency %p.\n",
+            mesh, stage, tangent_index, binormal_index, wrap, adjacency);
+
+    return D3DXComputeTangentFrameEx(mesh, D3DDECLUSAGE_TEXCOORD, stage,
+            tangent_index == D3DX_DEFAULT ? D3DX_DEFAULT : D3DDECLUSAGE_TANGENT, tangent_index == D3DX_DEFAULT ? 0 : tangent_index,
+            binormal_index == D3DX_DEFAULT ? D3DX_DEFAULT : D3DDECLUSAGE_BINORMAL, binormal_index == D3DX_DEFAULT ? 0 : binormal_index,
+            D3DX_DEFAULT, 0, D3DXTANGENT_GENERATE_IN_PLACE | (wrap ? D3DXTANGENT_WRAP_UV : 0), adjacency,
+            -1.01f, -0.01f, -1.01f, NULL, NULL);
+}
+
+/*************************************************************************
+ * D3DXLoadMeshFromXof    (D3DX9_36.@)
+ */
+HRESULT WINAPI D3DXLoadMeshFromXof(struct ID3DXFileData *filedata, DWORD options, struct IDirect3DDevice9 *device,
+        struct ID3DXBuffer **adjacency_out, struct ID3DXBuffer **materials_out, struct ID3DXBuffer **effects_out,
+        DWORD *num_materials_out, struct ID3DXMesh **mesh_out)
+{
+    TRACE("filedata %p, options %#lx, device %p, adjacency_out %p, materials_out %p, effects_out %p, "
+            "num_materials_out %p, mesh_out %p.\n", filedata, options, device, adjacency_out, materials_out,
+            effects_out, num_materials_out, mesh_out);
 
+    return D3DXLoadSkinMeshFromXof(filedata, options, device, adjacency_out, materials_out, effects_out,
+            num_materials_out, NULL, mesh_out);
+}
+
+/* The vertex of a mesh converted to the declaration of the concatenated mesh, transformed. */
+static HRESULT concat_mesh_vertices(ID3DXMesh *src, const D3DVERTEXELEMENT9 *decl, IDirect3DDevice9 *device,
+        const D3DXMATRIX *geom, const D3DXMATRIX *tex, void *dst_vertices, DWORD vertex_stride)
+{
+    D3DVERTEXELEMENT9 elements[MAX_FVF_DECL_SIZE];
+    D3DXMATRIX normal_matrix;
+    ID3DXMesh *converted;
+    BYTE *vertices;
+    DWORD count, i, e;
+    HRESULT hr;
+
+    if (FAILED(hr = src->lpVtbl->CloneMesh(src, D3DXMESH_SYSTEMMEM, decl, device, &converted)))
+        return hr;
+    if (FAILED(hr = converted->lpVtbl->GetDeclaration(converted, elements)))
+        goto done;
+    if (FAILED(hr = converted->lpVtbl->LockVertexBuffer(converted, D3DLOCK_READONLY, (void **)&vertices)))
+        goto done;
+
+    count = converted->lpVtbl->GetNumVertices(converted);
+    memcpy(dst_vertices, vertices, (SIZE_T)count * vertex_stride);
+
+    if (geom)
+    {
+        D3DXMatrixInverse(&normal_matrix, NULL, geom);
+        D3DXMatrixTranspose(&normal_matrix, &normal_matrix);
+    }
+    for (e = 0; elements[e].Stream != 0xff; ++e)
+    {
+        const D3DVERTEXELEMENT9 *el = &elements[e];
+
+        for (i = 0; i < count; ++i)
+        {
+            BYTE *base = (BYTE *)dst_vertices + (SIZE_T)i * vertex_stride + el->Offset;
+            D3DXVECTOR3 *v3 = (D3DXVECTOR3 *)base;
+            float *f = (float *)base;
+
+            if (geom && el->Usage == D3DDECLUSAGE_POSITION && !el->UsageIndex
+                    && (el->Type == D3DDECLTYPE_FLOAT3 || el->Type == D3DDECLTYPE_FLOAT4))
+            {
+                D3DXVec3TransformCoord(v3, v3, geom);
+            }
+            else if (geom && (el->Usage == D3DDECLUSAGE_NORMAL || el->Usage == D3DDECLUSAGE_TANGENT
+                    || el->Usage == D3DDECLUSAGE_BINORMAL)
+                    && (el->Type == D3DDECLTYPE_FLOAT3 || el->Type == D3DDECLTYPE_FLOAT4))
+            {
+                D3DXVec3TransformNormal(v3, v3, &normal_matrix);
+                D3DXVec3Normalize(v3, v3);
+            }
+            else if (tex && el->Usage == D3DDECLUSAGE_TEXCOORD
+                    && (el->Type == D3DDECLTYPE_FLOAT2 || el->Type == D3DDECLTYPE_FLOAT3))
+            {
+                D3DXVECTOR4 out, in = {f[0], f[1], 0.0f, 1.0f};
+
+                D3DXVec4Transform(&out, &in, tex);
+                f[0] = out.x;
+                f[1] = out.y;
+            }
+        }
+    }
+    converted->lpVtbl->UnlockVertexBuffer(converted);
+    hr = D3D_OK;
+
+done:
+    converted->lpVtbl->Release(converted);
+    return hr;
+}
