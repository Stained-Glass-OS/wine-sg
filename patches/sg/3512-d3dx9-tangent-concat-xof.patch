+/*************************************************************************
+ * D3DXConcatenateMeshes    (D3DX9_36.@)
+ */
+HRESULT WINAPI D3DXConcatenateMeshes(ID3DXMesh **meshes, UINT mesh_count, DWORD options,
+        const D3DXMATRIX *geometry_matrices, const D3DXMATRIX *texture_matrices,
+        const D3DVERTEXELEMENT9 *declaration, IDirect3DDevice9 *device, ID3DXMesh **mesh_out)
+{
+    D3DVERTEXELEMENT9 first_declaration[MAX_FVF_DECL_SIZE];
+    D3DVERTEXELEMENT9 out_declaration[MAX_FVF_DECL_SIZE];
+    DWORD total_vertices = 0, total_faces = 0, first_vertex = 0, first_face = 0;
+    IDirect3DDevice9 *own_device = NULL;
+    ID3DXMesh *result = NULL;
+    BYTE *vertices = NULL;
+    void *indices = NULL;
+    DWORD *attributes = NULL;
+    DWORD stride, i, j;
+    HRESULT hr;
+
+    TRACE("meshes %p, mesh_count %u, options %#lx, geometry_matrices %p, texture_matrices %p, declaration %p, "
+            "device %p, mesh_out %p.\n", meshes, mesh_count, options, geometry_matrices, texture_matrices,
+            declaration, device, mesh_out);
+
+    if (!meshes || !mesh_count || !mesh_out)
+        return D3DERR_INVALIDCALL;
+    for (i = 0; i < mesh_count; ++i)
+        if (!meshes[i]) return D3DERR_INVALIDCALL;
+
+    if (!declaration)
+    {
+        if (FAILED(hr = meshes[0]->lpVtbl->GetDeclaration(meshes[0], first_declaration))) return hr;
+        declaration = first_declaration;
+    }
+    if (!D3DXGetDeclLength(declaration))
+        return D3DERR_INVALIDCALL;
+    memcpy(out_declaration, declaration, (D3DXGetDeclLength(declaration) + 1) * sizeof(*declaration));
+    stride = D3DXGetDeclVertexSize(declaration, 0);
+
+    if (!device)
+    {
+        if (FAILED(hr = meshes[0]->lpVtbl->GetDevice(meshes[0], &own_device))) return hr;
+        device = own_device;
+    }
+
+    for (i = 0; i < mesh_count; ++i)
+    {
+        total_vertices += meshes[i]->lpVtbl->GetNumVertices(meshes[i]);
+        total_faces += meshes[i]->lpVtbl->GetNumFaces(meshes[i]);
+    }
+    if (!(options & D3DXMESH_32BIT) && total_vertices > 0xffff)
+    {
+        hr = D3DERR_INVALIDCALL;
+        goto done;
+    }
+
+    if (FAILED(hr = D3DXCreateMesh(total_faces, total_vertices, options, out_declaration, device, &result)))
+        goto done;
+    if (FAILED(hr = result->lpVtbl->LockVertexBuffer(result, 0, (void **)&vertices))) goto done;
+    if (FAILED(hr = result->lpVtbl->LockIndexBuffer(result, 0, &indices)))
+    {
+        indices = NULL;
+        goto done;
+    }
+    if (FAILED(hr = result->lpVtbl->LockAttributeBuffer(result, 0, &attributes)))
+    {
+        attributes = NULL;
+        goto done;
+    }
+
+    for (i = 0; i < mesh_count; ++i)
+    {
+        ID3DXMesh *src = meshes[i];
+        DWORD nv = src->lpVtbl->GetNumVertices(src), nf = src->lpVtbl->GetNumFaces(src);
+        BOOL src_wide = src->lpVtbl->GetOptions(src) & D3DXMESH_32BIT;
+        void *src_indices;
+        DWORD *src_attributes;
+
+        if (FAILED(hr = concat_mesh_vertices(src, out_declaration, device,
+                geometry_matrices ? &geometry_matrices[i] : NULL, texture_matrices ? &texture_matrices[i] : NULL,
+                vertices + (SIZE_T)first_vertex * stride, stride)))
+            goto done;
+
+        if (FAILED(hr = src->lpVtbl->LockIndexBuffer(src, D3DLOCK_READONLY, &src_indices))) goto done;
+        for (j = 0; j < nf * 3; ++j)
+        {
+            DWORD index = read_ib(src_indices, src_wide, j) + first_vertex;
+
+            if (options & D3DXMESH_32BIT)
+                ((DWORD *)indices)[first_face * 3 + j] = index;
+            else
+                ((WORD *)indices)[first_face * 3 + j] = index;
+        }
+        src->lpVtbl->UnlockIndexBuffer(src);
+
+        if (SUCCEEDED(src->lpVtbl->LockAttributeBuffer(src, D3DLOCK_READONLY, &src_attributes)))
+        {
+            memcpy(attributes + first_face, src_attributes, nf * sizeof(*attributes));
+            src->lpVtbl->UnlockAttributeBuffer(src);
+        }
+        else
+            memset(attributes + first_face, 0, nf * sizeof(*attributes));
+
+        first_vertex += nv;
+        first_face += nf;
+    }
+    hr = D3D_OK;
+
+done:
+    if (attributes) result->lpVtbl->UnlockAttributeBuffer(result);
+    if (indices) result->lpVtbl->UnlockIndexBuffer(result);
+    if (vertices) result->lpVtbl->UnlockVertexBuffer(result);
+    if (own_device) IDirect3DDevice9_Release(own_device);
+    if (SUCCEEDED(hr))
+        *mesh_out = result;
+    else if (result)
+        result->lpVtbl->Release(result);
     return hr;
 }
 
