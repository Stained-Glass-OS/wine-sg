+    swprintf( path, ARRAY_SIZE(path), L"%s%s", SG_FW_POLICY_KEY, names[0] );
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_QUERY_VALUE, &key ))
+    {
+        if (!RegQueryValueExW( key, L"DisabledInterfaces", NULL, &type, NULL, &size ) && type == REG_MULTI_SZ &&
+            (data = malloc( size + 2 * sizeof(WCHAR) )))
+        {
+            if (RegQueryValueExW( key, L"DisabledInterfaces", NULL, &type, (BYTE *)data, &size ))
+                size = 0;
+            data[size / sizeof(WCHAR)] = data[size / sizeof(WCHAR) + 1] = 0;
+        }
+        RegCloseKey( key );
+    }
+    if (data)
+        for (p = data; *p; p += wcslen( p ) + 1) count++;
+    if (!count) { free( data ); return S_OK; }              /* none: empty */
+
+    if (!(sa = SafeArrayCreateVector( VT_VARIANT, 0, count ))) { free( data ); return E_OUTOFMEMORY; }
+    SafeArrayAccessData( sa, (void **)&var );
+    for (p = data; *p; p += wcslen( p ) + 1, i++)
+    {
+        V_VT(&var[i]) = VT_BSTR;
+        V_BSTR(&var[i]) = SysAllocString( p );
+    }
+    SafeArrayUnaccessData( sa );
+    free( data );
+    V_VT(interfaces) = VT_ARRAY | VT_VARIANT;
+    V_ARRAY(interfaces) = sa;
+    return S_OK;
 }
 
 static HRESULT WINAPI fwpolicy2_put_ExcludedInterfaces(INetFwPolicy2 *iface, NET_FW_PROFILE_TYPE2 profileType, VARIANT interfaces)
 {
-    fw_policy2 *This = impl_from_INetFwPolicy2( iface );
-    FIXME("%p %d\n", This, profileType);
-    return E_NOTIMPL;
+    const WCHAR *names[3];
+    WCHAR *multi = NULL, *w;
+    SAFEARRAY *sa = NULL;
+    VARTYPE vt = V_VT(&interfaces);
+    LONG lo = 0, hi = -1, i;
+    size_t len = 1;
+    HRESULT hr;
+    int k;
+
+    TRACE("%p, %d, %s\n", iface, profileType, debugstr_variant(&interfaces));
+
+    if (FAILED(hr = policy2_profiles( profileType, TRUE, names ))) return hr;
+    if (vt == (VT_ARRAY | VT_VARIANT) || vt == (VT_ARRAY | VT_BSTR)) sa = V_ARRAY(&interfaces);
+    else if (vt != VT_EMPTY && vt != VT_NULL) return E_INVALIDARG;
+
+    if (sa)
+    {
+        if (SafeArrayGetDim( sa ) != 1) return E_INVALIDARG;
+        SafeArrayGetLBound( sa, 1, &lo );
+        SafeArrayGetUBound( sa, 1, &hi );
+    }
+    for (i = lo; i <= hi; i++)
+    {
+        VARIANT item;
+        VariantInit( &item );
+        if (vt == (VT_ARRAY | VT_BSTR)) { BSTR b; SafeArrayGetElement( sa, &i, &b ); V_VT(&item) = VT_BSTR; V_BSTR(&item) = b; }
+        else SafeArrayGetElement( sa, &i, &item );
+        if (V_VT(&item) != VT_BSTR) { VariantClear( &item ); return E_INVALIDARG; }
+        len += SysStringLen( V_BSTR(&item) ) + 1;
+        VariantClear( &item );
+    }
+    if (!(multi = malloc( (len + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    w = multi;
+    for (i = lo; i <= hi; i++)
+    {
+        VARIANT item;
+        VariantInit( &item );
+        if (vt == (VT_ARRAY | VT_BSTR)) { BSTR b; SafeArrayGetElement( sa, &i, &b ); V_VT(&item) = VT_BSTR; V_BSTR(&item) = b; }
+        else SafeArrayGetElement( sa, &i, &item );
+        wcscpy( w, V_BSTR(&item) );
+        w += wcslen( w ) + 1;
+        VariantClear( &item );
+    }
+    *w++ = 0;
+    if (w == multi + 1) *w++ = 0;               /* an empty list is two terminators */
+
+    for (k = 0; k < 3 && names[k]; k++)
+    {
