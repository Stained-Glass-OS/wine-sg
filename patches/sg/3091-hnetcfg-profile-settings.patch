diff --git a/dlls/hnetcfg/policy.c b/dlls/hnetcfg/policy.c
index 68fe44f..e28a03c 100644
--- a/dlls/hnetcfg/policy.c
+++ b/dlls/hnetcfg/policy.c
@@ -1456,6 +1456,162 @@ static HRESULT WINAPI fw_policy_Invoke(
     return hr;
 }
 
+
+/* ---- the profiles' settings, where Windows keeps them ----
+ *
+ * HKLM\...\SharedAccess\Parameters\FirewallPolicy\{DomainProfile,StandardProfile,PublicProfile}
+ * (Standard is the Private profile). Stained Glass Firewall does not enforce
+ * these -- it blocks what others start to this PC and allows what this PC
+ * starts -- so they are the settings a program set and reads back. Writing
+ * them needs an administrator: the registry refuses anyone else, as on
+ * Windows (E_ACCESSDENIED). */
+#define SG_FW_POLICY_KEY L"System\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy\\"
+
+HRESULT fw_profile_value_get( const WCHAR *profile, const WCHAR *value, DWORD def, DWORD *out )
+{
+    WCHAR path[MAX_PATH];
+    DWORD size = sizeof(*out), type;
+    HKEY key;
+    LSTATUS err;
+
+    *out = def;
+    swprintf( path, ARRAY_SIZE(path), L"%s%s", SG_FW_POLICY_KEY, profile );
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_QUERY_VALUE, &key )) return S_OK;
+    err = RegQueryValueExW( key, value, NULL, &type, (BYTE *)out, &size );
+    RegCloseKey( key );
+    if (err || type != REG_DWORD) *out = def;
+    return S_OK;
+}
+
+HRESULT fw_profile_value_set( const WCHAR *profile, const WCHAR *value, DWORD data )
+{
+    WCHAR path[MAX_PATH];
+    HKEY key;
+    LSTATUS err;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s%s", SG_FW_POLICY_KEY, profile );
+    if ((err = RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )))
+        return HRESULT_FROM_WIN32( err );
+    err = RegSetValueExW( key, value, 0, REG_DWORD, (BYTE *)&data, sizeof(data) );
+    RegCloseKey( key );
+    return err ? HRESULT_FROM_WIN32( err ) : S_OK;
+}
+
+/* the profiles a call names: one of them, or (for a change) several */
+static HRESULT policy2_profiles( LONG type, BOOL change, const WCHAR **names )
+{
+    LONG bits = type == NET_FW_PROFILE2_ALL ? 7 : type;
+    int n = 0;
+
+    names[0] = names[1] = names[2] = NULL;
+    if (bits <= 0 || (bits & ~7)) return E_INVALIDARG;
+    if (!change && (bits & (bits - 1))) return E_INVALIDARG;     /* a read names one */
+    if (bits & NET_FW_PROFILE2_DOMAIN) names[n++] = L"DomainProfile";
+    if (bits & NET_FW_PROFILE2_PRIVATE) names[n++] = L"StandardProfile";
+    if (bits & NET_FW_PROFILE2_PUBLIC) names[n++] = L"PublicProfile";
+    return S_OK;
+}
+
+static HRESULT policy2_get_dword( LONG type, const WCHAR *value, DWORD def, DWORD *out )
+{
+    const WCHAR *names[3];
+    HRESULT hr;
+
+    if (FAILED(hr = policy2_profiles( type, FALSE, names ))) return hr;
+    return fw_profile_value_get( names[0], value, def, out );
+}
+
+static HRESULT policy2_set_dword( LONG type, const WCHAR *value, DWORD data )
+{
+    const WCHAR *names[3];
+    HRESULT hr;
+    int i;
+
+    if (FAILED(hr = policy2_profiles( type, TRUE, names ))) return hr;
+    for (i = 0; i < 3 && names[i]; i++)
+        if (FAILED(hr = fw_profile_value_set( names[i], value, data ))) return hr;
+    return S_OK;
+}
+
+/* the kind of network in use, as the older interfaces have it: Domain (0)
+ * or Standard (1) */
+LONG fw_current_legacy_type(void)
+{
+    char *status = sgfw_status(), current[64];
+    LONG bits = 0, type = NET_FW_PROFILE_STANDARD;
+
+    if (status && sgfw_status_line( status, "current", current, sizeof(current) )) bits = sgfw_profile_bits( current );
+    if (bits & NET_FW_PROFILE2_DOMAIN) type = NET_FW_PROFILE_DOMAIN;
+    free( status );
+    return type;
+}
+
+/* a list of ports ("80,443,1000-2000" or "*") holds a port */
+static BOOL port_in_list( const WCHAR *list, LONG port )
+{
+    WCHAR *copy, *item, *ctx;
+    BOOL found = FALSE;
+
+    if (!list || !*list || !wcscmp( list, L"*" )) return TRUE;
+    if (!(copy = str_dup( list ))) return FALSE;
+    for (item = wcstok_s( copy, L",", &ctx ); item && !found; item = wcstok_s( NULL, L",", &ctx ))
+    {
+        WCHAR *end;
+        LONG lo = wcstol( item, &end, 10 ), hi = lo;
+        if (*end == '-') hi = wcstol( end + 1, NULL, 10 );
+        found = port >= lo && port <= hi;
+    }
+    free( copy );
+    return found;
+}
+
+/* whether the firewall lets a program take connections to a port, in the
+ * profiles in use: what the older INetFwMgr::IsPortAllowed answers */
+HRESULT fw_port_allowed( const WCHAR *image, LONG protocol, LONG port, BOOL *allowed, BOOL *restricted )
+{
+    struct stored_rule *list;
+    char *status = sgfw_status(), current[64];
+    LONG bits = NET_FW_PROFILE2_PRIVATE;
+    DWORD n, i, block_all = 0;
+    const WCHAR *names[3];
+    BOOL on = TRUE;
+    HRESULT hr;
+
+    *allowed = *restricted = FALSE;
+    if (status && sgfw_status_line( status, "current", current, sizeof(current) ) && sgfw_profile_bits( current ))
+        bits = sgfw_profile_bits( current );
+    if (sgfw_profile_on( status, bits & NET_FW_PROFILE2_DOMAIN ? "domain" :
+                         bits & NET_FW_PROFILE2_PUBLIC ? "public" : "private" ) == 0) on = FALSE;
+    free( status );
+    if (!on) { *allowed = TRUE; return S_OK; }
+
+    if (SUCCEEDED(policy2_profiles( bits & NET_FW_PROFILE2_DOMAIN ? NET_FW_PROFILE2_DOMAIN :
+                                    bits & NET_FW_PROFILE2_PUBLIC ? NET_FW_PROFILE2_PUBLIC :
+                                    NET_FW_PROFILE2_PRIVATE, FALSE, names )))
+        fw_profile_value_get( names[0], L"DoNotAllowExceptions", 0, &block_all );
+    if (block_all) return S_OK;
+
+    if (FAILED(hr = load_rules( &list, &n ))) return hr;
+    for (i = 0; i < n; i++)
+    {
+        fw_rule *r = list[i].rule;
+        if (!r->enabled || r->action != NET_FW_ACTION_ALLOW || r->direction != NET_FW_RULE_DIR_IN) continue;
+        if (!(r->profiles & bits)) continue;
+        if (r->protocol != SG_FW_PROTOCOL_ANY && r->protocol != protocol) continue;
+        if (!port_in_list( r->lports, port )) continue;
+        if (r->app && (!image || wcsicmp( r->app, image ))) continue;
+        *allowed = TRUE;
+#ifndef SG_MUTANT_HN_NO_SCOPE
+        if (r->raddrs && wcscmp( r->raddrs, L"*" )) *restricted = TRUE;    /* a scope */
+#else
+        if (0) ;
+#endif
+        else { *restricted = FALSE; break; }
+    }
+    free_stored( list, n );
+    return S_OK;
+}
+
 static HRESULT WINAPI fw_policy_get_CurrentProfile(
     INetFwPolicy *iface,
     INetFwProfile **profile )
@@ -1473,8 +1629,12 @@ static HRESULT WINAPI fw_policy_GetProfileByType(
 {
     fw_policy *This = impl_from_INetFwPolicy( iface );
 
-    FIXME("%p, %u, %p\n", This, profileType, profile);
-    return E_NOTIMPL;
+    TRACE("%p, %u, %p\n", This, profileType, profile);
+
+    if (!profile) return E_POINTER;
+    if (profileType == NET_FW_PROFILE_CURRENT) return NetFwProfile_create( NULL, (void **)profile );
+    if (profileType != NET_FW_PROFILE_DOMAIN && profileType != NET_FW_PROFILE_STANDARD) return E_INVALIDARG;
+    return NetFwProfile_create_type( profileType, (void **)profile );
 }
 
