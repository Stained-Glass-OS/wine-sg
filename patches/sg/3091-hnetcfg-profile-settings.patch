+
+/* The settings of a profile are where Windows keeps them (see policy.c): the
+ * Domain profile's, or the Standard profile's (a network that is not a
+ * domain's: Private and Public). */
+static const WCHAR *profile_key( const fw_profile *p )
+{
+    return p->type == NET_FW_PROFILE_DOMAIN ? L"DomainProfile" : L"StandardProfile";
+}
+
+static HRESULT get_flag( fw_profile *p, const WCHAR *value, VARIANT_BOOL *out )
+{
+    DWORD data;
+
+    if (!out) return E_POINTER;
+    fw_profile_value_get( profile_key( p ), value, 0, &data );
+    *out = data ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT put_flag( fw_profile *p, const WCHAR *value, VARIANT_BOOL data )
+{
+    HRESULT hr = fw_profile_value_set( profile_key( p ), value, data ? 1 : 0 );
+
+    /* the Standard profile is the Private and the Public one's */
+    if (SUCCEEDED(hr) && p->type == NET_FW_PROFILE_STANDARD)
+        hr = fw_profile_value_set( L"PublicProfile", value, data ? 1 : 0 );
+    return hr;
+}
