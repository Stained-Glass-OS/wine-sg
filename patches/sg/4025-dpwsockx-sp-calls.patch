From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dpwsockx: Implement Reply, Send, GetAddress, Cancel and GetMessageQueue.

The DirectPlay Winsock service provider sends and replies over its
sockets, returns player addresses, and reports an empty message queue.
---
 dlls/dpwsockx/dpwsockx_main.c | 171 +++++++++++++++++++++++++++++++++++++++---
 1 file changed, 161 insertions(+), 10 deletions(-)

diff --git a/dlls/dpwsockx/dpwsockx_main.c b/dlls/dpwsockx/dpwsockx_main.c
index 430901b..7653be3 100644
--- a/dlls/dpwsockx/dpwsockx_main.c
+++ b/dlls/dpwsockx/dpwsockx_main.c
@@ -23,9 +23,11 @@
 #include "windef.h"
 #include "winbase.h"
 #include "winsock2.h"
+#include "ws2tcpip.h"
 #include "dpwsockx_dll.h"
 #include "wine/debug.h"
 #include "dplay.h"
+#include "dplobby.h"
 #include "wine/dplaysp.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(dplay);
@@ -571,21 +573,103 @@ static HRESULT WINAPI DPWSCB_EnumSessions( LPDPSP_ENUMSESSIONSDATA data )
     return DP_OK;
 }
 
+static HRESULT DPWS_SendImpl( DPWS_DATA *dpwsData, DPWS_PLAYER *player, SGBUFFER *buffers,
+                              DWORD bufferCount, DWORD messageSize, BOOL guaranteed, BOOL system );
+
+/* A reply goes back over TCP to the address the request came from. */
 static HRESULT WINAPI DPWSCB_Reply( LPDPSP_REPLYDATA data )
 {
-    FIXME( "(%p,%p,%ld,%ld,%p) stub\n",
+    DPSP_MSG_HEADER *request = data->lpSPMessageHeader, *header = data->lpMessage;
+    DPWS_DATA *dpwsData;
+    DWORD dpwsDataSize, sent = 0;
+    SOCKET sock;
+    HRESULT hr;
+    int ret;
+
+    TRACE( "(%p,%p,%ld,%ld,%p)\n",
            data->lpSPMessageHeader, data->lpMessage, data->dwMessageSize,
            data->idNameServer, data->lpISP );
-    return DPERR_UNSUPPORTED;
+
+    if ( !request || !header || data->dwMessageSize < sizeof( DPSP_MSG_HEADER ) )
+        return DPERR_INVALIDPARAMS;
+
+    hr = IDirectPlaySP_GetSPData( data->lpISP, (void **) &dpwsData, &dpwsDataSize, DPSET_LOCAL );
+    if ( FAILED( hr ) )
+        return hr;
+
+    memset( header, 0, sizeof( DPSP_MSG_HEADER ) );
+    header->mixed = DPSP_MSG_MAKE_MIXED( data->dwMessageSize, DPSP_MSG_TOKEN_REMOTE );
+    header->SockAddr.sin_family = AF_INET;
+    header->SockAddr.sin_port = dpwsData->tcpAddr.sin_port;
+
+    sock = socket( AF_INET, SOCK_STREAM, IPPROTO_TCP );
+    if ( sock == INVALID_SOCKET )
+    {
+        ERR( "socket() failed\n" );
+        return DPERR_UNAVAILABLE;
+    }
+    if ( SOCKET_ERROR == connect( sock, (SOCKADDR *) &request->SockAddr, sizeof( request->SockAddr ) ) )
+    {
+        WARN( "connect() failed\n" );
+        closesocket( sock );
+        return DPERR_UNAVAILABLE;
+    }
+    while ( sent < data->dwMessageSize )
+    {
+        ret = send( sock, (char *) data->lpMessage + sent, data->dwMessageSize - sent, 0 );
+        if ( ret == SOCKET_ERROR || !ret )
+        {
+            WARN( "send() failed\n" );
+            closesocket( sock );
+            return DPERR_CONNECTIONLOST;
+        }
+        sent += ret;
+    }
+    closesocket( sock );
+
+    return DP_OK;
 }
 
+/* The DirectX 5 send: the message starts with room for the SP header. */
 static HRESULT WINAPI DPWSCB_Send( LPDPSP_SENDDATA data )
 {
-    FIXME( "(0x%08lx,%ld,%ld,%p,%ld,%u,%p) stub\n",
+    DPWS_PLAYER *player;
+    DPWS_DATA *dpwsData;
+    DWORD dpwsDataSize, playerSize;
+    SGBUFFER buffers[ 2 ];
+    HRESULT hr;
+
+    TRACE( "(0x%08lx,%ld,%ld,%p,%ld,%u,%p)\n",
            data->dwFlags, data->idPlayerTo, data->idPlayerFrom,
            data->lpMessage, data->dwMessageSize,
            data->bSystemMessage, data->lpISP );
-    return DPERR_UNSUPPORTED;
+
+    if ( data->dwMessageSize < sizeof( DPSP_MSG_HEADER ) )
+        return DPERR_INVALIDPARAMS;
+
+    hr = IDirectPlaySP_GetSPData( data->lpISP, (void **) &dpwsData, &dpwsDataSize, DPSET_LOCAL );
+    if ( FAILED( hr ) )
+        return hr;
+
+    if ( data->idPlayerTo )
+    {
+        hr = IDirectPlaySP_GetSPPlayerData( data->lpISP, data->idPlayerTo, (void **) &player,
+                                            &playerSize, DPSET_LOCAL );
+        if ( FAILED( hr ) )
+            return hr;
+    }
+    else
+    {
+        player = &dpwsData->nameserver;
+    }
+
+    buffers[ 0 ].len = sizeof( DPSP_MSG_HEADER );
+    buffers[ 0 ].pData = data->lpMessage;
+    buffers[ 1 ].len = data->dwMessageSize - sizeof( DPSP_MSG_HEADER );
+    buffers[ 1 ].pData = (unsigned char *) data->lpMessage + sizeof( DPSP_MSG_HEADER );
+
+    return DPWS_SendImpl( dpwsData, player, buffers, 2, data->dwMessageSize,
+                          !!( data->dwFlags & DPSEND_GUARANTEED ), data->bSystemMessage );
 }
 
 static HRESULT WINAPI DPWSCB_AddPlayerToGroup( DPSP_ADDPLAYERTOGROUPDATA *data )
@@ -847,12 +931,72 @@ static HRESULT WINAPI DPWSCB_DeletePlayer( LPDPSP_DELETEPLAYERDATA data )
     return DP_OK;
 }
 
+/* A player's DirectPlay address: the TCP/IP provider, the IP address and the port,
+ * as a compound address (total size element first). */
 static HRESULT WINAPI DPWSCB_GetAddress( LPDPSP_GETADDRESSDATA data )
 {
-    FIXME( "(%ld,0x%08lx,%p,%p,%p) stub\n",
+    DPWS_PLAYERDATA *playerData;
+    DWORD playerDataSize, size, ip_len;
+    struct sockaddr_in addr;
+    char ip[ 16 ], host[ 256 ];
+    struct addrinfo hints = { 0 }, *info;
+    BYTE *p;
+    WORD port;
+    HRESULT hr;
+
+    TRACE( "(%ld,0x%08lx,%p,%p,%p)\n",
            data->idPlayer, data->dwFlags, data->lpAddress,
            data->lpdwAddressSize, data->lpISP );
-    return DPERR_UNSUPPORTED;
+
+    if ( !data->lpdwAddressSize )
+        return DPERR_INVALIDPARAMS;
+
+    hr = IDirectPlaySP_GetSPPlayerData( data->lpISP, data->idPlayer, (void **) &playerData,
+                                        &playerDataSize, DPSET_REMOTE );
+    if ( FAILED( hr ) || playerDataSize != sizeof( DPWS_PLAYERDATA ) )
+        return DPERR_INVALIDPLAYER;
+
+    addr = playerData->tcpAddr;
+    if ( addr.sin_addr.s_addr == INADDR_ANY )
+    {
+        /* a local player: this machine's address */
+        addr.sin_addr.s_addr = htonl( INADDR_LOOPBACK );
+        hints.ai_family = AF_INET;
+        if ( !gethostname( host, sizeof( host ) ) && !getaddrinfo( host, NULL, &hints, &info ) )
+        {
+            addr.sin_addr = ((struct sockaddr_in *) info->ai_addr)->sin_addr;
+            freeaddrinfo( info );
+        }
+    }
+    strcpy( ip, inet_ntoa( addr.sin_addr ) );
+    ip_len = strlen( ip ) + 1;
+    port = ntohs( addr.sin_port );
+
+    size = 4 * sizeof( DPADDRESS ) + sizeof( DWORD ) + sizeof( GUID ) + ip_len + sizeof( WORD );
+    if ( !data->lpAddress || *data->lpdwAddressSize < size )
+    {
+        *data->lpdwAddressSize = size;
+        return DPERR_BUFFERTOOSMALL;
+    }
+    *data->lpdwAddressSize = size;
+
+#define ADD_ELEMENT( guid, ptr, len ) \
+    do { \
+        ((DPADDRESS *) p)->guidDataType = guid; \
+        ((DPADDRESS *) p)->dwDataSize = len; \
+        p += sizeof( DPADDRESS ); \
+        memcpy( p, ptr, len ); \
+        p += len; \
+    } while (0)
+
+    p = (BYTE *) data->lpAddress;
+    ADD_ELEMENT( DPAID_TotalSize, &size, sizeof( DWORD ) );
+    ADD_ELEMENT( DPAID_ServiceProvider, &DPSPGUID_TCPIP, sizeof( GUID ) );
+    ADD_ELEMENT( DPAID_INet, ip, ip_len );
+    ADD_ELEMENT( DPAID_INetPort, &port, sizeof( WORD ) );
+#undef ADD_ELEMENT
+
+    return DP_OK;
 }
 
 static HRESULT WINAPI DPWSCB_GetCaps( LPDPSP_GETCAPSDATA data )
@@ -1208,20 +1352,27 @@ static HRESULT WINAPI DPWSCB_SendToGroupEx( LPDPSP_SENDTOGROUPEXDATA data )
