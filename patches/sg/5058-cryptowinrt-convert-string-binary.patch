From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cryptowinrt: Implement CryptographicBuffer ConvertStringToBinary and ConvertBinaryToString.

CryptographicBuffer.ConvertStringToBinary and ConvertBinaryToString convert
between a string and its UTF-8, UTF-16LE or UTF-16BE bytes; they returned
E_NOTIMPL. An encoding outside BinaryStringEncoding is E_INVALIDARG.

Gate: test/cryptobuffer-convert-gate.sh.
---
 dlls/cryptowinrt/main.c | 76 ++++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 72 insertions(+), 4 deletions(-)

diff --git a/dlls/cryptowinrt/main.c b/dlls/cryptowinrt/main.c
index 09978db..5aa35f6 100644
--- a/dlls/cryptowinrt/main.c
+++ b/dlls/cryptowinrt/main.c
@@ -483,17 +483,85 @@ static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_ConvertStringToBinary(
         ICryptographicBufferStatics *iface, HSTRING value, BinaryStringEncoding encoding,
         IBuffer **buffer)
 {
-    FIXME("iface %p, value %p, encoding %d, buffer %p stub!\n", iface, value, encoding, buffer);
+    const WCHAR *text;
+    UINT32 length, i;
+    BYTE *data;
+    HRESULT hr;
+    int size;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, value %s, encoding %d, buffer %p.\n", iface, debugstr_hstring(value), encoding, buffer);
+
+    if (!buffer) return E_POINTER;
+    text = WindowsGetStringRawBuffer(value, &length);
+    switch (encoding)
+    {
+    case BinaryStringEncoding_Utf8:
+        size = length ? WideCharToMultiByte(CP_UTF8, 0, text, length, NULL, 0, NULL, NULL) : 0;
+        if (!(data = malloc(size + 1))) return E_OUTOFMEMORY;
+        if (size) WideCharToMultiByte(CP_UTF8, 0, text, length, (char *)data, size, NULL, NULL);
+        break;
+    case BinaryStringEncoding_Utf16LE:
+    case BinaryStringEncoding_Utf16BE:
+        size = length * sizeof(WCHAR);
+        if (!(data = malloc(size + 1))) return E_OUTOFMEMORY;
+        for (i = 0; i < length; i++)
+        {
+            BYTE lo = text[i] & 0xff, hi = text[i] >> 8;
+#ifdef SG_MUTANT_BE_AS_LE
+            encoding = BinaryStringEncoding_Utf16LE;
+#endif
+            data[2 * i] = encoding == BinaryStringEncoding_Utf16LE ? lo : hi;
+            data[2 * i + 1] = encoding == BinaryStringEncoding_Utf16LE ? hi : lo;
+        }
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    hr = buffer_from_bytes(data, size, buffer);
+    free(data);
+    return hr;
 }
 
 static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_ConvertBinaryToString(
         ICryptographicBufferStatics *iface, BinaryStringEncoding encoding, IBuffer *buffer, HSTRING *value)
 {
-    FIXME("iface %p, encoding %d, buffer %p, value %p stub!\n", iface, encoding, buffer, value);
+    IBufferByteAccess *access;
+    UINT32 length, i;
+    WCHAR *text;
+    BYTE *bytes;
+    HRESULT hr;
+    int count;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, encoding %d, buffer %p, value %p.\n", iface, encoding, buffer, value);
+
+    if (!value) return E_POINTER;
+    if (encoding != BinaryStringEncoding_Utf8 && encoding != BinaryStringEncoding_Utf16LE &&
+        encoding != BinaryStringEncoding_Utf16BE) return E_INVALIDARG;
+    if (FAILED(hr = buffer_bytes(buffer, &bytes, &length, &access))) return hr;
+    if (encoding != BinaryStringEncoding_Utf8 && length % 2) hr = E_INVALIDARG;
+    else
+    {
+        count = encoding == BinaryStringEncoding_Utf8
+                ? (length ? MultiByteToWideChar(CP_UTF8, 0, (const char *)bytes, length, NULL, 0) : 0)
+                : length / 2;
+        if ((text = malloc((count + 1) * sizeof(WCHAR))))
+        {
+            if (encoding == BinaryStringEncoding_Utf8)
+            {
+                if (count) MultiByteToWideChar(CP_UTF8, 0, (const char *)bytes, length, text, count);
+            }
+            else for (i = 0; i < count; i++)
+            {
+                if (encoding == BinaryStringEncoding_Utf16LE) text[i] = bytes[2 * i] | bytes[2 * i + 1] << 8;
+                else text[i] = bytes[2 * i] << 8 | bytes[2 * i + 1];
+            }
+            hr = WindowsCreateString(text, count, value);
+            free(text);
+        }
+        else hr = E_OUTOFMEMORY;
+    }
+    if (access) access->lpVtbl->Release(access);
+    return hr;
 }
 
 static const struct ICryptographicBufferStaticsVtbl cryptobuffer_statics_vtbl =
