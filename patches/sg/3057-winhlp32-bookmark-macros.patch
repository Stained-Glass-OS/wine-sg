diff --git a/programs/winhlp32/macro.c b/programs/winhlp32/macro.c
index 36bda65..f6d5e8d 100644
--- a/programs/winhlp32/macro.c
+++ b/programs/winhlp32/macro.c
@@ -341,9 +341,37 @@ static void CALLBACK MACRO_DeleteItem(LPCSTR str)
     WINE_FIXME("(%s)\n", debugstr_a(str));
 }
 
+/* bookmarks of the macro SaveMark: a name and a topic in a help file */
+struct mark
+{
+    struct mark *next;
+    char *name;
+    char *file;
+    LONG offset;
+};
+
+static struct mark *marks;
+
+static struct mark **MACRO_LookupMark(LPCSTR name)
+{
+    struct mark **m;
+
+    for (m = &marks; *m; m = &(*m)->next)
+        if (!lstrcmpiA((*m)->name, name)) break;
+    return m;
+}
+
 static void CALLBACK MACRO_DeleteMark(LPCSTR str)
 {
-    WINE_FIXME("(%s)\n", debugstr_a(str));
+    struct mark **m, *mark;
+
+    WINE_TRACE("(%s)\n", debugstr_a(str));
+    m = MACRO_LookupMark(str);
+    if (!(mark = *m)) return;
+    *m = mark->next;
+    free(mark->name);
+    free(mark->file);
+    free(mark);
 }
 
 static void CALLBACK MACRO_DisableItem(LPCSTR str)
@@ -461,7 +489,14 @@ static void CALLBACK MACRO_Generate(LPCSTR str, LONG w, LONG l)
 
 static void CALLBACK MACRO_GotoMark(LPCSTR str)
 {
-    WINE_FIXME("(%s)\n", debugstr_a(str));
+    struct mark *mark = *MACRO_LookupMark(str);
+    HLPFILE *hlpfile;
+
+    WINE_TRACE("(%s)\n", debugstr_a(str));
+    if (!mark) return;
+    if ((hlpfile = WINHELP_LookupHelpFile(mark->file)))
+        WINHELP_OpenHelpWindow(HLPFILE_PageByOffset, hlpfile, mark->offset,
+                               MACRO_CurrentWindow()->info, SW_NORMAL);
 }
 
 void CALLBACK MACRO_HelpOn(void)
@@ -553,14 +588,14 @@ static BOOL CALLBACK MACRO_IsBook(void)
 
 static BOOL CALLBACK MACRO_IsMark(LPCSTR str)
 {
-    WINE_FIXME("(%s)\n", debugstr_a(str));
-    return FALSE;
+    WINE_TRACE("(%s)\n", debugstr_a(str));
+    return *MACRO_LookupMark(str) != NULL;
 }
 
 static BOOL CALLBACK MACRO_IsNotMark(LPCSTR str)
 {
-    WINE_FIXME("(%s)\n", debugstr_a(str));
-    return TRUE;
+    WINE_TRACE("(%s)\n", debugstr_a(str));
+    return *MACRO_LookupMark(str) == NULL;
 }
 
 void CALLBACK MACRO_JumpContext(LPCSTR lpszPath, LPCSTR lpszWindow, LONG context)
@@ -813,7 +848,22 @@ static void CALLBACK MACRO_ResetMenu(void)
 
 static void CALLBACK MACRO_SaveMark(LPCSTR str)
 {
-    WINE_FIXME("(%s)\n", debugstr_a(str));
+    WINHELP_WINDOW *win = MACRO_CurrentWindow();
+    struct mark **m, *mark;
+
+    WINE_TRACE("(%s)\n", debugstr_a(str));
+    if (!win || !win->page || !win->page->file) return;
+
+    m = MACRO_LookupMark(str);
+    if (!(mark = *m))
+    {
+        if (!(mark = calloc(1, sizeof(*mark)))) return;
+        mark->name = strdup(str);
+        *m = mark;
+    }
+    free(mark->file);
+    mark->file = strdup(win->page->file->lpszPath);
+    mark->offset = win->page->offset;
 }
 
 static void CALLBACK MACRO_Search(void)
