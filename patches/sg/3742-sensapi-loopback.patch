From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sensapi: the loopback is reachable without a route (3742)

sensapi: the loopback is reachable without a route

IsDestinationReachable answered "unreachable" for 127.0.0.1 and ::1 on a
machine with no route at all, because the routing table has no entry for the
loopback; Windows has a loopback interface that is always there. The sens
gate now controls connectivity itself: it runs the probe on the host and in
two network namespaces (no route; a default route), so the connect.dll
IsInternetConnected mutants that escaped on a machine with a default route
are caught.

Rebased at integration (integ-2026-10) onto 3292 (fast-a): the loopback rule of 3742 ported into fast-a 3292's IsDestinationReachableW (3741's sensapi code is not used); mutant SG_MUTANT_SENS_NOLOOPBACK.
---
diff --git a/dlls/sensapi/sensapi.c b/dlls/sensapi/sensapi.c
--- a/dlls/sensapi/sensapi.c
+++ b/dlls/sensapi/sensapi.c
@@ -102,6 +102,16 @@ static BOOL adapter_connected( const IP_ADAPTER_ADDRESSES *aa )
     return aa->OperStatus == IfOperStatusUp && aa->IfType != IF_TYPE_SOFTWARE_LOOPBACK && has_usable_address( aa );
 }
 
+/* the loopback is always there, with or without a route (3742) */
+static BOOL is_loopback( const SOCKADDR *addr )
+{
+    if (addr->sa_family == AF_INET)
+        return ((const SOCKADDR_IN *)addr)->sin_addr.S_un.S_un_b.s_b1 == 127;
+    if (addr->sa_family == AF_INET6)
+        return IN6_IS_ADDR_LOOPBACK( &((const SOCKADDR_IN6 *)addr)->sin6_addr );
+    return FALSE;
+}
+
 static DWORD clip_speed( ULONG64 speed ) { return speed > 0xffffffff ? 0xffffffff : (DWORD)speed; }
 
 BOOL WINAPI IsDestinationReachableA(LPCSTR lpszDestination, LPQOCINFO lpQOCInfo)
@@ -136,7 +146,7 @@ BOOL WINAPI IsDestinationReachableW(LPCWSTR lpszDestination, LPQOCINFO lpQOCInfo
     const IP_ADAPTER_ADDRESSES *aa, *best = NULL;
     WSADATA wsa;
     DWORD index = 0;
-    BOOL ret = FALSE;
+    BOOL ret = FALSE, loopback = FALSE;
     DWORD err;
 
     TRACE("%s,%p\n", debugstr_w(lpszDestination), lpQOCInfo);
@@ -164,7 +174,12 @@ BOOL WINAPI IsDestinationReachableW(LPCWSTR lpszDestination, LPQOCINFO lpQOCInfo
     {
         ADDRINFOW *ai;
         for (ai = res; ai && !ret; ai = ai->ai_next)
+        {
+#ifndef SG_MUTANT_SENS_NOLOOPBACK
+            if (is_loopback( ai->ai_addr )) { ret = loopback = TRUE; break; }
+#endif
             if (GetBestInterfaceEx( ai->ai_addr, &index ) == NO_ERROR) ret = TRUE;
+        }
     }
     FreeAddrInfoW( res );
     WSACleanup();
@@ -180,9 +195,9 @@ BOOL WINAPI IsDestinationReachableW(LPCWSTR lpszDestination, LPQOCINFO lpQOCInfo
     if (lpQOCInfo)
 #endif
     {
-        lpQOCInfo->dwFlags = 0;
+        lpQOCInfo->dwFlags = loopback ? NETWORK_ALIVE_LAN : 0;
         lpQOCInfo->dwInSpeed = lpQOCInfo->dwOutSpeed = 0;
-        if ((adapters = get_adapters()))
+        if (!loopback && (adapters = get_adapters()))
         {
             for (aa = adapters; aa; aa = aa->Next)
                 if (aa->IfIndex == index || aa->Ipv6IfIndex == index) { best = aa; break; }
