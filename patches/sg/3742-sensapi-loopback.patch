From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sensapi: the loopback is reachable without a route (3742)

sensapi: the loopback is reachable without a route

IsDestinationReachable answered "unreachable" for 127.0.0.1 and ::1 on a
machine with no route at all, because the routing table has no entry for the
loopback; Windows has a loopback interface that is always there. The sens
gate now controls connectivity itself: it runs the probe on the host and in
two network namespaces (no route; a default route), so the connect.dll
IsInternetConnected mutants that escaped on a machine with a default route
are caught.
---
diff --git a/dlls/sensapi/sensapi.c b/dlls/sensapi/sensapi.c
index 547d7e6..1a0609e 100644
--- a/dlls/sensapi/sensapi.c
+++ b/dlls/sensapi/sensapi.c
@@ -41,6 +41,15 @@ WINE_DEFAULT_DEBUG_CHANNEL(sensapi);
 /* Stained Glass OS: a destination (a host name or an address) is reachable when it resolves and the
  * routing table has an interface for it; the speed of that interface goes to the QOC info (GUESS: Windows
  * measures; the link speed is what the interface says). */
+static BOOL is_loopback(const SOCKADDR *addr)
+{
+    if (addr->sa_family == AF_INET)
+        return (((const SOCKADDR_IN *)addr)->sin_addr.S_un.S_un_b.s_b1 == 127);
+    if (addr->sa_family == AF_INET6)
+        return IN6_IS_ADDR_LOOPBACK(&((const SOCKADDR_IN6 *)addr)->sin6_addr);
+    return FALSE;
+}
+
 static BOOL destination_reachable(const WCHAR *dest, QOCINFO *qoc)
 {
     ADDRINFOW hints = {0}, *res, *cur;
@@ -61,6 +70,13 @@ static BOOL destination_reachable(const WCHAR *dest, QOCINFO *qoc)
             DWORD index;
             MIB_IFROW row;
 
+            if (is_loopback(cur->ai_addr))
+            {
+                /* the loopback is always there, with or without a route */
+                ret = TRUE;
+                if (qoc) { qoc->dwFlags = NETWORK_ALIVE_LAN; qoc->dwInSpeed = qoc->dwOutSpeed = 0; }
+                continue;
+            }
             if (GetBestInterfaceEx(cur->ai_addr, &index)) continue;
             ret = TRUE;
             if (qoc)
