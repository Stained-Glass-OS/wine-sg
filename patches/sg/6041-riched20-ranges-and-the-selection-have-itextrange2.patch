+static HRESULT WINAPI range2_TypeText( ITextRange2 *iface, BSTR text )
+{
+    HRESULT hr;
+
+    TRACE( "(%p)->(%s)\n", iface, debugstr_w(text) );
+    /* the text replaces the range, which then follows it */
+    if (FAILED(hr = ITextRange_SetText( range_of( iface ), text ))) return hr;
+    return ITextRange_Collapse( range_of( iface ), tomEnd );
+}
