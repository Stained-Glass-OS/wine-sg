+static HRESULT WINAPI range2_GetType( ITextRange2 *iface, LONG *type )
+{
+    LONG start, end;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", iface, type );
+    if (!type) return E_INVALIDARG;
+    if (FAILED(hr = ITextRange_GetStart( range_of( iface ), &start )) ||
+        FAILED(hr = ITextRange_GetEnd( range_of( iface ), &end ))) return hr;
+    *type = start == end ? tomSelectionIP : tomSelectionNormal;
+    return S_OK;
