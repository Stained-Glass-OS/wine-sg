+/* as the selection moves with the arrow keys: a range that is not empty first collapses to the side
+ * it moves to (that counts as one unit); with extend, only the end on that side moves */
+static HRESULT range2_move( ITextRange2 *iface, LONG unit, LONG count, LONG extend, LONG *delta )
+{
+    ITextRange *range = range_of( iface );
+    LONG start, end, moved = 0, more = 0, step = count < 0 ? -1 : 1;
+    HRESULT hr;
+
+    if (delta) *delta = 0;
+    if (FAILED(hr = ITextRange_GetStart( range, &start )) || FAILED(hr = ITextRange_GetEnd( range, &end ))) return hr;
+    if (!count) return S_FALSE;
+    if (extend)
+        hr = count < 0 ? ITextRange_MoveStart( range, unit, count, &moved ) : ITextRange_MoveEnd( range, unit, count, &moved );
+    else
+    {
+        if (start != end)
+        {
+            ITextRange_Collapse( range, count < 0 ? tomStart : tomEnd );
+            moved = step;
+            count -= step;
+        }
+        if (count)
+        {
+            hr = ITextRange_Move( range, unit, count, &more );
+            moved += more;
+        }
+    }
+    if (delta) *delta = moved;
+    if (FAILED(hr)) return hr;
+    return moved ? S_OK : S_FALSE;
+}
