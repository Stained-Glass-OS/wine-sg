+static HRESULT WINAPI range2_MoveDown( ITextRange2 *iface, LONG unit, LONG count, LONG extend, LONG *delta )
+{
+    TRACE( "(%p)->(%ld %ld %ld %p)\n", iface, unit, count, extend, delta );
