+}
+
+/* the rectangle from the range's start to its end, in screen coordinates */
+static HRESULT WINAPI tom2_GetRect( ITextRange2 *iface, LONG type, LONG *left, LONG *top, LONG *right,
+                                    LONG *bottom, LONG *hit )
+{
+    LONG l = 0, t = 0, r = 0, b = 0;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%#lx %p %p %p %p %p)\n", iface, type, left, top, right, bottom, hit );
+    if (!left || !top || !right || !bottom) return E_INVALIDARG;
+    if (FAILED(hr = ITextRange_GetPoint( range_of( iface ), tomStart | TA_TOP | TA_LEFT, &l, &t )) ||
+        FAILED(hr = ITextRange_GetPoint( range_of( iface ), tomEnd | TA_BOTTOM | TA_RIGHT, &r, &b ))) return hr;
+    *left = l;
+    *top = t;
+    *right = r;
+    *bottom = b;
+    if (hit) *hit = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI tom2_GetSubrange( ITextRange2 *iface, LONG subrange, LONG *first, LONG *limit )
+{
+    HRESULT hr;
+
+    TRACE( "(%p)->(%ld %p %p)\n", iface, subrange, first, limit );
+    if (!first || !limit) return E_INVALIDARG;
+    if (subrange) return E_INVALIDARG;   /* one subrange, number 0 */
+    if (FAILED(hr = ITextRange_GetStart( range_of( iface ), first ))) return hr;
+    return ITextRange_GetEnd( range_of( iface ), limit );
+}
