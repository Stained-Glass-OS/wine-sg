+
+static HRESULT WINAPI tom2_DeleteSubrange( ITextRange2 *iface, LONG first, LONG lim )
+{
+    FIXME( "(%p)->(%ld %ld): only one subrange\n", iface, first, lim );
+    return E_NOTIMPL;
+}
+
+/* the other range's text, found as FindText finds it */
+static HRESULT WINAPI tom2_Find( ITextRange2 *iface, ITextRange2 *range, LONG count, LONG flags, LONG *delta )
+{
+    BSTR text = NULL;
+    LONG length = 0;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p %ld %#lx %p)\n", iface, range, count, flags, delta );
+    if (delta) *delta = 0;
+    if (!range) return E_INVALIDARG;
+    if (FAILED(hr = ITextRange_GetText( range_of( range ), &text ))) return hr;
+    hr = ITextRange_FindText( range_of( iface ), text, count, flags, &length );
+    SysFreeString( text );
+    if (delta) *delta = length;
+    return hr;
+}
+
+/* the character at the offset from the range's start */
+static HRESULT WINAPI tom2_GetChar2( ITextRange2 *iface, LONG *ch, LONG offset )
+{
+    ITextRange *dup;
+    LONG start, length;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p %ld)\n", iface, ch, offset );
+    if (!ch) return E_INVALIDARG;
+    *ch = 0;
+    if (FAILED(hr = ITextRange_GetStart( range_of( iface ), &start )) ||
+        FAILED(hr = ITextRange_GetStoryLength( range_of( iface ), &length ))) return hr;
+    if (start + offset < 0 || start + offset >= length) return S_FALSE;
+    if (FAILED(hr = tom2_dup( iface, &dup ))) return hr;
+    if (SUCCEEDED(hr = ITextRange_SetRange( dup, start + offset, start + offset + 1 )))
+        hr = ITextRange_GetChar( dup, ch );
+    ITextRange_Release( dup );
+    return hr;
+}
