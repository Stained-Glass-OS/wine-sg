+/* the start of the paragraph the range starts in */
+static HRESULT WINAPI tom2_GetStartPara( ITextRange2 *iface, LONG *value )
+{
+    ITextRange *dup;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", iface, value );
+    if (!value) return E_INVALIDARG;
+    if (FAILED(hr = tom2_dup( iface, &dup ))) return hr;
+    ITextRange_Collapse( dup, tomStart );
+    if (SUCCEEDED(hr = ITextRange_StartOf( dup, tomParagraph, tomMove, NULL )))
+        hr = ITextRange_GetStart( dup, value );
+    ITextRange_Release( dup );
+    return SUCCEEDED(hr) ? S_OK : hr;
+}
