+/* ---- Stained Glass OS: TOM2 (ITextRange2 / ITextSelection2) -----------------------------------
+ *
+ * RichEdit 7 and later give ranges and the selection ITextRange2, which adds the ITextSelection
+ * methods (for a range they act on the range) and TOM2's own. The methods here work through the
+ * range's ITextRange methods, so ranges and the selection share them. Tables, math, inline objects,
+ * subranges beyond the first and ITextFont2/ITextPara2 are not there (E_NOTIMPL). */
+
+static inline ITextRange *range_of( ITextRange2 *iface )
+{
+    return (ITextRange *)iface;
+}
+
+/* a duplicate of the range as an ITextRange */
+static HRESULT tom2_dup( ITextRange2 *iface, ITextRange **dup )
+{
+    return ITextRange_GetDuplicate( range_of( iface ), dup );
+}
+
+static HRESULT WINAPI tom2_GetCch( ITextRange2 *iface, LONG *count )
+{
+    LONG start, end;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", iface, count );
+    if (!count) return E_INVALIDARG;
+    if (FAILED(hr = ITextRange_GetStart( range_of( iface ), &start )) ||
+        FAILED(hr = ITextRange_GetEnd( range_of( iface ), &end ))) return hr;
+#ifdef SG_MUTANT_TOM2_CCH
+    *count = 0;
+    return S_OK;
+#endif
+    *count = end - start;
+    return S_OK;
+}
+
+static HRESULT WINAPI tom2_GetCells( ITextRange2 *iface, IUnknown **cells )
+{
+    FIXME( "(%p)->(%p): tables are not supported\n", iface, cells );
+    if (cells) *cells = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI tom2_GetColumn( ITextRange2 *iface, IUnknown **column )
+{
+    FIXME( "(%p)->(%p): tables are not supported\n", iface, column );
+    if (column) *column = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI tom2_GetCount( ITextRange2 *iface, LONG *count )
+{
+    LONG start;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", iface, count );
+    if (!count) return E_INVALIDARG;
+    if (FAILED(hr = ITextRange_GetStart( range_of( iface ), &start ))) return hr;
+    *count = 1;   /* one subrange: the range itself */
+    return S_OK;
+}
+
+static HRESULT WINAPI tom2_GetDuplicate2( ITextRange2 *iface, ITextRange2 **range )
+{
+    ITextRange *dup;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", iface, range );
+    if (!range) return E_INVALIDARG;
+    *range = NULL;
+    if (FAILED(hr = tom2_dup( iface, &dup ))) return hr;
+    hr = ITextRange_QueryInterface( dup, &IID_ITextRange2, (void **)range );
+    ITextRange_Release( dup );
+    return hr;
+}
+
+static HRESULT WINAPI tom2_GetFont2( ITextRange2 *iface, ITextFont2 **font )
+{
+    FIXME( "(%p)->(%p): ITextFont2 is not supported, use GetFont\n", iface, font );
+    if (font) *font = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI tom2_SetFont2( ITextRange2 *iface, ITextFont2 *font )
