+}
+
+static HRESULT WINAPI tom2_GetFormattedText2( ITextRange2 *iface, ITextRange2 **range )
+{
+    ITextRange *text;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", iface, range );
+    if (!range) return E_INVALIDARG;
+    *range = NULL;
+    if (FAILED(hr = ITextRange_GetFormattedText( range_of( iface ), &text ))) return hr;
+    hr = ITextRange_QueryInterface( text, &IID_ITextRange2, (void **)range );
+    ITextRange_Release( text );
+    return hr;
+}
+
+static HRESULT WINAPI tom2_SetFormattedText2( ITextRange2 *iface, ITextRange2 *range )
+{
+    TRACE( "(%p)->(%p)\n", iface, range );
+    if (!range) return E_INVALIDARG;
+    return ITextRange_SetFormattedText( range_of( iface ), range_of( range ) );
+}
+
+static HRESULT WINAPI tom2_GetGravity( ITextRange2 *iface, LONG *value )
+{
+    LONG start;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", iface, value );
+    if (!value) return E_INVALIDARG;
+    if (FAILED(hr = ITextRange_GetStart( range_of( iface ), &start ))) return hr;
+    *value = 0;   /* tomGravityUI, the only gravity kept */
+    return S_OK;
+}
+
+static HRESULT WINAPI tom2_SetGravity( ITextRange2 *iface, LONG value )
+{
+    TRACE( "(%p)->(%ld)\n", iface, value );
+    /* tomGravityUI (0) through the four explicit gravities */
+    if (value < 0 || value > 4) return E_INVALIDARG;
+    if (value)
+    {
+        FIXME( "gravity %ld is not supported\n", value );
+        return E_NOTIMPL;
+    }
+    return S_OK;
+}
