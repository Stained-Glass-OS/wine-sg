From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:53:30 -0700
Subject: [PATCH] appwiz.cpl: install callback GetPriority and
 OnObjectAvailable succeed (3265)

The download callback of the add-on installer answered E_NOTIMPL to GetPriority (now S_OK with THREAD_PRIORITY_NORMAL, E_INVALIDARG for NULL) and OnObjectAvailable (S_OK: it is only called for BindToObject).

diff --git a/dlls/appwiz.cpl/addons.c b/dlls/appwiz.cpl/addons.c
index 7b2c434..43cbf58 100644
--- a/dlls/appwiz.cpl/addons.c
+++ b/dlls/appwiz.cpl/addons.c
@@ -431,7 +431,10 @@ static HRESULT WINAPI InstallCallback_OnStartBinding(IBindStatusCallback *iface,
 static HRESULT WINAPI InstallCallback_GetPriority(IBindStatusCallback *iface,
         LONG *pnPriority)
 {
-    return E_NOTIMPL;
+    if (!pnPriority)
+        return E_INVALIDARG;
+    *pnPriority = THREAD_PRIORITY_NORMAL;
+    return S_OK;
 }
 
 static HRESULT WINAPI InstallCallback_OnLowResource(IBindStatusCallback *iface,
@@ -525,8 +528,9 @@ static HRESULT WINAPI InstallCallback_OnDataAvailable(IBindStatusCallback *iface
 static HRESULT WINAPI InstallCallback_OnObjectAvailable(IBindStatusCallback *iface,
         REFIID riid, IUnknown* punk)
 {
-    ERR("\n");
-    return E_NOTIMPL;
+    /* only called for IMoniker::BindToObject, which this download never uses */
+    TRACE("\n");
+    return S_OK;
 }
 
 static const IBindStatusCallbackVtbl InstallCallbackVtbl = {
