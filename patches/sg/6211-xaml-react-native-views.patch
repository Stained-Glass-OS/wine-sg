+static HRESULT focus_op_create( boolean succeeded, IInspectable **out )
+{
+    struct movement_result *result;
+    struct focus_op *op;
+
+    if (!out) return E_POINTER;
+#ifdef SG_MUTANT_NO_FOCUS_ASYNC
+    return E_NOTIMPL;
+#endif
+    if (!(result = calloc( 1, sizeof(*result) ))) return E_OUTOFMEMORY;
+    result->IFocusMovementResult_iface.vtbl = movement_result_vtbl;
+    result->succeeded = succeeded;
+    xobj_init( &result->obj, &movement_result_class, NULL );
