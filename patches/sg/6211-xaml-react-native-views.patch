+
+    if (!handler) return E_POINTER;
+    if (op->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    op->handler = handler;
+    IUnknown_AddRef( handler );
+    /* done already: told at once (AsyncOperationCompletedHandler.Invoke( operation, Completed )) */
+    return ((HRESULT (WINAPI *)( IUnknown *, void *, INT32 ))((void **)handler->lpVtbl)[3])( handler, &op->vtbl, 1 );
