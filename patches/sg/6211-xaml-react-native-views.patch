+static struct scroll_viewer *sv_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct scroll_viewer, c.e.d.obj );
+}
+
+/* ScrollViewer 2 to 4: its headers and settings kept; it does not scroll yet, so a ChangeView is
+ * taken (the view is where it was asked to be: at its origin) and its events are accepted */
+static LONG sv_next_token;
+
+static HRESULT WINAPI sv_add_event( struct xiface *iface, IUnknown *handler, INT64 *token )
+{
+    if (!handler || !token) return E_POINTER;
+    *token = InterlockedIncrement( &sv_next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI sv_remove_event( struct xiface *iface, INT64 token )
+{
+    return S_OK;
+}
+
+#define SV_HEADER(name, i) \
+static HRESULT WINAPI sv2_get_##name( struct xiface *iface, IInspectable **value ) \
+{ \
+    if (!value) return E_POINTER; \
+    if ((*value = sv_from_iface( iface )->headers[i])) IInspectable_AddRef( *value ); \
+    return S_OK; \
+} \
+static HRESULT WINAPI sv2_put_##name( struct xiface *iface, IInspectable *value ) \
+{ \
+    struct scroll_viewer *sv = sv_from_iface( iface ); \
+    if (value) IInspectable_AddRef( value ); \
