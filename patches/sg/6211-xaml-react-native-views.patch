+/*
+ * The identifiers of UI Automation's properties (AutomationElementIdentifiers.NameProperty,
+ * TogglePatternIdentifiers.ToggleStateProperty, ...): one AutomationProperty object each, the same
+ * one every time asked, for programs to name a property they raise a change of; and
+ * ScrollPatternIdentifiers.NoScroll (-1).  Interface identity per windows-rs 0.30.0 (MIT); this file
+ * is generated by an SG script from it.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+
+struct automation_property
+{
+    struct xobj obj;
+    struct xiface IAutomationProperty_iface;
+};
+
+static const void *automation_property_vtbl[] = { XIFACE_COMMON };
+C_ASSERT( ARRAY_SIZE(automation_property_vtbl) == IAutomationProperty_slots );
+
+static const struct xiface_entry automation_property_ifaces[] =
+{
+    { &IID_IAutomationProperty, offsetof(struct automation_property, IAutomationProperty_iface) },
+};
+
+static const struct xclass automation_property_class =
+{
+    L"Windows.UI.Xaml.Automation.AutomationProperty", automation_property_ifaces, ARRAY_SIZE(automation_property_ifaces), NULL,
+};
+
+static IInspectable *identifiers[107];
+
+/* identifier n: made once, kept for the process */
+static HRESULT identifier( unsigned int n, IInspectable **value )
+{
+    struct automation_property *prop;
+    IInspectable *made;
+
+    if (!value) return E_POINTER;
+#ifdef SG_MUTANT_NO_AUTOMATION_IDENTIFIERS
+    return E_NOTIMPL;
+#endif
+    if (!identifiers[n])
+    {
+        if (!(prop = calloc( 1, sizeof(*prop) ))) return E_OUTOFMEMORY;
+        prop->IAutomationProperty_iface.vtbl = automation_property_vtbl;
+        xobj_init( &prop->obj, &automation_property_class, NULL );
+        made = xobj_default( &prop->obj );
+        IInspectable_Release( (IInspectable *)&prop->obj.IInspectable_inner );
+        if (InterlockedCompareExchangePointer( (void **)&identifiers[n], made, NULL )) IInspectable_Release( made );
+    }
+    IInspectable_AddRef( (*value = identifiers[n]) );
+    return S_OK;
+}
+
+/* ScrollPatternIdentifiers.NoScroll: the scroll position of a direction that does not scroll */
+static HRESULT WINAPI scroll_NoScroll( struct xfiface *iface, DOUBLE *value )
+{
+    if (!value) return E_POINTER;
+    *value = -1.0;
+    return S_OK;
+}
