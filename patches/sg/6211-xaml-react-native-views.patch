+/* the other attached kinds: a boolean, an element, an enumeration */
+static HRESULT attached_get( IInspectable *element, struct xaml_property **prop, IInspectable **box )
+{
+    struct dobj *obj = dobj_from_inspectable( element );
+
+    buttons_init();
+#ifdef SG_MUTANT_AUTOMATION1_NOT_KEPT
+    return E_NOTIMPL;
+#endif
+    *box = NULL;
+    if (!obj) return E_INVALIDARG;
+    return dobj_get_value( obj, *prop, box );
+}
+
+/* the property by its address: it is registered on first use, by buttons_init */
+static HRESULT attached_set( IInspectable *element, struct xaml_property **prop, IInspectable *box )
+{
+    struct dobj *obj = dobj_from_inspectable( element );
+    HRESULT hr;
+
+    buttons_init();
+    if (!obj) hr = E_INVALIDARG;
+    else hr = dobj_set_value( obj, *prop, box );
+    return hr;
+}
+
+static HRESULT WINAPI automation_GetIsRequiredForForm( struct xfiface *iface, IInspectable *element, boolean *value )
+{
+    IInspectable *box;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = attached_get( element, &prop_required_for_form, &box ))) return hr;
+    *value = xunbox_boolean( box, FALSE );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+static HRESULT WINAPI automation_SetIsRequiredForForm( struct xfiface *iface, IInspectable *element, boolean value )
+{
+    IInspectable *box = xbox_boolean( value );
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = attached_set( element, &prop_required_for_form, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static HRESULT WINAPI automation_GetLabeledBy( struct xfiface *iface, IInspectable *element, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    return attached_get( element, &prop_labeled_by, value );
+}
+
+static HRESULT WINAPI automation_SetLabeledBy( struct xfiface *iface, IInspectable *element, IInspectable *value )
+{
+    return attached_set( element, &prop_labeled_by, value );
+}
+
+static HRESULT WINAPI automation_GetLiveSetting( struct xfiface *iface, IInspectable *element, INT32 *value )
+{
+    IInspectable *box;
+    HRESULT hr;
