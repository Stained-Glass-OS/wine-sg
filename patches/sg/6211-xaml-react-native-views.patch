+};
+
+/* IAsyncOperation<FocusMovementResult>, already completed */
+struct focus_op
+{
+    const void *vtbl, *info_vtbl;
+    LONG ref;
+    IInspectable *result;
+    IUnknown *handler;
+};
+
+static struct focus_op *op_from( void *iface, BOOL info )
+{
+    return (struct focus_op *)((char *)iface - (info ? offsetof(struct focus_op, info_vtbl) : offsetof(struct focus_op, vtbl)));
+}
+
+static HRESULT op_qi( struct focus_op *op, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAsyncOperation_FocusMovementResult ))
+        *out = &op->vtbl;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo_fm )) *out = &op->info_vtbl;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &op->ref );
+    return S_OK;
+}
+
+static ULONG op_release( struct focus_op *op )
+{
+    ULONG ref = InterlockedDecrement( &op->ref );
+    if (!ref)
+    {
+        if (op->result) IInspectable_Release( op->result );
+        if (op->handler) IUnknown_Release( op->handler );
+        free( op );
+    }
+    return ref;
+}
