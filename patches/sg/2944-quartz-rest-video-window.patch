From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: IVideoWindow background palette, border colour, cursor, restore position; IBasicVideo palette entries

quartz's video window: IVideoWindow BackgroundPalette (OATRUE/OAFALSE
only, otherwise E_INVALIDARG), BorderColor, HideCursor / IsCursorHidden
(the cursor is hidden over the client area), GetRestorePosition (the
normal-state placement of the window), and IBasicVideo
GetVideoPaletteEntries (VFW_E_NOT_CONNECTED, otherwise
VFW_E_NO_PALETTE_AVAILABLE). Six todo_wine marks of the videorenderer,
vmr7 and vmr9 tests are removed. FullScreenMode stays E_NOTIMPL.

---
diff --git a/dlls/quartz/quartz_private.h b/dlls/quartz/quartz_private.h
index 5f568f8..507f7fc 100644
--- a/dlls/quartz/quartz_private.h
+++ b/dlls/quartz/quartz_private.h
@@ -90,6 +90,9 @@ struct video_window
     HWND hwnd;
     HWND hwndDrain;
     HWND hwndOwner;
+    LONG background_palette;
+    LONG border_color;
+    BOOL cursor_hidden;
     struct strmbase_filter *pFilter;
     struct strmbase_pin *pPin;
     const struct video_window_ops *ops;
diff --git a/dlls/quartz/tests/videorenderer.c b/dlls/quartz/tests/videorenderer.c
index ea54ec8..25e08d5 100644
--- a/dlls/quartz/tests/videorenderer.c
+++ b/dlls/quartz/tests/videorenderer.c
@@ -2836,7 +2836,7 @@ static void test_basic_video(void)
     hr = IBasicVideo_GetVideoPaletteEntries(video, 0, 1, NULL, &l);
     ok(hr == E_POINTER, "Got hr %#lx.\n", hr);
     hr = IBasicVideo_GetVideoPaletteEntries(video, 0, 1, &l, NULL);
-    todo_wine ok(hr == VFW_E_NOT_CONNECTED, "Got hr %#lx.\n", hr);
+    ok(hr == VFW_E_NOT_CONNECTED, "Got hr %#lx.\n", hr);
 
     testfilter_init(&source);
     IFilterGraph2_AddFilter(graph, &source.filter.IBaseFilter_iface, L"vmr9");
@@ -2860,7 +2860,7 @@ static void test_basic_video(void)
     ok(!l, "Got bit rate %ld.\n", l);
 
     hr = IBasicVideo_GetVideoPaletteEntries(video, 0, 1, &l, NULL);
-    todo_wine ok(hr == VFW_E_NO_PALETTE_AVAILABLE, "Got hr %#lx.\n", hr);
+    ok(hr == VFW_E_NO_PALETTE_AVAILABLE, "Got hr %#lx.\n", hr);
 
     width = height = 0xdeadbeef;
     hr = IBasicVideo_GetVideoSize(video, &width, &height);
diff --git a/dlls/quartz/tests/vmr7.c b/dlls/quartz/tests/vmr7.c
index 8e9b59c..ed2a9ff 100644
--- a/dlls/quartz/tests/vmr7.c
+++ b/dlls/quartz/tests/vmr7.c
