diff --git a/dlls/quartz/window.c b/dlls/quartz/window.c
index 02c6a82..1d18104 100644
--- a/dlls/quartz/window.c
+++ b/dlls/quartz/window.c
@@ -69,6 +69,13 @@ static LRESULT CALLBACK WndProcW(HWND hwnd, UINT message, WPARAM wparam, LPARAM
             return 0;
         }
         break;
+    case WM_SETCURSOR:
+        if (window->cursor_hidden && LOWORD(lparam) == HTCLIENT)
+        {
+            SetCursor(NULL);
+            return TRUE;
+        }
+        break;
     case WM_SIZE:
         if (window->default_dst)
             GetClientRect(window->hwnd, &window->dst);
@@ -328,19 +335,31 @@ HRESULT WINAPI BaseControlWindowImpl_get_WindowState(IVideoWindow *iface, LONG *
 
 HRESULT WINAPI BaseControlWindowImpl_put_BackgroundPalette(IVideoWindow *iface, LONG BackgroundPalette)
 {
-    struct video_window *This = impl_from_IVideoWindow(iface);
+    struct video_window *window = impl_from_IVideoWindow(iface);
 
-    FIXME("window %p, palette %ld, stub!\n", This, BackgroundPalette);
+    TRACE("window %p, palette %ld.\n", window, BackgroundPalette);
 
+#ifndef SG_MUTANT_WIN_BGPAL
+    if (BackgroundPalette != OATRUE && BackgroundPalette != OAFALSE)
+        return E_INVALIDARG;
+#endif
+
+    /* The video is not drawn through a palette, so this only changes the
+     * setting that is reported back. */
+    window->background_palette = BackgroundPalette;
     return S_OK;
 }
 
 HRESULT WINAPI BaseControlWindowImpl_get_BackgroundPalette(IVideoWindow *iface, LONG *pBackgroundPalette)
 {
-    struct video_window *This = impl_from_IVideoWindow(iface);
+    struct video_window *window = impl_from_IVideoWindow(iface);
 
-    FIXME("(%p/%p)->(%p): stub !!!\n", This, iface, pBackgroundPalette);
+    TRACE("window %p, palette %p.\n", window, pBackgroundPalette);
 
+    if (!pBackgroundPalette)
+        return E_POINTER;
+
+    *pBackgroundPalette = window->background_palette;
     return S_OK;
 }
 
@@ -539,19 +558,26 @@ HRESULT WINAPI BaseControlWindowImpl_get_MessageDrain(IVideoWindow *iface, OAHWN
 
 HRESULT WINAPI BaseControlWindowImpl_get_BorderColor(IVideoWindow *iface, LONG *Color)
 {
-    struct video_window *This = impl_from_IVideoWindow(iface);
+    struct video_window *window = impl_from_IVideoWindow(iface);
 
-    FIXME("(%p/%p)->(%p): stub !!!\n", This, iface, Color);
+    TRACE("window %p, colour %p.\n", window, Color);
 
+    if (!Color)
+        return E_POINTER;
+
+    *Color = window->border_color;
     return S_OK;
 }
 
 HRESULT WINAPI BaseControlWindowImpl_put_BorderColor(IVideoWindow *iface, LONG Color)
 {
-    struct video_window *This = impl_from_IVideoWindow(iface);
+    struct video_window *window = impl_from_IVideoWindow(iface);
 
-    TRACE("window %p, colour %#lx.\n", This, Color);
+    TRACE("window %p, colour %#lx.\n", window, Color);
 
+#ifndef SG_MUTANT_WIN_BORDER
+    window->border_color = Color;
+#endif
     return S_OK;
 }
 
@@ -676,10 +702,22 @@ HRESULT WINAPI BaseControlWindowImpl_GetMaxIdealImageSize(IVideoWindow *iface, L
 
 HRESULT WINAPI BaseControlWindowImpl_GetRestorePosition(IVideoWindow *iface, LONG *pLeft, LONG *pTop, LONG *pWidth, LONG *pHeight)
 {
-    struct video_window *This = impl_from_IVideoWindow(iface);
+    struct video_window *window = impl_from_IVideoWindow(iface);
+    WINDOWPLACEMENT placement = {.length = sizeof(placement)};
+
+    TRACE("window %p, left %p, top %p, width %p, height %p.\n", window, pLeft, pTop, pWidth, pHeight);
+
+    if (!pLeft || !pTop || !pWidth || !pHeight)
+        return E_POINTER;
 
-    FIXME("(%p/%p)->(%p, %p, %p, %p): stub !!!\n", This, iface, pLeft, pTop, pWidth, pHeight);
+    /* The position the window has when it is neither minimised nor maximised. */
+    if (!GetWindowPlacement(window->hwnd, &placement))
+        return HRESULT_FROM_WIN32(GetLastError());
 
+    *pLeft = placement.rcNormalPosition.left;
+    *pTop = placement.rcNormalPosition.top;
+    *pWidth = placement.rcNormalPosition.right - placement.rcNormalPosition.left;
+    *pHeight = placement.rcNormalPosition.bottom - placement.rcNormalPosition.top;
     return S_OK;
 }
 
@@ -687,17 +725,27 @@ HRESULT WINAPI BaseControlWindowImpl_HideCursor(IVideoWindow *iface, LONG hide)
 {
     struct video_window *window = impl_from_IVideoWindow(iface);
 
-    FIXME("window %p, hide %ld, stub!\n", window, hide);
+    TRACE("window %p, hide %ld.\n", window, hide);
+
+    if (hide != OATRUE && hide != OAFALSE)
+        return E_INVALIDARG;
 
+#ifndef SG_MUTANT_WIN_CURSOR
+    window->cursor_hidden = !!hide;
+#endif
     return S_OK;
 }
 
 HRESULT WINAPI BaseControlWindowImpl_IsCursorHidden(IVideoWindow *iface, LONG *CursorHidden)
 {
-    struct video_window *This = impl_from_IVideoWindow(iface);
+    struct video_window *window = impl_from_IVideoWindow(iface);
+
+    TRACE("window %p, hidden %p.\n", window, CursorHidden);
 
-    FIXME("(%p/%p)->(%p): stub !!!\n", This, iface, CursorHidden);
+    if (!CursorHidden)
+        return E_POINTER;
 
+    *CursorHidden = window->cursor_hidden ? OATRUE : OAFALSE;
     return S_OK;
 }
 
@@ -1178,13 +1226,19 @@ static HRESULT WINAPI basic_video_GetVideoPaletteEntries(IBasicVideo *iface,
 {
     struct video_window *window = impl_from_IBasicVideo(iface);
 
-    FIXME("window %p, start %ld, count %ld, ret_count %p, palette %p, stub!\n",
+    TRACE("window %p, start %ld, count %ld, ret_count %p, palette %p.\n",
             window, start, count, ret_count, palette);
 
-    if (!ret_count || !palette)
+    if (!ret_count)
         return E_POINTER;
-
     *ret_count = 0;
+
+#ifndef SG_MUTANT_WIN_PALENT
+    if (!window->pPin->peer)
+        return VFW_E_NOT_CONNECTED;
+#endif
+
+    /* The renderer draws through its own surface, so it has no palette to report. */
     return VFW_E_NO_PALETTE_AVAILABLE;
 }
 
