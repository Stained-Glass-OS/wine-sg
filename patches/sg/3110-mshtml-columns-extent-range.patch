From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 21:29:58 -0700
Subject: [PATCH] mshtml: multi-column style, text range word moves, selection
 clear and empty, SetExtent

The column-* style properties are passed to the engine under their prefixed
names (the tests' todo_wine marks for them are removed). IHTMLTxtRange
moveStart and moveEnd work by words. IHTMLSelectionObject::empty drops the
selection and clear deletes the selected content. IOleObject::SetExtent
refuses a negative size with E_FAIL before it checks the aspect (the four
todo_wine marks in htmldoc.c are removed).

diff --git a/dlls/mshtml/htmlstyle.c b/dlls/mshtml/htmlstyle.c
index f78a778..5507ab7 100644
--- a/dlls/mshtml/htmlstyle.c
+++ b/dlls/mshtml/htmlstyle.c
@@ -1782,6 +1782,26 @@ C_ASSERT(ARRAY_SIZE(style_tbl) == STYLEID_MAX_VALUE);
 
 static const WCHAR *get_style_nsname(const style_tbl_entry_t *style_entry)
 {
+    /* The multi-column properties are still prefixed in the engine. */
+    static const struct { const WCHAR *name, *ns_name; } columns[] = {
+        { L"column-count",      L"-moz-column-count" },
+        { L"column-fill",       L"-moz-column-fill" },
+        { L"column-gap",        L"-moz-column-gap" },
+        { L"column-rule",       L"-moz-column-rule" },
+        { L"column-rule-color", L"-moz-column-rule-color" },
+        { L"column-rule-style", L"-moz-column-rule-style" },
+        { L"column-rule-width", L"-moz-column-rule-width" },
+        { L"column-width",      L"-moz-column-width" },
+    };
+
+#ifndef SG_MUTANT_MSHTML_NOMOZCOL
+    if(!wcsncmp(style_entry->name, L"column-", 7)) {
+        unsigned i;
+        for(i = 0; i < ARRAY_SIZE(columns); i++)
+            if(!wcscmp(style_entry->name, columns[i].name))
+                return columns[i].ns_name;
+    }
+#endif
     if(style_entry->name[0] == '-')
         return style_entry->name + sizeof("-ms-")-1;
     return style_entry->name;
diff --git a/dlls/mshtml/oleobj.c b/dlls/mshtml/oleobj.c
index 7dffdbe..c488811 100644
--- a/dlls/mshtml/oleobj.c
+++ b/dlls/mshtml/oleobj.c
@@ -769,6 +769,9 @@ static HRESULT WINAPI DocObjOleObject_SetExtent(IOleObject *iface, DWORD dwDrawA
 
     TRACE("(%p)->(%ld %p)\n", This, dwDrawAspect, psizel);
 
+    /* A negative size is refused first, whatever the aspect is. */
+    if (psizel->cx < 0 || psizel->cy < 0)
+        return E_FAIL;
     if (dwDrawAspect != DVASPECT_CONTENT)
         return E_INVALIDARG;
 
diff --git a/dlls/mshtml/range.c b/dlls/mshtml/range.c
index b1b0aee..472fdad 100644
--- a/dlls/mshtml/range.c
+++ b/dlls/mshtml/range.c
@@ -1183,6 +1183,22 @@ static HRESULT WINAPI HTMLTxtRange_moveStart(IHTMLTxtRange *iface, BSTR Unit,
         break;
     }
 
+    case RU_WORD: {
+        rangepoint_t start;
+
+        get_start_point(This, &start);
+
+        #ifdef SG_MUTANT_MSHTML_NOWORDS
+        *ActualCount = 0;
+#else
+        *ActualCount = move_by_words(&start, Count);
+#endif
+
+        set_start_point(This, &start);
+        free_rangepoint(&start);
+        break;
+    }
+
     default:
         FIXME("unimplemented unit %s\n", debugstr_w(Unit));
         return E_NOTIMPL;
@@ -1221,6 +1237,18 @@ static HRESULT WINAPI HTMLTxtRange_moveEnd(IHTMLTxtRange *iface, BSTR Unit,
         break;
     }
 
+    case RU_WORD: {
+        rangepoint_t end;
+
+        get_end_point(This, &end);
+
+        *ActualCount = move_by_words(&end, Count);
+
+        set_end_point(This, &end);
+        free_rangepoint(&end);
+        break;
+    }
+
     default:
         FIXME("unimplemented unit %s\n", debugstr_w(Unit));
     }
diff --git a/dlls/mshtml/selection.c b/dlls/mshtml/selection.c
index 03d269d..e9e7156 100644
--- a/dlls/mshtml/selection.c
+++ b/dlls/mshtml/selection.c
@@ -108,15 +108,29 @@ static HRESULT WINAPI HTMLSelectionObject_createRange(IHTMLSelectionObject *ifac
 static HRESULT WINAPI HTMLSelectionObject_empty(IHTMLSelectionObject *iface)
 {
     HTMLSelectionObject *This = impl_from_IHTMLSelectionObject(iface);
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+    nsresult nsres;
+
+    TRACE("(%p)\n", This);
+
+    /* The selection is dropped; the content stays. */
+    if(!This->nsselection)
+        return S_OK;
+    nsres = nsISelection_RemoveAllRanges(This->nsselection);
+    return NS_SUCCEEDED(nsres) ? S_OK : E_FAIL;
 }
 
 static HRESULT WINAPI HTMLSelectionObject_clear(IHTMLSelectionObject *iface)
 {
     HTMLSelectionObject *This = impl_from_IHTMLSelectionObject(iface);
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+    nsresult nsres;
+
+    TRACE("(%p)\n", This);
+
+    /* The selected content is deleted. */
+    if(!This->nsselection)
+        return S_OK;
+    nsres = nsISelection_DeleteFromDocument(This->nsselection);
+    return NS_SUCCEEDED(nsres) ? S_OK : E_FAIL;
 }
 
 static HRESULT WINAPI HTMLSelectionObject_get_type(IHTMLSelectionObject *iface, BSTR *p)
