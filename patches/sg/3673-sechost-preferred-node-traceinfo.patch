diff --git a/dlls/sechost/trace.c b/dlls/sechost/trace.c
index e5b409f..b5695c3 100644
--- a/dlls/sechost/trace.c
+++ b/dlls/sechost/trace.c
@@ -657,13 +657,154 @@ ULONG WINAPI SgEnableTraceClassic( ULONG enable, ULONG flags, ULONG level, const
     return ERROR_SUCCESS;
 }
 
+/* session->reserved flags kept by TraceSetInformation */
+#define SG_ETW_FLAG_BINARY_TRACKING 0x1
+#define SG_ETW_FLAG_COMPRESSION     0x2
+
 /******************************************************************************
  *     TraceSetInformation   (sechost.@)
+ *
+ * Validation follows the documented error codes (ERROR_BAD_LENGTH for a
+ * length below the class minimum, ERROR_INVALID_PARAMETER, ERROR_NOT_SUPPORTED).
+ * The classes that configure kernel event capture (stack tracing, system
+ * enable flags, sampled profile, profile sources, PMC lists, periodic
+ * capture) are only meaningful for the kernel logger session; they are
+ * validated and accepted there, but Wine produces no kernel events for them
+ * to apply to (see ESCALATE.md).  The length/limit values are GUESSED from
+ * the documented structure sizes.
  */
 ULONG WINAPI TraceSetInformation( TRACEHANDLE handle, TRACE_INFO_CLASS class, void *info, ULONG len )
 {
-    FIXME("%s %d %p %ld: stub\n", wine_dbgstr_longlong(handle), class, info, len);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    struct sg_etw_session *session;
+    BOOL kernel_only = FALSE;
+    ULONG ret = ERROR_SUCCESS;
+
+    TRACE( "%s %d %p %ld\n", wine_dbgstr_longlong(handle), class, info, len );
+
+    if ((int)class < 0 || class >= MaxTraceSetInfoClass) return ERROR_INVALID_PARAMETER;
+
+    switch (class)
+    {
+    case TraceStackTracingInfo:
+        kernel_only = TRUE;
+        /* an array of CLASSIC_EVENT_ID (GUID, type, 7 reserved); length 0 disables */
+#ifndef SEC_MUT_LEN
+        if (len % (sizeof(GUID) + 8)) return ERROR_BAD_LENGTH;
+#endif
+        break;
+    case TraceSystemTraceEnableFlagsInfo:
+    case TraceProfileSourceConfigInfo:
+        kernel_only = TRUE;
+        if (len < sizeof(ULONG)) return ERROR_BAD_LENGTH;
+        if (len % sizeof(ULONG)) return ERROR_BAD_LENGTH;
+        break;
+    case TraceSampledProfileIntervalInfo:
+        kernel_only = TRUE;
+        if (len < 2 * sizeof(ULONG)) return ERROR_BAD_LENGTH;   /* TRACE_PROFILE_INTERVAL: Source, Interval */
+        break;
+    case TracePmcEventListInfo:
+    case TracePmcCounterListInfo:
+        kernel_only = TRUE;
+        if (len < sizeof(ULONG)) return ERROR_BAD_LENGTH;
+        break;
+    case TracePeriodicCaptureStateInfo:
+        kernel_only = TRUE;
+        if (len < 2 * sizeof(ULONG)) return ERROR_BAD_LENGTH;   /* frequency, provider count */
+        break;
+    case TraceProviderBinaryTracking:
+    case TraceCompressionInfo:
+        if (len < sizeof(BOOLEAN)) return ERROR_BAD_LENGTH;
+        break;
+    case TraceSetDisallowList:
+        if (len < sizeof(ULONG)) return ERROR_BAD_LENGTH;
+        break;
+    default:
+        /* the query-only classes */
+        return ERROR_NOT_SUPPORTED;
+    }
+    if (len && !info) return ERROR_INVALID_PARAMETER;
+
+    if (!map_shared()) return ERROR_WMI_INSTANCE_NOT_FOUND;
+    lock_shared();
+    if (!(session = find_session( handle, NULL )))
+    {
+        unlock_shared();
+        return ERROR_WMI_INSTANCE_NOT_FOUND;
+    }
+#ifdef SEC_MUT_KERNEL
+    if (0)
+#else
+    if (kernel_only && !IsEqualGUID( &session->guid, &SystemTraceControlGuid ))
+#endif
+        ret = ERROR_INVALID_PARAMETER;
+    else if (class == TraceProviderBinaryTracking)
+    {
+        if (*(BOOLEAN *)info) session->reserved |= SG_ETW_FLAG_BINARY_TRACKING;
+        else session->reserved &= ~SG_ETW_FLAG_BINARY_TRACKING;
+    }
+    else if (class == TraceCompressionInfo)
+    {
+#ifdef SEC_MUT_FLAGS
+        if (*(BOOLEAN *)info) session->reserved |= SG_ETW_FLAG_BINARY_TRACKING;
+#else
+        if (*(BOOLEAN *)info) session->reserved |= SG_ETW_FLAG_COMPRESSION;
+#endif
+        else session->reserved &= ~SG_ETW_FLAG_COMPRESSION;
+    }
+    unlock_shared();
+    return ret;
+}
+
+/******************************************************************************
+ *     TraceQueryInformation   (sechost.@)
+ */
+ULONG WINAPI TraceQueryInformation( TRACEHANDLE handle, TRACE_INFO_CLASS class, void *info, ULONG len, ULONG *ret_len )
+{
+    struct sg_etw_session *session;
+    ULONG size, flag;
+
+    TRACE( "%s %d %p %lu %p\n", wine_dbgstr_longlong(handle), class, info, len, ret_len );
+
+    switch (class)
+    {
+    case TraceMaxLoggersQuery:
+        if (ret_len) *ret_len = sizeof(ULONG);
+        if (!info || len < sizeof(ULONG)) return ERROR_BAD_LENGTH;
+        *(ULONG *)info = SG_ETW_MAX_SESSIONS;
+        return ERROR_SUCCESS;
+    case TraceVersionInfo:
+    {
+        struct { ULONG EtwTraceProcessingVersion; ULONG Reserved; } *version = info;
+        if (ret_len) *ret_len = sizeof(*version);
+        if (!info || len < sizeof(*version)) return ERROR_BAD_LENGTH;
+        version->EtwTraceProcessingVersion = 2;
+        version->Reserved = 0;
+        return ERROR_SUCCESS;
+    }
+    case TraceProviderBinaryTracking:
+    case TraceCompressionInfo:
+        size = sizeof(BOOLEAN);
+        flag = class == TraceProviderBinaryTracking ? SG_ETW_FLAG_BINARY_TRACKING : SG_ETW_FLAG_COMPRESSION;
+        break;
+    default:
+        return ERROR_NOT_SUPPORTED;
+    }
+    if (ret_len) *ret_len = size;
+    if (!info || len < size) return ERROR_BAD_LENGTH;
+    if (!map_shared()) return ERROR_WMI_INSTANCE_NOT_FOUND;
+    lock_shared();
+    if (!(session = find_session( handle, NULL )))
+    {
+        unlock_shared();
+        return ERROR_WMI_INSTANCE_NOT_FOUND;
+    }
+#ifdef SEC_MUT_QUERY
+    *(BOOLEAN *)info = 0;
+#else
+    *(BOOLEAN *)info = !!(session->reserved & flag);
+#endif
+    unlock_shared();
+    return ERROR_SUCCESS;
 }
 
 /* ---- consumers ---- */
diff --git a/include/wine/svcctl.idl b/include/wine/svcctl.idl
index e49d506..1341ea4 100644
--- a/include/wine/svcctl.idl
+++ b/include/wine/svcctl.idl
@@ -164,6 +164,11 @@ typedef struct _SERVICE_PRESHUTDOWN_INFO {
     DWORD dwPreshutdownTimeout;
 } SERVICE_PRESHUTDOWN_INFO,*LPSERVICE_PRESHUTDOWN_INFO;
 
+typedef struct _SERVICE_PREFERRED_NODE_INFO {
+    USHORT usPreferredNode;
+    BOOLEAN fDelete;
+} SERVICE_PREFERRED_NODE_INFO,*LPSERVICE_PREFERRED_NODE_INFO;
+
 typedef struct _SERVICE_LAUNCH_PROTECTED_INFO {
     DWORD dwLaunchProtected;
 } SERVICE_LAUNCH_PROTECTED_INFO,*PSERVICE_LAUNCH_PROTECTED_INFO;
@@ -177,6 +182,7 @@ typedef struct _SERVICE_LAUNCH_PROTECTED_INFO {
 #define SERVICE_CONFIG_PRESHUTDOWN_INFO         7
 #define SERVICE_CONFIG_TRIGGER_INFO             8
 #define SERVICE_CONFIG_LAUNCH_PROTECTED         12
+#define SERVICE_CONFIG_PREFERRED_NODE           9
 
 typedef struct _SERVICE_TRIGGER_SPECIFIC_DATA_ITEM {
     DWORD dwDataType;
@@ -313,6 +319,7 @@ typedef struct _SC_RPC_CONFIG_INFOW {
         [case(SERVICE_CONFIG_PRESHUTDOWN_INFO)] SERVICE_PRESHUTDOWN_INFO *preshutdown;
         [case(SERVICE_CONFIG_TRIGGER_INFO)] SERVICE_TRIGGER_INFO *trigger;
         [case(SERVICE_CONFIG_LAUNCH_PROTECTED)] SERVICE_LAUNCH_PROTECTED_INFO *launchprotected;
+        [case(SERVICE_CONFIG_PREFERRED_NODE)] SERVICE_PREFERRED_NODE_INFO *preferrednode;
     };
 } SC_RPC_CONFIG_INFOW;
 
diff --git a/programs/services/rpc.c b/programs/services/rpc.c
index 1898e77..87082cd 100644
--- a/programs/services/rpc.c
+++ b/programs/services/rpc.c
@@ -1108,6 +1108,8 @@ DWORD __cdecl svcctl_SetServiceStatus(SC_RPC_HANDLE handle, SERVICE_STATUS *stat
     return ERROR_SUCCESS;
 }
 
+BOOL WINAPI GetNumaHighestNodeNumber( ULONG *highest );
+
 DWORD __cdecl svcctl_ChangeServiceConfig2W( SC_RPC_HANDLE hService, SC_RPC_CONFIG_INFOW config )
 {
     struct sc_service_handle *service;
@@ -1188,6 +1190,40 @@ DWORD __cdecl svcctl_ChangeServiceConfig2W( SC_RPC_HANDLE hService, SC_RPC_CONFI
                                          config.launchprotected->dwLaunchProtected );
         service_unlock( service->service_entry );
         break;
+    case SERVICE_CONFIG_PREFERRED_NODE:
+    {
+        /* stored as the DWORD value PreferredNode of the service key; fDelete removes it */
+        const SERVICE_PREFERRED_NODE_INFO *info = config.preferrednode;
+        HKEY key;
+
+        if (!info) return ERROR_INVALID_PARAMETER;
+        if (!info->fDelete)
+        {
+            ULONG highest = 0;
+            GetNumaHighestNodeNumber( &highest );
+#ifndef SEC_MUT_NODE
+            if (info->usPreferredNode > highest) return ERROR_INVALID_PARAMETER;
+#endif
+        }
+        service_lock( service->service_entry );
+        if (info->fDelete)
+        {
+            err = RegOpenKeyExW( service->service_entry->db->root_key, service->service_entry->name, 0, KEY_SET_VALUE, &key );
+            if (!err)
+            {
+#ifdef SEC_MUT_DELETE
+                err = 0;
+#else
+                err = RegDeleteValueW( key, L"PreferredNode" );
+#endif
+                if (err == ERROR_FILE_NOT_FOUND) err = ERROR_SUCCESS;
+                RegCloseKey( key );
+            }
+        }
+        else err = set_service_dword_setting( service->service_entry, L"PreferredNode", info->usPreferredNode );
+        service_unlock( service->service_entry );
+        break;
+    }
     case SERVICE_CONFIG_PRESHUTDOWN_INFO:
         WINE_TRACE( "changing service %p preshutdown timeout to %ld\n",
                 service, config.preshutdown->dwPreshutdownTimeout );
@@ -1356,6 +1392,41 @@ DWORD __cdecl svcctl_QueryServiceConfig2W( SC_RPC_HANDLE hService, DWORD level,
         break;
     }
 
+    case SERVICE_CONFIG_PREFERRED_NODE:
+    {
+        SERVICE_PREFERRED_NODE_INFO *info = (SERVICE_PREFERRED_NODE_INFO *)buffer;
+        DWORD value = 0, vsize = sizeof(value), type;
+        HKEY key;
+
+        *needed = sizeof(*info);
+        if (size < sizeof(*info)) { err = ERROR_INSUFFICIENT_BUFFER; break; }
+        service_lock(service->service_entry);
+        err = RegOpenKeyExW(service->service_entry->db->root_key, service->service_entry->name, 0, KEY_READ, &key);
+        if (!err)
+        {
+            err = RegQueryValueExW(key, L"PreferredNode", NULL, &type, (BYTE *)&value, &vsize);
+            RegCloseKey(key);
+        }
+        service_unlock(service->service_entry);
+        if (err == ERROR_FILE_NOT_FOUND)
+        {
+            /* no preferred node set: reported as deleted */
+            info->usPreferredNode = 0;
+#ifdef SEC_MUT_UNSET
+            info->fDelete = FALSE;
+#else
+            info->fDelete = TRUE;
+#endif
+            err = ERROR_SUCCESS;
+        }
+        else if (!err)
+        {
+            info->usPreferredNode = type == REG_DWORD ? (USHORT)value : 0;
+            info->fDelete = FALSE;
+        }
+        break;
+    }
+
     case SERVICE_CONFIG_REQUIRED_PRIVILEGES_INFO:
         service_lock(service->service_entry);
         err = query_service_privileges(service->service_entry, buffer, size, needed);
