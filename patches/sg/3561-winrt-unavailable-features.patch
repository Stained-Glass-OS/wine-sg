From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] hvsim, perception, graphicscapture: unavailable-feature answers (3561)

hvsimanagementapi, windows.perception.stub, graphicscapture: consistent "not available" answers

The activation factories answer GetIids, GetRuntimeClassName and GetTrustLevel properly (no FIXME for
them any more) and DllGetClassObject no longer logs a fixme. IsolatedWindowsEnvironmentHost.HostErrors
returns a real read-only IVectorView (with IIterable) listing why the host is not ready;
HolographicSpace.IsAvailableChanged accepts handlers (availability never changes) and gives tokens;
SpatialSurfaceObserver.RequestAccessAsync completes with DeniedBySystem, as there is no holographic
service to give access.
---
--- a/include/windows.security.isolation.idl
+++ b/include/windows.security.isolation.idl
@@ -34,6 +34,8 @@
     runtimeclass IsolatedWindowsEnvironmentHost;
 
     declare {
+        interface Windows.Foundation.Collections.IIterable<Windows.Security.Isolation.IsolatedWindowsEnvironmentHostError>;
+        interface Windows.Foundation.Collections.IIterator<Windows.Security.Isolation.IsolatedWindowsEnvironmentHostError>;
         interface Windows.Foundation.Collections.IVectorView<Windows.Security.Isolation.IsolatedWindowsEnvironmentHostError>;
     }
 
--- a/dlls/hvsimanagementapi/host.c
+++ b/dlls/hvsimanagementapi/host.c
@@ -22,6 +22,310 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(hvsi);
 
+
+/* ---- HostErrors: a read-only list of the reasons the host cannot be used ---- */
+
+static const IsolatedWindowsEnvironmentHostError host_errors[] =
+{
+    IsolatedWindowsEnvironmentHostError_AdminPolicyIsDisabledOrNotPresent,
+};
+
+#define HOST_ERROR_COUNT ARRAY_SIZE(host_errors)
+
+struct errors_iterator
+{
+    IIterator_IsolatedWindowsEnvironmentHostError IIterator_iface;
+    LONG ref;
+    UINT32 pos;
+};
+
+static inline struct errors_iterator *impl_from_IIterator( IIterator_IsolatedWindowsEnvironmentHostError *iface )
+{
+    return CONTAINING_RECORD( iface, struct errors_iterator, IIterator_iface );
+}
+
+static HRESULT WINAPI iterator_QueryInterface( IIterator_IsolatedWindowsEnvironmentHostError *iface, REFIID iid, void **out )
+{
+    struct errors_iterator *impl = impl_from_IIterator( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterator_IsolatedWindowsEnvironmentHostError ))
+    {
+        IIterator_IsolatedWindowsEnvironmentHostError_AddRef( (*out = &impl->IIterator_iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI iterator_AddRef( IIterator_IsolatedWindowsEnvironmentHostError *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterator( iface )->ref );
+}
+
+static ULONG WINAPI iterator_Release( IIterator_IsolatedWindowsEnvironmentHostError *iface )
+{
+    struct errors_iterator *impl = impl_from_IIterator( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( IIterator_IsolatedWindowsEnvironmentHostError *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = IID_IIterator_IsolatedWindowsEnvironmentHostError;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetRuntimeClassName( IIterator_IsolatedWindowsEnvironmentHostError *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Foundation.Collections.IIterator`1<Windows.Security.Isolation.IsolatedWindowsEnvironmentHostError>";
+    return WindowsCreateString( class_name, ARRAY_SIZE(class_name) - 1, name );
+}
+
+static HRESULT WINAPI iterator_GetTrustLevel( IIterator_IsolatedWindowsEnvironmentHostError *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_get_Current( IIterator_IsolatedWindowsEnvironmentHostError *iface,
+                                            IsolatedWindowsEnvironmentHostError *value )
+{
+    struct errors_iterator *impl = impl_from_IIterator( iface );
+
+    if (!value) return E_POINTER;
+    if (impl->pos >= HOST_ERROR_COUNT)
+    {
+        *value = 0;
+        return E_BOUNDS;
+    }
+    *value = host_errors[impl->pos];
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( IIterator_IsolatedWindowsEnvironmentHostError *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_IIterator( iface )->pos < HOST_ERROR_COUNT;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( IIterator_IsolatedWindowsEnvironmentHostError *iface, boolean *value )
+{
+    struct errors_iterator *impl = impl_from_IIterator( iface );
+
+    if (!value) return E_POINTER;
+    if (impl->pos < HOST_ERROR_COUNT) impl->pos++;
+    *value = impl->pos < HOST_ERROR_COUNT;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetMany( IIterator_IsolatedWindowsEnvironmentHostError *iface, UINT32 size,
+                                        IsolatedWindowsEnvironmentHostError *items, UINT32 *copied )
+{
+    struct errors_iterator *impl = impl_from_IIterator( iface );
+    UINT32 n = 0;
+
+    if (!items || !copied) return E_POINTER;
+    while (n < size && impl->pos < HOST_ERROR_COUNT) items[n++] = host_errors[impl->pos++];
+    *copied = n;
+    return S_OK;
+}
+
+static const IIterator_IsolatedWindowsEnvironmentHostErrorVtbl iterator_vtbl =
+{
+    iterator_QueryInterface, iterator_AddRef, iterator_Release, iterator_GetIids, iterator_GetRuntimeClassName,
+    iterator_GetTrustLevel, iterator_get_Current, iterator_get_HasCurrent, iterator_MoveNext, iterator_GetMany,
