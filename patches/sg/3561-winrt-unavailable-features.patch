 WINE_DEFAULT_DEBUG_CHANNEL(perception);
 
+
+/* ---- completed async operation ---- */
+
+/* An IAsyncOperation<SpatialPerceptionAccessStatus*> that has already completed: the result is known when it is created. */
+
+struct done_op
+{
+    IAsyncOperation_SpatialPerceptionAccessStatus IAsyncOperation_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    INT32 value;
+    IAsyncOperationCompletedHandler_SpatialPerceptionAccessStatus *handler;
+    BOOL closed;
+};
+
+static inline struct done_op *impl_from_op( IAsyncOperation_SpatialPerceptionAccessStatus *iface )
+{
+    return CONTAINING_RECORD( iface, struct done_op, IAsyncOperation_iface );
+}
+
+static inline struct done_op *impl_from_info( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct done_op, IAsyncInfo_iface );
+}
+
+static HRESULT done_op_query_interface( struct done_op *op, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncOperation_SpatialPerceptionAccessStatus ))
+    {
+        IAsyncOperation_SpatialPerceptionAccessStatus_AddRef( (*out = &op->IAsyncOperation_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+    {
+        IAsyncInfo_AddRef( (*out = &op->IAsyncInfo_iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG done_op_add_ref( struct done_op *op )
+{
+    return InterlockedIncrement( &op->ref );
+}
+
+static ULONG done_op_release( struct done_op *op )
+{
+    ULONG ref = InterlockedDecrement( &op->ref );
+
+    if (!ref)
+    {
+        if (op->handler) IAsyncOperationCompletedHandler_SpatialPerceptionAccessStatus_Release( op->handler );
+        free( op );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI op_QueryInterface( IAsyncOperation_SpatialPerceptionAccessStatus *iface, REFIID iid, void **out )
+{
+    return done_op_query_interface( impl_from_op( iface ), iid, out );
+}
+
+static ULONG WINAPI op_AddRef( IAsyncOperation_SpatialPerceptionAccessStatus *iface )
+{
+    return done_op_add_ref( impl_from_op( iface ) );
+}
+
+static ULONG WINAPI op_Release( IAsyncOperation_SpatialPerceptionAccessStatus *iface )
+{
+    return done_op_release( impl_from_op( iface ) );
+}
+
+static HRESULT WINAPI op_GetIids( IAsyncOperation_SpatialPerceptionAccessStatus *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = IID_IAsyncOperation_SpatialPerceptionAccessStatus;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI op_GetRuntimeClassName( IAsyncOperation_SpatialPerceptionAccessStatus *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Foundation.IAsyncOperation`1<Windows.Perception.Spatial.SpatialPerceptionAccessStatus>";
+    return WindowsCreateString( class_name, ARRAY_SIZE(class_name) - 1, name );
+}
+
+static HRESULT WINAPI op_GetTrustLevel( IAsyncOperation_SpatialPerceptionAccessStatus *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI op_put_Completed( IAsyncOperation_SpatialPerceptionAccessStatus *iface, IAsyncOperationCompletedHandler_SpatialPerceptionAccessStatus *handler )
+{
+    struct done_op *op = impl_from_op( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (op->closed) return E_ILLEGAL_METHOD_CALL;
+    if (op->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
