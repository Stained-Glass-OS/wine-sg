+
+static HRESULT WINAPI view_IndexOf( IVectorView_IsolatedWindowsEnvironmentHostError *iface,
+                                    IsolatedWindowsEnvironmentHostError value, UINT32 *index, boolean *found )
+{
+    UINT32 i;
+
+    if (!index || !found) return E_POINTER;
+    *index = 0;
+    *found = FALSE;
+    for (i = 0; i < HOST_ERROR_COUNT; i++)
+    {
+        if (host_errors[i] != value) continue;
+        *index = i;
+        *found = TRUE;
+        break;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI view_GetMany( IVectorView_IsolatedWindowsEnvironmentHostError *iface, UINT32 start, UINT32 size,
