From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: font face and reference results recorded from Windows, alpha texture checks

Wine's dwrite conformance tests mark as todo_wine what Windows was seen to do;
done here, with the marks removed:
 - IDWriteFactory::CreateFontFace with DWRITE_FONT_FACE_TYPE_RAW_CFF is
   DWRITE_E_UNSUPPORTEDOPERATION, and with DWRITE_FONT_FACE_TYPE_UNKNOWN it makes a
   face of the type the file has.
 - IDWriteFontFaceReference::CreateFontFace for a reference whose face index is past
   the faces of the file is DWRITE_E_FILEFORMAT.
 - IDWriteFactory3::CreateFontFaceReference with a path needs the file to exist
   (DWRITE_E_FILENOTFOUND; a reference made of a font file object does not).
 - IDWriteGlyphRunAnalysis::CreateAlphaTexture answers a ClearType request on an
   aliased analysis with DWRITE_E_UNSUPPORTEDOPERATION before it looks at the size
   of the buffer.
The system font collection's GetFontSet no longer needs a todo mark either; its
reference counts still differ from Windows (the font set keeps the factory alive).
---
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -6698,6 +6698,12 @@ static HRESULT WINAPI glyphrunanalysis_CreateAlphaTexture(IDWriteGlyphRunAnalysi
     if (!bounds || !bitmap || (UINT32)type > DWRITE_TEXTURE_CLEARTYPE_3x1)
         return E_INVALIDARG;
 
+    /* a ClearType texture cannot be made of an aliased analysis, whatever the buffer is */
+#ifndef SG_MUTANT_DW_TEXTURE_SIZE_FIRST
+    if (type == DWRITE_TEXTURE_CLEARTYPE_3x1 && analysis->texture_type != type)
+        return DWRITE_E_UNSUPPORTEDOPERATION;
+#endif
+
     /* make sure buffer is large enough for requested texture type */
     required = (bounds->right - bounds->left) * (bounds->bottom - bounds->top);
     if (analysis->texture_type == DWRITE_TEXTURE_CLEARTYPE_3x1)
@@ -7299,6 +7305,12 @@ static HRESULT WINAPI fontfacereference_CreateFontFaceWithSimulations(IDWriteFon
     if (FAILED(hr))
         return hr;
 
+    /* a reference may name a face the file does not have */
+#ifndef SG_MUTANT_DW_REF_INDEX_UNCHECKED
+    if (is_supported && reference->index >= face_num)
+        return DWRITE_E_FILEFORMAT;
+#endif
+
     hr = IDWriteFactory7_CreateFontFace(reference->factory, face_type, 1, &reference->file, reference->index,
             simulations, &fontface);
     if (SUCCEEDED(hr))
--- a/dlls/dwrite/main.c
+++ b/dlls/dwrite/main.c
@@ -1035,7 +1035,19 @@ static HRESULT WINAPI dwritefactory_CreateFontFace(IDWriteFactory7 *iface, DWRIT
 
     *fontface = NULL;
 
+    /* raw CFF data can be described, but no face can be made of it */
+#ifdef SG_MUTANT_DW_RAWCFF_INVALIDARG
+    if (req_facetype == DWRITE_FONT_FACE_TYPE_RAW_CFF)
+        return E_INVALIDARG;
+#endif
+    if (req_facetype == DWRITE_FONT_FACE_TYPE_RAW_CFF)
+        return DWRITE_E_UNSUPPORTEDOPERATION;
+
+#ifdef SG_MUTANT_DW_UNKNOWN_REJECTED
     if (!is_face_type_supported(req_facetype))
+#else
+    if (req_facetype != DWRITE_FONT_FACE_TYPE_UNKNOWN && !is_face_type_supported(req_facetype))
+#endif
         return E_INVALIDARG;
 
     if (req_facetype != DWRITE_FONT_FACE_TYPE_OPENTYPE_COLLECTION && index)
@@ -1059,6 +1071,10 @@ static HRESULT WINAPI dwritefactory_CreateFontFace(IDWriteFactory7 *iface, DWRIT
         goto failed;
     }
 
+    /* an unknown type asks for the one the file has */
+    if (req_facetype == DWRITE_FONT_FACE_TYPE_UNKNOWN)
+        req_facetype = face_type;
+
     if (face_type != req_facetype) {
         hr = DWRITE_E_FILEFORMAT;
         goto failed;
@@ -1506,6 +1522,7 @@ static HRESULT WINAPI dwritefactory3_CreateFontFaceReference(IDWriteFactory7 *if
         FILETIME const *writetime, UINT32 index, DWRITE_FONT_SIMULATIONS simulations,
         IDWriteFontFaceReference **reference)
 {
+    IDWriteFontFileStream *stream;
     IDWriteFontFile *file;
     HRESULT hr;
 
@@ -1518,6 +1535,22 @@ static HRESULT WINAPI dwritefactory3_CreateFontFaceReference(IDWriteFactory7 *if
         return hr;
     }
 
+    /* the file has to be there, as opposed to a reference made of a file object */
+    hr = get_filestream_from_file(file, &stream);
+#ifdef SG_MUTANT_DW_REF_PATH_UNCHECKED
+    if (0)
+#else
+    if (FAILED(hr))
+#endif
+    {
+        IDWriteFontFile_Release(file);
+        *reference = NULL;
+        return hr == E_FAIL ? DWRITE_E_FILENOTFOUND : hr;
+    }
+#ifndef SG_MUTANT_DW_REF_PATH_UNCHECKED
+    IDWriteFontFileStream_Release(stream);
+#endif
+
     hr = create_fontfacereference(iface, file, index, simulations, NULL, 0, (IDWriteFontFaceReference1 **)reference);
     IDWriteFontFile_Release(file);
     return hr;
--- a/dlls/dwrite/tests/font.c
+++ b/dlls/dwrite/tests/font.c
@@ -1995,7 +1995,6 @@ static void test_CreateFontFace(void)
     ok(hr == DWRITE_E_FILEFORMAT || broken(hr == E_FAIL) /* < win10 */, "Unexpected hr %#lx.\n", hr);
 
     hr = IDWriteFactory_CreateFontFace(factory, DWRITE_FONT_FACE_TYPE_RAW_CFF, 1, &file, 0, DWRITE_FONT_SIMULATIONS_NONE, &fontface);
-    todo_wine
     ok(hr == DWRITE_E_UNSUPPORTEDOPERATION || broken(hr == E_INVALIDARG) /* older versions */, "Unexpected hr %#lx.\n", hr);
 
     fontface = (void*)0xdeadbeef;
@@ -2015,7 +2014,6 @@ static void test_CreateFontFace(void)
 
     fontface = NULL;
     hr = IDWriteFactory_CreateFontFace(factory, DWRITE_FONT_FACE_TYPE_UNKNOWN, 1, &file, 0, DWRITE_FONT_SIMULATIONS_NONE, &fontface);
-    todo_wine
     ok(hr == S_OK || broken(hr == E_INVALIDARG) /* < win10 */, "Unexpected hr %#lx.\n", hr);
     if (hr == S_OK) {
         ok(fontface != NULL, "got %p\n", fontface);
@@ -2605,7 +2603,6 @@ static void test_system_fontcollection(void)
         EXPECT_REF(collection1, 2);
         EXPECT_REF(factory, 2);
         hr = IDWriteFontCollection1_GetFontSet(collection1, &fontset);
-        todo_wine
         ok(hr == S_OK, "Failed to get fontset, hr %#lx.\n", hr);
     if (hr == S_OK) {
         EXPECT_REF(collection1, 2);
@@ -6039,7 +6036,6 @@ static void test_CreateGlyphRunAnalysis(void)
         ok(hr == DWRITE_E_UNSUPPORTEDOPERATION, "Unexpected hr %#lx.\n", hr);
 
         hr = IDWriteGlyphRunAnalysis_CreateAlphaTexture(analysis, DWRITE_TEXTURE_CLEARTYPE_3x1, &rect, bits, size - 1);
-        todo_wine
         ok(hr == DWRITE_E_UNSUPPORTEDOPERATION, "Unexpected hr %#lx.\n", hr);
 
         free(bits);
@@ -6120,7 +6116,6 @@ static void test_CreateGlyphRunAnalysis(void)
         ok(hr == DWRITE_E_UNSUPPORTEDOPERATION, "Unexpected hr %#lx.\n", hr);
 
         hr = IDWriteGlyphRunAnalysis_CreateAlphaTexture(analysis, DWRITE_TEXTURE_CLEARTYPE_3x1, &rect, bits, size - 1);
-        todo_wine
         ok(hr == DWRITE_E_UNSUPPORTEDOPERATION, "Unexpected hr %#lx.\n", hr);
 
         free(bits);
@@ -8033,14 +8028,12 @@ static void test_CreateFontFaceReference(void)
     IDWriteFontFile_Release(file);
 
     hr = IDWriteFontFaceReference_CreateFontFace(ref, &fontface);
-    todo_wine
     ok(hr == DWRITE_E_FILEFORMAT, "Unexpected hr %#lx.\n", hr);
 
     IDWriteFontFaceReference_Release(ref);
 
     /* path however has to be valid */
     hr = IDWriteFactory3_CreateFontFaceReference(factory, L"dummy", NULL, 0, DWRITE_FONT_SIMULATIONS_NONE, &ref);
-    todo_wine
     ok(hr == DWRITE_E_FILENOTFOUND, "Unexpected hr %#lx.\n", hr);
     if (hr == S_OK)
         IDWriteFontFaceReference_Release(ref);
