From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:18:47 -0700
Subject: [PATCH] shdocvw: SetQueryNetSessionCount is ieframe's (3234)

The session count is kept by ieframe; shdocvw's stub always returned 0.
Forward the export so both DLLs share one count.

diff --git a/dlls/shdocvw/shdocvw.spec b/dlls/shdocvw/shdocvw.spec
index aa1b5e0..9ced424 100644
--- a/dlls/shdocvw/shdocvw.spec
+++ b/dlls/shdocvw/shdocvw.spec
@@ -124,7 +124,7 @@
 @ stdcall InstallReg_RunDLL(long long str long)
 @ stdcall OpenURL(long long str long) ieframe.OpenURL
 @ stub SHGetIDispatchForFolder
-@ stdcall SetQueryNetSessionCount(long)
+@ stdcall SetQueryNetSessionCount(long) ieframe.SetQueryNetSessionCount
 @ stub SoftwareUpdateMessageBox
 @ stub URLQualifyA
 @ stub URLQualifyW
diff --git a/dlls/shdocvw/shdocvw_main.c b/dlls/shdocvw/shdocvw_main.c
index 84e257d..4b113b6 100644
--- a/dlls/shdocvw/shdocvw_main.c
+++ b/dlls/shdocvw/shdocvw_main.c
@@ -242,14 +242,7 @@ DWORD WINAPI RunInstallUninstallStubs2(int arg)
     return 0x0deadbee;
 }
 
-/***********************************************************************
- *              SetQueryNetSessionCount (SHDOCVW.@)
- */
-DWORD WINAPI SetQueryNetSessionCount(DWORD arg)
-{
-    FIXME("(%lu), stub!\n", arg);
-    return 0;
-}
+/* SetQueryNetSessionCount (SHDOCVW.@) is forwarded to ieframe, which counts the sessions (see shdocvw.spec) */
 
 /**********************************************************************
  * Some forwards (by ordinal) to SHLWAPI
