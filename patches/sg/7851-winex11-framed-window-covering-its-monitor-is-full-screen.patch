  *      sg_embed_message
  *
@@ -1378,6 +1541,10 @@ LRESULT sg_embed_message( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
         fixed = (e = find_hwnd( hwnd )) && (e->maximized || e->fullscreen);
         if (fixed) { child = e->child; fx = e->x; fy = e->y; fw = e->w; fh = e->h; }
         pthread_mutex_unlock( &embed_mutex );
+#ifndef SG_MUTANT_EMBED_NO_LEGACY_FS
+        /* sized to cover its monitor: full screen; sized back from that: windowed */
+        if (sg_embed_size_fullscreen( hwnd, (int)(wp & 0xffff), (int)((wp >> 16) & 0xffff) )) return 0;
+#endif
 #ifndef SG_MUTANT_EMBED_MAX_FOLLOWS
         /* and the program's window is put back to it, as a window manager
          * holds a maximized window to its size: GTK resizes its own for a
@@ -1412,9 +1579,6 @@ LRESULT sg_embed_message( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
         unsigned long count, remaining;
         unsigned char *prop = NULL;
         BOOL on = FALSE;
-        MONITORINFO mi = { sizeof(mi) };
-        LONG style;
-        RECT rect;
 
         X11DRV_expect_error( display, ignore_error, NULL );
         if (!XGetWindowProperty( display, child, fullscreen_atom( display ), 0, 1, False, XA_CARDINAL,
@@ -1422,40 +1586,7 @@ LRESULT sg_embed_message( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
             on = *(long *)prop != 0;
         if (prop) XFree( prop );
         sync_check_error( display );
-        pthread_mutex_lock( &embed_mutex );
-        e = find_hwnd( hwnd );
