From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: A framed Linux window sized to cover its monitor is full screen.

A game run by Linux Steam under Proton (Skyrim, David 2026-11-17) did not come up as a
full-screen game in its SgLinuxWindow frame. A window with no frame of its own sized to cover
its whole monitor, with no full-screen state asked, is that monitor's full-screen window -- as
a pop-up the size of its monitor is on Windows, and as X window managers take one (legacy full
screen; 7826 did it only for a window already so when framed). Its frame grew where it was
instead, off the screen and over the taskbar. Now the frame is made full screen (no title bar,
the monitor's size); sized back to less than its monitor, the window is windowed again, its
frame round the size and place it asked for. The place a framed program asks for is kept with
its size (it places its window in the screen's coordinates); none asked, its frame's monitor's
size alone decides.
---
diff --git a/dlls/winex11.drv/sg_embed.c b/dlls/winex11.drv/sg_embed.c
index 7a3041d..41b5225 100644
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -89,6 +89,9 @@ struct sg_embed
                            * ConfigureNotify from before that is stale */
     LONG     style;       /* ...and the frame's style and place before */
     RECT     rect;
+    BOOL     legacy_fs;   /* full screen because it covered its monitor (no state asked) */
+    BOOL     moved;       /* its last size came with a place it asked for: */
+    int      req_x, req_y; /* that place, in the screen's coordinates (the program's) */
 };
 
 static Atom fullscreen_atom( Display *display )
@@ -1209,6 +1212,166 @@ static void set_title( HWND hwnd, Display *display, Window child )
     send_message( hwnd, WM_SETTEXT, 0, (LPARAM)title );
 }
 
+/* the frame made full screen (the whole of its monitor, no frame) or put back; legacy: because
+ * the program's window covered its monitor, no full-screen state asked (sg_embed_size) */
+static void frame_fullscreen( HWND hwnd, BOOL on, BOOL legacy )
+{
+    struct sg_embed *e;
+    MONITORINFO mi = { sizeof(mi) };
+    LONG style;
+    RECT rect;
+
+    pthread_mutex_lock( &embed_mutex );
+    e = find_hwnd( hwnd );
+    if (e) e->fs_pending = FALSE;
+    if (!e || e->fullscreen == on) { pthread_mutex_unlock( &embed_mutex ); return; }
+    e->fullscreen = on;
+    e->legacy_fs = on && legacy;
+    if (on)
+    {
+        e->style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
+        NtUserGetWindowRect( hwnd, &e->rect, NtUserGetDpiForWindow( hwnd ) );
+    }
+    style = e->style;
+    rect = e->rect;
+    pthread_mutex_unlock( &embed_mutex );
+    if (on)
+    {
+        /* the whole of its monitor, no frame -- as a full-screen window */
+        NtUserGetMonitorInfo( NtUserMonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST ), &mi );
+#ifndef SG_MUTANT_EMBED_FS_MAXIMIZED
+        /* (not maximized either: a maximized pop-up is sized as one, not to its monitor, 7826;
+         * the saved style keeps it for the way back) */
+        NtUserSetWindowLong( hwnd, GWL_STYLE, (style & ~(WS_CAPTION | WS_THICKFRAME | WS_MAXIMIZE)) | WS_POPUP, FALSE );
+#else
+        NtUserSetWindowLong( hwnd, GWL_STYLE, (style & ~(WS_CAPTION | WS_THICKFRAME)) | WS_POPUP, FALSE );
+#endif
+        NtUserSetWindowPos( hwnd, HWND_TOP, mi.rcMonitor.left, mi.rcMonitor.top,
+                            mi.rcMonitor.right - mi.rcMonitor.left, mi.rcMonitor.bottom - mi.rcMonitor.top,
+                            SWP_FRAMECHANGED );
+    }
+    else
+    {
+        NtUserSetWindowLong( hwnd, GWL_STYLE, style, FALSE );
+        NtUserSetWindowPos( hwnd, 0, rect.left, rect.top, rect.right - rect.left,
+                            rect.bottom - rect.top, SWP_FRAMECHANGED | SWP_NOZORDER );
+    }
+}
+
+/* Stained Glass OS (wine-sg 7851): a window with no frame of its own sized to cover its whole
+ * monitor is that monitor's full-screen window -- as a pop-up the size of its monitor is on
+ * Windows, and as X window managers take one ("legacy full screen", 7826 for a window framed
+ * so): a game under Wine or Proton that goes full screen by sizing its window to the screen,
+ * asking no full-screen state, had its frame grown where it was, off the screen and over the
+ * taskbar (David 2026-11-17, Skyrim from Linux Steam). Sized back to less than its monitor, it
+ * is windowed again, its frame round the size (and place) it asked for. TRUE: done. */
+static BOOL sg_embed_size_fullscreen( HWND hwnd, int nw, int nh )
+{
+    Display *display = NULL;
+    Window child = 0;
+    struct x11drv_win_data *data;
+    struct sg_embed *e;
+    MONITORINFO mi = { sizeof(mi) };
+    HMONITOR mon;
+    BOOL moved = FALSE, legacy = FALSE, fullscreen = FALSE, covers, own;
+    int rx = 0, ry = 0, ox = 0, oy = 0;
+    RECT r, frame;
+    POINT pt;
+
+    if (nw <= 0 || nh <= 0) return FALSE;
+    if (!(data = get_win_data( hwnd ))) return FALSE;
+    frame = data->rects.window;
+    pthread_mutex_lock( &embed_mutex );
+    if ((e = find_hwnd( hwnd )) && e->display == data->display)
+    {
+        display = e->display;
+        child = e->child;
+        moved = e->moved;
+        rx = e->req_x;
+        ry = e->req_y;
+        legacy = e->legacy_fs;
+        fullscreen = e->fullscreen || e->fs_pending;
+        ox = data->rects.visible.left + e->x;   /* where its window is on the screen */
+        oy = data->rects.visible.top + e->y;
+    }
+    pthread_mutex_unlock( &embed_mutex );
+    release_win_data( data );
+    if (!e) return FALSE;
+
+    if (moved)
+    {
+        pt = root_to_virtual_screen( rx, ry );
+        rx = pt.x;
+        ry = pt.y;
+    }
+    else
+    {
+        rx = ox;
+        ry = oy;
+    }
+    SetRect( &r, rx, ry, rx + nw, ry + nh );
+    if (moved)
+    {
+        mon = NtUserMonitorFromRect( &r, MONITOR_DEFAULTTONULL );
+        covers = mon && NtUserGetMonitorInfo( mon, &mi ) && EqualRect( &mi.rcMonitor, &r );
+    }
+    else
+    {
+        /* no place asked -- or the place where we keep it, its frame's corner, which the screen's
+         * corner (0,0) also is in its own frame: its frame's monitor's size */
+        mon = NtUserMonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST );
+        covers = mon && NtUserGetMonitorInfo( mon, &mi ) && nw == mi.rcMonitor.right - mi.rcMonitor.left &&
+                 nh == mi.rcMonitor.bottom - mi.rcMonitor.top;
+    }
+    TRACE( "%p: %dx%d at %s (asked %d): covers %d, full screen %d (legacy %d)\n", hwnd, nw, nh,
+           wine_dbgstr_rect( &r ), moved, covers, fullscreen, legacy );
+
+    if (covers && !fullscreen)
+    {
+        long on = 1;
+        own = draws_own_frame( display, child ) || fixed_size( display, child );
+        if (own)
+        {
+            X11DRV_expect_error( display, ignore_error, NULL );
+            XChangeProperty( display, child, fullscreen_atom( display ), XA_CARDINAL, 32, PropModeReplace,
+                             (unsigned char *)&on, 1 );
+            sync_check_error( display );
+        }
+        if (!own) return FALSE;
+        frame_fullscreen( hwnd, TRUE, TRUE );
+        return TRUE;
+    }
+    if (!covers && fullscreen && legacy)
+    {
+        long off = 0;
+        int cw, ch;
+        X11DRV_expect_error( display, ignore_error, NULL );
+        XChangeProperty( display, child, fullscreen_atom( display ), XA_CARDINAL, 32, PropModeReplace,
+                         (unsigned char *)&off, 1 );
+        sync_check_error( display );
+        frame_fullscreen( hwnd, FALSE, FALSE );
+        /* the frame as it was, then round the size (and at the place) it asked for */
+        if (!(data = get_win_data( hwnd ))) return TRUE;
+        frame = data->rects.window;
+        pthread_mutex_lock( &embed_mutex );
+        if ((e = find_hwnd( hwnd )))
+        {
+            ox = data->rects.visible.left + e->x;
+            oy = data->rects.visible.top + e->y;
+            cw = e->w;
+            ch = e->h;
+        }
+        pthread_mutex_unlock( &embed_mutex );
+        release_win_data( data );
+        if (!e) return TRUE;
+        if (moved) OffsetRect( &frame, rx - ox, ry - oy );
+        NtUserSetWindowPos( hwnd, 0, frame.left, frame.top, frame.right - frame.left + nw - cw,
+                            frame.bottom - frame.top + nh - ch, SWP_NOZORDER | SWP_NOACTIVATE );
+        return TRUE;
+    }
+    return FALSE;
+}
+
