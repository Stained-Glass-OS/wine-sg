-            /* the whole of its monitor, no frame -- as a full-screen window */
-            NtUserGetMonitorInfo( NtUserMonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST ), &mi );
-#ifndef SG_MUTANT_EMBED_FS_MAXIMIZED
-            /* (not maximized either: a maximized pop-up is sized as one, not to its monitor, 7826;
-             * the saved style keeps it for the way back) */
-            NtUserSetWindowLong( hwnd, GWL_STYLE, (style & ~(WS_CAPTION | WS_THICKFRAME | WS_MAXIMIZE)) | WS_POPUP, FALSE );
-#else
-            NtUserSetWindowLong( hwnd, GWL_STYLE, (style & ~(WS_CAPTION | WS_THICKFRAME)) | WS_POPUP, FALSE );
-#endif
-            NtUserSetWindowPos( hwnd, HWND_TOP, mi.rcMonitor.left, mi.rcMonitor.top,
-                                mi.rcMonitor.right - mi.rcMonitor.left, mi.rcMonitor.bottom - mi.rcMonitor.top,
-                                SWP_FRAMECHANGED );
-        }
-        else
-        {
-            NtUserSetWindowLong( hwnd, GWL_STYLE, style, FALSE );
-            NtUserSetWindowPos( hwnd, 0, rect.left, rect.top, rect.right - rect.left,
-                                rect.bottom - rect.top, SWP_FRAMECHANGED | SWP_NOZORDER );
-        }
+        frame_fullscreen( hwnd, on, FALSE );
         return 0;
     }
     case WM_X11DRV_SG_EMBED_MAXIMIZE:
@@ -1660,6 +1791,22 @@ BOOL sg_embed_event( Display *display, XEvent *event )
             XMoveWindow( display, event->xany.window, ex, ey );
             sync_check_error( display );
         }
+#ifndef SG_MUTANT_EMBED_NO_LEGACY_FS
+        if (!stale && (event->xconfigure.width != ew || event->xconfigure.height != eh))
+        {
+            /* the place it asked for with the size: it sizes and places its window in the
+             * screen's coordinates (it does not know it is framed); left where we keep it,
+             * it asked for no place */
+            pthread_mutex_lock( &embed_mutex );
+            if ((e = find_child( display, event->xany.window )))
+            {
+                e->moved = event->xconfigure.x != ex || event->xconfigure.y != ey;
+                e->req_x = event->xconfigure.x;
+                e->req_y = event->xconfigure.y;
+            }
+            pthread_mutex_unlock( &embed_mutex );
+        }
+#endif
         if (!stale && (event->xconfigure.width != ew || event->xconfigure.height != eh))
             NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_SIZE,
                                (WPARAM)(event->xconfigure.width | event->xconfigure.height << 16),
