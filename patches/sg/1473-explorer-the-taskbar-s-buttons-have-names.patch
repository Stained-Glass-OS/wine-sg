From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the taskbar's buttons have names

The taskbar's buttons are owner drawn and had no window text, so UI
Automation and a screen reader read each as a nameless "button". Each
now carries its name as its window text, set when it paints and only
when it changed: Start, Search, Task View, a pinned program's name, a
program's window title.

Gate: test/uiaview-gate.sh. Mutant: SG_MUTANT_TASKBAR_NAMELESS.
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -3239,8 +3239,44 @@
     }
 }
 
+/* Stained Glass OS (wine-sg 1473): a taskbar button's name, as its window
+ * text -- what UI Automation and a screen reader read for it (Start, Search,
+ * Task View, a pinned program, a window's title). The buttons are owner
+ * drawn and had none: each read as a nameless "button". Set when it
+ * changes; setting it repaints the button, which comes here again. */
+static void sg_name_taskbar_button( const DRAWITEMSTRUCT *dis )
+{
+    static BOOL naming;
+    struct taskbar_button *win;
+    WCHAR name[256] = L"", old[256];
+
+    if (naming) return;
+    if (dis->CtlID == SG_SEARCH_ID) lstrcpyW( name, L"Search" );
+    else if (dis->CtlID == SG_TASKVIEW_ID) lstrcpyW( name, L"Task View" );
+    else if (dis->CtlID >= SG_PIN_FIRST && dis->CtlID < SG_PIN_FIRST + SG_PIN_MAX)
+    {
+        if (dis->CtlID - SG_PIN_FIRST < sg_npins) lstrcpynW( name, sg_pins[dis->CtlID - SG_PIN_FIRST].name, ARRAY_SIZE(name) );
+    }
+    else if ((win = find_taskbar_button( LongToHandle( dis->CtlID ))))
+    {
+        if (!win->hwnd) lstrcpynW( name, start_label, ARRAY_SIZE(name) );
+        else if (win->elevated) InternalGetWindowText( win->hwnd, name, ARRAY_SIZE(name) );
+        else GetWindowTextW( win->hwnd, name, ARRAY_SIZE(name) );
+    }
+    else return;
+    GetWindowTextW( dis->hwndItem, old, ARRAY_SIZE(old) );
+    if (!wcscmp( old, name )) return;
+    naming = TRUE;
+    SetWindowTextW( dis->hwndItem, name );
+    naming = FALSE;
+}
+
 static void paint_taskbar_button( const DRAWITEMSTRUCT *dis )
 {
+#ifndef SG_MUTANT_TASKBAR_NAMELESS
+    sg_name_taskbar_button( dis );
+#endif
+
     RECT rect;
     struct taskbar_button *win;
     COLORREF bg = SG_COL_BAR;
