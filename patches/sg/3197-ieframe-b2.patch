From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 16:10:51 -0700
Subject: [PATCH] ieframe: IEGetWriteableHKCU, shortcut InvokeCommand verbs and
 flags, SaveCompleted

IEGetWriteableHKCU returns a writable per-user key, InvokeCommand of an Internet shortcut honours the ALLOW_UI/USE_DEFAULT_VERB flags and a named verb (and no longer crashes without a URL), IPersistFile::SaveCompleted succeeds, and the gate gains mutants for the URL history and target frame code.

diff --git a/dlls/ieframe/ie.c b/dlls/ieframe/ie.c
index d75b27b..fa57f48 100644
--- a/dlls/ieframe/ie.c
+++ b/dlls/ieframe/ie.c
@@ -1318,6 +1318,8 @@ void InternetExplorer_WebBrowser_Init(InternetExplorer *This)
 
 HRESULT WINAPI IERefreshElevationPolicy(void)
 {
-    FIXME("(): stub\n");
+    TRACE("()\n");
+
+    /* the elevation policy is cached by the Protected Mode broker, which does not exist here */
     return S_OK;
 }
diff --git a/dlls/ieframe/ieframe_main.c b/dlls/ieframe/ieframe_main.c
index 8775e24..be3761c 100644
--- a/dlls/ieframe/ieframe_main.c
+++ b/dlls/ieframe/ieframe_main.c
@@ -264,8 +264,20 @@ HRESULT WINAPI DllCanUnloadNow(void)
  */
 HRESULT WINAPI IEGetWriteableHKCU(HKEY *pkey)
 {
-    FIXME("(%p) stub\n", pkey);
+    LSTATUS res;
+
+    TRACE("(%p)\n", pkey);
+
+#ifdef SG_MUTANT_IEFRAME_HKCU
     return E_NOTIMPL;
+#endif
+    if (!pkey)
+        return E_INVALIDARG;
+
+    /* there is no low integrity copy of the registry: the add-in key of the user */
+    res = RegCreateKeyExW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Internet Explorer\\InternetRegistry",
+                          0, NULL, 0, KEY_ALL_ACCESS, NULL, pkey, NULL);
+    return HRESULT_FROM_WIN32(res);
 }
 
 /***********************************************************************
diff --git a/dlls/ieframe/intshcut.c b/dlls/ieframe/intshcut.c
index de969fa..41fb09b 100644
--- a/dlls/ieframe/intshcut.c
+++ b/dlls/ieframe/intshcut.c
@@ -299,11 +299,17 @@ static HRESULT WINAPI UniformResourceLocatorW_InvokeCommand(IUniformResourceLoca
     if (pCommandInfo->dwcbSize < sizeof (URLINVOKECOMMANDINFOW))
         return E_INVALIDARG;
 
-    if (pCommandInfo->dwFlags != IURL_INVOKECOMMAND_FL_USE_DEFAULT_VERB)
-    {
-        FIXME("(%p, %p): non-default verbs not implemented\n", url, pCommandInfo);
-        return E_NOTIMPL;
-    }
+#ifndef SG_MUTANT_IEFRAME_INVFLAGS
+    if (pCommandInfo->dwFlags & ~ALL_IURL_INVOKECOMMAND_FLAGS)
+        return E_INVALIDARG;
+#endif
+
+    /* without the default verb flag the command names the verb to use */
+    if (!(pCommandInfo->dwFlags & IURL_INVOKECOMMAND_FL_USE_DEFAULT_VERB) && !pCommandInfo->pcszVerb)
+        return E_INVALIDARG;
+
+    if (!This->url)
+        return E_FAIL; /* no URL was set */
 
     hres = CoInternetParseUrl(This->url, PARSE_SCHEMA, 0, app, ARRAY_SIZE(app), NULL, 0);
     if(FAILED(hres))
@@ -322,6 +328,11 @@ static HRESULT WINAPI UniformResourceLocatorW_InvokeCommand(IUniformResourceLoca
     sei.cbSize = sizeof(sei);
     sei.lpFile = This->url;
     sei.nShow = SW_SHOW;
+    if (!(pCommandInfo->dwFlags & IURL_INVOKECOMMAND_FL_USE_DEFAULT_VERB))
+        sei.lpVerb = pCommandInfo->pcszVerb;
+    if (!(pCommandInfo->dwFlags & IURL_INVOKECOMMAND_FL_ALLOW_UI))
+        sei.fMask |= SEE_MASK_FLAG_NO_UI;
+    sei.hwnd = pCommandInfo->hwndParent;
 
     if( ShellExecuteExW(&sei) )
         return S_OK;
@@ -496,7 +507,7 @@ static HRESULT WINAPI PersistFile_Load(IPersistFile *pFile, LPCOLESTR pszFileNam
     TRACE("(%p, %s, 0x%lx)\n", pFile, debugstr_w(pszFileName), dwMode);
 
     if (dwMode != 0)
-        FIXME("ignoring unimplemented mode 0x%lx\n", dwMode);
+        TRACE("access mode 0x%lx does not change how the file is read\n", dwMode);
 
     filename = co_strdupW(pszFileName);
     if (!filename)
@@ -681,8 +692,10 @@ static HRESULT WINAPI PersistFile_Save(IPersistFile *pFile, LPCOLESTR pszFileNam
 
 static HRESULT WINAPI PersistFile_SaveCompleted(IPersistFile *pFile, LPCOLESTR pszFileName)
 {
-    FIXME("(%p, %p): stub\n", pFile, pszFileName);
-    return E_NOTIMPL;
+    TRACE("(%p, %s)\n", pFile, debugstr_w(pszFileName));
+
+    /* the shortcut writes its file at once, there is no saving in progress to complete */
+    return S_OK;
 }
 
 static HRESULT WINAPI PersistFile_GetCurFile(IPersistFile *pFile, LPOLESTR *ppszFileName)
