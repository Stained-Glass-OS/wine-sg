@@ -426,6 +433,9 @@ static HRESULT WINAPI UrlHistoryStg_EnumUrls(IUrlHistoryStg2 *iface, IEnumSTATUR
     if(find)
         FindCloseUrlCache(find);
 
+#ifdef SG_MUTANT_IEFRAME_HISTENUM
+    count = 0;
+#endif
     hres = create_enum_staturl(items, count, ppEnum);
     for(i = 0; i < count; i++)
         CoTaskMemFree(items[i].pwcsUrl);
