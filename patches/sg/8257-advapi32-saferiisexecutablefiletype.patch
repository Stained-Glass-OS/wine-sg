From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: SaferiIsExecutableFileType

SaferiIsExecutableFileType says whether a file name's extension is a designated executable file type: the Software Restriction Policies' ExecutableTypes list when a policy sets one, else Windows' default list; with bFromShellExecute .exe is left out. It was not exported (every Temurin and Corretto JDK's awt.dll imports it). winsafer.h gains it.
---
--- a/include/winsafer.h
+++ b/include/winsafer.h
@@ -103,6 +103,7 @@
 WINADVAPI BOOL WINAPI SaferGetPolicyInformation(DWORD,SAFER_POLICY_INFO_CLASS,DWORD,PVOID,PDWORD,LPVOID);
 WINADVAPI BOOL WINAPI SaferIdentifyLevel(DWORD,PSAFER_CODE_PROPERTIES,SAFER_LEVEL_HANDLE*,LPVOID);
 WINADVAPI BOOL WINAPI SaferSetLevelInformation(SAFER_LEVEL_HANDLE,SAFER_OBJECT_INFO_CLASS,LPVOID,DWORD);
+WINADVAPI BOOL WINAPI SaferiIsExecutableFileType(LPCWSTR,BOOLEAN);
 
 #ifdef __cplusplus
 }
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -4951,6 +4951,49 @@
     return TRUE;
 }
 
+#ifndef SG_MUTANT_NO_SAFERI_EXEC
+/******************************************************************************
+ * SaferiIsExecutableFileType   [ADVAPI32.@]
+ *
+ * (wine-sg 8257) Whether a file name's extension is one of the designated executable file types (the Software
+ * Restriction Policies' ExecutableTypes list, or the default list when no policy sets one); with
+ * from_shell_execute, .exe is left out.
+ */
+BOOL WINAPI SaferiIsExecutableFileType( const WCHAR *path, BOOLEAN from_shell_execute )
+{
+    /* Windows' default designated file types, and the examples the documentation adds (JS, PL, VBS) */
+    static const WCHAR defaults[] = L"ADE\0ADP\0BAS\0BAT\0CHM\0CMD\0COM\0CPL\0CRT\0EXE\0HLP\0HTA\0INF\0INS\0ISP\0"
+                                    L"LNK\0MDB\0MDE\0MSC\0MSI\0MSP\0MST\0OCX\0PCD\0PIF\0REG\0SCR\0SHS\0URL\0VB\0WSC\0"
+                                    L"JS\0PL\0VBS\0";
+    WCHAR *list = NULL;
+    const WCHAR *ext, *type;
+    DWORD size = 0;
+    BOOL ret = FALSE;
+
+    TRACE( "%s, %u\n", debugstr_w(path), from_shell_execute );
+
+    if (!path || !*path || !(ext = wcsrchr( path, '.' )) || wcschr( ext, '\\' ) || !ext[1]) return FALSE;
+    ext++;
+    if (from_shell_execute && !wcsicmp( ext, L"exe" )) return FALSE;
+
+    if (!RegGetValueW( HKEY_LOCAL_MACHINE, L"Software\\Policies\\Microsoft\\Windows\\Safer\\CodeIdentifiers",
+                       L"ExecutableTypes", RRF_RT_REG_MULTI_SZ, NULL, NULL, &size ) && size > sizeof(WCHAR) &&
+        (list = malloc( size )) &&
+        RegGetValueW( HKEY_LOCAL_MACHINE, L"Software\\Policies\\Microsoft\\Windows\\Safer\\CodeIdentifiers",
+                      L"ExecutableTypes", RRF_RT_REG_MULTI_SZ, NULL, list, &size ))
+    {
+        free( list );
+        list = NULL;
+    }
+    for (type = list ? list : defaults; *type; type += wcslen( type ) + 1)
+        if (!wcsicmp( type, ext )) { ret = TRUE; break; }
+    free( list );
+    return ret;
+}
+#else
+BOOL WINAPI SaferiIsExecutableFileType( const WCHAR *path, BOOLEAN from_shell_execute ) { return FALSE; }
+#endif
+
 /******************************************************************************
  * SaferIdentifyLevel   [ADVAPI32.@]
  */
--- a/dlls/advapi32/advapi32.spec
+++ b/dlls/advapi32/advapi32.spec
@@ -726,7 +726,7 @@
 # @ stub SaferiChangeRegistryScope
 # @ stub SaferiCompareTokenLevels
 # @ stub SaferiIsDllAllowed
-# @ stub SaferiIsExecutableFileType
+@ stdcall SaferiIsExecutableFileType(wstr long)
 # @ stub SaferiPopulateDefaultsInRegistry
 # @ stub SaferiRecordEventLogEntry
 # @ stub SaferiReplaceProcessThreadTokens
