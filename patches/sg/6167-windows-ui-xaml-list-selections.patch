+static BOOL sel_fit( struct items_control *items, UINT32 n )
+{
+    BYTE *sel;
+
+    if (n <= items->sel_size) return TRUE;
+    if (!(sel = realloc( items->sel, n ))) return FALSE;
+    memset( sel + items->sel_size, 0, n - items->sel_size );
+    items->sel = sel;
+    items->sel_size = n;
