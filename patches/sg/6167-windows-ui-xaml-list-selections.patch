+        items->orientation = xunbox_enum( box, &IID_IReference_Orientation, 0 ) == 1 ? 1 : 0;
+#ifdef SG_MUTANT_ITEMS_ALWAYS_VERTICAL
+        items->orientation = 0;
+#endif
+        if (box) IInspectable_Release( box );
+    }
+    IInspectable_Release( content );
+    return items->orientation;
