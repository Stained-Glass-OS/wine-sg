+/* after a change from before: SelectedIndex/SelectedItem the first selected, SelectedItems again
+ * (unless the change came from it), SelectionChanged with the items added and removed */
+static void selection_commit( struct items_control *items, const BYTE *before, UINT32 before_size, BOOL from_vector )
+{
+    IInspectable **list, *item = NULL, *sender = NULL;
+    UINT32 i, n = get_items( items, &list );
+    struct changed_args *args = NULL;
+    INT32 first = -1;
+    BOOL any = FALSE;
+
+    sel_fit( items, n );
+    for (i = 0; i < n && first < 0; i++) if (items->sel[i]) first = i;
+    if (first >= 0 && (item = list[first])) IInspectable_AddRef( item );
+    if (items->selected_item) IInspectable_Release( items->selected_item );
+    items->selected_item = item;
+    items->selected_index = first;
+    if (!from_vector && items->selected_items)
+    {
+        IInspectable *vector = xvector_iface( items->selected_items );
+        items->syncing = TRUE;
+        ((HRESULT (WINAPI *)( IInspectable * ))((void **)vector->lpVtbl)[15])( vector );   /* Clear */
+        for (i = 0; i < n; i++) if (items->sel[i]) vector_call( vector, 13, list[i] );     /* Append */
+        items->syncing = FALSE;
+    }
+    if (!list_empty( &items->selection_changed.entries ) && (args = calloc( 1, sizeof(*args) )))
+    {
+        args->iface.vtbl = changed_args_vtbl;
+        xvector_create( &changed_type, NULL, &args->added );
+        xvector_create( &changed_type, NULL, &args->removed );
+        xobj_init( &args->obj, &changed_args_class, NULL );
+    }
+    for (i = 0; i < n; i++)
+    {
+        BOOL was = i < before_size && before[i], now = items->sel[i];
+        if (was == now) continue;
+        any = TRUE;
+        if (args && args->added && args->removed) vector_call( xvector_iface( now ? args->added : args->removed ), 13, list[i] );
+    }
+    free_items( list, n );
+    if (any) xaml_invalidate_visuals();
+    if (args && any && SUCCEEDED(IUnknown_QueryInterface( items->c.e.d.obj.outer, &IID_IInspectable, (void **)&sender )))
+    {
+        TRACE( "%p: selection changed, first %d\n", items, first );
+        xaml_raise_routed( &items->selection_changed, sender, (IInspectable *)&args->iface );
+        IInspectable_Release( sender );
+    }
+    if (args) IInspectable_Release( (IInspectable *)&args->iface );
+}
+
+static HRESULT selection_set( struct items_control *items, INT32 index, enum select_how how )
+{
+    IInspectable **list;
+    UINT32 n = get_items( items, &list ), i;
+    BYTE *before;
+    INT32 lo, hi;
+
+    free_items( list, n );
+    if (index < -1 || (index >= 0 && (UINT32)index >= n)) return E_INVALIDARG;
+    if (!sel_fit( items, n ) || !(before = malloc( max( items->sel_size, 1 ) ))) return E_OUTOFMEMORY;
+    memcpy( before, items->sel, items->sel_size );
+#ifdef SG_MUTANT_LIST_SINGLE_ONLY
+    how = SELECT_ONLY;
+#endif
+    switch (how)
+    {
+    case SELECT_TOGGLE:
+        if (index >= 0) items->sel[index] = !items->sel[index];
+        items->anchor = index;
+        break;
+    case SELECT_RANGE:
+    case SELECT_RANGE_ADD:
+        if (how == SELECT_RANGE) memset( items->sel, 0, items->sel_size );
+        lo = items->anchor >= 0 ? min( items->anchor, index ) : index;
+        hi = items->anchor >= 0 ? max( items->anchor, index ) : index;
+        for (i = max( lo, 0 ); (INT32)i <= hi && i < n; i++) items->sel[i] = 1;
+        break;
+    default:
+        memset( items->sel, 0, items->sel_size );
+        if (index >= 0) items->sel[index] = 1;
+        items->anchor = index;
+        break;
+    }
+    selection_commit( items, before, items->sel_size, FALSE );
+    free( before );
+    return S_OK;
+}
