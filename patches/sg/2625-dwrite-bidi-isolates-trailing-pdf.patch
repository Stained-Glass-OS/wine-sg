From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: bidi analysis without isolates, trailing embedding code keeps its level

Ground truth from Wine's analyzer tests (todo_wine bidi cases):
 - The text analyzer does not know the isolate formatting characters of Unicode 6.3
   (LRI, RLI, FSI, PDI): they are neutral characters, and text between them is not
   embedded.
 - An embedding code that ends the text (a PDF) keeps the level of the embedding it
   closes instead of getting the base level back through the rule for trailing white
   space.
The three todo markers of the tests are removed.
---
--- a/dlls/dwrite/bidi.c
+++ b/dlls/dwrite/bidi.c
@@ -920,7 +920,12 @@ static void bidi_resolve_resolved(struct bidi_char *chars, unsigned int count, U
                 ;
         }
 
+        /* the end of the text does not give back the level of an embedding that was not closed */
+#ifdef SG_MUTANT_DW_BIDI_TRAILING_PDF
         if (i == eos && is_rule_L1_reset_class(chars[i].nominal_bidi_class))
+#else
+        if (i == eos && is_rule_L1_reset_class(chars[i].nominal_bidi_class) && chars[i].nominal_bidi_class != PDF)
+#endif
         {
             int j = i;
             while (j >= sos && is_rule_L1_reset_class(chars[j].nominal_bidi_class))
@@ -1075,6 +1080,20 @@ HRESULT bidi_computelevels(struct bidi_char *chars, unsigned int count, UINT8 ba
 
     if (TRACE_ON(bidi)) bidi_dump_types("start ", chars, 0, count);
 
+    /* The isolate formatting characters of Unicode 6.3 are not known to the analyzer:
+     * they are neutral characters. */
+#ifndef SG_MUTANT_DW_BIDI_ISOLATES
+    {
+        unsigned int k;
+
+        for (k = 0; k < count; ++k)
+        {
+            if (bidi_is_isolate(chars[k].bidi_class))
+                chars[k].bidi_class = chars[k].nominal_bidi_class = ON;
+        }
+    }
+#endif
+
     bidi_resolve_explicit(chars, count, baselevel);
 
     if (TRACE_ON(bidi)) bidi_dump_types("after explicit", chars, 0, count);
--- a/dlls/dwrite/tests/analyzer.c
+++ b/dlls/dwrite/tests/analyzer.c
@@ -2734,22 +2734,19 @@ static const struct bidi_test bidi_tests[] = {
       { LRE, 'a', 'b', PDF, 0 },
       DWRITE_READING_DIRECTION_LEFT_TO_RIGHT,
       { 2, 2, 2, 2 },
-      { 0, 2, 2, 2 },
-      TRUE
+      { 0, 2, 2, 2 }
     },
     {
       { LRI, 'a', 'b', PDI, 0 },
       DWRITE_READING_DIRECTION_LEFT_TO_RIGHT,
       { 0, 0, 0, 0 },
-      { 0, 0, 0, 0 },
-      TRUE
+      { 0, 0, 0, 0 }
     },
     {
       { RLI, 'a', 'b', PDI, 0 },
       DWRITE_READING_DIRECTION_LEFT_TO_RIGHT,
       { 0, 0, 0, 0 },
-      { 0, 0, 0, 0 },
-      TRUE
+      { 0, 0, 0, 0 }
     },
     {
       { 0 }
