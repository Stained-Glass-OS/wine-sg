+/* every image stretched to the new size */
 static HRESULT WINAPI ImageListImpl_Resize(IImageList2 *iface, INT cx, INT cy)
 {
-    FIXME("(%p)->(%d %d): stub\n", iface, cx, cy);
-    return E_NOTIMPL;
+    HIMAGELIST himl = impl_from_IImageList2(iface), copy;
+    INT i, count;
+
+    TRACE("(%p)->(%d %d)\n", iface, cx, cy);
+
+    if (cx <= 0 || cy <= 0) return E_INVALIDARG;
+    if (cx == himl->cx && cy == himl->cy) return S_OK;
+    if (!(copy = ImageList_Duplicate(himl))) return E_OUTOFMEMORY;
+    count = himl->cCurImage;
+    if (!ImageList_SetIconSize(himl, cx, cy) || !ImageList_SetImageCount(himl, count))
+    {
+        ImageList_Destroy(copy);
+        return E_FAIL;
+    }
+    for (i = 0; i < count; i++)
+    {
+        IMAGELISTDRAWPARAMS params = { sizeof(params) };
+        HDC dc = CreateCompatibleDC(0);
+        BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER), cx, cy, 1, 32, BI_RGB }};
+        HBITMAP bmp;
+        void *bits;
+
+        if (!dc) break;
+        if ((bmp = CreateDIBSection(dc, &info, DIB_RGB_COLORS, &bits, 0, 0)))
+        {
+            HBITMAP mask = 0, old;
+            DWORD *argb = bits;
+            INT n;
+
+            old = SelectObject(dc, bmp);
+            params.himl = copy;
+            params.i = i;
+            params.hdcDst = dc;
+            params.cx = cx;
+            params.cy = cy;
+            params.rgbBk = CLR_NONE;
+            params.fStyle = ILD_SCALE | ILD_TRANSPARENT;
+            ImageList_DrawIndirect(&params);
+            SelectObject(dc, old);
+            /* the transparent parts make the mask */
+            if (himl->flags & ILC_MASK)
+            {
+                BYTE *mbits = Alloc(((cx + 15) / 16) * 2 * cy);
+                INT stride = ((cx + 15) / 16) * 2, x, y;
+                if (mbits)
+                {
+                    for (y = 0; y < cy; y++)
+                        for (x = 0; x < cx; x++)
+                            if (!(argb[(cy - 1 - y) * cx + x] >> 24)) mbits[y * stride + x / 8] |= 0x80 >> (x % 8);
+                    mask = CreateBitmap(cx, cy, 1, 1, mbits);
+                    Free(mbits);
+                }
+            }
+            /* the colours, opaque where the image was */
+            if (himl->uBitsPixel != 32) for (n = 0; n < cx * cy; n++) if (!(argb[n] >> 24)) argb[n] = 0;
+            ImageList_Replace(himl, i, bmp, mask);
+            if (mask) DeleteObject(mask);
+            DeleteObject(bmp);
+        }
+        DeleteDC(dc);
+    }
+    ImageList_Destroy(copy);
+    return S_OK;
 }
 
