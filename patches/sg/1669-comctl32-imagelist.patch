+/* Stained Glass OS 1669: an image as premultiplied ARGB, bottom-up, cx by
+ * cy: its alpha channel, else its mask (opaque where the mask is black) */
+static DWORD *image_argb( HIMAGELIST himl, int i, int cx, int cy )
+{
+    BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER), 0, 0, 1, 32, BI_RGB }};
+    DWORD *bits, *mask_bits, *ret = NULL;
+    HBITMAP bmp, mask_bmp = 0;
+    HDC hdc;
+    POINT pt;
+    int n;
+
+    info.bmiHeader.biWidth = cx;
+    info.bmiHeader.biHeight = cy;
+    if (!(hdc = CreateCompatibleDC( 0 ))) return NULL;
+    if (!(bmp = CreateDIBSection( hdc, &info, DIB_RGB_COLORS, (void **)&bits, 0, 0 )))
+    {
+        DeleteDC( hdc );
+        return NULL;
+    }
+    imagelist_point_from_index( himl, i, &pt );
+    SelectObject( hdc, bmp );
+    BitBlt( hdc, 0, 0, cx, cy, himl->hdcImage, pt.x, pt.y, SRCCOPY );
+    if (!(himl->item_flags[i] & ILIF_ALPHA))
+    {
+        if (himl->hbmMask && (mask_bmp = CreateDIBSection( hdc, &info, DIB_RGB_COLORS, (void **)&mask_bits, 0, 0 )))
+        {
+            SelectObject( hdc, mask_bmp );
+            SetTextColor( hdc, RGB(0, 0, 0) );
+            SetBkColor( hdc, RGB(0xff, 0xff, 0xff) );
+            BitBlt( hdc, 0, 0, cx, cy, himl->hdcMask, pt.x, pt.y, SRCCOPY );
+            for (n = 0; n < cx * cy; n++)
+                bits[n] = (mask_bits[n] & 0xffffff) ? 0 : (bits[n] | 0xff000000);
+        }
+        else for (n = 0; n < cx * cy; n++) bits[n] |= 0xff000000;
+    }
+    if ((ret = Alloc( cx * cy * sizeof(DWORD) ))) memcpy( ret, bits, cx * cy * sizeof(DWORD) );
+    DeleteDC( hdc );
+    DeleteObject( bmp );
+    if (mask_bmp) DeleteObject( mask_bmp );
+    return ret;
+}
+
+/* premultiplied ARGB, bottom-up, onto a DC: stretched to dst_cx by dst_cy */
+static void blend_argb( HDC dst, int x, int y, int dst_cx, int dst_cy, const DWORD *argb, int cx, int cy,
+                        BYTE constant_alpha )
+{
+    BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER), 0, 0, 1, 32, BI_RGB }};
+    BLENDFUNCTION func = { AC_SRC_OVER, 0, constant_alpha, AC_SRC_ALPHA };
+    HBITMAP bmp;
+    DWORD *bits;
+    HDC hdc;
+
+    info.bmiHeader.biWidth = cx;
+    info.bmiHeader.biHeight = cy;
+    if (!(hdc = CreateCompatibleDC( 0 ))) return;
+    if ((bmp = CreateDIBSection( hdc, &info, DIB_RGB_COLORS, (void **)&bits, 0, 0 )))
+    {
+        memcpy( bits, argb, cx * cy * sizeof(DWORD) );
+        SelectObject( hdc, bmp );
+        GdiAlphaBlend( dst, x, y, dst_cx, dst_cy, hdc, 0, 0, cx, cy, func );
+        DeleteObject( bmp );
+    }
+    DeleteDC( hdc );
+}
+
+/* ILS_GLOW and ILS_SHADOW: the image's silhouette in the effect's colour,
+ * spread two pixels around it (a glow) or two pixels down and right of it,
+ * at half strength (a shadow), under the image */
+static void draw_effect( HIMAGELIST himl, const IMAGELISTDRAWPARAMS *params, int cx, int cy, BOOL shadow )
+{
+    const int spread = 2, w = cx + 2 * spread, h = cy + 2 * spread;
+    COLORREF color = params->crEffect;
+    DWORD *argb, *effect;
+    int x, y, dx, dy;
+
+    if (color == CLR_DEFAULT || color == CLR_NONE) color = shadow ? RGB(0, 0, 0) : GetSysColor( COLOR_HIGHLIGHT );
+    if (!(argb = image_argb( himl, params->i, cx, cy ))) return;
+    if (!(effect = Alloc( w * h * sizeof(DWORD) )))
+    {
+        Free( argb );
+        return;
+    }
+    /* rows are bottom-up: the effect pixel (x, y) is over the image pixel
+     * (x - spread, y - spread); a shadow's is spread pixels right of and
+     * below it */
+    for (y = 0; y < h; y++)
+        for (x = 0; x < w; x++)
+        {
+            DWORD a = 0, sum = 0, count = 0;
+            int r = shadow ? 1 : spread;
+            int ox = shadow ? x - 2 * spread : x - spread, oy = shadow ? y : y - spread;
+
+            for (dy = -r; dy <= r; dy++)
+                for (dx = -r; dx <= r; dx++)
+                {
+                    int sx = ox + dx, sy = oy + dy;
+                    DWORD v = (sx < 0 || sy < 0 || sx >= cx || sy >= cy) ? 0 : argb[sy * cx + sx] >> 24;
+                    a = max( a, v );
+                    sum += v;
+                    count++;
+                }
+            if (shadow) a = sum / count / 2;
+            effect[y * w + x] = (a << 24) | ((GetRValue( color ) * a / 255) << 16) |
+                                ((GetGValue( color ) * a / 255) << 8) | (GetBValue( color ) * a / 255);
+        }
+    blend_argb( params->hdcDst, params->x - spread, params->y - spread, w, h, effect, w, h, 255 );
+    Free( effect );
+    Free( argb );
+}
+
+/* ILD_SCALE and ILD_DPISCALE: the image drawn to another size */
+static BOOL draw_scaled( HIMAGELIST himl, const IMAGELISTDRAWPARAMS *params, int dst_cx, int dst_cy )
+{
+    DWORD state = params->cbSize < sizeof(IMAGELISTDRAWPARAMS) ? ILS_NORMAL : params->fState;
+    BYTE constant = state & ILS_ALPHA ? (BYTE)params->Frame : 255;
+    DWORD *argb;
+    int n, ovl;
+
+    if (!(argb = image_argb( himl, params->i, himl->cx, himl->cy ))) return FALSE;
+    if (params->fStyle & (ILD_BLEND25 | ILD_BLEND50))
+    {
+        COLORREF col = params->rgbFg == CLR_DEFAULT || params->rgbFg == CLR_NONE ? GetSysColor( COLOR_HIGHLIGHT ) : params->rgbFg;
+        int keep = params->fStyle & ILD_BLEND25 ? 3 : 1, total = keep + 1;
+        for (n = 0; n < himl->cx * himl->cy; n++)
+        {
+            DWORD a = argb[n] >> 24;
+            DWORD r = (((argb[n] >> 16) & 0xff) * keep + GetRValue( col ) * a / 255) / total;
+            DWORD g = (((argb[n] >> 8) & 0xff) * keep + GetGValue( col ) * a / 255) / total;
+            DWORD b = ((argb[n] & 0xff) * keep + GetBValue( col ) * a / 255) / total;
+            argb[n] = (a << 24) | (r << 16) | (g << 8) | b;
+        }
+    }
+    if (state & ILS_SATURATE)
+        for (n = 0; n < himl->cx * himl->cy; n++)
+        {
+            DWORD gray = (((argb[n] >> 16) & 0xff) * 299 + ((argb[n] >> 8) & 0xff) * 587 + (argb[n] & 0xff) * 114 + 500) / 1000;
+            argb[n] = (argb[n] & 0xff000000) | (gray << 16) | (gray << 8) | gray;
+        }
+    blend_argb( params->hdcDst, params->x, params->y, dst_cx, dst_cy, argb, himl->cx, himl->cy, constant );
+    Free( argb );
+    /* the overlay, scaled the same */
+    ovl = (params->fStyle & ILD_OVERLAYMASK) >> 8;
+    if (ovl >= 1 && ovl <= MAX_OVERLAYIMAGE && (ovl = himl->nOvlIdx[ovl - 1]) >= 0 && ovl < himl->cCurImage &&
+        (argb = image_argb( himl, ovl, himl->cx, himl->cy )))
+    {
+        blend_argb( params->hdcDst, params->x, params->y, dst_cx, dst_cy, argb, himl->cx, himl->cy, constant );
+        Free( argb );
+    }
+    return TRUE;
+}
