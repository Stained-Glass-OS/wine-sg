+/* ---- the pager on the taskbar ----------------------------------------- */
+
+/* A desktop switcher on the bar, as MATE's panel has one: a box per desktop,
+ * the screen's shape, with its windows' outlines; the current one in the
+ * accent colour. Click a box to go there, the wheel steps through them, and
+ * the right button offers a new desktop, closing one, and Task View. The Task
+ * View button sits just left of it (systray.c places both). */
+static int pager_hot = -1;
+
+#define PAGER_PAD   4   /* between the boxes, and at the ends */
+#define PAGER_INSET 8   /* between a box and the bar's edges */
+
+static void pager_box_size( BOOL vertical, int thickness, int *w, int *h )
+{
+    int sw = GetSystemMetrics( SM_CXSCREEN ), sh = GetSystemMetrics( SM_CYSCREEN );
+    if (sw <= 0 || sh <= 0) { sw = 16; sh = 9; }
+    if (vertical) { *w = max( 12, thickness - 2 * PAGER_INSET ); *h = max( 8, MulDiv( *w, sh, sw )); }
+    else { *h = max( 8, thickness - 2 * PAGER_INSET ); *w = max( 12, MulDiv( *h, sw, sh )); }
+}
+
+int vd_pager_len( BOOL vertical, int thickness )
+{
+    int w, h;
+    pager_box_size( vertical, thickness, &w, &h );
+    return vd_count * ((vertical ? h : w) + PAGER_PAD) + PAGER_PAD;
+}
+
+static BOOL pager_vertical( const RECT *client )
+{
+    return client->bottom - client->top > client->right - client->left;
+}
+
+static void pager_box( const RECT *client, int d, RECT *box )
+{
+    BOOL vertical = pager_vertical( client );
+    int w, h, at;
+
+    pager_box_size( vertical, vertical ? client->right : client->bottom, &w, &h );
+    if (vertical)
+    {
+        at = PAGER_PAD + d * (h + PAGER_PAD);
+        SetRect( box, (client->right - w) / 2, at, (client->right - w) / 2 + w, at + h );
+    }
+    else
+    {
+        at = PAGER_PAD + d * (w + PAGER_PAD);
+        SetRect( box, at, (client->bottom - h) / 2, at + w, (client->bottom - h) / 2 + h );
+    }
+}
+
+static int pager_hit( HWND hwnd, int x, int y )
+{
+    RECT client, box;
+    POINT pt = { x, y };
+    int d;
+
+    GetClientRect( hwnd, &client );
+    for (d = 0; d < vd_count; d++)
+    {
+        pager_box( &client, d, &box );
+        InflateRect( &box, PAGER_PAD / 2, PAGER_INSET );
+        if (PtInRect( &box, pt )) return d;
+    }
+    return -1;
+}
+
+static void pager_paint( HWND hwnd, HDC dc )
+{
+    COLORREF bar, hover, text, accent = taskbar_accent();
+    HWND list[256] = {0};
+    RECT client, box;
+    int d, i;
+
+    taskbar_colors( &bar, &hover, &text );
+    GetClientRect( hwnd, &client );
+    fill( dc, &client, bar );
+    EnumWindows( mini_collect, (LPARAM)list );
+    for (d = 0; d < vd_count; d++)
+    {
+        struct mini m = { &box, d, dc };
+
+        pager_box( &client, d, &box );
+        fill( dc, &box, d == vd_current ? accent : d == pager_hot ? hover : RGB(0x40,0x40,0x40) );
+        for (i = 0; list[i]; i++) ;
+        while (i--) mini_proc( list[i], (LPARAM)&m );
+        frame( dc, &box, d == vd_current ? accent : d == pager_hot ? text : RGB(0x70,0x70,0x70), 1 );
+    }
+}
+
+static void pager_menu( HWND hwnd, int d, POINT pt )
+{
+    HMENU menu = CreatePopupMenu();
+    WCHAR name[64], text[96];
+    int cmd;
+
+    AppendMenuW( menu, MF_STRING | (vd_count >= VD_MAX ? MF_GRAYED : 0), 1, L"&New desktop" );
+    if (d >= 0)
+    {
+        vd_name( d, name, ARRAY_SIZE(name) );
+        swprintf( text, ARRAY_SIZE(text), L"&Close %s", name );
+        AppendMenuW( menu, MF_STRING | (vd_count <= 1 ? MF_GRAYED : 0), 2, text );
+    }
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( menu, MF_STRING, 3, L"&Task View" );
+    SetForegroundWindow( vd_tray );
+    cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_RIGHTBUTTON | TPM_BOTTOMALIGN, pt.x, pt.y, 0, hwnd, NULL );
+    DestroyMenu( menu );
+    switch (cmd)
+    {
+    case 1: vd_new( FALSE ); break;
+    case 2: vd_close( d ); break;
+    case 3: vd_taskview( FALSE ); break;
+    }
+    InvalidateRect( hwnd, NULL, TRUE );
+}
+
+static LRESULT CALLBACK pager_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    switch (msg)
+    {
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC dc = BeginPaint( hwnd, &ps );
+        pager_paint( hwnd, dc );
+        EndPaint( hwnd, &ps );
+        return 0;
+    }
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_MOUSEACTIVATE:
+        return MA_NOACTIVATE;
+    case WM_MOUSEMOVE:
+    {
+        int d = pager_hit( hwnd, (short)LOWORD(lp), (short)HIWORD(lp) );
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd, 0 };
+        if (d != pager_hot) { pager_hot = d; InvalidateRect( hwnd, NULL, TRUE ); }
+        TrackMouseEvent( &tme );
+        return 0;
+    }
+    case WM_MOUSELEAVE:
+        if (pager_hot >= 0) { pager_hot = -1; InvalidateRect( hwnd, NULL, TRUE ); }
+        return 0;
+    case WM_LBUTTONUP:
+    {
+        int d = pager_hit( hwnd, (short)LOWORD(lp), (short)HIWORD(lp) );
+        if (d >= 0) vd_switch( d, FALSE );
+        return 0;
+    }
+    case WM_MOUSEWHEEL:
+    {
+        int d = vd_current + ((short)HIWORD(wp) > 0 ? -1 : 1);
+        if (d >= 0 && d < vd_count) vd_switch( d, FALSE );
+        return 0;
+    }
+    case WM_RBUTTONUP:
+    {
+        POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
+        int d = pager_hit( hwnd, pt.x, pt.y );
+        ClientToScreen( hwnd, &pt );
+        pager_menu( hwnd, d, pt );
+        return 0;
+    }
+    case WM_TIMER:  /* windows move and resize without telling the bar */
+        if (IsWindowVisible( hwnd )) InvalidateRect( hwnd, NULL, FALSE );
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+HWND vd_pager_create( HWND parent )
+{
+    pager = CreateWindowW( L"SgVirtualDesktopPager", NULL, WS_CHILD, 0, 0, 0, 0, parent, 0, 0, 0 );
+    if (pager) SetTimer( pager, 1, 1000, NULL );
+    return pager;
+}
