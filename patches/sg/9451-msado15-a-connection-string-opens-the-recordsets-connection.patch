From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msado15: a connection string as a Recordset's ActiveConnection opens a connection of its own.

Recordset.Open "SELECT ...", "Driver=...;..." -- the way most scripts open a recordset -- failed with adErrInvalidConnection ("Unsupported Active connection type 8"), and setting ActiveConnection to a string stored the string. As ADO does, the string opens a new Connection, which is the recordset's ActiveConnection from then on. Two reference bugs this showed: Open changed its by-value VARIANT arguments, which on x86_64 are the caller's memory that IDispatch::Invoke clears afterwards (a connection put there was released twice); and Open copied the recordset's own connection over itself, which released it first and freed a connection only the recordset held.
---
--- a/dlls/msado15/recordset.c
+++ b/dlls/msado15/recordset.c
@@ -1738,6 +1738,26 @@
     return S_OK;
 }
 
+/* Stained Glass OS (wine-sg 9451): a new Connection, opened with the string */
+static HRESULT recordset_open_connection( BSTR str, VARIANT *ret )
+{
+    _Connection *conn;
+    HRESULT hr;
+
+    VariantInit( ret );
+    if (FAILED(hr = Connection_create( (void **)&conn ))) return hr;
+    if (FAILED(hr = _Connection_Open( conn, str, NULL, NULL, adConnectUnspecified )))
+    {
+        _Connection_Release( conn );
+        return hr;
+    }
+    V_VT(ret) = VT_DISPATCH;
+    hr = _Connection_QueryInterface( conn, &IID_IDispatch, (void **)&V_DISPATCH(ret) );
+    _Connection_Release( conn );
+    if (FAILED(hr)) V_VT(ret) = VT_EMPTY;
+    return hr;
+}
+
 static HRESULT WINAPI recordset_put_ActiveConnection( _Recordset *iface, VARIANT connection )
 {
     struct recordset *recordset = impl_from_Recordset( iface );
@@ -1761,6 +1781,18 @@
         VariantClear( &copy );
         return MAKE_ADO_HRESULT( adErrInvalidArgument );
     }
+#ifndef SG_MUTANT_ADO_CONNSTR
+    if (V_VT(&copy) == VT_BSTR)
+    {
+        /* Stained Glass OS (wine-sg 9451): a connection string: a new connection is opened with it */
+        VARIANT opened;
+
+        hr = recordset_open_connection( V_BSTR(&copy), &opened );
+        VariantClear( &copy );
+        if (FAILED(hr)) return hr;
+        copy = opened;
+    }
+#endif
 
     VariantClear( &recordset->active_connection );
     recordset->active_connection = copy;
@@ -3973,10 +4005,14 @@
