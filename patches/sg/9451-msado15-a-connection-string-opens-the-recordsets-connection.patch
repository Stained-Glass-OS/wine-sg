     ICommandText *command_text;
@@ -4049,6 +4085,26 @@
         V_VT(&recordset->active_connection) == VT_DISPATCH && V_DISPATCH(&recordset->active_connection))
         active_connection = recordset->active_connection;
 
+    /* Stained Glass OS (wine-sg 9451): a connection string opens a connection of the recordset's own,
+     * which is its ActiveConnection from then on */
