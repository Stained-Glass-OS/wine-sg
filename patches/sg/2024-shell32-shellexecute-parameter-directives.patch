From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: ShellExecute parameter directives %2..%9, %* and %~n (2024)

shell32: ShellExecute parameter directives %2..%9, %* and %~n (2024)

From Wine's argify tests, which record Windows: the parameters given to
ShellExecute are split on spaces only, a run of k quotes giving k/2
quotes and (odd k) ending the argument, a quoted argument that is never
closed being lost; %2..%9 are those arguments, %* the raw string, %~2 the
same, %~n for n>2 what follows argument n-1 (spaces included), empty when
that argument does not exist; any other %~ is kept as it is.
---
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -73,6 +73,65 @@
  * %* all following parameters (see batfile)
  *
  */
+/* Stained Glass OS: the parameters of a command, split as ShellExecute does
+ * (it is neither CreateProcess nor CommandLineToArgv): arguments are
+ * separated by spaces only; a run of k quotes inside an argument gives k/2
+ * quotes and, if k is odd, ends the argument (a quote opens a quoted one at
+ * its start); a quoted argument that is not closed is lost. Returns the end
+ * of the n'th argument (1 is the first) in the raw string, NULL when there
+ * is none; its text is copied to text.
+ */
+static const WCHAR *argify_param(const WCHAR *args, unsigned int n, WCHAR *text, DWORD cap)
+{
+    const WCHAR *p = args;
+    DWORD len;
+
+    if (text && cap) text[0] = 0;
+    for (;;)
+    {
+        BOOL quoted, ended = FALSE;
+
+        while (*p == ' ') p++;
+        if (!*p) return NULL;
+        quoted = *p == '"';
+        if (quoted) p++;
+        len = 0;
+        while (!ended)
+        {
+            if (!*p)
+            {
+                if (quoted)
+                {
+                    /* an unclosed quoted argument is lost */
+                    if (text && cap) text[0] = 0;
+                    return NULL;
+                }
+                break;
+            }
+            if (*p == '"')
+            {
+                unsigned int k = 0, i;
+                while (*p == '"') { k++; p++; }
+                for (i = 0; i < k / 2; i++)
+                    if (n == 1 && text && len + 1 < cap) text[len++] = '"';
+                    else len++;
+                if (k & 1) ended = TRUE;
+                continue;
+            }
+            if (!quoted && *p == ' ') break;
+            if (n == 1 && text && len + 1 < cap) text[len] = *p;
+            len++;
+            p++;
+        }
+        if (n == 1)
+        {
+            if (text && cap) text[min(len, cap - 1)] = 0;
+            return p;
+        }
+        n--;
+    }
+}
+
