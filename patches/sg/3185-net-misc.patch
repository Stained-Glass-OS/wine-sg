+        break;
+    }
+    default:
+        return ERROR_INVALID_LEVEL;
+    }
+
+    if (!remote || !remote[0])
+    {
+        if (parm_err) *parm_err = USE_REMOTE_PARMNUM;
+        return ERROR_INVALID_PARAMETER;
+    }
+
+    memset(&nr, 0, sizeof(nr));
+    switch (type)
+    {
+    case USE_DISKDEV: nr.dwType = RESOURCETYPE_DISK; break;
+    case USE_SPOOLDEV: nr.dwType = RESOURCETYPE_PRINT; break;
+    case USE_CHARDEV:
+    case USE_WILDCARD: nr.dwType = RESOURCETYPE_ANY; break;
+    default:
+        if (parm_err) *parm_err = USE_ASGTYPE_PARMNUM;
+        return ERROR_INVALID_PARAMETER;
+    }
+    nr.lpLocalName = (local && local[0]) ? (WCHAR *)local : NULL;
+    nr.lpRemoteName = (WCHAR *)remote;
+
+    if (user && user[0] && domain && domain[0])
+    {
+        if (!(account = malloc((wcslen(domain) + wcslen(user) + 2) * sizeof(WCHAR)))) return ERROR_NOT_ENOUGH_MEMORY;
+        swprintf(account, wcslen(domain) + wcslen(user) + 2, L"%s\\%s", domain, user);
