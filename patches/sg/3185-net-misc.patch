+    }
+
+    ret = WNetAddConnection2W(&nr, password, (user && user[0]) ? user : NULL, 0);
+    free(account);
+    return ret;
 }
 
 NET_API_STATUS WINAPI NetUseDel(LMSTR servername, LMSTR usename, DWORD forcecond)
 {
-    FIXME("%s %s %ld stub\n", debugstr_w(servername), debugstr_w(usename), forcecond);
+    DWORD ret;
+
+    TRACE("%s %s %ld\n", debugstr_w(servername), debugstr_w(usename), forcecond);
+
+    if (servername && servername[0] && !NETAPI_IsLocalComputer(servername)) return ERROR_NOT_SUPPORTED;
+    if (!usename || !usename[0]) return ERROR_INVALID_PARAMETER;
+    if (forcecond > USE_LOTS_OF_FORCE) return ERROR_INVALID_PARAMETER;
+
+#ifdef SG_MUTANT_B3_USEDEL
     return NERR_Success;
+#endif
+    ret = WNetCancelConnection2W(usename, 0, forcecond != USE_NOFORCE);
+    if (ret == ERROR_NOT_CONNECTED) return NERR_UseNotFound;
+    return ret;
 }
 
