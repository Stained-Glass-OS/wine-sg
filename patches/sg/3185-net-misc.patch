 /******************************************************************
  *    CreateSortedAddressPairs (IPHLPAPI.@)
  */
+/* RFC 6724 address scopes, precedence and source selection are used to pick a source address for each
+   destination and to sort the pairs. IPv4 addresses are handled as v4-mapped IPv6 addresses. */
+static BOOL is_v4mapped( const IN6_ADDR *a )
+{
+    return !a->u.Word[0] && !a->u.Word[1] && !a->u.Word[2] && !a->u.Word[3] && !a->u.Word[4] && a->u.Word[5] == 0xffff;
+}
+
+static int addr_scope( const IN6_ADDR *a )
+{
+    if (a->u.Byte[0] == 0xff) return a->u.Byte[1] & 0xf;
+    if (is_v4mapped( a ))
+    {
+        if (a->u.Byte[12] == 127 || (a->u.Byte[12] == 169 && a->u.Byte[13] == 254)) return 2;
+        return 0xe;
+    }
+    if (IN6_IS_ADDR_LOOPBACK( a )) return 2;
+    if (a->u.Byte[0] == 0xfe && (a->u.Byte[1] & 0xc0) == 0x80) return 2;
+    if (a->u.Byte[0] == 0xfe && (a->u.Byte[1] & 0xc0) == 0xc0) return 5;
+    return 0xe;
+}
+
+static int addr_precedence( const IN6_ADDR *a )
+{
+    if (IN6_IS_ADDR_LOOPBACK( a )) return 50;
+    if (is_v4mapped( a )) return 35;
+    if (a->u.Word[0] == 0x0220) return 30;                               /* 2002::/16 */
+    if (a->u.Word[0] == 0x0120 && !a->u.Word[1]) return 5;               /* 2001::/32 */
+    if ((a->u.Byte[0] & 0xfe) == 0xfc) return 3;                         /* fc00::/7 */
+    if (a->u.Byte[0] == 0xfe && (a->u.Byte[1] & 0xc0) == 0xc0) return 1; /* fec0::/10 */
+    if (a->u.Byte[0] == 0x3f && a->u.Byte[1] == 0xfe) return 1;          /* 3ffe::/16 */
+    if (!a->u.Word[0] && !a->u.Word[1] && !a->u.Word[2] && !a->u.Word[3] && !a->u.Word[4] && !a->u.Word[5]) return 1;
+    return 40;
+}
+
+static int common_prefix_len( const IN6_ADDR *a, const IN6_ADDR *b )
+{
+    int i, bit;
+
+    for (i = 0; i < 16; i++)
+    {
+        BYTE x = a->u.Byte[i] ^ b->u.Byte[i];
+        if (!x) continue;
+        for (bit = 0; bit < 8; bit++) if (x & (0x80 >> bit)) return i * 8 + bit;
+    }
+    return 128;
+}
+
+struct sort_pair
+{
+    SOCKADDR_IN6 dst, src;
+    BOOL has_src;
+    DWORD index;
+};
+
+static int sort_pair_cmp( const void *pa, const void *pb )
+{
+    const struct sort_pair *a = pa, *b = pb;
+    int sa, sb, da, db, v;
+
+    if (a->has_src != b->has_src) return a->has_src ? -1 : 1;                              /* rule 1 */
+    if (a->has_src)
+    {
+        sa = addr_scope( &a->src.sin6_addr ) == addr_scope( &a->dst.sin6_addr );
+        sb = addr_scope( &b->src.sin6_addr ) == addr_scope( &b->dst.sin6_addr );
+        if (sa != sb) return sa ? -1 : 1;                                                  /* rule 2 */
+    }
+    da = addr_precedence( &a->dst.sin6_addr );
+    db = addr_precedence( &b->dst.sin6_addr );
+    if (da != db) return da > db ? -1 : 1;                                                 /* rule 6 */
+    da = addr_scope( &a->dst.sin6_addr );
+    db = addr_scope( &b->dst.sin6_addr );
+    if (da != db) return da < db ? -1 : 1;                                                 /* rule 8 */
+    if (a->has_src)
+    {
+        v = common_prefix_len( &a->src.sin6_addr, &a->dst.sin6_addr ) -
+            common_prefix_len( &b->src.sin6_addr, &b->dst.sin6_addr );
+        if (v) return v > 0 ? -1 : 1;                                                      /* rule 9 */
+    }
+    return a->index < b->index ? -1 : a->index > b->index;                                 /* keep the order */
+}
+
+static void map_address_4to6( DWORD addr, SOCKADDR_IN6 *out )
+{
+    memset( out, 0, sizeof(*out) );
+    out->sin6_family = AF_INET6;
+    out->sin6_addr.u.Word[5] = 0xffff;
+    out->sin6_addr.u.Word[6] = addr & 0xffff;
+    out->sin6_addr.u.Word[7] = addr >> 16;
+}
