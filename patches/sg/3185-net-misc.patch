 NET_API_STATUS WINAPI NetUseAdd(LMSTR servername, DWORD level, LPBYTE bufptr, LPDWORD parm_err)
 {
-    FIXME("%s %ld %p %p stub\n", debugstr_w(servername), level, bufptr, parm_err);
-    return NERR_Success;
+    NETRESOURCEW nr;
+    const WCHAR *local, *remote, *password, *user = NULL, *domain = NULL;
+    WCHAR *account = NULL;
+    DWORD type, ret;
+
+    TRACE("%s %ld %p %p\n", debugstr_w(servername), level, bufptr, parm_err);
+
+    if (servername && servername[0] && !NETAPI_IsLocalComputer(servername)) return ERROR_NOT_SUPPORTED;
+    if (!bufptr) return ERROR_INVALID_PARAMETER;
+    if (parm_err) *parm_err = 0;
+
+    switch (level)
+    {
+    case 1:
+    {
+        USE_INFO_1 *ui = (USE_INFO_1 *)bufptr;
