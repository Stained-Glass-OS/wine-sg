+            if (src_list[i].sin6_family != AF_INET6) return ERROR_INVALID_PARAMETER;
+        cands = src_list;
+        cand_count = src_count;
+    }
+    else if (!GetUnicastIpAddressTable( AF_UNSPEC, &utable ))
     {
-        if (!map_address_6to4( &dst_list[i], &addr4 ))
+        if ((cands = HeapAlloc( GetProcessHeap(), 0, max( utable->NumEntries, 1 ) * sizeof(*cands) )))
         {
-            FIXME("only mapped IPv4 addresses are supported\n");
-            return ERROR_NOT_SUPPORTED;
+            for (i = 0; i < utable->NumEntries; i++)
+            {
+                const MIB_UNICASTIPADDRESS_ROW *row = &utable->Table[i];
