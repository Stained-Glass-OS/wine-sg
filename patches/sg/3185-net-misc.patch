+        }
+
+        for (j = 0; j < cand_count; j++)
         {
-            char buf[46];
-            FIXME( "source address for %s not found\n", debugstr_ipv6(&dst_list[i], buf) );
-            memset( pairs[i].SourceAddress, 0, sizeof(*pairs[i].SourceAddress) );
-            pairs[i].SourceAddress->sin6_family = AF_INET6;
+            int score;
+            /* a v4-mapped destination needs an IPv4 source and the other way round */
+            if (is_v4mapped( &cands[j].sin6_addr ) != is_v4mapped( &dst_list[i].sin6_addr )) continue;
+            if (IN6_IS_ADDR_UNSPECIFIED( &cands[j].sin6_addr )) continue;
+            if (!memcmp( &cands[j].sin6_addr, &dst_list[i].sin6_addr, sizeof(IN6_ADDR) )) { best = j; best_score = 1000; break; }
+            score = (addr_scope( &cands[j].sin6_addr ) == addr_scope( &dst_list[i].sin6_addr ) ? 256 : 0) +
+                    common_prefix_len( &cands[j].sin6_addr, &dst_list[i].sin6_addr );
