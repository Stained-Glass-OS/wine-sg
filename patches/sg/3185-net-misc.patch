            src_list, src_count, dst_list, dst_count, options, pair_list, pair_count );
 
-    if (src_list || src_count || !dst_list || !pair_list || !pair_count || dst_count > 500)
+    if ((src_list == NULL) != (src_count == 0) || !dst_list || !dst_count || !pair_list || !pair_count ||
+        dst_count > 500)
         return ERROR_INVALID_PARAMETER;
-
     for (i = 0; i < dst_count; i++)
+        if (dst_list[i].sin6_family != AF_INET6) return ERROR_INVALID_PARAMETER;
+
+    if (src_list)
+    {
