From: Stained Glass OS <dev@stained-glass.example>
Subject: crypt32: the SSL policy honours the ignore-unknown-revocation flags

CertVerifyCertificateChainPolicy(CERT_CHAIN_POLICY_SSL) failed any chain
with CERT_TRUST_IS_OFFLINE_REVOCATION as CERT_E_REVOCATION_FAILURE unless
the HTTPS extra parameters said SECURITY_FLAG_IGNORE_REVOCATION; the base
flags CERT_CHAIN_POLICY_IGNORE_END_REV_UNKNOWN_FLAG, ..._CA_... and
..._ROOT_... were ignored. Rust's schannel crate (Discord's updater,
reqwest) builds the chain with CERT_CHAIN_REVOCATION_CHECK_CACHE_ONLY --
so every CRL is "offline" -- and passes
CERT_CHAIN_POLICY_IGNORE_ALL_REV_UNKNOWN_FLAGS: every HTTPS request failed
with 0x800b010e and the updater said "Update failed -- retrying" forever.

The error now stands only if some certificate whose revocation status is
unknown is not covered by the flag for its place in the chain (the end
certificate, a self-signed root, or a CA in between).

Gate: test/commapps-gate.sh.
---
--- a/dlls/crypt32/chain.c
+++ b/dlls/crypt32/chain.c
@@ -3508,6 +3508,46 @@
     }
 }
 
+/* Whether every certificate whose revocation status could not be learned
+ * (offline, or no revocation information) is one the policy parameters' flags
+ * say to ignore that for: CERT_CHAIN_POLICY_IGNORE_END_REV_UNKNOWN_FLAG for
+ * the end certificate, ..._ROOT_... for a chain's self-signed root,
+ * ..._CA_... for the certificates in between (and ..._CTL_SIGNER_... for a
+ * CTL's signer, which this does not track). */
+static BOOL revocation_unknown_ignored(PCCERT_CHAIN_CONTEXT chain, DWORD flags)
+{
+    DWORD i, j;
+
+    if (!(flags & (CERT_CHAIN_POLICY_IGNORE_END_REV_UNKNOWN_FLAG |
+     CERT_CHAIN_POLICY_IGNORE_CA_REV_UNKNOWN_FLAG |
+     CERT_CHAIN_POLICY_IGNORE_ROOT_REV_UNKNOWN_FLAG)))
+        return FALSE;
+    for (i = 0; i < chain->cChain; i++)
+    {
+        const CERT_SIMPLE_CHAIN *simple = chain->rgpChain[i];
+
+        for (j = 0; j < simple->cElement; j++)
+        {
+            const CERT_CHAIN_ELEMENT *element = simple->rgpElement[j];
+            DWORD needed;
+
+            if (!(element->TrustStatus.dwErrorStatus &
+             (CERT_TRUST_IS_OFFLINE_REVOCATION | CERT_TRUST_REVOCATION_STATUS_UNKNOWN)))
+                continue;
+            if (i == 0 && j == 0)
+                needed = CERT_CHAIN_POLICY_IGNORE_END_REV_UNKNOWN_FLAG;
+            else if (j == simple->cElement - 1 &&
+             element->TrustStatus.dwInfoStatus & CERT_TRUST_IS_SELF_SIGNED)
+                needed = CERT_CHAIN_POLICY_IGNORE_ROOT_REV_UNKNOWN_FLAG;
+            else
+                needed = CERT_CHAIN_POLICY_IGNORE_CA_REV_UNKNOWN_FLAG;
+            if (!(flags & needed))
+                return FALSE;
+        }
+    }
+    return TRUE;
+}
+
 static BOOL WINAPI verify_ssl_policy(LPCSTR szPolicyOID,
  PCCERT_CHAIN_CONTEXT pChainContext, PCERT_CHAIN_POLICY_PARA pPolicyPara,
  PCERT_CHAIN_POLICY_STATUS pPolicyStatus)
@@ -3581,7 +3621,8 @@
     }
     else if (pChainContext->TrustStatus.dwErrorStatus &
      CERT_TRUST_IS_OFFLINE_REVOCATION &&
-     !(checks & SECURITY_FLAG_IGNORE_REVOCATION))
+     !(checks & SECURITY_FLAG_IGNORE_REVOCATION) &&
+     !revocation_unknown_ignored(pChainContext, baseChecks))
     {
         pPolicyStatus->dwError = CERT_E_REVOCATION_FAILURE;
         find_element_with_error(pChainContext,
