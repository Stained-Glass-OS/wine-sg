+    HRESULT Hiding([in] BOOL ensure_focused_element_in_view);
+}
+
+[
+    object,
+    uuid(5752238b-24f0-495a-82f1-2fd593056796),
+    pointer_default(unique)
+]
+interface IFrameworkInputPane : IUnknown
+{
+    HRESULT Advise([in] IUnknown *window, [in] IFrameworkInputPaneHandler *handler, [out] DWORD *cookie);
+    HRESULT AdviseWithHWND([in] HWND hwnd, [in] IFrameworkInputPaneHandler *handler, [out] DWORD *cookie);
+    HRESULT Unadvise([in] DWORD cookie);
