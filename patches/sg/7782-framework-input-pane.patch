+
+cpp_quote("DEFINE_GUID(CLSID_FrameworkInputPane, 0xd5120aa3, 0x46ba, 0x44c5, 0x82, 0x2d, 0xca, 0x80, 0x92, 0xc1, 0xfc, 0x72);")
+
 [
     object,
     uuid(947aab5f-0a5c-4c13-b4d6-4bf7836fc9f8),
