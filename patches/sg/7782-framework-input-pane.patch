+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "shobjidl.h"
+#include "winstring.h"
+#include "roapi.h"
+#include "wine/list.h"
+#include "wine/debug.h"
+#include "shell32_main.h"
+#include "initguid.h"
+#define WIDL_using_Windows_Foundation
+#define WIDL_using_Windows_UI_ViewManagement
+#include "windows.ui.viewmanagement.h"
+#include "inputpaneinterop.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+struct pane_advise
+{
+    struct list entry;
+    DWORD cookie;
+    HWND hwnd;
+    IFrameworkInputPaneHandler *handler;
+    IInputPane *pane;                       /* the window's InputPane, NULL when there is none */
+    EventRegistrationToken showing, hiding;
+    struct visibility_handler *delegate;
+};
+
+struct visibility_handler
+{
+    ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs ITypedEventHandler_iface;
+    LONG ref;
+    BOOL showing;
+    HWND hwnd;
+    IFrameworkInputPaneHandler *handler;
+};
+
+struct framework_pane
+{
+    IFrameworkInputPane IFrameworkInputPane_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    struct list advises;
+    DWORD next_cookie;
+};
+
+static inline struct framework_pane *impl_from_IFrameworkInputPane( IFrameworkInputPane *iface )
+{
+    return CONTAINING_RECORD( iface, struct framework_pane, IFrameworkInputPane_iface );
+}
+
+static inline struct visibility_handler *impl_from_handler( ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct visibility_handler, ITypedEventHandler_iface );
+}
+
+/* an InputPane rectangle (view pixels) on the screen of HWND, in pixels */
+static void pane_rect_to_screen( HWND hwnd, const Rect *in, RECT *out )
+{
+    UINT dpi = hwnd ? GetDpiForWindow( hwnd ) : 0;
+
+    if (!dpi) dpi = GetDpiForSystem();
+    if (!dpi) dpi = 96;
+    out->left = in->X * dpi / 96.0f;
+    out->top = in->Y * dpi / 96.0f;
+    out->right = (in->X + in->Width) * dpi / 96.0f;
+    out->bottom = (in->Y + in->Height) * dpi / 96.0f;
+}
+
+static HRESULT WINAPI handler_QueryInterface( ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs *iface,
+                                              REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs ))
+    {
+        ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs_AddRef( iface );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI handler_AddRef( ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_handler( iface )->ref );
+}
+
+static ULONG WINAPI handler_Release( ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs *iface )
+{
+    struct visibility_handler *impl = impl_from_handler( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IFrameworkInputPaneHandler_Release( impl->handler );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI handler_Invoke( ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs *iface,
+                                      IInputPane *sender, IInputPaneVisibilityEventArgs *args )
+{
+    struct visibility_handler *impl = impl_from_handler( iface );
+    Rect rect = {0};
+    RECT screen;
+
+    TRACE( "%p %s\n", impl, impl->showing ? "showing" : "hiding" );
+    if (!impl->showing) return IFrameworkInputPaneHandler_Hiding( impl->handler, FALSE );
+    if (args) IInputPaneVisibilityEventArgs_get_OccludedRect( args, &rect );
+    pane_rect_to_screen( impl->hwnd, &rect, &screen );
+    return IFrameworkInputPaneHandler_Showing( impl->handler, &screen, FALSE );
+}
+
+static const ITypedEventHandler_InputPane_InputPaneVisibilityEventArgsVtbl handler_vtbl =
+{
+    handler_QueryInterface,
+    handler_AddRef,
+    handler_Release,
+    handler_Invoke,
+};
+
+static struct visibility_handler *create_handler( HWND hwnd, IFrameworkInputPaneHandler *handler, BOOL showing )
+{
+    struct visibility_handler *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->ITypedEventHandler_iface.lpVtbl = &handler_vtbl;
+    impl->ref = 1;
+    impl->showing = showing;
+    impl->hwnd = hwnd;
+    IFrameworkInputPaneHandler_AddRef( (impl->handler = handler) );
+    return impl;
+}
+
+/* the window's InputPane (windows.ui), or NULL */
+static IInputPane *window_input_pane( HWND hwnd )
+{
+    static const WCHAR name[] = L"Windows.UI.ViewManagement.InputPane";
+    IInputPaneInterop *interop = NULL;
+    IInputPane *pane = NULL;
+    HSTRING str;
+
+#ifdef SG_MUTANT_FIP_NO_PANE
+    return NULL;
+#endif
+    if (FAILED(WindowsCreateString( name, wcslen( name ), &str ))) return NULL;
+    if (SUCCEEDED(RoGetActivationFactory( str, &IID_IInputPaneInterop, (void **)&interop )))
+    {
+        IInputPaneInterop_GetForWindow( interop, hwnd, &IID_IInputPane, (void **)&pane );
+        IInputPaneInterop_Release( interop );
+    }
+    WindowsDeleteString( str );
+    return pane;
+}
+
+static void free_advise( struct pane_advise *advise )
+{
+    if (advise->pane)
+    {
+        IInputPane_remove_Showing( advise->pane, advise->showing );
+        IInputPane_remove_Hiding( advise->pane, advise->hiding );
+        IInputPane_Release( advise->pane );
+    }
+    IFrameworkInputPaneHandler_Release( advise->handler );
+    free( advise );
+}
+
+static HRESULT WINAPI fip_QueryInterface( IFrameworkInputPane *iface, REFIID iid, void **out )
+{
+    struct framework_pane *impl = impl_from_IFrameworkInputPane( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IFrameworkInputPane ))
+    {
+        IFrameworkInputPane_AddRef( (*out = &impl->IFrameworkInputPane_iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI fip_AddRef( IFrameworkInputPane *iface )
+{
+    return InterlockedIncrement( &impl_from_IFrameworkInputPane( iface )->ref );
+}
+
+static ULONG WINAPI fip_Release( IFrameworkInputPane *iface )
+{
+    struct framework_pane *impl = impl_from_IFrameworkInputPane( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    struct pane_advise *advise, *next;
+
+    if (!ref)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE( advise, next, &impl->advises, struct pane_advise, entry )
+        {
+            list_remove( &advise->entry );
+            free_advise( advise );
+        }
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI fip_AdviseWithHWND( IFrameworkInputPane *iface, HWND hwnd, IFrameworkInputPaneHandler *handler,
+                                          DWORD *cookie )
+{
+    struct framework_pane *impl = impl_from_IFrameworkInputPane( iface );
+    struct pane_advise *advise;
+    struct visibility_handler *showing = NULL, *hiding = NULL;
+
+    TRACE( "iface %p, hwnd %p, handler %p, cookie %p.\n", iface, hwnd, handler, cookie );
+
+    if (!cookie) return E_POINTER;
+    *cookie = 0;
+    if (!handler) return E_INVALIDARG;
+    if (!(advise = calloc( 1, sizeof(*advise) ))) return E_OUTOFMEMORY;
+    advise->hwnd = hwnd;
+    IFrameworkInputPaneHandler_AddRef( (advise->handler = handler) );
+
+    /* no InputPane (no windows.ui): still registered, never told anything, as when the keyboard
+     * never shows */
+    if ((advise->pane = window_input_pane( hwnd )))
+    {
+        if ((showing = create_handler( hwnd, handler, TRUE )))
+            IInputPane_add_Showing( advise->pane, &showing->ITypedEventHandler_iface, &advise->showing );
+        if ((hiding = create_handler( hwnd, handler, FALSE )))
+            IInputPane_add_Hiding( advise->pane, &hiding->ITypedEventHandler_iface, &advise->hiding );
+        if (showing) ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs_Release( &showing->ITypedEventHandler_iface );
+        if (hiding) ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs_Release( &hiding->ITypedEventHandler_iface );
+    }
+
+    EnterCriticalSection( &impl->cs );
+    advise->cookie = ++impl->next_cookie;
+    list_add_tail( &impl->advises, &advise->entry );
+    LeaveCriticalSection( &impl->cs );
+    *cookie = advise->cookie;
+    return S_OK;
+}
+
+static HRESULT WINAPI fip_Advise( IFrameworkInputPane *iface, IUnknown *window, IFrameworkInputPaneHandler *handler,
+                                  DWORD *cookie )
+{
+    TRACE( "iface %p, window %p, handler %p, cookie %p.\n", iface, window, handler, cookie );
+
+    /* a CoreWindow: the pane is the foreground one's */
+    if (!window) return E_INVALIDARG;
+    return fip_AdviseWithHWND( iface, NULL, handler, cookie );
+}
+
+static HRESULT WINAPI fip_Unadvise( IFrameworkInputPane *iface, DWORD cookie )
+{
+    struct framework_pane *impl = impl_from_IFrameworkInputPane( iface );
+    struct pane_advise *advise, *found = NULL;
+
+    TRACE( "iface %p, cookie %lu.\n", iface, cookie );
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( advise, &impl->advises, struct pane_advise, entry )
+    {
+        if (advise->cookie != cookie) continue;
+        list_remove( &advise->entry );
+        found = advise;
+        break;
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (!found) return E_INVALIDARG;
+    free_advise( found );
+    return S_OK;
+}
+
+static HRESULT WINAPI fip_Location( IFrameworkInputPane *iface, RECT *location )
+{
+    IInputPane *pane;
+    Rect rect = {0};
+
+    TRACE( "iface %p, location %p.\n", iface, location );
+
+    if (!location) return E_POINTER;
+    SetRectEmpty( location );
+    if ((pane = window_input_pane( GetForegroundWindow() )))
+    {
+        IInputPane_get_OccludedRect( pane, &rect );
+        IInputPane_Release( pane );
+        pane_rect_to_screen( GetForegroundWindow(), &rect, location );
+    }
+    return S_OK;
+}
+
+static const IFrameworkInputPaneVtbl fip_vtbl =
+{
+    fip_QueryInterface,
+    fip_AddRef,
+    fip_Release,
+    fip_Advise,
+    fip_AdviseWithHWND,
+    fip_Unadvise,
+    fip_Location,
+};
+
+HRESULT WINAPI FrameworkInputPane_Constructor( IUnknown *outer, REFIID riid, void **out )
+{
+    struct framework_pane *impl;
+    HRESULT hr;
+
+    TRACE( "outer %p, riid %s, out %p.\n", outer, debugstr_guid( riid ), out );
+
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IFrameworkInputPane_iface.lpVtbl = &fip_vtbl;
+    impl->ref = 1;
+    list_init( &impl->advises );
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": framework_pane.cs");
+    hr = IFrameworkInputPane_QueryInterface( &impl->IFrameworkInputPane_iface, riid, out );
+    IFrameworkInputPane_Release( &impl->IFrameworkInputPane_iface );
+    return hr;
+}
