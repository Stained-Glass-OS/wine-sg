 	new_menu.c \
diff --git a/dlls/shell32/inputpane.c b/dlls/shell32/inputpane.c
new file mode 100644
index 0000000..6de91b0
--- /dev/null
+++ b/dlls/shell32/inputpane.c
@@ -0,0 +1,353 @@
+/*
+ * FrameworkInputPane (Stained Glass OS)
+ *
+ * The documented COM face of the input pane (the on-screen keyboard) that desktop programs use:
+ * IFrameworkInputPane::Advise/AdviseWithHWND register an IFrameworkInputPaneHandler that is told
+ * when the keyboard shows (with where it covers the screen) and hides; Location says where it is.
+ * Windows always has the class; Avalonia asks for it for every window (ILSpy 11, ...) and stopped
+ * with REGDB_E_CLASSNOTREG. It is the Windows.UI.ViewManagement.InputPane for the window
+ * (windows.ui: the sg-osk keyboard), whose Showing and Hiding are passed on.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
