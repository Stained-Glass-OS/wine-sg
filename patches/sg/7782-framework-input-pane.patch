 	{&CLSID_SGPdfThumbnailProvider, PdfThumbnailProvider_Constructor},
diff --git a/include/shobjidl.idl b/include/shobjidl.idl
index 6683e70..ee15159 100644
--- a/include/shobjidl.idl
+++ b/include/shobjidl.idl
@@ -4321,6 +4321,32 @@ interface IVirtualDesktopManager : IUnknown
 
 cpp_quote("DEFINE_GUID(CLSID_VirtualDesktopManager, 0xaa509086, 0x5ca9, 0x4c25, 0x8f, 0x95, 0x58, 0x9d, 0x3c, 0x07, 0xb4, 0x8a);")
 
+[
+    object,
+    uuid(226c537b-1e76-4d9e-a760-33db29922f18),
