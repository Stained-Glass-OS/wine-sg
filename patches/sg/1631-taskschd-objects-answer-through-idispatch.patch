@@ -112,6 +112,76 @@ static const struct IClassFactoryVtbl factory_vtbl =
 
 static TaskScheduler_factory TaskScheduler_cf = { { &factory_vtbl }, TaskService_create };
 
+/* Stained Glass OS: the objects' IDispatch, through the Task Scheduler
+ * type library (scripts -- VBScript, JScript, PowerShell's COM -- drive the
+ * Task Scheduler this way) */
+static ITypeLib *typelib;
+static struct { const IID *iid; ITypeInfo *info; } typeinfos[32];
+static CRITICAL_SECTION typeinfo_cs;
+static CRITICAL_SECTION_DEBUG typeinfo_cs_debug =
+{
+    0, 0, &typeinfo_cs,
+    { &typeinfo_cs_debug.ProcessLocksList, &typeinfo_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": typeinfo_cs") }
+};
+static CRITICAL_SECTION typeinfo_cs = { &typeinfo_cs_debug, -1, 0, 0, 0, 0 };
+
+HRESULT get_typeinfo(REFIID iid, ITypeInfo **info)
+{
+    HRESULT hr = S_OK;
+    unsigned int i;
+
+    *info = NULL;
+    EnterCriticalSection(&typeinfo_cs);
+#ifndef SG_MUTANT_NO_DISPATCH
+    if (!typelib) hr = LoadRegTypeLib(&LIBID_TaskScheduler, 1, 0, LOCALE_SYSTEM_DEFAULT, &typelib);
+#else
+    hr = E_NOTIMPL;
+#endif
+    for (i = 0; SUCCEEDED(hr) && i < ARRAY_SIZE(typeinfos); i++)
+    {
+        if (!typeinfos[i].iid)
+        {
+            if (FAILED(hr = ITypeLib_GetTypeInfoOfGuid(typelib, iid, &typeinfos[i].info))) break;
+            typeinfos[i].iid = iid;
+        }
+        if (IsEqualGUID(typeinfos[i].iid, iid))
+        {
+            *info = typeinfos[i].info;
+            ITypeInfo_AddRef(*info);
+            break;
+        }
+    }
+    LeaveCriticalSection(&typeinfo_cs);
+    if (FAILED(hr)) WARN("no type info for %s: %#lx\n", debugstr_guid(iid), hr);
+    else if (!*info) hr = E_OUTOFMEMORY;
+    return hr;
+}
+
+HRESULT dispatch_get_ids(REFIID iid, LPOLESTR *names, UINT count, DISPID *dispid)
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (!names || !count || !dispid) return E_INVALIDARG;
+    if (FAILED(hr = get_typeinfo(iid, &info))) return hr;
+    hr = ITypeInfo_GetIDsOfNames(info, names, count, dispid);
+    ITypeInfo_Release(info);
+    return hr;
+}
+
+HRESULT dispatch_invoke(IDispatch *iface, REFIID iid, DISPID dispid, WORD flags, DISPPARAMS *params,
+                        VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr)
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (FAILED(hr = get_typeinfo(iid, &info))) return hr;
+    hr = ITypeInfo_Invoke(info, iface, dispid, flags, params, result, excepinfo, argerr);
+    ITypeInfo_Release(info);
+    return hr;
+}
+
