From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] taskschd: the Task Scheduler's objects answer through IDispatch

Every object's GetTypeInfoCount, GetTypeInfo, GetIDsOfNames and Invoke
(68 methods, and those of every trigger kind) was E_NOTIMPL: no script --
VBScript, JScript, PowerShell's COM objects, installers' custom actions --
could make, read or delete a scheduled task. They now go through the
registered Task Scheduler type library (one cached ITypeInfo per
interface, DISP_E_BADINDEX for a type info index past 0).

Two things scripts meet on the way:
- TaskService::Connect took an optional argument a script leaves out
  (VT_ERROR, DISP_E_PARAMNOTFOUND) for a remote server name and failed;
  such arguments read as absent.
- The sddl argument of ITaskFolder::RegisterTask, RegisterTaskDefinition
  and CreateFolder is [optional], as in the SDK's IDL; without it a script
  calling with six arguments got DISP_E_BADPARAMCOUNT.

Wine's taskschd tests: no failures, as before.

Gate: test/taskdisp-gate.sh (test/taskdisp.js under cscript, 64- and
32-bit: register a task, read it back, delete it). Mutant
SG_MUTANT_NO_DISPATCH (taskschd/taskschd.c).
---
--- a/dlls/taskschd/folder.c
+++ b/dlls/taskschd/folder.c
@@ -87,29 +87,31 @@ static HRESULT WINAPI TaskFolder_QueryInterface(ITaskFolder *iface, REFIID riid,
 
 static HRESULT WINAPI TaskFolder_GetTypeInfoCount(ITaskFolder *iface, UINT *count)
 {
-    FIXME("%p,%p: stub\n", iface, count);
-    return E_NOTIMPL;
+    TRACE("%p,%p\n", iface, count);
+    *count = 1;
+    return S_OK;
 }
 
 static HRESULT WINAPI TaskFolder_GetTypeInfo(ITaskFolder *iface, UINT index, LCID lcid, ITypeInfo **info)
 {
-    FIXME("%p,%u,%lu,%p: stub\n", iface, index, lcid, info);
-    return E_NOTIMPL;
+    TRACE("%p,%u,%lu,%p\n", iface, index, lcid, info);
+    if (index) return DISP_E_BADINDEX;
+    return get_typeinfo(&IID_ITaskFolder, info);
 }
 
 static HRESULT WINAPI TaskFolder_GetIDsOfNames(ITaskFolder *iface, REFIID riid, LPOLESTR *names,
                                                 UINT count, LCID lcid, DISPID *dispid)
 {
-    FIXME("%p,%s,%p,%u,%lu,%p: stub\n", iface, debugstr_guid(riid), names, count, lcid, dispid);
-    return E_NOTIMPL;
+    TRACE("%p,%s,%p,%u,%lu,%p\n", iface, debugstr_guid(riid), names, count, lcid, dispid);
+    return dispatch_get_ids(&IID_ITaskFolder, names, count, dispid);
 }
 
 static HRESULT WINAPI TaskFolder_Invoke(ITaskFolder *iface, DISPID dispid, REFIID riid, LCID lcid, WORD flags,
                                          DISPPARAMS *params, VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr)
 {
-    FIXME("%p,%ld,%s,%04lx,%04x,%p,%p,%p,%p: stub\n", iface, dispid, debugstr_guid(riid), lcid, flags,
+    TRACE("%p,%ld,%s,%04lx,%04x,%p,%p,%p,%p\n", iface, dispid, debugstr_guid(riid), lcid, flags,
           params, result, excepinfo, argerr);
-    return E_NOTIMPL;
+    return dispatch_invoke((IDispatch *)iface, &IID_ITaskFolder, dispid, flags, params, result, excepinfo, argerr);
 }
 
 static HRESULT WINAPI TaskFolder_get_Name(ITaskFolder *iface, BSTR *name)
