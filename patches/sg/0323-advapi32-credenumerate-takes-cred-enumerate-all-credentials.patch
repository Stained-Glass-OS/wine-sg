From: Stained Glass OS <dev@stained-glass.example>
Subject: advapi32: CredEnumerate takes CRED_ENUMERATE_ALL_CREDENTIALS

CredEnumerateW refused every flag with ERROR_INVALID_FLAGS. Git Credential
Manager (in Git for Windows) enumerates with CRED_ENUMERATE_ALL_CREDENTIALS
and a NULL filter and matches the targets itself, so `git
credential-manager get` failed ("Failed to enumerate credentials. [0x3ec]
Invalid flags") and every push asked for the password again. The flag now
returns every credential; with a filter as well it is
ERROR_INVALID_PARAMETER, and other flags are still refused.

Gate: test/devtools-gate.sh (credenum).
---
--- a/dlls/advapi32/cred.c
+++ b/dlls/advapi32/cred.c
@@ -1014,11 +1014,18 @@
 
     TRACE("(%s, 0x%lx, %p, %p)\n", debugstr_w(Filter), Flags, Count, Credentials);
 
-    if (Flags)
+    /* CRED_ENUMERATE_ALL_CREDENTIALS: every credential, with no filter (Git
+     * Credential Manager enumerates so and filters them itself) */
+    if (Flags & ~CRED_ENUMERATE_ALL_CREDENTIALS)
     {
         SetLastError(ERROR_INVALID_FLAGS);
         return FALSE;
     }
+    if (Flags && Filter)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
 
     ret = open_cred_mgr_key(&hkeyMgr, FALSE);
     if (ret != ERROR_SUCCESS)
--- a/include/wincred.h
+++ b/include/wincred.h
@@ -251,6 +251,9 @@
 /* flags for CredWrite and CredWriteDomainCredentials */
 #define CRED_PRESERVE_CREDENTIAL_BLOB               0x00000001
 
+/* values for CredEnumerate flags */
+#define CRED_ENUMERATE_ALL_CREDENTIALS              0x00000001
+
 WINADVAPI BOOL  WINAPI CredDeleteA(LPCSTR,DWORD,DWORD);
 WINADVAPI BOOL  WINAPI CredDeleteW(LPCWSTR,DWORD,DWORD);
 #define                CredDelete WINELIB_NAME_AW(CredDelete)
