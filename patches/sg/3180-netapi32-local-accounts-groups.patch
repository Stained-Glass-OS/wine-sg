+/* Where the accounts live on this system:
+ *
+ *  - A person's account is a Unix account (uid 1000..59999) in the sgwine
+ *    group; an administrator is also in sg-admins. They are created, removed
+ *    and given a new password or type by sg-admind (verbs user-add,
+ *    user-remove, user-password, user-type), whose spool only an elevated
+ *    program (SYSTEM) can write. /etc/passwd and /etc/group are read to see
+ *    them (SG_ACCOUNTS_ROOT names another directory, for tests).
+ *  - The local group Administrators is the administrator accounts: adding a
+ *    local account to it makes the account an administrator, removing it makes
+ *    the account standard. The local group Users is the standard accounts.
+ *  - Every other local group, and members that are not local accounts (well
+ *    known SIDs, domain accounts), are kept in the prefix registry
+ *    (HKLM\Software\Wine\SG\LocalGroups\NAME: Comment, Members) and change no
+ *    Unix group.
+ *
+ * Every change needs an administrator (ERROR_ACCESS_DENIED otherwise). Without
+ * sg-admind (a plain Wine) local accounts are the process-local list that
+ * netapi32.c keeps, and Administrators/Users membership is recorded in the
+ * registry like any other group. */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "winreg.h"
+#include "sddl.h"
+#include "lm.h"
+#include "lmaccess.h"
+#include "lmapibuf.h"
+#include "wine/debug.h"
+#include "wine/sgfirewall.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(netapi32);
+
+extern BOOL sg_is_administrator(void);
+extern BOOL sg_admind_present(void);
+extern BOOL sg_account_exists(const WCHAR *name);
+extern DWORD sg_admin_change(const WCHAR *const *fields, int n);
+
+static const WCHAR groups_key[] = L"Software\\Wine\\SG\\LocalGroups";
+
+static const struct { const WCHAR *name, *comment; } builtin_groups[] =
+{
+    { L"Administrators",       L"Administrators have complete and unrestricted access to the computer" },
+    { L"Backup Operators",     L"Backup Operators can override security restrictions for the sole purpose of backing up or restoring files" },
+    { L"Guests",               L"Guests have the same access as members of the Users group by default, except for the Guest account which is further restricted" },
+    { L"Power Users",          L"Power Users are included for backwards compatibility and possess limited administrative powers" },
+    { L"Remote Desktop Users", L"Members in this group are granted the right to logon remotely" },
+    { L"Users",                L"Users are prevented from making accidental or intentional system-wide changes and can run most applications" },
+};
+
+static BOOL is_builtin( const WCHAR *name )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(builtin_groups); i++) if (!wcsicmp( name, builtin_groups[i].name )) return TRUE;
+    return FALSE;
+}
+
+/* ---- the Unix account files -------------------------------------------------------------- */
+
+static char *read_account_file( const WCHAR *file )
+{
+    WCHAR dir[MAX_PATH + 16], path[MAX_PATH + 32];
+    HANDLE h;
+    DWORD size, got = 0;
+    char *text;
+
+    sgfw_unix_path( L"SG_ACCOUNTS_ROOT", L"/etc", dir, ARRAY_SIZE(dir) );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", dir, file );
+    h = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL );
+    if (h == INVALID_HANDLE_VALUE) return NULL;
+    size = GetFileSize( h, NULL );
+    if (size == INVALID_FILE_SIZE || size > (1 << 22) || !(text = malloc( size + 1 ))) { CloseHandle( h ); return NULL; }
+    ReadFile( h, text, size, &got, NULL );
+    CloseHandle( h );
+    text[got] = 0;
+    return text;
+}
+
+static void to_utf8( const WCHAR *in, char *out, int len )
+{
+    if (!WideCharToMultiByte( CP_UTF8, 0, in, -1, out, len, NULL, NULL )) out[0] = 0;
+}
+
+static WCHAR *dup_utf8( const char *s, int len )
+{
+    WCHAR *w;
+    int n = MultiByteToWideChar( CP_UTF8, 0, s, len, NULL, 0 );
+    if (!(w = malloc( (n + 1) * sizeof(WCHAR) ))) return NULL;
+    MultiByteToWideChar( CP_UTF8, 0, s, len, w, n );
+    w[n] = 0;
+    return w;
+}
+
+static const char *const reserved_names[] = { "root", "sgsystem", "sguser", "sggreet", "nobody", "daemon", "bin",
+                                              "sys", "admin", "administrator", "guest", "system" };
+
+struct passwd_line { char name[128]; unsigned int uid, gid; };
+
+/* the next /etc/passwd line at *pos; FALSE at the end */
+static BOOL next_passwd( const char **pos, struct passwd_line *e )
+{
+    const char *p = *pos, *end;
+    int field;
+
+    while (*p)
+    {
+        const char *f[7];
+        end = strchr( p, '\n' );
+        if (!end) end = p + strlen( p );
+        f[0] = p;
+        for (field = 1; field < 4 && f[field - 1]; field++)
+        {
+            f[field] = memchr( f[field - 1], ':', end - f[field - 1] );
+            if (f[field]) f[field]++;
+        }
+        if (field == 4 && f[3])
+        {
+            const char *c1 = f[1] - 1;
+            size_t n = c1 - f[0];
+            if (n && n < sizeof(e->name))
+            {
+                memcpy( e->name, f[0], n );
+                e->name[n] = 0;
+                e->uid = strtoul( f[2], NULL, 10 );
+                e->gid = strtoul( f[3], NULL, 10 );
+                *pos = *end ? end + 1 : end;
+                return TRUE;
+            }
+        }
+        p = *end ? end + 1 : end;
+    }
+    *pos = p;
+    return FALSE;
+}
+
+static BOOL local_person( const struct passwd_line *e )
+{
+    unsigned int i;
+    if (e->uid < 1000 || e->uid >= 60000) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(reserved_names); i++) if (!strcmp( e->name, reserved_names[i] )) return FALSE;
+    return TRUE;
+}
+
+/* membership of the Unix group in /etc/group text: listed, or by primary gid */
+static BOOL in_unix_group( const char *groups, const char *group, const struct passwd_line *e )
+{
+    const char *p = groups;
+    size_t glen = strlen( group );
+
+    while (p && *p)
+    {
+        const char *end = strchr( p, '\n' ), *c;
+        if (!end) end = p + strlen( p );
+        if (!strncmp( p, group, glen ) && p[glen] == ':')
+        {
+            char *list;
+            const char *gid;
+            c = p + glen + 1;
+            c = memchr( c, ':', end - c );                /* after the password */
+            if (c)
+            {
+                gid = ++c;
+                if ((unsigned int)strtoul( gid, NULL, 10 ) == e->gid) return TRUE;
+                c = memchr( c, ':', end - c );
+                if (c)
+                {
+                    size_t n = end - (c + 1);
+                    if ((list = malloc( n + 3 )))
+                    {
+                        const char *hit;
+                        size_t elen = strlen( e->name );
+                        list[0] = ','; memcpy( list + 1, c + 1, n ); list[n + 1] = ','; list[n + 2] = 0;
+                        for (hit = list; (hit = strstr( hit, e->name )); hit++)
+                            if (hit > list && hit[-1] == ',' && hit[elen] == ',') { free( list ); return TRUE; }
+                        free( list );
+                    }
+                }
+            }
+            return FALSE;
+        }
+        p = *end ? end + 1 : end;
+    }
+    return FALSE;
+}
+
+static const char *env_group( const WCHAR *var, const char *def, char *buf, int len )
+{
+    WCHAR w[64];
+    if (GetEnvironmentVariableW( var, w, ARRAY_SIZE(w) ) && w[0]) { to_utf8( w, buf, len ); return buf; }
+    return def;
+}
+
+/* the local accounts (people), as names; admin: 0 all, 1 administrators only, 2 standard only */
+static DWORD list_accounts( int admin, WCHAR ***names, DWORD *count )
+{
+    char abuf[64], wbuf[64], *passwd, *group;
+    const char *agroup = env_group( L"SG_ADMIN_GROUP", "sg-admins", abuf, sizeof(abuf) );
+    const char *wgroup = env_group( L"SG_WINE_GROUP", "sgwine", wbuf, sizeof(wbuf) );
+    const char *pos;
+    struct passwd_line e;
+    WCHAR **list = NULL;
+    DWORD n = 0, cap = 0;
+
+    *names = NULL; *count = 0;
+    if (!(passwd = read_account_file( L"passwd" ))) return NERR_Success;
+    group = read_account_file( L"group" );
+    for (pos = passwd; next_passwd( &pos, &e ); )
+    {
+        BOOL is_admin;
+        if (!local_person( &e )) continue;
+        if (!group || !in_unix_group( group, wgroup, &e )) continue;
+        is_admin = in_unix_group( group, agroup, &e );
+        if ((admin == 1 && !is_admin) || (admin == 2 && is_admin)) continue;
+        if (n == cap)
+        {
+            WCHAR **bigger = realloc( list, (cap = cap ? cap * 2 : 8) * sizeof(*list) );
+            if (!bigger) break;
+            list = bigger;
+        }
+        if (!(list[n] = dup_utf8( e.name, -1 ))) break;
+        n++;
+    }
+    free( passwd ); free( group );
+    *names = list; *count = n;
+    return NERR_Success;
+}
+
+static void free_names( WCHAR **list, DWORD n )
+{
+    DWORD i;
+    for (i = 0; i < n; i++) free( list[i] );
+    free( list );
+}
+
+BOOL sg_account_exists( const WCHAR *name )
+{
+    WCHAR **list;
+    DWORD i, n;
+    BOOL found = FALSE;
+
+    if (!name || !name[0]) return FALSE;
+    list_accounts( 0, &list, &n );
+    for (i = 0; i < n; i++) if (!wcsicmp( list[i], name )) found = TRUE;
+    free_names( list, n );
+    return found;
+}
+
+static BOOL account_is_admin( const WCHAR *name )
+{
+    WCHAR **list;
+    DWORD i, n;
+    BOOL found = FALSE;
+
+    list_accounts( 1, &list, &n );
+    for (i = 0; i < n; i++) if (!wcsicmp( list[i], name )) found = TRUE;
+    free_names( list, n );
+    return found;
+}
+
+/* ---- sg-admind --------------------------------------------------------------------------- */
+
+BOOL sg_admind_present(void)
+{
+    WCHAR dir[MAX_PATH + 16], path[MAX_PATH + 32];
+    DWORD attr;
+
+    sgfw_unix_path( L"SG_ADMIN_SPOOL", L"/run/stained-glass-admin", dir, ARRAY_SIZE(dir) );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\requests", dir );
+    attr = GetFileAttributesW( path );
+    return attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+BOOL sg_is_administrator(void)
+{
+    SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    PSID admins;
+    BOOL member = FALSE;
+
+    if (!AllocateAndInitializeSid( &nt, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS, 0, 0, 0, 0, 0, 0, &admins ))
+        return FALSE;
+#ifdef SG_MUTANT_ACCT_NOADMIN
+    member = TRUE;
+#else
+    if (!CheckTokenMembership( NULL, admins, &member )) member = FALSE;
+#endif
+    FreeSid( admins );
+    return member;
+}
+
+/* a request to sg-admind, its refusal reason as a Network Management error */
+DWORD sg_admin_change( const WCHAR *const *fields, int n )
+{
+    WCHAR msg[256];
+    DWORD err = sgfw_admin_request( fields, n, 30000, msg, ARRAY_SIZE(msg) );
+
+    if (!err) return NERR_Success;
+    if (err == ERROR_PRIVILEGE_NOT_HELD) return ERROR_ACCESS_DENIED;
+    if (err == ERROR_TIMEOUT) return NERR_InternalError;
+    if (wcsstr( msg, L"already an account" )) return NERR_UserExists;
+    if (wcsstr( msg, L"only administrator" )) return ERROR_LAST_ADMIN;
+    if (wcsstr( msg, L"no account named" )) return NERR_UserNotFound;
+    if (wcsstr( msg, L"password" ) || wcsstr( msg, L"Password" )) return NERR_PasswordTooShort;
+    if (wcsstr( msg, L"valid account name" ) || wcsstr( msg, L"reserved" )) return NERR_BadUsername;
+    return ERROR_ACCESS_DENIED;
+}
+
+DWORD sg_user_add( const WCHAR *name, const WCHAR *password )
+{
+    const WCHAR *f[5] = { L"user-add", name, L"", L"standard", password };
+    if (!sg_is_administrator()) return ERROR_ACCESS_DENIED;
+    return sg_admin_change( f, 5 );
+}
+
+DWORD sg_user_del( const WCHAR *name )
+{
+    const WCHAR *f[3] = { L"user-remove", name, L"keep" };
+    if (!sg_is_administrator()) return ERROR_ACCESS_DENIED;
+    return sg_admin_change( f, 3 );
+}
+
+DWORD sg_user_password( const WCHAR *name, const WCHAR *password )
+{
+    const WCHAR *f[3] = { L"user-password", name, password };
+    if (!sg_is_administrator()) return ERROR_ACCESS_DENIED;
+    return sg_admin_change( f, 3 );
+}
+
+/* ---- the groups in the registry ----------------------------------------------------------- */
+
+static HKEY open_group( const WCHAR *name, BOOL create )
+{
+    WCHAR path[256 + 64];
+    HKEY key = NULL;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", groups_key, name );
+    if (create) RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL );
+    else RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_ALL_ACCESS, &key );
+    return key;
+}
+
+static BOOL group_exists( const WCHAR *name )
+{
+    HKEY key;
+    if (is_builtin( name )) return TRUE;
+    if (!(key = open_group( name, FALSE ))) return FALSE;
+    RegCloseKey( key );
+    return TRUE;
+}
+
+/* a multi-string of the members recorded for the group (malloc'd, double-zero terminated) */
+static WCHAR *recorded_members( const WCHAR *group, DWORD *chars )
+{
+    HKEY key = open_group( group, FALSE );
+    DWORD type, size = 0;
+    WCHAR *data = NULL;
+
+    *chars = 0;
+    if (key && !RegQueryValueExW( key, L"Members", NULL, &type, NULL, &size ) && type == REG_MULTI_SZ && size >= 2 * sizeof(WCHAR))
+    {
+        if ((data = malloc( size + 2 * sizeof(WCHAR) )))
+        {
+            if (RegQueryValueExW( key, L"Members", NULL, &type, (BYTE *)data, &size )) { free( data ); data = NULL; }
+            else { data[size / sizeof(WCHAR)] = 0; data[size / sizeof(WCHAR) + 1] = 0; *chars = size / sizeof(WCHAR); }
+        }
+    }
+    if (key) RegCloseKey( key );
+    return data;
+}
+
+static DWORD store_members( const WCHAR *group, const WCHAR *const *names, DWORD n )
+{
+    HKEY key = open_group( group, TRUE );
+    DWORD i, total = 1;
+    WCHAR *buf, *p;
+    LSTATUS ret;
+
+    if (!key) return ERROR_ACCESS_DENIED;
+    for (i = 0; i < n; i++) total += wcslen( names[i] ) + 1;
+    if (!(buf = malloc( (total + 1) * sizeof(WCHAR) ))) { RegCloseKey( key ); return ERROR_NOT_ENOUGH_MEMORY; }
+    for (p = buf, i = 0; i < n; i++) { wcscpy( p, names[i] ); p += wcslen( p ) + 1; }
+    *p++ = 0;
+    if (!n) *p++ = 0;
+    ret = RegSetValueExW( key, L"Members", 0, REG_MULTI_SZ, (BYTE *)buf, (p - buf) * sizeof(WCHAR) );
+    free( buf );
+    RegCloseKey( key );
+    return ret ? ERROR_ACCESS_DENIED : NERR_Success;
+}
+
+static void computer_name( WCHAR *buf, DWORD len )
+{
+    DWORD size = len;
+    if (!GetComputerNameW( buf, &size )) wcscpy( buf, L"COMPUTER" );
+}
+
+/* The members of a group as "DOMAIN\name" strings (malloc'd array of malloc'd strings). */
+DWORD sg_localgroup_members( const WCHAR *group, WCHAR ***out, DWORD *count )
+{
+    WCHAR comp[MAX_COMPUTERNAME_LENGTH + 1], **accts = NULL, *rec, *p, **list = NULL;
+    DWORD i, n = 0, na = 0, chars, total;
+    int implicit = !wcsicmp( group, L"Administrators" ) ? 1 : !wcsicmp( group, L"Users" ) ? 2 : 0;
+
+    *out = NULL; *count = 0;
+    if (!group_exists( group )) return NERR_GroupNotFound;
+    computer_name( comp, ARRAY_SIZE(comp) );
+    if (implicit) list_accounts( implicit, &accts, &na );
+    if (implicit == 1 && !na && sg_is_administrator())
+    {
+        /* no administrator account is known (a plain Wine): the user running this one is one */
+        WCHAR user[UNLEN + 1];
+        DWORD len = ARRAY_SIZE(user);
+        if (GetUserNameW( user, &len ) && (accts = calloc( 1, sizeof(*accts) )) && (accts[0] = malloc( len * sizeof(WCHAR) )))
+        {
+            wcscpy( accts[0], user );
+            na = 1;
+        }
+    }
+    rec = recorded_members( group, &chars );
+    total = na;
+    if (rec) for (p = rec; *p; p += wcslen( p ) + 1) total++;
+    if (total && !(list = calloc( total, sizeof(*list) ))) { free_names( accts, na ); free( rec ); return ERROR_NOT_ENOUGH_MEMORY; }
+    for (i = 0; i < na; i++)
+    {
+        if ((list[n] = malloc( (wcslen( comp ) + wcslen( accts[i] ) + 2) * sizeof(WCHAR) )))
+            { swprintf( list[n], wcslen( comp ) + wcslen( accts[i] ) + 2, L"%s\\%s", comp, accts[i] ); n++; }
+    }
+    if (rec)
+        for (p = rec; *p; p += wcslen( p ) + 1)
+        {
+            DWORD j;
+            for (j = 0; j < n; j++) if (!wcsicmp( list[j], p )) break;
+            if (j < n) continue;
+            if ((list[n] = malloc( (wcslen( p ) + 1) * sizeof(WCHAR) ))) { wcscpy( list[n], p ); n++; }
+        }
+    free_names( accts, na ); free( rec );
+    *out = list; *count = n;
+    return NERR_Success;
+}
+
+/* A member as given by the caller: level 0 a SID, level 3 "DOMAIN\name" or "name". */
+struct member
+{
+    WCHAR display[MAX_COMPUTERNAME_LENGTH + UNLEN + 4];  /* the entry as listed and recorded */
+    WCHAR user[UNLEN + 1];                               /* the local account, if it is one */
+    BOOL local;
+};
+
+static DWORD resolve_member( DWORD level, const BYTE *buf, DWORD index, struct member *m )
+{
+    WCHAR comp[MAX_COMPUTERNAME_LENGTH + 1], name[UNLEN + 1], domain[MAX_COMPUTERNAME_LENGTH + 64], text[300];
+    const WCHAR *given = NULL, *slash;
+    SID_NAME_USE use;
+    DWORD nlen = ARRAY_SIZE(name), dlen = ARRAY_SIZE(domain);
+
+    memset( m, 0, sizeof(*m) );
+    computer_name( comp, ARRAY_SIZE(comp) );
+    if (level == 0)
+    {
+        PSID sid = ((const LOCALGROUP_MEMBERS_INFO_0 *)buf)[index].lgrmi0_sid;
+        if (!sid || !IsValidSid( sid )) return ERROR_NO_SUCH_MEMBER;
+        if (!LookupAccountSidW( NULL, sid, name, &nlen, domain, &dlen, &use )) return ERROR_NO_SUCH_MEMBER;
+        swprintf( text, ARRAY_SIZE(text), L"%s\\%s", domain, name );
+        given = text;
+    }
+    else if (level == 3) given = ((const LOCALGROUP_MEMBERS_INFO_3 *)buf)[index].lgrmi3_domainandname;
+    else return ERROR_INVALID_LEVEL;
+    if (!given || !given[0]) return ERROR_NO_SUCH_MEMBER;
+
+    if ((slash = wcschr( given, '\\' )))
+    {
+        size_t dl = slash - given;
+        if (!dl || (dl == wcslen( comp ) && !wcsnicmp( given, comp, dl )) || (dl == 1 && given[0] == '.'))
+            lstrcpynW( name, slash + 1, ARRAY_SIZE(name) ), dl = 0;
+        else
+        {
+            /* a domain account or a well known one: it has to resolve */
+            dlen = ARRAY_SIZE(domain);
+            if (wcslen( given ) >= ARRAY_SIZE(m->display)) return ERROR_NO_SUCH_MEMBER;
+            {
+                BYTE sidbuf[SECURITY_MAX_SID_SIZE];
+                DWORD sl = sizeof(sidbuf);
+                if (!LookupAccountNameW( NULL, given, sidbuf, &sl, domain, &dlen, &use )) return ERROR_NO_SUCH_MEMBER;
+            }
+            wcscpy( m->display, given );
+            return NERR_Success;
+        }
+        if (dl) return ERROR_NO_SUCH_MEMBER;
+    }
+    else
+    {
+        if (wcslen( given ) > UNLEN) return ERROR_NO_SUCH_MEMBER;
+        wcscpy( name, given );
+    }
+    if (sg_account_exists( name ))
+    {
+        m->local = TRUE;
+        wcscpy( m->user, name );
+        swprintf( m->display, ARRAY_SIZE(m->display), L"%s\\%s", comp, name );
+        return NERR_Success;
+    }
+    /* a name the system knows (a built-in account, a user of this prefix) */
+    {
+        BYTE sidbuf[SECURITY_MAX_SID_SIZE];
+        DWORD sl = sizeof(sidbuf);
+        dlen = ARRAY_SIZE(domain);
+        if (!LookupAccountNameW( NULL, name, sidbuf, &sl, domain, &dlen, &use )) return ERROR_NO_SUCH_MEMBER;
+        swprintf( m->display, ARRAY_SIZE(m->display), L"%s\\%s", dlen ? domain : comp, name );
+    }
+    return NERR_Success;
+}
+
+static BOOL listed( WCHAR **list, DWORD n, const WCHAR *display )
+{
+    DWORD i;
+    for (i = 0; i < n; i++) if (!wcsicmp( list[i], display )) return TRUE;
+    return FALSE;
+}
+
+/* the change of one resolved member; add or remove */
+static DWORD apply_member( const WCHAR *group, const struct member *m, BOOL add )
+{
+    int implicit = !wcsicmp( group, L"Administrators" ) ? 1 : !wcsicmp( group, L"Users" ) ? 2 : 0;
+    WCHAR *rec, *p, **keep = NULL;
+    DWORD chars, n = 0, ret, i;
+
+#ifdef SG_MUTANT_ACCT_NOTYPE
+    if (0)
+#else
+    if (m->local && implicit && sg_admind_present())
+#endif
+    {
+        BOOL admin = account_is_admin( m->user );
+        if (implicit == 1)
+        {
+            const WCHAR *f[3] = { L"user-type", m->user, add ? L"administrator" : L"standard" };
+            if (add == admin) return NERR_Success;
+            return sg_admin_change( f, 3 );
+        }
+        /* Users: a standard account is a member by being one */
+        if (!admin) return add ? NERR_Success : ERROR_ACCESS_DENIED;
+    }
+    rec = recorded_members( group, &chars );
+    if (rec) for (p = rec; *p; p += wcslen( p ) + 1) n++;
+    if (!(keep = calloc( n + 1, sizeof(*keep) ))) { free( rec ); return ERROR_NOT_ENOUGH_MEMORY; }
+    n = 0;
+    if (rec) for (p = rec; *p; p += wcslen( p ) + 1) if (add || wcsicmp( p, m->display )) keep[n++] = p;
+    if (add) keep[n++] = (WCHAR *)m->display;
+    ret = store_members( group, (const WCHAR *const *)keep, n );
+    (void)i;
+    free( keep ); free( rec );
+    return ret;
+}
+
+/* mode 0 add, 1 delete, 2 set */
+DWORD sg_localgroup_change( const WCHAR *group, DWORD level, const BYTE *buf, DWORD total, int mode )
+{
+    struct member *m;
+    WCHAR **cur;
+    DWORD i, j, ncur, ret;
+
+    if (level != 0 && level != 3) return ERROR_INVALID_LEVEL;
+    if (!group || !group[0]) return NERR_GroupNotFound;
+    if (!sg_is_administrator()) return ERROR_ACCESS_DENIED;
+    if (!group_exists( group )) return NERR_GroupNotFound;
+    if (total && !buf) return ERROR_INVALID_PARAMETER;
+    if (!(m = calloc( total + 1, sizeof(*m) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    if ((ret = sg_localgroup_members( group, &cur, &ncur ))) { free( m ); return ret; }
+
+    /* nothing changes when any member is wrong */
+    for (i = 0; i < total && !ret; i++)
+    {
+        if ((ret = resolve_member( level, buf, i, &m[i] ))) break;
+        if (mode == 0 && listed( cur, ncur, m[i].display )) ret = ERROR_MEMBER_IN_ALIAS;
+        if (mode == 1 && !listed( cur, ncur, m[i].display )) ret = ERROR_MEMBER_NOT_IN_ALIAS;
+    }
+    if (ret) goto done;
+
+    if (mode == 2)
+    {
+        /* take out what is not in the new list, then add what is missing */
+        for (j = 0; j < ncur && !ret; j++)
+        {
+            struct member old = {0};
+            BOOL keep = FALSE;
+            WCHAR *bs = wcschr( cur[j], '\\' );
+            for (i = 0; i < total; i++) if (!wcsicmp( m[i].display, cur[j] )) keep = TRUE;
+            if (keep) continue;
+            lstrcpynW( old.display, cur[j], ARRAY_SIZE(old.display) );
+            if (bs && sg_account_exists( bs + 1 )) { old.local = TRUE; wcscpy( old.user, bs + 1 ); }
+            ret = apply_member( group, &old, FALSE );
+        }
+        for (i = 0; i < total && !ret; i++)
+            if (!listed( cur, ncur, m[i].display )) ret = apply_member( group, &m[i], TRUE );
+    }
+    else for (i = 0; i < total && !ret; i++) ret = apply_member( group, &m[i], mode == 0 );
+done:
+    free_names( cur, ncur );
+    free( m );
+    return ret;
+}
+
+static BOOL valid_group_name( const WCHAR *name )
+{
+    size_t len;
+    if (!name || !(len = wcslen( name )) || len > 256 || name[len - 1] == '.') return FALSE;
+    for (; *name; name++)
+        if (*name < 32 || wcschr( L"\"/\\[]:|<>+=;,?*", *name )) return FALSE;
+    return TRUE;
+}
+
+DWORD sg_localgroup_add( const WCHAR *name, const WCHAR *comment, DWORD *parm_err )
+{
+    HKEY key;
+
+    TRACE( "%s\n", debugstr_w( name ));
+    if (!valid_group_name( name )) { if (parm_err) *parm_err = LOCALGROUP_NAME_PARMNUM; return ERROR_INVALID_PARAMETER; }
+    if (!sg_is_administrator()) return ERROR_ACCESS_DENIED;
+    if (group_exists( name )) return ERROR_ALIAS_EXISTS;
+    if (sg_account_exists( name )) return NERR_UserExists;
+    if (!(key = open_group( name, TRUE ))) return ERROR_ACCESS_DENIED;
+    if (comment) RegSetValueExW( key, L"Comment", 0, REG_SZ, (const BYTE *)comment, (wcslen( comment ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    return NERR_Success;
+}
+
+DWORD sg_localgroup_del( const WCHAR *name )
+{
+    WCHAR path[256 + 64];
+
+    if (!name || !name[0]) return NERR_GroupNotFound;
+    if (!sg_is_administrator()) return ERROR_ACCESS_DENIED;
+    if (is_builtin( name )) return ERROR_SPECIAL_ACCOUNT;
+    if (!group_exists( name )) return NERR_GroupNotFound;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", groups_key, name );
+    return RegDeleteTreeW( HKEY_LOCAL_MACHINE, path ) ? ERROR_ACCESS_DENIED : NERR_Success;
+}
+
+/* the group's comment (malloc'd, may be empty) */
+DWORD sg_localgroup_comment( const WCHAR *name, WCHAR **comment )
+{
+    HKEY key;
+    DWORD type, size = 0, i;
+    WCHAR *text = NULL;
+
+    *comment = NULL;
+    if (!name || !group_exists( name )) return NERR_GroupNotFound;
+    if ((key = open_group( name, FALSE )))
+    {
+        if (!RegQueryValueExW( key, L"Comment", NULL, &type, NULL, &size ) && type == REG_SZ && (text = malloc( size + 2 )))
+        {
+            if (RegQueryValueExW( key, L"Comment", NULL, &type, (BYTE *)text, &size )) { free( text ); text = NULL; }
+            else text[size / sizeof(WCHAR)] = 0;
+        }
+        RegCloseKey( key );
+    }
+    if (!text)
+    {
+        const WCHAR *def = L"";
+        for (i = 0; i < ARRAY_SIZE(builtin_groups); i++) if (!wcsicmp( name, builtin_groups[i].name )) def = builtin_groups[i].comment;
+        text = malloc( (wcslen( def ) + 1) * sizeof(WCHAR) );
+        if (text) wcscpy( text, def );
+    }
+    *comment = text;
+    return text ? NERR_Success : ERROR_NOT_ENOUGH_MEMORY;
+}
+
+DWORD sg_localgroup_setinfo( const WCHAR *name, const WCHAR *comment )
+{
+    HKEY key;
+
+    if (!name || !group_exists( name )) return NERR_GroupNotFound;
+    if (!sg_is_administrator()) return ERROR_ACCESS_DENIED;
+    if (!(key = open_group( name, TRUE ))) return ERROR_ACCESS_DENIED;
+    RegSetValueExW( key, L"Comment", 0, REG_SZ, (const BYTE *)comment, (wcslen( comment ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    return NERR_Success;
+}
+
+/* every local group name: the built-in ones, then those created */
+DWORD sg_localgroup_names( WCHAR ***out, DWORD *count )
+{
+    HKEY key;
+    WCHAR **list, name[260];
+    DWORD i, n = 0, extra = 0, len;
+
+    *out = NULL; *count = 0;
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, groups_key, 0, KEY_READ, &key ))
+    {
+        RegQueryInfoKeyW( key, NULL, NULL, NULL, &extra, NULL, NULL, NULL, NULL, NULL, NULL, NULL );
+    }
+    else key = NULL;
+    if (!(list = calloc( ARRAY_SIZE(builtin_groups) + extra + 1, sizeof(*list) ))) { if (key) RegCloseKey( key ); return ERROR_NOT_ENOUGH_MEMORY; }
+    for (i = 0; i < ARRAY_SIZE(builtin_groups); i++)
+    {
+        if ((list[n] = malloc( (wcslen( builtin_groups[i].name ) + 1) * sizeof(WCHAR) ))) wcscpy( list[n++], builtin_groups[i].name );
+    }
+    for (i = 0; key && i < extra; i++)
+    {
+        len = ARRAY_SIZE(name);
+        if (RegEnumKeyExW( key, i, name, &len, NULL, NULL, NULL, NULL )) break;
+        if (is_builtin( name )) continue;
+        if ((list[n] = malloc( (len + 1) * sizeof(WCHAR) ))) { wcscpy( list[n], name ); n++; }
+    }
+    if (key) RegCloseKey( key );
+    *out = list; *count = n;
+    return NERR_Success;
+}
+
+void sg_free_names( WCHAR **list, DWORD n ) { free_names( list, n ); }
