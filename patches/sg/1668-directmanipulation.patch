+/* milliseconds since the first call: small enough for a float's precision */
+static float now_ms(void)
+{
+    static LONGLONG base;
+    LARGE_INTEGER counter, freq;
+
+    QueryPerformanceCounter( &counter );
+    QueryPerformanceFrequency( &freq );
+    if (!base) base = counter.QuadPart;
+    return (float)((double)(counter.QuadPart - base) * 1000.0 / freq.QuadPart);
+}
