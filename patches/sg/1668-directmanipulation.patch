+static void xform_to_matrix( const struct xform *x, float *matrix, DWORD count )
+{
+    float m[6] = { x->s, 0.0f, 0.0f, x->s, x->tx, x->ty };
+    memcpy( matrix, m, min( count, 6 ) * sizeof(float) );
