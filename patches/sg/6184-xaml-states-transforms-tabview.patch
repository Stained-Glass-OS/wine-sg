+/* Storyboard: begun, its end values are set at once; Completed comes from the message loop */
+struct begun
+{
+    struct list entry;
+    UINT_PTR timer;
+    struct anim *anim;              /* held while begun */
+};
+static struct list begun = LIST_INIT( begun );
+
+static void CALLBACK storyboard_completed( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
+{
+    struct begun *entry, *found = NULL;
+
+    KillTimer( NULL, id );
+    LIST_FOR_EACH_ENTRY( entry, &begun, struct begun, entry )
+        if (entry->timer == id) { found = entry; break; }
+    if (!found) return;
+    list_remove( &found->entry );
+    found->anim->timer = 0;
+#ifndef SG_MUTANT_STORYBOARD_NO_COMPLETED
+    xaml_raise_routed( &found->anim->h1, anim_outer( found->anim ), NULL );
+#endif
+    IUnknown_Release( found->anim->d.obj.outer );
+    free( found );
+}
+
+static HRESULT WINAPI storyboard_get_Children( struct xiface *iface, IInspectable **value )
+{
+    struct anim *anim = anim_from_iface( iface );
+    return get_vector( anim, &anim->v1, &objects_type, value );
+}
+
+static HRESULT WINAPI storyboard_Begin( struct xiface *iface )
+{
+    struct anim *anim = anim_from_iface( iface );
+
+    TRACE( "%p\n", anim );
+#ifdef SG_MUTANT_STORYBOARD_NOT_BEGUN
+    return S_OK;
+#endif
+    applied_clear( anim );
+    apply_storyboard( anim, NULL, anim );
+    if (!anim->timer)
+    {
+        struct begun *entry = calloc( 1, sizeof(*entry) );
+        if (entry && (entry->timer = SetTimer( NULL, 0, 0, storyboard_completed )))
+        {
+            IUnknown_AddRef( anim->d.obj.outer );
+            entry->anim = anim;
+            anim->timer = entry->timer;
