+static const void *ecp_statics_vtbl[] =
+{
+    IElementCompositionPreviewStatics_FSTUBS,
+    [IElementCompositionPreviewStatics_GetElementVisual] = ecp_GetElementVisual,
+    [IElementCompositionPreviewStatics_GetElementChildVisual] = ecp_GetElementChildVisual,
+    [IElementCompositionPreviewStatics_SetElementChildVisual] = ecp_SetElementChildVisual,
+    [IElementCompositionPreviewStatics_GetScrollViewerManipulationPropertySet] = ecp_property_set,
+};
+
+static const void *ecp_statics2_vtbl[] =
+{
+    IElementCompositionPreviewStatics2_FSTUBS,
+    [IElementCompositionPreviewStatics2_SetImplicitShowAnimation] = ecp_SetImplicitAnimation,
+    [IElementCompositionPreviewStatics2_SetImplicitHideAnimation] = ecp_SetImplicitAnimation,
+    [IElementCompositionPreviewStatics2_SetIsTranslationEnabled] = ecp_SetIsTranslationEnabled,
+    [IElementCompositionPreviewStatics2_GetPointerPositionPropertySet] = ecp_property_set,
+};
+
+static const void *ecp_statics3_vtbl[] =
+{
+    IElementCompositionPreviewStatics3_FSTUBS,
+    [IElementCompositionPreviewStatics3_SetAppWindowContent] = ecp_SetAppWindowContent,
+    [IElementCompositionPreviewStatics3_GetAppWindowContent] = ecp_GetAppWindowContent,
+};
+
+static struct xfactory ecp_factory_obj =
+{
+    { &xfactory_vtbl }, L"Windows.UI.Xaml.Hosting.ElementCompositionPreview",
+    { &IID_IElementCompositionPreviewStatics, &IID_IElementCompositionPreviewStatics2, &IID_IElementCompositionPreviewStatics3 },
+    { { ecp_statics_vtbl }, { ecp_statics2_vtbl }, { ecp_statics3_vtbl } },
+};
+
+IActivationFactory *element_composition_preview_factory = &ecp_factory_obj.IActivationFactory_iface;
