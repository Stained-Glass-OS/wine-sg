+IActivationFactory *xaml_animation_factory( const WCHAR *name )
+{
+    unsigned int i;
+
+    for (i = 0; i < A_KINDS; i++)
+        if (!wcscmp( anim_classes[i].name, name ))
+        {
+            anim_factories[i]->name = anim_classes[i].name;
+            return &anim_factories[i]->IActivationFactory_iface;
+        }
+    return NULL;
+}
+
+/* ---- values from markup's text ---- */
+
+/* "[-][d.]h:m:s[.fffffff]", in 100 ns units */
+static BOOL parse_timespan( const WCHAR *str, INT64 *out )
+{
+    double parts[4] = { 0 }, seconds;
+    int n = 0, sign = 1;
+    const WCHAR *p = str;
+    WCHAR *end;
+    BOOL days = FALSE;
+
+    while (*p == ' ') p++;
+    if (*p == '-') { sign = -1; p++; }
+    for (;;)
+    {
+        double v = wcstod( p, &end );
+        if (end == p || n >= 4) return FALSE;
+        parts[n++] = v;
+        p = end;
+        if (*p == ':') { p++; continue; }
+        if (*p == '.' && n == 1 && wcschr( p, ':' )) { days = TRUE; p++; continue; }   /* d.h:m:s */
+        break;
+    }
+    while (*p == ' ') p++;
+    if (*p) return FALSE;
+    if (days)
+    {
+        if (n < 3) return FALSE;
+        seconds = parts[0] * 86400 + parts[1] * 3600 + parts[2] * 60 + (n > 3 ? parts[3] : 0);
+    }
+    else if (n == 3) seconds = parts[0] * 3600 + parts[1] * 60 + parts[2];
+    else if (n == 2) seconds = parts[0] * 3600 + parts[1] * 60;
+    else seconds = parts[0] * 86400;   /* a single number: days, as TimeSpan.Parse */
+    *out = (INT64)(sign * seconds * 10000000.0 + (sign > 0 ? 0.5 : -0.5));
+    return TRUE;
+}
+
+static BOOL parse_point( const WCHAR **p, struct xpoint *pt )
+{
+    WCHAR *end;
+
+    while (**p == ' ') (*p)++;
+    pt->x = wcstod( *p, &end );
+    if (end == *p) return FALSE;
+    *p = end;
+    while (**p == ' ' || **p == ',') (*p)++;
+    pt->y = wcstod( *p, &end );
+    if (end == *p) return FALSE;
+    *p = end;
+    return TRUE;
+}
+
+/* S_FALSE: not a type of ours */
+HRESULT xaml_animation_value_from_string( const WCHAR *type, const WCHAR *str, IInspectable **value )
+{
+    INT64 span;
+
+    if (!wcscmp( type, L"Windows.UI.Xaml.Duration" ))
+    {
+        struct xduration d = { 0, 0 };
+        if (!wcscmp( str, L"Forever" )) d.type = 2;
+        else if (wcscmp( str, L"Automatic" ))
+        {
+            if (!parse_timespan( str, &span )) return E_INVALIDARG;
+            d.span = span;
+            d.type = 1;
+        }
+        return (*value = xbox_ref( &IID_IReference_Duration, &d, sizeof(d) )) ? S_OK : E_OUTOFMEMORY;
+    }
+    if (!wcscmp( type, L"Windows.Foundation.TimeSpan" ) || !wcscmp( type, L"Windows.UI.Xaml.Media.Animation.KeyTime" ))
+    {
+        if (!parse_timespan( str, &span )) return E_INVALIDARG;
+        *value = xbox_ref( wcscmp( type, L"Windows.Foundation.TimeSpan" ) ? &IID_IReference_KeyTime : &IID_IReference_TimeSpan_a,
+                           &span, sizeof(span) );
+        return *value ? S_OK : E_OUTOFMEMORY;
+    }
+    if (!wcscmp( type, L"Windows.UI.Xaml.Media.Animation.RepeatBehavior" ))
+    {
+        struct xrepeat r = { 1, 0, 0 };
+        size_t len = wcslen( str );
+        if (!wcscmp( str, L"Forever" )) r.type = 2;
+        else if (len && (str[len - 1] == 'x' || str[len - 1] == 'X')) r.count = wcstod( str, NULL );
+        else if (parse_timespan( str, &span )) { r.duration = span; r.type = 1; }
+        else return E_INVALIDARG;
+        return (*value = xbox_ref( &IID_IReference_RepeatBehavior, &r, sizeof(r) )) ? S_OK : E_OUTOFMEMORY;
+    }
+    if (!wcscmp( type, L"Windows.Foundation.Point" ))
+    {
+        struct xpoint pt;
+        const WCHAR *p = str;
+        if (!parse_point( &p, &pt )) return E_INVALIDARG;
+        return (*value = xbox_ref( &IID_IReference_Point_a, &pt, sizeof(pt) )) ? S_OK : E_OUTOFMEMORY;
+    }
+    if (!wcscmp( type, L"Windows.UI.Xaml.Media.Animation.KeySpline" ))
+    {
+        struct anim *spline;
+        const WCHAR *p = str;
+        struct xpoint a, b;
+        if (!parse_point( &p, &a ) || !parse_point( &p, &b )) return E_INVALIDARG;
+        if (!(spline = new_anim( A_KEY_SPLINE, NULL ))) return E_OUTOFMEMORY;
+        spline->cp1 = a;
+        spline->cp2 = b;
+        *value = (IInspectable *)&spline->if0;
+        return S_OK;
+    }
+    return S_FALSE;
+}
