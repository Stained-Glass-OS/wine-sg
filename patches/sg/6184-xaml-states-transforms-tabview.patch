+/* a visual state's value (a setter's, an animation's held end): above the local value until cleared */
+HRESULT dobj_set_animated_value( struct dobj *obj, struct xaml_property *prop, BOOL set, IInspectable *new_value )
+{
+    IInspectable *old_value, *now;
+    struct dvalue *value;
+    HRESULT hr;
+
+    if (FAILED(hr = dobj_get_value( obj, prop, &old_value ))) return hr;
+    if (!(value = find_value( obj, prop, set )))
+    {
+        if (old_value) IInspectable_Release( old_value );
+        return set ? E_OUTOFMEMORY : S_OK;
+    }
+    if (set && new_value) IInspectable_AddRef( new_value );
+    if (value->animated) IInspectable_Release( value->animated );
+    value->animated = set ? new_value : NULL;
+    value->has_animated = set;
+    if (SUCCEEDED(dobj_get_value( obj, prop, &now )))
+    {
+        if (!values_equal( old_value, now )) notify_changed( obj, prop, old_value, now );
+        if (now) IInspectable_Release( now );
+    }
+    if (old_value) IInspectable_Release( old_value );
+    return S_OK;
+}
