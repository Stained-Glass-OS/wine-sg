+/* ---- applying values ---- */
+
+static void applied_clear( struct anim *anim )
+{
+    unsigned int i;
+
+    for (i = 0; i < anim->napplied; i++)
+    {
+        dobj_set_animated_value( anim->applied[i].obj, anim->applied[i].prop, FALSE, NULL );
+        IUnknown_Release( anim->applied[i].obj->obj.outer );
+    }
+    anim->napplied = 0;
+}
+
+static void applied_add( struct anim *anim, struct dobj *obj, struct xaml_property *prop, IInspectable *value )
+{
+    if (anim->napplied == anim->sapplied)
+    {
+        unsigned int size = anim->sapplied ? anim->sapplied * 2 : 8;
+        struct applied *list = realloc( anim->applied, size * sizeof(*list) );
+        if (!list) return;
+        anim->applied = list;
+        anim->sapplied = size;
+    }
+#ifndef SG_MUTANT_STATE_VALUES_NOT_SET
+    if (FAILED(dobj_set_animated_value( obj, prop, TRUE, value ))) return;
+#endif
+    IUnknown_AddRef( obj->obj.outer );
+    anim->applied[anim->napplied].obj = obj;
+    anim->applied[anim->napplied].prop = prop;
+    anim->napplied++;
+}
+
+/* a property path ("Opacity", "(UIElement.Opacity)", "(Border.Background).(SolidColorBrush.Color)") from an
+ * object: the object and property its last step names */
+static BOOL resolve_path( struct dobj *start, const WCHAR *path, struct dobj **obj_out, struct xaml_property **prop_out )
+{
+    struct dobj *obj = start;
+    const WCHAR *p = path;
+    WCHAR step[128];
+
+    *obj_out = NULL;
+    *prop_out = NULL;
+    while (*p)
+    {
+        struct xaml_property *prop;
+        size_t n = 0;
+
+        if (*p == '(')
+        {
+            p++;
+            while (*p && *p != ')' && n < ARRAY_SIZE(step) - 1) step[n++] = *p++;
+            if (*p != ')') return FALSE;
+            p++;
+        }
+        else while (*p && *p != '.' && *p != '[' && n < ARRAY_SIZE(step) - 1) step[n++] = *p++;
+        step[n] = 0;
+        if (*p == '[') return FALSE;   /* indexers: not ours yet */
+        if (!n || !obj || !(prop = xaml_find_member( obj, step ))) return FALSE;
+        if (*p == '.') p++;
+        if (!*p)
+        {
+            *obj_out = obj;
+            *prop_out = prop;
+            return TRUE;
+        }
+        {
+            IInspectable *next = NULL;
+            dobj_get_value( obj, prop, &next );
+            obj = next ? dobj_from_inspectable( next ) : NULL;
+            if (next) IInspectable_Release( next );   /* the property holds it */
+        }
+    }
+    return FALSE;
+}
+
+static struct dobj *find_target( struct uielem *scope, const WCHAR *name )
+{
+    struct uielem *elem = NULL, *root;
+
+    if (!scope || !name || !*name) return NULL;
+    if (!(elem = xaml_find_name( scope, name )))
+    {
+        for (root = scope; root->parent; root = root->parent) ;
+        elem = xaml_find_name( root, name );
+    }
+    return elem ? &elem->d : NULL;
+}
+
+static IInspectable *value_for( struct xaml_property *prop, IInspectable *value )
+{
+    WCHAR *str;
+    IInspectable *boxed = NULL;
+
+    /* a string for a property of another type: converted as markup's values are */
+    if (value && wcscmp( prop->type, L"String" ) && wcscmp( prop->type, L"Object" ) && (str = xunbox_string( value )))
+    {
+        if (FAILED(xaml_value_from_string( prop->type, str, &boxed ))) boxed = NULL;
+        free( str );
+        return boxed;
+    }
+    if (value) IInspectable_AddRef( value );
+    return value;
+}
+
+/* a setter of a visual state: Target "Element.Property" */
+static void apply_setter( struct anim *owner, struct uielem *scope, IInspectable *setter )
+{
+    const WCHAR *target_text = NULL, *value_text = NULL;
+    IInspectable *value = NULL, *converted = NULL;
+    struct xaml_property *prop;
+    struct dobj *obj, *target;
+    WCHAR name[128], *dot;
+
+    if (!xaml_setter_parts( setter, &target_text, &value, &value_text ) || !target_text) return;
+    if (!(dot = wcschr( target_text, '.' )) || dot - target_text >= ARRAY_SIZE(name)) return;
+    memcpy( name, target_text, (dot - target_text) * sizeof(WCHAR) );
+    name[dot - target_text] = 0;
+    if (!(target = find_target( scope, name )) || !resolve_path( target, dot + 1, &obj, &prop ))
+    {
+        WARN( "setter target %s not found\n", debugstr_w( target_text ) );
+        return;
+    }
+    if (value) converted = value_for( prop, value );
+    else if (value_text && FAILED(xaml_value_from_string( prop->type, value_text, &converted ))) return;
+    applied_add( owner, obj, prop, converted );
+    if (converted) IInspectable_Release( converted );
+}
+
+static INT64 key_time( struct anim *frame )
+{
+    INT64 time = 0;
+    struct xaml_property *prop = is_double_frame( frame->kind ) ? prop_dkf_time :
+                                 is_color_frame( frame->kind ) ? prop_ckf_time : prop_okf_time;
+    get_ref( frame, prop, &IID_IReference_KeyTime, &time, sizeof(time) );
+    return time;
+}
+
+/* an animation's held end value (a reference), or NULL when it has none of its own */
+static IInspectable *end_value( struct anim *anim )
+{
+    IInspectable *value = NULL;
+    struct anim *last = NULL;
+    UINT32 i;
+
+    switch (anim->kind)
+    {
+    case A_DOUBLE:
+        dobj_get_value( &anim->d, prop_d_to, &value );
+        if (!value) dobj_get_value( &anim->d, prop_d_from, &value );
+        return value;
+    case A_COLOR:
+        dobj_get_value( &anim->d, prop_c_to, &value );
+        if (!value) dobj_get_value( &anim->d, prop_c_from, &value );
+        return value;
+    case A_DOUBLE_KEYS: case A_COLOR_KEYS: case A_OBJECT_KEYS:
+        for (i = 0; anim->v1 && i < xvector_size( anim->v1 ); i++)
+        {
+            struct anim *frame = anim_from_inspectable( xvector_item( anim->v1, i ) );
+            if (frame && (!last || key_time( frame ) >= key_time( last ))) last = frame;
+        }
+        if (!last) return NULL;
+        dobj_get_value( &last->d, is_double_frame( last->kind ) ? prop_dkf_value :
+                                  is_color_frame( last->kind ) ? prop_ckf_value : prop_okf_value, &value );
+        return value;
+    default:
+        return NULL;
+    }
+}
+
+/* a storyboard's animations' end values, held */
+static void apply_storyboard( struct anim *owner, struct uielem *scope, struct anim *storyboard )
+{
+    UINT32 i;
+
+    if (!storyboard || storyboard->kind != A_STORYBOARD) return;
+    for (i = 0; storyboard->v1 && i < xvector_size( storyboard->v1 ); i++)
+    {
+        struct anim *anim = anim_from_inspectable( xvector_item( storyboard->v1, i ) );
+        IInspectable *value, *converted;
+        WCHAR *name, *path;
+        struct dobj *target = NULL, *obj;
+        struct xaml_property *prop;
+
+        if (!anim) continue;
+        if (anim->kind == A_STORYBOARD)
+        {
+            apply_storyboard( owner, scope, anim );
+            continue;
+        }
+        name = prop_string( &anim->d, prop_target_name );
+        path = prop_string( &anim->d, prop_target_property );
+        if (anim->target) target = dobj_from_inspectable( anim->target );
+        else if (name) target = find_target( scope, name );
+        if (target && path && resolve_path( target, path, &obj, &prop ) && (value = end_value( anim )))
+        {
+            if ((converted = value_for( prop, value )))
+            {
+                applied_add( owner, obj, prop, converted );
+                IInspectable_Release( converted );
+            }
+            IInspectable_Release( value );
+        }
+        else if (path) TRACE( "%s.%s: not animated\n", debugstr_w( name ), debugstr_w( path ) );
+        free( name );
+        free( path );
+    }
+}
+
+/* ---- VisualStateManager ---- */
+
+/* an element's VisualStateManager.VisualStateGroups (no reference), made when asked for */
+IInspectable *xaml_visual_state_groups( struct uielem *elem, BOOL create )
+{
+    struct xvector *vector;
+
+    xaml_animation_init();
+    if (elem->state_groups || !create) return elem->state_groups;
+    if (FAILED(xvector_create( &objects_type, NULL, &vector ))) return NULL;
+    elem->state_groups = xvector_iface( vector );   /* the element's reference */
+    return elem->state_groups;
+}
+
+static UINT32 vector_size( IInspectable *vector )
+{
+    UINT32 size = 0;
+    ((HRESULT (WINAPI *)( IInspectable *, UINT32 * ))((void **)vector->lpVtbl)[7])( vector, &size );
+    return size;
+}
+
+static IInspectable *vector_at( IInspectable *vector, UINT32 i )
+{
+    IInspectable *item = NULL;
+    ((HRESULT (WINAPI *)( IInspectable *, UINT32, IInspectable ** ))((void **)vector->lpVtbl)[6])( vector, i, &item );
+    return item;
+}
+
+/* the group and state of that name among an element's groups (references) */
+static BOOL find_state( struct uielem *root, const WCHAR *name, struct anim **group_out, struct anim **state_out )
+{
+    IInspectable *groups = root ? xaml_visual_state_groups( root, FALSE ) : NULL;
+    UINT32 i, j, n = groups ? vector_size( groups ) : 0;
+
+    for (i = 0; i < n; i++)
+    {
+        IInspectable *item = vector_at( groups, i );
+        struct anim *group = anim_from_inspectable( item );
+
+        if (group && group->kind == A_GROUP && group->v1)
+        {
+            for (j = 0; j < xvector_size( group->v1 ); j++)
+            {
+                struct anim *state = anim_from_inspectable( xvector_item( group->v1, j ) );
+                WCHAR *state_name;
+                BOOL match;
+
+                if (!state) continue;
+                state_name = prop_string( &state->d, prop_state_name );
+                match = state_name && !wcscmp( state_name, name );
+                free( state_name );
+                if (match)
+                {
+                    *group_out = group;
+                    IUnknown_AddRef( state->d.obj.outer );
+                    *state_out = state;
+                    return TRUE;   /* the group keeps item's reference: given to the caller */
+                }
+            }
+        }
+        if (item) IInspectable_Release( item );
+    }
+    return FALSE;
+}
+
+/* the default GoToStateCore: the group's previous state taken back, the new one's values set */
+void xaml_apply_visual_state( IInspectable *group_obj, IInspectable *state_obj, struct uielem *root )
+{
+    struct anim *group = anim_from_inspectable( group_obj ), *state = anim_from_inspectable( state_obj );
+    IInspectable *storyboard = NULL;
+    UINT32 i;
+
+    if (!group || !state) return;
+    applied_clear( group );
+    for (i = 0; state->v1 && i < xvector_size( state->v1 ); i++) apply_setter( group, root, xvector_item( state->v1, i ) );
+    dobj_get_value( &state->d, prop_state_storyboard, &storyboard );
+    apply_storyboard( group, root, anim_from_inspectable( storyboard ) );
+    if (storyboard) IInspectable_Release( storyboard );
+    if (state_obj) IInspectable_AddRef( state_obj );
+    if (group->current) IInspectable_Release( group->current );
+    group->current = state_obj;
+    xaml_invalidate_visuals();
+}
+
+/* VisualStateManager.GoToState: the state of the control's template (or its content); FALSE if none */
+HRESULT xaml_go_to_state( IInspectable *control_obj, const WCHAR *name, boolean transitions, boolean *done )
+{
+    struct uielem *elem = uielem_from_inspectable( control_obj ), *root = NULL;
+    struct anim *group = NULL, *state = NULL;
+    IInspectable *custom = NULL, *overrides = NULL;
+    struct control *control;
+    HRESULT hr = S_OK;
+
+    *done = FALSE;
+    if (!elem) return E_INVALIDARG;
+    xaml_animation_init();
+    if (is_control( &elem->d ) && (control = control_from_elem( elem )))
+        root = control->template_root ? control->template_root : control->child;
+    if (!root && !list_empty( &elem->children )) root = LIST_ENTRY( list_head( &elem->children ), struct uielem, entry );
+#ifdef SG_MUTANT_VSM_NO_STATES
+    return S_OK;
+#endif
+    if (!root || !find_state( root, name, &group, &state ))
+    {
+        IInspectable *groups = root ? xaml_visual_state_groups( root, FALSE ) : NULL;
+        /* one of our controls without a template of the program's draws its states itself */
+        if (is_control( &elem->d ) && (control = control_from_elem( elem )) && !control->template_root &&
+            (!groups || !vector_size( groups )))
+            *done = TRUE;
+        TRACE( "%p: no state %s%s\n", elem, debugstr_w( name ), *done ? " (drawn by the control)" : "" );
+        return S_OK;
+    }
+    *done = TRUE;
+    if (group->current != (IInspectable *)anim_outer( state ))
+    {
+        /* a CustomVisualStateManager of the program's decides (its GoToStateCore) */
+        custom = xaml_custom_state_manager( root );
+        if (custom && SUCCEEDED(IInspectable_QueryInterface( custom, &IID_IVisualStateManagerOverrides, (void **)&overrides )))
+        {
+            HSTRING hname;
+            boolean result = FALSE;
+            WindowsCreateString( name, wcslen( name ), &hname );
+            hr = ((HRESULT (WINAPI *)( IInspectable *, IInspectable *, IInspectable *, HSTRING, IInspectable *, IInspectable *,
+                                       boolean, boolean * ))((void **)overrides->lpVtbl)[6])(
+                    overrides, control_obj, uielem_iface( root ), hname, anim_outer( group ), anim_outer( state ),
+                    transitions, &result );
+            WindowsDeleteString( hname );
+            IInspectable_Release( overrides );
+            *done = SUCCEEDED(hr) && result;
+            hr = S_OK;
+        }
+        else xaml_apply_visual_state( anim_outer( group ), anim_outer( state ), root );
+        if (custom) IInspectable_Release( custom );
+    }
+    TRACE( "%p: state %s\n", elem, debugstr_w( name ) );
+    IUnknown_Release( state->d.obj.outer );
+    IUnknown_Release( group->d.obj.outer );
+    return hr;
+}
