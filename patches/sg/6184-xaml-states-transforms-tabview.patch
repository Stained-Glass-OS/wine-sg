+static HRESULT sb_get( IInspectable *element, struct xaml_property *prop, HSTRING *value )
+{
+    struct dobj *d = dobj_from_inspectable( element );
+    WCHAR *str;
+    HRESULT hr;
+
+    xaml_animation_init();
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!d) return E_INVALIDARG;
+    str = prop_string( d, prop );
+    hr = str ? WindowsCreateString( str, wcslen( str ), value ) : S_OK;
+    free( str );
+    return hr;
+}
+
+static HRESULT sb_put( IInspectable *element, struct xaml_property *prop, HSTRING value )
+{
+    struct dobj *d = dobj_from_inspectable( element );
+    IInspectable *box;
+    HRESULT hr;
+
+    xaml_animation_init();
+    if (!d) return E_INVALIDARG;
+    if (!(box = xbox_string( WindowsGetStringRawBuffer( value, NULL ) ))) return E_OUTOFMEMORY;
+    hr = dobj_set_value( d, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
