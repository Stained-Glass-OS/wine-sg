+ */
+
+/*
+ * Programs reach the composition layer under their XAML elements through ElementCompositionPreview:
+ * an element's visual, a child visual it hosts, property sets for animations.  Our elements are
+ * drawn with Direct2D, not composed, so the visuals here are real Windows.UI.Composition objects
+ * (dcomp's) made from one compositor of the process -- the program may set their properties and
+ * start animations on them -- but they are not drawn: an element's visual does not move it, and a
+ * child visual is kept, not shown.  Window.Compositor is that compositor.  Interface identity per
+ * windows-rs 0.30.0 (MIT); ICompositor's per Wine's windows.ui.composition.idl.
+ */
+
+#include "private.h"
+#include "roapi.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+static const GUID IID_ICompositor_x = { 0xb403ca50, 0x7f8c, 0x4e83, { 0x98, 0x5f, 0xcc, 0x45, 0x06, 0x00, 0x36, 0xd8 } };
+enum { ICompositor_CreateContainerVisual_x = 9, ICompositor_CreatePropertySet_x = 18 };
+
+static IInspectable *compositor;   /* ICompositor */
+static CRITICAL_SECTION compositor_cs;
+static CRITICAL_SECTION_DEBUG compositor_cs_debug =
+{
+    0, 0, &compositor_cs,
+    { &compositor_cs_debug.ProcessLocksList, &compositor_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": compositor_cs") }
+};
+static CRITICAL_SECTION compositor_cs = { &compositor_cs_debug, -1, 0, 0, 0, 0 };
+
+/* the compositor of the process (a reference), made when first asked for */
+HRESULT xaml_compositor( IInspectable **out )
+{
+    IInspectable *inspectable = NULL;
+    HSTRING name;
+    HRESULT hr = S_OK;
+
+    *out = NULL;
+#ifdef SG_MUTANT_NO_COMPOSITOR
+    return E_NOTIMPL;
+#endif
+    EnterCriticalSection( &compositor_cs );
+    if (!compositor)
+    {
+        if (SUCCEEDED(hr = WindowsCreateString( L"Windows.UI.Composition.Compositor", 33, &name )))
+        {
+            hr = RoActivateInstance( name, &inspectable );
+            WindowsDeleteString( name );
+        }
+        if (SUCCEEDED(hr))
+        {
+            hr = IInspectable_QueryInterface( inspectable, &IID_ICompositor_x, (void **)&compositor );
+            IInspectable_Release( inspectable );
+        }
+        if (FAILED(hr)) WARN( "no compositor: %#lx\n", hr );
+    }
+    if ((*out = compositor)) IInspectable_AddRef( compositor );
+    LeaveCriticalSection( &compositor_cs );
+    return hr;
+}
+
+static HRESULT compositor_call( int slot, IInspectable **out )
+{
+    IInspectable *comp;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = xaml_compositor( &comp ))) return hr;
+    hr = ((HRESULT (WINAPI *)( IInspectable *, IInspectable ** ))((void **)comp->lpVtbl)[slot])( comp, out );
+    IInspectable_Release( comp );
+    return hr;
+}
+
+/* ---- ElementCompositionPreview ---- */
+
+static HRESULT WINAPI ecp_GetElementVisual( struct xfiface *iface, IInspectable *element, IInspectable **visual )
+{
+    struct uielem *elem = uielem_from_inspectable( element );
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", element, visual );
+    if (!visual) return E_POINTER;
+    *visual = NULL;
+    if (!elem) return E_INVALIDARG;
+    if (!elem->comp_visual && FAILED(hr = compositor_call( ICompositor_CreateContainerVisual_x, &elem->comp_visual ))) return hr;
+    IInspectable_AddRef( (*visual = elem->comp_visual) );
+    return S_OK;
+}
+
+static HRESULT WINAPI ecp_GetElementChildVisual( struct xfiface *iface, IInspectable *element, IInspectable **visual )
+{
+    struct uielem *elem = uielem_from_inspectable( element );
+
+    TRACE( "%p, %p\n", element, visual );
+    if (!visual) return E_POINTER;
+    *visual = NULL;
+    if (!elem) return E_INVALIDARG;
+    if ((*visual = elem->comp_child)) IInspectable_AddRef( *visual );
+    return S_OK;
+}
+
+static HRESULT WINAPI ecp_SetElementChildVisual( struct xfiface *iface, IInspectable *element, IInspectable *visual )
+{
+    struct uielem *elem = uielem_from_inspectable( element );
+
+    TRACE( "%p, %p\n", element, visual );
+    if (!elem) return E_INVALIDARG;
+    if (visual) IInspectable_AddRef( visual );
+    if (elem->comp_child) IInspectable_Release( elem->comp_child );
+    elem->comp_child = visual;   /* kept, not drawn */
+    return S_OK;
+}
+
+static HRESULT WINAPI ecp_property_set( struct xfiface *iface, IInspectable *element, IInspectable **set )
+{
+    TRACE( "%p, %p\n", element, set );
+    if (!set) return E_POINTER;
+    if (!uielem_from_inspectable( element ))
+    {
+        *set = NULL;
+        return E_INVALIDARG;
+    }
+    return compositor_call( ICompositor_CreatePropertySet_x, set );   /* its values stay as set */
+}
+
+static HRESULT WINAPI ecp_SetImplicitAnimation( struct xfiface *iface, IInspectable *element, IInspectable *animation )
+{
+    TRACE( "%p, %p: not run\n", element, animation );
+    return S_OK;
+}
+
+static HRESULT WINAPI ecp_SetIsTranslationEnabled( struct xfiface *iface, IInspectable *element, boolean enabled )
+{
+    TRACE( "%p, %d\n", element, enabled );
+    return S_OK;
+}
+
+static HRESULT WINAPI ecp_SetAppWindowContent( struct xfiface *iface, IInspectable *window, IInspectable *content )
+{
+    FIXME( "%p, %p: AppWindow content not supported\n", window, content );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ecp_GetAppWindowContent( struct xfiface *iface, IInspectable *window, IInspectable **content )
+{
+    if (!content) return E_POINTER;
+    *content = NULL;
+    return S_OK;
+}
