+static struct anim *new_anim( enum akind kind, IInspectable *outer )
+{
+    struct anim *anim;
+
+    xaml_animation_init();
+    if (!(anim = calloc( 1, sizeof(*anim) ))) return NULL;
+    anim->kind = kind;
+    anim->if0.vtbl = if0_vtbls[kind];
+    if (kind == A_STATE) anim->if1.vtbl = state2_vtbl;
+    else if (is_timeline( kind )) anim->if1.vtbl = timeline_vtbl;
+    else if (is_double_frame( kind )) anim->if1.vtbl = dkf_vtbl;
+    else if (is_color_frame( kind )) anim->if1.vtbl = ckf_vtbl;
+    else if (kind == A_OKF_DISCRETE) anim->if1.vtbl = okf_vtbl;
+    handlers_init( &anim->h1 );
+    handlers_init( &anim->h2 );
+    dobj_init( &anim->d, &anim_classes[kind], outer );
+    return anim;
+}
