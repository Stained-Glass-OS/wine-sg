+    prop_children = xaml_property_register( kinds[T_GROUP].class, L"Children", L"Windows.UI.Xaml.Media.TransformCollection",
+                                            NULL, FALSE, transform_changed );
+    return TRUE;
+}
+
+static void transforms_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_props, NULL, NULL );
+}
+
+struct xform
+{
+    struct dobj d;
+    struct xiface IGeneralTransform_iface, ITransform_iface, IKind_iface;
+    enum tkind kind;
+    struct xvector *children;       /* a TransformGroup's, made when asked for */
+};
+
+static struct xform *xform_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct xform, d.obj );
+}
+
+static DOUBLE get( struct xform *xf, unsigned int i )
+{
+    IInspectable *box = NULL;
+    DOUBLE value;
+
+    dobj_get_value( &xf->d, props[xf->kind][i], &box );
+    value = xunbox_double( box, kinds[xf->kind].defaults[i] );
+    if (box) IInspectable_Release( box );
+    return value;
+}
+
+/* ---- matrices ---- */
+
+static void multiply( struct xmatrix *out, const struct xmatrix *a, const struct xmatrix *b )
+{
+    struct xmatrix r;
+
+    r.m11 = a->m11 * b->m11 + a->m12 * b->m21;
+    r.m12 = a->m11 * b->m12 + a->m12 * b->m22;
+    r.m21 = a->m21 * b->m11 + a->m22 * b->m21;
+    r.m22 = a->m21 * b->m12 + a->m22 * b->m22;
+    r.dx = a->dx * b->m11 + a->dy * b->m21 + b->dx;
+    r.dy = a->dx * b->m12 + a->dy * b->m22 + b->dy;
+    *out = r;
+}
+
+/* m then the other, about a center */
+static void about( struct xmatrix *m, const struct xmatrix *part, DOUBLE cx, DOUBLE cy )
+{
+    struct xmatrix to = { 1, 0, 0, 1, -cx, -cy }, back = { 1, 0, 0, 1, cx, cy }, t;
+
+    multiply( &t, &to, part );
+    multiply( &t, &t, &back );
+    multiply( m, m, &t );
+}
+
+static void rotation( struct xmatrix *m, DOUBLE degrees )
+{
+    DOUBLE a = degrees * M_PI / 180;
+    m->m11 = cos( a ); m->m12 = sin( a ); m->m21 = -sin( a ); m->m22 = cos( a ); m->dx = m->dy = 0;
+}
+
+static BOOL is_transform( struct dobj *d );
+
+/* the matrix of a transform of ours (identity for others and NULL) */
+void xaml_transform_matrix( IInspectable *obj, struct xmatrix *m )
+{
+    struct dobj *d = dobj_from_inspectable( obj );
+    struct xmatrix part;
+    struct xform *xf;
+    IInspectable *box = NULL;
+    UINT32 i;
+
+    m->m11 = m->m22 = 1;
+    m->m12 = m->m21 = m->dx = m->dy = 0;
+    if (!d || !is_transform( d )) return;
+    xf = CONTAINING_RECORD( d, struct xform, d );
+#ifdef SG_MUTANT_TRANSFORM_MATRIX_IDENTITY
+    return;
+#endif
+    switch (xf->kind)
+    {
+    case T_TRANSLATE:
+        m->dx = get( xf, 0 );
+        m->dy = get( xf, 1 );
+        break;
+    case T_SCALE:
+        part = (struct xmatrix){ get( xf, 2 ), 0, 0, get( xf, 3 ), 0, 0 };
+        about( m, &part, get( xf, 0 ), get( xf, 1 ) );
+        break;
+    case T_ROTATE:
+        rotation( &part, get( xf, 2 ) );
+        about( m, &part, get( xf, 0 ), get( xf, 1 ) );
+        break;
+    case T_SKEW:
+        part = (struct xmatrix){ 1, tan( get( xf, 3 ) * M_PI / 180 ), tan( get( xf, 2 ) * M_PI / 180 ), 1, 0, 0 };
+        about( m, &part, get( xf, 0 ), get( xf, 1 ) );
+        break;
+    case T_COMPOSITE:
+    {
+        DOUBLE cx = get( xf, 0 ), cy = get( xf, 1 );
+        part = (struct xmatrix){ get( xf, 2 ), 0, 0, get( xf, 3 ), 0, 0 };
+        about( m, &part, cx, cy );
+        part = (struct xmatrix){ 1, tan( get( xf, 5 ) * M_PI / 180 ), tan( get( xf, 4 ) * M_PI / 180 ), 1, 0, 0 };
+        about( m, &part, cx, cy );
+        rotation( &part, get( xf, 6 ) );
+        about( m, &part, cx, cy );
+        m->dx += get( xf, 7 );
+        m->dy += get( xf, 8 );
+        break;
+    }
+    case T_MATRIX:
+        dobj_get_value( &xf->d, prop_matrix, &box );
+        if (box) xunbox_ref( box, &IID_IReference_Matrix, m, sizeof(*m) );
+        if (box) IInspectable_Release( box );
+        break;
+    case T_GROUP:
+        for (i = 0; xf->children && i < xvector_size( xf->children ); i++)
+        {
+            xaml_transform_matrix( xvector_item( xf->children, i ), &part );
+            multiply( m, m, &part );
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static BOOL invert( struct xmatrix *out, const struct xmatrix *m )
+{
+    DOUBLE det = m->m11 * m->m22 - m->m12 * m->m21;
+
+    if (fabs( det ) < 1e-12) return FALSE;
+    out->m11 = m->m22 / det;
+    out->m12 = -m->m12 / det;
+    out->m21 = -m->m21 / det;
+    out->m22 = m->m11 / det;
+    out->dx = (m->m21 * m->dy - m->m22 * m->dx) / det;
+    out->dy = (m->m12 * m->dx - m->m11 * m->dy) / det;
+    return TRUE;
+}
+
+static struct xpoint apply( const struct xmatrix *m, struct xpoint p )
+{
+    struct xpoint r = { p.x * m->m11 + p.y * m->m21 + m->dx, p.x * m->m12 + p.y * m->m22 + m->dy };
+    return r;
+}
+
+/* ---- GeneralTransform ---- */
+
+static IInspectable *new_matrix_transform( const struct xmatrix *m );
+
+static HRESULT WINAPI general_get_Inverse( struct xiface *iface, IInspectable **value )
+{
+    struct xmatrix m, inverse;
+
+    if (!value) return E_POINTER;
+    xaml_transform_matrix( (IInspectable *)&xform_from_iface( iface )->IGeneralTransform_iface, &m );
+    *value = invert( &inverse, &m ) ? new_matrix_transform( &inverse ) : NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI general_TransformPoint( struct xiface *iface, struct xpoint point, struct xpoint *value )
+{
+    struct xmatrix m;
+
+    if (!value) return E_POINTER;
+    xaml_transform_matrix( (IInspectable *)&xform_from_iface( iface )->IGeneralTransform_iface, &m );
+    *value = apply( &m, point );
+    return S_OK;
+}
+
+static HRESULT WINAPI general_TryTransform( struct xiface *iface, struct xpoint point, struct xpoint *out, boolean *ok )
+{
+    if (!out || !ok) return E_POINTER;
+    *ok = TRUE;
+    return general_TransformPoint( iface, point, out );
+}
+
+static HRESULT WINAPI general_TransformBounds( struct xiface *iface, struct xrect rect, struct xrect *value )
+{
+    struct xpoint corners[4] = { { rect.x, rect.y }, { rect.x + rect.width, rect.y }, { rect.x, rect.y + rect.height },
+                                 { rect.x + rect.width, rect.y + rect.height } };
+    FLOAT left = INFINITY, top = INFINITY, right = -INFINITY, bottom = -INFINITY;
+    struct xmatrix m;
+    unsigned int i;
+
+    if (!value) return E_POINTER;
+    xaml_transform_matrix( (IInspectable *)&xform_from_iface( iface )->IGeneralTransform_iface, &m );
+    for (i = 0; i < 4; i++)
+    {
+        struct xpoint p = apply( &m, corners[i] );
+        left = fminf( left, p.x ); right = fmaxf( right, p.x );
+        top = fminf( top, p.y ); bottom = fmaxf( bottom, p.y );
+    }
+    value->x = left;
+    value->y = top;
+    value->width = right - left;
+    value->height = bottom - top;
+    return S_OK;
+}
+
+static const void *general_vtbl[] =
