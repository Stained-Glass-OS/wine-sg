+/* ---- markup: collection content, VisualStateGroups ---- */
+
+/* the collection a member of ours names (no reference), or NULL */
+IInspectable *xaml_animation_collection( IInspectable *obj, const WCHAR *name )
+{
+    struct anim *anim = anim_from_inspectable( obj );
+    struct uielem *elem;
+    IInspectable *value = NULL;
+    HRESULT hr = E_FAIL;
+
+    if (!wcscmp( name, L"VisualStateGroups" ) && (elem = uielem_from_inspectable( obj )))
+        return xaml_visual_state_groups( elem, TRUE );
+    if (!anim) return NULL;
+    if (anim->kind == A_GROUP && !wcscmp( name, L"States" )) hr = group_get_States( &anim->if0, &value );
+    else if (anim->kind == A_GROUP && !wcscmp( name, L"Transitions" )) hr = group_get_Transitions( &anim->if0, &value );
+    else if (anim->kind == A_STATE && !wcscmp( name, L"Setters" )) hr = state_get_Setters( &anim->if1, &value );
+    else if (anim->kind == A_STATE && !wcscmp( name, L"StateTriggers" )) hr = state_get_StateTriggers( &anim->if1, &value );
+    else if (anim->kind == A_STORYBOARD && !wcscmp( name, L"Children" )) hr = storyboard_get_Children( &anim->if0, &value );
+    else if ((anim->kind == A_DOUBLE_KEYS || anim->kind == A_COLOR_KEYS || anim->kind == A_OBJECT_KEYS) &&
+             !wcscmp( name, L"KeyFrames" )) hr = keys_get_KeyFrames( &anim->if0, &value );
+    if (FAILED(hr) || !value) return NULL;
+    IInspectable_Release( value );   /* the object keeps it */
+    return value;
+}
