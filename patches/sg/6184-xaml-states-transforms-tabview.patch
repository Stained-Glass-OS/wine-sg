+void xaml_animation_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_props, NULL, NULL );
+}
+
+/* ---- the objects ---- */
+
+struct applied
+{
+    struct dobj *obj;               /* a reference on its outer */
+    struct xaml_property *prop;
+};
+
+struct anim
+{
+    struct dobj d;
+    struct xiface if0, if1;
+    enum akind kind;
+    struct xvector *v1, *v2;        /* group: States, Transitions; state: Setters, StateTriggers;
+                                       storyboard: Children; key frame animations: KeyFrames */
+    IInspectable *current;          /* a group's CurrentState (a reference) */
+    struct handler_list h1, h2;     /* group: CurrentStateChanged/Changing; timelines: Completed */
+    struct applied *applied;        /* a group's state's (or a begun storyboard's) values */
+    unsigned int napplied, sapplied;
+    IInspectable *target;           /* a timeline's Storyboard.SetTarget (a weak hold: no reference) */
+    struct xpoint cp1, cp2;         /* a KeySpline's */
+    UINT_PTR timer;                 /* a begun storyboard's Completed */
+};
+
+static struct anim *anim_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct anim, d.obj );
+}
+
+static const struct xclass anim_classes[A_KINDS];
+
+static struct anim *anim_from_inspectable( IInspectable *obj )
+{
+    struct dobj *d = obj ? dobj_from_inspectable( obj ) : NULL;
+    if (!d || d->obj.cls < anim_classes || d->obj.cls >= anim_classes + A_KINDS) return NULL;
+    return CONTAINING_RECORD( d, struct anim, d );
+}
+
+static IInspectable *anim_outer( struct anim *anim )
+{
+    return (IInspectable *)anim->d.obj.outer;
+}
+
+static HRESULT get_prop( struct anim *anim, struct xaml_property *prop, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    return dobj_get_value( &anim->d, prop, value );
+}
+
+static HRESULT put_boxed( struct anim *anim, struct xaml_property *prop, IInspectable *box )
+{
+    HRESULT hr;
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &anim->d, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static BOOL get_bool( struct anim *anim, struct xaml_property *prop )
+{
+    IInspectable *box = NULL;
+    boolean value;
+    dobj_get_value( &anim->d, prop, &box );
+    value = xunbox_boolean( box, FALSE );
+    if (box) IInspectable_Release( box );
+    return value;
+}
+
+static HRESULT get_string( struct anim *anim, struct xaml_property *prop, HSTRING *value )
+{
+    IInspectable *box = NULL;
+    WCHAR *str;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    dobj_get_value( &anim->d, prop, &box );
+    str = xunbox_string( box );
+    if (box) IInspectable_Release( box );
+    hr = str ? WindowsCreateString( str, wcslen( str ), value ) : S_OK;
+    free( str );
+    return hr;
+}
+
+static HRESULT put_string( struct anim *anim, struct xaml_property *prop, HSTRING value )
+{
+    return put_boxed( anim, prop, xbox_string( WindowsGetStringRawBuffer( value, NULL ) ) );
+}
+
+static WCHAR *prop_string( struct dobj *d, struct xaml_property *prop )
+{
+    IInspectable *box = NULL;
+    WCHAR *str;
+    dobj_get_value( d, prop, &box );
+    str = xunbox_string( box );
+    if (box) IInspectable_Release( box );
+    return str;
+}
+
+static HRESULT get_ref( struct anim *anim, struct xaml_property *prop, const GUID *iid, void *out, size_t size )
+{
+    IInspectable *box = NULL;
+    if (!out) return E_POINTER;
+    memset( out, 0, size );
+    dobj_get_value( &anim->d, prop, &box );
+    if (box)
+    {
+        xunbox_ref( box, iid, out, size );
+        IInspectable_Release( box );
+    }
+    return S_OK;
+}
+
+static HRESULT get_vector( struct anim *anim, struct xvector **vector, const struct xvector_type *type, IInspectable **value )
+{
+    HRESULT hr;
+    if (!value) return E_POINTER;
+    if (!*vector && FAILED(hr = xvector_create( type, anim, vector ))) return hr;
+    IInspectable_AddRef( (*value = xvector_iface( *vector )) );
+    return S_OK;
+}
