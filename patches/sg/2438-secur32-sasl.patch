+#include <stdarg.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "sspi.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(secur32);
+
+/* A SASL profile is the name of a SASL mechanism (as an LDAP server lists it in
+ * supportedSASLMechanisms) together with the SSPI package that carries it.  The
+ * list is in the order the best mechanism comes first. */
+static const struct
+{
+    const char *profile;
+    const WCHAR *package;
+}
+profiles[] =
+{
+    { "GSS-SPNEGO", L"Negotiate" },
+    { "GSSAPI",     L"Kerberos" },
+    { "DIGEST-MD5", L"WDigest" },
+};
+
+static int profile_index( const char *name, int len )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(profiles); i++)
+    {
+#ifdef SG_MUTANT_SASL_CASE
+        if (strlen( profiles[i].profile ) == len && !strncmp( profiles[i].profile, name, len ))
+#else
+        if (strlen( profiles[i].profile ) == len && !_strnicmp( profiles[i].profile, name, len ))
+#endif
+            return i;
+    }
+    return -1;
+}
+
+static int profile_index_w( const WCHAR *name )
+{
+    char buf[32];
+    int len;
+
+    for (len = 0; name[len]; len++)
+    {
+        if (len >= sizeof(buf) || name[len] > 0x7f) return -1;
+        buf[len] = name[len];
+    }
+    return profile_index( buf, len );
+}
+
+/***********************************************************************
+ *             SaslEnumerateProfilesW   (SECUR32.@)
+ *
+ * The names come back as consecutive null-terminated strings, ended by an
+ * empty string, in one block released with FreeContextBuffer.
+ */
+SECURITY_STATUS SEC_ENTRY SaslEnumerateProfilesW( WCHAR **list, ULONG *count )
+{
+    unsigned int i, size = 1;
+    WCHAR *buf, *p;
+
+    TRACE( "%p, %p\n", list, count );
+
+    if (!list || !count) return SEC_E_INVALID_PARAMETER;
+
+    for (i = 0; i < ARRAY_SIZE(profiles); i++) size += strlen( profiles[i].profile ) + 1;
+    if (!(buf = HeapAlloc( GetProcessHeap(), 0, size * sizeof(WCHAR) ))) return SEC_E_INSUFFICIENT_MEMORY;
+
+    for (i = 0, p = buf; i < ARRAY_SIZE(profiles); i++)
+        {
+            const char *n = profiles[i].profile;
+            while ((*p++ = (unsigned char)*n++)) ;
+        }
+    *p = 0;
+
+    *list = buf;
+    *count = ARRAY_SIZE(profiles);
+    return SEC_E_OK;
+}
+
+/***********************************************************************
+ *             SaslEnumerateProfilesA   (SECUR32.@)
+ */
+SECURITY_STATUS SEC_ENTRY SaslEnumerateProfilesA( char **list, ULONG *count )
+{
+    unsigned int i, size = 1;
+    char *buf, *p;
+
+    TRACE( "%p, %p\n", list, count );
+
+    if (!list || !count) return SEC_E_INVALID_PARAMETER;
+
+    for (i = 0; i < ARRAY_SIZE(profiles); i++) size += strlen( profiles[i].profile ) + 1;
+    if (!(buf = HeapAlloc( GetProcessHeap(), 0, size ))) return SEC_E_INSUFFICIENT_MEMORY;
+
+    for (i = 0, p = buf; i < ARRAY_SIZE(profiles); i++)
+    {
+        strcpy( p, profiles[i].profile );
+        p += strlen( p ) + 1;
+    }
+    *p = 0;
+
+    *list = buf;
+    *count = ARRAY_SIZE(profiles);
+    return SEC_E_OK;
+}
+
+/***********************************************************************
+ *             SaslGetProfilePackageW   (SECUR32.@)
+ */
+SECURITY_STATUS SEC_ENTRY SaslGetProfilePackageW( WCHAR *name, SecPkgInfoW **info )
+{
+    int i;
+
+    TRACE( "%s, %p\n", debugstr_w(name), info );
+
+    if (!name || !info) return SEC_E_INVALID_PARAMETER;
+    if ((i = profile_index_w( name )) < 0) return SEC_E_SECPKG_NOT_FOUND;
+    return QuerySecurityPackageInfoW( (SEC_WCHAR *)profiles[i].package, info );
+}
+
+static SECURITY_STATUS query_package_a( int i, SecPkgInfoA **info );
+
+/***********************************************************************
+ *             SaslGetProfilePackageA   (SECUR32.@)
+ */
+SECURITY_STATUS SEC_ENTRY SaslGetProfilePackageA( char *name, SecPkgInfoA **info )
+{
+    int i;
+
+    TRACE( "%s, %p\n", debugstr_a(name), info );
+
+    if (!name || !info) return SEC_E_INVALID_PARAMETER;
+    if ((i = profile_index( name, strlen( name ) )) < 0) return SEC_E_SECPKG_NOT_FOUND;
+    return query_package_a( i, info );
+}
+
+static SECURITY_STATUS query_package_a( int i, SecPkgInfoA **info )
+{
+    char name[32];
+
+    const WCHAR *w = profiles[i].package;
+    char *n = name;
+
+    while ((*n++ = (char)*w++)) ;
+    return QuerySecurityPackageInfoA( name, info );
+}
+
+/* The server's list of mechanisms: names separated by blanks, commas or nulls.
+ * Returns the profile of the best one we know, or -1. */
+static int identify_profile( const SecBufferDesc *input, SECURITY_STATUS *status )
+{
+    const SecBuffer *token = NULL;
+    const char *data;
+    unsigned int i, len, pos, found = ARRAY_SIZE(profiles);
+
+    *status = SEC_E_INVALID_PARAMETER;
+    if (!input || (input->cBuffers && !input->pBuffers)) return -1;
+
+    for (i = 0; i < input->cBuffers; i++)
+    {
+        if ((input->pBuffers[i].BufferType & ~SECBUFFER_ATTRMASK) == SECBUFFER_TOKEN)
+        {
+            token = &input->pBuffers[i];
+            break;
+        }
+    }
+    if (!token) return -1;
+
+    *status = SEC_E_INVALID_TOKEN;
+    if (!token->cbBuffer || !token->pvBuffer) return -1;
+    data = token->pvBuffer;
+    len = token->cbBuffer;
+
+    for (pos = 0; pos < len;)
+    {
+        unsigned int start = pos;
+        int idx;
+
+        while (pos < len && data[pos] != ' ' && data[pos] != ',' && data[pos] != 0 && data[pos] != '\n' && data[pos] != '\r') pos++;
+#ifdef SG_MUTANT_SASL_ORDER
+        if (pos > start && (idx = profile_index( data + start, pos - start )) >= 0)
+            found = idx;
+#else
+        if (pos > start && (idx = profile_index( data + start, pos - start )) >= 0 && (unsigned int)idx < found)
+            found = idx;
+#endif
+        pos++;
+    }
+    if (found == ARRAY_SIZE(profiles))
+    {
+        *status = SEC_E_SECPKG_NOT_FOUND;
+        return -1;
+    }
+    *status = SEC_E_OK;
+    return found;
+}
+
+/***********************************************************************
+ *             SaslIdentifyPackageW   (SECUR32.@)
+ */
+SECURITY_STATUS SEC_ENTRY SaslIdentifyPackageW( SecBufferDesc *input, SecPkgInfoW **info )
+{
+    SECURITY_STATUS status;
+    int i;
+
+    TRACE( "%p, %p\n", input, info );
+
+    if (!info) return SEC_E_INVALID_PARAMETER;
+    if ((i = identify_profile( input, &status )) < 0) return status;
+    return QuerySecurityPackageInfoW( (SEC_WCHAR *)profiles[i].package, info );
+}
+
+/***********************************************************************
+ *             SaslIdentifyPackageA   (SECUR32.@)
+ */
+SECURITY_STATUS SEC_ENTRY SaslIdentifyPackageA( SecBufferDesc *input, SecPkgInfoA **info )
+{
+    SECURITY_STATUS status;
+    int i;
+
+    TRACE( "%p, %p\n", input, info );
+
+    if (!info) return SEC_E_INVALID_PARAMETER;
+    if ((i = identify_profile( input, &status )) < 0) return status;
+    return query_package_a( i, info );
+}
+
+/***********************************************************************
+ *             SaslInitializeSecurityContextW   (SECUR32.@)
+ *
+ * The SASL entry points run the same exchange as the SSPI ones on the package
+ * the credential belongs to; the SASL framing is left to the caller.
+ */
+SECURITY_STATUS SEC_ENTRY SaslInitializeSecurityContextW( CredHandle *cred, CtxtHandle *context, SEC_WCHAR *target,
+        ULONG req, ULONG reserved1, ULONG rep, SecBufferDesc *input, ULONG reserved2, CtxtHandle *new_context,
+        SecBufferDesc *output, ULONG *attrs, TimeStamp *expiry )
+{
+    TRACE( "%p, %p, %s, %#lx, %p\n", cred, context, debugstr_w(target), req, input );
+    return InitializeSecurityContextW( cred, context, target, req, reserved1, rep, input, reserved2,
+                                       new_context, output, attrs, expiry );
+}
+
+/***********************************************************************
+ *             SaslInitializeSecurityContextA   (SECUR32.@)
+ */
+SECURITY_STATUS SEC_ENTRY SaslInitializeSecurityContextA( CredHandle *cred, CtxtHandle *context, SEC_CHAR *target,
+        ULONG req, ULONG reserved1, ULONG rep, SecBufferDesc *input, ULONG reserved2, CtxtHandle *new_context,
+        SecBufferDesc *output, ULONG *attrs, TimeStamp *expiry )
+{
+    TRACE( "%p, %p, %s, %#lx, %p\n", cred, context, debugstr_a(target), req, input );
+    return InitializeSecurityContextA( cred, context, target, req, reserved1, rep, input, reserved2,
+                                       new_context, output, attrs, expiry );
+}
+
+/***********************************************************************
+ *             SaslAcceptSecurityContext   (SECUR32.@)
+ */
+SECURITY_STATUS SEC_ENTRY SaslAcceptSecurityContext( CredHandle *cred, CtxtHandle *context, SecBufferDesc *input,
+        ULONG req, ULONG rep, CtxtHandle *new_context, SecBufferDesc *output, ULONG *attrs, TimeStamp *expiry )
+{
+    TRACE( "%p, %p, %p, %#lx\n", cred, context, input, req );
+    return AcceptSecurityContext( cred, context, input, req, rep, new_context, output, attrs, expiry );
+}
--- a/dlls/secur32/secur32.spec
+++ b/dlls/secur32/secur32.spec
@@ -52,15 +52,15 @@
 @ stdcall QuerySecurityPackageInfoA(str ptr)
 @ stdcall QuerySecurityPackageInfoW(wstr ptr)
 @ stdcall RevertSecurityContext(ptr)
-@ stub SaslAcceptSecurityContext
-@ stub SaslEnumerateProfilesA
-@ stub SaslEnumerateProfilesW
-@ stub SaslGetProfilePackageA
-@ stub SaslGetProfilePackageW
-@ stub SaslIdentifyPackageA
-@ stub SaslIdentifyPackageW
-@ stub SaslInitializeSecurityContextA
-@ stub SaslInitializeSecurityContextW
+@ stdcall SaslAcceptSecurityContext(ptr ptr ptr long long ptr ptr ptr ptr)
+@ stdcall SaslEnumerateProfilesA(ptr ptr)
+@ stdcall SaslEnumerateProfilesW(ptr ptr)
+@ stdcall SaslGetProfilePackageA(str ptr)
+@ stdcall SaslGetProfilePackageW(wstr ptr)
+@ stdcall SaslIdentifyPackageA(ptr ptr)
+@ stdcall SaslIdentifyPackageW(ptr ptr)
+@ stdcall SaslInitializeSecurityContextA(ptr ptr str long long long ptr long ptr ptr ptr ptr)
+@ stdcall SaslInitializeSecurityContextW(ptr ptr wstr long long long ptr long ptr ptr ptr ptr)
 @ stdcall SealMessage(ptr long ptr long) EncryptMessage
 @ stub SecCacheSspiPackages
 @ stub SecGetLocaleSpecificEncryptionRules
