From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Address Windowing Extensions answer as Windows does without SeLockMemoryPrivilege

AllocateUserPhysicalPages needs SeLockMemoryPrivilege enabled; no SG account's token has it (as no
Windows account has it by default), so it fails with ERROR_PRIVILEGE_NOT_HELD -- what database
servers check before using ordinary memory -- instead of ERROR_CALL_NOT_IMPLEMENTED. Mapping or freeing
pages never handed out: ERROR_INVALID_PARAMETER. MapUserPhysicalPagesScatter exported.
Gate: test/awe-gate.sh. Mutant: SG_MUTANT_AWE_NOTIMPL.
---
--- a/dlls/kernelbase/memory.c
+++ b/dlls/kernelbase/memory.c
@@ -1452,10 +1452,51 @@
 /***********************************************************************
  *             AllocateUserPhysicalPages   (kernelbase.@)
  */
+/* Stained Glass OS (wine-sg 9706): Address Windowing Extensions as Windows answers them. Physical pages
+ * need SeLockMemoryPrivilege enabled in the caller's token ("Lock pages in memory"); without it, as for
+ * every account by default on Windows (and every SG account: no token is given that privilege), allocating
+ * fails with ERROR_PRIVILEGE_NOT_HELD, which is what database servers check for before falling back to
+ * ordinary memory. Wine's stub said ERROR_CALL_NOT_IMPLEMENTED. With no physical pages handed out, mapping
+ * or freeing any is an invalid parameter. */
+static BOOL awe_privilege_held(void)
+{
+    PRIVILEGE_SET set;
+    BOOLEAN held = FALSE;
+    HANDLE token;
+
+#ifdef SG_MUTANT_AWE_NOTIMPL
+    return TRUE;
+#endif
+    if (NtOpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ) &&
+        NtOpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+        return FALSE;
+    set.PrivilegeCount = 1;
+    set.Control = PRIVILEGE_SET_ALL_NECESSARY;
+    set.Privilege[0].Luid.LowPart = SE_LOCK_MEMORY_PRIVILEGE;
+    set.Privilege[0].Luid.HighPart = 0;
+    set.Privilege[0].Attributes = 0;
+    if (NtPrivilegeCheck( token, &set, &held )) held = FALSE;
+    NtClose( token );
+    return held;
+}
+
 BOOL WINAPI DECLSPEC_HOTPATCH AllocateUserPhysicalPages( HANDLE process, ULONG_PTR *pages,
                                                          ULONG_PTR *userarray )
 {
-    FIXME( "stub: %p %p %p\n", process, pages, userarray );
+    TRACE( "%p %p %p\n", process, pages, userarray );
+
+    if (!pages || !userarray)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!awe_privilege_held())
+    {
+        SetLastError( ERROR_PRIVILEGE_NOT_HELD );
+        return FALSE;
+    }
+    /* a token holding SeLockMemoryPrivilege: none in SG (granting it is a decision kept for David) */
+    FIXME( "physical pages for a token with SeLockMemoryPrivilege: %p %Iu\n", process, *pages );
     SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
     return FALSE;
 }
@@ -1467,9 +1508,20 @@
 BOOL WINAPI DECLSPEC_HOTPATCH FreeUserPhysicalPages( HANDLE process, ULONG_PTR *pages,
                                                      ULONG_PTR *userarray )
 {
-    FIXME( "stub: %p %p %p\n", process, pages, userarray );
+    TRACE( "%p %p %p\n", process, pages, userarray );
+    if (!pages)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+#ifndef SG_MUTANT_AWE_NOTIMPL
+    /* none were handed out (AllocateUserPhysicalPages), so these are not this process's */
+    *pages = 0;
+    SetLastError( ERROR_INVALID_PARAMETER );
+#else
     *pages = 0;
     SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+#endif
     return FALSE;
 }
 
@@ -1556,9 +1608,25 @@
  */
 BOOL WINAPI DECLSPEC_HOTPATCH MapUserPhysicalPages( void *addr, ULONG_PTR page_count, ULONG_PTR *pages )
 {
-    FIXME( "stub: %p %Iu %p\n", addr, page_count, pages );
-    *pages = 0;
+    TRACE( "%p %Iu %p\n", addr, page_count, pages );
+    /* no region reserved with MEM_PHYSICAL holds physical pages (none are handed out) */
+#ifndef SG_MUTANT_AWE_NOTIMPL
+    SetLastError( ERROR_INVALID_PARAMETER );
+#else
     SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+#endif
+    return FALSE;
+}
+
+
+/***********************************************************************
+ *             MapUserPhysicalPagesScatter   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH MapUserPhysicalPagesScatter( void **addrs, ULONG_PTR page_count, ULONG_PTR *pages )
+{
+    TRACE( "%p %Iu %p\n", addrs, page_count, pages );
+    /* as MapUserPhysicalPages: no physical pages are handed out (wine-sg 9706) */
+    SetLastError( ERROR_INVALID_PARAMETER );
     return FALSE;
 }
 
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -995,6 +995,7 @@
