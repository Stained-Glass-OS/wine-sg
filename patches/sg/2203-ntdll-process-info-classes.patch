From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, wow64: ProcessDeviceMap, ProcessLUIDDeviceMapsEnabled, ProcessWorkingSetWatch/HandleTracing, quiet set-only classes

- NtQueryInformationProcess answered ProcessDeviceMap and
  ProcessLUIDDeviceMapsEnabled with STATUS_INVALID_INFO_CLASS and a FIXME;
  both are real query classes. ProcessDeviceMap returns the drive letters the
  shell and installers see (the \DosDevices entries plus mapped network
  drives, with DRIVE_FIXED for the system drive); a wrong size is
  STATUS_INFO_LENGTH_MISMATCH. ProcessLUIDDeviceMapsEnabled answers 0.
- ProcessWorkingSetWatch and ProcessHandleTracing answer STATUS_UNSUCCESSFUL
  (never enabled) on a PROCESS_QUERY_INFORMATION handle and
  STATUS_ACCESS_DENIED on a limited one, which is what
  kernel32's process.c information-class sweep expects.
- The set-only and 16-bit-VDM classes (ProcessBasePriority, ...
  ProcessForegroundInformation) stay STATUS_INVALID_INFO_CLASS but no longer
  log a FIXME on every normal probe.
- wow64: the 32-bit PROCESS_DEVICEMAP_INFORMATION is 36 bytes (40 natively),
  so ProcessDeviceMap is thunked; the other new classes pass through.

---
--- a/include/winternl.h
+++ b/include/winternl.h
@@ -2693,6 +2693,19 @@
     UINT64    UniqueProcessId;
     UINT64    InheritedFromUniqueProcessId;
 } PROCESS_BASIC_INFORMATION64;
+
+/* ProcessDeviceMap (NtQueryInformationProcess/NtSetInformationProcess) */
+typedef struct _PROCESS_DEVICEMAP_INFORMATION {
+    union {
+        struct {
+            HANDLE DirectoryHandle;
+        } Set;
+        struct {
+            ULONG DriveMap;
+            UCHAR DriveType[32];
+        } Query;
+    } DUMMYUNIONNAME;
+} PROCESS_DEVICEMAP_INFORMATION, *PPROCESS_DEVICEMAP_INFORMATION;
 
 #define PROCESS_PRIOCLASS_IDLE          1
 #define PROCESS_PRIOCLASS_NORMAL        2
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -1204,6 +1204,24 @@
         ret = STATUS_INVALID_INFO_CLASS; \
         break
 
+/* Stained Glass OS: a class NtQueryInformationProcess never answers on real
+ * Windows either -- ProcessBasePriority, ProcessRaisePriority and
+ * ProcessAccessToken are set-only (query the base priority through
+ * ProcessBasicInformation instead); ProcessExceptionPort and
+ * ProcessForegroundInformation are set-only, used by csrss/the window
+ * manager; ProcessWx86Information (16-bit NTVDM), ProcessLdtInformation,
+ * ProcessLdtSize, ProcessIoPortHandlers and ProcessUserModeIOPL are 16-bit
+ * DOS/VDM or kernel-driver classes with no user-mode query at all;
+ * ProcessEnableAlignmentFaultFixup is set-only. STATUS_INVALID_INFO_CLASS
+ * was already the right answer; only the FIXME (score up to 325 in real
+ * logs: every one of these is a program's normal probe, not a bug) was
+ * noise. */
+#define SETONLY_INFO_CLASS(c) \
+    case c: \
+        TRACE( "(process=%p) %s is set-only\n", handle, #c ); \
+        ret = STATUS_INVALID_INFO_CLASS; \
+        break
+
 /* Settings a process makes on itself and reads back: SetProcessMitigationPolicy,
  * SetProcessInformation. Chrome and Edge set mitigation policies and check
  * them; they and .NET set power throttling and memory priority. Kept, not
@@ -1437,21 +1455,138 @@
 
     switch (class)
     {
-    UNIMPLEMENTED_INFO_CLASS(ProcessBasePriority);
-    UNIMPLEMENTED_INFO_CLASS(ProcessRaisePriority);
-    UNIMPLEMENTED_INFO_CLASS(ProcessExceptionPort);
-    UNIMPLEMENTED_INFO_CLASS(ProcessAccessToken);
-    UNIMPLEMENTED_INFO_CLASS(ProcessLdtInformation);
-    UNIMPLEMENTED_INFO_CLASS(ProcessLdtSize);
-    UNIMPLEMENTED_INFO_CLASS(ProcessIoPortHandlers);
-    UNIMPLEMENTED_INFO_CLASS(ProcessWorkingSetWatch);
-    UNIMPLEMENTED_INFO_CLASS(ProcessUserModeIOPL);
-    UNIMPLEMENTED_INFO_CLASS(ProcessEnableAlignmentFaultFixup);
-    UNIMPLEMENTED_INFO_CLASS(ProcessWx86Information);
-    UNIMPLEMENTED_INFO_CLASS(ProcessDeviceMap);
-    UNIMPLEMENTED_INFO_CLASS(ProcessForegroundInformation);
-    UNIMPLEMENTED_INFO_CLASS(ProcessLUIDDeviceMapsEnabled);
-    UNIMPLEMENTED_INFO_CLASS(ProcessHandleTracing);
+    SETONLY_INFO_CLASS(ProcessBasePriority);
+    SETONLY_INFO_CLASS(ProcessRaisePriority);
+    SETONLY_INFO_CLASS(ProcessExceptionPort);
+    SETONLY_INFO_CLASS(ProcessAccessToken);
+    SETONLY_INFO_CLASS(ProcessLdtInformation);
+    SETONLY_INFO_CLASS(ProcessLdtSize);
+    SETONLY_INFO_CLASS(ProcessIoPortHandlers);
+    SETONLY_INFO_CLASS(ProcessUserModeIOPL);
+    SETONLY_INFO_CLASS(ProcessEnableAlignmentFaultFixup);
+    SETONLY_INFO_CLASS(ProcessWx86Information);
+    SETONLY_INFO_CLASS(ProcessForegroundInformation);
+
+    /* queryable only after NtSetInformationProcess enables it; we never do,
+     * so answer exactly as Windows does before that first Set call */
+    case ProcessWorkingSetWatch:
+    case ProcessHandleTracing:
+        TRACE( "(process=%p) %u: not enabled\n", handle, class );
+#ifndef SG_MUTANT_NO_QUERY_ACCESS
+        if (handle != GetCurrentProcess())
+        {
+            /* these two want PROCESS_QUERY_INFORMATION, not just the limited right */
+            OBJECT_BASIC_INFORMATION obi;
+
+            if ((ret = NtQueryObject( handle, ObjectBasicInformation, &obi, sizeof(obi), NULL ))) break;
+            if (!(obi.GrantedAccess & PROCESS_QUERY_INFORMATION)) { ret = STATUS_ACCESS_DENIED; break; }
+        }
+#endif
+#ifndef SG_MUTANT_WORKINGSET_WRONG
+        ret = STATUS_UNSUCCESSFUL;
+#else
+        ret = STATUS_INVALID_INFO_CLASS;
+#endif
+        break;
+
+    /* Stained Glass OS: ProcessDeviceMap was "Unimplemented information
+     * class" (FIXME, score 100: installers and the shell check a process's
+     * drive letters at startup). We have one \DosDevices directory, shared
+     * by every process (no per-session object namespace, so another
+     * process's map cannot differ from ours); its drive letters, exactly as
+     * GetLogicalDrives (kernelbase) finds them: entries under \DosDevices,
+     * plus mapped network drives, which are plain directories outside it. */
+    case ProcessDeviceMap:
+    {
+        PROCESS_DEVICEMAP_INFORMATION map;
+#ifndef SG_MUTANT_NO_DEVICEMAP
+        OBJECT_ATTRIBUTES attr;
+        static const WCHAR dosdevicesW[] = { '\\','D','o','s','D','e','v','i','c','e','s','\\',0 };
+        UNICODE_STRING nt_name;
+        HANDLE dir;
+#endif
+        int i;
+
+        if (size != sizeof(map))
+        {
+            len = sizeof(map);
+            ret = STATUS_INFO_LENGTH_MISMATCH;
+            break;
+        }
+        memset( &map, 0, sizeof(map) );
+#ifndef SG_MUTANT_NO_DEVICEMAP
+        RtlInitUnicodeString( &nt_name, dosdevicesW );
+        nt_name.Length -= sizeof(WCHAR);
+        attr.Length = sizeof(attr);
+        attr.RootDirectory = 0;
+        attr.ObjectName = &nt_name;
+        attr.Attributes = OBJ_CASE_INSENSITIVE;
+        attr.SecurityDescriptor = NULL;
+        attr.SecurityQualityOfService = NULL;
+        if (!NtOpenDirectoryObject( &dir, FILE_LIST_DIRECTORY, &attr ))
+        {
+            char data[1024];
+            DIRECTORY_BASIC_INFORMATION *dirinfo = (DIRECTORY_BASIC_INFORMATION *)data;
+            ULONG ctx = 0, dlen;
+
+            while (!NtQueryDirectoryObject( dir, dirinfo, sizeof(data), 1, 0, &ctx, &dlen ))
+            {
+                if (dirinfo->ObjectName.Length == 2 * sizeof(WCHAR) && dirinfo->ObjectName.Buffer[1] == ':')
+                {
+                    i = dirinfo->ObjectName.Buffer[0] - 'A';
+                    if (i >= 0 && i < 32)
+                    {
+                        map.Query.DriveMap |= 1 << i;
+                        /* DRIVE_FIXED (winbase.h, not included here) vs DRIVE_UNKNOWN: we
+                         * cannot ask the mount manager about other drives' media from here */
+                        map.Query.DriveType[i] = (dirinfo->ObjectName.Buffer[0] == 'C') ? 3 /* DRIVE_FIXED */ : 0 /* DRIVE_UNKNOWN */;
+                    }
+                }
+            }
+            NtClose( dir );
+        }
+        {
+            WCHAR root[] = { '\\','?','?','\\','A',':','\\',0 };
+            UNICODE_STRING root_str;
+            FILE_BASIC_INFORMATION info;
+
+            RtlInitUnicodeString( &root_str, root );
+            attr.ObjectName = &root_str;
+            for (i = 0; i < 26; i++)
+            {
+                if (map.Query.DriveMap & (1 << i)) continue;
+                root[4] = 'A' + i;
+                if (!NtQueryAttributesFile( &attr, &info ) && (info.FileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+                    map.Query.DriveMap |= 1 << i;
+            }
+        }
+#else
+        (void)i;
+#endif
+        len = sizeof(map);
+        if (!info) ret = STATUS_ACCESS_VIOLATION;
+        else memcpy( info, &map, sizeof(map) );
+        break;
+    }
+
+    /* Stained Glass OS: LUID device maps (one DosDevices per logon session)
+     * are not modeled -- we have the one, process-wide -- so this is always
+     * disabled, exactly as a non-Terminal-Services machine reports it. */
+    case ProcessLUIDDeviceMapsEnabled:
+    {
+        ULONG enabled = 0;
+
+        if (size != sizeof(enabled))
+        {
+            len = sizeof(enabled);
+            ret = STATUS_INFO_LENGTH_MISMATCH;
+            break;
+        }
+        len = sizeof(enabled);
+        if (!info) ret = STATUS_ACCESS_VIOLATION;
+        else memcpy( info, &enabled, sizeof(enabled) );
+        break;
+    }
 
     case ProcessBasicInformation:
         {
--- a/dlls/wow64/process.c
+++ b/dlls/wow64/process.c
@@ -568,8 +568,40 @@
     case ProcessPagePriority:  /* MEMORY_PRIORITY_INFORMATION */
     case ProcessLeapSecondInformation:  /* PROCESS_LEAP_SECOND_INFO */
     case ProcessPriorityBoost:  /* ULONG */
+    case ProcessLUIDDeviceMapsEnabled:  /* ULONG */
+    case ProcessWorkingSetWatch:  /* never enabled: nothing to return */
+    case ProcessHandleTracing:  /* never enabled: nothing to return */
         /* FIXME: check buffer alignment */
         return NtQueryInformationProcess( handle, class, ptr, len, retlen );
+
+    case ProcessDeviceMap:  /* PROCESS_DEVICEMAP_INFORMATION: 36 bytes here, 40 natively */
+        if (len == sizeof(ULONG) + 32)
+        {
+            PROCESS_DEVICEMAP_INFORMATION info;
+
+            if (!(status = NtQueryInformationProcess( handle, class, &info, sizeof(info), NULL )))
+            {
+                memcpy( ptr, &info.Query, sizeof(ULONG) + 32 );
+                if (retlen) *retlen = sizeof(ULONG) + 32;
+            }
+            return status;
+        }
+        if (retlen) *retlen = sizeof(ULONG) + 32;
+        return STATUS_INFO_LENGTH_MISMATCH;
+
+    /* set-only classes (see ntdll/unix/process.c) */
+    case ProcessBasePriority:
+    case ProcessRaisePriority:
+    case ProcessExceptionPort:
+    case ProcessAccessToken:
+    case ProcessLdtInformation:
+    case ProcessLdtSize:
+    case ProcessIoPortHandlers:
+    case ProcessUserModeIOPL:
+    case ProcessEnableAlignmentFaultFixup:
+    case ProcessWx86Information:
+    case ProcessForegroundInformation:
+        return STATUS_INVALID_INFO_CLASS;
 
     case ProcessQuotaLimits:  /* QUOTA_LIMITS(_EX) */
         if (len == sizeof(QUOTA_LIMITS32) || len == sizeof(QUOTA_LIMITS_EX32))
