+/* Stained Glass OS (ADR 0014): cross-uid ptrace/signal via a per-user agent.
+ *
+ * The shared machine-level server runs as sgsystem; the kernel refuses it
+ * ptrace/tgkill on an ordinary user's processes (different uid). A small
+ * unprivileged agent (sg-procagent) runs as each session user and performs the
+ * operation on that user's own processes, where the kernel allows it. The
+ * server connects to <prefix>/.sg-procagent.<uid>, checks the peer really is
+ * that uid, and delegates. Nothing here gains a capability: the agent can only
+ * touch its own user's processes, exactly as that user could. Same-uid
+ * operations are still done directly below (this is bypassed entirely on an
+ * ordinary, non-system prefix). */
+
+enum sg_proc_op { SG_PROC_READ = 1, SG_PROC_WRITE, SG_PROC_SIGNAL, SG_PROC_GETDR, SG_PROC_SETDR, SG_PROC_SETAFF };
+
+struct sg_proc_req
+{
+    int              op;
+    int              sig;
+    unsigned int     pid;
+    unsigned int     tid;
+    unsigned __int64 addr;
+    unsigned int     len;   /* payload bytes that follow the request / are expected back */
+};
+
+struct sg_proc_reply
+{
+    int          status;    /* 1 = ok, 0 = failed */
+    unsigned int len;       /* payload bytes that follow the reply */
+};
+
+#define SG_AGENT_MAX 64
+static struct { uid_t uid; int fd; } sg_agents[SG_AGENT_MAX];  /* fd 0 means empty */
+
+static int sg_io_all( int fd, void *buf, size_t len, int writing )
+{
+    char *p = buf;
+    while (len)
+    {
+        ssize_t r = writing ? write( fd, p, len ) : read( fd, p, len );
+        if (r > 0) { p += r; len -= r; continue; }
+        if (r == -1 && errno == EINTR) continue;
+        return 0;
+    }
+    return 1;
+}
+
+static void sg_agent_drop( uid_t uid )
+{
+    int i;
+    for (i = 0; i < SG_AGENT_MAX; i++)
+        if (sg_agents[i].fd && sg_agents[i].uid == uid)
+        {
+            close( sg_agents[i].fd );
+            sg_agents[i].fd = 0;
+            return;
+        }
+}
+
+static int sg_agent_fd( uid_t uid )
+{
+    struct sockaddr_un addr;
+    struct ucred cred;
+    socklen_t clen = sizeof(cred);
+    struct timeval tv = { 10, 0 };
+    int fd, i, slot = -1, n;
+
+    for (i = 0; i < SG_AGENT_MAX; i++)
+    {
+        if (sg_agents[i].fd && sg_agents[i].uid == uid) return sg_agents[i].fd;
+        if (!sg_agents[i].fd && slot == -1) slot = i;
+    }
+    if (slot == -1 || !get_config_dir()) return -1;
+
+    memset( &addr, 0, sizeof(addr) );
+    addr.sun_family = AF_UNIX;
+    n = snprintf( addr.sun_path, sizeof(addr.sun_path), "%s/.sg-procagent.%u", get_config_dir(), (unsigned)uid );
+    if (n < 0 || n >= (int)sizeof(addr.sun_path)) return -1;
+    /* the socket must be a socket owned by that very user -- so another member
+     * of the prefix group cannot squat the path and impersonate the agent
+     * (SO_PEERCRED below is the second, decisive check) */
+    {
+        struct stat st;
+        if (stat( addr.sun_path, &st ) == -1 || !S_ISSOCK(st.st_mode) || st.st_uid != uid) return -1;
+    }
+    if ((fd = socket( AF_UNIX, SOCK_STREAM, 0 )) == -1) return -1;
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) == -1 ||
+        getsockopt( fd, SOL_SOCKET, SO_PEERCRED, &cred, &clen ) == -1 ||
+        cred.uid != uid)
+    {
+        close( fd );
+        return -1;
+    }
+    setsockopt( fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv) );
+    setsockopt( fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv) );
+    sg_agents[slot].uid = uid;
+    sg_agents[slot].fd = fd;
+    return fd;
+}
+
+/* returns 1 on success; fills rbuf (up to rlen bytes) for READ/GETDR */
+static int sg_agent_call( uid_t uid, struct sg_proc_req *req, const void *wbuf,
+                          void *rbuf, unsigned int rlen )
+{
+    struct sg_proc_reply rep;
+    int fd = sg_agent_fd( uid );
+
+    if (fd == -1) return 0;
+    if (!sg_io_all( fd, req, sizeof(*req), 1 )) goto fail;
+    if (req->len && wbuf && !sg_io_all( fd, (void *)wbuf, req->len, 1 )) goto fail;
+    if (!sg_io_all( fd, &rep, sizeof(rep), 0 )) goto fail;
+    if (rep.len)
+    {
+        if (rep.len != rlen || !rbuf || !sg_io_all( fd, rbuf, rep.len, 0 )) goto fail;
+    }
+    return rep.status;
+fail:
+    sg_agent_drop( uid );
+    return 0;
+}
+
+static inline int sg_delegate_process( struct process *process )
+{
+    return sg_system_prefix && process->peer_uid != getuid();
+}
+
+/* Stained Glass OS (ADR 0014): set a thread's affinity via its user's agent.
+ * Returns 1 done-ok, 0 done-failed, -1 not delegated (caller does it). */
+int sg_agent_set_affinity( struct thread *thread, unsigned __int64 affinity )
+{
+    struct sg_proc_req req;
+
+    if (!sg_delegate_process( thread->process ) || thread->unix_tid == -1) return -1;
+    memset( &req, 0, sizeof(req) );
+    req.op = SG_PROC_SETAFF;
+    req.pid = thread->unix_pid;
+    req.tid = thread->unix_tid;
+    req.addr = affinity;
+    return sg_agent_call( thread->process->peer_uid, &req, NULL, NULL, 0 ) ? 1 : 0;
+}
