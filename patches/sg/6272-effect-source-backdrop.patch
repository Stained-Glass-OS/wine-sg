@@ -2468,7 +2473,7 @@ static void draw_brush( ID2D1DeviceContext *ctx, const struct visual *v, struct
 
         if (SUCCEEDED(ID2D1DeviceContext_CreateSolidColorBrush( ctx, &color, NULL, &solid )))
         {
-            ID2D1DeviceContext_FillRectangle( ctx, &(D2D1_RECT_F){ 0, 0, v->render_size.X, v->render_size.Y },
+            ID2D1DeviceContext_FillRectangle( ctx, &(D2D1_RECT_F){ 0, 0, size.X, size.Y },
                     (ID2D1Brush *)solid );
             ID2D1SolidColorBrush_Release( solid );
         }
@@ -2479,7 +2484,7 @@ static void draw_brush( ID2D1DeviceContext *ctx, const struct visual *v, struct
         IWineDXGICompositionSwapChain *swapchain;
 
         if (!sc)
