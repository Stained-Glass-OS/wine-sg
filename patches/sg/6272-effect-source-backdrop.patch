+static void draw_surface_brush( ID2D1DeviceContext *ctx, Vector2 size, struct brush *brush, float opacity )
 {
     struct drawing_surface *surface = unsafe_drawing_surface( (IUnknown *)brush->surface );
-    float sw, sh, w = v->render_size.X, h = v->render_size.Y, dw, dh, scale;
+    float sw, sh, w = size.X, h = size.Y, dw, dh, scale;
     D2D1_RECT_F dst, src;
 
     if (!surface || !surface->bitmap) return;
@@ -2393,12 +2398,12 @@ static ID2D1Brush *mask_d2d_brush( ID2D1DeviceContext *ctx, struct brush *mask,
     return NULL;
 }
 
-static void draw_brush( ID2D1DeviceContext *ctx, const struct visual *v, struct brush *brush, float opacity,
+static void draw_brush( ID2D1DeviceContext *ctx, Vector2 size, struct brush *brush, float opacity,
         const D2D1_MATRIX_3X2_F *world, struct swapchain_place *places, unsigned int max_places, unsigned int *count,
         unsigned int depth );
 
 /* a mask brush: its source, through the mask's alpha (a Direct2D layer with the mask as its opacity brush) */
-static void draw_mask_brush( ID2D1DeviceContext *ctx, const struct visual *v, struct brush *brush, float opacity,
+static void draw_mask_brush( ID2D1DeviceContext *ctx, Vector2 size, struct brush *brush, float opacity,
         const D2D1_MATRIX_3X2_F *world, struct swapchain_place *places, unsigned int max_places, unsigned int *count,
         unsigned int depth )
 {
@@ -2413,10 +2418,10 @@ static void draw_mask_brush( ID2D1DeviceContext *ctx, const struct visual *v, st
 #endif
     if (!mask)
     {
-        draw_brush( ctx, v, source, opacity, world, places, max_places, count, depth + 1 );
+        draw_brush( ctx, size, source, opacity, world, places, max_places, count, depth + 1 );
         return;
     }
