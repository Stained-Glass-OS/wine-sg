         else if (*count < max_places && SUCCEEDED(IUnknown_QueryInterface( sc->swapchain,
                 &IID_IWineDXGICompositionSwapChain, (void **)&swapchain )))
         {
@@ -2519,7 +2524,7 @@ static void draw_visual( ID2D1DeviceContext *ctx, struct visual *v, const D2D1_M
     }
 
     if (v->sprite && (brush = unsafe_brush( v->brush )))
-        draw_brush( ctx, v, brush, opacity, &world, places, max_places, count, 0 );
+        draw_brush( ctx, v->render_size, brush, opacity, &world, places, max_places, count, 0 );
     else if (v->brush && v->sprite)
         FIXME( "Brush %p is not drawn.\n", v->brush );
 #ifndef SG_MUTANT_SHAPES_NOT_DRAWN
@@ -2677,6 +2682,15 @@ static void target_render( struct desktop_target *target )
         draw_root_parent_size.X = client.right - client.left;
         draw_root_parent_size.Y = client.bottom - client.top;
     }
+    /* the window's system backdrop, under everything: a brush of ours is drawn over the client area
+     * (Mica and acrylic are the window manager's on Windows: their brushes are not ours) */
+    if (target->backdrop)
+    {
+        struct brush *backdrop = unsafe_brush( target->backdrop );
+        if (backdrop) draw_brush( target->context, draw_root_parent_size, backdrop, 1.0f, &identity,
+                                  places, ARRAY_SIZE(places), &count, 0 );
+        ID2D1DeviceContext_SetTransform( target->context, &identity );
+    }
     draw_visual( target->context, target->root, &identity, 1.0f, 0, places, ARRAY_SIZE(places), &count );
     draw_root_parent_size.X = draw_root_parent_size.Y = 0.0f;
     ID2D1DeviceContext_SetTransform( target->context, &identity );
@@ -2836,6 +2850,10 @@ static HRESULT WINAPI desktop_target_QueryInterface( IDesktopWindowTarget *iface
         *out = &impl->ICompositionTarget_iface;
     else if (IsEqualGUID( iid, &IID_IDesktopWindowTargetInterop ))
         *out = &impl->IDesktopWindowTargetInterop_iface;
+#ifndef SG_MUTANT_NO_SYSTEM_BACKDROP
+    else if (IsEqualGUID( iid, &IID_ICompositionSupportsSystemBackdrop_x ))
+        *out = &impl->ICompositionSupportsSystemBackdrop_iface;
+#endif
     else if (IsEqualGUID( iid, &IID_ICompositionObject ))
         *out = &impl->ICompositionObject_iface;
     else if (IsEqualGUID( iid, &IID_IClosable ))
@@ -2866,6 +2884,7 @@ static ULONG WINAPI desktop_target_Release( IDesktopWindowTarget *iface )
         list_remove( &impl->entry );
         LeaveCriticalSection( &impl->compositor->cs );
         if (impl->root) IVisual_Release( &impl->root->IVisual_iface );
+        if (impl->backdrop) ICompositionBrush_Release( impl->backdrop );
         if (impl->bitmap) ID2D1Bitmap1_Release( impl->bitmap );
         if (impl->readback) ID2D1Bitmap1_Release( impl->readback );
         if (impl->context) ID2D1DeviceContext_Release( impl->context );
@@ -2911,6 +2930,70 @@ static const struct IDesktopWindowTargetVtbl desktop_target_vtbl =
     desktop_target_get_IsTopmost,
 };
 
+static struct desktop_target *impl_from_backdrop( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct desktop_target, ICompositionSupportsSystemBackdrop_iface );
+}
+
+static HRESULT WINAPI backdrop_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    return desktop_target_QueryInterface( &impl_from_backdrop( iface )->IDesktopWindowTarget_iface, iid, out );
+}
+
+static ULONG WINAPI backdrop_AddRef( void *iface )
+{
+    return desktop_target_AddRef( &impl_from_backdrop( iface )->IDesktopWindowTarget_iface );
+}
+
+static ULONG WINAPI backdrop_Release( void *iface )
+{
+    return desktop_target_Release( &impl_from_backdrop( iface )->IDesktopWindowTarget_iface );
+}
+
+static HRESULT WINAPI backdrop_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    return desktop_target_GetIids( &impl_from_backdrop( iface )->IDesktopWindowTarget_iface, count, iids );
+}
+
+static HRESULT WINAPI backdrop_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return desktop_target_GetRuntimeClassName( &impl_from_backdrop( iface )->IDesktopWindowTarget_iface, name );
+}
+
+static HRESULT WINAPI backdrop_GetTrustLevel( void *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI backdrop_get_SystemBackdrop( void *iface, ICompositionBrush **value )
+{
+    struct desktop_target *impl = impl_from_backdrop( iface );
+    if (!value) return E_POINTER;
+    if ((*value = impl->backdrop)) ICompositionBrush_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI backdrop_put_SystemBackdrop( void *iface, ICompositionBrush *value )
+{
+    struct desktop_target *impl = impl_from_backdrop( iface );
+    ICompositionBrush *brush = NULL;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (value && FAILED(ICompositionBrush_QueryInterface( value, &IID_ICompositionBrush, (void **)&brush )))
+        return E_INVALIDARG;
+    if (impl->backdrop) ICompositionBrush_Release( impl->backdrop );
+    impl->backdrop = brush;
+    compositor_changed( impl->compositor );
+    return S_OK;
+}
+
+static const void * const backdrop_vtbl[] =
+{
+    backdrop_QueryInterface, backdrop_AddRef, backdrop_Release, backdrop_GetIids, backdrop_GetRuntimeClassName,
+    backdrop_GetTrustLevel, backdrop_get_SystemBackdrop, backdrop_put_SystemBackdrop,
+};
+
