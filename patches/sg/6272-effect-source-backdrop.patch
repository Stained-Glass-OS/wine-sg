     struct list entry;
     HWND hwnd;
     BOOL topmost;
@@ -2286,10 +2291,10 @@ static struct swapchain_surface *unsafe_swapchain_surface( ICompositionSurface *
  * (under the compositor's lock) */
 static BOOL draw_render_target_only;
 
