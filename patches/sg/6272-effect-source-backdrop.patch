     target->IDesktopWindowTarget_iface.lpVtbl = &desktop_target_vtbl;
     target->ICompositionTarget_iface.lpVtbl = &composition_target_vtbl;
     target->IDesktopWindowTargetInterop_iface.lpVtbl = &target_interop_vtbl;
+    target->ICompositionSupportsSystemBackdrop_iface.vtbl = backdrop_vtbl;
     target->ICompositionObject_iface.lpVtbl = &desktop_target_object_vtbl;
     target->IClosable_iface.lpVtbl = &desktop_target_closable_vtbl;
     target->ref = 1;
@@ -4084,6 +4168,8 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
     else if (!wcscmp( name, L"Windows.UI.Composition.CompositionCapabilities" ))
         *factory = capabilities_factory;
 #endif
+    else if (!wcscmp( name, L"Windows.UI.Composition.CompositionEffectSourceParameter" ))
+        *factory = source_parameter_factory;
     if (!*factory)
         return CLASS_E_CLASSNOTAVAILABLE;
     IActivationFactory_AddRef( *factory );
diff --git a/dlls/dcomp/composition_private.h b/dlls/dcomp/composition_private.h
