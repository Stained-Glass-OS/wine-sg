+/* ICompositionSupportsSystemBackdrop (windows-rs metadata): a window target's SystemBackdrop */
+static const GUID IID_ICompositionSupportsSystemBackdrop_x = { 0x397dafe4, 0xb6c2, 0x5bb9, { 0x95, 0x1d, 0xf5, 0x70, 0x7d, 0xe8, 0xb7, 0xbc } };
+
 struct desktop_target
 {
     IDesktopWindowTarget IDesktopWindowTarget_iface;
@@ -2066,8 +2069,10 @@ struct desktop_target
     IDesktopWindowTargetInterop IDesktopWindowTargetInterop_iface;
