From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dcomp: CompositionEffectSourceParameter, a window target's SystemBackdrop (Teams)

Windows.UI.Composition.CompositionEffectSourceParameter exists (an effect's named source), and a desktop window target supports a system backdrop (ICompositionSupportsSystemBackdrop): a brush of ours set as its SystemBackdrop is drawn under the root. Teams asked for both; with them it draws its sign-in page at its real size.
---
diff --git a/dlls/dcomp/capabilities.c b/dlls/dcomp/capabilities.c
index 245b972..cfd3993 100644
--- a/dlls/dcomp/capabilities.c
+++ b/dlls/dcomp/capabilities.c
@@ -1,5 +1,5 @@
 /*
- * Windows.UI.Composition.CompositionCapabilities (wine-sg 6270)
+ * Windows.UI.Composition.CompositionCapabilities (wine-sg 6271) and CompositionEffectSourceParameter (6272)
  *
  * What the compositor can draw, for a program to choose what it asks for:
  * GetForCurrentView, AreEffectsSupported, AreEffectsFast and Changed, as
@@ -197,3 +197,190 @@ static const void * const cs_vtbl[] =
 static struct caps_factory caps_factory_impl = { { &cf_vtbl }, { cs_vtbl } };
 
 IActivationFactory *capabilities_factory = &caps_factory_impl.IActivationFactory_iface;
+
+/* ---- Windows.UI.Composition.CompositionEffectSourceParameter (wine-sg 6272): a named source of an
+ * effect description (IGraphicsEffectSource), bound to a brush by name once an effect brush is made.
+ * Ours keeps its name; effect brushes are not made yet (see above). ---- */
+
+static const GUID IID_ICompositionEffectSourceParameter_x = { 0x858ab13a, 0x3292, 0x4e4e, { 0xb3, 0xbb, 0x2b, 0x6c, 0x65, 0x44, 0xa6, 0xee } };
+static const GUID IID_ICompositionEffectSourceParameterFactory_x = { 0xb3d9f276, 0xaba3, 0x4724, { 0xac, 0xf3, 0xd0, 0x39, 0x74, 0x64, 0xdb, 0x1c } };
+static const GUID IID_IGraphicsEffectSource_x = { 0x2d8f9ddc, 0x4339, 0x4eb9, { 0x92, 0x16, 0xf9, 0xde, 0xb7, 0x56, 0x58, 0xa2 } };
+static const WCHAR class_source_parameter[] = L"Windows.UI.Composition.CompositionEffectSourceParameter";
+
+struct source_parameter
+{
+    IInspectable IInspectable_iface;                         /* ICompositionEffectSourceParameter */
+    struct { const void * const *vtbl; } effect_source_iface; /* IGraphicsEffectSource: no methods of its own */
+    LONG ref;
+    HSTRING name;
+};
+
+static struct source_parameter *impl_from_param( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct source_parameter, IInspectable_iface );
+}
+
+static HRESULT WINAPI param_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    struct source_parameter *impl = impl_from_param( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICompositionEffectSourceParameter_x ))
+        *out = &impl->IInspectable_iface;
+    else if (IsEqualGUID( iid, &IID_IGraphicsEffectSource_x ))
+        *out = &impl->effect_source_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI param_AddRef( void *iface )
+{
+    return InterlockedIncrement( &impl_from_param( iface )->ref );
+}
+
+static ULONG WINAPI param_Release( void *iface )
+{
+    struct source_parameter *impl = impl_from_param( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        WindowsDeleteString( impl->name );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI param_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    if (!(*iids = CoTaskMemAlloc( 2 * sizeof(IID) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_ICompositionEffectSourceParameter_x;
+    (*iids)[1] = IID_IGraphicsEffectSource_x;
+    *count = 2;
+    return S_OK;
+}
+
+static HRESULT WINAPI param_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return WindowsCreateString( class_source_parameter, wcslen( class_source_parameter ), name );
+}
+
+static HRESULT WINAPI param_GetTrustLevel( void *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI param_get_Name( void *iface, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( impl_from_param( iface )->name, value );
+}
+
+static const void * const param_vtbl[] =
+{
+    param_QueryInterface, param_AddRef, param_Release, param_GetIids, param_GetRuntimeClassName,
+    param_GetTrustLevel, param_get_Name,
+};
+
+static struct source_parameter *impl_from_effect_source( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct source_parameter, effect_source_iface );
+}
+
+static HRESULT WINAPI es_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    return param_QueryInterface( &impl_from_effect_source( iface )->IInspectable_iface, iid, out );
+}
+static ULONG WINAPI es_AddRef( void *iface ) { return param_AddRef( &impl_from_effect_source( iface )->IInspectable_iface ); }
+static ULONG WINAPI es_Release( void *iface ) { return param_Release( &impl_from_effect_source( iface )->IInspectable_iface ); }
+static HRESULT WINAPI es_GetIids( void *iface, ULONG *count, IID **iids ) { return param_GetIids( NULL, count, iids ); }
+static HRESULT WINAPI es_GetRuntimeClassName( void *iface, HSTRING *name ) { return param_GetRuntimeClassName( NULL, name ); }
+static HRESULT WINAPI es_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static const void * const effect_source_vtbl[] =
+{
+    es_QueryInterface, es_AddRef, es_Release, es_GetIids, es_GetRuntimeClassName, es_GetTrustLevel,
+};
+
+struct param_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    struct { const void * const *vtbl; } factory_iface;
+};
+
+static struct param_factory param_factory_impl;
+
+static HRESULT WINAPI pf2_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &param_factory_impl.IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionEffectSourceParameterFactory_x ))
+        *out = &param_factory_impl.factory_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI pf2_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI pf2_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI pf2_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { *count = 0; *iids = NULL; return S_OK; }
+static HRESULT WINAPI pf2_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return param_GetRuntimeClassName( NULL, name ); }
+static HRESULT WINAPI pf2_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+/* made with a name only (ICompositionEffectSourceParameterFactory) */
+static HRESULT WINAPI pf2_ActivateInstance( IActivationFactory *iface, IInspectable **out ) { *out = NULL; return E_NOTIMPL; }
+
+static const struct IActivationFactoryVtbl pf2_vtbl =
+{
+    pf2_QueryInterface, pf2_AddRef, pf2_Release, pf2_GetIids, pf2_GetRuntimeClassName, pf2_GetTrustLevel,
+    pf2_ActivateInstance,
+};
+
+static HRESULT WINAPI pfc_QueryInterface( void *iface, REFIID iid, void **out ) { return pf2_QueryInterface( NULL, iid, out ); }
+static ULONG WINAPI pfc_AddRef( void *iface ) { return 2; }
+static ULONG WINAPI pfc_Release( void *iface ) { return 1; }
+static HRESULT WINAPI pfc_GetIids( void *iface, ULONG *count, IID **iids ) { return pf2_GetIids( NULL, count, iids ); }
+static HRESULT WINAPI pfc_GetRuntimeClassName( void *iface, HSTRING *name ) { return param_GetRuntimeClassName( NULL, name ); }
+static HRESULT WINAPI pfc_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI pfc_Create( void *iface, HSTRING name, IInspectable **out )
+{
+    struct source_parameter *impl;
+    HRESULT hr;
+
+    TRACE( "name %s, out %p.\n", debugstr_hstring( name ), out );
+    if (!out) return E_POINTER;
+#ifdef SG_MUTANT_NO_SOURCE_PARAMETER
+    *out = NULL;
+    return E_NOTIMPL;
+#endif
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IInspectable_iface.lpVtbl = (const IInspectableVtbl *)param_vtbl;
+    impl->effect_source_iface.vtbl = effect_source_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = WindowsDuplicateString( name, &impl->name )))
+    {
+        free( impl );
+        return hr;
+    }
+    *out = &impl->IInspectable_iface;
+    return S_OK;
+}
+
+static const void * const pfc_vtbl[] =
+{
+    pfc_QueryInterface, pfc_AddRef, pfc_Release, pfc_GetIids, pfc_GetRuntimeClassName, pfc_GetTrustLevel,
+    pfc_Create,
+};
+
+static struct param_factory param_factory_impl = { { &pf2_vtbl }, { pfc_vtbl } };
+
+IActivationFactory *source_parameter_factory = &param_factory_impl.IActivationFactory_iface;
diff --git a/dlls/dcomp/classes.idl b/dlls/dcomp/classes.idl
index 9562b9c..6ae49cc 100644
--- a/dlls/dcomp/classes.idl
+++ b/dlls/dcomp/classes.idl
@@ -74,4 +74,21 @@ namespace Windows.UI.Composition {
     {
         [default] interface Windows.UI.Composition.ICompositionCapabilities;
     }
+
+    /* wine-sg 6272: an effect's named source (capabilities.c) */
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(858ab13a-3292-4e4e-b3bb-2b6c6544a6ee)]
+    interface ICompositionEffectSourceParameter : IInspectable {}
+
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(b3d9f276-aba3-4724-acf3-d0397464db1c)]
+    interface ICompositionEffectSourceParameterFactory : IInspectable {}
+
+    [
+        activatable(Windows.UI.Composition.ICompositionEffectSourceParameterFactory, Windows.Foundation.UniversalApiContract, 1.0),
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        marshaling_behavior(agile)
+    ]
+    runtimeclass CompositionEffectSourceParameter
+    {
+        [default] interface Windows.UI.Composition.ICompositionEffectSourceParameter;
+    }
 }
