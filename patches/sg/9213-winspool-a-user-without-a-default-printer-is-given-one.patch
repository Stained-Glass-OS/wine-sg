From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Sat, 28 Nov 2026 05:25:00 -0800
Subject: [PATCH] winspool: a user without a default printer is given one (9213)

The default printer is per user (HKCU ...\Windows "Device"), set when a
process adds the CUPS printers. On Stained Glass OS the printers are made by
the system (sg-printers-refresh) or were made in another account, so a user's
own prefix had printers but no default: GetDefaultPrinter said
ERROR_FILE_NOT_FOUND and the classic Print dialog (WordPad's, PrintDlg)
listed no printer at all -- an empty name box, nothing to print to (QA VM
walk 2026-11-28). Windows gives every user a default printer; now
GetDefaultPrinterW, finding none, makes the CUPS default one (if it is a
printer here, else the first printer) and answers with it.
Gate test/cupsjobs-gate.sh default part (64/32-bit); mutant
SG_MUTANT_NO_DEFAULT_CHOICE.
---
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -6849,6 +6849,47 @@
  *	This function must read the value from data 'device' of key
  *	HCU\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Windows
  */
+/* Stained Glass OS (9213): a user with printers but no default printer of
+ * their own -- the printers were made by the system (sg-printers-refresh) or
+ * in another account, where the default was set -- is given one, as Windows
+ * gives each user a default printer: the CUPS default if it is a printer
+ * here, else the first printer. Without it the classic Print dialog listed
+ * no printer at all (WordPad) and GetDefaultPrinter said there was none. */
+static BOOL choose_default_printer( void )
+{
+    unsigned int size = 10000, num = 0, i;
+    struct enum_printers_params enum_params = { NULL, &size, &num };
+    PRINTER_INFO_4W *pi4 = NULL;
+    DWORD needed = 0, count = 0, j;
+    const WCHAR *choice = NULL;
+    NTSTATUS status;
+    BOOL ret = FALSE;
+
+    EnumPrintersW( PRINTER_ENUM_LOCAL, NULL, 4, NULL, 0, &needed, &count );
+    if (!needed || !(pi4 = malloc( needed ))) return FALSE;
+    if (!EnumPrintersW( PRINTER_ENUM_LOCAL, NULL, 4, (BYTE *)pi4, needed, &needed, &count ) || !count) goto done;
+    do
+    {
+        size *= 2;
+        free( enum_params.printers );
+        enum_params.printers = malloc( size );
+        status = enum_params.printers ? UNIX_CALL( enum_printers, &enum_params ) : STATUS_NO_MEMORY;
+    } while (status == STATUS_BUFFER_OVERFLOW);
+    for (i = 0; !status && i < num && !choice; i++)
+    {
+        if (!enum_params.printers[i].is_default) continue;
+        for (j = 0; j < count; j++)
+            if (!wcsicmp( pi4[j].pPrinterName, enum_params.printers[i].name )) choice = pi4[j].pPrinterName;
+    }
+    if (!choice) choice = pi4[0].pPrinterName;
+    TRACE( "no default printer, choosing %s\n", debugstr_w( choice ) );
+    ret = SetDefaultPrinterW( choice );
+done:
+    free( enum_params.printers );
+    free( pi4 );
+    return ret;
+}
+
 BOOL WINAPI GetDefaultPrinterW(LPWSTR name, LPDWORD namesize)
 {
     BOOL  retval = TRUE;
@@ -6869,7 +6910,11 @@
     len = max(100, (insize + 20));
     buffer = malloc( len * sizeof(WCHAR));
 
-    if (!GetProfileStringW( L"windows", L"device", L"", buffer, len ))
+    if (!GetProfileStringW( L"windows", L"device", L"", buffer, len )
+#ifndef SG_MUTANT_NO_DEFAULT_CHOICE
+        && (!choose_default_printer() || !GetProfileStringW( L"windows", L"device", L"", buffer, len ))
+#endif
+        )
     {
         SetLastError (ERROR_FILE_NOT_FOUND);
         retval = FALSE;
