From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] schedsvc: SchRpcRename renames a task or folder

SchRpcRename was E_NOTIMPL. It renames a task or folder within its folder:
the new name is a bare name (invalid characters give ERROR_INVALID_NAME), it
must be free (ERROR_ALREADY_EXISTS), the source must exist, the root cannot
be renamed (E_ACCESSDENIED) and the reserved flags must be zero
(E_INVALIDARG). The test also loses two todo_wine markers on checks that pass
(a registered task is enabled and ready).
---
--- a/dlls/schedsvc/schedsvc.c
+++ b/dlls/schedsvc/schedsvc.c
@@ -989,10 +989,44 @@ HRESULT __cdecl SchRpcDelete(const WCHAR *path, DWORD flags)
     return hr;
 }
 
+/* MS-TSCH SchRpcRename: a task or folder keeps its folder and takes the new
+ * name (just a name: no path). The root cannot be renamed, the new name must
+ * be free, and the flags are reserved. */
 HRESULT __cdecl SchRpcRename(const WCHAR *path, const WCHAR *name, DWORD flags)
 {
-    FIXME("%s,%s,%#lx: stub\n", debugstr_w(path), debugstr_w(name), flags);
-    return E_NOTIMPL;
+    WCHAR *old_full, *new_full, *slash;
+    const WCHAR *bare = path;
+    HRESULT hr = S_OK;
+
+    TRACE("%s,%s,%#lx\n", debugstr_w(path), debugstr_w(name), flags);
+
+    if (flags) return E_INVALIDARG;
+
+    while (*bare == '\\' || *bare == '/') bare++;
+    if (!*bare) return E_ACCESSDENIED;
+    if (!*name || wcspbrk(name, L"\\/:*?\"<>|")) return HRESULT_FROM_WIN32(ERROR_INVALID_NAME);
+
+    old_full = get_full_name(path, NULL);
+    if (!old_full) return E_OUTOFMEMORY;
+    if (!(new_full = malloc((lstrlenW(old_full) + lstrlenW(name) + 1) * sizeof(WCHAR))))
+    {
+        free(old_full);
+        return E_OUTOFMEMORY;
+    }
+    lstrcpyW(new_full, old_full);
+    if ((slash = wcsrchr(new_full, '\\'))) lstrcpyW(slash + 1, name);
+
+#ifdef SG_MUTANT_RENAME_OVERWRITE
+    if (!MoveFileExW(old_full, new_full, MOVEFILE_REPLACE_EXISTING)) hr = HRESULT_FROM_WIN32(GetLastError());
+#else
+    if (GetFileAttributesW(new_full) != INVALID_FILE_ATTRIBUTES) hr = HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS);
+    else if (!MoveFileW(old_full, new_full)) hr = HRESULT_FROM_WIN32(GetLastError());
+#endif
+    if (hr == S_OK) taskrun_unforce(bare);
+
+    free(old_full);
+    free(new_full);
+    return hr;
 }
 
 HRESULT __cdecl SchRpcScheduledRuntimes(const WCHAR *path, SYSTEMTIME *start, SYSTEMTIME *end, DWORD flags,
--- a/dlls/schedsvc/tests/rpcapi.c
+++ b/dlls/schedsvc/tests/rpcapi.c
@@ -538,9 +538,7 @@ START_TEST(rpcapi)
     enabled = state = 0xdeadbeef;
     hr = SchRpcGetTaskInfo(L"\\Wine\\Task1", SCH_FLAG_STATE, &enabled, &state);
     ok(hr == S_OK, "expected S_OK, got %#lx\n", hr);
-    todo_wine
     ok(enabled == 1, "expected 1, got %lu\n", enabled);
-    todo_wine
     ok(state == TASK_STATE_READY, "expected TASK_STATE_READY, got %lu\n", state);
 
     hr = SchRpcDelete(L"Wine\\Task1", 0);
@@ -569,6 +567,45 @@ START_TEST(rpcapi)
         MIDL_user_free(path);
     }
 
+    /* SchRpcRename */
+    path = NULL;
+    info = NULL;
+    hr = SchRpcRegisterTask(L"WineRename\\Old", xml1, TASK_CREATE, NULL, TASK_LOGON_NONE, 0, NULL, &path, &info);
+    ok(hr == S_OK, "expected S_OK, got %#lx\n", hr);
+    MIDL_user_free(path);
+    path = NULL;
+    hr = SchRpcRegisterTask(L"WineRename\\Other", xml1, TASK_CREATE, NULL, TASK_LOGON_NONE, 0, NULL, &path, &info);
+    ok(hr == S_OK, "expected S_OK, got %#lx\n", hr);
+    MIDL_user_free(path);
+
+    hr = SchRpcRename(L"WineRename\\Old", L"New", 1);
+    ok(hr == E_INVALIDARG, "expected E_INVALIDARG, got %#lx\n", hr);
+    hr = SchRpcRename(L"WineRename\\Old", L"Other", 0);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS), "expected ERROR_ALREADY_EXISTS, got %#lx\n", hr);
+    hr = SchRpcRename(L"WineRename\\Old", L"A\\B", 0);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_INVALID_NAME), "expected ERROR_INVALID_NAME, got %#lx\n", hr);
+    hr = SchRpcRename(L"WineRename\\Missing", L"New", 0);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND), "expected ERROR_FILE_NOT_FOUND, got %#lx\n", hr);
+    hr = SchRpcRename(L"\\", L"New", 0);
+    ok(hr == E_ACCESSDENIED, "expected E_ACCESSDENIED, got %#lx\n", hr);
+
+    hr = SchRpcRename(L"\\WineRename\\Old", L"New", 0);
+    ok(hr == S_OK, "expected S_OK, got %#lx\n", hr);
+    xml = NULL;
+    count = 0;
+    hr = SchRpcRetrieveTask(L"WineRename\\Old", L"", &count, &xml);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND), "the old name is gone: %#lx\n", hr);
+    hr = SchRpcRetrieveTask(L"WineRename\\New", L"", &count, &xml);
+    ok(hr == S_OK, "the new name has the task: %#lx\n", hr);
+    if (hr == S_OK) MIDL_user_free(xml);
+
+    hr = SchRpcDelete(L"WineRename\\New", 0);
+    ok(hr == S_OK, "expected S_OK, got %#lx\n", hr);
+    hr = SchRpcDelete(L"WineRename\\Other", 0);
+    ok(hr == S_OK, "expected S_OK, got %#lx\n", hr);
+    hr = SchRpcDelete(L"\\WineRename", 0);
+    ok(hr == S_OK, "expected S_OK, got %#lx\n", hr);
+
     hr = RpcBindingFree(&schrpc_handle);
     ok(hr == RPC_S_OK, "RpcBindingFree error %#lx\n", hr);
 }
