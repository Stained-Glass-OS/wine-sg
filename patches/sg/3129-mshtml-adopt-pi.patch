From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 00:26:21 -0700
Subject: [PATCH] mshtml: createProcessingInstruction and adoptNode

document.createProcessingInstruction returns a processing instruction node
object (IDOMProcessingInstruction: target, data, nodeType 7, own prototype)
for document modes 9 and later; nodeType of processing instruction and CDATA
nodes is 7 and 4 instead of 0. document.adoptNode moves a node and its subtree
into the document through the engine and moves the node objects over to the
new document, so a script variable holding the node stays the same object.

diff --git a/dlls/mshtml/htmldoc.c b/dlls/mshtml/htmldoc.c
index 222cc77..65595eb 100644
--- a/dlls/mshtml/htmldoc.c
+++ b/dlls/mshtml/htmldoc.c
@@ -350,6 +350,180 @@ HRESULT create_doctype_node(HTMLDocumentNode *doc, nsIDOMNode *nsnode, HTMLDOMNo
     return S_OK;
 }
 
+typedef struct {
+    HTMLDOMNode node;
+    IDOMProcessingInstruction IDOMProcessingInstruction_iface;
+} ProcessingInstruction;
+
+static inline ProcessingInstruction *impl_from_IDOMProcessingInstruction(IDOMProcessingInstruction *iface)
+{
+    return CONTAINING_RECORD(iface, ProcessingInstruction, IDOMProcessingInstruction_iface);
+}
+
+DISPEX_IDISPATCH_IMPL(ProcessingInstruction, IDOMProcessingInstruction,
+                      impl_from_IDOMProcessingInstruction(iface)->node.event_target.dispex)
+
+static HRESULT WINAPI ProcessingInstruction_get_target(IDOMProcessingInstruction *iface, BSTR *p)
+{
+    ProcessingInstruction *This = impl_from_IDOMProcessingInstruction(iface);
+    nsAString nsstr;
+    nsresult nsres;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    nsAString_Init(&nsstr, NULL);
+    nsres = nsIDOMNode_GetNodeName(This->node.nsnode, &nsstr);
+    return return_nsstr(nsres, &nsstr, p);
+}
+
+static HRESULT WINAPI ProcessingInstruction_put_data(IDOMProcessingInstruction *iface, BSTR v)
+{
+    ProcessingInstruction *This = impl_from_IDOMProcessingInstruction(iface);
+    nsAString nsstr;
+    nsresult nsres;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_w(v));
+
+    nsAString_InitDepend(&nsstr, v);
+    nsres = nsIDOMNode_SetNodeValue(This->node.nsnode, &nsstr);
+    nsAString_Finish(&nsstr);
+    return map_nsresult(nsres);
+}
+
+static HRESULT WINAPI ProcessingInstruction_get_data(IDOMProcessingInstruction *iface, BSTR *p)
+{
+    ProcessingInstruction *This = impl_from_IDOMProcessingInstruction(iface);
+    nsAString nsstr;
+    nsresult nsres;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    nsAString_Init(&nsstr, NULL);
+    nsres = nsIDOMNode_GetNodeValue(This->node.nsnode, &nsstr);
+    return return_nsstr(nsres, &nsstr, p);
+}
+
+static const IDOMProcessingInstructionVtbl ProcessingInstructionVtbl = {
+    ProcessingInstruction_QueryInterface,
+    ProcessingInstruction_AddRef,
+    ProcessingInstruction_Release,
+    ProcessingInstruction_GetTypeInfoCount,
+    ProcessingInstruction_GetTypeInfo,
+    ProcessingInstruction_GetIDsOfNames,
+    ProcessingInstruction_Invoke,
+    ProcessingInstruction_get_target,
+    ProcessingInstruction_put_data,
+    ProcessingInstruction_get_data
+};
+
+static inline ProcessingInstruction *ProcessingInstruction_from_HTMLDOMNode(HTMLDOMNode *iface)
+{
+    return CONTAINING_RECORD(iface, ProcessingInstruction, node);
+}
+
+static inline ProcessingInstruction *ProcessingInstruction_from_DispatchEx(DispatchEx *iface)
+{
+    return CONTAINING_RECORD(iface, ProcessingInstruction, node.event_target.dispex);
+}
+
+static HRESULT ProcessingInstruction_clone(HTMLDOMNode *iface, nsIDOMNode *nsnode, HTMLDOMNode **ret)
+{
+    ProcessingInstruction *This = ProcessingInstruction_from_HTMLDOMNode(iface);
+
+    return create_pi_node(This->node.doc, nsnode, ret);
+}
+
+static const cpc_entry_t ProcessingInstruction_cpc[] = {{NULL}};
+
+static const NodeImplVtbl ProcessingInstructionImplVtbl = {
+    .cpc_entries           = ProcessingInstruction_cpc,
+    .clone                 = ProcessingInstruction_clone
+};
+
+static void *ProcessingInstruction_query_interface(DispatchEx *dispex, REFIID riid)
+{
+    ProcessingInstruction *This = ProcessingInstruction_from_DispatchEx(dispex);
+
+    if(IsEqualGUID(&IID_IDOMProcessingInstruction, riid))
+        return &This->IDOMProcessingInstruction_iface;
+
+    return HTMLDOMNode_query_interface(&This->node.event_target.dispex, riid);
+}
+
+static nsISupports *ProcessingInstruction_get_gecko_target(DispatchEx *dispex)
+{
+    ProcessingInstruction *This = ProcessingInstruction_from_DispatchEx(dispex);
+    return (nsISupports*)This->node.nsnode;
+}
+
+static EventTarget *ProcessingInstruction_get_parent_event_target(DispatchEx *dispex)
+{
+    ProcessingInstruction *This = ProcessingInstruction_from_DispatchEx(dispex);
+    nsIDOMNode *nsnode;
+    HTMLDOMNode *node;
+    nsresult nsres;
+    HRESULT hres;
+
+    nsres = nsIDOMNode_GetParentNode(This->node.nsnode, &nsnode);
+    assert(nsres == NS_OK);
+    if(!nsnode)
+        return NULL;
+
+    hres = get_node(nsnode, TRUE, &node);
+    nsIDOMNode_Release(nsnode);
+    if(FAILED(hres))
+        return NULL;
+
+    return &node->event_target;
+}
+
+static IHTMLEventObj *ProcessingInstruction_set_current_event(DispatchEx *dispex, IHTMLEventObj *event)
+{
+    ProcessingInstruction *This = ProcessingInstruction_from_DispatchEx(dispex);
+    return default_set_current_event(This->node.doc->window, event);
+}
+
+static const event_target_vtbl_t ProcessingInstruction_event_target_vtbl = {
+    {
+        .query_interface     = ProcessingInstruction_query_interface,
+        .destructor          = HTMLDOMNode_destructor,
+        .traverse            = HTMLDOMNode_traverse,
+        .unlink              = HTMLDOMNode_unlink
+    },
+    .get_gecko_target        = ProcessingInstruction_get_gecko_target,
+    .get_parent_event_target = ProcessingInstruction_get_parent_event_target,
+    .set_current_event       = ProcessingInstruction_set_current_event
+};
+
+static const tid_t ProcessingInstruction_iface_tids[] = {
+    IDOMProcessingInstruction_tid,
+    0
+};
+
+dispex_static_data_t ProcessingInstruction_dispex = {
+    .id           = PROT_ProcessingInstruction,
+    .prototype_id = PROT_Node,
+    .vtbl         = &ProcessingInstruction_event_target_vtbl.dispex_vtbl,
+    .disp_tid     = IDOMProcessingInstruction_tid,
+    .iface_tids   = ProcessingInstruction_iface_tids,
+    .init_info    = HTMLDOMNode_init_dispex_info,
+};
+
+HRESULT create_pi_node(HTMLDocumentNode *doc, nsIDOMNode *nsnode, HTMLDOMNode **ret)
+{
+    ProcessingInstruction *pi;
+
+    if(!(pi = calloc(1, sizeof(*pi))))
+        return E_OUTOFMEMORY;
+
+    pi->node.vtbl = &ProcessingInstructionImplVtbl;
+    pi->IDOMProcessingInstruction_iface.lpVtbl = &ProcessingInstructionVtbl;
+    HTMLDOMNode_Init(doc, &pi->node, nsnode, &ProcessingInstruction_dispex);
+
+    *ret = &pi->node;
+    return S_OK;
+}
+
 static inline HTMLDocumentNode *impl_from_IHTMLDocument2(IHTMLDocument2 *iface)
 {
     return CONTAINING_RECORD(iface, HTMLDocumentNode, IHTMLDocument2_iface);
@@ -3884,16 +4058,118 @@ static HRESULT WINAPI HTMLDocument7_createProcessingInstruction(IHTMLDocument7 *
         BSTR data, IDOMProcessingInstruction **newProcessingInstruction)
 {
     HTMLDocumentNode *This = impl_from_IHTMLDocument7(iface);
-    FIXME("(%p)->(%s %s %p)\n", This, debugstr_w(target), debugstr_w(data), newProcessingInstruction);
+    nsIDOMProcessingInstruction *nspi;
+    nsAString target_str, data_str;
+    nsIDOMNode *nsnode;
+    HTMLDOMNode *node;
+    nsresult nsres;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s %s %p)\n", This, debugstr_w(target), debugstr_w(data), newProcessingInstruction);
+
+    if(!This->dom_document)
+        return E_FAIL;
+#ifdef SG_MUTANT_MSHTML_NOPI
     return E_NOTIMPL;
+#endif
+
+    nsAString_InitDepend(&target_str, target);
+    nsAString_InitDepend(&data_str, data);
+    nsres = nsIDOMDocument_CreateProcessingInstruction(This->dom_document, &target_str, &data_str, &nspi);
+    nsAString_Finish(&target_str);
+    nsAString_Finish(&data_str);
+    if(NS_FAILED(nsres))
+        return map_nsresult(nsres);
+
+    nsres = nsISupports_QueryInterface((nsISupports*)nspi, &IID_nsIDOMNode, (void**)&nsnode);
+    nsISupports_Release((nsISupports*)nspi);
+    if(NS_FAILED(nsres))
+        return map_nsresult(nsres);
+    hres = get_node(nsnode, TRUE, &node);
+    nsIDOMNode_Release(nsnode);
+    if(FAILED(hres))
+        return hres;
+
+    hres = IHTMLDOMNode_QueryInterface(&node->IHTMLDOMNode_iface, &IID_IDOMProcessingInstruction,
+                                       (void**)newProcessingInstruction);
+    IHTMLDOMNode_Release(&node->IHTMLDOMNode_iface);
+    return hres;
+}
+
+static HRESULT adopt_rewrap(HTMLDocumentNode *doc, nsIDOMNode *nsnode)
+{
+    nsIDOMNode *child, *next;
+    HTMLDOMNode *node;
+    HRESULT hres;
+
+    /* a wrapper keeps the document it was made for: move it over, so that script variables holding it stay valid */
+    hres = get_node(nsnode, FALSE, &node);
+    if(FAILED(hres))
+        return hres;
+    if(node) {
+        if(node->doc != doc && &node->doc->node != node) {
+            HTMLDocumentNode *old = node->doc;
+            IHTMLDOMNode_AddRef(&doc->node.IHTMLDOMNode_iface);
+            node->doc = doc;
+            IHTMLDOMNode_Release(&old->node.IHTMLDOMNode_iface);
+        }
+        IHTMLDOMNode_Release(&node->IHTMLDOMNode_iface);
+    }
+
+    nsIDOMNode_GetFirstChild(nsnode, &child);
+    while(child) {
+        hres = adopt_rewrap(doc, child);
+        nsIDOMNode_GetNextSibling(child, &next);
+        nsIDOMNode_Release(child);
+        if(FAILED(hres)) {
+            if(next) nsIDOMNode_Release(next);
+            return hres;
+        }
+        child = next;
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI HTMLDocument7_adoptNode(IHTMLDocument7 *iface, IHTMLDOMNode *pNodeSource, IHTMLDOMNode3 **ppNodeDest)
 {
     HTMLDocumentNode *This = impl_from_IHTMLDocument7(iface);
-    /* the node object of a node keeps the document it was made for, so it cannot be moved over */
-    FIXME("(%p)->(%p %p)\n", This, pNodeSource, ppNodeDest);
-    return E_NOTIMPL;
+    nsIDOMNode *nsnode = NULL;
+    HTMLDOMNode *node;
+    nsresult nsres;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p %p)\n", This, pNodeSource, ppNodeDest);
+
+    if(!This->dom_document)
+        return E_UNEXPECTED;
+
+    if(!(node = unsafe_impl_from_IHTMLDOMNode(pNodeSource))) {
+        WARN("not our node\n");
+        return E_FAIL;
+    }
+
+    nsres = nsIDOMDocument_AdoptNode(This->dom_document, node->nsnode, &nsnode);
+    if(NS_FAILED(nsres))
+        return map_nsresult(nsres);
+
+    if(!nsnode) {
+        *ppNodeDest = NULL;
+        return S_OK;
+    }
+
+#ifdef SG_MUTANT_MSHTML_NOADOPT
+    hres = S_OK;
+#else
+    hres = adopt_rewrap(This, nsnode);
+#endif
+    if(SUCCEEDED(hres))
+        hres = get_node(nsnode, TRUE, &node);
+    nsIDOMNode_Release(nsnode);
+    if(FAILED(hres))
+        return hres;
+
+    *ppNodeDest = &node->IHTMLDOMNode3_iface;
+    return S_OK;
 }
 
 static HRESULT WINAPI HTMLDocument7_put_onmssitemodejumplistitemremoved(IHTMLDocument7 *iface, VARIANT v)
