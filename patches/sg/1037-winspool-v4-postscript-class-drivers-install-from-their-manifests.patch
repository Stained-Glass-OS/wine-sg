From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winspool: v4 PostScript class drivers install from their manifests

A v4 driver package (ClassVer=4.0) names no driver in its INF: each
model's files include a "<model>-manifest.ini" whose [DriverConfig] gives
the data file and the class driver. The installer reads it: a PostScript
class model (DriverFile=PSCRIPT5.DLL, Konica Minolta's and HP's inbox PS
packages) installs on our PostScript driver with its PPD and prints from
it. A model rendered by its maker's XPS filters (a GPD and no DriverFile:
Canon's and Epson's inbox drivers) is not installed, with
ERROR_UNKNOWN_PRINTER_DRIVER, as we do not run XPS filter pipelines.

Test: test/psdriver-gate.sh (mutant SG_MUTANT_V4PS).
---
--- a/dlls/winspool.drv/install.c
+++ b/dlls/winspool.drv/install.c
@@ -634,6 +634,44 @@
     else TRACE( "language monitor %s (%s)\n", debugstr_w(ic->monitor), debugstr_w(ic->monitor_dll) );
 }
 
+/* a v4 package (ClassVer 4.0) names its driver in a manifest among its files
+ * (Microsoft Learn, "V4 driver manifest"): [DriverConfig] DataFile and
+ * DriverFile. A PostScript class driver (DriverFile=PSCRIPT5.DLL) prints from
+ * its PPD on our PostScript driver; a GPD one renders through its maker's XPS
+ * filters, which we do not run, so it is not installed. */
+static BOOL read_manifest( struct install_ctx *ic )
+{
+    WCHAR path[MAX_PATH], value[MAX_PATH];
+    unsigned int i;
+    size_t len;
+
+    for (i = 0; i < ic->files.count; i++)
+    {
+        len = wcslen( ic->files.names[i] );
+        if (len > 13 && !wcsicmp( ic->files.names[i] + len - 13, L"-manifest.ini" )) break;
+    }
+    if (i == ic->files.count) return TRUE;  /* not a v4 package */
+    if (!find_file( ic, ic->files.names[i], path, MAX_PATH ))
+    {
+        WARN( "%s: no %s in the package\n", debugstr_w(ic->model), debugstr_w(ic->files.names[i]) );
+        return FALSE;
+    }
+    TRACE( "%s: v4 manifest %s\n", debugstr_w(ic->model), debugstr_w(ic->files.names[i]) );
+    if (!ic->data[0]) GetPrivateProfileStringW( L"DriverConfig", L"DataFile", L"", ic->data, MAX_PATH, path );
+    GetPrivateProfileStringW( L"DriverConfig", L"DriverFile", L"", value, ARRAY_SIZE(value), path );
+#ifndef SG_MUTANT_V4PS
+    if (!wcsicmp( value, L"PSCRIPT5.DLL" ))
+    {
+        if (!ic->driver[0]) wcscpy( ic->driver, L"PSCRIPT5.DLL" );
+        if (!ic->config[0]) wcscpy( ic->config, L"PS5UI.DLL" );
+        return TRUE;
+    }
+#endif
+    WARN( "%s: a v4 driver rendered by XPS filters (%s): not supported\n", debugstr_w(ic->model),
+          debugstr_w(ic->data) );
+    return FALSE;
+}
+
 static BOOL install_from_inf( const WCHAR *inf_path, const WCHAR *model, const WCHAR *env )
 {
     WCHAR install[MAX_PATH], section[MAX_PATH], inf_dir[MAX_PATH], *slash;
@@ -664,6 +702,11 @@
         if (!SetupFindFirstLineW( ic.inf, section, NULL, &ctx )) wcscpy( section, install );
     }
     read_section( &ic, section );
+    if (!ic.driver[0] && !read_manifest( &ic ))
+    {
+        SetLastError( ERROR_UNKNOWN_PRINTER_DRIVER );
+        goto done;
+    }
     /* an old rule: the section names the driver file when nothing else does */
     if (!ic.driver[0]) wcscpy( ic.driver, install );
     if (!ic.data[0]) wcscpy( ic.data, install );
