--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -617,6 +617,7 @@
     XWindowChanges changes;
     DWORD timestamp;
     Window below;
+    BOOL topmost;
 
     if (!data->whole_window) return;
 
@@ -640,9 +641,11 @@
 
     /* Set X focus and install colormap. In a virtual desktop (Stained Glass
      * OS) the focused window goes where Wine's Z order has it -- activating a
-     * window brings it to the top of its band, never above a topmost one --
-     * not always to the top. */
-    if (get_stack_predecessor( data->hwnd, data->managed, &below ) ||
+     * window brings it to the top of its band, never above a topmost one of
+     * this process (Word's topmost error box over its splash); otherwise it
+     * is raised. */
+    if (get_stack_predecessor( data->hwnd, data->managed, &below, &topmost ) || !topmost ||
+        (NtUserGetWindowLongW( data->hwnd, GWL_EXSTYLE ) & WS_EX_TOPMOST) ||
         !stack_window_below( data->display, data->whole_window, below ))
     {
         changes.stack_mode = Above;
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -1337,17 +1337,30 @@
  * the top of them, and a focused one was raised to the top. Their X stacking
  * must follow Wine's Z order: returns TRUE when the window is the top visible
  * one, else FALSE with *below the X window of the visible window before it
- * (0 outside a virtual desktop, where the window manager stacks).
+ * when that is one of this process's (0 otherwise, and outside a virtual
+ * desktop, where the window manager stacks), and *topmost whether it is a
+ * topmost window.
  */
-BOOL get_stack_predecessor( HWND hwnd, BOOL managed, Window *below )
+BOOL get_stack_predecessor( HWND hwnd, BOOL managed, Window *below, BOOL *topmost )
 {
     HWND prev = NtUserGetWindowRelative( hwnd, GW_HWNDPREV );
+    DWORD pid, prev_pid;
 
     *below = 0;
+    if (topmost) *topmost = FALSE;
     while (prev && !(NtUserGetWindowLongW( prev, GWL_STYLE ) & WS_VISIBLE))
         prev = NtUserGetWindowRelative( prev, GW_HWNDPREV );
     if (!prev) return TRUE;
-    if (is_virtual_desktop() && !managed) *below = X11DRV_get_whole_window( prev );
+    if (!is_virtual_desktop() || managed) return FALSE;
+    /* Only a window of this process: another process's X window (explorer's
+     * taskbar and desktop windows) may sit anywhere in the X stack, and a
+     * window put below it went below the window that owned it -- an owned
+     * popup opened hidden under its owner. */
+    NtUserGetWindowThread( hwnd, &pid );
+    NtUserGetWindowThread( prev, &prev_pid );
+    if (pid != prev_pid) return FALSE;
+    *below = X11DRV_get_whole_window( prev );
+    if (topmost) *topmost = !!(NtUserGetWindowLongW( prev, GWL_EXSTYLE ) & WS_EX_TOPMOST);
     return FALSE;
 }
 
