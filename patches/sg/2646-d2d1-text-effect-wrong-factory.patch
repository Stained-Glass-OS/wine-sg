From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: a text drawing effect brush of another factory is D2DERR_WRONG_FACTORY

The drawing effect of a range of a text layout that is a brush made by a different factory than the
render target's was drawn with. The Wine test (todo) records that native fails the drawing: EndDraw
returns D2DERR_WRONG_FACTORY. The run with that effect is not drawn and the target stays usable.
---
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -3833,6 +3833,23 @@ static HRESULT STDMETHODCALLTYPE d2d_text_renderer_DrawGlyphRun(IDWriteTextRende
 
     TRACE("%s\n", debugstr_wn(glyph_run_desc->string, glyph_run_desc->stringLength));
 
+    /* a drawing effect brush that belongs to another factory is an error of the drawing */
+#ifndef SG_MUTANT_D2DTXT_WRONG_FACTORY_IGNORED
+    {
+        ID2D1Factory *brush_factory;
+
+        ID2D1Brush_GetFactory(brush, &brush_factory);
+        if (brush_factory != render_target->factory)
+        {
+            d2d_device_context_set_error(render_target, D2DERR_WRONG_FACTORY);
+            ID2D1Factory_Release(brush_factory);
+            ID2D1Brush_Release(brush);
+            return S_OK;
+        }
+        ID2D1Factory_Release(brush_factory);
+    }
+#endif
+
     if (context->options & D2D1_DRAW_TEXT_OPTIONS_ENABLE_COLOR_FONT)
     {
         IDWriteFontFace2 *fontface;
--- a/dlls/d2d1/tests/d2d1.c
+++ b/dlls/d2d1/tests/d2d1.c
@@ -5859,7 +5859,7 @@ static void test_draw_text_layout(BOOL d3d11)
     ID2D1RenderTarget_DrawTextLayout(rt, origin, text_layout, (ID2D1Brush*)brush, D2D1_DRAW_TEXT_OPTIONS_NONE);
 
     hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
-    todo_wine ok(hr == D2DERR_WRONG_FACTORY, "Got unexpected hr %#lx.\n", hr);
+    ok(hr == D2DERR_WRONG_FACTORY, "Got unexpected hr %#lx.\n", hr);
 
     /* Effect is d2d resource, but not a brush. */
     set_rect(&rect, 0.0f, 0.0f, 10.0f, 10.0f);
