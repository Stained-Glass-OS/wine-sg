From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcp90: Collate by code unit in the "C" locale.

In the "C" locale the Dinkumware collation helpers order strings by code
unit, as strcmp and wcscmp do (a prefix sorts first). _Strcoll and _Wcscoll
used CompareString with the user's locale (LCID 0, or LocaleNameToLCID(NULL)
for msvcp110 and later), so "A" and "Z" sorted after "a" in the "C" locale;
_Strxfrm and _Wcsxfrm of msvcp110 and later produced linguistic sort keys there
for the same reason. A named locale still collates with CompareString.

msvcrt (before msvcr110): setlocale keeps a category that is already "C"
when "C" is asked for again, instead of building it anew. msvcp90's collate
test relies on that on Windows: it gives the "C" collate category another
handle, and collate<char> built afterwards (whose _Locinfo sets "C" again)
must still compare linguistically.

Gate: test/msvcp-c-collate-gate.sh (msvcp60 .. msvcp140, 64/32).
---
 dlls/msvcp90/locale.c | 51 +++++++++++++++++++++++++++++++++++++++++++++++++--
 dlls/msvcrt/locale.c  |  8 ++++++++
 2 files changed, 57 insertions(+), 2 deletions(-)

diff --git a/dlls/msvcp90/locale.c b/dlls/msvcp90/locale.c
index ad841e3..cc9c0b3 100644
--- a/dlls/msvcp90/locale.c
+++ b/dlls/msvcp90/locale.c
@@ -3738,6 +3738,49 @@ static collate* collate_char_use_facet(const locale *loc)
     return obj;
 }
 
+/* the "C" locale collates in code unit order */
+static BOOL collvec_is_c_locale(const _Collvec *coll)
+{
+#ifdef SG_MUTANT_C_COLLATE_LINGUISTIC
+    return FALSE;
+#endif
+#if _MSVCP_VER < 110
+    return !(coll ? coll->handle : ___lc_handle_func()[LC_COLLATE]);
+#else
+    const wchar_t *name = coll ? coll->lc_name : ___lc_locale_name_func()[LC_COLLATE];
+    return !name || !name[0];
+#endif
+}
+
+/* compares two ranges of code units like memcmp, a prefix first */
+static int compare_code_units(const void *first1, size_t len1, const void *first2, size_t len2, size_t unit)
+{
+    size_t i, len = min(len1, len2);
+
+    for (i = 0; i < len; i++)
+    {
+        int c1, c2;
+
+        if (unit == 1)
+        {
+#ifdef SG_MUTANT_C_COLLATE_SIGNED_CHAR
+            c1 = ((const signed char *)first1)[i];
+            c2 = ((const signed char *)first2)[i];
+#else
+            c1 = ((const unsigned char *)first1)[i];
+            c2 = ((const unsigned char *)first2)[i];
+#endif
+        }
+        else
+        {
+            c1 = ((const wchar_t *)first1)[i];
+            c2 = ((const wchar_t *)first2)[i];
+        }
+        if (c1 != c2) return c1 < c2 ? -1 : 1;
+    }
+    return len1 == len2 ? 0 : (len1 < len2 ? -1 : 1);
+}
+
 /* _Strcoll */
 int __cdecl _Strcoll(const char *first1, const char *last1, const char *first2,
         const char *last2, const _Collvec *coll)
@@ -3746,6 +3789,8 @@ int __cdecl _Strcoll(const char *first1, const char *last1, const char *first2,
 
     TRACE("(%s %s)\n", debugstr_an(first1, last1-first1), debugstr_an(first2, last2-first2));
 
+    if (collvec_is_c_locale(coll))
+        return compare_code_units(first1, last1 - first1, first2, last2 - first2, 1);
 #if _MSVCP_VER < 110
     lcid = (coll ? coll->handle : ___lc_handle_func()[LC_COLLATE]);
 #else
@@ -4099,6 +4144,8 @@ int __cdecl _Wcscoll(const wchar_t *first1, const wchar_t *last1, const wchar_t
 {
     TRACE("(%s %s)\n", debugstr_wn(first1, last1-first1), debugstr_wn(first2, last2-first2));
 
+    if (collvec_is_c_locale(coll))
+        return compare_code_units(first1, last1 - first1, first2, last2 - first2, sizeof(wchar_t));
 #if _MSVCP_VER < 110
     return CompareStringW(coll ? coll->handle : ___lc_handle_func()[LC_COLLATE],
             0, first1, last1-first1, first2, last2-first2)-CSTR_EQUAL;
@@ -16052,7 +16099,7 @@ size_t __cdecl _Strxfrm(char *dest, char *dest_end,
     lcid = LocaleNameToLCID(cv.lc_name, 0);
 #endif
 
-    if (!lcid && !cv.page)
+    if (collvec_is_c_locale(&cv) && !cv.page)
     {
         if (src_len > dest_len) return src_len;
         memcpy(dest, src, src_len);
@@ -16092,7 +16139,7 @@ size_t __cdecl _Wcsxfrm(wchar_t *dest, wchar_t *dest_end,
     lcid = LocaleNameToLCID(cv.lc_name, 0);
 #endif
 
-    if (!lcid)
+    if (collvec_is_c_locale(&cv))
     {
         if (src_len > dest_len) return src_len;
         memcpy(dest, src, src_len * sizeof(wchar_t));
diff --git a/dlls/msvcrt/locale.c b/dlls/msvcrt/locale.c
index 85714a7..ff6cec3 100644
--- a/dlls/msvcrt/locale.c
+++ b/dlls/msvcrt/locale.c
@@ -1200,6 +1200,14 @@ static inline BOOL category_needs_update(int cat,
     if(!locinfo->lc_name[cat] || !sname) return TRUE;
     return wcscmp(sname, locinfo->lc_name[cat]) != 0 || cp!=locinfo->lc_id[cat].wCodePage;
 #else
+    /* a category that is "C" already stays as it is (msvcp90's collate test
+     * relies on this on Windows) */
+#ifndef SG_MUTANT_SETLOCALE_C_REBUILD
+    if(!sname && locinfo->lc_category[cat].locale && !strcmp(locinfo->lc_category[cat].locale, "C"))
+#else
+    if(0)
+#endif
+        return cp!=locinfo->lc_id[cat].wCodePage;
     lcid = sname ? LocaleNameToLCID(sname, 0) : 0;
     return lcid!=locinfo->lc_handle[cat] || cp!=locinfo->lc_id[cat].wCodePage;
 #endif
