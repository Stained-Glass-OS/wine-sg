From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msscript: Timeout stops a script that runs longer, with its error and the Timeout event

The Script Control stops a script that runs longer than its Timeout, as Windows' does: the call fails with E_FAIL and the error "The script was aborted because execution exceeded the specified timeout period.", the Timeout event fires, then the Error event. With AllowUI the person is asked first. Wine let such a script run for ever.
---
diff --git a/dlls/msscript.ocx/msscript.c b/dlls/msscript.ocx/msscript.c
index 66ee99b..71c856a 100644
--- a/dlls/msscript.ocx/msscript.c
+++ b/dlls/msscript.ocx/msscript.c
@@ -161,6 +161,13 @@ struct ScriptHost {
 
     unsigned int module_count;
     struct list named_items;
+
+    /* the Timeout property (wine-sg 7723): a script that runs longer is stopped */
+    LONG timeout;               /* milliseconds; -1 none; 0 not watched */
+    VARIANT_BOOL allow_ui;      /* ask first whether to stop it */
+    LONG enter_depth;           /* OnEnterScript nesting */
+    HANDLE timer;               /* while a script runs */
+    LONG timed_out;             /* the running script was stopped for its time */
 };
 
 struct ScriptControl {
@@ -781,12 +788,49 @@ static HRESULT WINAPI ActiveScriptSite_OnScriptError(IActiveScriptSite *iface, I
     return S_FALSE;
 }
 
+/* The script ran past Timeout. With AllowUI the person is asked whether to stop it (asked again after
+ * as long again when they let it go on); then the engine is interrupted: the call fails with E_FAIL,
+ * "The script was aborted because execution exceeded the specified timeout period.", as on Windows,
+ * and the Timeout event follows (fire_timeout_event). From a thread pool thread. */
+static void CALLBACK script_timeout_proc(void *param, BOOLEAN fired)
+{
+    ScriptHost *host = param;
+    EXCEPINFO ei;
+
+    if (host->timed_out || !host->script) return;
+    if (host->allow_ui && MessageBoxW(NULL, L"A script on this page is taking longer than expected to run. "
+            L"Do you want to stop it?", L"Script Control", MB_YESNO | MB_ICONWARNING | MB_TASKMODAL) != IDYES)
+        return;
+    if (InterlockedExchange(&host->timed_out, 1)) return;
+    memset(&ei, 0, sizeof(ei));
+    ei.bstrSource = SysAllocString(L"ScriptControl");
+    ei.bstrDescription = SysAllocString(L"The script was aborted because execution exceeded the specified timeout period.");
+    ei.scode = E_FAIL;
+    TRACE("host %p: stopping the script after %ld ms\n", host, host->timeout);
+#ifndef SG_MUTANT_TIMEOUT_NOT_ENFORCED
+    IActiveScript_InterruptScriptThread(host->script, SCRIPTTHREADID_ALL, &ei, 0);
+#endif
+    SysFreeString(ei.bstrSource);
+    SysFreeString(ei.bstrDescription);
+}
+
 static HRESULT WINAPI ActiveScriptSite_OnEnterScript(IActiveScriptSite *iface)
 {
     ScriptHost *This = impl_from_IActiveScriptSite(iface);
 
     TRACE("(%p)\n", This);
 
+    if (This->enter_depth++ == 0 && This->timeout > 0 && !This->timer)
+    {
+        This->timed_out = 0;
+        IActiveScriptSite_AddRef(&This->IActiveScriptSite_iface);
+        if (!CreateTimerQueueTimer(&This->timer, NULL, script_timeout_proc, This, This->timeout, This->timeout,
+                WT_EXECUTELONGFUNCTION))
+        {
+            This->timer = NULL;
+            IActiveScriptSite_Release(&This->IActiveScriptSite_iface);
+        }
+    }
     return S_OK;
 }
 
@@ -796,6 +840,13 @@ static HRESULT WINAPI ActiveScriptSite_OnLeaveScript(IActiveScriptSite *iface)
 
     TRACE("(%p)\n", This);
 
+    if (This->enter_depth > 0 && --This->enter_depth == 0 && This->timer)
+    {
+        /* waits for a timeout being taken (or asked about) to finish */
+        DeleteTimerQueueTimer(NULL, This->timer, INVALID_HANDLE_VALUE);
+        This->timer = NULL;
+        IActiveScriptSite_Release(&This->IActiveScriptSite_iface);
+    }
     return S_OK;
 }
 
@@ -2572,6 +2623,11 @@ static HRESULT init_script_host(ScriptControl *control, const CLSID *clsid, Scri
     }
     host->script_state = SCRIPTSTATE_INITIALIZED;
     host->site_hwnd = control->allow_ui ? control->site_hwnd : ((HWND)-1);
+    host->timeout = control->timeout;
+    host->allow_ui = control->allow_ui;
+    host->enter_depth = 0;
+    host->timer = NULL;
+    host->timed_out = 0;
     host->error = control->error;
     IScriptError_AddRef(&host->error->IScriptError_iface);
 
@@ -2902,11 +2958,9 @@ static HRESULT WINAPI ScriptControl_put_Timeout(IScriptControl *iface, LONG time
     if (timeout < -1)
         return CTL_E_INVALIDPROPERTYVALUE;
 
-    if (timeout != -1)
-        FIXME("execution timeout ignored\n");
-
     This->timeout = timeout;
     This->dirty = TRUE;
+    if (This->host) This->host->timeout = timeout;
     return S_OK;
 }
 
@@ -2930,7 +2984,10 @@ static HRESULT WINAPI ScriptControl_put_AllowUI(IScriptControl *iface, VARIANT_B
     This->allow_ui = allow_ui;
     This->dirty = TRUE;
     if (This->host)
+    {
         This->host->site_hwnd = allow_ui ? This->site_hwnd : ((HWND)-1);
+        This->host->allow_ui = allow_ui;
+    }
     return S_OK;
 }
 
@@ -3064,8 +3121,28 @@ static HRESULT fire_error_event(ScriptControl *This, HRESULT hr)
 #ifdef SG_MUTANT_NO_ERROR_EVENT
     return hr;
 #endif
+    /* a script stopped for its time: the error is the control's own (whatever the engine made of the
+     * interrupt), the Timeout event, then the Error event for the abort */
+    if (This->host && InterlockedExchange(&This->host->timed_out, 0))
+    {
+        hr = E_FAIL;
+        if (This->error)
+        {
+            IScriptError_Clear(&This->error->IScriptError_iface);
+            This->error->info_filled = TRUE;
+            This->error->number = E_FAIL;
+            This->error->source = SysAllocString(L"ScriptControl");
+            This->error->desc = SysAllocString(L"The script was aborted because execution exceeded the specified timeout period.");
+        }
+        for (i = 0; !This->events_frozen && i < cp->sink_count; i++)
+        {
+            if (FAILED(IUnknown_QueryInterface(cp->sinks[i].unk, &IID_IDispatch, (void **)&sink))) continue;
+            IDispatch_Invoke(sink, 0xbb9, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &dp, NULL, NULL, NULL);
+            IDispatch_Release(sink);
+        }
+    }
     if (SUCCEEDED(hr) || This->events_frozen || !cp->sink_count) return hr;
-    had_error = This->error && This->error->object;
+    had_error = This->error && (This->error->object || (This->error->info_filled && This->error->number));
 
     for (i = 0; i < cp->sink_count; i++)
     {
@@ -3073,7 +3150,7 @@ static HRESULT fire_error_event(ScriptControl *This, HRESULT hr)
         IDispatch_Invoke(sink, 0xbb8, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &dp, NULL, NULL, NULL);
         IDispatch_Release(sink);
     }
-    if (had_error && !This->error->object) return S_OK;
+    if (had_error && !This->error->object && !This->error->number) return S_OK;
     return hr;
 }
 
@@ -3530,6 +3607,11 @@ static HRESULT WINAPI PersistStreamInit_Load(IPersistStreamInit *iface, IStream
     if (read != sizeof(data) || data.version != 1) return E_FAIL;
     This->timeout = data.timeout;
     This->allow_ui = data.allow_ui;
+    if (This->host)
+    {
+        This->host->timeout = This->timeout;
+        This->host->allow_ui = This->allow_ui;
+    }
     This->use_safe_subset = data.use_safe_subset;
     This->dirty = FALSE;
     return S_OK;
