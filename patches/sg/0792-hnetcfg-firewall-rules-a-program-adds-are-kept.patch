+static WCHAR *new_rule_id( HKEY key, const WCHAR *name )
+{
+    WCHAR *id = malloc( (wcslen( name ) + 16) * sizeof(WCHAR) );
+    int i;
+    if (!id) return NULL;
+    wcscpy( id, name );
+    for (i = 2; !RegQueryValueExW( key, id, NULL, NULL, NULL, NULL ) && i < 10000; i++)
+        swprintf( id, wcslen( name ) + 16, L"%s (%d)", name, i );
+    return id;
+}
