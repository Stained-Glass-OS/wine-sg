From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] hnetcfg: firewall rules a program adds are kept

Installers that set up Windows Firewall -- Sonos Desktop Controller's on
David's Latitude (2026-10-02) -- add a rule through INetFwPolicy2::Rules
and then look for it, list the rules or turn a rule group on. Wine's rules
collection was a stub: Count always 0, Add kept nothing, Item and the
enumeration (For Each, _NewEnum) failed with E_NOTIMPL, and a rule's
properties were E_NOTIMPL too, so the installer failed.

Rules are now kept where Windows keeps them -- the FirewallRules key under
SharedAccess\Parameters\FirewallPolicy, one value per rule in Windows'
"v2.30|Action=Allow|Dir=In|Protocol=6|LPort=...|App=...|Name=...|" form --
and the collection adds, counts, finds, lists and removes them; a rule got
from it is live (a change is stored). Adding or removing one needs an
administrator, as on Windows (E_ACCESSDENIED). A rule has every property of
INetFwRule3. The policy answers what installers ask: the firewall is on,
the current profile is Private, the local policy can be changed, inbound
blocked and outbound allowed by default; rule groups follow their rules
(EnableRuleGroup, IsRuleGroupEnabled).

Also: the type information table had no entries for INetFwRule and
INetFwRules, so a rule's and the rules' IDispatch (scripts) looked up
IUPnPNAT's and every scripted call failed.

The rules are recorded, not enforced: the machine's own firewall is
Linux's.

Test: test/fwrules-gate.sh with test/fwrules-probe.c and test/fwrules.vbs
(mutant SG_MUTANT_FW_RULES_STUB).
---
--- a/dlls/hnetcfg/apps.c
+++ b/dlls/hnetcfg/apps.c
@@ -114,6 +114,10 @@
     &IID_INetFwPolicy,
     &IID_INetFwPolicy2,
     &IID_INetFwProfile,
+    /* Stained Glass OS: in type_id's order -- without these two, a rule's
+     * and the rules' IDispatch (scripts, For Each) looked up IUPnPNAT's */
+    &IID_INetFwRule,
+    &IID_INetFwRules,
     &IID_IUPnPNAT,
     &IID_IStaticPortMappingCollection,
     &IID_IStaticPortMapping,
--- a/dlls/hnetcfg/policy.c
+++ b/dlls/hnetcfg/policy.c
@@ -55,27 +55,232 @@
     return CONTAINING_RECORD(iface, fw_policy2, INetFwPolicy2_iface);
 }
 
+/* Stained Glass OS: firewall rules that programs add (their installers, as
+ * Sonos's does) are kept where Windows keeps them -- the FirewallRules key,
+ * one value per rule in its "v2.30|Action=Allow|Dir=In|..." form -- so a
+ * rule added can be found, listed and removed again; adding or removing one
+ * needs an administrator, as on Windows (E_ACCESSDENIED otherwise). A rule
+ * got from the collection is live: changing it changes the stored rule. */
+#define SG_FW_PROTOCOL_ANY 256   /* NET_FW_IP_PROTOCOL_ANY */
+#define SG_FW_RULES_KEY L"System\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy\\FirewallRules"
+
 typedef struct fw_rule
 {
-    INetFwRule INetFwRule_iface;
+    INetFwRule3 INetFwRule3_iface;
     LONG refs;
+    WCHAR *id;          /* its value in the FirewallRules key, once stored */
+    WCHAR *name;
+    WCHAR *desc;
+    WCHAR *app;
+    WCHAR *service;
+    WCHAR *lports;
+    WCHAR *rports;
+    WCHAR *laddrs;
+    WCHAR *raddrs;
+    WCHAR *icmp;
+    WCHAR *iftypes;
+    WCHAR *grouping;
+    WCHAR *package;
+    WCHAR *owner;
+    WCHAR *luserauth;
+    WCHAR *ruserauth;
+    LONG protocol, direction, profiles, action, edge_options;
+    VARIANT_BOOL enabled, edge;
 } fw_rule;
 
 static inline fw_rule *impl_from_INetFwRule( INetFwRule *iface )
 {
-    return CONTAINING_RECORD(iface, fw_rule, INetFwRule_iface);
+    return CONTAINING_RECORD((INetFwRule3 *)iface, fw_rule, INetFwRule3_iface);
+}
+
+static inline fw_rule *impl_from_INetFwRule3( INetFwRule3 *iface )
+{
+    return CONTAINING_RECORD(iface, fw_rule, INetFwRule3_iface);
+}
+
+static void rule_init( fw_rule *rule )
+{
+    memset( rule, 0, sizeof(*rule) );
+    rule->refs = 1;
+    rule->protocol = SG_FW_PROTOCOL_ANY;
+    rule->direction = NET_FW_RULE_DIR_IN;
+    rule->profiles = NET_FW_PROFILE2_ALL;
+    rule->action = NET_FW_ACTION_ALLOW;
+}
+
+static WCHAR *str_dup( const WCHAR *s )
+{
+    WCHAR *r;
+    if (!s || !*s) return NULL;
+    if ((r = malloc( (wcslen( s ) + 1) * sizeof(WCHAR) ))) wcscpy( r, s );
+    return r;
+}
+
+static void set_str( WCHAR **field, const WCHAR *s )
+{
+    free( *field );
+    *field = str_dup( s );
+}
+
+static HRESULT get_str( const WCHAR *field, BSTR *out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (field && !(*out = SysAllocString( field ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+/* ---- the stored form: "v2.30|Key=Value|...|" ---- */
+
+struct fw_text { WCHAR *buf; size_t len, cap; };
+
+static void text_add( struct fw_text *t, const WCHAR *key, const WCHAR *val )
+{
+    size_t need = wcslen( key ) + (val ? wcslen( val ) : 0) + 3;
+    WCHAR *n;
+    if (t->len + need + 1 > t->cap)
+    {
+        size_t cap = max( t->cap * 2, t->len + need + 64 );
+        if (!(n = realloc( t->buf, cap * sizeof(WCHAR) ))) return;
+        t->buf = n; t->cap = cap;
+    }
+    if (val) t->len += swprintf( t->buf + t->len, t->cap - t->len, L"%s=%s|", key, val );
+    else t->len += swprintf( t->buf + t->len, t->cap - t->len, L"%s|", key );
+}
+
+/* a list ("80,443") as one Key=item per item, as Windows writes it */
+static void text_add_list( struct fw_text *t, const WCHAR *key, const WCHAR *list )
+{
+    WCHAR *copy, *item, *ctx;
+    if (!list || !wcscmp( list, L"*" ) || !(copy = str_dup( list ))) return;
+    for (item = wcstok_s( copy, L",", &ctx ); item; item = wcstok_s( NULL, L",", &ctx )) text_add( t, key, item );
+    free( copy );
+}
+
+static WCHAR *rule_to_text( const fw_rule *r )
+{
+    struct fw_text t = { NULL, 0, 0 };
+    WCHAR num[16];
+    text_add( &t, L"v2.30", NULL );
+    text_add( &t, L"Action", r->action == NET_FW_ACTION_ALLOW ? L"Allow" : L"Block" );
+    text_add( &t, L"Active", r->enabled ? L"TRUE" : L"FALSE" );
+    text_add( &t, L"Dir", r->direction == NET_FW_RULE_DIR_OUT ? L"Out" : L"In" );
+    if (r->protocol != SG_FW_PROTOCOL_ANY)
+    {
+        swprintf( num, ARRAY_SIZE(num), L"%ld", r->protocol );
+        text_add( &t, L"Protocol", num );
+    }
+    if (r->profiles != NET_FW_PROFILE2_ALL)
+    {
+        if (r->profiles & NET_FW_PROFILE2_DOMAIN) text_add( &t, L"Profile", L"Domain" );
+        if (r->profiles & NET_FW_PROFILE2_PRIVATE) text_add( &t, L"Profile", L"Private" );
+        if (r->profiles & NET_FW_PROFILE2_PUBLIC) text_add( &t, L"Profile", L"Public" );
+    }
+    text_add_list( &t, L"LPort", r->lports );
+    text_add_list( &t, L"RPort", r->rports );
+    text_add_list( &t, L"LA4", r->laddrs );
+    text_add_list( &t, L"RA4", r->raddrs );
+    if (r->icmp) text_add_list( &t, L"ICMP4", r->icmp );
+    if (r->app) text_add( &t, L"App", r->app );
+    if (r->service) text_add( &t, L"Svc", r->service );
+    if (r->name) text_add( &t, L"Name", r->name );
+    if (r->desc) text_add( &t, L"Desc", r->desc );
+    if (r->grouping) text_add( &t, L"EmbedCtxt", r->grouping );
+    if (r->iftypes && wcscmp( r->iftypes, L"All" )) text_add( &t, L"IFType", r->iftypes );
+    if (r->edge) text_add( &t, L"Edge", L"TRUE" );
+    if (r->package) text_add( &t, L"AppPkgId", r->package );
+    if (r->owner) text_add( &t, L"LUOwn", r->owner );
+    if (r->luserauth) text_add( &t, L"LUAuth", r->luserauth );
+    if (r->ruserauth) text_add( &t, L"RUAuth", r->ruserauth );
+    return t.buf;
+}
+
+static void list_append( WCHAR **field, const WCHAR *item )
+{
+    WCHAR *n;
+    size_t len = *field ? wcslen( *field ) : 0;
+    if (!(n = realloc( *field, (len + wcslen( item ) + 2) * sizeof(WCHAR) ))) return;
+    if (len) { n[len] = ','; wcscpy( n + len + 1, item ); }
+    else wcscpy( n, item );
+    *field = n;
+}
+
+static void rule_from_text( fw_rule *r, const WCHAR *text )
+{
+    WCHAR *copy = str_dup( text ), *item, *ctx, *eq;
+    BOOL profiles = FALSE;
+    if (!copy) return;
+    for (item = wcstok_s( copy, L"|", &ctx ); item; item = wcstok_s( NULL, L"|", &ctx ))
+    {
+        if (!(eq = wcschr( item, '=' ))) continue;
+        *eq++ = 0;
+        if (!wcsicmp( item, L"Action" )) r->action = wcsicmp( eq, L"Block" ) ? NET_FW_ACTION_ALLOW : NET_FW_ACTION_BLOCK;
+        else if (!wcsicmp( item, L"Active" )) r->enabled = wcsicmp( eq, L"TRUE" ) ? VARIANT_FALSE : VARIANT_TRUE;
+        else if (!wcsicmp( item, L"Dir" )) r->direction = wcsicmp( eq, L"Out" ) ? NET_FW_RULE_DIR_IN : NET_FW_RULE_DIR_OUT;
+        else if (!wcsicmp( item, L"Protocol" )) r->protocol = wcstol( eq, NULL, 10 );
+        else if (!wcsicmp( item, L"Profile" ))
+        {
+            if (!profiles) { r->profiles = 0; profiles = TRUE; }
+            if (!wcsicmp( eq, L"Domain" )) r->profiles |= NET_FW_PROFILE2_DOMAIN;
+            else if (!wcsicmp( eq, L"Private" )) r->profiles |= NET_FW_PROFILE2_PRIVATE;
+            else if (!wcsicmp( eq, L"Public" )) r->profiles |= NET_FW_PROFILE2_PUBLIC;
+        }
+        else if (!wcsicmp( item, L"LPort" )) list_append( &r->lports, eq );
+        else if (!wcsicmp( item, L"RPort" )) list_append( &r->rports, eq );
+        else if (!wcsicmp( item, L"LA4" ) || !wcsicmp( item, L"LA6" )) list_append( &r->laddrs, eq );
+        else if (!wcsicmp( item, L"RA4" ) || !wcsicmp( item, L"RA6" )) list_append( &r->raddrs, eq );
+        else if (!wcsicmp( item, L"ICMP4" ) || !wcsicmp( item, L"ICMP6" )) list_append( &r->icmp, eq );
+        else if (!wcsicmp( item, L"App" )) set_str( &r->app, eq );
+        else if (!wcsicmp( item, L"Svc" )) set_str( &r->service, eq );
+        else if (!wcsicmp( item, L"Name" )) set_str( &r->name, eq );
+        else if (!wcsicmp( item, L"Desc" )) set_str( &r->desc, eq );
+        else if (!wcsicmp( item, L"EmbedCtxt" )) set_str( &r->grouping, eq );
+        else if (!wcsicmp( item, L"IFType" )) set_str( &r->iftypes, eq );
+        else if (!wcsicmp( item, L"Edge" )) r->edge = wcsicmp( eq, L"TRUE" ) ? VARIANT_FALSE : VARIANT_TRUE;
+        else if (!wcsicmp( item, L"AppPkgId" )) set_str( &r->package, eq );
+        else if (!wcsicmp( item, L"LUOwn" )) set_str( &r->owner, eq );
+        else if (!wcsicmp( item, L"LUAuth" )) set_str( &r->luserauth, eq );
+        else if (!wcsicmp( item, L"RUAuth" )) set_str( &r->ruserauth, eq );
+    }
+    free( copy );
+}
+
+static HRESULT open_rules_key( REGSAM access, HKEY *key )
+{
+    LSTATUS err = (access & KEY_SET_VALUE)
+        ? RegCreateKeyExW( HKEY_LOCAL_MACHINE, SG_FW_RULES_KEY, 0, NULL, 0, access, NULL, key, NULL )
+        : RegOpenKeyExW( HKEY_LOCAL_MACHINE, SG_FW_RULES_KEY, 0, access, key );
+    return err ? HRESULT_FROM_WIN32( err ) : S_OK;
+}
+
+/* a stored rule's changes go back to its value */
+static HRESULT rule_save( fw_rule *r )
+{
+    WCHAR *text;
+    HKEY key;
+    HRESULT hr;
+    LSTATUS err;
+    if (!r->id) return S_OK;
+    if (FAILED(hr = open_rules_key( KEY_SET_VALUE, &key ))) return hr;
+    if (!(text = rule_to_text( r ))) { RegCloseKey( key ); return E_OUTOFMEMORY; }
+    err = RegSetValueExW( key, r->id, 0, REG_SZ, (BYTE *)text, (wcslen( text ) + 1) * sizeof(WCHAR) );
+    free( text );
+    RegCloseKey( key );
+    return err ? HRESULT_FROM_WIN32( err ) : S_OK;
 }
 
