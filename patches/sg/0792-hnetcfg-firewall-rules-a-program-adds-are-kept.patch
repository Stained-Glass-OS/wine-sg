+/* a rule group is on when it has rules and those for these profiles are on */
+static HRESULT rule_group_enabled( LONG profiles, const WCHAR *group, VARIANT_BOOL *enabled )
+{
+    struct stored_rule *list;
+    DWORD n, i;
+    BOOL any = FALSE, all = TRUE;
+    HRESULT hr;
+
+    if (!enabled || !group) return E_POINTER;
+    if (FAILED(hr = load_rules( &list, &n ))) return hr;
+    for (i = 0; i < n; i++)
+    {
+        fw_rule *r = list[i].rule;
+        if (!r->grouping || wcsicmp( r->grouping, group ) || !(r->profiles & profiles)) continue;
+        any = TRUE;
+        if (!r->enabled) all = FALSE;
+    }
+    free_stored( list, n );
+    *enabled = any && all ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
