     return InterlockedIncrement( &This->refs );
 }
 
+static void rule_free_fields( fw_rule *r )
+{
+    free( r->id );
+    free( r->name );
+    free( r->desc );
+    free( r->app );
+    free( r->service );
+    free( r->lports );
+    free( r->rports );
+    free( r->laddrs );
+    free( r->raddrs );
+    free( r->icmp );
+    free( r->iftypes );
+    free( r->grouping );
+    free( r->package );
+    free( r->owner );
+    free( r->luserauth );
+    free( r->ruserauth );
+}
+
 static ULONG WINAPI netfw_rule_Release(
-    INetFwRule *iface )
+    INetFwRule3 *iface )
 {
-    fw_rule *This = impl_from_INetFwRule( iface );
+    fw_rule *This = impl_from_INetFwRule3( iface );
     LONG refs = InterlockedDecrement( &This->refs );
     if (!refs)
     {
         TRACE("destroying %p\n", This);
+        rule_free_fields( This );
         free( This );
     }
     return refs;
 }
 
