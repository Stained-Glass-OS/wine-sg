+/* For Each rule In policy.Rules: an IEnumVARIANT over the rules as they are */
+typedef struct fw_rules_enum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG refs;
+    struct stored_rule *list;
+    DWORD count, pos;
+} fw_rules_enum;
+
+static inline fw_rules_enum *impl_from_IEnumVARIANT( IEnumVARIANT *iface )
+{
+    return CONTAINING_RECORD(iface, fw_rules_enum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI rules_enum_QueryInterface( IEnumVARIANT *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IEnumVARIANT ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        IEnumVARIANT_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI rules_enum_AddRef( IEnumVARIANT *iface )
+{
+    return InterlockedIncrement( &impl_from_IEnumVARIANT( iface )->refs );
+}
+
+static ULONG WINAPI rules_enum_Release( IEnumVARIANT *iface )
+{
+    fw_rules_enum *This = impl_from_IEnumVARIANT( iface );
+    LONG refs = InterlockedDecrement( &This->refs );
+    if (!refs)
+    {
+        free_stored( This->list, This->count );
+        free( This );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI rules_enum_Next( IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched )
+{
+    fw_rules_enum *This = impl_from_IEnumVARIANT( iface );
+    ULONG i = 0;
+
+    if (!var) return E_POINTER;
+    for (; i < celt && This->pos < This->count; i++, This->pos++)
+    {
+        INetFwRule3 *r = &This->list[This->pos].rule->INetFwRule3_iface;
+        INetFwRule3_AddRef( r );
+        V_VT(&var[i]) = VT_DISPATCH;
+        V_DISPATCH(&var[i]) = (IDispatch *)r;
+    }
+    if (fetched) *fetched = i;
+    return i == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI rules_enum_Skip( IEnumVARIANT *iface, ULONG celt )
+{
+    fw_rules_enum *This = impl_from_IEnumVARIANT( iface );
+    This->pos = min( This->pos + celt, This->count );
+    return This->pos < This->count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI rules_enum_Reset( IEnumVARIANT *iface )
+{
+    impl_from_IEnumVARIANT( iface )->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_rules_enum( IUnknown **out );
+
+static HRESULT WINAPI rules_enum_Clone( IEnumVARIANT *iface, IEnumVARIANT **out )
+{
+    fw_rules_enum *This = impl_from_IEnumVARIANT( iface );
+    HRESULT hr;
+    if (!out) return E_POINTER;
+    if (FAILED(hr = create_rules_enum( (IUnknown **)out ))) return hr;
+    impl_from_IEnumVARIANT( *out )->pos = This->pos;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl rules_enum_vtbl =
+{
+    rules_enum_QueryInterface,
+    rules_enum_AddRef,
+    rules_enum_Release,
+    rules_enum_Next,
+    rules_enum_Skip,
+    rules_enum_Reset,
+    rules_enum_Clone
+};
+
+static HRESULT create_rules_enum( IUnknown **out )
+{
+    fw_rules_enum *e = calloc( 1, sizeof(*e) );
+    HRESULT hr;
+    if (!e) return E_OUTOFMEMORY;
+    if (FAILED(hr = load_rules( &e->list, &e->count ))) { free( e ); return hr; }
+    e->IEnumVARIANT_iface.lpVtbl = &rules_enum_vtbl;
+    e->refs = 1;
+    *out = (IUnknown *)&e->IEnumVARIANT_iface;
+    return S_OK;
 }
 
