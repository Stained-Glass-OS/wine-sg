-    return E_NOTIMPL;
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&engine->cs);
+    if (engine->flags & FLAGS_ENGINE_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (!engine->presentation.pd)
+        hr = MF_E_NOT_INITIALIZED;
+    else if (engine->presentation.selection)
+    {
+        /* The new selection is recorded in the presentation descriptor; a
+         * running topology is not rebuilt. */
+        for (i = 0; i < engine->presentation.selection_count && SUCCEEDED(hr); ++i)
+        {
+            if (engine->presentation.selection[i])
+                hr = IMFPresentationDescriptor_SelectStream(engine->presentation.pd, i);
+            else
+                hr = IMFPresentationDescriptor_DeselectStream(engine->presentation.pd, i);
+        }
+    }
+    LeaveCriticalSection(&engine->cs);
+
+    return hr;
 }
 
