 static HRESULT WINAPI media_engine_SetStreamSelection(IMFMediaEngineEx *iface, DWORD stream_index, BOOL enabled)
 {
-    FIXME("%p, %ld, %d stub.\n", iface, stream_index, enabled);
+    struct media_engine *engine = impl_from_IMFMediaEngineEx(iface);
+    IMFStreamDescriptor *sd;
+    DWORD count, i;
+    HRESULT hr;
+    BOOL selected;
 
-    return E_NOTIMPL;
+    TRACE("%p, %ld, %d.\n", iface, stream_index, enabled);
+
+    EnterCriticalSection(&engine->cs);
+    if (engine->flags & FLAGS_ENGINE_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (!engine->presentation.pd)
+        hr = MF_E_NOT_INITIALIZED;
+    else if (SUCCEEDED(hr = IMFPresentationDescriptor_GetStreamDescriptorByIndex(engine->presentation.pd,
+            stream_index, &selected, &sd)))
+    {
+        IMFStreamDescriptor_Release(sd);
+        if (!engine->presentation.selection
+                && SUCCEEDED(hr = IMFPresentationDescriptor_GetStreamDescriptorCount(engine->presentation.pd, &count)))
+        {
+            if (!(engine->presentation.selection = calloc(count, sizeof(*engine->presentation.selection))))
+                hr = E_OUTOFMEMORY;
+            else
+            {
+                engine->presentation.selection_count = count;
+                for (i = 0; i < count; ++i)
+                {
+                    if (SUCCEEDED(IMFPresentationDescriptor_GetStreamDescriptorByIndex(engine->presentation.pd,
+                            i, &selected, &sd)))
+                    {
+                        engine->presentation.selection[i] = selected;
+                        IMFStreamDescriptor_Release(sd);
+                    }
+                }
+            }
+        }
+        if (SUCCEEDED(hr))
+            engine->presentation.selection[stream_index] = !!enabled;
+    }
+    LeaveCriticalSection(&engine->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI media_engine_ApplyStreamSelections(IMFMediaEngineEx *iface)
 {
-    FIXME("%p stub.\n", iface);
+    struct media_engine *engine = impl_from_IMFMediaEngineEx(iface);
+    HRESULT hr = S_OK;
