+            break;
+        default:
+            hr = E_INVALIDARG;
+            break;
+    }
+    /* The pipeline keeps no counters: every statistic reads zero. */
+    LeaveCriticalSection(&engine->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI media_engine_UpdateVideoStream(IMFMediaEngineEx *iface, const MFVideoNormalizedRect *src,
         const RECT *dst, const MFARGB *border_color)
 {
-    FIXME("%p, %p, %p, %p stub.\n", iface, src, dst, border_color);
+    struct media_engine *engine = impl_from_IMFMediaEngineEx(iface);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p, %p, %p.\n", iface, src, dst, border_color);
+
+    if (!src && !dst && !border_color)
+        return E_INVALIDARG;
+    if (src && (src->left < 0.0f || src->top < 0.0f || src->right > 1.0f || src->bottom > 1.0f
+            || src->left >= src->right || src->top >= src->bottom))
+        return E_INVALIDARG;
+    if (dst && (dst->left >= dst->right || dst->top >= dst->bottom))
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&engine->cs);
+    if (engine->flags & FLAGS_ENGINE_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        /* Remembered; frames are transferred with the rectangles given to TransferVideoFrame. */
+        if (src) engine->video_stream.src = *src;
+        if (dst) engine->video_stream.dst = *dst;
+        if (border_color) engine->video_stream.border = *border_color;
+    }
+    LeaveCriticalSection(&engine->cs);
+
+    return hr;
 }
 
