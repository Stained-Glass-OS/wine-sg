+    PropVariantInit(stat);
+
+    EnterCriticalSection(&engine->cs);
+    if (engine->flags & FLAGS_ENGINE_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else switch (stat_id)
+    {
+        case MF_MEDIA_ENGINE_STATISTIC_FRAMES_RENDERED:
+        case MF_MEDIA_ENGINE_STATISTIC_FRAMES_DROPPED:
+        case MF_MEDIA_ENGINE_STATISTIC_BUFFER_PROGRESS:
+        case MF_MEDIA_ENGINE_STATISTIC_FRAMES_CORRUPTED:
+        case MF_MEDIA_ENGINE_STATISTIC_TOTAL_FRAME_DELAY:
+            stat->vt = VT_UI4;
+            break;
+        case MF_MEDIA_ENGINE_STATISTIC_BYTES_DOWNLOADED:
+            stat->vt = VT_UI8;
+            break;
+        case MF_MEDIA_ENGINE_STATISTIC_FRAMES_PER_SECOND:
+            stat->vt = VT_R4;
+            break;
+        case MF_MEDIA_ENGINE_STATISTIC_PLAYBACK_JITTER:
