 static HRESULT WINAPI media_engine_SetSourceElements(IMFMediaEngineEx *iface, IMFMediaEngineSrcElements *elements)
 {
-    FIXME("(%p, %p): stub.\n", iface, elements);
+    struct media_engine *engine = impl_from_IMFMediaEngineEx(iface);
+    BSTR url = NULL, type = NULL;
+    DWORD count, i;
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p.\n", iface, elements);
+
+    if (!elements)
+        return E_POINTER;
+
+    EnterCriticalSection(&engine->cs);
+
+    if (engine->flags & FLAGS_ENGINE_SHUT_DOWN)
+    {
+        hr = MF_E_SHUTDOWN;
+        goto done;
+    }
+
+    /* Pick the first element whose type is not known to be unsupported. */
+    count = IMFMediaEngineSrcElements_GetLength(elements);
+    for (i = 0; i < count; ++i)
+    {
+        MF_MEDIA_ENGINE_CANPLAY canplay = MF_MEDIA_ENGINE_CANPLAY_MAYBE;
+
+        SysFreeString(url);
+        SysFreeString(type);
+        url = type = NULL;
+
+        if (FAILED(hr = IMFMediaEngineSrcElements_GetURL(elements, i, &url)))
+            goto done;
+        if (!url || !*url)
+            continue;
+
+        if (engine->extension && SUCCEEDED(IMFMediaEngineSrcElements_GetType(elements, i, &type)) && type && *type)
+        {
+            if (SUCCEEDED(IMFMediaEngineExtension_CanPlayType(engine->extension,
+                    !!(engine->flags & MF_MEDIA_ENGINE_AUDIOONLY), type, &canplay))
+                    && canplay == MF_MEDIA_ENGINE_CANPLAY_NOT_SUPPORTED)
+                continue;
+        }
+        break;
+    }
+
+    if (i < count)
+        hr = media_engine_set_source(engine, NULL, url);
+    else
+    {
+        /* Empty list or nothing usable: no source, with an error for a non-empty list. */
+        hr = media_engine_set_source(engine, NULL, NULL);
+        if (SUCCEEDED(hr) && count)
+        {
+            engine->error_code = MF_MEDIA_ENGINE_ERR_SRC_NOT_SUPPORTED;
+            IMFMediaEngineNotify_EventNotify(engine->callback, MF_MEDIA_ENGINE_EVENT_ERROR,
+                    MF_MEDIA_ENGINE_ERR_SRC_NOT_SUPPORTED, MF_E_UNSUPPORTED_BYTESTREAM_TYPE);
+        }
+    }
+
+done:
+    LeaveCriticalSection(&engine->cs);
+    SysFreeString(url);
+    SysFreeString(type);
+
+    return hr;
 }
 
