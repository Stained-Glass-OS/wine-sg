From: Stained Glass OS <ke7oxh@gmail.com>
dwrite: face references of a font set have axis values

A reference taken from a font set (and so the references of its fonts)
carries the weight, width, italic and slant axes of the font, as the Wine
test records from native. Removes that todo_wine mark.
---
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -8300,10 +8300,38 @@ static UINT32 WINAPI dwritefontset_GetFontCount(IDWriteFontSet3 *iface)
     return set->count;
 }
 
+static BOOL fontset_entry_number(struct dwrite_fontset_entry *entry, DWRITE_FONT_PROPERTY_ID id, int *value)
+{
+    IDWriteLocalizedStrings *strings;
+    WCHAR buffer[16], *end;
+    BOOL ret = FALSE;
+
+    if (!(strings = fontset_entry_get_property(entry, id))) return FALSE;
+    if (SUCCEEDED(IDWriteLocalizedStrings_GetString(strings, 0, buffer, ARRAY_SIZE(buffer))))
+    {
+        *value = wcstol(buffer, &end, 10);
+        ret = end != buffer;
+    }
+    IDWriteLocalizedStrings_Release(strings);
+    return ret;
+}
+
+static float stretch_to_width(int stretch)
+{
+    static const float widths[] = { 100.0f, 50.0f, 62.5f, 75.0f, 87.5f, 100.0f, 112.5f, 125.0f, 150.0f, 200.0f };
+
+    return stretch >= 0 && stretch < ARRAY_SIZE(widths) ? widths[stretch] : 100.0f;
+}
+
 static HRESULT WINAPI dwritefontset_GetFontFaceReference(IDWriteFontSet3 *iface, UINT32 index,
         IDWriteFontFaceReference **reference)
 {
     struct dwrite_fontset *set = impl_from_IDWriteFontSet3(iface);
+    struct dwrite_fontset_entry *entry;
+    DWRITE_FONT_AXIS_VALUE axes[4];
+    IDWriteFontFaceReference1 *reference1;
+    int weight, stretch, style;
+    HRESULT hr;
 
     TRACE("%p, %u, %p.\n", iface, index, reference);
 
@@ -8312,8 +8340,32 @@ static HRESULT WINAPI dwritefontset_GetFontFaceReference(IDWriteFontSet3 *iface,
     if (index >= set->count)
         return E_INVALIDARG;
 
-    return IDWriteFactory7_CreateFontFaceReference_(set->factory, set->entries[index]->desc.file,
-            set->entries[index]->desc.face_index, set->entries[index]->desc.simulations, reference);
+    entry = set->entries[index];
+    /* A font of a set is a face with the axes of its weight, width, italic and slant. */
+#ifndef SG_MUTANT_DWSET_NO_AXES
+    if (fontset_entry_number(entry, DWRITE_FONT_PROPERTY_ID_WEIGHT, &weight)
+            && fontset_entry_number(entry, DWRITE_FONT_PROPERTY_ID_STRETCH, &stretch)
+            && fontset_entry_number(entry, DWRITE_FONT_PROPERTY_ID_STYLE, &style))
+    {
+        axes[0].axisTag = DWRITE_FONT_AXIS_TAG_WEIGHT;
+        axes[0].value = weight;
+        axes[1].axisTag = DWRITE_FONT_AXIS_TAG_WIDTH;
+        axes[1].value = stretch_to_width(stretch);
+        axes[2].axisTag = DWRITE_FONT_AXIS_TAG_ITALIC;
+        axes[2].value = style == DWRITE_FONT_STYLE_ITALIC ? 1.0f : 0.0f;
+        axes[3].axisTag = DWRITE_FONT_AXIS_TAG_SLANT;
+        axes[3].value = 0.0f;
+        if (SUCCEEDED(hr = IDWriteFactory7_CreateFontFaceReference(set->factory, entry->desc.file,
+                entry->desc.face_index, entry->desc.simulations, axes, ARRAY_SIZE(axes), &reference1)))
+        {
+            *reference = (IDWriteFontFaceReference *)reference1;
+            return S_OK;
+        }
+    }
+#endif
+
+    return IDWriteFactory7_CreateFontFaceReference_(set->factory, entry->desc.file,
+            entry->desc.face_index, entry->desc.simulations, reference);
 }
 
