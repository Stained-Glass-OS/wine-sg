From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ole32: StgOpenStorageEx returns the interface asked for (patch 5109)

Gap-CORE item 505. Gate with a mutant.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/ole32/storage32.c b/dlls/ole32/storage32.c
--- a/dlls/ole32/storage32.c
+++ b/dlls/ole32/storage32.c
@@ -8743,6 +8743,9 @@
  */
 HRESULT WINAPI StgOpenStorageEx(const WCHAR* pwcsName, DWORD grfMode, DWORD stgfmt, DWORD grfAttrs, STGOPTIONS* pStgOptions, void* reserved, REFIID riid, void** ppObjectOpen)
 {
+    IStorage *storage;
+    HRESULT hr;
+
     TRACE("%s, %#lx, %#lx, %#lx, %p, %p, %p, %p.\n", debugstr_w(pwcsName),
           grfMode, stgfmt, grfAttrs, pStgOptions, reserved, riid, ppObjectOpen);
 
@@ -8767,7 +8770,8 @@
             ERR("grfAttrs must be 0 or FILE_FLAG_NO_BUFFERING if stgfmt == STGFMT_DOCFILE\n");
             return STG_E_INVALIDPARAMETER;
         }
-        FIXME("Stub: calling StgOpenStorage, but ignoring pStgOptions and grfAttrs\n");
+        /* pStgOptions (the version and the sector size of a file to be created) and the
+         * FILE_FLAG_NO_BUFFERING hint have nothing to say about opening an existing file */
         break;
 
     case STGFMT_ANY:
@@ -8778,7 +8782,23 @@
         return STG_E_INVALIDPARAMETER;
     }
 
-    return StgOpenStorage(pwcsName, NULL, grfMode, NULL, 0, (IStorage **)ppObjectOpen);
+    if (!ppObjectOpen)
+        return STG_E_INVALIDPOINTER;
+    *ppObjectOpen = NULL;
+    if (!riid)
+        return STG_E_INVALIDPARAMETER;
+
+    if (FAILED(hr = StgOpenStorage(pwcsName, NULL, grfMode, NULL, 0, &storage)))
+        return hr;
+
+    /* IID_IStorage or IID_IPropertySetStorage, as the caller asked */
+#ifdef SG_MUTANT_STG_OPENEX_RIID
+    *ppObjectOpen = storage;
+    return S_OK;
+#endif
+    hr = IStorage_QueryInterface(storage, riid, ppObjectOpen);
+    IStorage_Release(storage);
+    return hr;
 }
 
 
