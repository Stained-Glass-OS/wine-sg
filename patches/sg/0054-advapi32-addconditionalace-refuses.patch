From: Stained Glass OS <dev@stained-glass.example>
Subject: advapi32: AddConditionalAce refuses conditional ACEs

A missing export Microsoft Edge delay-loads. Nothing in Wine compiles or
evaluates conditional ACEs, so refuse (ERROR_NOT_SUPPORTED) rather than add
an ACE that would grant or deny without its condition.

--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -305,6 +305,23 @@
  *  Success: ERROR_SUCCESS
  *  Failure: nonzero error code from Winerror.h
  */
+/******************************************************************************
+ * AddConditionalAce [ADVAPI32.@]
+ *
+ * Add a callback ACE whose condition is an SDDL conditional expression. The
+ * condition would have to be compiled to its binary form, and nothing in
+ * Wine evaluates conditional ACEs yet, so refuse it rather than add an ACE
+ * that would grant or deny without its condition.
+ */
+BOOL WINAPI AddConditionalAce( PACL acl, DWORD revision, DWORD flags, UCHAR type, DWORD mask,
+                               PSID sid, PWCHAR condition, DWORD *length )
+{
+    FIXME( "%p %lu %#lx %u %#lx %p %s %p: conditional ACEs are not supported\n",
+           acl, revision, flags, type, mask, sid, debugstr_w(condition), length );
+    SetLastError( ERROR_NOT_SUPPORTED );
+    return FALSE;
+}
+
 DWORD WINAPI BuildSecurityDescriptorA(
     IN PTRUSTEEA pOwner,
     IN PTRUSTEEA pGroup,
--- a/dlls/advapi32/advapi32.spec
+++ b/dlls/advapi32/advapi32.spec
@@ -25,7 +25,7 @@
 @ stdcall -import AddAuditAccessAce(ptr long long ptr long long)
 @ stdcall -import AddAuditAccessAceEx(ptr long long long ptr long long)
 @ stdcall -import AddAuditAccessObjectAce(ptr long long long ptr ptr ptr long long)
-# @ stub AddConditionalAce
+@ stdcall AddConditionalAce(ptr long long long long ptr ptr ptr)
 @ stdcall -import AddMandatoryAce(ptr long long long ptr)
 # @ stub AddUsersToEncryptedFile
 # @ stub AddUsersToEncryptedFileEx
