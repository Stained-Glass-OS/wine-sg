+       EVB_ISSESSION, EVB_COUNT };
+enum { EVS_TYPE, EVS_QUALIFIER, EVS_SRCURN, EVS_DATAFLD, EVS_PROPERTYNAME, EVS_DATA, EVS_COUNT };
+enum { EVP_SRCELEMENT, EVP_FROMELEMENT, EVP_TOELEMENT, EVP_SRCFILTER, EVP_RECORDSET,
+       EVP_BOOKMARKS, EVP_BOUNDELEMENTS, EVP_COUNT };
