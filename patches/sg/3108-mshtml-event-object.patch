@@ -526,8 +534,107 @@ typedef struct {
 
     DOMEvent *event;
     VARIANT return_value;
+
+    /* Values set by script/the host on the event object: they replace what the
+     * DOM event says (the legacy event object is a writable bag of properties). */
+    DWORD set_long, set_bool, val_bool, set_str, set_ptr;
+    LONG lval[EVL_COUNT];
+    BSTR sval[EVS_COUNT];
+    IUnknown *pval[EVP_COUNT];
+    struct list attrs;
 } HTMLEventObj;
 
+typedef struct {
+    struct list entry;
+    BSTR name;
+    VARIANT value;
+} event_attr_t;
+
+#define EV_GET_LONG(This, i, p) do { if((This)->set_long & (1u << (i))) { *(p) = (This)->lval[i]; return S_OK; } } while(0)
+#define EV_PUT_LONG(This, i, v) do { (This)->lval[i] = (v); (This)->set_long |= 1u << (i); return S_OK; } while(0)
+#define EV_GET_BOOL(This, i, p) do { if((This)->set_bool & (1u << (i))) { *(p) = variant_bool((This)->val_bool & (1u << (i))); return S_OK; } } while(0)
+#define EV_PUT_BOOL(This, i, v) do { (This)->set_bool |= 1u << (i); \
+        if(v) (This)->val_bool |= 1u << (i); else (This)->val_bool &= ~(1u << (i)); return S_OK; } while(0)
+
+static HRESULT ev_copy_str(BSTR src, BSTR *p)
+{
+    *p = NULL;
+    if(!src)
+        return S_OK;
+    return (*p = SysAllocStringLen(src, SysStringLen(src))) ? S_OK : E_OUTOFMEMORY;
+}
+
+#define EV_GET_STR(This, i, p) do { if((This)->set_str & (1u << (i))) return ev_copy_str((This)->sval[i], (p)); } while(0)
+
+static HRESULT ev_put_str(HTMLEventObj *This, unsigned i, BSTR v)
+{
+    BSTR copy = NULL;
+    if(v && !(copy = SysAllocStringLen(v, SysStringLen(v))))
+        return E_OUTOFMEMORY;
+    SysFreeString(This->sval[i]);
+    This->sval[i] = copy;
+    This->set_str |= 1u << i;
+    return S_OK;
+}
+
+#define EV_GET_PTR(This, i, p) do { if((This)->set_ptr & (1u << (i))) { \
+        if(((*(IUnknown**)(p)) = (This)->pval[i])) IUnknown_AddRef((This)->pval[i]); return S_OK; } } while(0)
+
+static HRESULT ev_put_ptr(HTMLEventObj *This, unsigned i, IUnknown *v)
+{
+#ifdef SG_MUTANT_MSHTML_EVENT_NOSET
+    return S_OK;
+#endif
+    if(v)
+        IUnknown_AddRef(v);
+    if(This->pval[i])
+        IUnknown_Release(This->pval[i]);
+    This->pval[i] = v;
+    This->set_ptr |= 1u << i;
+    return S_OK;
+}
+
+static void ev_free_overrides(HTMLEventObj *This)
+{
+    event_attr_t *attr, *next;
+    unsigned i;
+
+    for(i = 0; i < EVS_COUNT; i++) {
+        SysFreeString(This->sval[i]);
+        This->sval[i] = NULL;
+    }
+    for(i = 0; i < EVP_COUNT; i++) {
+        if(This->pval[i])
+            IUnknown_Release(This->pval[i]);
+        This->pval[i] = NULL;
+    }
+    This->set_long = This->set_bool = This->val_bool = This->set_str = This->set_ptr = 0;
+    LIST_FOR_EACH_ENTRY_SAFE(attr, next, &This->attrs, event_attr_t, entry) {
+        list_remove(&attr->entry);
+        SysFreeString(attr->name);
+        VariantClear(&attr->value);
+        free(attr);
+    }
+}
+
+static event_attr_t *ev_find_attr(HTMLEventObj *This, const WCHAR *name, LONG flags)
+{
+    event_attr_t *attr;
+
+    LIST_FOR_EACH_ENTRY(attr, &This->attrs, event_attr_t, entry) {
+        if(flags & 1 ? !wcscmp(attr->name, name) : !wcsicmp(attr->name, name))
+            return attr;
+    }
+    return NULL;
+}
+
+/* the keyboard event behind the legacy event object, if it is one */
+static BOOL ev_get_key_event(HTMLEventObj *This, IDOMKeyboardEvent **ret)
+{
+    return This->event && SUCCEEDED(IDOMEvent_QueryInterface(&This->event->IDOMEvent_iface,
+                                                             &IID_IDOMKeyboardEvent, (void**)ret));
+}
