+/* ---- STRRET ---------------------------------------------------------------------- */
+
+HRESULT WINAPI shcore_StrRetToStrW(STRRET *strret, const ITEMIDLIST *pidl, WCHAR **out)
+{
+    HRESULT hr = S_OK;
+    int len;
+
+    TRACE("%p, %p, %p\n", strret, pidl, out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!strret) return E_POINTER;
+
+    switch (strret->uType)
+    {
+    case STRRET_WSTR:
+        hr = SHStrDupW(strret->pOleStr, out);
+        CoTaskMemFree(strret->pOleStr);
+        strret->pOleStr = NULL;
+        return hr;
+    case STRRET_CSTR:
+        len = MultiByteToWideChar(CP_ACP, 0, strret->cStr, -1, NULL, 0);
+        if (!(*out = CoTaskMemAlloc(len * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+        MultiByteToWideChar(CP_ACP, 0, strret->cStr, -1, *out, len);
+        return S_OK;
+    case STRRET_OFFSET:
+        if (!pidl) return E_FAIL;
+        len = MultiByteToWideChar(CP_ACP, 0, (const char *)pidl + strret->uOffset, -1, NULL, 0);
+        if (!(*out = CoTaskMemAlloc(len * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+        MultiByteToWideChar(CP_ACP, 0, (const char *)pidl + strret->uOffset, -1, *out, len);
+        return S_OK;
+    default:
+        return E_FAIL;
+    }
+}
+
+HRESULT WINAPI shcore_StrRetToBufW(STRRET *strret, const ITEMIDLIST *pidl, WCHAR *buf, UINT len)
+{
+    WCHAR *str;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p, %u\n", strret, pidl, buf, len);
+
+    if (!buf || !len) return E_POINTER;
+    buf[0] = 0;
+    if (FAILED(hr = shcore_StrRetToStrW(strret, pidl, &str))) return hr;
+    lstrcpynW(buf, str, len);
+    CoTaskMemFree(str);
+    return S_OK;
+}
+
+HRESULT WINAPI shcore_StrRetToBSTR(STRRET *strret, const ITEMIDLIST *pidl, BSTR *bstr)
+{
+    WCHAR *str;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", strret, pidl, bstr);
+
+    if (!bstr) return E_POINTER;
+    *bstr = NULL;
+    if (FAILED(hr = shcore_StrRetToStrW(strret, pidl, &str))) return hr;
+    *bstr = SysAllocString(str);
+    CoTaskMemFree(str);
+    return *bstr ? S_OK : E_OUTOFMEMORY;
+}
