+/* ---- code page conversion ------------------------------------------------------------ */
+
+int WINAPI shcore_SHAnsiToUnicodeCP(UINT cp, const char *src, WCHAR *dest, int len)
+{
+    int ret = 1;
+
+    TRACE("%u, %s, %p, %d\n", cp, debugstr_a(src), dest, len);
+
+    if (!dest || !len) return 0;
+    if (src)
+    {
+        ret = MultiByteToWideChar(cp, 0, src, -1, dest, len);
+        if (!ret)
+        {
+            dest[len - 1] = 0;
+            ret = len;
+        }
+    }
+    else dest[0] = 0;
+    return ret;
+}
+
+int WINAPI shcore_SHUnicodeToAnsiCP(UINT cp, const WCHAR *src, char *dest, int len)
+{
+    int ret = 1;
+
+    TRACE("%u, %s, %p, %d\n", cp, debugstr_w(src), dest, len);
+
+    if (!dest || !len) return 0;
+    if (src)
+    {
+        ret = WideCharToMultiByte(cp, 0, src, -1, dest, len, NULL, NULL);
+        if (!ret)
+        {
+            dest[len - 1] = 0;
+            ret = len;
+        }
+    }
+    else dest[0] = 0;
+    return ret;
+}
