+/* ---- paths and drives ---------------------------------------------------------------- */
+
+BOOL WINAPI shcore_PathIsNetworkPathW(const WCHAR *path)
+{
+    WCHAR root[4];
+
+    TRACE("%s\n", debugstr_w(path));
+
+    if (!path || !path[0]) return FALSE;
+    if (path[0] == '\\' && path[1] == '\\') return TRUE;
+    if (path[1] == ':' && ((path[0] | 0x20) >= 'a' && (path[0] | 0x20) <= 'z'))
+    {
+        root[0] = path[0]; root[1] = ':'; root[2] = '\\'; root[3] = 0;
+        return GetDriveTypeW(root) == DRIVE_REMOTE;
+    }
+    return FALSE;
+}
+
+BOOL WINAPI shcore_PathIsNetworkPathA(const char *path)
+{
+    WCHAR buf[MAX_PATH];
+
+    if (!path) return FALSE;
+    MultiByteToWideChar(CP_ACP, 0, path, -1, buf, MAX_PATH);
+    return shcore_PathIsNetworkPathW(buf);
+}
+
+WCHAR * WINAPI shcore_PathBuildRootW(WCHAR *root, int drive)
+{
+    TRACE("%p, %d\n", root, drive);
+
+    if (!root) return NULL;
+    root[0] = 'A' + drive;
+    root[1] = ':';
+    root[2] = '\\';
+    root[3] = 0;
+    return root;
+}
+
+char * WINAPI shcore_PathBuildRootA(char *root, int drive)
+{
+    TRACE("%p, %d\n", root, drive);
+
+    if (!root) return NULL;
+    root[0] = 'A' + drive;
+    root[1] = ':';
+    root[2] = '\\';
+    root[3] = 0;
+    return root;
+}
+
+UINT WINAPI shcore_DriveType(int drive)
+{
+    WCHAR root[4];
+
+    return GetDriveTypeW(shcore_PathBuildRootW(root, drive));
+}
+
+static BOOL is_full_path(const WCHAR *path)
+{
+    if (path[0] == '\\' && path[1] == '\\') return TRUE;
+    return path[0] && path[1] == ':' && path[2] == '\\';
+}
+
+int WINAPI shcore_SHCreateDirectoryExW(HWND hwnd, const WCHAR *path, SECURITY_ATTRIBUTES *sa)
+{
+    WCHAR *parent, *p;
+    DWORD err, attr;
+    int ret;
+
+    TRACE("%p, %s, %p\n", hwnd, debugstr_w(path), sa);
+
+    if (!path || !path[0] || !is_full_path(path)) return ERROR_BAD_PATHNAME;
+    if (lstrlenW(path) >= MAX_PATH) return ERROR_FILENAME_EXCED_RANGE;
+
+    if (CreateDirectoryW(path, sa)) return ERROR_SUCCESS;
+    err = GetLastError();
+    if (err == ERROR_ALREADY_EXISTS)
+    {
+        attr = GetFileAttributesW(path);
+        return (attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY)) ? ERROR_ALREADY_EXISTS : ERROR_FILE_EXISTS;
+    }
+    if (err != ERROR_PATH_NOT_FOUND) return err;
+
+    if (!(parent = HeapAlloc(GetProcessHeap(), 0, (lstrlenW(path) + 1) * sizeof(WCHAR)))) return ERROR_OUTOFMEMORY;
+    lstrcpyW(parent, path);
+    p = parent + lstrlenW(parent);
+    while (p > parent && p[-1] == '\\') *--p = 0;
+    while (p > parent && p[-1] != '\\') p--;
+    if (p <= parent + 3)
+    {
+        HeapFree(GetProcessHeap(), 0, parent);
+        return ERROR_PATH_NOT_FOUND;
+    }
+    p[-1] = 0;
+    ret = shcore_SHCreateDirectoryExW(hwnd, parent, sa);
+    HeapFree(GetProcessHeap(), 0, parent);
+    if (ret != ERROR_SUCCESS && ret != ERROR_ALREADY_EXISTS) return ret;
+    return CreateDirectoryW(path, sa) ? ERROR_SUCCESS : GetLastError();
+}
+
+int WINAPI shcore_SHCreateDirectoryExA(HWND hwnd, const char *path, SECURITY_ATTRIBUTES *sa)
+{
+    WCHAR buf[MAX_PATH];
+
+    if (!path) return ERROR_BAD_PATHNAME;
+    if (!MultiByteToWideChar(CP_ACP, 0, path, -1, buf, MAX_PATH)) return ERROR_FILENAME_EXCED_RANGE;
+    return shcore_SHCreateDirectoryExW(hwnd, buf, sa);
+}
+
+int WINAPI shcore_SHCreateDirectory(HWND hwnd, const WCHAR *path)
+{
+    return shcore_SHCreateDirectoryExW(hwnd, path, NULL);
+}
