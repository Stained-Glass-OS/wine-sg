+/* ---- registry ------------------------------------------------------------------------ */
+
+DWORD WINAPI shcore_SHRegGetCLSIDKey(const GUID *guid, const WCHAR *sub, BOOL use_hkcu, BOOL create, HKEY *key)
+{
+    WCHAR path[200];
+    int len;
+
+    TRACE("%s, %s, %d, %d, %p\n", debugstr_guid(guid), debugstr_w(sub), use_hkcu, create, key);
+
+    if (!guid || !key) return ERROR_INVALID_PARAMETER;
+    len = swprintf(path, ARRAY_SIZE(path), L"Software\\Classes\\CLSID\\");
+    StringFromGUID2(guid, path + len, ARRAY_SIZE(path) - len);
+    if (sub && sub[0])
+    {
+        lstrcatW(path, L"\\");
+        lstrcpynW(path + lstrlenW(path), sub, ARRAY_SIZE(path) - lstrlenW(path));
+    }
+    if (create)
+        return RegCreateKeyExW(use_hkcu ? HKEY_CURRENT_USER : HKEY_LOCAL_MACHINE, path, 0, NULL, 0,
+                MAXIMUM_ALLOWED, NULL, key, NULL);
+    return RegOpenKeyExW(use_hkcu ? HKEY_CURRENT_USER : HKEY_LOCAL_MACHINE, path, 0, KEY_READ, key);
+}
+
+DWORD WINAPI shcore_SHGetValueGoodBootA(HKEY hkey, const char *subkey, const char *value, DWORD *type,
+        void *data, DWORD *size)
+{
+    return SHGetValueA(hkey, subkey, value, type, data, size);
+}
+
+DWORD WINAPI shcore_SHGetValueGoodBootW(HKEY hkey, const WCHAR *subkey, const WCHAR *value, DWORD *type,
+        void *data, DWORD *size)
+{
+    return SHGetValueW(hkey, subkey, value, type, data, size);
+}
+
+HRESULT WINAPI shcore_SHLoadRegUIStringW(HKEY hkey, const WCHAR *value, WCHAR *buf, DWORD size)
+{
+    HRESULT (WINAPI *load_indirect)(const WCHAR *, WCHAR *, UINT, void **);
+    WCHAR tmp[MAX_PATH * 2];
+    DWORD type, sz = sizeof(tmp) - sizeof(WCHAR);
+    HMODULE shlwapi;
+    LONG ls;
+
+    TRACE("%p, %s, %p, %lu\n", hkey, debugstr_w(value), buf, size);
+
+    if (!buf || !size) return E_FAIL;
+    buf[0] = 0;
+    if ((ls = RegQueryValueExW(hkey, value, NULL, &type, (BYTE *)tmp, &sz))) return HRESULT_FROM_WIN32(ls);
+    if (type != REG_SZ && type != REG_EXPAND_SZ) return E_FAIL;
+    tmp[sz / sizeof(WCHAR)] = 0;
+    if (!(shlwapi = LoadLibraryW(L"shlwapi.dll"))
+            || !(load_indirect = (void *)GetProcAddress(shlwapi, "SHLoadIndirectString")))
+        return E_FAIL;
+    return load_indirect(tmp, buf, size, NULL);
+}
+
+/* ---- COM helpers --------------------------------------------------------------------- */
+
+HRESULT WINAPI shcore_IUnknown_GetClassID(IUnknown *unk, CLSID *clsid)
+{
+    IPersist *persist;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", unk, clsid);
+
+    if (!clsid) return E_POINTER;
+    *clsid = null_guid;
+    if (!unk) return E_FAIL;
+    if (FAILED(hr = IUnknown_QueryInterface(unk, &local_iid_persist, (void **)&persist))) return hr;
+    hr = IPersist_GetClassID(persist, clsid);
+    IPersist_Release(persist);
+    return hr;
+}
+
+static const GUID sid_profferservice = { 0xcb728b20, 0xf786, 0x11ce, { 0x92, 0xad, 0x00, 0xaa, 0x00, 0xa7, 0x4c, 0xd0 } };
+
+HRESULT WINAPI shcore_IUnknown_ProfferService(IUnknown *unk, const GUID *service, IServiceProvider *sp, DWORD *cookie)
+{
+    IServiceProvider *site;
+    IProfferService *proffer;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p, %p\n", unk, debugstr_guid(service), sp, cookie);
+
+    if (!unk || !cookie) return E_FAIL;
+    if (FAILED(hr = IUnknown_QueryInterface(unk, &local_iid_sp, (void **)&site))) return hr;
+    hr = IServiceProvider_QueryService(site, &sid_profferservice, &local_iid_proffer, (void **)&proffer);
+    IServiceProvider_Release(site);
+    if (FAILED(hr)) return hr;
+    if (sp)
+        hr = IProfferService_ProfferService(proffer, service, sp, cookie);
+    else if (*cookie)
+    {
+        hr = IProfferService_RevokeService(proffer, *cookie);
+        *cookie = 0;
+    }
+    else hr = E_INVALIDARG;
+    IProfferService_Release(proffer);
+    return hr;
+}
+
+BOOL WINAPI shcore_GUIDFromStringW(const WCHAR *str, GUID *guid)
+{
+    TRACE("%s, %p\n", debugstr_w(str), guid);
+
+    if (!guid) return FALSE;
+    *guid = null_guid;
+    if (!str) return FALSE;
+    return SUCCEEDED(CLSIDFromString(str, guid));
+}
+
+/* ---- shared memory blocks ------------------------------------------------------------ */
+
+struct shared_header
+{
+    DWORD size;
+    DWORD pid;
+};
+
+static HANDLE open_process(DWORD pid, DWORD access)
+{
+    if (!pid || pid == GetCurrentProcessId()) return NULL;
+    return OpenProcess(access, FALSE, pid);
+}
+
+HANDLE WINAPI shcore_SHMapHandle(HANDLE handle, DWORD src_pid, DWORD dst_pid, DWORD access, DWORD options)
+{
+    HANDLE src = GetCurrentProcess(), dst = GetCurrentProcess(), ret = NULL, to_close_src = NULL, to_close_dst = NULL;
+
+    TRACE("%p, %lu, %lu, %#lx, %#lx\n", handle, src_pid, dst_pid, access, options);
+
+    if (src_pid != GetCurrentProcessId() && src_pid)
+    {
+        if (!(src = to_close_src = open_process(src_pid, PROCESS_DUP_HANDLE))) return NULL;
+    }
+    if (dst_pid != GetCurrentProcessId() && dst_pid)
+    {
+        if (!(dst = to_close_dst = open_process(dst_pid, PROCESS_DUP_HANDLE)))
+        {
+            if (to_close_src) CloseHandle(to_close_src);
+            return NULL;
+        }
+    }
+    if (!DuplicateHandle(src, handle, dst, &ret, access, FALSE, options)) ret = NULL;
+    if (to_close_src) CloseHandle(to_close_src);
+    if (to_close_dst) CloseHandle(to_close_dst);
+    return ret;
+}
+
+HANDLE WINAPI shcore_SHAllocShared(const void *data, DWORD size, DWORD dest_pid)
+{
+    HANDLE map, ret;
+    struct shared_header *hdr;
+
+    TRACE("%p, %lu, %lu\n", data, size, dest_pid);
+
+    if (size > 0x7fffffff - sizeof(*hdr)) return NULL;
+    map = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, size + sizeof(*hdr), NULL);
+    if (!map) return NULL;
+    if (!(hdr = MapViewOfFile(map, FILE_MAP_ALL_ACCESS, 0, 0, 0)))
+    {
+        CloseHandle(map);
+        return NULL;
+    }
+    hdr->size = size;
+    hdr->pid = GetCurrentProcessId();
+    if (data) memcpy(hdr + 1, data, size);
+    UnmapViewOfFile(hdr);
+
+    ret = shcore_SHMapHandle(map, GetCurrentProcessId(), dest_pid, FILE_MAP_ALL_ACCESS, DUPLICATE_SAME_ACCESS);
+    CloseHandle(map);
+    return ret;
+}
+
+void * WINAPI shcore_SHLockSharedEx(HANDLE handle, DWORD pid, BOOL writable)
+{
+    HANDLE local;
+    struct shared_header *hdr;
+
+    TRACE("%p, %lu, %d\n", handle, pid, writable);
+
+    if (!(local = shcore_SHMapHandle(handle, pid, GetCurrentProcessId(),
+            writable ? FILE_MAP_ALL_ACCESS : FILE_MAP_READ, 0)))
+        return NULL;
+    hdr = MapViewOfFile(local, writable ? FILE_MAP_ALL_ACCESS : FILE_MAP_READ, 0, 0, 0);
+    CloseHandle(local);
+    return hdr ? hdr + 1 : NULL;
+}
+
+void * WINAPI shcore_SHLockShared(HANDLE handle, DWORD pid)
+{
+    return shcore_SHLockSharedEx(handle, pid, TRUE);
+}
+
+BOOL WINAPI shcore_SHUnlockShared(void *mem)
+{
+    TRACE("%p\n", mem);
+    return mem && UnmapViewOfFile((struct shared_header *)mem - 1);
+}
+
+BOOL WINAPI shcore_SHFreeShared(HANDLE handle, DWORD pid)
+{
+    HANDLE src;
+    BOOL ret;
+
+    TRACE("%p, %lu\n", handle, pid);
+
+    if (!handle) return FALSE;
+    if (!pid || pid == GetCurrentProcessId()) return CloseHandle(handle);
+    if (!(src = open_process(pid, PROCESS_DUP_HANDLE))) return FALSE;
+    ret = DuplicateHandle(src, handle, GetCurrentProcess(), NULL, 0, FALSE, DUPLICATE_CLOSE_SOURCE);
+    CloseHandle(src);
+    return ret;
+}
+
+/* ---- worker windows and subclassing -------------------------------------------------- */
+
+HWND WINAPI shcore_SHCreateWorkerWindowW(WNDPROC proc, HWND parent, DWORD ex_style, DWORD style, HMENU menu,
+        LONG_PTR data)
+{
+    static const WCHAR class_name[] = L"WorkerW";
+    WNDCLASSW wc;
+    HWND hwnd;
+
+    TRACE("%p, %p, %#lx, %#lx, %p, %Id\n", proc, parent, ex_style, style, menu, data);
+
+    if (!GetClassInfoW(GetModuleHandleW(L"shcore.dll"), class_name, &wc))
+    {
+        memset(&wc, 0, sizeof(wc));
+        wc.lpfnWndProc = DefWindowProcW;
+        wc.cbWndExtra = sizeof(void *);
+        wc.hInstance = GetModuleHandleW(L"shcore.dll");
+        wc.hCursor = LoadCursorW(NULL, (const WCHAR *)IDC_ARROW);
+        wc.hbrBackground = (HBRUSH)(COLOR_BTNFACE + 1);
+        wc.lpszClassName = class_name;
+        RegisterClassW(&wc);
+    }
+    hwnd = CreateWindowExW(ex_style, class_name, NULL, style, 0, 0, 0, 0, parent, menu,
+            GetModuleHandleW(L"shcore.dll"), NULL);
+    if (hwnd)
+    {
+        SetWindowLongPtrW(hwnd, 0, data);
+        if (proc) SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)proc);
+    }
+    return hwnd;
+}
+
+static HMODULE comctl32_module(void)
+{
+    return LoadLibraryW(L"comctl32.dll");
+}
+
+BOOL WINAPI shcore_SHSetWindowSubclass(HWND hwnd, SUBCLASSPROC proc, UINT_PTR id, DWORD_PTR data)
+{
+    BOOL (WINAPI *fn)(HWND, SUBCLASSPROC, UINT_PTR, DWORD_PTR);
+    HMODULE m = comctl32_module();
+
+    if (!m || !(fn = (void *)GetProcAddress(m, "SetWindowSubclass"))) return FALSE;
+    return fn(hwnd, proc, id, data);
+}
+
+BOOL WINAPI shcore_SHGetWindowSubclassData(HWND hwnd, SUBCLASSPROC proc, UINT_PTR id, DWORD_PTR *data)
+{
+    BOOL (WINAPI *fn)(HWND, SUBCLASSPROC, UINT_PTR, DWORD_PTR *);
+    HMODULE m = comctl32_module();
+
+    if (!m || !(fn = (void *)GetProcAddress(m, "GetWindowSubclass"))) return FALSE;
+    return fn(hwnd, proc, id, data);
+}
+
+BOOL WINAPI shcore_SHRemoveWindowSubclass(HWND hwnd, SUBCLASSPROC proc, UINT_PTR id)
+{
+    BOOL (WINAPI *fn)(HWND, SUBCLASSPROC, UINT_PTR);
+    HMODULE m = comctl32_module();
+
+    if (!m || !(fn = (void *)GetProcAddress(m, "RemoveWindowSubclass"))) return FALSE;
+    return fn(hwnd, proc, id);
+}
+
+LRESULT WINAPI shcore_SHDefSubclassProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    LRESULT (WINAPI *fn)(HWND, UINT, WPARAM, LPARAM);
+    HMODULE m = comctl32_module();
+
+    if (!m || !(fn = (void *)GetProcAddress(m, "DefSubclassProc"))) return 0;
+    return fn(hwnd, msg, wp, lp);
+}
