From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dinput: implement the IDirectInputJoyConfig8 methods

Cooperative level / acquire state machine (SetCooperativeLevel with DISCL_EXCLUSIVE|DISCL_BACKGROUND must precede Acquire; changes need an acquired interface), OEM joystick types under Joystick\OEM\<type>, per id configuration, user values, OpenTypeKey and OpenAppStatusKey. The registry layout apart from the OEM key is this implementation's own; AddNewHardware has no wizard and ends without installing anything.
---
diff --git a/dlls/dinput/dinput.c b/dlls/dinput/dinput.c
index 2467d51..0b190e0 100644
--- a/dlls/dinput/dinput.c
+++ b/dlls/dinput/dinput.c
@@ -26,6 +26,10 @@
 #define COBJMACROS
 #include "windef.h"
 #include "winbase.h"
+#include "winreg.h"
+#include "winuser.h"
+#include "winerror.h"
+#include "ole2.h"
 
 #include "dinput_private.h"
 #include "device_private.h"
@@ -631,55 +635,297 @@ static ULONG WINAPI joy_config_Release( IDirectInputJoyConfig8 *iface )
     return IDirectInput7_Release( &impl->IDirectInput7W_iface );
 }
 
+/* IDirectInputJoyConfig8.  The state machine and the argument checks follow the interface
+ * documentation: SetCooperativeLevel(DISCL_EXCLUSIVE | DISCL_BACKGROUND) must precede Acquire,
+ * everything that modifies the configuration needs the interface to be acquired.  The registry
+ * layout below is this implementation's own (only the OEM type key location is documented):
+ *
+ *   HKLM\System\CurrentControlSet\Control\MediaProperties\PrivateProperties\Joystick
+ *     OEM\<type>        OEMName, OEMCallout, OEMHardwareID, ConfigCLSID, MapFile (REG_SZ),
+ *                       OEMData (REG_BINARY JOYREGHWSETTINGS), Flags1, Flags2 (REG_DWORD)
+ *     Config\<id>       GuidInstance, GuidGameport (REG_BINARY GUID), HwConfig (REG_BINARY
+ *                       JOYREGHWCONFIG), Gain (REG_DWORD), Type, Callout (REG_SZ)
+ *     UserValues        UserValues (REG_BINARY JOYREGUSERVALUES), GlobalDriver,
+ *                       GameportEmulator (REG_SZ)
+ *   HKCU\...\Joystick\AppStatus   handed out by OpenAppStatusKey
+ */
+#define DITC_REGHWSETTINGS 0x00000001
+#define DITC_CLSIDCONFIG   0x00000002
+#define DITC_DISPLAYNAME   0x00000004
+#define DITC_CALLOUT       0x00000008
+#define DITC_HARDWAREID    0x00000010
+#define DITC_FLAGS1        0x00000020
+#define DITC_FLAGS2        0x00000040
+#define DITC_MAPFILE       0x00000080
+#define DITC_ALL           0x000000ff
+
+#define DIJC_ALL           (DIJC_GUIDINSTANCE | DIJC_REGHWCONFIGTYPE | DIJC_GAIN | DIJC_CALLOUT | DIJC_WDMGAMEPORT)
+
+#define DIJU_USERVALUES      0x00000001
+#define DIJU_GLOBALDRIVER    0x00000002
+#define DIJU_GAMEPORTEMULATOR 0x00000004
+#define DIJU_ALL             0x00000007
+
+#define JOY_CFG_LEVEL_SET 0x1
+#define JOY_CFG_ACQUIRED  0x2
+
+static const WCHAR joy_base_path[] = L"System\\CurrentControlSet\\Control\\MediaProperties\\PrivateProperties\\Joystick";
+
+static HRESULT joy_reg_open( HKEY root, const WCHAR *sub, REGSAM access, BOOL create, HKEY *key )
+{
+    WCHAR path[MAX_PATH];
+    DWORD ret;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s%s%s", joy_base_path, sub ? L"\\" : L"", sub ? sub : L"" );
+    if (create) ret = RegCreateKeyExW( root, path, 0, NULL, 0, access, NULL, key, NULL );
+    else ret = RegOpenKeyExW( root, path, 0, access, key );
+    if (ret == ERROR_FILE_NOT_FOUND || ret == ERROR_PATH_NOT_FOUND) return DIERR_NOTFOUND;
+    if (ret) return HRESULT_FROM_WIN32( ret );
+    return DI_OK;
+}
+
+static void joy_reg_get_string( HKEY key, const WCHAR *name, WCHAR *buffer, DWORD count )
+{
+    DWORD type, size = (count - 1) * sizeof(WCHAR);
+
+    if (RegQueryValueExW( key, name, NULL, &type, (BYTE *)buffer, &size ) || type != REG_SZ) size = 0;
+    buffer[size / sizeof(WCHAR)] = 0;
+    buffer[count - 1] = 0;
+}
+
+static BOOL joy_reg_get_data( HKEY key, const WCHAR *name, DWORD type, void *data, DWORD size )
+{
+    DWORD read_type, read_size = size;
+    return !RegQueryValueExW( key, name, NULL, &read_type, data, &read_size ) && read_type == type && read_size == size;
+}
+
+static void joy_reg_set_string( HKEY key, const WCHAR *name, const WCHAR *value )
+{
+    RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)value, (wcsnlen( value, MAX_JOYSTRING - 1 ) + 1) * sizeof(WCHAR) );
+}
+
+static void joy_reg_set_data( HKEY key, const WCHAR *name, DWORD type, const void *data, DWORD size )
+{
+    RegSetValueExW( key, name, 0, type, data, size );
+}
+
+static BOOL joy_valid_type_name( const WCHAR *name )
+{
+    size_t len;
+    if (!name) return FALSE;
+    len = wcsnlen( name, MAX_JOYSTRING );
+    return len && len < MAX_JOYSTRING && !wcschr( name, '\\' );
+}
+
+static BOOL joy_type_info_valid_size( DWORD size )
+{
+    return size == sizeof(DIJOYTYPEINFO) || size == sizeof(DIJOYTYPEINFO_DX6) || size == sizeof(DIJOYTYPEINFO_DX5);
+}
+
+/* the DITC_* flags a DIJOYTYPEINFO of this size has the members for */
+static DWORD joy_type_info_flags( DWORD size )
+{
+    if (size == sizeof(DIJOYTYPEINFO)) return DITC_ALL;
+    if (size == sizeof(DIJOYTYPEINFO_DX6)) return DITC_ALL & ~(DITC_FLAGS2 | DITC_MAPFILE);
+    return DITC_REGHWSETTINGS | DITC_CLSIDCONFIG | DITC_DISPLAYNAME | DITC_CALLOUT;
+}
+
 static HRESULT WINAPI joy_config_Acquire( IDirectInputJoyConfig8 *iface )
 {
-    FIXME( "iface %p stub!\n", iface );
-    return E_NOTIMPL;
+    struct dinput *impl = impl_from_IDirectInputJoyConfig8( iface );
+
+    TRACE( "iface %p.\n", iface );
