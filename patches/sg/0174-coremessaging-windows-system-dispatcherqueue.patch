+static HRESULT WINAPI queue_statics_GetForCurrentThread( IDispatcherQueueStatics *iface, IDispatcherQueue **result )
+{
+    struct dispatcher_queue *queue;
+
+    TRACE( "iface %p, result %p.\n", iface, result );
+
+    if (!result) return E_POINTER;
+    EnterCriticalSection( &queues_cs );
+    if ((queue = find_current_queue())) IDispatcherQueue_AddRef( &queue->IDispatcherQueue_iface );
+    LeaveCriticalSection( &queues_cs );
+    *result = queue ? &queue->IDispatcherQueue_iface : NULL;
+    return S_OK;
+}
