+/* posts to the queue's window; never to a thread (a NULL window), once the
+ * queue has shut down */
+static BOOL post_to_queue( struct dispatcher_queue *queue, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    BOOL ret = FALSE;
+
+    EnterCriticalSection( &queues_cs );
+    if (queue->hwnd) ret = PostMessageW( queue->hwnd, msg, wparam, lparam );
+    LeaveCriticalSection( &queues_cs );
+    return ret;
