 #include "dispatcherqueue.h"
+
 #include "wine/debug.h"
+#include "wine/list.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(messaging);
 
+#define WM_QUEUE_DISPATCH  (WM_USER + 1)
+#define WM_QUEUE_TIMER     (WM_USER + 2)   /* wparam: 1 start, 0 stop; lparam: the timer */
+#define WM_QUEUE_SHUTDOWN  (WM_USER + 3)   /* lparam: the async action */
