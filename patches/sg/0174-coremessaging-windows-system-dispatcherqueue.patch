+static const WCHAR queue_class[] = L"__wine_dispatcher_queue";
+
+static CRITICAL_SECTION queues_cs;
+static CRITICAL_SECTION_DEBUG queues_cs_debug =
+{
+    0, 0, &queues_cs,
+    { &queues_cs_debug.ProcessLocksList, &queues_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": queues_cs") }
+};
+static CRITICAL_SECTION queues_cs = { &queues_cs_debug, -1, 0, 0, 0, 0 };
+static struct list queues = LIST_INIT( queues );
+static EventRegistrationToken next_token = { 1 };
+
+struct handler_entry
+{
+    struct list entry;
+    EventRegistrationToken token;
+    IUnknown *handler;
+};
+
+static HRESULT add_handler( struct list *list, IUnknown *handler, EventRegistrationToken *token )
+{
+    struct handler_entry *entry;
+
+    if (!handler) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    entry->handler = handler; IUnknown_AddRef( entry->handler );
+    EnterCriticalSection( &queues_cs );
+    entry->token = *token = next_token;
+    next_token.value++;
+    list_add_tail( list, &entry->entry );
+    LeaveCriticalSection( &queues_cs );
+    return S_OK;
+}
+
+static HRESULT remove_handler( struct list *list, EventRegistrationToken token )
+{
+    struct handler_entry *entry, *found = NULL;
+
+    EnterCriticalSection( &queues_cs );
+    LIST_FOR_EACH_ENTRY( entry, list, struct handler_entry, entry )
+        if (entry->token.value == token.value) { found = entry; break; }
+    if (found) list_remove( &found->entry );
+    LeaveCriticalSection( &queues_cs );
+    if (!found) return S_OK;   /* removing an unknown token is not an error */
+    IUnknown_Release( found->handler );
+    free( found );
+    return S_OK;
+}
+
+/* a snapshot of the handlers, so one may unregister itself while it runs */
+static IUnknown **snapshot_handlers( struct list *list, UINT *count )
+{
+    struct handler_entry *entry;
+    IUnknown **ret;
+    UINT i = 0;
+
+    EnterCriticalSection( &queues_cs );
+    *count = list_count( list );
+    if ((ret = calloc( *count + 1, sizeof(*ret) )))
+        LIST_FOR_EACH_ENTRY( entry, list, struct handler_entry, entry )
+            { ret[i] = entry->handler; IUnknown_AddRef( ret[i] ); i++; }
+    else *count = 0;
+    LeaveCriticalSection( &queues_cs );
+    return ret;
+}
+
+static void free_handlers( struct list *list )
+{
+    struct handler_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, list, struct handler_entry, entry )
+    {
+        list_remove( &entry->entry );
+        IUnknown_Release( entry->handler );
+        free( entry );
+    }
+}
