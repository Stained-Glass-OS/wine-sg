+static ULONG WINAPI dispatcher_queue_Release( IDispatcherQueue *iface )
+{
+    struct dispatcher_queue *impl = impl_from_IDispatcherQueue( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    struct queue_item *item, *next;
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        /* the window was destroyed at shutdown, or goes with its thread */
+        LIST_FOR_EACH_ENTRY_SAFE( item, next, &impl->items, struct queue_item, entry )
+        {
+            list_remove( &item->entry );
+            IDispatcherQueueHandler_Release( item->handler );
+            free( item );
+        }
+        free_handlers( &impl->shutdown_starting );
+        free_handlers( &impl->shutdown_completed );
+        free( impl );
+    }
+    return ref;
+}
