+struct dedicated_params
+{
+    DISPATCHERQUEUE_THREAD_APARTMENTTYPE apartment;
+    HANDLE ready;
+    HRESULT hr;
+    struct dispatcher_queue *queue;
+};
+
+static DWORD WINAPI dedicated_thread( void *arg )
+{
+    struct dedicated_params *params = arg;
+    struct dispatcher_queue *queue;
+    BOOL com = FALSE;
+    MSG msg;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_dispatcher_queue" );
+    if (params->apartment == DQTAT_COM_ASTA || params->apartment == DQTAT_COM_STA)
+        com = SUCCEEDED( CoInitializeEx( NULL, COINIT_APARTMENTTHREADED ) );
+
+    if (SUCCEEDED(params->hr = create_queue_for_current_thread( TRUE, &queue )))
+        params->queue = queue;
+    SetEvent( params->ready );   /* params is gone after this */
+    if (FAILED(params->hr))
+    {
+        if (com) CoUninitialize();
+        return 0;
+    }
+
+    while (GetMessageW( &msg, NULL, 0, 0 ) > 0)
+    {
+        TranslateMessage( &msg );
+        DispatchMessageW( &msg );
+    }
+    SetWindowLongPtrW( queue->hwnd, GWLP_USERDATA, 0 );
+    DestroyWindow( queue->hwnd );
+    IDispatcherQueue_Release( &queue->IDispatcherQueue_iface );
+    if (com) CoUninitialize();
+    return 0;
+}
+
+static HRESULT create_controller( DISPATCHERQUEUE_THREAD_TYPE type, DISPATCHERQUEUE_THREAD_APARTMENTTYPE apartment,
+                                  IDispatcherQueueController **out )
+{
+    struct dispatcher_queue_controller *impl;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IDispatcherQueueController_iface.lpVtbl = &controller_vtbl;
+    impl->ref = 1;
+
+    if (type == DQTYPE_THREAD_DEDICATED)
+    {
+        struct dedicated_params params = { apartment };
+
+        params.ready = CreateEventW( NULL, TRUE, FALSE, NULL );
+        if (!(impl->thread = CreateThread( NULL, 0, dedicated_thread, &params, 0, NULL )))
+        {
+            CloseHandle( params.ready );
+            free( impl );
+            return HRESULT_FROM_WIN32( GetLastError() );
+        }
+        WaitForSingleObject( params.ready, INFINITE );
+        CloseHandle( params.ready );
+        if (FAILED(hr = params.hr))
+        {
+            WaitForSingleObject( impl->thread, INFINITE );
+            CloseHandle( impl->thread );
+            free( impl );
+            return hr;
+        }
+        impl->queue = params.queue;
+    }
+    else if (FAILED(hr = create_queue_for_current_thread( FALSE, &impl->queue )))
+    {
+        free( impl );
+        return hr;
+    }
+    *out = &impl->IDispatcherQueueController_iface;
+    return S_OK;
+}
+
 HRESULT WINAPI CreateDispatcherQueueController( DispatcherQueueOptions options, PDISPATCHERQUEUECONTROLLER *queue_controller )
 {
-    FIXME( "options.dwSize = %lu, options.threadType = %d, options.apartmentType = %d, queue_controller %p stub!\n",
-            options.dwSize, options.threadType, options.apartmentType, queue_controller );
+    TRACE( "options.dwSize = %lu, options.threadType = %d, options.apartmentType = %d, queue_controller %p.\n",
+           options.dwSize, options.threadType, options.apartmentType, queue_controller );
+
+    if (!queue_controller) return E_POINTER;
+    *queue_controller = NULL;
+    if (options.dwSize != sizeof(options)) return E_INVALIDARG;
+    if (options.threadType != DQTYPE_THREAD_DEDICATED && options.threadType != DQTYPE_THREAD_CURRENT)
+        return E_INVALIDARG;
+    if (options.apartmentType > DQTAT_COM_STA) return E_INVALIDARG;
+    return create_controller( options.threadType, options.apartmentType, queue_controller );
+}
