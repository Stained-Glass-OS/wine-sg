+/* the queue's window: everything runs here, on the queue's thread */
+
+static void run_one_item( struct dispatcher_queue *queue )
+{
+    struct queue_item *item = NULL;
+    struct list *head;
+    HRESULT hr;
+
+    EnterCriticalSection( &queues_cs );
+    if ((head = list_head( &queue->items )))
+    {
+        item = LIST_ENTRY( head, struct queue_item, entry );
+        list_remove( &item->entry );
+    }
+    LeaveCriticalSection( &queues_cs );
+    if (!item) return;
+
+    if (FAILED(hr = IDispatcherQueueHandler_Invoke( item->handler )))
+        WARN( "handler %p failed, hr %#lx.\n", item->handler, hr );
+    IDispatcherQueueHandler_Release( item->handler );
+    free( item );
+}
+
+static void set_timer( struct dispatcher_queue *queue, struct dispatcher_queue_timer *timer, BOOL start )
+{
+    UINT ms;
+
+    if (start && timer->running)
+    {
+        ms = timer->interval.Duration / 10000;
+        if (!ms) ms = USER_TIMER_MINIMUM;
+        if (list_empty( &timer->entry ))
+        {
+            list_add_tail( &queue->timers, &timer->entry );
+            IDispatcherQueueTimer_AddRef( &timer->IDispatcherQueueTimer_iface );
+        }
+        SetTimer( queue->hwnd, (UINT_PTR)timer, ms, NULL );
+    }
+    else if (!timer->running && !list_empty( &timer->entry ))
+    {
+        KillTimer( queue->hwnd, (UINT_PTR)timer );
+        list_remove( &timer->entry );
+        list_init( &timer->entry );
+        IDispatcherQueueTimer_Release( &timer->IDispatcherQueueTimer_iface );
+    }
+}
+
+static void fire_timer( struct dispatcher_queue *queue, UINT_PTR id )
+{
+    struct dispatcher_queue_timer *timer = NULL, *cur;
+    IUnknown **handlers;
+    UINT i, count;
+
+    LIST_FOR_EACH_ENTRY( cur, &queue->timers, struct dispatcher_queue_timer, entry )
+        if ((UINT_PTR)cur == id) { timer = cur; break; }
+    if (!timer)
+    {
+        KillTimer( queue->hwnd, id );
+        return;
+    }
+
+    IDispatcherQueueTimer_AddRef( &timer->IDispatcherQueueTimer_iface );
+    if (!timer->repeating)
+    {
+        timer->running = FALSE;
+        set_timer( queue, timer, FALSE );
+    }
+    if ((handlers = snapshot_handlers( &timer->tick, &count )))
+    {
+        for (i = 0; i < count; i++)
+        {
+            ITypedEventHandler_DispatcherQueueTimer_IInspectable_Invoke( (ITypedEventHandler_DispatcherQueueTimer_IInspectable *)handlers[i],
+                                                                        &timer->IDispatcherQueueTimer_iface, NULL );
+            IUnknown_Release( handlers[i] );
+        }
+        free( handlers );
+    }
+    IDispatcherQueueTimer_Release( &timer->IDispatcherQueueTimer_iface );
+}
+
+static void shutdown_queue( struct dispatcher_queue *queue, struct async_action *action )
+{
+    struct dispatcher_queue_timer *timer, *next;
+    struct shutdown_args *args;
+    IUnknown **handlers;
+    UINT i, count;
+
+    /* ShutdownStarting: work may still be queued from its handlers */
+    if ((args = calloc( 1, sizeof(*args) )))
+    {
+        args->IDispatcherQueueShutdownStartingEventArgs_iface.lpVtbl = &shutdown_args_vtbl;
+        args->ref = 1;
+        if ((handlers = snapshot_handlers( &queue->shutdown_starting, &count )))
+        {
+            for (i = 0; i < count; i++)
+            {
+                ITypedEventHandler_DispatcherQueue_DispatcherQueueShutdownStartingEventArgs_Invoke(
+                        (ITypedEventHandler_DispatcherQueue_DispatcherQueueShutdownStartingEventArgs *)handlers[i],
+                        &queue->IDispatcherQueue_iface, &args->IDispatcherQueueShutdownStartingEventArgs_iface );
+                IUnknown_Release( handlers[i] );
+            }
+            free( handlers );
+        }
+        IDispatcherQueueShutdownStartingEventArgs_Release( &args->IDispatcherQueueShutdownStartingEventArgs_iface );
+    }
+
+    /* then no more; what is queued still runs */
+    EnterCriticalSection( &queues_cs );
+    queue->shutting_down = TRUE;
+    LeaveCriticalSection( &queues_cs );
+    while (!list_empty( &queue->items )) run_one_item( queue );
+
+    LIST_FOR_EACH_ENTRY_SAFE( timer, next, &queue->timers, struct dispatcher_queue_timer, entry )
+    {
+        timer->running = FALSE;
+        set_timer( queue, timer, FALSE );
+    }
+
+    if ((handlers = snapshot_handlers( &queue->shutdown_completed, &count )))
+    {
+        for (i = 0; i < count; i++)
+        {
+            ITypedEventHandler_DispatcherQueue_IInspectable_Invoke( (ITypedEventHandler_DispatcherQueue_IInspectable *)handlers[i],
+                                                                   &queue->IDispatcherQueue_iface, NULL );
+            IUnknown_Release( handlers[i] );
+        }
+        free( handlers );
+    }
+
+    EnterCriticalSection( &queues_cs );
+    list_remove( &queue->entry );
+    list_init( &queue->entry );
+    LeaveCriticalSection( &queues_cs );
+
+    if (action)
+    {
+        complete_async_action( action );
+        IAsyncAction_Release( &action->IAsyncAction_iface );
+    }
+    /* a dedicated thread ends, and lets its queue go; the calling thread's
+     * queue lets its window go here */
+    if (queue->dedicated) PostQuitMessage( 0 );
+    else
+    {
+        HWND hwnd = queue->hwnd;
+        SetWindowLongPtrW( hwnd, GWLP_USERDATA, 0 );
+        EnterCriticalSection( &queues_cs );
+        queue->hwnd = NULL;
+        LeaveCriticalSection( &queues_cs );
+        DestroyWindow( hwnd );
+        IDispatcherQueue_Release( &queue->IDispatcherQueue_iface );
+    }
+}
+
+static LRESULT CALLBACK queue_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    struct dispatcher_queue *queue = (struct dispatcher_queue *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+
+    switch (msg)
+    {
+    case WM_QUEUE_DISPATCH:
+        if (queue) run_one_item( queue );
+        return 0;
+    case WM_QUEUE_TIMER:
+    {
+        struct dispatcher_queue_timer *timer = (struct dispatcher_queue_timer *)lparam;
+        if (queue)
+        {
+            if (wparam == 2 && timer->running) set_timer( queue, timer, TRUE );
+            else if (wparam != 2) set_timer( queue, timer, wparam == 1 );
+        }
+        if (wparam != 2) IDispatcherQueueTimer_Release( &timer->IDispatcherQueueTimer_iface );
+        return 0;
+    }
+    case WM_TIMER:
+        if (queue) fire_timer( queue, wparam );
+        return 0;
+    case WM_QUEUE_SHUTDOWN:
+        if (queue) shutdown_queue( queue, (struct async_action *)lparam );
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static BOOL WINAPI register_queue_class( INIT_ONCE *once, void *param, void **context )
+{
+    WNDCLASSW class = { 0 };
+
+    class.lpfnWndProc = queue_wndproc;
+    class.hInstance = GetModuleHandleW( L"coremessaging.dll" );
+    class.lpszClassName = queue_class;
+    RegisterClassW( &class );
+    return TRUE;
+}
+
+static struct dispatcher_queue *find_current_queue(void)
+{
+    struct dispatcher_queue *queue;
+    DWORD tid = GetCurrentThreadId();
+
+    LIST_FOR_EACH_ENTRY( queue, &queues, struct dispatcher_queue, entry )
+        if (queue->thread_id == tid) return queue;
+    return NULL;
+}
+
+/* a queue for the calling thread, which runs it */
+static HRESULT create_queue_for_current_thread( BOOL dedicated, struct dispatcher_queue **out )
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    struct dispatcher_queue *queue;
+
+    *out = NULL;
+    EnterCriticalSection( &queues_cs );
+    queue = find_current_queue();
+    LeaveCriticalSection( &queues_cs );
+    if (queue) return RPC_E_WRONG_THREAD;   /* one per thread */
+
+    InitOnceExecuteOnce( &once, register_queue_class, NULL, NULL );
+    if (!(queue = calloc( 1, sizeof(*queue) ))) return E_OUTOFMEMORY;
+    queue->IDispatcherQueue_iface.lpVtbl = &dispatcher_queue_vtbl;
+    queue->IDispatcherQueue2_iface.lpVtbl = &dispatcher_queue2_vtbl;
+    queue->ref = 2;   /* the caller's, and its thread's until shutdown */
+    queue->thread_id = GetCurrentThreadId();
+    queue->dedicated = dedicated;
+    list_init( &queue->items );
+    list_init( &queue->shutdown_starting );
+    list_init( &queue->shutdown_completed );
+    list_init( &queue->timers );
+    if (!(queue->hwnd = CreateWindowExW( 0, queue_class, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL,
+                                         GetModuleHandleW( L"coremessaging.dll" ), NULL )))
+    {
+        free( queue );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    SetWindowLongPtrW( queue->hwnd, GWLP_USERDATA, (LONG_PTR)queue );
+
+    EnterCriticalSection( &queues_cs );
+    list_add_tail( &queues, &queue->entry );
+    LeaveCriticalSection( &queues_cs );
+    *out = queue;
+    return S_OK;
+}
