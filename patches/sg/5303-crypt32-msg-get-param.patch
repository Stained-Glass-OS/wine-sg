From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: more CryptMsgGetParam parameters for decoded messages

crypt32: CryptMsgGetParam on a decoded message answers three more of the
parameters the documentation lists: CMSG_SIGNER_HASH_ALGORITHM_PARAM for a
signed message (per signer, CRYPT_E_INVALID_INDEX past the last one) and
CMSG_ENVELOPE_ALGORITHM_PARAM and CMSG_CMS_RECIPIENT_COUNT_PARAM for an
enveloped message. The algorithm is a CRYPT_ALGORITHM_IDENTIFIER followed by
its object identifier and parameters, as for the hash message.
---
--- a/dlls/crypt32/msg.c
+++ b/dlls/crypt32/msg.c
@@ -2972,6 +2972,35 @@ static BOOL CRYPT_CopyRecipientInfo(void *pvData, DWORD *pcbData,
     return ret;
 }
 
+/* A CRYPT_ALGORITHM_IDENTIFIER followed by its object identifier and parameters, as
+ * CryptMsgGetParam returns them for the hash and encryption algorithm parameters */
+static BOOL CRYPT_CopyAlgorithmParam(void *pvData, DWORD *pcbData, const CRYPT_ALGORITHM_IDENTIFIER *alg)
+{
+    DWORD size = sizeof(CRYPT_ALGORITHM_IDENTIFIER);
+    BOOL ret = TRUE;
+
+    if (alg->pszObjId) size += strlen(alg->pszObjId) + 1;
+    size += alg->Parameters.cbData;
+    if (!pvData)
+        *pcbData = size;
+    else if (*pcbData < size)
+    {
+        *pcbData = size;
+        SetLastError(ERROR_MORE_DATA);
+        ret = FALSE;
+    }
+    else
+    {
+        CRYPT_ALGORITHM_IDENTIFIER *out = pvData;
+        LPBYTE nextData = (BYTE *)pvData + sizeof(CRYPT_ALGORITHM_IDENTIFIER);
+
+        memset(out, 0, sizeof(*out));
+        CRYPT_CopyAlgorithmId(out, alg, &nextData);
+        *pcbData = size;
+    }
+    return ret;
+}
+
 static BOOL CDecodeEnvelopedMsg_GetParam(CDecodeMsg *msg, DWORD dwParamType,
  DWORD dwIndex, void *pvData, DWORD *pcbData)
 {
@@ -3007,6 +3036,23 @@ static BOOL CDecodeEnvelopedMsg_GetParam(CDecodeMsg *msg, DWORD dwParamType,
         else
             SetLastError(CRYPT_E_INVALID_MSG_TYPE);
         break;
+    case CMSG_ENVELOPE_ALGORITHM_PARAM:
+#ifndef SG_MUTANT_MSGPARAM
+        if (msg->u.enveloped_data.data)
+            ret = CRYPT_CopyAlgorithmParam(pvData, pcbData,
+             &msg->u.enveloped_data.data->encryptedContentInfo.contentEncryptionAlgorithm);
+        else
+            SetLastError(CRYPT_E_INVALID_MSG_TYPE);
+        break;
+#endif
+    case CMSG_CMS_RECIPIENT_COUNT_PARAM:
+        /* only key transport recipients are read, so this is the same count as CMSG_RECIPIENT_COUNT_PARAM */
+        if (msg->u.enveloped_data.data)
+            ret = CRYPT_CopyParam(pvData, pcbData,
+             &msg->u.enveloped_data.data->cRecipientInfo, sizeof(DWORD));
+        else
+            SetLastError(CRYPT_E_INVALID_MSG_TYPE);
+        break;
     case CMSG_RECIPIENT_INFO_PARAM:
         if (msg->u.enveloped_data.data)
         {
@@ -3224,6 +3270,20 @@ static BOOL CDecodeSignedMsg_GetParam(CDecodeMsg *msg, DWORD dwParamType,
         else
             SetLastError(CRYPT_E_INVALID_MSG_TYPE);
         break;
+#ifndef SG_MUTANT_MSGPARAM2
+    case CMSG_SIGNER_HASH_ALGORITHM_PARAM:
+        if (msg->u.signed_data.info)
+        {
+            if (dwIndex >= msg->u.signed_data.info->cSignerInfo)
+                SetLastError(CRYPT_E_INVALID_INDEX);
+            else
+                ret = CRYPT_CopyAlgorithmParam(pvData, pcbData,
+                 &msg->u.signed_data.info->rgSignerInfo[dwIndex].HashAlgorithm);
+        }
+        else
+            SetLastError(CRYPT_E_INVALID_MSG_TYPE);
+        break;
+#endif
     case CMSG_CMS_SIGNER_INFO_PARAM:
         if (msg->u.signed_data.info)
         {
--- a/dlls/crypt32/tests/msg.c
+++ b/dlls/crypt32/tests/msg.c
@@ -2787,6 +2787,20 @@ static void test_decode_msg_get_param(void)
     ret = CryptMsgGetParam(msg, CMSG_SIGNER_COUNT_PARAM, 0, &value, &size);
     ok(ret, "CryptMsgGetParam failed: %08lx\n", GetLastError());
     ok(value == 1, "Expected 1 signer, got %ld\n", value);
+    {
+        CRYPT_ALGORITHM_IDENTIFIER *alg;
+        BYTE alg_buffer[128];
+        DWORD alg_size = sizeof(alg_buffer);
+
+        ret = CryptMsgGetParam(msg, CMSG_SIGNER_HASH_ALGORITHM_PARAM, 0, alg_buffer, &alg_size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        alg = (CRYPT_ALGORITHM_IDENTIFIER *)alg_buffer;
+        ok(alg_size > sizeof(*alg), "got size %lu.\n", alg_size);
+        ok(!strcmp(alg->pszObjId, szOID_RSA_MD5), "got %s.\n", alg->pszObjId);
+        SetLastError(0xdeadbeef);
+        ret = CryptMsgGetParam(msg, CMSG_SIGNER_HASH_ALGORITHM_PARAM, 1, alg_buffer, &alg_size);
+        ok(!ret && GetLastError() == CRYPT_E_INVALID_INDEX, "got ret %d, error %#lx.\n", ret, GetLastError());
+    }
     size = 0;
     ret = CryptMsgGetParam(msg, CMSG_SIGNER_INFO_PARAM, 0, NULL, &size);
     ok(ret, "CryptMsgGetParam failed: %08lx\n", GetLastError());
@@ -2975,6 +2989,27 @@ static void test_decode_msg_get_param(void)
     value = 3;
     check_param("recipient count", msg, CMSG_RECIPIENT_COUNT_PARAM,
      (const BYTE *)&value, sizeof(value));
+    check_param("CMS recipient count", msg, CMSG_CMS_RECIPIENT_COUNT_PARAM,
+     (const BYTE *)&value, sizeof(value));
+    {
+        CRYPT_ALGORITHM_IDENTIFIER *alg;
+        BYTE buffer[128];
+        DWORD alg_size = 0;
+
+        ret = CryptMsgGetParam(msg, CMSG_ENVELOPE_ALGORITHM_PARAM, 0, NULL, &alg_size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ok(alg_size > sizeof(*alg) && alg_size <= sizeof(buffer), "got size %lu.\n", alg_size);
+        ret = CryptMsgGetParam(msg, CMSG_ENVELOPE_ALGORITHM_PARAM, 0, buffer, &alg_size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        alg = (CRYPT_ALGORITHM_IDENTIFIER *)buffer;
+        ok(!strcmp(alg->pszObjId, "1.2.840.113549.3.4"), "got %s.\n", alg->pszObjId);
+        ok(alg->Parameters.cbData == 2 && alg->Parameters.pbData[0] == 5 && !alg->Parameters.pbData[1],
+                "got %lu bytes.\n", alg->Parameters.cbData);
+        alg_size = sizeof(*alg);
+        SetLastError(0xdeadbeef);
+        ret = CryptMsgGetParam(msg, CMSG_ENVELOPE_ALGORITHM_PARAM, 0, buffer, &alg_size);
+        ok(!ret && GetLastError() == ERROR_MORE_DATA, "got ret %d, error %#lx.\n", ret, GetLastError());
+    }
     size = 0;
     SetLastError(0xdeadbeef);
     ret = CryptMsgGetParam(msg, CMSG_RECIPIENT_INFO_PARAM, 3, NULL, &size);
