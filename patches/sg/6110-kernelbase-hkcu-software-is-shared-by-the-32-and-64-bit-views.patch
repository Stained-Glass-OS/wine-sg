From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: HKCU\Software is one key for KEY_WOW64_32KEY

Windows shares HKCU\Software between the 32- and 64-bit views. A 64-bit program opening keys with KEY_WOW64_32KEY stepped into HKCU\Software\Wow6432Node once one existed: Edge WebView2's user-level setup wrote its EdgeUpdate\Clients key there and the 32-bit updater found none (0x80040905).
---
diff --git a/dlls/kernelbase/registry.c b/dlls/kernelbase/registry.c
index 7017c3c..a5f6235 100644
--- a/dlls/kernelbase/registry.c
+++ b/dlls/kernelbase/registry.c
@@ -152,6 +152,32 @@ static BOOL is_classes_wow6432node( HKEY key )
     return ret;
 }
 
+/* Stained Glass OS: whether KEY is a user's HKCU\Software (\REGISTRY\USER\<SID>\Software).
+ * Windows shares it between the 32- and 64-bit views (since Windows 7; only
+ * Software\Classes below it is redirected): a Wow6432Node key in it is an
+ * ordinary key. A 64-bit program opening a key with KEY_WOW64_32KEY went into
+ * HKCU\Software\Wow6432Node as soon as one existed -- Chromium's setup (Edge
+ * WebView2's, user level) wrote its EdgeUpdate\Clients keys there, and the
+ * 32-bit updater, which sees the shared key, said the installer made none
+ * (0x80040905). The server does the same for 32-bit programs (5949). */
+static BOOL is_user_software( HANDLE key )
+{
+    static const WCHAR userW[] = L"\\REGISTRY\\USER\\";
+    char buffer[512];
+    KEY_NAME_INFORMATION *info = (KEY_NAME_INFORMATION *)buffer;
+    DWORD len, i, n, prefix = ARRAY_SIZE(userW) - 1;
+
+#ifdef SG_MUTANT_HKCU_WOW32KEY
+    return FALSE;
+#endif
+    if (NtQueryKey( key, KeyNameInformation, info, sizeof(buffer) - sizeof(WCHAR), &len )) return FALSE;
+    n = info->NameLength / sizeof(WCHAR);
+    if (n <= prefix + 9 || wcsnicmp( info->Name, userW, prefix )) return FALSE;
+    if (wcsnicmp( info->Name + n - 9, L"\\Software", 9 )) return FALSE;
+    for (i = prefix; i < n - 9; i++) if (info->Name[i] == '\\') return FALSE;  /* one name: the SID */
+    return i > prefix;
+}
+
 /* Open the Wow6432Node subkey of the specified key */
 static HANDLE open_wow6432node( HANDLE key )
 {
@@ -256,7 +282,7 @@ static NTSTATUS open_subkey( HKEY *subkey, HKEY root, UNICODE_STRING *name, DWOR
         name->Buffer += i;
         name->Length -= i * sizeof(WCHAR);
 
-        if (is_wow64_key && !is_wow6432node( name ))
+        if (is_wow64_key && !is_wow6432node( name ) && !is_user_software( *subkey ))
         {
             HKEY wow6432node = open_wow6432node( *subkey );
             if (wow6432node != *subkey)
