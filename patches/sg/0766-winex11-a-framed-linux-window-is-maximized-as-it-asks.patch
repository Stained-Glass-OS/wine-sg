From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a framed Linux window is maximized as it asks

Linux Firefox, restored at the size it had maximized (1280 wide), was
framed at that size plus the frame -- wider than the screen, at y 16 and
running under the taskbar -- and its frame's Maximize was not what Firefox
knew of itself. As a window manager does:

- a program's _NET_WM_STATE request to be maximized or restored (heard by
  the thread 0764 started for full screen) maximizes or restores its frame;
- the frame maximized or restored (its buttons, snap) is told to the
  program in _NET_WM_STATE;
- a window that was maximized before it was framed, or whose frame does not
  fit in the work area, is framed maximized.

The embedding's slots are cleared when reused: the full-screen state of a
window framed before carried over to the next.

Test: test/linuxembed-gate.sh (asked to maximize and restore, the frame's
state told, maximized before framed, bigger than the work area; mutants
EMBED_NO_MAXIMIZE, EMBED_MAX_UNTOLD). VM-checked with Firefox.
---
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -76,6 +76,7 @@
     Window   child;     /* the program's window */
     int      x, y, w, h; /* where we put it in the frame */
     BOOL     fullscreen;  /* the program asked for the whole screen */
+    BOOL     maximized;   /* the frame is maximized (as the program knows it) */
     LONG     style;       /* ...and the frame's style and place before */
     RECT     rect;
 };
@@ -87,6 +88,42 @@
     return atom;
 }
 
+static Atom maximized_atom( Display *display )
+{
+    static Atom atom;
+    if (!atom) atom = XInternAtom( display, "_SG_EMBED_MAXIMIZED", False );
+    return atom;
+}
+
+/* _NET_WM_STATE as a window manager keeps it: full screen, maximized */
+static void set_net_state( Display *d, Window w, BOOL fullscreen, BOOL maximized )
+{
+    Atom atoms[3];
+    int n = 0;
+    if (fullscreen) atoms[n++] = XInternAtom( d, "_NET_WM_STATE_FULLSCREEN", False );
+    if (maximized)
+    {
+        atoms[n++] = XInternAtom( d, "_NET_WM_STATE_MAXIMIZED_VERT", False );
+        atoms[n++] = XInternAtom( d, "_NET_WM_STATE_MAXIMIZED_HORZ", False );
+    }
+    XChangeProperty( d, w, XInternAtom( d, "_NET_WM_STATE", False ), XA_ATOM, 32, PropModeReplace,
+                     (unsigned char *)atoms, n );
+}
+
+static long get_cardinal( Display *d, Window w, Atom prop_atom )
+{
+    Atom type;
+    int format;
+    unsigned long count, remaining;
+    unsigned char *prop = NULL;
+    long ret = 0;
+    if (!XGetWindowProperty( d, w, prop_atom, 0, 1, False, XA_CARDINAL, &type, &format, &count, &remaining, &prop ) &&
+        prop && count)
+        ret = *(long *)prop;
+    if (prop) XFree( prop );
+    return ret;
+}
+
 static struct sg_embed embeds[MAX_EMBEDS];
 static int embed_count;
 static pthread_mutex_t embed_mutex = PTHREAD_MUTEX_INITIALIZER;
@@ -216,7 +253,9 @@
     Window root = DefaultRootWindow( d );
     Atom wm_state = XInternAtom( d, "_NET_WM_STATE", False );
     Atom fs = XInternAtom( d, "_NET_WM_STATE_FULLSCREEN", False );
-    Atom ours = XInternAtom( d, "_SG_EMBED_FULLSCREEN", False );
+    Atom max_v = XInternAtom( d, "_NET_WM_STATE_MAXIMIZED_VERT", False );
+    Atom max_h = XInternAtom( d, "_NET_WM_STATE_MAXIMIZED_HORZ", False );
+    Atom ours_fs = fullscreen_atom( d ), ours_max = maximized_atom( d );
     XEvent ev;
 
     XSelectInput( d, root, SubstructureNotifyMask );
@@ -224,27 +263,28 @@
     {
         Window r, parent, *children = NULL;
         unsigned int n;
-        Atom type;
-        int format;
-        unsigned long count, remaining;
-        unsigned char *prop = NULL;
-        long on, now = 0;
+        Atom a1, a2, ours;
+        long on, now;
 
         XNextEvent( d, &ev );
         if (ev.type != ClientMessage || ev.xclient.message_type != wm_state || ev.xclient.format != 32) continue;
-        if ((Atom)ev.xclient.data.l[1] != fs && (Atom)ev.xclient.data.l[2] != fs) continue;
+        a1 = ev.xclient.data.l[1];
+        a2 = ev.xclient.data.l[2];
+        if (a1 == fs || a2 == fs) ours = ours_fs;
+#ifndef SG_MUTANT_EMBED_NO_MAXIMIZE
+        /* maximized: Firefox restores itself so, asking at once */
+        else if (a1 == max_v || a1 == max_h || a2 == max_v || a2 == max_h) ours = ours_max;
+#endif
+        else continue;
         /* only a window we framed: its parent is not the root */
         if (!XQueryTree( d, ev.xclient.window, &r, &parent, &children, &n )) continue;
         if (children) XFree( children );
         if (parent == root) continue;
-        if (!XGetWindowProperty( d, ev.xclient.window, ours, 0, 1, False, XA_CARDINAL, &type, &format, &count,
-                                 &remaining, &prop ) && prop && count)
-            now = *(long *)prop;
-        if (prop) XFree( prop );
+        now = get_cardinal( d, ev.xclient.window, ours );
         on = ev.xclient.data.l[0] == 2 ? !now : ev.xclient.data.l[0] == 1;   /* toggle, add, remove */
         XChangeProperty( d, ev.xclient.window, ours, XA_CARDINAL, 32, PropModeReplace, (unsigned char *)&on, 1 );
-        if (on) XChangeProperty( d, ev.xclient.window, wm_state, XA_ATOM, 32, PropModeReplace, (unsigned char *)&fs, 1 );
-        else XChangeProperty( d, ev.xclient.window, wm_state, XA_ATOM, 32, PropModeReplace, NULL, 0 );
+        set_net_state( d, ev.xclient.window, get_cardinal( d, ev.xclient.window, ours_fs ),
+                       get_cardinal( d, ev.xclient.window, ours_max ) );
         XFlush( d );
     }
     return NULL;
@@ -294,6 +334,7 @@
         return 0;
     }
     e = &embeds[embed_count++];
+    memset( e, 0, sizeof(*e) );   /* not the full screen or maximized of the window here before */
     e->hwnd = hwnd;
     e->display = data->display;
     e->frame = data->whole_window;
@@ -339,6 +380,32 @@
 #ifndef SG_MUTANT_EMBED_NO_FULLSCREEN
     start_state_thread( data->display );
 #endif
+#ifndef SG_MUTANT_EMBED_NO_MAXIMIZE
+    {
+        /* maximized already -- asked before it was framed, of the
+         * compositor's window manager: its frame is */
+        Atom type, *atoms = NULL;
+        int format;
+        unsigned long count = 0, remaining, i;
+        int max = 0;
+        X11DRV_expect_error( data->display, ignore_error, NULL );
+        if (!XGetWindowProperty( data->display, child, XInternAtom( data->display, "_NET_WM_STATE", False ), 0, 32,
+                                 False, XA_ATOM, &type, &format, &count, &remaining, (unsigned char **)&atoms ) && atoms)
+        {
+            for (i = 0; i < count; i++)
+                if (atoms[i] == XInternAtom( data->display, "_NET_WM_STATE_MAXIMIZED_VERT", False ) ||
+                    atoms[i] == XInternAtom( data->display, "_NET_WM_STATE_MAXIMIZED_HORZ", False )) max++;
+            XFree( atoms );
+        }
+        if (max == 2)
+        {
+            long on = 1;
+            XChangeProperty( data->display, child, maximized_atom( data->display ), XA_CARDINAL, 32,
+                             PropModeReplace, (unsigned char *)&on, 1 );
+        }
+        X11DRV_check_error();
+    }
+#endif
     XFlush( data->display );
     TRACE( "%p: %lx embedded in %lx at %d,%d %dx%d\n", hwnd, child, data->whole_window, x, y, w, h );
     release_win_data( data );
@@ -351,13 +418,26 @@
  * The frame moved or was sized (X11DRV_WindowPosChanged): the program's
  * window fills its client area.
  */
-void sg_embed_layout( struct x11drv_win_data *data )
+void sg_embed_layout( struct x11drv_win_data *data, UINT style )
 {
     struct sg_embed *e;
     int x, y, w, h;
 
     if (!embed_count || !client_in_frame( data, &x, &y, &w, &h )) return;
     pthread_mutex_lock( &embed_mutex );
+#ifndef SG_MUTANT_EMBED_MAX_UNTOLD
+    if ((e = find_hwnd( data->hwnd )) && !e->fullscreen && e->maximized != !!(style & WS_MAXIMIZE))
+    {
+        /* maximized or restored (its buttons, Aero snap): the program is told,
+         * as a window manager tells it, and draws itself so */
+        long on = e->maximized = !!(style & WS_MAXIMIZE);
+        X11DRV_expect_error( e->display, ignore_error, NULL );
+        XChangeProperty( e->display, e->child, maximized_atom( e->display ), XA_CARDINAL, 32,
+                         PropModeReplace, (unsigned char *)&on, 1 );
+        set_net_state( e->display, e->child, FALSE, on );
+        X11DRV_check_error();
+    }
+#endif
     if ((e = find_hwnd( data->hwnd )) && (e->x != x || e->y != y || e->w != w || e->h != h))
     {
         e->x = x; e->y = y; e->w = w; e->h = h;
@@ -528,11 +608,41 @@
     case WM_X11DRV_SG_EMBED_ATTACH:
     {
         LRESULT ret = sg_embed_attach( hwnd, (Window)wp );
+        XWindowAttributes attr;
+        Display *d = NULL;
+        BOOL big = FALSE;
         if (ret && (data = get_win_data( hwnd )))
         {
-            set_title( hwnd, data->display, (Window)wp );
+            d = data->display;
+            set_title( hwnd, d, (Window)wp );
+            X11DRV_expect_error( d, ignore_error, NULL );
+            big = XGetWindowAttributes( d, (Window)wp, &attr );
+            if (X11DRV_check_error()) big = FALSE;
             release_win_data( data );
         }
+#ifndef SG_MUTANT_EMBED_NO_MAXIMIZE
+        if (big)
+        {
+            /* its frame does not fit in the work area: it was as wide or as
+             * tall as the screen -- Firefox, restored at its size from when
+             * it was maximized (its request to be maximized went before it
+             * was framed), ran under the taskbar. Its frame is maximized. */
+            MONITORINFO mi = { sizeof(mi) };
+            RECT wr;
+            NtUserGetMonitorInfo( NtUserMonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST ), &mi );
+            NtUserGetWindowRect( hwnd, &wr, NtUserGetDpiForWindow( hwnd ) );
+            big = wr.right - wr.left > mi.rcWork.right - mi.rcWork.left || wr.bottom - wr.top > mi.rcWork.bottom - mi.rcWork.top;
+            if (big)
+            {
+                long on = 1;
+                X11DRV_expect_error( d, ignore_error, NULL );
+                XChangeProperty( d, (Window)wp, maximized_atom( d ), XA_CARDINAL, 32, PropModeReplace,
+                                 (unsigned char *)&on, 1 );
+                XFlush( d );
+                X11DRV_check_error();
+            }
+        }
+#endif
         return ret;
     }
     }
@@ -621,6 +731,16 @@
         }
         return 0;
     }
+    case WM_X11DRV_SG_EMBED_MAXIMIZE:
+    {
+        /* the program asked to be maximized or restored: its frame is */
+        BOOL on, zoomed = !!(NtUserGetWindowLongW( hwnd, GWL_STYLE ) & WS_MAXIMIZE);
+        X11DRV_expect_error( display, ignore_error, NULL );
+        on = get_cardinal( display, child, maximized_atom( display ) ) != 0;
+        X11DRV_check_error();
+        if (on != zoomed) NtUserShowWindow( hwnd, on ? SW_MAXIMIZE : SW_RESTORE );
+        return 0;
+    }
     case WM_X11DRV_SG_EMBED_CLOSE:
     {
         Atom *protocols;
@@ -721,6 +841,8 @@
         else if (event->xproperty.atom == fullscreen_atom( display ))
             NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_FULLSCREEN, 0, 0 );
 #endif
+        else if (event->xproperty.atom == maximized_atom( display ))
+            NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_MAXIMIZE, 0, 0 );
         break;
     case UnmapNotify:
         if (event->xunmap.window == event->xunmap.event) NtUserPostMessage( hwnd, WM_SG_EMBED_SHOWN, 0, 0 );
