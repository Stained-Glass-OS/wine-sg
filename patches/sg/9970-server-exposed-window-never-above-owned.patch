From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: an exposed window never goes above a window it owns

update_window_zorder (winex11 asks it on an Expose and on pointer motion:
"X shows this rectangle of the window, so nothing is over it") moved the
window above the first window over that rectangle, minding only the topmost
rule. Under the session's compositor (sg-deskcomp redirects the desktop's X
windows) every exposure covers the whole window, and a window just mapped is
exposed before it is restacked, so an owner went above the popup it owns:
Brave's and Chrome's "quit unexpectedly" dialog (an owned popup, its browser
window disabled behind it) was invisible and the browser took no clicks.
Windows never puts an owner over the windows it owns; neither does this.
---
--- a/server/window.c
+++ b/server/window.c
@@ -3206,11 +3206,25 @@
 }
 
 
+/* Stained Glass OS: whether WIN owns PTR, itself or through PTR's owner's owner */
+static int window_owns( struct window *win, struct window *ptr )
+{
+    unsigned int depth;
+
+    for (depth = 0; ptr && ptr->owner && depth < 64; depth++)
+    {
+        if (ptr->owner == win->handle) return 1;
+        ptr = get_user_object( ptr->owner, USER_WINDOW );
+    }
+    return 0;
+}
+
 /* update the z order of a window so that a given rectangle is fully visible */
 DECL_HANDLER(update_window_zorder)
 {
     struct rectangle tmp, rect = req->rect;
     struct window *ptr, *win = get_window( req->window );
+    struct window *above;
 
     if (!win || !win->parent || !is_visible( win )) return;  /* nothing to do */
 
@@ -3232,6 +3246,18 @@
         /* making sure to not violate the topmost rule */
         if (!(ptr->ex_style & WS_EX_TOPMOST) || (win->ex_style & WS_EX_TOPMOST))
         {
+#ifndef SG_MUTANT_ZORDER_OVER_OWNED
+            /* Stained Glass OS: nor the owner rule -- a window never goes above a
+             * window it owns (Windows keeps owned windows over their owner). The X
+             * server's word that the rectangle is exposed is no proof that nothing
+             * is over it: under a compositor (sg-deskcomp redirects the desktop's
+             * windows) every exposure covers the whole window, and a window just
+             * mapped is exposed before it is stacked. Brave's "quit unexpectedly"
+             * dialog went under its disabled browser window that way. */
+            for (above = ptr; above && above != win; above = get_next_window( above ))
+                if (window_owns( win, above )) break;
+            if (above != win) break;
+#endif
             list_remove( &win->entry );
             list_add_before( &ptr->entry, &win->entry );
         }
