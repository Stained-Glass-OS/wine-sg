+/* Stained Glass OS (wine-sg 1526): Windows.Security.EnterpriseData.ProtectionPolicyManager
+ * as Windows answers it on a machine where Windows Information Protection
+ * manages no identity: nothing is managed, protection is off, every access is
+ * allowed and nothing is revoked. Office looks it up as it starts (Excel's
+ * file opening, OneNote) and logged "GetIPolicyProtectionMgrStatics2
+ * 0x80040154" when the class was missing. */
+
+/* IProtectionPolicyManagerInterop (efswrtinterop.h): the manager for a window */
+DEFINE_GUID(IID_IProtectionPolicyManagerInterop, 0x4652651d,0xc1fe,0x4ba1,0x9f,0x0a,0xc0,0xf5,0x65,0x96,0xf7,0x21);
+typedef struct IProtectionPolicyManagerInterop IProtectionPolicyManagerInterop;
+typedef struct
+{
+    HRESULT (WINAPI *QueryInterface)(IProtectionPolicyManagerInterop *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(IProtectionPolicyManagerInterop *);
+    ULONG (WINAPI *Release)(IProtectionPolicyManagerInterop *);
+    HRESULT (WINAPI *GetIids)(IProtectionPolicyManagerInterop *, ULONG *, IID **);
+    HRESULT (WINAPI *GetRuntimeClassName)(IProtectionPolicyManagerInterop *, HSTRING *);
+    HRESULT (WINAPI *GetTrustLevel)(IProtectionPolicyManagerInterop *, TrustLevel *);
+    HRESULT (WINAPI *RequestAccessForWindowAsync)(IProtectionPolicyManagerInterop *, HWND, HSTRING, HSTRING, REFIID, void **);
+    HRESULT (WINAPI *GetForWindow)(IProtectionPolicyManagerInterop *, HWND, REFIID, void **);
+} IProtectionPolicyManagerInteropVtbl;
+struct IProtectionPolicyManagerInterop { const IProtectionPolicyManagerInteropVtbl *lpVtbl; };
+
+/* a manager, for a view or a window: it only keeps what it is told */
+struct manager
+{
+    IProtectionPolicyManager IProtectionPolicyManager_iface;
+    IProtectionPolicyManager2 IProtectionPolicyManager2_iface;
+    LONG ref;
+    HSTRING identity;
+    boolean show_indicator;
+};
+
+static inline struct manager *impl_from_IProtectionPolicyManager( IProtectionPolicyManager *iface )
+{
+    return CONTAINING_RECORD( iface, struct manager, IProtectionPolicyManager_iface );
+}
+
+static HRESULT WINAPI manager_QueryInterface( IProtectionPolicyManager *iface, REFIID iid, void **out )
+{
+    struct manager *impl = impl_from_IProtectionPolicyManager( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IProtectionPolicyManager ))
+        *out = &impl->IProtectionPolicyManager_iface;
+    else if (IsEqualGUID( iid, &IID_IProtectionPolicyManager2 ))
+        *out = &impl->IProtectionPolicyManager2_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI manager_AddRef( IProtectionPolicyManager *iface )
+{
+    return InterlockedIncrement( &impl_from_IProtectionPolicyManager( iface )->ref );
+}
+
+static ULONG WINAPI manager_Release( IProtectionPolicyManager *iface )
+{
+    struct manager *impl = impl_from_IProtectionPolicyManager( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        WindowsDeleteString( impl->identity );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI manager_GetIids( IProtectionPolicyManager *iface, ULONG *count, IID **iids )
+{
+    FIXME( "iface %p, count %p, iids %p stub!\n", iface, count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI manager_GetRuntimeClassName( IProtectionPolicyManager *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Security_EnterpriseData_ProtectionPolicyManager,
+                                wcslen( RuntimeClass_Windows_Security_EnterpriseData_ProtectionPolicyManager ), name );
+}
+
+static HRESULT WINAPI manager_GetTrustLevel( IProtectionPolicyManager *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI manager_put_Identity( IProtectionPolicyManager *iface, HSTRING value )
+{
+    struct manager *impl = impl_from_IProtectionPolicyManager( iface );
+    HSTRING copy;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+    if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    WindowsDeleteString( impl->identity );
+    impl->identity = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI manager_get_Identity( IProtectionPolicyManager *iface, HSTRING *value )
+{
+    struct manager *impl = impl_from_IProtectionPolicyManager( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( impl->identity, value );
+}
+
+static const struct IProtectionPolicyManagerVtbl manager_vtbl =
+{
+    manager_QueryInterface,
+    manager_AddRef,
+    manager_Release,
+    manager_GetIids,
+    manager_GetRuntimeClassName,
+    manager_GetTrustLevel,
+    manager_put_Identity,
+    manager_get_Identity,
+};
+
+static inline struct manager *impl_from_IProtectionPolicyManager2( IProtectionPolicyManager2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct manager, IProtectionPolicyManager2_iface );
+}
+
+#define FORWARD_IINSPECTABLE( pfx, type, impl_from, base )                                                    \
+    static HRESULT WINAPI pfx##_QueryInterface( type *iface, REFIID iid, void **out )                          \
+    { return IInspectable_QueryInterface( (IInspectable *)base, iid, out ); }                                   \
+    static ULONG WINAPI pfx##_AddRef( type *iface ) { return IInspectable_AddRef( (IInspectable *)base ); }    \
+    static ULONG WINAPI pfx##_Release( type *iface ) { return IInspectable_Release( (IInspectable *)base ); }  \
+    static HRESULT WINAPI pfx##_GetIids( type *iface, ULONG *count, IID **iids )                               \
+    { return IInspectable_GetIids( (IInspectable *)base, count, iids ); }                                       \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( type *iface, HSTRING *name )                              \
+    { return IInspectable_GetRuntimeClassName( (IInspectable *)base, name ); }                                  \
+    static HRESULT WINAPI pfx##_GetTrustLevel( type *iface, TrustLevel *level )                                \
+    { return IInspectable_GetTrustLevel( (IInspectable *)base, level ); }
+
+FORWARD_IINSPECTABLE( manager2, IProtectionPolicyManager2, impl_from_IProtectionPolicyManager2,
+                      &impl_from_IProtectionPolicyManager2( iface )->IProtectionPolicyManager_iface )
+
+static HRESULT WINAPI manager2_put_ShowEnterpriseIndicator( IProtectionPolicyManager2 *iface, boolean value )
+{
+    TRACE( "iface %p, value %d.\n", iface, value );
+    impl_from_IProtectionPolicyManager2( iface )->show_indicator = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI manager2_get_ShowEnterpriseIndicator( IProtectionPolicyManager2 *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl_from_IProtectionPolicyManager2( iface )->show_indicator;
+    return S_OK;
+}
+
+static const struct IProtectionPolicyManager2Vtbl manager2_vtbl =
+{
+    manager2_QueryInterface,
+    manager2_AddRef,
+    manager2_Release,
+    manager2_GetIids,
+    manager2_GetRuntimeClassName,
+    manager2_GetTrustLevel,
+    manager2_put_ShowEnterpriseIndicator,
+    manager2_get_ShowEnterpriseIndicator,
+};
+
+static HRESULT manager_create( REFIID iid, void **out )
+{
+    struct manager *impl;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IProtectionPolicyManager_iface.lpVtbl = &manager_vtbl;
+    impl->IProtectionPolicyManager2_iface.lpVtbl = &manager2_vtbl;
+    impl->ref = 1;
+    impl->show_indicator = TRUE;
+    hr = IProtectionPolicyManager_QueryInterface( &impl->IProtectionPolicyManager_iface, iid, out );
+    IProtectionPolicyManager_Release( &impl->IProtectionPolicyManager_iface );
+    return hr;
+}
