+DEFINE_GUID(IID_IThreadNetworkContext_local, 0xfa4ea8e9,0xef13,0x405a,0xb1,0x2c,0xd7,0x34,0x8c,0x6f,0x41,0xfc);
+
+/* a thread network context: closing it changes nothing, as nothing was applied */
+struct context
+{
+    IClosable IClosable_iface;
+    LONG ref;
+};
+
+static inline struct context *impl_from_IClosable( IClosable *iface )
+{
+    return CONTAINING_RECORD( iface, struct context, IClosable_iface );
+}
+
+static HRESULT WINAPI context_QueryInterface( IClosable *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IClosable ))
+    {
+        *out = iface;
+        IClosable_AddRef( iface );
+        return S_OK;
+    }
+    /* IThreadNetworkContext has no members: answered by the default interface */
