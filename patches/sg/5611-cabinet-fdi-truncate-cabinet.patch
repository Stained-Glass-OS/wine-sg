From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cabinet: FDITruncateCabinet

cabinet: FDITruncateCabinet

Removes the folders from a cabinet from a given folder onwards, rewriting
the header, folder and file tables and the data blocks, and truncating the
file.
---
--- a/dlls/cabinet/fdi.c
+++ b/dlls/cabinet/fdi.c
@@ -2853,12 +2853,241 @@ BOOL __cdecl FDITruncateCabinet(
 	USHORT  iFolderToDelete)
 {
   FDI_Int *fdi = get_fdi_ptr( hfdi );
-
-  FIXME("(hfdi == ^%p, pszCabinetName == %s, iFolderToDelete == %hu): stub\n",
+  cab_UBYTE *old = NULL, *out = NULL;
+  cab_UBYTE *folders, *files, *p;
+  cab_ULONG file_size, cabsize, coff_files, data_start, hdr_len, folder_len, new_files_off, new_size;
+  cab_UWORD flags, num_folders, num_files, kept_files = 0, header_resv = 0;
+  cab_UBYTE folder_resv = 0, block_resv = 0;
+  cab_ULONG pos, written;
+  INT_PTR hf;
+  BOOL ret = FALSE;
+  unsigned int i, j;
+
+  TRACE("(hfdi == ^%p, pszCabinetName == %s, iFolderToDelete == %hu)\n",
     hfdi, debugstr_a(pszCabinetName), iFolderToDelete);
 
   if (!fdi) return FALSE;
 
-  SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-  return FALSE;
+  hf = fdi->open( pszCabinetName, _O_RDWR|_O_BINARY, _S_IREAD | _S_IWRITE );
+  if (hf == -1)
+  {
+    set_error( fdi, FDIERROR_CABINET_NOT_FOUND, 0 );
+    SetLastError( ERROR_FILE_NOT_FOUND );
+    return FALSE;
+  }
+
+  /* the whole cabinet is read, rebuilt and written back */
+  file_size = fdi->seek( hf, 0, SEEK_END );
+  if (file_size == (cab_ULONG)-1 || fdi->seek( hf, 0, SEEK_SET ) == -1 || file_size < cfhead_SIZEOF)
+  {
+    set_error( fdi, FDIERROR_NOT_A_CABINET, 0 );
+    goto done;
+  }
+  if (!(old = fdi->alloc( file_size )))
+  {
+    set_error( fdi, FDIERROR_ALLOC_FAIL, ERROR_NOT_ENOUGH_MEMORY );
+    goto done;
+  }
+  if (fdi->read( hf, old, file_size ) != file_size)
+  {
+    set_error( fdi, FDIERROR_CORRUPT_CABINET, 0 );
+    goto done;
+  }
+
+  if (EndGetI32(old + cfhead_Signature) != 0x4643534d)
+  {
+    set_error( fdi, FDIERROR_NOT_A_CABINET, 0 );
+    goto done;
+  }
+  if (old[cfhead_MajorVersion] > 1 || (old[cfhead_MajorVersion] == 1 && old[cfhead_MinorVersion] > 3))
+  {
+    set_error( fdi, FDIERROR_UNKNOWN_CABINET_VERSION, 0 );
+    goto done;
+  }
+  cabsize = EndGetI32(old + cfhead_CabinetSize);
+  coff_files = EndGetI32(old + cfhead_FileOffset);
+  num_folders = EndGetI16(old + cfhead_NumFolders);
+  num_files = EndGetI16(old + cfhead_NumFiles);
+  flags = EndGetI16(old + cfhead_Flags);
+  if (cabsize > file_size) cabsize = file_size;
+
+  /* the header, with its reserved areas and the names of the neighbouring cabinets */
+  pos = cfhead_SIZEOF;
+  if (flags & cfheadRESERVE_PRESENT)
+  {
+    if (pos + cfheadext_SIZEOF > cabsize) goto corrupt;
+    header_resv = EndGetI16(old + pos + cfheadext_HeaderReserved);
+    folder_resv = old[pos + cfheadext_FolderReserved];
+    block_resv = old[pos + cfheadext_DataReserved];
+    pos += cfheadext_SIZEOF;
+    if (pos + header_resv > cabsize) goto corrupt;
+    pos += header_resv;
+  }
+  for (i = 0; i < 4; i++)
+  {
+    static const cab_UWORD names[4] = { cfheadPREV_CABINET, cfheadPREV_CABINET, cfheadNEXT_CABINET, cfheadNEXT_CABINET };
+    if (!(flags & names[i])) continue;
+    while (pos < cabsize && old[pos]) pos++;
+    if (pos >= cabsize) goto corrupt;
+    pos++;
+  }
+  hdr_len = pos;
+  folder_len = cffold_SIZEOF + folder_resv;
+  if (hdr_len + (cab_ULONG)num_folders * folder_len > cabsize) goto corrupt;
+  folders = old + hdr_len;
+  if (coff_files < hdr_len + (cab_ULONG)num_folders * folder_len || coff_files > cabsize) goto corrupt;
+  files = old + coff_files;
+
+  if (iFolderToDelete > num_folders) iFolderToDelete = num_folders;
+
+  /* the files that stay; they are listed after the folders, up to the first data block */
+  data_start = cabsize;
+  for (i = 0; i < num_folders; i++)
+  {
+    cab_ULONG off = EndGetI32(folders + i * folder_len + cffold_DataOffset);
+    if (off > cabsize) goto corrupt;
+    if (off < data_start) data_start = off;
+  }
+  if (data_start < coff_files) goto corrupt;
+  if (!num_folders) data_start = cabsize;
+
+  new_files_off = hdr_len + (cab_ULONG)iFolderToDelete * folder_len;
+  p = files;
+  for (j = 0; j < num_files; j++)
+  {
+    cab_UWORD idx;
+    cab_ULONG len;
+
+    if (p + cffile_SIZEOF > old + data_start) goto corrupt;
+    idx = EndGetI16(p + cffile_FolderIndex);
+    /* the files continued from or into another cabinet belong to the first or last folder */
+    if (idx == cffileCONTINUED_FROM_PREV) idx = 0;
+    else if (idx == cffileCONTINUED_TO_NEXT || idx == cffileCONTINUED_PREV_AND_NEXT) idx = num_folders - 1;
+    for (len = cffile_SIZEOF; p + len < old + data_start && p[len]; len++) ;
+    if (p + len >= old + data_start) goto corrupt;
+    len++;
+#ifdef SG_MUTANT_CAB_KEEP_FILES
+    if (idx < 0xffff) kept_files++;
+#else
+    if (idx < iFolderToDelete) kept_files++;
+#endif
+    p += len;
+  }
+
+  /* the data of the folders that stay must be whole blocks inside the cabinet */
+  for (i = 0; i < iFolderToDelete; i++)
+  {
+    cab_ULONG q = EndGetI32(folders + i * folder_len + cffold_DataOffset);
+    cab_UWORD blocks = EndGetI16(folders + i * folder_len + cffold_NumBlocks);
+
+    for (j = 0; j < blocks; j++)
+    {
+      if (q + 8 + block_resv > cabsize) goto corrupt;
+      q += 8 + block_resv + EndGetI16(old + q + 4);
+      if (q > cabsize) goto corrupt;
+    }
+  }
+
+  /* size of what is kept: header, folders, files, data */
+  {
+    cab_ULONG files_len = 0, data_len = 0;
+
+    p = files;
+    for (j = 0; j < num_files; j++)
+    {
+      cab_UWORD idx = EndGetI16(p + cffile_FolderIndex);
+      cab_ULONG len;
+      cab_UWORD eff = idx;
+
+      if (idx == cffileCONTINUED_FROM_PREV) eff = 0;
+      else if (idx == cffileCONTINUED_TO_NEXT || idx == cffileCONTINUED_PREV_AND_NEXT) eff = num_folders - 1;
+      for (len = cffile_SIZEOF; p[len]; len++) ;
+      len++;
+      if (eff < iFolderToDelete) files_len += len;
+      p += len;
+    }
+    for (i = 0; i < iFolderToDelete; i++)
+    {
+      cab_ULONG off = EndGetI32(folders + i * folder_len + cffold_DataOffset);
+      cab_UWORD blocks = EndGetI16(folders + i * folder_len + cffold_NumBlocks);
+      cab_ULONG q = off;
+      for (j = 0; j < blocks; j++) q += 8 + block_resv + EndGetI16(old + q + 4);
+      data_len += q - off;
+    }
+    new_size = new_files_off + files_len + data_len;
+  }
+
+  if (!(out = fdi->alloc( new_size )))
+  {
+    set_error( fdi, FDIERROR_ALLOC_FAIL, ERROR_NOT_ENOUGH_MEMORY );
+    goto done;
+  }
+
+  /* header and folders */
+  memcpy( out, old, hdr_len );
+  out[cfhead_CabinetSize] = new_size; out[cfhead_CabinetSize + 1] = new_size >> 8;
+  out[cfhead_CabinetSize + 2] = new_size >> 16; out[cfhead_CabinetSize + 3] = new_size >> 24;
+  out[cfhead_FileOffset] = new_files_off; out[cfhead_FileOffset + 1] = new_files_off >> 8;
+  out[cfhead_FileOffset + 2] = new_files_off >> 16; out[cfhead_FileOffset + 3] = new_files_off >> 24;
+  out[cfhead_NumFolders] = iFolderToDelete; out[cfhead_NumFolders + 1] = iFolderToDelete >> 8;
+  out[cfhead_NumFiles] = kept_files; out[cfhead_NumFiles + 1] = kept_files >> 8;
+  memcpy( out + hdr_len, folders, (cab_ULONG)iFolderToDelete * folder_len );
+
+  /* files */
+  written = new_files_off;
+  p = files;
+  for (j = 0; j < num_files; j++)
+  {
+    cab_UWORD idx = EndGetI16(p + cffile_FolderIndex), eff = idx;
+    cab_ULONG len;
+
+    if (idx == cffileCONTINUED_FROM_PREV) eff = 0;
+    else if (idx == cffileCONTINUED_TO_NEXT || idx == cffileCONTINUED_PREV_AND_NEXT) eff = num_folders - 1;
+    for (len = cffile_SIZEOF; p[len]; len++) ;
+    len++;
+    if (eff < iFolderToDelete)
+    {
+      memcpy( out + written, p, len );
+      written += len;
+    }
+    p += len;
+  }
+
+  /* data, with the folders' offsets moved */
+  for (i = 0; i < iFolderToDelete; i++)
+  {
+    cab_UBYTE *fold = out + hdr_len + (cab_ULONG)i * folder_len;
+    cab_ULONG off = EndGetI32(fold + cffold_DataOffset), q = off;
+    cab_UWORD blocks = EndGetI16(fold + cffold_NumBlocks);
+
+    for (j = 0; j < blocks; j++) q += 8 + block_resv + EndGetI16(old + q + 4);
+#ifndef SG_MUTANT_CAB_NO_OFFSET_FIX
+    fold[cffold_DataOffset] = written; fold[cffold_DataOffset + 1] = written >> 8;
+    fold[cffold_DataOffset + 2] = written >> 16; fold[cffold_DataOffset + 3] = written >> 24;
+#endif
+    memcpy( out + written, old + off, q - off );
+    written += q - off;
+  }
+
+  /* written back; a write of nothing truncates the file at the current position */
+#ifdef SG_MUTANT_CAB_NO_TRUNCATE
+  if (fdi->seek( hf, 0, SEEK_SET ) == -1 || fdi->write( hf, out, new_size ) != new_size)
+#else
+  if (fdi->seek( hf, 0, SEEK_SET ) == -1 || fdi->write( hf, out, new_size ) != new_size ||
+      fdi->write( hf, out, 0 ) != 0)
+#endif
+  {
+    set_error( fdi, FDIERROR_USER_ABORT, 0 );
+    goto done;
+  }
+  ret = TRUE;
+  goto done;
+
+corrupt:
+  set_error( fdi, FDIERROR_CORRUPT_CABINET, 0 );
+done:
+  if (old) fdi->free( old );
+  if (out) fdi->free( out );
+  fdi->close( hf );
+  return ret;
 }
--- a/dlls/cabinet/tests/fdi.c
+++ b/dlls/cabinet/tests/fdi.c
@@ -935,6 +935,258 @@ static void test_FDICopy(void)
 }
 
 
+/* a cabinet of three folders and five files, with a reserved area in the
+ * header, folders and blocks, rebuilt with FDITruncateCabinet */
+static void *CDECL tr_alloc(ULONG cb) { return HeapAlloc(GetProcessHeap(), 0, cb); }
+static void CDECL tr_free(void *pv) { HeapFree(GetProcessHeap(), 0, pv); }
+
+static INT_PTR CDECL tr_open(char *name, int oflag, int pmode)
+{
+    HANDLE h = CreateFileA(name, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                           OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    return h == INVALID_HANDLE_VALUE ? -1 : (INT_PTR)h;
+}
+
+static UINT CDECL tr_read(INT_PTR hf, void *pv, UINT cb)
+{
+    DWORD read;
+    return ReadFile((HANDLE)hf, pv, cb, &read, NULL) ? read : (UINT)-1;
+}
+
+static UINT CDECL tr_write(INT_PTR hf, void *pv, UINT cb)
+{
+    DWORD written;
+    if (!cb) return SetEndOfFile((HANDLE)hf) ? 0 : (UINT)-1;
+    return WriteFile((HANDLE)hf, pv, cb, &written, NULL) ? written : (UINT)-1;
+}
+
+static int CDECL tr_close(INT_PTR hf) { return CloseHandle((HANDLE)hf) ? 0 : -1; }
+
+static LONG CDECL tr_seek(INT_PTR hf, LONG dist, int seektype)
+{
+    DWORD ret = SetFilePointer((HANDLE)hf, dist, NULL, seektype);
+    return ret == INVALID_SET_FILE_POINTER ? -1 : ret;
+}
+
+static void put16(BYTE *p, unsigned int v) { p[0] = v; p[1] = v >> 8; }
+static void put32(BYTE *p, unsigned int v) { put16(p, v); put16(p + 2, v >> 16); }
+static unsigned int get16(const BYTE *p) { return p[0] | (p[1] << 8); }
+static unsigned int get32(const BYTE *p) { return get16(p) | (get16(p + 2) << 16); }
+
+static struct
+{
+    char names[8][16];
+    unsigned int sizes[8];
+    unsigned int count;
+} tr_files;
+
+static INT_PTR CDECL tr_notify(FDINOTIFICATIONTYPE type, FDINOTIFICATION *info)
+{
+    if (type == fdintCOPY_FILE && tr_files.count < 8)
+    {
+        lstrcpyA(tr_files.names[tr_files.count], info->psz1);
+        tr_files.sizes[tr_files.count++] = info->cb;
+    }
+    return 0;
+}
+
+static unsigned int build_cab(BYTE *cab, BOOL reserve)
+{
+    /* folder 0: a.txt (and b.txt), folder 1: c.txt, folder 2: d.txt and e.txt, two blocks */
+    static const struct { const char *name; unsigned int folder, offset, size; } files[5] =
+    {
+        { "a.txt", 0, 0, 5 }, { "b.txt", 0, 5, 7 }, { "c.txt", 1, 0, 4 }, { "d.txt", 2, 0, 6 }, { "e.txt", 2, 6, 6 }
+    };
+    static const unsigned int blocks_in_folder[3] = { 1, 2, 2 };
+    unsigned int hdr = 36 + (reserve ? 4 + 3 : 0), folder_len = 8 + (reserve ? 2 : 0), block_resv = reserve ? 1 : 0;
+    unsigned int i, j, pos, files_off, data_off;
+    BYTE *p;
+
+    memset(cab, 0, 4096);
+    memcpy(cab, "MSCF", 4);
+    cab[24] = 3; cab[25] = 1;
+    put16(cab + 26, 3);
+    put16(cab + 28, 5);
+    put16(cab + 30, reserve ? 4 : 0);
+    put16(cab + 32, 0x1234);
+    put16(cab + 34, 0);
+    if (reserve)
+    {
+        put16(cab + 36, 3);   /* header reserve */
+        cab[38] = 2;          /* folder reserve */
+        cab[39] = 1;          /* block reserve */
+        memcpy(cab + 40, "res", 3);
+    }
+    files_off = hdr + 3 * folder_len;
+    put32(cab + 16, files_off);
+    p = cab + files_off;
+    for (i = 0; i < 5; i++)
+    {
+        put32(p, files[i].size);
+        put32(p + 4, files[i].offset);
+        put16(p + 8, files[i].folder);
+        put16(p + 10, 0x1225);
+        put16(p + 12, 0x2013);
+        put16(p + 14, 0x20);
+        strcpy((char *)p + 16, files[i].name);
+        p += 16 + strlen(files[i].name) + 1;
+    }
+    data_off = p - cab;
+    pos = data_off;
+    for (i = 0; i < 3; i++)
+    {
+        BYTE *folder = cab + hdr + i * folder_len;
+
+        put32(folder, pos);
+        put16(folder + 4, blocks_in_folder[i]);
+        put16(folder + 6, 0);
+        if (reserve) { folder[8] = 0xf0 + i; folder[9] = 0xf8 + i; }
+        for (j = 0; j < blocks_in_folder[i]; j++)
+        {
+            unsigned int n = 6;
+
+            put32(cab + pos, 0xc0de0000 + i * 16 + j);
+            put16(cab + pos + 4, n);
+            put16(cab + pos + 6, n);
+            if (reserve) cab[pos + 8] = 0xe0 + i;
+            memset(cab + pos + 8 + block_resv, 'A' + i * 2 + j, n);
+            pos += 8 + block_resv + n;
+        }
+    }
+    put32(cab + 8, pos);
+    return pos;
+}
+
+static void test_FDITruncateCabinet(void)
+{
+    static const unsigned int expected_files[4] = { 0, 2, 3, 5 };
+    char path[MAX_PATH], name[MAX_PATH];
+    BYTE cab[4096], *got;
+    ERF erf;
+    HFDI hfdi;
+    HANDLE file;
+    DWORD size, written;
+    unsigned int total, reserve, folders, i;
+    BOOL ret;
+
+    GetTempPathA(MAX_PATH, path);
+    sprintf(name, "%swine-truncate.cab", path);
+
+    hfdi = FDICreate(tr_alloc, tr_free, tr_open, tr_read, tr_write, tr_close, tr_seek, cpuUNKNOWN, &erf);
+    ok(hfdi != NULL, "FDICreate failed\n");
+
+    for (reserve = 0; reserve < 2; reserve++)
+    for (folders = 0; folders < 4; folders++)
+    {
+        total = build_cab(cab, reserve);
+        file = CreateFileA(name, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        WriteFile(file, cab, total, &written, NULL);
+        CloseHandle(file);
+
+        memset(&erf, 0xcc, sizeof(erf));
+        ret = FDITruncateCabinet(hfdi, name, folders);
+        ok(ret, "folders %u: FDITruncateCabinet failed, erf %d %d\n", folders, erf.erfOper, erf.erfType);
+
+        file = CreateFileA(name, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+        size = GetFileSize(file, NULL);
+        got = HeapAlloc(GetProcessHeap(), 0, size);
+        ReadFile(file, got, size, &written, NULL);
+        CloseHandle(file);
+
+        ok(get32(got + 8) == size, "reserve %u, folders %u: cabinet size %u, file size %lu\n", reserve, folders, get32(got + 8), size);
+        ok(get16(got + 26) == folders, "folders %u: got %u folders\n", folders, get16(got + 26));
+        ok(get16(got + 28) == expected_files[folders], "folders %u: got %u files, expected %u\n", folders,
+           get16(got + 28), expected_files[folders]);
+        ok(get32(got + 16) == (reserve ? 43u : 36u) + folders * (reserve ? 10u : 8u), "folders %u: files at %u\n", folders,
+           get32(got + 16));
+        if (folders)
+        {
+            unsigned int hdr = reserve ? 43 : 36, flen = reserve ? 10 : 8, bres = reserve ? 1 : 0;
+
+            for (i = 0; i < folders; i++)
+            {
+                BYTE *fold = got + hdr + i * flen;
+                unsigned int off = get32(fold), blocks = get16(fold + 4), j;
+
+                ok(off + 8 + bres + 6 <= size, "folder %u: data at %u of %lu\n", i, off, size);
+                if (off + 8 + bres + 6 > size) continue;
+                for (j = 0; j < blocks; j++, off += 8 + bres + 6)
+                {
+                    ok(get32(got + off) == 0xc0de0000 + (i == 0 ? 0 : i == 1 ? 16 : 32) + j, "folder %u block %u: checksum %#x\n",
+                       i, j, get32(got + off));
+                    ok(got[off + 8 + bres] == 'A' + i * 2 + j, "folder %u block %u: data %c\n", i, j,
+                       got[off + 8 + bres]);
+                }
+                if (reserve)
+                {
+                    ok(fold[8] == 0xf0 + i && fold[9] == 0xf8 + i, "folder %u: reserved area lost\n", i);
+                }
+            }
+        }
+        if (reserve) ok(!memcmp(got + 40, "res", 3), "header reserved area lost\n");
+
+        /* what FDI reads out of it */
+        memset(&tr_files, 0, sizeof(tr_files));
+        if (folders)
+        {
+            char dir[MAX_PATH], cabname[MAX_PATH];
+            lstrcpyA(dir, path);
+            lstrcpyA(cabname, "wine-truncate.cab");
+            ret = FDICopy(hfdi, cabname, dir, 0, tr_notify, NULL, NULL);
+            ok(ret, "reserve %u, folders %u: FDICopy failed, erf %d %d\n", reserve, folders, erf.erfOper, erf.erfType);
+            ok(tr_files.count == expected_files[folders], "folders %u: %u files listed\n", folders, tr_files.count);
+            for (i = 0; i < tr_files.count; i++)
+                ok(tr_files.names[i][0] == 'a' + i, "folders %u: file %u is %s\n", folders, i, tr_files.names[i]);
+        }
+        HeapFree(GetProcessHeap(), 0, got);
+    }
+
+    /* more than there are changes nothing */
+    total = build_cab(cab, 0);
+    file = CreateFileA(name, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    WriteFile(file, cab, total, &written, NULL);
+    CloseHandle(file);
+    ret = FDITruncateCabinet(hfdi, name, 3);
+    ok(ret, "FDITruncateCabinet failed\n");
+    file = CreateFileA(name, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    size = GetFileSize(file, NULL);
+    CloseHandle(file);
+    ok(size == total, "got size %lu, expected %u\n", size, total);
+
+    /* errors */
+    memset(&erf, 0, sizeof(erf));
+    sprintf(name, "%swine-truncate-missing.cab", path);
+    DeleteFileA(name);
+    ret = FDITruncateCabinet(hfdi, name, 1);
+    ok(!ret, "FDITruncateCabinet succeeded\n");
+    ok(erf.fError && erf.erfOper == FDIERROR_CABINET_NOT_FOUND, "got erf %d %d %d\n", erf.fError, erf.erfOper, erf.erfType);
+
+    sprintf(name, "%swine-truncate-bad.cab", path);
+    file = CreateFileA(name, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    WriteFile(file, "this is not a cabinet file at all, not even close to one", 56, &written, NULL);
+    CloseHandle(file);
+    memset(&erf, 0, sizeof(erf));
+    ret = FDITruncateCabinet(hfdi, name, 1);
+    ok(!ret, "FDITruncateCabinet succeeded\n");
+    ok(erf.fError && erf.erfOper == FDIERROR_NOT_A_CABINET, "got erf %d %d %d\n", erf.fError, erf.erfOper, erf.erfType);
+    DeleteFileA(name);
+
