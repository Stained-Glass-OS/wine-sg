+/* ---- the log callback: one at a time, of whichever kind was registered last ---- */
+
+enum log_kind { LOG_NONE, LOG_CDECL_W, LOG_CDECL_A, LOG_STDCALL_W, LOG_STDCALL_A };
+
+static CRITICAL_SECTION log_cs;
+static CRITICAL_SECTION_DEBUG log_cs_debug =
 {
-    FIXME("(%s, %lu) stub\n", wine_dbgstr_a(inf), flags);
-    return ERROR_SUCCESS;
+    0, 0, &log_cs,
+    { &log_cs_debug.ProcessLocksList, &log_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": log_cs") }
+};
+static CRITICAL_SECTION log_cs = { &log_cs_debug, -1, 0, 0, 0, 0 };
+static struct { enum log_kind kind; void *callback; void *context; } log_target;
+
+static void set_log_callback( enum log_kind kind, void *callback, void *context )
+{
+    EnterCriticalSection( &log_cs );
+    /* NULL "unregisters the currently registered callback function, if any" */
+    log_target.kind = callback ? kind : LOG_NONE;
+    log_target.callback = callback;
+    log_target.context = context;
+    LeaveCriticalSection( &log_cs );
 }
 
-DWORD WINAPI DriverPackagePreinstallW(LPCWSTR inf, DWORD flags)
+static void log_event( DIFXAPI_LOG type, DWORD error, const WCHAR *format, ... )
 {
-    FIXME("(%s, %lu) stub\n", wine_dbgstr_w(inf), flags);
-    return ERROR_SUCCESS;
+    WCHAR text[512];
+    char ansi[512];
+    va_list args;
+    enum log_kind kind;
+    void *callback, *context;
+
+#ifdef SG_MUTANT_NO_LOG
+    return;
+#endif
+    EnterCriticalSection( &log_cs );
+    kind = log_target.kind;
+    callback = log_target.callback;
+    context = log_target.context;
+    LeaveCriticalSection( &log_cs );
+    if (kind == LOG_NONE) return;
+
+    va_start( args, format );
+    vswprintf( text, ARRAY_SIZE(text), format, args );
+    va_end( args );
+
+    switch (kind)
+    {
+    case LOG_CDECL_W: ((DIFXAPILOGCALLBACK_W)callback)( type, error, text, context ); break;
+    case LOG_STDCALL_W: ((DIFXLOGCALLBACK_W)callback)( type, error, text, context ); break;
+    case LOG_CDECL_A:
+    case LOG_STDCALL_A:
+        WideCharToMultiByte( CP_ACP, 0, text, -1, ansi, sizeof(ansi), NULL, NULL );
+        if (kind == LOG_CDECL_A) ((DIFXAPILOGCALLBACK_A)callback)( type, error, ansi, context );
+        else ((DIFXLOGCALLBACK_A)callback)( type, error, ansi, context );
+        break;
+    default: break;
+    }
 }
 
