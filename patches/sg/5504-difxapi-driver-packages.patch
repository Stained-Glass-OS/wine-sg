+
+/* ---- the checks every function starts with ---- */
+
+static BOOL is_administrator(void)
+{
+    SID_IDENTIFIER_AUTHORITY authority = { SECURITY_NT_AUTHORITY };
+    BOOL member = FALSE;
+    PSID sid;
+
+    if (!AllocateAndInitializeSid( &authority, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS,
+                                   0, 0, 0, 0, 0, 0, &sid ))
+        return FALSE;
+    if (!CheckTokenMembership( NULL, sid, &member )) member = FALSE;
+    FreeSid( sid );
+#ifdef SG_MUTANT_NO_ADMIN_CHECK
+    return TRUE;
+#endif
+    return member;
+}
+
+static BOOL is_wow64(void)
+{
+    BOOL wow64 = FALSE;
+
+    IsWow64Process( GetCurrentProcess(), &wow64 );
+#ifdef SG_MUTANT_NO_WOW64_CHECK
+    return FALSE;
+#endif
+    return wow64;
+}
+
+static BOOL in_system_inf_directory( const WCHAR *path )
+{
+    WCHAR dir[MAX_PATH], full[MAX_PATH], *file;
+    UINT len;
+
+    len = GetSystemWindowsDirectoryW( dir, ARRAY_SIZE(dir) );
+    if (!len || len > ARRAY_SIZE(dir) - 6) return FALSE;
+    lstrcatW( dir, L"\\inf" );
+    if (!GetFullPathNameW( path, ARRAY_SIZE(full), full, &file ) || !file) return FALSE;
+    *(file - 1) = 0;
+    return !lstrcmpiW( full, dir );
+}
+
+/* what all of them check before touching anything, in the order of the pages:
+ * a 32-bit caller, the arguments, the path, the caller's rights, the file */
+static DWORD check_call( const WCHAR *inf, DWORD flags, DWORD supported, const INSTALLERINFO_W *info )
+{
+    if (is_wow64()) return ERROR_IN_WOW64;
+    if (!inf || (flags & ~supported)) return ERROR_INVALID_PARAMETER;
+    /* "all members of the structure must supply non-empty string values" */
+    if (info && (!info->pApplicationId || !info->pApplicationId[0] || !info->pDisplayName || !info->pDisplayName[0] ||
+                 !info->pProductName || !info->pProductName[0] || !info->pMfgName || !info->pMfgName[0]))
+        return ERROR_INVALID_PARAMETER;
+    if (lstrlenW( inf ) >= MAX_PATH) return ERROR_FILENAME_EXCED_RANGE;
+    /* "fully qualified": a drive and a path, or a UNC path */
+    if (!((inf[0] && inf[1] == ':' && (inf[2] == '\\' || inf[2] == '/')) || (inf[0] == '\\' && inf[1] == '\\')))
+        return ERROR_INVALID_NAME;
+    if (!is_administrator()) return ERROR_ACCESS_DENIED;
+    if (GetFileAttributesW( inf ) == INVALID_FILE_ATTRIBUTES) return ERROR_FILE_NOT_FOUND;
     return ERROR_SUCCESS;
 }
 
-DWORD WINAPI DriverPackageUninstallA(LPCSTR inf, DWORD flags, PCINSTALLERINFO_A info, BOOL *reboot)
+/* A package for a PnP function driver has a [Manufacturer] section with models
+ * in it; one signed has a catalog beside the INF. The catalog's signature is
+ * not verified here (see the notes): it must be named, and be there. */
+static DWORD check_package( const WCHAR *inf )
+{
+    WCHAR catalog[MAX_PATH], full[MAX_PATH], *file;
+    INFCONTEXT ctx;
+    HINF hinf;
+    DWORD err = ERROR_SUCCESS;
+
+    if ((hinf = SetupOpenInfFileW( inf, NULL, INF_STYLE_WIN4, NULL )) == INVALID_HANDLE_VALUE)
+        return GetLastError();
+
+    if (!SetupGetLineByIndexW( hinf, L"Manufacturer", 0, &ctx ))
+    {
+        err = ERROR_INVALID_FUNCTION;  /* "The driver package is not for a PnP function driver." */
+        goto done;
+    }
+
+    if (!SetupFindFirstLineW( hinf, L"Version", L"CatalogFile.NTamd64", &ctx ) &&
+        !SetupFindFirstLineW( hinf, L"Version", L"CatalogFile.NT", &ctx ) &&
+        !SetupFindFirstLineW( hinf, L"Version", L"CatalogFile", &ctx ))
+    {
+        err = TRUST_E_NOSIGNATURE;  /* "The driver package is not signed." */
+        goto done;
+    }
+    if (!SetupGetStringFieldW( &ctx, 1, catalog, ARRAY_SIZE(catalog), NULL ) || !catalog[0])
+    {
+        err = TRUST_E_NOSIGNATURE;
+        goto done;
+    }
+    GetFullPathNameW( inf, ARRAY_SIZE(full), full, &file );
+    lstrcpynW( file, catalog, ARRAY_SIZE(full) - (file - full) );
+    /* "The catalog file for the specified driver package was not found" */
+    if (GetFileAttributesW( full ) == INVALID_FILE_ATTRIBUTES) err = CRYPT_E_FILE_ERROR;
+done:
+    SetupCloseInfFile( hinf );
+    return err;
+}
+
+/* ---- the driver store and the applications associated with a package ---- */
+
+/* the package in the driver store (the INF there), or ERROR_DRIVER_PACKAGE_NOT_IN_STORE */
+static DWORD find_in_store( const WCHAR *inf, WCHAR *store_inf, DWORD size )
+{
+    SYSTEM_INFO info;
+    HRESULT hr;
+    DWORD len = size;
+
+    GetNativeSystemInfo( &info );
+    hr = DriverStoreFindDriverPackageW( inf, NULL, NULL, info.wProcessorArchitecture, NULL, store_inf, &len );
+    if (hr == S_OK) return ERROR_SUCCESS;
+    if (hr == HRESULT_FROM_WIN32( ERROR_NOT_FOUND ) || hr == HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND ))
+        return ERROR_DRIVER_PACKAGE_NOT_IN_STORE;
+    if (hr == HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER )) return ERROR_INSUFFICIENT_BUFFER;
+    return HRESULT_CODE( hr );
+}
+
+/* HKLM\Software\Wine\DIFx\Packages\<the package's store directory>\Applications\<application id>:
+ * who asked for the package, with the strings of its INSTALLERINFO */
+static HKEY open_package_key( const WCHAR *store_inf, BOOL create )
+{
+    WCHAR name[MAX_PATH], path[MAX_PATH + 64], *p, *dir_end, *dir_start;
+    HKEY key = 0;
+
+    lstrcpynW( name, store_inf, ARRAY_SIZE(name) );
+    /* ...\FileRepository\<inf>_<n>\<inf>: the directory's name identifies the package */
+    dir_end = wcsrchr( name, '\\' );
+    if (!dir_end) return 0;
+    *dir_end = 0;
+    dir_start = wcsrchr( name, '\\' );
+    p = dir_start ? dir_start + 1 : name;
+    swprintf( path, ARRAY_SIZE(path), L"Software\\Wine\\DIFx\\Packages\\%s", p );
+    if (create)
+    {
+        if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL )) return 0;
+    }
+    else if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_ALL_ACCESS, &key )) return 0;
+    return key;
+}
+
+static void associate_application( const WCHAR *store_inf, const INSTALLERINFO_W *info )
+{
+    HKEY package, apps, app;
+
+#ifdef SG_MUTANT_NO_APP_ASSOC
+    return;
+#endif
+    if (!info || !(package = open_package_key( store_inf, TRUE ))) return;
+    if (!RegCreateKeyExW( package, L"Applications", 0, NULL, 0, KEY_ALL_ACCESS, NULL, &apps, NULL ))
+    {
+        if (!RegCreateKeyExW( apps, info->pApplicationId, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &app, NULL ))
+        {
+            RegSetValueExW( app, L"DisplayName", 0, REG_SZ, (const BYTE *)info->pDisplayName,
+                            (lstrlenW( info->pDisplayName ) + 1) * sizeof(WCHAR) );
+            RegSetValueExW( app, L"ProductName", 0, REG_SZ, (const BYTE *)info->pProductName,
+                            (lstrlenW( info->pProductName ) + 1) * sizeof(WCHAR) );
+            RegSetValueExW( app, L"MfgName", 0, REG_SZ, (const BYTE *)info->pMfgName,
+                            (lstrlenW( info->pMfgName ) + 1) * sizeof(WCHAR) );
+            RegCloseKey( app );
+        }
+        RegCloseKey( apps );
+    }
+    RegCloseKey( package );
+}
+
+/* drops the application's association; returns how many other applications are left */
+static DWORD dissociate_application( const WCHAR *store_inf, const INSTALLERINFO_W *info )
+{
+    HKEY package, apps;
+    DWORD count = 0;
+
+    if (!(package = open_package_key( store_inf, FALSE ))) return 0;
+    if (!RegOpenKeyExW( package, L"Applications", 0, KEY_ALL_ACCESS, &apps ))
+    {
+        if (info) RegDeleteKeyW( apps, info->pApplicationId );
+        RegQueryInfoKeyW( apps, NULL, NULL, NULL, &count, NULL, NULL, NULL, NULL, NULL, NULL, NULL );
+        RegCloseKey( apps );
+    }
+    RegCloseKey( package );
+    return count;
+}
+
+static void forget_package( const WCHAR *store_inf )
 {
-    FIXME("(%s, %lu, %p, %p) stub\n", wine_dbgstr_a(inf), flags, info, reboot);
+    WCHAR name[MAX_PATH], path[MAX_PATH + 64], *p;
+
+    lstrcpynW( name, store_inf, ARRAY_SIZE(name) );
+    if (!(p = wcsrchr( name, '\\' ))) return;
+    *p = 0;
+    if (!(p = wcsrchr( name, '\\' ))) return;
+    swprintf( path, ARRAY_SIZE(path), L"Software\\Wine\\DIFx\\Packages\\%s", p + 1 );
+    RegDeleteTreeW( HKEY_LOCAL_MACHINE, path );
+}
+
+/* the package in the driver store: its INF copy in the system INF directory */
+static DWORD stage_package( const WCHAR *inf, BOOL replace, WCHAR *oem, DWORD size, BOOL *existed )
+{
+    DWORD err;
+
+    *existed = FALSE;
+    if (SetupCopyOEMInfW( inf, NULL, SPOST_PATH, SP_COPY_NOOVERWRITE, oem, size, NULL, NULL )) return ERROR_SUCCESS;
+    err = GetLastError();
+    if (err != ERROR_FILE_EXISTS) return err;
+    /* the store knows a package by its name and content: this one is there already */
+    *existed = TRUE;
+    return replace ? ERROR_SUCCESS : ERROR_ALREADY_EXISTS;
+}
+
+/* newdev's private device installer, with counts */
+typedef BOOL (WINAPI *install_on_devices_t)( const WCHAR *, DWORD, BOOL *, DWORD *, DWORD * );
+
+static install_on_devices_t get_device_installer(void)
+{
+    HMODULE newdev = LoadLibraryW( L"newdev.dll" );
+
+    return newdev ? (install_on_devices_t)GetProcAddress( newdev, "SgInstallDriverOnDevices" ) : NULL;
+}
+
+/* ---- Preinstall, Install, Uninstall, GetPath ---- */
+
+static DWORD preinstall( const WCHAR *inf, DWORD flags, WCHAR *oem, DWORD oem_size, BOOL *existed )
+{
+    install_on_devices_t install_on_devices;
+    BOOL reboot;
+    DWORD err, matched = 0, installed = 0;
+
+    if (in_system_inf_directory( inf )) return ERROR_CANT_ACCESS_FILE;
+#ifndef SG_MUTANT_NO_CATALOG_CHECK
+    if ((err = check_package( inf ))) return err;
+#endif
+
+    install_on_devices = get_device_installer();
+
+    if ((flags & DRIVER_PACKAGE_ONLY_IF_DEVICE_PRESENT) && install_on_devices)
+    {
+        /* "only if the driver package is a better match to a device in the device tree" */
+        WCHAR staged[MAX_PATH];
+        BOOL was_there;
+
+        if ((err = stage_package( inf, TRUE, staged, ARRAY_SIZE(staged), &was_there ))) return err;
+        install_on_devices( staged, (flags & DRIVER_PACKAGE_FORCE) ? 3 : 2, &reboot, &matched, &installed );
+        if (!matched || (!(flags & DRIVER_PACKAGE_FORCE) && !installed))
+        {
+            if (!was_there)
+            {
+                WCHAR *file = wcsrchr( staged, '\\' );
+                if (file) SetupUninstallOEMInfW( file + 1, 0, NULL );
+            }
+            return matched ? ERROR_NO_MORE_ITEMS : ERROR_NO_SUCH_DEVINST;
+        }
+    }
+
+    return stage_package( inf, !!(flags & DRIVER_PACKAGE_REPAIR), oem, oem_size, existed );
+}
+
+DWORD WINAPI DriverPackagePreinstallW(LPCWSTR inf, DWORD flags)
+{
+    WCHAR oem[MAX_PATH];
+    BOOL existed;
+    DWORD err;
+
+    TRACE("(%s, %#lx)\n", wine_dbgstr_w(inf), flags);
+
+    if ((err = check_call( inf, flags, SUPPORTED_PREINSTALL_FLAGS, NULL ))) goto done;
+    log_event( DIFXAPI_INFO, 0, L"Preinstalling driver package %s.", inf );
+    err = preinstall( inf, flags, oem, ARRAY_SIZE(oem), &existed );
+done:
+    if (err) log_event( DIFXAPI_ERROR, err, L"DriverPackagePreinstall failed." );
+    else log_event( DIFXAPI_SUCCESS, 0, L"Driver package %s was preinstalled.", inf );
+    return err;
+}
+
+DWORD WINAPI DriverPackageInstallW(LPCWSTR inf, DWORD flags, PCINSTALLERINFO_W info, BOOL *reboot)
+{
+    install_on_devices_t install_on_devices;
+    WCHAR oem[MAX_PATH], store[MAX_PATH];
+    DWORD err, matched = 0, installed = 0;
+    BOOL existed, need_reboot = FALSE;
+
+    TRACE("(%s, %#lx, %p, %p)\n", wine_dbgstr_w(inf), flags, info, reboot);
+
     if (reboot) *reboot = FALSE;
-    return ERROR_SUCCESS;
+    if ((err = check_call( inf, flags, SUPPORTED_PREINSTALL_FLAGS, info ))) goto done;
+    log_event( DIFXAPI_INFO, 0, L"Installing driver package %s.", inf );
+
+    err = preinstall( inf, flags, oem, ARRAY_SIZE(oem), &existed );
+    /* installing a package that is already preinstalled goes on to the devices */
+    if (err == ERROR_ALREADY_EXISTS) err = ERROR_SUCCESS;
+    if (err) goto done;
+
+    if (info)
+    {
+        DWORD size = ARRAY_SIZE(store);
+
+        if (!find_in_store( inf, store, size )) associate_application( store, info );
+    }
+
+    if (!(install_on_devices = get_device_installer()))
+    {
+        err = ERROR_INSTALL_FAILURE;
+        log_event( DIFXAPI_ERROR, ERROR_PROC_NOT_FOUND, L"The device installer is not available." );
+        goto done;
+    }
+#ifdef SG_MUTANT_NO_FORCE
+    install_on_devices( oem, 0, &need_reboot, &matched, &installed );
+#else
+    install_on_devices( oem, (flags & DRIVER_PACKAGE_FORCE) ? 1 : 0, &need_reboot, &matched, &installed );
+#endif
+    if (!matched) err = ERROR_NO_SUCH_DEVINST;  /* no device to install it on: it stays preinstalled */
+    else if (!installed) err = ERROR_NO_MORE_ITEMS;  /* the drivers the devices have are better matches */
+    if (reboot) *reboot = need_reboot;
+done:
+    if (err) log_event( DIFXAPI_ERROR, err, L"DriverPackageInstall returns %lu.", err );
+    else log_event( DIFXAPI_SUCCESS, 0, L"Driver package %s was installed.", inf );
+    return err;
 }
 
 DWORD WINAPI DriverPackageUninstallW(LPCWSTR inf, DWORD flags, PCINSTALLERINFO_W info, BOOL *reboot)
 {
-    FIXME("(%s, %lu, %p, %p) stub\n", wine_dbgstr_w(inf), flags, info, reboot);
+    WCHAR store[MAX_PATH], oem[MAX_PATH], *file;
+    DWORD err, others;
+
+    TRACE("(%s, %#lx, %p, %p)\n", wine_dbgstr_w(inf), flags, info, reboot);
+
     if (reboot) *reboot = FALSE;
+    if ((err = check_call( inf, flags, SUPPORTED_UNINSTALL_FLAGS, info ))) goto done;
+    log_event( DIFXAPI_INFO, 0, L"Uninstalling driver package %s.", inf );
+
+    /* "the specified INF file is in the system INF directory and the driver package
+     * is not preinstalled" */
+    if (in_system_inf_directory( inf )) { err = ERROR_CANT_ACCESS_FILE; goto done; }
+    if ((err = find_in_store( inf, store, ARRAY_SIZE(store) ))) goto done;
+
+    /* applications: the caller's association goes; others keep the package unless forced */
+    others = dissociate_application( store, info );
+    if (others && !(flags & DRIVER_PACKAGE_FORCE))
+    {
+        err = ERROR_DEPENDENT_APPLICATIONS_EXIST;
+        goto done;
+    }
+
+    /* the copy of the INF in the system INF directory, which setupapi uninstalls by name */
+    if (!SetupCopyOEMInfW( inf, NULL, SPOST_PATH, SP_COPY_NOOVERWRITE, oem, ARRAY_SIZE(oem), NULL, NULL ) &&
+        GetLastError() != ERROR_FILE_EXISTS)
+    {
+        err = GetLastError();
+        goto done;
+    }
+    if (!(file = wcsrchr( oem, '\\' ))) { err = ERROR_INSTALL_FAILURE; goto done; }
+    if (!SetupUninstallOEMInfW( file + 1, 0, NULL ))
+    {
+        err = GetLastError();
+        log_event( DIFXAPI_ERROR, err, L"The driver package %s could not be removed.", file + 1 );
