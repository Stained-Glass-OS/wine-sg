-DWORD WINAPI DriverPackagePreinstallA(LPCSTR inf, DWORD flags)
+/* the part of DIFxAPI's setupapi that the header does not declare */
+HRESULT WINAPI DriverStoreFindDriverPackageW(const WCHAR *inf_path, void *unk1, void *unk2, WORD architecture,
+        void *unk4, WCHAR *ret_path, DWORD *ret_len);
+
+#define SUPPORTED_PREINSTALL_FLAGS (DRIVER_PACKAGE_REPAIR | DRIVER_PACKAGE_SILENT | DRIVER_PACKAGE_FORCE | \
+        DRIVER_PACKAGE_ONLY_IF_DEVICE_PRESENT | DRIVER_PACKAGE_LEGACY_MODE)
+#define SUPPORTED_UNINSTALL_FLAGS (DRIVER_PACKAGE_DELETE_FILES | DRIVER_PACKAGE_FORCE | DRIVER_PACKAGE_SILENT)
