 #include <stdarg.h>
+#include <stdlib.h>
 #include "windef.h"
 #include "winbase.h"
 #include "wincrypt.h"
+#include "winreg.h"
 #include "wine/debug.h"
 #include "wine/exception.h"
 #include "crypt32_private.h"
@@ -1192,3 +1194,418 @@
         ret = FALSE;
     return ret;
 }
+
+#ifndef SG_MUTANT_NO_KEYID_PROPS
+/* Stained Glass OS (wine-sg 8214): properties attached to a key identifier rather than to a certificate
+ * (CryptSet/Get/EnumKeyIdentifierProperty(ies)), kept per user, or per machine with CRYPT_KEYID_MACHINE_FLAG,
+ * under SystemCertificates\KeyId\Keys\<key id in hex>, value "Blob": the properties serialized as a store
+ * serializes a certificate's (propID, 1, cb, data; CERT_KEY_PROV_INFO_PROP_ID in its offset form). The
+ * registry's own security decides who may write the machine ones. */
+static const WCHAR keyid_rootW[] = L"Software\\Microsoft\\SystemCertificates\\KeyId\\Keys";
+
+static BOOL keyid_name(const CRYPT_HASH_BLOB *id, WCHAR *name)
+{
+    DWORD i;
+
+    if (!id || !id->cbData || id->cbData > 64 || !id->pbData)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    for (i = 0; i < id->cbData; i++)
+        swprintf(name + 2 * i, 3, L"%02X", id->pbData[i]);
+    return TRUE;
+}
+
+static BOOL keyid_from_name(const WCHAR *name, BYTE *buf, CRYPT_HASH_BLOB *id)
+{
+    DWORD len = lstrlenW(name), i;
+
+    if (!len || len % 2 || len > 128) return FALSE;
+    for (i = 0; i < len / 2; i++)
+    {
+        WCHAR hex[3] = { name[2 * i], name[2 * i + 1], 0 }, *end;
+        buf[i] = wcstoul(hex, &end, 16);
+        if (*end) return FALSE;
+    }
+    id->cbData = len / 2;
+    id->pbData = buf;
+    return TRUE;
+}
+
+static HKEY keyid_root(DWORD flags, BOOL create)
+{
+    HKEY root = (flags & CRYPT_KEYID_MACHINE_FLAG) ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER, key;
+    LONG err;
+
+    if (create)
+        err = RegCreateKeyExW(root, keyid_rootW, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL);
+    else
+        err = RegOpenKeyExW(root, keyid_rootW, 0, KEY_READ, &key);
+    if (err)
+    {
+        SetLastError(err);
+        return NULL;
+    }
+    return key;
+}
+
+/* the serialized properties of a key identifier, NULL if it has none */
+static BYTE *keyid_read(HKEY root, const WCHAR *name, DWORD *size)
+{
+    BYTE *buf;
+    LONG err;
+
+    *size = 0;
+    if (RegGetValueW(root, name, L"Blob", RRF_RT_REG_BINARY, NULL, NULL, size) || !*size) return NULL;
+    if (!(buf = CryptMemAlloc(*size))) return NULL;
+    if ((err = RegGetValueW(root, name, L"Blob", RRF_RT_REG_BINARY, NULL, buf, size)))
+    {
+        CryptMemFree(buf);
+        return NULL;
+    }
+    return buf;
+}
+
+/* the next well-formed property of a serialized list, NULL at its end */
+static const WINE_CERT_PROP_HEADER *keyid_next(const BYTE *buf, DWORD size, DWORD *pos)
+{
+    const WINE_CERT_PROP_HEADER *hdr;
+
+    if (*pos + sizeof(*hdr) > size) return NULL;
+    hdr = (const WINE_CERT_PROP_HEADER *)(buf + *pos);
+    if (!hdr->propID || hdr->unknown != 1 || hdr->cb > size - *pos - sizeof(*hdr)) return NULL;
+    *pos += sizeof(*hdr) + hdr->cb;
+    return hdr;
+}
+
+static BOOL keyid_prov_info_valid(const BYTE *data, DWORD cb)
+{
+    const struct store_CRYPT_KEY_PROV_INFO *store = (const struct store_CRYPT_KEY_PROV_INFO *)data;
+
+    if (cb < sizeof(*store)) return FALSE;
+    if (store->cProvParam && (store->rgProvParam > cb ||
+        store->cProvParam > (cb - store->rgProvParam) / sizeof(struct store_CRYPT_KEY_PROV_PARAM)))
+        return FALSE;
+    return store->pwszContainerName < cb && store->pwszProvName < cb;
+}
+
+/* a property's value as the caller sees it: CERT_KEY_PROV_INFO_PROP_ID as a CRYPT_KEY_PROV_INFO (allocated in
+ * *alloc), the others as their bytes */
+static BOOL keyid_value(const WINE_CERT_PROP_HEADER *hdr, void **value, DWORD *cb, void **alloc)
+{
+    *alloc = NULL;
+    if (hdr->propID == CERT_KEY_PROV_INFO_PROP_ID)
+    {
+        CRYPT_KEY_PROV_INFO *info;
+
+        if (!keyid_prov_info_valid((const BYTE *)(hdr + 1), hdr->cb) ||
+            !(*cb = read_serialized_KeyProvInfoProperty((const struct store_CRYPT_KEY_PROV_INFO *)(hdr + 1), &info)))
+            return FALSE;
+        *value = *alloc = info;
+        return TRUE;
+    }
+    *value = (void *)(hdr + 1);
+    *cb = hdr->cb;
+    return TRUE;
+}
+
+/* copy a CRYPT_KEY_PROV_INFO built by read_serialized_KeyProvInfoProperty, its pointers moved along */
+static void keyid_copy_prov_info(const CRYPT_KEY_PROV_INFO *src, DWORD size, BYTE *dst)
+{
+    CRYPT_KEY_PROV_INFO *info = (CRYPT_KEY_PROV_INFO *)dst;
+    INT_PTR delta = dst - (const BYTE *)src;
+    DWORD i;
+
+    memcpy(dst, src, size);
+    if (info->pwszContainerName) info->pwszContainerName = (WCHAR *)((BYTE *)info->pwszContainerName + delta);
+    if (info->pwszProvName) info->pwszProvName = (WCHAR *)((BYTE *)info->pwszProvName + delta);
+    if (info->rgProvParam)
+    {
+        info->rgProvParam = (CRYPT_KEY_PROV_PARAM *)((BYTE *)info->rgProvParam + delta);
+        for (i = 0; i < info->cProvParam; i++)
+            if (info->rgProvParam[i].pbData) info->rgProvParam[i].pbData += delta;
+    }
+}
+
+BOOL WINAPI CryptSetKeyIdentifierProperty(const CRYPT_HASH_BLOB *pKeyIdentifier, DWORD dwPropId,
+    DWORD dwFlags, LPCWSTR pwszComputerName, void *pvReserved, const void *pvData)
+{
+    const WINE_CERT_PROP_HEADER *hdr;
+    WCHAR name[129];
+    BYTE *old, *new, *prop_data = NULL;
+    DWORD old_size, new_size = 0, prop_size = 0, pos = 0;
+    BOOL found = FALSE;
+    HKEY root;
+    LONG err;
+
+    TRACE("(%p, %lu, %#lx, %s, %p, %p)\n", pKeyIdentifier, dwPropId, dwFlags, debugstr_w(pwszComputerName),
+          pvReserved, pvData);
+
+    if (pwszComputerName)
+    {
+        FIXME("remote computer %s\n", debugstr_w(pwszComputerName));
+        SetLastError(ERROR_NOT_SUPPORTED);
+        return FALSE;
+    }
+    if (!keyid_name(pKeyIdentifier, name)) return FALSE;
+    if (!(root = keyid_root(dwFlags, TRUE))) return FALSE;
+
+    if (dwFlags & CRYPT_KEYID_DELETE_FLAG)
+    {
+        err = RegDeleteTreeW(root, name);
+        RegCloseKey(root);
+        if (err)
+        {
+            SetLastError(err == ERROR_FILE_NOT_FOUND ? CRYPT_E_NOT_FOUND : err);
+            return FALSE;
+        }
+        return TRUE;
+    }
+    if (!dwPropId)
+    {
+        RegCloseKey(root);
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+
+    old = keyid_read(root, name, &old_size);
+    while ((hdr = keyid_next(old, old_size, &pos))) if (hdr->propID == dwPropId) found = TRUE;
+    if (found && pvData && (dwFlags & CRYPT_KEYID_SET_NEW_FLAG))
+    {
+        CryptMemFree(old);
+        RegCloseKey(root);
+        SetLastError(CRYPT_E_EXISTS);
+        return FALSE;
+    }
+
+    if (pvData)
+    {
+        if (dwPropId == CERT_KEY_PROV_INFO_PROP_ID)
+        {
+            struct store_CRYPT_KEY_PROV_INFO *store;
+            if (!(prop_size = serialize_KeyProvInfoProperty(pvData, &store)))
+            {
+                CryptMemFree(old);
+                RegCloseKey(root);
+                SetLastError(ERROR_OUTOFMEMORY);
+                return FALSE;
+            }
+            prop_data = (BYTE *)store;
+        }
+        else
+        {
+            const CRYPT_DATA_BLOB *blob = pvData;
+            prop_size = blob->cbData;
+            if (!(prop_data = CryptMemAlloc(prop_size ? prop_size : 1)))
+            {
+                CryptMemFree(old);
+                RegCloseKey(root);
+                SetLastError(ERROR_OUTOFMEMORY);
+                return FALSE;
+            }
+            if (prop_size) memcpy(prop_data, blob->pbData, prop_size);
+        }
+    }
+
+    /* the other properties, then the new value */
+    if (!(new = CryptMemAlloc(old_size + sizeof(WINE_CERT_PROP_HEADER) + prop_size)))
+    {
+        CryptMemFree(old);
+        CryptMemFree(prop_data);
+        RegCloseKey(root);
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    pos = 0;
+    while ((hdr = keyid_next(old, old_size, &pos)))
+    {
+        if (hdr->propID == dwPropId) continue;
+        memcpy(new + new_size, hdr, sizeof(*hdr) + hdr->cb);
+        new_size += sizeof(*hdr) + hdr->cb;
+    }
+    if (pvData)
+    {
+        WINE_CERT_PROP_HEADER *nh = (WINE_CERT_PROP_HEADER *)(new + new_size);
+        nh->propID = dwPropId;
+        nh->unknown = 1;
+        nh->cb = prop_size;
+        memcpy(nh + 1, prop_data, prop_size);
+        new_size += sizeof(*nh) + prop_size;
+    }
+
+    err = 0;
+    if (new_size)
+        err = RegSetKeyValueW(root, name, L"Blob", REG_BINARY, new, new_size);
+    else  /* no properties left: the key identifier goes */
+        RegDeleteTreeW(root, name);
+    CryptMemFree(old);
+    CryptMemFree(new);
+    CryptMemFree(prop_data);
+    RegCloseKey(root);
+    if (err)
+    {
+        SetLastError(err);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+BOOL WINAPI CryptGetKeyIdentifierProperty(const CRYPT_HASH_BLOB *pKeyIdentifier, DWORD dwPropId,
+    DWORD dwFlags, LPCWSTR pwszComputerName, void *pvReserved, void *pvData, DWORD *pcbData)
+{
+    const WINE_CERT_PROP_HEADER *hdr;
+    WCHAR name[129];
+    BYTE *blob, *out;
+    DWORD size, pos = 0, cb;
+    void *value, *alloc;
+    BOOL ret = FALSE;
+    HKEY root;
+
+    TRACE("(%p, %lu, %#lx, %s, %p, %p, %p)\n", pKeyIdentifier, dwPropId, dwFlags, debugstr_w(pwszComputerName),
+          pvReserved, pvData, pcbData);
+
+    if (pwszComputerName)
+    {
+        FIXME("remote computer %s\n", debugstr_w(pwszComputerName));
+        SetLastError(ERROR_NOT_SUPPORTED);
+        return FALSE;
+    }
+    if (!pcbData)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!keyid_name(pKeyIdentifier, name)) return FALSE;
+    if (!(root = keyid_root(dwFlags, FALSE)))
+    {
+        SetLastError(CRYPT_E_NOT_FOUND);
+        return FALSE;
+    }
+    blob = keyid_read(root, name, &size);
+    RegCloseKey(root);
+    while ((hdr = keyid_next(blob, size, &pos)) && hdr->propID != dwPropId) ;
+    if (!hdr || !keyid_value(hdr, &value, &cb, &alloc))
+    {
+        CryptMemFree(blob);
+        SetLastError(CRYPT_E_NOT_FOUND);
+        return FALSE;
+    }
+
+    if (dwFlags & CRYPT_KEYID_ALLOC_FLAG)
+    {
+        /* pvData receives a LocalAlloc'ed copy */
+        if (!pvData) SetLastError(E_INVALIDARG);
+        else if (!(out = LocalAlloc(LMEM_FIXED, cb ? cb : 1))) SetLastError(ERROR_OUTOFMEMORY);
+        else
+        {
+            if (alloc) keyid_copy_prov_info(alloc, cb, out);
+            else memcpy(out, value, cb);
+            *(void **)pvData = out;
+            ret = TRUE;
+        }
+    }
+    else if (!pvData)
+        ret = TRUE;
+    else if (*pcbData < cb)
+        SetLastError(ERROR_MORE_DATA);
+    else
+    {
+        if (alloc) keyid_copy_prov_info(alloc, cb, pvData);
+        else memcpy(pvData, value, cb);
+        ret = TRUE;
+    }
+    *pcbData = cb;
+    CryptMemFree(alloc);
+    CryptMemFree(blob);
+    return ret;
+}
+
+/* call back for one key identifier with its properties (only dwPropId's when it is set) */
+static BOOL keyid_enum_one(HKEY root, const WCHAR *name, const CRYPT_HASH_BLOB *id, DWORD prop_id, DWORD flags,
+                           void *arg, PFN_CRYPT_ENUM_KEYID_PROP callback, BOOL *stop)
+{
+    const WINE_CERT_PROP_HEADER *hdr;
+    DWORD size, pos = 0, count = 0, i;
+    DWORD ids[64], sizes[64];
+    void *values[64], *allocs[64];
+    BYTE *blob;
+    BOOL ret = TRUE;
+
+    if (!(blob = keyid_read(root, name, &size))) return TRUE;
+    while (count < ARRAY_SIZE(ids) && (hdr = keyid_next(blob, size, &pos)))
+    {
+        if (prop_id && hdr->propID != prop_id) continue;
+        if (!keyid_value(hdr, &values[count], &sizes[count], &allocs[count])) continue;
+        ids[count++] = hdr->propID;
+    }
+    if (count || !prop_id)
+    {
+        if (!callback(id, flags, NULL, arg, count, ids, values, sizes))
+        {
+            *stop = TRUE;
+            ret = FALSE;
+        }
+    }
+    for (i = 0; i < count; i++) CryptMemFree(allocs[i]);
+    CryptMemFree(blob);
+    return ret;
+}
+
+BOOL WINAPI CryptEnumKeyIdentifierProperties(const CRYPT_HASH_BLOB *pKeyIdentifier, DWORD dwPropId,
+    DWORD dwFlags, LPCWSTR pwszComputerName, void *pvReserved, void *pvArg, PFN_CRYPT_ENUM_KEYID_PROP pfnEnum)
+{
+    WCHAR name[129];
+    BYTE buf[64];
+    CRYPT_HASH_BLOB id;
+    BOOL stop = FALSE, ret = TRUE;
+    DWORD i = 0, len;
+    HKEY root;
+
+    TRACE("(%p, %lu, %#lx, %s, %p, %p, %p)\n", pKeyIdentifier, dwPropId, dwFlags, debugstr_w(pwszComputerName),
+          pvReserved, pvArg, pfnEnum);
+
+    if (pwszComputerName)
+    {
+        FIXME("remote computer %s\n", debugstr_w(pwszComputerName));
+        SetLastError(ERROR_NOT_SUPPORTED);
+        return FALSE;
+    }
+    if (!pfnEnum)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!(root = keyid_root(dwFlags, FALSE))) return TRUE;  /* none yet */
+    if (pKeyIdentifier)
+    {
+        if (keyid_name(pKeyIdentifier, name))
+            ret = keyid_enum_one(root, name, pKeyIdentifier, dwPropId, dwFlags, pvArg, pfnEnum, &stop);
+        else ret = FALSE;
+    }
+    else
+    {
+        while (!stop && (len = ARRAY_SIZE(name), !RegEnumKeyExW(root, i++, name, &len, NULL, NULL, NULL, NULL)))
+        {
+            if (!keyid_from_name(name, buf, &id)) continue;
+            if (!keyid_enum_one(root, name, &id, dwPropId, dwFlags, pvArg, pfnEnum, &stop)) ret = FALSE;
+        }
+    }
+    RegCloseKey(root);
+    return ret;
+}
+#else
+BOOL WINAPI CryptGetKeyIdentifierProperty(const CRYPT_HASH_BLOB *pKeyIdentifier, DWORD dwPropId,
+    DWORD dwFlags, LPCWSTR pwszComputerName, void *pvReserved, void *pvData, DWORD *pcbData)
+{
+    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    return FALSE;
+}
+
+BOOL WINAPI CryptEnumKeyIdentifierProperties(const CRYPT_HASH_BLOB *pKeyIdentifier, DWORD dwPropId,
+    DWORD dwFlags, LPCWSTR pwszComputerName, void *pvReserved, void *pvArg, PFN_CRYPT_ENUM_KEYID_PROP pfnEnum)
+{
+    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    return FALSE;
+}
+#endif
--- a/include/wincrypt.h
+++ b/include/wincrypt.h
@@ -2331,6 +2331,15 @@
 #define CERT_STORE_MANIFOLD_FLAG                    0x00000100
 #define CERT_STORE_ENUM_ARCHIVED_FLAG               0x00000200
 #define CERT_STORE_UPDATE_KEYID_FLAG                0x00000400
+
+/* CryptSetKeyIdentifierProperty and friends */
+#define CRYPT_KEYID_DELETE_FLAG                     0x00000010
+#define CRYPT_KEYID_MACHINE_FLAG                    0x00000020
+#define CRYPT_KEYID_SET_NEW_FLAG                    0x00002000
+#define CRYPT_KEYID_ALLOC_FLAG                      0x00008000
+
+typedef BOOL (WINAPI *PFN_CRYPT_ENUM_KEYID_PROP)(const CRYPT_HASH_BLOB *pKeyIdentifier, DWORD dwFlags,
+ void *pvReserved, void *pvArg, DWORD cProp, DWORD *rgdwPropId, void **rgpvData, DWORD *rgcbData);
 #define CERT_STORE_BACKUP_RESTORE_FLAG              0x00000800
 #define CERT_STORE_MAXIMUM_ALLOWED_FLAG             0x00001000
 #define CERT_STORE_CREATE_NEW_FLAG                  0x00002000
@@ -4436,6 +4445,12 @@
  DWORD dwFormatStrType, void *pFormatStruct, LPCSTR lpszStructType,
  const BYTE *pbEncoded, DWORD cbEncoded, void *pbFormat, DWORD *pcbFormat);
 
+WINCRYPT32API BOOL WINAPI CryptGetKeyIdentifierProperty(const CRYPT_HASH_BLOB *pKeyIdentifier, DWORD dwPropId,
+ DWORD dwFlags, LPCWSTR pwszComputerName, void *pvReserved, void *pvData, DWORD *pcbData);
+WINCRYPT32API BOOL WINAPI CryptSetKeyIdentifierProperty(const CRYPT_HASH_BLOB *pKeyIdentifier, DWORD dwPropId,
+ DWORD dwFlags, LPCWSTR pwszComputerName, void *pvReserved, const void *pvData);
+WINCRYPT32API BOOL WINAPI CryptEnumKeyIdentifierProperties(const CRYPT_HASH_BLOB *pKeyIdentifier, DWORD dwPropId,
+ DWORD dwFlags, LPCWSTR pwszComputerName, void *pvReserved, void *pvArg, PFN_CRYPT_ENUM_KEYID_PROP pfnEnum);
 WINCRYPT32API BOOL WINAPI CryptHashCertificate(HCRYPTPROV_LEGACY hCryptProv, ALG_ID Algid,
  DWORD dwFlags, const BYTE *pbEncoded, DWORD cbEncoded, BYTE *pbComputedHash,
  DWORD *pcbComputedHash);
