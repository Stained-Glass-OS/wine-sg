From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wineboot: nothing of the Run keys or the Startup folder starts on the sign-in screen

The sign-in screen runs Wine as its own account (sggreet), and wineboot ran
the machine's Run keys there like in a user's session: Everything.exe
-startup started under sggreet on the sign-in screen (David, 2026-10-18), and
the machine's RunOnce entries were used up before anyone signed in.
sg-login-ui sets SG_SIGN_IN_SCREEN; then wineboot starts none of HKLM/HKCU
Run, HKLM RunOnce or the Startup folder. Gate: test-startup.
---
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1973,6 +1973,7 @@
 {
     /* First, set the current directory to SystemRoot */
     int i, j;
+    BOOL sign_in_screen;
     BOOL end_session, force, init, kill, restart, shutdown, update, logoff = FALSE;
     HANDLE event;
     OBJECT_ATTRIBUTES attr;
@@ -2092,9 +2093,18 @@
 
     create_volatile_environment_registry_key();
 
-    ProcessRunKeys( HKEY_LOCAL_MACHINE, L"RunOnce", TRUE, TRUE );
+    /* Stained Glass: the sign-in screen (sg-login-ui, account sggreet) is
+     * no user's session: nothing of the Run keys or the Startup folder starts
+     * there, and the machine's RunOnce entries wait for the first sign-in. */
+#ifdef SG_MUTANT_GREETER_STARTUP
+    sign_in_screen = FALSE;
+#else
+    sign_in_screen = GetEnvironmentVariableW( L"SG_SIGN_IN_SCREEN", NULL, 0 ) != 0;
+#endif
+    if (!sign_in_screen)
+        ProcessRunKeys( HKEY_LOCAL_MACHINE, L"RunOnce", TRUE, TRUE );
 
-    if (!init && !restart)
+    if (!init && !restart && !sign_in_screen)
     {
         ProcessRunKeys( HKEY_LOCAL_MACHINE, L"Run", FALSE, FALSE );
         ProcessRunKeys( HKEY_CURRENT_USER, L"Run", FALSE, FALSE );
