+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * Windows 10 and later carry ICU in system32; programs built against the
+ * system ICU (Qt 6's text codecs, for one) import icuuc.dll by its
+ * unversioned C names.  This is our own implementation of the documented
+ * ICU converter API over the code pages the system already has: the
+ * Unicode encodings directly, everything else through
+ * MultiByteToWideChar/WideCharToMultiByte one character at a time, so that
+ * the documented error callbacks see each bad sequence where it is.
+ */
+
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(icu);
+
+/* ICU's C types and constants, as its documentation gives them */
+typedef int8_t UBool;
+typedef WCHAR UChar;
+typedef int32_t UChar32;
+typedef int UErrorCode;
+
+#define U_USING_DEFAULT_WARNING   (-127)
+#define U_AMBIGUOUS_ALIAS_WARNING (-122)
+#define U_ZERO_ERROR              0
+#define U_ILLEGAL_ARGUMENT_ERROR  1
+#define U_FILE_ACCESS_ERROR       4
+#define U_MEMORY_ALLOCATION_ERROR 7
+#define U_INDEX_OUTOFBOUNDS_ERROR 8
+#define U_INVALID_CHAR_FOUND      10
+#define U_TRUNCATED_CHAR_FOUND    11
+#define U_ILLEGAL_CHAR_FOUND      12
+#define U_BUFFER_OVERFLOW_ERROR   15
+#define U_FAILURE(x) ((x) > U_ZERO_ERROR)
+
+typedef enum
+{
+    UCNV_UNASSIGNED = 0,
+    UCNV_ILLEGAL = 1,
+    UCNV_IRREGULAR = 2,
+    UCNV_RESET = 3,
+    UCNV_CLOSE = 4,
+    UCNV_CLONE = 5
+} UConverterCallbackReason;
+
+typedef struct UConverter UConverter;
+
+typedef struct
+{
+    uint16_t size;
+    UBool flush;
+    UConverter *converter;
+    const UChar *source;
+    const UChar *sourceLimit;
+    char *target;
+    const char *targetLimit;
+    int32_t *offsets;
+} UConverterFromUnicodeArgs;
+
+typedef struct
+{
+    uint16_t size;
+    UBool flush;
+    UConverter *converter;
+    const char *source;
+    const char *sourceLimit;
+    UChar *target;
+    const UChar *targetLimit;
+    int32_t *offsets;
+} UConverterToUnicodeArgs;
+
+typedef void (__cdecl *UConverterToUCallback)( const void *context, UConverterToUnicodeArgs *args,
+                                               const char *units, int32_t length,
+                                               UConverterCallbackReason reason, UErrorCode *err );
+typedef void (__cdecl *UConverterFromUCallback)( const void *context, UConverterFromUnicodeArgs *args,
+                                                 const UChar *units, int32_t length, UChar32 cp,
+                                                 UConverterCallbackReason reason, UErrorCode *err );
+
+#define SUB_STOP_ON_ILLEGAL "i"
+
+/* the converters: an ICU-style canonical name, the IANA/MIME name, the code page and aliases */
+enum kind { KIND_CODEPAGE, KIND_UTF8, KIND_UTF16LE, KIND_UTF16BE, KIND_UTF16, KIND_UTF32LE, KIND_UTF32BE, KIND_UTF32 };
+
+struct charset
+{
+    const char *name;      /* what ucnv_getName returns */
+    const char *iana;      /* ucnv_getStandardName(name, "IANA"/"MIME") */
+    BOOL mime;
+    enum kind kind;
+    UINT codepage;
+    const char *aliases[8];
+};
+
+static const struct charset charsets[] =
+{
+    { "UTF-8", "UTF-8", TRUE, KIND_UTF8, CP_UTF8, { "utf8", "cp1208", "ibm-1208", "unicode-1-1-utf-8" } },
+    { "UTF-16", "UTF-16", TRUE, KIND_UTF16, 0, { "utf16", "ucs-2", "unicode", "csunicode", "iso-10646-ucs-2" } },
+    { "UTF-16LE", "UTF-16LE", TRUE, KIND_UTF16LE, 1200, { "utf16le", "unicodelittle", "x-utf-16le", "cp1200" } },
+    { "UTF-16BE", "UTF-16BE", TRUE, KIND_UTF16BE, 1201, { "utf16be", "unicodebig", "x-utf-16be", "cp1201" } },
+    { "UTF-32", "UTF-32", TRUE, KIND_UTF32, 0, { "utf32", "ucs-4", "iso-10646-ucs-4", "csucs4" } },
+    { "UTF-32LE", "UTF-32LE", TRUE, KIND_UTF32LE, 12000, { "utf32le", "ucs-4le", "cp12000" } },
+    { "UTF-32BE", "UTF-32BE", TRUE, KIND_UTF32BE, 12001, { "utf32be", "ucs-4be", "cp12001" } },
+    { "US-ASCII", "US-ASCII", TRUE, KIND_CODEPAGE, 20127, { "ascii", "ansi_x3.4-1968", "iso646-us", "us", "csascii", "cp367", "ibm367" } },
+    { "ISO-8859-1", "ISO-8859-1", TRUE, KIND_CODEPAGE, 28591, { "latin1", "l1", "iso_8859-1", "cp819", "ibm819", "csisolatin1", "8859_1" } },
+    { "ISO-8859-2", "ISO-8859-2", TRUE, KIND_CODEPAGE, 28592, { "latin2", "l2", "iso_8859-2", "csisolatin2", "8859_2", "cp912" } },
+    { "ISO-8859-3", "ISO-8859-3", TRUE, KIND_CODEPAGE, 28593, { "latin3", "l3", "iso_8859-3", "csisolatin3", "8859_3" } },
+    { "ISO-8859-4", "ISO-8859-4", TRUE, KIND_CODEPAGE, 28594, { "latin4", "l4", "iso_8859-4", "csisolatin4", "8859_4" } },
+    { "ISO-8859-5", "ISO-8859-5", TRUE, KIND_CODEPAGE, 28595, { "cyrillic", "iso_8859-5", "csisolatincyrillic", "8859_5" } },
+    { "ISO-8859-6", "ISO-8859-6", TRUE, KIND_CODEPAGE, 28596, { "arabic", "iso_8859-6", "csisolatinarabic", "8859_6" } },
+    { "ISO-8859-7", "ISO-8859-7", TRUE, KIND_CODEPAGE, 28597, { "greek", "greek8", "iso_8859-7", "csisolatingreek", "8859_7" } },
+    { "ISO-8859-8", "ISO-8859-8", TRUE, KIND_CODEPAGE, 28598, { "hebrew", "iso_8859-8", "csisolatinhebrew", "8859_8" } },
+    { "ISO-8859-9", "ISO-8859-9", TRUE, KIND_CODEPAGE, 28599, { "latin5", "l5", "iso_8859-9", "csisolatin5", "8859_9" } },
+    { "ISO-8859-13", "ISO-8859-13", TRUE, KIND_CODEPAGE, 28603, { "latin7", "l7", "8859_13" } },
+    { "ISO-8859-15", "ISO-8859-15", TRUE, KIND_CODEPAGE, 28605, { "latin9", "latin-9", "l9", "iso_8859-15", "8859_15", "csisolatin9" } },
+    { "windows-874", "windows-874", FALSE, KIND_CODEPAGE, 874, { "cp874", "tis-620", "tis620", "ms874" } },
+    { "windows-1250", "windows-1250", TRUE, KIND_CODEPAGE, 1250, { "cp1250" } },
+    { "windows-1251", "windows-1251", TRUE, KIND_CODEPAGE, 1251, { "cp1251", "ansi1251" } },
+    { "windows-1252", "windows-1252", TRUE, KIND_CODEPAGE, 1252, { "cp1252", "ibm-5348" } },
+    { "windows-1253", "windows-1253", TRUE, KIND_CODEPAGE, 1253, { "cp1253" } },
+    { "windows-1254", "windows-1254", TRUE, KIND_CODEPAGE, 1254, { "cp1254" } },
+    { "windows-1255", "windows-1255", TRUE, KIND_CODEPAGE, 1255, { "cp1255" } },
+    { "windows-1256", "windows-1256", TRUE, KIND_CODEPAGE, 1256, { "cp1256" } },
+    { "windows-1257", "windows-1257", TRUE, KIND_CODEPAGE, 1257, { "cp1257" } },
+    { "windows-1258", "windows-1258", TRUE, KIND_CODEPAGE, 1258, { "cp1258" } },
+    { "KOI8-R", "KOI8-R", TRUE, KIND_CODEPAGE, 20866, { "koi8", "cskoi8r", "cp878" } },
+    { "KOI8-U", "KOI8-U", TRUE, KIND_CODEPAGE, 21866, { "koi8u" } },
+    { "IBM437", "IBM437", FALSE, KIND_CODEPAGE, 437, { "cp437", "437", "cspc8codepage437" } },
+    { "IBM850", "IBM850", FALSE, KIND_CODEPAGE, 850, { "cp850", "850", "cspc850multilingual" } },
+    { "IBM852", "IBM852", FALSE, KIND_CODEPAGE, 852, { "cp852", "852", "cspcp852" } },
+    { "IBM866", "IBM866", FALSE, KIND_CODEPAGE, 866, { "cp866", "866", "csibm866" } },
+    { "macintosh", "macintosh", FALSE, KIND_CODEPAGE, 10000, { "mac", "macroman", "csmacintosh", "x-mac-roman" } },
+    { "IBM037", "IBM037", FALSE, KIND_CODEPAGE, 37, { "cp037", "ebcdic-cp-us", "ebcdic-cp-ca", "csibm037" } },
+    { "Shift_JIS", "Shift_JIS", TRUE, KIND_CODEPAGE, 932, { "sjis", "ms_kanji", "csshiftjis", "windows-31j", "cp932", "x-sjis", "ms932" } },
+    { "EUC-JP", "EUC-JP", TRUE, KIND_CODEPAGE, 20932, { "eucjp", "x-euc-jp", "cseucpkdfmtjapanese" } },
+    { "GBK", "GBK", FALSE, KIND_CODEPAGE, 936, { "cp936", "ms936", "windows-936", "gb2312", "csgb2312", "euc-cn" } },
+    { "GB18030", "GB18030", FALSE, KIND_CODEPAGE, 54936, { "windows-54936", "ibm-1392" } },
+    { "Big5", "Big5", TRUE, KIND_CODEPAGE, 950, { "csbig5", "windows-950", "cp950", "x-big5" } },
+    { "EUC-KR", "EUC-KR", TRUE, KIND_CODEPAGE, 949, { "euckr", "cseuckr", "windows-949", "cp949", "ks_c_5601-1987", "korean" } },
+    { "UTF-7", "UTF-7", TRUE, KIND_CODEPAGE, 65000, { "utf7", "unicode-1-1-utf-7", "windows-65000" } },
+};
+
+/* ICU compares converter names ignoring case and anything but letters and digits */
+static BOOL names_match( const char *a, const char *b )
+{
+    for (;;)
+    {
+        while (*a && !isalnum( (unsigned char)*a )) a++;
+        while (*b && !isalnum( (unsigned char)*b )) b++;
+        if (!*a || !*b) return !*a && !*b;
+        if (tolower( (unsigned char)*a ) != tolower( (unsigned char)*b )) return FALSE;
+        a++;
+        b++;
+    }
+}
+
+static const struct charset *find_charset( const char *name )
+{
+    unsigned int i, j;
+
+    for (i = 0; i < ARRAY_SIZE(charsets); i++)
+    {
+        if (names_match( name, charsets[i].name ) || names_match( name, charsets[i].iana )) return &charsets[i];
+        for (j = 0; j < ARRAY_SIZE(charsets[i].aliases) && charsets[i].aliases[j]; j++)
+            if (names_match( name, charsets[i].aliases[j] )) return &charsets[i];
+    }
+    /* "windows-NNNN", "cpNNNN", "ibm-NNNN" for any code page the system has */
+    return NULL;
+}
+
+struct UConverter
+{
+    const struct charset *charset;
+    UINT codepage;
+    int max_char;
+    CPINFOEXW info;
+    UConverterToUCallback to_cb;
+    const void *to_ctx;
+    UConverterFromUCallback from_cb;
+    const void *from_ctx;
+    /* to Unicode: an incomplete character's bytes, and output that did not fit */
+    unsigned char pending[8];
+    int pending_len;
+    UChar to_overflow[32];
+    int to_overflow_len;
+    BOOL bom_seen;      /* UTF-16/UTF-32: the byte order was settled */
+    BOOL big_endian;
+    /* from Unicode: a lead surrogate, and output that did not fit */
+    UChar lead;
+    char from_overflow[64];
+    int from_overflow_len;
+    BOOL bom_written;
+    char name[64];      /* for a code page that is not in the table */
+};
+
+void __cdecl UCNV_TO_U_CALLBACK_SUBSTITUTE( const void *context, UConverterToUnicodeArgs *args, const char *units,
+                                            int32_t length, UConverterCallbackReason reason, UErrorCode *err );
+void __cdecl UCNV_FROM_U_CALLBACK_SUBSTITUTE( const void *context, UConverterFromUnicodeArgs *args,
+                                              const UChar *units, int32_t length, UChar32 cp,
+                                              UConverterCallbackReason reason, UErrorCode *err );
+void __cdecl ucnv_cbToUWriteUChars( UConverterToUnicodeArgs *args, const UChar *source, int32_t length,
+                                    int32_t offset_index, UErrorCode *err );
+void __cdecl ucnv_cbFromUWriteUChars( UConverterFromUnicodeArgs *args, const UChar **source,
+                                      const UChar *source_limit, int32_t offset_index, UErrorCode *err );
+
+/***********************************************************************
+ *		ucnv_open (icuuc.@)
+ */
+UConverter * __cdecl ucnv_open( const char *name, UErrorCode *err )
+{
+    const struct charset *charset = NULL;
+    UConverter *conv;
+    UINT codepage = 0;
+    const char *p;
+
+    TRACE( "%s %p\n", debugstr_a(name), err );
+
+    if (!err || U_FAILURE(*err)) return NULL;
+    if (!name || !*name) charset = &charsets[0];  /* the default: Windows' ICU is UTF-8 */
+    else if (!(charset = find_charset( name )))
+    {
+        /* windows-NNN / cpNNN / ibm-NNN with a code page this system has */
+        for (p = name; *p && !isdigit( (unsigned char)*p ); p++) ;
+        if (*p && (!_strnicmp( name, "windows", 7 ) || !_strnicmp( name, "cp", 2 ) || !_strnicmp( name, "ibm", 3 )))
+            codepage = atoi( p );
+        if (!codepage || !IsValidCodePage( codepage ))
+        {
+            WARN( "no converter %s\n", debugstr_a(name) );
+            *err = U_FILE_ACCESS_ERROR;
+            return NULL;
+        }
+    }
+    if (charset && charset->kind == KIND_CODEPAGE && !IsValidCodePage( charset->codepage ))
+    {
+        WARN( "%s: code page %u not available\n", debugstr_a(name), charset->codepage );
+        *err = U_FILE_ACCESS_ERROR;
+        return NULL;
+    }
+    if (!(conv = calloc( 1, sizeof(*conv) )))
+    {
+        *err = U_MEMORY_ALLOCATION_ERROR;
+        return NULL;
+    }
+    conv->charset = charset;
+    conv->codepage = charset ? charset->codepage : codepage;
+    if (!charset) snprintf( conv->name, sizeof(conv->name), "windows-%u", codepage );
+    switch (charset ? charset->kind : KIND_CODEPAGE)
+    {
+    case KIND_UTF8: conv->max_char = 3; break;
+    case KIND_UTF16: case KIND_UTF16LE: case KIND_UTF16BE: conv->max_char = 2; break;
+    case KIND_UTF32: case KIND_UTF32LE: case KIND_UTF32BE: conv->max_char = 4; break;
+    default:
+        GetCPInfoExW( conv->codepage, 0, &conv->info );
+        conv->max_char = conv->codepage == 65000 ? 5 : max( 1, conv->info.MaxCharSize );
+        break;
+    }
+    conv->to_cb = UCNV_TO_U_CALLBACK_SUBSTITUTE;
+    conv->from_cb = UCNV_FROM_U_CALLBACK_SUBSTITUTE;
+    return conv;
+}
+
+static void reset_to( UConverter *conv )
+{
+    conv->pending_len = 0;
+    conv->to_overflow_len = 0;
+    conv->bom_seen = FALSE;
+    conv->big_endian = FALSE;
+}
+
+static void reset_from( UConverter *conv )
+{
+    conv->lead = 0;
+    conv->from_overflow_len = 0;
+    conv->bom_written = FALSE;
+}
+
+static void call_reset_callbacks( UConverter *conv, UConverterCallbackReason reason )
+{
+    UConverterToUnicodeArgs to = { sizeof(to), TRUE, conv };
+    UConverterFromUnicodeArgs from = { sizeof(from), TRUE, conv };
+    UErrorCode err = U_ZERO_ERROR;
+
+    if (conv->to_cb) conv->to_cb( conv->to_ctx, &to, NULL, 0, reason, &err );
+    err = U_ZERO_ERROR;
+    if (conv->from_cb) conv->from_cb( conv->from_ctx, &from, NULL, 0, 0, reason, &err );
+}
+
+/***********************************************************************
+ *		ucnv_close (icuuc.@)
+ */
+void __cdecl ucnv_close( UConverter *conv )
+{
+    TRACE( "%p\n", conv );
+    if (!conv) return;
+    call_reset_callbacks( conv, UCNV_CLOSE );
+    free( conv );
+}
+
+/***********************************************************************
+ *		ucnv_reset (icuuc.@)
+ */
+void __cdecl ucnv_reset( UConverter *conv )
+{
+    TRACE( "%p\n", conv );
+    if (!conv) return;
+    call_reset_callbacks( conv, UCNV_RESET );
+    reset_to( conv );
+    reset_from( conv );
+}
+
+/***********************************************************************
+ *		ucnv_getMaxCharSize (icuuc.@)
+ */
+int8_t __cdecl ucnv_getMaxCharSize( const UConverter *conv )
+{
+    return conv ? conv->max_char : 0;
+}
+
+/***********************************************************************
+ *		ucnv_getName (icuuc.@)
+ */
+const char * __cdecl ucnv_getName( const UConverter *conv, UErrorCode *err )
+{
+    if (!err || U_FAILURE(*err)) return NULL;
+    if (!conv)
+    {
+        *err = U_ILLEGAL_ARGUMENT_ERROR;
+        return NULL;
+    }
+    return conv->charset ? conv->charset->name : conv->name;
+}
+
+/***********************************************************************
+ *		ucnv_getStandardName (icuuc.@)
+ */
+const char * __cdecl ucnv_getStandardName( const char *name, const char *standard, UErrorCode *err )
+{
+    const struct charset *charset;
+
+    TRACE( "%s %s\n", debugstr_a(name), debugstr_a(standard) );
+
+    if (!err || U_FAILURE(*err)) return NULL;
+    if (!name || !standard)
+    {
+        *err = U_ILLEGAL_ARGUMENT_ERROR;
+        return NULL;
+    }
+    if (!(charset = find_charset( name ))) return NULL;
+    if (!_stricmp( standard, "MIME" )) return charset->mime ? charset->iana : NULL;
+    if (!_stricmp( standard, "IANA" )) return charset->iana;
+    if (!_stricmp( standard, "WINDOWS" )) return charset->iana;
+    return NULL;
+}
+
+/***********************************************************************
+ *		ucnv_countAvailable (icuuc.@)
+ */
+int32_t __cdecl ucnv_countAvailable(void)
+{
+    unsigned int i, n = 0;
+    for (i = 0; i < ARRAY_SIZE(charsets); i++)
+        if (charsets[i].kind != KIND_CODEPAGE || IsValidCodePage( charsets[i].codepage )) n++;
+    return n;
+}
+
+/***********************************************************************
+ *		ucnv_getAvailableName (icuuc.@)
+ */
+const char * __cdecl ucnv_getAvailableName( int32_t index )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(charsets); i++)
+    {
+        if (charsets[i].kind == KIND_CODEPAGE && !IsValidCodePage( charsets[i].codepage )) continue;
+        if (!index--) return charsets[i].name;
+    }
+    return NULL;
+}
+
+/***********************************************************************
+ *		ucnv_getToUCallBack (icuuc.@)
+ */
+void __cdecl ucnv_getToUCallBack( const UConverter *conv, UConverterToUCallback *action, const void **context )
+{
+    if (!conv) return;
+    if (action) *action = conv->to_cb;
+    if (context) *context = conv->to_ctx;
+}
+
+/***********************************************************************
+ *		ucnv_getFromUCallBack (icuuc.@)
+ */
+void __cdecl ucnv_getFromUCallBack( const UConverter *conv, UConverterFromUCallback *action, const void **context )
+{
+    if (!conv) return;
+    if (action) *action = conv->from_cb;
+    if (context) *context = conv->from_ctx;
+}
+
+/***********************************************************************
+ *		ucnv_setToUCallBack (icuuc.@)
+ */
+void __cdecl ucnv_setToUCallBack( UConverter *conv, UConverterToUCallback action, const void *context,
+                                  UConverterToUCallback *old_action, const void **old_context, UErrorCode *err )
+{
+    if (!err || U_FAILURE(*err)) return;
+    if (!conv)
+    {
+        *err = U_ILLEGAL_ARGUMENT_ERROR;
+        return;
+    }
+    if (old_action) *old_action = conv->to_cb;
+    if (old_context) *old_context = conv->to_ctx;
+    conv->to_cb = action;
+    conv->to_ctx = context;
+}
+
+/***********************************************************************
+ *		ucnv_setFromUCallBack (icuuc.@)
+ */
+void __cdecl ucnv_setFromUCallBack( UConverter *conv, UConverterFromUCallback action, const void *context,
+                                    UConverterFromUCallback *old_action, const void **old_context, UErrorCode *err )
+{
+    if (!err || U_FAILURE(*err)) return;
+    if (!conv)
+    {
+        *err = U_ILLEGAL_ARGUMENT_ERROR;
+        return;
+    }
+    if (old_action) *old_action = conv->from_cb;
+    if (old_context) *old_context = conv->from_ctx;
+    conv->from_cb = action;
+    conv->from_ctx = context;
+}
+
+/***********************************************************************
+ * To Unicode
+ */
+
+/* write UChars to the target, the rest to the converter's overflow buffer */
+static void put_uchars( UConverterToUnicodeArgs *args, const UChar *chars, int len, int32_t offset, UErrorCode *err )
+{
+    UConverter *conv = args->converter;
+    int i;
+
+    for (i = 0; i < len; i++)
+    {
+        if (args->target < args->targetLimit)
+        {
+            *args->target++ = chars[i];
+            if (args->offsets) *args->offsets++ = offset;
+        }
+        else if (conv->to_overflow_len < ARRAY_SIZE(conv->to_overflow))
+        {
+            conv->to_overflow[conv->to_overflow_len++] = chars[i];
+            *err = U_BUFFER_OVERFLOW_ERROR;
+        }
+        else *err = U_BUFFER_OVERFLOW_ERROR;
+    }
+}
+
+/* decode one character at units[0..]; returns the number of units it takes (0: needs more input,
+ * < 0: -n illegal units), the UTF-16 result in out/out_len */
+static int decode_one( UConverter *conv, const unsigned char *units, int avail, UChar *out, int *out_len,
+                       UConverterCallbackReason *reason )
+{
+    enum kind kind = conv->charset ? conv->charset->kind : KIND_CODEPAGE;
+    unsigned int c, i, need;
+
+    *reason = UCNV_ILLEGAL;
+    switch (kind)
+    {
+    case KIND_UTF8:
+        c = units[0];
+        if (c < 0x80) { out[0] = c; *out_len = 1; return 1; }
+        if (c < 0xc2 || c > 0xf4) return -1;
+        need = c < 0xe0 ? 2 : c < 0xf0 ? 3 : 4;
+        for (i = 1; i < need; i++)
+        {
+            if (i >= (unsigned int)avail) return 0;
+            if ((units[i] & 0xc0) != 0x80) return -(int)i;
+            if (i == 1 && ((c == 0xe0 && units[1] < 0xa0) || (c == 0xed && units[1] > 0x9f) ||
+                           (c == 0xf0 && units[1] < 0x90) || (c == 0xf4 && units[1] > 0x8f)))
+                return -1;
+        }
+        if (need == 2) c = ((c & 0x1f) << 6) | (units[1] & 0x3f);
+        else if (need == 3) c = ((c & 0x0f) << 12) | ((units[1] & 0x3f) << 6) | (units[2] & 0x3f);
+        else c = ((c & 0x07) << 18) | ((units[1] & 0x3f) << 12) | ((units[2] & 0x3f) << 6) | (units[3] & 0x3f);
+        break;
+    case KIND_UTF16: case KIND_UTF16LE: case KIND_UTF16BE:
+    {
+        BOOL be = kind == KIND_UTF16BE || (kind == KIND_UTF16 && conv->big_endian);
+        unsigned int c2;
+        if (avail < 2) return 0;
+        c = be ? (units[0] << 8) | units[1] : units[0] | (units[1] << 8);
+        if (c >= 0xdc00 && c <= 0xdfff) return -2;
+        if (c < 0xd800 || c > 0xdbff) { out[0] = c; *out_len = 1; return 2; }
+        if (avail < 4) return 0;
+        c2 = be ? (units[2] << 8) | units[3] : units[2] | (units[3] << 8);
+        if (c2 < 0xdc00 || c2 > 0xdfff) return -2;
+        out[0] = c;
+        out[1] = c2;
+        *out_len = 2;
+        return 4;
+    }
+    case KIND_UTF32: case KIND_UTF32LE: case KIND_UTF32BE:
+    {
+        BOOL be = kind == KIND_UTF32BE || (kind == KIND_UTF32 && conv->big_endian);
+        if (avail < 4) return 0;
+        c = be ? ((unsigned int)units[0] << 24) | (units[1] << 16) | (units[2] << 8) | units[3]
+               : units[0] | (units[1] << 8) | (units[2] << 16) | ((unsigned int)units[3] << 24);
+        if (c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff)) return -4;
+        need = 4;
+        break;
+    }
+    default:
+    {
+        int len = 1, n;
+        WCHAR buf[4];
+
+        if (conv->codepage == 54936)  /* GB18030: one, two or four bytes */
+        {
+            if (units[0] >= 0x81 && units[0] <= 0xfe)
+            {
+                if (avail < 2) return 0;
+                len = (units[1] >= 0x30 && units[1] <= 0x39) ? 4 : 2;
+                if (avail < len) return 0;
+            }
+        }
+        else if (conv->codepage == 65000)  /* UTF-7: hand the run to the system whole */
+        {
+            n = MultiByteToWideChar( conv->codepage, 0, (const char *)units, avail, NULL, 0 );
+            if (n <= 0 || n > 4) n = 0;
+            len = avail;
+            if (!n || !MultiByteToWideChar( conv->codepage, 0, (const char *)units, len, out, 4 )) return -len;
+            *out_len = n;
+            return len;
+        }
+        else if (conv->info.MaxCharSize > 1 && IsDBCSLeadByteEx( conv->codepage, units[0] ))
+        {
+            if (avail < 2) return 0;
+            len = 2;
+        }
+        n = MultiByteToWideChar( conv->codepage, MB_ERR_INVALID_CHARS, (const char *)units, len, buf, ARRAY_SIZE(buf) );
+        if (n <= 0)
+        {
+            *reason = len > 1 ? UCNV_UNASSIGNED : UCNV_ILLEGAL;
+            return -len;
+        }
+        /* a byte the code page leaves unmapped comes back as its default character */
+        if (n == 1 && len == 1 && buf[0] == conv->info.UnicodeDefaultChar && units[0] != conv->info.DefaultChar[0])
+        {
+            *reason = UCNV_UNASSIGNED;
+            return -1;
+        }
+        memcpy( out, buf, n * sizeof(WCHAR) );
+        *out_len = n;
+        return len;
+    }
+    }
+    if (c >= 0x10000)
+    {
+        out[0] = 0xd800 + ((c - 0x10000) >> 10);
+        out[1] = 0xdc00 + ((c - 0x10000) & 0x3ff);
+        *out_len = 2;
+    }
+    else
+    {
+        out[0] = c;
+        *out_len = 1;
+    }
+    return need;
+}
+
+/* n units were used: the held-back ones first, then the caller's */
+static void consume( UConverter *conv, const unsigned char **src, int n )
+{
+    if (n >= conv->pending_len)
+    {
+        *src += n - conv->pending_len;
+        conv->pending_len = 0;
+    }
+    else
+    {
+        memmove( conv->pending, conv->pending + n, conv->pending_len - n );
+        conv->pending_len -= n;
+    }
+}
+
+/* a UTF-16 or UTF-32 byte order mark at the start of the input */
+static int skip_bom( UConverter *conv, const unsigned char *units, int avail )
+{
+    enum kind kind = conv->charset ? conv->charset->kind : KIND_CODEPAGE;
+
+    if (conv->bom_seen) return 0;
+    if (kind == KIND_UTF16)
+    {
+        if (avail < 2) return -1;
+        conv->bom_seen = TRUE;
+        conv->big_endian = TRUE;  /* without a mark, big-endian */
+        if (units[0] == 0xff && units[1] == 0xfe) { conv->big_endian = FALSE; return 2; }
+        if (units[0] == 0xfe && units[1] == 0xff) return 2;
+        return 0;
+    }
+    if (kind == KIND_UTF32)
+    {
+        if (avail < 4) return -1;
+        conv->bom_seen = TRUE;
+        conv->big_endian = TRUE;
+        if (units[0] == 0xff && units[1] == 0xfe && !units[2] && !units[3]) { conv->big_endian = FALSE; return 4; }
+        if (!units[0] && !units[1] && units[2] == 0xfe && units[3] == 0xff) return 4;
+        return 0;
+    }
+    conv->bom_seen = TRUE;
+    return 0;
+}
+
+/***********************************************************************
+ *		ucnv_toUnicode (icuuc.@)
+ */
+void __cdecl ucnv_toUnicode( UConverter *conv, UChar **target, const UChar *target_limit, const char **source,
+                             const char *source_limit, int32_t *offsets, UBool flush, UErrorCode *err )
+{
+    UConverterToUnicodeArgs args;
+    const unsigned char *src, *end;
+    unsigned char buf[16];
+    UChar out[4];
+    int n, out_len = 0, take, i;
+    UConverterCallbackReason reason;
+
+    if (!err || U_FAILURE(*err)) return;
+    if (!conv || !target || !source || *target > target_limit || *source > source_limit)
+    {
+        *err = U_ILLEGAL_ARGUMENT_ERROR;
+        return;
+    }
+    TRACE( "%p %Iu bytes, room %Iu, flush %d\n", conv, (SIZE_T)(source_limit - *source),
+           (SIZE_T)(target_limit - *target), flush );
+
+    args.size = sizeof(args);
+    args.flush = flush;
+    args.converter = conv;
+    args.source = *source;
+    args.sourceLimit = source_limit;
+    args.target = *target;
+    args.targetLimit = target_limit;
+    args.offsets = offsets;
+
+    /* what did not fit last time */
+    if (conv->to_overflow_len)
+    {
+        UChar held[ARRAY_SIZE(conv->to_overflow)];
+        int len = conv->to_overflow_len;
+        memcpy( held, conv->to_overflow, len * sizeof(UChar) );
+        conv->to_overflow_len = 0;
+        put_uchars( &args, held, len, -1, err );
+        if (U_FAILURE(*err)) goto done;
+    }
+
+    src = (const unsigned char *)*source;
+    end = (const unsigned char *)source_limit;
+    for (;;)
+    {
+        /* the next units: a held-back incomplete character first */
+        int avail;
+        const unsigned char *units;
+        int32_t offset = conv->pending_len ? -1 : (int32_t)(src - (const unsigned char *)*source);
+
+        if (conv->pending_len)
+        {
+            take = min( (int)(sizeof(buf) - conv->pending_len), (int)(end - src) );
+            memcpy( buf, conv->pending, conv->pending_len );
+            memcpy( buf + conv->pending_len, src, take );
+            units = buf;
+            avail = conv->pending_len + take;
+        }
+        else
+        {
+            if (src >= end) break;
+            units = src;
+            avail = end - src;
+        }
+
+        if (!conv->bom_seen)
+        {
+            n = skip_bom( conv, units, avail );
+            if (n < 0)  /* not enough to tell */
+            {
+                if (!flush) goto hold;
+                conv->bom_seen = TRUE;
+                conv->big_endian = TRUE;
+                n = 0;
+            }
+            if (n)
+            {
+                consume( conv, &src, n );
+                continue;
+            }
+        }
+
+        n = decode_one( conv, units, avail, out, &out_len, &reason );
+        if (n == 0)
+        {
+            if (flush)
+            {
+                /* the input ends inside a character */
+                n = -avail;
+                reason = UCNV_ILLEGAL;
+                *err = U_TRUNCATED_CHAR_FOUND;
+                goto bad;
+            }
+hold:
+            /* keep the incomplete character for the next call */
+            if (avail > (int)sizeof(conv->pending)) avail = sizeof(conv->pending);
+#ifdef SG_MUTANT_ICU_NO_PENDING
+            src += avail - conv->pending_len;
+            conv->pending_len = 0;
+            break;
+#endif
+            if (units != conv->pending) memmove( conv->pending, units, avail );
+            src += avail - conv->pending_len;
+            conv->pending_len = avail;
+            break;
+        }
+        if (n > 0)
+        {
+            put_uchars( &args, out, out_len, offset, err );
+            consume( conv, &src, n );
+            if (U_FAILURE(*err)) break;
+            continue;
+        }
+        *err = reason == UCNV_UNASSIGNED ? U_INVALID_CHAR_FOUND : U_ILLEGAL_CHAR_FOUND;
+bad:
+        n = -n;
+        {
+            unsigned char bad[16];
+            for (i = 0; i < n && i < (int)sizeof(bad); i++) bad[i] = units[i];
+            memcpy( buf, bad, i );
+        }
+        consume( conv, &src, n );
+        args.source = (const char *)src;
+#ifdef SG_MUTANT_ICU_NO_CALLBACK
+        if (conv->to_cb) UCNV_TO_U_CALLBACK_SUBSTITUTE( NULL, &args, (const char *)buf, n, reason, err );
+#else
+        if (conv->to_cb) conv->to_cb( conv->to_ctx, &args, (const char *)buf, n, reason, err );
+#endif
+        if (U_FAILURE(*err)) break;
+        if (*err == U_TRUNCATED_CHAR_FOUND) *err = U_ZERO_ERROR;
+    }
+    if (flush && !U_FAILURE(*err)) reset_to( conv );
+    args.source = (const char *)src;
+done:
+    *source = args.source;
+    *target = args.target;
+}
+
+/***********************************************************************
+ *		ucnv_toUCountPending (icuuc.@)
+ */
+int32_t __cdecl ucnv_toUCountPending( const UConverter *conv, UErrorCode *err )
+{
+    if (!err || U_FAILURE(*err)) return -1;
+    if (!conv)
+    {
+        *err = U_ILLEGAL_ARGUMENT_ERROR;
+        return -1;
+    }
+    return conv->pending_len;
+}
+
+/***********************************************************************
+ *		ucnv_cbToUWriteUChars (icuuc.@)
+ */
+void __cdecl ucnv_cbToUWriteUChars( UConverterToUnicodeArgs *args, const UChar *source, int32_t length,
+                                    int32_t offset_index, UErrorCode *err )
+{
+    if (!err || U_FAILURE(*err) || !args || !args->converter) return;
+    put_uchars( args, source, length, offset_index, err );
+}
+
+/***********************************************************************
+ *		UCNV_TO_U_CALLBACK_SUBSTITUTE (icuuc.@)
+ */
+void __cdecl UCNV_TO_U_CALLBACK_SUBSTITUTE( const void *context, UConverterToUnicodeArgs *args, const char *units,
+                                            int32_t length, UConverterCallbackReason reason, UErrorCode *err )
+{
+    static const UChar replacement = 0xfffd;
+
+    if (reason > UCNV_IRREGULAR) return;
+    if (context && !strcmp( context, SUB_STOP_ON_ILLEGAL ) && reason != UCNV_UNASSIGNED) return;
+    *err = U_ZERO_ERROR;
+    put_uchars( args, &replacement, 1, 0, err );
+}
+
+/***********************************************************************
+ * From Unicode
+ */
+
+static void put_bytes( UConverterFromUnicodeArgs *args, const char *bytes, int len, int32_t offset, UErrorCode *err )
+{
+    UConverter *conv = args->converter;
+    int i;
+
+    for (i = 0; i < len; i++)
+    {
+        if (args->target < args->targetLimit)
+        {
+            *args->target++ = bytes[i];
+            if (args->offsets) *args->offsets++ = offset;
+        }
+        else if (conv->from_overflow_len < ARRAY_SIZE(conv->from_overflow))
+        {
+            conv->from_overflow[conv->from_overflow_len++] = bytes[i];
+            *err = U_BUFFER_OVERFLOW_ERROR;
+        }
+        else *err = U_BUFFER_OVERFLOW_ERROR;
+    }
+}
+
+/* encode one code point; returns the byte count, or 0 when this charset has no such character */
+static int encode_one( UConverter *conv, UChar32 c, char *out )
+{
+    enum kind kind = conv->charset ? conv->charset->kind : KIND_CODEPAGE;
+    WCHAR w[2];
+    BOOL used_default = FALSE;
+    int n, wlen;
+
+    switch (kind)
+    {
+    case KIND_UTF8:
+        if (c < 0x80) { out[0] = c; return 1; }
+        if (c < 0x800) { out[0] = 0xc0 | (c >> 6); out[1] = 0x80 | (c & 0x3f); return 2; }
+        if (c < 0x10000)
+        {
+            out[0] = 0xe0 | (c >> 12); out[1] = 0x80 | ((c >> 6) & 0x3f); out[2] = 0x80 | (c & 0x3f);
+            return 3;
+        }
+        out[0] = 0xf0 | (c >> 18); out[1] = 0x80 | ((c >> 12) & 0x3f);
+        out[2] = 0x80 | ((c >> 6) & 0x3f); out[3] = 0x80 | (c & 0x3f);
+        return 4;
+    case KIND_UTF16: case KIND_UTF16LE: case KIND_UTF16BE:
+    {
+        BOOL be = kind == KIND_UTF16BE;  /* UTF-16 itself writes the platform's order, after a mark */
+        int i;
+        if (c >= 0x10000)
+        {
+            w[0] = 0xd800 + ((c - 0x10000) >> 10);
+            w[1] = 0xdc00 + ((c - 0x10000) & 0x3ff);
+            wlen = 2;
+        }
+        else
+        {
+            w[0] = c;
+            wlen = 1;
+        }
+        for (i = 0; i < wlen; i++)
+        {
+            out[2 * i + (be ? 0 : 1)] = w[i] >> 8;
+            out[2 * i + (be ? 1 : 0)] = w[i] & 0xff;
+        }
+        return 2 * wlen;
+    }
+    case KIND_UTF32: case KIND_UTF32LE: case KIND_UTF32BE:
+    {
+        BOOL be = kind == KIND_UTF32BE;
+        out[be ? 0 : 3] = c >> 24;
+        out[be ? 1 : 2] = (c >> 16) & 0xff;
+        out[be ? 2 : 1] = (c >> 8) & 0xff;
+        out[be ? 3 : 0] = c & 0xff;
+        return 4;
+    }
+    default:
+        if (c >= 0x10000)
+        {
+            w[0] = 0xd800 + ((c - 0x10000) >> 10);
+            w[1] = 0xdc00 + ((c - 0x10000) & 0x3ff);
+            wlen = 2;
+        }
+        else
+        {
+            w[0] = c;
+            wlen = 1;
+        }
+        if (conv->codepage == 65000 || conv->codepage == 54936)
+            n = WideCharToMultiByte( conv->codepage, 0, w, wlen, out, 8, NULL, NULL );
+        else
+            n = WideCharToMultiByte( conv->codepage, WC_NO_BEST_FIT_CHARS, w, wlen, out, 8, NULL, &used_default );
+        return n > 0 && !used_default ? n : 0;
+    }
+}
+
+/***********************************************************************
+ *		ucnv_fromUnicode (icuuc.@)
+ */
+void __cdecl ucnv_fromUnicode( UConverter *conv, char **target, const char *target_limit, const UChar **source,
+                               const UChar *source_limit, int32_t *offsets, UBool flush, UErrorCode *err )
+{
+    UConverterFromUnicodeArgs args;
+    const UChar *src;
+    enum kind kind;
+    char out[8];
+    UChar units[2];
+    UChar32 c;
+    int n, len;
+    int32_t offset;
+    UConverterCallbackReason reason;
+
+    if (!err || U_FAILURE(*err)) return;
+    if (!conv || !target || !source || *target > target_limit || *source > source_limit)
+    {
+        *err = U_ILLEGAL_ARGUMENT_ERROR;
+        return;
+    }
+    TRACE( "%p %Iu chars, room %Iu, flush %d\n", conv, (SIZE_T)(source_limit - *source),
+           (SIZE_T)(target_limit - *target), flush );
+
+    kind = conv->charset ? conv->charset->kind : KIND_CODEPAGE;
+    args.size = sizeof(args);
+    args.flush = flush;
+    args.converter = conv;
+    args.source = *source;
+    args.sourceLimit = source_limit;
+    args.target = *target;
+    args.targetLimit = target_limit;
+    args.offsets = offsets;
+
+    if (conv->from_overflow_len)
+    {
+        char held[ARRAY_SIZE(conv->from_overflow)];
+        int held_len = conv->from_overflow_len;
+        memcpy( held, conv->from_overflow, held_len );
+        conv->from_overflow_len = 0;
+        put_bytes( &args, held, held_len, -1, err );
+        if (U_FAILURE(*err)) goto done;
+    }
+    /* UTF-16 and UTF-32 without a stated byte order start with a mark, then little-endian as ICU does here */
+    if (!conv->bom_written && (kind == KIND_UTF16 || kind == KIND_UTF32) && (args.source < source_limit || conv->lead))
+    {
+        conv->bom_written = TRUE;
+        if (kind == KIND_UTF16) put_bytes( &args, "\xff\xfe", 2, -1, err );
+        else put_bytes( &args, "\xff\xfe\0\0", 4, -1, err );
+        if (U_FAILURE(*err)) goto done;
+    }
+
+    src = *source;
+    for (;;)
+    {
+        offset = (int32_t)(src - *source);
+        if (conv->lead)
+        {
+            if (src >= source_limit)
+            {
+                if (!flush) break;
+                /* the input ends after a lead surrogate */
+                units[0] = conv->lead;
+                conv->lead = 0;
+                *err = U_TRUNCATED_CHAR_FOUND;
+                args.source = src;
+                if (conv->from_cb) conv->from_cb( conv->from_ctx, &args, units, 1, units[0], UCNV_ILLEGAL, err );
+                if (*err == U_TRUNCATED_CHAR_FOUND) *err = U_ZERO_ERROR;
+                break;
+            }
+            if (*src >= 0xdc00 && *src <= 0xdfff)
+            {
+                units[0] = conv->lead;
+                units[1] = *src++;
+                conv->lead = 0;
+                c = 0x10000 + ((units[0] - 0xd800) << 10) + (units[1] - 0xdc00);
+                len = 2;
+                offset = -1;
+            }
+            else
+            {
+                units[0] = conv->lead;
+                conv->lead = 0;
+                c = units[0];
+                len = 1;
+                reason = UCNV_ILLEGAL;
+                *err = U_ILLEGAL_CHAR_FOUND;
+                goto bad;
+            }
+        }
+        else
+        {
+            if (src >= source_limit) break;
+            units[0] = *src++;
+            c = units[0];
+            len = 1;
+            if (c >= 0xd800 && c <= 0xdbff)
+            {
+                conv->lead = c;
+                continue;
+            }
+            if (c >= 0xdc00 && c <= 0xdfff)
+            {
+                reason = UCNV_ILLEGAL;
+                *err = U_ILLEGAL_CHAR_FOUND;
+                goto bad;
+            }
+        }
+        if ((n = encode_one( conv, c, out )))
+        {
+            put_bytes( &args, out, n, offset, err );
+            if (U_FAILURE(*err)) break;
+            continue;
+        }
+        reason = UCNV_UNASSIGNED;
+        *err = U_INVALID_CHAR_FOUND;
+bad:
+        args.source = src;
+        if (conv->from_cb) conv->from_cb( conv->from_ctx, &args, units, len, c, reason, err );
+        if (U_FAILURE(*err)) break;
+    }
+    if (flush && !U_FAILURE(*err))
+    {
+        conv->lead = 0;
+        conv->bom_written = FALSE;
+    }
+    args.source = src;
+done:
+    *source = args.source;
+    *target = args.target;
+}
+
+/***********************************************************************
+ *		ucnv_fromUCountPending (icuuc.@)
+ */
+int32_t __cdecl ucnv_fromUCountPending( const UConverter *conv, UErrorCode *err )
+{
+    if (!err || U_FAILURE(*err)) return -1;
+    if (!conv)
+    {
+        *err = U_ILLEGAL_ARGUMENT_ERROR;
+        return -1;
+    }
+    return conv->lead ? 1 : 0;
+}
+
+/***********************************************************************
+ *		ucnv_cbFromUWriteUChars (icuuc.@)
+ *
+ * A callback's replacement text, converted with the converter's charset.
+ */
+void __cdecl ucnv_cbFromUWriteUChars( UConverterFromUnicodeArgs *args, const UChar **source,
+                                      const UChar *source_limit, int32_t offset_index, UErrorCode *err )
+{
+    const UChar *s;
+    char out[8];
+    UChar32 c;
+    int n;
+
+    if (!err || U_FAILURE(*err) || !args || !args->converter || !source) return;
+    for (s = *source; s < source_limit; s++)
+    {
+        c = *s;
+        if (c >= 0xd800 && c <= 0xdbff && s + 1 < source_limit && s[1] >= 0xdc00 && s[1] <= 0xdfff)
+        {
+            c = 0x10000 + ((c - 0xd800) << 10) + (s[1] - 0xdc00);
+            s++;
+        }
+        if (!(n = encode_one( args->converter, c, out )))
+        {
+            out[0] = 0x1a;
+            n = 1;
+        }
+        put_bytes( args, out, n, offset_index, err );
+    }
+    *source = s;
+}
+
+/***********************************************************************
+ *		UCNV_FROM_U_CALLBACK_SUBSTITUTE (icuuc.@)
+ */
+void __cdecl UCNV_FROM_U_CALLBACK_SUBSTITUTE( const void *context, UConverterFromUnicodeArgs *args,
+                                              const UChar *units, int32_t length, UChar32 cp,
+                                              UConverterCallbackReason reason, UErrorCode *err )
+{
+    UConverter *conv;
+    char sub[8];
+    int n = 1;
+
+    if (reason > UCNV_IRREGULAR) return;
+    if (context && !strcmp( context, SUB_STOP_ON_ILLEGAL ) && reason != UCNV_UNASSIGNED) return;
+    *err = U_ZERO_ERROR;
+    conv = args->converter;
+    /* the charset's substitution character: U+FFFD in the Unicode forms, SUB (0x1a) in a single-byte
+     * code page, the code page's own default character in a multi-byte one */
+    if (conv->charset && conv->charset->kind != KIND_CODEPAGE) n = encode_one( conv, 0xfffd, sub );
+    else if (conv->info.MaxCharSize > 1)
+    {
+        sub[0] = conv->info.DefaultChar[0];
+        if (conv->info.DefaultChar[1]) { sub[1] = conv->info.DefaultChar[1]; n = 2; }
+    }
+    else sub[0] = 0x1a;
+    put_bytes( args, sub, n, 0, err );
+}
