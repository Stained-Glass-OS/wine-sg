From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: wait completion packets

NtCreateWaitCompletionPacket, NtAssociateWaitCompletionPacket and NtCancelWaitCompletionPacket did not exist: the Windows App SDK's CoreMessagingXP (WinUI 3's dispatcher) calls them and App Installer died at the first one. A packet is a handle; associated with a waitable object and an I/O completion port, it queues a completion with its key, APC context, status and information when the object is signalled (at once, and reported, if it is already); cancelled before that, nothing is queued. Implemented on a thread pool wait.
---
diff --git a/dlls/ntdll/ntdll.spec b/dlls/ntdll/ntdll.spec
index 869055c..253ac5c 100644
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -404,6 +404,9 @@
 @ stdcall -syscall NtSetInformationToken(long long ptr long)
 @ stdcall -syscall NtSetInformationVirtualMemory(long long ptr ptr ptr long)
 @ stdcall -syscall NtSetIntervalProfile(long long)
+@ stdcall NtAssociateWaitCompletionPacket(ptr ptr ptr ptr ptr long ptr ptr)
+@ stdcall NtCancelWaitCompletionPacket(ptr long)
+@ stdcall NtCreateWaitCompletionPacket(ptr long ptr)
 @ stdcall -syscall NtSetIoCompletion(ptr long long long long)
 @ stdcall -syscall NtSetIoCompletionEx(ptr ptr long long long long)
 @ stdcall -syscall NtSetLdtEntries(long int64 long int64)
@@ -1478,6 +1481,9 @@
 @ stdcall -private -syscall ZwSetInformationToken(long long ptr long) NtSetInformationToken
 @ stdcall -private -syscall ZwSetInformationVirtualMemory(long long ptr ptr ptr long) NtSetInformationVirtualMemory
 @ stdcall -private -syscall ZwSetIntervalProfile(long long) NtSetIntervalProfile
+@ stdcall -private ZwAssociateWaitCompletionPacket(ptr ptr ptr ptr ptr long ptr ptr) NtAssociateWaitCompletionPacket
+@ stdcall -private ZwCancelWaitCompletionPacket(ptr long) NtCancelWaitCompletionPacket
+@ stdcall -private ZwCreateWaitCompletionPacket(ptr long ptr) NtCreateWaitCompletionPacket
 @ stdcall -private -syscall ZwSetIoCompletion(ptr long long long long) NtSetIoCompletion
 @ stdcall -private -syscall ZwSetIoCompletionEx(ptr ptr long long long long) NtSetIoCompletionEx
 @ stdcall -private -syscall ZwSetLdtEntries(long int64 long int64) NtSetLdtEntries
diff --git a/dlls/ntdll/threadpool.c b/dlls/ntdll/threadpool.c
index ce66f64..446d5e3 100644
--- a/dlls/ntdll/threadpool.c
+++ b/dlls/ntdll/threadpool.c
@@ -3421,3 +3421,174 @@ NTSTATUS WINAPI RtlDeregisterWait(HANDLE WaitHandle)
 {
     return RtlDeregisterWaitEx(WaitHandle, NULL);
 }
+
+/***********************************************************************
+ * Wait completion packets
+ *
+ * Stained Glass OS: a wait completion packet ties a waitable object to an I/O completion port --
+ * when the object is signalled (the wait satisfied, as by any wait), a completion with the packet's
+ * key, APC context, status and information is queued to the port.  The Windows App SDK's
+ * CoreMessagingXP (WinUI 3's dispatcher) waits on its objects this way.  The packet is a handle of
+ * its own (an event stands in for the object); the wait is a thread pool wait.
+ */
+enum wait_packet_state { PACKET_IDLE, PACKET_WAITING, PACKET_QUEUED };
+
+struct wait_packet
+{
+    struct list entry;
+    HANDLE handle;
+    TP_WAIT *wait;
+    HANDLE port;
+    void *key, *apc;
+    NTSTATUS status;
+    ULONG_PTR info;
+    enum wait_packet_state state;
+};
+
+static struct list wait_packets = LIST_INIT( wait_packets );
+static RTL_CRITICAL_SECTION wait_packets_cs;
+static RTL_CRITICAL_SECTION_DEBUG wait_packets_cs_debug =
+{
+    0, 0, &wait_packets_cs,
+    { &wait_packets_cs_debug.ProcessLocksList, &wait_packets_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": wait_packets_cs") }
+};
+static RTL_CRITICAL_SECTION wait_packets_cs = { &wait_packets_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct wait_packet *find_wait_packet( HANDLE handle )
+{
+    struct wait_packet *packet;
+
+    LIST_FOR_EACH_ENTRY( packet, &wait_packets, struct wait_packet, entry )
+        if (packet->handle == handle) return packet;
+    return NULL;
+}
+
+static void CALLBACK wait_packet_callback( TP_CALLBACK_INSTANCE *instance, void *context, TP_WAIT *wait,
+                                           TP_WAIT_RESULT result )
+{
+    struct wait_packet *packet = context;
+
+    RtlEnterCriticalSection( &wait_packets_cs );
+    if (packet->state == PACKET_WAITING && result == WAIT_OBJECT_0)
+    {
+#ifndef SG_MUTANT_WAIT_PACKET_NOT_QUEUED
+        NtSetIoCompletion( packet->port, (ULONG_PTR)packet->key, (ULONG_PTR)packet->apc, packet->status, packet->info );
+#endif
+        packet->state = PACKET_QUEUED;
+    }
+    RtlLeaveCriticalSection( &wait_packets_cs );
+}
+
+/***********************************************************************
+ *           NtCreateWaitCompletionPacket   (NTDLL.@)
+ */
+NTSTATUS WINAPI NtCreateWaitCompletionPacket( HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBUTES *attr )
+{
+    struct wait_packet *packet;
+    NTSTATUS status;
+
+    TRACE( "%p %#lx %p\n", handle, access, attr );
+
+    if (!handle) return STATUS_ACCESS_VIOLATION;
+    if (!(packet = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*packet) ))) return STATUS_NO_MEMORY;
+    if ((status = NtCreateEvent( &packet->handle, EVENT_ALL_ACCESS, attr, NotificationEvent, FALSE )))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, packet );
+        return status;
+    }
+    if ((status = TpAllocWait( &packet->wait, wait_packet_callback, packet, NULL )))
+    {
+        NtClose( packet->handle );
+        RtlFreeHeap( GetProcessHeap(), 0, packet );
+        return status;
+    }
+    RtlEnterCriticalSection( &wait_packets_cs );
+    list_add_tail( &wait_packets, &packet->entry );
+    RtlLeaveCriticalSection( &wait_packets_cs );
+    *handle = packet->handle;
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           NtAssociateWaitCompletionPacket   (NTDLL.@)
+ */
+NTSTATUS WINAPI NtAssociateWaitCompletionPacket( HANDLE handle, HANDLE port, HANDLE target, void *key, void *apc,
+                                                 NTSTATUS io_status, ULONG_PTR info, BOOLEAN *already_signaled )
+{
+    LARGE_INTEGER zero = {{ 0 }};
+    struct wait_packet *packet;
+    NTSTATUS status;
+
+    TRACE( "%p %p %p %p %p %#lx %#Ix %p\n", handle, port, target, key, apc, io_status, info, already_signaled );
+
+    if (already_signaled) *already_signaled = FALSE;
+    RtlEnterCriticalSection( &wait_packets_cs );
+    if (!(packet = find_wait_packet( handle )))
+    {
+        RtlLeaveCriticalSection( &wait_packets_cs );
+        return STATUS_INVALID_HANDLE;
+    }
+    if (packet->state == PACKET_WAITING)
+    {
+        RtlLeaveCriticalSection( &wait_packets_cs );
+        return STATUS_INVALID_PARAMETER;   /* cancel it first */
+    }
+    packet->port = port;
+    packet->key = key;
+    packet->apc = apc;
+    packet->status = io_status;
+    packet->info = info;
+
+    /* an object signalled already: the packet is queued now */
+    status = NtWaitForSingleObject( target, FALSE, &zero );
+    if (status == STATUS_WAIT_0)
+    {
+        status = NtSetIoCompletion( port, (ULONG_PTR)key, (ULONG_PTR)apc, io_status, info );
+        if (!status)
+        {
+            packet->state = PACKET_QUEUED;
+            if (already_signaled) *already_signaled = TRUE;
+        }
+    }
+    else if (status == STATUS_TIMEOUT)
+    {
+        packet->state = PACKET_WAITING;
+        TpSetWait( packet->wait, target, NULL );
+        status = STATUS_SUCCESS;
+    }
+    RtlLeaveCriticalSection( &wait_packets_cs );
+    return status;
+}
+
+/***********************************************************************
+ *           NtCancelWaitCompletionPacket   (NTDLL.@)
+ *
+ * STATUS_SUCCESS: the wait was cancelled before the object was signalled; STATUS_PENDING: the
+ * packet is queued already (it is not taken back from the port); STATUS_CANCELLED: it was not
+ * associated.
+ */
+NTSTATUS WINAPI NtCancelWaitCompletionPacket( HANDLE handle, BOOLEAN remove_signaled )
+{
+    struct wait_packet *packet;
+    NTSTATUS status;
+
+    TRACE( "%p %d\n", handle, remove_signaled );
+
+    RtlEnterCriticalSection( &wait_packets_cs );
+    if (!(packet = find_wait_packet( handle ))) status = STATUS_INVALID_HANDLE;
+    else if (packet->state == PACKET_WAITING)
+    {
+        TpSetWait( packet->wait, NULL, NULL );
+        packet->state = PACKET_IDLE;
+        status = STATUS_SUCCESS;
+    }
+    else if (packet->state == PACKET_QUEUED)
+    {
+        packet->state = PACKET_IDLE;
+        status = STATUS_PENDING;
+    }
+    else status = STATUS_CANCELLED;
+    RtlLeaveCriticalSection( &wait_packets_cs );
+    return status;
+}
