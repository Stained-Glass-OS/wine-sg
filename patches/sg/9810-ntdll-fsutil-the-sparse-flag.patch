From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, fsutil: a file's sparse flag; fsutil sparse

FSCTL_SET_SPARSE marks a file sparse as NTFS does: the flag is kept in the DOS attributes
extended attribute and reported as FILE_ATTRIBUTE_SPARSE_FILE; setting attributes keeps it,
FSCTL_SET_SPARSE(FALSE) clears it (filling the holes), a handle without write access is refused.
fsutil gains sparse queryflag/setflag [0|1]/queryrange/setrange. winioctl.h: FILE_SET_SPARSE_BUFFER,
FILE_ZERO_DATA_INFORMATION, FILE_ALLOCATED_RANGE_BUFFER. Electrum marks its block header file
sparse with fsutil (runtime census set 7, gaps15).
---
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -186,10 +186,18 @@
  * with the file (attrib +p / -u; FILE_ATTRIBUTE_RECALL_ON_DATA_ACCESS of a file whose data
  * is in the cloud): cldapi sets them, and programs and the shell read them back */
 #ifndef SG_MUTANT_NO_CLOUD_ATTRIBS
+/* Stained Glass OS 9810: and the sparse flag FSCTL_SET_SPARSE gives a file (fsutil sparse setflag),
+ * which Windows keeps with the file and reports among its attributes */
+#ifndef SG_MUTANT_NO_SPARSE_FLAG
+#define XATTR_SPARSE            FILE_ATTRIBUTE_SPARSE_FILE
+#else
+#define XATTR_SPARSE            0
+#endif
 #define XATTR_ATTRIBS_MASK      (FILE_ATTRIBUTE_HIDDEN|FILE_ATTRIBUTE_SYSTEM|0x00040000 /* RECALL_ON_OPEN */ | \
                                  0x00080000 /* PINNED */ | 0x00100000 /* UNPINNED */ | \
-                                 0x00400000 /* RECALL_ON_DATA_ACCESS */)
+                                 0x00400000 /* RECALL_ON_DATA_ACCESS */ | XATTR_SPARSE)
 #else
+#define XATTR_SPARSE            0
 #define XATTR_ATTRIBS_MASK      (FILE_ATTRIBUTE_HIDDEN|FILE_ATTRIBUTE_SYSTEM)
 #endif
 
@@ -1810,10 +1818,24 @@
     return ret;
 }
 
+/* Stained Glass OS 9810: the sparse flag the file has now (only FSCTL_SET_SPARSE changes it) */
+static UINT fd_get_sparse_attrib( int fd )
+{
+    char data[65];
+    int len;
+
+    if (!XATTR_SPARSE) return 0;
+    if ((len = xattr_fget( fd, SAMBA_XATTR_DOS_ATTRIB, data, sizeof(data) - 1 )) == -1) return 0;
+    return parse_samba_dos_attrib_data( data, len ) & XATTR_SPARSE;
+}
+
 static int fd_set_dos_attrib( int fd, UINT attr, BOOL force_set )
 {
     /* we only store the HIDDEN and SYSTEM attributes (and the cloud ones, 6257) */
     attr &= XATTR_ATTRIBS_MASK;
+    /* Stained Glass OS 9810: as on Windows, setting attributes neither sets nor clears the sparse
+     * flag: the file keeps the one it has */
+    attr = (attr & ~XATTR_SPARSE) | fd_get_sparse_attrib( fd );
     if (force_set || attr != 0)
     {
         /* encode the attributes in Samba 3 ASCII format. Samba 4 has extended
@@ -5172,7 +5194,7 @@
         }
 
         if (io->Information == FILE_CREATED &&
-            ((attributes & XATTR_ATTRIBS_MASK) || name_hidden))
+            ((attributes & XATTR_ATTRIBS_MASK & ~XATTR_SPARSE) || name_hidden))
         {
             int fd, needs_close;
 
@@ -8188,6 +8210,50 @@
     return status;
 }
 
+/* Stained Glass OS 9810: FSCTL_SET_SPARSE marks a file sparse (or, with FALSE, not), as NTFS does:
+ * the flag is kept in the DOS attributes extended attribute, so the file's attributes report
+ * FILE_ATTRIBUTE_SPARSE_FILE (fsutil sparse queryflag; Electrum's block header file). Clearing it
+ * gives every hole its space back, as NTFS allocates the sparse ranges when the flag goes. */
+static NTSTATUS set_sparse( HANDLE handle, const void *in, ULONG in_size )
+{
+    OBJECT_BASIC_INFORMATION obi;
+    BOOLEAN sparse = TRUE;
+    int fd, needs_close, len;
+    char data[65];
+    UINT attr = 0;
+    struct stat st;
+    NTSTATUS status;
+
+    if (in && in_size) sparse = *(const BOOLEAN *)in != 0;
+    if (!NtQueryObject( handle, ObjectBasicInformation, &obi, sizeof(obi), NULL ) &&
+        !(obi.GrantedAccess & (FILE_WRITE_DATA | FILE_WRITE_ATTRIBUTES | FILE_APPEND_DATA)))
+        return STATUS_ACCESS_DENIED;
+    if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL ))) return status;
+    if (fstat( fd, &st ) == -1) { status = errno_to_status( errno ); goto done; }
+    if (!S_ISREG( st.st_mode )) { status = STATUS_INVALID_PARAMETER; goto done; }
+#ifndef SG_MUTANT_NO_SPARSE_FLAG
+    if ((len = xattr_fget( fd, SAMBA_XATTR_DOS_ATTRIB, data, sizeof(data) - 1 )) != -1)
+        attr = parse_samba_dos_attrib_data( data, len );
+    if (!sparse && (attr & XATTR_SPARSE) && st.st_size)
+    {
+        int err = posix_fallocate( fd, 0, st.st_size );
+        if (err == ENOSPC) { status = STATUS_DISK_FULL; goto done; }
+    }
+    attr = sparse ? (attr | XATTR_SPARSE) : (attr & ~XATTR_SPARSE);
+    if (attr) len = snprintf( data, sizeof(data), "0x%x", attr );
+    if ((attr ? xattr_fset( fd, SAMBA_XATTR_DOS_ATTRIB, data, len ) : xattr_fremove( fd, SAMBA_XATTR_DOS_ATTRIB )) == -1)
+    {
+        if (errno == EACCES || errno == EPERM) status = STATUS_ACCESS_DENIED;
+        /* a file system with no extended attributes: the request was always taken (holes work) */
+    }
+#else
+    (void)len; (void)data; (void)attr;
+#endif
+done:
+    if (needs_close) close( fd );
+    return status;
+}
+
 /******************************************************************************
  *              NtFsControlFile   (NTDLL.@)
  */
@@ -8292,8 +8358,7 @@
     }
 
     case FSCTL_SET_SPARSE:
-        TRACE("FSCTL_SET_SPARSE: Ignoring request\n");
-        status = STATUS_SUCCESS;
+        status = set_sparse( handle, in_buffer, in_size );
         break;
 
     case FSCTL_QUERY_ALLOCATED_RANGES:
