 #include <windows.h>
+#include <winioctl.h>
+#include <stdio.h>
+#include <stdlib.h>
 
 #include "wine/debug.h"
 #include "resources.h"
@@ -112,6 +115,150 @@
     return ret;
 }
 
+/* Stained Glass OS 9810: fsutil sparse, as on Windows -- queryflag/setflag [0|1] read and change a
+ * file's sparse flag (FSCTL_SET_SPARSE), queryrange lists its allocated ranges
+ * (FSCTL_QUERY_ALLOCATED_RANGES), setrange gives a range back as a hole (FSCTL_SET_ZERO_DATA).
+ * Electrum marks its block header file sparse with "fsutil sparse setflag <file> 1". */
+static HANDLE open_for_sparse(const WCHAR *name, DWORD access)
+{
+    HANDLE file = CreateFileW(name, access, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                              OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    if (file == INVALID_HANDLE_VALUE) output_error_string(GetLastError());
+    return file;
+}
+
+static BOOL parse_number(const WCHAR *str, LONGLONG *value)
+{
+    WCHAR *end;
+    if (!*str) return FALSE;
+    *value = _wcstoi64(str, &end, 0);
+    return !*end && *value >= 0;
+}
+
+static int sparse_queryflag(int argc, WCHAR *argv[])
+{
+    DWORD attr;
+
+    if (argc != 4)
+    {
+        output_string(STRING_SPARSE_QUERYFLAG_USAGE);
+        return 1;
+    }
+    if ((attr = GetFileAttributesW(argv[3])) == INVALID_FILE_ATTRIBUTES)
+    {
+        output_error_string(GetLastError());
+        return 1;
+    }
+    output_string((attr & FILE_ATTRIBUTE_SPARSE_FILE) ? STRING_SPARSE_IS_SET : STRING_SPARSE_NOT_SET);
+    return 0;
+}
+
+static int sparse_setflag(int argc, WCHAR *argv[])
+{
+    FILE_SET_SPARSE_BUFFER buf;
+    HANDLE file;
+    DWORD ret;
+    BOOL ok;
+
+    if ((argc != 4 && argc != 5) || (argc == 5 && wcscmp(argv[4], L"0") && wcscmp(argv[4], L"1")))
+    {
+        output_string(STRING_SPARSE_SETFLAG_USAGE);
+        return 1;
+    }
+    buf.SetSparse = argc == 4 || argv[4][0] == '1';
+    if ((file = open_for_sparse(argv[3], GENERIC_WRITE)) == INVALID_HANDLE_VALUE) return 1;
+    ok = DeviceIoControl(file, FSCTL_SET_SPARSE, &buf, sizeof(buf), NULL, 0, &ret, NULL);
+    if (!ok) output_error_string(GetLastError());
+    CloseHandle(file);
+    return !ok;
+}
+
+static int sparse_queryrange(int argc, WCHAR *argv[])
+{
+    FILE_ALLOCATED_RANGE_BUFFER query, ranges[64];
+    LARGE_INTEGER size;
+    HANDLE file;
+    DWORD ret, i;
+    BOOL ok;
+
+    if (argc != 4)
+    {
+        output_string(STRING_SPARSE_QUERYRANGE_USAGE);
+        return 1;
+    }
+    if ((file = open_for_sparse(argv[3], GENERIC_READ)) == INVALID_HANDLE_VALUE) return 1;
+    if (!GetFileSizeEx(file, &size))
+    {
+        output_error_string(GetLastError());
+        CloseHandle(file);
+        return 1;
+    }
+    query.FileOffset.QuadPart = 0;
+    query.Length.QuadPart = size.QuadPart;
+    for (;;)
+    {
+        ok = DeviceIoControl(file, FSCTL_QUERY_ALLOCATED_RANGES, &query, sizeof(query), ranges, sizeof(ranges), &ret, NULL);
+        if (!ok && GetLastError() != ERROR_MORE_DATA)
+        {
+            output_error_string(GetLastError());
+            CloseHandle(file);
+            return 1;
+        }
+        for (i = 0; i < ret / sizeof(ranges[0]); i++)
+        {
+            WCHAR offset[32], length[32];
+            swprintf(offset, ARRAY_SIZE(offset), L"Offset: 0x%I64x", ranges[i].FileOffset.QuadPart);
+            swprintf(length, ARRAY_SIZE(length), L"Length: 0x%I64x", ranges[i].Length.QuadPart);
+            output_string(STRING_SPARSE_RANGE, offset, length);
+        }
+        if (ok || !ret) break;
+        /* more ranges: go on after the last one returned */
+        query.FileOffset.QuadPart = ranges[i - 1].FileOffset.QuadPart + ranges[i - 1].Length.QuadPart;
+        query.Length.QuadPart = size.QuadPart - query.FileOffset.QuadPart;
+        if (query.Length.QuadPart <= 0) break;
+    }
+    CloseHandle(file);
+    return 0;
+}
+
+static int sparse_setrange(int argc, WCHAR *argv[])
+{
+    FILE_ZERO_DATA_INFORMATION zero;
+    LONGLONG offset, length;
+    HANDLE file;
+    DWORD ret;
+    BOOL ok;
+
+    if (argc != 6 || !parse_number(argv[4], &offset) || !parse_number(argv[5], &length))
+    {
+        output_string(STRING_SPARSE_SETRANGE_USAGE);
+        return 1;
+    }
+    if ((file = open_for_sparse(argv[3], GENERIC_WRITE)) == INVALID_HANDLE_VALUE) return 1;
+    zero.FileOffset.QuadPart = offset;
+    zero.BeyondFinalZero.QuadPart = offset + length;
+    ok = DeviceIoControl(file, FSCTL_SET_ZERO_DATA, &zero, sizeof(zero), NULL, 0, &ret, NULL);
+    if (!ok) output_error_string(GetLastError());
+    CloseHandle(file);
+    return !ok;
+}
+
+static int sparse(int argc, WCHAR *argv[])
+{
+    if (argc > 2)
+    {
+        if (!wcsicmp(argv[2], L"queryflag")) return sparse_queryflag(argc, argv);
+        if (!wcsicmp(argv[2], L"setflag")) return sparse_setflag(argc, argv);
+        if (!wcsicmp(argv[2], L"queryrange")) return sparse_queryrange(argc, argv);
+        if (!wcsicmp(argv[2], L"setrange")) return sparse_setrange(argc, argv);
+        FIXME("unsupported parameter %s\n", debugstr_w(argv[2]));
+        output_string(STRING_SPARSE_USAGE);
+        return 1;
+    }
+    output_string(STRING_SPARSE_USAGE);
+    return 0;
+}
+
 int __cdecl wmain(int argc, WCHAR *argv[])
 {
     int i, ret = 0;
@@ -125,6 +272,10 @@
     {
         if (!wcsicmp(argv[1], L"hardlink"))
             return hardlink(argc, argv);
+#ifndef SG_MUTANT_NO_FSUTIL_SPARSE
+        else if (!wcsicmp(argv[1], L"sparse"))
+            return sparse(argc, argv);
+#endif
         else
         {
             FIXME("unsupported command %s\n", debugstr_w(argv[1]));
