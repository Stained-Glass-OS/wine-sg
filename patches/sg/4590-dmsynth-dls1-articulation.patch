From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dmsynth: Apply the DLS level 1 articulation of instrument downloads.

An instrument downloaded as DMUS_DOWNLOADINFO_INSTRUMENT carries its DLS
level 1 articulation as DMUS_ARTICPARAMS (LFO, volume envelope, pitch
envelope, default pan). The synthesizer ignored it, so such instruments
played with default envelopes. Each member is now turned into the DLS level
1 connection block it stands for (for example VolEG.tcAttack into
CONN_SRC_NONE -> CONN_DST_EG1_ATTACKTIME, PitchEG.pcRange into CONN_SRC_EG2
-> CONN_DST_PITCH), and the instrument uses them as it uses a level 2
articulation's connection list. Wine's own dmusic always downloads level 2
instruments; a native dmusic.dll sends level 1 ones.

Gate: test/dmsynth-dls1-gate.sh (64/32).
---
 dlls/dmsynth/synth.c | 70 ++++++++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 65 insertions(+), 5 deletions(-)

diff --git a/dlls/dmsynth/synth.c b/dlls/dmsynth/synth.c
index 5e8a37e..aa35676 100644
--- a/dlls/dmsynth/synth.c
+++ b/dlls/dmsynth/synth.c
@@ -696,16 +696,76 @@ static HRESULT synth_download_articulation2(struct synth *This, ULONG *offsets,
     return S_OK;
 }
 
+/* DMUS_ARTICPARAMS is the DLS level 1 articulation ('art1') in fixed form:
+ * each member is the scale of one of the level 1 connection blocks */
+static const struct
+{
+    USHORT source, control, destination;
+    size_t offset;
+}
+dls1_connections[] =
+{
+    {CONN_SRC_NONE, CONN_SRC_NONE, CONN_DST_LFO_FREQUENCY, offsetof(DMUS_ARTICPARAMS, LFO.pcFrequency)},
+    {CONN_SRC_NONE, CONN_SRC_NONE, CONN_DST_LFO_STARTDELAY, offsetof(DMUS_ARTICPARAMS, LFO.tcDelay)},
+    {CONN_SRC_LFO, CONN_SRC_NONE, CONN_DST_ATTENUATION, offsetof(DMUS_ARTICPARAMS, LFO.gcVolumeScale)},
+    {CONN_SRC_LFO, CONN_SRC_NONE, CONN_DST_PITCH, offsetof(DMUS_ARTICPARAMS, LFO.pcPitchScale)},
+    {CONN_SRC_LFO, CONN_SRC_CC1, CONN_DST_ATTENUATION, offsetof(DMUS_ARTICPARAMS, LFO.gcMWToVolume)},
+    {CONN_SRC_LFO, CONN_SRC_CC1, CONN_DST_PITCH, offsetof(DMUS_ARTICPARAMS, LFO.pcMWToPitch)},
+    {CONN_SRC_NONE, CONN_SRC_NONE, CONN_DST_EG1_ATTACKTIME, offsetof(DMUS_ARTICPARAMS, VolEG.tcAttack)},
+    {CONN_SRC_NONE, CONN_SRC_NONE, CONN_DST_EG1_DECAYTIME, offsetof(DMUS_ARTICPARAMS, VolEG.tcDecay)},
+    {CONN_SRC_NONE, CONN_SRC_NONE, CONN_DST_EG1_SUSTAINLEVEL, offsetof(DMUS_ARTICPARAMS, VolEG.ptSustain)},
+    {CONN_SRC_NONE, CONN_SRC_NONE, CONN_DST_EG1_RELEASETIME, offsetof(DMUS_ARTICPARAMS, VolEG.tcRelease)},
+    {CONN_SRC_KEYONVELOCITY, CONN_SRC_NONE, CONN_DST_EG1_ATTACKTIME, offsetof(DMUS_ARTICPARAMS, VolEG.tcVel2Attack)},
+    {CONN_SRC_KEYNUMBER, CONN_SRC_NONE, CONN_DST_EG1_DECAYTIME, offsetof(DMUS_ARTICPARAMS, VolEG.tcKey2Decay)},
+    {CONN_SRC_NONE, CONN_SRC_NONE, CONN_DST_EG2_ATTACKTIME, offsetof(DMUS_ARTICPARAMS, PitchEG.tcAttack)},
+    {CONN_SRC_NONE, CONN_SRC_NONE, CONN_DST_EG2_DECAYTIME, offsetof(DMUS_ARTICPARAMS, PitchEG.tcDecay)},
+    {CONN_SRC_NONE, CONN_SRC_NONE, CONN_DST_EG2_SUSTAINLEVEL, offsetof(DMUS_ARTICPARAMS, PitchEG.ptSustain)},
+    {CONN_SRC_NONE, CONN_SRC_NONE, CONN_DST_EG2_RELEASETIME, offsetof(DMUS_ARTICPARAMS, PitchEG.tcRelease)},
+    {CONN_SRC_KEYONVELOCITY, CONN_SRC_NONE, CONN_DST_EG2_ATTACKTIME, offsetof(DMUS_ARTICPARAMS, PitchEG.tcVel2Attack)},
+    {CONN_SRC_KEYNUMBER, CONN_SRC_NONE, CONN_DST_EG2_DECAYTIME, offsetof(DMUS_ARTICPARAMS, PitchEG.tcKey2Decay)},
+    {CONN_SRC_EG2, CONN_SRC_NONE, CONN_DST_PITCH, offsetof(DMUS_ARTICPARAMS, PitchEG.pcRange)},
+    {CONN_SRC_NONE, CONN_SRC_NONE, CONN_DST_PAN, offsetof(DMUS_ARTICPARAMS, Misc.ptDefaultPan)},
+};
+
+static HRESULT synth_download_articulation1(struct synth *This, ULONG *offsets, BYTE *data,
+        UINT index, struct list *articulations)
+{
+    DMUS_ARTICULATION *articulation_info = (DMUS_ARTICULATION *)(data + offsets[index]);
+    const DMUS_ARTICPARAMS *params;
+    struct articulation *articulation;
+    UINT i, count = ARRAY_SIZE(dls1_connections);
+
+    if (articulation_info->ulFirstExtCkIdx) FIXME("Articulation extensions not implemented\n");
+    if (!articulation_info->ulArt1Idx) return S_OK;
+    params = (const DMUS_ARTICPARAMS *)(data + offsets[articulation_info->ulArt1Idx]);
+
+#ifdef SG_MUTANT_DLS1_DROPPED
+    return S_OK;
+#endif
+    if (!(articulation = calloc(1, offsetof(struct articulation, connections[count])))) return E_OUTOFMEMORY;
+    articulation->list.cbSize = sizeof(articulation->list);
+    articulation->list.cConnections = count;
+    for (i = 0; i < count; i++)
+    {
+        CONNECTION *connection = &articulation->connections[i];
+
+        connection->usSource = dls1_connections[i].source;
+        connection->usControl = dls1_connections[i].control;
+        connection->usDestination = dls1_connections[i].destination;
+        connection->usTransform = CONN_TRN_NONE;
+        connection->lScale = *(const LONG *)((const BYTE *)params + dls1_connections[i].offset);
+    }
+    if (TRACE_ON(dmsynth)) dump_connectionlist(&articulation->list);
+    list_add_tail(articulations, &articulation->entry);
+    return S_OK;
+}
+
 static HRESULT synth_download_articulation(struct synth *This, DMUS_DOWNLOADINFO *info, ULONG *offsets, BYTE *data,
         UINT index, struct list *list)
 {
     if (info->dwDLType == DMUS_DOWNLOADINFO_INSTRUMENT2)
         return synth_download_articulation2(This, offsets, data, index, list);
-    else
-    {
-        FIXME("DMUS_ARTICPARAMS support not implemented\n");
-        return S_OK;
-    }
+    return synth_download_articulation1(This, offsets, data, index, list);
 }
 
 static struct wave *synth_find_wave_from_id(struct synth *This, DWORD id)
