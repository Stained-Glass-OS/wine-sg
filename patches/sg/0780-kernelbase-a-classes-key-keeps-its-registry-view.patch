From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: a classes key keeps its registry view

7-Zip's x64 setup (a 32-bit program) registers its shell extension's CLSID
twice through HKEY_CLASSES_ROOT: for 32-bit programs, then with
KEY_WOW64_64KEY for 64-bit ones. The merged view (0178) re-opens a key by
its path for each value written and for keys opened below it, and dropped
the view flag on the way: the 64-bit registration's values went into the
32-bit view over the 32-bit one, and 64-bit COM found no server -- the
7-Zip menu never appeared.

A key of the merged view now remembers the view it was opened in, and its
values and the keys opened below it (unless asked otherwise) stay in it.

Test: test/hkcrview-gate.sh (a 32-bit probe registering both, as 7-Zip;
mutant SG_MUTANT_CLASSES_VIEW_LOST).
---
--- a/dlls/kernelbase/registry.c
+++ b/dlls/kernelbase/registry.c
@@ -609,6 +609,9 @@
     HKEY hkey;
     WCHAR *path;          /* below Classes, no leading backslash */
     BOOL user_bound;      /* opened on the user's key: stays with it */
+    ACCESS_MASK wow;      /* the registry view it was opened in (KEY_WOW64_64KEY / 32KEY): a
+                           * 32-bit installer's 64-bit CLSID kept its values in the 32-bit
+                           * view when they were written through it (7-Zip, 2026-10-03) */
     WCHAR **names;        /* merged subkey names, while enumerating */
     DWORD count;
 };
@@ -659,7 +662,7 @@
     return ret;
 }
 
-static void track_classes_key( HKEY hkey, const WCHAR *path, BOOL user_bound )
+static void track_classes_key( HKEY hkey, const WCHAR *path, BOOL user_bound, ACCESS_MASK wow )
 {
     struct classes_key *key;
 
@@ -672,11 +675,26 @@
     lstrcpyW( key->path, path );
     key->hkey = hkey;
     key->user_bound = user_bound;
+#ifndef SG_MUTANT_CLASSES_VIEW_LOST
+    key->wow = wow & (KEY_WOW64_64KEY | KEY_WOW64_32KEY);
+#endif
     RtlEnterCriticalSection( &classes_cs );
     list_add_head( &classes_keys, &key->entry );
     RtlLeaveCriticalSection( &classes_cs );
 }
 
+/* the view a key of the merged view was opened in (0: the caller's own) */
+static ACCESS_MASK classes_wow( HKEY hkey )
+{
+    struct classes_key *key;
+    ACCESS_MASK ret = 0;
+
+    RtlEnterCriticalSection( &classes_cs );
+    if ((key = find_classes_key( hkey ))) ret = key->wow;
+    RtlLeaveCriticalSection( &classes_cs );
+    return ret;
+}
+
 static void untrack_classes_key( HKEY hkey )
 {
     struct classes_key *key;
@@ -745,7 +763,7 @@
                              BOOL *deleted )
 {
     *deleted = FALSE;
-    open_classes_sides( path, access, user, machine );
+    open_classes_sides( path, access | classes_wow( hkey ), user, machine );
     if (!is_user_bound( hkey )) return;
     if (*user) NtClose( *user );
     *user = 0;
@@ -789,7 +807,8 @@
 
 /* open (or create) a key of the merged view */
 static NTSTATUS open_classes_key( HKEY *retkey, const WCHAR *base, const UNICODE_STRING *name, DWORD options,
-                                  ACCESS_MASK access, BOOL create, const UNICODE_STRING *class, DWORD *dispos )
+                                  ACCESS_MASK access, BOOL create, const UNICODE_STRING *class, DWORD *dispos,
+                                  ACCESS_MASK parent_wow )
 {
     UNICODE_STRING pathW, userW;
     WCHAR *path, *user_path = NULL;
@@ -798,6 +817,8 @@
     BOOL user_bound = FALSE;
     HKEY user_root, machine_root;
 
+    /* a key below one opened in a view is in that view, unless asked otherwise */
+    if (!(access & (KEY_WOW64_64KEY | KEY_WOW64_32KEY))) access |= parent_wow;
     if (!(path = join_classes_path( base, name ))) return STATUS_NO_MEMORY;
     RtlInitUnicodeString( &pathW, path );
     user_root = get_special_root_hkey( HKEY_CURRENT_USER );
@@ -827,7 +848,7 @@
     if (!status)
     {
         *retkey = (HKEY)((UINT_PTR)*retkey | 2);  /* Windows marks HKCR's keys so */
-        track_classes_key( *retkey, path, user_bound );
+        track_classes_key( *retkey, path, user_bound, access );
     }
     heap_free( user_path );
     heap_free( path );
@@ -1139,7 +1160,8 @@
 
     if ((path = get_classes_path( hkey )))
     {
-        NTSTATUS status = open_classes_key( retkey, path, &nameW, options, access, TRUE, &classW, dispos );
+        NTSTATUS status = open_classes_key( retkey, path, &nameW, options, access, TRUE, &classW, dispos,
+                                            classes_wow( hkey ) );
         heap_free( path );
         return RtlNtStatusToDosError( status );
     }
@@ -1201,7 +1223,7 @@
             {
                 if (path)
                     status = open_classes_key( retkey, path, &NtCurrentTeb()->StaticUnicodeString, options, access,
-                                               TRUE, &classW, dispos );
+                                               TRUE, &classW, dispos, classes_wow( hkey ) );
                 else
                     status = create_key( retkey, hkey, NtCurrentTeb()->StaticUnicodeString, options, access, &classW, dispos );
                 RtlFreeUnicodeString( &classW );
@@ -1241,7 +1263,8 @@
         WCHAR *path = get_classes_path( hkey );
         if (path)
         {
-            NTSTATUS status = open_classes_key( retkey, path, &nameW, options, access, FALSE, NULL, NULL );
+            NTSTATUS status = open_classes_key( retkey, path, &nameW, options, access, FALSE, NULL, NULL,
+                                                classes_wow( hkey ) );
             heap_free( path );
             return RtlNtStatusToDosError( status );
         }
@@ -1301,7 +1324,8 @@
                                                      &nameA, FALSE )))
         {
             UNICODE_STRING nameW = NtCurrentTeb()->StaticUnicodeString;
-            if (path) status = open_classes_key( retkey, path, &nameW, options, access, FALSE, NULL, NULL );
+            if (path) status = open_classes_key( retkey, path, &nameW, options, access, FALSE, NULL, NULL,
+                                                 classes_wow( hkey ) );
             else status = open_key( retkey, hkey, &nameW, options, access, FALSE );
         }
         heap_free( path );
