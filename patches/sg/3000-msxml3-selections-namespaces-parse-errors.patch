+
+        /* a document receives the result by parsing it; anything else must be a stream */
+        if (IUnknown_QueryInterface(V_UNKNOWN(&output), &IID_IXMLDOMDocument, (void **)&doc) == S_OK)
+        {
+            VARIANT_BOOL b;
