+HRESULT node_transform_node_to_object(const xmlnode *node, IXMLDOMNode *stylesheet, VARIANT output)
+{
+    switch (V_VT(&output))
+    {
+    case VT_UNKNOWN:
+    case VT_DISPATCH:
+    {
+        ISequentialStream *stream;
+        IXMLDOMDocument *doc;
+        HRESULT hr;
+        BSTR str;
