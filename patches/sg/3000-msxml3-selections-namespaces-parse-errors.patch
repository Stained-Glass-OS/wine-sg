+/* The tail of a text node, from offset, becomes a text node of its own next to it. libxml2 would
+ * merge the two when linking them, so the new node is linked by hand. */
+static HRESULT text_split(IXMLDOMText *iface, LONG offset, LONG length, IXMLDOMText **txtNode)
+{
+    domtext *This = impl_from_IXMLDOMText( iface );
+    IXMLDOMDocument *doc;
+    IXMLDOMText *tail;
+    xmlNodePtr node, parent, new_node;
+    BSTR data;
+    HRESULT hr;
+
+    if (FAILED(hr = IXMLDOMText_get_ownerDocument(iface, &doc))) return hr;
+
+    hr = IXMLDOMText_substringData(iface, offset, length - offset, &data);
+    if (hr == S_OK)
+    {
+        hr = IXMLDOMDocument_createTextNode(doc, data, &tail);
+        SysFreeString(data);
+    }
+    IXMLDOMDocument_Release(doc);
+    if (hr != S_OK) return hr;
+
+    if (FAILED(hr = IXMLDOMText_deleteData(iface, offset, length - offset)))
+    {
+        IXMLDOMText_Release(tail);
+        return hr;
+    }
+
+    node = This->node.node;
+    new_node = get_node_obj((IXMLDOMNode *)tail)->node;
+    if ((parent = node->parent))
+    {
+        xmldoc_remove_orphan(new_node->doc, new_node);
+        new_node->parent = parent;
+        new_node->prev = node;
+        new_node->next = node->next;
+        if (node->next) node->next->prev = new_node;
+        else parent->last = new_node;
+        node->next = new_node;
+    }
+
+    *txtNode = tail;
+    return S_OK;
+}
+
