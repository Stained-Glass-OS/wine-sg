+static xmlParserInputPtr resolve_from_stream(saxlocator *locator, IUnknown *unk)
+{
+    ISequentialStream *stream;
+    xmlParserInputBufferPtr buf;
+    xmlParserInputPtr input = NULL;
+    char data[4096], *mem = NULL;
+    size_t size = 0, cap = 0;
+    ULONG read;
+
+    if (FAILED(IUnknown_QueryInterface(unk, &IID_ISequentialStream, (void **)&stream)) &&
+        FAILED(IUnknown_QueryInterface(unk, &IID_IStream, (void **)&stream)))
+        return NULL;
+
+    for (;;)
+    {
+        read = 0;
+        if (FAILED(ISequentialStream_Read(stream, data, sizeof(data), &read)) || !read) break;
+        if (size + read > cap)
+        {
+            char *tmp = realloc(mem, cap = max(cap * 2, size + read));
+            if (!tmp) { free(mem); mem = NULL; size = 0; break; }
+            mem = tmp;
+        }
+        memcpy(mem + size, data, read);
+        size += read;
+    }
+    ISequentialStream_Release(stream);
+
+    if (mem && size && (buf = xmlParserInputBufferCreateMem(mem, size, XML_CHAR_ENCODING_NONE)))
+    {
+        /* libxml copies the memory into the buffer */
+        input = xmlNewIOInputStream(locator->pParserCtxt, buf, XML_CHAR_ENCODING_NONE);
+        if (!input) xmlFreeParserInputBuffer(buf);
+    }
+    free(mem);
+    return input;
+}
+
 static xmlParserInputPtr libxmlresolveentity(void *ctx, const xmlChar *publicid, const xmlChar *systemid)
 {
-    FIXME("entity resolving not implemented, %s, %s\n", publicid, systemid);
-    return xmlSAX2ResolveEntity(ctx, publicid, systemid);
+    saxlocator *locator = ctx;
+    struct saxentityresolver_iface *resolver = &locator->saxreader->saxhandlers[SAXEntityResolver].u.entityresolver;
+    xmlParserInputPtr input = NULL;
+    BSTR pub, sys;
+    VARIANT ret;
+    HRESULT hr;
+
+    TRACE("%s, %s\n", debugstr_a((const char *)publicid), debugstr_a((const char *)systemid));
+
+    if (!resolver->handler && !resolver->vbhandler)
+        return xmlSAX2ResolveEntity(locator->pParserCtxt, publicid, systemid);
+
+    pub = bstr_from_xmlChar(publicid);
+    sys = bstr_from_xmlChar(systemid);
+    VariantInit(&ret);
+
+    if (locator->vbInterface)
+        hr = IVBSAXEntityResolver_resolveEntity(resolver->vbhandler, &pub, &sys, &ret);
+    else
+        hr = ISAXEntityResolver_resolveEntity(resolver->handler, pub, sys, &ret);
+
+    if (FAILED(hr))
+    {
+        format_error_message_from_id(locator, hr);
+    }
+    else
+    {
+        switch (V_VT(&ret))
+        {
+        case VT_BSTR:
+        {
+            xmlChar *url = V_BSTR(&ret) && *V_BSTR(&ret) ? xmlchar_from_wchar(V_BSTR(&ret)) : NULL;
+            if (url)
+            {
+                input = xmlLoadExternalEntity((const char *)url, (const char *)publicid, locator->pParserCtxt);
+                free(url);
+            }
+            else
+                input = xmlSAX2ResolveEntity(locator->pParserCtxt, publicid, systemid);
+            break;
+        }
+        case VT_UNKNOWN:
+        case VT_DISPATCH:
+            if (V_UNKNOWN(&ret)) input = resolve_from_stream(locator, V_UNKNOWN(&ret));
+            break;
+        default:
+            /* nothing returned: use the default resolution */
+            input = xmlSAX2ResolveEntity(locator->pParserCtxt, publicid, systemid);
+            break;
+        }
+    }
+
+    VariantClear(&ret);
+    SysFreeString(pub);
+    SysFreeString(sys);
+    return input;
 }
 
