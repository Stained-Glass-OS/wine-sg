+static void clear_parse_error(domdoc *doc)
+{
+    SysFreeString(doc->perr.reason);
+    SysFreeString(doc->perr.srcText);
+    memset(&doc->perr, 0, sizeof(doc->perr));
+}
+
+/* the text of line 'line' (1-based) of a parser input, and its offset in characters */
+static BSTR parse_error_source_text(const char *buf, int len, xmlCharEncoding enc, int line, int *line_start)
+{
+    BSTR ret;
+    int i, n;
+
+    *line_start = 0;
+    if (!buf || line < 1) return NULL;
+
+    if (enc == XML_CHAR_ENCODING_UTF16LE)
+    {
+        const WCHAR *w = (const WCHAR *)buf, *p = w, *end = w + len / sizeof(WCHAR), *eol;
+
+        for (i = 1; i < line && p < end; i++)
+        {
+            while (p < end && *p != '\n') p++;
+            if (p == end) return NULL;
+            p++;
+        }
+        *line_start = p - w;
+        eol = p;
+        while (eol < end && *eol != '\n' && *eol != '\r') eol++;
+        if (eol - p > 4096) eol = p + 4096;
+        return SysAllocStringLen(p, eol - p);
+    }
+    else
+    {
+        const char *p = buf, *end = buf + len, *eol;
+
+        /* only ASCII-compatible 8-bit input can be cut into lines here */
+        if (len >= 2 && (((unsigned char)buf[0] == 0xff && (unsigned char)buf[1] == 0xfe) ||
+                ((unsigned char)buf[0] == 0xfe && (unsigned char)buf[1] == 0xff)))
+            return NULL;
+        if (len >= 2 && (!buf[0] || !buf[1])) return NULL;
+
+        for (i = 1; i < line && p < end; i++)
+        {
+            const char *nl = memchr(p, '\n', end - p);
+            if (!nl) return NULL;
+            p = nl + 1;
+        }
+        *line_start = p - buf;
+        eol = p;
+        while (eol < end && *eol != '\n' && *eol != '\r') eol++;
+        if (eol - p > 4096) eol = p + 4096;
+        n = MultiByteToWideChar(CP_UTF8, 0, p, eol - p, NULL, 0);
+        if (!n && eol != p) return NULL;
+        if (!(ret = SysAllocStringLen(NULL, n))) return NULL;
+        MultiByteToWideChar(CP_UTF8, 0, p, eol - p, ret, n);
+        return ret;
+    }
+}
+
+/* What msxml calls an error libxml2 found: the error code and, when known, the wording. */
+static LONG msxml_error_code( const xmlError *err, BOOL empty_input, BSTR *reason )
+{
+    static const struct { int code; LONG msxml; } map[] =
+    {
+        { XML_ERR_TAG_NAME_MISMATCH,         0xC00CE56D }, /* XML_E_ENDTAGMISMATCH */
+        { XML_ERR_NAME_REQUIRED,             0xC00CE56B }, /* XML_E_EXPECTING_NAME */
+        { XML_ERR_ATTRIBUTE_REDEFINED,       0xC00CE554 }, /* XML_E_DUPLICATEATTRIBUTE */
+        { XML_ERR_LT_IN_ATTRIBUTE,           0xC00CE506 }, /* XML_E_BADCHARINSTRING */
+        { XML_ERR_ATTRIBUTE_NOT_STARTED,     0xC00CE502 }, /* XML_E_MISSINGQUOTE */
+        { XML_ERR_ATTRIBUTE_WITHOUT_VALUE,   0xC00CE501 }, /* XML_E_MISSINGEQUALS */
+        { XML_ERR_ATTRIBUTE_NOT_FINISHED,    0xC00CE560 }, /* XML_E_UNCLOSEDSTRING */
+        { XML_ERR_LTSLASH_REQUIRED,          0xC00CE50A }, /* XML_E_EXPECTINGTAGEND */
+        { XML_ERR_GT_REQUIRED,               0xC00CE50A }, /* XML_E_EXPECTINGTAGEND */
+        { XML_ERR_COMMENT_NOT_FINISHED,      0xC00CE561 }, /* XML_E_UNCLOSEDCOMMENT */
+        { XML_ERR_PI_NOT_STARTED,            0xC00CE51A }, /* XML_E_PIDECLSYNTAX */
+        { XML_ERR_PI_NOT_FINISHED,           0xC00CE55D }, /* XML_E_UNCLOSEDPI */
+        { XML_ERR_CDATA_NOT_FINISHED,        0xC00CE564 }, /* XML_E_UNCLOSEDCDATA */
+        { XML_ERR_XMLDECL_NOT_FINISHED,      0xC00CE507 }, /* XML_E_XMLDECLSYNTAX */
+        { XML_ERR_UNSUPPORTED_ENCODING,      0xC00CE56E }, /* XML_E_INVALIDENCODING */
+        { XML_ERR_UNKNOWN_ENCODING,          0xC00CE56E }, /* XML_E_INVALIDENCODING */
+        { XML_ERR_UNDECLARED_ENTITY,         0xC00CE57C }, /* XML_E_MISSING_ENTITY */
+        { XML_WAR_UNDECLARED_ENTITY,         0xC00CE57C }, /* XML_E_MISSING_ENTITY */
+        { XML_ERR_ENTITYREF_SEMICOL_MISSING, 0xC00CE50D }, /* XML_E_MISSINGSEMICOLON */
+        { XML_ERR_ENTITYREF_NO_NAME,         0xC00CE50E }, /* XML_E_BADCHARINENTREF */
+        { XML_ERR_INVALID_CHAR,              0xC00CE508 }, /* XML_E_BADCHARDATA */
+        { XML_ERR_VERSION_MISSING,           0xC00CE569 }, /* XML_E_EXPECTING_VERSION */
+        { XML_ERR_UNSUPPORTED_ENCODING,      0xC00CE56E },
+    };
+    LONG code = 0;
+    size_t i;
+
+    switch (err->code)
+    {
+    case XML_ERR_DOCUMENT_EMPTY:
+        /* nothing at all is a missing root, something that is not markup is out of place */
+        code = empty_input ? 0xC00CE558 /* XML_E_MISSINGROOT */ : 0xC00CE556 /* XML_E_INVALIDATROOTLEVEL */;
+        break;
+    case XML_ERR_DOCUMENT_END:
+        code = 0xC00CE556; /* XML_E_INVALIDATROOTLEVEL */
+        break;
+    case XML_ERR_TAG_NOT_FINISHED:
+    case XML_ERR_NOT_WELL_BALANCED:
+        code = 0xC00CE553; /* XML_E_UNCLOSEDTAG */
+        break;
+    default:
+        for (i = 0; i < ARRAY_SIZE(map); i++)
+            if (map[i].code == err->code) { code = map[i].msxml; break; }
+    }
+
+    *reason = NULL;
+    if (code == (LONG)0xC00CE56D && err->str1 && err->str2)
+    {
+        WCHAR text[512];
+        WCHAR start[128], end[128];
+
+        MultiByteToWideChar(CP_UTF8, 0, err->str1, -1, start, ARRAY_SIZE(start));
+        MultiByteToWideChar(CP_UTF8, 0, err->str2, -1, end, ARRAY_SIZE(end));
+        start[ARRAY_SIZE(start) - 1] = end[ARRAY_SIZE(end) - 1] = 0;
+        swprintf(text, ARRAY_SIZE(text), L"End tag '%s' does not match the start tag '%s'.\r\n", end, start);
+        *reason = SysAllocString(text);
+    }
+    else if (code == (LONG)0xC00CE556)
+        *reason = SysAllocString(L"Invalid at the top level of the document.\r\n");
+    else if (code == (LONG)0xC00CE558)
+        *reason = SysAllocString(L"XML document must have a top level element.\r\n");
+    return code;
+}
+
+static BOOL input_is_blank( const char *buf, int len, xmlCharEncoding enc )
+{
+    int i;
+
+    if (!buf) return TRUE;
+    if (enc == XML_CHAR_ENCODING_UTF16LE)
+    {
+        const WCHAR *w = (const WCHAR *)buf;
+        for (i = 0; i < len / (int)sizeof(WCHAR); i++)
+            if (w[i] != ' ' && w[i] != '\t' && w[i] != '\r' && w[i] != '\n' && w[i] != 0xfeff) return FALSE;
+        return TRUE;
+    }
+    for (i = 0; i < len; i++)
+        if (buf[i] != ' ' && buf[i] != '\t' && buf[i] != '\r' && buf[i] != '\n' && buf[i] != 0) return FALSE;
+    return TRUE;
+}
+
+static void record_parse_error(domdoc *doc, const xmlError *err, const char *buf, int len, xmlCharEncoding enc)
+{
+    BSTR msg;
+    int n, start;
+    size_t mlen;
+
+    if (!doc || doc->perr.reason || !err || err->level < XML_ERR_ERROR) return;
+
+    doc->perr.code = msxml_error_code(err, input_is_blank(buf, len, enc), &msg);
+    if (!msg)
+    {
+        mlen = err->message ? strlen(err->message) : 0;
+        while (mlen && (err->message[mlen - 1] == '\n' || err->message[mlen - 1] == '\r')) mlen--;
+        n = MultiByteToWideChar(CP_UTF8, 0, err->message ? err->message : "", mlen, NULL, 0);
+        if ((msg = SysAllocStringLen(NULL, n + 2)))
+        {
+            MultiByteToWideChar(CP_UTF8, 0, err->message ? err->message : "", mlen, msg, n);
+            wcscpy(msg + n, L"\r\n");
+        }
+    }
+    doc->perr.reason = msg;
+    doc->perr.line = err->line;
+    doc->perr.linepos = err->int2;
+    doc->perr.srcText = parse_error_source_text(buf, len, enc, err->line, &start);
+    doc->perr.filepos = start + (err->int2 > 0 ? err->int2 - 1 : 0);
+}
