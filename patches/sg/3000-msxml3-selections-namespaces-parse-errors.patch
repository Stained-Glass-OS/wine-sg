+static HRESULT node_namespace_uri(xmlNodePtr node, const WCHAR *prefix, BSTR *uri)
+{
+    xmlChar *pfx = *prefix ? xmlchar_from_wchar(prefix) : NULL;
+    xmlNs *ns;
+
+    *uri = NULL;
+    if (*prefix && !pfx) return E_OUTOFMEMORY;
+
+    if (node->type == XML_ATTRIBUTE_NODE || node->type == XML_ELEMENT_NODE)
+        ns = xmlSearchNs(node->doc, node->type == XML_ATTRIBUTE_NODE ? node->parent : node, pfx);
+    else
+        ns = node->parent ? xmlSearchNs(node->doc, node->parent, pfx) : NULL;
+    free(pfx);
+
+    if (!ns || !ns->href) return S_FALSE;
+    if (!(*uri = bstr_from_xmlChar(ns->href))) return E_OUTOFMEMORY;
+    return S_OK;
+}
