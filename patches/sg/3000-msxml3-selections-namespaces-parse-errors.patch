+static HRESULT collect_prefixes(const struct list *ctxts, const WCHAR *uri, BOOL all_contexts,
+        IMXNamespacePrefixes **out)
+{
+    const struct nscontext *ctxt;
+    BSTR *prefixes = NULL;
+    LONG count = 0, cap = 0, i, j;
+
+    *out = NULL;
+
+    LIST_FOR_EACH_ENTRY(ctxt, ctxts, struct nscontext, entry)
+    {
+        for (i = 0; i < ctxt->count; i++)
+        {
+            BOOL dup = FALSE;
+
+            if (uri && wcscmp(ctxt->ns[i].uri, uri)) continue;
+            for (j = 0; j < count; j++)
+                if (!wcscmp(prefixes[j], ctxt->ns[i].prefix)) { dup = TRUE; break; }
+            if (dup) continue;
+
+            if (count == cap)
+            {
+                BSTR *tmp = realloc(prefixes, (cap = cap ? cap * 2 : 8) * sizeof(*prefixes));
+                if (!tmp) goto fail;
+                prefixes = tmp;
+            }
+            if (!(prefixes[count] = SysAllocString(ctxt->ns[i].prefix))) goto fail;
+            count++;
+        }
+        if (!all_contexts) break;
+    }
+
+    return create_nsprefixes(prefixes, count, out);
+
+fail:
+    for (i = 0; i < count; i++) SysFreeString(prefixes[i]);
+    free(prefixes);
+    return E_OUTOFMEMORY;
+}
