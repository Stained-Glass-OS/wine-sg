+static void declare_node_namespaces(namespacemanager *This, xmlNodePtr node, BOOL deep)
+{
+    VARIANT_BOOL override = This->override;
+    xmlNodePtr cur;
+    xmlNs *ns;
+
+    /* declarations already in the context win, in scope order */
+    This->override = VARIANT_FALSE;
+
+    for (cur = node; cur; cur = cur->parent)
+    {
+        if (cur->type != XML_ELEMENT_NODE) continue;
+        for (ns = cur->nsDef; ns; ns = ns->next)
+        {
+            BSTR prefix = xml_ns_prefix_bstr(ns), uri = bstr_from_xmlChar(ns->href);
+            if (prefix && uri) declare_prefix(This, prefix, uri);
+            SysFreeString(prefix);
+            SysFreeString(uri);
+        }
+    }
+
+    if (deep && node->type == XML_ELEMENT_NODE)
+    {
+        cur = node->children;
+        while (cur)
+        {
+            if (cur->type == XML_ELEMENT_NODE)
+            {
+                for (ns = cur->nsDef; ns; ns = ns->next)
+                {
+                    BSTR prefix = xml_ns_prefix_bstr(ns), uri = bstr_from_xmlChar(ns->href);
+                    if (prefix && uri) declare_prefix(This, prefix, uri);
+                    SysFreeString(prefix);
+                    SysFreeString(uri);
+                }
+                if (cur->children) { cur = cur->children; continue; }
+            }
+            while (cur && cur != node && !cur->next) cur = cur->parent;
+            if (!cur || cur == node) break;
+            cur = cur->next;
+        }
+    }
+
+    This->override = override;
+}
