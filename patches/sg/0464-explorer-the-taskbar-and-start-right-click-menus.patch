+/* Stained Glass OS: the bar's own menu, as Windows 10's: search, the Task
+ * View button, Show the desktop, Task Manager, Lock the taskbar and Taskbar
+ * settings. It writes what Settings > Personalization > Taskbar writes, and
+ * the bar follows the same way (WM_SETTINGCHANGE "TraySettings"). */
+enum { SG_MENU_SEARCH_OFF = 1, SG_MENU_SEARCH_ICON, SG_MENU_SEARCH_BOX, SG_MENU_TASKVIEW, SG_MENU_DESKTOP,
+       SG_MENU_TASKMGR, SG_MENU_LOCK, SG_MENU_SETTINGS };
+
+static void sg_set_dword( const WCHAR *key, const WCHAR *name, DWORD value )
+{
+    RegSetKeyValueW( HKEY_CURRENT_USER, key, name, REG_DWORD, &value, sizeof(value) );
+    SendMessageTimeoutW( HWND_BROADCAST, WM_SETTINGCHANGE, 0, (LPARAM)L"TraySettings",
+                         SMTO_ABORTIFHUNG, 2000, NULL );
+}
+
+static void sg_taskbar_menu( LPARAM lparam )
+{
+    static const WCHAR search_key[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Search";
+    HMENU menu = CreatePopupMenu(), search = CreatePopupMenu();
+    BOOL locked = !sg_reg_dword( sg_advanced_key, L"TaskbarSizeMove", 0 );
+    POINT pt = { (short)LOWORD(lparam), (short)HIWORD(lparam) };
+    int cmd;
+
+    if (lparam == -1) { RECT rc; GetWindowRect( tray_window, &rc ); pt.x = rc.left; pt.y = rc.top; }
+    AppendMenuW( search, MF_STRING | (sg_bar.search == 0 ? MF_CHECKED : 0), SG_MENU_SEARCH_OFF, L"&Hidden" );
+    AppendMenuW( search, MF_STRING | (sg_bar.search == 1 ? MF_CHECKED : 0), SG_MENU_SEARCH_ICON, L"Show search &icon" );
+    AppendMenuW( search, MF_STRING | (sg_bar.search == 2 ? MF_CHECKED : 0), SG_MENU_SEARCH_BOX, L"Show search &box" );
+    AppendMenuW( menu, MF_POPUP, (UINT_PTR)search, L"S&earch" );
+    AppendMenuW( menu, MF_STRING | (sg_bar.taskview ? MF_CHECKED : 0), SG_MENU_TASKVIEW, L"Show Task &View button" );
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( menu, MF_STRING, SG_MENU_DESKTOP, L"Show the &desktop" );
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( menu, MF_STRING, SG_MENU_TASKMGR, L"Tas&k Manager" );
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( menu, MF_STRING | (locked ? MF_CHECKED : 0), SG_MENU_LOCK, L"L&ock the taskbar" );
+    AppendMenuW( menu, MF_STRING, SG_MENU_SETTINGS, L"Taskbar se&ttings" );
+
+    SetForegroundWindow( tray_window );
+    cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_NONOTIFY | TPM_RIGHTBUTTON |
+                          (sg_bar.edge == ABE_TOP ? TPM_TOPALIGN : TPM_BOTTOMALIGN),
+                          pt.x, pt.y, 0, tray_window, NULL );
+    DestroyMenu( menu );   /* and the Search submenu with it */
+
+    switch (cmd)
+    {
+    case SG_MENU_SEARCH_OFF:
+    case SG_MENU_SEARCH_ICON:
+    case SG_MENU_SEARCH_BOX:
+        sg_set_dword( search_key, L"SearchboxTaskbarMode", cmd - SG_MENU_SEARCH_OFF );
+        break;
+    case SG_MENU_TASKVIEW: sg_set_dword( sg_advanced_key, L"ShowTaskViewButton", !sg_bar.taskview ); break;
+    case SG_MENU_DESKTOP: shell_show_desktop(); break;
+    case SG_MENU_TASKMGR: ShellExecuteW( NULL, NULL, L"taskmgr.exe", NULL, NULL, SW_SHOWNORMAL ); break;
+    case SG_MENU_LOCK: sg_set_dword( sg_advanced_key, L"TaskbarSizeMove", locked ); break;
+    case SG_MENU_SETTINGS:
+        if ((INT_PTR)ShellExecuteW( NULL, NULL, L"ms-settings:taskbar", NULL, NULL, SW_SHOWNORMAL ) <= 32)
+            ShellExecuteW( NULL, NULL, L"control.exe", NULL, NULL, SW_SHOWNORMAL );
+        break;
+    }
+}
+
