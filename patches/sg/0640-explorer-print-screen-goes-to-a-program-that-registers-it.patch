From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Print Screen goes to a program that registers it

The shell registered Print Screen as its own hotkey for screen snipping, so
a screenshot tool that registers it (Greenshot, ShareX) failed: "the
hotkey(s) PrintScreen could not be registered". The shell now takes Print
Screen in its low-level keyboard hook, and only while no program holds it
(it can register the key itself, and gives it straight back); otherwise the
key goes on to that program's hotkey. Wine runs low-level hooks before it
looks for hotkeys.
---
--- a/programs/explorer/shellkeys.c
+++ b/programs/explorer/shellkeys.c
@@ -531,10 +531,34 @@
 
 /* The Windows key alone: Start, on its release -- unless another key was
  * pressed while it was down (a shortcut), as on Windows. */
+/* Print Screen opens screen snipping only while no program has made it a
+ * hotkey of its own: a screenshot tool (Greenshot, ShareX) that registers it
+ * gets it, as on Windows when it asks first -- holding it ourselves made their
+ * RegisterHotKey fail ("the hotkey PrintScreen could not be registered"). */
+static BOOL sk_prtsc;
+
+static BOOL prtsc_is_ours(void)
+{
+#ifdef SG_MUTANT_PRTSC_HELD
+    return TRUE;
+#endif
+    /* free if we can take it -- then give it straight back */
+    if (!RegisterHotKey( sk_tray, SK_SNIP_PRTSC, MOD_NOREPEAT, VK_SNAPSHOT )) return FALSE;
+    UnregisterHotKey( sk_tray, SK_SNIP_PRTSC );
+    return TRUE;
+}
+
 static LRESULT CALLBACK win_key_proc( int code, WPARAM wp, LPARAM lp )
 {
     const KBDLLHOOKSTRUCT *k = (const KBDLLHOOKSTRUCT *)lp;
 
+    if (code == HC_ACTION && sk_prtsc && k->vkCode == VK_SNAPSHOT && !(k->flags & LLKHF_INJECTED) &&
+        GetAsyncKeyState( VK_MENU ) >= 0 && GetAsyncKeyState( VK_CONTROL ) >= 0 && GetAsyncKeyState( VK_SHIFT ) >= 0 &&
+        GetAsyncKeyState( VK_LWIN ) >= 0 && GetAsyncKeyState( VK_RWIN ) >= 0 && prtsc_is_ours())
+    {
+        if (wp == WM_KEYDOWN || wp == WM_SYSKEYDOWN) PostMessageW( sk_tray, WM_HOTKEY, SK_SNIP_PRTSC, 0 );
+        return 1;
+    }
     if (code == HC_ACTION)
     {
         BOOL win = k->vkCode == VK_LWIN || k->vkCode == VK_RWIN;
@@ -588,12 +612,16 @@
     RegisterHotKey( tray, SK_MAG_CLOSE, MOD_WIN | MOD_NOREPEAT, VK_ESCAPE );
     RegisterHotKey( tray, SK_OSK, MOD_WIN | MOD_CONTROL | MOD_NOREPEAT, 'O' );
     /* Print Screen opens screen snipping, as Windows 11 does, unless "Use the
-     * Print screen key to open screen snipping" is turned off */
+     * Print screen key to open screen snipping" is turned off -- through the
+     * keyboard hook, while no program holds the key (win_key_proc) */
     {
         DWORD on = 1, size = sizeof(on);
         RegGetValueW( HKEY_CURRENT_USER, L"Control Panel\\Keyboard", L"PrintScreenKeyForSnippingEnabled",
                       RRF_RT_REG_DWORD, NULL, &on, &size );
+#ifdef SG_MUTANT_PRTSC_HELD
         if (on) RegisterHotKey( tray, SK_SNIP_PRTSC, MOD_NOREPEAT, VK_SNAPSHOT );
+#endif
+        sk_prtsc = on != 0;
     }
     sk_hook = SetWindowsHookExW( WH_KEYBOARD_LL, win_key_proc, GetModuleHandleW( NULL ), 0 );
     {
