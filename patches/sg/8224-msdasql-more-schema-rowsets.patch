+/* (wine-sg 8224) a catalog row's ODBC columns, each read once as text: SQLGetData gives a column only once,
+ * and several OLE DB columns come from the same one */
+struct schema_value
+{
+    BOOL read, null;
+    SQLLEN len;
+    WCHAR text[1024];
+};
+
+static const struct schema_value *schema_get( SQLHSTMT hstmt, struct schema_value *cache, SQLUSMALLINT col )
+{
+    struct schema_value *v = &cache[col];
+
+    if (!v->read)
+    {
+        SQLLEN ind = SQL_NULL_DATA;
+        v->read = TRUE;
+        v->null = !SQL_SUCCEEDED(SQLGetData( hstmt, col, SQL_C_WCHAR, v->text, sizeof(v->text), &ind )) ||
+                  ind == SQL_NULL_DATA;
+        if (ind == SQL_NO_TOTAL || ind > (SQLLEN)sizeof(v->text) - (SQLLEN)sizeof(WCHAR))
+            ind = sizeof(v->text) - sizeof(WCHAR);
+        v->len = v->null ? 0 : ind;
+        v->text[v->len / sizeof(WCHAR)] = 0;
+    }
+    return v;
+}
+
