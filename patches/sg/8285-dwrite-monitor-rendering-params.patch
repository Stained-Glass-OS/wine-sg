From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: CreateMonitorRenderingParams follows the monitor's ClearType settings

CreateMonitorRenderingParams ignored the monitor and gave gamma 2.0, ClearType level 0 and a flat pixel geometry. It now reads the monitor's ClearType settings as documented (Software\Microsoft\Avalon.Graphics\<display name>: GammaLevel 1000-2200 under HKLM, default 1900; ClearTypeLevel 0-100 under HKCU, default 100; PixelStructure 0 flat, 1 RGB, 2 BGR under HKLM) and, with no pixel structure set, takes the system's font smoothing (ClearType and its orientation, else flat).
---
--- a/dlls/dwrite/main.c
+++ b/dlls/dwrite/main.c
@@ -1312,20 +1312,68 @@
     return IDWriteFactory7_CreateMonitorRenderingParams(iface, monitor, params);
 }
 
+#ifndef SG_MUTANT_NO_MONITOR_PARAMS
+/* (wine-sg 8285) A monitor's text rendering settings, as the ClearType registry settings document them
+ * (Software\Microsoft\Avalon.Graphics\<display name>): GammaLevel 1000-2200 (HKLM, default 1900),
+ * ClearTypeLevel 0-100 (HKCU, default 100), PixelStructure 0 flat / 1 RGB / 2 BGR (HKLM); with no pixel
+ * structure set, the system's font smoothing settings decide (ClearType with its orientation, else flat). */
+static DWORD avalon_value(HKEY root, const WCHAR *display, const WCHAR *name, DWORD def)
+{
+    WCHAR path[128];
+    DWORD value, size = sizeof(value);
+
+    swprintf(path, ARRAY_SIZE(path), L"Software\\Microsoft\\Avalon.Graphics\\%s", display);
+    if (RegGetValueW(root, path, name, RRF_RT_REG_DWORD, NULL, &value, &size)) return def;
+    return value;
+}
+#endif
+
 static HRESULT WINAPI dwritefactory_CreateMonitorRenderingParams(IDWriteFactory7 *iface, HMONITOR monitor,
     IDWriteRenderingParams **params)
 {
     IDWriteRenderingParams3 *params3;
-    static int fixme_once = 0;
+    float gamma = 2.0f, cleartype_level = 1.0f;
+    DWRITE_PIXEL_GEOMETRY geometry = DWRITE_PIXEL_GEOMETRY_FLAT;
     HRESULT hr;
 
     TRACE("%p, %p, %p.\n", iface, monitor, params);
 
-    if (!fixme_once++)
-        FIXME("(%p): monitor setting ignored\n", monitor);
+#ifndef SG_MUTANT_NO_MONITOR_PARAMS
+    {
+        MONITORINFOEXW info;
+        const WCHAR *display = L"DISPLAY1";
+        DWORD value, pixel_structure;
+
+        info.cbSize = sizeof(info);
+        /* "\\.\DISPLAY1" -> "DISPLAY1" */
+        if (monitor && GetMonitorInfoW(monitor, (MONITORINFO *)&info) && !wcsncmp(info.szDevice, L"\\\\.\\", 4))
+            display = info.szDevice + 4;
+
+        value = avalon_value(HKEY_LOCAL_MACHINE, display, L"GammaLevel", 1900);
+        gamma = min(max(value, 1000), 2200) / 1000.0f;
+        value = avalon_value(HKEY_CURRENT_USER, display, L"ClearTypeLevel", 100);
+        cleartype_level = min(value, 100) / 100.0f;
+        pixel_structure = avalon_value(HKEY_LOCAL_MACHINE, display, L"PixelStructure", ~0u);
+        if (pixel_structure == 1) geometry = DWRITE_PIXEL_GEOMETRY_RGB;
+        else if (pixel_structure == 2) geometry = DWRITE_PIXEL_GEOMETRY_BGR;
+        else if (pixel_structure == ~0u)
+        {
+            BOOL smoothing = FALSE;
+            UINT type = 0, orientation = FE_FONTSMOOTHINGORIENTATIONRGB;
 
-    /* FIXME: use actual per-monitor gamma factor */
-    hr = IDWriteFactory7_CreateCustomRenderingParams(iface, 2.0f, 0.0f, 1.0f, 0.0f, DWRITE_PIXEL_GEOMETRY_FLAT,
+            if (SystemParametersInfoW(SPI_GETFONTSMOOTHING, 0, &smoothing, 0) && smoothing &&
+                SystemParametersInfoW(SPI_GETFONTSMOOTHINGTYPE, 0, &type, 0) && type == FE_FONTSMOOTHINGCLEARTYPE)
+            {
+                SystemParametersInfoW(SPI_GETFONTSMOOTHINGORIENTATION, 0, &orientation, 0);
+                geometry = orientation == FE_FONTSMOOTHINGORIENTATIONBGR ? DWRITE_PIXEL_GEOMETRY_BGR
+                                                                         : DWRITE_PIXEL_GEOMETRY_RGB;
+            }
+        }
+    }
+#else
+    FIXME("(%p): monitor setting ignored\n", monitor);
+#endif
+    hr = IDWriteFactory7_CreateCustomRenderingParams(iface, gamma, 0.0f, 1.0f, cleartype_level, geometry,
         DWRITE_RENDERING_MODE1_DEFAULT, DWRITE_GRID_FIT_MODE_DEFAULT, &params3);
     *params = (IDWriteRenderingParams*)params3;
     return hr;
