From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] user32: SetDisplayConfig

SetDisplayConfig validates the SDC_* flag combinations as documented and
applies the supplied source modes through ChangeDisplaySettingsEx (all or
nothing, SDC_ALLOW_CHANGES uses the nearest mode), instead of returning
success for anything. CORE: integrator must review (patches/notes/5209.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/user32/sysparams.c b/dlls/user32/sysparams.c
--- a/dlls/user32/sysparams.c
+++ b/dlls/user32/sysparams.c
@@ -1184,16 +1184,247 @@
     return RtlNtStatusToDosError( STATUS_NOT_IMPLEMENTED );
 }
 
+/* Stained Glass OS: SetDisplayConfig.  There is no persistence database: the supplied paths
+ * are applied through the display-mode machinery (ChangeDisplaySettingsEx), the topology
+ * requests are satisfied by the current (extended) topology. */
+#define SG_SDC_TOPOLOGY_INTERNAL        0x00000001
+#define SG_SDC_TOPOLOGY_CLONE           0x00000002
+#define SG_SDC_TOPOLOGY_EXTEND          0x00000004
+#define SG_SDC_TOPOLOGY_EXTERNAL        0x00000008
+#define SG_SDC_TOPOLOGY_SUPPLIED        0x00000010
+#define SG_SDC_USE_SUPPLIED_DISPLAY_CONFIG 0x00000020
+#define SG_SDC_VALIDATE                 0x00000040
+#define SG_SDC_APPLY                    0x00000080
+#define SG_SDC_NO_OPTIMIZATION          0x00000100
+#define SG_SDC_SAVE_TO_DATABASE         0x00000200
+#define SG_SDC_ALLOW_CHANGES            0x00000400
+#define SG_SDC_PATH_PERSIST_IF_REQUIRED 0x00000800
+#define SG_SDC_FORCE_MODE_ENUMERATION   0x00001000
+#define SG_SDC_ALLOW_PATH_ORDER_CHANGES 0x00002000
+#define SG_SDC_VIRTUAL_MODE_AWARE       0x00008000
+#define SG_SDC_VIRTUAL_REFRESH_RATE_AWARE 0x00020000
+#define SG_SDC_TOPOLOGY_MASK (SG_SDC_TOPOLOGY_INTERNAL | SG_SDC_TOPOLOGY_CLONE | SG_SDC_TOPOLOGY_EXTEND | SG_SDC_TOPOLOGY_EXTERNAL)
+#define SG_SDC_KNOWN_MASK (SG_SDC_TOPOLOGY_MASK | SG_SDC_TOPOLOGY_SUPPLIED | SG_SDC_USE_SUPPLIED_DISPLAY_CONFIG | \
+        SG_SDC_VALIDATE | SG_SDC_APPLY | SG_SDC_NO_OPTIMIZATION | SG_SDC_SAVE_TO_DATABASE | SG_SDC_ALLOW_CHANGES | \
+        SG_SDC_PATH_PERSIST_IF_REQUIRED | SG_SDC_FORCE_MODE_ENUMERATION | SG_SDC_ALLOW_PATH_ORDER_CHANGES | \
+        SG_SDC_VIRTUAL_MODE_AWARE | SG_SDC_VIRTUAL_REFRESH_RATE_AWARE)
+
+struct sdc_source
+{
+    WCHAR name[CCHDEVICENAME];
+    DEVMODEW mode;
+};
+
+static BOOL sdc_path_active( const DISPLAYCONFIG_PATH_INFO *path )
+{
+    return (path->flags & DISPLAYCONFIG_PATH_ACTIVE) != 0;
+}
+
+static UINT32 sdc_path_source_mode( const DISPLAYCONFIG_PATH_INFO *path, UINT32 flags )
+{
+    return (flags & SG_SDC_VIRTUAL_MODE_AWARE) ? path->sourceInfo.sourceModeInfoIdx : path->sourceInfo.modeInfoIdx;
+}
+
+/* the closest enumerated mode of the source, for SDC_ALLOW_CHANGES */
+static BOOL sdc_nearest_mode( const WCHAR *name, DEVMODEW *mode )
+{
+    DEVMODEW cur = {.dmSize = sizeof(cur)};
+    LONGLONG best_dist = -1;
+    DWORD i;
+
+    for (i = 0; EnumDisplaySettingsExW( name, i, &cur, 0 ); i++)
+    {
+        LONGLONG dx = (LONGLONG)cur.dmPelsWidth - mode->dmPelsWidth, dy = (LONGLONG)cur.dmPelsHeight - mode->dmPelsHeight;
+        LONGLONG dist = dx * dx + dy * dy;
+
+        if (best_dist >= 0 && dist >= best_dist) continue;
+        if (ChangeDisplaySettingsExW( name, &cur, NULL, CDS_TEST, NULL ) != DISP_CHANGE_SUCCESSFUL) continue;
+        best_dist = dist;
+        mode->dmPelsWidth = cur.dmPelsWidth;
+        mode->dmPelsHeight = cur.dmPelsHeight;
+        mode->dmBitsPerPel = cur.dmBitsPerPel;
+        mode->dmDisplayFrequency = cur.dmDisplayFrequency;
+    }
+    return best_dist >= 0;
+}
+
 /***********************************************************************
  *              SetDisplayConfig (USER32.@)
  */
 LONG WINAPI SetDisplayConfig(UINT32 path_info_count, DISPLAYCONFIG_PATH_INFO *path_info, UINT32 mode_info_count,
         DISPLAYCONFIG_MODE_INFO *mode_info, UINT32 flags)
 {
-    FIXME("path_info_count %u, path_info %p, mode_info_count %u, mode_info %p, flags %#x stub.\n",
-            path_info_count, path_info, mode_info_count, mode_info, flags);
+    struct sdc_source *sources = NULL;
+    UINT32 i, active = 0, topology = flags & SG_SDC_TOPOLOGY_MASK;
+    LONG ret = ERROR_SUCCESS;
+
+    TRACE( "path_info_count %u, path_info %p, mode_info_count %u, mode_info %p, flags %#x\n",
+           path_info_count, path_info, mode_info_count, mode_info, flags );
 
+    if (flags & ~SG_SDC_KNOWN_MASK) return ERROR_INVALID_PARAMETER;
+    /* SDC_TOPOLOGY_SUPPLIED with another SDC_TOPOLOGY_XXX is ignored, not an error */
+    if ((flags & SG_SDC_TOPOLOGY_SUPPLIED) && topology) flags &= ~SG_SDC_TOPOLOGY_SUPPLIED;
+
+#ifdef SG_MUTANT_SDC_NOVALIDATE
     return ERROR_SUCCESS;
+#endif
+    if (!(flags & SG_SDC_APPLY) == !(flags & SG_SDC_VALIDATE)) return ERROR_INVALID_PARAMETER;
+    if (!!(flags & SG_SDC_USE_SUPPLIED_DISPLAY_CONFIG) == !!(flags & (SG_SDC_TOPOLOGY_MASK | SG_SDC_TOPOLOGY_SUPPLIED)))
+        return ERROR_INVALID_PARAMETER;
+    if ((flags & SG_SDC_NO_OPTIMIZATION) && !(flags & SG_SDC_APPLY)) return ERROR_INVALID_PARAMETER;
+    if ((flags & SG_SDC_SAVE_TO_DATABASE) && !(flags & SG_SDC_USE_SUPPLIED_DISPLAY_CONFIG)) return ERROR_INVALID_PARAMETER;
+    if ((flags & SG_SDC_PATH_PERSIST_IF_REQUIRED) &&
+        (flags & (SG_SDC_USE_SUPPLIED_DISPLAY_CONFIG | SG_SDC_TOPOLOGY_SUPPLIED)))
+        return ERROR_INVALID_PARAMETER;
+    if ((flags & SG_SDC_FORCE_MODE_ENUMERATION) &&
+        (!(flags & SG_SDC_APPLY) || !(flags & SG_SDC_USE_SUPPLIED_DISPLAY_CONFIG)))
+        return ERROR_INVALID_PARAMETER;
+    if ((flags & SG_SDC_ALLOW_PATH_ORDER_CHANGES) && !(flags & SG_SDC_TOPOLOGY_SUPPLIED)) return ERROR_INVALID_PARAMETER;
+
+    if (flags & (SG_SDC_USE_SUPPLIED_DISPLAY_CONFIG | SG_SDC_TOPOLOGY_SUPPLIED))
+    {
+        if (!path_info_count || !path_info) return ERROR_INVALID_PARAMETER;
+        if (mode_info_count && !mode_info) return ERROR_INVALID_PARAMETER;
+    }
+    else if (path_info_count || path_info || mode_info_count || mode_info) return ERROR_INVALID_PARAMETER;
+
+    if (!(flags & SG_SDC_USE_SUPPLIED_DISPLAY_CONFIG) && !(flags & SG_SDC_TOPOLOGY_SUPPLIED))
+    {
+        /* the only topology Wine has is the extended one (the internal one with a single display) */
+        UINT32 paths = 0, modes = 0;
+
+        if (NtUserGetDisplayConfigBufferSizes( QDC_ONLY_ACTIVE_PATHS, &paths, &modes )) return ERROR_GEN_FAILURE;
+        if ((topology & SG_SDC_TOPOLOGY_EXTEND) || ((topology & SG_SDC_TOPOLOGY_INTERNAL) && paths <= 1))
+            return ERROR_SUCCESS;
+        return ERROR_BAD_CONFIGURATION;
+    }
+
+    /* the supplied paths: every active path needs a valid source mode, a mode appears once */
+    for (i = 0; i < path_info_count; i++)
+    {
+        UINT32 idx;
+
+        if (!sdc_path_active( &path_info[i] )) continue;
+        active++;
+        idx = sdc_path_source_mode( &path_info[i], flags );
+        if (idx == DISPLAYCONFIG_PATH_MODE_IDX_INVALID) continue;
+        if (idx >= mode_info_count || mode_info[idx].infoType != DISPLAYCONFIG_MODE_INFO_TYPE_SOURCE)
+            return ERROR_INVALID_PARAMETER;
+    }
+    if (!active) return ERROR_INVALID_PARAMETER;
+
+    if (flags & SG_SDC_TOPOLOGY_SUPPLIED)
+    {
+        /* the supplied topology is satisfiable when it is the current set of active paths */
+        DISPLAYCONFIG_PATH_INFO *cur_paths;
+        DISPLAYCONFIG_MODE_INFO *cur_modes;
+        UINT32 cur_path_count = 0, cur_mode_count = 0, j, matched = 0;
+
+        if (NtUserGetDisplayConfigBufferSizes( QDC_ONLY_ACTIVE_PATHS, &cur_path_count, &cur_mode_count ))
+            return ERROR_GEN_FAILURE;
+        cur_paths = calloc( cur_path_count + 1, sizeof(*cur_paths) );
+        cur_modes = calloc( cur_mode_count + 1, sizeof(*cur_modes) );
+        if (!cur_paths || !cur_modes) { free( cur_paths ); free( cur_modes ); return ERROR_NOT_ENOUGH_MEMORY; }
+        if (NtUserQueryDisplayConfig( QDC_ONLY_ACTIVE_PATHS, &cur_path_count, cur_paths, &cur_mode_count, cur_modes, NULL ))
+            ret = ERROR_GEN_FAILURE;
+        else
+        {
+            for (i = 0; i < path_info_count; i++)
+            {
+                if (!sdc_path_active( &path_info[i] )) continue;
+                for (j = 0; j < cur_path_count; j++)
+                    if (cur_paths[j].sourceInfo.id == path_info[i].sourceInfo.id &&
+                        cur_paths[j].targetInfo.id == path_info[i].targetInfo.id &&
+                        !memcmp( &cur_paths[j].sourceInfo.adapterId, &path_info[i].sourceInfo.adapterId, sizeof(LUID) ))
+                    {
+                        matched++;
+                        break;
+                    }
+            }
+#ifdef SG_MUTANT_SDC_ANYTOPOLOGY
+            matched = cur_path_count;
+#endif
+            if (matched != active || active != cur_path_count) ret = ERROR_BAD_CONFIGURATION;
+        }
+        free( cur_paths );
+        free( cur_modes );
+        return ret;
+    }
+
+    /* SDC_USE_SUPPLIED_DISPLAY_CONFIG: the source modes go through ChangeDisplaySettingsEx */
+    if (!(sources = calloc( path_info_count, sizeof(*sources) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    for (i = 0; i < path_info_count; i++)
+    {
+        DISPLAYCONFIG_SOURCE_DEVICE_NAME name = {{0}};
+        const DISPLAYCONFIG_SOURCE_MODE *src;
+        UINT32 idx;
+
+        sources[i].name[0] = 0;
+        if (!sdc_path_active( &path_info[i] )) continue;
+        idx = sdc_path_source_mode( &path_info[i], flags );
+        if (idx == DISPLAYCONFIG_PATH_MODE_IDX_INVALID) continue;   /* best mode: leave as it is */
+        src = &mode_info[idx].sourceMode;
+
+        name.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+        name.header.size = sizeof(name);
+        name.header.adapterId = path_info[i].sourceInfo.adapterId;
+        name.header.id = path_info[i].sourceInfo.id;
+        if (DisplayConfigGetDeviceInfo( &name.header )) { ret = ERROR_INVALID_PARAMETER; goto done; }
+        lstrcpyW( sources[i].name, name.viewGdiDeviceName );
+
+        sources[i].mode.dmSize = sizeof(sources[i].mode);
+        sources[i].mode.dmFields = DM_PELSWIDTH | DM_PELSHEIGHT | DM_POSITION;
+        sources[i].mode.dmPelsWidth = src->width;
+        sources[i].mode.dmPelsHeight = src->height;
+        sources[i].mode.dmPosition = src->position;
+        if (src->pixelFormat >= DISPLAYCONFIG_PIXELFORMAT_8BPP && src->pixelFormat <= DISPLAYCONFIG_PIXELFORMAT_32BPP)
+        {
+            sources[i].mode.dmFields |= DM_BITSPERPEL;
+            sources[i].mode.dmBitsPerPel = src->pixelFormat * 8;
+        }
+        if (path_info[i].targetInfo.refreshRate.Denominator && path_info[i].targetInfo.refreshRate.Numerator)
+        {
+            sources[i].mode.dmFields |= DM_DISPLAYFREQUENCY;
+            sources[i].mode.dmDisplayFrequency = (path_info[i].targetInfo.refreshRate.Numerator +
+                    path_info[i].targetInfo.refreshRate.Denominator / 2) / path_info[i].targetInfo.refreshRate.Denominator;
+        }
+    }
+
+    /* all or nothing: test every mode first */
+    for (i = 0; i < path_info_count; i++)
+    {
+        if (!sources[i].name[0]) continue;
+        if (ChangeDisplaySettingsExW( sources[i].name, &sources[i].mode, NULL, CDS_TEST, NULL ) == DISP_CHANGE_SUCCESSFUL)
+            continue;
+        if ((flags & SG_SDC_ALLOW_CHANGES) && sdc_nearest_mode( sources[i].name, &sources[i].mode )) continue;
+        ret = ERROR_BAD_CONFIGURATION;
+        goto done;
+    }
+#ifdef SG_MUTANT_SDC_NOAPPLY
+    goto done;
+#endif
+    if (flags & SG_SDC_APPLY)
+    {
+        /* saved: written to the registry for all the displays, then applied together;
+         * temporary: each display is changed at once (the registry keeps the old mode) */
+        BOOL save = (flags & SG_SDC_SAVE_TO_DATABASE) != 0;
+        DWORD cds = save ? CDS_UPDATEREGISTRY | CDS_NORESET : 0;
+
+        for (i = 0; i < path_info_count; i++)
+        {
+            if (!sources[i].name[0]) continue;
+            if (ChangeDisplaySettingsExW( sources[i].name, &sources[i].mode, NULL, cds, NULL ) != DISP_CHANGE_SUCCESSFUL)
+            {
+                ret = ERROR_GEN_FAILURE;
+                goto done;
+            }
+        }
+        if (save && ChangeDisplaySettingsExW( NULL, NULL, NULL, 0, NULL ) != DISP_CHANGE_SUCCESSFUL) ret = ERROR_GEN_FAILURE;
+    }
+
+done:
+    free( sources );
+    return ret;
 }
 
 
-- 
