From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dinput: ConfigureDevices traces, effect QueryInterface warns.

ConfigureDevices only reports a FIXME for the unsupported DDS target, and
unknown effect interfaces are a WARN.
---
 dlls/dinput/dinput.c       | 7 ++++++-
 dlls/dinput/joystick_hid.c | 3 ++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/dlls/dinput/dinput.c b/dlls/dinput/dinput.c
index 0b190e0..b7cd132 100644
--- a/dlls/dinput/dinput.c
+++ b/dlls/dinput/dinput.c
@@ -605,9 +605,14 @@ cleanup:
 static HRESULT WINAPI dinput8_ConfigureDevices( IDirectInput8W *iface, LPDICONFIGUREDEVICESCALLBACK callback,
                                                 DICONFIGUREDEVICESPARAMSW *params, DWORD flags, void *context )
 {
-    FIXME( "iface %p, callback %p, params %p, flags %#lx, context %p stub!\n", iface, callback,
+    TRACE( "iface %p, callback %p, params %p, flags %#lx, context %p.\n", iface, callback,
            params, flags, context );
 
+    /* The mapping UI is a window of its own; drawing it on the caller's
+     * DirectDraw/Direct3D surface (and calling back to present it) is not done. */
+    if (params && params->lpUnkDDSTarget)
+        FIXME( "Rendering on target surface %p not implemented, using a window.\n", params->lpUnkDDSTarget );
+
     /* Call helper function in config.c to do the real work */
     return _configure_devices( iface, callback, params, flags, context );
 }
diff --git a/dlls/dinput/joystick_hid.c b/dlls/dinput/joystick_hid.c
index d754086..a8e8cf8 100644
--- a/dlls/dinput/joystick_hid.c
+++ b/dlls/dinput/joystick_hid.c
@@ -2149,7 +2149,8 @@ static HRESULT WINAPI hid_joystick_effect_QueryInterface( IDirectInputEffect *if
         return S_OK;
     }
 
-    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    /* an effect has no other interface */
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
 }
