From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: HKCU\Software is the same key in the 32- and 64-bit views (5949)

server: HKCU\Software is the same key in the 32- and 64-bit views

Windows has shared HKCU\Software between the 32- and 64-bit registry views
since Windows 7: a key named Wow6432Node below it is an ordinary key. Wine
redirects to any Wow6432Node subkey it finds, so once a program had created
HKCU\Software\WOW6432Node\... (one did on qa4, during Scribus's install),
every 32-bit program had an HKCU\Software of its own: none of the user's
settings, its own Run and Uninstall keys, Explorer folders and file classes
written apart from the 64-bit ones. A 32-bit Burn bundle (Python 3.13) looked
for its related bundles there.

A Wow6432Node directly below \Registry\User\<SID>\Software is no longer a
redirection point; HKLM\Software and the classes keep theirs. Keys already
written below such a node stay there (as on Windows, where they would be
ordinary keys). Gate test-userhive; mutant SG_MUTANT_HKCU_WOW_REDIRECT.
---
--- a/server/registry.c
+++ b/server/registry.c
@@ -660,6 +660,38 @@
     return ret;
 }
 
+/* Stained Glass OS: whether a key is a user's HKCU\Software (\Registry\User\<SID>\Software).
+ * Windows has shared it between the 32- and 64-bit views since Windows 7: a Wow6432Node
+ * key below it is an ordinary key, not where a 32-bit program's keys go. Wine redirected
+ * to it as soon as one existed -- a program had created HKCU\Software\WOW6432Node\... --
+ * and every 32-bit program then had an HKCU\Software of its own (qa4 2026-10-21: a 32-bit
+ * Burn bundle saw none of the user's keys). Software\Classes keeps its redirection. */
+static int sg_is_user_software( struct object *obj )
+{
+    static const WCHAR userW[] = {'\\','R','e','g','i','s','t','r','y','\\','U','s','e','r','\\'};
+    static const WCHAR softwareW[] = {'\\','S','o','f','t','w','a','r','e'};
+    data_size_t len = 0, i;
+    WCHAR *name;
+    int ret = 0;
+
+#ifdef SG_MUTANT_HKCU_WOW_REDIRECT
+    return 0;
+#endif
+    if (!(name = obj->ops->get_full_name( obj, &len ))) { clear_error(); return 0; }
+    len /= sizeof(WCHAR);
+    if (len > ARRAY_SIZE(userW) + ARRAY_SIZE(softwareW) &&
+        !memicmp_strW( name, userW, sizeof(userW) ) &&
+        !memicmp_strW( name + len - ARRAY_SIZE(softwareW), softwareW, sizeof(softwareW) ))
+    {
+        /* exactly one name (the SID) between \Registry\User\ and \Software */
+        ret = 1;
+        for (i = ARRAY_SIZE(userW); i < len - ARRAY_SIZE(softwareW); i++)
+            if (name[i] == '\\') ret = 0;
+    }
+    free( name );
+    return ret;
+}
+
 /* Stained Glass OS: whether a key is in a user's hive (\Registry\User\...). Elevated programs
  * run as the SYSTEM account with the user's own HKCU, as on Windows; what they create or touch
  * there must stay the user's. */
@@ -862,7 +894,8 @@
         parent_key->subkeys[i] = parent_key->subkeys[i - 1];
     parent_key->subkeys[index] = (struct key *)grab_object( key );
     if (is_wow6432node( name->name, name->len ) &&
-        !is_wow6432node( parent_key->obj.name->name, parent_key->obj.name->len ))
+        !is_wow6432node( parent_key->obj.name->name, parent_key->obj.name->len ) &&
+        !sg_is_user_software( &parent_key->obj ))
         parent_key->wow6432node = key;
     name->parent = parent;
     return 1;
