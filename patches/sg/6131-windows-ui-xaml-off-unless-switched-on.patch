From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: off unless switched on per program, until it draws

With windows.ui.xaml registering its classes, a program that asks whether Windows.UI.Xaml is there and falls back to its Win32 interface when it is not would take the XAML path into a XAML that draws nothing yet. Until it does, its classes answer REGDB_E_CLASSNOTREG -- as before the DLL existed -- unless XAML is switched on for the program: HKCU or HKLM Software\\Wine\\AppDefaults\\<exe> SgXaml (DWORD, not 0), Software\\Wine SgXaml for every program, or WINE_SG_XAML=1.
---
diff --git a/dlls/windows.ui.xaml/main.c b/dlls/windows.ui.xaml/main.c
index 88e7d0f..b246f2f 100644
--- a/dlls/windows.ui.xaml/main.c
+++ b/dlls/windows.ui.xaml/main.c
@@ -20,6 +20,8 @@
 
 #include "initguid.h"
 #include "private.h"
+#include "winreg.h"
+#include <stdio.h>
 
 WINE_DEFAULT_DEBUG_CHANNEL(xaml);
 
@@ -47,6 +49,53 @@ classes[] =
     { L"Windows.UI.Xaml.Window", &window_factory_iface },
 };
 
+/*
+ * Until our Windows.UI.Xaml draws what programs put in it, a program that asks whether it is there
+ * and falls back to its Win32 interface when it is not must keep getting "not registered", as before
+ * the DLL existed.  XAML is on for a program when HKCU (or HKLM) Software\Wine\AppDefaults\<exe>
+ * has SgXaml (DWORD, not 0), or Software\Wine has it (every program), or WINE_SG_XAML=1 is set.
+ */
+static BOOL xaml_enabled_in( HKEY root, const WCHAR *path )
+{
+    DWORD value = 0, size = sizeof(value);
+
+    if (RegGetValueW( root, path, L"SgXaml", RRF_RT_REG_DWORD, NULL, &value, &size )) return FALSE;
+    return value != 0;
+}
+
+static BOOL WINAPI init_xaml_enabled( INIT_ONCE *once, void *param, void **context )
+{
+    BOOL *enabled = param;
+    WCHAR path[MAX_PATH + 40], exe[MAX_PATH], *name;
+    char env[8];
+
+    *enabled = FALSE;
+    if (GetEnvironmentVariableA( "WINE_SG_XAML", env, sizeof(env) ) && env[0] == '1') *enabled = TRUE;
+    if (!*enabled && GetModuleFileNameW( NULL, exe, ARRAY_SIZE(exe) ))
+    {
+        name = wcsrchr( exe, '\\' ) ? wcsrchr( exe, '\\' ) + 1 : exe;
+        swprintf( path, ARRAY_SIZE(path), L"Software\\Wine\\AppDefaults\\%s", name );
+        *enabled = xaml_enabled_in( HKEY_CURRENT_USER, path ) || xaml_enabled_in( HKEY_LOCAL_MACHINE, path );
+    }
+    if (!*enabled)
+        *enabled = xaml_enabled_in( HKEY_CURRENT_USER, L"Software\\Wine" ) ||
+                   xaml_enabled_in( HKEY_LOCAL_MACHINE, L"Software\\Wine" );
+#ifdef SG_MUTANT_XAML_ALWAYS_ON
+    *enabled = TRUE;
+#endif
+    TRACE( "XAML %s for this program\n", *enabled ? "on" : "off" );
+    return TRUE;
+}
+
+static BOOL xaml_enabled(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    static BOOL enabled;
+
+    InitOnceExecuteOnce( &once, init_xaml_enabled, &enabled, NULL );
+    return enabled;
+}
+
 HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **factory )
 {
     const WCHAR *name = WindowsGetStringRawBuffer( classid, NULL );
@@ -55,6 +104,11 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
     TRACE( "class %s, factory %p.\n", debugstr_w(name), factory );
 
     *factory = NULL;
+    if (!xaml_enabled())
+    {
+        WARN( "class %s: XAML is not on for this program (SgXaml)\n", debugstr_w(name) );
+        return REGDB_E_CLASSNOTREG;
+    }
     for (i = 0; i < ARRAY_SIZE(classes); i++)
     {
         if (wcscmp( name, classes[i].name )) continue;
