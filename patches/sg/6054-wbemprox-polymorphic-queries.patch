From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wbemprox: A query of a class gives its subclasses' instances (6054)

WQL queries were not polymorphic: SELECT * FROM CIM_LogicalDevice gave
nothing, and CIM_Processor or CIM_LogicalDisk gave copies of the Win32_
rows labelled with the CIM_ class. Installers and management tools ask
for the CIM_ base classes. A SELECT now takes the tables of the class's
subclasses too, each row keeping its own class; the CIM_ classes that
have copies of a Win32_ subclass's table here give the subclass's rows
instead. The path of a class is still the class (GetObject of a CIM_
class gives its definition, not a subclass's instance).
---
diff --git a/dlls/wbemprox/class.c b/dlls/wbemprox/class.c
index 2fd7772..cde98a5 100644
--- a/dlls/wbemprox/class.c
+++ b/dlls/wbemprox/class.c
@@ -441,8 +441,9 @@ HRESULT create_class_only_object( IEnumWbemClassObject *iter, enum wbm_namespace
     struct record *record;
     HRESULT hr;
 
-    if (!ec->query->view->table_count) return WBEM_E_NOT_FOUND;
-    table = get_view_table( ec->query->view, 0 );
+    /* the class's own table: a class that has none is not found here */
+    if (!ec->query->view->table_count || !ec->query->view->has_own) return WBEM_E_NOT_FOUND;
+    table = ec->query->view->table[0];
     if (!(record = create_record( table ))) return E_OUTOFMEMORY;
     if (FAILED(hr = create_class_object( ns, table->name, iter, 0, record, obj ))) destroy_record( record );
     else impl_from_IWbemClassObject( *obj )->is_class = TRUE;
diff --git a/dlls/wbemprox/query.c b/dlls/wbemprox/query.c
index 6d8ebe3..7ae56eb 100644
--- a/dlls/wbemprox/query.c
+++ b/dlls/wbemprox/query.c
@@ -38,6 +38,47 @@ static HRESULT append_table( struct view *view, struct table *table )
     return S_OK;
 }
 
+/* whether a class is a subclass of another, at any depth */
+static BOOL derives_from( const WCHAR *class, const WCHAR *ancestor )
+{
+    const WCHAR *parent;
+    int depth = 0;
+
+    for (parent = get_class_parent( class ); parent && depth < 32; parent = get_class_parent( parent ), depth++)
+        if (!wcsicmp( parent, ancestor )) return TRUE;
+    return FALSE;
+}
+
+/* A query of a class gives the instances of its subclasses too. The CIM_ classes that have tables of
+ * their own here have them as copies of a Win32_ subclass's: with a subclass's table, theirs is left out. */
+static HRESULT add_subclass_tables( struct view *view, enum wbm_namespace ns, const WCHAR *class )
+{
+    WCHAR **names;
+    UINT count, i, added = 0;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_WMI_NOT_POLYMORPHIC
+    return S_OK;
+#endif
+    if ((hr = list_table_names( ns, &names, &count )) != S_OK) return hr;
+    for (i = 0; i < count; i++)
+    {
+        struct table *table;
+
+        if (hr == S_OK && wcsicmp( names[i], class ) && derives_from( names[i], class )
+                && (table = find_table( ns, names[i] )))
+        {
+            if ((hr = append_table( view, table )) != S_OK) release_table( table );
+            else added++;
+        }
+        free( names[i] );
+    }
+    free( names );
+    /* the class's table stays first, for its definition */
+    if (hr == S_OK && added && view->table_count > added && !wcsnicmp( class, L"CIM_", 4 )) view->skip_own = TRUE;
+    return hr;
+}
+
 HRESULT create_view( enum view_type type, enum wbm_namespace ns, const WCHAR *path, const struct keyword *keywordlist,
                      const WCHAR *class, const struct property *proplist, const struct expr *cond, struct view **ret )
 {
@@ -68,6 +109,12 @@ HRESULT create_view( enum view_type type, enum wbm_namespace ns, const WCHAR *pa
             free( view );
             return WBEM_E_INVALID_CLASS;
         }
+        view->has_own = table != NULL;
+        if (class && ns < WBEMPROX_NAMESPACE_LAST && (hr = add_subclass_tables( view, ns, class )) != S_OK)
+        {
+            destroy_view( view );
+            return hr;
+        }
         view->proplist = proplist;
         view->cond     = cond;
         break;
@@ -91,6 +138,7 @@ void destroy_view( struct view *view )
     for (i = 0; i < view->table_count; i++) release_table( view->table[i] );
     free( view->table );
     free( view->result );
+    free( view->result_table );
     free( view );
 }
 
@@ -722,41 +770,55 @@ static BOOL cond_properties_exist( const struct table *table, const struct expr
 
 static HRESULT exec_select_view( struct view *view )
 {
-    UINT i, j = 0, len;
-    enum fill_status status = FILL_STATUS_UNFILTERED;
-    struct table *table;
+    UINT t, i, j = 0, len = 16;
+    BOOL several = view->table_count > 1;
 
     if (!view->table_count) return S_OK;
-
-    table = view->table[0];
-    if (!cond_properties_exist( table, view->cond )) return WBEM_E_INVALID_QUERY;
-    if (table->fill)
-    {
-        clear_table( table );
-        status = table->fill( table, view->cond );
-    }
-    if (status == FILL_STATUS_FAILED) return WBEM_E_FAILED;
-    if (!table->num_rows) return S_OK;
-
-    len = min( table->num_rows, 16 );
+    if (!several && !cond_properties_exist( view->table[0], view->cond )) return WBEM_E_INVALID_QUERY;
     if (!(view->result = malloc( len * sizeof(UINT) ))) return E_OUTOFMEMORY;
+    if (several && !(view->result_table = malloc( len * sizeof(UINT) ))) return E_OUTOFMEMORY;
 
-    for (i = 0; i < table->num_rows; i++)
+    /* each table's rows that meet the condition, the class's first, then its subclasses' */
+    for (t = 0; t < view->table_count; t++)
     {
-        HRESULT hr;
-        LONGLONG val = 0;
-        UINT type;
+        enum fill_status status = FILL_STATUS_UNFILTERED;
+        struct table *table = view->table[t];
 
-        if (j >= len)
+        if (several && (!cond_properties_exist( table, view->cond ) || (!t && view->skip_own))) continue;
+        if (table->fill)
         {
-            UINT *tmp;
-            len *= 2;
-            if (!(tmp = realloc( view->result, len * sizeof(UINT) ))) return E_OUTOFMEMORY;
-            view->result = tmp;
+            clear_table( table );
+            status = table->fill( table, view->cond );
+        }
+        if (status == FILL_STATUS_FAILED)
+        {
+            if (!several) return WBEM_E_FAILED;
+            continue;
+        }
+        for (i = 0; i < table->num_rows; i++)
+        {
+            HRESULT hr;
+            LONGLONG val = 0;
+            UINT type;
+
+            if (j >= len)
+            {
+                UINT *tmp;
+                len *= 2;
+                if (!(tmp = realloc( view->result, len * sizeof(UINT) ))) return E_OUTOFMEMORY;
+                view->result = tmp;
+                if (several)
+                {
+                    if (!(tmp = realloc( view->result_table, len * sizeof(UINT) ))) return E_OUTOFMEMORY;
+                    view->result_table = tmp;
+                }
+            }
+            if (status == FILL_STATUS_FILTERED) val = 1;
+            else if ((hr = eval_cond( table, i, view->cond, &val, &type )) != S_OK) return hr;
+            if (!val) continue;
+            if (several) view->result_table[j] = t;
+            view->result[j++] = i;
         }
-        if (status == FILL_STATUS_FILTERED) val = 1;
-        else if ((hr = eval_cond( table, i, view->cond, &val, &type )) != S_OK) return hr;
-        if (val) view->result[j++] = i;
     }
 
     view->result_count = j;
@@ -1253,7 +1315,7 @@ static HRESULT map_view_index( const struct view *view, UINT index, UINT *table_
     switch (view->type)
     {
     case VIEW_TYPE_SELECT:
-        *table_index = 0;
+        *table_index = view->result_table && index < view->result_count ? view->result_table[index] : 0;
         *result_index = index;
         break;
 
@@ -1273,7 +1335,7 @@ struct table *get_view_table( const struct view *view, UINT index )
     switch (view->type)
     {
     case VIEW_TYPE_SELECT:
-        return view->table[0];
+        return view->table[view->result_table && index < view->result_count ? view->result_table[index] : 0];
 
     case VIEW_TYPE_ASSOCIATORS:
         return view->table[index];
diff --git a/dlls/wbemprox/services.c b/dlls/wbemprox/services.c
index 2dfb8b1..3e9de3d 100644
--- a/dlls/wbemprox/services.c
+++ b/dlls/wbemprox/services.c
@@ -534,6 +534,8 @@ static HRESULT create_instance_enum( enum wbm_namespace ns, const struct path *p
     return hr;
 }
 
+static HRESULT get_class_definition( enum wbm_namespace ns, const WCHAR *name, IWbemClassObject **obj );
+
 HRESULT get_object( enum wbm_namespace ns, const WCHAR *object_path, IWbemClassObject **obj )
 {
     IEnumWbemClassObject *iter;
@@ -551,6 +553,33 @@ HRESULT get_object( enum wbm_namespace ns, const WCHAR *object_path, IWbemClassO
         return hr;
     }
     hr = IEnumWbemClassObject_Next( iter, WBEM_INFINITE, 1, obj, &count );
+    if (hr == S_OK && !path->filter)
+    {
+        /* a class's path is the class: not an instance of a subclass the query of it gives */
+        VARIANT var;
+
+        if (IWbemClassObject_Get( *obj, L"__CLASS", 0, &var, NULL, NULL ) == S_OK && V_VT( &var ) == VT_BSTR
+                && (wcslen( V_BSTR( &var ) ) != path->class_len || wcsnicmp( V_BSTR( &var ), path->class, path->class_len )))
+        {
+            WCHAR *name = malloc( (path->class_len + 1) * sizeof(WCHAR) );
+
+            IWbemClassObject_Release( *obj );
+            *obj = NULL;
+            VariantClear( &var );
+            IEnumWbemClassObject_Release( iter );
+            if (!name) hr = E_OUTOFMEMORY;
+            else
+            {
+                memcpy( name, path->class, path->class_len * sizeof(WCHAR) );
+                name[path->class_len] = 0;
+                hr = get_class_definition( ns, name, obj );
+                free( name );
+            }
+            free_path( path );
+            return hr;
+        }
+        VariantClear( &var );
+    }
     if (hr == WBEM_S_FALSE)
     {
         /* a class with no instance is still a class; an instance that is not there is not found */
diff --git a/dlls/wbemprox/wbemprox_private.h b/dlls/wbemprox/wbemprox_private.h
index 6448c4f..0a96fb8 100644
--- a/dlls/wbemprox/wbemprox_private.h
+++ b/dlls/wbemprox/wbemprox_private.h
@@ -200,6 +200,9 @@ struct view
     struct table **table;
     UINT result_count;
     UINT *result;
+    UINT *result_table;                     /* SELECT over a class and its subclasses: each result's table */
+    BOOL skip_own;                          /* the class's own table gives no instances (a CIM_ copy) */
+    BOOL has_own;                           /* table[0] is the class's own */
 };
 
 struct query
