From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, wow64: the working set (MemoryWorkingSetInformation)

NtQueryVirtualMemory(MemoryWorkingSetInformation), which psapi's QueryWorkingSet asks,
was not implemented ('Unknown information class'); Firefox and Thunderbird ask for their
working set (16 bytes first, for the count). It now lists every page of the process
that is in memory (from /proc/self/pagemap): NumberOfEntries, then a block per page
with the page's protection as the memory manager codes it (a written copy-on-write
page is the process's own read/write page), shared and share count for pages shared
with a file or another process, and the virtual page number. A buffer too small for
them all gets STATUS_INFO_LENGTH_MISMATCH (ERROR_BAD_LENGTH) with the count set.
WoW64 converts the blocks; psapi.h gains PSAPI_WORKING_SET_BLOCK/INFORMATION.

Gate: test/workingset-gate.sh; mutant SG_MUTANT_NO_WORKING_SET.
---
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -5603,6 +5603,108 @@
     return STATUS_SUCCESS;
 }
 
+/* Stained Glass OS (wine-sg 9758): MemoryWorkingSetInformation, psapi's QueryWorkingSet -- every page
+ * of the process that is in memory, as MEMORY_WORKING_SET_INFORMATION: NumberOfEntries, then one
+ * block per page (bits 0-4 the page's protection as the memory manager codes it, 5-7 the share count,
+ * 8 shared, 12 up the virtual page number). A buffer too small for them all gets
+ * STATUS_INFO_LENGTH_MISMATCH with NumberOfEntries set, which is how callers size it (Firefox and
+ * Thunderbird ask with 16 bytes first). Residency comes from /proc/self/pagemap. */
+static ULONG_PTR working_set_protection( DWORD prot )
+{
+    ULONG_PTR ret;
+
+    switch (prot & 0xff)
+    {
+    case PAGE_READONLY:          ret = 1; break;
+    case PAGE_EXECUTE:           ret = 2; break;
+    case PAGE_EXECUTE_READ:      ret = 3; break;
+    case PAGE_READWRITE:         ret = 4; break;
+    case PAGE_WRITECOPY:         ret = 5; break;
+    case PAGE_EXECUTE_READWRITE: ret = 6; break;
+    case PAGE_EXECUTE_WRITECOPY: ret = 7; break;
+    default:                     ret = 0; break;
+    }
+    if (prot & PAGE_NOCACHE) ret |= 8;
+    if (prot & PAGE_WRITECOMBINE) ret |= 24;
+    return ret;
+}
+
+static unsigned int get_working_set( HANDLE process, void *buffer, SIZE_T len, SIZE_T *res_len )
+{
+#if defined(linux) && !defined(SG_MUTANT_NO_WORKING_SET)
+    static int fd = -2;
+    ULONG_PTR *out = buffer, max, count = 0;
+    UINT64 pm[256];
+    struct file_view *view;
+    sigset_t sigset;
+
+    if (process != NtCurrentProcess())
+    {
+        FIXME( "(process=%p) only the current process's working set\n", process );
+        return STATUS_INVALID_INFO_CLASS;
+    }
+    if (len < sizeof(ULONG_PTR)) return STATUS_INFO_LENGTH_MISMATCH;
+    max = len / sizeof(ULONG_PTR) - 1;
+
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    if (fd == -2) fd = open( "/proc/self/pagemap", O_RDONLY | O_CLOEXEC );
+    WINE_RB_FOR_EACH_ENTRY( view, &views_tree, struct file_view, entry )
+    {
+        char *addr = view->base, *end = addr + view->size;
+
+        while (addr < end)
+        {
+            BYTE vprot;
+            SIZE_T size = get_committed_size( view, addr, end - addr, &vprot, ~VPROT_WRITEWATCH ), page, n, i;
+            DWORD prot;
+
+            if (!size) break;
+            if (fd >= 0 && (vprot & VPROT_COMMITTED) && (vprot & 0x0f) && !(vprot & VPROT_GUARD))
+            {
+                prot = get_win32_prot( vprot, view->protect );
+                for (page = (UINT_PTR)addr >> page_shift; page < ((UINT_PTR)addr + size) >> page_shift; page += n)
+                {
+                    ssize_t got;
+
+                    n = min( ARRAY_SIZE(pm), (((UINT_PTR)addr + size) >> page_shift) - page );
+                    got = pread( fd, pm, n * sizeof(pm[0]), page * sizeof(pm[0]) );
+                    if (got <= 0) break;
+                    n = got / sizeof(pm[0]);
+                    for (i = 0; i < n; i++)
+                    {
+                        DWORD page_prot = prot;
+                        BOOL shared;
+
+                        if (!(pm[i] >> 63)) continue;  /* not in memory */
+                        shared = !is_view_valloc( view ) && ((pm[i] >> 61) & 1);
+                        /* a copy-on-write page that was written is the process's own copy now */
+                        if (!((pm[i] >> 61) & 1))
+                        {
+                            if ((page_prot & 0xff) == PAGE_WRITECOPY) page_prot = (page_prot & ~0xff) | PAGE_READWRITE;
+                            else if ((page_prot & 0xff) == PAGE_EXECUTE_WRITECOPY)
+                                page_prot = (page_prot & ~0xff) | PAGE_EXECUTE_READWRITE;
+                        }
+                        if (count < max)
+                            out[1 + count] = ((ULONG_PTR)(page + i) << page_shift) | working_set_protection( page_prot ) |
+                                             (shared ? (1 << 5) | (1 << 8) : 0);
+                        count++;
+                    }
+                }
+            }
+            addr += size;
+        }
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+
+    out[0] = count;
+    if (res_len) *res_len = (min( count, max ) + 1) * sizeof(ULONG_PTR);
+    return count > max ? STATUS_INFO_LENGTH_MISMATCH : STATUS_SUCCESS;
+#else
+    FIXME( "(%p,%p,%lu) not supported here\n", process, buffer, len );
+    return STATUS_INVALID_INFO_CLASS;
+#endif
+}
+
 static unsigned int get_memory_section_name( HANDLE process, LPCVOID addr,
                                              MEMORY_SECTION_NAME *info, SIZE_T len, SIZE_T *ret_len )
 {
@@ -5690,6 +5792,9 @@
         case MemoryWorkingSetExInformation:
             return get_working_set_ex( process, addr, buffer, len, res_len );
 
+        case MemoryWorkingSetInformation:
+            return get_working_set( process, buffer, len, res_len );
+
         case MemoryMappedFilenameInformation:
             return get_memory_section_name( process, addr, buffer, len, res_len );
 
--- a/dlls/wow64/virtual.c
+++ b/dlls/wow64/virtual.c
@@ -640,6 +640,24 @@
         break;
     }
 
+    case MemoryWorkingSetInformation:  /* MEMORY_WORKING_SET_INFORMATION (wine-sg 9758) */
+    {
+        ULONG *info32 = ptr, i, count = len / sizeof(ULONG);
+        ULONG_PTR *info;
+
+        if (len < sizeof(ULONG)) return STATUS_INFO_LENGTH_MISMATCH;
+        info = Wow64AllocateTemp( count * sizeof(*info) );
+        status = NtQueryVirtualMemory( handle, addr, class, info, count * sizeof(*info), &res_len );
+        if (!status || status == STATUS_INFO_LENGTH_MISMATCH)
+        {
+            info32[0] = info[0];
+            count = min( count, res_len / sizeof(*info) );
+            for (i = 1; i < count; i++) info32[i] = info[i];   /* pages below 4 GB: the same bits */
+            res_len = count * sizeof(ULONG);
+        }
+        break;
+    }
+
     case MemoryImageInformation: /* MEMORY_IMAGE_INFORMATION */
     {
         if (len < sizeof(MEMORY_IMAGE_INFORMATION32)) return STATUS_INFO_LENGTH_MISMATCH;
--- a/include/psapi.h
+++ b/include/psapi.h
@@ -45,6 +45,26 @@
 } PROCESS_MEMORY_COUNTERS;
 typedef PROCESS_MEMORY_COUNTERS *PPROCESS_MEMORY_COUNTERS;
 
+typedef union _PSAPI_WORKING_SET_BLOCK {
+    ULONG_PTR Flags;
+    struct {
+        ULONG_PTR Protection : 5;
+        ULONG_PTR ShareCount : 3;
+        ULONG_PTR Shared : 1;
+        ULONG_PTR Reserved : 3;
+#ifdef _WIN64
+        ULONG_PTR VirtualPage : 52;
+#else
+        ULONG_PTR VirtualPage : 20;
+#endif
+    } DUMMYSTRUCTNAME;
+} PSAPI_WORKING_SET_BLOCK, *PPSAPI_WORKING_SET_BLOCK;
+
+typedef struct _PSAPI_WORKING_SET_INFORMATION {
+    ULONG_PTR NumberOfEntries;
+    PSAPI_WORKING_SET_BLOCK WorkingSetInfo[1];
+} PSAPI_WORKING_SET_INFORMATION, *PPSAPI_WORKING_SET_INFORMATION;
+
 typedef union _PSAPI_WORKING_SET_EX_BLOCK {
     ULONG_PTR Flags;
     struct {
