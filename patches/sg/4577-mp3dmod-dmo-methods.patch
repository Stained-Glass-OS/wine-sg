From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mp3dmod: Implement the current types, streaming resources, input status and Lock.

GetInputCurrentType and GetOutputCurrentType return a copy of the type set,
checking the stream index first, then whether a type is set, then the
pointer, as Windows' DMOs do (mf tests: test_wmv_decoder_media_object).
AllocateStreamingResources and FreeStreamingResources return S_OK: the
decoder keeps its mpg123 handle for its whole life, and the documentation
says a DMO without streaming resources returns S_OK. GetInputStatus reports
DMO_INPUT_STATUSF_ACCEPT_DATA unless ProcessInput holds a buffer. Lock takes
a critical section that the type, input, output and flush methods also take.

Gate: test/mp3dmod-dmo-gate.sh (64/32).
---
 dlls/mp3dmod/mp3dmod.c | 147 +++++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 130 insertions(+), 17 deletions(-)

diff --git a/dlls/mp3dmod/mp3dmod.c b/dlls/mp3dmod/mp3dmod.c
index 842be58..b0ff30c 100644
--- a/dlls/mp3dmod/mp3dmod.c
+++ b/dlls/mp3dmod/mp3dmod.c
@@ -53,6 +53,8 @@ struct mp3_decoder
 
     IMediaBuffer *buffer;
     REFERENCE_TIME timestamp;
+
+    CRITICAL_SECTION cs;  /* IMediaObject::Lock, taken by the stream methods */
 };
 
 static inline struct mp3_decoder *impl_from_IUnknown(IUnknown *iface)
@@ -106,6 +108,8 @@ static ULONG WINAPI Unknown_Release(IUnknown *iface)
             MoFreeMediaType(&This->intype);
         MoFreeMediaType(&This->outtype);
         mpg123_delete(This->mh);
+        This->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&This->cs);
         free(This);
     }
     return refcount;
@@ -219,7 +223,7 @@ static HRESULT WINAPI MediaObject_GetOutputType(IMediaObject *iface, DWORD index
     return S_OK;
 }
 
-static HRESULT WINAPI MediaObject_SetInputType(IMediaObject *iface, DWORD index, const DMO_MEDIA_TYPE *type, DWORD flags)
+static HRESULT SetInputType_unlocked(IMediaObject *iface, DWORD index, const DMO_MEDIA_TYPE *type, DWORD flags)
 {
     struct mp3_decoder *dmo = impl_from_IMediaObject(iface);
 
@@ -249,7 +253,7 @@ static HRESULT WINAPI MediaObject_SetInputType(IMediaObject *iface, DWORD index,
     return S_OK;
 }
 
-static HRESULT WINAPI MediaObject_SetOutputType(IMediaObject *iface, DWORD index, const DMO_MEDIA_TYPE *type, DWORD flags)
+static HRESULT SetOutputType_unlocked(IMediaObject *iface, DWORD index, const DMO_MEDIA_TYPE *type, DWORD flags)
 {
     struct mp3_decoder *This = impl_from_IMediaObject(iface);
     WAVEFORMATEX *format;
@@ -296,18 +300,45 @@ static HRESULT WINAPI MediaObject_SetOutputType(IMediaObject *iface, DWORD index
     return S_OK;
 }
 
+/* the stream index first, then whether a type is set, then the pointer, as
+ * Windows' DMOs check them (mf tests, test_wmv_decoder_media_object) */
+static HRESULT get_current_type(struct mp3_decoder *dmo, DWORD index, DMO_MEDIA_TYPE *type,
+        const DMO_MEDIA_TYPE *current, BOOL set)
+{
+    HRESULT hr;
+
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+    EnterCriticalSection(&dmo->cs);
+    if (!set)
+        hr = DMO_E_TYPE_NOT_SET;
+    else if (!type)
+        hr = E_POINTER;
+    else
+        hr = MoCopyMediaType(type, current);
+    LeaveCriticalSection(&dmo->cs);
+    return hr;
+}
+
 static HRESULT WINAPI MediaObject_GetInputCurrentType(IMediaObject *iface, DWORD index, DMO_MEDIA_TYPE *type)
 {
-    FIXME("(%p)->(%ld, %p) stub!\n", iface, index, type);
+    struct mp3_decoder *dmo = impl_from_IMediaObject(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, index %lu, type %p.\n", iface, index, type);
+
+    return get_current_type(dmo, index, type, &dmo->intype, dmo->intype_set);
 }
 
 static HRESULT WINAPI MediaObject_GetOutputCurrentType(IMediaObject *iface, DWORD index, DMO_MEDIA_TYPE *type)
 {
-    FIXME("(%p)->(%ld, %p) stub!\n", iface, index, type);
+    struct mp3_decoder *dmo = impl_from_IMediaObject(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, index %lu, type %p.\n", iface, index, type);
+
+#ifdef SG_MUTANT_MP3_OUTTYPE_UNSET
+    return get_current_type(dmo, index, type, &dmo->outtype, FALSE);
+#endif
+    return get_current_type(dmo, index, type, &dmo->outtype, dmo->outtype_set);
 }
 
 static HRESULT WINAPI MediaObject_GetInputSizeInfo(IMediaObject *iface,
@@ -353,7 +384,7 @@ static HRESULT WINAPI MediaObject_SetInputMaxLatency(IMediaObject *iface, DWORD
     return E_NOTIMPL;
 }
 
-static HRESULT WINAPI MediaObject_Flush(IMediaObject *iface)
+static HRESULT Flush_unlocked(IMediaObject *iface)
 {
     struct mp3_decoder *dmo = impl_from_IMediaObject(iface);
 
@@ -378,28 +409,44 @@ static HRESULT WINAPI MediaObject_Discontinuity(IMediaObject *iface, DWORD index
     return S_OK;
 }
 
+/* the decoder keeps its mpg123 handle for its whole life: there is nothing
+ * to allocate or free, and a DMO without streaming resources returns S_OK */
 static HRESULT WINAPI MediaObject_AllocateStreamingResources(IMediaObject *iface)
 {
-    FIXME("(%p)->() stub!\n", iface);
+    TRACE("iface %p.\n", iface);
 
-    return E_NOTIMPL;
+    return S_OK;
 }
 
 static HRESULT WINAPI MediaObject_FreeStreamingResources(IMediaObject *iface)
 {
-    FIXME("(%p)->() stub!\n", iface);
+    TRACE("iface %p.\n", iface);
 
-    return E_NOTIMPL;
+    return S_OK;
 }
 
 static HRESULT WINAPI MediaObject_GetInputStatus(IMediaObject *iface, DWORD index, DWORD *flags)
 {
-    FIXME("(%p)->(%ld, %p) stub!\n", iface, index, flags);
+    struct mp3_decoder *dmo = impl_from_IMediaObject(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, index %lu, flags %p.\n", iface, index, flags);
+
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+    if (!flags)
+        return E_POINTER;
+    /* ProcessInput takes one buffer until ProcessOutput has drained it */
+    EnterCriticalSection(&dmo->cs);
+#ifdef SG_MUTANT_MP3_STATUS_ALWAYS
+    *flags = DMO_INPUT_STATUSF_ACCEPT_DATA;
+#else
+    *flags = dmo->buffer ? 0 : DMO_INPUT_STATUSF_ACCEPT_DATA;
+#endif
+    LeaveCriticalSection(&dmo->cs);
+    return S_OK;
 }
 
-static HRESULT WINAPI MediaObject_ProcessInput(IMediaObject *iface, DWORD index,
+static HRESULT ProcessInput_unlocked(IMediaObject *iface, DWORD index,
     IMediaBuffer *buffer, DWORD flags, REFERENCE_TIME timestamp, REFERENCE_TIME timelength)
 {
     struct mp3_decoder *This = impl_from_IMediaObject(iface);
@@ -446,7 +493,7 @@ static REFERENCE_TIME get_frametime(DMO_MEDIA_TYPE *type)
     return (REFERENCE_TIME) 10000000 * 1152 / format->nSamplesPerSec;
 }
 
-static HRESULT WINAPI MediaObject_ProcessOutput(IMediaObject *iface, DWORD flags, DWORD count, DMO_OUTPUT_DATA_BUFFER *buffers, DWORD *status)
+static HRESULT ProcessOutput_unlocked(IMediaObject *iface, DWORD flags, DWORD count, DMO_OUTPUT_DATA_BUFFER *buffers, DWORD *status)
 {
     struct mp3_decoder *This = impl_from_IMediaObject(iface);
     REFERENCE_TIME time = 0, frametime;
@@ -536,9 +583,73 @@ static HRESULT WINAPI MediaObject_ProcessOutput(IMediaObject *iface, DWORD flags
 
 static HRESULT WINAPI MediaObject_Lock(IMediaObject *iface, LONG lock)
 {
-    FIXME("(%p)->(%ld) stub!\n", iface, lock);
+    struct mp3_decoder *dmo = impl_from_IMediaObject(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, lock %ld.\n", iface, lock);
+
+#ifndef SG_MUTANT_MP3_LOCK_NOOP
+    if (lock)
+        EnterCriticalSection(&dmo->cs);
+    else
+        LeaveCriticalSection(&dmo->cs);
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI MediaObject_SetInputType(IMediaObject *iface, DWORD index, const DMO_MEDIA_TYPE *type, DWORD flags)
+{
+    struct mp3_decoder *dmo = impl_from_IMediaObject(iface);
+    HRESULT hr;
+
+    EnterCriticalSection(&dmo->cs);
+    hr = SetInputType_unlocked(iface, index, type, flags);
+    LeaveCriticalSection(&dmo->cs);
+    return hr;
+}
+
+static HRESULT WINAPI MediaObject_SetOutputType(IMediaObject *iface, DWORD index, const DMO_MEDIA_TYPE *type, DWORD flags)
+{
+    struct mp3_decoder *dmo = impl_from_IMediaObject(iface);
+    HRESULT hr;
+
+    EnterCriticalSection(&dmo->cs);
+    hr = SetOutputType_unlocked(iface, index, type, flags);
+    LeaveCriticalSection(&dmo->cs);
+    return hr;
+}
+
+static HRESULT WINAPI MediaObject_Flush(IMediaObject *iface)
+{
+    struct mp3_decoder *dmo = impl_from_IMediaObject(iface);
+    HRESULT hr;
+
+    EnterCriticalSection(&dmo->cs);
+    hr = Flush_unlocked(iface);
+    LeaveCriticalSection(&dmo->cs);
+    return hr;
+}
+
+static HRESULT WINAPI MediaObject_ProcessOutput(IMediaObject *iface, DWORD flags, DWORD count, DMO_OUTPUT_DATA_BUFFER *buffers, DWORD *status)
+{
+    struct mp3_decoder *dmo = impl_from_IMediaObject(iface);
+    HRESULT hr;
+
+    EnterCriticalSection(&dmo->cs);
+    hr = ProcessOutput_unlocked(iface, flags, count, buffers, status);
+    LeaveCriticalSection(&dmo->cs);
+    return hr;
+}
+
+static HRESULT WINAPI MediaObject_ProcessInput(IMediaObject *iface, DWORD index, IMediaBuffer *buffer, DWORD flags,
+        REFERENCE_TIME timestamp, REFERENCE_TIME timelength)
+{
+    struct mp3_decoder *dmo = impl_from_IMediaObject(iface);
+    HRESULT hr;
+
+    EnterCriticalSection(&dmo->cs);
+    hr = ProcessInput_unlocked(iface, index, buffer, flags, timestamp, timelength);
+    LeaveCriticalSection(&dmo->cs);
+    return hr;
 }
 
 static const IMediaObjectVtbl MediaObject_vtbl = {
@@ -581,6 +692,8 @@ static HRESULT create_mp3_decoder(IUnknown *outer, REFIID iid, void **obj)
     This->IMediaObject_iface.lpVtbl = &MediaObject_vtbl;
     This->ref = 1;
     This->outer = outer ? outer : &This->IUnknown_inner;
+    InitializeCriticalSectionEx(&This->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    This->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": mp3_decoder.cs");
 
     mpg123_init();
     This->mh = mpg123_new(NULL, &err);
