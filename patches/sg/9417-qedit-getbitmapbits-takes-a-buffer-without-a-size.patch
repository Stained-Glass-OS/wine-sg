From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] qedit: GetBitmapBits takes a buffer without a size pointer (9417)

Microsoft's poster-frame sample asks IMediaDet for the size, then for the
bits with no size pointer: GetBitmapBits(time, NULL, buffer, w, h). Wine
refused that call with E_POINTER, so thumbnailers written after the
sample drew nothing. A buffer with no size pointer is now taken as big
enough; neither pointer is still E_POINTER.
---
--- a/dlls/qedit/mediadet.c
+++ b/dlls/qedit/mediadet.c
@@ -982,8 +982,15 @@
 
     TRACE("(%p)->(%.16e %p %p %ld %ld)\n", This, StreamTime, pBufferSize, pBuffer, Width, Height);
 
+    /* Stained Glass OS (wine-sg 9417): a buffer without a size pointer is taken as
+     * big enough, as Microsoft's poster-frame sample asks: the size first, then
+     * GetBitmapBits(time, NULL, buffer, w, h) */
+#ifdef SG_MUTANT_MDET_SIZE_REQUIRED
     if (!pBufferSize)
         return E_POINTER;
+#endif
+    if (!pBufferSize && !pBuffer)
+        return E_POINTER;
     if (Width < 0 || Height < 0)
         return E_INVALIDARG;
 
@@ -1001,7 +1008,7 @@
     if (FAILED(hr = grab_bitmap(This, StreamTime, Width, Height, &dib, &size)))
         return hr;
 
-    if (*pBufferSize < (LONG)size)
+    if (pBufferSize && *pBufferSize < (LONG)size)
     {
         free(dib);
         *pBufferSize = size;
@@ -1009,7 +1016,8 @@
     }
 
     memcpy(pBuffer, dib, size);
-    *pBufferSize = size;
+    if (pBufferSize)
+        *pBufferSize = size;
     free(dib);
     return S_OK;
 }
