From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a context menu handler shows once and its commands find the items (7500)

WinRAR's RarExt is registered for its archive ProgID and for *, and has no
IPersist, so the duplicate check (IPersist::GetClassID) let it in twice:
"Extract files...", "Extract Here" and "Extract to" showed twice for a
.7z. The menu now remembers each handler's CLSID and loads it once, as
Windows does. RarExt also keeps the IDataObject that IShellExtInit::Initialize
gave it without a reference of its own and reads the files from it again
when its command runs; the menu released the object right after building
itself, so "Add to archive" and "Extract to" failed (E_FAIL, no files).
The menu now keeps the data object for as long as it keeps the handlers.
---
diff --git a/dlls/shell32/shlview_cmenu.c b/dlls/shell32/shlview_cmenu.c
index 7cbc4b4..688cb1b 100644
--- a/dlls/shell32/shlview_cmenu.c
+++ b/dlls/shell32/shlview_cmenu.c
@@ -92,8 +92,9 @@ typedef struct
     /* Stained Glass OS: other programs' context menu handlers (shellex\
      * ContextMenuHandlers -- TortoiseGit, 7-Zip, "Edit with Notepad++"),
      * each with the commands it took */
-    struct ext_handler { IContextMenu *cm; UINT first, count; } ext[MAX_EXT];
+    struct ext_handler { IContextMenu *cm; UINT first, count; CLSID clsid; } ext[MAX_EXT];
     UINT ext_count;
+    IDataObject *ext_data;  /* the items, given to the handlers; kept while they are (as Windows) */
 
     IUnknown *site;      /* IObjectWithSite: the object the menu is shown for */
 } ContextMenu;
@@ -179,6 +180,7 @@ static ULONG WINAPI ContextMenu_Release(IContextMenu3 *iface)
         SHELL_FreeSendToTargets(This->sendto);
         for (unsigned int i = 0; i < This->ext_count; ++i)
             IContextMenu_Release(This->ext[i].cm);
+        if (This->ext_data) IDataObject_Release(This->ext_data);
         if (This->site) IUnknown_Release(This->site);
         free(This);
     }
@@ -296,6 +298,11 @@ static void ext_add_from(ContextMenu *This, const WCHAR *type, HMENU hmenu, UINT
         {
             IPersist *persist;
             CLSID have;
+            /* a handler registered for several of the types (WinRAR: its ProgID and *) is loaded
+             * once, as Windows does; most handlers have no IPersist to tell them apart */
+#ifndef SG_MUTANT_HANDLER_TWICE
+            if (IsEqualCLSID(&This->ext[j].clsid, &clsid)) break;
+#endif
             if (SUCCEEDED(IContextMenu_QueryInterface(This->ext[j].cm, &IID_IPersist, (void **)&persist)))
             {
                 hr = IPersist_GetClassID(persist, &have);
@@ -331,6 +338,7 @@ static void ext_add_from(ContextMenu *This, const WCHAR *type, HMENU hmenu, UINT
             continue;
         }
         This->ext[This->ext_count].cm = cm;
+        This->ext[This->ext_count].clsid = clsid;
         This->ext[This->ext_count].first = *next;
         This->ext[This->ext_count].count = HRESULT_CODE(hr);
         This->ext_count++;
@@ -385,6 +393,7 @@ static void ext_add_package_verbs(ContextMenu *This, BOOL folders, HMENU hmenu,
             continue;
         }
         This->ext[This->ext_count].cm = menus[i];
+        This->ext[This->ext_count].clsid = GUID_NULL;
         This->ext[This->ext_count].first = *next;
         This->ext[This->ext_count].count = HRESULT_CODE(hr);
         This->ext_count++;
@@ -428,7 +437,15 @@ static void ext_add_handlers(ContextMenu *This, HMENU hmenu, UINT *pos, UINT idC
     }
     ext_add_from(This, L"AllFilesystemObjects", hmenu, pos, idCmdFirst, idCmdLast, flags, data, &next);
     ext_add_package_verbs(This, folders == This->cidl, hmenu, pos, idCmdFirst, idCmdLast, flags, &next);
+    /* Handlers may keep the data object Initialize gave them without a reference of their own and
+     * read the items from it again when a command is invoked (WinRAR's "Add to archive" found no
+     * files: the object was gone); the menu owns it for as long as it has the handlers. */
+#ifdef SG_MUTANT_DROP_ITEMS_EARLY
     IDataObject_Release(data);
+#else
+    if (This->ext_data) IDataObject_Release(This->ext_data);
+    This->ext_data = data;
+#endif
     if (next > EXT_ID_OFFSET) *uIDMax = max(*uIDMax, (INT)(idCmdFirst + next));
 }
 
