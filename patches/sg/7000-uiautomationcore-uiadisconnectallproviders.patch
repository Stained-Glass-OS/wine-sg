From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uiautomationcore: UiaDisconnectAllProviders (7000)

Electron and Chromium (Element, Discord, Slack, VS Code) delay-import
UiaDisconnectAllProviders from uiautomationcore, which did not export
it: their delay-load helper fails where they call it. It now
disconnects every provider node this process has handed to UI
Automation clients, as Windows does: the providers are released and a
client still holding such an element gets UIA_E_ELEMENTNOTAVAILABLE.
---
diff --git a/dlls/uiautomationcore/uia_provider.c b/dlls/uiautomationcore/uia_provider.c
index 1786286..609cd37 100644
--- a/dlls/uiautomationcore/uia_provider.c
+++ b/dlls/uiautomationcore/uia_provider.c
@@ -2981,6 +2981,45 @@ exit:
     LeaveCriticalSection(&provider_thread_cs);
 }
 
+/* Disconnect every node the provider thread has handed out, as
+ * UiaDisconnectAllProviders does: the providers are released, and clients
+ * holding these nodes get UIA_E_ELEMENTNOTAVAILABLE from then on. */
+static void uia_provider_thread_disconnect_all_nodes(void)
+{
+    struct list *cursor, *cursor2;
+
+    EnterCriticalSection(&provider_thread_cs);
+
+    if (provider_thread.ref)
+    {
+        LIST_FOR_EACH_SAFE(cursor, cursor2, &provider_thread.nodes_list)
+        {
+            struct uia_node *node_data = LIST_ENTRY(cursor, struct uia_node, prov_thread_list_entry);
+
+            list_remove(cursor);
+            list_init(cursor);
+            if (!list_empty(&node_data->node_map_list_entry))
+            {
+                list_remove(&node_data->node_map_list_entry);
+                list_init(&node_data->node_map_list_entry);
+                if (list_empty(&node_data->map->nodes_list))
+                {
+                    rb_remove(&provider_thread.node_map, &node_data->map->entry);
+                    SafeArrayDestroy(node_data->map->runtime_id);
+                    free(node_data->map);
+                }
+                node_data->map = NULL;
+            }
+#ifndef SG_MUTANT_UIA_DISCONNECT_ALL_KEEPS
+            if (!node_data->disconnected)
+                IWineUiaNode_disconnect(&node_data->IWineUiaNode_iface);
+#endif
+        }
+    }
+
+    LeaveCriticalSection(&provider_thread_cs);
+}
+
 static HRESULT uia_provider_thread_add_node(HUIANODE node, SAFEARRAY *rt_id)
 {
     struct uia_node *node_data = impl_from_IWineUiaNode((IWineUiaNode *)node);
@@ -3235,6 +3274,18 @@ LRESULT WINAPI UiaReturnRawElementProvider(HWND hwnd, WPARAM wparam,
     return uia_lresult_from_node(node);
 }
 
+/***********************************************************************
+ *          UiaDisconnectAllProviders (uiautomationcore.@)
+ */
+HRESULT WINAPI UiaDisconnectAllProviders(void)
+{
+    TRACE("()\n");
+
+    uia_provider_thread_disconnect_all_nodes();
+
+    return S_OK;
+}
+
 /***********************************************************************
  *          UiaDisconnectProvider (uiautomationcore.@)
  */
diff --git a/dlls/uiautomationcore/uiautomationcore.spec b/dlls/uiautomationcore/uiautomationcore.spec
index 7e89753..1ce36e5 100644
--- a/dlls/uiautomationcore/uiautomationcore.spec
+++ b/dlls/uiautomationcore/uiautomationcore.spec
@@ -58,7 +58,7 @@
 @ stdcall TransformPattern_Rotate(ptr double)
 @ stdcall UiaAddEvent(ptr long ptr long ptr long ptr ptr)
 @ stdcall UiaClientsAreListening()
-#@ stub UiaDisconnectAllProviders
+@ stdcall UiaDisconnectAllProviders()
 @ stdcall UiaDisconnectProvider(ptr)
 @ stdcall UiaEventAddWindow(ptr long)
 @ stdcall UiaEventRemoveWindow(ptr long)
diff --git a/include/uiautomationcoreapi.h b/include/uiautomationcoreapi.h
index a15bc6b..45fe6d7 100644
--- a/include/uiautomationcoreapi.h
+++ b/include/uiautomationcoreapi.h
@@ -701,6 +701,7 @@ HRESULT WINAPI UiaGetRootNode(HUIANODE *huianode);
 HRESULT WINAPI UiaNodeFromFocus(struct UiaCacheRequest *cache_req, SAFEARRAY **out_req, BSTR *tree_struct);
 HRESULT WINAPI UiaNodeFromPoint(double x, double y, struct UiaCacheRequest *cache_req, SAFEARRAY **out_req, BSTR *tree_struct);
 HRESULT WINAPI UiaDisconnectProvider(IRawElementProviderSimple *elprov);
+HRESULT WINAPI UiaDisconnectAllProviders(void);
 HRESULT WINAPI UiaGetUpdatedCache(HUIANODE huianode, struct UiaCacheRequest *cache_req, enum NormalizeState normalize_state,
         struct UiaCondition *normalize_cond, SAFEARRAY **out_req, BSTR *tree_struct);
 HRESULT WINAPI UiaNavigate(HUIANODE huianode, enum NavigateDirection dir, struct UiaCondition *nav_condition,
