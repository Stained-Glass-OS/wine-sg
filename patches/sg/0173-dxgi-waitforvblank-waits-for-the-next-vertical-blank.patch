From: Stained Glass OS <dev@stained-glass.example>
Subject: dxgi: IDXGIOutput::WaitForVBlank waits for the next vertical blank

It returned E_NOTIMPL at once. Like DwmFlush (0170), it is what a vsync
thread paces itself with -- Chromium's, and Firefox tries it before
DwmFlush -- and a program that does not treat the failure as a reason to
sleep spins. It now waits for the next refresh boundary of the output's
mode, on the grid DwmGetCompositionTimingInfo reports.

Gate: test/vsync-gate.sh (30 calls take 30 frames).
---
--- a/dlls/dxgi/output.c
+++ b/dlls/dxgi/output.c
@@ -363,14 +363,40 @@
 
 static HRESULT STDMETHODCALLTYPE dxgi_output_WaitForVBlank(IDXGIOutput6 *iface)
 {
-    static BOOL once = FALSE;
+    struct dxgi_output *output = impl_from_IDXGIOutput6(iface);
+    enum wined3d_display_rotation rotation;
+    struct wined3d_display_mode mode;
+    LARGE_INTEGER frequency, now, due;
+    LONGLONG period, next;
+    unsigned int rate = 60;
+    HANDLE timer;
 
-    if (!once++)
-        FIXME("iface %p stub!\n", iface);
-    else
-        TRACE("iface %p stub!\n", iface);
+    TRACE("iface %p.\n", iface);
 
-    return E_NOTIMPL;
+    /* the next vertical blank of the output's mode, on the same grid as
+     * DwmGetCompositionTimingInfo's */
+    wined3d_mutex_lock();
+    if (SUCCEEDED(wined3d_output_get_display_mode(output->wined3d_output, &mode, &rotation))
+            && mode.refresh_rate)
+        rate = mode.refresh_rate;
+    wined3d_mutex_unlock();
+
+    QueryPerformanceFrequency(&frequency);
+    QueryPerformanceCounter(&now);
+    period = frequency.QuadPart / rate;
+    if (period <= 0)
+        return S_OK;
+    next = (now.QuadPart / period + 1) * period;
+    due.QuadPart = -((next - now.QuadPart) * 10000000 / frequency.QuadPart);
+    if (!due.QuadPart)
+        due.QuadPart = -1;
+    if ((timer = CreateWaitableTimerW(NULL, TRUE, NULL)))
+    {
+        if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE))
+            WaitForSingleObject(timer, INFINITE);
+        CloseHandle(timer);
+    }
+    return S_OK;
 }
 
 static HRESULT STDMETHODCALLTYPE dxgi_output_TakeOwnership(IDXGIOutput6 *iface, IUnknown *device, BOOL exclusive)
