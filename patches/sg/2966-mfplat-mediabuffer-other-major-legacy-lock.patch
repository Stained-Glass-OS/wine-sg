From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfplat: MFCreateMediaBufferFromMediaType other majors, legacy buffer Lock

- MFCreateMediaBufferFromMediaType (E_NOTIMPL for a major type other than
  audio/video): any other major type, null included, gets a plain buffer of
  the requested minimum length (16-byte aligned at least), E_INVALIDARG when
  that length is 0.
- The legacy IMediaBuffer created by MFCreateLegacyMediaBufferOnMFMediaBuffer
  calls IMFMediaBuffer::Lock without a length pointer on the first
  GetBufferAndLength and reads the length with GetCurrentLength.
Three todo_wine groups of dlls/mfplat/tests/mfplat.c are removed.

---
diff --git a/dlls/mfplat/buffer.c b/dlls/mfplat/buffer.c
index cb4f366..b2b2c73 100644
--- a/dlls/mfplat/buffer.c
+++ b/dlls/mfplat/buffer.c
@@ -1978,8 +1978,16 @@ HRESULT WINAPI MFCreateMediaBufferFromMediaType(IMFMediaType *media_type, LONGLO
         return create_1d_buffer(min_length, alignment - 1, buffer);
     }
 
+    /* any other major type: a plain buffer of the requested minimum length */
+#ifdef SG_MUTANT_MEDIABUF_OTHER_NOTIMPL
     FIXME("Major type %s is not supported.\n", debugstr_guid(&major));
     return E_NOTIMPL;
+#endif
+    if (!min_length)
+        return E_INVALIDARG;
+
+    alignment = max(16, alignment);
+    return create_1d_buffer(min_length, alignment - 1, buffer);
 }
 
 struct legacy_buffer
@@ -2090,8 +2098,24 @@ static HRESULT WINAPI legacy_buffer_GetBufferAndLength(IMediaBuffer *iface, BYTE
     if ((*data = InterlockedCompareExchangePointer(&buffer->locked_data, NULL, NULL)))
         return IMFMediaBuffer_GetCurrentLength(buffer->media_buffer, len);
 
+    /* the length is not asked from Lock(), it is read from the buffer itself */
+#ifdef SG_MUTANT_LEGACY_LOCK_LENGTH
     if (SUCCEEDED(hr = IMFMediaBuffer_Lock(buffer->media_buffer, data, NULL, len)))
+    {
+        InterlockedExchangePointer(&buffer->locked_data, *data);
+        return hr;
+    }
+    return hr;
+#endif
+    if (SUCCEEDED(hr = IMFMediaBuffer_Lock(buffer->media_buffer, data, NULL, NULL)))
+    {
         InterlockedExchangePointer(&buffer->locked_data, *data);
+        if (FAILED(hr = IMFMediaBuffer_GetCurrentLength(buffer->media_buffer, len)))
+        {
+            IMFMediaBuffer_Unlock(buffer->media_buffer);
+            InterlockedExchangePointer(&buffer->locked_data, NULL);
+        }
+    }
 
     return hr;
 }
diff --git a/dlls/mfplat/tests/mfplat.c b/dlls/mfplat/tests/mfplat.c
index 9707846..708048b 100644
--- a/dlls/mfplat/tests/mfplat.c
+++ b/dlls/mfplat/tests/mfplat.c
@@ -3236,7 +3236,7 @@ static HRESULT WINAPI test_buffer_Lock(IMFMediaBuffer *iface, BYTE **data, DWORD
 {
     ok(expect_locks--, "Unexpected call\n");
     ok(!maxlength, "got maxlength\n");
-    todo_wine ok(!length, "got length\n");
+    ok(!length, "got length\n");
     *data = (BYTE *)0xdeadbeef;
     return S_OK;
 }
@@ -7330,9 +7330,9 @@ static void test_MFCreateMediaBufferFromMediaType(void)
     hr = IMFMediaType_SetGUID(media_type, &MF_MT_MAJOR_TYPE, &GUID_NULL);
     ok(hr == S_OK, "Failed to set attribute, hr %#lx.\n", hr);
     hr = pMFCreateMediaBufferFromMediaType(media_type, 0, 0, 0, &buffer);
-    todo_wine ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
     hr = pMFCreateMediaBufferFromMediaType(media_type, 0, 16, 0, &buffer);
-    todo_wine ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     if (hr == S_OK)
     {
     hr = IMFMediaBuffer_GetMaxLength(buffer, &length);
