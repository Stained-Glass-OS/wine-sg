+}
+
+static HRESULT composition_resize(struct composition_swapchain *swapchain, UINT buffer_count,
+        UINT width, UINT height, DXGI_FORMAT format, UINT flags)
+{
+    DXGI_SWAP_CHAIN_DESC1 old = swapchain->desc;
+    HRESULT hr;
+
+    if (format != DXGI_FORMAT_UNKNOWN && !composition_format_supported(format))
+    {
+        FIXME("Unsupported format %#x.\n", format);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    EnterCriticalSection(&swapchain->cs);
+    if (buffer_count)
+        swapchain->desc.BufferCount = buffer_count;
+    /* A composition swap chain has no window to take a size from. */
+    if (width)
+        swapchain->desc.Width = width;
+    if (height)
+        swapchain->desc.Height = height;
+    if (format != DXGI_FORMAT_UNKNOWN)
+        swapchain->desc.Format = format;
+    swapchain->desc.Flags = flags;
+
+    composition_destroy_buffers(swapchain);
+    if (FAILED(hr = composition_create_buffers(swapchain)))
+    {
+        swapchain->desc = old;
+        composition_create_buffers(swapchain);
+    }
+    LeaveCriticalSection(&swapchain->cs);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_ResizeBuffers(IDXGISwapChain4 *iface,
+        UINT buffer_count, UINT width, UINT height, DXGI_FORMAT format, UINT flags)
+{
