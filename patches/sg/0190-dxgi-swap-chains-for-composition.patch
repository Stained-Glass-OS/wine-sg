+HRESULT dxgi_composition_swapchain_create(IWineDXGIFactory *factory, IUnknown *device,
+        const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGISwapChain1 **ret)
+{
+    struct composition_swapchain *swapchain;
+    ID3D11Device *d3d11_device;
+    HRESULT hr;
+
+    if (FAILED(IUnknown_QueryInterface(device, &IID_ID3D11Device, (void **)&d3d11_device)))
+    {
+        FIXME("Composition swap chains are only implemented for Direct3D 11 devices.\n");
+        return E_NOTIMPL;
+    }
+
+    /* Composition swap chains must use the flip model, and have no scaling
+     * that needs a window. */
+    if ((desc->SwapEffect != DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL && desc->SwapEffect != DXGI_SWAP_EFFECT_FLIP_DISCARD)
+            || !desc->Width || !desc->Height || desc->Scaling == DXGI_SCALING_NONE)
+    {
+        WARN("Invalid description for a composition swap chain.\n");
+        ID3D11Device_Release(d3d11_device);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+    if (!composition_format_supported(desc->Format))
+    {
+        FIXME("Unsupported format %s.\n", debug_dxgi_format(desc->Format));
+        ID3D11Device_Release(d3d11_device);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    if (!(swapchain = calloc(1, sizeof(*swapchain))))
+    {
+        ID3D11Device_Release(d3d11_device);
+        return E_OUTOFMEMORY;
+    }
+
+    swapchain->IDXGISwapChain4_iface.lpVtbl = &composition_swapchain_vtbl;
+    swapchain->IWineDXGICompositionSwapChain_iface.lpVtbl = &composition_target_vtbl;
+    swapchain->refcount = 1;
+    wined3d_private_store_init(&swapchain->private_store);
+    swapchain->factory = factory;
+    IWineDXGIFactory_AddRef(factory);
+    swapchain->device = d3d11_device;
+    swapchain->desc = *desc;
+    swapchain->max_latency = 3;
+    InitializeCriticalSectionEx(&swapchain->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    swapchain->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": composition_swapchain.cs");
+
+    if (FAILED(hr = composition_create_buffers(swapchain)))
+    {
+        IDXGISwapChain4_Release(&swapchain->IDXGISwapChain4_iface);
+        return hr;
+    }
+    if (!(swapchain->refresh_timer = CreateThreadpoolTimer(composition_refresh, swapchain, NULL)))
+        WARN("Failed to create the refresh timer, error %lu.\n", GetLastError());
+
+    TRACE("Created composition swapchain %p.\n", swapchain);
+    *ret = (IDXGISwapChain1 *)&swapchain->IDXGISwapChain4_iface;
+    return S_OK;
+}
