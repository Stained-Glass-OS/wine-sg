+/*
+ * A composition swap chain has no window of its own: DirectComposition shows
+ * it as the content of a visual, and the visual tree is bound to a window by
+ * an IDCompositionTarget. dcomp.dll tells us that window (and the visual's
+ * offset) through IWineDXGICompositionSwapChain when the tree is committed.
+ *
+ * This implementation is for Direct3D 11 devices. The back buffer is an
+ * ordinary texture that persists across presents (so partial updates keep the
+ * rest of the frame). Present copies it into a staging texture, reads it back
+ * into memory and draws that into the target window with GDI. That is slow
+ * compared with a real compositor, but needs nothing from wined3d that a
+ * Direct3D 11 application could not do itself.
+ *
+ * On Windows the compositor puts a visual's content above whatever GDI draws
+ * in the window. Here there is no compositor: the window, or an ancestor in
+ * another process (a WebView2 host), may paint over the frame after it was
+ * drawn, and nobody tells us. So the last frame is drawn again shortly after
+ * each present and then periodically, from memory, on a thread-pool timer.
+ */
+
+#define COBJMACROS
+#include "d3d11.h"
+#include "dxgi_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dxgi);
+
+struct composition_swapchain
+{
+    IDXGISwapChain4 IDXGISwapChain4_iface;
+    IWineDXGICompositionSwapChain IWineDXGICompositionSwapChain_iface;
+    LONG refcount;
+    struct wined3d_private_store private_store;
+
+    IWineDXGIFactory *factory;
+    ID3D11Device *device;
+    DXGI_SWAP_CHAIN_DESC1 desc;
+
+    CRITICAL_SECTION cs;
+    ID3D11Texture2D *buffer;
+    ID3D11Texture2D *staging;
+    DWORD *frame;               /* last presented frame, BGRX, width * height */
+    UINT frame_width, frame_height;
+    TP_TIMER *refresh_timer;
+    HWND window;
+    int x, y;
+    LONG present_count;
+    DXGI_RGBA background;
+    DXGI_MODE_ROTATION rotation;
+    UINT max_latency;
+};
+
+static inline struct composition_swapchain *impl_from_IDXGISwapChain4(IDXGISwapChain4 *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_swapchain, IDXGISwapChain4_iface);
+}
+
+static inline struct composition_swapchain *impl_from_IWineDXGICompositionSwapChain(IWineDXGICompositionSwapChain *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_swapchain, IWineDXGICompositionSwapChain_iface);
+}
+
+static BOOL composition_format_supported(DXGI_FORMAT format)
+{
+    switch (format)
+    {
+        case DXGI_FORMAT_B8G8R8A8_UNORM:
+        case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+        case DXGI_FORMAT_R8G8B8A8_UNORM:
+        case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+            return TRUE;
+        default:
+            return FALSE;
+    }
+}
+
+static HRESULT composition_create_buffers(struct composition_swapchain *swapchain)
+{
+    D3D11_TEXTURE2D_DESC desc;
+    HRESULT hr;
+
+    desc.Width = swapchain->desc.Width;
+    desc.Height = swapchain->desc.Height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = swapchain->desc.Format;
+    desc.SampleDesc.Count = 1;
+    desc.SampleDesc.Quality = 0;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    desc.CPUAccessFlags = 0;
+    desc.MiscFlags = 0;
+    if (FAILED(hr = ID3D11Device_CreateTexture2D(swapchain->device, &desc, NULL, &swapchain->buffer)))
+    {
+        WARN("Failed to create back buffer, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (FAILED(hr = ID3D11Device_CreateTexture2D(swapchain->device, &desc, NULL, &swapchain->staging)))
+    {
+        WARN("Failed to create staging texture, hr %#lx.\n", hr);
+        ID3D11Texture2D_Release(swapchain->buffer);
+        swapchain->buffer = NULL;
+        return hr;
+    }
+    return S_OK;
+}
+
+static void composition_destroy_buffers(struct composition_swapchain *swapchain)
+{
+    if (swapchain->buffer)
+        ID3D11Texture2D_Release(swapchain->buffer);
+    if (swapchain->staging)
+        ID3D11Texture2D_Release(swapchain->staging);
+    swapchain->buffer = NULL;
+    swapchain->staging = NULL;
+}
+
+/* Draws the last presented frame into the target window. Called with the
+ * critical section held; touches no Direct3D state, so any thread may call it. */
+static void composition_draw(struct composition_swapchain *swapchain)
+{
+    BITMAPINFO info;
+    HDC dc;
+
+    if (!swapchain->window || !swapchain->frame || !IsWindowVisible(swapchain->window))
+        return;
+
+    memset(&info, 0, sizeof(info));
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = swapchain->frame_width;
+    info.bmiHeader.biHeight = -(LONG)swapchain->frame_height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+
+    if ((dc = GetDCEx(swapchain->window, 0, DCX_CACHE | DCX_CLIPSIBLINGS)))
+    {
+        SetDIBitsToDevice(dc, swapchain->x, swapchain->y, swapchain->frame_width, swapchain->frame_height,
+                0, 0, 0, swapchain->frame_height, swapchain->frame, &info, DIB_RGB_COLORS);
+        ReleaseDC(swapchain->window, dc);
+    }
+}
+
+/* Reads the back buffer into memory. Called with the critical section held,
+ * on the thread that presents. Premultiplied alpha is drawn opaque: nothing
+ * is composed beneath the visual here. */
+static void composition_read_frame(struct composition_swapchain *swapchain)
+{
+    UINT width = swapchain->desc.Width, height = swapchain->desc.Height, i, j;
+    BOOL swap_rb = swapchain->desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM
+            || swapchain->desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+    ID3D11DeviceContext *context;
+    D3D11_MAPPED_SUBRESOURCE map;
+    const BYTE *src;
+    DWORD *dst;
+    HRESULT hr;
+
+    if (swapchain->frame_width != width || swapchain->frame_height != height)
+    {
+        free(swapchain->frame);
+        swapchain->frame_width = swapchain->frame_height = 0;
+        if (!(swapchain->frame = malloc(width * height * sizeof(*swapchain->frame))))
+            return;
+        swapchain->frame_width = width;
+        swapchain->frame_height = height;
+    }
+
+    ID3D11Device_GetImmediateContext(swapchain->device, &context);
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)swapchain->staging,
+            (ID3D11Resource *)swapchain->buffer);
+    if (FAILED(hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)swapchain->staging, 0,
+            D3D11_MAP_READ, 0, &map)))
+    {
+        WARN("Failed to map staging texture, hr %#lx.\n", hr);
+        ID3D11DeviceContext_Release(context);
+        return;
+    }
+    for (i = 0; i < height; ++i)
+    {
+        src = (const BYTE *)map.pData + i * map.RowPitch;
+        dst = swapchain->frame + i * width;
+        if (!swap_rb)
+            memcpy(dst, src, width * 4);
+        else
+            for (j = 0; j < width; ++j)
+                dst[j] = src[j * 4 + 2] | (src[j * 4 + 1] << 8) | (src[j * 4] << 16) | (src[j * 4 + 3] << 24);
+    }
+    ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)swapchain->staging, 0);
+    ID3D11DeviceContext_Release(context);
+}
+
+static void CALLBACK composition_refresh(TP_CALLBACK_INSTANCE *instance, void *context, TP_TIMER *timer)
+{
+    struct composition_swapchain *swapchain = context;
+
+    EnterCriticalSection(&swapchain->cs);
+    composition_draw(swapchain);
+    LeaveCriticalSection(&swapchain->cs);
+}
+
+/* Draw again 100 ms from now, then every 500 ms. */
+static void composition_schedule_refresh(struct composition_swapchain *swapchain)
+{
+    LARGE_INTEGER due;
+    FILETIME ft;
+
+    if (!swapchain->refresh_timer)
+        return;
+    due.QuadPart = -100 * 10000;
+    ft.dwLowDateTime = due.u.LowPart;
+    ft.dwHighDateTime = due.u.HighPart;
+    SetThreadpoolTimer(swapchain->refresh_timer, &ft, 500, 50);
+}
+
+/* IUnknown methods */
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_QueryInterface(IDXGISwapChain4 *iface, REFIID riid, void **object)
+{
+    struct composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
+    TRACE("iface %p, riid %s, object %p.\n", iface, debugstr_guid(riid), object);
+
+    if (IsEqualGUID(riid, &IID_IUnknown)
+            || IsEqualGUID(riid, &IID_IDXGIObject)
+            || IsEqualGUID(riid, &IID_IDXGIDeviceSubObject)
+            || IsEqualGUID(riid, &IID_IDXGISwapChain)
+            || IsEqualGUID(riid, &IID_IDXGISwapChain1)
+            || IsEqualGUID(riid, &IID_IDXGISwapChain2)
+            || IsEqualGUID(riid, &IID_IDXGISwapChain3)
+            || IsEqualGUID(riid, &IID_IDXGISwapChain4))
+    {
+        IDXGISwapChain4_AddRef(iface);
+        *object = iface;
+        return S_OK;
+    }
+    if (IsEqualGUID(riid, &IID_IWineDXGICompositionSwapChain))
+    {
+        IDXGISwapChain4_AddRef(iface);
+        *object = &swapchain->IWineDXGICompositionSwapChain_iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(riid));
+    *object = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE composition_swapchain_AddRef(IDXGISwapChain4 *iface)
+{
+    struct composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+    ULONG refcount = InterlockedIncrement(&swapchain->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", swapchain, refcount);
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE composition_swapchain_Release(IDXGISwapChain4 *iface)
+{
+    struct composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+    ULONG refcount = InterlockedDecrement(&swapchain->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", swapchain, refcount);
+
+    if (!refcount)
+    {
+        if (swapchain->refresh_timer)
+        {
+            SetThreadpoolTimer(swapchain->refresh_timer, NULL, 0, 0);
+            WaitForThreadpoolTimerCallbacks(swapchain->refresh_timer, TRUE);
+            CloseThreadpoolTimer(swapchain->refresh_timer);
+        }
+        free(swapchain->frame);
+        composition_destroy_buffers(swapchain);
+        wined3d_private_store_cleanup(&swapchain->private_store);
+        swapchain->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&swapchain->cs);
+        ID3D11Device_Release(swapchain->device);
+        IWineDXGIFactory_Release(swapchain->factory);
+        free(swapchain);
+    }
+    return refcount;
+}
+
