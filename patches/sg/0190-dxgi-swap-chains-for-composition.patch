+/* IDXGISwapChain methods */
+
+static HRESULT composition_present(struct composition_swapchain *swapchain, UINT flags)
+{
+    if (flags & DXGI_PRESENT_TEST)
+        return S_OK;
+
+    EnterCriticalSection(&swapchain->cs);
+    if (swapchain->buffer)
+    {
+        composition_read_frame(swapchain);
+        composition_draw(swapchain);
+        composition_schedule_refresh(swapchain);
+    }
+    LeaveCriticalSection(&swapchain->cs);
+
+    InterlockedIncrement(&swapchain->present_count);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_Present(IDXGISwapChain4 *iface, UINT sync_interval, UINT flags)
+{
+    struct composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
+    TRACE("iface %p, sync_interval %u, flags %#x.\n", iface, sync_interval, flags);
+    return composition_present(swapchain, flags);
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_GetBuffer(IDXGISwapChain4 *iface,
+        UINT buffer_idx, REFIID riid, void **surface)
+{
+    struct composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, buffer_idx %u, riid %s, surface %p.\n", iface, buffer_idx, debugstr_guid(riid), surface);
+
+    /* Flip model: only the current back buffer, index 0, can be written. */
+    if (buffer_idx)
+    {
+        WARN("Buffer %u requested; only buffer 0 is accessible.\n", buffer_idx);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    EnterCriticalSection(&swapchain->cs);
+    hr = swapchain->buffer ? ID3D11Texture2D_QueryInterface(swapchain->buffer, riid, surface) : DXGI_ERROR_INVALID_CALL;
+    LeaveCriticalSection(&swapchain->cs);
+    return hr;
+}
+
