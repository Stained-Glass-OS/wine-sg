+
+    return composition_swapchain_Release(&swapchain->IDXGISwapChain4_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE composition_target_set_target(IWineDXGICompositionSwapChain *iface,
+        HWND window, int x, int y)
+{
+    struct composition_swapchain *swapchain = impl_from_IWineDXGICompositionSwapChain(iface);
+
+    TRACE("iface %p, window %p, x %d, y %d.\n", iface, window, x, y);
+
+    EnterCriticalSection(&swapchain->cs);
+    swapchain->window = window;
+    swapchain->x = x;
+    swapchain->y = y;
+    composition_draw(swapchain);
+    composition_schedule_refresh(swapchain);
+    LeaveCriticalSection(&swapchain->cs);
+    return S_OK;
+}
