From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:48:22 -0700
Subject: [PATCH] uiautomationcore: enum Clone, MSAA runtime id,
 ShowContextMenu (3263)

- IEnumVARIANT::Clone of the bridge's selection enumeration (accSelection)
  makes a copy with the same items and position instead of E_NOTIMPL.
- The MSAA proxy provider's IRawElementProviderFragment::GetRuntimeId
  returns NULL for the element at the root of its window and
  {UiaAppendRuntimeId, value} otherwise (the unique id of an IAccessible2
  object, the child id of a simple element, else the identity of the
  object), instead of E_NOTIMPL.
- IUIAutomationElement3::ShowContextMenu asks the element's providers for
  IRawElementProviderSimple2::ShowContextMenu (new pattern-method path,
  like SetFocus); UIA_E_NOTSUPPORTED when none has it.

diff --git a/dlls/uiautomationcore/uia_bridge.c b/dlls/uiautomationcore/uia_bridge.c
index ee82252..5cf67fe 100644
--- a/dlls/uiautomationcore/uia_bridge.c
+++ b/dlls/uiautomationcore/uia_bridge.c
@@ -624,8 +624,38 @@ static HRESULT WINAPI bridge_enum_Reset(IEnumVARIANT *iface)
 
 static HRESULT WINAPI bridge_enum_Clone(IEnumVARIANT *iface, IEnumVARIANT **out)
 {
+    struct bridge_enum *e = impl_from_IEnumVARIANT(iface), *clone;
+    ULONG i;
+
+    if (!out) return E_POINTER;
     *out = NULL;
+#ifdef SG_MUTANT_UIA_ENUMCLONE
     return E_NOTIMPL;
+#endif
+    /* a copy of the enumeration state: the same items, at the same position */
+    if (!(clone = calloc(1, sizeof(*clone)))) return E_OUTOFMEMORY;
+    clone->IEnumVARIANT_iface.lpVtbl = e->IEnumVARIANT_iface.lpVtbl;
+    clone->ref = 1;
+    clone->count = e->count;
+    clone->pos = e->pos;
+    if (e->count && !(clone->items = calloc(e->count, sizeof(*clone->items))))
+    {
+        free(clone);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < e->count; i++)
+    {
+        HRESULT hr = VariantCopy(&clone->items[i], &e->items[i]);
+        if (FAILED(hr))
+        {
+            while (i--) VariantClear(&clone->items[i]);
+            free(clone->items);
+            free(clone);
+            return hr;
+        }
+    }
+    *out = &clone->IEnumVARIANT_iface;
+    return S_OK;
 }
 
 static const IEnumVARIANTVtbl bridge_enum_vtbl = {
diff --git a/dlls/uiautomationcore/uia_com_client.c b/dlls/uiautomationcore/uia_com_client.c
index 8d6e6d1..5d3f8e9 100644
--- a/dlls/uiautomationcore/uia_com_client.c
+++ b/dlls/uiautomationcore/uia_com_client.c
@@ -4573,8 +4573,35 @@ static HRESULT WINAPI uia_element_get_CachedFlowsFrom(IUIAutomationElement9 *ifa
 
 static HRESULT WINAPI uia_element_ShowContextMenu(IUIAutomationElement9 *iface)
 {
-    FIXME("%p: stub\n", iface);
+    IWineUiaNode *node = uia_checked_node(impl_from_IUIAutomationElement9(iface)->node);
+    HRESULT hr = UIA_E_NOTSUPPORTED;
+    int idx;
+
+    TRACE("%p\n", iface);
+
+#ifdef SG_MUTANT_UIACOM_NO_MENU
     return E_NOTIMPL;
+#endif
+    if (!node)
+        return E_INVALIDARG;
+
+    /* Asks each provider of the element in turn. GUESS: the parent's menu when the element has none
+     * (documented) is not tried. */
+    for (idx = 0; ; idx++)
+    {
+        VARIANT v;
+        HRESULT hr2 = call_pattern_on_node_provider(node, idx, 0, PATTERN_METHOD_SHOW_CONTEXT_MENU, NULL, &v);
+
+        if (idx && FAILED(hr2) && hr2 == E_INVALIDARG)
+            break;
+        if (!idx && FAILED(hr2) && hr2 == E_INVALIDARG)
+            return hr2;
+
+        hr = hr2;
+        if (hr != UIA_E_NOTSUPPORTED)
+            break;
+    }
+    return hr;
 }
 
 static HRESULT WINAPI uia_element_get_CurrentIsPeripheral(IUIAutomationElement9 *iface, BOOL *ret_val)
diff --git a/dlls/uiautomationcore/uia_patterns.c b/dlls/uiautomationcore/uia_patterns.c
index d457ed4..c9b4e82 100644
--- a/dlls/uiautomationcore/uia_patterns.c
+++ b/dlls/uiautomationcore/uia_patterns.c
@@ -241,6 +241,19 @@ HRESULT uia_pattern_call_provider(IRawElementProviderSimple *elprov, int pattern
     {
         IRawElementProviderFragment *frag;
 
+        if (method == PATTERN_METHOD_SHOW_CONTEXT_MENU)
+        {
+            IRawElementProviderSimple2 *simple2;
+
+            hr = IRawElementProviderSimple_QueryInterface(elprov, &IID_IRawElementProviderSimple2, (void **)&simple2);
+            if (FAILED(hr))
+                return UIA_E_NOTSUPPORTED;
+
+            hr = IRawElementProviderSimple2_ShowContextMenu(simple2);
+            IRawElementProviderSimple2_Release(simple2);
+            return hr;
+        }
+
         if (method != PATTERN_METHOD_SET_FOCUS)
             return E_INVALIDARG;
 
diff --git a/dlls/uiautomationcore/uia_private.h b/dlls/uiautomationcore/uia_private.h
index 336a767..d193302 100644
--- a/dlls/uiautomationcore/uia_private.h
+++ b/dlls/uiautomationcore/uia_private.h
@@ -121,6 +121,7 @@ enum uia_pattern_method {
     PATTERN_METHOD_LEGACY_SET_VALUE,
     PATTERN_METHOD_LEGACY_GET_IACCESSIBLE,
     PATTERN_METHOD_SET_FOCUS,
+    PATTERN_METHOD_SHOW_CONTEXT_MENU,
 };
 
 IWineUiaNode *uia_checked_node(HUIANODE huianode);
diff --git a/dlls/uiautomationcore/uia_provider.c b/dlls/uiautomationcore/uia_provider.c
index ab3c58b..65a78c5 100644
--- a/dlls/uiautomationcore/uia_provider.c
+++ b/dlls/uiautomationcore/uia_provider.c
@@ -1112,9 +1112,38 @@ static HRESULT WINAPI msaa_fragment_Navigate(IRawElementProviderFragment *iface,
 static HRESULT WINAPI msaa_fragment_GetRuntimeId(IRawElementProviderFragment *iface,
         SAFEARRAY **ret_val)
 {
-    FIXME("%p, %p: stub!\n", iface, ret_val);
+    struct msaa_provider *msaa_prov = impl_from_msaa_fragment(iface);
+    LONG id[2] = { UiaAppendRuntimeId, 0 };
+    SAFEARRAY *sa;
+    LONG idx, unique = 0;
+
+    TRACE("%p, %p\n", iface, ret_val);
+
     *ret_val = NULL;
+#ifdef SG_MUTANT_UIA_RUNTIMEID
     return E_NOTIMPL;
+#endif
+    /* The element at the root of its window gets its runtime id from the window. */
+    if (msaa_check_root_acc(msaa_prov))
+        return S_OK;
+
+    /* A value that is unique among the elements of the window: the unique id of an IAccessible2 object, the child
+     * id of a simple element, else the identity of the object (a GUESS: not stable for proxies made again). */
+    if (!(msaa_prov->ia2 && SUCCEEDED(IAccessible2_get_uniqueID(msaa_prov->ia2, &unique)) && unique))
+    {
+        if (V_I4(&msaa_prov->cid) != CHILDID_SELF)
+            unique = V_I4(&msaa_prov->cid);
+        else
+            unique = (LONG)(ULONG_PTR)msaa_prov->acc;
+    }
+    id[1] = unique;
+
+    if (!(sa = SafeArrayCreateVector(VT_I4, 0, 2)))
+        return E_OUTOFMEMORY;
+    for (idx = 0; idx < 2; idx++)
+        SafeArrayPutElement(sa, &idx, &id[idx]);
+    *ret_val = sa;
+    return S_OK;
 }
 
 static HRESULT WINAPI msaa_fragment_get_BoundingRectangle(IRawElementProviderFragment *iface,
