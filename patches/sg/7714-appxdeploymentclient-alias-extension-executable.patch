From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxdeploymentclient: an execution alias runs its extension's program

---
--- a/dlls/appxdeploymentclient/deploy.c
+++ b/dlls/appxdeploymentclient/deploy.c
@@ -950,7 +950,7 @@
 static void create_aliases( IAppxManifestReader *manifest, const struct package_record *rec, struct strlist *list )
 {
     WCHAR dir[MAX_PATH], family_dir[MAX_PATH], path[MAX_PATH], target[MAX_PATH], aumid[512];
-    WCHAR *app_id = NULL, *exe = NULL;
+    WCHAR *app_id = NULL, *exe = NULL, *ext_exe = NULL;
     IXmlReader *reader = NULL;
     IStream *stream = NULL;
     XmlNodeType type;
@@ -980,7 +980,8 @@
         {
             free( app_id );
             free( exe );
-            app_id = exe = NULL;
+            free( ext_exe );
+            app_id = exe = ext_exe = NULL;
             if (IXmlReader_MoveToAttributeByName( reader, L"Id", NULL ) == S_OK &&
                 SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL ))) app_id = wcsdup( value );
             if (IXmlReader_MoveToAttributeByName( reader, L"Executable", NULL ) == S_OK &&
@@ -989,14 +990,32 @@
             app_depth = depth;
             continue;
         }
+        /* Stained Glass OS: the alias extension's own program, when it names one (ImageMagick: the
+         * application is a stub, magick.exe the extension's -- the alias ran the stub, no output) */
+        if (app_depth && !wcscmp( name, L"Extension" ))
+        {
+            BOOL alias_ext;
+
+            free( ext_exe );
+            ext_exe = NULL;
+            alias_ext = IXmlReader_MoveToAttributeByName( reader, L"Category", NULL ) == S_OK &&
+                        SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL )) &&
+                        !wcscmp( value, L"windows.appExecutionAlias" );
+#ifndef SG_MUTANT_AX_ALIAS_APP_EXE
+            if (alias_ext && IXmlReader_MoveToAttributeByName( reader, L"Executable", NULL ) == S_OK &&
+                SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL ))) ext_exe = wcsdup( value );
+#endif
+            IXmlReader_MoveToElement( reader );
+            continue;
+        }
         if (!app_depth || !app_id || !exe || wcscmp( name, L"ExecutionAlias" )) continue;
         /* the alias attribute has no namespace (uap5:ExecutionAlias Alias=, desktop:ExecutionAlias Alias=) */
         if (IXmlReader_MoveToAttributeByName( reader, L"Alias", NULL ) != S_OK ||
             FAILED(IXmlReader_GetValue( reader, &value, NULL )))
             continue;
-        if (!valid_alias( value ) || !payload_path( content_root( rec ), exe, target, ARRAY_SIZE(target) ))
+        if (!valid_alias( value ) || !payload_path( content_root( rec ), ext_exe ? ext_exe : exe, target, ARRAY_SIZE(target) ))
         {
-            WARN( "refusing alias %s for %s\n", debugstr_w( value ), debugstr_w( exe ) );
+            WARN( "refusing alias %s for %s\n", debugstr_w( value ), debugstr_w( ext_exe ? ext_exe : exe ) );
             continue;
         }
         swprintf( aumid, ARRAY_SIZE(aumid), L"%s!%s", rec->family_name, app_id );
@@ -1016,6 +1035,7 @@
 done:
     free( app_id );
     free( exe );
+    free( ext_exe );
     if (reader) IXmlReader_Release( reader );
     IStream_Release( stream );
 }
