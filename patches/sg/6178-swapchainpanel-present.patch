+        *out = &factory->IWineDXGISurfaceHandles_iface;
+        return S_OK;
+    }
 
     WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
 
@@ -750,9 +764,119 @@ struct dxgi_factory *unsafe_impl_from_IDXGIFactory(IDXGIFactory *iface)
     return factory;
 }
 
+/* IDXGIFactoryMedia: composition swap chains for a surface handle of DirectComposition's
+ * (DCompositionCreateSurfaceHandle). Whoever was given the handle in this process finds the
+ * swap chain through IWineDXGISurfaceHandles and shows it. */
+static inline struct dxgi_factory *impl_from_IDXGIFactoryMedia(IDXGIFactoryMedia *iface)
+{
+    return CONTAINING_RECORD(iface, struct dxgi_factory, IDXGIFactoryMedia_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_factory_media_QueryInterface(IDXGIFactoryMedia *iface, REFIID iid, void **out)
+{
+    struct dxgi_factory *factory = impl_from_IDXGIFactoryMedia(iface);
+    return dxgi_factory_QueryInterface(&factory->IWineDXGIFactory_iface, iid, out);
+}
+
+static ULONG STDMETHODCALLTYPE dxgi_factory_media_AddRef(IDXGIFactoryMedia *iface)
+{
+    struct dxgi_factory *factory = impl_from_IDXGIFactoryMedia(iface);
+    return dxgi_factory_AddRef(&factory->IWineDXGIFactory_iface);
+}
+
+static ULONG STDMETHODCALLTYPE dxgi_factory_media_Release(IDXGIFactoryMedia *iface)
+{
+    struct dxgi_factory *factory = impl_from_IDXGIFactoryMedia(iface);
+    return dxgi_factory_Release(&factory->IWineDXGIFactory_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_factory_media_CreateSwapChainForCompositionSurfaceHandle(IDXGIFactoryMedia *iface,
+        IUnknown *device, HANDLE surface, const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGIOutput *output,
+        IDXGISwapChain1 **swapchain)
+{
+    struct dxgi_factory *factory = impl_from_IDXGIFactoryMedia(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, device %p, surface %p, desc %p, output %p, swapchain %p.\n",
+            iface, device, surface, desc, output, swapchain);
+
+    if (!surface)
+        return E_INVALIDARG;
+    if (FAILED(hr = dxgi_factory_CreateSwapChainForComposition(&factory->IWineDXGIFactory_iface,
+            device, desc, output, swapchain)))
+        return hr;
+    if (FAILED(hr = dxgi_composition_handle_add(*swapchain, surface)))
+    {
+        IDXGISwapChain1_Release(*swapchain);
+        *swapchain = NULL;
+    }
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_factory_media_CreateDecodeSwapChainForCompositionSurfaceHandle(
+        IDXGIFactoryMedia *iface, IUnknown *device, HANDLE surface, DXGI_DECODE_SWAP_CHAIN_DESC *desc,
+        IDXGIResource *buffers, IDXGIOutput *output, IDXGIDecodeSwapChain **swapchain)
+{
+    FIXME("iface %p, device %p, surface %p, desc %p, buffers %p, output %p, swapchain %p stub!\n",
+            iface, device, surface, desc, buffers, output, swapchain);
+    return E_NOTIMPL;
+}
+
+static const struct IDXGIFactoryMediaVtbl dxgi_factory_media_vtbl =
+{
+    dxgi_factory_media_QueryInterface,
+    dxgi_factory_media_AddRef,
+    dxgi_factory_media_Release,
+    dxgi_factory_media_CreateSwapChainForCompositionSurfaceHandle,
+    dxgi_factory_media_CreateDecodeSwapChainForCompositionSurfaceHandle,
+};
+
+static inline struct dxgi_factory *impl_from_IWineDXGISurfaceHandles(IWineDXGISurfaceHandles *iface)
+{
+    return CONTAINING_RECORD(iface, struct dxgi_factory, IWineDXGISurfaceHandles_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_surface_handles_QueryInterface(IWineDXGISurfaceHandles *iface, REFIID iid, void **out)
+{
+    struct dxgi_factory *factory = impl_from_IWineDXGISurfaceHandles(iface);
+    return dxgi_factory_QueryInterface(&factory->IWineDXGIFactory_iface, iid, out);
+}
+
+static ULONG STDMETHODCALLTYPE dxgi_surface_handles_AddRef(IWineDXGISurfaceHandles *iface)
+{
+    struct dxgi_factory *factory = impl_from_IWineDXGISurfaceHandles(iface);
+    return dxgi_factory_AddRef(&factory->IWineDXGIFactory_iface);
+}
+
+static ULONG STDMETHODCALLTYPE dxgi_surface_handles_Release(IWineDXGISurfaceHandles *iface)
+{
+    struct dxgi_factory *factory = impl_from_IWineDXGISurfaceHandles(iface);
+    return dxgi_factory_Release(&factory->IWineDXGIFactory_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_surface_handles_swapchain_from_handle(IWineDXGISurfaceHandles *iface,
+        HANDLE handle, IWineDXGICompositionSwapChain **swapchain)
+{
+    TRACE("iface %p, handle %p, swapchain %p.\n", iface, handle, swapchain);
+
+    if (!swapchain)
+        return E_POINTER;
+    return dxgi_composition_handle_find(handle, swapchain);
+}
+
+static const struct IWineDXGISurfaceHandlesVtbl dxgi_surface_handles_vtbl =
+{
+    dxgi_surface_handles_QueryInterface,
+    dxgi_surface_handles_AddRef,
+    dxgi_surface_handles_Release,
+    dxgi_surface_handles_swapchain_from_handle,
+};
+
 static HRESULT dxgi_factory_init(struct dxgi_factory *factory, BOOL extended, UINT flags)
 {
     factory->IWineDXGIFactory_iface.lpVtbl = &dxgi_factory_vtbl;
+    factory->IDXGIFactoryMedia_iface.lpVtbl = &dxgi_factory_media_vtbl;
+    factory->IWineDXGISurfaceHandles_iface.lpVtbl = &dxgi_surface_handles_vtbl;
     factory->refcount = 1;
     list_init(&factory->notifications);
     factory->creation_flags = flags;
diff --git a/dlls/windows.ui.xaml/panel.c b/dlls/windows.ui.xaml/panel.c
index 106cd8f..08fef7a 100644
--- a/dlls/windows.ui.xaml/panel.c
+++ b/dlls/windows.ui.xaml/panel.c
@@ -30,6 +30,15 @@
 #include <math.h>
 #include <string.h>
 #include "private.h"
+#include "dxgi1_6.h"
+#include "initguid.h"   /* for winedxgi.h's interfaces only */
+/* winedxgi.h names these in methods not called here */
+struct wined3d_resource;
+struct wined3d_texture;
+struct wined3d_device_parent;
+#include "wine/winedxgi.h"
+
+DEFINE_GUID(IID_IDXGIFactory1_sg, 0x770aae78, 0xf26f, 0x4dba, 0xa8, 0x29, 0x25, 0x3c, 0x83, 0xd1, 0xb3, 0x87);
 
 WINE_DEFAULT_DEBUG_CHANNEL(xaml);
 
@@ -1139,8 +1148,7 @@ COMPOSABLE_CREATE(grid_factory_CreateInstance, struct grid, grid_init( obj, oute
 
 static const void *grid_factory_vtbl[] = { IGridFactory_FSTUBS, [IGridFactory_CreateInstance] = grid_factory_CreateInstance };
 
-/* ---- SwapChainPanel: a Grid that takes a swap chain (ISwapChainPanelNative/Native2), kept; what the
- * program presents to it is not drawn yet ---- */
+/* ---- SwapChainPanel: a Grid that shows a composition swap chain (ISwapChainPanelNative/Native2) ---- */
 
 static const GUID IID_ISwapChainPanelNative_x = { 0xf92f19d2, 0x3ade, 0x45a6, { 0xa2, 0x0c, 0xf6, 0xf1, 0xea, 0x90, 0x55, 0x4b } };
 static const GUID IID_ISwapChainPanelNative2_x = { 0xd5a2f60c, 0x37b2, 0x44a2, { 0x93, 0x7b, 0x8d, 0x8e, 0xb9, 0x72, 0x68, 0x21 } };
@@ -1151,8 +1159,93 @@ struct swap_panel
     struct xiface ISwapChainPanel_iface, ISwapChainPanelNative_iface, ISwapChainPanelNative2_iface;
     IUnknown *swapchain;
     HANDLE handle;
+    struct list entry;                       /* in swap_panels */
+    IWineDXGICompositionSwapChain *target;   /* what shows it: the swap chain's, set or found by handle */
+    HWND window;                             /* where it was last shown */
+    POINT at;
 };
 
+/* The swap chains of SwapChainPanels are composition swap chains of our dxgi: told the window and
+ * place of their panel, they draw each presented frame there.  The island draws over that place when
+ * it paints, so they are told again (and draw their last frame) after each paint of the island. */
+static struct list swap_panels = LIST_INIT( swap_panels );
+static CRITICAL_SECTION swap_cs;
+static CRITICAL_SECTION_DEBUG swap_cs_debug =
+{
+    0, 0, &swap_cs,
+    { &swap_cs_debug.ProcessLocksList, &swap_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": swap_cs") }
+};
+static CRITICAL_SECTION swap_cs = { &swap_cs_debug, -1, 0, 0, 0, 0 };
+
+/* the composition swap chain made for a surface handle (IDXGIFactoryMedia) in this process */
+static IWineDXGICompositionSwapChain *swapchain_from_handle( HANDLE handle )
+{
+    HRESULT (WINAPI *create)( REFIID, void ** );
+    IWineDXGICompositionSwapChain *target = NULL;
+    IWineDXGISurfaceHandles *handles;
+    IUnknown *factory = NULL;
+    HMODULE dxgi;
+
+    /* no one made a swap chain if dxgi is not loaded */
+    if (!handle || !(dxgi = GetModuleHandleW( L"dxgi.dll" ))) return NULL;
+    if (!(create = (void *)GetProcAddress( dxgi, "CreateDXGIFactory1" ))) return NULL;
+    if (FAILED(create( &IID_IDXGIFactory1_sg, (void **)&factory ))) return NULL;
+    if (SUCCEEDED(IUnknown_QueryInterface( factory, &IID_IWineDXGISurfaceHandles, (void **)&handles )))
+    {
+        IWineDXGISurfaceHandles_swapchain_from_handle( handles, handle, &target );
+        IWineDXGISurfaceHandles_Release( handles );
+    }
+    IUnknown_Release( factory );
+    return target;
+}
+
+static void swap_panel_untarget( struct swap_panel *panel )
+{
+    if (!panel->target) return;
+    if (panel->window) IWineDXGICompositionSwapChain_set_target( panel->target, NULL, 0, 0 );
+    IWineDXGICompositionSwapChain_Release( panel->target );
+    panel->target = NULL;
+    panel->window = NULL;
+}
+
+/* after a paint of the window: its panels' swap chains shown in their places */
+void xaml_swap_panels_present( HWND hwnd )
+{
+    struct swap_panel *panel;
+    struct uielem *e;
+    POINT at;
+
+    EnterCriticalSection( &swap_cs );
+    LIST_FOR_EACH_ENTRY( panel, &swap_panels, struct swap_panel, entry )
+    {
+        struct uielem *elem = &panel->g.p.e;
+        HWND window = xaml_element_window( elem );
+        BOOL shown = TRUE;
+
+        if (!panel->target && panel->handle) panel->target = swapchain_from_handle( panel->handle );
+        if (!panel->target) continue;
+        if (window != hwnd && panel->window != hwnd) continue;
+        at.x = at.y = 0;
+        for (e = elem; e; e = e->parent)
+        {
+            if (e->visibility == XCOLLAPSED) shown = FALSE;
+            at.x += e->offset.x;
+            at.y += e->offset.y;
+        }
+        if (!shown || window != hwnd) window = NULL;
+#ifdef SG_MUTANT_SWAP_PANEL_NOT_PRESENTED
+        window = NULL;
+#endif
+        TRACE( "%p: %p in %p at %ld,%ld\n", panel, panel->target, window, at.x, at.y );
+        if (!window && !panel->window) continue;
+        panel->window = window;
+        panel->at = at;
+        IWineDXGICompositionSwapChain_set_target( panel->target, window, at.x, at.y );
+    }
+    LeaveCriticalSection( &swap_cs );
+}
+
 static struct swap_panel *swap_panel_from_iface( struct xiface *iface )
 {
     return CONTAINING_RECORD( iface->obj, struct swap_panel, g.p.e.d.obj );
@@ -1195,8 +1288,14 @@ static HRESULT WINAPI swap_SetSwapChain( struct xiface *iface, IUnknown *swapcha
     return E_NOTIMPL;
 #endif
     if (swapchain) IUnknown_AddRef( swapchain );
+    EnterCriticalSection( &swap_cs );
+    swap_panel_untarget( panel );
     if (panel->swapchain) IUnknown_Release( panel->swapchain );
     panel->swapchain = swapchain;
+    panel->handle = NULL;
+    if (swapchain && FAILED(IUnknown_QueryInterface( swapchain, &IID_IWineDXGICompositionSwapChain, (void **)&panel->target )))
+        FIXME( "%p is not a composition swap chain of ours; not shown\n", swapchain );
+    LeaveCriticalSection( &swap_cs );
     xaml_invalidate_visuals();
     return S_OK;
 }
@@ -1206,7 +1305,13 @@ static HRESULT WINAPI swap_SetSwapChainHandle( struct xiface *iface, HANDLE hand
     struct swap_panel *panel = swap_panel_from_iface( iface );
 
     TRACE( "%p, %p\n", panel, handle );
-    panel->handle = handle;
+    EnterCriticalSection( &swap_cs );
+    swap_panel_untarget( panel );
+    if (panel->swapchain) IUnknown_Release( panel->swapchain );
+    panel->swapchain = NULL;
+    panel->handle = handle;   /* the caller's; its swap chain may come later */
+    panel->target = swapchain_from_handle( handle );
+    LeaveCriticalSection( &swap_cs );
     xaml_invalidate_visuals();
     return S_OK;
 }
@@ -1234,6 +1339,10 @@ static void swap_panel_destroy( struct xobj *obj )
 {
     struct swap_panel *panel = CONTAINING_RECORD( obj, struct swap_panel, g.p.e.d.obj );
 
+    EnterCriticalSection( &swap_cs );
+    list_remove( &panel->entry );
+    swap_panel_untarget( panel );
+    LeaveCriticalSection( &swap_cs );
     if (panel->swapchain) IUnknown_Release( panel->swapchain );
     grid_destroy( obj );
 }
@@ -1249,7 +1358,9 @@ static void swap_panel_init( struct swap_panel *panel, IInspectable *outer )
     panel->ISwapChainPanelNative_iface.vtbl = swap_native_vtbl;
     panel->ISwapChainPanelNative2_iface.vtbl = swap_native2_vtbl;
     grid_init_class( &panel->g, &swap_panel_class, outer );
-
+    EnterCriticalSection( &swap_cs );
+    list_add_tail( &swap_panels, &panel->entry );
+    LeaveCriticalSection( &swap_cs );
 }
 
 #define e_obj g.p.e.d.obj
diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
