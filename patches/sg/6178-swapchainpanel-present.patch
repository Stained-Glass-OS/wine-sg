From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dxgi, windows.ui.xaml: SwapChainPanel shows its composition swap chain

Windows Terminal draws its terminal with Direct3D 11 into a composition swap chain that it makes for a DirectComposition surface handle (IDXGIFactoryMedia::CreateSwapChainForCompositionSurfaceHandle) and hands that handle to a XAML SwapChainPanel (ISwapChainPanelNative2::SetSwapChainHandle); other programs hand the swap chain itself (SetSwapChain). dxgi had no IDXGIFactoryMedia, and the panel kept what it was given without showing it. The DXGI factory now implements IDXGIFactoryMedia (composition swap chains as made by CreateSwapChainForComposition, recorded with their surface handle) and a private interface through which the handle's consumer in the same process finds the newest swap chain made for it. A SwapChainPanel finds its swap chain (by handle, also when the swap chain comes after the handle) and tells it the island window and its place there; the swap chain draws each presented frame there, and the island tells it again after each of its paints, so the frame stays over what the island drew.
---
diff --git a/dlls/dxgi/Makefile.in b/dlls/dxgi/Makefile.in
index 3d2f24e..5061a42 100644
--- a/dlls/dxgi/Makefile.in
+++ b/dlls/dxgi/Makefile.in
@@ -1,6 +1,6 @@
 MODULE    = dxgi.dll
 IMPORTLIB = dxgi
-IMPORTS   = gdi32 dxguid uuid wined3d user32 win32u
+IMPORTS   = gdi32 dxguid uuid wined3d user32 win32u ntdll
 EXTRAINCL = $(VKD3D_PE_CFLAGS)
 
 SOURCES = \
diff --git a/dlls/dxgi/composition.c b/dlls/dxgi/composition.c
index 8e0f748..323729d 100644
--- a/dlls/dxgi/composition.c
+++ b/dlls/dxgi/composition.c
@@ -43,6 +43,7 @@
 #define COBJMACROS
 #include "d3d11.h"
 #include "dxgi_private.h"
+#include "winternl.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(dxgi);
 
@@ -67,7 +68,21 @@ struct composition_swapchain
     int x, y;
     LONG present_count;
     struct dxgi_swapchain_state state;
+
+    struct list handle_entry;   /* in surface_swapchains, if made for a surface handle */
+    HANDLE surface;             /* that handle (our duplicate) */
+};
+
+/* The swap chains made for composition surface handles (IDXGIFactoryMedia), newest first. */
+static struct list surface_swapchains = LIST_INIT(surface_swapchains);
+static CRITICAL_SECTION surface_cs;
+static CRITICAL_SECTION_DEBUG surface_cs_debug =
+{
+    0, 0, &surface_cs,
+    { &surface_cs_debug.ProcessLocksList, &surface_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": surface_cs") }
 };
+static CRITICAL_SECTION surface_cs = { &surface_cs_debug, -1, 0, 0, 0, 0 };
 
 static inline struct composition_swapchain *impl_from_IDXGISwapChain4(IDXGISwapChain4 *iface)
 {
@@ -363,6 +378,13 @@ static ULONG STDMETHODCALLTYPE composition_swapchain_Release(IDXGISwapChain4 *if
 
     if (!refcount)
     {
+        if (swapchain->surface)
+        {
+            EnterCriticalSection(&surface_cs);
+            list_remove(&swapchain->handle_entry);
+            LeaveCriticalSection(&surface_cs);
+            CloseHandle(swapchain->surface);
+        }
         if (swapchain->refresh_timer)
         {
             SetThreadpoolTimer(swapchain->refresh_timer, NULL, 0, 0);
@@ -1036,3 +1058,51 @@ HRESULT dxgi_composition_swapchain_create(IWineDXGIFactory *factory, IUnknown *d
     *ret = (IDXGISwapChain1 *)&swapchain->IDXGISwapChain4_iface;
     return S_OK;
 }
+
+/* Records that the swap chain was made for a composition surface handle. */
+HRESULT dxgi_composition_handle_add(IDXGISwapChain1 *iface, HANDLE handle)
+{
+    struct composition_swapchain *swapchain = impl_from_IDXGISwapChain4((IDXGISwapChain4 *)iface);
+
+    if (!DuplicateHandle(GetCurrentProcess(), handle, GetCurrentProcess(), &swapchain->surface, 0, FALSE,
+            DUPLICATE_SAME_ACCESS))
+    {
+        WARN("Invalid surface handle %p, error %lu.\n", handle, GetLastError());
+        swapchain->surface = NULL;
+        return E_INVALIDARG;
+    }
+    EnterCriticalSection(&surface_cs);
+    list_add_head(&surface_swapchains, &swapchain->handle_entry);
+    LeaveCriticalSection(&surface_cs);
+    return S_OK;
+}
+
+/* The newest swap chain made for that handle (or another handle to the same
+ * surface), with a reference; none once it is released. */
+HRESULT dxgi_composition_handle_find(HANDLE handle, IWineDXGICompositionSwapChain **out)
+{
+    struct composition_swapchain *swapchain;
+    LONG refcount;
+
+    *out = NULL;
+#ifdef SG_MUTANT_DXGI_SURFACE_HANDLE_UNKNOWN
+    return DXGI_ERROR_NOT_FOUND;
+#endif
+    EnterCriticalSection(&surface_cs);
+    LIST_FOR_EACH_ENTRY(swapchain, &surface_swapchains, struct composition_swapchain, handle_entry)
+    {
+        if (swapchain->surface != handle && NtCompareObjects(swapchain->surface, handle))
+            continue;
+        /* it may be on its way out: a reference only while it has others */
+        while ((refcount = swapchain->refcount) > 0)
+            if (InterlockedCompareExchange(&swapchain->refcount, refcount + 1, refcount) == refcount)
+            {
+                *out = &swapchain->IWineDXGICompositionSwapChain_iface;
+                break;
+            }
+        if (*out)
+            break;
+    }
+    LeaveCriticalSection(&surface_cs);
+    return *out ? S_OK : DXGI_ERROR_NOT_FOUND;
+}
diff --git a/dlls/dxgi/dxgi_private.h b/dlls/dxgi/dxgi_private.h
index 7b216e6..8218041 100644
--- a/dlls/dxgi/dxgi_private.h
+++ b/dlls/dxgi/dxgi_private.h
@@ -173,6 +173,8 @@ void dxgi_notify_cleanup(struct list *list);
 struct dxgi_factory
 {
     IWineDXGIFactory IWineDXGIFactory_iface;
+    IDXGIFactoryMedia IDXGIFactoryMedia_iface;
+    IWineDXGISurfaceHandles IWineDXGISurfaceHandles_iface;
     LONG refcount;
     struct wined3d_private_store private_store;
     struct wined3d *wined3d;
@@ -258,6 +260,8 @@ struct d3d11_swapchain
 HRESULT d3d11_swapchain_init(struct d3d11_swapchain *swapchain, struct dxgi_device *device,
         struct wined3d_swapchain_desc *desc);
 
+HRESULT dxgi_composition_handle_add(IDXGISwapChain1 *swapchain, HANDLE handle);
+HRESULT dxgi_composition_handle_find(HANDLE handle, IWineDXGICompositionSwapChain **swapchain);
 HRESULT dxgi_composition_swapchain_create(IWineDXGIFactory *factory, IUnknown *device,
         const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGISwapChain1 **swapchain);
 HRESULT d3d12_swapchain_create(IWineDXGIFactory *factory, ID3D12CommandQueue *queue, HWND window,
diff --git a/dlls/dxgi/factory.c b/dlls/dxgi/factory.c
index 80245f1..d939de5 100644
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -51,6 +51,20 @@ static HRESULT STDMETHODCALLTYPE dxgi_factory_QueryInterface(IWineDXGIFactory *i
         *out = iface;
         return S_OK;
     }
+#ifndef SG_MUTANT_DXGI_NO_FACTORY_MEDIA
+    if (IsEqualGUID(iid, &IID_IDXGIFactoryMedia))
+    {
+        IUnknown_AddRef(iface);
+        *out = &factory->IDXGIFactoryMedia_iface;
