diff --git a/include/wine/winedxgi.idl b/include/wine/winedxgi.idl
index 197d0aa..dbc162e 100644
--- a/include/wine/winedxgi.idl
+++ b/include/wine/winedxgi.idl
@@ -99,6 +99,19 @@ interface IWineDXGICompositionSwapChain : IUnknown
     HRESULT set_target([in] HWND window, [in] int x, [in] int y);
 }
 
+/* Implemented by the DXGI factory: the composition swap chain last made for a
+ * composition surface handle (IDXGIFactoryMedia), so that the handle's consumer
+ * in this process (a XAML SwapChainPanel) can show it. */
+[
+    object,
+    local,
+    uuid(b5d3ad91-81e3-409d-84da-01807c20ad13)
+]
+interface IWineDXGISurfaceHandles : IUnknown
+{
+    HRESULT swapchain_from_handle([in] HANDLE handle, [out] IWineDXGICompositionSwapChain **swapchain);
+}
+
 /* Implemented by the Direct3D object a DXGI resource belongs to when the resource can be
  * shared: tells IDXGIResource::GetSharedHandle which handle that is. */
 [
