From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: a menu item's 32 bpp bitmap with an alpha channel is drawn blended (8702)

draw_bitmap_item copied an item's bitmap (MIIM_BITMAP's hbmpItem) with
BitBlt. SWT gives menus premultiplied 32 bpp DIB sections -- TuxGuitar,
Eclipse, DBeaver -- and Windows blends them over the item's background, so
there every transparent pixel was drawn black: a black box round each icon,
highlighted or not. A 32 bpp DIB section that has an alpha value somewhere
is now drawn with AlphaBlend (AC_SRC_ALPHA); one whose alpha is all zero
has no channel and is copied as before (and inverted when highlighted, as
before). Mutant SG_MUTANT_MENU_BITMAP_NO_ALPHA.
---
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -2251,6 +2251,28 @@
     NtGdiDeleteObjectApp( mem_hdc );
 }
 
+/* Whether a menu item's bitmap carries an alpha channel (8702): a 32 bpp DIB section
+ * with an alpha value somewhere. Windows draws such a bitmap blended -- SWT (TuxGuitar,
+ * Eclipse, DBeaver) and others give menus premultiplied 32 bpp images, and copied as they
+ * are, every transparent pixel was black. A 32 bpp bitmap whose alpha is all zero has no
+ * channel and is copied as before. */
+static BOOL menu_bitmap_has_alpha( const BITMAP *bm )
+{
+    const BYTE *row;
+    int x, y;
+
+#ifdef SG_MUTANT_MENU_BITMAP_NO_ALPHA
+    return FALSE;
+#endif
+    if (bm->bmBitsPixel != 32 || !bm->bmBits) return FALSE;
+    for (y = 0; y < bm->bmHeight; y++)
+    {
+        row = (const BYTE *)bm->bmBits + (SIZE_T)y * bm->bmWidthBytes;
+        for (x = 0; x < bm->bmWidth; x++) if (row[x * 4 + 3]) return TRUE;
+    }
+    return FALSE;
+}
+
 static void draw_bitmap_item( HWND hwnd, HDC hdc, struct menu_item *item, const RECT *rect,
                               struct menu *menu, HWND owner, UINT odaction )
 {
@@ -2384,7 +2406,15 @@
     rop= ((item->fState & MF_HILITE) && !IS_MAGIC_BITMAP(bmp_to_draw)) ? NOTSRCCOPY : SRCCOPY;
     if ((item->fState & MF_HILITE) && item->hbmpItem)
         NtGdiGetAndSetDCDword( hdc, NtGdiSetBkColor, get_sys_color( COLOR_HIGHLIGHT ), NULL );
-    NtGdiBitBlt( hdc, left, top, w, h, mem_hdc, bmp_xoffset, 0, rop, 0, 0 );
+    if (!IS_MAGIC_BITMAP( bmp_to_draw ) && menu_bitmap_has_alpha( &bm ))
+    {
+        /* blended over the item's background, highlighted or not */
+        int bw = min( w, bm.bmWidth - bmp_xoffset ), bh = min( h, bm.bmHeight );
+        if (bw > 0 && bh > 0)
+            NtGdiAlphaBlend( hdc, left, top, bw, bh, mem_hdc, bmp_xoffset, 0, bw, bh,
+                             MAKEFOURCC( AC_SRC_OVER, 0, 255, AC_SRC_ALPHA ), 0 );
+    }
+    else NtGdiBitBlt( hdc, left, top, w, h, mem_hdc, bmp_xoffset, 0, rop, 0, 0 );
     NtGdiDeleteObjectApp( mem_hdc );
 }
 
