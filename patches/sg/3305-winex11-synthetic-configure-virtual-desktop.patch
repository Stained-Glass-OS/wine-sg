From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 03:19:59 -0700
Subject: [PATCH] winex11: synthetic ConfigureNotify and GravityNotify in a
 virtual desktop (3305)

CORE review: windowing.

A synthetic ConfigureNotify or GravityNotify (sent by the window manager,
ICCCM 4.1.5) carries the window position in the coordinates of the real
root window. In a virtual desktop the driver used it unchanged and logged
"synthetic event mapping not implemented", so a window the manager moved
got the position of the desktop window added to it. The position is now
taken relative to the virtual desktop's window (its place on the root
from XTranslateCoordinates) before it is turned into a virtual screen
position, as for a real event that goes through the parent windows.

Test: test/fastxcfg-gate.sh (mutant SG_MUTANT_CFGNOTIFY_NOMAP).

diff --git a/dlls/winex11.drv/event.c b/dlls/winex11.drv/event.c
index 1f88776..0971c83 100644
--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -1122,6 +1122,26 @@ static BOOL X11DRV_ReparentNotify( HWND hwnd, XEvent *xev )
     return TRUE;
 }
 
+/* A synthetic ConfigureNotify (ICCCM 4.1.5, sent by the window manager) has the position
+ * in the coordinates of the real root window. Inside a virtual desktop, whose window is
+ * somewhere on that root, the position in the desktop is relative to the desktop window. */
+static POINT synthetic_event_to_desktop( Display *display, POINT pos )
+{
+    int x, y;
+    Window child;
+
+    if (!is_virtual_desktop() || root_window == DefaultRootWindow( display )) return pos;
+#ifdef SG_MUTANT_CFGNOTIFY_NOMAP
+    return pos;
+#endif
+    if (XTranslateCoordinates( display, root_window, DefaultRootWindow( display ), 0, 0, &x, &y, &child ))
+    {
+        pos.x -= x;
+        pos.y -= y;
+    }
+    return pos;
+}
+
 /***********************************************************************
  *		X11DRV_ConfigureNotify
  */
@@ -1145,7 +1165,7 @@ static BOOL X11DRV_ConfigureNotify( HWND hwnd, XEvent *xev )
 
     /* synthetic events are already in absolute coordinates */
     if (!event->send_event) pos = host_window_map_point( data->parent, event->x, event->y );
-    else if (is_virtual_desktop()) FIXME( "synthetic event mapping not implemented\n" );
+    else pos = synthetic_event_to_desktop( event->display, pos );
 
     pos = root_to_virtual_screen( pos.x, pos.y );
     if (size.cx == 1 && size.cy == 1 && IsRectEmpty( &data->rects.window )) size.cx = size.cy = 0;
@@ -1185,7 +1205,7 @@ static BOOL X11DRV_GravityNotify( HWND hwnd, XEvent *xev )
     {
         /* synthetic events are already in absolute coordinates */
         if (!event->send_event) pos = host_window_map_point( data->parent, event->x, event->y );
-        else if (is_virtual_desktop()) FIXME( "synthetic event mapping not implemented\n" );
+        else pos = synthetic_event_to_desktop( event->display, pos );
 
         pos = root_to_virtual_screen( pos.x, pos.y );
         OffsetRect( &rect, pos.x - rect.left, pos.y - rect.top );
