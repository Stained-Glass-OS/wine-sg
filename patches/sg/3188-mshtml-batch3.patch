+static HRESULT WINAPI EnumViews_Clone(IEnumOleDocumentViews *iface, IEnumOleDocumentViews **ppEnum)
+{
+    EnumViews *This = impl_from_IEnumOleDocumentViews(iface);
+
+    if(!ppEnum)
