+/* The coordinate systems are translations of the document's: the content's (the document's own),
+ * the frame's (the view, so the scroll position away), the screen's (the view's window away) and
+ * those of the parent and the container of an element (its top left corner away). */
+static HRESULT display_offset(HTMLDocumentNode *This, COORD_SYSTEM system, IHTMLElement *elem, POINT *off)
+{
+    LONG x = 0, y = 0;
+
+    off->x = off->y = 0;
+    switch(system) {
+    case COORD_SYSTEM_CONTENT:
+        return S_OK;
+    case COORD_SYSTEM_GLOBAL:
+    case COORD_SYSTEM_FRAME:
+        if(This->window && This->window->base.outer_window && This->window->base.outer_window->nswindow) {
+            LONG sx = 0, sy = 0;
+            nsIDOMWindow_GetScrollX(This->window->base.outer_window->nswindow, &sx);
+            nsIDOMWindow_GetScrollY(This->window->base.outer_window->nswindow, &sy);
+            x = -sx;
+            y = -sy;
+        }
+        if(system == COORD_SYSTEM_GLOBAL && This->doc_obj && This->doc_obj->hwnd) {
+            POINT origin = {0, 0};
+            ClientToScreen(This->doc_obj->hwnd, &origin);
+            x += origin.x;
+            y += origin.y;
+        }
+        off->x = x;
+        off->y = y;
+        return S_OK;
+    case COORD_SYSTEM_PARENT:
+    case COORD_SYSTEM_CONTAINER: {
+        IHTMLElement2 *elem2;
+        IHTMLRect *rect;
+        POINT scroll;
+        HRESULT hres;
+
+        if(!elem)
+            return E_INVALIDARG;
+        hres = IHTMLElement_QueryInterface(elem, &IID_IHTMLElement2, (void**)&elem2);
+        if(FAILED(hres))
+            return hres;
+        hres = IHTMLElement2_getBoundingClientRect(elem2, &rect);
+        IHTMLElement2_Release(elem2);
+        if(FAILED(hres))
+            return hres;
+        IHTMLRect_get_left(rect, &x);
+        IHTMLRect_get_top(rect, &y);
+        IHTMLRect_Release(rect);
+        display_offset(This, COORD_SYSTEM_FRAME, NULL, &scroll);
+        off->x = x - scroll.x;     /* the element's corner in the content, its offset when taken from it */
+        off->y = y - scroll.y;
+        return S_OK;
+    }
+    default:
+        return E_INVALIDARG;
+    }
+}
+
+static HRESULT display_transform(HTMLDocumentNode *This, POINT *pt, COORD_SYSTEM src, COORD_SYSTEM dst, IHTMLElement *elem)
+{
