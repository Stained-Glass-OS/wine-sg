+
+static inline EnumViews *impl_from_IEnumOleDocumentViews(IEnumOleDocumentViews *iface)
+{
+    return CONTAINING_RECORD(iface, EnumViews, IEnumOleDocumentViews_iface);
+}
+
+static HRESULT WINAPI EnumViews_QueryInterface(IEnumOleDocumentViews *iface, REFIID riid, void **ppv)
+{
+    if(IsEqualGUID(&IID_IUnknown, riid) || IsEqualGUID(&IID_IEnumOleDocumentViews, riid)) {
+        *ppv = iface;
+        IEnumOleDocumentViews_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EnumViews_AddRef(IEnumOleDocumentViews *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumOleDocumentViews(iface)->ref);
+}
+
+static ULONG WINAPI EnumViews_Release(IEnumOleDocumentViews *iface)
+{
+    EnumViews *This = impl_from_IEnumOleDocumentViews(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        IOleDocumentView_Release(This->view);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI EnumViews_Next(IEnumOleDocumentViews *iface, ULONG cViews, IOleDocumentView **rgpView, ULONG *pcFetched)
+{
+    EnumViews *This = impl_from_IEnumOleDocumentViews(iface);
+    ULONG fetched = 0;
+
+    if(!rgpView || (!pcFetched && cViews != 1))
+        return E_POINTER;
+    if(cViews && !This->pos) {      /* the one view the document has */
+        IOleDocumentView_AddRef(This->view);
+        rgpView[fetched++] = This->view;
+        This->pos = 1;
+    }
+    if(pcFetched)
+        *pcFetched = fetched;
+    return fetched == cViews ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumViews_Skip(IEnumOleDocumentViews *iface, ULONG cViews)
+{
+    EnumViews *This = impl_from_IEnumOleDocumentViews(iface);
+    ULONG left = 1 - This->pos;
+
+    This->pos = 1 < This->pos + cViews ? 1 : This->pos + cViews;
+    return cViews <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumViews_Reset(IEnumOleDocumentViews *iface)
+{
+    impl_from_IEnumOleDocumentViews(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_enum_views(IOleDocumentView *view, ULONG pos, IEnumOleDocumentViews **ret);
