+/* a location to jump to is a bookmark: the fragment of the document's address */
+static void hlink_jump(HTMLOuterWindow *outer, const WCHAR *location)
+{
+    IHTMLLocation *loc;
+    WCHAR *frag;
+    BSTR hash;
+
+    if(!location || !*location)
+        return;
+    if(!(frag = malloc((wcslen(location) + 2) * sizeof(WCHAR))))
+        return;
+    swprintf(frag, wcslen(location) + 2, L"#%s", location + (*location == '#'));
+    if(SUCCEEDED(IHTMLWindow2_get_location(&outer->base.IHTMLWindow2_iface, &loc))) {
+        if((hash = SysAllocString(frag))) {
+            IHTMLLocation_put_hash(loc, hash);
+            SysFreeString(hash);
+        }
+        IHTMLLocation_Release(loc);
+    }
+    free(frag);
+}
