+    if(!pt)
+        return E_INVALIDARG;
+    if((hres = display_offset(This, src, elem, &from)) != S_OK || (hres = display_offset(This, dst, elem, &to)) != S_OK)
+        return hres;
+    /* in a system, a point is the content's less the system's offset */
+    pt->x = pt->x + from.x - to.x;
+    pt->y = pt->y + from.y - to.y;
+    return S_OK;
+}
