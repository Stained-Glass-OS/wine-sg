From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] tbs, rsaenh: documented error returns; quiet logs for stubs that are right

tbs: Tbsi_Context_Create answers TBS_E_INVALID_OUTPUT_POINTER for a NULL
output and TBS_E_INVALID_CONTEXT_PARAM for NULL or a version other than
TPM_VERSION_12/20 (the documented codes), then TBS_E_TPM_NOT_FOUND as before
(no TPM is reachable). Tbsi_GetDeviceInfo answers TBS_E_BAD_PARAMETER for a
NULL buffer or one smaller than TPM_DEVICE_INFO (four UINT32s).

rsaenh: CPSetProvParam sets NTE_BAD_TYPE for a parameter it does not know,
which is what the documentation says the error means.

schannel SslEmptyCache, powrprof IsAdminOverrideActive,
windows.networking SetSocketMediaStreamingMode and winusb WinUsb_Free logged
a FIXME for a result that is already right (nothing is cached, there is no
administrator override, a hint with no effect here, the documented TRUE).
---
--- a/dlls/powrprof/powrprof.c
+++ b/dlls/powrprof/powrprof.c
@@ -152,7 +152,8 @@ BOOLEAN WINAPI GetPwrDiskSpindownRange(PUINT RangeMax, PUINT RangeMin)
 
 BOOLEAN WINAPI IsAdminOverrideActive(PADMINISTRATOR_POWER_POLICY p)
 {
-   FIXME("( %p) stub!\n", p);
+   /* no administrator override exists on this system */
+   TRACE("( %p)\n", p);
    return FALSE;
 }
 
--- a/dlls/rsaenh/rsaenh.c
+++ b/dlls/rsaenh/rsaenh.c
@@ -4870,8 +4870,14 @@ BOOL WINAPI RSAENH_CPSetProvParam(HCRYPTPROV hProv, DWORD dwParam, BYTE *pbData,
         return TRUE;
     }
     default:
+        /* documented: NTE_BAD_TYPE, "The dwParam parameter specifies an unknown parameter" */
+#ifdef SG_MUTANT_PROVPARAM_NOERR
         FIXME("unimplemented parameter %08lx\n", dwParam);
         return FALSE;
+#endif
+        WARN("unimplemented parameter %08lx\n", dwParam);
+        SetLastError(NTE_BAD_TYPE);
+        return FALSE;
     }
 }
 
--- a/dlls/rsaenh/tests/rsaenh.c
+++ b/dlls/rsaenh/tests/rsaenh.c
@@ -4416,6 +4416,18 @@ static void test_RC4_session_key(void)
     CryptReleaseContext(hprov, 0);
 }
 
+static void test_set_prov_param(void)
+{
+    BYTE data[4] = {0};
+    BOOL ret;
+
+    SetLastError(0xdeadbeef);
+    ret = CryptSetProvParam(hProv, 0xdeadbeef, data, 0);
+    ok(!ret, "CryptSetProvParam succeeded for an unknown parameter\n");
+    ok(GetLastError() == NTE_BAD_TYPE || broken(GetLastError() == ERROR_INVALID_PARAMETER),
+       "got error %08lx\n", GetLastError());
+}
+
 START_TEST(rsaenh)
 {
     test_RC4_salt();
@@ -4427,6 +4439,7 @@ START_TEST(rsaenh)
             continue;
         trace("Testing '%s'\n", szProviders[iProv]);
         test_prov();
+        test_set_prov_param();
         test_gen_random();
         test_hashes();
         test_rc4();
--- a/dlls/schannel/schannel_main.c
+++ b/dlls/schannel/schannel_main.c
@@ -29,12 +29,13 @@ WINE_DEFAULT_DEBUG_CHANNEL(schannel);
 
 BOOL WINAPI SslEmptyCacheA(LPSTR target, DWORD flags)
 {
-    FIXME("%s %lx\n", debugstr_a(target), flags);
+    /* there is no session cache here to empty, so success is the truth */
+    TRACE("%s %lx\n", debugstr_a(target), flags);
     return TRUE;
 }
 
 BOOL WINAPI SslEmptyCacheW(LPWSTR target, DWORD flags)
 {
-    FIXME("%s %lx\n", debugstr_w(target), flags);
+    TRACE("%s %lx\n", debugstr_w(target), flags);
     return TRUE;
 }
--- a/dlls/tbs/tbs.c
+++ b/dlls/tbs/tbs.c
@@ -18,7 +18,10 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
+#include <stdarg.h>
 #include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
 #include "tbs.h"
 #include "wine/debug.h"
 
@@ -26,13 +29,26 @@ WINE_DEFAULT_DEBUG_CHANNEL(tbs);
 
 TBS_RESULT WINAPI Tbsi_Context_Create(const TBS_CONTEXT_PARAMS *params, TBS_HCONTEXT *out)
 {
-    FIXME("(%p, %p) stub\n", params, out);
+    TRACE("(%p, %p)\n", params, out);
+
+#ifndef SG_MUTANT_TBS_NOCHECK
+    /* documented: TBS_E_INVALID_OUTPUT_POINTER, TBS_E_INVALID_CONTEXT_PARAM
+     * (the version is TPM_VERSION_12 = 1 or TPM_VERSION_20 = 2) */
+    if (!out) return TBS_E_INVALID_OUTPUT_POINTER;
+    if (!params || params->version < 1 || params->version > 2) return TBS_E_INVALID_CONTEXT_PARAM;
+#endif
+    /* no TPM is reachable from here */
     return TBS_E_TPM_NOT_FOUND;
 }
 
 TBS_RESULT WINAPI Tbsi_GetDeviceInfo(UINT32 size, void *info)
 {
-    FIXME("(%u, %p) stub\n", size, info);
+    TRACE("(%u, %p)\n", size, info);
+
+#ifndef SG_MUTANT_TBS_NOCHECK
+    /* TPM_DEVICE_INFO is four UINT32s */
+    if (!info || size < 4 * sizeof(UINT32)) return TBS_E_BAD_PARAMETER;
+#endif
     return TBS_E_TPM_NOT_FOUND;
 }
 
--- a/dlls/windows.networking/main.c
+++ b/dlls/windows.networking/main.c
@@ -25,7 +25,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(winsock);
 
 HRESULT WINAPI SetSocketMediaStreamingMode(BOOL value)
 {
-    FIXME("value %d stub!\n", value);
+    TRACE("value %d\n", value);
     return S_OK;
 }
 
--- a/dlls/winusb/main.c
+++ b/dlls/winusb/main.c
@@ -31,6 +31,6 @@ WINE_DEFAULT_DEBUG_CHANNEL(winusb);
  */
 BOOL WINAPI WinUsb_Free(WINUSB_INTERFACE_HANDLE handle)
 {
-    FIXME( "(%p) - stub\n", handle );
+    TRACE( "(%p)\n", handle );
     return TRUE;
 }
