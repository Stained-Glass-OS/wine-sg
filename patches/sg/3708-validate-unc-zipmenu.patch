From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHValidateUNC connects a drive only with VALIDATEUNC_CONNECT (3708)

shell32: SHValidateUNC connects a drive only with VALIDATEUNC_CONNECT

SHValidateUNC asked for a local drive when the connect flag was not given
and not when it was, so the connect flag changed nothing. It now asks for a
drive letter only with VALIDATEUNC_CONNECT, and the path it returns is the
path on that drive (what followed the share stays). Tested against a test
network provider registered in a scratch prefix, and the zip folder item
menu's GetCommandString has a gate now.
---
diff --git a/dlls/shell32/shellord.c b/dlls/shell32/shellord.c
index 361e3e3..28daf16 100644
--- a/dlls/shell32/shellord.c
+++ b/dlls/shell32/shellord.c
@@ -1753,13 +1753,28 @@ BOOL WINAPI SHValidateUNC (HWND hwndOwner, PWSTR pszFile, UINT fConnect)
     nr.lpRemoteName = share;
     if (!(fConnect & 2)) flags |= CONNECT_INTERACTIVE;
     if (fConnect & 8) flags |= CONNECT_UPDATE_PROFILE;
-    /* without the connect flag no drive letter is wanted: the share only has to answer */
-    if (!(fConnect & 1) || (fConnect & 4)) flags |= CONNECT_REDIRECT;
+    /* a drive letter is wanted only with the connect flag (a print share has none): otherwise the
+     * share only has to answer */
+#ifdef SG_MUTANT_VALIDATE_REDIRECT
+    if (!(fConnect & 1)) flags |= CONNECT_REDIRECT;
+#else
+    if ((fConnect & 1) && !(fConnect & 4)) flags |= CONNECT_REDIRECT;
+#endif
     ret = use((fConnect & 2) ? NULL : hwndOwner, &nr, NULL, NULL, flags, local, &size, &result);
     FreeLibrary(mpr);
     if (ret != NO_ERROR && ret != ERROR_ALREADY_ASSIGNED) return FALSE;
-    /* the path is now the drive it is mapped to */
-    if ((fConnect & 1) && local[0] && lstrlenW(local) <= lstrlenW(pszFile)) lstrcpyW(pszFile, local);
+    /* the path is now the path on the drive it is mapped to (what followed the share stays) */
+    if ((fConnect & 1) && local[0] && lstrlenW(local) <= lstrlenW(share))
+    {
+        WCHAR rest[MAX_PATH];
+
+        lstrcpynW(rest, pszFile + lstrlenW(share), ARRAY_SIZE(rest));
+#ifdef SG_MUTANT_VALIDATE_REST
+        rest[0] = 0;
+#endif
+        lstrcpyW(pszFile, local);
+        lstrcatW(pszFile, rest);
+    }
     return TRUE;
 }
 
diff --git a/dlls/shell32/zipfolder.c b/dlls/shell32/zipfolder.c
index ef8ea57..fcca11a 100644
--- a/dlls/shell32/zipfolder.c
+++ b/dlls/shell32/zipfolder.c
@@ -1805,6 +1805,9 @@ static HRESULT WINAPI zipmenu_GetCommandString( IContextMenu *iface, UINT_PTR cm
     {
     case GCS_VALIDATEA:
     case GCS_VALIDATEW:
+#ifdef SG_MUTANT_ZIPMENU_VALIDATE
+        return S_OK;
+#endif
         if (!HIWORD( cmd )) return cmd < ARRAY_SIZE(zipmenu_verbs) ? S_OK : S_FALSE;
         for (i = 0; i < ARRAY_SIZE(zipmenu_verbs); i++)
         {
@@ -1817,15 +1820,26 @@ static HRESULT WINAPI zipmenu_GetCommandString( IContextMenu *iface, UINT_PTR cm
         return S_FALSE;
     case GCS_VERBA:
     case GCS_VERBW:
+#ifdef SG_MUTANT_ZIPMENU_VERB
+        text = cmd < ARRAY_SIZE(zipmenu_verbs) ? zipmenu_verbs[(cmd + 1) % ARRAY_SIZE(zipmenu_verbs)] : NULL;
+#else
         text = cmd < ARRAY_SIZE(zipmenu_verbs) ? zipmenu_verbs[cmd] : NULL;
+#endif
         break;
     case GCS_HELPTEXTA:
     case GCS_HELPTEXTW:
+#ifdef SG_MUTANT_ZIPMENU_HELP
+        text = cmd < ARRAY_SIZE(helps) ? helps[0] : NULL;
+#else
         text = cmd < ARRAY_SIZE(helps) ? helps[cmd] : NULL;
+#endif
         break;
     default:
         return E_INVALIDARG;
     }
+#ifdef SG_MUTANT_ZIPMENU_RANGE
+    if (!text) text = L"x";
+#endif
     if (!text || !name) return E_INVALIDARG;
     if (type == GCS_VERBW || type == GCS_HELPTEXTW) lstrcpynW( (WCHAR *)name, text, len );
     else WideCharToMultiByte( CP_ACP, 0, text, -1, name, len, NULL, NULL );
