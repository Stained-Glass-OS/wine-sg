+static LRESULT CALLBACK notify_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    if (msg == WM_RIBBON_FLUSH)
+    {
+        UIRibbonFrameworkImpl *This = (UIRibbonFrameworkImpl *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+        if (This) IUIFramework_FlushPendingInvalidations(&This->IUIFramework_iface);
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+static HWND create_notify_window(void *This)
+{
+    static const WCHAR classW[] = L"WineUIRibbonNotify";
+    WNDCLASSW wc = { 0 };
+    HWND hwnd;
+
+    wc.lpfnWndProc = notify_proc;
+    wc.hInstance = GetModuleHandleW(NULL);
+    wc.lpszClassName = classW;
+    RegisterClassW(&wc);
+    hwnd = CreateWindowExW(0, classW, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, wc.hInstance, NULL);
+    if (hwnd) SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)This);
+    return hwnd;
+}
