+static HRESULT WINAPI ribbon_QueryInterface(IUIRibbon *iface, REFIID riid, void **ppv)
+{
+    UIRibbonFrameworkImpl *This = impl_from_IUIRibbon(iface);
+
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IUIRibbon))
+    {
+        IUIRibbon_AddRef(iface);
+        *ppv = &This->IUIRibbon_iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ribbon_AddRef(IUIRibbon *iface)
+{
+    UIRibbonFrameworkImpl *This = impl_from_IUIRibbon(iface);
+    return IUIFramework_AddRef(&This->IUIFramework_iface);
+}
+
+static ULONG WINAPI ribbon_Release(IUIRibbon *iface)
+{
+    UIRibbonFrameworkImpl *This = impl_from_IUIRibbon(iface);
+    return IUIFramework_Release(&This->IUIFramework_iface);
+}
+
+static HRESULT WINAPI ribbon_GetHeight(IUIRibbon *iface, UINT32 *cy)
+{
+    TRACE("(%p)\n", cy);
+    if (!cy) return E_POINTER;
+    *cy = 0;
+    return S_OK;
+}
+
+#define RIBBON_SETTINGS_MAGIC 0x53425247 /* "GRBS" */
+
+static HRESULT WINAPI ribbon_LoadSettingsFromStream(IUIRibbon *iface, IStream *stream)
+{
+    DWORD magic = 0, read = 0;
+    HRESULT hr;
+
+    TRACE("(%p)\n", stream);
+    if (!stream) return E_POINTER;
+    hr = IStream_Read(stream, &magic, sizeof(magic), &read);
+    if (FAILED(hr)) return hr;
+    return read == sizeof(magic) && magic == RIBBON_SETTINGS_MAGIC ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI ribbon_SaveSettingsToStream(IUIRibbon *iface, IStream *stream)
+{
+    DWORD magic = RIBBON_SETTINGS_MAGIC;
+
+    TRACE("(%p)\n", stream);
+    if (!stream) return E_POINTER;
+    return IStream_Write(stream, &magic, sizeof(magic), NULL);
+}
+
+static const IUIRibbonVtbl IUIRibbon_Vtbl =
+{
+    ribbon_QueryInterface,
+    ribbon_AddRef,
+    ribbon_Release,
+    ribbon_GetHeight,
+    ribbon_LoadSettingsFromStream,
+    ribbon_SaveSettingsToStream,
+};
