+static ULONG WINAPI image_AddRef(IUIImage *iface)
+{
+    return InterlockedIncrement(&impl_from_IUIImage(iface)->ref);
+}
+
+static ULONG WINAPI image_Release(IUIImage *iface)
+{
+    UIImageImpl *This = impl_from_IUIImage(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        DeleteObject(This->bitmap);
+        HeapFree(GetProcessHeap(), 0, This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI image_GetBitmap(IUIImage *iface, HBITMAP *bitmap)
+{
+    UIImageImpl *This = impl_from_IUIImage(iface);
+
+    TRACE("(%p)\n", bitmap);
+    if (!bitmap) return E_POINTER;
+    *bitmap = This->bitmap;
+    return S_OK;
+}
+
+static const IUIImageVtbl IUIImage_Vtbl =
+{
+    image_QueryInterface,
+    image_AddRef,
+    image_Release,
+    image_GetBitmap,
+};
+
+typedef struct
+{
+    IUIImageFromBitmap IUIImageFromBitmap_iface;
+    LONG ref;
+} UIImageFromBitmapImpl;
+
+static inline UIImageFromBitmapImpl *impl_from_IUIImageFromBitmap(IUIImageFromBitmap *iface)
+{
+    return CONTAINING_RECORD(iface, UIImageFromBitmapImpl, IUIImageFromBitmap_iface);
+}
+
+static HRESULT WINAPI factory_QueryInterface(IUIImageFromBitmap *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IUIImageFromBitmap))
+    {
+        IUIImageFromBitmap_AddRef(iface);
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef(IUIImageFromBitmap *iface)
+{
+    return InterlockedIncrement(&impl_from_IUIImageFromBitmap(iface)->ref);
+}
+
+static ULONG WINAPI factory_Release(IUIImageFromBitmap *iface)
+{
+    UIImageFromBitmapImpl *This = impl_from_IUIImageFromBitmap(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref) HeapFree(GetProcessHeap(), 0, This);
+    return ref;
+}
+
+/* the image takes the bitmap itself (UI_OWNERSHIP_TRANSFER) or a copy of it */
+static HRESULT WINAPI factory_CreateImage(IUIImageFromBitmap *iface, HBITMAP bitmap, UI_OWNERSHIP options, IUIImage **image)
+{
+    UIImageImpl *img;
+    HBITMAP own = bitmap;
+
+    TRACE("(%p, %d, %p)\n", bitmap, options, image);
+
+    if (!image) return E_POINTER;
+    *image = NULL;
+    if (!bitmap || (options != UI_OWNERSHIP_TRANSFER && options != UI_OWNERSHIP_COPY)) return E_INVALIDARG;
+    if (GetObjectType(bitmap) != OBJ_BITMAP) return E_INVALIDARG;
+    if (options == UI_OWNERSHIP_COPY)
+    {
+        if (!(own = CopyImage(bitmap, IMAGE_BITMAP, 0, 0, LR_CREATEDIBSECTION))) return E_OUTOFMEMORY;
+    }
+    if (!(img = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*img))))
+    {
+        if (own != bitmap) DeleteObject(own);
+        return E_OUTOFMEMORY;
+    }
+    img->IUIImage_iface.lpVtbl = &IUIImage_Vtbl;
+    img->ref = 1;
+    img->bitmap = own;
+    *image = &img->IUIImage_iface;
+    return S_OK;
+}
+
+static const IUIImageFromBitmapVtbl IUIImageFromBitmap_Vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_CreateImage,
+};
+
+HRESULT UIRibbonImageFromBitmapImpl_Create(IUnknown *pUnkOuter, void **ppObj)
+{
+    UIImageFromBitmapImpl *object;
+
+    if (pUnkOuter) return CLASS_E_NOAGGREGATION;
+    if (!(object = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*object)))) return E_OUTOFMEMORY;
+    object->IUIImageFromBitmap_iface.lpVtbl = &IUIImageFromBitmap_Vtbl;
+    object->ref = 1;
+    *ppObj = &object->IUIImageFromBitmap_iface;
+    return S_OK;
+}
