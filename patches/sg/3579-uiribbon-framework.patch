+static IUICommandHandler *get_handler(UIRibbonFrameworkImpl *This, UINT32 command)
+{
+    struct command_handler *h;
+    IUICommandHandler *handler = NULL;
+    HRESULT hr;
+
+    LIST_FOR_EACH_ENTRY(h, &This->handlers, struct command_handler, entry)
+        if (h->command == command) return h->handler;
+
+    hr = IUIApplication_OnCreateUICommand(This->app, command, UI_COMMANDTYPE_UNKNOWN, &handler);
+    if (FAILED(hr) || !handler) return NULL;
+    if (!(h = HeapAlloc(GetProcessHeap(), 0, sizeof(*h)))) { IUICommandHandler_Release(handler); return NULL; }
+    h->command = command;
+    h->handler = handler;
+    list_add_tail(&This->handlers, &h->entry);
+    return handler;
+}
 
-    return E_NOTIMPL;
+/* asks the command's handler for the new value of one property and keeps it */
+static HRESULT run_invalidation(UIRibbonFrameworkImpl *This, UINT32 command, const PROPERTYKEY *key)
+{
+    IUICommandHandler *handler;
+    PROPVARIANT current, new_value;
+    struct command_prop *p;
+    HRESULT hr;
+
+    if (!(handler = get_handler(This, command))) return E_FAIL;
+    PropVariantInit(&current);
+    PropVariantInit(&new_value);
+    if ((p = find_prop(This, command, key))) PropVariantCopy(&current, &p->value);
+    IUICommandHandler_AddRef(handler);
+    hr = IUICommandHandler_UpdateProperty(handler, command, key, p ? &current : NULL, &new_value);
+    IUICommandHandler_Release(handler);
+    if (SUCCEEDED(hr)) hr = store_prop(This, command, key, &new_value);
+    PropVariantClear(&current);
+    PropVariantClear(&new_value);
+    return hr;
 }
 
 static HRESULT WINAPI UIRibbonFrameworkImpl_FlushPendingInvalidations(IUIFramework *iface)
 {
-    FIXME("(): stub!\n");
+    UIRibbonFrameworkImpl *This = impl_from_IUIFramework(iface);
+    struct invalidation *inv, *inv2;
+    struct list todo;
