+/* ---- IUIImageFromBitmap and IUIImage ---- */
+
+typedef struct
+{
+    IUIImage IUIImage_iface;
+    LONG ref;
+    HBITMAP bitmap;
+} UIImageImpl;
+
+static inline UIImageImpl *impl_from_IUIImage(IUIImage *iface)
+{
+    return CONTAINING_RECORD(iface, UIImageImpl, IUIImage_iface);
+}
+
+static HRESULT WINAPI image_QueryInterface(IUIImage *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IUIImage))
+    {
