 WINE_DEFAULT_DEBUG_CHANNEL(uiribbon);
 
+/*
+ * The ribbon framework, without the drawing: the application object model is real (initialization,
+ * views, per-command properties, invalidation through the application's command handlers) but the
+ * ribbon markup is not interpreted, so no commands are created from it and the ribbon has no height.
+ */
+
+#define WM_RIBBON_FLUSH (WM_USER + 0x4A1)
+
+struct command_prop
+{
+    struct list entry;
+    UINT32 command;
+    PROPERTYKEY key;
+    PROPVARIANT value;
+};
+
+struct invalidation
+{
+    struct list entry;
+    UINT32 command;
+    UI_INVALIDATIONS flags;
+    PROPERTYKEY key;
+    BOOL has_key;
+};
+
+typedef struct
+{
+    IUIFramework IUIFramework_iface;
+    IUIRibbon IUIRibbon_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    HWND frame, notify;
+    DWORD thread;
+    IUIApplication *app;
+    BOOL ui_loaded;
+    INT32 modes;
+    BOOL flush_posted;
+    struct list props, pending, handlers;
+} UIRibbonFrameworkImpl;
+
+struct command_handler
+{
+    struct list entry;
+    UINT32 command;
+    IUICommandHandler *handler;
+};
+
 static inline UIRibbonFrameworkImpl *impl_from_IUIFramework(IUIFramework *iface)
 {
     return CONTAINING_RECORD(iface, UIRibbonFrameworkImpl, IUIFramework_iface);
 }
 
+static inline UIRibbonFrameworkImpl *impl_from_IUIRibbon(IUIRibbon *iface)
+{
+    return CONTAINING_RECORD(iface, UIRibbonFrameworkImpl, IUIRibbon_iface);
+}
+
+static struct command_prop *find_prop(UIRibbonFrameworkImpl *This, UINT32 command, const PROPERTYKEY *key)
+{
+    struct command_prop *p;
+
+    LIST_FOR_EACH_ENTRY(p, &This->props, struct command_prop, entry)
+        if (p->command == command && IsEqualPropertyKey(p->key, *key)) return p;
+    return NULL;
+}
+
+static void free_state(UIRibbonFrameworkImpl *This)
+{
+    struct command_prop *p, *p2;
+    struct invalidation *i, *i2;
+    struct command_handler *h, *h2;
+
+    LIST_FOR_EACH_ENTRY_SAFE(p, p2, &This->props, struct command_prop, entry)
+    {
+        list_remove(&p->entry);
+        PropVariantClear(&p->value);
+        HeapFree(GetProcessHeap(), 0, p);
+    }
+    LIST_FOR_EACH_ENTRY_SAFE(i, i2, &This->pending, struct invalidation, entry)
+    {
+        list_remove(&i->entry);
+        HeapFree(GetProcessHeap(), 0, i);
+    }
+    LIST_FOR_EACH_ENTRY_SAFE(h, h2, &This->handlers, struct command_handler, entry)
+    {
+        list_remove(&h->entry);
+        if (This->app) IUIApplication_OnDestroyUICommand(This->app, h->command, UI_COMMANDTYPE_UNKNOWN, h->handler);
+        if (h->handler) IUICommandHandler_Release(h->handler);
+        HeapFree(GetProcessHeap(), 0, h);
+    }
+}
+
+/*** IUIRibbon ***/
