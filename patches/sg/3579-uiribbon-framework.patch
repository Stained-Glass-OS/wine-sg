-    return E_NOTIMPL;
+    if (!This->app) return E_UNEXPECTED;
+    list_init(&todo);
+    EnterCriticalSection(&This->cs);
+    list_move_tail(&todo, &This->pending);
+    This->flush_posted = FALSE;
+    LeaveCriticalSection(&This->cs);
+
+    LIST_FOR_EACH_ENTRY_SAFE(inv, inv2, &todo, struct invalidation, entry)
+    {
+        struct command_prop *p;
+        PROPERTYKEY keys[32];
+        unsigned int n = 0, i;
+
+        list_remove(&inv->entry);
+        EnterCriticalSection(&This->cs);
+        if ((inv->flags & UI_INVALIDATIONS_PROPERTY) && inv->has_key) keys[n++] = inv->key;
+        /* the other invalidations concern the properties the command has */
+        if (inv->flags & ~UI_INVALIDATIONS_PROPERTY)
+            LIST_FOR_EACH_ENTRY(p, &This->props, struct command_prop, entry)
+                if (p->command == inv->command && n < ARRAY_SIZE(keys)) keys[n++] = p->key;
+        LeaveCriticalSection(&This->cs);
+        for (i = 0; i < n; i++) run_invalidation(This, inv->command, &keys[i]);
+        HeapFree(GetProcessHeap(), 0, inv);
+    }
+    return S_OK;
 }
 
