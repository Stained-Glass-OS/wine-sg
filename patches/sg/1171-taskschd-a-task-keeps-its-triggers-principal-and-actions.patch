+/* ---- repetition patterns ------------------------------------------------ */
+
+struct repetition
+{
+    IRepetitionPattern IRepetitionPattern_iface;
+    LONG ref;
+    WCHAR *interval, *duration;
+    BOOL stop_at_end;
+};
+
+static inline struct repetition *impl_from_IRepetitionPattern(IRepetitionPattern *iface)
+{
+    return CONTAINING_RECORD(iface, struct repetition, IRepetitionPattern_iface);
+}
+
+static HRESULT WINAPI repetition_QueryInterface(IRepetitionPattern *iface, REFIID riid, void **obj)
+{
+    TRACE("%p,%s,%p\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualGUID(riid, &IID_IRepetitionPattern) || IsEqualGUID(riid, &IID_IDispatch) ||
+        IsEqualGUID(riid, &IID_IUnknown))
+    {
+        IRepetitionPattern_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI repetition_AddRef(IRepetitionPattern *iface)
+{
+    return InterlockedIncrement(&impl_from_IRepetitionPattern(iface)->ref);
+}
+
+static ULONG WINAPI repetition_Release(IRepetitionPattern *iface)
+{
+    struct repetition *rep = impl_from_IRepetitionPattern(iface);
+    LONG ref = InterlockedDecrement(&rep->ref);
+
+    if (!ref)
+    {
+        free(rep->interval);
+        free(rep->duration);
+        free(rep);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI repetition_GetTypeInfoCount(IRepetitionPattern *iface, UINT *count)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI repetition_GetTypeInfo(IRepetitionPattern *iface, UINT index, LCID lcid, ITypeInfo **info)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI repetition_GetIDsOfNames(IRepetitionPattern *iface, REFIID riid, LPOLESTR *names,
+                                               UINT count, LCID lcid, DISPID *dispid)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI repetition_Invoke(IRepetitionPattern *iface, DISPID dispid, REFIID riid, LCID lcid, WORD flags,
+                                        DISPPARAMS *params, VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr)
+{
+    return E_NOTIMPL;
+}
+
+/* a string property: NULL or a copy */
+static HRESULT get_string(const WCHAR *value, BSTR *out)
+{
+    if (!out) return E_POINTER;
+    if (!value) *out = NULL;
+    else if (!(*out = SysAllocString(value))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT put_string(WCHAR **field, const WCHAR *value)
+{
+    WCHAR *str = NULL;
+
+    if (value && *value && !(str = wcsdup(value))) return E_OUTOFMEMORY;
+    free(*field);
+    *field = str;
+    return S_OK;
+}
+
+static HRESULT WINAPI repetition_get_Interval(IRepetitionPattern *iface, BSTR *interval)
+{
+    return get_string(impl_from_IRepetitionPattern(iface)->interval, interval);
+}
+
+static HRESULT WINAPI repetition_put_Interval(IRepetitionPattern *iface, BSTR interval)
+{
+    TRACE("%p,%s\n", iface, debugstr_w(interval));
+    return put_string(&impl_from_IRepetitionPattern(iface)->interval, interval);
+}
+
+static HRESULT WINAPI repetition_get_Duration(IRepetitionPattern *iface, BSTR *duration)
+{
+    return get_string(impl_from_IRepetitionPattern(iface)->duration, duration);
+}
+
+static HRESULT WINAPI repetition_put_Duration(IRepetitionPattern *iface, BSTR duration)
+{
+    TRACE("%p,%s\n", iface, debugstr_w(duration));
+    return put_string(&impl_from_IRepetitionPattern(iface)->duration, duration);
+}
+
+static HRESULT WINAPI repetition_get_StopAtDurationEnd(IRepetitionPattern *iface, VARIANT_BOOL *stop)
+{
+    if (!stop) return E_POINTER;
+    *stop = impl_from_IRepetitionPattern(iface)->stop_at_end ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI repetition_put_StopAtDurationEnd(IRepetitionPattern *iface, VARIANT_BOOL stop)
+{
+    impl_from_IRepetitionPattern(iface)->stop_at_end = !!stop;
+    return S_OK;
+}
+
+static const IRepetitionPatternVtbl repetition_vtbl =
+{
+    repetition_QueryInterface,
+    repetition_AddRef,
+    repetition_Release,
+    repetition_GetTypeInfoCount,
+    repetition_GetTypeInfo,
+    repetition_GetIDsOfNames,
+    repetition_Invoke,
+    repetition_get_Interval,
+    repetition_put_Interval,
+    repetition_get_Duration,
+    repetition_put_Duration,
+    repetition_get_StopAtDurationEnd,
+    repetition_put_StopAtDurationEnd
+};
