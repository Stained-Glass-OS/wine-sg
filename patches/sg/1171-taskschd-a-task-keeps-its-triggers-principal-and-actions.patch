+/* ---- triggers ------------------------------------------------------------ */
+
+/* One object for every kind: the interface it is (its vtable) follows the
+ * type; what a kind does not have is never read or written. */
+struct trigger
+{
+    ITrigger ITrigger_iface;
+    LONG ref;
+    TASK_TRIGGER_TYPE2 type;
+    WCHAR *id, *start, *end, *time_limit;
+    BOOL enabled;
+    struct repetition *repetition;
+    WCHAR *delay;           /* logon, boot, registration */
+    WCHAR *random_delay;    /* time, daily, weekly */
+    WCHAR *user_id;         /* logon */
+    short days_interval;    /* daily */
+    short days_of_week;     /* weekly: TASK_SUNDAY (1) .. TASK_SATURDAY (64) */
+    short weeks_interval;   /* weekly */
+};
+
+static inline struct trigger *impl_from_ITrigger(ITrigger *iface)
+{
+    return CONTAINING_RECORD(iface, struct trigger, ITrigger_iface);
+}
+
+static const IID *trigger_iid(TASK_TRIGGER_TYPE2 type)
+{
+    switch (type)
+    {
+    case TASK_TRIGGER_TIME: return &IID_ITimeTrigger;
+    case TASK_TRIGGER_DAILY: return &IID_IDailyTrigger;
+    case TASK_TRIGGER_WEEKLY: return &IID_IWeeklyTrigger;
+    case TASK_TRIGGER_LOGON: return &IID_ILogonTrigger;
+    case TASK_TRIGGER_BOOT: return &IID_IBootTrigger;
+    case TASK_TRIGGER_REGISTRATION: return &IID_IRegistrationTrigger;
+    case TASK_TRIGGER_IDLE: return &IID_IIdleTrigger;
+    default: return &IID_ITrigger;
+    }
+}
+
+static HRESULT WINAPI trigger_QueryInterface(ITrigger *iface, REFIID riid, void **obj)
+{
+    struct trigger *trigger = impl_from_ITrigger(iface);
+
+    TRACE("%p,%s,%p\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch) ||
+        IsEqualGUID(riid, &IID_ITrigger) || IsEqualGUID(riid, trigger_iid(trigger->type)))
+    {
+        ITrigger_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    WARN("%s is not implemented\n", debugstr_guid(riid));
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI trigger_AddRef(ITrigger *iface)
+{
+    return InterlockedIncrement(&impl_from_ITrigger(iface)->ref);
+}
+
+static ULONG WINAPI trigger_Release(ITrigger *iface)
+{
+    struct trigger *trigger = impl_from_ITrigger(iface);
+    LONG ref = InterlockedDecrement(&trigger->ref);
+
+    if (!ref)
+    {
+        TRACE("destroying %p\n", iface);
+        free(trigger->id);
+        free(trigger->start);
+        free(trigger->end);
+        free(trigger->time_limit);
+        free(trigger->delay);
+        free(trigger->random_delay);
+        free(trigger->user_id);
+        if (trigger->repetition) IRepetitionPattern_Release(&trigger->repetition->IRepetitionPattern_iface);
+        free(trigger);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI trigger_GetTypeInfoCount(ITrigger *iface, UINT *count)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI trigger_GetTypeInfo(ITrigger *iface, UINT index, LCID lcid, ITypeInfo **info)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI trigger_GetIDsOfNames(ITrigger *iface, REFIID riid, LPOLESTR *names,
+                                            UINT count, LCID lcid, DISPID *dispid)
+{
+    return E_NOTIMPL;
+}
