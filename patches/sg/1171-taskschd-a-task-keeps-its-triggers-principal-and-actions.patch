+
+/* A task started by Run: its path; its state is asked of the server */
+typedef struct
+{
+    IRunningTask IRunningTask_iface;
+    LONG ref;
+    WCHAR *path;
+} RunningTask;
+
+static inline RunningTask *impl_from_IRunningTask(IRunningTask *iface)
+{
+    return CONTAINING_RECORD(iface, RunningTask, IRunningTask_iface);
+}
+
+static HRESULT WINAPI running_QueryInterface(IRunningTask *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IRunningTask) || IsEqualGUID(riid, &IID_IDispatch) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        IRunningTask_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI running_AddRef(IRunningTask *iface)
+{
+    return InterlockedIncrement(&impl_from_IRunningTask(iface)->ref);
+}
+
+static ULONG WINAPI running_Release(IRunningTask *iface)
+{
+    RunningTask *task = impl_from_IRunningTask(iface);
+    LONG ref = InterlockedDecrement(&task->ref);
+
+    if (!ref)
+    {
+        free(task->path);
+        free(task);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI running_GetTypeInfoCount(IRunningTask *iface, UINT *count)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI running_GetTypeInfo(IRunningTask *iface, UINT index, LCID lcid, ITypeInfo **info)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI running_GetIDsOfNames(IRunningTask *iface, REFIID riid, LPOLESTR *names, UINT count,
+                                            LCID lcid, DISPID *dispid)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI running_Invoke(IRunningTask *iface, DISPID dispid, REFIID riid, LCID lcid, WORD flags,
+                                     DISPPARAMS *params, VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI running_get_Name(IRunningTask *iface, BSTR *name)
+{
+    const WCHAR *path = impl_from_IRunningTask(iface)->path, *p = wcsrchr(path, '\\');
+
+    if (!name) return E_POINTER;
+    return (*name = SysAllocString(p && p[1] ? p + 1 : path)) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI running_get_InstanceGuid(IRunningTask *iface, BSTR *guid)
+{
+    if (!guid) return E_POINTER;
+    return (*guid = SysAllocString(L"{00000000-0000-0000-0000-000000000000}")) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI running_get_Path(IRunningTask *iface, BSTR *path)
+{
+    if (!path) return E_POINTER;
+    return (*path = SysAllocString(impl_from_IRunningTask(iface)->path)) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI running_get_State(IRunningTask *iface, TASK_STATE *state)
+{
+    DWORD enabled;
+
+    if (!state) return E_POINTER;
+    return SchRpcGetTaskInfo(impl_from_IRunningTask(iface)->path, SCH_FLAG_STATE, &enabled, (DWORD *)state);
+}
+
+static HRESULT WINAPI running_get_CurrentAction(IRunningTask *iface, BSTR *name)
+{
+    if (!name) return E_POINTER;
+    *name = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI running_Stop(IRunningTask *iface)
+{
+    return SchRpcStop(impl_from_IRunningTask(iface)->path, 0);
+}
+
+static HRESULT WINAPI running_Refresh(IRunningTask *iface)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI running_get_EnginePID(IRunningTask *iface, DWORD *pid)
+{
+    if (!pid) return E_POINTER;
+    *pid = 0;
+    return S_OK;
+}
+
+static const IRunningTaskVtbl RunningTask_vtbl =
+{
+    running_QueryInterface,
+    running_AddRef,
+    running_Release,
+    running_GetTypeInfoCount,
+    running_GetTypeInfo,
+    running_GetIDsOfNames,
+    running_Invoke,
+    running_get_Name,
+    running_get_InstanceGuid,
+    running_get_Path,
+    running_get_State,
+    running_get_CurrentAction,
+    running_Stop,
+    running_Refresh,
+    running_get_EnginePID
+};
+
+HRESULT RunningTask_create(const WCHAR *path, IRunningTask **obj)
+{
+    RunningTask *task;
+
+    if (!(task = calloc(1, sizeof(*task)))) return E_OUTOFMEMORY;
+    if (!(task->path = wcsdup(path)))
+    {
+        free(task);
+        return E_OUTOFMEMORY;
+    }
+    task->IRunningTask_iface.lpVtbl = &RunningTask_vtbl;
+    task->ref = 1;
+    *obj = &task->IRunningTask_iface;
+    return S_OK;
+}
