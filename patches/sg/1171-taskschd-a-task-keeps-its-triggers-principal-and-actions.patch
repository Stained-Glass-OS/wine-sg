+/* Run's parameters: one string or an array of them; $(Arg0).. in the
+ * actions take them on Windows -- here they reach the server, which passes
+ * them on as the program's arguments when the action names none */
+static HRESULT regtask_run(RegisteredTask *regtask, VARIANT params, LONG flags, LONG session_id, BSTR user,
+                           IRunningTask **task)
+{
+    const WCHAR *one = NULL;
+    GUID guid;
+    HRESULT hr;
+
+    if (V_VT(&params) == VT_BSTR) one = V_BSTR(&params);
+    else if (V_VT(&params) != VT_EMPTY && V_VT(&params) != VT_ERROR && V_VT(&params) != VT_NULL)
+        FIXME("parameters %s are not passed\n", debugstr_variant(&params));
+
+    hr = SchRpcRun(regtask->path, one ? 1 : 0, one ? &one : NULL, flags, session_id, user, &guid);
+    if (FAILED(hr)) return hr;
+    if (task) return RunningTask_create(regtask->path, task);
     return S_OK;
 }
 
