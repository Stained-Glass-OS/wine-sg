+/* Everything a trigger has, read through its interfaces: a trigger made by
+ * another implementation is written too. */
+static HRESULT write_trigger(IStream *stream, ITrigger *iface)
+{
+    TASK_TRIGGER_TYPE2 type;
+    IRepetitionPattern *rep;
+    VARIANT_BOOL enabled = VARIANT_TRUE;
+    const WCHAR *name;
+    BSTR s = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = ITrigger_get_Type(iface, &type))) return hr;
+    if (!(name = element_name(type)))
+    {
+        FIXME("trigger type %d is not written\n", type);
+        return S_OK;
+    }
+    if (SUCCEEDED(ITrigger_get_Id(iface, &s)) && s)
+    {
+        xml_write_indent(stream);
+        xml_write_string(stream, L"<");
+        xml_write_string(stream, name);
+        xml_write_string(stream, L" id=\"");
+        xml_write_escaped(stream, s);
+        xml_write_string(stream, L"\">\n");
+        SysFreeString(s);
+    }
+    else
+        xml_write_element(stream, name);
+    xml_push_indent();
+
+    if (SUCCEEDED(ITrigger_get_Repetition(iface, &rep)) && rep)
+    {
+        BSTR interval = NULL, duration = NULL;
+        VARIANT_BOOL stop = VARIANT_FALSE;
+
+        IRepetitionPattern_get_Interval(rep, &interval);
+        IRepetitionPattern_get_Duration(rep, &duration);
+        IRepetitionPattern_get_StopAtDurationEnd(rep, &stop);
+        if (interval)
+        {
+            xml_write_element(stream, L"Repetition");
+            xml_push_indent();
+            xml_write_text_value(stream, L"Interval", interval);
+            if (duration) xml_write_text_value(stream, L"Duration", duration);
+            xml_write_text_value(stream, L"StopAtDurationEnd", stop ? L"true" : L"false");
+            xml_pop_indent();
+            xml_write_element_end(stream, L"Repetition");
+        }
+        SysFreeString(interval);
+        SysFreeString(duration);
+        IRepetitionPattern_Release(rep);
+    }
+    s = NULL;
+    if (SUCCEEDED(ITrigger_get_StartBoundary(iface, &s)) && s) xml_write_text_value(stream, L"StartBoundary", s);
+    SysFreeString(s);
+    s = NULL;
+    if (SUCCEEDED(ITrigger_get_EndBoundary(iface, &s)) && s) xml_write_text_value(stream, L"EndBoundary", s);
+    SysFreeString(s);
+    s = NULL;
+    if (SUCCEEDED(ITrigger_get_ExecutionTimeLimit(iface, &s)) && s)
+        xml_write_text_value(stream, L"ExecutionTimeLimit", s);
+    SysFreeString(s);
+    ITrigger_get_Enabled(iface, &enabled);
+    xml_write_text_value(stream, L"Enabled", enabled ? L"true" : L"false");
+
+    switch (type)
+    {
+    case TASK_TRIGGER_TIME:
+    {
+        ITimeTrigger *time;
+        s = NULL;
+        if (SUCCEEDED(ITrigger_QueryInterface(iface, &IID_ITimeTrigger, (void **)&time)))
+        {
+            if (SUCCEEDED(ITimeTrigger_get_RandomDelay(time, &s)) && s) xml_write_text_value(stream, L"RandomDelay", s);
+            ITimeTrigger_Release(time);
+        }
+        SysFreeString(s);
+        break;
+    }
+    case TASK_TRIGGER_DAILY:
+    {
+        IDailyTrigger *daily;
+        short days = 1;
+        s = NULL;
+        if (SUCCEEDED(ITrigger_QueryInterface(iface, &IID_IDailyTrigger, (void **)&daily)))
+        {
+            IDailyTrigger_get_DaysInterval(daily, &days);
+            IDailyTrigger_get_RandomDelay(daily, &s);
+            IDailyTrigger_Release(daily);
+        }
+        if (s) xml_write_text_value(stream, L"RandomDelay", s);
+        SysFreeString(s);
+        xml_write_element(stream, L"ScheduleByDay");
+        xml_push_indent();
+        xml_write_int_value(stream, L"DaysInterval", days);
+        xml_pop_indent();
+        xml_write_element_end(stream, L"ScheduleByDay");
+        break;
+    }
+    case TASK_TRIGGER_WEEKLY:
+    {
+        IWeeklyTrigger *weekly;
+        short days = 0, weeks = 1;
+        unsigned int i;
+        s = NULL;
+        if (SUCCEEDED(ITrigger_QueryInterface(iface, &IID_IWeeklyTrigger, (void **)&weekly)))
+        {
+            IWeeklyTrigger_get_DaysOfWeek(weekly, &days);
+            IWeeklyTrigger_get_WeeksInterval(weekly, &weeks);
+            IWeeklyTrigger_get_RandomDelay(weekly, &s);
+            IWeeklyTrigger_Release(weekly);
+        }
+        if (s) xml_write_text_value(stream, L"RandomDelay", s);
+        SysFreeString(s);
+        xml_write_element(stream, L"ScheduleByWeek");
+        xml_push_indent();
+        xml_write_element(stream, L"DaysOfWeek");
+        xml_push_indent();
+        for (i = 0; i < ARRAY_SIZE(week_days); i++)
+            if (days & week_days[i].bit) xml_write_empty_element(stream, week_days[i].name);
+        xml_pop_indent();
+        xml_write_element_end(stream, L"DaysOfWeek");
+        xml_write_int_value(stream, L"WeeksInterval", weeks);
+        xml_pop_indent();
+        xml_write_element_end(stream, L"ScheduleByWeek");
+        break;
+    }
+    case TASK_TRIGGER_LOGON:
+    {
+        ILogonTrigger *logon;
+        BSTR user = NULL;
+        s = NULL;
+        if (SUCCEEDED(ITrigger_QueryInterface(iface, &IID_ILogonTrigger, (void **)&logon)))
+        {
+            ILogonTrigger_get_Delay(logon, &s);
+            ILogonTrigger_get_UserId(logon, &user);
+            ILogonTrigger_Release(logon);
+        }
+        if (user) xml_write_text_value(stream, L"UserId", user);
+        if (s) xml_write_text_value(stream, L"Delay", s);
+        SysFreeString(user);
+        SysFreeString(s);
+        break;
+    }
+    case TASK_TRIGGER_BOOT:
+    case TASK_TRIGGER_REGISTRATION:
+    {
+        IBootTrigger *boot;   /* both have Delay in the same place */
+        s = NULL;
+        if (SUCCEEDED(ITrigger_QueryInterface(iface, type == TASK_TRIGGER_BOOT ? &IID_IBootTrigger
+                                              : &IID_IRegistrationTrigger, (void **)&boot)))
+        {
+            IBootTrigger_get_Delay(boot, &s);
+            IBootTrigger_Release(boot);
+        }
+        if (s) xml_write_text_value(stream, L"Delay", s);
+        SysFreeString(s);
+        break;
+    }
+    default:
+        break;
+    }
+
+    xml_pop_indent();
+    return xml_write_element_end(stream, name);
+}
+
+HRESULT write_triggers(IStream *stream, ITriggerCollection *triggers)
+{
+    LONG count = 0, i;
+    HRESULT hr;
+
+    if (!triggers || FAILED(ITriggerCollection_get_Count(triggers, &count)) || !count)
+        return xml_write_empty_element(stream, L"Triggers");
+
+    xml_write_element(stream, L"Triggers");
+    xml_push_indent();
+    for (i = 1; i <= count; i++)
+    {
+        ITrigger *trigger;
+
+        if (FAILED(ITriggerCollection_get_Item(triggers, i, &trigger))) continue;
+        hr = write_trigger(stream, trigger);
+        ITrigger_Release(trigger);
+        if (FAILED(hr)) return hr;
+    }
+    xml_pop_indent();
+    return xml_write_element_end(stream, L"Triggers");
+}
+
+/* the text of the element the reader is on; "" for an empty one */
+static HRESULT read_text(IXmlReader *reader, WCHAR **value)
+{
+    static WCHAR empty[] = L"";
+    XmlNodeType type;
+
+    if (IXmlReader_IsEmptyElement(reader))
+    {
+        *value = empty;
+        return S_OK;
+    }
+    while (IXmlReader_Read(reader, &type) == S_OK)
+    {
+        if (type == XmlNodeType_Text) return IXmlReader_GetValue(reader, (const WCHAR **)value, NULL);
+        if (type == XmlNodeType_EndElement)
+        {
+            *value = empty;
+            return S_OK;
+        }
+    }
+    return SCHED_E_MALFORMEDXML;
+}
+
+static BOOL is_true(const WCHAR *value)
+{
+    return !wcscmp(value, L"true") || !wcscmp(value, L"1");
+}
+
+/* reads to the end of the element the reader is on; calls back for each
+ * child element */
+typedef HRESULT (*child_fn)(IXmlReader *reader, const WCHAR *name, struct trigger *trigger);
+
+static HRESULT read_children(IXmlReader *reader, const WCHAR *parent, child_fn fn, struct trigger *trigger)
+{
+    const WCHAR *name;
+    XmlNodeType type;
+    HRESULT hr;
+    UINT depth, d;
+
+    if (IXmlReader_IsEmptyElement(reader)) return S_OK;
+    IXmlReader_GetDepth(reader, &depth);
+    while (IXmlReader_Read(reader, &type) == S_OK)
+    {
+        if (type == XmlNodeType_EndElement)
+        {
+            IXmlReader_GetDepth(reader, &d);
+            if (d <= depth + 1) return S_OK;   /* an end element is a level below its element */
+        }
+        else if (type == XmlNodeType_Element)
+        {
+            if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL))) return hr;
+            if (FAILED(hr = fn(reader, name, trigger))) return hr;
+        }
+    }
+    WARN("%s was not terminated\n", debugstr_w(parent));
+    return SCHED_E_MALFORMEDXML;
+}
+
+static HRESULT skip_element(IXmlReader *reader)
+{
+    XmlNodeType type;
+    UINT depth, d;
+
+    if (IXmlReader_IsEmptyElement(reader)) return S_OK;
+    IXmlReader_GetDepth(reader, &depth);
+    while (IXmlReader_Read(reader, &type) == S_OK)
+    {
+        if (type != XmlNodeType_EndElement) continue;
+        IXmlReader_GetDepth(reader, &d);
+        if (d <= depth + 1) return S_OK;   /* an end element is a level below its element */
+    }
+    return SCHED_E_MALFORMEDXML;
+}
+
+static HRESULT read_repetition_child(IXmlReader *reader, const WCHAR *name, struct trigger *trigger)
+{
+    WCHAR *value;
+    HRESULT hr;
+
+    if (FAILED(hr = read_text(reader, &value))) return hr;
+    if (!wcscmp(name, L"Interval")) put_string(&trigger->repetition->interval, value);
+    else if (!wcscmp(name, L"Duration")) put_string(&trigger->repetition->duration, value);
+    else if (!wcscmp(name, L"StopAtDurationEnd")) trigger->repetition->stop_at_end = is_true(value);
+    return S_OK;
+}
+
+static HRESULT read_days_of_week_child(IXmlReader *reader, const WCHAR *name, struct trigger *trigger)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(week_days); i++)
+        if (!wcscmp(name, week_days[i].name)) trigger->days_of_week |= week_days[i].bit;
+    return skip_element(reader);
+}
+
+static HRESULT read_schedule_child(IXmlReader *reader, const WCHAR *name, struct trigger *trigger)
+{
+    WCHAR *value;
+    HRESULT hr;
+
+    if (!wcscmp(name, L"DaysOfWeek"))
+    {
+        trigger->days_of_week = 0;
+        return read_children(reader, name, read_days_of_week_child, trigger);
+    }
+    if (FAILED(hr = read_text(reader, &value))) return hr;
+    if (!wcscmp(name, L"DaysInterval")) trigger->days_interval = max(1, wcstol(value, NULL, 10));
+    else if (!wcscmp(name, L"WeeksInterval")) trigger->weeks_interval = max(1, wcstol(value, NULL, 10));
+    return S_OK;
+}
+
+static HRESULT read_trigger_child(IXmlReader *reader, const WCHAR *name, struct trigger *trigger)
+{
+    WCHAR *value;
+    HRESULT hr;
+
+    if (!wcscmp(name, L"Repetition"))
+    {
+        if (!trigger->repetition && FAILED(hr = repetition_create(&trigger->repetition))) return hr;
+        return read_children(reader, name, read_repetition_child, trigger);
+    }
+    if (!wcscmp(name, L"ScheduleByDay"))
+    {
+        trigger->type = TASK_TRIGGER_DAILY;
+        trigger->ITrigger_iface.lpVtbl = (const ITriggerVtbl *)&daily_trigger_vtbl;
+        return read_children(reader, name, read_schedule_child, trigger);
+    }
+    if (!wcscmp(name, L"ScheduleByWeek"))
+    {
+        trigger->type = TASK_TRIGGER_WEEKLY;
+        trigger->ITrigger_iface.lpVtbl = (const ITriggerVtbl *)&weekly_trigger_vtbl;
+        return read_children(reader, name, read_schedule_child, trigger);
+    }
+    if (!wcscmp(name, L"ScheduleByMonth") || !wcscmp(name, L"ScheduleByMonthDayOfWeek"))
+    {
+        FIXME("%s is not implemented, read as a daily trigger\n", debugstr_w(name));
+        return skip_element(reader);
+    }
+    if (FAILED(hr = read_text(reader, &value))) return hr;
+    if (!wcscmp(name, L"StartBoundary")) put_string(&trigger->start, value);
+    else if (!wcscmp(name, L"EndBoundary")) put_string(&trigger->end, value);
+    else if (!wcscmp(name, L"ExecutionTimeLimit")) put_string(&trigger->time_limit, value);
+    else if (!wcscmp(name, L"Enabled")) trigger->enabled = is_true(value);
+    else if (!wcscmp(name, L"Delay")) put_string(&trigger->delay, value);
+    else if (!wcscmp(name, L"RandomDelay")) put_string(&trigger->random_delay, value);
+    else if (!wcscmp(name, L"UserId")) put_string(&trigger->user_id, value);
+    else TRACE("%s is not kept\n", debugstr_w(name));
+    return S_OK;
+}
+
+static HRESULT read_trigger_id(IXmlReader *reader, struct trigger *trigger)
+{
+    const WCHAR *name, *value;
+    HRESULT hr;
+
+    for (hr = IXmlReader_MoveToFirstAttribute(reader); hr == S_OK; hr = IXmlReader_MoveToNextAttribute(reader))
+    {
+        if (FAILED(IXmlReader_GetLocalName(reader, &name, NULL)) || FAILED(IXmlReader_GetValue(reader, &value, NULL)))
+            break;
+        if (!wcscmp(name, L"id")) put_string(&trigger->id, value);
+    }
+    IXmlReader_MoveToElement(reader);
+    return S_OK;
+}
+
+/* the reader is on <Triggers> */
+HRESULT read_triggers(IXmlReader *reader, ITaskDefinition *taskdef)
+{
+    struct trigger_collection *collection;
+    ITriggerCollection *triggers;
+    const WCHAR *name;
+    XmlNodeType type;
+    UINT depth, d;
+    HRESULT hr;
+
+    if (FAILED(hr = ITaskDefinition_get_Triggers(taskdef, &triggers))) return hr;
+    collection = impl_from_ITriggerCollection(triggers);   /* the definition's own */
+    if (IXmlReader_IsEmptyElement(reader)) goto done;
+    IXmlReader_GetDepth(reader, &depth);
+    while ((hr = IXmlReader_Read(reader, &type)) == S_OK)
+    {
+        TASK_TRIGGER_TYPE2 kind;
+        struct trigger *trigger;
+
+        if (type == XmlNodeType_EndElement)
+        {
+            IXmlReader_GetDepth(reader, &d);
+            if (d <= depth + 1) break;
+            continue;
+        }
+        if (type != XmlNodeType_Element) continue;
+        if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL))) break;
+
+        if (!wcscmp(name, L"TimeTrigger")) kind = TASK_TRIGGER_TIME;
+        else if (!wcscmp(name, L"CalendarTrigger")) kind = TASK_TRIGGER_DAILY;   /* its schedule says which */
+        else if (!wcscmp(name, L"LogonTrigger")) kind = TASK_TRIGGER_LOGON;
+        else if (!wcscmp(name, L"BootTrigger")) kind = TASK_TRIGGER_BOOT;
+        else if (!wcscmp(name, L"RegistrationTrigger")) kind = TASK_TRIGGER_REGISTRATION;
+        else if (!wcscmp(name, L"IdleTrigger")) kind = TASK_TRIGGER_IDLE;
+        else
+        {
+            FIXME("trigger %s is not implemented\n", debugstr_w(name));
+            if (FAILED(hr = skip_element(reader))) break;
+            continue;
+        }
+        if (FAILED(hr = trigger_create(kind, &trigger))) break;
+        read_trigger_id(reader, trigger);
+        hr = read_children(reader, name, read_trigger_child, trigger);
+#ifndef SG_MUTANT_TASK_DROP_TRIGGERS
+        if (SUCCEEDED(hr)) hr = collection_add(collection, &trigger->ITrigger_iface);
+#endif
+        ITrigger_Release(&trigger->ITrigger_iface);
+        if (FAILED(hr)) break;
+    }
+done:
+    ITriggerCollection_Release(triggers);
+    return FAILED(hr) ? hr : S_OK;
+}
