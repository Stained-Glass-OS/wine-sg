+static HRESULT repetition_create(struct repetition **out)
+{
+    struct repetition *rep;
+
+    if (!(rep = calloc(1, sizeof(*rep)))) return E_OUTOFMEMORY;
+    rep->IRepetitionPattern_iface.lpVtbl = &repetition_vtbl;
+    rep->ref = 1;
+    *out = rep;
+    return S_OK;
+}
