+HRESULT TriggerCollection_create(ITriggerCollection **obj)
+{
+    struct trigger_collection *collection;
+
+    if (!(collection = calloc(1, sizeof(*collection)))) return E_OUTOFMEMORY;
+    collection->ITriggerCollection_iface.lpVtbl = &collection_vtbl;
+    collection->ref = 1;
+    *obj = &collection->ITriggerCollection_iface;
+    return S_OK;
+}
