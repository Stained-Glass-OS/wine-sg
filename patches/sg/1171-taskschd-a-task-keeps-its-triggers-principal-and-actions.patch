+/* ---- the collection ------------------------------------------------------- */
+
+struct trigger_collection
+{
+    ITriggerCollection ITriggerCollection_iface;
+    LONG ref;
+    ITrigger **items;
+    LONG count, size;
+};
+
+static inline struct trigger_collection *impl_from_ITriggerCollection(ITriggerCollection *iface)
+{
+    return CONTAINING_RECORD(iface, struct trigger_collection, ITriggerCollection_iface);
+}
+
+static HRESULT WINAPI collection_QueryInterface(ITriggerCollection *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch) ||
+        IsEqualGUID(riid, &IID_ITriggerCollection))
+    {
+        ITriggerCollection_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI collection_AddRef(ITriggerCollection *iface)
+{
+    return InterlockedIncrement(&impl_from_ITriggerCollection(iface)->ref);
+}
+
+static void collection_clear(struct trigger_collection *collection)
+{
+    LONG i;
+
+    for (i = 0; i < collection->count; i++) ITrigger_Release(collection->items[i]);
+    collection->count = 0;
+}
+
+static ULONG WINAPI collection_Release(ITriggerCollection *iface)
+{
+    struct trigger_collection *collection = impl_from_ITriggerCollection(iface);
+    LONG ref = InterlockedDecrement(&collection->ref);
+
+    if (!ref)
+    {
+        collection_clear(collection);
+        free(collection->items);
+        free(collection);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI collection_GetTypeInfoCount(ITriggerCollection *iface, UINT *count)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI collection_GetTypeInfo(ITriggerCollection *iface, UINT index, LCID lcid, ITypeInfo **info)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI collection_GetIDsOfNames(ITriggerCollection *iface, REFIID riid, LPOLESTR *names,
+                                               UINT count, LCID lcid, DISPID *dispid)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI collection_Invoke(ITriggerCollection *iface, DISPID dispid, REFIID riid, LCID lcid, WORD flags,
+                                        DISPPARAMS *params, VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI collection_get_Count(ITriggerCollection *iface, LONG *count)
+{
+    if (!count) return E_POINTER;
+    *count = impl_from_ITriggerCollection(iface)->count;
+    return S_OK;
+}
+
+/* Item is 1-based, as in every Task Scheduler collection */
+static HRESULT WINAPI collection_get_Item(ITriggerCollection *iface, LONG index, ITrigger **trigger)
+{
+    struct trigger_collection *collection = impl_from_ITriggerCollection(iface);
+
+    if (!trigger) return E_POINTER;
+    if (index < 1 || index > collection->count) return E_INVALIDARG;
+    ITrigger_AddRef(*trigger = collection->items[index - 1]);
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_get__NewEnum(ITriggerCollection *iface, IUnknown **penum)
+{
+    FIXME("%p,%p: enumerator not implemented, use Count and Item\n", iface, penum);
+    return E_NOTIMPL;
+}
+
+static HRESULT collection_add(struct trigger_collection *collection, ITrigger *trigger)
+{
+    if (collection->count == collection->size)
+    {
+        LONG size = max(4, collection->size * 2);
+        ITrigger **items = realloc(collection->items, size * sizeof(*items));
+
+        if (!items) return E_OUTOFMEMORY;
+        collection->items = items;
+        collection->size = size;
+    }
+    ITrigger_AddRef(collection->items[collection->count++] = trigger);
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_Create(ITriggerCollection *iface, TASK_TRIGGER_TYPE2 type, ITrigger **out)
+{
+    struct trigger_collection *collection = impl_from_ITriggerCollection(iface);
+    struct trigger *trigger;
+    HRESULT hr;
+
+    TRACE("%p,%d,%p\n", iface, type, out);
+
+    if (!out) return E_POINTER;
+#ifndef SG_MUTANT_TASK_DROP_TRIGGERS
+    if (FAILED(hr = trigger_create(type, &trigger))) return hr;
+    if (FAILED(hr = collection_add(collection, &trigger->ITrigger_iface)))
+    {
+        ITrigger_Release(&trigger->ITrigger_iface);
+        return hr;
+    }
+#else
+    if (FAILED(hr = trigger_create(type, &trigger))) return hr;
+#endif
+    *out = &trigger->ITrigger_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_Remove(ITriggerCollection *iface, VARIANT index)
+{
+    struct trigger_collection *collection = impl_from_ITriggerCollection(iface);
+    LONG i = -1, n;
+    VARIANT v;
+
+    TRACE("%p,%s\n", iface, debugstr_variant(&index));
+
+    VariantInit(&v);
+    if (V_VT(&index) == VT_BSTR)
+    {
+        for (n = 0; n < collection->count; n++)
+        {
+            struct trigger *trigger = unsafe_trigger(collection->items[n]);
+            if (trigger && trigger->id && !wcscmp(trigger->id, V_BSTR(&index))) { i = n; break; }
+        }
+    }
+    else if (SUCCEEDED(VariantChangeType(&v, &index, 0, VT_I4)))
+        i = V_I4(&v) - 1;
+    if (i < 0 || i >= collection->count) return E_INVALIDARG;
+    ITrigger_Release(collection->items[i]);
+    memmove(&collection->items[i], &collection->items[i + 1], (collection->count - i - 1) * sizeof(*collection->items));
+    collection->count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_Clear(ITriggerCollection *iface)
+{
+    collection_clear(impl_from_ITriggerCollection(iface));
+    return S_OK;
+}
+
+static const ITriggerCollectionVtbl collection_vtbl =
+{
+    collection_QueryInterface,
+    collection_AddRef,
+    collection_Release,
+    collection_GetTypeInfoCount,
+    collection_GetTypeInfo,
+    collection_GetIDsOfNames,
+    collection_Invoke,
+    collection_get_Count,
+    collection_get_Item,
+    collection_get__NewEnum,
+    collection_Create,
+    collection_Remove,
+    collection_Clear
+};
