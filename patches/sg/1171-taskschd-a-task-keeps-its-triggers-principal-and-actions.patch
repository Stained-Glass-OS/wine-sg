+static const WCHAR *element_name(TASK_TRIGGER_TYPE2 type)
+{
+    switch (type)
+    {
+    case TASK_TRIGGER_TIME: return L"TimeTrigger";
+    case TASK_TRIGGER_DAILY:
+    case TASK_TRIGGER_WEEKLY: return L"CalendarTrigger";
+    case TASK_TRIGGER_LOGON: return L"LogonTrigger";
+    case TASK_TRIGGER_BOOT: return L"BootTrigger";
+    case TASK_TRIGGER_REGISTRATION: return L"RegistrationTrigger";
+    case TASK_TRIGGER_IDLE: return L"IdleTrigger";
+    default: return NULL;
+    }
+}
