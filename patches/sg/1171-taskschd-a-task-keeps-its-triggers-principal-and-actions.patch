+static HRESULT trigger_create(TASK_TRIGGER_TYPE2 type, struct trigger **out)
+{
+    struct trigger *trigger;
+    const void *vtbl;
+
+    switch (type)
+    {
+    case TASK_TRIGGER_TIME: vtbl = &time_trigger_vtbl; break;
+    case TASK_TRIGGER_DAILY: vtbl = &daily_trigger_vtbl; break;
+    case TASK_TRIGGER_WEEKLY: vtbl = &weekly_trigger_vtbl; break;
+    case TASK_TRIGGER_LOGON: vtbl = &logon_trigger_vtbl; break;
+    case TASK_TRIGGER_BOOT: vtbl = &boot_trigger_vtbl; break;
+    case TASK_TRIGGER_REGISTRATION: vtbl = &registration_trigger_vtbl; break;
+    case TASK_TRIGGER_IDLE: vtbl = &plain_trigger_vtbl; break;   /* IIdleTrigger adds nothing */
+    default:
+        FIXME("trigger type %d is not implemented\n", type);
+        return E_NOTIMPL;
+    }
+    if (!(trigger = calloc(1, sizeof(*trigger)))) return E_OUTOFMEMORY;
+    trigger->ITrigger_iface.lpVtbl = vtbl;
+    trigger->ref = 1;
+    trigger->type = type;
+    trigger->enabled = TRUE;
+    trigger->days_interval = 1;
+    trigger->weeks_interval = 1;
+    *out = trigger;
+    return S_OK;
+}
+
+/* ours, or NULL for a trigger made elsewhere */
+static struct trigger *unsafe_trigger(ITrigger *iface)
+{
+    const void *vtbl = iface ? iface->lpVtbl : NULL;
+
+    if (vtbl == &time_trigger_vtbl || vtbl == &daily_trigger_vtbl || vtbl == &weekly_trigger_vtbl ||
+        vtbl == &logon_trigger_vtbl || vtbl == &boot_trigger_vtbl || vtbl == &registration_trigger_vtbl ||
+        vtbl == &plain_trigger_vtbl)
+        return impl_from_ITrigger(iface);
+    return NULL;
+}
