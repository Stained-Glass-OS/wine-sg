+static HRESULT read_exec(IXmlReader *reader, IExecAction *exec)
+{
+    const WCHAR *name;
+    XmlNodeType type;
+    WCHAR *value;
+    UINT depth, d;
+    HRESULT hr;
+
+    if (IXmlReader_IsEmptyElement(reader)) return S_OK;
+    IXmlReader_GetDepth(reader, &depth);
+    while (IXmlReader_Read(reader, &type) == S_OK)
+    {
+        if (type == XmlNodeType_EndElement)
+        {
+            IXmlReader_GetDepth(reader, &d);
+            if (d <= depth + 1) return S_OK;   /* an end element is a level below its element */
+            continue;
+        }
+        if (type != XmlNodeType_Element) continue;
+        if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL))) return hr;
+        if (IXmlReader_IsEmptyElement(reader)) continue;
+        if (FAILED(hr = read_text_value(reader, &value))) return hr;
+        if (!lstrcmpW(name, L"Command")) IExecAction_put_Path(exec, value);
+        else if (!lstrcmpW(name, L"Arguments")) IExecAction_put_Arguments(exec, value);
+        else if (!lstrcmpW(name, L"WorkingDirectory")) IExecAction_put_WorkingDirectory(exec, value);
+        else FIXME("unhandled Exec element %s\n", debugstr_w(name));
+    }
+    return SCHED_E_MALFORMEDXML;
+}
