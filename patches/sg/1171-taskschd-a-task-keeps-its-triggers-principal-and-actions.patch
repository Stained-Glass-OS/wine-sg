+static HRESULT WINAPI trigger_Invoke(ITrigger *iface, DISPID dispid, REFIID riid, LCID lcid, WORD flags,
+                                     DISPPARAMS *params, VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr)
+{
+    return E_NOTIMPL;
+}
