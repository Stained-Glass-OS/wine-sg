+static HRESULT WINAPI trigger_get_Type(ITrigger *iface, TASK_TRIGGER_TYPE2 *type)
+{
+    if (!type) return E_POINTER;
+    *type = impl_from_ITrigger(iface)->type;
+    return S_OK;
+}
+
+static HRESULT WINAPI trigger_get_Id(ITrigger *iface, BSTR *id)
+{
+    return get_string(impl_from_ITrigger(iface)->id, id);
+}
