+{
+    return put_string(&impl_from_ITrigger(iface)->id, id);
+}
+
+static HRESULT WINAPI trigger_get_Repetition(ITrigger *iface, IRepetitionPattern **repeat)
+{
+    struct trigger *trigger = impl_from_ITrigger(iface);
+    HRESULT hr;
+
+    if (!repeat) return E_POINTER;
+    if (!trigger->repetition && FAILED(hr = repetition_create(&trigger->repetition))) return hr;
+    IRepetitionPattern_AddRef(*repeat = &trigger->repetition->IRepetitionPattern_iface);
+    return S_OK;
+}
+
+static HRESULT WINAPI trigger_put_Repetition(ITrigger *iface, IRepetitionPattern *repeat)
+{
+    struct trigger *trigger = impl_from_ITrigger(iface);
+    VARIANT_BOOL stop = VARIANT_FALSE;
+    BSTR interval = NULL, duration = NULL;
+    HRESULT hr;
+
+    TRACE("%p,%p\n", iface, repeat);
+
+    if (!repeat) return E_POINTER;
+    if (!trigger->repetition && FAILED(hr = repetition_create(&trigger->repetition))) return hr;
+    if (repeat == &trigger->repetition->IRepetitionPattern_iface) return S_OK;
+    /* the values are taken, as on Windows: the pattern given stays the caller's */
+    IRepetitionPattern_get_Interval(repeat, &interval);
+    IRepetitionPattern_get_Duration(repeat, &duration);
+    IRepetitionPattern_get_StopAtDurationEnd(repeat, &stop);
+    put_string(&trigger->repetition->interval, interval);
+    put_string(&trigger->repetition->duration, duration);
+    trigger->repetition->stop_at_end = !!stop;
+    SysFreeString(interval);
+    SysFreeString(duration);
+    return S_OK;
+}
