From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernel32: Fail pipe session ids on an unconnected end.

GetNamedPipeClientSessionId and GetNamedPipeServerSessionId give the session
of the process at that end of the pipe, and fail like
GetNamedPipeClientProcessId/ServerProcessId when that end is not connected
(ERROR_NOT_FOUND on a disconnected server, ERROR_PIPE_NOT_CONNECTED on its
client). They always succeeded with the caller's session. Removes six
todo_wine in the kernel32 pipe test.

Gate: test/kernel32-pipesession-gate.sh (64/32).
---
 dlls/kernel32/sync.c       | 20 ++++++++++++++++++--
 dlls/kernel32/tests/pipe.c | 12 ++++++------
 2 files changed, 24 insertions(+), 8 deletions(-)

diff --git a/dlls/kernel32/sync.c b/dlls/kernel32/sync.c
index e1d7980..2a7dfe3 100644
--- a/dlls/kernel32/sync.c
+++ b/dlls/kernel32/sync.c
@@ -602,7 +602,9 @@ BOOL WINAPI GetNamedPipeServerProcessId( HANDLE pipe, ULONG *id )
  */
 BOOL WINAPI GetNamedPipeClientSessionId( HANDLE pipe, ULONG *id )
 {
-    FIXME( "%p, %p\n", pipe, id );
+    ULONG pid;
+
+    TRACE( "%p, %p\n", pipe, id );
 
 #ifndef SG_MUTANT_NO_PIPE_NULL
     if (!id)
@@ -610,6 +612,12 @@ BOOL WINAPI GetNamedPipeClientSessionId( HANDLE pipe, ULONG *id )
         SetLastError( ERROR_INSUFFICIENT_BUFFER );
         return FALSE;
     }
+#endif
+#ifndef SG_MUTANT_PIPE_SESSION_UNCONNECTED
+    /* the session of the process at that end: fails like the process id
+     * when that end is not connected */
+    if (!GetNamedPipeClientProcessId( pipe, &pid )) return FALSE;
+    if (ProcessIdToSessionId( pid, id )) return TRUE;
 #endif
     *id = NtCurrentTeb()->Peb->SessionId;
     return TRUE;
@@ -620,7 +628,9 @@ BOOL WINAPI GetNamedPipeClientSessionId( HANDLE pipe, ULONG *id )
  */
 BOOL WINAPI GetNamedPipeServerSessionId( HANDLE pipe, ULONG *id )
 {
-    FIXME( "%p, %p\n", pipe, id );
+    ULONG pid;
+
+    TRACE( "%p, %p\n", pipe, id );
 
 #ifndef SG_MUTANT_NO_PIPE_NULL
     if (!id)
@@ -628,6 +638,12 @@ BOOL WINAPI GetNamedPipeServerSessionId( HANDLE pipe, ULONG *id )
         SetLastError( ERROR_INSUFFICIENT_BUFFER );
         return FALSE;
     }
+#endif
+#ifndef SG_MUTANT_PIPE_SESSION_UNCONNECTED
+    /* the session of the process at that end: fails like the process id
+     * when that end is not connected */
+    if (!GetNamedPipeServerProcessId( pipe, &pid )) return FALSE;
+    if (ProcessIdToSessionId( pid, id )) return TRUE;
 #endif
     *id = NtCurrentTeb()->Peb->SessionId;
     return TRUE;
diff --git a/dlls/kernel32/tests/pipe.c b/dlls/kernel32/tests/pipe.c
index 53785bd..be40c0f 100644
--- a/dlls/kernel32/tests/pipe.c
+++ b/dlls/kernel32/tests/pipe.c
@@ -3662,8 +3662,8 @@ static void test_namedpipe_session_id(void)
 
     SetLastError(0xdeadbeef);
     ret = pGetNamedPipeClientSessionId(server, &id);
-    todo_wine ok(!ret, "success\n");
-    todo_wine ok(GetLastError() == ERROR_NOT_FOUND, "got %lu\n", GetLastError());
+    ok(!ret, "success\n");
+    ok(GetLastError() == ERROR_NOT_FOUND, "got %lu\n", GetLastError());
 
     id = 0;
     ret = pGetNamedPipeServerSessionId(server, &id);
@@ -3672,13 +3672,13 @@ static void test_namedpipe_session_id(void)
 
     SetLastError(0xdeadbeef);
     ret = pGetNamedPipeClientSessionId(client, &id);
-    todo_wine ok(!ret, "success\n");
-    todo_wine ok(GetLastError() == ERROR_PIPE_NOT_CONNECTED, "got %lu\n", GetLastError());
+    ok(!ret, "success\n");
+    ok(GetLastError() == ERROR_PIPE_NOT_CONNECTED, "got %lu\n", GetLastError());
 
     SetLastError(0xdeadbeef);
     ret = pGetNamedPipeServerSessionId(client, &id);
-    todo_wine ok(!ret, "success\n");
-    todo_wine ok(GetLastError() == ERROR_PIPE_NOT_CONNECTED, "got %lu\n", GetLastError());
+    ok(!ret, "success\n");
+    ok(GetLastError() == ERROR_PIPE_NOT_CONNECTED, "got %lu\n", GetLastError());
     CloseHandle(client);
     CloseHandle(server);
 
