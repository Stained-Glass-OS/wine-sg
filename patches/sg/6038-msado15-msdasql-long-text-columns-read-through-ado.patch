From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msado15, msdasql: Long text columns read through ADO (6038)

ADO binds a long column (SQL_WLONGVARCHAR: SQLite's TEXT, memo fields)
as DBTYPE_IUNKNOWN with an ISequentialStream storage object. MSDASQL
refused that binding, so the recordset failed to load and every value
read empty. MSDASQL now keeps the binding's storage object and gives an
ISequentialStream over the value; ADO's reader grows its buffer for
any read size; the field reports adLongVarWChar/adLongVarChar/
adLongVarBinary as ADO does. GetBindings hands out copies of the
storage objects.
---
diff --git a/dlls/msado15/recordset.c b/dlls/msado15/recordset.c
index 312157e..3e64963 100644
--- a/dlls/msado15/recordset.c
+++ b/dlls/msado15/recordset.c
@@ -3106,8 +3106,20 @@ static HRESULT create_bindings(IUnknown *rowset, struct recordset *recordset, DB
                   colinfo[i].dwFlags, colinfo[i].ulColumnSize, colinfo[i].wType,
                   colinfo[i].bPrecision, colinfo[i].bScale);
 
-            hr = append_field(recordset->fields, colinfo[i].pwszName, colinfo[i].wType, colinfo[i].ulColumnSize,
-                     colinfo[i].dwFlags, NULL);
+            {
+                /* Stained Glass OS: a long column's ADO type is the long one (adLongVarWChar...) */
+                DataTypeEnum type = colinfo[i].wType;
+#ifndef SG_MUTANT_ADO_LONG_TYPE
+                if (colinfo[i].dwFlags & DBCOLUMNFLAGS_ISLONG)
+                {
+                    if (colinfo[i].wType == DBTYPE_WSTR) type = adLongVarWChar;
+                    else if (colinfo[i].wType == DBTYPE_STR) type = adLongVarChar;
+                    else if (colinfo[i].wType == DBTYPE_BYTES) type = adLongVarBinary;
+                }
+#endif
+                hr = append_field(recordset->fields, colinfo[i].pwszName, type, colinfo[i].ulColumnSize,
+                         colinfo[i].dwFlags, NULL);
+            }
 
             bindings[i].iOrdinal = colinfo[i].iOrdinal;
             bindings[i].obValue = offset;
@@ -3265,15 +3277,18 @@ static HRESULT load_all_recordset_data(struct recordset *recordset, IUnknown *ro
                         hr2 = ISequentialStream_Read(seq, unkdata, sizeof(unkdata), &dataRead);
                         if (FAILED(hr2) || !dataRead) break;
 
-                        total += dataRead;
-                        memcpy(p, unkdata, dataRead);
-                        p += dataRead;
-                        if (total == size)
+                        /* Stained Glass OS: room for what was read (a read can be shorter than asked) */
+                        if (total + dataRead > size)
                         {
-                            size *= 2;  /* Double buffer */
-                            buffer = realloc(buffer, size);
+                            char *grown;
+                            while (total + dataRead > size) size *= 2;
+                            if (!(grown = realloc(buffer, size))) break;
+                            buffer = grown;
                             p = buffer + total;
                         }
+                        total += dataRead;
+                        memcpy(p, unkdata, dataRead);
+                        p += dataRead;
                     } while(hr2 == S_OK);
 
                     if (recordset->columntypes[datacol] == DBTYPE_WSTR)
diff --git a/dlls/msdasql/msdasql_private.h b/dlls/msdasql/msdasql_private.h
index 6dd2e8e..ce409a3 100644
--- a/dlls/msdasql/msdasql_private.h
+++ b/dlls/msdasql/msdasql_private.h
@@ -24,6 +24,7 @@ struct rt_accessor
     DBACCESSORFLAGS flags;
     DBCOUNTITEM count;
     DBBINDING *bindings;
+    DBOBJECT *objects;      /* the storage objects of DBTYPE_IUNKNOWN bindings */
     DBLENGTH row_size;
     LONG refs;
 };
diff --git a/dlls/msdasql/rowset.c b/dlls/msdasql/rowset.c
index 49023c3..5c81ee1 100644
--- a/dlls/msdasql/rowset.c
+++ b/dlls/msdasql/rowset.c
@@ -134,9 +134,15 @@ HRESULT rt_create_accessor(struct rowtable *rt, DBACCESSORFLAGS flags, DBCOUNTIT
         else if ((b->dwPart & DBPART_VALUE) && !b->wType)
             st = DBBINDSTATUS_BADBINDINFO;
         /* Stained Glass OS: pObject is for DBTYPE_IUNKNOWN bindings only, and
-         * ignored for the others (ADO sets it for all of them) */
-        else if (b->pObject && (b->wType & ~DBTYPE_BYREF) == DBTYPE_IUNKNOWN)
-            st = DBBINDSTATUS_BADBINDINFO;
+         * ignored for the others (ADO sets it for all of them); the storage object a
+         * DBTYPE_IUNKNOWN binding asks for is an ISequentialStream over the value (how ADO
+         * reads long columns) */
+        else if (b->pObject && (b->wType & ~DBTYPE_BYREF) == DBTYPE_IUNKNOWN &&
+#ifndef SG_MUTANT_DASQL_NO_STREAM
+                 !IsEqualIID(&b->pObject->iid, &IID_ISequentialStream) && !IsEqualIID(&b->pObject->iid, &IID_IStream) &&
+#endif
+                 TRUE)
+            st = DBBINDSTATUS_NOINTERFACE;
         else if (rt->ncols && (flags & DBACCESSOR_ROWDATA) && (b->dwPart & DBPART_VALUE))
         {
             IDataConvert *conv = get_converter(rt);
@@ -161,13 +167,20 @@ HRESULT rt_create_accessor(struct rowtable *rt, DBACCESSORFLAGS flags, DBCOUNTIT
     if (count)
     {
         acc->bindings = malloc(count * sizeof(*acc->bindings));
-        if (!acc->bindings) { free(acc); return E_OUTOFMEMORY; }
+        acc->objects = calloc(count, sizeof(*acc->objects));
+        if (!acc->bindings || !acc->objects) { free(acc->bindings); free(acc->objects); free(acc); return E_OUTOFMEMORY; }
         memcpy(acc->bindings, bindings, count * sizeof(*acc->bindings));
         for (i = 0; i < count; i++)
         {
             acc->bindings[i].pTypeInfo = NULL;
-            acc->bindings[i].pObject = NULL;
             acc->bindings[i].pBindExt = NULL;
+            /* Stained Glass OS: a DBTYPE_IUNKNOWN binding keeps its storage object */
+            if (bindings[i].pObject && bindings[i].wType == DBTYPE_IUNKNOWN)
+            {
+                acc->objects[i] = *bindings[i].pObject;
+                acc->bindings[i].pObject = &acc->objects[i];
+            }
+            else acc->bindings[i].pObject = NULL;
         }
     }
 
@@ -181,6 +194,7 @@ HRESULT rt_create_accessor(struct rowtable *rt, DBACCESSORFLAGS flags, DBCOUNTIT
         {
             LeaveCriticalSection(&rt->cs);
             free(acc->bindings);
+            free(acc->objects);
             free(acc);
             return E_OUTOFMEMORY;
         }
@@ -234,6 +248,7 @@ HRESULT rt_release_accessor(struct rowtable *rt, HACCESSOR h, DBREFCOUNT *count)
         if (!--acc->refs)
         {
             free(acc->bindings);
+            free(acc->objects);
             free(acc);
             rt->acc[h - 1] = NULL;
         }
@@ -260,7 +275,19 @@ HRESULT rt_get_bindings(struct rowtable *rt, HACCESSOR h, DBACCESSORFLAGS *flags
         if (acc->count)
         {
             *bindings = CoTaskMemAlloc(acc->count * sizeof(**bindings));
-            if (*bindings) memcpy(*bindings, acc->bindings, acc->count * sizeof(**bindings));
+            if (*bindings)
+            {
+                DBCOUNTITEM i;
+
+                memcpy(*bindings, acc->bindings, acc->count * sizeof(**bindings));
+                /* the caller frees each binding's storage object (CoTaskMemFree) */
+                for (i = 0; i < acc->count; i++)
+                {
+                    if (!acc->bindings[i].pObject) continue;
+                    if (((*bindings)[i].pObject = CoTaskMemAlloc(sizeof(DBOBJECT))))
+                        *(*bindings)[i].pObject = *acc->bindings[i].pObject;
+                }
+            }
             else hr = E_OUTOFMEMORY;
         }
         if (hr == S_OK)
@@ -510,6 +537,26 @@ HRESULT rt_get_data(struct rowtable *rt, HROW hrow, HACCESSOR hacc, void *data)
             dst_status = DBSTATUS_S_ISNULL;
             dst_len = 0;
         }
+        else if ((b->dwPart & DBPART_VALUE) && b->pObject && b->wType == DBTYPE_IUNKNOWN)
+        {
+            /* the value as a stream (a long column): its bytes, as the column's type has them */
+            IStream *stream = NULL;
+            LARGE_INTEGER zero = {{ 0 }};
+
+            if (SUCCEEDED(chr = CreateStreamOnHGlobal(NULL, TRUE, &stream)) &&
+                SUCCEEDED(chr = IStream_Write(stream, cell->data, cell->len, NULL)) &&
+                SUCCEEDED(chr = IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL)))
+            {
+                chr = IStream_QueryInterface(stream, &b->pObject->iid, (void **)(base + b->obValue));
+            }
+            if (stream) IStream_Release(stream);
+            if (FAILED(chr))
+            {
+                dst_status = DBSTATUS_E_CANTCREATE;
+                bad++;
+            }
+            dst_len = cell->len;
+        }
         else if (b->dwPart & DBPART_VALUE)
         {
             DBLENGTH maxlen = b->cbMaxLen;
