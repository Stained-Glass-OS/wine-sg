+/* Stained Glass OS: the Fonts folder (shell:fonts, its CLSID, or the
+ * %WINDIR%\Fonts path) opens the Fonts view of the program App Paths
+ * registers for fontview.exe, as Windows shows fonts in a view of their own
+ * rather than as files. Returns FALSE (a plain folder) when none is. */
+static BOOL open_fonts_folder(const WCHAR *root)
+{
+    WCHAR fonts[MAX_PATH], full[MAX_PATH], target[MAX_PATH];
+    DWORD cb = sizeof(target);
+    SHELLEXECUTEINFOW sei = { sizeof(sei) };
+
+    if (!root || !root[0]) return FALSE;
+    if (wcsicmp(root, L"shell:fonts") && wcsicmp(root, L"shell:::{BD84B380-8CA2-1069-AB1D-08000948F534}") &&
+        wcsicmp(root, L"::{BD84B380-8CA2-1069-AB1D-08000948F534}"))
+    {
+        if (FAILED(SHGetFolderPathW(NULL, CSIDL_FONTS, NULL, SHGFP_TYPE_CURRENT, fonts))) return FALSE;
+        if (!GetFullPathNameW(root, MAX_PATH, full, NULL)) return FALSE;
+        PathRemoveBackslashW(full);
+        if (wcsicmp(full, fonts)) return FALSE;
+    }
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\fontview.exe",
+                     NULL, RRF_RT_REG_SZ, NULL, target, &cb)) return FALSE;
+    sei.fMask = SEE_MASK_FLAG_NO_UI;
+    sei.lpFile = target;
+    sei.lpParameters = L"/folder";
+    sei.nShow = SW_SHOWNORMAL;
+    return ShellExecuteExW(&sei);
+}
