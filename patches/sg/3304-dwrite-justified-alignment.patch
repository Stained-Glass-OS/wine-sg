From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 03:04:06 -0700
Subject: [PATCH] dwrite: justified text alignment (3304)

CORE review: text layout.

DWRITE_TEXT_ALIGNMENT_JUSTIFIED logged a FIXME and laid text out as
leading alignment. A line that wraps and is not the last one of its
paragraph is now widened to the layout width: the room left is shared by
its blanks (space, no-break space, ideographic space), or by the edges
between kana and ideographs when it has no blanks. The last line of a
paragraph (before a line break or at the end of the text), a trimmed line
and a line with nothing to stretch stay natural. The widening is in the
glyph advances of the effective runs (a run has advances of its own when
it was widened), so drawing, ink boxes, underlines and strikethrough,
hit testing and cluster positions follow it; the line metrics and the
text metrics keep the natural widths. Switching to or from justified
alignment rebuilds the lines.

Test: test/fastdwjust-gate.sh (mutants SG_MUTANT_DWJ_*).

diff --git a/dlls/dwrite/layout.c b/dlls/dwrite/layout.c
index eee2a6f..7007baa 100644
--- a/dlls/dwrite/layout.c
+++ b/dlls/dwrite/layout.c
@@ -162,6 +162,7 @@ struct layout_effective_run {
     FLOAT align_dx;         /* adjustment from text alignment */
     FLOAT width;            /* run width */
     UINT16 *clustermap;     /* effective clustermap, allocated separately, is not reused from nominal map */
+    float *advances;        /* the glyph advances when justified text widened some, else NULL (the nominal run's) */
     UINT32 line;            /* 0-based line index in line metrics array */
     BOOL underlined;        /* set if this run is underlined */
     D2D1_RECT_F bbox;       /* ink run box, top == bottom means it wasn't estimated yet */
@@ -255,6 +256,7 @@ struct dwrite_textlayout
 
     struct layout_cluster *clusters;
     DWRITE_CLUSTER_METRICS *clustermetrics;
+    float *justify_extra;       /* width justified text adds to a cluster, NULL when no line was justified */
     UINT32 cluster_count;
     FLOAT  minwidth;
 
@@ -362,8 +364,11 @@ static void free_layout_eruns(struct dwrite_textlayout *layout)
     {
         list_remove(&cur->entry);
         free(cur->clustermap);
+        free(cur->advances);
         free(cur);
     }
+    free(layout->justify_extra);
+    layout->justify_extra = NULL;
 
     LIST_FOR_EACH_ENTRY_SAFE(in, in2, &layout->inlineobjects, struct layout_effective_inline, entry)
     {
@@ -1371,7 +1376,7 @@ static inline float get_cluster_range_width(const struct dwrite_textlayout *layo
 {
     float width = 0.0f;
     for (; start < end; start++)
-        width += layout->clustermetrics[start].width;
+        width += layout->clustermetrics[start].width + (layout->justify_extra ? layout->justify_extra[start] : 0.0f);
     return width;
 }
 
@@ -1523,6 +1528,35 @@ static HRESULT layout_add_effective_run(struct dwrite_textlayout *layout, const
     for (i = 0; i < length; i++)
         run->clustermap[i] = r->u.regular.clustermap[start + i] - r->u.regular.clustermap[start];
 
+    /* justified text widens some clusters: the run then has advances of its own */
+    run->advances = NULL;
+    if (layout->justify_extra && run->glyphcount)
+    {
+        BOOL widened = FALSE;
+
+        for (i = first_cluster; i <= last_cluster; i++)
+            if (layout->justify_extra[i]) widened = TRUE;
+
+        if (widened
+#ifdef SG_MUTANT_DWJ_NOADV
+                && 0
+#endif
+                && (run->advances = malloc(run->glyphcount * sizeof(*run->advances))))
+        {
+            memcpy(run->advances, &r->u.regular.run.glyphAdvances[r->u.regular.clustermap[start]],
+                    run->glyphcount * sizeof(*run->advances));
+            for (i = first_cluster; i <= last_cluster; i++)
+            {
+                UINT32 glyph;
+
+                if (!layout->justify_extra[i]) continue;
+                glyph = run->clustermap[layout->clusters[i].position - start];
+                if (glyph < run->glyphcount)
+                    run->advances[glyph] += layout->justify_extra[i];
+            }
+        }
+    }
+
     run->effect = params->effect;
     run->underlined = params->underline;
     list_add_tail(&layout->eruns, &run->entry);
@@ -1812,7 +1846,8 @@ static void layout_apply_text_alignment(struct dwrite_textlayout *layout)
         layout_apply_centered_alignment(layout);
         break;
     case DWRITE_TEXT_ALIGNMENT_JUSTIFIED:
-        FIXME("alignment %d not implemented\n", layout->format.textalignment);
+        /* the lines were widened when they were built, the rest is leading alignment */
+        layout_apply_leading_alignment(layout);
         break;
     default:
         ;
@@ -2012,9 +2047,69 @@ static HRESULT layout_set_dummy_line_metrics(struct dwrite_textlayout *layout)
     return layout_set_line_metrics(layout, &metrics);
 }
 
+static BOOL layout_cluster_is_blank(const struct dwrite_textlayout *layout, UINT32 cluster)
+{
+    const struct layout_cluster *lc = &layout->clusters[cluster];
+    WCHAR ch;
+
+    if (lc->run->kind != LAYOUT_RUN_REGULAR) return FALSE;
+    ch = lc->run->u.regular.descr.string[lc->position];
+#ifdef SG_MUTANT_DWJ_ALLCLUSTERS
+    return TRUE;
+#endif
+    return ch == ' ' || ch == 0xa0 || ch == 0x3000;
+}
+
+static BOOL layout_cluster_is_ideograph(const struct dwrite_textlayout *layout, UINT32 cluster)
+{
+    const struct layout_cluster *lc = &layout->clusters[cluster];
+    WCHAR ch;
+
+    if (lc->run->kind != LAYOUT_RUN_REGULAR) return FALSE;
+    ch = lc->run->u.regular.descr.string[lc->position];
+    /* kana, the CJK ideographs and the compatibility ideographs */
+    return (ch >= 0x3040 && ch <= 0x30ff) || (ch >= 0x3400 && ch <= 0x4dbf)
+            || (ch >= 0x4e00 && ch <= 0x9fff) || (ch >= 0xf900 && ch <= 0xfaff);
+}
+
+/* Justified alignment: the room left on a line that wraps is shared by its blanks, or by
+ * the edges between ideographs when it has no blanks. The last line of a paragraph is not
+ * stretched, nor is a line that does not fill the layout width. */
+static void layout_justify_line(struct dwrite_textlayout *layout, UINT32 first_cluster, UINT32 last_cluster,
+        float width)
+{
+    float room = layout->metrics.layoutWidth - width, each;
+    UINT32 i, blanks = 0, edges = 0;
+
+    if (!(room > 0.0f) || !isfinite(room)) return;
+
+    for (i = first_cluster; i <= last_cluster; i++)
+        if (layout_cluster_is_blank(layout, i)) blanks++;
+#ifndef SG_MUTANT_DWJ_NOIDEO
+    if (!blanks)
+        for (i = first_cluster; i < last_cluster; i++)
+#else
+    if (0)
+        for (i = first_cluster; i < last_cluster; i++)
+#endif
+            if (layout_cluster_is_ideograph(layout, i)) edges++;
+    if (!blanks && !edges) return;
+
+    if (!layout->justify_extra && !(layout->justify_extra = calloc(layout->cluster_count, sizeof(*layout->justify_extra))))
+        return;
+
+    each = room / (blanks ? blanks : edges);
+    for (i = first_cluster; i <= last_cluster; i++)
+    {
+        if (blanks ? layout_cluster_is_blank(layout, i) : (i < last_cluster && layout_cluster_is_ideograph(layout, i)))
+            layout->justify_extra[i] = each;
+    }
+}
+
 static void layout_add_line(struct dwrite_textlayout *layout, UINT32 first_cluster, UINT32 last_cluster,
         UINT32 *textpos)
 {
+    UINT32 line_end = last_cluster;
     BOOL is_rtl = layout->format.readingdir == DWRITE_READING_DIRECTION_RIGHT_TO_LEFT;
     struct layout_final_splitting_params params, prev_params;
     DWRITE_INLINE_OBJECT_METRICS sign_metrics = { 0 };
@@ -2095,6 +2190,21 @@ static void layout_add_line(struct dwrite_textlayout *layout, UINT32 first_clust
         width = trimmed_width + sign_metrics.width;
     }
 
+    /* a line that wraps, and is not the last one of its paragraph, is widened to the layout width */
+    if (layout->format.textalignment == DWRITE_TEXT_ALIGNMENT_JUSTIFIED
+#ifndef SG_MUTANT_DWJ_NOWRAPCHECK
+            && layout->format.wrapping != DWRITE_WORD_WRAPPING_NO_WRAP
+#endif
+            && !append_trimming_run
+#ifndef SG_MUTANT_DWJ_NEWLINE
+            && !metrics.newlineLength
+#endif
+#ifndef SG_MUTANT_DWJ_LASTLINE
+            && line_end + 1 < layout->cluster_count
+#endif
+            )
+        layout_justify_line(layout, first_cluster, last_cluster, width);
+
     layout_splitting_params_from_pos(layout, pos, &params);
     prev_params = params;
     run = layout->clusters[first_cluster].run;
@@ -3719,7 +3829,7 @@ static HRESULT WINAPI dwritetextlayout_Draw(IDWriteTextLayout4 *iface,
 
         /* fixup glyph data arrays */
         glyph_run.glyphIndices += start_glyph;
-        glyph_run.glyphAdvances += start_glyph;
+        glyph_run.glyphAdvances = run->advances ? run->advances : glyph_run.glyphAdvances + start_glyph;
         glyph_run.glyphOffsets += start_glyph;
 
         /* description */
@@ -3873,7 +3983,7 @@ static void layout_get_erun_bbox(struct dwrite_textlayout *layout, struct layout
         glyph_run = regular->run;
         glyph_run.glyphCount = run->glyphcount;
         glyph_run.glyphIndices = &regular->run.glyphIndices[start_glyph];
-        glyph_run.glyphAdvances = &regular->run.glyphAdvances[start_glyph];
+        glyph_run.glyphAdvances = run->advances ? run->advances : &regular->run.glyphAdvances[start_glyph];
         glyph_run.glyphOffsets = &regular->run.glyphOffsets[start_glyph];
 
         memset(&glyph_bitmap, 0, sizeof(glyph_bitmap));
@@ -4172,7 +4282,11 @@ static HRESULT layout_get_hit_segments(struct dwrite_textlayout *layout, UINT32
         for (c = layout_find_cluster(layout, run_start); c < layout->cluster_count; ++c)
         {
             UINT32 pos = layout_cluster_text_position(layout, c);
+#ifdef SG_MUTANT_DWJ_NOHIT
             float width = layout->clustermetrics[c].width;
+#else
+            float width = layout->clustermetrics[c].width + (layout->justify_extra ? layout->justify_extra[c] : 0.0f);
+#endif
             UINT32 length = layout->clustermetrics[c].length;
 
             if (pos >= run_end)
@@ -4967,6 +5081,7 @@ static HRESULT WINAPI dwritetextformat_layout_SetTextAlignment(IDWriteTextFormat
         DWRITE_TEXT_ALIGNMENT alignment)
 {
     struct dwrite_textlayout *layout = impl_from_IDWriteTextFormat3(iface);
+    DWRITE_TEXT_ALIGNMENT old = layout->format.textalignment;
     BOOL changed;
     HRESULT hr;
 
@@ -4978,6 +5093,11 @@ static HRESULT WINAPI dwritetextformat_layout_SetTextAlignment(IDWriteTextFormat
 
     if (changed)
     {
+        /* justified lines are built differently */
+#ifndef SG_MUTANT_DWJ_NORECOMPUTE
+        if (old == DWRITE_TEXT_ALIGNMENT_JUSTIFIED || alignment == DWRITE_TEXT_ALIGNMENT_JUSTIFIED)
+            layout->recompute |= RECOMPUTE_LINES;
+#endif
         /* if layout is not ready there's nothing to align */
         if (!(layout->recompute & RECOMPUTE_LINES))
             layout_apply_text_alignment(layout);
