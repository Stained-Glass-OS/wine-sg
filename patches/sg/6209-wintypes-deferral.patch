From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wintypes: Windows.Foundation.Deferral

Windows.Foundation.Deferral had no factory: OneDrive (React Native for Windows) makes deferrals and, refused, tried again and again (hundreds of hresult_no_interface throws). DeferralFactory.Create keeps its handler; Complete runs it once and lets it go; Close lets it go unrun.
---
diff --git a/dlls/wintypes/main.c b/dlls/wintypes/main.c
index d216b54..f443bc8 100644
--- a/dlls/wintypes/main.c
+++ b/dlls/wintypes/main.c
@@ -98,6 +98,7 @@ struct wintypes
     IActivationFactory IActivationFactory_iface;
     IApiInformationStatics IApiInformationStatics_iface;
     IPropertyValueStatics IPropertyValueStatics_iface;
+    IDeferralFactory IDeferralFactory_iface;
     LONG ref;
 };
 
@@ -137,6 +138,15 @@ static HRESULT STDMETHODCALLTYPE wintypes_QueryInterface(IActivationFactory *ifa
         return S_OK;
     }
 
+#ifndef SG_MUTANT_NO_DEFERRAL_FACTORY
+    if (IsEqualGUID(iid, &IID_IDeferralFactory))
+    {
+        IUnknown_AddRef(iface);
+        *out = &impl->IDeferralFactory_iface;
+        return S_OK;
+    }
+#endif
+
     WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
     *out = NULL;
     return E_NOINTERFACE;
@@ -1438,11 +1448,168 @@ static const struct IPropertyValueStaticsVtbl property_value_statics_vtbl =
     property_value_statics_CreateRectArray,
 };
 
+/*
+ * Windows.Foundation.Deferral: Complete runs its handler once; Close lets the handler go unrun.
+ */
+
+struct deferral
+{
+    IDeferral IDeferral_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    IDeferralCompletedHandler *handler;   /* until completed or closed */
+};
+
+static inline struct deferral *impl_from_IDeferral(IDeferral *iface)
+{
+    return CONTAINING_RECORD(iface, struct deferral, IDeferral_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE deferral_QueryInterface(IDeferral *iface, REFIID iid, void **out)
+{
+    struct deferral *impl = impl_from_IDeferral(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+            IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IDeferral))
+        *out = &impl->IDeferral_iface;
+    else if (IsEqualGUID(iid, &IID_IClosable))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG STDMETHODCALLTYPE deferral_AddRef(IDeferral *iface)
+{
+    return InterlockedIncrement(&impl_from_IDeferral(iface)->ref);
+}
+
+static ULONG STDMETHODCALLTYPE deferral_Release(IDeferral *iface)
+{
+    struct deferral *impl = impl_from_IDeferral(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+
+    if (!ref)
+    {
+        if (impl->handler) IDeferralCompletedHandler_Release(impl->handler);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE deferral_GetIids(IDeferral *iface, ULONG *iid_count, IID **iids)
+{
+    FIXME("iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids);
+    return E_NOTIMPL;
+}
+
+static HRESULT STDMETHODCALLTYPE deferral_GetRuntimeClassName(IDeferral *iface, HSTRING *class_name)
+{
+    return WindowsCreateString(L"Windows.Foundation.Deferral", 27, class_name);
+}
+
+static HRESULT STDMETHODCALLTYPE deferral_GetTrustLevel(IDeferral *iface, TrustLevel *trust_level)
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE deferral_Complete(IDeferral *iface)
+{
+    struct deferral *impl = impl_from_IDeferral(iface);
+    IDeferralCompletedHandler *handler;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p.\n", iface);
+
+    if ((handler = InterlockedExchangePointer((void **)&impl->handler, NULL)))
+    {
+        hr = IDeferralCompletedHandler_Invoke(handler);
+        IDeferralCompletedHandler_Release(handler);
+    }
+    return hr;
+}
+
+static const struct IDeferralVtbl deferral_vtbl =
+{
+    deferral_QueryInterface,
+    deferral_AddRef,
+    deferral_Release,
+    deferral_GetIids,
+    deferral_GetRuntimeClassName,
+    deferral_GetTrustLevel,
+    deferral_Complete,
+};
+
+DEFINE_IINSPECTABLE(deferral_closable, IClosable, struct deferral, IDeferral_iface)
+
+static HRESULT STDMETHODCALLTYPE deferral_closable_Close(IClosable *iface)
+{
+    struct deferral *impl = impl_from_IClosable(iface);
+    IDeferralCompletedHandler *handler;
+
+    TRACE("iface %p.\n", iface);
+
+    if ((handler = InterlockedExchangePointer((void **)&impl->handler, NULL)))
+        IDeferralCompletedHandler_Release(handler);
+    return S_OK;
+}
+
+static const struct IClosableVtbl deferral_closable_vtbl =
+{
+    deferral_closable_QueryInterface,
+    deferral_closable_AddRef,
+    deferral_closable_Release,
+    deferral_closable_GetIids,
+    deferral_closable_GetRuntimeClassName,
+    deferral_closable_GetTrustLevel,
+    deferral_closable_Close,
+};
+
+DEFINE_IINSPECTABLE(deferral_factory, IDeferralFactory, struct wintypes, IActivationFactory_iface)
+
+static HRESULT STDMETHODCALLTYPE deferral_factory_Create(IDeferralFactory *iface, IDeferralCompletedHandler *handler,
+        IDeferral **result)
+{
+    struct deferral *impl;
+
+    TRACE("iface %p, handler %p, result %p.\n", iface, handler, result);
+
+    if (!result) return E_POINTER;
+    if (!handler) return E_INVALIDARG;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IDeferral_iface.lpVtbl = &deferral_vtbl;
+    impl->IClosable_iface.lpVtbl = &deferral_closable_vtbl;
+    impl->ref = 1;
+    IDeferralCompletedHandler_AddRef((impl->handler = handler));
+    *result = &impl->IDeferral_iface;
+    return S_OK;
+}
+
+static const struct IDeferralFactoryVtbl deferral_factory_vtbl =
+{
+    deferral_factory_QueryInterface,
+    deferral_factory_AddRef,
+    deferral_factory_Release,
+    deferral_factory_GetIids,
+    deferral_factory_GetRuntimeClassName,
+    deferral_factory_GetTrustLevel,
+    deferral_factory_Create,
+};
+
 static struct wintypes wintypes =
 {
     {&activation_factory_vtbl},
     {&api_information_statics_vtbl},
     {&property_value_statics_vtbl},
+    {&deferral_factory_vtbl},
     1
 };
 
