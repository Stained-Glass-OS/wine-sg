From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] traffic: Fail as without a traffic control device (6065)

TcRegisterClient checks its arguments and the TCI version, then fails
with ERROR_OPEN_FAILED as when the traffic control device cannot be
opened; the calls on interface, flow and filter handles, which were
stubs, find none.
---
diff --git a/dlls/traffic/traffic.spec b/dlls/traffic/traffic.spec
index ad4bce0..3b754a2 100644
--- a/dlls/traffic/traffic.spec
+++ b/dlls/traffic/traffic.spec
@@ -1,21 +1,21 @@
 @ stub TcAddClassMap
-@ stub TcAddFilter
-@ stub TcAddFlow
-@ stub TcCloseInterface
-@ stub TcDeleteFilter
-@ stub TcDeleteFlow
+@ stdcall TcAddFilter(ptr ptr ptr)
+@ stdcall TcAddFlow(ptr ptr long ptr ptr)
+@ stdcall TcCloseInterface(ptr)
+@ stdcall TcDeleteFilter(ptr)
+@ stdcall TcDeleteFlow(ptr)
 @ stdcall TcDeregisterClient(ptr)
-@ stub TcEnumerateFlows
-@ stub TcEnumerateInterfaces
-@ stub TcGetFlowNameA
-@ stub TcGetFlowNameW
-@ stub TcModifyFlow
-@ stub TcOpenInterfaceA
-@ stub TcOpenInterfaceW
-@ stub TcQueryFlowA
-@ stub TcQueryFlowW
-@ stub TcQueryInterface
+@ stdcall TcEnumerateFlows(ptr ptr ptr ptr ptr)
+@ stdcall TcEnumerateInterfaces(ptr ptr ptr)
+@ stdcall TcGetFlowNameA(ptr long ptr)
+@ stdcall TcGetFlowNameW(ptr long ptr)
+@ stdcall TcModifyFlow(ptr ptr)
+@ stdcall TcOpenInterfaceA(str ptr ptr ptr)
+@ stdcall TcOpenInterfaceW(wstr ptr ptr ptr)
+@ stdcall TcQueryFlowA(str ptr ptr ptr)
+@ stdcall TcQueryFlowW(wstr ptr ptr ptr)
+@ stdcall TcQueryInterface(ptr ptr long ptr ptr)
 @ stdcall TcRegisterClient(long ptr ptr ptr)
-@ stub TcSetFlowA
-@ stub TcSetFlowW
-@ stub TcSetInterface
+@ stdcall TcSetFlowA(str ptr long ptr)
+@ stdcall TcSetFlowW(wstr ptr long ptr)
+@ stdcall TcSetInterface(ptr ptr long ptr)
diff --git a/dlls/traffic/traffic_main.c b/dlls/traffic/traffic_main.c
index c551d8b..82f4650 100644
--- a/dlls/traffic/traffic_main.c
+++ b/dlls/traffic/traffic_main.c
@@ -26,22 +26,69 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(traffic);
 
+/* Traffic control needs the system's packet classifier device (GPC) and a QoS packet scheduler, which
+ * this system does not have: registering fails as when the device cannot be opened, so no client, interface,
+ * flow or filter handle ever exists and the calls on one find none. */
+
 /*****************************************************************************
  * TcRegisterClient [TRAFFIC.@]
  */
 ULONG WINAPI TcRegisterClient(ULONG version, HANDLE context,
                               PTCI_CLIENT_FUNC_LIST list, PHANDLE buffer)
 {
-    FIXME("(%lu %p %p %p) stub\n", version, context, list, buffer);
-    if(buffer) *buffer = INVALID_HANDLE_VALUE;
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    TRACE("(%lu %p %p %p)\n", version, context, list, buffer);
+    if (!list || !buffer || !list->ClNotifyHandler) return ERROR_INVALID_PARAMETER;
+    *buffer = NULL;
+    if (version != CURRENT_TCI_VERSION) return ERROR_INCOMPATIBLE_TCI_VERSION;
+    /* "Traffic control failed to open a system device" */
+#ifdef SG_MUTANT_TC_REGISTER_OK
+    *buffer = (HANDLE)1;
+    return NO_ERROR;
+#endif
+    return ERROR_OPEN_FAILED;
 }
 
 /*****************************************************************************
  * TcDeregisterClient [TRAFFIC.@]
  */
-ULONG WINAPI TcDeregisterClient(HANDLE ClientHandle)
+ULONG WINAPI TcDeregisterClient(HANDLE client)
 {
-    FIXME("%p: stub\n", ClientHandle);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    TRACE("%p\n", client);
+    return ERROR_INVALID_HANDLE;
 }
+
+/* the calls on an interface, flow or filter handle: there are none */
+#define NO_HANDLE( name, args, call ) \
+    ULONG WINAPI name args \
+    { \
+        TRACE( "%p\n", call ); \
+        return ERROR_INVALID_HANDLE; \
+    }
+
+NO_HANDLE( TcEnumerateInterfaces, (HANDLE client, ULONG *size, void *buffer), client )
+NO_HANDLE( TcOpenInterfaceA, (char *name, HANDLE client, HANDLE context, HANDLE *ifc), client )
+NO_HANDLE( TcOpenInterfaceW, (WCHAR *name, HANDLE client, HANDLE context, HANDLE *ifc), client )
+NO_HANDLE( TcCloseInterface, (HANDLE ifc), ifc )
+NO_HANDLE( TcQueryInterface, (HANDLE ifc, GUID *guid, BOOLEAN notify, ULONG *size, void *buffer), ifc )
+NO_HANDLE( TcSetInterface, (HANDLE ifc, GUID *guid, ULONG size, void *buffer), ifc )
+NO_HANDLE( TcAddFlow, (HANDLE ifc, HANDLE context, ULONG flags, void *flow, HANDLE *handle), ifc )
+NO_HANDLE( TcGetFlowNameA, (HANDLE flow, ULONG size, char *name), flow )
+NO_HANDLE( TcGetFlowNameW, (HANDLE flow, ULONG size, WCHAR *name), flow )
+NO_HANDLE( TcModifyFlow, (HANDLE flow, void *generic), flow )
+NO_HANDLE( TcAddFilter, (HANDLE flow, void *filter, HANDLE *handle), flow )
+NO_HANDLE( TcDeleteFlow, (HANDLE flow), flow )
+NO_HANDLE( TcDeleteFilter, (HANDLE filter), filter )
+NO_HANDLE( TcEnumerateFlows, (HANDLE ifc, HANDLE *enum_handle, ULONG *count, ULONG *size, void *buffer), ifc )
+
+/* with no interface open no flow exists: "The instance name was not found" */
+#define NO_FLOW( name, type, args ) \
+    ULONG WINAPI name args \
+    { \
+        TRACE( "%p\n", flow ); \
+        return flow ? ERROR_WMI_INSTANCE_NOT_FOUND : ERROR_INVALID_PARAMETER; \
+    }
+
+NO_FLOW( TcQueryFlowA, char, (char *flow, GUID *guid, ULONG *size, void *buffer) )
+NO_FLOW( TcQueryFlowW, WCHAR, (WCHAR *flow, GUID *guid, ULONG *size, void *buffer) )
+NO_FLOW( TcSetFlowA, char, (char *flow, GUID *guid, ULONG size, void *buffer) )
+NO_FLOW( TcSetFlowW, WCHAR, (WCHAR *flow, GUID *guid, ULONG size, void *buffer) )
diff --git a/include/traffic.h b/include/traffic.h
index 5ffc1ec..42ad955 100644
--- a/include/traffic.h
+++ b/include/traffic.h
@@ -39,7 +39,15 @@ typedef struct _TCI_CLIENT_FUNC_LIST
     TCI_DEL_FLOW_COMPLETE_HANDLER ClDeleteFlowCompleteHandler;
 } TCI_CLIENT_FUNC_LIST, *PTCI_CLIENT_FUNC_LIST;
 
+#define CURRENT_TCI_VERSION 0x0002
+
+/* tcerror.h */
+#define TCBASE 7500
+#define ERROR_INCOMPATIBLE_TCI_VERSION (TCBASE+1)
+#define ERROR_TOO_MANY_CLIENTS         (TCBASE+21)
+
 ULONG WINAPI TcRegisterClient(ULONG,HANDLE,PTCI_CLIENT_FUNC_LIST,PHANDLE);
+ULONG WINAPI TcDeregisterClient(HANDLE);
 
 #ifdef __cplusplus
 } /* extern "C" */
