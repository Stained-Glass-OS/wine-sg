From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ole32, combase, oleaut32: MonikerRelativePathTo, CoQueryAuthenticationServices, OleLoadPictureFileEx

MonikerRelativePathTo gives the moniker that composed onto the source gives the destination: the inverse of what follows their common prefix of components in the source, then what follows it in the destination; the destination itself (MK_S_HIM) when they share none. CoQueryAuthenticationServices returns the authentication services CoInitializeSecurity registered (COM's NTLM and Negotiate for -1, none before it), which CoInitializeSecurity now keeps. OleLoadPictureFileEx loads a picture file as OleLoadPictureFile does, at the size and with the colour flags asked for. They were spec stubs.
---
--- a/dlls/ole32/compositemoniker.c
+++ b/dlls/ole32/compositemoniker.c
@@ -1919,6 +1919,68 @@
     return S_OK;
 }
 
+#ifndef SG_MUTANT_NO_COM_HELPERS
+/******************************************************************************
+ *        MonikerRelativePathTo	[OLE32.@]
+ *
+ * (wine-sg 8240) The moniker that, composed onto the end of src, gives dest: the inverse of what follows their
+ * common prefix of components in src, then what follows it in dest; dest itself (MK_S_HIM) when they have no
+ * common prefix. For IMoniker::RelativePathTo implementations.
+ */
+HRESULT WINAPI MonikerRelativePathTo(IMoniker *src, IMoniker *dest, IMoniker **relpath, BOOL reserved)
+{
+    IMoniker **components = NULL, **dest_components = NULL, *tail = NULL, *dest_tail = NULL, *inv;
+    unsigned int count, dest_count, n = 0;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p, %d\n", src, dest, relpath, reserved);
+
+    if (!relpath) return E_INVALIDARG;
+    *relpath = NULL;
+    if (!src || !dest) return E_INVALIDARG;
+
+    if (FAILED(hr = composite_get_components_alloc(src, &count, &components))) return hr;
+    if (FAILED(hr = composite_get_components_alloc(dest, &dest_count, &dest_components)))
+    {
+        free(components);
+        return hr;
+    }
+    while (n < min(count, dest_count) && IMoniker_IsEqual(components[n], dest_components[n]) == S_OK) n++;
+
+    if (!n || (n == count && n == dest_count))
+    {
+        *relpath = dest;
+        IMoniker_AddRef(dest);
+        hr = MK_S_HIM;
+        goto done;
+    }
+    if (n < count && SUCCEEDED(hr = composite_compose_components(&components[n], count - n, &tail)))
+    {
+        hr = IMoniker_Inverse(tail, &inv);
+        IMoniker_Release(tail);
+        tail = SUCCEEDED(hr) ? inv : NULL;
+    }
+    if (SUCCEEDED(hr) && n < dest_count)
+        hr = composite_compose_components(&dest_components[n], dest_count - n, &dest_tail);
+    if (SUCCEEDED(hr))
+    {
+        if (tail && dest_tail) hr = CreateGenericComposite(tail, dest_tail, relpath);
+        else if ((*relpath = tail ? tail : dest_tail)) IMoniker_AddRef(*relpath);
+    }
+    if (tail) IMoniker_Release(tail);
+    if (dest_tail) IMoniker_Release(dest_tail);
+done:
+    free(components);
+    free(dest_components);
+    return hr;
+}
+#else
+HRESULT WINAPI MonikerRelativePathTo(IMoniker *src, IMoniker *dest, IMoniker **relpath, BOOL reserved)
+{
+    return E_NOTIMPL;
+}
+#endif
