 /***********************************************************************
+ *           CoQueryAuthenticationServices    (combase.@)
+ *
+ * (wine-sg 8240) The authentication services the process registered with CoInitializeSecurity: those it gave,
+ * or for -1 the ones COM picks (NTLM and Negotiate); none before CoInitializeSecurity. Freed with CoTaskMemFree.
+ */
+#ifndef SG_MUTANT_NO_COM_HELPERS
+HRESULT WINAPI CoQueryAuthenticationServices(DWORD *count, SOLE_AUTHENTICATION_SERVICE **services)
+{
+    static const DWORD defaults[] = { RPC_C_AUTHN_WINNT, RPC_C_AUTHN_GSS_NEGOTIATE };
+    SOLE_AUTHENTICATION_SERVICE *out;
+    DWORD n, i;
+
+    TRACE("%p, %p\n", count, services);
+
+    if (!count || !services) return E_INVALIDARG;
+    *count = 0;
+    *services = NULL;
+    n = com_security.auth_count < 0 ? ARRAY_SIZE(defaults) : com_security.auth_count;
+    if (!n) return S_OK;
+    if (!(out = CoTaskMemAlloc(n * sizeof(*out)))) return E_OUTOFMEMORY;
+    for (i = 0; i < n; i++)
+    {
+        if (com_security.auth_count < 0)
+        {
+            out[i].dwAuthnSvc = defaults[i];
+            out[i].dwAuthzSvc = RPC_C_AUTHZ_NONE;
+            out[i].pPrincipalName = NULL;
+            out[i].hr = S_OK;
+        }
+        else
+        {
+            out[i] = com_security.auth[i];
+            out[i].pPrincipalName = NULL;   /* the caller does not free names: they are not given out */
+        }
+    }
+    *count = n;
+    *services = out;
+    return S_OK;
+}
+#else
+HRESULT WINAPI CoQueryAuthenticationServices(DWORD *count, SOLE_AUTHENTICATION_SERVICE **services) { return E_NOTIMPL; }
+#endif
