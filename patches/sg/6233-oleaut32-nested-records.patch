From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] oleaut32: nested records, enum/alias fields, records passed through Invoke

IRecordInfo only knew fields of base types: a field of a user-defined type (an enum, an alias, an interface or another record) made RecordClear and RecordCopy fail ("Not supported vt = 29") and RecordCopy copied the wrong size, and ITypeInfo::Invoke could not take a record argument (TKIND_RECORD unhandled), so a program passing a structure through a dual interface got garbage where the structure should be (OneDrive's sync setup crashed reading it). User-defined fields are now resolved when the record info is made (enum to VT_I4, interface to VT_UNKNOWN, alias to its type, record to a nested record info), each field is copied by its real size, nested records and VARIANT fields are cleared and copied deeply, and Invoke passes a VT_RECORD argument by reference.
---
diff --git a/dlls/oleaut32/recinfo.c b/dlls/oleaut32/recinfo.c
index 93f2873..766d80b 100644
--- a/dlls/oleaut32/recinfo.c
+++ b/dlls/oleaut32/recinfo.c
@@ -35,6 +35,8 @@ typedef struct {
     VARKIND varkind;
     ULONG offset;
     BSTR name;
+    ULONG size;             /* its bytes (to the next field or the record's end) */
+    IRecordInfo *rec;       /* a field that is itself a record (VT_RECORD) */
 } fieldstr;
 
 typedef struct {
@@ -201,7 +203,10 @@ static ULONG WINAPI IRecordInfoImpl_Release(IRecordInfo *iface)
     if(!ref) {
         int i;
         for(i=0; i<This->n_vars; i++)
+        {
             SysFreeString(This->fields[i].name);
+            if (This->fields[i].rec) IRecordInfo_Release(This->fields[i].rec);
+        }
         SysFreeString(This->name);
         free(This->fields);
         ITypeInfo_Release(This->pTypeInfo);
@@ -270,6 +275,21 @@ static HRESULT WINAPI IRecordInfoImpl_RecordClear(IRecordInfo *iface, PVOID pvEx
             case VT_SAFEARRAY:
                 SafeArrayDestroy(var);
                 break;
+#ifndef SG_MUTANT_RECORD_NESTED_IGNORED
+            case VT_RECORD:
+                /* a record field (Stained Glass OS, wine-sg 6233) */
+                if (This->fields[i].rec) IRecordInfo_RecordClear(This->fields[i].rec, var);
+                break;
+            case VT_VARIANT:
+                VariantClear(var);
+                break;
+            case VT_USERDEFINED:
+            case VT_PTR:
+            case VT_CARRAY:
+            case VT_LPSTR:
+            case VT_LPWSTR:
+                break;
+#endif
             case VT_UNKNOWN:
             case VT_DISPATCH:
             {
@@ -341,6 +361,20 @@ static HRESULT WINAPI IRecordInfoImpl_RecordCopy(IRecordInfo *iface, void *src_r
             case VT_SAFEARRAY:
                 hr = SafeArrayCopy(src, dest);
                 break;
+#ifndef SG_MUTANT_RECORD_NESTED_IGNORED
+            case VT_RECORD:
+                if (This->fields[i].rec) hr = IRecordInfo_RecordCopy(This->fields[i].rec, src, dest);
+                else memcpy(dest, src, This->fields[i].size);
+                break;
+            case VT_VARIANT:
+                VariantInit(dest);
+                hr = VariantCopy(dest, src);
+                break;
+            default:
+                /* copied as it is: its bytes, whatever its type */
+                memcpy(dest, src, This->fields[i].size);
+                break;
+#else
             default:
             {
                 /* copy directly for types that don't need deep copy */
@@ -348,6 +382,7 @@ static HRESULT WINAPI IRecordInfoImpl_RecordCopy(IRecordInfo *iface, void *src_r
                 memcpy(dest, src, len);
                 break;
             }
+#endif
         }
 
         if (FAILED(hr)) break;
@@ -734,8 +769,43 @@ HRESULT WINAPI GetRecordInfoFromTypeInfo(ITypeInfo* pTI, IRecordInfo** ppRecInfo
         if(FAILED(hres))
             WARN("GetDocumentation failed: %#lx.\n", hres);
         TRACE("field=%s, offset=%ld\n", debugstr_w(ret->fields[i].name), ret->fields[i].offset);
+#ifndef SG_MUTANT_RECORD_NESTED_IGNORED
+        if (vardesc->elemdescVar.tdesc.vt == VT_USERDEFINED)
+        {
+            /* an enum, an interface or a record of the type library (wine-sg 6233) */
+            ITypeInfo *ref_info;
+            TYPEATTR *ref_attr;
+
+            if (SUCCEEDED(ITypeInfo_GetRefTypeInfo(pTypeInfo, vardesc->elemdescVar.tdesc.hreftype, &ref_info)))
+            {
+                if (SUCCEEDED(ITypeInfo_GetTypeAttr(ref_info, &ref_attr)))
+                {
+                    if (ref_attr->typekind == TKIND_ENUM) ret->fields[i].vt = VT_I4;
+                    else if (ref_attr->typekind == TKIND_INTERFACE || ref_attr->typekind == TKIND_DISPATCH)
+                        ret->fields[i].vt = VT_UNKNOWN;
+                    else if (ref_attr->typekind == TKIND_ALIAS && ref_attr->tdescAlias.vt != VT_USERDEFINED)
+                        ret->fields[i].vt = ref_attr->tdescAlias.vt;
+                    else if (ref_attr->typekind == TKIND_RECORD &&
+                             SUCCEEDED(GetRecordInfoFromTypeInfo(ref_info, &ret->fields[i].rec)))
+                        ret->fields[i].vt = VT_RECORD;
+                    ITypeInfo_ReleaseTypeAttr(ref_info, ref_attr);
+                }
+                ITypeInfo_Release(ref_info);
+            }
+        }
+#endif
         ITypeInfo_ReleaseVarDesc(pTypeInfo, vardesc);
     }
+    /* each field's bytes: to the next field after it, or to the record's end */
+    for (i = 0; i < ret->n_vars; i++)
+    {
+        ULONG end = ret->size;
+        int j;
+
+        for (j = 0; j < ret->n_vars; j++)
+            if (ret->fields[j].offset > ret->fields[i].offset && ret->fields[j].offset < end) end = ret->fields[j].offset;
+        ret->fields[i].size = end > ret->fields[i].offset ? end - ret->fields[i].offset : 0;
+    }
 
     *ppRecInfo = &ret->IRecordInfo_iface;
 
diff --git a/dlls/oleaut32/typelib.c b/dlls/oleaut32/typelib.c
index 8d38fa5..6e188ec 100644
--- a/dlls/oleaut32/typelib.c
+++ b/dlls/oleaut32/typelib.c
@@ -7037,8 +7037,13 @@ static HRESULT userdefined_to_variantvt(ITypeInfo *tinfo, const TYPEDESC *tdesc,
         break;
 
     case TKIND_RECORD:
+#ifndef SG_MUTANT_INVOKE_NO_RECORD
+        /* Stained Glass OS (wine-sg 6233): a structure argument, a VT_RECORD */
+        *vt |= VT_RECORD;
+#else
         FIXME("TKIND_RECORD unhandled.\n");
         hr = E_NOTIMPL;
+#endif
         break;
 
     case TKIND_UNION:
@@ -7434,7 +7439,14 @@ static HRESULT WINAPI ITypeInfo_fnInvoke(
 
                     if(rgvt[i]!=V_VT(src_arg))
                     {
-                        if (rgvt[i] == VT_VARIANT)
+                        if (rgvt[i] == (VT_RECORD | VT_BYREF) && V_VT(src_arg) == VT_RECORD)
+                        {
+                            /* a record for a pointer to one: the record itself (wine-sg 6233) */
+                            V_VT(&rgvarg[i]) = VT_RECORD | VT_BYREF;
+                            V_RECORD(&rgvarg[i]) = V_RECORD(src_arg);
+                            V_RECORDINFO(&rgvarg[i]) = V_RECORDINFO(src_arg);
+                        }
+                        else if (rgvt[i] == VT_VARIANT)
                             hres = VariantCopy(&rgvarg[i], src_arg);
                         else if (rgvt[i] == (VT_VARIANT | VT_BYREF))
                         {
