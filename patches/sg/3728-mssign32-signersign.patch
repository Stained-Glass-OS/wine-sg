+IMPORTS = crypt32 advapi32 wintrust
+
 EXTRADLLFLAGS = -Wb,--prefer-native
 
 SOURCES = \
diff --git a/dlls/mssign32/mssign32_main.c b/dlls/mssign32/mssign32_main.c
index c6a5a72..124a713 100644
--- a/dlls/mssign32/mssign32_main.c
+++ b/dlls/mssign32/mssign32_main.c
@@ -25,11 +25,16 @@
 #include "wincrypt.h"
 
 #include "wine/debug.h"
+#include "winerror.h"
+#include "wintrust.h"
+#include "mssip.h"
 #include "wine/heap.h"
 #include "wine/mssign.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(mssign);
 
+HRESULT WINAPI SignerFreeSignerContext(SIGNER_CONTEXT *signer_context);
+
 HRESULT WINAPI PvkGetCryptProv(HWND hwnd, LPCWSTR pwszCaption, LPCWSTR pwszCapiProvider,
                     DWORD dwProviderType, LPCWSTR pwszPvkFile, LPCWSTR pwszKeyContainerName,
                     DWORD *pdwKeySpec, LPWSTR *ppwszTmpContainer, HCRYPTPROV *phCryptProv)
@@ -59,11 +64,144 @@ void WINAPI PvkFreeCryptProv(HCRYPTPROV hProv, LPCWSTR pwszCapiProvider, DWORD d
                     debugstr_w(pwszTmpContainer));
 }
 
-HRESULT WINAPI SignerSign(SIGNER_SUBJECT_INFO *subject, SIGNER_CERT *cert, SIGNER_SIGNATURE_INFO *signature,
-        SIGNER_PROVIDER_INFO *provider, const WCHAR *timestamp, CRYPT_ATTRIBUTES *attrs, void *sip_data)
+
+static HRESULT last_error_hr(void)
+{
+    DWORD err = GetLastError();
+    return err ? HRESULT_FROM_WIN32(err) : E_FAIL;
+}
+
+static BYTE *der_put_len(BYTE *p, DWORD len)
+{
+    if (len < 0x80) *p++ = len;
+    else if (len < 0x100) { *p++ = 0x81; *p++ = len; }
+    else { *p++ = 0x82; *p++ = len >> 8; *p++ = len; }
+    return p;
+}
+
+/* SpcSpOpusInfo ::= SEQUENCE { programName [0] EXPLICIT SpcString OPTIONAL,
+ *                              moreInfo [1] EXPLICIT SpcLink OPTIONAL }
+ * SpcString ::= CHOICE { unicode [0] IMPLICIT BMPString }
+ * SpcLink   ::= CHOICE { url [0] IMPLICIT IA5String } */
+static BYTE *encode_opus_info(const SIGNER_ATTR_AUTHCODE *attr, DWORD *ret_len)
+{
+    DWORD name_len = attr->pwszName ? lstrlenW(attr->pwszName) : 0;
+    DWORD info_len = attr->pwszInfo ? lstrlenW(attr->pwszInfo) : 0;
+    DWORD i, inner, name_content = name_len * 2, name_str, name_expl = 0, info_expl = 0, info_str, total;
+    BYTE tmp[4], *buf, *p;
+
+    name_str = name_content ? 1 + (der_put_len(tmp, name_content) - tmp) + name_content : 0;
+    if (name_str) name_expl = 1 + (der_put_len(tmp, name_str) - tmp) + name_str;
+    info_str = info_len ? 1 + (der_put_len(tmp, info_len) - tmp) + info_len : 0;
+    if (info_str) info_expl = 1 + (der_put_len(tmp, info_str) - tmp) + info_str;
+    inner = name_expl + info_expl;
+    total = 1 + (der_put_len(tmp, inner) - tmp) + inner;
+    if (!(buf = malloc(total))) return NULL;
+    p = buf;
+    *p++ = 0x30; p = der_put_len(p, inner);
+    if (name_str)
+    {
+        *p++ = 0xa0; p = der_put_len(p, name_str);
+        *p++ = 0x80; p = der_put_len(p, name_content);
+        for (i = 0; i < name_len; i++) { *p++ = attr->pwszName[i] >> 8; *p++ = attr->pwszName[i]; }
+    }
+    if (info_str)
+    {
+        *p++ = 0xa1; p = der_put_len(p, info_str);
+        *p++ = 0x80; p = der_put_len(p, info_len);
+        for (i = 0; i < info_len; i++) *p++ = attr->pwszInfo[i] < 0x80 ? attr->pwszInfo[i] : '?';
+    }
+    *ret_len = p - buf;
+    return buf;
+}
+
+static const BYTE oid_individual[] = { 0x06, 0x0a, 0x2b, 0x06, 0x01, 0x04, 0x01, 0x82, 0x37, 0x02, 0x01, 0x15 };
+static const BYTE oid_commercial[] = { 0x06, 0x0a, 0x2b, 0x06, 0x01, 0x04, 0x01, 0x82, 0x37, 0x02, 0x01, 0x16 };
+
+static BOOL load_spc_store(const WCHAR *file, HCERTSTORE *store)
+{
+    return CryptQueryObject(CERT_QUERY_OBJECT_FILE, file,
+            CERT_QUERY_CONTENT_FLAG_PKCS7_SIGNED | CERT_QUERY_CONTENT_FLAG_CERT |
+            CERT_QUERY_CONTENT_FLAG_SERIALIZED_STORE | CERT_QUERY_CONTENT_FLAG_PKCS7_UNSIGNED,
+            CERT_QUERY_FORMAT_FLAG_ALL, 0, NULL, NULL, NULL, store, NULL, NULL);
+}
+
+static void add_chain(HCERTSTORE out, const CERT_CONTEXT *cert, HCERTSTORE extra, DWORD policy)
+{
+    CERT_CHAIN_PARA para = { sizeof(para) };
+    const CERT_CHAIN_CONTEXT *chain;
+    DWORD i;
+
+    CertAddCertificateContextToStore(out, cert, CERT_STORE_ADD_USE_EXISTING, NULL);
+    if (policy & (SIGNER_CERT_POLICY_CHAIN | SIGNER_CERT_POLICY_CHAIN_NO_ROOT))
+    {
+        if (CertGetCertificateChain(NULL, cert, NULL, extra, &para, 0, NULL, &chain))
+        {
+            CERT_SIMPLE_CHAIN *simple = chain->rgpChain[0];
+            for (i = 1; i < simple->cElement; i++)
+            {
+                CERT_CHAIN_ELEMENT *el = simple->rgpElement[i];
+                if ((policy & SIGNER_CERT_POLICY_CHAIN_NO_ROOT) && i == simple->cElement - 1 &&
+                    (el->TrustStatus.dwInfoStatus & CERT_TRUST_IS_SELF_SIGNED))
+                    continue;
+                CertAddCertificateContextToStore(out, el->pCertContext, CERT_STORE_ADD_USE_EXISTING, NULL);
+            }
+            CertFreeCertificateChain(chain);
+        }
+    }
+    if ((policy & SIGNER_CERT_POLICY_STORE) && extra)
+    {
+        const CERT_CONTEXT *c = NULL;
+        while ((c = CertEnumCertificatesInStore(extra, c)))
+            CertAddCertificateContextToStore(out, c, CERT_STORE_ADD_USE_EXISTING, NULL);
+    }
+}
+
+static BOOL key_matches_cert(HCRYPTPROV prov, DWORD keyspec, const CERT_CONTEXT *cert)
+{
+    CERT_PUBLIC_KEY_INFO *pub;
+    DWORD size = 0;
+    BOOL ret = FALSE;
+
+    if (!CryptExportPublicKeyInfo(prov, keyspec, X509_ASN_ENCODING, NULL, &size) || !(pub = malloc(size)))
+        return FALSE;
+    if (CryptExportPublicKeyInfo(prov, keyspec, X509_ASN_ENCODING, pub, &size))
+        ret = CertComparePublicKeyInfo(X509_ASN_ENCODING, pub, &cert->pCertInfo->SubjectPublicKeyInfo);
+    free(pub);
+    return ret;
+}
+
+static BOOL acquire_key(const SIGNER_PROVIDER_INFO *prov_info, const CERT_CONTEXT *cert,
+        HCRYPTPROV *prov, DWORD *keyspec, BOOL *release)
 {
-    FIXME("%p %p %p %p %s %p %p stub\n", subject, cert, signature, provider, debugstr_w(timestamp), attrs, sip_data);
-    return E_NOTIMPL;
+    *release = FALSE;
+    if (prov_info)
+    {
+        if (prov_info->cbSize < sizeof(*prov_info))
+        {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+        }
+        if (prov_info->dwPvkChoice == PVK_TYPE_KEYCONTAINER)
+        {
+            if (!CryptAcquireContextW(prov, prov_info->pwszKeyContainer, prov_info->pwszProviderName,
+                                      prov_info->dwProviderType, 0))
+                return FALSE;
+            *release = TRUE;
+            *keyspec = prov_info->dwKeySpec;
+            if (!*keyspec)
+            {
+                HCRYPTKEY key;
+                if (CryptGetUserKey(*prov, AT_SIGNATURE, &key)) { CryptDestroyKey(key); *keyspec = AT_SIGNATURE; }
+                else *keyspec = AT_KEYEXCHANGE;
+            }
+            return TRUE;
+        }
+        SetLastError(ERROR_NOT_SUPPORTED);
+        return FALSE;
+    }
+    if (!cert) { SetLastError(ERROR_INVALID_PARAMETER); return FALSE; }
+    return CryptAcquireCertificatePrivateKey(cert, CRYPT_ACQUIRE_COMPARE_KEY_FLAG, NULL, prov, keyspec, release);
 }
 
 HRESULT WINAPI SignerSignEx(DWORD flags, SIGNER_SUBJECT_INFO *subject_info, SIGNER_CERT *signer_cert,
@@ -71,9 +209,287 @@ HRESULT WINAPI SignerSignEx(DWORD flags, SIGNER_SUBJECT_INFO *subject_info, SIGN
                             const WCHAR *http_time_stamp, CRYPT_ATTRIBUTES *request, void *sip_data,
                             SIGNER_CONTEXT **signer_context)
 {
-    FIXME("%lx %p %p %p %p %s %p %p %p stub\n", flags, subject_info, signer_cert, signature_info, provider_info,
-                    wine_dbgstr_w(http_time_stamp), request, sip_data, signer_cert);
-    return E_NOTIMPL;
+    static char spc_indirect_oid[] = "1.3.6.1.4.1.311.2.1.4";
+    static char spc_opus_oid[] = "1.3.6.1.4.1.311.2.1.12";
+    static char spc_stmt_oid[] = "1.3.6.1.4.1.311.2.1.11";
+    const SIGNER_FILE_INFO *file_info;
+    const CERT_CONTEXT *cert = NULL, *free_cert = NULL;
+    HCERTSTORE spc_store = NULL, msg_store = NULL;
+    HCERTSTORE extra = NULL;
+    DWORD policy = 0, keyspec = 0, index = 0, indirect_size = 0, i, n;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    BOOL release_prov = FALSE, ret;
+    HCRYPTPROV prov = 0;
+    HCRYPTMSG msg = NULL;
+    SIP_DISPATCH_INFO sip = { sizeof(sip) };
+    SIP_SUBJECTINFO si = { sizeof(si) };
+    SIP_INDIRECT_DATA *indirect = NULL;
+    BYTE *encoded = NULL, *opus = NULL, *stmt = NULL, *signed_blob = NULL;
+    DWORD encoded_size = 0, opus_size = 0, stmt_size = 0, signed_size = 0;
+    CRYPT_ATTRIBUTE auth_attrs[2 + 16];
+    CRYPT_ATTR_BLOB auth_blobs[2];
+    CRYPT_ATTRIBUTE *all_auth = NULL, *all_unauth = NULL;
+    const CRYPT_OID_INFO *oid_info;
+    CMSG_SIGNER_ENCODE_INFO signer = { sizeof(signer) };
+    CMSG_SIGNED_ENCODE_INFO signed_info = { sizeof(signed_info) };
+    CERT_BLOB *cert_blobs = NULL;
+    SIGNER_CONTEXT *ctx;
+    GUID guid;
+    HRESULT hr = S_OK;
+    ALG_ID alg;
+
+    TRACE("%lx %p %p %p %p %s %p %p %p\n", flags, subject_info, signer_cert, signature_info, provider_info,
+            debugstr_w(http_time_stamp), request, sip_data, signer_context);
+
+    if (!subject_info || !signer_cert || !signature_info || !signer_context ||
+        subject_info->cbSize < sizeof(*subject_info) || signer_cert->cbSize < sizeof(*signer_cert) ||
+        signature_info->cbSize < sizeof(*signature_info))
+        return E_INVALIDARG;
+    *signer_context = NULL;
+
+    if (subject_info->dwSubjectChoice != SIGNER_SUBJECT_FILE)
+        return subject_info->dwSubjectChoice == SIGNER_SUBJECT_BLOB ?
+                HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED) : E_INVALIDARG;
+    file_info = subject_info->pSignerFileInfo;
+    if (!file_info || file_info->cbSize < sizeof(*file_info) ||
+        (!file_info->pwszFileName && (!file_info->hFile || file_info->hFile == INVALID_HANDLE_VALUE)))
+        return E_INVALIDARG;
+    if (signature_info->dwAttrChoice == SIGNER_AUTHCODE_ATTR &&
+        (!signature_info->pAttrAuthcode || signature_info->pAttrAuthcode->cbSize < sizeof(SIGNER_ATTR_AUTHCODE)))
+        return E_INVALIDARG;
+    if (signature_info->dwAttrChoice > SIGNER_AUTHCODE_ATTR) return E_INVALIDARG;
+    if (http_time_stamp) return HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED);
+
+    alg = signature_info->algidHash ? signature_info->algidHash : CALG_SHA1;
+    if (GET_ALG_CLASS(alg) != ALG_CLASS_HASH) return NTE_BAD_ALGID;
+    if (!(oid_info = CryptFindOIDInfo(CRYPT_OID_INFO_ALGID_KEY, &alg, CRYPT_HASH_ALG_OID_GROUP_ID)))
+        return NTE_BAD_ALGID;
+
+    /* the signing certificate */
+    switch (signer_cert->dwCertChoice)
+    {
+    case SIGNER_CERT_STORE:
+        if (!signer_cert->pCertStoreInfo || signer_cert->pCertStoreInfo->cbSize < sizeof(SIGNER_CERT_STORE_INFO) ||
+            !signer_cert->pCertStoreInfo->pSigningCert)
+            return E_INVALIDARG;
+        cert = signer_cert->pCertStoreInfo->pSigningCert;
+        policy = signer_cert->pCertStoreInfo->dwCertPolicy;
+        extra = signer_cert->pCertStoreInfo->hCertStore;
+        break;
+    case SIGNER_CERT_SPC_FILE:
+    case SIGNER_CERT_SPC_CHAIN:
+    {
+        const WCHAR *spc;
+        if (signer_cert->dwCertChoice == SIGNER_CERT_SPC_FILE) spc = signer_cert->pwszSpcFile;
+        else if (signer_cert->pSpcChainInfo && signer_cert->pSpcChainInfo->cbSize >= sizeof(SIGNER_SPC_CHAIN_INFO))
+        {
+            spc = signer_cert->pSpcChainInfo->pwszSpcFile;
+            policy = signer_cert->pSpcChainInfo->dwCertPolicy;
+            extra = signer_cert->pSpcChainInfo->hCertStore;
+        }
+        else return E_INVALIDARG;
+        if (!spc) return E_INVALIDARG;
+        if (!load_spc_store(spc, &spc_store)) return last_error_hr();
+        /* the certificate whose public key belongs to the private key */
+        if (provider_info && !acquire_key(provider_info, NULL, &prov, &keyspec, &release_prov))
+        {
+            hr = last_error_hr();
+            goto done;
+        }
+        {
+            const CERT_CONTEXT *c = NULL, *first = NULL;
+            CERT_PUBLIC_KEY_INFO *pub = NULL;
+            DWORD pub_size = 0;
+
+            if (prov && CryptExportPublicKeyInfo(prov, keyspec, X509_ASN_ENCODING, NULL, &pub_size) &&
+                (pub = malloc(pub_size)) &&
+                !CryptExportPublicKeyInfo(prov, keyspec, X509_ASN_ENCODING, pub, &pub_size))
+            { free(pub); pub = NULL; }
+            while ((c = CertEnumCertificatesInStore(spc_store, c)))
+            {
+                if (!first) first = CertDuplicateCertificateContext(c);
+#ifdef SG_MUTANT_MSSIGN_FIRSTCERT
+                if (0)
+#else
+                if (pub && CertComparePublicKeyInfo(X509_ASN_ENCODING, pub, &c->pCertInfo->SubjectPublicKeyInfo))
+#endif
+                {
+                    free_cert = CertDuplicateCertificateContext(c);
+                    CertFreeCertificateContext(c);
+                    break;
+                }
+            }
+            free(pub);
+            if (free_cert) { if (first) CertFreeCertificateContext(first); }
+            else free_cert = first;
+        }
+        if (!(cert = free_cert)) { hr = CRYPT_E_NOT_FOUND; goto done; }
+        if (!extra) extra = spc_store;
+        break;
+    }
+    default:
+        return E_INVALIDARG;
+    }
+
+    if (!prov && !acquire_key(provider_info, cert, &prov, &keyspec, &release_prov))
+    {
+        hr = last_error_hr();
+        goto done;
+    }
+    /* the private key must be the one of the certificate (crypt32 does not
+     * compare them for CRYPT_ACQUIRE_COMPARE_KEY_FLAG) */
+#ifndef SG_MUTANT_MSSIGN_NOKEYCMP
+    if (!key_matches_cert(prov, keyspec, cert))
+    {
+        hr = NTE_BAD_PUBLIC_KEY;
+        goto done;
+    }
+#endif
+
+    /* the subject and its SIP */
+    if (file_info->hFile && file_info->hFile != INVALID_HANDLE_VALUE) file = file_info->hFile;
+    else
+    {
+        file = CreateFileW(file_info->pwszFileName, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ, NULL,
+                OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (file == INVALID_HANDLE_VALUE) { hr = last_error_hr(); goto done; }
+    }
+    if (!CryptSIPRetrieveSubjectGuid(file_info->pwszFileName, file, &guid))
+    {
+        hr = TRUST_E_SUBJECT_FORM_UNKNOWN;
+        goto done;
+    }
+    if (!CryptSIPLoad(&guid, 0, &sip)) { hr = last_error_hr(); goto done; }
+    si.pgSubjectType = &guid;
+    si.hFile = file;
+    si.pwsFileName = file_info->pwszFileName;
+    si.DigestAlgorithm.pszObjId = (char *)oid_info->pszOID;
+    si.dwFlags = flags;
+    si.dwEncodingType = X509_ASN_ENCODING | PKCS_7_ASN_ENCODING;
+    si.pClientData = sip_data;
+    if (!sip.pfCreate(&si, &indirect_size, NULL) ||
+        !(indirect = malloc(indirect_size)) ||
+        !sip.pfCreate(&si, &indirect_size, indirect))
+    { hr = last_error_hr(); goto done; }
+#ifdef SG_MUTANT_MSSIGN_STALE
+    indirect->Digest.pbData[0] ^= 1;
+#endif
+    if (!CryptEncodeObject(X509_ASN_ENCODING, spc_indirect_oid, indirect, NULL, &encoded_size) ||
+        !(encoded = malloc(encoded_size)) ||
+        !CryptEncodeObject(X509_ASN_ENCODING, spc_indirect_oid, indirect, encoded, &encoded_size))
+    { hr = last_error_hr(); goto done; }
+
+    /* authenticated attributes */
+    n = 0;
+    if (signature_info->dwAttrChoice == SIGNER_AUTHCODE_ATTR)
+    {
+        const SIGNER_ATTR_AUTHCODE *ac = signature_info->pAttrAuthcode;
+        BYTE *p;
+
+        stmt_size = 2 + (ac->fCommercial ? sizeof(oid_commercial) : 0) + (ac->fIndividual ? sizeof(oid_individual) : 0);
+        if (stmt_size == 2) stmt_size += sizeof(oid_individual);
+        if (!(stmt = malloc(stmt_size))) { hr = E_OUTOFMEMORY; goto done; }
+        p = stmt; *p++ = 0x30; *p++ = stmt_size - 2;
+        if (ac->fCommercial) { memcpy(p, oid_commercial, sizeof(oid_commercial)); p += sizeof(oid_commercial); }
+        if (ac->fIndividual || !ac->fCommercial) { memcpy(p, oid_individual, sizeof(oid_individual)); }
+        auth_blobs[0].cbData = stmt_size; auth_blobs[0].pbData = stmt;
+        auth_attrs[n].pszObjId = spc_stmt_oid; auth_attrs[n].cValue = 1; auth_attrs[n].rgValue = &auth_blobs[0]; n++;
+        if ((ac->pwszName || ac->pwszInfo) && (opus = encode_opus_info(ac, &opus_size)))
+        {
+            auth_blobs[1].cbData = opus_size; auth_blobs[1].pbData = opus;
+            auth_attrs[n].pszObjId = spc_opus_oid; auth_attrs[n].cValue = 1; auth_attrs[n].rgValue = &auth_blobs[1]; n++;
+        }
+    }
+    if (signature_info->psAuthenticated) n += signature_info->psAuthenticated->cAttr;
+    if (n)
+    {
+        DWORD k = 0;
+        if (!(all_auth = malloc(n * sizeof(*all_auth)))) { hr = E_OUTOFMEMORY; goto done; }
+        for (i = 0; i < n - (signature_info->psAuthenticated ? signature_info->psAuthenticated->cAttr : 0); i++)
+            all_auth[k++] = auth_attrs[i];
+        if (signature_info->psAuthenticated)
+            for (i = 0; i < signature_info->psAuthenticated->cAttr; i++)
+                all_auth[k++] = signature_info->psAuthenticated->rgAttr[i];
+    }
+    (void)all_unauth;
+
+    signer.pCertInfo = cert->pCertInfo;
+    signer.hCryptProv = prov;
+    signer.dwKeySpec = keyspec;
+    signer.HashAlgorithm.pszObjId = (char *)oid_info->pszOID;
+    signer.cAuthAttr = n;
+    signer.rgAuthAttr = all_auth;
+    if (signature_info->psUnauthenticated)
+    {
+        signer.cUnauthAttr = signature_info->psUnauthenticated->cAttr;
+        signer.rgUnauthAttr = signature_info->psUnauthenticated->rgAttr;
+    }
+    /* include the certificate and its chain */
+    if (!(msg_store = CertOpenStore(CERT_STORE_PROV_MEMORY, 0, 0, CERT_STORE_CREATE_NEW_FLAG, NULL)))
+    { hr = last_error_hr(); goto done; }
+    add_chain(msg_store, cert, extra, policy);
+    {
+        const CERT_CONTEXT *c = NULL;
+        for (n = 0; (c = CertEnumCertificatesInStore(msg_store, c)); ) n++;
+        if (!(cert_blobs = malloc(n * sizeof(*cert_blobs)))) { hr = E_OUTOFMEMORY; goto done; }
+        for (i = 0; (c = CertEnumCertificatesInStore(msg_store, c)); i++)
+        {
+            cert_blobs[i].cbData = c->cbCertEncoded;
+            cert_blobs[i].pbData = c->pbCertEncoded;
+        }
+    }
+    signed_info.cSigners = 1;
+    signed_info.rgSigners = &signer;
+    signed_info.cCertEncoded = n;
+    signed_info.rgCertEncoded = cert_blobs;
+
+    if (!(msg = CryptMsgOpenToEncode(X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, 0, CMSG_SIGNED, &signed_info,
+                                     spc_indirect_oid, NULL)) ||
+        !CryptMsgUpdate(msg, encoded, encoded_size, TRUE) ||
+        !CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, NULL, &signed_size) ||
+        !(signed_blob = malloc(signed_size)) ||
+        !CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, signed_blob, &signed_size))
+    { hr = last_error_hr(); goto done; }
+
+#ifdef SG_MUTANT_MSSIGN_NOPUT
+    ret = TRUE;
+#else
+    ret = sip.pfPut(&si, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, &index, signed_size, signed_blob);
+#endif
+    if (!ret) { hr = last_error_hr(); goto done; }
+
+    if (!(ctx = malloc(sizeof(*ctx) + signed_size))) { hr = E_OUTOFMEMORY; goto done; }
+    ctx->cbSize = sizeof(*ctx);
+    ctx->cbBlob = signed_size;
+    ctx->pbBlob = (BYTE *)(ctx + 1);
+    memcpy(ctx->pbBlob, signed_blob, signed_size);
+    *signer_context = ctx;
+    if (subject_info->pdwIndex) *subject_info->pdwIndex = index;
+
+done:
+    free(signed_blob);
+    if (msg) CryptMsgClose(msg);
+    free(cert_blobs);
+    if (msg_store) CertCloseStore(msg_store, 0);
+    free(all_auth); free(opus); free(stmt); free(encoded); free(indirect);
+    if (file != INVALID_HANDLE_VALUE && file != file_info->hFile) CloseHandle(file);
+    if (release_prov && prov) CryptReleaseContext(prov, 0);
+    if (free_cert) CertFreeCertificateContext(free_cert);
+    if (spc_store) CertCloseStore(spc_store, 0);
+    return hr;
+}
+
+HRESULT WINAPI SignerSign(SIGNER_SUBJECT_INFO *subject, SIGNER_CERT *cert, SIGNER_SIGNATURE_INFO *signature,
+        SIGNER_PROVIDER_INFO *provider, const WCHAR *timestamp, CRYPT_ATTRIBUTES *attrs, void *sip_data)
+{
+    SIGNER_CONTEXT *ctx = NULL;
+    HRESULT hr;
+
+    TRACE("%p %p %p %p %s %p %p\n", subject, cert, signature, provider, debugstr_w(timestamp), attrs, sip_data);
+
+    hr = SignerSignEx(0, subject, cert, signature, provider, timestamp, attrs, sip_data, &ctx);
+    if (SUCCEEDED(hr)) SignerFreeSignerContext(ctx);
+    return hr;
 }
 
 HRESULT WINAPI SignerFreeSignerContext(SIGNER_CONTEXT *signer_context)
