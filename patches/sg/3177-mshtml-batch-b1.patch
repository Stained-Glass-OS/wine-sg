+/* the block format ("h1", "p", "pre"...) of the selection, IDM_BLOCKFMT */
+static HRESULT exec_blockfmt(HTMLDocumentNode *doc, DWORD cmdexecopt, VARIANT *in, VARIANT *out)
+{
+    TRACE("(%p)->(%p %p)\n", doc, in, out);
+
+    if(out && !in) {
+        nsICommandParams *nsparam = create_nscommand_params();
+        char *stra = NULL;
+
+        V_VT(out) = VT_BSTR;
+        V_BSTR(out) = NULL;
+        if(NS_SUCCEEDED(get_ns_command_state(doc->browser, NSCMD_PARAGRAPHSTATE, nsparam))) {
+            nsICommandParams_GetCStringValue(nsparam, NSSTATE_ATTRIBUTE, &stra);
+            if(stra) {
+                int len = MultiByteToWideChar(CP_ACP, 0, stra, -1, NULL, 0);
+                WCHAR *strw = malloc(len * sizeof(WCHAR));
+                if(strw) {
+                    MultiByteToWideChar(CP_ACP, 0, stra, -1, strw, len);
+                    V_BSTR(out) = SysAllocString(strw);
+                    free(strw);
+                }
+                nsfree(stra);
+            }
+        }
+        nsICommandParams_Release(nsparam);
+    }
+
+    if(in) {
+        nsICommandParams *nsparam;
+        char *format;
+        int len;
+        const char *p;
+
+        if(V_VT(in) != VT_BSTR)
+            return E_INVALIDARG;
+        len = WideCharToMultiByte(CP_ACP, 0, V_BSTR(in), -1, NULL, 0, NULL, NULL);
+        if(!len || !(format = malloc(len)))
+            return E_OUTOFMEMORY;
+        WideCharToMultiByte(CP_ACP, 0, V_BSTR(in), -1, format, len, NULL, NULL);
+
+        /* "<h1>" and "Heading 1" style names are accepted as well as the tag name */
+        p = format;
+        if(*p == '<')
+            p++;
+        if(!_strnicmp(p, "Heading ", 8)) {
+            memmove(format, "h", 1);
+            memmove(format + 1, p + 8, strlen(p + 8) + 1);
+        }else if(!_strnicmp(p, "Normal", 6)) {
+            strcpy(format, "p");
+        }else if(!_strnicmp(p, "Formatted", 9)) {
+            strcpy(format, "pre");
+        }else if(!_strnicmp(p, "Address", 7)) {
+            strcpy(format, "address");
+        }else {
+            memmove(format, p, strlen(p) + 1);
+            if(format[0] && format[strlen(format) - 1] == '>')
+                format[strlen(format) - 1] = 0;
+        }
+
+        nsparam = create_nscommand_params();
+        nsICommandParams_SetCStringValue(nsparam, NSSTATE_ATTRIBUTE, format);
+        do_ns_command(doc, NSCMD_PARAGRAPHSTATE, nsparam);
+        nsICommandParams_Release(nsparam);
+        free(format);
+        update_doc(doc->browser->doc, UPDATE_UI);
+    }
+    return S_OK;
+}
