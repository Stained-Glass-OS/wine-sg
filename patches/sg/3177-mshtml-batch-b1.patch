+/* Elements outside the HTML namespace (SVG) have no innerHTML in Gecko: serialize
+ * and parse their children ourselves. */
+static HRESULT nonhtml_get_inner_html(HTMLElement *This, BSTR *ret)
+{
+    nsIDOMNode *child, *next;
+    WCHAR *buf = NULL;
+    size_t len = 0;
+    HRESULT hres = S_OK;
+
+#ifdef SG_MUTANT_MSHTML_B1_SVGHTML
+    return (*ret = SysAllocString(L"")) ? S_OK : E_OUTOFMEMORY;
+#endif
+    nsIDOMNode_GetFirstChild(This->node.nsnode, &child);
+    while(child) {
+        nsAString str;
+        const WCHAR *data;
+        size_t n;
+        WCHAR *tmp;
+
+        nsAString_Init(&str, NULL);
+        hres = nsnode_to_nsstring(child, &str);
+        if(SUCCEEDED(hres)) {
+            nsAString_GetData(&str, &data);
+            n = wcslen(data);
+            tmp = realloc(buf, (len + n + 1) * sizeof(WCHAR));
+            if(tmp) {
+                buf = tmp;
+                memcpy(buf + len, data, n * sizeof(WCHAR));
+                len += n;
+                buf[len] = 0;
+            }else {
+                hres = E_OUTOFMEMORY;
+            }
+        }
+        nsAString_Finish(&str);
+
+        next = NULL;
+        if(SUCCEEDED(hres))
+            nsIDOMNode_GetNextSibling(child, &next);
+        nsIDOMNode_Release(child);
+        child = next;
+    }
+
+    if(SUCCEEDED(hres)) {
+        *ret = SysAllocStringLen(buf, len);
+        if(!*ret)
+            hres = E_OUTOFMEMORY;
+    }
+    free(buf);
+    return hres;
+}
+
+static HRESULT nonhtml_set_inner_html(HTMLElement *This, const WCHAR *html)
+{
+    nsIDOMDocumentFragment *fragment;
+    nsIDOMNode *child, *tmp;
+    nsIDOMRange *range;
+    nsAString str;
+    nsresult nsres;
+
+    nsres = nsIDOMDocument_CreateRange(This->node.doc->dom_document, &range);
+    if(NS_FAILED(nsres))
+        return map_nsresult(nsres);
+    nsIDOMRange_SelectNodeContents(range, This->node.nsnode);
+
+    nsAString_InitDepend(&str, html);
+    nsres = nsIDOMRange_CreateContextualFragment(range, &str, &fragment);
+    nsAString_Finish(&str);
+    nsIDOMRange_Release(range);
+    if(NS_FAILED(nsres))
+        return map_nsresult(nsres);
+
+    while(1) {
+        nsIDOMNode_GetFirstChild(This->node.nsnode, &child);
+        if(!child)
+            break;
+        nsres = nsIDOMNode_RemoveChild(This->node.nsnode, child, &tmp);
+        nsIDOMNode_Release(child);
+        if(NS_FAILED(nsres)) {
+            nsIDOMDocumentFragment_Release(fragment);
+            return map_nsresult(nsres);
+        }
+        if(tmp)
+            nsIDOMNode_Release(tmp);
+    }
+
+    nsres = nsIDOMNode_AppendChild(This->node.nsnode, (nsIDOMNode*)fragment, &tmp);
+    nsIDOMDocumentFragment_Release(fragment);
+    if(NS_FAILED(nsres))
+        return map_nsresult(nsres);
+    if(tmp)
+        nsIDOMNode_Release(tmp);
+    return S_OK;
+}
