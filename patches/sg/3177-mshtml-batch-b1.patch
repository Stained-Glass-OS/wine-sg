+/* The default (source) interface of the element class, from its coclass type information */
+static HRESULT class_default_iid(const CLSID *clsid, BOOL source, IID *ret)
+{
+    ITypeInfo *class_info, *iface_info;
+    TYPEATTR *attr, *iface_attr;
+    HRESULT hres;
+    UINT i;
+    int flags;
+    HREFTYPE ref;
+
+    hres = get_class_typeinfo(clsid, &class_info);
+    if(FAILED(hres))
+        return hres;
+
+    hres = ITypeInfo_GetTypeAttr(class_info, &attr);
+    if(FAILED(hres)) {
+        ITypeInfo_Release(class_info);
+        return hres;
+    }
+
+    hres = E_FAIL;
+    for(i = 0; i < attr->cImplTypes; i++) {
+        if(FAILED(ITypeInfo_GetImplTypeFlags(class_info, i, &flags)))
+            continue;
+        if(!(flags & IMPLTYPEFLAG_FDEFAULT) || !(flags & IMPLTYPEFLAG_FSOURCE) != !source)
+            continue;
+        if(FAILED(ITypeInfo_GetRefTypeOfImplType(class_info, i, &ref)))
+            continue;
+        if(FAILED(ITypeInfo_GetRefTypeInfo(class_info, ref, &iface_info)))
+            continue;
+        if(SUCCEEDED(ITypeInfo_GetTypeAttr(iface_info, &iface_attr))) {
+            *ret = iface_attr->guid;
+            ITypeInfo_ReleaseTypeAttr(iface_info, iface_attr);
+            hres = S_OK;
+        }
+        ITypeInfo_Release(iface_info);
+        break;
+    }
+
+    ITypeInfo_ReleaseTypeAttr(class_info, attr);
+    ITypeInfo_Release(class_info);
+    return hres;
+}
