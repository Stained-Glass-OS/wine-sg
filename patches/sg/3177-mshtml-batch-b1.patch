+/* Comment elements have no DOM element behind them: the string properties IE
+ * lets scripts set on them live in the expando storage of the wrapper. */
+static HRESULT comment_dprop_put_str(HTMLElement *This, const WCHAR *name, const WCHAR *v)
+{
+    VARIANT *var;
+    HRESULT hres;
+
+    hres = dispex_get_dprop_ref(&This->node.event_target.dispex, name, TRUE, &var);
+    if(FAILED(hres))
+        return hres;
+
+    VariantClear(var);
+    V_VT(var) = VT_BSTR;
+    V_BSTR(var) = v ? SysAllocString(v) : NULL;
+    return S_OK;
+}
+
+static HRESULT comment_dprop_get_str(HTMLElement *This, const WCHAR *name, BSTR *p)
+{
+    VARIANT *var;
+    HRESULT hres;
+
+#ifdef SG_MUTANT_MSHTML_B1_COMMENT
+    return (*p = SysAllocString(L"")) ? S_OK : E_OUTOFMEMORY;
+#endif
+    hres = dispex_get_dprop_ref(&This->node.event_target.dispex, name, FALSE, &var);
+    if(hres == DISP_E_UNKNOWNNAME || (SUCCEEDED(hres) && V_VT(var) == VT_BSTR && !V_BSTR(var)))
+        *p = SysAllocString(L"");
+    else if(FAILED(hres))
+        return hres;
+    else if(V_VT(var) != VT_BSTR)
+        return E_FAIL;
+    else
+        *p = SysAllocString(V_BSTR(var));
+    return *p ? S_OK : E_OUTOFMEMORY;
+}
+
+/* Layout box of an element in client coordinates; comment elements have no box. */
+static HRESULT elem_client_box(HTMLElement *This, float *left, float *top, float *width, float *height)
+{
+    nsIDOMClientRect *rect;
+    nsresult nsres;
+
+    *left = *top = *width = *height = 0.0f;
+    if(!This->dom_element)
+        return S_OK;
+
+    nsres = nsIDOMElement_GetBoundingClientRect(This->dom_element, &rect);
+    if(NS_FAILED(nsres) || !rect)
+        return E_FAIL;
+
+    nsIDOMClientRect_GetLeft(rect, left);
+    nsIDOMClientRect_GetTop(rect, top);
+    nsIDOMClientRect_GetWidth(rect, width);
+    nsIDOMClientRect_GetHeight(rect, height);
+    nsIDOMClientRect_Release(rect);
+    return S_OK;
+}
+
+static HRESULT elem_offset_box(HTMLElement *This, int which, LONG *p)
+{
+    float box[4];
+    HRESULT hres;
+
+    hres = elem_client_box(This, &box[0], &box[1], &box[2], &box[3]);
+    if(FAILED(hres))
+        return hres;
+    *p = floor(box[which] + 0.5);
+    return S_OK;
+}
