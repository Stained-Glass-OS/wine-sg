+/* The enumerator of a collection that is always empty */
+typedef struct {
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+} EmptyEnum;
+
+static inline EmptyEnum *EmptyEnum_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, EmptyEnum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI EmptyEnum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **ppv)
+{
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumVARIANT)) {
+        IEnumVARIANT_AddRef(iface);
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EmptyEnum_AddRef(IEnumVARIANT *iface)
+{
+    return InterlockedIncrement(&EmptyEnum_from_IEnumVARIANT(iface)->ref);
+}
+
+static ULONG WINAPI EmptyEnum_Release(IEnumVARIANT *iface)
+{
+    EmptyEnum *This = EmptyEnum_from_IEnumVARIANT(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    if(!ref)
+        free(This);
+    return ref;
+}
+
+static HRESULT WINAPI EmptyEnum_Next(IEnumVARIANT *iface, ULONG celt, VARIANT *rgVar, ULONG *pCeltFetched)
+{
+    if(pCeltFetched)
+        *pCeltFetched = 0;
+    return S_FALSE;
+}
+
+static HRESULT WINAPI EmptyEnum_Skip(IEnumVARIANT *iface, ULONG celt)
+{
+    return celt ? S_FALSE : S_OK;
+}
+
+static HRESULT WINAPI EmptyEnum_Reset(IEnumVARIANT *iface)
+{
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl EmptyEnumVtbl;
+
+static HRESULT create_empty_enum(IUnknown **ret)
+{
+    EmptyEnum *enumerator;
+
+    if(!(enumerator = malloc(sizeof(*enumerator))))
+        return E_OUTOFMEMORY;
+    enumerator->IEnumVARIANT_iface.lpVtbl = &EmptyEnumVtbl;
+    enumerator->ref = 1;
+    *ret = (IUnknown*)&enumerator->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI EmptyEnum_Clone(IEnumVARIANT *iface, IEnumVARIANT **ppEnum)
+{
+    return create_empty_enum((IUnknown**)ppEnum);
+}
+
+static const IEnumVARIANTVtbl EmptyEnumVtbl = {
+    EmptyEnum_QueryInterface,
+    EmptyEnum_AddRef,
+    EmptyEnum_Release,
+    EmptyEnum_Next,
+    EmptyEnum_Skip,
+    EmptyEnum_Reset,
+    EmptyEnum_Clone
+};
