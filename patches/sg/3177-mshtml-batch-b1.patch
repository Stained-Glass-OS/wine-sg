+/* The file a document was loaded from: the file itself for file: URLs, the cache entry otherwise */
+static BOOL get_doc_file_info(HTMLDocumentNode *doc, WIN32_FILE_ATTRIBUTE_DATA *data)
+{
+    WCHAR path[MAX_PATH];
+    DWORD size = ARRAY_SIZE(path);
+    const WCHAR *url;
+
+    if(!doc->window || !doc->window->base.outer_window || !(url = doc->window->base.outer_window->url))
+        return FALSE;
+
+    if(SUCCEEDED(PathCreateFromUrlW(url, path, &size, 0)))
+        return GetFileAttributesExW(path, GetFileExInfoStandard, data);
+
+    {
+        INTERNET_CACHE_ENTRY_INFOW *info;
+        DWORD info_size = 0;
+        BOOL ret = FALSE;
+
+        GetUrlCacheEntryInfoW(url, NULL, &info_size);
+        if(!info_size || GetLastError() != ERROR_INSUFFICIENT_BUFFER)
+            return FALSE;
+        if(!(info = malloc(info_size)))
+            return FALSE;
+        if(GetUrlCacheEntryInfoW(url, info, &info_size) && info->lpszLocalFileName)
+            ret = GetFileAttributesExW(info->lpszLocalFileName, GetFileExInfoStandard, data);
+        free(info);
+        return ret;
+    }
+}
+
+/* date strings use the "MM/DD/YYYY HH:MM:SS" form of document.lastModified */
+static HRESULT file_time_to_bstr(const FILETIME *ft, BSTR *ret)
+{
+    SYSTEMTIME st;
+    FILETIME local;
+    WCHAR buf[32];
+
+    FileTimeToLocalFileTime(ft, &local);
+    if(!FileTimeToSystemTime(&local, &st))
+        return E_FAIL;
+    swprintf(buf, ARRAY_SIZE(buf), L"%02u/%02u/%04u %02u:%02u:%02u", st.wMonth, st.wDay, st.wYear,
+             st.wHour, st.wMinute, st.wSecond);
+    *ret = SysAllocString(buf);
+    return *ret ? S_OK : E_OUTOFMEMORY;
+}
