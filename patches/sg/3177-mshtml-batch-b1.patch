+static HRESULT exec_backcolor(HTMLDocumentNode *doc, DWORD cmdexecopt, VARIANT *in, VARIANT *out)
+{
+    TRACE("(%p)->(%p %p)\n", doc, in, out);
+
+    if(out)
+        V_VT(out) = VT_EMPTY;
+
+    if(in) {
+        nsICommandParams *nsparam;
+        char buf[32], *color_str = buf;
+
+        if(V_VT(in) == VT_I4) {
+            sprintf(buf, "#%02lx%02lx%02lx", V_I4(in)&0xff, (V_I4(in)>>8)&0xff, (V_I4(in)>>16)&0xff);
+        }else if(V_VT(in) == VT_BSTR) {
+            int len = WideCharToMultiByte(CP_ACP, 0, V_BSTR(in), -1, NULL, 0, NULL, NULL);
+            if(!len || !(color_str = malloc(len)))
+                return E_OUTOFMEMORY;
+            WideCharToMultiByte(CP_ACP, 0, V_BSTR(in), -1, color_str, len, NULL, NULL);
+        }else {
+            return E_INVALIDARG;
+        }
+
+        nsparam = create_nscommand_params();
+        nsICommandParams_SetCStringValue(nsparam, NSSTATE_ATTRIBUTE, color_str);
+        do_ns_command(doc, NSCMD_HIGHLIGHT, nsparam);
+        nsICommandParams_Release(nsparam);
+        if(color_str != buf)
+            free(color_str);
+
+        update_doc(doc->browser->doc, UPDATE_UI);
+    }
+    return S_OK;
+}
