From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 00:42:59 -0700
Subject: [PATCH] localspl: SetJob commands, job order and JOB_INFO data (3297)

SetJob ignored its command and level 3. It now pauses, resumes, restarts,
cancels/deletes, retains and releases jobs: a paused document stays queued
when it ends and prints on resume; a job cancelled while being written is
dropped when the document ends; a retained job stays in the queue after it
printed (JOB_STATUS_PRINTED|RETAINED) until released; unknown commands and
unknown jobs are refused. Level 3 puts the job before NextJobId (0: last).
Levels 1 and 2 read the caller's JOB_INFO (they read the spooler's own job
record instead, so the new title was garbage), and a level 2 without a
DEVMODE no longer fails.

diff --git a/dlls/localspl/provider.c b/dlls/localspl/provider.c
index 120e539..0224650 100644
--- a/dlls/localspl/provider.c
+++ b/dlls/localspl/provider.c
@@ -235,8 +235,18 @@ typedef struct {
     BOOL read;              /* a print processor opened the job's data */
     DWORD pages;            /* StartPagePrinter calls */
     SYSTEMTIME submitted;   /* when the job was made */
+    DWORD status;           /* JOB_STATUS_ flags set by SetJob: paused, deleting, retained, printed */
+    BOOL spooled;           /* the document is complete (EndDocPrinter), the job waits to be printed */
 } job_info_t;
 
+#ifndef JOB_CONTROL_RETAIN
+#define JOB_CONTROL_RETAIN  8
+#define JOB_CONTROL_RELEASE 9
+#endif
+#ifndef JOB_STATUS_RETAINED
+#define JOB_STATUS_RETAINED 0x2000
+#endif
+
 typedef struct {
     WCHAR *name;
     struct list entry;
@@ -3992,6 +4002,8 @@ static BOOL WINAPI fpWritePrinter(HANDLE hprinter, void *buf, DWORD size, DWORD
     return FALSE;
 }
 
+static BOOL WINAPI fpScheduleJob(HANDLE hprinter, DWORD job_id);
+
 static BOOL WINAPI fpSetJob(HANDLE hprinter, DWORD job_id,
         DWORD level, BYTE *data, DWORD command)
 {
@@ -4000,7 +4012,6 @@ static BOOL WINAPI fpSetJob(HANDLE hprinter, DWORD job_id,
     job_info_t *job;
 
     TRACE("(%p, %ld, %ld, %p, %ld)\n", hprinter, job_id, level, data, command);
-    FIXME("Ignoring everything other than document title\n");
 
     if (!printer || printer->header.type != HANDLE_PRINTER)
     {
@@ -4008,11 +4019,26 @@ static BOOL WINAPI fpSetJob(HANDLE hprinter, DWORD job_id,
         return 0;
     }
 
+    switch (command)
+    {
+    case 0:
+    case JOB_CONTROL_PAUSE: case JOB_CONTROL_RESUME: case JOB_CONTROL_CANCEL: case JOB_CONTROL_RESTART:
+    case JOB_CONTROL_DELETE: case JOB_CONTROL_SENT_TO_PRINTER: case JOB_CONTROL_LAST_PAGE_EJECTED:
+    case JOB_CONTROL_RETAIN: case JOB_CONTROL_RELEASE:
+        break;
+#ifndef SG_MUTANT_SETJOB_BADCMD
+    default:
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+#endif
+    }
+
     EnterCriticalSection(&printer->info->jobs_cs);
     job = get_job(printer->info, job_id);
     if (!job)
     {
         LeaveCriticalSection(&printer->info->jobs_cs);
+        SetLastError(ERROR_INVALID_PARAMETER);
         return FALSE;
     }
 
@@ -4023,8 +4049,19 @@ static BOOL WINAPI fpSetJob(HANDLE hprinter, DWORD job_id,
         break;
     case 1:
     {
+        #ifdef SG_MUTANT_SETJOB_L1
         JOB_INFO_1W *info1 = (JOB_INFO_1W *)job;
-        WCHAR *title = wcsdup(info1->pDocument);
+#else
+        JOB_INFO_1W *info1 = (JOB_INFO_1W *)data;
+#endif
+        WCHAR *title;
+
+        if (!info1 || !info1->pDocument)
+        {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            break;
+        }
+        title = wcsdup(info1->pDocument);
 
         if (title)
         {
@@ -4036,11 +4073,19 @@ static BOOL WINAPI fpSetJob(HANDLE hprinter, DWORD job_id,
     }
     case 2:
     {
-        JOB_INFO_2W *info2 = (JOB_INFO_2W *)job;
-        WCHAR *title = wcsdup(info2->pDocument);
-        DEVMODEW *devmode = dup_devmode(info2->pDevMode);
+        JOB_INFO_2W *info2 = (JOB_INFO_2W *)data;
+        WCHAR *title;
+        DEVMODEW *devmode;
 
-        if (!title || !devmode)
+        if (!info2 || !info2->pDocument)
+        {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            break;
+        }
+        title = wcsdup(info2->pDocument);
+        devmode = dup_devmode(info2->pDevMode);
+
+        if (!title || (info2->pDevMode && !devmode))
         {
             free(title);
             free(devmode);
@@ -4048,22 +4093,85 @@ static BOOL WINAPI fpSetJob(HANDLE hprinter, DWORD job_id,
         else
         {
             free(job->document_title);
-            free(job->devmode);
             job->document_title = title;
-            job->devmode = devmode;
+            if (devmode)
+            {
+                free(job->devmode);
+                job->devmode = devmode;
+            }
             ret = TRUE;
         }
         break;
       }
     case 3:
-        FIXME("level 3 stub\n");
+    {
+        /* JOB_INFO_3: the job prints right before NextJobId (0: last in the queue) */
+        JOB_INFO_3 *info3 = (JOB_INFO_3 *)data;
+        job_info_t *next = NULL;
+
+        if (!info3 || (info3->NextJobId && (!(next = get_job(printer->info, info3->NextJobId)) || next == job)))
+        {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            break;
+        }
+        list_remove(&job->entry);
+#ifdef SG_MUTANT_SETJOB_ORDER
+        if (next) list_add_after(&next->entry, &job->entry);
+#else
+        if (next) list_add_before(&next->entry, &job->entry);
+#endif
+        else list_add_tail(&printer->info->jobs, &job->entry);
         ret = TRUE;
         break;
+    }
     default:
         SetLastError(ERROR_INVALID_LEVEL);
         break;
     }
 
+    if (ret && command)
+    {
+        switch (command)
+        {
+        case JOB_CONTROL_PAUSE:
+            job->status |= JOB_STATUS_PAUSED;
+            break;
+        case JOB_CONTROL_RESUME:
+        case JOB_CONTROL_RESTART:
+            job->status &= ~JOB_STATUS_PAUSED;
+            /* a document that is waiting goes to the print processor now (the job is gone afterwards) */
+#ifndef SG_MUTANT_SETJOB_RESUME
+            if (job->spooled && !job->read) ret = fpScheduleJob(hprinter, job_id);
+#endif
+            break;
+        case JOB_CONTROL_CANCEL:
+        case JOB_CONTROL_DELETE:
+#ifndef SG_MUTANT_SETJOB_DELMARK
+            job->status |= JOB_STATUS_DELETING;
+#endif
+            if (job->spooled && !job->read)
+            {
+                DeleteFileW(job->filename);
+                free_job(job);
+            }
+            break;
+        case JOB_CONTROL_RETAIN:
+            job->status |= JOB_STATUS_RETAINED;
+            break;
+        case JOB_CONTROL_RELEASE:
+            job->status &= ~JOB_STATUS_RETAINED;
+            if (job->status & JOB_STATUS_PRINTED)
+            {
+                /* a printed job that was only kept leaves the queue when released */
+                if (!(printer->info->attributes & PRINTER_ATTRIBUTE_KEEPPRINTEDJOBS)) DeleteFileW(job->filename);
+                free_job(job);
+            }
+            break;
+        default:   /* sent to printer, last page ejected: nothing to do for a spooler without a device */
+            break;
+        }
+    }
+
     LeaveCriticalSection(&printer->info->jobs_cs);
     return ret;
 }
@@ -4223,7 +4331,7 @@ static void fill_job_info(printer_t *printer, job_info_t *job, DWORD level, DWOR
         BYTE *info_ptr, BYTE *data, DWORD *s, BOOL fill, const WCHAR *user, const WCHAR *machine)
 {
     WCHAR *p = (WCHAR *)(data + *s);
-    DWORD status = job->read ? JOB_STATUS_PRINTING : 0;
+    DWORD status = (job->read ? JOB_STATUS_PRINTING : 0) | job->status;
 
     switch (level)
     {
@@ -4456,6 +4564,26 @@ static BOOL WINAPI fpScheduleJob(HANDLE hprinter, DWORD job_id)
         return FALSE;
     }
 
+    job->spooled = TRUE;
+    if (job->status & JOB_STATUS_DELETING)
+    {
+        /* SetJob(JOB_CONTROL_DELETE) while the document was being written */
+        DeleteFileW(job->filename);
+        free_job(job);
+        LeaveCriticalSection(&printer->info->jobs_cs);
+        return TRUE;
+    }
+#ifndef SG_MUTANT_SETJOB_PAUSE
+    if (job->status & JOB_STATUS_PAUSED)
+#else
+    if (0)
+#endif
+    {
+        /* a paused job stays queued until SetJob(JOB_CONTROL_RESUME) */
+        LeaveCriticalSection(&printer->info->jobs_cs);
+        return TRUE;
+    }
+
     port = job->port;
     if (!port || !*port)
         port = printer->info->port;
@@ -4575,6 +4703,14 @@ static BOOL WINAPI fpScheduleJob(HANDLE hprinter, DWORD job_id)
     }
 #endif
 
+    if (job->status & JOB_STATUS_RETAINED)
+    {
+        /* a retained job stays in the queue after it was printed */
+#ifndef SG_MUTANT_SETJOB_RETAIN
+        job->status |= JOB_STATUS_PRINTED;
+        goto cleanup;
+#endif
+    }
     if (!(printer->info->attributes & PRINTER_ATTRIBUTE_KEEPPRINTEDJOBS))
         DeleteFileW(job->filename);
     free_job(job);
