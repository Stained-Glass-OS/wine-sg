+/* DWebBrowserEvents2::PropertyChange */
+void fire_property_change(DocHost *This, const WCHAR *name)
+{
+    VARIANTARG arg;
+    DISPPARAMS dispparams = {&arg, NULL, 1, 0};
+
+    V_VT(&arg) = VT_BSTR;
+    V_BSTR(&arg) = SysAllocString(name);
+    call_sink(This->cps.wbe2, DISPID_PROPERTYCHANGE, &dispparams);
+    SysFreeString(V_BSTR(&arg));
+}
