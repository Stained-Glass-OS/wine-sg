+/* The download state is also reported to the container's command target, which then is responsible
+ * for the progress display instead of DWebBrowserEvents2::DownloadBegin/DownloadComplete. */
+static void exec_download_state(DocHost *dochost, LONG state)
+{
+    VARIANT arg;
+
+    if(!dochost->olecmd)
+        return;
+    V_VT(&arg) = VT_I4;
+    V_I4(&arg) = state;
+    IOleCommandTarget_Exec(dochost->olecmd, NULL, OLECMDID_SETDOWNLOADSTATE, 0, &arg, NULL);
+}
