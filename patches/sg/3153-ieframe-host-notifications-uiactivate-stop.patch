+/* the document does not hand over a drop target yet; hosts that wrap or keep it get one that accepts nothing */
+static HRESULT WINAPI NoDropTarget_QueryInterface(IDropTarget *iface, REFIID riid, void **ppv)
+{
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDropTarget)) {
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI NoDropTarget_AddRef(IDropTarget *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI NoDropTarget_Release(IDropTarget *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI NoDropTarget_DragEnter(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    if(effect)
+        *effect = DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI NoDropTarget_DragOver(IDropTarget *iface, DWORD keys, POINTL pt, DWORD *effect)
+{
+    if(effect)
+        *effect = DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI NoDropTarget_DragLeave(IDropTarget *iface)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI NoDropTarget_Drop(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    if(effect)
+        *effect = DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static const IDropTargetVtbl NoDropTargetVtbl = {
+    NoDropTarget_QueryInterface,
+    NoDropTarget_AddRef,
+    NoDropTarget_Release,
+    NoDropTarget_DragEnter,
+    NoDropTarget_DragOver,
+    NoDropTarget_DragLeave,
+    NoDropTarget_Drop
+};
+
+static IDropTarget no_drop_target = { &NoDropTargetVtbl };
+
 static HRESULT WINAPI DocHostUIHandler_GetDropTarget(IDocHostUIHandler2 *iface,
         IDropTarget *pDropTarget, IDropTarget **ppDropTarget)
 {
     DocHost *This = impl_from_IDocHostUIHandler2(iface);
-    FIXME("(%p)\n", This);
+
