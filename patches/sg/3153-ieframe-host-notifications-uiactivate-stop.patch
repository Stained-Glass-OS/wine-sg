+/* Messages and help requests of the document go to the container first; S_FALSE leaves them to the document. */
+static HRESULT WINAPI DocHostShowUI_ShowMessage(IDocHostShowUI *iface, HWND hwnd, LPOLESTR text,
+        LPOLESTR caption, DWORD type, LPOLESTR help_file, DWORD help_context, LRESULT *result)
+{
+    DocHost *This = impl_from_IDocHostShowUI(iface);
+
+    TRACE("(%p)->(%p %s %s %lx %s %lx %p)\n", This, hwnd, debugstr_w(text), debugstr_w(caption), type,
+          debugstr_w(help_file), help_context, result);
+
+#ifdef SG_MUTANT_SHOWUI_IEFRAME
+    if(0)
+#endif
+    if(This->showui)
+        return IDocHostShowUI_ShowMessage(This->showui, hwnd, text, caption, type, help_file, help_context, result);
+    return S_FALSE;
+}
+
+static HRESULT WINAPI DocHostShowUI_ShowHelp(IDocHostShowUI *iface, HWND hwnd, LPOLESTR help_file,
+        UINT command, DWORD data, POINT mouse, IDispatch *object)
+{
+    DocHost *This = impl_from_IDocHostShowUI(iface);
+
+    TRACE("(%p)->(%p %s %u %lx %ld,%ld %p)\n", This, hwnd, debugstr_w(help_file), command, data, mouse.x, mouse.y,
+          object);
+
+    if(This->showui)
+        return IDocHostShowUI_ShowHelp(This->showui, hwnd, help_file, command, data, mouse, object);
+    return S_FALSE;
+}
