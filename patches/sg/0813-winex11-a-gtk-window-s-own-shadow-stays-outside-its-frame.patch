From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a GTK window's own shadow stays outside its frame

GTK programs that draw their own title bar (client-side decorations:
GNOME apps, GTK 4 -- GNOME Secrets on David's X1) also draw a shadow
around the window and name its width in _GTK_FRAME_EXTENTS, for a window
manager to keep outside the window's frame. Our frame (0803) took the
shadow for part of the window: the frame was the shadow's size larger,
the shadow drawn inside it on the frame's background, and the title bar
the program drags inset from the frame's top. Now the frame goes round
what is seen; the program's window sits the shadow's width out from the
frame's client area, its shadow clipped by the frame; when the program
changes the shadow (GTK drops it when maximized and brings it back),
what is seen stays where it is. GTK's resize handles are in the shadow,
so for such a window the frame's own edge, 6 pixels in, sizes it.

Test: test/csdframe-gate.sh with test/csdframe-client.c (mutants
SG_MUTANT_EMBED_CSD_SHADOW_IN, SG_MUTANT_EMBED_CSD_NO_EDGES).
---
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -77,6 +77,8 @@
     Window   frame;     /* the Wine window's whole_window */
     Window   child;     /* the program's window */
     int      x, y, w, h; /* where we put it in the frame */
+    long     ext[4];      /* its own shadow (_GTK_FRAME_EXTENTS: left, right, top,
+                           * bottom), kept outside the frame */
     BOOL     fullscreen;  /* the program asked for the whole screen */
     BOOL     maximized;   /* the frame is maximized (as the program knows it) */
     LONG     style;       /* ...and the frame's style and place before */
@@ -177,6 +179,31 @@
     return TRUE;
 }
 
+/* GTK draws its own title bar and a shadow around the window (client-side
+ * decorations) and names the shadow's width in _GTK_FRAME_EXTENTS: a window
+ * manager keeps it outside the frame. Ours framed the shadow too -- the
+ * frame its size larger, the shadow drawn in it on the frame's background,
+ * the title bar the program drags inset from the frame's top. */
+static void get_extents( Display *display, Window child, long ext[4] )
+{
+    Atom type;
+    int format, i;
+    unsigned long count, remaining;
+    unsigned long *prop = NULL;
+
+    ext[0] = ext[1] = ext[2] = ext[3] = 0;
+#ifdef SG_MUTANT_EMBED_CSD_SHADOW_IN
+    return;
+#endif
+    X11DRV_expect_error( display, ignore_error, NULL );
+    if (!XGetWindowProperty( display, child, XInternAtom( display, "_GTK_FRAME_EXTENTS", False ), 0, 4, False,
+                             XA_CARDINAL, &type, &format, &count, &remaining, (unsigned char **)&prop ) &&
+        prop && format == 32 && count == 4)
+        for (i = 0; i < 4; i++) ext[i] = min( prop[i] & 0xffff, 256 );
+    if (prop) XFree( prop );
+    X11DRV_check_error();
+}
+
 /* a window the session may put in a frame: a top-level, shown, not a menu */
 static BOOL embeddable( Display *display, Window child, XWindowAttributes *attr )
 {
@@ -247,6 +274,17 @@
     X11DRV_expect_error( display, ignore_error, NULL );
     ok = XTranslateCoordinates( display, child, attr.root, 0, 0, &x, &y, &dummy );
     if (X11DRV_check_error() || !ok) return 0;
+    {
+        /* the frame goes round what is seen, not the program's shadow */
+        long ext[4];
+        get_extents( display, child, ext );
+        if (ext[0] + ext[1] < attr.width && ext[2] + ext[3] < attr.height)
+        {
+            x += ext[0]; y += ext[2];
+            attr.width -= ext[0] + ext[1];
+            attr.height -= ext[2] + ext[3];
+        }
+    }
     TRACE( "%p: %lx at %d,%d %dx%d\n", hwnd, child, x, y, attr.width, attr.height );
     return (LRESULT)((ULONGLONG)(USHORT)x | (ULONGLONG)(USHORT)y << 16 |
                      (ULONGLONG)(USHORT)min( attr.width, 0x7fff ) << 32 |
@@ -419,6 +457,9 @@
     e->display = data->display;
     e->frame = data->whole_window;
     e->child = child;
+    get_extents( data->display, child, e->ext );
+    x -= e->ext[0]; y -= e->ext[2];
+    w += e->ext[0] + e->ext[1]; h += e->ext[2] + e->ext[3];
     e->x = x; e->y = y; e->w = w; e->h = h;
     pthread_mutex_unlock( &embed_mutex );
 
@@ -518,7 +559,13 @@
         X11DRV_check_error();
     }
 #endif
-    if ((e = find_hwnd( data->hwnd )) && (e->x != x || e->y != y || e->w != w || e->h != h))
+    if ((e = find_hwnd( data->hwnd )))
+    {
+        /* its shadow outside the frame (clipped by it) */
+        x -= e->ext[0]; y -= e->ext[2];
+        w += e->ext[0] + e->ext[1]; h += e->ext[2] + e->ext[3];
+    }
+    if (e && (e->x != x || e->y != y || e->w != w || e->h != h))
     {
         e->x = x; e->y = y; e->w = w; e->h = h;
         X11DRV_expect_error( e->display, ignore_error, NULL );
@@ -622,12 +669,42 @@
 {
     struct sg_embed *e;
     Window child = 0;
+    int edge = 0;
 
     if (!embed_count) return FALSE;
     pthread_mutex_lock( &embed_mutex );
-    if ((e = find_hwnd( hwnd )) && event->window == e->frame) child = e->child;
+    if ((e = find_hwnd( hwnd )) && event->window == e->frame)
+    {
+        child = e->child;
+#ifndef SG_MUTANT_EMBED_CSD_NO_EDGES
+        /* GTK's resize handles are in its shadow, which is outside the
+         * frame: the frame's own edge, a few pixels in, sizes it instead */
+        if (event->button == Button1 && !e->maximized && !e->fullscreen && (e->ext[0] || e->ext[1] || e->ext[2] || e->ext[3]))
+        {
+            static const int grip = 6;
+            int w = e->w - e->ext[0] - e->ext[1], h = e->h - e->ext[2] - e->ext[3];
+            int left = event->x < grip, right = event->x >= w - grip, top = event->y < grip, bottom = event->y >= h - grip;
+            if (top && left) edge = WMSZ_TOPLEFT;
+            else if (top && right) edge = WMSZ_TOPRIGHT;
+            else if (bottom && left) edge = WMSZ_BOTTOMLEFT;
+            else if (bottom && right) edge = WMSZ_BOTTOMRIGHT;
+            else if (left) edge = WMSZ_LEFT;
+            else if (right) edge = WMSZ_RIGHT;
+            else if (top) edge = WMSZ_TOP;
+            else if (bottom) edge = WMSZ_BOTTOM;
+        }
+#endif
+    }
     pthread_mutex_unlock( &embed_mutex );
     if (!child) return FALSE;
+    if (edge)
+    {
+        /* the press stays the frame's (its grab), and Wine sizes it */
+        XAllowEvents( event->display, AsyncPointer, event->time );
+        NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_ACTIVATE, 0, 0 );
+        NtUserPostMessage( hwnd, WM_SYSCOMMAND, SC_SIZE | edge, 0 );
+        return TRUE;
+    }
     if (event->subwindow != child)
     {
         XAllowEvents( event->display, AsyncPointer, event->time );
@@ -956,6 +1033,26 @@
 #endif
         else if (event->xproperty.atom == maximized_atom( display ))
             NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_MAXIMIZE, 0, 0 );
+        else if (event->xproperty.atom == XInternAtom( display, "_GTK_FRAME_EXTENTS", False ))
+        {
+            /* its shadow changed (GTK drops it when maximized, and brings it
+             * back): what is seen stays where the frame's client area is */
+            long ext[4];
+            get_extents( display, event->xany.window, ext );
+            pthread_mutex_lock( &embed_mutex );
+            if ((e = find_hwnd( hwnd )) && memcmp( ext, e->ext, sizeof(ext) ))
+            {
+                e->x += e->ext[0] - ext[0];
+                e->y += e->ext[2] - ext[2];
+                e->w += ext[0] + ext[1] - e->ext[0] - e->ext[1];
+                e->h += ext[2] + ext[3] - e->ext[2] - e->ext[3];
+                memcpy( e->ext, ext, sizeof(ext) );
+                X11DRV_expect_error( display, ignore_error, NULL );
+                XMoveResizeWindow( display, e->child, e->x, e->y, max( 1, e->w ), max( 1, e->h ) );
+                X11DRV_check_error();
+            }
+            pthread_mutex_unlock( &embed_mutex );
+        }
         else if (event->xproperty.atom == moveresize_atom( display ) && event->xproperty.state == PropertyNewValue)
         {
             /* _NET_WM_MOVERESIZE's directions: top-left, top, top-right,
