From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3d9: D3D9Ex shared surfaces (6023)

Render targets, offscreen plain surfaces and textures made with a shared
handle are shared through the D3DKMT resource that Direct3D 11 uses, in its
layout, so D3D9Ex and Direct3D 11 open each other's (G-SHARED). Also
d3d11: B8G8R8A8/X8 textures were taken for block-compressed ones and never
handed their pixels over.
---
diff --git a/dlls/d3d11/texture.c b/dlls/d3d11/texture.c
index cb1d7ae..43584ea 100644
--- a/dlls/d3d11/texture.c
+++ b/dlls/d3d11/texture.c
@@ -531,7 +531,12 @@ static BOOL texture_pixels_exchangeable(const D3D11_TEXTURE2D_DESC *desc)
 {
     /* Compressed, planar and multisampled textures are not copied. */
     return desc->SampleDesc.Count <= 1 && desc->ArraySize >= 1
+            /* the block-compressed formats are two ranges: B5G6R5..B8G8R8X8_UNORM_SRGB lie between them */
+#ifdef SG_MUTANT_D3D11_BC_RANGE_OLD
             && !(desc->Format >= DXGI_FORMAT_BC1_TYPELESS && desc->Format <= DXGI_FORMAT_BC7_UNORM_SRGB)
+#endif
+            && !(desc->Format >= DXGI_FORMAT_BC1_TYPELESS && desc->Format <= DXGI_FORMAT_BC5_SNORM)
+            && !(desc->Format >= DXGI_FORMAT_BC6H_TYPELESS && desc->Format <= DXGI_FORMAT_BC7_UNORM_SRGB)
             && !(desc->Format >= DXGI_FORMAT_NV12 && desc->Format <= DXGI_FORMAT_V408)
             && !(desc->BindFlags & D3D11_BIND_DEPTH_STENCIL);
 }
