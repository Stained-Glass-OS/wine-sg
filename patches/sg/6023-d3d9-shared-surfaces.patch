+/* Stained Glass OS: a surface made to be shared gets its handle; one made for a shared handle opens it */
+static HRESULT d3d9_device_share_surface(struct d3d9_device *device, struct d3d9_surface *surface, D3DFORMAT format,
+        UINT width, UINT height, HANDLE open_handle, HANDLE *shared_handle)
+{
+    HRESULT hr;
+
+    wined3d_mutex_lock();
+    if (open_handle)
+        hr = d3d9_surface_open_shared(device, surface, format, open_handle);
+    else
+        hr = d3d9_surface_share(device, surface, format, width, height, shared_handle);
+    wined3d_mutex_unlock();
+    return hr;
+}
