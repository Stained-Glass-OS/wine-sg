diff --git a/dlls/d3d9/query.c b/dlls/d3d9/query.c
index 37ec859..69bf549 100644
--- a/dlls/d3d9/query.c
+++ b/dlls/d3d9/query.c
@@ -124,6 +124,14 @@ static HRESULT WINAPI d3d9_query_Issue(IDirect3DQuery9 *iface, DWORD flags)
 {
     struct d3d9_query *query = impl_from_IDirect3DQuery9(iface);
     TRACE("iface %p, flags %#lx.\n", iface, flags);
+
+    /* Stained Glass OS: the end of an event query is where a device that shares a surface is done with it */
+    if ((flags & D3DISSUE_END) && wined3d_query_get_type(query->wined3d_query) == WINED3D_QUERY_TYPE_EVENT)
+    {
+        wined3d_mutex_lock();
+        d3d9_shares_sync(impl_from_IDirect3DDevice9Ex(query->parent_device), TRUE, FALSE);
+        wined3d_mutex_unlock();
+    }
     return wined3d_query_issue(query->wined3d_query, flags);
 }
 
diff --git a/dlls/d3d9/shared.c b/dlls/d3d9/shared.c
new file mode 100644
index 0000000..4ec1557
--- /dev/null
+++ b/dlls/d3d9/shared.c
@@ -0,0 +1,488 @@
+/*
+ * Direct3D 9Ex shared resources (Stained Glass OS)
+ *
+ * A D3D9Ex device makes a render target, an offscreen plain surface or a texture
+ * that other devices and processes open by its shared handle, and opens one that
+ * another device made: Direct3D 11 (WPF's D3DImage hosts a Direct3D 11 render
+ * this way), or another D3D9Ex device. The resource is the D3DKMT resource that
+ * Direct3D 11 makes for a shared texture (system memory, win32u), in the same
+ * layout: its private runtime data says what the texture is, its content holds a
+ * version and the pixels. The device that made the resource hands its pixels
+ * over when it ends a scene, presents or flushes, and when somebody has opened
+ * it; a device that opened it takes what is new when it begins a scene.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "d3d9_private.h"
+#include "winternl.h"
+#include "ddk/d3dkmthk.h"
+#include "d3d11.h"
+#include "wine/kmtshare.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3d9);
+
+/* The private runtime data of a shared resource: Direct3D 11's layout (dlls/d3d11/d3d11_private.h). */
+struct d3d9_shared_runtime
+{
+    UINT magic;                         /* WINE_D3D_SHARED_MAGIC */
+    UINT type;                          /* D3D11_RESOURCE_DIMENSION_TEXTURE2D */
+    LUID luid;
+    UINT mutex_global;                  /* a keyed mutex: not made here */
+    UINT pitch;
+    UINT64 content_size;
+    D3D11_TEXTURE2D_DESC desc2d;
+};
+
+/* The content of a shared resource starts with this; the pixels follow. */
+struct d3d9_shared_content
+{
+    UINT64 version;
+    UINT64 id;
+    LONG readers;
+    LONG pad;
+};
+
+struct d3d9_kmt_share
+{
+    struct list entry;
+    struct d3d9_surface *surface;       /* not referenced: the share goes with it */
+    struct d3d9_device *device;
+    D3DKMT_HANDLE resource, allocation;
+    UINT global;
+    BOOL creator;
+    UINT pitch, width, height, bpp;
+    D3DFORMAT format;
+    UINT64 synced_version;
+};
+
+static SRWLOCK kmt_lock = SRWLOCK_INIT;
+static D3DKMT_HANDLE kmt_adapter, kmt_device;
+static struct list d3d9_kmt_shares = LIST_INIT(d3d9_kmt_shares);
+
+static const struct
+{
+    D3DFORMAT d3d9;
+    DXGI_FORMAT dxgi;
+    UINT bpp;
+}
+share_formats[] =
+{
+    {D3DFMT_A8R8G8B8,      DXGI_FORMAT_B8G8R8A8_UNORM,     4},
+    {D3DFMT_X8R8G8B8,      DXGI_FORMAT_B8G8R8X8_UNORM,     4},
+    {D3DFMT_A8B8G8R8,      DXGI_FORMAT_R8G8B8A8_UNORM,     4},
+    {D3DFMT_A2B10G10R10,   DXGI_FORMAT_R10G10B10A2_UNORM,  4},
+    {D3DFMT_A16B16G16R16F, DXGI_FORMAT_R16G16B16A16_FLOAT, 8},
+    {D3DFMT_A32B32G32R32F, DXGI_FORMAT_R32G32B32A32_FLOAT, 16},
+    {D3DFMT_R5G6B5,        DXGI_FORMAT_B5G6R5_UNORM,       2},
+    {D3DFMT_A1R5G5B5,      DXGI_FORMAT_B5G5R5A1_UNORM,     2},
+    {D3DFMT_R32F,          DXGI_FORMAT_R32_FLOAT,          4},
+    {D3DFMT_G16R16F,       DXGI_FORMAT_R16G16_FLOAT,       4},
+    {D3DFMT_R16F,          DXGI_FORMAT_R16_FLOAT,          2},
+    {D3DFMT_A8,            DXGI_FORMAT_A8_UNORM,           1},
+    {D3DFMT_L8,            DXGI_FORMAT_R8_UNORM,           1},
+};
+
+static BOOL share_format(D3DFORMAT format, DXGI_FORMAT *dxgi, UINT *bpp)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(share_formats); ++i)
+    {
+        if (share_formats[i].d3d9 != format)
+            continue;
+        if (dxgi) *dxgi = share_formats[i].dxgi;
+        if (bpp) *bpp = share_formats[i].bpp;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL share_format_from_dxgi(DXGI_FORMAT dxgi, D3DFORMAT format)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(share_formats); ++i)
+        if (share_formats[i].d3d9 == format && share_formats[i].dxgi == dxgi)
+            return TRUE;
+    /* DXGI's typeless and sRGB forms are the same pixels */
+    if (format == D3DFMT_A8R8G8B8 && (dxgi == DXGI_FORMAT_B8G8R8A8_TYPELESS || dxgi == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB))
+        return TRUE;
+    if (format == D3DFMT_A8B8G8R8 && (dxgi == DXGI_FORMAT_R8G8B8A8_TYPELESS || dxgi == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB))
+        return TRUE;
+    if (format == D3DFMT_X8R8G8B8 && (dxgi == DXGI_FORMAT_B8G8R8X8_TYPELESS || dxgi == DXGI_FORMAT_B8G8R8X8_UNORM_SRGB
+            || dxgi == DXGI_FORMAT_B8G8R8A8_UNORM))
+        return TRUE;
+    return FALSE;
+}
+
+static HRESULT kmt_init(const LUID *luid)
+{
+    D3DKMT_OPENADAPTERFROMLUID adapter = {{0}};
+    D3DKMT_CREATEDEVICE device = {0};
+
+    AcquireSRWLockExclusive(&kmt_lock);
+    if (!kmt_device)
+    {
+        adapter.AdapterLuid = *luid;
+        if (D3DKMTOpenAdapterFromLuid(&adapter))
+        {
+            ReleaseSRWLockExclusive(&kmt_lock);
+            WARN("Failed to open the adapter.\n");
+            return E_FAIL;
+        }
+        device.hAdapter = adapter.hAdapter;
+        if (D3DKMTCreateDevice(&device))
+        {
+            D3DKMT_CLOSEADAPTER close = {adapter.hAdapter};
+            D3DKMTCloseAdapter(&close);
+            ReleaseSRWLockExclusive(&kmt_lock);
+            WARN("Failed to create the device.\n");
+            return E_FAIL;
+        }
+        kmt_adapter = adapter.hAdapter;
+        kmt_device = device.hDevice;
+    }
+    ReleaseSRWLockExclusive(&kmt_lock);
+    return S_OK;
+}
+
+static void device_luid(struct d3d9_device *device, LUID *luid)
+{
+    memset(luid, 0, sizeof(*luid));
+    IDirect3D9Ex_GetAdapterLUID(&device->d3d_parent->IDirect3D9Ex_iface, device->adapter_ordinal, luid);
+}
+
+static HRESULT share_map(struct d3d9_kmt_share *share, struct d3d9_shared_content **content, void **view)
+{
+    struct wine_kmt_escape escape = {WINE_KMT_ESCAPE_MAGIC, WINE_KMT_ESCAPE_MAP_ALLOCATION, share->allocation};
+    D3DKMT_ESCAPE esc = {0};
+    HANDLE section;
+    BYTE *base;
+
+    esc.hAdapter = kmt_adapter;
+    esc.hDevice = kmt_device;
+    esc.Type = D3DKMT_ESCAPE_DRIVERPRIVATE;
+    esc.pPrivateDriverData = &escape;
+    esc.PrivateDriverDataSize = sizeof(escape);
+    if (D3DKMTEscape(&esc))
+        return E_FAIL;
+    section = (HANDLE)(ULONG_PTR)escape.section;
+    base = MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, 0);
+    CloseHandle(section);
+    if (!base)
+        return E_FAIL;
+    *view = base;
+    *content = (struct d3d9_shared_content *)(base + escape.offset);
+    return S_OK;
+}
+
+static BOOL surface_is_render_target(struct d3d9_surface *surface)
+{
+    struct wined3d_resource_desc desc;
+
+    wined3d_resource_get_desc(wined3d_texture_get_resource(surface->wined3d_texture), &desc);
+    return (desc.bind_flags & WINED3D_BIND_RENDER_TARGET) && desc.multisample_type == WINED3D_MULTISAMPLE_NONE;
+}
+
+/* A system memory surface for the pixels that go in or out. */
+static IDirect3DSurface9 *share_staging(struct d3d9_kmt_share *share)
+{
+    IDirect3DSurface9 *staging = NULL;
+
+    IDirect3DDevice9Ex_CreateOffscreenPlainSurface(&share->device->IDirect3DDevice9Ex_iface, share->width,
+            share->height, share->format, D3DPOOL_SYSTEMMEM, &staging, NULL);
+    return staging;
+}
+
+/* The pixels of the surface go into the content, for the others. */
+static void share_push(struct d3d9_kmt_share *share, BOOL force)
+{
+    struct d3d9_shared_content *content;
+    IDirect3DSurface9 *staging;
+    D3DLOCKED_RECT locked;
+    void *view;
+    UINT y;
+
+    if (FAILED(share_map(share, &content, &view)))
+        return;
+    TRACE("share %p, readers %ld, version %s.\n", share, content->readers, wine_dbgstr_longlong(content->version));
+    /* a render target's pixels are read through a copy; a plain surface can be locked */
+    if (!surface_is_render_target(share->surface))
+    {
+        if ((force || content->readers) && SUCCEEDED(IDirect3DSurface9_LockRect(&share->surface->IDirect3DSurface9_iface,
+                &locked, NULL, D3DLOCK_READONLY)))
+        {
+            for (y = 0; y < share->height; ++y)
+                memcpy((BYTE *)(content + 1) + y * share->pitch, (BYTE *)locked.pBits + y * locked.Pitch,
+                        min(share->pitch, (UINT)locked.Pitch));
+            IDirect3DSurface9_UnlockRect(&share->surface->IDirect3DSurface9_iface);
+            share->synced_version = InterlockedIncrement64((LONG64 *)&content->version);
+        }
+    }
+    else if ((force || content->readers) && (staging = share_staging(share)))
+    {
+        if (SUCCEEDED(IDirect3DDevice9Ex_GetRenderTargetData(&share->device->IDirect3DDevice9Ex_iface,
+                &share->surface->IDirect3DSurface9_iface, staging))
+                && SUCCEEDED(IDirect3DSurface9_LockRect(staging, &locked, NULL, D3DLOCK_READONLY)))
+        {
+#ifndef SG_MUTANT_D3D9_SHARE_NO_PIXELS
+            for (y = 0; y < share->height; ++y)
+                memcpy((BYTE *)(content + 1) + y * share->pitch, (BYTE *)locked.pBits + y * locked.Pitch,
+                        min(share->pitch, (UINT)locked.Pitch));
+#endif
+            IDirect3DSurface9_UnlockRect(staging);
+            share->synced_version = InterlockedIncrement64((LONG64 *)&content->version);
+        }
+        IDirect3DSurface9_Release(staging);
+    }
+    UnmapViewOfFile(view);
+}
+
+/* What the others made comes into the surface. */
+static void share_pull(struct d3d9_kmt_share *share)
+{
+    struct d3d9_shared_content *content;
+    IDirect3DSurface9 *staging;
+    D3DLOCKED_RECT locked;
+    void *view;
+    UINT y;
+
+    if (FAILED(share_map(share, &content, &view)))
+        return;
+    TRACE("share %p, version %s, synced %s.\n", share, wine_dbgstr_longlong(content->version),
+            wine_dbgstr_longlong(share->synced_version));
+    if ((ULONGLONG)content->version > share->synced_version && (staging = share_staging(share)))
+    {
+        if (SUCCEEDED(IDirect3DSurface9_LockRect(staging, &locked, NULL, 0)))
+        {
+            for (y = 0; y < share->height; ++y)
+                memcpy((BYTE *)locked.pBits + y * locked.Pitch, (BYTE *)(content + 1) + y * share->pitch,
+                        min(share->pitch, (UINT)locked.Pitch));
+            IDirect3DSurface9_UnlockRect(staging);
+            if (SUCCEEDED(IDirect3DDevice9Ex_UpdateSurface(&share->device->IDirect3DDevice9Ex_iface, staging, NULL,
+                    &share->surface->IDirect3DSurface9_iface, NULL)))
+                share->synced_version = content->version;
+        }
+        IDirect3DSurface9_Release(staging);
+    }
+    UnmapViewOfFile(view);
+}
+
+static void share_register(struct d3d9_kmt_share *share, struct d3d9_surface *surface, struct d3d9_device *device)
+{
+    share->surface = surface;
+    share->device = device;
+    surface->share = share;
+    AcquireSRWLockExclusive(&kmt_lock);
+    list_add_tail(&d3d9_kmt_shares, &share->entry);
+    ReleaseSRWLockExclusive(&kmt_lock);
+}
+
+/* The resource for a surface that is made to be shared; its handle goes to the caller. */
+HRESULT d3d9_surface_share(struct d3d9_device *device, struct d3d9_surface *surface, D3DFORMAT format,
+        UINT width, UINT height, HANDLE *handle)
+{
+    struct wine_kmt_alloc_data data = {sizeof(struct d3d9_shared_content)};
+    struct d3d9_shared_runtime runtime = {0};
+    D3DDDI_ALLOCATIONINFO info = {0};
+    D3DKMT_CREATEALLOCATION create = {0};
+    struct d3d9_shared_content *content;
+    struct d3d9_kmt_share *share;
+    DXGI_FORMAT dxgi;
+    UINT bpp;
+    void *view;
+    HRESULT hr;
+
+    if (!share_format(format, &dxgi, &bpp))
+    {
+        FIXME("Sharing of format %#x is not supported.\n", format);
+        return D3DERR_INVALIDCALL;
+    }
+    device_luid(device, &runtime.luid);
+    if (FAILED(hr = kmt_init(&runtime.luid)))
+        return hr;
+    if (!(share = calloc(1, sizeof(*share))))
+        return E_OUTOFMEMORY;
+
+    runtime.magic = WINE_D3D_SHARED_MAGIC;
+    runtime.type = D3D11_RESOURCE_DIMENSION_TEXTURE2D;
+    runtime.pitch = width * bpp;
+    runtime.content_size = (UINT64)runtime.pitch * height;
+    runtime.desc2d.Width = width;
+    runtime.desc2d.Height = height;
+    runtime.desc2d.MipLevels = 1;
+    runtime.desc2d.ArraySize = 1;
+    runtime.desc2d.Format = dxgi;
+    runtime.desc2d.SampleDesc.Count = 1;
+    runtime.desc2d.Usage = D3D11_USAGE_DEFAULT;
+    runtime.desc2d.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    runtime.desc2d.MiscFlags = D3D11_RESOURCE_MISC_SHARED;
+    data.size += runtime.content_size;
+
+    create.hDevice = kmt_device;
+    create.pPrivateRuntimeData = &runtime;
+    create.PrivateRuntimeDataSize = sizeof(runtime);
+    create.NumAllocations = 1;
+    create.pAllocationInfo = &info;
+    create.Flags.CreateResource = 1;
+    create.Flags.CreateShared = 1;
+    info.pPrivateDriverData = &data;
+    info.PrivateDriverDataSize = sizeof(data);
+    if (D3DKMTCreateAllocation(&create))
+    {
+        WARN("Failed to create the allocation.\n");
+        free(share);
+        return E_FAIL;
+    }
+    share->resource = create.hResource;
+    share->allocation = info.hAllocation;
+    share->global = create.hGlobalShare;
+    share->creator = TRUE;
+    share->pitch = runtime.pitch;
+    share->width = width;
+    share->height = height;
+    share->bpp = bpp;
+    share->format = format;
+    if (SUCCEEDED(share_map(share, &content, &view)))
+    {
+        content->id = ((UINT64)GetCurrentProcessId() << 32) | share->global;
+        UnmapViewOfFile(view);
+    }
+    share_register(share, surface, device);
+    *handle = (HANDLE)(ULONG_PTR)share->global;
+    TRACE("Shared surface %p as %p.\n", surface, *handle);
+    return S_OK;
+}
+
+/* Whether a shared handle is a resource a surface of this description can open. */
+HRESULT d3d9_shared_handle_check(struct d3d9_device *device, HANDLE handle, D3DFORMAT format, UINT width, UINT height)
+{
+    D3DKMT_QUERYRESOURCEINFO query = {0};
+    struct d3d9_shared_runtime runtime = {0};
+    LUID luid;
+    HRESULT hr;
+
+    device_luid(device, &luid);
+    if (FAILED(hr = kmt_init(&luid)))
+        return hr;
+    query.hDevice = kmt_device;
+    query.hGlobalShare = (UINT)(ULONG_PTR)handle;
+    query.pPrivateRuntimeData = &runtime;
+    query.PrivateRuntimeDataSize = sizeof(runtime);
+    if (D3DKMTQueryResourceInfo(&query) || query.NumAllocations != 1
+            || query.PrivateRuntimeDataSize != sizeof(runtime) || runtime.magic != WINE_D3D_SHARED_MAGIC
+            || runtime.type != D3D11_RESOURCE_DIMENSION_TEXTURE2D)
+        return D3DERR_INVALIDCALL;
+#ifndef SG_MUTANT_D3D9_SHARE_NO_DESC_CHECK
+    if (runtime.desc2d.Width != width || runtime.desc2d.Height != height
+            || !share_format_from_dxgi(runtime.desc2d.Format, format))
+    {
+        WARN("The shared resource is %ux%u format %#x, not %ux%u format %#x.\n", runtime.desc2d.Width,
+                runtime.desc2d.Height, runtime.desc2d.Format, width, height, format);
+        return D3DERR_INVALIDCALL;
+    }
+#endif
+    return S_OK;
+}
+
+/* A surface opens the resource of a shared handle (checked) and takes its pixels. */
+HRESULT d3d9_surface_open_shared(struct d3d9_device *device, struct d3d9_surface *surface, D3DFORMAT format,
+        HANDLE handle)
+{
+    D3DDDI_OPENALLOCATIONINFO alloc_info = {0};
+    struct d3d9_shared_runtime runtime = {0};
+    D3DKMT_OPENRESOURCE open = {0};
+    struct d3d9_shared_content *content;
+    struct d3d9_kmt_share *share;
+    char total[256];
+    void *view;
+
+    if (!(share = calloc(1, sizeof(*share))))
+        return E_OUTOFMEMORY;
+    open.hDevice = kmt_device;
+    open.hGlobalShare = (UINT)(ULONG_PTR)handle;
+    open.NumAllocations = 1;
+    open.pOpenAllocationInfo = &alloc_info;
+    open.pPrivateRuntimeData = &runtime;
+    open.PrivateRuntimeDataSize = sizeof(runtime);
+    open.pTotalPrivateDriverDataBuffer = total;
+    open.TotalPrivateDriverDataBufferSize = sizeof(total);
+    if (D3DKMTOpenResource(&open))
+    {
+        free(share);
+        return D3DERR_INVALIDCALL;
+    }
+    share->resource = open.hResource;
+    share->allocation = alloc_info.hAllocation;
+    share->global = open.hGlobalShare;
+    share->pitch = runtime.pitch;
+    share->width = runtime.desc2d.Width;
+    share->height = runtime.desc2d.Height;
+    share->format = format;
+    share_format(format, NULL, &share->bpp);
+    if (!share->pitch)
+        share->pitch = share->width * share->bpp;
+    if (SUCCEEDED(share_map(share, &content, &view)))
+    {
+        InterlockedIncrement(&content->readers);
+        UnmapViewOfFile(view);
+    }
+    share_register(share, surface, device);
+    share_pull(share);
+    return S_OK;
+}
+
+void d3d9_share_destroy(struct d3d9_kmt_share *share)
+{
+    D3DKMT_DESTROYALLOCATION destroy = {0};
+    struct d3d9_shared_content *content;
+    void *view;
+
+    if (!share)
+        return;
+    AcquireSRWLockExclusive(&kmt_lock);
+    list_remove(&share->entry);
+    ReleaseSRWLockExclusive(&kmt_lock);
+    if (!share->creator && SUCCEEDED(share_map(share, &content, &view)))
+    {
+        InterlockedDecrement(&content->readers);
+        UnmapViewOfFile(view);
+    }
+    destroy.hDevice = kmt_device;
+    destroy.hResource = share->resource;
+    D3DKMTDestroyAllocation(&destroy);
+    free(share);
+}
+
+/* The device's shared surfaces hand over and take what they hold. */
+void d3d9_shares_sync(struct d3d9_device *device, BOOL push, BOOL pull)
+{
+    struct d3d9_kmt_share *share;
+
+    if (list_empty(&d3d9_kmt_shares))
+        return;
+    AcquireSRWLockShared(&kmt_lock);
+    LIST_FOR_EACH_ENTRY(share, &d3d9_kmt_shares, struct d3d9_kmt_share, entry)
+    {
+        if (share->device != device)
+            continue;
+        if (share->creator && push)
+            share_push(share, FALSE);
+        else if (!share->creator && pull)
+            share_pull(share);
+    }
+    ReleaseSRWLockShared(&kmt_lock);
+}
