+static HRESULT create_enum_props(const ENUMPROPERTY *items, ULONG count, ULONG pos, IMimeEnumProperties **ret)
+{
+    enum_props *This;
+    ULONG i;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->IMimeEnumProperties_iface.lpVtbl = &enum_props_vtbl;
+    This->ref = 1;
+    This->count = count;
+    This->pos = pos;
+    if (count && !(This->items = calloc(count, sizeof(*This->items))))
+    {
+        free(This);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        This->items[i] = items[i];
+        if (items[i].pszName) This->items[i].pszName = strdup(items[i].pszName);
+    }
+    *ret = &This->IMimeEnumProperties_iface;
+    return S_OK;
+}
