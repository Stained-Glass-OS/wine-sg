+/* An attachment is anything but plain readable text: disposition "attachment" says so, "inline" or a
+ * text, html or multipart type without a file name says not. */
+static BOOL body_is_attachment(MimeBody *This)
+{
+    header_t *header;
+    const char *pri = This->content_pri_type ? This->content_pri_type : "text";
+    const char *sub = This->content_sub_type ? This->content_sub_type : "plain";
+    param_t *param;
+
+#ifdef SG_MUTANT_ISTYPE_ATT
+    return TRUE;
+#endif
+    if (This->main_text) return FALSE;
+    if (find_prop(This, "Content-Disposition", &header) == S_OK && header->value.vt == VT_LPSTR && header->value.pszVal)
+    {
+        if (!lstrcmpiA(header->value.pszVal, "attachment")) return TRUE;
+        if (!lstrcmpiA(header->value.pszVal, "inline")) return FALSE;
+    }
+    if (!lstrcmpiA(pri, "multipart")) return FALSE;
+    if (This->in_message) return TRUE; /* a part that is not the text the message shows */
+    if (!lstrcmpiA(pri, "text") && (!lstrcmpiA(sub, "plain") || !lstrcmpiA(sub, "html")))
+    {
+        if (find_prop(This, "Content-Disposition", &header) == S_OK)
+            LIST_FOR_EACH_ENTRY(param, &header->params, param_t, entry)
+                if (!lstrcmpiA(param->name, "filename")) return TRUE;
+        return FALSE;
+    }
+    return TRUE;
 }
 
