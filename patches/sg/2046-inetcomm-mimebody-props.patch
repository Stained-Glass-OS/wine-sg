+/* Does a header belong to the property a name (or #id string) stands for? */
+static BOOL header_matches(const header_t *header, const char *name)
+{
+    if (ISPIDSTR(name)) return STRTOPID(name) == header->prop->id;
+    return !lstrcmpiA(name, header->prop->name);
+}
+
+static void delete_headers_named(MimeBody *body, const char *name)
+{
+    header_t *header, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(header, next, &body->headers, header_t, entry)
+        if (header_matches(header, name)) free_header(header);
+}
+
+/* Copy one header, parameters and all, to another of our bodies */
+static HRESULT copy_header(MimeBody *dst, const header_t *src)
+{
+    header_t *header;
+    param_t *param, *copy;
+    HRESULT hr;
+
+    if (FAILED(hr = new_header(dst, src->prop->name, src->prop->default_vt, &header))) return hr;
+    if (FAILED(hr = PropVariantCopy(&header->value, &src->value)))
+    {
+        free_header(header);
+        return hr;
+    }
+    header->flags = src->flags;
+    header->row_number = src->row_number;
+    header->encoding = src->encoding;
+    header->charset = src->charset;
+    LIST_FOR_EACH_ENTRY(param, &src->params, param_t, entry)
+    {
+        if (!(copy = malloc(sizeof(*copy)))) return E_OUTOFMEMORY;
+        copy->name = strdup(param->name);
+        copy->value = strdup(param->value);
+        list_add_tail(&header->params, &copy->entry);
+    }
+    if (header->value.vt == VT_LPSTR && header->value.pszVal)
+    {
+        if (header->prop->id == PID_HDR_CNTTYPE)
+        {
+            free(dst->content_pri_type);
+            free(dst->content_sub_type);
+            dst->content_pri_type = dst->content_sub_type = NULL;
+            init_content_type(dst, header);
+        }
+        else if (header->prop->id == PID_HDR_CNTXFER)
+            init_content_encoding(dst, header);
+    }
+    MIMEBODY_SET_DIRTY(dst);
+    return S_OK;
+}
+
+static BOOL name_listed(const header_t *header, ULONG count, LPCSTR *names)
+{
+    ULONG i;
+
+    for (i = 0; i < count; i++)
+        if (names[i] && header_matches(header, names[i])) return TRUE;
+    return FALSE;
+}
+
+/* CopyProps and MoveProps: the named properties (all of them for a NULL list) go to another set */
+static HRESULT copy_props(MimeBody *This, ULONG count, LPCSTR *names, IMimePropertySet *dest, BOOL move)
+{
+    MimeBody *dst_body = NULL;
+    header_t *header, *next, *earlier;
+    HRESULT hr = S_OK;
+
+    if (!dest) return E_INVALIDARG;
+    if (count && !names) return E_INVALIDARG;
+    if ((const void *)dest->lpVtbl == (const void *)&body_vtbl)
+        dst_body = impl_from_IMimeBody((IMimeBody *)dest);
+    if (dst_body == This) return S_OK;
+
+    LIST_FOR_EACH_ENTRY_SAFE(header, next, &This->headers, header_t, entry)
+    {
+        BOOL first = TRUE;
+
+        if (names && !name_listed(header, count, names)) continue;
+
+        /* the copy replaces what the destination has of that property */
+        LIST_FOR_EACH_ENTRY(earlier, &This->headers, header_t, entry)
+        {
+            if (earlier == header) break;
+            if (earlier->prop->id == header->prop->id) { first = FALSE; break; }
+        }
+#ifdef SG_MUTANT_PROPS_REPLACE
+        first = FALSE;
+#endif
+        if (first)
+        {
+            if (dst_body) delete_headers_named(dst_body, header->prop->name);
+            else while (IMimePropertySet_DeleteProp(dest, header->prop->name) == S_OK) {}
+        }
+
+        if (dst_body) hr = copy_header(dst_body, header);
+        else hr = IMimePropertySet_AppendProp(dest, header->prop->name, 0, &header->value);
+        if (FAILED(hr)) return hr;
+        if (move) free_header(header);
+    }
+    if (move) MIMEBODY_SET_DIRTY(This);
+    return S_OK;
+}
