+typedef struct
+{
+    IMimeEnumProperties IMimeEnumProperties_iface;
+    LONG ref;
+    ENUMPROPERTY *items;
+    ULONG count, pos;
+} enum_props;
+
+static inline enum_props *impl_from_IMimeEnumProperties(IMimeEnumProperties *iface)
+{
+    return CONTAINING_RECORD(iface, enum_props, IMimeEnumProperties_iface);
+}
+
+static HRESULT WINAPI enum_props_QueryInterface(IMimeEnumProperties *iface, REFIID riid, void **ppv)
+{
+    TRACE("(%p)->(%s, %p)\n", iface, debugstr_guid(riid), ppv);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IMimeEnumProperties))
+    {
+        *ppv = iface;
+        IMimeEnumProperties_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_props_AddRef(IMimeEnumProperties *iface)
+{
+    enum_props *This = impl_from_IMimeEnumProperties(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI enum_props_Release(IMimeEnumProperties *iface)
+{
+    enum_props *This = impl_from_IMimeEnumProperties(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    ULONG i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) free(This->items[i].pszName);
+        free(This->items);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_props_Next(IMimeEnumProperties *iface, ULONG cFetch, ENUMPROPERTY *prgProp, ULONG *pcFetched)
+{
+    enum_props *This = impl_from_IMimeEnumProperties(iface);
+    ULONG n = 0;
+
+    TRACE("(%p)->(%lu, %p, %p)\n", This, cFetch, prgProp, pcFetched);
+
+    if (!prgProp || (!pcFetched && cFetch > 1))
+        return E_INVALIDARG;
+
+    while (n < cFetch && This->pos < This->count)
+    {
+        const ENUMPROPERTY *item = &This->items[This->pos];
+
+        prgProp[n] = *item;
+        if (item->pszName)
+        {
+            /* the caller frees the names, with the allocator */
+            if (!(prgProp[n].pszName = CoTaskMemAlloc(strlen(item->pszName) + 1)))
+            {
+                while (n--) CoTaskMemFree(prgProp[n].pszName);
+                if (pcFetched) *pcFetched = 0;
+                return E_OUTOFMEMORY;
+            }
+            strcpy(prgProp[n].pszName, item->pszName);
+        }
+        n++;
+        This->pos++;
+    }
+    if (pcFetched) *pcFetched = n;
+    return n == cFetch ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_props_Skip(IMimeEnumProperties *iface, ULONG cItems)
+{
