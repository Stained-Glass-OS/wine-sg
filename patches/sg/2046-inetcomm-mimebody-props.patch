+static HRESULT WINAPI enum_props_Clone(IMimeEnumProperties *iface, IMimeEnumProperties **ppEnum)
+{
+    enum_props *This = impl_from_IMimeEnumProperties(iface);
+
+    TRACE("(%p)->(%p)\n", This, ppEnum);
+
+    if (!ppEnum) return E_INVALIDARG;
+    return create_enum_props(This->items, This->count, This->pos, ppEnum);
+}
+
+static HRESULT WINAPI enum_props_Count(IMimeEnumProperties *iface, ULONG *pcItems)
