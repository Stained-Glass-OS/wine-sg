+/* The first plain or html text of a message is what it shows; the other parts are attachments. */
+static BOOL mark_main_text(struct list *bodies)
+{
+    body_t *body;
+
+    LIST_FOR_EACH_ENTRY(body, bodies, body_t, entry)
+    {
+        MimeBody *mb = body->mime_body;
+        const char *pri = mb->content_pri_type ? mb->content_pri_type : "text";
+        const char *sub = mb->content_sub_type ? mb->content_sub_type : "plain";
+        header_t *disp;
+
+        if (!list_empty(&body->children))
+        {
+            if (mark_main_text(&body->children)) return TRUE;
+            continue;
+        }
+        if (lstrcmpiA(pri, "text") || (lstrcmpiA(sub, "plain") && lstrcmpiA(sub, "html"))) continue;
+        if (find_prop(mb, "Content-Disposition", &disp) == S_OK && disp->value.vt == VT_LPSTR &&
+            disp->value.pszVal && !lstrcmpiA(disp->value.pszVal, "attachment")) continue;
+        mb->main_text = TRUE;
+        return TRUE;
+    }
+    return FALSE;
+}
