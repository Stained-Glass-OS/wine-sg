+/* the selection's paths, double-null terminated, from the view */
+static WCHAR *selected_paths(int *count)
+{
+    IShellView *sv;
+    IDataObject *data;
+    FORMATETC fmt = { CF_HDROP, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    STGMEDIUM med;
+    WCHAR *list = NULL, *p, path[MAX_PATH];
+    UINT i, n, len = 1;
+
+    *count = 0;
+    if (fe.content == CONTENT_SEARCH) return selected_result_paths(count);
+    if (fe.content != CONTENT_FOLDER || !(sv = get_view())) return NULL;
+    if (SUCCEEDED(IShellView_GetItemObject(sv, SVGIO_SELECTION, &IID_IDataObject, (void **)&data)))
+    {
+        if (SUCCEEDED(IDataObject_GetData(data, &fmt, &med)))
+        {
+            HDROP drop = GlobalLock(med.hGlobal);
+            n = DragQueryFileW(drop, ~0u, NULL, 0);
+            for (i = 0; i < n; i++) len += DragQueryFileW(drop, i, NULL, 0) + 1;
+            p = list = calloc(len, sizeof(WCHAR));
+            for (i = 0; i < n; i++)
+            {
+                DragQueryFileW(drop, i, path, MAX_PATH);
+                lstrcpyW(p, path);
+                p += lstrlenW(p) + 1;
+            }
+            *count = n;
+            GlobalUnlock(med.hGlobal);
+            ReleaseStgMedium(&med);
+        }
+        IDataObject_Release(data);
+    }
+    IShellView_Release(sv);
+    return list;
+}
+
+/* Delete moves to the Recycle Bin without asking, as on Windows 10;
+ * Shift+Delete deletes for good, after asking */
+static void delete_selection(BOOL permanent)
+{
+    SHFILEOPSTRUCTW op = { 0 };
+    int count;
+    WCHAR *list = selected_paths(&count), *p;
+
+    if (!list) return;
+    op.hwnd = fe.hwnd;
+    op.wFunc = FO_DELETE;
+    op.pFrom = list;
+    op.fFlags = permanent ? 0 : FOF_ALLOWUNDO | FOF_NOCONFIRMATION;
+    SHFileOperationW(&op);
+    for (p = list; *p; p += lstrlenW(p) + 1)
+    {
+        if (GetFileAttributesW(p) != INVALID_FILE_ATTRIBUTES) continue;
+        SHChangeNotify(SHCNE_DELETE, SHCNF_PATHW, p, NULL);
+        SHChangeNotify(SHCNE_RMDIR, SHCNF_PATHW, p, NULL);
+        if (fe.content == CONTENT_SEARCH)
+        {
+            int i, n = SendMessageW(fe.results, LVM_GETITEMCOUNT, 0, 0);
+            for (i = n - 1; i >= 0; i--)
+            {
+                struct result *r = result_at(i);
+                if (r && !wcsicmp(r->path, p))
+                {
+                    SendMessageW(fe.results, LVM_DELETEITEM, i, 0);
+                    free(r->path);
+                    free(r);
+                    fe.nresults--;
+                }
+            }
+        }
+    }
+    free(list);
+    update_status();
+}
