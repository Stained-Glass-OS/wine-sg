+static void rename_selection(void)
+{
+    IFolderView2 *fv;
+    IShellView *sv;
+    int index = -1;
+    ITEMIDLIST *child;
+    HWND list;
+
+    if (fe.content != CONTENT_FOLDER || !(fv = get_folder_view())) return;
+    if ((list = get_view_list())) index = SendMessageW(list, LVM_GETNEXTITEM, -1, LVNI_FOCUSED | LVNI_SELECTED);
+    if (index < 0 && list) index = SendMessageW(list, LVM_GETNEXTITEM, -1, LVNI_SELECTED);
+    if (index >= 0 && SUCCEEDED(IFolderView2_Item(fv, index, &child)))
+    {
+        if ((sv = get_view()))
+        {
+            IShellView_SelectItem(sv, child, SVSI_EDIT);
+            IShellView_Release(sv);
+        }
+        ILFree(child);
+    }
+    IFolderView2_Release(fv);
+}
