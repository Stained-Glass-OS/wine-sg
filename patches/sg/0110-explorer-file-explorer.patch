+static void register_classes(void)
+{
+    WNDCLASSEXW wc = { sizeof(wc) };
+
+    wc.hInstance = GetModuleHandleW(NULL);
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW);
+    wc.hbrBackground = NULL;
+
+    wc.lpfnWndProc = frame_proc;
+    wc.lpszClassName = L"ExplorerWClass";
+    ExtractIconExW(L"shell32.dll", -4, &wc.hIcon, &wc.hIconSm, 1);
+    wc.cbWndExtra = sizeof(LONG_PTR);
+    RegisterClassExW(&wc);
+    wc.hIcon = wc.hIconSm = NULL;
+    wc.cbWndExtra = 0;
+
+    wc.lpfnWndProc = cmdbar_proc;
+    wc.lpszClassName = L"SGExplorerCommandBar";
+    RegisterClassExW(&wc);
+    wc.lpfnWndProc = addrbar_proc;
+    wc.lpszClassName = L"SGExplorerAddressBar";
+    RegisterClassExW(&wc);
+    wc.lpfnWndProc = status_proc;
+    wc.lpszClassName = L"SGExplorerStatusBar";
+    RegisterClassExW(&wc);
+    wc.style = CS_DBLCLKS;
+    wc.lpfnWndProc = thispc_proc;
+    wc.lpszClassName = L"SGExplorerThisPC";
+    RegisterClassExW(&wc);
+}
+
+static void create_fonts(void)
+{
+    NONCLIENTMETRICSW ncm = { sizeof(ncm) };
+    LOGFONTW lf;
+    TEXTMETRICW tm;
+    HDC dc;
+
+    SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0);
+    lf = ncm.lfMessageFont;
+    fe.font = CreateFontIndirectW(&lf);
+    lf.lfHeight = -MulDiv(11, fe.dpi, 72);
+    lf.lfWeight = FW_SEMIBOLD;
+    fe.font_heading = CreateFontIndirectW(&lf);
+    lf = ncm.lfMessageFont;
+    lf.lfHeight = lf.lfHeight * 9 / 10;
+    fe.font_small = CreateFontIndirectW(&lf);
+    dc = GetDC(0);
+    SelectObject(dc, fe.font);
+    GetTextMetricsW(dc, &tm);
+    fe.font_height = tm.tmHeight;
+    ReleaseDC(0, dc);
+}
