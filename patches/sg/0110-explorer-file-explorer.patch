+/* ------------------------------------------------------------------------ */
+/* navigation pane                                                          */
+
+static WNDPROC tree_default_proc;
+static HTREEITEM tree_hot, tree_quick, tree_pc, tree_network;
+
+static struct tree_node *node_of(HTREEITEM item)
+{
+    TVITEMW tvi = { TVIF_PARAM, item };
+    if (!item || !SendMessageW(fe.tree, TVM_GETITEMW, 0, (LPARAM)&tvi)) return NULL;
+    return (struct tree_node *)tvi.lParam;
+}
+
+static HTREEITEM tree_add(HTREEITEM parent, const ITEMIDLIST *pidl, const WCHAR *name, BOOL children, int glyph)
+{
+    TVINSERTSTRUCTW tvis = { parent, TVI_LAST };
+    struct tree_node *node = calloc(1, sizeof(*node));
+    WCHAR buf[MAX_PATH];
+
+    node->pidl = pidl ? ILClone(pidl) : NULL;
+    node->glyph = glyph;
+    if (!name) { display_name(pidl, buf, MAX_PATH); name = buf; }
+    tvis.item.mask = TVIF_TEXT | TVIF_PARAM | TVIF_CHILDREN;
+    tvis.item.pszText = (WCHAR *)name;
+    tvis.item.lParam = (LPARAM)node;
+    tvis.item.cChildren = children ? 1 : 0;
+    return (HTREEITEM)SendMessageW(fe.tree, TVM_INSERTITEMW, 0, (LPARAM)&tvis);
+}
+
+static void tree_load_children(HTREEITEM item)
+{
+    struct tree_node *node = node_of(item);
+    IShellFolder *desktop, *folder = NULL;
+    IEnumIDList *ids;
+    ITEMIDLIST *child;
+    int count = 0;
+
+    if (!node || node->loaded || !node->pidl) return;
+    node->loaded = TRUE;
+    SHGetDesktopFolder(&desktop);
+    if (ILIsEmpty(node->pidl)) { folder = desktop; IShellFolder_AddRef(folder); }
+    else IShellFolder_BindToObject(desktop, node->pidl, NULL, &IID_IShellFolder, (void **)&folder);
+    if (folder && IShellFolder_EnumObjects(folder, fe.hwnd, SHCONTF_FOLDERS, &ids) == S_OK)
+    {
+        ITEMIDLIST *items[512];
+        int n = 0, i, j;
+        while (n < ARRAY_SIZE(items) && IEnumIDList_Next(ids, 1, &child, NULL) == S_OK) items[n++] = child;
+        IEnumIDList_Release(ids);
+        /* in name order, as Windows lists them */
+        for (i = 1; i < n; i++)
+            for (j = i; j > 0 && (SHORT)HRESULT_CODE(IShellFolder_CompareIDs(folder, 0, items[j - 1], items[j])) > 0; j--)
+            {
+                ITEMIDLIST *t = items[j]; items[j] = items[j - 1]; items[j - 1] = t;
+            }
+        for (i = 0; i < n; i++)
+        {
+            SFGAOF attrs = SFGAO_HASSUBFOLDER | SFGAO_FOLDER;
+            ITEMIDLIST *full = ILCombine(node->pidl, items[i]);
+            IShellFolder_GetAttributesOf(folder, 1, (const ITEMIDLIST **)&items[i], &attrs);
+            tree_add(item, full, NULL, !!(attrs & SFGAO_HASSUBFOLDER), G_NONE);
+            ILFree(full);
+            ILFree(items[i]);
+            count++;
+        }
+    }
+    if (folder) IShellFolder_Release(folder);
+    IShellFolder_Release(desktop);
+    if (!count)
+    {
+        TVITEMW tvi = { TVIF_CHILDREN, item };
+        tvi.cChildren = 0;
+        SendMessageW(fe.tree, TVM_SETITEMW, 0, (LPARAM)&tvi);
+    }
+}
+
+static void build_tree(void)
+{
+    ITEMIDLIST *pidl;
+    IShellFolder *desktop, *pc;
+    IEnumIDList *ids;
+    unsigned int i;
+    static const KNOWNFOLDERID *quick[] = { &FOLDERID_Desktop, &FOLDERID_Downloads, &FOLDERID_Documents, &FOLDERID_Pictures };
+
+    tree_quick = tree_add(TVI_ROOT, NULL, L"Quick access", TRUE, G_STAR);
+    node_of(tree_quick)->heading = TRUE;
+    node_of(tree_quick)->loaded = TRUE;
+    for (i = 0; i < ARRAY_SIZE(quick); i++)
+        if ((pidl = known_folder(quick[i]))) { tree_add(tree_quick, pidl, NULL, FALSE, G_NONE); ILFree(pidl); }
+
+    tree_pc = tree_add(TVI_ROOT, fe.mycomputer, NULL, TRUE, G_NONE);
+    node_of(tree_pc)->loaded = TRUE;
+    for (i = 0; i < ARRAY_SIZE(pc_folders); i++)
+        if ((pidl = known_folder(pc_folders[i]))) { tree_add(tree_pc, pidl, NULL, TRUE, G_NONE); ILFree(pidl); }
+    SHGetDesktopFolder(&desktop);
+    if (SUCCEEDED(IShellFolder_BindToObject(desktop, fe.mycomputer, NULL, &IID_IShellFolder, (void **)&pc)))
+    {
+        if (IShellFolder_EnumObjects(pc, fe.hwnd, SHCONTF_FOLDERS, &ids) == S_OK)
+        {
+            ITEMIDLIST *child;
+            while (IEnumIDList_Next(ids, 1, &child, NULL) == S_OK)
+            {
+                ITEMIDLIST *full = ILCombine(fe.mycomputer, child);
+                WCHAR path[MAX_PATH];
+                if (pidl_path(full, path) && PathIsRootW(path)) tree_add(tree_pc, full, NULL, TRUE, G_NONE);
+                ILFree(full);
+                ILFree(child);
+            }
+            IEnumIDList_Release(ids);
+        }
+        IShellFolder_Release(pc);
+    }
+    IShellFolder_Release(desktop);
+
+    if (SUCCEEDED(SHGetSpecialFolderLocation(NULL, CSIDL_NETWORK, &pidl)))
+    {
+        tree_network = tree_add(TVI_ROOT, pidl, NULL, FALSE, G_NONE);
+        ILFree(pidl);
+    }
+    SendMessageW(fe.tree, TVM_EXPAND, TVE_EXPAND, (LPARAM)tree_quick);
+    SendMessageW(fe.tree, TVM_EXPAND, TVE_EXPAND, (LPARAM)tree_pc);
+}
+
+static int tree_level(HTREEITEM item)
+{
+    int level = 0;
+    while ((item = (HTREEITEM)SendMessageW(fe.tree, TVM_GETNEXTITEM, TVGN_PARENT, (LPARAM)item))) level++;
+    return level;
+}
+
+static int tree_chevron_right(HTREEITEM item)
+{
+    return S(6) + tree_level(item) * S(14) + S(16);
+}
+
+static LRESULT tree_custom_draw(NMTVCUSTOMDRAW *cd)
+{
+    HTREEITEM item = (HTREEITEM)cd->nmcd.dwItemSpec;
+    struct tree_node *node;
+    TVITEMW tvi;
+    WCHAR name[MAX_PATH];
+    RECT rc, t;
+    HDC dc = cd->nmcd.hdc;
+    int x;
+
+    if (cd->nmcd.dwDrawStage == CDDS_PREPAINT) return CDRF_NOTIFYITEMDRAW;
+    if (cd->nmcd.dwDrawStage != CDDS_ITEMPREPAINT) return CDRF_DODEFAULT;
+
+    node = node_of(item);
+    tvi.mask = TVIF_TEXT | TVIF_STATE | TVIF_CHILDREN;
+    tvi.hItem = item;
+    tvi.pszText = name;
+    tvi.cchTextMax = MAX_PATH;
+    tvi.stateMask = TVIS_SELECTED | TVIS_EXPANDED;
+    SendMessageW(fe.tree, TVM_GETITEMW, 0, (LPARAM)&tvi);
+
+    rc = cd->nmcd.rc;
+    fill(dc, &rc, C_BG);
+    if (tvi.state & TVIS_SELECTED) fill(dc, &rc, C_SELECTED);
+    else if (item == tree_hot) fill(dc, &rc, C_HOT);
+
+    x = rc.left + S(6) + tree_level(item) * S(14);
+    if (tvi.cChildren)
+        draw_glyph(dc, (tvi.state & TVIS_EXPANDED) ? G_CHEVRON_DOWN : G_CHEVRON_RIGHT, x + S(2),
+                   rc.top + (rc.bottom - rc.top - S(12)) / 2, S(12), item == tree_hot ? C_TEXT : C_MUTED);
+    x += S(18);
+    if (node && node->glyph != G_NONE)
+        draw_glyph(dc, node->glyph, x, rc.top + (rc.bottom - rc.top - S(16)) / 2, S(16), C_ACCENT);
+    else if (node && node->pidl)
+    {
+        int icon = small_icon(node->pidl);
+        if (icon >= 0) ImageList_Draw(fe.small_icons, icon, dc, x, rc.top + (rc.bottom - rc.top - S(16)) / 2, ILD_TRANSPARENT);
+    }
+    x += S(16) + S(8);
+    t = rc;
+    t.left = x;
+    t.right -= S(4);
+    SelectObject(dc, fe.font);
+    text(dc, name, &t, C_TEXT, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_END_ELLIPSIS);
+    return CDRF_SKIPDEFAULT;
+}
+
+static LRESULT CALLBACK tree_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    TVHITTESTINFO ht;
+
+    switch (msg)
+    {
+    case WM_MOUSEMOVE:
+    {
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd };
+        HTREEITEM old = tree_hot;
+        ht.pt.x = GET_X_LPARAM(lp); ht.pt.y = GET_Y_LPARAM(lp);
+        tree_hot = (HTREEITEM)SendMessageW(hwnd, TVM_HITTEST, 0, (LPARAM)&ht);
+        if (!(ht.flags & (TVHT_ONITEM | TVHT_ONITEMINDENT | TVHT_ONITEMBUTTON | TVHT_ONITEMRIGHT))) tree_hot = NULL;
+        if (old != tree_hot) InvalidateRect(hwnd, NULL, FALSE);
+        TrackMouseEvent(&tme);
+        break;
+    }
+    case WM_MOUSELEAVE:
+        tree_hot = NULL;
+        InvalidateRect(hwnd, NULL, FALSE);
+        break;
+    case WM_LBUTTONDOWN:
+    case WM_LBUTTONDBLCLK:
+    {
+        HTREEITEM item;
+        struct tree_node *node;
+        ht.pt.x = GET_X_LPARAM(lp); ht.pt.y = GET_Y_LPARAM(lp);
+        item = (HTREEITEM)SendMessageW(hwnd, TVM_HITTEST, 0, (LPARAM)&ht);
+        if (!item) return 0;
+        node = node_of(item);
+        /* the chevron, or a heading: expand and collapse */
+        if (ht.pt.x < tree_chevron_right(item) || (node && node->heading))
+        {
+            SendMessageW(hwnd, TVM_EXPAND, TVE_TOGGLE, (LPARAM)item);
+            return 0;
+        }
+        SetFocus(hwnd);
+        fe.syncing_tree = TRUE;
+        SendMessageW(hwnd, TVM_SELECTITEM, TVGN_CARET, (LPARAM)item);
+        fe.syncing_tree = FALSE;
+        if (node && node->pidl && (fe.content == CONTENT_SEARCH || !fe.pidl || !ILIsEqual(node->pidl, fe.pidl)))
+        {
+            if (fe.content == CONTENT_SEARCH) exit_search(FALSE);
+            navigate(node->pidl);
+        }
+        return 0;
+    }
+    }
+    return CallWindowProcW(tree_default_proc, hwnd, msg, wp, lp);
+}
+
+static LRESULT tree_notify(NMHDR *hdr)
+{
+    switch (hdr->code)
+    {
+    case NM_CUSTOMDRAW:
+        return tree_custom_draw((NMTVCUSTOMDRAW *)hdr);
+    case TVN_ITEMEXPANDINGW:
+    {
+        NMTREEVIEWW *nm = (NMTREEVIEWW *)hdr;
+        if (nm->action & TVE_EXPAND) tree_load_children(nm->itemNew.hItem);
+        return 0;
+    }
+    case TVN_SELCHANGEDW:
+    {
+        NMTREEVIEWW *nm = (NMTREEVIEWW *)hdr;
+        struct tree_node *node = (struct tree_node *)nm->itemNew.lParam;
+        if (fe.syncing_tree || !node || !node->pidl) return 0;
+        if (nm->action == TVC_BYMOUSE || nm->action == TVC_BYKEYBOARD)
+        {
+            if (fe.content == CONTENT_SEARCH) exit_search(FALSE);
+            navigate(node->pidl);
+        }
+        return 0;
+    }
+    case TVN_DELETEITEMW:
+    {
+        NMTREEVIEWW *nm = (NMTREEVIEWW *)hdr;
+        struct tree_node *node = (struct tree_node *)nm->itemOld.lParam;
+        if (node) { ILFree(node->pidl); free(node); }
+        return 0;
+    }
+    case NM_RCLICK:
+    {
+        TVHITTESTINFO ht;
+        struct tree_node *node;
+        IShellFolder *parent;
+        const ITEMIDLIST *child;
+        IContextMenu *cm;
+        HTREEITEM item;
+
+        GetCursorPos(&ht.pt);
+        ScreenToClient(fe.tree, &ht.pt);
+        item = (HTREEITEM)SendMessageW(fe.tree, TVM_HITTEST, 0, (LPARAM)&ht);
+        if (!(node = node_of(item)) || !node->pidl) return 0;
+        if (SUCCEEDED(SHBindToParent(node->pidl, &IID_IShellFolder, (void **)&parent, &child)))
+        {
+            if (SUCCEEDED(IShellFolder_GetUIObjectOf(parent, fe.hwnd, 1, &child, &IID_IContextMenu, NULL, (void **)&cm)))
+            {
+                HMENU menu = CreatePopupMenu();
+                POINT pt;
+                int cmd;
+                IContextMenu_QueryContextMenu(cm, menu, 0, 1, 0x7fff, CMF_NORMAL | CMF_EXPLORE);
+                GetCursorPos(&pt);
+                cmd = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_RIGHTBUTTON, pt.x, pt.y, 0, fe.hwnd, NULL);
+                if (cmd > 0)
+                {
+                    CMINVOKECOMMANDINFO ici = { sizeof(ici) };
+                    ici.hwnd = fe.hwnd;
+                    ici.lpVerb = MAKEINTRESOURCEA(cmd - 1);
+                    ici.nShow = SW_SHOWNORMAL;
+                    IContextMenu_InvokeCommand(cm, &ici);
+                }
+                DestroyMenu(menu);
+                IContextMenu_Release(cm);
+            }
+            IShellFolder_Release(parent);
+        }
+        return 1;
+    }
+    }
+    return 0;
+}
+
+static HTREEITEM tree_find(HTREEITEM item, const ITEMIDLIST *pidl)
+{
+    for (; item; item = (HTREEITEM)SendMessageW(fe.tree, TVM_GETNEXTITEM, TVGN_NEXT, (LPARAM)item))
+    {
+        struct tree_node *node = node_of(item);
+        HTREEITEM child, found;
+        if (node && node->pidl && ILIsEqual(node->pidl, pidl)) return item;
+        if (node && node->pidl && !ILIsParent(node->pidl, pidl, FALSE)) continue;
+        child = (HTREEITEM)SendMessageW(fe.tree, TVM_GETNEXTITEM, TVGN_CHILD, (LPARAM)item);
+        if ((found = tree_find(child, pidl))) return found;
+    }
+    return NULL;
+}
+
+static void sync_tree(void)
+{
+    HTREEITEM item = NULL, child;
+
+    if (!fe.pidl) return;
+    /* This PC's branch first, then the rest */
+    if (tree_pc)
+    {
+        struct tree_node *node = node_of(tree_pc);
+        if (node && ILIsEqual(node->pidl, fe.pidl)) item = tree_pc;
+        else if ((child = (HTREEITEM)SendMessageW(fe.tree, TVM_GETNEXTITEM, TVGN_CHILD, (LPARAM)tree_pc)))
+            item = tree_find(child, fe.pidl);
+    }
+    if (!item) item = tree_find((HTREEITEM)SendMessageW(fe.tree, TVM_GETNEXTITEM, TVGN_ROOT, 0), fe.pidl);
+    fe.syncing_tree = TRUE;
+    SendMessageW(fe.tree, TVM_SELECTITEM, TVGN_CARET, (LPARAM)item);
+    if (item) SendMessageW(fe.tree, TVM_ENSUREVISIBLE, 0, (LPARAM)item);
+    fe.syncing_tree = FALSE;
+}
