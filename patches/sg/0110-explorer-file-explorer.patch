+/* a known folder as its file system location, so it matches the paths a user browses */
+static ITEMIDLIST *known_folder(const KNOWNFOLDERID *id)
+{
+    ITEMIDLIST *pidl = NULL;
+    WCHAR *path;
+
+    if (SUCCEEDED(SHGetKnownFolderPath(id, 0, NULL, &path)))
+    {
+        pidl = ILCreateFromPathW(path);
+        CoTaskMemFree(path);
+    }
+    if (!pidl) SHGetKnownFolderIDList(id, 0, NULL, &pidl);
+    return pidl;
+}
