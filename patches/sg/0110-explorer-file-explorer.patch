+static void cmd_dropdown(struct cmd_item *c)
+{
+    HMENU menu = CreatePopupMenu(), show;
+    UINT mode = current_view_mode(), i;
+    BOOL folder = fe.content == CONTENT_FOLDER;
+    int cmd;
+
+    switch (c->id)
+    {
+    case CMD_NEW:
+        AppendMenuW(menu, MF_STRING, CMD_NEWFOLDER, L"Folder\tCtrl+Shift+N");
+        AppendMenuW(menu, MF_STRING, CMD_NEWTEXT, L"Text Document");
+        break;
+    case CMD_VIEW:
+    {
+        static const struct { UINT mode; const WCHAR *name; } modes[] =
+        {
+            { FVM_ICON, L"Large icons" }, { FVM_SMALLICON, L"Small icons" },
+            { FVM_LIST, L"List" }, { FVM_DETAILS, L"Details" },
+        };
+        for (i = 0; i < ARRAY_SIZE(modes); i++)
+            AppendMenuW(menu, MF_STRING | (!folder ? MF_GRAYED : 0) | (folder && mode == modes[i].mode ? MF_CHECKED : 0),
+                        CMD_VIEW_BASE + modes[i].mode, modes[i].name);
+        AppendMenuW(menu, MF_SEPARATOR, 0, NULL);
+        show = CreatePopupMenu();
+        AppendMenuW(show, MF_STRING | (fe.show_nav ? MF_CHECKED : 0), CMD_SHOW_NAVPANE, L"Navigation pane");
+        AppendMenuW(show, MF_STRING | (setting_extensions() ? MF_CHECKED : 0), CMD_SHOW_EXT, L"File name extensions");
+        AppendMenuW(show, MF_STRING | (setting_hidden() ? MF_CHECKED : 0), CMD_SHOW_HIDDEN, L"Hidden items");
+        AppendMenuW(menu, MF_POPUP, (UINT_PTR)show, L"Show");
+        break;
+    }
+    case CMD_SORT:
+    {
+        IFolderView2 *fv = get_folder_view();
+        SORTCOLUMN sc = {{{0}}};
+        BOOL have = fv && SUCCEEDED(IFolderView2_GetSortColumns(fv, &sc, 1));
+        for (i = 0; i < ARRAY_SIZE(sort_pids); i++)
+            AppendMenuW(menu, MF_STRING | (!folder ? MF_GRAYED : 0) | (have && sc.propkey.pid == sort_pids[i] ? MF_CHECKED : 0),
+                        CMD_SORT_BASE + i, sort_names[i]);
+        AppendMenuW(menu, MF_SEPARATOR, 0, NULL);
+        AppendMenuW(menu, MF_STRING | (!folder ? MF_GRAYED : 0) | (have && sc.direction != SORT_DESCENDING ? MF_CHECKED : 0), CMD_SORT_ASC, L"Ascending");
+        AppendMenuW(menu, MF_STRING | (!folder ? MF_GRAYED : 0) | (have && sc.direction == SORT_DESCENDING ? MF_CHECKED : 0), CMD_SORT_DESC, L"Descending");
+        if (fv) IFolderView2_Release(fv);
+        break;
+    }
+    case CMD_MORE:
+        AppendMenuW(menu, MF_STRING | (!folder ? MF_GRAYED : 0), CMD_SELECTALL, L"Select all\tCtrl+A");
+        AppendMenuW(menu, MF_STRING | (!folder ? MF_GRAYED : 0), CMD_SELECTNONE, L"Select none");
+        AppendMenuW(menu, MF_STRING | (!folder ? MF_GRAYED : 0), CMD_INVERT, L"Invert selection");
+        AppendMenuW(menu, MF_SEPARATOR, 0, NULL);
+        AppendMenuW(menu, MF_STRING, CMD_COPYPATH, L"Copy as path");
+        AppendMenuW(menu, MF_STRING, CMD_NEWWINDOW, L"Open in new window\tCtrl+N");
+        AppendMenuW(menu, MF_SEPARATOR, 0, NULL);
+        AppendMenuW(menu, MF_STRING, CMD_PROPERTIES, L"Properties\tAlt+Enter");
+        break;
+    }
+    if ((cmd = popup(menu, fe.cmdbar, &c->rc))) run_command(cmd);
+}
+
+static LRESULT CALLBACK cmdbar_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    int i;
+
+    switch (msg)
+    {
+    case WM_PAINT:
+        cmdbar_paint(hwnd);
+        return 0;
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_SIZE:
+        cmdbar_layout();
+        return 0;
+    case WM_MOUSEMOVE:
+    {
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd };
+        i = cmd_at(GET_X_LPARAM(lp), GET_Y_LPARAM(lp));
+        if (i != fe.cmd_hot) { fe.cmd_hot = i; InvalidateRect(hwnd, NULL, FALSE); }
+        TrackMouseEvent(&tme);
+        return 0;
+    }
+    case WM_MOUSELEAVE:
+        fe.cmd_hot = -1;
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_LBUTTONDOWN:
+        i = cmd_at(GET_X_LPARAM(lp), GET_Y_LPARAM(lp));
+        if (i < 0 || !fe.cmds[i].enabled) return 0;
+        if (fe.cmds[i].dropdown)
+        {
+            fe.cmd_pressed = i;
+            InvalidateRect(hwnd, NULL, FALSE);
+            UpdateWindow(hwnd);
+            cmd_dropdown(&fe.cmds[i]);
+            fe.cmd_pressed = -1;
+            InvalidateRect(hwnd, NULL, FALSE);
+            return 0;
+        }
+        fe.cmd_pressed = i;
+        SetCapture(hwnd);
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_LBUTTONUP:
+        if (GetCapture() == hwnd) ReleaseCapture();
+        i = cmd_at(GET_X_LPARAM(lp), GET_Y_LPARAM(lp));
+        if (i >= 0 && i == fe.cmd_pressed)
+        {
+            fe.cmd_pressed = -1;
+            InvalidateRect(hwnd, NULL, FALSE);
+            run_command(fe.cmds[i].id);
+        }
+        fe.cmd_pressed = -1;
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
