+    for (i = 0; i < 2; i++)
+    {
+        RECT *head = i ? &fe.rc_head_drives : &fe.rc_head_folders;
+        RECT line;
+        SIZE sz;
+        if (i ? !ndrives : !nfolders) continue;
+        swprintf(buf, ARRAY_SIZE(buf), i ? L"Devices and drives (%d)" : L"Folders (%d)", i ? ndrives : nfolders);
+        SelectObject(dc, fe.font_heading);
+        rc = *head;
+        draw_glyph(dc, G_CHEVRON_DOWN, rc.left, rc.top + (rc.bottom - rc.top - S(12)) / 2, S(12), C_MUTED);
+        rc.left += S(18);
+        text(dc, buf, &rc, C_ACCENT_DK, DT_SINGLELINE | DT_VCENTER | DT_LEFT);
+        GetTextExtentPoint32W(dc, buf, lstrlenW(buf), &sz);
+        SetRect(&line, rc.left + sz.cx + S(10), (rc.top + rc.bottom) / 2, head->right, (rc.top + rc.bottom) / 2 + 1);
+        fill(dc, &line, C_LINE);
+    }
+    SelectObject(dc, fe.font);
+
+    for (i = 0; i < fe.npc; i++)
+    {
+        struct pc_item *it = &fe.pc[i];
+        RECT t;
+        int icon_y = it->rc.top + (it->rc.bottom - it->rc.top - S(48)) / 2;
+
+        if (i == fe.pc_sel) { fill(dc, &it->rc, C_SELECTED); frame(dc, &it->rc, blend(C_SELECTED, C_ACCENT, 35)); }
+        else if (i == fe.pc_hot) fill(dc, &it->rc, C_HOT);
+        if (extra_large)
+            ImageList_Draw((HIMAGELIST)extra_large, it->icon, dc, it->rc.left + S(6), icon_y, ILD_TRANSPARENT);
+        t = it->rc;
+        t.left += S(6) + S(48) + S(10);
+        t.right -= S(8);
+        if (!it->drive)
+        {
+            text(dc, it->name, &t, C_TEXT, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_END_ELLIPSIS);
+            continue;
+        }
+        t.top += S(6);
+        t.bottom = t.top + fe.font_height + S(2);
+        text(dc, it->name, &t, C_TEXT, DT_SINGLELINE | DT_TOP | DT_LEFT | DT_END_ELLIPSIS);
+        if (it->have_space)
+        {
+            RECT bar = { t.left, t.bottom + S(3), t.left + min(S(190), t.right - t.left), t.bottom + S(3) + S(13) };
+            RECT used = bar;
+            WCHAR fr[32], tot[32];
+            double pct = 1.0 - (double)it->free / (double)it->total;
+            fill(dc, &bar, C_BAR_TRACK);
+            used.right = bar.left + (int)((bar.right - bar.left) * pct);
+            fill(dc, &used, pct >= 0.9 ? C_BAR_FULL : C_ACCENT);
+            frame(dc, &bar, RGB(0xbc, 0xbc, 0xbc));
+            format_size(it->free, fr, 32);
+            format_size(it->total, tot, 32);
+            swprintf(buf, ARRAY_SIZE(buf), L"%s free of %s", fr, tot);
+            t.top = bar.bottom + S(3);
+            t.bottom = it->rc.bottom;
+            SelectObject(dc, fe.font_small);
+            text(dc, buf, &t, C_MUTED, DT_SINGLELINE | DT_TOP | DT_LEFT | DT_END_ELLIPSIS);
+            SelectObject(dc, fe.font);
+        }
+    }
+    end_paint(hwnd, &p);
+}
