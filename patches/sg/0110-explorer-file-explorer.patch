+static void copy_as_path(void)
+{
+    int count;
+    WCHAR *list = selected_paths(&count), *p, *out, path[MAX_PATH];
+    size_t len = 0;
+    HGLOBAL mem;
+
+    if (!list)
+    {
+        if (!pidl_path(fe.pidl, path)) return;
+        list = calloc(lstrlenW(path) + 2, sizeof(WCHAR));
+        lstrcpyW(list, path);
+    }
+    for (p = list; *p; p += lstrlenW(p) + 1) len += lstrlenW(p) + 4;
+    if (!(mem = GlobalAlloc(GMEM_MOVEABLE, (len + 1) * sizeof(WCHAR)))) { free(list); return; }
+    out = GlobalLock(mem);
+    out[0] = 0;
+    for (p = list; *p; p += lstrlenW(p) + 1)
+    {
+        if (out[0]) lstrcatW(out, L"\r\n");
+        lstrcatW(out, L"\"");
+        lstrcatW(out, p);
+        lstrcatW(out, L"\"");
+    }
+    GlobalUnlock(mem);
+    if (OpenClipboard(fe.hwnd))
+    {
+        EmptyClipboard();
+        SetClipboardData(CF_UNICODETEXT, mem);
+        CloseClipboard();
+    }
+    else GlobalFree(mem);
+    free(list);
+}
