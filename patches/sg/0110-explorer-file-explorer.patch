+/* ------------------------------------------------------------------------ */
+/* search: the current folder and everything below it                       */
+
+struct search_job
+{
+    WCHAR root[MAX_PATH];
+    WCHAR query[256];
+    LONG gen;
+    BOOL wildcard, hidden;
+    int found;
+};
+
+static BOOL search_matches(const struct search_job *job, const WCHAR *name)
+{
+    if (job->wildcard) return PathMatchSpecW(name, job->query);
+    return StrStrIW(name, job->query) != NULL;
+}
+
+static void search_dir(struct search_job *job, const WCHAR *dir, int depth)
+{
+    WIN32_FIND_DATAW fd;
+    WCHAR spec[MAX_PATH + 4], sub[MAX_PATH];
+    HANDLE find;
+
+    if (depth > 40 || job->found >= 5000 || job->gen != fe.search_gen) return;
+    if (lstrlenW(dir) + 3 >= MAX_PATH) return;
+    lstrcpyW(spec, dir);
+    PathAppendW(spec, L"*");
+    find = FindFirstFileExW(spec, FindExInfoBasic, &fd, FindExSearchNameMatch, NULL, FIND_FIRST_EX_LARGE_FETCH);
+    if (find == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        BOOL is_dir = !!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY);
+        if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L"..")) continue;
+        if (!job->hidden && (fd.dwFileAttributes & (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM))) continue;
+        if (lstrlenW(dir) + lstrlenW(fd.cFileName) + 2 >= MAX_PATH) continue;
+        lstrcpyW(sub, dir);
+        PathAppendW(sub, fd.cFileName);
+        if (search_matches(job, fd.cFileName))
+        {
+            struct result *r = calloc(1, sizeof(*r));
+            r->path = wcsdup(sub);
+            r->name = PathFindFileNameW(r->path);
+            r->attrs = fd.dwFileAttributes;
+            r->mtime = fd.ftLastWriteTime;
+            r->size = ((ULONGLONG)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+            job->found++;
+            if (!PostMessageW(fe.hwnd, WM_FE_RESULT, job->gen, (LPARAM)r)) { free(r->path); free(r); }
+        }
+        if (is_dir && !(fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT))
+            search_dir(job, sub, depth + 1);
+    } while (job->gen == fe.search_gen && FindNextFileW(find, &fd));
+    FindClose(find);
+}
+
+static DWORD WINAPI search_thread(void *arg)
+{
+    struct search_job *job = arg;
+    const WCHAR *p = job->root;
+
+    /* This PC: the user's files (a search of every drive would take all day) */
+    while (*p)
+    {
+        search_dir(job, p, 0);
+        p += lstrlenW(p) + 1;
+        if (p >= job->root + MAX_PATH) break;
+    }
+    PostMessageW(fe.hwnd, WM_FE_SEARCHDONE, job->gen, 0);
+    free(job);
+    return 0;
+}
+
+static void clear_results(void)
+{
+    int i, n = SendMessageW(fe.results, LVM_GETITEMCOUNT, 0, 0);
+    for (i = 0; i < n; i++)
+    {
+        LVITEMW item = { LVIF_PARAM, i };
+        if (SendMessageW(fe.results, LVM_GETITEMW, 0, (LPARAM)&item) && item.lParam)
+        {
+            struct result *r = (struct result *)item.lParam;
+            free(r->path);
+            free(r);
+        }
+    }
+    SendMessageW(fe.results, LVM_DELETEALLITEMS, 0, 0);
+    fe.nresults = 0;
+}
+
+static void start_search(void)
+{
+    struct search_job *job;
+    WCHAR query[256], path[MAX_PATH];
+    HANDLE thread;
+
+    GetWindowTextW(fe.search_edit, query, ARRAY_SIZE(query));
+    StrTrimW(query, L" \t");
+    if (!query[0])
+    {
+        if (fe.content == CONTENT_SEARCH) exit_search(TRUE);
+        return;
+    }
+    InterlockedIncrement(&fe.search_gen);
+    job = calloc(1, sizeof(*job));
+    job->gen = fe.search_gen;
+    lstrcpynW(job->query, query, ARRAY_SIZE(job->query));
+    job->wildcard = wcschr(query, '*') || wcschr(query, '?');
+    job->hidden = setting_hidden();
+    if (pidl_path(fe.pidl, path))
+        lstrcpyW(job->root, path);
+    else
+    {
+        /* This PC and other places without a path: the user's profile */
+        ExpandEnvironmentStringsW(L"%USERPROFILE%", job->root, MAX_PATH);
+    }
+    lstrcpyW(fe.search_root, job->root);
+    lstrcpynW(fe.search_query, query, ARRAY_SIZE(fe.search_query));
+    display_name(fe.pidl, fe.search_where, MAX_PATH);
+
+    clear_results();
+    fe.results_sort = 0;
+    fe.results_desc = FALSE;
+    fe.searching = TRUE;
+    show_content(CONTENT_SEARCH);
+    TRACE("searching %s for %s\n", debugstr_w(job->root), debugstr_w(job->query));
+    if ((thread = CreateThread(NULL, 0, search_thread, job, 0, NULL))) CloseHandle(thread);
+    else { free(job); fe.searching = FALSE; }
+    update_status();
+}
+
+static void add_result(struct result *r)
+{
+    LVITEMW item = { LVIF_TEXT | LVIF_PARAM | LVIF_IMAGE };
+    SHFILEINFOW info;
+    WCHAR folder[MAX_PATH], buf[64];
+    SYSTEMTIME st, local;
+    WCHAR date[32], timestr[32];
+    DWORD flags = SHGFI_SYSICONINDEX | SHGFI_SMALLICON | SHGFI_TYPENAME;
+    const WCHAR *ext = PathFindExtensionW(r->name);
+
+    /* the real icon for programs and shortcuts; the type's for the rest */
+    if (wcsicmp(ext, L".exe") && wcsicmp(ext, L".lnk") && wcsicmp(ext, L".ico")) flags |= SHGFI_USEFILEATTRIBUTES;
+    memset(&info, 0, sizeof(info));
+    SHGetFileInfoW(r->path, r->attrs, &info, sizeof(info), flags);
+
+    item.iItem = fe.nresults++;
+    item.pszText = (WCHAR *)r->name;
+    item.iImage = info.iIcon;
+    item.lParam = (LPARAM)r;
+    item.iItem = SendMessageW(fe.results, LVM_INSERTITEMW, 0, (LPARAM)&item);
+
+    lstrcpyW(folder, r->path);
+    PathRemoveFileSpecW(folder);
+    item.mask = LVIF_TEXT;
+    item.iSubItem = 1; item.pszText = folder;
+    SendMessageW(fe.results, LVM_SETITEMW, 0, (LPARAM)&item);
+
+    FileTimeToSystemTime(&r->mtime, &st);
+    SystemTimeToTzSpecificLocalTime(NULL, &st, &local);
+    GetDateFormatW(LOCALE_USER_DEFAULT, DATE_SHORTDATE, &local, NULL, date, ARRAY_SIZE(date));
+    GetTimeFormatW(LOCALE_USER_DEFAULT, TIME_NOSECONDS, &local, NULL, timestr, ARRAY_SIZE(timestr));
+    swprintf(buf, ARRAY_SIZE(buf), L"%s %s", date, timestr);
+    item.iSubItem = 2; item.pszText = buf;
+    SendMessageW(fe.results, LVM_SETITEMW, 0, (LPARAM)&item);
+
+    item.iSubItem = 3; item.pszText = info.szTypeName;
+    SendMessageW(fe.results, LVM_SETITEMW, 0, (LPARAM)&item);
+
+    if (!(r->attrs & FILE_ATTRIBUTE_DIRECTORY))
+    {
+        StrFormatKBSizeW(r->size, buf, ARRAY_SIZE(buf));
+        item.iSubItem = 4; item.pszText = buf;
+        SendMessageW(fe.results, LVM_SETITEMW, 0, (LPARAM)&item);
+    }
+}
+
+static void exit_search(BOOL restore)
+{
+    InterlockedIncrement(&fe.search_gen);
+    fe.searching = FALSE;
+    if (fe.content != CONTENT_SEARCH) return;
+    clear_results();
+    SetWindowTextW(fe.search_edit, L"");
+    KillTimer(fe.hwnd, TIMER_SEARCH);
+    if (restore) show_content(fe.pidl && fe.mycomputer && ILIsEqual(fe.pidl, fe.mycomputer) ? CONTENT_THISPC : CONTENT_FOLDER);
+    else fe.content = CONTENT_FOLDER;
+}
+
+static struct result *result_at(int i)
+{
+    LVITEMW item = { LVIF_PARAM, i };
+    if (i < 0 || !SendMessageW(fe.results, LVM_GETITEMW, 0, (LPARAM)&item)) return NULL;
+    return (struct result *)item.lParam;
+}
+
+static void open_result(int i)
+{
+    struct result *r = result_at(i);
+    ITEMIDLIST *pidl;
+
+    if (!r) return;
+    if (r->attrs & FILE_ATTRIBUTE_DIRECTORY)
+    {
+        if ((pidl = ILCreateFromPathW(r->path)))
+        {
+            exit_search(FALSE);
+            navigate(pidl);
+            ILFree(pidl);
+        }
+        return;
+    }
+    ShellExecuteW(fe.hwnd, NULL, r->path, NULL, NULL, SW_SHOWNORMAL);
+}
+
+static void open_result_location(int i)
+{
+    struct result *r = result_at(i);
+    ITEMIDLIST *pidl;
+    WCHAR folder[MAX_PATH];
+
+    if (!r) return;
+    lstrcpyW(folder, r->path);
+    PathRemoveFileSpecW(folder);
+    lstrcpyW(fe.select_after, r->path);
+    if ((pidl = ILCreateFromPathW(folder)))
+    {
+        exit_search(FALSE);
+        navigate(pidl);
+        ILFree(pidl);
+    }
+}
+
+/* the selected results' paths, double-null terminated */
+static WCHAR *selected_result_paths(int *count)
+{
+    int i = -1, len = 1;
+    WCHAR *list = NULL, *p;
+    struct result *r;
+
+    *count = 0;
+    while ((i = SendMessageW(fe.results, LVM_GETNEXTITEM, i, LVNI_SELECTED)) >= 0)
+        if ((r = result_at(i))) len += lstrlenW(r->path) + 1;
+    if (len == 1) return NULL;
+    p = list = calloc(len, sizeof(WCHAR));
+    i = -1;
+    while ((i = SendMessageW(fe.results, LVM_GETNEXTITEM, i, LVNI_SELECTED)) >= 0)
+        if ((r = result_at(i))) { lstrcpyW(p, r->path); p += lstrlenW(p) + 1; (*count)++; }
+    return list;
+}
+
+static void results_context_menu(POINT pt)
+{
+    int i = SendMessageW(fe.results, LVM_GETNEXTITEM, -1, LVNI_SELECTED);
+    struct result *r = result_at(i);
+    ITEMIDLIST *pidls[256], *parent_pidl = NULL;
+    const ITEMIDLIST *children[256];
+    IShellFolder *parent = NULL;
+    IContextMenu *cm = NULL;
+    HMENU menu;
+    int n = 0, cmd;
+    BOOL same = TRUE;
+    WCHAR first_dir[MAX_PATH], dir[MAX_PATH];
+
+    if (!r) return;
+    lstrcpyW(first_dir, r->path);
+    PathRemoveFileSpecW(first_dir);
+    for (i = -1; n < ARRAY_SIZE(pidls) && (i = SendMessageW(fe.results, LVM_GETNEXTITEM, i, LVNI_SELECTED)) >= 0;)
+    {
+        if (!(r = result_at(i))) continue;
+        lstrcpyW(dir, r->path);
+        PathRemoveFileSpecW(dir);
+        if (wcsicmp(dir, first_dir)) same = FALSE;
+        if ((pidls[n] = ILCreateFromPathW(r->path))) n++;
+    }
+    menu = CreatePopupMenu();
+    AppendMenuW(menu, MF_STRING, 0x7f01, L"Open file location");
+    AppendMenuW(menu, MF_SEPARATOR, 0, NULL);
+    if (n && same && (parent_pidl = ILCreateFromPathW(first_dir)))
+    {
+        IShellFolder *desktop;
+        SHGetDesktopFolder(&desktop);
+        if (SUCCEEDED(IShellFolder_BindToObject(desktop, parent_pidl, NULL, &IID_IShellFolder, (void **)&parent)))
+        {
+            for (i = 0; i < n; i++) children[i] = ILFindLastID(pidls[i]);
+            if (FAILED(IShellFolder_GetUIObjectOf(parent, fe.hwnd, n, children, &IID_IContextMenu, NULL, (void **)&cm))) cm = NULL;
+        }
+        IShellFolder_Release(desktop);
+    }
+    if (cm) IContextMenu_QueryContextMenu(cm, menu, 2, 1, 0x7eff, CMF_NORMAL);
+    else AppendMenuW(menu, MF_STRING, 0x7f02, L"Delete");
+    cmd = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_RIGHTBUTTON, pt.x, pt.y, 0, fe.hwnd, NULL);
+    DestroyMenu(menu);
+    if (cmd == 0x7f01) open_result_location(SendMessageW(fe.results, LVM_GETNEXTITEM, -1, LVNI_SELECTED));
+    else if (cmd == 0x7f02) run_command(CMD_DELETE);
+    else if (cmd > 0 && cm)
+    {
+        CMINVOKECOMMANDINFO ici = { sizeof(ici) };
+        ici.hwnd = fe.hwnd;
+        ici.lpVerb = MAKEINTRESOURCEA(cmd - 1);
+        ici.nShow = SW_SHOWNORMAL;
+        IContextMenu_InvokeCommand(cm, &ici);
+    }
+    if (cm) IContextMenu_Release(cm);
+    if (parent) IShellFolder_Release(parent);
+    ILFree(parent_pidl);
+    for (i = 0; i < n; i++) ILFree(pidls[i]);
+}
+
+static int CALLBACK results_compare(LPARAM a, LPARAM b, LPARAM column)
+{
+    struct result *r1 = (struct result *)a, *r2 = (struct result *)b;
+    BOOL d1 = !!(r1->attrs & FILE_ATTRIBUTE_DIRECTORY), d2 = !!(r2->attrs & FILE_ATTRIBUTE_DIRECTORY);
+    WCHAR f1[MAX_PATH], f2[MAX_PATH];
+    int ret = 0;
+
+    if (d1 != d2) return d1 ? -1 : 1;
+    switch (column)
+    {
+    case 1:
+        lstrcpyW(f1, r1->path); PathRemoveFileSpecW(f1);
+        lstrcpyW(f2, r2->path); PathRemoveFileSpecW(f2);
+        ret = StrCmpLogicalW(f1, f2);
+        break;
+    case 2: ret = CompareFileTime(&r1->mtime, &r2->mtime); break;
+    case 3: ret = wcsicmp(PathFindExtensionW(r1->name), PathFindExtensionW(r2->name)); break;
+    case 4: ret = r1->size < r2->size ? -1 : r1->size > r2->size; break;
+    }
+    if (!ret) ret = StrCmpLogicalW(r1->name, r2->name);
+    return fe.results_desc ? -ret : ret;
+}
+
+static LRESULT results_notify(NMHDR *hdr)
+{
+    switch (hdr->code)
+    {
+    case NM_DBLCLK:
+    case LVN_ITEMACTIVATE:
+        open_result(SendMessageW(fe.results, LVM_GETNEXTITEM, -1, LVNI_FOCUSED));
+        return 0;
+    case LVN_ITEMCHANGED:
+        PostMessageW(fe.hwnd, WM_FE_STATUS, 0, 0);
+        return 0;
+    case LVN_COLUMNCLICK:
+    {
+        NMLISTVIEW *nm = (NMLISTVIEW *)hdr;
+        HWND header = (HWND)SendMessageW(fe.results, LVM_GETHEADER, 0, 0);
+        int i;
+        if (fe.results_sort == nm->iSubItem) fe.results_desc = !fe.results_desc;
+        else { fe.results_sort = nm->iSubItem; fe.results_desc = nm->iSubItem == 2 || nm->iSubItem == 4; }
+        SendMessageW(fe.results, LVM_SORTITEMS, fe.results_sort, (LPARAM)results_compare);
+        for (i = 0; i < 5; i++)
+        {
+            HDITEMW hi = { HDI_FORMAT };
+            SendMessageW(header, HDM_GETITEMW, i, (LPARAM)&hi);
+            hi.fmt &= ~(HDF_SORTUP | HDF_SORTDOWN);
+            if (i == fe.results_sort) hi.fmt |= fe.results_desc ? HDF_SORTDOWN : HDF_SORTUP;
+            SendMessageW(header, HDM_SETITEMW, i, (LPARAM)&hi);
+        }
+        return 0;
+    }
+    case NM_RCLICK:
+    {
+        POINT pt;
+        GetCursorPos(&pt);
+        results_context_menu(pt);
+        return 1;
+    }
+    }
+    return 0;
+}
+
+static void create_results(void)
+{
+    static const struct { const WCHAR *name; int width, fmt; } cols[] =
+    {
+        { L"Name", 220, LVCFMT_LEFT }, { L"Folder", 200, LVCFMT_LEFT }, { L"Date modified", 140, LVCFMT_LEFT },
+        { L"Type", 110, LVCFMT_LEFT }, { L"Size", 70, LVCFMT_RIGHT },
+    };
