+/* a new folder or text document, named as Windows names them, then renamed */
+static void new_item(BOOL folder)
+{
+    WCHAR dir[MAX_PATH], path[MAX_PATH], name[64];
+    const WCHAR *base = folder ? L"New folder" : L"New Text Document", *ext = folder ? L"" : L".txt";
+    int i;
+    HANDLE file;
+    ITEMIDLIST *pidl;
+
+    if (fe.content != CONTENT_FOLDER || !pidl_path(fe.pidl, dir)) return;
+    for (i = 1; i < 1000; i++)
+    {
+        if (i == 1) swprintf(name, ARRAY_SIZE(name), L"%s%s", base, ext);
+        else swprintf(name, ARRAY_SIZE(name), L"%s (%d)%s", base, i, ext);
+        lstrcpyW(path, dir);
+        PathAppendW(path, name);
+        if (GetFileAttributesW(path) == INVALID_FILE_ATTRIBUTES) break;
+    }
+    if (folder)
+    {
+        if (!CreateDirectoryW(path, NULL)) return;
+    }
+    else
+    {
+        if ((file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL)) == INVALID_HANDLE_VALUE)
+            return;
+        CloseHandle(file);
+    }
+    /* a full ID list, read from the disk, so the view shows what it really is */
+    if ((pidl = ILCreateFromPathW(path)))
+    {
+        SHChangeNotify(folder ? SHCNE_MKDIR : SHCNE_CREATE, SHCNF_IDLIST | SHCNF_FLUSH, pidl, NULL);
+        ILFree(pidl);
+    }
+    TRACE("created %s\n", debugstr_w(path));
+    lstrcpyW(fe.new_item, path);
+    fe.new_item_tries = 0;
+    SetFocus(get_view_list());
+    if (!rename_new_item()) SetTimer(fe.hwnd, TIMER_NEWITEM, 100, NULL);
+}
