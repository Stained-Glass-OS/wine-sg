+/* ------------------------------------------------------------------------ */
+/* glyphs: line icons, drawn anti-aliased on a 16-unit grid                 */
+
+static void draw_glyph(HDC dc, int glyph, int x, int y, int size, COLORREF color)
+{
+    GpGraphics *g;
+    GpPen *pen;
+    GpSolidFill *brush;
+    float s = size / 16.0f;
+    ARGB argb = 0xff000000 | (GetRValue(color) << 16) | (GetGValue(color) << 8) | GetBValue(color);
+    ARGB accent = 0xff000000 | (GetRValue(C_ACCENT) << 16) | (GetGValue(C_ACCENT) << 8) | GetBValue(C_ACCENT);
+
+#define X(v) (x + (v) * s)
+#define Y(v) (y + (v) * s)
+#define L(x1, y1, x2, y2) GdipDrawLine(g, pen, X(x1), Y(y1), X(x2), Y(y2))
+#define R(x1, y1, w, h) GdipDrawRectangle(g, pen, X(x1), Y(y1), (w) * s, (h) * s)
+#define E(x1, y1, w, h) GdipDrawEllipse(g, pen, X(x1), Y(y1), (w) * s, (h) * s)
+#define FE(x1, y1, w, h) GdipFillEllipse(g, (GpBrush *)brush, X(x1), Y(y1), (w) * s, (h) * s)
+
+    if (glyph == G_NONE || GdipCreateFromHDC(dc, &g) != Ok) return;
+    GdipSetSmoothingMode(g, SmoothingModeAntiAlias);
+    GdipSetPixelOffsetMode(g, PixelOffsetModeHalf);
+    GdipCreatePen1(argb, max(1.0f, 1.15f * s), UnitPixel, &pen);
+    GdipSetPenLineJoin(pen, LineJoinRound);
+    GdipSetPenStartCap(pen, LineCapRound);
+    GdipSetPenEndCap(pen, LineCapRound);
+    GdipCreateSolidFill(argb, &brush);
+
+    switch (glyph)
+    {
+    case G_BACK:
+        L(13, 8, 3, 8); L(7.5, 3.5, 3, 8); L(3, 8, 7.5, 12.5); break;
+    case G_FORWARD:
+        L(3, 8, 13, 8); L(8.5, 3.5, 13, 8); L(13, 8, 8.5, 12.5); break;
+    case G_UP:
+        L(8, 13.5, 8, 2.5); L(3.5, 7, 8, 2.5); L(8, 2.5, 12.5, 7); break;
+    case G_REFRESH:
+        GdipDrawArc(g, pen, X(2.5), Y(2.5), 11 * s, 11 * s, -60, 300);
+        L(13.2, 1.8, 13.3, 5.4); L(13.3, 5.4, 9.8, 5.3); break;
+    case G_SEARCH:
+        E(2, 2, 8.5, 8.5); L(9.5, 9.5, 14, 14); break;
+    case G_CHEVRON_RIGHT:
+        L(6, 3.5, 10.5, 8); L(10.5, 8, 6, 12.5); break;
+    case G_CHEVRON_DOWN:
+        L(3.5, 6, 8, 10.5); L(8, 10.5, 12.5, 6); break;
+    case G_CHEVRON_LEFT2:
+        L(8, 4, 4, 8); L(4, 8, 8, 12); L(12, 4, 8, 8); L(8, 8, 12, 12); break;
+    case G_NEW:
+    case G_NEWFOLDER:
+    {
+        GpPen *plus;
+        L(1.5, 4, 6, 4); L(6, 4, 7.5, 5.5); L(7.5, 5.5, 9, 5.5);
+        L(1.5, 4, 1.5, 14); L(1.5, 14, 14.5, 14); L(14.5, 14, 14.5, 9.5);
+        GdipCreatePen1(accent, max(1.0f, 1.3f * s), UnitPixel, &plus);
+        GdipDrawLine(g, plus, X(12.5), Y(1), X(12.5), Y(7)); GdipDrawLine(g, plus, X(9.5), Y(4), X(15.5), Y(4));
+        GdipDeletePen(plus);
+        break;
+    }
+    case G_CUT:
+        E(2, 10, 4, 4); E(10, 10, 4, 4); L(5.3, 10.3, 11, 1.5); L(10.7, 10.3, 5, 1.5); break;
+    case G_COPY:
+        R(5.5, 5.5, 8.5, 9); L(2.5, 11, 2.5, 2.5); L(2.5, 2.5, 9.5, 2.5); break;
+    case G_PASTE:
+        L(5, 2.5, 3, 2.5); L(3, 2.5, 3, 14.5); L(3, 14.5, 13, 14.5); L(13, 14.5, 13, 2.5); L(13, 2.5, 11, 2.5);
+        R(5.5, 1.2, 5, 2.8); break;
+    case G_RENAME:
+        L(9, 5, 2, 5); L(2, 5, 2, 11); L(2, 11, 9, 11);
+        L(12, 2, 12, 14); L(10.5, 2, 13.5, 2); L(10.5, 14, 13.5, 14); break;
+    case G_DELETE:
+        L(2, 4, 14, 4); L(6, 4, 6, 2); L(6, 2, 10, 2); L(10, 2, 10, 4);
+        L(3.5, 4, 4.5, 14.5); L(4.5, 14.5, 11.5, 14.5); L(11.5, 14.5, 12.5, 4);
+        L(6.7, 7, 6.7, 12); L(9.3, 7, 9.3, 12); break;
+    case G_SORT:
+        L(5, 14, 5, 2); L(2.5, 4.5, 5, 2); L(5, 2, 7.5, 4.5);
+        L(11, 2, 11, 14); L(8.5, 11.5, 11, 14); L(11, 14, 13.5, 11.5); break;
+    case G_VIEW:
+    case G_ICONS:
+        R(2, 2, 5, 5); R(9, 2, 5, 5); R(2, 9, 5, 5); R(9, 9, 5, 5); break;
+    case G_DETAILS:
+        L(2, 3, 14, 3); L(2, 6.3, 14, 6.3); L(2, 9.6, 14, 9.6); L(2, 13, 14, 13); break;
+    case G_PROPERTIES:
+        E(1.5, 1.5, 13, 13); FE(7.2, 4.1, 1.6, 1.6); L(8, 7.3, 8, 11.8); break;
+    case G_MORE:
+        FE(2, 7, 2, 2); FE(7, 7, 2, 2); FE(12, 7, 2, 2); break;
+    case G_CLOSE:
+        L(4, 4, 12, 12); L(12, 4, 4, 12); break;
+    case G_STAR:
+    {
+        GpPen *star;
+        GpPointF pts[11];
+        int i;
+        for (i = 0; i < 10; i++)
+        {
+            double a = -3.14159265 / 2 + i * 3.14159265 / 5, r = (i & 1) ? 3.0 : 7.0;
+            pts[i].X = X(8 + r * cos(a)); pts[i].Y = Y(8.6 + r * sin(a));
+        }
+        pts[10] = pts[0];
+        GdipCreatePen1(accent, max(1.0f, 1.15f * s), UnitPixel, &star);
+        GdipSetPenLineJoin(star, LineJoinRound);
+        GdipDrawLines(g, star, pts, 11);
+        GdipDeletePen(star);
+        break;
+    }
+    }
+#undef X
+#undef Y
+#undef L
+#undef R
+#undef E
+#undef FE
+    GdipDeleteBrush((GpBrush *)brush);
+    GdipDeletePen(pen);
+    GdipDeleteGraphics(g);
+}
