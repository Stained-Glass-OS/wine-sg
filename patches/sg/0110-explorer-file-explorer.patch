+static LRESULT CALLBACK thispc_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    int i;
+
+    switch (msg)
+    {
+    case WM_PAINT:
+        thispc_paint(hwnd);
+        return 0;
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_SIZE:
+        thispc_layout();
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_VSCROLL:
+    case WM_MOUSEWHEEL:
+    {
+        RECT client;
+        int pos = fe.pc_scroll;
+        GetClientRect(hwnd, &client);
+        if (msg == WM_MOUSEWHEEL) pos -= GET_WHEEL_DELTA_WPARAM(wp) * S(48) / WHEEL_DELTA;
+        else switch (LOWORD(wp))
+        {
+        case SB_LINEUP: pos -= S(24); break;
+        case SB_LINEDOWN: pos += S(24); break;
+        case SB_PAGEUP: pos -= client.bottom; break;
+        case SB_PAGEDOWN: pos += client.bottom; break;
+        case SB_THUMBTRACK: case SB_THUMBPOSITION: pos = HIWORD(wp); break;
+        }
+        pos = max(0, min(pos, fe.pc_height - client.bottom));
+        if (pos != fe.pc_scroll) { fe.pc_scroll = pos; thispc_layout(); InvalidateRect(hwnd, NULL, FALSE); }
+        return 0;
+    }
+    case WM_MOUSEMOVE:
+    {
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd };
+        i = pc_at(GET_X_LPARAM(lp), GET_Y_LPARAM(lp));
+        if (i != fe.pc_hot) { fe.pc_hot = i; InvalidateRect(hwnd, NULL, FALSE); }
+        TrackMouseEvent(&tme);
+        return 0;
+    }
+    case WM_MOUSELEAVE:
+        fe.pc_hot = -1;
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_LBUTTONDOWN:
+    case WM_RBUTTONDOWN:
+        SetFocus(hwnd);
+        pc_select(pc_at(GET_X_LPARAM(lp), GET_Y_LPARAM(lp)));
+        return 0;
+    case WM_LBUTTONDBLCLK:
+        pc_open(pc_at(GET_X_LPARAM(lp), GET_Y_LPARAM(lp)));
+        return 0;
+    case WM_CONTEXTMENU:
+    {
+        POINT pt = { GET_X_LPARAM(lp), GET_Y_LPARAM(lp) };
+        if (fe.pc_sel < 0) return 0;
+        if (pt.x == -1 && pt.y == -1)
+        {
+            pt.x = fe.pc[fe.pc_sel].rc.left + S(24); pt.y = fe.pc[fe.pc_sel].rc.top + S(24);
+            ClientToScreen(hwnd, &pt);
+        }
+        item_context_menu(fe.pc[fe.pc_sel].pidl, pt);
+        return 0;
+    }
+    case WM_GETDLGCODE:
+        return DLGC_WANTARROWS;
+    case WM_KEYDOWN:
+        switch (wp)
+        {
+        case VK_RETURN: pc_open(fe.pc_sel); return 0;
+        case VK_LEFT: case VK_UP: pc_select(fe.pc_sel <= 0 ? 0 : fe.pc_sel - 1); return 0;
+        case VK_RIGHT: case VK_DOWN: pc_select(fe.pc_sel < 0 ? 0 : min(fe.npc - 1, fe.pc_sel + 1)); return 0;
+        case VK_HOME: pc_select(0); return 0;
+        case VK_END: pc_select(fe.npc - 1); return 0;
+        }
+        break;
+    case WM_SETFOCUS:
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
