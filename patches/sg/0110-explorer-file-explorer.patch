+static int S(int x) { return MulDiv(x, fe.dpi, 96); }
+
+static COLORREF blend(COLORREF a, COLORREF b, int pct)
+{
+    return RGB((GetRValue(a) * (100 - pct) + GetRValue(b) * pct) / 100,
+               (GetGValue(a) * (100 - pct) + GetGValue(b) * pct) / 100,
+               (GetBValue(a) * (100 - pct) + GetBValue(b) * pct) / 100);
+}
+
+static void fill(HDC dc, const RECT *rc, COLORREF color)
+{
+    SetDCBrushColor(dc, color);
+    FillRect(dc, rc, GetStockObject(DC_BRUSH));
+}
+
+static void frame(HDC dc, const RECT *rc, COLORREF color)
+{
+    SetDCBrushColor(dc, color);
+    FrameRect(dc, rc, GetStockObject(DC_BRUSH));
+}
+
+static void text(HDC dc, const WCHAR *str, RECT *rc, COLORREF color, UINT flags)
+{
+    SetTextColor(dc, color);
+    SetBkMode(dc, TRANSPARENT);
+    DrawTextW(dc, str, -1, rc, flags | DT_NOPREFIX);
+}
+
+/* a double-buffered paint */
+struct paint { PAINTSTRUCT ps; HDC wnd_dc, dc; HBITMAP bmp, old; RECT rc; HFONT old_font; };
+
+static HDC begin_paint(HWND hwnd, struct paint *p)
+{
+    p->wnd_dc = BeginPaint(hwnd, &p->ps);
+    GetClientRect(hwnd, &p->rc);
+    p->dc = CreateCompatibleDC(p->wnd_dc);
+    p->bmp = CreateCompatibleBitmap(p->wnd_dc, max(1, p->rc.right), max(1, p->rc.bottom));
+    p->old = SelectObject(p->dc, p->bmp);
+    p->old_font = SelectObject(p->dc, fe.font);
+    fill(p->dc, &p->rc, C_BG);
+    return p->dc;
+}
+
+static void end_paint(HWND hwnd, struct paint *p)
+{
+    BitBlt(p->wnd_dc, 0, 0, p->rc.right, p->rc.bottom, p->dc, 0, 0, SRCCOPY);
+    SelectObject(p->dc, p->old_font);
+    SelectObject(p->dc, p->old);
+    DeleteObject(p->bmp);
+    DeleteDC(p->dc);
+    EndPaint(hwnd, &p->ps);
+}
