+#define SG_EXPLORER_KEY L"Software\\Stained Glass\\Explorer"
+
+static DWORD reg_dword(const WCHAR *subkey, const WCHAR *name, DWORD def)
+{
+    DWORD value, size = sizeof(value);
+    WCHAR key[MAX_PATH];
+
+    swprintf(key, ARRAY_SIZE(key), L"%s%s%s", SG_EXPLORER_KEY, subkey ? L"\\" : L"", subkey ? subkey : L"");
+    if (RegGetValueW(HKEY_CURRENT_USER, key, name, RRF_RT_REG_DWORD, NULL, &value, &size)) return def;
+    return value;
+}
+
+static void set_reg_dword(const WCHAR *subkey, const WCHAR *name, DWORD value)
+{
+    WCHAR key[MAX_PATH];
+
+    swprintf(key, ARRAY_SIZE(key), L"%s%s%s", SG_EXPLORER_KEY, subkey ? L"\\" : L"", subkey ? subkey : L"");
+    RegSetKeyValueW(HKEY_CURRENT_USER, key, name, REG_DWORD, &value, sizeof(value));
+}
+
+static BOOL folder_key(const ITEMIDLIST *pidl, WCHAR *name)
+{
+    WCHAR *str;
+
+    if (!pidl || FAILED(SHGetNameFromIDList(pidl, SIGDN_DESKTOPABSOLUTEPARSING, &str))) return FALSE;
+    lstrcpynW(name, str, MAX_PATH);
+    CoTaskMemFree(str);
+    return TRUE;
+}
+
+static UINT default_view_mode(const ITEMIDLIST *pidl)
+{
+    WCHAR name[MAX_PATH], path[MAX_PATH], kf[MAX_PATH];
+    ITEMIDLIST *k;
+    UINT mode = FVM_DETAILS;
+
+    if (folder_key(pidl, name) && (mode = reg_dword(L"FolderViews", name, 0))) return mode;
+    mode = FVM_DETAILS;
+    if (!pidl_path(pidl, path)) return mode;
+    if ((k = known_folder(&FOLDERID_Pictures)) && pidl_path(k, kf) && !wcsicmp(kf, path)) mode = FVM_ICON;
+    ILFree(k);
+    if ((k = known_folder(&FOLDERID_Videos)) && pidl_path(k, kf) && !wcsicmp(kf, path)) mode = FVM_ICON;
+    ILFree(k);
+    return mode;
+}
