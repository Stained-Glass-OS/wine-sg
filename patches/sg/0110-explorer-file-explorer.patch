-            if(FAILED(hres) || hres == S_FALSE)
-                break;
-            if (!create_combobox_item( desktop, curr_pidl, info->icon_list, &item ))
-                WARN( "Could not create a combobox item\n" );
-            else
-            {
-                LPITEMIDLIST full_pidl = ILCombine(desktop_pidl,curr_pidl);
