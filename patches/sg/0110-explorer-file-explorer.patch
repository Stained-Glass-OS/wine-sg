+
+enum { A_NONE = -1, A_BACK = -2, A_FWD = -3, A_UP = -4, A_REFRESH = -5, A_OVERFLOW = -6, A_BOX = -7,
+       A_CHEVRON = 1000 /* + crumb */ };
+
+static void free_crumbs(void)
+{
+    int i;
+    for (i = 0; i < fe.ncrumbs; i++) ILFree(fe.crumbs[i].pidl);
+    fe.ncrumbs = 0;
+}
+
+static void add_crumb(const ITEMIDLIST *pidl, const WCHAR *name)
+{
+    struct crumb *c;
+
+    if (fe.ncrumbs >= ARRAY_SIZE(fe.crumbs)) return;
+    c = &fe.crumbs[fe.ncrumbs++];
+    c->pidl = ILClone(pidl);
+    if (name) lstrcpynW(c->name, name, MAX_PATH);
+    else display_name(pidl, c->name, MAX_PATH);
+}
+
+/* the crumbs for the current location: This PC > Documents > ... for a path
+ * inside one of the user's folders, as Windows shows it */
+static void build_crumbs(void)
+{
+    WCHAR path[MAX_PATH], kf[MAX_PATH];
+    ITEMIDLIST *pidl, *base = NULL;
+    unsigned int i, len, n, depth = 0;
+
+    free_crumbs();
+    if (!fe.pidl) return;
+
+    if (pidl_path(fe.pidl, path))
+    {
+        for (i = 0; i < ARRAY_SIZE(pc_folders) && !base; i++)
+        {
+            ITEMIDLIST *k = known_folder(pc_folders[i]);
+            if (k && pidl_path(k, kf) && (len = lstrlenW(kf)) && !wcsnicmp(path, kf, len) &&
+                (!path[len] || path[len] == '\\'))
+            {
+                base = k;
+                continue;
+            }
+            ILFree(k);
+        }
+    }
+
+    if (base)
+    {
+        const WCHAR *rest;
+        WCHAR sub[MAX_PATH];
+
+        pidl_path(base, kf);
+        add_crumb(fe.mycomputer, NULL);
+        add_crumb(base, NULL);
+        rest = path + lstrlenW(kf);
+        while (*rest == '\\') rest++;
+        lstrcpyW(sub, kf);
+        while (*rest)
+        {
+            const WCHAR *end = wcschr(rest, '\\');
+            WCHAR part[MAX_PATH];
+            len = end ? end - rest : lstrlenW(rest);
+            lstrcpynW(part, rest, len + 1);
+            PathAppendW(sub, part);
+            if ((pidl = ILCreateFromPathW(sub))) { add_crumb(pidl, NULL); ILFree(pidl); }
+            rest += len;
+            while (*rest == '\\') rest++;
+        }
+        ILFree(base);
+    }
+    else
+    {
+        /* the location's own ancestry below the desktop */
+        const ITEMIDLIST *p = fe.pidl;
+        while (!ILIsEmpty(p)) { depth++; p = ILGetNext(p); }
+        if (!depth)
+        {
+            add_crumb(fe.pidl, NULL);
+        }
+        for (n = 1; n <= depth; n++)
+        {
+            pidl = ILClone(fe.pidl);
+            for (i = depth; i > n; i--) ILRemoveLastID(pidl);
+            add_crumb(pidl, NULL);
+            ILFree(pidl);
+        }
+    }
+    if (fe.content == CONTENT_SEARCH && fe.ncrumbs < ARRAY_SIZE(fe.crumbs))
+    {
+        struct crumb *c = &fe.crumbs[fe.ncrumbs++];
+        c->pidl = NULL;
+        swprintf(c->name, MAX_PATH, L"Search Results in %s", fe.search_where);
+    }
+    fe.addr_icon = small_icon(fe.pidl);
+}
+
+static void addrbar_layout(void)
+{
+    RECT client;
+    int h = S(30), y, search_w, x = S(6), i, avail, total;
+    HDC dc;
+    HFONT old;
+
+    GetClientRect(fe.addrbar, &client);
+    y = (client.bottom - h) / 2;
+    SetRect(&fe.rc_back, x, y, x + S(32), y + h); x += S(34);
+    SetRect(&fe.rc_fwd, x, y, x + S(32), y + h); x += S(34);
+    SetRect(&fe.rc_up, x, y, x + S(32), y + h); x += S(40);
+    search_w = min(S(260), max(S(140), client.right / 4));
+    SetRect(&fe.rc_search, client.right - S(8) - search_w, y, client.right - S(8), y + h);
+    SetRect(&fe.rc_addr, x, y, fe.rc_search.left - S(8), y + h);
+    SetRect(&fe.rc_refresh, fe.rc_addr.right - S(32), y + 1, fe.rc_addr.right - 1, y + h - 1);
+
+    if (fe.addr_edit)
+        MoveWindow(fe.addr_edit, fe.rc_addr.left + S(8), y + (h - fe.font_height) / 2,
+                   fe.rc_refresh.left - fe.rc_addr.left - S(12), fe.font_height, TRUE);
+    if (fe.search_edit)
+        MoveWindow(fe.search_edit, fe.rc_search.left + S(8), y + (h - fe.font_height) / 2,
+                   fe.rc_search.right - fe.rc_search.left - S(40), fe.font_height, TRUE);
+
+    /* crumbs: from the right, as many as fit */
+    SetRect(&fe.rc_crumbs, fe.rc_addr.left + S(30), y + 1, fe.rc_refresh.left - S(2), y + h - 1);
+    dc = GetDC(fe.addrbar);
+    old = SelectObject(dc, fe.font);
+    total = 0;
+    for (i = 0; i < fe.ncrumbs; i++)
+    {
+        SIZE sz;
+        GetTextExtentPoint32W(dc, fe.crumbs[i].name, lstrlenW(fe.crumbs[i].name), &sz);
+        fe.crumbs[i].text.right = sz.cx + S(10);   /* width, for now */
+    }
+    avail = fe.rc_crumbs.right - fe.rc_crumbs.left - S(26);
+    fe.first_crumb = fe.ncrumbs;
+    for (i = fe.ncrumbs - 1; i >= 0; i--)
+    {
+        int w = fe.crumbs[i].text.right + S(20);
+        if (total + w > avail && i < fe.ncrumbs - 1) break;
+        total += w;
+        fe.first_crumb = i;
+    }
+    x = fe.rc_crumbs.left;
+    SetRectEmpty(&fe.rc_overflow);
+    if (fe.first_crumb > 0)
+    {
+        SetRect(&fe.rc_overflow, x, fe.rc_crumbs.top + S(2), x + S(22), fe.rc_crumbs.bottom - S(2));
+        x += S(24);
+    }
+    for (i = 0; i < fe.ncrumbs; i++)
+    {
+        struct crumb *c = &fe.crumbs[i];
+        int w = c->text.right;
+        if (i < fe.first_crumb) { SetRectEmpty(&c->text); SetRectEmpty(&c->chevron); continue; }
+        SetRect(&c->text, x, fe.rc_crumbs.top + S(2), min(x + w, fe.rc_crumbs.right), fe.rc_crumbs.bottom - S(2));
+        x = c->text.right;
+        if (c->pidl && (i < fe.ncrumbs - 1 || fe.content != CONTENT_SEARCH))
+        {
+            SetRect(&c->chevron, x, c->text.top, min(x + S(18), fe.rc_crumbs.right), c->text.bottom);
+            x = c->chevron.right + S(2);
+        }
+        else SetRectEmpty(&c->chevron);
+    }
+    SelectObject(dc, old);
+    ReleaseDC(fe.addrbar, dc);
+}
+
+static void nav_button(HDC dc, const RECT *rc, int glyph, BOOL enabled, int id)
+{
+    if (enabled && fe.addr_pressed == id) fill(dc, rc, C_PRESSED);
+    else if (enabled && fe.addr_hot == id) fill(dc, rc, C_HOT);
+    draw_glyph(dc, glyph, rc->left + (rc->right - rc->left - S(16)) / 2, rc->top + (rc->bottom - rc->top - S(16)) / 2,
+               S(16), enabled ? C_TEXT : C_DISABLED);
+}
+
+static void addrbar_paint(HWND hwnd)
+{
+    struct paint p;
+    HDC dc = begin_paint(hwnd, &p);
+    RECT rc, line = p.rc;
+    int i;
+
+    nav_button(dc, &fe.rc_back, G_BACK, fe.can_back, A_BACK);
+    nav_button(dc, &fe.rc_fwd, G_FORWARD, fe.can_forward, A_FWD);
+    nav_button(dc, &fe.rc_up, G_UP, fe.can_up, A_UP);
+
+    /* the address box */
+    frame(dc, &fe.rc_addr, fe.editing ? C_ACCENT : fe.addr_hot == A_BOX ? blend(C_BORDER, C_ACCENT, 40) : C_BORDER);
+    if (fe.editing)
+    {
+        rc = fe.rc_addr;
+        rc.top = rc.bottom - S(2);
+        fill(dc, &rc, C_ACCENT);
+    }
+    else
+    {
+        if (fe.addr_icon >= 0)
+            ImageList_Draw(fe.small_icons, fe.addr_icon, dc, fe.rc_addr.left + S(8),
+                           fe.rc_addr.top + (fe.rc_addr.bottom - fe.rc_addr.top - S(16)) / 2, ILD_TRANSPARENT);
+        if (!IsRectEmpty(&fe.rc_overflow))
+        {
+            if (fe.addr_hot == A_OVERFLOW) fill(dc, &fe.rc_overflow, C_HOT);
+            draw_glyph(dc, G_CHEVRON_LEFT2, fe.rc_overflow.left + S(4), fe.rc_overflow.top + (fe.rc_overflow.bottom - fe.rc_overflow.top - S(14)) / 2, S(14), C_TEXT);
+        }
+        for (i = fe.first_crumb; i < fe.ncrumbs; i++)
+        {
+            struct crumb *c = &fe.crumbs[i];
+            if (fe.addr_pressed == i || fe.addr_pressed == A_CHEVRON + i)
+            {
+                RECT both = c->text;
+                if (!IsRectEmpty(&c->chevron)) both.right = c->chevron.right;
+                fill(dc, &both, C_PRESSED);
+            }
+            else if (fe.addr_hot == i || fe.addr_hot == A_CHEVRON + i)
+            {
+                RECT both = c->text;
+                if (!IsRectEmpty(&c->chevron)) both.right = c->chevron.right;
+                fill(dc, &both, C_HOT);
+                if (fe.addr_hot == A_CHEVRON + i || fe.addr_hot == i)
+                {
+                    RECT sep = { c->text.right, c->text.top, c->text.right + 1, c->text.bottom };
+                    if (!IsRectEmpty(&c->chevron)) fill(dc, &sep, C_PRESSED);
+                }
+            }
+            rc = c->text;
+            rc.left += S(5);
+            text(dc, c->name, &rc, C_TEXT, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_END_ELLIPSIS);
+            if (!IsRectEmpty(&c->chevron))
+                draw_glyph(dc, G_CHEVRON_RIGHT, c->chevron.left + (c->chevron.right - c->chevron.left - S(12)) / 2,
+                           c->chevron.top + (c->chevron.bottom - c->chevron.top - S(12)) / 2, S(12), C_MUTED);
+        }
+    }
+    nav_button(dc, &fe.rc_refresh, fe.content == CONTENT_SEARCH && fe.searching ? G_CLOSE : G_REFRESH, TRUE, A_REFRESH);
+
+    /* the search box */
+    frame(dc, &fe.rc_search, GetFocus() == fe.search_edit ? C_ACCENT : C_BORDER);
+    if (GetFocus() == fe.search_edit)
+    {
+        rc = fe.rc_search;
+        rc.top = rc.bottom - S(2);
+        fill(dc, &rc, C_ACCENT);
+    }
+    draw_glyph(dc, G_SEARCH, fe.rc_search.right - S(26), fe.rc_search.top + (fe.rc_search.bottom - fe.rc_search.top - S(14)) / 2,
+               S(14), C_MUTED);
+
+    line.top = line.bottom - 1;
+    fill(dc, &line, C_LINE);
+    end_paint(hwnd, &p);
+}
+
+static int addr_hit(int x, int y)
+{
+    POINT pt = { x, y };
+    int i;
+
+    if (PtInRect(&fe.rc_back, pt)) return A_BACK;
+    if (PtInRect(&fe.rc_fwd, pt)) return A_FWD;
+    if (PtInRect(&fe.rc_up, pt)) return A_UP;
+    if (PtInRect(&fe.rc_refresh, pt)) return A_REFRESH;
+    if (fe.editing) return A_NONE;
+    if (PtInRect(&fe.rc_overflow, pt)) return A_OVERFLOW;
+    for (i = fe.first_crumb; i < fe.ncrumbs; i++)
+    {
+        if (PtInRect(&fe.crumbs[i].text, pt)) return i;
+        if (PtInRect(&fe.crumbs[i].chevron, pt)) return A_CHEVRON + i;
+    }
+    if (PtInRect(&fe.rc_addr, pt)) return A_BOX;
+    return A_NONE;
+}
