+static void status_paint(HWND hwnd)
+{
+    struct paint p;
+    HDC dc = begin_paint(hwnd, &p);
+    RECT rc = p.rc, line = p.rc;
+    UINT mode = fe.content == CONTENT_FOLDER ? current_view_mode() : 0;
+    int y = (p.rc.bottom - S(22)) / 2;
+
+    line.bottom = 1;
+    fill(dc, &line, C_LINE);
+    rc.left += S(12);
+    SelectObject(dc, fe.font_small);
+    text(dc, fe.status_left, &rc, C_TEXT, DT_SINGLELINE | DT_VCENTER | DT_LEFT);
+    if (fe.status_sel[0])
+    {
+        SIZE sz;
+        GetTextExtentPoint32W(dc, fe.status_left, lstrlenW(fe.status_left), &sz);
+        rc.left += sz.cx + S(24);
+        text(dc, fe.status_sel, &rc, C_TEXT, DT_SINGLELINE | DT_VCENTER | DT_LEFT);
+    }
+
+    SetRect(&fe.rc_view_icons, p.rc.right - S(30), y, p.rc.right - S(6), y + S(22));
+    SetRect(&fe.rc_view_details, fe.rc_view_icons.left - S(26), y, fe.rc_view_icons.left - S(2), y + S(22));
+    if (fe.content == CONTENT_FOLDER)
+    {
+        if (mode == FVM_DETAILS) fill(dc, &fe.rc_view_details, C_PRESSED);
+        if (mode == FVM_ICON) fill(dc, &fe.rc_view_icons, C_PRESSED);
+    }
+    draw_glyph(dc, G_DETAILS, fe.rc_view_details.left + S(5), y + S(4), S(14), fe.content == CONTENT_FOLDER ? C_TEXT : C_DISABLED);
+    draw_glyph(dc, G_ICONS, fe.rc_view_icons.left + S(5), y + S(4), S(14), fe.content == CONTENT_FOLDER ? C_TEXT : C_DISABLED);
+    end_paint(hwnd, &p);
+}
+
+static LRESULT CALLBACK status_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    POINT pt;
+
+    switch (msg)
+    {
+    case WM_PAINT:
+        status_paint(hwnd);
+        return 0;
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_LBUTTONUP:
+        pt.x = GET_X_LPARAM(lp); pt.y = GET_Y_LPARAM(lp);
+        if (PtInRect(&fe.rc_view_details, pt)) run_command(CMD_VIEW_BASE + FVM_DETAILS);
+        else if (PtInRect(&fe.rc_view_icons, pt)) run_command(CMD_VIEW_BASE + FVM_ICON);
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
