-    if(ILIsEqual(info->pidl,desktop_pidl))
-        main_item = item;
-    else
-        CoTaskMemFree(item.pszText);
-    /*Add all direct subfolders of Desktop*/
-    if(SUCCEEDED(IShellFolder_EnumObjects(desktop,NULL,SHCONTF_FOLDERS,&ids))
-       && ids!=NULL)
-    {
-        LPITEMIDLIST curr_pidl=NULL;
-        HRESULT hres;
-
-        item.iIndent = 1;
-        while(1)
-        {
-            ILFree(curr_pidl);
