+/* ------------------------------------------------------------------------ */
+/* the window                                                               */
+
+#define CMDBAR_H 48
+#define ADDRBAR_H 44
+#define STATUS_H 26
+
+static void layout(void)
+{
+    RECT client, rc;
+    int top, bottom, nav = fe.show_nav ? fe.nav_width : 0;
+
+    if (!fe.hwnd) return;
+    GetClientRect(fe.hwnd, &client);
+    top = S(CMDBAR_H) + S(ADDRBAR_H);
+    bottom = client.bottom - S(STATUS_H);
+    MoveWindow(fe.cmdbar, 0, 0, client.right, S(CMDBAR_H), TRUE);
+    MoveWindow(fe.addrbar, 0, S(CMDBAR_H), client.right, S(ADDRBAR_H), TRUE);
+    MoveWindow(fe.status, 0, bottom, client.right, S(STATUS_H), TRUE);
+    ShowWindow(fe.tree, fe.show_nav ? SW_SHOW : SW_HIDE);
+    if (fe.show_nav) MoveWindow(fe.tree, 0, top, nav, bottom - top, TRUE);
+    SetRect(&rc, nav ? nav + S(5) : 0, top, client.right, bottom);
+    fe.content_rc = rc;
+    if (fe.browser) IExplorerBrowser_SetRect(fe.browser, NULL, rc);
+    MoveWindow(fe.page, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, TRUE);
+    MoveWindow(fe.results, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, TRUE);
+    InvalidateRect(fe.hwnd, NULL, TRUE);
+}
+
+static BOOL handle_copydata(const COPYDATASTRUCT *cds)
+{
+    static const unsigned int magic = 0xe32ee32e;
+    unsigned int i, flags, count;
+    const ITEMIDLIST *child;
+    unsigned char *ptr;
+    IShellView *sv;
+    SVSIF sv_flags;
+
+    /* For SHOpenFolderAndSelectItems() */
+    if (cds->dwData != magic) return FALSE;
+    ptr = cds->lpData;
+    memcpy(&count, ptr, sizeof(count));
+    ptr += sizeof(count);
+    memcpy(&flags, ptr, sizeof(flags));
+    ptr += sizeof(flags);
+    sv_flags = flags & OFASI_EDIT ? SVSI_EDIT : SVSI_SELECT;
+    if (fe.content == CONTENT_SEARCH) exit_search(TRUE);
+    if (!(sv = get_view())) return FALSE;
+    for (i = 0; i < count; ++i)
+    {
+        child = (const ITEMIDLIST *)ptr;
+        if (i == 0)
+            IShellView_SelectItem(sv, child, sv_flags | SVSI_ENSUREVISIBLE | SVSI_FOCUSED | SVSI_DESELECTOTHERS);
+        else
+            IShellView_SelectItem(sv, child, sv_flags);
+        ptr += ILGetSize(child);
+    }
+    IShellView_Release(sv);
+    SetForegroundWindow(fe.hwnd);
+    return TRUE;
+}
+
+static LRESULT CALLBACK frame_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg)
+    {
+    case WM_SIZE:
+        layout();
+        return 0;
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC dc = BeginPaint(hwnd, &ps);
+        RECT client, split;
+        GetClientRect(hwnd, &client);
+        fill(dc, &ps.rcPaint, C_BG);
+        if (fe.show_nav)
+        {
+            SetRect(&split, fe.nav_width + S(2), S(CMDBAR_H) + S(ADDRBAR_H), fe.nav_width + S(3), client.bottom - S(STATUS_H));
+            fill(dc, &split, C_LINE);
+        }
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+    case WM_SETCURSOR:
+    {
+        POINT pt;
+        GetCursorPos(&pt);
+        ScreenToClient(hwnd, &pt);
+        if ((HWND)wp == hwnd && fe.show_nav && pt.x >= fe.nav_width && pt.x < fe.nav_width + S(5))
+        {
+            SetCursor(LoadCursorW(NULL, (LPCWSTR)IDC_SIZEWE));
+            return TRUE;
+        }
+        break;
+    }
+    case WM_LBUTTONDOWN:
+        if (fe.show_nav && GET_X_LPARAM(lp) >= fe.nav_width && GET_X_LPARAM(lp) < fe.nav_width + S(5))
+        {
+            fe.dragging_split = TRUE;
+            SetCapture(hwnd);
+        }
+        return 0;
+    case WM_MOUSEMOVE:
+        if (fe.dragging_split)
+        {
+            RECT client;
+            GetClientRect(hwnd, &client);
+            fe.nav_width = max(S(120), min(GET_X_LPARAM(lp), client.right - S(200)));
+            layout();
+        }
+        return 0;
+    case WM_LBUTTONUP:
+        if (fe.dragging_split)
+        {
+            fe.dragging_split = FALSE;
+            ReleaseCapture();
+            set_reg_dword(NULL, L"NavigationPaneWidth", MulDiv(fe.nav_width, 96, fe.dpi));
+        }
+        return 0;
+    case WM_NOTIFY:
+    {
+        NMHDR *hdr = (NMHDR *)lp;
+        if (hdr->hwndFrom == fe.tree) return tree_notify(hdr);
+        if (hdr->hwndFrom == fe.results) return results_notify(hdr);
+        break;
+    }
+    case WM_TIMER:
+        if (wp == TIMER_SEARCH) { KillTimer(hwnd, TIMER_SEARCH); start_search(); }
+        if (wp == TIMER_NEWITEM && (rename_new_item() || ++fe.new_item_tries > 20)) KillTimer(hwnd, TIMER_NEWITEM);
+        return 0;
+    case WM_FE_STATUS:
+    {
+        MSG m;
+        while (PeekMessageW(&m, hwnd, WM_FE_STATUS, WM_FE_STATUS, PM_REMOVE));
+        update_status();
+        return 0;
+    }
+    case WM_FE_RESULT:
+    {
+        struct result *r = (struct result *)lp;
+        if ((LONG)wp == fe.search_gen && fe.content == CONTENT_SEARCH)
+        {
+            add_result(r);
+            if (!(fe.nresults % 50) || fe.nresults < 50) update_status();
+        }
+        else { free(r->path); free(r); }
+        return 0;
+    }
+    case WM_FE_SEARCHDONE:
+        if ((LONG)wp == fe.search_gen)
+        {
+            fe.searching = FALSE;
+            TRACE("search done, %d results\n", fe.nresults);
+            if (fe.results_sort >= 0) SendMessageW(fe.results, LVM_SORTITEMS, fe.results_sort, (LPARAM)results_compare);
+            update_status();
+            InvalidateRect(fe.addrbar, NULL, FALSE);
+        }
+        return 0;
+    case WM_CLIPBOARDUPDATE:
+        update_commands();
+        return 0;
+    case WM_ACTIVATE:
+        if (LOWORD(wp) != WA_INACTIVE) update_commands();
+        break;
+    case WM_COMMAND:
+        run_command(LOWORD(wp));
+        return 0;
+    case WM_APPCOMMAND:
+        switch (GET_APPCOMMAND_LPARAM(lp))
+        {
+        case APPCOMMAND_BROWSER_BACKWARD: run_command(CMD_BACK); return TRUE;
+        case APPCOMMAND_BROWSER_FORWARD: run_command(CMD_FORWARD); return TRUE;
+        case APPCOMMAND_BROWSER_REFRESH: run_command(CMD_REFRESH); return TRUE;
+        case APPCOMMAND_BROWSER_SEARCH: run_command(CMD_SEARCH); return TRUE;
+        }
+        break;
+    case WM_COPYDATA:
+        return handle_copydata((const COPYDATASTRUCT *)lp);
+    case WM_CLOSE:
+    {
+        WINDOWPLACEMENT wpl = { sizeof(wpl) };
+        if (GetWindowPlacement(hwnd, &wpl))
+        {
+            set_reg_dword(NULL, L"WindowWidth", MulDiv(wpl.rcNormalPosition.right - wpl.rcNormalPosition.left, 96, fe.dpi));
+            set_reg_dword(NULL, L"WindowHeight", MulDiv(wpl.rcNormalPosition.bottom - wpl.rcNormalPosition.top, 96, fe.dpi));
+            set_reg_dword(NULL, L"WindowMaximized", wpl.showCmd == SW_SHOWMAXIMIZED);
+        }
+        break;
+    }
+    case WM_DESTROY:
+        InterlockedIncrement(&fe.search_gen);
+        RemoveClipboardFormatListener(hwnd);
+        if (fe.sw)
+        {
+            IShellWindows_Revoke(fe.sw, fe.sw_cookie);
+            IShellWindows_Release(fe.sw);
+            fe.sw = NULL;
+        }
+        if (fe.browser)
+        {
+            IExplorerBrowser_Unadvise(fe.browser, fe.advise_cookie);
+            IExplorerBrowser_Destroy(fe.browser);
+            IExplorerBrowser_Release(fe.browser);
+            fe.browser = NULL;
+        }
+        PostQuitMessage(0);
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
