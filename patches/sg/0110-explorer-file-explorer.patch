+static void begin_address_edit(void)
+{
+    WCHAR path[MAX_PATH];
+
+    if (!pidl_path(fe.pidl, path)) display_name(fe.pidl, path, MAX_PATH);
+    fe.editing = TRUE;
+    SetWindowTextW(fe.addr_edit, path);
+    ShowWindow(fe.addr_edit, SW_SHOW);
+    SetFocus(fe.addr_edit);
+    SendMessageW(fe.addr_edit, EM_SETSEL, 0, -1);
+    InvalidateRect(fe.addrbar, NULL, FALSE);
+}
+
+static void end_address_edit(void)
+{
+    if (!fe.editing) return;
+    fe.editing = FALSE;
+    ShowWindow(fe.addr_edit, SW_HIDE);
+    InvalidateRect(fe.addrbar, NULL, FALSE);
+}
+
+/* the subfolders of a crumb, to go to */
+static void crumb_menu(int index)
+{
+    IShellFolder *desktop, *folder = NULL;
+    IEnumIDList *ids;
+    ITEMIDLIST *child, *items[200];
+    HMENU menu = CreatePopupMenu();
+    int n = 0, cmd, i;
+    const ITEMIDLIST *pidl = index >= 0 ? fe.crumbs[index].pidl : NULL;
+
+    if (index < 0)
+    {
+        /* the crumbs that did not fit */
+        for (i = fe.first_crumb - 1; i >= 0; i--)
+            AppendMenuW(menu, MF_STRING, 1 + i, fe.crumbs[i].name);
+        if ((cmd = popup(menu, fe.addrbar, &fe.rc_overflow))) navigate(fe.crumbs[cmd - 1].pidl);
+        return;
+    }
+
+    SHGetDesktopFolder(&desktop);
+    if (ILIsEmpty(pidl)) { folder = desktop; IShellFolder_AddRef(folder); }
+    else IShellFolder_BindToObject(desktop, pidl, NULL, &IID_IShellFolder, (void **)&folder);
+    if (folder && IShellFolder_EnumObjects(folder, fe.hwnd, SHCONTF_FOLDERS, &ids) == S_OK)
+    {
+        while (n < ARRAY_SIZE(items) && IEnumIDList_Next(ids, 1, &child, NULL) == S_OK)
+        {
+            STRRET str;
+            WCHAR name[MAX_PATH];
+            if (SUCCEEDED(IShellFolder_GetDisplayNameOf(folder, child, SHGDN_INFOLDER, &str)) &&
+                SUCCEEDED(StrRetToBufW(&str, child, name, MAX_PATH)))
+            {
+                items[n++] = child;
+                AppendMenuW(menu, MF_STRING, n, name);
+            }
+            else ILFree(child);
+        }
+        IEnumIDList_Release(ids);
+    }
+    if (folder) IShellFolder_Release(folder);
+    IShellFolder_Release(desktop);
+    if (!n) AppendMenuW(menu, MF_STRING | MF_GRAYED, 0, L"(empty)");
+    fe.addr_pressed = A_CHEVRON + index;
+    InvalidateRect(fe.addrbar, NULL, FALSE);
+    cmd = popup(menu, fe.addrbar, &fe.crumbs[index].chevron);
+    fe.addr_pressed = A_NONE;
+    InvalidateRect(fe.addrbar, NULL, FALSE);
+    if (cmd > 0)
+    {
+        ITEMIDLIST *full = ILCombine(pidl, items[cmd - 1]);
+        navigate(full);
+        ILFree(full);
+    }
+    for (i = 0; i < n; i++) ILFree(items[i]);
+}
+
+static LRESULT CALLBACK addrbar_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    int hit;
+
+    switch (msg)
+    {
+    case WM_PAINT:
+        addrbar_paint(hwnd);
+        return 0;
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_SIZE:
+        addrbar_layout();
+        return 0;
+    case WM_CTLCOLOREDIT:
+        SetBkColor((HDC)wp, C_BG);
+        SetTextColor((HDC)wp, C_TEXT);
+        SetDCBrushColor((HDC)wp, C_BG);
+        return (LRESULT)GetStockObject(DC_BRUSH);
+    case WM_COMMAND:
+        if ((HWND)lp == fe.search_edit && HIWORD(wp) == EN_CHANGE)
+            SetTimer(fe.hwnd, TIMER_SEARCH, 450, NULL);
+        if ((HWND)lp == fe.search_edit && (HIWORD(wp) == EN_SETFOCUS || HIWORD(wp) == EN_KILLFOCUS))
+            InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_MOUSEMOVE:
+    {
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd };
+        hit = addr_hit(GET_X_LPARAM(lp), GET_Y_LPARAM(lp));
+        if (hit != fe.addr_hot) { fe.addr_hot = hit; InvalidateRect(hwnd, NULL, FALSE); }
+        TrackMouseEvent(&tme);
+        return 0;
+    }
+    case WM_MOUSELEAVE:
+        fe.addr_hot = A_NONE;
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_LBUTTONDOWN:
+        hit = addr_hit(GET_X_LPARAM(lp), GET_Y_LPARAM(lp));
+        if (hit >= A_CHEVRON) { crumb_menu(hit - A_CHEVRON); return 0; }
+        if (hit == A_OVERFLOW) { crumb_menu(-1); return 0; }
+        if (hit == A_BOX) { begin_address_edit(); return 0; }
+        if (PtInRect(&fe.rc_search, (POINT){ GET_X_LPARAM(lp), GET_Y_LPARAM(lp) }))
+        {
+            SetFocus(fe.search_edit);
+            return 0;
+        }
+        fe.addr_pressed = hit;
+        SetCapture(hwnd);
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_LBUTTONUP:
+        if (GetCapture() == hwnd) ReleaseCapture();
+        hit = addr_hit(GET_X_LPARAM(lp), GET_Y_LPARAM(lp));
+        if (hit == fe.addr_pressed)
+        {
+            fe.addr_pressed = A_NONE;
+            if (hit == A_BACK && fe.can_back) run_command(CMD_BACK);
+            else if (hit == A_FWD && fe.can_forward) run_command(CMD_FORWARD);
+            else if (hit == A_UP && fe.can_up) run_command(CMD_UP);
+            else if (hit == A_REFRESH) run_command(CMD_REFRESH);
+            else if (hit >= 0 && hit < fe.ncrumbs && fe.crumbs[hit].pidl)
+            {
+                if (fe.content == CONTENT_SEARCH) exit_search(FALSE);
+                navigate(fe.crumbs[hit].pidl);
+            }
+        }
+        fe.addr_pressed = A_NONE;
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+static WNDPROC edit_proc;
+
+/* what the user typed in the address bar: a folder, a shell location, a
+ * program or a document; a Unix path works too */
+static void go_to_address(const WCHAR *typed)
+{
+    WCHAR buf[MAX_PATH * 2], *path = buf;
+    ITEMIDLIST *pidl = NULL;
+    SFGAOF attrs = SFGAO_FOLDER;
+    SHELLEXECUTEINFOW sei = { sizeof(sei) };
+    WCHAR msg[MAX_PATH + 100];
+    static const struct { const WCHAR *name; const WCHAR *where; } names[] =
+    {
+        { L"This PC", L"::{20D04FE0-3AEA-1069-A2D8-08002B30309D}" },
+        { L"Computer", L"::{20D04FE0-3AEA-1069-A2D8-08002B30309D}" },
+        { L"Recycle Bin", L"::{645FF040-5081-101B-9F08-00AA002F954E}" },
+        { L"Network", L"::{F02C1A0D-BE21-4350-88B0-7367FC96EF3C}" },
+        { L"Control Panel", L"::{26EE0668-A00A-44D7-9371-BEB064C98683}" },
+    };
+    unsigned int i;
+
+    ExpandEnvironmentStringsW(typed, buf, ARRAY_SIZE(buf));
+    StrTrimW(buf, L" \t\"");
+    if (!buf[0]) return;
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+        if (!wcsicmp(buf, names[i].name)) { lstrcpyW(buf, names[i].where); break; }
+    if (buf[0] == '/')
+    {
+        char unix_path[MAX_PATH * 3];
+        WCHAR *dos;
+        WideCharToMultiByte(CP_UNIXCP, 0, buf, -1, unix_path, sizeof(unix_path), NULL, NULL);
+        if ((dos = wine_get_dos_file_name(unix_path)))
+        {
+            lstrcpynW(buf, dos, ARRAY_SIZE(buf));
+            HeapFree(GetProcessHeap(), 0, dos);
+        }
+    }
+    if (buf[0] && buf[1] == ':' && !buf[2]) lstrcatW(buf, L"\\");
+
+    if (SUCCEEDED(SHParseDisplayName(path, NULL, &pidl, SFGAO_FOLDER, &attrs)) && pidl)
+    {
+        if (attrs & SFGAO_FOLDER)
+        {
+            end_address_edit();
+            if (fe.content == CONTENT_SEARCH) exit_search(FALSE);
+            navigate(pidl);
+            ILFree(pidl);
+            SetFocus(get_view_list());
+            return;
+        }
+        ILFree(pidl);
+    }
+    sei.fMask = SEE_MASK_FLAG_NO_UI;
+    sei.hwnd = fe.hwnd;
+    sei.lpFile = path;
+    sei.nShow = SW_SHOWNORMAL;
+    if (ShellExecuteExW(&sei))
+    {
+        end_address_edit();
+        return;
+    }
+    swprintf(msg, ARRAY_SIZE(msg), L"File Explorer can't find '%s'. Check the spelling and try again.", typed);
+    MessageBoxW(fe.hwnd, msg, L"File Explorer", MB_OK | MB_ICONERROR);
+}
+
+static LRESULT CALLBACK edits_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg)
+    {
+    case WM_KEYDOWN:
+        if (wp == VK_RETURN)
+        {
+            if (hwnd == fe.addr_edit)
+            {
+                WCHAR typed[MAX_PATH * 2];
+                GetWindowTextW(hwnd, typed, ARRAY_SIZE(typed));
+                go_to_address(typed);
+            }
+            else
+            {
+                KillTimer(fe.hwnd, TIMER_SEARCH);
+                start_search();
+            }
+            return 0;
+        }
+        if (wp == VK_ESCAPE)
+        {
+            if (hwnd == fe.addr_edit) { end_address_edit(); SetFocus(get_view_list()); }
+            else
+            {
+                SetWindowTextW(hwnd, L"");
+                KillTimer(fe.hwnd, TIMER_SEARCH);
+                if (fe.content == CONTENT_SEARCH) exit_search(TRUE);
+            }
+            return 0;
+        }
+        break;
+    case WM_CHAR:
+        if (wp == '\r' || wp == 27) return 0;
+        break;
+    case WM_KILLFOCUS:
+        if (hwnd == fe.addr_edit) end_address_edit();
+        else InvalidateRect(fe.addrbar, NULL, FALSE);
+        break;
+    case WM_SETFOCUS:
+        if (hwnd == fe.search_edit) InvalidateRect(fe.addrbar, NULL, FALSE);
+        InvalidateRect(hwnd, NULL, TRUE);
+        break;
+    case WM_PAINT:
+        if (hwnd == fe.search_edit && !GetWindowTextLengthW(hwnd) && GetFocus() != hwnd)
+        {
+            /* the cue: "Search Documents" */
+            PAINTSTRUCT ps;
+            HDC dc = BeginPaint(hwnd, &ps);
+            RECT rc;
+            WCHAR cue[MAX_PATH + 16], name[MAX_PATH];
+            GetClientRect(hwnd, &rc);
+            fill(dc, &rc, C_BG);
+            display_name(fe.pidl, name, MAX_PATH);
+            swprintf(cue, ARRAY_SIZE(cue), L"Search %s", name);
+            SelectObject(dc, fe.font);
+            text(dc, cue, &rc, C_MUTED, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_END_ELLIPSIS);
+            EndPaint(hwnd, &ps);
+            return 0;
+        }
+        break;
+    }
+    return CallWindowProcW(edit_proc, hwnd, msg, wp, lp);
+}
+
+static void update_search_cue(void)
+{
+    InvalidateRect(fe.search_edit, NULL, TRUE);
+}
