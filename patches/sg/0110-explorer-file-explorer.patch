+/* root: the folder to open (a path or ::{CLSID}), or empty for This PC;
+ * selection: a file to select in it */
+void file_explorer_window(const WCHAR *root, const WCHAR *selection)
+{
+    struct GdiplusStartupInput gdip = { 1 };
+    ITEMIDLIST *start = NULL;
+    FOLDERSETTINGS fs;
+    RECT rc, work;
+    int width, height;
+    HDC dc;
+    MSG msg;
+    IObjectWithSite *ows;
+    IShellBrowser *sb;
+    WCHAR path[MAX_PATH];
+
+    CoCreateInstance(&CLSID_ShellWindows, NULL, CLSCTX_LOCAL_SERVER, &IID_IShellWindows, (void **)&fe.sw);
+
+    if (root && root[0] == ':' && root[1] == ':')
+        SHParseDisplayName(root, NULL, &start, 0, NULL);
+    else if (root && root[0])
+    {
+        GetFullPathNameW(root, MAX_PATH, path, NULL);
+        if (!(start = ILCreateFromPathW(path))) SHParseDisplayName(path, NULL, &start, 0, NULL);
+        if (!start) ERR("Failed to create PIDL for %s.\n", debugstr_w(path));
+    }
+    SHGetSpecialFolderLocation(NULL, CSIDL_DRIVES, &fe.mycomputer);
+    if (!start) start = ILClone(fe.mycomputer);   /* File Explorer opens to This PC */
+
+    /* already open there: bring that window forward (and select in it) */
+    if (fe.sw && start)
+    {
+        VARIANT var, empty;
+        IDispatch *dispatch;
+        LONG hwnd;
+
+        V_VT(&var) = VT_ARRAY | VT_UI1;
+        V_ARRAY(&var) = SafeArrayCreateVector(VT_UI1, 0, ILGetSize(start));
+        memcpy(V_ARRAY(&var)->pvData, start, ILGetSize(start));
+        V_VT(&empty) = VT_EMPTY;
+        if (IShellWindows_FindWindowSW(fe.sw, &var, &empty, SWC_EXPLORER, &hwnd, 0, &dispatch) == S_OK)
+        {
+            ITEMIDLIST *sel;
+            TRACE("Found window %#lx already browsing that folder.\n", hwnd);
+            VariantClear(&var);
+            if (selection && selection[0] && (sel = ILCreateFromPathW(selection)))
+            {
+                SHOpenFolderAndSelectItems(sel, 0, NULL, 0);
+                ILFree(sel);
+            }
+            SetForegroundWindow((HWND)(LONG_PTR)hwnd);
+            IShellWindows_Release(fe.sw);
+            ILFree(start);
+            return;
+        }
+        VariantClear(&var);
+    }
+    if (selection) lstrcpynW(fe.select_after, selection, MAX_PATH);
+
+    dc = GetDC(0);
+    fe.dpi = GetDeviceCaps(dc, LOGPIXELSY);
+    ReleaseDC(0, dc);
+    GdiplusStartup(&fe.gdip_token, &gdip, NULL);
+    create_fonts();
+    Shell_GetImageLists(&fe.big_icons, &fe.small_icons);
+    SHGetImageList(SHIL_EXTRALARGE, &IID_IImageList, (void **)&extra_large);
+    register_classes();
+    fe.cmd_hot = fe.cmd_pressed = -1;
+    fe.addr_hot = fe.addr_pressed = A_NONE;
+    fe.pc_sel = fe.pc_hot = -1;
+    fe.show_nav = reg_dword(NULL, L"NavigationPane", 1);
+    fe.nav_width = S(reg_dword(NULL, L"NavigationPaneWidth", 220));
+
+    if (FAILED(CoCreateInstance(&CLSID_ExplorerBrowser, NULL, CLSCTX_INPROC_SERVER, &IID_IExplorerBrowser, (void **)&fe.browser)))
+    {
+        ERR("Could not obtain an instance of IExplorerBrowser\n");
+        return;
+    }
+
+    SystemParametersInfoW(SPI_GETWORKAREA, 0, &work, 0);
+    width = min(S(reg_dword(NULL, L"WindowWidth", 1000)), work.right - work.left);
+    height = min(S(reg_dword(NULL, L"WindowHeight", 620)), work.bottom - work.top);
+    fe.hwnd = CreateWindowExW(0, L"ExplorerWClass", L"File Explorer", WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN,
+                              CW_USEDEFAULT, CW_USEDEFAULT, width, height, NULL, NULL, GetModuleHandleW(NULL), NULL);
+    if (fe.sw) IShellWindows_Register(fe.sw, NULL, (LONG_PTR)fe.hwnd, SWC_EXPLORER, &fe.sw_cookie);
+    AddClipboardFormatListener(fe.hwnd);
+
+    fe.tooltip = CreateWindowExW(WS_EX_TOPMOST, TOOLTIPS_CLASSW, NULL, TTS_ALWAYSTIP | TTS_NOPREFIX,
+                                 0, 0, 0, 0, fe.hwnd, NULL, NULL, NULL);
+    fe.cmdbar = CreateWindowExW(0, L"SGExplorerCommandBar", NULL, WS_CHILD | WS_VISIBLE, 0, 0, 0, 0, fe.hwnd, NULL, NULL, NULL);
