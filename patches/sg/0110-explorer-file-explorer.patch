+static void clipboard_verb(const char *verb)
+{
+    if (fe.content == CONTENT_FOLDER) { selection_verb(verb); return; }
+    if (fe.content == CONTENT_SEARCH)
+    {
+        /* the results come from many folders: put their paths on the clipboard as files */
+        int count;
+        WCHAR *list = selected_paths(&count), *p;
+        size_t len = 0;
+        HGLOBAL mem;
+        DROPFILES *df;
+
+        if (!list) return;
+        for (p = list; *p; p += lstrlenW(p) + 1) len += lstrlenW(p) + 1;
+        if ((mem = GlobalAlloc(GMEM_MOVEABLE | GMEM_ZEROINIT, sizeof(DROPFILES) + (len + 1) * sizeof(WCHAR))))
+        {
+            df = GlobalLock(mem);
+            df->pFiles = sizeof(DROPFILES);
+            df->fWide = TRUE;
+            memcpy(df + 1, list, len * sizeof(WCHAR));
+            GlobalUnlock(mem);
+            if (OpenClipboard(fe.hwnd))
+            {
+                HGLOBAL effect = GlobalAlloc(GMEM_MOVEABLE, sizeof(DWORD));
+                DWORD *e = GlobalLock(effect);
+                *e = strcmp(verb, "cut") ? DROPEFFECT_COPY : DROPEFFECT_MOVE;
+                GlobalUnlock(effect);
+                EmptyClipboard();
+                SetClipboardData(CF_HDROP, mem);
+                SetClipboardData(RegisterClipboardFormatW(CFSTR_PREFERREDDROPEFFECTW), effect);
+                CloseClipboard();
+            }
+            else GlobalFree(mem);
+        }
+        free(list);
+    }
+}
+
+static void run_command(int id)
+{
+    TRACE("command %d\n", id);
+    if (id >= CMD_VIEW_BASE && id < CMD_VIEW_BASE + 20) { set_view_mode(id - CMD_VIEW_BASE); return; }
+    if (id >= CMD_SORT_BASE && id < CMD_SORT_BASE + (int)ARRAY_SIZE(sort_pids)) { set_sort(id - CMD_SORT_BASE, 0); return; }
+    switch (id)
+    {
+    case CMD_BACK:
+        if (fe.content == CONTENT_SEARCH) { exit_search(TRUE); return; }
+        if (fe.history_pos <= 0) break;
+        fe.history_move = -1;
+        navigate(fe.history[fe.history_pos - 1]);
+        break;
+    case CMD_FORWARD:
+        if (fe.history_pos >= fe.nhistory - 1) break;
+        fe.history_move = 1;
+        navigate(fe.history[fe.history_pos + 1]);
+        break;
+    case CMD_UP:
+        if (fe.content == CONTENT_SEARCH) exit_search(FALSE);
+        if (fe.can_up) IExplorerBrowser_BrowseToObject(fe.browser, NULL, SBSP_PARENT);
+        break;
+    case CMD_REFRESH: refresh_view(); break;
+    case CMD_NEWFOLDER: new_item(TRUE); break;
+    case CMD_NEWTEXT: new_item(FALSE); break;
+    case CMD_CUT: clipboard_verb("cut"); break;
+    case CMD_COPY: clipboard_verb("copy"); break;
+    case CMD_PASTE: if (fe.content == CONTENT_FOLDER) background_verb("paste"); break;
+    case CMD_RENAME: rename_selection(); break;
+    case CMD_DELETE: delete_selection(FALSE); break;
+    case CMD_PERMDELETE: delete_selection(TRUE); break;
+    case CMD_PROPERTIES: properties(); break;
+    case CMD_SELECTALL: select_all(1); break;
+    case CMD_SELECTNONE: select_all(0); break;
+    case CMD_INVERT: select_all(2); break;
+    case CMD_COPYPATH: copy_as_path(); break;
+    case CMD_NEWWINDOW: open_new_window(); break;
+    case CMD_ADDRESS: begin_address_edit(); break;
+    case CMD_SEARCH:
+        SetFocus(fe.search_edit);
+        SendMessageW(fe.search_edit, EM_SETSEL, 0, -1);
+        break;
+    case CMD_CLOSE: PostMessageW(fe.hwnd, WM_CLOSE, 0, 0); break;
+    case CMD_SORT_ASC: set_sort(-1, 1); break;
+    case CMD_SORT_DESC: set_sort(-1, -1); break;
+    case CMD_SHOW_HIDDEN: toggle_setting(L"Hidden", 1, 2, setting_hidden()); break;
+    case CMD_SHOW_EXT: toggle_setting(L"HideFileExt", 0, 1, setting_extensions()); break;
+    case CMD_SHOW_NAVPANE:
+        fe.show_nav = !fe.show_nav;
+        set_reg_dword(NULL, L"NavigationPane", fe.show_nav);
+        layout();
+        break;
+    }
+}
+
+static void update_commands(void)
+{
+    int sel = 0;
+    BOOL folder = fe.content == CONTENT_FOLDER, fs = FALSE;
+    WCHAR path[MAX_PATH];
+    HWND list;
+
+    if (folder && (list = get_view_list())) sel = SendMessageW(list, LVM_GETSELECTEDCOUNT, 0, 0);
+    else if (fe.content == CONTENT_SEARCH) sel = SendMessageW(fe.results, LVM_GETSELECTEDCOUNT, 0, 0);
+    else if (fe.content == CONTENT_THISPC) sel = fe.pc_sel >= 0;
+    fs = folder && pidl_path(fe.pidl, path);
+
+    set_cmd_enabled(CMD_NEW, fs);
+    set_cmd_enabled(CMD_CUT, sel && fe.content != CONTENT_THISPC);
+    set_cmd_enabled(CMD_COPY, sel && fe.content != CONTENT_THISPC);
+    set_cmd_enabled(CMD_PASTE, fs && (IsClipboardFormatAvailable(CF_HDROP) ||
+                                      IsClipboardFormatAvailable(RegisterClipboardFormatW(CFSTR_SHELLIDLISTW))));
+    set_cmd_enabled(CMD_RENAME, sel == 1 && folder);
+    set_cmd_enabled(CMD_DELETE, sel && fe.content != CONTENT_THISPC);
+    set_cmd_enabled(CMD_SORT, folder);
+    set_cmd_enabled(CMD_PROPERTIES, sel || fs);
+}
+
+/* the keyboard, as in Windows' File Explorer */
+static BOOL translate_key(MSG *msg)
+{
+    BOOL ctrl = GetKeyState(VK_CONTROL) < 0, shift = GetKeyState(VK_SHIFT) < 0, alt = GetKeyState(VK_MENU) < 0;
+    HWND focus = GetFocus();
+    WCHAR cls[32] = {0};
+    BOOL in_edit, in_tree = focus == fe.tree;
+    int cmd = 0;
+
+    if (msg->message != WM_KEYDOWN && msg->message != WM_SYSKEYDOWN) return FALSE;
+    if (!focus || (focus != fe.hwnd && !IsChild(fe.hwnd, focus))) return FALSE;
+    GetClassNameW(focus, cls, ARRAY_SIZE(cls));
+    in_edit = !wcsicmp(cls, L"Edit");
+
+    switch (msg->wParam)
+    {
+    case VK_LEFT: if (alt) cmd = CMD_BACK; break;
+    case VK_RIGHT: if (alt) cmd = CMD_FORWARD; break;
+    case VK_UP: if (alt) cmd = CMD_UP; break;
+    case VK_BACK: if (!in_edit && !alt) cmd = CMD_BACK; break;
+    case VK_BROWSER_BACK: cmd = CMD_BACK; break;
+    case VK_BROWSER_FORWARD: cmd = CMD_FORWARD; break;
+    case VK_F5: cmd = CMD_REFRESH; break;
+    case 'R': if (ctrl && !in_edit) cmd = CMD_REFRESH; break;
+    case 'L': if (ctrl) cmd = CMD_ADDRESS; break;
+    case 'D': if (alt) cmd = CMD_ADDRESS; break;
+    case VK_F4: if (!alt && !ctrl) cmd = CMD_ADDRESS; break;
+    case 'F': case 'E': if (ctrl) cmd = CMD_SEARCH; break;
+    case VK_F3: cmd = CMD_SEARCH; break;
+    case 'N':
+        if (ctrl && shift) cmd = CMD_NEWFOLDER;
+        else if (ctrl && !in_edit) cmd = CMD_NEWWINDOW;
+        break;
+    case 'W': if (ctrl) cmd = CMD_CLOSE; break;
+    case VK_F2: if (!in_edit && !in_tree) cmd = CMD_RENAME; break;
+    case VK_DELETE: if (!in_edit && !in_tree) cmd = shift ? CMD_PERMDELETE : CMD_DELETE; break;
+    case 'C': if (ctrl && !in_edit && !in_tree) cmd = CMD_COPY; break;
+    case 'X': if (ctrl && !in_edit && !in_tree) cmd = CMD_CUT; break;
+    case 'V': if (ctrl && !in_edit && !in_tree) cmd = CMD_PASTE; break;
+    case 'A': if (ctrl && !in_edit && !in_tree) cmd = CMD_SELECTALL; break;
+    case VK_RETURN: if (alt && !in_edit) cmd = CMD_PROPERTIES; break;
+    case VK_F6:
+    case VK_TAB:
+        if (in_edit && focus != fe.search_edit && msg->wParam == VK_TAB) return FALSE;
+        if (focus == fe.tree) SetFocus(fe.content == CONTENT_FOLDER ? get_view_list() : fe.content == CONTENT_THISPC ? fe.page : fe.results);
+        else if (focus == fe.search_edit) SetFocus(fe.show_nav ? fe.tree : fe.content == CONTENT_THISPC ? fe.page : get_view_list());
+        else SetFocus(fe.search_edit);
+        return TRUE;
+    }
+    if (!cmd) return FALSE;
+    /* the window's own Alt handling must see that Alt was not pressed alone,
+     * or its release opens the window menu */
+    if (msg->message == WM_SYSKEYDOWN) DefWindowProcW(fe.hwnd, WM_SYSKEYDOWN, msg->wParam, msg->lParam);
+    run_command(cmd);
+    return TRUE;
+}
