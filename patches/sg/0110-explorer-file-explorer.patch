+static void select_all(int how)
+{
+    HWND list = fe.content == CONTENT_SEARCH ? fe.results : get_view_list();
+    LVITEMW item = { 0 };
+    int i, n;
+
+    if (!list) return;
+    item.stateMask = LVIS_SELECTED;
+    if (how != 2)
+    {
+        item.state = how ? LVIS_SELECTED : 0;
+        SendMessageW(list, LVM_SETITEMSTATE, -1, (LPARAM)&item);
+        return;
+    }
+    n = SendMessageW(list, LVM_GETITEMCOUNT, 0, 0);
+    for (i = 0; i < n; i++)
+    {
+        item.state = SendMessageW(list, LVM_GETITEMSTATE, i, LVIS_SELECTED) ^ LVIS_SELECTED;
+        SendMessageW(list, LVM_SETITEMSTATE, i, (LPARAM)&item);
+    }
+}
