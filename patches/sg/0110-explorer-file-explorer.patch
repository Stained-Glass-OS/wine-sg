+
+static HRESULT WINAPI events_OnNavigationComplete(IExplorerBrowserEvents *iface, PCIDLIST_ABSOLUTE pidl)
+{
+    WCHAR name[MAX_PATH];
+    ITEMIDLIST *parent;
+
+    if (fe.sw)
+    {
+        VARIANT var;
+        V_VT(&var) = VT_ARRAY | VT_UI1;
+        V_ARRAY(&var) = SafeArrayCreateVector(VT_UI1, 0, ILGetSize(pidl));
+        memcpy(V_ARRAY(&var)->pvData, pidl, ILGetSize(pidl));
+        IShellWindows_OnNavigate(fe.sw, fe.sw_cookie, &var);
+        VariantClear(&var);
+    }
+
+    ILFree(fe.pidl);
+    fe.pidl = ILClone(pidl);
+    TRACE("navigated to %s\n", debugstr_w((display_name(pidl, name, MAX_PATH), name)));
+
+    display_name(pidl, name, MAX_PATH);
+    SetWindowTextW(fe.hwnd, name);
+
+    parent = ILClone(pidl);
+    fe.can_up = ILRemoveLastID(parent);
+    ILFree(parent);
+
+    if (fe.history_move)
+    {
+        fe.history_pos = max(0, min(fe.nhistory - 1, fe.history_pos + fe.history_move));
+        fe.history_move = 0;
+    }
+    else if (!fe.nhistory || !ILIsEqual(fe.history[fe.history_pos], pidl))
+    {
+        int i;
+        for (i = fe.history_pos + 1; i < fe.nhistory; i++) ILFree(fe.history[i]);
+        fe.nhistory = fe.nhistory ? fe.history_pos + 1 : 0;
+        if (fe.nhistory == ARRAY_SIZE(fe.history))
+        {
+            ILFree(fe.history[0]);
+            memmove(fe.history, fe.history + 1, (fe.nhistory - 1) * sizeof(fe.history[0]));
+            fe.nhistory--;
+        }
+        fe.history[fe.nhistory++] = ILClone(pidl);
+        fe.history_pos = fe.nhistory - 1;
+    }
+    fe.can_back = fe.history_pos > 0;
+    fe.can_forward = fe.history_pos < fe.nhistory - 1;
+
+    if (fe.content == CONTENT_SEARCH) exit_search(FALSE);
+    show_content(fe.mycomputer && ILIsEqual(pidl, fe.mycomputer) ? CONTENT_THISPC : CONTENT_FOLDER);
+    update_search_cue();
+    sync_tree();
+    select_pending();
+    if (GetFocus() != fe.search_edit && GetFocus() != fe.addr_edit && GetFocus() != fe.tree)
+        SetFocus(fe.content == CONTENT_THISPC ? fe.page : get_view_list());
+    update_status();
+    return S_OK;
+}
