+/* ------------------------------------------------------------------------ */
+/* This PC: the user's folders, and devices and drives with capacity bars   */
+
+static IImageList *extra_large;
+
+static void load_thispc(void)
+{
+    IShellFolder *desktop, *pc;
+    IEnumIDList *ids;
+    ITEMIDLIST *child, *pidl;
+    SHFILEINFOW info;
+    unsigned int i;
+
+    for (i = 0; i < fe.npc; i++) ILFree(fe.pc[i].pidl);
+    fe.npc = 0;
+    fe.pc_sel = fe.pc_hot = -1;
+    for (i = 0; i < ARRAY_SIZE(pc_folders); i++)
+    {
+        struct pc_item *it;
+        if (!(pidl = known_folder(pc_folders[i]))) continue;
+        it = &fe.pc[fe.npc++];
+        memset(it, 0, sizeof(*it));
+        it->pidl = pidl;
+        display_name(pidl, it->name, MAX_PATH);
+        SHGetFileInfoW((WCHAR *)pidl, 0, &info, sizeof(info), SHGFI_PIDL | SHGFI_SYSICONINDEX);
+        it->icon = info.iIcon;
+    }
+    SHGetDesktopFolder(&desktop);
+    if (SUCCEEDED(IShellFolder_BindToObject(desktop, fe.mycomputer, NULL, &IID_IShellFolder, (void **)&pc)))
+    {
+        if (IShellFolder_EnumObjects(pc, fe.hwnd, SHCONTF_FOLDERS | SHCONTF_NONFOLDERS, &ids) == S_OK)
+        {
+            while (fe.npc < ARRAY_SIZE(fe.pc) && IEnumIDList_Next(ids, 1, &child, NULL) == S_OK)
+            {
+                struct pc_item *it;
+                WCHAR path[MAX_PATH];
+                ULARGE_INTEGER avail, total, free;
+                pidl = ILCombine(fe.mycomputer, child);
+                ILFree(child);
+                if (!pidl_path(pidl, path) || !PathIsRootW(path)) { ILFree(pidl); continue; }
+                it = &fe.pc[fe.npc++];
+                memset(it, 0, sizeof(*it));
+                it->pidl = pidl;
+                it->drive = TRUE;
+                it->section = 1;
+                lstrcpynW(it->root, path, 4);
+                display_name(pidl, it->name, MAX_PATH);
+                SHGetFileInfoW((WCHAR *)pidl, 0, &info, sizeof(info), SHGFI_PIDL | SHGFI_SYSICONINDEX);
+                it->icon = info.iIcon;
+                if (GetDiskFreeSpaceExW(it->root, &avail, &total, &free) && total.QuadPart)
+                {
+                    it->have_space = TRUE;
+                    it->total = total.QuadPart;
+                    it->free = avail.QuadPart;
+                }
+            }
+            IEnumIDList_Release(ids);
+        }
+        IShellFolder_Release(pc);
+    }
+    IShellFolder_Release(desktop);
+}
+
+static void thispc_layout(void)
+{
+    RECT client;
+    int i, x, y, col_w, tile_h, section = -1, left = S(20), cols, n = 0;
+
+    GetClientRect(fe.page, &client);
+    y = S(12) - fe.pc_scroll;
+    for (i = 0; i < fe.npc; i++)
+    {
+        struct pc_item *it = &fe.pc[i];
+        if (it->section != section)
+        {
+            section = it->section;
+            if (i) y += S(16);
+            SetRect(section ? &fe.rc_head_drives : &fe.rc_head_folders, left, y, client.right - S(16), y + S(28));
+            y += S(34);
+            n = 0;
+        }
+        col_w = it->drive ? S(270) : S(230);
+        tile_h = it->drive ? S(70) : S(60);
+        cols = max(1, (client.right - left - S(8)) / col_w);
+        x = left + (n % cols) * col_w;
+        if (n && !(n % cols)) y += tile_h + S(4);
+        SetRect(&it->rc, x, y, x + col_w - S(8), y + tile_h);
+        n++;
+        if (i == fe.npc - 1 || fe.pc[i + 1].section != section) y += tile_h + S(4);
+    }
+    fe.pc_height = y + fe.pc_scroll + S(12);
+    {
+        SCROLLINFO si = { sizeof(si), SIF_RANGE | SIF_PAGE | SIF_POS, 0, fe.pc_height, client.bottom, fe.pc_scroll };
+        SetScrollInfo(fe.page, SB_VERT, &si, TRUE);
+    }
+}
