+static void add_cmd(int id, int glyph, const WCHAR *label, const WCHAR *tip, BOOL dropdown, BOOL sep)
+{
+    struct cmd_item *c = &fe.cmds[fe.ncmds++];
+    c->id = id; c->glyph = glyph; c->label = label; c->tip = tip;
+    c->dropdown = dropdown; c->sep_before = sep; c->enabled = TRUE;
+}
+
+static void cmdbar_layout(void)
+{
+    HDC dc = GetDC(fe.cmdbar);
+    HFONT old = SelectObject(dc, fe.font);
+    RECT client;
+    int i, x = S(8), h = S(32), y;
+    TTTOOLINFOW ti = { sizeof(ti) };
+
+    GetClientRect(fe.cmdbar, &client);
+    y = (client.bottom - h) / 2;
+    for (i = 0; i < fe.ncmds; i++)
+    {
+        struct cmd_item *c = &fe.cmds[i];
+        int w = S(36);
+
+        if (c->sep_before) x += S(13);
+        if (c->label)
+        {
+            SIZE sz;
+            GetTextExtentPoint32W(dc, c->label, lstrlenW(c->label), &sz);
+            w = S(10) + S(16) + S(8) + sz.cx + (c->dropdown ? S(18) : S(10));
+        }
+        SetRect(&c->rc, x, y, x + w, y + h);
+        x += w + S(2);
+
+        if (fe.tooltip)
+        {
+            ti.uFlags = TTF_SUBCLASS;
+            ti.hwnd = fe.cmdbar;
+            ti.uId = c->id;
+            ti.rect = c->rc;
+            ti.lpszText = (WCHAR *)(c->tip ? c->tip : c->label);
+            SendMessageW(fe.tooltip, TTM_DELTOOLW, 0, (LPARAM)&ti);
+            SendMessageW(fe.tooltip, TTM_ADDTOOLW, 0, (LPARAM)&ti);
+        }
+    }
+    SelectObject(dc, old);
+    ReleaseDC(fe.cmdbar, dc);
+}
+
+static void cmdbar_paint(HWND hwnd)
+{
+    struct paint p;
+    HDC dc = begin_paint(hwnd, &p);
+    RECT line = p.rc;
+    int i;
+
+    for (i = 0; i < fe.ncmds; i++)
+    {
+        struct cmd_item *c = &fe.cmds[i];
+        RECT rc = c->rc, t;
+        COLORREF fg = c->enabled ? C_TEXT : C_DISABLED;
+        int gy = rc.top + (rc.bottom - rc.top - S(16)) / 2;
+
+        if (c->sep_before)
+        {
+            RECT sep = { rc.left - S(7), rc.top + S(6), rc.left - S(6), rc.bottom - S(6) };
+            fill(dc, &sep, C_BORDER);
+        }
+        if (c->enabled && i == fe.cmd_pressed) fill(dc, &rc, C_PRESSED);
+        else if (c->enabled && i == fe.cmd_hot) fill(dc, &rc, C_HOT);
+
+        if (!c->label)
+        {
+            draw_glyph(dc, c->glyph, rc.left + (rc.right - rc.left - S(16)) / 2, gy, S(16), fg);
+            continue;
+        }
+        draw_glyph(dc, c->glyph, rc.left + S(10), gy, S(16), fg);
+        t = rc;
+        t.left += S(10) + S(16) + S(8);
+        text(dc, c->label, &t, fg, DT_SINGLELINE | DT_VCENTER | DT_LEFT);
+        if (c->dropdown)
+            draw_glyph(dc, G_CHEVRON_DOWN, rc.right - S(16), rc.top + (rc.bottom - rc.top - S(10)) / 2, S(10), fg);
+    }
+    line.top = line.bottom - 1;
+    fill(dc, &line, C_LINE);
+    end_paint(hwnd, &p);
+}
+
+static int cmd_at(int x, int y)
+{
+    POINT pt = { x, y };
+    int i;
+    for (i = 0; i < fe.ncmds; i++)
+        if (PtInRect(&fe.cmds[i].rc, pt)) return i;
+    return -1;
+}
