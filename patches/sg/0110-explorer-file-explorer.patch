+static void format_items(WCHAR *buf, UINT len, int n)
+{
+    swprintf(buf, len, n == 1 ? L"%d item" : L"%d items", n);
+}
+
+static void update_status(void)
+{
+    WCHAR size[64];
+    int total = 0, sel = 0;
+
+    fe.status_left[0] = fe.status_sel[0] = 0;
+    if (fe.content == CONTENT_FOLDER)
+    {
+        HWND list = get_view_list();
+        if (list)
+        {
+            total = SendMessageW(list, LVM_GETITEMCOUNT, 0, 0);
+            sel = SendMessageW(list, LVM_GETSELECTEDCOUNT, 0, 0);
+        }
+        format_items(fe.status_left, ARRAY_SIZE(fe.status_left), total);
+        if (sel)
+        {
+            IShellView *sv = get_view();
+            IDataObject *data = NULL;
+            ULONGLONG bytes = 0;
+            BOOL only_files = TRUE;
+
+            swprintf(fe.status_sel, ARRAY_SIZE(fe.status_sel), sel == 1 ? L"%d item selected" : L"%d items selected", sel);
+            if (sv && sel <= 5000 && SUCCEEDED(IShellView_GetItemObject(sv, SVGIO_SELECTION, &IID_IDataObject, (void **)&data)))
+            {
+                FORMATETC fmt = { CF_HDROP, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+                STGMEDIUM med;
+                if (SUCCEEDED(IDataObject_GetData(data, &fmt, &med)))
+                {
+                    HDROP drop = GlobalLock(med.hGlobal);
+                    UINT i, n = DragQueryFileW(drop, ~0u, NULL, 0);
+                    WCHAR path[MAX_PATH];
+                    WIN32_FILE_ATTRIBUTE_DATA fad;
+                    for (i = 0; i < n && only_files; i++)
+                    {
+                        DragQueryFileW(drop, i, path, MAX_PATH);
+                        if (!GetFileAttributesExW(path, GetFileExInfoStandard, &fad) ||
+                            (fad.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) only_files = FALSE;
+                        else bytes += ((ULONGLONG)fad.nFileSizeHigh << 32) | fad.nFileSizeLow;
+                    }
+                    GlobalUnlock(med.hGlobal);
+                    ReleaseStgMedium(&med);
+                    if (only_files && n)
+                    {
+                        StrFormatByteSizeW(bytes, size, ARRAY_SIZE(size));
+                        lstrcatW(fe.status_sel, L"  ");
+                        lstrcatW(fe.status_sel, size);
+                    }
+                }
+                IDataObject_Release(data);
+            }
+            if (sv) IShellView_Release(sv);
+        }
+    }
+    else if (fe.content == CONTENT_THISPC)
+    {
+        format_items(fe.status_left, ARRAY_SIZE(fe.status_left), fe.npc);
+        if (fe.pc_sel >= 0) lstrcpyW(fe.status_sel, L"1 item selected");
+    }
+    else
+    {
+        total = fe.nresults;
+        sel = SendMessageW(fe.results, LVM_GETSELECTEDCOUNT, 0, 0);
+        format_items(fe.status_left, ARRAY_SIZE(fe.status_left), total);
+        if (fe.searching) lstrcatW(fe.status_left, L"   Searching...");
+        if (sel) swprintf(fe.status_sel, ARRAY_SIZE(fe.status_sel), sel == 1 ? L"%d item selected" : L"%d items selected", sel);
+    }
+    InvalidateRect(fe.status, NULL, FALSE);
+    update_commands();
+}
