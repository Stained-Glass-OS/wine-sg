From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase, wine.inf: NV Hostname and NV Domain, SearchList, the TCP/IPv6 and DNS client keys (9252)

SetComputerNameEx writes NV Hostname and NV Domain beside Hostname and Domain, as Windows keeps them in Tcpip\Parameters. wine.inf makes Tcpip\Parameters SearchList (empty), Tcpip\Parameters\Interfaces, Tcpip6\Parameters\Interfaces and Dnscache\Parameters, which every Windows has and programs open to read or watch (Chromium's DNS configuration watcher).

Gate: test-tcpipreg.
---
--- a/dlls/kernelbase/registry.c
+++ b/dlls/kernelbase/registry.c
@@ -4834,6 +4834,9 @@
         if (ret) break;
         ret = RegSetValueExW( key, L"Hostname", 0, REG_SZ,
                               (BYTE *)name, (lstrlenW(name) + 1) * sizeof(WCHAR) );
+        /* Stained Glass OS: and the name for the next start, which Windows keeps beside it */
+        if (!ret) ret = RegSetValueExW( key, L"NV Hostname", 0, REG_SZ,
+                                        (BYTE *)name, (lstrlenW(name) + 1) * sizeof(WCHAR) );
         RegCloseKey( key );
         /* fall through */
 
@@ -4870,6 +4873,8 @@
         if (ret) break;
         ret = RegSetValueExW( key, L"Domain", 0, REG_SZ,
                               (BYTE *)name, (lstrlenW(name) + 1) * sizeof(WCHAR) );
+        if (!ret) ret = RegSetValueExW( key, L"NV Domain", 0, REG_SZ,
+                                        (BYTE *)name, (lstrlenW(name) + 1) * sizeof(WCHAR) );
         RegCloseKey( key );
         break;
     default:
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -2885,6 +2885,10 @@
 HKLM,"System\CurrentControlSet\Services\Eventlog\Application",,16
 HKLM,"System\CurrentControlSet\Services\Eventlog\System","Sources",0x10000,""
 HKLM,"System\CurrentControlSet\Services\Tcpip\Parameters","DataBasePath",,"%12%\etc"
+HKLM,"System\CurrentControlSet\Services\Tcpip\Parameters","SearchList",2,""
+HKLM,"System\CurrentControlSet\Services\Tcpip\Parameters\Interfaces",,16
+HKLM,"System\CurrentControlSet\Services\Tcpip6\Parameters\Interfaces",,16
+HKLM,"System\CurrentControlSet\Services\Dnscache\Parameters",,16
 HKLM,"System\CurrentControlSet\Services\VxD\MSTCP",,16
 HKLM,"System\CurrentControlSet\Services\Winsock\Parameters",,16
 HKLM,"System\CurrentControlSet\Services\Winsock2\Parameters\Protocol_Catalog9\Catalog_Entries",,16
