+/* a pinned folder's place among the pins, or -1 */
+static int pin_index(HTREEITEM item)
+{
+    HTREEITEM child;
+    int i = 0;
+
+    for (child = (HTREEITEM)SendMessageW(fe.tree, TVM_GETNEXTITEM, TVGN_CHILD, (LPARAM)tree_quick); child;
+         child = (HTREEITEM)SendMessageW(fe.tree, TVM_GETNEXTITEM, TVGN_NEXT, (LPARAM)child))
+    {
+        struct tree_node *node = node_of(child);
+        if (!node || !node->pinned) break;
+        if (child == item) return i;
+        i++;
+    }
+    return -1;
+}
+
+/* the dragged pin goes before (or after) the target pin */
+static void move_pin(const WCHAR *path, HTREEITEM target, BOOL after)
+{
+    WCHAR *pins = qa_pins(), *p, **order = NULL, *out;
+    int n = 0, from = -1, to = pin_index(target), i;
+    size_t len = 0;
+
+    for (p = pins; p && *p; p += lstrlenW(p) + 1) n++;
+    if (!n || !(order = calloc(n, sizeof(*order)))) goto done;
+    for (p = pins, i = 0; *p; p += lstrlenW(p) + 1, i++)
+    {
+        order[i] = p;
+        if (!wcsicmp(p, path)) from = i;
+    }
+    if (from < 0 || to < 0 || to >= n) goto done;
+    if (after) to++;
+    if (to > from) to--;
+    if (to == from) goto done;
+    p = order[from];
+    if (from < to) memmove(order + from, order + from + 1, (to - from) * sizeof(*order));
+    else memmove(order + to + 1, order + to, (from - to) * sizeof(*order));
+    order[to] = p;
+    for (i = 0; i < n; i++) len += lstrlenW(order[i]) + 1;
+    if (!(out = calloc(len + 1, sizeof(WCHAR)))) goto done;
+    for (i = 0, len = 0; i < n; i++)
+    {
+        lstrcpyW(out + len, order[i]);
+        len += lstrlenW(order[i]) + 1;
+    }
+    RegSetKeyValueW(HKEY_CURRENT_USER, QA_KEY, L"Pinned", REG_MULTI_SZ, out, (len + 1) * sizeof(WCHAR));
+    free(out);
+    for (i = 0; i < n; i++) TRACE("quick access pin order %d: %s\n", i, debugstr_w(order[i]));
+done:
+    free(order);
+    free(pins);
+    fill_quick_tree();
+}
