+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "mfapi.h"
+#include "mfidl.h"
+#include "mfreadwrite.h"
+#include "initguid.h"
+#include "wincodec.h"
+
+#include "explorer_private.h"
+
+/* a picture's size and bits per pixel, from WIC's decoder for it */
+BOOL image_properties(const WCHAR *path, UINT *width, UINT *height, UINT *bpp)
+{
+    IWICImagingFactory *factory;
+    IWICBitmapDecoder *decoder = NULL;
+    IWICBitmapFrameDecode *frame = NULL;
+    IWICComponentInfo *info = NULL;
+    IWICPixelFormatInfo *format_info = NULL;
+    WICPixelFormatGUID format;
+    BOOL ok = FALSE;
+
+    *width = *height = *bpp = 0;
+    if (FAILED(CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IWICImagingFactory, (void **)&factory)))
+        return FALSE;
+    if (SUCCEEDED(IWICImagingFactory_CreateDecoderFromFilename(factory, path, NULL, GENERIC_READ,
+                                                               WICDecodeMetadataCacheOnDemand, &decoder)) &&
+        SUCCEEDED(IWICBitmapDecoder_GetFrame(decoder, 0, &frame)) &&
+        SUCCEEDED(IWICBitmapFrameDecode_GetSize(frame, width, height)))
+    {
+        ok = TRUE;
+        if (SUCCEEDED(IWICBitmapFrameDecode_GetPixelFormat(frame, &format)) &&
+            SUCCEEDED(IWICImagingFactory_CreateComponentInfo(factory, &format, &info)) &&
+            SUCCEEDED(IWICComponentInfo_QueryInterface(info, &IID_IWICPixelFormatInfo, (void **)&format_info)))
+            IWICPixelFormatInfo_GetBitsPerPixel(format_info, bpp);
+    }
+    if (format_info) IWICPixelFormatInfo_Release(format_info);
+    if (info) IWICComponentInfo_Release(info);
+    if (frame) IWICBitmapFrameDecode_Release(frame);
+    if (decoder) IWICBitmapDecoder_Release(decoder);
+    IWICImagingFactory_Release(factory);
+    return ok;
+}
+
+/* a video's frame size and length (100 ns units) */
+BOOL video_properties(const WCHAR *path, UINT *width, UINT *height, ULONGLONG *duration)
+{
+    IMFSourceReader *reader = NULL;
+    IMFMediaType *type = NULL;
+    PROPVARIANT value;
+    UINT64 size = 0;
+    BOOL ok = FALSE;
+
+    *width = *height = 0;
+    *duration = 0;
+    if (FAILED(MFStartup(MF_VERSION, MFSTARTUP_LITE))) return FALSE;
+    PropVariantInit(&value);
+    if (SUCCEEDED(MFCreateSourceReaderFromURL(path, NULL, &reader)))
+    {
+        if (SUCCEEDED(IMFSourceReader_GetNativeMediaType(reader, MF_SOURCE_READER_FIRST_VIDEO_STREAM, 0, &type)) &&
+            SUCCEEDED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_SIZE, &size)))
+        {
+            *width = size >> 32;
+            *height = (UINT32)size;
+            ok = TRUE;
+        }
+        if (SUCCEEDED(IMFSourceReader_GetPresentationAttribute(reader, MF_SOURCE_READER_MEDIASOURCE, &MF_PD_DURATION, &value)) &&
+            value.vt == VT_UI8)
+        {
+            *duration = value.uhVal.QuadPart;
+            ok = TRUE;
+        }
+        PropVariantClear(&value);
+        if (type) IMFMediaType_Release(type);
+        IMFSourceReader_Release(reader);
+    }
+    MFShutdown();
+    return ok;
