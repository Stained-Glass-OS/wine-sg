+/* folders taken out of Quick access with "Remove from Quick access": they
+ * are not counted again and never come back as frequent, as on Windows */
+static BOOL qa_excluded(const WCHAR *path)
+{
+    WCHAR *list, *p;
+    DWORD size = 0;
+    BOOL found = FALSE;
+
+    if (RegGetValueW(HKEY_CURRENT_USER, QA_KEY, L"Excluded", RRF_RT_REG_MULTI_SZ, NULL, NULL, &size) ||
+        !(list = calloc(size / sizeof(WCHAR) + 2, sizeof(WCHAR)))) return FALSE;
+    if (!RegGetValueW(HKEY_CURRENT_USER, QA_KEY, L"Excluded", RRF_RT_REG_MULTI_SZ, NULL, list, &size))
+        for (p = list; *p && !found; p += lstrlenW(p) + 1) found = !wcsicmp(p, path);
+    free(list);
+    return found;
+}
+
+static void qa_remove_frequent(const WCHAR *path)
+{
+    WCHAR *list = NULL, *grown;
+    DWORD size = 0, len = 0;
+
+    RegDeleteKeyValueW(HKEY_CURRENT_USER, QA_KEY L"\\Frequent", path);
+    if (qa_excluded(path)) return;
+    if (!RegGetValueW(HKEY_CURRENT_USER, QA_KEY, L"Excluded", RRF_RT_REG_MULTI_SZ, NULL, NULL, &size) &&
+        (list = calloc(size / sizeof(WCHAR) + 2, sizeof(WCHAR))) &&
+        !RegGetValueW(HKEY_CURRENT_USER, QA_KEY, L"Excluded", RRF_RT_REG_MULTI_SZ, NULL, list, &size))
+        for (len = 0; list[len]; len += lstrlenW(list + len) + 1);
+    if (!(grown = realloc(list, (len + lstrlenW(path) + 2) * sizeof(WCHAR)))) { free(list); return; }
+    list = grown;
+    lstrcpyW(list + len, path);
+    len += lstrlenW(path) + 1;
+    list[len++] = 0;
+    RegSetKeyValueW(HKEY_CURRENT_USER, QA_KEY, L"Excluded", REG_MULTI_SZ, list, len * sizeof(WCHAR));
+    free(list);
+    TRACE("quick access removed: %s\n", debugstr_w(path));
+}
