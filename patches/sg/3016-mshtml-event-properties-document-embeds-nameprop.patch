 static HRESULT WINAPI HTMLDocument4_get_URLUnencoded(IHTMLDocument4 *iface, BSTR *p)
 {
     HTMLDocumentNode *This = impl_from_IHTMLDocument4(iface);
-    FIXME("(%p)->(%p)\n", This, p);
-    return E_NOTIMPL;
+    BSTR url = NULL;
+    HRESULT hres;
+    DWORD len;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    if(!p)
+        return E_INVALIDARG;
+
+    hres = IHTMLDocument2_get_URL(&This->IHTMLDocument2_iface, &url);
+    if(FAILED(hres))
+        return hres;
+    if(!url) {
+        *p = NULL;
+        return S_OK;
+    }
+
+    len = SysStringLen(url);
+    *p = SysAllocStringLen(NULL, len);
+    if(!*p) {
+        SysFreeString(url);
+        return E_OUTOFMEMORY;
+    }
+    wcscpy(*p, url);
+    SysFreeString(url);
+
+    len++;
+    hres = UrlUnescapeW(*p, NULL, &len, URL_UNESCAPE_INPLACE);
+    return FAILED(hres) ? hres : S_OK;
 }
 
