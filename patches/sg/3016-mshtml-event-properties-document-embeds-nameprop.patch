@@ -7379,6 +7379,101 @@ static void test_adjacent_text_and_attributes(IHTMLDocument2 *doc)
     IHTMLElement_Release(parent);
 }
 
+static void test_doc_embeds_nameprop(IHTMLDocument2 *doc)
+{
+    IHTMLElementCollection *col;
+    IHTMLDocument4 *doc4;
+    BSTR str, url;
+    LONG length;
+    HRESULT hres;
+
+    col = NULL;
+    hres = IHTMLDocument2_get_embeds(doc, &col);
+    ok(hres == S_OK && col, "get_embeds returned %08lx, %p\n", hres, col);
+    if(col) {
+        length = -1;
+        hres = IHTMLElementCollection_get_length(col, &length);
+        ok(hres == S_OK && length == 0, "embeds length = %08lx, %ld\n", hres, length);
+        IHTMLElementCollection_Release(col);
+    }
+
+    col = NULL;
+    hres = IHTMLDocument2_get_plugins(doc, &col);
+    ok(hres == S_OK && col, "get_plugins returned %08lx, %p\n", hres, col);
+    if(col) {
+        length = -1;
+        hres = IHTMLElementCollection_get_length(col, &length);
+        ok(hres == S_OK && length == 0, "plugins length = %08lx, %ld\n", hres, length);
+        IHTMLElementCollection_Release(col);
+    }
+
+    hres = IHTMLDocument2_get_title(doc, &str);
+    ok(hres == S_OK, "get_title failed: %08lx\n", hres);
+    SysFreeString(str);
+
+    hres = IHTMLDocument2_get_nameProp(doc, &str);
+    ok(hres == S_OK && str, "get_nameProp returned %08lx, %s\n", hres, wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    hres = IHTMLDocument2_QueryInterface(doc, &IID_IHTMLDocument4, (void**)&doc4);
+    if(hres == S_OK) {
+        hres = IHTMLDocument2_get_URL(doc, &url);
+        ok(hres == S_OK, "get_URL failed: %08lx\n", hres);
+        str = NULL;
+        hres = IHTMLDocument4_get_URLUnencoded(doc4, &str);
+        ok(hres == S_OK, "get_URLUnencoded failed: %08lx\n", hres);
+        ok(!url == !str, "URL %s, URLUnencoded %s\n", wine_dbgstr_w(url), wine_dbgstr_w(str));
+        SysFreeString(str);
+        SysFreeString(url);
+        IHTMLDocument4_Release(doc4);
+    }
+}
+
+static void test_unsupported_event_props(IHTMLDocument2 *doc)
+{
+    IHTMLElement2 *elem2;
+    IHTMLElement *elem;
+    IDispatch *handler;
+    VARIANT v;
+    HRESULT hres;
+
+    elem = test_create_elem(doc, L"div");
+    elem2 = get_elem2_iface((IUnknown*)elem);
+    handler = (IDispatch*)elem;
+
+    /* events that Gecko never fires for us still keep their handlers */
+    V_VT(&v) = VT_DISPATCH;
+    V_DISPATCH(&v) = handler;
+    hres = IHTMLElement2_put_oncut(elem2, v);
+    ok(hres == S_OK, "put_oncut failed: %08lx\n", hres);
+    V_VT(&v) = VT_EMPTY;
+    hres = IHTMLElement2_get_oncut(elem2, &v);
+    ok(hres == S_OK, "get_oncut failed: %08lx\n", hres);
+    ok(V_VT(&v) == VT_DISPATCH && V_DISPATCH(&v), "oncut = %d\n", V_VT(&v));
+    VariantClear(&v);
+
+    V_VT(&v) = VT_DISPATCH;
+    V_DISPATCH(&v) = handler;
+    hres = IHTMLElement_put_onbeforeupdate(elem, v);
+    ok(hres == S_OK, "put_onbeforeupdate failed: %08lx\n", hres);
+    V_VT(&v) = VT_EMPTY;
+    hres = IHTMLElement_get_onbeforeupdate(elem, &v);
+    ok(hres == S_OK, "get_onbeforeupdate failed: %08lx\n", hres);
+    ok(V_VT(&v) == VT_DISPATCH && V_DISPATCH(&v), "onbeforeupdate = %d\n", V_VT(&v));
+    VariantClear(&v);
+
+    V_VT(&v) = VT_NULL;
+    hres = IHTMLElement_put_onbeforeupdate(elem, v);
+    ok(hres == S_OK, "put_onbeforeupdate failed: %08lx\n", hres);
+    V_VT(&v) = VT_EMPTY;
+    hres = IHTMLElement_get_onbeforeupdate(elem, &v);
+    ok(hres == S_OK, "get_onbeforeupdate failed: %08lx\n", hres);
+    ok(V_VT(&v) == VT_NULL, "onbeforeupdate = %d\n", V_VT(&v));
+
+    IHTMLElement2_Release(elem2);
+    IHTMLElement_Release(elem);
+}
+
