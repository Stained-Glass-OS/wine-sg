From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxdeploymentclient: a package's files beyond MAX_PATH

---
--- a/dlls/appxdeploymentclient/deploy.c
+++ b/dlls/appxdeploymentclient/deploy.c
@@ -570,21 +570,66 @@
     return TRUE;
 }
 
+/* Stained Glass OS: paths beyond MAX_PATH. A package's deepest files are near it in Program Files
+ * (ChatGPT's node_modules: 253 characters), and past it in a person's own
+ * AppData\Local\Programs\WindowsApps: the Store's install of ChatGPT stopped with "the package's
+ * files could not be installed" (qa4, 2026-11-08). The payload goes through "\\?\" paths. */
+#define LONG_PATH 32768
+
+/* the payload path for the file functions: "\\?\" before a drive path; NULL for a bad name */
+static WCHAR *long_payload_path( const WCHAR *root, const WCHAR *name )
+{
+    WCHAR *path = malloc( LONG_PATH * sizeof(WCHAR) );
+    size_t off = 0;
+
+    if (!path) return NULL;
+#ifndef SG_MUTANT_AX_SHORT_PATHS
+    if (root[0] && root[1] == ':' && root[2] == '\\')
+    {
+        wcscpy( path, L"\\\\?\\" );
+        off = 4;
+    }
+    if (!payload_path( root, name, path + off, LONG_PATH - off ))
+#else
+    if (!payload_path( root, name, path, MAX_PATH ))
+#endif
+    {
+        free( path );
+        return NULL;
+    }
+    return path;
+}
+
+/* each missing folder of the file's path, one by one (SHCreateDirectoryEx stops at MAX_PATH) */
 static HRESULT create_parent_dirs( WCHAR *path )
 {
-    WCHAR *p = wcsrchr( path, '\\' );
-    int res;
+    WCHAR *p = wcsrchr( path, '\\' ), *q;
+    HRESULT hr = S_OK;
 
     if (!p) return S_OK;
     *p = 0;
-    res = SHCreateDirectoryExW( NULL, path, NULL );
+    if (!CreateDirectoryW( path, NULL ) && GetLastError() != ERROR_ALREADY_EXISTS)
+    {
+        q = path;
+        if (!wcsncmp( q, L"\\\\?\\", 4 )) q += 4;
+        if (q[0] && q[1] == ':') q += 2;
+        if (*q == '\\') q++;
+        for (; (q = wcschr( q, '\\' )); q++)
+        {
+            *q = 0;
+            CreateDirectoryW( path, NULL );
+            *q = '\\';
+        }
+        if (!CreateDirectoryW( path, NULL ) && GetLastError() != ERROR_ALREADY_EXISTS)
+            hr = HRESULT_FROM_WIN32( GetLastError() );
+    }
     *p = '\\';
-    return (res == ERROR_SUCCESS || res == ERROR_ALREADY_EXISTS || res == ERROR_FILE_EXISTS) ? S_OK : HRESULT_FROM_WIN32( res );
+    return hr;
 }
 
