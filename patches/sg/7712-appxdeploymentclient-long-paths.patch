@@ -1953,20 +2007,55 @@
 
 /* ---- removal ------------------------------------------------------------------------------ */
 
+/* a folder and everything in it, also beyond MAX_PATH (a package's files) */
+static void delete_tree_long( WCHAR *path, size_t len )
+{
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+
+    if (len + 3 >= LONG_PATH) return;
+    wcscpy( path + len, L"\\*" );
+    if ((find = FindFirstFileW( path, &fd )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            size_t n = wcslen( fd.cFileName );
+
+            if (!wcscmp( fd.cFileName, L"." ) || !wcscmp( fd.cFileName, L".." )) continue;
+            if (len + 1 + n >= LONG_PATH) continue;
+            path[len] = '\\';
+            wcscpy( path + len + 1, fd.cFileName );
+            if ((fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) && !(fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT))
+                delete_tree_long( path, len + 1 + n );
+            else
+            {
+                if (fd.dwFileAttributes & FILE_ATTRIBUTE_READONLY) SetFileAttributesW( path, FILE_ATTRIBUTE_NORMAL );
+                DeleteFileW( path );
+            }
+        } while (FindNextFileW( find, &fd ));
+        FindClose( find );
+    }
+    path[len] = 0;
+    RemoveDirectoryW( path );
+}
+
 static void delete_tree( const WCHAR *dir )
 {
-    WCHAR *from;
-    size_t len = wcslen( dir );
-    SHFILEOPSTRUCTW op = { 0 };
-
-    /* double NUL-terminated */
