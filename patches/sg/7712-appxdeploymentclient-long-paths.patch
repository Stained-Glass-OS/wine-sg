-    memcpy( from, dir, len * sizeof(WCHAR) );
-    op.wFunc = FO_DELETE;
-    op.pFrom = from;
-    op.fFlags = FOF_NO_UI;
-    SHFileOperationW( &op );
-    free( from );
+    WCHAR *path;
+    size_t off = 0;
+
+    if (!dir || !dir[0] || !(path = malloc( LONG_PATH * sizeof(WCHAR) ))) return;
+    if (dir[0] && dir[1] == ':' && dir[2] == '\\')
+    {
+        wcscpy( path, L"\\\\?\\" );
+        off = 4;
+    }
+    if (off + wcslen( dir ) < LONG_PATH)
+    {
+        wcscpy( path + off, dir );
+        delete_tree_long( path, wcslen( path ) );
+    }
+    free( path );
 }
 
