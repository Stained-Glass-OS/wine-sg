From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 07:44:13 -0700
Subject: [PATCH] rasapi32: RasEnumEntries without a phonebook, RasEnumDevicesA

RasEnumEntriesA/W with no stored entries check their arguments (NULL size/count: ERROR_INVALID_PARAMETER,
dwSize below the oldest structure: ERROR_INVALID_SIZE) and report zero entries; RasEnumDevicesA behaves as
the Unicode variant (size query, zero-size buffer, ERROR_INVALID_SIZE).

diff --git a/dlls/rasapi32/rasapi.c b/dlls/rasapi32/rasapi.c
index e7453ea..928f407 100644
--- a/dlls/rasapi32/rasapi.c
+++ b/dlls/rasapi32/rasapi.c
@@ -475,9 +475,13 @@ DWORD WINAPI RasEnumEntriesA( LPCSTR Reserved, LPCSTR lpszPhoneBook,
 {
 	DWORD ret = sg_enum_entries( lpRasEntryName, lpcb, lpcEntries, FALSE );
 	if (ret != ~0u) return ret;
-	FIXME("(%p,%s,%p,%p,%p),stub!\n",Reserved,debugstr_a(lpszPhoneBook),
+	TRACE("(%p,%s,%p,%p,%p): no entries\n",Reserved,debugstr_a(lpszPhoneBook),
             lpRasEntryName,lpcb,lpcEntries);
-        *lpcEntries = 0;
+	if (!lpcb || !lpcEntries) return ERROR_INVALID_PARAMETER;
+	/* dwSize identifies the structure version; a size below the oldest one is refused (documented) */
+	if (lpRasEntryName && lpRasEntryName->dwSize < sizeof(*lpRasEntryName))
+		return ERROR_INVALID_SIZE;
+	*lpcEntries = 0;
 	return 0;
 }
 
@@ -490,9 +494,13 @@ DWORD WINAPI RasEnumEntriesW( LPCWSTR Reserved, LPCWSTR lpszPhoneBook,
 {
 	DWORD ret = sg_enum_entries( lpRasEntryName, lpcb, lpcEntries, TRUE );
 	if (ret != ~0u) return ret;
-	FIXME("(%p,%s,%p,%p,%p),stub!\n",Reserved,debugstr_w(lpszPhoneBook),
+	TRACE("(%p,%s,%p,%p,%p): no entries\n",Reserved,debugstr_w(lpszPhoneBook),
             lpRasEntryName,lpcb,lpcEntries);
-        *lpcEntries = 0;
+	if (!lpcb || !lpcEntries) return ERROR_INVALID_PARAMETER;
+	/* dwSize identifies the structure version; a size below the oldest one is refused (documented) */
+	if (lpRasEntryName && lpRasEntryName->dwSize < sizeof(*lpRasEntryName))
+		return ERROR_INVALID_SIZE;
+	*lpcEntries = 0;
 	return 0;
 }
 
@@ -652,33 +660,30 @@ DWORD WINAPI RasEnumAutodialAddressesW(LPWSTR *a, LPDWORD b, LPDWORD c)
  * Just return a virtual modem to see what other APIs programs will
  * call with it.
  */
-DWORD WINAPI RasEnumDevicesA(LPRASDEVINFOA lpRasDevinfo, LPDWORD lpcb, LPDWORD lpcDevices)
+DWORD WINAPI RasEnumDevicesA(LPRASDEVINFOA info, LPDWORD size, LPDWORD count)
 {
-	if (!lpcb || !lpcDevices)
-            return ERROR_INVALID_PARAMETER;
+    if (!size || !count) return ERROR_INVALID_PARAMETER;
+    TRACE("(%p,%p,%p)\n",info,size,count);
 
-	FIXME("(%p,%p,%p),stub!\n",lpRasDevinfo,lpcb,lpcDevices);
+    if (info && info->dwSize != sizeof(RASDEVINFOA)) return ERROR_INVALID_SIZE;
 
-	if(lpRasDevinfo && lpRasDevinfo->dwSize != sizeof(RASDEVINFOA))
-		return ERROR_INVALID_SIZE;
+    if (info && !*size)
+    {
+        /* a zero sized buffer is refused before the devices are counted */
+        *size = sizeof(RASDEVINFOA);
+        return ERROR_BUFFER_TOO_SMALL;
+    }
 
-	if (lpRasDevinfo && !*lpcb)
-	{
-		/* a zero sized buffer is refused before the devices are counted */
-		*lpcb = sizeof(RASDEVINFOA);
-		return ERROR_BUFFER_TOO_SMALL;
-	}
-
-	*lpcDevices = 1;
-
-	if (!lpRasDevinfo || (*lpcb < sizeof(RASDEVINFOA))) {
-		*lpcb = sizeof(RASDEVINFOA);
-		return ERROR_BUFFER_TOO_SMALL;
-	}
-	/* honor dwSize ? */
-	strcpy(lpRasDevinfo->szDeviceType, RASDT_Modem);
-	strcpy(lpRasDevinfo->szDeviceName, "WINE virtmodem");
-	return 0;
+    *count = 1;
+    if (!info || *size < sizeof(RASDEVINFOA))
+    {
+        *size = sizeof(RASDEVINFOA);
+        return ERROR_BUFFER_TOO_SMALL;
+    }
+    strcpy(info->szDeviceType, RASDT_Modem);
+    strcpy(info->szDeviceName, "WINE virtmodem");
+    *size = sizeof(RASDEVINFOA);
+    return 0;
 }
 
 DWORD WINAPI RasEnumDevicesW(LPRASDEVINFOW info, LPDWORD size, LPDWORD count)
