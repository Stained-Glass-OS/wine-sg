From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3drm: Clone of materials, lights, faces and mesh builders

Clone makes an independent copy of the object (all of its state, references
to the textures and materials it uses taken again; for a mesh builder the
vertices, normals, faces, texture coordinates, per-material data and the
faces made with CreateFace, which keep their place in front of or behind the
loaded ones) and returns the interface asked for. A non-NULL outer object is
CLASS_E_NOAGGREGATION, no output D3DRMERR_BADVALUE. These were E_NOTIMPL.
---
--- a/dlls/d3drm/face.c
+++ b/dlls/d3drm/face.c
@@ -197,12 +197,47 @@ static ULONG WINAPI d3drm_face1_Release(IDirect3DRMFace *iface)
     return refcount;
 }
 
+
+static HRESULT face_clone(struct d3drm_face *face, IUnknown *outer, REFIID iid, void **out)
+{
+    struct d3drm_face *clone;
+    HRESULT hr;
+
+    if (!out)
+        return D3DRMERR_BADVALUE;
+    *out = NULL;
+    if (outer)
+        return CLASS_E_NOAGGREGATION;
+    if (FAILED(hr = d3drm_face_create(&clone)))
+        return hr;
+    if (face->nb_vertices)
+    {
+        if (!(clone->vertices = malloc(face->nb_vertices * sizeof(*clone->vertices))))
+        {
+            IDirect3DRMFace_Release(&clone->IDirect3DRMFace_iface);
+            return E_OUTOFMEMORY;
+        }
+        memcpy(clone->vertices, face->vertices, face->nb_vertices * sizeof(*clone->vertices));
+        clone->nb_vertices = clone->vertices_size = face->nb_vertices;
+    }
+    clone->color = face->color;
+    clone->wrap_u = face->wrap_u;
+    clone->wrap_v = face->wrap_v;
+    if ((clone->texture = face->texture))
+        IDirect3DRMTexture3_AddRef(clone->texture);
+    if ((clone->material = face->material))
+        IDirect3DRMMaterial2_AddRef(clone->material);
+    hr = IDirect3DRMFace_QueryInterface(&clone->IDirect3DRMFace_iface, iid, out);
+    IDirect3DRMFace_Release(&clone->IDirect3DRMFace_iface);
+    return hr;
+}
+
 static HRESULT WINAPI d3drm_face1_Clone(IDirect3DRMFace *iface,
         IUnknown *outer, REFIID iid, void **out)
 {
-    FIXME("iface %p, outer %p, iid %s, out %p stub!\n", iface, outer, debugstr_guid(iid), out);
+    TRACE("iface %p, outer %p, iid %s, out %p.\n", iface, outer, debugstr_guid(iid), out);
 
-    return E_NOTIMPL;
+    return face_clone(impl_from_IDirect3DRMFace(iface), outer, iid, out);
 }
 
 static HRESULT WINAPI d3drm_face1_AddDestroyCallback(IDirect3DRMFace *iface,
@@ -614,9 +649,9 @@ static ULONG WINAPI d3drm_face2_Release(IDirect3DRMFace2 *iface)
 static HRESULT WINAPI d3drm_face2_Clone(IDirect3DRMFace2 *iface,
         IUnknown *outer, REFIID iid, void **out)
 {
-    FIXME("iface %p, outer %p, iid %s, out %p stub!\n", iface, outer, debugstr_guid(iid), out);
+    TRACE("iface %p, outer %p, iid %s, out %p.\n", iface, outer, debugstr_guid(iid), out);
 
-    return E_NOTIMPL;
+    return face_clone(impl_from_IDirect3DRMFace2(iface), outer, iid, out);
 }
 
 static HRESULT WINAPI d3drm_face2_AddDestroyCallback(IDirect3DRMFace2 *iface,
