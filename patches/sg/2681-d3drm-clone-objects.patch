--- a/dlls/d3drm/meshbuilder.c
+++ b/dlls/d3drm/meshbuilder.c
@@ -506,12 +506,115 @@ static ULONG WINAPI d3drm_mesh_builder2_Release(IDirect3DRMMeshBuilder2 *iface)
     return refcount;
 }
 
+
+static HRESULT mesh_builder_clone(struct d3drm_mesh_builder *mb, IUnknown *outer, REFIID iid, void **out)
+{
+    struct d3drm_mesh_builder *clone;
+    HRESULT hr;
+    DWORD i;
+
+    if (!out)
+        return D3DRMERR_BADVALUE;
+    *out = NULL;
+    if (outer)
+        return CLASS_E_NOAGGREGATION;
+    if (FAILED(hr = d3drm_mesh_builder_create(&clone, mb->d3drm)))
+        return hr;
+
+#define CLONE_ARRAY(dst, src, count, size) \
+    if ((count) && !((dst) = malloc((count) * sizeof(*(dst))))) { hr = E_OUTOFMEMORY; goto fail; } \
+    else if (count) memcpy((dst), (src), (count) * sizeof(*(dst))), (size) = (count)
+    CLONE_ARRAY(clone->vertices, mb->vertices, mb->nb_vertices, clone->vertices_size);
+    clone->nb_vertices = mb->nb_vertices;
+    CLONE_ARRAY(clone->normals, mb->normals, mb->nb_normals, clone->normals_size);
+    clone->nb_normals = mb->nb_normals;
+#undef CLONE_ARRAY
+    if (mb->face_data_size)
+    {
+        if (!(clone->pFaceData = malloc(mb->face_data_size * sizeof(DWORD))))
+        {
+            hr = E_OUTOFMEMORY;
+            goto fail;
+        }
+        memcpy(clone->pFaceData, mb->pFaceData, mb->face_data_size * sizeof(DWORD));
+    }
+    clone->face_data_size = mb->face_data_size;
+    clone->nb_faces = mb->nb_faces;
+    if (mb->nb_coords2d)
+    {
+        if (!(clone->pCoords2d = malloc(mb->nb_coords2d * sizeof(*clone->pCoords2d))))
+        {
+            hr = E_OUTOFMEMORY;
+            goto fail;
+        }
+        memcpy(clone->pCoords2d, mb->pCoords2d, mb->nb_coords2d * sizeof(*clone->pCoords2d));
+    }
+    clone->nb_coords2d = mb->nb_coords2d;
+    clone->color = mb->color;
+    clone->quality = mb->quality;
+    clone->color_source = mb->color_source;
+    clone->perspective = mb->perspective;
+    clone->wrap_u = mb->wrap_u;
+    clone->wrap_v = mb->wrap_v;
+    if ((clone->material = mb->material))
+        IDirect3DRMMaterial2_AddRef(clone->material);
+    if ((clone->texture = mb->texture))
+        IDirect3DRMTexture3_AddRef(clone->texture);
+    if (mb->nb_materials)
+    {
+        if (!(clone->materials = calloc(mb->nb_materials, sizeof(*clone->materials)))
+                || !(clone->material_indices = calloc(mb->nb_faces + 1, sizeof(*clone->material_indices))))
+        {
+            hr = E_OUTOFMEMORY;
+            goto fail;
+        }
+        memcpy(clone->materials, mb->materials, mb->nb_materials * sizeof(*clone->materials));
+        clone->nb_materials = mb->nb_materials;
+        for (i = 0; i < mb->nb_materials; ++i)
+        {
+            if (clone->materials[i].material)
+                IDirect3DRMMaterial2_AddRef(clone->materials[i].material);
+            if (clone->materials[i].texture)
+                IDirect3DRMTexture3_AddRef(clone->materials[i].texture);
+        }
+        if (mb->material_indices)
+            memcpy(clone->material_indices, mb->material_indices, mb->nb_faces * sizeof(*clone->material_indices));
+    }
+    /* the faces made with CreateFace are copies too */
+    for (i = 0; i < mb->nb_extra_faces; ++i)
+    {
+        struct d3drm_face *face = NULL;
+
+        if (FAILED(hr = IDirect3DRMFace_Clone(&mb->extra_faces[i]->IDirect3DRMFace_iface, NULL,
+                &IID_IDirect3DRMFace, (void **)&face)))
+            goto fail;
+        if (!d3drm_array_reserve((void **)&clone->extra_faces, &clone->extra_faces_size,
+                clone->nb_extra_faces + 1, sizeof(*clone->extra_faces)))
+        {
+            IDirect3DRMFace_Release((IDirect3DRMFace *)face);
+            hr = E_OUTOFMEMORY;
+            goto fail;
+        }
+        /* IDirect3DRMFace is the first interface of the object */
+        clone->extra_faces[clone->nb_extra_faces++] = CONTAINING_RECORD((IDirect3DRMFace *)face,
+                struct d3drm_face, IDirect3DRMFace_iface);
+    }
+#ifndef SG_MUTANT_DRMCLONE_NO_LEADING
+    clone->nb_leading_extra_faces = mb->nb_leading_extra_faces;
+#endif
+
+    hr = IDirect3DRMMeshBuilder2_QueryInterface(&clone->IDirect3DRMMeshBuilder2_iface, iid, out);
+fail:
+    IDirect3DRMMeshBuilder2_Release(&clone->IDirect3DRMMeshBuilder2_iface);
+    return hr;
+}
+
 static HRESULT WINAPI d3drm_mesh_builder2_Clone(IDirect3DRMMeshBuilder2 *iface,
         IUnknown *outer, REFIID iid, void **out)
 {
-    FIXME("iface %p, outer %p, iid %s, out %p stub!\n", iface, outer, debugstr_guid(iid), out);
+    TRACE("iface %p, outer %p, iid %s, out %p.\n", iface, outer, debugstr_guid(iid), out);
 
-    return E_NOTIMPL;
+    return mesh_builder_clone(impl_from_IDirect3DRMMeshBuilder2(iface), outer, iid, out);
 }
 
 static HRESULT WINAPI d3drm_mesh_builder2_AddDestroyCallback(IDirect3DRMMeshBuilder2 *iface,
@@ -1149,9 +1252,9 @@ static ULONG WINAPI d3drm_mesh_builder3_Release(IDirect3DRMMeshBuilder3 *iface)
 static HRESULT WINAPI d3drm_mesh_builder3_Clone(IDirect3DRMMeshBuilder3 *iface,
         IUnknown *outer, REFIID iid, void **out)
 {
-    FIXME("iface %p, outer %p, iid %s, out %p stub!\n", iface, outer, debugstr_guid(iid), out);
+    TRACE("iface %p, outer %p, iid %s, out %p.\n", iface, outer, debugstr_guid(iid), out);
 
-    return E_NOTIMPL;
+    return mesh_builder_clone(impl_from_IDirect3DRMMeshBuilder3(iface), outer, iid, out);
 }
 
