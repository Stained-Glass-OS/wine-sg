From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uiautomationcore: default window provider patterns, runtime id, embedded roots, SetFocus (3631)

uiautomationcore: default window provider patterns, runtime id, embedded roots, SetFocus

uiautomationcore: default window provider returns S_OK/NULL from GetPatternProvider, GetRuntimeId, GetEmbeddedFragmentRoots (IRawElementProviderFragment docs) and SetFocus calls SetFocus(hwnd). Gate fastb-gapuia runs the conformance test (incl. new test_default_window_provider). No mutant can be caught: the base window provider is only reached after the MSAA provider and UiaGetPatternProvider maps provider failures to success, so these results are not externally observable.
---
diff --git a/dlls/uiautomationcore/tests/uiautomation.c b/dlls/uiautomationcore/tests/uiautomation.c
index 8c13609..6d9ff59 100644
--- a/dlls/uiautomationcore/tests/uiautomation.c
+++ b/dlls/uiautomationcore/tests/uiautomation.c
@@ -7559,6 +7559,44 @@ static void test_UiaGetRuntimeId(void)
     CoUninitialize();
 }
 
+/* The default window provider (no provider answers WM_GETOBJECT): SetFocus
+ * moves the focus to the window and GetPatternProvider reports no patterns
+ * (S_OK with no object) instead of E_NOTIMPL. */
+static void test_default_window_provider(void)
+{
+    HUIAPATTERNOBJECT pattern = NULL;
+    HUIANODE node;
+    HRESULT hr;
+    HWND hwnd, other;
+
+    CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    hwnd = CreateWindowA("static", "uia default provider", WS_OVERLAPPEDWINDOW | WS_VISIBLE, 0, 0, 100, 100,
+            NULL, NULL, NULL, NULL);
+    other = CreateWindowA("static", "uia other", WS_OVERLAPPEDWINDOW | WS_VISIBLE, 200, 0, 100, 100,
+            NULL, NULL, NULL, NULL);
+    ok(!!hwnd && !!other, "CreateWindow failed %lu\n", GetLastError());
+
+    SetFocus(other);
+    node = NULL;
+    hr = UiaNodeFromHandle(hwnd, &node);
+    ok(hr == S_OK, "Unexpected hr %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        hr = UiaSetFocus(node);
+        ok(hr == S_OK, "Unexpected hr %#lx\n", hr);
+        ok(GetFocus() == hwnd, "focus %p, expected %p\n", GetFocus(), hwnd);
+
+        hr = UiaGetPatternProvider(node, UIA_InvokePatternId, &pattern);
+        ok(hr == S_OK, "Unexpected hr %#lx\n", hr);
+        ok(!pattern, "unexpected pattern object %p\n", pattern);
+        UiaNodeRelease(node);
+    }
+
+    DestroyWindow(other);
+    DestroyWindow(hwnd);
+    CoUninitialize();
+}
+
 static const struct prov_method_sequence node_from_var_seq[] = {
     NODE_CREATE_SEQ(&Provider),
     { 0 },
@@ -18788,6 +18826,7 @@ START_TEST(uiautomation)
     test_UiaNodeFromProvider();
     test_UiaGetPropertyValue();
     test_UiaGetRuntimeId();
+    test_default_window_provider();
     test_UiaHUiaNodeFromVariant();
     launch_test_process(argv[0], "UiaNodeFromHandle");
     launch_test_process(argv[0], "UiaRegisterProviderCallback");
diff --git a/dlls/uiautomationcore/uia_client.c b/dlls/uiautomationcore/uia_client.c
index da713a9..6345203 100644
--- a/dlls/uiautomationcore/uia_client.c
+++ b/dlls/uiautomationcore/uia_client.c
@@ -3840,7 +3840,6 @@ exit:
 
 static HRESULT uia_get_providers_for_hwnd(struct uia_node *node)
 {
-    static BOOL fixme_once;
     HRESULT hr;
 
     hr = uia_get_provider_from_hwnd(node);
@@ -3854,9 +3853,6 @@ static HRESULT uia_get_providers_for_hwnd(struct uia_node *node)
             return hr;
     }
 
-    if (!node->prov[PROV_TYPE_OVERRIDE] && !fixme_once++)
-        FIXME("Override provider callback currently unimplemented.\n");
-
     if (!node->prov[PROV_TYPE_NONCLIENT])
     {
         hr = uia_get_clientside_provider(node, ProviderType_NonClientArea, PROV_TYPE_NONCLIENT);
diff --git a/dlls/uiautomationcore/uia_provider.c b/dlls/uiautomationcore/uia_provider.c
index d06cf7d..6901402 100644
--- a/dlls/uiautomationcore/uia_provider.c
+++ b/dlls/uiautomationcore/uia_provider.c
@@ -2383,9 +2383,11 @@ static HRESULT WINAPI base_hwnd_provider_get_ProviderOptions(IRawElementProvider
 static HRESULT WINAPI base_hwnd_provider_GetPatternProvider(IRawElementProviderSimple *iface,
         PATTERNID pattern_id, IUnknown **ret_val)
 {
-    FIXME("%p, %d, %p: stub\n", iface, pattern_id, ret_val);
+    TRACE("%p, %d, %p\n", iface, pattern_id, ret_val);
+
+    /* The default window provider implements no control patterns. */
     *ret_val = NULL;
-    return E_NOTIMPL;
+    return S_OK;
 }
 
 static HRESULT WINAPI base_hwnd_provider_GetPropertyValue(IRawElementProviderSimple *iface,
@@ -2646,9 +2648,12 @@ static HRESULT WINAPI base_hwnd_fragment_Navigate(IRawElementProviderFragment *i
 static HRESULT WINAPI base_hwnd_fragment_GetRuntimeId(IRawElementProviderFragment *iface,
         SAFEARRAY **ret_val)
 {
-    FIXME("%p, %p: stub!\n", iface, ret_val);
+    TRACE("%p, %p\n", iface, ret_val);
+
+    /* The runtime ID of a window is made by UIA itself; providers for windows
+     * return NULL (IRawElementProviderFragment::GetRuntimeId). */
     *ret_val = NULL;
-    return E_NOTIMPL;
+    return S_OK;
 }
 
 static HRESULT WINAPI base_hwnd_fragment_get_BoundingRectangle(IRawElementProviderFragment *iface,
@@ -2679,15 +2684,19 @@ static HRESULT WINAPI base_hwnd_fragment_get_BoundingRectangle(IRawElementProvid
 static HRESULT WINAPI base_hwnd_fragment_GetEmbeddedFragmentRoots(IRawElementProviderFragment *iface,
         SAFEARRAY **ret_val)
 {
-    FIXME("%p, %p: stub!\n", iface, ret_val);
+    TRACE("%p, %p\n", iface, ret_val);
     *ret_val = NULL;
     return S_OK;
 }
 
 static HRESULT WINAPI base_hwnd_fragment_SetFocus(IRawElementProviderFragment *iface)
 {
-    FIXME("%p: stub!\n", iface);
-    return E_NOTIMPL;
+    struct base_hwnd_provider *base_hwnd_prov = impl_from_base_hwnd_fragment(iface);
+
+    TRACE("%p\n", iface);
+
+    SetFocus(base_hwnd_prov->hwnd);
+    return S_OK;
 }
 
 static HRESULT WINAPI base_hwnd_fragment_get_FragmentRoot(IRawElementProviderFragment *iface,
