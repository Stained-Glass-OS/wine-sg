From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] webservices: WS_CHAR_ARRAY_TYPE, WS_UTF8_ARRAY_TYPE and WS_BYTE_ARRAY_TYPE fields

A struct field of one of these types is two fields serialized as one value: the pointer at the field's offset and its count at countOffset. They are written and read as a WS_STRING, WS_XML_STRING or WS_BYTES (text, text, base64), with the WS_CHAR_ARRAY_DESCRIPTION / WS_UTF8_ARRAY_DESCRIPTION / WS_BYTE_ARRAY_DESCRIPTION limits (same layout as those types' descriptions). They were "type not supported" (E_NOTIMPL). The three descriptions are added to webservices.h.
---
--- a/include/webservices.h
+++ b/include/webservices.h
@@ -453,6 +453,21 @@
     ULONG maxByteCount;
 } WS_XML_STRING_DESCRIPTION;
 
+typedef struct _WS_CHAR_ARRAY_DESCRIPTION {
+    ULONG minCharCount;
+    ULONG maxCharCount;
+} WS_CHAR_ARRAY_DESCRIPTION;
+
+typedef struct _WS_UTF8_ARRAY_DESCRIPTION {
+    ULONG minByteCount;
+    ULONG maxByteCount;
+} WS_UTF8_ARRAY_DESCRIPTION;
+
+typedef struct _WS_BYTE_ARRAY_DESCRIPTION {
+    ULONG minByteCount;
+    ULONG maxByteCount;
+} WS_BYTE_ARRAY_DESCRIPTION;
+
 typedef struct _WS_XML_QNAME_DESCRIPTION {
     ULONG minLocalNameByteCount;
     ULONG maxLocalNameByteCount;
--- a/dlls/webservices/reader.c
+++ b/dlls/webservices/reader.c
@@ -7316,9 +7316,75 @@
     return hr;
 }
 
+/* Stained Glass OS (wine-sg 8229): WS_CHAR_ARRAY_TYPE, WS_UTF8_ARRAY_TYPE and WS_BYTE_ARRAY_TYPE fields are two
+ * struct fields serialized as one value -- the pointer at offset, the count at countOffset -- the way a WS_STRING,
+ * WS_XML_STRING or WS_BYTES is (their descriptions have the same min/max layout). */
+static WS_TYPE array_field_value_type( WS_TYPE type )
+{
+#ifndef SG_MUTANT_WS_NO_ARRAY_FIELDS
+    switch (type)
+    {
+    case WS_CHAR_ARRAY_TYPE: return WS_STRING_TYPE;
+    case WS_UTF8_ARRAY_TYPE: return WS_XML_STRING_TYPE;
+    case WS_BYTE_ARRAY_TYPE: return WS_BYTES_TYPE;
+    default: break;
+    }
+#endif
+    return 0;
+}
+
+union array_field_value
+{
+    WS_STRING string;
+    WS_XML_STRING xml_string;
+    WS_BYTES bytes;
+};
+
+static HRESULT read_type_field_value( struct reader *, const WS_STRUCT_DESCRIPTION *, const WS_FIELD_DESCRIPTION *,
+                                      WS_HEAP *, char *, ULONG );
+
 static HRESULT read_type_field( struct reader *reader, const WS_STRUCT_DESCRIPTION *desc_struct,
                                 const WS_FIELD_DESCRIPTION *desc, WS_HEAP *heap, char *buf, ULONG offset )
 {
+    union array_field_value value;
+    WS_FIELD_DESCRIPTION field;
+    ULONG count;
+    void *ptr;
+    HRESULT hr;
+
+    if (!desc || !(field.type = array_field_value_type( desc->type )))
+        return read_type_field_value( reader, desc_struct, desc, heap, buf, offset );
+    if (desc->options & ~(WS_FIELD_OPTIONAL|WS_FIELD_NILLABLE|WS_FIELD_OTHER_NAMESPACE)) return E_INVALIDARG;
+    if (desc->mapping == WS_REPEATING_ELEMENT_FIELD_MAPPING || desc->mapping == WS_REPEATING_ELEMENT_CHOICE_FIELD_MAPPING ||
+        desc->mapping == WS_ELEMENT_CHOICE_FIELD_MAPPING) return E_INVALIDARG;
+
+    memset( &value, 0, sizeof(value) );
+    field.mapping         = desc->mapping;
+    field.localName       = desc->localName;
+    field.ns              = desc->ns;
+    field.typeDescription = desc->typeDescription;
+    field.offset          = 0;
+    field.options         = desc->options;
+    field.defaultValue    = NULL;
+    field.countOffset     = 0;
+    field.itemLocalName   = NULL;
+    field.itemNs          = NULL;
+    field.itemRange       = NULL;
+    if ((hr = read_type_field_value( reader, desc_struct, &field, heap, (char *)&value, 0 )) != S_OK) return hr;
+    switch (field.type)
+    {
+    case WS_STRING_TYPE: count = value.string.length; ptr = value.string.chars; break;
+    case WS_XML_STRING_TYPE: count = value.xml_string.length; ptr = value.xml_string.bytes; break;
+    default: count = value.bytes.length; ptr = value.bytes.bytes; break;
+    }
+    *(ULONG *)(buf + desc->countOffset) = count;
+    *(void **)(buf + offset) = ptr;
+    return S_OK;
+}
+
+static HRESULT read_type_field_value( struct reader *reader, const WS_STRUCT_DESCRIPTION *desc_struct,
+                                      const WS_FIELD_DESCRIPTION *desc, WS_HEAP *heap, char *buf, ULONG offset )
+{
     char *ptr;
     WS_READ_OPTION option;
     ULONG size;
