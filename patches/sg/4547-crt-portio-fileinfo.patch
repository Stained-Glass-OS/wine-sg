diff --git a/dlls/msvcrt/misc.c b/dlls/msvcrt/misc.c
index fb4cdb8..d39b650 100644
--- a/dlls/msvcrt/misc.c
+++ b/dlls/msvcrt/misc.c
@@ -919,3 +919,73 @@ ULONG_PTR CDECL _GetThrowImageBase(void)
     return msvcrt_get_thread_data()->throw_image_base;
 }
 #endif
+
+#if defined(__i386__) && _MSVCR_VER < 140
+/*********************************************************************
+ * _inp (MSVCRT.@)
+ *
+ * Reads a byte from an I/O port. User mode code is not allowed to,
+ * so this raises a privileged instruction exception, as on Windows.
+ */
+int CDECL _inp(unsigned short port)
+{
+    unsigned char value;
+
+    __asm__ __volatile__( "inb %w1,%b0" : "=a" (value) : "d" (port) );
+    return value;
+}
+
+/*********************************************************************
+ * _inpw (MSVCRT.@)
+ */
+unsigned short CDECL _inpw(unsigned short port)
+{
+    unsigned short value;
+
+#ifdef SG_MUTANT_INPW_BYTE
+    return _inp(port);
+#endif
+    __asm__ __volatile__( "inw %w1,%w0" : "=a" (value) : "d" (port) );
+    return value;
+}
+
+/*********************************************************************
+ * _inpd (MSVCRT.@)
+ */
+__msvcrt_ulong CDECL _inpd(unsigned short port)
+{
+    unsigned int value;
+
+    __asm__ __volatile__( "inl %w1,%0" : "=a" (value) : "d" (port) );
+    return value;
+}
+
+/*********************************************************************
+ * _outp (MSVCRT.@)
+ *
+ * Writes a byte to an I/O port; see _inp.
+ */
+int CDECL _outp(unsigned short port, int data)
+{
+    __asm__ __volatile__( "outb %b0,%w1" : : "a" (data), "d" (port) );
+    return data;
+}
+
+/*********************************************************************
+ * _outpw (MSVCRT.@)
+ */
+unsigned short CDECL _outpw(unsigned short port, unsigned short data)
+{
+    __asm__ __volatile__( "outw %w0,%w1" : : "a" (data), "d" (port) );
+    return data;
+}
+
+/*********************************************************************
+ * _outpd (MSVCRT.@)
+ */
+__msvcrt_ulong CDECL _outpd(unsigned short port, __msvcrt_ulong data)
+{
+    __asm__ __volatile__( "outl %0,%w1" : : "a" ((unsigned int)data), "d" (port) );
+    return data;
+}
+#endif
