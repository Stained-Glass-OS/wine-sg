From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the desktop's icons take the keyboard after Win+D: type to select, Enter opens

After Win+D the keyboard went to the taskbar and typing a letter and Enter did
nothing (i0639). As Windows' desktop list view, the desktop's keyboard window
now has it: the letters typed within a second select the icon whose name
starts with them, the same letter again the next such icon, Enter opens it.
---
 programs/explorer/desktop.c | 69 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 69 insertions(+)

--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -2429,6 +2429,52 @@ static void sg_key_nav( HWND hwnd, WPARAM key )
     InvalidateRect( hwnd, NULL, TRUE );
 }
 
+/* Stained Glass OS 9932: type to select, as Windows' desktop (a list view) does: the letters typed
+ * within a second name the icon; the same letter again goes on to the next icon starting with it */
+static void sg_type_ahead( HWND hwnd, WCHAR ch )
+{
+    static WCHAR typed[64];
+    static unsigned int ntyped;
+    static DWORD last;
+    DWORD now = GetTickCount();
+    BOOL same = TRUE;
+    int *order, n = nb_launchers, cur = -1, start, k, found = -1, i, j;
+
+    if (ch < ' ' || !nb_launchers) return;
+    if (now - last > 1000) ntyped = 0;
+    last = now;
+    if (ntyped < ARRAY_SIZE(typed) - 1) typed[ntyped++] = ch;
+    typed[ntyped] = 0;
+    for (k = 1; k < (int)ntyped; k++) if (towlower( typed[k] ) != towlower( typed[0] )) same = FALSE;
+
+    /* the icons in the desktop's order: down each column, the columns left to right */
+    if (!(order = malloc( n * sizeof(*order) ))) return;
+    for (i = 0; i < n; i++) order[i] = i;
+    for (i = 1; i < n; i++)
+        for (j = i; j > 0; j--)
+        {
+            const struct launcher *a = launchers[order[j - 1]], *b = launchers[order[j]];
+            if (a->col * 100000 + a->row <= b->col * 100000 + b->row) break;
+            k = order[j]; order[j] = order[j - 1]; order[j - 1] = k;
+        }
+    for (i = 0; i < n; i++) if (order[i] == sg_selected) cur = i;
+
+    /* one letter (or the same one again): from the icon after the focused one; more: from it */
+    start = cur < 0 ? 0 : (same ? cur + 1 : cur);
+    for (k = 0; k < n && found < 0; k++)
+    {
+        const struct launcher *l = launchers[order[(start + k) % n]];
+        if (l->title && !wcsnicmp( l->title, typed, same ? 1 : ntyped )) found = order[(start + k) % n];
+    }
+    free( order );
+    if (found < 0) return;
+    sg_focus_cues = TRUE;
+    sg_select_only( found );
+    sg_anchor = found;
+    sg_tip_hide();
+    InvalidateRect( hwnd, NULL, TRUE );
+}
+
 /* --- dragging icons ---------------------------------------------------------------- */
 
 static BOOL sg_dragging;             /* the desktop's own icons are being dragged */
@@ -2933,7 +2979,19 @@ static LRESULT CALLBACK sg_keys_proc( HWND hwnd, UINT message, WPARAM wp, LPARAM
             else sg_desktop_menu( sg_desktop_hwnd, pt );
             return 0;
         }
+        /* Stained Glass OS 9932: a letter selects the icon whose name starts with it (the desktop's
+         * thread does not translate its keys: the character is made here) */
+        if (GetKeyState( VK_CONTROL ) >= 0 && GetKeyState( VK_MENU ) >= 0)
+        {
+            BYTE state[256];
+            WCHAR ch[4];
+            if (GetKeyboardState( state ) && ToUnicode( wp, (lp >> 16) & 0xff, state, ch, ARRAY_SIZE(ch), 4 ) == 1 &&
+                ch[0] > ' ')
+                return SendMessageW( sg_desktop_hwnd, WM_CHAR, ch[0], lp );
+        }
         break;
+    case WM_CHAR:
+        return SendMessageW( sg_desktop_hwnd, message, wp, lp );
     case WM_CONTEXTMENU:
         return 0;
     case WM_SYSCOMMAND:
@@ -2943,6 +3001,12 @@ static LRESULT CALLBACK sg_keys_proc( HWND hwnd, UINT message, WPARAM wp, LPARAM
     return DefWindowProcW( hwnd, message, wp, lp );
 }
 
+/* Stained Glass OS 9932: the desktop's keyboard window, for Win+D (shellkeys.c) */
+HWND desktop_keys_window(void)
+{
+    return sg_keys_hwnd;
+}
+
 static void sg_create_keys_window(void)
 {
     WNDCLASSW wc = { 0 };
@@ -3443,6 +3507,11 @@ static LRESULT WINAPI desktop_wnd_proc( HWND hwnd, UINT message, WPARAM wp, LPAR
         }
         break;
 
+    case WM_CHAR:
+        if (using_root) break;
+        sg_type_ahead( hwnd, wp );
+        return 0;
+
     case WM_PARENTNOTIFY:
         handle_parent_notify( (HWND)lp, wp );
         return 0;
