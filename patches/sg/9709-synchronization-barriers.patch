From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: synchronization barriers

GnuCash imports InitializeSynchronizationBarrier and EnterSynchronizationBarrier statically and did
not load. A phase ends when its last thread arrives, whose Enter returns TRUE; the others spin (the
spin count, unless BLOCK_ONLY) and then sleep on the phase (WaitOnAddress), or only spin (SPIN_ONLY);
DeleteSynchronizationBarrier waits until no thread is inside. Gate: test/syncbarrier-gate.sh.
Mutant: SG_MUTANT_BARRIER_NOWAIT.
---
--- a/dlls/kernelbase/sync.c
+++ b/dlls/kernelbase/sync.c
@@ -1981,6 +1981,96 @@
 
 
 /***********************************************************************
+ * Synchronization barriers
+ *
+ * Stained Glass OS (wine-sg 9709): the barriers of Windows 8 and later (GnuCash imports them). A phase
+ * ends when its last thread arrives; that thread's EnterSynchronizationBarrier returns TRUE, the others
+ * FALSE. Threads spin first (the barrier's spin count, unless BLOCK_ONLY), then sleep on the phase number
+ * (WaitOnAddress), or spin only (SPIN_ONLY). DeleteSynchronizationBarrier waits until no thread is still
+ * inside. The opaque structure: Reserved1 the threads still to come in this phase, Reserved2 the total,
+ * Reserved3[0] the phase, Reserved3[1] the threads inside, Reserved4 the spin count.
+ */
+#define BARRIER_LEFT(b)   ((LONG *)&(b)->Reserved1)
+#define BARRIER_PHASE(b)  ((ULONG_PTR *)&(b)->Reserved3[0])
+#define BARRIER_INSIDE(b) ((LONG_PTR *)&(b)->Reserved3[1])
+
+/***********************************************************************
+ *           InitializeSynchronizationBarrier    (kernelbase.@)
+ */
+BOOL WINAPI InitializeSynchronizationBarrier( SYNCHRONIZATION_BARRIER *barrier, LONG threads, LONG spin )
+{
+    TRACE( "%p %ld %ld\n", barrier, threads, spin );
+
+    if (!barrier || threads < 1 || spin < -1)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    memset( barrier, 0, sizeof(*barrier) );
+    barrier->Reserved1 = threads;
+    barrier->Reserved2 = threads;
+    barrier->Reserved4 = spin == -1 ? 2000 : spin;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           EnterSynchronizationBarrier    (kernelbase.@)
+ */
+BOOL WINAPI EnterSynchronizationBarrier( SYNCHRONIZATION_BARRIER *barrier, DWORD flags )
+{
+    ULONG_PTR phase;
+    BOOL last = FALSE;
+    DWORD i;
+
+    TRACE( "%p %#lx\n", barrier, flags );
+
+    if (!(flags & SYNCHRONIZATION_BARRIER_FLAGS_NO_DELETE)) InterlockedIncrementSizeT( (SIZE_T *)BARRIER_INSIDE(barrier) );
+    phase = *(volatile ULONG_PTR *)BARRIER_PHASE(barrier);
+#ifndef SG_MUTANT_BARRIER_NOWAIT
+    if (!InterlockedDecrement( BARRIER_LEFT(barrier) ))
+#endif
+    {
+        /* the last one: the next phase starts, everyone waiting goes on */
+        *BARRIER_LEFT(barrier) = barrier->Reserved2;
+        InterlockedIncrementSizeT( (SIZE_T *)BARRIER_PHASE(barrier) );
+        RtlWakeAddressAll( BARRIER_PHASE(barrier) );
+        last = TRUE;
+    }
+#ifndef SG_MUTANT_BARRIER_NOWAIT
+    else
+    {
+        if (!(flags & SYNCHRONIZATION_BARRIER_FLAGS_BLOCK_ONLY))
+            for (i = 0; i < barrier->Reserved4 && *(volatile ULONG_PTR *)BARRIER_PHASE(barrier) == phase; i++)
+                YieldProcessor();
+        while (*(volatile ULONG_PTR *)BARRIER_PHASE(barrier) == phase)
+        {
+            if (flags & SYNCHRONIZATION_BARRIER_FLAGS_SPIN_ONLY) YieldProcessor();
+            else RtlWaitOnAddress( BARRIER_PHASE(barrier), &phase, sizeof(phase), NULL );
+        }
+    }
+#endif
+    if (!(flags & SYNCHRONIZATION_BARRIER_FLAGS_NO_DELETE) &&
+        !InterlockedDecrementSizeT( (SIZE_T *)BARRIER_INSIDE(barrier) ))
+        RtlWakeAddressAll( BARRIER_INSIDE(barrier) );
+    return last;
+}
+
+/***********************************************************************
+ *           DeleteSynchronizationBarrier    (kernelbase.@)
+ */
+BOOL WINAPI DeleteSynchronizationBarrier( SYNCHRONIZATION_BARRIER *barrier )
+{
+    LONG_PTR inside;
+
+    TRACE( "%p\n", barrier );
+
+    while ((inside = *(volatile LONG_PTR *)BARRIER_INSIDE(barrier)))
+        RtlWaitOnAddress( BARRIER_INSIDE(barrier), &inside, sizeof(inside), NULL );
+    return TRUE;
+}
+
+
+/***********************************************************************
  *           InitOnceExecuteOnce    (kernelbase.@)
  */
 BOOL WINAPI DECLSPEC_HOTPATCH InitOnceExecuteOnce( INIT_ONCE *once, PINIT_ONCE_FN func,
