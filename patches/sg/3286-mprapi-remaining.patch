-DWORD WINAPI MprConfigServerInstall(ULONG_PTR a1, ULONG_PTR a2)
+/* IP-in-IP interface friendly names: the name that goes with the GUID of a tunnel interface. Kept in the router
+ * parameters (GUESS: the key is ours). */
+typedef struct { WCHAR wszFriendlyName[257]; GUID Guid; } IPINIP_INTERFACE_0;
+
+#define IPINIP_KEY L"System\\CurrentControlSet\\Services\\RemoteAccess\\Parameters\\IpInIpInterfaces"
+
+static void guid_to_key( const GUID *guid, WCHAR *buf )
+{
+    swprintf( buf, 40, L"{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}", guid->Data1, guid->Data2, guid->Data3,
+              guid->Data4[0], guid->Data4[1], guid->Data4[2], guid->Data4[3], guid->Data4[4], guid->Data4[5],
+              guid->Data4[6], guid->Data4[7] );
+}
+
+DWORD WINAPI MprSetupIpInIpInterfaceFriendlyNameCreate( HANDLE config, IPINIP_INTERFACE_0 *info )
 {
-    FIXME( "MprConfigServerInstall: not supported\n" );
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    WCHAR name[40];
+    HKEY key;
+    DWORD ret;
+
+    TRACE( "(%p, %p)\n", config, info );
+
+    if (!valid_config( config )) return ERROR_INVALID_HANDLE;
+    if (!info || !info->wszFriendlyName[0]) return ERROR_INVALID_PARAMETER;
+    if ((ret = RegCreateKeyExW( HKEY_LOCAL_MACHINE, IPINIP_KEY, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL ))) return ret;
+    /* a friendly name names one interface */
+    {
+        DWORD idx, size;
+        WCHAR existing[258];
+
+        for (idx = 0; ; idx++)
+        {
+            DWORD nsize = 40;
+            size = sizeof(existing);
+            if (RegEnumValueW( key, idx, name, &nsize, NULL, NULL, (BYTE *)existing, &size )) break;
+#ifdef SG_MUTANT_MPR_IPDUP
+            if (0)
+#else
+            if (!wcsicmp( existing, info->wszFriendlyName ))
+#endif
+            {
+                RegCloseKey( key );
+                return ERROR_ALREADY_EXISTS;
+            }
+        }
+    }
+    guid_to_key( &info->Guid, name );
+    ret = RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)info->wszFriendlyName,
+                          (lstrlenW( info->wszFriendlyName ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    return ret;
+}
+
+DWORD WINAPI MprSetupIpInIpInterfaceFriendlyNameDelete( HANDLE config, GUID *guid )
+{
+    WCHAR name[40];
+    HKEY key;
+    DWORD ret;
+
+    TRACE( "(%p, %s)\n", config, debugstr_guid( guid ) );
+
+    if (!valid_config( config )) return ERROR_INVALID_HANDLE;
+    if (!guid) return ERROR_INVALID_PARAMETER;
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, IPINIP_KEY, 0, KEY_ALL_ACCESS, &key )) return ERROR_NO_SUCH_INTERFACE;
+    guid_to_key( guid, name );
+    ret = RegDeleteValueW( key, name );
+    RegCloseKey( key );
+    return ret ? ERROR_NO_SUCH_INTERFACE : ERROR_SUCCESS;
+}
+
+DWORD WINAPI MprSetupIpInIpInterfaceFriendlyNameEnum( HANDLE config, LPBYTE *buffer, LPDWORD count )
+{
+    IPINIP_INTERFACE_0 *list = NULL;
+    HKEY key;
+    DWORD i, n = 0, total = 0;
+
+    TRACE( "(%p, %p, %p)\n", config, buffer, count );
+
+    if (!valid_config( config )) return ERROR_INVALID_HANDLE;
+    if (!buffer || !count) return ERROR_INVALID_PARAMETER;
+    *buffer = NULL;
+    *count = 0;
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, IPINIP_KEY, 0, KEY_READ, &key )) return ERROR_SUCCESS;
+    RegQueryInfoKeyW( key, NULL, NULL, NULL, NULL, NULL, NULL, &total, NULL, NULL, NULL, NULL );
+    if (total && !(list = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, total * sizeof(*list) )))
+    {
+        RegCloseKey( key );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    for (i = 0; i < total; i++)
+    {
+        WCHAR name[40];
+        DWORD nsize = ARRAY_SIZE(name), size = sizeof(list[n].wszFriendlyName) - sizeof(WCHAR);
+        UNICODE_STRING us;
+        GUID guid;
+
+        if (RegEnumValueW( key, i, name, &nsize, NULL, NULL, (BYTE *)list[n].wszFriendlyName, &size )) break;
+        RtlInitUnicodeString( &us, name );
+        if (RtlGUIDFromString( &us, &guid )) continue;
+        list[n++].Guid = guid;
+    }
+    RegCloseKey( key );
+#ifdef SG_MUTANT_MPR_IPENUM
+    n = 0;
+#endif
+    if (!n) { HeapFree( GetProcessHeap(), 0, list ); list = NULL; }
+    *buffer = (LPBYTE)list;
+    *count = n;
+    return ERROR_SUCCESS;
+}
+
+DWORD WINAPI MprConfigServerInstall( DWORD level, PVOID buffer )
+{
+    TRACE( "(%lu, %p)\n", level, buffer );
+
+    if (!buffer) return ERROR_INVALID_PARAMETER;
+    if (level != 1) return ERROR_INVALID_LEVEL;
+    /* the router is not part of this system, there is nothing to install it from */
+    return ERROR_NOT_SUPPORTED;
 }
 
