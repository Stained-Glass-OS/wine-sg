+DWORD WINAPI MprAdminEstablishDomainRasServer( LPWSTR domain, LPWSTR machine, BOOL enable )
 {
-    FIXME( "MprAdminEstablishDomainRasServer: not supported\n" );
-    return ERROR_CALL_NOT_IMPLEMENTED;
