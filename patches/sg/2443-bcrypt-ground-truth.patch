     ret = BCryptEncrypt(key, data2, 32, &auth_info, ivbuf, 16, ciphertext, 32, &size, BCRYPT_BLOCK_PADDING);
-    todo_wine ok(ret == STATUS_BUFFER_TOO_SMALL, "got %#lx\n", ret);
+    ok(ret == STATUS_BUFFER_TOO_SMALL, "got %#lx\n", ret);
 
