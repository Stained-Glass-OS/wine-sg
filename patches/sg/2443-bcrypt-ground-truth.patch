From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: AES key length, GCM padding size, CFB size query, used-up hashes, private DSA export, DH test marks

Ground truth from Wine's bcrypt tests (13 todo_wine marks removed, 7 of them DH/ECDH marks that gnutls 3.8 now satisfies): setting BCRYPT_KEY_LENGTH on an AES provider is STATUS_NOT_SUPPORTED; a GCM encryption with BCRYPT_BLOCK_PADDING sizes the output as padded (STATUS_BUFFER_TOO_SMALL when it does not fit) and is otherwise STATUS_INVALID_PARAMETER; asking for the size of a CFB encryption of a partial block succeeds; BCryptDeriveKeyCapi uses the hash up (later calls on it are STATUS_INVALID_HANDLE, destroying it still works); exporting a private DSA blob from a public-only key is STATUS_INVALID_PARAMETER.
---
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -511,6 +511,7 @@ static NTSTATUS hash_finish( struct hash_impl *hash, enum alg_id alg_id, UCHAR *
 
 #define HASH_FLAG_HMAC      0x01
 #define HASH_FLAG_REUSABLE  0x02
+#define HASH_FLAG_DERIVED   0x04   /* BCryptDeriveKeyCapi used it up: only destroying it is left */
 struct hash
 {
     struct object     hdr;
@@ -782,6 +783,9 @@ static NTSTATUS set_alg_property( struct algorithm *alg, const WCHAR *prop, UCHA
                 return STATUS_NOT_IMPLEMENTED;
             }
         }
+#ifndef SG_MUTANT_BCRYPT_AES_KEYLEN
+        if (!wcscmp( prop, BCRYPT_KEY_LENGTH )) return STATUS_NOT_SUPPORTED;   /* a property one can only read */
+#endif
         FIXME( "unsupported aes algorithm property %s\n", debugstr_w(prop) );
         return STATUS_NOT_IMPLEMENTED;
 
@@ -1042,7 +1046,7 @@ NTSTATUS WINAPI BCryptDuplicateHash( BCRYPT_HASH_HANDLE handle, BCRYPT_HASH_HAND
 
     TRACE( "%p, %p, %p, %lu, %#lx\n", handle, handle_copy, object, objectlen, flags );
 
-    if (!hash_orig) return STATUS_INVALID_HANDLE;
+    if (!hash_orig || (hash_orig->flags & HASH_FLAG_DERIVED)) return STATUS_INVALID_HANDLE;
     if (!handle_copy) return STATUS_INVALID_PARAMETER;
     /* the caller's object buffer is not needed: the object is ours */
     if (object) TRACE( "object buffer %p not used\n", object );
@@ -1087,6 +1091,9 @@ NTSTATUS WINAPI BCryptHashData( BCRYPT_HASH_HANDLE handle, UCHAR *input, ULONG s
     TRACE( "%p, %p, %lu, %#lx\n", handle, input, size, flags );
 
     if (!hash) return STATUS_INVALID_HANDLE;
+#ifndef SG_MUTANT_BCRYPT_DERIVED
+    if (hash->flags & HASH_FLAG_DERIVED) return STATUS_INVALID_HANDLE;
+#endif
     if (!input) return STATUS_SUCCESS;
 
     return hash_update( &hash->inner, hash->alg_id, input, size );
@@ -1120,6 +1127,7 @@ NTSTATUS WINAPI BCryptFinishHash( BCRYPT_HASH_HANDLE handle, UCHAR *output, ULON
     TRACE( "%p, %p, %lu, %#lx\n", handle, output, size, flags );
 
     if (!hash) return STATUS_INVALID_HANDLE;
+    if (hash->flags & HASH_FLAG_DERIVED) return STATUS_INVALID_HANDLE;
     if (!output || size != builtin_algorithms[hash->alg_id].hash_length) return STATUS_INVALID_PARAMETER;
 
     return hash_finalize( hash, output );
@@ -1396,7 +1404,14 @@ static NTSTATUS key_symmetric_encrypt( struct key *key,  UCHAR *input, ULONG inp
             return status;
 
         *ret_len = input_len;
-        if (flags & BCRYPT_BLOCK_PADDING) return STATUS_INVALID_PARAMETER;
+        if (flags & BCRYPT_BLOCK_PADDING)
+        {
+            /* the size is worked out as with padding, though a stream mode takes none */
+#ifndef SG_MUTANT_BCRYPT_GCM_PAD
+            if (output && output_len < ((input_len + 16) & ~15u)) return STATUS_BUFFER_TOO_SMALL;
+#endif
+            return STATUS_INVALID_PARAMETER;
+        }
         if (input && !output) return STATUS_SUCCESS;
         if (output_len < *ret_len) return STATUS_BUFFER_TOO_SMALL;
 
@@ -1422,10 +1437,18 @@ static NTSTATUS key_symmetric_encrypt( struct key *key,  UCHAR *input, ULONG inp
 
     if (flags & BCRYPT_BLOCK_PADDING)
         *ret_len = (input_len + key->u.s.block_size) & ~(key->u.s.block_size - 1);
+#ifndef SG_MUTANT_BCRYPT_SIZE_QUERY
+    else if ((output || key->u.s.mode != CHAIN_MODE_CFB) && (input_len & (key->u.s.block_size - 1)))
+        return STATUS_INVALID_BUFFER_SIZE;
+
+    /* asking for the size of a CFB encryption succeeds whatever the input length */
+    if (!output) return STATUS_SUCCESS;
+#else
     else if (input_len & (key->u.s.block_size - 1))
         return STATUS_INVALID_BUFFER_SIZE;
 
     if (!output) return STATUS_SUCCESS;
+#endif
     if (output_len < *ret_len) return STATUS_BUFFER_TOO_SMALL;
     if (key->u.s.mode == CHAIN_MODE_ECB && iv) return STATUS_INVALID_PARAMETER;
     if ((status = key_symmetric_set_vector( key, iv, iv_len, flags & BCRYPT_BLOCK_PADDING ))) return status;
@@ -2325,6 +2348,9 @@ NTSTATUS WINAPI BCryptDeriveKeyCapi( BCRYPT_HASH_HANDLE handle, BCRYPT_ALG_HANDL
     TRACE( "%p, %p, %p, %lu, %#lx\n", handle, halg, key, keylen, flags );
 
     if (!hash) return STATUS_INVALID_HANDLE;
+#ifndef SG_MUTANT_BCRYPT_DERIVED
+    if (hash->flags & HASH_FLAG_DERIVED) return STATUS_INVALID_HANDLE;
+#endif
     if (!key || !keylen) return STATUS_INVALID_PARAMETER;
     if (keylen > builtin_algorithms[hash->alg_id].hash_length * 2) return STATUS_INVALID_PARAMETER;
     if (halg)
@@ -2357,6 +2383,7 @@ NTSTATUS WINAPI BCryptDeriveKeyCapi( BCRYPT_HASH_HANDLE handle, BCRYPT_ALG_HANDL
     }
 
     memcpy( key, buf, keylen );
+    hash->flags |= HASH_FLAG_DERIVED;
     return STATUS_SUCCESS;
 }
 
--- a/dlls/bcrypt/gnutls.c
+++ b/dlls/bcrypt/gnutls.c
@@ -1834,6 +1834,10 @@ static NTSTATUS key_asymmetric_export( void *args )
         }
         if (key->u.a.flags & KEY_FLAG_LEGACY_DSA_V2)
             return key_export_dsa_capi( key, params->buf, params->len, params->ret_len );
+#ifndef SG_MUTANT_BCRYPT_DSA_PRIVATE
+        /* a key with only the public half has no private blob to give */
+        if (!key_data(key)->a.privkey) return STATUS_INVALID_PARAMETER;
+#endif
         return STATUS_NOT_IMPLEMENTED;
 
     case ALG_ID_DH:
--- a/dlls/bcrypt/tests/bcrypt.c
