     struct parser_source *src;
     uint32_t i, stream_count;
     WCHAR source_name[20];
 
     stream_count = wg_parser_get_stream_count(parser);
+#ifndef SG_MUTANT_AVI_NO_STREAM_HEADERS
+    header_count = avi_read_stream_headers(filter->reader, headers, ARRAY_SIZE(headers));
+#endif
     for (i = 0; i < stream_count; ++i)
     {
         swprintf(source_name, ARRAY_SIZE(source_name), L"Stream %02u", i);
@@ -2527,8 +2806,24 @@
         if (!src)
             return FALSE;
         src->interpolate_timestamps = TRUE;
+
+        /* GStreamer's demuxer makes a stream of every strl, in file order */
+        if (header_count == stream_count)
+        {
+            struct wg_format format;
+
+            wg_parser_stream_get_current_format(src->wg_stream, &format);
+            if (format.major_type == WG_MAJOR_TYPE_UNKNOWN
+                    && (src->avi_mt = avi_stream_media_type(&headers[i], &src->avi_buffer_size)))
+            {
+                TRACE("Stream %u goes out as it is in the file, subtype %s.\n", i, debugstr_guid(&src->avi_mt->subtype));
+                avi_demuxer_flip(&headers[i], &src->avi_flip_stride, &src->avi_flip_rows);
+            }
+        }
     }
 
+    for (j = 0; j < header_count; ++j)
+        free(headers[j].format);
     return TRUE;
 }
 
