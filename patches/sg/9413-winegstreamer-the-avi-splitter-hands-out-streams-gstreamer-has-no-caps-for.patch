+/* Stained Glass OS (wine-sg 9413): the streams GStreamer has no caps for (a 16-bit
+ * BI_RGB or BI_BITFIELDS bitmap, a codec only a Video for Windows or ACM driver
+ * decodes) get the media type Windows' AVI splitter gives them, from the file's
+ * own stream headers: the bitmap's subtype (RGB555 for 16-bit BI_RGB, RGB565 or
+ * RGB555 by the BI_BITFIELDS masks) or its FOURCC, a VIDEOINFOHEADER carrying the
+ * stream format header; the wave format tag's subtype and the WAVEFORMATEX for
+ * audio. Their buffers are the file's chunks as they are. */
+struct avi_stream_header
+{
+    DWORD type;             /* strh fccType */
+    DWORD handler;          /* strh fccHandler */
+    DWORD scale, rate, suggested_buffer_size, sample_size;
+    BYTE *format;           /* strf */
+    DWORD format_size;
+};
+
+static DWORD avi_read32(const BYTE *p)
+{
+    return p[0] | (p[1] << 8) | (p[2] << 16) | ((DWORD)p[3] << 24);
+}
+
+/* the strh/strf of each strl in the file's hdrl list, in file order */
+static unsigned int avi_read_stream_headers(IAsyncReader *reader, struct avi_stream_header *headers,
+        unsigned int max_headers)
+{
+    BYTE head[24], *hdrl, *p, *end;
+    unsigned int count = 0;
+    LONGLONG total, avail;
+    DWORD size;
+
+    if (FAILED(IAsyncReader_Length(reader, &total, &avail)) || total < 24)
+        return 0;
+    if (IAsyncReader_SyncRead(reader, 0, sizeof(head), head) != S_OK)
+        return 0;
+    if (memcmp(head, "RIFF", 4) || memcmp(head + 8, "AVI ", 4)
+            || memcmp(head + 12, "LIST", 4) || memcmp(head + 20, "hdrl", 4))
+        return 0;
+    size = avi_read32(head + 16);
+    if (size < 4 || size > 16 * 1024 * 1024 || 20 + (LONGLONG)size > total)
+        return 0;
+    if (!(hdrl = malloc(size)))
+        return 0;
+    if (IAsyncReader_SyncRead(reader, 20, size, hdrl) != S_OK)
+    {
+        free(hdrl);
+        return 0;
+    }
+
+    p = hdrl + 4;
+    end = hdrl + size;
+    while (end - p >= 8 && count < max_headers)
+    {
+        DWORD chunk_size = avi_read32(p + 4);
+        BYTE *chunk = p + 8, *q, *chunk_end;
+
+        if (chunk_size > (DWORD)(end - chunk))
+            break;
+        if (!memcmp(p, "LIST", 4) && chunk_size >= 4 && !memcmp(chunk, "strl", 4))
+        {
+            struct avi_stream_header *h = &headers[count];
+
+            memset(h, 0, sizeof(*h));
+            chunk_end = chunk + chunk_size;
+            q = chunk + 4;
+            while (chunk_end - q >= 8)
+            {
+                DWORD sub_size = avi_read32(q + 4);
+
+                if (sub_size > (DWORD)(chunk_end - q - 8))
+                    break;
+                if (!memcmp(q, "strh", 4) && sub_size >= 48)
+                {
+                    h->type = avi_read32(q + 8);
+                    h->handler = avi_read32(q + 8 + 4);
+                    h->scale = avi_read32(q + 8 + 20);
+                    h->rate = avi_read32(q + 8 + 24);
+                    h->suggested_buffer_size = avi_read32(q + 8 + 36);
+                    h->sample_size = avi_read32(q + 8 + 44);
+                }
+                else if (!memcmp(q, "strf", 4) && !h->format && (h->format = malloc(sub_size)))
+                {
+                    memcpy(h->format, q + 8, sub_size);
+                    h->format_size = sub_size;
+                }
+                q += 8 + sub_size + (sub_size & 1);
+            }
+            ++count;
+        }
+        p = chunk + chunk_size + (chunk_size & 1);
+    }
+
+    free(hdrl);
+    return count;
+}
+
+static const GUID *avi_bitmap_subtype(const BITMAPINFOHEADER *bih, DWORD format_size, GUID *fourcc)
+{
+    const DWORD *masks = (const DWORD *)((const BYTE *)bih + bih->biSize);
+
+    if (bih->biCompression == BI_RGB)
+    {
+        switch (bih->biBitCount)
+        {
+            case 1: return &MEDIASUBTYPE_RGB1;
+            case 4: return &MEDIASUBTYPE_RGB4;
+            case 8: return &MEDIASUBTYPE_RGB8;
+            case 16: return &MEDIASUBTYPE_RGB555;
+            case 24: return &MEDIASUBTYPE_RGB24;
+            case 32: return &MEDIASUBTYPE_RGB32;
+        }
+        return NULL;
+    }
+    if (bih->biCompression == BI_BITFIELDS)
+    {
+        if (format_size < bih->biSize + 3 * sizeof(DWORD))
+            return NULL;
+        if (bih->biBitCount == 16 && masks[0] == 0xf800 && masks[1] == 0x07e0 && masks[2] == 0x001f)
+            return &MEDIASUBTYPE_RGB565;
+        if (bih->biBitCount == 16 && masks[0] == 0x7c00 && masks[1] == 0x03e0 && masks[2] == 0x001f)
+            return &MEDIASUBTYPE_RGB555;
+        if (bih->biBitCount == 32 && masks[0] == 0xff0000 && masks[1] == 0xff00 && masks[2] == 0xff)
+            return &MEDIASUBTYPE_RGB32;
+        return NULL;
+    }
+    *fourcc = MEDIASUBTYPE_YUY2;
+    fourcc->Data1 = bih->biCompression;
+    return fourcc;
+}
+
+static AM_MEDIA_TYPE *avi_stream_media_type(const struct avi_stream_header *h, DWORD *buffer_size)
+{
+    AM_MEDIA_TYPE *mt;
+
+    if (!h->format)
+        return NULL;
+    if (!(mt = CoTaskMemAlloc(sizeof(*mt))))
+        return NULL;
+    memset(mt, 0, sizeof(*mt));
+
+    if (h->type == mmioFOURCC('v','i','d','s') && h->format_size >= sizeof(BITMAPINFOHEADER))
+    {
+        const BITMAPINFOHEADER *bih = (const BITMAPINFOHEADER *)h->format;
+        const GUID *subtype;
+        VIDEOINFOHEADER *vih;
+        GUID fourcc;
+        DWORD image_size;
+
+        if (bih->biSize < sizeof(BITMAPINFOHEADER) || bih->biSize > h->format_size || !bih->biWidth || !bih->biHeight
+                || !(subtype = avi_bitmap_subtype(bih, h->format_size, &fourcc)))
+        {
+            CoTaskMemFree(mt);
+            return NULL;
+        }
+        mt->cbFormat = offsetof(VIDEOINFOHEADER, bmiHeader) + h->format_size;
+        if (!(mt->pbFormat = CoTaskMemAlloc(mt->cbFormat)))
+        {
+            CoTaskMemFree(mt);
+            return NULL;
+        }
+        vih = (VIDEOINFOHEADER *)mt->pbFormat;
+        memset(vih, 0, offsetof(VIDEOINFOHEADER, bmiHeader));
+        memcpy(&vih->bmiHeader, h->format, h->format_size);
+        if (h->rate)
+            vih->AvgTimePerFrame = (REFERENCE_TIME)h->scale * 10000000 / h->rate;
+        mt->majortype = MEDIATYPE_Video;
+        mt->subtype = *subtype;
+        mt->formattype = FORMAT_VideoInfo;
+        if (bih->biCompression == BI_RGB || bih->biCompression == BI_BITFIELDS)
+        {
+            image_size = ((abs(bih->biWidth) * bih->biBitCount + 31) / 32) * 4 * abs(bih->biHeight);
+            vih->bmiHeader.biSizeImage = image_size;
+            mt->bFixedSizeSamples = TRUE;
+            mt->lSampleSize = image_size;
+            if (h->rate && h->scale)
+                vih->dwBitRate = (DWORD)min((ULONGLONG)image_size * 8 * h->rate / h->scale, 0xffffffff);
+        }
+        else
+        {
+            image_size = bih->biSizeImage;
+            mt->bTemporalCompression = TRUE;
+        }
+        *buffer_size = max(max(image_size, h->suggested_buffer_size), 16384);
+        return mt;
+    }
+
+    if (h->type == mmioFOURCC('a','u','d','s') && h->format_size >= sizeof(PCMWAVEFORMAT))
+    {
+        const WAVEFORMATEX *wfx = (const WAVEFORMATEX *)h->format;
+        DWORD size = max(h->format_size, sizeof(WAVEFORMATEX));
+
+        if (!(mt->pbFormat = CoTaskMemAlloc(size)))
+        {
+            CoTaskMemFree(mt);
+            return NULL;
+        }
+        memset(mt->pbFormat, 0, size);
+        memcpy(mt->pbFormat, h->format, h->format_size);
+        if (h->format_size < sizeof(WAVEFORMATEX))
+            ((WAVEFORMATEX *)mt->pbFormat)->cbSize = 0;
+        mt->cbFormat = size;
+        mt->majortype = MEDIATYPE_Audio;
+        mt->subtype = MEDIASUBTYPE_PCM;
+        mt->subtype.Data1 = wfx->wFormatTag;
+        mt->formattype = FORMAT_WaveFormatEx;
+        mt->bFixedSizeSamples = TRUE;
+        mt->lSampleSize = max(wfx->nBlockAlign, 1);
+        *buffer_size = max(max(h->suggested_buffer_size, wfx->nAvgBytesPerSec), 16384);
+        return mt;
+    }
+
+    CoTaskMemFree(mt);
+    return NULL;
+}
+
+/* GStreamer's AVI demuxer turns an uncompressed (BI_RGB: no compression, or a
+ * DIB/RGB/RAW handler) bottom-up stream's rows top-down, rows of
+ * width * (bits / 8) rounded up to 4 bytes */
+static void avi_demuxer_flip(const struct avi_stream_header *h, DWORD *stride, DWORD *rows)
+{
+    const BITMAPINFOHEADER *bih = (const BITMAPINFOHEADER *)h->format;
+    DWORD fourcc;
+
+    *stride = *rows = 0;
+    if (h->type != mmioFOURCC('v','i','d','s') || !h->format || h->format_size < sizeof(*bih))
+        return;
+    fourcc = bih->biCompression ? bih->biCompression : h->handler;
+    if (fourcc && fourcc != mmioFOURCC('D','I','B',' ') && fourcc != mmioFOURCC('R','G','B',' ')
+            && fourcc != mmioFOURCC('R','A','W',' '))
+        return;
+    if (bih->biHeight <= 0 || bih->biWidth <= 0 || bih->biBitCount < 8)
+        return;
+    *stride = ((DWORD)bih->biWidth * (bih->biBitCount / 8) + 3) & ~3u;
+    *rows = bih->biHeight;
+}
+
 static BOOL avi_splitter_filter_init_gst(struct parser *filter)
 {
+    struct avi_stream_header headers[64];
     wg_parser_t parser = filter->wg_parser;
