From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] win32u: D3DKMTQueryAdapterInfo for the types Wine has data for

ADAPTERTYPE, ADAPTERGUID, PHYSICALADAPTERCOUNT, GETSEGMENTSIZE and
CURRENTDISPLAYMODE are answered and the parameters validated; the types that
need a hardware driver stay unsupported (partial, escalated). CORE: integrator
must review (patches/notes/5220.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/win32u/d3dkmt.c b/dlls/win32u/d3dkmt.c
--- a/dlls/win32u/d3dkmt.c
+++ b/dlls/win32u/d3dkmt.c
@@ -37,6 +37,8 @@
     D3DKMT_HANDLE handle;               /* Kernel mode graphics adapter handle */
     struct list entry;                  /* List entry */
     VkPhysicalDevice vk_device;         /* Vulkan physical device */
+    LUID luid;                          /* the adapter's LUID */
+    GUID guid;                          /* Vulkan device UUID, or made of the LUID */
 };
 
 struct d3dkmt_device
@@ -295,6 +297,7 @@
     GUID uuid = {0};
 
     if (!(adapter = calloc( 1, sizeof(*adapter) ))) return STATUS_NO_MEMORY;
+    adapter->luid = desc->AdapterLuid;
 
     if (!d3dkmt_use_vulkan())
         WARN( "Vulkan is unavailable.\n" );
@@ -304,6 +307,16 @@
     else if (!(adapter->vk_device = get_vulkan_physical_device( &uuid )))
         WARN( "Failed to find vulkan device with GUID %s\n", debugstr_guid( &uuid ) );
 
+    /* the adapter GUID: the Vulkan device's UUID; without one, a fixed one made of the LUID */
+    if (uuid.Data1 || uuid.Data2 || uuid.Data3 || uuid.Data4[0] || uuid.Data4[7]) adapter->guid = uuid;
+    else
+    {
+        adapter->guid.Data1 = desc->AdapterLuid.LowPart;
+        adapter->guid.Data2 = LOWORD( desc->AdapterLuid.HighPart );
+        adapter->guid.Data3 = HIWORD( desc->AdapterLuid.HighPart );
+        memcpy( adapter->guid.Data4, "SGAdapt", 8 );
+    }
+
     pthread_mutex_lock( &d3dkmt_lock );
     desc->hAdapter = adapter->handle = ++handle_start;
     list_add_tail( &d3dkmt_adapters, &adapter->entry );
@@ -378,15 +391,171 @@
     return STATUS_SUCCESS;
 }
 
+/* Stained Glass OS: the outputs of D3DKMTQueryAdapterInfo that Wine can fill (layouts from the
+ * D3DKMT_ADAPTERTYPE, D3DKMT_SEGMENTSIZEINFO, D3DKMT_PHYSICAL_ADAPTER_COUNT, D3DKMT_CURRENTDISPLAYMODE and
+ * D3DKMT_DISPLAYMODE pages of the driver documentation) */
+struct kmt_adapter_type
+{
+    UINT value; /* RenderSupported:1, DisplaySupported:1, SoftwareDevice:1, PostDevice:1, ... */
+};
+
+struct kmt_segment_size_info
+{
+    ULONGLONG dedicated_video_memory;
+    ULONGLONG dedicated_system_memory;
+    ULONGLONG shared_system_memory;
+};
+
+struct kmt_display_mode
+{
+    UINT width;
+    UINT height;
+    UINT format;                 /* D3DDDIFORMAT */
+    UINT integer_refresh_rate;
+    UINT refresh_numerator;      /* D3DDDI_RATIONAL RefreshRate */
+    UINT refresh_denominator;
+    UINT scan_line_ordering;     /* D3DDDI_VIDEO_SIGNAL_SCANLINE_ORDERING */
+    UINT display_orientation;    /* D3DDDI_ROTATION */
+    UINT display_fixed_output;
+    UINT flags;                  /* D3DKMDT_DISPLAYMODE_FLAGS */
+};
+
+struct kmt_current_display_mode
+{
+    UINT vidpn_source_id;
+    struct kmt_display_mode mode;
+};
+
+static NTSTATUS query_current_display_mode( const LUID *adapter_luid, struct kmt_current_display_mode *out )
+{
+    WCHAR name[CCHDEVICENAME];
+    UNICODE_STRING device;
+    DEVMODEW devmode = {.dmSize = sizeof(devmode)};
+    char buffer[64];
+    LUID luid;
+    UINT source_id;
+
+    /* the source id is numbered as NtGdiDdDDIOpenAdapterFromHdc returns it (see get_display_source_luid) */
+    snprintf( buffer, sizeof(buffer), "\\\\.\\DISPLAY%u", out->vidpn_source_id );
+    asciiz_to_unicode( name, buffer );
+    if (!get_display_source_luid( name, &luid, &source_id ) || source_id != out->vidpn_source_id ||
+        memcmp( &luid, adapter_luid, sizeof(luid) ))
+    {
+        TRACE( "source %u: %s luid %08x:%08x (adapter %08x:%08x)\n", out->vidpn_source_id, debugstr_w(name),
+               (int)luid.HighPart, (int)luid.LowPart, (int)adapter_luid->HighPart, (int)adapter_luid->LowPart );
+        return STATUS_INVALID_PARAMETER;
+    }
+    RtlInitUnicodeString( &device, name );
+    if (!NtUserEnumDisplaySettings( &device, ENUM_CURRENT_SETTINGS, &devmode, 0 )) return STATUS_INVALID_PARAMETER;
+
+    memset( &out->mode, 0, sizeof(out->mode) );
+    out->mode.width = devmode.dmPelsWidth;
+    out->mode.height = devmode.dmPelsHeight;
+    switch (devmode.dmBitsPerPel)
+    {
+    case 8:  out->mode.format = 0x29; break;   /* D3DDDIFMT_P8 */
+    case 16: out->mode.format = 0x17; break;   /* D3DDDIFMT_R5G6B5 */
+    case 24: out->mode.format = 0x14; break;   /* D3DDDIFMT_R8G8B8 */
+    default: out->mode.format = 0x16; break;   /* D3DDDIFMT_X8R8G8B8 */
+    }
+    out->mode.integer_refresh_rate = devmode.dmDisplayFrequency;
+    out->mode.refresh_numerator = devmode.dmDisplayFrequency;
+    out->mode.refresh_denominator = devmode.dmDisplayFrequency ? 1 : 0;
+    out->mode.scan_line_ordering = (devmode.dmFields & DM_DISPLAYFLAGS) && (devmode.dmDisplayFlags & DM_INTERLACED) ? 2 : 1;
+    out->mode.display_orientation = (devmode.dmFields & DM_DISPLAYORIENTATION) ? devmode.dmDisplayOrientation + 1 : 1;
+    return STATUS_SUCCESS;
+}
+
 /******************************************************************************
  *           NtGdiDdDDIQueryAdapterInfo    (win32u.@)
  */
 NTSTATUS WINAPI NtGdiDdDDIQueryAdapterInfo( D3DKMT_QUERYADAPTERINFO *desc )
 {
-    if (!desc) return STATUS_INVALID_PARAMETER;
+    struct d3dkmt_adapter *adapter, copy;
+    NTSTATUS status = STATUS_SUCCESS;
+    UINT size;
+
+    TRACE( "(%p)\n", desc );
+
+    if (!desc || !desc->hAdapter || !desc->pPrivateDriverData) return STATUS_INVALID_PARAMETER;
+
+    switch (desc->Type)
+    {
+    case KMTQAITYPE_ADAPTERTYPE:         size = sizeof(struct kmt_adapter_type); break;
+    case KMTQAITYPE_ADAPTERGUID:         size = sizeof(GUID); break;
+    case KMTQAITYPE_PHYSICALADAPTERCOUNT: size = sizeof(UINT); break;
+    case KMTQAITYPE_GETSEGMENTSIZE:      size = sizeof(struct kmt_segment_size_info); break;
+    case KMTQAITYPE_CURRENTDISPLAYMODE:  size = sizeof(struct kmt_current_display_mode); break;
+    default:
+        FIXME( "desc %p, type %d not supported\n", desc, desc->Type );
+        return STATUS_NOT_IMPLEMENTED;
+    }
+#ifndef SG_MUTANT_QAI_NOSIZE
+    if (desc->PrivateDriverDataSize < size) return STATUS_INVALID_PARAMETER;
+#endif
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if (!(adapter = find_adapter_from_handle( desc->hAdapter )))
+    {
+        pthread_mutex_unlock( &d3dkmt_lock );
+        return STATUS_INVALID_PARAMETER;
+    }
+    copy = *adapter;
+    pthread_mutex_unlock( &d3dkmt_lock );
+    adapter = &copy;
 
-    FIXME( "desc %p, type %d stub\n", desc, desc->Type );
-    return STATUS_NOT_IMPLEMENTED;
+    switch (desc->Type)
+    {
+    case KMTQAITYPE_ADAPTERTYPE:
+    {
+        struct kmt_adapter_type *type = desc->pPrivateDriverData;
+        UINT source_id;
+        LUID luid;
+        WCHAR name[CCHDEVICENAME];
+
+        /* a render device; a display device when it has a display source; the POST device */
+        type->value = 0x1 | 0x8;
+        asciiz_to_unicode( name, "\\\\.\\DISPLAY1" );
+        if (get_display_source_luid( name, &luid, &source_id ) && !memcmp( &luid, &adapter->luid, sizeof(luid) ))
+            type->value |= 0x2;
+#ifdef SG_MUTANT_QAI_TYPE
+        type->value = 0;
+#endif
+        break;
+    }
+    case KMTQAITYPE_ADAPTERGUID:
+        *(GUID *)desc->pPrivateDriverData = adapter->guid;
+        break;
+    case KMTQAITYPE_PHYSICALADAPTERCOUNT:
+        *(UINT *)desc->pPrivateDriverData = 1;   /* Wine has no linked adapters */
+        break;
+    case KMTQAITYPE_GETSEGMENTSIZE:
+    {
+        struct kmt_segment_size_info *info = desc->pPrivateDriverData;
+        VkPhysicalDeviceMemoryProperties properties;
+        unsigned int i;
+
+        memset( info, 0, sizeof(*info) );
+        if (adapter->vk_device)
+        {
+            pvkGetPhysicalDeviceMemoryProperties( adapter->vk_device, &properties );
+            for (i = 0; i < properties.memoryHeapCount; i++)
+            {
+                if (properties.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)
+                    info->dedicated_video_memory += properties.memoryHeaps[i].size;
+                else
+                    info->shared_system_memory += properties.memoryHeaps[i].size;
+            }
+        }
+        break;
+    }
+    case KMTQAITYPE_CURRENTDISPLAYMODE:
+        status = query_current_display_mode( &adapter->luid, desc->pPrivateDriverData );
+        break;
+    default:
+        break;
+    }
+    return status;
 }
 
 /******************************************************************************
