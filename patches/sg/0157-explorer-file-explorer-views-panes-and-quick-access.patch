+/* what shows for a location: This PC and Quick access are pages of ours */
+static int location_content(const ITEMIDLIST *pidl)
+{
+    if (is_quick(pidl)) return CONTENT_QUICK;
+    if (pidl && fe.mycomputer && ILIsEqual(pidl, fe.mycomputer)) return CONTENT_THISPC;
+    return CONTENT_FOLDER;
+}
