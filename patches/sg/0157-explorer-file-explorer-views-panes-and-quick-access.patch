+/* a 32-bit premultiplied DIB drawn scaled with its alpha */
+static void draw_picture(HDC dc, HBITMAP bitmap, int x, int y, int w, int h)
+{
+    GpGraphics *g;
+    GpBitmap *image;
+    BITMAP bm;
+
+    if (!GetObjectW(bitmap, sizeof(bm), &bm) || bm.bmBitsPixel != 32 || !bm.bmBits) return;
+    if (GdipCreateFromHDC(dc, &g) != Ok) return;
+    GdipSetInterpolationMode(g, InterpolationModeHighQualityBicubic);
+    GdipSetPixelOffsetMode(g, PixelOffsetModeHalf);
+    if (GdipCreateBitmapFromScan0(bm.bmWidth, bm.bmHeight, bm.bmWidthBytes, PixelFormat32bppPARGB, bm.bmBits, &image) == Ok)
+    {
+        GdipDrawImageRectI(g, (GpImage *)image, x, y, w, h);
+        GdipDisposeImage((GpImage *)image);
+    }
+    GdipDeleteGraphics(g);
+}
+
+static void pane_paint(HWND hwnd)
+{
+    struct paint p;
+    HDC dc = begin_paint(hwnd, &p);
+    RECT rc = p.rc, t, line = p.rc;
+    BITMAP bm;
+    int y = S(16), i;
+
+    line.right = 1;
+    fill(dc, &line, C_LINE);
+    rc.left += S(16);
+    rc.right -= S(16);
+    if (fe.pane == PANE_PREVIEW)
+    {
+        if (fe.pane_picture && GetObjectW(fe.pane_picture, sizeof(bm), &bm))
+        {
+            int w = bm.bmWidth, h = bm.bmHeight, max_w = rc.right - rc.left, max_h = p.rc.bottom - S(32);
+            if (w > max_w) { h = h * max_w / w; w = max_w; }
+            if (h > max_h) { w = w * max_h / h; h = max_h; }
+            draw_picture(dc, fe.pane_picture, rc.left + (max_w - w) / 2, S(16) + (max_h - h) / 2, w, h);
+        }
+        else if (!fe.pane_text)
+        {
+            t = p.rc;
+            text(dc, fe.pane_count == 1 ? L"No preview available." : L"Select a file to preview.", &t, C_MUTED,
+                 DT_SINGLELINE | DT_CENTER | DT_VCENTER);
+        }
+        end_paint(hwnd, &p);
+        return;
+    }
+
+    /* details */
+    if (!fe.pane_count)
+    {
+        t = p.rc;
+        text(dc, L"Select a single file to get more information.", &t, C_MUTED,
+             DT_CENTER | DT_VCENTER | DT_WORDBREAK);
+        end_paint(hwnd, &p);
+        return;
+    }
+    if (fe.pane_picture && GetObjectW(fe.pane_picture, sizeof(bm), &bm))
+    {
+        int size = S(128), w = bm.bmWidth, h = bm.bmHeight;
+        if (w > size || h > size) { if (w >= h) { h = h * size / w; w = size; } else { w = w * size / h; h = size; } }
+        draw_picture(dc, fe.pane_picture, rc.left + (rc.right - rc.left - w) / 2, y + (size - h) / 2, w, h);
+        y += size + S(16);
+    }
+    SelectObject(dc, fe.font_title);
+    SetRect(&t, rc.left, y, rc.right, y + S(28));
+    text(dc, fe.pane_name, &t, C_TEXT, DT_SINGLELINE | DT_LEFT | DT_END_ELLIPSIS);
+    y += S(30);
+    SelectObject(dc, fe.font);
+    if (fe.pane_type[0])
+    {
+        SetRect(&t, rc.left, y, rc.right, y + fe.font_height + S(4));
+        text(dc, fe.pane_type, &t, C_MUTED, DT_SINGLELINE | DT_LEFT | DT_END_ELLIPSIS);
+        y += fe.font_height + S(16);
+    }
+    for (i = 0; i < fe.pane_nlines; i++)
+    {
+        WCHAR label[80], *tab = wcschr(fe.pane_lines[i], '\t');
+        lstrcpynW(label, fe.pane_lines[i], tab ? min(80, tab - fe.pane_lines[i] + 1) : 80);
+        SetRect(&t, rc.left, y, rc.left + S(110), y + fe.font_height + S(4));
+        text(dc, label, &t, C_MUTED, DT_SINGLELINE | DT_LEFT | DT_END_ELLIPSIS);
+        SetRect(&t, rc.left + S(114), y, rc.right, y + fe.font_height + S(4));
+        text(dc, tab ? tab + 1 : L"", &t, C_TEXT, DT_SINGLELINE | DT_LEFT | DT_END_ELLIPSIS);
+        y += fe.font_height + S(8);
+    }
+    end_paint(hwnd, &p);
+}
