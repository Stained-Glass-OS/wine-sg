+static const WCHAR *text_extensions[] =
+{
+    L".txt", L".log", L".ini", L".inf", L".xml", L".json", L".md", L".csv", L".c", L".h", L".cpp", L".hpp",
+    L".cs", L".py", L".js", L".ts", L".css", L".html", L".htm", L".bat", L".cmd", L".ps1", L".reg", L".sh",
+    L".yml", L".yaml", L".toml", L".cfg", L".conf", L".rs", L".go", L".java", L".sql", L".diff", L".patch",
+};
+
+static BOOL is_text_file(const WCHAR *path)
+{
+    const WCHAR *ext = PathFindExtensionW(path);
+    WCHAR perceived[32];
+    DWORD size = sizeof(perceived);
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(text_extensions); i++) if (!wcsicmp(ext, text_extensions[i])) return TRUE;
+    return ext[0] && !RegGetValueW(HKEY_CLASSES_ROOT, ext, L"PerceivedType", RRF_RT_REG_SZ, NULL, perceived, &size) &&
+           !wcsicmp(perceived, L"text");
+}
+
+/* the start of a text file, for the preview: BOM-aware, UTF-8 when valid, else the code page */
+static WCHAR *read_text_preview(const WCHAR *path)
+{
+    HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+    BYTE *bytes;
+    DWORD got = 0;
+    WCHAR *text = NULL, *out;
+    int n, i, j;
+
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    if ((bytes = malloc(65536 + 2)))
+    {
+        ReadFile(file, bytes, 65536, &got, NULL);
+        bytes[got] = bytes[got + 1] = 0;
+        if (got >= 2 && bytes[0] == 0xff && bytes[1] == 0xfe)
+        {
+            if ((text = calloc(got / 2 + 1, sizeof(WCHAR)))) memcpy(text, bytes + 2, got - 2);
+        }
+        else
+        {
+            BYTE *start = bytes;
+            if (got >= 3 && bytes[0] == 0xef && bytes[1] == 0xbb && bytes[2] == 0xbf) { start += 3; got -= 3; }
+            n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, (char *)start, got, NULL, 0);
+            if (n > 0 && (text = calloc(n + 1, sizeof(WCHAR)))) MultiByteToWideChar(CP_UTF8, 0, (char *)start, got, text, n);
+            else if ((n = MultiByteToWideChar(CP_ACP, 0, (char *)start, got, NULL, 0)) > 0 && (text = calloc(n + 1, sizeof(WCHAR))))
+                MultiByteToWideChar(CP_ACP, 0, (char *)start, got, text, n);
+        }
+        free(bytes);
+    }
+    CloseHandle(file);
+    if (!text) return NULL;
+    /* the edit control wants CR LF */
+    n = lstrlenW(text);
+    if ((out = calloc(n * 2 + 1, sizeof(WCHAR))))
+    {
+        for (i = j = 0; i < n; i++)
+        {
+            if (text[i] == '\n' && (!i || text[i - 1] != '\r')) out[j++] = '\r';
+            out[j++] = text[i] ? text[i] : ' ';
+        }
+        out[j] = 0;
+    }
+    free(text);
+    return out;
+}
+
+static void format_file_time(const FILETIME *ft, WCHAR *buf, int len)
+{
+    FILETIME local;
+    SYSTEMTIME st;
+    WCHAR date[64], time[64];
+
+    FileTimeToLocalFileTime(ft, &local);
+    FileTimeToSystemTime(&local, &st);
+    GetDateFormatW(LOCALE_USER_DEFAULT, DATE_SHORTDATE, &st, NULL, date, ARRAY_SIZE(date));
+    GetTimeFormatW(LOCALE_USER_DEFAULT, TIME_NOSECONDS, &st, NULL, time, ARRAY_SIZE(time));
+    swprintf(buf, len, L"%s %s", date, time);
+}
+
+/* a picture of the item for the pane: its thumbnail, else its icon, no larger than size */
+static HBITMAP pane_picture(const WCHAR *path, int size, BOOL thumbnail_only)
+{
+    IShellItemImageFactory *factory;
+    HBITMAP bitmap = NULL;
+    SIZE sz = { size, size };
+
+    if (SUCCEEDED(SHCreateItemFromParsingName(path, NULL, &IID_IShellItemImageFactory, (void **)&factory)))
+    {
+        if (FAILED(IShellItemImageFactory_GetImage(factory, sz, thumbnail_only ? SIIGBF_THUMBNAILONLY : SIIGBF_BIGGERSIZEOK, &bitmap)))
+            bitmap = NULL;
+        IShellItemImageFactory_Release(factory);
+    }
+    return bitmap;
+}
