+/* ------------------------------------------------------------------------ */
+/* Quick access: pinned folders (shell32's "Pin to Quick access" writes     */
+/* them), the folders visited most, and the files opened lately            */
+
+#define QA_KEY SG_EXPLORER_KEY L"\\QuickAccess"
+
+static const KNOWNFOLDERID *qa_default_pins[] = { &FOLDERID_Desktop, &FOLDERID_Downloads, &FOLDERID_Documents, &FOLDERID_Pictures };
+
+/* the pinned folders, double-null-terminated (the defaults until the user changes them) */
+static WCHAR *qa_pins(void)
+{
+    DWORD size = 0;
+    WCHAR *list;
+    size_t len = 0;
+    unsigned int i;
+
+    if (!RegGetValueW(HKEY_CURRENT_USER, QA_KEY, L"Pinned", RRF_RT_REG_MULTI_SZ, NULL, NULL, &size) &&
+        (list = calloc(size / sizeof(WCHAR) + 2, sizeof(WCHAR))))
+    {
+        if (!RegGetValueW(HKEY_CURRENT_USER, QA_KEY, L"Pinned", RRF_RT_REG_MULTI_SZ, NULL, list, &size)) return list;
+        free(list);
+    }
+    if (!(list = calloc(ARRAY_SIZE(qa_default_pins) * MAX_PATH + 1, sizeof(WCHAR)))) return NULL;
+    for (i = 0; i < ARRAY_SIZE(qa_default_pins); i++)
+    {
+        WCHAR *path;
+        if (FAILED(SHGetKnownFolderPath(qa_default_pins[i], 0, NULL, &path))) continue;
+        lstrcpynW(list + len, path, MAX_PATH);
+        len += lstrlenW(list + len) + 1;
+        CoTaskMemFree(path);
+    }
+    list[len] = 0;
+    return list;
+}
+
+static BOOL qa_pinned(const WCHAR *path)
+{
+    WCHAR *list = qa_pins(), *p;
+    BOOL found = FALSE;
+
+    for (p = list; p && *p && !found; p += lstrlenW(p) + 1) found = !wcsicmp(p, path);
+    free(list);
+    return found;
+}
+
+struct qa_folder
+{
+    WCHAR path[MAX_PATH];
+    DWORD count;
+    FILETIME last;
+};
+
+/* a folder was visited: one more for its place among the frequent ones */
+static void qa_visit(const ITEMIDLIST *pidl)
+{
+    struct { DWORD count; FILETIME last; } data = { 0 };
+    WCHAR path[MAX_PATH];
+    DWORD size = sizeof(data);
+
+    if (!pidl_path(pidl, path) || !PathIsDirectoryW(path) || PathIsRootW(path)) return;
+    RegGetValueW(HKEY_CURRENT_USER, QA_KEY L"\\Frequent", path, RRF_RT_REG_BINARY, NULL, &data, &size);
+    data.count++;
+    GetSystemTimeAsFileTime(&data.last);
+    RegSetKeyValueW(HKEY_CURRENT_USER, QA_KEY L"\\Frequent", path, REG_BINARY, &data, sizeof(data));
+}
+
+static int __cdecl qa_compare_frequent(const void *a, const void *b)
+{
+    const struct qa_folder *x = a, *y = b;
+    if (x->count != y->count) return x->count > y->count ? -1 : 1;
+    return -CompareFileTime(&x->last, &y->last);
+}
+
+/* the folders visited more than once, most visited first, pins left out */
+static int qa_frequent(struct qa_folder *out, int max)
+{
+    struct { DWORD count; FILETIME last; } data;
+    struct qa_folder *all = NULL, *grown;
+    WCHAR name[MAX_PATH];
+    DWORD i, name_len, size, n = 0, cap = 0;
+    HKEY key;
+    int count = 0;
+
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, QA_KEY L"\\Frequent", 0, KEY_READ, &key)) return 0;
+    for (i = 0;; i++)
+    {
+        name_len = MAX_PATH;
+        size = sizeof(data);
+        if (RegEnumValueW(key, i, name, &name_len, NULL, NULL, (BYTE *)&data, &size)) break;
+        if (size != sizeof(data) || data.count < 2 || !PathIsDirectoryW(name) || qa_pinned(name)) continue;
+        if (n == cap)
+        {
+            cap = max(32, cap * 2);
+            if (!(grown = realloc(all, cap * sizeof(*all)))) break;
+            all = grown;
+        }
+        lstrcpyW(all[n].path, name);
+        all[n].count = data.count;
+        all[n].last = data.last;
+        n++;
+    }
+    RegCloseKey(key);
+    if (n) qsort(all, n, sizeof(*all), qa_compare_frequent);
+    for (i = 0; i < n && count < max; i++) out[count++] = all[i];
+    free(all);
+    return count;
+}
+
+struct qa_recent
+{
+    WCHAR path[MAX_PATH];
+    FILETIME when;
+};
+
+static int __cdecl qa_compare_recent(const void *a, const void *b)
+{
+    return -CompareFileTime(&((const struct qa_recent *)a)->when, &((const struct qa_recent *)b)->when);
+}
+
+/* the files opened lately: the Recent folder's shortcuts (SHAddToRecentDocs), newest first */
+static int qa_recent_files(struct qa_recent *out, int max)
+{
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH], lnk[MAX_PATH], target[MAX_PATH];
+    struct qa_recent *all = NULL, *grown;
+    WIN32_FIND_DATAW fd;
+    int n = 0, cap = 0, count = 0, i, j;
+    HANDLE find;
+
+    if (SHGetFolderPathW(NULL, CSIDL_RECENT, NULL, SHGFP_TYPE_CURRENT, dir) != S_OK) return 0;
+    PathCombineW(pattern, dir, L"*.lnk");
+    if ((find = FindFirstFileW(pattern, &fd)) == INVALID_HANDLE_VALUE) return 0;
+    do
+    {
+        IShellLinkW *sl;
+        IPersistFile *pf;
+
+        target[0] = 0;
+        PathCombineW(lnk, dir, fd.cFileName);
+        if (SUCCEEDED(CoCreateInstance(&CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&sl)))
+        {
+            if (SUCCEEDED(IShellLinkW_QueryInterface(sl, &IID_IPersistFile, (void **)&pf)))
+            {
+                if (SUCCEEDED(IPersistFile_Load(pf, lnk, STGM_READ))) IShellLinkW_GetPath(sl, target, MAX_PATH, NULL, SLGP_RAWPATH);
+                IPersistFile_Release(pf);
+            }
+            IShellLinkW_Release(sl);
+        }
+        if (!target[0] || GetFileAttributesW(target) == INVALID_FILE_ATTRIBUTES || PathIsDirectoryW(target)) continue;
+        if (n == cap)
+        {
+            cap = max(32, cap * 2);
+            if (!(grown = realloc(all, cap * sizeof(*all)))) break;
+            all = grown;
+        }
+        lstrcpyW(all[n].path, target);
+        all[n].when = fd.ftLastWriteTime;
+        n++;
+    } while (FindNextFileW(find, &fd));
+    FindClose(find);
+    if (n) qsort(all, n, sizeof(*all), qa_compare_recent);
+    for (i = 0; i < n && count < max; i++)
+    {
+        for (j = 0; j < count; j++) if (!wcsicmp(out[j].path, all[i].path)) break;
+        if (j == count) out[count++] = all[i];
+    }
+    free(all);
+    return count;
+}
