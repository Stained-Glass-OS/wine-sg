+/* ------------------------------------------------------------------------ */
+/* the navigation pane takes files dropped on its folders and drives        */
+
+static DWORD tree_drag_allowed;
+
+static IDropTarget *folder_drop_target(const ITEMIDLIST *pidl)
+{
+    IShellFolder *desktop, *folder;
+    IDropTarget *dt = NULL;
+
+    if (FAILED(SHGetDesktopFolder(&desktop))) return NULL;
+    if (SUCCEEDED(IShellFolder_BindToObject(desktop, pidl, NULL, &IID_IShellFolder, (void **)&folder)))
+    {
+        if (FAILED(IShellFolder_CreateViewObject(folder, fe.hwnd, &IID_IDropTarget, (void **)&dt))) dt = NULL;
+        IShellFolder_Release(folder);
+    }
+    IShellFolder_Release(desktop);
+    return dt;
+}
+
+static void tree_drop_reset(void)
+{
+    if (fe.tree_drop)
+    {
+        IDropTarget_DragLeave(fe.tree_drop);
+        IDropTarget_Release(fe.tree_drop);
+        fe.tree_drop = NULL;
+    }
+    if (fe.tree_drop_item)
+    {
+        fe.tree_drop_item = NULL;
+        InvalidateRect(fe.tree, NULL, FALSE);
+    }
+}
+
+static HRESULT WINAPI treedrop_QueryInterface(IDropTarget *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IDropTarget))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI treedrop_AddRef(IDropTarget *iface) { return 2; }
+static ULONG WINAPI treedrop_Release(IDropTarget *iface) { return 1; }
+
+static HRESULT WINAPI treedrop_DragOver(IDropTarget *iface, DWORD keys, POINTL pt, DWORD *effect)
+{
+    TVHITTESTINFO ht;
+    HTREEITEM item;
+    struct tree_node *node;
+
+    ht.pt.x = pt.x;
+    ht.pt.y = pt.y;
+    ScreenToClient(fe.tree, &ht.pt);
+    item = (HTREEITEM)SendMessageW(fe.tree, TVM_HITTEST, 0, (LPARAM)&ht);
+    if (item != fe.tree_drop_item || (!fe.tree_drop && item))
+    {
+        tree_drop_reset();
+        node = node_of(item);
+        if (node && node->pidl && !is_quick(node->pidl) && fe.tree_drag_data &&
+            (fe.tree_drop = folder_drop_target(node->pidl)))
+        {
+            DWORD allowed = tree_drag_allowed;
+            if (FAILED(IDropTarget_DragEnter(fe.tree_drop, fe.tree_drag_data, keys, pt, &allowed)) || !allowed)
+            {
+                IDropTarget_Release(fe.tree_drop);
+                fe.tree_drop = NULL;
+            }
+            else
+            {
+                WCHAR name[MAX_PATH];
+                fe.tree_drop_item = item;
+                display_name(node->pidl, name, MAX_PATH);
+                TRACE("dragging over %s\n", debugstr_w(name));
+            }
+        }
+        InvalidateRect(fe.tree, NULL, FALSE);
+    }
+    if (fe.tree_drop)
+    {
+        *effect &= tree_drag_allowed;
+        return IDropTarget_DragOver(fe.tree_drop, keys, pt, effect);
+    }
+    *effect = DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI treedrop_DragEnter(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    if (fe.tree_drag_data) IDataObject_Release(fe.tree_drag_data);
+    IDataObject_AddRef(fe.tree_drag_data = data);
+    tree_drag_allowed = *effect;
+    tree_drop_reset();
+    return treedrop_DragOver(iface, keys, pt, effect);
+}
+
+static HRESULT WINAPI treedrop_DragLeave(IDropTarget *iface)
+{
+    tree_drop_reset();
+    if (fe.tree_drag_data) IDataObject_Release(fe.tree_drag_data);
+    fe.tree_drag_data = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI treedrop_Drop(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    HRESULT hr = S_OK;
+
+    treedrop_DragOver(iface, keys, pt, effect);
+    if (fe.tree_drop)
+    {
+        *effect &= tree_drag_allowed;
+        TRACE("dropped on the navigation pane, effect %#lx\n", *effect);
+        hr = IDropTarget_Drop(fe.tree_drop, data, keys, pt, effect);
+        IDropTarget_Release(fe.tree_drop);
+        fe.tree_drop = NULL;
+    }
+    else *effect = DROPEFFECT_NONE;
+    tree_drop_reset();
+    if (fe.tree_drag_data) IDataObject_Release(fe.tree_drag_data);
+    fe.tree_drag_data = NULL;
+    return hr;
+}
+
+static const IDropTargetVtbl treedrop_vtbl =
+{
+    treedrop_QueryInterface, treedrop_AddRef, treedrop_Release,
+    treedrop_DragEnter, treedrop_DragOver, treedrop_DragLeave, treedrop_Drop
+};
+static IDropTarget tree_drop_target = { &treedrop_vtbl };
