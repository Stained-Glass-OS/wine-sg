+/* works out what the pane shows for the current selection */
+static void update_pane(void)
+{
+    WCHAR *list = NULL;
+    int count = 0;
+    BOOL show_text = FALSE;
+
+    if (!fe.pane_wnd) return;
+    if (fe.pane_picture) { DeleteObject(fe.pane_picture); fe.pane_picture = NULL; }
+    fe.pane_path[0] = fe.pane_name[0] = fe.pane_type[0] = 0;
+    fe.pane_nlines = 0;
+    fe.pane_text = fe.pane_folder = FALSE;
+    fe.pane_count = 0;
+    if (fe.pane == PANE_NONE) return;
+
+    if (fe.content == CONTENT_FOLDER || fe.content == CONTENT_SEARCH) list = selected_paths(&count);
+    else if (IS_PAGE() && fe.pc_sel >= 0 && (list = calloc(MAX_PATH + 2, sizeof(WCHAR))))
+    {
+        if (fe.pc[fe.pc_sel].drive) lstrcpyW(list, fe.pc[fe.pc_sel].root);
+        else pidl_path(fe.pc[fe.pc_sel].pidl, list);
+        count = list[0] ? 1 : 0;
+    }
+    fe.pane_count = count;
+    if (count == 1)
+    {
+        WIN32_FILE_ATTRIBUTE_DATA fad;
+        SHFILEINFOW info;
+
+        lstrcpynW(fe.pane_path, list, MAX_PATH);
+        if (SHGetFileInfoW(list, 0, &info, sizeof(info), SHGFI_DISPLAYNAME | SHGFI_TYPENAME))
+        {
+            lstrcpynW(fe.pane_name, info.szDisplayName, MAX_PATH);
+            lstrcpynW(fe.pane_type, info.szTypeName, ARRAY_SIZE(fe.pane_type));
+        }
+        if (GetFileAttributesExW(list, GetFileExInfoStandard, &fad))
+        {
+            WCHAR when[64], size[64];
+            fe.pane_folder = !!(fad.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY);
+            format_file_time(&fad.ftLastWriteTime, when, ARRAY_SIZE(when));
+            swprintf(fe.pane_lines[fe.pane_nlines++], 160, L"Date modified:\t%s", when);
+            if (!fe.pane_folder)
+            {
+                StrFormatByteSizeW(((ULONGLONG)fad.nFileSizeHigh << 32) | fad.nFileSizeLow, size, ARRAY_SIZE(size));
+                swprintf(fe.pane_lines[fe.pane_nlines++], 160, L"Size:\t%s", size);
+            }
+            format_file_time(&fad.ftCreationTime, when, ARRAY_SIZE(when));
+            swprintf(fe.pane_lines[fe.pane_nlines++], 160, L"Date created:\t%s", when);
+        }
+        if (fe.pane == PANE_PREVIEW && !fe.pane_folder && is_text_file(list))
+        {
+            WCHAR *text = read_text_preview(list);
+            if (text)
+            {
+                SetWindowTextW(fe.pane_edit, text);
+                free(text);
+                show_text = fe.pane_text = TRUE;
+                TRACE("preview: text of %s\n", debugstr_w(list));
+            }
+        }
+        if (!fe.pane_text)
+        {
+            RECT rc;
+            GetClientRect(fe.pane_wnd, &rc);
+            if (fe.pane == PANE_PREVIEW)
+            {
+                fe.pane_picture = fe.pane_folder ? NULL : pane_picture(list, max(S(64), min(rc.right, rc.bottom) - S(32)), TRUE);
+                TRACE("preview: %s %s\n", fe.pane_picture ? "picture of" : "nothing for", debugstr_w(list));
+            }
+            else
+                fe.pane_picture = pane_picture(list, S(128), FALSE);
+        }
+    }
+    else if (count > 1)
+    {
+        swprintf(fe.pane_name, MAX_PATH, L"%d items selected", count);
+    }
+    free(list);
+    ShowWindow(fe.pane_edit, show_text ? SW_SHOW : SW_HIDE);
+    InvalidateRect(fe.pane_wnd, NULL, FALSE);
+}
