+/* Quick access has no shell folder in Wine: its place in the history is a pidl of its CLSID */
+static ITEMIDLIST *make_quick_pidl(void)
+{
+    static const GUID home = { 0x679f85cb, 0x0220, 0x4080, { 0xb2, 0x9b, 0x55, 0x40, 0xcc, 0x05, 0xaa, 0xb6 } };
+    BYTE *p = CoTaskMemAlloc(2 + 1 + 1 + sizeof(GUID) + 2);
+
+    if (!p) return NULL;
+    p[0] = 2 + 1 + 1 + sizeof(GUID);
+    p[1] = 0;
+    p[2] = 0x1f;    /* a root CLSID item */
+    p[3] = 0x50;
+    memcpy(p + 4, &home, sizeof(GUID));
+    p[4 + sizeof(GUID)] = p[5 + sizeof(GUID)] = 0;
+    return (ITEMIDLIST *)p;
+}
+
+static BOOL is_quick(const ITEMIDLIST *pidl)
+{
+    return pidl && fe.quick && ILGetSize(pidl) == ILGetSize(fe.quick) && !memcmp(pidl, fe.quick, ILGetSize(pidl));
+}
