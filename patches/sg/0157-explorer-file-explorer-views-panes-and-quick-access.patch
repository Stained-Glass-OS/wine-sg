+/* Quick access's branch: the pinned folders, then the frequent ones */
+static void fill_quick_tree(void)
+{
+    static DWORD last_signature;
+    struct qa_folder freq[5];
+    WCHAR *pins = qa_pins(), *p;
+    HTREEITEM child;
+    ITEMIDLIST *pidl;
+    int i, n, count = 0;
+    DWORD signature = 5381;
+
+    /* only when what it shows changed: a visit to a folder writes here too */
+    n = qa_frequent(freq, ARRAY_SIZE(freq));
+    for (p = pins; p && *p; p += lstrlenW(p) + 1)
+    {
+        const WCHAR *c;
+        for (c = p; *c; c++) signature = signature * 33 + *c;
+        signature = signature * 33 + '|';
+    }
+    for (i = 0; i < n; i++)
+    {
+        const WCHAR *c;
+        for (c = freq[i].path; *c; c++) signature = signature * 33 + *c;
+        signature = signature * 33 + '#';
+    }
+    if (signature == last_signature && SendMessageW(fe.tree, TVM_GETNEXTITEM, TVGN_CHILD, (LPARAM)tree_quick))
+    {
+        free(pins);
+        return;
+    }
+    last_signature = signature;
+
+    while ((child = (HTREEITEM)SendMessageW(fe.tree, TVM_GETNEXTITEM, TVGN_CHILD, (LPARAM)tree_quick)))
+        SendMessageW(fe.tree, TVM_DELETEITEM, 0, (LPARAM)child);
+    for (p = pins; p && *p; p += lstrlenW(p) + 1)
+    {
+        if (!(pidl = ILCreateFromPathW(p))) continue;
+        if ((child = tree_add(tree_quick, pidl, NULL, FALSE, G_NONE))) node_of(child)->pinned = TRUE;
+        ILFree(pidl);
+        count++;
+        TRACE("quick access pin: %s\n", debugstr_w(p));
+    }
+    free(pins);
+    for (i = 0; i < n; i++)
+    {
+        if (!(pidl = ILCreateFromPathW(freq[i].path))) continue;
+        tree_add(tree_quick, pidl, NULL, FALSE, G_NONE);
+        ILFree(pidl);
+        TRACE("quick access frequent: %s\n", debugstr_w(freq[i].path));
+    }
+    TRACE("quick access: %d pinned, %d frequent\n", count, n);
+    SendMessageW(fe.tree, TVM_EXPAND, TVE_EXPAND, (LPARAM)tree_quick);
+    InvalidateRect(fe.tree, NULL, FALSE);
+    if (fe.content == CONTENT_QUICK) show_content(CONTENT_QUICK);
+    else sync_tree();
