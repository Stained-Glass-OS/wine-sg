+/* Stained Glass OS: Mono's soft debugger agent, for debuggers that speak its protocol (and ICorDebug), when
+ * WINE_MONO_DEBUGGER_AGENT holds its options: transport=dt_socket,address=127.0.0.1:PORT[,server=y][,suspend=y].
+ * The agent runs the debugger's requests in the process, so it is only ever given a loopback address. */
+static BOOL agent_address_is_loopback(const char *options)
+{
+    const char *address = strstr(options, "address="), *end;
+    char host[64];
+    size_t len;
+
+    if (!address || !strstr(options, "transport=dt_socket")) return FALSE;
+    address += 8;
+    if (!(end = strrchr(address, ':')) || (strchr(address, ',') && strchr(address, ',') < end)) return FALSE;
+    len = end - address;
+    if (!len || len >= sizeof(host)) return FALSE;
+    memcpy(host, address, len);
+    host[len] = 0;
+#ifdef SG_MUTANT_AGENT_ANY_ADDRESS
+    return TRUE;
+#endif
+    return !strcmp(host, "localhost") || !strcmp(host, "[::1]") || !strcmp(host, "::1") || !strncmp(host, "127.", 4);
+}
+
+static void start_debugger_agent(void)
+{
+    char options[512], arg[600], *argv[1] = { arg };
+    DWORD len = GetEnvironmentVariableA("WINE_MONO_DEBUGGER_AGENT", options, sizeof(options));
+
+    if (!len) return;
+    if (len >= sizeof(options) || !mono_jit_parse_options || !mono_debug_init)
+    {
+        ERR("cannot start the debugger agent\n");
+        return;
+    }
+    if (!agent_address_is_loopback(options))
+    {
+        ERR("the debugger agent takes a loopback address only: %s\n", debugstr_a(options));
+        return;
+    }
+    TRACE("debugger agent %s\n", debugstr_a(options));
+    snprintf(arg, sizeof(arg), "--debugger-agent=%s", options);
+    mono_jit_parse_options(1, argv);
+    mono_debug_init(1 /* MONO_DEBUG_FORMAT_MONO */);
+}
+
