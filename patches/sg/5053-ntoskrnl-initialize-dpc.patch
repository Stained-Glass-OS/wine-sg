From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntoskrnl: Initialise DPC objects fully.

KeInitializeDpc makes a DPC object as Windows does - Type 0x13 (DpcObject),
MediumImportance, Number 0, no DPC data - besides the routine and context,
and KeSetImportanceDpc sets the importance. Removes two todo_wine in the
ntoskrnl driver test.

Gate: test/ntoskrnl-dpc-gate.sh (a probe driver; 64-bit, a WoW64 host skips).
---
 dlls/ntoskrnl.exe/ntoskrnl.c     | 17 +++++++++++++----
 dlls/ntoskrnl.exe/tests/driver.c |  4 ++--
 2 files changed, 15 insertions(+), 6 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index b2ec279..9e25dbd 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -3498,9 +3498,15 @@ MM_SYSTEMSIZE WINAPI MmQuerySystemSize(void)
  */
 void WINAPI KeInitializeDpc(KDPC *dpc, PKDEFERRED_ROUTINE deferred_routine, void *deferred_context)
 {
-    FIXME("dpc %p, deferred_routine %p, deferred_context %p semi-stub.\n",
-            dpc, deferred_routine, deferred_context);
-
+    TRACE("dpc %p, deferred_routine %p, deferred_context %p.\n", dpc, deferred_routine, deferred_context);
+
+    /* a DPC object of medium importance for any processor (ntoskrnl tests) */
+#ifndef SG_MUTANT_DPC_FIELDS
+    dpc->Type = 0x13;   /* DpcObject */
+    dpc->Importance = MediumImportance;
+    dpc->Number = 0;
+    dpc->DpcData = NULL;
+#endif
     dpc->DeferredRoutine = deferred_routine;
     dpc->DeferredContext = deferred_context;
 }
@@ -3510,7 +3516,10 @@ void WINAPI KeInitializeDpc(KDPC *dpc, PKDEFERRED_ROUTINE deferred_routine, void
  */
 VOID WINAPI KeSetImportanceDpc(PRKDPC dpc, KDPC_IMPORTANCE importance)
 {
-    FIXME("%p, %d stub\n", dpc, importance);
+    TRACE("%p, %d\n", dpc, importance);
+#ifndef SG_MUTANT_DPC_FIELDS
+    dpc->Importance = importance;
+#endif
 }
 
 /***********************************************************************
diff --git a/dlls/ntoskrnl.exe/tests/driver.c b/dlls/ntoskrnl.exe/tests/driver.c
index a556bf1..33bf2fa 100644
--- a/dlls/ntoskrnl.exe/tests/driver.c
+++ b/dlls/ntoskrnl.exe/tests/driver.c
@@ -2140,8 +2140,8 @@ static void test_dpc(void)
     pKeInitializeDpc(&dpc, test_dpc_func, &data);
 
     ok(dpc.Number == 0, "Got unexpected Dpc Number %u.\n", dpc.Number);
-    todo_wine ok(dpc.Type == 0x13, "Got unexpected Dpc Type %u.\n", dpc.Type);
-    todo_wine ok(dpc.Importance == MediumImportance, "Got unexpected Dpc Importance %u.\n", dpc.Importance);
+    ok(dpc.Type == 0x13, "Got unexpected Dpc Type %u.\n", dpc.Type);
+    ok(dpc.Importance == MediumImportance, "Got unexpected Dpc Importance %u.\n", dpc.Importance);
     ok(dpc.DeferredRoutine == test_dpc_func, "Got unexpected Dpc DeferredRoutine %p.\n", dpc.DeferredRoutine);
     ok(dpc.DeferredContext == &data, "Got unexpected Dpc DeferredContext %p.\n", dpc.DeferredContext);
 
