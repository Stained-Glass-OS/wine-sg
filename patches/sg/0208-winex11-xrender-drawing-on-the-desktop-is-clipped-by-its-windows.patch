From: Stained Glass OS <dev@stained-glass.example>
Subject: winex11: XRender drawing on the desktop is clipped by the windows on it

Drawing on the root window -- a virtual desktop's window, where every
top-level window is an X child -- must not cover the windows: X11DRV_GetDC
gives such a DC's GC ClipByChildren. The XRender destination picture was
always made with IncludeInferiors, though, so whatever the desktop drew
through XRender went over every window: a new wallpaper (a stretched or
tiled bitmap) covered all the windows and the taskbar until each repainted
(explorer's 250 ms repaint in patch 0069 hid it). The picture now takes the
DC's subwindow mode, kept in the physical device.

--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -121,6 +121,7 @@
     int           depth;       /* bit depth of the DC */
     ColorShifts  *color_shifts; /* color shifts of the DC */
     int           exposures;   /* count of graphics exposures operations */
+    int           subwindow_mode; /* the drawable's: ClipByChildren for the root (virtual desktop) window */
 } X11DRV_PDEVICE;
 
 #define GAMMA_RAMP_SIZE 256
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -89,6 +89,7 @@
     physDev->gc = XCreateGC( gdi_display, drawable, 0, NULL );
     XSetGraphicsExposures( gdi_display, physDev->gc, False );
     XSetSubwindowMode( gdi_display, physDev->gc, IncludeInferiors );
+    physDev->subwindow_mode = IncludeInferiors;
     XFlush( gdi_display );
     return physDev;
 }
@@ -291,6 +292,7 @@
                     physDev->gc = XCreateGC( gdi_display, physDev->drawable, 0, NULL );
                     XSetGraphicsExposures( gdi_display, physDev->gc, False );
                     XSetSubwindowMode( gdi_display, physDev->gc, data->mode );
+                    physDev->subwindow_mode = data->mode;
                     TRACE( "SET_DRAWABLE hdc %p drawable %lx dc_rect %s\n",
                            dev->hdc, physDev->drawable, wine_dbgstr_rect(&physDev->dc_rect) );
                     return TRUE;
--- a/dlls/winex11.drv/xrender.c
+++ b/dlls/winex11.drv/xrender.c
@@ -486,7 +486,11 @@
     {
         XRenderPictureAttributes pa;
 
-        pa.subwindow_mode = IncludeInferiors;
+        /* The DC's own mode: drawing on the desktop (the root window, a
+         * virtual desktop's window) is clipped by the top-level windows, as
+         * with the X11 GC (X11DRV_GetDC). With IncludeInferiors a desktop
+         * repaint -- a new wallpaper -- was drawn over every window. */
+        pa.subwindow_mode = dev->x11dev->subwindow_mode;
         dev->pict = pXRenderCreatePicture( gdi_display, dev->x11dev->drawable,
                                            dev->pict_format, CPSubwindowMode, &pa );
         TRACE( "Allocing pict=%lx dc=%p drawable=%08lx\n",
