From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vcruntime140: Implement the __vcrt module function wrappers.

vcruntime140's __vcrt_GetModuleFileNameW, __vcrt_GetModuleHandleW and
__vcrt_LoadLibraryExW, cdecl wrappers of the kernel32 functions, were spec
stubs.
---
 dlls/vcruntime140/misc.c            | 21 +++++++++++++++++++++
 dlls/vcruntime140/vcruntime140.spec |  6 +++---
 2 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/dlls/vcruntime140/misc.c b/dlls/vcruntime140/misc.c
index 2176633..3604ce1 100644
--- a/dlls/vcruntime140/misc.c
+++ b/dlls/vcruntime140/misc.c
@@ -50,6 +50,27 @@ BOOL CDECL __vcrt_InitializeCriticalSectionEx(
     return InitializeCriticalSectionEx(cs, spin_count, flags);
 }
 
+DWORD CDECL __vcrt_GetModuleFileNameW(HMODULE module, WCHAR *name, DWORD size)
+{
+    TRACE("(%p %p %lu)\n", module, name, size);
+    return GetModuleFileNameW(module, name, size);
+}
+
+HMODULE CDECL __vcrt_GetModuleHandleW(const WCHAR *name)
+{
+    TRACE("(%s)\n", debugstr_w(name));
+#ifdef SG_MUTANT_VCRT_MODULE_NULL
+    return NULL;
+#endif
+    return GetModuleHandleW(name);
+}
+
+HMODULE CDECL __vcrt_LoadLibraryExW(const WCHAR *name, HANDLE file, DWORD flags)
+{
+    TRACE("(%s %p %#lx)\n", debugstr_w(name), file, flags);
+    return LoadLibraryExW(name, file, flags);
+}
+
 int __cdecl __uncaught_exceptions(void)
 {
     return *__processing_throw();
diff --git a/dlls/vcruntime140/vcruntime140.spec b/dlls/vcruntime140/vcruntime140.spec
index 6bfa90e..02ade73 100644
--- a/dlls/vcruntime140/vcruntime140.spec
+++ b/dlls/vcruntime140/vcruntime140.spec
@@ -50,10 +50,10 @@
 @ cdecl __unDNameEx(ptr str long ptr ptr ptr long) ucrtbase.__unDNameEx
 @ cdecl __uncaught_exception() ucrtbase.__uncaught_exception
 @ cdecl __uncaught_exceptions()
-@ stub __vcrt_GetModuleFileNameW
-@ stub __vcrt_GetModuleHandleW
+@ cdecl __vcrt_GetModuleFileNameW(long ptr long)
+@ cdecl __vcrt_GetModuleHandleW(wstr)
 @ cdecl __vcrt_InitializeCriticalSectionEx(ptr long long)
-@ stub __vcrt_LoadLibraryExW
+@ cdecl __vcrt_LoadLibraryExW(wstr long long)
 @ cdecl -arch=i386 -norelay _chkesp() ucrtbase._chkesp
 @ cdecl -arch=i386 _except_handler2(ptr ptr ptr ptr) ucrtbase._except_handler2
 @ cdecl -arch=i386 _except_handler3(ptr ptr ptr ptr) ucrtbase._except_handler3
