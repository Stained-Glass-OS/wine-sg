+static struct core_application_statics core_application_statics =
+{
+    {&factory_vtbl},
+    {&core_application_vtbl},
+    1,
+    NULL,
+    {NULL, -1, 0, 0, 0, 0},
+};
+
+IActivationFactory *core_application_factory = &core_application_statics.IActivationFactory_iface;
