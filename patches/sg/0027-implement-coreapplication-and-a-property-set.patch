+/* A minimal Windows.Foundation.Collections.IPropertySet, for CoreApplication.
+ *
+ * CoreApplication exposes a process-wide property bag through its Properties
+ * member: a string-keyed map of arbitrary objects, used by frameworks (and by
+ * winget's start-up) to stash and retrieve process singletons. Wine has no
+ * IPropertySet implementation -- wintypes registers ValueSet but activates it
+ * as a stub -- so this provides a small, functional one: an ordinal-keyed map
+ * of IInspectable values with the observable-map and iterable faces present.
+ *
+ * Copyright (C) 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(model);
+
+struct entry
+{
+    HSTRING key;
+    IInspectable *value;
+};
+
+struct property_set
+{
+    IPropertySet IPropertySet_iface;
+    IMap_HSTRING_IInspectable IMap_iface;
+    IObservableMap_HSTRING_IInspectable IObservableMap_iface;
+    IIterable_IKeyValuePair_HSTRING_IInspectable IIterable_iface;
+    LONG ref;
+
+    struct entry *entries;
+    unsigned int count;
+    unsigned int capacity;
+};
+
+static struct property_set *impl_from_IPropertySet( IPropertySet *iface )
+{
+    return CONTAINING_RECORD( iface, struct property_set, IPropertySet_iface );
+}
+
+static HRESULT WINAPI property_set_QueryInterface( IPropertySet *iface, REFIID iid, void **out )
+{
+    struct property_set *impl = impl_from_IPropertySet( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IPropertySet ))
+        *out = &impl->IPropertySet_iface;
+    else if (IsEqualGUID( iid, &IID_IMap_HSTRING_IInspectable ))
+        *out = &impl->IMap_iface;
+    else if (IsEqualGUID( iid, &IID_IObservableMap_HSTRING_IInspectable ))
+        *out = &impl->IObservableMap_iface;
+    else if (IsEqualGUID( iid, &IID_IIterable_IKeyValuePair_HSTRING_IInspectable ))
+        *out = &impl->IIterable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI property_set_AddRef( IPropertySet *iface )
+{
+    struct property_set *impl = impl_from_IPropertySet( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI property_set_Release( IPropertySet *iface )
+{
+    struct property_set *impl = impl_from_IPropertySet( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        unsigned int i;
+        for (i = 0; i < impl->count; i++)
+        {
+            WindowsDeleteString( impl->entries[i].key );
+            if (impl->entries[i].value) IInspectable_Release( impl->entries[i].value );
+        }
+        free( impl->entries );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI property_set_GetIids( IPropertySet *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI property_set_GetRuntimeClassName( IPropertySet *iface, HSTRING *class_name )
+{
+    static const WCHAR name[] = L"Windows.Foundation.Collections.PropertySet";
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( name, ARRAY_SIZE(name) - 1, class_name );
+}
+
+static HRESULT WINAPI property_set_GetTrustLevel( IPropertySet *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static const struct IPropertySetVtbl property_set_vtbl =
+{
+    property_set_QueryInterface,
+    property_set_AddRef,
+    property_set_Release,
+    property_set_GetIids,
+    property_set_GetRuntimeClassName,
+    property_set_GetTrustLevel,
+};
+
+/* ---- IMap<HSTRING, IInspectable> --------------------------------------- */
+
+static struct property_set *impl_from_IMap( IMap_HSTRING_IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct property_set, IMap_iface );
+}
+
+static struct entry *find_entry( struct property_set *impl, HSTRING key )
+{
+    INT32 order;
+    unsigned int i;
+    for (i = 0; i < impl->count; i++)
+    {
+        if (SUCCEEDED( WindowsCompareStringOrdinal( impl->entries[i].key, key, &order ) ) && !order)
+            return &impl->entries[i];
+    }
+    return NULL;
+}
+
+static HRESULT WINAPI map_QueryInterface( IMap_HSTRING_IInspectable *iface, REFIID iid, void **out )
+{
+    return property_set_QueryInterface( &impl_from_IMap( iface )->IPropertySet_iface, iid, out );
+}
+static ULONG WINAPI map_AddRef( IMap_HSTRING_IInspectable *iface )
+{
+    return property_set_AddRef( &impl_from_IMap( iface )->IPropertySet_iface );
+}
+static ULONG WINAPI map_Release( IMap_HSTRING_IInspectable *iface )
+{
+    return property_set_Release( &impl_from_IMap( iface )->IPropertySet_iface );
+}
+static HRESULT WINAPI map_GetIids( IMap_HSTRING_IInspectable *iface, ULONG *c, IID **v )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI map_GetRuntimeClassName( IMap_HSTRING_IInspectable *iface, HSTRING *n )
+{
+    return property_set_GetRuntimeClassName( &impl_from_IMap( iface )->IPropertySet_iface, n );
+}
+static HRESULT WINAPI map_GetTrustLevel( IMap_HSTRING_IInspectable *iface, TrustLevel *t )
+{
+    *t = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI map_Lookup( IMap_HSTRING_IInspectable *iface, HSTRING key, IInspectable **value )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    struct entry *e;
+
+    TRACE( "iface %p, key %s, value %p.\n", iface, debugstr_hstring( key ), value );
+
+    if (!(e = find_entry( impl, key )))
+    {
+        *value = NULL;
+        return E_BOUNDS;
+    }
+    *value = e->value;
+    if (*value) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_get_Size( IMap_HSTRING_IInspectable *iface, unsigned int *size )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    TRACE( "iface %p, size %p.\n", iface, size );
+    *size = impl->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI map_HasKey( IMap_HSTRING_IInspectable *iface, HSTRING key, boolean *found )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    TRACE( "iface %p, key %s, found %p.\n", iface, debugstr_hstring( key ), found );
+    *found = !!find_entry( impl, key );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_GetView( IMap_HSTRING_IInspectable *iface, IMapView_HSTRING_IInspectable **view )
+{
+    FIXME( "iface %p, view %p stub!\n", iface, view );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI map_Insert( IMap_HSTRING_IInspectable *iface, HSTRING key,
+        IInspectable *value, boolean *replaced )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    struct entry *e;
+    HRESULT hr;
+
+    TRACE( "iface %p, key %s, value %p, replaced %p.\n", iface, debugstr_hstring( key ), value, replaced );
+
+    if ((e = find_entry( impl, key )))
+    {
+        if (value) IInspectable_AddRef( value );
+        if (e->value) IInspectable_Release( e->value );
+        e->value = value;
+        *replaced = TRUE;
+        return S_OK;
+    }
+
+    if (impl->count == impl->capacity)
+    {
+        unsigned int cap = impl->capacity ? impl->capacity * 2 : 4;
+        struct entry *grown = realloc( impl->entries, cap * sizeof(*grown) );
+        if (!grown) return E_OUTOFMEMORY;
+        impl->entries = grown;
+        impl->capacity = cap;
+    }
+
+    e = &impl->entries[impl->count];
+    if (FAILED( hr = WindowsDuplicateString( key, &e->key ) )) return hr;
+    e->value = value;
+    if (value) IInspectable_AddRef( value );
+    impl->count++;
+    *replaced = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI map_Remove( IMap_HSTRING_IInspectable *iface, HSTRING key )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    struct entry *e;
+    unsigned int idx;
+
+    TRACE( "iface %p, key %s.\n", iface, debugstr_hstring( key ) );
+
+    if (!(e = find_entry( impl, key ))) return E_BOUNDS;
+    idx = e - impl->entries;
+    WindowsDeleteString( e->key );
+    if (e->value) IInspectable_Release( e->value );
+    memmove( &impl->entries[idx], &impl->entries[idx + 1],
+             (impl->count - idx - 1) * sizeof(*impl->entries) );
+    impl->count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI map_Clear( IMap_HSTRING_IInspectable *iface )
+{
+    struct property_set *impl = impl_from_IMap( iface );
+    unsigned int i;
+    TRACE( "iface %p.\n", iface );
+    for (i = 0; i < impl->count; i++)
+    {
+        WindowsDeleteString( impl->entries[i].key );
+        if (impl->entries[i].value) IInspectable_Release( impl->entries[i].value );
+    }
