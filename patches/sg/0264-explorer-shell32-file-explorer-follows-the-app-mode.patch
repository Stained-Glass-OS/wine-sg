+/* take the app mode's palette (at creation, and when the mode changes):
+ * the title bar (DWMWA_USE_IMMERSIVE_DARK_MODE), the controls that keep
+ * colours of their own, and a repaint of everything */
+static void fe_apply_mode(void)
+{
+    static HRESULT (WINAPI *set_attr)(HWND, DWORD, const void *, DWORD);
+    static BOOL looked;
+    BOOL dark = fe_apps_dark();
+
+    fe_pal = dark ? &fe_dark : &fe_light;
+    if (!looked)
+    {
+        HMODULE dwm = LoadLibraryW( L"dwmapi.dll" );
+        looked = TRUE;
+        if (dwm) set_attr = (void *)GetProcAddress( dwm, "DwmSetWindowAttribute" );
+    }
+    if (!fe.hwnd) return;
+    if (set_attr) set_attr( fe.hwnd, 20 /* DWMWA_USE_IMMERSIVE_DARK_MODE */, &dark, sizeof(dark) );
+    if (fe.tree)
+    {
+        SendMessageW( fe.tree, TVM_SETBKCOLOR, 0, C_BG );
+        SendMessageW( fe.tree, TVM_SETTEXTCOLOR, 0, C_TEXT );
+    }
+    if (fe.results)
+    {
+        SendMessageW( fe.results, LVM_SETBKCOLOR, 0, C_BG );
+        SendMessageW( fe.results, LVM_SETTEXTBKCOLOR, 0, C_BG );
+        SendMessageW( fe.results, LVM_SETTEXTCOLOR, 0, C_TEXT );
+    }
+    RedrawWindow( fe.hwnd, NULL, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+}
+
 static LRESULT CALLBACK frame_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
 {
     switch (msg)
     {
+    case WM_SETTINGCHANGE:
+        if (lp && !wcscmp( (const WCHAR *)lp, L"ImmersiveColorSet" )) fe_apply_mode();
+        break;
+    case WM_SYSCOLORCHANGE:
+    case WM_THEMECHANGED:
+        /* the switch's system colours arrive after ImmersiveColorSet: the
+         * common controls inside (the folder view's list, the header) hear of
+         * it only from their parent, as on Windows -- DefWindowProc does not
+         * pass it on -- then everything repaints in them */
+        EnumChildWindows( hwnd, fe_forward_proc, msg );
+        fe_apply_mode();
+        break;
     case WM_SIZE:
         layout();
         return 0;
