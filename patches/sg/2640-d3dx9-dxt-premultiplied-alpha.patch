From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9: DXT2 and DXT4 surfaces hold colours multiplied by their alpha

The colours of DXT2 and DXT4 (premultiplied alpha) were read and written as if they were
DXT3 and DXT5. As the Wine tests record from Windows:

 - Reading a DXT2/DXT4 block undoes the multiplication: colours are divided by the alpha
   (computed in float, truncated, 255 for alpha 255 left as it is, and 0 for alpha 0).
 - Writing multiplies the colours by the alpha before the block is compressed, so a
   transparent pixel keeps no colour. The destination pixels outside the written rectangle,
   decompressed to be recompressed, are un-multiplied first.
 - Removed the todo marks for the 16 pixels of the test blocks and the compress check.
---
--- a/dlls/d3dx9_36/surface.c
+++ b/dlls/d3dx9_36/surface.c
@@ -2515,6 +2515,47 @@ void point_filter_argb_pixels(const BYTE *src, UINT src_row_pitch, UINT src_slic
     }
 }
 
+/* DXT2 and DXT4 hold colours that were multiplied by their alpha value: undo it on a texel */
+static void dxt_unpremultiply_texel(BYTE *texel)
+{
+    unsigned int i;
+
+#ifdef SG_MUTANT_D3DXDXT_NO_PMA
+    return;
+#endif
+    /* texels are A8B8G8R8: R, G, B, A in memory */
+    if (!texel[3])
+    {
+        texel[0] = texel[1] = texel[2] = 0;
+        return;
+    }
+    if (texel[3] == 255)
+        return;
+    for (i = 0; i < 3; ++i)
+    {
+        /* the order of the float operations matters for the last bit that the truncation sees */
+        float c = ((float)texel[i] / 255.0f) / ((float)texel[3] / 255.0f) / (1.0f / 255.0f);
+
+        texel[i] = c >= 255.0f ? 255 : (BYTE)c;
+    }
+}
+
+static void dxt_premultiply_texel(BYTE *texel)
+{
+    unsigned int i;
+
+#ifdef SG_MUTANT_D3DXDXT_NO_PMA
+    return;
+#endif
+    for (i = 0; i < 3; ++i)
+        texel[i] = (texel[i] * texel[3] + 127) / 255;
+}
+
+static BOOL dxt_is_premultiplied(enum d3dx_pixel_format_id format)
+{
+    return format == D3DX_PIXEL_FORMAT_DXT2_UNORM || format == D3DX_PIXEL_FORMAT_DXT4_UNORM;
+}
+
 static HRESULT d3dx_pixels_decompress(struct d3dx_pixels *pixels, const struct pixel_format_desc *desc,
         BOOL is_dst, void **out_memory, uint32_t *out_row_pitch, uint32_t *out_slice_pitch,
         const struct pixel_format_desc **out_desc)
@@ -2583,10 +2624,18 @@ static HRESULT d3dx_pixels_decompress(struct d3dx_pixels *pixels, const struct p
                 const POINT pt = { x, y };
 
                 if (!is_dst)
+                {
                     fetch_dxt_texel(tmp_pitch, slice_data, x + pixels->unaligned_rect.left,
                             y + pixels->unaligned_rect.top, ptr);
+                    if (dxt_is_premultiplied(desc->format))
+                        dxt_unpremultiply_texel(ptr);
+                }
                 else if (!PtInRect(&pixels->unaligned_rect, pt))
+                {
                     fetch_dxt_texel(tmp_pitch, slice_data, x, y, ptr);
+                    if (dxt_is_premultiplied(desc->format))
+                        dxt_unpremultiply_texel(ptr);
+                }
                 ptr += uncompressed_desc->bytes_per_pixel;
             }
         }
@@ -2773,6 +2822,13 @@ HRESULT d3dx_load_pixels_from_pixels(struct d3dx_pixels *dst_pixels,
                 BYTE *uncompressed_mem_slice = (BYTE *)uncompressed_mem + (i * uncompressed_slice_pitch);
                 BYTE *dst_memory_slice = ((BYTE *)dst_pixels->data) + (i * dst_pixels->slice_pitch);
 
+                if (dxt_is_premultiplied(dst_desc->format))
+                {
+                    uint32_t px;
+
+                    for (px = 0; px < uncompressed_slice_pitch / uncompressed_desc->bytes_per_pixel; ++px)
+                        dxt_premultiply_texel(uncompressed_mem_slice + px * uncompressed_desc->bytes_per_pixel);
+                }
                 tx_compress_dxtn(4, dst_size_aligned.width, dst_size_aligned.height, uncompressed_mem_slice, gl_format,
                         dst_memory_slice, dst_pixels->row_pitch);
             }
--- a/dlls/d3dx9_36/tests/surface.c
+++ b/dlls/d3dx9_36/tests/surface.c
@@ -1487,7 +1487,7 @@ static void test_dxt_premultiplied_alpha(IDirect3DDevice9 *device)
             {
                 const uint32_t expected_pixel = !(x & 0x01) ? 0xffffffff : 0x00000000;
 
-                check_readback_pixel_4bpp(&surface_rb, x, y, expected_pixel, !expected_pixel);
+                check_readback_pixel_4bpp(&surface_rb, x, y, expected_pixel, FALSE);
             }
         }
         release_surface_readback(&surface_rb);
@@ -1515,9 +1515,7 @@ static void test_dxt_premultiplied_alpha(IDirect3DDevice9 *device)
             for (x = 0; x < 4; ++x)
             {
                 const uint32_t expected_pixel = dxt_pma_decompressed_expected[(y * 4) + x];
-                const BOOL todo = ((expected_pixel >> 24) & 0xff) != 0xff;
-
-                todo_wine_if(todo) check_pixel_4bpp(&lock_rect, x, y, expected_pixel);
+                check_pixel_4bpp(&lock_rect, x, y, expected_pixel);
             }
         }
         IDirect3DSurface9_UnlockRect(decomp_surf);
