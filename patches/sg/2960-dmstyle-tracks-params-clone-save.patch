+#define DMUS_PCHANNEL_MUTE 0xffffffff
+
+struct mute_entry
+{
+    struct list entry;
+    DMUS_IO_MUTE mute;
+};
+
 typedef struct IDirectMusicMuteTrack {
     IDirectMusicTrack8 IDirectMusicTrack8_iface;
     struct dmobject dmobj;  /* IPersistStream only */
     LONG ref;
