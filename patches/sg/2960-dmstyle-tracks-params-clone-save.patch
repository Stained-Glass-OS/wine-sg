+static void command_track_clear(IDirectMusicCommandTrack *This)
+{
+    struct command_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &This->Commands, struct command_entry, entry)
+    {
+        list_remove(&entry->entry);
+        free(entry);
+    }
+}
+
+/* inserts a copy of the command, after the commands which are not later than it; a command
+ * at the same time replaces the previous one when 'replace' is set */
+static HRESULT command_track_insert(IDirectMusicCommandTrack *This, const DMUS_IO_COMMAND *command,
+        BOOL replace)
+{
+    struct command_entry *entry, *new_entry;
+
+    if (replace)
+    {
+        LIST_FOR_EACH_ENTRY(entry, &This->Commands, struct command_entry, entry)
+        {
+            if (entry->command.mtTime != command->mtTime) continue;
+            entry->command = *command;
+            return S_OK;
+        }
+    }
+
+    if (!(new_entry = calloc(1, sizeof(*new_entry)))) return E_OUTOFMEMORY;
+    new_entry->command = *command;
+
+    LIST_FOR_EACH_ENTRY_REV(entry, &This->Commands, struct command_entry, entry)
+    {
+        if (entry->command.mtTime > command->mtTime) continue;
+        list_add_after(&entry->entry, &new_entry->entry);
+        return S_OK;
+    }
+    list_add_head(&This->Commands, &new_entry->entry);
+    return S_OK;
+}
