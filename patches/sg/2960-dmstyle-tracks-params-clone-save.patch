+static void style_track_clear(IDirectMusicStyleTrack *This)
+{
+    struct style_item *item, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(item, next, &This->Items, struct style_item, entry)
+    {
+        list_remove(&item->entry);
+        IDirectMusicStyle8_Release(item->dmstyle);
+        free(item);
+    }
+}
+
+/* Adds a reference to the style at the time, after the items which are not later than it;
+ * an item at the same time is replaced when 'replace' is set. */
+static HRESULT style_track_insert(IDirectMusicStyleTrack *This, DWORD timestamp,
+        IDirectMusicStyle8 *style, BOOL replace)
+{
+    struct style_item *item, *new_item;
+
+    if (replace)
+    {
+        LIST_FOR_EACH_ENTRY(item, &This->Items, struct style_item, entry)
+        {
+            if (item->timestamp != timestamp) continue;
+            IDirectMusicStyle8_AddRef(style);
+            IDirectMusicStyle8_Release(item->dmstyle);
+            item->dmstyle = style;
+            return S_OK;
+        }
+    }
+
+    if (!(new_item = calloc(1, sizeof(*new_item)))) return E_OUTOFMEMORY;
+    new_item->timestamp = timestamp;
+    new_item->dmstyle = style;
+    IDirectMusicStyle8_AddRef(style);
+
+    LIST_FOR_EACH_ENTRY_REV(item, &This->Items, struct style_item, entry)
+    {
+        if (item->timestamp > timestamp) continue;
+        list_add_after(&item->entry, &new_item->entry);
+        return S_OK;
+    }
+    list_add_head(&This->Items, &new_item->entry);
+    return S_OK;
+}
