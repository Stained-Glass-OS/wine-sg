 }  IDirectMusicChordTrack;
 
 /* IDirectMusicChordTrack IDirectMusicTrack8 part: */
@@ -40,6 +50,47 @@ static inline IDirectMusicChordTrack *impl_from_IDirectMusicTrack8(IDirectMusicT
     return CONTAINING_RECORD(iface, IDirectMusicChordTrack, IDirectMusicTrack8_iface);
 }
 
+static void chord_track_clear(IDirectMusicChordTrack *This)
+{
+    struct chord_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &This->chords, struct chord_entry, entry)
+    {
+        list_remove(&entry->entry);
+        free(entry);
+    }
+}
+
+/* adds the chord after those which are not later than it, a chord at the same time replaces
+ * the previous one when 'replace' is set; the entry is copied */
+static HRESULT chord_track_insert(IDirectMusicChordTrack *This, const struct chord_entry *chord,
+        BOOL replace)
+{
+    struct chord_entry *entry, *new_entry;
+
+    if (replace)
+    {
+        LIST_FOR_EACH_ENTRY(entry, &This->chords, struct chord_entry, entry)
+        {
+            if (entry->chord.mtTime != chord->chord.mtTime) continue;
+            memcpy(&entry->chord, &chord->chord, sizeof(*chord) - offsetof(struct chord_entry, chord));
+            return S_OK;
+        }
+    }
+
+    if (!(new_entry = calloc(1, sizeof(*new_entry)))) return E_OUTOFMEMORY;
+    memcpy(&new_entry->chord, &chord->chord, sizeof(*chord) - offsetof(struct chord_entry, chord));
+
+    LIST_FOR_EACH_ENTRY_REV(entry, &This->chords, struct chord_entry, entry)
+    {
+        if (entry->chord.mtTime > chord->chord.mtTime) continue;
+        list_add_after(&entry->entry, &new_entry->entry);
+        return S_OK;
+    }
+    list_add_head(&This->chords, &new_entry->entry);
+    return S_OK;
+}
+
