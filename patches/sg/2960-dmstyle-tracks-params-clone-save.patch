+static void mute_track_clear(IDirectMusicMuteTrack *This)
+{
+    struct mute_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &This->mutes, struct mute_entry, entry)
+    {
+        list_remove(&entry->entry);
+        free(entry);
+    }
+}
+
+/* adds a copy of the item after those which are not later than it */
+static HRESULT mute_track_insert(IDirectMusicMuteTrack *This, const DMUS_IO_MUTE *mute)
+{
+    struct mute_entry *entry, *new_entry;
+
+    if (!(new_entry = calloc(1, sizeof(*new_entry)))) return E_OUTOFMEMORY;
+    new_entry->mute = *mute;
+
+    LIST_FOR_EACH_ENTRY_REV(entry, &This->mutes, struct mute_entry, entry)
+    {
+        if (entry->mute.mtTime > mute->mtTime) continue;
+        list_add_after(&entry->entry, &new_entry->entry);
+        return S_OK;
+    }
+    list_add_head(&This->mutes, &new_entry->entry);
+    return S_OK;
+}
