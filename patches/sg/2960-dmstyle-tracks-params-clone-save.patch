+/*****************************************************************************
+ * DirectMusicSection: the object of the sections of the first DirectMusic versions. It is an
+ * IDirectMusicObject and IPersistStream which keeps a descriptor; the section files themselves
+ * (a format which was replaced by the segment form) are not read.
+ */
+struct section
+{
+    IUnknown IUnknown_iface;
+    struct dmobject dmobj;
+    LONG ref;
+};
+
+static inline struct section *section_from_IUnknown(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct section, IUnknown_iface);
+}
+
+static HRESULT WINAPI section_QueryInterface(IUnknown *iface, REFIID riid, void **ret_iface)
+{
+    struct section *This = section_from_IUnknown(iface);
+
+    TRACE("(%p, %s, %p)\n", This, debugstr_dmguid(riid), ret_iface);
+
+    *ret_iface = NULL;
+
+    if (IsEqualIID(riid, &IID_IUnknown))
+        *ret_iface = iface;
+    else if (IsEqualIID(riid, &IID_IDirectMusicObject))
+        *ret_iface = &This->dmobj.IDirectMusicObject_iface;
+    else if (IsEqualIID(riid, &IID_IPersistStream))
+        *ret_iface = &This->dmobj.IPersistStream_iface;
+    else {
+        WARN("(%p, %s, %p): not found\n", This, debugstr_dmguid(riid), ret_iface);
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*ret_iface);
+    return S_OK;
+}
+
+static ULONG WINAPI section_AddRef(IUnknown *iface)
+{
+    struct section *This = section_from_IUnknown(iface);
+    LONG ref = InterlockedIncrement(&This->ref);
+
+    TRACE("(%p) ref=%ld\n", This, ref);
+
+    return ref;
+}
+
+static ULONG WINAPI section_Release(IUnknown *iface)
+{
+    struct section *This = section_from_IUnknown(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    TRACE("(%p) ref=%ld\n", This, ref);
+
+    if (!ref) free(This);
+
+    return ref;
+}
+
+static const IUnknownVtbl section_vtbl = {
+    section_QueryInterface,
+    section_AddRef,
+    section_Release
+};
+
+static HRESULT WINAPI section_IDirectMusicObject_ParseDescriptor(IDirectMusicObject *iface,
