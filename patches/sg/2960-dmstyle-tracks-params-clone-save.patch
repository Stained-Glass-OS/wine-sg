+/* Track helpers shared by the style, command, chord, mute, motif and audition tracks */
+
+HRESULT track_init_play(IDirectMusicPerformance *performance, void **state_data)
+{
+    struct track_play_state *state;
+
+    if (!state_data) return E_POINTER;
+    if (!(state = calloc(1, sizeof(*state)))) return E_OUTOFMEMORY;
+    state->performance = performance;
+    *state_data = state;
+    return S_OK;
+}
+
+HRESULT track_end_play(void *state_data)
+{
+    free(state_data);
+    return S_OK;
+}
+
+HRESULT track_play_ex(IDirectMusicTrack *track, void *state_data, REFERENCE_TIME start_time,
+        REFERENCE_TIME end_time, REFERENCE_TIME offset, DWORD flags,
+        IDirectMusicPerformance *performance, IDirectMusicSegmentState *segment_state,
+        DWORD track_id)
+{
+    MUSIC_TIME music_start, music_end, music_offset;
+    HRESULT hr;
+
+    if (!performance) return E_POINTER;
+
+    /* the segment starts at 'offset', start_time and end_time are relative to it */
+    if (FAILED(hr = IDirectMusicPerformance_ReferenceToMusicTime(performance, offset, &music_offset))
+            || FAILED(hr = IDirectMusicPerformance_ReferenceToMusicTime(performance,
+                    offset + start_time, &music_start))
+            || FAILED(hr = IDirectMusicPerformance_ReferenceToMusicTime(performance,
+                    offset + end_time, &music_end)))
+        return hr;
+
+    return IDirectMusicTrack_Play(track, state_data, music_start - music_offset,
+            music_end - music_offset, music_offset, flags, performance, segment_state, track_id);
+}
+
+/* The extended parameter methods take reference times: they are converted with the performance
+ * which InitPlay stored in the play state. */
+static HRESULT track_get_music_time(void *state_data, REFERENCE_TIME time, MUSIC_TIME *music_time)
+{
+    struct track_play_state *state = state_data;
+
+    if (!state || !state->performance) return E_POINTER;
+#ifdef SG_MUTANT_PARAMEX
+    *music_time = time;
+    return S_OK;
+#endif
+    return IDirectMusicPerformance_ReferenceToMusicTime(state->performance, time, music_time);
+}
+
+HRESULT track_get_param_ex(IDirectMusicTrack8 *track, REFGUID type, REFERENCE_TIME time,
+        REFERENCE_TIME *next, void *param, void *state_data, DWORD flags)
+{
+    MUSIC_TIME music_time, next_time = 0;
+    HRESULT hr;
+
+    if (!type) return E_POINTER;
+    if (FAILED(hr = track_get_music_time(state_data, time, &music_time))) return hr;
+    if (FAILED(hr = IDirectMusicTrack8_GetParam(track, type, music_time, &next_time, param)))
+        return hr;
+
+    if (next)
+    {
+        REFERENCE_TIME next_ref = 0;
+        if (next_time)
+            IDirectMusicPerformance_MusicToReferenceTime(
+                    ((struct track_play_state *)state_data)->performance, music_time + next_time,
+                    &next_ref);
+        *next = next_ref ? next_ref - time : 0;
+    }
+    return hr;
+}
+
+HRESULT track_set_param_ex(IDirectMusicTrack8 *track, REFGUID type, REFERENCE_TIME time,
+        void *param, void *state_data, DWORD flags)
+{
+    MUSIC_TIME music_time;
+    HRESULT hr;
+
+    if (!type) return E_POINTER;
+    if (FAILED(hr = track_get_music_time(state_data, time, &music_time))) return hr;
+    return IDirectMusicTrack8_SetParam(track, type, music_time, param);
+}
+
+HRESULT track_send_notification(IDirectMusicPerformance *performance, const GUID *type,
+        MUSIC_TIME time, DWORD track_id)
+{
+    DMUS_NOTIFICATION_PMSG *msg;
+    IDirectMusicGraph *graph;
+    HRESULT hr;
+
+    if (FAILED(hr = IDirectMusicPerformance_QueryInterface(performance, &IID_IDirectMusicGraph,
+            (void **)&graph)))
+        return hr;
+
+    if (SUCCEEDED(hr = IDirectMusicPerformance_AllocPMsg(performance, sizeof(*msg),
+            (DMUS_PMSG **)&msg)))
+    {
+        msg->mtTime = time;
+        msg->dwFlags = DMUS_PMSGF_MUSICTIME;
+        msg->dwVirtualTrackID = track_id;
+        msg->dwType = DMUS_PMSGT_NOTIFICATION;
+        msg->dwGroupID = -1;
+        msg->guidNotificationType = *type;
+
+        if (FAILED(hr = IDirectMusicGraph_StampPMsg(graph, (DMUS_PMSG *)msg))
+                || FAILED(hr = IDirectMusicPerformance_SendPMsg(performance, (DMUS_PMSG *)msg)))
+            IDirectMusicPerformance_FreePMsg(performance, (DMUS_PMSG *)msg);
+    }
+
+    IDirectMusicGraph_Release(graph);
+    return hr;
+}
+
+/* Joining accepts the tracks of the same class only */
+HRESULT track_same_class(IDirectMusicTrack *track, IDirectMusicTrack8 *iface,
+        IDirectMusicTrack8 **ret)
+{
+    *ret = NULL;
+    if (FAILED(IDirectMusicTrack_QueryInterface(track, &IID_IDirectMusicTrack8, (void **)ret)))
+        return DMUS_E_TYPE_UNSUPPORTED;
+    if ((*ret)->lpVtbl != iface->lpVtbl)
+    {
+        IDirectMusicTrack8_Release(*ret);
+        *ret = NULL;
+        return DMUS_E_TYPE_UNSUPPORTED;
+    }
+    return S_OK;
+}
