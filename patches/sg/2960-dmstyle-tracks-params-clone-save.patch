+/* Copies the chords of [start_time, end_time) of this track to the new track, moved by
+ * join_offset - start_time; the chord in effect at start_time comes first. */
+static HRESULT chord_track_copy(IDirectMusicChordTrack *This, MUSIC_TIME start_time,
+        MUSIC_TIME end_time, MUSIC_TIME join_offset, IDirectMusicChordTrack *dest)
+{
+    struct chord_entry *entry, *before = NULL, copy;
+    BOOL at_start = FALSE;
+    HRESULT hr;
+
+    LIST_FOR_EACH_ENTRY(entry, &This->chords, struct chord_entry, entry)
+    {
+        if (entry->chord.mtTime < start_time) before = entry;
+        if (entry->chord.mtTime == start_time) at_start = TRUE;
+    }
+    if (before && start_time > 0 && !at_start)
+    {
+        copy = *before;
+        copy.chord.mtTime = join_offset;
+        if (FAILED(hr = chord_track_insert(dest, &copy, FALSE))) return hr;
+    }
+
+    LIST_FOR_EACH_ENTRY(entry, &This->chords, struct chord_entry, entry)
+    {
+        if (entry->chord.mtTime < start_time || entry->chord.mtTime >= end_time) continue;
+        copy = *entry;
+#ifdef SG_MUTANT_CLONE_SHIFT
+        copy.chord.mtTime += join_offset;
+#else
+        copy.chord.mtTime += join_offset - start_time;
+#endif
+        if (FAILED(hr = chord_track_insert(dest, &copy, FALSE))) return hr;
+    }
+
+    return S_OK;
 }
 
