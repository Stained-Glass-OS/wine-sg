From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: an owned window with WS_EX_APPWINDOW has a taskbar button (7008)

As on Windows, WS_EX_APPWINDOW forces a visible top-level window onto the
taskbar, owned or not. Delphi and Lazarus programs' main forms are owned
by a hidden application window and ask for their button that way: the
Lazarus IDE had none. The taskbar, Alt+Tab/Task View and the Win+number
keys follow the same rule.
---
diff --git a/programs/explorer/shellkeys.c b/programs/explorer/shellkeys.c
index 73195a5..29ecc89 100644
--- a/programs/explorer/shellkeys.c
+++ b/programs/explorer/shellkeys.c
@@ -76,7 +76,8 @@ static BOOL is_app( HWND hwnd )
 {
     DWORD pid;
     LONG ex = GetWindowLongW( hwnd, GWL_EXSTYLE );
-    if (!IsWindowVisible( hwnd ) || GetWindow( hwnd, GW_OWNER )) return FALSE;
+    if (!IsWindowVisible( hwnd )) return FALSE;
+    if (GetWindow( hwnd, GW_OWNER ) && !(ex & WS_EX_APPWINDOW)) return FALSE;   /* wine-sg 7008 */
     if (!GetWindowThreadProcessId( hwnd, &pid )) return FALSE;
     if (pid == GetCurrentProcessId() && !is_linux_frame( hwnd )) return FALSE;
     if ((ex & WS_EX_TOOLWINDOW) && !(ex & WS_EX_APPWINDOW)) return FALSE;
diff --git a/programs/explorer/systray.c b/programs/explorer/systray.c
index 271b927..bc9addf 100644
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1433,7 +1433,14 @@ static void sync_taskbar_buttons(void)
 #ifndef SG_MUTANT_CHILD_BUTTON
                        (win->elevated || GetAncestor( win->hwnd, GA_PARENT ) == GetDesktopWindow()) &&
 #endif
+#ifndef SG_MUTANT_OWNED_APPWINDOW
+                       /* Stained Glass OS (wine-sg 7008): an owned window with WS_EX_APPWINDOW
+                        * has a button too, as on Windows (Delphi and Lazarus programs: their
+                        * main form is owned by a hidden application window) */
+                       (!GetWindow( win->hwnd, GW_OWNER ) || (GetWindowLongW( win->hwnd, GWL_EXSTYLE ) & WS_EX_APPWINDOW)) &&
+#else
                        !GetWindow( win->hwnd, GW_OWNER ) &&
+#endif
                        ((GetWindowLongW( win->hwnd, GWL_EXSTYLE ) & (WS_EX_TOOLWINDOW | WS_EX_APPWINDOW)) != WS_EX_TOOLWINDOW) &&
                        (win->elevated || vd_on_current( win->hwnd ));
         if (win->visible) count++;
@@ -3605,7 +3612,8 @@ static BOOL CALLBACK sg_elevated_window( HWND hwnd, LPARAM lparam )
 
     /* its desktop is not ours: IsWindowVisible calls every window on it
      * hidden, so no elevated window had a button; its style says */
-    if (!(GetWindowLongW( hwnd, GWL_STYLE ) & WS_VISIBLE) || GetWindow( hwnd, GW_OWNER ) ||
+    if (!(GetWindowLongW( hwnd, GWL_STYLE ) & WS_VISIBLE) ||
+        (GetWindow( hwnd, GW_OWNER ) && !(GetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_APPWINDOW)) ||
         (GetWindowLongW( hwnd, GWL_EXSTYLE ) & (WS_EX_TOOLWINDOW | WS_EX_APPWINDOW)) == WS_EX_TOOLWINDOW)
         return TRUE;
     if (!(win = find_taskbar_button( hwnd )))
diff --git a/programs/explorer/vdesktop.c b/programs/explorer/vdesktop.c
index d87962e..818cea3 100644
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -283,7 +283,8 @@ static BOOL is_app_window( HWND hwnd )
     LONG ex = GetWindowLongW( hwnd, GWL_EXSTYLE );
 
     if (GetAncestor( hwnd, GA_PARENT ) != GetDesktopWindow()) return FALSE;
-    if (GetWindow( hwnd, GW_OWNER )) return FALSE;
+    /* an owned window is one only with WS_EX_APPWINDOW, as the taskbar has it (wine-sg 7008) */
+    if (GetWindow( hwnd, GW_OWNER ) && !(ex & WS_EX_APPWINDOW)) return FALSE;
     /* explorer's own windows are the shell's -- but for the frames that hold
      * Linux programs' windows (wine-sg 0762): windows like any program's, on
      * one desktop */
