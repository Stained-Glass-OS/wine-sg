From: Stained Glass OS <ke7oxh@gmail.com>
dwrite: font collections and fallbacks and the factory's reference count

Only the system and EUDC collections take a reference of the factory; a
custom collection keeps the factory's memory alive without counting, and a
font fallback relies on its system collection's reference. Removes three
todo_wine marks of the refcount tests.
---
--- a/dlls/dwrite/analyzer.c
+++ b/dlls/dwrite/analyzer.c
@@ -2638,7 +2638,10 @@ static ULONG WINAPI customfontfallback_Release(IDWriteFontFallback1 *iface)
 
     if (!refcount)
     {
+        /* the system collection holds the factory */
+#ifdef SG_MUTANT_DWFALLBACK_FACTORY_REF
         IDWriteFactory7_Release(fallback->factory);
+#endif
         if (fallback->systemcollection)
             IDWriteFontCollection_Release(fallback->systemcollection);
         release_fallback_data(&fallback->data);
@@ -2895,7 +2898,9 @@ static HRESULT fallbackbuilder_create_fallback(struct dwrite_fontfallback_builde
     fallback->IDWriteFontFallback1_iface.lpVtbl = &customfontfallbackvtbl;
     fallback->refcount = 1;
     fallback->factory = builder->factory;
+#ifdef SG_MUTANT_DWFALLBACK_FACTORY_REF
     IDWriteFactory7_AddRef(fallback->factory);
+#endif
     if (FAILED(hr = IDWriteFactory_GetSystemFontCollection((IDWriteFactory *)fallback->factory,
             &fallback->systemcollection, FALSE)))
     {
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -378,6 +378,7 @@ struct dwrite_fontcollection
     size_t size;
     size_t count;
     HANDLE expiration_event;   /* Stained Glass OS 1692 */
+    BOOL weak_factory;         /* the collection does not count as a reference of the factory */
 };
 
 struct dwrite_fontfamily
@@ -3475,12 +3476,19 @@ static ULONG WINAPI dwritefontcollection_Release(IDWriteFontCollection3 *iface)
 
     if (!refcount)
     {
-        factory_detach_fontcollection(collection->factory, iface);
+        IDWriteFactory7 *factory = collection->factory;
+        BOOL weak = collection->weak_factory;
+
+        factory_detach_fontcollection(factory, iface);
         for (i = 0; i < collection->count; ++i)
             release_fontfamily_data(collection->family_data[i]);
         free(collection->family_data);
         if (collection->expiration_event) CloseHandle(collection->expiration_event);
         free(collection);
+        if (weak)
+            factory_release_internal_ref(factory);
+        else
+            IDWriteFactory7_Release(factory);
     }
 
     return refcount;
@@ -3825,12 +3833,24 @@ static HRESULT fontcollection_add_family(struct dwrite_fontcollection *collectio
 }
 
 static HRESULT init_font_collection(struct dwrite_fontcollection *collection, IDWriteFactory7 *factory,
-        DWRITE_FONT_FAMILY_MODEL family_model, BOOL is_system)
+        DWRITE_FONT_FAMILY_MODEL family_model, BOOL is_system, BOOL strong_factory)
 {
     collection->IDWriteFontCollection3_iface.lpVtbl = is_system ? &systemfontcollectionvtbl : &fontcollectionvtbl;
     collection->refcount = 1;
     collection->factory = factory;
-    IDWriteFactory7_AddRef(collection->factory);
+    /* only the system and EUDC collections take a reference of the factory */
+#ifdef SG_MUTANT_DWCOLLECTION_FACTORY_REF
+    strong_factory = TRUE;
+#endif
+    if (strong_factory)
+    {
+        IDWriteFactory7_AddRef(collection->factory);
+    }
+    else
+    {
+        factory_add_internal_ref(collection->factory);
+        collection->weak_factory = TRUE;
+    }
     collection->family_model = family_model;
 
     return S_OK;
@@ -4999,7 +5019,7 @@ HRESULT create_font_collection(IDWriteFactory7 *factory, IDWriteFontFileEnumerat
     if (!(collection = calloc(1, sizeof(*collection))))
         return E_OUTOFMEMORY;
 
-    hr = init_font_collection(collection, factory, DWRITE_FONT_FAMILY_MODEL_WEIGHT_STRETCH_STYLE, is_system);
+    hr = init_font_collection(collection, factory, DWRITE_FONT_FAMILY_MODEL_WEIGHT_STRETCH_STYLE, is_system, is_system);
     if (FAILED(hr))
     {
         free(collection);
@@ -5221,7 +5241,7 @@ HRESULT create_font_collection_from_set(IDWriteFactory7 *factory, IDWriteFontSet
     if (!(collection = calloc(1, sizeof(*collection))))
         return E_OUTOFMEMORY;
 
-    if (FAILED(hr = init_font_collection(collection, factory, family_model, FALSE)))
+    if (FAILED(hr = init_font_collection(collection, factory, family_model, FALSE, FALSE)))
     {
         free(collection);
         return hr;
@@ -5607,7 +5627,7 @@ HRESULT get_eudc_fontcollection(IDWriteFactory7 *factory, IDWriteFontCollection3
     if (!(collection = calloc(1, sizeof(*collection))))
