From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cryptowinrt: CryptographicBuffer encodes hex and Base64 and copies bytes

Windows.Security.Cryptography.CryptographicBuffer answered E_NOTIMPL to
everything but GenerateRandomNumber. With the system identifier there
(0961), AnyDesk turns it into hex with EncodeToHexString and failed on
that instead ("Could not get system ID (0x80004001)").

Compare, GenerateRandom, CreateFromByteArray, CopyToByteArray,
EncodeToHexString (lower-case, as on Windows), DecodeFromHexString,
EncodeToBase64String and DecodeFromBase64String now work, on any
IBuffer that gives its bytes (IBufferByteAccess); the buffers made are
Windows.Storage.Streams.Buffer. ConvertStringToBinary and
ConvertBinaryToString remain stubs.

Test: test/sysid-gate.sh with test/sysid-probe.c (mutant
SG_MUTANT_NO_CRYPTOBUFFER).
---
--- a/dlls/cryptowinrt/main.c
+++ b/dlls/cryptowinrt/main.c
@@ -25,6 +25,7 @@
 #include "objbase.h"
 
 #include "bcrypt.h"
+#include "roapi.h"
 
 #define WIDL_using_Windows_Security_Cryptography
 #include "windows.security.cryptography.h"
@@ -135,20 +136,133 @@
 
 DEFINE_IINSPECTABLE(cryptobuffer_statics, ICryptographicBufferStatics, struct cryptobuffer_factory, IActivationFactory_iface);
 
+#ifndef SG_MUTANT_NO_CRYPTOBUFFER
+/* robuffer.h: an IBuffer's bytes */
+typedef struct IBufferByteAccess IBufferByteAccess;
+typedef struct IBufferByteAccessVtbl
+{
+    HRESULT (WINAPI *QueryInterface)( IBufferByteAccess *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( IBufferByteAccess *iface );
+    ULONG (WINAPI *Release)( IBufferByteAccess *iface );
+    HRESULT (WINAPI *Buffer)( IBufferByteAccess *iface, BYTE **value );
+} IBufferByteAccessVtbl;
+struct IBufferByteAccess { const IBufferByteAccessVtbl *lpVtbl; };
+static const GUID IID_IBufferByteAccess_cb = { 0x905a0fef, 0xbc53, 0x11df, { 0x8c, 0x49, 0x00, 0x1e, 0x4f, 0xc6, 0x86, 0xda } };
+
+/* the bytes of an IBuffer (none for no buffer); *access is released by the caller */
+static HRESULT buffer_bytes( IBuffer *buffer, BYTE **bytes, UINT32 *length, IBufferByteAccess **access )
+{
+    HRESULT hr;
+
+    *bytes = NULL;
+    *length = 0;
+    *access = NULL;
+    if (!buffer) return S_OK;
+    if (FAILED(hr = IBuffer_get_Length( buffer, length ))) return hr;
+    if (FAILED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess_cb, (void **)access ))) return hr;
+    if (FAILED(hr = (*access)->lpVtbl->Buffer( *access, bytes )))
+    {
+        (*access)->lpVtbl->Release( *access );
+        *access = NULL;
+    }
+    return hr;
+}
+
+/* a new Windows.Storage.Streams.Buffer holding a copy of the bytes */
+static HRESULT buffer_from_bytes( const BYTE *data, UINT32 length, IBuffer **out )
+{
+    static const WCHAR *name = L"Windows.Storage.Streams.Buffer";
+    IBufferByteAccess *access;
+    IBufferFactory *factory;
+    HSTRING class_name;
+    IBuffer *buffer;
+    BYTE *bytes;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = WindowsCreateString( name, wcslen( name ), &class_name ))) return hr;
+    hr = RoGetActivationFactory( class_name, &IID_IBufferFactory, (void **)&factory );
+    WindowsDeleteString( class_name );
+    if (FAILED(hr)) return hr;
+    hr = IBufferFactory_Create( factory, length, &buffer );
+    IBufferFactory_Release( factory );
+    if (FAILED(hr)) return hr;
+
+    if (SUCCEEDED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess_cb, (void **)&access )))
+    {
+        if (SUCCEEDED(hr = access->lpVtbl->Buffer( access, &bytes )))
+        {
+            if (length && data) memcpy( bytes, data, length );
+            else if (length) BCryptGenRandom( NULL, bytes, length, BCRYPT_USE_SYSTEM_PREFERRED_RNG );
+            hr = IBuffer_put_Length( buffer, length );
+        }
+        access->lpVtbl->Release( access );
+    }
+    if (FAILED(hr)) IBuffer_Release( buffer );
+    else *out = buffer;
+    return hr;
+}
+
+static int hex_value( WCHAR c )
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static const char base64_chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static int base64_value( WCHAR c )
+{
+    const char *p;
+    if (!c || c > 0x7f || !(p = strchr( base64_chars, (char)c ))) return -1;
+    return p - base64_chars;
+}
+#endif
+
 static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_Compare(
         ICryptographicBufferStatics *iface, IBuffer *object1, IBuffer *object2, boolean *is_equal)
 {
+#ifndef SG_MUTANT_NO_CRYPTOBUFFER
+    IBufferByteAccess *access1, *access2;
+    UINT32 length1, length2;
+    BYTE *bytes1, *bytes2;
+    HRESULT hr;
+
+    TRACE("iface %p, object1 %p, object2 %p, is_equal %p.\n", iface, object1, object2, is_equal);
+
+    if (!is_equal) return E_POINTER;
+    if (FAILED(hr = buffer_bytes(object1, &bytes1, &length1, &access1))) return hr;
+    if (FAILED(hr = buffer_bytes(object2, &bytes2, &length2, &access2)))
+    {
+        if (access1) access1->lpVtbl->Release(access1);
+        return hr;
+    }
+    *is_equal = length1 == length2 && (!length1 || !memcmp(bytes1, bytes2, length1));
+    if (access1) access1->lpVtbl->Release(access1);
+    if (access2) access2->lpVtbl->Release(access2);
+    return S_OK;
+#else
     FIXME("iface %p, object1 %p, object2 %p, is_equal %p stub!\n", iface, object1, object2, is_equal);
 
     return E_NOTIMPL;
+#endif
 }
 
 static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_GenerateRandom(
         ICryptographicBufferStatics *iface, UINT32 length, IBuffer **buffer)
 {
+#ifndef SG_MUTANT_NO_CRYPTOBUFFER
+    TRACE("iface %p, length %u, buffer %p.\n", iface, length, buffer);
+
+    if (!buffer) return E_POINTER;
+    return buffer_from_bytes(NULL, length, buffer);
+#else
     FIXME("iface %p, length %u, buffer %p stub!\n", iface, length, buffer);
 
     return E_NOTIMPL;
+#endif
 }
 
 static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_GenerateRandomNumber(
@@ -163,49 +277,198 @@
 static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_CreateFromByteArray(
         ICryptographicBufferStatics *iface, UINT32 value_size, BYTE *value, IBuffer **buffer)
 {
+#ifndef SG_MUTANT_NO_CRYPTOBUFFER
+    TRACE("iface %p, value_size %u, value %p, buffer %p.\n", iface, value_size, value, buffer);
+
+    if (!buffer) return E_POINTER;
+    if (value_size && !value) return E_POINTER;
+    return buffer_from_bytes(value, value_size, buffer);
+#else
     FIXME("iface %p, value_size %u, value %p, buffer %p stub!\n", iface, value_size, value, buffer);
 
     return E_NOTIMPL;
+#endif
 }
 
 static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_CopyToByteArray(
         ICryptographicBufferStatics *iface, IBuffer *buffer, UINT32 *value_size, BYTE **value)
 {
+#ifndef SG_MUTANT_NO_CRYPTOBUFFER
+    IBufferByteAccess *access;
+    UINT32 length;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE("iface %p, buffer %p, value_size %p, value %p.\n", iface, buffer, value_size, value);
+
+    if (!value_size || !value) return E_POINTER;
+    *value_size = 0;
+    *value = NULL;
+    if (FAILED(hr = buffer_bytes(buffer, &bytes, &length, &access))) return hr;
+    if (length)
+    {
+        if ((*value = CoTaskMemAlloc(length)))
+        {
+            memcpy(*value, bytes, length);
+            *value_size = length;
+        }
+        else hr = E_OUTOFMEMORY;
+    }
+    if (access) access->lpVtbl->Release(access);
+    return hr;
+#else
     FIXME("iface %p, buffer %p, value_size %p, value %p stub!\n", iface, buffer, value_size, value);
 
     return E_NOTIMPL;
+#endif
 }
 
 static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_DecodeFromHexString(
         ICryptographicBufferStatics *iface, HSTRING value, IBuffer **buffer)
 {
+#ifndef SG_MUTANT_NO_CRYPTOBUFFER
+    UINT32 length, i;
+    const WCHAR *text;
+    BYTE *data;
+    HRESULT hr;
+    int hi, lo;
+
+    TRACE("iface %p, value %s, buffer %p.\n", iface, debugstr_hstring(value), buffer);
+
+    if (!buffer) return E_POINTER;
+    text = WindowsGetStringRawBuffer(value, &length);
+    if (length % 2) return E_INVALIDARG;
+    if (!(data = malloc(length / 2 + 1))) return E_OUTOFMEMORY;
+    for (i = 0; i < length / 2; i++)
+    {
+        if ((hi = hex_value(text[2 * i])) < 0 || (lo = hex_value(text[2 * i + 1])) < 0)
+        {
+            free(data);
+            return E_INVALIDARG;
+        }
+        data[i] = hi << 4 | lo;
+    }
+    hr = buffer_from_bytes(data, length / 2, buffer);
+    free(data);
+    return hr;
+#else
     FIXME("iface %p, value %p, buffer %p stub!\n", iface, value, buffer);
 
     return E_NOTIMPL;
+#endif
 }
 
 static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_EncodeToHexString(
         ICryptographicBufferStatics *iface, IBuffer *buffer, HSTRING *value)
 {
+#ifndef SG_MUTANT_NO_CRYPTOBUFFER
+    static const WCHAR digits[] = L"0123456789abcdef";
+    IBufferByteAccess *access;
+    UINT32 length, i;
+    WCHAR *text;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE("iface %p, buffer %p, value %p.\n", iface, buffer, value);
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = buffer_bytes(buffer, &bytes, &length, &access))) return hr;
+    if ((text = malloc((2 * length + 1) * sizeof(WCHAR))))
+    {
+        for (i = 0; i < length; i++)
+        {
+            text[2 * i] = digits[bytes[i] >> 4];
+            text[2 * i + 1] = digits[bytes[i] & 0xf];
+        }
+        hr = WindowsCreateString(text, 2 * length, value);
+        free(text);
+    }
+    else hr = E_OUTOFMEMORY;
+    if (access) access->lpVtbl->Release(access);
+    return hr;
+#else
     FIXME("iface %p, buffer %p, value %p stub!\n", iface, buffer, value);
 
     return E_NOTIMPL;
+#endif
 }
 
 static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_DecodeFromBase64String(
         ICryptographicBufferStatics *iface, HSTRING value, IBuffer **buffer)
 {
+#ifndef SG_MUTANT_NO_CRYPTOBUFFER
+    UINT32 length, i, n = 0, bits = 0, acc = 0;
+    const WCHAR *text;
+    BYTE *data;
+    HRESULT hr;
+    int v;
+
+    TRACE("iface %p, value %s, buffer %p.\n", iface, debugstr_hstring(value), buffer);
+
+    if (!buffer) return E_POINTER;
+    text = WindowsGetStringRawBuffer(value, &length);
+    if (!(data = malloc(length * 3 / 4 + 3))) return E_OUTOFMEMORY;
+    for (i = 0; i < length; i++)
+    {
+        if (text[i] == '=') break;
+        if (text[i] == ' ' || text[i] == '\r' || text[i] == '\n' || text[i] == '\t') continue;
+        if ((v = base64_value(text[i])) < 0)
+        {
+            free(data);
+            return E_INVALIDARG;
+        }
+        acc = acc << 6 | v;
+        if ((bits += 6) >= 8)
+        {
+            bits -= 8;
+            data[n++] = acc >> bits;
+        }
+    }
+    hr = buffer_from_bytes(data, n, buffer);
+    free(data);
+    return hr;
+#else
     FIXME("iface %p, value %p, buffer %p stub!\n", iface, value, buffer);
 
     return E_NOTIMPL;
+#endif
 }
 
 static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_EncodeToBase64String(
         ICryptographicBufferStatics *iface, IBuffer *buffer, HSTRING *value)
 {
+#ifndef SG_MUTANT_NO_CRYPTOBUFFER
+    IBufferByteAccess *access;
+    UINT32 length, i, n = 0;
+    WCHAR *text;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE("iface %p, buffer %p, value %p.\n", iface, buffer, value);
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = buffer_bytes(buffer, &bytes, &length, &access))) return hr;
+    if ((text = malloc(((length + 2) / 3 * 4 + 1) * sizeof(WCHAR))))
+    {
+        for (i = 0; i < length; i += 3)
+        {
+            UINT32 chunk = bytes[i] << 16 | (i + 1 < length ? bytes[i + 1] << 8 : 0) | (i + 2 < length ? bytes[i + 2] : 0);
+            text[n++] = base64_chars[chunk >> 18];
+            text[n++] = base64_chars[(chunk >> 12) & 0x3f];
+            text[n++] = i + 1 < length ? base64_chars[(chunk >> 6) & 0x3f] : '=';
+            text[n++] = i + 2 < length ? base64_chars[chunk & 0x3f] : '=';
+        }
+        hr = WindowsCreateString(text, n, value);
+        free(text);
+    }
+    else hr = E_OUTOFMEMORY;
+    if (access) access->lpVtbl->Release(access);
+    return hr;
+#else
     FIXME("iface %p, buffer %p, value %p stub!\n", iface, buffer, value);
 
     return E_NOTIMPL;
+#endif
 }
 
 static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_ConvertStringToBinary(
