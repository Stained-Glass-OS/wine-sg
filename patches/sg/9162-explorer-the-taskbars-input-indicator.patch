+++ b/programs/explorer/inputind.c
@@ -0,0 +1,695 @@
+/*
+ * The taskbar's input indicator (Stained Glass OS 9162)
+ *
+ * As Windows 10's: with two keyboards or more the taskbar shows, left of the
+ * clock, the input language the foreground window types with ("ENG", "DEU";
+ * with two keyboards of one language the keyboard under it, "ENG" over "US").
+ * A click lists the keyboards -- the language's abbreviation, its name and the
+ * keyboard's -- with the one in use marked, picks one, and ends with
+ * "Language preferences" (Settings > Time & Language > Language). The
+ * Windows logo key + Space shows the same list while the key is held, the
+ * keyboard moving down it at each Space; Shift goes back up.
+ *
+ * The indicator follows HSHELL_LANGUAGE (win32u 9160), which the foreground
+ * window's thread sends whenever its layout is activated: the person's own
+ * switch on the display server (9154: the keyboard's group changed), a
+ * program's ActivateKeyboardLayout, a pick here. The session's keyboards are
+ * GetKeyboardLayoutList's (the session keymap's groups, 9154).
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "winnls.h"
+#include "shellapi.h"
+#include "commctrl.h"
+#include "wine/debug.h"
+#include "explorer_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(explorer);
+
+#ifndef MOD_NOREPEAT
+#define MOD_NOREPEAT 0x4000
+#endif
+#ifndef INPUTLANGCHANGE_SYSCHARSET
+#define INPUTLANGCHANGE_SYSCHARSET 0x0001
+#endif
+
+#define IND_MAX        8
+#define IND_HOTKEY     0x5760           /* the Windows logo key + Space */
+#define IND_HOTKEY_BACK 0x5761          /* ... with Shift */
+#define IND_TIMER      0x5762           /* the switcher: is the Windows logo key still down? */
+
+struct ind_layout
+{
+    HKL   hkl;
+    WCHAR abbrev[8];       /* the language's: ENG */
+    WCHAR tag[8];          /* the keyboard's, when another keyboard has the same language: US */
+    WCHAR language[96];    /* English (United States) */
+    WCHAR keyboard[96];    /* US keyboard */
+};
+
+static struct ind_layout ind_layouts[IND_MAX];
+static UINT ind_count;
+static HKL ind_current;
+static HWND ind_tray, ind_window, ind_flyout, ind_tooltip;
+static HWND ind_target;     /* the foreground window when the list was opened by a click */
+static BOOL ind_hot;        /* the pointer is over the indicator */
+static BOOL ind_switching;  /* the list is up for the Windows logo key + Space */
+static int ind_sel = -1, ind_hover = -1;
+
+/* ---- names --------------------------------------------------------------- */
+
+static BOOL is_word_script( WCHAR c )
+{
+    /* Latin, Greek, Cyrillic: the language's own name gives the letters, as Windows' indicator
+     * (ENG, DEU, FRA, ESP, SVE, РУС, УКР, ΕΛΛ); others take the ISO 639-2 code */
+    return (c >= 'A' && c < 0x250) || (c >= 0x370 && c < 0x530);
+}
+
+static void lang_abbrev( LANGID lang, WCHAR *out, int size )
+{
+    LCID lcid = MAKELCID( lang, SORT_DEFAULT );
+    WCHAR native[80];
+    int i, n = 0;
+
+    out[0] = 0;
+    if (GetLocaleInfoW( lcid, LOCALE_SNATIVELANGNAME, native, ARRAY_SIZE(native) ) && is_word_script( native[0] ))
+    {
+        for (i = 0; native[i] && n < 3 && n < size - 1; i++)
+            if (IsCharAlphaW( native[i] )) out[n++] = native[i];
+        out[n] = 0;
+    }
+    if (n < 2 && !GetLocaleInfoW( lcid, LOCALE_SISO639LANGNAME2, out, size )) lstrcpynW( out, L"???", size );
+    CharUpperW( out );
+}
+
+/* the keyboard layout identifier (KLID) of a layout's high word: 0407 is 00000407; an F00x one is the
+ * layout with that Layout Id (00010409 for United States-Dvorak, 0002) */
+static DWORD layout_klid( HKL hkl )
+{
+    WORD device = HIWORD( (UINT_PTR)hkl );
+    WCHAR name[16], id[16];
+    DWORD i, klid = device, size;
+    HKEY key, sub;
+
+    if ((device & 0xf000) != 0xf000) return device;
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Keyboard Layouts", 0,
+                       KEY_READ, &key )) return LOWORD( (UINT_PTR)hkl );
+    klid = LOWORD( (UINT_PTR)hkl );
+    for (i = 0; !RegEnumKeyW( key, i, name, ARRAY_SIZE(name) ); i++)
+    {
+        if (RegOpenKeyExW( key, name, 0, KEY_READ, &sub )) continue;
+        size = sizeof(id);
+        if (!RegQueryValueExW( sub, L"Layout Id", NULL, NULL, (BYTE *)id, &size ) &&
+            wcstoul( id, NULL, 16 ) == (device & 0x0fff))
+        {
+            klid = wcstoul( name, NULL, 16 );
+            RegCloseKey( sub );
+            break;
+        }
+        RegCloseKey( sub );
+    }
+    RegCloseKey( key );
+    return klid;
+}
+
+/* the keyboard's name, Windows' (Keyboard Layouts\KLID Layout Text), else its language's */
+static void keyboard_name( DWORD klid, WCHAR *out, int size )
+{
+    WCHAR path[96];
+    DWORD len = size * sizeof(WCHAR);
+
+    swprintf( path, ARRAY_SIZE(path), L"System\\CurrentControlSet\\Control\\Keyboard Layouts\\%08x", klid );
+    if (!RegGetValueW( HKEY_LOCAL_MACHINE, path, L"Layout Text", RRF_RT_REG_SZ, NULL, out, &len ) && out[0]) return;
+    if (!GetLocaleInfoW( MAKELCID( LOWORD(klid), SORT_DEFAULT ), LOCALE_SENGLANGUAGE, out, size ))
+        swprintf( out, size, L"%08x", klid );
+}
+
+/* the keyboard's short name under the language's, for two keyboards of one language */
+static void keyboard_tag( DWORD klid, WCHAR *out, int size )
+{
+    static const struct { DWORD klid; const WCHAR *tag; } tags[] =
+    {
+        { 0x00000409, L"US" }, { 0x00000809, L"UK" }, { 0x00020409, L"INTL" }, { 0x00010409, L"DV" },
+        { 0x00030409, L"DVL" }, { 0x00040409, L"DVR" }, { 0x00000452, L"UKX" }, { 0x00011009, L"CMS" },
+    };
+    UINT i;
+
+    for (i = 0; i < ARRAY_SIZE(tags); i++)
+        if (tags[i].klid == klid) { lstrcpynW( out, tags[i].tag, size ); return; }
+    if (!GetLocaleInfoW( MAKELCID( LOWORD(klid), SORT_DEFAULT ), LOCALE_SISO3166CTRYNAME, out, size ))
+        swprintf( out, size, L"%04X", LOWORD(klid) );
+    if (HIWORD(klid)) wcsncat( out, L"*", size - wcslen( out ) - 1 );   /* a variant of that country's */
+}
+
+/* ---- the keyboards ------------------------------------------------------- */
+
+static int find_layout( HKL hkl )
+{
+    UINT i;
+    for (i = 0; i < ind_count; i++) if (ind_layouts[i].hkl == hkl) return i;
+    return -1;
+}
+
+static const struct ind_layout *current_layout(void)
+{
+    int i = find_layout( ind_current );
+    return i >= 0 ? &ind_layouts[i] : NULL;
+}
+
+static void update_text(void)
+{
+    const struct ind_layout *l = current_layout();
+    WCHAR text[32] = L"", tip[256] = L"";
+    TTTOOLINFOW ti = { sizeof(ti) };
+
+    if (!ind_window) return;
+    if (l)
+    {
+        swprintf( text, ARRAY_SIZE(text), l->tag[0] ? L"%s %s" : L"%s", l->abbrev, l->tag );
+        swprintf( tip, ARRAY_SIZE(tip), L"%s\n%s\n\nTo switch input methods, press the Start key + Space.",
+                  l->language, l->keyboard );
+    }
+    SetWindowTextW( ind_window, text );
+    SetPropW( ind_window, L"SgInputLayout", ind_current );
+    if (ind_tooltip)
+    {
+        ti.hwnd = ind_window;
+        ti.uId = 1;
+        ti.lpszText = tip;
+        SendMessageW( ind_tooltip, TTM_UPDATETIPTEXTW, 0, (LPARAM)&ti );
+    }
+    InvalidateRect( ind_window, NULL, TRUE );
+    if (ind_flyout) InvalidateRect( ind_flyout, NULL, TRUE );
+}
+
+/* read the person's keyboards again; TRUE when the indicator came or went (the bar is laid out again) */
+BOOL input_indicator_refresh(void)
+{
+    HKL list[IND_MAX];
+    UINT count = GetKeyboardLayoutList( IND_MAX, list ), i, j, was = ind_count;
+    BOOL same = count == ind_count;
+    HKL was_current = ind_current;
+
+    if (count > IND_MAX) count = IND_MAX;
+    for (i = 0; same && i < count; i++) if (ind_layouts[i].hkl != list[i]) same = FALSE;
+    if (!same)
+    {
+        ind_count = count;
+        for (i = 0; i < count; i++)
+        {
+            struct ind_layout *l = &ind_layouts[i];
+            WCHAR name[80];
+            DWORD klid = layout_klid( list[i] );
+
+            memset( l, 0, sizeof(*l) );
+            l->hkl = list[i];
+            lang_abbrev( LOWORD( (UINT_PTR)list[i] ), l->abbrev, ARRAY_SIZE(l->abbrev) );
+            if (!GetLocaleInfoW( MAKELCID( LOWORD( (UINT_PTR)list[i] ), SORT_DEFAULT ), LOCALE_SLOCALIZEDDISPLAYNAME,
+                                 l->language, ARRAY_SIZE(l->language) ))
+                lstrcpyW( l->language, l->abbrev );
+            keyboard_name( klid, name, ARRAY_SIZE(name) );
+            swprintf( l->keyboard, ARRAY_SIZE(l->keyboard), L"%s keyboard", name );
+            for (j = 0; j < count; j++)
+                if (j != i && LOWORD( (UINT_PTR)list[j] ) == LOWORD( (UINT_PTR)list[i] ))
+                {
+                    keyboard_tag( klid, l->tag, ARRAY_SIZE(l->tag) );
+                    break;
+                }
+        }
+        TRACE( "%u keyboards\n", count );
+    }
+    if (find_layout( ind_current ) < 0)
+    {
+        ind_current = GetKeyboardLayout( 0 );
+        if (find_layout( ind_current ) < 0) ind_current = count ? ind_layouts[0].hkl : 0;
+    }
+    if (!same || ind_current != was_current) update_text();
+    if (ind_window) ShowWindow( ind_window, ind_count >= 2 ? SW_SHOWNA : SW_HIDE );
+    return (was >= 2) != (ind_count >= 2);
+}
+
+int input_indicator_len( BOOL vertical, int (*px)(int) )
+{
+    if (ind_count < 2) return 0;
+#ifdef SG_MUTANT_IND_NO_ROOM
+    return 0;
+#endif
+    return px( vertical ? 32 : 36 );
+}
+
+void input_indicator_place( int x, int y, int cx, int cy )
+{
+    if (!ind_window) return;
+    SetWindowPos( ind_window, 0, x, y, cx, cy, SWP_NOACTIVATE | SWP_NOZORDER );
+    if (ind_tooltip)
+    {
+        TTTOOLINFOW ti = { sizeof(ti) };
+        ti.hwnd = ind_window;
+        ti.uId = 1;
+        GetClientRect( ind_window, &ti.rect );
+        SendMessageW( ind_tooltip, TTM_NEWTOOLRECTW, 0, (LPARAM)&ti );
+    }
+}
+
+/* ---- switching ----------------------------------------------------------- */
+
+static void set_current( HKL hkl )
+{
+    if (hkl == ind_current) return;
+    ind_current = hkl;
+    if (ind_switching || ind_flyout) ind_sel = find_layout( hkl );
+    update_text();
+}
+
+/* HSHELL_LANGUAGE: the foreground window's layout */
+void input_indicator_language( HKL hkl )
+{
+    TRACE( "%p\n", hkl );
+    if (find_layout( hkl ) < 0) input_indicator_refresh();
+#ifndef SG_MUTANT_IND_IGNORE_SHELL
+    if (find_layout( hkl ) >= 0) set_current( hkl );
+#endif
+}
+
+static void close_flyout( BOOL give_back )
+{
+    HWND target = ind_target, flyout = ind_flyout;
+
+    KillTimer( ind_tray, IND_TIMER );
+    ind_switching = FALSE;
+    ind_target = 0;
+    ind_flyout = 0;
+    ind_sel = ind_hover = -1;
+    if (flyout) DestroyWindow( flyout );
+    if (ind_tooltip) SendMessageW( ind_tooltip, TTM_ACTIVATE, TRUE, 0 );
+    if (ind_window) InvalidateRect( ind_window, NULL, FALSE );
+    if (give_back && target && IsWindow( target )) SetForegroundWindow( target );
+}
+
+/* a keyboard picked from the list: the keyboard types with it (explorer is in the foreground: its
+ * activation switches the session's keyboard, 9156); the window that was in front -- whose layout the
+ * indicator shows -- gets the foreground back and is asked to take it, as Windows' switcher asks it
+ * (WM_INPUTLANGCHANGEREQUEST to its focus window, after its activation: a window in the background has
+ * no focus to tell of the change) */
+static void pick( int i )
+{
+    HKL hkl;
+    HWND target = ind_target, focus;
+    GUITHREADINFO gui = { sizeof(gui) };
+    DWORD tid = 0;
+
+    if (i < 0 || i >= (int)ind_count) return;
+    hkl = ind_layouts[i].hkl;
+    TRACE( "%p for %p\n", hkl, target );
+#ifndef SG_MUTANT_IND_PICK_NOTHING
+    ActivateKeyboardLayout( hkl, 0 );
+#endif
+    set_current( hkl );
+    if (target && IsWindow( target )) tid = GetWindowThreadProcessId( target, NULL );
+    close_flyout( TRUE );
+#ifndef SG_MUTANT_IND_PICK_NOTHING
+    if (tid && tid != GetCurrentThreadId())
+    {
+        focus = GetGUIThreadInfo( tid, &gui ) && gui.hwndFocus ? gui.hwndFocus : target;
+        PostMessageW( focus, WM_INPUTLANGCHANGEREQUEST, INPUTLANGCHANGE_SYSCHARSET, (LPARAM)hkl );
+    }
+#endif
+}
+
+/* ---- the list ------------------------------------------------------------ */
+
+#define FLY_ITEM   56
+#define FLY_LINK   44
+#define FLY_WIDTH  300
+#define FLY_ABBREV 64
+
+static int (*ind_px)(int);
+
+static int fly_item_at( int y )
+{
+    int item = ind_px( FLY_ITEM ), i;
+    if (y < 0) return -1;
+    i = y / item;
+    if (i < (int)ind_count) return i;
+    if (y >= item * (int)ind_count && !ind_switching) return ind_count;   /* the link */
+    return -1;
+}
+
+static HFONT fly_font( int size, int weight )
+{
+    NONCLIENTMETRICSW ncm = { sizeof(ncm) };
+    LOGFONTW lf;
+
+    SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+    lf = ncm.lfMenuFont;
+    lf.lfHeight = -ind_px( size );
+    lf.lfWeight = weight;
+    return CreateFontIndirectW( &lf );
+}
+
+static void fly_paint( HWND hwnd, HDC hdc )
+{
+    COLORREF bar, hover, text, accent = taskbar_accent();
+    HFONT big = fly_font( 15, FW_SEMIBOLD ), small = fly_font( 12, FW_NORMAL ), old;
+    int item = ind_px( FLY_ITEM ), i;
+    RECT rc, r;
+    HBRUSH brush;
+
+    taskbar_colors( &bar, &hover, &text );
+    GetClientRect( hwnd, &rc );
+    brush = CreateSolidBrush( bar );
+    FillRect( hdc, &rc, brush );
+    DeleteObject( brush );
+    SetBkMode( hdc, TRANSPARENT );
+    SetTextColor( hdc, text );
+    old = SelectObject( hdc, big );
+    for (i = 0; i < (int)ind_count; i++)
+    {
+        const struct ind_layout *l = &ind_layouts[i];
+
+        SetRect( &r, 0, i * item, rc.right, (i + 1) * item );
+        if (i == ind_sel || i == ind_hover)
+        {
+            brush = CreateSolidBrush( hover );
+            FillRect( hdc, &r, brush );
+            DeleteObject( brush );
+        }
+        if (i == ind_sel)
+        {
+            RECT mark = { 0, r.top, ind_px( 3 ), r.bottom };
+            brush = CreateSolidBrush( accent );
+            FillRect( hdc, &mark, brush );
+            DeleteObject( brush );
+        }
+        SelectObject( hdc, big );
+        SetRect( &r, ind_px( 12 ), i * item, ind_px( FLY_ABBREV ), (i + 1) * item );
+        DrawTextW( hdc, l->abbrev, -1, &r, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX );
+        SetRect( &r, ind_px( FLY_ABBREV ), i * item + ind_px( 8 ), rc.right - ind_px( 8 ), i * item + item / 2 );
+        DrawTextW( hdc, l->language, -1, &r, DT_LEFT | DT_BOTTOM | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS );
+        SelectObject( hdc, small );
+        SetRect( &r, ind_px( FLY_ABBREV ), i * item + item / 2 + ind_px( 2 ), rc.right - ind_px( 8 ), (i + 1) * item );
+        DrawTextW( hdc, l->keyboard, -1, &r, DT_LEFT | DT_TOP | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS );
+    }
+    if (!ind_switching)
+    {
+        HPEN pen = CreatePen( PS_SOLID, 1, hover ), oldp = SelectObject( hdc, pen );
+        int top = ind_count * item;
+
+        MoveToEx( hdc, 0, top, NULL );
+        LineTo( hdc, rc.right, top );
+        SelectObject( hdc, oldp );
+        DeleteObject( pen );
+        SetRect( &r, ind_px( 12 ), top, rc.right, rc.bottom );
+        if (ind_hover == (int)ind_count)
+        {
+            brush = CreateSolidBrush( hover );
+            FillRect( hdc, &r, brush );
+            DeleteObject( brush );
+        }
+        SelectObject( hdc, small );
+        SetTextColor( hdc, accent );
+        SetRect( &r, ind_px( 12 ), top, rc.right, rc.bottom );
+        DrawTextW( hdc, L"Language preferences", -1, &r, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX );
+    }
+    SelectObject( hdc, old );
+    DeleteObject( big );
+    DeleteObject( small );
+}
+
+static LRESULT WINAPI fly_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    switch (msg)
+    {
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint( hwnd, &ps );
+        fly_paint( hwnd, hdc );
+        EndPaint( hwnd, &ps );
+        return 0;
+    }
+    case WM_MOUSEMOVE:
+    {
+        int i = fly_item_at( (short)HIWORD(lp) );
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd, 0 };
+        if (i != ind_hover) { ind_hover = i; InvalidateRect( hwnd, NULL, FALSE ); }
+        TrackMouseEvent( &tme );
+        return 0;
+    }
+    case WM_MOUSELEAVE:
+        ind_hover = -1;
+        InvalidateRect( hwnd, NULL, FALSE );
+        return 0;
+    case WM_LBUTTONUP:
+    {
+        int i = fly_item_at( (short)HIWORD(lp) );
+        if (i == (int)ind_count)
+        {
+            close_flyout( FALSE );
+            ShellExecuteW( NULL, NULL, L"ms-settings:regionlanguage", NULL, NULL, SW_SHOWNORMAL );
+        }
+        else if (i >= 0) pick( i );
+        return 0;
+    }
+    case WM_KEYDOWN:
+        if (wp == VK_ESCAPE) close_flyout( TRUE );
+        else if (wp == VK_UP && ind_count) { ind_sel = (ind_sel + ind_count - 1) % ind_count; InvalidateRect( hwnd, NULL, FALSE ); }
+        else if (wp == VK_DOWN && ind_count) { ind_sel = (ind_sel + 1) % ind_count; InvalidateRect( hwnd, NULL, FALSE ); }
+        else if (wp == VK_RETURN || wp == VK_SPACE) pick( ind_sel );
+        return 0;
+    case WM_ACTIVATE:
+        /* a click anywhere else: the list goes (not from inside its own activation) */
+        if (LOWORD(wp) == WA_INACTIVE && !ind_switching) PostMessageW( hwnd, WM_CLOSE, 0, 0 );
+        return 0;
+    case WM_CLOSE:
+        if (hwnd == ind_flyout) close_flyout( FALSE );
+        return 0;
+    case WM_MOUSEACTIVATE:
+        return ind_switching ? MA_NOACTIVATE : MA_ACTIVATE;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+/* the list over the indicator (or beside it, on a vertical bar), in its display's work area */
+static void open_flyout( BOOL switching )
+{
+    HMONITOR mon;
+    MONITORINFO mi = { sizeof(mi) };
+    RECT ind, tray;
+    UINT edge = ABE_BOTTOM;
+    int cx = ind_px( FLY_WIDTH ), cy = ind_px( FLY_ITEM ) * ind_count + (switching ? 0 : ind_px( FLY_LINK ));
+    int x, y;
+
+    if (ind_flyout) close_flyout( FALSE );
+    GetWindowRect( ind_window, &ind );
+    taskbar_state( &tray, &edge );
+    mon = MonitorFromRect( &ind, MONITOR_DEFAULTTONEAREST );
+    GetMonitorInfoW( mon, &mi );
+    switch (edge)
+    {
+    case ABE_TOP:   x = ind.right - cx; y = ind.bottom; break;
+    case ABE_LEFT:  x = ind.right; y = ind.bottom - cy; break;
+    case ABE_RIGHT: x = ind.left - cx; y = ind.bottom - cy; break;
+    default:        x = ind.right - cx; y = ind.top - cy; break;
+    }
+    if (x + cx > mi.rcWork.right) x = mi.rcWork.right - cx;
+    if (x < mi.rcWork.left) x = mi.rcWork.left;
+    if (y + cy > mi.rcWork.bottom) y = mi.rcWork.bottom - cy;
+    if (y < mi.rcWork.top) y = mi.rcWork.top;
+
+    ind_switching = switching;
+    ind_sel = find_layout( ind_current );
+    ind_hover = -1;
+    ind_flyout = CreateWindowExW( WS_EX_TOOLWINDOW | WS_EX_TOPMOST | (switching ? WS_EX_NOACTIVATE : 0),
+                                  L"SgInputSwitcher", switching ? L"Switching input" : L"Input",
+                                  WS_POPUP | WS_BORDER, x, y, cx, cy, 0, 0, 0, NULL );
+    if (!ind_flyout) return;
+    /* the indicator's tooltip does not cover the list */
+    if (ind_tooltip) SendMessageW( ind_tooltip, TTM_ACTIVATE, FALSE, 0 );
+    InvalidateRect( ind_window, NULL, FALSE );
+    if (switching)
+    {
+        ShowWindow( ind_flyout, SW_SHOWNOACTIVATE );
+        SetTimer( ind_tray, IND_TIMER, 50, NULL );
+    }
+    else
+    {
+        AllowSetForegroundWindow( ASFW_ANY );
+        ShowWindow( ind_flyout, SW_SHOW );
+        SetForegroundWindow( ind_flyout );
+        SetFocus( ind_flyout );
+    }
+}
+
+/* ---- the indicator ------------------------------------------------------- */
+
+static void ind_paint( HWND hwnd, HDC hdc )
+{
+    const struct ind_layout *l = current_layout();
+    COLORREF bar, hover, text;
+    RECT rc, r;
+    HFONT font, old;
+
+    taskbar_colors( &bar, &hover, &text );
+    GetClientRect( hwnd, &rc );
+    taskbar_paint_under( hdc, hwnd );
+    if (ind_hot || ind_flyout)
+    {
+        HBRUSH brush = CreateSolidBrush( hover );
+        FillRect( hdc, &rc, brush );
+        DeleteObject( brush );
+    }
+    if (!l) return;
+    font = fly_font( 12, FW_NORMAL );
+    old = SelectObject( hdc, font );
+    SetBkMode( hdc, TRANSPARENT );
+    SetTextColor( hdc, text );
+    if (l->tag[0] && rc.bottom >= ind_px( 36 ))
+    {
+        r = rc; r.bottom = rc.bottom / 2;
+        DrawTextW( hdc, l->abbrev, -1, &r, DT_CENTER | DT_BOTTOM | DT_SINGLELINE | DT_NOPREFIX );
+        r = rc; r.top = rc.bottom / 2;
+        DrawTextW( hdc, l->tag, -1, &r, DT_CENTER | DT_TOP | DT_SINGLELINE | DT_NOPREFIX );
+    }
+    else DrawTextW( hdc, l->abbrev, -1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX );
+    SelectObject( hdc, old );
+    DeleteObject( font );
+}
+
+static LRESULT WINAPI ind_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    switch (msg)
+    {
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint( hwnd, &ps );
+        ind_paint( hwnd, hdc );
+        EndPaint( hwnd, &ps );
+        return 0;
+    }
+    case WM_MOUSEMOVE:
+        if (!ind_hot)
+        {
+            TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd, 0 };
+            ind_hot = TRUE;
+            TrackMouseEvent( &tme );
+            InvalidateRect( hwnd, NULL, FALSE );
+        }
+        return 0;
+    case WM_MOUSELEAVE:
+        ind_hot = FALSE;
+        InvalidateRect( hwnd, NULL, FALSE );
+        return 0;
+    case WM_LBUTTONDOWN:
+        /* the window the person was typing in: the bar does not take the foreground */
+        if (!ind_flyout) ind_target = GetForegroundWindow();
+        return 0;
+    case WM_LBUTTONUP:
+        if (ind_flyout && !ind_switching) close_flyout( TRUE );
+        else
+        {
+            HWND target = ind_target;
+            open_flyout( FALSE );
+            ind_target = target;
+        }
+        InvalidateRect( hwnd, NULL, FALSE );
+        return 0;
+    case WM_MOUSEACTIVATE:
+        return MA_NOACTIVATE;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+void input_indicator_create( HWND tray, int (*px)(int) )
+{
+    WNDCLASSW wc = { 0 };
+    TTTOOLINFOW ti = { sizeof(ti) };
+
+    ind_tray = tray;
+    ind_px = px;
+    wc.lpfnWndProc = ind_proc;
+    wc.hCursor = LoadCursorW( 0, (const WCHAR *)IDC_ARROW );
+    wc.lpszClassName = L"TrayInputIndicatorWClass";
+    RegisterClassW( &wc );
+    wc.lpfnWndProc = fly_proc;
+    wc.style = CS_DROPSHADOW;
+    wc.lpszClassName = L"SgInputSwitcher";
+    RegisterClassW( &wc );
+
+    ind_window = CreateWindowExW( 0, L"TrayInputIndicatorWClass", L"", WS_CHILD | WS_CLIPSIBLINGS,
+                                  0, 0, 0, 0, tray, 0, 0, NULL );
+    ind_tooltip = CreateWindowExW( WS_EX_TOPMOST, TOOLTIPS_CLASSW, NULL, WS_POPUP | TTS_NOPREFIX | TTS_ALWAYSTIP,
+                                   0, 0, 0, 0, tray, 0, 0, NULL );
+    if (ind_tooltip)
+    {
+        ti.uFlags = TTF_SUBCLASS;
+        ti.hwnd = ind_window;
+        ti.uId = 1;
+        ti.lpszText = (WCHAR *)L"";
+        SendMessageW( ind_tooltip, TTM_ADDTOOLW, 0, (LPARAM)&ti );
+        SendMessageW( ind_tooltip, TTM_SETMAXTIPWIDTH, 0, 400 );
+    }
+#ifndef SG_MUTANT_IND_NO_HOTKEY
+    RegisterHotKey( tray, IND_HOTKEY, MOD_WIN | MOD_NOREPEAT, VK_SPACE );
+    RegisterHotKey( tray, IND_HOTKEY_BACK, MOD_WIN | MOD_SHIFT | MOD_NOREPEAT, VK_SPACE );
+#endif
+    ind_current = GetKeyboardLayout( 0 );
+    input_indicator_refresh();
+    update_text();
+}
+
+/* the Windows logo key + Space: the next keyboard (the display server switches the keyboard itself,
+ * grp:win_space_toggle; this shows where it went), Shift: the one before */
+BOOL input_indicator_hotkey( WPARAM id )
+{
+    int i;
+
+    if (id != IND_HOTKEY && id != IND_HOTKEY_BACK) return FALSE;
+    if (ind_count < 2) return TRUE;
+    i = find_layout( ind_current );
+    if (i < 0) i = 0;
+    else if (id == IND_HOTKEY) i = (i + 1) % ind_count;
+    else i = (i + ind_count - 1) % ind_count;
+    if (!ind_switching) open_flyout( TRUE );
+    set_current( ind_layouts[i].hkl );
+    ind_sel = i;
+    if (ind_flyout) InvalidateRect( ind_flyout, NULL, FALSE );
+    return TRUE;
+}
+
+/* the tray's timer: the switcher goes when the Windows logo key is let go */
+BOOL input_indicator_timer( WPARAM id )
+{
+    if (id != IND_TIMER) return FALSE;
+    if (ind_switching && GetAsyncKeyState( VK_LWIN ) >= 0 && GetAsyncKeyState( VK_RWIN ) >= 0)
+        close_flyout( FALSE );
+    return TRUE;
+}
