+/* service classes: "Name", and "Infos": a count, then per entry the name
+ * space, value type, value size and name length, the name and the value */
+static BYTE *serialize_class_infos( const WSASERVICECLASSINFOW *info, DWORD *size )
+{
+    DWORD i, total = sizeof(DWORD), *p;
+    BYTE *ret, *q;
+
+    for (i = 0; i < info->dwCount; i++)
+        total += 4 * sizeof(DWORD) + (wcslen( info->lpClassInfos[i].lpszName ) + 1) * sizeof(WCHAR) +
+                 info->lpClassInfos[i].dwValueSize;
+    if (!(ret = malloc( total ))) return NULL;
+    *(DWORD *)ret = info->dwCount;
+    q = ret + sizeof(DWORD);
+    for (i = 0; i < info->dwCount; i++)
+    {
+        const WSANSCLASSINFOW *c = &info->lpClassInfos[i];
+        DWORD name_size = (wcslen( c->lpszName ) + 1) * sizeof(WCHAR);
+        p = (DWORD *)q;
+        p[0] = c->dwNameSpace;
+        p[1] = c->dwValueType;
+        p[2] = c->dwValueSize;
+        p[3] = name_size;
+        q += 4 * sizeof(DWORD);
+        memcpy( q, c->lpszName, name_size );
+        q += name_size;
+        if (c->dwValueSize) memcpy( q, c->lpValue, c->dwValueSize );
+        q += c->dwValueSize;
+    }
+    *size = total;
+    return ret;
+}
