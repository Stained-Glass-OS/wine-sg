+
+static BOOL is_builtin_ns( const GUID *id )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(providers); i++) if (IsEqualGUID( providers[i].id, id )) return TRUE;
+    return FALSE;
+}
+
+/***********************************************************************
+ *      WSCInstallNameSpace   (ws2_32.@)
+ */
+int WINAPI WSCInstallNameSpace( WCHAR *identifier, WCHAR *path, DWORD name_space, DWORD version, GUID *provider )
+{
+    LSTATUS status;
+    DWORD disp, one = 1;
+    HKEY key;
+    WCHAR sub[80];
+
+    TRACE( "(%s %s %#lx %#lx %s)\n", debugstr_w(identifier), debugstr_w(path), name_space, version,
+           debugstr_guid(provider) );
+
+    if (!identifier || !path || !provider || is_builtin_ns( provider ))
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    wcscpy( sub, L"NameSpaces\\" );
+    guid_to_name( provider, sub + wcslen( sub ) );
+    {
+        WCHAR full[256];
+        swprintf( full, ARRAY_SIZE(full), L"%s\\%s", catalog_path, sub );
+        status = RegCreateKeyExW( HKEY_LOCAL_MACHINE, full, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, &disp );
+    }
+    if (status)
+    {
+        SetLastError( reg_error( status ) );
+        return SOCKET_ERROR;
+    }
+    if (disp == REG_OPENED_EXISTING_KEY)
+    {
+        RegCloseKey( key );
+        SetLastError( WSAEINVAL );   /* already installed */
+        return SOCKET_ERROR;
+    }
+    RegSetValueExW( key, L"Identifier", 0, REG_SZ, (BYTE *)identifier, (wcslen( identifier ) + 1) * sizeof(WCHAR) );
+    RegSetValueExW( key, L"Path", 0, REG_SZ, (BYTE *)path, (wcslen( path ) + 1) * sizeof(WCHAR) );
+    RegSetValueExW( key, L"NameSpace", 0, REG_DWORD, (BYTE *)&name_space, sizeof(DWORD) );
+    RegSetValueExW( key, L"Version", 0, REG_DWORD, (BYTE *)&version, sizeof(DWORD) );
+    RegSetValueExW( key, L"Enabled", 0, REG_DWORD, (BYTE *)&one, sizeof(DWORD) );
+    RegCloseKey( key );
+    return 0;
+}
+
+/***********************************************************************
+ *      WSCUnInstallNameSpace   (ws2_32.@)
+ */
+int WINAPI WSCUnInstallNameSpace( GUID *provider )
+{
+    LSTATUS status;
+    WCHAR name[40];
+    HKEY key;
+
+    TRACE( "(%s)\n", debugstr_guid(provider) );
+
+    if (!provider || is_builtin_ns( provider ))
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    if ((status = open_catalog( L"NameSpaces", KEY_ALL_ACCESS, FALSE, &key )))
+    {
+        SetLastError( reg_error( status ) );
+        return SOCKET_ERROR;
+    }
+    guid_to_name( provider, name );
+    status = RegDeleteTreeW( key, name );
+    RegCloseKey( key );
+    if (status)
+    {
+        SetLastError( reg_error( status ) );
+        return SOCKET_ERROR;
+    }
+    return 0;
+}
+
+/***********************************************************************
+ *      WSCEnableNSProvider   (ws2_32.@)
+ */
+int WINAPI WSCEnableNSProvider( GUID *provider, BOOL enable )
+{
+    struct ns_provider *list;
+    unsigned int count, i;
+    LSTATUS status;
+    DWORD value = !!enable;
+    HKEY key;
+
+    TRACE( "(%s %d)\n", debugstr_guid(provider), enable );
+
+    if (!provider)
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    count = get_ns_providers( &list );
+    for (i = 0; i < count; i++) if (IsEqualGUID( &list[i].id, provider )) break;
+    free_ns_providers( list, count );
+    if (i == count)
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    if ((status = open_catalog_entry( L"NameSpaces", provider, KEY_SET_VALUE, TRUE, &key )))
+    {
+        SetLastError( reg_error( status ) );
+        return SOCKET_ERROR;
+    }
+    status = RegSetValueExW( key, L"Enabled", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+    RegCloseKey( key );
+    if (status)
+    {
+        SetLastError( reg_error( status ) );
+        return SOCKET_ERROR;
+    }
+    return 0;
+}
+
+/***********************************************************************
+ *      WSCWriteNameSpaceOrder   (ws2_32.@)
+ */
+int WINAPI WSCWriteNameSpaceOrder( GUID *ids, DWORD count )
+{
+    struct ns_provider *list;
+    unsigned int n, i, j;
+    LSTATUS status;
+    HKEY key;
+
+    TRACE( "(%p %lu)\n", ids, count );
+
+    if (!ids) return WSAEINVAL;
+    n = get_ns_providers( &list );
+    /* every provider, each once */
+    for (i = 0; i < count && count == n; i++)
+    {
+        for (j = 0; j < n; j++) if (IsEqualGUID( &list[j].id, &ids[i] )) break;
+        if (j == n) break;
+        for (j = 0; j < i; j++) if (IsEqualGUID( &ids[j], &ids[i] )) break;
+        if (j < i) break;
+    }
+    free_ns_providers( list, n );
+    if (count != n || i < count) return WSAEINVAL;
+
+    if ((status = open_catalog( L"NameSpaces", KEY_SET_VALUE, TRUE, &key ))) return reg_error( status );
+    status = RegSetValueExW( key, L"Order", 0, REG_BINARY, (BYTE *)ids, count * sizeof(GUID) );
+    RegCloseKey( key );
+    return reg_error( status );
+}
+
+/***********************************************************************
+ *      WSCWriteProviderOrder   (ws2_32.@)
+ */
+int WINAPI WSCWriteProviderOrder( DWORD *entries, DWORD count )
+{
+    WSAPROTOCOL_INFOW *info;
+    DWORD size = 0;
+    LSTATUS status;
+    int n, i, j;
+    HKEY key;
+
+    TRACE( "(%p %lu)\n", entries, count );
+
+    if (!entries) return WSAEINVAL;
+    WSAEnumProtocolsW( NULL, NULL, &size );
+    if (!size || !(info = malloc( size ))) return WSA_NOT_ENOUGH_MEMORY;
+    n = WSAEnumProtocolsW( NULL, info, &size );
+    /* every catalog entry, each once */
+    for (i = 0; i < count && count == n; i++)
+    {
+        for (j = 0; j < n; j++) if (info[j].dwCatalogEntryId == entries[i]) break;
+        if (j == n) break;
+        for (j = 0; j < i; j++) if (entries[j] == entries[i]) break;
+        if (j < i) break;
+    }
+    free( info );
+    if (count != n || i < count) return WSAEINVAL;
+
+    if ((status = open_catalog( NULL, KEY_SET_VALUE, TRUE, &key ))) return reg_error( status );
+    status = RegSetValueExW( key, L"ProviderOrder", 0, REG_BINARY, (BYTE *)entries, count * sizeof(DWORD) );
+    RegCloseKey( key );
+    return reg_error( status );
+}
+
+/***********************************************************************
+ *      WSCInstallProvider   (ws2_32.@)
+ */
+int WINAPI WSCInstallProvider( GUID *provider, const WCHAR *path, WSAPROTOCOL_INFOW *protocol_info,
+                               DWORD count, int *err )
+{
+    LSTATUS status;
+    DWORD disp;
+    WCHAR full[256], name[40];
+    HKEY key;
+
+    TRACE( "(%s, %s, %p, %lu, %p)\n", debugstr_guid(provider), debugstr_w(path), protocol_info, count, err );
+
+    if (!err) return SOCKET_ERROR;
+    if (!provider || !path || !protocol_info || !count)
+    {
+        *err = WSAEINVAL;
+        return SOCKET_ERROR;
+    }
+    guid_to_name( provider, name );
+    swprintf( full, ARRAY_SIZE(full), L"%s\\Providers\\%s", catalog_path, name );
+    if ((status = RegCreateKeyExW( HKEY_LOCAL_MACHINE, full, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, &disp )))
+    {
+        *err = reg_error( status );
+        return SOCKET_ERROR;
+    }
+    if (disp == REG_OPENED_EXISTING_KEY)
+    {
+        RegCloseKey( key );
+        *err = WSAEINVAL;
+        return SOCKET_ERROR;
+    }
+    RegSetValueExW( key, L"Path", 0, REG_SZ, (BYTE *)path, (wcslen( path ) + 1) * sizeof(WCHAR) );
+    RegSetValueExW( key, L"Protocols", 0, REG_BINARY, (BYTE *)protocol_info, count * sizeof(*protocol_info) );
+    RegCloseKey( key );
+    FIXME( "provider %s recorded; sockets are not layered through %s\n", debugstr_guid(provider), debugstr_w(path) );
+    *err = 0;
+    return 0;
+}
+
+/***********************************************************************
+ *      WSCDeinstallProvider   (ws2_32.@)
+ */
+int WINAPI WSCDeinstallProvider( GUID *provider, int *err )
+{
+    LSTATUS status;
+    WCHAR name[40];
+    HKEY key;
+
+    TRACE( "(%s, %p)\n", debugstr_guid(provider), err );
+
+    if (!err) return SOCKET_ERROR;
+    if (!provider)
+    {
+        *err = WSAEFAULT;
+        return SOCKET_ERROR;
+    }
+    if ((status = open_catalog( L"Providers", KEY_ALL_ACCESS, FALSE, &key )))
+    {
+        *err = status == ERROR_FILE_NOT_FOUND ? WSAEINVAL : reg_error( status );
+        return SOCKET_ERROR;
+    }
+    guid_to_name( provider, name );
+    status = RegDeleteTreeW( key, name );
+    RegCloseKey( key );
+    if (status)
+    {
+        *err = reg_error( status );
+        return SOCKET_ERROR;
+    }
+    *err = 0;
+    return 0;
+}
