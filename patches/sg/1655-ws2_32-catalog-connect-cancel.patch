+                  &connectex, sizeof(connectex), &size, NULL, NULL ))
+        return FALSE;
+    if (timeout) deadline = GetTickCount64() + (ULONGLONG)timeout->tv_sec * 1000 + timeout->tv_usec / 1000;
+
+    /* ConnectEx takes a bound socket */
+    len = sizeof(local);
+    if (getsockname( s, (struct sockaddr *)&local, &len ))
+    {
+        memset( &local, 0, sizeof(local) );
+        local.ss_family = family;
+        if (bind( s, (struct sockaddr *)&local, family == AF_INET6 ? sizeof(SOCKADDR_IN6) : sizeof(SOCKADDR_IN) ))
+            return FALSE;
+    }
+
+    memset( &ov, 0, sizeof(ov) );
+    if (!(ov.hEvent = CreateEventW( NULL, TRUE, FALSE, NULL ))) return FALSE;
+    for (i = 0; i < count; i++)
+    {
+        DWORD wait = INFINITE, bytes, flags;
+
+        if (!addrs[i].lpSockaddr || addrs[i].lpSockaddr->sa_family != family) continue;
+        ResetEvent( ov.hEvent );
+        if (connectex( s, addrs[i].lpSockaddr, addrs[i].iSockaddrLength, NULL, 0, NULL, &ov )) break;
+        if ((err = WSAGetLastError()) != ERROR_IO_PENDING) continue;
+        if (timeout)
+        {
+            ULONGLONG now = GetTickCount64();
+            wait = now >= deadline ? 0 : deadline - now;
+        }
+#ifdef SG_MUTANT_CONNECT_NO_TIMEOUT
+        wait = INFINITE;
+#endif
