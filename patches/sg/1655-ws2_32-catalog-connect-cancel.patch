+/* an installed transport provider's path */
+static WCHAR *installed_provider_path( const GUID *provider )
+{
+    WCHAR *ret = NULL;
+    HKEY key;
+
+    if (!open_catalog_entry( L"Providers", provider, KEY_READ, FALSE, &key ))
+    {
+        ret = reg_get_string( key, L"Path" );
+        RegCloseKey( key );
+    }
+    return ret;
+}
