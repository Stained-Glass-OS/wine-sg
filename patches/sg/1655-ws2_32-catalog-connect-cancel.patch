+/* application categories: "AppCategories\<path|extra>", backslashes as
+ * slashes, with the category */
+static BOOL app_category_key( const WCHAR *path, DWORD path_len, const WCHAR *extra, DWORD extra_len,
+                              WCHAR *buf, DWORD size )
+{
+    DWORD i, n = 0;
+
+    if (path_len + extra_len + 32 > size) return FALSE;
+    n = swprintf( buf, size, L"AppCategories\\" );
+    for (i = 0; i < path_len && path[i]; i++) buf[n++] = path[i] == '\\' ? '/' : towlower( path[i] );
+    buf[n++] = '|';
+    for (i = 0; extra && i < extra_len && extra[i]; i++) buf[n++] = extra[i] == '\\' ? '/' : extra[i];
+    buf[n] = 0;
+    return TRUE;
+}
+
+/***********************************************************************
+ *      WSCGetApplicationCategory   (ws2_32.@)
+ */
+int WINAPI WSCGetApplicationCategory( const WCHAR *path, DWORD path_len, const WCHAR *extra,
+                                      DWORD extra_len, DWORD *category, int *errcode )
+{
+    WCHAR sub[MAX_PATH * 2 + 64];
+    HKEY key;
+
+    TRACE( "(%s %lu %s %lu %p %p)\n", debugstr_w(path), path_len, debugstr_w(extra), extra_len, category, errcode );
+
+    if (!errcode) return SOCKET_ERROR;
+    if (!path || !path_len || !category || (extra_len && !extra) ||
+        !app_category_key( path, path_len, extra, extra_len, sub, ARRAY_SIZE(sub) ))
+    {
+        *errcode = WSAEINVAL;
+        return SOCKET_ERROR;
+    }
+    if (open_catalog( sub, KEY_READ, FALSE, &key ))
+    {
+        *errcode = WSANO_RECOVERY;   /* no category set for this application */
+        return SOCKET_ERROR;
+    }
+    *category = reg_get_dword( key, L"Category", 0 );
+    RegCloseKey( key );
+    return 0;
+}
+
+/***********************************************************************
+ *      WSCSetApplicationCategory   (ws2_32.@)
+ */
+int WINAPI WSCSetApplicationCategory( const WCHAR *path, DWORD path_len, const WCHAR *extra, DWORD extra_len,
+                                      DWORD category, DWORD *prev_category, int *err )
+{
+    WCHAR sub[MAX_PATH * 2 + 64];
+    LSTATUS status;
+    HKEY key;
+
+    TRACE( "(%s %lu %s %lu %#lx %p %p)\n", debugstr_w(path), path_len, debugstr_w(extra), extra_len,
+           category, prev_category, err );
+
+    if (!err) return SOCKET_ERROR;
+    if (!path || !path_len || (extra_len && !extra) ||
+        !app_category_key( path, path_len, extra, extra_len, sub, ARRAY_SIZE(sub) ))
+    {
+        *err = WSAEINVAL;
+        return SOCKET_ERROR;
+    }
+    if ((status = open_catalog( sub, KEY_ALL_ACCESS, TRUE, &key )))
+    {
+        *err = reg_error( status );
+        return SOCKET_ERROR;
+    }
+    if (prev_category) *prev_category = reg_get_dword( key, L"Category", 0 );
+    status = RegSetValueExW( key, L"Category", 0, REG_DWORD, (BYTE *)&category, sizeof(category) );
+    RegCloseKey( key );
+    if (status)
+    {
+        *err = reg_error( status );
+        return SOCKET_ERROR;
+    }
+    *err = 0;
+    return 0;
+}
+
+struct config_change
+{
+    HKEY key;
+    HANDLE event, wait, thread;
+    OVERLAPPED *overlapped;
+    LPWSAOVERLAPPED_COMPLETION_ROUTINE completion;
+};
+
+static void WINAPI config_change_apc( ULONG_PTR arg )
+{
+    struct config_change *change = (struct config_change *)arg;
+    change->completion( 0, 0, change->overlapped, 0 );
+    CloseHandle( change->thread );
+    free( change );
+}
+
+static void CALLBACK config_changed( void *context, BOOLEAN timeout )
+{
+    struct config_change *change = context;
+
+    UnregisterWaitEx( change->wait, NULL );
+    CloseHandle( change->event );
+    change->overlapped->Internal = 0;
+    change->overlapped->InternalHigh = 0;
+    if (change->completion)
+    {
+        if (QueueUserAPC( config_change_apc, change->thread, (ULONG_PTR)change )) return;
+        CloseHandle( change->thread );
+    }
+    else if (change->overlapped->hEvent) SetEvent( change->overlapped->hEvent );
+    free( change );
+}
+
+/***********************************************************************
+ *      WSAProviderConfigChange   (ws2_32.@)
+ */
+int WINAPI WSAProviderConfigChange( HANDLE *handle, OVERLAPPED *overlapped,
+                                    LPWSAOVERLAPPED_COMPLETION_ROUTINE completion )
+{
+    static const DWORD filter = REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET;
+    struct config_change *change;
+    LSTATUS status;
+    HKEY key;
+
+    TRACE( "(%p %p %p)\n", handle, overlapped, completion );
+
+    if (!handle)
+    {
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    if (!*handle)
+    {
+        /* the first call gives the handle to wait with; it closes with CloseHandle */
+        if ((status = open_catalog( NULL, KEY_NOTIFY, FALSE, &key )) &&
+            (status = open_catalog( NULL, KEY_NOTIFY, TRUE, &key )))
+        {
+            SetLastError( reg_error( status ) );
+            return SOCKET_ERROR;
+        }
+        *handle = key;
+        return 0;
+    }
+
+    if (!overlapped)
+    {
+        if ((status = RegNotifyChangeKeyValue( *handle, TRUE, filter, NULL, FALSE )))
+        {
+            SetLastError( WSA_INVALID_HANDLE );
+            return SOCKET_ERROR;
+        }
+        return 0;
+    }
+
+    if (!(change = calloc( 1, sizeof(*change) )) || !(change->event = CreateEventW( NULL, FALSE, FALSE, NULL )))
+    {
+        free( change );
+        SetLastError( WSA_NOT_ENOUGH_MEMORY );
+        return SOCKET_ERROR;
+    }
+    change->key = *handle;
+    change->overlapped = overlapped;
+    change->completion = completion;
+    if (completion && !DuplicateHandle( GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(),
+                                        &change->thread, 0, FALSE, DUPLICATE_SAME_ACCESS ))
+        goto fail;
+#ifdef SG_MUTANT_NO_CONFIG_NOTIFY
+    ResetEvent( change->event );
+    if (FALSE)
+#else
+    if (RegNotifyChangeKeyValue( *handle, TRUE, filter, change->event, TRUE ))
+#endif
+    {
+        SetLastError( WSA_INVALID_HANDLE );
+        goto fail_set;
+    }
+    overlapped->Internal = STATUS_PENDING;
+    if (!RegisterWaitForSingleObject( &change->wait, change->event, config_changed, change, INFINITE,
+                                      WT_EXECUTEONLYONCE ))
+        goto fail;
+    SetLastError( WSA_IO_PENDING );
+    return SOCKET_ERROR;
+
+fail:
+    SetLastError( WSA_NOT_ENOUGH_MEMORY );
+fail_set:
+    if (change->thread) CloseHandle( change->thread );
+    CloseHandle( change->event );
+    free( change );
+    return SOCKET_ERROR;
 }
 
