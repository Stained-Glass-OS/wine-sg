From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ws2_32: the Winsock catalog, WSAConnectByName timeouts, WSAConnectByList, cancellable GetAddrInfoEx

The rest of the Winsock catalog API were stubs that claimed success and
did nothing (WSCInstallNameSpace, WSCEnableNSProvider, WSASetService,
WSCSetApplicationCategory, ...) or failed (service classes,
WSAProviderConfigChange); WSAConnectByName ignored its timeout and tried
only the first address; WSAConnectByList was missing; GetAddrInfoEx
ignored its timeout and GetAddrInfoExCancel never cancelled (.NET's
cancellable DNS lookups use it).

- WSAConnectByName tries each address the name resolves to, through
  ConnectEx, until one connects; the timeout covers them all and ends a
  connect in progress (WSAETIMEDOUT), whatever the socket's blocking
  mode. An IPv6 socket that is not IPv6-only reaches IPv4 hosts through
  mapped addresses. WSAConnectByList (new) does the same over a list.
- GetAddrInfoExW's asynchronous lookups can be cancelled with
  GetAddrInfoExCancel and end at their timeout: the overlapped completes
  with WSA_E_CANCELLED or WSAETIMEDOUT, the completion routine or event is
  told once, and the caller's result is not written afterwards.
- The catalog lives under HKLM\System\CurrentControlSet\Services\
  WinSock2\Parameters, and changing it takes an administrator:
  - name space providers: WSCInstallNameSpace, WSCUnInstallNameSpace (not
    the built-in ones), WSCEnableNSProvider, WSCWriteNameSpaceOrder (now
    exported); WSAEnumNameSpaceProviders lists them in order, with their
    state;
  - service classes: WSAInstallServiceClass (A/W; WSAEALREADY twice),
    WSARemoveServiceClass, WSAGetServiceClassInfo (the entries for a
    provider's name space), WSAGetServiceClassNameByClassId;
  - WSCSetApplicationCategory / WSCGetApplicationCategory;
  - WSCInstallProvider / WSCDeinstallProvider record a transport provider
    (WSCGetProviderPath gives its path); sockets are not layered through
    it, and a FIXME says so; WSCWriteProviderOrder checks and keeps the
    order;
  - WSAProviderConfigChange gives a handle, then waits, or completes an
    overlapped (event or completion routine), when the catalog changes.
- WSASetService fails as Windows does where no name space takes
  registrations, instead of claiming success.
- WSANSCLASSINFOW's name is a wide string (it was declared LPSTR).

Wine's ws2_32 tests: protocol 7806 tests, no failures (4 more todo_wine
removed, WSCGetApplicationCategory); sock 2672348 tests, the same 2
failures as before (select on a full pipe).

Gate: test/wscatalog-gate.sh (64- and 32-bit, test/wscatalog-probe.c).
Mutants SG_MUTANT_NO_CANCEL (ws2_32/protocol.c),
SG_MUTANT_CONNECT_NO_TIMEOUT (ws2_32/socket.c), SG_MUTANT_NO_CONFIG_NOTIFY
(ws2_32/nsp.c).
---
--- a/dlls/ws2_32/nsp.c
+++ b/dlls/ws2_32/nsp.c
@@ -957,13 +957,206 @@ int WINAPI WSALookupServiceEnd( HANDLE handle )
     return 0;
 }
 
+/* The Winsock catalog (Stained Glass OS 1655): name space providers
+ * installed beside the built-in ones, their order and enabled state, service
+ * classes, application categories and installed transport providers, kept
+ * under HKLM\System\CurrentControlSet\Services\WinSock2\Parameters. Changing
+ * it takes an administrator, as on Windows. Installed transport providers
+ * (layered service providers) are recorded but not loaded: sockets here do
+ * not go through layers. */
+
+static const WCHAR catalog_path[] = L"System\\CurrentControlSet\\Services\\WinSock2\\Parameters";
+
+static int reg_error( LSTATUS status )
+{
+    switch (status)
+    {
+    case ERROR_SUCCESS: return 0;
+    case ERROR_ACCESS_DENIED: return WSAEACCES;
+    case ERROR_FILE_NOT_FOUND: return WSAEINVAL;
+    case ERROR_NOT_ENOUGH_MEMORY: case ERROR_OUTOFMEMORY: return WSA_NOT_ENOUGH_MEMORY;
+    default: return WSANO_RECOVERY;
+    }
+}
+
+static LSTATUS open_catalog( const WCHAR *sub, REGSAM access, BOOL create, HKEY *key )
+{
+    WCHAR path[256];
+
+    swprintf( path, ARRAY_SIZE(path), sub ? L"%s\\%s" : L"%s", catalog_path, sub );
+    if (create) return RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, 0, access, NULL, key, NULL );
+    return RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, access, key );
+}
+
+static void guid_to_name( const GUID *guid, WCHAR *buf )
+{
+    swprintf( buf, 39, L"{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}", guid->Data1, guid->Data2,
+              guid->Data3, guid->Data4[0], guid->Data4[1], guid->Data4[2], guid->Data4[3], guid->Data4[4],
+              guid->Data4[5], guid->Data4[6], guid->Data4[7] );
+}
+
+static BOOL parse_guid( const WCHAR *str, GUID *guid )
+{
+    unsigned int d[11], i;
+
+    if (wcslen( str ) != 38 ||
+        swscanf( str, L"{%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x}", &d[0], &d[1], &d[2], &d[3], &d[4],
+                 &d[5], &d[6], &d[7], &d[8], &d[9], &d[10] ) != 11)
+        return FALSE;
+    guid->Data1 = d[0];
+    guid->Data2 = d[1];
+    guid->Data3 = d[2];
+    for (i = 0; i < 8; i++) guid->Data4[i] = d[3 + i];
+    return TRUE;
+}
+
+static LSTATUS open_catalog_entry( const WCHAR *list, const GUID *guid, REGSAM access, BOOL create, HKEY *key )
+{
+    WCHAR sub[80];
+
+    swprintf( sub, ARRAY_SIZE(sub), L"%s\\", list );
+    guid_to_name( guid, sub + wcslen( sub ) );
+    return open_catalog( sub, access, create, key );
+}
+
+static WCHAR *reg_get_string( HKEY key, const WCHAR *name )
+{
+    DWORD size = 0, type;
+    WCHAR *ret;
+
+    if (RegQueryValueExW( key, name, NULL, &type, NULL, &size ) || type != REG_SZ) return NULL;
+    if (!(ret = calloc( 1, size + sizeof(WCHAR) ))) return NULL;
+    if (RegQueryValueExW( key, name, NULL, NULL, (BYTE *)ret, &size ))
+    {
+        free( ret );
+        return NULL;
+    }
+    return ret;
+}
+
+static DWORD reg_get_dword( HKEY key, const WCHAR *name, DWORD def )
+{
+    DWORD size = sizeof(DWORD), value;
+    if (RegQueryValueExW( key, name, NULL, NULL, (BYTE *)&value, &size ) || size != sizeof(DWORD)) return def;
+    return value;
+}
+
+struct ns_provider
+{
+    GUID id;
+    DWORD name_space;
+    BOOL active;
+    DWORD version;
+    WCHAR *identifier;
+    WCHAR *path;
+    BOOL builtin;
+};
+
+static void free_ns_providers( struct ns_provider *list, unsigned int count )
+{
+    while (count--)
+    {
+        free( list[count].identifier );
+        free( list[count].path );
+    }
+    free( list );
+}
+
+/* the built-in providers, then the installed ones, in the written order */
+static unsigned int get_ns_providers( struct ns_provider **ret )
+{
+    struct ns_provider *list;
+    unsigned int count = 0, i, j;
+    WCHAR name[64];
+    DWORD index, size;
+    GUID *order;
+    HKEY key, sub;
+
+    if (!(list = calloc( ARRAY_SIZE(providers), sizeof(*list) ))) return 0;
+    for (i = 0; i < ARRAY_SIZE(providers); i++, count++)
+    {
+        list[i].id = *providers[i].id;
+        list[i].name_space = providers[i].name_space;
+        list[i].active = TRUE;
+        list[i].version = 1;
+        list[i].identifier = strdupW( providers[i].identifier );
+        list[i].path = strdupW( L"%SystemRoot%\\system32\\mswsock.dll" );
+        list[i].builtin = TRUE;
+    }
+
+    if (!open_catalog( L"NameSpaces", KEY_READ, FALSE, &key ))
+    {
+        for (index = 0; size = ARRAY_SIZE(name), !RegEnumKeyExW( key, index, name, &size, NULL, NULL, NULL, NULL ); index++)
+        {
+            struct ns_provider *grown;
+            GUID id;
+
+            if (!parse_guid( name, &id )) continue;
+            if (RegOpenKeyExW( key, name, 0, KEY_READ, &sub )) continue;
+            for (i = 0; i < count; i++) if (IsEqualGUID( &list[i].id, &id )) break;
+            if (i < count)  /* a built-in provider's state */
+            {
+                list[i].active = reg_get_dword( sub, L"Enabled", TRUE ) != 0;
+                RegCloseKey( sub );
+                continue;
+            }
+            if (!(grown = realloc( list, (count + 1) * sizeof(*list) )))
+            {
+                RegCloseKey( sub );
+                break;
+            }
+            list = grown;
+            memset( &list[count], 0, sizeof(*list) );
+            list[count].id = id;
+            list[count].name_space = reg_get_dword( sub, L"NameSpace", 0 );
+            list[count].version = reg_get_dword( sub, L"Version", 0 );
+            list[count].active = reg_get_dword( sub, L"Enabled", TRUE ) != 0;
+            list[count].identifier = reg_get_string( sub, L"Identifier" );
+            list[count].path = reg_get_string( sub, L"Path" );
+            if (!list[count].identifier) list[count].identifier = strdupW( L"" );
+            count++;
+            RegCloseKey( sub );
+        }
+
+        /* WSCWriteNameSpaceOrder */
+        size = 0;
+        if (!RegQueryValueExW( key, L"Order", NULL, NULL, NULL, &size ) && size && (order = malloc( size )))
+        {
+            unsigned int n = size / sizeof(GUID), pos = 0;
+            if (!RegQueryValueExW( key, L"Order", NULL, NULL, (BYTE *)order, &size ))
+            {
+                for (j = 0; j < n; j++)
+                {
+                    for (i = pos; i < count; i++)
+                    {
+                        if (!IsEqualGUID( &list[i].id, &order[j] )) continue;
+                        if (i != pos)
+                        {
+                            struct ns_provider tmp = list[i];
+                            memmove( &list[pos + 1], &list[pos], (i - pos) * sizeof(*list) );
+                            list[pos] = tmp;
+                        }
+                        pos++;
+                        break;
+                    }
+                }
+            }
+            free( order );
+        }
+        RegCloseKey( key );
+    }
+    *ret = list;
+    return count;
+}
+
 /***********************************************************************
  *      WSAEnumNameSpaceProvidersW   (ws2_32.@)
  */
 int WINAPI WSAEnumNameSpaceProvidersW( DWORD *len, WSANAMESPACE_INFOW *buffer )
 {
-    size_t size = ARRAY_SIZE(providers) * sizeof(*buffer);
-    unsigned int i;
+    struct ns_provider *list;
+    unsigned int count, i;
+    size_t size;
     WCHAR *str;
 
     TRACE( "(%p %p)\n", len, buffer );
@@ -973,25 +1166,32 @@ int WINAPI WSAEnumNameSpaceProvidersW( DWORD *len, WSANAMESPACE_INFOW *buffer )
         SetLastError( WSAEFAULT );
         return SOCKET_ERROR;
     }
-    for (i = 0; i < ARRAY_SIZE(providers); i++) size += (wcslen( providers[i].identifier ) + 1) * sizeof(WCHAR);
+    count = get_ns_providers( &list );
+#ifdef SG_MUTANT_NO_INSTALLED_NS
+    count = min( count, ARRAY_SIZE(providers) );
+#endif
+    size = count * sizeof(*buffer);
+    for (i = 0; i < count; i++) size += (wcslen( list[i].identifier ) + 1) * sizeof(WCHAR);
     if (!buffer || *len < size)
     {
+        free_ns_providers( list, count );
         *len = size;
         SetLastError( WSAEFAULT );
         return SOCKET_ERROR;
     }
-    str = (WCHAR *)(buffer + ARRAY_SIZE(providers));
-    for (i = 0; i < ARRAY_SIZE(providers); i++)
+    str = (WCHAR *)(buffer + count);
+    for (i = 0; i < count; i++)
     {
-        buffer[i].NSProviderId = *providers[i].id;
-        buffer[i].dwNameSpace = providers[i].name_space;
-        buffer[i].fActive = TRUE;
-        buffer[i].dwVersion = 1;
+        buffer[i].NSProviderId = list[i].id;
+        buffer[i].dwNameSpace = list[i].name_space;
+        buffer[i].fActive = list[i].active;
+        buffer[i].dwVersion = list[i].version;
         buffer[i].lpszIdentifier = str;
-        wcscpy( str, providers[i].identifier );
+        wcscpy( str, list[i].identifier );
         str += wcslen( str ) + 1;
     }
-    return ARRAY_SIZE(providers);
+    free_ns_providers( list, count );
+    return count;
 }
 
 /***********************************************************************
@@ -999,8 +1199,9 @@ int WINAPI WSAEnumNameSpaceProvidersW( DWORD *len, WSANAMESPACE_INFOW *buffer )
  */
 int WINAPI WSAEnumNameSpaceProvidersA( DWORD *len, WSANAMESPACE_INFOA *buffer )
 {
-    size_t size = ARRAY_SIZE(providers) * sizeof(*buffer);
-    unsigned int i;
+    struct ns_provider *list;
+    unsigned int count, i;
+    size_t size;
     char *str;
 
     TRACE( "(%p %p)\n", len, buffer );
@@ -1010,26 +1211,903 @@ int WINAPI WSAEnumNameSpaceProvidersA( DWORD *len, WSANAMESPACE_INFOA *buffer )
         SetLastError( WSAEFAULT );
         return SOCKET_ERROR;
     }
-    for (i = 0; i < ARRAY_SIZE(providers); i++)
-        size += WideCharToMultiByte( CP_ACP, 0, providers[i].identifier, -1, NULL, 0, NULL, NULL );
