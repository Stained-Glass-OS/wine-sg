+/***********************************************************************
+ *      WSAInstallServiceClassW   (ws2_32.@)
+ */
+int WINAPI WSAInstallServiceClassW( WSASERVICECLASSINFOW *info )
+{
+    LSTATUS status;
+    DWORD disp, size, i;
+    WCHAR full[256], name[40];
+    BYTE *infos;
+    HKEY key;
+
+    TRACE( "(%p)\n", info );
+
+    if (!info || !info->lpServiceClassId || !info->lpszServiceClassName || (info->dwCount && !info->lpClassInfos))
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    for (i = 0; i < info->dwCount; i++)
+        if (!info->lpClassInfos[i].lpszName || (info->lpClassInfos[i].dwValueSize && !info->lpClassInfos[i].lpValue))
+        {
+            SetLastError( WSAEINVAL );
+            return SOCKET_ERROR;
+        }
+    if (!(infos = serialize_class_infos( info, &size )))
+    {
+        SetLastError( WSA_NOT_ENOUGH_MEMORY );
+        return SOCKET_ERROR;
+    }
+    guid_to_name( info->lpServiceClassId, name );
+    swprintf( full, ARRAY_SIZE(full), L"%s\\ServiceClasses\\%s", catalog_path, name );
+    if ((status = RegCreateKeyExW( HKEY_LOCAL_MACHINE, full, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, &disp )))
+    {
+        free( infos );
+        SetLastError( reg_error( status ) );
+        return SOCKET_ERROR;
+    }
+    if (disp == REG_OPENED_EXISTING_KEY)
+    {
+        free( infos );
+        RegCloseKey( key );
+        SetLastError( WSAEALREADY );
+        return SOCKET_ERROR;
+    }
+    RegSetValueExW( key, L"Name", 0, REG_SZ, (BYTE *)info->lpszServiceClassName,
+                    (wcslen( info->lpszServiceClassName ) + 1) * sizeof(WCHAR) );
+    RegSetValueExW( key, L"Infos", 0, REG_BINARY, infos, size );
+    RegCloseKey( key );
+    free( infos );
+    return 0;
+}
+
+/***********************************************************************
+ *      WSAInstallServiceClassA   (ws2_32.@)
+ */
+int WINAPI WSAInstallServiceClassA( WSASERVICECLASSINFOA *info )
+{
+    WSASERVICECLASSINFOW infoW;
+    WSANSCLASSINFOW *classes = NULL;
+    BOOL ok = TRUE;
+    DWORD i;
+    int ret;
+
+    TRACE( "(%p)\n", info );
+
+    if (!info || !info->lpServiceClassId || !info->lpszServiceClassName || (info->dwCount && !info->lpClassInfos))
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    infoW.lpServiceClassId = info->lpServiceClassId;
+    infoW.lpszServiceClassName = strdupAtoW( info->lpszServiceClassName );
+    infoW.dwCount = info->dwCount;
+    if (info->dwCount && !(classes = calloc( info->dwCount, sizeof(*classes) ))) ok = FALSE;
+    for (i = 0; ok && i < info->dwCount; i++)
+    {
+        classes[i].lpszName = strdupAtoW( info->lpClassInfos[i].lpszName );
+        classes[i].dwNameSpace = info->lpClassInfos[i].dwNameSpace;
+        classes[i].dwValueType = info->lpClassInfos[i].dwValueType;
+        classes[i].dwValueSize = info->lpClassInfos[i].dwValueSize;
+        classes[i].lpValue = info->lpClassInfos[i].lpValue;
+        if (info->lpClassInfos[i].lpszName && !classes[i].lpszName) ok = FALSE;
+    }
+    infoW.lpClassInfos = classes;
+    if (ok && infoW.lpszServiceClassName) ret = WSAInstallServiceClassW( &infoW );
+    else
+    {
+        SetLastError( WSA_NOT_ENOUGH_MEMORY );
+        ret = SOCKET_ERROR;
+    }
+    for (i = 0; classes && i < info->dwCount; i++) free( classes[i].lpszName );
+    free( classes );
+    free( infoW.lpszServiceClassName );
+    return ret;
+}
