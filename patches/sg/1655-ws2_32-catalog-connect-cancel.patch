+/***********************************************************************
+ *      WSASetServiceW   (ws2_32.@)
+ */
+int WINAPI WSASetServiceW( WSAQUERYSETW *query, WSAESETSERVICEOP operation, DWORD flags )
+{
+    TRACE( "(%p %#x %#lx)\n", query, operation, flags );
+
+    if (!query || query->dwSize < sizeof(*query) || !query->lpServiceClassId || operation > RNRSERVICE_DELETE)
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    /* the name spaces here (DNS, the network list) do not take registrations:
+     * those go to a directory (NS_NTDS) or SAP, which this machine has not */
+    SetLastError( operation == RNRSERVICE_REGISTER ? WSAEINVAL : WSASERVICE_NOT_FOUND );
+    return SOCKET_ERROR;
+}
+
+/***********************************************************************
+ *      WSASetServiceA   (ws2_32.@)
+ */
+int WINAPI WSASetServiceA( WSAQUERYSETA *query, WSAESETSERVICEOP operation, DWORD flags )
+{
+    TRACE( "(%p %#x %#lx)\n", query, operation, flags );
+
+    if (!query || query->dwSize < sizeof(*query) || !query->lpServiceClassId || operation > RNRSERVICE_DELETE)
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    SetLastError( operation == RNRSERVICE_REGISTER ? WSAEINVAL : WSASERVICE_NOT_FOUND );
+    return SOCKET_ERROR;
+}
