+/* Stained Glass OS 1655: connect to the first of the addresses that answers,
+ * within the timeout, through ConnectEx, so a timeout can stop a connect in
+ * progress whatever the socket's blocking mode. */
+static BOOL connect_to_any( SOCKET s, int family, const SOCKET_ADDRESS *addrs, unsigned int count,
+                            const struct timeval *timeout, unsigned int *connected )
+{
+    GUID connectex_guid = WSAID_CONNECTEX;
+    LPFN_CONNECTEX connectex;
+    ULONGLONG deadline = 0;
+    SOCKADDR_STORAGE local;
+    int len, err = WSAEADDRNOTAVAIL;
