     if (!buffer || *len < size)
     {
+        free_ns_providers( list, count );
         *len = size;
         SetLastError( WSAEFAULT );
         return SOCKET_ERROR;
     }
-    str = (char *)(buffer + ARRAY_SIZE(providers));
-    for (i = 0; i < ARRAY_SIZE(providers); i++)
+    str = (char *)(buffer + count);
+    for (i = 0; i < count; i++)
     {
-        buffer[i].NSProviderId = *providers[i].id;
-        buffer[i].dwNameSpace = providers[i].name_space;
-        buffer[i].fActive = TRUE;
-        buffer[i].dwVersion = 1;
+        buffer[i].NSProviderId = list[i].id;
+        buffer[i].dwNameSpace = list[i].name_space;
