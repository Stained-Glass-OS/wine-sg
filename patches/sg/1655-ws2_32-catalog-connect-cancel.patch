+/* the class's name and serialized infos */
+static int read_service_class( const GUID *class_id, WCHAR **name, BYTE **infos, DWORD *size )
+{
+    HKEY key;
+
+    *infos = NULL;
+    if (!class_id) return WSAEINVAL;
+    if (open_catalog_entry( L"ServiceClasses", class_id, KEY_READ, FALSE, &key )) return WSATYPE_NOT_FOUND;
+    *name = reg_get_string( key, L"Name" );
+    *size = 0;
+    if (!RegQueryValueExW( key, L"Infos", NULL, NULL, NULL, size ) && *size >= sizeof(DWORD) &&
+        (*infos = malloc( *size )))
+        RegQueryValueExW( key, L"Infos", NULL, NULL, *infos, size );
+    RegCloseKey( key );
+    if (!*name || !*infos)
+    {
+        free( *name );
+        free( *infos );
+        return WSATYPE_NOT_FOUND;
+    }
+    return 0;
+}
+
+static int get_class_info( GUID *provider, GUID *service, DWORD *len, BYTE *out, BOOL ansi )
+{
+    struct ns_provider *list;
+    unsigned int count, i;
+    DWORD name_space = 0, size, n, kept = 0;
+    WCHAR *name;
+    BYTE *infos, *q;
+    size_t need, off;
+    int err;
+
+    if (!len || !provider || !service) return WSAEFAULT;
+    count = get_ns_providers( &list );
+    for (i = 0; i < count; i++) if (IsEqualGUID( &list[i].id, provider )) name_space = list[i].name_space;
+    free_ns_providers( list, count );
+    if (!name_space) return WSAEINVAL;
+    if ((err = read_service_class( service, &name, &infos, &size ))) return err;
+
+    /* the entries for this provider's name space */
+    n = *(DWORD *)infos;
+    need = sizeof(WSASERVICECLASSINFOW) + sizeof(GUID) + string_size( name, ansi );
+    for (i = 0, q = infos + sizeof(DWORD); i < n; i++)
+    {
+        DWORD *p = (DWORD *)q;
+        if (p[0] == name_space || p[0] == NS_ALL)
+        {
+            kept++;
+            need += sizeof(WSANSCLASSINFOW) + string_size( (WCHAR *)(q + 4 * sizeof(DWORD)), ansi ) + p[2] + sizeof(void *);
+        }
+        q += 4 * sizeof(DWORD) + p[3] + p[2];
+    }
+    if (!out || *len < need)
+    {
+        *len = need;
+        free( name );
+        free( infos );
+        return WSAEFAULT;
+    }
+
+    {
+        WSASERVICECLASSINFOW *ci = (WSASERVICECLASSINFOW *)out;
+        WSANSCLASSINFOW *classes;
+
+        off = sizeof(*ci);
+        ci->lpServiceClassId = (GUID *)(out + off);
+        *ci->lpServiceClassId = *service;
+        off += sizeof(GUID);
+        off = ALIGN_PTR( off );
+        classes = (WSANSCLASSINFOW *)(out + off);
+        ci->lpClassInfos = classes;
+        ci->dwCount = kept;
+        off += kept * sizeof(*classes);
+        ci->lpszServiceClassName = put_string( out, &off, name, ansi );
+        for (i = 0, kept = 0, q = infos + sizeof(DWORD); i < n; i++)
+        {
+            DWORD *p = (DWORD *)q;
+            if (p[0] == name_space || p[0] == NS_ALL)
+            {
+                classes[kept].dwNameSpace = p[0];
+                classes[kept].dwValueType = p[1];
+                classes[kept].dwValueSize = p[2];
+                classes[kept].lpszName = put_string( out, &off, (WCHAR *)(q + 4 * sizeof(DWORD)), ansi );
+                off = ALIGN_PTR( off );
+                classes[kept].lpValue = p[2] ? out + off : NULL;
+                memcpy( out + off, q + 4 * sizeof(DWORD) + p[3], p[2] );
+                off += p[2];
+                kept++;
+            }
+            q += 4 * sizeof(DWORD) + p[3] + p[2];
+        }
+    }
+    free( name );
+    free( infos );
+    return 0;
+}
+
+/***********************************************************************
+ *      WSAGetServiceClassInfoW   (ws2_32.@)
+ */
+int WINAPI WSAGetServiceClassInfoW( GUID *provider, GUID *service, DWORD *len, WSASERVICECLASSINFOW *info )
+{
+    int err;
+
+    TRACE( "(%s %s %p %p)\n", debugstr_guid(provider), debugstr_guid(service), len, info );
+
+    if ((err = get_class_info( provider, service, len, (BYTE *)info, FALSE )))
+    {
+        SetLastError( err );
+        return SOCKET_ERROR;
+    }
+    return 0;
+}
+
+/***********************************************************************
+ *      WSAGetServiceClassInfoA   (ws2_32.@)
+ */
+int WINAPI WSAGetServiceClassInfoA( GUID *provider, GUID *service, DWORD *len, WSASERVICECLASSINFOA *info )
+{
+    int err;
+
+    C_ASSERT( sizeof(WSASERVICECLASSINFOA) == sizeof(WSASERVICECLASSINFOW) );
+
+    TRACE( "(%s %s %p %p)\n", debugstr_guid(provider), debugstr_guid(service), len, info );
+
+    if ((err = get_class_info( provider, service, len, (BYTE *)info, TRUE )))
+    {
+        SetLastError( err );
+        return SOCKET_ERROR;
+    }
+    return 0;
+}
+
+/***********************************************************************
+ *      WSAGetServiceClassNameByClassIdW   (ws2_32.@)
+ */
+int WINAPI WSAGetServiceClassNameByClassIdW( GUID *class_id, WCHAR *service, DWORD *len )
+{
+    WCHAR *name;
+    BYTE *infos;
+    DWORD size, need;
+    int err;
+
+    TRACE( "(%s %p %p)\n", debugstr_guid(class_id), service, len );
+
+    if (!len)
+    {
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    if ((err = read_service_class( class_id, &name, &infos, &size )))
+    {
+        SetLastError( err );
+        return SOCKET_ERROR;
+    }
+    free( infos );
+    need = wcslen( name ) + 1;
+    if (!service || *len < need)
+    {
+        *len = need;
+        free( name );
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    wcscpy( service, name );
+    *len = need;
+    free( name );
+    return 0;
+}
+
+/***********************************************************************
+ *      WSAGetServiceClassNameByClassIdA   (ws2_32.@)
+ */
+int WINAPI WSAGetServiceClassNameByClassIdA( GUID *class_id, char *service, DWORD *len )
+{
+    WCHAR *name;
+    BYTE *infos;
+    DWORD size, need;
+    int err;
+
+    TRACE( "(%s %p %p)\n", debugstr_guid(class_id), service, len );
+
+    if (!len)
+    {
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    if ((err = read_service_class( class_id, &name, &infos, &size )))
+    {
+        SetLastError( err );
+        return SOCKET_ERROR;
+    }
+    free( infos );
+    need = WideCharToMultiByte( CP_ACP, 0, name, -1, NULL, 0, NULL, NULL );
+    if (!service || *len < need)
+    {
+        *len = need;
+        free( name );
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    WideCharToMultiByte( CP_ACP, 0, name, -1, service, *len, NULL, NULL );
+    *len = need;
+    free( name );
+    return 0;
+}
