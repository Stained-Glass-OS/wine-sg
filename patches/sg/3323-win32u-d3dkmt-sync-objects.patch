+/* ---- synchronization objects ----
+ *
+ * The state of a synchronization object (its type, flags, limit and value) is in the header of its block, like
+ * the state of a keyed mutex, so a shared one is the same object in every process: a mutex is signaled or not, a
+ * semaphore has a count, a fence has a value. A CPU notification object only sets an event of the process that
+ * made it. */
+
+#define STATUS_SEMAPHORE_LIMIT_EXCEEDED_VALUE ((NTSTATUS)0xC0000047)
+#define KMT_MAX_SYNC_OBJECTS 32
+
+struct kmt_sync_info
+{
+    UINT type, flags;
+    BOOL initial_state;
+    UINT max_count, initial_count;
+    UINT64 fence;
+    HANDLE event;
+};
+
+static NTSTATUS kmt_sync_validate( const struct kmt_sync_info *info )
+{
+    D3DDDI_SYNCHRONIZATIONOBJECT_FLAGS flags;
+
+    flags.Value = info->flags;
+    switch (info->type)
+    {
+    case D3DDDI_SYNCHRONIZATION_MUTEX:
+    case D3DDDI_FENCE:
+    case D3DDDI_MONITORED_FENCE:
+        break;
+    case D3DDDI_SEMAPHORE:
+        if (!info->max_count || info->initial_count > info->max_count) return STATUS_INVALID_PARAMETER;
+        break;
+    case D3DDDI_CPU_NOTIFICATION:
+        /* an event of this process cannot be shared */
+        if (!info->event || flags.Shared) return STATUS_INVALID_PARAMETER;
+        break;
+    case D3DDDI_PERIODIC_MONITORED_FENCE:
+        return STATUS_NOT_SUPPORTED;
+    default:
+        return STATUS_INVALID_PARAMETER;
+    }
+    if (flags.NtSecuritySharing && !flags.Shared) return STATUS_INVALID_PARAMETER;
+    return STATUS_SUCCESS;
+}
+
+/* d3dkmt_lock must be held */
+static void kmt_sync_init_state( struct kmt_share_header *hdr, const struct kmt_sync_info *info )
+{
+    hdr->sync_type = info->type;
+    hdr->sync_flags = info->flags;
+    hdr->sync_max = info->max_count;
+    switch (info->type)
+    {
+    case D3DDDI_SYNCHRONIZATION_MUTEX: hdr->sync_value = info->initial_state ? 1 : 0; break;
+    case D3DDDI_SEMAPHORE: hdr->sync_value = info->initial_count; break;
+    case D3DDDI_FENCE:
+    case D3DDDI_MONITORED_FENCE: hdr->sync_value = info->fence; break;
+    default: hdr->sync_value = 0; break;
+    }
+}
+
+static NTSTATUS kmt_create_sync( D3DKMT_HANDLE device, const struct kmt_sync_info *info, D3DKMT_HANDLE *handle,
+                                 UINT *shared, void **cpu_address )
+{
+    D3DDDI_SYNCHRONIZATIONOBJECT_FLAGS flags;
+    struct kmt_object *object;
+    struct kmt_block *block;
+    UINT id = 0;
+    NTSTATUS status;
+
+    if (!handle) return STATUS_INVALID_PARAMETER;
+    if ((status = kmt_sync_validate( info ))) return status;
+    flags.Value = info->flags;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if (!kmt_device_exists( device )) status = STATUS_INVALID_PARAMETER;
+    else if (!(status = kmt_block_create( KMT_SHARE_SYNC, NULL, 0, NULL, 0, 0, NULL, NULL,
+                                          (flags.Shared && !flags.NtSecuritySharing) ? &id : NULL, &block )))
+    {
+        kmt_sync_init_state( block->hdr, info );
+        if (!(object = kmt_object_new( KMT_SYNC, device, block ))) status = STATUS_NO_MEMORY;
+        else
+        {
+            object->nt_sharing = flags.NtSecuritySharing;
+            object->event = info->event;
+            *handle = object->handle;
+            if (shared) *shared = id;
+            if (cpu_address) *cpu_address = &block->hdr->sync_value;
+        }
+        kmt_block_unref( block );
+    }
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
+}
+
