+    switch (info.type)
+    {
+    case D3DDDI_SYNCHRONIZATION_MUTEX: info.initial_state = params->Info.SynchronizationMutex.InitialState; break;
+    case D3DDDI_SEMAPHORE:
+        info.max_count = params->Info.Semaphore.MaxCount;
+        info.initial_count = params->Info.Semaphore.InitialCount;
+        break;
+    case D3DDDI_FENCE: info.fence = params->Info.Fence.FenceValue; break;
+    case D3DDDI_CPU_NOTIFICATION: info.event = params->Info.CPUNotification.Event; break;
+    case D3DDDI_MONITORED_FENCE: info.fence = params->Info.MonitoredFence.InitialFenceValue; break;
+    }
+    status = kmt_create_sync( params->hDevice, &info, &params->hSyncObject, &params->Info.SharedHandle,
+                              info.type == D3DDDI_MONITORED_FENCE ? &cpu_address : NULL );
+    if (!status && info.type == D3DDDI_MONITORED_FENCE)
+        params->Info.MonitoredFence.FenceValueCPUVirtualAddress = cpu_address;
+    return status;
