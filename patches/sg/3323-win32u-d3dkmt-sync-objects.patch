+/* A synchronization object of a block that has one. The block's reference stays with the caller. */
+static NTSTATUS kmt_sync_open( D3DKMT_HANDLE device, struct kmt_block *block, D3DKMT_HANDLE *handle,
+                               void **cpu_address )
+{
+    struct kmt_object *object;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    if (!(block->hdr->flags & KMT_SHARE_SYNC) || !handle) return STATUS_INVALID_PARAMETER;
+    pthread_mutex_lock( &d3dkmt_lock );
+    if (device && !kmt_device_exists( device )) status = STATUS_INVALID_PARAMETER;
+    else if (!(object = kmt_object_new( KMT_SYNC, device, block ))) status = STATUS_NO_MEMORY;
+    else
+    {
+        object->nt_sharing = TRUE;
+        *handle = object->handle;
+        if (cpu_address) *cpu_address = &block->hdr->sync_value;
+    }
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
 }
 
