+ *           NtGdiDdDDISignalSynchronizationObjectFromCpu    (win32u.@)
+ */
+NTSTATUS WINAPI NtGdiDdDDISignalSynchronizationObjectFromCpu( const D3DKMT_SIGNALSYNCHRONIZATIONOBJECTFROMCPU *params )
+{
+    struct kmt_object *objects[KMT_MAX_SYNC_OBJECTS];
+    struct kmt_block *blocks[KMT_MAX_SYNC_OBJECTS];
+    HANDLE events[KMT_MAX_SYNC_OBJECTS];
+    NTSTATUS status;
+    UINT i;
+
+    TRACE( "params %p\n", params );
+    if (!params || !params->ObjectCount || params->ObjectCount > KMT_MAX_SYNC_OBJECTS || !params->ObjectHandleArray
+        || !params->FenceValueArray)
+        return STATUS_INVALID_PARAMETER;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    status = kmt_sync_collect( params->hDevice, params->ObjectCount, params->ObjectHandleArray, objects, blocks, events );
+    pthread_mutex_unlock( &d3dkmt_lock );
+    if (status) return status;
+
+    /* a fence only goes up, unless it is allowed to be rewound; checked for all of them before one is signaled */
+    for (i = 0; i < params->ObjectCount && !status; i++)
+    {
+        struct kmt_share_header *hdr = blocks[i]->hdr;
+
+        if ((hdr->sync_type == D3DDDI_FENCE || hdr->sync_type == D3DDDI_MONITORED_FENCE)
+            && !params->Flags.AllowFenceRewind
+#ifndef SG_MUTANT_KMT_SYNC_REWIND
+            && params->FenceValueArray[i] <= __atomic_load_n( &hdr->sync_value, __ATOMIC_SEQ_CST )
+#else
+            && FALSE
+#endif
+            )
+            status = STATUS_INVALID_PARAMETER;
+#ifndef SG_MUTANT_KMT_SYNC_NOLIMIT
+        else if (hdr->sync_type == D3DDDI_SEMAPHORE && __atomic_load_n( &hdr->sync_value, __ATOMIC_SEQ_CST ) >= hdr->sync_max)
+            status = STATUS_SEMAPHORE_LIMIT_EXCEEDED_VALUE;
+#endif
+    }
+    for (i = 0; i < params->ObjectCount && !status; i++)
+    {
+        struct kmt_share_header *hdr = blocks[i]->hdr;
+
+        switch (hdr->sync_type)
+        {
+        case D3DDDI_SYNCHRONIZATION_MUTEX:
+            __atomic_store_n( &hdr->sync_value, 1, __ATOMIC_SEQ_CST );
+            break;
+        case D3DDDI_SEMAPHORE:
+            __atomic_add_fetch( &hdr->sync_value, 1, __ATOMIC_SEQ_CST );
+            break;
+        case D3DDDI_FENCE:
+        case D3DDDI_MONITORED_FENCE:
+            __atomic_store_n( &hdr->sync_value, params->FenceValueArray[i], __ATOMIC_SEQ_CST );
+            break;
+        case D3DDDI_CPU_NOTIFICATION:
+            if (events[i]) NtSetEvent( events[i], NULL );
+            break;
+        }
+    }
+    pthread_mutex_lock( &d3dkmt_lock );
+    for (i = 0; i < params->ObjectCount; i++) kmt_block_unref( blocks[i] );
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
+}
+
+/* whether a wait on an object ends now, and takes the object if it is a mutex or a semaphore */
+static BOOL kmt_sync_satisfied( struct kmt_share_header *hdr, UINT64 value, BOOL take )
+{
+    UINT64 current = __atomic_load_n( &hdr->sync_value, __ATOMIC_SEQ_CST );
+
+    switch (hdr->sync_type)
+    {
+    case D3DDDI_FENCE:
+    case D3DDDI_MONITORED_FENCE:
+        return current >= value;
+    case D3DDDI_SYNCHRONIZATION_MUTEX:
+    case D3DDDI_SEMAPHORE:
+        if (!current) return FALSE;
+        if (!take) return TRUE;
+        return __atomic_compare_exchange_n( &hdr->sync_value, &current, current - 1, FALSE, __ATOMIC_SEQ_CST,
+                                            __ATOMIC_SEQ_CST );
+    }
+    return FALSE;
+}
+
+static void kmt_sync_give_back( struct kmt_share_header *hdr )
+{
+    if (hdr->sync_type == D3DDDI_SYNCHRONIZATION_MUTEX || hdr->sync_type == D3DDDI_SEMAPHORE)
+        __atomic_add_fetch( &hdr->sync_value, 1, __ATOMIC_SEQ_CST );
+}
+
+/******************************************************************************
+ *           NtGdiDdDDIWaitForSynchronizationObjectFromCpu    (win32u.@)
+ */
+NTSTATUS WINAPI NtGdiDdDDIWaitForSynchronizationObjectFromCpu( const D3DKMT_WAITFORSYNCHRONIZATIONOBJECTFROMCPU *params )
+{
+    struct kmt_object *objects[KMT_MAX_SYNC_OBJECTS];
+    struct kmt_block *blocks[KMT_MAX_SYNC_OBJECTS];
+    HANDLE events[KMT_MAX_SYNC_OBJECTS];
+    NTSTATUS status;
+    UINT i, j, polls = 0;
+    BOOL any;
+
+    TRACE( "params %p\n", params );
+    if (!params || !params->ObjectCount || params->ObjectCount > KMT_MAX_SYNC_OBJECTS || !params->ObjectHandleArray
+        || !params->FenceValueArray)
+        return STATUS_INVALID_PARAMETER;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    status = kmt_sync_collect( params->hDevice, params->ObjectCount, params->ObjectHandleArray, objects, blocks, events );
+    pthread_mutex_unlock( &d3dkmt_lock );
+    if (status) return status;
+
+    any = params->Flags.WaitAny;
+#ifdef SG_MUTANT_KMT_SYNC_ANYALL
+    any = TRUE;
+#endif
+    for (i = 0; i < params->ObjectCount && !status; i++)
+        if (blocks[i]->hdr->sync_type == D3DDDI_CPU_NOTIFICATION) status = STATUS_INVALID_PARAMETER;
+
+    /* waiting for an event of the caller to be set later would take a thread of our own */
+    for (;;)
+    {
+        BOOL done = FALSE;
+
+        if (status) break;
+        if (any)
+        {
+            for (i = 0; i < params->ObjectCount; i++)
+                if (kmt_sync_satisfied( blocks[i]->hdr, params->FenceValueArray[i], TRUE )) { done = TRUE; break; }
+        }
+        else
+        {
+            for (i = 0; i < params->ObjectCount; i++)
+                if (!kmt_sync_satisfied( blocks[i]->hdr, params->FenceValueArray[i], FALSE )) break;
+            if (i == params->ObjectCount)
+            {
+                /* all of them: take the mutexes and semaphores, and start again if one was taken by another */
+                for (i = 0; i < params->ObjectCount; i++)
+                    if (!kmt_sync_satisfied( blocks[i]->hdr, params->FenceValueArray[i], TRUE )) break;
+                if (i == params->ObjectCount) done = TRUE;
+                else for (j = 0; j < i; j++) kmt_sync_give_back( blocks[j]->hdr );
+            }
+        }
+        if (done) break;
+        if (params->hAsyncEvent)
+        {
+            status = STATUS_NOT_SUPPORTED;
+            break;
+        }
+        kmt_poll_sleep( polls++ );
+    }
+    if (!status && params->hAsyncEvent) NtSetEvent( params->hAsyncEvent, NULL );
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    for (i = 0; i < params->ObjectCount; i++) kmt_block_unref( blocks[i] );
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
 }
