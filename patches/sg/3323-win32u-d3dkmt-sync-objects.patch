+/* d3dkmt_lock must be held. The objects of a list that are all of this device's; their blocks get a reference. */
+static NTSTATUS kmt_sync_collect( D3DKMT_HANDLE device, UINT count, const D3DKMT_HANDLE *handles,
+                                  struct kmt_object **objects, struct kmt_block **blocks, HANDLE *events )
+{
+    UINT i;
+
+    if (!kmt_device_exists( device )) return STATUS_INVALID_PARAMETER;
+    for (i = 0; i < count; i++)
+    {
+        if (!(objects[i] = kmt_find( handles[i], KMT_SYNC ))) return STATUS_INVALID_PARAMETER;
+        blocks[i] = objects[i]->block;
+        events[i] = objects[i]->event;
+    }
+    for (i = 0; i < count; i++) blocks[i]->ref++;
+    return STATUS_SUCCESS;
+}
