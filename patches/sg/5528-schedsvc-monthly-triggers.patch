From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] schedsvc: ScheduleByMonth and ScheduleByMonthDayOfWeek triggers

The schedule service turned a monthly calendar trigger off ("is not
implemented; the trigger is off"), so a task that was to run on the first of
each month never ran. It now reads both forms from the task XML and runs
them: ScheduleByMonth with DaysOfMonth (Day 1-31 or Last) and Months, and
ScheduleByMonthDayOfWeek with Weeks (Week 1-4 or Last), DaysOfWeek and
Months. The runs are at the start boundary's time of day, never before the
start boundary, and appear in GetRunTimes / NextRunTime like the daily and
weekly ones.
---
--- a/dlls/schedsvc/taskrun.c
+++ b/dlls/schedsvc/taskrun.c
@@ -73,7 +73,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(schedsvc);
 #define NEVER            (~0ULL)
 #define RUN_IGNORE_CONSTRAINTS 0x2   /* TASK_RUN_IGNORE_CONSTRAINTS */
 
-enum trigger_kind { TRIGGER_TIME, TRIGGER_DAILY, TRIGGER_WEEKLY, TRIGGER_BOOT, TRIGGER_LOGON, TRIGGER_REGISTRATION };
+enum trigger_kind { TRIGGER_TIME, TRIGGER_DAILY, TRIGGER_WEEKLY, TRIGGER_MONTHLY, TRIGGER_MONTHLY_DOW, TRIGGER_BOOT, TRIGGER_LOGON, TRIGGER_REGISTRATION };
 
 struct run_trigger
 {
@@ -84,6 +84,11 @@ struct run_trigger
     ULONGLONG delay;
     ULONGLONG event;                /* when a boot, log-on or registration trigger fired (+ delay); 0 = not */
     int days_interval, weeks_interval, days_of_week;
+    int months;                     /* monthly kinds: bit 0 = January ... bit 11 = December */
+    unsigned int days_of_month;     /* ScheduleByMonth: bit 0 = day 1 ... bit 30 = day 31 */
+    BOOL last_day;                  /* ... and the last day of the month */
+    int weeks_of_month;             /* ScheduleByMonthDayOfWeek: bit 0 = first week ... bit 3 = fourth */
+    BOOL last_week;                 /* ... and the last week */
     BOOL someone_else;              /* a log-on trigger for an account not this scheduler's */
     BOOL pending;                   /* fired and not run yet: due even when its time is past */
 };
@@ -309,6 +314,112 @@ static ULONGLONG repeat_after(const struct run_trigger *t, ULONGLONG base, ULONG
     return when;
 }
 
+static ULONGLONG ticks_from_systemtime(const SYSTEMTIME *st)
+{
+    FILETIME ft;
+
+    if (!SystemTimeToFileTime(st, &ft)) return NEVER;
+    return ((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+}
+
+static int days_in_month(int year, int month)
+{
+    static const int days[] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
+
+    if (month == 2 && ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0)) return 29;
+    return days[month - 1];
+}
+
+/* the weekday (0 = Sunday) of a date */
+static int weekday_of(int year, int month, int day)
+{
+    SYSTEMTIME st = { 0 }, out;
+    FILETIME ft;
+
+    st.wYear = year; st.wMonth = month; st.wDay = day;
+    SystemTimeToFileTime(&st, &ft);
+    FileTimeToSystemTime(&ft, &out);
+    return out.wDayOfWeek;
+}
+
+/* The runs of a monthly trigger in one month, in order, at the start's time of
+ * day; none before the start. Returns their number (at most 31). */
+static int month_runs(const struct run_trigger *t, int year, int month, ULONGLONG *runs)
+{
+    SYSTEMTIME start;
+    FILETIME ft;
+    int n = 0, day, dim = days_in_month(year, month), first_wday;
+    BOOL chosen[32] = { FALSE };
+
+    if (!(t->months & (1 << (month - 1)))) return 0;
+    ft.dwLowDateTime = (DWORD)t->start;
+    ft.dwHighDateTime = (DWORD)(t->start >> 32);
+    FileTimeToSystemTime(&ft, &start);
+
+    if (t->kind == TRIGGER_MONTHLY)
+    {
+        for (day = 1; day <= dim; day++) if (t->days_of_month & (1u << (day - 1))) chosen[day] = TRUE;
+        if (t->last_day) chosen[dim] = TRUE;
+    }
+    else
+    {
+        first_wday = weekday_of(year, month, 1);
+        for (day = 1; day <= dim; day++)
+        {
+            int wday = (first_wday + day - 1) % 7, nth = (day - 1) / 7;   /* 0 = the first such weekday */
+
+            if (!(t->days_of_week & (1 << wday))) continue;
+            if (nth < 4 && (t->weeks_of_month & (1 << nth))) chosen[day] = TRUE;
+            if (t->last_week && day + 7 > dim) chosen[day] = TRUE;
+        }
+    }
+
+    for (day = 1; day <= dim; day++)
+    {
+        SYSTEMTIME st = start;
+        ULONGLONG when;
+
+        if (!chosen[day]) continue;
+        st.wYear = year; st.wMonth = month; st.wDay = day;
+        when = ticks_from_systemtime(&st);
+        if (when == NEVER || when < t->start) continue;
+        runs[n++] = when;
+    }
+    return n;
+}
+
+/* the last run at or before "at" of a monthly trigger and the first after it */
+static void monthly_bases(const struct run_trigger *t, ULONGLONG at, ULONGLONG *last, ULONGLONG *next)
+{
+    SYSTEMTIME st;
+    FILETIME ft;
+    ULONGLONG runs[32];
+    int year, month, n, i, step;
+
+    *last = NEVER;
+    *next = NEVER;
+    ft.dwLowDateTime = (DWORD)at;
+    ft.dwHighDateTime = (DWORD)(at >> 32);
+    FileTimeToSystemTime(&ft, &st);
+
+    /* backwards from the month of "at", at most a leap cycle and a month back */
+    year = st.wYear; month = st.wMonth;
+    for (step = 0; step < 12 * 9 && *last == NEVER; step++)
+    {
+        n = month_runs(t, year, month, runs);
+        for (i = n - 1; i >= 0; i--) if (runs[i] <= at) { *last = runs[i]; break; }
+        if (--month < 1) { month = 12; year--; }
+        if (year < 1601) break;
+    }
+    year = st.wYear; month = st.wMonth;
+    for (step = 0; step < 12 * 9 && *next == NEVER; step++)
+    {
+        n = month_runs(t, year, month, runs);
+        for (i = 0; i < n; i++) if (runs[i] > at) { *next = runs[i]; break; }
+        if (++month > 12) { month = 1; year++; }
+    }
+}
+
 /* the last base of a calendar trigger at or before "at", and the first one
  * after it */
 static void calendar_bases(const struct run_trigger *t, ULONGLONG at, ULONGLONG *last, ULONGLONG *next)
@@ -318,6 +429,11 @@ static void calendar_bases(const struct run_trigger *t, ULONGLONG at, ULONGLONG
 
     *last = NEVER;
     *next = NEVER;
+    if (t->kind == TRIGGER_MONTHLY || t->kind == TRIGGER_MONTHLY_DOW)
+    {
+        monthly_bases(t, at, last, next);
+        return;
+    }
     if (at < t->start)
     {
         *next = t->start;
@@ -376,6 +492,8 @@ static ULONGLONG trigger_next(const struct run_trigger *t, ULONGLONG after)
         break;
     case TRIGGER_DAILY:
     case TRIGGER_WEEKLY:
+    case TRIGGER_MONTHLY:
+    case TRIGGER_MONTHLY_DOW:
         if (!t->start) return NEVER;
         calendar_bases(t, after, &last, &next);
         if (last != NEVER) when = repeat_after(t, last, after);
@@ -516,7 +634,7 @@ struct parse
     struct run_task *task;
     struct run_trigger *trigger;    /* the one being read */
     struct run_action *action;
-    BOOL in_principal, in_settings, in_repetition, in_days_of_week, user_seen;
+    BOOL in_principal, in_settings, in_repetition, in_days_of_week, in_days_of_month, in_weeks, in_months, user_seen;
 };
 
 static void parse_element(IXmlReader *reader, const WCHAR *name, UINT depth, struct parse *p, UINT *trigger_depth)
@@ -534,13 +652,56 @@ static void parse_element(IXmlReader *reader, const WCHAR *name, UINT depth, str
         if (!wcscmp(name, L"Repetition")) { p->in_repetition = TRUE; return; }
         if (!wcscmp(name, L"ScheduleByDay")) { t->kind = TRIGGER_DAILY; return; }
         if (!wcscmp(name, L"ScheduleByWeek")) { t->kind = TRIGGER_WEEKLY; t->days_of_week = 0; return; }
-        if (!wcscmp(name, L"ScheduleByMonth") || !wcscmp(name, L"ScheduleByMonthDayOfWeek"))
+        if (!wcscmp(name, L"ScheduleByMonth")) { t->kind = TRIGGER_MONTHLY; return; }
+        if (!wcscmp(name, L"ScheduleByMonthDayOfWeek"))
         {
-            FIXME("%s is not implemented; the trigger is off\n", debugstr_w(name));
-            t->enabled = FALSE;
+            t->kind = TRIGGER_MONTHLY_DOW;
+            t->days_of_week = 0;
             return;
         }
         if (!wcscmp(name, L"DaysOfWeek")) { p->in_days_of_week = TRUE; return; }
+        if (!wcscmp(name, L"DaysOfMonth")) { p->in_days_of_month = TRUE; return; }
+        if (!wcscmp(name, L"Weeks")) { p->in_weeks = TRUE; return; }
+        if (!wcscmp(name, L"Months")) { p->in_months = TRUE; return; }
+        if (p->in_months)
+        {
+            static const WCHAR *const names[] = { L"January", L"February", L"March", L"April", L"May", L"June", L"July",
+                                                  L"August", L"September", L"October", L"November", L"December" };
+            for (i = 0; i < ARRAY_SIZE(names); i++) if (!wcscmp(name, names[i])) t->months |= 1 << i;
+            return;
+        }
+        if (p->in_days_of_month && !wcscmp(name, L"Day"))
+        {
+            if ((text = element_text(reader)))
+            {
+                int day = wcstol(text, NULL, 10);
+
+#ifdef SG_MUTANT_MONTH_NO_LAST
+                if (0) t->last_day = TRUE;
+#else
+                if (!wcscmp(text, L"Last")) t->last_day = TRUE;
+#endif
+                else if (day >= 1 && day <= 31) t->days_of_month |= 1u << (day - 1);
+                free(text);
+            }
+            return;
+        }
+        if (p->in_weeks && !wcscmp(name, L"Week"))
+        {
+            if ((text = element_text(reader)))
+            {
+                int week = wcstol(text, NULL, 10);
+
+#ifdef SG_MUTANT_MONTH_NO_LAST
+                if (0) t->last_week = TRUE;
+#else
+                if (!wcscmp(text, L"Last")) t->last_week = TRUE;
+#endif
+                else if (week >= 1 && week <= 4) t->weeks_of_month |= 1 << (week - 1);
+                free(text);
+            }
+            return;
+        }
         if (p->in_days_of_week)
         {
             for (i = 0; i < ARRAY_SIZE(days); i++) if (!wcscmp(name, days[i])) t->days_of_week |= 1 << i;
@@ -664,6 +825,9 @@ static void parse_end(const WCHAR *name, UINT depth, struct parse *p, UINT trigg
     {
         if (!wcscmp(name, L"Repetition")) p->in_repetition = FALSE;
         else if (!wcscmp(name, L"DaysOfWeek")) p->in_days_of_week = FALSE;
+        else if (!wcscmp(name, L"DaysOfMonth")) p->in_days_of_month = FALSE;
+        else if (!wcscmp(name, L"Weeks")) p->in_weeks = FALSE;
+        else if (!wcscmp(name, L"Months")) p->in_months = FALSE;
         else if (depth == trigger_depth + 1) p->trigger = NULL;   /* an end element is a level below its element */
         return;
     }
@@ -1588,7 +1752,8 @@ static ULONGLONG task_next_time(const struct run_task *task, ULONGLONG after)
     {
         const struct run_trigger *t = &task->triggers[i];
 
-        if (!t->enabled || (t->kind != TRIGGER_TIME && t->kind != TRIGGER_DAILY && t->kind != TRIGGER_WEEKLY))
+        if (!t->enabled || (t->kind != TRIGGER_TIME && t->kind != TRIGGER_DAILY && t->kind != TRIGGER_WEEKLY &&
+                       t->kind != TRIGGER_MONTHLY && t->kind != TRIGGER_MONTHLY_DOW))
             continue;
         when = trigger_next(t, after);
         if (when < next) next = when;
