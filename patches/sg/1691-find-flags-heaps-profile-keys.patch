+/* the block after "after" (or the first when it is NULL) in one of this process's heaps */
+static BOOL walk_heap( HEAPENTRY32 *lphe, HANDLE heap, ULONG_PTR after )
+{
+    PROCESS_HEAP_ENTRY entry;
+    BOOL found = FALSE, past = !after;
+
+    memset( &entry, 0, sizeof(entry) );
+    if (!HeapLock( heap )) return FALSE;
+    while (HeapWalk( heap, &entry ))
+    {
+        if (entry.wFlags & (PROCESS_HEAP_REGION | PROCESS_HEAP_UNCOMMITTED_RANGE)) continue;
+        if (!past)
+        {
+            if ((ULONG_PTR)entry.lpData == after) past = TRUE;
+            continue;
+        }
+        lphe->hHandle = (HANDLE)entry.lpData;
+        lphe->dwAddress = (ULONG_PTR)entry.lpData;
+        lphe->dwBlockSize = entry.cbData;
+        lphe->dwFlags = (entry.wFlags & PROCESS_HEAP_ENTRY_BUSY) ?
+                        ((entry.wFlags & PROCESS_HEAP_ENTRY_MOVEABLE) ? LF32_MOVEABLE : LF32_FIXED) : LF32_FREE;
+        lphe->dwLockCount = 0;
+        lphe->dwResvd = 0;
+        found = TRUE;
+        break;
+    }
+    HeapUnlock( heap );
+    if (!found) SetLastError( ERROR_NO_MORE_FILES );
+    return found;
+}
+
+static BOOL is_process_heap( ULONG_PTR id )
+{
+    HANDLE heaps[256];
+    DWORD i, count = GetProcessHeaps( ARRAY_SIZE(heaps), heaps );
+
+    for (i = 0; i < min( count, ARRAY_SIZE(heaps) ); i++) if ((ULONG_PTR)heaps[i] == id) return TRUE;
     return FALSE;
 }
 
+/************************************************************************
+ *              Heap32First (KERNEL32.@)
+ */
+BOOL WINAPI Heap32First(LPHEAPENTRY32 lphe, DWORD pid, ULONG_PTR heap_id)
+{
+    TRACE( "%p, %lu, %#Ix\n", lphe, pid, heap_id );
+
+    if (!lphe || lphe->dwSize < sizeof(HEAPENTRY32))
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+#ifdef SG_MUTANT_NO_HEAP_WALK
+    SetLastError( ERROR_NO_MORE_FILES );
+    return FALSE;
+#endif
+    if (!is_own_process( pid ) || !is_process_heap( heap_id ))
+    {
+        SetLastError( ERROR_NO_MORE_FILES );
+        return FALSE;
+    }
+    lphe->th32ProcessID = GetCurrentProcessId();
+    lphe->th32HeapID = heap_id;
+    return walk_heap( lphe, (HANDLE)heap_id, 0 );
+}
+
+/************************************************************************
+ *              Heap32Next (KERNEL32.@)
+ */
+BOOL WINAPI Heap32Next(LPHEAPENTRY32 lphe)
+{
+    TRACE( "%p\n", lphe );
+
+    if (!lphe || lphe->dwSize < sizeof(HEAPENTRY32))
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    if (!is_own_process( lphe->th32ProcessID ) || !is_process_heap( lphe->th32HeapID ))
+    {
+        SetLastError( ERROR_NO_MORE_FILES );
+        return FALSE;
+    }
+    return walk_heap( lphe, (HANDLE)lphe->th32HeapID, lphe->dwAddress );
+}
