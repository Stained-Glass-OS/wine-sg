+/* Stained Glass OS 1691: DICS_FLAG_CONFIGSPECIFIC keys, in the hardware
+ * profile's branch (0: the current profile) */
+static LONG config_specific_path(struct device *device, DWORD profile, DWORD type, WCHAR *path, DWORD len)
+{
+    WCHAR prof[16], driver[50];
+    DWORD size = sizeof(driver);
+    LONG l;
+
+    if (profile) swprintf(prof, ARRAY_SIZE(prof), L"%04lu", profile);
+    else lstrcpyW(prof, L"Current");
+    if (type == DIREG_DEV)
+    {
+        swprintf(path, len, L"System\\CurrentControlSet\\Hardware Profiles\\%s\\System\\CurrentControlSet\\Enum\\%s",
+                 prof, device->instanceId);
+        return ERROR_SUCCESS;
+    }
+    if ((l = RegGetValueW(device->key, NULL, Driver, RRF_RT_REG_SZ, NULL, driver, &size)))
+        return l;
+    swprintf(path, len, L"System\\CurrentControlSet\\Hardware Profiles\\%s\\System\\CurrentControlSet\\Control\\Class\\%s",
+             prof, driver);
+    return ERROR_SUCCESS;
+}
+
+static LONG config_specific_key(struct device *device, DWORD profile, DWORD type, BOOL create, REGSAM access, HKEY *key)
+{
+    WCHAR path[MAX_PATH + 200];
+    LONG l;
+
+#ifdef SG_MUTANT_NO_CONFIG_SPECIFIC
+    return ERROR_FILE_NOT_FOUND;
+#endif
+    if (type == DIREG_DRV && create)
+    {
+        /* the driver key first: its name is the profile's key's */
+        HKEY drv;
+        if ((l = create_driver_key(device, &drv))) return l;
+        RegCloseKey(drv);
+    }
+    if ((l = config_specific_path(device, profile, type, path, ARRAY_SIZE(path)))) return l;
+    if (create)
+    {
+        /* the current profile's branch is rebuilt each boot here (volatile,
+         * as wineboot makes it): its keys are too */
+        l = RegCreateKeyExW(HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_READ | KEY_WRITE, NULL, key, NULL);
+        if (l == ERROR_CHILD_MUST_BE_VOLATILE)
+            l = RegCreateKeyExW(HKEY_LOCAL_MACHINE, path, 0, NULL, REG_OPTION_VOLATILE, KEY_READ | KEY_WRITE, NULL, key, NULL);
+        return l;
+    }
+    return RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, access, key);
+}
