+static BOOL next_heap_list( HANDLE snapshot, HEAPLIST32 *lphl, BOOL first )
+{
+    struct snapshot *snap;
+    BOOL ret = FALSE;
+
+    if (!lphl || lphl->dwSize < sizeof(HEAPLIST32))
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    if (!(snap = MapViewOfFile( snapshot, FILE_MAP_ALL_ACCESS, 0, 0, 0 ))) return FALSE;
+    if (first) snap->heap_pos = 0;
+    if (snap->heap_pos < snap->heap_count)
+    {
+        *lphl = ((HEAPLIST32 *)&snap->data[snap->heap_offset])[snap->heap_pos++];
+        ret = TRUE;
+    }
