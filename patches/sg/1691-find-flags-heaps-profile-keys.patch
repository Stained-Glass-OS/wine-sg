+
+/* Stained Glass OS 1691: the heaps of a process. They are read here for
+ * this process; another's heaps are not ours to walk, and its list is empty. */
+static BOOL is_own_process( DWORD process )
+{
+    return !process || process == GetCurrentProcessId();
+}
+
+static ULONG heap_count( DWORD process, DWORD flags )
+{
+    if (!(flags & TH32CS_SNAPHEAPLIST) || !is_own_process( process )) return 0;
+    return GetProcessHeaps( 0, NULL );
+}
+
+static void fill_heap( struct snapshot *snap, ULONG *offset, DWORD process, ULONG num )
+{
+    HEAPLIST32 *entry;
+    HANDLE *heaps;
+    ULONG i;
+
+    snap->heap_count = 0;
+    snap->heap_pos = 0;
+    if (!num) return;
+    snap->heap_offset = *offset;
+    if (!(heaps = HeapAlloc( GetProcessHeap(), 0, num * sizeof(*heaps) ))) return;
+    num = min( num, GetProcessHeaps( num, heaps ));
+    entry = (HEAPLIST32 *)&snap->data[*offset];
+    for (i = 0; i < num; i++, entry++)
+    {
+        entry->dwSize = sizeof(*entry);
+        entry->th32ProcessID = GetCurrentProcessId();
+        entry->th32HeapID = (ULONG_PTR)heaps[i];
+        entry->dwFlags = heaps[i] == GetProcessHeap() ? HF32_DEFAULT : 0;
+    }
+    HeapFree( GetProcessHeap(), 0, heaps );
+    snap->heap_count = num;
+    *offset += num * sizeof(HEAPLIST32);
+}
