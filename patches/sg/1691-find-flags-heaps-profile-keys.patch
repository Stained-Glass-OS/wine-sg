+/* a name against a mask, case and all: '*' and '<' any run, '?' and '>'
+ * one character, '"' a dot (the DOS wildcards FindFirstFile takes) */
+static BOOL match_case_sensitive( const WCHAR *mask, const WCHAR *name )
+{
+    for (;; mask++, name++)
+    {
+        switch (*mask)
+        {
+        case 0:
+            return !*name;
+        case '*':
+        case '<':
+            while (mask[1] == '*' || mask[1] == '<') mask++;
+            if (!mask[1]) return TRUE;
+            for (; *name; name++) if (match_case_sensitive( mask + 1, name )) return TRUE;
+            return match_case_sensitive( mask + 1, name );
+        case '?':
+        case '>':
+            if (!*name) return mask[1] == 0 || mask[1] == '.' || mask[1] == '"' || mask[1] == '>';
+            break;
+        case '"':
+            if (*name != '.') return FALSE;
+            break;
+        default:
+            if (*mask != *name) return FALSE;
+            break;
+        }
+    }
+}
