                                       result, bcrypt_flags));
 }
 
+/* Stained Glass OS: NCryptExportKey's encrypt_key and NCryptImportKey's
+ * decrypt_key wrap the exported bytes for a specific other key to hold --
+ * key transport/escrow. Real Windows's wire format for this envelope is
+ * not public, and no caller ever parses it themselves: a blob only ever
+ * goes back into NCryptImportKey with the matching decrypt_key. So our
+ * own envelope here is exactly as usable as Microsoft's, provided this
+ * provider's own import always reads what its own export wrote:
+ *
+ *   DWORD magic; BYTE iv[16]; DWORD wrapped_key_len; DWORD payload_len;
+ *   then wrapped_key_len bytes: a fresh AES-256 key, RSA-OAEP (SHA-256) encrypted
+ *   under the wrapping key; then payload_len bytes: the plain export,
+ *   AES-256-CBC encrypted under that AES key with iv (PKCS7 padded).
+ *
+ * Only an RSA wrapping key is implemented -- the key-transport scenario
+ * NCrypt is for always uses one (the recipient's RSA public key encrypts
+ * a one-time symmetric key, same idea as CMS/PKCS#7 envelopes). A
+ * symmetric or ECDH wrapping key answers NTE_NOT_SUPPORTED rather than
+ * guessing at a key-agreement scheme nothing here can verify. */
+#define SG_WRAPPED_KEY_MAGIC 0x314b5753u  /* arbitrary; ours to read back */
+
+struct sg_wrapped_key_header
+{
+    DWORD magic;
+    BYTE  iv[16];
+    DWORD wrapped_key_len;
+    DWORD payload_len;
+};
+
+static SECURITY_STATUS wrap_key_for_transport(NCRYPT_KEY_HANDLE encrypt_key, const BYTE *plain, DWORD plain_len,
+                                               BYTE *output, DWORD output_len, DWORD *ret_len)
+{
+    struct object *kek = get_typed_object(encrypt_key, KEY);
+    BYTE empty_label[1] = { 0 };
+    BCRYPT_OAEP_PADDING_INFO oaep = { BCRYPT_SHA256_ALGORITHM, empty_label, 0 };
+    BCRYPT_ALG_HANDLE aes_alg = NULL;
+    BCRYPT_KEY_HANDLE aes_key = NULL;
+    BYTE aes_secret[32], iv[16], iv_copy[16];
+    BYTE *wrapped_key = NULL, *payload = NULL;
+    DWORD wrapped_len, payload_cap, payload_len = 0, total;
+    NTSTATUS status;
+    SECURITY_STATUS ret;
+    struct sg_wrapped_key_header hdr;
+
+    if (!kek) return NTE_INVALID_HANDLE;
+    if (!kek->key.finalized || !kek->key.bcrypt_key) return NTE_BAD_KEY_STATE;
+    if (kek->key.algid != RSA)
+    {
+        FIXME("wrapping key algorithm %d not supported for key transport\n", kek->key.algid);
+        return NTE_NOT_SUPPORTED;
+    }
+    wrapped_len = get_dword_property(kek, NCRYPT_LENGTH_PROPERTY, 2048) / 8;
+
+    if ((status = BCryptGenRandom(NULL, aes_secret, sizeof(aes_secret), BCRYPT_USE_SYSTEM_PREFERRED_RNG)))
+        return map_ntstatus(status);
+    if ((status = BCryptGenRandom(NULL, iv, sizeof(iv), BCRYPT_USE_SYSTEM_PREFERRED_RNG)))
+        return map_ntstatus(status);
+    if ((status = BCryptOpenAlgorithmProvider(&aes_alg, BCRYPT_AES_ALGORITHM, NULL, 0)))
+        return map_ntstatus(status);
+    if ((status = BCryptSetProperty(aes_alg, BCRYPT_CHAINING_MODE, (UCHAR *)BCRYPT_CHAIN_MODE_CBC,
+                                     sizeof(BCRYPT_CHAIN_MODE_CBC), 0)) ||
+        (status = BCryptGenerateSymmetricKey(aes_alg, &aes_key, NULL, 0, aes_secret, sizeof(aes_secret), 0)))
+    {
+        BCryptCloseAlgorithmProvider(aes_alg, 0);
+        return map_ntstatus(status);
+    }
+
+    payload_cap = plain_len + 16;
+    if (!(payload = malloc(payload_cap)))
+    {
+        ret = NTE_NO_MEMORY;
+        goto done;
+    }
+    memcpy(iv_copy, iv, sizeof(iv_copy));
+    if ((status = BCryptEncrypt(aes_key, (BYTE *)plain, plain_len, NULL, iv_copy, sizeof(iv_copy),
+                                payload, payload_cap, &payload_len, BCRYPT_BLOCK_PADDING)))
+    {
+        ret = map_ntstatus(status);
+        goto done;
+    }
+#ifdef SG_MUTANT_WRAP_NO_ENCRYPT
+    memcpy(payload, plain, plain_len);
+    payload_len = plain_len;
+#endif
+
+    if (!(wrapped_key = malloc(wrapped_len)))
+    {
+        ret = NTE_NO_MEMORY;
+        goto done;
+    }
+    if ((ret = crypt_data(encrypt_key, aes_secret, sizeof(aes_secret), &oaep, wrapped_key, wrapped_len,
+                          &wrapped_len, BCRYPT_PAD_OAEP, TRUE)))
+        goto done;
+
+    total = sizeof(hdr) + wrapped_len + payload_len;
+    if (!output)
+    {
+        *ret_len = total;
+        ret = ERROR_SUCCESS;
+        goto done;
+    }
+    if (output_len < total)
+    {
+        *ret_len = total;
+        ret = NTE_BUFFER_TOO_SMALL;
+        goto done;
+    }
+
+    hdr.magic = SG_WRAPPED_KEY_MAGIC;
+    memcpy(hdr.iv, iv, sizeof(iv));
+    hdr.wrapped_key_len = wrapped_len;
+    hdr.payload_len = payload_len;
+    memcpy(output, &hdr, sizeof(hdr));
+    memcpy(output + sizeof(hdr), wrapped_key, wrapped_len);
+    memcpy(output + sizeof(hdr) + wrapped_len, payload, payload_len);
+    *ret_len = total;
+    ret = ERROR_SUCCESS;
+
+done:
+    RtlSecureZeroMemory(aes_secret, sizeof(aes_secret));
+    free(payload);
+    free(wrapped_key);
+    if (aes_key) BCryptDestroyKey(aes_key);
+    if (aes_alg) BCryptCloseAlgorithmProvider(aes_alg, 0);
+    return ret;
+}
+
+static SECURITY_STATUS unwrap_key_for_transport(NCRYPT_KEY_HANDLE decrypt_key, const BYTE *blob, DWORD blob_len,
+                                                 BYTE **plain, DWORD *plain_len)
+{
+    struct object *kek = get_typed_object(decrypt_key, KEY);
+    const struct sg_wrapped_key_header *hdr = (const struct sg_wrapped_key_header *)blob;
+    BYTE empty_label[1] = { 0 };
+    BCRYPT_OAEP_PADDING_INFO oaep = { BCRYPT_SHA256_ALGORITHM, empty_label, 0 };
+    BCRYPT_ALG_HANDLE aes_alg = NULL;
+    BCRYPT_KEY_HANDLE aes_key = NULL;
+    BYTE aes_secret[32], iv_copy[16];
+    DWORD secret_len = sizeof(aes_secret);
+    NTSTATUS status;
+    SECURITY_STATUS ret;
+    const BYTE *wrapped_key, *payload;
+
+    *plain = NULL;
+    if (!kek) return NTE_INVALID_HANDLE;
+    if (!kek->key.finalized || !kek->key.bcrypt_key) return NTE_BAD_KEY_STATE;
+    if (kek->key.algid != RSA)
+    {
+        FIXME("wrapping key algorithm %d not supported for key transport\n", kek->key.algid);
+        return NTE_NOT_SUPPORTED;
+    }
+    if (blob_len < sizeof(*hdr) || hdr->magic != SG_WRAPPED_KEY_MAGIC) return NTE_INVALID_PARAMETER;
+    if (hdr->wrapped_key_len > blob_len - sizeof(*hdr) ||
+        hdr->payload_len > blob_len - sizeof(*hdr) - hdr->wrapped_key_len)
+        return NTE_INVALID_PARAMETER;
+    wrapped_key = blob + sizeof(*hdr);
+    payload = wrapped_key + hdr->wrapped_key_len;
+
+    if ((ret = crypt_data(decrypt_key, (BYTE *)wrapped_key, hdr->wrapped_key_len, &oaep, aes_secret,
+                          sizeof(aes_secret), &secret_len, BCRYPT_PAD_OAEP, FALSE)))
+        return ret;
+    if (secret_len != sizeof(aes_secret))
+    {
+        RtlSecureZeroMemory(aes_secret, sizeof(aes_secret));
+        return NTE_INVALID_PARAMETER;
+    }
+
+    if ((status = BCryptOpenAlgorithmProvider(&aes_alg, BCRYPT_AES_ALGORITHM, NULL, 0)))
+    {
+        RtlSecureZeroMemory(aes_secret, sizeof(aes_secret));
+        return map_ntstatus(status);
+    }
+    if ((status = BCryptSetProperty(aes_alg, BCRYPT_CHAINING_MODE, (UCHAR *)BCRYPT_CHAIN_MODE_CBC,
+                                     sizeof(BCRYPT_CHAIN_MODE_CBC), 0)) ||
+        (status = BCryptGenerateSymmetricKey(aes_alg, &aes_key, NULL, 0, aes_secret, sizeof(aes_secret), 0)))
+    {
+        RtlSecureZeroMemory(aes_secret, sizeof(aes_secret));
+        BCryptCloseAlgorithmProvider(aes_alg, 0);
+        return map_ntstatus(status);
+    }
+    RtlSecureZeroMemory(aes_secret, sizeof(aes_secret));
+
+    memcpy(iv_copy, hdr->iv, sizeof(iv_copy));
+    if (!(*plain = malloc(hdr->payload_len ? hdr->payload_len : 1)))
+    {
+        ret = NTE_NO_MEMORY;
+        goto done;
+    }
+    if ((status = BCryptDecrypt(aes_key, (BYTE *)payload, hdr->payload_len, NULL, iv_copy, sizeof(iv_copy),
+                                *plain, hdr->payload_len, plain_len, BCRYPT_BLOCK_PADDING)))
+    {
+        free(*plain);
+        *plain = NULL;
+        ret = map_ntstatus(status);
+        goto done;
+    }
+    ret = ERROR_SUCCESS;
+
+done:
+    if (aes_key) BCryptDestroyKey(aes_key);
+    if (aes_alg) BCryptCloseAlgorithmProvider(aes_alg, 0);
+    return ret;
+}
+
 SECURITY_STATUS WINAPI NCryptEncrypt(NCRYPT_KEY_HANDLE key, BYTE *input, DWORD insize, void *padding,
                                      BYTE *output, DWORD outsize, DWORD *result, DWORD flags)
 {
