@@ -0,0 +1,350 @@
+/*
+ * Range lists of the configuration manager
+ *
+ * A range list is a set of inclusive ranges of 64-bit values (the I/O ports, memory and IRQ numbers a
+ * device may use); these functions build and combine such sets. They keep their data in the calling process.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "cfgmgr32.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(setupapi);
+
+#define RANGE_LIST_MAGIC 0x52616e67
+
+struct range
+{
+    struct range *next;
+    DWORDLONG start, end;
+};
+
+struct range_list
+{
+    DWORD magic;
+    struct range *head;    /* sorted, never touching */
+};
+
+static struct range_list *get_list( RANGE_LIST handle )
+{
+    struct range_list *list = (struct range_list *)handle;
+
+    if (!list || list->magic != RANGE_LIST_MAGIC) return NULL;
+    return list;
+}
+
+/* adds [start, end], joining whatever it overlaps or touches */
+static BOOL list_add( struct range_list *list, DWORDLONG start, DWORDLONG end )
+{
+    struct range **link = &list->head, *r;
+
+    while ((r = *link) && r->end != ~(DWORDLONG)0 && r->end + 1 < start) link = &r->next;
+    while ((r = *link) && (end == ~(DWORDLONG)0 || r->start <= end + 1))
+    {
+        if (r->start < start) start = r->start;
+        if (r->end > end) end = r->end;
+        *link = r->next;
+        free( r );
+    }
+    if (!(r = malloc( sizeof(*r) ))) return FALSE;
+    r->start = start;
+    r->end = end;
+    r->next = *link;
+    *link = r;
+    return TRUE;
+}
+
+/* takes [start, end] out */
+static BOOL list_delete( struct range_list *list, DWORDLONG start, DWORDLONG end )
+{
+    struct range **link = &list->head, *r;
+
+    while ((r = *link))
+    {
+        if (r->end < start || r->start > end) { link = &r->next; continue; }
+        if (r->start < start && r->end > end)
+        {
+            struct range *tail = malloc( sizeof(*tail) );
+
+            if (!tail) return FALSE;
+            tail->start = end + 1;
+            tail->end = r->end;
+            tail->next = r->next;
+            r->end = start - 1;
+            r->next = tail;
+            return TRUE;
+        }
+        if (r->start < start) { r->end = start - 1; link = &r->next; }
+        else if (r->end > end) { r->start = end + 1; link = &r->next; }
+        else
+        {
+            *link = r->next;
+            free( r );
+        }
+    }
+    return TRUE;
+}
+
+static void list_clear( struct range_list *list )
+{
+    struct range *r;
+
+    while ((r = list->head))
+    {
+        list->head = r->next;
+        free( r );
+    }
+}
+
+static BOOL list_contains( const struct range_list *list, DWORDLONG start, DWORDLONG end )
+{
+    const struct range *r;
+
+    for (r = list->head; r; r = r->next)
+        if (r->start <= start && r->end >= end) return TRUE;
+    return FALSE;
+}
+
+static CONFIGRET list_new( struct range_list **ret )
+{
+    struct range_list *list = calloc( 1, sizeof(*list) );
+
+    if (!list) return CR_OUT_OF_MEMORY;
+    list->magic = RANGE_LIST_MAGIC;
+    *ret = list;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Create_Range_List( PRANGE_LIST handle, ULONG flags )
+{
+    struct range_list *list;
+    CONFIGRET ret;
+
+    TRACE( "%p, %#lx\n", handle, flags );
+
+    if (flags) return CR_INVALID_FLAG;
+    if (!handle) return CR_INVALID_POINTER;
+    if ((ret = list_new( &list ))) return ret;
+    *handle = (RANGE_LIST)list;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Free_Range_List( RANGE_LIST handle, ULONG flags )
+{
+    struct range_list *list = get_list( handle );
+
+    TRACE( "%#Ix, %#lx\n", handle, flags );
+
+    if (flags) return CR_INVALID_FLAG;
+    if (!list) return CR_INVALID_RANGE_LIST;
+    list->magic = 0;
+    list_clear( list );
+    free( list );
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Add_Range( RANGE_LIST handle, DWORDLONG start, DWORDLONG end, ULONG flags )
+{
+    struct range_list *list = get_list( handle );
+
+    TRACE( "%#Ix, %#I64x, %#I64x, %#lx\n", handle, start, end, flags );
+
+    if (flags & ~CM_ADD_RANGE_BITS) return CR_INVALID_FLAG;
+    if (!list) return CR_INVALID_RANGE_LIST;
+    if (end < start) return CR_INVALID_RANGE;
+    if (flags == CM_ADD_RANGE_DONOTADDIFCONFLICT)
+    {
+        const struct range *r;
+
+        for (r = list->head; r; r = r->next)
+            if (r->start <= end && r->end >= start) return CR_FAILURE;
+    }
+    return list_add( list, start, end ) ? CR_SUCCESS : CR_OUT_OF_MEMORY;
+}
+
+CONFIGRET WINAPI CM_Delete_Range( DWORDLONG start, DWORDLONG end, RANGE_LIST handle, ULONG flags )
+{
+    struct range_list *list = get_list( handle );
+
+    TRACE( "%#I64x, %#I64x, %#Ix, %#lx\n", start, end, handle, flags );
+
+    if (flags) return CR_INVALID_FLAG;
+    if (!list) return CR_INVALID_RANGE_LIST;
+    if (end < start) return CR_INVALID_RANGE;
+    return list_delete( list, start, end ) ? CR_SUCCESS : CR_OUT_OF_MEMORY;
+}
+
+CONFIGRET WINAPI CM_Test_Range_Available( DWORDLONG start, DWORDLONG end, RANGE_LIST handle, ULONG flags )
+{
+    struct range_list *list = get_list( handle );
+
+    TRACE( "%#I64x, %#I64x, %#Ix, %#lx\n", start, end, handle, flags );
+
+    if (flags) return CR_INVALID_FLAG;
+    if (!list) return CR_INVALID_RANGE_LIST;
+    if (end < start) return CR_INVALID_RANGE;
+    return list_contains( list, start, end ) ? CR_SUCCESS : CR_FAILURE;
+}
+
+CONFIGRET WINAPI CM_Dup_Range_List( RANGE_LIST old_handle, PRANGE_LIST new_handle, ULONG flags )
+{
+    struct range_list *old = get_list( old_handle ), *new;
+    const struct range *r;
+    CONFIGRET ret;
+
+    TRACE( "%#Ix, %p, %#lx\n", old_handle, new_handle, flags );
+
+    if (flags) return CR_INVALID_FLAG;
+    if (!old) return CR_INVALID_RANGE_LIST;
+    if (!new_handle) return CR_INVALID_POINTER;
+    if ((ret = list_new( &new ))) return ret;
+    for (r = old->head; r; r = r->next)
+    {
+        if (!list_add( new, r->start, r->end ))
+        {
+            list_clear( new );
+            free( new );
+            return CR_OUT_OF_MEMORY;
+        }
+    }
+    *new_handle = (RANGE_LIST)new;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Merge_Range_List( RANGE_LIST old1_handle, RANGE_LIST old2_handle, RANGE_LIST new_handle, ULONG flags )
+{
+    struct range_list *old1 = get_list( old1_handle ), *old2 = get_list( old2_handle ), *new = get_list( new_handle );
+    const struct range *r;
+
+    TRACE( "%#Ix, %#Ix, %#Ix, %#lx\n", old1_handle, old2_handle, new_handle, flags );
+
+    if (flags) return CR_INVALID_FLAG;
+    if (!old1 || !old2 || !new) return CR_INVALID_RANGE_LIST;
+    for (r = old1->head; r; r = r->next)
+        if (!list_add( new, r->start, r->end )) return CR_OUT_OF_MEMORY;
+    for (r = old2->head; r; r = r->next)
+        if (!list_add( new, r->start, r->end )) return CR_OUT_OF_MEMORY;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Intersect_Range_List( RANGE_LIST old1_handle, RANGE_LIST old2_handle, RANGE_LIST new_handle, ULONG flags )
+{
+    struct range_list *old1 = get_list( old1_handle ), *old2 = get_list( old2_handle ), *new = get_list( new_handle );
+    const struct range *r1, *r2;
+
+    TRACE( "%#Ix, %#Ix, %#Ix, %#lx\n", old1_handle, old2_handle, new_handle, flags );
+
+    if (flags) return CR_INVALID_FLAG;
+    if (!old1 || !old2 || !new) return CR_INVALID_RANGE_LIST;
+    for (r1 = old1->head; r1; r1 = r1->next)
+    {
+        for (r2 = old2->head; r2; r2 = r2->next)
+        {
+            DWORDLONG start = max( r1->start, r2->start );
+            DWORDLONG end = min( r1->end, r2->end );
+
+            if (start <= end && !list_add( new, start, end )) return CR_OUT_OF_MEMORY;
+        }
+    }
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Invert_Range_List( RANGE_LIST old_handle, RANGE_LIST new_handle, DWORDLONG max_value, ULONG flags )
+{
+    struct range_list *old = get_list( old_handle ), *new = get_list( new_handle );
+    DWORDLONG next = 0;
+    const struct range *r;
+
+    TRACE( "%#Ix, %#Ix, %#I64x, %#lx\n", old_handle, new_handle, max_value, flags );
+
+    if (flags) return CR_INVALID_FLAG;
+    if (!old || !new) return CR_INVALID_RANGE_LIST;
+    for (r = old->head; r && next <= max_value; r = r->next)
+    {
+        if (r->start > next && !list_add( new, next, min( r->start - 1, max_value ) )) return CR_OUT_OF_MEMORY;
+        if (r->end == ~(DWORDLONG)0) return CR_SUCCESS;
+        next = r->end + 1;
+    }
+    if (next <= max_value && !list_add( new, next, max_value )) return CR_OUT_OF_MEMORY;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_First_Range( RANGE_LIST handle, PDWORDLONG start, PDWORDLONG end, PRANGE_ELEMENT element, ULONG flags )
+{
+    struct range_list *list = get_list( handle );
+
+    TRACE( "%#Ix, %p, %p, %p, %#lx\n", handle, start, end, element, flags );
+
+    if (flags) return CR_INVALID_FLAG;
+    if (!list) return CR_INVALID_RANGE_LIST;
+    if (!start || !end || !element) return CR_INVALID_POINTER;
+    if (!list->head) return CR_FAILURE;
+    *start = list->head->start;
+    *end = list->head->end;
+    *element = (RANGE_ELEMENT)list->head;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Next_Range( PRANGE_ELEMENT element, PDWORDLONG start, PDWORDLONG end, ULONG flags )
+{
+    struct range *current;
+
+    TRACE( "%p, %p, %p, %#lx\n", element, start, end, flags );
+
+    if (flags) return CR_INVALID_FLAG;
+    if (!element || !start || !end) return CR_INVALID_POINTER;
+    if (!(current = (struct range *)*element)) return CR_FAILURE;
+    if (!(current = current->next)) return CR_FAILURE;
+    *start = current->start;
+    *end = current->end;
+    *element = (RANGE_ELEMENT)current;
+    return CR_SUCCESS;
+}
+
+/* the alignment is a mask: the bits that are set are the ones that count, 0xfffffffffffff000 is 4K */
+CONFIGRET WINAPI CM_Find_Range( PDWORDLONG found, DWORDLONG start, ULONG length, DWORDLONG alignment, DWORDLONG end,
+                                RANGE_LIST handle, ULONG flags )
+{
+    struct range_list *list = get_list( handle );
+    const struct range *r;
+
+    TRACE( "%p, %#I64x, %lu, %#I64x, %#I64x, %#Ix, %#lx\n", found, start, length, alignment, end, handle, flags );
+
+    if (flags) return CR_INVALID_FLAG;
+    if (!list) return CR_INVALID_RANGE_LIST;
+    if (!found) return CR_INVALID_POINTER;
+    if (!length || !alignment || end < start || end - start < length - 1) return CR_INVALID_RANGE;
+    for (r = list->head; r; r = r->next)
+    {
+        DWORDLONG first = max( r->start, start ), last = min( r->end, end ), candidate;
+
+        if (first > last) continue;
+        candidate = (first + ~alignment) & alignment;
+        if (candidate < first) continue;   /* wrapped around */
+        if (last >= candidate && last - candidate >= length - 1)
+        {
+            *found = candidate;
+            return CR_SUCCESS;
+        }
+    }
+    return CR_FAILURE;
+}
