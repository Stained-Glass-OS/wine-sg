+    This->link_mk = NULL;
+  }
+
   HeapFree( GetProcessHeap(), 0, This->containerApp );
   This->containerApp = NULL;
   HeapFree( GetProcessHeap(), 0, This->containerObj );
diff --git a/dlls/ole32/ole2.c b/dlls/ole32/ole2.c
index 30773e0..ba9b0ee 100644
--- a/dlls/ole32/ole2.c
+++ b/dlls/ole32/ole2.c
@@ -2913,15 +2913,191 @@ HRESULT WINAPI OleCreateFromData(IDataObject *data, REFIID iid, DWORD renderopt,
                                fmt, NULL, NULL, client_site, stg, obj);
 }
 
+/* Stained Glass OS: a linked object for a source moniker: the default handler
+ * with IOleLink (defaulthandler.c), its storage, site and presentation cache,
+ * brought up to date from the source when it is to be drawn */
+static HRESULT create_link(IMoniker *mk, REFIID iid, DWORD renderopt, ULONG num_fmts, DWORD *adv_flags,
+                           FORMATETC *fmts, IAdviseSink *sink, DWORD *conns, IOleClientSite *site,
+                           IStorage *stg, void **obj)
+{
+    FORMATETC draw = { 0, NULL, DVASPECT_CONTENT, -1, TYMED_NULL };
+    CLSID clsid = CLSID_NULL;
+    IPersistStorage *persist;
+    IOleObject *object;
+    IOleCache *cache;
+    IOleLink *link;
+    IUnknown *unk;
+    IBindCtx *bc;
+    LPOLESTR name;
+    DWORD mksys;
+    HRESULT hr;
+    ULONG i;
+
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+    if (!mk) return E_INVALIDARG;
+    if (renderopt != OLERENDER_NONE && renderopt != OLERENDER_DRAW && renderopt != OLERENDER_FORMAT)
+        return E_INVALIDARG;
+
+    /* a file's class is known before binding */
+    if (SUCCEEDED(IMoniker_IsSystemMoniker(mk, &mksys)) && mksys == MKSYS_FILEMONIKER &&
+        SUCCEEDED(CreateBindCtx(0, &bc)))
+    {
+        if (SUCCEEDED(IMoniker_GetDisplayName(mk, bc, NULL, &name)))
+        {
+            if (FAILED(GetClassFile(name, &clsid))) clsid = CLSID_NULL;
+            CoTaskMemFree(name);
+        }
+        IBindCtx_Release(bc);
+    }
+
+    if (FAILED(hr = DefaultHandler_CreateLink(&clsid, mk, &unk))) return hr;
+    if (stg && SUCCEEDED(hr = IUnknown_QueryInterface(unk, &IID_IPersistStorage, (void **)&persist)))
+    {
+        hr = IPersistStorage_InitNew(persist, stg);
+        IPersistStorage_Release(persist);
+    }
+    if (SUCCEEDED(hr) && site && SUCCEEDED(hr = IUnknown_QueryInterface(unk, &IID_IOleObject, (void **)&object)))
+    {
+        hr = IOleObject_SetClientSite(object, site);
+        IOleObject_Release(object);
+    }
+    if (SUCCEEDED(hr) && renderopt != OLERENDER_NONE)
+    {
+        if (renderopt == OLERENDER_DRAW && !num_fmts)
+        {
+            num_fmts = 1;
+            fmts = &draw;
+        }
+        if (SUCCEEDED(hr = IUnknown_QueryInterface(unk, &IID_IOleCache, (void **)&cache)))
+        {
+            for (i = 0; i < num_fmts && SUCCEEDED(hr); i++)
+            {
+                DWORD conn = 0;
+                hr = IOleCache_Cache(cache, &fmts[i], adv_flags ? adv_flags[i] : ADVF_PRIMEFIRST, &conn);
+                if (hr == CACHE_S_FORMATETC_NOTSUPPORTED || hr == CACHE_S_SAMECACHE) hr = S_OK;
+                if (conns) conns[i] = conn;
+            }
+            IOleCache_Release(cache);
+        }
+        /* the presentation comes from the source */
+#ifndef SG_MUTANT_LINK_CREATE_NO_UPDATE
+        if (SUCCEEDED(hr) && SUCCEEDED(hr = IUnknown_QueryInterface(unk, &IID_IOleLink, (void **)&link)))
+        {
+            hr = IOleLink_Update(link, NULL);
+            IOleLink_Release(link);
+        }
+#endif
+    }
+    if (SUCCEEDED(hr) && sink && SUCCEEDED(IUnknown_QueryInterface(unk, &IID_IOleObject, (void **)&object)))
+    {
+        DWORD conn;
+        IOleObject_Advise(object, sink, &conn);
+        IOleObject_Release(object);
+    }
+    if (SUCCEEDED(hr)) hr = IUnknown_QueryInterface(unk, iid, obj);
+    IUnknown_Release(unk);
+    return hr;
+}
+
+/******************************************************************************
+ *              OleCreateLinkEx        [OLE32.@]
+ */
+HRESULT WINAPI OleCreateLinkEx(IMoniker *mk, REFIID iid, DWORD flags, DWORD renderopt, ULONG num_fmts,
+        DWORD *adv_flags, FORMATETC *fmts, IAdviseSink *sink, DWORD *conns, IOleClientSite *site,
+        IStorage *stg, void **obj)
+{
+    TRACE("%p, %s, %#lx, %ld, %ld, %p, %p, %p, %p, %p, %p, %p\n", mk, debugstr_guid(iid), flags, renderopt,
+          num_fmts, adv_flags, fmts, sink, conns, site, stg, obj);
+    return create_link(mk, iid, renderopt, num_fmts, adv_flags, fmts, sink, conns, site, stg, obj);
+}
+
+/******************************************************************************
+ *              OleCreateLink        [OLE32.@]
+ */
+HRESULT WINAPI OleCreateLink(IMoniker *mk, REFIID iid, DWORD renderopt, FORMATETC *fmt,
+        IOleClientSite *site, IStorage *stg, void **obj)
+{
+    TRACE("%p, %s, %ld, %p, %p, %p, %p\n", mk, debugstr_guid(iid), renderopt, fmt, site, stg, obj);
+    return create_link(mk, iid, renderopt, fmt ? 1 : 0, NULL, fmt, NULL, NULL, site, stg, obj);
+}
+
+/******************************************************************************
+ *              OleCreateLinkToFileEx        [OLE32.@]
+ */
+HRESULT WINAPI OleCreateLinkToFileEx(const OLECHAR *filename, REFIID iid, DWORD flags, DWORD renderopt,
+        ULONG num_fmts, DWORD *adv_flags, FORMATETC *fmts, IAdviseSink *sink, DWORD *conns,
+        IOleClientSite *site, IStorage *stg, void **obj)
+{
+    IMoniker *mk;
+    HRESULT hr;
+
+    TRACE("%s, %s, %#lx, %ld\n", debugstr_w(filename), debugstr_guid(iid), flags, renderopt);
+    if (!filename) return E_INVALIDARG;
+    if (FAILED(hr = CreateFileMoniker(filename, &mk))) return hr;
+    hr = create_link(mk, iid, renderopt, num_fmts, adv_flags, fmts, sink, conns, site, stg, obj);
+    IMoniker_Release(mk);
+    return hr;
+}
+
+/******************************************************************************
+ *              OleCreateLinkToFile        [OLE32.@]
+ */
+HRESULT WINAPI OleCreateLinkToFile(const OLECHAR *filename, REFIID iid, DWORD renderopt, FORMATETC *fmt,
+        IOleClientSite *site, IStorage *stg, void **obj)
+{
+    return OleCreateLinkToFileEx(filename, iid, 0, renderopt, fmt ? 1 : 0, NULL, fmt, NULL, NULL, site, stg, obj);
+}
+
+/* the moniker of a data object's "Link Source" format (a moniker and the class) */
+static IMoniker *link_source_moniker(IDataObject *data)
+{
+    FORMATETC fmt = { 0, NULL, DVASPECT_CONTENT, -1, TYMED_ISTREAM };
+    LARGE_INTEGER zero = {{0}};
+    IMoniker *mk = NULL;
+    STGMEDIUM med;
+
+    fmt.cfFormat = RegisterClipboardFormatW(L"Link Source");
+    if (FAILED(IDataObject_GetData(data, &fmt, &med))) return NULL;
+    if (med.tymed == TYMED_ISTREAM)
+    {
+        IStream_Seek(med.pstm, zero, STREAM_SEEK_SET, NULL);
+        if (FAILED(OleLoadFromStream(med.pstm, &IID_IMoniker, (void **)&mk))) mk = NULL;
+    }
+    ReleaseStgMedium(&med);
+    return mk;
+}
+
+/******************************************************************************
+ *              OleCreateLinkFromDataEx        [OLE32.@]
+ */
+HRESULT WINAPI OleCreateLinkFromDataEx(IDataObject *data, REFIID iid, DWORD flags, DWORD renderopt,
+        ULONG num_fmts, DWORD *adv_flags, FORMATETC *fmts, IAdviseSink *sink, DWORD *conns,
+        IOleClientSite *site, IStorage *stg, void **obj)
+{
+    IMoniker *mk;
+    HRESULT hr;
+
+    TRACE("%p, %s, %#lx, %ld\n", data, debugstr_guid(iid), flags, renderopt);
+    if (!data) return E_INVALIDARG;
+    /* the data names its link source; data without one is embedded, as before */
+    if (!(mk = link_source_moniker(data)))
+    {
+        WARN("no link source: embedding the data\n");
+        return OleCreateFromDataEx(data, iid, flags, renderopt, num_fmts, adv_flags, fmts, sink, conns, site, stg, obj);
+    }
+    hr = create_link(mk, iid, renderopt, num_fmts, adv_flags, fmts, sink, conns, site, stg, obj);
+    IMoniker_Release(mk);
+    return hr;
+}
+
