 /*
  * Virtual function tables for the DefaultHandler class.
  */
+/* Stained Glass OS: a linked object (OleCreateLink*): the default handler with
+ * IOleLink. Its source is named by a moniker; running it binds the moniker
+ * (BindToSource) instead of starting the class's server, and its storage keeps
+ * the moniker in the \1Ole stream ([MS-OLEDS] 2.3.3 OLEStream). */
+static inline DefaultHandler *impl_from_IOleLink( IOleLink *iface )
+{
+    return CONTAINING_RECORD(iface, DefaultHandler, IOleLink_iface);
+}
+
+static HRESULT link_bind( DefaultHandler *This, IBindCtx *pbc, DWORD flags )
+{
+    IOleCacheControl *cache_ctrl;
+    IBindCtx *bc = pbc;
+    HRESULT hr;
+
+    if (object_is_running(This)) return S_OK;
+    if (!This->link_mk) return MK_E_UNAVAILABLE;
+    release_delegates(This);
+
+    if (!bc && FAILED(hr = CreateBindCtx( 0, &bc ))) return hr;
+#ifdef SG_MUTANT_LINK_NO_BIND
+    hr = MK_E_UNAVAILABLE;
+#else
+    hr = IMoniker_BindToObject( This->link_mk, bc, NULL, &IID_IOleObject, (void **)&This->pOleDelegate );
+#endif
+    if (!pbc) IBindCtx_Release( bc );
+    if (FAILED(hr)) return hr;
+
+    if (!(flags & OLELINKBIND_EVENIFCLASSDIFF) && !IsEqualCLSID( &This->clsid, &CLSID_NULL ))
+    {
+        CLSID clsid;
+        if (SUCCEEDED(IOleObject_GetUserClassID( This->pOleDelegate, &clsid )) && !IsEqualCLSID( &clsid, &This->clsid ))
+        {
+            release_delegates(This);
+            return OLE_E_CLASSDIFF;
+        }
+    }
+    if (IsEqualCLSID( &This->clsid, &CLSID_NULL )) IOleObject_GetUserClassID( This->pOleDelegate, &This->clsid );
+
+    /* the link is the source's client: it advises the source; the container's
+     * site stays with the link */
+    hr = IOleObject_Advise( This->pOleDelegate, &This->IAdviseSink_iface, &This->dwAdvConn );
+    if (FAILED(hr)) goto fail;
+    if (FAILED(hr = IOleObject_QueryInterface( This->pOleDelegate, &IID_IDataObject, (void **)&This->pDataDelegate )))
+        goto fail;
+    This->object_state = object_state_running;
+    if (This->dataAdviseHolder) DataAdviseHolder_OnConnect( This->dataAdviseHolder, This->pDataDelegate );
+    if (SUCCEEDED(IUnknown_QueryInterface( This->dataCache, &IID_IOleCacheControl, (void **)&cache_ctrl )))
+    {
+        IOleCacheControl_OnRun( cache_ctrl, This->pDataDelegate );
+        IOleCacheControl_Release( cache_ctrl );
+    }
+    return S_OK;
+
+fail:
+    if (This->object_state == object_state_running) DefaultHandler_Stop(This);
+    else release_delegates(This);
+    return hr;
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_QueryInterface( IOleLink *iface, REFIID riid, void **obj )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+    return IUnknown_QueryInterface( This->outerUnknown, riid, obj );
+}
+
+static ULONG WINAPI DefaultHandler_IOleLink_AddRef( IOleLink *iface )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+    return IUnknown_AddRef( This->outerUnknown );
+}
+
+static ULONG WINAPI DefaultHandler_IOleLink_Release( IOleLink *iface )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+    return IUnknown_Release( This->outerUnknown );
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_SetUpdateOptions( IOleLink *iface, DWORD opt )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+
+    TRACE("(%p)->(%ld)\n", This, opt);
+    if (opt != OLEUPDATE_ALWAYS && opt != OLEUPDATE_ONCALL) return E_INVALIDARG;
+    This->link_update = opt;
+    return S_OK;
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_GetUpdateOptions( IOleLink *iface, DWORD *opt )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+
+    TRACE("(%p)->(%p)\n", This, opt);
+    if (!opt) return E_INVALIDARG;
+    *opt = This->link_update;
+    return S_OK;
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_SetSourceMoniker( IOleLink *iface, IMoniker *mk, REFCLSID clsid )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+
+    TRACE("(%p)->(%p %s)\n", This, mk, debugstr_guid(clsid));
+    /* a new source: the old one is let go of */
+    DefaultHandler_Stop(This);
+    if (mk) IMoniker_AddRef( mk );
+    if (This->link_mk) IMoniker_Release( This->link_mk );
+    This->link_mk = mk;
+    if (clsid) This->clsid = *clsid;
+    return S_OK;
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_GetSourceMoniker( IOleLink *iface, IMoniker **mk )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+
+    TRACE("(%p)->(%p)\n", This, mk);
+    if (!mk) return E_INVALIDARG;
+    *mk = This->link_mk;
+    if (!*mk) return MK_E_UNAVAILABLE;
+    IMoniker_AddRef( *mk );
+    return S_OK;
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_SetSourceDisplayName( IOleLink *iface, LPCOLESTR name )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+    IMoniker *mk;
+    IBindCtx *bc;
+    ULONG eaten;
+    HRESULT hr;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_w(name));
+    if (!name) return E_INVALIDARG;
+    if (FAILED(hr = CreateBindCtx( 0, &bc ))) return hr;
+    hr = MkParseDisplayName( bc, name, &eaten, &mk );
+    IBindCtx_Release( bc );
+    if (FAILED(hr)) return hr;
+    hr = DefaultHandler_IOleLink_SetSourceMoniker( iface, mk, NULL );
+    IMoniker_Release( mk );
+    return hr;
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_GetSourceDisplayName( IOleLink *iface, LPOLESTR *name )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+    IBindCtx *bc;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, name);
+    if (!name) return E_INVALIDARG;
+    *name = NULL;
+    if (!This->link_mk) return MK_E_UNAVAILABLE;
+    if (FAILED(hr = CreateBindCtx( 0, &bc ))) return hr;
+    hr = IMoniker_GetDisplayName( This->link_mk, bc, NULL, name );
+    IBindCtx_Release( bc );
+    return hr;
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_BindToSource( IOleLink *iface, DWORD flags, IBindCtx *bc )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+
+    TRACE("(%p)->(%#lx %p)\n", This, flags, bc);
+    return link_bind( This, bc, flags );
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_BindIfRunning( IOleLink *iface )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+    IBindCtx *bc;
+    HRESULT hr;
+
+    TRACE("(%p)\n", This);
+    if (object_is_running(This)) return S_OK;
+    if (!This->link_mk) return MK_E_UNAVAILABLE;
+    if (FAILED(hr = CreateBindCtx( 0, &bc ))) return hr;
+    /* only a source that is running already */
+    hr = IMoniker_IsRunning( This->link_mk, bc, NULL, NULL );
+    if (hr == S_OK) hr = link_bind( This, bc, 0 );
+    else if (SUCCEEDED(hr)) hr = S_FALSE;
+    IBindCtx_Release( bc );
+    return hr;
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_GetBoundSource( IOleLink *iface, IUnknown **unk )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+
+    TRACE("(%p)->(%p)\n", This, unk);
+    if (!unk) return E_INVALIDARG;
+    *unk = NULL;
+    if (!object_is_running(This)) return E_FAIL;
+    return IOleObject_QueryInterface( This->pOleDelegate, &IID_IUnknown, (void **)unk );
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_UnbindSource( IOleLink *iface )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+
+    TRACE("(%p)\n", This);
+#ifndef SG_MUTANT_LINK_UNBIND
+    DefaultHandler_Stop(This);
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI DefaultHandler_IOleLink_Update( IOleLink *iface, IBindCtx *bc )
+{
+    DefaultHandler *This = impl_from_IOleLink(iface);
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, bc);
+    /* binds the source and brings the presentation up to date from it */
+    if (FAILED(hr = link_bind( This, bc, 0 ))) return hr;
+    start_object_call( This );
+    hr = IOleObject_Update( This->pOleDelegate );
+    end_object_call( This );
+    if (SUCCEEDED(hr))
+    {
+        IOleCache2 *cache;
+        if (SUCCEEDED(IUnknown_QueryInterface( This->dataCache, &IID_IOleCache2, (void **)&cache )))
+        {
+            IOleCache2_UpdateCache( cache, This->pDataDelegate, UPDFCACHE_ALL, NULL );
+            IOleCache2_Release( cache );
+        }
+        GetSystemTimeAsFileTime( &This->link_update_time );
+    }
+    return hr;
+}
+
+static const IOleLinkVtbl DefaultHandler_IOleLink_VTable =
+{
+    DefaultHandler_IOleLink_QueryInterface,
+    DefaultHandler_IOleLink_AddRef,
+    DefaultHandler_IOleLink_Release,
+    DefaultHandler_IOleLink_SetUpdateOptions,
+    DefaultHandler_IOleLink_GetUpdateOptions,
+    DefaultHandler_IOleLink_SetSourceMoniker,
+    DefaultHandler_IOleLink_GetSourceMoniker,
+    DefaultHandler_IOleLink_SetSourceDisplayName,
+    DefaultHandler_IOleLink_GetSourceDisplayName,
+    DefaultHandler_IOleLink_BindToSource,
+    DefaultHandler_IOleLink_BindIfRunning,
+    DefaultHandler_IOleLink_GetBoundSource,
+    DefaultHandler_IOleLink_UnbindSource,
+    DefaultHandler_IOleLink_Update
+};
+
+/* the link's \1Ole stream: header, no reserved moniker, no relative moniker,
+ * the absolute source moniker, the class, no display name, the update times */
+static HRESULT save_link_stream( DefaultHandler *This, IStorage *storage )
+{
+    ole_stream_header_t header = { ole_stream_version, 1, This->link_update, 0, 0 };
+    IStream *stream, *mkstream = NULL;
+    IPersistStream *persist;
+    DWORD zero = 0, size = 0;
+    LONG indicator = -1;
+    ULARGE_INTEGER pos;
+    LARGE_INTEGER start = {{0}};
+    FILETIME times[3];
+    HGLOBAL hglobal;
+    BYTE *data = NULL;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_LINK_NO_PERSIST
+    return S_OK;
+#endif
+    if (This->link_mk && SUCCEEDED(IMoniker_QueryInterface( This->link_mk, &IID_IPersistStream, (void **)&persist )))
+    {
+        if (SUCCEEDED(hr = CreateStreamOnHGlobal( NULL, TRUE, &mkstream )))
+            hr = OleSaveToStream( persist, mkstream );
+        IPersistStream_Release( persist );
+        if (FAILED(hr))
+        {
+            if (mkstream) IStream_Release( mkstream );
+            return hr;
+        }
+        IStream_Seek( mkstream, start, STREAM_SEEK_CUR, &pos );
+        size = pos.LowPart;
+        GetHGlobalFromStream( mkstream, &hglobal );
+        data = GlobalLock( hglobal );
+    }
+    hr = IStorage_CreateStream( storage, L"\1Ole", STGM_CREATE | STGM_WRITE | STGM_SHARE_EXCLUSIVE, 0, 0, &stream );
+    if (SUCCEEDED(hr))
+    {
+        times[0] = times[1] = This->link_update_time;
+        times[2] = This->link_update_time;
+        IStream_Write( stream, &header, sizeof(header), NULL );
+        IStream_Write( stream, &zero, sizeof(zero), NULL );          /* relative source moniker */
+        IStream_Write( stream, &size, sizeof(size), NULL );          /* absolute source moniker */
+        if (size) IStream_Write( stream, data, size, NULL );
+        IStream_Write( stream, &indicator, sizeof(indicator), NULL );
+        IStream_Write( stream, &This->clsid, sizeof(This->clsid), NULL );
+        IStream_Write( stream, &zero, sizeof(zero), NULL );          /* display name */
+        IStream_Write( stream, &zero, sizeof(zero), NULL );          /* reserved */
+        hr = IStream_Write( stream, times, sizeof(times), NULL );
+        IStream_Release( stream );
+    }
+    if (mkstream)
+    {
+        GlobalUnlock( hglobal );
+        IStream_Release( mkstream );
+    }
+    return hr;
+}
+
+static HRESULT load_link_stream( DefaultHandler *This, IStream *stream, const ole_stream_header_t *header )
+{
+    LARGE_INTEGER skip;
+    IMoniker *mk = NULL;
+    DWORD size, read;
+    LONG indicator;
+    CLSID clsid;
+    HRESULT hr;
+
+    This->is_link = TRUE;
+    This->link_update = header->link_update_opt;
+    if (header->moniker_size)
+    {
+        skip.QuadPart = header->moniker_size;
+        IStream_Seek( stream, skip, STREAM_SEEK_CUR, NULL );
+    }
+    /* the relative source moniker, if any, then the absolute one */
+    if (FAILED(hr = IStream_Read( stream, &size, sizeof(size), &read )) || read != sizeof(size)) return S_OK;
+    if (size)
+    {
+        skip.QuadPart = size;
+        IStream_Seek( stream, skip, STREAM_SEEK_CUR, NULL );
+    }
+    if (FAILED(hr = IStream_Read( stream, &size, sizeof(size), &read )) || read != sizeof(size)) return S_OK;
+    if (size && FAILED(hr = OleLoadFromStream( stream, &IID_IMoniker, (void **)&mk )))
+    {
+        WARN("could not read the link's moniker: %#lx\n", hr);
+        return S_OK;
+    }
+    if (SUCCEEDED(IStream_Read( stream, &indicator, sizeof(indicator), &read )) && read == sizeof(indicator) &&
+        indicator == -1 && SUCCEEDED(IStream_Read( stream, &clsid, sizeof(clsid), &read )) && read == sizeof(clsid))
+        This->clsid = clsid;
+    if (This->link_mk) IMoniker_Release( This->link_mk );
+    This->link_mk = mk;
+    return S_OK;
+}
+
+/* a link object of class clsid (CLSID_NULL: the source's, learned at binding) */
+HRESULT DefaultHandler_CreateLink( REFCLSID clsid, IMoniker *mk, IUnknown **obj )
+{
+    DefaultHandler *This = DefaultHandler_Construct( clsid, NULL, 0, NULL );
+
+    if (!This) return E_OUTOFMEMORY;
+    This->is_link = TRUE;
+    if (mk) IMoniker_AddRef( mk );
+    This->link_mk = mk;
+    *obj = &This->IUnknown_iface;
+    return S_OK;
+}
+
 static const IOleObjectVtbl DefaultHandler_IOleObject_VTable =
 {
   DefaultHandler_QueryInterface,
@@ -2140,6 +2515,11 @@ static DefaultHandler* DefaultHandler_Construct(
   This->IRunnableObject_iface.lpVtbl = &DefaultHandler_IRunnableObject_VTable;
   This->IAdviseSink_iface.lpVtbl = &DefaultHandler_IAdviseSink_VTable;
   This->IPersistStorage_iface.lpVtbl = &DefaultHandler_IPersistStorage_VTable;
+  This->IOleLink_iface.lpVtbl = &DefaultHandler_IOleLink_VTable;
+  This->is_link = FALSE;
+  This->link_mk = NULL;
+  This->link_update = OLEUPDATE_ALWAYS;
+  This->link_update_time.dwLowDateTime = This->link_update_time.dwHighDateTime = 0;
 
   This->inproc_server = (flags & EMBDHLP_INPROC_SERVER) != 0;
 
@@ -2242,6 +2622,12 @@ static void DefaultHandler_Destroy(
   /* release delegates */
