From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wininet: GetUrlCacheConfigInfo quota and usage

GetUrlCacheConfigInfo reports the container's cache limit as dwQuota and the space its normal and sticky entries take as dwNormalUsage and dwExemptUsage, in kilobytes, as the documentation describes; they were a fixed figure (the index file's largest size) and zeros, and the call logged itself as a semi-stub.
---
--- a/dlls/wininet/urlcache.c
+++ b/dlls/wininet/urlcache.c
@@ -4521,7 +4521,7 @@
     cache_container *container;
     DWORD error;
 
-    FIXME("(%p, %p, %lx): semi-stub\n", info, size, flags);
+    TRACE("(%p, %p, %lx)\n", info, size, flags);
 
     if (!info || !(container = find_container(flags)))
     {
@@ -4546,6 +4546,21 @@
     info->dwExemptUsage = 0;
     info->dwCacheSize = container->file_size / 1024;
     lstrcpynW(info->CachePath, container->path, MAX_PATH);
+#ifndef SG_MUTANT_NO_CACHECFG
+    {
+        /* (wine-sg 8247) the container's own figures, in kilobytes: its cache limit (the quota), the space its
+         * entries take, and the part of that exempt from scavenging (sticky entries) */
+        urlcache_header *header = cache_container_lock_index(container);
+
+        if (header)
+        {
+            info->dwQuota = header->cache_limit.QuadPart / 1024;
+            info->dwNormalUsage = header->cache_usage.QuadPart / 1024;
+            info->dwExemptUsage = header->exempt_usage.QuadPart / 1024;
+            cache_container_unlock_index(container, header);
+        }
+    }
+#endif
 
     cache_container_close_index(container);
 
