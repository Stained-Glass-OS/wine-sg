From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernel32, kernelbase: GlobalXxx/LocalXxx errors for bad pointers and handles

Global/Local memory functions handed bad pointers and handles answered
differently from Windows, as Wine's own conformance test (heap.c, todo_wine)
records: an address that cannot be read is ERROR_NOACCESS for LocalFree,
LocalReAlloc, LocalFlags, LocalHandle and GlobalFree/GlobalReAlloc, but an
invalid handle for GlobalFlags, GlobalLock and GlobalHandle; GlobalFlags
validates a fixed block; LocalFlags of a bad pointer is LMEM_INVALID_HANDLE;
GlobalUnlock of a freed or invalid handle sets ERROR_INVALID_HANDLE and
answers TRUE.  The matching todo_wine marks are removed.

---
--- a/dlls/kernel32/heap.c
+++ b/dlls/kernel32/heap.c
@@ -125,6 +125,27 @@ static inline void *unsafe_ptr_from_HLOCAL( HLOCAL handle )
     return handle;
 }
 
+/* Windows looks at the header of the block an address would belong to: an
+ * address nobody can read there is ERROR_NOACCESS, a readable one that is not a
+ * block of the heap is an invalid handle */
+static inline BOOL ptr_is_inaccessible( const void *ptr )
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        volatile const char *p = ptr;
+        (void)*p;
+        (void)*(p - 2 * sizeof(void *));
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        ret = TRUE;
+    }
+    __ENDTRY
+    return ret;
+}
+
 
 /***********************************************************************
  *           GlobalLock   (KERNEL32.@)
@@ -144,6 +165,27 @@ static inline void *unsafe_ptr_from_HLOCAL( HLOCAL handle )
  */
 void *WINAPI GlobalLock( HGLOBAL handle )
 {
+    void *ptr;
+
+    /* a fixed block whose address cannot be read is an invalid handle here
+     * (LocalLock gives no error for it) */
+    if ((ptr = unsafe_ptr_from_HLOCAL( handle )))
+    {
+#ifndef SG_MUTANT_NO_GLOBAL_PTR_ERRORS
+        __TRY
+        {
+            volatile char *p = ptr;
+            *p |= 0;
+        }
+        __EXCEPT_PAGE_FAULT
+        {
+            SetLastError( ERROR_INVALID_HANDLE );
+            return NULL;
+        }
+        __ENDTRY
+#endif
+        return ptr;
+    }
     return LocalLock( handle );
 }
 
@@ -167,6 +209,23 @@ void *WINAPI GlobalLock( HGLOBAL handle )
 BOOL WINAPI GlobalUnlock( HGLOBAL handle )
 {
     if (unsafe_ptr_from_HLOCAL( handle )) return TRUE;
+#ifndef SG_MUTANT_NO_GLOBAL_PTR_ERRORS
+    /* a handle that is not (or no longer) a memory handle: Windows sets the error
+     * but answers TRUE, unlike LocalUnlock */
+    {
+        HANDLE heap = GetProcessHeap();
+        BOOL valid;
+
+        RtlLockHeap( heap );
+        valid = !!unsafe_mem_from_HLOCAL( handle );
+        RtlUnlockHeap( heap );
+        if (!valid && handle)
+        {
+            SetLastError( ERROR_INVALID_HANDLE );
+            return TRUE;
+        }
+    }
+#endif
     return LocalUnlock( handle );
 }
 
@@ -176,7 +235,11 @@ BOOL WINAPI GlobalUnlock( HGLOBAL handle )
  */
 HGLOBAL WINAPI GlobalHandle( const void *ptr )
 {
-    return LocalHandle( ptr );
+    HLOCAL handle = LocalHandle( ptr );
+
+    /* the two differ in the error for a pointer that is not a block */
+    if (!handle && GetLastError() == ERROR_NOACCESS) SetLastError( ERROR_INVALID_HANDLE );
+    return handle;
 }
 
 /***********************************************************************
@@ -277,8 +340,20 @@ UINT WINAPI GlobalFlags( HGLOBAL handle )
     HANDLE heap = GetProcessHeap();
     struct mem_entry *mem;
     UINT flags;
+    void *ptr;
 
-    if (unsafe_ptr_from_HLOCAL( handle )) return 0;
+    if ((ptr = unsafe_ptr_from_HLOCAL( handle )))
+    {
+#ifndef SG_MUTANT_NO_GLOBAL_PTR_ERRORS
+        if (!HeapValidate( heap, 0, ptr ))
+        {
+            WARN_(globalmem)( "invalid pointer %p\n", handle );
+            SetLastError( ERROR_INVALID_HANDLE );
+            return GMEM_INVALID_HANDLE;
+        }
+#endif
+        return 0;
+    }
 
     RtlLockHeap( heap );
     if ((mem = unsafe_mem_from_HLOCAL( handle )))
@@ -333,7 +408,18 @@ SIZE_T WINAPI LocalCompact( UINT minfree )
  */
 UINT WINAPI LocalFlags( HLOCAL handle )
 {
-    UINT flags = GlobalFlags( handle );
+    UINT flags;
+    void *ptr;
+
+    /* a pointer that is not a valid block is not accessible (GlobalFlags calls it
+     * an invalid handle) */
+    if ((ptr = unsafe_ptr_from_HLOCAL( handle )) && !HeapValidate( GetProcessHeap(), 0, ptr ))
+    {
+        WARN_(globalmem)( "invalid pointer %p\n", handle );
+        SetLastError( ptr_is_inaccessible( ptr ) ? ERROR_NOACCESS : ERROR_INVALID_HANDLE );
+        return LMEM_INVALID_HANDLE;
+    }
+    flags = GlobalFlags( handle );
     if (flags & GMEM_DISCARDABLE) flags |= LMEM_DISCARDABLE;
     return flags;
 }
@@ -360,7 +446,7 @@ HLOCAL WINAPI LocalHandle( const void *ptr )
     if (!HeapValidate( heap, HEAP_NO_SERIALIZE, ptr ) ||
         !RtlGetUserInfoHeap( heap, HEAP_NO_SERIALIZE, (void *)ptr, &handle, &flags ))
     {
-        SetLastError( ERROR_INVALID_HANDLE );
+        SetLastError( unsafe_ptr_from_HLOCAL( (HLOCAL)ptr ) && ptr_is_inaccessible( ptr ) ? ERROR_NOACCESS : ERROR_INVALID_HANDLE );
         handle = 0;
     }
     RtlUnlockHeap( heap );
--- a/dlls/kernel32/tests/heap.c
+++ b/dlls/kernel32/tests/heap.c
@@ -1580,7 +1580,6 @@ static void test_GlobalAlloc(void)
     ok( GetLastError() == ERROR_INVALID_HANDLE, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
     ret = GlobalUnlock( mem );
-    todo_wine
     ok( ret, "GlobalUnlock failed, error %lu\n", GetLastError() );
     ok( GetLastError() == ERROR_INVALID_HANDLE, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
@@ -1614,7 +1613,6 @@ static void test_GlobalAlloc(void)
     ok( GetLastError() == ERROR_INVALID_HANDLE, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
     ret = GlobalUnlock( invalid_mem );
-    todo_wine
     ok( ret, "GlobalUnlock failed, error %lu\n", GetLastError() );
     ok( GetLastError() == ERROR_INVALID_HANDLE, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
@@ -1637,13 +1635,10 @@ static void test_GlobalAlloc(void)
     SetLastError( 0xdeadbeef );
     tmp_mem = pGlobalFree( invalid_ptr );
     ok( tmp_mem == invalid_ptr, "GlobalFree succeeded\n" );
-    todo_wine
     ok( GetLastError() == ERROR_NOACCESS, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
     flags = GlobalFlags( invalid_ptr );
-    todo_wine
     ok( flags == GMEM_INVALID_HANDLE, "GlobalFlags succeeded\n" );
-    todo_wine
     ok( GetLastError() == ERROR_INVALID_HANDLE, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
     size = GlobalSize( invalid_ptr );
@@ -1652,7 +1647,6 @@ static void test_GlobalAlloc(void)
     SetLastError( 0xdeadbeef );
     ptr = GlobalLock( invalid_ptr );
     ok( !ptr, "GlobalLock succeeded\n" );
-    todo_wine
     ok( GetLastError() == ERROR_INVALID_HANDLE, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
     ret = GlobalUnlock( invalid_ptr );
@@ -1661,7 +1655,6 @@ static void test_GlobalAlloc(void)
     SetLastError( 0xdeadbeef );
     tmp_mem = GlobalReAlloc( invalid_ptr, 0, GMEM_MOVEABLE );
     ok( !tmp_mem, "GlobalReAlloc succeeded\n" );
-    todo_wine
     ok( GetLastError() == ERROR_NOACCESS, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
     tmp_mem = GlobalHandle( invalid_ptr );
@@ -2379,13 +2372,10 @@ static void test_LocalAlloc(void)
     SetLastError( 0xdeadbeef );
     tmp_mem = pLocalFree( invalid_ptr );
     ok( tmp_mem == invalid_ptr, "LocalFree succeeded\n" );
-    todo_wine
     ok( GetLastError() == ERROR_NOACCESS, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
     flags = LocalFlags( invalid_ptr );
-    todo_wine
     ok( flags == LMEM_INVALID_HANDLE, "LocalFlags succeeded\n" );
-    todo_wine
     ok( GetLastError() == ERROR_NOACCESS, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
     size = LocalSize( invalid_ptr );
@@ -2402,12 +2392,10 @@ static void test_LocalAlloc(void)
     SetLastError( 0xdeadbeef );
     tmp_mem = LocalReAlloc( invalid_ptr, 0, LMEM_MOVEABLE );
     ok( !tmp_mem, "LocalReAlloc succeeded\n" );
-    todo_wine
     ok( GetLastError() == ERROR_NOACCESS, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
     tmp_mem = LocalHandle( invalid_ptr );
     ok( !tmp_mem, "LocalHandle succeeded\n" );
-    todo_wine
     ok( GetLastError() == ERROR_NOACCESS, "got error %lu\n", GetLastError() );
 
     /* LMEM_FIXED block doesn't allow resize, though it succeeds with LMEM_MODIFY */
--- a/dlls/kernelbase/memory.c
+++ b/dlls/kernelbase/memory.c
@@ -1033,6 +1033,27 @@ static inline void *unsafe_ptr_from_HLOCAL( HLOCAL handle )
     return handle;
 }
 
+/* Windows looks at the header of the block an address would belong to: an
+ * address nobody can read there is ERROR_NOACCESS, a readable one that is not a
+ * block of the heap is an invalid handle */
+static inline BOOL ptr_is_inaccessible( const void *ptr )
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        volatile const char *p = ptr;
+        (void)*p;
+        (void)*(p - 2 * sizeof(void *));
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        ret = TRUE;
+    }
+    __ENDTRY
+    return ret;
+}
+
 void init_global_data(void)
 {
     global_data.mem_entries = VirtualAlloc( NULL, MAX_MEM_HANDLES * sizeof(struct mem_entry), MEM_COMMIT, PAGE_READWRITE );
@@ -1169,7 +1190,12 @@ HLOCAL WINAPI DECLSPEC_HOTPATCH LocalFree( HLOCAL handle )
     if (ret)
     {
         WARN_(globalmem)( "invalid handle %p\n", handle );
+#ifdef SG_MUTANT_NO_GLOBAL_PTR_ERRORS
         SetLastError( ERROR_INVALID_HANDLE );
+#else
+        /* an address that is not a block of the heap cannot be accessed */
+        SetLastError( unsafe_ptr_from_HLOCAL( handle ) && ptr_is_inaccessible( handle ) ? ERROR_NOACCESS : ERROR_INVALID_HANDLE );
+#endif
     }
     return ret;
 }
@@ -1283,7 +1309,12 @@ HLOCAL WINAPI DECLSPEC_HOTPATCH LocalReAlloc( HLOCAL handle, SIZE_T size, UINT f
             else SetLastError( ERROR_INVALID_PARAMETER );
         }
     }
-    else SetLastError( ERROR_INVALID_HANDLE );
+    else
+#ifdef SG_MUTANT_NO_GLOBAL_PTR_ERRORS
+        SetLastError( ERROR_INVALID_HANDLE );
+#else
+        SetLastError( unsafe_ptr_from_HLOCAL( handle ) && ptr_is_inaccessible( handle ) ? ERROR_NOACCESS : ERROR_INVALID_HANDLE );
+#endif
     RtlUnlockHeap( heap );
 
     return ret;
