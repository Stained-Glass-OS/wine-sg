From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Win+. and Win+; open the emoji panel

Issue #15: Win+. (and Win+;) opens the emoji panel, as on Windows:
explorer runs sg-shell's sg-emoji.exe /toggle through App Paths, as Win+H
runs voice typing; a second press closes it. Gate: test/shellkeys-gate.sh.
Mutant: SG_MUTANT_NO_WIN_PERIOD.
---
--- a/programs/explorer/shellkeys.c
+++ b/programs/explorer/shellkeys.c
@@ -8,7 +8,8 @@
  * Management and Computer Management), Win+H voice typing (sg-dictate.exe /toggle), Win+Shift+S and
  * Print Screen screen snipping (snippingtool.exe /clip), Ctrl+Shift+Esc Task Manager,
  * Win+Plus Magnifier (starts it, or zooms in), Win+Minus zooms out, Win+Esc
- * closes it, Win+Ctrl+O the On-Screen Keyboard (starts or closes it);
+ * closes it, Win+Ctrl+O the On-Screen Keyboard (starts or closes it), Win+. and
+ * Win+; the emoji panel (sg-emoji.exe /toggle);
  * Win+Left/Right snap the active window
  * to half the screen, Win+Up maximizes it, Win+Down restores or minimizes it.
  * Dragging a window to the left or right edge snaps it to that half, to the
@@ -51,7 +52,7 @@
 
 enum { SK_DESKTOP = 0x5700, SK_MINIMIZE_ALL, SK_RESTORE_ALL, SK_EXPLORER, SK_RUN, SK_SETTINGS, SK_SYSTEM,
        SK_QUICKLINK, SK_NOTIFY, SK_SNAP_LEFT, SK_SNAP_RIGHT, SK_MAXIMIZE, SK_DOWN, SK_DICTATE, SK_SNIP, SK_SNIP_PRTSC, SK_TASKMGR,
-       SK_MAG_IN, SK_MAG_IN_PAD, SK_MAG_OUT, SK_MAG_OUT_PAD, SK_MAG_CLOSE, SK_OSK, SK_LAST };
+       SK_MAG_IN, SK_MAG_IN_PAD, SK_MAG_OUT, SK_MAG_OUT_PAD, SK_MAG_CLOSE, SK_OSK, SK_EMOJI, SK_EMOJI_SEMI, SK_LAST };
 
 static HWND sk_tray;
 static HHOOK sk_hook;
@@ -559,6 +560,12 @@
         /* voice typing (sg-shell's sg-dictate, found through App Paths) */
         run( L"sg-dictate.exe", L"/toggle" );
         return TRUE;
+    case SK_EMOJI:
+    case SK_EMOJI_SEMI:
+        /* the emoji panel (sg-shell's sg-emoji, through App Paths), at the caret of the window
+         * in front, as Windows' Win+. opens it */
+        run( L"sg-emoji.exe", L"/toggle" );
+        return TRUE;
     case SK_SNIP:
     case SK_SNIP_PRTSC:
         /* screen snipping (sg-shell's Snipping Tool, through App Paths) */
@@ -650,6 +657,10 @@
     RegisterHotKey( tray, SK_MAXIMIZE, MOD_WIN, VK_UP );
     RegisterHotKey( tray, SK_DOWN, MOD_WIN, VK_DOWN );
     RegisterHotKey( tray, SK_DICTATE, MOD_WIN | MOD_NOREPEAT, 'H' );
+#ifndef SG_MUTANT_NO_WIN_PERIOD
+    RegisterHotKey( tray, SK_EMOJI, MOD_WIN | MOD_NOREPEAT, VK_OEM_PERIOD );
+    RegisterHotKey( tray, SK_EMOJI_SEMI, MOD_WIN | MOD_NOREPEAT, VK_OEM_1 );
+#endif
 #ifndef SG_MUTANT_NO_WIN_A
     RegisterHotKey( tray, SK_NOTIFY, MOD_WIN | MOD_NOREPEAT, 'A' );
 #endif
