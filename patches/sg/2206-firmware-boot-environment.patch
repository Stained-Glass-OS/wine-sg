+/* Windows reads the firmware ("system environment") variables only for a
+ * caller holding SeSystemEnvironmentPrivilege enabled (administrators have
+ * it, disabled until AdjustTokenPrivileges); everyone else is refused before
+ * anything is read, whatever the host's efivars permissions. */
+static NTSTATUS check_system_environment_privilege(void)
+{
+    PRIVILEGE_SET privs;
+    HANDLE token;
+    BOOLEAN held = FALSE;
+    NTSTATUS status;
+
+    privs.PrivilegeCount = 1;
+    privs.Control = PRIVILEGE_SET_ALL_NECESSARY;
+    privs.Privilege[0].Luid.LowPart = SE_SYSTEM_ENVIRONMENT_PRIVILEGE;
+    privs.Privilege[0].Luid.HighPart = 0;
+    privs.Privilege[0].Attributes = 0;
+    if (NtOpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ) &&
+        NtOpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+        return STATUS_PRIVILEGE_NOT_HELD;
+    status = NtPrivilegeCheck( token, &privs, &held );
+    NtClose( token );
+    if (status) return status;
+#ifdef SG_MUTANT_NO_SYSENV_PRIVILEGE
+    held = TRUE;
+#endif
+    return held ? STATUS_SUCCESS : STATUS_PRIVILEGE_NOT_HELD;
+}
+
+
 /******************************************************************************
  *              NtQuerySystemEnvironmentValueEx  (NTDLL.@)
  */
 NTSTATUS WINAPI NtQuerySystemEnvironmentValueEx( UNICODE_STRING *name, GUID *vendor, void *buffer,
                                                  ULONG *retlen, ULONG *attrib )
 {
-    FIXME( "(%s, %s, %p, %p, %p), stub\n", debugstr_us(name),
-           debugstr_guid(vendor), buffer, retlen, attrib );
-    return STATUS_NOT_IMPLEMENTED;
+    /* UEFI variables are what the "system environment" is today: Linux shows
+     * them as /sys/firmware/efi/efivars/NAME-GUID, 4 attribute bytes (the
+     * same bit values) followed by the data.  A BIOS machine has none. */
+    char path[256 + 64];
+    unsigned char *data;
+    unsigned int i, count;
+    ULONG avail, got;
+    int fd;
+    ssize_t n;
+    struct stat st;
+    NTSTATUS status;
+
+    TRACE( "(%s, %s, %p, %p, %p)\n", debugstr_us(name), debugstr_guid(vendor), buffer, retlen, attrib );
+
+    if (!name || !vendor || !retlen) return STATUS_INVALID_PARAMETER;
+    if ((status = check_system_environment_privilege())) return status;
+    if (!sg_booted_uefi()) return STATUS_NOT_IMPLEMENTED;
+
+    count = name->Length / sizeof(WCHAR);
+    if (!count || count > 128) return STATUS_INVALID_PARAMETER;
+    for (i = 0; i < count; i++)
+    {
+        WCHAR ch = name->Buffer[i];
+        /* variable names that cannot be a file name are not there */
+        if (ch < 0x20 || ch >= 0x7f || ch == '/') return STATUS_VARIABLE_NOT_FOUND;
+        path[sizeof("/sys/firmware/efi/efivars/") - 1 + i] = ch;
+    }
+    memcpy( path, "/sys/firmware/efi/efivars/", sizeof("/sys/firmware/efi/efivars/") - 1 );
+    snprintf( path + sizeof("/sys/firmware/efi/efivars/") - 1 + count, 48,
+              "-%08x-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+              (unsigned int)vendor->Data1, vendor->Data2, vendor->Data3,
+              vendor->Data4[0], vendor->Data4[1], vendor->Data4[2], vendor->Data4[3],
+              vendor->Data4[4], vendor->Data4[5], vendor->Data4[6], vendor->Data4[7] );
+
+    if ((fd = open( path, O_RDONLY )) == -1)
+        return errno == EACCES || errno == EPERM ? STATUS_ACCESS_DENIED : STATUS_VARIABLE_NOT_FOUND;
+    if (fstat( fd, &st ) || st.st_size < 4 || st.st_size > 1024 * 1024)
+    {
+        close( fd );
+        return STATUS_VARIABLE_NOT_FOUND;
+    }
+    if (!(data = malloc( st.st_size )))
+    {
+        close( fd );
+        return STATUS_NO_MEMORY;
+    }
+    n = read( fd, data, st.st_size );
+    close( fd );
+    if (n < 4)
+    {
+        free( data );
+        return STATUS_VARIABLE_NOT_FOUND;
+    }
+    avail = *retlen;
+    got = n - 4;
+    *retlen = got;
+#ifndef SG_MUTANT_NO_ATTRIB
+    if (attrib) *attrib = data[0] | data[1] << 8 | data[2] << 16 | (ULONG)data[3] << 24;
+#endif
+    if (got > avail)
+    {
+        status = STATUS_BUFFER_TOO_SMALL;
+    }
+    else
+    {
+        if (got && !buffer) status = STATUS_ACCESS_VIOLATION;
+        else
+        {
+            if (got) memcpy( buffer, data + 4, got );
+            status = STATUS_SUCCESS;
+        }
+    }
+    free( data );
+    return status;
 }
 
 
