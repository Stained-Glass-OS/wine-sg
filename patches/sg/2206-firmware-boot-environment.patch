+/* Stained Glass OS: firmware (UEFI) variables are read through
+ * NtQuerySystemEnvironmentValueEx, which, as on Windows, refuses a caller
+ * without SeSystemEnvironmentPrivilege enabled (ERROR_PRIVILEGE_NOT_HELD);
+ * the other errors are Windows': no UEFI is ERROR_INVALID_FUNCTION, a
+ * missing variable ERROR_ENVVAR_NOT_FOUND, a short buffer
+ * ERROR_INSUFFICIENT_BUFFER. */
+static DWORD get_firmware_variable( const WCHAR *name, const WCHAR *guid, void *buffer, DWORD size, DWORD *attrib )
+{
+    UNICODE_STRING nameW, guidW;
+    GUID vendor;
+    ULONG len = size, attr = 0;
+    NTSTATUS status;
+
+    if (!name || !guid)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    RtlInitUnicodeString( &nameW, name );
+    RtlInitUnicodeString( &guidW, guid );
+    if (RtlGUIDFromString( &guidW, &vendor ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    status = NtQuerySystemEnvironmentValueEx( &nameW, &vendor, buffer, &len, &attr );
+    if (attrib) *attrib = attr;
+    switch (status)
+    {
+    case STATUS_SUCCESS:
+        return len;
+    case STATUS_NOT_IMPLEMENTED:
+        SetLastError( ERROR_INVALID_FUNCTION );
+        return 0;
+    case STATUS_VARIABLE_NOT_FOUND:
+        SetLastError( ERROR_ENVVAR_NOT_FOUND );
+        return 0;
+    case STATUS_BUFFER_TOO_SMALL:
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return 0;
+    default:
+        SetLastError( RtlNtStatusToDosError( status ));
+        return 0;
+    }
+}
+
+static DWORD get_firmware_variable_a( const char *name, const char *guid, void *buffer, DWORD size, DWORD *attrib )
+{
+    WCHAR nameW[129], guidW[64];
+
+    if (!name || !guid)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    if (!MultiByteToWideChar( CP_ACP, 0, name, -1, nameW, ARRAY_SIZE(nameW) ) ||
+        !MultiByteToWideChar( CP_ACP, 0, guid, -1, guidW, ARRAY_SIZE(guidW) ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    return get_firmware_variable( nameW, guidW, buffer, size, attrib );
+}
+
