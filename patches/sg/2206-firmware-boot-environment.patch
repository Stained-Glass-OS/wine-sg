     return ret;
 }
 
+/* Stained Glass OS: the firmware facts behind SystemBootEnvironmentInformation
+ * and SystemSecureBootInformation come from the same places a Linux user looks
+ * at: /sys/firmware/efi exists only when booted through UEFI, the SecureBoot
+ * variable is exposed under efivars (4 attribute bytes, then the value), and
+ * the kernel's per-boot random id stands in for the boot application GUID. */
+static BOOL sg_booted_uefi(void)
+{
+    struct stat st;
+    return !stat( "/sys/firmware/efi", &st ) && S_ISDIR( st.st_mode );
+}
+
+static BOOL sg_read_secureboot_var( BOOL *enabled )
+{
+    unsigned char buf[16];
+    int fd, n;
+
+    if ((fd = open( "/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c", O_RDONLY )) == -1)
+        return FALSE;
+    n = read( fd, buf, sizeof(buf) );
+    close( fd );
+    if (n < 5) return FALSE;
+    *enabled = buf[4] == 1;
+    return TRUE;
+}
+
+static void sg_get_boot_guid( GUID *guid )
+{
+    unsigned char b[16];
+    char text[64];
+    int fd, n, i, j;
+
+    memset( guid, 0, sizeof(*guid) );
+    if ((fd = open( "/proc/sys/kernel/random/boot_id", O_RDONLY )) == -1) return;
+    n = read( fd, text, sizeof(text) - 1 );
+    close( fd );
+    if (n < 32) return;
+    text[n] = 0;
+    for (i = j = 0; text[i] && j < 16; )
+    {
+        int hi, lo;
+        if (text[i] == '-') { i++; continue; }
+        hi = text[i] >= 'a' ? text[i] - 'a' + 10 : text[i] >= 'A' ? text[i] - 'A' + 10 : text[i] - '0';
+        lo = text[i + 1] >= 'a' ? text[i + 1] - 'a' + 10 : text[i + 1] >= 'A' ? text[i + 1] - 'A' + 10 : text[i + 1] - '0';
+        if (hi < 0 || hi > 15 || lo < 0 || lo > 15) return;
+        b[j++] = hi << 4 | lo;
+        i += 2;
+    }
+    if (j < 16) return;
+    guid->Data1 = b[0] << 24 | b[1] << 16 | b[2] << 8 | b[3];
+    guid->Data2 = b[4] << 8 | b[5];
+    guid->Data3 = b[6] << 8 | b[7];
+    memcpy( guid->Data4, b + 8, 8 );
+}
+
