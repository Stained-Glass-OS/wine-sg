From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, winevulkan: Vulkan's window surface with no display driver is a headless one (9559)

A process with no display driver -- a service in session 0, a program
started without a desktop -- had no VK_KHR_win32_surface: the null
driver's host surface extension was a placeholder name no Vulkan
driver offers, so a vkCreateInstance that asked for it failed with
VK_ERROR_EXTENSION_NOT_PRESENT. DXVK asks for it in every instance, so
Direct3D 9, 10 and 11 failed outright there. On Windows Direct3D works
in services. Epic's updater service runs "EpicGamesLauncher.exe
-Commandlet=selfupdateinstall -RanAsService" to apply the launcher's
self-update; it crashed at start (D3D11 device null), and the launcher
staged its update and restarted for it every ~12 seconds, for good.

Now the null driver's host surface extension is VK_EXT_headless_surface
(Mesa's drivers and NVIDIA's have it), reported as VK_KHR_win32_surface
as the X11 and Wayland ones are, and a window's surface there is a
headless surface: an instance, a device and rendering work, presenting
goes nowhere.

Gate: test/headlessvk-gate.sh (no display, DXVK on lavapipe; SKIPs
without VK_EXT_headless_surface). Mutant SG_MUTANT_NO_HEADLESS_SURFACE
(win32u/vulkan.c).
---
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -557,8 +557,34 @@
     .p_get_host_surface_extension = win32u_get_host_surface_extension,
 };
 
+/* Stained Glass OS (wine-sg 9559): with no display driver -- a service in
+ * session 0, a program run with no desktop -- Vulkan still has its window
+ * surface extension, as on Windows (where Direct3D works in services):
+ * VK_KHR_win32_surface is the host's VK_EXT_headless_surface, and a window's
+ * surface a headless one. Without it DXVK could not create its instance and
+ * Direct3D 9-11 failed outright (Epic's updater service crashed at start). */
+typedef struct
+{
+    VkStructureType sType;
+    const void *pNext;
+    VkFlags flags;
+} sg_headless_surface_info;
+#define SG_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT ((VkStructureType)1000256000)
+typedef VkResult (VKAPI_PTR *sg_create_headless_surface)( VkInstance, const sg_headless_surface_info *,
+                                                          const VkAllocationCallbacks *, VkSurfaceKHR * );
+
 static VkResult nulldrv_vulkan_surface_create( HWND hwnd, VkInstance instance, VkSurfaceKHR *surface, void **private )
 {
+#ifndef SG_MUTANT_NO_HEADLESS_SURFACE
+    sg_headless_surface_info info = {SG_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT};
+    sg_create_headless_surface create;
+
+    if ((create = (sg_create_headless_surface)p_vkGetInstanceProcAddr( instance, "vkCreateHeadlessSurfaceEXT" )))
+    {
+        *private = NULL;
+        return create( instance, &info, NULL, surface );
+    }
+#endif
     FIXME( "stub!\n" );
     return VK_ERROR_INCOMPATIBLE_DRIVER;
 }
@@ -586,7 +612,11 @@
 
 static const char *nulldrv_get_host_surface_extension(void)
 {
+#ifndef SG_MUTANT_NO_HEADLESS_SURFACE
+    return "VK_EXT_headless_surface";   /* (9559) */
+#else
     return "VK_WINE_nulldrv_surface";
+#endif
 }
 
 static const struct vulkan_driver_funcs nulldrv_funcs =
--- a/dlls/winevulkan/vulkan.c
+++ b/dlls/winevulkan/vulkan.c
@@ -1274,6 +1274,20 @@
     return *count < phys_dev->extension_count ? VK_INCOMPLETE : VK_SUCCESS;
 }
 
+/* Stained Glass OS (wine-sg 9559): the display driver's own surface
+ * extension -- with no display driver, VK_EXT_headless_surface -- stands for
+ * VK_KHR_win32_surface like the X11 and Wayland ones do */
+static BOOL sg_is_driver_surface_extension(const char *name)
+{
+    const char *own = vk_funcs->p_get_host_surface_extension();
+    return own && !strcmp(name, own);
+}
+
+static BOOL sg_is_host_surface_extension(const char *name)
+{
+    return wine_vk_is_host_surface_extension(name) || sg_is_driver_surface_extension(name);
+}
+
 VkResult wine_vkEnumerateInstanceExtensionProperties(const char *name, uint32_t *count,
                                                      VkExtensionProperties *properties)
 {
@@ -1303,8 +1317,9 @@
      */
     for (i = 0, surface = 0; i < num_host_properties; i++)
     {
-        if (wine_vk_instance_extension_supported(host_properties[i].extensionName)
-                || (wine_vk_is_host_surface_extension(host_properties[i].extensionName) && !surface++))
+        if ((!sg_is_driver_surface_extension(host_properties[i].extensionName) &&
+             wine_vk_instance_extension_supported(host_properties[i].extensionName))
+                || (sg_is_host_surface_extension(host_properties[i].extensionName) && !surface++))
             num_properties++;
         else
             TRACE("Instance extension '%s' is not supported.\n", host_properties[i].extensionName);
@@ -1320,12 +1335,13 @@
 
     for (i = 0, j = 0, surface = 0; i < num_host_properties && j < *count; i++)
     {
-        if (wine_vk_instance_extension_supported(host_properties[i].extensionName))
+        if (!sg_is_driver_surface_extension(host_properties[i].extensionName) &&
+            wine_vk_instance_extension_supported(host_properties[i].extensionName))
         {
             TRACE("Enabling extension '%s'.\n", host_properties[i].extensionName);
             properties[j++] = host_properties[i];
         }
-        else if (wine_vk_is_host_surface_extension(host_properties[i].extensionName) && !surface++)
+        else if (sg_is_host_surface_extension(host_properties[i].extensionName) && !surface++)
         {
             VkExtensionProperties win32_surface = {VK_KHR_WIN32_SURFACE_EXTENSION_NAME, VK_KHR_WIN32_SURFACE_SPEC_VERSION};
             TRACE("Enabling VK_KHR_win32_surface.\n");
