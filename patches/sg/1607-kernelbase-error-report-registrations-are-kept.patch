From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: error report registrations are kept

WerRegisterMemoryBlock, WerRegisterFile, WerUnregisterMemoryBlock,
WerUnregisterFile and WerGetFlags failed with E_NOTIMPL; the runtime
exception module registrations and WerSetFlags kept nothing (Chrome,
Edge, .NET and Office register at start). No error report is made here,
but the registrations are kept as Windows keeps them: twice is
ERROR_ALREADY_EXISTS, unregistering what is not registered is
ERROR_NOT_FOUND, a memory block is at most 64 KB, at most 512 entries
and 16 runtime exception modules, bad file types and flags are
E_INVALIDARG, and WerGetFlags reads back WerSetFlags.

Gate: test/werreg-gate.sh. Mutant SG_MUTANT_NO_WER_REGISTRATION
(kernelbase/debug.c).
---
--- a/dlls/kernelbase/debug.c
+++ b/dlls/kernelbase/debug.c
@@ -35,6 +35,7 @@
 #include "werapi.h"
 
 #include "wine/exception.h"
+#include "wine/list.h"
 #include "wine/asm.h"
 #include "kernelbase.h"
 #include "wine/debug.h"
@@ -791,13 +792,116 @@ LONG WINAPI UnhandledExceptionFilter( EXCEPTION_POINTERS *epointers )
 }
 
 
+/* What a process registers for its error reports: memory blocks, files,
+ * runtime exception modules and its reporting flags. No report is made
+ * here, but the registrations are kept as Windows keeps them, with its
+ * limits and its answers for what was never registered: the stubs failed
+ * with E_NOTIMPL (Chrome, Edge, .NET and Office register at start). */
+#define WER_MAX_REGISTERED_ENTRIES 512
+#define WER_MAX_MEM_BLOCK_SIZE     (64 * 1024)
+#define WER_MAX_RUNTIME_MODULES    16
+#define WER_FILE_VALID_FLAGS       0x7  /* delete when done, anonymous data, compressed */
+
+struct wer_entry
+{
+    struct list entry;
+    int         kind;
+    const void *ptr;      /* memory block, module context */
+    DWORD       size;     /* memory block size, file type */
+    DWORD       flags;
+    WCHAR       name[MAX_PATH];
+};
+enum { WER_ENTRY_MEMORY, WER_ENTRY_FILE, WER_ENTRY_MODULE };
+
+static struct list wer_entries = LIST_INIT( wer_entries );
+static DWORD wer_flags;
+static CRITICAL_SECTION wer_cs;
+static CRITICAL_SECTION_DEBUG wer_cs_debug =
+{
+    0, 0, &wer_cs,
+    { &wer_cs_debug.ProcessLocksList, &wer_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": wer_cs") }
+};
+static CRITICAL_SECTION wer_cs = { &wer_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct wer_entry *find_wer_entry( int kind, const void *ptr, const WCHAR *name, unsigned int *count )
+{
+    struct wer_entry *entry, *found = NULL;
+
+    *count = 0;
+    LIST_FOR_EACH_ENTRY( entry, &wer_entries, struct wer_entry, entry )
+    {
+        if (entry->kind != kind) continue;
+        (*count)++;
+        if (found) continue;
+        if (kind == WER_ENTRY_MEMORY && entry->ptr == ptr) found = entry;
+        else if (kind == WER_ENTRY_FILE && !wcsicmp( entry->name, name )) found = entry;
+        else if (kind == WER_ENTRY_MODULE && entry->ptr == ptr && !wcsicmp( entry->name, name )) found = entry;
+    }
+    return found;
+}
+
+static HRESULT add_wer_entry( int kind, const void *ptr, DWORD size, DWORD flags, const WCHAR *name,
+                              unsigned int max )
+{
+    struct wer_entry *entry;
+    unsigned int count;
+    HRESULT hr = S_OK;
+
+    RtlEnterCriticalSection( &wer_cs );
+    if (find_wer_entry( kind, ptr, name, &count )) hr = HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS );
+    else if (count >= max) hr = HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+    else if (!(entry = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*entry) ))) hr = E_OUTOFMEMORY;
+    else
+    {
+        entry->kind = kind;
+        entry->ptr = ptr;
+        entry->size = size;
+        entry->flags = flags;
+        if (name) lstrcpynW( entry->name, name, ARRAY_SIZE(entry->name) );
+        list_add_tail( &wer_entries, &entry->entry );
+    }
+    RtlLeaveCriticalSection( &wer_cs );
+    return hr;
+}
+
+static HRESULT remove_wer_entry( int kind, const void *ptr, const WCHAR *name )
+{
+    struct wer_entry *entry;
+    unsigned int count;
+    HRESULT hr = S_OK;
+
+    RtlEnterCriticalSection( &wer_cs );
+    if (!(entry = find_wer_entry( kind, ptr, name, &count ))) hr = HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    else
+    {
+        list_remove( &entry->entry );
+        HeapFree( GetProcessHeap(), 0, entry );
+    }
+    RtlLeaveCriticalSection( &wer_cs );
+    return hr;
+}
+
 /***********************************************************************
  *         WerGetFlags   (kernelbase.@)
  */
 HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerGetFlags( HANDLE process, DWORD *flags )
 {
+#ifndef SG_MUTANT_NO_WER_REGISTRATION
+    TRACE( "(%p, %p)\n", process, flags );
+    if (!flags) return E_INVALIDARG;
+    if (process != GetCurrentProcess() && GetProcessId( process ) != GetCurrentProcessId())
+    {
+        if (!GetProcessId( process )) return HRESULT_FROM_WIN32( GetLastError() );
+        *flags = 0;  /* another process's are not known here */
+        return S_OK;
+    }
+    *flags = wer_flags;
+    return S_OK;
+#else
     FIXME( "(%p, %p) stub\n", process, flags );
     return E_NOTIMPL;
+#endif
 }
 
 
@@ -807,8 +911,16 @@ HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerGetFlags( HANDLE process, DWORD *flags
 HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerRegisterFile( const WCHAR *file, WER_REGISTER_FILE_TYPE type,
                                                         DWORD flags )
 {
+#ifndef SG_MUTANT_NO_WER_REGISTRATION
+    TRACE( "(%s, %d, %ld)\n", debugstr_w(file), type, flags );
+    if (!file || !*file || wcslen( file ) >= MAX_PATH || type <= 0 || type >= WerRegFileTypeMax ||
+        (flags & ~WER_FILE_VALID_FLAGS))
+        return E_INVALIDARG;
+    return add_wer_entry( WER_ENTRY_FILE, NULL, type, flags, file, WER_MAX_REGISTERED_ENTRIES );
+#else
     FIXME( "(%s, %d, %ld) stub\n", debugstr_w(file), type, flags );
     return E_NOTIMPL;
+#endif
 }
 
 
@@ -817,8 +929,14 @@ HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerRegisterFile( const WCHAR *file, WER_R
  */
 HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerRegisterMemoryBlock( void *block, DWORD size )
 {
+#ifndef SG_MUTANT_NO_WER_REGISTRATION
+    TRACE( "(%p %ld)\n", block, size );
+    if (!block || !size || size > WER_MAX_MEM_BLOCK_SIZE) return E_INVALIDARG;
+    return add_wer_entry( WER_ENTRY_MEMORY, block, size, 0, NULL, WER_MAX_REGISTERED_ENTRIES );
+#else
     FIXME( "(%p %ld) stub\n", block, size );
     return E_NOTIMPL;
+#endif
 }
 
 
@@ -842,8 +960,14 @@ HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerUnregisterCustomMetadata( const WCHAR
 
 HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerRegisterRuntimeExceptionModule( const WCHAR *dll, void *context )
 {
+#ifndef SG_MUTANT_NO_WER_REGISTRATION
+    TRACE( "(%s, %p)\n", debugstr_w(dll), context );
+    if (!dll || !*dll || wcslen( dll ) >= MAX_PATH) return E_INVALIDARG;
+    return add_wer_entry( WER_ENTRY_MODULE, context, 0, 0, dll, WER_MAX_RUNTIME_MODULES );
+#else
     FIXME( "(%s, %p) stub\n", debugstr_w(dll), context );
     return S_OK;
+#endif
 }
 
 
@@ -852,7 +976,8 @@ HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerRegisterRuntimeExceptionModule( const
  */
 HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerSetFlags( DWORD flags )
 {
-    FIXME("(%ld) stub\n", flags);
+    TRACE("(%ld)\n", flags);
+    wer_flags = flags;
     return S_OK;
 }
 
@@ -862,8 +987,14 @@ HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerSetFlags( DWORD flags )
  */
 HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerUnregisterFile( const WCHAR *file )
 {
+#ifndef SG_MUTANT_NO_WER_REGISTRATION
+    TRACE( "(%s)\n", debugstr_w(file) );
+    if (!file) return E_INVALIDARG;
+    return remove_wer_entry( WER_ENTRY_FILE, NULL, file );
+#else
     FIXME( "(%s) stub\n", debugstr_w(file) );
     return E_NOTIMPL;
+#endif
 }
 
 
@@ -872,8 +1003,13 @@ HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerUnregisterFile( const WCHAR *file )
  */
 HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerUnregisterMemoryBlock( void *block )
 {
+#ifndef SG_MUTANT_NO_WER_REGISTRATION
+    TRACE( "(%p)\n", block );
+    return remove_wer_entry( WER_ENTRY_MEMORY, block, NULL );
+#else
     FIXME( "(%p) stub\n", block );
     return E_NOTIMPL;
+#endif
 }
 
 
@@ -882,8 +1018,14 @@ HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerUnregisterMemoryBlock( void *block )
  */
 HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerUnregisterRuntimeExceptionModule( const WCHAR *dll, void *context )
 {
+#ifndef SG_MUTANT_NO_WER_REGISTRATION
+    TRACE( "(%s, %p)\n", debugstr_w(dll), context );
+    if (!dll) return E_INVALIDARG;
+    return remove_wer_entry( WER_ENTRY_MODULE, context, dll );
+#else
     FIXME( "(%s, %p) stub\n", debugstr_w(dll), context );
     return S_OK;
+#endif
 }
 
 
