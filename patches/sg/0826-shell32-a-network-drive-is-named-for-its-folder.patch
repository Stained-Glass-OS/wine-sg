From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a network drive is named for its folder

File Explorer named every mapped drive "Network Drive (X:)", so one mapped
drive was told from another by its letter alone. As Windows names them, a
network drive is now named for the folder it is mapped to: "private
(\\fs1) (P:)", "alice (\\dc1\home) (H:)" -- through the network provider
(WNetGetConnection), loaded when a network drive is named.

Test: test/netuse-gate.sh (mutant SG_MUTANT_NETDRIVE_GENERIC_NAME).
---
--- a/dlls/shell32/shfldr_mycomp.c
+++ b/dlls/shell32/shfldr_mycomp.c
@@ -560,6 +560,17 @@
     return hr;
 }
 
+/* Stained Glass OS: the share a drive letter is mapped to (mpr, loaded when
+ * a network drive is named) */
+static DWORD net_connection(const WCHAR *local, WCHAR *remote, DWORD *size)
+{
+    static DWORD (WINAPI *get)(const WCHAR *, WCHAR *, DWORD *);
+    HMODULE mpr;
+
+    if (!get && (mpr = LoadLibraryW(L"mpr.dll"))) get = (void *)GetProcAddress(mpr, "WNetGetConnectionW");
+    return get ? get(local, remote, size) : ERROR_NOT_SUPPORTED;
+}
+
 /**************************************************************************
 *    ISF_MyComputer_fnGetDisplayNameOf
 */
@@ -671,14 +682,31 @@
             /* long view "lw_name (C:)" */
             if (!(dwFlags & SHGDN_FORPARSING))
             {
-                WCHAR wszDrive[32 /* label */ + 6 /* ' (C:)'\0 */] = {0};
-
-                GetVolumeInformationW (pszPath, wszDrive, ARRAY_SIZE(wszDrive) - 5, NULL, NULL,
+                WCHAR wszDrive[MAX_PATH + 6 /* ' (C:)'\0 */] = {0};
+                WCHAR remote[MAX_PATH], local[3] = { pszPath[0], ':', 0 }, *share;
+                DWORD size = ARRAY_SIZE(remote);
+                UINT type = GetDriveTypeW(pszPath);
+
+#ifndef SG_MUTANT_NETDRIVE_GENERIC_NAME
+                /* Stained Glass OS: a network drive is named for its folder, as
+                 * Windows names it -- "private (\\fs1) (P:)", "alice
+                 * (\\dc1\home) (H:)" -- not "Network Drive (P:)", which told
+                 * one mapped drive from another by its letter alone */
+                if (type == DRIVE_REMOTE && !net_connection(local, remote, &size) &&
+                    remote[0] == '\\' && remote[1] == '\\' && wcschr(remote + 2, '\\') &&
+                    (share = wcsrchr(remote + 2, '\\')) && share[1])
+                {
+                    *share++ = 0;
+                    swprintf(wszDrive, ARRAY_SIZE(wszDrive) - 6, L"%s (%s)", share, remote);
+                }
+                else
+#endif
+                GetVolumeInformationW (pszPath, wszDrive, 32, NULL, NULL,
                         NULL, NULL, 0);
                 /* Stained Glass: a drive without a label is named for its kind, as on Windows */
                 if (!wszDrive[0])
                 {
-                    switch (GetDriveTypeW(pszPath))
+                    switch (type)
                     {
                     case DRIVE_FIXED:     lstrcpyW(wszDrive, L"Local Disk"); break;
                     case DRIVE_REMOVABLE: lstrcpyW(wszDrive, L"USB Drive"); break;
