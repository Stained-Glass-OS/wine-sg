From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: CoGetStdMarshalEx (6012)

The standard marshaler aggregated by an outer object (SMEXF_SERVER,
SMEXF_HANDLER).
---
diff --git a/dlls/combase/combase.spec b/dlls/combase/combase.spec
index 75e9d60..f40dc4f 100644
--- a/dlls/combase/combase.spec
+++ b/dlls/combase/combase.spec
@@ -118,7 +118,7 @@
 @ stdcall CoGetPSClsid(ptr ptr)
 @ stub CoGetProcessIdentifier
 @ stdcall CoGetStandardMarshal(ptr ptr long ptr long ptr)
-@ stub CoGetStdMarshalEx
+@ stdcall CoGetStdMarshalEx(ptr long ptr)
 @ stub CoGetSystemSecurityPermissions
 @ stdcall CoGetTreatAsClass(ptr ptr)
 @ stdcall CoImpersonateClient()
diff --git a/dlls/combase/marshal.c b/dlls/combase/marshal.c
index c8baee6..226bc0a 100644
--- a/dlls/combase/marshal.c
+++ b/dlls/combase/marshal.c
@@ -2475,6 +2475,153 @@ HRESULT WINAPI InternalCoStdMarshalObject(REFIID riid, DWORD dest_context, void
     return StdMarshalImpl_Construct(riid, dest_context, dest_context_data, NULL, ppvObject);
 }
 
+#ifndef SMEXF_SERVER
+#define SMEXF_SERVER  0x01
+#define SMEXF_HANDLER 0x02
+#endif
+
+/* Stained Glass OS: the standard marshaler aggregated into another object
+ * (CoGetStdMarshalEx): its IMarshal delegates IUnknown to the outer object */
+struct stdmarshal_agg
+{
+    IUnknown IUnknown_inner;
+    IMarshal IMarshal_iface;
+    IUnknown *outer;
+    IMarshal *std;
+    LONG refcount;
+};
+
+static inline struct stdmarshal_agg *agg_from_IUnknown(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct stdmarshal_agg, IUnknown_inner);
+}
+
+static inline struct stdmarshal_agg *agg_from_IMarshal(IMarshal *iface)
+{
+    return CONTAINING_RECORD(iface, struct stdmarshal_agg, IMarshal_iface);
+}
+
+static HRESULT WINAPI agg_inner_QueryInterface(IUnknown *iface, REFIID riid, void **obj)
+{
+    struct stdmarshal_agg *agg = agg_from_IUnknown(iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown)) *obj = &agg->IUnknown_inner;
+    else if (IsEqualIID(riid, &IID_IMarshal)) *obj = &agg->IMarshal_iface;
+    else
+    {
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*obj);
+    return S_OK;
+}
+
+static ULONG WINAPI agg_inner_AddRef(IUnknown *iface)
+{
+    struct stdmarshal_agg *agg = agg_from_IUnknown(iface);
+    return InterlockedIncrement(&agg->refcount);
+}
+
+static ULONG WINAPI agg_inner_Release(IUnknown *iface)
+{
+    struct stdmarshal_agg *agg = agg_from_IUnknown(iface);
+    ULONG ref = InterlockedDecrement(&agg->refcount);
+
+    if (!ref)
+    {
+        IMarshal_Release(agg->std);
+        free(agg);
+    }
+    return ref;
+}
+
+static const IUnknownVtbl agg_inner_vtbl = { agg_inner_QueryInterface, agg_inner_AddRef, agg_inner_Release };
+
+static HRESULT WINAPI agg_QueryInterface(IMarshal *iface, REFIID riid, void **obj)
+{
+    return IUnknown_QueryInterface(agg_from_IMarshal(iface)->outer, riid, obj);
+}
+
+static ULONG WINAPI agg_AddRef(IMarshal *iface)
+{
+    return IUnknown_AddRef(agg_from_IMarshal(iface)->outer);
+}
+
+static ULONG WINAPI agg_Release(IMarshal *iface)
+{
+    return IUnknown_Release(agg_from_IMarshal(iface)->outer);
+}
+
+static HRESULT WINAPI agg_GetUnmarshalClass(IMarshal *iface, REFIID riid, void *pv, DWORD ctx, void *ctx_data,
+        DWORD flags, CLSID *clsid)
+{
+    return IMarshal_GetUnmarshalClass(agg_from_IMarshal(iface)->std, riid, pv, ctx, ctx_data, flags, clsid);
+}
+
+static HRESULT WINAPI agg_GetMarshalSizeMax(IMarshal *iface, REFIID riid, void *pv, DWORD ctx, void *ctx_data,
+        DWORD flags, DWORD *size)
+{
+    return IMarshal_GetMarshalSizeMax(agg_from_IMarshal(iface)->std, riid, pv, ctx, ctx_data, flags, size);
+}
+
+static HRESULT WINAPI agg_MarshalInterface(IMarshal *iface, IStream *stream, REFIID riid, void *pv, DWORD ctx,
+        void *ctx_data, DWORD flags)
+{
+    return IMarshal_MarshalInterface(agg_from_IMarshal(iface)->std, stream, riid, pv, ctx, ctx_data, flags);
+}
+
+static HRESULT WINAPI agg_UnmarshalInterface(IMarshal *iface, IStream *stream, REFIID riid, void **ppv)
+{
+    return IMarshal_UnmarshalInterface(agg_from_IMarshal(iface)->std, stream, riid, ppv);
+}
+
+static HRESULT WINAPI agg_ReleaseMarshalData(IMarshal *iface, IStream *stream)
+{
+    return IMarshal_ReleaseMarshalData(agg_from_IMarshal(iface)->std, stream);
+}
+
+static HRESULT WINAPI agg_DisconnectObject(IMarshal *iface, DWORD reserved)
+{
+    return IMarshal_DisconnectObject(agg_from_IMarshal(iface)->std, reserved);
+}
+
+static const IMarshalVtbl agg_marshal_vtbl =
+{
+    agg_QueryInterface, agg_AddRef, agg_Release, agg_GetUnmarshalClass, agg_GetMarshalSizeMax,
+    agg_MarshalInterface, agg_UnmarshalInterface, agg_ReleaseMarshalData, agg_DisconnectObject
+};
+
+/***********************************************************************
+ *            CoGetStdMarshalEx        (combase.@)
+ */
+HRESULT WINAPI CoGetStdMarshalEx(IUnknown *outer, DWORD flags, IUnknown **inner)
+{
+    struct stdmarshal_agg *agg;
+    HRESULT hr;
+
+    TRACE("%p, %#lx, %p\n", outer, flags, inner);
+
+    if (!inner) return E_INVALIDARG;
+    *inner = NULL;
+    /* the standard marshaler of a server, or of a client-side handler */
+    if (!outer || (flags != SMEXF_SERVER && flags != SMEXF_HANDLER)) return E_INVALIDARG;
+    if (!(agg = calloc(1, sizeof(*agg)))) return E_OUTOFMEMORY;
+    if (FAILED(hr = StdMarshalImpl_Construct(&IID_IMarshal, 0, NULL, NULL, (void **)&agg->std)))
+    {
+        free(agg);
+        return hr;
+    }
+    agg->IUnknown_inner.lpVtbl = &agg_inner_vtbl;
+    agg->IMarshal_iface.lpVtbl = &agg_marshal_vtbl;
+    agg->outer = outer;
+    agg->refcount = 1;
+#ifdef SG_MUTANT_STDMARSHALEX_NOAGG
+    agg->outer = &agg->IUnknown_inner;
+#endif
+    *inner = &agg->IUnknown_inner;
+    return S_OK;
+}
+
 /***********************************************************************
  *            CoGetStandardMarshal        (combase.@)
  */
diff --git a/dlls/ole32/ole32.spec b/dlls/ole32/ole32.spec
index 517dce5..e956f6b 100644
--- a/dlls/ole32/ole32.spec
+++ b/dlls/ole32/ole32.spec
@@ -47,6 +47,7 @@
 @ stdcall CoGetObjectContext(ptr ptr) combase.CoGetObjectContext
 @ stdcall CoGetPSClsid(ptr ptr) combase.CoGetPSClsid
 @ stdcall CoGetStandardMarshal(ptr ptr long ptr long ptr) combase.CoGetStandardMarshal
+@ stdcall CoGetStdMarshalEx(ptr long ptr) combase.CoGetStdMarshalEx
 @ stdcall CoGetState(ptr)
 @ stub CoGetTIDFromIPID
 @ stdcall CoGetTreatAsClass(ptr ptr) combase.CoGetTreatAsClass
