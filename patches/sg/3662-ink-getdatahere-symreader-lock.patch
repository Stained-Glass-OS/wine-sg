From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] inkobj, diasymreader: GetDataHere, LockServer (3662)

inkobj, diasymreader: IDataObject::GetDataHere, class factory LockServer

The ink clipboard data object now serves GetDataHere into a caller-supplied
HGLOBAL (STG_E_MEDIUMFULL if the block is too small, DV_E_TYMED for other
media). The diasymreader class factory's LockServer returns S_OK.
---
diff --git a/dlls/diasymreader/main.c b/dlls/diasymreader/main.c
index 28e0525..650d95d 100644
--- a/dlls/diasymreader/main.c
+++ b/dlls/diasymreader/main.c
@@ -114,8 +114,8 @@ static HRESULT WINAPI ClassFactoryImpl_CreateInstance(IClassFactory *iface,
 
 static HRESULT WINAPI ClassFactoryImpl_LockServer(IClassFactory *iface, BOOL lock)
 {
-    TRACE("(%p, %i): stub\n", iface, lock);
-    return E_NOTIMPL;
+    TRACE("(%p, %i)\n", iface, lock);
+    return S_OK;
 }
 
 static const IClassFactoryVtbl ClassFactoryImpl_Vtbl = {
diff --git a/dlls/inkobj/inkobj.c b/dlls/inkobj/inkobj.c
index f161671..419f6aa 100644
--- a/dlls/inkobj/inkobj.c
+++ b/dlls/inkobj/inkobj.c
@@ -3158,7 +3158,21 @@ static HRESULT WINAPI dataobj_GetData(IDataObject *iface, FORMATETC *fmt, STGMED
 
 static HRESULT WINAPI dataobj_GetDataHere(IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium)
 {
-    return E_NOTIMPL;
+    struct dataobj *d = impl_from_IDataObject(iface);
+    HRESULT hr;
+    void *p;
+
+    if (!fmt || !medium) return E_INVALIDARG;
+    if (FAILED(hr = dataobj_check(fmt))) return hr;
+    if (medium->tymed != TYMED_HGLOBAL) return DV_E_TYMED;
+    if (!medium->hGlobal) return E_INVALIDARG;
+#ifndef SG_MUTANT_INK_HERE
+    if (GlobalSize(medium->hGlobal) < d->size) return STG_E_MEDIUMFULL;
+#endif
+    if (!(p = GlobalLock(medium->hGlobal))) return E_OUTOFMEMORY;
+    memcpy(p, d->data, d->size);
+    GlobalUnlock(medium->hGlobal);
+    return S_OK;
 }
 
 static HRESULT WINAPI dataobj_QueryGetData(IDataObject *iface, FORMATETC *fmt)
