From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the desktop names files as the shell does

The desktop named every file by its file name, hiding only .lnk and .url.
A Linux app's .desktop file (Steam puts one there) read "steam.desktop"
though its type says NeverShowExt. Now the shell's display name
(SHGFI_DISPLAYNAME): NeverShowExt and the user's HideFileExt apply.
---
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -708,10 +708,13 @@
     if (!(launcher = calloc( 1, sizeof(*launcher) ))) return FALSE;
     if (!(launcher->path = append_path( folder, filename, -1 ))) goto error;
     memset( &info, 0, sizeof(info) );
-    SHGetFileInfoW( launcher->path, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON | SHGFI_TYPENAME );
+    SHGetFileInfoW( launcher->path, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON | SHGFI_TYPENAME | SHGFI_DISPLAYNAME );
     if (!(launcher->icon = info.hIcon)) goto error;
     launcher->icon = sized_file_icon( launcher->path, 0, launcher->icon );
-    launcher->title = hide_ext ? build_title( filename, -1 ) : wcsdup( filename );
+    /* the name as the shell shows it: without the extension where the user
+     * hides them, or the file type never shows one (NeverShowExt -- a Linux
+     * app's .desktop file reads "steam", not "steam.desktop") */
+    launcher->title = hide_ext ? build_title( filename, -1 ) : wcsdup( info.szDisplayName[0] ? info.szDisplayName : filename );
     launcher->type = wcsdup( (data->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) ? L"" : info.szTypeName );
     launcher->is_file = TRUE;
     launcher->is_dir = (data->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
