     if ((status = generate_symmetric_key( alg, ret_handle, secret, secret_len ))) return status;
     TRACE( "returning handle %p\n", *ret_handle );
     return STATUS_SUCCESS;
@@ -3172,6 +3209,302 @@ static NTSTATUS derive_key_hash( struct secret *secret, BCryptBufferDesc *desc,
     return status;
 }
 
+/***********************************************************************
+ * Key derivation functions (BCryptKeyDerivation): PBKDF2 (RFC 8018),
+ * HKDF (RFC 5869), the SP 800-56A concatenation KDF and the SP 800-108
+ * counter-mode KDF with HMAC -- all written from their specifications.
+ */
+
+static BOOL hash_id_from_name( const WCHAR *name, enum alg_id *id )
+{
+    static const struct { const WCHAR *name; enum alg_id id; } hashes[] =
+    {
+        { BCRYPT_SHA1_ALGORITHM, ALG_ID_SHA1 }, { BCRYPT_SHA256_ALGORITHM, ALG_ID_SHA256 },
+        { BCRYPT_SHA384_ALGORITHM, ALG_ID_SHA384 }, { BCRYPT_SHA512_ALGORITHM, ALG_ID_SHA512 },
+        { BCRYPT_MD5_ALGORITHM, ALG_ID_MD5 }, { BCRYPT_SHA3_256_ALGORITHM, ALG_ID_SHA3_256 },
+        { BCRYPT_SHA3_384_ALGORITHM, ALG_ID_SHA3_384 }, { BCRYPT_SHA3_512_ALGORITHM, ALG_ID_SHA3_512 },
+    };
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(hashes); i++)
+        if (!wcscmp( name, hashes[i].name )) { *id = hashes[i].id; return TRUE; }
+    return FALSE;
+}
+
+/* a pseudo algorithm object: the hash, keyed or not */
+static void kdf_hash_alg( struct algorithm *alg, enum alg_id id, BOOL hmac )
+{
+    memset( alg, 0, sizeof(*alg) );
+    alg->hdr.magic = MAGIC_ALG;
+    alg->id = id;
+    alg->flags = hmac ? BCRYPT_ALG_HANDLE_HMAC_FLAG : 0;
+}
+
+/* HMAC or hash over up to four pieces */
+static NTSTATUS kdf_mac( enum alg_id id, BOOL hmac, const UCHAR *key, ULONG key_len, const UCHAR **parts,
+                         const ULONG *lens, unsigned int count, UCHAR *out )
+{
+    struct algorithm alg;
+    struct hash *hash;
+    NTSTATUS status;
+    unsigned int i;
+
+    kdf_hash_alg( &alg, id, hmac );
+    if ((status = hash_create( &alg, (UCHAR *)key, key_len, 0, &hash ))) return status;
+    for (i = 0; i < count && !status; i++)
+        if (lens[i]) status = hash_update( &hash->inner, hash->alg_id, (UCHAR *)parts[i], lens[i] );
+    if (!status) status = hash_finalize( hash, out );
+    hash_destroy( hash );
+    return status;
+}
+
+static const BCryptBuffer *kdf_param( const BCryptBufferDesc *desc, ULONG type )
+{
+    ULONG i;
+    if (!desc) return NULL;
+    for (i = 0; i < desc->cBuffers; i++) if (desc->pBuffers[i].BufferType == type) return &desc->pBuffers[i];
+    return NULL;
+}
+
+static NTSTATUS kdf_hash_param( const BCryptBufferDesc *desc, enum alg_id *id )
+{
+    const BCryptBuffer *buf = kdf_param( desc, KDF_HASH_ALGORITHM );
+    if (!buf) return STATUS_INVALID_PARAMETER;
+    if (!buf->pvBuffer || !hash_id_from_name( buf->pvBuffer, id )) return STATUS_NOT_SUPPORTED;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS set_hkdf_property( struct key *key, const WCHAR *prop, UCHAR *value, ULONG size )
+{
+    UCHAR prk[MAX_HASH_OUTPUT_BYTES], *copy;
+    const UCHAR *parts[1];
+    ULONG lens[1], len;
+    NTSTATUS status;
+
+    if (key->alg_id != ALG_ID_HKDF) return STATUS_NOT_SUPPORTED;
+    if (!wcscmp( prop, BCRYPT_HKDF_HASH_ALGORITHM ))
+    {
+        if (key->u.k.finalized) return STATUS_INVALID_PARAMETER;
+        if (!value || !hash_id_from_name( (const WCHAR *)value, &key->u.k.hash )) return STATUS_NOT_SUPPORTED;
+        key->u.k.hash_set = TRUE;
+        return STATUS_SUCCESS;
+    }
+    if (!wcscmp( prop, BCRYPT_HKDF_SALT_AND_FINALIZE ))
+    {
+        /* extract: PRK = HMAC-Hash(salt, IKM) */
+        if (!key->u.k.hash_set || key->u.k.finalized) return STATUS_INVALID_PARAMETER;
+        len = builtin_algorithms[key->u.k.hash].hash_length;
+        parts[0] = key->u.k.secret;
+        lens[0] = key->u.k.secret_len;
+        if (size) status = kdf_mac( key->u.k.hash, TRUE, value, size, parts, lens, 1, prk );
+        else
+        {
+            UCHAR zeros[MAX_HASH_OUTPUT_BYTES] = {0};  /* no salt: HashLen zeros */
+            status = kdf_mac( key->u.k.hash, TRUE, zeros, len, parts, lens, 1, prk );
+        }
+        if (status) return status;
+        if (!(copy = malloc( len ))) return STATUS_NO_MEMORY;
+        memcpy( copy, prk, len );
+        if (key->u.k.secret) SecureZeroMemory( key->u.k.secret, key->u.k.secret_len );
+        free( key->u.k.secret );
+        key->u.k.secret = copy;
+        key->u.k.secret_len = len;
+        key->u.k.finalized = TRUE;
+        SecureZeroMemory( prk, sizeof(prk) );
+        return STATUS_SUCCESS;
+    }
+    if (!wcscmp( prop, BCRYPT_HKDF_PRK_AND_FINALIZE ))
+    {
+        /* the key already is the pseudorandom key */
+        if (!key->u.k.hash_set || key->u.k.finalized) return STATUS_INVALID_PARAMETER;
+        key->u.k.finalized = TRUE;
+        return STATUS_SUCCESS;
+    }
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS kdf_hkdf( struct key *key, const BCryptBufferDesc *desc, UCHAR *out, ULONG out_len )
+{
+    const BCryptBuffer *info = kdf_param( desc, KDF_HKDF_INFO );
+    UCHAR t[MAX_HASH_OUTPUT_BYTES], counter;
+    ULONG hash_len, done = 0, t_len = 0;
+    const UCHAR *parts[3];
+    ULONG lens[3];
+    NTSTATUS status;
+
+    if (!key->u.k.finalized) return STATUS_INVALID_PARAMETER;
+    hash_len = builtin_algorithms[key->u.k.hash].hash_length;
+    if (out_len > 255 * hash_len) return STATUS_INVALID_PARAMETER;
+    /* expand: T(i) = HMAC-Hash(PRK, T(i-1) | info | i) */
+    for (counter = 1; done < out_len; counter++)
+    {
+        parts[0] = t; lens[0] = t_len;
+        parts[1] = info ? info->pvBuffer : NULL; lens[1] = info ? info->cbBuffer : 0;
+        parts[2] = &counter; lens[2] = 1;
+        if ((status = kdf_mac( key->u.k.hash, TRUE, key->u.k.secret, key->u.k.secret_len, parts, lens, 3, t )))
+            return status;
+        t_len = hash_len;
+        memcpy( out + done, t, min( hash_len, out_len - done ) );
+        done += min( hash_len, out_len - done );
+    }
+    SecureZeroMemory( t, sizeof(t) );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS kdf_pbkdf2( struct key *key, const BCryptBufferDesc *desc, UCHAR *out, ULONG out_len )
+{
+    const BCryptBuffer *salt = kdf_param( desc, KDF_SALT ), *iter = kdf_param( desc, KDF_ITERATION_COUNT );
+    struct algorithm alg;
+    ULONGLONG iterations = 10000;  /* the documented default */
+    enum alg_id id;
+    NTSTATUS status;
+
+    if ((status = kdf_hash_param( desc, &id ))) return status;
+    if (iter)
+    {
+        if (iter->cbBuffer != sizeof(ULONGLONG) || !iter->pvBuffer) return STATUS_INVALID_PARAMETER;
+        iterations = *(ULONGLONG *)iter->pvBuffer;
+    }
+    if (!iterations) return STATUS_INVALID_PARAMETER;
+    kdf_hash_alg( &alg, id, TRUE );
+    return derive_key_pbkdf2( &alg, key->u.k.secret, key->u.k.secret_len, salt ? salt->pvBuffer : NULL,
+                              salt ? salt->cbBuffer : 0, iterations, out, out_len );
+}
+
+/* SP 800-56A 5.8.1: K(i) = H(counter | Z | AlgorithmID | PartyUInfo | PartyVInfo | SuppPub | SuppPriv) */
+static NTSTATUS kdf_concat( enum alg_id id, const UCHAR *z, ULONG z_len, const BCryptBufferDesc *desc,
+                            UCHAR *out, ULONG out_len )
+{
+    static const ULONG types[] = { KDF_ALGORITHMID, KDF_PARTYUINFO, KDF_PARTYVINFO, KDF_SUPPPUBINFO, KDF_SUPPPRIVINFO };
+    ULONG hash_len = builtin_algorithms[id].hash_length, done = 0, other_len = 0, i, counter;
+    UCHAR t[MAX_HASH_OUTPUT_BYTES], be[4], *other, *p;
+    const BCryptBuffer *buf;
+    const UCHAR *parts[3];
+    ULONG lens[3];
+    NTSTATUS status = STATUS_SUCCESS;
+
+    for (i = 0; i < ARRAY_SIZE(types); i++) if ((buf = kdf_param( desc, types[i] ))) other_len += buf->cbBuffer;
+    if (!(other = malloc( max( other_len, 1 ) ))) return STATUS_NO_MEMORY;
+    for (i = 0, p = other; i < ARRAY_SIZE(types); i++)
+        if ((buf = kdf_param( desc, types[i] )) && buf->cbBuffer)
+        {
+            memcpy( p, buf->pvBuffer, buf->cbBuffer );
+            p += buf->cbBuffer;
+        }
+    for (counter = 1; done < out_len && !status; counter++)
+    {
+        be[0] = counter >> 24; be[1] = counter >> 16; be[2] = counter >> 8; be[3] = counter;
+        parts[0] = be; lens[0] = 4;
+        parts[1] = z; lens[1] = z_len;
+        parts[2] = other; lens[2] = other_len;
+        if (!(status = kdf_mac( id, FALSE, NULL, 0, parts, lens, 3, t )))
+        {
+            memcpy( out + done, t, min( hash_len, out_len - done ) );
+            done += min( hash_len, out_len - done );
+        }
+    }
+    free( other );
+    SecureZeroMemory( t, sizeof(t) );
+    return status;
+}
+
+/* SP 800-108 5.1, HMAC PRF: K(i) = PRF(KI, i | Label | 0x00 | Context | L), counter and L 32-bit big-endian */
+static NTSTATUS kdf_sp800108( struct key *key, const BCryptBufferDesc *desc, UCHAR *out, ULONG out_len )
+{
+    const BCryptBuffer *label = kdf_param( desc, KDF_LABEL ), *context = kdf_param( desc, KDF_CONTEXT );
+    ULONG hash_len, done = 0, bits = out_len * 8, total, counter;
+    UCHAR t[MAX_HASH_OUTPUT_BYTES], *msg;
+    enum alg_id id;
+    NTSTATUS status;
+    const UCHAR *parts[1];
+    ULONG lens[1];
+
+    if ((status = kdf_hash_param( desc, &id ))) return status;
+    hash_len = builtin_algorithms[id].hash_length;
+    total = 4 + (label ? label->cbBuffer : 0) + 1 + (context ? context->cbBuffer : 0) + 4;
+    if (!(msg = malloc( total ))) return STATUS_NO_MEMORY;
+    for (counter = 1; done < out_len && !status; counter++)
+    {
+        UCHAR *p = msg;
+        *p++ = counter >> 24; *p++ = counter >> 16; *p++ = counter >> 8; *p++ = counter;
+        if (label && label->cbBuffer) { memcpy( p, label->pvBuffer, label->cbBuffer ); p += label->cbBuffer; }
+        *p++ = 0;
+        if (context && context->cbBuffer) { memcpy( p, context->pvBuffer, context->cbBuffer ); p += context->cbBuffer; }
+        *p++ = bits >> 24; *p++ = bits >> 16; *p++ = bits >> 8; *p++ = bits;
+        parts[0] = msg; lens[0] = total;
+        if (!(status = kdf_mac( id, TRUE, key->u.k.secret, key->u.k.secret_len, parts, lens, 1, t )))
+        {
+            memcpy( out + done, t, min( hash_len, out_len - done ) );
+            done += min( hash_len, out_len - done );
+        }
+    }
+    free( msg );
+    SecureZeroMemory( t, sizeof(t) );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptKeyDerivation( BCRYPT_KEY_HANDLE handle, BCryptBufferDesc *desc, UCHAR *output,
+                                     ULONG output_len, ULONG *ret_len, ULONG flags )
+{
+    struct key *key = get_key_object( handle );
+    NTSTATUS status;
+    enum alg_id id;
+
+    TRACE( "%p, %p, %p, %lu, %p, %#lx\n", handle, desc, output, output_len, ret_len, flags );
+
+    if (!key) return STATUS_INVALID_HANDLE;
+    if (!is_kdf_alg( key->alg_id )) return STATUS_NOT_SUPPORTED;
+    if (!output || !output_len || !ret_len || flags) return STATUS_INVALID_PARAMETER;
+
+    switch (key->alg_id)
+    {
+    case ALG_ID_PBKDF2:
+        status = kdf_pbkdf2( key, desc, output, output_len );
+        break;
+    case ALG_ID_HKDF:
+        status = kdf_hkdf( key, desc, output, output_len );
+        break;
+    case ALG_ID_SP80056A_CONCAT:
+        if (!(status = kdf_hash_param( desc, &id )))
+#ifndef SG_MUTANT_KDF_CONCAT_NO_OTHERINFO
+            status = kdf_concat( id, key->u.k.secret, key->u.k.secret_len, desc, output, output_len );
+#else
+            status = kdf_concat( id, key->u.k.secret, key->u.k.secret_len, NULL, output, output_len );
+#endif
+        break;
+    case ALG_ID_SP800108_CTR_HMAC:
+        status = kdf_sp800108( key, desc, output, output_len );
+        break;
+    default:
+        status = STATUS_NOT_SUPPORTED;
+        break;
+    }
+    if (!status) *ret_len = output_len;
+    return status;
+}
+
+/* BCryptDeriveKey(secret, "SP800_56A_CONCAT"): the agreed secret through the concatenation KDF */
+static NTSTATUS derive_key_concat( struct secret *secret, BCryptBufferDesc *desc, UCHAR *output, ULONG output_len,
+                                   ULONG *ret_len )
+{
+    UCHAR z[132];
+    ULONG z_len = 0;
+    enum alg_id id;
+    NTSTATUS status;
+
+    if ((status = kdf_hash_param( desc, &id ))) return status;
+    if (!output)
+    {
+        *ret_len = builtin_algorithms[id].hash_length;
+        return STATUS_SUCCESS;
+    }
+    if ((status = derive_key_raw( secret, z, sizeof(z), &z_len ))) return status;
+    reverse_bytes( z, z_len );  /* the raw form is little-endian; the KDF takes Z as the field element's bytes */
+    status = kdf_concat( id, z, z_len, desc, output, output_len );
+    SecureZeroMemory( z, sizeof(z) );
+    if (!status) *ret_len = output_len;
+    return status;
+}
+
 NTSTATUS WINAPI BCryptDeriveKey( BCRYPT_SECRET_HANDLE handle, const WCHAR *kdf, BCryptBufferDesc *desc,
                                  UCHAR *output, ULONG output_len, ULONG *ret_len, ULONG flags )
 {
@@ -3191,6 +3524,10 @@ NTSTATUS WINAPI BCryptDeriveKey( BCRYPT_SECRET_HANDLE handle, const WCHAR *kdf,
     {
         return derive_key_hash( secret, desc, output, output_len, ret_len );
     }
+    else if (!wcscmp(kdf, BCRYPT_KDF_SP80056A_CONCAT))
+    {
+        return derive_key_concat( secret, desc, output, output_len, ret_len );
+    }
 
     FIXME( "kdf %s not supportedi\n", debugstr_w(kdf) );
     return STATUS_NOT_SUPPORTED;
diff --git a/include/bcrypt.h b/include/bcrypt.h
index 768daea..43e7f00 100644
--- a/include/bcrypt.h
+++ b/include/bcrypt.h
@@ -127,6 +127,10 @@ typedef LONG NTSTATUS;
 #define BCRYPT_KDF_TLS_PRF          L"TLS_PRF"
