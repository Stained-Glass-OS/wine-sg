--- a/dlls/bcrypt/bcrypt_internal.h
+++ b/dlls/bcrypt/bcrypt_internal.h
@@ -157,6 +157,12 @@ enum alg_id
 
     /* rng */
     ALG_ID_RNG,
+
+    /* key derivation */
+    ALG_ID_PBKDF2,
+    ALG_ID_HKDF,
+    ALG_ID_SP80056A_CONCAT,
+    ALG_ID_SP800108_CTR_HMAC,
 };
 
 enum chain_mode
@@ -199,6 +205,16 @@ struct key_asymmetric
 };
 
 #define PRIVATE_DATA_SIZE 3
+/* a key derivation function's key: its secret, and HKDF's state */
+struct key_kdf
+{
+    UCHAR        *secret;
+    ULONG         secret_len;
+    enum alg_id   hash;         /* HKDF: the hash it was given */
+    BOOL          hash_set;
+    BOOL          finalized;    /* HKDF: the secret is the pseudorandom key now */
+};
+
 struct key
 {
     struct object hdr;
@@ -208,6 +224,7 @@ struct key
     {
         struct key_symmetric s;
         struct key_asymmetric a;
+        struct key_kdf k;
     } u;
 };
 
