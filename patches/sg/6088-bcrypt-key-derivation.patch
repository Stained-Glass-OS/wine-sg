     {
         UNIX_CALL( key_symmetric_destroy, key );
         free( key->u.s.vector );
@@ -2368,6 +2386,25 @@ NTSTATUS WINAPI BCryptGenerateSymmetricKey( BCRYPT_ALG_HANDLE handle, BCRYPT_KEY
     }
 
     if (!alg) return STATUS_INVALID_HANDLE;
+    if (is_kdf_alg( alg->id ))
+    {
+        /* a key derivation function's key is its secret */
+        struct key *key;
+
+        if (!ret_handle || (!secret && secret_len)) return STATUS_INVALID_PARAMETER;
+        if (!(key = calloc( 1, sizeof(*key) ))) return STATUS_NO_MEMORY;
