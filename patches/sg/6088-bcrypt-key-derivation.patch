     {{ MAGIC_ALG }, ALG_ID_SHA3_512 },
@@ -897,8 +907,11 @@ static NTSTATUS set_alg_property( struct algorithm *alg, const WCHAR *prop, UCHA
     }
 }
 
+static NTSTATUS set_hkdf_property( struct key *key, const WCHAR *prop, UCHAR *value, ULONG size );
+
 static NTSTATUS set_key_property( struct key *key, const WCHAR *prop, UCHAR *value, ULONG size, ULONG flags )
 {
+    if (is_kdf_alg( key->alg_id )) return set_hkdf_property( key, prop, value, size );
     if (!wcscmp( prop, BCRYPT_CHAINING_MODE ))
     {
         if (!wcscmp( (WCHAR *)value, BCRYPT_CHAIN_MODE_ECB ))
@@ -1962,7 +1975,12 @@ static NTSTATUS key_symmetric_decrypt( struct key *key, UCHAR *input, ULONG inpu
 
 static void key_destroy( struct key *key )
 {
-    if (is_symmetric_key( key ))
+    if (is_kdf_alg( key->alg_id ))
+    {
+        if (key->u.k.secret) SecureZeroMemory( key->u.k.secret, key->u.k.secret_len );
+        free( key->u.k.secret );
+    }
