@@ -1383,8 +1383,13 @@ static HRESULT WINAPI ImagingFactory_CreateQueryWriterFromReader(IWICImagingFact
 
 static HRESULT WINAPI ImagingFactory_CreateImageEncoder(IWICImagingFactory2 *iface, ID2D1Device *device, IWICImageEncoder **encoder)
 {
-    FIXME("%p,%p,%p stub.\n", iface, device, encoder);
+    TRACE("%p,%p,%p\n", iface, device, encoder);
+
+#ifdef SG_MUTANT_WIC_IMAGEENC_STUB
     return E_NOTIMPL;
+#endif
+    /* Stained Glass OS: imageencoder.c */
+    return ImageEncoder_Create(device, encoder);
 }
 
 static const IWICImagingFactory2Vtbl ImagingFactory_Vtbl = {
diff --git a/dlls/windowscodecs/wincodecs_private.h b/dlls/windowscodecs/wincodecs_private.h
index 4c04474..7b105ab 100644
--- a/dlls/windowscodecs/wincodecs_private.h
+++ b/dlls/windowscodecs/wincodecs_private.h
@@ -150,7 +150,8 @@ extern HRESULT TgaDecoder_CreateInstance(REFIID iid, void** ppv);
 extern HRESULT DdsDecoder_CreateInstance(REFIID iid, void** ppv);
 extern HRESULT DdsEncoder_CreateInstance(REFIID iid, void** ppv);
 
-extern HRESULT BitmapImpl_Create(UINT uiWidth, UINT uiHeight,
+extern HRESULT ImageEncoder_Create(ID2D1Device *device, IWICImageEncoder **encoder);
