+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Stained Glass OS: IWICImagingFactory2::CreateImageEncoder gave E_NOTIMPL, so a program could not
+ * save what it drew with Direct2D through WIC (screenshot and drawing tools, the Windows samples'
+ * SaveToImageFile). The image is drawn on the encoder's device into a bitmap of its own, copied into
+ * one the CPU reads, and that is written to the frame (or set as a thumbnail) as a WIC bitmap, which
+ * the frame converts to its own pixel format. */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "d2d1_1.h"
+#include "wincodecs_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wincodecs);
+
+static const GUID iid_d2d_bitmap = {0xa2296057,0xea42,0x4099,{0x98,0x3b,0x53,0x9f,0xb6,0x50,0x54,0x26}};
+
+struct image_encoder
+{
+    IWICImageEncoder IWICImageEncoder_iface;
+    LONG ref;
+    ID2D1Device *device;
+};
+
+static inline struct image_encoder *impl_from_IWICImageEncoder( IWICImageEncoder *iface )
+{
+    return CONTAINING_RECORD( iface, struct image_encoder, IWICImageEncoder_iface );
+}
+
+static HRESULT WINAPI image_encoder_QueryInterface( IWICImageEncoder *iface, REFIID iid, void **out )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_INVALIDARG;
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IWICImageEncoder ))
+    {
+        *out = iface;
+        IWICImageEncoder_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI image_encoder_AddRef( IWICImageEncoder *iface )
+{
+    return InterlockedIncrement( &impl_from_IWICImageEncoder( iface )->ref );
+}
+
+static ULONG WINAPI image_encoder_Release( IWICImageEncoder *iface )
+{
+    struct image_encoder *encoder = impl_from_IWICImageEncoder( iface );
+    ULONG ref = InterlockedDecrement( &encoder->ref );
+
+    if (!ref)
+    {
+        ID2D1Device_Release( encoder->device );
+        free( encoder );
+    }
+    return ref;
+}
+
+/* the WIC pixel format of the Direct2D one */
+static HRESULT wic_format( const D2D1_PIXEL_FORMAT *format, WICPixelFormatGUID *wic )
+{
+    BOOL premultiplied = format->alphaMode == D2D1_ALPHA_MODE_PREMULTIPLIED;
+
+    switch (format->format)
+    {
+    case DXGI_FORMAT_B8G8R8A8_UNORM:
+        *wic = format->alphaMode == D2D1_ALPHA_MODE_IGNORE ? GUID_WICPixelFormat32bppBGR :
+               premultiplied ? GUID_WICPixelFormat32bppPBGRA : GUID_WICPixelFormat32bppBGRA;
+        return S_OK;
+    case DXGI_FORMAT_R8G8B8A8_UNORM:
+        *wic = premultiplied ? GUID_WICPixelFormat32bppPRGBA : GUID_WICPixelFormat32bppRGBA;
+        return S_OK;
+    default:
+        FIXME( "DXGI format %#x\n", format->format );
+        return WINCODEC_ERR_UNSUPPORTEDPIXELFORMAT;
+    }
+}
+
+/* The image drawn into a WIC bitmap: the parameters' area of it, or all of it. */
+static HRESULT render_image( struct image_encoder *encoder, ID2D1Image *image, const WICImageParameters *params,
+                             IWICBitmap **out, double *dpi_x, double *dpi_y )
+{
+    D2D1_BITMAP_PROPERTIES1 props = { { DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED }, 96.0f, 96.0f };
+    D2D1_POINT_2F offset = { 0.0f, 0.0f };
+    ID2D1Bitmap1 *target = NULL, *readback = NULL;
+    ID2D1DeviceContext *context = NULL;
+    ID2D1Bitmap *bitmap = NULL;
+    D2D1_MAPPED_RECT mapped;
+    WICPixelFormatGUID format;
+    D2D1_SIZE_U size;
+    D2D1_RECT_F bounds;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = ID2D1Device_CreateDeviceContext( encoder->device, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &context )))
+        return hr;
+
+    if (params)
+    {
+        props.pixelFormat = params->PixelFormat;
+        props.dpiX = params->DpiX;
+        props.dpiY = params->DpiY;
+        size.width = params->PixelWidth;
+        size.height = params->PixelHeight;
+        offset.x = -params->Left;
+        offset.y = -params->Top;
+    }
+    else if (SUCCEEDED(ID2D1Image_QueryInterface( image, &iid_d2d_bitmap, (void **)&bitmap )))
+    {
+        /* a bitmap is written as it is */
+        size = ID2D1Bitmap_GetPixelSize( bitmap );
+        props.pixelFormat = ID2D1Bitmap_GetPixelFormat( bitmap );
+        ID2D1Bitmap_GetDpi( bitmap, &props.dpiX, &props.dpiY );
+        ID2D1Bitmap_Release( bitmap );
+    }
+    else
+    {
+        /* anything else: its bounds at 96 dpi */
+        if (FAILED(hr = ID2D1DeviceContext_GetImageLocalBounds( context, image, &bounds ))) goto done;
+        size.width = (UINT32)(bounds.right - bounds.left + 0.5f);
+        size.height = (UINT32)(bounds.bottom - bounds.top + 0.5f);
+        offset.x = -bounds.left;
+        offset.y = -bounds.top;
+    }
+    if (props.pixelFormat.format == DXGI_FORMAT_UNKNOWN) props.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    if (props.pixelFormat.alphaMode == D2D1_ALPHA_MODE_UNKNOWN) props.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    if (!props.dpiX) props.dpiX = 96.0f;
+    if (!props.dpiY) props.dpiY = 96.0f;
+    if (!size.width || !size.height)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    if (FAILED(hr = wic_format( &props.pixelFormat, &format ))) goto done;
+    *dpi_x = props.dpiX;
+    *dpi_y = props.dpiY;
+
+    /* drawn on the device ... */
+    props.bitmapOptions = D2D1_BITMAP_OPTIONS_TARGET | D2D1_BITMAP_OPTIONS_CANNOT_DRAW;
+    if (FAILED(hr = ID2D1DeviceContext_CreateBitmap( context, size, NULL, 0, &props, &target ))) goto done;
+    ID2D1DeviceContext_SetTarget( context, (ID2D1Image *)target );
+    ID2D1DeviceContext_BeginDraw( context );
+    ID2D1DeviceContext_Clear( context, NULL );
+    ID2D1DeviceContext_DrawImage( context, image, &offset, NULL, D2D1_INTERPOLATION_MODE_LINEAR,
+                                  D2D1_COMPOSITE_MODE_SOURCE_OVER );
+    if (FAILED(hr = ID2D1DeviceContext_EndDraw( context, NULL, NULL ))) goto done;
+    ID2D1DeviceContext_SetTarget( context, NULL );
+
+    /* ... and read back */
+    props.bitmapOptions = D2D1_BITMAP_OPTIONS_CPU_READ | D2D1_BITMAP_OPTIONS_CANNOT_DRAW;
+    if (FAILED(hr = ID2D1DeviceContext_CreateBitmap( context, size, NULL, 0, &props, &readback ))) goto done;
+    if (FAILED(hr = ID2D1Bitmap1_CopyFromBitmap( readback, NULL, (ID2D1Bitmap *)target, NULL ))) goto done;
+    if (FAILED(hr = ID2D1Bitmap1_Map( readback, D2D1_MAP_OPTIONS_READ, &mapped ))) goto done;
+#ifdef SG_MUTANT_WIC_IMAGEENC_NOPIXELS
+    memset( mapped.bits, 0, mapped.pitch * size.height );
+#endif
+    hr = BitmapImpl_Create( size.width, size.height, mapped.pitch, mapped.pitch * size.height, NULL, 0, &format,
+                            WICBitmapCacheOnLoad, out );
+    if (SUCCEEDED(hr))
+    {
+        IWICBitmapLock *lock;
+        UINT length;
+        BYTE *data;
+
+        if (SUCCEEDED(hr = IWICBitmap_Lock( *out, NULL, WICBitmapLockWrite, &lock )))
+        {
+            IWICBitmapLock_GetDataPointer( lock, &length, &data );
+            memcpy( data, mapped.bits, min( length, mapped.pitch * size.height ) );
+            IWICBitmapLock_Release( lock );
+            IWICBitmap_SetResolution( *out, props.dpiX, props.dpiY );
+        }
+        else
+        {
+            IWICBitmap_Release( *out );
+            *out = NULL;
+        }
+    }
+    ID2D1Bitmap1_Unmap( readback );
+
+done:
+    if (readback) ID2D1Bitmap1_Release( readback );
+    if (target) ID2D1Bitmap1_Release( target );
+    ID2D1DeviceContext_Release( context );
+    return hr;
+}
+
+static HRESULT WINAPI image_encoder_WriteFrame( IWICImageEncoder *iface, ID2D1Image *image,
+                                                IWICBitmapFrameEncode *frame, const WICImageParameters *params )
+{
+    struct image_encoder *encoder = impl_from_IWICImageEncoder( iface );
+    IWICBitmap *bitmap;
+    double dpi_x, dpi_y;
+    UINT width, height;
+    HRESULT hr;
+
+    TRACE( "%p, %p, %p, %p\n", iface, image, frame, params );
+
+    if (!image || !frame) return E_INVALIDARG;
+    if (FAILED(hr = render_image( encoder, image, params, &bitmap, &dpi_x, &dpi_y ))) return hr;
+    IWICBitmap_GetSize( bitmap, &width, &height );
+    if (SUCCEEDED(hr = IWICBitmapFrameEncode_SetSize( frame, width, height )) &&
+        SUCCEEDED(hr = IWICBitmapFrameEncode_SetResolution( frame, dpi_x, dpi_y )))
+        hr = IWICBitmapFrameEncode_WriteSource( frame, (IWICBitmapSource *)bitmap, NULL );
+    IWICBitmap_Release( bitmap );
+    return hr;
+}
+
+static HRESULT WINAPI image_encoder_WriteFrameThumbnail( IWICImageEncoder *iface, ID2D1Image *image,
+                                                         IWICBitmapFrameEncode *frame, const WICImageParameters *params )
+{
+    struct image_encoder *encoder = impl_from_IWICImageEncoder( iface );
+    IWICBitmap *bitmap;
+    double dpi_x, dpi_y;
+    HRESULT hr;
+
+    TRACE( "%p, %p, %p, %p\n", iface, image, frame, params );
+
+    if (!image || !frame) return E_INVALIDARG;
+    if (FAILED(hr = render_image( encoder, image, params, &bitmap, &dpi_x, &dpi_y ))) return hr;
+    hr = IWICBitmapFrameEncode_SetThumbnail( frame, (IWICBitmapSource *)bitmap );
+    IWICBitmap_Release( bitmap );
+    return hr;
+}
+
+static HRESULT WINAPI image_encoder_WriteThumbnail( IWICImageEncoder *iface, ID2D1Image *image,
+                                                    IWICBitmapEncoder *bitmap_encoder, const WICImageParameters *params )
+{
+    struct image_encoder *encoder = impl_from_IWICImageEncoder( iface );
+    IWICBitmap *bitmap;
+    double dpi_x, dpi_y;
+    HRESULT hr;
+
+    TRACE( "%p, %p, %p, %p\n", iface, image, bitmap_encoder, params );
+
+    if (!image || !bitmap_encoder) return E_INVALIDARG;
+    if (FAILED(hr = render_image( encoder, image, params, &bitmap, &dpi_x, &dpi_y ))) return hr;
+    hr = IWICBitmapEncoder_SetThumbnail( bitmap_encoder, (IWICBitmapSource *)bitmap );
+    IWICBitmap_Release( bitmap );
+    return hr;
+}
+
+static const IWICImageEncoderVtbl image_encoder_vtbl =
+{
+    image_encoder_QueryInterface,
+    image_encoder_AddRef,
+    image_encoder_Release,
+    image_encoder_WriteFrame,
+    image_encoder_WriteFrameThumbnail,
+    image_encoder_WriteThumbnail,
+};
+
+HRESULT ImageEncoder_Create( ID2D1Device *device, IWICImageEncoder **out )
+{
+    struct image_encoder *encoder;
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+    if (!device) return E_INVALIDARG;
+    if (!(encoder = calloc( 1, sizeof(*encoder) ))) return E_OUTOFMEMORY;
+    encoder->IWICImageEncoder_iface.lpVtbl = &image_encoder_vtbl;
+    encoder->ref = 1;
+    encoder->device = device;
+    ID2D1Device_AddRef( device );
+    *out = &encoder->IWICImageEncoder_iface;
+    return S_OK;
+}
diff --git a/dlls/windowscodecs/imgfactory.c b/dlls/windowscodecs/imgfactory.c
