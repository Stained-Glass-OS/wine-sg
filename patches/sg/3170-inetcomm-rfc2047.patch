+
+/* ---- RFC 1522 / RFC 2047 encoded words ---- */
+
+typedef struct
+{
+    const char *start;      /* start of "=?" */
+    const char *end;        /* one past "?=" */
+    char charset[CCHMAX_CSET_NAME];
+    char enc;               /* 'B' or 'Q' */
+    const char *text;
+    int text_len;
+} enc_word;
+
+static int hexval(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* Parse an encoded word at p ("=?charset?enc?text?="). */
+static BOOL parse_enc_word(const char *p, enc_word *w)
+{
+    const char *q, *cs_end;
+    int len;
+
+    if (p[0] != '=' || p[1] != '?') return FALSE;
+    q = p + 2;
+    cs_end = q;
+    while (*cs_end && *cs_end != '?' && *cs_end != '*' && *cs_end != ' ') cs_end++;
+    len = cs_end - q;
+    if (!len || len >= sizeof(w->charset)) return FALSE;
+    memcpy(w->charset, q, len);
+    w->charset[len] = 0;
+    q = cs_end;
+    if (*q == '*')                          /* RFC 2231 language, ignored */
+        while (*q && *q != '?' && *q != ' ') q++;
+    if (*q != '?') return FALSE;
+    q++;
+    if ((q[0] != 'B' && q[0] != 'b' && q[0] != 'Q' && q[0] != 'q') || q[1] != '?') return FALSE;
+    w->enc = q[0] & ~0x20;
+    q += 2;
+    w->text = q;
+    while (*q && *q != '?' && *q != ' ' && *q != '\t' && *q != '\r' && *q != '\n') q++;
+    if (q[0] != '?' || q[1] != '=') return FALSE;
+    w->text_len = q - w->text;
+    w->start = p;
+    w->end = q + 2;
+    return TRUE;
+}
+
+/* Decode the text of an encoded word to a newly allocated buffer. */
+static char *decode_enc_text(const enc_word *w, int *ret_len)
+{
+    char *out = HeapAlloc(GetProcessHeap(), 0, w->text_len + 1);
+    int i, n = 0;
+
+    if (!out) return NULL;
+    if (w->enc == 'Q')
+    {
+        for (i = 0; i < w->text_len; i++)
+        {
+            char c = w->text[i];
+            if (c == '_') out[n++] = ' ';
+            else if (c == '=' && i + 2 < w->text_len &&
+                     hexval(w->text[i + 1]) >= 0 && hexval(w->text[i + 2]) >= 0)
+            {
+                out[n++] = (hexval(w->text[i + 1]) << 4) | hexval(w->text[i + 2]);
+                i += 2;
+            }
+            else out[n++] = c;
+        }
+    }
+    else
+    {
+        DWORD acc = 0;
+        int bits = 0;
+        for (i = 0; i < w->text_len; i++)
+        {
+            char c = w->text[i];
+            int v;
+            if (c >= 'A' && c <= 'Z') v = c - 'A';
+            else if (c >= 'a' && c <= 'z') v = c - 'a' + 26;
+            else if (c >= '0' && c <= '9') v = c - '0' + 52;
+            else if (c == '+') v = 62;
+            else if (c == '/') v = 63;
+            else continue;      /* padding and junk */
+            acc = (acc << 6) | v;
+            bits += 6;
+            if (bits >= 8)
+            {
+                bits -= 8;
+                out[n++] = (acc >> bits) & 0xff;
+            }
+        }
+    }
+    out[n] = 0;
+    *ret_len = n;
+    return out;
+}
+
+static const char b64chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+/* Length in bytes of the multibyte character starting at p */
+static int mb_char_len(UINT cp, const char *p, const char *end)
+{
+    int n = 1;
+    if (cp == CP_UTF8)
+    {
+        unsigned char c = *p;
+        int want = c >= 0xf0 ? 4 : c >= 0xe0 ? 3 : c >= 0xc0 ? 2 : 1;
+        while (n < want && p + n < end && (p[n] & 0xc0) == 0x80) n++;
+    }
+    else if (cp != CP_UTF7 && IsDBCSLeadByteEx(cp, *p) && p + 1 < end) n = 2;
+    return n;
+}
+
+static void append_str(char **buf, int *len, int *cap, const char *s, int n)
+{
+    if (*len + n + 1 > *cap)
+    {
+        *cap = max(*cap * 2, *len + n + 64);
+        *buf = HeapReAlloc(GetProcessHeap(), 0, *buf, *cap);
+    }
+    memcpy(*buf + *len, s, n);
+    *len += n;
+    (*buf)[*len] = 0;
+}
+
+/* Encode bytes as a sequence of encoded words, folded with CRLF SP. The result is
+ * allocated with CoTaskMemAlloc. */
+static char *encode_words(const char *data, int len, UINT cp, const char *charset, BOOL use_b)
+{
+    char *buf = HeapAlloc(GetProcessHeap(), 0, 64), *ret;
+    int blen = 0, cap = 64, pos = 0, first = 1;
+    const int max_word = 75;
+
+    if (!buf) return NULL;
+    buf[0] = 0;
+    while (pos < len)
+    {
+        char word[128];
+        int overhead = strlen(charset) + 7;     /* =? ? ? ?= */
+        int budget = max_word - overhead, n = 0, start = pos;
+        int enc_len = 0;
+        char payload[128];
+
+        if (use_b)
+        {
+            int bytes = 0;
+            while (pos < len)
+            {
+                int cl = mb_char_len(cp, data + pos, data + len);
+                int nb = bytes + cl;
+                if (((nb + 2) / 3) * 4 > budget) break;
+                bytes = nb;
+                pos += cl;
+            }
+            if (!bytes) { pos = start + mb_char_len(cp, data + start, data + len); bytes = pos - start; }
+            for (n = 0; n < bytes; n += 3)
+            {
+                DWORD v = (unsigned char)data[start + n] << 16;
+                if (n + 1 < bytes) v |= (unsigned char)data[start + n + 1] << 8;
+                if (n + 2 < bytes) v |= (unsigned char)data[start + n + 2];
+                payload[enc_len++] = b64chars[(v >> 18) & 63];
+                payload[enc_len++] = b64chars[(v >> 12) & 63];
+                payload[enc_len++] = n + 1 < bytes ? b64chars[(v >> 6) & 63] : '=';
+                payload[enc_len++] = n + 2 < bytes ? b64chars[v & 63] : '=';
+            }
+        }
+        else
+        {
+            while (pos < len)
+            {
+                int cl = mb_char_len(cp, data + pos, data + len), i, add = 0;
+                for (i = 0; i < cl; i++)
+                {
+                    unsigned char c = data[pos + i];
+                    add += (c < 0x80 && (isalnum(c) || strchr("!*+-/ ", c))) ? 1 : 3;
+                }
+                if (enc_len + add > budget && enc_len) break;
+                for (i = 0; i < cl; i++)
+                {
+                    unsigned char c = data[pos + i];
+                    if (c == ' ') payload[enc_len++] = '_';
+                    else if (c < 0x80 && (isalnum(c) || strchr("!*+-/", c))) payload[enc_len++] = c;
+                    else
+                    {
+                        payload[enc_len++] = '=';
+                        payload[enc_len++] = "0123456789ABCDEF"[c >> 4];
+                        payload[enc_len++] = "0123456789ABCDEF"[c & 15];
+                    }
+                }
+                pos += cl;
+            }
+        }
+        #ifndef MUT_NOFOLD
+        if (!first) append_str(&buf, &blen, &cap, "\r\n ", 3);
+#endif
+        first = 0;
+        n = sprintf(word, "=?%s?%c?", charset, use_b ? 'B' : 'Q');
+        append_str(&buf, &blen, &cap, word, n);
+        append_str(&buf, &blen, &cap, payload, enc_len);
+        append_str(&buf, &blen, &cap, "?=", 2);
+    }
+    ret = CoTaskMemAlloc(blen + 1);
+    if (ret) memcpy(ret, buf, blen + 1);
+    HeapFree(GetProcessHeap(), 0, buf);
+    return ret;
+}
+
+static BOOL has_8bit(const char *s, int len)
+{
+    while (len--) if (*s++ & 0x80) return TRUE;
+    return FALSE;
+}
+
+/* Appends the Unicode conversion of bytes to *out */
+static BOOL append_wide(WCHAR **out, int *n, int *cap, UINT cp, const char *s, int len)
+{
+    int need = MultiByteToWideChar(cp, 0, s, len, NULL, 0);
+    if (len && !need) return FALSE;
+    if (*n + need + 1 > *cap)
+    {
+        WCHAR *p;
+        *cap = max(*cap * 2, *n + need + 64);
+        p = HeapReAlloc(GetProcessHeap(), 0, *out, *cap * sizeof(WCHAR));
+        if (!p) return FALSE;
+        *out = p;
+    }
+    MultiByteToWideChar(cp, 0, s, len, *out + *n, need);
+    *n += need;
+    (*out)[*n] = 0;
+    return TRUE;
+}
