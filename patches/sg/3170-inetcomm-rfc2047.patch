+static inline UINT windows_cp(const INETCSETINFO *info)
+{
+    /* Unicode charsets (utf-8) report 1200 as the Windows code page: use the ANSI one for narrow strings */
+    return (!info->cpiWindows || info->cpiWindows == CP_UNICODE) ? CP_ACP : info->cpiWindows;
+}
+
+static HRESULT get_header_charset_info(IMimeInternational *iface, HCHARSET hCharset, INETCSETINFO *info)
+{
+    HRESULT hr;
+
+    if (!hCharset)
+    {
+        hr = IMimeInternational_GetDefaultCharset(iface, &hCharset);
+        if (FAILED(hr)) return E_FAIL;
+    }
+    hr = IMimeInternational_GetCharsetInfo(iface, hCharset, info);
+    return hr;
+}
+
 static HRESULT WINAPI MimeInternat_DecodeHeader(IMimeInternational *iface, HCHARSET hCharset,
                                                 LPCSTR pszData,
                                                 LPPROPVARIANT pDecoded,
                                                 LPRFC1522INFO pRfc1522Info)
 {
-    FIXME("stub\n");
-    return E_NOTIMPL;
+    INETCSETINFO base, wordcs;
+    BOOL have_base = FALSE, convert_failed = FALSE, prev_word = FALSE, first_word = TRUE;
+    const char *p, *lit;
+    WCHAR *wide;
+    int wlen = 0, wcap = 64;
+    UINT target_cp = CP_ACP;
+    HCHARSET first_cs = NULL;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p, %s, %p, %p)\n", iface, hCharset, debugstr_a(pszData), pDecoded, pRfc1522Info);
+
+    if (!pszData || !pDecoded || (pDecoded->vt != VT_LPSTR && pDecoded->vt != VT_LPWSTR))
+        return E_INVALIDARG;
+
+    if (hCharset)
+    {
+        hr = IMimeInternational_GetCharsetInfo(iface, hCharset, &base);
+        if (FAILED(hr)) return MIME_E_INVALID_HANDLE;
+        have_base = TRUE;
+    }
+
+    if (pRfc1522Info)
+    {
+        pRfc1522Info->fRfc1522Used = FALSE;
+        pRfc1522Info->hRfc1522Cset = NULL;
+    }
+
+    wide = HeapAlloc(GetProcessHeap(), 0, wcap * sizeof(WCHAR));
+    if (!wide) return E_OUTOFMEMORY;
+    wide[0] = 0;
+
+    for (p = lit = pszData; ; )
+    {
+        enc_word w;
+        BOOL is_word = (p[0] == '=' && p[1] == '?' && parse_enc_word(p, &w));
+
+        if (!is_word && *p)
+        {
+            p++;
+            continue;
+        }
+
+        /* literal run lit..p */
+        if (p > lit)
+        {
+            const char *q;
+            BOOL all_space = TRUE;
+            for (q = lit; q < p; q++) if (*q != ' ' && *q != '\t' && *q != '\r' && *q != '\n') all_space = FALSE;
+            /* whitespace between two encoded words is dropped */
+            if (!(prev_word && all_space && is_word))
+            {
+                UINT cp = CP_ACP;
+                if (!have_base && !hCharset)
+                {
+                    if (SUCCEEDED(get_header_charset_info(iface, NULL, &base))) have_base = TRUE;
+                }
+                if (have_base) cp = base.cpiInternet ? base.cpiInternet : base.cpiWindows;
+                if (!append_wide(&wide, &wlen, &wcap, cp, lit, p - lit)) convert_failed = TRUE;
+            }
+        }
+        if (!is_word) break;
+
+        {
+            char *raw;
+            int raw_len;
+            UINT cp;
+            HCHARSET hcs = NULL;
+
+            raw = decode_enc_text(&w, &raw_len);
+            if (!raw) { HeapFree(GetProcessHeap(), 0, wide); return E_OUTOFMEMORY; }
+
+            if (SUCCEEDED(IMimeInternational_FindCharset(iface, w.charset, &hcs)) &&
+                SUCCEEDED(IMimeInternational_GetCharsetInfo(iface, hcs, &wordcs)))
+            {
+                cp = wordcs.cpiInternet ? wordcs.cpiInternet : wordcs.cpiWindows;
+                if (pRfc1522Info && first_word) first_cs = hcs;
+            }
+            else
+            {
+                cp = CP_ACP;
+                convert_failed = TRUE;
+                hcs = NULL;
+            }
+#ifndef MUT_NOOVERRIDE
+            if (hCharset) cp = base.cpiInternet ? base.cpiInternet : base.cpiWindows;
+#endif
+            if (first_word && !hCharset && hcs) { base = wordcs; have_base = TRUE; }
+            if (!append_wide(&wide, &wlen, &wcap, cp, raw, raw_len)) convert_failed = TRUE;
+            HeapFree(GetProcessHeap(), 0, raw);
+            first_word = FALSE;
+        }
+        prev_word = TRUE;
+        p = lit = w.end;
+        /* literal text after a word starts at lit */
+        if (!*p) break;
+        {
+            /* continue scanning; remember prev_word until a non-space literal is seen */
+            const char *q = p;
+            enc_word w2;
+            while (*q == ' ' || *q == '\t' || *q == '\r' || *q == '\n') q++;
+            if (!(q[0] == '=' && q[1] == '?' && parse_enc_word(q, &w2))) prev_word = FALSE;
+        }
+    }
+
+    if (have_base) target_cp = windows_cp(&base);
+
+    if (pDecoded->vt == VT_LPWSTR)
+    {
+        pDecoded->pwszVal = CoTaskMemAlloc((wlen + 1) * sizeof(WCHAR));
+        if (!pDecoded->pwszVal) { HeapFree(GetProcessHeap(), 0, wide); return E_OUTOFMEMORY; }
+        memcpy(pDecoded->pwszVal, wide, (wlen + 1) * sizeof(WCHAR));
+    }
+    else
+    {
+        int n = WideCharToMultiByte(target_cp, 0, wide, wlen + 1, NULL, 0, NULL, NULL);
+        pDecoded->pszVal = CoTaskMemAlloc(n ? n : 1);
+        if (!pDecoded->pszVal) { HeapFree(GetProcessHeap(), 0, wide); return E_OUTOFMEMORY; }
+        if (n) WideCharToMultiByte(target_cp, 0, wide, wlen + 1, pDecoded->pszVal, n, NULL, NULL);
+        else pDecoded->pszVal[0] = 0;
+    }
+    HeapFree(GetProcessHeap(), 0, wide);
+
+    if (pRfc1522Info && first_cs)
+    {
+        pRfc1522Info->fRfc1522Used = TRUE;
+        pRfc1522Info->hRfc1522Cset = first_cs;
+    }
+    /* MIME_S_NO_CHARSET_CONVERT has no value we can verify; report a plain success code */
+    return convert_failed ? S_FALSE : S_OK;
 }
 
