From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: custom effects' compute transforms are told their compute info and dispatched

An ID2D1ComputeTransform was never given its ID2D1ComputeInfo
(SetComputeInfo was not called) and nothing ran its shader: Paint.NET 5.2's
Auto-Level failed with "Unexpected null". As Direct2D does: the render info
object is also the transform's ID2D1ComputeInfo (compute shader, constant
buffer, resource textures, input descriptions); drawing the node asks
CalculateThreadgroups for its output rectangle and dispatches the shader with
Direct2D's system constants at b0 (resultRect, outputOffset, sceneToInputNX/Y
per input, as d2d1effecthelpers.hlsli declares them), the effect's constants
at b1, its inputs at t0../s0.., resource textures at their registers and the
output, a 16-bit float texture, at u0.
---
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -869,11 +869,13 @@
 enum d2d_render_info_mask
 {
     D2D_RENDER_INFO_PIXEL_SHADER = 0x1,
+    D2D_RENDER_INFO_COMPUTE_SHADER = 0x2,      /* wine-sg 9204 */
 };
 
 struct d2d_render_info
 {
     ID2D1DrawInfo ID2D1DrawInfo_iface;
+    ID2D1ComputeInfo ID2D1ComputeInfo_iface;   /* wine-sg 9204: what a compute transform is told */
     LONG refcount;
 
     unsigned int mask;
@@ -883,8 +885,9 @@
     D2D1_CHANNEL_DEPTH output_depth;
     BOOL cached;
     UINT32 instruction_count_hint;
-    BYTE *ps_constants, *vs_constants;
-    UINT32 ps_constants_size, vs_constants_size;
+    BYTE *ps_constants, *vs_constants, *cs_constants;
+    UINT32 ps_constants_size, vs_constants_size, cs_constants_size;
+    GUID compute_shader;
     D2D1_INPUT_DESCRIPTION *input_descs;
     UINT32 input_desc_count;
     ID2D1ResourceTexture **textures;
--- a/dlls/d2d1/effect.c
+++ b/dlls/d2d1/effect.c
@@ -3045,6 +3045,11 @@
     return CONTAINING_RECORD(iface, struct d2d_render_info, ID2D1DrawInfo_iface);
 }
 
+static ID2D1DrawInfo *draw_info_from_ID2D1ComputeInfo(ID2D1ComputeInfo *iface)
+{
+    return &CONTAINING_RECORD(iface, struct d2d_render_info, ID2D1ComputeInfo_iface)->ID2D1DrawInfo_iface;
+}
+
 static HRESULT STDMETHODCALLTYPE d2d_draw_info_QueryInterface(ID2D1DrawInfo *iface, REFIID iid,
         void **obj)
 {
@@ -3058,6 +3063,15 @@
         ID2D1DrawInfo_AddRef(iface);
         return S_OK;
     }
+#ifndef SG_MUTANT_D2D_NO_COMPUTE
+    if (IsEqualGUID(iid, &IID_ID2D1ComputeInfo))
+    {
+        struct d2d_render_info *render_info = impl_from_ID2D1DrawInfo(iface);
+        *obj = &render_info->ID2D1ComputeInfo_iface;
+        ID2D1DrawInfo_AddRef(iface);
+        return S_OK;
+    }
+#endif
 
     WARN("Unsupported interface %s.\n", debugstr_guid(iid));
 
@@ -3096,6 +3110,7 @@
         free(render_info->input_descs);
         free(render_info->ps_constants);
         free(render_info->vs_constants);
+        free(render_info->cs_constants);
         free(render_info);
     }
 
@@ -3250,6 +3265,100 @@
     return E_NOTIMPL;
 }
 
+/* wine-sg 9204: ID2D1ComputeInfo, the same object as the draw info: what a compute transform says
+ * (its shader, its constants, its resource textures) is kept for dispatching it */
+static HRESULT STDMETHODCALLTYPE d2d_compute_info_QueryInterface(ID2D1ComputeInfo *iface, REFIID iid, void **obj)
+{
+    ID2D1DrawInfo *draw = draw_info_from_ID2D1ComputeInfo(iface);
+
+    TRACE("iface %p, iid %s, obj %p.\n", iface, debugstr_guid(iid), obj);
+
+    if (IsEqualGUID(iid, &IID_ID2D1ComputeInfo)
+            || IsEqualGUID(iid, &IID_ID2D1RenderInfo)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        *obj = iface;
+        ID2D1DrawInfo_AddRef(draw);
+        return S_OK;
+    }
+    WARN("Unsupported interface %s.\n", debugstr_guid(iid));
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_compute_info_AddRef(ID2D1ComputeInfo *iface)
+{
+    return ID2D1DrawInfo_AddRef(draw_info_from_ID2D1ComputeInfo(iface));
+}
+
+static ULONG STDMETHODCALLTYPE d2d_compute_info_Release(ID2D1ComputeInfo *iface)
+{
+    return ID2D1DrawInfo_Release(draw_info_from_ID2D1ComputeInfo(iface));
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_compute_info_SetInputDescription(ID2D1ComputeInfo *iface,
+        UINT32 index, D2D1_INPUT_DESCRIPTION description)
+{
+    return ID2D1DrawInfo_SetInputDescription(draw_info_from_ID2D1ComputeInfo(iface), index, description);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_compute_info_SetOutputBuffer(ID2D1ComputeInfo *iface,
+        D2D1_BUFFER_PRECISION precision, D2D1_CHANNEL_DEPTH depth)
+{
+    return ID2D1DrawInfo_SetOutputBuffer(draw_info_from_ID2D1ComputeInfo(iface), precision, depth);
+}
+
+static void STDMETHODCALLTYPE d2d_compute_info_SetCached(ID2D1ComputeInfo *iface, BOOL is_cached)
+{
+    ID2D1DrawInfo_SetCached(draw_info_from_ID2D1ComputeInfo(iface), is_cached);
+}
+
+static void STDMETHODCALLTYPE d2d_compute_info_SetInstructionCountHint(ID2D1ComputeInfo *iface, UINT32 count)
+{
+    ID2D1DrawInfo_SetInstructionCountHint(draw_info_from_ID2D1ComputeInfo(iface), count);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_compute_info_SetComputeShaderConstantBuffer(ID2D1ComputeInfo *iface,
+        const BYTE *buffer, UINT32 size)
+{
+    struct d2d_render_info *render_info = impl_from_ID2D1DrawInfo(draw_info_from_ID2D1ComputeInfo(iface));
+
+    TRACE("iface %p, buffer %p, size %u.\n", iface, buffer, size);
+
+    return d2d_render_info_set_constants(&render_info->cs_constants, &render_info->cs_constants_size, buffer, size);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_compute_info_SetComputeShader(ID2D1ComputeInfo *iface, REFGUID id)
+{
+    struct d2d_render_info *render_info = impl_from_ID2D1DrawInfo(draw_info_from_ID2D1ComputeInfo(iface));
+
+    TRACE("iface %p, id %s.\n", iface, debugstr_guid(id));
+
+    render_info->mask |= D2D_RENDER_INFO_COMPUTE_SHADER;
+    render_info->compute_shader = *id;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_compute_info_SetResourceTexture(ID2D1ComputeInfo *iface,
+        UINT32 index, ID2D1ResourceTexture *texture)
+{
+    return ID2D1DrawInfo_SetResourceTexture(draw_info_from_ID2D1ComputeInfo(iface), index, texture);
+}
+
+static const ID2D1ComputeInfoVtbl d2d_compute_info_vtbl =
+{
+    d2d_compute_info_QueryInterface,
+    d2d_compute_info_AddRef,
+    d2d_compute_info_Release,
+    d2d_compute_info_SetInputDescription,
+    d2d_compute_info_SetOutputBuffer,
+    d2d_compute_info_SetCached,
+    d2d_compute_info_SetInstructionCountHint,
+    d2d_compute_info_SetComputeShaderConstantBuffer,
+    d2d_compute_info_SetComputeShader,
+    d2d_compute_info_SetResourceTexture,
+};
+
 static const ID2D1DrawInfoVtbl d2d_draw_info_vtbl =
 {
     d2d_draw_info_QueryInterface,
@@ -3274,6 +3383,7 @@
         return E_OUTOFMEMORY;
 
     object->ID2D1DrawInfo_iface.lpVtbl = &d2d_draw_info_vtbl;
+    object->ID2D1ComputeInfo_iface.lpVtbl = &d2d_compute_info_vtbl;
     object->refcount = 1;
 
     *obj = object;
@@ -3306,6 +3416,7 @@
 
 static HRESULT d2d_transform_node_initialize(struct d2d_transform_node *node)
 {
+    ID2D1ComputeTransform *compute_transform;
     ID2D1DrawTransform *draw_transform;
     HRESULT hr;
 
@@ -3328,6 +3439,19 @@
             return hr;
         }
     }
+#ifndef SG_MUTANT_D2D_NO_COMPUTE
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1ComputeTransform,
+            (void **)&compute_transform)))
+    {
+        hr = ID2D1ComputeTransform_SetComputeInfo(compute_transform, &node->render_info->ID2D1ComputeInfo_iface);
+        ID2D1ComputeTransform_Release(compute_transform);
+        if (FAILED(hr))
+        {
+            WARN("Failed to set compute info, hr %#lx.\n", hr);
+            return hr;
+        }
+    }
+#endif
     /* Blend, border, offset and bounds adjustment transforms and nodes
      * made from effects have nothing to be told before drawing. */
     node->initialized = TRUE;
--- a/dlls/d2d1/effect_render.c
+++ b/dlls/d2d1/effect_render.c
@@ -1023,6 +1023,170 @@
     return hr;
 }
 
+#ifndef SG_MUTANT_D2D_NO_COMPUTE
+/* wine-sg 9204: a compute transform's pass. As Direct2D does: the transform says how many thread groups
+ * the output rectangle takes (CalculateThreadgroups); its shader reads its inputs at t0.., samplers
+ * s0.., Direct2D's constants at b0 and its own at b1 (SetComputeShaderConstantBuffer), and writes
+ * RWTexture2D u0. Direct2D's constants (d2d1effecthelpers.hlsli): int4 resultRect (the output rectangle,
+ * scene pixels), int2 outputOffset (added with resultRect.xy to a thread's id to address the output
+ * texture: here the texture is the rectangle, so -resultRect.xy), then per input float2 sceneToInputNX,
+ * sceneToInputNY (texel = scene * [0] + [1], normalised). */
+static HRESULT fx_dispatch(struct fx_renderer *r, ID2D1ComputeTransform *transform, const struct d2d_render_info *info,
+        const D2D1_RECT_L *rect, const struct fx_pass_input *inputs, unsigned int input_count, struct fx_texture *out)
+{
+    struct fx_cs_constants
+    {
+        INT result_rect[4];
+        INT output_offset[2];
+        float scene_to_input[16][2][2];
+        float pad[2];
+    } constants;
+    ID3D11ShaderResourceView *srvs[16] = { 0 }, *res_srvs[16] = { 0 };
+    ID3D11SamplerState *samplers[16] = { 0 };
+    ID3D11UnorderedAccessView *uav = NULL, *no_uav = NULL;
+    ID3D11Buffer *cbs[2] = { 0 };
+    ID3D11ComputeShader *cs = NULL;
+    D3D11_SAMPLER_DESC sampler_desc;
+    D3D11_BUFFER_DESC buffer_desc;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_SUBRESOURCE_DATA data;
+    UINT32 gx = 0, gy = 0, gz = 0;
+    unsigned int i;
+    HRESULT hr;
+
+    memset(out, 0, sizeof(*out));
+    input_count = min(input_count, 16);
+    if (!d2d_device_get_indexed_object(&r->context->device->shaders, &info->compute_shader, (IUnknown **)&cs))
+    {
+        WARN("Compute shader %s was not loaded.\n", debugstr_guid(&info->compute_shader));
+        return D2DERR_SHADER_COMPILE_FAILED;
+    }
+    if (FAILED(hr = ID2D1ComputeTransform_CalculateThreadgroups(transform, rect, &gx, &gy, &gz)))
+    {
+        WARN("CalculateThreadgroups failed, hr %#lx.\n", hr);
+        goto done;
+    }
+
+    desc.Width = rect->right - rect->left;
+    desc.Height = rect->bottom - rect->top;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+    desc.SampleDesc.Count = 1;
+    desc.SampleDesc.Quality = 0;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS;
+    desc.CPUAccessFlags = 0;
+    desc.MiscFlags = 0;
+    if (FAILED(hr = ID3D11Device1_CreateTexture2D(r->device, &desc, NULL, &out->texture))
+            || FAILED(hr = ID3D11Device1_CreateShaderResourceView(r->device, (ID3D11Resource *)out->texture, NULL, &out->srv))
+            || FAILED(hr = ID3D11Device1_CreateUnorderedAccessView(r->device, (ID3D11Resource *)out->texture, NULL, &uav)))
+        goto done;
+    out->rect = *rect;
+    {
+        static const float transparent[4];
+        ID3D11DeviceContext1_ClearUnorderedAccessViewFloat(r->dc, uav, transparent);
+    }
+
+    memset(&constants, 0, sizeof(constants));
+    constants.result_rect[0] = rect->left;
+    constants.result_rect[1] = rect->top;
+    constants.result_rect[2] = rect->right;
+    constants.result_rect[3] = rect->bottom;
+    constants.output_offset[0] = -rect->left;
+    constants.output_offset[1] = -rect->top;
+    for (i = 0; i < input_count; ++i)
+    {
+        const struct fx_texture *t = inputs[i].texture;
+        float w, h;
+
+        if (!t || !t->srv)
+            continue;
+        w = t->rect.right - t->rect.left;
+        h = t->rect.bottom - t->rect.top;
+        constants.scene_to_input[i][0][0] = 1.0f / w;
+        constants.scene_to_input[i][0][1] = -t->rect.left / w;
+        constants.scene_to_input[i][1][0] = 1.0f / h;
+        constants.scene_to_input[i][1][1] = -t->rect.top / h;
+        srvs[i] = t->srv;
+
+        memset(&sampler_desc, 0, sizeof(sampler_desc));
+        sampler_desc.Filter = inputs[i].filter;
+        sampler_desc.AddressU = sampler_desc.AddressV = sampler_desc.AddressW = D3D11_TEXTURE_ADDRESS_BORDER;
+        sampler_desc.MaxAnisotropy = 1;
+        sampler_desc.ComparisonFunc = D3D11_COMPARISON_NEVER;
+        sampler_desc.MaxLOD = D3D11_FLOAT32_MAX;
+        if (FAILED(hr = ID3D11Device1_CreateSamplerState(r->device, &sampler_desc, &samplers[i])))
+            goto done;
+    }
+    for (i = 0; i < min(info->texture_count, 16); ++i)
+    {
+        if (!info->textures[i] || srvs[i])
+            continue;
+        if (FAILED(hr = d2d_resource_texture_bind(info->textures[i], r->device, &res_srvs[i], &samplers[i])))
+            goto done;
+        srvs[i] = res_srvs[i];
+    }
+
+    buffer_desc.ByteWidth = FIELD_OFFSET(struct fx_cs_constants, scene_to_input[max(input_count, 1)]);
+    buffer_desc.ByteWidth = (buffer_desc.ByteWidth + 15) & ~15u;
+    buffer_desc.Usage = D3D11_USAGE_DEFAULT;
+    buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    buffer_desc.CPUAccessFlags = 0;
+    buffer_desc.MiscFlags = 0;
+    buffer_desc.StructureByteStride = 0;
+    data.pSysMem = &constants;
+    data.SysMemPitch = data.SysMemSlicePitch = 0;
+    if (FAILED(hr = ID3D11Device1_CreateBuffer(r->device, &buffer_desc, &data, &cbs[0])))
+        goto done;
+    if (info->cs_constants_size)
+    {
+        void *padded;
+
+        buffer_desc.ByteWidth = (info->cs_constants_size + 15) & ~15u;
+        if (!(padded = calloc(1, buffer_desc.ByteWidth)))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+        memcpy(padded, info->cs_constants, info->cs_constants_size);
+        data.pSysMem = padded;
+        hr = ID3D11Device1_CreateBuffer(r->device, &buffer_desc, &data, &cbs[1]);
+        free(padded);
+        if (FAILED(hr))
+            goto done;
+    }
+
+    ID3D11DeviceContext1_CSSetShader(r->dc, cs, NULL, 0);
+    ID3D11DeviceContext1_CSSetConstantBuffers(r->dc, 0, 2, cbs);
+    ID3D11DeviceContext1_CSSetShaderResources(r->dc, 0, 16, srvs);
+    ID3D11DeviceContext1_CSSetSamplers(r->dc, 0, 16, samplers);
+    ID3D11DeviceContext1_CSSetUnorderedAccessViews(r->dc, 0, 1, &uav, NULL);
+    if (gx && gy && gz)
+        ID3D11DeviceContext1_Dispatch(r->dc, gx, gy, gz);
+
+    /* let go of the inputs and the output */
+    memset(srvs, 0, sizeof(srvs));
+    ID3D11DeviceContext1_CSSetShaderResources(r->dc, 0, 16, srvs);
+    ID3D11DeviceContext1_CSSetUnorderedAccessViews(r->dc, 0, 1, &no_uav, NULL);
+    ID3D11DeviceContext1_CSSetShader(r->dc, NULL, NULL, 0);
+    hr = S_OK;
+
+done:
+    for (i = 0; i < ARRAY_SIZE(samplers); ++i)
+        if (samplers[i]) ID3D11SamplerState_Release(samplers[i]);
+    for (i = 0; i < ARRAY_SIZE(res_srvs); ++i)
+        if (res_srvs[i]) ID3D11ShaderResourceView_Release(res_srvs[i]);
+    for (i = 0; i < ARRAY_SIZE(cbs); ++i)
+        if (cbs[i]) ID3D11Buffer_Release(cbs[i]);
+    if (uav) ID3D11UnorderedAccessView_Release(uav);
+    if (cs) ID3D11ComputeShader_Release(cs);
+    if (FAILED(hr))
+        fx_texture_release(out);
+    return hr;
+}
+#endif
+
 /* The built-in effects' shader: one, with a mode. Its inputs are those of a
  * Direct2D pixel shader, so the same vertex shader making feeds it. */
 static const char fx_builtin_ps[] =
@@ -1895,6 +2059,7 @@
     D2D1_RECT_L stack_rects[8], *rects = stack_rects, *effect_rects = NULL, bounds, rect;
     struct fx_texture stack_textures[8], *textures = stack_textures;
     ID2D1OffsetTransform *offset_transform;
+    ID2D1ComputeTransform *compute;
     ID2D1DrawTransform *draw;
     struct d2d_effect *nested;
     unsigned int i, n = node->input_count;
@@ -1967,6 +2132,32 @@
         ID3D11PixelShader_Release(ps);
         ID3D11VertexShader_Release(vs);
     }
+#ifndef SG_MUTANT_D2D_NO_COMPUTE
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1ComputeTransform, (void **)&compute)))
+    {
+        struct fx_pass_input pass_inputs[16];
+        struct d2d_render_info *info = node->render_info;
+
+        if (n)
+            hr = ID2D1ComputeTransform_MapOutputRectToInputRects(compute, &rect, rects, n);
+        if (FAILED(hr))
+            WARN("MapOutputRectToInputRects failed, hr %#lx.\n", hr);
+        for (i = 0; i < n && SUCCEEDED(hr); ++i)
+            hr = fx_render_node_input(r, effect, node, i, effect_inputs, &rects[i], &textures[i]);
+        if (SUCCEEDED(hr) && (!info || !(info->mask & D2D_RENDER_INFO_COMPUTE_SHADER)))
+            FIXME("Compute transform %p has no compute shader.\n", node->object);
+        else if (SUCCEEDED(hr))
+        {
+            for (i = 0; i < min(n, 16); ++i)
+            {
+                pass_inputs[i].texture = &textures[i];
+                pass_inputs[i].filter = fx_filter(info, i);
+            }
+            hr = fx_dispatch(r, compute, info, &rect, pass_inputs, min(n, 16), out);
+        }
+        ID2D1ComputeTransform_Release(compute);
+    }
+#endif
     else if ((nested = d2d_effect_from_transform_node(node->object)))
     {
         /* an effect as a node: its inputs are this node's, drawn as far as it may read */
