+/******************************************************************
+ *		dump_handle_data
+ *
+ * Stained Glass OS: the process's handles (MiniDumpWithHandleData): their
+ * values, types, names, attributes, access and counts.
+ */
+static unsigned dump_handle_data(struct dump_context* dc)
+{
+    SYSTEM_HANDLE_INFORMATION_EX*   info = NULL;
+    MINIDUMP_HANDLE_DATA_STREAM     hdr;
+    MINIDUMP_HANDLE_DESCRIPTOR      desc;
+    ULONG                           size = 0x10000, i, count = 0;
+    RVA                             rva_base;
+    NTSTATUS                        status;
+    char                            buf[1024];
+
+    for (;;)
+    {
+        if (!(info = HeapAlloc(GetProcessHeap(), 0, size))) return 0;
+        status = NtQuerySystemInformation(SystemExtendedHandleInformation, info, size, &size);
+        if (status != STATUS_INFO_LENGTH_MISMATCH) break;
+        HeapFree(GetProcessHeap(), 0, info);
+        size += 0x10000;
+    }
+    if (status)
+    {
+        HeapFree(GetProcessHeap(), 0, info);
+        info = NULL;
+    }
+    if (info)
+        for (i = 0; i < info->NumberOfHandles; i++)
+            if (info->Handles[i].UniqueProcessId == dc->pid) count++;
+
+    hdr.SizeOfHeader = sizeof(hdr);
+    hdr.SizeOfDescriptor = sizeof(desc);
+    hdr.NumberOfDescriptors = 0;
+    hdr.Reserved = 0;
+    rva_base = dc->rva;
+    dc->rva += sizeof(hdr) + count * sizeof(desc);
+
+    for (i = 0; info && i < info->NumberOfHandles && hdr.NumberOfDescriptors < count; i++)
+    {
+        SYSTEM_HANDLE_TABLE_ENTRY_INFO_EX *h = info->Handles + i;
+        OBJECT_TYPE_INFORMATION *type = (OBJECT_TYPE_INFORMATION *)buf;
+        OBJECT_NAME_INFORMATION *name = (OBJECT_NAME_INFORMATION *)buf;
+        OBJECT_BASIC_INFORMATION basic;
+        MINIDUMP_STRING *ms;
+        HANDLE dup = NULL;
+        ULONG len;
+
+        if (h->UniqueProcessId != dc->pid) continue;
+        memset(&desc, 0, sizeof(desc));
+        desc.Handle = h->HandleValue;
+        desc.Attributes = h->HandleAttributes;
+        desc.GrantedAccess = h->GrantedAccess;
+        if (DuplicateHandle(dc->process->handle, (HANDLE)h->HandleValue, GetCurrentProcess(), &dup, 0, FALSE,
+                            DUPLICATE_SAME_ACCESS))
+        {
+            if (!NtQueryObject(dup, ObjectBasicInformation, &basic, sizeof(basic), NULL))
+            {
+                desc.HandleCount = basic.HandleCount ? basic.HandleCount - 1 : 0;  /* not counting ours */
+                desc.PointerCount = basic.PointerCount;
+            }
+            if (!NtQueryObject(dup, ObjectTypeInformation, buf, sizeof(buf) - sizeof(WCHAR), &len) &&
+                type->TypeName.Length)
+            {
+                ms = HeapAlloc(GetProcessHeap(), 0, sizeof(ULONG) + type->TypeName.Length + sizeof(WCHAR));
+                if (ms)
+                {
+                    ms->Length = type->TypeName.Length;
+                    memcpy(ms->Buffer, type->TypeName.Buffer, type->TypeName.Length);
+                    ms->Buffer[type->TypeName.Length / sizeof(WCHAR)] = 0;
+                    desc.TypeNameRva = dc->rva;
+                    append(dc, ms, sizeof(ULONG) + ms->Length + sizeof(WCHAR));
+                    HeapFree(GetProcessHeap(), 0, ms);
+                }
+            }
+            if (!NtQueryObject(dup, ObjectNameInformation, buf, sizeof(buf) - sizeof(WCHAR), &len) &&
+                name->Name.Length)
+            {
+                ms = HeapAlloc(GetProcessHeap(), 0, sizeof(ULONG) + name->Name.Length + sizeof(WCHAR));
+                if (ms)
+                {
+                    ms->Length = name->Name.Length;
+                    memcpy(ms->Buffer, name->Name.Buffer, name->Name.Length);
+                    ms->Buffer[name->Name.Length / sizeof(WCHAR)] = 0;
+                    desc.ObjectNameRva = dc->rva;
+                    append(dc, ms, sizeof(ULONG) + ms->Length + sizeof(WCHAR));
+                    HeapFree(GetProcessHeap(), 0, ms);
+                }
+            }
+            CloseHandle(dup);
+        }
+        writeat(dc, rva_base + sizeof(hdr) + hdr.NumberOfDescriptors++ * sizeof(desc), &desc, sizeof(desc));
+    }
+    writeat(dc, rva_base, &hdr, sizeof(hdr));
+    HeapFree(GetProcessHeap(), 0, info);
+    return sizeof(hdr) + hdr.NumberOfDescriptors * sizeof(desc);
+}
+
 /******************************************************************
  *		dump_memory64_info
  *
