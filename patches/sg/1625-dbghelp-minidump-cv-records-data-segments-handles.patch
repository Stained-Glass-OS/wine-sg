+/* Stained Glass OS: a module's PE layout, read from the process, whatever
+ * its bitness: its debug directory and its sections */
+struct pe_layout
+{
+    IMAGE_DATA_DIRECTORY debug_dir;
+    ULONG64              sections;  /* address of the section table */
+    unsigned             num_sections;
+};
+
+static BOOL read_pe_layout(struct dump_context* dc, ULONG64 base, struct pe_layout* pe)
+{
+    IMAGE_DOS_HEADER    dos;
+    IMAGE_FILE_HEADER   fh;
+    ULONG64             nt;
+    WORD                magic;
+    ULONG64             dirs;
+    DWORD               num_dirs;
+
+    memset(pe, 0, sizeof(*pe));
+    if (!read_process_memory(dc->process, base, &dos, sizeof(dos)) || dos.e_magic != IMAGE_DOS_SIGNATURE)
+        return FALSE;
+    nt = base + dos.e_lfanew;
+    if (!read_process_memory(dc->process, nt + sizeof(DWORD), &fh, sizeof(fh)) ||
+        !read_process_memory(dc->process, nt + sizeof(DWORD) + sizeof(fh), &magic, sizeof(magic)))
+        return FALSE;
+    if (magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC)
+    {
+        dirs = nt + sizeof(DWORD) + sizeof(fh) + FIELD_OFFSET(IMAGE_OPTIONAL_HEADER64, DataDirectory);
+        if (!read_process_memory(dc->process, nt + sizeof(DWORD) + sizeof(fh) +
+                                 FIELD_OFFSET(IMAGE_OPTIONAL_HEADER64, NumberOfRvaAndSizes), &num_dirs, sizeof(num_dirs)))
+            return FALSE;
+    }
+    else if (magic == IMAGE_NT_OPTIONAL_HDR32_MAGIC)
+    {
+        dirs = nt + sizeof(DWORD) + sizeof(fh) + FIELD_OFFSET(IMAGE_OPTIONAL_HEADER32, DataDirectory);
+        if (!read_process_memory(dc->process, nt + sizeof(DWORD) + sizeof(fh) +
+                                 FIELD_OFFSET(IMAGE_OPTIONAL_HEADER32, NumberOfRvaAndSizes), &num_dirs, sizeof(num_dirs)))
+            return FALSE;
+    }
+    else return FALSE;
+    if (num_dirs > IMAGE_DIRECTORY_ENTRY_DEBUG)
+        read_process_memory(dc->process, dirs + IMAGE_DIRECTORY_ENTRY_DEBUG * sizeof(IMAGE_DATA_DIRECTORY),
+                            &pe->debug_dir, sizeof(pe->debug_dir));
+    pe->sections = nt + sizeof(DWORD) + sizeof(fh) + fh.SizeOfOptionalHeader;
+    pe->num_sections = fh.NumberOfSections;
+    return TRUE;
+}
+
+/* the module's CodeView record (the PDB it was linked with), appended to
+ * the dump */
+static void dump_module_cv_record(struct dump_context* dc, ULONG64 base, MINIDUMP_LOCATION_DESCRIPTOR* loc)
+{
+    IMAGE_DEBUG_DIRECTORY   dbg;
+    struct pe_layout        pe;
+    unsigned                i;
+    char*                   data;
+
+    loc->DataSize = loc->Rva = 0;
+#ifndef SG_MUTANT_NO_CV_RECORD
+    if (!read_pe_layout(dc, base, &pe) || !pe.debug_dir.VirtualAddress) return;
+    for (i = 0; i < pe.debug_dir.Size / sizeof(dbg) && i < 32; i++)
+    {
+        if (!read_process_memory(dc->process, base + pe.debug_dir.VirtualAddress + i * sizeof(dbg), &dbg, sizeof(dbg)))
+            return;
+        if (dbg.Type != IMAGE_DEBUG_TYPE_CODEVIEW || !dbg.AddressOfRawData || !dbg.SizeOfData ||
+            dbg.SizeOfData > 0x10000)
+            continue;
+        if (!(data = HeapAlloc(GetProcessHeap(), 0, dbg.SizeOfData))) return;
+        if (read_process_memory(dc->process, base + dbg.AddressOfRawData, data, dbg.SizeOfData))
+        {
+            loc->Rva = dc->rva;
+            loc->DataSize = dbg.SizeOfData;
+            append(dc, data, dbg.SizeOfData);
+        }
+        HeapFree(GetProcessHeap(), 0, data);
+        return;
+    }
+#endif
+}
+
+/* the module's writable data sections, to the memory list */
+static void add_module_data_segments(struct dump_context* dc, ULONG64 base)
+{
+    IMAGE_SECTION_HEADER    sec;
+    struct pe_layout        pe;
+    unsigned                i;
+
+    if (!read_pe_layout(dc, base, &pe)) return;
+    for (i = 0; i < pe.num_sections && i < 96; i++)
+    {
+        if (!read_process_memory(dc->process, pe.sections + i * sizeof(sec), &sec, sizeof(sec))) return;
+        if (!(sec.Characteristics & IMAGE_SCN_MEM_WRITE) || (sec.Characteristics & IMAGE_SCN_MEM_EXECUTE)) continue;
+        if (!sec.Misc.VirtualSize) continue;
+        minidump_add_memory_block(dc, base + sec.VirtualAddress, sec.Misc.VirtualSize, 0);
+    }
+}
+
+/* whether a value in the threads' stacks points into the module */
+static BOOL module_referenced_by_stacks(struct dump_context* dc, ULONG64 base, ULONG size)
+{
+    unsigned    i, j, word = dbghelp_current_cpu->word_size;
+    ULONG64     value;
+    char        buf[4096];
+    ULONG       pos, len;
+
+    for (i = 0; i < dc->num_mem; i++)
+    {
+        if (!dc->mem[i].rva) continue;  /* stacks are the blocks the thread list points to */
+        for (pos = 0; pos < dc->mem[i].size; pos += len)
+        {
+            len = min(dc->mem[i].size - pos, sizeof(buf));
+            if (!read_process_memory(dc->process, dc->mem[i].base + pos, buf, len)) break;
+            for (j = 0; j + word <= len; j += word)
+            {
+                value = 0;
+                memcpy(&value, buf + j, word);
+                if (value >= base && value < base + size) return TRUE;
+            }
+        }
+    }
+    return FALSE;
+}
+
+/* whether a stack value is one a stack trace needs: an address in a module
+ * or in a thread's stack */
+static BOOL stack_value_needed(struct dump_context* dc, ULONG64 value)
+{
+    unsigned i;
+
+    for (i = 0; i < dc->num_modules; i++)
+        if (value >= dc->modules[i].base && value < dc->modules[i].base + dc->modules[i].size) return TRUE;
+    for (i = 0; i < dc->num_mem; i++)
+        if (dc->mem[i].rva && value >= dc->mem[i].base && value < dc->mem[i].base + dc->mem[i].size) return TRUE;
+    return FALSE;
+}
+
