+/* Stained Glass OS: domain accounts signed in to this machine. The server
+ * knows their real SIDs and names (sg-session's sg-domain-logon records them
+ * at sign-in) and answers through sg_lookup_account: a SID string gives
+ * "DOMAIN\name", a name gives "<SID>\t<DOMAIN>"; *kind is SidTypeUser or
+ * SidTypeGroup. */
+static BOOL sg_lookup_domain( const WCHAR *query, WCHAR *out, DWORD out_len, SID_NAME_USE *kind )
+{
+    NTSTATUS status;
+    DWORD rid = 0, len = 0;
+
+    SERVER_START_REQ( sg_lookup_account )
+    {
+        req->rid = 0;
+        wine_server_add_data( req, query, lstrlenW( query ) * sizeof(WCHAR) );
+        wine_server_set_reply( req, out, (out_len - 1) * sizeof(WCHAR) );
+        status = wine_server_call( req );
+        if (!status)
+        {
+            rid = reply->rid;
+            len = wine_server_reply_size( reply ) / sizeof(WCHAR);
+        }
+    }
+    SERVER_END_REQ;
+    if (status || (rid != 0x80000001 && rid != 0x80000002)) return FALSE;
+    out[len] = 0;
+    *kind = rid == 0x80000002 ? SidTypeGroup : SidTypeUser;
+    return TRUE;
+}
