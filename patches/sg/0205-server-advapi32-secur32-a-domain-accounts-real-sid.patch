+/* A domain account's "DOMAIN\name" split in place; FALSE if not one. */
+static BOOL sg_domain_sid_name( PSID sid, WCHAR *buffer, DWORD len, WCHAR **domain, WCHAR **account,
+                                SID_NAME_USE *kind )
+{
+    WCHAR *str = NULL, *slash;
+    BOOL ret;
+
+    if (!ConvertSidToStringSidW( sid, &str )) return FALSE;
+    ret = sg_lookup_domain( str, buffer, len, kind ) && (slash = wcschr( buffer, '\\' ));
+    LocalFree( str );
+    if (!ret) return FALSE;
+    *slash = 0;
+    *domain = buffer;
+    *account = slash + 1;
+    return TRUE;
+}
