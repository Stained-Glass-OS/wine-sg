+        if (!sg_parse_sid( str, len / sizeof(WCHAR), &sid )) return FALSE;
+        LIST_FOR_EACH_ENTRY( entry, &sg_uid_sids, struct sg_uid_sid, entry )
+        {
+            if (!entry->domain) continue;
+            if (equal_sid( &entry->user.sid, &sid )) { found = &entry->user; break; }
+            for (i = 0; i < entry->group_count && !found; i++)
+                if (equal_sid( &entry->groups[i].sid, &sid )) { found = &entry->groups[i]; is_group = TRUE; }
+            for (i = 0; i < entry->name_count && !found; i++)
+                if (equal_sid( &entry->names[i].sid, &sid )) { found = &entry->names[i]; is_group = TRUE; }
+            if (found) break;
