+/* Domain accounts (the files sg-domain-logon writes, above) answer through
+ * the same request, without changing its layout: rid 0 and a name that is a
+ * SID string ("S-1-5-21-...") asks for that domain account's or group's
+ * name, and rid 0 and an account name asks whether it is a domain account.
+ * The reply's rid is then SG_LOOKUP_DOMAIN_USER or _GROUP, and its data
+ * "DOMAIN\name" for a SID, or "<SID>\t<DOMAIN>" for a name. */
+#define SG_LOOKUP_DOMAIN_USER  0x80000001
+#define SG_LOOKUP_DOMAIN_GROUP 0x80000002
+
+static int sg_name_matches( const struct sg_domain_name *item, const WCHAR *name, data_size_t len )
+{
+    const WCHAR *slash = memchr( item->name, '\\', item->name_len ), *p;
+    data_size_t account_len;
+
+    /* DOMAIN\name: the whole of it */
+    for (p = name; p < name + len / sizeof(WCHAR); p++) if (*p == '\\') break;
+    if (p < name + len / sizeof(WCHAR))
+        return len == item->name_len && !memicmp_strW( item->name, name, len );
+    /* name alone: the part after the domain */
+    if (!slash) return FALSE;
+    slash++;
+    account_len = item->name_len - (slash - item->name) * sizeof(WCHAR);
+    return len == account_len && !memicmp_strW( slash, name, len );
+}
