+/* The SID as "S-1-...", for replies; its length in characters (0: too long). */
+static data_size_t sg_format_sid( const struct sid *sid, WCHAR *out, data_size_t max_chars )
+{
+    char buf[256];
+    unsigned long long auth = 0;
+    unsigned int i;
+    int len;
+
+    for (i = 0; i < 6; i++) auth = (auth << 8) | sid->id_auth[i];
+    len = snprintf( buf, sizeof(buf), "S-%u-%llu", sid->revision, auth );
+    for (i = 0; i < sid->sub_count && len < (int)sizeof(buf); i++)
+        len += snprintf( buf + len, sizeof(buf) - len, "-%u", sid->sub_auth[i] );
+    if (len < 0 || len >= (int)sizeof(buf) || (data_size_t)len > max_chars) return 0;
+    for (i = 0; i < (unsigned int)len; i++) out[i] = (unsigned char)buf[i];
+    return len;
+}
+
+/* UTF-8 to UTF-16, in a new buffer; NULL if it is not valid UTF-8. */
+static WCHAR *sg_utf8_to_wide( const char *str, size_t len, data_size_t *ret_len )
+{
+    WCHAR *out = mem_alloc( (len + 1) * sizeof(WCHAR) );
+    data_size_t n = 0;
+    size_t i = 0;
+
+    if (!out) return NULL;
+    while (i < len)
+    {
+        unsigned char c = str[i];
+        unsigned int cp, extra, k;
+
+        if (c < 0x80) { cp = c; extra = 0; }
+        else if ((c & 0xe0) == 0xc0) { cp = c & 0x1f; extra = 1; }
+        else if ((c & 0xf0) == 0xe0) { cp = c & 0x0f; extra = 2; }
+        else if ((c & 0xf8) == 0xf0) { cp = c & 0x07; extra = 3; }
+        else goto bad;
+        if (i + extra >= len && extra) goto bad;
+        for (k = 1; k <= extra; k++)
+        {
+            if ((str[i + k] & 0xc0) != 0x80) goto bad;
+            cp = (cp << 6) | (str[i + k] & 0x3f);
+        }
+        i += extra + 1;
+        if (!cp || cp > 0x10ffff || (cp >= 0xd800 && cp < 0xe000)) goto bad;
+        if (cp >= 0x10000)
+        {
+            cp -= 0x10000;
+            out[n++] = 0xd800 | (cp >> 10);
+            out[n++] = 0xdc00 | (cp & 0x3ff);
+        }
+        else out[n++] = cp;
+    }
+    *ret_len = n * sizeof(WCHAR);
+    return out;
+bad:
+    free( out );
+    return NULL;
+}
