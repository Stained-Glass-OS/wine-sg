+/* Read a uid's domain identity file into the entry; FALSE if there is none
+ * (or it is not safe to believe). */
+static int sg_read_domain_account( struct sg_uid_sid *entry )
+{
+    char path[64], data[16384], *line, *next;
+    struct stat st;
+    ssize_t size;
+    int fd;
+
+    if (stat( SG_DOMAIN_SIDS_DIR, &st ) || !S_ISDIR( st.st_mode ) || st.st_uid || (st.st_mode & 022)) return FALSE;
+    snprintf( path, sizeof(path), SG_DOMAIN_SIDS_DIR "/%u", (unsigned int)entry->uid );
+    if ((fd = open( path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK )) == -1) return FALSE;
+    if (fstat( fd, &st ) || !S_ISREG( st.st_mode ) || st.st_uid || (st.st_mode & 022) ||
+        (size = read( fd, data, sizeof(data) - 1 )) <= 0)
+    {
+        close( fd );
+        return FALSE;
+    }
+    close( fd );
+    data[size] = 0;
+
+    sg_free_domain_account( entry );
+    if (!(entry->groups = mem_alloc( SG_DOMAIN_MAX_GROUPS * sizeof(*entry->groups) )) ||
+        !(entry->names = mem_alloc( SG_DOMAIN_MAX_GROUPS * sizeof(*entry->names) )))
+    {
+        sg_free_domain_account( entry );
+        return FALSE;
+    }
+    for (line = data; line && *line; line = next)
+    {
+        struct sg_domain_name item;
+        char *sid, *name, *end;
+        int is_user = FALSE, is_name = FALSE;
+
+        if ((next = strchr( line, '\n' ))) *next++ = 0;
+        if ((end = strchr( line, '\r' ))) *end = 0;
+        if (!strncmp( line, "user ", 5 )) { is_user = TRUE; sid = line + 5; }
+        else if (!strncmp( line, "group ", 6 )) sid = line + 6;
+        else if (!strncmp( line, "name ", 5 )) { is_name = TRUE; sid = line + 5; }
+        else continue;
+        if (!(name = strchr( sid, ' ' ))) continue;
+        if (!sg_parse_sid( sid, name - sid, &item.sid )) continue;
+        name++;
+        if (!strchr( name, '\\' ) || !(item.name = sg_utf8_to_wide( name, strlen( name ), &item.name_len ))) continue;
+        if (is_user && !entry->user.name) entry->user = item;
+        else if (is_name && entry->name_count < SG_DOMAIN_MAX_GROUPS) entry->names[entry->name_count++] = item;
+        else if (!is_user && !is_name && entry->group_count < SG_DOMAIN_MAX_GROUPS) entry->groups[entry->group_count++] = item;
+        else free( item.name );
+    }
+    if (!entry->user.name)
+    {
+        sg_free_domain_account( entry );
+        return FALSE;
+    }
+    entry->sid = entry->user.sid;
+    entry->domain = TRUE;
+    return TRUE;
+}
