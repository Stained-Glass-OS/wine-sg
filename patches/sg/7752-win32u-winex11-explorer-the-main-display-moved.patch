From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, winex11, explorer: another display made the main one, one moved to the left of it

Over every monitor (7749) the virtual screen starts at the leftmost display, and making
another display the main one or putting one left of it moves Windows' 0,0 on the X screen.
Fresh programs saw it; running ones did not: only the desktop heard of a display change the
driver found (Windows tells every window: WM_DISPLAYCHANGE is broadcast now), windows whose
Win32 rectangle stayed the same were never moved on the X screen (winex11 re-places them on
WM_WINE_DESKTOP_RESIZED when the origin moved), and the desktop's icons were drawn from the
desktop window's corner, the leftmost display, not the main display's.
---
diff --git a/programs/explorer/desktop.c b/programs/explorer/desktop.c
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -299,14 +299,33 @@
 static void shellwindows_init(void);
 static void desktopshellbrowserwindow_init(void);
 
+/* Stained Glass OS: where the main display's corner is in the desktop window. The desktop over
+ * every monitor (wine-sg 7749) starts at the leftmost and topmost of them, and the icons are on
+ * the main display, as on Windows: with a monitor left of the main one they were on that one
+ * (wine-sg 7752). 0,0 when the main display is the top-left one. */
+static int sg_desk_ox(void)
+{
+#ifdef SG_MUTANT_ICONS_AT_DESKTOP_ORIGIN
+    return 0;
+#endif
+    return -GetSystemMetrics( SM_XVIRTUALSCREEN );
+}
+static int sg_desk_oy(void)
+{
+#ifdef SG_MUTANT_ICONS_AT_DESKTOP_ORIGIN
+    return 0;
+#endif
+    return -GetSystemMetrics( SM_YVIRTUALSCREEN );
+}
+
 static RECT get_icon_rect( unsigned int index )
 {
     RECT rect;
 
     /* Stained Glass OS: each icon has a place of its own on the grid */
-    rect.left   = launchers[index]->col * launcher_size + icon_offset_cx;
+    rect.left   = sg_desk_ox() + launchers[index]->col * launcher_size + icon_offset_cx;
     rect.right  = rect.left + icon_cx;
-    rect.top    = launchers[index]->row * launcher_size + icon_offset_cy;
+    rect.top    = sg_desk_oy() + launchers[index]->row * launcher_size + icon_offset_cy;
     rect.bottom = rect.top + icon_cy;
     return rect;
 }
@@ -315,9 +334,9 @@
 {
     RECT rect;
 
-    rect.left   = launchers[index]->col * launcher_size + title_offset_cx;
+    rect.left   = sg_desk_ox() + launchers[index]->col * launcher_size + title_offset_cx;
     rect.right  = rect.left + title_cx;
-    rect.top    = launchers[index]->row * launcher_size + title_offset_cy;
+    rect.top    = sg_desk_oy() + launchers[index]->row * launcher_size + title_offset_cy;
     rect.bottom = rect.top + title_cy;
     return rect;
 }
@@ -327,10 +346,12 @@
     RECT icon, title;
     unsigned int index;
 
-    if (!launcher_size || x < 0 || y < 0) return -1;
+    int gx = x - sg_desk_ox(), gy = y - sg_desk_oy();   /* on the grid, from the main display's corner */
+
+    if (!launcher_size || gx < 0 || gy < 0) return -1;
     for (index = 0; index < nb_launchers; index++)
     {
-        if (launchers[index]->col != x / launcher_size || launchers[index]->row != y / launcher_size) continue;
+        if (launchers[index]->col != gx / launcher_size || launchers[index]->row != gy / launcher_size) continue;
         icon = get_icon_rect( index );
         title = get_title_rect( index );
         if ((x < icon.left || x > icon.right || y < icon.top || y > icon.bottom) &&
@@ -2494,8 +2515,8 @@
     unsigned int i, k;
 
     if (sg_drag_anchor < 0 || sg_drag_anchor >= (int)nb_launchers || !launcher_size) return;
-    x = max( 0, pt.x - sg_drag_offset.x + launcher_size / 2 ) / launcher_size;
-    y = max( 0, pt.y - sg_drag_offset.y + launcher_size / 2 ) / launcher_size;
+    x = max( 0, pt.x - sg_desk_ox() - sg_drag_offset.x + launcher_size / 2 ) / launcher_size;
+    y = max( 0, pt.y - sg_desk_oy() - sg_drag_offset.y + launcher_size / 2 ) / launcher_size;
     dc = min( x, cols - 1 ) - launchers[sg_drag_anchor]->col;
     dr = min( y, rows - 1 ) - launchers[sg_drag_anchor]->row;
     if ((!dc && !dr) || !(used = calloc( cols * rows, 1 ))) return;
@@ -2673,8 +2694,8 @@
         {
             /* files dropped on the empty desktop are placed where they were dropped */
             sg_save_positions();
-            sg_drop_slot = (max( 0, pt.x ) / launcher_size) * max( launchers_per_column, 1 ) +
-                           min( max( 0, pt.y ) / launcher_size, max( launchers_per_column, 1 ) - 1 );
+            sg_drop_slot = (max( 0, pt.x - sg_desk_ox() ) / launcher_size) * max( launchers_per_column, 1 ) +
+                           min( max( 0, pt.y - sg_desk_oy() ) / launcher_size, max( launchers_per_column, 1 ) - 1 );
             sg_drop_time = GetTickCount();
         }
         TRACE( "dropping on %d\n", sg_drop_sub_index );
@@ -2935,6 +2956,11 @@
 #endif
         return TRUE;
 
+    case WM_DISPLAYCHANGE:
+        /* the displays changed: the icons are drawn from the main display's corner (wine-sg 7752) */
+        if (!using_root) { InvalidateRect( hwnd, NULL, TRUE ); sg_dump(); }
+        break;
+
     case WM_SG_DESKTOP_REPAINT:
         if (!IsRectEmpty( &sg_erased )) InvalidateRect( hwnd, &sg_erased, FALSE );
         SetRectEmpty( &sg_erased );
@@ -3070,8 +3096,8 @@
                 if (index < (int)nb_launchers && launchers[index]->selected)
                 {
                     sg_drag_anchor = index;
-                    sg_drag_offset.x = sg_press_pt.x - launchers[index]->col * launcher_size;
-                    sg_drag_offset.y = sg_press_pt.y - launchers[index]->row * launcher_size;
+                    sg_drag_offset.x = sg_press_pt.x - sg_desk_ox() - launchers[index]->col * launcher_size;
+                    sg_drag_offset.y = sg_press_pt.y - sg_desk_oy() - launchers[index]->row * launcher_size;
                     sg_drag_icons( hwnd );
                 }
             }
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -4205,8 +4205,19 @@
     }
 
     if (!broadcast)
+    {
         send_message( get_desktop_window(), WM_DISPLAYCHANGE, current_mode.dmBitsPerPel,
                       MAKELPARAM( current_mode.dmPelsWidth, current_mode.dmPelsHeight ) );
+#ifndef SG_MUTANT_DISPLAYCHANGE_DESKTOP_ONLY
+        /* Stained Glass OS: and every window, as Windows tells them of any display change --
+         * a monitor plugged in, another made the main display, one moved (wine-sg 7752).
+         * Only the desktop heard of one the driver found: the taskbars stayed where the
+         * displays had been */
+        send_message_timeout( HWND_BROADCAST, WM_DISPLAYCHANGE, current_mode.dmBitsPerPel,
+                              MAKELPARAM( current_mode.dmPelsWidth, current_mode.dmPelsHeight ),
+                              SMTO_ABORTIFHUNG, 2000, FALSE );
+#endif
+    }
     else
     {
         /* broadcast to all the windows as well if an application changed the display settings */
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3871,6 +3871,17 @@
         {
             /* update the full screen state */
             update_net_wm_states( data );
+#ifndef SG_MUTANT_ORIGIN_MOVE_KEEPS_X
+            /* Stained Glass OS: the virtual screen's origin moved (another monitor made the main
+             * display, one put to the left of it: wine-sg 7752) -- the same Win32 rectangle is
+             * now somewhere else on the X screen. Taken for no change, every window stayed on
+             * the monitor it was on, the taskbar on what was no longer the main display */
+            {
+                RECT virt = NtUserGetVirtualScreenRect( MDT_DEFAULT );
+                if (virt.left != (int)wp || virt.top != (int)lp)
+                    OffsetRect( &data->pending_state.rect, 1, 1 );
+            }
+#endif
             window_set_config( data, &data->rects.visible, FALSE, 0 );
             release_win_data( data );
         }
