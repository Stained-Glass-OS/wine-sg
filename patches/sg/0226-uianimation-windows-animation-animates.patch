+    { &anim_cs_debug.ProcessLocksList, &anim_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": anim_cs") }
+};
+static CRITICAL_SECTION anim_cs = { &anim_cs_debug, -1, 0, 0, 0, 0 };
