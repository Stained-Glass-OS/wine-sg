+static UI_ANIMATION_SECONDS current_seconds(void)
+{
+    LARGE_INTEGER counter, freq;
+    QueryPerformanceCounter( &counter );
+    QueryPerformanceFrequency( &freq );
+    return (double)counter.QuadPart / (double)freq.QuadPart;
+}
