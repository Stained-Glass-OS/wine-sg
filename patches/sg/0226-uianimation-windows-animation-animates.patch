+/***********************************************************************
+ *          IUIAnimationTransition
+ */
+enum transition_kind
+{
+    TR_INSTANTANEOUS,
+    TR_CONSTANT,
+    TR_DISCRETE,
+    TR_LINEAR,
+    TR_LINEAR_FROM_SPEED,
+    TR_SINUSOIDAL_FROM_VELOCITY,
+    TR_SINUSOIDAL_FROM_RANGE,
+    TR_ACCELERATE_DECELERATE,
+    TR_REVERSAL,
+    TR_CUBIC,
+    TR_SMOOTH_STOP,
+    TR_PARABOLIC,
+    TR_CUSTOM,
+};
+
+struct transition
+{
+    IUIAnimationTransition IUIAnimationTransition_iface;
+    LONG ref;
+    enum transition_kind kind;
+    UI_ANIMATION_SECONDS duration;
+    double final;
+    double p1, p2, p3, p4;         /* per kind */
+    double initial, velocity;
+    BOOL initial_set;
+    IUIAnimationInterpolator *interpolator;
+};
+
+static const struct IUIAnimationTransitionVtbl transition_vtbl;
+
+static struct transition *impl_from_IUIAnimationTransition( IUIAnimationTransition *iface )
+{
+    return CONTAINING_RECORD( iface, struct transition, IUIAnimationTransition_iface );
+}
+
+static struct transition *unsafe_transition( IUIAnimationTransition *iface )
+{
+    if (!iface || iface->lpVtbl != &transition_vtbl) return NULL;
+    return impl_from_IUIAnimationTransition( iface );
+}
+
+static HRESULT WINAPI transition_QueryInterface( IUIAnimationTransition *iface, REFIID iid, void **obj )
+{
+    TRACE( "(%p)->(%s %p)\n", iface, debugstr_guid( iid ), obj );
+
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IUIAnimationTransition ))
+    {
+        IUIAnimationTransition_AddRef( iface );
+        *obj = iface;
+        return S_OK;
+    }
+    WARN( "interface %s not implemented\n", debugstr_guid( iid ) );
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI transition_AddRef( IUIAnimationTransition *iface )
+{
+    struct transition *This = impl_from_IUIAnimationTransition( iface );
+    ULONG ref = InterlockedIncrement( &This->ref );
+    TRACE( "(%p) ref = %lu\n", This, ref );
+    return ref;
+}
+
+static ULONG WINAPI transition_Release( IUIAnimationTransition *iface )
+{
+    struct transition *This = impl_from_IUIAnimationTransition( iface );
+    ULONG ref = InterlockedDecrement( &This->ref );
+
+    TRACE( "(%p) ref = %lu\n", This, ref );
+    if (!ref)
+    {
+        if (This->interpolator) IUIAnimationInterpolator_Release( This->interpolator );
+        free( This );
+    }
+    return ref;
+}
+
+/* the duration, once the initial value and velocity are known */
+static void transition_prepare( struct transition *tr, double initial, double velocity )
+{
+    tr->initial = initial;
+    tr->velocity = velocity;
+    tr->initial_set = TRUE;
+
+    switch (tr->kind)
+    {
+    case TR_LINEAR_FROM_SPEED:
+        tr->duration = tr->p1 > 0 ? fabs( tr->final - initial ) / tr->p1 : 0;
+        break;
+    case TR_PARABOLIC:
+        /* final velocity p1, acceleration p2: v_f^2 = v_0^2 + 2a(x_f - x_0) */
+        if (tr->p2 != 0)
+        {
+            double v0_sq = tr->p1 * tr->p1 - 2 * tr->p2 * (tr->final - initial);
+            double v0 = v0_sq > 0 ? sqrt( v0_sq ) : 0;
+            if ((tr->final - initial) * tr->p1 < 0) v0 = -v0;
+            tr->velocity = v0;
+            tr->duration = fabs( (tr->p1 - v0) / tr->p2 );
+        }
+        else tr->duration = tr->p1 != 0 ? fabs( (tr->final - initial) / tr->p1 ) : 0;
+        break;
+    case TR_CUSTOM:
+        IUIAnimationInterpolator_SetInitialValueAndVelocity( tr->interpolator, initial, velocity );
+        if (FAILED(IUIAnimationInterpolator_GetDuration( tr->interpolator, &tr->duration ))) tr->duration = 0;
+        break;
+    default:
+        break;
+    }
+    if (!(tr->duration >= 0)) tr->duration = 0;
+}
+
+/* where an accelerate-decelerate curve is, 0 to 1, at progress p */
+static double accel_decel( double p, double a, double d )
+{
+    double v = 1 / (1 - a / 2 - d / 2);
+
+    if (a > 0 && p < a) return v * p * p / (2 * a);
+    if (d > 0 && p > 1 - d) return 1 - v * (1 - p) * (1 - p) / (2 * d);
+    return v * (a / 2 + (p - a));
+}
+
+/* Hermite curve from (x0, v0) to (x1, v1) over duration d */
+static double hermite( double x0, double v0, double x1, double v1, double d, double t )
+{
+    double p = t / d, p2 = p * p, p3 = p2 * p;
+    return (2 * p3 - 3 * p2 + 1) * x0 + (p3 - 2 * p2 + p) * d * v0 + (-2 * p3 + 3 * p2) * x1 + (p3 - p2) * d * v1;
+}
+
+static double transition_value( struct transition *tr, UI_ANIMATION_SECONDS t )
+{
+    double x0 = tr->initial, d = tr->duration;
+
+    if (t < 0) t = 0;
+    if (t > d) t = d;
+
+    switch (tr->kind)
+    {
+    case TR_INSTANTANEOUS:
+        return tr->final;
+    case TR_CONSTANT:
+        return x0;
+    case TR_DISCRETE:
+        return t < tr->p1 ? x0 : tr->final;
+    case TR_LINEAR:
+    case TR_LINEAR_FROM_SPEED:
+        return d > 0 ? x0 + (tr->final - x0) * (t / d) : tr->final;
+    case TR_SINUSOIDAL_FROM_VELOCITY:
+        /* period p1, starting at the initial value with the initial velocity */
+        if (tr->p1 <= 0) return x0;
+        return x0 + tr->velocity * tr->p1 / (2 * M_PI) * sin( 2 * M_PI * t / tr->p1 );
+    case TR_SINUSOIDAL_FROM_RANGE:
+    {
+        /* minimum p1, maximum p2, period p3, slope p4 */
+        double mid = (tr->p1 + tr->p2) / 2, amp = (tr->p2 - tr->p1) / 2, s, phase;
+        if (tr->p3 <= 0 || amp == 0) return x0;
+        s = (x0 - mid) / amp;
+        if (s > 1) s = 1;
+        if (s < -1) s = -1;
+        phase = asin( s );
+        if (tr->p4 == UI_ANIMATION_SLOPE_DECREASING) phase = M_PI - phase;
+        return mid + amp * sin( 2 * M_PI * t / tr->p3 + phase );
+    }
+    case TR_ACCELERATE_DECELERATE:
+        return d > 0 ? x0 + (tr->final - x0) * accel_decel( t / d, tr->p1, tr->p2 ) : tr->final;
+    case TR_REVERSAL:
+        /* back to where it started, leaving with the opposite velocity */
+        return d > 0 ? x0 + tr->velocity * t * (1 - t / d) : x0;
+    case TR_CUBIC:
+        return d > 0 ? hermite( x0, tr->velocity, tr->final, tr->p1, d, t ) : tr->final;
+    case TR_SMOOTH_STOP:
+        return d > 0 ? hermite( x0, tr->velocity, tr->final, 0, d, t ) : tr->final;
+    case TR_PARABOLIC:
+        if (t >= d) return tr->final;
+        return x0 + tr->velocity * t + tr->p2 * t * t / 2;
+    case TR_CUSTOM:
+    {
+        double value = x0;
+        if (t >= d && SUCCEEDED(IUIAnimationInterpolator_GetFinalValue( tr->interpolator, &value ))) return value;
+        IUIAnimationInterpolator_InterpolateValue( tr->interpolator, t, &value );
+        return value;
+    }
+    }
+    return x0;
+}
+
+static double transition_velocity( struct transition *tr, UI_ANIMATION_SECONDS t )
+{
+    double h = tr->duration > 0 ? min( tr->duration / 100, 0.001 ) : 0;
+
+    if (tr->kind == TR_CUSTOM)
+    {
+        double velocity = 0;
+        IUIAnimationInterpolator_InterpolateVelocity( tr->interpolator, t, &velocity );
+        return velocity;
+    }
+    if (h <= 0) return 0;
+    if (t - h < 0) t = h;
+    return (transition_value( tr, t ) - transition_value( tr, t - h )) / h;
+}
+
+static HRESULT WINAPI transition_SetInitialValue( IUIAnimationTransition *iface, DOUBLE value )
+{
+    struct transition *This = impl_from_IUIAnimationTransition( iface );
+
+    TRACE( "(%p)->(%f)\n", This, value );
+    EnterCriticalSection( &anim_cs );
+    transition_prepare( This, value, This->velocity );
+    LeaveCriticalSection( &anim_cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI transition_SetInitialVelocity( IUIAnimationTransition *iface, DOUBLE velocity )
+{
+    struct transition *This = impl_from_IUIAnimationTransition( iface );
+
+    TRACE( "(%p)->(%f)\n", This, velocity );
+    EnterCriticalSection( &anim_cs );
+    transition_prepare( This, This->initial, velocity );
+    LeaveCriticalSection( &anim_cs );
+    return S_OK;
+}
+
+static BOOL transition_duration_known( struct transition *tr )
+{
+    switch (tr->kind)
+    {
+    case TR_LINEAR_FROM_SPEED:
+    case TR_PARABOLIC:
+    case TR_CUSTOM:
+        return tr->initial_set;
+    default:
+        return TRUE;
+    }
+}
+
+static HRESULT WINAPI transition_IsDurationKnown( IUIAnimationTransition *iface )
+{
+    struct transition *This = impl_from_IUIAnimationTransition( iface );
+    TRACE( "(%p)\n", This );
+    return transition_duration_known( This ) ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI transition_GetDuration( IUIAnimationTransition *iface, UI_ANIMATION_SECONDS *duration )
+{
+    struct transition *This = impl_from_IUIAnimationTransition( iface );
+
+    TRACE( "(%p)->(%p)\n", This, duration );
+    if (!duration) return E_POINTER;
+    if (!transition_duration_known( This )) return UI_E_VALUE_NOT_DETERMINED;
+    *duration = This->duration;
+    return S_OK;
+}
+
+static const struct IUIAnimationTransitionVtbl transition_vtbl =
+{
+    transition_QueryInterface,
+    transition_AddRef,
+    transition_Release,
+    transition_SetInitialValue,
+    transition_SetInitialVelocity,
+    transition_IsDurationKnown,
+    transition_GetDuration,
+};
+
+static HRESULT transition_new( enum transition_kind kind, UI_ANIMATION_SECONDS duration, double final,
+                               double p1, double p2, double p3, double p4, IUIAnimationTransition **out )
+{
+    struct transition *tr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(duration >= 0)) return E_INVALIDARG;
+    if (!(tr = calloc( 1, sizeof(*tr) ))) return E_OUTOFMEMORY;
+    tr->IUIAnimationTransition_iface.lpVtbl = &transition_vtbl;
+    tr->ref = 1;
+    tr->kind = kind;
+    tr->duration = duration;
+    tr->final = final;
+    tr->p1 = p1;
+    tr->p2 = p2;
+    tr->p3 = p3;
+    tr->p4 = p4;
+    *out = &tr->IUIAnimationTransition_iface;
+    return S_OK;
+}
+
+/* the value a transition ends at */
+static double transition_final( struct transition *tr )
+{
+    switch (tr->kind)
+    {
+    case TR_CONSTANT:
+    case TR_REVERSAL:
+    case TR_SINUSOIDAL_FROM_VELOCITY:
+    case TR_SINUSOIDAL_FROM_RANGE:
+    case TR_CUSTOM:
+        return transition_value( tr, tr->duration );
+    default:
+        return tr->final;
+    }
+}
