From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: stand-ins for the Lock, Shield, Ringer and NetworkTower icons

Four more icon-font glyphs Windows Terminal uses (Lock, Shield, Ringer, NetworkTower; Shield marks its elevated tabs) are drawn as standard Unicode characters when the icon font is not installed, instead of nothing.
---
diff --git a/dlls/windows.ui.xaml/glyphs.txt b/dlls/windows.ui.xaml/glyphs.txt
index 583508c..1a4101d 100644
--- a/dlls/windows.ui.xaml/glyphs.txt
+++ b/dlls/windows.ui.xaml/glyphs.txt
@@ -17,6 +17,7 @@ Forward E72A 2192
 Back E72B 2190
 Refresh E72C 21BB
 Share E72D 2197
+Lock E72E 1F512
 FavoriteStar E734 2606
 FavoriteStarFill E735 2605
 Remove E738 2212
@@ -49,7 +50,10 @@ ChevronLeftSmall E96F 2039
 ChevronRightSmall E970 203A
 ChevronRightMed E974 203A
 Unknown E9CE 003F
+Shield EA18 26E8
 ErrorBadge EA39 2297
+Ringer EA8F 1F514
+NetworkTower EC05 1F4F6
 CaretLeftSolid8 EDD9 25C2
 CaretRightSolid8 EDDA 25B8
 CaretUpSolid8 EDDB 25B4
diff --git a/dlls/windows.ui.xaml/symbols.h b/dlls/windows.ui.xaml/symbols.h
index 5121bf4..e533ac6 100644
--- a/dlls/windows.ui.xaml/symbols.h
+++ b/dlls/windows.ui.xaml/symbols.h
@@ -220,6 +220,7 @@ static const struct { UINT32 value; UINT32 fallback; } glyphs[] =
     { 0xe72a, 0x2192 }, /* Forward */
     { 0xe72b, 0x2190 }, /* Back */
     { 0xe72c, 0x21BB }, /* Refresh */
+    { 0xe72e, 0x1F512 }, /* Lock */
     { 0xe734, 0x2606 }, /* FavoriteStar */
     { 0xe735, 0x2605 }, /* FavoriteStarFill */
     { 0xe738, 0x2212 }, /* Remove */
@@ -252,7 +253,10 @@ static const struct { UINT32 value; UINT32 fallback; } glyphs[] =
     { 0xe970, 0x203A }, /* ChevronRightSmall */
     { 0xe974, 0x203A }, /* ChevronRightMed */
     { 0xe9ce, 0x003F }, /* Unknown */
+    { 0xea18, 0x26E8 }, /* Shield */
     { 0xea39, 0x2297 }, /* ErrorBadge */
+    { 0xea8f, 0x1F514 }, /* Ringer */
+    { 0xec05, 0x1F4F6 }, /* NetworkTower */
     { 0xedd9, 0x25C2 }, /* CaretLeftSolid8 */
     { 0xedda, 0x25B8 }, /* CaretRightSolid8 */
     { 0xeddb, 0x25B4 }, /* CaretUpSolid8 */
