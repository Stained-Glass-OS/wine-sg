+/* The texture another device of the process made, opened with its shared handle. */
+HRESULT d3d_texture2d_open_shared(struct d3d_device *device, HANDLE handle, struct d3d_texture2d **out)
+{
+    struct d3d_shared_resource *shared = NULL, *entry;
+    struct d3d_texture2d *texture;
+    HRESULT hr;
+
+    AcquireSRWLockExclusive(&shared_resources_lock);
+    LIST_FOR_EACH_ENTRY(entry, &shared_resources, struct d3d_shared_resource, entry)
+    {
+        if (entry->handle && entry->handle == handle)
+        {
+            shared_resource_addref(entry);
+            shared = entry;
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive(&shared_resources_lock);
+    if (!shared)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = texture2d_create(device, &shared->desc, NULL, NULL, shared, &texture)))
+    {
+        shared_resource_release(shared);
+        return hr;
+    }
+
+    /* A resource without a keyed mutex is what its maker has drawn up to now. */
+    if (!(shared->desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX))
+    {
+        BYTE *pixels;
+        UINT pitch, size;
+
+        AcquireSRWLockExclusive(&shared->lock);
+        if (shared->source && SUCCEEDED(texture2d_read_pixels(shared->source, &pixels, &pitch, &size)))
+        {
+            free(shared->pixels);
+            shared->pixels = pixels;
+            shared->pitch = pitch;
+            shared->size = size;
+            ++shared->version;
+        }
+        ReleaseSRWLockExclusive(&shared->lock);
+    }
+    if (shared->pixels && SUCCEEDED(texture2d_write_pixels(texture, shared->pixels, shared->pitch)))
+        texture->synced_version = shared->version;
+
+    shared_resource_release(shared);
+    *out = texture;
+    return S_OK;
+}
