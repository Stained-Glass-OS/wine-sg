-    SRWLOCK keyed_mutex_lock;
-    CONDITION_VARIABLE keyed_mutex_released;
-    BOOL keyed_mutex_owned;
-    UINT64 keyed_mutex_key;
+    IWineDXGISharedResource IWineDXGISharedResource_iface;
+    struct d3d_shared_resource *shared;
+    ULONGLONG synced_version;
 };
 
