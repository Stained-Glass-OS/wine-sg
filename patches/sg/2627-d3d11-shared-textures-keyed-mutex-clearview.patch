+struct d3d_texture2d;
+
+/* A texture that other devices of the process can open (D3D11_RESOURCE_MISC_SHARED*): the keyed
+ * mutex state, and the pixels that are handed over with it. */
+struct d3d_shared_resource
+{
+    LONG refcount;
+    struct list entry;
+    HANDLE handle;                  /* legacy shared handle, NULL for NT handle sharing */
+    D3D11_TEXTURE2D_DESC desc;
+    SRWLOCK lock;
+    CONDITION_VARIABLE released;
+    BOOL owned, abandoned;
+    UINT64 key;
+    ID3D11Device2 *owner_device;    /* not referenced */
+    struct d3d_texture2d *owner_texture, *source;  /* not referenced */
+    BYTE *pixels;
+    UINT pitch, size;
+    ULONGLONG version;
+};
+
 struct d3d_texture2d
 {
     ID3D11Texture2D ID3D11Texture2D_iface;
@@ -144,15 +166,14 @@ struct d3d_texture2d
