+static HRESULT STDMETHODCALLTYPE d3d11_texture2d_QueryInterface(ID3D11Texture2D *iface, REFIID riid, void **object);
+static ULONG STDMETHODCALLTYPE d3d11_texture2d_AddRef(ID3D11Texture2D *iface);
+static ULONG STDMETHODCALLTYPE d3d11_texture2d_Release(ID3D11Texture2D *iface);
+
+/* ---- textures shared between the devices of a process ---- */
+
+static struct list shared_resources = LIST_INIT(shared_resources);
+static SRWLOCK shared_resources_lock = SRWLOCK_INIT;
+static LONG shared_handle_counter;
+
+static BOOL texture_pixels_exchangeable(const D3D11_TEXTURE2D_DESC *desc)
+{
+    /* Compressed, planar and multisampled textures are not copied. */
+    return desc->SampleDesc.Count <= 1 && desc->ArraySize >= 1
+            && !(desc->Format >= DXGI_FORMAT_BC1_TYPELESS && desc->Format <= DXGI_FORMAT_BC7_UNORM_SRGB)
+            && !(desc->Format >= DXGI_FORMAT_NV12 && desc->Format <= DXGI_FORMAT_V408)
+            && !(desc->BindFlags & D3D11_BIND_DEPTH_STENCIL);
+}
+
+/* The first mip level of the first array slice, as the pixels of a shared resource. */
+static HRESULT texture2d_read_pixels(struct d3d_texture2d *texture, BYTE **pixels, UINT *pitch, UINT *size)
+{
+    D3D11_TEXTURE2D_DESC desc = texture->desc;
+    ID3D11Texture2D *staging;
+    ID3D11DeviceContext *context;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    HRESULT hr;
+    UINT y;
+
+    if (!texture_pixels_exchangeable(&texture->desc))
+        return E_NOTIMPL;
+
+    desc.Width = texture->desc.Width;
+    desc.Height = texture->desc.Height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    desc.MiscFlags = 0;
+    if (FAILED(hr = ID3D11Device2_CreateTexture2D(texture->device, &desc, NULL, &staging)))
+        return hr;
+
+    ID3D11Device2_GetImmediateContext(texture->device, &context);
+    ID3D11DeviceContext_CopySubresourceRegion(context, (ID3D11Resource *)staging, 0, 0, 0, 0,
+            (ID3D11Resource *)&texture->ID3D11Texture2D_iface, 0, NULL);
+    if (SUCCEEDED(hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &mapped)))
+    {
+        *pitch = mapped.RowPitch;
+        *size = mapped.RowPitch * desc.Height;
+        if ((*pixels = malloc(*size)))
+        {
+            for (y = 0; y < desc.Height; ++y)
+                memcpy(*pixels + y * mapped.RowPitch, (BYTE *)mapped.pData + y * mapped.RowPitch, mapped.RowPitch);
+        }
+        else
+            hr = E_OUTOFMEMORY;
+        ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
+    }
+    ID3D11DeviceContext_Release(context);
+    ID3D11Texture2D_Release(staging);
+    return hr;
+}
+
+static HRESULT texture2d_write_pixels(struct d3d_texture2d *texture, const BYTE *pixels, UINT pitch)
+{
+    ID3D11DeviceContext *context;
+
+    if (!texture_pixels_exchangeable(&texture->desc) || texture->desc.Usage != D3D11_USAGE_DEFAULT)
+        return E_NOTIMPL;
+
+    ID3D11Device2_GetImmediateContext(texture->device, &context);
+    ID3D11DeviceContext_UpdateSubresource(context, (ID3D11Resource *)&texture->ID3D11Texture2D_iface, 0, NULL,
+            pixels, pitch, 0);
+    ID3D11DeviceContext_Release(context);
+    return S_OK;
+}
+
+static void shared_resource_addref(struct d3d_shared_resource *shared)
+{
+    InterlockedIncrement(&shared->refcount);
+}
+
+static void shared_resource_release(struct d3d_shared_resource *shared)
+{
+    if (!shared || InterlockedDecrement(&shared->refcount))
+        return;
+
+    AcquireSRWLockExclusive(&shared_resources_lock);
+    list_remove(&shared->entry);
+    ReleaseSRWLockExclusive(&shared_resources_lock);
+    free(shared->pixels);
+    free(shared);
+}
+
+static struct d3d_shared_resource *shared_resource_create(struct d3d_texture2d *texture)
+{
+    struct d3d_shared_resource *shared;
+
+    if (!(shared = calloc(1, sizeof(*shared))))
+        return NULL;
+
+    shared->refcount = 1;
+    shared->desc = texture->desc;
+    shared->source = texture;
+    InitializeSRWLock(&shared->lock);
+    InitializeConditionVariable(&shared->released);
+    /* A legacy handle is a number any process could use; this is a number nothing else is. */
+    if (!(texture->desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_NTHANDLE))
+        shared->handle = (HANDLE)(ULONG_PTR)(0xc0000000 | ((InterlockedIncrement(&shared_handle_counter) & 0x3fffff) << 2));
+
+    AcquireSRWLockExclusive(&shared_resources_lock);
+    list_add_tail(&shared_resources, &shared->entry);
+    ReleaseSRWLockExclusive(&shared_resources_lock);
+    return shared;
+}
+
+/* The texture is destroyed: a mutex it holds is lost. */
+static void shared_resource_texture_gone(struct d3d_texture2d *texture)
+{
+    struct d3d_shared_resource *shared = texture->shared;
+
+    if (!shared)
+        return;
+
+    AcquireSRWLockExclusive(&shared->lock);
+    if (shared->source == texture)
+        shared->source = NULL;
+    if (shared->owned && shared->owner_texture == texture)
+    {
+#ifndef SG_MUTANT_SHARED_NO_ABANDON
+        shared->abandoned = TRUE;
+#endif
+        shared->owned = FALSE;
+        shared->owner_texture = NULL;
+        shared->owner_device = NULL;
+        WakeAllConditionVariable(&shared->released);
+    }
+    ReleaseSRWLockExclusive(&shared->lock);
+}
+
+static inline struct d3d_texture2d *impl_from_IWineDXGISharedResource(IWineDXGISharedResource *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3d_texture2d, IWineDXGISharedResource_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE shared_resource_QueryInterface(IWineDXGISharedResource *iface, REFIID riid, void **object)
+{
+    struct d3d_texture2d *texture = impl_from_IWineDXGISharedResource(iface);
+
+    return d3d11_texture2d_QueryInterface(&texture->ID3D11Texture2D_iface, riid, object);
+}
+
+static ULONG STDMETHODCALLTYPE shared_resource_AddRef(IWineDXGISharedResource *iface)
+{
+    struct d3d_texture2d *texture = impl_from_IWineDXGISharedResource(iface);
+
+    return d3d11_texture2d_AddRef(&texture->ID3D11Texture2D_iface);
+}
+
+static ULONG STDMETHODCALLTYPE shared_resource_Release(IWineDXGISharedResource *iface)
+{
+    struct d3d_texture2d *texture = impl_from_IWineDXGISharedResource(iface);
+
+    return d3d11_texture2d_Release(&texture->ID3D11Texture2D_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE shared_resource_get_shared_handle(IWineDXGISharedResource *iface, HANDLE *handle)
+{
+    struct d3d_texture2d *texture = impl_from_IWineDXGISharedResource(iface);
+
+    TRACE("iface %p, handle %p.\n", iface, handle);
+
+    if (!texture->shared)
+    {
+        *handle = NULL;
+        return S_OK;
+    }
+    /* a resource shared with an NT handle has none of the other kind */
+    if (texture->desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_NTHANDLE)
+        return E_INVALIDARG;
+    *handle = texture->shared->handle;
+    return S_OK;
+}
+
+static const IWineDXGISharedResourceVtbl shared_resource_vtbl =
+{
+    shared_resource_QueryInterface,
+    shared_resource_AddRef,
+    shared_resource_Release,
+    shared_resource_get_shared_handle,
+};
+
 /* ID3D11Texture2D methods */
 
 static HRESULT STDMETHODCALLTYPE d3d11_texture2d_QueryInterface(ID3D11Texture2D *iface, REFIID riid, void **object)
@@ -555,6 +748,12 @@ static HRESULT STDMETHODCALLTYPE d3d11_texture2d_QueryInterface(ID3D11Texture2D
         IUnknown_AddRef((IUnknown *)*object);
         return S_OK;
     }
+    else if (IsEqualGUID(riid, &IID_IWineDXGISharedResource))
+    {
+        *object = &texture->IWineDXGISharedResource_iface;
+        IUnknown_AddRef((IUnknown *)*object);
+        return S_OK;
+    }
 
     TRACE("Forwarding to dxgi resource.\n");
 
@@ -595,6 +794,7 @@ static ULONG STDMETHODCALLTYPE d3d11_texture2d_Release(ID3D11Texture2D *iface)
     if (!refcount)
     {
         ID3D11Device2 *device = texture->device;
+        shared_resource_texture_gone(texture);
         if (texture->swapchain)
             wined3d_swapchain_decref(texture->swapchain);
         /* Releasing the texture may free the d3d11 object, so do not access it
@@ -803,6 +1003,7 @@ static void STDMETHODCALLTYPE d3d_texture2d_wined3d_object_released(void *parent
     struct d3d_texture2d *texture = parent;
 
     if (texture->dxgi_resource) IUnknown_Release(texture->dxgi_resource);
+    shared_resource_release(texture->shared);
     free(texture);
 }
 
@@ -1014,6 +1215,22 @@ static BOOL validate_texture2d_desc(const D3D11_TEXTURE2D_DESC *desc, D3D_FEATUR
         return FALSE;
     }
 
+    /* sharing is of one kind: with or without a keyed mutex, from feature level 10 on */
+#ifndef SG_MUTANT_SHARED_FLAGS_ANY
+    if (desc->MiscFlags & (D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX
+            | D3D11_RESOURCE_MISC_SHARED_NTHANDLE))
+    {
+        unsigned int type = desc->MiscFlags & (D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX);
+
+        if (feature_level < D3D_FEATURE_LEVEL_10_0
+                || (type != D3D11_RESOURCE_MISC_SHARED && type != D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX))
+        {
+            WARN("Invalid sharing flags %#x.\n", desc->MiscFlags);
+            return FALSE;
+        }
+    }
+#endif
+
     return TRUE;
 }
 
@@ -1140,13 +1357,27 @@ static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_GetDevice(IDXGIKeyedMutex *ifa
 static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_AcquireSync(IDXGIKeyedMutex *iface, UINT64 key, DWORD timeout)
 {
     struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    struct d3d_shared_resource *shared = texture->shared;
     ULONGLONG start = GetTickCount64(), elapsed;
     HRESULT hr = S_OK;
 
     TRACE("iface %p, key %s, timeout %lu.\n", iface, wine_dbgstr_longlong(key), timeout);
 
-    AcquireSRWLockExclusive(&texture->keyed_mutex_lock);
-    while (texture->keyed_mutex_owned || texture->keyed_mutex_key != key)
+    AcquireSRWLockExclusive(&shared->lock);
+    if (shared->abandoned)
+    {
+        ReleaseSRWLockExclusive(&shared->lock);
+        return WAIT_ABANDONED;
+    }
+    /* the device holds it already: waiting would never end */
+#ifndef SG_MUTANT_KM_REACQUIRE_WAITS
+    if (shared->owned && shared->owner_device == texture->device)
+    {
+        ReleaseSRWLockExclusive(&shared->lock);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+#endif
+    while (shared->owned || shared->key != key)
     {
         elapsed = GetTickCount64() - start;
         if (timeout != INFINITE && elapsed >= timeout)
@@ -1154,12 +1385,30 @@ static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_AcquireSync(IDXGIKeyedMutex *i
             hr = WAIT_TIMEOUT;
             break;
         }
-        SleepConditionVariableSRW(&texture->keyed_mutex_released, &texture->keyed_mutex_lock,
+        SleepConditionVariableSRW(&shared->released, &shared->lock,
                 timeout == INFINITE ? INFINITE : timeout - elapsed, 0);
+        if (shared->abandoned)
+        {
+            ReleaseSRWLockExclusive(&shared->lock);
+            return WAIT_ABANDONED;
+        }
     }
     if (hr == S_OK)
-        texture->keyed_mutex_owned = TRUE;
-    ReleaseSRWLockExclusive(&texture->keyed_mutex_lock);
+    {
+        shared->owned = TRUE;
+        shared->owner_device = texture->device;
+        shared->owner_texture = texture;
+    }
+    ReleaseSRWLockExclusive(&shared->lock);
