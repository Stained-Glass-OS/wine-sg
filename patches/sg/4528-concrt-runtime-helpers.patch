+/* ??4?$_SpinWait@$0A@@details@Concurrency@@QEAAAEAV012@AEBV012@@Z */
+DEFINE_THISCALL_WRAPPER(SpinWait_assign, 8)
+SpinWait* __thiscall SpinWait_assign(SpinWait *this, const SpinWait *rhs)
+{
+    TRACE("(%p %p)\n", this, rhs);
+#ifndef SG_MUTANT_SPINWAIT_ASSIGN_NOP
+    *this = *rhs;
+#endif
+    return this;
+}
+
+typedef struct
+{
+    LONG *flag;
+} _SpinLock;
+
+/* ??0_SpinLock@details@Concurrency@@QAE@ACJ@Z */
+/* ??0_SpinLock@details@Concurrency@@QEAA@AECJ@Z */
+DEFINE_THISCALL_WRAPPER(_SpinLock_ctor, 8)
+_SpinLock* __thiscall _SpinLock_ctor(_SpinLock *this, LONG *flag)
+{
+    SpinWait sw;
+
+    TRACE("(%p %p)\n", this, flag);
+
+    this->flag = flag;
+    SpinWait_ctor(&sw, &spin_wait_yield);
+    SpinWait__Reset(&sw);
+    while (InterlockedCompareExchange(flag, 1, 0))
+        SpinWait__SpinOnce(&sw);
+    SpinWait_dtor(&sw);
+    return this;
+}
+
+/* ??1_SpinLock@details@Concurrency@@QAE@XZ */
+/* ??1_SpinLock@details@Concurrency@@QEAA@XZ */
+DEFINE_THISCALL_WRAPPER(_SpinLock_dtor, 4)
+void __thiscall _SpinLock_dtor(_SpinLock *this)
+{
+    TRACE("(%p)\n", this);
+    InterlockedExchange(this->flag, 0);
+}
