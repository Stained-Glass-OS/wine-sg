+/* the values of IResourceManager::OSVersion */
+enum resource_manager_os_version
+{
+    OSVERSION_XP,
+    OSVERSION_VISTA,
+    OSVERSION_WIN7_OR_LATER,
+    OSVERSION_UMS_THREAD_AWARE,
+    OSVERSION_WIN8_OR_LATER,
+};
+
+/* ?GetOSVersion@Concurrency@@YA?AW4OSVersion@IResourceManager@1@XZ */
+enum resource_manager_os_version __cdecl GetOSVersion(void)
+{
+    OSVERSIONINFOW info = {sizeof(info)};
+
+    TRACE("()\n");
+    GetVersionExW(&info);
+    if (info.dwMajorVersion > 6 || (info.dwMajorVersion == 6 && info.dwMinorVersion >= 2))
+        return OSVERSION_WIN8_OR_LATER;
+    if (info.dwMajorVersion == 6 && info.dwMinorVersion == 1)
+        return sizeof(void *) == 8 ? OSVERSION_UMS_THREAD_AWARE : OSVERSION_WIN7_OR_LATER;
+    if (info.dwMajorVersion == 6) return OSVERSION_VISTA;
+    return OSVERSION_XP;
+}
