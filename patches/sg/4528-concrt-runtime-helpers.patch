+/* ?GetSharedTimerQueue@details@Concurrency@@YAPAXXZ */
+/* ?GetSharedTimerQueue@details@Concurrency@@YAPEAXXZ */
+void * __cdecl GetSharedTimerQueue(void)
+{
+    static HANDLE queue;
+
+    TRACE("()\n");
+    if (!queue)
+    {
+        HANDLE q = CreateTimerQueue();
+        if (q && InterlockedCompareExchangePointer(&queue, q, NULL)) DeleteTimerQueue(q);
+    }
+    return queue;
+}
