+/* ?Log2@details@Concurrency@@YAKI@Z */
+/* ?Log2@details@Concurrency@@YAK_K@Z */
+/* the index of the highest bit set */
+ULONG __cdecl Concurrency_Log2(ULONG64 n)
+{
+    ULONG r = 0;
+
+    while (n >>= 1) r++;
+    return r;
+}
+
+ULONG __cdecl Concurrency_Log2_32(unsigned int n)
+{
+    return Concurrency_Log2(n);
+}
