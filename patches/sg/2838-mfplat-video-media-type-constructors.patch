From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfplat: MFCreateVideoMediaTypeFromVideoInfoHeader, ...VideoInfoHeader2, ...BitMapInfoHeader, ...BitMapInfoHeaderEx

- MFCreateVideoMediaTypeFromVideoInfoHeader (E_NOTIMPL): validates the header
  (E_INVALIDARG), takes the subtype from the bit depth when it is NULL or
  GUID_NULL, and sets the pixel aspect ratio, the interlace mode and the
  video flags (pad control, content hint, DRM flags). dlls/mfplat/tests is the
  ground truth (their todo_wine marks are removed).
- MFCreateVideoMediaTypeFromVideoInfoHeader2, MFCreateVideoMediaTypeFromBitMapInfoHeader
  and ...Ex ("@ stub" exports): the same for a VIDEOINFOHEADER2 and for a bare
  BITMAPINFOHEADER (the subtype from the bit depth for RGB, from the FOURCC
  otherwise; frame rate and bit rate when given).

---
diff --git a/dlls/mfplat/mediatype.c b/dlls/mfplat/mediatype.c
index d444d2d..67b7e6a 100644
--- a/dlls/mfplat/mediatype.c
+++ b/dlls/mfplat/mediatype.c
@@ -3832,6 +3832,146 @@ HRESULT WINAPI MFCreateVideoMediaType(const MFVIDEOFORMAT *format, IMFVideoMedia
     return hr;
 }
 
+static void set_video_flags_attributes(IMFMediaType *media_type, QWORD video_flags, HRESULT *hr)
+{
+    UINT32 value;
+
+#ifdef SG_MUTANT_MFMT_NO_FLAGS
+    return;
+#endif
+    if ((value = video_flags & MFVideoFlag_PAD_TO_Mask))
+        mediatype_set_uint32(media_type, &MF_MT_PAD_CONTROL_FLAGS, value, hr);
+    if ((value = video_flags & MFVideoFlag_SrcContentHintMask))
+        mediatype_set_uint32(media_type, &MF_MT_SOURCE_CONTENT_HINT, value >> 2, hr);
+    if ((value = video_flags & (MFVideoFlag_AnalogProtected | MFVideoFlag_DigitallyProtected)))
+        mediatype_set_uint32(media_type, &MF_MT_DRM_FLAGS, value >> 5, hr);
+}
+
+/***********************************************************************
+ *      MFCreateVideoMediaTypeFromVideoInfoHeader2 (mfplat.@)
+ */
+HRESULT WINAPI MFCreateVideoMediaTypeFromVideoInfoHeader2(const VIDEOINFOHEADER2 *vih, DWORD size, QWORD video_flags,
+        const GUID *subtype, IMFVideoMediaType **ret)
+{
+    struct media_type *object;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %I64x, %s, %p.\n", vih, size, video_flags, debugstr_guid(subtype), ret);
+
+    if (!vih || !ret || size < sizeof(*vih) || vih->bmiHeader.biSize < sizeof(vih->bmiHeader))
+        return E_INVALIDARG;
+
+    if (subtype && IsEqualGUID(subtype, &GUID_NULL))
+        subtype = NULL;
+
+    if (FAILED(hr = create_media_type(&object)))
+        return hr;
+
+    if (SUCCEEDED(hr = MFInitMediaTypeFromVideoInfoHeader2(&object->IMFMediaType_iface, vih,
+            size, subtype)))
+        set_video_flags_attributes(&object->IMFMediaType_iface, video_flags, &hr);
+
+    if (FAILED(hr))
+    {
+        IMFMediaType_Release(&object->IMFMediaType_iface);
+        return hr;
+    }
+
+    *ret = &object->IMFVideoMediaType_iface;
+
+    return S_OK;
+}
+
+static HRESULT create_video_media_type_from_bitmap_info_header(const BITMAPINFOHEADER *bih, UINT32 size, DWORD par_x,
+        DWORD par_y, MFVideoInterlaceMode interlace_mode, QWORD video_flags, QWORD fps_numerator, QWORD fps_denominator,
+        DWORD max_bitrate, IMFVideoMediaType **ret)
+{
+    GUID subtype = MFVideoFormat_Base;
+    const GUID *subtype_ptr = NULL;
+    struct media_type *object;
+    VIDEOINFOHEADER2 vih2;
+    HRESULT hr;
+
+    if (!bih || !ret || size < sizeof(*bih) || bih->biSize < sizeof(*bih))
+        return E_INVALIDARG;
+
+    memset(&vih2, 0, sizeof(vih2));
+    vih2.bmiHeader = *bih;
+    vih2.dwBitRate = max_bitrate;
+
+    /* uncompressed RGB formats are told by their bit depth, the others by their FOURCC */
+#ifdef SG_MUTANT_MFMT_FOURCC
+    if (0)
+#else
+    if (bih->biCompression != BI_RGB && bih->biCompression != BI_BITFIELDS)
+#endif
+    {
+        subtype.Data1 = bih->biCompression;
+        subtype_ptr = &subtype;
+    }
+
+    if (FAILED(hr = create_media_type(&object)))
+        return hr;
+
+    if (SUCCEEDED(hr = MFInitMediaTypeFromVideoInfoHeader2(&object->IMFMediaType_iface, &vih2, sizeof(vih2),
+            subtype_ptr)))
+    {
+#ifndef SG_MUTANT_MFMT_NO_PAR
+        if (par_x && par_y)
+            mediatype_set_uint64(&object->IMFMediaType_iface, &MF_MT_PIXEL_ASPECT_RATIO, par_x, par_y, &hr);
+#endif
+        mediatype_set_uint32(&object->IMFMediaType_iface, &MF_MT_INTERLACE_MODE, interlace_mode, &hr);
+#ifdef SG_MUTANT_MFMT_NO_FPS
+        if (0)
+#else
+        if (fps_numerator && fps_denominator)
+#endif
+            mediatype_set_uint64(&object->IMFMediaType_iface, &MF_MT_FRAME_RATE, fps_numerator, fps_denominator, &hr);
+        if (max_bitrate)
+            mediatype_set_uint32(&object->IMFMediaType_iface, &MF_MT_AVG_BITRATE, max_bitrate, &hr);
+        set_video_flags_attributes(&object->IMFMediaType_iface, video_flags, &hr);
+    }
+
+    if (FAILED(hr))
+    {
+        IMFMediaType_Release(&object->IMFMediaType_iface);
+        return hr;
+    }
+
+    *ret = &object->IMFVideoMediaType_iface;
+
+    return S_OK;
+}
+
+/***********************************************************************
+ *      MFCreateVideoMediaTypeFromBitMapInfoHeader (mfplat.@)
+ */
+HRESULT WINAPI MFCreateVideoMediaTypeFromBitMapInfoHeader(const BITMAPINFOHEADER *bih, DWORD par_x, DWORD par_y,
+        MFVideoInterlaceMode interlace_mode, QWORD video_flags, QWORD fps_numerator, QWORD fps_denominator,
+        DWORD max_bitrate, IMFVideoMediaType **ret)
+{
+    TRACE("%p, %lu, %lu, %d, %I64x, %I64u, %I64u, %lu, %p.\n", bih, par_x, par_y, interlace_mode, video_flags,
+            fps_numerator, fps_denominator, max_bitrate, ret);
+
+    /* this variant does not tell the size of the header: it is at least the common part */
+    return create_video_media_type_from_bitmap_info_header(bih, bih ? bih->biSize : 0, par_x, par_y, interlace_mode,
+            video_flags, fps_numerator, fps_denominator, max_bitrate, ret);
+}
+
+/***********************************************************************
+ *      MFCreateVideoMediaTypeFromBitMapInfoHeaderEx (mfplat.@)
+ */
+HRESULT WINAPI MFCreateVideoMediaTypeFromBitMapInfoHeaderEx(const BITMAPINFOHEADER *bih, UINT32 size, DWORD par_x,
+        DWORD par_y, MFVideoInterlaceMode interlace_mode, QWORD video_flags, DWORD fps_numerator,
+        DWORD fps_denominator, DWORD max_bitrate, IMFVideoMediaType **ret)
+{
+    TRACE("%p, %u, %lu, %lu, %d, %I64x, %lu, %lu, %lu, %p.\n", bih, size, par_x, par_y, interlace_mode, video_flags,
+            fps_numerator, fps_denominator, max_bitrate, ret);
+
+    return create_video_media_type_from_bitmap_info_header(bih, size, par_x, par_y, interlace_mode, video_flags,
+            fps_numerator, fps_denominator, max_bitrate, ret);
+}
+
 /***********************************************************************
  *      MFCreateVideoMediaTypeFromVideoInfoHeader (mfplat.@)
  */
@@ -3839,10 +3979,41 @@ HRESULT WINAPI MFCreateVideoMediaTypeFromVideoInfoHeader(const KS_VIDEOINFOHEADE
         DWORD pixel_aspect_ratio_y, MFVideoInterlaceMode interlace_mode, QWORD video_flags, const GUID *subtype,
         IMFVideoMediaType **ret)
 {
-    FIXME("%p, %lu, %lu, %lu, %d, %I64x, %s, %p.\n", vih, size, pixel_aspect_ratio_x, pixel_aspect_ratio_y, interlace_mode,
+    struct media_type *object;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %lu, %lu, %d, %I64x, %s, %p.\n", vih, size, pixel_aspect_ratio_x, pixel_aspect_ratio_y, interlace_mode,
             video_flags, debugstr_guid(subtype), ret);
 
-    return E_NOTIMPL;
+    if (!vih || !ret || size < sizeof(*vih) || vih->bmiHeader.biSize < sizeof(vih->bmiHeader))
+        return E_INVALIDARG;
+
+    /* no subtype, or a null one: it comes from the bit depth */
+    if (subtype && IsEqualGUID(subtype, &GUID_NULL))
+        subtype = NULL;
+
+    if (FAILED(hr = create_media_type(&object)))
+        return hr;
+
+    if (SUCCEEDED(hr = MFInitMediaTypeFromVideoInfoHeader(&object->IMFMediaType_iface, (const VIDEOINFOHEADER *)vih,
+            size, subtype)))
+    {
+        if (pixel_aspect_ratio_x && pixel_aspect_ratio_y)
+            mediatype_set_uint64(&object->IMFMediaType_iface, &MF_MT_PIXEL_ASPECT_RATIO, pixel_aspect_ratio_x,
+                    pixel_aspect_ratio_y, &hr);
+        mediatype_set_uint32(&object->IMFMediaType_iface, &MF_MT_INTERLACE_MODE, interlace_mode, &hr);
+        set_video_flags_attributes(&object->IMFMediaType_iface, video_flags, &hr);
+    }
+
+    if (FAILED(hr))
+    {
+        IMFMediaType_Release(&object->IMFMediaType_iface);
+        return hr;
+    }
+
+    *ret = &object->IMFVideoMediaType_iface;
+
+    return S_OK;
 }
 
 /***********************************************************************
