From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: an inherited Unix pipe answers the named pipe queries

A program started from a Linux shell with its output piped got a standard handle that GetFileType calls a pipe,
but SetNamedPipeHandleState failed with ERROR_INVALID_HANDLE and GetNamedPipeHandleState / GetNamedPipeInfo with
ERROR_INVALID_FUNCTION, where a Windows anonymous pipe (a named pipe) answers them. libuv gives up on such a
handle: Node.js and npm died with 'Error: open EBADF' writing to stdout or stderr. A Unix pipe or socket now
answers FilePipeInformation and FilePipeLocalInformation as a connected byte-mode pipe (its direction from its
access mode, the bytes waiting from FIONREAD), and setting byte mode with blocking succeeds.
---
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index b5775b0..0076064 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5473,6 +5473,43 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         }
         break;
 #endif
+    case FilePipeInformation:
+    case FilePipeLocalInformation:
+        /* Stained Glass OS: a Unix pipe or socket a program inherited as its
+         * standard handle (started from a Linux shell, its output piped):
+         * Windows' anonymous pipes are named pipes and answer these, and
+         * libuv (Node.js) gives up on the handle when they fail */
+#ifndef SG_MUTANT_UNIX_PIPE_INFO
+        if (fstat( fd, &st ) != -1 && (S_ISFIFO(st.st_mode) || S_ISSOCK(st.st_mode)))
+        {
+            int flags = fcntl( fd, F_GETFL ), avail = 0;
+            if (class == FilePipeInformation)
+            {
+                FILE_PIPE_INFORMATION *info = ptr;
+                info->ReadMode = FILE_PIPE_BYTE_STREAM_MODE;
+                info->CompletionMode = (flags != -1 && (flags & O_NONBLOCK)) ? FILE_PIPE_COMPLETE_OPERATION
+                                                                           : FILE_PIPE_QUEUE_OPERATION;
+            }
+            else
+            {
+                FILE_PIPE_LOCAL_INFORMATION *info = ptr;
+                memset( info, 0, sizeof(*info) );
+                info->NamedPipeType = FILE_PIPE_TYPE_BYTE;
+                info->NamedPipeConfiguration = S_ISSOCK(st.st_mode) ? FILE_PIPE_FULL_DUPLEX :
+                    (flags != -1 && (flags & O_ACCMODE) == O_RDONLY) ? FILE_PIPE_OUTBOUND : FILE_PIPE_INBOUND;
+                info->MaximumInstances = 1;
+                info->CurrentInstances = 1;
+                info->InboundQuota = info->OutboundQuota = 65536;
+                if (ioctl( fd, FIONREAD, &avail ) != -1) info->ReadDataAvailable = avail;
+                info->WriteQuotaAvailable = 65536;
+                info->NamedPipeState = FILE_PIPE_CONNECTED_STATE;
+                info->NamedPipeEnd = FILE_PIPE_CLIENT_END;
+            }
+            break;
+        }
+#endif
+        status = STATUS_INVALID_PARAMETER;
+        break;
     default:
         FIXME("Unsupported class (%d)\n", class);
         status = STATUS_NOT_IMPLEMENTED;
@@ -5665,6 +5702,21 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
                 status = wine_server_call( req );
             }
             SERVER_END_REQ;
+#ifndef SG_MUTANT_UNIX_PIPE_INFO
+            if (status == STATUS_OBJECT_TYPE_MISMATCH || status == STATUS_INVALID_HANDLE)
+            {
+                /* Stained Glass OS: an inherited Unix pipe or socket is a byte
+                 * stream that blocks: setting just that is done */
+                int fd, needs_close;
+                struct stat st;
+                if (!server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL ))
+                {
+                    if (fstat( fd, &st ) != -1 && (S_ISFIFO(st.st_mode) || S_ISSOCK(st.st_mode)))
+                        status = (!info->ReadMode && !info->CompletionMode) ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
+                    if (needs_close) close( fd );
+                }
+            }
+#endif
         }
         else status = SET_INFO_SHORT;
         break;
