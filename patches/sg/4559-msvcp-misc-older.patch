+DWORD __cdecl _GetCurrentThreadId(void)
+{
+    TRACE("()\n");
+#ifdef SG_MUTANT_CONCRT_THREAD_ID_PROCESS
+    return GetCurrentProcessId();
+#endif
+    return GetCurrentThreadId();
+}
+#endif
