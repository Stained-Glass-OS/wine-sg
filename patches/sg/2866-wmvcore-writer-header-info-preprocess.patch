+HRESULT writer_header_create(IUnknown *outer, struct writer_header **out)
+{
+    struct writer_header *header;
+
+    if (!(header = calloc(1, sizeof(*header))))
+        return E_OUTOFMEMORY;
+    header->IWMHeaderInfo3_iface.lpVtbl = &header_vtbl;
+    header->outer = outer;
+    InitializeCriticalSectionEx(&header->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    header->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": writer_header.cs");
+    *out = header;
+    return S_OK;
+}
+
+IWMHeaderInfo3 *writer_header_iface(struct writer_header *header)
+{
+    return &header->IWMHeaderInfo3_iface;
+}
+
+void writer_header_destroy(struct writer_header *header)
+{
+    unsigned int i;
+
+    for (i = 0; i < header->attr_count; ++i)
+        attribute_clear(&header->attrs[i]);
+    free(header->attrs);
+    for (i = 0; i < header->marker_count; ++i)
+        free(header->markers[i].name);
+    free(header->markers);
+    for (i = 0; i < header->script_count; ++i)
+    {
+        free(header->scripts[i].type);
+        free(header->scripts[i].command);
+    }
+    free(header->scripts);
+    for (i = 0; i < header->codec_count; ++i)
+    {
+        free(header->codecs[i].name);
+        free(header->codecs[i].description);
+        free(header->codecs[i].info);
+    }
+    free(header->codecs);
+    header->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection(&header->cs);
+    free(header);
+}
