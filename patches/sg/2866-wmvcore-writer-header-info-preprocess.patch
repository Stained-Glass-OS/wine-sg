+static HRESULT WINAPI header_GetAttributeCountEx(IWMHeaderInfo3 *iface, WORD stream, WORD *count)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    unsigned int i, n = 0;
+
+    TRACE("iface %p, stream %u, count %p.\n", iface, stream, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    EnterCriticalSection(&header->cs);
+    for (i = 0; i < header->attr_count; ++i)
+        n += stream == ALL_STREAMS || header->attrs[i].stream == stream;
+    LeaveCriticalSection(&header->cs);
+    *count = n;
+    return S_OK;
+}
+
+static HRESULT WINAPI header_GetAttributeIndices(IWMHeaderInfo3 *iface, WORD stream, const WCHAR *name,
+        WORD *lang, WORD *indices, WORD *count)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    WORD n = 0, index = 0, requested;
+    unsigned int i;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, stream %u, name %s, lang %p, indices %p, count %p.\n",
+            iface, stream, debugstr_w(name), lang, indices, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    requested = *count;
+    EnterCriticalSection(&header->cs);
+    for (i = 0; i < header->attr_count; ++i)
+    {
+        struct attribute *attr = &header->attrs[i];
+
+        if (stream != ALL_STREAMS && attr->stream != stream)
+            continue;
+        if (name && wcsicmp(attr->name, name))
+        {
+            ++index;
+            continue;
+        }
+        if (lang && attr->lang != *lang)
+        {
+            ++index;
+            continue;
+        }
+        if (indices && n < requested)
+            indices[n] = index;
+        ++n;
+        ++index;
+    }
+    LeaveCriticalSection(&header->cs);
+    if (indices && requested < n)
+        hr = ASF_E_BUFFERTOOSMALL;
+    *count = n;
+    return hr;
+}
