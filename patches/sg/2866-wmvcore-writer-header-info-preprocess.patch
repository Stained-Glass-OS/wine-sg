+static HRESULT WINAPI header_DeleteAttribute(IWMHeaderInfo3 *iface, WORD stream, WORD index)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    struct attribute *attr;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, stream %u, index %u.\n", iface, stream, index);
+
+    EnterCriticalSection(&header->cs);
+    if (!(attr = find_by_index(header, stream, index)))
+        hr = E_INVALIDARG;
+    else
+    {
+        attribute_clear(attr);
+        memmove(attr, attr + 1, (&header->attrs[header->attr_count] - (attr + 1)) * sizeof(*attr));
+        --header->attr_count;
+    }
+    LeaveCriticalSection(&header->cs);
+    return hr;
+}
+
+static HRESULT WINAPI header_AddCodecInfo(IWMHeaderInfo3 *iface, const WCHAR *name, const WCHAR *description,
+        WMT_CODEC_INFO_TYPE type, WORD info_size, BYTE *info)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    struct codec_info *codecs, codec = {0};
+
+    TRACE("iface %p, name %s, description %s, type %#x, info_size %u, info %p.\n",
+            iface, debugstr_w(name), debugstr_w(description), type, info_size, info);
+
+    if (!name || !description || (info_size && !info))
+        return E_INVALIDARG;
+    codec.name = wcsdup(name);
+    codec.description = wcsdup(description);
+    codec.type = type;
+    codec.info_size = info_size;
+    if (info_size)
+        codec.info = malloc(info_size);
+    if (!codec.name || !codec.description || (info_size && !codec.info))
+        goto oom;
+    if (info_size)
+        memcpy(codec.info, info, info_size);
+
+    EnterCriticalSection(&header->cs);
+    if (!(codecs = realloc(header->codecs, (header->codec_count + 1) * sizeof(*codecs))))
+    {
+        LeaveCriticalSection(&header->cs);
+        goto oom;
+    }
+    header->codecs = codecs;
+    codecs[header->codec_count++] = codec;
+    LeaveCriticalSection(&header->cs);
+    return S_OK;
+
+oom:
+    free(codec.name);
+    free(codec.description);
+    free(codec.info);
+    return E_OUTOFMEMORY;
+}
