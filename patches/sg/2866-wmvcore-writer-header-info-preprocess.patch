+static HRESULT WINAPI header_GetCodecInfo(IWMHeaderInfo3 *iface, DWORD index, WORD *name_len, WCHAR *name,
+        WORD *description_len, WCHAR *description, WMT_CODEC_INFO_TYPE *type, WORD *info_size, BYTE *info)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, index %lu, name_len %p, name %p, description_len %p, description %p, type %p, info_size %p, info %p.\n",
+            iface, index, name_len, name, description_len, description, type, info_size, info);
+
+    if (!name_len || !description_len || !type || !info_size)
+        return E_INVALIDARG;
+    EnterCriticalSection(&header->cs);
+    if (index >= header->codec_count)
+        hr = E_INVALIDARG;
+    else
+    {
+        struct codec_info *codec = &header->codecs[index];
+        DWORD size = *info_size;
+        HRESULT hr2;
+
+        hr = copy_string_out(codec->name, name, name_len);
+        hr2 = copy_string_out(codec->description, description, description_len);
+        if (SUCCEEDED(hr))
+            hr = hr2;
+        hr2 = copy_out(codec->info, codec->info_size, info, &size);
+        *info_size = size;
+        if (SUCCEEDED(hr))
+            hr = hr2;
+        *type = codec->type;
+    }
+    LeaveCriticalSection(&header->cs);
+    return hr;
+}
