+static HRESULT WINAPI header_AddScript(IWMHeaderInfo3 *iface, const WCHAR *type, const WCHAR *command, QWORD time)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    struct script *scripts, script;
+    unsigned int i;
+
+    TRACE("iface %p, type %s, command %s, time %s.\n", iface, debugstr_w(type), debugstr_w(command),
+            wine_dbgstr_longlong(time));
+
+    if (!type || !command)
+        return E_INVALIDARG;
+    script.type = wcsdup(type);
+    script.command = wcsdup(command);
+    script.time = time;
+    if (!script.type || !script.command)
+    {
+        free(script.type);
+        free(script.command);
+        return E_OUTOFMEMORY;
+    }
+
+    EnterCriticalSection(&header->cs);
+    if (!(scripts = realloc(header->scripts, (header->script_count + 1) * sizeof(*scripts))))
+    {
+        LeaveCriticalSection(&header->cs);
+        free(script.type);
+        free(script.command);
+        return E_OUTOFMEMORY;
+    }
+    header->scripts = scripts;
+    for (i = header->script_count; i && scripts[i - 1].time > time; --i)
+        scripts[i] = scripts[i - 1];
+    scripts[i] = script;
+    ++header->script_count;
+    LeaveCriticalSection(&header->cs);
+    return S_OK;
+}
