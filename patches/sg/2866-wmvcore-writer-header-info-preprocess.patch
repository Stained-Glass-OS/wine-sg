+static HRESULT WINAPI header_GetAttributeByIndexEx(IWMHeaderInfo3 *iface, WORD stream, WORD index, WCHAR *name,
+        WORD *name_len, WMT_ATTR_DATATYPE *type, WORD *lang, BYTE *value, DWORD *length)
+{
