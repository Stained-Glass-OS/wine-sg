-    todo_wine check_interface(writer, &IID_IWMWriterPreprocess, TRUE);
-    todo_wine check_interface(writer, &IID_IWMHeaderInfo, TRUE);
-    todo_wine check_interface(writer, &IID_IWMHeaderInfo2, TRUE);
-    todo_wine check_interface(writer, &IID_IWMHeaderInfo3, TRUE);
+    check_interface(writer, &IID_IWMWriterPreprocess, TRUE);
+    check_interface(writer, &IID_IWMHeaderInfo, TRUE);
+    check_interface(writer, &IID_IWMHeaderInfo2, TRUE);
+    check_interface(writer, &IID_IWMHeaderInfo3, TRUE);
 
     IWMWriter_Release(writer);
 }
diff --git a/dlls/wmvcore/writer.c b/dlls/wmvcore/writer.c
index fe023f7..6d11d24 100644
--- a/dlls/wmvcore/writer.c
+++ b/dlls/wmvcore/writer.c
@@ -38,6 +38,8 @@ struct writer_input
 typedef struct {
     IWMWriter IWMWriter_iface;
     IWMWriterAdvanced3 IWMWriterAdvanced3_iface;
+    IWMWriterPreprocess IWMWriterPreprocess_iface;
+    struct writer_header *header;
     LONG ref;
 
     CRITICAL_SECTION cs;
@@ -78,6 +80,13 @@ static HRESULT WINAPI WMWriter_QueryInterface(IWMWriter *iface, REFIID riid, voi
     }else if(IsEqualGUID(&IID_IWMWriterAdvanced3, riid)) {
         TRACE("(%p)->(IID_IWMWriterAdvanced3 %p)\n", This, ppv);
         *ppv = &This->IWMWriterAdvanced3_iface;
+    }else if(IsEqualGUID(&IID_IWMWriterPreprocess, riid)) {
+        TRACE("(%p)->(IID_IWMWriterPreprocess %p)\n", This, ppv);
+        *ppv = &This->IWMWriterPreprocess_iface;
+    }else if(IsEqualGUID(&IID_IWMHeaderInfo, riid) || IsEqualGUID(&IID_IWMHeaderInfo2, riid)
+            || IsEqualGUID(&IID_IWMHeaderInfo3, riid)) {
+        TRACE("(%p)->(%s %p)\n", This, debugstr_guid(riid), ppv);
+        *ppv = writer_header_iface(This->header);
     }else {
         WARN("Unsupported iface %s\n", debugstr_guid(riid));
         *ppv = NULL;
@@ -115,6 +124,7 @@ static ULONG WINAPI WMWriter_Release(IWMWriter *iface)
         if (This->profile)
             IWMProfile3_Release(This->profile);
         free(This->filename);
+        writer_header_destroy(This->header);
         This->cs.DebugInfo->Spare[0] = 0;
         DeleteCriticalSection(&This->cs);
         free(This);
@@ -773,6 +783,128 @@ static const IWMWriterVtbl WMWriterVtbl = {
     WMWriter_Flush
 };
 
+static inline WMWriter *impl_from_IWMWriterPreprocess(IWMWriterPreprocess *iface)
+{
+    return CONTAINING_RECORD(iface, WMWriter, IWMWriterPreprocess_iface);
+}
+
+static HRESULT WINAPI WMWriterPreprocess_QueryInterface(IWMWriterPreprocess *iface, REFIID riid, void **ppv)
+{
+    WMWriter *This = impl_from_IWMWriterPreprocess(iface);
+    return IWMWriter_QueryInterface(&This->IWMWriter_iface, riid, ppv);
+}
+
+static ULONG WINAPI WMWriterPreprocess_AddRef(IWMWriterPreprocess *iface)
+{
+    WMWriter *This = impl_from_IWMWriterPreprocess(iface);
+    return IWMWriter_AddRef(&This->IWMWriter_iface);
+}
+
+static ULONG WINAPI WMWriterPreprocess_Release(IWMWriterPreprocess *iface)
+{
+    WMWriter *This = impl_from_IWMWriterPreprocess(iface);
+    return IWMWriter_Release(&This->IWMWriter_iface);
+}
+
+/* The input checks shared by the preprocessing calls. */
+static HRESULT preprocess_check(WMWriter *This, DWORD input, DWORD flags)
+{
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&This->cs);
+    if (!This->profile)
+        hr = NS_E_INVALIDPROFILE;
+#ifdef SG_MUTANT_WMVW_PRE_FLAGS
+    else if (input >= This->input_count)
+#else
+    else if (input >= This->input_count || flags)
+#endif
+        hr = E_INVALIDARG;
+    LeaveCriticalSection(&This->cs);
+    return hr;
+}
+
+static HRESULT WINAPI WMWriterPreprocess_GetMaxPreprocessingPasses(IWMWriterPreprocess *iface, DWORD input,
+        DWORD flags, DWORD *passes)
+{
+    WMWriter *This = impl_from_IWMWriterPreprocess(iface);
+    HRESULT hr;
+
+    TRACE("(%p)->(%lu %#lx %p)\n", This, input, flags, passes);
+
+    if (!passes)
+        return E_INVALIDARG;
+    if (FAILED(hr = preprocess_check(This, input, flags)))
+        return hr;
+    /* None of the formats listed for the inputs is encoded by a multi-pass codec. */
+    *passes = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI WMWriterPreprocess_SetNumPreprocessingPasses(IWMWriterPreprocess *iface, DWORD input,
+        DWORD flags, DWORD passes)
+{
+    WMWriter *This = impl_from_IWMWriterPreprocess(iface);
+    HRESULT hr;
+
+    TRACE("(%p)->(%lu %#lx %lu)\n", This, input, flags, passes);
+
+    if (FAILED(hr = preprocess_check(This, input, flags)))
+        return hr;
+    return passes ? E_INVALIDARG : S_OK;
+}
+
+static HRESULT WINAPI WMWriterPreprocess_BeginPreprocessingPass(IWMWriterPreprocess *iface, DWORD input, DWORD flags)
+{
+    WMWriter *This = impl_from_IWMWriterPreprocess(iface);
+    HRESULT hr;
+
+    TRACE("(%p)->(%lu %#lx)\n", This, input, flags);
+
+    if (FAILED(hr = preprocess_check(This, input, flags)))
+        return hr;
+    /* No pass was requested, as the inputs allow none. */
+    return NS_E_INVALID_REQUEST;
+}
+
+static HRESULT WINAPI WMWriterPreprocess_PreprocessSample(IWMWriterPreprocess *iface, DWORD input,
+        QWORD sample_time, DWORD flags, INSSBuffer *sample)
+{
+    WMWriter *This = impl_from_IWMWriterPreprocess(iface);
+    HRESULT hr;
+
+    TRACE("(%p)->(%lu %s %#lx %p)\n", This, input, wine_dbgstr_longlong(sample_time), flags, sample);
+
+    if (!sample)
+        return E_INVALIDARG;
+    if (FAILED(hr = preprocess_check(This, input, 0)))
+        return hr;
+    return NS_E_INVALID_REQUEST;
+}
+
+static HRESULT WINAPI WMWriterPreprocess_EndPreprocessingPass(IWMWriterPreprocess *iface, DWORD input, DWORD flags)
+{
+    WMWriter *This = impl_from_IWMWriterPreprocess(iface);
+    HRESULT hr;
+
+    TRACE("(%p)->(%lu %#lx)\n", This, input, flags);
+
+    if (FAILED(hr = preprocess_check(This, input, flags)))
+        return hr;
+    return NS_E_INVALID_REQUEST;
+}
+
+static const IWMWriterPreprocessVtbl WMWriterPreprocessVtbl = {
+    WMWriterPreprocess_QueryInterface,
+    WMWriterPreprocess_AddRef,
+    WMWriterPreprocess_Release,
+    WMWriterPreprocess_GetMaxPreprocessingPasses,
+    WMWriterPreprocess_SetNumPreprocessingPasses,
+    WMWriterPreprocess_BeginPreprocessingPass,
+    WMWriterPreprocess_PreprocessSample,
+    WMWriterPreprocess_EndPreprocessingPass
+};
+
 static inline WMWriter *impl_from_IWMWriterAdvanced3(IWMWriterAdvanced3 *iface)
 {
     return CONTAINING_RECORD(iface, WMWriter, IWMWriterAdvanced3_iface);
@@ -1039,8 +1171,17 @@ HRESULT WINAPI WMCreateWriter(IUnknown *reserved, IWMWriter **writer)
 
     ret->IWMWriter_iface.lpVtbl = &WMWriterVtbl;
     ret->IWMWriterAdvanced3_iface.lpVtbl = &WMWriterAdvanced3Vtbl;
+    ret->IWMWriterPreprocess_iface.lpVtbl = &WMWriterPreprocessVtbl;
     ret->ref = 1;
 
+    if (FAILED(writer_header_create((IUnknown *)&ret->IWMWriter_iface, &ret->header)))
+    {
+        ret->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&ret->cs);
+        free(ret);
+        return E_OUTOFMEMORY;
+    }
+
     *writer = &ret->IWMWriter_iface;
     return S_OK;
 }
diff --git a/dlls/wmvcore/writer_header.c b/dlls/wmvcore/writer_header.c
new file mode 100644
index 0000000..ebf5f05
--- /dev/null
+++ b/dlls/wmvcore/writer_header.c
@@ -0,0 +1,830 @@
+/*
+ * IWMHeaderInfo, IWMHeaderInfo2 and IWMHeaderInfo3 of the writer: the
+ * attributes, markers, scripts and codec descriptions that go into the
+ * header of the file being written.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "wmvcore_private.h"
+#include "wmsdk.h"
+#include "asferr.h"
+#include "nserror.h"
+#include "profile.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wmvcore);
+
+#define ALL_STREAMS 0xffff
+#ifdef SG_MUTANT_WMVW_HDR_MARKERORDER
+#define MARKER_APPEND 1
+#else
+#define MARKER_APPEND 0
+#endif
+
+struct attribute
+{
+    WORD stream, lang;
+    WCHAR *name;
+    WMT_ATTR_DATATYPE type;
+    BYTE *value;
+    DWORD length;
+};
+
+struct marker
+{
+    WCHAR *name;
+    QWORD time;
+};
+
+struct script
+{
+    WCHAR *type, *command;
+    QWORD time;
+};
+
+struct codec_info
+{
+    WCHAR *name, *description;
+    WMT_CODEC_INFO_TYPE type;
+    BYTE *info;
+    WORD info_size;
+};
+
+struct writer_header
+{
+    IWMHeaderInfo3 IWMHeaderInfo3_iface;
+    IUnknown *outer;
+    CRITICAL_SECTION cs;
+
+    struct attribute *attrs;
+    unsigned int attr_count;
+    struct marker *markers;
+    unsigned int marker_count;
+    struct script *scripts;
+    unsigned int script_count;
+    struct codec_info *codecs;
+    unsigned int codec_count;
+};
+
+static struct writer_header *impl_from_IWMHeaderInfo3(IWMHeaderInfo3 *iface)
+{
+    return CONTAINING_RECORD(iface, struct writer_header, IWMHeaderInfo3_iface);
+}
+
+static HRESULT WINAPI header_QueryInterface(IWMHeaderInfo3 *iface, REFIID iid, void **out)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    return IUnknown_QueryInterface(header->outer, iid, out);
+}
+
+static ULONG WINAPI header_AddRef(IWMHeaderInfo3 *iface)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    return IUnknown_AddRef(header->outer);
+}
+
+static ULONG WINAPI header_Release(IWMHeaderInfo3 *iface)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    return IUnknown_Release(header->outer);
+}
+
+/* The index-th attribute of the stream, in the order of addition. */
+static struct attribute *find_by_index(struct writer_header *header, WORD stream, WORD index)
+{
+    unsigned int i;
+
+    for (i = 0; i < header->attr_count; ++i)
+    {
+        if (stream != ALL_STREAMS && header->attrs[i].stream != stream)
+            continue;
+        if (!index--)
+            return &header->attrs[i];
+    }
+    return NULL;
+}
+
+static BOOL valid_value(WMT_ATTR_DATATYPE type, const BYTE *value, DWORD length)
+{
+#ifdef SG_MUTANT_WMVW_HDR_TYPECHECK
+    if (type <= WMT_TYPE_GUID)
+        return TRUE;
+#endif
+    if (length && !value)
+        return FALSE;
+    switch (type)
+    {
+        case WMT_TYPE_WORD: return length == sizeof(WORD);
+        case WMT_TYPE_DWORD:
+        case WMT_TYPE_BOOL: return length == sizeof(DWORD);
+        case WMT_TYPE_QWORD: return length == sizeof(QWORD);
+        case WMT_TYPE_GUID: return length == sizeof(GUID);
+        case WMT_TYPE_STRING: return !(length % 2);
+        case WMT_TYPE_BINARY: return TRUE;
+        default: return FALSE;
+    }
+}
+
+static void attribute_clear(struct attribute *attr)
+{
+    free(attr->name);
+    free(attr->value);
+    memset(attr, 0, sizeof(*attr));
+}
+
+static HRESULT attribute_set(struct attribute *attr, WMT_ATTR_DATATYPE type, WORD lang, const BYTE *value, DWORD length)
+{
+    BYTE *copy = NULL;
+
+    if (length)
+    {
+        if (!(copy = malloc(length)))
+            return E_OUTOFMEMORY;
+        memcpy(copy, value, length);
+    }
+    free(attr->value);
+    attr->value = copy;
+    attr->length = length;
+    attr->type = type;
+    attr->lang = lang;
+    return S_OK;
+}
+
+static HRESULT attribute_add(struct writer_header *header, WORD stream, const WCHAR *name, WMT_ATTR_DATATYPE type,
+        WORD lang, const BYTE *value, DWORD length, WORD *index)
+{
+    struct attribute *attrs, *attr;
+    WORD n = 0;
+    unsigned int i;
+    HRESULT hr;
+
+    if (!(attrs = realloc(header->attrs, (header->attr_count + 1) * sizeof(*attrs))))
+        return E_OUTOFMEMORY;
+    header->attrs = attrs;
+    attr = &attrs[header->attr_count];
+    memset(attr, 0, sizeof(*attr));
+    attr->stream = stream;
+    if (!(attr->name = wcsdup(name)))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = attribute_set(attr, type, lang, value, length)))
+    {
+        free(attr->name);
+        return hr;
+    }
+    for (i = 0; i < header->attr_count; ++i)
+        n += attrs[i].stream == stream;
+    ++header->attr_count;
+    if (index)
+        *index = n;
+    return S_OK;
+}
+
+/* Copies a string or blob out through the SDK's size protocol. */
+static HRESULT copy_out(const void *src, DWORD size, void *dst, DWORD *dst_size)
+{
+    DWORD requested = *dst_size;
+
+    *dst_size = size;
+    if (!dst)
+        return S_OK;
+    if (requested < size)
+        return ASF_E_BUFFERTOOSMALL;
+    if (size)
+        memcpy(dst, src, size);
+    return S_OK;
+}
+
+static HRESULT copy_string_out(const WCHAR *str, WCHAR *dst, WORD *len)
+{
+    DWORD size = *len * sizeof(WCHAR);
+    HRESULT hr = copy_out(str, (wcslen(str) + 1) * sizeof(WCHAR), dst, &size);
+
+    *len = size / sizeof(WCHAR);
+    return hr;
+}
+
+static HRESULT read_attribute(struct attribute *attr, WCHAR *name, WORD *name_len, WMT_ATTR_DATATYPE *type,
+        WORD *lang, BYTE *value, DWORD *length)
+{
+    HRESULT hr = S_OK, hr2;
+
+    if (name_len)
+        hr = copy_string_out(attr->name, name, name_len);
+    if (type)
+        *type = attr->type;
+    if (lang)
+        *lang = attr->lang;
+    if (length)
+    {
+        hr2 = copy_out(attr->value, attr->length, value, length);
+        if (SUCCEEDED(hr))
+            hr = hr2;
+    }
+    return hr;
+}
+
+static HRESULT WINAPI header_GetAttributeCount(IWMHeaderInfo3 *iface, WORD stream, WORD *count)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    unsigned int i, n = 0;
+
+    TRACE("iface %p, stream %u, count %p.\n", iface, stream, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    EnterCriticalSection(&header->cs);
+    for (i = 0; i < header->attr_count; ++i)
+        n += header->attrs[i].stream == stream;
+    LeaveCriticalSection(&header->cs);
+    *count = n;
+    return S_OK;
+}
+
+static HRESULT WINAPI header_GetAttributeByIndex(IWMHeaderInfo3 *iface, WORD index, WORD *stream, WCHAR *name,
+        WORD *name_len, WMT_ATTR_DATATYPE *type, BYTE *value, WORD *length)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    struct attribute *attr;
+    DWORD size;
+    HRESULT hr;
+
+    TRACE("iface %p, index %u, stream %p, name %p, name_len %p, type %p, value %p, length %p.\n",
+            iface, index, stream, name, name_len, type, value, length);
+
+    if (!stream || !name_len || !length)
+        return E_INVALIDARG;
+    EnterCriticalSection(&header->cs);
+    if (!(attr = find_by_index(header, *stream, index)))
+        hr = E_INVALIDARG;
+    else
+    {
+        size = *length;
+        hr = read_attribute(attr, name, name_len, type, NULL, value, &size);
+        *length = min(size, 0xffff);
+    }
+    LeaveCriticalSection(&header->cs);
+    return hr;
+}
+
+static HRESULT WINAPI header_GetAttributeByName(IWMHeaderInfo3 *iface, WORD *stream, const WCHAR *name,
+        WMT_ATTR_DATATYPE *type, BYTE *value, WORD *length)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    unsigned int i;
+    DWORD size;
+    HRESULT hr = ASF_E_NOTFOUND;
+
+    TRACE("iface %p, stream %p, name %s, type %p, value %p, length %p.\n",
+            iface, stream, debugstr_w(name), type, value, length);
+
+    if (!stream || !name || !length)
+        return E_INVALIDARG;
+    EnterCriticalSection(&header->cs);
+    for (i = 0; i < header->attr_count; ++i)
+    {
+        struct attribute *attr = &header->attrs[i];
+
+        if (attr->stream != *stream || wcsicmp(attr->name, name))
+            continue;
+        size = *length;
+        hr = read_attribute(attr, NULL, NULL, type, NULL, value, &size);
+        *length = min(size, 0xffff);
+        break;
+    }
+    LeaveCriticalSection(&header->cs);
+    return hr;
+}
+
+static HRESULT WINAPI header_SetAttribute(IWMHeaderInfo3 *iface, WORD stream, const WCHAR *name,
+        WMT_ATTR_DATATYPE type, const BYTE *value, WORD length)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    unsigned int i;
+    HRESULT hr;
+
+    TRACE("iface %p, stream %u, name %s, type %#x, value %p, length %u.\n",
+            iface, stream, debugstr_w(name), type, value, length);
+
+    if (!name || !*name || !valid_value(type, value, length))
+        return E_INVALIDARG;
+    EnterCriticalSection(&header->cs);
+    for (i = 0; i < header->attr_count; ++i)
+    {
+#ifdef SG_MUTANT_WMVW_HDR_NOREPLACE
+        break;
+#endif
+        if (header->attrs[i].stream == stream && !wcsicmp(header->attrs[i].name, name))
+        {
+            hr = attribute_set(&header->attrs[i], type, 0, value, length);
+            LeaveCriticalSection(&header->cs);
+            return hr;
+        }
+    }
+    hr = attribute_add(header, stream, name, type, 0, value, length, NULL);
+    LeaveCriticalSection(&header->cs);
+    return hr;
+}
+
+static HRESULT WINAPI header_GetMarkerCount(IWMHeaderInfo3 *iface, WORD *count)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    EnterCriticalSection(&header->cs);
+    *count = header->marker_count;
+    LeaveCriticalSection(&header->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI header_GetMarker(IWMHeaderInfo3 *iface, WORD index, WCHAR *name, WORD *len, QWORD *time)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, index %u, name %p, len %p, time %p.\n", iface, index, name, len, time);
+
+    if (!len || !time)
+        return E_INVALIDARG;
+    EnterCriticalSection(&header->cs);
+    if (index >= header->marker_count)
+        hr = E_INVALIDARG;
+    else if (SUCCEEDED(hr = copy_string_out(header->markers[index].name, name, len)))
+        *time = header->markers[index].time;
+    LeaveCriticalSection(&header->cs);
+    return hr;
+}
+
+static HRESULT WINAPI header_AddMarker(IWMHeaderInfo3 *iface, const WCHAR *name, QWORD time)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    struct marker *markers, marker;
+    unsigned int i;
+
+    TRACE("iface %p, name %s, time %s.\n", iface, debugstr_w(name), wine_dbgstr_longlong(time));
+
+    if (!name)
+        return E_INVALIDARG;
+    if (!(marker.name = wcsdup(name)))
+        return E_OUTOFMEMORY;
+    marker.time = time;
+
+    EnterCriticalSection(&header->cs);
+    if (!(markers = realloc(header->markers, (header->marker_count + 1) * sizeof(*markers))))
+    {
+        LeaveCriticalSection(&header->cs);
+        free(marker.name);
+        return E_OUTOFMEMORY;
+    }
+    header->markers = markers;
+    /* Markers are kept in time order. */
+    for (i = header->marker_count; i && markers[i - 1].time > time && !MARKER_APPEND; --i)
+        markers[i] = markers[i - 1];
+    markers[i] = marker;
+    ++header->marker_count;
+    LeaveCriticalSection(&header->cs);
+    return S_OK;
+}
