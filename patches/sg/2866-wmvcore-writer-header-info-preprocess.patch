+static HRESULT WINAPI header_AddAttribute(IWMHeaderInfo3 *iface, WORD stream, const WCHAR *name, WORD *index,
+        WMT_ATTR_DATATYPE type, WORD lang, const BYTE *value, DWORD length)
+{
+    struct writer_header *header = impl_from_IWMHeaderInfo3(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, stream %u, name %s, index %p, type %#x, lang %u, value %p, length %lu.\n",
+            iface, stream, debugstr_w(name), index, type, lang, value, length);
+
+    if (!name || !*name || !valid_value(type, value, length))
+        return E_INVALIDARG;
+    EnterCriticalSection(&header->cs);
+    hr = attribute_add(header, stream, name, type, lang, value, length, index);
+    LeaveCriticalSection(&header->cs);
+    return hr;
+}
