+    HRESULT hr;
+
+    TRACE("iface %p, stream %u, index %u, name %p, name_len %p, type %p, lang %p, value %p, length %p.\n",
+            iface, stream, index, name, name_len, type, lang, value, length);
+
+    if (!name_len || !length)
+        return E_INVALIDARG;
+    EnterCriticalSection(&header->cs);
+    if (!(attr = find_by_index(header, stream, index)))
+        hr = E_INVALIDARG;
+    else
+        hr = read_attribute(attr, name, name_len, type, lang, value, length);
+    LeaveCriticalSection(&header->cs);
+    return hr;
+}
