+        HRESULT hr2;
+
+        hr = copy_string_out(header->scripts[index].type, type, type_len);
+        hr2 = copy_string_out(header->scripts[index].command, command, command_len);
+        if (SUCCEEDED(hr))
+            hr = hr2;
+        if (SUCCEEDED(hr))
