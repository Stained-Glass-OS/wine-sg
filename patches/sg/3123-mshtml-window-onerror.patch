From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 23:32:53 -0700
Subject: [PATCH] mshtml: uncaught script errors call window.onerror

The script site of the page answered OnScriptError with E_NOTIMPL, so an
error that no code caught was dropped and window.onerror never ran. In
document mode 9 and later the handler now gets the message, the address of
the document, the line and the column (both counted from 1); the host is not
asked to show the error.

diff --git a/dlls/mshtml/script.c b/dlls/mshtml/script.c
index c15960b..4a86fe3 100644
--- a/dlls/mshtml/script.c
+++ b/dlls/mshtml/script.c
@@ -459,8 +459,57 @@ static HRESULT WINAPI ActiveScriptSite_OnStateChange(IActiveScriptSite *iface, S
 static HRESULT WINAPI ActiveScriptSite_OnScriptError(IActiveScriptSite *iface, IActiveScriptError *pscripterror)
 {
     ScriptHost *This = impl_from_IActiveScriptSite(iface);
-    FIXME("(%p)->(%p)\n", This, pscripterror);
-    return E_NOTIMPL;
+    HTMLInnerWindow *window = This->window;
+    VARIANT handler;
+    EXCEPINFO ei;
+    ULONG line = 0;
+    LONG col = 0;
+    DWORD ctx;
+
+    TRACE("(%p)->(%p)\n", This, pscripterror);
+
+#ifdef SG_MUTANT_ONERROR
+    return S_OK;
+#endif
+    if(!pscripterror || !window || !window->doc || window->doc->document_mode < COMPAT_MODE_IE9)
+        return S_OK;
+
+    /* window.onerror gets the message, the address, the line and the column; a true result
+     * says the error has been dealt with */
+    V_VT(&handler) = VT_EMPTY;
+    if(SUCCEEDED(get_event_handler(&window->event_target, EVENTID_ERROR, &handler)) && V_VT(&handler) == VT_DISPATCH
+       && V_DISPATCH(&handler)) {
+        VARIANT args[4], ret;
+        DISPPARAMS dp = { args, NULL, 4, 0 };
+        BSTR url = NULL;
+
+        memset(&ei, 0, sizeof(ei));
+        IActiveScriptError_GetExceptionInfo(pscripterror, &ei);
+        if(FAILED(IActiveScriptError_GetSourcePosition(pscripterror, &ctx, &line, &col))) {
+            line = 0;
+            col = 0;
+        }
+        IHTMLDocument2_get_URL(&window->doc->IHTMLDocument2_iface, &url);
+
+        V_VT(&args[3]) = VT_BSTR;
+        V_BSTR(&args[3]) = ei.bstrDescription;
+        V_VT(&args[2]) = VT_BSTR;
+        V_BSTR(&args[2]) = url;
+        V_VT(&args[1]) = VT_I4;
+        V_I4(&args[1]) = line + 1;
+        V_VT(&args[0]) = VT_I4;
+        V_I4(&args[0]) = col + 1;
+        V_VT(&ret) = VT_EMPTY;
+        call_disp_func(V_DISPATCH(&handler), &dp, &ret);
+        VariantClear(&ret);
+
+        SysFreeString(ei.bstrSource);
+        SysFreeString(ei.bstrDescription);
+        SysFreeString(ei.bstrHelpFile);
+        SysFreeString(url);
+    }
+    VariantClear(&handler);
+    return S_OK;
 }
 
 static HRESULT WINAPI ActiveScriptSite_OnEnterScript(IActiveScriptSite *iface)
