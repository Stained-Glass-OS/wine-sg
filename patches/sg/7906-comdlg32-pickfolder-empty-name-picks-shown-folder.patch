From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comdlg32: A folder picker with no name typed picks the folder shown.

Windows' folder picker (IFileOpenDialog with FOS_PICKFOLDERS) picks the folder
being shown when its button is pressed with the name box empty. Wine's
on_default_action returned at once when no name was typed, so nothing happened:
DOSBox-X's first-run "Choose a working folder" stayed open whatever was clicked
until a folder was selected in the list. The shown folder becomes the result (a
non-filesystem folder is still refused under FOS_FORCEFILESYSTEM) and OnFileOk is
asked as for any other pick.
---
diff --git a/dlls/comdlg32/itemdlg.c b/dlls/comdlg32/itemdlg.c
index 29abec0..6acfdf6 100644
--- a/dlls/comdlg32/itemdlg.c
+++ b/dlls/comdlg32/itemdlg.c
@@ -745,6 +745,30 @@ static HRESULT on_default_action(FileDialogImpl *This)
         file_count = COMDLG32_SplitFileNames(tmp_files, len, &files, &size_used);
         CoTaskMemFree(tmp_files);
     }
+#ifndef SG_MUTANT_PICKFOLDER_EMPTY_NAME
+    /* A folder picker's button with no name typed picks the folder being shown,
+     * as Windows' does (DOSBox-X's first-run "Choose" did nothing). */
+    if(!file_count && (This->options & FOS_PICKFOLDERS) && This->psi_folder)
+    {
+        SFGAOF attr = 0;
+
+        if((This->options & FOS_FORCEFILESYSTEM) &&
+           (FAILED(IShellItem_GetAttributes(This->psi_folder, SFGAO_FILESYSTEM, &attr)) || !(attr & SFGAO_FILESYSTEM)))
+            return E_FAIL;
+        if(This->psia_results)
+        {
+            IShellItemArray_Release(This->psia_results);
+            This->psia_results = NULL;
+        }
+        if(FAILED(SHCreateShellItemArrayFromShellItem(This->psi_folder, &IID_IShellItemArray,
+                                                       (void **)&This->psia_results)))
+            return E_FAIL;
+        if(events_OnFileOk(This) == S_OK) return S_OK;
+        IShellItemArray_Release(This->psia_results);
+        This->psia_results = NULL;
+        return E_FAIL;
+    }
+#endif
     if(!file_count) return E_FAIL;
 
     hr = SHGetIDListFromObject((IUnknown*)This->psi_folder, &current_folder);
