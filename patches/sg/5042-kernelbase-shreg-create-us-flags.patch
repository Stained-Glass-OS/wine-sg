From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Honour all SHREGSET flags in SHRegCreateUSKeyW.

SHRegCreateUSKeyW makes the key in each hive its flags name:
SHREGSET_HKCU/FORCE_HKCU in HKCU, SHREGSET_HKLM/FORCE_HKLM in HKLM,
SHREGSET_DEFAULT (FORCE_HKCU | HKLM) in both. A hive that was not forced may
fail (HKLM without the rights) as long as one key opens; unknown flags fail
with ERROR_INVALID_PARAMETER. Every flag but FORCE_HKCU returned
ERROR_SUCCESS with a NULL key.

Gate: test/kernelbase-shregcreate-gate.sh (64/32).
---
 dlls/kernelbase/registry.c | 40 ++++++++++++++++++++++++++++++++--------
 1 file changed, 32 insertions(+), 8 deletions(-)

diff --git a/dlls/kernelbase/registry.c b/dlls/kernelbase/registry.c
index 221885a..bdb6750 100644
--- a/dlls/kernelbase/registry.c
+++ b/dlls/kernelbase/registry.c
@@ -4487,13 +4487,17 @@ LONG WINAPI SHRegCreateUSKeyW(const WCHAR *path, REGSAM samDesired, HUSKEY relat
 
     *new_uskey = NULL;
 
+#ifndef SG_MUTANT_SHREGCREATE_HKCU_ONLY
+    if (!(flags & (SHREGSET_HKCU | SHREGSET_FORCE_HKCU | SHREGSET_HKLM | SHREGSET_FORCE_HKLM))
+            || (flags & ~(SHREGSET_HKCU | SHREGSET_FORCE_HKCU | SHREGSET_HKLM | SHREGSET_FORCE_HKLM)))
+        return ERROR_INVALID_PARAMETER;
+#else
     if (flags & ~SHREGSET_FORCE_HKCU)
-    {
-        FIXME("unsupported flags 0x%08lx\n", flags);
         return ERROR_SUCCESS;
-    }
+#endif
 
     ret_key = heap_alloc_zero(sizeof(*ret_key));
+    if (!ret_key) return ERROR_NOT_ENOUGH_MEMORY;
     lstrcpynW(ret_key->path, path, ARRAY_SIZE(ret_key->path));
 
     if (relative_key)
@@ -4507,15 +4511,35 @@ LONG WINAPI SHRegCreateUSKeyW(const WCHAR *path, REGSAM samDesired, HUSKEY relat
         ret_key->HKLMstart = HKEY_LOCAL_MACHINE;
     }
 
-    if (flags & SHREGSET_FORCE_HKCU)
+    /* the key is made in each hive the flags name; a hive the caller did
+     * not force may fail (HKLM without the rights) as long as one opens */
+    if (flags & (SHREGSET_HKCU | SHREGSET_FORCE_HKCU))
     {
         ret = RegCreateKeyExW(ret_key->HKCUstart, path, 0, NULL, 0, samDesired, NULL, &ret_key->HKCUkey, NULL);
-        if (ret == ERROR_SUCCESS)
-            *new_uskey = ret_key;
-        else
-            heap_free(ret_key);
+        if (ret && (flags & SHREGSET_FORCE_HKCU)) goto failed;
+    }
+    if (flags & (SHREGSET_HKLM | SHREGSET_FORCE_HKLM))
+    {
+        LONG ret2 = RegCreateKeyExW(ret_key->HKLMstart, path, 0, NULL, 0, samDesired, NULL, &ret_key->HKLMkey, NULL);
+        if (ret2 && (flags & SHREGSET_FORCE_HKLM))
+        {
+            ret = ret2;
+            goto failed;
+        }
+        if (!ret_key->HKCUkey) ret = ret2;
+    }
+    if (ret_key->HKCUkey || ret_key->HKLMkey)
+    {
+        *new_uskey = ret_key;
+        return ERROR_SUCCESS;
     }
 
+failed:
+    if (ret_key->HKCUkey) RegCloseKey(ret_key->HKCUkey);
+    if (ret_key->HKLMkey) RegCloseKey(ret_key->HKLMkey);
+    if (ret_key->HKCUstart && ret_key->HKCUstart != HKEY_CURRENT_USER) RegCloseKey(ret_key->HKCUstart);
+    if (ret_key->HKLMstart && ret_key->HKLMstart != HKEY_LOCAL_MACHINE) RegCloseKey(ret_key->HKLMstart);
+    heap_free(ret_key);
     return ret;
 }
 
