From: Stained Glass OS <dev@stained-glass.example>
Subject: shell32: an on-disk thumbnail cache

SHELL_GetThumbnail keeps what it makes under
%LOCALAPPDATA%\Microsoft\Windows\Explorer\sg-thumbcache, one file per path
and size (FNV-1a of the lower-cased path, then _SIZE.thumb): a header (magic
"SGTC", version, width, height, the file's last write time and size, the
path) then the BGRA rows. An entry is used only when the time, size and path
all match, so a changed file is thumbnailed again; a hit touches the entry.
Bounded: HKCU\Software\Stained Glass\Explorer ThumbnailCacheKB (default
100 MB), the least recently used entries go down to three quarters of it.
Off under the NoThumbnailCache / DisableThumbnailCache policies. Written to
a temporary file then moved, so readers never see half an entry.

Gate: test/explorer3-gate.sh.
---
--- a/dlls/shell32/thumbnail.c
+++ b/dlls/shell32/thumbnail.c
@@ -420,6 +420,9 @@
     {
         LONG pitch = stride ? stride : (LONG)w * 4;
         UINT y;
+        /* Wine's video processor gives the stride in pixels, not bytes:
+         * a stride too small for the row keeps only its direction */
+        if (labs(pitch) < (LONG)w * 4) pitch = pitch < 0 ? -(LONG)w * 4 : (LONG)w * 4;
         if ((SIZE_T)labs(pitch) * h > len || labs(pitch) < (LONG)w * 4) hr = E_FAIL;
         else if (!(*pixels = malloc((SIZE_T)w * h * 4))) hr = E_OUTOFMEMORY;
         else
@@ -801,10 +804,226 @@
     return hr;
 }
 
+/* ------------------------------------------------------------------------ */
+/* the thumbnail cache on disk                                              */
+
+/* Explorer keeps what it made: %LOCALAPPDATA%\Microsoft\Windows\Explorer\
+ * sg-thumbcache, a file per picture and size named by a hash of the path, so
+ * a picture changes in place. Each holds the file's time and size and its
+ * path, and is used only while they still match -- a changed file is made
+ * again, over the old one. The folder is kept under a limit (HKCU\Software\
+ * Stained Glass\Explorer ThumbnailCacheKB, 100 MB unless set) by dropping the
+ * pictures used longest ago (a hit touches its file). The policy Windows has
+ * for it (Explorer policies NoThumbnailCache, or DisableThumbnailCache under
+ * Advanced) turns it off. */
+
+#define TC_MAGIC 0x43544753      /* "SGTC" */
+#define TC_VERSION 1
+
+struct tc_header
+{
+    DWORD magic, version, width, height;
+    FILETIME written;
+    ULONGLONG size;
+    DWORD path_len;              /* characters, then the path, then the BGRA rows */
+};
+
+static BOOL tc_disabled(void)
+{
+    DWORD value = 0, size = sizeof(value);
+    if (!RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
+                      L"NoThumbnailCache", RRF_RT_REG_DWORD, NULL, &value, &size) && value) return TRUE;
+    size = sizeof(value);
+    if (!RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
+                      L"DisableThumbnailCache", RRF_RT_REG_DWORD, NULL, &value, &size) && value) return TRUE;
+    return FALSE;
+}
+
+static ULONGLONG tc_limit(void)
+{
+    DWORD kb = 100 * 1024, size = sizeof(kb);
+    RegGetValueW(HKEY_CURRENT_USER, L"Software\\Stained Glass\\Explorer", L"ThumbnailCacheKB", RRF_RT_REG_DWORD, NULL, &kb, &size);
+    return (ULONGLONG)max(kb, 16) * 1024;
+}
+
+static BOOL tc_dir(WCHAR *dir)
+{
+    if (FAILED(SHGetFolderPathW(NULL, CSIDL_LOCAL_APPDATA | CSIDL_FLAG_CREATE, NULL, SHGFP_TYPE_CURRENT, dir))) return FALSE;
+    PathAppendW(dir, L"Microsoft\\Windows\\Explorer\\sg-thumbcache");
+    if (PathIsDirectoryW(dir)) return TRUE;
+    return SHCreateDirectoryExW(NULL, dir, NULL) == ERROR_SUCCESS || GetLastError() == ERROR_ALREADY_EXISTS ||
+           PathIsDirectoryW(dir);
+}
+
+/* the entry's file: FNV-1a of the lower-cased path, and the size */
+static BOOL tc_file(const WCHAR *path, UINT size, WCHAR *file)
+{
+    ULONGLONG hash = 0xcbf29ce484222325ull;
+    const WCHAR *c;
+    if (!tc_dir(file)) return FALSE;
+    for (c = path; *c; c++)
+    {
+        WCHAR lower = towlower(*c);
+        hash = (hash ^ (lower & 0xff)) * 0x100000001b3ull;
+        hash = (hash ^ (lower >> 8)) * 0x100000001b3ull;
+    }
+    swprintf(file + lstrlenW(file), MAX_PATH, L"\\%016I64x_%u.thumb", hash, size);
+    return TRUE;
+}
+
+static HBITMAP tc_read(const WCHAR *path, const WIN32_FILE_ATTRIBUTE_DATA *fad, UINT size)
+{
+    WCHAR file[MAX_PATH + 64], stored[MAX_PATH];
+    struct tc_header head;
+    HBITMAP bitmap = NULL;
+    FILETIME now;
+    void *bits;
+    DWORD got;
+    HANDLE h;
+
+    if (!tc_file(path, size, file)) return NULL;
+    h = CreateFileW(file, GENERIC_READ | FILE_WRITE_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+    if (h == INVALID_HANDLE_VALUE) return NULL;
+    if (ReadFile(h, &head, sizeof(head), &got, NULL) && got == sizeof(head) && head.magic == TC_MAGIC &&
+        head.version == TC_VERSION && head.path_len < MAX_PATH && head.width && head.height &&
+        head.width <= max(size, 1) && head.height <= max(size, 1) &&
+        !CompareFileTime(&head.written, &fad->ftLastWriteTime) &&
+        head.size == (((ULONGLONG)fad->nFileSizeHigh << 32) | fad->nFileSizeLow) &&
+        ReadFile(h, stored, head.path_len * sizeof(WCHAR), &got, NULL) && got == head.path_len * sizeof(WCHAR))
+    {
+        stored[head.path_len] = 0;
+        if (!wcsicmp(stored, path) && (bitmap = create_dib(head.width, head.height, &bits)))
+        {
+            DWORD need = head.width * head.height * 4;
+            if (!ReadFile(h, bits, need, &got, NULL) || got != need)
+            {
+                DeleteObject(bitmap);
+                bitmap = NULL;
+            }
+        }
+    }
+    if (bitmap)
+    {
+        GetSystemTimeAsFileTime(&now);
+        SetFileTime(h, NULL, NULL, &now);     /* used now: kept longest */
+    }
+    CloseHandle(h);
+    TRACE("cache %s %s\n", bitmap ? "hit" : "miss", debugstr_w(path));
+    return bitmap;
+}
+
+struct tc_entry
+{
+    WCHAR name[64];
+    FILETIME used;
+    ULONGLONG size;
+};
+
+static int __cdecl tc_older(const void *a, const void *b)
+{
+    return CompareFileTime(&((const struct tc_entry *)a)->used, &((const struct tc_entry *)b)->used);
+}
+
+/* the cache under its limit: the least recently used entries go */
+static void tc_prune(const WCHAR *dir, ULONGLONG limit, ULONGLONG *total)
+{
+    WCHAR pattern[MAX_PATH + 8], file[MAX_PATH + 64];
+    struct tc_entry *all = NULL, *grown;
+    WIN32_FIND_DATAW fd;
+    size_t n = 0, cap = 0, i;
+    HANDLE find;
+
+    *total = 0;
+    swprintf(pattern, ARRAY_SIZE(pattern), L"%s\\*.thumb", dir);
+    if ((find = FindFirstFileW(pattern, &fd)) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (n == cap)
+        {
+            cap = max(64, cap * 2);
+            if (!(grown = realloc(all, cap * sizeof(*all)))) break;
+            all = grown;
+        }
+        lstrcpynW(all[n].name, fd.cFileName, ARRAY_SIZE(all[n].name));
+        all[n].used = fd.ftLastWriteTime;
+        all[n].size = ((ULONGLONG)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+        *total += all[n].size;
+        n++;
+    } while (FindNextFileW(find, &fd));
+    FindClose(find);
+    if (*total > limit && n)
+    {
+        qsort(all, n, sizeof(*all), tc_older);
+        for (i = 0; i < n && *total > limit / 4 * 3; i++)
+        {
+            swprintf(file, ARRAY_SIZE(file), L"%s\\%s", dir, all[i].name);
+            if (DeleteFileW(file)) *total -= all[i].size;
+        }
+        TRACE("cache pruned to %I64u bytes\n", *total);
+    }
+    free(all);
+}
+
+static void tc_write(const WCHAR *path, const WIN32_FILE_ATTRIBUTE_DATA *fad, UINT size, HBITMAP bitmap)
+{
+    static ULONGLONG total = ~0ull;           /* what this process knows the folder holds (an estimate: threads may race) */
+    WCHAR file[MAX_PATH + 64], tmp[MAX_PATH + 80], dir[MAX_PATH];
+    struct tc_header head;
+    BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER) }};
+    ULONGLONG limit = tc_limit();
+    BITMAP bm;
+    DWORD *px, done, need;
+    BOOL ok;
+    HANDLE h;
+    HDC dc;
+
+    if (!GetObjectW(bitmap, sizeof(bm), &bm) || bm.bmWidth <= 0 || bm.bmHeight <= 0) return;
+    if (!tc_file(path, size, file) || !tc_dir(dir)) return;
+    need = bm.bmWidth * bm.bmHeight * 4;
+    if (!(px = malloc(need))) return;
+    bmi.bmiHeader.biWidth = bm.bmWidth;
+    bmi.bmiHeader.biHeight = -bm.bmHeight;
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+    dc = GetDC(0);
+    ok = GetDIBits(dc, bitmap, 0, bm.bmHeight, px, &bmi, DIB_RGB_COLORS) == bm.bmHeight;
+    ReleaseDC(0, dc);
+    if (ok)
+    {
+        head.magic = TC_MAGIC;
+        head.version = TC_VERSION;
+        head.width = bm.bmWidth;
+        head.height = bm.bmHeight;
+        head.written = fad->ftLastWriteTime;
+        head.size = ((ULONGLONG)fad->nFileSizeHigh << 32) | fad->nFileSizeLow;
+        head.path_len = lstrlenW(path);
+        swprintf(tmp, ARRAY_SIZE(tmp), L"%s.%lx.tmp", file, GetCurrentThreadId());
+        h = CreateFileW(tmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (h != INVALID_HANDLE_VALUE)
+        {
+            ok = WriteFile(h, &head, sizeof(head), &done, NULL) &&
+                 WriteFile(h, path, head.path_len * sizeof(WCHAR), &done, NULL) &&
+                 WriteFile(h, px, need, &done, NULL);
+            CloseHandle(h);
+            if (ok && MoveFileExW(tmp, file, MOVEFILE_REPLACE_EXISTING))
+            {
+                if (total != ~0ull) total += sizeof(head) + head.path_len * sizeof(WCHAR) + need;
+            }
+            else DeleteFileW(tmp);
+        }
+    }
+    free(px);
+    /* the first write of a process counts the folder; later ones add up */
+    if (total == ~0ull || total > limit) tc_prune(dir, limit, &total);
+}
+
 /* Stained Glass: a file's thumbnail, from its type's handler; fails when the
  * type has none (the caller shows its icon) */
 HRESULT SHELL_GetThumbnail(const ITEMIDLIST *pidl, UINT size, HBITMAP *bitmap)
 {
+    WIN32_FILE_ATTRIBUTE_DATA fad;
+    BOOL cache;
     WCHAR path[MAX_PATH];
     const WCHAR *ext;
     CLSID clsid;
@@ -812,9 +1031,12 @@
 
     *bitmap = NULL;
     if (!pidl || !SHGetPathFromIDListW(pidl, path) || !path[0]) return E_FAIL;
-    if (GetFileAttributesW(path) & FILE_ATTRIBUTE_DIRECTORY) return E_FAIL;
+    if (!GetFileAttributesExW(path, GetFileExInfoStandard, &fad)) return E_FAIL;
+    if (fad.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) return E_FAIL;
     ext = PathFindExtensionW(path);
     if (!ext[0]) return E_FAIL;
+    cache = !tc_disabled();
+    if (cache && (*bitmap = tc_read(path, &fad, size))) return S_OK;
     if (find_handler(ext, thumbnail_provider_key, &clsid))
         hr = provider_thumbnail(&clsid, pidl, path, size, bitmap);
     if (FAILED(hr) && find_handler(ext, extract_image_key, &clsid))
@@ -824,6 +1046,7 @@
         DeleteObject(*bitmap);
         *bitmap = NULL;
     }
+    if (SUCCEEDED(hr) && cache) tc_write(path, &fad, size, *bitmap);
     TRACE("%s: %#lx\n", debugstr_w(path), hr);
     return hr;
 }
