From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ucrtbase: Export the _mbcasemap array.

ucrtbase's _mbcasemap data export: the case map of the process'
multibyte code page, refreshed by _setmbcp like the _mbctype array the
older CRTs export.
---
 dlls/msvcrt/mbcs.c          | 7 +++++++
 dlls/ucrtbase/ucrtbase.spec | 2 +-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/dlls/msvcrt/mbcs.c b/dlls/msvcrt/mbcs.c
index 721fd94..73155d6 100644
--- a/dlls/msvcrt/mbcs.c
+++ b/dlls/msvcrt/mbcs.c
@@ -36,6 +36,10 @@
 WINE_DEFAULT_DEBUG_CHANNEL(msvcrt);
 
 unsigned char MSVCRT_mbctype[257] = { 0 };
+#if _MSVCR_VER >= 140
+/* the case map of the process' multibyte code page, beside _mbctype */
+unsigned char MSVCRT_mbcasemap[256] = { 0 };
+#endif
 
 /* It seems that the data about valid trail bytes is not available from kernel32
  * so we have to store is here. The format is the same as for lead bytes in CPINFO */
@@ -432,6 +436,9 @@ int CDECL _setmbcp(int cp)
         free_mbcinfo(MSVCRT_locale->mbcinfo);
         MSVCRT_locale->mbcinfo = mbcinfo;
         memcpy(MSVCRT_mbctype, MSVCRT_locale->mbcinfo->mbctype, sizeof(MSVCRT_mbctype));
+#if _MSVCR_VER >= 140 && !defined(SG_MUTANT_MBCASEMAP_DATA_STALE)
+        memcpy(MSVCRT_mbcasemap, MSVCRT_locale->mbcinfo->mbcasemap, sizeof(MSVCRT_mbcasemap));
+#endif
         _unlock(_MB_CP_LOCK);
     }
     return 0;
diff --git a/dlls/ucrtbase/ucrtbase.spec b/dlls/ucrtbase/ucrtbase.spec
index 35f9783..d3c5383 100644
--- a/dlls/ucrtbase/ucrtbase.spec
+++ b/dlls/ucrtbase/ucrtbase.spec
@@ -588,7 +588,7 @@
 @ cdecl _mbbtombc_l(long ptr)
 @ cdecl _mbbtype(long long)
 @ cdecl _mbbtype_l(long long ptr)
-@ stub _mbcasemap
+@ extern _mbcasemap MSVCRT_mbcasemap
 @ cdecl _mbccpy(ptr ptr)
 @ cdecl _mbccpy_l(ptr ptr ptr)
 @ cdecl _mbccpy_s(ptr long ptr ptr)
