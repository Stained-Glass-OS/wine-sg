+/***********************************************************************
+ *          UiaGetErrorDescription (uiautomationcore.@)
+ *
+ * The description of the last error the calling thread's COM error object
+ * holds; FALSE when there is none.
+ */
+BOOL WINAPI UiaGetErrorDescription(BSTR *desc)
+{
+    IErrorInfo *info = NULL;
+    BSTR text = NULL;
+
+    TRACE("(%p)\n", desc);
+
+    if (!desc)
+        return FALSE;
+    *desc = NULL;
+    if (GetErrorInfo(0, &info) != S_OK || !info)
+        return FALSE;
+    IErrorInfo_GetDescription(info, &text);
+    IErrorInfo_Release(info);
+    if (!text)
+        return FALSE;
+    *desc = text;
+    return TRUE;
+}
