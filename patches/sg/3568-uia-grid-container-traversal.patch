+/***********************************************************************
+ *          GridPattern_GetItem (uiautomationcore.@)
+ */
+HRESULT WINAPI GridPattern_GetItem(HUIAPATTERNOBJECT hobj, int row, int column, HUIANODE *node)
+{
+    SAFEARRAY *sa = SafeArrayCreateVector(VT_I4, 0, 2);
+    int vals[2] = { row, column };
+    VARIANT in, out;
+    LONG idx;
+    HRESULT hr;
+
+    TRACE("(%p, %d, %d, %p)\n", hobj, row, column, node);
+
+    if (!node)
+        return E_INVALIDARG;
+    *node = NULL;
+    if (!sa)
+        return E_OUTOFMEMORY;
+    for (idx = 0; idx < 2; idx++)
+        SafeArrayPutElement(sa, &idx, &vals[idx]);
+    V_VT(&in) = VT_I4 | VT_ARRAY;
+    V_ARRAY(&in) = sa;
+    VariantInit(&out);
+    hr = pattern_object_call(hobj, UIA_GridPatternId, PATTERN_METHOD_GRID_GET_ITEM, &in, &out);
+    SafeArrayDestroy(sa);
+    if (SUCCEEDED(hr) && V_VT(&out) == VT_I4)
+        hr = uia_node_from_lresult((LRESULT)V_I4(&out), node, 0);
+    VariantClear(&out);
+    return hr;
+}
+
+/***********************************************************************
+ *          ItemContainerPattern_FindItemByProperty (uiautomationcore.@)
+ */
+HRESULT WINAPI ItemContainerPattern_FindItemByProperty(HUIAPATTERNOBJECT hobj, HUIANODE start_after, PROPERTYID prop_id,
+        VARIANT value, HUIANODE *found)
+{
+    IWineUiaNode *start_node = start_after ? uia_checked_node(start_after) : NULL;
+    SAFEARRAY *sa;
+    VARIANT args[3], in, out;
+    LONG idx;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %d, %s, %p)\n", hobj, start_after, prop_id, debugstr_variant(&value), found);
+
+    if (!found)
+        return E_INVALIDARG;
+    *found = NULL;
+    if (start_after && !start_node)
+        return E_INVALIDARG;
+
+    VariantInit(&args[0]);
+    if (start_node)
+    {
+        LRESULT lr;
+
+        /* the node travels as a marshalled reference; the one we hold stays ours */
+        IWineUiaNode_AddRef(start_node);
+        if (!(lr = uia_lresult_from_node(start_after)))
+        {
+            IWineUiaNode_Release(start_node);
+            return E_FAIL;
+        }
+        variant_init_i4(&args[0], lr);
+    }
+    variant_init_i4(&args[1], prop_id);
+    args[2] = value;
+
+    if (!(sa = SafeArrayCreateVector(VT_VARIANT, 0, 3)))
+        return E_OUTOFMEMORY;
+    for (idx = 0; idx < 3; idx++)
+        SafeArrayPutElement(sa, &idx, &args[idx]);
+    V_VT(&in) = VT_VARIANT | VT_ARRAY;
+    V_ARRAY(&in) = sa;
+    VariantInit(&out);
+    hr = pattern_object_call(hobj, UIA_ItemContainerPatternId, PATTERN_METHOD_ITEMCONTAINER_FIND, &in, &out);
+    SafeArrayDestroy(sa);
+    if (SUCCEEDED(hr) && V_VT(&out) == VT_I4)
+        hr = uia_node_from_lresult((LRESULT)V_I4(&out), found, 0);
+    VariantClear(&out);
+    return hr;
+}
