+/* The element of a node: its provider if the node is one of this side, else a stand-in. Takes the node. */
+static HRESULT elprov_from_node(HUIANODE node, IRawElementProviderSimple **out)
+{
+    struct node_elprov *impl;
+    HRESULT hr;
+
+    hr = uia_node_get_elprov(node, out);
+    if (SUCCEEDED(hr))
+    {
+        UiaNodeRelease(node);
+        return hr;
+    }
+    if (!(impl = calloc(1, sizeof(*impl))))
+    {
+        UiaNodeRelease(node);
+        return E_OUTOFMEMORY;
+    }
+    impl->IRawElementProviderSimple_iface.lpVtbl = &node_simple_vtbl;
+    impl->IRawElementProviderFragment_iface.lpVtbl = &node_fragment_vtbl;
+    impl->ref = 1;
+    impl->node = node;
+    *out = &impl->IRawElementProviderSimple_iface;
+    return S_OK;
