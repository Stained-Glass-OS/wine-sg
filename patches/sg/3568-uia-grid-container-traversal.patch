+/* An element a provider returned travels to the client as a node number. */
+static HRESULT pattern_out_node(VARIANT *out, IRawElementProviderSimple *elprov)
+{
+    HUIANODE node;
+    LRESULT lr;
+    HRESULT hr;
+
+    if (!elprov)
+    {
+        V_VT(out) = VT_EMPTY;
+        return S_OK;
+    }
+    hr = create_uia_node_from_elprov(elprov, &node, TRUE, 0);
+    IRawElementProviderSimple_Release(elprov);
+    if (FAILED(hr))
+        return hr;
+    if (!(lr = uia_lresult_from_node(node)))
+        return E_FAIL;
+    V_VT(out) = VT_I4;
+    V_I4(out) = lr;
+    return S_OK;
+}
+
+/* An element a provider asks about that came from another apartment cannot be turned back into the
+ * provider it was made from: a stand-in answers for it from the node (properties and runtime id). */
+struct node_elprov
+{
+    IRawElementProviderSimple IRawElementProviderSimple_iface;
+    IRawElementProviderFragment IRawElementProviderFragment_iface;
+    LONG ref;
+    HUIANODE node;
+};
+
+static struct node_elprov *impl_from_node_simple(IRawElementProviderSimple *iface)
+{
+    return CONTAINING_RECORD(iface, struct node_elprov, IRawElementProviderSimple_iface);
+}
+
+static struct node_elprov *impl_from_node_fragment(IRawElementProviderFragment *iface)
+{
+    return CONTAINING_RECORD(iface, struct node_elprov, IRawElementProviderFragment_iface);
+}
+
+static HRESULT WINAPI node_simple_QueryInterface(IRawElementProviderSimple *iface, REFIID riid, void **ppv)
+{
+    struct node_elprov *impl = impl_from_node_simple(iface);
+
+    *ppv = NULL;
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IRawElementProviderSimple))
+        *ppv = &impl->IRawElementProviderSimple_iface;
+    else if (IsEqualIID(riid, &IID_IRawElementProviderFragment))
+        *ppv = &impl->IRawElementProviderFragment_iface;
+    else
+        return E_NOINTERFACE;
+    InterlockedIncrement(&impl->ref);
+    return S_OK;
+}
+
+static ULONG WINAPI node_simple_AddRef(IRawElementProviderSimple *iface)
+{
+    return InterlockedIncrement(&impl_from_node_simple(iface)->ref);
+}
+
+static ULONG WINAPI node_simple_Release(IRawElementProviderSimple *iface)
+{
+    struct node_elprov *impl = impl_from_node_simple(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+
+    if (!ref)
+    {
+        UiaNodeRelease(impl->node);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI node_simple_get_ProviderOptions(IRawElementProviderSimple *iface, enum ProviderOptions *ret)
+{
+    *ret = ProviderOptions_ServerSideProvider;
+    return S_OK;
+}
+
+static HRESULT WINAPI node_simple_GetPatternProvider(IRawElementProviderSimple *iface, PATTERNID id, IUnknown **ret)
+{
+    *ret = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI node_simple_GetPropertyValue(IRawElementProviderSimple *iface, PROPERTYID id, VARIANT *ret)
+{
+    VariantInit(ret);
+    return UiaGetPropertyValue(impl_from_node_simple(iface)->node, id, ret);
+}
+
+static HRESULT WINAPI node_simple_get_HostRawElementProvider(IRawElementProviderSimple *iface,
+        IRawElementProviderSimple **ret)
+{
+    *ret = NULL;
+    return S_OK;
+}
+
+static const IRawElementProviderSimpleVtbl node_simple_vtbl =
+{
+    node_simple_QueryInterface,
+    node_simple_AddRef,
+    node_simple_Release,
+    node_simple_get_ProviderOptions,
+    node_simple_GetPatternProvider,
+    node_simple_GetPropertyValue,
+    node_simple_get_HostRawElementProvider,
+};
