                                       ISpTTSEngineSite *site)
 {
-    struct speak_state state = { site, wfx, 0, 0 };
+    struct ttsengine *This = impl_from_ISpTTSEngine(iface);
+    struct speak_state state = { site, wfx, 0, 0, This->langid };
     const SPVTEXTFRAG *frag;
     HRESULT hr = S_OK;
 
@@ -495,7 +500,10 @@
 {
     struct ttsengine *This = impl_from_ISpObjectWithToken(iface);
 
-    FIXME("(%p, %p): semi-stub.\n", iface, token);
+    ISpDataKey *attributes;
+    WCHAR *value;
+
+    TRACE("(%p, %p)\n", iface, token);
 
     if (!token)
         return E_INVALIDARG;
@@ -504,6 +512,22 @@
 
     ISpObjectToken_AddRef(token);
     This->token = token;
+
+    /* Stained Glass OS (wine-sg 9418): a voice speaks its own language: the token's
+     * Language attribute (hexadecimal LCIDs, ";"-separated, the first is the voice's)
+     * for text that names no language of its own */
+#ifndef SG_MUTANT_TTS_VOICE_LANG_IGNORED
+    if (SUCCEEDED(ISpObjectToken_OpenKey(token, L"Attributes", &attributes)))
+    {
+        if (SUCCEEDED(ISpDataKey_GetStringValue(attributes, L"Language", &value)))
+        {
+            This->langid = LANGIDFROMLCID(wcstoul(value, NULL, 16));
+            CoTaskMemFree(value);
+        }
+        ISpDataKey_Release(attributes);
