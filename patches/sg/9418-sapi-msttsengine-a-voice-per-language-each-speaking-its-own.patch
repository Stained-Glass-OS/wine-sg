--- a/dlls/sapi/token.c
+++ b/dlls/sapi/token.c
@@ -1331,6 +1331,58 @@
 
     this_data_key = impl_from_ISpRegDataKey( This->data_key );
 
+    /* Stained Glass OS (wine-sg 9418): with no choice of the user's, the voice of the
+     * user's display language is the default, as on Windows (a German Windows
+     * speaks with its German voice): the first token whose Language attribute names
+     * the display language, else one of its primary language */
+#ifndef SG_MUTANT_SAPITOK_NO_UI_VOICE
+    {
+        LANGID ui = GetUserDefaultUILanguage();
+        WCHAR name[MAX_PATH], lang[64], best[MAX_PATH] = L"";
+        const WCHAR *subkey;
+        HKEY tokens, root;
+        DWORD i, len, size;
+        int best_score = 0;
+
+        if (ui && !RegOpenKeyExW( this_data_key->key, L"Tokens", 0, KEY_READ, &tokens ))
+        {
+            for (i = 0; ; i++)
+            {
+                WCHAR *p;
+                int score = 0;
+
+                len = ARRAY_SIZE( name );
+                if (RegEnumKeyExW( tokens, i, name, &len, NULL, NULL, NULL, NULL )) break;
+                swprintf( lang, ARRAY_SIZE(lang), L"" );
+                size = sizeof(lang);
+                swprintf( regvalue, ARRAY_SIZE(regvalue), L"%s\\Attributes", name );
+                if (RegGetValueW( tokens, regvalue, L"Language", RRF_RT_REG_SZ, NULL, lang, &size )) continue;
+                for (p = lang; *p; )
+                {
+                    LANGID l = (LANGID)wcstoul( p, &p, 16 );
+                    if (l == ui) score = max( score, 2 );
+                    else if (PRIMARYLANGID(l) == PRIMARYLANGID(ui)) score = max( score, 1 );
+                    while (*p && *p != ';') p++;
+                    if (*p == ';') p++;
+                }
+                /* the English voice on an English display stays the first one listed */
+                if (score > best_score) { best_score = score; lstrcpyW( best, name ); }
+            }
+            RegCloseKey( tokens );
+        }
+        if (best_score && parse_cat_id( This->id, &root, &subkey ) == S_OK)
+        {
+            WCHAR *def;
+            size_t n = wcslen( This->id ) + wcslen( best ) + 16;
+
+            if (!(def = CoTaskMemAlloc( n * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+            swprintf( def, n, L"%s\\Tokens\\%s", This->id, best );
+            *id = def;
+            return S_OK;
+        }
+    }
+#endif
+
     res = RegGetValueW( this_data_key->key, NULL, L"DefaultDefaultTokenId", RRF_RT_REG_SZ,
                         NULL, &regvalue, &regvalue_size);
     if (res == ERROR_FILE_NOT_FOUND) {
