diff --git a/dlls/dnsapi/mdns.c b/dlls/dnsapi/mdns.c
new file mode 100644
index 0000000..1951938
--- /dev/null
+++ b/dlls/dnsapi/mdns.c
@@ -0,0 +1,712 @@
+/*
+ * DNS-SD over multicast DNS: DnsServiceBrowse, DnsServiceResolve and service instances
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A browse or a resolve is a session with the system's mDNS responder
+ * (mdnsunix.c) and a thread of ours that waits for its events and calls the
+ * caller back: DnsServiceBrowse with the records of each instance found (its
+ * PTR record, then its SRV, TXT and address records; a PTR record with a zero
+ * TTL when the instance goes away), DnsServiceResolve once with the
+ * instance. Both return DNS_REQUEST_PENDING; the cancel calls end them, the
+ * browse callback then getting ERROR_CANCELLED.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "windns.h"
+#include "dnsapi.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dnsapi);
+
+struct mdns_request
+{
+    struct list_entry { struct mdns_request *next; } link;
+    UINT64 handle;
+    enum mdns_mode mode;
+    ULONG version;
+    void *context;
+    PDNS_SERVICE_BROWSE_CALLBACK browse;
+    DNS_QUERY_COMPLETION_ROUTINE *browse2;
+    PDNS_SERVICE_RESOLVE_COMPLETE resolve;
+    PDNS_SERVICE_REGISTER_COMPLETE registered;
+    DNS_SERVICE_INSTANCE *instance;     /* MDNS_REGISTER: what is advertised */
+    PDNS_SERVICE_REGISTER_COMPLETE deregistered;  /* DnsServiceDeRegister's callback */
+    void *deregister_context;
+    WCHAR *query;                       /* the name asked for */
+    PDNS_SERVICE_CANCEL cancel;
+    DNS_SERVICE_CANCEL own_cancel;
+    LONG cancelled;
+};
+
+static struct mdns_request *requests;   /* those running, for the cancel calls */
+static CRITICAL_SECTION requests_cs;
+static CRITICAL_SECTION_DEBUG requests_cs_debug =
+{
+    0, 0, &requests_cs,
+    { &requests_cs_debug.ProcessLocksList, &requests_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": requests_cs") }
+};
+static CRITICAL_SECTION requests_cs = { &requests_cs_debug, -1, 0, 0, 0, 0 };
+
+static WCHAR *utf8_to_wide( const char *s )
+{
+    int len = MultiByteToWideChar( CP_UTF8, 0, s, -1, NULL, 0 );
+    WCHAR *ret = malloc( len * sizeof(WCHAR) );
+    if (ret) MultiByteToWideChar( CP_UTF8, 0, s, -1, ret, len );
+    return ret;
+}
+
+static BOOL wide_to_utf8( const WCHAR *s, char *buf, int size )
+{
+    return WideCharToMultiByte( CP_UTF8, 0, s, -1, buf, size, NULL, NULL ) > 0;
+}
+
+static WCHAR *strdupW( const WCHAR *s )
+{
+    WCHAR *ret;
+    if (!s) return NULL;
+    if ((ret = malloc( (wcslen( s ) + 1) * sizeof(WCHAR) ))) wcscpy( ret, s );
+    return ret;
+}
+
+/* "instance.<service>.<_tcp|_udp>.<domain>": the instance (when wanted), the type and the domain */
+static BOOL split_name( const char *name, BOOL instance, char *inst, char *type, char *domain )
+{
+    const char *proto = strstr( name, "._tcp." ), *p, *start;
+
+    if (!proto) proto = strstr( name, "._udp." );
+    if (!proto)
+    {
+        size_t len = strlen( name );
+        /* "_svc._tcp" without a domain */
+        if (len >= 5 && (!strcmp( name + len - 5, "._tcp" ) || !strcmp( name + len - 5, "._udp" ))) proto = name + len - 5;
+        else return FALSE;
+    }
+    /* the service label is the one before the protocol: it starts after the dot before it */
+    for (p = proto - 1; p >= name && *p != '.'; p--);
+    start = p + 1;
+    if (*start != '_') return FALSE;
+    if (instance)
+    {
+        if (p < name || p == name) return FALSE;
+        if (p - name >= MDNS_NAME_LEN) return FALSE;
+        memcpy( inst, name, p - name );
+        inst[p - name] = 0;
+    }
+    else if (p >= name) return FALSE;   /* a browse names a service type, no instance */
+    if (proto + 5 - start >= MDNS_TYPE_LEN) return FALSE;
+    memcpy( type, start, proto + 5 - start );
+    type[proto + 5 - start] = 0;
+    if (proto[5] == '.') lstrcpynA( domain, proto + 6, MDNS_TYPE_LEN );
+    else domain[0] = 0;
+    /* a trailing dot is the root */
+    if (domain[0] && domain[strlen( domain ) - 1] == '.') domain[strlen( domain ) - 1] = 0;
+    return TRUE;
+}
+
+static DNS_RECORDW *new_record( const WCHAR *name, WORD type, WORD size )
+{
+    DNS_RECORDW *r = calloc( 1, FIELD_OFFSET(DNS_RECORDW, Data) + size );
+
+    if (!r) return NULL;
+    if (!(r->pName = strdupW( name )))
+    {
+        free( r );
+        return NULL;
+    }
+    r->wType = type;
+    r->wDataLength = size;
+    r->Flags.S.Section = DnsSectionAnswer;
+    r->Flags.S.CharSet = DnsCharSetUnicode;
+    r->dwTtl = 120;
+    return r;
+}
+
+static void append( DNS_RECORDW ***tail, DNS_RECORDW *r )
+{
+    if (!r) return;
+    **tail = r;
+    *tail = &r->pNext;
+}
+
+static WCHAR *instance_name( const struct mdns_event *ev )
+{
+    char full[MDNS_NAME_LEN + 2 * MDNS_TYPE_LEN + 2];
+
+    snprintf( full, sizeof(full), "%s.%s.%s", ev->name, ev->type, ev->domain );
+    return utf8_to_wide( full );
+}
+
+/* the records of an instance found (or gone, a PTR with no time to live) */
+static DNS_RECORDW *event_records( const struct mdns_request *req, const struct mdns_event *ev )
+{
+    DNS_RECORDW *list = NULL, **tail = &list, *r;
+    WCHAR *inst = instance_name( ev ), *host = ev->host[0] ? utf8_to_wide( ev->host ) : NULL;
+    char service[2 * MDNS_TYPE_LEN + 2];
+    WCHAR *wservice;
+    UINT32 i, count;
+
+    snprintf( service, sizeof(service), "%s.%s", ev->type, ev->domain );
+    wservice = utf8_to_wide( service );
+    if (!inst || !wservice) goto done;
+
+    if ((r = new_record( wservice, DNS_TYPE_PTR, sizeof(DNS_PTR_DATAW) )))
+    {
+        if (!(r->Data.PTR.pNameHost = strdupW( inst ))) { DnsRecordListFree( (DNS_RECORD *)r, DnsFreeRecordList ); r = NULL; }
+        else if (ev->kind == MDNS_EVENT_REMOVED) r->dwTtl = 0;
+        append( &tail, r );
+    }
+    if (ev->kind == MDNS_EVENT_REMOVED || !host) goto done;
+#ifdef SG_MUTANT_MDNS_PTR_ONLY
+    goto done;
+#endif
+
+    if ((r = new_record( inst, DNS_TYPE_SRV, sizeof(DNS_SRV_DATAW) )))
+    {
+        r->Flags.S.Section = DnsSectionAddtional;
+        r->Data.SRV.wPort = ev->port;
+        if (!(r->Data.SRV.pNameTarget = strdupW( host ))) { DnsRecordListFree( (DNS_RECORD *)r, DnsFreeRecordList ); r = NULL; }
+        append( &tail, r );
+    }
+    for (i = count = 0; i < ev->txt_len; i += 1 + ev->txt[i]) count++;
+    if ((r = new_record( inst, DNS_TYPE_TEXT, FIELD_OFFSET(DNS_TXT_DATAW, pStringArray[count ? count : 1]) )))
+    {
+        UINT32 n = 0;
+        r->Flags.S.Section = DnsSectionAddtional;
+        for (i = 0; i < ev->txt_len && n < count; i += 1 + ev->txt[i])
+        {
+            char str[256];
+            memcpy( str, ev->txt + i + 1, ev->txt[i] );
+            str[ev->txt[i]] = 0;
+            if (!(r->Data.TXT.pStringArray[n] = utf8_to_wide( str ))) break;
+            n++;
+        }
+        r->Data.TXT.dwStringCount = n;
+        append( &tail, r );
+    }
+    if (ev->has_ip4 && (r = new_record( host, DNS_TYPE_A, sizeof(DNS_A_DATA) )))
+    {
+        r->Flags.S.Section = DnsSectionAddtional;
+        memcpy( &r->Data.A.IpAddress, ev->ip4, 4 );
+        append( &tail, r );
+    }
+    if (ev->has_ip6 && (r = new_record( host, DNS_TYPE_AAAA, sizeof(DNS_AAAA_DATA) )))
+    {
+        r->Flags.S.Section = DnsSectionAddtional;
+        memcpy( &r->Data.AAAA.Ip6Address, ev->ip6, 16 );
+        append( &tail, r );
+    }
+done:
+    free( inst );
+    free( host );
+    free( wservice );
+    return list;
+}
+
+static void browse_report( struct mdns_request *req, DWORD status, DNS_RECORDW *records )
+{
+    if (req->version == DNS_QUERY_REQUEST_VERSION2)
+    {
+        DNS_QUERY_RESULT result = { DNS_QUERY_RESULTS_VERSION1, status, 0, (DNS_RECORD *)records, NULL };
+        req->browse2( req->context, &result );
+    }
+    else req->browse( status, req->context, (DNS_RECORD *)records );
+}
+
+static DNS_SERVICE_INSTANCE *event_instance( const struct mdns_event *ev )
+{
+    WCHAR *inst = instance_name( ev ), *host = utf8_to_wide( ev->host ), **keys = NULL, **values = NULL;
+    DNS_SERVICE_INSTANCE *ret = NULL;
+    IP4_ADDRESS ip4;
+    IP6_ADDRESS ip6;
+    UINT32 i, count = 0, n = 0;
+
+    for (i = 0; i < ev->txt_len; i += 1 + ev->txt[i]) count++;
+    if (count && (!(keys = calloc( count, sizeof(*keys) )) || !(values = calloc( count, sizeof(*values) )))) goto done;
+    /* the properties are the TXT strings, "key=value" (a key alone has an empty value) */
+    for (i = 0; i < ev->txt_len && n < count; i += 1 + ev->txt[i])
+    {
+        char str[256], *eq;
+        memcpy( str, ev->txt + i + 1, ev->txt[i] );
+        str[ev->txt[i]] = 0;
+        if ((eq = strchr( str, '=' ))) *eq = 0;
+        keys[n] = utf8_to_wide( str );
+        values[n] = utf8_to_wide( eq ? eq + 1 : "" );
+        if (keys[n] && values[n]) n++;
+    }
+    memcpy( &ip4, ev->ip4, 4 );
+    memcpy( &ip6, ev->ip6, 16 );
+    if (inst && host)
+        ret = DnsServiceConstructInstance( inst, host, ev->has_ip4 ? &ip4 : NULL, ev->has_ip6 ? &ip6 : NULL, ev->port,
+                                           0, 0, n, (const WCHAR **)keys, (const WCHAR **)values );
+    if (ret) ret->dwInterfaceIndex = ev->interface;
+done:
+    for (i = 0; i < count; i++)
+    {
+        if (keys) free( keys[i] );
+        if (values) free( values[i] );
+    }
+    free( keys );
+    free( values );
+    free( inst );
+    free( host );
+    return ret;
+}
+
+static void remove_request( struct mdns_request *req )
+{
+    struct mdns_request **p;
+
+    EnterCriticalSection( &requests_cs );
+    for (p = &requests; *p; p = &(*p)->link.next)
+        if (*p == req)
+        {
+            *p = req->link.next;
+            break;
+        }
+    LeaveCriticalSection( &requests_cs );
+}
+
+static DWORD CALLBACK mdns_thread( void *arg )
+{
+    struct mdns_request *req = arg;
+    struct mdns_wait_params params = { req->handle, 500 };
+    struct mdns_handle_params handle = { req->handle };
+    NTSTATUS status;
+
+    for (;;)
+    {
+        status = RESOLV_CALL( mdns_wait, &params );
+        if (status == STATUS_TIMEOUT)
+        {
+            if (req->mode == MDNS_RESOLVE && !req->cancelled)
+            {
+                /* the responder gave up without an answer */
+                params.event.kind = MDNS_EVENT_FAILED;
+                params.event.error = ERROR_TIMEOUT;
+            }
+            else continue;
+        }
+        else if (status) break;
+
+        if (req->mode == MDNS_BROWSE)
+        {
+            if (params.event.kind == MDNS_EVENT_FAILED)
+            {
+                browse_report( req, params.event.error, NULL );
+                break;
+            }
+            browse_report( req, ERROR_SUCCESS, event_records( req, &params.event ) );
+        }
+        else if (req->mode == MDNS_REGISTER)
+        {
+            /* advertised until DnsServiceDeRegister, or this process ends and its connection to the
+             * responder with it */
+            if (params.event.kind == MDNS_EVENT_FAILED)
+            {
+                req->registered( params.event.error, req->context, NULL );
+                break;
+            }
+            req->registered( ERROR_SUCCESS, req->context, DnsServiceCopyInstance( req->instance ) );
+        }
+        else
+        {
+            if (params.event.kind == MDNS_EVENT_FAILED) req->resolve( params.event.error, req->context, NULL );
+            else req->resolve( ERROR_SUCCESS, req->context, event_instance( &params.event ) );
+            break;
+        }
+    }
+    remove_request( req );
+    /* a cancelled browse says so */
+    if (status == STATUS_CANCELLED && req->mode == MDNS_BROWSE) browse_report( req, ERROR_CANCELLED, NULL );
+    /* closing the session withdraws a registration */
+    RESOLV_CALL( mdns_close, &handle );
+    if (req->deregistered) req->deregistered( ERROR_SUCCESS, req->deregister_context, DnsServiceCopyInstance( req->instance ) );
+    DnsServiceFreeInstance( req->instance );
+    free( req->query );
+    free( req );
+    return 0;
+}
+
+static DNS_STATUS start_session( struct mdns_request *req, struct mdns_start_params *params )
+{
+    HANDLE thread;
+
+    params->mode = req->mode;
+    if (RESOLV_CALL( mdns_start, params )) params->error = DNS_ERROR_RCODE_SERVER_FAILURE;
+    if (params->error) return params->error;
+    req->handle = params->handle;
+    req->cancel->reserved = req;
+    EnterCriticalSection( &requests_cs );
+    req->link.next = requests;
+    requests = req;
+    LeaveCriticalSection( &requests_cs );
+    if (!(thread = CreateThread( NULL, 0, mdns_thread, req, 0, NULL )))
+    {
+        struct mdns_handle_params handle = { req->handle };
+        remove_request( req );
+        RESOLV_CALL( mdns_close, &handle );
+        return GetLastError();
+    }
+    CloseHandle( thread );
+    return DNS_REQUEST_PENDING;
+}
+
+static DNS_STATUS start_request( struct mdns_request *req, const char *name, const char *type, const char *domain,
+                                 ULONG interface )
+{
+    struct mdns_start_params *params = calloc( 1, sizeof(*params) );
+    DNS_STATUS status;
+
+    if (!params) return ERROR_OUTOFMEMORY;
+    params->interface = interface;
+    lstrcpynA( params->name, name, sizeof(params->name) );
+    lstrcpynA( params->type, type, sizeof(params->type) );
+    lstrcpynA( params->domain, domain, sizeof(params->domain) );
+    status = start_session( req, params );
+    free( params );
+    return status;
+}
+
+/******************************************************************************
+ * DnsServiceBrowse                        [DNSAPI.@]
+ */
+DNS_STATUS WINAPI DnsServiceBrowse( PDNS_SERVICE_BROWSE_REQUEST request, PDNS_SERVICE_CANCEL cancel )
+{
+    char name[MDNS_NAME_LEN], type[MDNS_TYPE_LEN], domain[MDNS_TYPE_LEN];
+    struct mdns_request *req;
+    DNS_STATUS status;
+
+    TRACE( "(%p, %p)\n", request, cancel );
+
+    if (!request || !cancel || !request->QueryName || !request->pBrowseCallback) return ERROR_INVALID_PARAMETER;
+    if (request->Version != DNS_QUERY_REQUEST_VERSION1 && request->Version != DNS_QUERY_REQUEST_VERSION2)
+        return ERROR_INVALID_PARAMETER;
+    TRACE( "%s on interface %lu\n", debugstr_w(request->QueryName), request->InterfaceIndex );
+    if (!wide_to_utf8( request->QueryName, name, sizeof(name) ) || !split_name( name, FALSE, NULL, type, domain ))
+        return ERROR_INVALID_PARAMETER;
+    if (!domain[0]) strcpy( domain, "local" );
+    if (!(req = calloc( 1, sizeof(*req) ))) return ERROR_OUTOFMEMORY;
+    req->mode = MDNS_BROWSE;
+    req->version = request->Version;
+    req->context = request->pQueryContext;
+    req->browse = request->pBrowseCallback;
+    req->browse2 = request->pBrowseCallbackV2;
+    req->cancel = cancel;
+    if ((status = start_request( req, "", type, domain, request->InterfaceIndex )) != DNS_REQUEST_PENDING) free( req );
+    return status;
+}
+
+static DNS_STATUS cancel_request( PDNS_SERVICE_CANCEL cancel, enum mdns_mode mode )
+{
+    struct mdns_request *req;
+    DNS_STATUS status = ERROR_CANCELLED;
+
+    if (!cancel) return ERROR_INVALID_PARAMETER;
+    EnterCriticalSection( &requests_cs );
+    for (req = requests; req; req = req->link.next)
+    {
+        struct mdns_handle_params handle;
+
+        if (req != cancel->reserved || req->mode != mode) continue;
+        handle.handle = req->handle;
+        req->cancelled = TRUE;
+        RESOLV_CALL( mdns_cancel, &handle );
+        status = ERROR_SUCCESS;
+        break;
+    }
+    LeaveCriticalSection( &requests_cs );
+    return status;
+}
+
+/******************************************************************************
+ * DnsServiceBrowseCancel                  [DNSAPI.@]
+ */
+DNS_STATUS WINAPI DnsServiceBrowseCancel( PDNS_SERVICE_CANCEL cancel )
+{
+    TRACE( "(%p)\n", cancel );
+    return cancel_request( cancel, MDNS_BROWSE );
+}
+
+/******************************************************************************
+ * DnsServiceResolve                       [DNSAPI.@]
+ */
+DNS_STATUS WINAPI DnsServiceResolve( PDNS_SERVICE_RESOLVE_REQUEST request, PDNS_SERVICE_CANCEL cancel )
+{
+    char name[MDNS_NAME_LEN + 2 * MDNS_TYPE_LEN], inst[MDNS_NAME_LEN], type[MDNS_TYPE_LEN], domain[MDNS_TYPE_LEN];
+    struct mdns_request *req;
+    DNS_STATUS status;
+
+    TRACE( "(%p, %p)\n", request, cancel );
+
+    if (!request || !cancel || !request->QueryName || !request->pResolveCompletionCallback) return ERROR_INVALID_PARAMETER;
+    if (request->Version != DNS_QUERY_REQUEST_VERSION1) return ERROR_INVALID_PARAMETER;
+    TRACE( "%s on interface %lu\n", debugstr_w(request->QueryName), request->InterfaceIndex );
+    if (!wide_to_utf8( request->QueryName, name, sizeof(name) ) || !split_name( name, TRUE, inst, type, domain ))
+        return ERROR_INVALID_PARAMETER;
+    if (!domain[0]) strcpy( domain, "local" );
+    if (!(req = calloc( 1, sizeof(*req) ))) return ERROR_OUTOFMEMORY;
+    req->mode = MDNS_RESOLVE;
+    req->version = request->Version;
+    req->context = request->pQueryContext;
+    req->resolve = request->pResolveCompletionCallback;
+    req->cancel = cancel;
+    if ((status = start_request( req, inst, type, domain, request->InterfaceIndex )) != DNS_REQUEST_PENDING) free( req );
+    return status;
+}
+
+/******************************************************************************
+ * DnsServiceResolveCancel                 [DNSAPI.@]
+ */
+DNS_STATUS WINAPI DnsServiceResolveCancel( PDNS_SERVICE_CANCEL cancel )
+{
+    TRACE( "(%p)\n", cancel );
+    return cancel_request( cancel, MDNS_RESOLVE );
+}
+
+/******************************************************************************
+ * DnsServiceConstructInstance             [DNSAPI.@]
+ */
+PDNS_SERVICE_INSTANCE WINAPI DnsServiceConstructInstance( const WCHAR *service, const WCHAR *host, IP4_ADDRESS *ip4,
+                                                          IP6_ADDRESS *ip6, WORD port, WORD priority, WORD weight,
+                                                          DWORD count, const WCHAR **keys, const WCHAR **values )
+{
+    DNS_SERVICE_INSTANCE *inst;
+    DWORD i;
+
+    TRACE( "%s %s %p %p %u %u %u %lu %p %p\n", debugstr_w(service), debugstr_w(host), ip4, ip6, port, priority,
+           weight, count, keys, values );
+
+    if (!service || (count && (!keys || !values)))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!(inst = calloc( 1, sizeof(*inst) ))) return NULL;
+    inst->pszInstanceName = strdupW( service );
+    inst->pszHostName = strdupW( host );
+    if (ip4 && (inst->ip4Address = malloc( sizeof(*ip4) ))) *inst->ip4Address = *ip4;
+    if (ip6 && (inst->ip6Address = malloc( sizeof(*ip6) ))) *inst->ip6Address = *ip6;
+    inst->wPort = port;
+    inst->wPriority = priority;
+    inst->wWeight = weight;
+    if (count)
+    {
+        inst->keys = calloc( count, sizeof(*inst->keys) );
+        inst->values = calloc( count, sizeof(*inst->values) );
+        if (inst->keys && inst->values)
+            for (i = 0; i < count; i++)
+            {
+                inst->keys[i] = strdupW( keys[i] );
+                inst->values[i] = strdupW( values[i] );
+            }
+        inst->dwPropertyCount = count;
+    }
+    if (!inst->pszInstanceName || (host && !inst->pszHostName) || (count && (!inst->keys || !inst->values)) ||
+        (ip4 && !inst->ip4Address) || (ip6 && !inst->ip6Address))
+    {
+        DnsServiceFreeInstance( inst );
+        SetLastError( ERROR_OUTOFMEMORY );
+        return NULL;
+    }
+    return inst;
+}
+
+/******************************************************************************
+ * DnsServiceCopyInstance                  [DNSAPI.@]
+ */
+PDNS_SERVICE_INSTANCE WINAPI DnsServiceCopyInstance( PDNS_SERVICE_INSTANCE orig )
+{
+    DNS_SERVICE_INSTANCE *inst;
+
+    TRACE( "%p\n", orig );
+    if (!orig) return NULL;
+    inst = DnsServiceConstructInstance( orig->pszInstanceName, orig->pszHostName, orig->ip4Address, orig->ip6Address,
+                                        orig->wPort, orig->wPriority, orig->wWeight, orig->dwPropertyCount,
+                                        (const WCHAR **)orig->keys, (const WCHAR **)orig->values );
+    if (inst) inst->dwInterfaceIndex = orig->dwInterfaceIndex;
+    return inst;
+}
+
+/******************************************************************************
+ * DnsServiceFreeInstance                  [DNSAPI.@]
+ */
+void WINAPI DnsServiceFreeInstance( PDNS_SERVICE_INSTANCE inst )
+{
+    DWORD i;
+
+    TRACE( "%p\n", inst );
+    if (!inst) return;
+    for (i = 0; i < inst->dwPropertyCount; i++)
+    {
+        if (inst->keys) free( inst->keys[i] );
+        if (inst->values) free( inst->values[i] );
+    }
+    free( inst->keys );
+    free( inst->values );
+    free( inst->pszInstanceName );
+    free( inst->pszHostName );
+    free( inst->ip4Address );
+    free( inst->ip6Address );
+    free( inst );
+}
+
+/******************************************************************************
+ * DnsServiceRegister                      [DNSAPI.@]
+ *
+ * Advertises the instance through the system's responder while this process holds the registration.
+ */
+DWORD WINAPI DnsServiceRegister( PDNS_SERVICE_REGISTER_REQUEST request, PDNS_SERVICE_CANCEL cancel )
+{
+    char full[MDNS_NAME_LEN + 2 * MDNS_TYPE_LEN];
+    struct mdns_start_params *params;
+    const DNS_SERVICE_INSTANCE *inst;
+    struct mdns_request *req, *other;
+    DNS_STATUS status;
+    DWORD i;
+
+    TRACE( "(%p, %p)\n", request, cancel );
+
+    if (!request || !request->pServiceInstance || !request->pRegisterCompletionCallback ||
+        request->Version != DNS_QUERY_REQUEST_VERSION1)
+        return ERROR_INVALID_PARAMETER;
+    inst = request->pServiceInstance;
+    TRACE( "%s %s port %u\n", debugstr_w(inst->pszInstanceName), debugstr_w(inst->pszHostName), inst->wPort );
+    if (!inst->pszInstanceName || !(params = calloc( 1, sizeof(*params) ))) return ERROR_INVALID_PARAMETER;
+    status = ERROR_INVALID_PARAMETER;
+    if (!wide_to_utf8( inst->pszInstanceName, full, sizeof(full) ) ||
+        !split_name( full, TRUE, params->name, params->type, params->domain ))
+        goto done;
+    if (!params->domain[0]) strcpy( params->domain, "local" );
+    if (inst->pszHostName && !wide_to_utf8( inst->pszHostName, params->host, sizeof(params->host) )) goto done;
+    /* this machine's own name is the responder's to give */
+    {
+        char self[MDNS_NAME_LEN];
+        DWORD len = sizeof(self);
+        if (GetComputerNameExA( ComputerNameDnsHostname, self, &len ) && !strncasecmp( params->host, self, len ) &&
+            (!params->host[len] || params->host[len] == '.'))
+            params->host[0] = 0;
+    }
+    params->port = inst->wPort;
+    params->interface = request->InterfaceIndex;
+    for (i = 0; i < inst->dwPropertyCount; i++)
+    {
+        char kv[256 + 2], key[128], value[128];
+        size_t len;
+
+        if (!inst->keys || !inst->keys[i] || !wide_to_utf8( inst->keys[i], key, sizeof(key) )) goto done;
+        if (inst->values && inst->values[i] && inst->values[i][0])
+        {
+            if (!wide_to_utf8( inst->values[i], value, sizeof(value) )) goto done;
+            snprintf( kv, sizeof(kv), "%s=%s", key, value );
+        }
+        else snprintf( kv, sizeof(kv), "%s", key );
+        len = strlen( kv );
+        if (len > 255 || params->txt_len + 1 + len > sizeof(params->txt)) goto done;
+        params->txt[params->txt_len++] = len;
+        memcpy( params->txt + params->txt_len, kv, len );
+        params->txt_len += len;
+    }
+    /* one registration of a name per process */
+    EnterCriticalSection( &requests_cs );
+    for (other = requests; other; other = other->link.next)
+        if (other->mode == MDNS_REGISTER && !wcsicmp( other->instance->pszInstanceName, inst->pszInstanceName )) break;
+    LeaveCriticalSection( &requests_cs );
+    if (other)
+    {
+        status = DNS_ERROR_RECORD_ALREADY_EXISTS;
+        goto done;
+    }
+    status = ERROR_OUTOFMEMORY;
+    if (!(req = calloc( 1, sizeof(*req) ))) goto done;
+    req->mode = MDNS_REGISTER;
+    req->version = request->Version;
+    req->context = request->pQueryContext;
+    req->registered = request->pRegisterCompletionCallback;
+    if (!(req->instance = DnsServiceCopyInstance( request->pServiceInstance )))
+    {
+        free( req );
+        goto done;
+    }
+    /* the cancel structure is optional: DnsServiceDeRegister finds the registration by its name */
+    req->cancel = cancel ? cancel : &req->own_cancel;
+    if ((status = start_session( req, params )) != DNS_REQUEST_PENDING)
+    {
+        DnsServiceFreeInstance( req->instance );
+        free( req );
+    }
+done:
+    free( params );
+    return status;
+}
+
+/******************************************************************************
+ * DnsServiceDeRegister                    [DNSAPI.@]
+ */
+DWORD WINAPI DnsServiceDeRegister( PDNS_SERVICE_REGISTER_REQUEST request, PDNS_SERVICE_CANCEL cancel )
+{
+    struct mdns_request *req;
+    DWORD status = ERROR_NOT_FOUND;
+
+    TRACE( "(%p, %p)\n", request, cancel );
+
+    if (!request || !request->pServiceInstance || !request->pServiceInstance->pszInstanceName ||
+        !request->pRegisterCompletionCallback)
+        return ERROR_INVALID_PARAMETER;
+    EnterCriticalSection( &requests_cs );
+    for (req = requests; req; req = req->link.next)
+    {
+        struct mdns_handle_params handle;
+
+        if (req->mode != MDNS_REGISTER || req->cancelled ||
+            wcsicmp( req->instance->pszInstanceName, request->pServiceInstance->pszInstanceName ))
+            continue;
+        req->deregistered = request->pRegisterCompletionCallback;
+        req->deregister_context = request->pQueryContext;
+        req->cancelled = TRUE;
+        handle.handle = req->handle;
+#ifndef SG_MUTANT_MDNS_KEEP_REGISTERED
+        RESOLV_CALL( mdns_cancel, &handle );
+#endif
+        status = DNS_REQUEST_PENDING;
+        break;
+    }
+    LeaveCriticalSection( &requests_cs );
+    return status;
+}
+
+/******************************************************************************
+ * DnsServiceRegisterCancel                [DNSAPI.@]
+ */
+DWORD WINAPI DnsServiceRegisterCancel( PDNS_SERVICE_CANCEL cancel )
+{
+    TRACE( "(%p)\n", cancel );
+    return cancel_request( cancel, MDNS_REGISTER );
+}
diff --git a/dlls/dnsapi/mdnsunix.c b/dlls/dnsapi/mdnsunix.c
new file mode 100644
index 0000000..9a0413a
--- /dev/null
+++ b/dlls/dnsapi/mdnsunix.c
@@ -0,0 +1,513 @@
+/*
+ * Multicast DNS service discovery through the system's avahi daemon
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
