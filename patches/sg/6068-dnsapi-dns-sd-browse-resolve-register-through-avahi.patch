+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+/*
+ * The system's mDNS responder (avahi-daemon) does the multicast work: this
+ * is one of its clients, loaded with dlopen so that dnsapi has no hard
+ * dependency on it. A session is a client connection with its own poll
+ * loop, a service browser or resolver on it, and the events they produced
+ * for dnsapi's thread to take one at a time. Nothing is published and no
+ * port is opened here: the daemon answers the queries it makes.
+ */
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <dlfcn.h>
+#include <pthread.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "windns.h"
+
+#include "wine/debug.h"
+#include "dnsapi.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dnsapi);
+
+/* avahi's client interface, as its headers describe it */
+typedef struct AvahiPoll AvahiPoll;
+typedef struct AvahiSimplePoll AvahiSimplePoll;
+typedef struct AvahiClient AvahiClient;
+typedef struct AvahiServiceBrowser AvahiServiceBrowser;
+typedef struct AvahiServiceResolver AvahiServiceResolver;
+typedef struct AvahiEntryGroup AvahiEntryGroup;
+typedef int AvahiIfIndex;
+typedef int AvahiProtocol;
+typedef struct AvahiStringList
+{
+    struct AvahiStringList *next;
+    size_t size;
+    uint8_t text[1];
+} AvahiStringList;
+typedef struct
+{
+    AvahiProtocol proto;
+    union
+    {
+        struct { uint8_t address[16]; } ipv6;
+        struct { uint32_t address; } ipv4;
+        uint8_t data[1];
+    } data;
+} AvahiAddress;
+
+#define AVAHI_IF_UNSPEC     (-1)
+#define AVAHI_PROTO_INET    0
+#define AVAHI_PROTO_INET6   1
+#define AVAHI_PROTO_UNSPEC  (-1)
+enum { AVAHI_BROWSER_NEW, AVAHI_BROWSER_REMOVE, AVAHI_BROWSER_CACHE_EXHAUSTED, AVAHI_BROWSER_ALL_FOR_NOW, AVAHI_BROWSER_FAILURE };
+enum { AVAHI_RESOLVER_FOUND, AVAHI_RESOLVER_FAILURE };
+enum { AVAHI_CLIENT_S_REGISTERING = 1, AVAHI_CLIENT_S_RUNNING = 2, AVAHI_CLIENT_S_COLLISION = 3,
+       AVAHI_CLIENT_FAILURE = 100, AVAHI_CLIENT_CONNECTING = 101 };
+enum { AVAHI_ENTRY_GROUP_UNCOMMITED, AVAHI_ENTRY_GROUP_REGISTERING, AVAHI_ENTRY_GROUP_ESTABLISHED,
+       AVAHI_ENTRY_GROUP_COLLISION, AVAHI_ENTRY_GROUP_FAILURE };
+#define AVAHI_ERR_COLLISION (-8)
+#define AVAHI_ERR_TIMEOUT   (-14)
+#define AVAHI_ERR_NOT_FOUND (-28)
+
+typedef void (*AvahiClientCallback)( AvahiClient *, int state, void * );
+typedef void (*AvahiServiceBrowserCallback)( AvahiServiceBrowser *, AvahiIfIndex, AvahiProtocol, int event,
+                                             const char *name, const char *type, const char *domain, int flags,
+                                             void * );
+typedef void (*AvahiEntryGroupCallback)( AvahiEntryGroup *, int state, void * );
+typedef void (*AvahiServiceResolverCallback)( AvahiServiceResolver *, AvahiIfIndex, AvahiProtocol, int event,
+                                              const char *name, const char *type, const char *domain,
+                                              const char *host, const AvahiAddress *, uint16_t port,
+                                              AvahiStringList *txt, int flags, void * );
+
+static AvahiSimplePoll *(*p_avahi_simple_poll_new)(void);
+static void (*p_avahi_simple_poll_free)(AvahiSimplePoll *);
+static const AvahiPoll *(*p_avahi_simple_poll_get)(AvahiSimplePoll *);
+static int (*p_avahi_simple_poll_iterate)(AvahiSimplePoll *, int);
+static AvahiClient *(*p_avahi_client_new)(const AvahiPoll *, int, AvahiClientCallback, void *, int *);
+static void (*p_avahi_client_free)(AvahiClient *);
+static int (*p_avahi_client_errno)(AvahiClient *);
+static AvahiServiceBrowser *(*p_avahi_service_browser_new)(AvahiClient *, AvahiIfIndex, AvahiProtocol, const char *,
+                                                           const char *, int, AvahiServiceBrowserCallback, void *);
+static int (*p_avahi_service_browser_free)(AvahiServiceBrowser *);
+static AvahiServiceResolver *(*p_avahi_service_resolver_new)(AvahiClient *, AvahiIfIndex, AvahiProtocol, const char *,
+                                                             const char *, const char *, AvahiProtocol, int,
+                                                             AvahiServiceResolverCallback, void *);
+static int (*p_avahi_service_resolver_free)(AvahiServiceResolver *);
+static AvahiEntryGroup *(*p_avahi_entry_group_new)(AvahiClient *, AvahiEntryGroupCallback, void *);
+static int (*p_avahi_entry_group_add_service_strlst)(AvahiEntryGroup *, AvahiIfIndex, AvahiProtocol, int,
+                                                     const char *, const char *, const char *, const char *,
+                                                     uint16_t, AvahiStringList *);
+static int (*p_avahi_entry_group_commit)(AvahiEntryGroup *);
+static int (*p_avahi_entry_group_free)(AvahiEntryGroup *);
+static AvahiStringList *(*p_avahi_string_list_add_arbitrary)(AvahiStringList *, const uint8_t *, size_t);
+static void (*p_avahi_string_list_free)(AvahiStringList *);
+
+static pthread_once_t init_once = PTHREAD_ONCE_INIT;
+static BOOL avahi_loaded;
+
+static void load_avahi(void)
+{
+    void *common = dlopen( "libavahi-common.so.3", RTLD_NOW ), *client = dlopen( "libavahi-client.so.3", RTLD_NOW );
+
+    if (!common || !client)
+    {
+        WARN( "avahi is not installed\n" );
+        return;
+    }
+#define LOAD( lib, f ) if (!(p_##f = dlsym( lib, #f ))) { WARN( "no %s\n", #f ); return; }
+    LOAD( common, avahi_simple_poll_new )
+    LOAD( common, avahi_simple_poll_free )
+    LOAD( common, avahi_simple_poll_get )
+    LOAD( common, avahi_simple_poll_iterate )
+    LOAD( client, avahi_client_new )
+    LOAD( client, avahi_client_free )
+    LOAD( client, avahi_client_errno )
+    LOAD( client, avahi_service_browser_new )
+    LOAD( client, avahi_service_browser_free )
+    LOAD( client, avahi_service_resolver_new )
+    LOAD( client, avahi_service_resolver_free )
+    LOAD( client, avahi_entry_group_new )
+    LOAD( client, avahi_entry_group_add_service_strlst )
+    LOAD( client, avahi_entry_group_commit )
+    LOAD( client, avahi_entry_group_free )
+    LOAD( common, avahi_string_list_add_arbitrary )
+    LOAD( common, avahi_string_list_free )
+#undef LOAD
+    avahi_loaded = TRUE;
+}
+
+struct resolver
+{
+    struct session *session;
+    AvahiServiceResolver *r;
+    struct resolver *next;
+};
+
+struct seen
+{
+    AvahiIfIndex interface;
+    char name[MDNS_NAME_LEN];
+};
+
+struct session
+{
+    enum mdns_mode mode;
+    AvahiSimplePoll *poll;
+    AvahiClient *client;
+    AvahiServiceBrowser *browser;
+    AvahiEntryGroup *group;             /* MDNS_REGISTER: the published service, withdrawn when freed */
+    struct resolver *resolvers;
+    struct mdns_event *events;
+    unsigned int event_count, event_alloc;
+    struct seen *seen;
+    unsigned int seen_count;
+    volatile LONG cancelled;
+    BOOL done;                          /* a resolve that has its answer */
+    char type[MDNS_TYPE_LEN], domain[MDNS_TYPE_LEN];
+};
+
+static DWORD map_avahi_error( int error )
+{
+    if (error == AVAHI_ERR_TIMEOUT) return ERROR_TIMEOUT;
+    if (error == AVAHI_ERR_NOT_FOUND) return DNS_ERROR_RCODE_NAME_ERROR;
+    return DNS_ERROR_RCODE_SERVER_FAILURE;
+}
+
+static struct mdns_event *new_event( struct session *s, UINT32 kind )
+{
+    struct mdns_event *events;
+
+    if (s->event_count == s->event_alloc)
+    {
+        unsigned int alloc = s->event_alloc ? s->event_alloc * 2 : 8;
+        if (!(events = realloc( s->events, alloc * sizeof(*events) ))) return NULL;
+        s->events = events;
+        s->event_alloc = alloc;
+    }
+    memset( &s->events[s->event_count], 0, sizeof(s->events[0]) );
+    s->events[s->event_count].kind = kind;
+    return &s->events[s->event_count++];
+}
+
+static void copy_str( char *dst, const char *src, size_t size )
+{
+    size_t len;
+
+    if (!src) src = "";
+    len = strlen( src );
+    if (len >= size) len = size - 1;
+    memcpy( dst, src, len );
+    dst[len] = 0;
+}
+
+static void resolver_callback( AvahiServiceResolver *r, AvahiIfIndex interface, AvahiProtocol protocol, int event,
+                               const char *name, const char *type, const char *domain, const char *host,
+                               const AvahiAddress *addr, uint16_t port, AvahiStringList *txt, int flags, void *user )
+{
+    struct resolver *res = user;
+    struct session *s = res->session;
+    struct mdns_event *ev;
+    AvahiStringList *l;
+
+    TRACE( "%s %s %s: event %d host %s port %u\n", debugstr_a(name), debugstr_a(type), debugstr_a(domain), event,
+           debugstr_a(host), port );
+    if (event == AVAHI_RESOLVER_FOUND)
+    {
+        if (!(ev = new_event( s, MDNS_EVENT_FOUND ))) return;
+        ev->interface = interface < 0 ? 0 : interface;
+        copy_str( ev->name, name, sizeof(ev->name) );
+        copy_str( ev->type, type, sizeof(ev->type) );
+        copy_str( ev->domain, domain, sizeof(ev->domain) );
+        copy_str( ev->host, host, sizeof(ev->host) );
+        ev->port = port;
+        if (addr && addr->proto == AVAHI_PROTO_INET)
+        {
+            ev->has_ip4 = 1;
+            memcpy( ev->ip4, &addr->data.ipv4.address, 4 );
+        }
+        else if (addr && addr->proto == AVAHI_PROTO_INET6)
+        {
+            ev->has_ip6 = 1;
+            memcpy( ev->ip6, addr->data.ipv6.address, 16 );
+        }
+        for (l = txt; l; l = l->next)
+        {
+            size_t len = l->size > 255 ? 255 : l->size;
+            if (ev->txt_len + 1 + len > sizeof(ev->txt)) break;
+            ev->txt[ev->txt_len++] = len;
+            memcpy( ev->txt + ev->txt_len, l->text, len );
+            ev->txt_len += len;
+        }
+    }
+    else if (s->mode == MDNS_RESOLVE)
+    {
+        if (!(ev = new_event( s, MDNS_EVENT_FAILED ))) return;
+        ev->error = map_avahi_error( p_avahi_client_errno( s->client ) );
+    }
+    else
+    {
+        /* found by the browser but not resolved: it is reported without its target */
+        if (!(ev = new_event( s, MDNS_EVENT_FOUND ))) return;
+        ev->interface = interface < 0 ? 0 : interface;
+        copy_str( ev->name, name, sizeof(ev->name) );
+        copy_str( ev->type, type, sizeof(ev->type) );
+        copy_str( ev->domain, domain, sizeof(ev->domain) );
+    }
+    if (s->mode == MDNS_RESOLVE) s->done = TRUE;
+}
+
+static void browser_callback( AvahiServiceBrowser *b, AvahiIfIndex interface, AvahiProtocol protocol, int event,
+                              const char *name, const char *type, const char *domain, int flags, void *user )
+{
+    struct session *s = user;
+    struct mdns_event *ev;
+    struct resolver *res;
+    unsigned int i;
+
+    TRACE( "event %d interface %d protocol %d %s %s %s\n", event, interface, protocol, debugstr_a(name),
+           debugstr_a(type), debugstr_a(domain) );
+    switch (event)
+    {
+    case AVAHI_BROWSER_NEW:
+        /* an instance is seen once on each interface, whichever protocols announce it */
+        for (i = 0; i < s->seen_count; i++)
+            if (s->seen[i].interface == interface && !strcmp( s->seen[i].name, name )) return;
+        {
+            struct seen *grown = realloc( s->seen, (s->seen_count + 1) * sizeof(*grown) );
+            if (!grown) return;
+            s->seen = grown;
+            grown[s->seen_count].interface = interface;
+            copy_str( grown[s->seen_count++].name, name, MDNS_NAME_LEN );
+        }
+        if (!(res = calloc( 1, sizeof(*res) ))) return;
+        res->session = s;
+        if (!(res->r = p_avahi_service_resolver_new( s->client, interface, protocol, name, type, domain,
+                                                     AVAHI_PROTO_UNSPEC, 0, resolver_callback, res )))
+        {
+            free( res );
+            return;
+        }
+        res->next = s->resolvers;
+        s->resolvers = res;
+        break;
+    case AVAHI_BROWSER_REMOVE:
+        for (i = 0; i < s->seen_count; i++)
+            if (s->seen[i].interface == interface && !strcmp( s->seen[i].name, name ))
+            {
+                s->seen[i] = s->seen[--s->seen_count];
+                break;
+            }
+        if (!(ev = new_event( s, MDNS_EVENT_REMOVED ))) return;
+        ev->interface = interface < 0 ? 0 : interface;
+        copy_str( ev->name, name, sizeof(ev->name) );
+        copy_str( ev->type, type, sizeof(ev->type) );
+        copy_str( ev->domain, domain, sizeof(ev->domain) );
+        break;
+    case AVAHI_BROWSER_FAILURE:
+        if (!(ev = new_event( s, MDNS_EVENT_FAILED ))) return;
+        ev->error = map_avahi_error( p_avahi_client_errno( s->client ) );
+        break;
+    default:
+        break;
+    }
+}
+
+static void group_callback( AvahiEntryGroup *group, int state, void *user )
+{
+    struct session *s = user;
+    struct mdns_event *ev;
+
+    TRACE( "entry group state %d\n", state );
+    if (state == AVAHI_ENTRY_GROUP_ESTABLISHED)
+    {
+        if ((ev = new_event( s, MDNS_EVENT_FOUND ))) copy_str( ev->type, s->type, sizeof(ev->type) );
+    }
+    else if (state == AVAHI_ENTRY_GROUP_COLLISION || state == AVAHI_ENTRY_GROUP_FAILURE)
+    {
+        /* another host has the name: nothing is advertised */
+        if ((ev = new_event( s, MDNS_EVENT_FAILED )))
+            ev->error = state == AVAHI_ENTRY_GROUP_COLLISION ? DNS_ERROR_RECORD_ALREADY_EXISTS
+                                                             : DNS_ERROR_RCODE_SERVER_FAILURE;
+    }
+}
+
+static void client_callback( AvahiClient *client, int state, void *user )
+{
+    TRACE( "client state %d\n", state );
+}
+
+static void session_free( struct session *s )
+{
+    struct resolver *res, *next;
+
+    for (res = s->resolvers; res; res = next)
+    {
+        next = res->next;
+        p_avahi_service_resolver_free( res->r );
+        free( res );
+    }
+    if (s->group) p_avahi_entry_group_free( s->group );
+    if (s->browser) p_avahi_service_browser_free( s->browser );
+    if (s->client) p_avahi_client_free( s->client );
+    if (s->poll) p_avahi_simple_poll_free( s->poll );
+    free( s->events );
+    free( s->seen );
+    free( s );
+}
+
+NTSTATUS mdns_start( void *args )
+{
+    struct mdns_start_params *params = args;
+    AvahiIfIndex interface = params->interface ? (AvahiIfIndex)params->interface : AVAHI_IF_UNSPEC;
+    struct session *s;
+    int error = 0;
+
+    params->handle = 0;
+    params->error = ERROR_SUCCESS;
+    pthread_once( &init_once, load_avahi );
+    if (!avahi_loaded)
+    {
+        params->error = ERROR_SERVICE_DOES_NOT_EXIST;
+        return STATUS_SUCCESS;
+    }
+    if (!(s = calloc( 1, sizeof(*s) )))
+    {
+        params->error = ERROR_OUTOFMEMORY;
+        return STATUS_SUCCESS;
+    }
+    s->mode = params->mode;
+    copy_str( s->type, params->type, sizeof(s->type) );
+    copy_str( s->domain, params->domain, sizeof(s->domain) );
+    if (!(s->poll = p_avahi_simple_poll_new()) ||
+        !(s->client = p_avahi_client_new( p_avahi_simple_poll_get( s->poll ), 0, client_callback, s, &error )))
+    {
+        /* no daemon: the multicast responder is not running */
+        WARN( "cannot reach the avahi daemon (%d)\n", error );
+        params->error = ERROR_SERVICE_NOT_ACTIVE;
+        session_free( s );
+        return STATUS_SUCCESS;
+    }
+    if (s->mode == MDNS_BROWSE)
+    {
+        s->browser = p_avahi_service_browser_new( s->client, interface, AVAHI_PROTO_UNSPEC, s->type,
+                                                  s->domain[0] ? s->domain : NULL, 0, browser_callback, s );
+        if (!s->browser) params->error = map_avahi_error( p_avahi_client_errno( s->client ) );
+    }
+    else if (s->mode == MDNS_REGISTER)
+    {
+        AvahiStringList *txt = NULL;
+        UINT32 i;
+        int ret;
+
+        for (i = 0; i < params->txt_len && i + 1 + params->txt[i] <= params->txt_len; i += 1 + params->txt[i])
+            txt = p_avahi_string_list_add_arbitrary( txt, params->txt + i + 1, params->txt[i] );
+        if (!(s->group = p_avahi_entry_group_new( s->client, group_callback, s )))
+            params->error = map_avahi_error( p_avahi_client_errno( s->client ) );
+        else if ((ret = p_avahi_entry_group_add_service_strlst( s->group, interface, AVAHI_PROTO_UNSPEC, 0, params->name,
+                                                                s->type, s->domain[0] ? s->domain : NULL,
+                                                                params->host[0] ? params->host : NULL,
+                                                                params->port, txt )) ||
+                 (ret = p_avahi_entry_group_commit( s->group )))
+            params->error = ret == AVAHI_ERR_COLLISION ? DNS_ERROR_RECORD_ALREADY_EXISTS : ERROR_INVALID_PARAMETER;
+        if (txt) p_avahi_string_list_free( txt );
+    }
+    else
+    {
+        struct resolver *res = calloc( 1, sizeof(*res) );
+        if (res)
+        {
+            res->session = s;
+            res->r = p_avahi_service_resolver_new( s->client, interface, AVAHI_PROTO_UNSPEC, params->name, s->type,
+                                                   s->domain[0] ? s->domain : NULL, AVAHI_PROTO_UNSPEC, 0,
+                                                   resolver_callback, res );
+            if (res->r) s->resolvers = res;
+            else
+            {
+                free( res );
+                params->error = map_avahi_error( p_avahi_client_errno( s->client ) );
+            }
+        }
+        else params->error = ERROR_OUTOFMEMORY;
+    }
+    if (params->error)
+    {
+        session_free( s );
+        return STATUS_SUCCESS;
+    }
+    params->handle = (UINT_PTR)s;
+    return STATUS_SUCCESS;
+}
+
+/* the next event, waiting for one at most the timeout; STATUS_TIMEOUT when none came, STATUS_CANCELLED once
+ * the session is cancelled */
+NTSTATUS mdns_wait( void *args )
+{
+    struct mdns_wait_params *params = args;
+    struct session *s = (struct session *)(UINT_PTR)params->handle;
+    int waited = 0;
+
+    if (!s) return STATUS_INVALID_HANDLE;
+    for (;;)
+    {
+        if (s->cancelled) return STATUS_CANCELLED;
+        if (s->event_count)
+        {
+            params->event = s->events[0];
+            memmove( s->events, s->events + 1, --s->event_count * sizeof(s->events[0]) );
+            return STATUS_SUCCESS;
+        }
+        if (s->done || waited >= params->timeout) return STATUS_TIMEOUT;
+        /* short steps, so that a cancel is seen soon */
+        if (p_avahi_simple_poll_iterate( s->poll, 100 ) < 0)
+        {
+            struct mdns_event *ev = new_event( s, MDNS_EVENT_FAILED );
+            if (ev) ev->error = DNS_ERROR_RCODE_SERVER_FAILURE;
+            s->done = TRUE;
+        }
+        waited += 100;
+    }
+}
+
+NTSTATUS mdns_cancel( void *args )
+{
+    struct mdns_handle_params *params = args;
+    struct session *s = (struct session *)(UINT_PTR)params->handle;
+
+    if (!s) return STATUS_INVALID_HANDLE;
+    __atomic_store_n( &s->cancelled, 1, __ATOMIC_SEQ_CST );
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS mdns_close( void *args )
+{
+    struct mdns_handle_params *params = args;
+    struct session *s = (struct session *)(UINT_PTR)params->handle;
+
+    if (!s) return STATUS_INVALID_HANDLE;
+    session_free( s );
+    return STATUS_SUCCESS;
+}
