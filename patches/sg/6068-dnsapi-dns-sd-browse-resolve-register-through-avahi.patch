From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dnsapi: DNS-SD browse, resolve and register through the system's avahi (6068)

DnsServiceBrowse returned success without ever calling back, and
DnsServiceResolve, DnsServiceRegister and the instance helpers were
missing. They go through the system's avahi daemon, loaded at run time:
a browse reports each instance's PTR, SRV, TXT and address records and a
PTR with no time to live when it goes; a resolve gives the instance; a
registration is advertised while the program holds it, until
DnsServiceDeRegister or the program's end. Cancel calls end them.
---
diff --git a/dlls/dnsapi/Makefile.in b/dlls/dnsapi/Makefile.in
index d346be2..da673b4 100644
--- a/dlls/dnsapi/Makefile.in
+++ b/dlls/dnsapi/Makefile.in
@@ -3,11 +3,13 @@ UNIXLIB   = dnsapi.so
 IMPORTLIB = dnsapi
 IMPORTS      = advapi32
 DELAYIMPORTS = netapi32
-UNIX_LIBS    = $(RESOLV_LIBS)
+UNIX_LIBS    = $(RESOLV_LIBS) $(PTHREAD_LIBS)
 
 SOURCES = \
 	libresolv.c \
 	main.c \
+	mdns.c \
+	mdnsunix.c \
 	name.c \
 	query.c \
 	record.c \
diff --git a/dlls/dnsapi/dnsapi.h b/dlls/dnsapi/dnsapi.h
index d2b57b9..6541e74 100644
--- a/dlls/dnsapi/dnsapi.h
+++ b/dlls/dnsapi/dnsapi.h
@@ -121,13 +121,76 @@ struct query_params
     DWORD           *len;
 };
 
+/* multicast DNS service discovery through the system's avahi daemon (mdns.c); the
+ * structures hold no pointers, so 32-bit callers share them */
+#define MDNS_NAME_LEN 256
+#define MDNS_TYPE_LEN 64
+#define MDNS_TXT_LEN  1300
+
+enum mdns_mode { MDNS_BROWSE = 1, MDNS_RESOLVE = 2, MDNS_REGISTER = 3 };
+enum mdns_event_kind { MDNS_EVENT_FOUND = 1, MDNS_EVENT_REMOVED = 2, MDNS_EVENT_FAILED = 3 };
+
+struct mdns_event
+{
+    UINT32 kind;
+    UINT32 interface;               /* the system's interface index */
+    UINT32 error;                   /* MDNS_EVENT_FAILED: a Win32 error */
+    char   name[MDNS_NAME_LEN];     /* the instance's name, as it is */
+    char   type[MDNS_TYPE_LEN];     /* "_ipp._tcp" */
+    char   domain[MDNS_TYPE_LEN];   /* "local" */
+    char   host[MDNS_NAME_LEN];     /* "printer.local", empty when not resolved */
+    UINT16 port;
+    UINT8  has_ip4, has_ip6;
+    UINT8  ip4[4];
+    UINT8  ip6[16];
+    UINT32 txt_len;
+    UINT8  txt[MDNS_TXT_LEN];       /* the TXT strings, each after its length byte */
+};
+
+struct mdns_start_params
+{
+    UINT64 handle;                  /* out */
+    UINT32 mode;
+    UINT32 interface;               /* 0: any */
+    UINT32 error;                   /* out: a Win32 error */
+    char   name[MDNS_NAME_LEN];     /* MDNS_RESOLVE, MDNS_REGISTER: the instance */
+    char   type[MDNS_TYPE_LEN];
+    char   domain[MDNS_TYPE_LEN];
+    char   host[MDNS_NAME_LEN];     /* MDNS_REGISTER: empty for this machine */
+    UINT16 port;
+    UINT16 pad;
+    UINT32 txt_len;
+    UINT8  txt[MDNS_TXT_LEN];
+};
+
+struct mdns_wait_params
+{
+    UINT64 handle;
+    UINT32 timeout;                 /* milliseconds */
+    struct mdns_event event;        /* out */
+};
+
+struct mdns_handle_params
+{
+    UINT64 handle;
+};
+
 enum unix_funcs
 {
     unix_get_searchlist,
     unix_get_serverlist,
     unix_set_serverlist,
     unix_query,
+    unix_mdns_start,
+    unix_mdns_wait,
+    unix_mdns_cancel,
+    unix_mdns_close,
     unix_funcs_count
 };
 
+extern NTSTATUS mdns_start( void *args );
+extern NTSTATUS mdns_wait( void *args );
+extern NTSTATUS mdns_cancel( void *args );
+extern NTSTATUS mdns_close( void *args );
+
 #define RESOLV_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
