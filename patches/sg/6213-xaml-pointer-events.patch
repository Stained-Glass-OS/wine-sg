+enum { VKM_CONTROL = 1, VKM_MENU = 2, VKM_SHIFT = 4, VKM_WINDOWS = 8 };   /* VirtualKeyModifiers */
+
+/* what a pointer message says */
+struct pointer_state
+{
+    FLOAT x, y;                     /* in the window's content */
+    WPARAM buttons;                 /* MK_ flags */
+    INT32 update;                   /* PointerUpdateKind */
+    INT32 wheel;
+    BOOL horizontal;
+    UINT64 timestamp;
+};
