 #ifndef SG_MUTANT_ADD_HANDLER_NOT_JOINED
         if (i == REV_KEY_DOWN) return xaml_routed_list( elem, XROUTED_KEY_DOWN );
         if (i == REV_KEY_UP) return xaml_routed_list( elem, XROUTED_KEY_UP );
+        if (i >= REV_POINTER_ENTERED && i <= REV_POINTER_WHEEL_CHANGED)
+            return xaml_routed_list( elem, XROUTED_POINTER_ENTERED + (i - REV_POINTER_ENTERED) );
 #endif
         return NULL;
     }
@@ -1408,7 +1410,26 @@ static HRESULT WINAPI uielement_AddHandler( struct xiface *iface, IInspectable *
     TRACE( "%p, %s, %p, handled too %d\n", elem, debugstr_w( name ), handler, handled_too );
     if (!name) return E_INVALIDARG;
     if (!list) return S_OK;     /* not raised yet */
-    return handlers_add( list, (IUnknown *)handler, &token );
+    /* the handler as an object: a delegate (IUnknown alone), or one boxed (C++/WinRT box_value, an
+     * IReference<T>, the delegate its Value) */
+#ifndef SG_MUTANT_ADD_HANDLER_BOXED
+    {
+        IInspectable *boxed = NULL;
+        IUnknown *delegate = NULL;
+        HRESULT hr;
+
+        if (SUCCEEDED(IInspectable_QueryInterface( handler, &IID_IInspectable, (void **)&boxed )))
+        {
+            hr = ((HRESULT (WINAPI *)( IInspectable *, IUnknown ** ))((void **)boxed->lpVtbl)[6])( boxed, &delegate );
+            IInspectable_Release( boxed );
+            if (FAILED(hr) || !delegate) return E_INVALIDARG;
+            hr = handlers_add_ex( list, delegate, &token, handled_too );
+            IUnknown_Release( delegate );
+            return hr;
+        }
+    }
+#endif
+    return handlers_add_ex( list, (IUnknown *)handler, &token, handled_too );
 }
 
 static HRESULT WINAPI uielement_RemoveHandler( struct xiface *iface, IInspectable *routed, IInspectable *handler )
@@ -1428,6 +1449,42 @@ static HRESULT WINAPI uielement_RemoveHandler( struct xiface *iface, IInspectabl
     return S_OK;
