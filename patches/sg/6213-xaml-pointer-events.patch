+static IInspectable *static_object( struct static_object **slot, const struct xclass *cls, const void *vtbl )
+{
+    struct static_object *made;
+
+    if (!*slot && (made = calloc( 1, sizeof(*made) )))
+    {
+        made->iface.vtbl = vtbl;
+        xobj_init( &made->obj, cls, NULL );
+        if (InterlockedCompareExchangePointer( (void **)slot, made, NULL ))
+            IInspectable_Release( (IInspectable *)&made->obj.IInspectable_inner );
+    }
+    return *slot ? (IInspectable *)&(*slot)->iface : NULL;
+}
