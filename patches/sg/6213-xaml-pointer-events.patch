+/* SelectionChanged, when the selection is not the one last told */
+static void selection_check( struct text_box *box )
+{
+    IInspectable *sender = NULL, *args;
+
+    if (box->selection_start == box->told_start && box->selection_length == box->told_length) return;
+    box->told_start = box->selection_start;
+    box->told_length = box->selection_length;
+#ifdef SG_MUTANT_NO_SELECTION_CHANGED
+    return;
+#endif
+    if (list_empty( &box->selection_changed.entries )) return;
+    if (FAILED(IUnknown_QueryInterface( box->c.e.d.obj.outer, &IID_IInspectable, (void **)&sender ))) return;
+    if ((args = xaml_routed_args( sender )))
+    {
+        xaml_raise_routed( &box->selection_changed, sender, args );
+        IInspectable_Release( args );
+    }
+    IInspectable_Release( sender );
+}
