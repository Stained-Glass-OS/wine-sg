+static void raise_text_changing( struct text_box *box, IInspectable *sender )
+{
+    struct changing_args *args;
+    IInspectable *iface;
+
+#ifdef SG_MUTANT_NO_TEXT_CHANGING
+    return;
+#endif
+    if (list_empty( &box->text_changing.entries ) || !(args = calloc( 1, sizeof(*args) ))) return;
+    args->ITextBoxTextChangingEventArgs_iface.vtbl = changing_args_vtbl;
+    args->ITextBoxTextChangingEventArgs2_iface.vtbl = changing_args2_vtbl;
+    xobj_init( &args->obj, &changing_args_class, NULL );
+    iface = xobj_default( &args->obj );
+    IInspectable_Release( (IInspectable *)&args->obj.IInspectable_inner );
+    xaml_raise_routed( &box->text_changing, sender, iface );
+    IInspectable_Release( iface );
