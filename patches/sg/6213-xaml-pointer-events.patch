+};
+
+/* ---- raising ---- */
+
+static IInspectable *object_of( struct uielem *elem )
+{
+    IInspectable *obj = NULL;
+    IUnknown_QueryInterface( elem->d.obj.outer, &IID_IInspectable, (void **)&obj );
+    return obj;
+}
+
+/* the event on elem, then up the tree while not handled (handledEventsToo handlers see it all the way) */
+static BOOL raise( struct uielem *elem, enum xaml_routed which, const struct pointer_state *state )
+{
+    struct uielem *chain[256], *e;
+    struct pointer_args *args;
+    IInspectable *iface;
+    unsigned int i, count = 0;
+    BOOL handled;
+
+    for (e = elem; e && count < ARRAY_SIZE(chain); e = e->parent)
+    {
+        IUnknown_AddRef( e->d.obj.outer );
+        chain[count++] = e;
+    }
+    if (!(args = calloc( 1, sizeof(*args) ))) goto done;
+    args->IRoutedEventArgs_iface.vtbl = args_routed_vtbl;
+    args->IPointerRoutedEventArgs_iface.vtbl = args_vtbl;
+    args->IPointerRoutedEventArgs2_iface.vtbl = args2_vtbl;
+    args->source = object_of( elem );
+    args->state = *state;
+    xobj_init( &args->obj, &args_class, NULL );
+    iface = (IInspectable *)&args->IPointerRoutedEventArgs_iface;
+    for (i = 0; i < count; i++)
+    {
+        struct handler_list *list = xaml_routed_list( chain[i], which );
+        IInspectable *sender;
+
+        if (!list || list_empty( &list->entries ) || !(sender = object_of( chain[i] ))) continue;
+        xaml_raise_routed_handled( list, sender, iface, &args->handled );
+        IInspectable_Release( sender );
+    }
+    handled = args->handled;
+    IInspectable_Release( iface );
+done:
+    for (i = 0; i < count; i++) IUnknown_Release( chain[i]->d.obj.outer );
+    return args ? handled : FALSE;
+}
+
+static struct uielem *hover, *capture;
+
+static void hold( struct uielem **slot, struct uielem *elem )
+{
+    if (*slot == elem) return;
+    if (elem) IUnknown_AddRef( elem->d.obj.outer );
+    if (*slot) IUnknown_Release( (*slot)->d.obj.outer );
+    *slot = elem;
+}
+
+/* UIElement.CapturePointer: the pointer's events go to elem until released */
+BOOL xaml_pointer_capture( struct uielem *elem )
+{
+    hold( &capture, elem );
+    return TRUE;
+}
+
+void xaml_pointer_release( struct uielem *elem )
+{
+    if (!elem || capture == elem) hold( &capture, NULL );
+}
+
+/* a mouse message of a XAML host window as the pointer events it makes */
+void xaml_pointer_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspectable *content )
+{
+    struct uielem *root = content ? uielem_from_inspectable( content ) : NULL, *hit, *target;
+    struct pointer_state state = { 0 };
+    enum xaml_routed which;
+    POINT pt;
+
+#ifdef SG_MUTANT_NO_POINTER_EVENTS
+    return;
+#endif
+    if (!root) return;
+    switch (msg)
+    {
+    case WM_MOUSEMOVE: which = XROUTED_POINTER_MOVED; state.update = 0; break;
+    case WM_LBUTTONDOWN: which = XROUTED_POINTER_PRESSED; state.update = 1; break;
+    case WM_LBUTTONUP: which = XROUTED_POINTER_RELEASED; state.update = 2; break;
+    case WM_RBUTTONDOWN: which = XROUTED_POINTER_PRESSED; state.update = 3; break;
+    case WM_RBUTTONUP: which = XROUTED_POINTER_RELEASED; state.update = 4; break;
+    case WM_MBUTTONDOWN: which = XROUTED_POINTER_PRESSED; state.update = 5; break;
+    case WM_MBUTTONUP: which = XROUTED_POINTER_RELEASED; state.update = 6; break;
+    case WM_MOUSEWHEEL: case WM_MOUSEHWHEEL: which = XROUTED_POINTER_WHEEL_CHANGED; break;
+    case WM_MOUSELEAVE:
+        if (hover && !capture)
+        {
+            state.timestamp = GetTickCount64();
+            raise( hover, XROUTED_POINTER_EXITED, &state );
+            hold( &hover, NULL );
+        }
+        return;
+    default: return;
+    }
+
+    pt.x = (SHORT)LOWORD( lparam );
+    pt.y = (SHORT)HIWORD( lparam );
+    if (which == XROUTED_POINTER_WHEEL_CHANGED)
+    {
+        ScreenToClient( hwnd, &pt );   /* wheel messages give screen coordinates */
+        state.wheel = (SHORT)HIWORD( wparam );
+        state.horizontal = msg == WM_MOUSEHWHEEL;
+    }
+    state.x = pt.x;
+    state.y = pt.y;
+    state.buttons = LOWORD( wparam );
+    state.timestamp = GetTickCount64();
+    pointer_in_contact = !!(state.buttons & (MK_LBUTTON | MK_RBUTTON | MK_MBUTTON));
+    hit = xaml_hit_element( root, state.x, state.y );
+    /* handlers may take elements out of the tree (and free them): the ones used here are held */
+    if (hit) IUnknown_AddRef( hit->d.obj.outer );
+
+    /* the element under the pointer changed: Exited on the old one, Entered on the new */
+    if (hit != hover && !capture)
+    {
+        if (hover) raise( hover, XROUTED_POINTER_EXITED, &state );
+        hold( &hover, hit );
+        if (hit) raise( hit, XROUTED_POINTER_ENTERED, &state );
+    }
+    target = capture ? capture : hit;
+    TRACE( "%p msg %#x at %.0f,%.0f: %p\n", hwnd, msg, state.x, state.y, target );
+    if (target)
+    {
+        IUnknown_AddRef( target->d.obj.outer );
+        raise( target, which, &state );
+        IUnknown_Release( target->d.obj.outer );
+    }
+    /* the buttons all up: a capture ends (PointerCaptureLost) */
+    if (which == XROUTED_POINTER_RELEASED && capture && !pointer_in_contact)
+    {
+        struct uielem *lost = capture;
+        IUnknown_AddRef( lost->d.obj.outer );
+        hold( &capture, NULL );
+        raise( lost, XROUTED_POINTER_CAPTURE_LOST, &state );
+        IUnknown_Release( lost->d.obj.outer );
+    }
+    if (hit) IUnknown_Release( hit->d.obj.outer );
+}
