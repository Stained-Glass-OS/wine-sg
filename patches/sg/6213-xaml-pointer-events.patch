+    [IUIElement_PointerCanceled] = uielement_add_PointerCanceled, [IUIElement_RemovePointerCanceled] = uielement_remove_PointerCanceled,
+    [IUIElement_PointerWheelChanged] = uielement_add_PointerWheelChanged,
