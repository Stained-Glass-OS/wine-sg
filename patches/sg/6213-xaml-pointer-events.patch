+    [IUIElement_PointerEntered] = uielement_add_PointerEntered, [IUIElement_RemovePointerEntered] = uielement_remove_PointerEntered,
+    [IUIElement_PointerExited] = uielement_add_PointerExited, [IUIElement_RemovePointerExited] = uielement_remove_PointerExited,
+    [IUIElement_PointerCaptureLost] = uielement_add_PointerCaptureLost,
