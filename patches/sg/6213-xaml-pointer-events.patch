+static const struct xiface_entry args_ifaces[] =
+{
+    { &IID_IPointerRoutedEventArgs, offsetof(struct pointer_args, IPointerRoutedEventArgs_iface) },
+    { &IID_IPointerRoutedEventArgs2, offsetof(struct pointer_args, IPointerRoutedEventArgs2_iface) },
