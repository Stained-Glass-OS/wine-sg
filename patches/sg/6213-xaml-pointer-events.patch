+/* the point relative to an element (NULL: the window's content) */
+static HRESULT WINAPI args_GetCurrentPoint( struct xiface *iface, IInspectable *relative_to, IInspectable **value )
+{
+    struct pointer_args *args = args_from( iface );
+    struct uielem *elem = relative_to ? uielem_from_inspectable( relative_to ) : NULL;
+    struct point *point;
+    FLOAT ox = 0, oy = 0;
+
+    if (!value) return E_POINTER;
+    if (!(point = calloc( 1, sizeof(*point) ))) return E_OUTOFMEMORY;
+    for (; elem; elem = elem->parent)
+    {
+        ox += elem->offset.x;
+        oy += elem->offset.y;
+    }
+    point->IPointerPoint_iface.vtbl = point_vtbl;
+    point->state = args->state;
+    point->x = args->state.x - ox;
+    point->y = args->state.y - oy;
+    xobj_init( &point->obj, &point_class, NULL );
+    *value = (IInspectable *)&point->IPointerPoint_iface;
+    return S_OK;
+}
