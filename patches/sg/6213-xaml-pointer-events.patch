+static const GUID IID_IPointerPoint_x = { 0xe995317d, 0x7296, 0x42d9, { 0x82, 0x33, 0xc5, 0xbe, 0x73, 0xb7, 0x4a, 0x4a } };
+static const GUID IID_IPointerPointProperties_x = { 0xc79d8a4b, 0xc163, 0x4ee7, { 0x80, 0x3f, 0x67, 0xce, 0x79, 0xf9, 0x97, 0x2d } };
+static const GUID IID_IPointerDevice_x = { 0x93c9bafc, 0xebcb, 0x467e, { 0x82, 0xc6, 0x27, 0x6f, 0xea, 0xe3, 0x6b, 0x5a } };
+
