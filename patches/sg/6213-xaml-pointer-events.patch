+    if (GetKeyState( VK_MENU ) < 0) *value |= VKM_MENU;
+    if (GetKeyState( VK_SHIFT ) < 0) *value |= VKM_SHIFT;
+    if (GetKeyState( VK_LWIN ) < 0 || GetKeyState( VK_RWIN ) < 0) *value |= VKM_WINDOWS;
+    return S_OK;
+}
