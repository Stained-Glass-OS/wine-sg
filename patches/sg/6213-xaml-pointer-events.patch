+/* the pointer events' add_/remove_ (in IUIElement's order) and pointer capture */
+#define POINTER_EVENT(name, which) \
+static HRESULT WINAPI uielement_add_##name( struct xiface *iface, IUnknown *handler, INT64 *token ) \
+{ return handlers_add( xaml_routed_list( elem_from_iface( iface ), which ), handler, token ); } \
+static HRESULT WINAPI uielement_remove_##name( struct xiface *iface, INT64 token ) \
+{ return handlers_remove( xaml_routed_list( elem_from_iface( iface ), which ), token ); }
+POINTER_EVENT(PointerPressed, XROUTED_POINTER_PRESSED)
+POINTER_EVENT(PointerMoved, XROUTED_POINTER_MOVED)
+POINTER_EVENT(PointerReleased, XROUTED_POINTER_RELEASED)
+POINTER_EVENT(PointerEntered, XROUTED_POINTER_ENTERED)
+POINTER_EVENT(PointerExited, XROUTED_POINTER_EXITED)
+POINTER_EVENT(PointerCaptureLost, XROUTED_POINTER_CAPTURE_LOST)
+POINTER_EVENT(PointerCanceled, XROUTED_POINTER_CANCELED)
+POINTER_EVENT(PointerWheelChanged, XROUTED_POINTER_WHEEL_CHANGED)
+#undef POINTER_EVENT
+
+static HRESULT WINAPI uielement_CapturePointer( struct xiface *iface, IInspectable *pointer, boolean *captured )
+{
+    if (!captured) return E_POINTER;
+    if (!pointer) return E_INVALIDARG;
+    *captured = xaml_pointer_capture( elem_from_iface( iface ) );
+    return S_OK;
+}
+
+static HRESULT WINAPI uielement_ReleasePointerCapture( struct xiface *iface, IInspectable *pointer )
+{
+    xaml_pointer_release( elem_from_iface( iface ) );
+    return S_OK;
+}
+
+static HRESULT WINAPI uielement_ReleasePointerCaptures( struct xiface *iface )
+{
+    xaml_pointer_release( elem_from_iface( iface ) );
+    return S_OK;
+}
