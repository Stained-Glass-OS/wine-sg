From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: LogonUser tells the broker which program asks

The elevation broker records every LogonUser success and failure in the
journal and in the Windows Security log (4624, 4625: sg-session
0.1.0-191), naming the account, the requesting user and its program.
LogonUser now sends the calling program's path with the request
(LOGON_PROGRAM), so the record names the program a person would recognise
rather than Wine's loader. The broker shows it but never trusts it; the
requesting user and process id come from the socket.

Gate: test/logonuser-gate.sh now also checks that the logon is in the
Security log with the probe's name.
---
--- a/dlls/advapi32/advapi.c
+++ b/dlls/advapi32/advapi.c
@@ -520,6 +520,11 @@ BOOL WINAPI LogonUserW( LPCWSTR lpszUsername, LPCWSTR lpszDomain, LPCWSTR lpszPa
     InitOnceExecuteOnce( &logon_once, logon_init, NULL, NULL );
     memset( &params, 0, sizeof(params) );
     params.type = dwLogonType;
+    {
+        WCHAR module[MAX_PATH];
+        if (GetModuleFileNameW( NULL, module, ARRAY_SIZE(module) ))
+            WideCharToMultiByte( CP_UTF8, 0, module, -1, params.program, sizeof(params.program), NULL, NULL );
+    }
     status = STATUS_NO_LOGON_SERVERS;
     /* for the gate: a ticket by its name, as if the broker had given it (the
      * wineserver checks it as any other: its owner, its requester, its age) */
--- a/dlls/advapi32/cred_unix.h
+++ b/dlls/advapi32/cred_unix.h
@@ -74,6 +74,7 @@ struct logon_ticket_params
     char password[260];   /* UTF-8 */
     unsigned int type;    /* LOGON32_LOGON_* */
     char ticket[40];      /* out: 32 hex digits */
+    char program[260];    /* the calling program's path, UTF-8 (for the broker's audit) */
 };
 
 extern NTSTATUS logon_ticket( void *args );
--- a/dlls/advapi32/logon_unix.c
+++ b/dlls/advapi32/logon_unix.c
@@ -62,7 +62,8 @@ static void wipe( volatile char *p, size_t len )
 }
 
 /* The broker's request: the directory "@logon", the environment
- * LOGON_USER, LOGON_PASSWORD and LOGON_TYPE, and an empty string -- no
+ * LOGON_USER, LOGON_PASSWORD, LOGON_TYPE and LOGON_PROGRAM (which program
+ * asks, for the broker's audit), and an empty string -- no
  * program (an older broker refuses such a request at once); its length
  * first. The answer: a status byte (0 logged on, 1
  * refused), then "TICKET <name>". The password goes over the broker's socket
@@ -72,7 +73,7 @@ NTSTATUS logon_ticket( void *args )
     struct logon_ticket_params *params = args;
     struct sockaddr_un addr = { .sun_family = AF_UNIX };
     const char *path = getenv( "SG_BROKER_SOCK" );
-    char blob[1024], line[64];
+    char blob[1536], line[64];
     unsigned char status = 2;
     uint32_t len;
     size_t n = 0;
@@ -85,8 +86,9 @@ NTSTATUS logon_ticket( void *args )
     params->user[sizeof(params->user) - 1] = 0;
     params->password[sizeof(params->password) - 1] = 0;
 
-    ret = snprintf( blob, sizeof(blob), "@logon%cLOGON_USER=%s%cLOGON_PASSWORD=%s%cLOGON_TYPE=%u%c",
-                    0, params->user, 0, params->password, 0, params->type, 0 );
+    params->program[sizeof(params->program) - 1] = 0;
+    ret = snprintf( blob, sizeof(blob), "@logon%cLOGON_USER=%s%cLOGON_PASSWORD=%s%cLOGON_TYPE=%u%cLOGON_PROGRAM=%s%c",
+                    0, params->user, 0, params->password, 0, params->type, 0, params->program, 0 );
     if (ret < 0 || (size_t)ret + 1 > sizeof(blob)) { wipe( blob, sizeof(blob) ); return STATUS_LOGON_FAILURE; }
     len = ret + 1;
 
