From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msado15: ADO over ODBC keeps its connection and reads its rows (6032)

With a real ODBC driver ADO did almost nothing:
- Connection.Open uninitialized the data source right after making the
  session, which for MSDASQL is SQLDisconnect: every command after it
  failed with "not connected".
- A SELECT's rows were read only when the provider counted them, and an
  ODBC driver's row count for a SELECT is -1: the recordset was empty.
- Connection.Execute with its options left out (adOptionUnspecified,
  -1) took every bit as set: adExecuteNoRecords, so no recordset.
- rs("Name") and rs("Name") = value in a script reached Fields, which
  takes no index; ADO answers them with the field (and Collect).
- Recordset.Open did not take a connection passed by reference, as a
  script passes its variables.
---
diff --git a/dlls/msado15/connection.c b/dlls/msado15/connection.c
index bd95ce8..d98e005 100644
--- a/dlls/msado15/connection.c
+++ b/dlls/msado15/connection.c
@@ -64,6 +64,7 @@ struct connection
     ConnectModeEnum           mode;
     CursorLocationEnum        location;
     IUnknown                 *session;
+    IDBInitialize            *dso;         /* Stained Glass OS: the data source, initialized while open */
     struct connection_point   cp_connev;
     Errors                   *errors;
     Properties               *props;
@@ -114,6 +115,11 @@ static ULONG WINAPI connection_Release( _Connection *iface )
                 IUnknown_Release( connection->cp_connev.sinks[i] );
         }
         if (connection->session) IUnknown_Release( connection->session );
+        if (connection->dso)
+        {
+            IDBInitialize_Uninitialize( connection->dso );
+            IDBInitialize_Release( connection->dso );
+        }
         if (connection->errors) Errors_Release( connection->errors );
         if (connection->props) Properties_Release( connection->props );
         free( connection->cp_connev.sinks );
@@ -314,6 +320,13 @@ static HRESULT WINAPI connection_Close( _Connection *iface )
         IUnknown_Release( connection->session );
         connection->session = NULL;
     }
+    /* the data source's connection ends with the session's */
+    if (connection->dso)
+    {
+        IDBInitialize_Uninitialize( connection->dso );
+        IDBInitialize_Release( connection->dso );
+        connection->dso = NULL;
+    }
 
     connection->state = adStateClosed;
     return S_OK;
@@ -332,6 +345,12 @@ static HRESULT WINAPI connection_Execute( _Connection *iface, BSTR command, VARI
 
     if (connection->state == adStateClosed) return MAKE_ADO_HRESULT( adErrObjectClosed );
 
+    /* Stained Glass OS: a script that leaves Options out passes adOptionUnspecified (-1), which has
+     * every bit set: it is no options at all, not adExecuteNoRecords and command type 0xff */
+#ifndef SG_MUTANT_ADO_OPTIONS_ALL
+    if (options == adOptionUnspecified) options = 0;
+#endif
+
     hr = Recordset_create( (void**)&recordset);
     if (FAILED(hr))
     {
@@ -501,6 +520,13 @@ static HRESULT WINAPI connection_Open( _Connection *iface, BSTR connect_str, BST
     if ((hr = IDBCreateSession_CreateSession( session, NULL, &IID_IUnknown, &connection->session )) == S_OK)
     {
         connection->state = adStateOpen;
+#ifndef SG_MUTANT_ADO_UNINIT_DSO
+        /* Stained Glass OS: the session works through the data source's connection (an ODBC
+         * connection for MSDASQL): it stays initialized until the connection is closed. Uninitialized
+         * at once, every command of the connection failed ("not connected"). */
+        connection->dso = dbinit;
+        dbinit = NULL;
+#endif
     }
     IDBCreateSession_Release( session );
 
diff --git a/dlls/msado15/recordset.c b/dlls/msado15/recordset.c
index c9e755b..0b57774 100644
--- a/dlls/msado15/recordset.c
+++ b/dlls/msado15/recordset.c
@@ -1531,6 +1531,33 @@ static HRESULT WINAPI recordset_Invoke( _Recordset *iface, DISPID member, REFIID
     TRACE( "%p, %ld, %s, %ld, %d, %p, %p, %p, %p\n", recordset, member, debugstr_guid(riid), lcid, flags, params,
            result, excep_info, arg_err );
 
+    /* Stained Glass OS: rs("Name") in a script is the default member, Fields, given an index: ADO
+     * answers it with that field (whose default member is its value), as rs.Fields("Name") is; and
+     * rs("Name") = value sets that field's value (Collect). Fields itself takes no index. */
+#ifndef SG_MUTANT_ADO_NO_COLLECT
+    if (member == DISPID_VALUE && params && recordset->fields)
+    {
+        if ((flags & DISPATCH_PROPERTYGET) && params->cArgs - params->cNamedArgs == 1 && !params->cNamedArgs)
+        {
+            VARIANT *index = &params->rgvarg[0];
+            Field *field;
+
+            while (V_VT(index) == (VT_BYREF | VT_VARIANT) && V_VARIANTREF(index)) index = V_VARIANTREF(index);
+            if (FAILED(hr = Fields_get_Item( &recordset->fields->Fields_iface, *index, &field ))) return hr;
+            if (!result)
+            {
+                Field_Release( field );
+                return S_OK;
+            }
+            V_VT(result) = VT_DISPATCH;
+            V_DISPATCH(result) = (IDispatch *)field;
+            return S_OK;
+        }
+        if ((flags & (DISPATCH_PROPERTYPUT | DISPATCH_PROPERTYPUTREF)) && params->cArgs == 2)
+            member = -8; /* DISPID_COLLECT */
+    }
+#endif
+
     hr = get_typeinfo(Recordset_tid, &typeinfo);
     if(SUCCEEDED(hr))
     {
@@ -2861,6 +2888,13 @@ static HRESULT WINAPI recordset_Open( _Recordset *iface, VARIANT source, VARIANT
     TRACE( "%p, %s, %s, %d, %d, %ld\n", recordset, debugstr_variant(&source), debugstr_variant(&active_connection),
            cursor_type, lock_type, options );
 
+    /* Stained Glass OS: a script passes its variables by reference (VT_BYREF | VT_VARIANT) */
+#ifndef SG_MUTANT_ADO_NO_BYREF
+    while (V_VT(&source) == (VT_BYREF | VT_VARIANT) && V_VARIANTREF(&source)) source = *V_VARIANTREF(&source);
+    while (V_VT(&active_connection) == (VT_BYREF | VT_VARIANT) && V_VARIANTREF(&active_connection))
+        active_connection = *V_VARIANTREF(&active_connection);
+#endif
+
     if (recordset->state == adStateOpen) return MAKE_ADO_HRESULT( adErrObjectOpen );
 
     if (recordset->fields)
@@ -3007,10 +3041,11 @@ static HRESULT WINAPI recordset_Open( _Recordset *iface, VARIANT source, VARIANT
     recordset->count = affected > 0 ? affected : 0;
     recordset->index = affected > 0 ? 0 : -1;
 
-    /*
-     * We can safely just return with an empty recordset here
-     */
+    /* Stained Glass OS: the rows are read whatever count the provider gave: for a SELECT an ODBC
+     * driver's row count is usually -1 (SQLRowCount is for changes), and the recordset was empty */
+#ifdef SG_MUTANT_ADO_ROWCOUNT_ONLY
     if (affected > 0)
+#endif
     {
         hr = load_all_recordset_data(recordset, rowset, bindings, datasize);
         if (FAILED(hr))
@@ -3020,6 +3055,7 @@ static HRESULT WINAPI recordset_Open( _Recordset *iface, VARIANT source, VARIANT
             IUnknown_Release(rowset);
             return hr;
         }
+        recordset->index = recordset->count ? 0 : -1;
     }
 
     CoTaskMemFree(bindings);
