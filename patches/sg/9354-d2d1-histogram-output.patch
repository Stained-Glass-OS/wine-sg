From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: the Histogram effect fills its HistogramOutput

The Histogram effect was drawn as its input and its HistogramOutput stayed empty. Drawing it now counts the selected channel (ChannelSelect) of the input's straight pixels -- colour divided by alpha, clamped to 0..1 -- into NumBins bins (2 to 1024), each bin the fraction of the pixels in it, the bins summing to 1 the way Win2D's ComputeHistogram tests read them on Windows (red, lime, blue and white in two bins: 0.5 0.5); the effect still draws its input. Paint.NET's Levels and Auto-Level read histograms.
---
--- a/dlls/d2d1/effect_render.c
+++ b/dlls/d2d1/effect_render.c
@@ -1344,6 +1344,115 @@
 static HRESULT fx_render_effect(struct fx_renderer *r, struct d2d_effect *effect, const struct fx_texture *given,
         const D2D1_RECT_L *want, struct fx_texture *out);
 
+/* wine-sg 9354: the Histogram effect. Drawing it passes its input through and counts the selected channel
+ * of the input's straight pixels (colour divided by alpha, clamped to 0..1) into NumBins bins, each bin the
+ * fraction of the pixels in it (the bins sum to 1, as Win2D's ComputeHistogram tests read it); the counts
+ * are the HistogramOutput property. Paint.NET's Auto-Level reads them. */
+static float fx_half_to_float(UINT16 h)
+{
+    UINT32 sign = (h >> 15) & 1, exp = (h >> 10) & 0x1f, mant = h & 0x3ff;
+    float v;
+
+    if (!exp) v = ldexpf((float)mant, -24);
+    else if (exp == 31) v = mant ? 0.0f : 65504.0f;
+    else v = ldexpf((float)(mant | 0x400), (int)exp - 25);
+    return sign ? -v : v;
+}
+
+static void fx_histogram(struct fx_renderer *r, struct d2d_effect *effect, const struct fx_texture *input)
+{
+    UINT32 bins = 256, channel = 0, x, y, count = 0;
+    D3D11_MAPPED_SUBRESOURCE map;
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D *staging, *source = NULL;
+    ID3D11Resource *resource;
+    float *hist;
+
+    get_uint(effect, 0, D2D1_PROPERTY_TYPE_UINT32, &bins);
+    get_uint(effect, 1, D2D1_PROPERTY_TYPE_ENUM, &channel);
+    bins = min(max(bins, 2), 1024);
+    channel = min(channel, 3);
+    if (input->texture)
+    {
+        source = input->texture;
+        ID3D11Texture2D_AddRef(source);
+    }
+    else if (input->srv)
+    {
+        /* a bitmap drawn from: its own texture, through its view */
+        ID3D11ShaderResourceView_GetResource(input->srv, &resource);
+        if (FAILED(ID3D11Resource_QueryInterface(resource, &IID_ID3D11Texture2D, (void **)&source)))
+            source = NULL;
+        ID3D11Resource_Release(resource);
+    }
+    if (!source || !(hist = calloc(bins, sizeof(*hist))))
+    {
+        if (source) ID3D11Texture2D_Release(source);
+        return;
+    }
+
+    ID3D11Texture2D_GetDesc(source, &desc);
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    desc.MiscFlags = 0;
+    if (SUCCEEDED(ID3D11Device1_CreateTexture2D(r->device, &desc, NULL, &staging)))
+    {
+        ID3D11DeviceContext1_CopyResource(r->dc, (ID3D11Resource *)staging, (ID3D11Resource *)source);
+        if (SUCCEEDED(ID3D11DeviceContext1_Map(r->dc, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &map)))
+        {
+            for (y = 0; y < desc.Height; ++y)
+            {
+                const BYTE *row = (const BYTE *)map.pData + (size_t)y * map.RowPitch;
+
+                for (x = 0; x < desc.Width; ++x)
+                {
+                    float px[4], v;
+                    UINT32 k;
+
+                    switch (desc.Format)
+                    {
+                    case DXGI_FORMAT_R16G16B16A16_FLOAT:
+                        for (k = 0; k < 4; ++k) px[k] = fx_half_to_float(((const UINT16 *)row)[x * 4 + k]);
+                        break;
+                    case DXGI_FORMAT_R32G32B32A32_FLOAT:
+                        memcpy(px, row + x * 16, sizeof(px));
+                        break;
+                    case DXGI_FORMAT_B8G8R8A8_UNORM:
+                    case DXGI_FORMAT_B8G8R8X8_UNORM:
+                        px[0] = row[x * 4 + 2] / 255.0f;
+                        px[1] = row[x * 4 + 1] / 255.0f;
+                        px[2] = row[x * 4] / 255.0f;
+                        px[3] = desc.Format == DXGI_FORMAT_B8G8R8X8_UNORM ? 1.0f : row[x * 4 + 3] / 255.0f;
+                        break;
+                    case DXGI_FORMAT_R8G8B8A8_UNORM:
+                        for (k = 0; k < 4; ++k) px[k] = row[x * 4 + k] / 255.0f;
+                        break;
+                    default:
+                        FIXME("Histogram of format %#x.\n", desc.Format);
+                        x = desc.Width;
+                        y = desc.Height;
+                        continue;
+                    }
+                    v = px[channel];
+                    if (channel < 3) v = px[3] > 0.0f ? v / px[3] : 0.0f;
+                    v = min(max(v, 0.0f), 1.0f);
+                    k = min((UINT32)(v * bins), bins - 1);
+                    hist[k] += 1.0f;
+                    ++count;
+                }
+            }
+            ID3D11DeviceContext1_Unmap(r->dc, (ID3D11Resource *)staging, 0);
+        }
+        ID3D11Texture2D_Release(staging);
+    }
+    ID3D11Texture2D_Release(source);
+    if (count)
+        for (x = 0; x < bins; ++x) hist[x] /= count;
+    ID2D1Effect_SetValue(&effect->ID2D1Effect_iface, 2, D2D1_PROPERTY_TYPE_BLOB, (const BYTE *)hist, bins * sizeof(*hist));
+    free(hist);
+}
+
 static HRESULT fx_render_builtin(struct fx_renderer *r, struct d2d_effect *effect, const struct fx_texture *inputs,
         const D2D1_RECT_L *want, struct fx_texture *out)
 {
@@ -1711,6 +1820,10 @@
                     : D3D11_FILTER_MIN_MAG_MIP_POINT, &rect, out);
         }
     }
+#ifndef SG_MUTANT_D2D_HISTOGRAM_EMPTY
+    else if (IsEqualGUID(id, &CLSID_D2D1Histogram))
+        fx_histogram(r, effect, &inputs[0]);    /* and drawn as its input */
+#endif
     else if (!IsEqualGUID(id, &CLSID_D2D1Crop) && !IsEqualGUID(id, &CLSID_D2D1Border)
             && !IsEqualGUID(id, &CLSID_D2D1DpiCompensation) && !IsEqualGUID(id, &CLSID_D2D1Atlas)
             && !IsEqualGUID(id, &CLSID_D2D1OpacityMetadata) && !once++)
