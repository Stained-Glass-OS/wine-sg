+/*****************************************************************
+ *  MultinetGetConnectionPerformanceW [MPR.@]
+ *
+ * The network provider that owns the connection tells: a device that is redirected is looked up through
+ * WNetGetConnection, a resource named by lpRemoteName must be connected already.
+ */
+typedef DWORD (APIENTRY *PF_NPGetConnectionPerformance)( LPCWSTR, LPNETCONNECTINFOSTRUCT );
+
+DWORD WINAPI MultinetGetConnectionPerformanceW( LPNETRESOURCEW netres, LPNETCONNECTINFOSTRUCT info )
+{
+    WCHAR remote_buf[MAX_PATH];
+    const WCHAR *remote;
+    DWORD ret = ERROR_NOT_SUPPORTED, first = 0, last = 0, i;
+    BOOL tried = FALSE;
+
+    TRACE( "(%p, %p)\n", netres, info );
+
+    if (!netres || !info) ret = ERROR_INVALID_ADDRESS;
+#ifndef SG_MUTANT_MPR_PERFARG
+    else if (info->cbStructure != sizeof(*info)) ret = ERROR_INVALID_PARAMETER;
+#endif
+    else if (!providerTable || !providerTable->numProviders) ret = WN_NO_NETWORK;
+    else
+    {
+        if (netres->lpLocalName && netres->lpLocalName[0])
+        {
+            DWORD size = ARRAY_SIZE(remote_buf);
+
+            switch (WNetGetConnectionW( netres->lpLocalName, remote_buf, &size ))
+            {
+            case WN_SUCCESS: break;
+            case WN_BAD_LOCALNAME: return (SetLastError( ERROR_BAD_DEVICE ), ERROR_BAD_DEVICE);
+            default: return (SetLastError( ERROR_NOT_CONNECTED ), ERROR_NOT_CONNECTED);
+            }
+            remote = remote_buf;
+        }
+        else if (netres->lpRemoteName && netres->lpRemoteName[0]) remote = netres->lpRemoteName;
+        else
+        {
+            SetLastError( ERROR_BAD_NET_NAME );
+            return ERROR_BAD_NET_NAME;
+        }
+
+        if (netres->lpProvider && netres->lpProvider[0])
+        {
+            first = _findProviderIndexW( netres->lpProvider );
+            if (first == BAD_PROVIDER_INDEX)
+            {
+                SetLastError( ERROR_BAD_PROVIDER );
+                return ERROR_BAD_PROVIDER;
+            }
+            last = first + 1;
+        }
+        else last = providerTable->numProviders;
+
+        for (i = first; i < last; i++)
+        {
+            PF_NPGetConnectionPerformance get = (PF_NPGetConnectionPerformance)
+                GetProcAddress( providerTable->table[i].hLib, "NPGetConnectionPerformance" );
+
+#ifdef SG_MUTANT_MPR_PERF
+            get = NULL;
+#endif
+            if (!get) continue;
+            ret = get( remote, info );
+            tried = TRUE;
+            /* a provider that does not know the connection leaves it to the next one */
+            if (ret != WN_NOT_CONNECTED && ret != WN_BAD_NETNAME && ret != ERROR_NOT_SUPPORTED) break;
+        }
+        if (!tried) ret = ERROR_NOT_SUPPORTED;
+    }
+    if (ret) SetLastError( ret );
+    return ret;
+}
+
+/*****************************************************************
+ *  MultinetGetConnectionPerformanceA [MPR.@]
+ */
+DWORD WINAPI MultinetGetConnectionPerformanceA( LPNETRESOURCEA netres, LPNETCONNECTINFOSTRUCT info )
+{
+    NETRESOURCEW resourceW;
+    DWORD ret;
+
+    TRACE( "(%p, %p)\n", netres, info );
+
+    if (!netres || !info) return MultinetGetConnectionPerformanceW( NULL, info );
+    netresource_a_to_w( netres, &resourceW );
+    ret = MultinetGetConnectionPerformanceW( &resourceW, info );
+    free_netresourceW( &resourceW );
+    return ret;
+}
