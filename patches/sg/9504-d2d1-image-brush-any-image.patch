+/* wine-sg 9504: an image brush paints the source rectangle of any image -- an effect's output, a command
+ * list, an image source, a part of a bitmap -- in image space, extended by its extend modes. What is not
+ * a whole bitmap is drawn (DrawImage on a device context of the same device) into a bitmap of the
+ * rectangle, at the target's DPI, before each use, so the brush follows changes to the image. */
+void d2d_brush_prepare(struct d2d_brush *brush, struct d2d_device_context *context)
+{
+    D2D1_BITMAP_PROPERTIES1 props = {{DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED}};
+    ID2D1DeviceContext *dc = NULL;
+    ID2D1Bitmap1 *target = NULL;
+    ID2D1Bitmap *bitmap;
+    D2D1_RECT_F rect;
+    D2D1_SIZE_U size;
+    float dpi_x, dpi_y;
+    HRESULT hr;
+
+    if (!brush || brush->type != D2D_BRUSH_TYPE_IMAGE || !brush->u.image.image || !context->device)
+        return;
+    if (brush->u.image.realized)
+    {
+        ID2D1Bitmap_Release(brush->u.image.realized);
+        brush->u.image.realized = NULL;
+    }
+    rect = brush->u.image.source_rect;
+    if (SUCCEEDED(ID2D1Image_QueryInterface(brush->u.image.image, &IID_ID2D1Bitmap, (void **)&bitmap)))
+    {
+        D2D1_SIZE_F bs = ID2D1Bitmap_GetSize(bitmap);
+        BOOL whole = (rect.left >= rect.right || rect.top >= rect.bottom) ||
+                (rect.left == 0.0f && rect.top == 0.0f && rect.right == bs.width && rect.bottom == bs.height);
+
+        ID2D1Bitmap_Release(bitmap);
+        if (whole) return;
+    }
+#ifdef SG_MUTANT_D2D_IMAGE_BRUSH_BITMAPS_ONLY
+    return;
+#endif
+    if (rect.left >= rect.right || rect.top >= rect.bottom)
+    {
+        if (FAILED(ID2D1DeviceContext6_GetImageLocalBounds(&context->ID2D1DeviceContext6_iface,
+                brush->u.image.image, &rect)))
+            return;
+    }
+    ID2D1DeviceContext6_GetDpi(&context->ID2D1DeviceContext6_iface, &dpi_x, &dpi_y);
+    if (dpi_x <= 0.0f) dpi_x = 96.0f;
+    if (dpi_y <= 0.0f) dpi_y = 96.0f;
+    if (!(rect.right - rect.left < 16384.0f && rect.bottom - rect.top < 16384.0f)) return; /* also NaN, infinite */
+    size.width = max(1, (UINT32)ceilf((rect.right - rect.left) * dpi_x / 96.0f));
+    size.height = max(1, (UINT32)ceilf((rect.bottom - rect.top) * dpi_y / 96.0f));
+
+    props.dpiX = dpi_x;
+    props.dpiY = dpi_y;
+    props.bitmapOptions = D2D1_BITMAP_OPTIONS_TARGET;
+    if (FAILED(hr = ID2D1Device6_CreateDeviceContext(&context->device->ID2D1Device6_iface,
+            D2D1_DEVICE_CONTEXT_OPTIONS_NONE, (ID2D1DeviceContext6 **)&dc)))
+        goto done;
+    if (FAILED(hr = ID2D1DeviceContext_CreateBitmap(dc, size, NULL, 0, &props, &target)))
+        goto done;
+    ID2D1DeviceContext_SetTarget(dc, (ID2D1Image *)target);
+    ID2D1DeviceContext_SetDpi(dc, dpi_x, dpi_y);
+    ID2D1DeviceContext_BeginDraw(dc);
+    ID2D1DeviceContext_Clear(dc, NULL);
+    ID2D1DeviceContext_DrawImage(dc, brush->u.image.image, NULL, &rect, brush->u.image.interpolation_mode,
+            D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    if (FAILED(hr = ID2D1DeviceContext_EndDraw(dc, NULL, NULL)))
+        goto done;
+    brush->u.image.realized = (ID2D1Bitmap *)target;
+    brush->u.image.origin.x = rect.left;
+    brush->u.image.origin.y = rect.top;
+    target = NULL;
+done:
+    if (FAILED(hr))
+        WARN("Failed to draw image %p for the brush, hr %#lx.\n", brush->u.image.image, hr);
+    if (target) ID2D1Bitmap1_Release(target);
+    if (dc) ID2D1DeviceContext_Release(dc);
+}
