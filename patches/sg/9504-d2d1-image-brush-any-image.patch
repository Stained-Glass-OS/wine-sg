+    else if (FAILED(ID2D1Image_QueryInterface(brush->u.image.image, &IID_ID2D1Bitmap, (void **)&image_bitmap)))
     {
-        FIXME("Only image brushes with bitmaps are supported.\n");
+        WARN("Image %p could not be made a bitmap.\n", brush->u.image.image);
         return;
     }
 
