+/* a graphics device over the program's Direct2D (or Direct3D) device */
+static HRESULT WINAPI compositor_interop_CreateGraphicsDevice( ICompositorInterop *iface, IUnknown *device,
+        ICompositionGraphicsDevice **result )
+{
+    struct compositor *impl = impl_from_ICompositorInterop( iface );
+    struct graphics_device *object;
+    ID2D1Device *d2d_device = NULL;
+    IDXGIDevice *dxgi;
+    HRESULT hr;
+
+    TRACE( "iface %p, device %p, result %p.\n", iface, device, result );
+
+    if (!device || !result) return E_INVALIDARG;
+    if (FAILED(IUnknown_QueryInterface( device, &IID_ID2D1Device, (void **)&d2d_device )))
+    {
+        ID2D1Factory1 *factory;
+
+        if (FAILED(hr = IUnknown_QueryInterface( device, &IID_IDXGIDevice, (void **)&dxgi ))) return hr;
+        if (SUCCEEDED(hr = D2D1CreateFactory( D2D1_FACTORY_TYPE_MULTI_THREADED, &IID_ID2D1Factory1, NULL,
+                (void **)&factory )))
+        {
+            hr = ID2D1Factory1_CreateDevice( factory, dxgi, &d2d_device );
+            ID2D1Factory1_Release( factory );
+        }
+        IDXGIDevice_Release( dxgi );
+        if (FAILED(hr)) return hr;
+    }
+
+    if (!(object = calloc( 1, sizeof(*object) )))
+    {
+        ID2D1Device_Release( d2d_device );
+        return E_OUTOFMEMORY;
+    }
+    object->ICompositionGraphicsDevice_iface.lpVtbl = &graphics_device_vtbl;
+    object->ICompositionGraphicsDeviceInterop_iface.lpVtbl = &device_interop_vtbl;
+    object->ICompositionObject_iface.lpVtbl = &graphics_device_object_vtbl;
+    object->IClosable_iface.lpVtbl = &graphics_device_closable_vtbl;
+    object->ref = 1;
+    object->compositor = impl;
+    ICompositor_AddRef( &impl->ICompositor_iface );
+    object->d2d_device = d2d_device;
+    InitializeCriticalSectionEx( &object->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    object->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": graphics_device.cs");
+    if (FAILED(hr = ID2D1Device_CreateDeviceContext( d2d_device, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &object->context )))
+    {
+        ID2D1Device_Release( d2d_device );
+        ICompositor_Release( &impl->ICompositor_iface );
+        DeleteCriticalSection( &object->cs );
+        free( object );
+        return hr;
+    }
+
+    /* the targets draw with the first device given, so its surfaces need no copies */
+    EnterCriticalSection( &impl->cs );
+    if (!impl->d2d_device)
+        ID2D1Device_AddRef( impl->d2d_device = d2d_device );
+    LeaveCriticalSection( &impl->cs );
+
+    *result = &object->ICompositionGraphicsDevice_iface;
+    return S_OK;
+}
