+/* the children: a collection object over the container */
+struct visual_collection
+{
+    IVisualCollection IVisualCollection_iface;
+    LONG ref;
+    struct visual *owner;
+};
+
+static struct visual_collection *impl_from_IVisualCollection( IVisualCollection *iface )
+{
+    return CONTAINING_RECORD( iface, struct visual_collection, IVisualCollection_iface );
+}
+
+static HRESULT WINAPI collection_QueryInterface( IVisualCollection *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IVisualCollection ))
+    {
+        IVisualCollection_AddRef( iface );
+        *out = iface;
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI collection_AddRef( IVisualCollection *iface )
+{
+    return InterlockedIncrement( &impl_from_IVisualCollection( iface )->ref );
+}
+
+static ULONG WINAPI collection_Release( IVisualCollection *iface )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        IVisual_Release( &impl->owner->IVisual_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI collection_GetIids( IVisualCollection *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
