+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_get_Count( IVisualCollection *iface, INT32 *value )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    *value = list_count( &impl->owner->children );
+    return S_OK;
+}
+
+/* takes a child from wherever it was and puts it after (or before) an entry of this container */
+static HRESULT collection_insert( struct visual_collection *impl, IVisual *child_iface, struct list *after )
+{
+    struct visual *child = unsafe_visual( (IUnknown *)child_iface );
+
+    if (!child) return E_INVALIDARG;
+    if (child == impl->owner) return E_INVALIDARG;
+    IVisual_AddRef( &child->IVisual_iface );
+    visual_detach( child );
+    list_add_after( after, &child->entry );
+    child->parent = impl->owner;
+    compositor_changed( impl->owner->compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_InsertAbove( IVisualCollection *iface, IVisual *child, IVisual *sibling )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    struct visual *s = unsafe_visual( (IUnknown *)sibling );
+
+    TRACE( "iface %p, child %p, sibling %p.\n", iface, child, sibling );
+    if (!s || s->parent != impl->owner) return E_INVALIDARG;
+    if (s == unsafe_visual( (IUnknown *)child )) return S_OK;
+    return collection_insert( impl, child, &s->entry );
+}
+
+static HRESULT WINAPI collection_InsertAtBottom( IVisualCollection *iface, IVisual *child )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    TRACE( "iface %p, child %p.\n", iface, child );
+    return collection_insert( impl, child, &impl->owner->children );
+}
+
+static HRESULT WINAPI collection_InsertAtTop( IVisualCollection *iface, IVisual *child )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    struct visual *c = unsafe_visual( (IUnknown *)child );
+    HRESULT hr;
+
+    TRACE( "iface %p, child %p.\n", iface, child );
+    if (!c) return E_INVALIDARG;
+    /* taken out first, so the last entry is not itself */
+    IVisual_AddRef( &c->IVisual_iface );
+    visual_detach( c );
+    hr = collection_insert( impl, child, impl->owner->children.prev );
+    IVisual_Release( &c->IVisual_iface );
+    return hr;
+}
+
+static HRESULT WINAPI collection_InsertBelow( IVisualCollection *iface, IVisual *child, IVisual *sibling )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    struct visual *s = unsafe_visual( (IUnknown *)sibling ), *c = unsafe_visual( (IUnknown *)child );
+    HRESULT hr;
+
+    TRACE( "iface %p, child %p, sibling %p.\n", iface, child, sibling );
+    if (!s || !c || s->parent != impl->owner) return E_INVALIDARG;
+    if (s == c) return S_OK;
+    IVisual_AddRef( &c->IVisual_iface );
+    visual_detach( c );
+    hr = collection_insert( impl, child, s->entry.prev );
+    IVisual_Release( &c->IVisual_iface );
+    return hr;
+}
+
+static HRESULT WINAPI collection_Remove( IVisualCollection *iface, IVisual *child )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    struct visual *c = unsafe_visual( (IUnknown *)child );
+
+    TRACE( "iface %p, child %p.\n", iface, child );
+    if (!c || c->parent != impl->owner) return E_INVALIDARG;
+    visual_detach( c );
+    compositor_changed( impl->owner->compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_RemoveAll( IVisualCollection *iface )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    struct visual *child, *next;
+
+    TRACE( "iface %p.\n", iface );
+    LIST_FOR_EACH_ENTRY_SAFE( child, next, &impl->owner->children, struct visual, entry )
+        visual_detach( child );
+    compositor_changed( impl->owner->compositor );
+    return S_OK;
+}
