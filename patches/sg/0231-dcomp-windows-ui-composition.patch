+    struct compositor *compositor;
+    ID2D1Device *d2d_device;
+    ID2D1DeviceContext *context;        /* the surfaces are drawn with */
+    CRITICAL_SECTION cs;
+};
+
+struct drawing_surface
+{
+    ICompositionDrawingSurface ICompositionDrawingSurface_iface;
+    ICompositionSurface ICompositionSurface_iface;
+    ICompositionDrawingSurfaceInterop ICompositionDrawingSurfaceInterop_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    struct compositor *compositor;
+    struct graphics_device *device;
+    ID2D1Bitmap1 *bitmap;
+    D2D1_SIZE_U size;
+    DirectXPixelFormat format;
+    DirectXAlphaMode alpha_mode;
+    BOOL drawing;
+};
+
+static const struct ICompositionDrawingSurfaceVtbl drawing_surface_vtbl;
+
+static struct drawing_surface *impl_from_ICompositionDrawingSurface( ICompositionDrawingSurface *iface )
+{
+    return CONTAINING_RECORD( iface, struct drawing_surface, ICompositionDrawingSurface_iface );
+}
+
+/* one of ours, from whichever of its interfaces */
+static struct drawing_surface *unsafe_drawing_surface( IUnknown *unknown )
+{
+    ICompositionDrawingSurface *surface;
+    struct drawing_surface *impl = NULL;
+
+    if (!unknown || FAILED(IUnknown_QueryInterface( unknown, &IID_ICompositionDrawingSurface, (void **)&surface )))
+        return NULL;
+    if (surface->lpVtbl == &drawing_surface_vtbl) impl = impl_from_ICompositionDrawingSurface( surface );
+    ICompositionDrawingSurface_Release( surface );
+    return impl;
+}
+
+static HRESULT drawing_surface_allocate( struct drawing_surface *impl, D2D1_SIZE_U size )
+{
+    D2D1_BITMAP_PROPERTIES1 props;
+    ID2D1Bitmap1 *bitmap;
+    HRESULT hr;
+
+    memset( &props, 0, sizeof(props) );
+    props.pixelFormat.format = impl->format == DirectXPixelFormat_Unknown ? DXGI_FORMAT_B8G8R8A8_UNORM
+            : (DXGI_FORMAT)impl->format;
+    props.pixelFormat.alphaMode = impl->alpha_mode == DirectXAlphaMode_Ignore ? D2D1_ALPHA_MODE_IGNORE
+            : D2D1_ALPHA_MODE_PREMULTIPLIED;
+    props.dpiX = props.dpiY = 96.0f;
+    props.bitmapOptions = D2D1_BITMAP_OPTIONS_TARGET;
+    if (!size.width) size.width = 1;
+    if (!size.height) size.height = 1;
+    if (FAILED(hr = ID2D1DeviceContext_CreateBitmap( impl->device->context, size, NULL, 0, &props, &bitmap )))
+    {
+        WARN( "Failed to create a %ux%u bitmap of format %#x, hr %#lx.\n", size.width, size.height,
+              props.pixelFormat.format, hr );
+        return hr;
+    }
+    if (impl->bitmap) ID2D1Bitmap1_Release( impl->bitmap );
+    impl->bitmap = bitmap;
+    impl->size = size;
+    return S_OK;
+}
