+/* a visual's 2D transform from its properties */
+static void visual_local_transform( const struct visual *v, D2D1_MATRIX_3X2_F *m )
+{
+    float cx = v->center_point.X, cy = v->center_point.Y, c = cosf( v->rotation_angle ), s = sinf( v->rotation_angle );
+    D2D1_MATRIX_3X2_F a, b;
+
+    /* anchor, then scale and rotation about the centre point */
+    a._11 = v->scale.X * c; a._12 = v->scale.X * s;
+    a._21 = -v->scale.Y * s; a._22 = v->scale.Y * c;
+    a._31 = -cx * a._11 - cy * a._21 + cx - v->anchor_point.X * v->size.X;
+    a._32 = -cx * a._12 - cy * a._22 + cy - v->anchor_point.Y * v->size.Y;
+    /* then its matrix's 2D part */
+    b._11 = v->transform.M11; b._12 = v->transform.M12;
+    b._21 = v->transform.M21; b._22 = v->transform.M22;
+    b._31 = v->transform.M41; b._32 = v->transform.M42;
+    m->_11 = a._11 * b._11 + a._12 * b._21;
+    m->_12 = a._11 * b._12 + a._12 * b._22;
+    m->_21 = a._21 * b._11 + a._22 * b._21;
+    m->_22 = a._21 * b._12 + a._22 * b._22;
+    m->_31 = a._31 * b._11 + a._32 * b._21 + b._31 + v->offset.X;
+    m->_32 = a._31 * b._12 + a._32 * b._22 + b._32 + v->offset.Y;
+}
+
+static void matrix_multiply( D2D1_MATRIX_3X2_F *out, const D2D1_MATRIX_3X2_F *a, const D2D1_MATRIX_3X2_F *b )
+{
+    D2D1_MATRIX_3X2_F r;
+
+    r._11 = a->_11 * b->_11 + a->_12 * b->_21;
+    r._12 = a->_11 * b->_12 + a->_12 * b->_22;
+    r._21 = a->_21 * b->_11 + a->_22 * b->_21;
+    r._22 = a->_21 * b->_12 + a->_22 * b->_22;
+    r._31 = a->_31 * b->_11 + a->_32 * b->_21 + b->_31;
+    r._32 = a->_31 * b->_12 + a->_32 * b->_22 + b->_32;
+    *out = r;
+}
