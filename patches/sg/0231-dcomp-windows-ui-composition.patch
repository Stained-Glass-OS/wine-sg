+DEFINE_IUNKNOWN( surface_interop, ICompositionDrawingSurfaceInterop, struct drawing_surface,
+                 ICompositionDrawingSurface_iface )
+
+/* Drawing into a surface: the graphics device's context, aimed at it, already drawing. */
+static HRESULT WINAPI surface_interop_BeginDraw( ICompositionDrawingSurfaceInterop *iface, const RECT *update_rect,
+        REFIID iid, void **update_object, POINT *update_offset )
+{
+    struct drawing_surface *impl = impl_from_ICompositionDrawingSurfaceInterop( iface );
+    struct graphics_device *device = impl->device;
+    D2D1_RECT_F clip;
+    HRESULT hr;
+
+    TRACE( "iface %p, update_rect %s, iid %s, update_object %p, update_offset %p.\n", iface,
+           wine_dbgstr_rect( update_rect ), debugstr_guid( iid ), update_object, update_offset );
+
+    if (!update_object || !update_offset) return E_INVALIDARG;
+    *update_object = NULL;
+    if (impl->drawing) return E_ILLEGAL_METHOD_CALL;
+    if (update_rect && (update_rect->left < 0 || update_rect->top < 0 || update_rect->right > impl->size.width
+            || update_rect->bottom > impl->size.height || IsRectEmpty( update_rect )))
+        return E_INVALIDARG;
+
+    /* nothing is packed in an atlas: the rectangle is where it is */
+    update_offset->x = update_rect ? update_rect->left : 0;
+    update_offset->y = update_rect ? update_rect->top : 0;
+
+    if (IsEqualGUID( iid, &IID_ID2D1DeviceContext ) || IsEqualGUID( iid, &IID_ID2D1RenderTarget )
+            || IsEqualGUID( iid, &IID_ID2D1DeviceContext1 ) || IsEqualGUID( iid, &IID_IUnknown ))
+    {
+        EnterCriticalSection( &device->cs );
+        if (FAILED(hr = ID2D1DeviceContext_QueryInterface( device->context, iid, update_object )))
+        {
+            LeaveCriticalSection( &device->cs );
+            return hr;
+        }
+        ID2D1DeviceContext_SetTarget( device->context, (ID2D1Image *)impl->bitmap );
+        ID2D1DeviceContext_SetDpi( device->context, 96.0f, 96.0f );
+        ID2D1DeviceContext_BeginDraw( device->context );
+        ID2D1DeviceContext_SetTransform( device->context, &(D2D1_MATRIX_3X2_F){{{ 1, 0, 0, 1, 0, 0 }}} );
+        if (update_rect)
+        {
+            clip.left = update_rect->left;
+            clip.top = update_rect->top;
+            clip.right = update_rect->right;
+            clip.bottom = update_rect->bottom;
+            ID2D1DeviceContext_PushAxisAlignedClip( device->context, &clip, D2D1_ANTIALIAS_MODE_ALIASED );
+        }
+        impl->drawing = update_rect ? 2 : 1;
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IDXGISurface ) || IsEqualGUID( iid, &IID_IDXGISurface1 ))
+    {
+        IDXGISurface *surface;
+
+        if (FAILED(hr = ID2D1Bitmap1_GetSurface( impl->bitmap, &surface ))) return hr;
+        hr = IDXGISurface_QueryInterface( surface, iid, update_object );
+        IDXGISurface_Release( surface );
+        if (SUCCEEDED(hr)) impl->drawing = 3;
+        return hr;
+    }
+    if (IsEqualGUID( iid, &IID_ID3D11Texture2D ))
+    {
+        IDXGISurface *surface;
+
+        if (FAILED(hr = ID2D1Bitmap1_GetSurface( impl->bitmap, &surface ))) return hr;
+        hr = IDXGISurface_QueryInterface( surface, iid, update_object );
+        IDXGISurface_Release( surface );
+        if (SUCCEEDED(hr)) impl->drawing = 3;
+        return hr;
+    }
+    FIXME( "Drawing through %s is not supported.\n", debugstr_guid( iid ) );
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI surface_interop_EndDraw( ICompositionDrawingSurfaceInterop *iface )
+{
+    struct drawing_surface *impl = impl_from_ICompositionDrawingSurfaceInterop( iface );
+    struct graphics_device *device = impl->device;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p.\n", iface );
+
+    if (!impl->drawing) return E_ILLEGAL_METHOD_CALL;
+    if (impl->drawing != 3)
+    {
+        if (impl->drawing == 2) ID2D1DeviceContext_PopAxisAlignedClip( device->context );
+        hr = ID2D1DeviceContext_EndDraw( device->context, NULL, NULL );
+        ID2D1DeviceContext_SetTarget( device->context, NULL );
+        LeaveCriticalSection( &device->cs );
+    }
+    impl->drawing = FALSE;
+    compositor_changed( impl->compositor );
+    return hr;
+}
+
+static HRESULT WINAPI surface_interop_Resize( ICompositionDrawingSurfaceInterop *iface, SIZE size )
+{
+    struct drawing_surface *impl = impl_from_ICompositionDrawingSurfaceInterop( iface );
+    D2D1_SIZE_U new_size = { size.cx, size.cy };
+
+    TRACE( "iface %p, size %ldx%ld.\n", iface, size.cx, size.cy );
+    if (size.cx < 0 || size.cy < 0) return E_INVALIDARG;
+    if (impl->drawing) return E_ILLEGAL_METHOD_CALL;
+    return drawing_surface_allocate( impl, new_size );
+}
+
+static HRESULT WINAPI surface_interop_Scroll( ICompositionDrawingSurfaceInterop *iface, const RECT *scroll_rect,
+        const RECT *clip_rect, int offset_x, int offset_y )
+{
+    struct drawing_surface *impl = impl_from_ICompositionDrawingSurfaceInterop( iface );
+    RECT src = { 0, 0, impl->size.width, impl->size.height }, dst;
+    D2D1_POINT_2U point;
+    D2D1_RECT_U rect;
+    ID2D1Bitmap1 *copy;
+    D2D1_BITMAP_PROPERTIES1 props;
+    HRESULT hr;
+
+    TRACE( "iface %p, scroll_rect %s, clip_rect %s, offset %d,%d.\n", iface, wine_dbgstr_rect( scroll_rect ),
+           wine_dbgstr_rect( clip_rect ), offset_x, offset_y );
+
+    /* the contents moved, through a copy */
+    if (scroll_rect) IntersectRect( &src, &src, scroll_rect );
+    dst = src;
+    OffsetRect( &dst, offset_x, offset_y );
+    if (clip_rect) IntersectRect( &dst, &dst, clip_rect );
+    IntersectRect( &dst, &dst, &(RECT){ 0, 0, impl->size.width, impl->size.height } );
+    if (IsRectEmpty( &dst )) return S_OK;
+
+    memset( &props, 0, sizeof(props) );
+    props.pixelFormat = ID2D1Bitmap1_GetPixelFormat( impl->bitmap );
+    props.dpiX = props.dpiY = 96.0f;
+    if (FAILED(hr = ID2D1DeviceContext_CreateBitmap( impl->device->context, impl->size, NULL, 0, &props, &copy )))
+        return hr;
+    point.x = point.y = 0;
+    ID2D1Bitmap1_CopyFromBitmap( copy, &point, (ID2D1Bitmap *)impl->bitmap, NULL );
+    point.x = dst.left;
+    point.y = dst.top;
+    rect.left = dst.left - offset_x;
+    rect.top = dst.top - offset_y;
+    rect.right = dst.right - offset_x;
+    rect.bottom = dst.bottom - offset_y;
+    ID2D1Bitmap1_CopyFromBitmap( impl->bitmap, &point, (ID2D1Bitmap *)copy, &rect );
+    ID2D1Bitmap1_Release( copy );
+    return S_OK;
+}
+
+static HRESULT WINAPI surface_interop_ResumeDraw( ICompositionDrawingSurfaceInterop *iface )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI surface_interop_SuspendDraw( ICompositionDrawingSurfaceInterop *iface )
+{
+    return S_OK;
