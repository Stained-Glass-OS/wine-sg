+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IVisual_iface.lpVtbl = &visual_vtbl;
+    impl->IContainerVisual_iface.lpVtbl = &container_vtbl;
+    impl->ISpriteVisual_iface.lpVtbl = &sprite_vtbl;
