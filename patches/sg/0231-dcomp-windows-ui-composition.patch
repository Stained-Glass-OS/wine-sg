+/***********************************************************************
+ *          Visuals
+ */
+
+struct visual
+{
+    IVisual IVisual_iface;
+    IContainerVisual IContainerVisual_iface;
+    ISpriteVisual ISpriteVisual_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+
+    struct compositor *compositor;
+    BOOL sprite;
+    struct visual *parent;      /* not referenced */
+    struct list entry;          /* in the parent's children */
+    struct list children;       /* referenced, bottom first */
+
