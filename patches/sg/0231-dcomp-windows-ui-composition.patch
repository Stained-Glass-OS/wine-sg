+/* one of ours, whichever of its interfaces is given */
+static struct visual *unsafe_visual( IUnknown *unknown )
+{
+    IVisual *visual;
+    struct visual *impl = NULL;
+
+    if (!unknown || FAILED(IUnknown_QueryInterface( unknown, &IID_IVisual, (void **)&visual ))) return NULL;
+    if (visual->lpVtbl == &visual_vtbl) impl = impl_from_IVisual( visual );
+    IVisual_Release( visual );
+    return impl;
+}
