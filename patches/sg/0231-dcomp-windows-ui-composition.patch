+/***********************************************************************
+ *          CompositorController
+ */
+
+struct commit_handler
+{
+    struct list entry;
+    EventRegistrationToken token;
+    ITypedEventHandler_CompositorController_IInspectable *handler;
+};
+
+struct compositor_controller
+{
+    ICompositorController ICompositorController_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    struct compositor *compositor;
+    struct list handlers;
+    INT64 next_token;
+};
+
+static void controller_commit_needed( struct compositor_controller *controller );
+
+static LRESULT CALLBACK notify_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    struct compositor *compositor;
+
+    if (msg == WM_COMPOSITION_CHANGED
+            && (compositor = (struct compositor *)GetWindowLongPtrW( hwnd, GWLP_USERDATA )))
+    {
+        ICompositor_AddRef( &compositor->ICompositor_iface );
+        /* with a controller, the program commits when told; without, it is drawn now */
+        if (compositor->controller)
+            controller_commit_needed( compositor->controller );
+        else
+            compositor_commit( compositor );
+        ICompositor_Release( &compositor->ICompositor_iface );
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static HRESULT compositor_create( struct compositor **out )
+{
+    static const WCHAR class_name[] = L"__wine_composition_notify";
+    struct compositor *impl;
+    WNDCLASSW cls = { 0 };
+    HMODULE module = NULL;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->ICompositor_iface.lpVtbl = &compositor_vtbl;
+    impl->ICompositorInterop_iface.lpVtbl = &compositor_interop_vtbl;
+    impl->ICompositorDesktopInterop_iface.lpVtbl = &desktop_interop_vtbl;
+    impl->IClosable_iface.lpVtbl = &compositor_closable_vtbl;
+    impl->ref = 1;
+    list_init( &impl->targets );
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": compositor.cs");
+
+    GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                        (const WCHAR *)notify_wndproc, &module );
+    cls.lpfnWndProc = notify_wndproc;
+    cls.hInstance = module;
+    cls.lpszClassName = class_name;
+    RegisterClassW( &cls );
+    if ((impl->notify_window = CreateWindowW( class_name, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, module, NULL )))
+        SetWindowLongPtrW( impl->notify_window, GWLP_USERDATA, (LONG_PTR)impl );
+    *out = impl;
+    return S_OK;
+}
+
+static struct compositor_controller *impl_from_ICompositorController( ICompositorController *iface )
+{
+    return CONTAINING_RECORD( iface, struct compositor_controller, ICompositorController_iface );
+}
+
+static void controller_commit_needed( struct compositor_controller *controller )
+{
+    struct commit_handler *handler, *next;
+
+    ICompositorController_AddRef( &controller->ICompositorController_iface );
+    LIST_FOR_EACH_ENTRY_SAFE( handler, next, &controller->handlers, struct commit_handler, entry )
+    {
+        ITypedEventHandler_CompositorController_IInspectable *h = handler->handler;
+
+        ITypedEventHandler_CompositorController_IInspectable_AddRef( h );
+        ITypedEventHandler_CompositorController_IInspectable_Invoke( h,
+                (ICompositorController *)&controller->ICompositorController_iface, NULL );
+        ITypedEventHandler_CompositorController_IInspectable_Release( h );
+    }
+    ICompositorController_Release( &controller->ICompositorController_iface );
+}
+
+static HRESULT WINAPI controller_QueryInterface( ICompositorController *iface, REFIID iid, void **out )
+{
+    struct compositor_controller *impl = impl_from_ICompositorController( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICompositorController ))
+        *out = &impl->ICompositorController_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI controller_AddRef( ICompositorController *iface )
+{
+    return InterlockedIncrement( &impl_from_ICompositorController( iface )->ref );
+}
+
+static ULONG WINAPI controller_Release( ICompositorController *iface )
+{
+    struct compositor_controller *impl = impl_from_ICompositorController( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    struct commit_handler *handler, *next;
+
+    if (!ref)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE( handler, next, &impl->handlers, struct commit_handler, entry )
+        {
+            ITypedEventHandler_CompositorController_IInspectable_Release( handler->handler );
+            free( handler );
+        }
+        impl->compositor->controller = NULL;
+        ICompositor_Release( &impl->compositor->ICompositor_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI controller_GetIids( ICompositorController *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI controller_GetRuntimeClassName( ICompositorController *iface, HSTRING *class_name )
+{
+    return runtime_class_name( class_compositor_controller, class_name );
+}
+
+static HRESULT WINAPI controller_GetTrustLevel( ICompositorController *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI controller_get_Compositor( ICompositorController *iface, ICompositor **value )
+{
+    struct compositor_controller *impl = impl_from_ICompositorController( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return compositor_get_interface( impl->compositor, value );
+}
+
+static HRESULT WINAPI controller_Commit( ICompositorController *iface )
+{
+    struct compositor_controller *impl = impl_from_ICompositorController( iface );
+    TRACE( "iface %p.\n", iface );
+    compositor_commit( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI controller_EnsurePreviousCommitCompletedAsync( ICompositorController *iface,
+        IAsyncAction **action )
+{
+    FIXME( "iface %p, action %p stub!\n", iface, action );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI controller_add_CommitNeeded( ICompositorController *iface,
+        ITypedEventHandler_CompositorController_IInspectable *handler, EventRegistrationToken *token )
+{
+    struct compositor_controller *impl = impl_from_ICompositorController( iface );
+    struct commit_handler *entry;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    if (!handler) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    ITypedEventHandler_CompositorController_IInspectable_AddRef( entry->handler = handler );
+    entry->token.value = token->value = ++impl->next_token;
+    list_add_tail( &impl->handlers, &entry->entry );
+    /* anything waiting is drawn at the next commit */
+    if (impl->compositor->dirty)
+    {
+        impl->compositor->notified = FALSE;
+        compositor_changed( impl->compositor );
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI controller_remove_CommitNeeded( ICompositorController *iface, EventRegistrationToken token )
+{
+    struct compositor_controller *impl = impl_from_ICompositorController( iface );
+    struct commit_handler *entry;
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+    LIST_FOR_EACH_ENTRY( entry, &impl->handlers, struct commit_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        ITypedEventHandler_CompositorController_IInspectable_Release( entry->handler );
+        free( entry );
+        break;
+    }
+    return S_OK;
+}
+
+static const struct ICompositorControllerVtbl controller_vtbl =
+{
+    controller_QueryInterface,
+    controller_AddRef,
+    controller_Release,
+    controller_GetIids,
+    controller_GetRuntimeClassName,
+    controller_GetTrustLevel,
+    controller_get_Compositor,
+    controller_Commit,
+    controller_EnsurePreviousCommitCompletedAsync,
+    controller_add_CommitNeeded,
+    controller_remove_CommitNeeded,
+};
