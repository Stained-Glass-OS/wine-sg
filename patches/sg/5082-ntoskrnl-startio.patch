 }
 
+BOOLEAN WINAPI KeInsertByKeyDeviceQueue( KDEVICE_QUEUE *queue, KDEVICE_QUEUE_ENTRY *entry, ULONG key )
+{
+    LIST_ENTRY *pos;
+    BOOL insert;
+    KIRQL irql;
+
+    TRACE( "queue %p, entry %p, key %lu.\n", queue, entry, key );
+
+    KeAcquireSpinLock( &queue->Lock, &irql );
+    entry->SortKey = key;
+    insert = entry->Inserted = queue->Busy;
+    if (insert)
+    {
+        /* after the entries with a key less than or equal to this one */
+        for (pos = queue->DeviceListHead.Flink; pos != &queue->DeviceListHead; pos = pos->Flink)
+            if (CONTAINING_RECORD( pos, KDEVICE_QUEUE_ENTRY, DeviceListEntry )->SortKey > key) break;
+#ifdef SG_MUTANT_STARTIO_NO_KEY_ORDER
+        pos = &queue->DeviceListHead;
+#endif
+        InsertTailList( pos, &entry->DeviceListEntry );
+    }
+    queue->Busy = TRUE;
+    KeReleaseSpinLock( &queue->Lock, irql );
+
+    return insert;
+}
+
+KDEVICE_QUEUE_ENTRY *WINAPI KeRemoveByKeyDeviceQueue( KDEVICE_QUEUE *queue, ULONG key )
+{
+    KDEVICE_QUEUE_ENTRY *entry = NULL;
+    LIST_ENTRY *pos;
+    KIRQL irql;
+
+    TRACE( "queue %p, key %lu.\n", queue, key );
+
+    KeAcquireSpinLock( &queue->Lock, &irql );
+    if (IsListEmpty( &queue->DeviceListHead )) queue->Busy = FALSE;
+    else
+    {
+        /* the first entry whose key is greater than or equal to the key, else the first entry */
+        for (pos = queue->DeviceListHead.Flink; pos != &queue->DeviceListHead; pos = pos->Flink)
+            if (CONTAINING_RECORD( pos, KDEVICE_QUEUE_ENTRY, DeviceListEntry )->SortKey >= key) break;
+        if (pos == &queue->DeviceListHead) pos = queue->DeviceListHead.Flink;
+        RemoveEntryList( pos );
+        entry = CONTAINING_RECORD( pos, KDEVICE_QUEUE_ENTRY, DeviceListEntry );
+        entry->Inserted = FALSE;
+    }
+    KeReleaseSpinLock( &queue->Lock, irql );
+
+    return entry;
+}
+
+BOOLEAN WINAPI KeRemoveEntryDeviceQueue( KDEVICE_QUEUE *queue, KDEVICE_QUEUE_ENTRY *entry )
+{
+    BOOLEAN removed;
+    KIRQL irql;
+
+    TRACE( "queue %p, entry %p.\n", queue, entry );
+
+    KeAcquireSpinLock( &queue->Lock, &irql );
+    if ((removed = entry->Inserted))
+    {
+        RemoveEntryList( &entry->DeviceListEntry );
+        entry->Inserted = FALSE;
+    }
+    KeReleaseSpinLock( &queue->Lock, irql );
+
+    return removed;
+}
+
 KDEVICE_QUEUE_ENTRY *WINAPI KeRemoveDeviceQueue( KDEVICE_QUEUE *queue )
 {
     KDEVICE_QUEUE_ENTRY *entry = NULL;
