+/* StartIo state of a device that asked for attributes or is inside its StartIo routine */
+struct startio_state
+{
+    struct list entry;
+    DEVICE_OBJECT *device;
+    BOOLEAN deferred, running, pending, pending_by_key, nocancel;
+    ULONG pending_key, pending_cancelable;
+};
+static struct list startio_states = LIST_INIT( startio_states );
+static CRITICAL_SECTION startio_cs;
+static CRITICAL_SECTION_DEBUG startio_cs_debug =
+{
+    0, 0, &startio_cs,
+    { &startio_cs_debug.ProcessLocksList, &startio_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": startio_cs") }
+};
+static CRITICAL_SECTION startio_cs = { &startio_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct startio_state *get_startio_state( DEVICE_OBJECT *device, BOOL create )
+{
+    struct startio_state *state;
+
+    LIST_FOR_EACH_ENTRY( state, &startio_states, struct startio_state, entry )
+        if (state->device == device) return state;
+    if (!create || !(state = calloc( 1, sizeof(*state) ))) return NULL;
+    state->device = device;
+    list_add_tail( &startio_states, &state->entry );
+    return state;
+}
+
+/* the next irp of the device queue, NULL when it is empty (the device is idle then) */
+static IRP *dequeue_next_packet( DEVICE_OBJECT *device, BOOLEAN cancelable, BOOL by_key, ULONG key )
+{
+    KDEVICE_QUEUE_ENTRY *entry;
+    IRP *irp;
+
+    for (;;)
+    {
+        entry = by_key ? KeRemoveByKeyDeviceQueue( &device->DeviceQueue, key ) : KeRemoveDeviceQueue( &device->DeviceQueue );
+        if (!entry)
+        {
+            device->CurrentIrp = NULL;
+            return NULL;
+        }
+        irp = CONTAINING_RECORD( entry, IRP, Tail.Overlay.DeviceQueueEntry );
+        /* an irp whose cancel routine already ran is the cancel routine's to complete */
+        if (cancelable && !IoSetCancelRoutine( irp, NULL )) continue;
+        return irp;
+    }
+}
+
+/* run the device's StartIo routine for the irp. With the deferred attribute, a call to
+ * IoStartNextPacket from inside the routine waits until the routine has returned. */
+static void call_start_io( DEVICE_OBJECT *device, IRP *irp )
+{
+    struct startio_state *state;
+    BOOL deferred;
+
+    EnterCriticalSection( &startio_cs );
+    state = get_startio_state( device, FALSE );
+    deferred = state && state->deferred;
+    if (deferred) state->running = TRUE;
+    LeaveCriticalSection( &startio_cs );
+
+    for (;;)
+    {
+        BOOLEAN cancelable, by_key;
+        ULONG key;
+
+        device->CurrentIrp = irp;
+        device->DriverObject->DriverStartIo( device, irp );
+        if (!deferred) return;
+
+        EnterCriticalSection( &startio_cs );
+        state = get_startio_state( device, FALSE );
+        if (!state || !state->pending)
+        {
+            if (state) state->running = FALSE;
+            LeaveCriticalSection( &startio_cs );
+            return;
+        }
+        state->pending = FALSE;
+        cancelable = state->pending_cancelable;
+        by_key = state->pending_by_key;
+        key = state->pending_key;
+        LeaveCriticalSection( &startio_cs );
+
+        if (!(irp = dequeue_next_packet( device, cancelable, by_key, key )))
+        {
+            EnterCriticalSection( &startio_cs );
+            if ((state = get_startio_state( device, FALSE ))) state->running = FALSE;
+            LeaveCriticalSection( &startio_cs );
+            return;
+        }
+    }
+}
+
+static void start_next_packet( DEVICE_OBJECT *device, BOOLEAN cancelable, BOOL by_key, ULONG key )
+{
+    struct startio_state *state;
+    IRP *irp;
+
+    EnterCriticalSection( &startio_cs );
+    state = get_startio_state( device, FALSE );
+#ifdef SG_MUTANT_STARTIO_NO_DEFER
+    if (0)
+#else
+    if (state && state->deferred && state->running)
+#endif
+    {
+        state->pending = TRUE;
+        state->pending_cancelable = cancelable;
+        state->pending_by_key = by_key;
+        state->pending_key = key;
+        LeaveCriticalSection( &startio_cs );
+        return;
+    }
+    LeaveCriticalSection( &startio_cs );
+
+    if ((irp = dequeue_next_packet( device, cancelable, by_key, key ))) call_start_io( device, irp );
+}
+
+static void free_startio_state( DEVICE_OBJECT *device )
+{
+    struct startio_state *state;
+
+    EnterCriticalSection( &startio_cs );
+    if ((state = get_startio_state( device, FALSE )))
+    {
+        list_remove( &state->entry );
+        free( state );
+    }
+    LeaveCriticalSection( &startio_cs );
+}
+
+/*****************************************************
+ *           IoStartPacket  (NTOSKRNL.EXE.@)
+ */
+VOID WINAPI IoStartPacket(PDEVICE_OBJECT device, PIRP irp, PULONG key, PDRIVER_CANCEL cancel)
+{
+    BOOLEAN queued;
+    KIRQL irql;
+
+    TRACE( "(%p %p %p %p)\n", device, irp, key, cancel );
+
+#ifndef SG_MUTANT_STARTIO_NO_CANCEL
+    if (cancel) IoSetCancelRoutine( irp, cancel );
+#endif
+    if (key) queued = KeInsertByKeyDeviceQueue( &device->DeviceQueue, &irp->Tail.Overlay.DeviceQueueEntry, *key );
+    else queued = KeInsertDeviceQueue( &device->DeviceQueue, &irp->Tail.Overlay.DeviceQueueEntry );
+
+    if (!queued)
+    {
+        /* the device was idle: this irp is processed at once and can no longer be canceled */
+        if (cancel) IoSetCancelRoutine( irp, NULL );
+        call_start_io( device, irp );
+    }
+    else if (cancel && irp->Cancel && KeRemoveEntryDeviceQueue( &device->DeviceQueue, &irp->Tail.Overlay.DeviceQueueEntry ))
+    {
+        /* canceled before it was queued */
+        if (IoSetCancelRoutine( irp, NULL ))
+        {
+            IoAcquireCancelSpinLock( &irql );
+            irp->CancelIrql = irql;
+            cancel( device, irp );
+        }
+    }
+}
+
+/*****************************************************
+ *           IoSetStartIoAttributes  (NTOSKRNL.EXE.@)
+ */
+VOID WINAPI IoSetStartIoAttributes(PDEVICE_OBJECT device, BOOLEAN deferred, BOOLEAN nocancel)
+{
+    struct startio_state *state;
+
+    TRACE( "(%p %d %d)\n", device, deferred, nocancel );
+
+    EnterCriticalSection( &startio_cs );
+    if ((state = get_startio_state( device, TRUE )))
+    {
+        state->deferred = deferred;
+        state->nocancel = nocancel;
+    }
+    LeaveCriticalSection( &startio_cs );
+}
+
 /*****************************************************
  *           IoStartNextPacket  (NTOSKRNL.EXE.@)
  */
 VOID WINAPI IoStartNextPacket(PDEVICE_OBJECT deviceobject, BOOLEAN cancelable)
 {
-    FIXME("(%p %d) stub\n", deviceobject, cancelable);
+    TRACE( "(%p %d)\n", deviceobject, cancelable );
+    start_next_packet( deviceobject, cancelable, FALSE, 0 );
+}
+
+/*****************************************************
+ *           IoStartNextPacketByKey  (NTOSKRNL.EXE.@)
+ */
+VOID WINAPI IoStartNextPacketByKey(PDEVICE_OBJECT deviceobject, BOOLEAN cancelable, ULONG key)
+{
+    TRACE( "(%p %d %lu)\n", deviceobject, cancelable, key );
+    start_next_packet( deviceobject, cancelable, TRUE, key );
 }
 
 /*****************************************************
