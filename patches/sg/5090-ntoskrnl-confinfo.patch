From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: IoGetConfigurationInformation counts.

The structure it returned was all zero ("partial stub"). It now starts with
the counts of the numbered device objects of each kind that exist in \Device
(disks, floppies, CD-ROMs, tapes, SCSI ports, serial and parallel ports,
changers), as the system's own drivers supply them, and stays one structure
that drivers raise as they create their devices.

Gate: test/ntoskrnl-confinfo-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -2144,14 +2144,65 @@
 }
 
 static CONFIGURATION_INFORMATION configuration_information;
+static INIT_ONCE configuration_once = INIT_ONCE_STATIC_INIT;
+
+/* the counts the system's own drivers supply: the numbered device objects of each kind that exist
+ * (\Device\Harddisk0, Serial1, ...); drivers add the devices they create to the structure */
+static BOOL CALLBACK init_configuration_information( INIT_ONCE *once, void *param, void **context )
+{
+    static const struct { const WCHAR *prefix; unsigned int offset; } kinds[] =
+    {
+        { L"Harddisk", FIELD_OFFSET( CONFIGURATION_INFORMATION, DiskCount ) },
+        { L"Floppy", FIELD_OFFSET( CONFIGURATION_INFORMATION, FloppyCount ) },
+        { L"CdRom", FIELD_OFFSET( CONFIGURATION_INFORMATION, CdRomCount ) },
+        { L"Tape", FIELD_OFFSET( CONFIGURATION_INFORMATION, TapeCount ) },
+        { L"ScsiPort", FIELD_OFFSET( CONFIGURATION_INFORMATION, ScsiPortCount ) },
+        { L"Serial", FIELD_OFFSET( CONFIGURATION_INFORMATION, SerialCount ) },
+        { L"Parallel", FIELD_OFFSET( CONFIGURATION_INFORMATION, ParallelCount ) },
+        { L"Changer", FIELD_OFFSET( CONFIGURATION_INFORMATION, MediumChangerCount ) },
+    };
+    UNICODE_STRING name = RTL_CONSTANT_STRING( L"\\Device" );
+    OBJECT_ATTRIBUTES attr;
+    HANDLE dir;
+    char buffer[1024];
+    DIRECTORY_BASIC_INFORMATION *info = (DIRECTORY_BASIC_INFORMATION *)buffer;
+    ULONG context_index = 0, size;
+    NTSTATUS status;
+
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, NULL, NULL );
+    if (NtOpenDirectoryObject( &dir, 0x0001 /* DIRECTORY_QUERY */, &attr )) return TRUE;
+    while (!(status = NtQueryDirectoryObject( dir, info, sizeof(buffer), TRUE, FALSE, &context_index, &size )))
+    {
+        const WCHAR *str = info->ObjectName.Buffer;
+        unsigned int i, len = info->ObjectName.Length / sizeof(WCHAR), j;
+
+        for (i = 0; i < ARRAY_SIZE(kinds); i++)
+        {
+            size_t prefix_len = wcslen( kinds[i].prefix );
+
+            if (len <= prefix_len || _wcsnicmp( str, kinds[i].prefix, prefix_len )) continue;
+            for (j = prefix_len; j < len; j++) if (str[j] < '0' || str[j] > '9') break;
+            if (j == len) ++*(ULONG *)((char *)&configuration_information + kinds[i].offset);
+        }
+    }
+    NtClose( dir );
+    return TRUE;
+}
 
 /***********************************************************************
  *           IoGetConfigurationInformation    (NTOSKRNL.EXE.@)
  */
 PCONFIGURATION_INFORMATION WINAPI IoGetConfigurationInformation(void)
 {
-    FIXME( "partial stub\n" );
-    /* FIXME: return actual devices on system */
+#ifdef SG_MUTANT_CONFINFO_ZERO
+    return &configuration_information;
+#endif
+#ifdef SG_MUTANT_CONFINFO_EVERY_CALL
+    memset( &configuration_information, 0, sizeof(configuration_information) );
+    init_configuration_information( NULL, NULL, NULL );
+#else
+    InitOnceExecuteOnce( &configuration_once, init_configuration_information, NULL, NULL );
+#endif
     return &configuration_information;
 }
 
