+/* Stained Glass OS 5941: a screen reader telling the system it runs (and
+ * about touch interaction): nothing here acts on either, so both are taken
+ * note of. NVDA binds them at start, and stopped with "function not found". */
+HRESULT WINAPI AccSetRunningUtilityState( HWND hwnd, DWORD mask, DWORD state )
+{
+    FIXME( "(%p, %#lx, %#lx)\n", hwnd, mask, state );
+    return S_OK;
+}
+
+HRESULT WINAPI AccNotifyTouchInteraction( HWND app, HWND target, POINT pt )
+{
+    FIXME( "(%p, %p, %s)\n", app, target, wine_dbgstr_point( &pt ) );
+    return S_OK;
+}
+
 UINT WINAPI GetStateTextW(DWORD state_bit, WCHAR *state_str, UINT state_str_len)
 {
     DWORD state_id;
