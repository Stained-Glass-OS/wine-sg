 @ stdcall -import GetConsoleWindow()
--- a/dlls/user32/message.c
+++ b/dlls/user32/message.c
@@ -1296,6 +1296,44 @@
 }
 
 
+/***********************************************************************
+ *		GhostWindowFromHungWindow (USER32.@)
+ *
+ * Stained Glass OS 5941: Wine draws no ghost window for a hung one.
+ */
+HWND WINAPI GhostWindowFromHungWindow( HWND hwnd )
+{
+    TRACE( "(%p)\n", hwnd );
+#ifdef SG_MUTANT_NO_NVDA_BINDINGS
+    return (HWND)1;
+#endif
+    return NULL;
+}
+
+/***********************************************************************
+ *		RegisterPointerInputTarget (USER32.@)
+ *
+ * Stained Glass OS 5941: taking every pointer of a type is for programs with
+ * UIAccess; as on Windows for one without it, access is denied. NVDA binds it
+ * (and its Unregister) at start, and stopped with "function not found".
+ */
+BOOL WINAPI RegisterPointerInputTarget( HWND hwnd, POINTER_INPUT_TYPE type )
+{
+    FIXME( "(%p, %lu): no UIAccess\n", hwnd, type );
+    SetLastError( ERROR_ACCESS_DENIED );
+    return FALSE;
+}
+
+/***********************************************************************
+ *		UnregisterPointerInputTarget (USER32.@)
+ */
+BOOL WINAPI UnregisterPointerInputTarget( HWND hwnd, POINTER_INPUT_TYPE type )
+{
+    FIXME( "(%p, %lu): no UIAccess\n", hwnd, type );
+    SetLastError( ERROR_ACCESS_DENIED );
+    return FALSE;
+}
+
