From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: DDS decoder query reader, DDS encoder Initialize and SetParameters checks

Results the Wine tests record from Windows, which were todo (41 marks).

 - IWICBitmapDecoder::GetMetadataQueryReader of the DDS decoder returns a query reader
   (S_OK) with the DDS container format and no metadata, instead of E_NOTIMPL.
 - The DDS encoder refuses a cache option beyond WICBitmapEncoderNoCache with
   WINCODEC_ERR_UNSUPPORTEDOPERATION, and the next Initialize on that encoder is E_INVALIDARG.
 - IWICDdsEncoder::SetParameters answers WINCODEC_ERR_BADHEADER for a format that is not
   block compressed (BC1 to BC7) and for cube maps, instead of accepting anything.
---
--- a/dlls/windowscodecs/ddsformat.c
+++ b/dlls/windowscodecs/ddsformat.c
@@ -169,6 +169,7 @@ typedef struct DdsEncoder {
     UINT frame_index;
     BOOL uncommitted_frame;
     BOOL committed;
+    BOOL init_failed;
     dds_info info;
 } DdsEncoder;
 
@@ -1173,14 +1174,103 @@ static HRESULT WINAPI DdsDecoder_CopyPalette(IWICBitmapDecoder *iface,
     return WINCODEC_ERR_PALETTEUNAVAILABLE;
 }
 
+/* A DDS file carries no metadata: its query reader has no blocks. */
+struct dds_empty_blocks
+{
+    IWICMetadataBlockReader IWICMetadataBlockReader_iface;
+    LONG ref;
+};
+
+static struct dds_empty_blocks *impl_from_dds_blocks(IWICMetadataBlockReader *iface)
+{
+    return CONTAINING_RECORD(iface, struct dds_empty_blocks, IWICMetadataBlockReader_iface);
+}
+
+static HRESULT WINAPI dds_blocks_QueryInterface(IWICMetadataBlockReader *iface, REFIID iid, void **out)
+{
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IWICMetadataBlockReader))
+    {
+        *out = iface;
+        IWICMetadataBlockReader_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI dds_blocks_AddRef(IWICMetadataBlockReader *iface)
+{
+    return InterlockedIncrement(&impl_from_dds_blocks(iface)->ref);
+}
+
+static ULONG WINAPI dds_blocks_Release(IWICMetadataBlockReader *iface)
+{
+    struct dds_empty_blocks *blocks = impl_from_dds_blocks(iface);
+    ULONG ref = InterlockedDecrement(&blocks->ref);
+
+    if (!ref) free(blocks);
+    return ref;
+}
+
+static HRESULT WINAPI dds_blocks_GetContainerFormat(IWICMetadataBlockReader *iface, GUID *format)
+{
+    if (!format) return E_INVALIDARG;
+    *format = GUID_ContainerFormatDds;
+    return S_OK;
+}
+
+static HRESULT WINAPI dds_blocks_GetCount(IWICMetadataBlockReader *iface, UINT *count)
+{
+    if (!count) return E_INVALIDARG;
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI dds_blocks_GetReaderByIndex(IWICMetadataBlockReader *iface, UINT index,
+        IWICMetadataReader **reader)
+{
+    if (!reader) return E_INVALIDARG;
+    *reader = NULL;
+    return WINCODEC_ERR_VALUEOUTOFRANGE;
+}
+
+static HRESULT WINAPI dds_blocks_GetEnumerator(IWICMetadataBlockReader *iface, IEnumUnknown **enumerator)
+{
+    return E_NOTIMPL;
+}
+
+static const IWICMetadataBlockReaderVtbl dds_blocks_vtbl =
+{
+    dds_blocks_QueryInterface,
+    dds_blocks_AddRef,
+    dds_blocks_Release,
+    dds_blocks_GetContainerFormat,
+    dds_blocks_GetCount,
+    dds_blocks_GetReaderByIndex,
+    dds_blocks_GetEnumerator,
+};
+
 static HRESULT WINAPI DdsDecoder_GetMetadataQueryReader(IWICBitmapDecoder *iface,
                                                         IWICMetadataQueryReader **ppIMetadataQueryReader)
 {
-    if (!ppIMetadataQueryReader) return E_INVALIDARG;
+    struct dds_empty_blocks *blocks;
+    HRESULT hr;
 
-    FIXME("(%p,%p)\n", iface, ppIMetadataQueryReader);
+    TRACE("(%p,%p)\n", iface, ppIMetadataQueryReader);
 
+    if (!ppIMetadataQueryReader) return E_INVALIDARG;
+
+#ifdef SG_MUTANT_DDSQ_UNSUPPORTED
+    *ppIMetadataQueryReader = NULL;
     return E_NOTIMPL;
+#endif
+    if (!(blocks = calloc(1, sizeof(*blocks)))) return E_OUTOFMEMORY;
+    blocks->IWICMetadataBlockReader_iface.lpVtbl = &dds_blocks_vtbl;
+    blocks->ref = 1;
+
+    hr = MetadataQueryReader_CreateInstance(&blocks->IWICMetadataBlockReader_iface, NULL, ppIMetadataQueryReader);
+    IWICMetadataBlockReader_Release(&blocks->IWICMetadataBlockReader_iface);
+    return hr;
 }
 
 static HRESULT WINAPI DdsDecoder_GetPreview(IWICBitmapDecoder *iface,
@@ -1808,6 +1898,12 @@ static ULONG WINAPI DdsEncoder_Dds_Release(IWICDdsEncoder *iface)
     return IWICBitmapEncoder_Release(&This->IWICBitmapEncoder_iface);
 }
 
+static BOOL dds_is_block_compressed_format(DXGI_FORMAT format)
+{
+    return (format >= DXGI_FORMAT_BC1_TYPELESS && format <= DXGI_FORMAT_BC5_SNORM)
+            || (format >= DXGI_FORMAT_BC6H_TYPELESS && format <= DXGI_FORMAT_BC7_UNORM_SRGB);
+}
+
 static HRESULT WINAPI DdsEncoder_Dds_SetParameters(IWICDdsEncoder *iface,
                                                    WICDdsParameters *parameters)
 {
@@ -1826,6 +1922,15 @@ static HRESULT WINAPI DdsEncoder_Dds_SetParameters(IWICDdsEncoder *iface,
         goto end;
     }
 
+    /* only block compressed formats, and no cube maps, can be written */
+#ifndef SG_MUTANT_DDSENC_ANY_PARAMS
+    if (!dds_is_block_compressed_format(parameters->DxgiFormat) || parameters->Dimension == WICDdsTextureCube)
+    {
+        hr = WINCODEC_ERR_BADHEADER;
+        goto end;
+    }
+#endif
+
     This->info.width      = parameters->Width;
     This->info.height     = parameters->Height;
     This->info.depth      = parameters->Depth;
@@ -2006,6 +2111,21 @@ static HRESULT WINAPI DdsEncoder_Initialize(IWICBitmapEncoder *iface,
 
     EnterCriticalSection(&This->lock);
 
+    /* an unknown cache option is refused, and the encoder takes the next call for a bad one */
+    if (This->init_failed)
+    {
+        hr = E_INVALIDARG;
+        goto end;
+    }
+#ifndef SG_MUTANT_DDSENC_ANY_CACHE
+    if (cacheOption > WICBitmapEncoderNoCache)
+    {
+        This->init_failed = TRUE;
+        hr = WINCODEC_ERR_UNSUPPORTEDOPERATION;
+        goto end;
+    }
+#endif
+
     if (This->stream)
     {
         hr = WINCODEC_ERR_WRONGSTATE;
@@ -2178,6 +2298,7 @@ HRESULT DdsEncoder_CreateInstance( REFIID iid, void **ppv)
     This->frame_index = 0;
     This->uncommitted_frame = FALSE;
     This->committed = FALSE;
+    This->init_failed = FALSE;
     InitializeCriticalSectionEx(&This->lock, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
     This->lock.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": DdsEncoder.lock");
 
--- a/dlls/windowscodecs/tests/ddsformat.c
+++ b/dlls/windowscodecs/tests/ddsformat.c
@@ -817,7 +817,7 @@ static void test_dds_decoder_global_properties(IWICBitmapDecoder *decoder)
     }
 
     hr = IWICBitmapDecoder_GetMetadataQueryReader(decoder, &metadata_reader);
-    todo_wine ok (hr == S_OK, "GetMetadataQueryReader got unexpected hr %#lx\n", hr);
+    ok (hr == S_OK, "GetMetadataQueryReader got unexpected hr %#lx\n", hr);
     hr = IWICBitmapDecoder_GetMetadataQueryReader(decoder, NULL);
     ok(hr == E_INVALIDARG, "GetMetadataQueryReader got unexpected hr %#lx\n", hr);
 
@@ -1330,11 +1330,9 @@ static void test_dds_encoder_initialize(void)
     /* initialize with invalid cache option */
 
     hr = IWICBitmapEncoder_Initialize(encoder, (IStream *)stream, 0xdeadbeef);
-    todo_wine
     ok(hr == WINCODEC_ERR_UNSUPPORTEDOPERATION, "Initialize got unexpected hr %#lx\n", hr);
 
     hr = IWICBitmapEncoder_Initialize(encoder, (IStream *)stream, WICBitmapEncoderNoCache);
-    todo_wine
     ok(hr == E_INVALIDARG, "Initialize got unexpected hr %#lx\n", hr);
 
     IWICBitmapEncoder_Release(encoder);
@@ -1428,7 +1426,6 @@ static void test_dds_encoder_params(void)
     for (i = 0; i < ARRAY_SIZE(test_data); ++i)
     {
         hr = IWICDdsEncoder_SetParameters(dds_encoder, &test_data[i].expected_parameters);
-        todo_wine_if(test_data[i].init_hr != S_OK)
         ok((hr == S_OK && test_data[i].init_hr == S_OK) || hr == WINCODEC_ERR_BADHEADER,
            "Test %u: SetParameters got unexpected hr %#lx\n", i, hr);
     }
