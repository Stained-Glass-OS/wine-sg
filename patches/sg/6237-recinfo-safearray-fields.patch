From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] oleaut32: a record's SAFEARRAY fields are the arrays they point to

IRecordInfo::RecordClear destroyed a SAFEARRAY field by passing the field's address to SafeArrayDestroy instead of the array it holds, and RecordCopy passed the field's address to SafeArrayCopy, so clearing a record whose structure holds an array read the field before it (often another array's pointer) as the array's hidden record info and crashed, and a copied record shared or lost its array. The field's array is now destroyed and the field cleared, a copy gets its own copy of the array, and destroying or copying an array of records no longer starts at the first record for a later cell or calls through a missing record info.
---
diff --git a/dlls/oleaut32/recinfo.c b/dlls/oleaut32/recinfo.c
index 766d80b..f69d5bd 100644
--- a/dlls/oleaut32/recinfo.c
+++ b/dlls/oleaut32/recinfo.c
@@ -273,7 +273,13 @@ static HRESULT WINAPI IRecordInfoImpl_RecordClear(IRecordInfo *iface, PVOID pvEx
                 *(void**)var = NULL;
                 break;
             case VT_SAFEARRAY:
+                /* the field holds the array's pointer (Stained Glass OS, wine-sg 6237) */
+#ifndef SG_MUTANT_RECORD_SAFEARRAY_FIELD_ADDRESS
+                SafeArrayDestroy(*(SAFEARRAY **)var);
+                *(SAFEARRAY **)var = NULL;
+#else
                 SafeArrayDestroy(var);
+#endif
                 break;
 #ifndef SG_MUTANT_RECORD_NESTED_IGNORED
             case VT_RECORD:
@@ -359,7 +365,11 @@ static HRESULT WINAPI IRecordInfoImpl_RecordCopy(IRecordInfo *iface, void *src_r
                 break;
             }
             case VT_SAFEARRAY:
+#ifndef SG_MUTANT_RECORD_SAFEARRAY_FIELD_ADDRESS
+                hr = SafeArrayCopy(*(SAFEARRAY **)src, (SAFEARRAY **)dest);
+#else
                 hr = SafeArrayCopy(src, dest);
+#endif
                 break;
 #ifndef SG_MUTANT_RECORD_NESTED_IGNORED
             case VT_RECORD:
diff --git a/dlls/oleaut32/safearray.c b/dlls/oleaut32/safearray.c
index 92a73c7..a4a38ee 100644
--- a/dlls/oleaut32/safearray.c
+++ b/dlls/oleaut32/safearray.c
@@ -308,9 +308,9 @@ static HRESULT SAFEARRAY_DestroyData(SAFEARRAY *psa, ULONG ulStartCell)
     {
       IRecordInfo *lpRecInfo;
 
-      if (SUCCEEDED(SafeArrayGetRecordInfo(psa, &lpRecInfo)))
+      if (SUCCEEDED(SafeArrayGetRecordInfo(psa, &lpRecInfo)) && lpRecInfo)
       {
-        PBYTE pRecordData = psa->pvData;
+        PBYTE pRecordData = (BYTE *)psa->pvData + ulStartCell * psa->cbElements;
         while(ulCellCount--)
         {
           IRecordInfo_RecordClear(lpRecInfo, pRecordData);
@@ -404,7 +404,7 @@ static HRESULT SAFEARRAY_CopyData(SAFEARRAY *psa, SAFEARRAY *dest)
       IRecordInfo *record;
 
       SafeArrayGetRecordInfo(psa, &record);
-      while (ulCellCount--)
+      while (record && ulCellCount--)
       {
           /* RecordCopy() clears destination record */
           hr = IRecordInfo_RecordCopy(record, src_data, dest_data);
@@ -417,7 +417,7 @@ static HRESULT SAFEARRAY_CopyData(SAFEARRAY *psa, SAFEARRAY *dest)
       /* This value is set to 32 bytes by default on descriptor creation,
          update with actual structure size. */
       dest->cbElements = psa->cbElements;
-      IRecordInfo_Release(record);
+      if (record) IRecordInfo_Release(record);
     }
     else if (psa->fFeatures & (FADF_UNKNOWN|FADF_DISPATCH))
     {
