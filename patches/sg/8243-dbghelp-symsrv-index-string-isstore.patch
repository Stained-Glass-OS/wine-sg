From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dbghelp: SymSrvGetFileIndexString, SymSrvIsStore

SymSrvGetFileIndexString(W) give the index string a symbol store files a file under -- a PDB's GUID and age (signature and age for an old PDB), an image's or .dbg file's time stamp and image size, in hexadecimal; an image without debug information still has its stamp and size. SymSrvIsStore(W) say whether a directory is a symbol store (its pingme.txt file or 000Admin directory). They were spec stubs; dbghelp.h gains them.
---
--- a/include/dbghelp.h
+++ b/include/dbghelp.h
@@ -1122,6 +1122,10 @@
 BOOL IMAGEAPI SymSrvGetFileIndexesW(PCWSTR, GUID *, PDWORD, PDWORD, DWORD);
 BOOL IMAGEAPI SymSrvGetFileIndexInfo(PCSTR, PSYMSRV_INDEX_INFO, DWORD);
 BOOL IMAGEAPI SymSrvGetFileIndexInfoW(PCWSTR, PSYMSRV_INDEX_INFOW, DWORD);
+BOOL IMAGEAPI SymSrvGetFileIndexString(HANDLE, PCSTR, PCSTR, PSTR, size_t, DWORD);
+BOOL IMAGEAPI SymSrvGetFileIndexStringW(HANDLE, PCWSTR, PCWSTR, PWSTR, size_t, DWORD);
+BOOL IMAGEAPI SymSrvIsStore(HANDLE, PCSTR);
+BOOL IMAGEAPI SymSrvIsStoreW(HANDLE, PCWSTR);
 
 typedef BOOL     (WINAPI* PSYMBOLSERVERPROC)(PCSTR, PCSTR, PVOID, DWORD, DWORD, PSTR);
 typedef BOOL     (WINAPI* PSYMBOLSERVERPROCA)(PCSTR, PCSTR, PVOID, DWORD, DWORD, PSTR);
--- a/dlls/dbghelp/path.c
+++ b/dlls/dbghelp/path.c
@@ -1010,3 +1010,113 @@
     }
     return TRUE;
 }
+
+
+#ifndef SG_MUTANT_NO_SYMSRV_INDEX
+/******************************************************************
+ *      SymSrvGetFileIndexStringW (DBGHELP.@)
+ *
+ * (wine-sg 8243) The index string a symbol store files a file under: a PDB's GUID and age (or signature and age
+ * for an old one), an image's or .dbg file's time stamp and image size, as hexadecimal.
+ */
+BOOL WINAPI SymSrvGetFileIndexStringW(HANDLE process, const WCHAR *srv_path, const WCHAR *file, WCHAR *index,
+                                      size_t size, DWORD flags)
+{
+    static const GUID null_guid;
+    SYMSRV_INDEX_INFOW info;
+    const WCHAR *ext;
+    WCHAR buf[64];
+
+    TRACE("(%p, %s, %s, %p, %Iu, 0x%08lx)\n", process, debugstr_w(srv_path), debugstr_w(file), index, size, flags);
+
+    if (!file || !index)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    memset(&info, 0, sizeof(info));
+    info.sizeofstruct = sizeof(info);
+    ext = wcsrchr(file, '.');
+    /* an image without debug information (ERROR_BAD_EXE_FORMAT) still has its time stamp and size */
+    if (!SymSrvGetFileIndexInfoW(file, &info, 0) &&
+        (GetLastError() != ERROR_BAD_EXE_FORMAT || (ext && !wcsicmp(ext, L".pdb"))))
+        return FALSE;
+    if (ext && !wcsicmp(ext, L".pdb"))
+    {
+        if (!memcmp(&info.guid, &null_guid, sizeof(null_guid)))
+            swprintf(buf, ARRAY_SIZE(buf), L"%08X%x", info.sig, info.age);
+        else
+            swprintf(buf, ARRAY_SIZE(buf), L"%08X%04X%04X%02X%02X%02X%02X%02X%02X%02X%02X%x",
+                     info.guid.Data1, info.guid.Data2, info.guid.Data3, info.guid.Data4[0], info.guid.Data4[1],
+                     info.guid.Data4[2], info.guid.Data4[3], info.guid.Data4[4], info.guid.Data4[5],
+                     info.guid.Data4[6], info.guid.Data4[7], info.age);
+    }
+    else swprintf(buf, ARRAY_SIZE(buf), L"%08X%x", info.timestamp, info.size);
+    if (wcslen(buf) >= size)
+    {
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+    wcscpy(index, buf);
+    return TRUE;
+}
+
+/******************************************************************
+ *      SymSrvGetFileIndexString (DBGHELP.@)
+ */
+BOOL WINAPI SymSrvGetFileIndexString(HANDLE process, const char *srv_path, const char *file, char *index,
+                                     size_t size, DWORD flags)
+{
+    WCHAR fileW[MAX_PATH], indexW[64];
+
+    if (!file || !index)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    MultiByteToWideChar(CP_ACP, 0, file, -1, fileW, ARRAY_SIZE(fileW));
+    if (!SymSrvGetFileIndexStringW(process, NULL, fileW, indexW, ARRAY_SIZE(indexW), flags)) return FALSE;
+    if (wcslen(indexW) >= size)
+    {
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+    WideCharToMultiByte(CP_ACP, 0, indexW, -1, index, size, NULL, NULL);
+    return TRUE;
+}
+
+/******************************************************************
+ *      SymSrvIsStoreW (DBGHELP.@)
+ *
+ * Whether a directory is a symbol store: it has the pingme.txt file or the 000Admin directory symstore makes.
+ */
+BOOL WINAPI SymSrvIsStoreW(HANDLE process, const WCHAR *path)
+{
+    WCHAR buf[MAX_PATH];
+    DWORD attr;
+
+    TRACE("(%p, %s)\n", process, debugstr_w(path));
+
+    if (!path || wcslen(path) + 12 >= MAX_PATH) return FALSE;
+    swprintf(buf, ARRAY_SIZE(buf), L"%s\\pingme.txt", path);
+    if ((attr = GetFileAttributesW(buf)) != INVALID_FILE_ATTRIBUTES && !(attr & FILE_ATTRIBUTE_DIRECTORY)) return TRUE;
+    swprintf(buf, ARRAY_SIZE(buf), L"%s\\000Admin", path);
+    return (attr = GetFileAttributesW(buf)) != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+/******************************************************************
+ *      SymSrvIsStore (DBGHELP.@)
+ */
+BOOL WINAPI SymSrvIsStore(HANDLE process, const char *path)
+{
+    WCHAR pathW[MAX_PATH];
+
+    if (!path || !MultiByteToWideChar(CP_ACP, 0, path, -1, pathW, ARRAY_SIZE(pathW))) return FALSE;
+    return SymSrvIsStoreW(process, pathW);
+}
+#else
+BOOL WINAPI SymSrvGetFileIndexStringW(HANDLE p, const WCHAR *s, const WCHAR *f, WCHAR *i, size_t n, DWORD fl) { return FALSE; }
+BOOL WINAPI SymSrvGetFileIndexString(HANDLE p, const char *s, const char *f, char *i, size_t n, DWORD fl) { return FALSE; }
+BOOL WINAPI SymSrvIsStoreW(HANDLE p, const WCHAR *path) { return FALSE; }
+BOOL WINAPI SymSrvIsStore(HANDLE p, const char *path) { return FALSE; }
+#endif
