From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 07:13:34 -0700
Subject: [PATCH] windows.web, windows.storage, appxdeploymentclient:
 IInspectable GetIids/GetRuntimeClassName/GetTrustLevel of factories and
 objects

GetIids now returns the interface list of each object (Json factories, HttpClient, HttpBaseProtocolFilter,
DataWriter, Buffer, InMemoryRandomAccessStream, RandomAccessStreamReference, PackageManager and the
deployment operation), the activation factories report their runtime class and BaseTrust, and a null
count/iids pointer is E_POINTER.

diff --git a/dlls/appxdeploymentclient/async.c b/dlls/appxdeploymentclient/async.c
index 063a211..bf7f619 100644
--- a/dlls/appxdeploymentclient/async.c
+++ b/dlls/appxdeploymentclient/async.c
@@ -199,7 +199,18 @@ static ULONG WINAPI op_Release( IAsyncOperationWithProgress_DeploymentResult_Dep
 
 static HRESULT WINAPI op_GetIids( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface, ULONG *count, IID **iids )
 {
-    return E_NOTIMPL;
+    static const IID *const ids[] = { &IID_IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress, &IID_IAsyncInfo };
+    IID *list;
+    ULONG i;
+
+    TRACE( "iface %p, count %p, iids %p.\n", iface, count, iids );
+
+    if (!count || !iids) return E_POINTER;
+    if (!(list = CoTaskMemAlloc( ARRAY_SIZE(ids) * sizeof(*list) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < ARRAY_SIZE(ids); i++) list[i] = *ids[i];
+    *count = ARRAY_SIZE(ids);
+    *iids = list;
+    return S_OK;
 }
 
 static HRESULT WINAPI op_GetRuntimeClassName( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface, HSTRING *name )
