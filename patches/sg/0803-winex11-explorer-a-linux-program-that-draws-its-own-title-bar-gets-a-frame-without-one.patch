+        SetWindowLongW( frame, GWL_STYLE, WS_POPUP | WS_THICKFRAME | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX );
+        SetWindowPos( frame, 0, 0, 0, 0, 0, SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE );
+    }
+    else AdjustWindowRectEx( &rc, WS_OVERLAPPEDWINDOW, FALSE, WS_EX_APPWINDOW );
     if (rc.top < 0) OffsetRect( &rc, 0, -rc.top );   /* the title bar on the screen */
     if (rc.left < 0) OffsetRect( &rc, -rc.left, 0 );
     if (icon)
@@ -1946,7 +1981,7 @@
     }
 }
 
