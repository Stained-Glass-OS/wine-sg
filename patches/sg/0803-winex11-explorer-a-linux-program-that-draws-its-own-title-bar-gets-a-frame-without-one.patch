 #define SG_POPUP_RESTORE_TIMER 0xC1A0  /* a passing shell surface went: the Linux window back? (0702) */
+#define SG_XWIN_READ_TIMER 0xC1A1      /* the Linux windows' list just asked for: read it */
 #define SG_AUTOHIDE_TICK   150
 #define SG_AUTOHIDE_DELAY  600
 
@@ -1623,6 +1624,32 @@
 {
     struct taskbar_button *win;
 
+    /* a frame for a program that draws its own title bar and edges (SG
+     * Office, Firefox): no title bar or border of ours, the program's window
+     * fills it; it is sizable (WS_THICKFRAME) only so it maximizes to the
+     * work area and the program's edges size it (sg_embed.c) */
+    if (GetPropW( hwnd, L"SgOwnFrame" ))
+    {
+        if (msg == WM_NCCALCSIZE) return 0;
+        if (msg == WM_NCPAINT) return 0;
+        if (msg == WM_NCACTIVATE) return TRUE;
+        if (msg == WM_GETMINMAXINFO)
+        {
+            /* maximized: the work area exactly (no border of ours to hide off it) */
+            MINMAXINFO *mmi = (MINMAXINFO *)lp;
+            MONITORINFO mi = { sizeof(mi) };
+            DefWindowProcW( hwnd, msg, wp, lp );
+            if (GetMonitorInfoW( MonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST ), &mi ))
+            {
+                mmi->ptMaxPosition.x = mi.rcWork.left - mi.rcMonitor.left;
+                mmi->ptMaxPosition.y = mi.rcWork.top - mi.rcMonitor.top;
+                mmi->ptMaxSize.x = mi.rcWork.right - mi.rcWork.left;
+                mmi->ptMaxSize.y = mi.rcWork.bottom - mi.rcWork.top;
+            }
+            return 0;
+        }
+    }
+
     /* a Linux window in this one: closing asks the program; it hid or
      * destroyed its window */
     if ((win = find_taskbar_button( hwnd )) && win->embedded)
@@ -1847,9 +1874,17 @@
     if (!(g = (ULONGLONG)sg_embed_call( frame, SG_EMBED_QUERY, xid ))) { DestroyWindow( frame ); return NULL; }
     rc.left = (short)(g & 0xffff);
     rc.top = (short)((g >> 16) & 0xffff);
-    rc.right = rc.left + (int)((g >> 32) & 0xffff);
-    rc.bottom = rc.top + (int)((g >> 48) & 0xffff);
-    AdjustWindowRectEx( &rc, WS_OVERLAPPEDWINDOW, FALSE, WS_EX_APPWINDOW );
+    rc.right = rc.left + (int)((g >> 32) & 0x7fff);
+    rc.bottom = rc.top + (int)((g >> 48) & 0x7fff);
