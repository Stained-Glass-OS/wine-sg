From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, explorer: a Linux program that draws its own title bar gets a frame without one

SG Office (Qt, frameless) and Firefox (its tabs in the title bar) draw
their own title bars and ask a window manager for no decorations
(_MOTIF_WM_HINTS); in their Wine frame (0762) they had a second title bar
above their own (David 2026-10-02: "SG Office has 2 title bars"). Such a
window's frame has no title bar or border (explorer: WS_POPUP |
WS_THICKFRAME, no non-client area, maximized to the work area), and
dragging the program's own title bar or edges -- _NET_WM_MOVERESIZE, as
Qt's startSystemMove and GTK ask a window manager -- moves or sizes the
frame (winex11's state thread hears it; the frame's thread starts Wine's
own move or size). And a new Linux window is framed soon after the list
naming it is asked for: the taskbar reads the compositor's list 250 ms
after asking, not a tick later, and the compositor (sg-compositor sg27)
holds the window back until then, so it is never seen with the
compositor's title bar first (David: the terminal "starts with one window
decorator, then changes a bit later to look like the others"). Test:
test/ownframe-gate.sh (mutants SG_MUTANT_EMBED_TWO_TITLEBARS,
SG_MUTANT_EMBED_NO_MOVERESIZE, SG_MUTANT_XWIN_LIST_LATE).
---
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -88,6 +88,15 @@
     return atom;
 }
 
+/* a move or size the program asked for (_NET_WM_MOVERESIZE's direction + 1),
+ * from the state thread to the frame's */
+static Atom moveresize_atom( Display *display )
+{
+    static Atom atom;
+    if (!atom) atom = XInternAtom( display, "_SG_EMBED_MOVERESIZE", False );
+    return atom;
+}
+
 static Atom maximized_atom( Display *display )
 {
     static Atom atom;
@@ -191,6 +200,32 @@
     return parent == root;
 }
 
+/* A program that draws its own title bar and frame asks a window manager
+ * for none (_MOTIF_WM_HINTS, decorations 0: SG Office, Firefox with its tabs
+ * in the title bar). Its frame then has no title bar of its own -- it had
+ * two (David 2026-10-02: "SG Office has 2 title bars") -- and the program
+ * moves and sizes it with _NET_WM_MOVERESIZE (the state thread). */
+static BOOL draws_own_frame( Display *display, Window child )
+{
+    Atom type;
+    int format;
+    unsigned long count, remaining;
+    unsigned long *hints = NULL;
+    BOOL ret = FALSE;
+
+#ifdef SG_MUTANT_EMBED_TWO_TITLEBARS
+    return FALSE;
+#endif
+    X11DRV_expect_error( display, ignore_error, NULL );
+    if (!XGetWindowProperty( display, child, x11drv_atom(_MOTIF_WM_HINTS), 0, 5, False, AnyPropertyType,
+                             &type, &format, &count, &remaining, (unsigned char **)&hints ) &&
+        hints && format == 32 && count >= 3)
+        ret = (hints[0] & (1 << 1)) && !(hints[2] & 0xffffffff);   /* MWM_HINTS_DECORATIONS, none */
+    if (hints) XFree( hints );
+    X11DRV_check_error();
+    return ret;
+}
+
 /***********************************************************************
  *      sg_embed_query
  *
@@ -212,7 +247,9 @@
     if (X11DRV_check_error() || !ok) return 0;
     TRACE( "%p: %lx at %d,%d %dx%d\n", hwnd, child, x, y, attr.width, attr.height );
     return (LRESULT)((ULONGLONG)(USHORT)x | (ULONGLONG)(USHORT)y << 16 |
-                     (ULONGLONG)(USHORT)attr.width << 32 | (ULONGLONG)(USHORT)attr.height << 48);
+                     (ULONGLONG)(USHORT)min( attr.width, 0x7fff ) << 32 |
+                     (ULONGLONG)(USHORT)min( attr.height, 0x7fff ) << 48 |
+                     (ULONGLONG)(draws_own_frame( display, child ) ? 1 : 0) << 63);
 }
 
 static void grab_shell_keys( Display *display, Window frame )
@@ -256,6 +293,7 @@
     Atom max_v = XInternAtom( d, "_NET_WM_STATE_MAXIMIZED_VERT", False );
     Atom max_h = XInternAtom( d, "_NET_WM_STATE_MAXIMIZED_HORZ", False );
     Atom ours_fs = fullscreen_atom( d ), ours_max = maximized_atom( d );
+    Atom net_moveresize = XInternAtom( d, "_NET_WM_MOVERESIZE", False ), ours_moveresize = moveresize_atom( d );
     XEvent ev;
 
     XSelectInput( d, root, SubstructureNotifyMask );
@@ -267,6 +305,22 @@
         long on, now;
 
         XNextEvent( d, &ev );
+#ifndef SG_MUTANT_EMBED_NO_MOVERESIZE
+        if (ev.type == ClientMessage && ev.xclient.message_type == net_moveresize && ev.xclient.format == 32 &&
+            ev.xclient.data.l[2] >= 0 && ev.xclient.data.l[2] <= 8)
+        {
+            /* the program's own title bar or edge dragged (its frame has
+             * none): the frame moves or sizes, as Wine's own drag does */
+            if (!XQueryTree( d, ev.xclient.window, &r, &parent, &children, &n )) continue;
+            if (children) XFree( children );
+            if (parent == root) continue;
+            on = ev.xclient.data.l[2] + 1;
+            XChangeProperty( d, ev.xclient.window, ours_moveresize, XA_CARDINAL, 32, PropModeReplace,
+                             (unsigned char *)&on, 1 );
+            XFlush( d );
+            continue;
+        }
+#endif
         if (ev.type != ClientMessage || ev.xclient.message_type != wm_state || ev.xclient.format != 32) continue;
         a1 = ev.xclient.data.l[1];
         a2 = ev.xclient.data.l[2];
@@ -843,6 +897,19 @@
 #endif
         else if (event->xproperty.atom == maximized_atom( display ))
             NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_MAXIMIZE, 0, 0 );
+        else if (event->xproperty.atom == moveresize_atom( display ) && event->xproperty.state == PropertyNewValue)
+        {
+            /* _NET_WM_MOVERESIZE's directions: top-left, top, top-right,
+             * right, bottom-right, bottom, bottom-left, left, move */
+            static const WPARAM size_edge[8] = { WMSZ_TOPLEFT, WMSZ_TOP, WMSZ_TOPRIGHT, WMSZ_RIGHT,
+                                                 WMSZ_BOTTOMRIGHT, WMSZ_BOTTOM, WMSZ_BOTTOMLEFT, WMSZ_LEFT };
+            long dir = get_cardinal( display, event->xany.window, moveresize_atom( display ) ) - 1;
+            X11DRV_expect_error( display, ignore_error, NULL );
+            XDeleteProperty( display, event->xany.window, moveresize_atom( display ) );
+            X11DRV_check_error();
+            if (dir == 8) NtUserPostMessage( hwnd, WM_SYSCOMMAND, SC_MOVE | HTCAPTION, 0 );
+            else if (dir >= 0 && dir < 8) NtUserPostMessage( hwnd, WM_SYSCOMMAND, SC_SIZE | size_edge[dir], 0 );
+        }
         break;
     case UnmapNotify:
         if (event->xunmap.window == event->xunmap.event) NtUserPostMessage( hwnd, WM_SG_EMBED_SHOWN, 0, 0 );
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -273,6 +273,7 @@
 #define SG_SYNC_TIMER      0xC10F   /* a window was shown, hidden, renamed or brought forward */
