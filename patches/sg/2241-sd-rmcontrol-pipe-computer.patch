From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase, kernel32, advapi32: IsValidRelativeSecurityDescriptor, SD RMControl, GetNamedPipeClientComputerName

IsValidRelativeSecurityDescriptor, GetSecurityDescriptorRMControl and
SetSecurityDescriptorRMControl were stubs in kernelbase and not exported by
advapi32 at all; GetNamedPipeClientComputerNameA/W were not exported by
kernel32. The first checks a self-relative descriptor's header, that every
SID and ACL it names lies inside its length and is valid, and the parts the
caller requires; the RM control pair keeps the resource manager's byte in the
descriptor (SE_RM_CONTROL_VALID); the pipe call names this computer for the
connected end of a pipe.

---
--- a/dlls/advapi32/advapi32.spec
+++ b/dlls/advapi32/advapi32.spec
@@ -355,7 +355,7 @@
 @ stdcall -import GetSecurityDescriptorGroup(ptr ptr ptr)
 @ stdcall -import GetSecurityDescriptorLength(ptr)
 @ stdcall -import GetSecurityDescriptorOwner(ptr ptr ptr)
-# @ stub GetSecurityDescriptorRMControl
+@ stdcall -import GetSecurityDescriptorRMControl(ptr ptr)
 @ stdcall -import GetSecurityDescriptorSacl (ptr ptr ptr ptr)
 @ stdcall GetSecurityInfo (long long long ptr ptr ptr ptr ptr)
 @ stdcall GetSecurityInfoExA (long long long str str ptr ptr ptr ptr)
@@ -417,7 +417,7 @@
 @ stdcall -import IsTokenRestricted(long)
 # @ stub IsTokenUntrusted
 @ stdcall -import IsValidAcl(ptr)
-# @ stub IsValidRelativeSecurityDescriptor
+@ stdcall -import IsValidRelativeSecurityDescriptor(ptr long long)
 @ stdcall -import IsValidSecurityDescriptor(ptr)
 @ stdcall -import IsValidSid(ptr)
 @ stdcall -import IsWellKnownSid(ptr long)
@@ -755,7 +755,7 @@
 @ stdcall -import SetSecurityDescriptorDacl(ptr long ptr long)
 @ stdcall -import SetSecurityDescriptorGroup (ptr ptr long)
 @ stdcall -import SetSecurityDescriptorOwner (ptr ptr long)
-# @ stub SetSecurityDescriptorRMControl
+@ stdcall -import SetSecurityDescriptorRMControl(ptr ptr)
 @ stdcall -import SetSecurityDescriptorSacl(ptr long ptr long)
 @ stdcall SetSecurityInfo (long long long ptr ptr ptr ptr)
 # @ stub SetSecurityInfoExA
--- a/dlls/kernel32/kernel32.spec
+++ b/dlls/kernel32/kernel32.spec
@@ -744,8 +744,8 @@
 @ stdcall -import GetNLSVersion(long long ptr)
 @ stdcall -import GetNLSVersionEx(long wstr ptr)
 # @ stub GetNamedPipeAttribute
-# @ stub GetNamedPipeClientComputerNameA
-# @ stub GetNamedPipeClientComputerNameW
+@ stdcall GetNamedPipeClientComputerNameA(long ptr long)
+@ stdcall GetNamedPipeClientComputerNameW(long ptr long)
 @ stdcall GetNamedPipeClientProcessId(long ptr)
 @ stdcall GetNamedPipeClientSessionId(long ptr)
 @ stdcall GetNamedPipeHandleStateA(long ptr ptr ptr ptr ptr long)
--- a/dlls/kernel32/sync.c
+++ b/dlls/kernel32/sync.c
@@ -525,6 +525,59 @@ BOOL WINAPI GetNamedPipeClientProcessId( HANDLE pipe, ULONG *id )
                                           sizeof("ClientProcessId"), id, sizeof(*id) ));
 }
 
+/***********************************************************************
+ *           GetNamedPipeClientComputerNameW  (KERNEL32.@)
+ *
+ * The computer a pipe's client runs on. Every client here is on this
+ * machine, whose name that is; the handle must still be the connected end
+ * of a pipe, which asking for the client's process tells.
+ */
+BOOL WINAPI GetNamedPipeClientComputerNameW( HANDLE pipe, WCHAR *name, ULONG len )
+{
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD size = ARRAY_SIZE(computer);
+    ULONG pid;
+
+    if (!GetNamedPipeClientProcessId( pipe, &pid )) return FALSE;
+    if (!GetComputerNameW( computer, &size )) return FALSE;
+    if (len < size + 1)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    if (!name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    memcpy( name, computer, (size + 1) * sizeof(WCHAR) );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           GetNamedPipeClientComputerNameA  (KERNEL32.@)
+ */
+BOOL WINAPI GetNamedPipeClientComputerNameA( HANDLE pipe, char *name, ULONG len )
+{
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD size;
+
+    if (!GetNamedPipeClientComputerNameW( pipe, computer, ARRAY_SIZE(computer) )) return FALSE;
+    size = WideCharToMultiByte( CP_ACP, 0, computer, -1, NULL, 0, NULL, NULL );
+    if (len < size)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    if (!name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    WideCharToMultiByte( CP_ACP, 0, computer, -1, name, len, NULL, NULL );
+    return TRUE;
+}
+
