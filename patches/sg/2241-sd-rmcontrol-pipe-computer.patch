+/******************************************************************************
+ * IsValidRelativeSecurityDescriptor    (kernelbase.@)
+ *
+ * Whether SD, LEN bytes long, is a well formed self-relative security
+ * descriptor that holds every part REQUIRED asks for.
+ */
+BOOL WINAPI IsValidRelativeSecurityDescriptor( PSECURITY_DESCRIPTOR sd, ULONG len, SECURITY_INFORMATION required )
+{
+    const SECURITY_DESCRIPTOR_RELATIVE *rel = sd;
+    const BYTE *base = sd;
+
+    TRACE( "%p %lu %#lx\n", sd, len, required );
+
+    if (!sd || len < sizeof(*rel) || rel->Revision != SECURITY_DESCRIPTOR_REVISION ||
+        !(rel->Control & SE_SELF_RELATIVE))
+        return FALSE;
+
+    if ((required & OWNER_SECURITY_INFORMATION) && !rel->Owner) return FALSE;
+    if ((required & GROUP_SECURITY_INFORMATION) && !rel->Group) return FALSE;
+    if ((required & DACL_SECURITY_INFORMATION) && !(rel->Control & SE_DACL_PRESENT)) return FALSE;
+    if ((required & SACL_SECURITY_INFORMATION) && !(rel->Control & SE_SACL_PRESENT)) return FALSE;
+
+    /* the owner and the group: a valid SID wholly inside the descriptor */
+    if (rel->Owner || rel->Group)
+    {
+        ULONG offsets[2] = { rel->Owner, rel->Group }, i;
+
+        for (i = 0; i < 2; i++)
+        {
+            if (!offsets[i]) continue;
+            if ((offsets[i] & 3) || offsets[i] < sizeof(*rel) || len < offsets[i] ||
+                len - offsets[i] < 8 || !RtlValidSid( (PSID)(base + offsets[i]) ) ||
+                RtlLengthSid( (PSID)(base + offsets[i]) ) > len - offsets[i])
+                return FALSE;
+        }
+    }
+
+    /* the ACLs, when the descriptor says they are there (an offset of zero is a NULL ACL) */
+    {
+        struct { ULONG offset; BOOL present; } acls[2] =
+        {
+            { rel->Dacl, (rel->Control & SE_DACL_PRESENT) != 0 },
+            { rel->Sacl, (rel->Control & SE_SACL_PRESENT) != 0 },
+        };
+        ULONG i;
+
+        for (i = 0; i < 2; i++)
+        {
+            const ACL *acl;
+
+            if (!acls[i].present || !acls[i].offset) continue;
+            if ((acls[i].offset & 3) || acls[i].offset < sizeof(*rel) || len < acls[i].offset ||
+                len - acls[i].offset < sizeof(ACL))
+                return FALSE;
+            acl = (const ACL *)(base + acls[i].offset);
+#ifdef SG_MUTANT_RELSD_NO_BOUNDS
+            if (!RtlValidAcl( (PACL)acl )) return FALSE;
+#else
+            if (acl->AclSize > len - acls[i].offset || !RtlValidAcl( (PACL)acl )) return FALSE;
+#endif
+        }
+    }
+    return TRUE;
+}
+
+/******************************************************************************
+ * GetSecurityDescriptorRMControl    (kernelbase.@)
+ */
+DWORD WINAPI GetSecurityDescriptorRMControl( PSECURITY_DESCRIPTOR sd, PUCHAR rmcontrol )
+{
+    SECURITY_DESCRIPTOR *descr = sd;
+
+    TRACE( "%p %p\n", sd, rmcontrol );
+
+    if (!(descr->Control & SE_RM_CONTROL_VALID)) return ERROR_INVALID_DATA;
+    *rmcontrol = descr->Sbz1;
+    return ERROR_SUCCESS;
+}
+
+/******************************************************************************
+ * SetSecurityDescriptorRMControl    (kernelbase.@)
+ *
+ * Stores the resource manager's control byte in the descriptor, or clears it
+ * (RMCONTROL NULL).
+ */
+DWORD WINAPI SetSecurityDescriptorRMControl( PSECURITY_DESCRIPTOR sd, PUCHAR rmcontrol )
+{
+    SECURITY_DESCRIPTOR *descr = sd;
+
+    TRACE( "%p %p\n", sd, rmcontrol );
+
+    if (rmcontrol)
+    {
+#ifndef SG_MUTANT_RMCONTROL_NO_FLAG
+        descr->Control |= SE_RM_CONTROL_VALID;
+#endif
+        descr->Sbz1 = *rmcontrol;
+    }
+    else
+    {
+        descr->Control &= ~SE_RM_CONTROL_VALID;
+        descr->Sbz1 = 0;
+    }
+    return ERROR_SUCCESS;
+}
+
