From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:01:44 -0700
Subject: [PATCH] riched20: selection flags, font style handle, client site
 notifications (3255)

- ITextSelection::SetFlags keeps the flags and GetFlags returns them
  (E_INVALIDARG for NULL), instead of E_NOTIMPL.
- ITextFont::SetStyle keeps the style handle, which TOM leaves to the
  implementation, GetStyle returns it, and a duplicate of the font has it.
- IOleClientSite::ShowObject and OnShowWindow succeed.

diff --git a/dlls/riched20/editstr.h b/dlls/riched20/editstr.h
index e81a7fb..6418113 100644
--- a/dlls/riched20/editstr.h
+++ b/dlls/riched20/editstr.h
@@ -474,6 +474,7 @@ struct text_selection
     LONG ref;
 
     struct text_services *services;
+    LONG flags;                 /* ITextSelection::SetFlags: tomSelStartActive, tomSelAtEOL, ... */
 };
 
 struct text_services
diff --git a/dlls/riched20/richole.c b/dlls/riched20/richole.c
index ddce98e..9236a39 100644
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -226,6 +226,7 @@ typedef struct ITextFontImpl {
     textfont_prop_val props[FONT_PROPID_LAST];
     BOOL get_cache_enabled;
     BOOL set_cache_enabled;
+    LONG style;               /* ITextFont::SetStyle: a handle whose meaning is left to the implementation */
 } ITextFontImpl;
 
 typedef struct ITextParaImpl {
@@ -1059,8 +1060,9 @@ static HRESULT WINAPI IOleClientSite_fnShowObject(IOleClientSite *iface)
     if (!This->child.reole)
         return CO_E_RELEASED;
 
-    FIXME("stub %p\n", iface);
-    return E_NOTIMPL;
+    TRACE("%p\n", iface);
+    /* the container has nothing to bring into view: the object is in the editor's window */
+    return S_OK;
 }
 
 static HRESULT WINAPI IOleClientSite_fnOnShowWindow(IOleClientSite *iface, BOOL fShow)
@@ -1069,8 +1071,9 @@ static HRESULT WINAPI IOleClientSite_fnOnShowWindow(IOleClientSite *iface, BOOL
     if (!This->child.reole)
         return CO_E_RELEASED;
 
-    FIXME("stub %p\n", iface);
-    return E_NOTIMPL;
+    TRACE("%p %d\n", iface, fShow);
+    /* the notification asks the container to shade the object while it is open in its own window: nothing is drawn shaded */
+    return S_OK;
 }
 
 static HRESULT WINAPI IOleClientSite_fnRequestNewObjectLayout(IOleClientSite *iface)
@@ -3620,15 +3623,30 @@ static HRESULT WINAPI TextFont_Reset(ITextFont *iface, LONG value)
 static HRESULT WINAPI TextFont_GetStyle(ITextFont *iface, LONG *value)
 {
     ITextFontImpl *This = impl_from_ITextFont(iface);
-    FIXME("(%p)->(%p): stub\n", This, value);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, value);
+
+    if (!value)
+        return E_INVALIDARG;
+    if (This->range && !get_range_reole(This->range))
+        return CO_E_RELEASED;
+    *value = This->style;
+    return S_OK;
 }
 
 static HRESULT WINAPI TextFont_SetStyle(ITextFont *iface, LONG value)
 {
     ITextFontImpl *This = impl_from_ITextFont(iface);
-    FIXME("(%p)->(%ld): stub\n", This, value);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%ld)\n", This, value);
+
+    if (This->range && !get_range_reole(This->range))
+        return CO_E_RELEASED;
+    /* the handle names a character style whose meaning TOM leaves to the implementation: it is kept */
+#ifndef SG_MUTANT_RICHED_STYLE
+    This->style = value;
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI TextFont_GetAllCaps(ITextFont *iface, LONG *value)
@@ -4067,6 +4085,11 @@ static HRESULT create_textfont(ITextRange *range, const ITextFontImpl *src, ITex
 
     font->ITextFont_iface.lpVtbl = &textfontvtbl;
     font->ref = 1;
+#ifdef SG_MUTANT_RICHED_STYLEDUP
+    font->style = 0;
+#else
+    font->style = src ? src->style : 0;
+#endif
 
     if (src) {
         font->range = NULL;
@@ -7417,24 +7440,32 @@ static HRESULT WINAPI ITextSelection_fnGetFlags(ITextSelection *me, LONG *flags)
 {
     struct text_selection *This = impl_from_ITextSelection(me);
 
-    FIXME("(%p)->(%p): stub\n", This, flags);
+    TRACE("(%p)->(%p)\n", This, flags);
 
     if (!This->services)
         return CO_E_RELEASED;
+    if (!flags)
+        return E_INVALIDARG;
 
-    return E_NOTIMPL;
+#ifdef SG_MUTANT_RICHED_SELFLAGS
+    *flags = 0;
+    return S_OK;
+#endif
+    *flags = This->flags;
+    return S_OK;
 }
 
 static HRESULT WINAPI ITextSelection_fnSetFlags(ITextSelection *me, LONG flags)
 {
     struct text_selection *This = impl_from_ITextSelection(me);
 
-    FIXME("(%p)->(%lx): stub\n", This, flags);
+    TRACE("(%p)->(%lx)\n", This, flags);
 
     if (!This->services)
         return CO_E_RELEASED;
 
-    return E_NOTIMPL;
+    This->flags = flags;
+    return S_OK;
 }
 
 static HRESULT WINAPI ITextSelection_fnGetType(ITextSelection *me, LONG *type)
@@ -7661,6 +7692,7 @@ static struct text_selection *text_selection_create(struct text_services *servic
     txtSel->ITextSelection_iface.lpVtbl = &tsvt;
     txtSel->ref = 1;
     txtSel->services = services;
+    txtSel->flags = 0;
     return txtSel;
 }
 
