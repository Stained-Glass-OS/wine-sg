+    struct brush *impl = effect_brush_impl( iface );
+    ICompositionBrush *old;
+    int index;
+
+    TRACE( "iface %p, name %s, source %p.\n", iface, debugstr_hstring( name ), source );
+    if ((index = effect_graph_param_index( impl->graph, WindowsGetStringRawBuffer( name, NULL ) )) < 0)
+        return E_INVALIDARG;
+    if (source) ICompositionBrush_AddRef( source );
+    compositor_lock( impl->compositor );
+    old = impl->effect_sources[index];
+    impl->effect_sources[index] = source;
+    compositor_unlock( impl->compositor );
+    if (old) ICompositionBrush_Release( old );
+    compositor_changed( impl->compositor );
