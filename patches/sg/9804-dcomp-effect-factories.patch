+/* Stained Glass OS (wine-sg 9804). ICompositor::CreateEffectFactory takes a description of an effect graph:
+ * Windows.Graphics.Effects.IGraphicsEffect objects (Win2D's effects, or a program's own) whose
+ * IGraphicsEffectD2D1Interop names the Direct2D effect (its CLSID), gives its properties in Direct2D's
+ * order and its sources -- other effects, or CompositionEffectSourceParameters a brush binds by name.
+ * The factory reads the description once, as Windows does (later changes to the description objects do not
+ * reach brushes made from it); CreateEffectFactoryWithProperties names the properties ("Effect.Property")
+ * a brush may change or animate afterwards, through its StartAnimation or its Properties. A brush draws
+ * as its graph of Direct2D effects over what its source brushes draw.
+ *
+ * IGraphicsEffectD2D1Interop's IID and method order, and GRAPHICS_EFFECT_PROPERTY_MAPPING, are the Windows
+ * metadata's (windows.graphics.effects.interop.h), as windows-rs 0.58 (MIT/Apache-2.0, generated from
+ * Microsoft's open win32metadata) publishes them. */
+
+#include <math.h>
+#include "composition_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(composition);
+
+static const GUID IID_IGraphicsEffectD2D1Interop_x = { 0x2fc57384, 0xa068, 0x44d7, { 0xa3, 0x31, 0x30, 0x98, 0x2f, 0xcf, 0x71, 0x77 } };
+static const GUID IID_ICompositionEffectSourceParameter_e = { 0x858ab13a, 0x3292, 0x4e4e, { 0xb3, 0xbb, 0x2b, 0x6c, 0x65, 0x44, 0xa6, 0xee } };
+static const WCHAR class_effect_factory[] = L"Windows.UI.Composition.CompositionEffectFactory";
+
+typedef enum
+{
+    MAPPING_UNKNOWN = 0,
+    MAPPING_DIRECT = 1,
+    MAPPING_VECTORX = 2,
+    MAPPING_VECTORY = 3,
+    MAPPING_VECTORZ = 4,
+    MAPPING_VECTORW = 5,
+    MAPPING_RECT_TO_VECTOR4 = 6,
+    MAPPING_RADIANS_TO_DEGREES = 7,
+    MAPPING_COLORMATRIX_ALPHA_MODE = 8,
+    MAPPING_COLOR_TO_VECTOR3 = 9,
+    MAPPING_COLOR_TO_VECTOR4 = 10,
+} GRAPHICS_EFFECT_PROPERTY_MAPPING;
+
+typedef struct graphics_effect_interop graphics_effect_interop;
+struct graphics_effect_interop_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( graphics_effect_interop *, REFIID, void ** );
+    ULONG (WINAPI *AddRef)( graphics_effect_interop * );
+    ULONG (WINAPI *Release)( graphics_effect_interop * );
+    HRESULT (WINAPI *GetEffectId)( graphics_effect_interop *, GUID * );
+    HRESULT (WINAPI *GetNamedPropertyMapping)( graphics_effect_interop *, const WCHAR *, UINT *,
+                                              GRAPHICS_EFFECT_PROPERTY_MAPPING * );
+    HRESULT (WINAPI *GetPropertyCount)( graphics_effect_interop *, UINT * );
+    HRESULT (WINAPI *GetProperty)( graphics_effect_interop *, UINT, IPropertyValue ** );
+    HRESULT (WINAPI *GetSource)( graphics_effect_interop *, UINT, IGraphicsEffectSource ** );
+    HRESULT (WINAPI *GetSourceCount)( graphics_effect_interop *, UINT * );
+};
+struct graphics_effect_interop { const struct graphics_effect_interop_vtbl *lpVtbl; };
+
+#define MAX_EFFECT_NODES   64
+#define MAX_EFFECT_SOURCES 16
+#define MAX_EFFECT_PROPS   64
+#define MAX_PROP_SIZE      (16 * sizeof(float))
+
+struct effect_prop
+{
+    UINT size;                 /* 0: not given, the effect's default stays */
+    BYTE data[MAX_PROP_SIZE];
+};
+
+struct effect_node
+{
+    GUID clsid;
+    WCHAR *name;
+    UINT prop_count;
+    struct effect_prop *props;
+    UINT source_count;
+    int sources[MAX_EFFECT_SOURCES];   /* >= 0: a node; < 0: -1 - the index of a source parameter */
+};
+
+/* a property a brush may change: "Effect.Property", where it goes in Direct2D's terms */
+struct effect_anim
+{
+    WCHAR *name;
+    UINT node, index;
+    GRAPHICS_EFFECT_PROPERTY_MAPPING mapping;
+    enum anim_kind kind;
+    BYTE initial[MAX_PROP_SIZE];      /* in the animated value's terms */
+};
+
+struct effect_graph
+{
+    LONG ref;
+    UINT node_count, root;
+    struct effect_node nodes[MAX_EFFECT_NODES];
+    UINT param_count;
+    WCHAR *params[MAX_EFFECT_SOURCES];
+    UINT anim_count;
+    struct effect_anim *anims;
+    IGraphicsEffect *objects[MAX_EFFECT_NODES];   /* the description's, while it is read */
+};
+
+static WCHAR *hstring_copy( HSTRING str )
+{
+    UINT32 len;
+    const WCHAR *buf = WindowsGetStringRawBuffer( str, &len );
+    WCHAR *ret = malloc( (len + 1) * sizeof(WCHAR) );
+    if (!ret) return NULL;
+    memcpy( ret, buf, len * sizeof(WCHAR) );
+    ret[len] = 0;
+    return ret;
+}
+
+void effect_graph_release( struct effect_graph *graph )
+{
+    UINT i;
+
+    if (!graph || InterlockedDecrement( &graph->ref )) return;
+    for (i = 0; i < graph->node_count; i++)
+    {
+        free( graph->nodes[i].name );
+        free( graph->nodes[i].props );
+    }
+    for (i = 0; i < graph->param_count; i++) free( graph->params[i] );
+    for (i = 0; i < graph->anim_count; i++) free( graph->anims[i].name );
+    free( graph->anims );
+    free( graph );
+}
+
+struct effect_graph *effect_graph_addref( struct effect_graph *graph )
+{
+    InterlockedIncrement( &graph->ref );
+    return graph;
+}
+
+/* a property's value as Direct2D takes it (FLOAT, UINT32/enum, BOOL, vectors and matrices as floats) */
+static HRESULT read_property( IPropertyValue *value, struct effect_prop *prop )
+{
+    PropertyType type;
+    HRESULT hr;
+
+    prop->size = 0;
+    if (!value) return S_OK;
+    if (FAILED(hr = IPropertyValue_get_Type( value, &type ))) return hr;
+    switch (type)
+    {
+    case PropertyType_Single:
+        prop->size = sizeof(FLOAT);
+        return IPropertyValue_GetSingle( value, (FLOAT *)prop->data );
+    case PropertyType_Double:
+    {
+        DOUBLE d;
+        if (FAILED(hr = IPropertyValue_GetDouble( value, &d ))) return hr;
+        *(FLOAT *)prop->data = d;
+        prop->size = sizeof(FLOAT);
+        return S_OK;
+    }
+    case PropertyType_UInt32:
+        prop->size = sizeof(UINT32);
+        return IPropertyValue_GetUInt32( value, (UINT32 *)prop->data );
+    case PropertyType_Int32:
+        prop->size = sizeof(INT32);
+        return IPropertyValue_GetInt32( value, (INT32 *)prop->data );
+    case PropertyType_Boolean:
+    {
+        boolean b;
+        if (FAILED(hr = IPropertyValue_GetBoolean( value, &b ))) return hr;
+        *(BOOL *)prop->data = !!b;
+        prop->size = sizeof(BOOL);
+        return S_OK;
+    }
+    case PropertyType_SingleArray:
+    {
+        UINT32 count;
+        FLOAT *array;
+        if (FAILED(hr = IPropertyValue_GetSingleArray( value, &count, &array ))) return hr;
+        if (count * sizeof(FLOAT) <= MAX_PROP_SIZE)
+        {
+            memcpy( prop->data, array, count * sizeof(FLOAT) );
+            prop->size = count * sizeof(FLOAT);
+        }
+        else FIXME( "an array of %u floats is not kept\n", count );
+        CoTaskMemFree( array );
+        return S_OK;
+    }
+    default:
+        FIXME( "property type %u is not supported\n", type );
+        return S_OK;
+    }
+}
+
+/* the name of a CompositionEffectSourceParameter (ours or a program's), or NULL */
+static WCHAR *source_parameter_name( IGraphicsEffectSource *source )
+{
+    IInspectable *param;
+    HSTRING name = NULL;
+    WCHAR *ret = NULL;
+
+    if (FAILED(IGraphicsEffectSource_QueryInterface( source, &IID_ICompositionEffectSourceParameter_e, (void **)&param )))
+        return NULL;
+    /* ICompositionEffectSourceParameter::get_Name, its first method */
+    if (SUCCEEDED(((HRESULT (WINAPI *)( IInspectable *, HSTRING * ))(*(void ***)param)[6])( param, &name )))
+    {
+        ret = hstring_copy( name );
+        WindowsDeleteString( name );
+    }
+    IInspectable_Release( param );
+    return ret;
+}
+
+static HRESULT read_effect( struct effect_graph *graph, IGraphicsEffect *effect, UINT depth, UINT *index );
+
+static HRESULT read_source( struct effect_graph *graph, IGraphicsEffectSource *source, UINT depth, int *out )
+{
+    IGraphicsEffect *effect;
+    WCHAR *name;
+    UINT i, node;
+    HRESULT hr;
+
+    if (!source) return E_INVALIDARG;
+    if ((name = source_parameter_name( source )))
+    {
+        for (i = 0; i < graph->param_count; i++)
+            if (!wcscmp( graph->params[i], name )) break;
+        if (i == graph->param_count)
+        {
+            if (graph->param_count == MAX_EFFECT_SOURCES)
+            {
+                free( name );
+                return E_INVALIDARG;
+            }
+            graph->params[graph->param_count++] = name;
+        }
+        else free( name );
+        *out = -1 - (int)i;
+        return S_OK;
+    }
+    if (SUCCEEDED(IGraphicsEffectSource_QueryInterface( source, &IID_IGraphicsEffect, (void **)&effect )))
+    {
+        hr = read_effect( graph, effect, depth + 1, &node );
+        IGraphicsEffect_Release( effect );
+        if (SUCCEEDED(hr)) *out = node;
+        return hr;
+    }
+    /* a source that is neither (a Win2D bitmap, say): Windows' compositor takes none */
+    WARN( "source %p is neither an effect nor a source parameter\n", source );
+    return E_INVALIDARG;
+}
+
+static HRESULT read_effect( struct effect_graph *graph, IGraphicsEffect *effect, UINT depth, UINT *index )
+{
+    graphics_effect_interop *interop;
+    struct effect_node *node;
+    IGraphicsEffectSource *source;
+    IPropertyValue *value;
+    HSTRING name = NULL;
+    UINT i, count;
+    HRESULT hr;
+
+    if (depth > 16 || graph->node_count == MAX_EFFECT_NODES) return E_INVALIDARG;
+    if (FAILED(hr = IGraphicsEffect_QueryInterface( effect, &IID_IGraphicsEffectD2D1Interop_x, (void **)&interop )))
+    {
+        WARN( "effect %p has no IGraphicsEffectD2D1Interop\n", effect );
+        return E_INVALIDARG;
+    }
+    node = &graph->nodes[*index = graph->node_count++];
+    graph->objects[*index] = effect;
+    IGraphicsEffect_AddRef( effect );
+    if (SUCCEEDED(IGraphicsEffect_get_Name( effect, &name )))
+    {
+        node->name = hstring_copy( name );
+        WindowsDeleteString( name );
+    }
+    if (FAILED(hr = interop->lpVtbl->GetEffectId( interop, &node->clsid ))) goto done;
+    TRACE( "effect %u %s: %s\n", *index, debugstr_w( node->name ), debugstr_guid( &node->clsid ) );
+
+    count = 0;
+    if (FAILED(hr = interop->lpVtbl->GetPropertyCount( interop, &count ))) goto done;
+    if (count > MAX_EFFECT_PROPS) { hr = E_INVALIDARG; goto done; }
+    if (count && !(node->props = calloc( count, sizeof(*node->props) ))) { hr = E_OUTOFMEMORY; goto done; }
+    node->prop_count = count;
+    for (i = 0; i < count; i++)
+    {
+        value = NULL;
+        if (FAILED(hr = interop->lpVtbl->GetProperty( interop, i, &value ))) goto done;
+        hr = read_property( value, &node->props[i] );
+        if (value) IPropertyValue_Release( value );
+        if (FAILED(hr)) goto done;
+    }
+
+    count = 0;
+    if (FAILED(hr = interop->lpVtbl->GetSourceCount( interop, &count ))) goto done;
+    if (count > MAX_EFFECT_SOURCES) { hr = E_INVALIDARG; goto done; }
+    for (i = 0; i < count; i++)
+    {
+        int src;
+        source = NULL;
+        if (FAILED(hr = interop->lpVtbl->GetSource( interop, i, &source ))) goto done;
+        node = &graph->nodes[*index];
+        hr = read_source( graph, source, depth, &src );
+        if (source) IGraphicsEffectSource_Release( source );
+        if (FAILED(hr)) goto done;
+        node = &graph->nodes[*index];
+        node->sources[node->source_count++] = src;
+    }
+done:
+    interop->lpVtbl->Release( interop );
+    return hr;
+}
+
+static UINT kind_bytes( enum anim_kind kind )
+{
+    switch (kind)
+    {
+    case ANIM_SCALAR: return 4;
+    case ANIM_VECTOR2: return 8;
+    case ANIM_VECTOR3: return 12;
+    case ANIM_VECTOR4: return 16;
+    case ANIM_MATRIX3X2: return 24;
+    case ANIM_MATRIX4X4: return 64;
+    default: return 0;
+    }
+}
+
+static enum anim_kind mapping_kind( GRAPHICS_EFFECT_PROPERTY_MAPPING mapping, UINT size )
+{
+    switch (mapping)
+    {
+    case MAPPING_DIRECT:
+        switch (size)
+        {
+        case 4: return ANIM_SCALAR;
+        case 8: return ANIM_VECTOR2;
+        case 12: return ANIM_VECTOR3;
+        case 16: return ANIM_VECTOR4;
+        case 24: return ANIM_MATRIX3X2;
+        case 64: return ANIM_MATRIX4X4;
+        default: return ANIM_NONE;
+        }
+    case MAPPING_VECTORX: case MAPPING_VECTORY: case MAPPING_VECTORZ: case MAPPING_VECTORW:
+    case MAPPING_RADIANS_TO_DEGREES:
+        return ANIM_SCALAR;
+    case MAPPING_RECT_TO_VECTOR4:
+        return ANIM_VECTOR4;
+    case MAPPING_COLOR_TO_VECTOR3: case MAPPING_COLOR_TO_VECTOR4:
+        return ANIM_COLOR;
+    default:
+        return ANIM_NONE;
+    }
+}
+
+static BYTE color_byte( float f )
+{
+    return (BYTE)floorf( max( 0.0f, min( 1.0f, f ) ) * 255.0f + 0.5f );
+}
+
+/* a Direct2D value in the animated value's terms */
+static void d2d_to_anim( const struct effect_anim *anim, const struct effect_prop *prop, BYTE *out )
+{
+    const float *f = (const float *)prop->data;
+    float *o = (float *)out;
+
+    memset( out, 0, MAX_PROP_SIZE );
+    switch (anim->mapping)
+    {
+    case MAPPING_VECTORX: case MAPPING_VECTORY: case MAPPING_VECTORZ: case MAPPING_VECTORW:
+    {
+        UINT c = anim->mapping - MAPPING_VECTORX;
+        if (prop->size > c * sizeof(float)) o[0] = f[c];
+        break;
+    }
+    case MAPPING_RADIANS_TO_DEGREES:
+        if (prop->size >= sizeof(float)) o[0] = f[0] * (float)M_PI / 180.0f;
+        break;
+    case MAPPING_RECT_TO_VECTOR4:
+        if (prop->size >= 4 * sizeof(float))
+        {
+            o[0] = f[0]; o[1] = f[1]; o[2] = f[2] - f[0]; o[3] = f[3] - f[1];
+        }
+        break;
+    case MAPPING_COLOR_TO_VECTOR3: case MAPPING_COLOR_TO_VECTOR4:
+    {
+        Color *color = (Color *)out;
+        color->A = prop->size >= 4 * sizeof(float) ? color_byte( f[3] ) : 255;
+        if (prop->size >= 3 * sizeof(float))
+        {
+            color->R = color_byte( f[0] ); color->G = color_byte( f[1] ); color->B = color_byte( f[2] );
+        }
+        break;
+    }
+    default:
+        memcpy( out, prop->data, min( prop->size, MAX_PROP_SIZE ) );
+        break;
+    }
+}
+
+/* the animated value back in Direct2D's terms, over the property's own value */
+static UINT anim_to_d2d( const struct effect_anim *anim, const struct effect_prop *base, const BYTE *value, BYTE *out )
+{
+    const float *v = (const float *)value;
+    float *o = (float *)out;
+    UINT size = base->size;
+
+    memcpy( out, base->data, MAX_PROP_SIZE );
+    switch (anim->mapping)
+    {
+    case MAPPING_VECTORX: case MAPPING_VECTORY: case MAPPING_VECTORZ: case MAPPING_VECTORW:
+    {
+        UINT c = anim->mapping - MAPPING_VECTORX;
+        o[c] = v[0];
+        size = max( size, (c + 1) * sizeof(float) );
+        break;
+    }
+    case MAPPING_RADIANS_TO_DEGREES:
+        o[0] = v[0] * 180.0f / (float)M_PI;
+        size = sizeof(float);
+        break;
+    case MAPPING_RECT_TO_VECTOR4:
+        o[0] = v[0]; o[1] = v[1]; o[2] = v[0] + v[2]; o[3] = v[1] + v[3];
+        size = 4 * sizeof(float);
+        break;
+    case MAPPING_COLOR_TO_VECTOR3: case MAPPING_COLOR_TO_VECTOR4:
+    {
+        const Color *color = (const Color *)value;
+        o[0] = color->R / 255.0f; o[1] = color->G / 255.0f; o[2] = color->B / 255.0f;
+        o[3] = color->A / 255.0f;
+        size = (anim->mapping == MAPPING_COLOR_TO_VECTOR3 ? 3 : 4) * sizeof(float);
+        break;
+    }
+    default:
+        size = max( size, kind_bytes( anim->kind ) );
+        memcpy( out, value, size );
+        break;
+    }
+    return size;
+}
+
+/* an animatable property's name, "Effect.Property": the node named Effect, and Property through its interop */
+static HRESULT add_animatable( struct effect_graph *graph, HSTRING hname )
+{
+    const WCHAR *full = WindowsGetStringRawBuffer( hname, NULL ), *dot = wcschr( full, '.' );
+    GRAPHICS_EFFECT_PROPERTY_MAPPING mapping = MAPPING_UNKNOWN;
+    graphics_effect_interop *interop = NULL;
+    struct effect_anim *anim, *anims;
+    UINT i, node, index = 0;
+    HRESULT hr;
+
+    if (!dot || dot == full) return E_INVALIDARG;
+    for (node = 0; node < graph->node_count; node++)
+        if (graph->nodes[node].name && wcslen( graph->nodes[node].name ) == dot - full &&
+            !wcsncmp( graph->nodes[node].name, full, dot - full ))
+            break;
+    if (node == graph->node_count)
+    {
+        WARN( "no effect named %s\n", debugstr_wn( full, dot - full ) );
+        return E_INVALIDARG;
+    }
+    /* that effect's description, for the property's mapping */
+    if (FAILED(IGraphicsEffect_QueryInterface( graph->objects[node], &IID_IGraphicsEffectD2D1Interop_x,
+                                               (void **)&interop )))
+        return E_INVALIDARG;
+    hr = interop->lpVtbl->GetNamedPropertyMapping( interop, dot + 1, &index, &mapping );
+    interop->lpVtbl->Release( interop );
+    if (FAILED(hr) || index >= graph->nodes[node].prop_count ||
+        mapping_kind( mapping, graph->nodes[node].props[index].size ) == ANIM_NONE)
+    {
+        WARN( "%s is not an animatable property (%#lx, index %u, mapping %u)\n", debugstr_w( full ), hr, index, mapping );
+        return E_INVALIDARG;
+    }
+    for (i = 0; i < graph->anim_count; i++) if (!wcscmp( graph->anims[i].name, full )) return S_OK;
+    if (!(anims = realloc( graph->anims, (graph->anim_count + 1) * sizeof(*anims) ))) return E_OUTOFMEMORY;
+    graph->anims = anims;
+    anim = &anims[graph->anim_count];
+    memset( anim, 0, sizeof(*anim) );
+    if (!(anim->name = hstring_copy( hname ))) return E_OUTOFMEMORY;
+    anim->node = node;
+    anim->index = index;
+    anim->mapping = mapping;
+    anim->kind = mapping_kind( mapping, graph->nodes[node].props[index].size );
+    d2d_to_anim( anim, &graph->nodes[node].props[index], anim->initial );
+    graph->anim_count++;
+    TRACE( "animatable %s: effect %u property %u, mapping %u\n", debugstr_w( full ), node, index, mapping );
+    return S_OK;
+}
+
+/* the graph keeps no reference to the description: later changes to it reach no brush, as on Windows */
+static void release_objects( struct effect_graph *graph )
+{
+    UINT i;
+    for (i = 0; i < MAX_EFFECT_NODES; i++)
+    {
+        if (graph->objects[i]) IGraphicsEffect_Release( graph->objects[i] );
+        graph->objects[i] = NULL;
+    }
+}
+
+HRESULT effect_graph_create( IGraphicsEffect *effect, IIterable_HSTRING *animatable, struct effect_graph **out )
+{
+    struct effect_graph *graph;
+    IIterator_HSTRING *iter;
+    boolean more = FALSE;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!effect) return E_INVALIDARG;
+    if (!(graph = calloc( 1, sizeof(*graph) ))) return E_OUTOFMEMORY;
+    graph->ref = 1;
+    if (FAILED(hr = read_effect( graph, effect, 0, &graph->root ))) goto fail;
+    if (animatable)
+    {
+        if (FAILED(hr = IIterable_HSTRING_First( animatable, &iter ))) goto fail;
+        hr = IIterator_HSTRING_get_HasCurrent( iter, &more );
+        while (SUCCEEDED(hr) && more)
+        {
+            HSTRING name = NULL;
+            if (FAILED(hr = IIterator_HSTRING_get_Current( iter, &name ))) break;
+            hr = add_animatable( graph, name );
+            WindowsDeleteString( name );
+            if (FAILED(hr)) break;
+            hr = IIterator_HSTRING_MoveNext( iter, &more );
+        }
+        IIterator_HSTRING_Release( iter );
+        if (FAILED(hr)) goto fail;
+    }
+    release_objects( graph );
+    *out = graph;
+    return S_OK;
+fail:
+    release_objects( graph );
+    effect_graph_release( graph );
+    return hr;
+}
+
+UINT effect_graph_param_count( const struct effect_graph *graph )
+{
+    return graph->param_count;
+}
+
+/* the index of a source parameter, or -1 */
+int effect_graph_param_index( const struct effect_graph *graph, const WCHAR *name )
+{
+    UINT i;
+    for (i = 0; i < graph->param_count; i++) if (!wcscmp( graph->params[i], name )) return i;
+    return -1;
+}
+
+/* a brush's own values of the animatable properties, at their described values */
+BYTE *effect_values_create( const struct effect_graph *graph )
+{
+    BYTE *values = calloc( max( graph->anim_count, 1 ), MAX_PROP_SIZE );
+    UINT i;
+
+    if (!values) return NULL;
+    for (i = 0; i < graph->anim_count; i++) memcpy( values + i * MAX_PROP_SIZE, graph->anims[i].initial, MAX_PROP_SIZE );
+    return values;
+}
+
+/* where an animatable property's value is: the brush's Properties when they have it, else the brush's own */
+static void *anim_storage( const struct effect_graph *graph, UINT i, BYTE *values, ICompositionPropertySet *properties )
+{
+    enum anim_kind kind;
+    void *data;
+
+    if (properties && (data = property_set_value( properties, graph->anims[i].name, &kind )) &&
+        kind == graph->anims[i].kind)
+        return data;
+    return values + i * MAX_PROP_SIZE;
+}
+
+/* StartAnimation of an effect brush: "Effect.Property", maybe with components ("Effect.Offset.X") */
+BOOL effect_values_resolve( const struct effect_graph *graph, BYTE *values, ICompositionPropertySet *properties,
+                            const WCHAR *name, struct anim_property *prop )
+{
+    UINT i;
+
+#ifdef SG_MUTANT_EFFECT_NOT_ANIMATABLE
+    return FALSE;
+#endif
+    for (i = 0; i < graph->anim_count; i++)
+    {
+        size_t len = wcslen( graph->anims[i].name );
+        if (wcsnicmp( graph->anims[i].name, name, len ) || (name[len] && name[len] != '.')) continue;
+        prop->base_kind = graph->anims[i].kind;
+        prop->data = anim_storage( graph, i, values, properties );
+        prop->factor = 0;
+        return anim_resolve_components( name[len] ? name + len : NULL, prop );
+    }
+    return FALSE;
+}
+
+/* a stamp of the animatable values a brush draws with: it changes when one does */
+UINT64 effect_values_stamp( const struct effect_graph *graph, BYTE *values, ICompositionPropertySet *properties,
+                            UINT64 h )
+{
+    UINT i, j;
+
+    for (i = 0; i < graph->anim_count; i++)
+    {
+        const BYTE *p = anim_storage( graph, i, values, properties );
+        for (j = 0; j < MAX_PROP_SIZE; j++) h = (h ^ p[j]) * 0x100000001b3ull;
+    }
+    return h;
+}
+
+/* the graph's output for these source images (NULL for a parameter no brush is bound to); the caller holds
+ * the compositor's lock and releases the image */
+ID2D1Image *effect_graph_render( const struct effect_graph *graph, BYTE *values, ICompositionPropertySet *properties,
+                                 ID2D1DeviceContext *ctx, ID2D1Image **param_images )
+{
+    ID2D1Effect *effects[MAX_EFFECT_NODES] = { 0 };
+    ID2D1Image *output = NULL;
+    BYTE data[MAX_PROP_SIZE];
+    UINT i, j, size;
+    HRESULT hr;
+
+    for (i = 0; i < graph->node_count; i++)
+    {
+        const struct effect_node *node = &graph->nodes[i];
+
+        if (FAILED(hr = ID2D1DeviceContext_CreateEffect( ctx, &node->clsid, &effects[i] )))
+        {
+            FIXME( "effect %s %s is not drawn: %#lx\n", debugstr_w( node->name ), debugstr_guid( &node->clsid ), hr );
+            goto done;
+        }
+        for (j = 0; j < node->prop_count; j++)
+        {
+            if (!node->props[j].size) continue;
+            if (FAILED(hr = ID2D1Effect_SetValue( effects[i], j, D2D1_PROPERTY_TYPE_UNKNOWN, node->props[j].data,
+                                                  node->props[j].size )))
+                WARN( "effect %s property %u (%u bytes): %#lx\n", debugstr_w( node->name ), j, node->props[j].size, hr );
+        }
+    }
+    for (i = 0; i < graph->anim_count; i++)
+    {
+        const struct effect_anim *anim = &graph->anims[i];
+        const struct effect_prop *base = &graph->nodes[anim->node].props[anim->index];
+        size = anim_to_d2d( anim, base, anim_storage( graph, i, values, properties ), data );
+        ID2D1Effect_SetValue( effects[anim->node], anim->index, D2D1_PROPERTY_TYPE_UNKNOWN, data, size );
+    }
+    for (i = 0; i < graph->node_count; i++)
+    {
+        const struct effect_node *node = &graph->nodes[i];
+
+        if (ID2D1Effect_GetInputCount( effects[i] ) < node->source_count)
+            ID2D1Effect_SetInputCount( effects[i], node->source_count );
+        for (j = 0; j < node->source_count; j++)
+        {
+            ID2D1Image *input = NULL;
+
+            if (node->sources[j] >= 0) ID2D1Effect_GetOutput( effects[node->sources[j]], &input );
+            else if ((input = param_images[-1 - node->sources[j]])) ID2D1Image_AddRef( input );
+            ID2D1Effect_SetInput( effects[i], j, input, FALSE );
+            if (input) ID2D1Image_Release( input );
+        }
+    }
+    ID2D1Effect_GetOutput( effects[graph->root], &output );
+done:
+    for (i = 0; i < graph->node_count; i++) if (effects[i]) ID2D1Effect_Release( effects[i] );
+    return output;
+}
