+/***********************************************************************
+ *          CompositionEffectFactory
+ */
+
+struct effect_factory
+{
+    ICompositionEffectFactory ICompositionEffectFactory_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    IInspectable ICompositionObject4_iface;
+    LONG ref;
+    struct compositor *compositor;
+    ICompositionPropertySet *properties;
+    struct effect_graph *graph;
+};
+
+static inline struct effect_factory *impl_from_ICompositionEffectFactory( ICompositionEffectFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct effect_factory, ICompositionEffectFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( ICompositionEffectFactory *iface, REFIID iid, void **out )
+{
+    struct effect_factory *impl = impl_from_ICompositionEffectFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICompositionEffectFactory ))
+        *out = &impl->ICompositionEffectFactory_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject4_x ))
+        *out = &impl->ICompositionObject4_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( ICompositionEffectFactory *iface )
+{
+    return InterlockedIncrement( &impl_from_ICompositionEffectFactory( iface )->ref );
+}
+
+static ULONG WINAPI factory_Release( ICompositionEffectFactory *iface )
+{
+    struct effect_factory *impl = impl_from_ICompositionEffectFactory( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        effect_graph_release( impl->graph );
+        object_release_properties( impl->properties );
+        ICompositor_Release( (ICompositor *)impl->compositor );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI factory_GetIids( ICompositionEffectFactory *iface, ULONG *count, IID **iids )
+{
+    if (!(*iids = CoTaskMemAlloc( 3 * sizeof(IID) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_ICompositionEffectFactory;
+    (*iids)[1] = IID_ICompositionObject;
+    (*iids)[2] = IID_IClosable;
+    *count = 3;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( ICompositionEffectFactory *iface, HSTRING *name )
+{
+    return WindowsCreateString( class_effect_factory, wcslen( class_effect_factory ), name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( ICompositionEffectFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_CreateBrush( ICompositionEffectFactory *iface, ICompositionEffectBrush **result )
+{
+    struct effect_factory *impl = impl_from_ICompositionEffectFactory( iface );
+
+    TRACE( "iface %p, result %p.\n", iface, result );
+    if (!result) return E_POINTER;
+    return effect_brush_create( impl->compositor, impl->graph, result );
+}
+
+static HRESULT WINAPI factory_get_ExtendedError( ICompositionEffectFactory *iface, HRESULT *value )
+{
+    if (!value) return E_POINTER;
+    *value = S_OK;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_get_LoadStatus( ICompositionEffectFactory *iface, CompositionEffectFactoryLoadStatus *value )
+{
+    if (!value) return E_POINTER;
+    *value = CompositionEffectFactoryLoadStatus_Success;
+    return S_OK;
+}
+
+static const struct ICompositionEffectFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    factory_CreateBrush,
+    factory_get_ExtendedError,
+    factory_get_LoadStatus,
+};
+
+DEFINE_COMPOSITION_OBJECT( factory, struct effect_factory, ICompositionEffectFactory_iface )
+DEFINE_COMPOSITION_OBJECT4( factory, struct effect_factory, ICompositionEffectFactory_iface )
+
+HRESULT effect_factory_create( struct compositor *compositor, IGraphicsEffect *effect, IIterable_HSTRING *animatable,
+                               ICompositionEffectFactory **out )
+{
+    struct effect_factory *impl;
+    struct effect_graph *graph;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+#ifdef SG_MUTANT_NO_EFFECT_FACTORY
+    return E_NOTIMPL;
+#endif
+    if (FAILED(hr = effect_graph_create( effect, animatable, &graph ))) return hr;
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        effect_graph_release( graph );
+        return E_OUTOFMEMORY;
+    }
+    impl->ICompositionEffectFactory_iface.lpVtbl = &factory_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &factory_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &factory_closable_vtbl;
+    impl->ICompositionObject4_iface.lpVtbl = (const IInspectableVtbl *)factory_object4_vtbl;
+    impl->ref = 1;
+    impl->compositor = compositor;
+    ICompositor_AddRef( (ICompositor *)compositor );
+    impl->graph = graph;
+    *out = &impl->ICompositionEffectFactory_iface;
+    return S_OK;
+}
