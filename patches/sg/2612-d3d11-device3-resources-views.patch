 struct d3d_rendertarget_view *unsafe_impl_from_ID3D10RenderTargetView(ID3D10RenderTargetView *iface);
 
+void d3d11_srv_desc1_from_desc(D3D11_SHADER_RESOURCE_VIEW_DESC1 *d1, const D3D11_SHADER_RESOURCE_VIEW_DESC *d);
+BOOL d3d11_srv_desc_from_desc1(D3D11_SHADER_RESOURCE_VIEW_DESC *d, const D3D11_SHADER_RESOURCE_VIEW_DESC1 *d1);
