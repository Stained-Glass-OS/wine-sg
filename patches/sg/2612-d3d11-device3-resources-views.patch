 static HRESULT STDMETHODCALLTYPE d3d11_device_CreateTexture2D1(ID3D11Device5 *iface,
-        const D3D11_TEXTURE2D_DESC1 *desc, const D3D11_SUBRESOURCE_DATA *data, ID3D11Texture2D1 **texture)
+        const D3D11_TEXTURE2D_DESC1 *desc1, const D3D11_SUBRESOURCE_DATA *data, ID3D11Texture2D1 **texture)
 {
-    FIXME("iface %p, desc %p, data %p, texture %p stub!\n", iface, desc, data, texture);
-    return E_NOTIMPL;
+    struct d3d_device *device = impl_from_ID3D11Device5(iface);
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D *object;
+    HRESULT hr;
+
+    TRACE("iface %p, desc %p, data %p, texture %p.\n", iface, desc1, data, texture);
+
+    if (!desc1)
+        return E_INVALIDARG;
+#ifndef SG_MUTANT_D3D113_LAYOUT_IGNORED
+    if (desc1->TextureLayout != D3D11_TEXTURE_LAYOUT_UNDEFINED)
+    {
+        WARN("Unsupported texture layout %#x.\n", desc1->TextureLayout);
+        return E_INVALIDARG;
+    }
+#endif
+
+    memcpy(&desc, desc1, sizeof(desc));
+    if (FAILED(hr = d3d11_device_CreateTexture2D(&device->ID3D11Device2_iface, &desc, data, &object)))
+        return hr;
+
+    /* the texture object also is an ID3D11Texture2D1; without a result pointer it only was a check */
+    if (!texture)
+    {
+        ID3D11Texture2D_Release(object);
+        return S_FALSE;
+    }
+    *texture = (ID3D11Texture2D1 *)object;
+    return S_OK;
 }
 
