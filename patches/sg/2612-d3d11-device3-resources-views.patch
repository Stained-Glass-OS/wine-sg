+void d3d11_uav_desc1_from_desc(D3D11_UNORDERED_ACCESS_VIEW_DESC1 *d1, const D3D11_UNORDERED_ACCESS_VIEW_DESC *d);
+BOOL d3d11_uav_desc_from_desc1(D3D11_UNORDERED_ACCESS_VIEW_DESC *d, const D3D11_UNORDERED_ACCESS_VIEW_DESC1 *d1);
