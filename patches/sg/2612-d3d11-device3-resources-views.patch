From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3d11: Direct3D 11.3 textures, views, queries and rasterizer state through ID3D11Device3

CreateTexture2D1, CreateTexture3D1, CreateShaderResourceView1,
CreateRenderTargetView1, CreateUnorderedAccessView1, CreateQuery1 and
CreateRasterizerState2 were E_NOTIMPL stubs, so applications that reach for the
11.3 device failed to create their resources. The new interfaces
(ID3D11Texture2D1, Texture3D1, ShaderResourceView1, RenderTargetView1,
UnorderedAccessView1, Query1 and RasterizerState2) are the existing objects: each
vtable is the old one followed by the one GetDesc1/GetDesc2 method, and the old
objects answer the new IIDs. The creators convert the new description to the old
one and refuse what Wine cannot do: a texture layout other than undefined, a
plane slice other than 0 and conservative rasterization (E_INVALIDARG). Called
without a result pointer they only validate and return S_FALSE. The query context
type is accepted and reported as ALL since the one immediate context does it all.
---
--- a/dlls/d3d11/async.c
+++ b/dlls/d3d11/async.c
@@ -36,6 +36,7 @@ static HRESULT STDMETHODCALLTYPE d3d11_query_QueryInterface(ID3D11Query *iface,
     TRACE("iface %p, riid %s, object %p.\n", iface, debugstr_guid(riid), object);
 
     if ((IsEqualGUID(riid, &IID_ID3D11Predicate) && query->predicate)
+            || (IsEqualGUID(riid, &IID_ID3D11Query1) && !query->predicate)
             || IsEqualGUID(riid, &IID_ID3D11Query)
             || IsEqualGUID(riid, &IID_ID3D11Asynchronous)
             || IsEqualGUID(riid, &IID_ID3D11DeviceChild)
@@ -158,8 +159,29 @@ static void STDMETHODCALLTYPE d3d11_query_GetDesc(ID3D11Query *iface, D3D11_QUER
     *desc = query->desc;
 }
 
-static const struct ID3D11QueryVtbl d3d11_query_vtbl =
+static void STDMETHODCALLTYPE d3d11_query_GetDesc1(ID3D11Query1 *iface, D3D11_QUERY_DESC1 *desc)
 {
+    struct d3d_query *query = impl_from_ID3D11Query((ID3D11Query *)iface);
+
+    TRACE("iface %p, desc %p.\n", iface, desc);
+
+    desc->Query = query->desc.Query;
+    desc->MiscFlags = query->desc.MiscFlags;
+#ifdef SG_MUTANT_D3D113_QUERY_CTX
+    desc->ContextType = D3D11_CONTEXT_TYPE_3D;
+#else
+    desc->ContextType = D3D11_CONTEXT_TYPE_ALL;
+#endif
+}
+
+static const struct
+{
+    struct ID3D11QueryVtbl base;
+    void (STDMETHODCALLTYPE *GetDesc1)(ID3D11Query1 *iface, D3D11_QUERY_DESC1 *desc);
+}
+d3d11_query_vtbl =
+{
+    {
     /* IUnknown methods */
     d3d11_query_QueryInterface,
     d3d11_query_AddRef,
@@ -173,6 +195,9 @@ static const struct ID3D11QueryVtbl d3d11_query_vtbl =
     d3d11_query_GetDataSize,
     /* ID3D11Query methods */
     d3d11_query_GetDesc,
+    },
+    /* ID3D11Query1 methods */
+    d3d11_query_GetDesc1,
 };
 
 static void STDMETHODCALLTYPE d3d_query_wined3d_object_destroyed(void *parent)
@@ -192,7 +217,7 @@ struct d3d_query *unsafe_impl_from_ID3D11Query(ID3D11Query *iface)
 {
     if (!iface)
         return NULL;
-    assert(iface->lpVtbl == &d3d11_query_vtbl);
+    assert(iface->lpVtbl == &d3d11_query_vtbl.base);
     return CONTAINING_RECORD(iface, struct d3d_query, ID3D11Query_iface);
 }
 
@@ -437,7 +462,7 @@ static HRESULT d3d_query_init(struct d3d_query *query, struct d3d_device *device
     if (desc->MiscFlags)
         FIXME("Ignoring MiscFlags %#x.\n", desc->MiscFlags);
 
-    query->ID3D11Query_iface.lpVtbl = &d3d11_query_vtbl;
+    query->ID3D11Query_iface.lpVtbl = &d3d11_query_vtbl.base;
     query->ID3D10Query_iface.lpVtbl = &d3d10_query_vtbl;
     query->refcount = 1;
 
--- a/dlls/d3d11/d3d11_private.h
+++ b/dlls/d3d11/d3d11_private.h
@@ -238,6 +238,13 @@ HRESULT d3d_rendertarget_view_create(struct d3d_device *device, ID3D11Resource *
