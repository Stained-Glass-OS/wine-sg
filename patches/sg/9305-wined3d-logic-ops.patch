+static GLenum gl_logic_op(enum wined3d_logic_op op)
+{
+    static const GLenum ops[] =
+    {
+        GL_CLEAR, GL_SET, GL_COPY, GL_COPY_INVERTED, GL_NOOP, GL_INVERT, GL_AND, GL_NAND,
+        GL_OR, GL_NOR, GL_XOR, GL_EQUIV, GL_AND_REVERSE, GL_AND_INVERTED, GL_OR_REVERSE, GL_OR_INVERTED,
+    };
+
+    if (op >= ARRAY_SIZE(ops))
+    {
+        FIXME("Unhandled logic op %#x.\n", op);
+        return GL_COPY;
+    }
+    return ops[op];
+}
+
+/* Direct3D 11.1 logic ops: one op for every render target, in place of blending. Like Direct3D,
+ * OpenGL applies it to (normalised) integer render targets only. */
+static void logic_op(struct wined3d_context *context, const struct wined3d_state *state)
+{
+    const struct wined3d_gl_info *gl_info = wined3d_context_gl(context)->gl_info;
+    const struct wined3d_blend_state *b = state->blend_state;
+
+#ifdef SG_MUTANT_NO_LOGIC_OP
+    if (0)
+#else
+    if (b && b->desc.logic_op_enable)
+#endif
+    {
+        gl_info->gl_ops.gl.p_glEnable(GL_COLOR_LOGIC_OP);
+        gl_info->gl_ops.gl.p_glLogicOp(gl_logic_op(b->desc.logic_op));
+    }
+    else
+    {
+        gl_info->gl_ops.gl.p_glDisable(GL_COLOR_LOGIC_OP);
+    }
+    checkGLcall("logic op");
+}
