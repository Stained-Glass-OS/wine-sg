+    WINED3D_LOGIC_OP_OR                     = 8,
+    WINED3D_LOGIC_OP_NOR                    = 9,
+    WINED3D_LOGIC_OP_XOR                    = 10,
+    WINED3D_LOGIC_OP_EQUIV                  = 11,
+    WINED3D_LOGIC_OP_AND_REVERSE            = 12,
