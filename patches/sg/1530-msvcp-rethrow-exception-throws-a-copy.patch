From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcp140, msvcr120: rethrow_exception throws a copy (1530)

On Windows std::rethrow_exception copies the object the exception_ptr holds
(with its copy constructor, onto the stack) and throws the copy, so the
catch that ends destroys only the copy and the exception_ptr keeps its own.
Wine raised the stored record as it was: the catch ran the destructor on the
exception_ptr's object, which was then used, rethrown again and destroyed a
second time. Microsoft 365 (OneNote's background error path, make_exception_ptr
then rethrow_exception in a loop) went on with a destroyed object.

Gate: test/ptrrethrow-gate.sh (64-bit, hand-built throw info).
Mutant: SG_MUTANT_RETHROW_SHARED_OBJECT (gate fails: copies=1 thrown=same).
msvcp140 (640 tests, 12 failures from directory tests) and msvcr120
(961 tests, 0 failures) conformance unchanged.

--- a/dlls/msvcp90/exception.c
+++ b/dlls/msvcp90/exception.c
@@ -1179,6 +1179,9 @@
     LONG *ref; /* not binary compatible with native */
 } exception_ptr;
 
+#if _MSVCP_VER >= 140
+static void exception_ptr_rethrow(const exception_ptr *ep);
+#else
 static void exception_ptr_rethrow(const exception_ptr *ep)
 {
     TRACE("(%p)\n", ep);
@@ -1196,6 +1199,7 @@
     RaiseException(ep->rec->ExceptionCode, ep->rec->ExceptionFlags & ~EXCEPTION_UNWINDING,
             ep->rec->NumberParameters, ep->rec->ExceptionInformation);
 }
+#endif
 
 /* ?_Rethrow_future_exception@std@@YAXVexception_ptr@1@@Z */
 void __cdecl _Rethrow_future_exception(const exception_ptr ep)
@@ -1318,6 +1322,51 @@
     ep->ref = NULL;
 }
 
+static void exception_ptr_rethrow(const exception_ptr *ep)
+{
+    ULONG_PTR info[EXCEPTION_MAXIMUM_PARAMETERS];
+
+    TRACE("(%p)\n", ep);
+
+    if (!ep->rec)
+    {
+        static const char *exception_msg = "bad exception";
+        exception e;
+
+        MSVCP_exception_ctor(&e, &exception_msg);
+        _CxxThrowException(&e, &exception_exception_type);
+        return;
+    }
+
+    memcpy(info, ep->rec->ExceptionInformation, sizeof(info));
+#ifndef SG_MUTANT_RETHROW_SHARED_OBJECT
+    /* Stained Glass OS (wine-sg 1530): Windows throws a copy of the stored
+     * object, so the catch that ends destroys only the copy; the
+     * exception_ptr keeps its own. Throwing the stored object let the catch
+     * destroy it under the exception_ptr, and OneNote then used it. */
+    if (ep->rec->ExceptionCode == CXX_EXCEPTION && info[1] && info[2])
+    {
+        void *obj = (void *)info[1];
+        const cxx_exception_type *et = (void *)info[2];
+        uintptr_t base = rtti_rva_base( et );
+        const cxx_type_info_table *table = rtti_rva( et->type_info_table, base );
+        const cxx_type_info *ti = rtti_rva( table->info[0], base );
+        void **copy = __builtin_alloca( ti->size ? ti->size : sizeof(void *) );
+
+        if (ti->flags & CLASS_IS_SIMPLE_TYPE)
+            memcpy(copy, obj, ti->size);
+        else if (ti->copy_ctor)
+            call_copy_ctor(rtti_rva(ti->copy_ctor, base), copy, obj,
+                    ti->flags & CLASS_HAS_VIRTUAL_BASE_CLASS);
+        else
+            memcpy(copy, obj, ti->size);
+        info[1] = (ULONG_PTR)copy;
+    }
+#endif
+    RaiseException(ep->rec->ExceptionCode, ep->rec->ExceptionFlags & ~EXCEPTION_UNWINDING,
+            ep->rec->NumberParameters, info);
+}
+
 /*********************************************************************
  * ?__ExceptionPtrDestroy@@YAXPAX@Z
  * ?__ExceptionPtrDestroy@@YAXPEAX@Z
--- a/dlls/msvcrt/exception_ptr.c
+++ b/dlls/msvcrt/exception_ptr.c
@@ -143,8 +143,35 @@
         return;
     }
 
-    RaiseException(ep->rec->ExceptionCode, ep->rec->ExceptionFlags & ~EXCEPTION_UNWINDING,
-            ep->rec->NumberParameters, ep->rec->ExceptionInformation);
+    {
+        ULONG_PTR info[EXCEPTION_MAXIMUM_PARAMETERS];
+
+        memcpy(info, ep->rec->ExceptionInformation, sizeof(info));
+#ifndef SG_MUTANT_RETHROW_SHARED_OBJECT
+        /* Stained Glass OS (wine-sg 1530): throw a copy; the exception_ptr
+         * keeps the stored object (see msvcp90). */
+        if (ep->rec->ExceptionCode == CXX_EXCEPTION && info[1] && info[2])
+        {
+            void *obj = (void *)info[1];
+            const cxx_exception_type *et = (void *)info[2];
+            uintptr_t base = rtti_rva_base( et );
+            const cxx_type_info_table *table = rtti_rva( et->type_info_table, base );
+            const cxx_type_info *ti = rtti_rva( table->info[0], base );
+            void **copy = __builtin_alloca( ti->size ? ti->size : sizeof(void *) );
+
+            if (ti->flags & CLASS_IS_SIMPLE_TYPE)
+                memcpy(copy, obj, ti->size);
+            else if (ti->copy_ctor)
+                call_copy_ctor(rtti_rva(ti->copy_ctor, base), copy, obj,
+                        ti->flags & CLASS_HAS_VIRTUAL_BASE_CLASS);
+            else
+                memcpy(copy, obj, ti->size);
+            info[1] = (ULONG_PTR)copy;
+        }
+#endif
+        RaiseException(ep->rec->ExceptionCode, ep->rec->ExceptionFlags & ~EXCEPTION_UNWINDING,
+                ep->rec->NumberParameters, info);
+    }
 }
 
