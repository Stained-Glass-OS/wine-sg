From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: OWNER RIGHTS ACEs are the owner's

An ACE for OWNER RIGHTS (S-1-3-4) applies to the object's owner, and when a
DACL has any they replace the owner's implicit rights. Wine matched them to
no one: CPython 3.12.4's os.mkdir(path, 0o700) -- tempfile.mkdtemp, BleachBit's
settings folder -- makes a directory for SYSTEM, the administrators and its
owner by OWNER RIGHTS, and a standard user got a directory with mode 000 that
it could not write in. The access check and the Unix mode now give them to
the owner.
---
--- a/server/token.c
+++ b/server/token.c
@@ -80,6 +80,7 @@
 };
 
 const struct sid world_sid = { SID_REVISION, 1, SECURITY_WORLD_SID_AUTHORITY, { SECURITY_WORLD_RID } };
+const struct sid owner_rights_sid = { SID_REVISION, 1, SECURITY_CREATOR_SID_AUTHORITY, { SECURITY_CREATOR_OWNER_RIGHTS_RID } };
 const struct sid local_system_sid = { SID_REVISION, 1, SECURITY_NT_AUTHORITY, { SECURITY_LOCAL_SYSTEM_RID } };
 const struct sid local_user_sid = { SID_REVISION, 5, SECURITY_NT_AUTHORITY, { SECURITY_NT_NON_UNIQUE, 0, 0, 0, 1000 } };
 const struct sid builtin_admins_sid = { SID_REVISION, 2, SECURITY_NT_AUTHORITY, { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS } };
@@ -1685,10 +1686,21 @@
                               restricted ? token_restricting_sid_present( token, (s) ) \
                                          : token_sid_present( token, (s), (deny) ))
 
+    /* Stained Glass OS: OWNER RIGHTS (S-1-3-4) ACEs are the owner's, and
+     * when there are any they replace its implicit rights -- Python 3.12.4's
+     * os.mkdir(path, 0o700) makes a directory only SYSTEM, the administrators
+     * and its owner (by OWNER RIGHTS) may use, and Wine let its owner in no
+     * further than its security (tempfile.mkdtemp; BleachBit's settings). */
+    int owner_rights = 0, is_owner = SID_PRESENT( owner, FALSE );
+
+    for (i = 0, ace = ace_first( dacl ); i < dacl->count; i++, ace = ace_next( ace ))
+        if (!(ace->flags & INHERIT_ONLY_ACE) && equal_sid( (const struct sid *)(ace + 1), &owner_rights_sid ))
+            owner_rights = 1;
+
     /* NOTE: SeTakeOwnershipPrivilege is not checked for here - it is instead
      * checked when a "set owner" call is made, overriding the access rights
      * determined here. */
-    if (SID_PRESENT( owner, FALSE ))
+    if (is_owner && !owner_rights)
     {
         current_access |= (STANDARD_RIGHTS_REQUIRED | SYNCHRONIZE);
         if (desired_access == current_access) return current_access;
@@ -1699,6 +1711,27 @@
         const struct sid *sid = (const struct sid *)(ace + 1);
 
         if (ace->flags & INHERIT_ONLY_ACE) continue;
+        if (equal_sid( sid, &owner_rights_sid ))
+        {
+            unsigned int access;
+            if (!is_owner || (ace->type != ACCESS_ALLOWED_ACE_TYPE && ace->type != ACCESS_DENIED_ACE_TYPE)) continue;
+            access = map_access( ace->mask, mapping );
+            if (ace->type == ACCESS_DENIED_ACE_TYPE)
+            {
+                if (desired_access & MAXIMUM_ALLOWED)
+                    denied_access |= access;
+                else
+                {
+                    denied_access |= (access & ~current_access);
+                    if (desired_access & access) goto done;
+                }
+            }
+            else if (desired_access & MAXIMUM_ALLOWED)
+                current_access |= access;
+            else
+                current_access |= (access & ~denied_access);
+            continue;
+        }
 
         switch (ace->type)
         {
--- a/server/security.h
+++ b/server/security.h
@@ -45,6 +45,7 @@
 extern const struct luid SeCreateGlobalPrivilege;
 
 extern const struct sid world_sid;
+extern const struct sid owner_rights_sid;
 extern const struct sid local_user_sid;
 
 /* Stained Glass OS: identity of the user a connection belongs to.
--- a/server/file.c
+++ b/server/file.c
@@ -574,7 +574,7 @@
                     {
                         bits_to_set &= ~((mode << 6) | (mode << 3));  /* user + group */
                     }
-                    else if (equal_sid( sid, owner ))
+                    else if (equal_sid( sid, owner ) || equal_sid( sid, &owner_rights_sid ))
                     {
                         bits_to_set &= ~(mode << 6);  /* user only */
                     }
@@ -600,9 +600,9 @@
                         new_mode |= mode & bits_to_set;
                         bits_to_set &= ~mode;
                     }
-                    else if (equal_sid( sid, owner ))
+                    else if (equal_sid( sid, owner ) || equal_sid( sid, &owner_rights_sid ))
                     {
-                        mode = (mode << 6);  /* user only */
+                        mode = (mode << 6);  /* user only (OWNER RIGHTS: the owner too) */
                         new_mode |= mode & bits_to_set;
                         bits_to_set &= ~mode;
                     }
