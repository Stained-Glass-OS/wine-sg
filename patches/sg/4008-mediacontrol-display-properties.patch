From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.media.mediacontrol: Display updater video and image properties.

SystemMediaTransportControlsDisplayUpdater's VideoProperties and
ImageProperties return objects keeping the title and subtitle set on them;
include/windows.media.idl gets the IImageDisplayProperties and
IVideoDisplayProperties(2) interfaces.
---
 dlls/windows.media.mediacontrol/main.c | 272 ++++++++++++++++++++++++++++++++-
 include/windows.media.idl              |  36 +++++
 2 files changed, 304 insertions(+), 4 deletions(-)

diff --git a/dlls/windows.media.mediacontrol/main.c b/dlls/windows.media.mediacontrol/main.c
index 7842267..9a724ac 100644
--- a/dlls/windows.media.mediacontrol/main.c
+++ b/dlls/windows.media.mediacontrol/main.c
@@ -448,6 +448,247 @@ static void music_properties_clear( struct music_properties *impl )
     IVector_HSTRING_Clear( impl->genres );
 }
 
+/* ImageDisplayProperties and VideoDisplayProperties: a title and a subtitle (and
+ * for video a genres list), kept by the display updater like the music values. */
+struct display_properties
+{
+    IImageDisplayProperties IImageDisplayProperties_iface;
+    IVideoDisplayProperties IVideoDisplayProperties_iface;
+    IVideoDisplayProperties2 IVideoDisplayProperties2_iface;
+    LONG ref;
+    BOOL video;
+
+    HSTRING title;
+    HSTRING subtitle;
+    IVector_HSTRING *genres;
+};
+
+static inline struct display_properties *impl_from_IImageDisplayProperties( IImageDisplayProperties *iface )
+{
+    return CONTAINING_RECORD( iface, struct display_properties, IImageDisplayProperties_iface );
+}
+
+static HRESULT WINAPI image_properties_QueryInterface( IImageDisplayProperties *iface, REFIID iid, void **out )
+{
+    struct display_properties *impl = impl_from_IImageDisplayProperties( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = impl->video ? (void *)&impl->IVideoDisplayProperties_iface : (void *)&impl->IImageDisplayProperties_iface;
+    else if (!impl->video && IsEqualGUID( iid, &IID_IImageDisplayProperties ))
+        *out = &impl->IImageDisplayProperties_iface;
+    else if (impl->video && IsEqualGUID( iid, &IID_IVideoDisplayProperties ))
+        *out = &impl->IVideoDisplayProperties_iface;
+    else if (impl->video && IsEqualGUID( iid, &IID_IVideoDisplayProperties2 ))
+        *out = &impl->IVideoDisplayProperties2_iface;
+    else
+    {
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI image_properties_AddRef( IImageDisplayProperties *iface )
+{
+    struct display_properties *impl = impl_from_IImageDisplayProperties( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI image_properties_Release( IImageDisplayProperties *iface )
+{
+    struct display_properties *impl = impl_from_IImageDisplayProperties( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->title );
+        WindowsDeleteString( impl->subtitle );
+        if (impl->genres) IVector_HSTRING_Release( impl->genres );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI image_properties_GetIids( IImageDisplayProperties *iface, ULONG *iid_count, IID **iids )
+{
+    struct display_properties *impl = impl_from_IImageDisplayProperties( iface );
+
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    if (impl->video) return SG_GET_IIDS( iid_count, iids, &IID_IVideoDisplayProperties, &IID_IVideoDisplayProperties2 );
+    return SG_GET_IIDS( iid_count, iids, &IID_IImageDisplayProperties );
+}
+
+static HRESULT WINAPI image_properties_GetRuntimeClassName( IImageDisplayProperties *iface, HSTRING *class_name )
+{
+    struct display_properties *impl = impl_from_IImageDisplayProperties( iface );
+
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+
+    return sg_class_name( impl->video ? RuntimeClass_Windows_Media_VideoDisplayProperties
+                                      : RuntimeClass_Windows_Media_ImageDisplayProperties, class_name );
+}
+
+static HRESULT WINAPI image_properties_GetTrustLevel( IImageDisplayProperties *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    return sg_get_trust_level( trust_level );
+}
+
+static HRESULT WINAPI image_properties_get_Title( IImageDisplayProperties *iface, HSTRING *value )
+{
+    struct display_properties *impl = impl_from_IImageDisplayProperties( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return get_string_property( impl->title, value );
+}
+
+static HRESULT WINAPI image_properties_put_Title( IImageDisplayProperties *iface, HSTRING value )
+{
+    struct display_properties *impl = impl_from_IImageDisplayProperties( iface );
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+    return put_string_property( &impl->title, value );
+}
+
+static HRESULT WINAPI image_properties_get_Subtitle( IImageDisplayProperties *iface, HSTRING *value )
+{
+    struct display_properties *impl = impl_from_IImageDisplayProperties( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return get_string_property( impl->subtitle, value );
+}
+
+static HRESULT WINAPI image_properties_put_Subtitle( IImageDisplayProperties *iface, HSTRING value )
+{
+    struct display_properties *impl = impl_from_IImageDisplayProperties( iface );
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+    return put_string_property( &impl->subtitle, value );
+}
+
+static const struct IImageDisplayPropertiesVtbl image_properties_vtbl =
+{
+    image_properties_QueryInterface,
+    image_properties_AddRef,
+    image_properties_Release,
+    /* IInspectable methods */
+    image_properties_GetIids,
+    image_properties_GetRuntimeClassName,
+    image_properties_GetTrustLevel,
+    /* IImageDisplayProperties methods */
+    image_properties_get_Title,
+    image_properties_put_Title,
+    image_properties_get_Subtitle,
+    image_properties_put_Subtitle,
+};
+
+DEFINE_IINSPECTABLE( video_properties, IVideoDisplayProperties, struct display_properties, IImageDisplayProperties_iface )
+
+static HRESULT WINAPI video_properties_get_Title( IVideoDisplayProperties *iface, HSTRING *value )
+{
+    struct display_properties *impl = impl_from_IVideoDisplayProperties( iface );
+    return image_properties_get_Title( &impl->IImageDisplayProperties_iface, value );
+}
+
+static HRESULT WINAPI video_properties_put_Title( IVideoDisplayProperties *iface, HSTRING value )
+{
+    struct display_properties *impl = impl_from_IVideoDisplayProperties( iface );
+    return image_properties_put_Title( &impl->IImageDisplayProperties_iface, value );
+}
+
+static HRESULT WINAPI video_properties_get_Subtitle( IVideoDisplayProperties *iface, HSTRING *value )
+{
+    struct display_properties *impl = impl_from_IVideoDisplayProperties( iface );
+    return image_properties_get_Subtitle( &impl->IImageDisplayProperties_iface, value );
+}
+
+static HRESULT WINAPI video_properties_put_Subtitle( IVideoDisplayProperties *iface, HSTRING value )
+{
+    struct display_properties *impl = impl_from_IVideoDisplayProperties( iface );
+    return image_properties_put_Subtitle( &impl->IImageDisplayProperties_iface, value );
+}
+
+static const struct IVideoDisplayPropertiesVtbl video_properties_vtbl =
+{
+    video_properties_QueryInterface,
+    video_properties_AddRef,
+    video_properties_Release,
+    /* IInspectable methods */
+    video_properties_GetIids,
+    video_properties_GetRuntimeClassName,
+    video_properties_GetTrustLevel,
+    /* IVideoDisplayProperties methods */
+    video_properties_get_Title,
+    video_properties_put_Title,
+    video_properties_get_Subtitle,
+    video_properties_put_Subtitle,
+};
+
+DEFINE_IINSPECTABLE( video_properties2, IVideoDisplayProperties2, struct display_properties, IImageDisplayProperties_iface )
+
+static HRESULT WINAPI video_properties2_get_Genres( IVideoDisplayProperties2 *iface, IVector_HSTRING **value )
+{
+    struct display_properties *impl = impl_from_IVideoDisplayProperties2( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    IVector_HSTRING_AddRef( (*value = impl->genres) );
+    return S_OK;
+}
+
+static const struct IVideoDisplayProperties2Vtbl video_properties2_vtbl =
+{
+    video_properties2_QueryInterface,
+    video_properties2_AddRef,
+    video_properties2_Release,
+    /* IInspectable methods */
+    video_properties2_GetIids,
+    video_properties2_GetRuntimeClassName,
+    video_properties2_GetTrustLevel,
+    /* IVideoDisplayProperties2 methods */
+    video_properties2_get_Genres,
+};
+
+static HRESULT display_properties_create( BOOL video, struct display_properties **out )
+{
+    struct display_properties *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->IImageDisplayProperties_iface.lpVtbl = &image_properties_vtbl;
+    impl->IVideoDisplayProperties_iface.lpVtbl = &video_properties_vtbl;
+    impl->IVideoDisplayProperties2_iface.lpVtbl = &video_properties2_vtbl;
+    impl->ref = 1;
+    impl->video = video;
+    if (video && FAILED( hr = hstring_vector_create( &impl->genres ) ))
+    {
+        free( impl );
+        return hr;
+    }
+    *out = impl;
+    return S_OK;
+}
+
+static void display_properties_clear( struct display_properties *impl )
+{
+    WindowsDeleteString( impl->title );
+    WindowsDeleteString( impl->subtitle );
+    impl->title = impl->subtitle = NULL;
+    if (impl->genres) IVector_HSTRING_Clear( impl->genres );
+}
+
 struct display_updater
 {
     ISystemMediaTransportControlsDisplayUpdater ISystemMediaTransportControlsDisplayUpdater_iface;
@@ -457,6 +698,8 @@ struct display_updater
     HSTRING app_media_id;
     __x_ABI_CWindows_CStorage_CStreams_CIRandomAccessStreamReference *thumbnail;
     struct music_properties *music;
+    struct display_properties *video;
+    struct display_properties *image;
 };
 
 static inline struct display_updater *impl_from_ISystemMediaTransportControlsDisplayUpdater( ISystemMediaTransportControlsDisplayUpdater *iface )
@@ -505,6 +748,8 @@ static ULONG WINAPI display_updater_Release( ISystemMediaTransportControlsDispla
         WindowsDeleteString( impl->app_media_id );
         if (impl->thumbnail) IUnknown_Release( (IUnknown *)impl->thumbnail );
         IMusicDisplayProperties_Release( &impl->music->IMusicDisplayProperties_iface );
+        if (impl->video) IImageDisplayProperties_Release( &impl->video->IImageDisplayProperties_iface );
+        if (impl->image) IImageDisplayProperties_Release( &impl->image->IImageDisplayProperties_iface );
         free( impl );
     }
     return ref;
@@ -602,14 +847,24 @@ static HRESULT WINAPI display_updater_get_MusicProperties( ISystemMediaTransport
 
 static HRESULT WINAPI display_updater_get_VideoProperties( ISystemMediaTransportControlsDisplayUpdater *iface, __x_ABI_CWindows_CMedia_CIVideoDisplayProperties **value )
 {
-    FIXME( "iface %p, value %p stub!\n", iface, value );
-    return E_NOTIMPL;
+    struct display_updater *impl = impl_from_ISystemMediaTransportControlsDisplayUpdater( iface );
+
+    TRACE( "iface %p, value %p\n", iface, value );
+
+    if (!value) return E_POINTER;
+    IVideoDisplayProperties_AddRef( (*value = &impl->video->IVideoDisplayProperties_iface) );
+    return S_OK;
 }
 
 static HRESULT WINAPI display_updater_get_ImageProperties( ISystemMediaTransportControlsDisplayUpdater *iface, __x_ABI_CWindows_CMedia_CIImageDisplayProperties **value )
 {
-    FIXME( "iface %p, value %p stub!\n", iface, value );
-    return E_NOTIMPL;
+    struct display_updater *impl = impl_from_ISystemMediaTransportControlsDisplayUpdater( iface );
+
+    TRACE( "iface %p, value %p\n", iface, value );
+
+    if (!value) return E_POINTER;
+    IImageDisplayProperties_AddRef( (*value = &impl->image->IImageDisplayProperties_iface) );
+    return S_OK;
 }
 
 static HRESULT WINAPI display_updater_CopyFromFileAsync( ISystemMediaTransportControlsDisplayUpdater *iface, MediaPlaybackType type, IStorageFile *source,
@@ -634,6 +889,8 @@ static HRESULT WINAPI display_updater_ClearAll( ISystemMediaTransportControlsDis
     old = InterlockedExchangePointer( (void **)&impl->thumbnail, NULL );
     if (old) IUnknown_Release( (IUnknown *)old );
     music_properties_clear( impl->music );
+    display_properties_clear( impl->video );
+    display_properties_clear( impl->image );
 #endif
     return S_OK;
 }
@@ -1138,6 +1395,13 @@ static HRESULT WINAPI media_control_statics_GetForWindow( ISystemMediaTransportC
         free( impl );
         return hr;
     }
+    if (FAILED( hr = display_properties_create( TRUE, &impl->updater->video ) )
+            || FAILED( hr = display_properties_create( FALSE, &impl->updater->image ) ))
+    {
+        ISystemMediaTransportControlsDisplayUpdater_Release( &impl->updater->ISystemMediaTransportControlsDisplayUpdater_iface );
+        free( impl );
+        return hr;
+    }
 
     TRACE( "created ISystemMediaTransportControls %p.\n", impl );
 
diff --git a/include/windows.media.idl b/include/windows.media.idl
index 87ccc75..e319c06 100644
--- a/include/windows.media.idl
+++ b/include/windows.media.idl
@@ -210,6 +210,42 @@ namespace Windows.Media
         [propget] HRESULT Genres([out, retval] Windows.Foundation.Collections.IVector<HSTRING> **value);
     }
 
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        exclusiveto(Windows.Media.ImageDisplayProperties),
+        uuid(cd0bc7ef-54e7-411f-9933-f0e98b0a96d2)
+    ]
+    interface IImageDisplayProperties : IInspectable
+    {
+        [propget] HRESULT Title([out, retval] HSTRING *value);
+        [propput] HRESULT Title([in] HSTRING value);
+        [propget] HRESULT Subtitle([out, retval] HSTRING *value);
+        [propput] HRESULT Subtitle([in] HSTRING value);
+    }
+
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        exclusiveto(Windows.Media.VideoDisplayProperties),
+        uuid(5609fdb1-5d2d-4872-8170-45dee5bc2f5c)
+    ]
+    interface IVideoDisplayProperties : IInspectable
+    {
+        [propget] HRESULT Title([out, retval] HSTRING *value);
+        [propput] HRESULT Title([in] HSTRING value);
+        [propget] HRESULT Subtitle([out, retval] HSTRING *value);
+        [propput] HRESULT Subtitle([in] HSTRING value);
+    }
+
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        exclusiveto(Windows.Media.VideoDisplayProperties),
+        uuid(b410e1ce-ab52-41ab-a486-cc10fab152f9)
+    ]
+    interface IVideoDisplayProperties2 : IInspectable
+    {
+        [propget] HRESULT Genres([out, retval] Windows.Foundation.Collections.IVector<HSTRING> **value);
+    }
+
     [
         contract(Windows.Foundation.UniversalApiContract, 1.0),
         exclusiveto(Windows.Media.PlaybackPositionChangeRequestedEventArgs),
