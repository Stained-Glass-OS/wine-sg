+#include <stdlib.h>
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(appx);
+
+/* A snapshot of packages: the list owns a reference to each. */
+struct package_list
+{
+    IIterable_Package IIterable_Package_iface;
+    LONG ref;
+    UINT32 count;
+    IPackage **packages;
+};
+
+struct package_iterator
+{
+    IIterator_Package IIterator_Package_iface;
+    LONG ref;
+    struct package_list *list;
+    UINT32 index;
+};
+
+static inline struct package_list *impl_from_IIterable_Package( IIterable_Package *iface )
+{
+    return CONTAINING_RECORD( iface, struct package_list, IIterable_Package_iface );
+}
+
+static inline struct package_iterator *impl_from_IIterator_Package( IIterator_Package *iface )
+{
+    return CONTAINING_RECORD( iface, struct package_iterator, IIterator_Package_iface );
+}
+
+static HRESULT WINAPI iterator_QueryInterface( IIterator_Package *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterator_Package ))
+    {
+        *out = iface;
+        IIterator_Package_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI iterator_AddRef( IIterator_Package *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterator_Package( iface )->ref );
+}
+
+static ULONG WINAPI iterator_Release( IIterator_Package *iface )
+{
+    struct package_iterator *impl = impl_from_IIterator_Package( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        IIterable_Package_Release( &impl->list->IIterable_Package_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( IIterator_Package *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI iterator_GetRuntimeClassName( IIterator_Package *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI iterator_GetTrustLevel( IIterator_Package *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI iterator_get_Current( IIterator_Package *iface, IPackage **value )
+{
+    struct package_iterator *impl = impl_from_IIterator_Package( iface );
+    if (!value) return E_POINTER;
+    if (impl->index >= impl->list->count) { *value = NULL; return E_BOUNDS; }
+    *value = impl->list->packages[impl->index];
+    IPackage_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( IIterator_Package *iface, boolean *value )
+{
+    struct package_iterator *impl = impl_from_IIterator_Package( iface );
+    if (!value) return E_POINTER;
+    *value = impl->index < impl->list->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( IIterator_Package *iface, boolean *value )
+{
+    struct package_iterator *impl = impl_from_IIterator_Package( iface );
+    if (!value) return E_POINTER;
+    if (impl->index < impl->list->count) impl->index++;
+    *value = impl->index < impl->list->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetMany( IIterator_Package *iface, UINT32 items_size, IPackage **items, UINT32 *count )
+{
+    struct package_iterator *impl = impl_from_IIterator_Package( iface );
+    UINT32 n = 0;
+
+    if (!count || (items_size && !items)) return E_POINTER;
+    while (n < items_size && impl->index < impl->list->count)
+    {
+        items[n] = impl->list->packages[impl->index++];
+        IPackage_AddRef( items[n++] );
+    }
+    *count = n;
+    return S_OK;
+}
+
+static const struct IIterator_PackageVtbl iterator_vtbl =
+{
+    iterator_QueryInterface,
+    iterator_AddRef,
+    iterator_Release,
+    iterator_GetIids,
+    iterator_GetRuntimeClassName,
+    iterator_GetTrustLevel,
+    iterator_get_Current,
+    iterator_get_HasCurrent,
+    iterator_MoveNext,
+    iterator_GetMany,
+};
+
+static HRESULT WINAPI list_QueryInterface( IIterable_Package *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterable_Package ))
+    {
+        *out = iface;
+        IIterable_Package_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI list_AddRef( IIterable_Package *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterable_Package( iface )->ref );
+}
+
+static ULONG WINAPI list_Release( IIterable_Package *iface )
+{
+    struct package_list *impl = impl_from_IIterable_Package( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT32 i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++) IPackage_Release( impl->packages[i] );
+        free( impl->packages );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI list_GetIids( IIterable_Package *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI list_GetRuntimeClassName( IIterable_Package *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI list_GetTrustLevel( IIterable_Package *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI list_First( IIterable_Package *iface, IIterator_Package **value )
+{
+    struct package_list *impl = impl_from_IIterable_Package( iface );
+    struct package_iterator *it;
+
+    if (!value) return E_POINTER;
+    if (!(it = calloc( 1, sizeof(*it) ))) return E_OUTOFMEMORY;
+    it->IIterator_Package_iface.lpVtbl = &iterator_vtbl;
+    it->ref = 1;
+    it->list = impl;
+    IIterable_Package_AddRef( iface );
+    *value = &it->IIterator_Package_iface;
+    return S_OK;
+}
+
+static const struct IIterable_PackageVtbl list_vtbl =
+{
+    list_QueryInterface,
+    list_AddRef,
+    list_Release,
+    list_GetIids,
+    list_GetRuntimeClassName,
+    list_GetTrustLevel,
+    list_First,
+};
+
+/* Takes the caller's references to the packages. */
+HRESULT package_list_create( IPackage **packages, UINT32 count, IIterable_Package **out )
+{
+    struct package_list *impl;
+
+    if (!out) return E_POINTER;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IIterable_Package_iface.lpVtbl = &list_vtbl;
+    impl->ref = 1;
+    impl->count = count;
+    impl->packages = packages;
+    *out = &impl->IIterable_Package_iface;
+    return S_OK;
+}
+
+/* The packages deployed on this system. MSIX deployment is not implemented
+ * yet (AddPackageAsync), so nothing has been deployed: the true answer to
+ * every query is an empty set, rather than an error that tells callers the
+ * query itself is impossible. */
+HRESULT deployed_packages( const WCHAR *user_sid, const WCHAR *name, const WCHAR *publisher,
+                           const WCHAR *family_name, IIterable_Package **out )
+{
+    TRACE( "user %s, name %s, publisher %s, family %s\n", debugstr_w( user_sid ), debugstr_w( name ),
+           debugstr_w( publisher ), debugstr_w( family_name ) );
+    return package_list_create( NULL, 0, out );
+}
