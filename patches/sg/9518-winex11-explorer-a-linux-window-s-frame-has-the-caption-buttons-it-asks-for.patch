From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, explorer: a Linux window's frame has the caption buttons it asks for

Every framed Linux window had a minimize and a maximize button and sizing
edges: Qt's message boxes, GTK's dialogs, a fixed-size window -- where
Windows shows a dialog with its close button only (linux1's QA VM,
2026-11-27: qBittorrent's legal notice, VLC's privacy dialog).

A program says so to a window manager: _MOTIF_WM_HINTS functions and
decorations without minimize or maximize, a dialog's or utility window's
type (_NET_WM_WINDOW_TYPE), a size it cannot change (WM_NORMAL_HINTS
minimum = maximum). explorer asks winex11 (SG_EMBED_HINTS, 0x80001011) as
it frames the window, and its frame goes without WS_MINIMIZEBOX,
WS_MAXIMIZEBOX or WS_THICKFRAME as asked.

Gate: test/linuxdialog-gate.sh (mutant SG_MUTANT_EMBED_ALL_BUTTONS).
---
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -1435,6 +1435,60 @@
     {
     case WM_X11DRV_SG_EMBED_QUERY:
         return sg_embed_query( hwnd, (Window)wp );
+    case WM_X11DRV_SG_EMBED_HINTS:
+    {
+        /* 9518: the caption buttons and frame a Linux window asks a window manager
+         * for: its _MOTIF_WM_HINTS functions and decorations (no minimize, no
+         * maximize: Qt's message boxes, GTK's dialogs), a dialog's type, a size
+         * it cannot change (WM_NORMAL_HINTS minimum = maximum). Its frame had a
+         * minimize and a maximize button and sizing edges for each. Bits: 1 no
+         * minimize, 2 no maximize, 4 a fixed size. */
+        Atom type, *types = NULL;
+        int format;
+        unsigned long count, remaining, i;
+        unsigned char *prop = NULL;
+        XSizeHints *size = XAllocSizeHints();
+        long supplied;
+        LRESULT ret = 0;
+
+        if (!(data = get_win_data( hwnd ))) { if (size) XFree( size ); return 0; }
+        display = data->display;
+        release_win_data( data );
+        X11DRV_expect_error( display, ignore_error, NULL );
+        if (!XGetWindowProperty( display, (Window)wp, x11drv_atom(_MOTIF_WM_HINTS), 0, 5, False, AnyPropertyType,
+                                 &type, &format, &count, &remaining, &prop ) && prop && format == 32 && count >= 3)
+        {
+            unsigned long *h = (unsigned long *)prop;
+            if (h[0] & 1)   /* MWM_HINTS_FUNCTIONS */
+            {
+                BOOL all = h[1] & 1, min = !!(h[1] & 8), max = !!(h[1] & 16);
+                if (all ? min : !min) ret |= 1;
+                if (all ? max : !max) ret |= 2;
+            }
+            if ((h[0] & 2) && h[2] && !(h[2] & 1))   /* MWM_HINTS_DECORATIONS, listed */
+            {
+                if (!(h[2] & 32)) ret |= 1;
+                if (!(h[2] & 64)) ret |= 2;
+            }
+        }
+        if (prop) { XFree( prop ); prop = NULL; }
+        if (!XGetWindowProperty( display, (Window)wp, x11drv_atom(_NET_WM_WINDOW_TYPE), 0, 16, False, XA_ATOM,
+                                 &type, &format, &count, &remaining, &prop ) && prop && format == 32)
+        {
+            types = (Atom *)prop;
+            for (i = 0; i < count; i++)
+                if (types[i] == x11drv_atom(_NET_WM_WINDOW_TYPE_DIALOG) ||
+                    types[i] == x11drv_atom(_NET_WM_WINDOW_TYPE_UTILITY)) { ret |= 1; break; }
+        }
+        if (prop) XFree( prop );
+        if (size && XGetWMNormalHints( display, (Window)wp, size, &supplied ) &&
+            (size->flags & (PMinSize | PMaxSize)) == (PMinSize | PMaxSize) &&
+            size->min_width == size->max_width && size->min_height == size->max_height && size->min_width > 0)
+            ret |= 4 | 2;
+        if (size) XFree( size );
+        if (sync_check_error( display )) ret = 0;
+        return ret;
+    }
     case WM_X11DRV_SG_EMBED_OWNER:
     {
         /* 9515: the window the Linux window WP is a dialog of (ICCCM
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3952,6 +3952,7 @@
     case WM_X11DRV_SG_EMBED_MOVESIZE_DONE:
     case WM_X11DRV_SG_EMBED_ATTENTION:
     case WM_X11DRV_SG_EMBED_OWNER:
+    case WM_X11DRV_SG_EMBED_HINTS:
         return sg_embed_message( hwnd, msg, wp, lp );
     case WM_X11DRV_SG_GL_RESHOW:
         return sg_gl_reshow( hwnd );
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -712,7 +712,8 @@
     WM_X11DRV_SG_EMBED_MOVESIZE_DONE,
     WM_X11DRV_SG_GL_RESHOW,        /* 6096: show the offscreen OpenGL frame again */
     WM_X11DRV_SG_EMBED_ATTENTION,  /* 9513: the Linux program in it asks for attention, or no longer */
-    WM_X11DRV_SG_EMBED_OWNER       /* 9515: whose dialog a Linux window is (explorer sends it by number, 0x80001010) */
+    WM_X11DRV_SG_EMBED_OWNER,      /* 9515: whose dialog a Linux window is (explorer sends it by number, 0x80001010) */
+    WM_X11DRV_SG_EMBED_HINTS       /* 9518: which caption buttons a Linux window has (by number, 0x80001011) */
 };
 
 /* a window whose OpenGL frames are rendered offscreen and copied into its top-level (6096) */
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -3157,6 +3157,7 @@
 #define SG_EMBED_ATTACH  0x80001005
 #define SG_EMBED_CLOSE   0x80001006
 #define SG_EMBED_OWNER   0x80001010   /* 9515: the X window a Linux window is a dialog of (WM_TRANSIENT_FOR) */
+#define SG_EMBED_HINTS   0x80001011   /* 9518: its caption buttons: 1 no minimize, 2 no maximize, 4 a fixed size */
 #define WM_SG_EMBED_SHOWN (WM_USER + 0x5350)
 #define WM_SG_EMBED_GONE  (WM_USER + 0x5351)
 
@@ -3729,7 +3730,26 @@
         SetWindowLongW( frame, GWL_STYLE, WS_POPUP | WS_THICKFRAME | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX );
         SetWindowPos( frame, 0, 0, 0, 0, 0, SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE );
     }
-    else AdjustWindowRectEx( &rc, WS_OVERLAPPEDWINDOW, FALSE, WS_EX_APPWINDOW );
+    else
+    {
+#ifndef SG_MUTANT_EMBED_ALL_BUTTONS
+        /* 9518: the buttons and edges it asks for, as a Windows dialog has only
+         * its close button (Qt's message boxes, GTK's dialogs, a fixed size) */
+        LONG style = WS_OVERLAPPEDWINDOW;
+        UINT hints = (UINT)sg_embed_call( frame, SG_EMBED_HINTS, xid );
+        if (hints & 1) style &= ~WS_MINIMIZEBOX;
+        if (hints & 2) style &= ~WS_MAXIMIZEBOX;
+        if (hints & 4) style &= ~WS_THICKFRAME;
+        if (style != WS_OVERLAPPEDWINDOW)
+        {
+            SetWindowLongW( frame, GWL_STYLE, (GetWindowLongW( frame, GWL_STYLE ) & ~WS_OVERLAPPEDWINDOW) | style );
+            SetWindowPos( frame, 0, 0, 0, 0, 0, SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE );
+        }
+        AdjustWindowRectEx( &rc, style, FALSE, WS_EX_APPWINDOW );
+#else
+        AdjustWindowRectEx( &rc, WS_OVERLAPPEDWINDOW, FALSE, WS_EX_APPWINDOW );
+#endif
+    }
 #ifndef SG_MUTANT_EMBED_FRAME_ORIGIN_CLAMP
     {
         /* the title bar on the screen: whole on its display's work area (the display under
