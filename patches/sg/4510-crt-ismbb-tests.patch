+ *		_ismbbprint_l(MSVCRT.@)
+ */
+int CDECL _ismbbprint_l(unsigned int c, _locale_t locale)
+{
+    return ismbbtype_l(c, _MS | _MP, _BLANK | _PUNCT | _ALPHA | _DIGIT, locale);
+}
+
+/*********************************************************************
+ *		_ismbbprint(MSVCRT.@)
+ */
+int CDECL _ismbbprint(unsigned int c)
+{
+    return _ismbbprint_l(c, NULL);
+}
+
+/*********************************************************************
+ *		_ismbbpunct_l(MSVCRT.@)
+ */
+int CDECL _ismbbpunct_l(unsigned int c, _locale_t locale)
+{
+    return ismbbtype_l(c, _MP, _PUNCT, locale);
+}
+
+/*********************************************************************
+ *		_ismbbpunct(MSVCRT.@)
+ */
+int CDECL _ismbbpunct(unsigned int c)
+{
+    return _ismbbpunct_l(c, NULL);
+}
+
+#if _MSVCR_VER >= 120
+/*********************************************************************
+ *		_ismbbblank_l(MSVCR120.@)
+ *
+ * A space or a horizontal tab (the blank characters of the C locale).
+ */
+int CDECL _ismbbblank_l(unsigned int c, _locale_t locale)
+{
+    return (c & 0xff) == '\t' || ismbbtype_l(c, 0, _BLANK, locale);
+}
+
+/*********************************************************************
+ *		_ismbbblank(MSVCR120.@)
+ */
+int CDECL _ismbbblank(unsigned int c)
+{
+    return _ismbbblank_l(c, NULL);
+}
+
+/*********************************************************************
+ *		_ismbcblank_l(MSVCR120.@)
+ *
+ * The single-byte blanks, and in code page 932 the double-byte
+ * (ideographic) space.
+ */
+int CDECL _ismbcblank_l(unsigned int c, _locale_t locale)
+{
+    pthreadmbcinfo mbcinfo = locale ? locale->mbcinfo : get_mbcinfo();
+
+    if (c > 0xff)
+        return mbcinfo->mbcodepage == 932 && c == 0x8140;
+    return _ismbbblank_l(c, locale);
+}
+
+/*********************************************************************
+ *		_ismbcblank(MSVCR120.@)
+ */
+int CDECL _ismbcblank(unsigned int c)
+{
+    return _ismbcblank_l(c, NULL);
+}
+#endif
+
