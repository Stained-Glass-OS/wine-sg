+ */
+int CDECL _ismbbgraph_l(unsigned int c, _locale_t locale)
+{
+    return ismbbtype_l(c, _MS | _MP, _PUNCT | _ALPHA | _DIGIT, locale);
+}
+
+/*********************************************************************
