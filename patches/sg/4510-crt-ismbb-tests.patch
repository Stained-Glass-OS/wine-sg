index bd4245c..5856261 100644
--- a/dlls/msvcrt/mbcs.c
+++ b/dlls/msvcrt/mbcs.c
@@ -1805,6 +1805,192 @@ unsigned int CDECL _mbbtombc(unsigned int c)
     return _mbbtombc_l(c, NULL);
 }
 
+/* A single byte of the given C ctype class, or a non-ASCII single-byte
+ * symbol of the code page with the given multibyte flags (_MS: kana
+ * alphanumerics, _MP: kana punctuation; only code page 932 has them). */
+static int ismbbtype_l(unsigned int c, int kflags, int ctype, _locale_t locale)
+{
+    pthreadmbcinfo mbcinfo = locale ? locale->mbcinfo : get_mbcinfo();
+
+    c &= 0xff;
+#ifndef SG_MUTANT_ISMBB_NO_KANA
+    if (mbcinfo->mbctype[c + 1] & kflags)
+        return 1;
+#endif
+    return ctype && _isctype_l(c, ctype, locale);
+}
+
+/*********************************************************************
+ *		_ismbbkalnum_l(MSVCRT.@)
+ */
+int CDECL _ismbbkalnum_l(unsigned int c, _locale_t locale)
+{
+    return ismbbtype_l(c, _MS, 0, locale);
+}
+
+/*********************************************************************
+ *		_ismbbkalnum(MSVCRT.@)
+ */
+int CDECL _ismbbkalnum(unsigned int c)
+{
+    return _ismbbkalnum_l(c, NULL);
+}
+
+/*********************************************************************
+ *		_ismbbkpunct_l(MSVCRT.@)
+ */
+int CDECL _ismbbkpunct_l(unsigned int c, _locale_t locale)
+{
+    return ismbbtype_l(c, _MP, 0, locale);
+}
+
+/*********************************************************************
+ *		_ismbbkpunct(MSVCRT.@)
+ */
+int CDECL _ismbbkpunct(unsigned int c)
+{
+    return _ismbbkpunct_l(c, NULL);
+}
+
+/*********************************************************************
+ *		_ismbbkprint_l(MSVCRT.@)
+ */
+int CDECL _ismbbkprint_l(unsigned int c, _locale_t locale)
+{
+    return ismbbtype_l(c, _MS | _MP, 0, locale);
+}
+
+/*********************************************************************
+ *		_ismbbkprint(MSVCRT.@)
+ */
+int CDECL _ismbbkprint(unsigned int c)
+{
+    return _ismbbkprint_l(c, NULL);
+}
+
+/*********************************************************************
+ *		_ismbbalnum_l(MSVCRT.@)
+ */
+int CDECL _ismbbalnum_l(unsigned int c, _locale_t locale)
+{
+    return ismbbtype_l(c, _MS, _ALPHA | _DIGIT, locale);
+}
+
+/*********************************************************************
+ *		_ismbbalnum(MSVCRT.@)
+ */
+int CDECL _ismbbalnum(unsigned int c)
+{
+    return _ismbbalnum_l(c, NULL);
+}
+
+/*********************************************************************
+ *		_ismbbalpha_l(MSVCRT.@)
+ */
+int CDECL _ismbbalpha_l(unsigned int c, _locale_t locale)
+{
+    return ismbbtype_l(c, _MS, _ALPHA, locale);
+}
+
+/*********************************************************************
+ *		_ismbbalpha(MSVCRT.@)
+ */
+int CDECL _ismbbalpha(unsigned int c)
+{
+    return _ismbbalpha_l(c, NULL);
+}
+
+/*********************************************************************
