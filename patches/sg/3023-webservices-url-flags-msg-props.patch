     len = len_scheme + 3; /* '://' */
     len += 6; /* ':65535' */
@@ -462,7 +531,7 @@ HRESULT WINAPI WsEncodeUrl( const WS_URL *base, ULONG flags, WS_HEAP *heap, WS_S
         goto done;
     len += len_enc + 1; /* '#' */
 
-    ret_size = len * sizeof(WCHAR);
+    ret_size = (len + 1) * sizeof(WCHAR);
     if (!(str = ws_alloc( heap, ret_size )))
     {
         hr = WS_E_QUOTA_EXCEEDED;
@@ -530,6 +599,7 @@ HRESULT WINAPI WsEncodeUrl( const WS_URL *base, ULONG flags, WS_HEAP *heap, WS_S
 
     ret->length = p - str;
     ret->chars  = str;
+    if (flags & WS_URL_FLAGS_ZERO_TERMINATE) *p = 0;
