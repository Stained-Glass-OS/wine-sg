diff --git a/dlls/webservices/url.c b/dlls/webservices/url.c
index c2db435..c4a638d 100644
--- a/dlls/webservices/url.c
+++ b/dlls/webservices/url.c
@@ -166,6 +166,63 @@ static WCHAR *url_decode( WCHAR *str, ULONG len, WS_HEAP *heap, ULONG *ret_len )
     return ret;
 }
 
+/* remove "." segments and resolve ".." segments, returns the new length */
+static ULONG collapse_path( WCHAR *path, ULONG len )
+{
+    ULONG in = 0, out = 0;
+
+    while (in < len)
+    {
+        ULONG seg_end = in + 1;
+
+        /* path[in] is a '/' */
+        while (seg_end < len && path[seg_end] != '/') seg_end++;
+        if (seg_end - in == 2 && path[in + 1] == '.')
+        {
+            if (seg_end == len) path[out++] = '/';
+        }
+        else if (seg_end - in == 3 && path[in + 1] == '.' && path[in + 2] == '.')
+        {
+            while (out && path[out - 1] != '/') out--;
+            if (out) out--;
+            if (seg_end == len) path[out++] = '/';
+        }
+        else
+        {
+            memmove( path + out, path + in, (seg_end - in) * sizeof(WCHAR) );
+            out += seg_end - in;
+        }
+        in = seg_end;
+    }
+    return out;
+}
+
+static BOOL has_dot_segment( const WCHAR *path, ULONG len )
+{
+    ULONG i;
+
+    for (i = 0; i + 1 < len; i++)
+    {
+        if (path[i] != '/' || path[i + 1] != '.') continue;
+        if (i + 2 == len || path[i + 2] == '/') return TRUE;
+        if (path[i + 2] == '.' && (i + 3 == len || path[i + 3] == '/')) return TRUE;
+    }
+    return FALSE;
+}
+
+/* replace the string by a zero terminated copy on the heap */
+static BOOL zero_terminate( WS_HEAP *heap, WS_STRING *str )
+{
+    WCHAR *copy;
+
+    if (!str->length) return TRUE;
+    if (!(copy = ws_alloc( heap, (str->length + 1) * sizeof(WCHAR) ))) return FALSE;
+    memcpy( copy, str->chars, str->length * sizeof(WCHAR) );
+    copy[str->length] = 0;
+    str->chars = copy;
+    return TRUE;
+}
+
 /**************************************************************************
  *          WsDecodeUrl		[webservices.@]
  */
@@ -181,11 +238,8 @@ HRESULT WINAPI WsDecodeUrl( const WS_STRING *str, ULONG flags, WS_HEAP *heap, WS
 
     if (!str || !heap) return E_INVALIDARG;
     if (!str->length) return WS_E_INVALID_FORMAT;
-    if (flags)
-    {
-        FIXME( "unimplemented flags %#lx\n", flags );
-        return E_NOTIMPL;
-    }
+    if (flags & ~(WS_URL_FLAGS_ALLOW_HOST_WILDCARDS | WS_URL_FLAGS_NO_PATH_COLLAPSE | WS_URL_FLAGS_ZERO_TERMINATE))
+        return E_INVALIDARG;
     if (!(decoded = url_decode( str->chars, str->length, heap, &len_decoded )) ||
         !(url = ws_alloc( heap, sizeof(*url) ))) goto done;
 
@@ -260,6 +314,25 @@ HRESULT WINAPI WsDecodeUrl( const WS_STRING *str, ULONG flags, WS_HEAP *heap, WS
     }
     else url->fragment.length = 0;
 
+    if (url->path.length && !(flags & WS_URL_FLAGS_NO_PATH_COLLAPSE) && has_dot_segment( url->path.chars, url->path.length ))
+    {
+        /* the decoded text may be the caller's own string, so collapse a copy */
+        WCHAR *copy;
+        hr = WS_E_QUOTA_EXCEEDED;
+        if (!(copy = ws_alloc( heap, url->path.length * sizeof(WCHAR) ))) goto done;
+        memcpy( copy, url->path.chars, url->path.length * sizeof(WCHAR) );
+        url->path.length = collapse_path( copy, url->path.length );
+        url->path.chars = copy;
+    }
+
+    if (flags & WS_URL_FLAGS_ZERO_TERMINATE)
+    {
+        hr = WS_E_QUOTA_EXCEEDED;
+        if (!zero_terminate( heap, &url->host ) || !zero_terminate( heap, &url->portAsString ) ||
+            !zero_terminate( heap, &url->path ) || !zero_terminate( heap, &url->query ) ||
+            !zero_terminate( heap, &url->fragment )) goto done;
+    }
+
     *ret = (WS_URL *)url;
     hr = S_OK;
 
@@ -437,11 +510,7 @@ HRESULT WINAPI WsEncodeUrl( const WS_URL *base, ULONG flags, WS_HEAP *heap, WS_S
     if (error) FIXME( "ignoring error parameter\n" );
 
