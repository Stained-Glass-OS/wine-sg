+        (hr = copy_msg_props( msg, WS_MESSAGE_PROPERTY_XML_READER_PROPERTIES, 1 )) != S_OK ||
+        (hr = copy_msg_props( msg, WS_MESSAGE_PROPERTY_XML_WRITER_PROPERTIES, 2 )) != S_OK)
     {
         free_msg( msg );
