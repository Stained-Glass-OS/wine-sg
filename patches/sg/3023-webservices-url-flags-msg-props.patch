     UuidCreate( &msg->id );
     msg->version_env  = env_version;
     msg->version_addr = addr_version;
@@ -382,13 +459,6 @@ HRESULT WINAPI WsGetMessageProperty( WS_MESSAGE *handle, WS_MESSAGE_PROPERTY_ID
         else *(BOOL *)buf = msg->is_addressed;
