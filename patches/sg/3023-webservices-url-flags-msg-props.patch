+        {
+            if (hp.properties[j].valueSize != sizeof(SIZE_T)) continue;
+            if (hp.properties[j].id == WS_HEAP_PROPERTY_MAX_SIZE) max_size = *(SIZE_T *)hp.properties[j].value;
+            else if (hp.properties[j].id == WS_HEAP_PROPERTY_TRIM_SIZE) trim_size = *(SIZE_T *)hp.properties[j].value;
+        }
+        if ((hr = WsCreateHeap( max_size, trim_size, NULL, 0, &msg->heap, NULL )) != S_OK)
+        {
+            free_msg( msg );
+            return hr;
+        }
+    }
