+/* The three property structures only point at the caller's arrays; keep a private copy of them. All of the
+ * heap, reader and writer property types are {id, value, valueSize}. */
+static HRESULT copy_msg_props( struct msg *msg, WS_MESSAGE_PROPERTY_ID id, ULONG slot )
+{
+    struct { WS_HEAP_PROPERTY *properties; ULONG propertyCount; } p;
+    WS_HEAP_PROPERTY *copy;
+    char *data;
+    ULONG i, size;
+
+    memset( &p, 0, sizeof(p) );
+    prop_get( msg->prop, msg->prop_count, id, &p, sizeof(p) );
+    if (!p.propertyCount || !p.properties) { memset( &p, 0, sizeof(p) ); goto done; }
+    size = p.propertyCount * sizeof(*copy);
+    for (i = 0; i < p.propertyCount; i++) size += p.properties[i].valueSize;
+    if (!(copy = malloc( size ))) return E_OUTOFMEMORY;
+    data = (char *)(copy + p.propertyCount);
+    for (i = 0; i < p.propertyCount; i++)
+    {
+        copy[i] = p.properties[i];
+        if (p.properties[i].valueSize && p.properties[i].value)
+        {
+            memcpy( data, p.properties[i].value, p.properties[i].valueSize );
+            copy[i].value = data;
+            data += p.properties[i].valueSize;
+        }
+    }
+    p.properties = copy;
+    msg->prop_copy[slot] = copy;
+done:
+    return prop_set( msg->prop, msg->prop_count, id, &p, sizeof(p) );
+}
+
+/* the writer and reader of a message honour the properties given when it was created */
+static HRESULT msg_create_writer( struct msg *msg )
+{
+    WS_XML_WRITER_PROPERTIES props;
+
+    memset( &props, 0, sizeof(props) );
+    prop_get( msg->prop, msg->prop_count, WS_MESSAGE_PROPERTY_XML_WRITER_PROPERTIES, &props, sizeof(props) );
+    return WsCreateWriter( props.properties, props.propertyCount, &msg->writer, NULL );
+}
+
+static HRESULT msg_create_reader( struct msg *msg )
+{
+    WS_XML_READER_PROPERTIES props;
+
+    memset( &props, 0, sizeof(props) );
+    prop_get( msg->prop, msg->prop_count, WS_MESSAGE_PROPERTY_XML_READER_PROPERTIES, &props, sizeof(props) );
+    return WsCreateReader( props.properties, props.propertyCount, &msg->reader, NULL );
+}
+
