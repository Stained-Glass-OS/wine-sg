+            { &GUID_WICPixelFormat32bppGrayFloat, -1, CHANNEL_FLOAT }, { &GUID_WICPixelFormat96bppRGBFloat, -1, CHANNEL_FLOAT },
+            { &GUID_WICPixelFormat128bppRGBFloat, -1, CHANNEL_FLOAT }, { &GUID_WICPixelFormat128bppRGBAFloat, 3, CHANNEL_FLOAT },
+            { &GUID_WICPixelFormat128bppPRGBAFloat, -1, CHANNEL_FLOAT },
+            { &GUID_WICPixelFormat16bppGrayHalf, -1, CHANNEL_HALF }, { &GUID_WICPixelFormat48bppRGBHalf, -1, CHANNEL_HALF },
+            { &GUID_WICPixelFormat64bppRGBHalf, -1, CHANNEL_HALF }, { &GUID_WICPixelFormat64bppRGBAHalf, 3, CHANNEL_HALF },
+            { &GUID_WICPixelFormat64bppPRGBAHalf, -1, CHANNEL_HALF },
+#endif
         };
         unsigned int i;
 
@@ -570,6 +659,7 @@
                 IWICBitmapSource_AddRef(pISource);
