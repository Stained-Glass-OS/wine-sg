+            { &GUID_WICPixelFormat48bppBGR, -1, CHANNEL_U16 }, { &GUID_WICPixelFormat64bppRGB, -1, CHANNEL_U16 },
+            { &GUID_WICPixelFormat64bppRGBA, 3, CHANNEL_U16 }, { &GUID_WICPixelFormat64bppBGRA, 3, CHANNEL_U16 },
