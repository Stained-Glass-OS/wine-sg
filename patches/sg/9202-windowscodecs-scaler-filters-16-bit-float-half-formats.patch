From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: the scaler filters 16-bit, float and half-float formats; their pixel format infos

9353 resampled formats of 8-bit channels only; the linear, cubic, Fant and
high quality cubic modes on 16-bit PNG/TIFF, JPEG XR and float images were
still nearest neighbour ("drawn as nearest neighbour"). The same separable
filter now reads and writes 16-bit unsigned, 32-bit float and 16-bit half
channels; the scaled source keeps its pixel format, as on Windows; float
values above 1.0 (HDR) are kept, integer channels clamped. 16bppGrayHalf,
48bppBGR, 64bppRGB, 64bppBGRA, 64bppPBGRA and 128bppRGBFloat had no pixel
format component info (CreateBitmapFromMemory E_FAIL); registered as Windows
lists them.
---
--- a/dlls/windowscodecs/scaler.c
+++ b/dlls/windowscodecs/scaler.c
@@ -45,6 +45,7 @@
     void (*fn_copy_scanline)(struct BitmapScaler*,UINT,UINT,UINT,BYTE**,UINT,UINT,BYTE*);
     BOOL filtered;      /* wine-sg 9353: linear, cubic, Fant or high quality cubic resampling */
     int alpha;          /* the channel of straight alpha, or -1 */
+    int channel;        /* wine-sg 9202: the channel type, enum scale_channel */
     BYTE *scaled;       /* the whole scaled image, made at the first CopyPixels */
     CRITICAL_SECTION lock; /* must be held when initialized */
 } BitmapScaler;
@@ -307,10 +308,81 @@
     free(taps);
 }
 
+/* wine-sg 9202: the channel types filtered; the scaled image keeps the source's pixel format */
+enum scale_channel { CHANNEL_U8, CHANNEL_U16, CHANNEL_FLOAT, CHANNEL_HALF };
+
+static UINT channel_bytes(int channel)
+{
+    switch (channel)
+    {
+    case CHANNEL_U16: case CHANNEL_HALF: return 2;
+    case CHANNEL_FLOAT: return 4;
+    default: return 1;
+    }
+}
+
+static float half_to_float(WORD h)
+{
+    UINT sign = (h >> 15) & 1, exp = (h >> 10) & 0x1f, mant = h & 0x3ff;
+    float v;
+
+    if (exp == 0) v = ldexpf((float)mant, -24);
+    else if (exp == 31)
+    {
+        union { UINT u; float f; } bits = { mant ? 0x7fc00000 : 0x7f800000 };
+        v = bits.f;
+    }
+    else v = ldexpf((float)(mant | 0x400), (int)exp - 25);
+    return sign ? -v : v;
+}
+
+static WORD float_to_half(float f)
+{
+    WORD sign = f < 0.0f ? 0x8000 : 0;
+    int exp;
+    float m;
+    UINT bits;
+
+    if (f != f) return 0x7e00;
+    f = fabsf(f);
+    if (f >= 65520.0f) return sign | 0x7c00;
+    if (f < ldexpf(1.0f, -14))
+        return sign | (WORD)lrintf(f * ldexpf(1.0f, 24));     /* subnormal (rounds up to the smallest normal) */
+    m = frexpf(f, &exp);                                      /* f = m * 2^exp, m in [0.5, 1) */
+    bits = (UINT)lrintf(m * 2048.0f);                         /* 11 significant bits */
+    if (bits == 2048) { bits = 1024; ++exp; }
+    if (exp + 14 >= 31) return sign | 0x7c00;
+    return sign | (WORD)((exp + 14) << 10) | (WORD)(bits & 0x3ff);
+}
+
+static float load_channel(const BYTE *p, int channel)
+{
+    switch (channel)
+    {
+    case CHANNEL_U16: return *(const WORD *)p;
+    case CHANNEL_FLOAT: return *(const float *)p;
+    case CHANNEL_HALF: return half_to_float(*(const WORD *)p);
+    default: return *p;
+    }
+}
+
+static void store_channel(BYTE *p, int channel, float v)
+{
+    switch (channel)
+    {
+    case CHANNEL_U16: *(WORD *)p = (WORD)min(max(v + 0.5f, 0.0f), 65535.0f); break;
+    case CHANNEL_FLOAT: *(float *)p = v; break;
+    case CHANNEL_HALF: *(WORD *)p = float_to_half(v); break;
+    default: *p = (BYTE)min(max(v + 0.5f, 0.0f), 255.0f); break;
+    }
+}
+
 static HRESULT scale_filtered(BitmapScaler *This)
 {
-    UINT n = This->bpp / 8, sw = This->src_width, sh = This->src_height, dw = This->width, dh = This->height;
-    UINT src_stride = sw * n, x, y, c;
+    UINT cb = channel_bytes(This->channel);
+    float one = This->channel == CHANNEL_U8 ? 255.0f : This->channel == CHANNEL_U16 ? 65535.0f : 1.0f;
+    UINT n = This->bpp / 8 / cb, sw = This->src_width, sh = This->src_height, dw = This->width, dh = This->height;
+    UINT src_stride = sw * n * cb, x, y, c;
     struct scale_taps *tx = NULL, *ty = NULL;
     float *rows = NULL, *acc = NULL;
     BYTE *src = NULL, *out = NULL;
@@ -318,7 +390,7 @@
     HRESULT hr;
     int k;
 
-    if (!(src = malloc((size_t)src_stride * sh)) || !(out = malloc((size_t)dw * dh * n))
+    if (!(src = malloc((size_t)src_stride * sh)) || !(out = malloc((size_t)dw * dh * n * cb))
             || !(rows = malloc((size_t)dw * sh * n * sizeof(float))) || !(acc = malloc((size_t)n * sizeof(float)))
             || !(tx = make_taps(sw, dw, This->mode)) || !(ty = make_taps(sh, dh, This->mode)))
     {
@@ -341,11 +413,15 @@
             for (k = 0; k < tx[x].count; ++k)
             {
                 int sx = min(max(tx[x].first + k, 0), (int)sw - 1);
-                const BYTE *p = line + (size_t)sx * n;
-                float wgt = tx[x].weights[k], a = This->alpha >= 0 ? p[This->alpha] / 255.0f : 1.0f;
+                const BYTE *p = line + (size_t)sx * n * cb;
+                float wgt = tx[x].weights[k];
+                float a = This->alpha >= 0 ? load_channel(p + This->alpha * cb, This->channel) / one : 1.0f;
 
                 for (c = 0; c < n; ++c)
-                    o[c] += wgt * ((int)c == This->alpha ? p[c] : p[c] * a);
+                {
+                    float v = load_channel(p + c * cb, This->channel);
+                    o[c] += wgt * ((int)c == This->alpha ? v : v * a);
+                }
             }
         }
     }
@@ -354,7 +430,7 @@
     {
         for (x = 0; x < dw; ++x)
         {
-            BYTE *d = out + ((size_t)y * dw + x) * n;
+            BYTE *d = out + ((size_t)y * dw + x) * n * cb;
 
             for (c = 0; c < n; ++c) acc[c] = 0.0f;
             for (k = 0; k < ty[y].count; ++k)
@@ -370,10 +446,10 @@
 
                 if (This->alpha >= 0 && (int)c != This->alpha)
                 {
-                    float a = acc[This->alpha] / 255.0f;
+                    float a = acc[This->alpha] / one;
                     v = a > 0.0f ? v / a : 0.0f;
                 }
-                d[c] = (BYTE)min(max(v + 0.5f, 0.0f), 255.0f);
+                store_channel(d + c * cb, This->channel, v);
             }
         }
     }
@@ -447,7 +523,7 @@
 
     if (This->filtered)
     {
-        UINT n = This->bpp / 8;
+        UINT n = This->bpp / 8; /* bytes per pixel */
 
         if (!This->scaled && FAILED(hr = scale_filtered(This))) goto end;
         for (y = 0; y < dest_rect.Height; ++y)
@@ -550,12 +626,25 @@
     if (SUCCEEDED(hr))
     {
         /* wine-sg 9353: the filtered modes for formats of 8-bit channels */
-        static const struct { const GUID *format; int alpha; } filterable[] = {
+        static const struct { const GUID *format; int alpha; int channel; } filterable[] = {
             { &GUID_WICPixelFormat24bppBGR, -1 }, { &GUID_WICPixelFormat24bppRGB, -1 },
             { &GUID_WICPixelFormat32bppBGR, -1 }, { &GUID_WICPixelFormat32bppRGB, -1 },
             { &GUID_WICPixelFormat32bppPBGRA, -1 }, { &GUID_WICPixelFormat32bppPRGBA, -1 },
             { &GUID_WICPixelFormat32bppBGRA, 3 }, { &GUID_WICPixelFormat32bppRGBA, 3 },
