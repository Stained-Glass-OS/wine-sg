         }
         ret = RegSetValueExW(shellFolderKey, value, 0, REG_SZ, (LPBYTE)path,
          (lstrlenW(path) + 1) * sizeof(WCHAR));
+        /* the path is right even where the cache cannot be written */
+        hr = S_OK;
