             WCHAR szTemp[MAX_PATH];
 
-            _SHExpandEnvironmentStrings(path, szTemp);
+            if (FAILED(_SHExpandEnvironmentStrings(path, szTemp)) || !szTemp[0])
+            {
+                /* never cache a path that did not expand: an empty
+                 * "Shell Folders" value breaks every later lookup */
+                RegCloseKey(shellFolderKey);
+                RegCloseKey(userShellFolderKey);
+                return E_FAIL;
+            }
