+static MUSIC_TIME pattern_length(const struct style_pattern *pattern)
+{
+    const DMUS_IO_TIMESIG *sig = &pattern->pattern.timeSig;
+    MUSIC_TIME beat = sig->bBeat ? DMUS_PPQ * 4 / sig->bBeat : DMUS_PPQ;
+
+    return max(pattern->pattern.wNbrMeasures, 1) * sig->bBeatsPerMeasure * beat;
 }
 
-static HRESULT WINAPI style_GetMotif(IDirectMusicStyle8 *iface, WCHAR *pwszName,
-        IDirectMusicSegment **ppSegment)
+/* A motif is played as a segment: a motif track holding the motif, the band of the motif in a
+ * band track, with the length, repeats, loop points and start point of the motif settings. */
+static HRESULT WINAPI style_GetMotif(IDirectMusicStyle8 *iface, WCHAR *name,
+        IDirectMusicSegment **ret_segment)
 {
     struct style *This = impl_from_IDirectMusicStyle8(iface);
-    FIXME("(%p, %s, %p): stub\n", This, debugstr_w(pwszName), ppSegment);
-    return S_FALSE;
+    const struct style_pattern *pattern;
+    IDirectMusicSegment *segment;
+    IDirectMusicTrack *track;
+    struct motif_info info = {{0}};
+    HRESULT hr;
+
+    TRACE("(%p, %s, %p)\n", This, debugstr_w(name), ret_segment);
+
+    if (!name || !ret_segment) return E_POINTER;
+
+    LIST_FOR_EACH_ENTRY(pattern, &This->patterns, struct style_pattern, entry)
+    {
+        if (!pattern_is_motif(pattern) || !(pattern->desc.dwValidData & DMUS_OBJ_NAME)) continue;
+        if (!lstrcmpiW(name, pattern->desc.wszName)) break;
+    }
+    if (&pattern->entry == &This->patterns) return DMUS_E_NOT_FOUND;
+
+    lstrcpynW(info.name, pattern->desc.wszName, DMUS_MAX_NAME);
+    info.pattern = pattern->pattern;
+    info.settings = pattern->settings;
+
+    if (FAILED(hr = CoCreateInstance(&CLSID_DirectMusicSegment, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IDirectMusicSegment, (void **)&segment)))
+        return hr;
+
+    hr = IDirectMusicSegment_SetLength(segment, pattern_length(pattern));
+#ifndef SG_MUTANT_MOTIF_REPEATS
+    if (SUCCEEDED(hr)) hr = IDirectMusicSegment_SetRepeats(segment, pattern->settings.dwRepeats);
+#endif
+    if (SUCCEEDED(hr) && pattern->settings.mtPlayStart)
+        hr = IDirectMusicSegment_SetStartPoint(segment, pattern->settings.mtPlayStart);
+    if (SUCCEEDED(hr) && pattern->settings.mtLoopEnd)
+        hr = IDirectMusicSegment_SetLoopPoints(segment, pattern->settings.mtLoopStart,
+                pattern->settings.mtLoopEnd);
+
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = create_motif_track_for(iface, &info, &track)))
+    {
+        hr = IDirectMusicSegment_InsertTrack(segment, track, 1);
+        IDirectMusicTrack_Release(track);
+    }
+
+    if (SUCCEEDED(hr) && pattern->band
+            && SUCCEEDED(CoCreateInstance(&CLSID_DirectMusicBandTrack, NULL, CLSCTX_INPROC_SERVER,
+                    &IID_IDirectMusicTrack, (void **)&track)))
+    {
+        DMUS_BAND_PARAM param = {0, pattern->band};
+
+        if (SUCCEEDED(IDirectMusicTrack_SetParam(track, &GUID_BandParam, 0, &param)))
+            hr = IDirectMusicSegment_InsertTrack(segment, track, 1);
+        IDirectMusicTrack_Release(track);
+    }
+
+    if (FAILED(hr))
+    {
+        IDirectMusicSegment_Release(segment);
+        return hr;
+    }
+
+    *ret_segment = segment;
+    return S_OK;
 }
 
