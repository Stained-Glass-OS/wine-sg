-static HRESULT WINAPI style_GetEmbellishmentLength(IDirectMusicStyle8 *iface,
-        DWORD dwType, DWORD dwLevel, DWORD *pdwMin, DWORD *pdwMax)
+/* the lengths (in measures) of the patterns of an embellishment (command) type for a groove level */
+static HRESULT WINAPI style_GetEmbellishmentLength(IDirectMusicStyle8 *iface, DWORD type,
+        DWORD level, DWORD *min, DWORD *max)
 {
     struct style *This = impl_from_IDirectMusicStyle8(iface);
-    FIXME("(%p, %ld, %ld, %p, %p): stub\n", This, dwType, dwLevel, pdwMin, pdwMax);
+    const struct style_pattern *pattern;
+    WORD embellishment;
+    BOOL found = FALSE;
+
+    TRACE("(%p, %lu, %lu, %p, %p)\n", This, type, level, min, max);
+
+    if (!min || !max) return E_POINTER;
+    *min = *max = 0;
+
+    switch (type)
+    {
+    case DMUS_COMMANDT_GROOVE: embellishment = DMUS_EMBELLISHT_NORMAL; break;
+    case DMUS_COMMANDT_FILL: embellishment = DMUS_EMBELLISHT_FILL; break;
+    case DMUS_COMMANDT_INTRO: embellishment = DMUS_EMBELLISHT_INTRO; break;
+    case DMUS_COMMANDT_BREAK: embellishment = DMUS_EMBELLISHT_BREAK; break;
+    case DMUS_COMMANDT_END: embellishment = DMUS_EMBELLISHT_END; break;
+    case DMUS_COMMANDT_ENDANDINTRO: embellishment = DMUS_EMBELLISHT_END | DMUS_EMBELLISHT_INTRO; break;
+    default: return E_INVALIDARG;
+    }
+
+    LIST_FOR_EACH_ENTRY(pattern, &This->patterns, struct style_pattern, entry)
+    {
+        DWORD length = pattern->pattern.wNbrMeasures;
+
+        if (pattern_is_motif(pattern)) continue;
+        if (embellishment ? !(pattern->pattern.wEmbellishment & embellishment)
+                : pattern->pattern.wEmbellishment) continue;
+#ifndef SG_MUTANT_LEVEL
+        if (level < pattern->pattern.bGrooveBottom || level > pattern->pattern.bGrooveTop) continue;
+#endif
+
+        if (!found || length < *min) *min = length;
+        if (!found || length > *max) *max = length;
+        found = TRUE;
+    }
     return S_OK;
 }
 
