From: Stained Glass OS <dev@stained-glass.example>
Subject: wineboot, msinfo32: lusrmgr.msc and fsmgmt.msc; msinfo32 /report waits

- wineboot writes lusrmgr.msc (Local Users and Groups) and fsmgmt.msc
  (Shared Folders) beside 0142's consoles, so `lusrmgr.msc` in the Run box,
  cmd or ShellExecute opens sg-shell's console as it does on Windows.
- msinfo32.exe's hand-off (0142) returned at once. With /report FILE or
  /nfo FILE it now waits for the System Information program and returns its
  exit code, as Windows' msinfo32 returns once the file is written -- scripts
  read the file next.

Gate: test/admintools-gate.sh (make test-admintools).
---
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1699,6 +1699,8 @@
         { L"devmgmt", L"Device Manager" },
         { L"diskmgmt", L"Disk Management" },
         { L"compmgmt", L"Computer Management" },
+        { L"lusrmgr", L"Local Users and Groups" },
+        { L"fsmgmt", L"Shared Folders" },
     };
     WCHAR dir[MAX_PATH], path[MAX_PATH];
     char buf[512], old[512];
--- a/programs/msinfo32/main.c
+++ b/programs/msinfo32/main.c
@@ -37,7 +37,7 @@
  * line's arguments instead -- programs run msinfo32 with CreateProcess, which
  * never reads App Paths. Never a program in a system directory: no loop. With
  * nothing registered, Wine's About box as before. */
-static BOOL hand_off( const WCHAR *name )
+static BOOL hand_off( const WCHAR *name, int argc, WCHAR *argv[], DWORD *code )
 {
     WCHAR key[MAX_PATH], target[MAX_PATH], self[MAX_PATH], dir[MAX_PATH], *cmd;
     const WCHAR *args = GetCommandLineW();
@@ -76,6 +76,19 @@
         return FALSE;
     }
     CloseHandle( pi.hThread );
+    /* msinfo32 /report FILE and /nfo FILE return once the file is written, as
+     * Windows' do (scripts read the file next): wait for the program then */
+    *code = 0;
+    for (i = 1; i < argc; i++)
+    {
+        const WCHAR *a = argv[i];
+        if ((a[0] == '/' || a[0] == '-') && (!wcsicmp( a + 1, L"report" ) || !wcsicmp( a + 1, L"nfo" )))
+        {
+            WaitForSingleObject( pi.hProcess, INFINITE );
+            GetExitCodeProcess( pi.hProcess, code );
+            break;
+        }
+    }
     CloseHandle( pi.hProcess );
     free( cmd );
     return TRUE;
@@ -84,9 +97,10 @@
 int __cdecl wmain(int argc, WCHAR *argv[])
 {
     int i;
+    DWORD code;
     WCHAR system_info[64];
 
-    if (hand_off( L"msinfo32.exe" )) return 0;
+    if (hand_off( L"msinfo32.exe", argc, argv, &code )) return code;
 
     InitCommonControls();
 
