+
+/* Enumerators over a snapshot (register words and input contexts) */
+enum enum_kind { ENUM_WORD_A, ENUM_WORD_W, ENUM_CONTEXT };
+
+struct snapshot_enum
+{
+    const void *const *lpVtbl;
+    LONG ref;
+    enum enum_kind kind;
+    void *items;      /* REGISTERWORDA[], REGISTERWORDW[] or HIMC[] */
+    ULONG count, pos;
+};
+
+static void snapshot_enum_free_items(enum enum_kind kind, void *items, ULONG count)
+{
+    ULONG i;
+
+    if (kind != ENUM_CONTEXT)
+    {
+        for (i = 0; i < count; i++)
+        {
+            if (kind == ENUM_WORD_A)
+            {
+                free(((REGISTERWORDA *)items)[i].lpReading);
+                free(((REGISTERWORDA *)items)[i].lpWord);
+            }
+            else
+            {
+                free(((REGISTERWORDW *)items)[i].lpReading);
+                free(((REGISTERWORDW *)items)[i].lpWord);
+            }
+        }
+    }
+    free(items);
+}
+
+static size_t snapshot_item_size(enum enum_kind kind)
+{
+    return kind == ENUM_WORD_A ? sizeof(REGISTERWORDA) : kind == ENUM_WORD_W ? sizeof(REGISTERWORDW) : sizeof(HIMC);
+}
+
+static HRESULT WINAPI snapshot_enum_QueryInterface(void *iface, REFIID iid, void **out)
+{
+    struct snapshot_enum *This = CONTAINING_RECORD(iface, struct snapshot_enum, lpVtbl);
+    const IID *own = This->kind == ENUM_WORD_A ? &IID_IEnumRegisterWordA :
+                     This->kind == ENUM_WORD_W ? &IID_IEnumRegisterWordW : &IID_IEnumInputContext;
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, own))
+    {
+        *out = &This->lpVtbl;
+        InterlockedIncrement(&This->ref);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI snapshot_enum_AddRef(void *iface)
+{
+    struct snapshot_enum *This = CONTAINING_RECORD(iface, struct snapshot_enum, lpVtbl);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI snapshot_enum_Release(void *iface)
+{
+    struct snapshot_enum *This = CONTAINING_RECORD(iface, struct snapshot_enum, lpVtbl);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        snapshot_enum_free_items(This->kind, This->items, This->count);
+        free(This);
+    }
+    return ref;
+}
+
+
+static char *dup_a(const char *str) { return str ? strdup(str) : NULL; }
+static WCHAR *dup_w(const WCHAR *str) { return str ? wcsdup(str) : NULL; }
+
+static const void *const snapshot_enum_vtbl[];
+
+static HRESULT snapshot_enum_create(enum enum_kind kind, const void *items, ULONG count, ULONG pos, void **out)
+{
+    struct snapshot_enum *This;
+    size_t size = snapshot_item_size(kind);
+    ULONG i;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    if (!(This->items = calloc(count ? count : 1, size)))
+    {
+        free(This);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(This->items, items, count * size);
+    /* the copy owns its strings */
+    for (i = 0; kind != ENUM_CONTEXT && i < count; i++)
+    {
+        if (kind == ENUM_WORD_A)
+        {
+            ((REGISTERWORDA *)This->items)[i].lpReading = dup_a(((REGISTERWORDA *)items)[i].lpReading);
+            ((REGISTERWORDA *)This->items)[i].lpWord = dup_a(((REGISTERWORDA *)items)[i].lpWord);
+        }
+        else
+        {
+            ((REGISTERWORDW *)This->items)[i].lpReading = dup_w(((REGISTERWORDW *)items)[i].lpReading);
+            ((REGISTERWORDW *)This->items)[i].lpWord = dup_w(((REGISTERWORDW *)items)[i].lpWord);
+        }
+    }
+    This->lpVtbl = snapshot_enum_vtbl;
+    This->ref = 1;
+    This->kind = kind;
+    This->count = count;
+    This->pos = pos;
+    *out = &This->lpVtbl;
+    return S_OK;
+}
+
+static HRESULT WINAPI snapshot_enum_Clone(void *iface, void **out)
+{
+    struct snapshot_enum *This = CONTAINING_RECORD(iface, struct snapshot_enum, lpVtbl);
+
+    if (!out) return E_INVALIDARG;
+    return snapshot_enum_create(This->kind, This->items, This->count, This->pos, out);
+}
+
+static HRESULT WINAPI snapshot_enum_Next(void *iface, ULONG count, void *items, ULONG *fetched)
+{
+    struct snapshot_enum *This = CONTAINING_RECORD(iface, struct snapshot_enum, lpVtbl);
+    size_t size = snapshot_item_size(This->kind);
+    ULONG n = 0;
+
+    if (fetched) *fetched = 0;
+    if (!items && count) return E_INVALIDARG;
+    while (n < count && This->pos < This->count)
+    {
+        BYTE *src = (BYTE *)This->items + This->pos * size, *dst = (BYTE *)items + n * size;
+
+        memcpy(dst, src, size);
+        /* the caller frees the strings with CoTaskMemFree */
+        if (This->kind == ENUM_WORD_A)
+        {
+            REGISTERWORDA *w = (REGISTERWORDA *)dst;
+            if (w->lpReading) { size_t l = strlen(w->lpReading) + 1; char *c = CoTaskMemAlloc(l); if (c) memcpy(c, w->lpReading, l); w->lpReading = c; }
+            if (w->lpWord) { size_t l = strlen(w->lpWord) + 1; char *c = CoTaskMemAlloc(l); if (c) memcpy(c, w->lpWord, l); w->lpWord = c; }
+        }
+        else if (This->kind == ENUM_WORD_W)
+        {
+            REGISTERWORDW *w = (REGISTERWORDW *)dst;
+            if (w->lpReading) { size_t l = (wcslen(w->lpReading) + 1) * sizeof(WCHAR); WCHAR *c = CoTaskMemAlloc(l); if (c) memcpy(c, w->lpReading, l); w->lpReading = c; }
+            if (w->lpWord) { size_t l = (wcslen(w->lpWord) + 1) * sizeof(WCHAR); WCHAR *c = CoTaskMemAlloc(l); if (c) memcpy(c, w->lpWord, l); w->lpWord = c; }
+        }
+        This->pos++;
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI snapshot_enum_Reset(void *iface)
+{
+    CONTAINING_RECORD(iface, struct snapshot_enum, lpVtbl)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI snapshot_enum_Skip(void *iface, ULONG count)
+{
+    struct snapshot_enum *This = CONTAINING_RECORD(iface, struct snapshot_enum, lpVtbl);
+
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static const void *const snapshot_enum_vtbl[] =
+{
+    snapshot_enum_QueryInterface, snapshot_enum_AddRef, snapshot_enum_Release,
+    snapshot_enum_Clone, snapshot_enum_Next, snapshot_enum_Reset, snapshot_enum_Skip,
+};
+
+struct collect
+{
+    enum enum_kind kind;
+    void *items;
+    ULONG count, size;
+};
+
+static BOOL collect_add(struct collect *c, const void *item)
+{
+    size_t size = snapshot_item_size(c->kind);
+
+    if (c->count == c->size)
+    {
+        ULONG new_size = c->size ? c->size * 2 : 16;
+        void *p = realloc(c->items, new_size * size);
+
+        if (!p) return FALSE;
+        c->items = p;
+        c->size = new_size;
+    }
+    memcpy((BYTE *)c->items + c->count * size, item, size);
+    c->count++;
+    return TRUE;
+}
+
+static int CALLBACK collect_word_a(const char *reading, DWORD style, const char *word, void *param)
+{
+    REGISTERWORDA w = { dup_a(reading), dup_a(word) };
+    return collect_add(param, &w);
+}
+
+static int CALLBACK collect_word_w(const WCHAR *reading, DWORD style, const WCHAR *word, void *param)
+{
+    REGISTERWORDW w = { dup_w(reading), dup_w(word) };
+    return collect_add(param, &w);
+}
+
+static BOOL CALLBACK collect_context(HIMC himc, LPARAM param)
+{
+    return collect_add((struct collect *)param, &himc);
+}
+
+static HRESULT collect_create(struct collect *c, void **out)
+{
+    HRESULT hr = snapshot_enum_create(c->kind, c->items, c->count, 0, out);
+
+    snapshot_enum_free_items(c->kind, c->items, c->count);
+    return hr;
+}
+
