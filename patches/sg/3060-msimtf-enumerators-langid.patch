         REFIID iid, LPVOID *ppvOut)
 {
@@ -152,16 +386,26 @@ static HRESULT WINAPI ActiveIMMApp_EnumRegisterWordA(IActiveIMMApp* This,
         HKL hKL, LPSTR szReading, DWORD dwStyle, LPSTR szRegister,
         LPVOID pData, IEnumRegisterWordA **pEnum)
 {
-    FIXME("Stub\n");
-    return E_NOTIMPL;
+    struct collect c = { ENUM_WORD_A };
+
+    TRACE("%p %s %lu %s %p %p\n", hKL, debugstr_a(szReading), dwStyle, debugstr_a(szRegister), pData, pEnum);
+
+    if (!pEnum) return E_INVALIDARG;
+    ImmEnumRegisterWordA(hKL, collect_word_a, szReading, dwStyle, szRegister, &c);
+    return collect_create(&c, (void **)pEnum);
 }
 
