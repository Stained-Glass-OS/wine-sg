+/* What GDI+ writes for a line drawn on an EMF-only metafile. Windows uses a geometric pen and a
+ * single EMR_POLYLINE16; we draw the stroke through a path, so only the records both have are
+ * required, in order, and the polyline is a todo. */
+static const DWORD emfonly_draw_types[] = {
+    EMR_SAVEDC, EMR_EXTCREATEPEN, EMR_SELECTOBJECT, EMR_DELETEOBJECT, EMR_RESTOREDC
+};
+
+struct collect_types
+{
+    DWORD types[128];
+    int count;
 };
 
+static BOOL CALLBACK collect_types_proc(EmfPlusRecordType record_type, unsigned int flags,
+    unsigned int dataSize, const unsigned char *pStr, void *userdata)
+{
+    struct collect_types *c = userdata;
+
+    if (c->count < ARRAY_SIZE(c->types))
+        c->types[c->count++] = record_type;
+    return TRUE;
+}
+
+static void check_emfonly_draw(GpMetafile *metafile, const GpPointF *dst_points, const GpRectF *frame)
+{
+    struct collect_types c = { { 0 }, 0 };
+    GpGraphics *graphics;
+    HDC hdc;
+    GpStatus stat;
+    int i, next = 0;
+    BOOL polyline = FALSE;
+
+    hdc = CreateCompatibleDC(0);
+    stat = GdipCreateFromHDC(hdc, &graphics);
+    expect(Ok, stat);
+    stat = GdipEnumerateMetafileSrcRectDestPoints(graphics, metafile, dst_points, 3, frame, UnitPixel,
+        collect_types_proc, &c, NULL);
+    expect(Ok, stat);
+    GdipDeleteGraphics(graphics);
+    DeleteDC(hdc);
+
+    ok(c.count > 2, "emfonly draw: got %i records\n", c.count);
+    if (c.count < 2) return;
+    ok(c.types[0] == EMR_HEADER, "emfonly draw: first record 0x%lx\n", c.types[0]);
+    ok(c.types[c.count - 1] == EMR_EOF, "emfonly draw: last record 0x%lx\n", c.types[c.count - 1]);
+    for (i = 0; i < c.count; i++)
+    {
+        if (next < ARRAY_SIZE(emfonly_draw_types) && c.types[i] == emfonly_draw_types[next]) next++;
+        if (c.types[i] == EMR_POLYLINE16) polyline = TRUE;
+    }
+    ok(next == ARRAY_SIZE(emfonly_draw_types), "emfonly draw: records found up to %i of %i\n", next,
+        (int)ARRAY_SIZE(emfonly_draw_types));
+    todo_wine ok(polyline, "emfonly draw: no EMR_POLYLINE16\n");
+}
