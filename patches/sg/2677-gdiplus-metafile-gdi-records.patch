+/*
+ * An EMF-only recording is made of GDI records, and an EMF+ dual one carries
+ * the GDI records of everything it draws beside the EMF+ records, for the
+ * programs that can only play GDI. A graphics object of our own on the
+ * recording device context draws them; it takes its state from the graphics
+ * object the program draws with. Returns NULL for the other kinds.
+ */
+GpGraphics *METAFILE_GetGdiGraphics(GpMetafile *metafile, const GpGraphics *state)
+{
+    GpGraphics *gdi;
+
+    if (metafile->metafile_type != MetafileTypeEmf && metafile->metafile_type != MetafileTypeEmfPlusDual)
+        return NULL;
+    if (!metafile->record_dc)
+        return NULL;
+#ifdef SG_MUTANT_DUAL_NO_GDI
+    if (metafile->metafile_type == MetafileTypeEmfPlusDual) return NULL;
+#endif
+#ifdef SG_MUTANT_EMFONLY_NO_GDI
+    if (metafile->metafile_type == MetafileTypeEmf) return NULL;
+#endif
+
+    if (!metafile->gdi_graphics &&
+            GdipCreateFromHDC(metafile->record_dc, &metafile->gdi_graphics) != Ok)
+        return NULL;
+
+    gdi = metafile->gdi_graphics;
+    gdi->unit = state->unit;
+    gdi->scale = state->scale;
+#ifndef SG_MUTANT_DUAL_NO_STATE
+    gdi->worldtrans = state->worldtrans;
+#endif
+    gdi->smoothing = state->smoothing;
+    gdi->compqual = state->compqual;
+    gdi->interpolation = state->interpolation;
+    gdi->pixeloffset = state->pixeloffset;
+    gdi->compmode = state->compmode;
+    gdi->texthint = state->texthint;
+    gdi->origin_x = state->origin_x;
+    gdi->origin_y = state->origin_y;
+#ifndef SG_MUTANT_DUAL_NO_STATE
+    if (state->clip)
+        GdipCombineRegionRegion(gdi->clip, state->clip, CombineModeReplace);
+#endif
+    return gdi;
+}
