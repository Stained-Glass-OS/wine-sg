From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: the Horizon and Glass caption buttons in the middle of the title bar

Wine puts a window's caption buttons 2 px below the top of its caption.
The Horizon and Glass frames (0742) draw the title bar across the frame's
top edge too -- 7 px of it in Glass -- so the buttons sat low in the bar
as it is seen (David 2026-10-02: "The glass look exit, maximize and min
buttons seem not quite centered vertically on the window decoration").
They are drawn in the middle of the band from the window's top to the
caption's bottom; hit-testing goes by the caption's columns and is
unchanged. Test: test/eraframes-gate.sh (mutant SG_MUTANT_BUTTONS_LOW).
---
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -1734,6 +1734,27 @@
     band->bottom = inside.top + get_system_metrics( (ex_style & WS_EX_TOOLWINDOW) ? SM_CYSMCAPTION : SM_CYCAPTION );
 }
 
+/* Stained Glass OS: a caption button of the Horizon or Glass frame, in the
+ * middle of the title bar as it is seen -- the frame's top edge and the
+ * caption together. Wine puts the buttons 2 px below the top of the caption,
+ * under the frame's top edge (7 px in Glass), so they sat low in the bar
+ * (David 2026-10-02: "not quite centered vertically"). Only drawn there:
+ * hit-testing goes by the caption's columns. */
+static void sg_era_button_rect( HWND hwnd, RECT *rect, DWORD style, DWORD ex_style )
+{
+    RECT inside;
+    int band, h = rect->bottom - rect->top;
+
+#ifdef SG_MUTANT_BUTTONS_LOW
+    return;
+#endif
+    if (!sg_frame_style_for( hwnd, style, ex_style, TRUE ) || (ex_style & WS_EX_TOOLWINDOW)) return;
+    get_inside_rect( hwnd, COORDS_WINDOW, &inside, style, ex_style );
+    band = inside.top + get_system_metrics( SM_CYCAPTION );   /* the window's top (0) to the caption's bottom */
+    rect->top = (band - h) / 2;
+    rect->bottom = rect->top + h;
+}
+
 /* a caption button of the look: its slice of the title bar, then a rounded
  * button with its glyph */
 static void sg_frame_button( HWND hwnd, HDC hdc, const RECT *r, UINT flags, const struct sg_frame_style *fs )
@@ -2075,6 +2096,7 @@
         rect.right -= 2;
     }
 
+    sg_era_button_rect( hwnd, &rect, style, ex_style );
     if (down) flags |= DFCS_PUSHED;
     if (grayed) flags |= DFCS_INACTIVE;
     sg_draw_caption_button( hwnd, hdc, &rect, flags );
@@ -2098,6 +2120,7 @@
     rect.bottom = rect.top + get_system_metrics( SM_CYSIZE ) - 2;
     rect.top += 2;
     rect.right -= 2;
+    sg_era_button_rect( hwnd, &rect, style, ex_style );
     if (down) flags |= DFCS_PUSHED;
     if (grayed) flags |= DFCS_INACTIVE;
     sg_draw_caption_button( hwnd, hdc, &rect, flags );
@@ -2124,6 +2147,7 @@
     rect.bottom = rect.top + get_system_metrics( SM_CYSIZE ) - 2;
     rect.top += 2;
     rect.right -= 2;
+    sg_era_button_rect( hwnd, &rect, style, ex_style );
     if (down) flags |= DFCS_PUSHED;
     if (grayed) flags |= DFCS_INACTIVE;
     sg_draw_caption_button( hwnd, hdc, &rect, flags );
