new file mode 100644
index 0000000..2aa7449
--- /dev/null
+++ b/dlls/sgd3dinterop/main.c
@@ -0,0 +1,385 @@
+/*
+ * DXGI <-> Windows.Graphics.DirectX.Direct3D11 interop (wine-sg 7854)
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * CreateDirect3D11DeviceFromDXGIDevice and CreateDirect3D11SurfaceFromDXGISurface (d3d11.dll's on
+ * Windows): a DXGI device or surface wrapped as the WinRT IDirect3DDevice / IDirect3DSurface that
+ * Windows.Graphics.Capture, MediaCapture and the composition APIs take, with
+ * IDirect3DDxgiInterfaceAccess to get the DXGI/D3D11 object back and IClosable to let it go. Here so
+ * that every d3d11.dll -- Wine's and DXVK's (sg-d3d), which forward these exports -- has the same
+ * one: OBS's, PotPlayer's and Zoom's capture plugins import them.
+ */
+
+#define COBJMACROS
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winstring.h"
+#include "objbase.h"
+#include "dxgi1_3.h"
+#include "initguid.h"
+#include "inspectable.h"
+#include "roapi.h"
+
+#define WIDL_using_Windows_Foundation
+#define WIDL_using_Windows_Graphics_DirectX
+#define WIDL_using_Windows_Graphics_DirectX_Direct3D11
+#include "windows.foundation.h"
+#include "windows.graphics.directx.direct3d11.h"
+#include "windows.graphics.directx.direct3d11.interop.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3d11);
+
+#ifndef RO_E_CLOSED
+#define RO_E_CLOSED ((HRESULT)0x80000013)
+#endif
+
+struct wrapper
+{
+    IInspectable IInspectable_iface;          /* IDirect3DDevice or IDirect3DSurface */
+    IClosable IClosable_iface;
+    IDirect3DDxgiInterfaceAccess IDirect3DDxgiInterfaceAccess_iface;
+    const GUID *iid;                          /* which of the two */
+    const WCHAR *class_name;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    IUnknown *dxgi;                           /* the IDXGIDevice / IDXGISurface; NULL once closed */
+};
+
+static struct wrapper *impl_from_IInspectable( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct wrapper, IInspectable_iface );
+}
+
+static HRESULT WINAPI wrapper_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct wrapper *impl = impl_from_IInspectable( iface );
+
+    TRACE( "(%p, %s, %p)\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->iid ))
+        *out = &impl->IInspectable_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else if (IsEqualGUID( iid, &IID_IDirect3DDxgiInterfaceAccess ))
+        *out = &impl->IDirect3DDxgiInterfaceAccess_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI wrapper_AddRef( IInspectable *iface )
+{
+    struct wrapper *impl = impl_from_IInspectable( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "(%p) -> %lu\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI wrapper_Release( IInspectable *iface )
+{
+    struct wrapper *impl = impl_from_IInspectable( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "(%p) -> %lu\n", iface, ref );
+    if (!ref)
+    {
+        if (impl->dxgi) IUnknown_Release( impl->dxgi );
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI wrapper_GetIids( IInspectable *iface, ULONG *count, IID **iids )
+{
+    struct wrapper *impl = impl_from_IInspectable( iface );
+
+    TRACE( "(%p, %p, %p)\n", iface, count, iids );
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( 2 * sizeof(IID) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = *impl->iid;
+    (*iids)[1] = IID_IClosable;
+    *count = 2;
+    return S_OK;
+}
+
+static HRESULT WINAPI wrapper_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    struct wrapper *impl = impl_from_IInspectable( iface );
+    TRACE( "(%p, %p)\n", iface, name );
+    return WindowsCreateString( impl->class_name, wcslen( impl->class_name ), name );
+}
+
+static HRESULT WINAPI wrapper_GetTrustLevel( IInspectable *iface, TrustLevel *level )
+{
+    TRACE( "(%p, %p)\n", iface, level );
+    *level = BaseTrust;
+    return S_OK;
+}
+
+/* the DXGI object, or NULL once closed (a reference the caller releases) */
+static IUnknown *get_dxgi( struct wrapper *impl )
+{
+    IUnknown *ret;
+
+    EnterCriticalSection( &impl->cs );
+    if ((ret = impl->dxgi)) IUnknown_AddRef( ret );
+    LeaveCriticalSection( &impl->cs );
+    return ret;
+}
+
+/* IDirect3DDevice */
+static HRESULT WINAPI device_Trim( IDirect3DDevice *iface )
+{
+    struct wrapper *impl = impl_from_IInspectable( (IInspectable *)iface );
+    IDXGIDevice3 *device3;
+    IUnknown *dxgi;
+
+    TRACE( "(%p)\n", iface );
+    if (!(dxgi = get_dxgi( impl ))) return RO_E_CLOSED;
+    if (SUCCEEDED(IUnknown_QueryInterface( dxgi, &IID_IDXGIDevice3, (void **)&device3 )))
+    {
+        IDXGIDevice3_Trim( device3 );
+        IDXGIDevice3_Release( device3 );
+    }
+    IUnknown_Release( dxgi );
+    return S_OK;
+}
+
+static const struct IDirect3DDeviceVtbl device_vtbl =
+{
+    (void *)wrapper_QueryInterface,
+    (void *)wrapper_AddRef,
+    (void *)wrapper_Release,
+    (void *)wrapper_GetIids,
+    (void *)wrapper_GetRuntimeClassName,
+    (void *)wrapper_GetTrustLevel,
+    device_Trim,
+};
+
+/* IDirect3DSurface */
+static HRESULT WINAPI surface_get_Description( IDirect3DSurface *iface, Direct3DSurfaceDescription *value )
+{
+    struct wrapper *impl = impl_from_IInspectable( (IInspectable *)iface );
+    IDXGISurface *surface;
+    DXGI_SURFACE_DESC desc;
+    IUnknown *dxgi;
+    HRESULT hr;
+
+    TRACE( "(%p, %p)\n", iface, value );
+    if (!value) return E_POINTER;
+    if (!(dxgi = get_dxgi( impl ))) return RO_E_CLOSED;
+    if (SUCCEEDED(hr = IUnknown_QueryInterface( dxgi, &IID_IDXGISurface, (void **)&surface )))
+    {
+        if (SUCCEEDED(hr = IDXGISurface_GetDesc( surface, &desc )))
+        {
+            value->Width = desc.Width;
+            value->Height = desc.Height;
+            /* DirectXPixelFormat has DXGI_FORMAT's values */
+            value->Format = (DirectXPixelFormat)desc.Format;
+            value->MultisampleDescription.Count = desc.SampleDesc.Count;
+            value->MultisampleDescription.Quality = desc.SampleDesc.Quality;
+        }
+        IDXGISurface_Release( surface );
+    }
+    IUnknown_Release( dxgi );
+    return hr;
+}
+
+static const struct IDirect3DSurfaceVtbl surface_vtbl =
+{
+    (void *)wrapper_QueryInterface,
+    (void *)wrapper_AddRef,
+    (void *)wrapper_Release,
+    (void *)wrapper_GetIids,
+    (void *)wrapper_GetRuntimeClassName,
+    (void *)wrapper_GetTrustLevel,
+    surface_get_Description,
+};
+
+/* IClosable: the DXGI object is let go; the wrapper answers RO_E_CLOSED from then on */
+static struct wrapper *impl_from_IClosable( IClosable *iface )
+{
+    return CONTAINING_RECORD( iface, struct wrapper, IClosable_iface );
+}
+
+static HRESULT WINAPI closable_QueryInterface( IClosable *iface, REFIID iid, void **out )
+{
+    return wrapper_QueryInterface( &impl_from_IClosable( iface )->IInspectable_iface, iid, out );
+}
+
+static ULONG WINAPI closable_AddRef( IClosable *iface )
+{
+    return wrapper_AddRef( &impl_from_IClosable( iface )->IInspectable_iface );
+}
+
+static ULONG WINAPI closable_Release( IClosable *iface )
+{
+    return wrapper_Release( &impl_from_IClosable( iface )->IInspectable_iface );
+}
+
+static HRESULT WINAPI closable_GetIids( IClosable *iface, ULONG *count, IID **iids )
+{
+    return wrapper_GetIids( &impl_from_IClosable( iface )->IInspectable_iface, count, iids );
+}
+
+static HRESULT WINAPI closable_GetRuntimeClassName( IClosable *iface, HSTRING *name )
+{
+    return wrapper_GetRuntimeClassName( &impl_from_IClosable( iface )->IInspectable_iface, name );
+}
+
+static HRESULT WINAPI closable_GetTrustLevel( IClosable *iface, TrustLevel *level )
+{
+    return wrapper_GetTrustLevel( &impl_from_IClosable( iface )->IInspectable_iface, level );
+}
+
+static HRESULT WINAPI closable_Close( IClosable *iface )
+{
+    struct wrapper *impl = impl_from_IClosable( iface );
+    IUnknown *dxgi;
+
+    TRACE( "(%p)\n", iface );
+    EnterCriticalSection( &impl->cs );
+    dxgi = impl->dxgi;
+    impl->dxgi = NULL;
+    LeaveCriticalSection( &impl->cs );
+#ifndef SG_MUTANT_D3DINTEROP_CLOSE_KEEPS
+    if (dxgi) IUnknown_Release( dxgi );
+#else
+    EnterCriticalSection( &impl->cs );
+    impl->dxgi = dxgi;
+    LeaveCriticalSection( &impl->cs );
+#endif
+    return S_OK;
+}
+
+static const struct IClosableVtbl closable_vtbl =
+{
+    closable_QueryInterface,
+    closable_AddRef,
+    closable_Release,
+    closable_GetIids,
+    closable_GetRuntimeClassName,
+    closable_GetTrustLevel,
+    closable_Close,
+};
+
+/* IDirect3DDxgiInterfaceAccess: the DXGI or Direct3D 11 interface asked for */
+static struct wrapper *impl_from_IDirect3DDxgiInterfaceAccess( IDirect3DDxgiInterfaceAccess *iface )
+{
+    return CONTAINING_RECORD( iface, struct wrapper, IDirect3DDxgiInterfaceAccess_iface );
+}
+
+static HRESULT WINAPI access_QueryInterface( IDirect3DDxgiInterfaceAccess *iface, REFIID iid, void **out )
+{
+    return wrapper_QueryInterface( &impl_from_IDirect3DDxgiInterfaceAccess( iface )->IInspectable_iface, iid, out );
+}
+
+static ULONG WINAPI access_AddRef( IDirect3DDxgiInterfaceAccess *iface )
+{
+    return wrapper_AddRef( &impl_from_IDirect3DDxgiInterfaceAccess( iface )->IInspectable_iface );
+}
+
+static ULONG WINAPI access_Release( IDirect3DDxgiInterfaceAccess *iface )
+{
+    return wrapper_Release( &impl_from_IDirect3DDxgiInterfaceAccess( iface )->IInspectable_iface );
+}
+
+static HRESULT WINAPI access_GetInterface( IDirect3DDxgiInterfaceAccess *iface, REFIID iid, void **out )
+{
+    struct wrapper *impl = impl_from_IDirect3DDxgiInterfaceAccess( iface );
+    IUnknown *dxgi;
+    HRESULT hr;
+
+    TRACE( "(%p, %s, %p)\n", iface, debugstr_guid( iid ), out );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(dxgi = get_dxgi( impl ))) return RO_E_CLOSED;
+    hr = IUnknown_QueryInterface( dxgi, iid, out );
+    IUnknown_Release( dxgi );
+    return hr;
+}
+
+static const struct IDirect3DDxgiInterfaceAccessVtbl access_vtbl =
+{
+    access_QueryInterface,
+    access_AddRef,
+    access_Release,
+    access_GetInterface,
+};
+
+static HRESULT create_wrapper( IUnknown *dxgi, REFIID dxgi_iid, const void *vtbl, const GUID *iid,
+                               const WCHAR *class_name, IInspectable **out )
+{
+    struct wrapper *impl;
+    IUnknown *held;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!dxgi) return E_INVALIDARG;
+    /* the caller's object must be what it says: a DXGI device or surface */
+    if (FAILED(hr = IUnknown_QueryInterface( dxgi, dxgi_iid, (void **)&held ))) return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        IUnknown_Release( held );
+        return E_OUTOFMEMORY;
+    }
+    impl->IInspectable_iface.lpVtbl = vtbl;
+    impl->IClosable_iface.lpVtbl = &closable_vtbl;
+    impl->IDirect3DDxgiInterfaceAccess_iface.lpVtbl = &access_vtbl;
+    impl->iid = iid;
+    impl->class_name = class_name;
+    impl->ref = 1;
+    impl->dxgi = held;
+    InitializeCriticalSection( &impl->cs );
+    *out = &impl->IInspectable_iface;
+    TRACE( "%p wraps %p\n", impl, held );
+    return S_OK;
+}
+
+/***********************************************************************
+ *      CreateDirect3D11DeviceFromDXGIDevice (SGD3DINTEROP.@, d3d11.@)
+ */
+HRESULT WINAPI CreateDirect3D11DeviceFromDXGIDevice( IDXGIDevice *device, IInspectable **graphics_device )
+{
+    TRACE( "(%p, %p)\n", device, graphics_device );
+    return create_wrapper( (IUnknown *)device, &IID_IDXGIDevice, &device_vtbl, &IID_IDirect3DDevice,
+                           L"Windows.Graphics.DirectX.Direct3D11.IDirect3DDevice", graphics_device );
+}
+
+/***********************************************************************
+ *      CreateDirect3D11SurfaceFromDXGISurface (SGD3DINTEROP.@, d3d11.@)
+ */
+HRESULT WINAPI CreateDirect3D11SurfaceFromDXGISurface( IDXGISurface *surface, IInspectable **graphics_surface )
+{
+    TRACE( "(%p, %p)\n", surface, graphics_surface );
+    return create_wrapper( (IUnknown *)surface, &IID_IDXGISurface, &surface_vtbl, &IID_IDirect3DSurface,
+                           L"Windows.Graphics.DirectX.Direct3D11.IDirect3DSurface", graphics_surface );
+}
