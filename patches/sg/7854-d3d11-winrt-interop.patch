+/* Interop between DXGI and the Windows.Graphics.DirectX.Direct3D11 WinRT types
+ * (windows.graphics.directx.direct3d11.interop.h in the Windows SDK). */
+
+import "inspectable.idl";
+import "dxgi.idl";
+
+[
+    object,
+    uuid(a9b3d012-3df2-4ee3-b8d1-8695f457d3c1),
+    local
+]
+interface IDirect3DDxgiInterfaceAccess : IUnknown
+{
+    HRESULT GetInterface([in] REFIID iid, [out, iid_is(iid)] void **object);
+}
+
+cpp_quote("HRESULT WINAPI CreateDirect3D11DeviceFromDXGIDevice(IDXGIDevice *device, IInspectable **graphics_device);")
+cpp_quote("HRESULT WINAPI CreateDirect3D11SurfaceFromDXGISurface(IDXGISurface *surface, IInspectable **graphics_surface);")
