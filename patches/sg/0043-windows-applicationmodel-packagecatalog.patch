+/*
+ * The catalog reports packages being staged, installed, updated, removed or
+ * changing status. Package tools (winget's installed-packages source) open it
+ * for the current user and subscribe to those events. Subscriptions are kept
+ * and can be removed; nothing raises them yet, because nothing deploys
+ * packages yet; Windows.Management.Deployment will raise them when it
+ * deploys.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "appmodel.h"
+#include "weakreference.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(model);
+
+enum catalog_event { EV_STAGING, EV_INSTALLING, EV_UPDATING, EV_UNINSTALLING, EV_STATUS, EV_COUNT };
+
+struct handler_entry
+{
+    IUnknown *handler;
+    INT64 token;
+};
+
+struct weak_ref;
+
+struct package_catalog
+{
+    IPackageCatalog IPackageCatalog_iface;
+    IWeakReferenceSource IWeakReferenceSource_iface;
+    LONG ref;
+    struct weak_ref *weak;
+    CRITICAL_SECTION cs;
+    struct handler_entry *handlers[EV_COUNT];
+    unsigned int count[EV_COUNT];
+};
+
+static LONG64 next_token = 1;
+
+static inline struct package_catalog *impl_from_IPackageCatalog( IPackageCatalog *iface )
+{
+    return CONTAINING_RECORD( iface, struct package_catalog, IPackageCatalog_iface );
+}
+
+/* ---- weak references ------------------------------------------------------
+ * C++/WinRT takes a weak reference to an event source to revoke its handlers
+ * automatically. A weak reference resolves only while the catalog still has
+ * strong references; the catalog clears the link, under weak_cs, before it is
+ * freed. */
+
+static CRITICAL_SECTION weak_cs;
+static CRITICAL_SECTION_DEBUG weak_cs_debug =
+{
+    0, 0, &weak_cs,
+    { &weak_cs_debug.ProcessLocksList, &weak_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": weak_cs") }
+};
+static CRITICAL_SECTION weak_cs = { &weak_cs_debug, -1, 0, 0, 0, 0 };
+
+struct weak_ref
+{
+    IWeakReference IWeakReference_iface;
+    LONG ref;
+    struct package_catalog *target;
+};
+
+static inline struct weak_ref *impl_from_IWeakReference( IWeakReference *iface )
+{
+    return CONTAINING_RECORD( iface, struct weak_ref, IWeakReference_iface );
+}
+
+static HRESULT WINAPI weak_ref_QueryInterface( IWeakReference *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference ))
+    {
+        *out = iface;
+        IWeakReference_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI weak_ref_AddRef( IWeakReference *iface )
+{
+    return InterlockedIncrement( &impl_from_IWeakReference( iface )->ref );
+}
+
+static ULONG WINAPI weak_ref_Release( IWeakReference *iface )
+{
+    struct weak_ref *impl = impl_from_IWeakReference( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI weak_ref_Resolve( IWeakReference *iface, REFIID iid, IInspectable **out )
+{
+    struct weak_ref *impl = impl_from_IWeakReference( iface );
+    struct package_catalog *target;
+    HRESULT hr;
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    EnterCriticalSection( &weak_cs );
+    if ((target = impl->target))
+    {
+        /* take a strong reference, but never revive one that reached zero */
+        for (;;)
+        {
+            LONG ref = target->ref;
+            if (!ref) { target = NULL; break; }
+            if (InterlockedCompareExchange( &target->ref, ref + 1, ref ) == ref) break;
+        }
+    }
+    LeaveCriticalSection( &weak_cs );
+    if (!target) return S_OK;   /* gone: a null reference, not an error */
+    hr = IPackageCatalog_QueryInterface( &target->IPackageCatalog_iface, iid, (void **)out );
+    IPackageCatalog_Release( &target->IPackageCatalog_iface );
+    return hr;
+}
+
+static const struct IWeakReferenceVtbl weak_ref_vtbl =
+{
+    weak_ref_QueryInterface,
+    weak_ref_AddRef,
+    weak_ref_Release,
+    weak_ref_Resolve,
+};
+
+static inline struct package_catalog *impl_from_IWeakReferenceSource( IWeakReferenceSource *iface )
+{
+    return CONTAINING_RECORD( iface, struct package_catalog, IWeakReferenceSource_iface );
+}
+
+static HRESULT WINAPI weak_source_QueryInterface( IWeakReferenceSource *iface, REFIID iid, void **out )
+{
+    return IPackageCatalog_QueryInterface( &impl_from_IWeakReferenceSource( iface )->IPackageCatalog_iface, iid, out );
+}
+
+static ULONG WINAPI weak_source_AddRef( IWeakReferenceSource *iface )
+{
+    return IPackageCatalog_AddRef( &impl_from_IWeakReferenceSource( iface )->IPackageCatalog_iface );
+}
+
+static ULONG WINAPI weak_source_Release( IWeakReferenceSource *iface )
+{
+    return IPackageCatalog_Release( &impl_from_IWeakReferenceSource( iface )->IPackageCatalog_iface );
+}
+
+static HRESULT WINAPI weak_source_GetWeakReference( IWeakReferenceSource *iface, IWeakReference **out )
+{
+    struct package_catalog *impl = impl_from_IWeakReferenceSource( iface );
+    struct weak_ref *weak;
+
+    TRACE( "iface %p, out %p.\n", iface, out );
+    if (!out) return E_POINTER;
+    EnterCriticalSection( &weak_cs );
+    if (!(weak = impl->weak) && (weak = calloc( 1, sizeof(*weak) )))
+    {
+        weak->IWeakReference_iface.lpVtbl = &weak_ref_vtbl;
+        weak->ref = 1;             /* the catalog's own */
+        weak->target = impl;
+        impl->weak = weak;
+    }
+    if (weak) IWeakReference_AddRef( &weak->IWeakReference_iface );
+    LeaveCriticalSection( &weak_cs );
+    if (!weak) return E_OUTOFMEMORY;
+    *out = &weak->IWeakReference_iface;
+    return S_OK;
+}
+
+static const struct IWeakReferenceSourceVtbl weak_source_vtbl =
+{
+    weak_source_QueryInterface,
+    weak_source_AddRef,
+    weak_source_Release,
+    weak_source_GetWeakReference,
+};
+
+static HRESULT WINAPI catalog_QueryInterface( IPackageCatalog *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IPackageCatalog ))
+    {
+        *out = iface;
+        IPackageCatalog_AddRef( iface );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IWeakReferenceSource ))
+    {
+        *out = &impl_from_IPackageCatalog( iface )->IWeakReferenceSource_iface;
+        IPackageCatalog_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI catalog_AddRef( IPackageCatalog *iface )
+{
+    struct package_catalog *impl = impl_from_IPackageCatalog( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI catalog_Release( IPackageCatalog *iface )
+{
+    struct package_catalog *impl = impl_from_IPackageCatalog( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    unsigned int e, i;
+
+    if (!ref)
+    {
+        EnterCriticalSection( &weak_cs );
+        if (impl->weak) impl->weak->target = NULL;
+        LeaveCriticalSection( &weak_cs );
+        if (impl->weak) IWeakReference_Release( &impl->weak->IWeakReference_iface );
+        for (e = 0; e < EV_COUNT; e++)
+        {
+            for (i = 0; i < impl->count[e]; i++) IUnknown_Release( impl->handlers[e][i].handler );
+            free( impl->handlers[e] );
+        }
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI catalog_GetIids( IPackageCatalog *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI catalog_GetRuntimeClassName( IPackageCatalog *iface, HSTRING *class_name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_ApplicationModel_PackageCatalog,
+                                wcslen( RuntimeClass_Windows_ApplicationModel_PackageCatalog ), class_name );
+}
+
+static HRESULT WINAPI catalog_GetTrustLevel( IPackageCatalog *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT add_handler( struct package_catalog *impl, enum catalog_event ev, IUnknown *handler,
+                            EventRegistrationToken *token )
+{
+    struct handler_entry *list;
+    HRESULT hr = S_OK;
+
+    if (!handler || !token) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    if (!(list = realloc( impl->handlers[ev], (impl->count[ev] + 1) * sizeof(*list) ))) hr = E_OUTOFMEMORY;
+    else
+    {
+        impl->handlers[ev] = list;
+        list[impl->count[ev]].handler = handler;
+        list[impl->count[ev]].token = InterlockedIncrement64( &next_token );
+        token->value = list[impl->count[ev]].token;
+        IUnknown_AddRef( handler );
+        impl->count[ev]++;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT remove_handler( struct package_catalog *impl, enum catalog_event ev, EventRegistrationToken token )
+{
+    IUnknown *handler = NULL;
+    unsigned int i;
+
+    EnterCriticalSection( &impl->cs );
+    for (i = 0; i < impl->count[ev]; i++)
+        if (impl->handlers[ev][i].token == token.value)
+        {
+            handler = impl->handlers[ev][i].handler;
+            memmove( &impl->handlers[ev][i], &impl->handlers[ev][i + 1], (impl->count[ev] - i - 1) * sizeof(**impl->handlers) );
+            impl->count[ev]--;
+            break;
+        }
+    LeaveCriticalSection( &impl->cs );
+    if (handler) IUnknown_Release( handler );
+    return S_OK;   /* removing an unknown token is not an error on Windows */
+}
+
+#define CATALOG_EVENT( name, ev, handler_type )                                                                  \
+    static HRESULT WINAPI catalog_add_##name( IPackageCatalog *iface, handler_type *handler,                     \
+                                              EventRegistrationToken *token )                                   \
+    {                                                                                                          \
+        TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );                                    \
+        return add_handler( impl_from_IPackageCatalog( iface ), ev, (IUnknown *)handler, token );                \
+    }                                                                                                          \
+    static HRESULT WINAPI catalog_remove_##name( IPackageCatalog *iface, EventRegistrationToken token )           \
+    {                                                                                                          \
+        TRACE( "iface %p, token %#I64x.\n", iface, token.value );                                               \
+        return remove_handler( impl_from_IPackageCatalog( iface ), ev, token );                                  \
+    }
+
+CATALOG_EVENT( PackageStaging, EV_STAGING, ITypedEventHandler_PackageCatalog_PackageStagingEventArgs )
+CATALOG_EVENT( PackageInstalling, EV_INSTALLING, ITypedEventHandler_PackageCatalog_PackageInstallingEventArgs )
+CATALOG_EVENT( PackageUpdating, EV_UPDATING, ITypedEventHandler_PackageCatalog_PackageUpdatingEventArgs )
+CATALOG_EVENT( PackageUninstalling, EV_UNINSTALLING, ITypedEventHandler_PackageCatalog_PackageUninstallingEventArgs )
+CATALOG_EVENT( PackageStatusChanged, EV_STATUS, ITypedEventHandler_PackageCatalog_PackageStatusChangedEventArgs )
+
+static const struct IPackageCatalogVtbl catalog_vtbl =
+{
+    catalog_QueryInterface,
+    catalog_AddRef,
+    catalog_Release,
+    /* IInspectable methods */
+    catalog_GetIids,
+    catalog_GetRuntimeClassName,
+    catalog_GetTrustLevel,
+    /* IPackageCatalog methods */
+    catalog_add_PackageStaging,
+    catalog_remove_PackageStaging,
+    catalog_add_PackageInstalling,
+    catalog_remove_PackageInstalling,
+    catalog_add_PackageUpdating,
+    catalog_remove_PackageUpdating,
+    catalog_add_PackageUninstalling,
+    catalog_remove_PackageUninstalling,
+    catalog_add_PackageStatusChanged,
+    catalog_remove_PackageStatusChanged,
+};
+
+static HRESULT catalog_create( IPackageCatalog **out )
+{
+    struct package_catalog *impl;
+
+    if (!out) return E_POINTER;
