Subject: [PATCH] rpcrt4: RpcServerUnregisterIfEx waits and runs down context handles (patch 5115)

Gap-CORE item 588. Gate with a real client and server and three mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/rpcrt4/rpc_assoc.c b/dlls/rpcrt4/rpc_assoc.c
--- a/dlls/rpcrt4/rpc_assoc.c
+++ b/dlls/rpcrt4/rpc_assoc.c
@@ -57,6 +57,8 @@
     UUID uuid;
     CRITICAL_SECTION lock;
     unsigned int refs;
+    /* the interface of the call that made the handle */
+    RPC_SYNTAX_IDENTIFIER if_id;
 } RpcContextHandle;
 
 static void RpcContextHandle_Destroy(RpcContextHandle *context_handle);
@@ -454,13 +456,14 @@
 }
 
 RPC_STATUS RpcServerAssoc_AllocateContextHandle(RpcAssoc *assoc, void *CtxGuard,
-                                                NDR_SCONTEXT *SContext)
+                                                const RPC_SYNTAX_IDENTIFIER *if_id, NDR_SCONTEXT *SContext)
 {
     RpcContextHandle *context_handle;
 
     context_handle = calloc(1, sizeof(*context_handle));
     if (!context_handle)
         return RPC_S_OUT_OF_MEMORY;
+    if (if_id) context_handle->if_id = *if_id;
 
     context_handle->ctx_guard = CtxGuard;
     InitializeCriticalSectionEx(&context_handle->lock, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
@@ -562,6 +565,41 @@
     free(context_handle);
 }
 
+/* RpcServerUnregisterIfEx: the context handles that calls of this interface made, in every client's
+ * association, are done with; their rundown routines are called if asked (the server may already have
+ * destroyed its part of them, then they are only forgotten) */
+void RpcServerAssoc_RundownInterface(const RPC_SYNTAX_IDENTIFIER *if_id, BOOL call_rundown)
+{
+    struct list doomed = LIST_INIT(doomed);
+    RpcContextHandle *context_handle, *next;
+    RpcAssoc *assoc;
+
+    EnterCriticalSection(&assoc_list_cs);
+    LIST_FOR_EACH_ENTRY(assoc, &server_assoc_list, RpcAssoc, entry)
+    {
+        EnterCriticalSection(&assoc->cs);
+        LIST_FOR_EACH_ENTRY_SAFE(context_handle, next, &assoc->context_handle_list, RpcContextHandle, entry)
+        {
+            if (memcmp(&context_handle->if_id, if_id, sizeof(*if_id))) continue;
+            /* a handle some call still holds is left to that call */
+            if (context_handle->refs > 1 || UuidIsNil(&context_handle->uuid, &(RPC_STATUS){0})) continue;
+            list_remove(&context_handle->entry);
+            list_add_tail(&doomed, &context_handle->entry);
+        }
+        LeaveCriticalSection(&assoc->cs);
+    }
+    LeaveCriticalSection(&assoc_list_cs);
+
+    LIST_FOR_EACH_ENTRY_SAFE(context_handle, next, &doomed, RpcContextHandle, entry)
+    {
+        list_remove(&context_handle->entry);
+#ifndef SG_MUTANT_RUNDOWN_FLAG
+        if (!call_rundown) context_handle->rundown_routine = NULL;
+#endif
+        RpcContextHandle_Destroy(context_handle);
+    }
+}
+
 unsigned int RpcServerAssoc_ReleaseContextHandle(RpcAssoc *assoc, NDR_SCONTEXT SContext, BOOL release_lock)
 {
     RpcContextHandle *context_handle = (RpcContextHandle *)SContext;
diff --git a/dlls/rpcrt4/rpc_assoc.h b/dlls/rpcrt4/rpc_assoc.h
--- a/dlls/rpcrt4/rpc_assoc.h
+++ b/dlls/rpcrt4/rpc_assoc.h
@@ -54,7 +54,8 @@
 void RpcAssoc_ReleaseIdleConnection(RpcAssoc *assoc, RpcConnection *Connection);
 ULONG RpcAssoc_Release(RpcAssoc *assoc);
 RPC_STATUS RpcServerAssoc_GetAssociation(LPCSTR Protseq, LPCSTR NetworkAddr, LPCSTR Endpoint, LPCWSTR NetworkOptions, ULONG assoc_gid, RpcAssoc **assoc_out);
-RPC_STATUS RpcServerAssoc_AllocateContextHandle(RpcAssoc *assoc, void *CtxGuard, NDR_SCONTEXT *SContext);
+RPC_STATUS RpcServerAssoc_AllocateContextHandle(RpcAssoc *assoc, void *CtxGuard, const RPC_SYNTAX_IDENTIFIER *if_id, NDR_SCONTEXT *SContext);
+void RpcServerAssoc_RundownInterface(const RPC_SYNTAX_IDENTIFIER *if_id, BOOL call_rundown);
 RPC_STATUS RpcServerAssoc_FindContextHandle(RpcAssoc *assoc, const UUID *uuid, void *CtxGuard, ULONG Flags, NDR_SCONTEXT *SContext);
 RPC_STATUS RpcServerAssoc_UpdateContextHandle(RpcAssoc *assoc, NDR_SCONTEXT SContext, void *CtxGuard, NDR_RUNDOWN rundown_routine);
 unsigned int RpcServerAssoc_ReleaseContextHandle(RpcAssoc *assoc, NDR_SCONTEXT SContext, BOOL release_lock);
diff --git a/dlls/rpcrt4/ndr_contexthandle.c b/dlls/rpcrt4/ndr_contexthandle.c
--- a/dlls/rpcrt4/ndr_contexthandle.c
+++ b/dlls/rpcrt4/ndr_contexthandle.c
@@ -340,6 +340,7 @@
     if (!pBuff || (!context_ndr->attributes &&
                    UuidIsNil((UUID *)&context_ndr->uuid, &status)))
         status = RpcServerAssoc_AllocateContextHandle(binding->Assoc, CtxGuard,
+                                                      binding->FromConn ? &binding->FromConn->ActiveInterface : NULL,
                                                       &SContext);
     else
     {
diff --git a/dlls/rpcrt4/rpc_server.c b/dlls/rpcrt4/rpc_server.c
--- a/dlls/rpcrt4/rpc_server.c
+++ b/dlls/rpcrt4/rpc_server.c
@@ -1201,9 +1201,10 @@
 }
 
 /***********************************************************************
- *             RpcServerUnregisterIf (RPCRT4.@)
+ *             unregister_if
  */
-RPC_STATUS WINAPI RpcServerUnregisterIf( RPC_IF_HANDLE IfSpec, UUID* MgrTypeUuid, UINT WaitForCallsToComplete )
+static RPC_STATUS unregister_if( RPC_IF_HANDLE IfSpec, UUID* MgrTypeUuid, UINT WaitForCallsToComplete,
+                                 RPC_SYNTAX_IDENTIFIER *removed )
 {
   PRPC_SERVER_INTERFACE If = IfSpec;
   HANDLE event = NULL;
@@ -1213,7 +1214,7 @@
   RPC_STATUS status;
 
   TRACE("(IfSpec == (RPC_IF_HANDLE)^%p (%s), MgrTypeUuid == %s, WaitForCallsToComplete == %u)\n",
-    IfSpec, debugstr_guid(&If->InterfaceId.SyntaxGUID), debugstr_guid(MgrTypeUuid), WaitForCallsToComplete);
+    IfSpec, If ? debugstr_guid(&If->InterfaceId.SyntaxGUID) : "(all)", debugstr_guid(MgrTypeUuid), WaitForCallsToComplete);
 
   EnterCriticalSection(&server_cs);
   LIST_FOR_EACH_ENTRY(cif, &server_interfaces, RpcServerInterface, entry) {
@@ -1221,6 +1222,7 @@
         (IfSpec && !memcmp(&If->InterfaceId, &cif->If->InterfaceId, sizeof(RPC_SYNTAX_IDENTIFIER)))) &&
         UuidEqual(MgrTypeUuid, &cif->MgrTypeUuid, &status)) {
       list_remove(&cif->entry);
+      if (removed) *removed = cif->If->InterfaceId;
       TRACE("unregistering cif %p\n", cif);
       if (cif->CurrentCalls) {
         completed = FALSE;
@@ -1252,14 +1254,38 @@
 }
 
 /***********************************************************************
+ *             RpcServerUnregisterIf (RPCRT4.@)
+ */
+RPC_STATUS WINAPI RpcServerUnregisterIf( RPC_IF_HANDLE IfSpec, UUID* MgrTypeUuid, UINT WaitForCallsToComplete )
+{
+  return unregister_if( IfSpec, MgrTypeUuid, WaitForCallsToComplete, NULL );
+}
+
+/***********************************************************************
  *             RpcServerUnregisterIfEx (RPCRT4.@)
  */
 RPC_STATUS WINAPI RpcServerUnregisterIfEx( RPC_IF_HANDLE IfSpec, UUID* MgrTypeUuid, int RundownContextHandles )
 {
-  FIXME("(IfSpec == (RPC_IF_HANDLE)^%p, MgrTypeUuid == %s, RundownContextHandles == %d): stub\n",
+  RPC_SYNTAX_IDENTIFIER removed;
+  RPC_STATUS status;
+
+  TRACE("(IfSpec == (RPC_IF_HANDLE)^%p, MgrTypeUuid == %s, RundownContextHandles == %d)\n",
     IfSpec, debugstr_guid(MgrTypeUuid), RundownContextHandles);
 
-  return RPC_S_OK;
+  /* "waits for all calls on a given interface to complete before unregistering the context handles" */
+  memset( &removed, 0, sizeof(removed) );
+#ifdef SG_MUTANT_UNREG_EX_NOWAIT
+  status = unregister_if( IfSpec, MgrTypeUuid, FALSE, &removed );
+#else
+  status = unregister_if( IfSpec, MgrTypeUuid, TRUE, &removed );
+#endif
+#ifdef SG_MUTANT_UNREG_EX_NOP
+  return status;
+#endif
+  if (status == RPC_S_OK)
+    RpcServerAssoc_RundownInterface( &removed, RundownContextHandles != 0 );
+
+  return status;
 }
 
