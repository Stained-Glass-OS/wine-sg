     ok(handle == INVALID_HANDLE_VALUE && error == ERROR_TRANSACTION_NOT_FOUND, "got %p, error %lu\n", handle, error);
 }
 
+static void test_ktmw32_info(void)
+{
+    BOOL (WINAPI *pGetTransactionId)(HANDLE, GUID *);
+    BOOL (WINAPI *pGetTransactionInformation)(HANDLE, DWORD *, DWORD *, DWORD *, DWORD *, DWORD, WCHAR *);
+    BOOL (WINAPI *pCommitTransactionAsync)(HANDLE);
+    BOOL (WINAPI *pRollbackTransactionAsync)(HANDLE);
+    static WCHAR desc[] = L"ktm info";
+    TRANSACTION_BASIC_INFORMATION info;
+    DWORD outcome, timeout, error;
+    WCHAR buf[64];
+    HMODULE ktm;
+    HANDLE handle;
+    GUID id;
+    BOOL ret;
+
+    ktm = GetModuleHandleA("ktmw32.dll");
+    pGetTransactionId = (void *)GetProcAddress(ktm, "GetTransactionId");
+    pGetTransactionInformation = (void *)GetProcAddress(ktm, "GetTransactionInformation");
+    pCommitTransactionAsync = (void *)GetProcAddress(ktm, "CommitTransactionAsync");
+    pRollbackTransactionAsync = (void *)GetProcAddress(ktm, "RollbackTransactionAsync");
+    if (!pGetTransactionId || !pGetTransactionInformation)
+    {
+        win_skip("GetTransactionId/GetTransactionInformation not available\n");
+        return;
+    }
+
+    handle = pCreateTransaction(NULL, NULL, 0, 0, 0, 30000, desc);
+    ok(handle != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError());
+    ret = pGetTransactionId(handle, &id);
+    ok(ret, "got error %lu\n", GetLastError());
+    basic_info(handle, &info);
+    ok(IsEqualGUID(&id, &info.TransactionId), "got %s\n", wine_dbgstr_guid(&id));
+
+    ret = pGetTransactionInformation(handle, &outcome, NULL, NULL, &timeout, sizeof(buf), buf);
+    ok(ret, "got error %lu\n", GetLastError());
+    ok(outcome == TransactionOutcomeUndetermined, "got outcome %lu\n", outcome);
+    ok(timeout > 20000 && timeout <= 30000, "got timeout %lu\n", timeout);
+    ok(!wcscmp(buf, desc), "got %s\n", wine_dbgstr_w(buf));
+    SetLastError(0xdeadbeef);
+    ret = pGetTransactionInformation(handle, NULL, NULL, NULL, NULL, 2, buf);
+    error = GetLastError();
+    ok(!ret && error == ERROR_BUFFER_OVERFLOW, "got %d, error %lu\n", ret, error);
+
+    ret = pCommitTransactionAsync(handle);
+    ok(ret, "got error %lu\n", GetLastError());
+    ret = pGetTransactionInformation(handle, &outcome, NULL, NULL, NULL, 0, NULL);
+    ok(ret && outcome == TransactionOutcomeCommitted, "got %d, outcome %lu\n", ret, outcome);
+    CloseHandle(handle);
+
+    handle = pCreateTransaction(NULL, NULL, 0, 0, 0, 0, NULL);
+    ret = pRollbackTransactionAsync(handle);
+    ok(ret, "got error %lu\n", GetLastError());
+    ret = pGetTransactionInformation(handle, &outcome, NULL, NULL, &timeout, 0, NULL);
+    ok(ret && outcome == TransactionOutcomeAborted && !timeout, "got %d, outcome %lu, timeout %lu\n", ret, outcome, timeout);
+    CloseHandle(handle);
+}
+
 START_TEST(transaction)
 {
     HMODULE ntdll = GetModuleHandleA("ntdll.dll");
@@ -336,4 +393,5 @@
     test_timeout();
     test_names();
     test_ktmw32();
+    test_ktmw32_info();
 }
