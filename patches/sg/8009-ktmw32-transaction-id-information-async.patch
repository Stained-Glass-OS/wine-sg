From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ktmw32: GetTransactionId, GetTransactionInformation, CommitTransactionAsync, RollbackTransactionAsync

Spec stubs before (a call raised an exception; pywin32's win32transaction in Anki imports them). They read the transaction objects of 5602 through NtQueryInformationTransaction: the GUID; outcome, isolation level/flags, the timeout in milliseconds (0 for none) and the description, NUL-terminated, ERROR_BUFFER_OVERFLOW when BufferLength (bytes) is too small. The asynchronous commit and rollback are NtCommit/NtRollbackTransaction without waiting. SetTransactionInformation is left: it needs a new server request.
---
--- a/dlls/ktmw32/ktmw32_main.c
+++ b/dlls/ktmw32/ktmw32_main.c
@@ -20,6 +20,8 @@
 
 #include <stdarg.h>
 
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
 #include "windef.h"
 #include "winbase.h"
 #include "winternl.h"
@@ -96,3 +98,89 @@
     if (!set_ntstatus( NtOpenTransaction( &handle, access, &attr, guid, NULL ))) return INVALID_HANDLE_VALUE;
     return handle;
 }
+
+/* Stained Glass OS (wine-sg 8009): the transaction queries and the asynchronous commit/rollback, over the
+ * transaction objects of 5602 (NtQueryInformationTransaction basic + properties classes). */
+
+/***********************************************************************
+ * CommitTransactionAsync (ktmw32.@)
+ */
+BOOL WINAPI CommitTransactionAsync( HANDLE transaction )
+{
+    return set_ntstatus( NtCommitTransaction( transaction, FALSE ));
+}
+
+/***********************************************************************
+ * RollbackTransactionAsync (ktmw32.@)
+ */
+BOOL WINAPI RollbackTransactionAsync( HANDLE transaction )
+{
+    return set_ntstatus( NtRollbackTransaction( transaction, FALSE ));
+}
+
+/***********************************************************************
+ * GetTransactionId (ktmw32.@)
+ */
+BOOL WINAPI GetTransactionId( HANDLE transaction, GUID *id )
+{
+    TRANSACTION_BASIC_INFORMATION info;
+
+    if (!set_ntstatus( NtQueryInformationTransaction( transaction, TransactionBasicInformation,
+                                                      &info, sizeof(info), NULL ))) return FALSE;
+    if (id) *id = info.TransactionId;
+    return TRUE;
+}
+
+/***********************************************************************
+ * GetTransactionInformation (ktmw32.@)
+ *
+ * BufferLength is the size of Description in bytes (MAX_TRANSACTION_DESCRIPTION_LENGTH characters at
+ * most); the description is copied NUL-terminated when it fits, ERROR_BUFFER_OVERFLOW otherwise. Timeout
+ * comes back in milliseconds, 0 for a transaction that does not time out.
+ */
+BOOL WINAPI GetTransactionInformation( HANDLE transaction, DWORD *outcome, DWORD *level, DWORD *flags,
+        DWORD *timeout, DWORD length, WCHAR *desc )
+{
+    union
+    {
+        TRANSACTION_PROPERTIES_INFORMATION props;
+        BYTE buf[FIELD_OFFSET(TRANSACTION_PROPERTIES_INFORMATION, Description[256])];
+    } info;
+    TRANSACTION_PROPERTIES_INFORMATION *props = &info.props;
+    NTSTATUS status;
+    ULONG len;
+
+    status = NtQueryInformationTransaction( transaction, TransactionPropertiesInformation,
+                                            &info, sizeof(info), NULL );
+    if (status && status != STATUS_BUFFER_OVERFLOW) return set_ntstatus( status );
+
+    if (outcome) *outcome = props->Outcome;
+    if (level) *level = props->IsolationLevel;
+    if (flags) *flags = props->IsolationFlags;
+    if (timeout)
+    {
+        LONGLONG t = props->Timeout.QuadPart;
+        if (t > 0)
+        {
+            LARGE_INTEGER now;
+            NtQuerySystemTime( &now );
+            t = now.QuadPart - t;  /* absolute: what is left of it */
+            if (t > 0) t = 0;
+        }
+        *timeout = t ? (DWORD)min( -t / 10000, (LONGLONG)(INFINITE - 1) ) : 0;
+    }
+    if (desc)
+    {
+        len = min( props->DescriptionLength, sizeof(info) - FIELD_OFFSET(TRANSACTION_PROPERTIES_INFORMATION, Description) );
+        len = len / sizeof(WCHAR) * sizeof(WCHAR);
+        if (length < len + sizeof(WCHAR))
+        {
+            if (length >= sizeof(WCHAR)) desc[0] = 0;
+            RtlSetLastWin32Error( ERROR_BUFFER_OVERFLOW );
+            return FALSE;
+        }
+        memcpy( desc, props->Description, len );
+        desc[len / sizeof(WCHAR)] = 0;
+    }
+    return TRUE;
+}
