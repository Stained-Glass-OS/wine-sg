+/* Remembers the blanket a caller asks for (Omaha's updaters, for one, fail
+ * when this does). The calls themselves go over local RPC, which has no
+ * authentication levels to change. */
 static HRESULT WINAPI ProxyCliSec_SetBlanket(IClientSecurity *iface,
                                              IUnknown *pProxy, DWORD AuthnSvc,
                                              DWORD AuthzSvc,
@@ -1399,18 +1430,54 @@
                                              void *pAuthInfo,
                                              DWORD Capabilities)
 {
-    FIXME("%p, %ld, %ld, %s, %ld, %ld, %p, %#lx: stub\n", pProxy, AuthnSvc, AuthzSvc,
+    struct proxy_manager *This = impl_from_IClientSecurity( iface );
+    WCHAR *princ = NULL;
+
+    TRACE("%p, %ld, %ld, %s, %ld, %ld, %p, %#lx\n", pProxy, AuthnSvc, AuthzSvc,
           pServerPrincName == COLE_DEFAULT_PRINCIPAL ? "<default principal>" : debugstr_w(pServerPrincName),
           AuthnLevel, ImpLevel, pAuthInfo, Capabilities);
+
+#ifdef SG_MUTANT_NOBLANKET
     return E_NOTIMPL;
+#endif
+    if (!proxy_manager_owns(This, pProxy)) return E_NOINTERFACE;
+    if ((AuthnSvc > 0xff && AuthnSvc != RPC_C_AUTHN_DEFAULT) ||
+        (AuthzSvc > 0xff && AuthzSvc != RPC_C_AUTHZ_DEFAULT) ||
+        AuthnLevel > RPC_C_AUTHN_LEVEL_PKT_PRIVACY || ImpLevel > RPC_C_IMP_LEVEL_DELEGATE)
+        return E_INVALIDARG;
+    if (pServerPrincName && pServerPrincName != COLE_DEFAULT_PRINCIPAL && !(princ = wcsdup(pServerPrincName)))
+        return E_OUTOFMEMORY;
+
+    EnterCriticalSection(&This->cs);
+    if (AuthnSvc != RPC_C_AUTHN_DEFAULT) This->authn_svc = AuthnSvc;
+    if (AuthzSvc != RPC_C_AUTHZ_DEFAULT) This->authz_svc = AuthzSvc;
+    if (pServerPrincName != COLE_DEFAULT_PRINCIPAL)
+    {
+        free(This->server_princ);
+        This->server_princ = princ;
+    }
+    if (AuthnLevel != RPC_C_AUTHN_LEVEL_DEFAULT) This->authn_level = AuthnLevel;
+    if (ImpLevel != RPC_C_IMP_LEVEL_DEFAULT) This->imp_level = ImpLevel;
+    if (Capabilities != EOAC_DEFAULT) This->capabilities = Capabilities;
+    LeaveCriticalSection(&This->cs);
+    return S_OK;
 }
 
+/* A copy shares the one blanket the proxy keeps; the caller gets the proxy
+ * itself, which is what it would talk to through a copy. */
 static HRESULT WINAPI ProxyCliSec_CopyProxy(IClientSecurity *iface,
                                             IUnknown *pProxy, IUnknown **ppCopy)
 {
-    FIXME("(%p, %p): stub\n", pProxy, ppCopy);
+    struct proxy_manager *This = impl_from_IClientSecurity( iface );
+
+    TRACE("(%p, %p)\n", pProxy, ppCopy);
+
+    if (!ppCopy) return E_INVALIDARG;
     *ppCopy = NULL;
-    return E_NOTIMPL;
+    if (!proxy_manager_owns(This, pProxy)) return E_NOINTERFACE;
+    IUnknown_AddRef(pProxy);
+    *ppCopy = pProxy;
+    return S_OK;
 }
 
 static const IClientSecurityVtbl ProxyCliSec_Vtbl =
@@ -1600,6 +1667,14 @@
     This->dest_context = MSHCTX_INPROC;
     This->dest_context_data = NULL;
 
+    /* what a proxy has on Windows until someone sets a blanket */
+    This->authn_svc = RPC_C_AUTHN_WINNT;
+    This->authz_svc = RPC_C_AUTHZ_NONE;
+    This->authn_level = RPC_C_AUTHN_LEVEL_CONNECT;
+    This->imp_level = RPC_C_IMP_LEVEL_IDENTIFY;
+    This->capabilities = EOAC_NONE;
+    This->server_princ = NULL;
+
     EnterCriticalSection(&apt->cs);
     /* FIXME: we are dependent on the ordering in here to make sure a proxy's
      * IRemUnknown proxy doesn't get destroyed before the regular proxy does
@@ -1957,6 +2032,7 @@
     DeleteCriticalSection(&This->cs);
 
     CloseHandle(This->remoting_mutex);
+    free(This->server_princ);
 
     free(This);
 }
