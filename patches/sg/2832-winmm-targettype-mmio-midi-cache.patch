+/**************************************************************************
+ *       		MMIO_GrowMemoryFile			[INTERNAL]
+ *
+ * A memory file whose buffer is a moveable global block, and that was opened
+ * with an expansion size in adwInfo[0], grows by that size when it is full.
+ */
+static BOOL MMIO_GrowMemoryFile(LPWINE_MMIO wm)
+{
+    HGLOBAL handle, grown;
+    LONG new_size, next;
+    char *base;
+
+#ifdef SG_MUTANT_WINMM_MMIO_GROW
+    return FALSE;
+#endif
+    if (!wm->info.adwInfo[0] || !wm->info.pchBuffer) return FALSE;
+    if (!(handle = GlobalHandle(wm->info.pchBuffer))) return FALSE;
+
+    new_size = wm->info.cchBuffer + wm->info.adwInfo[0];
+    if (new_size < wm->info.cchBuffer) return FALSE;
+
+    next = wm->info.pchNext - wm->info.pchBuffer;
+    GlobalUnlock(handle);
+    if (!(grown = GlobalReAlloc(handle, new_size, GMEM_MOVEABLE)))
+    {
+        GlobalLock(handle);
+        return FALSE;
+    }
+    base = GlobalLock(grown);
+
+    wm->info.pchBuffer = base;
+    wm->info.pchNext = base + next;
+    wm->info.pchEndRead = wm->info.pchEndWrite = base + new_size;
+    wm->info.cchBuffer = new_size;
+    return TRUE;
+}
+
 /**************************************************************************
  * 				mmioWrite      		[WINMM.@]
  */
@@ -867,6 +904,11 @@ LONG WINAPI mmioWrite(HMMIO hmmio, HPCSTR pch, LONG cch)
 	LONG	bytesW = 0;
 
         while (cch) {
+            if (wm->info.fccIOProc == FOURCC_MEM && wm->info.pchNext == wm->info.pchEndWrite) {
+                /* a full memory file stops, unless it may grow (adwInfo[0] is the expansion size) */
+                if (!MMIO_GrowMemoryFile(wm)) break;
+            }
+
             if (wm->info.pchNext != wm->info.pchEndWrite) {
                 count = wm->info.pchEndWrite - wm->info.pchNext;
                 if (count > cch || count < 0) count = cch;
@@ -876,18 +918,11 @@ LONG WINAPI mmioWrite(HMMIO hmmio, HPCSTR pch, LONG cch)
                 cch -= count;
                 bytesW += count;
                 wm->info.dwFlags |= MMIO_DIRTY;
-	    } else {
-                if (wm->info.fccIOProc == FOURCC_MEM) {
-                    if (wm->info.adwInfo[0]) {
-                        /* from where would we get the memory handle? */
-                        FIXME("memory file expansion not implemented!\n");
-                        break;
-		    } else break;
-                }
             }
 
             if (wm->info.pchNext == wm->info.pchEndWrite)
             {
+                if (wm->info.fccIOProc == FOURCC_MEM) continue;
                 MMIO_Flush(wm, MMIO_EMPTYBUF);
                 MMIO_GrabNextBuffer(wm, FALSE);
             }
