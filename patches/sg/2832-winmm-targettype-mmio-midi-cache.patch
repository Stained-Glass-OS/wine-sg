     return MIXERR_INVALLINE;
 }
 
+/* The line whose target is the device described by Target.dwType and Target.szPname
+ * (with the driver's ids: the caller passes the values it read from the device caps). */
+static BOOL WINMM_TargetMatches(WINMM_MMDevice *mmdevice, const MIXERLINEW *line, const MIXERLINEW *want)
+{
+    WORD mid = mmdevice->in_caps.szPname[0] ? mmdevice->in_caps.wMid : mmdevice->out_caps.wMid;
+    WORD pid = mmdevice->in_caps.szPname[0] ? mmdevice->in_caps.wPid : mmdevice->out_caps.wPid;
+    MMVERSION version = mmdevice->in_caps.szPname[0] ? mmdevice->in_caps.vDriverVersion : mmdevice->out_caps.vDriverVersion;
+
+#ifdef SG_MUTANT_WINMM_TARGETTYPE
+    return FALSE;
+#endif
+    if(line->Target.dwType != want->Target.dwType)
+        return FALSE;
+    if(wcscmp(line->Target.szPname, want->Target.szPname))
+        return FALSE;
+    /* the line reports no ids of its own: the device's are the right ones to ask with */
+    return (want->Target.wMid == line->Target.wMid || want->Target.wMid == mid) &&
+           (want->Target.wPid == line->Target.wPid || want->Target.wPid == pid) &&
+           (want->Target.vDriverVersion == line->Target.vDriverVersion || want->Target.vDriverVersion == version);
+}
+
+static UINT WINMM_GetTargetTypeLineInfo(WINMM_MMDevice *mmdevice,
+        UINT mmdev_index, MIXERLINEW *info, DWORD flags)
+{
+    MIXERLINEW line;
+    UINT ret;
+
+    switch(info->Target.dwType){
+    case MIXERLINE_TARGETTYPE_UNDEFINED:
+    case MIXERLINE_TARGETTYPE_WAVEOUT:
+    case MIXERLINE_TARGETTYPE_WAVEIN:
+    case MIXERLINE_TARGETTYPE_MIDIOUT:
+    case MIXERLINE_TARGETTYPE_MIDIIN:
+    case MIXERLINE_TARGETTYPE_AUX:
+        break;
+    default:
+        return MMSYSERR_INVALPARAM;
+    }
+
+    /* the destination line first, then the source line */
+    line = *info;
+    line.dwDestination = 0;
+    if(WINMM_GetDestinationLineInfo(mmdevice, mmdev_index, &line, flags) == MMSYSERR_NOERROR &&
+            WINMM_TargetMatches(mmdevice, &line, info)){
+        *info = line;
+        return MMSYSERR_NOERROR;
+    }
+
+    line = *info;
+    line.dwSource = 0;
+    ret = WINMM_GetSourceLineInfo(mmdevice, mmdev_index, &line, flags);
+    if(ret == MMSYSERR_NOERROR && WINMM_TargetMatches(mmdevice, &line, info)){
+        *info = line;
+        return MMSYSERR_NOERROR;
+    }
+
+    return MIXERR_INVALLINE;
+}
+
 /**************************************************************************
  * 				mixerGetLineInfoW		[WINMM.@]
  */
@@ -4313,8 +4372,7 @@ UINT WINAPI mixerGetLineInfoW(HMIXEROBJ hmix, LPMIXERLINEW lpmliW, DWORD fdwInfo
     case MIXER_GETLINEINFOF_LINEID:
         return WINMM_GetLineIDLineInfo(mmdevice, mmdev_index, lpmliW, fdwInfo);
     case MIXER_GETLINEINFOF_TARGETTYPE:
-        FIXME("TARGETTYPE flag not implemented!\n");
-        return MIXERR_INVALLINE;
+        return WINMM_GetTargetTypeLineInfo(mmdevice, mmdev_index, lpmliW, fdwInfo);
     }
 
     TRACE("Returning INVALFLAG on these flags: %lx\n", fdwInfo);
