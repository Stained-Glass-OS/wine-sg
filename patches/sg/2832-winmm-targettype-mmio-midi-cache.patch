@@ -2386,11 +2393,29 @@ UINT WINAPI mciGetDeviceIDFromElementIDA(DWORD dwElementID, LPCSTR lpstrType)
  */
 UINT WINAPI mciGetDeviceIDFromElementIDW(DWORD dwElementID, LPCWSTR lpstrType)
 {
-    /* FIXME: that's rather strange, there is no
-     * mciGetDeviceIDFromElementID32A in winmm.spec
-     */
-    FIXME("(%lu, %s) stub\n", dwElementID, debugstr_w(lpstrType));
-    return 0;
+    LPWINE_MCIDRIVER wmd;
+    UINT ret = 0;
+
+    TRACE("(%lu, %s)\n", dwElementID, debugstr_w(lpstrType));
+
+    if (!lpstrType) return 0;
+
+    /* the device of that type that was opened with this element id; none is 0 */
+    EnterCriticalSection(&WINMM_cs);
+    for (wmd = MciDrivers; wmd; wmd = wmd->lpNext)
+    {
+        if (wmd->has_element_id && wmd->element_id == dwElementID &&
+                wmd->lpstrDeviceType && !wcsicmp(wmd->lpstrDeviceType, lpstrType))
