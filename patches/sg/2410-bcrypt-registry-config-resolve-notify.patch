From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: keep the CNG configuration in the registry; BCryptResolveProviders and config-change notification

The context / function / provider store from 2402 lived in process memory,
so nothing a program configured outlived it or reached another process.
It is now read from and written to the keys Windows uses,
HKLM\SYSTEM\CurrentControlSet\Control\Cryptography\Configuration\{Local,Domain}
and ...\Cryptography\Providers: every call loads the keys into the model,
and a call that changes something writes the touched table or the provider
list back (STATUS_ACCESS_DENIED when the key cannot be written). A store that
was never written gets the built-in Default and SSL contexts and the
Microsoft Primitive Provider written out. Names that cannot be registry key
names (a backslash) are rejected. The failure NTSTATUS values are the
documented ones, now said in the file header.

BCryptResolveProviders walks the context's function and provider lists (the
Default context when none is named; Local before Domain), keeps registered
providers that register the function in the image kind the mode asks for,
and returns each with the function's properties and the image names and
flags in one block. CRYPT_ALL_FUNCTIONS and CRYPT_ALL_PROVIDERS are
supported, plus the include/bcrypt.h structures.

BCryptRegisterConfigChangeNotify / BCryptUnregisterConfigChangeNotify keep
a list of events that a worker thread signals, from a registry change
notification on the Configuration and Providers keys, so changes made by
other processes are seen too.
---
--- a/dlls/bcrypt/bcrypt.spec
+++ b/dlls/bcrypt/bcrypt.spec
@@ -40,17 +40,17 @@
 @ stdcall BCryptQueryContextFunctionConfiguration(long wstr long wstr ptr ptr)
 @ stdcall BCryptQueryContextFunctionProperty(long wstr long wstr wstr ptr ptr)
 @ stdcall BCryptQueryProviderRegistration(wstr long long ptr ptr)
-@ stub BCryptRegisterConfigChangeNotify
+@ stdcall BCryptRegisterConfigChangeNotify(ptr)
 @ stdcall BCryptRegisterProvider(wstr long ptr)
 @ stdcall BCryptRemoveContextFunction(long wstr long wstr)
 @ stdcall BCryptRemoveContextFunctionProvider(long wstr long wstr wstr)
-@ stub BCryptResolveProviders
+@ stdcall BCryptResolveProviders(wstr long wstr wstr long long ptr ptr)
 @ stdcall BCryptSecretAgreement(ptr ptr ptr long)
 @ stub BCryptSetAuditingInterface
 @ stdcall BCryptSetContextFunctionProperty(long wstr long wstr wstr long ptr)
 @ stdcall BCryptSetProperty(ptr wstr ptr long long)
 @ stdcall BCryptSignHash(ptr ptr ptr long ptr long ptr long)
-@ stub BCryptUnregisterConfigChangeNotify
+@ stdcall BCryptUnregisterConfigChangeNotify(ptr)
 @ stdcall BCryptUnregisterProvider(wstr)
 @ stdcall BCryptVerifySignature(ptr ptr ptr long ptr long long)
 @ stub GetAsymmetricEncryptionInterface
--- a/dlls/bcrypt/config.c
+++ b/dlls/bcrypt/config.c
@@ -2,12 +2,36 @@
  * CNG configuration store: contexts, context functions, providers
  *
  * Windows keeps this in the registry under
- * HKLM\SYSTEM\CurrentControlSet\Control\Cryptography\Configuration (and the
- * Providers key).  This implementation keeps the same model in memory for the
- * lifetime of the process: a table (local or domain) holds named contexts, a
- * context holds an ordered list of functions per interface, a function holds
- * an ordered list of providers plus named properties, and registered
- * providers are described by a CRYPT_PROVIDER_REG.
+ * HKLM\SYSTEM\CurrentControlSet\Control\Cryptography\Configuration (the
+ * Local and Domain tables) and ...\Cryptography\Providers.  The same keys
+ * hold it here, so every process (and every restart) sees one store.  Each
+ * API call loads the keys into an in-memory model, works on that, and a
+ * call that changes something writes the touched part back: a table (local
+ * or domain) holds named contexts, a context holds an ordered list of
+ * functions per interface, a function holds an ordered list of providers
+ * plus named properties, and registered providers are described by a
+ * CRYPT_PROVIDER_REG.
+ *
+ * Layout under Configuration\<Local|Domain>:
+ *   <context>                   Flags, Reserved (DWORD)
+ *     <interface, 8 hex>        Functions (REG_MULTI_SZ, priority order)
+ *       <function>              Providers (REG_MULTI_SZ, priority order),
+ *                               Flags, Reserved
+ *         Properties            one REG_BINARY value per property
+ * and under Providers:
+ *   <provider>                  Alias (REG_MULTI_SZ)
+ *     UM, KM                    Image (REG_SZ)
+ *       <interface, 8 hex>      Functions (REG_MULTI_SZ), Flags
+ * The key names and the value names are what Windows is known to use for the
+ * parts we are confident of (the Configuration and Providers roots, the
+ * Local/Domain split, Functions, Providers, Image, UM/KM, 8-hex interface
+ * keys); the rest of the naming is our own and only has to be read back by
+ * this implementation.
+ *
+ * The NTSTATUS values returned for the failure cases (STATUS_NOT_FOUND,
+ * STATUS_OBJECT_NAME_COLLISION, STATUS_BUFFER_TOO_SMALL, STATUS_INVALID_PARAMETER,
+ * STATUS_ACCESS_DENIED for a store that cannot be written) come from the
+ * CNG documentation, not from observation of Windows.
  *
  * Every buffer handed back to the caller is a single allocation with the
  * pointers inside it pointing into the same block, so BCryptFreeBuffer (free)
@@ -22,6 +46,7 @@
 #define WIN32_NO_STATUS
 #include "windef.h"
 #include "winbase.h"
+#include "winreg.h"
 #include "winternl.h"
 #include "bcrypt.h"
 
@@ -76,7 +101,6 @@ struct provider
 };
 
 static SRWLOCK config_lock = SRWLOCK_INIT;
-static BOOL    seeded;
 static struct list contexts[2] = { LIST_INIT( contexts[0] ), LIST_INIT( contexts[1] ) };
 static struct list providers = LIST_INIT( providers );
 
@@ -174,6 +198,12 @@ static BOOL valid_name( const WCHAR *name )
     return name && name[0];
 }
 
+/* names that become registry key names */
+static BOOL valid_key_name( const WCHAR *name )
+{
+    return valid_name( name ) && wcslen( name ) <= 255 && !wcschr( name, '\\' );
+}
+
 /* ---- provider registration blobs ---- */
 
 struct reg_copy
@@ -371,6 +401,34 @@ static void free_function( struct function *f )
     free( f );
 }
 
+static void free_context( struct context *ctx )
+{
+    while (!list_empty( &ctx->functions ))
+        free_function( LIST_ENTRY( list_head( &ctx->functions ), struct function, entry ) );
+    list_remove( &ctx->entry );
+    free( ctx->name );
+    free( ctx );
+}
+
+static void free_provider( struct provider *p )
+{
+    list_remove( &p->entry );
+    free( p->reg );
+    free( p->name );
+    free( p );
+}
+
+static void clear_model(void)
+{
+    ULONG i;
+
+    for (i = 0; i < 2; i++)
+        while (!list_empty( &contexts[i] ))
+            free_context( LIST_ENTRY( list_head( &contexts[i] ), struct context, entry ) );
+    while (!list_empty( &providers ))
+        free_provider( LIST_ENTRY( list_head( &providers ), struct provider, entry ) );
+}
+
 static struct context *add_context( ULONG table, const WCHAR *name, const CRYPT_CONTEXT_CONFIG *cfg )
 {
     struct context *ctx;
@@ -452,7 +510,7 @@ static struct function *add_function( struct context *ctx, ULONG iface, const WC
 
 /* Default context and the built-in provider are derived from the algorithms
  * this bcrypt implements, so the two never disagree with BCryptEnumAlgorithms. */
-static void seed_config(void)
+static void seed_model(void)
 {
     BCRYPT_ALGORITHM_IDENTIFIER *algs;
     CRYPT_INTERFACE_REG ifaces[LAST_INTERFACE + 1], *iface_list[LAST_INTERFACE];
@@ -462,9 +520,6 @@ static void seed_config(void)
     PWSTR *names[LAST_INTERFACE + 1] = { 0 };
     ULONG count, i, j, n, iface;
 
-    if (seeded) return;
-    seeded = TRUE;
-
     ctx = add_context( CRYPT_LOCAL, L"Default", NULL );
     add_context( CRYPT_LOCAL, L"SSL", NULL );
     if (BCryptEnumAlgorithms( 0, &count, &algs, 0 )) return;
@@ -507,6 +562,510 @@ static void seed_config(void)
     BCryptFreeBuffer( algs );
 }
 
+/* ---- registry store ---- */
+
+#define CRYPTO_KEY    L"System\\CurrentControlSet\\Control\\Cryptography"
+#define CONFIG_KEY    CRYPTO_KEY L"\\Configuration"
+#define PROVIDERS_KEY CRYPTO_KEY L"\\Providers"
+
+#define DIRTY_LOCAL     0x01
+#define DIRTY_DOMAIN    0x02
+#define DIRTY_PROVIDERS 0x04
+
+static const WCHAR *table_key_name( ULONG table )
+{
+    return table == CRYPT_LOCAL ? L"Local" : L"Domain";
+}
+
+/* everything allocated while reading one registry subtree, freed at once */
+struct arena
+{
+    void  **ptr;
+    SIZE_T  count, cap;
+};
+
+static void *arena_alloc( struct arena *a, SIZE_T size )
+{
+    void *mem;
+
+    if (a->count == a->cap)
+    {
+        SIZE_T cap = a->cap ? a->cap * 2 : 16;
+        void **p = realloc( a->ptr, cap * sizeof(*p) );
+        if (!p) return NULL;
+        a->ptr = p;
+        a->cap = cap;
+    }
+    if (!(mem = calloc( 1, size ? size : 1 ))) return NULL;
+    a->ptr[a->count++] = mem;
+    return mem;
+}
+
+static void arena_free( struct arena *a )
+{
+    while (a->count) free( a->ptr[--a->count] );
+    free( a->ptr );
+    memset( a, 0, sizeof(*a) );
+}
+
+static void iface_key_name( ULONG iface, WCHAR *buf )
+{
+    ULONG i, d;
+
+    for (i = 0; i < 8; i++)
+    {
+        d = (iface >> (28 - 4 * i)) & 0xf;
+        buf[i] = d < 10 ? '0' + d : 'A' + d - 10;
+    }
+    buf[8] = 0;
+}
+
+static BOOL parse_iface_key( const WCHAR *name, ULONG *iface )
+{
+    ULONG i, val = 0;
+
+    for (i = 0; i < 8; i++)
+    {
+        WCHAR c = name[i];
+        if (c >= '0' && c <= '9') val = (val << 4) | (c - '0');
+        else if (c >= 'A' && c <= 'F') val = (val << 4) | (c - 'A' + 10);
+        else if (c >= 'a' && c <= 'f') val = (val << 4) | (c - 'a' + 10);
+        else return FALSE;
+    }
+    if (name[8]) return FALSE;
+    *iface = val;
+    return TRUE;
+}
+
+/* a REG_MULTI_SZ (or a single REG_SZ) as an array of strings */
+static WCHAR **read_multi( struct arena *a, HKEY key, const WCHAR *name, ULONG *count )
+{
+    DWORD type, size = 0, n = 0;
+    WCHAR *buf, *p, **list;
+
+    *count = 0;
+    if (RegQueryValueExW( key, name, NULL, &type, NULL, &size ) || (type != REG_MULTI_SZ && type != REG_SZ))
+        return NULL;
+    if (!(buf = arena_alloc( a, size + 2 * sizeof(WCHAR) ))) return NULL;
+    if (RegQueryValueExW( key, name, NULL, &type, (BYTE *)buf, &size )) return NULL;
+    for (p = buf; *p; p += wcslen( p ) + 1) n++;
+    if (!(list = arena_alloc( a, (n + 1) * sizeof(*list) ))) return NULL;
+    for (p = buf, n = 0; *p; p += wcslen( p ) + 1) list[n++] = p;
+    *count = n;
+    return list;
+}
+
+static ULONG read_dword( HKEY key, const WCHAR *name )
+{
+    DWORD type, size = sizeof(DWORD), val = 0;
+
+    if (RegQueryValueExW( key, name, NULL, &type, (BYTE *)&val, &size ) || type != REG_DWORD) return 0;
+    return val;
+}
+
+static void load_function( HKEY ifkey, struct context *ctx, ULONG iface, const WCHAR *fname )
+{
+    struct arena a = { 0 };
+    struct function *f;
+    HKEY fk, pk;
+    WCHAR **list;
+    ULONG count, i;
+
+    if (!(f = add_function( ctx, iface, fname, CRYPT_PRIORITY_BOTTOM ))) return;
+    if (RegOpenKeyExW( ifkey, fname, 0, KEY_READ, &fk )) return;
+
+    list = read_multi( &a, fk, L"Providers", &count );
+    for (i = 0; i < count; i++) add_name( &f->providers, list[i], CRYPT_PRIORITY_BOTTOM );
+    f->flags = read_dword( fk, L"Flags" );
+    f->reserved = read_dword( fk, L"Reserved" );
+    arena_free( &a );
+
+    if (!RegOpenKeyExW( fk, L"Properties", 0, KEY_READ, &pk ))
+    {
+        for (i = 0;; i++)
+        {
+            WCHAR pname[256];
+            DWORD nlen = ARRAY_SIZE(pname), type, size = 0;
+            struct property *p;
+            LONG ret = RegEnumValueW( pk, i, pname, &nlen, NULL, &type, NULL, &size );
+
+            if (ret == ERROR_NO_MORE_ITEMS) break;
+            if (ret) continue;
+            if (!(p = malloc( sizeof(*p) ))) break;
+            if (!(p->name = dup_str( pname )) || !(p->data = malloc( size ? size : 1 )))
+            {
+                free( p->name );
+                free( p );
+                break;
+            }
+            nlen = size;
+            if (size && RegQueryValueExW( pk, pname, NULL, &type, p->data, &nlen )) size = 0;
+            p->size = size;
+            list_add_tail( &f->properties, &p->entry );
+        }
+        RegCloseKey( pk );
+    }
+    RegCloseKey( fk );
+}
+
+static void load_context( ULONG table, const WCHAR *name, HKEY ck )
+{
+    struct context *ctx;
+    ULONG i;
+
+    if (!(ctx = add_context( table, name, NULL ))) return;
+    ctx->flags = read_dword( ck, L"Flags" );
+    ctx->reserved = read_dword( ck, L"Reserved" );
+
+    for (i = 0;; i++)
+    {
+        WCHAR kname[256];
+        DWORD len = ARRAY_SIZE(kname);
+        struct arena a = { 0 };
+        WCHAR **list;
+        ULONG iface, count, j;
+        HKEY ik;
+        LONG ret = RegEnumKeyExW( ck, i, kname, &len, NULL, NULL, NULL, NULL );
+
+        if (ret == ERROR_NO_MORE_ITEMS) break;
+        if (ret || !parse_iface_key( kname, &iface )) continue;
+        if (RegOpenKeyExW( ck, kname, 0, KEY_READ, &ik )) continue;
+        list = read_multi( &a, ik, L"Functions", &count );
+        for (j = 0; j < count; j++)
+            if (!find_function( ctx, iface, list[j] )) load_function( ik, ctx, iface, list[j] );
+        arena_free( &a );
+        RegCloseKey( ik );
+    }
+}
+
+/* returns FALSE when the table key does not exist at all (a store that was never written) */
+static BOOL load_table( ULONG table )
+{
+    HKEY base, tk;
+    ULONG i;
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, CONFIG_KEY, 0, KEY_READ, &base )) return FALSE;
+    if (RegOpenKeyExW( base, table_key_name( table ), 0, KEY_READ, &tk ))
+    {
+        RegCloseKey( base );
+        return FALSE;
+    }
+    for (i = 0;; i++)
+    {
+        WCHAR name[256];
+        DWORD len = ARRAY_SIZE(name);
+        HKEY ck;
+        LONG ret = RegEnumKeyExW( tk, i, name, &len, NULL, NULL, NULL, NULL );
+
+        if (ret == ERROR_NO_MORE_ITEMS) break;
+        if (ret) continue;
+        if (RegOpenKeyExW( tk, name, 0, KEY_READ, &ck )) continue;
+        load_context( table, name, ck );
+        RegCloseKey( ck );
+    }
+    RegCloseKey( tk );
+    RegCloseKey( base );
+    return TRUE;
+}
+
+static CRYPT_IMAGE_REG *load_image( struct arena *a, HKEY pk, const WCHAR *which )
+{
+    CRYPT_IMAGE_REG *image;
+    HKEY ik;
+    WCHAR **str;
+    DWORD nsub = 0, i;
+    ULONG count, n = 0;
+
+    if (RegOpenKeyExW( pk, which, 0, KEY_READ, &ik )) return NULL;
+    if (!(image = arena_alloc( a, sizeof(*image) ))) goto done;
+    str = read_multi( a, ik, L"Image", &count );
+    image->pszImage = count ? str[0] : (WCHAR *)L"";
+    RegQueryInfoKeyW( ik, NULL, NULL, NULL, &nsub, NULL, NULL, NULL, NULL, NULL, NULL, NULL );
+    if (!(image->rgpInterfaces = arena_alloc( a, (nsub + 1) * sizeof(*image->rgpInterfaces) ))) goto done;
+
+    for (i = 0; i < nsub; i++)
+    {
+        WCHAR kname[256];
+        DWORD len = ARRAY_SIZE(kname);
+        CRYPT_INTERFACE_REG *reg;
+        ULONG iface;
+        HKEY fk;
+
+        if (RegEnumKeyExW( ik, i, kname, &len, NULL, NULL, NULL, NULL ) || !parse_iface_key( kname, &iface )) continue;
+        if (RegOpenKeyExW( ik, kname, 0, KEY_READ, &fk )) continue;
+        if ((reg = arena_alloc( a, sizeof(*reg) )))
+        {
+            reg->dwInterface = iface;
+            reg->dwFlags = read_dword( fk, L"Flags" );
+            reg->rgpszFunctions = read_multi( a, fk, L"Functions", &reg->cFunctions );
+            image->rgpInterfaces[n++] = reg;
+        }
+        RegCloseKey( fk );
+    }
+    image->cInterfaces = n;
+done:
+    RegCloseKey( ik );
+    return image;
+}
+
+static void load_providers(void)
+{
+    HKEY base;
+    ULONG i;
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, PROVIDERS_KEY, 0, KEY_READ, &base )) return;
+    for (i = 0;; i++)
+    {
+        WCHAR name[256];
+        DWORD len = ARRAY_SIZE(name);
+        struct arena a = { 0 };
+        CRYPT_PROVIDER_REG reg = { 0 };
+        HKEY pk;
+        LONG ret = RegEnumKeyExW( base, i, name, &len, NULL, NULL, NULL, NULL );
+
+        if (ret == ERROR_NO_MORE_ITEMS) break;
+        if (ret || RegOpenKeyExW( base, name, 0, KEY_READ, &pk )) continue;
+        reg.rgpszAliases = read_multi( &a, pk, L"Alias", &reg.cAliases );
+        reg.pUM = load_image( &a, pk, L"UM" );
+        reg.pKM = load_image( &a, pk, L"KM" );
+        register_provider( name, CRYPT_OVERWRITE, &reg );
+        arena_free( &a );
+        RegCloseKey( pk );
+    }
+    RegCloseKey( base );
+}
+
+static LONG create_key( HKEY parent, const WCHAR *name, HKEY *key )
+{
+    return RegCreateKeyExW( parent, name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, key, NULL );
+}
+
+static LONG set_multi( HKEY key, const WCHAR *name, const WCHAR *const *strs, ULONG count )
+{
+    SIZE_T len = 2, i;
+    WCHAR *buf, *p;
+    LONG ret;
+
+    for (i = 0; i < count; i++) len += wcslen( strs[i] ) + 1;
+    if (!(buf = malloc( len * sizeof(WCHAR) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    for (i = 0, p = buf; i < count; i++)
+    {
+        wcscpy( p, strs[i] );
+        p += wcslen( p ) + 1;
+    }
+    p[0] = p[1] = 0;
+    ret = RegSetValueExW( key, name, 0, REG_MULTI_SZ, (const BYTE *)buf, (p - buf + 1) * sizeof(WCHAR) );
+    free( buf );
+    return ret;
+}
+
+static LONG set_multi_list( HKEY key, const WCHAR *name, struct list *list )
+{
+    const WCHAR **strs;
+    struct name_entry *n;
+    ULONG count = 0;
+    LONG ret;
+
+    LIST_FOR_EACH_ENTRY( n, list, struct name_entry, entry ) count++;
+    if (!(strs = malloc( (count + 1) * sizeof(*strs) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    count = 0;
+    LIST_FOR_EACH_ENTRY( n, list, struct name_entry, entry ) strs[count++] = n->name;
+    ret = set_multi( key, name, strs, count );
+    free( strs );
+    return ret;
+}
+
+static LONG set_dword( HKEY key, const WCHAR *name, DWORD val )
+{
+    return RegSetValueExW( key, name, 0, REG_DWORD, (const BYTE *)&val, sizeof(val) );
+}
+
+static LONG save_function( HKEY ik, const struct function *f )
+{
+    struct property *p;
+    HKEY fk, pk;
+    LONG ret;
+
+    if ((ret = create_key( ik, f->name, &fk ))) return ret;
+    if (!(ret = set_multi_list( fk, L"Providers", (struct list *)&f->providers )) &&
+        !(ret = set_dword( fk, L"Flags", f->flags )))
+        ret = set_dword( fk, L"Reserved", f->reserved );
+    if (!ret && !list_empty( &f->properties ))
+    {
+        if (!(ret = create_key( fk, L"Properties", &pk )))
+        {
+            LIST_FOR_EACH_ENTRY( p, &f->properties, struct property, entry )
+                if ((ret = RegSetValueExW( pk, p->name, 0, REG_BINARY, p->data, p->size ))) break;
+            RegCloseKey( pk );
+        }
+    }
+    RegCloseKey( fk );
+    return ret;
+}
+
+static LONG save_context( HKEY tk, const struct context *ctx )
+{
+    const struct function *f, *g;
+    ULONG done[16], ndone = 0, i;
+    HKEY ck, ik;
+    LONG ret;
+
+    if ((ret = create_key( tk, ctx->name, &ck ))) return ret;
+    if ((ret = set_dword( ck, L"Flags", ctx->flags )) || (ret = set_dword( ck, L"Reserved", ctx->reserved )))
+        goto done;
+
+    LIST_FOR_EACH_ENTRY( f, &ctx->functions, struct function, entry )
+    {
+        WCHAR kname[9];
+        const WCHAR **names;
+        ULONG count = 0;
+
+        for (i = 0; i < ndone; i++) if (done[i] == f->iface) break;
+        if (i < ndone) continue;
+        if (ndone < ARRAY_SIZE(done)) done[ndone++] = f->iface;
+
+        LIST_FOR_EACH_ENTRY( g, &ctx->functions, struct function, entry ) if (g->iface == f->iface) count++;
+        if (!(names = malloc( count * sizeof(*names) ))) { ret = ERROR_NOT_ENOUGH_MEMORY; goto done; }
+        count = 0;
+        LIST_FOR_EACH_ENTRY( g, &ctx->functions, struct function, entry )
+            if (g->iface == f->iface) names[count++] = g->name;
+
+        iface_key_name( f->iface, kname );
+        if (!(ret = create_key( ck, kname, &ik )))
+        {
+#ifdef SG_MUTANT_BCCFG_SAVEORD
+            for (i = 0; i < count / 2; i++) { const WCHAR *tmp = names[i]; names[i] = names[count - 1 - i]; names[count - 1 - i] = tmp; }
+#endif
+            ret = set_multi( ik, L"Functions", names, count );
+            LIST_FOR_EACH_ENTRY( g, &ctx->functions, struct function, entry )
+                if (!ret && g->iface == f->iface) ret = save_function( ik, g );
+            RegCloseKey( ik );
+        }
+        free( names );
+        if (ret) goto done;
+    }
+done:
+    RegCloseKey( ck );
+    return ret;
+}
+
+static LONG save_table( ULONG table )
+{
+    const struct context *ctx;
+    HKEY base, tk;
+    LONG ret;
+
+    if ((ret = create_key( HKEY_LOCAL_MACHINE, CONFIG_KEY, &base ))) return ret;
+    ret = RegDeleteTreeW( base, table_key_name( table ) );
+    if (ret == ERROR_FILE_NOT_FOUND) ret = 0;
+    if (!ret && !(ret = create_key( base, table_key_name( table ), &tk )))
+    {
+        LIST_FOR_EACH_ENTRY( ctx, &contexts[table - 1], struct context, entry )
+            if ((ret = save_context( tk, ctx ))) break;
+        RegCloseKey( tk );
+    }
+    RegCloseKey( base );
+    return ret;
+}
+
+static LONG save_image( HKEY pk, const WCHAR *which, const CRYPT_IMAGE_REG *image )
+{
+    HKEY uk, ik;
+    ULONG i;
+    LONG ret;
+
+    if ((ret = create_key( pk, which, &uk ))) return ret;
+    if ((ret = RegSetValueExW( uk, L"Image", 0, REG_SZ, (const BYTE *)image->pszImage,
+                               (wcslen( image->pszImage ) + 1) * sizeof(WCHAR) ))) goto done;
+    for (i = 0; i < image->cInterfaces; i++)
+    {
+        const CRYPT_INTERFACE_REG *in = image->rgpInterfaces[i];
+        WCHAR kname[9];
+
+        iface_key_name( in->dwInterface, kname );
+        if ((ret = create_key( uk, kname, &ik ))) break;
+        if (!(ret = set_multi( ik, L"Functions", (const WCHAR *const *)in->rgpszFunctions, in->cFunctions )))
+            ret = set_dword( ik, L"Flags", in->dwFlags );
+        RegCloseKey( ik );
+        if (ret) break;
+    }
+done:
+    RegCloseKey( uk );
+    return ret;
+}
+
+static LONG save_providers(void)
+{
+    const struct provider *p;
+    HKEY base, pk;
+    LONG ret;
+
+    if ((ret = create_key( HKEY_LOCAL_MACHINE, PROVIDERS_KEY, &base ))) return ret;
+    for (;;)  /* everything stored here was loaded into the model, so rewrite it all */
+    {
+        WCHAR name[256];
+        DWORD len = ARRAY_SIZE(name);
+
+        if (RegEnumKeyExW( base, 0, name, &len, NULL, NULL, NULL, NULL )) break;
+        if ((ret = RegDeleteTreeW( base, name ))) goto done;
+    }
+    LIST_FOR_EACH_ENTRY( p, &providers, struct provider, entry )
+    {
+        if ((ret = create_key( base, p->name, &pk ))) break;
+        ret = set_multi( pk, L"Alias", (const WCHAR *const *)p->reg->rgpszAliases, p->reg->cAliases );
+        if (!ret && p->reg->pUM) ret = save_image( pk, L"UM", p->reg->pUM );
+        if (!ret && p->reg->pKM) ret = save_image( pk, L"KM", p->reg->pKM );
+        RegCloseKey( pk );
+        if (ret) break;
+    }
+done:
+    RegCloseKey( base );
+    return ret;
+}
+
+static LONG save_model( unsigned int dirty )
+{
+    LONG ret = 0;
+
+    /* the Local table last: its existence says the whole store was written */
+    if ((dirty & DIRTY_PROVIDERS) && (ret = save_providers())) return ret;
+    if ((dirty & DIRTY_DOMAIN) && (ret = save_table( CRYPT_DOMAIN ))) return ret;
+    if (dirty & DIRTY_LOCAL) ret = save_table( CRYPT_LOCAL );
+    return ret;
+}
+
+/* called with config_lock held: the model is whatever the registry says now */
+static void config_begin(void)
+{
+    BOOL have_local;
+
+    clear_model();
+    have_local = load_table( CRYPT_LOCAL );
+    load_table( CRYPT_DOMAIN );
+    load_providers();
+    if (have_local) return;  /* the Local key is written last, see save_model() */
+
+    /* a store that was never written: the built-in defaults, written out when
+     * we are allowed to (otherwise they are re-derived on every call) */
+    seed_model();
+    save_model( DIRTY_LOCAL | DIRTY_DOMAIN | DIRTY_PROVIDERS );
+}
+
+/* releases config_lock; a change that succeeded is written back first */
+static NTSTATUS config_end( NTSTATUS status, unsigned int dirty )
+{
+#ifdef SG_MUTANT_BCCFG_NOPERSIST
+    dirty = 0;
+#endif
+    if (!status && dirty)
+    {
+        LONG ret = save_model( dirty );
+        if (ret) status = ret == ERROR_ACCESS_DENIED ? STATUS_ACCESS_DENIED : STATUS_UNSUCCESSFUL;
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
