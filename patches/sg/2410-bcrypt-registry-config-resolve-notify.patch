@@ -1133,6 +1666,436 @@ NTSTATUS WINAPI BCryptEnumProviders( const WCHAR *alg, ULONG *count, BCRYPT_PROV
         }
         free( l.names );
     }
-    ReleaseSRWLockExclusive( &config_lock );
+    return config_end( status, 0 );
+}
+
+/* ---- provider resolution ---- */
+
+struct resolve_item
+{
+    ULONG                     iface;
+    const WCHAR              *func;
+    const WCHAR              *provider;
+    const struct function    *f;      /* the context function, if it is configured */
+    const CRYPT_PROVIDER_REG *reg;
+};
+
+struct resolve_list
+{
+    ULONG                mode;
+    ULONG                count, cap;
+    struct resolve_item *items;
+};
+
+/* does the image register this function for this interface */
+static const CRYPT_INTERFACE_REG *image_interface( const CRYPT_IMAGE_REG *image, ULONG iface, const WCHAR *func )
+{
+    ULONG i, j;
+
+    if (!image) return NULL;
+    for (i = 0; i < image->cInterfaces; i++)
+    {
+        const CRYPT_INTERFACE_REG *in = image->rgpInterfaces[i];
+        if (in->dwInterface != iface) continue;
+        for (j = 0; j < in->cFunctions; j++)
+            if (name_eq( in->rgpszFunctions[j], func )) return in;
+    }
+    return NULL;
+}
+
+static BOOL resolve_wants_um( ULONG mode ) { return mode != CRYPT_KM; }
+static BOOL resolve_wants_km( ULONG mode ) { return mode != CRYPT_UM; }
+
+static BOOL provider_usable( const CRYPT_PROVIDER_REG *reg, ULONG iface, const WCHAR *func, ULONG mode )
+{
+    BOOL um = image_interface( reg->pUM, iface, func ) != NULL;
+    BOOL km = image_interface( reg->pKM, iface, func ) != NULL;
+
+#ifdef SG_MUTANT_BCRES_MODE
+    return um || km;
+#endif
+    switch (mode)
+    {
+    case CRYPT_UM: return um;
+    case CRYPT_KM: return km;
+    case CRYPT_MM: return um && km;
+    default:       return um || km;
+    }
+}
+
+static BOOL resolve_add( struct resolve_list *l, ULONG iface, const struct function *f, const WCHAR *func,
+                         const WCHAR *provider, const WCHAR *only )
+{
+    const struct provider *p;
+
+    if (only && !name_eq( only, provider )) return TRUE;
+    if (!(p = find_provider( provider ))) return TRUE;
+    if (!provider_usable( p->reg, iface, func, l->mode )) return TRUE;
+    if (l->count == l->cap)
+    {
+        ULONG cap = l->cap ? l->cap * 2 : 8;
+        struct resolve_item *items = realloc( l->items, cap * sizeof(*items) );
+        if (!items) return FALSE;
+        l->items = items;
+        l->cap = cap;
+    }
+    l->items[l->count].iface = iface;
+    l->items[l->count].func = func;
+    l->items[l->count].provider = p->name;
+    l->items[l->count].f = f;
+    l->items[l->count].reg = p->reg;
+    l->count++;
+    return TRUE;
+}
+
+static void fill_resolved( struct blob *b, const void *arg )
+{
+    const struct resolve_list *l = arg;
+    CRYPT_PROVIDER_REFS *refs;
+    CRYPT_PROVIDER_REF **list;
+    ULONG i;
+
+    refs = blob_alloc( b, sizeof(*refs) );
+    list = blob_alloc( b, l->count * sizeof(*list) );
+    if (refs)
+    {
+        refs->cProviders = l->count;
+        refs->rgpProviders = list;
+    }
+    for (i = 0; i < l->count; i++)
+    {
+        const struct resolve_item *it = &l->items[i];
+        const struct property *prop;
+        CRYPT_PROVIDER_REF *ref;
+        CRYPT_PROPERTY_REF **props;
+        ULONG nprops = 0, j = 0;
+
+        if (it->f) LIST_FOR_EACH_ENTRY( prop, &it->f->properties, struct property, entry ) nprops++;
+#ifdef SG_MUTANT_BCRES_PROPS
+        nprops = 0;
+#endif
+        ref = blob_alloc( b, sizeof(*ref) );
+        props = blob_alloc( b, nprops * sizeof(*props) );
+        if (ref)
+        {
+            ref->dwInterface = it->iface;
+            ref->cProperties = nprops;
+            ref->rgpProperties = props;
+            ref->pUM = ref->pKM = NULL;
+            list[i] = ref;
+        }
+        {
+            WCHAR *s = blob_str( b, it->func );
+            if (ref) ref->pszFunction = s;
+            s = blob_str( b, it->provider );
+            if (ref) ref->pszProvider = s;
+        }
+        if (nprops) LIST_FOR_EACH_ENTRY( prop, &it->f->properties, struct property, entry )
+        {
+            CRYPT_PROPERTY_REF *pr = blob_alloc( b, sizeof(*pr) );
+            WCHAR *name = blob_str( b, prop->name );
+            BYTE *data = blob_alloc( b, prop->size ? prop->size : 1 );
+
+            if (data && prop->size) memcpy( data, prop->data, prop->size );
+            if (pr)
+            {
+                pr->pszProperty = name;
+                pr->cbValue = prop->size;
+                pr->pbValue = data;
+                props[j] = pr;
+            }
+            j++;
+        }
+        for (j = 0; j < 2; j++)
+        {
+            const CRYPT_IMAGE_REG *src = j ? it->reg->pKM : it->reg->pUM;
+            const CRYPT_INTERFACE_REG *in;
+            CRYPT_IMAGE_REF *image;
+
+            if (!(j ? resolve_wants_km( l->mode ) : resolve_wants_um( l->mode ))) continue;
+            if (!(in = image_interface( src, it->iface, it->func ))) continue;
+            image = blob_alloc( b, sizeof(*image) );
+            {
+                WCHAR *s = blob_str( b, src->pszImage );
+                if (image)
+                {
+                    image->pszImage = s;
+                    image->dwFlags = in->dwFlags;
+                    if (ref) { if (j) ref->pKM = image; else ref->pUM = image; }
+                }
+            }
+        }
+    }
+}
+
+/* Modes and flags as documented: the context defaults to "Default"; a NULL
+ * function (or CRYPT_ALL_FUNCTIONS) walks every function configured for the
+ * interface (0 = every interface); CRYPT_ALL_PROVIDERS lists every registered
+ * provider that offers the function instead of the context's own list; a
+ * provider name narrows the result to that provider.  A provider is only
+ * returned when it is registered and registers the function in the image
+ * kind the mode asks for.  Which table wins when a name is in both is not
+ * documented, the local one is searched first. */
+NTSTATUS WINAPI BCryptResolveProviders( const WCHAR *ctx_name, ULONG iface, const WCHAR *func,
+                                        const WCHAR *provider, ULONG mode, ULONG flags, ULONG *size,
+                                        CRYPT_PROVIDER_REFS **buffer )
+{
+    struct resolve_list l = { mode, 0, 0, NULL };
+    struct context *ctx = NULL;
+    const struct function *f;
+    const struct provider *p;
+    NTSTATUS status = STATUS_SUCCESS;
+    BOOL all_funcs = !func || (flags & CRYPT_ALL_FUNCTIONS);
+    ULONG t;
+
+    TRACE( "%s, %#lx, %s, %s, %#lx, %#lx, %p, %p\n", debugstr_w(ctx_name), iface, debugstr_w(func),
+           debugstr_w(provider), mode, flags, size, buffer );
+
+    if (!size || !buffer || mode < CRYPT_UM || mode > CRYPT_ANY ||
+        (flags & ~(CRYPT_ALL_FUNCTIONS | CRYPT_ALL_PROVIDERS)) || (iface && !valid_interface( iface )) ||
+        (ctx_name && !valid_key_name( ctx_name )) || (func && !valid_name( func )) ||
+        (provider && !valid_name( provider )))
+        return STATUS_INVALID_PARAMETER;
+    if (!ctx_name) ctx_name = L"Default";
+#ifdef SG_MUTANT_BCRES_ALLPROV
+    flags &= ~CRYPT_ALL_PROVIDERS;
+#endif
+
+    AcquireSRWLockExclusive( &config_lock );
+    config_begin();
+    for (t = CRYPT_LOCAL; t <= CRYPT_DOMAIN && !ctx; t++) ctx = find_context( t, ctx_name );
+    if (!ctx) status = STATUS_NOT_FOUND;
+    else
+    {
+        struct resolve_item *targets = NULL;
+        ULONG ntargets = 0, i;
+
+        /* the (interface, function) pairs to resolve, then their providers */
+        LIST_FOR_EACH_ENTRY( f, &ctx->functions, struct function, entry )
+        {
+            if (iface && f->iface != iface) continue;
+            if (!all_funcs && !name_eq( f->name, func )) continue;
+            ntargets++;
+        }
+        if (!(targets = calloc( ntargets + 1, sizeof(*targets) ))) status = STATUS_NO_MEMORY;
+        else
+        {
+            ntargets = 0;
+            LIST_FOR_EACH_ENTRY( f, &ctx->functions, struct function, entry )
+            {
+                if (iface && f->iface != iface) continue;
+                if (!all_funcs && !name_eq( f->name, func )) continue;
+                targets[ntargets].iface = f->iface;
+                targets[ntargets++].f = f;
+            }
+            if (!ntargets && !all_funcs && iface && (flags & CRYPT_ALL_PROVIDERS))
+            {
+                /* not configured in the context, but every provider that has it counts */
+                targets[0].iface = iface;
+                ntargets = 1;
+            }
+            for (i = 0; i < ntargets && status == STATUS_SUCCESS; i++)
+            {
+                const WCHAR *name = targets[i].f ? targets[i].f->name : func;
+
+                if (flags & CRYPT_ALL_PROVIDERS)
+                {
+                    LIST_FOR_EACH_ENTRY( p, &providers, struct provider, entry )
+                        if (!resolve_add( &l, targets[i].iface, targets[i].f, name, p->name, provider ))
+                            status = STATUS_NO_MEMORY;
+                }
+                else if (targets[i].f)
+                {
+                    struct name_entry *n;
+                    LIST_FOR_EACH_ENTRY( n, &targets[i].f->providers, struct name_entry, entry )
+                        if (!resolve_add( &l, targets[i].iface, targets[i].f, name, n->name, provider ))
+                            status = STATUS_NO_MEMORY;
+                }
+            }
+            free( targets );
+        }
+        if (!status && !l.count) status = STATUS_NOT_FOUND;
+        if (!status) status = deliver( fill_resolved, &l, size, (void **)buffer );
+        free( l.items );
+    }
+    return config_end( status, 0 );
+}
+
+/* ---- configuration change notification ---- */
+
+struct notify_entry
+{
+    struct list entry;
+    HANDLE      event;
+};
+
+static SRWLOCK     notify_lock = SRWLOCK_INIT;
+static struct list notify_list = LIST_INIT( notify_list );
+static HANDLE      notify_thread, notify_stop;
+static HMODULE     notify_module;  /* keeps this dll mapped while the thread runs */
+
+static DWORD WINAPI notify_proc( void *arg )
+{
+    HANDLE ready = arg, events[3];
+    HKEY keys[2] = { NULL, NULL };
+    BOOL armed[2] = { FALSE, FALSE };
+    const WCHAR *names[2] = { CONFIG_KEY, PROVIDERS_KEY };
+    ULONG i, n;
+
+    events[0] = notify_stop;
+    for (i = 0, n = 0; i < 2; i++)
+    {
+        HKEY key;
+        /* the keys are created when we may; reading them is enough to be told */
+        if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, names[i], 0, NULL, 0, KEY_NOTIFY, NULL, &key, NULL ) &&
+            RegOpenKeyExW( HKEY_LOCAL_MACHINE, names[i], 0, KEY_NOTIFY, &key )) continue;
+        if (!(events[1 + n] = CreateEventW( NULL, FALSE, FALSE, NULL )))
+        {
+            RegCloseKey( key );
+            continue;
+        }
+        keys[n++] = key;
+    }
+
+    for (;;)
+    {
+        DWORD ret;
+        struct notify_entry *e;
+
+        for (i = 0; i < n; i++)
+        {
+            if (armed[i]) continue;
+            if (!RegNotifyChangeKeyValue( keys[i], TRUE, REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_ATTRIBUTES |
+                                          REG_NOTIFY_CHANGE_LAST_SET, events[1 + i], TRUE )) armed[i] = TRUE;
+        }
+        if (ready)
+        {
+            SetEvent( ready );
+            ready = NULL;
+        }
+        ret = WaitForMultipleObjects( 1 + n, events, FALSE, INFINITE );
+        if (ret == WAIT_OBJECT_0 || ret >= WAIT_OBJECT_0 + 1 + n) break;
+        armed[ret - WAIT_OBJECT_0 - 1] = FALSE;
+
+#ifndef SG_MUTANT_BCNOT_NOSIGNAL
+        AcquireSRWLockShared( &notify_lock );
+        LIST_FOR_EACH_ENTRY( e, &notify_list, struct notify_entry, entry ) SetEvent( e->event );
+        ReleaseSRWLockShared( &notify_lock );
+#endif
+    }
+
+    for (i = 0; i < n; i++)
+    {
+        RegCloseKey( keys[i] );
+        CloseHandle( events[1 + i] );
+    }
+    if (ready) SetEvent( ready );
+    return 0;
+}
+
+static void stop_notify_thread( HANDLE thread, HANDLE stop, HMODULE module )
+{
+    SetEvent( stop );
+    WaitForSingleObject( thread, INFINITE );
+    CloseHandle( thread );
+    CloseHandle( stop );
+    FreeLibrary( module );
+}
+
+/* Which way round the argument goes is not documented for user mode (the
+ * kernel header takes an event object).  A handle to an event the caller
+ * already has is signalled on every change; if *event holds no usable handle
+ * a manual-reset event is created and returned there, which the caller owns
+ * and closes after unregistering it. */
+NTSTATUS WINAPI BCryptRegisterConfigChangeNotify( HANDLE *event )
+{
+    struct notify_entry *e;
+    HANDLE ready = NULL, h, stop = NULL, thread = NULL;
+    DWORD flags;
+    BOOL created = FALSE;
+
+    TRACE( "%p\n", event );
+
+    if (!event) return STATUS_INVALID_PARAMETER;
+    h = *event;
+    if (!h || h == INVALID_HANDLE_VALUE || !GetHandleInformation( h, &flags ))
+    {
+        if (!(h = CreateEventW( NULL, TRUE, FALSE, NULL ))) return STATUS_NO_MEMORY;
+        created = TRUE;
+    }
+    if (!(e = malloc( sizeof(*e) )))
+    {
+        if (created) CloseHandle( h );
+        return STATUS_NO_MEMORY;
+    }
+    e->event = h;
+
+    AcquireSRWLockExclusive( &notify_lock );
+    if (!notify_thread)
+    {
+        HMODULE module = NULL;
+
+        ready = CreateEventW( NULL, FALSE, FALSE, NULL );
+        stop = CreateEventW( NULL, TRUE, FALSE, NULL );
+        GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (const WCHAR *)notify_proc, &module );
+        notify_stop = stop;
+        if (ready && stop && module) thread = CreateThread( NULL, 0, notify_proc, ready, 0, NULL );
+        if (!thread)
+        {
+            ReleaseSRWLockExclusive( &notify_lock );
+            notify_stop = NULL;
+            if (ready) CloseHandle( ready );
+            if (stop) CloseHandle( stop );
+            if (module) FreeLibrary( module );
+            free( e );
+            if (created) CloseHandle( h );
+            return STATUS_NO_MEMORY;
+        }
+        notify_thread = thread;
+        notify_module = module;
+        /* wait until the first change is guaranteed to be seen; the thread
+         * takes notify_lock only after it has said it is ready */
+        WaitForSingleObject( ready, INFINITE );
+        CloseHandle( ready );
+    }
+    list_add_tail( &notify_list, &e->entry );
+    ReleaseSRWLockExclusive( &notify_lock );
+    *event = h;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS WINAPI BCryptUnregisterConfigChangeNotify( HANDLE event )
+{
+    struct notify_entry *e;
+    HANDLE thread = NULL, stop = NULL;
+    HMODULE module = NULL;
+    NTSTATUS status = STATUS_NOT_FOUND;
+
+    TRACE( "%p\n", event );
+
+    if (!event) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &notify_lock );
+    LIST_FOR_EACH_ENTRY( e, &notify_list, struct notify_entry, entry )
+    {
+#ifdef SG_MUTANT_BCNOT_NOUNREG
+        break;
+#endif
+        if (e->event != event) continue;
+        list_remove( &e->entry );
+        free( e );
+        status = STATUS_SUCCESS;
+        break;
+    }
+    if (list_empty( &notify_list ) && notify_thread)
+    {
+        thread = notify_thread;
+        stop = notify_stop;
+        module = notify_module;
+        notify_thread = notify_stop = NULL;
+        notify_module = NULL;
+    }
+    ReleaseSRWLockExclusive( &notify_lock );
+    if (thread) stop_notify_thread( thread, stop, module );
     return status;
 }
