From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 07:26:58 -0700
Subject: [PATCH] mapi32: HrQueryAllRows without a provider, IPropData string
 width

HrQueryAllRows no longer fails when no MAPI provider is installed: it sets the columns, restriction and sort
order, seeks to the start and collects QueryRows batches into one row set (crowsMax limits it). IPropData
GetProps returns a PT_UNSPECIFIED string property in the width the flags ask for (ANSI, or Unicode with
MAPI_UNICODE) and GetPropList reports string tags as PT_STRING8 or PT_UNICODE accordingly.

diff --git a/dlls/mapi32/prop.c b/dlls/mapi32/prop.c
index 8018cee..65ac44b 100644
--- a/dlls/mapi32/prop.c
+++ b/dlls/mapi32/prop.c
@@ -1440,6 +1440,53 @@ static IPropDataItem *IMAPIPROP_GetValue(IPropDataImpl *This, ULONG ulPropTag)
 }
 
 /* Internal - Add a new property value, assumes lock is held */
+/* The string type a caller asked for: ANSI unless MAPI_UNICODE is set */
+static ULONG IMAPIPROP_CharsetTag(ULONG ulPropTag, ULONG ulFlags)
+{
+#ifdef SG_MUTANT_MAPICHARSET
+    return ulPropTag;
+#endif
+    ULONG want = (ulFlags & MAPI_UNICODE) ? PT_UNICODE : PT_STRING8;
+
+    switch (PROP_TYPE(ulPropTag))
+    {
+    case PT_STRING8:
+    case PT_UNICODE:
+        return CHANGE_PROP_TYPE(ulPropTag, want);
+    case PT_MV_STRING8:
+    case PT_MV_UNICODE:
+        return CHANGE_PROP_TYPE(ulPropTag, want | MV_FLAG);
+    }
+    return ulPropTag;
+}
+
+/* Convert a copied PT_STRING8/PT_UNICODE value to the string type asked for */
+static HRESULT IMAPIPROP_ConvertString(IPropDataImpl *This, LPSPropValue prop, LPVOID lpOrig, ULONG ulFlags)
+{
+    BOOL unicode = (ulFlags & MAPI_UNICODE) != 0;
+    LPVOID buf = NULL;
+    int len;
+    HRESULT hr;
+
+    if (PROP_TYPE(prop->ulPropTag) == PT_STRING8 && unicode)
+    {
+        len = MultiByteToWideChar(CP_ACP, 0, prop->Value.lpszA, -1, NULL, 0);
+        if (FAILED(hr = This->lpMore(len * sizeof(WCHAR), lpOrig, &buf))) return hr;
+        MultiByteToWideChar(CP_ACP, 0, prop->Value.lpszA, -1, buf, len);
+        prop->Value.lpszW = buf;
+        prop->ulPropTag = CHANGE_PROP_TYPE(prop->ulPropTag, PT_UNICODE);
+    }
+    else if (PROP_TYPE(prop->ulPropTag) == PT_UNICODE && !unicode)
+    {
+        len = WideCharToMultiByte(CP_ACP, 0, prop->Value.lpszW, -1, NULL, 0, NULL, NULL);
+        if (FAILED(hr = This->lpMore(len, lpOrig, &buf))) return hr;
+        WideCharToMultiByte(CP_ACP, 0, prop->Value.lpszW, -1, buf, len, NULL, NULL);
+        prop->Value.lpszA = buf;
+        prop->ulPropTag = CHANGE_PROP_TYPE(prop->ulPropTag, PT_STRING8);
+    }
+    return S_OK;
+}
+
 static IPropDataItem *IMAPIPROP_AddValue(IPropDataImpl *This,
                                          LPSPropValue lpProp)
 {
@@ -1664,8 +1711,6 @@ static HRESULT WINAPI IPropData_fnGetProps(LPPROPDATA iface, LPSPropTagArray lpT
     if (!iface || ulFlags & ~MAPI_UNICODE || !lpTags || *lpCount || !lppProps)
         return MAPI_E_INVALID_PARAMETER;
 
-    FIXME("semi-stub, flags not supported\n");
-
     *lpCount = lpTags->cValues;
     *lppProps = NULL;
 
@@ -1685,8 +1730,13 @@ static HRESULT WINAPI IPropData_fnGetProps(LPPROPDATA iface, LPSPropTagArray lpT
             item = IMAPIPROP_GetValue(This, lpTags->aulPropTag[i]);
 
             if (item)
+            {
                 hRetTmp = PropCopyMore(&(*lppProps)[i], item->value,
                                        This->lpMore, *lppProps);
+                /* an unspecified type takes the string width the caller asked for */
+                if (SUCCEEDED(hRetTmp) && PROP_TYPE(lpTags->aulPropTag[i]) == PT_UNSPECIFIED)
+                    hRetTmp = IMAPIPROP_ConvertString(This, &(*lppProps)[i], *lppProps, ulFlags);
+            }
             if (FAILED(hRetTmp))
             {
                 hRet = MAPI_W_ERRORS_RETURNED;
@@ -1729,8 +1779,6 @@ static HRESULT WINAPI IPropData_fnGetPropList(LPPROPDATA iface, ULONG ulFlags,
     if (!iface || ulFlags & ~MAPI_UNICODE || !lppTags)
         return MAPI_E_INVALID_PARAMETER;
 
-    FIXME("semi-stub, flags not supported\n");
-
     *lppTags = NULL;
 
     IMAPIPROP_Lock(This);
@@ -1745,7 +1793,7 @@ static HRESULT WINAPI IPropData_fnGetPropList(LPPROPDATA iface, ULONG ulFlags,
         LIST_FOR_EACH(cursor, &This->values)
         {
             LPIPropDataItem current = LIST_ENTRY(cursor, IPropDataItem, entry);
-            (*lppTags)->aulPropTag[i] = current->value->ulPropTag;
+            (*lppTags)->aulPropTag[i] = IMAPIPROP_CharsetTag(current->value->ulPropTag, ulFlags);
             i++;
         }
         (*lppTags)->cValues = This->ulNumValues;
diff --git a/dlls/mapi32/util.c b/dlls/mapi32/util.c
index 3cd18bb..88ab392 100644
--- a/dlls/mapi32/util.c
+++ b/dlls/mapi32/util.c
@@ -934,12 +934,67 @@ HRESULT WINAPI HrQueryAllRows(LPMAPITABLE lpTable, LPSPropTagArray lpPropTags,
     LPSRestriction lpRestriction, LPSSortOrderSet lpSortOrderSet,
     LONG crowsMax, LPSRowSet *lppRows)
 {
+    SRowSet *all = NULL, *chunk;
+    ULONG total = 0, i, want;
+    HRESULT hr;
+
     if (mapiFunctions.HrQueryAllRows)
         return mapiFunctions.HrQueryAllRows(lpTable, lpPropTags, lpRestriction, lpSortOrderSet, crowsMax, lppRows);
 
-    FIXME("(%p, %p, %p, %p, %ld, %p): stub\n", lpTable, lpPropTags, lpRestriction, lpSortOrderSet, crowsMax, lppRows);
+    TRACE("(%p, %p, %p, %p, %ld, %p)\n", lpTable, lpPropTags, lpRestriction, lpSortOrderSet, crowsMax, lppRows);
+
+#ifdef SG_MUTANT_MAPIALL
     *lppRows = NULL;
     return MAPI_E_CALL_FAILED;
+#endif
+    /* no provider: do what the utility does, over the table's own methods */
+    if (!lppRows) return MAPI_E_INVALID_PARAMETER;
+    *lppRows = NULL;
+    if (!lpTable) return MAPI_E_INVALID_PARAMETER;
+
+    if (lpPropTags && FAILED(hr = lpTable->lpVtbl->SetColumns(lpTable, lpPropTags, TBL_BATCH))) return hr;
+    if (lpRestriction && FAILED(hr = lpTable->lpVtbl->Restrict(lpTable, lpRestriction, TBL_BATCH))) return hr;
+    if (lpSortOrderSet && FAILED(hr = lpTable->lpVtbl->SortTable(lpTable, lpSortOrderSet, TBL_BATCH))) return hr;
+    if (FAILED(hr = lpTable->lpVtbl->SeekRow(lpTable, BOOKMARK_BEGINNING, 0, NULL))) return hr;
+
+    if (FAILED(hr = MAPIAllocateBuffer(CbNewSRowSet(0), (void **)&all))) return hr;
+    all->cRows = 0;
+
+    for (;;)
+    {
+        SRowSet *grown;
+
+        want = 32;
+        if (crowsMax > 0 && (ULONG)crowsMax - total < want) want = crowsMax - total;
+        if (!want) break;
+        chunk = NULL;
+        if (FAILED(hr = lpTable->lpVtbl->QueryRows(lpTable, want, 0, &chunk))) goto failed;
+        if (!chunk) break;
+        if (!chunk->cRows)
+        {
+            MAPIFreeBuffer(chunk);
+            break;
+        }
+        if (FAILED(hr = MAPIAllocateBuffer(CbNewSRowSet(total + chunk->cRows), (void **)&grown)))
+        {
+            FreeProws(chunk);
+            goto failed;
+        }
+        memcpy(grown, all, CbNewSRowSet(total));
+        for (i = 0; i < chunk->cRows; i++) grown->aRow[total + i] = chunk->aRow[i];
+        total += chunk->cRows;
+        grown->cRows = total;
+        MAPIFreeBuffer(all);
+        all = grown;
+        MAPIFreeBuffer(chunk); /* the rows' property arrays now belong to the result */
+    }
+
+    *lppRows = all;
+    return S_OK;
+
+failed:
+    FreeProws(all);
+    return hr;
 }
 
 /**************************************************************************
