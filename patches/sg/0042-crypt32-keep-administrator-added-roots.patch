From: Stained Glass OS <dev@stained-glass.example>
Subject: crypt32: keep root certificates an administrator added

HKLM\...\SystemCertificates\Root was treated as a cache of the host's CA
bundle: at every process's first use, a certificate found there but not among
the host's roots counted as "removed on host", and the whole key was wiped and
re-imported. A root an administrator or Group Policy added -- an
organisation's own CA -- vanished at the next program start.

Record the thumbprints of the roots Wine imports itself (its built-in
Microsoft roots and the host bundle) under HKLM\Software\Wine\Crypt32, sync
only those with the host, and set the rest aside and write them back if the
key is rebuilt. A prefix without the record behaves as before once, then keeps
one.

--- a/dlls/crypt32/rootstore.c
+++ b/dlls/crypt32/rootstore.c
@@ -735,13 +735,96 @@
     return memStore;
 }
 
+/* HKLM\Root holds two kinds of certificate: roots Wine imports (its built-in
+ * Microsoft roots and the host's CA bundle), which it keeps in step with the
+ * host, and roots an administrator or Group Policy added, which are the
+ * machine's own and must stay. The thumbprints of the imported ones are kept
+ * here; anything else in HKLM\Root is the administrator's. */
+#define IMPORTED_ROOTS_KEY   L"Software\\Wine\\Crypt32"
+#define IMPORTED_ROOTS_VALUE L"ImportedRootCerts"
+
+static BYTE *read_imported_hashes(DWORD *count)
+{
+    DWORD size = 0, type;
+    BYTE *hashes;
+    HKEY key;
+
+    *count = 0;
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, IMPORTED_ROOTS_KEY, 0, KEY_READ, &key)) return NULL;
+    if (RegQueryValueExW(key, IMPORTED_ROOTS_VALUE, NULL, &type, NULL, &size) || type != REG_BINARY ||
+        size % 20 || !(hashes = CryptMemAlloc(size ? size : 1)))
+    {
+        RegCloseKey(key);
+        return NULL;
+    }
+    if (RegQueryValueExW(key, IMPORTED_ROOTS_VALUE, NULL, NULL, hashes, &size))
+    {
+        CryptMemFree(hashes);
+        hashes = NULL;
+    }
+    else *count = size / 20;
+    RegCloseKey(key);
+    return hashes;
+}
+
+static BOOL cert_sha1(PCCERT_CONTEXT cert, BYTE hash[20])
+{
+    DWORD size = 20;
+    return CertGetCertificateContextProperty(cert, CERT_SHA1_HASH_PROP_ID, hash, &size) && size == 20;
+}
+
+static BOOL hash_listed(const BYTE *hashes, DWORD count, const BYTE hash[20])
+{
+    DWORD i;
+    for (i = 0; i < count; i++) if (!memcmp(hashes + i * 20, hash, 20)) return TRUE;
+    return FALSE;
+}
+
+/* Records every certificate now in HKLM\Root, except the administrator's, as
+ * imported. */
+static void write_imported_hashes(HKEY root_key, HCERTSTORE admin)
+{
+    HCERTSTORE now = CertOpenStore(CERT_STORE_PROV_MEMORY, X509_ASN_ENCODING, 0, CERT_STORE_CREATE_NEW_FLAG, NULL);
+    PCCERT_CONTEXT cert = NULL;
+    BYTE *hashes = NULL, hash[20];
+    DWORD count = 0, n = 0;
+    HKEY key;
+
+    if (!now) return;
+    CRYPT_RegReadSerializedFromReg(root_key, CERT_STORE_CERTIFICATE_CONTEXT_FLAG, now, CERT_STORE_ADD_ALWAYS);
+    while ((cert = CertEnumCertificatesInStore(now, cert))) count++;
+    if (count && (hashes = CryptMemAlloc(count * 20)))
+    {
+        while ((cert = CertEnumCertificatesInStore(now, cert)))
+        {
+            PCCERT_CONTEXT theirs;
+            if (!cert_sha1(cert, hash)) continue;
+            if ((theirs = CertFindCertificateInStore(admin, X509_ASN_ENCODING, 0, CERT_FIND_EXISTING, cert, NULL)))
+            {
+                CertFreeCertificateContext(theirs);
+                continue;
+            }
+            memcpy(hashes + n++ * 20, hash, 20);
+        }
+        if (!RegCreateKeyExW(HKEY_LOCAL_MACHINE, IMPORTED_ROOTS_KEY, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL))
+        {
+            RegSetValueExW(key, IMPORTED_ROOTS_VALUE, 0, REG_BINARY, hashes, n * 20);
+            RegCloseKey(key);
+        }
+        CryptMemFree(hashes);
+    }
+    CertCloseStore(now, 0);
+}
+
 void CRYPT_ImportSystemRootCertsToReg(void)
 {
-    HCERTSTORE store = NULL, reg = NULL;
+    HCERTSTORE store = NULL, reg = NULL, admin = NULL;
     HKEY key = NULL;
     LONG rc;
     HANDLE hsem;
     BOOL delete;
+    BYTE *imported;
+    DWORD imported_count;
 
     static BOOL root_certs_imported = FALSE;
 
@@ -766,13 +849,34 @@
     if (rc)
         goto done;
 
-    if (!(reg = CertOpenStore(CERT_STORE_PROV_MEMORY, X509_ASN_ENCODING, 0, CERT_STORE_CREATE_NEW_FLAG, NULL)))
+    if (!(reg = CertOpenStore(CERT_STORE_PROV_MEMORY, X509_ASN_ENCODING, 0, CERT_STORE_CREATE_NEW_FLAG, NULL)) ||
+        !(admin = CertOpenStore(CERT_STORE_PROV_MEMORY, X509_ASN_ENCODING, 0, CERT_STORE_CREATE_NEW_FLAG, NULL)))
     {
         ERR("Failed to create memory store.\n");
         goto done;
     }
     CRYPT_RegReadSerializedFromReg(key, CERT_STORE_CERTIFICATE_CONTEXT_FLAG, reg, CERT_STORE_ADD_ALWAYS);
 
+    /* Set the administrator's roots aside: the host sync below compares only
+     * what Wine imported against the host. Without a record (a prefix from
+     * before it was kept) everything counts as imported, as it used to. */
+    if ((imported = read_imported_hashes(&imported_count)))
+    {
+        PCCERT_CONTEXT cert = NULL, found;
+        BYTE hash[20];
+
+        while ((cert = CertEnumCertificatesInStore(reg, cert)))
+            if (cert_sha1(cert, hash) && !hash_listed(imported, imported_count, hash))
+            {
+                TRACE("keeping %s, added by the administrator\n", get_cert_common_name(cert));
+                CertAddCertificateContextToStore(admin, cert, CERT_STORE_ADD_ALWAYS, NULL);
+            }
+        while ((cert = CertEnumCertificatesInStore(admin, cert)))
+            if ((found = CertFindCertificateInStore(reg, X509_ASN_ENCODING, 0, CERT_FIND_EXISTING, cert, NULL)))
+                CertDeleteCertificateFromStore(found);
+        CryptMemFree(imported);
+    }
+
     if (!(store = create_root_store(reg, &delete)))
     {
         ERR("Failed to create root store\n");
@@ -782,11 +886,15 @@
         ERR("Error deleting key.\n");
     if (!CRYPT_SerializeContextsToReg(key, 0, pCertInterface, store))
         ERR("Failed to import system certs into registry, %08lx\n", GetLastError());
+    if (delete && !CRYPT_SerializeContextsToReg(key, 0, pCertInterface, admin))
+        ERR("Failed to restore the administrator's roots, %08lx\n", GetLastError());
+    write_imported_hashes(key, admin);
 
 done:
     RegCloseKey(key);
     CertCloseStore(store, 0);
     CertCloseStore(reg, 0);
+    CertCloseStore(admin, 0);
     root_certs_imported = TRUE;
     ReleaseSemaphore(hsem, 1, NULL);
     CloseHandle(hsem);
