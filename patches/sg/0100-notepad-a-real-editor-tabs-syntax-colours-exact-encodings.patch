+#include <commdlg.h>
+#include <shellapi.h>
+#include <shlwapi.h>
+
+#include "notepad_res.h"
+
+#ifndef ARRAY_SIZE
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#endif
+
+/* ---------------------------------------------------------------- textbuf.c
+ * A gap buffer of UTF-16 text that keeps its line ends exactly as they came
+ * (CRLF, LF or CR, even mixed), plus the start of every line.              */
+
+typedef struct
+{
+    WCHAR  *buf;        /* text = buf[0, gap) + buf[gapend, cap) */
+    size_t  cap, gap, gapend;
+    size_t *lines;      /* lines[i] = offset where line i starts; lines[0] = 0 */
+    size_t  nlines, linecap;
+} TEXTBUF;
+
+void    tb_init(TEXTBUF *tb);
+void    tb_free(TEXTBUF *tb);
+BOOL    tb_set(TEXTBUF *tb, const WCHAR *text, size_t len);
+size_t  tb_len(const TEXTBUF *tb);
+WCHAR   tb_at(const TEXTBUF *tb, size_t pos);
+void    tb_get(const TEXTBUF *tb, size_t pos, size_t n, WCHAR *out);
+BOOL    tb_insert(TEXTBUF *tb, size_t pos, const WCHAR *text, size_t n);
+void    tb_delete(TEXTBUF *tb, size_t pos, size_t n);
+const WCHAR *tb_contig(TEXTBUF *tb);
+const WCHAR *tb_range(TEXTBUF *tb, size_t pos, size_t n);
+size_t  tb_line_of(const TEXTBUF *tb, size_t pos);
+size_t  tb_line_start(const TEXTBUF *tb, size_t line);
+size_t  tb_line_end(const TEXTBUF *tb, size_t line);   /* before the line end */
+size_t  tb_line_next(const TEXTBUF *tb, size_t line);  /* after the line end */
+
+/* ---------------------------------------------------------------- syntax.c */
+
+enum
+{
+    ST_DEFAULT, ST_KEYWORD, ST_TYPE, ST_STRING, ST_NUMBER, ST_COMMENT,
+    ST_PREPROC, ST_OPERATOR, ST_FUNCTION, ST_TAG, ST_ATTR, ST_VARIABLE,
+    ST_HEADING, ST_SECTION, ST_KEY, ST_ESCAPE, ST_LINK, ST_EMPHASIS,
+    ST_CONTROL, ST_WHITESPACE, ST_COUNT
+};
+
+enum
+{
+    LANG_TEXT, LANG_C, LANG_CS, LANG_JAVA, LANG_PYTHON, LANG_JS, LANG_TS, LANG_JSON,
+    LANG_XML, LANG_HTML, LANG_CSS, LANG_INI, LANG_REG, LANG_PS, LANG_BATCH,
+    LANG_SHELL, LANG_MARKDOWN, LANG_SQL, LANG_YAML, LANG_RUST, LANG_GO,
+    LANG_COUNT
+};
+
+int  syn_line(int lang, const WCHAR *s, int n, int state, BYTE *styles);
+int  syn_detect(const WCHAR *path, const WCHAR *first_line, int len);
+const WCHAR *syn_name(int lang);
+const WCHAR *syn_line_comment(int lang);
+BOOL syn_block_comment(int lang, const WCHAR **open, const WCHAR **close);
+
+/* ---------------------------------------------------------------- regex.c */
+
+typedef struct regex REGEX;
+REGEX *re_compile(const WCHAR *pattern, BOOL icase, const WCHAR **error);
+void   re_free(REGEX *re);
+int    re_ngroups(const REGEX *re);
+/* searches text[from, len) -- the whole text is visible for anchors and
+ * look-behind of \b; fills groups[2*i], groups[2*i+1] (start, end) */
+BOOL   re_search(REGEX *re, const WCHAR *text, size_t len, size_t from, BOOL backward, size_t *groups);
+
+/* ---------------------------------------------------------------- fileio.c */
+
+typedef enum
+{
+    ENC_UTF8, ENC_UTF8_BOM, ENC_UTF16LE, ENC_UTF16BE, ENC_ANSI, ENC_COUNT
+} ENCODING;
+
+typedef enum { EOL_CRLF, EOL_LF, EOL_CR } EOLTYPE;
+
+typedef struct
+{
+    WCHAR   *text;
+    size_t   len;
+    ENCODING enc;
+    EOLTYPE  eol;
+    BOOL     mixed_eol;
+} LOADED;
+
+/* force: ENC_COUNT = detect */
+DWORD load_file(const WCHAR *path, ENCODING force, LOADED *out);
+/* lossy: set when an ANSI save could not represent every character */
+DWORD save_file(const WCHAR *path, const WCHAR *text, size_t len, ENCODING enc, BOOL *lossy);
+BOOL  ansi_is_lossy(const WCHAR *text, size_t len);
+const WCHAR *enc_name(ENCODING enc);
+const WCHAR *eol_name(EOLTYPE eol);
+const WCHAR *eol_chars(EOLTYPE eol);
+EOLTYPE detect_eol(const WCHAR *text, size_t len, BOOL *mixed);
+
+/* ---------------------------------------------------------------- editor.c */
+
+typedef struct
+{
+    COLORREF bg, fg, gutter_bg, gutter_fg, gutter_cur, curline, sel_bg, sel_bg_inactive,
+             bracket_bg, whitespace, find_bg, caret;
+    COLORREF style[ST_COUNT];
+} EDTHEME;
+
+typedef struct
+{
+    BOOL wrap, line_numbers, cur_line, show_ws, auto_indent, use_spaces, bracket_match;
+    int  tab_width;
+    int  minimap;       /* 0 never, 1 always, 2 for code (not plain text) */
+} EDOPTS;
+
+/* what an editor tells its parent (editor_notify in main.c) */
+enum { EDN_SEL = 1, EDN_CHANGE = 2, EDN_ZOOM = 4, EDN_MODIFIED = 8, EDN_OVERWRITE = 16 };
+
+/* private messages the gate and main.c use */
+#define SGE_GETSTYLEAT   (WM_USER + 0x500)  /* wParam = pos: style at pos */
+#define SGE_GETLANG      (WM_USER + 0x501)
+#define SGE_GETZOOM      (WM_USER + 0x502)
+#define SGE_POSFROMCHAR  (WM_USER + 0x503)  /* wParam = pos: MAKELONG(x, y) client */
+#define SGE_GETTOPLINE   (WM_USER + 0x504)  /* the first line shown */
+#define SGE_GETMINIMAP   (WM_USER + 0x505)  /* MAKELONG(minimap's left x or 0 when none, px per line or 0 compressed) */
+#define SGE_GETMMLINE    (WM_USER + 0x506)  /* wParam = y: the line the minimap shows there (-1 none) */
+#define SGE_GETVISROWS   (WM_USER + 0x507)  /* rows the view shows */
+
+#define EDITOR_CLASS L"SgNotepadEditor"
+
+BOOL   editor_register(HINSTANCE inst);
+HWND   editor_create(HWND parent, HINSTANCE inst);
+void   ed_set_text(HWND hwnd, const WCHAR *text, size_t len);
+size_t ed_length(HWND hwnd);
+const WCHAR *ed_text(HWND hwnd);         /* contiguous; valid until next edit */
+void   ed_get_range(HWND hwnd, size_t pos, size_t n, WCHAR *out);
+void   ed_get_sel(HWND hwnd, size_t *anchor, size_t *caret);
+void   ed_set_sel(HWND hwnd, size_t anchor, size_t caret, BOOL scroll);
+void   ed_replace(HWND hwnd, size_t pos, size_t n, const WCHAR *text, size_t tn);
+void   ed_replace_sel(HWND hwnd, const WCHAR *text, size_t n);
+void   ed_begin_group(HWND hwnd);
+void   ed_end_group(HWND hwnd);
+BOOL   ed_undo(HWND hwnd);
+BOOL   ed_redo(HWND hwnd);
+BOOL   ed_can_undo(HWND hwnd);
+BOOL   ed_can_redo(HWND hwnd);
+BOOL   ed_modified(HWND hwnd);
+void   ed_set_savepoint(HWND hwnd);
+void   ed_cut(HWND hwnd);
+void   ed_copy(HWND hwnd);
+void   ed_paste(HWND hwnd);
+void   ed_delete(HWND hwnd);
+void   ed_select_all(HWND hwnd);
+void   ed_set_font(HWND hwnd, const LOGFONTW *lf);
+void   ed_set_zoom(HWND hwnd, int percent);
+int    ed_get_zoom(HWND hwnd);
+void   ed_set_opts(HWND hwnd, const EDOPTS *opts);
+void   ed_set_theme(HWND hwnd, const EDTHEME *theme);
+void   ed_set_lang(HWND hwnd, int lang);
+int    ed_get_lang(HWND hwnd);
+void   ed_set_eol(HWND hwnd, EOLTYPE eol);
+void   ed_linecol(HWND hwnd, size_t *line, size_t *col);
+size_t ed_line_count(HWND hwnd);
+void   ed_goto_line(HWND hwnd, size_t line);
+BOOL   ed_overwrite(HWND hwnd);
+BOOL   ed_minimap_shown(HWND hwnd);
+void   ed_command(HWND hwnd, UINT cmd);    /* CMD_DUPLICATE_LINE etc. */
+void   ed_scroll_caret(HWND hwnd);
+void   ed_set_find_highlight(HWND hwnd, const WCHAR *text, UINT flags);  /* NULL: none */
+
+/* ---------------------------------------------------------------- find.c */
+
+enum { FIND_CASE = 1, FIND_WORD = 2, FIND_REGEX = 4, FIND_BACK = 8, FIND_NOWRAP = 16 };
+
+/* returns 1 found, 2 found after wrapping, 0 not found, -1 bad pattern */
+int  find_next(HWND ed, const WCHAR *what, UINT flags);
+BOOL find_replace_one(HWND ed, const WCHAR *what, const WCHAR *with, UINT flags);
+int  find_replace_all(HWND ed, const WCHAR *what, const WCHAR *with, UINT flags);
+int  find_count(HWND ed, const WCHAR *what, UINT flags, int *index_of_sel);
+
+/* ---------------------------------------------------------------- print.c */
+
+typedef struct
+{
+    RECT  margins;      /* 1/100 mm */
+    WCHAR header[MAX_PATH], footer[MAX_PATH];
+    HGLOBAL devmode, devnames;
+} PRINTSETUP;
+
+BOOL print_document(HWND owner, HWND ed, const WCHAR *title, const LOGFONTW *lf, PRINTSETUP *ps,
+                    BOOL show_dialog, const WCHAR *printer);
+void print_page_setup(HWND owner, PRINTSETUP *ps);
+
+/* ---------------------------------------------------------------- main.c */
+
+void editor_notify(HWND ed, UINT what);
+
+#endif
