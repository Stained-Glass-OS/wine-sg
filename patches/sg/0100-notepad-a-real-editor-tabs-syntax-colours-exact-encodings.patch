index 0000000..a9e94de
--- /dev/null
+++ b/programs/notepad/textbuf.c
@@ -0,0 +1,245 @@
+/*
+ * Notepad -- gap buffer with a line index
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
