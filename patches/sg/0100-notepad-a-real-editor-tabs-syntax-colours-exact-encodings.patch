+static void command(UINT id)
+{
+    DOC *d = cur_doc();
+    HWND ed = cur_ed(), fe;
+    int i;
+
+    /* the clipboard keys belong to whatever edit box has the focus */
+    if ((fe = focused_edit()))
+    {
+        switch (id)
+        {
+        case CMD_CUT: SendMessageW(fe, WM_CUT, 0, 0); return;
+        case CMD_COPY: SendMessageW(fe, WM_COPY, 0, 0); return;
+        case CMD_PASTE: SendMessageW(fe, WM_PASTE, 0, 0); return;
+        case CMD_UNDO: SendMessageW(fe, EM_UNDO, 0, 0); return;
+        case CMD_SELECT_ALL: SendMessageW(fe, EM_SETSEL, 0, -1); return;
+        case CMD_DELETE: SendMessageW(fe, WM_CLEAR, 0, 0); return;
+        }
+    }
+    if (id >= CMD_RECENT_BASE && id < CMD_RECENT_BASE + MAX_RECENT)
+    {
+        i = id - CMD_RECENT_BASE;
+        if (i < G.nrecent)
+        {
+            WCHAR *p = _wcsdup(G.recent[i]);
+            if (GetFileAttributesW(p) == INVALID_FILE_ATTRIBUTES)
+            {
+                error_box(ERROR_FILE_NOT_FOUND, p);
+                free(G.recent[i]);
+                memmove(G.recent + i, G.recent + i + 1, (G.nrecent - i - 1) * sizeof(WCHAR *));
+                G.nrecent--;
+            }
+            else open_file(p, ENC_COUNT, TRUE);
+            free(p);
+        }
+        return;
+    }
+    if (id >= CMD_LANG_BASE && id < CMD_LANG_BASE + LANG_COUNT)
+    {
+        if (d)
+        {
+            ed_set_lang(ed, id - CMD_LANG_BASE);
+            d->lang_manual = TRUE;
+            update_status();
+        }
+        return;
+    }
+    switch (id)
+    {
+    case CMD_NEW: new_tab(); break;
+    case CMD_NEW_WINDOW: spawn_new_window(); break;
+    case CMD_OPEN: open_dialog(); break;
+    case CMD_SAVE: if (d) save_doc(d); break;
+    case CMD_SAVE_AS: if (d) save_as_dialog(d); break;
+    case CMD_SAVE_ALL:
+        for (i = 0; i < G.ndocs; i++)
+            if (doc_modified(G.docs[i]) && (activate(i), !save_doc(G.docs[i]))) break;
+        break;
+    case CMD_RELOAD: reopen(d, ENC_COUNT); break;
+    case CMD_CLOSE_TAB: close_tab(G.cur); break;
+    case CMD_CLOSE_OTHERS:
+        for (i = G.ndocs - 1; i >= 0; i--)
+            if (G.docs[i] != d) close_tab(i);
+        break;
+    case CMD_RECENT_CLEAR:
+        for (i = 0; i < G.nrecent; i++) free(G.recent[i]);
+        G.nrecent = 0;
+        break;
+    case CMD_PAGE_SETUP: print_page_setup(G.main, &G.ps); save_settings(); break;
+    case CMD_PRINT:
+        if (d)
+        {
+            WCHAR name[MAX_PATH];
+            doc_display_name(d, name, ARRAY_SIZE(name));
+            print_document(G.main, ed, name, &G.lf, &G.ps, TRUE, NULL);
+        }
+        break;
+    case CMD_EXIT: PostMessageW(G.main, WM_CLOSE, 0, 0); break;
+
+    case CMD_UNDO: ed_undo(ed); break;
+    case CMD_REDO: ed_redo(ed); break;
+    case CMD_CUT: ed_cut(ed); break;
+    case CMD_COPY: ed_copy(ed); break;
+    case CMD_PASTE: ed_paste(ed); break;
+    case CMD_DELETE: ed_delete(ed); break;
+    case CMD_SELECT_ALL: ed_select_all(ed); break;
+    case CMD_TIME_DATE: time_date(); break;
+    case CMD_FIND: open_find(FALSE); break;
+    case CMD_REPLACE: open_find(TRUE); break;
+    case CMD_FIND_NEXT: do_find(FALSE); break;
+    case CMD_FIND_PREV: do_find(TRUE); break;
+    case CMD_CLOSE_FIND: close_find(); break;
+    case CMD_GO_TO:
+    {
+        INT_PTR n = DialogBoxW(G.inst, MAKEINTRESOURCEW(DIALOG_GOTO), G.main, goto_proc);
+        if (n > 0) ed_goto_line(ed, n - 1);
+        break;
+    }
+    case CMD_DUPLICATE_LINE: case CMD_DELETE_LINE: case CMD_MOVE_LINE_UP: case CMD_MOVE_LINE_DOWN:
+    case CMD_TOGGLE_COMMENT: case CMD_UPPERCASE: case CMD_LOWERCASE: case CMD_INDENT: case CMD_UNINDENT:
+    case CMD_TRIM_TRAILING: case CMD_TABS_TO_SPACES: case CMD_SPACES_TO_TABS: case CMD_SELECT_LINE:
+    case CMD_GOTO_BRACKET:
+        ed_command(ed, id);
+        break;
+
+    case CMD_WRAP: G.opts.wrap = !G.opts.wrap; set_opts_all(); break;
+    case CMD_FONT: choose_font(); break;
+    case CMD_TAB2: G.opts.tab_width = 2; set_opts_all(); break;
+    case CMD_TAB4: G.opts.tab_width = 4; set_opts_all(); break;
+    case CMD_TAB8: G.opts.tab_width = 8; set_opts_all(); break;
+    case CMD_USE_SPACES: G.opts.use_spaces = !G.opts.use_spaces; set_opts_all(); break;
+    case CMD_AUTO_INDENT: G.opts.auto_indent = !G.opts.auto_indent; set_opts_all(); break;
+    case CMD_EOL_CRLF: case CMD_EOL_LF: case CMD_EOL_CR: convert_eol(d, id - CMD_EOL_CRLF); break;
+    case CMD_REOPEN_UTF8: reopen(d, ENC_UTF8); break;
+    case CMD_REOPEN_UTF16LE: reopen(d, ENC_UTF16LE); break;
+    case CMD_REOPEN_UTF16BE: reopen(d, ENC_UTF16BE); break;
+    case CMD_REOPEN_ANSI: reopen(d, ENC_ANSI); break;
+    case CMD_ENC_UTF8: case CMD_ENC_UTF8_BOM: case CMD_ENC_UTF16LE: case CMD_ENC_UTF16BE: case CMD_ENC_ANSI:
+        if (d && d->enc != (ENCODING)(id - CMD_ENC_UTF8))
+        {
+            d->enc = id - CMD_ENC_UTF8;
+            d->meta_dirty = TRUE;
+            update_title();
+            update_status();
+            InvalidateRect(G.tabs, NULL, FALSE);
+        }
+        break;
+
+    case CMD_ZOOM_IN: ed_set_zoom(ed, ed_get_zoom(ed) + 10); break;
+    case CMD_ZOOM_OUT: ed_set_zoom(ed, ed_get_zoom(ed) - 10); break;
+    case CMD_ZOOM_RESET: ed_set_zoom(ed, 100); break;
+    case CMD_SBAR: G.statusbar = !G.statusbar; layout_main(); break;
+    case CMD_LINE_NUMBERS: G.opts.line_numbers = !G.opts.line_numbers; set_opts_all(); break;
+    case CMD_MINIMAP:
+        /* from "code files" (2) or "always" to off; from off to always */
+        G.opts.minimap = (cur_ed() && ed_minimap_shown(cur_ed())) ? 0 : 1;
+        set_opts_all();
+        break;
+    case CMD_CUR_LINE: G.opts.cur_line = !G.opts.cur_line; set_opts_all(); break;
+    case CMD_SHOW_WS: G.opts.show_ws = !G.opts.show_ws; set_opts_all(); break;
+    case CMD_BRACKETS: G.opts.bracket_match = !G.opts.bracket_match; set_opts_all(); break;
+    case CMD_THEME_SYSTEM: case CMD_THEME_LIGHT: case CMD_THEME_DARK:
+        G.theme_mode = id - CMD_THEME_SYSTEM;
+        apply_theme();
+        break;
+    case CMD_RESTORE_SESSION: G.restore_session = !G.restore_session; break;
+    case CMD_NEXT_TAB: if (G.ndocs > 1) activate((G.cur + 1) % G.ndocs); break;
+    case CMD_PREV_TAB: if (G.ndocs > 1) activate((G.cur + G.ndocs - 1) % G.ndocs); break;
+    case CMD_HELP_CONTENTS:
+    case CMD_HELP_ABOUT_NOTEPAD:
+        ShellAboutW(G.main, load_str(STRING_NOTEPAD), load_str(STRING_ABOUT),
+                    LoadIconW(G.inst, MAKEINTRESOURCEW(IDI_NOTEPAD)));
+        break;
+    }
+}
+
+/* ------------------------------------------------------------ editor notifications */
+
+void editor_notify(HWND ed, UINT what)
+{
+    static BOOL last_modified = -1;
+    DOC *d = cur_doc();
+    if (!d || d->ed != ed) return;
+    if (what & (EDN_CHANGE | EDN_MODIFIED))
+    {
+        BOOL m = doc_modified(d);
+        update_title();
+        if (m != last_modified || (what & EDN_MODIFIED)) InvalidateRect(G.tabs, NULL, FALSE);
+        last_modified = m;
+        if (G.status_msg[0] && (what & EDN_CHANGE)) G.status_msg[0] = 0;
+    }
+    update_status();
+}
+
+/* ------------------------------------------------------------ main window */
+
+static BOOL close_all(void)
+{
+    int i;
+    for (i = 0; i < G.ndocs; i++)
+        if (!confirm_close(i)) return FALSE;
+    return TRUE;
+}
+
+static LRESULT CALLBACK main_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg)
+    {
+    case WM_CREATE:
+        G.main = hwnd;
+        G.tabs = CreateWindowExW(0, L"SgNotepadTabs", NULL, WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS, 0, 0, 0, 0,
+                                 hwnd, NULL, G.inst, NULL);
+        G.tip = CreateWindowExW(WS_EX_TOPMOST, TOOLTIPS_CLASSW, NULL, WS_POPUP | TTS_NOPREFIX | TTS_ALWAYSTIP,
+                                0, 0, 0, 0, hwnd, NULL, G.inst, NULL);
+        if (G.tip)
+        {
+            TTTOOLINFOW ti;
+            memset(&ti, 0, sizeof(ti));
+            ti.cbSize = sizeof(ti);
+            ti.uFlags = TTF_SUBCLASS;
+            ti.hwnd = G.tabs;
+            ti.uId = 1;
+            ti.lpszText = LPSTR_TEXTCALLBACKW;
+            SendMessageW(G.tip, TTM_ADDTOOLW, 0, (LPARAM)&ti);
+            SendMessageW(G.tip, TTM_SETMAXTIPWIDTH, 0, S(600));
+        }
+        G.status = CreateWindowExW(0, L"SgNotepadStatus", NULL, WS_CHILD | WS_CLIPSIBLINGS, 0, 0, 0, 0,
+                                   hwnd, NULL, G.inst, NULL);
+        DragAcceptFiles(hwnd, TRUE);
+        SetTimer(hwnd, 1, 1500, NULL);
+        return 0;
+    case WM_SIZE:
+        layout_main();
+        return 0;
+    case WM_SETFOCUS:
+        if (cur_ed()) SetFocus(cur_ed());
+        return 0;
+    case WM_ACTIVATEAPP:
+        if (wp) PostMessageW(hwnd, WM_TIMER, 1, 0);
+        return 0;
+    case WM_TIMER:
+        if (wp == 1 && GetForegroundWindow() == hwnd) check_disk(cur_doc());
+        return 0;
+    case WM_INITMENUPOPUP:
+        init_menu((HMENU)wp);
+        return 0;
+    case WM_MEASUREITEM:
+        if (menubar_measure((MEASUREITEMSTRUCT *)lp)) return TRUE;
+        break;
+    case WM_DRAWITEM:
+        if (menubar_draw((DRAWITEMSTRUCT *)lp)) return TRUE;
+        break;
+    case WM_MENUCHAR:
+    {
+        LRESULT r = menubar_char(LOWORD(wp), (HMENU)lp);
+        if (r) return r;
+        break;
+    }
+    case WM_COMMAND:
+        command(LOWORD(wp));
+        return 0;
+    case WM_DROPFILES:
+    {
+        HDROP drop = (HDROP)wp;
+        UINT i, n = DragQueryFileW(drop, 0xffffffff, NULL, 0);
+        for (i = 0; i < n; i++)
+        {
+            WCHAR path[MAX_PATH * 4];
+            if (DragQueryFileW(drop, i, path, ARRAY_SIZE(path))) open_file(path, ENC_COUNT, TRUE);
+        }
+        DragFinish(drop);
+        SetForegroundWindow(hwnd);
+        return 0;
+    }
+    case WM_SETTINGCHANGE:
+        if (G.theme_mode == 0) apply_theme();
+        return 0;
+    case WM_QUERYENDSESSION:
+        return close_all();
+    case WM_CLOSE:
+        if (!close_all()) return 0;
+        save_session();
+        G.closing = TRUE;
+        DestroyWindow(hwnd);
+        return 0;
+    case WM_DESTROY:
+        save_settings();
+        PostQuitMessage(0);
+        return 0;
+
+    case SGN_TABCOUNT: return G.ndocs;
+    case SGN_ACTIVETAB: return G.cur;
+    case SGN_GETEDITOR:
+    {
+        int i = (int)wp < 0 ? G.cur : (int)wp;
+        return (i >= 0 && i < G.ndocs) ? (LRESULT)G.docs[i]->ed : 0;
+    }
+    case SGN_ISMODIFIED:
+    {
+        int i = (int)wp < 0 ? G.cur : (int)wp;
+        return (i >= 0 && i < G.ndocs) ? doc_modified(G.docs[i]) : -1;
+    }
+    case SGN_GETENC:
+    {
+        int i = (int)wp < 0 ? G.cur : (int)wp;
+        return (i >= 0 && i < G.ndocs) ? MAKELONG(G.docs[i]->enc, G.docs[i]->eol) : -1;
+    }
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+/* ------------------------------------------------------------ command line */
+
+typedef struct
+{
+    BOOL     print;
+    WCHAR   *printer;
+    ENCODING force;
+    WCHAR  **files;
+    int      nfiles;
+} CMDLINE;
+
+static WCHAR *take_arg(WCHAR **p)
+{
+    WCHAR *s = *p, *start;
+    while (*s == ' ' || *s == '\t') s++;
+    if (!*s) { *p = s; return NULL; }
+    if (*s == '"')
+    {
+        start = ++s;
+        while (*s && *s != '"') s++;
+    }
+    else
+    {
+        start = s;
+        while (*s && *s != ' ' && *s != '\t') s++;
+    }
+    if (*s) *s++ = 0;
+    *p = s;
+    return start;
+}
+
+static void parse_cmdline(WCHAR *cmd, CMDLINE *cl)
+{
+    WCHAR *p = cmd, *arg;
+    memset(cl, 0, sizeof(*cl));
+    cl->force = ENC_COUNT;
+
+    /* skip the program name */
+    while (*p == ' ') p++;
+    if (*p == '"') { p++; while (*p && *p != '"') p++; if (*p) p++; }
+    else while (*p && *p != ' ') p++;
+
+    for (;;)
+    {
+        while (*p == ' ' || *p == '\t') p++;
+        if ((*p == '/' || *p == '-') && p[1] && (p[2] == ' ' || p[2] == '\t' || !p[2] ||
+                                                 ((p[1] == 'p' || p[1] == 'P') && (p[2] == 't' || p[2] == 'T') &&
+                                                  (p[3] == ' ' || !p[3]))))
+        {
+            WCHAR o = towlower(p[1]);
+            BOOL pt = (o == 'p' && (p[2] == 't' || p[2] == 'T'));
+            p += pt ? 3 : 2;
+            if (o == 'p') cl->print = TRUE;
+            else if (o == 'a') cl->force = ENC_ANSI;
+            else if (o == 'w') cl->force = ENC_UTF16LE;
+            if (pt)
+            {
+                /* /pt "file" "printer" "driver" "port" */
+                WCHAR *f = take_arg(&p);
+                if (f)
+                {
+                    cl->files = calloc(1, sizeof(WCHAR *));
+                    cl->files[0] = f;
+                    cl->nfiles = 1;
+                }
+                cl->printer = take_arg(&p);
+                return;
+            }
+            continue;
+        }
+        break;
+    }
+    if (!*p) return;
+    /* several quoted paths open several tabs; otherwise, as on Windows, the
+     * whole rest of the line is one path (unquoted spaces included) */
+    cl->files = calloc(64, sizeof(WCHAR *));
+    if (!cl->files) return;
+    if (*p == '"')
+    {
+        while ((arg = take_arg(&p)) && cl->nfiles < 64)
+        {
+            cl->files[cl->nfiles++] = arg;
+            while (*p == ' ') p++;
+            if (*p && *p != '"') break;
+        }
+    }
+    else
+    {
+        WCHAR *e = p + lstrlenW(p);
+        while (e > p && (e[-1] == ' ' || e[-1] == '\t')) *--e = 0;
+        cl->files[cl->nfiles++] = p;
+    }
+}
+
+/* Windows Notepad: a missing name without an extension is tried as .txt;
+ * a missing file may be created */
+static BOOL open_cmdline_file(const WCHAR *name, ENCODING force)
+{
+    WCHAR buf[MAX_PATH * 4], full[MAX_PATH * 4];
+    const WCHAR *file = name;
+
+    if (GetFileAttributesW(file) == INVALID_FILE_ATTRIBUTES && !wcschr(PathFindFileNameW(file), '.'))
+    {
+        lstrcpynW(buf, name, ARRAY_SIZE(buf) - 5);
+        lstrcatW(buf, L".txt");
+        file = buf;
+    }
+    if (GetFileAttributesW(file) != INVALID_FILE_ATTRIBUTES) return open_file(file, force, TRUE);
+
+    if (!GetFullPathNameW(file, ARRAY_SIZE(full), full, NULL)) lstrcpynW(full, file, ARRAY_SIZE(full));
+    switch (msgbox(MB_ICONEXCLAMATION | MB_YESNOCANCEL, STRING_DOESNOTEXIST, full))
+    {
+    case IDYES:
+    {
+        HANDLE h = CreateFileW(full, GENERIC_WRITE, FILE_SHARE_READ, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (h == INVALID_HANDLE_VALUE) { error_box(GetLastError(), full); return TRUE; }
+        CloseHandle(h);
+        return open_file(full, force, TRUE);
+    }
+    case IDNO:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+static void restore_session(void)
+{
+    HKEY key;
+    WCHAR *paths[64];
+    int n, i, active;
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, NOTEPAD_KEY, 0, KEY_READ, &key)) return;
+    n = reg_multi(key, L"sgSession", paths, ARRAY_SIZE(paths));
+    active = reg_dword(key, L"sgSessionActive", 0);
+    RegCloseKey(key);
+    for (i = 0; i < n; i++)
+    {
+        if (GetFileAttributesW(paths[i]) != INVALID_FILE_ATTRIBUTES) open_file(paths[i], ENC_COUNT, TRUE);
+        free(paths[i]);
+    }
+    if (n && active < G.ndocs) activate(active);
+}
+
+/* ------------------------------------------------------------ entry */
+
+static void register_classes(void)
+{
+    WNDCLASSEXW wc;
+    memset(&wc, 0, sizeof(wc));
+    wc.cbSize = sizeof(wc);
+    wc.lpfnWndProc = main_proc;
+    wc.hInstance = G.inst;
+    wc.hIcon = LoadIconW(G.inst, MAKEINTRESOURCEW(IDI_NOTEPAD));
+    wc.hIconSm = LoadImageW(G.inst, MAKEINTRESOURCEW(IDI_NOTEPAD), IMAGE_ICON, GetSystemMetrics(SM_CXSMICON),
+                            GetSystemMetrics(SM_CYSMICON), LR_SHARED);
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW);
+    wc.hbrBackground = NULL;
+    wc.lpszMenuName = MAKEINTRESOURCEW(MAIN_MENU);
+    wc.lpszClassName = L"Notepad";
+    RegisterClassExW(&wc);
+
+    wc.lpfnWndProc = tabs_proc;
+    wc.style = CS_DBLCLKS;
+    wc.hIcon = wc.hIconSm = NULL;
+    wc.lpszMenuName = NULL;
+    wc.lpszClassName = L"SgNotepadTabs";
+    RegisterClassExW(&wc);
+
+    wc.lpfnWndProc = status_proc;
+    wc.style = 0;
+    wc.lpszClassName = L"SgNotepadStatus";
+    RegisterClassExW(&wc);
+
+    editor_register(G.inst);
+}
+
+static void make_fonts(void)
+{
+    NONCLIENTMETRICSW ncm;
+    LOGFONTW lf;
+    ncm.cbSize = sizeof(ncm);
+    SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0);
+    lf = ncm.lfMessageFont;
+    G.ui_font = CreateFontIndirectW(&lf);
+    lf.lfWeight = FW_SEMIBOLD;
+    G.ui_bold = CreateFontIndirectW(&lf);
+    lf = ncm.lfMessageFont;
+    lf.lfHeight = lf.lfHeight * 6 / 5;
+    G.sym_font = CreateFontIndirectW(&lf);
+}
+
+int WINAPI wWinMain(HINSTANCE inst, HINSTANCE prev, LPWSTR unused, int show)
+{
+    MSG msg;
+    HACCEL accel;
+    CMDLINE cl;
+    WCHAR *cmd = _wcsdup(GetCommandLineW());
+    HDC dc;
+    BOOL other_window;
+    int i;
+    RECT r;
+    MONITORINFO mi;
+
+    InitCommonControls();
+    G.inst = inst;
+    G.cur = -1;
+    G.hot_tab = G.hot_close = G.press_tab = -1;
+    dc = GetDC(NULL);
+    G.dpi = GetDeviceCaps(dc, LOGPIXELSY);
+    ReleaseDC(NULL, dc);
+    G.tab_h = S(40);
+    G.status_h = S(26);
+    other_window = FindWindowW(L"Notepad", NULL) != NULL;
+
+    load_settings();
+    make_theme();
+    make_fonts();
+    register_classes();
+    parse_cmdline(cmd, &cl);
+
+    r = G.window_rect;
+    mi.cbSize = sizeof(mi);
+    GetMonitorInfoW(MonitorFromRect(&r, MONITOR_DEFAULTTOPRIMARY), &mi);
+    if (r.left == CW_USEDEFAULT || r.left >= mi.rcWork.right || r.top >= mi.rcWork.bottom || r.right <= mi.rcWork.left ||
+        r.bottom <= mi.rcWork.top || r.right - r.left < 200 || r.bottom - r.top < 150)
+        r.left = r.top = CW_USEDEFAULT;
+    G.main = CreateWindowExW(0, L"Notepad", L"Notepad", WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN,
+                             r.left, r.top, max(200, r.right - r.left), max(150, r.bottom - r.top),
+                             NULL, NULL, inst, NULL);
+    if (!G.main) return 1;
+    theme_menubar();
+    new_tab();
+
+    if (cl.print && cl.nfiles)
+    {
+        /* /p and /pt print and exit without showing a window, as on Windows */
+        if (open_file(cl.files[0], cl.force, FALSE))
+        {
+            WCHAR name[MAX_PATH];
+            doc_display_name(cur_doc(), name, ARRAY_SIZE(name));
+            print_document(G.main, cur_ed(), name, &G.lf, &G.ps, FALSE, cl.printer);
+        }
+        G.closing = TRUE;
+        DestroyWindow(G.main);
+        return 0;
+    }
+
+    ShowWindow(G.main, show);
+    UpdateWindow(G.main);
+    if (cl.nfiles)
+    {
+        for (i = 0; i < cl.nfiles; i++)
+            if (!open_cmdline_file(cl.files[i], cl.force))
+            {
+                DestroyWindow(G.main);
+                break;
+            }
+    }
+    else if (G.restore_session && !other_window)
+        restore_session();
 
+    accel = LoadAcceleratorsW(inst, MAKEINTRESOURCEW(ID_ACCEL));
     while (GetMessageW(&msg, 0, 0, 0))
     {
-        if (!IsDialogMessageW(Globals.hFindReplaceDlg, &msg) && !TranslateAcceleratorW(Globals.hMainWnd, hAccel, &msg))
-	{
-	    TranslateMessage(&msg);
-            DispatchMessageW(&msg);
-	}
+        if (TranslateAcceleratorW(G.main, accel, &msg)) continue;
+        if (G.findbar && IsWindowVisible(G.findbar) && IsDialogMessageW(G.findbar, &msg)) continue;
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
     }
-    return msg.wParam;
+    free(cl.files);
+    free(cmd);
+    return (int)msg.wParam;
 }
