+    if ((sub = find_submenu(GetMenu(G.main), CMD_LANG_BASE)) && (m == sub || GetMenuItemCount(sub) < LANG_COUNT))
+    {
+        while (GetMenuItemCount(sub)) DeleteMenu(sub, 0, MF_BYPOSITION);
