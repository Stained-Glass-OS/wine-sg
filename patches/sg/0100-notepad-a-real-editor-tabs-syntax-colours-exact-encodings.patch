+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Line ends are kept in the text exactly as the file had them, so a save
+ * writes back the same bytes.  CRLF, a lone LF and a lone CR each end a line.
+ * An edit can join or split a CRLF pair at its edges, so after every edit the
+ * line starts around it are recomputed from the text rather than patched. */
+
+#include "notepad.h"
+
+void tb_init(TEXTBUF *tb)
+{
+    memset(tb, 0, sizeof(*tb));
+    tb->linecap = 64;
+    tb->lines = malloc(tb->linecap * sizeof(size_t));
+    tb->lines[0] = 0;
+    tb->nlines = 1;
+}
+
+void tb_free(TEXTBUF *tb)
+{
+    free(tb->buf);
+    free(tb->lines);
+    memset(tb, 0, sizeof(*tb));
+}
+
+size_t tb_len(const TEXTBUF *tb)
+{
+    return tb->cap - (tb->gapend - tb->gap);
+}
+
+WCHAR tb_at(const TEXTBUF *tb, size_t pos)
+{
+    if (pos < tb->gap) return tb->buf[pos];
+    pos += tb->gapend - tb->gap;
+    return pos < tb->cap ? tb->buf[pos] : 0;
+}
+
+void tb_get(const TEXTBUF *tb, size_t pos, size_t n, WCHAR *out)
+{
+    if (pos < tb->gap)
+    {
+        size_t k = min(n, tb->gap - pos);
+        memcpy(out, tb->buf + pos, k * sizeof(WCHAR));
+        out += k; pos += k; n -= k;
+    }
+    if (n) memcpy(out, tb->buf + tb->gapend + (pos - tb->gap), n * sizeof(WCHAR));
+}
+
+static void move_gap(TEXTBUF *tb, size_t pos)
+{
+    size_t glen = tb->gapend - tb->gap;
+    if (pos < tb->gap)
+        memmove(tb->buf + pos + glen, tb->buf + pos, (tb->gap - pos) * sizeof(WCHAR));
+    else if (pos > tb->gap)
+        memmove(tb->buf + tb->gap, tb->buf + tb->gapend, (pos - tb->gap) * sizeof(WCHAR));
+    tb->gap = pos;
+    tb->gapend = pos + glen;
+}
+
+static BOOL reserve(TEXTBUF *tb, size_t n)
+{
+    size_t len = tb_len(tb), newcap, tail;
+    WCHAR *nb;
+
+    if (tb->gapend - tb->gap >= n) return TRUE;
+    newcap = len + n + len / 2 + 4096;
+    if (!(nb = malloc(newcap * sizeof(WCHAR)))) return FALSE;
+    tail = tb->cap - tb->gapend;
+    if (tb->buf)
+    {
+        memcpy(nb, tb->buf, tb->gap * sizeof(WCHAR));
+        memcpy(nb + newcap - tail, tb->buf + tb->gapend, tail * sizeof(WCHAR));
+    }
+    free(tb->buf);
+    tb->buf = nb;
+    tb->gapend = newcap - tail;
+    tb->cap = newcap;
+    return TRUE;
+}
+
+const WCHAR *tb_contig(TEXTBUF *tb)
+{
+    if (!tb->buf) reserve(tb, 16);
+    move_gap(tb, tb_len(tb));
+    return tb->buf;
+}
+
+const WCHAR *tb_range(TEXTBUF *tb, size_t pos, size_t n)
+{
+    if (!tb->buf) reserve(tb, 16);
+    if (pos + n <= tb->gap) return tb->buf + pos;
+    if (pos >= tb->gap) return tb->buf + tb->gapend + (pos - tb->gap);
+    move_gap(tb, pos);
+    return tb->buf + tb->gapend;
+}
+
+/* ------------------------------------------------------------ line index */
+
+static BOOL lines_reserve(TEXTBUF *tb, size_t n)
+{
+    size_t *nl, cap;
+    if (tb->nlines + n <= tb->linecap) return TRUE;
+    cap = tb->nlines + n + tb->nlines / 2 + 64;
+    if (!(nl = realloc(tb->lines, cap * sizeof(size_t)))) return FALSE;
+    tb->lines = nl;
+    tb->linecap = cap;
+    return TRUE;
+}
+
+/* first index whose start is > pos */
+static size_t upper_bound(const TEXTBUF *tb, size_t pos)
+{
+    size_t lo = 0, hi = tb->nlines;
+    while (lo < hi)
+    {
+        size_t mid = (lo + hi) / 2;
+        if (tb->lines[mid] <= pos) lo = mid + 1;
+        else hi = mid;
+    }
+    return lo;
+}
+
+size_t tb_line_of(const TEXTBUF *tb, size_t pos)
+{
+    size_t i = upper_bound(tb, pos);
+    return i ? i - 1 : 0;
+}
+
+size_t tb_line_start(const TEXTBUF *tb, size_t line)
+{
+    if (line >= tb->nlines) return tb_len(tb);
+    return tb->lines[line];
+}
+
+size_t tb_line_next(const TEXTBUF *tb, size_t line)
+{
+    if (line + 1 >= tb->nlines) return tb_len(tb);
+    return tb->lines[line + 1];
+}
+
+size_t tb_line_end(const TEXTBUF *tb, size_t line)
+{
+    size_t e, s;
+    if (line + 1 >= tb->nlines) return tb_len(tb);
+    e = tb->lines[line + 1];
+    s = tb->lines[line];
+    if (e >= s + 2 && tb_at(tb, e - 1) == '\n' && tb_at(tb, e - 2) == '\r') return e - 2;
+    return e - 1;
+}
+
+/* Collect the line starts s with from < s <= limit found by scanning the text
+ * from `from`, and splice them in place of the old entries [i, j). */
+static BOOL relex(TEXTBUF *tb, size_t from, size_t limit, size_t i, size_t j, ptrdiff_t delta)
+{
+    size_t len = tb_len(tb), p, k, cnt = 0, cap = 16;
+    size_t *found = malloc(cap * sizeof(size_t));
+
+    if (!found) return FALSE;
+    for (p = from; p < len && p < limit; p++)
+    {
+        WCHAR c = tb_at(tb, p);
+        size_t start;
+        if (c == '\n') start = p + 1;
+        else if (c == '\r')
+        {
+            if (p + 1 < len && tb_at(tb, p + 1) == '\n') { start = p + 2; p++; }
+            else start = p + 1;
+        }
+        else continue;
+        if (start > limit) break;
+        if (cnt == cap)
+        {
+            size_t *nf = realloc(found, (cap *= 2) * sizeof(size_t));
+            if (!nf) { free(found); return FALSE; }
+            found = nf;
+        }
+        found[cnt++] = start;
+    }
+    for (k = j; k < tb->nlines; k++) tb->lines[k] += delta;
+    if (cnt > j - i && !lines_reserve(tb, cnt - (j - i))) { free(found); return FALSE; }
+    memmove(tb->lines + i + cnt, tb->lines + j, (tb->nlines - j) * sizeof(size_t));
+    memcpy(tb->lines + i, found, cnt * sizeof(size_t));
+    tb->nlines = tb->nlines - (j - i) + cnt;
+    free(found);
+    return TRUE;
+}
+
+BOOL tb_set(TEXTBUF *tb, const WCHAR *text, size_t len)
+{
+    tb->gap = 0;
+    tb->gapend = tb->cap;
+    if (!reserve(tb, len + 1)) return FALSE;
+    memcpy(tb->buf, text, len * sizeof(WCHAR));
+    tb->gap = len;
+    tb->nlines = 1;
+    tb->lines[0] = 0;
+    return relex(tb, 0, len + 1, 1, 1, 0);
+}
+
+BOOL tb_insert(TEXTBUF *tb, size_t pos, const WCHAR *text, size_t n)
+{
+    size_t a, i, j;
+    if (!n) return TRUE;
+    if (!reserve(tb, n)) return FALSE;
+    move_gap(tb, pos);
+    memcpy(tb->buf + tb->gap, text, n * sizeof(WCHAR));
+    tb->gap += n;
+
+    a = tb->lines[tb_line_of(tb, pos ? pos - 1 : 0)];
+    i = upper_bound(tb, a);
+    j = upper_bound(tb, pos + 1);
+    return relex(tb, a, pos + n + 1, i, j, (ptrdiff_t)n);
+}
+
+void tb_delete(TEXTBUF *tb, size_t pos, size_t n)
+{
+    size_t a, i, j, len = tb_len(tb);
+    if (pos >= len || !n) return;
+    if (n > len - pos) n = len - pos;
+    move_gap(tb, pos);
+    tb->gapend += n;
+
+    a = tb->lines[tb_line_of(tb, pos ? pos - 1 : 0)];
+    i = upper_bound(tb, a);
+    j = upper_bound(tb, pos + n + 1);
+    relex(tb, a, pos + 1, i, j, -(ptrdiff_t)n);
+}
