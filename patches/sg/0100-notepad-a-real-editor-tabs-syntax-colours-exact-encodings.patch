+static void open_find(BOOL replace)
+{
+    HWND ed = cur_ed();
+    size_t a, c;
+    if (!G.findbar)
+    {
+        G.findbar = CreateDialogParamW(G.inst, MAKEINTRESOURCEW(IDD_FINDBAR), G.main, findbar_proc, 0);
+        if (!G.findbar) return;
+    }
+    G.replace_mode = replace;
+    /* a one-line selection seeds the search */
+    if (ed)
+    {
+        ed_get_sel(ed, &a, &c);
+        if (a != c && (a > c ? a - c : c - a) < ARRAY_SIZE(G.find_text) - 1)
+        {
+            size_t s = min(a, c), n = (a > c ? a - c : c - a), i;
+            WCHAR buf[1024];
+            ed_get_range(ed, s, n, buf);
+            buf[n] = 0;
+            for (i = 0; i < n && buf[i] != '\r' && buf[i] != '\n'; i++);
+            if (i == n) lstrcpyW(G.find_text, buf);
+        }
+    }
+    SetDlgItemTextW(G.findbar, IDC_FIND_TEXT, G.find_text);
+    SetDlgItemTextW(G.findbar, IDC_REPLACE_TEXT, G.replace_text);
+    ShowWindow(G.findbar, SW_SHOW);
+    layout_main();
+    SetFocus(GetDlgItem(G.findbar, replace && G.find_text[0] ? IDC_REPLACE_TEXT : IDC_FIND_TEXT));
+    SendDlgItemMessageW(G.findbar, IDC_FIND_TEXT, EM_SETSEL, 0, -1);
+    show_find_count();
+}
