+static void layout_main(void)
+{
+    RECT rc;
+    int top, bottom, i;
+    HDWP dwp;
+
+    if (!G.main) return;
+    GetClientRect(G.main, &rc);
+    top = G.tab_h;
+    bottom = rc.bottom - (G.statusbar ? G.status_h : 0);
+    dwp = BeginDeferWindowPos(4);
+    dwp = DeferWindowPos(dwp, G.tabs, 0, 0, 0, rc.right, G.tab_h, SWP_NOZORDER);
+    if (G.findbar && IsWindowVisible(G.findbar))
+    {
+        int h = G.replace_mode ? S(72) : S(37);
+        dwp = DeferWindowPos(dwp, G.findbar, HWND_TOP, 0, top, rc.right, h, 0);
+        top += h;
+    }
+    if (G.statusbar) dwp = DeferWindowPos(dwp, G.status, 0, 0, bottom, rc.right, G.status_h, SWP_NOZORDER | SWP_SHOWWINDOW);
+    else dwp = DeferWindowPos(dwp, G.status, 0, 0, 0, 0, 0, SWP_NOZORDER | SWP_HIDEWINDOW);
+    EndDeferWindowPos(dwp);
+    for (i = 0; i < G.ndocs; i++)
+        SetWindowPos(G.docs[i]->ed, 0, 0, top, rc.right, max(0, bottom - top), SWP_NOZORDER | SWP_NOACTIVATE);
+    if (G.findbar && IsWindowVisible(G.findbar)) layout_findbar();
+    InvalidateRect(G.tabs, NULL, FALSE);
