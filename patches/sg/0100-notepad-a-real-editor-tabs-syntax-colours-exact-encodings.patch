+static void check_disk(DOC *d)
+{
+    WIN32_FILE_ATTRIBUTE_DATA fad;
+    ULONGLONG size;
+    if (!d || !d->path || !d->have_ft || d->prompting) return;
+    if (!GetFileAttributesExW(d->path, GetFileExInfoStandard, &fad))
+    {
+        if (!d->gone)
+        {
+            WCHAR msg[MAX_PATH + 128];
+            d->gone = TRUE;
+            wsprintfW(msg, load_str(STRING_DELETED_ON_DISK), d->name);
+            set_status_msg(msg);
+            d->meta_dirty = TRUE;
+            update_title();
+            InvalidateRect(G.tabs, NULL, FALSE);
+        }
+        return;
+    }
+    size = ((ULONGLONG)fad.nFileSizeHigh << 32) | fad.nFileSizeLow;
+    if (!d->gone && !CompareFileTime(&fad.ftLastWriteTime, &d->ft) && size == d->size) return;
+    d->prompting = TRUE;
+    if (msgbox(MB_ICONQUESTION | MB_YESNO, STRING_CHANGED_ON_DISK, d->path) == IDYES)
+    {
+        WCHAR *path = _wcsdup(d->path);
+        size_t line, col;
+        ed_linecol(d->ed, &line, &col);
+        load_into(d, path, ENC_COUNT);
+        ed_goto_line(d->ed, line);
+        free(path);
+        update_title();
+        update_status();
+        InvalidateRect(G.tabs, NULL, FALSE);
+    }
+    else
+    {
+        d->ft = fad.ftLastWriteTime;
+        d->size = size;
+        d->gone = FALSE;
+    }
+    d->prompting = FALSE;
+}
