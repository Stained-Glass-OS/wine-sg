-static inline BOOL is_conversion_to_ansi_lossy(LPCWSTR textW, int lenW)
-{
-    BOOL ret = FALSE;
-    WideCharToMultiByte(CP_ACP, WC_NO_BEST_FIT_CHARS, textW, lenW, NULL, 0,
-                        NULL, &ret);
-    return ret;
