+
+const WCHAR *syn_name(int lang)
+{
+    if (lang < 0 || lang >= LANG_COUNT) lang = LANG_TEXT;
+    return langs[lang].name;
+}
+
+const WCHAR *syn_line_comment(int lang)
+{
+    if (lang <= LANG_TEXT || lang >= LANG_COUNT) return NULL;
+    if (lang == LANG_BATCH) return L"REM ";
+    if (lang == LANG_XML || lang == LANG_HTML || lang == LANG_MARKDOWN || lang == LANG_CSS) return NULL;
+    return langs[lang].line_comment;
+}
+
+BOOL syn_block_comment(int lang, const WCHAR **open, const WCHAR **close)
+{
+    if (lang == LANG_XML || lang == LANG_HTML || lang == LANG_MARKDOWN)
+    {
+        *open = L"<!--"; *close = L"-->";
+        return TRUE;
+    }
+    if (lang <= LANG_TEXT || lang >= LANG_COUNT || !langs[lang].block_open) return FALSE;
+    *open = langs[lang].block_open;
+    *close = langs[lang].block_close;
+    return TRUE;
+}
+
+/* ------------------------------------------------------------ keywords */
+
+typedef struct
+{
+    const WCHAR *word;
+    BYTE len, style;
+} KWENTRY;
+
+typedef struct
+{
+    KWENTRY *tab;
+    unsigned mask;
+} KWSET;
+
+static KWSET kwsets[LANG_COUNT];
+static BOOL  kw_ready[LANG_COUNT];
+
+static inline WCHAR fold(WCHAR c)
+{
+    return (c >= 'A' && c <= 'Z') ? c + 32 : c;
+}
+
+static unsigned kw_hash(const WCHAR *s, int n, BOOL icase)
+{
+    unsigned h = 2166136261u;
+    int i;
+    for (i = 0; i < n; i++) h = (h ^ (icase ? fold(s[i]) : s[i])) * 16777619u;
+    return h;
+}
+
+static void kw_add(KWSET *set, const WCHAR *list, BYTE style, BOOL icase)
+{
+    const WCHAR *p = list;
+    while (p && *p)
+    {
+        const WCHAR *e = p;
+        unsigned h;
+        while (*e && *e != ' ') e++;
+        if (e > p && e - p < 64)
+        {
+            h = kw_hash(p, e - p, icase) & set->mask;
+            while (set->tab[h].word) h = (h + 1) & set->mask;
+            set->tab[h].word = p;
+            set->tab[h].len = e - p;
+            set->tab[h].style = style;
+        }
+        p = *e ? e + 1 : e;
+    }
+}
+
+static void kw_init(int lang)
+{
+    const LANGDEF *d = &langs[lang];
+    unsigned size = 64, count = 0;
+    const WCHAR *p;
+    BOOL icase = !!(d->flags & F_ICASE);
+
+    for (p = d->keywords; p && *p; p++) if (*p == ' ') count++;
+    for (p = d->types; p && *p; p++) if (*p == ' ') count++;
+    count += 2;
+    while (size < count * 3) size *= 2;
+    kwsets[lang].tab = calloc(size, sizeof(KWENTRY));
+    kwsets[lang].mask = size - 1;
+    if (kwsets[lang].tab)
+    {
+        kw_add(&kwsets[lang], d->keywords, ST_KEYWORD, icase);
+        kw_add(&kwsets[lang], d->types, lang == LANG_PS ? ST_OPERATOR : ST_TYPE, icase);
+    }
+    kw_ready[lang] = TRUE;
+}
+
+static int kw_lookup(int lang, const WCHAR *s, int n)
+{
+    KWSET *set;
+    unsigned h;
+    BOOL icase = !!(langs[lang].flags & F_ICASE);
+    int i;
+
+    if (!kw_ready[lang]) kw_init(lang);
+    set = &kwsets[lang];
+    if (!set->tab || n <= 0 || n >= 64) return -1;
+    h = kw_hash(s, n, icase) & set->mask;
+    while (set->tab[h].word)
+    {
+        if (set->tab[h].len == n)
+        {
+            for (i = 0; i < n; i++)
+                if ((icase ? fold(s[i]) : s[i]) != (icase ? fold(set->tab[h].word[i]) : set->tab[h].word[i]))
+                    break;
+            if (i == n) return set->tab[h].style;
+        }
+        h = (h + 1) & set->mask;
+    }
+    return -1;
+}
+
+/* ------------------------------------------------------------ helpers */
+
+static inline BOOL is_alpha(WCHAR c)
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (c >= 0x80 && IsCharAlphaW(c));
+}
+
+static inline BOOL is_digit(WCHAR c)
+{
+    return c >= '0' && c <= '9';
+}
+
+static inline BOOL is_ident(WCHAR c)
+{
+    return is_alpha(c) || is_digit(c);
+}
+
+static inline BOOL is_space(WCHAR c)
+{
+    return c == ' ' || c == '\t' || c == 0xa0 || c == 0x3000 || c == 0xfeff;
+}
+
+#define PAINT(from, to, st) do { if (styles) { int _i; for (_i = (from); _i < (to); _i++) styles[_i] = (st); } } while (0)
+
+static BOOL at(const WCHAR *s, int n, int i, const WCHAR *lit)
+{
+    int k;
+    for (k = 0; lit[k]; k++)
+        if (i + k >= n || s[i + k] != lit[k]) return FALSE;
+    return TRUE;
+}
+
+static BOOL at_icase(const WCHAR *s, int n, int i, const WCHAR *lit)
+{
+    int k;
+    for (k = 0; lit[k]; k++)
+        if (i + k >= n || fold(s[i + k]) != fold(lit[k])) return FALSE;
+    return TRUE;
+}
+
+static int skip_number(const WCHAR *s, int n, int i)
+{
+    BOOL hex = (s[i] == '0' && i + 1 < n && (s[i + 1] == 'x' || s[i + 1] == 'X'));
+    i++;
+    while (i < n)
+    {
+        WCHAR c = s[i];
+        if (is_ident(c) || c == '.' || c == '\'') i++;
+        else if ((c == '+' || c == '-') && !hex && (s[i - 1] == 'e' || s[i - 1] == 'E')) i++;
+        else break;
+    }
+    return i;
+}
+
+static int next_nonspace(const WCHAR *s, int n, int i)
+{
+    while (i < n && is_space(s[i])) i++;
+    return i;
+}
+
+/* end of a quoted string starting after the opening quote; *closed says
+ * whether it ended on this line */
+static int skip_string(const WCHAR *s, int n, int i, WCHAR q, BOOL backslash, BOOL doubling, BOOL *closed)
+{
+    while (i < n)
+    {
+        if (backslash && s[i] == '\\') { i += 2; continue; }
+        if (s[i] == q)
+        {
+            if (doubling && i + 1 < n && s[i + 1] == q) { i += 2; continue; }
+            *closed = TRUE;
+            return i + 1;
+        }
+        i++;
+    }
+    *closed = FALSE;
+    return n;
+}
+
+/* ------------------------------------------------------------ C-like family */
+
+enum { CM_NORMAL, CM_BLOCK, CM_STRING };
+enum { SK_TRIPLE2 = 1, SK_TRIPLE1, SK_TEMPLATE, SK_VERBATIM, SK_RAWTICK };
+
+static int lex_clike(int lang, const WCHAR *s, int n, int state, BYTE *styles)
+{
+    const LANGDEF *d = &langs[lang];
+    DWORD fl = d->flags;
+    int i = 0, mode = state & 15, kind = (state >> 4) & 15, depth = state >> 8;
+    int line_start_code = 1;       /* nothing but spaces so far */
+    WCHAR prev_sig = 0;            /* last significant character, for JS regex */
+
+    PAINT(0, n, ST_DEFAULT);
+
+    while (i < n)
+    {
+        int st = i;
+
+        if (mode == CM_BLOCK)
+        {
+            while (i < n)
+            {
+                if ((fl & F_NESTCOMMENT) && at(s, n, i, d->block_open)) { depth++; i += 2; continue; }
+                if (at(s, n, i, d->block_close))
+                {
+                    i += lstrlenW(d->block_close);
+                    if (depth > 0 && (fl & F_NESTCOMMENT)) { depth--; continue; }
+                    mode = CM_NORMAL;
+                    break;
+                }
+                i++;
+            }
+            PAINT(st, i, ST_COMMENT);
+            continue;
+        }
+        if (mode == CM_STRING)
+        {
+            while (i < n)
+            {
+                if (kind == SK_TRIPLE2 && at(s, n, i, L"\"\"\"")) { i += 3; mode = CM_NORMAL; break; }
+                if (kind == SK_TRIPLE1 && at(s, n, i, L"'''")) { i += 3; mode = CM_NORMAL; break; }
+                if ((kind == SK_TRIPLE2 || kind == SK_TRIPLE1 || kind == SK_TEMPLATE) && s[i] == '\\') { i += 2; continue; }
+                if (kind == SK_TEMPLATE && s[i] == '`') { i++; mode = CM_NORMAL; break; }
+                if (kind == SK_RAWTICK && s[i] == '`') { i++; mode = CM_NORMAL; break; }
+                if (kind == SK_VERBATIM && s[i] == '"')
+                {
+                    if (i + 1 < n && s[i + 1] == '"') { i += 2; continue; }
+                    i++; mode = CM_NORMAL; break;
+                }
+                i++;
+            }
+            if (i > n) i = n;
+            PAINT(st, i, ST_STRING);
+            if (mode == CM_NORMAL) prev_sig = '"';
+            continue;
+        }
+
+        {
+            WCHAR c = s[i];
+            if (is_space(c)) { i++; continue; }
+
+            /* comments */
+            if (d->line_comment && at(s, n, i, d->line_comment))
+            {
+                PAINT(i, n, ST_COMMENT);
+                return 0;
+            }
+            if ((fl & F_HASHCOMMENT) && c == '#')
+            {
+                PAINT(i, n, ST_COMMENT);
+                return 0;
+            }
+            if (d->block_open && at(s, n, i, d->block_open))
+            {
+                mode = CM_BLOCK; depth = 0;
+                i += lstrlenW(d->block_open);
+                PAINT(st, i, ST_COMMENT);
+                continue;
+            }
+            /* preprocessor */
+            if ((fl & F_PREPROC) && c == '#' && line_start_code)
+            {
+                int j = next_nonspace(s, n, i + 1);
+                while (j < n && is_ident(s[j])) j++;
+                PAINT(i, j, ST_PREPROC);
+                if (at(s, n, next_nonspace(s, n, i + 1), L"include"))
+                {
+                    int k = next_nonspace(s, n, j);
+                    if (k < n && s[k] == '<')
+                    {
+                        int e = k;
+                        while (e < n && s[e] != '>') e++;
+                        if (e < n) e++;
+                        PAINT(k, e, ST_STRING);
+                        j = e;
+                    }
+                }
+                i = j;
+                line_start_code = 0;
+                continue;
+            }
+            line_start_code = 0;
+
+            /* strings */
+            if (c == '"' || c == '\'' || c == '`' ||
+                ((fl & F_VERBATIM) && (c == '@' || c == '$') && i + 1 < n && (s[i + 1] == '"' || s[i + 1] == '@' || s[i + 1] == '$')))
+            {
+                BOOL closed;
+                int j = i;
+                BOOL verbatim = FALSE;
+
+                if (fl & F_VERBATIM)
+                {
+                    while (j < n && (s[j] == '@' || s[j] == '$'))
+                    {
+                        if (s[j] == '@') verbatim = TRUE;
+                        j++;
+                    }
+                    if (j >= n || s[j] != '"') { i = j ? j : i + 1; PAINT(st, i, ST_OPERATOR); continue; }
+                    c = '"';
+                }
+                if (c == '`')
+                {
+                    if (fl & F_TICKIDENT)
+                    {
+                        j = skip_string(s, n, i + 1, '`', FALSE, FALSE, &closed);
+                        PAINT(i, j, ST_VARIABLE); i = j; prev_sig = 'a'; continue;
+                    }
+                    if (!(fl & (F_TEMPLATE | F_RAWTICK))) { i++; PAINT(st, i, ST_OPERATOR); continue; }
+                    mode = CM_STRING; kind = (fl & F_TEMPLATE) ? SK_TEMPLATE : SK_RAWTICK;
+                    i++;
+                    PAINT(st, i, ST_STRING);
+                    continue;
+                }
+                if ((fl & F_TRIPLE) && (at(s, n, i, L"\"\"\"") || at(s, n, i, L"'''")))
+                {
+                    mode = CM_STRING; kind = c == '"' ? SK_TRIPLE2 : SK_TRIPLE1;
+                    i += 3;
+                    PAINT(st, i, ST_STRING);
+                    continue;
+                }
+                if (verbatim)
+                {
+                    mode = CM_STRING; kind = SK_VERBATIM;
+                    i = j + 1;
+                    PAINT(st, i, ST_STRING);
+                    continue;
+                }
+                if (c == '\'' && (fl & F_LIFETIME))
+                {
+                    /* 'a' or '\n' is a char; 'a followed by anything else a lifetime */
+                    if (!(i + 2 < n && (s[i + 1] == '\\' || s[i + 2] == '\'')))
+                    {
+                        j = i + 1;
+                        while (j < n && is_ident(s[j])) j++;
+                        PAINT(i, j, ST_TYPE); i = j; continue;
+                    }
+                }
+                j = skip_string(s, n, j + 1, c, !(fl & F_SQLSTR), !!(fl & F_SQLSTR), &closed);
+                PAINT(i, j, ST_STRING);
+                i = j;
+                prev_sig = '"';
+                continue;
+            }
+            /* numbers */
+            if (is_digit(c) || (c == '.' && i + 1 < n && is_digit(s[i + 1])))
+            {
+                i = skip_number(s, n, i);
+                PAINT(st, i, ST_NUMBER);
+                prev_sig = '0';
+                continue;
+            }
+            /* identifiers */
+            if (is_alpha(c) || ((fl & (F_ANNOT | F_ATVAR)) && c == '@' && i + 1 < n && is_alpha(s[i + 1])))
+            {
+                int k, style;
+                i++;
+                while (i < n && is_ident(s[i])) i++;
+                if (c == '@')
+                {
+                    PAINT(st, i, (fl & F_ATVAR) ? ST_VARIABLE : ST_PREPROC);
+                    prev_sig = 'a';
+                    continue;
+                }
+                /* Python string prefixes: r"...", f'...', b"..." */
+                if ((fl & F_TRIPLE) && i < n && (s[i] == '"' || s[i] == '\'') && i - st <= 2)
+                {
+                    BOOL ok = TRUE;
+                    for (k = st; k < i; k++) if (!wcschr(L"rRbBuUfF", s[k])) ok = FALSE;
+                    if (ok) { PAINT(st, i, ST_STRING); prev_sig = 'a'; continue; }
+                }
+                style = kw_lookup(lang, s + st, i - st);
+                if (style < 0)
+                {
+                    k = next_nonspace(s, n, i);
+                    if ((fl & F_MACROBANG) && k < n && s[k] == '!') { style = ST_FUNCTION; i = k + 1; }
+                    else if (k < n && s[k] == '(') style = ST_FUNCTION;
+                    else style = ST_DEFAULT;
+                }
+                PAINT(st, i, style);
+                prev_sig = 'a';
+                continue;
+            }
+            /* JS regular expression literal */
+            if ((fl & F_REGEXLIT) && c == '/' && (!prev_sig || wcschr(L"(,=:[!&|?{};+-*%<>~^", prev_sig)))
+            {
+                int j = i + 1;
+                BOOL cls = FALSE, ok = FALSE;
+                while (j < n)
+                {
+                    if (s[j] == '\\') { j += 2; continue; }
+                    if (s[j] == '[') cls = TRUE;
+                    else if (s[j] == ']') cls = FALSE;
+                    else if (s[j] == '/' && !cls) { ok = TRUE; break; }
+                    j++;
+                }
+                if (ok && j > i + 1)
+                {
+                    j++;
+                    while (j < n && is_alpha(s[j])) j++;
+                    PAINT(i, j, ST_STRING);
+                    i = j;
+                    prev_sig = '"';
+                    continue;
+                }
+            }
+            /* operators and punctuation */
+            i++;
+            PAINT(st, i, ST_OPERATOR);
+            prev_sig = c;
+        }
+    }
+    if (mode == CM_NORMAL) return 0;
+    if (mode == CM_STRING && kind == SK_TEMPLATE) return mode | (kind << 4);
+    return mode | (kind << 4) | (depth << 8);
+}
+
+/* ------------------------------------------------------------ JSON */
+
+static int lex_json(int lang, const WCHAR *s, int n, int state, BYTE *styles)
+{
+    int i = 0;
+    PAINT(0, n, ST_DEFAULT);
+    if (state == CM_BLOCK)
+    {
+        while (i < n && !at(s, n, i, L"*/")) i++;
+        i = min(n, i + 2);
+        PAINT(0, i, ST_COMMENT);
+        if (i >= n && !(n >= 2 && s[n - 2] == '*' && s[n - 1] == '/')) return CM_BLOCK;
+    }
+    while (i < n)
+    {
+        WCHAR c = s[i];
+        int st = i;
+        if (is_space(c)) { i++; continue; }
+        if (at(s, n, i, L"//")) { PAINT(i, n, ST_COMMENT); return 0; }
+        if (at(s, n, i, L"/*"))
+        {
+            i += 2;
+            while (i < n && !at(s, n, i, L"*/")) i++;
+            if (i >= n) { PAINT(st, n, ST_COMMENT); return CM_BLOCK; }
+            i += 2;
+            PAINT(st, i, ST_COMMENT);
+            continue;
+        }
+        if (c == '"' || c == '\'')
+        {
+            BOOL closed;
+            int k;
+            i = skip_string(s, n, i + 1, c, TRUE, FALSE, &closed);
+            k = next_nonspace(s, n, i);
+            PAINT(st, i, (k < n && s[k] == ':') ? ST_KEY : ST_STRING);
+            continue;
+        }
+        if (is_digit(c) || c == '-' || c == '+')
+        {
+            i = skip_number(s, n, i);
+            PAINT(st, i, ST_NUMBER);
+            continue;
+        }
+        if (is_alpha(c))
+        {
+            int style;
+            while (i < n && is_ident(s[i])) i++;
+            style = kw_lookup(lang, s + st, i - st);
+            PAINT(st, i, style >= 0 ? style : ST_DEFAULT);
+            continue;
+        }
+        i++;
+        PAINT(st, i, ST_OPERATOR);
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------ XML / HTML */
+
+enum { XM_TEXT, XM_COMMENT, XM_TAG, XM_CDATA, XM_DECL };
+
+static int lex_markup(int lang, const WCHAR *s, int n, int state, BYTE *styles)
+{
+    int i = 0, mode = state & 15;
+    PAINT(0, n, ST_DEFAULT);
+    while (i < n)
+    {
+        int st = i;
+        switch (mode)
+        {
+        case XM_COMMENT:
+            while (i < n && !at(s, n, i, L"-->")) i++;
+            if (i < n) { i += 3; mode = XM_TEXT; }
+            PAINT(st, i, ST_COMMENT);
+            break;
+        case XM_CDATA:
+            while (i < n && !at(s, n, i, L"]]>")) i++;
+            if (i < n) { i += 3; mode = XM_TEXT; }
+            PAINT(st, i, ST_STRING);
+            break;
+        case XM_DECL:
+            while (i < n && s[i] != '>') i++;
+            if (i < n) { i++; mode = XM_TEXT; }
+            PAINT(st, i, ST_PREPROC);
+            break;
+        case XM_TAG:
+        {
+            WCHAR c = s[i];
+            if (is_space(c)) { i++; break; }
+            if (c == '>' || at(s, n, i, L"/>") || at(s, n, i, L"?>"))
+            {
+                i += (c == '>') ? 1 : 2;
+                PAINT(st, i, ST_TAG);
+                mode = XM_TEXT;
+                break;
+            }
+            if (c == '"' || c == '\'')
+            {
+                BOOL closed;
+                i = skip_string(s, n, i + 1, c, FALSE, FALSE, &closed);
+                PAINT(st, i, ST_STRING);
+                break;
+            }
+            if (c == '=') { i++; PAINT(st, i, ST_OPERATOR); break; }
+            while (i < n && !is_space(s[i]) && s[i] != '=' && s[i] != '>' && s[i] != '/' && s[i] != '"' && s[i] != '\'') i++;
+            if (i == st) i++;
+            PAINT(st, i, ST_ATTR);
+            break;
+        }
+        default:
+            if (at(s, n, i, L"<!--"))
+            {
+                mode = XM_COMMENT; i += 4;
+                PAINT(st, i, ST_COMMENT);
+            }
+            else if (at(s, n, i, L"<![CDATA["))
+            {
+                mode = XM_CDATA; i += 9;
+                PAINT(st, i, ST_STRING);
+            }
+            else if (at(s, n, i, L"<!"))
+            {
+                mode = XM_DECL; i += 2;
+                PAINT(st, i, ST_PREPROC);
+            }
+            else if (s[i] == '<' && i + 1 < n && (is_alpha(s[i + 1]) || s[i + 1] == '/' || s[i + 1] == '?' || s[i + 1] == ':'))
+            {
+                i++;
+                if (s[i] == '/' || s[i] == '?') i++;
+                while (i < n && (is_ident(s[i]) || s[i] == ':' || s[i] == '-' || s[i] == '.')) i++;
+                PAINT(st, i, ST_TAG);
+                mode = XM_TAG;
+            }
+            else if (s[i] == '&')
+            {
+                int j = i + 1;
+                while (j < n && j - i < 12 && (is_ident(s[j]) || s[j] == '#')) j++;
+                if (j < n && s[j] == ';') { i = j + 1; PAINT(st, i, ST_ESCAPE); }
+                else i++;
+            }
+            else i++;
+            break;
+        }
+    }
+    return mode;
+}
+
+/* ------------------------------------------------------------ CSS */
+
+static int lex_css(int lang, const WCHAR *s, int n, int state, BYTE *styles)
+{
+    int i = 0, mode = state & 15, depth = state >> 4;
+    PAINT(0, n, ST_DEFAULT);
+    while (i < n)
+    {
+        int st = i;
+        WCHAR c = s[i];
+        if (mode == CM_BLOCK)
+        {
+            while (i < n && !at(s, n, i, L"*/")) i++;
+            if (i < n) { i += 2; mode = CM_NORMAL; }
+            PAINT(st, i, ST_COMMENT);
+            continue;
+        }
+        if (is_space(c)) { i++; continue; }
+        if (at(s, n, i, L"/*")) { mode = CM_BLOCK; i += 2; PAINT(st, i, ST_COMMENT); continue; }
+        if (at(s, n, i, L"//") && (i == 0 || s[i - 1] != ':')) { PAINT(i, n, ST_COMMENT); break; }
+        if (c == '{') { depth = min(depth + 1, 15); i++; PAINT(st, i, ST_OPERATOR); continue; }
+        if (c == '}') { if (depth) depth--; i++; PAINT(st, i, ST_OPERATOR); continue; }
+        if (c == '"' || c == '\'')
+        {
+            BOOL closed;
+            i = skip_string(s, n, i + 1, c, TRUE, FALSE, &closed);
+            PAINT(st, i, ST_STRING);
+            continue;
+        }
+        if (c == '@')
+        {
+            i++;
+            while (i < n && (is_ident(s[i]) || s[i] == '-')) i++;
+            PAINT(st, i, ST_KEYWORD);
+            continue;
+        }
+        if (c == '#' && depth)
+        {
+            i++;
+            while (i < n && is_ident(s[i])) i++;
+            PAINT(st, i, ST_NUMBER);
+            continue;
+        }
+        if (is_digit(c) || (c == '.' && i + 1 < n && is_digit(s[i + 1])) || (c == '-' && i + 1 < n && is_digit(s[i + 1])))
+        {
+            i = skip_number(s, n, i + (c == '-'));
+            while (i < n && (is_alpha(s[i]) || s[i] == '%')) i++;
+            PAINT(st, i, ST_NUMBER);
+            continue;
+        }
+        if (is_alpha(c) || c == '-' || ((c == '.' || c == '#') && !depth) || c == '$' || c == '!')
+        {
+            int k, style = ST_DEFAULT;
+            i++;
+            while (i < n && (is_ident(s[i]) || s[i] == '-')) i++;
+            k = next_nonspace(s, n, i);
+            if (c == '!' || c == '$') style = c == '$' ? ST_VARIABLE : ST_KEYWORD;
+            else if (depth && k < n && s[k] == ':') style = ST_KEY;
+            else if (!depth) style = (c == '.' || c == '#') ? ST_ATTR : ST_TAG;
+            else if (kw_lookup(lang, s + st, i - st) >= 0) style = ST_KEYWORD;
+            else if (k < n && s[k] == '(') style = ST_FUNCTION;
+            PAINT(st, i, style);
+            continue;
+        }
+        i++;
+        PAINT(st, i, ST_OPERATOR);
+    }
+    return mode | (depth << 4);
+}
+
+/* ------------------------------------------------------------ INI / .reg */
+
+static int lex_ini(int lang, const WCHAR *s, int n, int state, BYTE *styles)
+{
+    int i = next_nonspace(s, n, 0), j;
+    PAINT(0, n, ST_DEFAULT);
+    if (i >= n) return 0;
+    if (s[i] == ';' || s[i] == '#') { PAINT(i, n, ST_COMMENT); return 0; }
+    if (lang == LANG_REG && (at(s, n, i, L"Windows Registry Editor") || at(s, n, i, L"REGEDIT4")))
+    {
+        PAINT(i, n, ST_PREPROC);
+        return 0;
+    }
+    if (s[i] == '[')
+    {
+        j = i;
+        while (j < n && s[j] != ']') j++;
+        if (j < n) j++;
+        PAINT(i, j, ST_SECTION);
+        return 0;
+    }
+    if (state == 1)    /* a .reg value continued with a trailing backslash */
+    {
+        PAINT(i, n, ST_NUMBER);
+        return (n && s[n - 1] == '\\') ? 1 : 0;
+    }
+    /* key */
+    j = i;
+    if (s[i] == '"')
+    {
+        BOOL closed;
+        j = skip_string(s, n, i + 1, '"', TRUE, FALSE, &closed);
+    }
+    else
+        while (j < n && s[j] != '=' && s[j] != ':') j++;
+    PAINT(i, j, ST_KEY);
+    if (j >= n) return 0;
+    i = next_nonspace(s, n, j);
+    if (i < n && (s[i] == '=' || s[i] == ':')) { PAINT(i, i + 1, ST_OPERATOR); i++; }
+    i = next_nonspace(s, n, i);
+    if (i >= n) return 0;
+    if (s[i] == '"')
+    {
+        BOOL closed;
+        j = skip_string(s, n, i + 1, '"', lang == LANG_REG, FALSE, &closed);
+        PAINT(i, j, ST_STRING);
+        i = j;
+    }
+    else if (lang == LANG_REG && (at_icase(s, n, i, L"dword:") || at_icase(s, n, i, L"hex") || at(s, n, i, L"-")))
+    {
+        PAINT(i, n, ST_NUMBER);
+        return (s[n - 1] == '\\') ? 1 : 0;
+    }
+    else if (is_digit(s[i]) || s[i] == '-')
+    {
+        j = skip_number(s, n, i);
+        if (next_nonspace(s, n, j) >= n) PAINT(i, j, ST_NUMBER);
+    }
+    else if (at_icase(s, n, i, L"true") || at_icase(s, n, i, L"false"))
+        PAINT(i, i + (fold(s[i]) == 't' ? 4 : 5), ST_KEYWORD);
+    j = i;
+    while (j < n && s[j] != ';' && s[j] != '#') j++;
+    if (j < n && j > 0 && is_space(s[j - 1])) PAINT(j, n, ST_COMMENT);
+    return 0;
+}
+
+/* ------------------------------------------------------------ batch */
+
+static int lex_batch(int lang, const WCHAR *s, int n, int state, BYTE *styles)
+{
+    int i = next_nonspace(s, n, 0);
+    BOOL cmd_start = TRUE;
+    PAINT(0, n, ST_DEFAULT);
+    if (i < n && s[i] == '@') { PAINT(i, i + 1, ST_OPERATOR); i++; }
+    if (at(s, n, i, L"::")) { PAINT(i, n, ST_COMMENT); return 0; }
+    if (i < n && s[i] == ':') { PAINT(i, n, ST_FUNCTION); return 0; }
+    while (i < n)
+    {
+        int st = i;
+        WCHAR c = s[i];
+        if (is_space(c)) { i++; continue; }
+        if (cmd_start && at_icase(s, n, i, L"rem") && (i + 3 >= n || is_space(s[i + 3]) || s[i + 3] == '.'))
+        {
+            PAINT(i, n, ST_COMMENT);
+            return 0;
+        }
+        if (c == '%' || c == '!')
+        {
+            int j = i + 1;
+            if (c == '%' && j < n && s[j] == '%') j++;
+            if (j < n && (s[j] == '~' || is_digit(s[j]) || s[j] == '*'))
+            {
+                while (j < n && (s[j] == '~' || is_alpha(s[j]) || s[j] == ':' || s[j] == '$')) j++;
+                if (j < n && (is_digit(s[j]) || s[j] == '*')) j++;
+                PAINT(i, j, ST_VARIABLE); i = j; continue;
+            }
+            if (s[i + 1] == '%' && j < n && is_alpha(s[j])) { PAINT(i, j + 1, ST_VARIABLE); i = j + 1; continue; }
+            while (j < n && s[j] != c && s[j] != '\n') j++;
+            if (j < n && j > i + 1) { PAINT(i, j + 1, ST_VARIABLE); i = j + 1; continue; }
+            i++;
+            continue;
+        }
+        if (c == '"')
+        {
+            BOOL closed;
+            i = skip_string(s, n, i + 1, '"', FALSE, FALSE, &closed);
+            PAINT(st, i, ST_STRING);
+            cmd_start = FALSE;
+            continue;
+        }
+        if (c == '&' || c == '|' || c == '(' || c == ')')
+        {
+            i++;
+            PAINT(st, i, ST_OPERATOR);
+            cmd_start = TRUE;
+            continue;
+        }
+        if (c == '>' || c == '<')
+        {
+            i++;
+            PAINT(st, i, ST_OPERATOR);
+            continue;
+        }
+        if (is_alpha(c) || is_digit(c) || c == '.' || c == '-' || c == '/' || c == '\\')
+        {
+            int style;
+            while (i < n && (is_ident(s[i]) || s[i] == '.' || s[i] == '-' || s[i] == '/' || s[i] == '\\' || s[i] == ':')) i++;
+            style = kw_lookup(lang, s + st, i - st);
+            PAINT(st, i, style >= 0 ? style : (cmd_start ? ST_FUNCTION : ST_DEFAULT));
+            if (!(style == ST_KEYWORD && (at_icase(s, n, st, L"if") || at_icase(s, n, st, L"else") ||
+                                          at_icase(s, n, st, L"do") || at_icase(s, n, st, L"not"))))
+                cmd_start = FALSE;
+            continue;
+        }
+        i++;
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------ shell */
+
+enum { SM_NORMAL, SM_HEREDOC, SM_DQUOTE };
+
+static unsigned word_hash(const WCHAR *s, int n)
+{
+    return (kw_hash(s, n, FALSE) & 0xffffff) | 1;
+}
+
+static int lex_shell(int lang, const WCHAR *s, int n, int state, BYTE *styles)
+{
+    int i = 0, mode = state & 3;
+    BOOL cmd_start = TRUE;
+    unsigned heredoc = 0;
+    BOOL strip_tabs = FALSE;
+    PAINT(0, n, ST_DEFAULT);
+
+    if (mode == SM_HEREDOC)
+    {
+        int b = 0, e = n;
+        while (b < n && s[b] == '\t') b++;
+        while (e > b && (s[e - 1] == ' ' || s[e - 1] == '\t')) e--;
+        PAINT(0, n, ST_STRING);
+        if (word_hash(s + b, e - b) == (unsigned)(state >> 8) && e > b) return 0;
+        return state;
+    }
+    if (mode == SM_DQUOTE)
+    {
+        BOOL closed;
+        i = skip_string(s, n, 0, '"', TRUE, FALSE, &closed);
+        PAINT(0, i, ST_STRING);
+        if (!closed) return SM_DQUOTE;
+    }
+    while (i < n)
+    {
+        int st = i;
+        WCHAR c = s[i];
+        if (is_space(c)) { i++; continue; }
+        if (c == '#' && (i == 0 || is_space(s[i - 1]) || s[i - 1] == ';'))
+        {
+            PAINT(i, n, ST_COMMENT);
+            break;
+        }
+        if (c == '\'' )
+        {
+            BOOL closed;
+            i = skip_string(s, n, i + 1, '\'', FALSE, FALSE, &closed);
+            PAINT(st, i, ST_STRING);
+            cmd_start = FALSE;
+            continue;
+        }
+        if (c == '"')
+        {
+            BOOL closed;
+            i = skip_string(s, n, i + 1, '"', TRUE, FALSE, &closed);
+            PAINT(st, i, ST_STRING);
+            cmd_start = FALSE;
+            if (!closed) return SM_DQUOTE;
+            continue;
+        }
+        if (c == '$')
+        {
+            i++;
+            if (i < n && s[i] == '{')
+            {
+                while (i < n && s[i] != '}') i++;
+                if (i < n) i++;
+            }
+            else if (i < n && s[i] == '(') i++;
+            else while (i < n && (is_ident(s[i]) || ((i == st + 1) && wcschr(L"#?@*!$-0123456789", s[i])))) i++;
+            PAINT(st, i, ST_VARIABLE);
+            cmd_start = FALSE;
+            continue;
+        }
+        if (at(s, n, i, L"<<") && !at(s, n, i, L"<<<"))
+        {
+            int j = i + 2, b, e;
+            strip_tabs = FALSE;
+            if (j < n && s[j] == '-') { strip_tabs = TRUE; j++; }
+            j = next_nonspace(s, n, j);
+            b = j;
+            if (j < n && (s[j] == '\'' || s[j] == '"'))
+            {
+                WCHAR q = s[j];
+                b = ++j;
+                while (j < n && s[j] != q) j++;
+                e = j;
+                if (j < n) j++;
+            }
+            else
+            {
+                while (j < n && (is_ident(s[j]) || s[j] == '-')) j++;
+                e = j;
+            }
+            if (e > b) heredoc = word_hash(s + b, e - b);
+            PAINT(i, j, ST_OPERATOR);
+            i = j;
+            continue;
+        }
+        if (is_digit(c) && !cmd_start)
+        {
+            i = skip_number(s, n, i);
+            PAINT(st, i, ST_NUMBER);
+            continue;
+        }
+        if (is_alpha(c) || c == '.' || c == '/' || c == '-' || c == '[')
+        {
+            int style, k;
+            while (i < n && (is_ident(s[i]) || s[i] == '.' || s[i] == '/' || s[i] == '-' || s[i] == '[' || s[i] == ']')) i++;
+            k = next_nonspace(s, n, i);
+            style = kw_lookup(lang, s + st, i - st);
+            if (style < 0 && k < n && s[k] == '=' && is_alpha(c)) style = ST_VARIABLE;
+            if (style < 0 && at(s, n, k, L"()")) style = ST_FUNCTION;
+            if (style < 0) style = ST_DEFAULT;
+            PAINT(st, i, style);
+            cmd_start = (style == ST_KEYWORD);
+            continue;
+        }
+        if (c == ';' || c == '|' || c == '&' || c == '(' || c == ')' || c == '{' || c == '}') cmd_start = TRUE;
+        i++;
+        PAINT(st, i, ST_OPERATOR);
+    }
+    (void)strip_tabs;
+    if (heredoc) return SM_HEREDOC | (heredoc << 8);
+    return 0;
+}
+
+/* ------------------------------------------------------------ PowerShell */
+
+enum { PM_NORMAL, PM_BLOCK, PM_HERE2, PM_HERE1 };
+
+static int lex_ps(int lang, const WCHAR *s, int n, int state, BYTE *styles)
+{
+    int i = 0, mode = state & 3;
+    PAINT(0, n, ST_DEFAULT);
+    while (i < n)
+    {
+        int st = i;
+        WCHAR c = s[i];
+        if (mode == PM_BLOCK)
+        {
+            while (i < n && !at(s, n, i, L"#>")) i++;
+            if (i < n) { i += 2; mode = PM_NORMAL; }
+            PAINT(st, i, ST_COMMENT);
+            continue;
+        }
+        if (mode == PM_HERE2 || mode == PM_HERE1)
+        {
+            if (at(s, n, 0, mode == PM_HERE2 ? L"\"@" : L"'@")) { PAINT(0, 2, ST_STRING); i = 2; mode = PM_NORMAL; continue; }
+            PAINT(0, n, ST_STRING);
+            return mode;
+        }
+        if (is_space(c)) { i++; continue; }
+        if (at(s, n, i, L"<#")) { mode = PM_BLOCK; i += 2; PAINT(st, i, ST_COMMENT); continue; }
+        if (c == '#') { PAINT(i, n, ST_COMMENT); break; }
+        if (at(s, n, i, L"@\"") && next_nonspace(s, n, i + 2) >= n) { PAINT(i, n, ST_STRING); return PM_HERE2; }
+        if (at(s, n, i, L"@'") && next_nonspace(s, n, i + 2) >= n) { PAINT(i, n, ST_STRING); return PM_HERE1; }
+        if (c == '"' || c == '\'')
+        {
+            BOOL closed;
+            int j = i + 1;
+            if (c == '"')
+            {
+                while (j < n && s[j] != '"') { if (s[j] == '`') j++; j++; }
+                if (j < n) j++;
+            }
+            else j = skip_string(s, n, j, '\'', FALSE, TRUE, &closed);
+            i = min(j, n);
+            PAINT(st, i, ST_STRING);
+            continue;
+        }
+        if (c == '$')
+        {
+            i++;
+            if (i < n && s[i] == '{') { while (i < n && s[i] != '}') i++; if (i < n) i++; }
+            else while (i < n && (is_ident(s[i]) || s[i] == ':' || s[i] == '?' || s[i] == '$')) i++;
+            PAINT(st, i, ST_VARIABLE);
+            continue;
+        }
+        if (c == '[' && i + 1 < n && is_alpha(s[i + 1]))
+        {
+            int j = i + 1;
+            while (j < n && (is_ident(s[j]) || s[j] == '.' || s[j] == '[' )) j++;
+            if (j < n && s[j] == ']') { PAINT(i, j + 1, ST_TYPE); i = j + 1; continue; }
+        }
+        if (c == '-' && i + 1 < n && is_alpha(s[i + 1]))
+        {
+            int j = i + 1, style;
+            while (j < n && is_ident(s[j])) j++;
+            style = kw_lookup(lang, s + i, j - i);
+            PAINT(i, j, style >= 0 ? ST_OPERATOR : ST_ATTR);
+            i = j;
+            continue;
+        }
+        if (is_digit(c))
+        {
+            i = skip_number(s, n, i);
+            PAINT(st, i, ST_NUMBER);
+            continue;
+        }
+        if (is_alpha(c))
+        {
+            int style;
+            BOOL dash = FALSE;
+            while (i < n && (is_ident(s[i]) || (s[i] == '-' && i + 1 < n && is_alpha(s[i + 1])))) { if (s[i] == '-') dash = TRUE; i++; }
+            style = kw_lookup(lang, s + st, i - st);
+            if (style == ST_OPERATOR) style = -1;
+            PAINT(st, i, style >= 0 ? style : (dash ? ST_FUNCTION : ST_DEFAULT));
+            continue;
+        }
+        i++;
+        PAINT(st, i, ST_OPERATOR);
+    }
+    return mode;
+}
+
+/* ------------------------------------------------------------ Markdown */
+
+enum { MD_NORMAL, MD_FENCE };
+
+static int lex_md(int lang, const WCHAR *s, int n, int state, BYTE *styles)
+{
+    int i = next_nonspace(s, n, 0), j;
+    PAINT(0, n, ST_DEFAULT);
+
+    if ((state & 15) == MD_FENCE)
+    {
+        WCHAR f = (WCHAR)((state >> 4) & 0xff);
+        int cnt = state >> 12, k = 0;
+        PAINT(0, n, ST_STRING);
+        while (i + k < n && s[i + k] == f) k++;
+        if (k >= cnt && next_nonspace(s, n, i + k) >= n) return 0;
+        return state;
+    }
+    if (i < n && (s[i] == '`' || s[i] == '~'))
+    {
+        int k = 0;
+        while (i + k < n && s[i + k] == s[i]) k++;
+        if (k >= 3)
+        {
+            PAINT(i, n, ST_STRING);
+            return MD_FENCE | (s[i] << 4) | (min(k, 15) << 12);
+        }
+    }
+    if (i < n && s[i] == '#')
+    {
+        j = i;
+        while (j < n && s[j] == '#') j++;
+        if (j >= n || is_space(s[j])) { PAINT(i, n, ST_HEADING); return 0; }
+    }
+    if (i < n && s[i] == '>') { PAINT(i, n, ST_COMMENT); return 0; }
+    if (i + 1 < n && (s[i] == '-' || s[i] == '*' || s[i] == '+') && is_space(s[i + 1])) { PAINT(i, i + 1, ST_KEYWORD); i += 2; }
+    else if (i < n && is_digit(s[i]))
+    {
+        j = i;
+        while (j < n && is_digit(s[j])) j++;
+        if (j + 1 < n && (s[j] == '.' || s[j] == ')') && is_space(s[j + 1])) { PAINT(i, j + 1, ST_KEYWORD); i = j + 1; }
+    }
+    if (n >= 3 && i < n && (s[i] == '=' || s[i] == '-'))
+    {
+        j = i;
+        while (j < n && s[j] == s[i]) j++;
+        if (j >= n && j - i >= 3) { PAINT(i, n, ST_HEADING); return 0; }
+    }
+    while (i < n)
+    {
+        WCHAR c = s[i];
+        int st = i;
+        if (c == '`')
+        {
+            j = i + 1;
+            while (j < n && s[j] != '`') j++;
+            if (j < n) { PAINT(i, j + 1, ST_STRING); i = j + 1; continue; }
+        }
+        if (c == '*' || c == '_')
+        {
+            int k = (i + 1 < n && s[i + 1] == c) ? 2 : 1;
+            j = i + k;
+            if (j < n && !is_space(s[j]) && (c == '*' || i == 0 || !is_ident(s[i - 1])))
+            {
+                while (j < n && !(s[j] == c && (k == 1 || (j + 1 < n && s[j + 1] == c)) && !is_space(s[j - 1]))) j++;
+                if (j < n) { PAINT(i, j + k, ST_EMPHASIS); i = j + k; continue; }
+            }
+        }
+        if (c == '[' || (c == '!' && i + 1 < n && s[i + 1] == '['))
+        {
+            j = i + (c == '!') + 1;
+            while (j < n && s[j] != ']') j++;
+            if (j + 1 < n && s[j + 1] == '(')
+            {
+                int e = j + 2;
+                while (e < n && s[e] != ')') e++;
+                if (e < n)
+                {
+                    PAINT(i, j + 1, ST_KEYWORD);
+                    PAINT(j + 1, e + 1, ST_LINK);
+                    i = e + 1;
+                    continue;
+                }
+            }
+        }
+        if (c == '<' && (at(s, n, i, L"<http") || (i + 1 < n && (is_alpha(s[i + 1]) || s[i + 1] == '/'))))
+        {
+            j = i + 1;
+            while (j < n && s[j] != '>') j++;
+            if (j < n) { PAINT(i, j + 1, at(s, n, i, L"<http") ? ST_LINK : ST_TAG); i = j + 1; continue; }
+        }
+        if (at(s, n, i, L"http://") || at(s, n, i, L"https://"))
+        {
+            j = i;
+            while (j < n && !is_space(s[j]) && s[j] != ')' && s[j] != '>') j++;
+            PAINT(i, j, ST_LINK);
+            i = j;
+            continue;
+        }
+        i = st + 1;
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------ YAML */
+
+static int lex_yaml(int lang, const WCHAR *s, int n, int state, BYTE *styles)
+{
+    int i = next_nonspace(s, n, 0), j, indent = i;
+    PAINT(0, n, ST_DEFAULT);
+
+    /* block scalar: lines indented deeper than the key that opened it */
+    if (state)
+    {
+        int base = state >> 4;
+        if (i >= n) return state;
+        if (indent > base) { PAINT(0, n, ST_STRING); return state; }
+    }
+    if (at(s, n, 0, L"---") || at(s, n, 0, L"...")) { PAINT(0, n, ST_PREPROC); return 0; }
+    if (i < n && s[i] == '#') { PAINT(i, n, ST_COMMENT); return 0; }
+    while (i + 1 < n && s[i] == '-' && is_space(s[i + 1])) { PAINT(i, i + 1, ST_OPERATOR); i = next_nonspace(s, n, i + 1); }
+    /* key: */
+    j = i;
+    if (j < n && (s[j] == '"' || s[j] == '\''))
+    {
+        BOOL closed;
+        j = skip_string(s, n, j + 1, s[j], s[j] == '"', s[j] == '\'', &closed);
+    }
+    else
+        while (j < n && s[j] != ':' && s[j] != '#' && !(s[j] == ' ' && j + 1 < n && s[j + 1] == '#')) j++;
+    if (j < n && s[j] == ':' && (j + 1 >= n || is_space(s[j + 1])))
+    {
+        PAINT(i, j, ST_KEY);
+        PAINT(j, j + 1, ST_OPERATOR);
+        i = j + 1;
+    }
+    i = next_nonspace(s, n, i);
+    while (i < n)
+    {
+        WCHAR c = s[i];
+        int st = i;
+        if (c == '#' && is_space(s[i - (i > 0)])) { PAINT(i, n, ST_COMMENT); break; }
+        if (c == '"' || c == '\'')
+        {
+            BOOL closed;
+            i = skip_string(s, n, i + 1, c, c == '"', c == '\'', &closed);
+            PAINT(st, i, ST_STRING);
+            continue;
+        }
+        if ((c == '|' || c == '>') && (i + 1 >= n || next_nonspace(s, n, i + 1) >= n || s[i + 1] == '-' || s[i + 1] == '+'))
+        {
+            PAINT(i, n, ST_OPERATOR);
+            return 1 | (min(indent, 0xfff) << 4);
+        }
+        if (c == '&' || c == '*' || c == '!')
+        {
+            i++;
+            while (i < n && !is_space(s[i])) i++;
+            PAINT(st, i, c == '!' ? ST_TYPE : ST_VARIABLE);
+            continue;
+        }
+        if (is_digit(c) || ((c == '-' || c == '+' || c == '.') && i + 1 < n && is_digit(s[i + 1])))
+        {
+            j = skip_number(s, n, i);
+            if (next_nonspace(s, n, j) >= n || s[j] == ',' || s[j] == ']' || s[j] == '}' || s[j] == ' ')
+            {
+                PAINT(i, j, ST_NUMBER);
+                i = j;
+                continue;
+            }
+        }
+        if (is_alpha(c) || c == '~')
+        {
+            int style;
+            j = i;
+            while (j < n && (is_ident(s[j]) || s[j] == '~')) j++;
+            style = kw_lookup(lang, s + i, j - i);
+            if (style >= 0 && next_nonspace(s, n, j) >= n) PAINT(i, j, ST_KEYWORD);
+            while (j < n && s[j] != '#') j++;
+            i = j;
+            continue;
+        }
+        if (wcschr(L"[]{},", c)) PAINT(i, i + 1, ST_OPERATOR);
+        i++;
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------ entry points */
+
+int syn_line(int lang, const WCHAR *s, int n, int state, BYTE *styles)
+{
+    if (lang <= LANG_TEXT || lang >= LANG_COUNT)
+    {
+        PAINT(0, n, ST_DEFAULT);
+        return 0;
+    }
+    switch (langs[lang].kind)
+    {
+    case K_CLIKE:  return lex_clike(lang, s, n, state, styles);
+    case K_JSON:   return lex_json(lang, s, n, state, styles);
+    case K_MARKUP: return lex_markup(lang, s, n, state, styles);
+    case K_CSS:    return lex_css(lang, s, n, state, styles);
+    case K_INI:    return lex_ini(lang, s, n, state, styles);
+    case K_BATCH:  return lex_batch(lang, s, n, state, styles);
+    case K_SHELL:  return lex_shell(lang, s, n, state, styles);
+    case K_PS:     return lex_ps(lang, s, n, state, styles);
+    case K_MD:     return lex_md(lang, s, n, state, styles);
+    case K_YAML:   return lex_yaml(lang, s, n, state, styles);
+    }
+    PAINT(0, n, ST_DEFAULT);
+    return 0;
+}
+
+static BOOL ext_in(const WCHAR *exts, const WCHAR *ext)
+{
+    WCHAR pat[40];
+    int k;
+    if (!*ext || lstrlenW(ext) > 32) return FALSE;
+    pat[0] = ';';
+    for (k = 0; ext[k]; k++) pat[k + 1] = fold(ext[k]);
+    pat[k + 1] = ';';
+    pat[k + 2] = 0;
+    return wcsstr(exts, pat) != NULL;
+}
+
+int syn_detect(const WCHAR *path, const WCHAR *first, int len)
+{
+    const WCHAR *name = path ? PathFindFileNameW(path) : L"";
+    const WCHAR *ext = PathFindExtensionW(name);
+    int lang;
+
+    if (*ext == '.') ext++;
+    for (lang = LANG_TEXT + 1; lang < LANG_COUNT; lang++)
+        if (ext_in(langs[lang].exts, ext)) return lang;
+
+    if (!lstrcmpiW(name, L"Makefile") || !lstrcmpiW(name, L"GNUmakefile") || !lstrcmpiW(name, L"Dockerfile") ||
+        !lstrcmpiW(name, L".bashrc") || !lstrcmpiW(name, L".profile") || !lstrcmpiW(name, L"PKGBUILD"))
+        return LANG_SHELL;
+    if (!lstrcmpiW(name, L"CMakeLists.txt")) return LANG_SHELL;
+
+    if (first && len >= 2 && first[0] == '#' && first[1] == '!')
+    {
+        WCHAR buf[128];
+        int k;
+        lstrcpynW(buf, first, min(len + 1, ARRAY_SIZE(buf)));
+        for (k = 0; buf[k]; k++) buf[k] = fold(buf[k]);
+        if (wcsstr(buf, L"python")) return LANG_PYTHON;
+        if (wcsstr(buf, L"node")) return LANG_JS;
+        if (wcsstr(buf, L"pwsh") || wcsstr(buf, L"powershell")) return LANG_PS;
+        if (wcsstr(buf, L"sh")) return LANG_SHELL;
+    }
+    if (first && len >= 5 && !wcsncmp(first, L"<?xml", 5)) return LANG_XML;
+    if (first && len >= 9 && !_wcsnicmp(first, L"<!DOCTYPE", 9)) return LANG_HTML;
+    if (first && len >= 23 && !wcsncmp(first, L"Windows Registry Editor", 23)) return LANG_REG;
+    return LANG_TEXT;
+}
