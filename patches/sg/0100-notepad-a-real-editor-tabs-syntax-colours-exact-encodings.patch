+static void layout_findbar(void)
+{
+    RECT rc;
+    int w, h = S(26), y1 = S(5), y2 = y1 + h + S(5), x = S(8), right;
+    HWND bar = G.findbar;
+    if (!bar) return;
+    GetClientRect(bar, &rc);
+    w = rc.right;
+    right = w - S(8);
+    SetWindowPos(GetDlgItem(bar, IDC_FIND_TOGGLE), 0, x, y1, S(24), h, SWP_NOZORDER);
+    x += S(28);
+    {
+        int edit_w = max(S(120), min(S(360), w - x - S(320)));
+        int eh = S(22), ey = (h - eh) / 2;
+        SetWindowPos(GetDlgItem(bar, IDC_FIND_TEXT), 0, x, y1 + ey, edit_w, eh, SWP_NOZORDER);
+        SetWindowPos(GetDlgItem(bar, IDC_REPLACE_TEXT), 0, x, y2 + ey, edit_w, eh, SWP_NOZORDER);
+        x += edit_w + S(4);
+    }
+    SetWindowPos(GetDlgItem(bar, IDC_FIND_CASE), 0, x, y1, S(28), h, SWP_NOZORDER); x += S(30);
+    SetWindowPos(GetDlgItem(bar, IDC_FIND_WORD), 0, x, y1, S(28), h, SWP_NOZORDER); x += S(30);
+    SetWindowPos(GetDlgItem(bar, IDC_FIND_REGEX), 0, x, y1, S(28), h, SWP_NOZORDER); x += S(36);
+    SetWindowPos(GetDlgItem(bar, IDC_FIND_PREV), 0, x, y1, S(28), h, SWP_NOZORDER); x += S(30);
+    SetWindowPos(GetDlgItem(bar, IDOK), 0, x, y1, S(28), h, SWP_NOZORDER); x += S(36);
+    SetWindowPos(GetDlgItem(bar, IDC_FIND_STATUS), 0, x, y1 + S(5), max(S(20), right - S(32) - x), h - S(8), SWP_NOZORDER);
+    SetWindowPos(GetDlgItem(bar, IDCANCEL), 0, right - S(28), y1, S(28), h, SWP_NOZORDER);
+    {
+        int rx = S(36) + max(S(120), min(S(360), w - S(36) - S(320))) + S(4);
+        SetWindowPos(GetDlgItem(bar, IDC_REPLACE_ONE), 0, rx, y2, S(80), h, SWP_NOZORDER);
+        SetWindowPos(GetDlgItem(bar, IDC_REPLACE_ALL), 0, rx + S(84), y2, S(96), h, SWP_NOZORDER);
+    }
+    ShowWindow(GetDlgItem(bar, IDC_REPLACE_TEXT), G.replace_mode ? SW_SHOW : SW_HIDE);
+    ShowWindow(GetDlgItem(bar, IDC_REPLACE_ONE), G.replace_mode ? SW_SHOW : SW_HIDE);
+    ShowWindow(GetDlgItem(bar, IDC_REPLACE_ALL), G.replace_mode ? SW_SHOW : SW_HIDE);
+    InvalidateRect(bar, NULL, TRUE);
+}
+
+static void draw_find_button(DRAWITEMSTRUCT *di)
+{
+    HDC hdc = di->hDC;
+    RECT r = di->rcItem;
+    BOOL on = FALSE, hot = (di->itemState & ODS_SELECTED) != 0, focus = (di->itemState & ODS_FOCUS) != 0;
+    const WCHAR *label = L"";
+    HBRUSH br;
+    COLORREF fg = G.chrome.text;
+    HFONT old;
+
+    switch (di->CtlID)
+    {
+    case IDC_FIND_CASE:  label = L"Aa"; on = !!(G.find_flags & FIND_CASE); break;
+    case IDC_FIND_WORD:  label = L"ab"; on = !!(G.find_flags & FIND_WORD); break;
+    case IDC_FIND_REGEX: label = L".*"; on = !!(G.find_flags & FIND_REGEX); break;
+    case IDC_FIND_PREV:  label = L"\x2191"; break;
+    case IDOK:           label = L"\x2193"; break;
+    case IDCANCEL:       label = L""; break;
+    case IDC_FIND_TOGGLE: label = G.replace_mode ? L"\x2304" : L"\x203a"; break;
+    }
+    br = CreateSolidBrush(G.chrome.find_bg);
+    FillRect(hdc, &r, br);
+    DeleteObject(br);
+    if (on || hot)
+    {
+        RECT b = r;
+        InflateRect(&b, -S(1), -S(1));
+        fill_round(hdc, &b, on ? G.chrome.accent : G.chrome.tab_hover, S(8));
+        if (on) fg = RGB(255, 255, 255);
+    }
+    if (focus)
+    {
+        RECT f = r;
+        InflateRect(&f, -S(2), -S(2));
+        DrawFocusRect(hdc, &f);
+    }
+    if (di->CtlID == IDCANCEL)
+    {
+        draw_x(hdc, &r, fg, S(8));
+        return;
+    }
+    if (di->CtlID == IDC_FIND_PREV || di->CtlID == IDOK || di->CtlID == IDC_FIND_TOGGLE)
+    {
+        /* chevrons, drawn: not every interface font has the arrows */
+        HPEN pen = CreatePen(PS_SOLID, max(1, S(1)), fg), op = SelectObject(hdc, pen);
+        int cx = (r.left + r.right) / 2, cy = (r.top + r.bottom) / 2, h = S(4), k;
+        for (k = 0; k < max(1, S(1)) + 1; k++)
+        {
+            if (di->CtlID == IDC_FIND_PREV)
