+
+static void convert_eol(DOC *d, EOLTYPE eol)
+{
+    const WCHAR *t, *eolc = eol_chars(eol);
+    size_t n, i, k = 0, cnt = 0, el = lstrlenW(eolc), anchor, caret;
+    WCHAR *out;
+
+    if (!d) return;
+    ed_get_sel(d->ed, &anchor, &caret);
+    t = ed_text(d->ed);
+    n = ed_length(d->ed);
+    for (i = 0; i < n; i++) if (t[i] == '\r' || t[i] == '\n') cnt++;
+    if (!(out = malloc((n + cnt * el + 1) * sizeof(WCHAR)))) return;
+    for (i = 0; i < n; i++)
+    {
+        if (t[i] == '\r' || t[i] == '\n')
+        {
+            if (t[i] == '\r' && i + 1 < n && t[i + 1] == '\n') i++;
+            memcpy(out + k, eolc, el * sizeof(WCHAR));
+            k += el;
+        }
+        else out[k++] = t[i];
+    }
+    if (k != n || memcmp(out, t, n * sizeof(WCHAR)))
+    {
+        size_t line, col;
+        ed_linecol(d->ed, &line, &col);
+        ed_begin_group(d->ed);
+        ed_replace(d->ed, 0, n, out, k);
+        ed_end_group(d->ed);
+        ed_goto_line(d->ed, line);
+    }
+    else if (d->eol != eol) d->meta_dirty = TRUE;
+    free(out);
+    d->eol = eol;
+    ed_set_eol(d->ed, eol);
+    update_title();
+    update_status();
+    InvalidateRect(G.tabs, NULL, FALSE);
+}
+
