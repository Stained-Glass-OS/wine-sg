+
+#include "notepad.h"
+
+/* A header or footer: &f file name, &p page, &d date, &t time, && an
+ * ampersand, and &l, &c, &r putting what follows on the left, in the centre
+ * or on the right (centred when no code says otherwise), as Windows'
+ * Notepad reads them. */
+typedef struct { WCHAR part[3][MAX_PATH]; } HEADLINE;
+
+static void expand_header(const WCHAR *pat, const WCHAR *title, int page, HEADLINE *out)
+{
+    int n[3] = { 0, 0, 0 }, where = 1;
+    const int cap = MAX_PATH;
+
+    memset(out, 0, sizeof(*out));
+    while (*pat)
+    {
+        WCHAR *o = out->part[where];
+        if (*pat == '&' && pat[1])
+        {
+            WCHAR c = towlower(pat[1]), buf[80];
+            pat += 2;
+            buf[0] = 0;
+            switch (c)
+            {
+            case 'f': lstrcpynW(buf, title, ARRAY_SIZE(buf)); break;
+            case 'p': wsprintfW(buf, L"%d", page); break;
+            case 'd': GetDateFormatW(LOCALE_USER_DEFAULT, DATE_SHORTDATE, NULL, NULL, buf, ARRAY_SIZE(buf)); break;
+            case 't': GetTimeFormatW(LOCALE_USER_DEFAULT, 0, NULL, NULL, buf, ARRAY_SIZE(buf)); break;
+            case '&': lstrcpyW(buf, L"&"); break;
+            case 'l': where = 0; continue;
+            case 'c': where = 1; continue;
+            case 'r': where = 2; continue;
+            default: break;
+            }
+            if (n[where] < cap - 1) lstrcpynW(o + n[where], buf, cap - n[where]);
+            n[where] += lstrlenW(o + n[where]);
+            continue;
+        }
+        if (n[where] < cap - 1) o[n[where]++] = *pat;
+        pat++;
+    }
+}
+
+static void draw_header(HDC dc, const WCHAR *pat, const WCHAR *title, int page, int left, int right, int top, int h)
+{
+    static const UINT align[3] = { DT_LEFT, DT_CENTER, DT_RIGHT };
+    HEADLINE hl;
+    int i;
+    expand_header(pat, title, page, &hl);
+    for (i = 0; i < 3; i++)
+    {
+        RECT rc = { left, top, right, top + h };
+        if (hl.part[i][0]) DrawTextW(dc, hl.part[i], -1, &rc, align[i] | DT_SINGLELINE | DT_NOPREFIX);
+    }
+}
+
+/* The printer, or for tests (NOTEPAD_PRINT_EMF=<directory>) a letter-size
+ * enhanced metafile per page there, page<N>.emf. */
+typedef struct
+{
+    HDC dc, ref;
+    BOOL emf;
+    WCHAR dir[MAX_PATH];
+    int page;
+} PRINTER;
+
+static BOOL printer_start_page(PRINTER *p)
+{
+    if (!p->emf) return StartPage(p->dc) > 0;
+    {
+        WCHAR path[MAX_PATH + 16];
+        RECT r = { 0, 0, 21590, 27940 };
+        wsprintfW(path, L"%s\\page%d.emf", p->dir, ++p->page);
+        p->dc = CreateEnhMetaFileW(p->ref, path, &r, NULL);
+        return p->dc != NULL;
+    }
+}
+
+static void printer_end_page(PRINTER *p)
+{
+    if (!p->emf) { EndPage(p->dc); return; }
+    if (p->dc) DeleteEnhMetaFile(CloseEnhMetaFile(p->dc));
+    p->dc = p->ref;
+}
+
+static HDC get_printer_dc(HWND owner, PRINTSETUP *ps, BOOL show_dialog, const WCHAR *printer, BOOL *selection)
+{
+    PRINTDLGW pd;
+
+    *selection = FALSE;
+    if (printer && *printer) return CreateDCW(NULL, printer, NULL, NULL);
+    memset(&pd, 0, sizeof(pd));
+    pd.lStructSize = sizeof(pd);
+    pd.hwndOwner = owner;
+    pd.hDevMode = ps->devmode;
+    pd.hDevNames = ps->devnames;
+    pd.Flags = PD_RETURNDC | PD_USEDEVMODECOPIESANDCOLLATE | PD_NOPAGENUMS;
+    if (!show_dialog) pd.Flags |= PD_RETURNDEFAULT;
+    pd.nCopies = 1;
+    if (!PrintDlgW(&pd)) return NULL;
+    ps->devmode = pd.hDevMode;
+    ps->devnames = pd.hDevNames;
+    *selection = (pd.Flags & PD_SELECTION) != 0;
+    return pd.hDC;
+}
+
+BOOL print_document(HWND owner, HWND ed, const WCHAR *title, const LOGFONTW *screen_lf, PRINTSETUP *ps,
+                    BOOL show_dialog, const WCHAR *printer)
+{
+    BOOL selection = FALSE;
+    PRINTER pr;
+    HDC dc;
+    DOCINFOW di;
+    LOGFONTW lf;
+    HFONT font, old;
+    HDC screen;
+    int dpix, dpiy, left, top, right, bottom, pw, ph, line_h, y, page = 1, spacew;
+    TEXTMETRICW tm;
+    size_t a, b, anchor, caret, pos, len;
+    const WCHAR *text;
+    WCHAR *line = NULL;
+    size_t linecap = 0;
+    BOOL ok = TRUE, page_open = FALSE;
+    SIZE sz;
+
+    memset(&pr, 0, sizeof(pr));
+    if (GetEnvironmentVariableW(L"NOTEPAD_PRINT_EMF", pr.dir, ARRAY_SIZE(pr.dir)))
+    {
+        HDC screen = GetDC(NULL);
+        pr.emf = TRUE;
+        pr.ref = CreateCompatibleDC(screen);
+        ReleaseDC(NULL, screen);
+        dc = pr.dc = pr.ref;
+    }
+    else dc = pr.dc = get_printer_dc(owner, ps, show_dialog, printer, &selection);
+    if (!dc) return FALSE;
+    dpix = GetDeviceCaps(dc, LOGPIXELSX);
+    dpiy = GetDeviceCaps(dc, LOGPIXELSY);
+    pw = GetDeviceCaps(dc, PHYSICALWIDTH);
+    ph = GetDeviceCaps(dc, PHYSICALHEIGHT);
+    if (pr.emf) { pw = MulDiv(85, dpix, 10); ph = 11 * dpiy; }
+    if (!pw) pw = GetDeviceCaps(dc, HORZRES);
+    if (!ph) ph = GetDeviceCaps(dc, VERTRES);
+    left = MulDiv(ps->margins.left, dpix, 2540) - GetDeviceCaps(dc, PHYSICALOFFSETX);
+    top = MulDiv(ps->margins.top, dpiy, 2540) - GetDeviceCaps(dc, PHYSICALOFFSETY);
+    right = pw - MulDiv(ps->margins.right, dpix, 2540) - GetDeviceCaps(dc, PHYSICALOFFSETX);
+    bottom = ph - MulDiv(ps->margins.bottom, dpiy, 2540) - GetDeviceCaps(dc, PHYSICALOFFSETY);
+    if (pr.emf)
+    {
+        left = MulDiv(ps->margins.left, dpix, 2540);
+        top = MulDiv(ps->margins.top, dpiy, 2540);
+        right = pw - MulDiv(ps->margins.right, dpix, 2540);
+        bottom = ph - MulDiv(ps->margins.bottom, dpiy, 2540);
+    }
+    if (right - left < dpix || bottom - top < dpiy)
+    {
+        left = top = dpix / 2;
+        right = GetDeviceCaps(dc, HORZRES) - dpix / 2;
+        bottom = GetDeviceCaps(dc, VERTRES) - dpiy / 2;
+    }
+
+    screen = GetDC(NULL);
+    lf = *screen_lf;
+    lf.lfHeight = -MulDiv(abs(screen_lf->lfHeight), dpiy, GetDeviceCaps(screen, LOGPIXELSY));
+    lf.lfWidth = 0;
+    ReleaseDC(NULL, screen);
+    font = CreateFontIndirectW(&lf);
+    old = SelectObject(dc, font);
+    GetTextMetricsW(dc, &tm);
+    line_h = tm.tmHeight + tm.tmExternalLeading;
+    GetTextExtentPoint32W(dc, L" ", 1, &sz);
+    spacew = max(1, sz.cx);
+
+    memset(&di, 0, sizeof(di));
+    di.cbSize = sizeof(di);
+    di.lpszDocName = title;
+    if (!pr.emf && StartDocW(dc, &di) <= 0) { SelectObject(dc, old); DeleteObject(font); DeleteDC(dc); return FALSE; }
+
+    len = ed_length(ed);
+    text = ed_text(ed);
+    ed_get_sel(ed, &anchor, &caret);
+    a = selection ? min(anchor, caret) : 0;
+    b = selection ? max(anchor, caret) : len;
+    pos = a;
+    y = top + (ps->header[0] ? line_h * 2 : 0);
+
+    while (ok && (pos < b || page == 1))
+    {
+        size_t e = pos, n, k = 0, col = 0, i;
+        int fit;
+        if (!page_open)
+        {
+            if (!printer_start_page(&pr)) { ok = FALSE; break; }
+            dc = pr.dc;
+            page_open = TRUE;
+            SelectObject(dc, font);
+            SetTextColor(dc, RGB(0, 0, 0));
+            SetBkMode(dc, TRANSPARENT);
+            if (ps->header[0]) draw_header(dc, ps->header, title, page, left, right, top, line_h);
+        }
+        while (e < b && text[e] != '\r' && text[e] != '\n') e++;
+        /* the line with tabs expanded */
+        n = e - pos;
+        if (linecap < n * 8 + 1)
+        {
+            WCHAR *nl = realloc(line, (n * 8 + 1) * sizeof(WCHAR));
+            if (!nl) { ok = FALSE; break; }
+            line = nl;
+            linecap = n * 8 + 1;
+        }
+        for (i = pos; i < e; i++)
+        {
+            if (text[i] == '\t') { do line[k++] = ' '; while (++col % 4); }
+            else { line[k++] = text[i]; col++; }
+        }
+        line[k] = 0;
+        i = 0;
+        do
+        {
+            size_t rest = k - i, take;
+            if (y + line_h > bottom - (ps->footer[0] ? line_h * 2 : 0))
+            {
+                if (ps->footer[0]) draw_header(dc, ps->footer, title, page, left, right, bottom - line_h, line_h);
+                printer_end_page(&pr);
+                page++;
+                if (!printer_start_page(&pr)) { ok = FALSE; break; }
+                dc = pr.dc;
+                SelectObject(dc, font);
+                SetTextColor(dc, RGB(0, 0, 0));
+                SetBkMode(dc, TRANSPARENT);
+                y = top;
+                if (ps->header[0])
+                {
+                    draw_header(dc, ps->header, title, page, left, right, top, line_h);
+                    y += line_h * 2;
+                }
+            }
+            fit = (int)rest;
+            if (rest && !GetTextExtentExPointW(dc, line + i, (int)min(rest, 0x7fffffff), right - left, &fit, NULL, &sz)) fit = (int)rest;
+            take = max(1, (size_t)fit);
+            if (take < rest)
+            {
+                size_t sp = take;
+                while (sp > 0 && line[i + sp - 1] != ' ') sp--;
+                if (sp > 0) take = sp;
+            }
+            if (rest) TextOutW(dc, left, y, line + i, (int)min(take, rest));
+            y += line_h;
+            i += rest ? take : 1;
+        } while (i < k);
+        (void)spacew;
+        /* past the line end */
+        if (e < b && text[e] == '\r' && e + 1 < b && text[e + 1] == '\n') e++;
+        pos = e + 1;
+        if (e >= b) break;
+    }
+    if (page_open)
+    {
+        if (ps->footer[0]) draw_header(dc, ps->footer, title, page, left, right, bottom - line_h, line_h);
+        printer_end_page(&pr);
+    }
+    dc = pr.dc;
+    if (!pr.emf) { if (ok) EndDoc(dc); else AbortDoc(dc); }
+    free(line);
+    SelectObject(dc, old);
+    DeleteObject(font);
+    DeleteDC(dc);
+    return ok;
+}
+
+/* Page Setup is the common dialog grown by a Header and a Footer box, as in
+ * Windows' Notepad: the hook makes room under the dialog's own controls. */
+static UINT CALLBACK page_setup_hook(HWND dlg, UINT msg, WPARAM wp, LPARAM lp)
+{
+    PRINTSETUP *ps = (PRINTSETUP *)GetPropW(dlg, L"SgNotepadPS");
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        PAGESETUPDLGW *psd = (PAGESETUPDLGW *)lp;
+        RECT rw, rc, du = { 0, 0, 4, 8 }, child;
+        HWND c;
+        HFONT font = (HFONT)SendMessageW(dlg, WM_GETFONT, 0, 0);
+        int extra, lh, row, x0, labw, editw, i, bottom = 0;
+        HWND after = HWND_TOP;
+        static const WCHAR *labels[2] = { L"&Header:", L"&Footer:" };
+
+        ps = (PRINTSETUP *)psd->lCustData;
+        SetPropW(dlg, L"SgNotepadPS", ps);
+        MapDialogRect(dlg, &du);                    /* du.right: 4 dialog units, du.bottom: 8 */
+        lh = du.bottom * 14 / 8;
+        extra = lh * 2 + du.bottom;
+        GetWindowRect(dlg, &rw);
+        GetClientRect(dlg, &rc);
+        /* the buttons along the bottom move down; the rest stays */
+        for (c = GetWindow(dlg, GW_CHILD); c; c = GetWindow(c, GW_HWNDNEXT))
+        {
+            WCHAR cls[16];
+            GetWindowRect(c, &child);
+            MapWindowPoints(NULL, dlg, (POINT *)&child, 2);
+            GetClassNameW(c, cls, ARRAY_SIZE(cls));
+            if (!wcsicmp(cls, L"Button") && (GetWindowLongW(c, GWL_STYLE) & BS_TYPEMASK) <= BS_DEFPUSHBUTTON &&
+                child.top > rc.bottom * 3 / 4)
+                SetWindowPos(c, NULL, child.left, child.top + extra, 0, 0, SWP_NOSIZE | SWP_NOZORDER);
+            else if (child.bottom > bottom) { bottom = child.bottom; after = c; }
+        }
+        SetWindowPos(dlg, NULL, 0, 0, rw.right - rw.left, rw.bottom - rw.top + extra, SWP_NOMOVE | SWP_NOZORDER);
+        x0 = du.right * 2;
+        labw = du.right * 10;
+        editw = rc.right - x0 * 2 - labw;
+        row = bottom + du.bottom / 2;
+        for (i = 0; i < 2; i++)
+        {
+            HWND l = CreateWindowExW(0, L"Static", labels[i], WS_CHILD | WS_VISIBLE | SS_LEFT, x0, row + i * lh + 3,
+                                     labw, lh - 4, dlg, (HMENU)(UINT_PTR)(0x3f0 + i * 2), NULL, NULL);
+            HWND e = CreateWindowExW(WS_EX_CLIENTEDGE, L"Edit", i ? ps->footer : ps->header,
+                                     WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL, x0 + labw, row + i * lh,
+                                     editw, lh - 4, dlg, (HMENU)(UINT_PTR)(0x3f1 + i * 2), NULL, NULL);
+            SendMessageW(l, WM_SETFONT, (WPARAM)font, 0);
+            SendMessageW(e, WM_SETFONT, (WPARAM)font, 0);
+            /* in the tab order after the margins, before the buttons */
+            SetWindowPos(l, after, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+            SetWindowPos(e, l, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+            after = e;
+        }
+        return FALSE;
+    }
+    case WM_COMMAND:
+        if (LOWORD(wp) == IDOK && ps)
+        {
+            GetDlgItemTextW(dlg, 0x3f1, ps->header, ARRAY_SIZE(ps->header));
+            GetDlgItemTextW(dlg, 0x3f3, ps->footer, ARRAY_SIZE(ps->footer));
+        }
+        return FALSE;
+    case WM_DESTROY:
+        RemovePropW(dlg, L"SgNotepadPS");
+        return FALSE;
+    }
+    return FALSE;
+}
+
+void print_page_setup(HWND owner, PRINTSETUP *ps)
+{
+    PAGESETUPDLGW psd;
+    memset(&psd, 0, sizeof(psd));
+    psd.lStructSize = sizeof(psd);
+    psd.hwndOwner = owner;
+    psd.hDevMode = ps->devmode;
+    psd.hDevNames = ps->devnames;
+    psd.Flags = PSD_INHUNDREDTHSOFMILLIMETERS | PSD_MARGINS | PSD_ENABLEPAGESETUPHOOK;
+    psd.rtMargin = ps->margins;
+    psd.lpfnPageSetupHook = page_setup_hook;
+    psd.lCustData = (LPARAM)ps;
+    if (PageSetupDlgW(&psd))
+    {
+        ps->devmode = psd.hDevMode;
+        ps->devnames = psd.hDevNames;
+        ps->margins = psd.rtMargin;
+    }
+}
diff --git a/programs/notepad/regex.c b/programs/notepad/regex.c
new file mode 100644
index 0000000..28bc5ec
--- /dev/null
+++ b/programs/notepad/regex.c
@@ -0,0 +1,700 @@
+/*
+ * Notepad -- regular expressions for find and replace
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* An ECMAScript-flavoured subset, compiled to a small program and run by a
+ * backtracking machine with an explicit stack (no recursion, so a long line
+ * cannot overflow the thread stack) and a step budget (so a pathological
+ * pattern gives up instead of hanging the editor).
+ *
+ * Supported: literals, . [...] [^...] \d \D \w \W \s \S \b \B \t \n \r \xHH
+ * \uHHHH, ^ $ (line anchors), ( ) (?: ) | * + ? {n} {n,} {n,m}, lazy
+ * quantifiers, and back-references \1-\9. */
+
+#include "notepad.h"
+
+enum { OP_CHAR, OP_ANY, OP_CLASS, OP_BOL, OP_EOL, OP_WORDB, OP_NWORDB, OP_SPLIT, OP_JMP,
+       OP_SAVE, OP_BACKREF, OP_MATCH };
+
+typedef struct
+{
+    int     nranges;
+    WCHAR  *ranges;     /* lo, hi pairs */
+    BOOL    negate;
+    BYTE    digit, ndigit, word, nword, space, nspace;
+} CLASSDEF;
+
+typedef struct
+{
+    BYTE      op;
+    WCHAR     c;
+    int       x, y;
+    CLASSDEF *cls;
+} INST;
+
+/* the parse tree */
+enum { N_EMPTY, N_CHAR, N_ANY, N_CLASS, N_BOL, N_EOL, N_WORDB, N_NWORDB, N_BACKREF,
+       N_GROUP, N_CONCAT, N_ALT, N_REPEAT };
+
+typedef struct node
+{
+    int          type;
+    WCHAR        c;
+    CLASSDEF    *cls;
+    int          group;       /* N_GROUP: capture index or -1 */
+    int          min, max;    /* N_REPEAT; max -1 = unbounded */
+    BOOL         greedy;
+    struct node *a, *b;
+} NODE;
+
+struct regex
+{
+    INST     *prog;
+    int       nprog, capprog;
+    int       ngroups;
+    BOOL      icase;
+    CLASSDEF **classes;
+    int       nclasses;
+    NODE     **nodes;
+    int       nnodes;
+    /* parser state */
+    const WCHAR *p;
+    const WCHAR *error;
+};
+
+#define MAX_GROUPS 32
+#define MAX_PROG   100000
+
+static NODE *new_node(REGEX *re, int type)
+{
+    NODE *n = calloc(1, sizeof(*n)), **nn;
+    if (!n) return NULL;
+    nn = realloc(re->nodes, (re->nnodes + 1) * sizeof(NODE *));
+    if (!nn) { free(n); return NULL; }
+    re->nodes = nn;
+    re->nodes[re->nnodes++] = n;
+    n->type = type;
+    n->group = -1;
+    return n;
+}
+
+static CLASSDEF *new_class(REGEX *re)
+{
+    CLASSDEF *c = calloc(1, sizeof(*c)), **nc;
+    if (!c) return NULL;
+    nc = realloc(re->classes, (re->nclasses + 1) * sizeof(CLASSDEF *));
+    if (!nc) { free(c); return NULL; }
+    re->classes = nc;
+    re->classes[re->nclasses++] = c;
+    return c;
+}
+
+static void class_add(CLASSDEF *c, WCHAR lo, WCHAR hi)
+{
+    WCHAR *r = realloc(c->ranges, (c->nranges + 1) * 2 * sizeof(WCHAR));
+    if (!r) return;
+    c->ranges = r;
+    r[c->nranges * 2] = lo;
+    r[c->nranges * 2 + 1] = hi;
+    c->nranges++;
+}
+
+static int hexval(WCHAR c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* a simple escape (one character); returns FALSE if not one */
+static BOOL simple_escape(REGEX *re, WCHAR *out)
+{
+    WCHAR e = *re->p;
+    int i, v, digits;
+    switch (e)
+    {
+    case 't': *out = '\t'; re->p++; return TRUE;
+    case 'n': *out = '\n'; re->p++; return TRUE;
+    case 'r': *out = '\r'; re->p++; return TRUE;
+    case 'f': *out = '\f'; re->p++; return TRUE;
+    case 'v': *out = '\v'; re->p++; return TRUE;
+    case '0': *out = 0;    re->p++; return TRUE;
+    case 'x': case 'u':
+        digits = (e == 'x') ? 2 : 4;
+        for (i = 0, v = 0; i < digits; i++)
+        {
+            int h = hexval(re->p[1 + i]);
+            if (h < 0) { re->error = L"bad \\x or \\u escape"; return FALSE; }
+            v = v * 16 + h;
+        }
+        re->p += 1 + digits;
+        *out = (WCHAR)v;
+        return TRUE;
+    }
+    if (e && !((e >= 'a' && e <= 'z') || (e >= 'A' && e <= 'Z') || (e >= '0' && e <= '9')))
+    {
+        *out = e;
+        re->p++;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL class_escape(REGEX *re, CLASSDEF *c)
+{
+    switch (*re->p)
+    {
+    case 'd': c->digit = 1; break;
+    case 'D': c->ndigit = 1; break;
+    case 'w': c->word = 1; break;
+    case 'W': c->nword = 1; break;
+    case 's': c->space = 1; break;
+    case 'S': c->nspace = 1; break;
+    default: return FALSE;
+    }
+    re->p++;
+    return TRUE;
+}
+
+static NODE *parse_alt(REGEX *re);
+
+static NODE *parse_class(REGEX *re)
+{
+    NODE *n = new_node(re, N_CLASS);
+    CLASSDEF *c = new_class(re);
+    BOOL first = TRUE;
+
+    if (!n || !c) return NULL;
+    n->cls = c;
+    if (*re->p == '^') { c->negate = TRUE; re->p++; }
+    while (*re->p && (*re->p != ']' || first))
+    {
+        WCHAR lo, hi;
+        first = FALSE;
+        if (*re->p == '\\')
+        {
+            re->p++;
+            if (class_escape(re, c)) continue;
+            if (*re->p == 'b') { lo = '\b'; re->p++; }
+            else if (!simple_escape(re, &lo)) { if (!re->error) re->error = L"bad escape in class"; return NULL; }
+        }
+        else lo = *re->p++;
+        hi = lo;
+        if (re->p[0] == '-' && re->p[1] && re->p[1] != ']')
+        {
+            re->p++;
+            if (*re->p == '\\')
+            {
+                re->p++;
+                if (!simple_escape(re, &hi)) { if (!re->error) re->error = L"bad range"; return NULL; }
+            }
+            else hi = *re->p++;
+            if (hi < lo) { re->error = L"bad range in class"; return NULL; }
+        }
+        class_add(c, lo, hi);
+    }
+    if (*re->p != ']') { re->error = L"missing ]"; return NULL; }
+    re->p++;
+    return n;
+}
+
+static NODE *parse_atom(REGEX *re)
+{
+    NODE *n;
+    WCHAR ch = *re->p;
+
+    switch (ch)
+    {
+    case '(':
+        re->p++;
+        n = new_node(re, N_GROUP);
+        if (!n) return NULL;
+        if (re->p[0] == '?' && re->p[1] == ':') re->p += 2;
+        else if (re->p[0] == '?') { re->error = L"unsupported group"; return NULL; }
+        else
+        {
+            if (re->ngroups >= MAX_GROUPS) { re->error = L"too many groups"; return NULL; }
+            n->group = re->ngroups++;
+        }
+        n->a = parse_alt(re);
+        if (re->error) return NULL;
+        if (*re->p != ')') { re->error = L"missing )"; return NULL; }
+        re->p++;
+        return n;
+    case '[':
+        re->p++;
+        return parse_class(re);
+    case '.':
+        re->p++;
+        return new_node(re, N_ANY);
+    case '^':
+        re->p++;
+        return new_node(re, N_BOL);
+    case '$':
+        re->p++;
+        return new_node(re, N_EOL);
+    case '\\':
+        re->p++;
+        if (!*re->p) { re->error = L"trailing \\"; return NULL; }
+        if (*re->p == 'b') { re->p++; return new_node(re, N_WORDB); }
+        if (*re->p == 'B') { re->p++; return new_node(re, N_NWORDB); }
+        if (*re->p >= '1' && *re->p <= '9')
+        {
+            n = new_node(re, N_BACKREF);
+            if (n) n->group = *re->p - '0';
+            re->p++;
+            return n;
+        }
+        if (wcschr(L"dDwWsS", *re->p))
+        {
+            n = new_node(re, N_CLASS);
+            if (!n || !(n->cls = new_class(re))) return NULL;
+            class_escape(re, n->cls);
+            return n;
+        }
+        n = new_node(re, N_CHAR);
+        if (!n) return NULL;
+        if (!simple_escape(re, &n->c)) { if (!re->error) re->error = L"unknown escape"; return NULL; }
+        return n;
+    case '*': case '+': case '?':
+        re->error = L"nothing to repeat";
+        return NULL;
+    }
+    re->p++;
+    n = new_node(re, N_CHAR);
+    if (n) n->c = ch;
+    return n;
+}
+
+static BOOL parse_int(REGEX *re, int *v)
+{
+    if (*re->p < '0' || *re->p > '9') return FALSE;
+    *v = 0;
+    while (*re->p >= '0' && *re->p <= '9') { *v = min(*v * 10 + (*re->p - '0'), 10000); re->p++; }
+    return TRUE;
+}
+
+static NODE *parse_repeat(REGEX *re, NODE *atom)
+{
+    for (;;)
+    {
+        int mn, mx;
+        const WCHAR *save = re->p;
+        NODE *r;
+        switch (*re->p)
+        {
+        case '*': mn = 0; mx = -1; re->p++; break;
+        case '+': mn = 1; mx = -1; re->p++; break;
+        case '?': mn = 0; mx = 1; re->p++; break;
+        case '{':
+            re->p++;
+            if (!parse_int(re, &mn)) { re->p = save; return atom; }
+            mx = mn;
+            if (*re->p == ',')
+            {
+                re->p++;
+                if (!parse_int(re, &mx)) mx = -1;
+            }
+            if (*re->p != '}') { re->p = save; return atom; }
+            re->p++;
+            if (mx >= 0 && mx < mn) { re->error = L"bad {n,m}"; return NULL; }
+            break;
+        default:
+            return atom;
+        }
+        if (atom->type == N_BOL || atom->type == N_EOL || atom->type == N_WORDB || atom->type == N_NWORDB)
+        {
+            re->error = L"nothing to repeat";
+            return NULL;
+        }
+        if (!(r = new_node(re, N_REPEAT))) return NULL;
+        r->a = atom;
+        r->min = mn;
+        r->max = mx;
+        r->greedy = TRUE;
+        if (*re->p == '?') { r->greedy = FALSE; re->p++; }
+        atom = r;
+    }
+}
+
+static NODE *parse_concat(REGEX *re)
+{
+    NODE *seq = NULL;
+    while (*re->p && *re->p != '|' && *re->p != ')')
+    {
+        NODE *a = parse_atom(re), *c;
+        if (!a) return NULL;
+        if (!(a = parse_repeat(re, a))) return NULL;
+        if (!seq) { seq = a; continue; }
+        if (!(c = new_node(re, N_CONCAT))) return NULL;
+        c->a = seq;
+        c->b = a;
+        seq = c;
+    }
+    return seq ? seq : new_node(re, N_EMPTY);
+}
+
+static NODE *parse_alt(REGEX *re)
+{
+    NODE *left = parse_concat(re);
+    while (left && *re->p == '|')
+    {
+        NODE *alt, *right;
+        re->p++;
+        if (!(right = parse_concat(re))) return NULL;
+        if (!(alt = new_node(re, N_ALT))) return NULL;
+        alt->a = left;
+        alt->b = right;
+        left = alt;
+    }
+    return left;
+}
+
+/* ------------------------------------------------------------ code generation */
+
+static int emit(REGEX *re, BYTE op)
+{
+    if (re->nprog >= MAX_PROG) { re->error = L"pattern too large"; return 0; }
+    if (re->nprog == re->capprog)
+    {
+        int cap = re->capprog ? re->capprog * 2 : 64;
+        INST *np = realloc(re->prog, cap * sizeof(INST));
+        if (!np) { re->error = L"out of memory"; return 0; }
+        re->prog = np;
+        re->capprog = cap;
+    }
+    memset(&re->prog[re->nprog], 0, sizeof(INST));
+    re->prog[re->nprog].op = op;
+    return re->nprog++;
+}
+
+static void gen(REGEX *re, NODE *n)
+{
+    int i, l1, l2;
+    if (re->error || !n) return;
+    switch (n->type)
+    {
+    case N_EMPTY: break;
+    case N_CHAR: i = emit(re, OP_CHAR); if (!re->error) re->prog[i].c = n->c; break;
+    case N_ANY: emit(re, OP_ANY); break;
+    case N_CLASS: i = emit(re, OP_CLASS); if (!re->error) re->prog[i].cls = n->cls; break;
+    case N_BOL: emit(re, OP_BOL); break;
+    case N_EOL: emit(re, OP_EOL); break;
+    case N_WORDB: emit(re, OP_WORDB); break;
+    case N_NWORDB: emit(re, OP_NWORDB); break;
+    case N_BACKREF: i = emit(re, OP_BACKREF); if (!re->error) re->prog[i].x = n->group; break;
+    case N_GROUP:
+        if (n->group >= 0) { i = emit(re, OP_SAVE); if (!re->error) re->prog[i].x = 2 * (n->group + 1); }
+        gen(re, n->a);
+        if (n->group >= 0) { i = emit(re, OP_SAVE); if (!re->error) re->prog[i].x = 2 * (n->group + 1) + 1; }
+        break;
+    case N_CONCAT:
+        gen(re, n->a);
+        gen(re, n->b);
+        break;
+    case N_ALT:
+        l1 = emit(re, OP_SPLIT);
+        gen(re, n->a);
+        l2 = emit(re, OP_JMP);
+        if (re->error) return;
+        re->prog[l1].x = l1 + 1;
+        re->prog[l1].y = re->nprog;
+        gen(re, n->b);
+        if (re->error) return;
+        re->prog[l2].x = re->nprog;
+        break;
+    case N_REPEAT:
+        for (i = 0; i < n->min; i++) gen(re, n->a);
+        if (n->max < 0)
+        {
+            /* L1: split L2, L3; L2: a; jmp L1; L3: */
+            l1 = emit(re, OP_SPLIT);
+            gen(re, n->a);
+            l2 = emit(re, OP_JMP);
+            if (re->error) return;
+            re->prog[l2].x = l1;
+            re->prog[l1].x = n->greedy ? l1 + 1 : re->nprog;
+            re->prog[l1].y = n->greedy ? re->nprog : l1 + 1;
+        }
+        else
+        {
+            int k, *fix = malloc(sizeof(int) * (n->max - n->min + 1)), nfix = 0;
+            if (!fix) { re->error = L"out of memory"; return; }
+            for (k = n->min; k < n->max; k++)
+            {
+                l1 = emit(re, OP_SPLIT);
+                if (re->error) break;
+                fix[nfix++] = l1;
+                gen(re, n->a);
+            }
+            for (k = 0; k < nfix && !re->error; k++)
+            {
+                l1 = fix[k];
+                re->prog[l1].x = n->greedy ? l1 + 1 : re->nprog;
+                re->prog[l1].y = n->greedy ? re->nprog : l1 + 1;
+            }
+            free(fix);
+        }
+        break;
+    }
+}
+
+void re_free(REGEX *re)
+{
+    int i;
+    if (!re) return;
+    for (i = 0; i < re->nclasses; i++) { free(re->classes[i]->ranges); free(re->classes[i]); }
+    for (i = 0; i < re->nnodes; i++) free(re->nodes[i]);
+    free(re->classes);
+    free(re->nodes);
+    free(re->prog);
+    free(re);
+}
+
+REGEX *re_compile(const WCHAR *pattern, BOOL icase, const WCHAR **error)
+{
+    REGEX *re = calloc(1, sizeof(*re));
+    NODE *root;
+    int i;
+
+    *error = NULL;
+    if (!re) { *error = L"out of memory"; return NULL; }
+    re->icase = icase;
+    re->p = pattern;
+    root = parse_alt(re);
+    if (!re->error && *re->p) re->error = (*re->p == ')') ? L"unmatched )" : L"syntax error";
+    if (!re->error)
+    {
+        i = emit(re, OP_SAVE);
+        if (!re->error) re->prog[i].x = 0;
+        gen(re, root);
+        i = emit(re, OP_SAVE);
+        if (!re->error) re->prog[i].x = 1;
+        emit(re, OP_MATCH);
+    }
+    for (i = 0; !re->error && i < re->nprog; i++)
+        if (re->prog[i].op == OP_BACKREF && re->prog[i].x > re->ngroups) re->error = L"back-reference to a missing group";
+    /* the tree is not needed once compiled */
+    for (i = 0; i < re->nnodes; i++) free(re->nodes[i]);
+    free(re->nodes);
+    re->nodes = NULL;
+    re->nnodes = 0;
+    if (re->error)
+    {
+        *error = re->error;
+        re_free(re);
+        return NULL;
+    }
+    return re;
+}
+
+int re_ngroups(const REGEX *re)
+{
+    return re->ngroups;
+}
+
+/* ------------------------------------------------------------ matching */
+
+static inline BOOL is_word(WCHAR c)
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' ||
+           (c >= 0x80 && IsCharAlphaNumericW(c));
+}
+
+static inline BOOL is_spc(WCHAR c)
+{
+    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v' || c == 0xa0 ||
+           c == 0x2028 || c == 0x2029 || c == 0x3000 || c == 0xfeff || (c >= 0x2000 && c <= 0x200a);
+}
+
+static WCHAR lower(WCHAR c)
+{
+    WCHAR s[2] = { c, 0 };
+    if (c < 128) return (c >= 'A' && c <= 'Z') ? c + 32 : c;
+    CharLowerBuffW(s, 1);
+    return s[0];
+}
+
+static WCHAR upper(WCHAR c)
+{
+    WCHAR s[2] = { c, 0 };
+    if (c < 128) return (c >= 'a' && c <= 'z') ? c - 32 : c;
+    CharUpperBuffW(s, 1);
+    return s[0];
+}
+
+static BOOL class_has(const CLASSDEF *c, WCHAR ch)
+{
+    int i;
+    if ((c->digit && ch >= '0' && ch <= '9') || (c->ndigit && !(ch >= '0' && ch <= '9')) ||
+        (c->word && is_word(ch)) || (c->nword && !is_word(ch)) ||
+        (c->space && is_spc(ch)) || (c->nspace && !is_spc(ch)))
+        return TRUE;
+    for (i = 0; i < c->nranges; i++)
+        if (ch >= c->ranges[2 * i] && ch <= c->ranges[2 * i + 1]) return TRUE;
+    return FALSE;
+}
+
+static BOOL class_match(const CLASSDEF *c, WCHAR ch, BOOL icase)
+{
+    BOOL in = class_has(c, ch);
+    if (!in && icase) in = class_has(c, lower(ch)) || class_has(c, upper(ch));
+    return c->negate ? !in : in;
+}
+
+typedef struct
+{
+    int    pc;
+    size_t sp;
+    int    slot;     /* >= 0: restore caps[slot] = sp on backtrack */
+} FRAME;
+
+static size_t steps_left;
+
+static BOOL run(REGEX *re, const WCHAR *text, size_t len, size_t start, size_t *caps, FRAME **stackp, size_t *stackcap)
+{
+    FRAME *stack = *stackp;
+    size_t nstack = 0, sp = start;
+    int pc = 0, ncaps = 2 * (re->ngroups + 1), i;
+
+    for (i = 0; i < ncaps; i++) caps[i] = (size_t)-1;
+
+#define PUSH(p, s, sl) do { \
+        if (nstack == *stackcap) { \
+            size_t nc = *stackcap ? *stackcap * 2 : 256; \
+            FRAME *ns = realloc(stack, nc * sizeof(FRAME)); \
+            if (!ns) return FALSE; \
+            stack = *stackp = ns; *stackcap = nc; \
+        } \
+        stack[nstack].pc = (p); stack[nstack].sp = (s); stack[nstack].slot = (sl); nstack++; \
+    } while (0)
+
+    for (;;)
+    {
+        const INST *in;
+        if (!steps_left) return FALSE;
+        steps_left--;
+        in = &re->prog[pc];
+        switch (in->op)
+        {
+        case OP_CHAR:
+            if (sp < len && (text[sp] == in->c || (re->icase && lower(text[sp]) == lower(in->c)))) { sp++; pc++; continue; }
+            goto fail;
+        case OP_ANY:
+            if (sp < len && text[sp] != '\n' && text[sp] != '\r') { sp++; pc++; continue; }
+            goto fail;
+        case OP_CLASS:
+            if (sp < len && class_match(in->cls, text[sp], re->icase)) { sp++; pc++; continue; }
+            goto fail;
+        case OP_BOL:
+            if (sp == 0 || text[sp - 1] == '\n' || (text[sp - 1] == '\r' && (sp >= len || text[sp] != '\n'))) { pc++; continue; }
+            goto fail;
+        case OP_EOL:
+            if (sp >= len || text[sp] == '\n' || (text[sp] == '\r')) { pc++; continue; }
+            goto fail;
+        case OP_WORDB:
+        case OP_NWORDB:
+        {
+            BOOL a = sp > 0 && is_word(text[sp - 1]), b = sp < len && is_word(text[sp]);
+            if ((a != b) == (in->op == OP_WORDB)) { pc++; continue; }
+            goto fail;
+        }
+        case OP_SPLIT:
+            PUSH(in->y, sp, -1);
+            pc = in->x;
+            continue;
+        case OP_JMP:
+            pc = in->x;
+            continue;
+        case OP_SAVE:
+            PUSH(0, caps[in->x], in->x);
+            caps[in->x] = sp;
+            pc++;
+            continue;
+        case OP_BACKREF:
+        {
+            size_t s = caps[2 * in->x], e = caps[2 * in->x + 1], k;
+            if (s == (size_t)-1 || e == (size_t)-1) { pc++; continue; }
+            if (sp + (e - s) > len) goto fail;
+            for (k = 0; k < e - s; k++)
+            {
+                WCHAR a = text[s + k], b = text[sp + k];
+                if (a != b && !(re->icase && lower(a) == lower(b))) goto fail;
+            }
+            sp += e - s;
+            pc++;
+            continue;
+        }
+        case OP_MATCH:
+            return TRUE;
+        }
+    fail:
+        for (;;)
+        {
+            if (!nstack) return FALSE;
+            nstack--;
+            if (stack[nstack].slot >= 0) { caps[stack[nstack].slot] = stack[nstack].sp; continue; }
+            pc = stack[nstack].pc;
+            sp = stack[nstack].sp;
+            break;
+        }
+    }
+#undef PUSH
+}
+
+BOOL re_search(REGEX *re, const WCHAR *text, size_t len, size_t from, BOOL backward, size_t *groups)
+{
+    FRAME *stack = NULL;
+    size_t stackcap = 0, pos;
+    BOOL found = FALSE;
+    const INST *first = &re->prog[1];
+    BOOL lit = (first->op == OP_CHAR && !re->icase);
+
+    steps_left = 50000000;
+    if (!backward)
+    {
+        for (pos = from; pos <= len; pos++)
+        {
+            if (lit)
+            {
+                while (pos < len && text[pos] != first->c) pos++;
+                if (pos >= len) break;
+            }
+            if (run(re, text, len, pos, groups, &stack, &stackcap)) { found = TRUE; break; }
+            if (!steps_left) break;
+        }
+    }
+    else
+    {
+        pos = from;
+        for (;;)
+        {
+            if ((!lit || (pos < len && text[pos] == first->c)) && run(re, text, len, pos, groups, &stack, &stackcap))
+            {
+                found = TRUE;
+                break;
+            }
+            if (!pos || !steps_left) break;
+            pos--;
+        }
+    }
+    free(stack);
+    return found;
+}
