+
+#ifndef NOTEPAD_H
+#define NOTEPAD_H
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <windef.h>
+#include <winbase.h>
+#include <wingdi.h>
+#include <winuser.h>
