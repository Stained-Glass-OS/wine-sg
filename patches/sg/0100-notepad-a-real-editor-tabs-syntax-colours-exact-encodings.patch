+    SendMessageW(G.main, WM_INITMENUPOPUP, (WPARAM)sub, 0);
+    cmd = TrackPopupMenu(sub, TPM_RETURNCMD | TPM_BOTTOMALIGN, pt.x, pt.y, 0, owner, NULL);
+    if (cmd) SendMessageW(G.main, WM_COMMAND, cmd, 0);
+}
+
+static LRESULT CALLBACK status_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg)
+    {
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint(hwnd, &ps);
+        paint_status(hwnd, hdc);
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_LBUTTONUP:
+    {
+        POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
+        int i;
+        for (i = 0; i < SP_COUNT; i++)
+        {
+            if (!PtInRect(&status_parts[i], pt)) continue;
+            ClientToScreen(hwnd, &pt);
+            pt.y -= S(2);
+            switch (i)
+            {
+            case SP_POS: SendMessageW(G.main, WM_COMMAND, CMD_GO_TO, 0); break;
+            case SP_ZOOM: SendMessageW(G.main, WM_COMMAND, CMD_ZOOM_RESET, 0); break;
+            case SP_EOL: popup_submenu(hwnd, CMD_EOL_CRLF, pt); break;
+            case SP_ENC: popup_submenu(hwnd, CMD_ENC_UTF8, pt); break;
+            case SP_LANG: popup_submenu(hwnd, CMD_LANG_BASE, pt); break;
+            }
+            break;
+        }
+        return 0;
+    }
+    case WM_SETCURSOR:
+        SetCursor(LoadCursorW(NULL, (LPCWSTR)IDC_ARROW));
+        return TRUE;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+/* ------------------------------------------------------------ tab strip */
+
+typedef struct { RECT tab, close; } TABGEOM;
+static TABGEOM *tab_geom;
+static RECT plus_rect;
+
+static void compute_tabs(HDC hdc)
+{
+    RECT rc;
+    int i, x, avail, total = 0, w, *wanted;
+    GetClientRect(G.tabs, &rc);
+    free(tab_geom);
+    tab_geom = calloc(max(1, G.ndocs), sizeof(TABGEOM));
+    wanted = calloc(max(1, G.ndocs), sizeof(int));
+    if (!tab_geom || !wanted) { free(wanted); return; }
+    avail = rc.right - S(8) - S(40);
+    for (i = 0; i < G.ndocs; i++)
+    {
+        WCHAR name[MAX_PATH];
+        SIZE sz;
+        HFONT of = SelectObject(hdc, G.ui_bold);
+        doc_display_name(G.docs[i], name, ARRAY_SIZE(name));
+        GetTextExtentPoint32W(hdc, name, lstrlenW(name), &sz);
+        SelectObject(hdc, of);
+        wanted[i] = max(S(96), min(S(260), sz.cx + S(62)));
+        total += wanted[i];
+    }
+    x = S(6);
+    for (i = 0; i < G.ndocs; i++)
+    {
+        w = total > avail ? max(S(44), MulDiv(wanted[i], avail, total)) : wanted[i];
+        SetRect(&tab_geom[i].tab, x, S(6), x + w, rc.bottom);
+        SetRect(&tab_geom[i].close, x + w - S(28), S(6) + (rc.bottom - S(6) - S(20)) / 2,
+                x + w - S(8), S(6) + (rc.bottom - S(6) - S(20)) / 2 + S(20));
+        x += w;
+    }
+    SetRect(&plus_rect, x + S(4), S(6) + (rc.bottom - S(6) - S(28)) / 2, x + S(4) + S(28),
+            S(6) + (rc.bottom - S(6) - S(28)) / 2 + S(28));
+    free(wanted);
+}
+
+static void draw_x(HDC hdc, RECT *r, COLORREF color, int size)
+{
+    HPEN pen = CreatePen(PS_SOLID, max(1, S(1)), color), old = SelectObject(hdc, pen);
+    int cx = (r->left + r->right) / 2, cy = (r->top + r->bottom) / 2, h = size / 2;
+    MoveToEx(hdc, cx - h, cy - h, NULL);
+    LineTo(hdc, cx + h + 1, cy + h + 1);
+    MoveToEx(hdc, cx + h, cy - h, NULL);
+    LineTo(hdc, cx - h - 1, cy + h + 1);
+    SelectObject(hdc, old);
+    DeleteObject(pen);
+}
+
+static void fill_round(HDC hdc, RECT *r, COLORREF color, int radius)
+{
+    HBRUSH br = CreateSolidBrush(color), oldb = SelectObject(hdc, br);
+    HPEN pen = CreatePen(PS_SOLID, 1, color), oldp = SelectObject(hdc, pen);
+    RoundRect(hdc, r->left, r->top, r->right, r->bottom, radius, radius);
+    SelectObject(hdc, oldb);
+    SelectObject(hdc, oldp);
+    DeleteObject(br);
+    DeleteObject(pen);
+}
+
+static void paint_tabs(HWND hwnd, HDC target)
+{
+    RECT rc, r;
+    HDC hdc;
+    HBITMAP bmp, oldbmp;
+    HBRUSH br;
+    HFONT old;
+    int i;
+
+    GetClientRect(hwnd, &rc);
+    hdc = CreateCompatibleDC(target);
+    bmp = CreateCompatibleBitmap(target, max(1, rc.right), max(1, rc.bottom));
+    oldbmp = SelectObject(hdc, bmp);
+    br = CreateSolidBrush(G.chrome.strip);
+    FillRect(hdc, &rc, br);
+    DeleteObject(br);
+    old = SelectObject(hdc, G.ui_font);
+    compute_tabs(hdc);
+    SetBkMode(hdc, TRANSPARENT);
+    for (i = 0; i < G.ndocs && tab_geom; i++)
+    {
+        WCHAR name[MAX_PATH];
+        BOOL active = (i == G.cur), hot = (i == G.hot_tab), modified = doc_modified(G.docs[i]);
+        r = tab_geom[i].tab;
+        if (active)
+        {
+            RECT low = r;
+            fill_round(hdc, &r, G.chrome.tab_active, S(12));
+            low.top = low.bottom - S(8);
+            br = CreateSolidBrush(G.chrome.tab_active);
+            FillRect(hdc, &low, br);
+            DeleteObject(br);
+            /* the accent line */
+            low = r;
+            low.left += S(10); low.right -= S(10);
+            low.top = r.top; low.bottom = r.top + S(2);
+            br = CreateSolidBrush(G.chrome.accent);
+            FillRect(hdc, &low, br);
+            DeleteObject(br);
+        }
+        else if (hot)
+        {
+            RECT h = r;
+            InflateRect(&h, -S(2), 0);
+            h.bottom -= S(4);
+            fill_round(hdc, &h, G.chrome.tab_hover, S(10));
+        }
+        else if (i + 1 != G.cur && i + 1 < G.ndocs)
+        {
+            HPEN pen = CreatePen(PS_SOLID, 1, G.chrome.border), op = SelectObject(hdc, pen);
+            MoveToEx(hdc, r.right - 1, r.top + S(8), NULL);
+            LineTo(hdc, r.right - 1, r.bottom - S(8));
+            SelectObject(hdc, op);
+            DeleteObject(pen);
+        }
+        doc_display_name(G.docs[i], name, ARRAY_SIZE(name));
+        SetTextColor(hdc, active ? G.chrome.text : G.chrome.dim);
+        SelectObject(hdc, active ? G.ui_bold : G.ui_font);
+        r.left += S(14);
+        r.right = tab_geom[i].close.left - S(4);
+        DrawTextW(hdc, name, -1, &r, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS);
+        SelectObject(hdc, G.ui_font);
+        if (G.hot_close == i)
+            fill_round(hdc, &tab_geom[i].close, G.dark ? RGB(0x40, 0x40, 0x40) : RGB(0xdc, 0xdc, 0xdc), S(6));
+        if (modified && !hot && !active)
+        {
+            RECT dot = tab_geom[i].close;
+            int cx = (dot.left + dot.right) / 2, cy = (dot.top + dot.bottom) / 2;
+            SetRect(&dot, cx - S(4), cy - S(4), cx + S(4), cy + S(4));
+            fill_round(hdc, &dot, G.chrome.dim, S(8));
+        }
+        else if (modified && active && G.hot_close != i && !hot)
+        {
+            RECT dot = tab_geom[i].close;
+            int cx = (dot.left + dot.right) / 2, cy = (dot.top + dot.bottom) / 2;
+            SetRect(&dot, cx - S(4), cy - S(4), cx + S(4), cy + S(4));
+            fill_round(hdc, &dot, G.chrome.text, S(8));
+        }
+        else if (active || hot)
+            draw_x(hdc, &tab_geom[i].close, G.chrome.text, S(8));
+    }
+    /* the + button */
+    if (G.hot_plus) fill_round(hdc, &plus_rect, G.chrome.tab_hover, S(8));
+    {
+        HPEN pen = CreatePen(PS_SOLID, max(1, S(1)), G.chrome.text), op = SelectObject(hdc, pen);
+        int cx = (plus_rect.left + plus_rect.right) / 2, cy = (plus_rect.top + plus_rect.bottom) / 2, h = S(6);
+        MoveToEx(hdc, cx - h, cy, NULL); LineTo(hdc, cx + h + 1, cy);
+        MoveToEx(hdc, cx, cy - h, NULL); LineTo(hdc, cx, cy + h + 1);
+        SelectObject(hdc, op);
+        DeleteObject(pen);
+    }
+    SelectObject(hdc, old);
+    BitBlt(target, 0, 0, rc.right, rc.bottom, hdc, 0, 0, SRCCOPY);
+    SelectObject(hdc, oldbmp);
+    DeleteObject(bmp);
+    DeleteDC(hdc);
+}
+
+static int tab_at(POINT pt, BOOL *on_close)
+{
+    int i;
+    *on_close = FALSE;
+    for (i = 0; i < G.ndocs && tab_geom; i++)
+        if (PtInRect(&tab_geom[i].tab, pt))
+        {
+            *on_close = PtInRect(&tab_geom[i].close, pt);
+            return i;
+        }
+    return -1;
+}
+
+static LRESULT CALLBACK tabs_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
+    BOOL on_close;
+    int i;
+
+    switch (msg)
+    {
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint(hwnd, &ps);
+        paint_tabs(hwnd, hdc);
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_MOUSEMOVE:
+    {
+        TRACKMOUSEEVENT tme;
+        int hot, hc;
+        BOOL hp;
+        i = tab_at(pt, &on_close);
+        hot = i;
+        hc = on_close ? i : -1;
+        hp = PtInRect(&plus_rect, pt);
+        if ((wp & MK_LBUTTON) && G.press_tab >= 0 && i >= 0 && i != G.press_tab)
+        {
+            /* drag to reorder */
+            DOC *t = G.docs[G.press_tab];
+            G.docs[G.press_tab] = G.docs[i];
+            G.docs[i] = t;
+            if (G.cur == G.press_tab) G.cur = i;
+            else if (G.cur == i) G.cur = G.press_tab;
+            G.press_tab = i;
+            InvalidateRect(hwnd, NULL, FALSE);
+        }
+        if (hot != G.hot_tab && G.tip) SendMessageW(G.tip, TTM_POP, 0, 0);
+        if (hot != G.hot_tab || hc != G.hot_close || hp != G.hot_plus)
+        {
+            G.hot_tab = hot;
+            G.hot_close = hc;
+            G.hot_plus = hp;
+            InvalidateRect(hwnd, NULL, FALSE);
+        }
+        tme.cbSize = sizeof(tme);
+        tme.dwFlags = TME_LEAVE;
+        tme.hwndTrack = hwnd;
+        TrackMouseEvent(&tme);
+        return 0;
+    }
+    case WM_MOUSELEAVE:
+        G.hot_tab = G.hot_close = -1;
+        G.hot_plus = FALSE;
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_LBUTTONDOWN:
+        i = tab_at(pt, &on_close);
+        G.press_tab = -1;
+        if (i >= 0 && !on_close)
+        {
+            activate(i);
+            G.press_tab = i;
+            SetCapture(hwnd);
+        }
+        return 0;
+    case WM_LBUTTONUP:
+        if (GetCapture() == hwnd) ReleaseCapture();
+        i = tab_at(pt, &on_close);
+        if (i >= 0 && on_close && G.press_tab < 0) close_tab(i);
+        else if (PtInRect(&plus_rect, pt)) new_tab();
+        G.press_tab = -1;
+        return 0;
+    case WM_LBUTTONDBLCLK:
+        if (tab_at(pt, &on_close) < 0 && !PtInRect(&plus_rect, pt)) new_tab();
+        return 0;
+    case WM_MBUTTONUP:
+        if ((i = tab_at(pt, &on_close)) >= 0) close_tab(i);
+        return 0;
+    case WM_RBUTTONUP:
+        if ((i = tab_at(pt, &on_close)) >= 0)
+        {
+            HMENU m = CreatePopupMenu();
+            UINT cmd;
+            activate(i);
+            AppendMenuW(m, MF_STRING, CMD_CLOSE_TAB, L"&Close tab");
+            AppendMenuW(m, MF_STRING | (G.ndocs > 1 ? 0 : MF_GRAYED), CMD_CLOSE_OTHERS, L"Close &other tabs");
+            AppendMenuW(m, MF_SEPARATOR, 0, NULL);
+            AppendMenuW(m, MF_STRING, CMD_SAVE, L"&Save");
+            AppendMenuW(m, MF_STRING | (G.docs[i]->path ? 0 : MF_GRAYED), CMD_RELOAD, L"Reloa&d");
+            ClientToScreen(hwnd, &pt);
+            cmd = TrackPopupMenu(m, TPM_RETURNCMD, pt.x, pt.y, 0, hwnd, NULL);
+            DestroyMenu(m);
+            if (cmd) SendMessageW(G.main, WM_COMMAND, cmd, 0);
+        }
+        return 0;
+    case WM_CAPTURECHANGED:
+        G.press_tab = -1;
+        return 0;
+    case WM_SIZE:
+        if (G.tip)
+        {
+            TTTOOLINFOW ti;
+            memset(&ti, 0, sizeof(ti));
+            ti.cbSize = sizeof(ti);
+            ti.hwnd = hwnd;
+            ti.uId = 1;
+            GetClientRect(hwnd, &ti.rect);
+            SendMessageW(G.tip, TTM_NEWTOOLRECTW, 0, (LPARAM)&ti);
+        }
+        break;
+    case WM_NOTIFY:
+    {
+        NMTTDISPINFOW *di = (NMTTDISPINFOW *)lp;
+        static WCHAR text[MAX_PATH * 2];
+        if (di->hdr.code != TTN_GETDISPINFOW) break;
+        text[0] = 0;
+        if (G.hot_tab >= 0 && G.hot_tab < G.ndocs)
+        {
+            DOC *d = G.docs[G.hot_tab];
+            if (G.hot_close == G.hot_tab) lstrcpyW(text, L"Close tab (Ctrl+W)");
+            else if (d->path) lstrcpynW(text, d->path, ARRAY_SIZE(text));
+            else doc_display_name(d, text, ARRAY_SIZE(text));
+        }
+        else if (G.hot_plus) lstrcpyW(text, L"New tab (Ctrl+N)");
+        di->lpszText = text;
+        return 0;
+    }
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+/* ------------------------------------------------------------ find bar */
+
+static UINT find_flags_now(void)
+{
+    return G.find_flags;
+}
+
+static void find_bar_read(void)
+{
+    if (!G.findbar) return;
+    GetDlgItemTextW(G.findbar, IDC_FIND_TEXT, G.find_text, ARRAY_SIZE(G.find_text));
+    GetDlgItemTextW(G.findbar, IDC_REPLACE_TEXT, G.replace_text, ARRAY_SIZE(G.replace_text));
+}
+
+static void apply_find_highlight(void)
+{
+    int i;
+    BOOL on = G.findbar && IsWindowVisible(G.findbar);
+    for (i = 0; i < G.ndocs; i++)
+        ed_set_find_highlight(G.docs[i]->ed, on && i == G.cur && G.find_text[0] ? G.find_text : NULL, G.find_flags);
+}
+
+static void show_find_count(void)
+{
+    HWND ed = cur_ed();
+    WCHAR buf[64];
+    int idx, n;
+    apply_find_highlight();
+    if (!G.findbar || !IsWindowVisible(G.findbar) || !ed) return;
+    if (!G.find_text[0]) { SetDlgItemTextW(G.findbar, IDC_FIND_STATUS, L""); return; }
+    n = find_count(ed, G.find_text, find_flags_now(), &idx);
+    if (n == 0) lstrcpyW(buf, load_str(STRING_NO_RESULTS));
+    else if (n < 0) buf[0] = 0;
+    else if (idx) wsprintfW(buf, load_str(STRING_N_OF_M), idx, n);
+    else wsprintfW(buf, L"%d", n);
+    SetDlgItemTextW(G.findbar, IDC_FIND_STATUS, buf);
+}
+
+static void do_find(BOOL back)
+{
+    HWND ed = cur_ed();
+    int r;
+    WCHAR msg[512];
+    if (!ed) return;
+    find_bar_read();
+    if (!G.find_text[0]) { SendMessageW(G.main, WM_COMMAND, CMD_FIND, 0); return; }
+    r = find_next(ed, G.find_text, find_flags_now() | (back ? FIND_BACK : 0));
+    if (r < 0)
+    {
+        wsprintfW(msg, load_str(STRING_BAD_REGEX), G.find_text);
+        set_status_msg(msg);
+        MessageBeep(MB_ICONEXCLAMATION);
+    }
+    else if (r == 0)
+    {
+        wsprintfW(msg, load_str(STRING_NOTFOUND), G.find_text);
+        set_status_msg(msg);
+        if (!G.findbar || !IsWindowVisible(G.findbar))
+            MessageBoxW(G.main, msg, load_str(STRING_NOTEPAD), MB_ICONINFORMATION | MB_OK);
+        else MessageBeep(MB_ICONASTERISK);
+    }
+    else set_status_msg(r == 2 ? load_str(STRING_WRAPPED) : L"");
+    show_find_count();
+}
