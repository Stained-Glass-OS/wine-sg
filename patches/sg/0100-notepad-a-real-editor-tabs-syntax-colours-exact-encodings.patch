diff --git a/programs/notepad/editor.c b/programs/notepad/editor.c
new file mode 100644
index 0000000..bd0e84e
--- /dev/null
+++ b/programs/notepad/editor.c
@@ -0,0 +1,2931 @@
+/*
+ * Notepad -- the editor control
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Our own editor control rather than the system EDIT control: it keeps the
+ * file's line ends, scales to large files (a gap buffer and a line index; only
+ * the lines on the screen are laid out and coloured), and draws syntax colours,
+ * a line-number gutter, the current line and matching brackets.
+ *
+ * Layout never asks GDI where a character landed: each character's advance
+ * comes from a per-font cache (GetTextExtentPoint32W, once per character) and
+ * the text is drawn with ExtTextOutW and that same advance array, so caret
+ * positions and pixels always agree -- including fallback fonts.
+ *
+ * The common EDIT messages (WM_GETTEXT, EM_GETSEL, EM_REPLACESEL, ...) are
+ * answered too, for programs and scripts that drive Notepad's text. */
+
+#include "notepad.h"
+#include <imm.h>
+
+#define NONE ((size_t)-1)
+
+enum { U_INS = 1, U_DEL = 2 };
+enum { M_NONE, M_TYPE, M_BACK, M_FWD };
+
+typedef struct
+{
+    BYTE   type;
+    size_t pos, len;
+    WCHAR *text;
+    int    group;
+    size_t sel_anchor, sel_caret;   /* before the group */
+} UNDOREC;
+
+typedef struct
+{
+    HWND     hwnd;
+    TEXTBUF  tb;
+
+    UNDOREC *undo;
+    size_t   nundo, capundo, undo_pos;
+    ptrdiff_t save_pos;
+    int      group_counter, group_depth, cur_group;
+    int      merge;                  /* M_*: how the last record may grow */
+    size_t   group_anchor, group_caret;
+
+    size_t   anchor, caret;
+    int      want_x;
+    BOOL     overwrite;
+
+    size_t   top_line;
+    int      top_sub, xoff;
+    int      cw, chh;
+
+    LOGFONTW lf;
+    int      zoom;
+    HFONT    font;
+    HDC      mdc;
+    int      line_h, text_h, ascent, char_w, space_w;
+    int     *wcache;
+    struct { UINT cp; int w; } pairs[64];
+    HFONT    fb[8];                  /* fallback fonts for glyphs the font lacks */
+    int      nfb;
+    BYTE    *fontmap;                /* per BMP character: 0 the font, k fallback k, 0xff not yet known */
+
+    EDOPTS   o;
+    EDTHEME  th;
+    int      lang;
+    EOLTYPE  eol;
+
+    int     *lstate;
+    size_t   lstatecap, hl_valid;
+
+    /* the current layout (one line) */
+    size_t   lay_line;
+    unsigned lay_ver;
+    int      lay_n, lay_nrows;
+    int     *xs;  size_t xscap;     /* x of each char, n + 1, cumulative across rows */
+    int     *rows; size_t rowscap;  /* nrows + 1 row starts, char indexes */
+    const WCHAR *lay_s;
+    BYTE    *sty; size_t stycap;
+
+    int      gutter_w, pad;
+    unsigned version;
+    int      max_width;
+    BOOL     focused;
+    BOOL     dragging, gutter_drag;
+    int      click_count;
+    DWORD    last_click;
+    POINT    last_pt;
+    size_t   drag_a, drag_b;          /* word/line selected by the click that began a drag */
+    int      drag_unit;
+    size_t   match_a, match_b;
+    int      wheel_acc;
+    BOOL     notify_off;
+    /* every match of the find bar's text, drawn behind the text */
+    WCHAR   *hl_text;
+    UINT     hl_flags;
+    REGEX   *hl_re;
+    size_t  *hl_m; size_t hl_mcap; int hl_n;
+    /* the minimap: a strip right of the text, cw..cw+mm_w */
+    int      full_w, mm_w;
+    BOOL     mm_drag;
+    BYTE    *mm_sty; size_t mm_stycap;
+    DWORD   *mm_px; size_t mm_pxcap;
+} EDITOR;
+
+static EDITOR *get(HWND hwnd)
+{
+    return (EDITOR *)GetWindowLongPtrW(hwnd, 0);
+}
+
+static void notify(EDITOR *e, UINT what)
+{
+    if (!e->notify_off) editor_notify(e->hwnd, what);
+}
+
+/* ------------------------------------------------------------ fonts and widths */
+
+static void free_font(EDITOR *e)
+{
+    int i;
+    if (e->font) DeleteObject(e->font);
+    e->font = NULL;
+    for (i = 0; i < e->nfb; i++) DeleteObject(e->fb[i]);
+    e->nfb = 0;
+}
+
+/* Fonts to borrow a glyph from when the editor's font has none: Wine links
+ * fonts only for a few interface faces, so a monospace font would otherwise
+ * show boxes for CJK, symbols and the like. */
+static const WCHAR *fallback_faces[] =
+{
+    L"DejaVu Sans Mono", L"DejaVu Sans", L"Noto Sans Mono", L"Noto Sans", L"Noto Sans CJK SC", L"Noto Sans CJK JP",
+    L"Droid Sans Fallback", L"WenQuanYi Zen Hei", L"Source Han Sans", L"Symbola", L"Noto Emoji", L"Segoe UI Symbol",
+    L"Microsoft YaHei", L"MS Gothic", L"Arial Unicode MS",
+};
+static BYTE face_present[ARRAY_SIZE(fallback_faces)];   /* 0 unknown, 1 yes, 2 no */
+
+static int CALLBACK face_proc(const LOGFONTW *lf, const TEXTMETRICW *tm, DWORD type, LPARAM lp)
+{
+    *(BOOL *)lp = TRUE;
+    return 0;
+}
+
+static BOOL have_face(HDC dc, int i)
+{
+    if (!face_present[i])
+    {
+        LOGFONTW lf;
+        BOOL found = FALSE;
+        memset(&lf, 0, sizeof(lf));
+        lf.lfCharSet = DEFAULT_CHARSET;
+        lstrcpynW(lf.lfFaceName, fallback_faces[i], LF_FACESIZE);
+        EnumFontFamiliesExW(dc, &lf, face_proc, (LPARAM)&found, 0);
+        face_present[i] = found ? 1 : 2;
+    }
+    return face_present[i] == 1;
+}
+
+/* which font draws c: 0 the editor's, k > 0 fallback k - 1 */
+static int font_for(EDITOR *e, WCHAR c)
+{
+    WORD gi;
+    int k;
+    if (e->fontmap[c] != 0xff) return e->fontmap[c];
+    e->fontmap[c] = 0;
+    if (c < 0x80 || (c >= 0xd800 && c <= 0xdfff) || c == 0xfeff) return 0;
+    if (GetGlyphIndicesW(e->mdc, &c, 1, &gi, GGI_MARK_NONEXISTING_GLYPHS) == 1 && gi != 0xffff) return 0;
+    for (k = 0; k < e->nfb; k++)
+    {
+        HFONT old = SelectObject(e->mdc, e->fb[k]);
+        BOOL has = GetGlyphIndicesW(e->mdc, &c, 1, &gi, GGI_MARK_NONEXISTING_GLYPHS) == 1 && gi != 0xffff;
+        SelectObject(e->mdc, old);
+        if (has) return e->fontmap[c] = k + 1;
+    }
+    return 0;
+}
+
+static HFONT font_n(EDITOR *e, int k)
+{
+    return k ? e->fb[k - 1] : e->font;
+}
+
+static void make_font(EDITOR *e)
+{
+    LOGFONTW lf = e->lf;
+    TEXTMETRICW tm;
+    SIZE sz;
+    int i;
+
+    free_font(e);
+    lf.lfHeight = MulDiv(e->lf.lfHeight, e->zoom, 100);
+    if (!lf.lfHeight) lf.lfHeight = e->lf.lfHeight < 0 ? -1 : 1;
+    lf.lfWidth = 0;
+    e->font = CreateFontIndirectW(&lf);
+    for (i = 0; i < ARRAY_SIZE(fallback_faces) && e->nfb < ARRAY_SIZE(e->fb); i++)
+    {
+        LOGFONTW f = lf;
+        if (!have_face(e->mdc, i) || !lstrcmpiW(fallback_faces[i], lf.lfFaceName)) continue;
+        lstrcpynW(f.lfFaceName, fallback_faces[i], LF_FACESIZE);
+        f.lfCharSet = DEFAULT_CHARSET;
+        f.lfPitchAndFamily = DEFAULT_PITCH;
+        e->fb[e->nfb++] = CreateFontIndirectW(&f);
+    }
+    memset(e->fontmap, 0xff, 65536);
+    SelectObject(e->mdc, e->font);
+    GetTextMetricsW(e->mdc, &tm);
+    e->text_h = tm.tmHeight;
+    e->ascent = tm.tmAscent;
+    e->line_h = tm.tmHeight + max(2, tm.tmHeight / 5);
+    GetTextExtentPoint32W(e->mdc, L"0", 1, &sz);
+    e->char_w = max(1, sz.cx);
+    GetTextExtentPoint32W(e->mdc, L" ", 1, &sz);
+    e->space_w = max(1, sz.cx);
+    for (i = 0; i < 65536; i++) e->wcache[i] = -1;
+    memset(e->pairs, 0, sizeof(e->pairs));
+    e->pad = max(4, e->char_w / 2);
+    e->version++;
+    e->max_width = 0;
+}
+
+static int char_width(EDITOR *e, WCHAR c)
+{
+    SIZE sz;
+    if (e->wcache[c] >= 0) return e->wcache[c];
+    if (c < 0x20 || c == 0x7f)
+    {
+        WCHAR pic = c == 0x7f ? 0x2421 : 0x2400 + c;
+        GetTextExtentPoint32W(e->mdc, &pic, 1, &sz);
+    }
+    else if (c >= 0xd800 && c <= 0xdfff)
+    {
+        WCHAR rep = 0xfffd;
+        GetTextExtentPoint32W(e->mdc, &rep, 1, &sz);
+    }
+    else if ((c >= 0x0300 && c <= 0x036f) || c == 0x200b || c == 0x200c || c == 0x200d || c == 0xfeff ||
+             (c >= 0xfe00 && c <= 0xfe0f))
+        sz.cx = 0;   /* combining marks, joiners and variation selectors take no room of their own */
+    else
+    {
+        int k = font_for(e, c);
+        if (k) SelectObject(e->mdc, font_n(e, k));
+        GetTextExtentPoint32W(e->mdc, &c, 1, &sz);
+        if (k) SelectObject(e->mdc, e->font);
+    }
+    return e->wcache[c] = max(0, sz.cx);
+}
+
+static int pair_width(EDITOR *e, WCHAR hi, WCHAR lo)
+{
+    UINT cp = 0x10000 + ((hi - 0xd800) << 10) + (lo - 0xdc00);
+    unsigned slot = cp % ARRAY_SIZE(e->pairs);
+    WCHAR s[2] = { hi, lo };
+    SIZE sz;
+    if (e->pairs[slot].cp == cp) return e->pairs[slot].w;
+    GetTextExtentPoint32W(e->mdc, s, 2, &sz);
+    e->pairs[slot].cp = cp;
+    e->pairs[slot].w = sz.cx;
+    return sz.cx;
+}
+
+static inline BOOL is_hi(WCHAR c) { return c >= 0xd800 && c <= 0xdbff; }
+static inline BOOL is_lo(WCHAR c) { return c >= 0xdc00 && c <= 0xdfff; }
+
+/* ------------------------------------------------------------ layout */
+
+static int text_left(EDITOR *e)
+{
+    return e->gutter_w + e->pad;
+}
+
+static int wrap_width(EDITOR *e)
+{
+    return max(e->char_w * 4, e->cw - text_left(e) - e->pad);
+}
+
+static BOOL grow(void **p, size_t *cap, size_t need, size_t elem)
+{
+    void *np;
+    size_t nc;
+    if (need <= *cap) return TRUE;
+    nc = need + need / 2 + 64;
+    if (!(np = realloc(*p, nc * elem))) return FALSE;
+    *p = np;
+    *cap = nc;
+    return TRUE;
+}
+
+static void layout(EDITOR *e, size_t line)
+{
+    size_t start = tb_line_start(&e->tb, line), end = tb_line_end(&e->tb, line);
+    int n = (int)(end - start), i, base = 0, last_break = -1, avail, tabpx, nrows = 0;
+    const WCHAR *s;
+
+    if (e->lay_line == line && e->lay_ver == e->version)
+    {
+        /* the text pointer may have moved with the gap */
+        e->lay_s = tb_range(&e->tb, start, n);
+        return;
+    }
+    s = tb_range(&e->tb, start, n);
+    if (!grow((void **)&e->xs, &e->xscap, n + 1, sizeof(int)) || !grow((void **)&e->rows, &e->rowscap, 2, sizeof(int)))
+    {
+        e->lay_n = 0; e->lay_nrows = 1; e->lay_s = s;
+        return;
+    }
+    avail = wrap_width(e);
+    tabpx = max(1, e->o.tab_width) * e->space_w;
+    e->rows[nrows++] = 0;
+    e->xs[0] = 0;
+    for (i = 0; i < n; i++)
+    {
+        WCHAR c = s[i];
+        int w, rel = e->xs[i] - base;
+        if (c == '\t') w = tabpx - rel % tabpx;
+        else if (is_hi(c) && i + 1 < n && is_lo(s[i + 1])) w = pair_width(e, c, s[i + 1]);
+        else if (is_lo(c) && i > 0 && is_hi(s[i - 1])) w = 0;
+        else w = char_width(e, c);
+
+        if (e->o.wrap && rel + w > avail && i > e->rows[nrows - 1] && !(is_lo(c) && i > 0 && is_hi(s[i - 1])))
+        {
+            int b = (last_break > e->rows[nrows - 1]) ? last_break : i;
+            if (!grow((void **)&e->rows, &e->rowscap, nrows + 2, sizeof(int))) break;
+            e->rows[nrows++] = b;
+            base = e->xs[b];
+            last_break = -1;
+            rel = e->xs[i] - base;
+            if (c == '\t') w = tabpx - rel % tabpx;
+        }
+        e->xs[i + 1] = e->xs[i] + w;
+        if (c == ' ' || c == '\t' || c == '-' || c == ',' || c == ';' || c == '/' || c == '\\') last_break = i + 1;
+    }
+    for (; i < n; i++) e->xs[i + 1] = e->xs[i];
+    e->rows[nrows] = n;
+    e->lay_nrows = nrows;
+    e->lay_n = n;
+    e->lay_s = s;
+    e->lay_line = line;
+    e->lay_ver = e->version;
+    if (!e->o.wrap && e->xs[n] > e->max_width) e->max_width = e->xs[n];
+}
+
+static int line_rows(EDITOR *e, size_t line)
+{
+    if (!e->o.wrap) return 1;
+    layout(e, line);
+    return e->lay_nrows;
+}
+
+/* row of a char index within the current layout */
+static int row_of(EDITOR *e, int idx)
+{
+    int r;
+    for (r = e->lay_nrows - 1; r > 0; r--)
+        if (idx >= e->rows[r]) break;
+    return r;
+}
+
+static int row_x(EDITOR *e, int idx)
+{
+    int r = row_of(e, idx);
+    return e->xs[idx] - e->xs[e->rows[r]];
+}
+
+/* ------------------------------------------------------------ highlighting */
+
+static void hl_invalidate(EDITOR *e, size_t line)
+{
+    if (line < e->hl_valid) e->hl_valid = line;
+}
+
+static int line_state(EDITOR *e, size_t line)
+{
+    size_t i;
+    if (e->lang == LANG_TEXT) return 0;
+    if (!grow((void **)&e->lstate, &e->lstatecap, e->tb.nlines + 1, sizeof(int))) return 0;
+    if (e->hl_valid == 0) e->lstate[0] = 0;
+    for (i = e->hl_valid; i < line && i < e->tb.nlines; i++)
+    {
+        size_t s = tb_line_start(&e->tb, i), n = tb_line_end(&e->tb, i) - s;
+        e->lstate[i + 1] = syn_line(e->lang, tb_range(&e->tb, s, n), (int)n, e->lstate[i], NULL);
+    }
+    if (line > e->hl_valid) e->hl_valid = min(line, e->tb.nlines);
+    return e->lstate[line];
+}
+
+/* styles for the current layout's line into e->sty */
+static void line_styles(EDITOR *e, size_t line)
+{
+    int st;
+    if (!grow((void **)&e->sty, &e->stycap, e->lay_n + 1, 1)) return;
+    if (e->lang == LANG_TEXT)
+    {
+        memset(e->sty, ST_DEFAULT, e->lay_n);
+        return;
+    }
+    st = line_state(e, line);
+    layout(e, line);  /* line_state may have moved the gap */
+    syn_line(e->lang, e->lay_s, e->lay_n, st, e->sty);
+}
+
+/* ------------------------------------------------------------ positions */
+
+static size_t len(EDITOR *e)
+{
+    return tb_len(&e->tb);
+}
+
+static WCHAR at(EDITOR *e, size_t pos)
+{
+    return tb_at(&e->tb, pos);
+}
+
+/* keep positions off the middle of a CRLF pair or a surrogate pair */
+static size_t fix_pos(EDITOR *e, size_t pos)
+{
+    size_t n = len(e);
+    if (pos > n) pos = n;
+    if (pos > 0 && pos < n)
+    {
+        if (at(e, pos - 1) == '\r' && at(e, pos) == '\n') pos--;
+        else if (is_hi(at(e, pos - 1)) && is_lo(at(e, pos))) pos--;
+    }
+    return pos;
+}
+
+static size_t next_pos(EDITOR *e, size_t pos)
+{
+    size_t line = tb_line_of(&e->tb, pos);
+    if (pos >= len(e)) return pos;
+    if (pos == tb_line_end(&e->tb, line)) return tb_line_next(&e->tb, line);
+    pos++;
+    if (is_lo(at(e, pos)) && is_hi(at(e, pos - 1))) pos++;
+    /* combining marks travel with their base */
+    while (pos < len(e) && at(e, pos) >= 0x300 && at(e, pos) <= 0x36f) pos++;
+    return pos;
+}
+
+static size_t prev_pos(EDITOR *e, size_t pos)
+{
+    size_t line = tb_line_of(&e->tb, pos);
+    if (!pos) return 0;
+    if (pos == tb_line_start(&e->tb, line)) return tb_line_end(&e->tb, line - 1);
+    pos--;
+    if (pos > 0 && is_lo(at(e, pos)) && is_hi(at(e, pos - 1))) pos--;
+    while (pos > tb_line_start(&e->tb, line) && at(e, pos) >= 0x300 && at(e, pos) <= 0x36f) pos--;
+    return pos;
+}
+
+static int char_class(WCHAR c)
+{
+    if (c == ' ' || c == '\t' || c == 0x3000 || c == 0xa0) return 0;
+    if (c == '\r' || c == '\n') return 3;
+    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' ||
+        (c >= 0x80 && IsCharAlphaNumericW(c)))
+        return 1;
+    return 2;
+}
+
+static size_t word_right(EDITOR *e, size_t pos)
+{
+    size_t n = len(e);
+    int cls;
+    if (pos >= n) return n;
+    cls = char_class(at(e, pos));
+    if (cls == 3) return next_pos(e, pos);
+    while (pos < n && char_class(at(e, pos)) == cls) pos++;
+    while (pos < n && char_class(at(e, pos)) == 0) pos++;
+    return fix_pos(e, pos);
+}
+
+static size_t word_left(EDITOR *e, size_t pos)
+{
+    int cls;
+    if (!pos) return 0;
+    if (char_class(at(e, pos - 1)) == 3) return prev_pos(e, pos);
+    while (pos > 0 && char_class(at(e, pos - 1)) == 0) pos--;
+    if (!pos || char_class(at(e, pos - 1)) == 3) return pos;
+    cls = char_class(at(e, pos - 1));
+    while (pos > 0 && char_class(at(e, pos - 1)) == cls) pos--;
+    return fix_pos(e, pos);
+}
+
+static void word_at(EDITOR *e, size_t pos, size_t *a, size_t *b)
+{
+    size_t n = len(e);
+    int cls;
+    size_t s = pos, t = pos;
+    if (pos >= n || char_class(at(e, pos)) == 3)
+    {
+        if (pos > 0 && char_class(at(e, pos - 1)) != 3) s = t = pos - 1;
+        else { *a = *b = pos; return; }
+    }
+    cls = char_class(at(e, s));
+    while (s > 0 && char_class(at(e, s - 1)) == cls) s--;
+    while (t < n && char_class(at(e, t)) == cls) t++;
+    *a = s;
+    *b = t;
+}
+
+/* ------------------------------------------------------------ scrolling */
+
+static int visible_rows(EDITOR *e)
+{
+    return max(1, e->chh / max(1, e->line_h));
+}
+
+static void update_gutter(EDITOR *e)
+{
+    int digits = 1, w;
+    size_t n = e->tb.nlines;
+    while (n >= 10) { digits++; n /= 10; }
+    digits = max(digits, 3);
+    w = e->o.line_numbers ? (digits + 2) * e->char_w : 0;
+    if (w != e->gutter_w)
+    {
+        e->gutter_w = w;
+        e->version++;
+    }
+}
+
+/* the top position that shows the last row at the bottom */
+static void max_top(EDITOR *e, size_t *line, int *sub)
+{
+    int need = visible_rows(e) - 1;
+    size_t l = e->tb.nlines - 1;
+    int r = line_rows(e, l) - 1;
+    while (need > 0)
+    {
+        if (r > 0) { r--; need--; continue; }
+        if (!l) break;
+        l--;
+        r = line_rows(e, l) - 1;
+        need--;
+    }
+    *line = l;
+    *sub = r;
+}
+
+static void clamp_top(EDITOR *e)
+{
+    size_t ml;
+    int ms;
+    if (e->top_line >= e->tb.nlines) { e->top_line = e->tb.nlines - 1; e->top_sub = 0; }
+    if (e->top_sub >= line_rows(e, e->top_line)) e->top_sub = line_rows(e, e->top_line) - 1;
+    max_top(e, &ml, &ms);
+    if (e->top_line > ml || (e->top_line == ml && e->top_sub > ms)) { e->top_line = ml; e->top_sub = ms; }
+    if (e->top_sub < 0) e->top_sub = 0;
+    if (e->o.wrap) e->xoff = 0;
+    else
+    {
+        int maxx = max(0, e->max_width + e->char_w * 4 - (e->cw - text_left(e)));
+        if (e->xoff > maxx) e->xoff = maxx;
+        if (e->xoff < 0) e->xoff = 0;
+    }
+}
+
+static void update_scrollbars(EDITOR *e)
+{
+    SCROLLINFO si;
+    size_t ml;
+    int ms;
+
+    max_top(e, &ml, &ms);
+    si.cbSize = sizeof(si);
+    si.fMask = SIF_RANGE | SIF_PAGE | SIF_POS | SIF_DISABLENOSCROLL;
+    si.nMin = 0;
+    si.nPage = visible_rows(e);
+    si.nMax = (int)min(ml + si.nPage - 1 + (ms > 0), 0x7ffffff0);
+    si.nPos = (int)min(e->top_line, 0x7ffffff0);
+    SetScrollInfo(e->hwnd, SB_VERT, &si, TRUE);
+
+    /* horizontal: only while something is out of view */
+    si.fMask = SIF_RANGE | SIF_PAGE | SIF_POS;
+    si.nPage = max(1, e->cw - text_left(e));
+    si.nMax = e->o.wrap ? 0 : e->max_width + e->char_w * 2;
+    si.nPos = e->xoff;
+    if (e->o.wrap || si.nMax < (int)si.nPage) { si.nMax = 0; si.nPage = 0; si.nPos = 0; }
+    SetScrollInfo(e->hwnd, SB_HORZ, &si, TRUE);
+}
+
+/* ------------------------------------------------------------ minimap
+ *
+ * Kate's minimap: the whole document in miniature, a pixel per character,
+ * coloured by the highlighter, the lines on screen shaded. A document that
+ * fits gets mm_row() pixels a line; a longer one is compressed to the strip's
+ * height, each pixel row showing the line it stands for. Only the rows the
+ * strip has are drawn, and a compressed strip never lexes past what the
+ * editor has already lexed (lines beyond are coloured from the start state),
+ * so a large file costs no more than the editor's own view. A click centres
+ * the editor on the line under it; dragging keeps doing so. */
+
+static int mm_row(EDITOR *e)
+{
+    int dpi = GetDeviceCaps(e->mdc, LOGPIXELSY);
+    return max(2, dpi / 48);
+}
+
+static BOOL mm_wanted(EDITOR *e)
+{
+    return e->o.minimap == 1 || (e->o.minimap == 2 && e->lang != LANG_TEXT);
+}
+
+/* the strip's width from the options, language and window; TRUE if changed */
+static BOOL mm_update_width(EDITOR *e)
+{
+    int dpi = GetDeviceCaps(e->mdc, LOGPIXELSX), w = 0;
+    if (mm_wanted(e) && e->full_w >= MulDiv(360, dpi, 96)) w = MulDiv(110, dpi, 96);
+    if (w == e->mm_w && e->cw == e->full_w - w) return FALSE;
+    e->mm_w = w;
+    e->cw = e->full_w - w;
+    e->version++;
+    return TRUE;
+}
+
+static BOOL mm_compressed(EDITOR *e)
+{
+#ifdef SG_MUTANT_MMSCALE
+    return FALSE;
+#else
+    return e->tb.nlines * (size_t)mm_row(e) > (size_t)max(1, e->chh);
+#endif
+}
+
+/* the line a pixel row of the strip shows, or NONE below the document */
+static size_t mm_line_at(EDITOR *e, int y)
+{
+    size_t l;
+    if (y < 0) y = 0;
+    if (mm_compressed(e)) l = (size_t)((double)y * e->tb.nlines / max(1, e->chh));
+    else l = (size_t)(y / mm_row(e));
+    return l < e->tb.nlines ? l : NONE;
+}
+
+/* the first pixel row of a line */
+static int mm_y_of(EDITOR *e, size_t line)
+{
+    if (mm_compressed(e)) return (int)((double)line * e->chh / e->tb.nlines);
+    return (int)(line * mm_row(e));
+}
+
+static COLORREF mix(COLORREF a, COLORREF b, int pct)   /* pct of b */
+{
+    return RGB((GetRValue(a) * (100 - pct) + GetRValue(b) * pct) / 100,
+               (GetGValue(a) * (100 - pct) + GetGValue(b) * pct) / 100,
+               (GetBValue(a) * (100 - pct) + GetBValue(b) * pct) / 100);
+}
+
+static DWORD px(COLORREF c) { return (GetRValue(c) << 16) | (GetGValue(c) << 8) | GetBValue(c); }
+
+/* one line's glyphs into pixel rows y..y+rows-1 */
+static void mm_draw_line(EDITOR *e, size_t line, int y, int rows, COLORREF back, int x0)
+{
+    int w = e->mm_w, st = 0, col = 0, tabw = max(1, e->o.tab_width);
+    size_t start, n;
+    const WCHAR *t;
+    if (e->lang != LANG_TEXT && (!mm_compressed(e) || line <= e->hl_valid)) st = line_state(e, line);
+    start = tb_line_start(&e->tb, line);
+    n = tb_line_end(&e->tb, line) - start;
+    if (n > (size_t)w * 2) n = (size_t)w * 2;     /* no further than the strip shows */
+    t = tb_range(&e->tb, start, n);
+    if (!grow((void **)&e->mm_sty, &e->mm_stycap, n + 1, 1)) return;
+    if (e->lang == LANG_TEXT) memset(e->mm_sty, ST_DEFAULT, n);
+    else syn_line(e->lang, t, (int)n, st, e->mm_sty);
+    for (size_t i = 0; i < n && x0 + col < w; i++)
+    {
+        WCHAR c = t[i];
+        if (c == '\t') { col += tabw - col % tabw; continue; }
+        if (c != ' ' && c != 0xa0 && !is_lo(c))
+        {
+            DWORD v = px(mix(back, e->th.style[min(e->mm_sty[i], ST_COUNT - 1)], 75));
+            for (int r = 0; r < rows; r++) e->mm_px[(size_t)(y + r) * w + x0 + col] = v;
+        }
+        col++;
+    }
+}
+
+static void mm_paint(EDITOR *e, HDC hdc)
+{
+    int w = e->mm_w, h = e->chh, rh = mm_row(e), y, x0 = MulDiv(6, GetDeviceCaps(e->mdc, LOGPIXELSX), 96);
+    int band0, band1;
+    size_t vis = (size_t)visible_rows(e), line;
+    COLORREF bg = mix(e->th.bg, e->th.fg, 4), shade = mix(e->th.bg, e->th.fg, 14), edge = mix(e->th.bg, e->th.fg, 20);
+    BITMAPINFO bi;
+
+    if (w <= 0 || h <= 0) return;
+    if (!grow((void **)&e->mm_px, &e->mm_pxcap, (size_t)w * h, sizeof(DWORD))) return;
+    /* the band: the lines on screen, at least two pixels */
+    band0 = mm_y_of(e, e->top_line);
+    band1 = mm_y_of(e, min(e->top_line + vis, e->tb.nlines));
+    if (band1 < band0 + 2) band1 = band0 + 2;
+    for (y = 0; y < h; y++)
+    {
+        DWORD c = px(y >= band0 && y < band1 ? shade : bg), *row = e->mm_px + (size_t)y * w;
+        for (int x = 0; x < w; x++) row[x] = c;
+        row[0] = px(edge);
+    }
+    if (mm_compressed(e))
+        for (y = 0; y < h; y++)
+        {
+            if ((line = mm_line_at(e, y)) == NONE) break;
+            mm_draw_line(e, line, y, 1, y >= band0 && y < band1 ? shade : bg, x0);
+        }
+    else
+        for (line = 0, y = 0; line < e->tb.nlines && y + rh <= h; line++, y += rh)
+            mm_draw_line(e, line, y, rh - 1, y >= band0 && y < band1 ? shade : bg, x0);
+    memset(&bi, 0, sizeof(bi));
+    bi.bmiHeader.biSize = sizeof(bi.bmiHeader);
+    bi.bmiHeader.biWidth = w;
+    bi.bmiHeader.biHeight = -h;
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    SetDIBitsToDevice(hdc, e->cw, 0, w, h, 0, 0, 0, h, e->mm_px, &bi, DIB_RGB_COLORS);
+}
+
+static void update_caret(EDITOR *e);
+
+/* the editor centred on the strip's line at y */
+static void mm_scroll_to(EDITOR *e, int y)
+{
+    size_t line = mm_line_at(e, y), half = (size_t)visible_rows(e) / 2;
+    if (line == NONE) line = e->tb.nlines - 1;
+#ifdef SG_MUTANT_MMCLICK
+    return;
+#endif
+    e->top_line = line > half ? line - half : 0;
+    e->top_sub = 0;
+    clamp_top(e);
+    update_scrollbars(e);
+    update_caret(e);
+    InvalidateRect(e->hwnd, NULL, FALSE);
+}
+
+static void scroll_rows(EDITOR *e, int delta)
+{
+    while (delta > 0)
+    {
+        if (e->top_sub + 1 < line_rows(e, e->top_line)) e->top_sub++;
+        else if (e->top_line + 1 < e->tb.nlines) { e->top_line++; e->top_sub = 0; }
+        else break;
+        delta--;
+    }
+    while (delta < 0)
+    {
+        if (e->top_sub > 0) e->top_sub--;
+        else if (e->top_line > 0) { e->top_line--; e->top_sub = line_rows(e, e->top_line) - 1; }
+        else break;
+        delta++;
+    }
+    clamp_top(e);
+}
+
+/* where a position is on the screen: row offset from the top and x */
+static BOOL pos_to_view(EDITOR *e, size_t pos, int *row, int *x)
+{
+    size_t line = tb_line_of(&e->tb, pos), l;
+    int r, rows = 0, limit = visible_rows(e) + 2;
+
+    layout(e, line);
+    r = row_of(e, (int)(pos - tb_line_start(&e->tb, line)));
+    *x = row_x(e, (int)(pos - tb_line_start(&e->tb, line)));
+    if (line < e->top_line || (line == e->top_line && r < e->top_sub)) { *row = -1; return FALSE; }
+    if (line == e->top_line) { *row = r - e->top_sub; return TRUE; }
+    rows = line_rows(e, e->top_line) - e->top_sub;
+    for (l = e->top_line + 1; l < line && rows <= limit; l++) rows += line_rows(e, l);
+    if (rows > limit) { *row = limit + 1; return FALSE; }
+    *row = rows + r;
+    return TRUE;
+}
+
+static void update_caret(EDITOR *e)
+{
+    int row, x;
+    if (!e->focused) return;
+    if (pos_to_view(e, e->caret, &row, &x) && row < visible_rows(e) + 1)
+        SetCaretPos(text_left(e) + x - e->xoff, row * e->line_h);
+    else
+        SetCaretPos(-100, -100);
+    {
+        HIMC imc = ImmGetContext(e->hwnd);
+        if (imc)
+        {
+            COMPOSITIONFORM cf;
+            POINT pt;
+            GetCaretPos(&pt);
+            cf.dwStyle = CFS_POINT;
+            cf.ptCurrentPos = pt;
+            ImmSetCompositionWindow(imc, &cf);
+            ImmReleaseContext(e->hwnd, imc);
+        }
+    }
+}
+
+static void ensure_visible(EDITOR *e, size_t pos)
+{
+    int row, x, vis = visible_rows(e);
+    size_t line = tb_line_of(&e->tb, pos);
+
+    layout(e, line);
+    {
+        int r = row_of(e, (int)(pos - tb_line_start(&e->tb, line)));
+        x = row_x(e, (int)(pos - tb_line_start(&e->tb, line)));
+        if (!pos_to_view(e, pos, &row, &x) || row >= vis)
+        {
+            if (row < 0) { e->top_line = line; e->top_sub = r; }
+            else
+            {
+                /* put it on the last full row */
+                e->top_line = line;
+                e->top_sub = r;
+                scroll_rows(e, -(vis - 1));
+                if (row > vis + 1)
+                {
+                    /* far away: centre it instead */
+                    e->top_line = line; e->top_sub = r;
+                    scroll_rows(e, -(vis / 2));
+                }
+            }
+        }
+    }
+    if (!e->o.wrap)
+    {
+        int left = e->xoff, width = e->cw - text_left(e) - e->pad, margin = e->char_w * 4;
+        layout(e, line);
+        x = e->xs[pos - tb_line_start(&e->tb, line)];
+        if (x < left) e->xoff = max(0, x - margin);
+        else if (x > left + width - e->char_w) e->xoff = x - width + margin;
+    }
+    clamp_top(e);
+}
+
+/* ------------------------------------------------------------ bracket matching */
+
+static void find_brackets(EDITOR *e)
+{
+    static const WCHAR open[] = L"([{", close[] = L")]}";
+    size_t pos = NONE, limit = 400000, n = len(e), i;
+    const WCHAR *p;
+    int depth = 0;
+    WCHAR c = 0, want;
+
+    e->match_a = e->match_b = NONE;
+    if (!e->o.bracket_match || e->anchor != e->caret) return;
+    if (e->caret < n && wcschr(L"()[]{}", at(e, e->caret)) && at(e, e->caret)) pos = e->caret;
+    else if (e->caret > 0 && wcschr(L"()[]{}", at(e, e->caret - 1)) && at(e, e->caret - 1)) pos = e->caret - 1;
+    if (pos == NONE) return;
+    c = at(e, pos);
+    if ((p = wcschr(open, c)))
+    {
+        want = close[p - open];
+        for (i = pos; i < n && i - pos < limit; i++)
+        {
+            WCHAR d = at(e, i);
+            if (d == c) depth++;
+            else if (d == want && !--depth) { e->match_a = pos; e->match_b = i; return; }
+        }
+    }
+    else if ((p = wcschr(close, c)))
+    {
+        want = open[p - close];
+        for (i = pos + 1; i-- > 0 && pos - i < limit; )
+        {
+            WCHAR d = at(e, i);
+            if (d == c) depth++;
+            else if (d == want && !--depth) { e->match_a = i; e->match_b = pos; return; }
+        }
+    }
+    e->match_a = pos;   /* unmatched: marked alone */
+}
+
+/* ------------------------------------------------------------ selection */
+
+static void set_sel(EDITOR *e, size_t anchor, size_t caret, BOOL scroll)
+{
+    anchor = fix_pos(e, anchor);
+    caret = fix_pos(e, caret);
+    e->anchor = anchor;
+    e->caret = caret;
+    find_brackets(e);
+    if (scroll) ensure_visible(e, caret);
+    update_scrollbars(e);
+    InvalidateRect(e->hwnd, NULL, FALSE);
+    update_caret(e);
+    notify(e, EDN_SEL);
+}
+
+static void sel_range(EDITOR *e, size_t *a, size_t *b)
+{
+    *a = min(e->anchor, e->caret);
+    *b = max(e->anchor, e->caret);
+}
+
+/* ------------------------------------------------------------ undo */
+
+static void free_rec(UNDOREC *r)
+{
+    free(r->text);
+    r->text = NULL;
+}
+
+static void truncate_redo(EDITOR *e)
+{
+    size_t i;
+    for (i = e->undo_pos; i < e->nundo; i++) free_rec(&e->undo[i]);
+    e->nundo = e->undo_pos;
+    if (e->save_pos > (ptrdiff_t)e->undo_pos) e->save_pos = -1;
+}
+
+static void push_undo(EDITOR *e, BYTE type, size_t pos, const WCHAR *text, size_t n, int merge)
+{
+    UNDOREC *r;
+    WCHAR *copy;
+
+    truncate_redo(e);
+    /* grow the last record for runs of typing and deleting */
+    if (merge != M_NONE && merge == e->merge && e->nundo && e->group_depth == 0 &&
+        e->save_pos != (ptrdiff_t)e->nundo)
+    {
+        r = &e->undo[e->nundo - 1];
+        if (merge == M_TYPE && r->type == U_INS && r->pos + r->len == pos &&
+            !(n == 1 && (text[0] == ' ' || text[0] == '\t') && r->len && r->text[r->len - 1] != ' ' && r->text[r->len - 1] != '\t'))
+        {
+            if ((copy = realloc(r->text, (r->len + n) * sizeof(WCHAR))))
+            {
+                memcpy(copy + r->len, text, n * sizeof(WCHAR));
+                r->text = copy;
+                r->len += n;
+                return;
+            }
+        }
+        if (merge == M_BACK && r->type == U_DEL && pos + n == r->pos)
+        {
+            if ((copy = malloc((r->len + n) * sizeof(WCHAR))))
+            {
+                memcpy(copy, text, n * sizeof(WCHAR));
+                memcpy(copy + n, r->text, r->len * sizeof(WCHAR));
+                free(r->text);
+                r->text = copy;
+                r->pos = pos;
+                r->len += n;
+                return;
+            }
+        }
+        if (merge == M_FWD && r->type == U_DEL && pos == r->pos)
+        {
+            if ((copy = realloc(r->text, (r->len + n) * sizeof(WCHAR))))
+            {
+                memcpy(copy + r->len, text, n * sizeof(WCHAR));
+                r->text = copy;
+                r->len += n;
+                return;
+            }
+        }
+    }
+    if (!grow((void **)&e->undo, &e->capundo, e->nundo + 1, sizeof(UNDOREC))) return;
+    if (!(copy = malloc(max(n, 1) * sizeof(WCHAR)))) return;
+    memcpy(copy, text, n * sizeof(WCHAR));
+    r = &e->undo[e->nundo++];
+    r->type = type;
+    r->pos = pos;
+    r->len = n;
+    r->text = copy;
+    if (e->group_depth)
+    {
+        r->group = e->cur_group;
+        r->sel_anchor = e->group_anchor;
+        r->sel_caret = e->group_caret;
+    }
+    else
+    {
+        r->group = ++e->group_counter;
+        r->sel_anchor = e->anchor;
+        r->sel_caret = e->caret;
+    }
+    e->undo_pos = e->nundo;
+    e->merge = merge;
+}
+
+void ed_begin_group(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return;
+    if (!e->group_depth++)
+    {
+        e->cur_group = ++e->group_counter;
+        e->group_anchor = e->anchor;
+        e->group_caret = e->caret;
+        e->merge = M_NONE;
+    }
+}
+
+void ed_end_group(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    if (e && e->group_depth) e->group_depth--;
+}
+
+/* ------------------------------------------------------------ editing */
+
+static void after_edit(EDITOR *e, size_t pos)
+{
+    size_t line = tb_line_of(&e->tb, pos);
+    e->version++;
+    hl_invalidate(e, line);
+    update_gutter(e);
+}
+
+/* the primitive: replace [pos, pos+n) with text; records undo */
+static void replace_range(EDITOR *e, size_t pos, size_t n, const WCHAR *text, size_t tn, int merge)
+{
+    size_t total = len(e);
+    if (pos > total) pos = total;
+    if (n > total - pos) n = total - pos;
+    if (n)
+    {
+        WCHAR *old = malloc(n * sizeof(WCHAR));
+        if (!old) return;
+        tb_get(&e->tb, pos, n, old);
+        push_undo(e, U_DEL, pos, old, n, merge == M_TYPE ? M_NONE : merge);
+        free(old);
+        tb_delete(&e->tb, pos, n);
+    }
+    if (tn)
+    {
+        if (!tb_insert(&e->tb, pos, text, tn))
+        {
+            MessageBeep(MB_ICONHAND);
+            after_edit(e, pos);
+            return;
+        }
+        push_undo(e, U_INS, pos, text, tn, n ? M_NONE : merge);
+    }
+    after_edit(e, pos);
+}
+
+static void changed(EDITOR *e, size_t caret)
+{
+    e->want_x = -1;
+    set_sel(e, caret, caret, TRUE);
+    notify(e, EDN_CHANGE);
+}
+
+void ed_replace(HWND hwnd, size_t pos, size_t n, const WCHAR *text, size_t tn)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return;
+    replace_range(e, pos, n, text, tn, M_NONE);
+    e->anchor = fix_pos(e, e->anchor);
+    e->caret = fix_pos(e, e->caret);
+    InvalidateRect(hwnd, NULL, FALSE);
+    notify(e, EDN_CHANGE);
+}
+
+static void insert_at_sel(EDITOR *e, const WCHAR *text, size_t tn, int merge)
+{
+    size_t a, b;
+    sel_range(e, &a, &b);
+    replace_range(e, a, b - a, text, tn, (a == b) ? merge : M_NONE);
+    changed(e, a + tn);
+}
+
+void ed_replace_sel(HWND hwnd, const WCHAR *text, size_t n)
+{
+    EDITOR *e = get(hwnd);
+    if (e) insert_at_sel(e, text, n, M_NONE);
+}
+
+/* text with any line ends turned into the document's */
+static WCHAR *to_doc_eol(EDITOR *e, const WCHAR *s, size_t n, size_t *outn)
+{
+    const WCHAR *eol = eol_chars(e->eol);
+    size_t el = lstrlenW(eol), cnt = 0, i, k = 0;
+    WCHAR *out;
+    for (i = 0; i < n; i++) if (s[i] == '\n' || s[i] == '\r') cnt++;
+    if (!(out = malloc((n + cnt * el + 1) * sizeof(WCHAR)))) return NULL;
+    for (i = 0; i < n; i++)
+    {
+        if (s[i] == '\r' || s[i] == '\n')
+        {
+            if (s[i] == '\r' && i + 1 < n && s[i + 1] == '\n') i++;
+            memcpy(out + k, eol, el * sizeof(WCHAR));
+            k += el;
+        }
+        else out[k++] = s[i];
+    }
+    *outn = k;
+    return out;
+}
+
+static BOOL undo_step(EDITOR *e)
+{
+    int group;
+    size_t caret = 0, anchor = 0;
+    if (!e->undo_pos) return FALSE;
+    group = e->undo[e->undo_pos - 1].group;
+    while (e->undo_pos && e->undo[e->undo_pos - 1].group == group)
+    {
+        UNDOREC *r = &e->undo[--e->undo_pos];
+        if (r->type == U_INS) tb_delete(&e->tb, r->pos, r->len);
+        else tb_insert(&e->tb, r->pos, r->text, r->len);
+        after_edit(e, r->pos);
+        anchor = r->sel_anchor;
+        caret = r->sel_caret;
+    }
+    e->merge = M_NONE;
+    e->want_x = -1;
+    set_sel(e, anchor, caret, TRUE);
+    notify(e, EDN_CHANGE);
+    return TRUE;
+}
+
+static BOOL redo_step(EDITOR *e)
+{
+    int group;
+    size_t caret = 0;
+    if (e->undo_pos >= e->nundo) return FALSE;
+    group = e->undo[e->undo_pos].group;
+    while (e->undo_pos < e->nundo && e->undo[e->undo_pos].group == group)
+    {
+        UNDOREC *r = &e->undo[e->undo_pos++];
+        if (r->type == U_INS) { tb_insert(&e->tb, r->pos, r->text, r->len); caret = r->pos + r->len; }
+        else { tb_delete(&e->tb, r->pos, r->len); caret = r->pos; }
+        after_edit(e, r->pos);
+    }
+    e->merge = M_NONE;
+    changed(e, caret);
+    return TRUE;
+}
+
+/* ------------------------------------------------------------ clipboard */
+
+static void copy_sel(EDITOR *e)
+{
+    size_t a, b, n, i, k = 0, extra = 0;
+    WCHAR *text;
+    HGLOBAL mem;
+    WCHAR *out;
+
+    sel_range(e, &a, &b);
+    if (a == b) return;
+    n = b - a;
+    if (!(text = malloc(n * sizeof(WCHAR)))) return;
+    tb_get(&e->tb, a, n, text);
+    for (i = 0; i < n; i++) if (text[i] == '\n' || text[i] == '\r') extra++;
+    if (!(mem = GlobalAlloc(GMEM_MOVEABLE, (n + extra + 1) * sizeof(WCHAR)))) { free(text); return; }
+    out = GlobalLock(mem);
+    for (i = 0; i < n; i++)
+    {
+        if (text[i] == '\r' || text[i] == '\n')
+        {
+            if (text[i] == '\r' && i + 1 < n && text[i + 1] == '\n') i++;
+            out[k++] = '\r';
+            out[k++] = '\n';
+        }
+        else out[k++] = text[i];
+    }
+    out[k] = 0;
+    GlobalUnlock(mem);
+    free(text);
+    if (OpenClipboard(e->hwnd))
+    {
+        EmptyClipboard();
+        if (!SetClipboardData(CF_UNICODETEXT, mem)) GlobalFree(mem);
+        CloseClipboard();
+    }
+    else GlobalFree(mem);
+}
+
+static void paste(EDITOR *e)
+{
+    HGLOBAL mem;
+    const WCHAR *src;
+    if (!OpenClipboard(e->hwnd)) return;
+    if ((mem = GetClipboardData(CF_UNICODETEXT)) && (src = GlobalLock(mem)))
+    {
+        size_t n = wcslen(src), tn;
+        WCHAR *text = to_doc_eol(e, src, n, &tn);
+        GlobalUnlock(mem);
+        if (text)
+        {
+            e->merge = M_NONE;
+            insert_at_sel(e, text, tn, M_NONE);
+            free(text);
+        }
+    }
+    CloseClipboard();
+}
+
+/* ------------------------------------------------------------ line operations */
+
+static void sel_lines(EDITOR *e, size_t *first, size_t *last)
+{
+    size_t a, b;
+    sel_range(e, &a, &b);
+    *first = tb_line_of(&e->tb, a);
+    *last = tb_line_of(&e->tb, b);
+    if (*last > *first && b == tb_line_start(&e->tb, *last)) (*last)--;
+}
+
+static void indent_text(EDITOR *e, WCHAR *buf, int *n)
+{
+    if (e->o.use_spaces)
+    {
+        int k;
+        for (k = 0; k < e->o.tab_width; k++) buf[k] = ' ';
+        *n = e->o.tab_width;
+    }
+    else { buf[0] = '\t'; *n = 1; }
+}
+
+static void indent_lines(EDITOR *e, BOOL out)
+{
+    size_t first, last, l, a, b;
+    WCHAR ind[16];
+    int indn;
+    BOOL caret_first = e->caret < e->anchor;
+
+    sel_lines(e, &first, &last);
+    indent_text(e, ind, &indn);
+    ed_begin_group(e->hwnd);
+    a = tb_line_start(&e->tb, first);
+    for (l = first; l <= last; l++)
+    {
+        size_t s = tb_line_start(&e->tb, l), end = tb_line_end(&e->tb, l);
+        if (!out)
+        {
+            if (end > s || first == last) replace_range(e, s, 0, ind, indn, M_NONE);
+        }
+        else
+        {
+            size_t k = 0;
+            if (s < end && at(e, s) == '\t') k = 1;
+            else while (k < (size_t)e->o.tab_width && s + k < end && at(e, s + k) == ' ') k++;
+            if (k) replace_range(e, s, k, NULL, 0, M_NONE);
+        }
+    }
+    ed_end_group(e->hwnd);
+    b = tb_line_end(&e->tb, last);
+    e->want_x = -1;
+    if (caret_first) set_sel(e, b, a, TRUE);
+    else set_sel(e, a, b, TRUE);
+    notify(e, EDN_CHANGE);
+}
+
+static void toggle_comment(EDITOR *e)
+{
+    const WCHAR *lc = syn_line_comment(e->lang), *bo, *bc;
+    size_t first, last, l;
+    BOOL all = TRUE;
+
+    sel_lines(e, &first, &last);
+    if (!lc)
+    {
+        size_t a, b, bol, bcl;
+        if (!syn_block_comment(e->lang, &bo, &bc)) return;
+        bol = lstrlenW(bo); bcl = lstrlenW(bc);
+        a = tb_line_start(&e->tb, first);
+        b = tb_line_end(&e->tb, last);
+        ed_begin_group(e->hwnd);
+        if (b - a >= bol + bcl)
+        {
+            WCHAR *t = malloc((b - a) * sizeof(WCHAR));
+            if (t)
+            {
+                tb_get(&e->tb, a, b - a, t);
+                if (!wcsncmp(t, bo, bol) && !wcsncmp(t + (b - a) - bcl, bc, bcl))
+                {
+                    replace_range(e, b - bcl, bcl, NULL, 0, M_NONE);
+                    replace_range(e, a, bol, NULL, 0, M_NONE);
+                    free(t);
+                    ed_end_group(e->hwnd);
+                    changed(e, a);
+                    return;
+                }
+                free(t);
+            }
+        }
+        replace_range(e, b, 0, bc, bcl, M_NONE);
+        replace_range(e, a, 0, bo, bol, M_NONE);
+        ed_end_group(e->hwnd);
+        changed(e, a);
+        return;
+    }
+    for (l = first; l <= last && all; l++)
+    {
+        size_t s = tb_line_start(&e->tb, l), end = tb_line_end(&e->tb, l), k = s, i;
+        while (k < end && (at(e, k) == ' ' || at(e, k) == '\t')) k++;
+        if (k == end) continue;
+        for (i = 0; lc[i] && lc[i] != ' '; i++)
+            if (k + i >= end || towlower(at(e, k + i)) != towlower(lc[i])) { all = FALSE; break; }
+    }
+    ed_begin_group(e->hwnd);
+    for (l = first; l <= last; l++)
+    {
+        size_t s = tb_line_start(&e->tb, l), end = tb_line_end(&e->tb, l), k = s;
+        size_t cl = lstrlenW(lc);
+        while (k < end && (at(e, k) == ' ' || at(e, k) == '\t')) k++;
+        if (k == end && first != last) continue;
+        if (all)
+        {
+            size_t n = 0;
+            while (lc[n] && lc[n] != ' ') n++;
+            if (k + n < end && lc[n] == 0 && at(e, k + n) == ' ') n++;
+            else if (lc[n] == ' ' && k + n < end && at(e, k + n) == ' ') n++;
+            replace_range(e, k, n, NULL, 0, M_NONE);
+        }
+        else
+        {
+            WCHAR buf[16];
+            int n = 0;
+            for (n = 0; lc[n] && n < 14; n++) buf[n] = lc[n];
+            if (lc[n - 1] != ' ') buf[n++] = ' ';
+            replace_range(e, k, 0, buf, n, M_NONE);
+            (void)cl;
+        }
+    }
+    ed_end_group(e->hwnd);
+    e->want_x = -1;
+    set_sel(e, tb_line_start(&e->tb, first), tb_line_end(&e->tb, last), TRUE);
+    notify(e, EDN_CHANGE);
+}
+
+static void move_lines(EDITOR *e, BOOL down)
+{
+    size_t first, last, a, b, other_a, other_b, n, on;
+    WCHAR *block, *other;
+    const WCHAR *eol = eol_chars(e->eol);
+    ptrdiff_t off_anchor, off_caret;
+
+    sel_lines(e, &first, &last);
+    if (down ? last + 1 >= e->tb.nlines : first == 0) return;
+    a = tb_line_start(&e->tb, first);
+    b = tb_line_end(&e->tb, last);
+    off_anchor = e->anchor - a;
+    off_caret = e->caret - a;
+    n = b - a;
+    if (down) { other_a = tb_line_start(&e->tb, last + 1); other_b = tb_line_end(&e->tb, last + 1); }
+    else { other_a = tb_line_start(&e->tb, first - 1); other_b = tb_line_end(&e->tb, first - 1); }
+    on = other_b - other_a;
+    block = malloc((n + 1) * sizeof(WCHAR));
+    other = malloc((on + 1) * sizeof(WCHAR));
+    if (!block || !other) { free(block); free(other); return; }
+    tb_get(&e->tb, a, n, block);
+    tb_get(&e->tb, other_a, on, other);
+    ed_begin_group(e->hwnd);
+    if (down)
+    {
+        /* [block][eol][other] -> [other][eol][block] */
+        size_t mid = tb_line_next(&e->tb, last);   /* start of other */
+        replace_range(e, other_a, on, block, n, M_NONE);
+        replace_range(e, a, n, other, on, M_NONE);
+        a = a + on + (mid - b);
+        (void)eol;
+    }
+    else
+    {
+        size_t gap = a - other_b;
+        replace_range(e, a, n, other, on, M_NONE);
+        replace_range(e, other_a, on, block, n, M_NONE);
+        a = other_a;
+        (void)gap;
+    }
+    ed_end_group(e->hwnd);
+    free(block);
+    free(other);
+    e->want_x = -1;
+    set_sel(e, a + off_anchor, a + off_caret, TRUE);
+    notify(e, EDN_CHANGE);
+}
+
+static void duplicate(EDITOR *e)
+{
+    size_t a, b, n;
+    WCHAR *t;
+    sel_range(e, &a, &b);
+    if (a == b)
+    {
+        size_t line = tb_line_of(&e->tb, a), s = tb_line_start(&e->tb, line), end = tb_line_end(&e->tb, line);
+        const WCHAR *eol = eol_chars(e->eol);
+        size_t el = lstrlenW(eol);
+        n = end - s;
+        if (!(t = malloc((n + el) * sizeof(WCHAR)))) return;
+        memcpy(t, eol, el * sizeof(WCHAR));
+        tb_get(&e->tb, s, n, t + el);
+        replace_range(e, end, 0, t, n + el, M_NONE);
+        free(t);
+        changed(e, e->caret + (end - s) + el);
+        return;
+    }
+    n = b - a;
+    if (!(t = malloc(n * sizeof(WCHAR)))) return;
+    tb_get(&e->tb, a, n, t);
+    replace_range(e, b, 0, t, n, M_NONE);
+    free(t);
+    e->want_x = -1;
+    set_sel(e, b, b + n, TRUE);
+    notify(e, EDN_CHANGE);
+}
+
+static void delete_lines(EDITOR *e)
+{
+    size_t first, last, a, b;
+    sel_lines(e, &first, &last);
+    a = tb_line_start(&e->tb, first);
+    b = tb_line_next(&e->tb, last);
+    if (b == len(e) && first > 0) a = tb_line_end(&e->tb, first - 1);
+    replace_range(e, a, b - a, NULL, 0, M_NONE);
+    a = min(a, len(e));
+    changed(e, tb_line_start(&e->tb, tb_line_of(&e->tb, a)));
+}
+
+static void change_case(EDITOR *e, BOOL upper)
+{
+    size_t a, b, n;
+    WCHAR *t;
+    sel_range(e, &a, &b);
+    if (a == b) word_at(e, a, &a, &b);
+    if (a == b) return;
+    n = b - a;
+    if (!(t = malloc(n * sizeof(WCHAR)))) return;
+    tb_get(&e->tb, a, n, t);
+    if (upper) CharUpperBuffW(t, (DWORD)n);
+    else CharLowerBuffW(t, (DWORD)n);
+    replace_range(e, a, n, t, n, M_NONE);
+    free(t);
+    e->want_x = -1;
+    set_sel(e, a, b, TRUE);
+    notify(e, EDN_CHANGE);
+}
+
+static void trim_trailing(EDITOR *e)
+{
+    size_t l;
+    ed_begin_group(e->hwnd);
+    for (l = e->tb.nlines; l-- > 0; )
+    {
+        size_t s = tb_line_start(&e->tb, l), end = tb_line_end(&e->tb, l), k = end;
+        while (k > s && (at(e, k - 1) == ' ' || at(e, k - 1) == '\t')) k--;
+        if (k < end) replace_range(e, k, end - k, NULL, 0, M_NONE);
+    }
+    ed_end_group(e->hwnd);
+    changed(e, fix_pos(e, e->caret));
+}
+
+static void convert_indent(EDITOR *e, BOOL to_spaces)
+{
+    size_t l;
+    int tw = max(1, e->o.tab_width);
+    ed_begin_group(e->hwnd);
+    for (l = 0; l < e->tb.nlines; l++)
+    {
+        size_t s = tb_line_start(&e->tb, l), end = tb_line_end(&e->tb, l), k = s;
+        int col = 0;
+        WCHAR buf[512];
+        int bn = 0;
+        while (k < end && (at(e, k) == ' ' || at(e, k) == '\t'))
+        {
+            col = at(e, k) == '\t' ? (col / tw + 1) * tw : col + 1;
+            k++;
+        }
+        if (k == s || col > 500) continue;
+        if (to_spaces) { while (bn < col) buf[bn++] = ' '; }
+        else { while (col >= tw) { buf[bn++] = '\t'; col -= tw; } while (col--) buf[bn++] = ' '; }
+        if (k - s <= 512)
+        {
+            WCHAR cur[512];
+            tb_get(&e->tb, s, k - s, cur);
+            if ((size_t)bn != k - s || memcmp(cur, buf, bn * sizeof(WCHAR)))
+                replace_range(e, s, k - s, buf, bn, M_NONE);
+        }
+    }
+    ed_end_group(e->hwnd);
+    changed(e, fix_pos(e, e->caret));
+}
+
+void ed_set_eol(HWND hwnd, EOLTYPE eol)
+{
+    EDITOR *e = get(hwnd);
+    if (e) e->eol = eol;
+}
+
+/* ------------------------------------------------------------ typing */
+
+static void type_newline(EDITOR *e)
+{
+    size_t a, b, line, s, k;
+    WCHAR *buf;
+    const WCHAR *eol = eol_chars(e->eol);
+    size_t el = lstrlenW(eol), ind = 0, n = 0;
+    BOOL extra = FALSE;
+
+    sel_range(e, &a, &b);
+    line = tb_line_of(&e->tb, a);
+    s = tb_line_start(&e->tb, line);
+    if (e->o.auto_indent)
+    {
+        k = s;
+        while (k < a && (at(e, k) == ' ' || at(e, k) == '\t')) k++;
+        ind = k - s;
+        /* one level more after an opening bracket (or a Python colon) */
+        k = a;
+        while (k > s && (at(e, k - 1) == ' ' || at(e, k - 1) == '\t')) k--;
+        if (k > s && (at(e, k - 1) == '{' || at(e, k - 1) == '[' || at(e, k - 1) == '(' ||
+                      (e->lang == LANG_PYTHON && at(e, k - 1) == ':')))
+            extra = TRUE;
+    }
+    if (!(buf = malloc((el + ind + 16) * sizeof(WCHAR)))) return;
+    memcpy(buf, eol, el * sizeof(WCHAR));
+    n = el;
+    if (ind) { tb_get(&e->tb, s, ind, buf + n); n += ind; }
+    if (extra) { int k2; indent_text(e, buf + n, &k2); n += k2; }
+    e->merge = M_NONE;
+    insert_at_sel(e, buf, n, M_NONE);
+    free(buf);
+}
+
+static void type_char(EDITOR *e, WCHAR c)
+{
+    size_t a, b;
+    sel_range(e, &a, &b);
+    if (e->overwrite && a == b && a < tb_line_end(&e->tb, tb_line_of(&e->tb, a)))
+    {
+        size_t nxt = next_pos(e, a);
+        replace_range(e, a, nxt - a, &c, 1, M_NONE);
+        changed(e, a + 1);
+        return;
+    }
+    /* a closing brace on a line of only indentation: take one level back */
+    if (c == '}' && e->o.auto_indent && a == b && e->lang != LANG_TEXT)
+    {
+        size_t line = tb_line_of(&e->tb, a), s = tb_line_start(&e->tb, line), k = s;
+        while (k < a && (at(e, k) == ' ' || at(e, k) == '\t')) k++;
+        if (k == a && a > s)
+        {
+            size_t cut = (at(e, a - 1) == '\t') ? 1 : 0;
+            if (!cut) while (cut < (size_t)e->o.tab_width && a - cut > s && at(e, a - cut - 1) == ' ') cut++;
+            ed_begin_group(e->hwnd);
+            replace_range(e, a - cut, cut, &c, 1, M_NONE);
+            ed_end_group(e->hwnd);
+            changed(e, a - cut + 1);
+            return;
+        }
+    }
+    insert_at_sel(e, &c, 1, M_TYPE);
+}
+
+static void type_tab(EDITOR *e, BOOL shift)
+{
+    size_t a, b;
+    sel_range(e, &a, &b);
+    if (shift || (a != b && tb_line_of(&e->tb, a) != tb_line_of(&e->tb, b)))
+    {
+        indent_lines(e, shift);
+        return;
+    }
+    if (e->o.use_spaces)
+    {
+        WCHAR sp[16];
+        size_t line = tb_line_of(&e->tb, a), s = tb_line_start(&e->tb, line), k;
+        int col = 0, n, tw = max(1, e->o.tab_width);
+        for (k = s; k < a; k++) col = at(e, k) == '\t' ? (col / tw + 1) * tw : col + 1;
+        n = tw - col % tw;
+        for (k = 0; k < (size_t)n; k++) sp[k] = ' ';
+        insert_at_sel(e, sp, n, M_TYPE);
+    }
+    else insert_at_sel(e, L"\t", 1, M_TYPE);
+}
+
+static void backspace(EDITOR *e, BOOL word)
+{
+    size_t a, b, p;
+    sel_range(e, &a, &b);
+    if (a != b) { replace_range(e, a, b - a, NULL, 0, M_NONE); changed(e, a); return; }
+    if (!a) return;
+    if (word) p = word_left(e, a);
+    else
+    {
+        size_t line = tb_line_of(&e->tb, a), s = tb_line_start(&e->tb, line), k = s;
+        p = prev_pos(e, a);
+        /* in leading spaces, go back to the previous indent stop */
+        if (e->o.use_spaces && a > s)
+        {
+            while (k < a && at(e, k) == ' ') k++;
+            if (k == a && (a - s) % e->o.tab_width == 0 && a - s >= (size_t)e->o.tab_width) p = a - e->o.tab_width;
+        }
+        else if (a > s && is_lo(at(e, a - 1)) && a - 1 > s && is_hi(at(e, a - 2))) p = a - 2;
+        else if (a > s) p = a - 1;   /* delete one mark at a time, unlike moving */
+    }
+    replace_range(e, p, a - p, NULL, 0, M_BACK);
+    changed(e, p);
+}
+
+static void delete_fwd(EDITOR *e, BOOL word)
+{
+    size_t a, b, p;
+    sel_range(e, &a, &b);
+    if (a != b) { replace_range(e, a, b - a, NULL, 0, M_NONE); changed(e, a); return; }
+    if (a >= len(e)) return;
+    p = word ? word_right(e, a) : next_pos(e, a);
+    replace_range(e, a, p - a, NULL, 0, M_FWD);
+    changed(e, a);
+}
+
+/* ------------------------------------------------------------ hit testing */
+
+static size_t hit(EDITOR *e, int x, int y)
+{
+    size_t line = e->top_line;
+    int lh = max(1, e->line_h), sub = e->top_sub, r, i, rx;
+    int row = y >= 0 ? y / lh : -((-y + lh - 1) / lh);
+    size_t s;
+
+    while (row < 0)
+    {
+        if (sub > 0) sub--;
+        else if (line > 0) { line--; sub = line_rows(e, line) - 1; }
+        else { row = 0; break; }
+        row++;
+    }
+    for (;;)
+    {
+        int nr = line_rows(e, line);
+        if (row < nr - sub) { r = sub + row; break; }
+        row -= nr - sub;
+        sub = 0;
+        if (line + 1 >= e->tb.nlines) { r = nr - 1; break; }
+        line++;
+    }
+    layout(e, line);
+    s = tb_line_start(&e->tb, line);
+    rx = x - text_left(e) + e->xoff;
+    {
+        int from = e->rows[r], to = e->rows[r + 1], base = e->xs[from];
+        for (i = from; i < to; i++)
+        {
+            int mid = (e->xs[i] + e->xs[i + 1]) / 2 - base;
+            if (rx < mid) break;
+        }
+        if (i == to && r + 1 < e->lay_nrows && to > from) i = to - 1;
+        return fix_pos(e, s + i);
+    }
+}
+
+/* the position one visual row up or down from pos, at x */
+static size_t row_move(EDITOR *e, size_t pos, int dir, int x)
+{
+    size_t line = tb_line_of(&e->tb, pos), s;
+    int r, i;
+    layout(e, line);
+    r = row_of(e, (int)(pos - tb_line_start(&e->tb, line))) + dir;
+    if (r < 0)
+    {
+        if (!line) return 0;
+        line--;
+        r = line_rows(e, line) - 1;
+    }
+    else if (r >= e->lay_nrows)
+    {
+        if (line + 1 >= e->tb.nlines) return len(e);
+        line++;
+        r = 0;
+    }
+    layout(e, line);
+    s = tb_line_start(&e->tb, line);
+    {
+        int from = e->rows[r], to = e->rows[r + 1], base = e->xs[from];
+        for (i = from; i < to; i++)
+            if (x < (e->xs[i] + e->xs[i + 1]) / 2 - base) break;
+        if (i == to && r + 1 < e->lay_nrows && to > from) i = to - 1;
+    }
+    return fix_pos(e, s + i);
+}
+
+/* ------------------------------------------------------------ painting */
+
+static BOOL hl_word(WCHAR c)
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' ||
+           (c >= 0x80 && IsCharAlphaNumericW(c));
+}
+
+/* the find text's matches in the current layout's line, into hl_m */
+static void line_matches(EDITOR *e)
+{
+    const WCHAR *s = e->lay_s;
+    int n = e->lay_n, i;
+    size_t wl;
+    e->hl_n = 0;
+    if (!e->hl_text || !*e->hl_text || n > 100000) return;
+    if (e->hl_flags & FIND_REGEX)
+    {
+        size_t g[2 * 33], pos = 0;
+        if (!e->hl_re) return;
+        while (pos <= (size_t)n && re_search(e->hl_re, s, n, pos, FALSE, g))
+        {
+            if (g[1] > g[0] && grow((void **)&e->hl_m, &e->hl_mcap, (e->hl_n + 1) * 2, sizeof(size_t)))
+            {
+                e->hl_m[2 * e->hl_n] = g[0];
+                e->hl_m[2 * e->hl_n + 1] = g[1];
+                e->hl_n++;
+            }
+            pos = g[1] > g[0] ? g[1] : g[0] + 1;
+            if (e->hl_n > 2000) break;
+        }
+        return;
+    }
+    wl = wcslen(e->hl_text);
+    for (i = 0; i + (int)wl <= n; i++)
+    {
+        size_t k;
+        for (k = 0; k < wl; k++)
+        {
+            WCHAR a = s[i + k], b = e->hl_text[k];
+            if (a != b && ((e->hl_flags & FIND_CASE) || CharLowerW((WCHAR *)(ULONG_PTR)a) != CharLowerW((WCHAR *)(ULONG_PTR)b))) break;
+        }
+        if (k < wl) continue;
+        if ((e->hl_flags & FIND_WORD) && ((i > 0 && hl_word(s[i - 1]) && hl_word(s[i])) ||
+                                          (i + (int)wl < n && hl_word(s[i + wl]) && hl_word(s[i + wl - 1]))))
+            continue;
+        if (!grow((void **)&e->hl_m, &e->hl_mcap, (e->hl_n + 1) * 2, sizeof(size_t))) break;
+        e->hl_m[2 * e->hl_n] = i;
+        e->hl_m[2 * e->hl_n + 1] = i + wl;
+        e->hl_n++;
+        i += (int)wl - 1;
+        if (e->hl_n > 2000) break;
+    }
+}
+
+void ed_set_find_highlight(HWND hwnd, const WCHAR *text, UINT flags)
+{
+    EDITOR *e = get(hwnd);
+    const WCHAR *err;
+    if (!e) return;
+    if (!text && !e->hl_text) return;
+    if (text && e->hl_text && !wcscmp(text, e->hl_text) && flags == e->hl_flags) return;
+    free(e->hl_text);
+    re_free(e->hl_re);
+    e->hl_re = NULL;
+    e->hl_text = (text && *text) ? _wcsdup(text) : NULL;
+    e->hl_flags = flags;
+    if (e->hl_text && (flags & FIND_REGEX)) e->hl_re = re_compile(e->hl_text, !(flags & FIND_CASE), &err);
+    InvalidateRect(hwnd, NULL, FALSE);
+}
+
+static COLORREF style_color(EDITOR *e, BYTE st)
+{
+    return st < ST_COUNT ? e->th.style[st] : e->th.fg;
+}
+
+static void paint_row(EDITOR *e, HDC dc, size_t line, int r, int y, size_t sa, size_t sb, BOOL curline)
+{
+    size_t ls = tb_line_start(&e->tb, line);
+    int from = e->rows[r], to = e->rows[r + 1], base = e->xs[from], x0 = text_left(e) - e->xoff;
+    int i, ty = y + (e->line_h - e->text_h) / 2;
+    RECT rc, clip;
+    BOOL last_row = (r == e->lay_nrows - 1);
+    int *dx;
+
+    SetRect(&clip, e->gutter_w, y, e->cw, y + e->line_h);
+    if (curline)
+    {
+        HBRUSH br = CreateSolidBrush(e->th.curline);
+        SetRect(&rc, e->gutter_w, y, e->cw, y + e->line_h);
+        FillRect(dc, &rc, br);
+        DeleteObject(br);
+    }
+    /* the find text's other matches */
+    if (e->hl_n)
+    {
+        HBRUSH br = CreateSolidBrush(e->th.find_bg);
+        int k;
+        for (k = 0; k < e->hl_n; k++)
+        {
+            int ma = (int)e->hl_m[2 * k], mb = (int)e->hl_m[2 * k + 1];
+            if (mb <= from || ma >= to) continue;
+            ma = max(ma, from);
+            mb = min(mb, to);
+            SetRect(&rc, x0 + e->xs[ma] - base, y + 1, x0 + e->xs[mb] - base, y + e->line_h - 1);
+            FillRect(dc, &rc, br);
+        }
+        DeleteObject(br);
+    }
+    /* selection */
+    if (sa != sb)
+    {
+        size_t rs = ls + from, re = ls + to;
+        size_t a = max(sa, rs), b = min(sb, re);
+        int xa = -1, xb = -1;
+        if (a < b || (a == b && a >= rs && a <= re && sb > re && last_row))
+        {
+            xa = e->xs[a - ls] - base;
+            xb = e->xs[b - ls] - base;
+        }
+        if (last_row && sb > ls + e->lay_n && sa <= ls + e->lay_n)
+        {
+            if (xa < 0) xa = e->xs[max(sa, rs) - ls] - base;
+            xb = e->xs[e->lay_n] - base + e->space_w;
+        }
+        if (xa >= 0 && xb > xa)
+        {
+            HBRUSH br = CreateSolidBrush(e->focused ? e->th.sel_bg : e->th.sel_bg_inactive);
+            SetRect(&rc, max(e->gutter_w, x0 + xa), y, x0 + xb, y + e->line_h);
+            FillRect(dc, &rc, br);
+            DeleteObject(br);
+        }
+    }
+    /* matching brackets */
+    {
+        size_t m[2] = { e->match_a, e->match_b };
+        int k;
+        for (k = 0; k < 2; k++)
+        {
+            if (m[k] == NONE || m[k] < ls + from || m[k] >= ls + to) continue;
+            {
+                HBRUSH br = CreateSolidBrush(e->th.bracket_bg);
+                int xa = e->xs[m[k] - ls] - base, xb = e->xs[m[k] - ls + 1] - base;
+                SetRect(&rc, x0 + xa, y, x0 + xb, y + e->line_h);
+                FillRect(dc, &rc, br);
+                DeleteObject(br);
+            }
+        }
+    }
+
+    /* skip what is left of the view */
+    i = from;
+    if (e->xoff > 0)
+    {
+        int lo = from, hi = to;
+        while (lo < hi)
+        {
+            int mid = (lo + hi) / 2;
+            if (e->xs[mid + 1] - base < e->xoff) lo = mid + 1; else hi = mid;
+        }
+        i = lo;
+    }
+    if (!(dx = malloc(sizeof(int) * (to - from + 1)))) return;
+    while (i < to)
+    {
+        WCHAR c = e->lay_s[i];
+        int x = x0 + e->xs[i] - base, j, fk;
+        BYTE st = e->sty[i];
+        if (x > e->cw) break;
+        if (c == '\t' || c == ' ')
+        {
+            if (e->o.show_ws)
+            {
+                HPEN pen = CreatePen(PS_SOLID, 1, e->th.whitespace), old = SelectObject(dc, pen);
+                int w = e->xs[i + 1] - e->xs[i], cy = y + e->line_h / 2;
+                if (c == ' ')
+                {
+                    int cx = x + w / 2;
+                    RECT d;
+                    HBRUSH br = CreateSolidBrush(e->th.whitespace);
+                    SetRect(&d, cx - 1, cy - 1, cx + 1, cy + 1);
+                    FillRect(dc, &d, br);
+                    DeleteObject(br);
+                }
+                else
+                {
+                    MoveToEx(dc, x + 2, cy, NULL);
+                    LineTo(dc, x + w - 3, cy);
+                    MoveToEx(dc, x + w - 6, cy - 3, NULL);
+                    LineTo(dc, x + w - 3, cy);
+                    LineTo(dc, x + w - 7, cy + 4);
+                }
+                SelectObject(dc, old);
+                DeleteObject(pen);
+            }
+            i++;
+            continue;
+        }
+        if (c < 0x20 || c == 0x7f || (is_lo(c) && !(i > from && is_hi(e->lay_s[i - 1]))) ||
+            (is_hi(c) && !(i + 1 < to && is_lo(e->lay_s[i + 1]))))
+        {
+            WCHAR pic = c == 0x7f ? 0x2421 : c < 0x20 ? 0x2400 + c : 0xfffd;
+            int w = e->xs[i + 1] - e->xs[i];
+            SetTextColor(dc, e->th.style[ST_CONTROL]);
+            ExtTextOutW(dc, x, ty, ETO_CLIPPED, &clip, &pic, 1, &w);
+            i++;
+            continue;
+        }
+        fk = font_for(e, c);
+        for (j = i; j < to; j++)
+        {
+            WCHAR d = e->lay_s[j];
+            if (e->sty[j] != st || d == '\t' || d == ' ' || d < 0x20 || d == 0x7f) break;
+            if (j > i && !is_lo(d) && font_for(e, d) != fk) break;
+            if (is_lo(d) && !(j > i && is_hi(e->lay_s[j - 1]))) break;
+            if (is_hi(d) && !(j + 1 < to && is_lo(e->lay_s[j + 1]))) break;
+            dx[j - i] = e->xs[j + 1] - e->xs[j];
+            if (x + e->xs[j] - e->xs[i] > e->cw + 200 && !is_hi(d)) { j++; break; }
+        }
+        if (j == i) j = i + 1, dx[0] = e->xs[i + 1] - e->xs[i];
+        SetTextColor(dc, style_color(e, st));
+        if (fk) SelectObject(dc, font_n(e, fk));
+        ExtTextOutW(dc, x, ty, ETO_CLIPPED, &clip, e->lay_s + i, j - i, dx);
+        if (fk) SelectObject(dc, e->font);
+        i = j;
+    }
+    free(dx);
+}
+
+static void paint(EDITOR *e, HDC hdc)
+{
+    HDC dc;
+    HBITMAP bmp, oldbmp;
+    HBRUSH br;
+    RECT rc;
+    size_t line = e->top_line, sa, sb, caret_line = tb_line_of(&e->tb, e->caret);
+    int sub = e->top_sub, y = 0, digits_w;
+    HFONT oldfont;
+
+    if (e->cw <= 0 || e->chh <= 0) return;
+    dc = CreateCompatibleDC(hdc);
+    bmp = CreateCompatibleBitmap(hdc, e->cw, e->chh);
+    oldbmp = SelectObject(dc, bmp);
+    oldfont = SelectObject(dc, e->font);
+    SetBkMode(dc, TRANSPARENT);
+    SetRect(&rc, 0, 0, e->cw, e->chh);
+    br = CreateSolidBrush(e->th.bg);
+    FillRect(dc, &rc, br);
+    DeleteObject(br);
+    if (e->gutter_w)
+    {
+        br = CreateSolidBrush(e->th.gutter_bg);
+        SetRect(&rc, 0, 0, e->gutter_w, e->chh);
+        FillRect(dc, &rc, br);
+        DeleteObject(br);
+    }
+    sel_range(e, &sa, &sb);
+    digits_w = e->gutter_w - e->char_w;
+
+    while (y < e->chh && line < e->tb.nlines)
+    {
+        int r;
+        BOOL cur = (line == caret_line && sa == sb && e->o.cur_line);
+        layout(e, line);
+        line_styles(e, line);
+        layout(e, line);
+        line_matches(e);
+        for (r = sub; r < e->lay_nrows && y < e->chh; r++)
+        {
+            paint_row(e, dc, line, r, y, sa, sb, cur);
+            if (e->gutter_w && r == 0)
+            {
+                WCHAR num[24];
+                RECT nr;
+                wsprintfW(num, L"%lu", (unsigned long)(line + 1));
+                SetTextColor(dc, line == caret_line ? e->th.gutter_cur : e->th.gutter_fg);
+                SetRect(&nr, 0, y, digits_w, y + e->line_h);
+                DrawTextW(dc, num, -1, &nr, DT_RIGHT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
+            }
+            y += e->line_h;
+        }
+        sub = 0;
+        line++;
+    }
+    BitBlt(hdc, 0, 0, e->cw, e->chh, dc, 0, 0, SRCCOPY);
+    if (e->mm_w) mm_paint(e, hdc);
+    SelectObject(dc, oldfont);
+    SelectObject(dc, oldbmp);
+    DeleteObject(bmp);
+    DeleteDC(dc);
+}
+
+/* ------------------------------------------------------------ keyboard */
+
+static void move_to(EDITOR *e, size_t pos, BOOL shift, BOOL keep_x)
+{
+    if (!keep_x) e->want_x = -1;
+    e->merge = M_NONE;
+    set_sel(e, shift ? e->anchor : pos, pos, TRUE);
+}
+
+static int caret_x(EDITOR *e)
+{
+    size_t line = tb_line_of(&e->tb, e->caret);
+    layout(e, line);
+    return row_x(e, (int)(e->caret - tb_line_start(&e->tb, line)));
+}
+
+static BOOL keydown(EDITOR *e, WPARAM vk)
+{
+    BOOL shift = GetKeyState(VK_SHIFT) < 0, ctrl = GetKeyState(VK_CONTROL) < 0, alt = GetKeyState(VK_MENU) < 0;
+    size_t a, b, line;
+
+    sel_range(e, &a, &b);
+    line = tb_line_of(&e->tb, e->caret);
+    if (alt && !ctrl)
+    {
+        if (vk == VK_UP || vk == VK_DOWN) { move_lines(e, vk == VK_DOWN); return TRUE; }
+        return FALSE;
+    }
+    switch (vk)
+    {
+    case VK_LEFT:
+        if (a != b && !shift) move_to(e, a, FALSE, FALSE);
+        else move_to(e, ctrl ? word_left(e, e->caret) : prev_pos(e, e->caret), shift, FALSE);
+        return TRUE;
+    case VK_RIGHT:
+        if (a != b && !shift) move_to(e, b, FALSE, FALSE);
+        else move_to(e, ctrl ? word_right(e, e->caret) : next_pos(e, e->caret), shift, FALSE);
+        return TRUE;
+    case VK_UP:
+    case VK_DOWN:
+        if (ctrl)
+        {
+            if (shift) { move_lines(e, vk == VK_DOWN); return TRUE; }
+            scroll_rows(e, vk == VK_UP ? -1 : 1);
+            update_scrollbars(e);
+            InvalidateRect(e->hwnd, NULL, FALSE);
+            update_caret(e);
+            return TRUE;
+        }
+        if (e->want_x < 0) e->want_x = caret_x(e);
+        {
+            size_t p = row_move(e, e->caret, vk == VK_UP ? -1 : 1, e->want_x);
+            if (!shift && a != b) p = row_move(e, vk == VK_UP ? a : b, vk == VK_UP ? -1 : 1, e->want_x);
+            move_to(e, p, shift, TRUE);
+        }
+        return TRUE;
+    case VK_PRIOR:
+    case VK_NEXT:
+    {
+        int n = visible_rows(e) - 1, k;
+        size_t p = e->caret;
+        if (e->want_x < 0) e->want_x = caret_x(e);
+        for (k = 0; k < max(1, n); k++) p = row_move(e, p, vk == VK_PRIOR ? -1 : 1, e->want_x);
+        scroll_rows(e, vk == VK_PRIOR ? -n : n);
+        move_to(e, p, shift, TRUE);
+        return TRUE;
+    }
+    case VK_HOME:
+        if (ctrl) { move_to(e, 0, shift, FALSE); return TRUE; }
+        {
+            size_t s = tb_line_start(&e->tb, line), end = tb_line_end(&e->tb, line), k = s, rs;
+            layout(e, line);
+            rs = s + e->rows[row_of(e, (int)(e->caret - s))];
+            if (rs == s)
+            {
+                while (k < end && (at(e, k) == ' ' || at(e, k) == '\t')) k++;
+                move_to(e, e->caret == k ? s : k, shift, FALSE);
+            }
+            else move_to(e, e->caret == rs ? s : rs, shift, FALSE);
+        }
+        return TRUE;
+    case VK_END:
+        if (ctrl) { move_to(e, len(e), shift, FALSE); return TRUE; }
+        move_to(e, tb_line_end(&e->tb, line), shift, FALSE);
+        return TRUE;
+    case VK_BACK:
+        backspace(e, ctrl);
+        return TRUE;
+    case VK_DELETE:
+        if (shift && !ctrl) { copy_sel(e); if (a != b) { replace_range(e, a, b - a, NULL, 0, M_NONE); changed(e, a); } return TRUE; }
+        if (ctrl && shift) { delete_lines(e); return TRUE; }
+        delete_fwd(e, ctrl);
+        return TRUE;
+    case VK_RETURN:
+        if (ctrl) return FALSE;
+        type_newline(e);
+        return TRUE;
+    case VK_TAB:
+        if (ctrl) return FALSE;
+        type_tab(e, shift);
+        return TRUE;
+    case VK_INSERT:
+        if (!ctrl && !shift)
+        {
+            e->overwrite = !e->overwrite;
+            if (e->focused)
+            {
+                DestroyCaret();
+                CreateCaret(e->hwnd, NULL, e->overwrite ? e->char_w : max(2, e->line_h / 16), e->line_h);
+                update_caret(e);
+                ShowCaret(e->hwnd);
+            }
+            notify(e, EDN_OVERWRITE);
+            return TRUE;
+        }
+        return FALSE;
+    case VK_ESCAPE:
+        if (a != b) { move_to(e, e->caret, FALSE, FALSE); return TRUE; }
+        SendMessageW(GetParent(e->hwnd), WM_COMMAND, CMD_CLOSE_FIND, 0);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* ------------------------------------------------------------ mouse */
+
+static void drag_to(EDITOR *e, int x, int y)
+{
+    size_t p = hit(e, x, y);
+    if (e->drag_unit == 1)
+    {
+        size_t wa, wb;
+        word_at(e, p, &wa, &wb);
+        if (p < e->drag_a) set_sel(e, e->drag_b, wa, TRUE);
+        else set_sel(e, e->drag_a, max(wb, e->drag_b), TRUE);
+    }
+    else if (e->drag_unit == 2)
+    {
+        size_t l = tb_line_of(&e->tb, p), la = tb_line_start(&e->tb, l), lb = tb_line_next(&e->tb, l);
+        if (p < e->drag_a) set_sel(e, e->drag_b, la, TRUE);
+        else set_sel(e, e->drag_a, max(lb, e->drag_b), TRUE);
+    }
+    else set_sel(e, e->anchor, p, TRUE);
+}
+
+static void lbutton_down(EDITOR *e, int x, int y, WPARAM keys)
+{
+    DWORD now = GetMessageTime();
+    size_t p;
+
+    SetFocus(e->hwnd);
+    if (now - e->last_click <= GetDoubleClickTime() && abs(x - e->last_pt.x) <= GetSystemMetrics(SM_CXDOUBLECLK) &&
+        abs(y - e->last_pt.y) <= GetSystemMetrics(SM_CYDOUBLECLK))
+        e->click_count = e->click_count % 3 + 1;
+    else
+        e->click_count = 1;
+    e->last_click = now;
+    e->last_pt.x = x;
+    e->last_pt.y = y;
+    p = hit(e, x, y);
+    e->want_x = -1;
+    e->merge = M_NONE;
+    if (x < e->gutter_w || e->click_count == 3)
+    {
+        size_t l = tb_line_of(&e->tb, p);
+        e->drag_a = tb_line_start(&e->tb, l);
+        e->drag_b = tb_line_next(&e->tb, l);
+        e->drag_unit = 2;
+        if (keys & MK_SHIFT) set_sel(e, e->anchor, e->drag_b, TRUE);
+        else set_sel(e, e->drag_a, e->drag_b, TRUE);
+    }
+    else if (e->click_count == 2)
+    {
+        word_at(e, p, &e->drag_a, &e->drag_b);
+        e->drag_unit = 1;
+        set_sel(e, e->drag_a, e->drag_b, TRUE);
+    }
+    else
+    {
+        e->drag_unit = 0;
+        set_sel(e, (keys & MK_SHIFT) ? e->anchor : p, p, TRUE);
+    }
+    e->dragging = TRUE;
+    SetCapture(e->hwnd);
+}
+
+/* ------------------------------------------------------------ API */
+
+static void reset_undo(EDITOR *e)
+{
+    size_t i;
+    for (i = 0; i < e->nundo; i++) free_rec(&e->undo[i]);
+    e->nundo = e->undo_pos = 0;
+    e->save_pos = 0;
+    e->merge = M_NONE;
+}
+
+void ed_set_text(HWND hwnd, const WCHAR *text, size_t n)
+{
+    EDITOR *e = get(hwnd);
+    size_t l, longest = 0;
+    if (!e) return;
+    if (!tb_set(&e->tb, text, n)) { MessageBeep(MB_ICONHAND); tb_set(&e->tb, L"", 0); }
+    reset_undo(e);
+    e->anchor = e->caret = 0;
+    e->top_line = 0;
+    e->top_sub = 0;
+    e->xoff = 0;
+    e->hl_valid = 0;
+    e->want_x = -1;
+    e->version++;
+    for (l = 0; l < e->tb.nlines; l++)
+    {
+        size_t w = tb_line_end(&e->tb, l) - tb_line_start(&e->tb, l);
+        if (w > longest) longest = w;
+    }
+    e->max_width = (int)min((size_t)longest * e->char_w, 0x3fffffff);
+    update_gutter(e);
+    find_brackets(e);
+    clamp_top(e);
+    update_scrollbars(e);
+    InvalidateRect(hwnd, NULL, FALSE);
+    update_caret(e);
+    notify(e, EDN_CHANGE | EDN_SEL);
+}
+
+size_t ed_length(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    return e ? len(e) : 0;
+}
+
+const WCHAR *ed_text(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return L"";
+    e->lay_ver--;   /* the layout's text pointer is invalid after moving the gap */
+    return tb_contig(&e->tb);
+}
+
+void ed_get_range(HWND hwnd, size_t pos, size_t n, WCHAR *out)
+{
+    EDITOR *e = get(hwnd);
+    if (e) tb_get(&e->tb, pos, n, out);
+}
+
+void ed_get_sel(HWND hwnd, size_t *anchor, size_t *caret)
+{
+    EDITOR *e = get(hwnd);
+    *anchor = e ? e->anchor : 0;
+    *caret = e ? e->caret : 0;
+}
+
+void ed_set_sel(HWND hwnd, size_t anchor, size_t caret, BOOL scroll)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return;
+    e->want_x = -1;
+    e->merge = M_NONE;
+    set_sel(e, anchor, caret, scroll);
+}
+
+void ed_scroll_caret(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return;
+    ensure_visible(e, e->caret);
+    update_scrollbars(e);
+    InvalidateRect(hwnd, NULL, FALSE);
+    update_caret(e);
+}
+
+BOOL ed_undo(HWND hwnd) { EDITOR *e = get(hwnd); return e && undo_step(e); }
+BOOL ed_redo(HWND hwnd) { EDITOR *e = get(hwnd); return e && redo_step(e); }
+BOOL ed_can_undo(HWND hwnd) { EDITOR *e = get(hwnd); return e && e->undo_pos > 0; }
+BOOL ed_can_redo(HWND hwnd) { EDITOR *e = get(hwnd); return e && e->undo_pos < e->nundo; }
+
+BOOL ed_modified(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    return e && e->save_pos != (ptrdiff_t)e->undo_pos;
+}
+
+void ed_set_savepoint(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return;
+    e->save_pos = e->undo_pos;
+    e->merge = M_NONE;
+    notify(e, EDN_MODIFIED);
+}
+
+void ed_cut(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    size_t a, b;
+    if (!e) return;
+    sel_range(e, &a, &b);
+    if (a == b) return;
+    copy_sel(e);
+    replace_range(e, a, b - a, NULL, 0, M_NONE);
+    changed(e, a);
+}
+
+void ed_copy(HWND hwnd) { EDITOR *e = get(hwnd); if (e) copy_sel(e); }
+void ed_paste(HWND hwnd) { EDITOR *e = get(hwnd); if (e) paste(e); }
+
+void ed_delete(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    if (e) delete_fwd(e, FALSE);
+}
+
+void ed_select_all(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    if (e) set_sel(e, 0, len(e), FALSE);
+}
+
+static void relayout(EDITOR *e)
+{
+    e->version++;
+    update_gutter(e);
+    clamp_top(e);
+    ensure_visible(e, e->caret);
+    update_scrollbars(e);
+    InvalidateRect(e->hwnd, NULL, FALSE);
+    if (e->focused)
+    {
+        DestroyCaret();
+        CreateCaret(e->hwnd, NULL, e->overwrite ? e->char_w : max(2, e->line_h / 16), e->line_h);
+        update_caret(e);
+        ShowCaret(e->hwnd);
+    }
+}
+
+void ed_set_font(HWND hwnd, const LOGFONTW *lf)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return;
+    e->lf = *lf;
+    make_font(e);
+    relayout(e);
+}
+
+void ed_set_zoom(HWND hwnd, int percent)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return;
+    percent = max(10, min(500, percent));
+    if (percent == e->zoom) return;
+    e->zoom = percent;
+    make_font(e);
+    relayout(e);
+    notify(e, EDN_ZOOM);
+}
+
+int ed_get_zoom(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    return e ? e->zoom : 100;
+}
+
+void ed_set_opts(HWND hwnd, const EDOPTS *o)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return;
+    e->o = *o;
+    if (e->o.tab_width < 1 || e->o.tab_width > 16) e->o.tab_width = 4;
+    mm_update_width(e);
+    find_brackets(e);
+    relayout(e);
+}
+
+void ed_set_theme(HWND hwnd, const EDTHEME *th)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return;
+    e->th = *th;
+    InvalidateRect(hwnd, NULL, FALSE);
+}
+
+void ed_set_lang(HWND hwnd, int lang)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return;
+    e->lang = lang;
+    e->hl_valid = 0;
+    if (mm_update_width(e)) relayout(e);
+    else InvalidateRect(hwnd, NULL, FALSE);
+}
+
+BOOL ed_minimap_shown(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    return e && e->mm_w > 0;
+}
+
+int ed_get_lang(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    return e ? e->lang : LANG_TEXT;
+}
+
+void ed_linecol(HWND hwnd, size_t *line, size_t *col)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) { *line = *col = 0; return; }
+    *line = tb_line_of(&e->tb, e->caret);
+    *col = e->caret - tb_line_start(&e->tb, *line);
+}
+
+size_t ed_line_count(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    return e ? e->tb.nlines : 0;
+}
+
+void ed_goto_line(HWND hwnd, size_t line)
+{
+    EDITOR *e = get(hwnd);
+    size_t p;
+    if (!e) return;
+    if (line >= e->tb.nlines) line = e->tb.nlines - 1;
+    p = tb_line_start(&e->tb, line);
+    e->want_x = -1;
+    e->top_line = line;
+    e->top_sub = 0;
+    scroll_rows(e, -(visible_rows(e) / 3));
+    set_sel(e, p, p, TRUE);
+}
+
+BOOL ed_overwrite(HWND hwnd)
+{
+    EDITOR *e = get(hwnd);
+    return e && e->overwrite;
+}
+
+void ed_command(HWND hwnd, UINT cmd)
+{
+    EDITOR *e = get(hwnd);
+    if (!e) return;
+    e->merge = M_NONE;
+    switch (cmd)
+    {
+    case CMD_DUPLICATE_LINE: duplicate(e); break;
+    case CMD_DELETE_LINE:    delete_lines(e); break;
+    case CMD_MOVE_LINE_UP:   move_lines(e, FALSE); break;
+    case CMD_MOVE_LINE_DOWN: move_lines(e, TRUE); break;
+    case CMD_TOGGLE_COMMENT: toggle_comment(e); break;
+    case CMD_UPPERCASE:      change_case(e, TRUE); break;
+    case CMD_LOWERCASE:      change_case(e, FALSE); break;
+    case CMD_INDENT:         indent_lines(e, FALSE); break;
+    case CMD_UNINDENT:       indent_lines(e, TRUE); break;
+    case CMD_TRIM_TRAILING:  trim_trailing(e); break;
+    case CMD_TABS_TO_SPACES: convert_indent(e, TRUE); break;
+    case CMD_SPACES_TO_TABS: convert_indent(e, FALSE); break;
+    case CMD_SELECT_LINE:
+    {
+        size_t first, last;
+        sel_lines(e, &first, &last);
+        set_sel(e, tb_line_start(&e->tb, first), tb_line_next(&e->tb, last), TRUE);
+        break;
+    }
+    case CMD_GOTO_BRACKET:
+        if (e->match_b != NONE)
+            move_to(e, e->caret == e->match_a || e->caret == e->match_a + 1 ? e->match_b : e->match_a, FALSE, FALSE);
+        break;
+    }
+}
+
+/* ------------------------------------------------------------ window procedure */
+
+static LRESULT get_text(EDITOR *e, WPARAM count, WCHAR *out)
+{
+    size_t n = len(e);
+    if (!count || !out) return 0;
+    n = min(n, count - 1);
+    tb_get(&e->tb, 0, n, out);
+    out[n] = 0;
+    return n;
+}
+
+static LRESULT CALLBACK editor_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    EDITOR *e = get(hwnd);
+
+    if (!e && msg != WM_NCCREATE) return DefWindowProcW(hwnd, msg, wp, lp);
+    switch (msg)
+    {
+    case WM_NCCREATE:
+    {
+        NONCLIENTMETRICSW ncm;
+        if (!(e = calloc(1, sizeof(*e)))) return FALSE;
+        if (!(e->wcache = malloc(65536 * sizeof(int)))) { free(e); return FALSE; }
+        if (!(e->fontmap = malloc(65536))) { free(e->wcache); free(e); return FALSE; }
+        e->hwnd = hwnd;
+        tb_init(&e->tb);
+        e->zoom = 100;
+        e->mdc = CreateCompatibleDC(NULL);
+        e->want_x = -1;
+        e->anchor = e->caret = 0;
+        e->match_a = e->match_b = NONE;
+        e->lay_line = NONE;
+        e->o.tab_width = 4;
+        e->o.cur_line = TRUE;
+        e->o.auto_indent = TRUE;
+        e->o.bracket_match = TRUE;
+        e->th.bg = RGB(255, 255, 255);
+        e->th.fg = RGB(0, 0, 0);
+        e->th.sel_bg = RGB(200, 180, 235);
+        e->th.sel_bg_inactive = RGB(225, 225, 225);
+        ncm.cbSize = sizeof(ncm);
+        SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0);
+        e->lf = ncm.lfMessageFont;
+        SetWindowLongPtrW(hwnd, 0, (LONG_PTR)e);
+        make_font(e);
+        return DefWindowProcW(hwnd, msg, wp, lp);
+    }
+    case WM_NCDESTROY:
+        reset_undo(e);
+        free(e->undo);
+        tb_free(&e->tb);
+        free_font(e);
+        DeleteDC(e->mdc);
+        free(e->wcache);
+        free(e->fontmap);
+        free(e->lstate);
+        free(e->xs);
+        free(e->rows);
+        free(e->sty);
+        free(e->mm_sty);
+        free(e->mm_px);
+        free(e->hl_text);
+        free(e->hl_m);
+        re_free(e->hl_re);
+        free(e);
+        SetWindowLongPtrW(hwnd, 0, 0);
+        return 0;
+
+    case WM_SIZE:
+    {
+        int w = LOWORD(lp), h = HIWORD(lp);
+        e->full_w = w;
+        e->chh = h;
+        if (!mm_update_width(e) && e->o.wrap) e->version++;
+        if (e->tb.nlines)
+        {
+            clamp_top(e);
+            update_scrollbars(e);
+            update_caret(e);
+        }
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    }
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint(hwnd, &ps);
+        paint(e, hdc);
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+    case WM_SETFOCUS:
+        e->focused = TRUE;
+        CreateCaret(hwnd, NULL, e->overwrite ? e->char_w : max(2, e->line_h / 16), e->line_h);
+        update_caret(e);
+        ShowCaret(hwnd);
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_KILLFOCUS:
+        e->focused = FALSE;
+        DestroyCaret();
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_GETDLGCODE:
+        return DLGC_WANTALLKEYS | DLGC_WANTARROWS | DLGC_WANTCHARS | DLGC_WANTTAB;
+
+    case WM_KEYDOWN:
+        if (keydown(e, wp)) return 0;
+        break;
+    case WM_SYSKEYDOWN:
+        if (keydown(e, wp)) return 0;
+        break;
+    case WM_CHAR:
+        if (wp >= 0x20 && wp != 0x7f)
+        {
+            if (GetKeyState(VK_CONTROL) < 0 && GetKeyState(VK_MENU) >= 0 && wp < 0x80) return 0;
+            type_char(e, (WCHAR)wp);
+        }
+        return 0;
+    case WM_IME_STARTCOMPOSITION:
+    {
+        HIMC imc = ImmGetContext(hwnd);
+        if (imc)
+        {
+            LOGFONTW lf;
+            GetObjectW(e->font, sizeof(lf), &lf);
+            ImmSetCompositionFontW(imc, &lf);
+            ImmReleaseContext(hwnd, imc);
+        }
+        update_caret(e);
+        break;
+    }
+
+    case WM_LBUTTONDOWN:
+        if (e->mm_w && (short)LOWORD(lp) >= e->cw)
+        {
+            SetFocus(hwnd);
+            e->mm_drag = TRUE;
+            SetCapture(hwnd);
+            mm_scroll_to(e, (short)HIWORD(lp));
+            return 0;
+        }
+        lbutton_down(e, (short)LOWORD(lp), (short)HIWORD(lp), wp);
+        return 0;
+    case WM_SETCURSOR:
+        if (LOWORD(lp) == HTCLIENT && e->mm_w)
+        {
+            POINT pt;
+            GetCursorPos(&pt);
+            ScreenToClient(hwnd, &pt);
+            if (pt.x >= e->cw) { SetCursor(LoadCursorW(NULL, (LPCWSTR)IDC_ARROW)); return TRUE; }
+        }
+        break;
+    case WM_LBUTTONDBLCLK:
+        if (e->mm_w && (short)LOWORD(lp) >= e->cw) return 0;
+        lbutton_down(e, (short)LOWORD(lp), (short)HIWORD(lp), wp);
+        return 0;
+    case WM_MOUSEMOVE:
+        if (e->mm_drag)
+        {
+            mm_scroll_to(e, (short)HIWORD(lp));
+            return 0;
+        }
+        if (e->dragging)
+        {
+            int x = (short)LOWORD(lp), y = (short)HIWORD(lp);
+            drag_to(e, x, y);
+            if (y < 0 || y > e->chh || x < 0 || x > e->cw) SetTimer(hwnd, 1, 50, NULL);
+            else KillTimer(hwnd, 1);
+        }
+        return 0;
+    case WM_TIMER:
+        if (wp == 1 && e->dragging)
+        {
+            POINT pt;
+            GetCursorPos(&pt);
+            ScreenToClient(hwnd, &pt);
+            if (pt.y < 0) scroll_rows(e, -1);
+            else if (pt.y > e->chh) scroll_rows(e, 1);
+            if (!e->o.wrap)
+            {
+                if (pt.x < e->gutter_w) e->xoff = max(0, e->xoff - e->char_w * 2);
+                else if (pt.x > e->cw) e->xoff += e->char_w * 2;
+            }
+            drag_to(e, pt.x, pt.y);
+        }
+        return 0;
+    case WM_LBUTTONUP:
+        if (e->mm_drag) { e->mm_drag = FALSE; ReleaseCapture(); return 0; }
+        if (e->dragging)
+        {
+            e->dragging = FALSE;
+            KillTimer(hwnd, 1);
+            ReleaseCapture();
+        }
+        return 0;
+    case WM_CAPTURECHANGED:
+        e->mm_drag = FALSE;
+        e->dragging = FALSE;
+        KillTimer(hwnd, 1);
+        return 0;
+    case WM_RBUTTONDOWN:
+    {
+        size_t a, b, p = hit(e, (short)LOWORD(lp), (short)HIWORD(lp));
+        SetFocus(hwnd);
+        sel_range(e, &a, &b);
+        if (p < a || p > b) set_sel(e, p, p, FALSE);
+        return 0;
+    }
+    case WM_CONTEXTMENU:
+    {
+        HMENU menu = CreatePopupMenu();
+        POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
+        size_t a, b;
+        WCHAR s[64];
+        const WCHAR *bo, *bc;
+        HINSTANCE inst = (HINSTANCE)GetWindowLongPtrW(hwnd, GWLP_HINSTANCE);
+        UINT ids[] = { CMD_UNDO, CMD_REDO, 0, CMD_CUT, CMD_COPY, CMD_PASTE, CMD_DELETE, 0, CMD_SELECT_ALL,
+                       0, CMD_TOGGLE_COMMENT, CMD_DUPLICATE_LINE };
+        UINT i;
+        sel_range(e, &a, &b);
+        for (i = 0; i < ARRAY_SIZE(ids); i++)
+        {
+            UINT flags = MF_STRING;
+            if (!ids[i]) { AppendMenuW(menu, MF_SEPARATOR, 0, NULL); continue; }
+            if (!LoadStringW(inst, STRING_MENU_BASE + ids[i], s, ARRAY_SIZE(s))) continue;
+            if ((ids[i] == CMD_UNDO && !e->undo_pos) || (ids[i] == CMD_REDO && e->undo_pos >= e->nundo) ||
+                ((ids[i] == CMD_CUT || ids[i] == CMD_COPY || ids[i] == CMD_DELETE) && a == b) ||
+                (ids[i] == CMD_PASTE && !IsClipboardFormatAvailable(CF_UNICODETEXT)) ||
+                (ids[i] == CMD_TOGGLE_COMMENT && !syn_line_comment(e->lang) && !syn_block_comment(e->lang, &bo, &bc)))
+                flags |= MF_GRAYED;
+            AppendMenuW(menu, flags, ids[i], s);
+        }
+        if (pt.x == -1 && pt.y == -1)
+        {
+            GetCaretPos(&pt);
+            ClientToScreen(hwnd, &pt);
+        }
+        i = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_RIGHTBUTTON, pt.x, pt.y, 0, hwnd, NULL);
+        DestroyMenu(menu);
+        if (i) SendMessageW(GetParent(hwnd), WM_COMMAND, i, 0);
+        return 0;
+    }
+    case WM_MOUSEWHEEL:
+    case WM_MOUSEHWHEEL:
+    {
+        int delta = (short)HIWORD(wp);
+        if (msg == WM_MOUSEWHEEL && (LOWORD(wp) & MK_CONTROL))
+        {
+            e->wheel_acc += delta;
+            while (e->wheel_acc >= WHEEL_DELTA) { ed_set_zoom(hwnd, e->zoom + 10); e->wheel_acc -= WHEEL_DELTA; }
+            while (e->wheel_acc <= -WHEEL_DELTA) { ed_set_zoom(hwnd, e->zoom - 10); e->wheel_acc += WHEEL_DELTA; }
+            return 0;
+        }
+        if (msg == WM_MOUSEHWHEEL || (LOWORD(wp) & MK_SHIFT))
+        {
+            if (!e->o.wrap)
+            {
+                e->xoff += (msg == WM_MOUSEHWHEEL ? delta : -delta) * e->char_w * 6 / WHEEL_DELTA;
+                clamp_top(e);
+            }
+        }
+        else
+        {
+            UINT lines = 3;
+            SystemParametersInfoW(SPI_GETWHEELSCROLLLINES, 0, &lines, 0);
+            if (lines == WHEEL_PAGESCROLL) lines = visible_rows(e);
+            e->wheel_acc += delta;
+            while (e->wheel_acc >= WHEEL_DELTA) { scroll_rows(e, -(int)lines); e->wheel_acc -= WHEEL_DELTA; }
+            while (e->wheel_acc <= -WHEEL_DELTA) { scroll_rows(e, lines); e->wheel_acc += WHEEL_DELTA; }
+        }
+        update_scrollbars(e);
+        InvalidateRect(hwnd, NULL, FALSE);
+        update_caret(e);
+        return 0;
+    }
+    case WM_VSCROLL:
+    {
+        SCROLLINFO si;
+        si.cbSize = sizeof(si);
+        si.fMask = SIF_TRACKPOS;
+        GetScrollInfo(hwnd, SB_VERT, &si);
+        switch (LOWORD(wp))
+        {
+        case SB_LINEUP: scroll_rows(e, -1); break;
+        case SB_LINEDOWN: scroll_rows(e, 1); break;
+        case SB_PAGEUP: scroll_rows(e, -(visible_rows(e) - 1)); break;
+        case SB_PAGEDOWN: scroll_rows(e, visible_rows(e) - 1); break;
+        case SB_TOP: e->top_line = 0; e->top_sub = 0; break;
+        case SB_BOTTOM: e->top_line = e->tb.nlines - 1; e->top_sub = 0; clamp_top(e); break;
+        case SB_THUMBTRACK:
+        case SB_THUMBPOSITION:
+            e->top_line = min((size_t)si.nTrackPos, e->tb.nlines - 1);
+            e->top_sub = 0;
+            clamp_top(e);
+            break;
+        }
+        update_scrollbars(e);
+        InvalidateRect(hwnd, NULL, FALSE);
+        update_caret(e);
+        return 0;
+    }
+    case WM_HSCROLL:
+    {
+        SCROLLINFO si;
+        int page = e->cw - text_left(e);
+        si.cbSize = sizeof(si);
+        si.fMask = SIF_TRACKPOS;
+        GetScrollInfo(hwnd, SB_HORZ, &si);
+        switch (LOWORD(wp))
+        {
+        case SB_LINELEFT: e->xoff -= e->char_w * 2; break;
+        case SB_LINERIGHT: e->xoff += e->char_w * 2; break;
+        case SB_PAGELEFT: e->xoff -= page; break;
+        case SB_PAGERIGHT: e->xoff += page; break;
+        case SB_LEFT: e->xoff = 0; break;
+        case SB_THUMBTRACK:
+        case SB_THUMBPOSITION: e->xoff = si.nTrackPos; break;
+        }
+        clamp_top(e);
+        update_scrollbars(e);
+        InvalidateRect(hwnd, NULL, FALSE);
+        update_caret(e);
+        return 0;
+    }
+
+    /* ---- the EDIT control's messages, for programs that drive Notepad ---- */
+    case WM_GETTEXTLENGTH:
+        return (LRESULT)min(len(e), 0x7fffffff);
+    case WM_GETTEXT:
+        return get_text(e, wp, (WCHAR *)lp);
+    case WM_SETTEXT:
+    {
+        const WCHAR *t = (const WCHAR *)lp;
+        size_t n = t ? wcslen(t) : 0;
+        ed_begin_group(hwnd);
+        replace_range(e, 0, len(e), t, n, M_NONE);
+        ed_end_group(hwnd);
+        changed(e, 0);
+        return TRUE;
+    }
+    case WM_CUT: ed_cut(hwnd); return 0;
+    case WM_COPY: copy_sel(e); return 0;
+    case WM_PASTE: paste(e); return 0;
+    case WM_CLEAR:
+    {
+        size_t a, b;
+        sel_range(e, &a, &b);
+        if (a != b) { replace_range(e, a, b - a, NULL, 0, M_NONE); changed(e, a); }
+        return 0;
+    }
+    case WM_UNDO:
+    case EM_UNDO:
+        return undo_step(e);
+    case EM_CANUNDO:
+        return e->undo_pos > 0;
+    case EM_EMPTYUNDOBUFFER:
+        reset_undo(e);
+        return 0;
+    case EM_GETMODIFY:
+        return ed_modified(hwnd);
+    case EM_SETMODIFY:
+        if (wp) e->save_pos = -1; else e->save_pos = e->undo_pos;
+        notify(e, EDN_MODIFIED);
+        return 0;
+    case EM_GETSEL:
+    {
+        size_t a, b;
+        sel_range(e, &a, &b);
+        if (wp) *(DWORD *)wp = (DWORD)a;
+        if (lp) *(DWORD *)lp = (DWORD)b;
+        return MAKELONG(min(a, 0xffff), min(b, 0xffff));
+    }
+    case EM_SETSEL:
+    {
+        size_t a = (INT)wp < 0 ? e->caret : (size_t)(DWORD)wp, b = (INT)lp < 0 ? len(e) : (size_t)(DWORD)lp;
+        if ((INT)wp == -1) { set_sel(e, e->caret, e->caret, FALSE); return 0; }
+        ed_set_sel(hwnd, min(a, len(e)), min(b, len(e)), FALSE);
+        return 0;
+    }
+    case EM_REPLACESEL:
+    {
+        const WCHAR *t = (const WCHAR *)lp;
+        if (t) insert_at_sel(e, t, wcslen(t), M_NONE);
+        return 0;
+    }
+    case EM_SCROLLCARET:
+        ed_scroll_caret(hwnd);
+        return 0;
+    case EM_GETLINECOUNT:
+        return (LRESULT)e->tb.nlines;
+    case EM_LINEINDEX:
+        if ((INT)wp < 0) return (LRESULT)tb_line_start(&e->tb, tb_line_of(&e->tb, e->caret));
+        return (size_t)wp < e->tb.nlines ? (LRESULT)tb_line_start(&e->tb, wp) : -1;
+    case EM_LINEFROMCHAR:
+        if ((INT)wp < 0) return (LRESULT)tb_line_of(&e->tb, e->caret);
+        return (LRESULT)tb_line_of(&e->tb, min((size_t)wp, len(e)));
+    case EM_LINELENGTH:
+    {
+        size_t l = (INT)wp < 0 ? tb_line_of(&e->tb, e->caret) : tb_line_of(&e->tb, min((size_t)wp, len(e)));
+        return (LRESULT)(tb_line_end(&e->tb, l) - tb_line_start(&e->tb, l));
+    }
+    case EM_GETLINE:
+    {
+        size_t l = wp, s, n, cap;
+        WCHAR *out = (WCHAR *)lp;
+        if (!out || l >= e->tb.nlines) return 0;
+        cap = *(WORD *)out;
+        s = tb_line_start(&e->tb, l);
+        n = min(tb_line_end(&e->tb, l) - s, cap);
+        tb_get(&e->tb, s, n, out);
+        return (LRESULT)n;
+    }
+    case EM_GETFIRSTVISIBLELINE:
+        return (LRESULT)e->top_line;
+    case EM_LINESCROLL:
+        scroll_rows(e, (int)lp);
+        update_scrollbars(e);
+        InvalidateRect(hwnd, NULL, FALSE);
+        update_caret(e);
+        return TRUE;
+    case EM_SETREADONLY:
+        return TRUE;
+
+    /* ---- ours ---- */
+    case SGE_GETSTYLEAT:
+    {
+        size_t pos = wp, line;
+        if (pos >= len(e)) return -1;
+        line = tb_line_of(&e->tb, pos);
+        layout(e, line);
+        line_styles(e, line);
+        return e->sty[pos - tb_line_start(&e->tb, line)];
+    }
+    case SGE_GETLANG:
+        return e->lang;
+    case SGE_GETZOOM:
+        return e->zoom;
+    case SGE_POSFROMCHAR:
+    {
+        int row, x;
+        if (!pos_to_view(e, min((size_t)wp, len(e)), &row, &x)) return -1;
+        return MAKELONG(text_left(e) + x - e->xoff, row * e->line_h);
+    }
+    case SGE_GETTOPLINE:
+        return e->top_line;
+    case SGE_GETMINIMAP:
+        return e->mm_w ? MAKELONG(e->cw, mm_compressed(e) ? 0 : mm_row(e)) : 0;
+    case SGE_GETMMLINE:
+        return mm_line_at(e, (int)wp);
+    case SGE_GETVISROWS:
+        return visible_rows(e);
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+BOOL editor_register(HINSTANCE inst)
+{
+    WNDCLASSEXW wc;
+    memset(&wc, 0, sizeof(wc));
+    wc.cbSize = sizeof(wc);
+    wc.style = CS_DBLCLKS;
+    wc.lpfnWndProc = editor_proc;
+    wc.cbWndExtra = sizeof(void *);
+    wc.hInstance = inst;
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_IBEAM);
+    wc.lpszClassName = EDITOR_CLASS;
+    return RegisterClassExW(&wc) != 0;
+}
+
+HWND editor_create(HWND parent, HINSTANCE inst)
+{
+    return CreateWindowExW(0, EDITOR_CLASS, NULL, WS_CHILD | WS_VSCROLL | WS_HSCROLL | WS_CLIPSIBLINGS,
+                           0, 0, 100, 100, parent, NULL, inst, NULL);
+}
diff --git a/programs/notepad/fileio.c b/programs/notepad/fileio.c
new file mode 100644
index 0000000..2f1ed84
--- /dev/null
+++ b/programs/notepad/fileio.c
@@ -0,0 +1,281 @@
+/*
+ * Notepad -- reading and writing files: encodings and line ends
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* A file is read whole and decoded once; its line ends stay in the text as
+ * they were (see textbuf.c), so saving with the same encoding writes back the
+ * same bytes.  Detection: a BOM decides; then UTF-16 without a BOM by its
+ * zero bytes; then valid UTF-8 (which includes plain ASCII) is UTF-8; anything
+ * else is the ANSI code page, which round-trips every byte it defines. */
+
+#include "notepad.h"
+
+const WCHAR *enc_name(ENCODING enc)
+{
+    switch (enc)
+    {
+    case ENC_UTF8:     return L"UTF-8";
+    case ENC_UTF8_BOM: return L"UTF-8 with BOM";
+    case ENC_UTF16LE:  return L"UTF-16 LE";
+    case ENC_UTF16BE:  return L"UTF-16 BE";
+    case ENC_ANSI:     return L"ANSI";
+    default:           return L"";
+    }
+}
+
+const WCHAR *eol_name(EOLTYPE eol)
+{
+    switch (eol)
+    {
+    case EOL_LF: return L"Unix (LF)";
+    case EOL_CR: return L"Macintosh (CR)";
+    default:     return L"Windows (CRLF)";
+    }
+}
+
+const WCHAR *eol_chars(EOLTYPE eol)
+{
+    switch (eol)
+    {
+    case EOL_LF: return L"\n";
+    case EOL_CR: return L"\r";
+    default:     return L"\r\n";
+    }
+}
+
+EOLTYPE detect_eol(const WCHAR *text, size_t len, BOOL *mixed)
+{
+    size_t crlf = 0, lf = 0, cr = 0, i;
+    for (i = 0; i < len; i++)
+    {
+        if (text[i] == '\r')
+        {
+            if (i + 1 < len && text[i + 1] == '\n') { crlf++; i++; }
+            else cr++;
+        }
+        else if (text[i] == '\n') lf++;
+    }
+    if (mixed) *mixed = ((crlf != 0) + (lf != 0) + (cr != 0)) > 1;
+    if (lf > crlf && lf >= cr) return EOL_LF;
+    if (cr > crlf && cr > lf) return EOL_CR;
+    return EOL_CRLF;
+}
+
+static BOOL valid_utf8(const BYTE *p, size_t n)
+{
+    size_t i = 0;
+    while (i < n)
+    {
+        BYTE c = p[i];
+        int k;
+        if (c < 0x80) { i++; continue; }
+        if (c >= 0xc2 && c <= 0xdf) k = 1;
+        else if (c >= 0xe0 && c <= 0xef) k = 2;
+        else if (c >= 0xf0 && c <= 0xf4) k = 3;
+        else return FALSE;
+        {
+            int j;
+            for (j = 1; j <= k; j++)
+                if (i + j >= n || (p[i + j] & 0xc0) != 0x80) return FALSE;
+        }
+        /* overlongs and surrogates */
+        if (c == 0xe0 && p[i + 1] < 0xa0) return FALSE;
+        if (c == 0xed && p[i + 1] > 0x9f) return FALSE;
+        if (c == 0xf0 && p[i + 1] < 0x90) return FALSE;
+        if (c == 0xf4 && p[i + 1] > 0x8f) return FALSE;
+        i += k + 1;
+    }
+    return TRUE;
+}
+
+static ENCODING sniff(const BYTE *p, size_t n, size_t *bom)
+{
+    size_t even0 = 0, odd0 = 0, i, lim = min(n, 65536);
+
+    *bom = 0;
+    if (n >= 3 && p[0] == 0xef && p[1] == 0xbb && p[2] == 0xbf) { *bom = 3; return ENC_UTF8_BOM; }
+    if (n >= 2 && p[0] == 0xff && p[1] == 0xfe) { *bom = 2; return ENC_UTF16LE; }
+    if (n >= 2 && p[0] == 0xfe && p[1] == 0xff) { *bom = 2; return ENC_UTF16BE; }
+    if (n >= 4 && !(n & 1))
+    {
+        for (i = 0; i + 1 < lim; i += 2)
+        {
+            if (!p[i]) even0++;
+            if (!p[i + 1]) odd0++;
+        }
+        if (odd0 > lim / 2 * 4 / 10 && even0 < lim / 2 / 20) return ENC_UTF16LE;
+        if (even0 > lim / 2 * 4 / 10 && odd0 < lim / 2 / 20) return ENC_UTF16BE;
+    }
+    if (valid_utf8(p, n)) return ENC_UTF8;
+    return ENC_ANSI;
+}
+
+static WCHAR *decode(const BYTE *p, size_t n, ENCODING enc, size_t *outlen)
+{
+    WCHAR *w;
+    size_t i, len;
+
+    switch (enc)
+    {
+    case ENC_UTF16LE:
+    case ENC_UTF16BE:
+        len = n / 2;
+        if (!(w = malloc((len + 1) * sizeof(WCHAR)))) return NULL;
+        for (i = 0; i < len; i++)
+            w[i] = enc == ENC_UTF16LE ? (WCHAR)(p[2 * i] | (p[2 * i + 1] << 8)) : (WCHAR)((p[2 * i] << 8) | p[2 * i + 1]);
+        break;
+    default:
+    {
+        UINT cp = (enc == ENC_ANSI) ? CP_ACP : CP_UTF8;
+        int k;
+        if (n > 0x7fffffff) return NULL;
+        len = n ? MultiByteToWideChar(cp, 0, (const char *)p, (int)n, NULL, 0) : 0;
+        if (!(w = malloc((len + 1) * sizeof(WCHAR)))) return NULL;
+        k = n ? MultiByteToWideChar(cp, 0, (const char *)p, (int)n, w, (int)len) : 0;
+        len = k;
+        break;
+    }
+    }
+    w[len] = 0;
+    *outlen = len;
+    return w;
+}
+
+DWORD load_file(const WCHAR *path, ENCODING force, LOADED *out)
+{
+    HANDLE h;
+    LARGE_INTEGER size;
+    BYTE *data;
+    DWORD got, err = 0;
+    size_t bom = 0, done = 0;
+    ENCODING enc;
+
+    memset(out, 0, sizeof(*out));
+    h = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                    OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h == INVALID_HANDLE_VALUE) return GetLastError();
+    if (!GetFileSizeEx(h, &size)) { err = GetLastError(); CloseHandle(h); return err; }
+    if ((ULONGLONG)size.QuadPart > (sizeof(void *) == 4 ? 0x20000000ull : 0x7fff0000ull))
+    {
+        CloseHandle(h);
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    if (!(data = malloc((size_t)size.QuadPart + 1))) { CloseHandle(h); return ERROR_NOT_ENOUGH_MEMORY; }
+    while (done < (size_t)size.QuadPart)
+    {
+        DWORD chunk = (DWORD)min((size_t)size.QuadPart - done, 1u << 30);
+        if (!ReadFile(h, data + done, chunk, &got, NULL)) { err = GetLastError(); break; }
+        if (!got) break;
+        done += got;
+    }
+    CloseHandle(h);
+    if (err) { free(data); return err; }
+
+    enc = sniff(data, done, &bom);
+    if (force != ENC_COUNT)
+    {
+        /* reopening with a chosen encoding: keep a matching BOM out of the text */
+        if (force == ENC_UTF8 || force == ENC_UTF8_BOM)
+        {
+            if (enc == ENC_UTF8_BOM) force = ENC_UTF8_BOM;
+            else { bom = 0; if (force == ENC_UTF8_BOM) force = ENC_UTF8; }
+        }
+        else if (force != enc) bom = 0;
+        enc = force;
+    }
+    out->text = decode(data + bom, done - bom, enc, &out->len);
+    free(data);
+    if (!out->text) return ERROR_NOT_ENOUGH_MEMORY;
+    out->enc = enc;
+    out->eol = detect_eol(out->text, out->len, &out->mixed_eol);
+    return 0;
+}
+
+BOOL ansi_is_lossy(const WCHAR *text, size_t len)
+{
+    BOOL used = FALSE;
+    if (!len || len > 0x7fffffff) return FALSE;
+    WideCharToMultiByte(CP_ACP, WC_NO_BEST_FIT_CHARS, text, (int)len, NULL, 0, NULL, &used);
+    return used;
+}
+
+DWORD save_file(const WCHAR *path, const WCHAR *text, size_t len, ENCODING enc, BOOL *lossy)
+{
+    BYTE *data = NULL;
+    size_t n = 0, i, bom = 0;
+    HANDLE h;
+    DWORD err = 0, wrote;
+
+    if (lossy) *lossy = FALSE;
+    if (len > 0x3fffffff) return ERROR_NOT_ENOUGH_MEMORY;
+    switch (enc)
+    {
+    case ENC_UTF16LE:
+    case ENC_UTF16BE:
+        bom = 2;
+        n = len * 2;
+        if (!(data = malloc(n + bom))) return ERROR_NOT_ENOUGH_MEMORY;
+        data[0] = enc == ENC_UTF16LE ? 0xff : 0xfe;
+        data[1] = enc == ENC_UTF16LE ? 0xfe : 0xff;
+        for (i = 0; i < len; i++)
+        {
+            BYTE lo = text[i] & 0xff, hi = text[i] >> 8;
+            data[bom + 2 * i] = enc == ENC_UTF16LE ? lo : hi;
+            data[bom + 2 * i + 1] = enc == ENC_UTF16LE ? hi : lo;
+        }
+        break;
+    default:
+    {
+        UINT cp = enc == ENC_ANSI ? CP_ACP : CP_UTF8;
+        BOOL used = FALSE;
+        int k;
+        bom = enc == ENC_UTF8_BOM ? 3 : 0;
+        k = len ? WideCharToMultiByte(cp, cp == CP_ACP ? WC_NO_BEST_FIT_CHARS : 0, text, (int)len, NULL, 0, NULL,
+                                      cp == CP_ACP ? &used : NULL) : 0;
+        if (!(data = malloc(k + bom + 1))) return ERROR_NOT_ENOUGH_MEMORY;
+        if (len) WideCharToMultiByte(cp, cp == CP_ACP ? WC_NO_BEST_FIT_CHARS : 0, text, (int)len, (char *)data + bom, k,
+                                     NULL, NULL);
+        if (bom) { data[0] = 0xef; data[1] = 0xbb; data[2] = 0xbf; }
+        n = k;
+        if (lossy) *lossy = used;
+        break;
+    }
+    }
+    n += bom;
+
+    /* write in place (not a new file renamed over it): keeps the file's
+     * identity, attributes, hard links and permissions, as Notepad does */
+    h = CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h == INVALID_HANDLE_VALUE)
+    {
+        err = GetLastError();
+        free(data);
+        return err;
+    }
+    for (i = 0; i < n; )
+    {
+        DWORD chunk = (DWORD)min(n - i, 1u << 30);
+        if (!WriteFile(h, data + i, chunk, &wrote, NULL)) { err = GetLastError(); break; }
+        i += wrote;
+    }
+    if (!err && !SetEndOfFile(h)) err = GetLastError();
+    CloseHandle(h);
+    free(data);
+    return err;
+}
