+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "notepad.h"
+
+static WCHAR *fold_tab;
+
+static void init_fold(void)
+{
+    int i;
+    if (fold_tab) return;
+    if (!(fold_tab = malloc(65536 * sizeof(WCHAR)))) return;
+    for (i = 0; i < 65536; i++) fold_tab[i] = (WCHAR)i;
+    CharLowerBuffW(fold_tab + 1, 65535);
+    for (i = 0xd800; i < 0xe000; i++) fold_tab[i] = (WCHAR)i;
+}
+
+static inline WCHAR fold(WCHAR c)
+{
+    return fold_tab ? fold_tab[c] : c;
+}
+
+static inline BOOL is_word(WCHAR c)
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' ||
+           (c >= 0x80 && IsCharAlphaNumericW(c));
+}
+
+/* the compiled pattern is kept between calls */
+static REGEX *cached_re;
+static WCHAR *cached_pat;
+static BOOL   cached_icase;
+
+static REGEX *get_regex(const WCHAR *what, BOOL icase)
+{
+    const WCHAR *err;
+    if (cached_re && cached_pat && !wcscmp(cached_pat, what) && cached_icase == icase) return cached_re;
+    re_free(cached_re);
+    free(cached_pat);
+    cached_re = re_compile(what, icase, &err);
+    cached_pat = _wcsdup(what);
+    cached_icase = icase;
+    return cached_re;
+}
+
+static BOOL match_at(const WCHAR *t, size_t len, size_t pos, const WCHAR *w, size_t wl, BOOL icase)
+{
+    size_t i;
+    if (pos + wl > len) return FALSE;
+    if (!icase) return !memcmp(t + pos, w, wl * sizeof(WCHAR));
+    for (i = 0; i < wl; i++)
+        if (fold(t[pos + i]) != fold(w[i])) return FALSE;
+    return TRUE;
+}
+
+static BOOL word_ok(const WCHAR *t, size_t len, size_t s, size_t e)
+{
+    return (s == 0 || !is_word(t[s - 1]) || !is_word(t[s])) && (e >= len || !is_word(t[e]) || !is_word(t[e - 1]));
+}
+
+/* the first match starting in [from, limit) going forward, or the last one
+ * starting at or before `from` going backward */
+static int find_raw(const WCHAR *t, size_t len, const WCHAR *what, UINT flags, size_t from, size_t limit,
+                    size_t *ms, size_t *me, size_t *groups)
+{
+    BOOL icase = !(flags & FIND_CASE), back = !!(flags & FIND_BACK);
+    size_t wl = wcslen(what), pos;
+
+    if (!*what) return 0;
+    if (icase) init_fold();
+    if (flags & FIND_REGEX)
+    {
+        REGEX *re = get_regex(what, icase);
+        size_t g[2 * 33];
+        if (!re) return -1;
+        if (!groups) groups = g;
+        pos = from;
+        for (;;)
+        {
+            if (!re_search(re, t, len, pos, back, groups)) return 0;
+            if (!back && groups[0] >= limit) return 0;
+            if (back && groups[0] < limit) return 0;
+            if (!(flags & FIND_WORD) || word_ok(t, len, groups[0], groups[1]))
+            {
+                *ms = groups[0];
+                *me = groups[1];
+                return 1;
+            }
+            if (back) { if (!groups[0]) return 0; pos = groups[0] - 1; }
+            else pos = groups[0] + 1;
+        }
+    }
+    if (!back)
+    {
+        WCHAR first = icase ? fold(what[0]) : what[0];
+        for (pos = from; pos < limit && pos + wl <= len; pos++)
+        {
+            if ((icase ? fold(t[pos]) : t[pos]) != first) continue;
+            if (match_at(t, len, pos, what, wl, icase) && (!(flags & FIND_WORD) || word_ok(t, len, pos, pos + wl)))
+            {
+                *ms = pos; *me = pos + wl;
+                return 1;
+            }
+        }
+        return 0;
+    }
+    if (len < wl) return 0;
+    pos = min(from, len - wl);
+    for (;;)
+    {
+        if (pos < limit) return 0;
+        if (match_at(t, len, pos, what, wl, icase) && (!(flags & FIND_WORD) || word_ok(t, len, pos, pos + wl)))
+        {
+            *ms = pos; *me = pos + wl;
+            return 1;
+        }
+        if (!pos) return 0;
+        pos--;
+    }
+}
+
+int find_next(HWND ed, const WCHAR *what, UINT flags)
+{
+    size_t anchor, caret, a, b, len = ed_length(ed), ms, me;
+    const WCHAR *t = ed_text(ed);
+    int r;
+
+    ed_get_sel(ed, &anchor, &caret);
+    a = min(anchor, caret);
+    b = max(anchor, caret);
+    if (!(flags & FIND_BACK))
+    {
+        size_t from = b;
+        if (a == b && (flags & FIND_REGEX)) from = b;
+        r = find_raw(t, len, what, flags, from, len + 1, &ms, &me, NULL);
+        /* an empty match where we already are: step over it */
+        if (r == 1 && ms == me && ms == a && a == b)
+            r = (from < len) ? find_raw(t, len, what, flags, from + 1, len + 1, &ms, &me, NULL) : 0;
+        if (r == 0 && !(flags & FIND_NOWRAP))
+        {
+            r = find_raw(t, len, what, flags, 0, from, &ms, &me, NULL);
+            if (r == 1) r = 2;
+        }
+    }
+    else
+    {
+        r = a ? find_raw(t, len, what, flags, a - 1, 0, &ms, &me, NULL) : 0;
+        if (r == 0 && !(flags & FIND_NOWRAP) && len)
+        {
+            r = find_raw(t, len, what, flags, len, a, &ms, &me, NULL);
+            if (r == 1) r = 2;
+        }
+    }
+    if (r > 0) ed_set_sel(ed, ms, me, TRUE);
+    return r;
+}
+
+/* the replacement text for a match: $1 \1 $& $0 \n \t in regex mode */
+static WCHAR *expand(const WCHAR *t, const WCHAR *with, UINT flags, const size_t *g, int ngroups, size_t *outn)
+{
+    size_t cap = wcslen(with) + 16, n = 0, k;
+    WCHAR *out = malloc(cap * sizeof(WCHAR));
+    const WCHAR *p;
+
+    if (!out) return NULL;
+    if (!(flags & FIND_REGEX))
+    {
+        n = wcslen(with);
+        memcpy(out, with, n * sizeof(WCHAR));
+        *outn = n;
+        return out;
+    }
+    for (p = with; *p; p++)
+    {
+        const WCHAR *piece = p;
+        size_t pl = 1;
+        WCHAR ch;
+        int grp = -1;
+        if ((*p == '$' || *p == '\\') && p[1] >= '0' && p[1] <= '9') { grp = p[1] - '0'; p++; }
+        else if (*p == '$' && p[1] == '&') { grp = 0; p++; }
+        else if (*p == '$' && p[1] == '$') { p++; }
+        else if (*p == '\\' && p[1])
+        {
+            p++;
+            ch = *p == 'n' ? '\n' : *p == 't' ? '\t' : *p == 'r' ? '\r' : *p;
+            piece = &ch;
+        }
+        if (grp >= 0)
+        {
+            if (grp > ngroups || g[2 * grp] == (size_t)-1 || g[2 * grp + 1] == (size_t)-1) continue;
+            piece = t + g[2 * grp];
+            pl = g[2 * grp + 1] - g[2 * grp];
+        }
+        if (n + pl + 1 > cap)
+        {
+            WCHAR *no;
+            cap = (n + pl) * 2 + 16;
+            if (!(no = realloc(out, cap * sizeof(WCHAR)))) { free(out); return NULL; }
+            out = no;
+        }
+        for (k = 0; k < pl; k++) out[n++] = piece[k];
+    }
+    *outn = n;
+    return out;
+}
+
+static int ngroups_of(const WCHAR *what, UINT flags)
+{
+    REGEX *re;
+    if (!(flags & FIND_REGEX)) return 0;
+    re = get_regex(what, !(flags & FIND_CASE));
+    return re ? re_ngroups(re) : 0;
+}
+
+BOOL find_replace_one(HWND ed, const WCHAR *what, const WCHAR *with, UINT flags)
+{
+    size_t anchor, caret, a, b, len = ed_length(ed), ms, me, g[2 * 33];
+    const WCHAR *t = ed_text(ed);
+
+    ed_get_sel(ed, &anchor, &caret);
+    a = min(anchor, caret);
+    b = max(anchor, caret);
+    /* the selection is a match: replace it, then find the next one */
+    if (find_raw(t, len, what, flags & ~FIND_BACK, a, a + 1, &ms, &me, g) == 1 && ms == a && me == b)
+    {
+        size_t n;
+        WCHAR *rep = expand(t, with, flags, g, ngroups_of(what, flags), &n);
+        if (rep)
+        {
+            ed_replace_sel(ed, rep, n);
+            free(rep);
+        }
+        if (ms == me) ed_set_sel(ed, a + n, a + n, FALSE);
+    }
+    return find_next(ed, what, flags) > 0;
+}
+
+int find_replace_all(HWND ed, const WCHAR *what, const WCHAR *with, UINT flags)
+{
+    size_t len = ed_length(ed), pos = 0, ms, me, first = (size_t)-1, last = 0, n = 0, cap = 0, g[2 * 33];
+    const WCHAR *t = ed_text(ed);
+    WCHAR *out = NULL;
+    int count = 0, ng = ngroups_of(what, flags), r;
+
+    flags &= ~FIND_BACK;
+    while (pos <= len && (r = find_raw(t, len, what, flags, pos, len + 1, &ms, &me, g)) == 1)
+    {
+        size_t rn, keep;
+        WCHAR *rep = expand(t, with, flags, g, ng, &rn);
+        if (!rep) break;
+        if (first == (size_t)-1) { first = ms; last = ms; }
+        keep = ms - last;
+        if (n + keep + rn + 1 > cap)
+        {
+            WCHAR *no;
+            cap = (n + keep + rn) * 2 + 1024;
+            if (!(no = realloc(out, cap * sizeof(WCHAR)))) { free(rep); break; }
+            out = no;
+        }
+        memcpy(out + n, t + last, keep * sizeof(WCHAR));
+        n += keep;
+        memcpy(out + n, rep, rn * sizeof(WCHAR));
+        n += rn;
+        free(rep);
+        count++;
+        last = me;
+        if (me == ms)
+        {
+            /* an empty match: keep the next character and move past it */
+            if (me >= len) break;
+            if (n + 2 > cap)
+            {
+                WCHAR *no;
+                cap = cap * 2 + 16;
+                if (!(no = realloc(out, cap * sizeof(WCHAR)))) break;
+                out = no;
+            }
+            out[n++] = t[me];
+            last = me + 1;
+            pos = me + 1;
+        }
+        else pos = me;
+    }
+    if (count > 0 && out)
+    {
+        ed_begin_group(ed);
+        ed_replace(ed, first, last - first, out, n);
+        ed_end_group(ed);
+        ed_set_sel(ed, first, first, TRUE);
+    }
+    free(out);
+    if (r < 0 && !count) return -1;
+    return count;
+}
+
+int find_count(HWND ed, const WCHAR *what, UINT flags, int *index_of_sel)
+{
+    size_t len = ed_length(ed), pos = 0, ms, me, anchor, caret, a;
+    const WCHAR *t;
+    int count = 0;
+    DWORD start = GetTickCount();
+
+    *index_of_sel = 0;
+    if (!*what || len > 16 * 1024 * 1024) return -1;
+    t = ed_text(ed);
+    ed_get_sel(ed, &anchor, &caret);
+    a = min(anchor, caret);
+    flags &= ~FIND_BACK;
+    while (pos <= len && find_raw(t, len, what, flags, pos, len + 1, &ms, &me, NULL) == 1)
+    {
+        count++;
+        if (ms == a) *index_of_sel = count;
+        pos = (me > ms) ? me : ms + 1;
+        if (count >= 99999 || GetTickCount() - start > 300) return -1;
+    }
+    return count;
+}
