From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] magnification: full-screen offsets reach the compositor in its own pixels

MagSetFullscreenTransform's offsets went to the compositor as given. A
DPI-unaware program's screen point is the physical one scaled down (at
200% halved), so its magnified view started at the wrong place. The point
is now scaled up from an unaware caller's (the system DPI as an aware
thread sees it), and the virtual screen's top left taken off: the
compositor's coordinates are the Wine desktop's (sg-compositor sg70).
MagGetFullscreenTransform still answers what the caller gave.

Gate test-magapi: at LogPixels 192 an unaware caller's 100,50 reaches the
compositor as 200,100, a per-monitor aware caller's as 100,50. Mutant
SG_MUTANT_MAG_LOGICAL_COORDS (magnification.c).
---
diff --git a/dlls/magnification/Makefile.in b/dlls/magnification/Makefile.in
index c608eb9..0edcd94 100644
--- a/dlls/magnification/Makefile.in
+++ b/dlls/magnification/Makefile.in
@@ -1,5 +1,6 @@
 MODULE    = magnification.dll
 UNIXLIB   = magnification.so
+IMPORTS   = user32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
diff --git a/dlls/magnification/magnification.c b/dlls/magnification/magnification.c
index 7ab7a2a..9fbe48c 100644
--- a/dlls/magnification/magnification.c
+++ b/dlls/magnification/magnification.c
@@ -25,6 +25,8 @@
 #define WIN32_NO_STATUS
 #include "windef.h"
 #include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
 #include "winternl.h"
 #include "wine/debug.h"
 
@@ -71,6 +73,30 @@ static BOOL command( const char *line )
     return !status;
 }
 
+/* The compositor takes the Wine desktop's coordinates (its top left 0,0, as the virtual screen's top
+ * left is for Windows programs) in its own pixels -- physical ones: a caller's screen point, scaled up
+ * from a DPI-unaware caller's, less the virtual screen's top left. */
+static void to_desktop( int *x, int *y )
+{
+    DPI_AWARENESS awareness = GetAwarenessFromDpiAwarenessContext( GetThreadDpiAwarenessContext() );
+    DPI_AWARENESS_CONTEXT old = SetThreadDpiAwarenessContext( DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2 );
+
+    /* the system DPI as an aware thread sees it (an unaware one is told 96) */
+#ifndef SG_MUTANT_MAG_LOGICAL_COORDS
+    if (awareness == DPI_AWARENESS_UNAWARE)
+#else
+    if (0)
+#endif
+    {
+        UINT dpi = GetDpiForSystem();
+        *x = MulDiv( *x, dpi, USER_DEFAULT_SCREEN_DPI );
+        *y = MulDiv( *y, dpi, USER_DEFAULT_SCREEN_DPI );
+    }
+    *x -= GetSystemMetrics( SM_XVIRTUALSCREEN );
+    *y -= GetSystemMetrics( SM_YVIRTUALSCREEN );
+    if (old) SetThreadDpiAwarenessContext( old );
+}
+
 BOOL WINAPI DllMain( HINSTANCE instance, DWORD reason, void *reserved )
 {
     switch (reason)
@@ -114,7 +140,12 @@ BOOL WINAPI MagSetFullscreenTransform( float level, int x, int y )
 
     EnterCriticalSection( &cs );
     if (level == 1.0f) strcpy( line, "off" );
-    else sprintf( line, "full %d %d %d", (int)(level * 100.0f + 0.5f), x, y );
+    else
+    {
+        int dx = x, dy = y;
+        to_desktop( &dx, &dy );
+        sprintf( line, "full %d %d %d", (int)(level * 100.0f + 0.5f), dx, dy );
+    }
     if ((ret = command( line )))
     {
         full_level = level;
