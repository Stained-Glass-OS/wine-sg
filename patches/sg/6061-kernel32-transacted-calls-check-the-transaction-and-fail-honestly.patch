From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernel32: Transacted calls check the transaction and fail as without TxF (6061)

The *Transacted file functions did their work outside the transaction,
so a rollback kept the changes. They now check the transaction handle
(ERROR_INVALID_HANDLE when it is not a transaction) and then fail the
way a volume without transaction support does, ERROR_RM_NOT_ACTIVE,
changing nothing. CreateHardLinkTransacted, which was a stub, does the
same.
---
diff --git a/dlls/kernel32/path.c b/dlls/kernel32/path.c
index ff5cecc..5561738 100644
--- a/dlls/kernel32/path.c
+++ b/dlls/kernel32/path.c
@@ -139,27 +139,59 @@ BOOL WINAPI CopyFileExA(LPCSTR sourceFilename, LPCSTR destFilename,
     return ret;
 }
 
+/* Transactional NTFS. Our volumes have no transaction support: once the transaction is known to be one,
+ * a *Transacted call fails the way it does on a volume whose transaction resource manager is not
+ * active (ERROR_RM_NOT_ACTIVE, "Transaction support within the specified resource manager is not
+ * started", winerror.h / System Error Codes 6000-8199). Doing the work outside the transaction would
+ * leave changes a rollback cannot undo. Returns whether the call may go on, which it never may here:
+ * the plain call after it is what a volume with transaction support would do within the transaction. */
+static BOOL txf_check( HANDLE transaction )
+{
+    struct
+    {
+        OBJECT_TYPE_INFORMATION info;
+        WCHAR name[32];
+    } type;
+    ULONG len;
+
+    if (!transaction || transaction == INVALID_HANDLE_VALUE ||
+        NtQueryObject( transaction, ObjectTypeInformation, &type, sizeof(type), &len ) ||
+        type.info.TypeName.Length != wcslen( L"Transaction" ) * sizeof(WCHAR) ||
+        wcsncmp( type.info.TypeName.Buffer, L"Transaction", wcslen( L"Transaction" ) ))
+    {
+#ifndef SG_MUTANT_TXF_NO_HANDLE_CHECK
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+#endif
+    }
+#ifdef SG_MUTANT_TXF_RUN_PLAIN
+    return TRUE;
+#endif
+    SetLastError( ERROR_RM_NOT_ACTIVE );
+    return FALSE;
+}
+
 /**************************************************************************
  *           MoveFileTransactedA   (KERNEL32.@)
  */
-BOOL WINAPI MoveFileTransactedA(const char *source, const char *dest, LPPROGRESS_ROUTINE progress, void *data, DWORD flags, HANDLE handle)
+BOOL WINAPI MoveFileTransactedA(const char *source, const char *dest, LPPROGRESS_ROUTINE progress, void *data, DWORD flags, HANDLE transaction)
 {
-    FIXME("(%s, %s, %p, %p, %ld, %p) semi-stub\n", debugstr_a(source), debugstr_a(dest), progress, data, flags, handle);
-
+    TRACE("(%s %s %p)\n", debugstr_a(source), debugstr_a(dest), transaction);
+    if (!txf_check( transaction )) return FALSE;
     return MoveFileWithProgressA(source, dest, progress, data, flags);
 }
 
