From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: effect vertex buffers can be mapped, WIC render targets check the bitmap format

Results the Wine tests record from Windows, which were todo (34 marks).

 - ID2D1VertexBuffer from an effect context keeps its data (the initial data of the properties,
   zeroes without): Map gives the same memory every time, E_INVALIDARG for a size over the buffer's
   byteWidth, Unmap succeeds.
 - ID2D1Factory::CreateWicBitmapRenderTarget refuses (E_INVALIDARG) a DXGI format that does not
   fit the bitmap (B8G8R8A8 with an RGB ordered bitmap and the reverse) and an alpha mode that does not fit
   whether the bitmap has an alpha channel (ignore with PBGRA/PRGBA, premultiplied with BGR/RGB).
 - Removed the corresponding todo_wine marks.
---
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -950,6 +950,10 @@ struct d2d_vertex_buffer
 {
     ID2D1VertexBuffer ID2D1VertexBuffer_iface;
     LONG refcount;
+
+    BYTE *data;
+    UINT32 size;
+    unsigned int map_count;
 };
 
 enum d2d_command_list_state
--- a/dlls/d2d1/effect.c
+++ b/dlls/d2d1/effect.c
@@ -83,23 +83,49 @@ static ULONG STDMETHODCALLTYPE d2d_vertex_buffer_Release(ID2D1VertexBuffer *ifac
     TRACE("%p decreasing refcount to %lu.\n", iface, refcount);
 
     if (!refcount)
+    {
+        free(buffer->data);
         free(buffer);
+    }
 
     return refcount;
 }
 
 static HRESULT STDMETHODCALLTYPE d2d_vertex_buffer_Map(ID2D1VertexBuffer *iface, BYTE **data, UINT32 size)
 {
-    FIXME("iface %p, data %p, size %u.\n", iface, data, size);
+    struct d2d_vertex_buffer *buffer = impl_from_ID2D1VertexBuffer(iface);
 
+    TRACE("iface %p, data %p, size %u.\n", iface, data, size);
+
+    if (!data)
+        return E_INVALIDARG;
+
+    *data = NULL;
+#ifndef SG_MUTANT_D2DVB_NOTIMPL
+    /* a buffer can be mapped again before it is unmapped, it is the same memory */
+    if (size > buffer->size)
+        return E_INVALIDARG;
+
+    *data = buffer->data;
+    buffer->map_count++;
+    return S_OK;
+#else
     return E_NOTIMPL;
+#endif
 }
 
 static HRESULT STDMETHODCALLTYPE d2d_vertex_buffer_Unmap(ID2D1VertexBuffer *iface)
 {
-    FIXME("iface %p.\n", iface);
+    struct d2d_vertex_buffer *buffer = impl_from_ID2D1VertexBuffer(iface);
+
+    TRACE("iface %p.\n", iface);
 
+#ifdef SG_MUTANT_D2DVB_NOTIMPL
     return E_NOTIMPL;
+#endif
+    if (buffer->map_count)
+        buffer->map_count--;
+    return S_OK;
 }
 
 static const ID2D1VertexBufferVtbl d2d_vertex_buffer_vtbl =
@@ -111,7 +137,7 @@ static const ID2D1VertexBufferVtbl d2d_vertex_buffer_vtbl =
     d2d_vertex_buffer_Unmap,
 };
 
-static HRESULT d2d_vertex_buffer_create(ID2D1VertexBuffer **buffer)
+static HRESULT d2d_vertex_buffer_create(const D2D1_VERTEX_BUFFER_PROPERTIES *properties, ID2D1VertexBuffer **buffer)
 {
     struct d2d_vertex_buffer *object;
 
@@ -120,6 +146,14 @@ static HRESULT d2d_vertex_buffer_create(ID2D1VertexBuffer **buffer)
 
     object->ID2D1VertexBuffer_iface.lpVtbl = &d2d_vertex_buffer_vtbl;
     object->refcount = 1;
+    object->size = properties ? properties->byteWidth : 0;
+    if (!(object->data = calloc(1, object->size ? object->size : 1)))
+    {
+        free(object);
+        return E_OUTOFMEMORY;
+    }
+    if (properties && properties->data)
+        memcpy(object->data, properties->data, object->size);
 
     *buffer = &object->ID2D1VertexBuffer_iface;
 
@@ -2171,13 +2205,13 @@ static HRESULT STDMETHODCALLTYPE d2d_effect_context_CreateVertexBuffer(ID2D1Effe
     struct d2d_device_context *context = effect_context->device_context;
     HRESULT hr;
 
-    FIXME("iface %p, buffer_properties %p, id %s, custom_buffer_properties %p, buffer %p stub!\n",
+    FIXME("iface %p, buffer_properties %p, id %s, custom_buffer_properties %p, buffer %p: custom layouts are ignored.\n",
             iface, buffer_properties, debugstr_guid(id), custom_buffer_properties, buffer);
 
     if (id && d2d_device_get_indexed_object(&context->vertex_buffers, id, (IUnknown **)buffer))
         return S_OK;
 
-    if (SUCCEEDED(hr = d2d_vertex_buffer_create(buffer)))
+    if (SUCCEEDED(hr = d2d_vertex_buffer_create(buffer_properties, buffer)))
     {
         if (id)
             hr = d2d_device_add_indexed_object(&context->vertex_buffers, id, (IUnknown *)*buffer);
--- a/dlls/d2d1/tests/d2d1.c
