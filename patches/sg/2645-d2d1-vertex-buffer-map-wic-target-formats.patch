--- a/dlls/d2d1/wic_render_target.c
+++ b/dlls/d2d1/wic_render_target.c
@@ -250,6 +250,32 @@ HRESULT d2d_wic_render_target_init(struct d2d_wic_render_target *render_target,
     texture_desc.ArraySize = 1;
 
     texture_desc.Format = desc->pixelFormat.format;
+#ifndef SG_MUTANT_D2DWIC_FORMAT_UNCHECKED
+    if (texture_desc.Format != DXGI_FORMAT_UNKNOWN)
+    {
+        /* the target format has to be the one of the bitmap: the same order of the channels, and an
+         * alpha mode that fits whether the bitmap has an alpha channel */
+        WICPixelFormatGUID bitmap_format;
+        BOOL bgr, rgb, alpha;
+
+        if (FAILED(hr = IWICBitmap_GetPixelFormat(bitmap, &bitmap_format)))
+            return hr;
+
+        bgr = IsEqualGUID(&bitmap_format, &GUID_WICPixelFormat32bppPBGRA)
+                || IsEqualGUID(&bitmap_format, &GUID_WICPixelFormat32bppBGR);
+        rgb = IsEqualGUID(&bitmap_format, &GUID_WICPixelFormat32bppPRGBA)
+                || IsEqualGUID(&bitmap_format, &GUID_WICPixelFormat32bppRGB);
+        alpha = IsEqualGUID(&bitmap_format, &GUID_WICPixelFormat32bppPBGRA)
+                || IsEqualGUID(&bitmap_format, &GUID_WICPixelFormat32bppPRGBA);
+
+        if ((bgr && texture_desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM)
+                || (rgb && texture_desc.Format != DXGI_FORMAT_R8G8B8A8_UNORM))
+            return E_INVALIDARG;
+        if ((bgr || rgb) && ((desc->pixelFormat.alphaMode == D2D1_ALPHA_MODE_IGNORE && alpha)
+                || (desc->pixelFormat.alphaMode == D2D1_ALPHA_MODE_PREMULTIPLIED && !alpha)))
+            return E_INVALIDARG;
+    }
+#endif
     if (texture_desc.Format == DXGI_FORMAT_UNKNOWN)
     {
         WICPixelFormatGUID bitmap_format;
