From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 13:40:33 -0700
Subject: [PATCH] setupapi: DriverVer, driver key properties,
 SetupDi{Get,Set}DriverInstallParams (3244)

[Version] DriverVer=date,version is parsed into SP_DRVINFO_DATA.DriverDate and
DriverVersion. Installing a driver writes the values Windows leaves in the
driver key (DriverDate, DriverDateData, DriverVersion, DriverDesc,
ProviderName, MatchingDeviceId). SetupDiGetDriverInstallParams and
SetupDiSetDriverInstallParams (A and W) were stubs: they now report and
store Rank, Flags and PrivateData of a driver (the selected one without a
driver info).

diff --git a/dlls/setupapi/devinst.c b/dlls/setupapi/devinst.c
index a5149ff..1faffe0 100644
--- a/dlls/setupapi/devinst.c
+++ b/dlls/setupapi/devinst.c
@@ -122,6 +122,11 @@ struct driver
     WCHAR mfg_key[LINE_LEN];
     WCHAR description[LINE_LEN];
     WCHAR section[LINE_LEN];
+    WCHAR matching_id[LINE_LEN];  /* the hardware or compatible ID of the INF line that matched */
+    FILETIME date;                /* [Version] DriverVer */
+    DWORDLONG version;
+    DWORD flags;                  /* SP_DRVINSTALL_PARAMS */
+    DWORD_PTR private_data;
 };
 
 /* is used to identify if a DeviceInfoSet pointer is
@@ -6323,6 +6328,50 @@ static bool any_version_is_compatible(INFCONTEXT *ctx)
     return false;
 }
 
+/* [Version] DriverVer=mm/dd/yyyy[,w.x.y.z] */
+static void parse_driver_ver(HINF hinf, struct driver *driver)
+{
+    WCHAR date[LINE_LEN], ver[LINE_LEN], *end;
+    SYSTEMTIME st = {0};
+    INFCONTEXT ctx;
+    DWORDLONG v = 0;
+    unsigned int i;
+
+    memset(&driver->date, 0, sizeof(driver->date));
+    driver->version = 0;
+
+#ifdef SG_MUTANT_SUDI_NODATE
+    return;
+#endif
+    if (!SetupFindFirstLineW(hinf, L"Version", L"DriverVer", &ctx)) return;
+
+    if (SetupGetStringFieldW(&ctx, 1, date, ARRAY_SIZE(date), NULL))
+    {
+        st.wMonth = wcstoul(date, &end, 10);
+        if (*end == '/' || *end == '-')
+        {
+            st.wDay = wcstoul(end + 1, &end, 10);
+            if (*end == '/' || *end == '-')
+            {
+                st.wYear = wcstoul(end + 1, &end, 10);
+                SystemTimeToFileTime(&st, &driver->date);
+            }
+        }
+    }
+    if (SetupGetStringFieldW(&ctx, 2, ver, ARRAY_SIZE(ver), NULL))
+    {
+        const WCHAR *p = ver;
+
+        for (i = 0; i < 4; i++)
+        {
+            v = (v << 16) | (wcstoul(p, &end, 10) & 0xffff);
+            if (*end != '.') { v <<= 16 * (3 - i); break; }
+            p = end + 1;
+        }
+        driver->version = v;
+    }
+}
+
 static void enum_compat_drivers_from_file(struct device *device, const WCHAR *path)
 {
     static const WCHAR manufacturerW[] = {'M','a','n','u','f','a','c','t','u','r','e','r',0};
@@ -6339,6 +6388,9 @@ static void enum_compat_drivers_from_file(struct device *device, const WCHAR *pa
         return;
 
     lstrcpyW(driver.inf_path, path);
+    driver.flags = 0;
+    driver.private_data = 0;
+    parse_driver_ver(hinf, &driver);
 
     for (i = 0; SetupGetLineByIndexW(hinf, manufacturerW, i, &ctx); ++i)
     {
@@ -6371,6 +6423,7 @@ static void enum_compat_drivers_from_file(struct device *device, const WCHAR *pa
             {
                 SetupGetStringFieldW(&ctx, 0, driver.description, ARRAY_SIZE(driver.description), NULL);
                 SetupGetStringFieldW(&ctx, 1, driver.section, ARRAY_SIZE(driver.section), NULL);
+                lstrcpyW(driver.matching_id, id);
 
                 TRACE("Found compatible driver: rank %#lx manufacturer %s, desc %s.\n",
                         driver.rank, debugstr_w(driver.manufacturer), debugstr_w(driver.description));
@@ -6472,6 +6525,8 @@ static BOOL copy_driver_data(SP_DRVINFO_DATA_W *data, const struct driver *drive
     wcscpy(data->Description, driver->description);
     wcscpy(data->MfgName, driver->manufacturer);
     data->DriverType = SPDIT_COMPATDRIVER;
+    data->DriverDate = driver->date;
+    data->DriverVersion = driver->version;
     data->Reserved = (ULONG_PTR)driver;
 
     SetupCloseInfFile(hinf);
@@ -6898,6 +6953,160 @@ static BOOL assoc_service(HINF hinf, const WCHAR *section, WCHAR *svc_name, DWOR
     return FALSE;
 }
 
+/* the values Windows leaves in a driver key besides the INF's own AddReg */
+static void write_driver_properties(HKEY key, const struct driver *driver)
+{
+    SYSTEMTIME st;
+    WCHAR str[LINE_LEN], provider[LINE_LEN];
+    INFCONTEXT ctx;
+    HINF hinf;
+
+    if (driver->date.dwLowDateTime || driver->date.dwHighDateTime)
+    {
+        FileTimeToSystemTime(&driver->date, &st);
+        wsprintfW(str, L"%u-%u-%u", st.wMonth, st.wDay, st.wYear);
+        RegSetValueExW(key, L"DriverDate", 0, REG_SZ, (BYTE *)str, (lstrlenW(str) + 1) * sizeof(WCHAR));
+        RegSetValueExW(key, L"DriverDateData", 0, REG_BINARY, (const BYTE *)&driver->date, sizeof(driver->date));
+    }
+    wsprintfW(str, L"%u.%u.%u.%u", (UINT)((driver->version >> 48) & 0xffff),
+             (UINT)((driver->version >> 32) & 0xffff), (UINT)((driver->version >> 16) & 0xffff),
+             (UINT)(driver->version & 0xffff));
+    RegSetValueExW(key, L"DriverVersion", 0, REG_SZ, (BYTE *)str, (lstrlenW(str) + 1) * sizeof(WCHAR));
+    RegSetValueExW(key, L"DriverDesc", 0, REG_SZ, (const BYTE *)driver->description,
+                   (lstrlenW(driver->description) + 1) * sizeof(WCHAR));
+#ifdef SG_MUTANT_SUDI_NOMATCH
+    if (0)
+#else
+    if (driver->matching_id[0])
+#endif
+        RegSetValueExW(key, L"MatchingDeviceId", 0, REG_SZ, (const BYTE *)driver->matching_id,
+                       (lstrlenW(driver->matching_id) + 1) * sizeof(WCHAR));
+
+    provider[0] = 0;
+    if ((hinf = SetupOpenInfFileW(driver->inf_path, NULL, INF_STYLE_WIN4, NULL)) != INVALID_HANDLE_VALUE)
+    {
+        if (SetupFindFirstLineW(hinf, L"Version", L"Provider", &ctx))
+            SetupGetStringFieldW(&ctx, 1, provider, ARRAY_SIZE(provider), NULL);
+        SetupCloseInfFile(hinf);
+    }
+    if (provider[0])
+        RegSetValueExW(key, L"ProviderName", 0, REG_SZ, (BYTE *)provider, (lstrlenW(provider) + 1) * sizeof(WCHAR));
+}
+
+/* the driver a SP_DRVINFO_DATA names, or the selected one without it */
+static struct driver *get_driver_param(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data, SP_DRVINFO_DATA_W *driver_data)
+{
+    struct device *device = get_device(devinfo, device_data);
+    struct driver *driver;
+
+    if (!device) return NULL;
+    if (driver_data)
+    {
+        if (driver_data->cbSize != sizeof(*driver_data) && driver_data->cbSize != sizeof(SP_DRVINFO_DATA_V1_W))
+        {
+            SetLastError(ERROR_INVALID_USER_BUFFER);
+            return NULL;
+        }
+        driver = (struct driver *)driver_data->Reserved;
+    }
+    else
+        driver = device->selected_driver;
+    if (!driver) SetLastError(ERROR_NO_DRIVER_SELECTED);
+    return driver;
+}
+
+/***********************************************************************
+ *              SetupDiGetDriverInstallParamsW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiGetDriverInstallParamsW(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data,
+        SP_DRVINFO_DATA_W *driver_data, SP_DRVINSTALL_PARAMS *params)
+{
+    struct driver *driver;
+
+    TRACE("devinfo %p, device_data %p, driver_data %p, params %p.\n", devinfo, device_data, driver_data, params);
+
+    if (!params || params->cbSize != sizeof(*params))
+    {
+        SetLastError(ERROR_INVALID_USER_BUFFER);
+        return FALSE;
+    }
+    if (!(driver = get_driver_param(devinfo, device_data, driver_data))) return FALSE;
+
+    params->Rank = driver->rank;
+    params->Flags = driver->flags | DNF_COMPATIBLE_DRIVER;
+    params->PrivateData = driver->private_data;
+    params->Reserved = 0;
+    return TRUE;
+}
+
+/***********************************************************************
+ *              SetupDiGetDriverInstallParamsA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiGetDriverInstallParamsA(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data,
+        SP_DRVINFO_DATA_A *driver_data, SP_DRVINSTALL_PARAMS *params)
+{
+    /* the structures differ in their strings only; the driver is found by the Reserved member */
+    SP_DRVINFO_DATA_W w = {0};
+
+    if (driver_data)
+    {
+        w.cbSize = sizeof(w);
+        w.Reserved = driver_data->Reserved;
+        if (driver_data->cbSize != sizeof(*driver_data) && driver_data->cbSize != sizeof(SP_DRVINFO_DATA_V1_A))
+        {
+            SetLastError(ERROR_INVALID_USER_BUFFER);
+            return FALSE;
+        }
+    }
+    return SetupDiGetDriverInstallParamsW(devinfo, device_data, driver_data ? &w : NULL, params);
+}
+
+/***********************************************************************
+ *              SetupDiSetDriverInstallParamsW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiSetDriverInstallParamsW(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data,
+        SP_DRVINFO_DATA_W *driver_data, SP_DRVINSTALL_PARAMS *params)
+{
+    struct driver *driver;
+
+    TRACE("devinfo %p, device_data %p, driver_data %p, params %p.\n", devinfo, device_data, driver_data, params);
+
+    if (!params || params->cbSize != sizeof(*params))
+    {
+        SetLastError(ERROR_INVALID_USER_BUFFER);
+        return FALSE;
+    }
+    if (!(driver = get_driver_param(devinfo, device_data, driver_data))) return FALSE;
+
+#ifndef SG_MUTANT_SUDI_NOSET
+    driver->rank = params->Rank;
+#endif
+    driver->flags = params->Flags & ~DNF_COMPATIBLE_DRIVER;
+    driver->private_data = params->PrivateData;
+    return TRUE;
+}
+
+/***********************************************************************
+ *              SetupDiSetDriverInstallParamsA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiSetDriverInstallParamsA(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data,
+        SP_DRVINFO_DATA_A *driver_data, SP_DRVINSTALL_PARAMS *params)
+{
+    SP_DRVINFO_DATA_W w = {0};
+
+    if (driver_data)
+    {
+        w.cbSize = sizeof(w);
+        w.Reserved = driver_data->Reserved;
+        if (driver_data->cbSize != sizeof(*driver_data) && driver_data->cbSize != sizeof(SP_DRVINFO_DATA_V1_A))
+        {
+            SetLastError(ERROR_INVALID_USER_BUFFER);
+            return FALSE;
+        }
+    }
+    return SetupDiSetDriverInstallParamsW(devinfo, device_data, driver_data ? &w : NULL, params);
+}
+
 /***********************************************************************
  *              SetupDiInstallDevice (SETUPAPI.@)
  */
@@ -7011,6 +7220,7 @@ BOOL WINAPI SetupDiInstallDevice(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data)
     RegSetValueExW(driver_key, infsectionW, 0, REG_SZ, (BYTE *)driver->section, lstrlenW(driver->section) * sizeof(WCHAR));
     if (extptr)
         RegSetValueExW(driver_key, infsectionextW, 0, REG_SZ, (BYTE *)extptr, lstrlenW(extptr) * sizeof(WCHAR));
+    write_driver_properties(driver_key, driver);
 
     RegCloseKey(device_key);
     RegCloseKey(driver_key);
