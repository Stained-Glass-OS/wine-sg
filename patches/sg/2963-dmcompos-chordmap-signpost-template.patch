+static void signpost_track_clear(IDirectMusicSignPostTrack *This)
+{
+    struct signpost_item *item, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(item, next, &This->items, struct signpost_item, entry)
+    {
+        list_remove(&item->entry);
+        free(item);
+    }
+}
+
+/* adds a signpost after those which are not later than it */
+static HRESULT signpost_track_insert(IDirectMusicSignPostTrack *This, const DMUS_IO_SIGNPOST *signpost)
+{
+    struct signpost_item *item, *new_item;
+
+    if (!(new_item = calloc(1, sizeof(*new_item)))) return E_OUTOFMEMORY;
+    new_item->signpost = *signpost;
+
+    LIST_FOR_EACH_ENTRY_REV(item, &This->items, struct signpost_item, entry)
+    {
+        if (item->signpost.mtTime > signpost->mtTime) continue;
+        list_add_after(&item->entry, &new_item->entry);
+        return S_OK;
+    }
+    list_add_head(&This->items, &new_item->entry);
+    return S_OK;
+}
+
+/* Copies the signposts of [start, end) of 'src', moved to 'shift' + (time - start). The signposts
+ * are points in time, none is carried over from before 'start'. */
+static HRESULT signpost_track_copy(IDirectMusicSignPostTrack *src, MUSIC_TIME start, MUSIC_TIME end,
+        MUSIC_TIME shift, IDirectMusicSignPostTrack *dst)
+{
+    struct signpost_item *item;
+    HRESULT hr;
+
+    LIST_FOR_EACH_ENTRY(item, &src->items, struct signpost_item, entry)
+    {
+        DMUS_IO_SIGNPOST signpost = item->signpost;
+
+        if (signpost.mtTime < start || signpost.mtTime >= end) continue;
+#ifdef SG_MUTANT_CLONE_SHIFT
+        signpost.mtTime += shift;
+#else
+        signpost.mtTime += shift - start;
+#endif
+        if (FAILED(hr = signpost_track_insert(dst, &signpost))) return hr;
+    }
+    return S_OK;
+}
