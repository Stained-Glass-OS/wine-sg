+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "dmcompos_private.h"
+#include "dmobject.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dmcompos);
+
+/* The template object is created by the class factory and offers IPersistStream only; the
+ * templates which the composer uses are segments. */
+struct template
+{
+    struct dmobject dmobj;  /* IPersistStream only */
+    IUnknown IUnknown_iface;
+    LONG ref;
+};
+
+static inline struct template *impl_from_IUnknown(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct template, IUnknown_iface);
+}
+
+static HRESULT WINAPI template_QueryInterface(IUnknown *iface, REFIID riid, void **ret_iface)
+{
+    struct template *This = impl_from_IUnknown(iface);
+
+    TRACE("(%p, %s, %p)\n", This, debugstr_dmguid(riid), ret_iface);
+
+    *ret_iface = NULL;
+
+    if (IsEqualIID(riid, &IID_IUnknown))
+        *ret_iface = &This->IUnknown_iface;
+    else if (IsEqualIID(riid, &IID_IPersistStream))
+        *ret_iface = &This->dmobj.IPersistStream_iface;
+    else {
+        WARN("(%p, %s, %p): not found\n", This, debugstr_dmguid(riid), ret_iface);
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*ret_iface);
+    return S_OK;
+}
+
+static ULONG WINAPI template_AddRef(IUnknown *iface)
+{
+    struct template *This = impl_from_IUnknown(iface);
+    LONG ref = InterlockedIncrement(&This->ref);
+
+    TRACE("(%p) ref=%ld\n", This, ref);
+
+    return ref;
+}
+
+static ULONG WINAPI template_Release(IUnknown *iface)
+{
+    struct template *This = impl_from_IUnknown(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    TRACE("(%p) ref=%ld\n", This, ref);
+
+    if (!ref) free(This);
+
+    return ref;
+}
+
+static const IUnknownVtbl template_vtbl =
+{
+    template_QueryInterface,
+    template_AddRef,
+    template_Release,
+};
+
+/* A template has no stream format of its own. */
+static HRESULT WINAPI template_persist_stream_Load(IPersistStream *iface, IStream *stream)
+{
+    TRACE("(%p, %p): method not implemented\n", iface, stream);
+    return E_NOTIMPL;
+}
+
+static const IPersistStreamVtbl template_persist_stream_vtbl =
+{
+    dmobj_IPersistStream_QueryInterface,
+    dmobj_IPersistStream_AddRef,
+    dmobj_IPersistStream_Release,
+    dmobj_IPersistStream_GetClassID,
+    unimpl_IPersistStream_IsDirty,
+    template_persist_stream_Load,
+    unimpl_IPersistStream_Save,
+    unimpl_IPersistStream_GetSizeMax,
+};
+
+/* for ClassFactory */
+HRESULT create_dmtemplate(REFIID riid, void **ret_iface)
+{
+    struct template *obj;
+    HRESULT hr;
+
+    *ret_iface = NULL;
+    if (!(obj = calloc(1, sizeof(*obj)))) return E_OUTOFMEMORY;
+    obj->IUnknown_iface.lpVtbl = &template_vtbl;
+    obj->ref = 1;
+    dmobject_init(&obj->dmobj, &CLSID_DirectMusicTemplate, &obj->IUnknown_iface);
+    obj->dmobj.IPersistStream_iface.lpVtbl = &template_persist_stream_vtbl;
+
+    hr = IUnknown_QueryInterface(&obj->IUnknown_iface, riid, ret_iface);
+    IUnknown_Release(&obj->IUnknown_iface);
+
+    return hr;
+}
