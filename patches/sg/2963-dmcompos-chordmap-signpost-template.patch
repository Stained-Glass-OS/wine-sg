+
 typedef struct IDirectMusicChordMapTrack {
     IDirectMusicTrack8 IDirectMusicTrack8_iface;
     struct dmobject dmobj;  /* IPersistStream only */
     LONG ref;
+    struct list items;      /* struct chordmap_item, sorted by time */
 } IDirectMusicChordMapTrack;
 
+/* what InitPlay keeps for the extended methods */
+struct chordmap_play_state
+{
+    IDirectMusicPerformance *performance;   /* not referenced */
+};
+
 /* IDirectMusicChordMapTrack IDirectMusicTrack8 part: */
 static inline IDirectMusicChordMapTrack *impl_from_IDirectMusicTrack8(IDirectMusicTrack8 *iface)
 {
     return CONTAINING_RECORD(iface, IDirectMusicChordMapTrack, IDirectMusicTrack8_iface);
 }
 
+static void chordmap_track_clear(IDirectMusicChordMapTrack *This)
+{
+    struct chordmap_item *item, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(item, next, &This->items, struct chordmap_item, entry)
+    {
+        list_remove(&item->entry);
+        IDirectMusicChordMap_Release(item->chordmap);
+        free(item);
+    }
+}
+
+/* Adds a reference to the chord map at the time; a chord map at the same time is replaced. */
+static HRESULT chordmap_track_insert(IDirectMusicChordMapTrack *This, MUSIC_TIME time,
+        IDirectMusicChordMap *chordmap)
+{
+    struct chordmap_item *item, *new_item;
+
+    LIST_FOR_EACH_ENTRY(item, &This->items, struct chordmap_item, entry)
+    {
+        if (item->time != time) continue;
+        IDirectMusicChordMap_AddRef(chordmap);
+        IDirectMusicChordMap_Release(item->chordmap);
+        item->chordmap = chordmap;
+        return S_OK;
+    }
+
+    if (!(new_item = calloc(1, sizeof(*new_item)))) return E_OUTOFMEMORY;
+    new_item->time = time;
+    new_item->chordmap = chordmap;
+    IDirectMusicChordMap_AddRef(chordmap);
+
+    LIST_FOR_EACH_ENTRY_REV(item, &This->items, struct chordmap_item, entry)
+    {
+        if (item->time > time) continue;
+        list_add_after(&item->entry, &new_item->entry);
+        return S_OK;
+    }
+    list_add_head(&This->items, &new_item->entry);
+    return S_OK;
+}
+
+/* Copies the chord maps of [start, end) of 'src', moved to 'shift' + (time - start); the chord
+ * map in effect at start comes first. */
+static HRESULT chordmap_track_copy(IDirectMusicChordMapTrack *src, MUSIC_TIME start,
+        MUSIC_TIME end, MUSIC_TIME shift, IDirectMusicChordMapTrack *dst)
+{
+    struct chordmap_item *item, *before = NULL;
+    BOOL at_start = FALSE;
+    HRESULT hr;
+
+    LIST_FOR_EACH_ENTRY(item, &src->items, struct chordmap_item, entry)
+    {
+        if (item->time < start) before = item;
+        if (item->time == start) at_start = TRUE;
+    }
+    if (before && start > 0 && !at_start)
+        if (FAILED(hr = chordmap_track_insert(dst, shift, before->chordmap))) return hr;
+
+    LIST_FOR_EACH_ENTRY(item, &src->items, struct chordmap_item, entry)
+    {
+        if (item->time < start || item->time >= end) continue;
+#ifdef SG_MUTANT_CLONE_SHIFT
+        hr = chordmap_track_insert(dst, item->time + shift, item->chordmap);
+#else
+        hr = chordmap_track_insert(dst, item->time + shift - start, item->chordmap);
+#endif
+        if (FAILED(hr)) return hr;
+    }
+    return S_OK;
+}
