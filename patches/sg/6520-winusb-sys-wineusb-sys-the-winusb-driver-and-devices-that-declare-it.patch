index 0000000..c052c25
--- /dev/null
+++ b/dlls/winusb.sys/winusb.c
@@ -0,0 +1,683 @@
+/*
+ * winusb.sys: the WinUSB function driver
+ *
+ * A function driver over a USB device or interface (wineusb's PDO) that a device declares for
+ * WinUSB (its Microsoft OS descriptors' compatible ID "WINUSB": winusb.inf matches
+ * USB\MS_COMP_WINUSB), or that an administrator listed. It registers the device interfaces the
+ * device names (DeviceInterfaceGUIDs in its Device Parameters key) and serves winusb.dll's
+ * private IOCTLs (wine/winusb_ioctl.h) with URBs to the PDO: descriptors, control transfers,
+ * bulk and interrupt transfers (asynchronous), pipe resets and aborts, alternate settings.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
