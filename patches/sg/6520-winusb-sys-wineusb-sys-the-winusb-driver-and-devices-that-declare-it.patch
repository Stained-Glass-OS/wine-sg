index fc71e11..c6b133f 100644
--- a/dlls/wineusb.sys/unixlib.c
+++ b/dlls/wineusb.sys/unixlib.c
@@ -156,6 +156,187 @@ static bool get_event(struct usb_event *event)
     return true;
