@@ -386,8 +580,46 @@ struct transfer_ctx
     void *transfer_buffer;
 };
 
+/* Stained Glass OS (wine-sg 6520): the transfers in flight, so that a cancel (an IRP's cancel
+ * routine, ABORT_PIPE) never reaches one that has completed and been freed */
+static pthread_mutex_t transfers_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct libusb_transfer **transfers;
+static size_t transfer_count, transfers_capacity;
+
+static void track_transfer(struct libusb_transfer *transfer, bool add)
+{
+    size_t i;
+
+    pthread_mutex_lock(&transfers_mutex);
+    if (add)
+    {
+        if (array_reserve((void **)&transfers, &transfers_capacity, transfer_count + 1, sizeof(*transfers)))
+            transfers[transfer_count++] = transfer;
+    }
+    else
+    {
+        for (i = 0; i < transfer_count; i++)
+            if (transfers[i] == transfer)
+            {
+                transfers[i] = transfers[--transfer_count];
+                break;
+            }
+    }
+    pthread_mutex_unlock(&transfers_mutex);
+}
+
+static int submit_tracked(struct libusb_transfer *transfer)
+{
+    int ret;
+
+    track_transfer(transfer, true);
+    if ((ret = libusb_submit_transfer(transfer)) < 0) track_transfer(transfer, false);
+    return ret;
+}
+
 static void LIBUSB_CALL transfer_cb(struct libusb_transfer *transfer)
 {
+    track_transfer(transfer, false);
     struct transfer_ctx *transfer_ctx = transfer->user_data;
     IRP *irp = transfer_ctx->irp;
     URB *urb = IoGetCurrentIrpStackLocation(irp)->Parameters.Others.Argument1;
@@ -427,6 +659,49 @@ static void LIBUSB_CALL transfer_cb(struct libusb_transfer *transfer)
                 break;
             }
 
+            /* Stained Glass OS (wine-sg 6520): the control requests of any kind */
+            case URB_FUNCTION_CONTROL_TRANSFER:
+            {
+                struct _URB_CONTROL_TRANSFER *req = &urb->UrbControlTransfer;
+                req->TransferBufferLength = transfer->actual_length;
+                if (req->SetupPacket[0] & 0x80)
+                    memcpy(transfer_buffer, libusb_control_transfer_get_data(transfer), transfer->actual_length);
+                break;
+            }
+
+            case URB_FUNCTION_VENDOR_ENDPOINT:
+            case URB_FUNCTION_VENDOR_OTHER:
+            case URB_FUNCTION_CLASS_ENDPOINT:
+            case URB_FUNCTION_CLASS_OTHER:
