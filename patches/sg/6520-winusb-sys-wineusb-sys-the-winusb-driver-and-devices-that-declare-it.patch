 }
 
+/* Stained Glass OS (wine-sg 6520): a control request on the default pipe, completed by
+ * transfer_cb; the data of an OUT request is the transfer buffer's */
+static NTSTATUS submit_control(const struct usb_submit_urb_params *params, uint8_t request_type, uint8_t request,
+                               uint16_t value, uint16_t index, uint16_t length)
+{
+    IRP *irp = params->irp;
+    URB *urb = IoGetCurrentIrpStackLocation(irp)->Parameters.Others.Argument1;
+    struct transfer_ctx *transfer_ctx;
+    struct libusb_transfer *transfer;
+    unsigned char *buffer;
+    int ret;
+
+    /* a request to an interface of the device: the interface claimed first */
+    if ((request_type & 0x1f) == LIBUSB_RECIPIENT_INTERFACE && (ret = claim_interface(params->device)) < 0)
+    {
+        urb->UrbHeader.Status = USBD_STATUS_REQUEST_FAILED;
+        return status_from_libusb(ret);
+    }
+    if (!(transfer_ctx = calloc(1, sizeof(*transfer_ctx))))
+        return STATUS_NO_MEMORY;
+    transfer_ctx->irp = irp;
+    transfer_ctx->transfer_buffer = params->transfer_buffer;
+    if (!(transfer = libusb_alloc_transfer(0)))
+    {
+        free(transfer_ctx);
+        return STATUS_NO_MEMORY;
+    }
+    if (!(buffer = malloc(LIBUSB_CONTROL_SETUP_SIZE + length)))
+    {
+        free(transfer_ctx);
+        libusb_free_transfer(transfer);
+        return STATUS_NO_MEMORY;
+    }
+    irp->Tail.Overlay.DriverContext[0] = transfer;
+    libusb_fill_control_setup(buffer, request_type, request, value, index, length);
+    if (!(request_type & LIBUSB_ENDPOINT_IN) && length)
+        memcpy(buffer + LIBUSB_CONTROL_SETUP_SIZE, params->transfer_buffer, length);
+    libusb_fill_control_transfer(transfer, params->device->handle, buffer, transfer_cb, transfer_ctx, 0);
+    transfer->flags = LIBUSB_TRANSFER_FREE_BUFFER | LIBUSB_TRANSFER_FREE_TRANSFER;
+    TRACE("control %02x %02x %04x %04x, %u bytes\n", request_type, request, value, index, length);
+    if ((ret = submit_tracked(transfer)) < 0)
+    {
+        ERR("Failed to submit control transfer: %s\n", libusb_strerror(ret));
+        irp->Tail.Overlay.DriverContext[0] = NULL;
+        free(transfer_ctx);
+        libusb_free_transfer(transfer);
+        urb->UrbHeader.Status = USBD_STATUS_REQUEST_FAILED;
+        return status_from_libusb(ret);
+    }
+    return STATUS_PENDING;
+}
+
+/* the recipient of a *_TO_* / *_FROM_* URB function */
+static uint8_t recipient_of(USHORT function)
+{
+    switch (function)
+    {
+    case URB_FUNCTION_SET_FEATURE_TO_INTERFACE:
+    case URB_FUNCTION_CLEAR_FEATURE_TO_INTERFACE:
+    case URB_FUNCTION_GET_STATUS_FROM_INTERFACE:
+    case URB_FUNCTION_VENDOR_INTERFACE:
+    case URB_FUNCTION_CLASS_INTERFACE:
+        return LIBUSB_RECIPIENT_INTERFACE;
+    case URB_FUNCTION_SET_FEATURE_TO_ENDPOINT:
+    case URB_FUNCTION_CLEAR_FEATURE_TO_ENDPOINT:
+    case URB_FUNCTION_GET_STATUS_FROM_ENDPOINT:
+    case URB_FUNCTION_VENDOR_ENDPOINT:
+    case URB_FUNCTION_CLASS_ENDPOINT:
+        return LIBUSB_RECIPIENT_ENDPOINT;
+    case URB_FUNCTION_SET_FEATURE_TO_OTHER:
+    case URB_FUNCTION_CLEAR_FEATURE_TO_OTHER:
+    case URB_FUNCTION_GET_STATUS_FROM_OTHER:
+    case URB_FUNCTION_VENDOR_OTHER:
+    case URB_FUNCTION_CLASS_OTHER:
+        return LIBUSB_RECIPIENT_OTHER;
+    }
+    return LIBUSB_RECIPIENT_DEVICE;
+}
