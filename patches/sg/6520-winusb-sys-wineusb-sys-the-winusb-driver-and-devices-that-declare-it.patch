+            if (ms_os) apply_ms_os(ms_os, &usb_event.u.added_device, iface_desc->bInterfaceNumber);
+            if (ms_os && !usb_event.u.added_device.winusb) apply_ms_os(ms_os, &usb_event.u.added_device, -1);
         }
         queue_event(&usb_event);
 
@@ -262,9 +454,11 @@ static void add_usb_device(libusb_device *libusb_device)
                 usb_event.u.added_device.protocol = iface_desc->bInterfaceProtocol;
                 usb_event.u.added_device.interface = true;
                 usb_event.u.added_device.interface_index = iface_desc->bInterfaceNumber;
+                if (ms_os) apply_ms_os(ms_os, &usb_event.u.added_device, iface_desc->bInterfaceNumber);
                 queue_event(&usb_event);
