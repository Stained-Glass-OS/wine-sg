+        case URB_FUNCTION_VENDOR_ENDPOINT:
+        case URB_FUNCTION_VENDOR_OTHER:
+        case URB_FUNCTION_CLASS_ENDPOINT:
+        case URB_FUNCTION_CLASS_OTHER:
+        {
+            struct _URB_CONTROL_VENDOR_OR_CLASS_REQUEST *req = &urb->UrbControlVendorClassRequest;
+            uint8_t type = (urb->UrbHeader.Function == URB_FUNCTION_CLASS_ENDPOINT || urb->UrbHeader.Function == URB_FUNCTION_CLASS_OTHER)
+                           ? LIBUSB_REQUEST_TYPE_CLASS : LIBUSB_REQUEST_TYPE_VENDOR;
