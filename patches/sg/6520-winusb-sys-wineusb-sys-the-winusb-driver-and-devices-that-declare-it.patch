+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "winioctl.h"
+#include "ddk/wdm.h"
+#include "ddk/ntifs.h"
+#include "ddk/usb.h"
+#include "ddk/usbioctl.h"
+#include "ddk/usbdlib.h"
+#include "wine/winusb_ioctl.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(winusb);
+
+#define MAX_PIPES 32
+
+/* a pending transfer's URB IRP stays known while its cancel may reach it */
+static CRITICAL_SECTION transfer_cs;
+static CRITICAL_SECTION_DEBUG transfer_cs_debug =
+{
+    0, 0, &transfer_cs,
+    { &transfer_cs_debug.ProcessLocksList, &transfer_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": transfer_cs") }
+};
+static CRITICAL_SECTION transfer_cs = { &transfer_cs_debug, -1, 0, 0, 0, 0 };
+#define MAX_TRANSFER (4 * 1024 * 1024)
+
+struct winusb
+{
+    DEVICE_OBJECT *fdo, *pdo, *next;
+    BOOL started;
+    USB_DEVICE_DESCRIPTOR device_desc;
+    USB_CONFIGURATION_DESCRIPTOR *config;
+    USBD_CONFIGURATION_HANDLE config_handle;
+    UCHAR interface_number;
+    USBD_PIPE_INFORMATION pipes[MAX_PIPES];
+    ULONG pipe_count;
+    UNICODE_STRING interfaces[4];
+    ULONG interface_count;
+};
+
+static NTSTATUS WINAPI sync_completion(DEVICE_OBJECT *device, IRP *irp, void *context)
+{
+    if (irp->PendingReturned) KeSetEvent(context, IO_NO_INCREMENT, FALSE);
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+/* an URB to the USB device, waited for */
+static NTSTATUS submit_urb_sync(struct winusb *dev, URB *urb)
+{
+    IO_STACK_LOCATION *stack;
+    NTSTATUS status;
+    KEVENT event;
+    IRP *irp;
+
+    if (!(irp = IoAllocateIrp(dev->next->StackSize, FALSE))) return STATUS_NO_MEMORY;
+    KeInitializeEvent(&event, NotificationEvent, FALSE);
+    stack = IoGetNextIrpStackLocation(irp);
+    stack->MajorFunction = IRP_MJ_INTERNAL_DEVICE_CONTROL;
+    stack->Parameters.DeviceIoControl.IoControlCode = IOCTL_INTERNAL_USB_SUBMIT_URB;
+    stack->Parameters.Others.Argument1 = urb;
+    IoSetCompletionRoutine(irp, sync_completion, &event, TRUE, TRUE, TRUE);
+    if (IoCallDriver(dev->next, irp) == STATUS_PENDING)
+        KeWaitForSingleObject(&event, Executive, KernelMode, FALSE, NULL);
+    status = irp->IoStatus.Status;
+    IoFreeIrp(irp);
+    if (!status && !USBD_SUCCESS(urb->UrbHeader.Status)) status = STATUS_UNSUCCESSFUL;
+    return status;
+}
+
+/* the program's IRP waits on an URB of its own */
+struct transfer
+{
+    IRP *irp;
+    BOOL in;
+    void *buffer;       /* the bytes moved (IN: copied to the program's buffer) */
+    URB urb;
+};
+
+static NTSTATUS WINAPI transfer_completion(DEVICE_OBJECT *device, IRP *usb_irp, void *context)
+{
+    struct transfer *transfer = context;
+    IRP *irp = transfer->irp;
+    ULONG length = 0;
+
+    IoSetCancelRoutine(irp, NULL);
+    EnterCriticalSection(&transfer_cs);
+    irp->Tail.Overlay.DriverContext[0] = NULL;
+    LeaveCriticalSection(&transfer_cs);
+
+    irp->IoStatus.Status = usb_irp->IoStatus.Status;
+    if (!irp->IoStatus.Status && !USBD_SUCCESS(transfer->urb.UrbHeader.Status))
+        irp->IoStatus.Status = transfer->urb.UrbHeader.Status == USBD_STATUS_STALL_PID ? STATUS_DEVICE_DATA_ERROR
+                                                                                        : STATUS_UNSUCCESSFUL;
+    if (!irp->IoStatus.Status)
+    {
+        if (transfer->urb.UrbHeader.Function == URB_FUNCTION_CONTROL_TRANSFER)
+            length = transfer->urb.UrbControlTransfer.TransferBufferLength;
+        else
+            length = transfer->urb.UrbBulkOrInterruptTransfer.TransferBufferLength;
+        if (transfer->in && length) memcpy(irp->AssociatedIrp.SystemBuffer, transfer->buffer, length);
+    }
+    irp->IoStatus.Information = length;
+    TRACE("irp %p: %#lx (usbd %#lx), %lu bytes.\n", irp, irp->IoStatus.Status, transfer->urb.UrbHeader.Status, length);
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    ExFreePool(transfer->buffer);
+    ExFreePool(transfer);
+    IoFreeIrp(usb_irp);
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+static void WINAPI cancel_transfer(DEVICE_OBJECT *device, IRP *irp)
+{
+    IRP *usb_irp;
+
+    IoReleaseCancelSpinLock(irp->CancelIrql);
+    EnterCriticalSection(&transfer_cs);
+    usb_irp = irp->Tail.Overlay.DriverContext[0];
+    TRACE("irp %p, usb irp %p\n", irp, usb_irp);
+    /* wineusb cancels the libusb transfer; it completes as cancelled */
+    if (usb_irp) IoCancelIrp(usb_irp);
+    LeaveCriticalSection(&transfer_cs);
+}
+
+/* an URB for the program's IRP, which pends on it */
+static NTSTATUS start_transfer(struct winusb *dev, IRP *irp, struct transfer *transfer)
+{
+    IO_STACK_LOCATION *stack;
+    IRP *usb_irp;
+
+    if (!(usb_irp = IoAllocateIrp(dev->next->StackSize, FALSE)))
+    {
+        ExFreePool(transfer->buffer);
+        ExFreePool(transfer);
+        return STATUS_NO_MEMORY;
+    }
+    transfer->irp = irp;
+    stack = IoGetNextIrpStackLocation(usb_irp);
+    stack->MajorFunction = IRP_MJ_INTERNAL_DEVICE_CONTROL;
+    stack->Parameters.DeviceIoControl.IoControlCode = IOCTL_INTERNAL_USB_SUBMIT_URB;
+    stack->Parameters.Others.Argument1 = &transfer->urb;
+    IoSetCompletionRoutine(usb_irp, transfer_completion, transfer, TRUE, TRUE, TRUE);
+
+    IoMarkIrpPending(irp);
+    EnterCriticalSection(&transfer_cs);
+    irp->Tail.Overlay.DriverContext[0] = usb_irp;
+    LeaveCriticalSection(&transfer_cs);
+    IoSetCancelRoutine(irp, cancel_transfer);
+    IoCallDriver(dev->next, usb_irp);
+    return STATUS_PENDING;
+}
+
+static USBD_PIPE_INFORMATION *find_pipe(struct winusb *dev, UCHAR address)
+{
+    ULONG i;
+    for (i = 0; i < dev->pipe_count; i++)
+        if (dev->pipes[i].EndpointAddress == address) return &dev->pipes[i];
+    return NULL;
+}
+
+static NTSTATUS get_descriptor(struct winusb *dev, UCHAR type, UCHAR index, USHORT lang, void *buffer, ULONG *length)
+{
+    struct _URB_CONTROL_DESCRIPTOR_REQUEST urb = {{0}};
+    NTSTATUS status;
+
+    urb.Hdr.Function = URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE;
+    urb.Hdr.Length = sizeof(urb);
+    urb.TransferBuffer = buffer;
+    urb.TransferBufferLength = *length;
+    urb.DescriptorType = type;
+    urb.Index = index;
+    urb.LanguageId = lang;
+    status = submit_urb_sync(dev, (URB *)&urb);
+    *length = urb.TransferBufferLength;
+    return status;
+}
+
+static NTSTATUS pipe_request(struct winusb *dev, UCHAR address, USHORT function)
+{
+    struct _URB_PIPE_REQUEST urb = {{0}};
+    USBD_PIPE_INFORMATION *pipe;
+
+    if (!(pipe = find_pipe(dev, address))) return STATUS_INVALID_PARAMETER;
+    urb.Hdr.Function = function;
+    urb.Hdr.Length = sizeof(urb);
+    urb.PipeHandle = pipe->PipeHandle;
+    return submit_urb_sync(dev, (URB *)&urb);
+}
+
+/* the pipes of an interface's setting, from a select request's answer */
+static void set_pipes(struct winusb *dev, const USBD_INTERFACE_INFORMATION *info)
+{
+    ULONG i;
+
+    dev->pipe_count = min(info->NumberOfPipes, MAX_PIPES);
+    for (i = 0; i < dev->pipe_count; i++) dev->pipes[i] = info->Pipes[i];
+    TRACE("interface %u setting %u: %lu pipes\n", info->InterfaceNumber, info->AlternateSetting, dev->pipe_count);
+}
+
+static NTSTATUS select_alternate(struct winusb *dev, UCHAR number, UCHAR setting)
+{
+    USB_INTERFACE_DESCRIPTOR *desc;
+    ULONG size, pipes;
+    NTSTATUS status;
+    URB *urb;
+
+    if (!(desc = USBD_ParseConfigurationDescriptorEx(dev->config, dev->config, number, setting, -1, -1, -1)))
+        return STATUS_INVALID_PARAMETER;
+    pipes = desc->bNumEndpoints;
+    size = offsetof(struct _URB_SELECT_INTERFACE, Interface.Pipes[max(pipes, 1)]);
+    if (!(urb = ExAllocatePool(NonPagedPool, size))) return STATUS_NO_MEMORY;
+    memset(urb, 0, size);
+    urb->UrbHeader.Function = URB_FUNCTION_SELECT_INTERFACE;
+    urb->UrbHeader.Length = size;
+    urb->UrbSelectInterface.ConfigurationHandle = dev->config_handle;
+    urb->UrbSelectInterface.Interface.Length = size - offsetof(struct _URB_SELECT_INTERFACE, Interface);
+    urb->UrbSelectInterface.Interface.InterfaceNumber = number;
+    urb->UrbSelectInterface.Interface.AlternateSetting = setting;
+    urb->UrbSelectInterface.Interface.NumberOfPipes = pipes;
+    if (!(status = submit_urb_sync(dev, urb)))
+        set_pipes(dev, &urb->UrbSelectInterface.Interface);
+    ExFreePool(urb);
+    return status;
+}
+
+static NTSTATUS device_ioctl(struct winusb *dev, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG code = stack->Parameters.DeviceIoControl.IoControlCode;
+    ULONG in_size = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_size = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    void *buffer = irp->AssociatedIrp.SystemBuffer;
+    struct transfer *transfer;
+    NTSTATUS status;
+
+    TRACE("code %#lx, in %lu, out %lu.\n", code, in_size, out_size);
+    irp->IoStatus.Information = 0;
+
+    switch (code)
+    {
+    case IOCTL_WINE_WINUSB_GET_INFO:
+    {
+        struct wine_winusb_info info = {0};
+
+        if (out_size < sizeof(info)) return STATUS_BUFFER_TOO_SMALL;
+        /* the speed by the USB version the device reports (the hub's view is not known here) */
+        info.speed = dev->device_desc.bcdUSB >= 0x200 ? 3 /* HighSpeed */ : 2 /* FullSpeed */;
+        info.first_interface = dev->interface_number;
+        info.interface_count = 1;
+        info.config_size = dev->config->wTotalLength;
+        memcpy(buffer, &info, sizeof(info));
+        irp->IoStatus.Information = sizeof(info);
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_WINE_WINUSB_GET_CONFIG:
+    {
+        ULONG size = min(out_size, dev->config->wTotalLength);
+
+        memcpy(buffer, dev->config, size);
+        irp->IoStatus.Information = size;
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_WINE_WINUSB_GET_DESCRIPTOR:
+    {
+        struct wine_winusb_descriptor_request req;
+        ULONG length = out_size;
+        void *data;
+
+        if (in_size < sizeof(req)) return STATUS_INVALID_PARAMETER;
+        memcpy(&req, buffer, sizeof(req));
+        if (!(data = ExAllocatePool(NonPagedPool, max(length, 1)))) return STATUS_NO_MEMORY;
+        if (!(status = get_descriptor(dev, req.type, req.index, req.language, data, &length)))
+        {
+            memcpy(buffer, data, min(length, out_size));
+            irp->IoStatus.Information = min(length, out_size);
+        }
+        ExFreePool(data);
+        return status;
+    }
+
+    case IOCTL_WINE_WINUSB_CONTROL:
+    {
+        struct wine_winusb_control req;
+        USHORT length;
+        BOOL in;
+
+        if (in_size < sizeof(req)) return STATUS_INVALID_PARAMETER;
+        memcpy(&req, buffer, sizeof(req));
+        in = !!(req.setup[0] & 0x80);
+        length = req.setup[6] | (req.setup[7] << 8);
+        if (in ? out_size < length : in_size < sizeof(req) + length) return STATUS_INVALID_PARAMETER;
+        if (!(transfer = ExAllocatePool(NonPagedPool, sizeof(*transfer)))) return STATUS_NO_MEMORY;
+        memset(transfer, 0, sizeof(*transfer));
+        if (!(transfer->buffer = ExAllocatePool(NonPagedPool, max(length, 1))))
+        {
+            ExFreePool(transfer);
+            return STATUS_NO_MEMORY;
+        }
+        if (!in && length) memcpy(transfer->buffer, (BYTE *)buffer + sizeof(req), length);
+        transfer->in = in;
+        transfer->urb.UrbHeader.Function = URB_FUNCTION_CONTROL_TRANSFER;
+        transfer->urb.UrbHeader.Length = sizeof(struct _URB_CONTROL_TRANSFER);
+        transfer->urb.UrbControlTransfer.TransferFlags = in ? USBD_TRANSFER_DIRECTION_IN | USBD_SHORT_TRANSFER_OK : 0;
+        transfer->urb.UrbControlTransfer.TransferBuffer = transfer->buffer;
+        transfer->urb.UrbControlTransfer.TransferBufferLength = length;
+        memcpy(transfer->urb.UrbControlTransfer.SetupPacket, req.setup, 8);
+        TRACE("control %02x %02x %02x%02x %02x%02x, %u bytes\n", req.setup[0], req.setup[1], req.setup[3], req.setup[2],
+              req.setup[5], req.setup[4], length);
+        return start_transfer(dev, irp, transfer);
+    }
+
+    case IOCTL_WINE_WINUSB_READ_PIPE:
+    case IOCTL_WINE_WINUSB_WRITE_PIPE:
+    {
+        BOOL read = code == IOCTL_WINE_WINUSB_READ_PIPE;
+        struct wine_winusb_pipe_request req;
+        USBD_PIPE_INFORMATION *pipe;
+        ULONG length;
+
+        if (in_size < sizeof(req)) return STATUS_INVALID_PARAMETER;
+        memcpy(&req, buffer, sizeof(req));
+        if (!(pipe = find_pipe(dev, req.pipe)) || (pipe->PipeType != UsbdPipeTypeBulk && pipe->PipeType != UsbdPipeTypeInterrupt))
+            return STATUS_INVALID_PARAMETER;
+        length = read ? out_size : in_size - sizeof(req);
+        if (length > MAX_TRANSFER) return STATUS_INVALID_PARAMETER;
+        if (!(transfer = ExAllocatePool(NonPagedPool, sizeof(*transfer)))) return STATUS_NO_MEMORY;
+        memset(transfer, 0, sizeof(*transfer));
+        if (!(transfer->buffer = ExAllocatePool(NonPagedPool, max(length, 1))))
+        {
+            ExFreePool(transfer);
+            return STATUS_NO_MEMORY;
+        }
+        if (!read && length) memcpy(transfer->buffer, (BYTE *)buffer + sizeof(req), length);
+        if (req.flags & WINE_WINUSB_SHORT_PACKET_TERMINATE)
+            FIXME("SHORT_PACKET_TERMINATE: no zero-length packet is sent\n");
+        transfer->in = read;
+        transfer->urb.UrbHeader.Function = URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER;
+        transfer->urb.UrbHeader.Length = sizeof(struct _URB_BULK_OR_INTERRUPT_TRANSFER);
+        transfer->urb.UrbBulkOrInterruptTransfer.PipeHandle = pipe->PipeHandle;
+        transfer->urb.UrbBulkOrInterruptTransfer.TransferFlags = read ? USBD_TRANSFER_DIRECTION_IN | USBD_SHORT_TRANSFER_OK : 0;
+        transfer->urb.UrbBulkOrInterruptTransfer.TransferBuffer = transfer->buffer;
+        transfer->urb.UrbBulkOrInterruptTransfer.TransferBufferLength = length;
+        TRACE("pipe %#x: %lu bytes %s\n", req.pipe, length, read ? "in" : "out");
+        return start_transfer(dev, irp, transfer);
+    }
+
+    case IOCTL_WINE_WINUSB_RESET_PIPE:
+    case IOCTL_WINE_WINUSB_ABORT_PIPE:
+    {
+        struct wine_winusb_pipe_request req;
+
+        if (in_size < sizeof(req)) return STATUS_INVALID_PARAMETER;
+        memcpy(&req, buffer, sizeof(req));
+        return pipe_request(dev, req.pipe, code == IOCTL_WINE_WINUSB_RESET_PIPE
+                            ? URB_FUNCTION_SYNC_RESET_PIPE_AND_CLEAR_STALL : URB_FUNCTION_ABORT_PIPE);
+    }
+
+    case IOCTL_WINE_WINUSB_SET_ALTERNATE:
+    {
+        struct wine_winusb_alternate req;
+
+        if (in_size < sizeof(req)) return STATUS_INVALID_PARAMETER;
+        memcpy(&req, buffer, sizeof(req));
+        if (req.interface != dev->interface_number) return STATUS_INVALID_PARAMETER;
+        return select_alternate(dev, req.interface, req.setting);
+    }
+    }
+
+    FIXME("unhandled ioctl %#lx\n", code);
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS WINAPI driver_ioctl(DEVICE_OBJECT *device, IRP *irp)
+{
+    struct winusb *dev = device->DeviceExtension;
+    NTSTATUS status = dev->started ? device_ioctl(dev, irp) : STATUS_DEVICE_NOT_READY;
+
+    if (status == STATUS_PENDING) return status;
+    irp->IoStatus.Status = status;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    return status;
+}
+
+static NTSTATUS WINAPI driver_create_close(DEVICE_OBJECT *device, IRP *irp)
+{
+    irp->IoStatus.Status = STATUS_SUCCESS;
+    irp->IoStatus.Information = 0;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    return STATUS_SUCCESS;
+}
+
+/* the interface this device object is: "&MI_xx" in its hardware IDs, or the configuration's first */
+static int pdo_interface(struct winusb *dev)
+{
+    WCHAR ids[512];
+    ULONG size;
+    const WCHAR *p;
+
+    if (!IoGetDeviceProperty(dev->pdo, DevicePropertyHardwareID, sizeof(ids), ids, &size))
+        for (p = ids; *p; p += wcslen(p) + 1)
+        {
+            const WCHAR *mi = wcsstr(p, L"&MI_");
+            if (mi)
+            {
+                int n = 0, i;
+                for (i = 4; i < 6; i++)
+                {
+                    WCHAR c = mi[i];
+                    n = n * 16 + (c >= '0' && c <= '9' ? c - '0' : (c | 0x20) - 'a' + 10);
+                }
+                return n;
+            }
+        }
+    return -1;
+}
+
+/* the device interfaces the device names (DeviceInterfaceGUIDs, or DeviceInterfaceGUID) */
+static void register_interfaces(struct winusb *dev)
+{
+    static const GUID usb_device = {0xa5dcbf10, 0x6530, 0x11d2, {0x90, 0x1f, 0x00, 0xc0, 0x4f, 0xb9, 0x51, 0xed}};
+    KEY_VALUE_PARTIAL_INFORMATION *info;
+    UNICODE_STRING name;
+    HANDLE key;
+    ULONG size;
+    BOOL any = FALSE;
+
+    if (!IoOpenDeviceRegistryKey(dev->pdo, PLUGPLAY_REGKEY_DEVICE, KEY_READ, &key))
+    {
+        static const WCHAR *const names[] = { L"DeviceInterfaceGUIDs", L"DeviceInterfaceGUID" };
+        unsigned int n;
+
+        if ((info = ExAllocatePool(PagedPool, 2048)))
+        {
+            for (n = 0; n < ARRAY_SIZE(names) && !any; n++)
+            {
+                const WCHAR *p;
+
+                RtlInitUnicodeString(&name, names[n]);
+                if (ZwQueryValueKey(key, &name, KeyValuePartialInformation, info, 2048, &size)) continue;
+                if (info->Type != REG_SZ && info->Type != REG_MULTI_SZ) continue;
+                for (p = (const WCHAR *)info->Data; *p && dev->interface_count < ARRAY_SIZE(dev->interfaces);
+                     p += wcslen(p) + 1)
+                {
+                    UNICODE_STRING string;
+                    GUID guid;
+
+                    RtlInitUnicodeString(&string, p);
+                    if (RtlGUIDFromString(&string, &guid)) continue;
+                    if (!IoRegisterDeviceInterface(dev->pdo, &guid, NULL, &dev->interfaces[dev->interface_count]))
+                    {
+                        IoSetDeviceInterfaceState(&dev->interfaces[dev->interface_count], TRUE);
+                        TRACE("interface %s\n", debugstr_w(dev->interfaces[dev->interface_count].Buffer));
+                        dev->interface_count++;
+                        any = TRUE;
+                    }
+                    if (info->Type == REG_SZ) break;
+                }
+            }
+            ExFreePool(info);
+        }
+        ZwClose(key);
+    }
+    /* the GUID the device's own descriptors (or the administrator's list) name */
+    if (!any)
+    {
+        WCHAR guid_string[40] = {0};
+        IO_STACK_LOCATION *stack;
+        KEVENT event;
+        IRP *irp;
+
+        if ((irp = IoAllocateIrp(dev->next->StackSize, FALSE)))
+        {
+            KeInitializeEvent(&event, NotificationEvent, FALSE);
+            stack = IoGetNextIrpStackLocation(irp);
+            stack->MajorFunction = IRP_MJ_INTERNAL_DEVICE_CONTROL;
+            stack->Parameters.DeviceIoControl.IoControlCode = IOCTL_WINE_WINEUSB_GET_INTERFACE_GUID;
+            stack->Parameters.Others.Argument1 = guid_string;
+            IoSetCompletionRoutine(irp, sync_completion, &event, TRUE, TRUE, TRUE);
+            if (IoCallDriver(dev->next, irp) == STATUS_PENDING)
+                KeWaitForSingleObject(&event, Executive, KernelMode, FALSE, NULL);
+            IoFreeIrp(irp);
+        }
+        guid_string[39] = 0;
+        if (guid_string[0] && dev->interface_count < ARRAY_SIZE(dev->interfaces))
+        {
+            UNICODE_STRING string;
+            GUID guid;
+
+            RtlInitUnicodeString(&string, guid_string);
+            if (!RtlGUIDFromString(&string, &guid) &&
+                !IoRegisterDeviceInterface(dev->pdo, &guid, NULL, &dev->interfaces[dev->interface_count]))
+            {
+                IoSetDeviceInterfaceState(&dev->interfaces[dev->interface_count], TRUE);
+                TRACE("the device's interface %s\n", debugstr_w(dev->interfaces[dev->interface_count].Buffer));
+                dev->interface_count++;
+                any = TRUE;
+            }
+        }
+    }
+    /* none named: programs find the device among the USB devices */
+    if (!any && dev->interface_count < ARRAY_SIZE(dev->interfaces) &&
+        !IoRegisterDeviceInterface(dev->pdo, &usb_device, NULL, &dev->interfaces[dev->interface_count]))
+    {
+        IoSetDeviceInterfaceState(&dev->interfaces[dev->interface_count], TRUE);
+        dev->interface_count++;
+    }
+}
+
+/* the descriptors, and the interface's first setting selected */
+static NTSTATUS start_device(struct winusb *dev)
+{
+    USB_CONFIGURATION_DESCRIPTOR header;
+    USBD_INTERFACE_LIST_ENTRY list[2] = {{0}};
+    USB_INTERFACE_DESCRIPTOR *iface;
+    NTSTATUS status;
+    ULONG length;
+    int number;
+    URB *urb;
+
+    length = sizeof(dev->device_desc);
+    if ((status = get_descriptor(dev, USB_DEVICE_DESCRIPTOR_TYPE, 0, 0, &dev->device_desc, &length))) return status;
+    length = sizeof(header);
+    if ((status = get_descriptor(dev, USB_CONFIGURATION_DESCRIPTOR_TYPE, 0, 0, &header, &length))) return status;
+    if (header.wTotalLength < sizeof(header)) return STATUS_DEVICE_CONFIGURATION_ERROR;
+    if (!(dev->config = ExAllocatePool(NonPagedPool, header.wTotalLength))) return STATUS_NO_MEMORY;
+    length = header.wTotalLength;
+    if ((status = get_descriptor(dev, USB_CONFIGURATION_DESCRIPTOR_TYPE, 0, 0, dev->config, &length))) return status;
+
+    number = pdo_interface(dev);
+    if (!(iface = USBD_ParseConfigurationDescriptorEx(dev->config, dev->config, number, 0, -1, -1, -1)))
+        return STATUS_DEVICE_CONFIGURATION_ERROR;
+    dev->interface_number = iface->bInterfaceNumber;
+    list[0].InterfaceDescriptor = iface;
+    if (!(urb = USBD_CreateConfigurationRequestEx(dev->config, list))) return STATUS_NO_MEMORY;
+    if (!(status = submit_urb_sync(dev, urb)))
+    {
+        dev->config_handle = urb->UrbSelectConfiguration.ConfigurationHandle;
+        set_pipes(dev, list[0].Interface);
+    }
+    ExFreePool(urb);
+    if (status) return status;
+
+    register_interfaces(dev);
+    TRACE("%04x:%04x interface %u: %lu pipes, %lu device interfaces\n", dev->device_desc.idVendor,
+          dev->device_desc.idProduct, dev->interface_number, dev->pipe_count, dev->interface_count);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS forward_sync(struct winusb *dev, IRP *irp)
+{
+    KEVENT event;
+
+    KeInitializeEvent(&event, NotificationEvent, FALSE);
+    IoCopyCurrentIrpStackLocationToNext(irp);
+    IoSetCompletionRoutine(irp, sync_completion, &event, TRUE, TRUE, TRUE);
+    if (IoCallDriver(dev->next, irp) == STATUS_PENDING)
+        KeWaitForSingleObject(&event, Executive, KernelMode, FALSE, NULL);
+    return irp->IoStatus.Status;
+}
+
+static void remove_interfaces(struct winusb *dev)
+{
+    ULONG i;
+
+    for (i = 0; i < dev->interface_count; i++)
+    {
+        IoSetDeviceInterfaceState(&dev->interfaces[i], FALSE);
+        RtlFreeUnicodeString(&dev->interfaces[i]);
+    }
+    dev->interface_count = 0;
+}
+
+static NTSTATUS WINAPI driver_pnp(DEVICE_OBJECT *device, IRP *irp)
+{
+    struct winusb *dev = device->DeviceExtension;
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    NTSTATUS status;
+
+    switch (stack->MinorFunction)
+    {
+    case IRP_MN_START_DEVICE:
+        if (!(status = forward_sync(dev, irp)))
+        {
+#ifndef SG_MUTANT_WINUSB_NOT_STARTED
+            if (!(status = start_device(dev))) dev->started = TRUE;
+            else ERR("the device could not be started: %#lx\n", status);
+#endif
+        }
+        irp->IoStatus.Status = status;
+        IoCompleteRequest(irp, IO_NO_INCREMENT);
+        return status;
+
+    case IRP_MN_SURPRISE_REMOVAL:
+        dev->started = FALSE;
+        remove_interfaces(dev);
+        break;
+
+    case IRP_MN_REMOVE_DEVICE:
+        dev->started = FALSE;
+        remove_interfaces(dev);
+        IoSkipCurrentIrpStackLocation(irp);
+        status = IoCallDriver(dev->next, irp);
+        IoDetachDevice(dev->next);
+        if (dev->config) ExFreePool(dev->config);
+        IoDeleteDevice(device);
+        return status;
+    }
+
+    IoSkipCurrentIrpStackLocation(irp);
+    return IoCallDriver(dev->next, irp);
+}
+
+static NTSTATUS WINAPI driver_add_device(DRIVER_OBJECT *driver, DEVICE_OBJECT *pdo)
+{
+    struct winusb *dev;
+    DEVICE_OBJECT *fdo;
+    NTSTATUS status;
+
+    if ((status = IoCreateDevice(driver, sizeof(*dev), NULL, FILE_DEVICE_UNKNOWN, 0, FALSE, &fdo)))
+    {
+        ERR("no device: %#lx\n", status);
+        return status;
+    }
+    dev = fdo->DeviceExtension;
+    memset(dev, 0, sizeof(*dev));
+    dev->fdo = fdo;
+    dev->pdo = pdo;
+    dev->next = IoAttachDeviceToDeviceStack(fdo, pdo);
+    fdo->Flags &= ~DO_DEVICE_INITIALIZING;
+    TRACE("pdo %p, fdo %p\n", pdo, fdo);
+    return STATUS_SUCCESS;
+}
+
+static void WINAPI driver_unload(DRIVER_OBJECT *driver)
+{
+}
+
+NTSTATUS WINAPI DriverEntry(DRIVER_OBJECT *driver, UNICODE_STRING *path)
+{
+    TRACE("driver %p, path %s.\n", driver, debugstr_w(path->Buffer));
+
+    driver->MajorFunction[IRP_MJ_CREATE] = driver_create_close;
+    driver->MajorFunction[IRP_MJ_CLOSE] = driver_create_close;
+    driver->MajorFunction[IRP_MJ_CLEANUP] = driver_create_close;
+    driver->MajorFunction[IRP_MJ_DEVICE_CONTROL] = driver_ioctl;
+    driver->MajorFunction[IRP_MJ_PNP] = driver_pnp;
+    driver->DriverExtension->AddDevice = driver_add_device;
+    driver->DriverUnload = driver_unload;
+    return STATUS_SUCCESS;
+}
diff --git a/dlls/winusb.sys/winusb.inf b/dlls/winusb.sys/winusb.inf
new file mode 100644
index 0000000..e8a9462
--- /dev/null
+++ b/dlls/winusb.sys/winusb.inf
@@ -0,0 +1,34 @@
+; WinUSB: the function driver for USB devices that declare it in their Microsoft OS
+; descriptors (compatible ID "WINUSB", which wineusb reports as USB\MS_COMP_WINUSB) or that an
+; administrator lists. Programs use the device through winusb.dll.
+; Stained Glass OS, our own.
+
+[Version]
+Signature="$WINDOWS NT$"
+Class=USBDevice
+ClassGuid={88bae032-5a81-49f0-bc3d-a4ff138216d6}
+Provider=%Wine%
+
+[Manufacturer]
+%Wine%=mfg_section
+
+[mfg_section]
+%Desc%=winusb_device,USB\MS_COMP_WINUSB
+
+[winusb_device]
+
+[winusb_device.Services]
+AddService = WinUSB,0x00000002,winusb_service
+
+[winusb_service]
+Description="WinUSB function driver"
+DisplayName="WinUSB"
+ServiceBinary="%12%\winusb.sys"
+LoadOrderGroup="WinePlugPlay"
+ServiceType=1
+StartType=3
+ErrorControl=1
+
+[Strings]
+Wine="Wine"
+Desc="WinUSB device"
