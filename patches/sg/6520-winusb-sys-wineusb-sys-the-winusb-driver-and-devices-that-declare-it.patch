+/* Stained Glass OS (wine-sg 6520): devices an administrator gives to WinUSB:
+ * HKLM\Software\Stained Glass\WinUSB\Devices, "VID_xxxx&PID_xxxx" (or with "&MI_xx") =
+ * "{device interface GUID}" (only an administrator may write HKLM) */
+static void winusb_admin_list(struct usb_device *device)
+{
+    static const WCHAR path[] = L"\\Registry\\Machine\\Software\\Stained Glass\\WinUSB\\Devices";
+    KEY_VALUE_PARTIAL_INFORMATION *info;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING string, name;
+    WCHAR id[32];
+    HANDLE key;
+    ULONG size;
+
+    RtlInitUnicodeString(&string, path);
+    InitializeObjectAttributes(&attr, &string, OBJ_CASE_INSENSITIVE | OBJ_KERNEL_HANDLE, NULL, NULL);
+    if (ZwOpenKey(&key, KEY_READ, &attr)) return;
+    if (device->interface)
+        swprintf(id, ARRAY_SIZE(id), L"VID_%04X&PID_%04X&MI_%02X", device->vendor, device->product, device->interface_index);
+    else
+        swprintf(id, ARRAY_SIZE(id), L"VID_%04X&PID_%04X", device->vendor, device->product);
+    RtlInitUnicodeString(&name, id);
+    if ((info = ExAllocatePool(PagedPool, 256)))
+    {
+        if (!ZwQueryValueKey(key, &name, KeyValuePartialInformation, info, 256, &size) && info->Type == REG_SZ)
+        {
+            device->winusb = TRUE;
+            lstrcpynW(device->interface_guid, (const WCHAR *)info->Data,
+                      min(ARRAY_SIZE(device->interface_guid), info->DataLength / sizeof(WCHAR) + 1));
+            TRACE("%s listed for WinUSB.\n", debugstr_w(id));
+        }
+        ExFreePool(info);
+    }
+    ZwClose(key);
+}
