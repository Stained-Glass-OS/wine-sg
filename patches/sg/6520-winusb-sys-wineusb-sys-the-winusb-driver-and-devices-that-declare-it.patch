+/* Stained Glass OS (wine-sg 6520): the Microsoft OS descriptors (1.0: string descriptor 0xEE,
+ * extended compat ID and extended properties; 2.0: the BOS platform capability and its
+ * descriptor set), read once per device: which interfaces (or the whole device, -1) declare the
+ * compatible ID "WINUSB", and the DeviceInterfaceGUID(s) they name. Written from the public
+ * specifications of these descriptors. */
+#define MS_OS_MAX_INTERFACES 32
+
+struct ms_os_info
+{
+    bool winusb[MS_OS_MAX_INTERFACES + 1];          /* [0]: the device, [i + 1]: interface i */
+    WCHAR guid[MS_OS_MAX_INTERFACES + 1][40];
+};
+
+static int ms_os_slot(int interface)
+{
+    if (interface < 0) return 0;
+    if (interface >= MS_OS_MAX_INTERFACES) return -1;
+    return interface + 1;
+}
+
+/* the first GUID of a REG_SZ/REG_MULTI_SZ property value (UTF-16LE) */
+static void ms_os_set_guid(struct ms_os_info *info, int interface, const unsigned char *data, unsigned int size)
+{
+    int slot = ms_os_slot(interface);
+    unsigned int i, n = 0;
+
+    if (slot < 0) return;
+    for (i = 0; i + 1 < size && n < 39; i += 2)
+    {
+        WCHAR c = data[i] | (data[i + 1] << 8);
+        if (!c) break;
+        info->guid[slot][n++] = c;
+    }
+    info->guid[slot][n] = 0;
+}
+
+static bool ms_os_property_is_guid(const unsigned char *name, unsigned int size)
+{
+    static const char want1[] = "DeviceInterfaceGUID", want2[] = "DeviceInterfaceGUIDs";
+    char ascii[32];
+    unsigned int i, n = 0;
+
+    for (i = 0; i + 1 < size && n < sizeof(ascii) - 1; i += 2)
+    {
+        if (!name[i] && !name[i + 1]) break;
+        ascii[n++] = name[i];
+    }
+    ascii[n] = 0;
+    return !strcasecmp(ascii, want1) || !strcasecmp(ascii, want2);
+}
+
+static void ms_os_10(libusb_device_handle *handle, struct ms_os_info *info, int interfaces)
+{
+    unsigned char string[18], buffer[4096];
+    unsigned int count, i, length;
+    uint8_t vendor_code;
+    int ret, k;
+
+    ret = libusb_control_transfer(handle, LIBUSB_ENDPOINT_IN, LIBUSB_REQUEST_GET_DESCRIPTOR,
+                                  (LIBUSB_DT_STRING << 8) | 0xee, 0, string, sizeof(string), 500);
+    if (ret < 18 || string[1] != LIBUSB_DT_STRING || memcmp(string + 2, "M\0S\0F\0T\0" "1\0" "0\0" "0\0", 14))
+        return;
+    vendor_code = string[16];
+    TRACE("MS OS 1.0 descriptors, vendor code %#x\n", vendor_code);
+
+    /* extended compat ID: the functions' compatible IDs */
+    ret = libusb_control_transfer(handle, LIBUSB_ENDPOINT_IN | LIBUSB_REQUEST_TYPE_VENDOR | LIBUSB_RECIPIENT_DEVICE,
+                                  vendor_code, 0, 4, buffer, sizeof(buffer), 500);
+    if (ret >= 16)
+    {
+        count = buffer[8];
+        for (i = 0; i < count && 16 + (i + 1) * 24 <= (unsigned int)ret; i++)
+        {
+            const unsigned char *function = buffer + 16 + i * 24;
+            if (!memcmp(function + 2, "WINUSB\0\0", 8))
+            {
+                int slot = ms_os_slot(interfaces > 1 ? function[0] : -1);
+                if (slot >= 0) info->winusb[slot] = true;
+                if (interfaces <= 1 && (slot = ms_os_slot(function[0])) >= 0) info->winusb[slot] = true;
+                TRACE("interface %u: WINUSB\n", function[0]);
+            }
+        }
+    }
+
+    /* extended properties, per interface (and the device's, interface 0) */
+    for (k = 0; k < max(interfaces, 1) && k < MS_OS_MAX_INTERFACES; k++)
+    {
+        unsigned int pos = 10;
+
+        ret = libusb_control_transfer(handle, LIBUSB_ENDPOINT_IN | LIBUSB_REQUEST_TYPE_VENDOR | LIBUSB_RECIPIENT_INTERFACE,
+                                      vendor_code, k, 5, buffer, sizeof(buffer), 500);
+        if (ret < 10) continue;
+        count = buffer[8] | (buffer[9] << 8);
+        for (i = 0; i < count && pos + 14 <= (unsigned int)ret; i++)
+        {
+            unsigned int size = buffer[pos] | (buffer[pos + 1] << 8) | (buffer[pos + 2] << 16) | ((unsigned int)buffer[pos + 3] << 24);
+            unsigned int type = buffer[pos + 4], name_length = buffer[pos + 8] | (buffer[pos + 9] << 8);
+            const unsigned char *name = buffer + pos + 10;
+
+            if (size < 14 || pos + size > (unsigned int)ret || 10 + name_length + 4 > size) break;
+            length = name[name_length] | (name[name_length + 1] << 8);
+            if ((type == 1 || type == 7) && ms_os_property_is_guid(name, name_length))
+            {
+                ms_os_set_guid(info, interfaces > 1 ? k : -1, name + name_length + 4, min(length, size - 14 - name_length));
+                if (interfaces <= 1) ms_os_set_guid(info, k, name + name_length + 4, min(length, size - 14 - name_length));
+            }
+            pos += size;
+        }
+    }
+}
+
+static void ms_os_20(libusb_device_handle *handle, struct ms_os_info *info, int interfaces)
+{
+    static const unsigned char platform_uuid[16] =
+        {0xdf, 0x60, 0xdd, 0xd8, 0x89, 0x45, 0xc7, 0x4c, 0x9c, 0xd2, 0x65, 0x9d, 0x9e, 0x64, 0x8a, 0x9f};
+    struct libusb_bos_descriptor *bos;
+    unsigned char *set = NULL;
+    unsigned int i, total = 0, pos;
+    uint8_t vendor_code = 0;
+    int ret, function = -1;
+
+    if (libusb_get_bos_descriptor(handle, &bos)) return;
+    for (i = 0; i < bos->bNumDeviceCaps; i++)
+    {
+        struct libusb_bos_dev_capability_descriptor *cap = bos->dev_capability[i];
+        /* platform capability: reserved byte, UUID, then the descriptor set information */
+        if (cap->bDevCapabilityType == 5 && cap->bLength >= 28 && !memcmp(cap->dev_capability_data + 1, platform_uuid, 16))
+        {
+            const uint8_t *data = cap->dev_capability_data + 17;
+            total = data[4] | (data[5] << 8);
+            vendor_code = data[6];
+        }
+    }
+    libusb_free_bos_descriptor(bos);
+    if (!total || total > 65535 || !(set = malloc(total))) return;
+    TRACE("MS OS 2.0 descriptor set, %u bytes, vendor code %#x\n", total, vendor_code);
+    ret = libusb_control_transfer(handle, LIBUSB_ENDPOINT_IN | LIBUSB_REQUEST_TYPE_VENDOR | LIBUSB_RECIPIENT_DEVICE,
+                                  vendor_code, 0, 7, set, total, 500);
+    for (pos = 0; ret > 0 && pos + 4 <= (unsigned int)ret;)
+    {
+        unsigned int length = set[pos] | (set[pos + 1] << 8), type = set[pos + 2] | (set[pos + 3] << 8);
+
+        if (length < 4 || pos + length > (unsigned int)ret) break;
+        if (type == 2 && length >= 8) function = set[pos + 4];                  /* function subset */
+        else if (type == 3 && length >= 20 && !memcmp(set + pos + 4, "WINUSB\0\0", 8))
+        {
+            int slot = ms_os_slot(interfaces > 1 ? function : -1);
+            if (slot >= 0) info->winusb[slot] = true;
+            if (function >= 0 && (slot = ms_os_slot(function)) >= 0) info->winusb[slot] = true;
+        }
+        else if (type == 4 && length >= 10)                                       /* registry property */
+        {
+            unsigned int data_type = set[pos + 4] | (set[pos + 5] << 8), name_length = set[pos + 6] | (set[pos + 7] << 8);
+            const unsigned char *name = set + pos + 8;
+
+            if (8 + name_length + 2 <= length && (data_type == 1 || data_type == 7) && ms_os_property_is_guid(name, name_length))
+            {
+                unsigned int data_length = name[name_length] | (name[name_length + 1] << 8);
+                data_length = min(data_length, length - 10 - name_length);
+                ms_os_set_guid(info, interfaces > 1 ? function : -1, name + name_length + 2, data_length);
+                if (function >= 0) ms_os_set_guid(info, function, name + name_length + 2, data_length);
+            }
+        }
+        pos += length;
+    }
+    free(set);
+}
+
+static void apply_ms_os(const struct ms_os_info *info, struct usb_add_device_event *event, int interface)
+{
+    int slot = ms_os_slot(interface);
+
+    event->winusb = false;
+    event->interface_guid[0] = 0;
+    if (slot < 0) return;
+#ifndef SG_MUTANT_WINEUSB_NO_MSOS
+    event->winusb = info->winusb[slot];
+    memcpy(event->interface_guid, info->guid[slot], sizeof(event->interface_guid));
+#endif
+}
