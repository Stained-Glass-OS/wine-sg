+wine_fn_config_makefile dlls/unidrv enable_unidrv
+wine_fn_config_makefile dlls/unidrvui enable_unidrvui
 wine_fn_config_makefile dlls/updspapi enable_updspapi
 wine_fn_config_makefile dlls/url enable_url
