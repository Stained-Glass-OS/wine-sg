+static void fill_gdiinfo( struct unidrv_pdev *pdev, GDIINFO *gi, ULONG size )
+{
+    GDIINFO info;
+
+    memset( &info, 0, sizeof(info) );
+    info.ulVersion = 0x5000;
+    info.ulTechnology = DT_RASPRINTER;
+    info.ulHorzSize = MulDiv( pdev->print_w, 254, pdev->dpi_x * 10 );
+    info.ulVertSize = MulDiv( pdev->print_h, 254, pdev->dpi_y * 10 );
+    info.ulHorzRes = pdev->print_w;
+    info.ulVertRes = pdev->print_h;
+    info.cBitsPixel = pdev->drv_bpp >= 24 ? 24 : pdev->drv_bpp;
+    info.cPlanes = 1;
+    info.ulNumColors = pdev->drv_bpp >= 24 ? (ULONG)-1 : 1u << pdev->drv_bpp;
+    info.flRaster = RC_BITBLT | RC_BANDING | RC_STRETCHBLT | RC_STRETCHDIB | RC_DIBTODEV | RC_BITMAP64;
+    info.ulLogPixelsX = pdev->dpi_x;
+    info.ulLogPixelsY = pdev->dpi_y;
+    info.flTextCaps = TC_OP_CHARACTER | TC_CR_ANY | TC_SA_DOUBLE | TC_SA_INTEGER | TC_SA_CONTIN |
+                      TC_EA_DOUBLE | TC_IA_ABLE | TC_UA_ABLE | TC_SO_ABLE | TC_RA_ABLE;
+    info.ulDACRed = info.ulDACGreen = info.ulDACBlue = 8;
+    info.ulAspectX = pdev->dpi_x;
+    info.ulAspectY = pdev->dpi_y;
+    info.ulAspectXY = (ULONG)(sqrt( (double)pdev->dpi_x * pdev->dpi_x + (double)pdev->dpi_y * pdev->dpi_y ) + 0.5);
+    info.xStyleStep = 1;
+    info.yStyleStep = 1;
+    info.denStyleStep = pdev->dpi_x / 25;
+    info.ptlPhysOffset.x = pdev->print_x;
+    info.ptlPhysOffset.y = pdev->print_y;
+    info.szlPhysSize.cx = pdev->page_w;
+    info.szlPhysSize.cy = pdev->page_h;
+    info.ulDevicePelsDPI = pdev->dpi_x;
+    info.ulPrimaryOrder = 0;
+    info.ulHTPatternSize = 0;
+    info.ulHTOutputFormat = pdev->drv_bpp >= 24 ? 7 : 0;
+    memcpy( gi, &info, min( size, sizeof(info) ) );
+}
+
+static void fill_devinfo( struct unidrv_pdev *pdev, DEVINFO *di, ULONG size )
+{
+    DEVINFO info;
+    memset( &info, 0, sizeof(info) );
+    info.flGraphicsCaps = GCAPS_HALFTONE;
+    info.iDitherFormat = pdev->drv_bpp >= 24 ? BMF_24BPP : BMF_1BPP;
+    if (pdev->drv_bpp == 1)
+    {
+        /* one bit per pixel: 0 is paper, 1 is ink */
+        ULONG colors[2] = { 0xffffff, 0 };
+        pdev->palette = EngCreatePalette( PAL_INDEXED, 2, colors, 0, 0, 0 );
+    }
+    else pdev->palette = EngCreatePalette( PAL_BGR, 0, NULL, 0, 0, 0 );
+    info.hpalDefault = pdev->palette;
+    wcscpy( info.lfDefaultFont.lfFaceName, L"Arial" );
+    wcscpy( info.lfAnsiVarFont.lfFaceName, L"Arial" );
+    wcscpy( info.lfAnsiFixFont.lfFaceName, L"Courier New" );
+    memcpy( di, &info, min( size, sizeof(info) ) );
+}
+
+static void set_color_format( struct unidrv_pdev *pdev )
+{
+    const char *v;
+    int n;
+
+    pdev->drv_bpp = 1;
+    pdev->dev_bpp = 1;
+    pdev->ip_callback = -1;
+    if ((v = gpd_selected_attr( pdev->gpd, pdev->sel, "ColorMode", "DrvBPP" )) && gpd_int( pdev->gpd, v, &n ))
+        pdev->drv_bpp = n;
+    if ((v = gpd_selected_attr( pdev->gpd, pdev->sel, "ColorMode", "DevBPP" )) && gpd_int( pdev->gpd, v, &n ))
+        pdev->dev_bpp = n;
+    if ((v = gpd_selected_attr( pdev->gpd, pdev->sel, "ColorMode", "IPCallbackID" )) && gpd_int( pdev->gpd, v, &n ))
+        pdev->ip_callback = n;
+    /* we draw in 1 or 24 bits; other depths are drawn in 24 and reduced */
+    if (pdev->drv_bpp != 1) pdev->drv_bpp = 24;
+    if (pdev->dev_bpp != 1)
+    {
+        FIXME( "device depth %d sent as 1 bit\n", pdev->dev_bpp );
+        pdev->dev_bpp = 1;
+    }
+}
+
+static void set_strip( struct unidrv_pdev *pdev )
+{
+    const char *v = gpd_selected_attr( pdev->gpd, pdev->sel, "Resolution", "StripBlanks" );
+    if (!v) v = gpd_global( pdev->gpd, pdev->sel, "StripBlanks" );
+    pdev->strip_trailing = gpd_list_has( pdev->gpd, v, "TRAILING" );
+    pdev->strip_leading = gpd_list_has( pdev->gpd, v, "LEADING" );
+    pdev->strip_enclosed = gpd_list_has( pdev->gpd, v, "ENCLOSED" );
+}
+
+static DEVMODEW *merge_devmode( struct unidrv_pdev *pdev, const DEVMODEW *in )
+{
+    DWORD oem_size = 0;
+    DEVMODEW *dm;
+
+    if (pdev->oem.uni) oem_size = oem_dm_size_from( pdev->oem.uni, pdev->oem.module );
+    dm = unidrv_default_devmode( pdev->gpd, pdev->name, oem_size );
+    if (in)
+    {
+        DWORD keep = dm->dmFields;
+        WORD size = dm->dmSize, extra = dm->dmDriverExtra;
+        memcpy( dm, in, min( in->dmSize, sizeof(DEVMODEW) ) );
+        dm->dmSize = size;
+        dm->dmDriverExtra = extra;
+        dm->dmFields |= keep;
+    }
+    unidrv_devmode_to_sel( pdev->gpd, in, pdev->sel );
+    unidrv_sel_to_devmode( pdev->gpd, pdev->sel, dm );
+
+    if (oem_size)
+    {
+        sg_oemdmparam param = { sizeof(param) };
+        BYTE *oem_out = (BYTE *)dm + dm->dmSize + sizeof(struct unidrv_dm);
+        const BYTE *oem_in = NULL;
+
+        if (in && in->dmDriverExtra >= sizeof(struct unidrv_dm) + oem_size)
+        {
+            const sg_oem_dmheader *hdr = (const sg_oem_dmheader *)((const BYTE *)in + in->dmSize +
+                                                                   sizeof(struct unidrv_dm));
+            if (hdr->size == oem_size && hdr->signature == pdev->oem.signature) oem_in = (const BYTE *)hdr;
+        }
+        param.driver_obj = pdev;
+        param.printer = pdev->printer;
+        param.oem_module = pdev->oem.module;
+        param.public_in = param.public_out = dm;
+        param.oem_out = oem_out;
+        param.out_size = oem_size;
+        pdev->oem.uni->lpVtbl->DevMode( pdev->oem.uni, SG_OEMDM_DEFAULT, &param );
+        if (oem_in) memcpy( oem_out, oem_in, oem_size );
+        pdev->devobj.oem_dm = oem_out;
+    }
+    return dm;
+}
+
+DHPDEV WINAPI DrvEnablePDEV( DEVMODEW *dm, WCHAR *log_address, ULONG pattern_count, HSURF *patterns,
+                             ULONG caps_size, ULONG *caps, ULONG devinfo_size, DEVINFO *devinfo, HDEV hdev,
+                             WCHAR *device_name, HANDLE driver )
+{
+    struct unidrv_pdev *pdev;
+    int ph;
+
+    TRACE( "%p %s %s %p\n", dm, debugstr_w(log_address), debugstr_w(device_name), driver );
+
+    pdev = calloc( 1, sizeof(*pdev) );
+    pdev->magic = UNIDRV_PDEV_MAGIC;
+    pdev->printer = driver;
+    pdev->name = wcsdup( device_name ? device_name : L"" );
+    if (!(pdev->gpd = unidrv_load_printer_gpd( driver )))
+    {
+        WARN( "no GPD for %s\n", debugstr_w(device_name) );
+        free( pdev->name );
+        free( pdev );
+        return NULL;
+    }
+    pdev->devobj.size = sizeof(pdev->devobj);
+    pdev->devobj.engine = (HANDLE)hdev;
+    pdev->devobj.printer = driver;
+    if (!oem_load( pdev, driver ))
+    {
+        struct wine_eng_device *dev = (struct wine_eng_device *)hdev;
+        /* printing without the maker's plug-in sends the printer the wrong
+         * data: let the print processor run the driver where it loads (a
+         * 64-bit plug-in for a 32-bit program).  Measuring the page is fine. */
+        if (dev && dev->magic == WINE_ENG_DEVICE_MAGIC && (dev->output || dev->file))
+        {
+            WARN( "the plug-in did not load in this process\n" );
+            oem_unload( pdev );
+            gpd_free( pdev->gpd );
+            free( pdev->name );
+            free( pdev );
+            SetLastError( ERROR_BAD_EXE_FORMAT );
+            return NULL;
+        }
+        WARN( "the plug-in did not load; measuring without it\n" );
+    }
+    pdev->devobj.oem_module = pdev->oem.module;
+
+    pdev->devmode = merge_devmode( pdev, dm );
+    pdev->devobj.public_dm = pdev->devmode;
+    unidrv_geometry( pdev->gpd, pdev->sel, pdev->devmode, &pdev->dpi_x, &pdev->dpi_y, &pdev->page_w,
+                     &pdev->page_h, &pdev->print_x, &pdev->print_y, &pdev->print_w, &pdev->print_h,
+                     &pdev->landscape );
+    set_color_format( pdev );
+    set_strip( pdev );
+    ph = pdev->print_h;
+    TRACE( "%dx%d dpi, page %dx%d, printable %d,%d %dx%d, landscape %d, bpp %d/%d, ip %d\n",
+           pdev->dpi_x, pdev->dpi_y, pdev->page_w, pdev->page_h, pdev->print_x, pdev->print_y,
+           pdev->print_w, ph, pdev->landscape, pdev->drv_bpp, pdev->dev_bpp, pdev->ip_callback );
+
+    if (caps) fill_gdiinfo( pdev, (GDIINFO *)caps, caps_size );
+    if (devinfo) fill_devinfo( pdev, devinfo, devinfo_size );
+
+    if (pdev->oem.uni)
+    {
+        DRVENABLEDATA core = { DDI_DRIVER_VERSION_NT5, ARRAY_SIZE(core_table), core_table };
+        void *oem_pdev = NULL;
+        HRESULT hr = pdev->oem.uni->lpVtbl->EnablePDEV( pdev->oem.uni, &pdev->devobj, device_name, pattern_count,
+                                                        patterns, caps_size, (GDIINFO *)caps, devinfo_size,
+                                                        devinfo, &core, &oem_pdev );
+        if (SUCCEEDED(hr)) pdev->devobj.oem_pdev = oem_pdev;
+        else WARN( "plug-in EnablePDEV %#lx\n", hr );
+    }
+    return (DHPDEV)pdev;
+}
+
+void WINAPI DrvCompletePDEV( DHPDEV dhpdev, HDEV hdev )
+{
+    struct unidrv_pdev *pdev = get_pdev( dhpdev );
+    if (pdev) pdev->devobj.engine = (HANDLE)hdev;
+}
+
+HSURF WINAPI DrvEnableSurface( DHPDEV dhpdev )
+{
+    struct unidrv_pdev *pdev = get_pdev( dhpdev );
+    SIZEL size;
+    LONG stride;
+    ULONG format;
+    BOOL banding;
+
+    if (!pdev) return NULL;
+    format = pdev->drv_bpp >= 24 ? BMF_24BPP : BMF_1BPP;
+    size.cx = pdev->print_w;
+    size.cy = pdev->print_h;
+    stride = format == BMF_24BPP ? ((size.cx * 3 + 3) & ~3) : ((size.cx + 31) / 32) * 4;
+    /* a page that does not fit in memory is drawn in bands; turned pages
+     * are rotated whole */
+    banding = !pdev->landscape && (LONGLONG)stride * size.cy > MAX_BAND_BYTES;
+    if (banding) size.cy = max( 1, MAX_BAND_BYTES / stride );
+    pdev->surface = EngCreateBitmap( size, stride, format, BMF_TOPDOWN, NULL );
+    if (!pdev->surface) return NULL;
+    EngAssociateSurface( pdev->surface, (HDEV)pdev->devobj.engine, 0 );
+    if (banding) EngMarkBandingSurface( pdev->surface );
+    TRACE( "surface %ldx%ld format %lu banding %d\n", size.cx, size.cy, format, banding );
+    return pdev->surface;
+}
+
+void WINAPI DrvDisableSurface( DHPDEV dhpdev )
+{
+    struct unidrv_pdev *pdev = get_pdev( dhpdev );
+    if (!pdev || !pdev->surface) return;
+    EngDeleteSurface( pdev->surface );
+    pdev->surface = NULL;
+}
+
+void WINAPI DrvDisablePDEV( DHPDEV dhpdev )
+{
+    struct unidrv_pdev *pdev = get_pdev( dhpdev );
+    if (!pdev) return;
+    if (pdev->oem.uni) pdev->oem.uni->lpVtbl->DisablePDEV( pdev->oem.uni, &pdev->devobj );
+    oem_unload( pdev );
+    if (pdev->palette) EngDeletePalette( pdev->palette );
+    gpd_free( pdev->gpd );
+    free( pdev->devmode );
+    free( pdev->name );
+    pdev->magic = 0;
+    free( pdev );
+}
+
+BOOL WINAPI DrvResetPDEV( DHPDEV old, DHPDEV new )
+{
+    return TRUE;
+}
+
+ULONG WINAPI DrvEscape( SURFOBJ *so, ULONG escape, ULONG in_size, void *in, ULONG out_size, void *out )
+{
+    if (escape == QUERYESCSUPPORT && in && in_size >= sizeof(DWORD))
+    {
+        DWORD code = *(DWORD *)in;
+        return code == QUERYESCSUPPORT || code == PASSTHROUGH;
+    }
+    if (escape == PASSTHROUGH && in && in_size >= sizeof(WORD))
+    {
+        struct unidrv_pdev *pdev = surf_pdev( so );
+        WORD len = *(WORD *)in;
+        if (pdev && len <= in_size - sizeof(WORD) && unidrv_write( pdev, (BYTE *)in + sizeof(WORD), len ))
+            return len;
+        return (ULONG)-1;
+    }
+    return 0;
+}
+
+static DRVFN driver_table[] =
+{
+    { INDEX_DrvEnablePDEV, (PFN)DrvEnablePDEV },
+    { INDEX_DrvCompletePDEV, (PFN)DrvCompletePDEV },
+    { INDEX_DrvDisablePDEV, (PFN)DrvDisablePDEV },
+    { INDEX_DrvEnableSurface, (PFN)DrvEnableSurface },
+    { INDEX_DrvDisableSurface, (PFN)DrvDisableSurface },
+    { INDEX_DrvResetPDEV, (PFN)DrvResetPDEV },
+    { INDEX_DrvStartDoc, (PFN)DrvStartDoc },
+    { INDEX_DrvStartPage, (PFN)DrvStartPage },
+    { INDEX_DrvSendPage, (PFN)DrvSendPage },
+    { INDEX_DrvEndDoc, (PFN)DrvEndDoc },
+    { INDEX_DrvStartBanding, (PFN)DrvStartBanding },
+    { INDEX_DrvNextBand, (PFN)DrvNextBand },
+    { INDEX_DrvEscape, (PFN)DrvEscape },
+};
+
+BOOL WINAPI DrvEnableDriver( ULONG version, ULONG size, DRVENABLEDATA *ded )
+{
+    TRACE( "%#lx %lu %p\n", version, size, ded );
+    if (size < sizeof(*ded)) return FALSE;
+    ded->iDriverVersion = DDI_DRIVER_VERSION_NT5;
+    ded->c = ARRAY_SIZE(driver_table);
+    ded->pdrvfn = driver_table;
+    return TRUE;
+}
+
+void WINAPI DrvDisableDriver( void )
+{
+}
+
+BOOL WINAPI DrvQueryDriverInfo( DWORD mode, void *buf, DWORD size, DWORD *needed )
+{
+    /* we keep no per-process state a spooler would have to know about */
+    if (needed) *needed = sizeof(DWORD);
+    if (mode == 1 && buf && size >= sizeof(DWORD))
+    {
+        *(DWORD *)buf = 0;
+        return TRUE;
+    }
+    return FALSE;
+}
