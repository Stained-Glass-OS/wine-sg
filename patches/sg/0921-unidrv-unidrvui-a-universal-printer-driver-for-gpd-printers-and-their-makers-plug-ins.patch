+/*
+ * The configuration DLL of a GPD printer answers DeviceCapabilities and
+ * DocumentProperties from the printer's GPD: its paper sizes (label stocks
+ * for a label printer), resolutions, trays and media, and the devmode that
+ * carries the choices (ours, then the maker's plug-in's own part).
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#define COBJMACROS
+#include "../unidrv/unidrv_private.h"
+#include "prsht.h"
+#include "ddk/winddiui.h"
+#include "ddk/compstui.h"
+#include "initguid.h"
+#include "wine/printdrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(unidrv);
+
+/* what DocumentProperties hands the driver */
+typedef struct
+{
+    WORD      cbSize;
+    WORD      Reserved;
+    HANDLE    hPrinter;
+    LPCWSTR   pszPrinterName;
+    DEVMODEW *pdmIn;
+    DEVMODEW *pdmOut;
+    DWORD     cbOut;
+    DWORD     fMode;
+} DOCUMENTPROPERTYHEADERW;
+
+struct config
+{
+    HANDLE      printer;
+    struct gpd *gpd;
+    sg_oemuni  *oem;        /* the render plug-in, for its devmode part */
+    HMODULE     oem_module;
+    DWORD       oem_size;
+    DWORD       oem_signature;
+};
+
+static void close_config( struct config *cfg )
+{
+    if (cfg->oem) cfg->oem->lpVtbl->Release( cfg->oem );
+    if (cfg->oem_module) FreeLibrary( cfg->oem_module );
+    gpd_free( cfg->gpd );
+    if (cfg->printer) ClosePrinter( cfg->printer );
+}
+
+static BOOL open_config( struct config *cfg, HANDLE printer, const WCHAR *name )
+{
+    HRESULT (WINAPI *get_class)( REFCLSID, REFIID, void ** );
+    WCHAR *file;
+
+    memset( cfg, 0, sizeof(*cfg) );
+    if (printer) cfg->printer = NULL;
+    else if (!OpenPrinterW( (WCHAR *)name, &cfg->printer, NULL )) return FALSE;
+    if (!(cfg->gpd = unidrv_load_printer_gpd( printer ? printer : cfg->printer )))
+    {
+        close_config( cfg );
+        return FALSE;
+    }
+    if ((file = unidrv_oem_file( printer ? printer : cfg->printer, L"OEMDriverFile1" )))
+    {
+        cfg->oem_module = LoadLibraryW( file );
+        free( file );
+    }
+    if (cfg->oem_module && (get_class = (void *)GetProcAddress( cfg->oem_module, "DllGetClassObject" )))
+    {
+        IClassFactory *factory;
+        IUnknown *unk;
+        if (SUCCEEDED(get_class( &SG_CLSID_OEMRENDER, &IID_IClassFactory, (void **)&factory )))
+        {
+            if (SUCCEEDED(IClassFactory_CreateInstance( factory, NULL, &IID_IUnknown, (void **)&unk )))
+            {
+                if (FAILED(IUnknown_QueryInterface( unk, &SG_IID_IPrintOemUni3, (void **)&cfg->oem )) &&
+                    FAILED(IUnknown_QueryInterface( unk, &SG_IID_IPrintOemUni2, (void **)&cfg->oem )))
+                    IUnknown_QueryInterface( unk, &SG_IID_IPrintOemUni, (void **)&cfg->oem );
+                IUnknown_Release( unk );
+            }
+            IClassFactory_Release( factory );
+        }
+    }
+    if (cfg->oem)
+    {
+        DWORD size;
+        cfg->oem_size = oem_dm_size_from( cfg->oem, cfg->oem_module );
+        cfg->oem->lpVtbl->GetInfo( cfg->oem, SG_OEMGI_SIGNATURE, &cfg->oem_signature,
+                                   sizeof(cfg->oem_signature), &size );
+    }
+    return TRUE;
+}
+
+/* the devmode for the printer: defaults, then what came in */
+static DEVMODEW *make_devmode( struct config *cfg, const WCHAR *name, const DEVMODEW *in )
+{
+    DEVMODEW *dm = unidrv_default_devmode( cfg->gpd, name, cfg->oem_size );
+    gpd_sel sel[UNIDRV_MAX_FEATURES];
+
+    if (cfg->oem_size)
+    {
+        sg_oemdmparam param = { sizeof(param) };
+        param.printer = cfg->printer;
+        param.oem_module = cfg->oem_module;
+        param.public_in = param.public_out = dm;
+        param.oem_out = (BYTE *)dm + dm->dmSize + sizeof(struct unidrv_dm);
+        param.out_size = cfg->oem_size;
+        cfg->oem->lpVtbl->DevMode( cfg->oem, SG_OEMDM_DEFAULT, &param );
+    }
+    if (!in) return dm;
+
+    /* the public fields the caller set */
+    if (in->dmFields & DM_COPIES) dm->dmCopies = in->dmCopies;
+    if (in->dmFields & DM_COLLATE) { dm->dmFields |= DM_COLLATE; dm->dmCollate = in->dmCollate; }
+    if (in->dmFields & DM_SCALE) dm->dmScale = in->dmScale;
+    if (in->dmFields & DM_DUPLEX) { dm->dmFields |= DM_DUPLEX; dm->dmDuplex = in->dmDuplex; }
+    if ((in->dmFields & DM_PAPERWIDTH) && (in->dmFields & DM_PAPERLENGTH))
+    {
+        dm->dmPaperWidth = in->dmPaperWidth;
+        dm->dmPaperLength = in->dmPaperLength;
+    }
+    unidrv_devmode_to_sel( cfg->gpd, in, sel );
+    unidrv_sel_to_devmode( cfg->gpd, sel, dm );
+    if ((in->dmFields & DM_PAPERWIDTH) && (in->dmFields & DM_PAPERLENGTH) && dm->dmPaperSize == DMPAPER_USER)
+    {
+        dm->dmPaperWidth = in->dmPaperWidth;
+        dm->dmPaperLength = in->dmPaperLength;
+    }
+    /* the maker's part, if it is theirs */
+    if (cfg->oem_size && in->dmDriverExtra >= sizeof(struct unidrv_dm) + cfg->oem_size)
+    {
+        const sg_oem_dmheader *hdr = (const sg_oem_dmheader *)((const BYTE *)in + in->dmSize +
+                                                               sizeof(struct unidrv_dm));
+        if (hdr->size == cfg->oem_size && hdr->signature == cfg->oem_signature)
+            memcpy( (BYTE *)dm + dm->dmSize + sizeof(struct unidrv_dm), hdr, cfg->oem_size );
+    }
+    return dm;
+}
