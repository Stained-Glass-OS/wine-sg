+
+/*
+ * A printer maker extends Unidrv with a COM object in a DLL its .ini file
+ * names (OEMDriverFile1).  We create the object, hand it our helper
+ * interface, and call it where Unidrv would: around the job's DDI calls (it
+ * may hook them), on each band (ImageProcessing) and on raster data
+ * (FilterGraphics).
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#define COBJMACROS
+#include "unidrv_private.h"
+#include "initguid.h"
+#include "wine/printdrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(unidrv);
+
+
+static struct unidrv_pdev *pdev_from_obj( void *obj )
+{
+    struct unidrv_pdev *pdev = obj;
+    if (!pdev || pdev->magic != UNIDRV_PDEV_MAGIC) return NULL;
+    return pdev;
+}
+
+/* ---- our helper interface ---- */
+
+static HRESULT STDMETHODCALLTYPE core_QueryInterface( sg_drvuni *iface, REFIID riid, void **out )
+{
+    TRACE( "%s\n", debugstr_guid(riid) );
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &SG_IID_IPrintOemDriverUni ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE core_AddRef( sg_drvuni *iface ) { return 2; }
+static ULONG STDMETHODCALLTYPE core_Release( sg_drvuni *iface ) { return 1; }
+
+static HRESULT STDMETHODCALLTYPE core_DrvGetDriverSetting( sg_drvuni *iface, void *obj, const char *feature,
+                                                           void *out, DWORD size, DWORD *needed, DWORD *count )
+{
+    struct unidrv_pdev *pdev = pdev_from_obj( obj );
+    if (!pdev) return E_INVALIDARG;
+    if (unidrv_get_driver_setting( pdev, feature, out, size, needed, count )) return S_OK;
+    return GetLastError() == ERROR_INSUFFICIENT_BUFFER ? E_OUTOFMEMORY : E_FAIL;
+}
+
+static HRESULT STDMETHODCALLTYPE core_DrvWriteSpoolBuf( sg_drvuni *iface, sg_devobj *obj, void *buf, DWORD size,
+                                                        DWORD *written )
+{
+    struct unidrv_pdev *pdev = pdev_from_obj( obj );
+    if (!pdev) return E_INVALIDARG;
+    if (!unidrv_write( pdev, buf, size ))
+    {
+        if (written) *written = 0;
+        return E_FAIL;
+    }
+    if (written) *written = size;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE core_DrvXMoveTo( sg_drvuni *iface, sg_devobj *obj, INT x, DWORD flags, INT *res )
+{
+    struct unidrv_pdev *pdev = pdev_from_obj( obj );
+    if (!pdev) return E_INVALIDARG;
+    if (flags & SG_MV_UPDATE) pdev->cur_x = (flags & SG_MV_RELATIVE) ? pdev->cur_x + x : x;
+    if (res) *res = 0;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE core_DrvYMoveTo( sg_drvuni *iface, sg_devobj *obj, INT y, DWORD flags, INT *res )
+{
+    struct unidrv_pdev *pdev = pdev_from_obj( obj );
+    if (!pdev) return E_INVALIDARG;
+    if (flags & SG_MV_UPDATE) pdev->cur_y = (flags & SG_MV_RELATIVE) ? pdev->cur_y + y : y;
+    if (res) *res = 0;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE core_DrvGetStandardVariable( sg_drvuni *iface, sg_devobj *obj, DWORD index,
+                                                              void *buf, DWORD size, DWORD *needed )
+{
+    struct unidrv_pdev *pdev = pdev_from_obj( obj );
+    if (!pdev) return E_INVALIDARG;
+    return unidrv_standard_variable( pdev, index, buf, size, needed ) ? S_OK : E_FAIL;
+}
+
+static HRESULT STDMETHODCALLTYPE core_DrvGetGPDData( sg_drvuni *iface, sg_devobj *obj, DWORD type, void *in,
+                                                     void *buf, DWORD size, DWORD *needed )
+{
+    FIXME( "type %lu\n", type );
+    return E_NOTIMPL;
+}
+
+static HRESULT STDMETHODCALLTYPE core_DrvUniTextOut( sg_drvuni *iface, SURFOBJ *so, STROBJ *str, FONTOBJ *font,
+                                                     CLIPOBJ *clip, RECTL *extra, RECTL *opaque, BRUSHOBJ *fore,
+                                                     BRUSHOBJ *back, POINTL *org, MIX mix )
+{
+    /* text reaches the page through our rendering of the document */
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE core_DrvWriteAbortBuf( sg_drvuni *iface, sg_devobj *obj, void *buf, DWORD size,
+                                                        DWORD wait )
+{
+    struct unidrv_pdev *pdev = pdev_from_obj( obj );
+    if (!pdev) return E_INVALIDARG;
+    unidrv_write( pdev, buf, size );
+    if (wait) Sleep( wait );
+    return S_OK;
+}
+
+const sg_drvuni_vtbl unidrv_core_vtbl =
+{
+    core_QueryInterface, core_AddRef, core_Release, core_DrvGetDriverSetting, core_DrvWriteSpoolBuf,
+    core_DrvXMoveTo, core_DrvYMoveTo, core_DrvGetStandardVariable, core_DrvGetGPDData, core_DrvUniTextOut,
+    core_DrvWriteAbortBuf,
+};
+sg_drvuni unidrv_core = { &unidrv_core_vtbl };
+
+/* the older function table some plug-ins use instead (DEVOBJ.pDrvProcs) */
+static DWORD WINAPI procs_write( sg_devobj *obj, void *buf, DWORD size )
+{
+    struct unidrv_pdev *pdev = pdev_from_obj( obj );
+    return pdev && unidrv_write( pdev, buf, size ) ? size : 0;
+}
+
+static INT WINAPI procs_xmove( sg_devobj *obj, INT x, DWORD flags )
+{
+    INT res = 0;
+    core_DrvXMoveTo( &unidrv_core, obj, x, flags, &res );
+    return res;
+}
+
+static INT WINAPI procs_ymove( sg_devobj *obj, INT y, DWORD flags )
+{
+    INT res = 0;
+    core_DrvYMoveTo( &unidrv_core, obj, y, flags, &res );
+    return res;
+}
+
+static BOOL WINAPI procs_setting( void *obj, const char *feature, void *out, DWORD size, DWORD *needed, DWORD *count )
+{
+    struct unidrv_pdev *pdev = pdev_from_obj( obj );
+    return pdev && unidrv_get_driver_setting( pdev, feature, out, size, needed, count );
+}
+
+static BOOL WINAPI procs_stdvar( sg_devobj *obj, DWORD index, void *buf, DWORD size, DWORD *needed )
+{
+    struct unidrv_pdev *pdev = pdev_from_obj( obj );
+    return pdev && unidrv_standard_variable( pdev, index, buf, size, needed );
+}
+
+static BOOL WINAPI procs_textout( SURFOBJ *a, STROBJ *b, FONTOBJ *c, CLIPOBJ *d, RECTL *e, RECTL *f,
+                                  BRUSHOBJ *g, BRUSHOBJ *h, POINTL *i, MIX j )
+{
+    return TRUE;
+}
+
+static DWORD WINAPI procs_abort( sg_devobj *obj, void *buf, DWORD size, DWORD wait )
+{
+    DWORD ret = procs_write( obj, buf, size );
+    if (wait) Sleep( wait );
+    return ret;
+}
+
+static sg_drvprocs unidrv_procs =
+{
+    procs_write, procs_xmove, procs_ymove, procs_setting, procs_stdvar, procs_textout, procs_abort,
+};
+
+static const char *method_names[] =
+{
+    "ImageProcessing", "FilterGraphics", "CommandCallback", "Compression", "MemoryUsage",
+};
+
+BOOL oem_load( struct unidrv_pdev *pdev, HANDLE printer )
+{
+    HRESULT (WINAPI *get_class)( REFCLSID, REFIID, void ** );
+    struct oem_plugin *oem = &pdev->oem;
+    IClassFactory *factory;
+    IUnknown *unk;
+    WCHAR *file;
+    HRESULT hr;
+    DWORD sig = 0, size;
+    unsigned int i;
+
+    pdev->devobj.procs = &unidrv_procs;
+#ifdef SG_MUTANT_UNIOEM
+    return TRUE;
+#endif
+    if (!(file = unidrv_oem_file( printer, L"OEMDriverFile1" ))) return TRUE;
+    oem->module = LoadLibraryW( file );
+    TRACE( "render plug-in %s -> %p\n", debugstr_w(file), oem->module );
+    free( file );
+    if (!oem->module) return FALSE;
+
+    if (!(get_class = (void *)GetProcAddress( oem->module, "DllGetClassObject" )))
+    {
+        FIXME( "plug-in without a COM object (the old export interface) is not supported\n" );
+        return TRUE;
+    }
+    hr = get_class( &SG_CLSID_OEMRENDER, &IID_IClassFactory, (void **)&factory );
+    if (FAILED(hr)) { WARN( "no class object %#lx\n", hr ); return FALSE; }
+    hr = IClassFactory_CreateInstance( factory, NULL, &IID_IUnknown, (void **)&unk );
+    IClassFactory_Release( factory );
+    if (FAILED(hr)) { WARN( "CreateInstance %#lx\n", hr ); return FALSE; }
+    if (FAILED(IUnknown_QueryInterface( unk, &SG_IID_IPrintOemUni3, (void **)&oem->uni )) &&
+        FAILED(IUnknown_QueryInterface( unk, &SG_IID_IPrintOemUni2, (void **)&oem->uni )) &&
+        FAILED(IUnknown_QueryInterface( unk, &SG_IID_IPrintOemUni, (void **)&oem->uni )))
+    {
+        WARN( "no render interface\n" );
+        IUnknown_Release( unk );
+        return FALSE;
+    }
+    IUnknown_Release( unk );
+
+    if (SUCCEEDED(oem->uni->lpVtbl->GetInfo( oem->uni, SG_OEMGI_SIGNATURE, &sig, sizeof(sig), &size )))
+        oem->signature = sig;
+    oem->uni->lpVtbl->PublishDriverInterface( oem->uni, (IUnknown *)&unidrv_core );
+
+    for (i = 0; i < ARRAY_SIZE(method_names); i++)
+    {
+        BOOL has = oem->uni->lpVtbl->GetImplementedMethod( oem->uni, (char *)method_names[i] ) == S_OK;
+        switch (i)
+        {
+        case 0: oem->has_image_processing = has; break;
+        case 1: oem->has_filter_graphics = has; break;
+        case 2: oem->has_command_callback = has; break;
+        case 3: oem->has_compression = has; break;
+        case 4: oem->has_memory_usage = has; break;
+        }
+    }
+    hr = oem->uni->lpVtbl->EnableDriver( oem->uni, SG_OEMINTF_VERSION, sizeof(oem->hooks), &oem->hooks );
+    if (FAILED(hr)) memset( &oem->hooks, 0, sizeof(oem->hooks) );
+    TRACE( "plug-in %08lx: ip %d filter %d callback %d, %lu hooks\n", oem->signature,
+           oem->has_image_processing, oem->has_filter_graphics, oem->has_command_callback, oem->hooks.c );
+    return TRUE;
+}
+
+void oem_unload( struct unidrv_pdev *pdev )
+{
+    struct oem_plugin *oem = &pdev->oem;
+    if (oem->uni)
+    {
+        oem->uni->lpVtbl->DisableDriver( oem->uni );
+        oem->uni->lpVtbl->Release( oem->uni );
+    }
+    if (oem->module) FreeLibrary( oem->module );
+    memset( oem, 0, sizeof(*oem) );
+}
+
