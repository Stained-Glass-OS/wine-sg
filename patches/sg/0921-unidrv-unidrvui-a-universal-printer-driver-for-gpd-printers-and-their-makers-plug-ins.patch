+/*
+ * The print processor draws each page of a job into the surface we create
+ * (a plain bitmap; GDI's own engine draws on it) and calls us around it, as
+ * the DDI describes: DrvStartDoc, then per page DrvStartPage and DrvSendPage
+ * (or, for a page drawn in bands, DrvStartBanding and DrvNextBand), then
+ * DrvEndDoc.  We turn the bitmap into the printer's raster commands as the
+ * GPD says, and let the maker's plug-in take part where Unidrv lets it.
+ */
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
+
+#include "unidrv_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(unidrv);
+
+
+/* a band is at most this many bytes of bitmap */
+#define MAX_BAND_BYTES (16 * 1024 * 1024)
+
+static struct unidrv_pdev *get_pdev( DHPDEV dhpdev )
+{
+    struct unidrv_pdev *pdev = (struct unidrv_pdev *)dhpdev;
+    return pdev && pdev->magic == UNIDRV_PDEV_MAGIC ? pdev : NULL;
+}
+
+static struct unidrv_pdev *surf_pdev( SURFOBJ *so )
+{
+    return so ? get_pdev( so->dhpdev ) : NULL;
+}
+
+BOOL unidrv_write( struct unidrv_pdev *pdev, const void *data, DWORD size )
+{
+    DWORD written = 0;
+    if (!size) return TRUE;
+    return EngWritePrinter( pdev->printer, (void *)data, size, &written ) && written == size;
+}
+
+/* ---- settings the plug-in may ask about ---- */
+
+BOOL unidrv_get_driver_setting( struct unidrv_pdev *pdev, const char *feature, void *out, DWORD size,
+                                DWORD *needed, DWORD *count )
+{
+    const char *value;
+    DWORD len;
+    int f;
+
+    if (!((ULONG_PTR)feature >> 16))
+    {
+        /* a numbered setting; we keep none of these, all are zero */
+        if (needed) *needed = sizeof(DWORD);
+        if (count) *count = 1;
+        if (!out || size < sizeof(DWORD))
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        *(DWORD *)out = 0;
+        return TRUE;
+    }
+    if ((f = gpd_find_feature( pdev->gpd, feature )) < 0)
+    {
+        TRACE( "unknown feature %s\n", debugstr_a(feature) );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    value = pdev->gpd->features[f].options[pdev->sel[f]].name;
+    len = strlen( value ) + 2;  /* a list of one, doubly terminated */
+    if (needed) *needed = len;
+    if (count) *count = 1;
+    TRACE( "%s = %s\n", debugstr_a(feature), debugstr_a(value) );
+    if (!out || size < len)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    memset( out, 0, len );
+    strcpy( out, value );
+    return TRUE;
+}
+
+static const char *std_var_names[SG_SVI_MAX] =
+{
+    "NumOfDataBytes", "RasterDataWidthInBytes", "RasterDataHeightInPixels", "NumOfCopies",
+    "PrintDirInCCDegrees", "DestX", "DestY", "DestXRel", "DestYRel", "LinefeedSpacing", "RectXSize",
+    "RectYSize", "GrayPercentage", "NextFontID", "NextGlyph", "PhysPaperLength", "PhysPaperWidth",
+    "FontHeight", "FontWidth", "FontMaxWidth", "FontBold", "FontItalic", "FontUnderline",
+    "FontStrikeThru", "CurrentFontID", "TextYRes", "TextXRes", "GraphicsYRes", "GraphicsXRes", "Rop3",
+    "RedValue", "GreenValue", "BlueValue", "PaletteIndexToProgram", "CurrentPaletteIndex",
+    "PatternBrushType", "PatternBrushID", "PatternBrushSize", "CursorOriginX", "CursorOriginY", "PageNumber",
+};
+
+static BOOL std_var( struct unidrv_pdev *pdev, DWORD index, int *v )
+{
+    int mx = 0, my = 0;
+
+    gpd_pair( pdev->gpd, gpd_global( pdev->gpd, pdev->sel, "MasterUnits" ), &mx, &my );
+    if (mx <= 0) mx = pdev->dpi_x;
+    if (my <= 0) my = pdev->dpi_y;
+    switch (index)
+    {
+    case SG_SVI_NUMDATABYTES: *v = pdev->data_bytes; return TRUE;
+    case SG_SVI_WIDTHINBYTES: *v = pdev->width_bytes; return TRUE;
+    case SG_SVI_HEIGHTINPIXELS: *v = pdev->height_pixels; return TRUE;
+    case SG_SVI_COPIES: *v = 1; return TRUE;  /* the print processor sends each copy */
+    case SG_SVI_PRINTDIRECTION: *v = 0; return TRUE;
+    case SG_SVI_DESTX: *v = MulDiv( pdev->cur_x, mx, pdev->dpi_x ); return TRUE;
+    case SG_SVI_DESTY: *v = MulDiv( pdev->cur_y, my, pdev->dpi_y ); return TRUE;
+    case SG_SVI_PHYSPAPERLENGTH: *v = MulDiv( pdev->landscape ? pdev->page_w : pdev->page_h, my, pdev->dpi_y ); return TRUE;
+    case SG_SVI_PHYSPAPERWIDTH: *v = MulDiv( pdev->landscape ? pdev->page_h : pdev->page_w, mx, pdev->dpi_x ); return TRUE;
+    case SG_SVI_TEXTXRES: case SG_SVI_GRAPHICSXRES: *v = pdev->dpi_x; return TRUE;
+    case SG_SVI_TEXTYRES: case SG_SVI_GRAPHICSYRES: *v = pdev->dpi_y; return TRUE;
+    case SG_SVI_PAGENUMBER: *v = pdev->page; return TRUE;
+    case SG_SVI_CURSORORIGINX: case SG_SVI_CURSORORIGINY: *v = 0; return TRUE;
+    }
+    if (index < SG_SVI_MAX) { *v = 0; return TRUE; }
+    return FALSE;
+}
+
+BOOL unidrv_standard_variable( struct unidrv_pdev *pdev, DWORD index, void *buf, DWORD size, DWORD *needed )
+{
+    int v;
+    if (needed) *needed = sizeof(DWORD);
+    if (!std_var( pdev, index, &v )) return FALSE;
+    if (!buf || size < sizeof(DWORD)) return FALSE;
+    *(DWORD *)buf = v;
+    return TRUE;
+}
+
+static BOOL cmd_var( void *ctx, const char *name, int *value )
+{
+    struct unidrv_pdev *pdev = ctx;
+    unsigned int i;
+    for (i = 0; i < SG_SVI_MAX; i++)
+        if (std_var_names[i] && !strcmp( std_var_names[i], name )) return std_var( pdev, i, value );
+    if (!strcmp( name, "NumOfCopies" )) { *value = 1; return TRUE; }
+    TRACE( "unknown variable %s\n", debugstr_a(name) );
+    return FALSE;
+}
+
+/* sends one GPD command, by way of the plug-in when it has a callback */
+static void send_command( struct unidrv_pdev *pdev, const struct gpd_command *cmd )
+{
+    BYTE buf[1024];
+    int len;
+
+    if (cmd->callback >= 0 && pdev->oem.uni && pdev->oem.has_command_callback)
+    {
+        DWORD params[16] = { 0 };
+        INT result = 0;
+        DWORD count = 0;
+        if (cmd->params)
+        {
+            /* LIST(var, var...) */
+            char tmp[256], *p, *tok;
+            lstrcpynA( tmp, cmd->params, sizeof(tmp) );
+            if ((p = strchr( tmp, '(' ))) p++; else p = tmp;
+            for (tok = strtok( p, ",) " ); tok && count < 16; tok = strtok( NULL, ",) " ))
+            {
+                int v = 0;
+                cmd_var( pdev, tok, &v );
+                params[count++] = v;
+            }
+        }
+        pdev->oem.uni->lpVtbl->CommandCallback( pdev->oem.uni, &pdev->devobj, cmd->callback, count, params, &result );
+        return;
+    }
+    if (!cmd->cmd) return;
+    len = gpd_build_command( cmd->cmd, cmd_var, pdev, buf, sizeof(buf) );
+    if (len > sizeof(buf)) len = sizeof(buf);
+    if (len) unidrv_write( pdev, buf, len );
+}
+
+static void send_named( struct unidrv_pdev *pdev, const char *name )
+{
+    struct gpd_command cmd;
+    if (gpd_command( pdev->gpd, pdev->sel, name, &cmd )) send_command( pdev, &cmd );
+}
+
+static void send_section( struct unidrv_pdev *pdev, enum gpd_section section )
+{
+    struct gpd_command cmds[UNIDRV_MAX_FEATURES + 8];
+    unsigned int count = gpd_section_commands( pdev->gpd, pdev->sel, section, cmds, ARRAY_SIZE(cmds) ), i;
+    for (i = 0; i < count; i++) send_command( pdev, &cmds[i] );
+}
+
+/* ---- raster output ---- */
+
+/* error diffusion to one bit per pixel, 1 = ink */
+static BYTE *dither_band( const BYTE *bits, int stride, int w, int h, int bpp, int *out_stride )
+{
+    int ostride = ((w + 31) / 32) * 4, x, y;
+    BYTE *out = calloc( ostride, h );
+    short *err = calloc( w + 2, sizeof(short) ), *next = calloc( w + 2, sizeof(short) );
+
+    for (y = 0; y < h; y++)
+    {
+        const BYTE *row = bits + y * stride;
+        memset( next, 0, (w + 2) * sizeof(short) );
+        for (x = 0; x < w; x++)
+        {
+            int gray, v, e;
+            if (bpp == 24) gray = (row[x * 3] * 29 + row[x * 3 + 1] * 150 + row[x * 3 + 2] * 77) >> 8;
+            else gray = (row[x * 4] * 29 + row[x * 4 + 1] * 150 + row[x * 4 + 2] * 77) >> 8;
+            v = gray + err[x + 1];
+            if (v < 128) { out[y * ostride + x / 8] |= 0x80 >> (x % 8); e = v; }
+            else e = v - 255;
+            err[x + 2] += e * 7 / 16;
+            next[x] += e * 3 / 16;
+            next[x + 1] += e * 5 / 16;
+            next[x + 2] += e / 16;
+        }
+        memcpy( err, next, (w + 2) * sizeof(short) );
+    }
+    free( err );
+    free( next );
+    *out_stride = ostride;
+    return out;
+}
+
+static BOOL row_blank( const BYTE *row, int bytes )
+{
+    int i;
+    for (i = 0; i < bytes; i++) if (row[i]) return FALSE;
+    return TRUE;
+}
+
+/* sends a band's rows as the GPD describes (no plug-in filter) */
+static void send_rows( struct unidrv_pdev *pdev, const BYTE *data, int stride, int bytes, int rows, int y0 )
+{
+    int y;
+
+    for (y = 0; y < rows; y++)
+    {
+        const BYTE *row = data + y * stride;
+        int len = bytes;
+
+        if (pdev->strip_trailing) while (len && !row[len - 1]) len--;
+        if (!len && row_blank( row, bytes )) continue;
+        pdev->cur_y = y0 + y;
+        send_named( pdev, "CmdYMoveAbsolute" );
+        pdev->data_bytes = len;
+        pdev->width_bytes = len;
+        pdev->height_pixels = 1;
+        send_named( pdev, "CmdSendBlockData" );
+        unidrv_write( pdev, row, len );
+        send_named( pdev, "CmdEndBlockData" );
+    }
+    pdev->cur_y = y0 + rows;
+}
+
+/* rotates a band for landscape pages: the surface holds the page as the
+ * program drew it, the printer wants the sheet */
+static BYTE *rotate_bitmap( const BYTE *bits, int stride, int w, int h, int bytespp, BOOL ccw270,
+                            int *out_stride )
+{
+    int ostride = (h * bytespp + 3) & ~3, x, y;
+    BYTE *out = malloc( ostride * w );
+
+    for (y = 0; y < h; y++)
+    {
+        const BYTE *src = bits + y * stride;
+        for (x = 0; x < w; x++)
+        {
+            int sx, sy;
+            /* page (x, y) on the sheet; the sheet is h wide and w high */
+            if (ccw270) { sx = h - 1 - y; sy = x; }
+            else { sx = y; sy = w - 1 - x; }
+            memcpy( out + sy * ostride + sx * bytespp, src + x * bytespp, bytespp );
+        }
+    }
+    *out_stride = ostride;
+    return out;
+}
+
+static void process_band( struct unidrv_pdev *pdev, SURFOBJ *so, POINTL origin, int rows, BOOL banding )
+{
+    const BYTE *bits = so->pvScan0;
+    int stride = so->lDelta, w = so->sizlBitmap.cx, h = rows;
+    BYTE *rotated = NULL, *dithered = NULL, *result = NULL;
+    int bytespp = pdev->drv_bpp / 8, out_stride, out_bytes;
+    POINT offset = { origin.x, origin.y };
+
+    if (pdev->landscape && bytespp)
+    {
+        int f = gpd_find_feature( pdev->gpd, "Orientation" );
+        BOOL ccw270 = f >= 0 && strstr( pdev->gpd->features[f].options[pdev->sel[f]].name, "CC270" ) != NULL;
+        int t;
+        rotated = rotate_bitmap( bits, stride, w, h, bytespp, ccw270, &stride );
+        bits = rotated;
+        t = w; w = h; h = t;
+        offset.x = offset.y = 0;
+    }
+
+    if (pdev->drv_bpp >= 24 && pdev->oem.uni && pdev->oem.has_image_processing && pdev->ip_callback >= 0)
+    {
+        BITMAPINFOHEADER bih = { sizeof(bih), w, h, 1, pdev->drv_bpp, BI_RGB };
+        sg_ipparams ip = { sizeof(ip) };
+        HRESULT hr;
+
+        bih.biSizeImage = stride * h;
+        bih.biXPelsPerMeter = MulDiv( pdev->dpi_x, 10000, 254 );
+        bih.biYPelsPerMeter = MulDiv( pdev->dpi_y, 10000, 254 );
+        ip.offset = offset;
+        ip.halftone = (char *)"ErrorDiffusion";
+        ip.banding = banding;
+        hr = pdev->oem.uni->lpVtbl->ImageProcessing( pdev->oem.uni, &pdev->devobj, (BYTE *)bits, &bih, NULL,
+                                                     pdev->ip_callback, &ip, &result );
+        TRACE( "ImageProcessing %dx%d -> %#lx %p\n", w, h, hr, result );
+        if (FAILED(hr) || !result) goto done;  /* the plug-in sent the band itself */
+        out_stride = ((w * pdev->dev_bpp + 31) / 32) * 4;
+    }
+    else if (pdev->drv_bpp >= 24)
+    {
+        dithered = dither_band( bits, stride, w, h, pdev->drv_bpp, &out_stride );
+        result = dithered;
+    }
+    else
+    {
+        result = (BYTE *)bits;
+        out_stride = stride;
+    }
+    out_bytes = (w * pdev->dev_bpp + 7) / 8;
+
+    if (pdev->oem.uni && pdev->oem.has_filter_graphics)
+    {
+        int y;
+        for (y = 0; y < h; y++)
+        {
+            pdev->data_bytes = pdev->width_bytes = out_bytes;
+            pdev->height_pixels = 1;
+            pdev->oem.uni->lpVtbl->FilterGraphics( pdev->oem.uni, &pdev->devobj, result + y * out_stride, out_bytes );
+        }
+    }
+    else send_rows( pdev, result, out_stride, out_bytes, h, offset.y );
+
+done:
+    free( rotated );
+    free( dithered );
+}
+
+/* ---- our own entry points; a plug-in's hooks call these ---- */
+
+static BOOL WINAPI core_StartDoc( SURFOBJ *so, WCHAR *doc_name, DWORD job_id )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    TRACE( "%p %s %lu\n", so, debugstr_w(doc_name), job_id );
+    if (!pdev) return FALSE;
+    pdev->job_id = job_id;
+    pdev->page = 0;
+    send_section( pdev, SEC_JOB_SETUP );
+    send_section( pdev, SEC_DOC_SETUP );
+    return TRUE;
+}
+
+static void erase_surface( SURFOBJ *so, BYTE value )
+{
+    int y;
+    for (y = 0; y < so->sizlBitmap.cy; y++)
+        memset( (BYTE *)so->pvScan0 + y * so->lDelta, value, abs( so->lDelta ) );
+}
+
+static BOOL WINAPI core_StartPage( SURFOBJ *so )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    TRACE( "%p\n", so );
+    if (!pdev) return FALSE;
+    pdev->page++;
+    pdev->cur_x = pdev->cur_y = 0;
+    send_section( pdev, SEC_PAGE_SETUP );
+    return TRUE;
+}
+
+static void finish_page( struct unidrv_pdev *pdev )
+{
+    send_section( pdev, SEC_PAGE_FINISH );
+    if (gpd_bool( pdev->gpd, gpd_global( pdev->gpd, pdev->sel, "EjectPageWithFF?" ), TRUE ))
+        send_named( pdev, "CmdFF" );
+}
+
+static BOOL WINAPI core_SendPage( SURFOBJ *so )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    POINTL origin = { 0, 0 };
+    TRACE( "%p\n", so );
+    if (!pdev) return FALSE;
+    process_band( pdev, so, origin, so->sizlBitmap.cy, FALSE );
+    finish_page( pdev );
+    return TRUE;
+}
+
+static BOOL WINAPI core_StartBanding( SURFOBJ *so, POINTL *pt )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    if (!pdev) return FALSE;
+    pt->x = 0;
+    pt->y = 0;
+    pdev->cur_y = 0;
+    return TRUE;
+}
+
+static BOOL WINAPI core_NextBand( SURFOBJ *so, POINTL *pt )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    int rows;
+
+    if (!pdev) return FALSE;
+    rows = min( so->sizlBitmap.cy, pdev->print_h - pt->y );
+    if (rows > 0) process_band( pdev, so, *pt, rows, TRUE );
+    pt->y += so->sizlBitmap.cy;
+    if (pt->y >= pdev->print_h)
+    {
+        finish_page( pdev );
+        pt->x = pt->y = -1;
+    }
+    return TRUE;
+}
+
+static BOOL WINAPI core_EndDoc( SURFOBJ *so, FLONG flags )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    TRACE( "%p %#lx\n", so, flags );
+    if (!pdev) return FALSE;
+    send_section( pdev, SEC_DOC_FINISH );
+    send_section( pdev, SEC_JOB_FINISH );
+    return TRUE;
+}
+
+static BOOL WINAPI core_true( void ) { return TRUE; }
+
+static DRVFN core_table[] =
+{
+    { INDEX_DrvStartDoc, (PFN)core_StartDoc },
+    { INDEX_DrvStartPage, (PFN)core_StartPage },
+    { INDEX_DrvSendPage, (PFN)core_SendPage },
+    { INDEX_DrvEndDoc, (PFN)core_EndDoc },
+    { INDEX_DrvStartBanding, (PFN)core_StartBanding },
+    { INDEX_DrvNextBand, (PFN)core_NextBand },
+    /* drawing reaches the surface through the engine; a plug-in hook that
+     * passes a drawing call on finds it done */
+    { INDEX_DrvBitBlt, (PFN)core_true }, { INDEX_DrvCopyBits, (PFN)core_true },
+    { INDEX_DrvStretchBlt, (PFN)core_true }, { INDEX_DrvStretchBltROP, (PFN)core_true },
+    { INDEX_DrvTextOut, (PFN)core_true }, { INDEX_DrvStrokePath, (PFN)core_true },
+    { INDEX_DrvFillPath, (PFN)core_true }, { INDEX_DrvStrokeAndFillPath, (PFN)core_true },
+    { INDEX_DrvPaint, (PFN)core_true }, { INDEX_DrvLineTo, (PFN)core_true },
+    { INDEX_DrvPlgBlt, (PFN)core_true }, { INDEX_DrvAlphaBlend, (PFN)core_true },
+    { INDEX_DrvGradientFill, (PFN)core_true }, { INDEX_DrvTransparentBlt, (PFN)core_true },
+};
+
+static PFN oem_hook( struct unidrv_pdev *pdev, ULONG index )
+{
+    ULONG i;
+    for (i = 0; i < pdev->oem.hooks.c; i++)
+        if (pdev->oem.hooks.pdrvfn[i].iFunc == index) return pdev->oem.hooks.pdrvfn[i].pfn;
+    return NULL;
+}
