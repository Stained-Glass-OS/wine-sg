+BOOL WINAPI DrvEndDoc( SURFOBJ *so, FLONG flags )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    BOOL (WINAPI *hook)( SURFOBJ *, FLONG );
+    if (pdev && (hook = (void *)oem_hook( pdev, INDEX_DrvEndDoc ))) return hook( so, flags );
+    return core_EndDoc( so, flags );
+}
