+static int paper_feature( struct gpd *gpd ) { return gpd_find_feature( gpd, "PaperSize" ); }
+
+int unidrv_master_units( struct gpd *gpd, int *mx, int *my )
+{
+    if (!gpd_pair( gpd, gpd_global( gpd, NULL, "MasterUnits" ), mx, my ) || *mx <= 0 || *my <= 0)
+        *mx = *my = 600;
+    return TRUE;
+}
+
+/* the paper id a devmode uses for an option */
+short unidrv_paper_id( struct gpd *gpd, int feature, unsigned int opt )
+{
+    const char *name = gpd->features[feature].options[opt].name;
+    const char *id = gpd_option_attr( gpd, NULL, feature, opt, "OptionID" );
+    unsigned int i;
+    int n;
+
+    if (id && gpd_int( gpd, id, &n )) return n;
+    for (i = 0; i < ARRAY_SIZE(std_papers); i++)
+        if (!_stricmp( name, std_papers[i].name )) return std_papers[i].id;
+    if (!strcmp( name, "CUSTOMSIZE" )) return DMPAPER_USER;
+    return 256 + opt;
+}
+
+/* the sheet of a paper option, in master units, unrotated */
+BOOL unidrv_paper_size( struct gpd *gpd, int feature, unsigned int opt, int *w, int *h )
+{
+    const char *name = gpd->features[feature].options[opt].name;
+    int mx, my;
+    unsigned int i;
+
+    unidrv_master_units( gpd, &mx, &my );
+    if (gpd_pair( gpd, gpd_option_attr( gpd, NULL, feature, opt, "PageDimensions" ), w, h )) return TRUE;
+    for (i = 0; i < ARRAY_SIZE(std_papers); i++)
+    {
+        if (_stricmp( name, std_papers[i].name )) continue;
+        *w = MulDiv( std_papers[i].w, mx, 25400 );
+        *h = MulDiv( std_papers[i].h, my, 25400 );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+void unidrv_geometry( struct gpd *gpd, const gpd_sel *sel, const DEVMODEW *dm, int *dpi_x, int *dpi_y,
+                      int *page_w, int *page_h, int *px, int *py, int *pw, int *ph, BOOL *landscape )
+{
+    int mx, my, w = 0, h = 0, ax, ay, ox, oy;
+    int feature = paper_feature( gpd );
+    const char *orient = NULL;
+    int f;
+
+    unidrv_master_units( gpd, &mx, &my );
+    if (!gpd_pair( gpd, gpd_selected_attr( gpd, sel, "Resolution", "DPI" ), dpi_x, dpi_y ))
+        *dpi_x = mx, *dpi_y = my;
+
+    if (feature >= 0 && !strcmp( gpd->features[feature].options[sel[feature]].name, "CUSTOMSIZE" ))
+    {
+        /* tenths of a millimetre from the devmode */
+        w = dm && dm->dmPaperWidth ? MulDiv( dm->dmPaperWidth, mx, 254 ) : MulDiv( 8500, mx, 1000 );
+        h = dm && dm->dmPaperLength ? MulDiv( dm->dmPaperLength, my, 254 ) : MulDiv( 11000, my, 1000 );
+        ax = w; ay = h; ox = oy = 0;
+        if (gpd_int( gpd, gpd_option_attr( gpd, sel, feature, sel[feature], "MaxPrintableWidth" ), &f ) && ax > f)
+            ax = f;
+        if (gpd_int( gpd, gpd_option_attr( gpd, sel, feature, sel[feature], "MinLeftMargin" ), &f )) ox = f;
+        if (ox + ax > w) ax = w - ox;
+    }
+    else
+    {
+        if (feature < 0 || !unidrv_paper_size( gpd, feature, sel[feature], &w, &h ))
+            w = MulDiv( 8500, mx, 1000 ), h = MulDiv( 11000, my, 1000 );
+        if (feature < 0 || !gpd_pair( gpd, gpd_option_attr( gpd, sel, feature, sel[feature], "PrintableArea" ), &ax, &ay ))
+            ax = w, ay = h;
+        if (feature < 0 || !gpd_pair( gpd, gpd_option_attr( gpd, sel, feature, sel[feature], "PrintableOrigin" ), &ox, &oy ))
+            ox = (w - ax) / 2, oy = (h - ay) / 2;
+    }
+
+    f = gpd_find_feature( gpd, "Orientation" );
+    if (f >= 0) orient = gpd->features[f].options[sel[f]].name;
+    *landscape = orient && strncmp( orient, "PORTRAIT", 8 );
+
+    /* master units to device pixels */
+    w = MulDiv( w, *dpi_x, mx );
+    h = MulDiv( h, *dpi_y, my );
+    ax = MulDiv( ax, *dpi_x, mx );
+    ay = MulDiv( ay, *dpi_y, my );
+    ox = MulDiv( ox, *dpi_x, mx );
+    oy = MulDiv( oy, *dpi_y, my );
+
+    if (*landscape)
+    {
+        /* the page as the program sees it: turned */
+        int t;
+        if (orient && strstr( orient, "CC270" ))
+        {
+            /* turned clockwise onto the sheet: the page's top is the sheet's right */
+            t = oy; oy = w - (ox + ax); ox = t;
+        }
+        else
+        {
+            /* turned counter-clockwise: the page's top is the sheet's left */
+            t = ox; ox = h - (oy + ay); oy = t;
+        }
+        t = w; w = h; h = t;
+        t = ax; ax = ay; ay = t;
+        t = *dpi_x; *dpi_x = *dpi_y; *dpi_y = t;
+    }
+    *page_w = w; *page_h = h;
+    *px = ox; *py = oy; *pw = ax; *ph = ay;
+}
+
+static BOOL dm_private_valid( struct gpd *gpd, const DEVMODEW *dm )
+{
+    const struct unidrv_dm *priv;
+    if (!dm || dm->dmDriverExtra < sizeof(struct unidrv_dm)) return FALSE;
+    priv = (const struct unidrv_dm *)((const BYTE *)dm + dm->dmSize);
+    return priv->signature == UNIDRV_DM_SIGNATURE && priv->feature_count == gpd->feature_count;
+}
+
+void unidrv_devmode_to_sel( struct gpd *gpd, const DEVMODEW *dm, gpd_sel *sel )
+{
+    int feature;
+    unsigned int i;
+
+    gpd_default_selection( gpd, sel );
+    if (dm_private_valid( gpd, dm ))
+    {
+        const struct unidrv_dm *priv = (const struct unidrv_dm *)((const BYTE *)dm + dm->dmSize);
+        for (i = 0; i < gpd->feature_count && i < UNIDRV_MAX_FEATURES; i++)
+            if (priv->sel[i] < gpd->features[i].option_count) sel[i] = priv->sel[i];
+    }
+    if (!dm) return;
+
+    if ((dm->dmFields & DM_ORIENTATION) && (feature = gpd_find_feature( gpd, "Orientation" )) >= 0)
+    {
+        for (i = 0; i < gpd->features[feature].option_count; i++)
+        {
+            BOOL portrait = !strncmp( gpd->features[feature].options[i].name, "PORTRAIT", 8 );
+            if (portrait == (dm->dmOrientation != DMORIENT_LANDSCAPE)) { sel[feature] = i; break; }
+        }
+    }
+    if ((feature = paper_feature( gpd )) >= 0)
+    {
+        BOOL found = FALSE;
+        if (dm->dmFields & DM_PAPERSIZE)
+        {
+            for (i = 0; i < gpd->features[feature].option_count; i++)
+                if (unidrv_paper_id( gpd, feature, i ) == dm->dmPaperSize) { sel[feature] = i; found = TRUE; break; }
+        }
+        if (!found && (dm->dmFields & DM_FORMNAME) && dm->dmFormName[0])
+        {
+            WCHAR name[CCHFORMNAME + 64], optname[64];
+            for (i = 0; i < gpd->features[feature].option_count; i++)
+            {
+                gpd_display_name( gpd, feature, i, name, ARRAY_SIZE(name) );
+                MultiByteToWideChar( CP_ACP, 0, gpd->features[feature].options[i].name, -1, optname, 64 );
+                if (!wcsnicmp( name, dm->dmFormName, CCHFORMNAME - 1 ) || !wcsicmp( optname, dm->dmFormName ))
+                {
+                    sel[feature] = i;
+                    found = TRUE;
+                    break;
+                }
+            }
+        }
+        if (!found && (dm->dmFields & (DM_PAPERWIDTH | DM_PAPERLENGTH)) == (DM_PAPERWIDTH | DM_PAPERLENGTH) &&
+            dm->dmPaperWidth && dm->dmPaperLength)
+        {
+            /* a size only: the option of that size, or a custom size */
+            int mx, my, w, h;
+            unidrv_master_units( gpd, &mx, &my );
+            for (i = 0; i < gpd->features[feature].option_count; i++)
+            {
+                if (!unidrv_paper_size( gpd, feature, i, &w, &h )) continue;
+                if (abs( MulDiv( w, 254, mx ) - dm->dmPaperWidth ) <= 3 &&
+                    abs( MulDiv( h, 254, my ) - dm->dmPaperLength ) <= 3)
+                {
+                    sel[feature] = i;
+                    found = TRUE;
+                    break;
+                }
+            }
+            if (!found && (i = gpd_find_option( gpd, feature, "CUSTOMSIZE" )) != (unsigned int)-1)
+                sel[feature] = i;
+        }
+    }
+    if ((dm->dmFields & DM_PRINTQUALITY) && dm->dmPrintQuality > 0 &&
+        (feature = gpd_find_feature( gpd, "Resolution" )) >= 0)
+    {
+        for (i = 0; i < gpd->features[feature].option_count; i++)
+        {
+            int x, y;
+            if (gpd_pair( gpd, gpd_option_attr( gpd, NULL, feature, i, "DPI" ), &x, &y ) &&
+                x == dm->dmPrintQuality &&
+                (!(dm->dmFields & DM_YRESOLUTION) || dm->dmYResolution <= 0 || y == dm->dmYResolution))
+            {
+                sel[feature] = i;
+                break;
+            }
+        }
+    }
+    if ((dm->dmFields & DM_DEFAULTSOURCE) && (feature = gpd_find_feature( gpd, "InputBin" )) >= 0)
+    {
+        for (i = 0; i < gpd->features[feature].option_count; i++)
+        {
+            const char *id = gpd_option_attr( gpd, NULL, feature, i, "OptionID" );
+            int n;
+            if (id && gpd_int( gpd, id, &n ) && n == dm->dmDefaultSource) { sel[feature] = i; break; }
+        }
+    }
+}
+
+void unidrv_sel_to_devmode( struct gpd *gpd, const gpd_sel *sel, DEVMODEW *dm )
+{
+    struct unidrv_dm *priv = (struct unidrv_dm *)((BYTE *)dm + dm->dmSize);
+    int feature, mx, my, w, h, x, y;
+    unsigned int i;
+
+    if (dm->dmDriverExtra >= sizeof(*priv))
+    {
+        memset( priv->reserved, 0, sizeof(priv->reserved) );
+        priv->size = sizeof(*priv);
+        priv->feature_count = gpd->feature_count;
+        priv->signature = UNIDRV_DM_SIGNATURE;
+        for (i = 0; i < gpd->feature_count && i < UNIDRV_MAX_FEATURES; i++) priv->sel[i] = sel[i];
+    }
+    unidrv_master_units( gpd, &mx, &my );
+    if ((feature = gpd_find_feature( gpd, "Orientation" )) >= 0)
+    {
+        dm->dmFields |= DM_ORIENTATION;
+        dm->dmOrientation = strncmp( gpd->features[feature].options[sel[feature]].name, "PORTRAIT", 8 )
+                            ? DMORIENT_LANDSCAPE : DMORIENT_PORTRAIT;
+    }
+    if ((feature = paper_feature( gpd )) >= 0)
+    {
+        unsigned int opt = sel[feature];
+        dm->dmFields |= DM_PAPERSIZE | DM_FORMNAME;
+        dm->dmPaperSize = unidrv_paper_id( gpd, feature, opt );
+        if (unidrv_paper_size( gpd, feature, opt, &w, &h ))
+        {
+            dm->dmFields |= DM_PAPERWIDTH | DM_PAPERLENGTH;
+            dm->dmPaperWidth = MulDiv( w, 254, mx );
+            dm->dmPaperLength = MulDiv( h, 254, my );
+        }
+        gpd_display_name( gpd, feature, opt, dm->dmFormName, CCHFORMNAME );
+    }
+    if (gpd_pair( gpd, gpd_selected_attr( gpd, sel, "Resolution", "DPI" ), &x, &y ))
+    {
+        dm->dmFields |= DM_PRINTQUALITY | DM_YRESOLUTION;
+        dm->dmPrintQuality = x;
+        dm->dmYResolution = y;
+    }
+    dm->dmFields |= DM_COLOR;
+    dm->dmColor = gpd_bool( gpd, gpd_selected_attr( gpd, sel, "ColorMode", "Color?" ), FALSE )
+                  ? DMCOLOR_COLOR : DMCOLOR_MONOCHROME;
+}
+
+DEVMODEW *unidrv_default_devmode( struct gpd *gpd, const WCHAR *name, DWORD oem_size )
+{
+    DEVMODEW *dm = calloc( 1, sizeof(DEVMODEW) + sizeof(struct unidrv_dm) + oem_size );
+    gpd_sel sel[UNIDRV_MAX_FEATURES];
+
+    dm->dmSize = sizeof(DEVMODEW);
+    dm->dmSpecVersion = DM_SPECVERSION;
+    dm->dmDriverVersion = 0x600;
+    dm->dmDriverExtra = sizeof(struct unidrv_dm) + oem_size;
+    if (name) lstrcpynW( dm->dmDeviceName, name, CCHDEVICENAME );
+    dm->dmFields = DM_COPIES | DM_SCALE;
+    dm->dmCopies = 1;
+    dm->dmScale = 100;
+    gpd_default_selection( gpd, sel );
+    unidrv_sel_to_devmode( gpd, sel, dm );
+    return dm;
+}
+
+static WCHAR *driver_path( const WCHAR *file, const WCHAR *dir )
+{
+    WCHAR *ret;
+    if (!file) return NULL;
+    if (wcschr( file, '\\' )) return wcsdup( file );
+    ret = malloc( (wcslen( dir ) + wcslen( file ) + 2) * sizeof(WCHAR) );
+    swprintf( ret, wcslen( dir ) + wcslen( file ) + 2, L"%s\\%s", dir, file );
+    return ret;
+}
+
+static DRIVER_INFO_3W *get_driver_info( HANDLE printer )
+{
+    DRIVER_INFO_3W *info;
+    DWORD needed = 0;
+
+    GetPrinterDriverW( printer, NULL, 3, NULL, 0, &needed );
+    if (!needed || !(info = malloc( needed ))) return NULL;
+    if (!GetPrinterDriverW( printer, NULL, 3, (BYTE *)info, needed, &needed ))
+    {
+        free( info );
+        return NULL;
+    }
+    return info;
+}
+
+struct gpd *unidrv_load_printer_gpd( HANDLE printer )
+{
+    DRIVER_INFO_3W *info = get_driver_info( printer );
+    struct gpd *gpd = NULL;
+    WCHAR dir[MAX_PATH], *path;
+    DWORD size;
+
+    if (!info) return NULL;
+    if (!GetPrinterDriverDirectoryW( NULL, NULL, 1, (BYTE *)dir, sizeof(dir), &size )) dir[0] = 0;
+    lstrcatW( dir, L"\\3" );
+    if ((path = driver_path( info->pDataFile, dir )))
+    {
+        gpd = gpd_load( path );
+        free( path );
+    }
+    free( info );
+    return gpd;
+}
+
+/* the plug-in files named by the driver's .ini dependent file */
+WCHAR *unidrv_oem_file( HANDLE printer, const WCHAR *key )
+{
+    DRIVER_INFO_3W *info = get_driver_info( printer );
+    WCHAR dir[MAX_PATH], value[MAX_PATH], *ret = NULL, *p;
+    DWORD size;
+
+    if (!info) return NULL;
+    if (!GetPrinterDriverDirectoryW( NULL, NULL, 1, (BYTE *)dir, sizeof(dir), &size )) dir[0] = 0;
+    lstrcatW( dir, L"\\3" );
+    for (p = info->pDependentFiles; p && *p; p += wcslen( p ) + 1)
+    {
+        const WCHAR *ext = wcsrchr( p, '.' );
+        WCHAR *ini;
+        if (!ext || wcsicmp( ext, L".ini" )) continue;
+        ini = driver_path( p, dir );
+        if (GetPrivateProfileStringW( L"OEMFiles", key, L"", value, MAX_PATH, ini ))
+        {
+            WCHAR *base = wcsrchr( value, '\\' ) ? wcsrchr( value, '\\' ) + 1 : value;
+            WCHAR inidir[MAX_PATH], *slash;
+            lstrcpynW( inidir, ini, MAX_PATH );
+            if ((slash = wcsrchr( inidir, '\\' ))) *slash = 0;
+            ret = driver_path( base, inidir );
+        }
+        free( ini );
+        if (ret) break;
+    }
+    free( info );
+    TRACE( "%s -> %s\n", debugstr_w(key), debugstr_w(ret) );
+    return ret;
+}
+
+/* the size of the render plug-in's private devmode part */
+DWORD oem_dm_size_from( sg_oemuni *uni, HMODULE module )
+{
+    sg_oemdmparam param = { sizeof(param) };
+    param.oem_module = module;
+    if (FAILED(uni->lpVtbl->DevMode( uni, SG_OEMDM_SIZE, &param ))) return 0;
+    return param.out_size;
+}
