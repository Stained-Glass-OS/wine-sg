+/*
+ * A GPD file is a list of "*Keyword: value" entries.  Some keywords open a
+ * construct whose entries follow in braces: *Feature, *Option, *switch,
+ * *case, *default, *Command, *Macros and a few more.  We read the whole file
+ * (and its *Include files) into a tree and answer questions about it given
+ * the option chosen for each feature.
+ */
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+
+#include "unidrv_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(unidrv);
+
+static const char *constructs[] =
+{
+    "Feature", "Option", "switch", "case", "default", "Command", "Macros", "BlockMacro",
+    "UIGroup", "Font", "TTFS", "OEM", "FontCartridge", "Case", "Switch", "Default",
+};
+
+static BOOL is_construct( const char *key )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(constructs); i++)
+        if (!strcmp( key, constructs[i] )) return TRUE;
+    return FALSE;
+}
+
+static struct gpd_node *node_new( const char *key, int key_len )
+{
+    struct gpd_node *node = calloc( 1, sizeof(*node) );
+    node->key = malloc( key_len + 1 );
+    memcpy( node->key, key, key_len );
+    node->key[key_len] = 0;
+    return node;
+}
+
+static void node_add( struct gpd_node *parent, struct gpd_node *kid )
+{
+    if (parent->count == parent->size)
+    {
+        parent->size = parent->size ? parent->size * 2 : 8;
+        parent->kids = realloc( parent->kids, parent->size * sizeof(*parent->kids) );
+    }
+    parent->kids[parent->count++] = kid;
+}
+
+static void node_free( struct gpd_node *node )
+{
+    unsigned int i;
+    for (i = 0; i < node->count; i++) node_free( node->kids[i] );
+    free( node->kids );
+    free( node->key );
+    free( node->name );
+    free( node->value );
+    free( node );
+}
+
+static char *dup_trim( const char *start, const char *end )
+{
+    char *ret;
+    while (start < end && isspace( (unsigned char)*start )) start++;
+    while (end > start && isspace( (unsigned char)end[-1] )) end--;
+    ret = malloc( end - start + 1 );
+    memcpy( ret, start, end - start );
+    ret[end - start] = 0;
+    return ret;
+}
+
+struct parser
+{
+    struct gpd *gpd;
+    int         depth;  /* include depth */
+};
+
+static void parse_text( struct parser *ps, const char *text, struct gpd_node *root );
+
+static char *read_file( const WCHAR *path, DWORD *len )
+{
+    HANDLE file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    DWORD size, got;
+    char *buf;
+
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    size = GetFileSize( file, NULL );
+    buf = malloc( size + 1 );
+    if (!ReadFile( file, buf, size, &got, NULL )) got = 0;
+    CloseHandle( file );
+    buf[got] = 0;
+    if (len) *len = got;
+    return buf;
+}
+
+static void include_file( struct parser *ps, const char *name, struct gpd_node *parent )
+{
+    WCHAR path[MAX_PATH], nameW[MAX_PATH];
+    char *text;
+
+    if (ps->depth > 8) return;
+    MultiByteToWideChar( CP_ACP, 0, name, -1, nameW, MAX_PATH );
+    swprintf( path, MAX_PATH, L"%s\\%s", ps->gpd->dir, nameW );
+    if (!(text = read_file( path, NULL )))
+    {
+        /* the standard include files describe names and fonts Unidrv itself would
+         * know; an absent one costs only display names */
+        TRACE( "include %s not found\n", debugstr_w(path) );
+        return;
+    }
+    ps->depth++;
+    parse_text( ps, text, parent );
+    ps->depth--;
+    free( text );
+}
+
+/* skips blanks, line ends and "*%" comments */
+static const char *skip_space( const char *p, BOOL lines )
+{
+    for (;;)
+    {
+        while (*p == ' ' || *p == '\t' || (lines && (*p == '\r' || *p == '\n'))) p++;
+        if (p[0] == '*' && p[1] == '%')
+        {
+            while (*p && *p != '\n') p++;
+            if (!lines) return p;
+            continue;
+        }
+        return p;
+    }
+}
+
+/* finds where an attribute's value ends: the end of its line, a comment, or a
+ * closing brace that it did not open; quoted text and parameter braces are
+ * part of the value */
+static const char *value_end( const char *p )
+{
+    int depth = 0;
+    BOOL quote = FALSE;
+
+    for (; *p; p++)
+    {
+        if (quote)
+        {
+            if (*p == '"') quote = FALSE;
+            else if (*p == '\n') return p;
+            continue;
+        }
+        if (*p == '"') quote = TRUE;
+        else if (*p == '\n' || *p == '\r') return p;
+        else if (p[0] == '*' && p[1] == '%') return p;
+        else if (*p == '{') depth++;
+        else if (*p == '}')
+        {
+            if (!depth) return p;
+            depth--;
+        }
+    }
+    return p;
+}
+
+static void add_macro( struct gpd *gpd, const char *name, const char *value )
+{
+    if (gpd->macro_count == gpd->macro_size)
+    {
+        gpd->macro_size = gpd->macro_size ? gpd->macro_size * 2 : 32;
+        gpd->macros = realloc( gpd->macros, gpd->macro_size * sizeof(*gpd->macros) );
+    }
+    gpd->macros[gpd->macro_count].name = strdup( name );
+    gpd->macros[gpd->macro_count].value = strdup( value );
+    gpd->macro_count++;
+}
+
+/* parses entries until the end of text or an unmatched closing brace; returns
+ * where it stopped */
+static const char *parse_block( struct parser *ps, const char *p, struct gpd_node *parent, BOOL macros )
+{
+    for (;;)
+    {
+        const char *key, *key_end, *end;
+        struct gpd_node *node;
+
+        p = skip_space( p, TRUE );
+        if (!*p) return p;
+        if (*p == '}') return p + 1;
+
+        if (*p != '*')
+        {
+            if (macros && (isalpha( (unsigned char)*p ) || *p == '_'))
+            {
+                /* a value macro: NAME: value */
+                const char *name = p;
+                char *n, *v;
+                while (*p && *p != ':' && *p != '\n' && *p != '}') p++;
+                if (*p != ':') continue;
+                n = dup_trim( name, p );
+                end = value_end( ++p );
+                v = dup_trim( p, end );
+                add_macro( ps->gpd, n, v );
+                free( n );
+                free( v );
+                p = end;
+                continue;
+            }
+            /* a continuation line or something we do not know: skip the line */
+            if (*p == '+' && parent->count && parent->kids[parent->count - 1]->value)
+            {
+                struct gpd_node *last = parent->kids[parent->count - 1];
+                char *more, *joined;
+                end = value_end( p + 1 );
+                more = dup_trim( p + 1, end );
+                joined = malloc( strlen( last->value ) + strlen( more ) + 2 );
+                sprintf( joined, "%s %s", last->value, more );
+                free( last->value );
+                free( more );
+                last->value = joined;
+                p = end;
+                continue;
+            }
+            while (*p && *p != '\n') p++;
+            continue;
+        }
+
+        key = ++p;
+        while (*p && (isalnum( (unsigned char)*p ) || *p == '_' || *p == '?')) p++;
+        key_end = p;
+        node = node_new( key, key_end - key );
+
+        /* EXTERN_GLOBAL: and EXTERN_FEATURE: prefixes just say where the
+         * attribute belongs; the attribute follows */
+        p = skip_space( p, FALSE );
+        if (*p == ':') p++;
+
+        if (!strcmp( node->key, "Include" ))
+        {
+            char *v;
+            end = value_end( p );
+            v = dup_trim( p, end );
+            if (v[0] == '"' && strlen( v ) >= 2)
+            {
+                v[strlen( v ) - 1] = 0;
+                include_file( ps, v + 1, parent );
+            }
+            free( v );
+            node_free( node );
+            p = end;
+            continue;
+        }
+
+        if (is_construct( node->key ))
+        {
+            const char *name = skip_space( p, FALSE );
+            const char *name_end = name;
+            while (*name_end && !isspace( (unsigned char)*name_end ) && *name_end != '{' &&
+                   !(name_end[0] == '*' && name_end[1] == '%')) name_end++;
+            if (name_end > name) node->name = dup_trim( name, name_end );
+            p = skip_space( name_end, TRUE );
+            if (*p == '{')
+            {
+                p = parse_block( ps, p + 1, node, !strcmp( node->key, "Macros" ) );
+                node_add( parent, node );
+            }
+            else node_free( node );  /* a construct without a body says nothing */
+            continue;
+        }
+
+        /* an attribute; strip a prefix such as EXTERN_GLOBAL */
+        if (!strncmp( node->key, "EXTERN_", 7 ))
+        {
+            const char *q = skip_space( p, FALSE );
+            if (*q == '*')
+            {
+                node_free( node );
+                p = q;
+                continue;
+            }
+        }
+        end = value_end( p );
+        node->value = dup_trim( p, end );
+        node_add( parent, node );
+        p = end;
+    }
+}
+
+static void parse_text( struct parser *ps, const char *text, struct gpd_node *root )
+{
+    const char *p = text;
+    while (*p)
+    {
+        p = parse_block( ps, p, root, FALSE );
+        /* a stray closing brace at the top level: go on after it */
+    }
+}
+
+static struct gpd_feature *get_feature( struct gpd *gpd, const char *name )
+{
+    unsigned int i;
+    for (i = 0; i < gpd->feature_count; i++)
+        if (!strcmp( gpd->features[i].name, name )) return &gpd->features[i];
+    gpd->features = realloc( gpd->features, (gpd->feature_count + 1) * sizeof(*gpd->features) );
+    memset( &gpd->features[gpd->feature_count], 0, sizeof(*gpd->features) );
+    gpd->features[gpd->feature_count].name = strdup( name );
+    return &gpd->features[gpd->feature_count++];
+}
+
+static void feature_add_node( struct gpd_feature *f, struct gpd_node *node )
+{
+    unsigned int i;
+
+    f->nodes = realloc( f->nodes, (f->count + 1) * sizeof(*f->nodes) );
+    f->nodes[f->count++] = node;
+    for (i = 0; i < node->count; i++)
+    {
+        struct gpd_node *kid = node->kids[i];
+        struct gpd_option *opt = NULL;
+        unsigned int j;
+
+        if (strcmp( kid->key, "Option" ) || !kid->name) continue;
+        for (j = 0; j < f->option_count; j++)
+            if (!strcmp( f->options[j].name, kid->name )) opt = &f->options[j];
+        if (!opt)
+        {
+            f->options = realloc( f->options, (f->option_count + 1) * sizeof(*f->options) );
+            opt = &f->options[f->option_count++];
+            opt->name = strdup( kid->name );
+            opt->nodes = NULL;
+            opt->count = 0;
+        }
+        opt->nodes = realloc( opt->nodes, (opt->count + 1) * sizeof(*opt->nodes) );
+        opt->nodes[opt->count++] = kid;
+    }
+}
+
+/* features can be declared anywhere a construct can, also inside switches */
+static void collect_features( struct gpd *gpd, struct gpd_node *node )
+{
+    unsigned int i;
+    for (i = 0; i < node->count; i++)
+    {
+        struct gpd_node *kid = node->kids[i];
+        if (!strcmp( kid->key, "Feature" ) && kid->name)
+            feature_add_node( get_feature( gpd, kid->name ), kid );
+        else if (!strcmp( kid->key, "switch" ) || !strcmp( kid->key, "Switch" ) ||
+                 !strcmp( kid->key, "case" ) || !strcmp( kid->key, "Case" ) ||
+                 !strcmp( kid->key, "default" ) || !strcmp( kid->key, "Default" ))
+            collect_features( gpd, kid );
+    }
+}
+
+struct gpd *gpd_load( const WCHAR *path )
+{
+    struct gpd *gpd;
+    struct parser ps;
+    WCHAR *slash;
+    char *text;
+    const char *res;
+
+    if (!(text = read_file( path, NULL )))
+    {
+        WARN( "cannot read %s\n", debugstr_w(path) );
+        return NULL;
+    }
+    gpd = calloc( 1, sizeof(*gpd) );
+    lstrcpynW( gpd->dir, path, MAX_PATH );
+    if ((slash = wcsrchr( gpd->dir, '\\' ))) *slash = 0;
+    gpd->root = node_new( "root", 4 );
+    ps.gpd = gpd;
+    ps.depth = 0;
+    parse_text( &ps, text, gpd->root );
+    free( text );
+    collect_features( gpd, gpd->root );
+
+    if ((res = gpd_global( gpd, NULL, "ResourceDLL" )) && res[0] == '"')
+    {
+        WCHAR resW[MAX_PATH], full[MAX_PATH];
+        char name[MAX_PATH];
+        lstrcpynA( name, res + 1, sizeof(name) );
+        if (strchr( name, '"' )) *strchr( name, '"' ) = 0;
+        MultiByteToWideChar( CP_ACP, 0, name, -1, resW, MAX_PATH );
+        swprintf( full, MAX_PATH, L"%s\\%s", gpd->dir, resW );
+        gpd->resources = LoadLibraryExW( full, NULL, LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE );
+        TRACE( "resources %s -> %p\n", debugstr_w(full), gpd->resources );
+    }
+    TRACE( "%s: %u features\n", debugstr_w(path), gpd->feature_count );
+    return gpd;
+}
+
+void gpd_free( struct gpd *gpd )
+{
+    unsigned int i, j;
+    if (!gpd) return;
+    for (i = 0; i < gpd->feature_count; i++)
+    {
+        for (j = 0; j < gpd->features[i].option_count; j++)
+        {
+            free( gpd->features[i].options[j].name );
+            free( gpd->features[i].options[j].nodes );
+        }
+        free( gpd->features[i].options );
+        free( gpd->features[i].nodes );
+        free( gpd->features[i].name );
+    }
+    for (i = 0; i < gpd->macro_count; i++)
+    {
+        free( gpd->macros[i].name );
+        free( gpd->macros[i].value );
+    }
+    free( gpd->macros );
+    free( gpd->features );
+    if (gpd->resources) FreeLibrary( gpd->resources );
+    node_free( gpd->root );
+    free( gpd );
+}
+
+int gpd_find_feature( const struct gpd *gpd, const char *name )
+{
+    unsigned int i;
+    for (i = 0; i < gpd->feature_count; i++)
+        if (!strcmp( gpd->features[i].name, name )) return i;
+    return -1;
+}
+
+int gpd_find_option( const struct gpd *gpd, int feature, const char *name )
+{
+    unsigned int i;
+    if (feature < 0) return -1;
+    for (i = 0; i < gpd->features[feature].option_count; i++)
+        if (!strcmp( gpd->features[feature].options[i].name, name )) return i;
+    return -1;
+}
+
+/* ---- lookups ---- */
+
+struct lookup
+{
+    const struct gpd *gpd;
+    const gpd_sel    *sel;
+    const char       *key;
+    const char       *found;
+};
+
+static BOOL is_key( const char *key, const char *name )
+{
+    return !strcmp( key, name ) || !_stricmp( key, name );
+}
+
+static void lookup_in( struct lookup *lk, const struct gpd_node *node );
+
+static void lookup_switch( struct lookup *lk, const struct gpd_node *sw )
+{
+    int feature = sw->name ? gpd_find_feature( lk->gpd, sw->name ) : -1;
+    const char *chosen = NULL;
+    const struct gpd_node *def = NULL;
+    unsigned int i;
+
+    if (feature >= 0)
+    {
+        unsigned int opt = lk->sel ? lk->sel[feature] : gpd_default_option( lk->gpd, feature );
+        if (opt < lk->gpd->features[feature].option_count)
+            chosen = lk->gpd->features[feature].options[opt].name;
+    }
+    for (i = 0; i < sw->count; i++)
+    {
+        const struct gpd_node *kid = sw->kids[i];
+        if (is_key( kid->key, "case" ) && chosen && kid->name && !strcmp( kid->name, chosen ))
+        {
+            lookup_in( lk, kid );
+            return;
+        }
+        if (is_key( kid->key, "default" )) def = kid;
+    }
+    if (def) lookup_in( lk, def );
+}
+
+static void lookup_in( struct lookup *lk, const struct gpd_node *node )
+{
+    unsigned int i;
+    for (i = 0; i < node->count; i++)
+    {
+        const struct gpd_node *kid = node->kids[i];
+        if (kid->value && !strcmp( kid->key, lk->key )) lk->found = kid->value;
+        else if (is_key( kid->key, "switch" )) lookup_switch( lk, kid );
+    }
+}
+
+unsigned int gpd_default_option( const struct gpd *gpd, int feature )
+{
+    struct lookup lk = { gpd, NULL, "DefaultOption", NULL };
+    unsigned int i;
+    int opt;
+
+    for (i = 0; i < gpd->features[feature].count; i++)
+    {
+        /* a switch inside the feature could depend on other defaults; use
+         * the plain entries only, to stay out of loops */
+        const struct gpd_node *node = gpd->features[feature].nodes[i];
+        unsigned int j;
+        for (j = 0; j < node->count; j++)
+            if (node->kids[j]->value && !strcmp( node->kids[j]->key, "DefaultOption" ))
+                lk.found = node->kids[j]->value;
+    }
+    if (lk.found && (opt = gpd_find_option( gpd, feature, lk.found )) >= 0) return opt;
+    return 0;
+}
+
+void gpd_default_selection( const struct gpd *gpd, gpd_sel *sel )
+{
+    unsigned int i;
+    for (i = 0; i < gpd->feature_count && i < UNIDRV_MAX_FEATURES; i++)
+        sel[i] = gpd_default_option( gpd, i );
+}
+
+const char *gpd_global( const struct gpd *gpd, const gpd_sel *sel, const char *key )
+{
+    struct lookup lk = { gpd, sel, key, NULL };
+    lookup_in( &lk, gpd->root );
+    return lk.found;
+}
+
+const char *gpd_option_attr( const struct gpd *gpd, const gpd_sel *sel, int feature, unsigned int option,
+                             const char *key )
+{
+    struct lookup lk = { gpd, sel, key, NULL };
+    unsigned int i;
+
+    if (feature < 0 || option >= gpd->features[feature].option_count) return NULL;
+    for (i = 0; i < gpd->features[feature].options[option].count; i++)
+        lookup_in( &lk, gpd->features[feature].options[option].nodes[i] );
+    return lk.found;
+}
+
+const char *gpd_selected_attr( const struct gpd *gpd, const gpd_sel *sel, const char *feature, const char *key )
+{
+    int f = gpd_find_feature( gpd, feature );
+    if (f < 0) return NULL;
+    return gpd_option_attr( gpd, sel, f, sel ? sel[f] : gpd_default_option( gpd, f ), key );
+}
+
+/* ---- values ---- */
+
+const char *gpd_resolve( const struct gpd *gpd, const char *value )
+{
+    unsigned int i, depth = 0;
+    while (value && value[0] == '=' && depth++ < 8)
+    {
+        const char *found = NULL;
+        for (i = 0; i < gpd->macro_count; i++)
+            if (!strcmp( gpd->macros[i].name, value + 1 )) found = gpd->macros[i].value;
+        if (!found) return value;
+        value = found;
+    }
+    return value;
+}
+
+BOOL gpd_pair( const struct gpd *gpd, const char *value, int *a, int *b )
+{
+    value = gpd_resolve( gpd, value );
+    if (!value) return FALSE;
+    return sscanf( value, " PAIR ( %d , %d )", a, b ) == 2;
+}
+
+BOOL gpd_int( const struct gpd *gpd, const char *value, int *v )
+{
+    value = gpd_resolve( gpd, value );
+    if (!value) return FALSE;
+    return sscanf( value, " %d", v ) == 1;
+}
+
+BOOL gpd_bool( const struct gpd *gpd, const char *value, BOOL def )
+{
+    value = gpd_resolve( gpd, value );
+    if (!value) return def;
+    if (!_strnicmp( value, "TRUE", 4 )) return TRUE;
+    if (!_strnicmp( value, "FALSE", 5 )) return FALSE;
+    return def;
+}
+
+BOOL gpd_list_has( const struct gpd *gpd, const char *value, const char *item )
+{
+    const char *p;
+    size_t len = strlen( item );
+
+    value = gpd_resolve( gpd, value );
+    if (!value) return FALSE;
+    for (p = strstr( value, item ); p; p = strstr( p + 1, item ))
+    {
+        if ((p == value || !isalnum( (unsigned char)p[-1] )) && !isalnum( (unsigned char)p[len] ) && p[len] != '_')
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/* the name shown for an option: *Name, or a string from the resource DLL */
+int gpd_display_name( const struct gpd *gpd, int feature, unsigned int option, WCHAR *buf, int len )
+{
+    const char *name = gpd_option_attr( gpd, NULL, feature, option, "Name" );
+    const char *id = gpd_option_attr( gpd, NULL, feature, option, "rcNameID" );
+    int n;
+
+    if (name && name[0] == '"')
+    {
+        char tmp[256];
+        lstrcpynA( tmp, name + 1, sizeof(tmp) );
+        if (strchr( tmp, '"' )) *strchr( tmp, '"' ) = 0;
+        MultiByteToWideChar( CP_ACP, 0, tmp, -1, buf, len );
+        return wcslen( buf );
+    }
+    if (id && gpd_int( gpd, id, &n ) && gpd->resources && LoadStringW( gpd->resources, n, buf, len ))
+        return wcslen( buf );
+    MultiByteToWideChar( CP_ACP, 0, gpd->features[feature].options[option].name, -1, buf, len );
+    return wcslen( buf );
+}
+
+/* ---- commands ---- */
+
+static const struct { const char *name; enum gpd_section sec; } sections[] =
+{
+    { "JOB_SETUP", SEC_JOB_SETUP }, { "DOC_SETUP", SEC_DOC_SETUP }, { "PAGE_SETUP", SEC_PAGE_SETUP },
+    { "PAGE_FINISH", SEC_PAGE_FINISH }, { "DOC_FINISH", SEC_DOC_FINISH }, { "JOB_FINISH", SEC_JOB_FINISH },
+};
+
+static void parse_order( const char *order, enum gpd_section *sec, int *n )
+{
+    unsigned int i;
+    *sec = SEC_NONE;
+    *n = 0;
+    if (!order) return;
+    while (isspace( (unsigned char)*order )) order++;
+    for (i = 0; i < ARRAY_SIZE(sections); i++)
+    {
+        size_t len = strlen( sections[i].name );
+        if (!strncmp( order, sections[i].name, len ) && order[len] == '.')
+        {
+            *sec = sections[i].sec;
+            *n = atoi( order + len + 1 );
+        }
+    }
+}
+
+static void fill_command( const struct gpd *gpd, const gpd_sel *sel, const struct gpd_node *node,
+                          struct gpd_command *cmd )
+{
+    struct lookup lk = { gpd, sel, "Cmd", NULL };
+    int id;
+
+    cmd->name = node->name;
+    lookup_in( &lk, node );
+    cmd->cmd = lk.found;
+    lk.key = "Order"; lk.found = NULL;
+    lookup_in( &lk, node );
+    parse_order( lk.found, &cmd->section, &cmd->order );
+    lk.key = "CallbackID"; lk.found = NULL;
+    lookup_in( &lk, node );
+    cmd->callback = (lk.found && gpd_int( gpd, lk.found, &id )) ? id : -1;
+    lk.key = "Params"; lk.found = NULL;
+    lookup_in( &lk, node );
+    cmd->params = lk.found;
+}
+
+struct cmd_search
+{
+    const struct gpd   *gpd;
+    const gpd_sel      *sel;
+    const char         *name;
+    const struct gpd_node *found;
+};
+
+static void cmd_search_in( struct cmd_search *cs, const struct gpd_node *node );
+
+static void cmd_search_switch( struct cmd_search *cs, const struct gpd_node *sw )
+{
+    int feature = sw->name ? gpd_find_feature( cs->gpd, sw->name ) : -1;
+    const char *chosen = NULL;
+    const struct gpd_node *def = NULL;
+    unsigned int i;
+
+    if (feature >= 0)
+    {
+        unsigned int opt = cs->sel ? cs->sel[feature] : gpd_default_option( cs->gpd, feature );
+        if (opt < cs->gpd->features[feature].option_count)
+            chosen = cs->gpd->features[feature].options[opt].name;
+    }
+    for (i = 0; i < sw->count; i++)
+    {
+        const struct gpd_node *kid = sw->kids[i];
+        if (is_key( kid->key, "case" ) && chosen && kid->name && !strcmp( kid->name, chosen ))
+        {
+            cmd_search_in( cs, kid );
+            return;
+        }
+        if (is_key( kid->key, "default" )) def = kid;
+    }
+    if (def) cmd_search_in( cs, def );
+}
+
+static void cmd_search_in( struct cmd_search *cs, const struct gpd_node *node )
+{
+    unsigned int i;
+    for (i = 0; i < node->count; i++)
+    {
+        const struct gpd_node *kid = node->kids[i];
+        if (!strcmp( kid->key, "Command" ) && kid->name && !strcmp( kid->name, cs->name )) cs->found = kid;
+        else if (is_key( kid->key, "switch" )) cmd_search_switch( cs, kid );
+    }
+}
+
+BOOL gpd_command( const struct gpd *gpd, const gpd_sel *sel, const char *name, struct gpd_command *cmd )
+{
+    struct cmd_search cs = { gpd, sel, name, NULL };
+    cmd_search_in( &cs, gpd->root );
+    if (!cs.found) return FALSE;
+    fill_command( gpd, sel, cs.found, cmd );
+    return TRUE;
+}
+
+static int compare_commands( const void *a, const void *b )
+{
+    const struct gpd_command *ca = a, *cb = b;
+    return ca->order - cb->order;
+}
+
+/* the commands to send in a section: global ones that name it, and each
+ * selected option's CmdSelect, in their order */
+unsigned int gpd_section_commands( const struct gpd *gpd, const gpd_sel *sel, enum gpd_section section,
+                                   struct gpd_command *cmds, unsigned int max )
+{
+    static const char *global_names[] = { "CmdStartJob", "CmdStartDoc", "CmdStartPage", "CmdEndPage",
+                                          "CmdEndDoc", "CmdEndJob" };
+    unsigned int count = 0, i;
+    struct gpd_command cmd;
+
+    for (i = 0; i < ARRAY_SIZE(global_names); i++)
+    {
+        if (gpd_command( gpd, sel, global_names[i], &cmd ) && cmd.section == section && count < max)
+            cmds[count++] = cmd;
+    }
+    for (i = 0; i < gpd->feature_count; i++)
+    {
+        struct cmd_search cs = { gpd, sel, "CmdSelect", NULL };
+        unsigned int opt = sel[i], j;
+
+        if (opt >= gpd->features[i].option_count) continue;
+        for (j = 0; j < gpd->features[i].options[opt].count; j++)
+            cmd_search_in( &cs, gpd->features[i].options[opt].nodes[j] );
+        if (!cs.found) continue;
+        fill_command( gpd, sel, cs.found, &cmd );
+        if (cmd.section == section && count < max) cmds[count++] = cmd;
+    }
+    qsort( cmds, count, sizeof(*cmds), compare_commands );
+    return count;
+}
+
+/* ---- command strings ---- */
+
+struct expr
+{
+    const char *p;
+    gpd_var_fn  var;
+    void       *ctx;
+};
+
+static int expr_add( struct expr *e );
+
+static int expr_atom( struct expr *e )
+{
+    int v = 0;
+
+    while (isspace( (unsigned char)*e->p )) e->p++;
+    if (*e->p == '(')
+    {
+        e->p++;
+        v = expr_add( e );
+        while (isspace( (unsigned char)*e->p )) e->p++;
+        if (*e->p == ')') e->p++;
+        return v;
+    }
+    if (*e->p == '-')
+    {
+        e->p++;
+        return -expr_atom( e );
+    }
+    if (isdigit( (unsigned char)*e->p ))
+    {
+        v = strtol( e->p, (char **)&e->p, 10 );
+        return v;
+    }
+    if (isalpha( (unsigned char)*e->p ) || *e->p == '_')
+    {
+        char name[64];
+        int n = 0;
+        while ((isalnum( (unsigned char)*e->p ) || *e->p == '_') && n < 63) name[n++] = *e->p++;
+        name[n] = 0;
+        while (isspace( (unsigned char)*e->p )) e->p++;
+        if (*e->p == '(')
+        {
+            /* max_repeat(x) and friends: the value itself */
+            e->p++;
+            v = expr_add( e );
+            while (isspace( (unsigned char)*e->p )) e->p++;
+            if (*e->p == ')') e->p++;
+            return v;
+        }
+        if (!e->var || !e->var( e->ctx, name, &v )) v = 0;
+        return v;
+    }
+    if (*e->p) e->p++;
+    return 0;
+}
+
+static int expr_mul( struct expr *e )
+{
+    int v = expr_atom( e );
+    for (;;)
+    {
+        while (isspace( (unsigned char)*e->p )) e->p++;
+        if (*e->p == '*') { e->p++; v *= expr_atom( e ); }
+        else if (*e->p == '/') { int d; e->p++; d = expr_atom( e ); v = d ? v / d : 0; }
+        else if (!strncmp( e->p, "MOD", 3 )) { int d; e->p += 3; if (!strncmp( e->p, "ULO", 3 )) e->p += 3;
+                                               d = expr_atom( e ); v = d ? v % d : 0; }
+        else return v;
+    }
+}
+
+static int expr_add( struct expr *e )
+{
+    int v = expr_mul( e );
+    for (;;)
+    {
+        while (isspace( (unsigned char)*e->p )) e->p++;
+        if (*e->p == '+') { e->p++; v += expr_mul( e ); }
+        else if (*e->p == '-') { e->p++; v -= expr_mul( e ); }
+        else return v;
+    }
+}
+
+static int put( BYTE *out, int size, int pos, BYTE b )
+{
+    if (pos < size) out[pos] = b;
+    return pos + 1;
+}
+
+/* builds a *Cmd value: quoted text with <hex> bytes, and %x[min,max]{expr}
+ * parameters between quotes */
+int gpd_build_command( const char *cmd, gpd_var_fn var, void *ctx, BYTE *out, int size )
+{
+    const char *p = cmd;
+    int pos = 0;
+
+    if (!cmd) return 0;
+    while (*p)
+    {
+        if (*p == '"')
+        {
+            for (p++; *p && *p != '"'; p++)
+            {
+                if (*p == '<')
+                {
+                    int hi = -1;
+                    for (p++; *p && *p != '>'; p++)
+                    {
+                        int d;
+                        if (isspace( (unsigned char)*p )) continue;
+                        if (isdigit( (unsigned char)*p )) d = *p - '0';
+                        else if (isxdigit( (unsigned char)*p )) d = toupper( (unsigned char)*p ) - 'A' + 10;
+                        else continue;
+                        if (hi < 0) hi = d;
+                        else { pos = put( out, size, pos, (hi << 4) | d ); hi = -1; }
+                    }
+                    if (!*p) break;
+                }
+                else if (*p == '%' && p[1] == '%') { pos = put( out, size, pos, '%' ); p++; }
+                else pos = put( out, size, pos, *p );
+            }
+            if (*p) p++;
+        }
+        else if (*p == '%')
+        {
+            struct expr e;
+            char type = *++p;
+            int lo = INT_MIN, hi = INT_MAX, v;
+            char num[16];
+            int i;
+
+            if (*p) p++;
+            if (*p == '[')
+            {
+                sscanf( p, "[%d,%d]", &lo, &hi );
+                while (*p && *p != ']') p++;
+                if (*p) p++;
+            }
+            while (isspace( (unsigned char)*p )) p++;
+            if (*p != '{') continue;
+            e.p = p + 1;
+            e.var = var;
+            e.ctx = ctx;
+            v = expr_add( &e );
+            p = e.p;
+            while (*p && *p != '}') p++;
+            if (*p) p++;
+            if (v < lo) v = lo;
+            if (v > hi) v = hi;
+            switch (type)
+            {
+            case 'c': pos = put( out, size, pos, v & 0xff ); break;
+            case 'C': pos = put( out, size, pos, (v + '0') & 0xff ); break;
+            case 'l': pos = put( out, size, pos, v & 0xff ); pos = put( out, size, pos, (v >> 8) & 0xff ); break;
+            case 'm': pos = put( out, size, pos, (v >> 8) & 0xff ); pos = put( out, size, pos, v & 0xff ); break;
+            case 'q':
+                for (i = 0; i < 4; i++) pos = put( out, size, pos, (v >> (8 * i)) & 0xff );
+                break;
+            case 'g':
+                for (i = 3; i >= 0; i--) pos = put( out, size, pos, (v >> (8 * i)) & 0xff );
+                break;
+            case 'D':
+                sprintf( num, "%+d", v );
+                for (i = 0; num[i]; i++) pos = put( out, size, pos, num[i] );
+                break;
+            default:
+                sprintf( num, "%d", v );
+                for (i = 0; num[i]; i++) pos = put( out, size, pos, num[i] );
+                break;
+            }
+        }
+        else p++;
+    }
+    return pos;
+}
