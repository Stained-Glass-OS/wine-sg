+/***********************************************************************
+ *           DrvDocumentPropertySheets    (UNIDRVUI.@)
+ */
+LONG WINAPI DrvDocumentPropertySheets( PROPSHEETUI_INFO *info, LPARAM lparam )
+{
+    DOCUMENTPROPERTYHEADERW *dph = (DOCUMENTPROPERTYHEADERW *)(info ? info->lParamInit : lparam);
+    struct config cfg;
+    DEVMODEW *dm;
+    LONG ret = CPSUI_OK;
+    DWORD size;
+
+    TRACE( "%p %Ix mode %#lx\n", info, lparam, dph ? dph->fMode : 0 );
+    if (!dph) return ERR_CPSUI_GETLASTERROR;
+    if (info && info->Reason != PROPSHEETUI_REASON_INIT) return CPSUI_OK;
+    if (!open_config( &cfg, dph->hPrinter, dph->pszPrinterName )) return ERR_CPSUI_GETLASTERROR;
+
+    dm = make_devmode( &cfg, dph->pszPrinterName,
+                       (dph->fMode & (DM_IN_BUFFER | DM_MODIFY)) ? dph->pdmIn : NULL );
+    size = dm->dmSize + dm->dmDriverExtra;
+    if (!dph->fMode || !dph->pdmOut)
+    {
+        dph->cbOut = size;
+        ret = size;
+    }
+    else if (dph->fMode & (DM_COPY | DM_UPDATE))
+    {
+        /* DM_PROMPT: we have no sheet of our own yet; the settings stand */
+        memcpy( dph->pdmOut, dm, size );
+        ret = info ? CPSUI_OK : IDOK;
+    }
+    free( dm );
+    close_config( &cfg );
+    return ret;
+}
+
+/***********************************************************************
+ *           DrvConvertDevMode    (UNIDRVUI.@)
+ */
+BOOL WINAPI DrvConvertDevMode( WCHAR *name, DEVMODEW *in, DEVMODEW *out, LONG *size, DWORD mode )
+{
+    struct config cfg;
+    DEVMODEW *dm;
+    DWORD need;
+    BOOL ret = FALSE;
+
+    TRACE( "%s %p %p %p %lu\n", debugstr_w(name), in, out, size, mode );
+    if (!size || !open_config( &cfg, NULL, name )) return FALSE;
+    dm = make_devmode( &cfg, name, mode == 3 /* CDM_DRIVER_DEFAULT */ ? NULL : in );
+    need = dm->dmSize + dm->dmDriverExtra;
+    if (!out || *size < need)
+    {
+        *size = need;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+    }
+    else
+    {
+        memcpy( out, dm, need );
+        *size = need;
+        ret = TRUE;
+    }
+    free( dm );
+    close_config( &cfg );
+    return ret;
+}
+
+static DWORD list_options( struct gpd *gpd, const char *feature, WORD cap, void *output, const DEVMODEW *dm )
+{
+    int f = gpd_find_feature( gpd, feature ), mx, my, w, h, n;
+    unsigned int i;
+    DWORD count = 0;
+
+    if (f < 0) return 0;
+    unidrv_master_units( gpd, &mx, &my );
+    for (i = 0; i < gpd->features[f].option_count; i++)
+    {
+        const char *name = gpd->features[f].options[i].name;
+        if (!strcmp( feature, "PaperSize" ) && !strcmp( name, "CUSTOMSIZE" ) && cap != DC_PAPERS &&
+            cap != DC_PAPERNAMES)
+            continue;
+        if (output) switch (cap)
+        {
+        case DC_PAPERS:
+            ((WORD *)output)[count] = unidrv_paper_id( gpd, f, i );
+            break;
+        case DC_PAPERSIZE:
+            if (unidrv_paper_size( gpd, f, i, &w, &h ))
+            {
+                ((POINT *)output)[count].x = MulDiv( w, 254, mx );
+                ((POINT *)output)[count].y = MulDiv( h, 254, my );
+            }
+            else ((POINT *)output)[count].x = ((POINT *)output)[count].y = 0;
+            break;
+        case DC_PAPERNAMES:
+        case DC_MEDIAREADY:
+        case DC_MEDIATYPENAMES:
+            gpd_display_name( gpd, f, i, (WCHAR *)output + count * 64, 64 );
+            break;
+        case DC_BINNAMES:
+            gpd_display_name( gpd, f, i, (WCHAR *)output + count * 24, 24 );
+            break;
+        case DC_BINS:
+        case DC_MEDIATYPES:
+        {
+            const char *id = gpd_option_attr( gpd, NULL, f, i, "OptionID" );
+            if (cap == DC_BINS)
+                ((WORD *)output)[count] = id && gpd_int( gpd, id, &n ) ? n : 256 + i;
+            else
+                ((DWORD *)output)[count] = id && gpd_int( gpd, id, &n ) ? n : 256 + i;
+            break;
+        }
+        case DC_ENUMRESOLUTIONS:
+            if (!gpd_pair( gpd, gpd_option_attr( gpd, NULL, f, i, "DPI" ), &w, &h )) continue;
+            ((LONG *)output)[count * 2] = w;
+            ((LONG *)output)[count * 2 + 1] = h;
+            break;
+        }
+        count++;
+    }
+    return count;
+}
+
+/***********************************************************************
+ *           DrvDeviceCapabilities    (UNIDRVUI.@)
+ */
+DWORD WINAPI DrvDeviceCapabilities( HANDLE printer, WCHAR *name, WORD cap, void *output, DEVMODEW *devmode )
+{
+    struct config cfg;
+    DEVMODEW *dm;
+    DWORD ret = 0;
+    int f, mx, my, w, h;
+    unsigned int i;
+
+    TRACE( "%s cap %u %p\n", debugstr_w(name), cap, output );
+    if (!open_config( &cfg, printer, name ))
+    {
+        WARN( "no configuration for %s\n", debugstr_w(name) );
+        return (DWORD)-1;
+    }
+    dm = make_devmode( &cfg, name, devmode );
+
+    switch (cap)
+    {
+    case DC_FIELDS: ret = dm->dmFields; break;
+    case DC_SIZE: ret = dm->dmSize; break;
+    case DC_EXTRA: ret = dm->dmDriverExtra; break;
+    case DC_VERSION: ret = dm->dmSpecVersion; break;
+    case DC_DRIVER: ret = dm->dmDriverVersion; break;
+    case DC_PAPERS: case DC_PAPERSIZE: case DC_PAPERNAMES: case DC_MEDIAREADY:
+        ret = list_options( cfg.gpd, "PaperSize", cap, output, dm );
+        break;
+    case DC_BINS: case DC_BINNAMES:
+        ret = list_options( cfg.gpd, "InputBin", cap, output, dm );
+        break;
+    case DC_MEDIATYPES: case DC_MEDIATYPENAMES:
+        ret = list_options( cfg.gpd, "MediaType", cap, output, dm );
+        break;
+    case DC_ENUMRESOLUTIONS:
+        ret = list_options( cfg.gpd, "Resolution", cap, output, dm );
+        break;
+    case DC_ORIENTATION:
+        ret = 0;
+        if ((f = gpd_find_feature( cfg.gpd, "Orientation" )) >= 0)
+        {
+            for (i = 0; i < cfg.gpd->features[f].option_count; i++)
+            {
+                const char *o = cfg.gpd->features[f].options[i].name;
+                if (strstr( o, "CC270" )) ret = 270;
+                else if (strstr( o, "CC90" )) ret = 90;
+            }
+        }
+        break;
+    case DC_MINEXTENT:
+    case DC_MAXEXTENT:
+    {
+        POINT ext = { cap == DC_MINEXTENT ? 0x7fff : 0, cap == DC_MINEXTENT ? 0x7fff : 0 };
+        unidrv_master_units( cfg.gpd, &mx, &my );
+        if ((f = gpd_find_feature( cfg.gpd, "PaperSize" )) >= 0)
+        {
+            for (i = 0; i < cfg.gpd->features[f].option_count; i++)
+            {
+                if (!unidrv_paper_size( cfg.gpd, f, i, &w, &h )) continue;
+                w = MulDiv( w, 254, mx );
+                h = MulDiv( h, 254, my );
+                if (cap == DC_MINEXTENT) { ext.x = min( ext.x, w ); ext.y = min( ext.y, h ); }
+                else { ext.x = max( ext.x, w ); ext.y = max( ext.y, h ); }
+            }
+            i = gpd_find_option( cfg.gpd, f, "CUSTOMSIZE" );
+            if (i != (unsigned int)-1)
+            {
+                const char *v = gpd_option_attr( cfg.gpd, NULL, f, i, cap == DC_MINEXTENT ? "MinSize" : "MaxSize" );
+                if (gpd_pair( cfg.gpd, v, &w, &h ))
+                {
+                    w = MulDiv( w, 254, mx );
+                    h = MulDiv( h, 254, my );
+                    if (cap == DC_MINEXTENT) { ext.x = min( ext.x, w ); ext.y = min( ext.y, h ); }
+                    else { ext.x = max( ext.x, w ); ext.y = max( ext.y, h ); }
+                }
+            }
+        }
+        ret = MAKELONG( ext.x, ext.y );
+        break;
+    }
+    case DC_COPIES: ret = 9999; break;
+    case DC_COLLATE: ret = 1; break;
+    case DC_DUPLEX: ret = gpd_find_feature( cfg.gpd, "Duplex" ) >= 0; break;
+    case DC_COLORDEVICE:
+        ret = 0;
+        if ((f = gpd_find_feature( cfg.gpd, "ColorMode" )) >= 0)
+            for (i = 0; i < cfg.gpd->features[f].option_count; i++)
+                if (gpd_bool( cfg.gpd, gpd_option_attr( cfg.gpd, NULL, f, i, "Color?" ), FALSE )) ret = 1;
+        break;
+    case DC_TRUETYPE: ret = DCTT_BITMAP; break;
+    case DC_NUP:
+        if (output) *(DWORD *)output = 1;
+        ret = 1;
+        break;
+    case DC_PRINTERMEM: ret = (DWORD)-1; break;
+    case DC_STAPLE: ret = 0; break;
+    case DC_EMF_COMPLIANT: ret = 1; break;
+    case DC_DATATYPE_PRODUCED:
+        if (output) wcscpy( output, L"RAW" );
+        ret = 1;
+        break;
+    case DC_BINADJUST: ret = DCBA_FACEUPNONE; break;
+    case DC_FILEDEPENDENCIES: case DC_PERSONALITY: ret = 0; break;
+    case DC_MANUFACTURER: case DC_MODEL: ret = 0; break;
+    default:
+        FIXME( "capability %u\n", cap );
+        ret = (DWORD)-1;
+        break;
+    }
+    free( dm );
+    close_config( &cfg );
+    return ret;
+}
