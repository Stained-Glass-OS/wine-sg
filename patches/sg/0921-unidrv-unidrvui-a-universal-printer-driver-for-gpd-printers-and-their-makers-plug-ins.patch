+
+/* ---- the GPD description ---- */
+
+struct gpd_node
+{
+    char             *key;    /* keyword without the star */
+    char             *name;   /* a construct's symbol (feature, option, command name...) */
+    char             *value;  /* an attribute's value text */
+    struct gpd_node **kids;   /* a construct's entries */
+    unsigned int      count, size;
+};
+
+struct gpd_option
+{
+    char             *name;
+    struct gpd_node **nodes;  /* every block that declared this option */
+    unsigned int      count;
+};
+
+struct gpd_feature
+{
+    char              *name;
+    struct gpd_node  **nodes;
+    unsigned int       count;
+    struct gpd_option *options;
+    unsigned int       option_count;
+};
+
+struct gpd_macro
+{
+    char *name;
+    char *value;
+};
+
+struct gpd
+{
+    struct gpd_node    *root;
+    struct gpd_feature *features;
+    unsigned int        feature_count;
+    struct gpd_macro   *macros;
+    unsigned int        macro_count, macro_size;
+    WCHAR               dir[MAX_PATH];  /* where the GPD and its includes live */
+    HMODULE             resources;      /* *ResourceDLL, for display names */
+};
+
+/* option selection: one option index per feature */
+typedef unsigned short gpd_sel;
+
+struct gpd *gpd_load( const WCHAR *path );
+void gpd_free( struct gpd *gpd );
+int gpd_find_feature( const struct gpd *gpd, const char *name );
+int gpd_find_option( const struct gpd *gpd, int feature, const char *name );
+unsigned int gpd_default_option( const struct gpd *gpd, int feature );
+void gpd_default_selection( const struct gpd *gpd, gpd_sel *sel );
+const char *gpd_global( const struct gpd *gpd, const gpd_sel *sel, const char *key );
+const char *gpd_option_attr( const struct gpd *gpd, const gpd_sel *sel, int feature, unsigned int option,
+                             const char *key );
+const char *gpd_selected_attr( const struct gpd *gpd, const gpd_sel *sel, const char *feature, const char *key );
+const char *gpd_resolve( const struct gpd *gpd, const char *value );
+BOOL gpd_pair( const struct gpd *gpd, const char *value, int *a, int *b );
+BOOL gpd_int( const struct gpd *gpd, const char *value, int *v );
+BOOL gpd_bool( const struct gpd *gpd, const char *value, BOOL def );
+BOOL gpd_list_has( const struct gpd *gpd, const char *value, const char *item );
+int gpd_display_name( const struct gpd *gpd, int feature, unsigned int option, WCHAR *buf, int len );
+
+/* commands */
+enum gpd_section { SEC_JOB_SETUP, SEC_DOC_SETUP, SEC_PAGE_SETUP, SEC_PAGE_FINISH, SEC_DOC_FINISH,
+                   SEC_JOB_FINISH, SEC_NONE };
+
+struct gpd_command
+{
+    const char *name;
+    const char *cmd;        /* the *Cmd value */
+    enum gpd_section section;
+    int order;
+    int callback;           /* *CallbackID, -1 if none */
+    const char *params;     /* *Params */
+};
+
+BOOL gpd_command( const struct gpd *gpd, const gpd_sel *sel, const char *name, struct gpd_command *cmd );
+unsigned int gpd_section_commands( const struct gpd *gpd, const gpd_sel *sel, enum gpd_section section,
+                                   struct gpd_command *cmds, unsigned int max );
+
+/* builds a command's bytes; variables come from the callback */
+typedef BOOL (*gpd_var_fn)( void *ctx, const char *name, int *value );
+int gpd_build_command( const char *cmd, gpd_var_fn var, void *ctx, BYTE *out, int size );
+
+/* ---- the devmode ---- */
+
+#define UNIDRV_DM_SIGNATURE 0x56444e55 /* "UNDV" */
+#define UNIDRV_MAX_FEATURES 128
+
+/* our private devmode part; Unidrv's documented header (four reserved words and
+ * the part's size) comes first so that plug-ins find their parts after it */
+struct unidrv_dm
+{
+    WORD    reserved[4];
+    WORD    size;            /* of this part */
+    WORD    feature_count;
+    DWORD   signature;
+    gpd_sel sel[UNIDRV_MAX_FEATURES];
+};
+
+/* ---- a loaded plug-in ---- */
+struct oem_plugin
+{
+    HMODULE    module;
+    sg_oemuni *uni;            /* the render interface, if any */
+    DWORD      dm_size;        /* its private devmode part */
+    DWORD      signature;
+    DRVENABLEDATA hooks;       /* DDI functions it hooks */
+    BOOL       has_image_processing, has_filter_graphics, has_command_callback;
+    BOOL       has_compression, has_memory_usage;
+};
+
+/* ---- the device (PDEV) ---- */
+struct unidrv_pdev
+{
+    sg_devobj       devobj;    /* handed to plug-ins; first, so DHPDEV is the DEVOBJ */
+    DWORD           magic;
+    struct gpd     *gpd;
+    gpd_sel         sel[UNIDRV_MAX_FEATURES];
+    DEVMODEW       *devmode;   /* public + our part + plug-in parts */
+    HANDLE          printer;   /* the driver handle GDI gave us */
+    WCHAR          *name;
+    struct oem_plugin oem;
+    void           *oem_pdev;
+    DRVENABLEDATA   core_fns;  /* our own entry points, for the plug-in's hooks to call */
+    /* geometry, device pixels */
+    int dpi_x, dpi_y;
+    int page_w, page_h;        /* the sheet */
+    int print_x, print_y;      /* printable origin */
+    int print_w, print_h;      /* printable area */
+    BOOL landscape;
+    int drv_bpp, dev_bpp, ip_callback;
+    BOOL strip_trailing, strip_leading, strip_enclosed;
+    HPALETTE palette;
+    /* job state */
+    HSURF    surface;
+    SURFOBJ *surfobj;
+    int      page;
+    DWORD    job_id;
+    BOOL     doc_setup_sent;
+    int      cur_x, cur_y;
+    int      data_bytes, width_bytes, height_pixels;
+};
+
+#define UNIDRV_PDEV_MAGIC 0x564e4955
+
+BOOL oem_load( struct unidrv_pdev *pdev, HANDLE printer );
+void oem_unload( struct unidrv_pdev *pdev );
+DWORD oem_dm_size( HANDLE printer, const WCHAR *ui_or_render );
+extern const sg_drvuni_vtbl unidrv_core_vtbl;
+extern sg_drvuni unidrv_core;
+
+BOOL unidrv_write( struct unidrv_pdev *pdev, const void *data, DWORD size );
+BOOL unidrv_get_driver_setting( struct unidrv_pdev *pdev, const char *feature, void *out, DWORD size,
+                                DWORD *needed, DWORD *count );
+BOOL unidrv_standard_variable( struct unidrv_pdev *pdev, DWORD index, void *buf, DWORD size, DWORD *needed );
+
+/* devmode helpers shared with unidrvui */
+struct gpd *unidrv_load_printer_gpd( HANDLE printer );
+DEVMODEW *unidrv_default_devmode( struct gpd *gpd, const WCHAR *name, DWORD oem_size );
+void unidrv_devmode_to_sel( struct gpd *gpd, const DEVMODEW *dm, gpd_sel *sel );
+void unidrv_sel_to_devmode( struct gpd *gpd, const gpd_sel *sel, DEVMODEW *dm );
+void unidrv_geometry( struct gpd *gpd, const gpd_sel *sel, const DEVMODEW *dm, int *dpi_x, int *dpi_y,
+                      int *page_w, int *page_h, int *px, int *py, int *pw, int *ph, BOOL *landscape );
+
+int unidrv_master_units( struct gpd *gpd, int *mx, int *my );
+short unidrv_paper_id( struct gpd *gpd, int feature, unsigned int opt );
+BOOL unidrv_paper_size( struct gpd *gpd, int feature, unsigned int opt, int *w, int *h );
+WCHAR *unidrv_oem_file( HANDLE printer, const WCHAR *key );
+DWORD oem_dm_size_from( sg_oemuni *uni, HMODULE module );
+
+#endif
