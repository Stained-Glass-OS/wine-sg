+/* ---- what GDI calls ---- */
+
+BOOL WINAPI DrvStartDoc( SURFOBJ *so, WCHAR *doc_name, DWORD job_id )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    BOOL (WINAPI *hook)( SURFOBJ *, WCHAR *, DWORD );
+    if (pdev && (hook = (void *)oem_hook( pdev, INDEX_DrvStartDoc ))) return hook( so, doc_name, job_id );
+    return core_StartDoc( so, doc_name, job_id );
+}
+
+BOOL WINAPI DrvStartPage( SURFOBJ *so )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    BOOL (WINAPI *hook)( SURFOBJ * );
+    if (pdev) erase_surface( so, pdev->drv_bpp == 1 ? 0x00 : 0xff );
+    if (pdev && (hook = (void *)oem_hook( pdev, INDEX_DrvStartPage ))) return hook( so );
+    return core_StartPage( so );
+}
+
+BOOL WINAPI DrvSendPage( SURFOBJ *so )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    BOOL (WINAPI *hook)( SURFOBJ * );
+    if (pdev && (hook = (void *)oem_hook( pdev, INDEX_DrvSendPage ))) return hook( so );
+    return core_SendPage( so );
+}
+
+BOOL WINAPI DrvStartBanding( SURFOBJ *so, POINTL *pt )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    BOOL (WINAPI *hook)( SURFOBJ *, POINTL * );
+    if (pdev) erase_surface( so, pdev->drv_bpp == 1 ? 0x00 : 0xff );
+    if (pdev && (hook = (void *)oem_hook( pdev, INDEX_DrvStartBanding ))) return hook( so, pt );
+    return core_StartBanding( so, pt );
+}
+
+BOOL WINAPI DrvNextBand( SURFOBJ *so, POINTL *pt )
+{
+    struct unidrv_pdev *pdev = surf_pdev( so );
+    BOOL (WINAPI *hook)( SURFOBJ *, POINTL * );
+    BOOL ret;
+    if (pdev && (hook = (void *)oem_hook( pdev, INDEX_DrvNextBand ))) ret = hook( so, pt );
+    else ret = core_NextBand( so, pt );
+    if (pdev && pt->x != -1) erase_surface( so, pdev->drv_bpp == 1 ? 0x00 : 0xff );
+    return ret;
+}
