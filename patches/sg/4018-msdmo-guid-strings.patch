From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msdmo: Implement DMOGuidToStr and DMOStrToGuid.

The A and W string conversions of DMO GUIDs (registry key form, without
braces) are exported.
---
 dlls/msdmo/dmoreg.c   | 62 +++++++++++++++++++++++++++++++++++++++++++++++++++
 dlls/msdmo/msdmo.spec |  8 +++----
 2 files changed, 66 insertions(+), 4 deletions(-)

diff --git a/dlls/msdmo/dmoreg.c b/dlls/msdmo/dmoreg.c
index 70f0166..0c58877 100644
--- a/dlls/msdmo/dmoreg.c
+++ b/dlls/msdmo/dmoreg.c
@@ -755,3 +755,65 @@ HRESULT WINAPI DMOGetTypes(REFCLSID clsid, ULONG input_count, ULONG *ret_input_c
     RegCloseKey(root);
     return S_OK;
 }
+
+/***************************************************************************
+ *		DMOGuidToStrW (MSDMO.@)
+ *
+ * The GUID as the DMO registry keys name it: without braces.
+ */
+HRESULT WINAPI DMOGuidToStrW(WCHAR *string, REFGUID guid)
+{
+    TRACE("%p, %s\n", string, debugstr_guid(guid));
+
+    if (!string || !guid)
+        return E_POINTER;
+    GUIDToString(string, guid);
+    return S_OK;
+}
+
+/***************************************************************************
+ *		DMOGuidToStrA (MSDMO.@)
+ */
+HRESULT WINAPI DMOGuidToStrA(char *string, REFGUID guid)
+{
+    WCHAR buffer[37];
+
+    TRACE("%p, %s\n", string, debugstr_guid(guid));
+
+    if (!string || !guid)
+        return E_POINTER;
+    GUIDToString(buffer, guid);
+    WideCharToMultiByte(CP_ACP, 0, buffer, -1, string, 37, NULL, NULL);
+    return S_OK;
+}
+
+/***************************************************************************
+ *		DMOStrToGuidW (MSDMO.@)
+ */
+HRESULT WINAPI DMOStrToGuidW(const WCHAR *string, GUID *guid)
+{
+    TRACE("%s, %p\n", debugstr_w(string), guid);
+
+    if (!string || !guid)
+        return E_POINTER;
+    if (wcslen(string) != 36)
+        return E_INVALIDARG;
+    return string_to_guid(string, guid);
+}
+
+/***************************************************************************
+ *		DMOStrToGuidA (MSDMO.@)
+ */
+HRESULT WINAPI DMOStrToGuidA(const char *string, GUID *guid)
+{
+    WCHAR buffer[37];
+
+    TRACE("%s, %p\n", debugstr_a(string), guid);
+
+    if (!string || !guid)
+        return E_POINTER;
+    if (strlen(string) != 36)
+        return E_INVALIDARG;
+    MultiByteToWideChar(CP_ACP, 0, string, -1, buffer, ARRAY_SIZE(buffer));
+    return string_to_guid(buffer, guid);
+}
diff --git a/dlls/msdmo/msdmo.spec b/dlls/msdmo/msdmo.spec
index 1b534d0..6747bcd 100644
--- a/dlls/msdmo/msdmo.spec
+++ b/dlls/msdmo/msdmo.spec
@@ -1,11 +1,11 @@
 @ stdcall DMOEnum(ptr long long ptr long ptr ptr)
 @ stdcall DMOGetName(ptr wstr)
 @ stdcall DMOGetTypes(ptr long ptr ptr long ptr ptr)
-@ stub    DMOGuidToStrA
-@ stub    DMOGuidToStrW
+@ stdcall DMOGuidToStrA(ptr ptr)
+@ stdcall DMOGuidToStrW(ptr ptr)
 @ stdcall DMORegister(wstr ptr ptr long long ptr long ptr)
-@ stub    DMOStrToGuidA
-@ stub    DMOStrToGuidW
+@ stdcall DMOStrToGuidA(str ptr)
+@ stdcall DMOStrToGuidW(wstr ptr)
 @ stdcall DMOUnregister(ptr ptr)
 @ stdcall MoCopyMediaType(ptr ptr)
 @ stdcall MoCreateMediaType(ptr long)
