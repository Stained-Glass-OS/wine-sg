+            && SUCCEEDED(IPin_ConnectedTo(pin, &peer)))
+    {
+        IPin_QueryInterface(peer, &IID_IAMStreamControl, (void **)&control);
+        IPin_Release(peer);
+    }
+    IPin_Release(pin);
+
+    if (!control)
+        return E_NOINTERFACE;
+
+    hr = IAMStreamControl_StartAt(control, start, start_cookie);
+    if (SUCCEEDED(hr))
+        hr = IAMStreamControl_StopAt(control, stop, FALSE, stop_cookie);
+    IAMStreamControl_Release(control);
+    return SUCCEEDED(hr) ? S_OK : hr;
+}
