             filter, pin, index, dimensions.cx, dimensions.cy, frame_rate);
 
-    return E_NOTIMPL;
+    if (!frame_rate)
+        return E_POINTER;
+    if (SUCCEEDED(hr = video_control_get_intervals(filter, pin, index, dimensions, &fastest, &slowest)))
+        *frame_rate = fastest;
