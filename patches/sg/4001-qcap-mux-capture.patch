+    /* A preallocated capture file holds less data than its size: only the RIFF
+     * data (and the chunks that follow it) is copied. */
+    if (!GetFileSizeEx(src, &size))
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    else if (!ReadFile(src, header, sizeof(header), &read, NULL))
+        hr = HRESULT_FROM_WIN32(GetLastError());
