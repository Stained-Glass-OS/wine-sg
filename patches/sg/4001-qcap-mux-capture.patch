+    dst = CreateFileW(lpwstrNew, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (dst == INVALID_HANDLE_VALUE)
+        hr = HRESULT_FROM_WIN32(GetLastError());
+
