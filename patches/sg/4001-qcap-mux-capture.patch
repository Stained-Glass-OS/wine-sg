+static HRESULT capture_graph_control_filter_stream(CaptureGraphImpl *This, const GUID *category,
+        const GUID *type, IBaseFilter *filter, REFERENCE_TIME *start, REFERENCE_TIME *stop,
+        WORD start_cookie, WORD stop_cookie)
