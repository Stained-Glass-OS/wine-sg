+        else if (fAllowEscAbort && (GetAsyncKeyState(VK_ESCAPE) & 0x8000))
+            hr = S_FALSE;
+        if (hr == S_FALSE)
+            break;
+    }
+
+    free(buffer);
+    CloseHandle(src);
+    if (dst != INVALID_HANDLE_VALUE)
+        CloseHandle(dst);
+    if (hr != S_OK)
+        DeleteFileW(lpwstrNew);
+    return hr;
 }
 
