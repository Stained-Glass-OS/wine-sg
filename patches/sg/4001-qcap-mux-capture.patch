+/* An output takes the input's type (whatever its sample size), or anything the
+ * upstream pin accepts; nothing while the input is not connected. */
+static HRESULT smart_tee_source_query_accept(struct strmbase_pin *base, const AM_MEDIA_TYPE *mt)
+{
+    SmartTeeFilter *filter = impl_from_strmbase_pin(base);
+    const AM_MEDIA_TYPE *current;
+    HRESULT hr = S_FALSE;
+
+    EnterCriticalSection(&filter->filter.filter_cs);
+    if (filter->sink.pin.peer)
+    {
+        current = &filter->sink.pin.mt;
+        if (IsEqualGUID(&mt->majortype, &current->majortype)
+                && IsEqualGUID(&mt->subtype, &current->subtype)
+                && IsEqualGUID(&mt->formattype, &current->formattype)
+                && mt->cbFormat == current->cbFormat
+                && (!mt->cbFormat || !memcmp(mt->pbFormat, current->pbFormat, mt->cbFormat)))
+            hr = S_OK;
+        else if (IPin_QueryAccept(filter->sink.pin.peer, mt) == S_OK)
+            hr = S_OK;
+    }
+    LeaveCriticalSection(&filter->filter.filter_cs);
+
+    return hr;
+}
