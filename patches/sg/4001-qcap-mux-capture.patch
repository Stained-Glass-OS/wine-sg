+/* The device's frame interval range for capability "index" at "dimensions". */
+static HRESULT video_control_get_intervals(struct vfw_capture *filter, IPin *pin, LONG index,
+        SIZE dimensions, LONGLONG *fastest, LONGLONG *slowest)
+{
+    struct get_caps_count_params count_params;
+    struct get_caps_params caps_params;
+    VIDEO_STREAM_CONFIG_CAPS caps;
+    VIDEOINFOHEADER format;
+    AM_MEDIA_TYPE mt;
+    int count = 0;
+
+    if (!pin)
+        return E_POINTER;
+    if (pin != &filter->source.pin.IPin_iface)
+        return E_INVALIDARG;
+
+    count_params.device = filter->device;
+    count_params.count = &count;
+    V4L_CALL( get_caps_count, &count_params );
+    if (index < 0 || index >= count)
+        return E_INVALIDARG;
+
+    caps_params.device = filter->device;
+    caps_params.index = index;
+    caps_params.mt = &mt;
+    caps_params.format = &format;
+    caps_params.caps = &caps;
+    V4L_CALL( get_caps, &caps_params );
+
+    if (dimensions.cx < caps.MinOutputSize.cx || dimensions.cx > caps.MaxOutputSize.cx
+            || dimensions.cy < caps.MinOutputSize.cy || dimensions.cy > caps.MaxOutputSize.cy)
+        return E_INVALIDARG;
+
+    *fastest = min(caps.MinFrameInterval, caps.MaxFrameInterval);
+    *slowest = max(caps.MinFrameInterval, caps.MaxFrameInterval);
+    return S_OK;
 }
 
