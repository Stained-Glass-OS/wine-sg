From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: Quick access as a shell folder

Windows' Quick access (its Home folder, ::{679F85CB-0220-4080-B29B-5540CC05AAB6})
holds the pinned folders, then the frequent ones; programs list it in their own file
browsers -- Blender adds it to its file browser's side bar (shell:::{679f85cb-...},
BHID_EnumItems, each item's SIGDN_FILESYSPATH). Wine had no such folder ('DllGetClassObject
failed for CLSID={679f85cb-...}'). shell32 now has it (sendto.c, beside the pins Send
to already keeps): the folders pinned in File Explorer (HKCU\Software\Stained
Glass\Explorer\QuickAccess, Pinned; Desktop, Downloads, Documents, Pictures until
pins are set), then up to ten frequent ones (Frequent, visited more than once, as File
Explorer counts them), each an item standing for its file system folder: its path for
parsing, and its name, attributes, icon, menu, details and contents are the folder's
own. Registered as 'Quick access' with the shell folder attributes Windows gives it.

Gate: test/quickaccess-gate.sh; mutant SG_MUTANT_QUICK_ACCESS_EMPTY.
---
--- a/dlls/shell32/sendto.c
+++ b/dlls/shell32/sendto.c
@@ -40,8 +40,12 @@
 #include "shobjidl.h"
 #include "shlwapi.h"
 #include "knownfolders.h"
+#include "commctrl.h"
+#include "shlguid.h"
+#include "ntquery.h"
 
 #include "shell32_main.h"
+#include "pidl.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(shell);
@@ -457,3 +461,635 @@
 {
     return sizeof(struct sendto_target);
 }
+
+/* ------------------------------------------------------------------------ */
+/* Quick access as a shell folder: ::{679F85CB-0220-4080-B29B-5540CC05AAB6} */
+/*                                                                          */
+/* Windows' "Quick access" (its Home folder) holds the pinned folders, then */
+/* the frequent ones. Programs list it in their own file browsers (Blender  */
+/* adds it to its file browser's side bar: "shell:::{679f85cb-...}", then   */
+/* BHID_EnumItems and each item's SIGDN_FILESYSPATH); Wine had no such      */
+/* folder, so binding it failed. Its items stand for file system folders:   */
+/* names, icons, menus, contents and details are the folders' own.          */
+
+const CLSID CLSID_SGQuickAccess = { 0x679f85cb, 0x0220, 0x4080, { 0xb2, 0x9b, 0x55, 0x40, 0xcc, 0x05, 0xaa, 0xb6 } };
+
+#define QA_PIDL_TYPE  0xa6
+#define QA_PIDL_MAGIC 0x41514753   /* "SGQA" */
+#define QA_MAX_FREQUENT 10         /* Windows shows up to ten frequent folders */
+
+#include "pshpack1.h"
+struct qa_pidl
+{
+    WORD cb;
+    BYTE type;
+    BYTE pinned;
+    DWORD magic;
+    WCHAR path[1];
+};
+#include "poppack.h"
+
+static const struct qa_pidl *qa_pidl( LPCITEMIDLIST pidl )
+{
+    const struct qa_pidl *q = (const struct qa_pidl *)pidl;
+    if (!pidl || pidl->mkid.cb < offsetof(struct qa_pidl, path) + sizeof(WCHAR) ||
+        q->type != QA_PIDL_TYPE || q->magic != QA_PIDL_MAGIC) return NULL;
+    return q;
+}
+
+static LPITEMIDLIST qa_make_pidl( const WCHAR *path, BOOL pinned )
+{
+    size_t len = (wcslen( path ) + 1) * sizeof(WCHAR), size = offsetof(struct qa_pidl, path) + len;
+    struct qa_pidl *q = SHAlloc( size + sizeof(WORD) );
+
+    if (!q) return NULL;
+    memset( q, 0, size + sizeof(WORD) );
+    q->cb = size;
+    q->type = QA_PIDL_TYPE;
+    q->pinned = pinned;
+    q->magic = QA_PIDL_MAGIC;
+    memcpy( q->path, path, len );
+    return (LPITEMIDLIST)q;
+}
+
+static BOOL qa_excluded_path( const WCHAR *path )
+{
+    WCHAR *list, *p;
+    DWORD size = 0;
+    BOOL found = FALSE;
+
+    if (RegGetValueW( HKEY_CURRENT_USER, QUICK_ACCESS_KEY, L"Excluded", RRF_RT_REG_MULTI_SZ, NULL, NULL, &size ) ||
+        !(list = calloc( size / sizeof(WCHAR) + 2, sizeof(WCHAR) ))) return FALSE;
+    if (!RegGetValueW( HKEY_CURRENT_USER, QUICK_ACCESS_KEY, L"Excluded", RRF_RT_REG_MULTI_SZ, NULL, list, &size ))
+        for (p = list; *p && !found; p += lstrlenW( p ) + 1) found = same_path( p, path );
+    free( list );
+    return found;
+}
+
+struct qa_frequent_folder
+{
+    WCHAR path[MAX_PATH];
+    DWORD count;
+    FILETIME last;
+};
+
+static int __cdecl qa_compare_frequent( const void *a, const void *b )
+{
+    const struct qa_frequent_folder *x = a, *y = b;
+    if (x->count != y->count) return x->count > y->count ? -1 : 1;
+    return -CompareFileTime( &x->last, &y->last );
+}
+
+/* the folders File Explorer counted as visited more than once (HKCU ...\QuickAccess\Frequent), the most
+ * visited first, pins and removed ones left out -- File Explorer's own Quick access page shows the same */
+static unsigned int qa_frequent_folders( struct qa_frequent_folder *out, unsigned int max )
+{
+    struct { DWORD count; FILETIME last; } data;
+    struct qa_frequent_folder *all = NULL, *grown;
+    WCHAR name[MAX_PATH];
+    DWORD i, name_len, size, n = 0, cap = 0, count = 0;
+    HKEY key;
+
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, QUICK_ACCESS_KEY L"\\Frequent", 0, KEY_READ, &key )) return 0;
+    for (i = 0;; i++)
+    {
+        name_len = MAX_PATH;
+        size = sizeof(data);
+        if (RegEnumValueW( key, i, name, &name_len, NULL, NULL, (BYTE *)&data, &size ) == ERROR_NO_MORE_ITEMS) break;
+        if (size != sizeof(data) || data.count < 2 || !PathIsDirectoryW( name ) ||
+            SHELL_QuickAccessPinned( name ) || qa_excluded_path( name )) continue;
+        if (n == cap)
+        {
+            cap = max( 32, cap * 2 );
+            if (!(grown = realloc( all, cap * sizeof(*all) ))) break;
+            all = grown;
+        }
+        lstrcpyW( all[n].path, name );
+        all[n].count = data.count;
+        all[n].last = data.last;
+        n++;
+    }
+    RegCloseKey( key );
+    if (n) qsort( all, n, sizeof(*all), qa_compare_frequent );
+    for (i = 0; i < n && count < max; i++) out[count++] = all[i];
+    free( all );
+    return count;
+}
+
+/* the folder an item stands for, as an absolute ID list */
+static LPITEMIDLIST qa_target( LPCITEMIDLIST pidl )
+{
+    const struct qa_pidl *q = qa_pidl( pidl );
+    return q ? ILCreateFromPathW( q->path ) : NULL;
+}
+
+/* the item's folder in its own parent: that parent folder and the item's last ID there */
+static HRESULT qa_target_parent( LPCITEMIDLIST pidl, IShellFolder **parent, LPITEMIDLIST *target, LPCITEMIDLIST *last )
+{
+    HRESULT hr;
+
+    if (!(*target = qa_target( pidl ))) return E_INVALIDARG;
+    if (FAILED(hr = SHBindToParent( *target, &IID_IShellFolder, (void **)parent, last )))
+    {
+        ILFree( *target );
+        *target = NULL;
+    }
+    return hr;
+}
+
+typedef struct
+{
+    IShellFolder2 IShellFolder2_iface;
+    IPersistFolder2 IPersistFolder2_iface;
+    LONG ref;
+    LPITEMIDLIST pidl;      /* absolute */
+} QuickAccessFolder;
+
+static inline QuickAccessFolder *qa_from_IShellFolder2( IShellFolder2 *iface )
+{
+    return CONTAINING_RECORD( iface, QuickAccessFolder, IShellFolder2_iface );
+}
+
+static inline QuickAccessFolder *qa_from_IPersistFolder2( IPersistFolder2 *iface )
+{
+    return CONTAINING_RECORD( iface, QuickAccessFolder, IPersistFolder2_iface );
+}
+
+static HRESULT WINAPI QuickAccess_QueryInterface( IShellFolder2 *iface, REFIID riid, void **ppv )
+{
+    QuickAccessFolder *This = qa_from_IShellFolder2( iface );
+
+    TRACE( "(%p)->(%s %p)\n", This, debugstr_guid(riid), ppv );
+    if (!ppv) return E_POINTER;
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IShellFolder ) || IsEqualIID( riid, &IID_IShellFolder2 ))
+        *ppv = &This->IShellFolder2_iface;
+    else if (IsEqualIID( riid, &IID_IPersist ) || IsEqualIID( riid, &IID_IPersistFolder ) || IsEqualIID( riid, &IID_IPersistFolder2 ))
+        *ppv = &This->IPersistFolder2_iface;
+    else
+    {
+        *ppv = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*ppv );
+    return S_OK;
+}
+
+static ULONG WINAPI QuickAccess_AddRef( IShellFolder2 *iface )
+{
+    QuickAccessFolder *This = qa_from_IShellFolder2( iface );
+    return InterlockedIncrement( &This->ref );
+}
+
+static ULONG WINAPI QuickAccess_Release( IShellFolder2 *iface )
+{
+    QuickAccessFolder *This = qa_from_IShellFolder2( iface );
+    ULONG ref = InterlockedDecrement( &This->ref );
+
+    if (!ref)
+    {
+        ILFree( This->pidl );
+        free( This );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI QuickAccess_ParseDisplayName( IShellFolder2 *iface, HWND hwnd, IBindCtx *bc, LPOLESTR name,
+                                                    ULONG *eaten, LPITEMIDLIST *pidl, ULONG *attrs )
+{
+    FIXME( "(%s): not supported\n", debugstr_w(name) );
+    if (pidl) *pidl = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI QuickAccess_EnumObjects( IShellFolder2 *iface, HWND hwnd, SHCONTF flags, IEnumIDList **ret )
+{
+    QuickAccessFolder *This = qa_from_IShellFolder2( iface );
+    struct qa_frequent_folder freq[QA_MAX_FREQUENT];
+    IEnumIDListImpl *list;
+    unsigned int i, count;
+    WCHAR *pins, *p;
+
+    TRACE( "(%p)->(%#lx)\n", This, flags );
+    if (!ret) return E_POINTER;
+    *ret = NULL;
+    if (!(list = IEnumIDList_Constructor())) return E_OUTOFMEMORY;
+    if (flags & SHCONTF_FOLDERS)
+    {
+#ifndef SG_MUTANT_QUICK_ACCESS_EMPTY
+        if ((pins = read_pins()))
+        {
+            for (p = pins; *p; p += lstrlenW( p ) + 1)
+                if (PathIsDirectoryW( p )) AddToEnumList( list, qa_make_pidl( p, TRUE ) );
+            free( pins );
+        }
+        count = qa_frequent_folders( freq, ARRAY_SIZE(freq) );
+        for (i = 0; i < count; i++) AddToEnumList( list, qa_make_pidl( freq[i].path, FALSE ) );
+#endif
+    }
+    *ret = &list->IEnumIDList_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI QuickAccess_BindToObject( IShellFolder2 *iface, LPCITEMIDLIST pidl, IBindCtx *bc,
+                                                REFIID riid, void **ppv )
+{
+    LPITEMIDLIST first, target;
+    IShellFolder *desktop, *folder;
+    HRESULT hr;
+
+    TRACE( "(%p %s %p)\n", pidl, debugstr_guid(riid), ppv );
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!(first = ILCloneFirst( pidl ))) return E_OUTOFMEMORY;
+    target = qa_target( first );
+    ILFree( first );
+    if (!target) return E_INVALIDARG;
+    if (SUCCEEDED(hr = SHGetDesktopFolder( &desktop )))
+    {
+        if (_ILIsPidlSimple( pidl ))
+            hr = IShellFolder_BindToObject( desktop, target, bc, riid, ppv );
+        else if (SUCCEEDED(hr = IShellFolder_BindToObject( desktop, target, bc, &IID_IShellFolder, (void **)&folder )))
+        {
+            hr = IShellFolder_BindToObject( folder, ILGetNext( pidl ), bc, riid, ppv );
+            IShellFolder_Release( folder );
+        }
+        IShellFolder_Release( desktop );
+    }
+    ILFree( target );
+    return hr;
+}
+
+static HRESULT WINAPI QuickAccess_BindToStorage( IShellFolder2 *iface, LPCITEMIDLIST pidl, IBindCtx *bc,
+                                                 REFIID riid, void **ppv )
+{
+    LPITEMIDLIST target;
+    IShellFolder *desktop;
+    HRESULT hr;
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!_ILIsPidlSimple( pidl )) return QuickAccess_BindToObject( iface, pidl, bc, riid, ppv );
+    if (!(target = qa_target( pidl ))) return E_INVALIDARG;
+    if (SUCCEEDED(hr = SHGetDesktopFolder( &desktop )))
+    {
+        hr = IShellFolder_BindToStorage( desktop, target, bc, riid, ppv );
+        IShellFolder_Release( desktop );
+    }
+    ILFree( target );
+    return hr;
+}
+
+static HRESULT WINAPI QuickAccess_CompareIDs( IShellFolder2 *iface, LPARAM lparam, LPCITEMIDLIST pidl1, LPCITEMIDLIST pidl2 )
+{
+    const struct qa_pidl *a = qa_pidl( pidl1 ), *b = qa_pidl( pidl2 );
+    int r;
+
+    if (!a || !b) return E_INVALIDARG;
+    r = lstrcmpiW( a->path, b->path );
+    if (!r && (!_ILIsPidlSimple( pidl1 ) || !_ILIsPidlSimple( pidl2 )))
+    {
+        /* the same folder: the rest of each path decides, as that folder orders it */
+        IShellFolder *folder;
+        LPITEMIDLIST first = ILCloneFirst( pidl1 );
+        HRESULT hr;
+
+        if (_ILIsPidlSimple( pidl1 )) { ILFree( first ); return MAKE_HRESULT( SEVERITY_SUCCESS, 0, (USHORT)-1 ); }
+        if (_ILIsPidlSimple( pidl2 )) { ILFree( first ); return MAKE_HRESULT( SEVERITY_SUCCESS, 0, 1 ); }
+        hr = QuickAccess_BindToObject( iface, first, NULL, &IID_IShellFolder, (void **)&folder );
+        ILFree( first );
+        if (FAILED(hr)) return hr;
+        hr = IShellFolder_CompareIDs( folder, lparam, ILGetNext( pidl1 ), ILGetNext( pidl2 ) );
+        IShellFolder_Release( folder );
+        return hr;
+    }
+    return MAKE_HRESULT( SEVERITY_SUCCESS, 0, (USHORT)(r < 0 ? -1 : r > 0 ? 1 : 0) );
+}
+
+static HRESULT WINAPI QuickAccess_CreateViewObject( IShellFolder2 *iface, HWND hwnd, REFIID riid, void **ppv )
+{
+    QuickAccessFolder *This = qa_from_IShellFolder2( iface );
+    IShellView *view;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%s %p)\n", This, debugstr_guid(riid), ppv );
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!IsEqualIID( riid, &IID_IShellView )) return E_NOINTERFACE;
+    if (!(view = IShellView_Constructor( (IShellFolder *)iface ))) return E_OUTOFMEMORY;
+    hr = IShellView_QueryInterface( view, riid, ppv );
+    IShellView_Release( view );
+    return hr;
+}
+
+static HRESULT WINAPI QuickAccess_GetAttributesOf( IShellFolder2 *iface, UINT count, LPCITEMIDLIST *items, SFGAOF *attrs )
+{
+    SFGAOF all = ~0u;
+    UINT i;
+
+    if (!attrs) return E_POINTER;
+    if (!count)
+    {
+        *attrs &= SFGAO_FOLDER | SFGAO_HASSUBFOLDER | SFGAO_BROWSABLE;
+        return S_OK;
+    }
+    for (i = 0; i < count; i++)
+    {
+        IShellFolder *parent;
+        LPITEMIDLIST target;
+        LPCITEMIDLIST last;
+        SFGAOF a = *attrs;
+
+        if (!qa_pidl( items[i] )) return E_INVALIDARG;
+        if (FAILED(qa_target_parent( items[i], &parent, &target, &last ))) { all = 0; continue; }
+        if (FAILED(IShellFolder_GetAttributesOf( parent, 1, &last, &a ))) a = 0;
+        IShellFolder_Release( parent );
+        ILFree( target );
+        all &= a;
+    }
+    *attrs &= all;
+    return S_OK;
+}
+
+static HRESULT WINAPI QuickAccess_GetUIObjectOf( IShellFolder2 *iface, HWND hwnd, UINT count, LPCITEMIDLIST *items,
+                                                 REFIID riid, UINT *reserved, void **ppv )
+{
+    IShellFolder *parent;
+    LPITEMIDLIST target;
+    LPCITEMIDLIST last;
+    HRESULT hr;
+
+    TRACE( "(%u %s %p)\n", count, debugstr_guid(riid), ppv );
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!count || !items) return E_INVALIDARG;
+    if (count > 1)
+    {
+        /* several folders: their paths for copying and dragging */
+        WCHAR *paths, *p;
+        size_t len = 1;
+        UINT i;
+
+        if (!IsEqualIID( riid, &IID_IDataObject )) return E_NOTIMPL;
+        for (i = 0; i < count; i++)
+        {
+            if (!qa_pidl( items[i] )) return E_INVALIDARG;
+            len += wcslen( qa_pidl( items[i] )->path ) + 1;
+        }
+        if (!(paths = calloc( len, sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+        for (i = 0, p = paths; i < count; i++)
+        {
+            lstrcpyW( p, qa_pidl( items[i] )->path );
+            p += wcslen( p ) + 1;
+        }
+        hr = SHELL_CreateHDropDataObject( paths, (IDataObject **)ppv );
+        free( paths );
+        return hr;
+    }
+    if (FAILED(hr = qa_target_parent( items[0], &parent, &target, &last ))) return hr;
+    hr = IShellFolder_GetUIObjectOf( parent, hwnd, 1, &last, riid, reserved, ppv );
+    IShellFolder_Release( parent );
+    ILFree( target );
+    return hr;
+}
+
+static HRESULT WINAPI QuickAccess_GetDisplayNameOf( IShellFolder2 *iface, LPCITEMIDLIST pidl, SHGDNF flags, STRRET *name )
+{
+    const struct qa_pidl *q = qa_pidl( pidl );
+    IShellFolder *parent;
+    LPITEMIDLIST target;
+    LPCITEMIDLIST last;
+    HRESULT hr;
+
+    if (!name) return E_POINTER;
+    if (_ILIsEmpty( pidl ))
+    {
+        name->uType = STRRET_WSTR;
+        return SHStrDupW( (flags & SHGDN_FORPARSING) ? L"::{679F85CB-0220-4080-B29B-5540CC05AAB6}" : L"Quick access",
+                          &name->pOleStr );
+    }
+    if (!q) return E_INVALIDARG;
+    if (!_ILIsPidlSimple( pidl ))
+    {
+        IShellFolder *folder;
+        LPITEMIDLIST head = ILClone( pidl );
+
+        ILRemoveLastID( head );
+        hr = QuickAccess_BindToObject( iface, head, NULL, &IID_IShellFolder, (void **)&folder );
+        ILFree( head );
+        if (FAILED(hr)) return hr;
+        hr = IShellFolder_GetDisplayNameOf( folder, ILFindLastID( pidl ), flags, name );
+        IShellFolder_Release( folder );
+        return hr;
+    }
+    if (flags & SHGDN_FORPARSING)
+    {
+        /* the folder's own path: an item here stands for it */
+        name->uType = STRRET_WSTR;
+        return SHStrDupW( q->path, &name->pOleStr );
+    }
+    if (FAILED(hr = qa_target_parent( pidl, &parent, &target, &last ))) return hr;
+    hr = IShellFolder_GetDisplayNameOf( parent, last, flags, name );
+    if (SUCCEEDED(hr) && name->uType == STRRET_OFFSET)
+    {
+        /* the offset is into the target's ID, which goes away below */
+        WCHAR buf[MAX_PATH];
+        StrRetToBufW( name, last, buf, ARRAY_SIZE(buf) );
+        name->uType = STRRET_WSTR;
+        hr = SHStrDupW( buf, &name->pOleStr );
+    }
+    IShellFolder_Release( parent );
+    ILFree( target );
+    return hr;
+}
+
+static HRESULT WINAPI QuickAccess_SetNameOf( IShellFolder2 *iface, HWND hwnd, LPCITEMIDLIST pidl, LPCOLESTR new_name,
+                                             SHGDNF flags, LPITEMIDLIST *out )
+{
+    if (out) *out = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI QuickAccess_GetDefaultSearchGUID( IShellFolder2 *iface, GUID *guid )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI QuickAccess_EnumSearches( IShellFolder2 *iface, IEnumExtraSearch **ret )
+{
+    if (ret) *ret = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI QuickAccess_GetDefaultColumn( IShellFolder2 *iface, DWORD reserved, ULONG *sort, ULONG *display )
+{
+    if (sort) *sort = 0;
+    if (display) *display = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI QuickAccess_GetDefaultColumnState( IShellFolder2 *iface, UINT column, SHCOLSTATEF *flags )
+{
+    if (!flags) return E_POINTER;
+    if (column) return E_INVALIDARG;
+    *flags = SHCOLSTATE_TYPE_STR | SHCOLSTATE_ONBYDEFAULT;
+    return S_OK;
+}
+
+static HRESULT WINAPI QuickAccess_GetDetailsEx( IShellFolder2 *iface, LPCITEMIDLIST pidl, const SHCOLUMNID *scid,
+                                                VARIANT *v )
+{
+    IShellFolder2 *parent2;
+    IShellFolder *parent;
+    LPITEMIDLIST target;
+    LPCITEMIDLIST last;
+    HRESULT hr;
+
+    if (!qa_pidl( pidl ) || !_ILIsPidlSimple( pidl )) return E_INVALIDARG;
+    if (FAILED(hr = qa_target_parent( pidl, &parent, &target, &last ))) return hr;
+    if (SUCCEEDED(hr = IShellFolder_QueryInterface( parent, &IID_IShellFolder2, (void **)&parent2 )))
+    {
+        hr = IShellFolder2_GetDetailsEx( parent2, last, scid, v );
+        IShellFolder2_Release( parent2 );
+    }
+    IShellFolder_Release( parent );
+    ILFree( target );
+    return hr;
+}
+
+static HRESULT WINAPI QuickAccess_GetDetailsOf( IShellFolder2 *iface, LPCITEMIDLIST pidl, UINT column, SHELLDETAILS *details )
+{
+    IShellFolder2 *parent2;
+    IShellFolder *parent;
+    LPITEMIDLIST target;
+    LPCITEMIDLIST last;
+    HRESULT hr;
+
+    if (!details) return E_POINTER;
+    if (column) return E_INVALIDARG;   /* the name, as the folders' own parents give it */
+    if (!pidl)
+    {
+        details->fmt = LVCFMT_LEFT;
+        details->cxChar = 30;
+        details->str.uType = STRRET_WSTR;
+        return SHStrDupW( L"Name", &details->str.pOleStr );
+    }
+    if (!qa_pidl( pidl ) || !_ILIsPidlSimple( pidl )) return E_INVALIDARG;
+    if (FAILED(hr = qa_target_parent( pidl, &parent, &target, &last ))) return hr;
+    if (SUCCEEDED(hr = IShellFolder_QueryInterface( parent, &IID_IShellFolder2, (void **)&parent2 )))
+    {
+        hr = IShellFolder2_GetDetailsOf( parent2, last, column, details );
+        if (SUCCEEDED(hr) && details->str.uType == STRRET_OFFSET)
+        {
+            WCHAR buf[MAX_PATH];
+            StrRetToBufW( &details->str, last, buf, ARRAY_SIZE(buf) );
+            details->str.uType = STRRET_WSTR;
+            hr = SHStrDupW( buf, &details->str.pOleStr );
+        }
+        IShellFolder2_Release( parent2 );
+    }
+    IShellFolder_Release( parent );
+    ILFree( target );
+    return hr;
+}
+
+static HRESULT WINAPI QuickAccess_MapColumnToSCID( IShellFolder2 *iface, UINT column, SHCOLUMNID *scid )
+{
