From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vcomp: MSVC's dynamic loops get chunks of their own size (6547)

_vcomp_for_dynamic_init took every flag but the increment bit as the
schedule kind. MSVC passes 0x20 besides the kind on schedule(dynamic)
loops (digiKam's libraw: 0x62 = increment | 0x20 | chunked, chunk 1);
0x22 was an unknown kind, run as guided. A loop MSVC compiled for chunks
of one iteration then ran only the first iteration of each guided chunk:
digiKam's editor showed a RAW photo as a few coloured lines on black.

The kind is the low four bits; the rest modify it. A test covers 0x20
with chunked scheduling.
---
diff --git a/dlls/vcomp/main.c b/dlls/vcomp/main.c
index 872228c..4f6098a 100644
--- a/dlls/vcomp/main.c
+++ b/dlls/vcomp/main.c
@@ -59,6 +59,7 @@ static RTL_CRITICAL_SECTION vcomp_section = { &critsect_debug, -1, 0, 0, 0, 0 };
 #define VCOMP_DYNAMIC_FLAGS_CHUNKED     0x02
 #define VCOMP_DYNAMIC_FLAGS_GUIDED      0x03
 #define VCOMP_DYNAMIC_FLAGS_INCREMENT   0x40
+#define VCOMP_DYNAMIC_FLAGS_TYPE_MASK   0x0f
 
 struct vcomp_thread_data
 {
@@ -1284,7 +1285,16 @@ void CDECL _vcomp_for_dynamic_init(unsigned int flags, unsigned int first, unsig
     struct vcomp_task_data *task_data = thread_data->task;
     int num_threads = team_data ? team_data->num_threads : 1;
     int thread_num = thread_data->thread_num;
+#ifdef SG_MUTANT_VCOMP_TYPE_WITH_MODIFIERS
     unsigned int type = flags & ~VCOMP_DYNAMIC_FLAGS_INCREMENT;
+#else
+    /* Stained Glass OS: the schedule kind is the low bits; the rest modify it
+     * (0x40 increment, and 0x20, which MSVC sets on schedule(dynamic) loops:
+     * digiKam's libraw, 0x62). Taken as an unknown kind, 0x22 became guided,
+     * and a loop MSVC compiled for chunks of one iteration ran only the first
+     * row of each guided chunk: RAW photos decoded to a few lines. */
+    unsigned int type = flags & VCOMP_DYNAMIC_FLAGS_TYPE_MASK;
+#endif
 
     TRACE("(%u, %u, %u, %d, %u)\n", flags, first, last, step, chunksize);
 
@@ -1399,7 +1409,16 @@ void CDECL _vcomp_for_dynamic_init_i8(unsigned int flags, ULONG64 first, ULONG64
     struct vcomp_task_data *task_data = thread_data->task;
     int num_threads = team_data ? team_data->num_threads : 1;
     int thread_num = thread_data->thread_num;
+#ifdef SG_MUTANT_VCOMP_TYPE_WITH_MODIFIERS
     unsigned int type = flags & ~VCOMP_DYNAMIC_FLAGS_INCREMENT;
+#else
+    /* Stained Glass OS: the schedule kind is the low bits; the rest modify it
+     * (0x40 increment, and 0x20, which MSVC sets on schedule(dynamic) loops:
+     * digiKam's libraw, 0x62). Taken as an unknown kind, 0x22 became guided,
+     * and a loop MSVC compiled for chunks of one iteration ran only the first
+     * row of each guided chunk: RAW photos decoded to a few lines. */
+    unsigned int type = flags & VCOMP_DYNAMIC_FLAGS_TYPE_MASK;
+#endif
 
     TRACE("(%u, %s, %s, %s, %s)\n", flags, wine_dbgstr_longlong(first), wine_dbgstr_longlong(last),
           wine_dbgstr_longlong(step), wine_dbgstr_longlong(chunksize));
diff --git a/dlls/vcomp/tests/vcomp.c b/dlls/vcomp/tests/vcomp.c
index 3542581..da6be8b 100644
--- a/dlls/vcomp/tests/vcomp.c
+++ b/dlls/vcomp/tests/vcomp.c
@@ -1576,6 +1576,22 @@ static void CDECL for_dynamic_chunked_cb(LONG *a, LONG *b, LONG *c, LONG *d)
     }
 }
 
+/* MSVC's schedule(dynamic) loops pass 0x20 besides the kind (digiKam's libraw:
+ * 0x62, chunks of 1): still chunked */
+static void CDECL for_dynamic_chunked_0x20_cb(LONG *a, LONG *b)
+{
+    unsigned int begin, end;
+
+    p_vcomp_for_dynamic_init(0x20 | VCOMP_DYNAMIC_FLAGS_CHUNKED | VCOMP_DYNAMIC_FLAGS_INCREMENT, 0, 1000, 7, 1);
+    while (p_vcomp_for_dynamic_next(&begin, &end))
+    {
+        if (begin == 994) ok(end == 1000, "expected end == 1000, got %u\n", end);
+        else ok(begin == end, "expected begin == end, got %u and %u\n", begin, end);
+        InterlockedExchangeAdd(a, begin);
+        InterlockedIncrement(b);
+    }
+}
+
 static void CDECL for_dynamic_guided_cb(unsigned int flags, LONG *a, LONG *b, LONG *c, LONG *d)
 {
     int num_threads = pomp_get_num_threads();
@@ -1661,6 +1677,15 @@ static void test_vcomp_for_dynamic_init(void)
         ok(d == 14790, "expected d == 14790, got %ld\n", d);
     }
 
+    for (i = 1; i <= 4; i++)
+    {
+        pomp_set_num_threads(i);
+        a = b = 0;
+        p_vcomp_fork(TRUE, 2, for_dynamic_chunked_0x20_cb, &a, &b);
+        ok(a == 71071, "expected a == 71071, got %ld\n", a);
+        ok(b == 143, "expected b == 143, got %ld\n", b);
+    }
+
     /* test guided scheduling */
     a = b = c = d = 0;
     for_dynamic_guided_cb(VCOMP_DYNAMIC_FLAGS_GUIDED, &a, &b, &c, &d);
