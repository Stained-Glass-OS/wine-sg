From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 07:20:21 -0700
Subject: [PATCH] msctf: ITfInputProcessorProfileMgr over the keyboard layouts

EnumProfiles lists one TF_PROFILETYPE_KEYBOARDLAYOUT profile per installed layout (optionally filtered by
language) with Next/Reset/Skip/Clone, GetActiveProfile returns the calling thread's layout for the keyboard
category (S_FALSE for other categories), GetProfile finds a layout by HKL or language.

diff --git a/dlls/msctf/inputprocessor.c b/dlls/msctf/inputprocessor.c
index 511d302..4add3f4 100644
--- a/dlls/msctf/inputprocessor.c
+++ b/dlls/msctf/inputprocessor.c
@@ -86,8 +86,48 @@ typedef struct tagEnumTfLanguageProfiles {
 typedef struct {
     IEnumTfInputProcessorProfiles IEnumTfInputProcessorProfiles_iface;
     LONG ref;
+
+    HKL *layouts;
+    UINT count;
+    UINT index;
 } EnumTfInputProcessorProfiles;
 
+#ifndef TF_IPP_FLAG_ACTIVE
+#define TF_IPP_FLAG_ACTIVE 0x1
+#define TF_IPP_FLAG_ENABLED 0x2
+#endif
+
+static const IEnumTfInputProcessorProfilesVtbl EnumTfInputProcessorProfilesVtbl;
+
+/* The profiles of this system are its keyboard layouts (there are no installed
+ * text input processors), one TF_PROFILETYPE_KEYBOARDLAYOUT profile each. */
+static void fill_layout_profile(HKL hkl, TF_INPUTPROCESSORPROFILE *profile)
+{
+    memset(profile, 0, sizeof(*profile));
+    profile->dwProfileType = TF_PROFILETYPE_KEYBOARDLAYOUT;
+    profile->langid = LOWORD(HandleToULong(hkl));
+    profile->catid = GUID_TFCAT_TIP_KEYBOARD;
+    profile->hkl = hkl;
+    profile->dwFlags = TF_IPP_FLAG_ENABLED;
+    if (hkl == GetKeyboardLayout(0)) profile->dwFlags |= TF_IPP_FLAG_ACTIVE;
+}
+
+static HKL *get_layouts(LANGID langid, UINT *count)
+{
+    HKL *all, *out;
+    UINT n, i, m = 0;
+
+    *count = 0;
+    if (!(n = GetKeyboardLayoutList(0, NULL))) return NULL;
+    if (!(all = malloc(n * sizeof(*all)))) return NULL;
+    n = GetKeyboardLayoutList(n, all);
+    out = all;
+    for (i = 0; i < n; i++)
+        if (!langid || LOWORD(HandleToULong(all[i])) == langid) out[m++] = all[i];
+    *count = m;
+    return out;
+}
+
 static HRESULT ProfilesEnumGuid_Constructor(IEnumGUID **ppOut);
 static HRESULT EnumTfLanguageProfiles_Constructor(LANGID langid, EnumTfLanguageProfiles **out);
 
@@ -135,7 +175,10 @@ static ULONG WINAPI EnumTfInputProcessorProfiles_Release(IEnumTfInputProcessorPr
     TRACE("(%p) ref=%ld\n", This, ref);
 
     if(!ref)
+    {
+        free(This->layouts);
         free(This);
+    }
 
     return ref;
 }
@@ -143,35 +186,64 @@ static ULONG WINAPI EnumTfInputProcessorProfiles_Release(IEnumTfInputProcessorPr
 static HRESULT WINAPI EnumTfInputProcessorProfiles_Clone(IEnumTfInputProcessorProfiles *iface,
         IEnumTfInputProcessorProfiles **ret)
 {
-    EnumTfInputProcessorProfiles *This = impl_from_IEnumTfInputProcessorProfiles(iface);
-    FIXME("(%p)->(%p)\n", This, ret);
-    return E_NOTIMPL;
+    EnumTfInputProcessorProfiles *This = impl_from_IEnumTfInputProcessorProfiles(iface), *clone;
+
+    TRACE("(%p)->(%p)\n", This, ret);
+
+    if (!ret) return E_INVALIDARG;
+    if (!(clone = calloc(1, sizeof(*clone)))) return E_OUTOFMEMORY;
+    clone->IEnumTfInputProcessorProfiles_iface.lpVtbl = &EnumTfInputProcessorProfilesVtbl;
+    clone->ref = 1;
+    clone->count = This->count;
+    clone->index = This->index;
+    if (This->count && !(clone->layouts = malloc(This->count * sizeof(*clone->layouts))))
+    {
+        free(clone);
+        return E_OUTOFMEMORY;
+    }
+    if (This->count) memcpy(clone->layouts, This->layouts, This->count * sizeof(*clone->layouts));
+    *ret = &clone->IEnumTfInputProcessorProfiles_iface;
+    return S_OK;
 }
 
 static HRESULT WINAPI EnumTfInputProcessorProfiles_Next(IEnumTfInputProcessorProfiles *iface, ULONG count,
         TF_INPUTPROCESSORPROFILE *profile, ULONG *fetch)
 {
     EnumTfInputProcessorProfiles *This = impl_from_IEnumTfInputProcessorProfiles(iface);
+    ULONG n = 0;
 
-    FIXME("(%p)->(%lu %p %p)\n", This, count, profile, fetch);
+    TRACE("(%p)->(%lu %p %p)\n", This, count, profile, fetch);
 
-    if(fetch)
-        *fetch = 0;
-    return S_FALSE;
+    if (!profile || (!fetch && count > 1)) return E_INVALIDARG;
+    while (n < count && This->index < This->count)
+        fill_layout_profile(This->layouts[This->index++], &profile[n++]);
+    if (fetch) *fetch = n;
+    return n == count ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI EnumTfInputProcessorProfiles_Reset(IEnumTfInputProcessorProfiles *iface)
 {
     EnumTfInputProcessorProfiles *This = impl_from_IEnumTfInputProcessorProfiles(iface);
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+
+    TRACE("(%p)\n", This);
+
+    This->index = 0;
+    return S_OK;
 }
 
 static HRESULT WINAPI EnumTfInputProcessorProfiles_Skip(IEnumTfInputProcessorProfiles *iface, ULONG count)
 {
     EnumTfInputProcessorProfiles *This = impl_from_IEnumTfInputProcessorProfiles(iface);
-    FIXME("(%p)->(%lu)\n", This, count);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%lu)\n", This, count);
+
+    if (count > This->count - This->index)
+    {
+        This->index = This->count;
+        return S_FALSE;
+    }
+    This->index += count;
+    return S_OK;
 }
 
 static const IEnumTfInputProcessorProfilesVtbl EnumTfInputProcessorProfilesVtbl = {
@@ -812,9 +884,30 @@ static HRESULT WINAPI InputProcessorProfileMgr_GetProfile(ITfInputProcessorProfi
         LANGID langid, REFCLSID clsid, REFGUID guidProfile, HKL hkl, TF_INPUTPROCESSORPROFILE *pProfile)
 {
     InputProcessorProfiles *This = impl_from_ITfInputProcessorProfileMgr(iface);
-    FIXME("(%p)->(%ld %x %s %s %p %p)\n", This, dwProfileType, langid, debugstr_guid(clsid),
+    HKL *layouts;
+    UINT count, i;
+    HRESULT hr = E_FAIL;
+
+    TRACE("(%p)->(%ld %x %s %s %p %p)\n", This, dwProfileType, langid, debugstr_guid(clsid),
           debugstr_guid(guidProfile), hkl, pProfile);
-    return E_NOTIMPL;
+
+    if (!pProfile) return E_INVALIDARG;
+    memset(pProfile, 0, sizeof(*pProfile));
+    if (dwProfileType != TF_PROFILETYPE_KEYBOARDLAYOUT && dwProfileType != TF_PROFILETYPE_INPUTPROCESSOR)
+        return E_INVALIDARG;
+    /* only keyboard layouts exist here */
+    if (dwProfileType == TF_PROFILETYPE_INPUTPROCESSOR) return E_FAIL;
+
+    layouts = get_layouts(0, &count);
+    for (i = 0; i < count; i++)
+        if (layouts[i] == hkl || (!hkl && LOWORD(HandleToULong(layouts[i])) == langid))
+        {
+            fill_layout_profile(layouts[i], pProfile);
+            hr = S_OK;
+            break;
+        }
+    free(layouts);
+    return hr;
 }
 
 static HRESULT WINAPI InputProcessorProfileMgr_EnumProfiles(ITfInputProcessorProfileMgr *iface, LANGID langid,
@@ -825,12 +918,14 @@ static HRESULT WINAPI InputProcessorProfileMgr_EnumProfiles(ITfInputProcessorPro
 
     TRACE("(%p)->(%x %p)\n", This, langid, ppEnum);
 
-    enum_profiles = malloc(sizeof(*enum_profiles));
+    if (!ppEnum) return E_INVALIDARG;
+    enum_profiles = calloc(1, sizeof(*enum_profiles));
     if(!enum_profiles)
         return E_OUTOFMEMORY;
 
     enum_profiles->IEnumTfInputProcessorProfiles_iface.lpVtbl = &EnumTfInputProcessorProfilesVtbl;
     enum_profiles->ref = 1;
+    enum_profiles->layouts = get_layouts(langid, &enum_profiles->count);
 
     *ppEnum = &enum_profiles->IEnumTfInputProcessorProfiles_iface;
     return S_OK;
@@ -867,15 +962,20 @@ static HRESULT WINAPI InputProcessorProfileMgr_UnregisterProfile(ITfInputProcess
 static HRESULT WINAPI InputProcessorProfileMgr_GetActiveProfile(ITfInputProcessorProfileMgr *iface, REFGUID catid,
         TF_INPUTPROCESSORPROFILE *pProfile)
 {
-    static int once;
+    InputProcessorProfiles *This = impl_from_ITfInputProcessorProfileMgr(iface);
 
-    if (!once++)
-    {
-        InputProcessorProfiles *This = impl_from_ITfInputProcessorProfileMgr(iface);
-        FIXME("(%p)->(%s %p)\n", This, debugstr_guid(catid), pProfile);
-    }
+    TRACE("(%p)->(%s %p)\n", This, debugstr_guid(catid), pProfile);
 
+#ifdef SG_MUTANT_MSCTFPROF
     return E_NOTIMPL;
+#endif
+    if (!catid || !pProfile) return E_INVALIDARG;
+    memset(pProfile, 0, sizeof(*pProfile));
+    /* the keyboard category is the one with an active profile: the layout of
+     * the calling thread; no other category has one without text services */
+    if (!IsEqualGUID(catid, &GUID_TFCAT_TIP_KEYBOARD)) return S_FALSE;
+    fill_layout_profile(GetKeyboardLayout(0), pProfile);
+    return S_OK;
 }
 
 static const ITfInputProcessorProfileMgrVtbl InputProcessorProfileMgrVtbl = {
