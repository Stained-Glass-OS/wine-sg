From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mf: The transcode API (9405)

MFCreateTranscodeTopology was E_NOTIMPL (Zoom's media adapter imports it; 7853) and
MFCreateTranscodeSinkActivate a stub. As documented: a partial topology of, per selected stream the
profile has attributes for, a source node, an encoder node (an encoder MFT for the profile's subtype,
its types set, video attributes the profile leaves out taken from the source) and an output node on the
transcode sink activation object; streams the profile has nothing for are deselected;
MF_E_TRANSCODE_NO_CONTAINERTYPE, MF_E_TRANSCODE_PROFILE_NO_MATCHING_STREAMS,
MF_E_TRANSCODE_NO_MATCHING_ENCODER, MF_E_MEDIA_SOURCE_NO_STREAMS_SELECTED. The sink activation object
(IMFTranscodeSinkInfoProvider -- added to mfidl.idl, layout as in Windows' metadata) makes the
MF_TRANSCODE_CONTAINERTYPE sink (MPEG-4, 3GP, fragmented MPEG-4, MP3, ADTS, AC-3, WAVE, ASF) on the
output file when the session activates it; its stream types are the encoders' actual output types.
---
--- a/include/mfidl.idl
+++ b/include/mfidl.idl
@@ -1716,6 +1716,27 @@
     HRESULT GetContainerAttributes([out] IMFAttributes **attrs);
 }
 
+typedef struct _MF_TRANSCODE_SINK_INFO
+{
+    DWORD dwVideoStreamID;
+    IMFMediaType *pVideoMediaType;
+    DWORD dwAudioStreamID;
+    IMFMediaType *pAudioMediaType;
+} MF_TRANSCODE_SINK_INFO;
+
+[
+    object,
+    uuid(8cffcd2e-5a03-4a3a-aff7-edcd107c620e),
+    local
+]
+interface IMFTranscodeSinkInfoProvider : IUnknown
+{
+    HRESULT SetOutputFile([in] LPCWSTR filename);
+    HRESULT SetOutputByteStream([in] IMFActivate *bytestream_activate);
+    HRESULT SetProfile([in] IMFTranscodeProfile *profile);
+    HRESULT GetSinkInfo([out] MF_TRANSCODE_SINK_INFO *info);
+}
+
 [
     object,
     uuid(994e23af-1cc2-493c-b9fa-46f1cb040fa4)
@@ -1728,6 +1749,8 @@
 }
 
 cpp_quote("HRESULT WINAPI MFCreateTranscodeProfile(IMFTranscodeProfile **profile);")
+cpp_quote("HRESULT WINAPI MFCreateTranscodeSinkActivate(IMFActivate **activate);")
+cpp_quote("HRESULT WINAPI MFCreateTranscodeTopology(IMFMediaSource *source, LPCWSTR url, IMFTranscodeProfile *profile, IMFTopology **topology);")
 cpp_quote("HRESULT WINAPI MFCreatePMPServer(DWORD flags, IMFPMPServer **server);")
 cpp_quote("HRESULT WINAPI MFCreatePMPMediaSession(DWORD flags, IMFAttributes *config, IMFMediaSession **session, IMFActivate **enabler_activate);")
 cpp_quote("HRESULT WINAPI MFCreateDeviceSource(IMFAttributes *attributes, IMFMediaSource **source);")
--- a/dlls/mf/sg_transcode.c
+++ b/dlls/mf/sg_transcode.c
@@ -1,5 +1,5 @@
 /*
- * MFCreateTranscodeTopology (7853)
+ * The transcode API: MFCreateTranscodeTopology, MFCreateTranscodeSinkActivate
  *
  * Copyright 2026 Stained Glass OS
