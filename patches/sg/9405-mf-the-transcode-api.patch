+/*
+ * Stained Glass OS (wine-sg 7853 made MFCreateTranscodeTopology a clean E_NOTIMPL for Zoom's media
+ * adapter; wine-sg 9405 builds it): as Microsoft documents it, MFCreateTranscodeTopology makes a partial
+ * topology -- per selected stream of the source that the profile has attributes for, a source node, an
+ * encoder node (an encoder MFT for the profile's subtype, its types set from the profile) and an output
+ * node on the transcode sink activation object; streams the profile has nothing for are deselected. The
+ * Media Session's topology loader adds the decoders and converters in front of the encoders. The sink
+ * activation object (MFCreateTranscodeSinkActivate, IMFTranscodeSinkInfoProvider) creates the container
+ * sink of MF_TRANSCODE_CONTAINERTYPE (MPEG-4, 3GP, MP3, ADTS, AC-3, fragmented MPEG-4, WAVE or ASF) on
+ * the output file when the session activates it.
+ */
+
 #define COBJMACROS
 #include <stdarg.h>
 #include "windef.h"
 #include "winbase.h"
+#include "mfapi.h"
+#include "mferror.h"
 #include "mfidl.h"
+#include "wmcontainer.h"
+#include "wine/mfinternal.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
 
-/* a topology that encodes a source into a file: the transcode API is not built here; the caller
- * (Zoom's media adapter) is told so instead of the program ending at a stub */
+#define TRANSCODE_VIDEO_ID 1
+
+static DWORD audio_stream_id(const GUID *container)
+{
+    /* the WAVE sink's only stream is 1; the other sinks put audio beside video as 2 */
+    return IsEqualGUID(container, &MFTranscodeContainerType_WAVE) ? 1 : 2;
+}
+
+static HRESULT media_type_from_attributes(IMFAttributes *attributes, const GUID *major, IMFMediaType **out)
+{
+    IMFMediaType *type;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&type)))
+        return hr;
+    if (SUCCEEDED(hr = IMFAttributes_CopyAllItems(attributes, (IMFAttributes *)type)))
+        hr = IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, major);
+    if (FAILED(hr))
+    {
+        IMFMediaType_Release(type);
+        return hr;
+    }
+    *out = type;
+    return S_OK;
+}
+
+/* transcode sink activation object */
+
+struct transcode_sink
+{
+    IMFActivate IMFActivate_iface;
+    IMFTranscodeSinkInfoProvider IMFTranscodeSinkInfoProvider_iface;
+    LONG refcount;
+    CRITICAL_SECTION cs;
+    IMFAttributes *attributes;
+    WCHAR *url;
+    IMFActivate *bytestream_activate;
+    GUID container;
+    IMFMediaType *audio_type, *video_type;
+    IMFMediaSink *sink;
+};
+
+static struct transcode_sink *impl_from_IMFActivate(IMFActivate *iface)
+{
+    return CONTAINING_RECORD(iface, struct transcode_sink, IMFActivate_iface);
+}
+
+static struct transcode_sink *impl_from_IMFTranscodeSinkInfoProvider(IMFTranscodeSinkInfoProvider *iface)
+{
+    return CONTAINING_RECORD(iface, struct transcode_sink, IMFTranscodeSinkInfoProvider_iface);
+}
+
+static HRESULT WINAPI transcode_sink_QueryInterface(IMFActivate *iface, REFIID riid, void **out)
+{
+    struct transcode_sink *sink = impl_from_IMFActivate(iface);
+
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFActivate) || IsEqualIID(riid, &IID_IMFAttributes) || IsEqualIID(riid, &IID_IUnknown))
+        *out = &sink->IMFActivate_iface;
+    else if (IsEqualIID(riid, &IID_IMFTranscodeSinkInfoProvider))
+        *out = &sink->IMFTranscodeSinkInfoProvider_iface;
+    else
+    {
+        WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI transcode_sink_AddRef(IMFActivate *iface)
+{
+    return InterlockedIncrement(&impl_from_IMFActivate(iface)->refcount);
+}
+
+static ULONG WINAPI transcode_sink_Release(IMFActivate *iface)
+{
+    struct transcode_sink *sink = impl_from_IMFActivate(iface);
+    ULONG refcount = InterlockedDecrement(&sink->refcount);
+
+    if (!refcount)
+    {
+        if (sink->sink)
+            IMFMediaSink_Release(sink->sink);
+        if (sink->bytestream_activate)
+            IMFActivate_Release(sink->bytestream_activate);
+        if (sink->audio_type)
+            IMFMediaType_Release(sink->audio_type);
+        if (sink->video_type)
+            IMFMediaType_Release(sink->video_type);
+        IMFAttributes_Release(sink->attributes);
+        free(sink->url);
+        sink->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&sink->cs);
+        free(sink);
+    }
+    return refcount;
+}
+
+#define SINK_FORWARD(name, args, call) \
+static HRESULT WINAPI transcode_sink_##name args \
+{ return IMFAttributes_##name call; }
+
+SINK_FORWARD(GetItem, (IMFActivate *iface, REFGUID key, PROPVARIANT *value), (impl_from_IMFActivate(iface)->attributes, key, value))
+SINK_FORWARD(GetItemType, (IMFActivate *iface, REFGUID key, MF_ATTRIBUTE_TYPE *type), (impl_from_IMFActivate(iface)->attributes, key, type))
+SINK_FORWARD(CompareItem, (IMFActivate *iface, REFGUID key, REFPROPVARIANT value, BOOL *result), (impl_from_IMFActivate(iface)->attributes, key, value, result))
+SINK_FORWARD(Compare, (IMFActivate *iface, IMFAttributes *theirs, MF_ATTRIBUTES_MATCH_TYPE type, BOOL *result), (impl_from_IMFActivate(iface)->attributes, theirs, type, result))
+SINK_FORWARD(GetUINT32, (IMFActivate *iface, REFGUID key, UINT32 *value), (impl_from_IMFActivate(iface)->attributes, key, value))
+SINK_FORWARD(GetUINT64, (IMFActivate *iface, REFGUID key, UINT64 *value), (impl_from_IMFActivate(iface)->attributes, key, value))
+SINK_FORWARD(GetDouble, (IMFActivate *iface, REFGUID key, double *value), (impl_from_IMFActivate(iface)->attributes, key, value))
+SINK_FORWARD(GetGUID, (IMFActivate *iface, REFGUID key, GUID *value), (impl_from_IMFActivate(iface)->attributes, key, value))
+SINK_FORWARD(GetStringLength, (IMFActivate *iface, REFGUID key, UINT32 *length), (impl_from_IMFActivate(iface)->attributes, key, length))
+SINK_FORWARD(GetString, (IMFActivate *iface, REFGUID key, WCHAR *value, UINT32 size, UINT32 *length), (impl_from_IMFActivate(iface)->attributes, key, value, size, length))
+SINK_FORWARD(GetAllocatedString, (IMFActivate *iface, REFGUID key, WCHAR **value, UINT32 *length), (impl_from_IMFActivate(iface)->attributes, key, value, length))
+SINK_FORWARD(GetBlobSize, (IMFActivate *iface, REFGUID key, UINT32 *size), (impl_from_IMFActivate(iface)->attributes, key, size))
+SINK_FORWARD(GetBlob, (IMFActivate *iface, REFGUID key, UINT8 *buf, UINT32 bufsize, UINT32 *blobsize), (impl_from_IMFActivate(iface)->attributes, key, buf, bufsize, blobsize))
+SINK_FORWARD(GetAllocatedBlob, (IMFActivate *iface, REFGUID key, UINT8 **buf, UINT32 *size), (impl_from_IMFActivate(iface)->attributes, key, buf, size))
+SINK_FORWARD(GetUnknown, (IMFActivate *iface, REFGUID key, REFIID riid, void **out), (impl_from_IMFActivate(iface)->attributes, key, riid, out))
+SINK_FORWARD(SetItem, (IMFActivate *iface, REFGUID key, REFPROPVARIANT value), (impl_from_IMFActivate(iface)->attributes, key, value))
+SINK_FORWARD(DeleteItem, (IMFActivate *iface, REFGUID key), (impl_from_IMFActivate(iface)->attributes, key))
+SINK_FORWARD(DeleteAllItems, (IMFActivate *iface), (impl_from_IMFActivate(iface)->attributes))
+SINK_FORWARD(SetUINT32, (IMFActivate *iface, REFGUID key, UINT32 value), (impl_from_IMFActivate(iface)->attributes, key, value))
+SINK_FORWARD(SetUINT64, (IMFActivate *iface, REFGUID key, UINT64 value), (impl_from_IMFActivate(iface)->attributes, key, value))
+SINK_FORWARD(SetDouble, (IMFActivate *iface, REFGUID key, double value), (impl_from_IMFActivate(iface)->attributes, key, value))
+SINK_FORWARD(SetGUID, (IMFActivate *iface, REFGUID key, REFGUID value), (impl_from_IMFActivate(iface)->attributes, key, value))
+SINK_FORWARD(SetString, (IMFActivate *iface, REFGUID key, const WCHAR *value), (impl_from_IMFActivate(iface)->attributes, key, value))
+SINK_FORWARD(SetBlob, (IMFActivate *iface, REFGUID key, const UINT8 *buf, UINT32 size), (impl_from_IMFActivate(iface)->attributes, key, buf, size))
+SINK_FORWARD(SetUnknown, (IMFActivate *iface, REFGUID key, IUnknown *unknown), (impl_from_IMFActivate(iface)->attributes, key, unknown))
+SINK_FORWARD(LockStore, (IMFActivate *iface), (impl_from_IMFActivate(iface)->attributes))
+SINK_FORWARD(UnlockStore, (IMFActivate *iface), (impl_from_IMFActivate(iface)->attributes))
+SINK_FORWARD(GetCount, (IMFActivate *iface, UINT32 *count), (impl_from_IMFActivate(iface)->attributes, count))
+SINK_FORWARD(GetItemByIndex, (IMFActivate *iface, UINT32 index, GUID *key, PROPVARIANT *value), (impl_from_IMFActivate(iface)->attributes, index, key, value))
+SINK_FORWARD(CopyAllItems, (IMFActivate *iface, IMFAttributes *dest), (impl_from_IMFActivate(iface)->attributes, dest))
+
+static HRESULT create_container_sink(const GUID *container, IMFByteStream *stream, IMFMediaType *video,
+        IMFMediaType *audio, IMFMediaSink **sink)
+{
+    if (IsEqualGUID(container, &MFTranscodeContainerType_MPEG4))
+        return MFCreateMPEG4MediaSink(stream, video, audio, sink);
+    if (IsEqualGUID(container, &MFTranscodeContainerType_3GP))
+        return MFCreate3GPMediaSink(stream, video, audio, sink);
+    if (IsEqualGUID(container, &MFTranscodeContainerType_FMPEG4))
+        return MFCreateFMPEG4MediaSink(stream, video, audio, sink);
+    if (video)
+        return MF_E_INVALIDMEDIATYPE;   /* the audio containers */
+    if (IsEqualGUID(container, &MFTranscodeContainerType_MP3))
+        return MFCreateMP3MediaSink(stream, sink);
+    if (IsEqualGUID(container, &MFTranscodeContainerType_ADTS))
+        return MFCreateADTSMediaSink(stream, audio, sink);
+    if (IsEqualGUID(container, &MFTranscodeContainerType_AC3))
+        return MFCreateAC3MediaSink(stream, audio, sink);
+    if (IsEqualGUID(container, &MFTranscodeContainerType_WAVE))
+    {
+        IMFSinkClassFactory *factory;
+        HRESULT hr;
+
+        /* mfsrcsnk's, through its class factory */
+        if (!audio)
+            return MF_E_INVALIDMEDIATYPE;
+        if (FAILED(hr = CoCreateInstance(&CLSID_MFWAVESinkClassFactory, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IMFSinkClassFactory, (void **)&factory)))
+            return hr;
+        hr = IMFSinkClassFactory_CreateMediaSink(factory, stream, NULL, audio, sink);
+        IMFSinkClassFactory_Release(factory);
+        return hr;
+    }
+    FIXME("Unsupported container %s.\n", debugstr_guid(container));
+    return MF_E_INVALIDMEDIATYPE;
+}
+
+/* the sink, with a stream sink of the sink info's identifier per stream */
+static HRESULT transcode_sink_create(struct transcode_sink *sink, IMFMediaSink **out)
+{
+    IMFByteStream *stream;
+    IMFStreamSink *stream_sink;
+    IMFMediaSink *media_sink;
+    HRESULT hr;
+
+    if (sink->url)
+        hr = MFCreateFile(MF_ACCESSMODE_READWRITE, MF_OPENMODE_DELETE_IF_EXIST, MF_FILEFLAGS_NONE, sink->url, &stream);
+    else if (sink->bytestream_activate)
+        hr = IMFActivate_ActivateObject(sink->bytestream_activate, &IID_IMFByteStream, (void **)&stream);
+    else
+        hr = MF_E_NOT_INITIALIZED;
+    if (FAILED(hr))
+        return hr;
+
+    if (IsEqualGUID(&sink->container, &MFTranscodeContainerType_ASF))
+        hr = MFCreateASFMediaSink(stream, &media_sink);
+    else
+        hr = create_container_sink(&sink->container, stream, sink->video_type, sink->audio_type, &media_sink);
+    IMFByteStream_Release(stream);
+    if (FAILED(hr))
+        return hr;
+
+    /* sinks made without their streams (ASF, MP3) get them here */
+    if (SUCCEEDED(hr) && sink->video_type
+            && FAILED(IMFMediaSink_GetStreamSinkById(media_sink, TRANSCODE_VIDEO_ID, &stream_sink)))
+        hr = IMFMediaSink_AddStreamSink(media_sink, TRANSCODE_VIDEO_ID, sink->video_type, &stream_sink);
+    if (SUCCEEDED(hr) && sink->video_type)
+        IMFStreamSink_Release(stream_sink);
+    if (SUCCEEDED(hr) && sink->audio_type
+            && FAILED(IMFMediaSink_GetStreamSinkById(media_sink, audio_stream_id(&sink->container), &stream_sink)))
+        hr = IMFMediaSink_AddStreamSink(media_sink, audio_stream_id(&sink->container), sink->audio_type, &stream_sink);
+    if (SUCCEEDED(hr) && sink->audio_type)
+        IMFStreamSink_Release(stream_sink);
+    if (FAILED(hr))
+    {
+        IMFMediaSink_Shutdown(media_sink);
+        IMFMediaSink_Release(media_sink);
+        return hr;
+    }
+    *out = media_sink;
+    return S_OK;
+}
+
+static HRESULT WINAPI transcode_sink_ActivateObject(IMFActivate *iface, REFIID riid, void **out)
+{
+    struct transcode_sink *sink = impl_from_IMFActivate(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    EnterCriticalSection(&sink->cs);
+    if (!sink->sink)
+        hr = transcode_sink_create(sink, &sink->sink);
+    if (SUCCEEDED(hr))
+        hr = IMFMediaSink_QueryInterface(sink->sink, riid, out);
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transcode_sink_ShutdownObject(IMFActivate *iface)
+{
+    struct transcode_sink *sink = impl_from_IMFActivate(iface);
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->sink)
+    {
+        IMFMediaSink_Shutdown(sink->sink);
+        IMFMediaSink_Release(sink->sink);
+        sink->sink = NULL;
+    }
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI transcode_sink_DetachObject(IMFActivate *iface)
+{
+    struct transcode_sink *sink = impl_from_IMFActivate(iface);
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->sink)
+        IMFMediaSink_Release(sink->sink);
+    sink->sink = NULL;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static const IMFActivateVtbl transcode_sink_vtbl =
+{
+    transcode_sink_QueryInterface,
+    transcode_sink_AddRef,
+    transcode_sink_Release,
+    transcode_sink_GetItem,
+    transcode_sink_GetItemType,
+    transcode_sink_CompareItem,
+    transcode_sink_Compare,
+    transcode_sink_GetUINT32,
+    transcode_sink_GetUINT64,
+    transcode_sink_GetDouble,
+    transcode_sink_GetGUID,
+    transcode_sink_GetStringLength,
+    transcode_sink_GetString,
+    transcode_sink_GetAllocatedString,
+    transcode_sink_GetBlobSize,
+    transcode_sink_GetBlob,
+    transcode_sink_GetAllocatedBlob,
+    transcode_sink_GetUnknown,
+    transcode_sink_SetItem,
+    transcode_sink_DeleteItem,
+    transcode_sink_DeleteAllItems,
+    transcode_sink_SetUINT32,
+    transcode_sink_SetUINT64,
+    transcode_sink_SetDouble,
+    transcode_sink_SetGUID,
+    transcode_sink_SetString,
+    transcode_sink_SetBlob,
+    transcode_sink_SetUnknown,
+    transcode_sink_LockStore,
+    transcode_sink_UnlockStore,
+    transcode_sink_GetCount,
+    transcode_sink_GetItemByIndex,
+    transcode_sink_CopyAllItems,
+    transcode_sink_ActivateObject,
+    transcode_sink_ShutdownObject,
+    transcode_sink_DetachObject,
+};
+
+static HRESULT WINAPI sink_info_QueryInterface(IMFTranscodeSinkInfoProvider *iface, REFIID riid, void **out)
+{
+    struct transcode_sink *sink = impl_from_IMFTranscodeSinkInfoProvider(iface);
+    return IMFActivate_QueryInterface(&sink->IMFActivate_iface, riid, out);
+}
+
+static ULONG WINAPI sink_info_AddRef(IMFTranscodeSinkInfoProvider *iface)
+{
+    struct transcode_sink *sink = impl_from_IMFTranscodeSinkInfoProvider(iface);
+    return IMFActivate_AddRef(&sink->IMFActivate_iface);
+}
+
+static ULONG WINAPI sink_info_Release(IMFTranscodeSinkInfoProvider *iface)
+{
+    struct transcode_sink *sink = impl_from_IMFTranscodeSinkInfoProvider(iface);
+    return IMFActivate_Release(&sink->IMFActivate_iface);
+}
+
+static HRESULT WINAPI sink_info_SetOutputFile(IMFTranscodeSinkInfoProvider *iface, const WCHAR *url)
+{
+    struct transcode_sink *sink = impl_from_IMFTranscodeSinkInfoProvider(iface);
+    HRESULT hr = S_OK;
+    WCHAR *copy;
+
+    TRACE("%p, %s.\n", iface, debugstr_w(url));
+
+    if (!url)
+        return E_INVALIDARG;
+    if (!(copy = wcsdup(url)))
+        return E_OUTOFMEMORY;
+    EnterCriticalSection(&sink->cs);
+    /* documented: the output file and the output byte stream exclude each other */
+    if (sink->bytestream_activate)
+    {
+        free(copy);
+        hr = MF_E_INVALIDREQUEST;
+    }
+    else
+    {
+        free(sink->url);
+        sink->url = copy;
+    }
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_info_SetOutputByteStream(IMFTranscodeSinkInfoProvider *iface, IMFActivate *activate)
+{
+    struct transcode_sink *sink = impl_from_IMFTranscodeSinkInfoProvider(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p.\n", iface, activate);
+
+    if (!activate)
+        return E_INVALIDARG;
+    EnterCriticalSection(&sink->cs);
+    if (sink->url)
+        hr = MF_E_INVALIDREQUEST;
+    else
+    {
+        if (sink->bytestream_activate)
+            IMFActivate_Release(sink->bytestream_activate);
+        IMFActivate_AddRef((sink->bytestream_activate = activate));
+    }
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_info_SetProfile(IMFTranscodeSinkInfoProvider *iface, IMFTranscodeProfile *profile)
+{
+    struct transcode_sink *sink = impl_from_IMFTranscodeSinkInfoProvider(iface);
+    IMFMediaType *audio = NULL, *video = NULL;
+    IMFAttributes *attributes;
+    GUID container;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, profile);
+
+    if (!profile)
+        return E_INVALIDARG;
+    if (FAILED(hr = IMFTranscodeProfile_GetContainerAttributes(profile, &attributes)) || !attributes)
+        return MF_E_TRANSCODE_NO_CONTAINERTYPE;
+    hr = IMFAttributes_GetGUID(attributes, &MF_TRANSCODE_CONTAINERTYPE, &container);
+    IMFAttributes_Release(attributes);
+    if (FAILED(hr))
+        return MF_E_TRANSCODE_NO_CONTAINERTYPE;
+
+    if (SUCCEEDED(IMFTranscodeProfile_GetAudioAttributes(profile, &attributes)) && attributes)
+    {
+        hr = media_type_from_attributes(attributes, &MFMediaType_Audio, &audio);
+        IMFAttributes_Release(attributes);
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(IMFTranscodeProfile_GetVideoAttributes(profile, &attributes)) && attributes)
+    {
+        hr = media_type_from_attributes(attributes, &MFMediaType_Video, &video);
+        IMFAttributes_Release(attributes);
+    }
+    if (FAILED(hr))
+    {
+        if (audio) IMFMediaType_Release(audio);
+        if (video) IMFMediaType_Release(video);
+        return hr;
+    }
+
+    EnterCriticalSection(&sink->cs);
+    sink->container = container;
+    if (sink->audio_type)
+        IMFMediaType_Release(sink->audio_type);
+    if (sink->video_type)
+        IMFMediaType_Release(sink->video_type);
+    sink->audio_type = audio;
+    sink->video_type = video;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_info_GetSinkInfo(IMFTranscodeSinkInfoProvider *iface, MF_TRANSCODE_SINK_INFO *info)
+{
+    struct transcode_sink *sink = impl_from_IMFTranscodeSinkInfoProvider(iface);
+
+    TRACE("%p, %p.\n", iface, info);
+
+    if (!info)
+        return E_INVALIDARG;
+    EnterCriticalSection(&sink->cs);
+    memset(info, 0, sizeof(*info));
+    if ((info->pVideoMediaType = sink->video_type))
+    {
+        IMFMediaType_AddRef(info->pVideoMediaType);
+        info->dwVideoStreamID = TRANSCODE_VIDEO_ID;
+    }
+    if ((info->pAudioMediaType = sink->audio_type))
+    {
+        IMFMediaType_AddRef(info->pAudioMediaType);
+        info->dwAudioStreamID = audio_stream_id(&sink->container);
+    }
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static const IMFTranscodeSinkInfoProviderVtbl sink_info_vtbl =
+{
+    sink_info_QueryInterface,
+    sink_info_AddRef,
+    sink_info_Release,
+    sink_info_SetOutputFile,
+    sink_info_SetOutputByteStream,
+    sink_info_SetProfile,
+    sink_info_GetSinkInfo,
+};
