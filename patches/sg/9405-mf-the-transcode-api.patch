+/***********************************************************************
+ *      MFCreateTranscodeSinkActivate (mf.@)
+ */
+HRESULT WINAPI MFCreateTranscodeSinkActivate(IMFActivate **activate)
+{
+    struct transcode_sink *sink;
+    HRESULT hr;
+
+    TRACE("%p.\n", activate);
+
+    if (!activate)
+        return E_POINTER;
+    if (!(sink = calloc(1, sizeof(*sink))))
+        return E_OUTOFMEMORY;
+    sink->IMFActivate_iface.lpVtbl = &transcode_sink_vtbl;
+    sink->IMFTranscodeSinkInfoProvider_iface.lpVtbl = &sink_info_vtbl;
+    sink->refcount = 1;
+    if (FAILED(hr = MFCreateAttributes(&sink->attributes, 0)))
+    {
+        free(sink);
+        return hr;
+    }
+    InitializeCriticalSectionEx(&sink->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    sink->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": transcode_sink.cs");
+    *activate = &sink->IMFActivate_iface;
+    return S_OK;
+}
+
+/* the sink's stream types become the encoders' actual output types (with their codec data) */
+static void transcode_sink_set_type(IMFActivate *activate, const GUID *major, IMFMediaType *type)
+{
+    struct transcode_sink *sink = impl_from_IMFActivate(activate);
+    IMFMediaType **slot = IsEqualGUID(major, &MFMediaType_Audio) ? &sink->audio_type : &sink->video_type;
+
+    EnterCriticalSection(&sink->cs);
+    if (*slot)
+        IMFMediaType_Release(*slot);
+    IMFMediaType_AddRef((*slot = type));
+    LeaveCriticalSection(&sink->cs);
+}
+
+/* topology */
+
+/* the source's stream type the encoder's missing video attributes come from */
+static void complete_video_type(IMFMediaType *type, IMFMediaType *source_type)
+{
+    static const GUID *const keys[] =
+    {
+        &MF_MT_FRAME_SIZE, &MF_MT_FRAME_RATE, &MF_MT_PIXEL_ASPECT_RATIO, &MF_MT_INTERLACE_MODE,
+    };
+    PROPVARIANT value;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(keys); i++)
+    {
+        if (SUCCEEDED(IMFMediaType_GetItem(type, keys[i], NULL)))
+            continue;
+        PropVariantInit(&value);
+        if (SUCCEEDED(IMFMediaType_GetItem(source_type, keys[i], &value)))
+            IMFMediaType_SetItem(type, keys[i], &value);
+        PropVariantClear(&value);
+    }
+    if (FAILED(IMFMediaType_GetItem(type, &MF_MT_INTERLACE_MODE, NULL)))
+        IMFMediaType_SetUINT32(type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);
+}
+
+/* the uncompressed input an audio encoder is given for its output type */
+static HRESULT audio_encoder_input(IMFTransform *encoder, IMFMediaType *output)
+{
+    UINT32 rate = 0, channels = 0;
+    IMFMediaType *input;
+    HRESULT hr;
+    DWORD i;
+
+    IMFMediaType_GetUINT32(output, &MF_MT_AUDIO_SAMPLES_PER_SECOND, &rate);
+    IMFMediaType_GetUINT32(output, &MF_MT_AUDIO_NUM_CHANNELS, &channels);
+    /* the encoder's own input type for the rate and channels, 16-bit PCM first */
+    for (i = 0; SUCCEEDED(hr = IMFTransform_GetInputAvailableType(encoder, 0, i, &input)); i++)
+    {
+        UINT32 r = 0, c = 0, bits = 0;
+
+        IMFMediaType_GetUINT32(input, &MF_MT_AUDIO_SAMPLES_PER_SECOND, &r);
+        IMFMediaType_GetUINT32(input, &MF_MT_AUDIO_NUM_CHANNELS, &c);
+        IMFMediaType_GetUINT32(input, &MF_MT_AUDIO_BITS_PER_SAMPLE, &bits);
+        if ((!rate || r == rate) && (!channels || c == channels) && bits == 16
+                && SUCCEEDED(IMFTransform_SetInputType(encoder, 0, input, 0)))
+        {
+            IMFMediaType_Release(input);
+            return S_OK;
+        }
+        IMFMediaType_Release(input);
+    }
+    if (hr != MF_E_NO_MORE_TYPES && hr != MF_E_TRANSFORM_TYPE_NOT_SET)
+        return hr;
+
+    /* else a PCM type of its own */
+    if (FAILED(hr = MFCreateMediaType(&input)))
+        return hr;
+    IMFMediaType_SetGUID(input, &MF_MT_MAJOR_TYPE, &MFMediaType_Audio);
+    IMFMediaType_SetGUID(input, &MF_MT_SUBTYPE, &MFAudioFormat_PCM);
+    IMFMediaType_SetUINT32(input, &MF_MT_AUDIO_BITS_PER_SAMPLE, 16);
+    IMFMediaType_SetUINT32(input, &MF_MT_AUDIO_SAMPLES_PER_SECOND, rate);
+    IMFMediaType_SetUINT32(input, &MF_MT_AUDIO_NUM_CHANNELS, channels);
+    IMFMediaType_SetUINT32(input, &MF_MT_AUDIO_BLOCK_ALIGNMENT, channels * 2);
+    IMFMediaType_SetUINT32(input, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, rate * channels * 2);
+    IMFMediaType_SetUINT32(input, &MF_MT_ALL_SAMPLES_INDEPENDENT, 1);
+    hr = IMFTransform_SetInputType(encoder, 0, input, 0);
+    IMFMediaType_Release(input);
+    return hr;
+}
+
+/* an encoder for the profile's type of a stream, its types set */
+static HRESULT create_encoder(const GUID *major, IMFMediaType *output, IMFMediaType *source_type,
+        IMFTransform **out, IMFMediaType **actual)
+{
+    BOOL audio = IsEqualGUID(major, &MFMediaType_Audio);
+    MFT_REGISTER_TYPE_INFO info = {*major};
+    IMFActivate **activates = NULL;
+    IMFTransform *encoder;
+    UINT32 count = 0, i;
+    HRESULT hr;
+
+    *out = NULL;
+#ifdef SG_MUTANT_TRANSCODE_NO_ENCODER
+    return MF_E_TRANSCODE_NO_MATCHING_ENCODER;
+#endif
+    if (FAILED(IMFMediaType_GetGUID(output, &MF_MT_SUBTYPE, &info.guidSubtype)))
+        return MF_E_TRANSCODE_INVALID_PROFILE;
+    if (!audio)
+        complete_video_type(output, source_type);
+    if (FAILED(hr = MFTEnumEx(audio ? MFT_CATEGORY_AUDIO_ENCODER : MFT_CATEGORY_VIDEO_ENCODER,
+            MFT_ENUM_FLAG_SYNCMFT | MFT_ENUM_FLAG_LOCALMFT | MFT_ENUM_FLAG_SORTANDFILTER, NULL, &info,
+            &activates, &count)))
+        return hr;
+
+    for (i = 0, hr = MF_E_TRANSCODE_NO_MATCHING_ENCODER; i < count && !*out; i++)
+    {
+        if (FAILED(IMFActivate_ActivateObject(activates[i], &IID_IMFTransform, (void **)&encoder)))
+            continue;
+        /* encoders take their output type first; those that need their input first (WMA) say so */
+        if (SUCCEEDED(IMFTransform_SetOutputType(encoder, 0, output, 0)))
+        {
+            if (!audio || SUCCEEDED(audio_encoder_input(encoder, output)))
+                *out = encoder;
+        }
+        else if (audio && SUCCEEDED(audio_encoder_input(encoder, output))
+                && SUCCEEDED(IMFTransform_SetOutputType(encoder, 0, output, 0)))
+            *out = encoder;
+        if (!*out)
+            IMFTransform_Release(encoder);
+    }
+    for (i = 0; i < count; i++)
+        IMFActivate_Release(activates[i]);
+    CoTaskMemFree(activates);
+    if (!*out)
+        return MF_E_TRANSCODE_NO_MATCHING_ENCODER;
+    if (FAILED(hr = IMFTransform_GetOutputCurrentType(*out, 0, actual)))
+    {
+        IMFTransform_Release(*out);
+        *out = NULL;
+    }
+    return hr;
+}
+
+static HRESULT add_branch(IMFTopology *topology, IMFMediaSource *source, IMFPresentationDescriptor *pd,
+        IMFStreamDescriptor *sd, IMFTransform *encoder, IMFActivate *sink, DWORD stream_id)
+{
+    IMFTopologyNode *source_node = NULL, *encoder_node = NULL, *output_node = NULL;
+    HRESULT hr;
+
+    if (SUCCEEDED(hr = MFCreateTopologyNode(MF_TOPOLOGY_SOURCESTREAM_NODE, &source_node)))
+    {
+        IMFTopologyNode_SetUnknown(source_node, &MF_TOPONODE_SOURCE, (IUnknown *)source);
+        IMFTopologyNode_SetUnknown(source_node, &MF_TOPONODE_PRESENTATION_DESCRIPTOR, (IUnknown *)pd);
+        hr = IMFTopologyNode_SetUnknown(source_node, &MF_TOPONODE_STREAM_DESCRIPTOR, (IUnknown *)sd);
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = MFCreateTopologyNode(MF_TOPOLOGY_TRANSFORM_NODE, &encoder_node)))
+        hr = IMFTopologyNode_SetObject(encoder_node, (IUnknown *)encoder);
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = MFCreateTopologyNode(MF_TOPOLOGY_OUTPUT_NODE, &output_node)))
+    {
+        IMFTopologyNode_SetObject(output_node, (IUnknown *)sink);
+        IMFTopologyNode_SetUINT32(output_node, &MF_TOPONODE_STREAMID, stream_id);
+        hr = IMFTopologyNode_SetUINT32(output_node, &MF_TOPONODE_NOSHUTDOWN_ON_REMOVE, FALSE);
+    }
+    if (SUCCEEDED(hr))
+        hr = IMFTopology_AddNode(topology, source_node);
+    if (SUCCEEDED(hr))
+        hr = IMFTopology_AddNode(topology, encoder_node);
+    if (SUCCEEDED(hr))
+        hr = IMFTopology_AddNode(topology, output_node);
+    if (SUCCEEDED(hr))
+        hr = IMFTopologyNode_ConnectOutput(source_node, 0, encoder_node, 0);
+    if (SUCCEEDED(hr))
+        hr = IMFTopologyNode_ConnectOutput(encoder_node, 0, output_node, 0);
+    if (source_node) IMFTopologyNode_Release(source_node);
+    if (encoder_node) IMFTopologyNode_Release(encoder_node);
+    if (output_node) IMFTopologyNode_Release(output_node);
+    return hr;
+}
+
+static HRESULT stream_current_type(IMFStreamDescriptor *sd, IMFMediaType **type, GUID *major)
+{
+    IMFMediaTypeHandler *handler;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFStreamDescriptor_GetMediaTypeHandler(sd, &handler)))
+        return hr;
+    if (FAILED(hr = IMFMediaTypeHandler_GetCurrentMediaType(handler, type)))
+        hr = IMFMediaTypeHandler_GetMediaTypeByIndex(handler, 0, type);
+    if (SUCCEEDED(hr))
+        hr = IMFMediaTypeHandler_GetMajorType(handler, major);
+    IMFMediaTypeHandler_Release(handler);
+    return hr;
+}
