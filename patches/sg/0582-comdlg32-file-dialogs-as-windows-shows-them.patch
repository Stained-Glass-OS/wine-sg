+static void nav_update_address(FileDialogImpl *This, PCIDLIST_ABSOLUTE pidl)
+{
+    HWND edit = GetDlgItem(This->dlg_hwnd, IDC_NAVADDRESS);
+    WCHAR *name = NULL;
+
+    if (!edit || !pidl) return;
+    if (FAILED(SHGetNameFromIDList(pidl, SIGDN_DESKTOPABSOLUTEEDITING, &name)) &&
+        FAILED(SHGetNameFromIDList(pidl, SIGDN_NORMALDISPLAY, &name)))
+        return;
+    SetWindowTextW(edit, name);
+    CoTaskMemFree(name);
+}
+
+static LRESULT CALLBACK nav_address_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, UINT_PTR id, DWORD_PTR data)
+{
+    FileDialogImpl *This = (FileDialogImpl *)data;
+
+    if (msg == WM_GETDLGCODE && wp == VK_RETURN)
+        return DLGC_WANTALLKEYS;
+    if (msg == WM_KEYDOWN && wp == VK_RETURN)
+    {
+        WCHAR text[MAX_PATH * 2];
+        PIDLIST_ABSOLUTE pidl;
+
+        GetWindowTextW(hwnd, text, ARRAY_SIZE(text));
+        if (text[0] && SUCCEEDED(SHParseDisplayName(text, NULL, &pidl, 0, NULL)))
+        {
+            IExplorerBrowser_BrowseToIDList(This->peb, pidl, SBSP_ABSOLUTE);
+            ILFree(pidl);
+        }
+        else MessageBeep(MB_ICONEXCLAMATION);
+        return 0;
+    }
+    if (msg == WM_CHAR && wp == '\r') return 0;
+    if (msg == WM_NCDESTROY) RemoveWindowSubclass(hwnd, nav_address_proc, id);
+    return DefSubclassProc(hwnd, msg, wp, lp);
+}
