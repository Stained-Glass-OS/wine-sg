+/* Stained Glass OS: as Windows since Vista, a GetOpenFileName or
+ * GetSaveFileName with no hook and no template shows the item dialog (the one
+ * with an address box and the folder tree), not the older "Look in" one -- the
+ * common dialogs looked years older than the rest of the system (David).
+ * Returns -1 when the older dialog is needed. */
+static void ofn_put_string(FileOpenDlgInfos *info, void *dst, DWORD size, const WCHAR *src, DWORD len)
+{
+    if (info->unicode)
+    {
+        memcpy(dst, src, min(len, size) * sizeof(WCHAR));
+    }
+    else
+        WideCharToMultiByte(CP_ACP, 0, src, len, dst, size, NULL, NULL);
+}
+
+static DWORD ofn_string_len(FileOpenDlgInfos *info, const WCHAR *src, DWORD len)
+{
+    return info->unicode ? len : WideCharToMultiByte(CP_ACP, 0, src, len, NULL, 0, NULL, NULL);
+}
