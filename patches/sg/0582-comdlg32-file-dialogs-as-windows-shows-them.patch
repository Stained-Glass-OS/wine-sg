+        const WCHAR *ext = PathFindExtensionW(name);
+        ofn->nFileOffset = ofn_string_len(info, result, name - result);
+        ofn->nFileExtension = (!several && *ext) ? ofn_string_len(info, result, ext + 1 - result) : 0;
+        if (ofn->lpstrFileTitle && ofn->nMaxFileTitle)
+        {
+            DWORD tlen = lstrlenW(name) + 1;
