+/* Stained Glass OS: the navigation bar as File Explorer's -- its back, forward
+ * and up arrows (drawn on whole pixels of a 16-unit grid, so both sides of a
+ * head match) instead of comctl32's old bitmaps, and an address box that shows
+ * the folder and goes where it is told on Enter. */
+static void nav_arrow(DWORD *bits, int size, int dir, DWORD argb)
+{
+    /* dir: 0 up, 2 left (back), 3 right (forward); as explorer's arrow_px */
+    static const int spec[4][3] = { { 3, 13, 4 }, { 0, 0, 0 }, { 3, 13, 4 }, { 12, 2, 4 } };
+    int tip = spec[dir][0], tail = spec[dir][1], arm = spec[dir][2], c = 8, s = max(1, size / 16);
+    int off = (size - 16 * s) / 2, lo = min(tip, tail), hi = max(tip, tail), k, i, j, sign = (dir == 0 || dir == 2) ? 1 : -1;
+#define PIX(u, v) do { for (i = 0; i < s; i++) for (j = 0; j < s; j++) { \
+        int px_ = off + (u) * s + i, py_ = off + (v) * s + j; \
+        if (px_ >= 0 && px_ < size && py_ >= 0 && py_ < size) bits[py_ * size + px_] = argb; } } while (0)
+    for (k = lo; k <= hi; k++)
+    {
+        if (dir == 0) PIX(c, k); else PIX(k, c);
+    }
+    for (k = 1; k <= arm; k++)
+    {
+        int along = tip + sign * k;
+        if (dir == 0) { PIX(c - k, along); PIX(c + k, along); }
+        else { PIX(along, c - k); PIX(along, c + k); }
+    }
+#undef PIX
+}
+
+static HIMAGELIST nav_imagelist(int size, COLORREF color)
+{
+    static const int dirs[3] = { 2, 3, 0 };   /* back, forward, up */
+    HIMAGELIST il = ImageList_Create(size, size, ILC_COLOR32, 3, 0);
+    BITMAPINFO bmi = { { sizeof(BITMAPINFOHEADER), 0, 0, 1, 32, BI_RGB } };
+    DWORD argb = 0xff000000 | (GetRValue(color) << 16) | (GetGValue(color) << 8) | GetBValue(color);
+    int i;
+
+    bmi.bmiHeader.biWidth = size;
+    bmi.bmiHeader.biHeight = -size;
+    for (i = 0; i < 3 && il; i++)
+    {
+        void *bits;
+        HBITMAP bmp = CreateDIBSection(NULL, &bmi, DIB_RGB_COLORS, &bits, NULL, 0);
+        if (!bmp) continue;
+        memset(bits, 0, size * size * 4);
+        nav_arrow(bits, size, dirs[i], argb);
+        ImageList_Add(il, bmp, NULL);
+        DeleteObject(bmp);
+    }
+    return il;
+}
