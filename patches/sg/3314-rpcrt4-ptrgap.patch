From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] rpcrt4: pointers: [allocate(all_nodes)] and freeing the data of an object pointer (3314)

CORE review: RPC (DECISIONS-2 RPC-NDR).

PointerUnmarshall logged FIXMEs for two cases:

FC_ALLOCATE_ALL_NODES: everything a pointer with [allocate(all_nodes)] points to
now comes from one block, sized from the data in the buffer (the memory-size
pass of the type), which one free releases (NdrPointerFree frees the block only).
A node which does not fit is allocated on its own.

FC_OP: an object pointer which is unmarshalled over a pointer that has data in a
client ([in, out]) frees that data first, with what it points to (interface
pointers are released by their own unmarshaller and are left alone).
---

diff --git a/dlls/rpcrt4/ndr_marshall.c b/dlls/rpcrt4/ndr_marshall.c
--- a/dlls/rpcrt4/ndr_marshall.c
+++ b/dlls/rpcrt4/ndr_marshall.c
@@ -435,6 +435,12 @@
  *  If the function is unable to allocate memory an RPC_X_NO_MEMORY
  *  exception is raised.
  */
+/* the block a pointer with [allocate(all_nodes)] gets for everything it points to */
+struct NDR_ALLOC_ALL_NODES_CONTEXT
+{
+    unsigned char *cur, *end;
+};
+
 void * WINAPI NdrAllocate(MIDL_STUB_MESSAGE *pStubMsg, SIZE_T len)
 {
     SIZE_T aligned_len;
@@ -442,6 +448,20 @@
     void *p;
     NDR_MEMORY_LIST *mem_list;
 
+    if (pStubMsg->pAllocAllNodesContext)
+    {
+        struct NDR_ALLOC_ALL_NODES_CONTEXT *ctx = pStubMsg->pAllocAllNodesContext;
+        SIZE_T size = (len + 7) & ~(SIZE_T)7;
+
+        if (size >= len && size <= (SIZE_T)(ctx->end - ctx->cur))
+        {
+            p = ctx->cur;
+            ctx->cur += size;
+            return p;
+        }
+        /* the block is used up (the sizing is an estimate): the node is allocated on its own */
+    }
+
     aligned_len = (len + 7) & ~7;
     adjusted_len = aligned_len + sizeof(NDR_MEMORY_LIST);
     /* check for overflow */
@@ -899,6 +919,20 @@
  * fMustAlloc seems to determine whether we can allocate from the buffer (if we
  * are on the server side). It's ignored here, since we can't allocate a pointer
  * from the buffer. */
+/* The data an object pointer pointed to before it gets new data (the [in, out] pointer of a
+ * client): freed, with what it points to.  An interface pointer is released by its own
+ * unmarshaller. */
+static void free_object_referent(PMIDL_STUB_MESSAGE pStubMsg, unsigned char *referent, PFORMAT_STRING desc)
+{
+  NDR_FREE m;
+
+  if (*desc == FC_IP) return;
+  m = NdrFreer[*desc & NDR_TABLE_MASK];
+  if (m) m(pStubMsg, referent, desc);
+  if (referent >= pStubMsg->BufferStart && referent <= pStubMsg->BufferEnd) return;
+  NdrFree(pStubMsg, referent);
+}
+
 static void PointerUnmarshall(PMIDL_STUB_MESSAGE pStubMsg,
                               unsigned char *Buffer,
                               unsigned char **pPointer,
@@ -910,7 +944,8 @@
   PFORMAT_STRING desc;
   NDR_UNMARSHALL m;
   DWORD pointer_id = 0;
-  BOOL pointer_needs_unmarshaling, need_alloc = FALSE, inner_must_alloc = FALSE;
+  BOOL pointer_needs_unmarshaling, need_alloc = FALSE, inner_must_alloc = FALSE, arena_set = FALSE;
+  struct NDR_ALLOC_ALL_NODES_CONTEXT *all_nodes_ctx = NULL;
 
   TRACE("(%p,%p,%p,%p,%p,%d)\n", pStubMsg, Buffer, pPointer, pSrcPointer, pFormat, fMustAlloc);
   TRACE("type=0x%x, attr=", type); dump_pointer_attr(attr);
@@ -940,8 +975,10 @@
      * buffer). */
     inner_must_alloc = TRUE;
 
-    if (pSrcPointer)
-        FIXME("free object pointer %p\n", pSrcPointer);
+#ifndef SG_MUTANT_PTRGAP_NOOPFREE
+    if (pSrcPointer && pStubMsg->IsClient && !(attr & FC_POINTER_DEREF))
+      free_object_referent(pStubMsg, pSrcPointer, desc);
+#endif
     if (pointer_id)
       pointer_needs_unmarshaling = TRUE;
     else
@@ -996,8 +1033,42 @@
         *pPointer = NULL;
     }
 
-    if (attr & FC_ALLOCATE_ALL_NODES)
-        FIXME("FC_ALLOCATE_ALL_NODES not implemented\n");
+    /* [allocate(all_nodes)]: everything the pointer points to comes from one block, which the
+     * stub frees with one call.  The block is sized as the data is in the buffer; a node which
+     * does not fit is allocated on its own. */
+    if ((attr & FC_ALLOCATE_ALL_NODES) && !pStubMsg->pAllocAllNodesContext && !(attr & FC_POINTER_DEREF) &&
+        (!pStubMsg->IsClient || !pSrcPointer))
+    {
+      NDR_MEMORYSIZE sizer = NdrMemorySizer[*desc & NDR_TABLE_MASK];
+
+      if (sizer)
+      {
+        unsigned char *saved_buffer = pStubMsg->Buffer, *saved_mark = pStubMsg->BufferMark;
+        unsigned char *saved_pmark = pStubMsg->PointerBufferMark;
+        ULONG saved_size = pStubMsg->MemorySize, size;
+        ULONG_PTR saved_max = pStubMsg->MaxCount;
+        ULONG saved_offset = pStubMsg->Offset, saved_actual = pStubMsg->ActualCount;
+        unsigned char *block;
+
+        pStubMsg->MemorySize = 0;
+        size = sizer(pStubMsg, desc);
+        pStubMsg->Buffer = saved_buffer; pStubMsg->BufferMark = saved_mark;
+        pStubMsg->PointerBufferMark = saved_pmark; pStubMsg->MemorySize = saved_size;
+        pStubMsg->MaxCount = saved_max; pStubMsg->Offset = saved_offset; pStubMsg->ActualCount = saved_actual;
+
+        size = size * 2 + 128;
+        block = NdrAllocateZero(pStubMsg, size);
+        all_nodes_ctx = malloc(sizeof(*all_nodes_ctx));
+        if (!all_nodes_ctx) RpcRaiseException(RPC_X_NO_MEMORY);
+        all_nodes_ctx->cur = block;
+        all_nodes_ctx->end = block + size;
+#ifndef SG_MUTANT_PTRGAP_NOALLNODES
+        pStubMsg->pAllocAllNodesContext = all_nodes_ctx;
+        arena_set = TRUE;
+#endif
+        inner_must_alloc = TRUE;
+      }
+    }
 
     if (attr & FC_POINTER_DEREF) {
       if (need_alloc)
@@ -1009,6 +1080,8 @@
     m = NdrUnmarshaller[*desc & NDR_TABLE_MASK];
     if (m) m(pStubMsg, current_ptr, desc, inner_must_alloc);
     else FIXME("no unmarshaller for data type=%02x\n", *desc);
+    if (arena_set) pStubMsg->pAllocAllNodesContext = NULL;
+    free(all_nodes_ctx);
 
     if (type == FC_FP)
       NdrFullPointerInsertRefId(pStubMsg->FullPtrXlatTables, pointer_id,
@@ -1155,6 +1228,16 @@
 
   if (!Pointer) return;
 
+#ifndef SG_MUTANT_PTRGAP_FREENODES
+  /* [allocate(all_nodes)]: one block holds everything the pointer points to */
+  if ((attr & FC_ALLOCATE_ALL_NODES) && !(attr & FC_POINTER_DEREF) && type != FC_FP &&
+      !(Pointer >= pStubMsg->BufferStart && Pointer <= pStubMsg->BufferEnd) && !(attr & FC_ALLOCED_ON_STACK))
+  {
+    NdrFree(pStubMsg, Pointer);
+    return;
+  }
+#endif
+
   if (type == FC_FP) {
     int pointer_needs_freeing = NdrFullPointerFree(
       pStubMsg->FullPtrXlatTables, Pointer);
diff --git a/test/rpcrt4-ptrgap-gate.sh b/test/rpcrt4-ptrgap-gate.sh
new file mode 100644
--- /dev/null
+++ b/test/rpcrt4-ptrgap-gate.sh
@@ -0,0 +1,37 @@
+#!/bin/sh
+. "$(dirname "$0")/scratch-home.sh"
+# CORE rpcrt4: pointer unmarshalling gaps: [allocate(all_nodes)] (one allocation, one free for a whole list) and the freeing of the
+# data an object pointer had (direct calls of NdrPointerUnmarshall/NdrPointerFree with hand-made formats), 64+32 bit.
+#
+#   WINE=/path/to/build/wine test/rpcrt4-ptrgap-gate.sh   (WINESERVER=... when not beside $WINE)
+# Mutants: PTRGAP_* (see patches/notes/3314.txt).
+set -u
+HERE=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
+WINE="${WINE:-/opt/wine-sg/bin/wine}"
+WINESERVER="${WINESERVER:-$(dirname "$WINE")/wineserver}"
+[ -x "$WINESERVER" ] || WINESERVER="$(dirname "$WINE")/server/wineserver"
+[ -x "$WINE" ] || { echo "SKIP: no wine at $WINE"; exit 77; }
+for cc in x86_64-w64-mingw32-gcc i686-w64-mingw32-gcc; do
+    command -v $cc >/dev/null || { echo "SKIP: $cc not installed"; exit 77; }
+done
+RC=0
+T=$(mktemp -d /var/tmp/sg-rpcrt4-ptrgap.XXXXXX)
+export WINEPREFIX="$T/prefix" WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml=;winemenubuilder.exe=d" WINESERVER
+cleanup() { "$WINESERVER" -k 2>/dev/null; rm -rf "$T" "${SG_GATE_HOME:-$T}"; }
+trap cleanup EXIT INT TERM
+for a in x86_64 i686; do
+    TMPDIR=/var/tmp $a-w64-mingw32-gcc -O1 -o "$T/probe-$a.exe" "$HERE/rpcrt4-ptrgap-probe.c" -lrpcrt4 \
+        || { echo "FAIL  probe did not build ($a)"; exit 1; }
+done
+mkdir -p "$WINEPREFIX"
+timeout -s KILL 300 env DISPLAY= "$WINE" wineboot -i >/dev/null 2>&1
+"$WINESERVER" -w
+ARCHES="x86_64 i686"; [ "${SG_QUICK:-}" = 1 ] && ARCHES=x86_64
+for a in $ARCHES; do
+    echo "== $a"
+    out=$(cd "$T" && timeout -s KILL 100 env DISPLAY= "$WINE" "$T/probe-$a.exe" 2>/dev/null </dev/null | tr -d '\r')
+    printf '%s\n' "$out" | sed 's/^/      /'
+    printf '%s\n' "$out" | grep -qx 'RESULT: PASS' || RC=1
+done
+[ "$RC" = 0 ] && echo "RESULT: PASS" || echo "RESULT: FAIL"
+exit "$RC"
diff --git a/test/rpcrt4-ptrgap-probe.c b/test/rpcrt4-ptrgap-probe.c
new file mode 100644
--- /dev/null
+++ b/test/rpcrt4-ptrgap-probe.c
@@ -0,0 +1,160 @@
+/* Pointers in the NDR unmarshaller, called directly with hand-made format strings: [allocate(all_nodes)] gives everything
+ * a pointer points to one block (one allocation, one free), and an object pointer which is unmarshalled over a pointer which
+ * has data frees that data. */
+#include <windows.h>
+#include <rpc.h>
+#include <rpcndr.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int failures;
+static void check(int ok, const char *what)
+{
+    printf("%s  %s\n", ok ? "PASS" : "FAIL", what);
+    fflush(stdout);
+    if (!ok) failures++;
+}
+
+#define FC_END 0x5b
+#define FC_PAD 0x5c
+#define FC_LONG 8
+#define FC_UP 0x12
+#define FC_OP 0x13
+#define FC_BOGUS_STRUCT 0x1a
+#define FC_POINTER 0x36
+#define FC_STRUCTPAD4 0x40
+#define PTR_ALL_NODES 0x01
+#define PTR_SIMPLE 0x08
+
+static int allocs, frees;
+static void *last_freed;
+
+static void *__RPC_API my_alloc(size_t size) { allocs++; return calloc(1, size); }
+static void __RPC_API my_free(void *p) { frees++; last_freed = p; free(p); }
+
+struct node { LONG v; struct node *next; };
+
+/* a list of nodes: a unique pointer to a complex structure with a long and a unique pointer to the next node */
+static unsigned build_list_format(unsigned char *t, unsigned char attr)
+{
+    unsigned n = 0, members, table, size = sizeof(struct node);
+
+    t[0] = FC_UP; t[1] = attr; t[2] = 2; t[3] = 0;                  /* the structure is at 4 */
+    t[4] = FC_BOGUS_STRUCT; t[5] = 3; t[6] = size; t[7] = 0;
+    t[8] = 0; t[9] = 0;                                              /* no conformant array */
+    members = 12;
+    t[members + n++] = FC_LONG;
+    if (sizeof(void *) == 8) t[members + n++] = FC_STRUCTPAD4;
+    t[members + n++] = FC_POINTER;
+    t[members + n++] = FC_END;
+    table = members + n;
+    t[10] = (table - 10) & 0xff; t[11] = (table - 10) >> 8;         /* the pointer layout */
+    t[table] = FC_UP; t[table + 1] = attr;
+    t[table + 2] = (4 - (table + 2)) & 0xff; t[table + 3] = ((4 - (table + 2)) >> 8) & 0xff;
+    return table + 4;
+}
+
+static unsigned build_list_wire(unsigned char *w, int nodes)
+{
+    unsigned n = 0;
+    int i;
+    ULONG v;
+
+    v = 0x20000; memcpy(w + n, &v, 4); n += 4;                       /* the pointer to the first node */
+    for (i = 0; i < nodes; i++)
+    {
+        v = 100 + i; memcpy(w + n, &v, 4); n += 4;                   /* the node: the value, the id of the next */
+        v = i + 1 < nodes ? 0x20004 + 4 * i : 0; memcpy(w + n, &v, 4); n += 4;
+    }
+    return n;
+}
+
+static void init_server(MIDL_STUB_MESSAGE *msg, RPC_MESSAGE *rpc, MIDL_STUB_DESC *desc, unsigned char *types,
+                        unsigned char *wire, unsigned len, BOOL client)
+{
+    memset(desc, 0, sizeof(*desc));
+    memset(rpc, 0, sizeof(*rpc));
+    desc->pfnAllocate = my_alloc;
+    desc->pfnFree = my_free;
+    desc->pFormatTypes = types;
+    rpc->Buffer = wire; rpc->BufferLength = len;
+    if (client) NdrClientInitializeNew(rpc, msg, desc, 0);
+    else NdrServerInitializeNew(rpc, msg, desc);
+    rpc->Buffer = wire; rpc->BufferLength = len;
+    msg->Buffer = msg->BufferStart = wire;
+    msg->BufferEnd = wire + len;
+    msg->BufferLength = len;
+}
+
+static void test_list(BOOL all_nodes)
+{
+    MIDL_STUB_MESSAGE msg;
+    RPC_MESSAGE rpc;
+    MIDL_STUB_DESC desc;
+    unsigned char types[64], wire[256];
+    unsigned len;
+    struct node *list = NULL, *n;
+    char what[200];
+    int count;
+
+    build_list_format(types, all_nodes ? PTR_ALL_NODES : 0);
+    len = build_list_wire(wire, 3);
+    init_server(&msg, &rpc, &desc, types, wire, len, FALSE);
+    allocs = frees = 0;
+    NdrPointerUnmarshall(&msg, (unsigned char **)&list, types, 0);
+    for (n = list, count = 0; n && count < 10; n = n->next) count++;
+    sprintf(what, "%s: a list of three nodes is unmarshalled (%d nodes, values %ld %ld %ld)", all_nodes ? "all_nodes" : "plain pointers", count,
+            list ? list->v : -1, list && list->next ? list->next->v : -1,
+            list && list->next && list->next->next ? list->next->next->v : -1);
+    check(count == 3 && list->v == 100 && list->next->v == 101 && list->next->next->v == 102 && !list->next->next->next, what);
+    sprintf(what, "%s: %d allocations", all_nodes ? "all_nodes" : "plain pointers", allocs);
+    check(all_nodes ? allocs == 1 : allocs == 3, what);
+    frees = 0;
+    NdrPointerFree(&msg, (unsigned char *)list, types);
+    sprintf(what, "%s: freed with %d calls", all_nodes ? "all_nodes" : "plain pointers", frees);
+    check(all_nodes ? frees == 1 && last_freed == list : frees == 3, what);
+}
+
+static void test_object_pointer(BOOL client)
+{
+    MIDL_STUB_MESSAGE msg;
+    RPC_MESSAGE rpc;
+    MIDL_STUB_DESC desc;
+    unsigned char types[8], wire[16];
+    ULONG v;
+    LONG *old, *pointer;
+    char what[200];
+
+    /* an object pointer to a long, simple pointer */
+    types[0] = FC_OP; types[1] = PTR_SIMPLE; types[2] = FC_LONG; types[3] = FC_PAD;
+    v = 0x20000; memcpy(wire, &v, 4); v = 4242; memcpy(wire + 4, &v, 4);
+    init_server(&msg, &rpc, &desc, types, wire, 8, client);
+    old = my_alloc(sizeof(LONG));
+    *old = 7;
+    pointer = old;
+    allocs = frees = 0; last_freed = NULL;
+    NdrPointerUnmarshall(&msg, (unsigned char **)&pointer, types, 0);
+    sprintf(what, "object pointer in a %s: new data %ld, freed %d (old data %s)", client ? "client" : "server",
+            pointer ? *pointer : -1, frees, last_freed == old ? "freed" : "kept");
+    if (client) check(pointer && *pointer == 4242 && frees == 1 && last_freed == old, what);
+    else check(pointer && *pointer == 4242 && frees == 0, what);
+    if (!client) free(old);
+
+    /* nothing to free in a pointer with no data */
+    init_server(&msg, &rpc, &desc, types, wire, 8, TRUE);
+    pointer = NULL;
+    frees = 0;
+    NdrPointerUnmarshall(&msg, (unsigned char **)&pointer, types, 0);
+    check(pointer && *pointer == 4242 && frees == 0, "object pointer with no data before: nothing is freed");
+}
+
+int main(int argc, char **argv)
+{
+    test_list(FALSE);
+    test_list(TRUE);
+    test_object_pointer(TRUE);
+    test_object_pointer(FALSE);
+    printf("RESULT: %s\n", failures ? "FAIL" : "PASS");
+    return failures != 0;
+}
-- 
