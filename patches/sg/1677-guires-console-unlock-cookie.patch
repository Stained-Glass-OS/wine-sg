-/**********************************************************************
- *	GetGuiResources	(USER32.@)
+struct count_windows
+{
+    DWORD pid;
+    DWORD count;
+};
+
+static BOOL CALLBACK count_child_window( HWND hwnd, LPARAM lparam )
+{
+    struct count_windows *data = (struct count_windows *)lparam;
+    DWORD pid = 0;
+
+    GetWindowThreadProcessId( hwnd, &pid );
+    if (!data->pid || pid == data->pid) data->count++;
+    return TRUE;
+}
+
+static BOOL CALLBACK count_window( HWND hwnd, LPARAM lparam )
+{
+    count_child_window( hwnd, lparam );
+    EnumChildWindows( hwnd, count_child_window, lparam );
+    return TRUE;
+}
+
+/* the GDI objects in the process's handle table (its own: the table of
+ * another process is not reachable from here) */
+static DWORD count_gdi_objects(void)
+{
+    const GDI_SHARED_MEMORY *shared;
+    DWORD i, count = 0;
+
+#ifndef _WIN64
+    if (NtCurrentTeb()->GdiBatchCount)
+    {
+        TEB64 *teb64 = (TEB64 *)(UINT_PTR)NtCurrentTeb()->GdiBatchCount;
+        PEB64 *peb64 = (PEB64 *)(UINT_PTR)teb64->Peb;
+        shared = (const GDI_SHARED_MEMORY *)(UINT_PTR)peb64->GdiSharedHandleTable;
+    }
+    else
+#endif
+    shared = (const GDI_SHARED_MEMORY *)NtCurrentTeb()->Peb->GdiSharedHandleTable;
+    if (!shared) return 0;
+    for (i = 0; i < GDI_MAX_HANDLE_COUNT; i++)
+        if (shared->Handles[i].Type && !shared->Handles[i].StockFlag) count++;
+    return count;
+}
+
+/***********************************************************************
+ *		GetGuiResources (USER32.@)
  */
 DWORD WINAPI GetGuiResources( HANDLE hProcess, DWORD uiFlags )
 {
-    static BOOL warn = TRUE;
+    static DWORD gdi_peak, user_peak;
+    struct count_windows data = { 0, 0 };
+    BOOL self;
+    DWORD count;
 
-    if (warn) {
-        FIXME("(%p,%lx): stub\n",hProcess,uiFlags);
-       warn = FALSE;
-    }
+    TRACE( "(%p,%lx)\n", hProcess, uiFlags );
 
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    /* Stained Glass OS 1677: the process's GDI objects (its handle table)
+     * and USER objects (its windows), and the most of them seen; GR_GLOBAL
+     * counts the windows of the whole session */
+    if (uiFlags != GR_GDIOBJECTS && uiFlags != GR_USEROBJECTS && uiFlags != GR_GDIOBJECTS_PEAK &&
+        uiFlags != GR_USEROBJECTS_PEAK)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    if (hProcess != GR_GLOBAL)
+    {
+        if (!(data.pid = GetProcessId( hProcess )))
+        {
+            SetLastError( ERROR_INVALID_HANDLE );
+            return 0;
+        }
+    }
+    self = data.pid == GetCurrentProcessId();
+#ifdef SG_MUTANT_NO_GUI_RESOURCES
     return 0;
+#endif
+
+    if (uiFlags == GR_GDIOBJECTS || uiFlags == GR_GDIOBJECTS_PEAK)
+    {
+        if (!self) return 0;
+        count = count_gdi_objects();
+        if (count > gdi_peak) gdi_peak = count;
+        return uiFlags == GR_GDIOBJECTS_PEAK ? gdi_peak : count;
+    }
+
+    count_window( GetDesktopWindow(), (LPARAM)&data );
+    count = data.count;
+    if (!self) return count;
+    if (count > user_peak) user_peak = count;
+    return uiFlags == GR_USEROBJECTS_PEAK ? user_peak : count;
 }
