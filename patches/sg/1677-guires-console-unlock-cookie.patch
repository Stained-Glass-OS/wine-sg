+/* a random value for the process's life, never 0 */
+static ULONG get_process_cookie(void)
+{
+    static ULONG cookie;
+
+    if (!cookie)
+    {
+        ULONG value = 0;
+        int fd = open( "/dev/urandom", O_RDONLY );
+
+        if (fd != -1)
+        {
+            if (read( fd, &value, sizeof(value) ) != sizeof(value)) value = 0;
+            close( fd );
+        }
+        if (!value) value = (ULONG)time( NULL ) ^ ((ULONG)getpid() << 16) ^ (ULONG)(ULONG_PTR)&value;
+        if (!value) value = 1;
+        InterlockedCompareExchange( (LONG *)&cookie, value, 0 );
+    }
+    return cookie;
+}
