From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: a 32-bit thread's stack overflow is delivered to the program (6026)

A WoW64 thread's overflow exception is first a 64-bit exception frame
on its 32-bit stack, then the 32-bit frame and the program's handlers;
the one page left for them did not hold that, and the thread was aborted
("stack overflow N bytes"): the process exited 1, or a secondary thread
vanished and its process went on, often waiting for it forever (ImgBurn,
Delphi programs). A 32-bit stack now keeps three pages for the
exception, and an exception with no stack left to dispatch it on ends
the process with STATUS_STACK_OVERFLOW, as on Windows.
---
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 7550cbb..930eb04 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -4057,7 +4057,14 @@ static BOOL is_inside_thread_stack( void *ptr, struct thread_stack_info *stack )
     stack->start = ULongToPtr( wow_teb->DeallocationStack );
     stack->limit = ULongToPtr( wow_teb->Tib.StackLimit );
     stack->end   = ULongToPtr( wow_teb->Tib.StackBase );
+    /* Stained Glass OS: a 32-bit thread's overflow exception is first a 64-bit exception frame on its
+     * stack (KiUserExceptionDispatcher, before Wow64PrepareForException moves it), then the 32-bit frame
+     * and the program's handlers: one page did not hold them, and the thread was aborted. */
+#ifdef SG_MUTANT_WOWSTACK_ONE_PAGE
     stack->guaranteed = max( wow_teb->GuaranteedStackBytes, page_size * (is_win64 ? 1 : 2) );
+#else
+    stack->guaranteed = max( wow_teb->GuaranteedStackBytes, page_size * (is_win64 ? 3 : 2) );
+#endif
     stack->is_wow = TRUE;
     return ((char *)ptr > stack->start && (char *)ptr <= stack->end);
 }
@@ -4192,6 +4199,11 @@ void *virtual_setup_exception( void *stack_ptr, size_t size, EXCEPTION_RECORD *r
         UINT diff = stack_info.start + 4096 - stack;
         ERR( "stack overflow %u bytes addr %p stack %p (%p-%p-%p)\n",
              diff, rec->ExceptionAddress, stack, stack_info.start, stack_info.limit, stack_info.end );
+#ifndef SG_MUTANT_WOWSTACK_ABORT_THREAD
+        /* Stained Glass OS: an exception with no stack left to dispatch it on ends the process, as on
+         * Windows; ending only the thread left a process without it, often waiting for it forever */
+        NtTerminateProcess( NtCurrentProcess(), STATUS_STACK_OVERFLOW );
+#endif
         abort_thread(1);
     }
     else if (stack < stack_info.limit)
