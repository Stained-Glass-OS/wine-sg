diff --git a/dlls/iphlpapi/netwrite.c b/dlls/iphlpapi/netwrite.c
index a9cdb9f..0bf3fbe 100644
--- a/dlls/iphlpapi/netwrite.c
+++ b/dlls/iphlpapi/netwrite.c
@@ -526,3 +526,226 @@ DWORD net_delete_ip_address( ULONG context )
     LeaveCriticalSection( &nte_cs );
     return err;
 }
+
+/* ---- DHCP lease, interface state, IP statistics, forwarding, TCP, proxy ARP ----
+ *
+ *   release|renew DEVICE            the DHCP lease (IpReleaseAddress, IpRenewAddress)
+ *   enable|disable DEVICE           administrative state (SetIfEntry)
+ *   forwarding on|off               IPv4 forwarding (EnableRouter, SetIpStatistics)
+ *   ttl N                           default TTL (SetIpTTL, SetIpStatistics)
+ *   tcp delete LADDR LPORT RADDR RPORT   drop a connection (SetTcpEntry)
+ *   proxyarp add|del DEVICE ADDRESS MASK
+ */
+static DWORD index_name( DWORD index, WCHAR *name, DWORD len )
+{
+    NET_LUID none = {0};
+
+    return interface_name( &none, index, name, len );
+}
+
+static DWORD lease_request( const IP_ADAPTER_INDEX_MAP *map, const WCHAR *verb )
+{
+    WCHAR dev[256];
+    const WCHAR *args[2];
+    DWORD err;
+
+    if (!map) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    if ((err = index_name( map->Index, dev, ARRAY_SIZE(dev) ))) return err;
+    args[0] = verb; args[1] = dev;
+    return netctl( args, 2, FALSE );
+}
+
+DWORD net_release_address( const IP_ADAPTER_INDEX_MAP *map ) { return lease_request( map, L"release" ); }
+DWORD net_renew_address( const IP_ADAPTER_INDEX_MAP *map ) { return lease_request( map, L"renew" ); }
+
+DWORD net_set_if_entry( const MIB_IFROW *row )
+{
+    WCHAR dev[256];
+    const WCHAR *args[2];
+    DWORD err;
+
+    if (!row) return ERROR_INVALID_PARAMETER;
+    if (row->dwAdminStatus != MIB_IF_ADMIN_STATUS_UP && row->dwAdminStatus != MIB_IF_ADMIN_STATUS_DOWN)
+        return row->dwAdminStatus == MIB_IF_ADMIN_STATUS_TESTING ? ERROR_NOT_SUPPORTED : ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    if ((err = index_name( row->dwIndex, dev, ARRAY_SIZE(dev) ))) return err;
+    args[0] = row->dwAdminStatus == MIB_IF_ADMIN_STATUS_UP ? L"enable" : L"disable";
+    args[1] = dev;
+    return netctl( args, 2, FALSE );
+}
+
+static DWORD set_forwarding( BOOL on )
+{
+    const WCHAR *args[2] = { L"forwarding", on ? L"on" : L"off" };
+    return netctl( args, 2, FALSE );
+}
+
+static DWORD set_ttl( UINT ttl )
+{
+    WCHAR text[16];
+    const WCHAR *args[2];
+
+    swprintf( text, ARRAY_SIZE(text), L"%u", ttl );
+    args[0] = L"ttl"; args[1] = text;
+    return netctl( args, 2, FALSE );
+}
+
+DWORD net_set_ip_ttl( UINT ttl )
+{
+    if (ttl < 1 || ttl > 255) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    return set_ttl( ttl );
+}
+
+DWORD net_set_ip_statistics( const MIB_IPSTATS *stats )
+{
+    DWORD err;
+
+    if (!stats) return ERROR_INVALID_PARAMETER;
+    if (stats->dwForwarding != MIB_IP_FORWARDING && stats->dwForwarding != MIB_IP_NOT_FORWARDING)
+        return ERROR_INVALID_PARAMETER;
+    if (stats->dwDefaultTTL < 1 || stats->dwDefaultTTL > 255) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    if ((err = set_forwarding( stats->dwForwarding == MIB_IP_FORWARDING ))) return err;
+    return set_ttl( stats->dwDefaultTTL );
+}
+
+/* EnableRouter / UnenableRouter: a reference count of the callers that want forwarding, one per OVERLAPPED */
+static OVERLAPPED **routers;
+static unsigned int router_count;
+static CRITICAL_SECTION router_cs;
+static CRITICAL_SECTION_DEBUG router_cs_debug =
+{
+    0, 0, &router_cs, { &router_cs_debug.ProcessLocksList, &router_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": router_cs") }
+};
+static CRITICAL_SECTION router_cs = { &router_cs_debug, -1, 0, 0, 0, 0 };
+
+DWORD net_enable_router( HANDLE *handle, OVERLAPPED *overlapped )
+{
+    OVERLAPPED **n;
+    unsigned int i;
+    DWORD err = ERROR_IO_PENDING;
+
+    if (!handle || !overlapped || !overlapped->hEvent) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    EnterCriticalSection( &router_cs );
+    for (i = 0; i < router_count; i++) if (routers[i] == overlapped) break;
+    if (i < router_count) err = ERROR_INVALID_PARAMETER;  /* already enabled with this structure */
+    else
+    {
+        DWORD ret = router_count ? NO_ERROR : set_forwarding( TRUE );
+        if (ret) err = ret;
+        else if ((n = realloc( routers, (router_count + 1) * sizeof(*routers) )))
+        {
+            routers = n;
+            routers[router_count++] = overlapped;
+            *handle = overlapped->hEvent;
+        }
+        else err = ERROR_NOT_ENOUGH_MEMORY;
+    }
+    LeaveCriticalSection( &router_cs );
+    return err;
+}
+
+DWORD net_unenable_router( OVERLAPPED *overlapped, DWORD *count )
+{
+    unsigned int i;
+    DWORD err = NO_ERROR;
+
+    if (!overlapped) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    EnterCriticalSection( &router_cs );
+    for (i = 0; i < router_count; i++) if (routers[i] == overlapped) break;
+    if (i == router_count) err = ERROR_INVALID_PARAMETER;
+    else
+    {
+#ifdef SG_MUTANT_IPH_NOCOUNT
+        if ((err = set_forwarding( FALSE ))) goto done;
+#else
+        if (router_count == 1 && (err = set_forwarding( FALSE ))) goto done;
+#endif
+        memmove( routers + i, routers + i + 1, (--router_count - i) * sizeof(*routers) );
+        if (overlapped->hEvent) SetEvent( overlapped->hEvent );  /* the pending request completes */
+    }
+    if (count) *count = router_count;
+done:
+    LeaveCriticalSection( &router_cs );
+    return err;
+}
+
+DWORD net_set_tcp_entry( const MIB_TCPROW *row )
+{
+    WCHAR laddr[32], lport[8], raddr[32], rport[8];
+    const WCHAR *args[6];
+    MIB_TCPTABLE *table;
+    DWORD i, size = 0, err;
+    BOOL found = FALSE;
+
+    if (!row) return ERROR_INVALID_PARAMETER;
+    /* Windows checks the caller first (the conformance test treats this error as "not allowed") */
+    if (!caller_is_admin()) return ERROR_NETWORK_ACCESS_DENIED;
+    if (row->dwState != MIB_TCP_STATE_DELETE_TCB) return ERROR_INVALID_PARAMETER;
+
+    /* only a connection that exists can be dropped */
+    err = GetTcpTable( NULL, &size, FALSE );
+    if (err == ERROR_INSUFFICIENT_BUFFER)
+    {
+        size += 16 * sizeof(MIB_TCPROW);
+        if (!(table = malloc( size ))) return ERROR_NOT_ENOUGH_MEMORY;
+        if (!GetTcpTable( table, &size, FALSE ))
+        {
+            for (i = 0; i < table->dwNumEntries; i++)
+            {
+                const MIB_TCPROW *r = &table->table[i];
+                if (r->dwLocalAddr == row->dwLocalAddr && r->dwRemoteAddr == row->dwRemoteAddr &&
+                    (WORD)r->dwLocalPort == (WORD)row->dwLocalPort && (WORD)r->dwRemotePort == (WORD)row->dwRemotePort)
+                {
+                    found = TRUE;
+                    break;
+                }
+            }
+        }
+        free( table );
+    }
+#ifdef SG_MUTANT_IPH_TCPEXISTS
+    found = TRUE;
+#endif
+    if (!found) return ERROR_MR_MID_NOT_FOUND;
+
+    InetNtopW( AF_INET, (void *)&row->dwLocalAddr, laddr, ARRAY_SIZE(laddr) );
+    InetNtopW( AF_INET, (void *)&row->dwRemoteAddr, raddr, ARRAY_SIZE(raddr) );
+    swprintf( lport, ARRAY_SIZE(lport), L"%u", ntohs( (USHORT)row->dwLocalPort ) );
+    swprintf( rport, ARRAY_SIZE(rport), L"%u", ntohs( (USHORT)row->dwRemotePort ) );
+    args[0] = L"tcp"; args[1] = L"delete"; args[2] = laddr; args[3] = lport; args[4] = raddr; args[5] = rport;
+    return netctl( args, 6, FALSE );
+}
+
+/* the TCP extended statistics of a connection: this stack keeps none (GetPerTcpConnectionEStats
+ * cannot read them), so enabling their collection is refused after the checks Windows makes */
+DWORD net_set_per_tcp_estats( const MIB_TCPROW *row, TCP_ESTATS_TYPE type, BYTE *rw, ULONG version, ULONG size, ULONG offset )
+{
+    if (!row || !rw || version || type < TcpConnectionEstatsSynOpts || type >= TcpConnectionEstatsMaximum)
+        return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    return ERROR_NOT_SUPPORTED;
+}
+
+static DWORD proxy_arp( DWORD address, DWORD mask, DWORD index, const WCHAR *verb )
+{
+    WCHAR dev[256], a[32], m[32];
+    const WCHAR *args[5];
+    DWORD err;
+
+    if (!address || !index) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    if ((err = index_name( index, dev, ARRAY_SIZE(dev) ))) return err;
+    InetNtopW( AF_INET, (void *)&address, a, ARRAY_SIZE(a) );
+    InetNtopW( AF_INET, (void *)&mask, m, ARRAY_SIZE(m) );
+    args[0] = L"proxyarp"; args[1] = verb; args[2] = dev; args[3] = a; args[4] = m;
+    return netctl( args, 5, FALSE );
+}
+
+DWORD net_create_proxy_arp( DWORD address, DWORD mask, DWORD index ) { return proxy_arp( address, mask, index, L"add" ); }
+DWORD net_delete_proxy_arp( DWORD address, DWORD mask, DWORD index ) { return proxy_arp( address, mask, index, L"del" ); }
