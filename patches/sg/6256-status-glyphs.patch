+static const GUID FMTID_StorageProviderView = { 0xe77e90df, 0x6271, 0x4f5b, { 0x83, 0x4f, 0x2d, 0xd1, 0xf2, 0x45, 0xdd, 0xa4 } };
+
+/* Stained Glass OS 6256: an item's Status glyph (System.StorageProviderState 1..4), -1 none */
+static int ShellView_StatusGlyph(IShellViewImpl *This, LPCITEMIDLIST pidl)
+{
+    SHCOLUMNID scid = { FMTID_StorageProviderView, 3 };
+    VARIANT v;
+    int ret = -1;
+
+    if (!This->pSF2Parent) return -1;
+    VariantInit(&v);
+    if (SUCCEEDED(IShellFolder2_GetDetailsEx(This->pSF2Parent, pidl, &scid, &v)) && V_VT(&v) == VT_UI4)
+        ret = SHELL32_StatusGlyph(V_UI4(&v));
+    VariantClear(&v);
+    return ret;
+}
+
 /* the column that holds an FMTID_Storage property, -1 if none */
 static int ShellView_ColumnOf(IShellViewImpl *This, DWORD pid)
 {
@@ -1690,6 +1708,21 @@ static void ShellView_InitList(IShellViewImpl *This)
     This->col_date = ShellView_ColumnOf(This, PID_STG_WRITETIME);
     This->col_type = ShellView_ColumnOf(This, PID_STG_STORAGETYPE);
     This->col_size = ShellView_ColumnOf(This, PID_STG_SIZE);
+    /* the Status column of a sync root shows a glyph by its text (the list's subitem images) */
+    This->col_status = -1;
+    if (This->pSF2Parent)
+    {
+        SHCOLUMNID scid;
+        UINT i;
+        for (i = 0; i < This->columns; i++)
+            if (SUCCEEDED(IShellFolder2_MapColumnToSCID(This->pSF2Parent, folder_column(This, i), &scid)) &&
+                IsEqualGUID(&scid.fmtid, &FMTID_StorageProviderView) && scid.pid == 2)
+                This->col_status = i;
+    }
+#ifndef SG_MUTANT_NO_STATUS_IMAGES
+    SendMessageW(This->hWndList, LVM_SETEXTENDEDLISTVIEWSTYLE, LVS_EX_SUBITEMIMAGES,
+                 This->col_status > 0 ? LVS_EX_SUBITEMIMAGES : 0);
+#endif
 }
 
 /* LVM_SORTITEMS callback used when initially inserting items */
@@ -3116,7 +3149,12 @@ static LRESULT ShellView_OnNotify(IShellViewImpl * This, UINT CtlID, LPNMHDR lpn
 	      lpdi->item.state = (lpdi->item.state & ~LVIS_OVERLAYMASK) | INDEXTOOVERLAYMASK(ShellView_Overlay(This, pidl));
 	    }
 
-	    if(lpdi->item.mask & LVIF_IMAGE)	/* image requested */
+	    if ((lpdi->item.mask & LVIF_IMAGE) && lpdi->item.iSubItem != 0)
+	    {
+	      /* Stained Glass OS 6256: a cloud file's Status glyph; no picture in the other columns */
+	      lpdi->item.iImage = lpdi->item.iSubItem == This->col_status ? ShellView_StatusGlyph(This, pidl) : -1;
+	    }
+	    else if(lpdi->item.mask & LVIF_IMAGE)	/* image requested */
 	    {
 	      /* Stained Glass: on a share, a file's own icon is read beside the view */
 	      if (lpdi->item.iSubItem != 0 || (lpdi->item.iImage = ShellView_RemoteIcon(This, pidl)) == -2)
