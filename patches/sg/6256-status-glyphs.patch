+/* ---- Stained Glass OS 6256: the Status column's glyphs ----
+ * A cloud file's state is shown beside its Status text, as File Explorer does: an outlined
+ * cloud (online only), an outlined circle with a check (on this device), a filled circle with
+ * a check (always on this device), two arrows (sync pending).  Our own drawings, made at each
+ * list's size (drawn four times over and averaged, so their edges are smooth) and added to all
+ * the shell's lists at one index, as the cache keeps them. */
+
+#define GLYPH_KEY RGB(255, 0, 255)
+
+static void sic_init(void);
+
+static void glyph_ellipse( HDC dc, double s, double l, double t, double r, double b, COLORREF c )
+{
+    HBRUSH brush = CreateSolidBrush( c ), old_brush = SelectObject( dc, brush );
+    HPEN old_pen = SelectObject( dc, GetStockObject( NULL_PEN ) );
+    Ellipse( dc, (int)(l * s), (int)(t * s), (int)(r * s) + 1, (int)(b * s) + 1 );
+    SelectObject( dc, old_pen );
+    DeleteObject( SelectObject( dc, old_brush ) );
+}
+
+static void glyph_rect( HDC dc, double s, double l, double t, double r, double b, COLORREF c )
+{
+    RECT rc = { (int)(l * s), (int)(t * s), (int)(r * s), (int)(b * s) };
+    HBRUSH brush = CreateSolidBrush( c );
+    FillRect( dc, &rc, brush );
+    DeleteObject( brush );
+}
+
+static void glyph_line( HDC dc, double s, const double *pts, int n, double width, COLORREF c )
+{
+    LOGBRUSH lb = { BS_SOLID, c, 0 };
+    HPEN pen = ExtCreatePen( PS_GEOMETRIC | PS_SOLID | PS_ENDCAP_ROUND | PS_JOIN_ROUND, max( 1, (int)(width * s) ), &lb, 0, NULL );
+    HPEN old = SelectObject( dc, pen );
+    POINT p[8];
+    int i;
+
+    for (i = 0; i < n && i < 8; i++) { p[i].x = (int)(pts[2 * i] * s); p[i].y = (int)(pts[2 * i + 1] * s); }
+    Polyline( dc, p, n );
+    DeleteObject( SelectObject( dc, old ) );
+}
+
+static void glyph_arc( HDC dc, double s, double cx, double cy, double rad, double a0, double a1, double width, COLORREF c )
+{
+    double pts[16];
+    int i;
+
+    for (i = 0; i < 8; i++)
+    {
+        double a = a0 + (a1 - a0) * i / 7;
+        pts[2 * i] = cx + rad * cos( a );
+        pts[2 * i + 1] = cy - rad * sin( a );
+    }
+    glyph_line( dc, s, pts, 8, width, c );
+}
+
+static void glyph_draw( HDC dc, double s, int state )
+{
+    static const COLORREF blue = RGB(0, 103, 192), green = RGB(16, 124, 16), white = RGB(255, 255, 255);
+    static const double check[] = { 4.6, 8.2, 6.9, 10.5, 11.4, 5.8 };
+
+    switch (state)
+    {
+    case 1:  /* online only: an outlined cloud */
+        glyph_ellipse( dc, s, 0.8, 6.5, 7.6, 13.3, blue );
+        glyph_ellipse( dc, s, 3.6, 2.6, 12.0, 11.0, blue );
+        glyph_ellipse( dc, s, 8.4, 6.0, 15.2, 12.8, blue );
+        glyph_rect( dc, s, 4.0, 9.0, 12.0, 13.3, blue );
+        glyph_ellipse( dc, s, 2.2, 7.9, 6.2, 11.9, GLYPH_KEY );
+        glyph_ellipse( dc, s, 5.0, 4.0, 10.6, 9.6, GLYPH_KEY );
+        glyph_ellipse( dc, s, 9.8, 7.4, 13.8, 11.4, GLYPH_KEY );
+        glyph_rect( dc, s, 4.0, 9.6, 12.0, 11.9, GLYPH_KEY );
+        break;
+    case 2:  /* on this device: a check in an outlined circle */
+        glyph_ellipse( dc, s, 1.0, 1.0, 15.0, 15.0, green );
+        glyph_ellipse( dc, s, 2.5, 2.5, 13.5, 13.5, GLYPH_KEY );
+        glyph_line( dc, s, check, 3, 1.5, green );
+        break;
+    case 3:  /* always on this device: a check in a filled circle */
+        glyph_ellipse( dc, s, 1.0, 1.0, 15.0, 15.0, green );
+        glyph_line( dc, s, check, 3, 1.6, white );
+        break;
+    case 4:  /* sync pending: two arrows going round */
+    {
+        static const double head1[] = { 11.6, 1.8, 13.4, 4.7, 10.2, 5.2 };
+        static const double head2[] = { 4.4, 14.2, 2.6, 11.3, 5.8, 10.8 };
+        glyph_arc( dc, s, 8.0, 8.0, 5.6, 0.35, 2.75, 1.5, blue );
+        glyph_arc( dc, s, 8.0, 8.0, 5.6, 3.49, 5.89, 1.5, blue );
+        glyph_line( dc, s, head1, 3, 1.5, blue );
+        glyph_line( dc, s, head2, 3, 1.5, blue );
+        break;
+    }
+    }
+}
+
+static HICON make_status_glyph( int state, int size )
+{
+    const int ss = 4, big = size * ss;
+    BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER) }};
+    DWORD *hi = NULL, *lo = NULL;
+    HBITMAP hi_bmp, lo_bmp, mask;
+    ICONINFO info = { TRUE };
+    HICON icon = NULL;
+    HDC dc;
+    int x, y, i, j;
+
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biWidth = big;
+    bmi.bmiHeader.biHeight = -big;
+    dc = CreateCompatibleDC( NULL );
+    if (!(hi_bmp = CreateDIBSection( dc, &bmi, DIB_RGB_COLORS, (void **)&hi, NULL, 0 ))) { DeleteDC( dc ); return NULL; }
+    bmi.bmiHeader.biWidth = size;
+    bmi.bmiHeader.biHeight = size;   /* bottom-up, as icons' bitmaps are */
+    if (!(lo_bmp = CreateDIBSection( dc, &bmi, DIB_RGB_COLORS, (void **)&lo, NULL, 0 )))
+    {
+        DeleteObject( hi_bmp );
+        DeleteDC( dc );
+        return NULL;
+    }
+    SelectObject( dc, hi_bmp );
+    glyph_rect( dc, 1, 0, 0, big, big, GLYPH_KEY );
+    glyph_draw( dc, big / 16.0, state );
+    GdiFlush();
+    for (y = 0; y < size; y++)
+        for (x = 0; x < size; x++)
+        {
+            unsigned int r = 0, g = 0, b = 0, n = 0;
+            for (j = 0; j < ss; j++)
+                for (i = 0; i < ss; i++)
+                {
+                    DWORD p = hi[(y * ss + j) * big + x * ss + i] & 0xffffff;
+                    if (p == 0xff00ff) continue;   /* the key, as DIB colour (BGR) */
+                    r += (p >> 16) & 0xff; g += (p >> 8) & 0xff; b += p & 0xff; n++;
+                }
+            if (!n) { lo[(size - 1 - y) * size + x] = 0; continue; }
+            /* premultiplied */
+            lo[(size - 1 - y) * size + x] = ((n * 255 / (ss * ss)) << 24) | ((r / n * n / (ss * ss)) << 16) |
+                               ((g / n * n / (ss * ss)) << 8) | (b / n * n / (ss * ss));
+        }
+    DeleteDC( dc );
+    DeleteObject( hi_bmp );
+    {
+        /* the AND mask: set where the glyph is transparent */
+        int stride = ((size + 15) / 16) * 2;
+        BYTE *mbits = calloc( stride, size );
+        if (mbits)
+            for (y = 0; y < size; y++)
+                for (x = 0; x < size; x++)
+                    if (!(lo[(size - 1 - y) * size + x] >> 24)) mbits[y * stride + x / 8] |= 0x80 >> (x % 8);
+        mask = CreateBitmap( size, size, 1, 1, mbits );
+        free( mbits );
+    }
+    info.hbmColor = lo_bmp;
+    info.hbmMask = mask;
+    icon = CreateIconIndirect( &info );
+    DeleteObject( mask );
+    DeleteObject( lo_bmp );
+    return icon;
+}
+
+static int status_glyphs[5];                 /* index + 1 in the shell's lists, 0 not made */
+static HIMAGELIST status_glyphs_lists;       /* the lists they were made in */
+
+/* the shell's image list index of a Status glyph (state 1..4), -1 for none */
+int SHELL32_StatusGlyph( int state )
+{
+    unsigned int i;
+    int index = -1, added;
+    SIZE size;
+
+#ifdef SG_MUTANT_NO_STATUS_GLYPH
+    return -1;
+#endif
+    if (state < 1 || state > 4) return -1;
+    sic_init();
+    EnterCriticalSection( &SHELL32_SicCS );
+    if (status_glyphs_lists != shell_imagelists[0])
+    {
+        memset( status_glyphs, 0, sizeof(status_glyphs) );
+        status_glyphs_lists = shell_imagelists[0];
+    }
+    if (status_glyphs[state]) index = status_glyphs[state] - 1;
+    else
+    {
+        for (i = 0; i < ARRAY_SIZE(shell_imagelists); i++)
+        {
+            HICON icon;
+
+            if (!get_imagelist_icon_size( i, &size ) || !(icon = make_status_glyph( state, size.cx ))) break;
+            added = ImageList_AddIcon( shell_imagelists[i], icon );
+            DestroyIcon( icon );
+            if (index != -1 && added != index) WARN( "Imagelists out of sync, list %u.\n", i );
+            index = added;
+        }
+        if (i < ARRAY_SIZE(shell_imagelists)) index = -1;
+        status_glyphs[state] = index + 1;
+    }
+    LeaveCriticalSection( &SHELL32_SicCS );
+    return index;
+}
+
