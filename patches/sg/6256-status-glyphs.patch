     if ((flags & (CF_UPDATE_FLAG_ALWAYS_FULL | CF_UPDATE_FLAG_ALLOW_PARTIAL))
@@ -1062,7 +1073,7 @@ HRESULT WINAPI CfRevertPlaceholder( HANDLE handle, DWORD flags, void *overlapped
