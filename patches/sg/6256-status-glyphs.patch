diff --git a/dlls/shell32/iconcache.c b/dlls/shell32/iconcache.c
index 70f5331..1e63e08 100644
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -22,6 +22,7 @@
 #include <string.h>
 #include <sys/types.h>
 #include <limits.h>
+#include <math.h>
 
 #define COBJMACROS
 
@@ -360,6 +361,207 @@ static BOOL get_imagelist_icon_size(int list, SIZE *size)
     return TRUE;
