From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmvcore: system profiles

IWMProfileManager::GetSystemProfileCount/LoadSystemProfile generate the
documented version 8 audio-only system profiles (one WMA v2 audio stream at
28.8/28.8/32/48/64/96/128 Kbps; mono for the first) with the documented names
and descriptions; other versions have none (no predefined version 9 profiles),
an index past the end is E_INVALIDARG. The profile ID constants are not part of
the documentation text, so LoadProfileByID and IWMWriter::SetProfileByID answer
NS_E_INVALIDPROFILE for every ID instead of inventing GUIDs.
---
diff --git a/dlls/wmvcore/profile.c b/dlls/wmvcore/profile.c
index 15b3306..6fd6e76 100644
--- a/dlls/wmvcore/profile.c
+++ b/dlls/wmvcore/profile.c
@@ -1919,3 +1919,96 @@ fail:
     IWMProfile3_Release(dst);
     return hr;
 }
+
+/* The system profiles of the version 8 list that describe nothing but one audio
+ * stream of a given bit rate and channel count. The list is the order of the
+ * documented table of version 8 system profiles; the video and multiple bit
+ * rate ones are not described in enough detail to generate a stream
+ * configuration and are left out. The sample rate is an assumption. */
+static const struct system_profile
+{
+    const WCHAR *name, *description;
+    DWORD bitrate;
+    WORD channels;
+    DWORD rate;
+}
+system_profiles[] =
+{
+    {L"Audio 8 for Dial-up Modem (Mono, 28.8 Kbps)", L"Use this profile for radio and music content (audio only).", 28800, 1, 22050},
+    {L"Audio 8 for Dial-up Modem (FM Radio Stereo, 28.8 Kbps)", L"Use this profile for radio and music content (audio only).", 28800, 2, 22050},
+    {L"Audio 8 for Dial-up Modem (32 Kbps)", L"Use this profile for radio and music content (audio only).", 32000, 2, 22050},
+    {L"Audio 8 for Dial-up Modem (Near CD quality, 48 Kbps)", L"Use for radio, music, and general purpose audio content.", 48000, 2, 44100},
+    {L"Audio 8 for Dial-up Modem (CD quality, 64 Kbps)", L"Use this profile for target audiences with high speed Internet or LAN connections.", 64000, 2, 44100},
+    {L"Audio 8 for ISDN (Better than CD quality, 96 Kbps)", L"Use this profile for target audiences with high speed Internet or LAN connections.", 96000, 2, 44100},
+    {L"Audio 8 for ISDN (Better than CD quality, 128 Kbps)", L"Use this profile for target audiences with high speed Internet or LAN connections.", 128000, 2, 44100},
+};
+
+DWORD profile_system_count(WMT_VERSION version)
+{
+    /* Only the version 8 list is described; there are no predefined version 9 profiles. */
+#ifdef SG_MUTANT_WMVP_SYSVERSION
+    return ARRAY_SIZE(system_profiles);
+#else
+    return version == WMT_VER_8_0 ? ARRAY_SIZE(system_profiles) : 0;
+#endif
+}
+
+HRESULT profile_system_load(WMT_VERSION version, DWORD index, IWMProfile3 **out)
+{
+    static const GUID audio_type = {0x73647561, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+    static const GUID wave_format = {0x05589f81, 0xc356, 0x11ce, {0xbf, 0x01, 0x00, 0xaa, 0x00, 0x55, 0x59, 0x5a}};
+    const struct system_profile *desc;
+    IWMStreamConfig *config;
+    IWMMediaProps *props;
+    IWMProfile3 *profile;
+    WM_MEDIA_TYPE mt = {0};
+    BYTE format[18] = {0};
+    DWORD align;
+    HRESULT hr;
+
+    if (index >= profile_system_count(version))
+        return E_INVALIDARG;
+    desc = &system_profiles[index];
+
+    if (FAILED(hr = profile_create(version, &profile)))
+        return hr;
+    IWMProfile3_SetName(profile, desc->name);
+    IWMProfile3_SetDescription(profile, desc->description);
+
+    if (FAILED(hr = IWMProfile3_CreateNewStream(profile, &audio_type, &config)))
+        goto fail;
+    IWMStreamConfig_SetBitrate(config, desc->bitrate);
+
+    /* Audio version 2 (format tag 0x161), 16 bit samples. */
+    format[0] = 0x61; format[1] = 0x01;
+    format[2] = desc->channels;
+    memcpy(format + 4, &desc->rate, 4);
+    align = desc->bitrate / 8;
+    memcpy(format + 8, &align, 4);
+    align = desc->channels * 2;
+    format[12] = align;
+    format[14] = 16;
+    mt.majortype = audio_type;
+    mt.subtype = audio_type;
+    mt.subtype.Data1 = 0x161;
+    mt.bFixedSizeSamples = TRUE;
+    mt.lSampleSize = align;
+    mt.formattype = wave_format;
+    mt.cbFormat = sizeof(format);
+    mt.pbFormat = format;
+    if (SUCCEEDED(hr = IWMStreamConfig_QueryInterface(config, &IID_IWMMediaProps, (void **)&props)))
+    {
+        hr = IWMMediaProps_SetMediaType(props, &mt);
+        IWMMediaProps_Release(props);
+    }
+    if (SUCCEEDED(hr))
+        hr = IWMProfile3_AddStream(profile, config);
+    IWMStreamConfig_Release(config);
+    if (FAILED(hr))
+        goto fail;
+    *out = profile;
+    return S_OK;
+fail:
+    IWMProfile3_Release(profile);
+    return hr;
+}
diff --git a/dlls/wmvcore/profile.h b/dlls/wmvcore/profile.h
index 3a27219..1cc0913 100644
--- a/dlls/wmvcore/profile.h
+++ b/dlls/wmvcore/profile.h
@@ -23,6 +23,9 @@
 
 /* An empty profile of the given version (the version is not checked here). */
 HRESULT profile_create(WMT_VERSION version, IWMProfile3 **out);
+/* The system profiles that can be generated for a version, and the one at an index. */
+DWORD profile_system_count(WMT_VERSION version);
+HRESULT profile_system_load(WMT_VERSION version, DWORD index, IWMProfile3 **out);
 /* A private copy of any profile object, made through its interfaces. */
 HRESULT profile_clone(IWMProfile *src, IWMProfile3 **out);
 /* The XML form of a profile. A NULL buffer returns the length needed, in
diff --git a/dlls/wmvcore/wmvcore_main.c b/dlls/wmvcore/wmvcore_main.c
index ff80786..352b833 100644
--- a/dlls/wmvcore/wmvcore_main.c
+++ b/dlls/wmvcore/wmvcore_main.c
@@ -278,8 +278,9 @@ static HRESULT WINAPI WMProfileManager_LoadProfileByID(IWMProfileManager2 *iface
     if (!guid || !ret)
         return E_INVALIDARG;
     *ret = NULL;
-    FIXME("profiles are not implemented\n");
-    return E_NOTIMPL;
+    /* The profile ID constants of the system profiles are not available here, so
+     * no ID names a profile: the documented answer for an unknown ID. */
+    return NS_E_INVALIDPROFILE;
 }
 
 static HRESULT WINAPI WMProfileManager_LoadProfileByData(IWMProfileManager2 *iface, const WCHAR *profile, IWMProfile **ret)
@@ -313,8 +314,8 @@ static HRESULT WINAPI WMProfileManager_GetSystemProfileCount(IWMProfileManager2
 
     if (!ret)
         return E_INVALIDARG;
-    FIXME("system profiles are not implemented\n");
-    return E_NOTIMPL;
+    *ret = profile_system_count(This->system_version);
+    return S_OK;
 }
 
 static HRESULT WINAPI WMProfileManager_LoadSystemProfile(IWMProfileManager2 *iface, DWORD index, IWMProfile **ret)
@@ -326,8 +327,7 @@ static HRESULT WINAPI WMProfileManager_LoadSystemProfile(IWMProfileManager2 *ifa
     if (!ret)
         return E_INVALIDARG;
     *ret = NULL;
-    FIXME("system profiles are not implemented\n");
-    return E_NOTIMPL;
+    return profile_system_load(This->system_version, index, (IWMProfile3 **)ret);
 }
 
 static HRESULT WINAPI WMProfileManager2_GetSystemProfileVersion(IWMProfileManager2 *iface, WMT_VERSION *version)
diff --git a/dlls/wmvcore/writer.c b/dlls/wmvcore/writer.c
index 6d11d24..88c442e 100644
--- a/dlls/wmvcore/writer.c
+++ b/dlls/wmvcore/writer.c
@@ -501,9 +501,9 @@ static HRESULT WINAPI WMWriter_SetProfileByID(IWMWriter *iface, REFGUID guidProf
 
     if (!guidProfile)
         return E_INVALIDARG;
-    /* There are no system profiles to look the ID up in. */
-    FIXME("system profiles are not available\n");
-    return E_NOTIMPL;
+    /* No system profile ID is known here, so none can be loaded (as with
+     * IWMProfileManager::LoadProfileByID). */
+    return NS_E_INVALIDPROFILE;
 }
 
 static HRESULT WINAPI WMWriter_SetProfile(IWMWriter *iface, IWMProfile *profile)
