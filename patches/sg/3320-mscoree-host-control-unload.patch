From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 07:58:08 -0700
Subject: [PATCH] mscoree: SetHostControl, GetCLRControl, UnloadAppDomain and
 UnloadDomain (3320)

DECISIONS-2 NET-HOST. ICLRRuntimeHost::SetHostControl keeps the host's IHostControl
(refused with HOST_E_INVALIDOPERATION once the runtime has started, as the docs say
it must come first); GetCLRControl hands out an ICLRControl whose
SetAppDomainManagerType records the manager type (GetCLRManager has no managers to
give: Wine Mono has none, E_NOINTERFACE). UnloadAppDomain(id) and
ICorRuntimeHost::UnloadDomain(domain) unload a real AppDomain (through
AppDomain.InternalUnload, so the thread and GC state is the runtime's own); the
default domain and unknown ids give COR_E_CANNOTUNLOADAPPDOMAIN and
COR_E_APPDOMAINUNLOADED. The gate runs with Wine Mono.

diff --git a/dlls/mscoree/corruntimehost.c b/dlls/mscoree/corruntimehost.c
index 628834d..8f9ea85 100644
--- a/dlls/mscoree/corruntimehost.c
+++ b/dlls/mscoree/corruntimehost.c
@@ -739,12 +739,71 @@ static HRESULT WINAPI corruntimehost_CreateEvidence(
     return E_NOTIMPL;
 }
 
+static HRESULT RuntimeHost_UnloadDomainId(RuntimeHost *This, int id)
+{
+    MonoDomain *domain, *root;
+    MonoObject *result;
+    void *args[1];
+    HRESULT hr;
+
+    if (!is_mono_started) return HOST_E_CLRNOTAVAILABLE;
+    root = get_root_domain();
+    if (!(domain = mono_domain_get_by_id(id))) return COR_E_APPDOMAINUNLOADED;
+    /* the default domain lives as long as the runtime */
+    if (domain == root) return COR_E_CANNOTUNLOADAPPDOMAIN;
+    /* AppDomain.Unload does this for the managed AppDomain object that has this id */
+    args[0] = &id;
+#ifndef SG_MUTANT_HOST_NOUNLOAD
+    hr = RuntimeHost_Invoke(This, root, NULL, "System", "AppDomain", "InternalUnload", NULL, args, 1, &result);
+#else
+    hr = S_OK;
+#endif
+    if (FAILED(hr)) WARN("unloading domain %d failed: %#lx\n", id, hr);
+    return FAILED(hr) ? COR_E_CANNOTUNLOADAPPDOMAIN : S_OK;
+}
+
+/* the Id of the AppDomain behind a COM object, through its IDispatch (the object may be a proxy of another domain) */
+static HRESULT get_domain_id(IUnknown *unk, int *id)
+{
+    static WCHAR id_name[] = L"Id";
+    DISPPARAMS params = { NULL, NULL, 0, 0 };
+    OLECHAR *names[1] = { id_name };
+    IDispatch *disp;
+    DISPID dispid;
+    VARIANT value;
+    HRESULT hr;
+
+    if (FAILED(hr = IUnknown_QueryInterface(unk, &IID_IDispatch, (void **)&disp))) return hr;
+    hr = IDispatch_GetIDsOfNames(disp, &IID_NULL, names, 1, LOCALE_USER_DEFAULT, &dispid);
+    if (SUCCEEDED(hr))
+    {
+        VariantInit(&value);
+        hr = IDispatch_Invoke(disp, dispid, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_PROPERTYGET, &params, &value, NULL, NULL);
+        if (SUCCEEDED(hr))
+        {
+            if (V_VT(&value) == VT_I4) *id = V_I4(&value);
+            else hr = E_INVALIDARG;
+            VariantClear(&value);
+        }
+    }
+    IDispatch_Release(disp);
+    return hr;
+}
+
 static HRESULT WINAPI corruntimehost_UnloadDomain(
     ICorRuntimeHost* iface,
     IUnknown *appDomain)
 {
-    FIXME("stub %p\n", iface);
-    return E_NOTIMPL;
+    RuntimeHost *This = impl_from_ICorRuntimeHost( iface );
+    HRESULT hr;
+    int id;
+
+    TRACE("(%p, %p)\n", iface, appDomain);
+
+    if (!appDomain) return E_POINTER;
+    if (!is_mono_started) return HOST_E_CLRNOTAVAILABLE;
+    if (FAILED(hr = get_domain_id(appDomain, &id))) return hr;
+    return RuntimeHost_UnloadDomainId(This, id);
 }
 
 static HRESULT WINAPI corruntimehost_CurrentDomain(
@@ -832,25 +891,144 @@ static HRESULT WINAPI CLRRuntimeHost_Stop(ICLRRuntimeHost* iface)
     return E_NOTIMPL;
 }
 
+/* what a host hands over before the runtime starts; the CLR hosting managers are not used by Wine Mono */
+static CRITICAL_SECTION host_control_cs;
+static CRITICAL_SECTION_DEBUG host_control_cs_debug =
+{
+    0, 0, &host_control_cs,
+    { &host_control_cs_debug.ProcessLocksList, &host_control_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": host_control_cs") }
+};
+static CRITICAL_SECTION host_control_cs = { &host_control_cs_debug, -1, 0, 0, 0, 0 };
+static IHostControl *host_control;
+static WCHAR *domain_manager_assembly, *domain_manager_type;
+
+struct clr_control
+{
+    ICLRControl ICLRControl_iface;
+    LONG ref;
+};
+
+static inline struct clr_control *impl_from_ICLRControl(ICLRControl *iface)
+{
+    return CONTAINING_RECORD(iface, struct clr_control, ICLRControl_iface);
+}
+
+static HRESULT WINAPI clr_control_QueryInterface(ICLRControl *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_ICLRControl))
+    {
+        *obj = iface;
+        ICLRControl_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI clr_control_AddRef(ICLRControl *iface)
+{
+    return InterlockedIncrement(&impl_from_ICLRControl(iface)->ref);
+}
+
+static ULONG WINAPI clr_control_Release(ICLRControl *iface)
+{
+    struct clr_control *This = impl_from_ICLRControl(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref) free(This);
+    return ref;
+}
+
+static HRESULT WINAPI clr_control_GetCLRManager(ICLRControl *iface, REFIID riid, void **obj)
+{
+    /* the task, policy, GC, debug and domain managers are the CLR's own: Mono has none to hand out */
+    FIXME("(%p, %s, %p): no CLR managers\n", iface, debugstr_guid(riid), obj);
+    if (obj) *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI clr_control_SetAppDomainManagerType(ICLRControl *iface, LPCWSTR assembly, LPCWSTR type)
+{
+    WCHAR *a, *t;
+
+    TRACE("(%p, %s, %s)\n", iface, debugstr_w(assembly), debugstr_w(type));
+
+    if (!assembly || !type) return E_POINTER;
+    if (is_mono_started) return HOST_E_INVALIDOPERATION;
+    a = wcsdup(assembly);
+    t = wcsdup(type);
+    if (!a || !t)
+    {
+        free(a);
+        free(t);
+        return E_OUTOFMEMORY;
+    }
+    EnterCriticalSection(&host_control_cs);
+    free(domain_manager_assembly);
+    free(domain_manager_type);
+    domain_manager_assembly = a;
+    domain_manager_type = t;
+    LeaveCriticalSection(&host_control_cs);
+    return S_OK;
+}
+
+static const ICLRControlVtbl clr_control_vtbl =
+{
+    clr_control_QueryInterface,
+    clr_control_AddRef,
+    clr_control_Release,
+    clr_control_GetCLRManager,
+    clr_control_SetAppDomainManagerType,
+};
+
 static HRESULT WINAPI CLRRuntimeHost_SetHostControl(ICLRRuntimeHost* iface,
     IHostControl *pHostControl)
 {
-    FIXME("(%p,%p)\n", iface, pHostControl);
-    return E_NOTIMPL;
+    TRACE("(%p,%p)\n", iface, pHostControl);
+
+    if (!pHostControl) return E_POINTER;
+    /* the host control must be in place before the runtime is initialised */
+#ifndef SG_MUTANT_HOST_STARTED
+    if (is_mono_started) return HOST_E_INVALIDOPERATION;
+#endif
+
+    EnterCriticalSection(&host_control_cs);
+#ifndef SG_MUTANT_HOST_REFS
+    IHostControl_AddRef(pHostControl);
+#endif
+    if (host_control) IHostControl_Release(host_control);
+    host_control = pHostControl;
+    LeaveCriticalSection(&host_control_cs);
+    return S_OK;
 }
 
 static HRESULT WINAPI CLRRuntimeHost_GetCLRControl(ICLRRuntimeHost* iface,
     ICLRControl **pCLRControl)
 {
-    FIXME("(%p,%p)\n", iface, pCLRControl);
-    return E_NOTIMPL;
+    struct clr_control *control;
+
+    TRACE("(%p,%p)\n", iface, pCLRControl);
+
+    if (!pCLRControl) return E_POINTER;
+    *pCLRControl = NULL;
+#ifndef SG_MUTANT_HOST_CTRL
+    if (is_mono_started) return HOST_E_INVALIDOPERATION;
+#endif
+    if (!(control = malloc(sizeof(*control)))) return E_OUTOFMEMORY;
+    control->ICLRControl_iface.lpVtbl = &clr_control_vtbl;
+    control->ref = 1;
+    *pCLRControl = &control->ICLRControl_iface;
+    return S_OK;
 }
 
 static HRESULT WINAPI CLRRuntimeHost_UnloadAppDomain(ICLRRuntimeHost* iface,
     DWORD dwAppDomainId, BOOL fWaitUntilDone)
 {
-    FIXME("(%p,%lu,%i)\n", iface, dwAppDomainId, fWaitUntilDone);
-    return E_NOTIMPL;
+    TRACE("(%p,%lu,%i)\n", iface, dwAppDomainId, fWaitUntilDone);
+
+    /* Mono unloads synchronously, so there is no difference when the caller does not want to wait */
+    return RuntimeHost_UnloadDomainId(impl_from_ICLRRuntimeHost(iface), dwAppDomainId);
 }
 
 static HRESULT WINAPI CLRRuntimeHost_ExecuteInAppDomain(ICLRRuntimeHost* iface,
