From: Stained Glass OS <dev@stained-glass.example>
Subject: msvcp: _Sinh, _Cosh, _FSinh, _FCosh, _LSinh, _LCosh

Microsoft's C++ library computes std::complex's sin, cos, sinh, cosh and
tan through _Sinh(x, y) = y * sinh(x) and _Cosh(x, y) = y * cosh(x); Wine
had stubs. LibreOffice for Windows (SG Office) calls them for Calc's
IMSIN, IMCOS, IMSINH, IMCOSH, IMTAN ... and ended at the first such cell
("unimplemented function msvcp140.dll._Sinh"). For |x| > 709, where sinh
and cosh overflow a double, y * e^(|x| - ln 2) is computed instead, so a
small y still gives a finite result; y = 0 gives 0, NaN gives NaN.

Gate: test/sinh-gate.sh (make test-sinh).
--- a/dlls/msvcp90/math.c
--- a/dlls/msvcp90/math.c
+++ b/dlls/msvcp90/math.c
@@ -2363,6 +2363,36 @@
     return dclass(*x);
 }
 
+/* _Sinh: y * sinh(x), what std::sinh and std::complex's sin/cos/sinh/cosh/tan use */
+double __cdecl _Sinh(double x, double y)
+{
+    if (y == 0 || isnan(x)) return isnan(x) ? x : 0;
+    if (fabs(x) > 709.0)   /* sinh itself overflows while y * sinh may not */
+        return y * copysign(exp(fabs(x) - M_LN2), x);
+    return y * sinh(x);
+}
+
+/* _Cosh: y * cosh(x) */
+double __cdecl _Cosh(double x, double y)
+{
+    if (y == 0 || isnan(x)) return isnan(x) ? x : 0;
+    if (fabs(x) > 709.0)
+        return y * exp(fabs(x) - M_LN2);
+    return y * cosh(x);
+}
+
+/* _FSinh */
+float __cdecl _FSinh(float x, float y)
+{
+    return _Sinh(x, y);
+}
+
+/* _FCosh */
+float __cdecl _FCosh(float x, float y)
+{
+    return _Cosh(x, y);
+}
+
