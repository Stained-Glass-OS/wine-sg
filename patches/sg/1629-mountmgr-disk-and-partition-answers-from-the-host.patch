From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mountmgr: disk and partition answers from the host

mountmgr made up what it said about disks: a disk of 10000 cylinders of
512-byte sectors, no seek penalty (every disk an SSD), no maker, model or
revision, a SCSI bus, zeroed volume extents; it did not answer partition
information or the volume's length (backup tools, installers, disk
utilities, defragmenters and game launchers ask). A new unix call reads
sysfs for the disk under a device -- its node, or for a drive like C: the
filesystem its directory lives on (stat st_dev):

- sizes: the disk, and the partition's start, size and number;
  device-mapper/md devices stand for the disk under them;
- logical and physical sector sizes, rotational, removable;
- vendor, model and revision; the bus (USB, NVMe, SATA, SD, else SCSI);
- the partition table type and the partition's entry type and id, as udev
  recorded them (/run/udev/data).

With these:
- IOCTL_STORAGE_QUERY_PROPERTY: StorageDeviceProperty with vendor, product,
  revision, bus type and removability; StorageDeviceSeekPenaltyProperty
  from rotational; StorageAccessAlignmentProperty (new);
- IOCTL_DISK_GET_DRIVE_GEOMETRY(_EX): the real sector size and disk size;
- IOCTL_DISK_GET_LENGTH_INFO, IOCTL_DISK_GET_PARTITION_INFO_EX and
  IOCTL_DISK_GET_PARTITION_INFO (MBR only, as on Windows) are answered;
- IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS gives the partition's extent.
Devices with nothing under them answer as before.

winioctl.h/ntddstor.h: PARTITION_STYLE, PARTITION_INFORMATION_MBR/GPT/EX,
GET_LENGTH_INFORMATION, STORAGE_ACCESS_ALIGNMENT_DESCRIPTOR.

Wine's kernel32 volume tests: no failures, as before.

Gate: test/diskinfo-gate.sh (compares with sysfs; skips without a block
device under the prefix). Mutant SG_MUTANT_NO_DISK_INFO
(mountmgr.sys/device.c).
---
--- a/dlls/mountmgr.sys/device.c
+++ b/dlls/mountmgr.sys/device.c
@@ -1528,6 +1528,18 @@ NTSTATUS query_unix_drive( void *buff, SIZE_T insize, SIZE_T outsize, IO_STATUS_
     return status;
 }
 
+/* Stained Glass OS: what the host knows of the disk under a device */
+static BOOL get_disk_info( struct disk_device *device, struct disk_info *info )
+{
+    struct get_disk_info_params params = { device->unix_device, device->unix_mount, info };
+
+#ifdef SG_MUTANT_NO_DISK_INFO
+    return FALSE;
+#endif
+    if (!device->unix_device && !device->unix_mount) return FALSE;
+    return !MOUNTMGR_CALL( get_disk_info, &params );
+}
+
 static NTSTATUS query_property( struct disk_device *device, IRP *irp )
 {
     IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation( irp );
@@ -1552,8 +1564,11 @@ static NTSTATUS query_property( struct disk_device *device, IRP *irp )
     {
         STORAGE_DEVICE_DESCRIPTOR *descriptor;
         DWORD len = sizeof(*descriptor);
+        struct disk_info info;
+        BOOL have_info = get_disk_info( device, &info );
 
         if (device->serial) len += strlen( device->serial ) + 1;
+        if (have_info) len += strlen( info.vendor ) + 1 + strlen( info.model ) + 1 + strlen( info.revision ) + 1;
 
         if (irpsp->Parameters.DeviceIoControl.OutputBufferLength < sizeof(STORAGE_DESCRIPTOR_HEADER))
             status = STATUS_INVALID_PARAMETER;
@@ -1567,7 +1582,7 @@ static NTSTATUS query_property( struct disk_device *device, IRP *irp )
         }
         else
         {
-            FIXME( "Faking StorageDeviceProperty data\n" );
+            if (!have_info) FIXME( "Faking StorageDeviceProperty data\n" );
 
             memset( irp->AssociatedIrp.SystemBuffer, 0, irpsp->Parameters.DeviceIoControl.OutputBufferLength );
             descriptor = irp->AssociatedIrp.SystemBuffer;
@@ -1588,6 +1603,22 @@ static NTSTATUS query_property( struct disk_device *device, IRP *irp )
                 descriptor->SerialNumberOffset = sizeof(*descriptor);
                 strcpy( (char *)descriptor + descriptor->SerialNumberOffset, device->serial );
             }
+            if (have_info)
+            {
+                /* the disk's own maker, model, revision, bus and removability */
+                DWORD offset = sizeof(*descriptor) + (device->serial ? strlen( device->serial ) + 1 : 0);
+
+                descriptor->VendorIdOffset = offset;
+                strcpy( (char *)descriptor + offset, info.vendor );
+                offset += strlen( info.vendor ) + 1;
+                descriptor->ProductIdOffset = offset;
+                strcpy( (char *)descriptor + offset, info.model );
+                offset += strlen( info.model ) + 1;
+                descriptor->ProductRevisionOffset = offset;
+                strcpy( (char *)descriptor + offset, info.revision );
+                descriptor->RemovableMedia = info.removable;
+                descriptor->BusType = info.bus_type;
+            }
             irp->IoStatus.Information = len;
             status = STATUS_SUCCESS;
         }
@@ -1611,10 +1642,13 @@ static NTSTATUS query_property( struct disk_device *device, IRP *irp )
             }
             else
             {
-                FIXME( "Faking StorageDeviceSeekPenaltyProperty data.\n" );
+                struct disk_info info;
 
                 memset( d, 0, sizeof(*d) );
                 d->Version = d->Size = sizeof(*d);
+                /* a spinning disk pays for seeks */
+                if (get_disk_info( device, &info )) d->IncursSeekPenalty = info.rotational;
+                else FIXME( "Faking StorageDeviceSeekPenaltyProperty data.\n" );
                 irp->IoStatus.Information = sizeof(*d);
             }
             status = STATUS_SUCCESS;
@@ -1622,6 +1656,37 @@ static NTSTATUS query_property( struct disk_device *device, IRP *irp )
         break;
     }
 
+    case StorageAccessAlignmentProperty:
+    {
+        STORAGE_ACCESS_ALIGNMENT_DESCRIPTOR *d = irp->AssociatedIrp.SystemBuffer;
+        struct disk_info info;
+
+        if (!get_disk_info( device, &info ))
+        {
+            status = STATUS_NOT_SUPPORTED;
+            break;
+        }
+        if (irpsp->Parameters.DeviceIoControl.OutputBufferLength < sizeof(STORAGE_DESCRIPTOR_HEADER))
+            status = STATUS_INVALID_PARAMETER;
+        else if (irpsp->Parameters.DeviceIoControl.OutputBufferLength < sizeof(*d))
+        {
+            d->Version = d->Size = sizeof(*d);
+            irp->IoStatus.Information = sizeof(STORAGE_DESCRIPTOR_HEADER);
+            status = STATUS_SUCCESS;
+        }
+        else
+        {
+            memset( d, 0, sizeof(*d) );
+            d->Version = d->Size = sizeof(*d);
+            d->BytesPerCacheLine = 64;
+            d->BytesPerLogicalSector = info.sector_size;
+            d->BytesPerPhysicalSector = info.physical_sector_size;
+            d->BytesOffsetForSectorAlignment = info.partition_start % info.physical_sector_size;
+            irp->IoStatus.Information = sizeof(*d);
+            status = STATUS_SUCCESS;
+        }
+        break;
+    }
     default:
         FIXME( "Unsupported property %#x\n", query->PropertyId );
         status = STATUS_NOT_SUPPORTED;
@@ -1630,6 +1695,27 @@ static NTSTATUS query_property( struct disk_device *device, IRP *irp )
     return status;
 }
 
+/* the partition a volume is, from the host */
+static void fill_partition_info_ex( struct disk_device *dev, const struct disk_info *info, PARTITION_INFORMATION_EX *part )
+{
+    memset( part, 0, sizeof(*part) );
+    part->PartitionStyle = info->gpt ? PARTITION_STYLE_GPT : PARTITION_STYLE_MBR;
+    part->StartingOffset.QuadPart = info->partition_start;
+    part->PartitionLength.QuadPart = info->partition_size;
+    part->PartitionNumber = info->partition_number;
+    if (info->gpt)
+    {
+        part->Gpt.PartitionType = info->gpt_type;
+        part->Gpt.PartitionId = info->gpt_id;
+    }
+    else
+    {
+        part->Mbr.PartitionType = info->mbr_type;
+        part->Mbr.RecognizedPartition = info->mbr_type != 0;
+        part->Mbr.HiddenSectors = info->partition_start / info->sector_size;
+    }
+}
+
 static NTSTATUS WINAPI harddisk_query_volume( DEVICE_OBJECT *device, IRP *irp )
 {
     IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation( irp );
@@ -1803,12 +1889,20 @@ static NTSTATUS WINAPI harddisk_ioctl( DEVICE_OBJECT *device, IRP *irp )
     {
         DISK_GEOMETRY info;
         DWORD len = min( sizeof(info), irpsp->Parameters.DeviceIoControl.OutputBufferLength );
+        struct disk_info disk;
 
         info.Cylinders.QuadPart = 10000;
         info.MediaType = (dev->devnum.DeviceType == FILE_DEVICE_DISK) ? FixedMedia : RemovableMedia;
         info.TracksPerCylinder = 255;
         info.SectorsPerTrack = 63;
         info.BytesPerSector = 512;
+        if (get_disk_info( dev, &disk ))
+        {
+            /* the disk's own size, in the geometry Windows makes up for it */
+            info.BytesPerSector = disk.sector_size;
+            info.Cylinders.QuadPart = disk.disk_size / (255 * 63 * (ULONGLONG)disk.sector_size);
+            if (disk.removable) info.MediaType = RemovableMedia;
+        }
         memcpy( irp->AssociatedIrp.SystemBuffer, &info, len );
         irp->IoStatus.Information = len;
         status = STATUS_SUCCESS;
@@ -1819,7 +1913,9 @@ static NTSTATUS WINAPI harddisk_ioctl( DEVICE_OBJECT *device, IRP *irp )
         DISK_GEOMETRY_EX info;
         DWORD len = min( sizeof(info), irpsp->Parameters.DeviceIoControl.OutputBufferLength );
 
-        FIXME("The DISK_PARTITION_INFO and DISK_DETECTION_INFO structures will not be filled\n");
+        struct disk_info disk;
+
+        TRACE("The DISK_PARTITION_INFO and DISK_DETECTION_INFO structures are not filled\n");
 
         info.Geometry.Cylinders.QuadPart = 10000;
         info.Geometry.MediaType = (dev->devnum.DeviceType == FILE_DEVICE_DISK) ? FixedMedia : RemovableMedia;
@@ -1828,6 +1924,13 @@ static NTSTATUS WINAPI harddisk_ioctl( DEVICE_OBJECT *device, IRP *irp )
         info.Geometry.BytesPerSector = 512;
         info.DiskSize.QuadPart = info.Geometry.Cylinders.QuadPart * info.Geometry.TracksPerCylinder *
                                  info.Geometry.SectorsPerTrack * info.Geometry.BytesPerSector;
+        if (get_disk_info( dev, &disk ))
+        {
+            info.Geometry.BytesPerSector = disk.sector_size;
+            info.Geometry.Cylinders.QuadPart = disk.disk_size / (255 * 63 * (ULONGLONG)disk.sector_size);
+            if (disk.removable) info.Geometry.MediaType = RemovableMedia;
+            info.DiskSize.QuadPart = disk.disk_size;
+        }
         info.Data[0]  = 0;
         memcpy( irp->AssociatedIrp.SystemBuffer, &info, len );
         irp->IoStatus.Information = len;
@@ -1849,13 +1952,87 @@ static NTSTATUS WINAPI harddisk_ioctl( DEVICE_OBJECT *device, IRP *irp )
     case IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS:
     {
         DWORD len = min( 32, irpsp->Parameters.DeviceIoControl.OutputBufferLength );
+        VOLUME_DISK_EXTENTS *extents = irp->AssociatedIrp.SystemBuffer;
+        struct disk_info disk;
 
-        FIXME( "returning zero-filled buffer for IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS\n" );
         memset( irp->AssociatedIrp.SystemBuffer, 0, len );
-        irp->IoStatus.Information = len;
+        if (get_disk_info( dev, &disk ))
+        {
+            if (len < sizeof(*extents))
+            {
+                status = STATUS_BUFFER_TOO_SMALL;
+                break;
+            }
+            /* one extent: the partition, on its disk */
+            extents->NumberOfDiskExtents = 1;
+            extents->Extents[0].DiskNumber = dev->devnum.DeviceNumber;
+            extents->Extents[0].StartingOffset.QuadPart = disk.partition_start;
+            extents->Extents[0].ExtentLength.QuadPart = disk.partition_size;
+            irp->IoStatus.Information = sizeof(*extents);
+        }
+        else
+        {
+            FIXME( "returning zero-filled buffer for IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS\n" );
+            irp->IoStatus.Information = len;
+        }
         status = STATUS_SUCCESS;
         break;
     }
+    case IOCTL_DISK_GET_LENGTH_INFO:
+    {
+        GET_LENGTH_INFORMATION *length = irp->AssociatedIrp.SystemBuffer;
+        struct disk_info disk;
+
+        if (irpsp->Parameters.DeviceIoControl.OutputBufferLength < sizeof(*length))
+            status = STATUS_BUFFER_TOO_SMALL;
+        else if (!get_disk_info( dev, &disk )) status = STATUS_NOT_SUPPORTED;
+        else
+        {
+            length->Length.QuadPart = disk.is_partition ? disk.partition_size : disk.disk_size;
+            irp->IoStatus.Information = sizeof(*length);
+            status = STATUS_SUCCESS;
+        }
+        break;
+    }
+    case IOCTL_DISK_GET_PARTITION_INFO_EX:
+    {
+        PARTITION_INFORMATION_EX *part = irp->AssociatedIrp.SystemBuffer;
+        struct disk_info disk;
+
+        if (irpsp->Parameters.DeviceIoControl.OutputBufferLength < sizeof(*part))
+            status = STATUS_BUFFER_TOO_SMALL;
+        else if (!get_disk_info( dev, &disk )) status = STATUS_NOT_SUPPORTED;
+        else
+        {
+            fill_partition_info_ex( dev, &disk, part );
+            irp->IoStatus.Information = sizeof(*part);
+            status = STATUS_SUCCESS;
+        }
+        break;
+    }
+    case IOCTL_DISK_GET_PARTITION_INFO:
+    {
+        PARTITION_INFORMATION *part = irp->AssociatedIrp.SystemBuffer;
+        struct disk_info disk;
+
+        if (irpsp->Parameters.DeviceIoControl.OutputBufferLength < sizeof(*part))
+            status = STATUS_BUFFER_TOO_SMALL;
+        else if (!get_disk_info( dev, &disk )) status = STATUS_NOT_SUPPORTED;
+        else if (disk.gpt) status = STATUS_INVALID_DEVICE_REQUEST;  /* MBR only, as on Windows */
+        else
+        {
+            memset( part, 0, sizeof(*part) );
+            part->StartingOffset.QuadPart = disk.partition_start;
+            part->PartitionLength.QuadPart = disk.partition_size;
+            part->HiddenSectors = disk.partition_start / disk.sector_size;
+            part->PartitionNumber = disk.partition_number;
+            part->PartitionType = disk.mbr_type;
+            part->RecognizedPartition = disk.mbr_type != 0;
+            irp->IoStatus.Information = sizeof(*part);
+            status = STATUS_SUCCESS;
+        }
+        break;
+    }
     case IOCTL_STORAGE_QUERY_PROPERTY:
         status = query_property( dev, irp );
         break;
--- a/dlls/mountmgr.sys/unixlib.c
+++ b/dlls/mountmgr.sys/unixlib.c
@@ -30,6 +30,11 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <sys/stat.h>
+#ifdef linux
+#include <dirent.h>
+#include <limits.h>
+#include <sys/sysmacros.h>
+#endif
 #ifdef HAVE_SYS_STATFS_H
 #include <sys/statfs.h>
 #endif
@@ -577,6 +582,177 @@ static NTSTATUS get_shell_folder( void *args )
     return STATUS_SUCCESS;
 }
 
+/* Stained Glass OS: a disk's properties, from sysfs */
+#ifdef linux
+static BOOL read_sys_string( const char *dir, const char *file, char *buf, size_t size )
+{
+    char path[PATH_MAX + 64];
+    ssize_t len;
+    int fd;
+
+    snprintf( path, sizeof(path), "%s/%s", dir, file );
+    if ((fd = open( path, O_RDONLY )) == -1) return FALSE;
+    len = read( fd, buf, size - 1 );
+    close( fd );
+    if (len <= 0) return FALSE;
+    buf[len] = 0;
+    while (len && (buf[len - 1] == '\n' || buf[len - 1] == ' ')) buf[--len] = 0;
+    return TRUE;
+}
+
+static ULONGLONG read_sys_ulonglong( const char *dir, const char *file )
+{
+    char buf[64];
+    return read_sys_string( dir, file, buf, sizeof(buf) ) ? strtoull( buf, NULL, 10 ) : 0;
+}
+
+/* a device-mapper or md device stands for the disk under it */
+static void follow_slaves( char *disk_dir, size_t size )
+{
+    char path[PATH_MAX + 64], real[PATH_MAX];
+    struct dirent *de;
+    int depth;
+    DIR *dir;
+
+    for (depth = 0; depth < 4; depth++)
+    {
+        snprintf( path, sizeof(path), "%s/slaves", disk_dir );
+        if (!(dir = opendir( path ))) return;
+        while ((de = readdir( dir )) && de->d_name[0] == '.') ;
+        if (!de) { closedir( dir ); return; }
+        snprintf( path, sizeof(path), "/sys/class/block/%s", de->d_name );
+        closedir( dir );
+        if (!realpath( path, real )) return;
+        /* a partition's disk is its parent */
+        snprintf( path, sizeof(path), "%s/partition", real );
+        if (!access( path, F_OK )) *strrchr( real, '/' ) = 0;
+        snprintf( disk_dir, size, "%s", real );
+    }
+}
+
+/* a GUID as udev writes it: 8-4-4-4-12 hex digits */
+static void parse_guid( const char *str, GUID *guid )
+{
+    unsigned int d[11];
+
+    if (sscanf( str, "%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x", &d[0], &d[1], &d[2], &d[3], &d[4],
+                &d[5], &d[6], &d[7], &d[8], &d[9], &d[10] ) == 11)
+    {
+        int i;
+        guid->Data1 = d[0];
+        guid->Data2 = d[1];
+        guid->Data3 = d[2];
+        for (i = 0; i < 8; i++) guid->Data4[i] = d[3 + i];
+    }
+}
+
+static NTSTATUS get_disk_info( void *args )
+{
+    const struct get_disk_info_params *params = args;
+    struct disk_info *info = params->info;
+    char sys[PATH_MAX + 64], real[PATH_MAX], disk[PATH_MAX], devpath[PATH_MAX], buf[256];
+    struct stat st;
+    unsigned int maj, min;
+    FILE *f;
+
+    memset( info, 0, sizeof(*info) );
+    if (params->unix_device)
+    {
+        if (stat( params->unix_device, &st ) == -1 || !S_ISBLK( st.st_mode )) return STATUS_NO_SUCH_DEVICE;
+        maj = major( st.st_rdev );
+        min = minor( st.st_rdev );
+    }
+    else if (params->unix_mount)
+    {
+        char *path = params->unix_mount[0] == '/' ? strdup( params->unix_mount )
+                                                  : get_dosdevices_path( params->unix_mount );
+        int ret = path ? stat( path, &st ) : -1;
+        free( path );
+        if (ret == -1 || !major( st.st_dev )) return STATUS_NO_SUCH_DEVICE;  /* no block device under it */
+        maj = major( st.st_dev );
+        min = minor( st.st_dev );
+    }
+    else return STATUS_NO_SUCH_DEVICE;
+
+    snprintf( sys, sizeof(sys), "/sys/dev/block/%u:%u", maj, min );
+    if (!realpath( sys, real )) return STATUS_NO_SUCH_DEVICE;
+    snprintf( disk, sizeof(disk), "%s", real );
+    if ((info->partition_number = read_sys_ulonglong( real, "partition" )))
+    {
+        info->is_partition = TRUE;
+        info->partition_start = read_sys_ulonglong( real, "start" ) * 512;
+        info->partition_size = read_sys_ulonglong( real, "size" ) * 512;
+        *strrchr( disk, '/' ) = 0;
+    }
+    else
+    {
+        info->partition_size = read_sys_ulonglong( real, "size" ) * 512;
+        follow_slaves( disk, sizeof(disk) );
+    }
+    info->disk_size = read_sys_ulonglong( disk, "size" ) * 512;
+    if (!info->partition_size) info->partition_size = info->disk_size;
+    info->sector_size = read_sys_ulonglong( disk, "queue/logical_block_size" );
+    info->physical_sector_size = read_sys_ulonglong( disk, "queue/physical_block_size" );
+    if (!info->sector_size) info->sector_size = 512;
+    if (!info->physical_sector_size) info->physical_sector_size = info->sector_size;
+    info->rotational = read_sys_ulonglong( disk, "queue/rotational" ) != 0;
+    info->removable = read_sys_ulonglong( disk, "removable" ) != 0;
+    if (!read_sys_string( disk, "device/vendor", info->vendor, sizeof(info->vendor) )) info->vendor[0] = 0;
+    if (!read_sys_string( disk, "device/model", info->model, sizeof(info->model) ) &&
+        !read_sys_string( disk, "device/name", info->model, sizeof(info->model) ))
+        info->model[0] = 0;
+    if (!read_sys_string( disk, "device/rev", info->revision, sizeof(info->revision) ) &&
+        !read_sys_string( disk, "device/firmware_rev", info->revision, sizeof(info->revision) ))
+        info->revision[0] = 0;
+
+    /* the bus, from where the disk hangs */
+    snprintf( sys, sizeof(sys), "%s/device", disk );
+    if (!realpath( sys, devpath )) devpath[0] = 0;
+    if (strstr( devpath, "/usb" )) info->bus_type = 7;          /* BusTypeUsb */
+    else if (strstr( disk, "/nvme" )) info->bus_type = 17;      /* BusTypeNvme */
+    else if (strstr( devpath, "/ata" )) info->bus_type = 11;    /* BusTypeSata */
+    else if (strstr( disk, "/mmcblk" )) info->bus_type = 12;    /* BusTypeSd */
+    else if (strstr( devpath, "/virtio" )) info->bus_type = 1;  /* BusTypeScsi, as Windows' virtio driver says */
+    else if (devpath[0]) info->bus_type = 1;                     /* BusTypeScsi */
+    else info->bus_type = 0;                                     /* BusTypeUnknown */
+
+    /* the partition table and the partition's entry, as udev read them */
+    if (info->is_partition && read_sys_string( real, "dev", buf, sizeof(buf) ))
+    {
+        snprintf( sys, sizeof(sys), "/run/udev/data/b%s", buf );
+        if ((f = fopen( sys, "r" )))
+        {
+            while (fgets( buf, sizeof(buf), f ))
+            {
+                if (!strncmp( buf, "E:ID_PART_ENTRY_TYPE=", 21 ))
+                {
+                    if (!strncmp( buf + 21, "0x", 2 )) info->mbr_type = strtoul( buf + 23, NULL, 16 );
+                    else parse_guid( buf + 21, &info->gpt_type );
+                }
+                else if (!strncmp( buf, "E:ID_PART_ENTRY_UUID=", 21 )) parse_guid( buf + 21, &info->gpt_id );
+            }
+            fclose( f );
+        }
+    }
+    if (read_sys_string( disk, "dev", buf, sizeof(buf) ))
+    {
+        snprintf( sys, sizeof(sys), "/run/udev/data/b%s", buf );
+        if ((f = fopen( sys, "r" )))
+        {
+            while (fgets( buf, sizeof(buf), f ))
+                if (!strncmp( buf, "E:ID_PART_TABLE_TYPE=gpt", 24 )) info->gpt = TRUE;
+            fclose( f );
+        }
+    }
+    return STATUS_SUCCESS;
+}
+#else
+static NTSTATUS get_disk_info( void *args )
+{
+    return STATUS_NOT_SUPPORTED;
+}
+#endif
+
 const unixlib_entry_t __wine_unix_call_funcs[] =
 {
     run_loop,
@@ -599,6 +775,7 @@ const unixlib_entry_t __wine_unix_call_funcs[] =
     write_credential,
     delete_credential,
     enumerate_credentials,
+    get_disk_info,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
--- a/dlls/mountmgr.sys/unixlib.h
+++ b/dlls/mountmgr.sys/unixlib.h
@@ -74,6 +74,35 @@ struct size_info
     ULONG bytes_per_sector;
 };
 
+/* Stained Glass OS: what the host knows of a disk and the partition on it */
+struct disk_info
+{
+    ULONGLONG disk_size;          /* bytes, the whole disk */
+    ULONGLONG partition_start;    /* bytes from the disk's start */
+    ULONGLONG partition_size;     /* bytes */
+    ULONG     partition_number;   /* 0 for a whole disk */
+    ULONG     sector_size;        /* logical */
+    ULONG     physical_sector_size;
+    ULONG     bus_type;           /* STORAGE_BUS_TYPE */
+    BOOL      rotational;
+    BOOL      removable;
+    BOOL      gpt;
+    BOOL      is_partition;
