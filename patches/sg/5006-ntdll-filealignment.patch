From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Answer FileAlignmentInformation.

NtQueryInformationFile answers FileAlignmentInformation with
FILE_BYTE_ALIGNMENT (files on Unix file systems need no buffer alignment),
so GetFileInformationByHandleEx(FileAlignmentInfo) works; it failed with
STATUS_NOT_IMPLEMENTED.

Gate: test/ntdll-filealign-gate.sh (64/32).
---
 dlls/ntdll/unix/file.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index f739a1f..b3bb97d 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5156,6 +5156,14 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             else if (status == STATUS_OBJECT_TYPE_MISMATCH) status = STATUS_INVALID_INFO_CLASS;
         }
         break;
+    case FileAlignmentInformation:
+        /* buffers for files on Unix file systems need no particular alignment */
+#ifndef SG_MUTANT_ALIGNMENT_NOTIMPL
+        ((FILE_ALIGNMENT_INFORMATION *)ptr)->AlignmentRequirement = FILE_BYTE_ALIGNMENT;
+#else
+        status = STATUS_NOT_IMPLEMENTED;
+#endif
+        break;
     case FileIdInformation:
         if (fd_get_file_info_h( handle, fd, options, &st, &attr ) == -1) status = errno_to_status( errno );
         else
