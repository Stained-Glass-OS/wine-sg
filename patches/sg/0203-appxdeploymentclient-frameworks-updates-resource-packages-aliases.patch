+/* ---- bundles -------------------------------------------------------------------------------- */
+
+/* How well a resource package's language fits the user's: 2 exactly, 1 by
+ * language alone ("de" for "de-AT"), 0 not at all. */
+static int language_match( const WCHAR *lang )
+{
+    WCHAR langs[1024], *p;
+    ULONG count = 0, size = ARRAY_SIZE(langs);
+    int best = 0;
+    size_t len;
+
+    if (!lang || !lang[0]) return 0;
+    if (!GetUserPreferredUILanguages( MUI_LANGUAGE_NAME, &count, langs, &size )) return 0;
+    for (p = langs; *p; p += wcslen( p ) + 1)
+    {
+        if (!wcsicmp( p, lang )) return 2;
+        len = wcscspn( p, L"-" );
+        if (wcscspn( lang, L"-" ) == len && !wcsnicmp( p, lang, len )) best = 1;
+    }
+    return best;
+}
+
+struct bundle_choice
+{
+    WCHAR *application;     /* the application package's file name */
+    WCHAR *resources[32];   /* resource packages' file names */
+    unsigned int resource_count;
+};
+
+static void bundle_choice_free( struct bundle_choice *choice )
+{
+    unsigned int i;
+    CoTaskMemFree( choice->application );
+    for (i = 0; i < choice->resource_count; i++) CoTaskMemFree( choice->resources[i] );
+    memset( choice, 0, sizeof(*choice) );
+}
+
+/* What to install from a bundle: the application package for this machine's
+ * architecture; the resource packages of the user's languages; of the scale
+ * packages, the one nearest 100. */
+static HRESULT choose_bundle_packages( IAppxBundleManifestReader *manifest, struct bundle_choice *choice, WCHAR **error_text )
+{
+    IAppxBundleManifestPackageInfoEnumerator *items = NULL;
+    IAppxBundleManifestPackageInfo *info;
+    WCHAR *best_scale = NULL;
+    int best_rank = 0, best_scale_diff = 0x7fffffff;
+    BOOL has_current;
+    HRESULT hr;
+
+    if (FAILED(hr = IAppxBundleManifestReader_GetPackageInfoItems( manifest, &items ))) return hr;
+    while (SUCCEEDED(IAppxBundleManifestPackageInfoEnumerator_GetHasCurrent( items, &has_current )) && has_current)
+    {
+        APPX_BUNDLE_PAYLOAD_PACKAGE_TYPE type;
+        IAppxManifestPackageId *id;
+        APPX_PACKAGE_ARCHITECTURE arch;
+        WCHAR *name = NULL;
+        int rank;
+
+        if (FAILED(IAppxBundleManifestPackageInfoEnumerator_GetCurrent( items, &info ))) break;
+        if (SUCCEEDED(IAppxBundleManifestPackageInfo_GetPackageType( info, &type )) &&
+            SUCCEEDED(IAppxBundleManifestPackageInfo_GetFileName( info, &name )))
+        {
+            if (type == APPX_BUNDLE_PAYLOAD_PACKAGE_TYPE_APPLICATION &&
+                SUCCEEDED(IAppxBundleManifestPackageInfo_GetPackageId( info, &id )))
+            {
+                if (SUCCEEDED(IAppxManifestPackageId_GetArchitecture( id, &arch )) &&
+                    (rank = architecture_rank( arch )) > best_rank)
+                {
+                    CoTaskMemFree( choice->application );
+                    choice->application = name;
+                    name = NULL;
+                    best_rank = rank;
+                }
+                IAppxManifestPackageId_Release( id );
+            }
+            else if (type == APPX_BUNDLE_PAYLOAD_PACKAGE_TYPE_RESOURCE)
+            {
+                IAppxManifestQualifiedResourcesEnumerator *res;
+                IAppxManifestQualifiedResource *r;
+                BOOL has_res, wanted = FALSE;
+                int scale_diff = -1;
+
+                if (SUCCEEDED(IAppxBundleManifestPackageInfo_GetResources( info, &res )))
+                {
+                    while (SUCCEEDED(IAppxManifestQualifiedResourcesEnumerator_GetHasCurrent( res, &has_res )) && has_res)
+                    {
+                        if (SUCCEEDED(IAppxManifestQualifiedResourcesEnumerator_GetCurrent( res, &r )))
+                        {
+                            WCHAR *lang = NULL;
+                            UINT32 scale = 0;
+
+                            IAppxManifestQualifiedResource_GetLanguage( r, &lang );
+                            IAppxManifestQualifiedResource_GetScale( r, &scale );
+                            if (language_match( lang )) wanted = TRUE;
+                            if (scale) scale_diff = abs( (int)scale - 100 );
+                            CoTaskMemFree( lang );
+                            IAppxManifestQualifiedResource_Release( r );
+                        }
+                        IAppxManifestQualifiedResourcesEnumerator_MoveNext( res, &has_res );
+                    }
+                    IAppxManifestQualifiedResourcesEnumerator_Release( res );
+                }
+                if (wanted && choice->resource_count < ARRAY_SIZE(choice->resources))
+                {
+                    choice->resources[choice->resource_count++] = name;
+                    name = NULL;
+                }
+                else if (scale_diff >= 0 && scale_diff < best_scale_diff)
+                {
+                    CoTaskMemFree( best_scale );
+                    best_scale = name;
+                    name = NULL;
+                    best_scale_diff = scale_diff;
+                }
+            }
+        }
+        CoTaskMemFree( name );
+        IAppxBundleManifestPackageInfo_Release( info );
+        IAppxBundleManifestPackageInfoEnumerator_MoveNext( items, &has_current );
+    }
+    IAppxBundleManifestPackageInfoEnumerator_Release( items );
+    if (best_scale)
+    {
+        if (choice->resource_count < ARRAY_SIZE(choice->resources)) choice->resources[choice->resource_count++] = best_scale;
+        else CoTaskMemFree( best_scale );
+    }
+    if (!choice->application)
+    {
+        set_error( error_text, L"The bundle has no package for this machine's architecture", NULL );
+        return 0x80073cf3; /* ERROR_INSTALL_RESOLVE_DEPENDENCY_FAILED */
+    }
+    return S_OK;
+}
