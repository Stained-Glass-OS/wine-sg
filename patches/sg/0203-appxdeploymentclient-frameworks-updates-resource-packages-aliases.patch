-/* ---- bundles -------------------------------------------------------------------- */
+
+/* ---- the records ------------------------------------------------------------------ */
+
+typedef BOOL (*record_func)( struct package_record *rec, void *context );
+
+/* Calls func for each deployed package of the user until it returns FALSE. */
+static void for_each_record( record_func func, void *context )
+{
+    WCHAR full_name[256];
+    DWORD len, index = 0;
+    HKEY root, key;
+    BOOL more = TRUE;
+
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, packages_keyW, 0, KEY_READ, &root )) return;
+    while (more && (len = ARRAY_SIZE(full_name), !RegEnumKeyExW( root, index++, full_name, &len, NULL, NULL, NULL, NULL )))
+    {
+        struct package_record rec;
+
+        if (RegOpenKeyExW( root, full_name, 0, KEY_READ, &key )) continue;
+        if (read_record( key, full_name, &rec ))
+        {
+            more = func( &rec, context );
+            package_record_free( &rec );
+        }
+        RegCloseKey( key );
+    }
+    RegCloseKey( root );
+}
+
+static BOOL open_record( const WCHAR *full_name, struct package_record *rec, HKEY *out )
+{
+    WCHAR path[MAX_PATH];
+    HKEY key;
+
+    if (!full_name || !full_name[0] || wcschr( full_name, '\\' ) || wcslen( full_name ) > 200) return FALSE;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, full_name );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &key )) return FALSE;
+    if (!read_record( key, full_name, rec ))
+    {
+        RegCloseKey( key );
+        return FALSE;
+    }
+    if (out) *out = key;
+    else RegCloseKey( key );
+    return TRUE;
+}
+
+/* ---- app execution aliases ----------------------------------------------------------- */
+
+/* The alias file's format is wine/appexeclink.h's. */
+static const WCHAR appexeclink_magic[] = APPEXECLINK_MAGIC;
+
+static HRESULT windows_apps_dir( WCHAR *dir, size_t size )
+{
+    if (FAILED(SHGetFolderPathW( NULL, CSIDL_LOCAL_APPDATA | CSIDL_FLAG_CREATE, NULL, SHGFP_TYPE_CURRENT, dir )) ||
+        wcslen( dir ) + 24 >= size)
+        return E_FAIL;
+    wcscat( dir, L"\\Microsoft\\WindowsApps" );
+    SHCreateDirectoryExW( NULL, dir, NULL );
+    return S_OK;
+}
