+/* A REG_MULTI_SZ as a list of NUL-terminated strings ending in an empty one. */
+static WCHAR *reg_multi( HKEY key, const WCHAR *name )
+{
+    DWORD size = 0;
+    WCHAR *value;
+
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_MULTI_SZ, NULL, NULL, &size )) return NULL;
+    if (!(value = calloc( 1, size + 2 * sizeof(WCHAR) ))) return NULL;
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_MULTI_SZ, NULL, value, &size ))
+    {
+        free( value );
+        return NULL;
+    }
+    return value;
+}
+
+/* A growing REG_MULTI_SZ. */
+struct strlist
+{
+    WCHAR *data;
+    DWORD len;    /* characters, without the list's final NUL */
+};
+
+static void strlist_add( struct strlist *list, const WCHAR *str )
+{
+    DWORD len = wcslen( str ) + 1;
+    WCHAR *grown;
+
+    if (!(grown = realloc( list->data, (list->len + len + 1) * sizeof(WCHAR) ))) return;
+    list->data = grown;
+    memcpy( list->data + list->len, str, len * sizeof(WCHAR) );
+    list->len += len;
+    list->data[list->len] = 0;
+}
+
+static BOOL multi_contains( const WCHAR *multi, const WCHAR *str )
+{
+    for (; multi && *multi; multi += wcslen( multi ) + 1) if (!wcsicmp( multi, str )) return TRUE;
+    return FALSE;
+}
+
+static void reg_set_multi( HKEY key, const WCHAR *name, const struct strlist *list )
+{
+    if (list && list->data) RegSetValueExW( key, name, 0, REG_MULTI_SZ, (const BYTE *)list->data, (list->len + 1) * sizeof(WCHAR) );
+}
+
