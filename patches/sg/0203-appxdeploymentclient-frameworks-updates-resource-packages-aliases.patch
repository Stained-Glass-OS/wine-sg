+static void create_aliases( IAppxManifestReader *manifest, const struct package_record *rec, struct strlist *list )
+{
+    WCHAR dir[MAX_PATH], family_dir[MAX_PATH], path[MAX_PATH], target[MAX_PATH], aumid[512];
+    WCHAR *app_id = NULL, *exe = NULL;
+    IXmlReader *reader = NULL;
+    IStream *stream = NULL;
+    XmlNodeType type;
+    UINT app_depth = 0;
+    BOOL made = FALSE;
+
+    if (FAILED(IAppxManifestReader_GetStream( manifest, &stream ))) return;
+    if (FAILED(windows_apps_dir( dir, ARRAY_SIZE(dir) )) ||
+        FAILED(CreateXmlReader( &IID_IXmlReader, (void **)&reader, NULL )))
+        goto done;
+    IXmlReader_SetProperty( reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit );
+    if (FAILED(IXmlReader_SetInput( reader, (IUnknown *)stream ))) goto done;
+    swprintf( family_dir, ARRAY_SIZE(family_dir), L"%s\\%s", dir, rec->family_name );
+
+    while (IXmlReader_Read( reader, &type ) == S_OK)
+    {
+        const WCHAR *name, *value;
+        UINT depth;
+
+        if (type != XmlNodeType_Element) continue;
+        IXmlReader_GetLocalName( reader, &name, NULL );
+        IXmlReader_GetDepth( reader, &depth );
+        if (depth <= app_depth) app_depth = 0;
+        if (depth == 2 && !wcscmp( name, L"Application" ))
+        {
+            free( app_id );
+            free( exe );
+            app_id = exe = NULL;
+            if (IXmlReader_MoveToAttributeByName( reader, L"Id", NULL ) == S_OK &&
+                SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL ))) app_id = wcsdup( value );
+            if (IXmlReader_MoveToAttributeByName( reader, L"Executable", NULL ) == S_OK &&
+                SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL ))) exe = wcsdup( value );
+            IXmlReader_MoveToElement( reader );
+            app_depth = depth;
+            continue;
+        }
+        if (!app_depth || !app_id || !exe || wcscmp( name, L"ExecutionAlias" )) continue;
+        /* the alias attribute has no namespace (uap5:ExecutionAlias Alias=, desktop:ExecutionAlias Alias=) */
+        if (IXmlReader_MoveToAttributeByName( reader, L"Alias", NULL ) != S_OK ||
+            FAILED(IXmlReader_GetValue( reader, &value, NULL )))
+            continue;
+        if (!valid_alias( value ) || !payload_path( rec->install_location, exe, target, ARRAY_SIZE(target) ))
+        {
+            WARN( "refusing alias %s for %s\n", debugstr_w( value ), debugstr_w( exe ) );
+            continue;
+        }
+        swprintf( aumid, ARRAY_SIZE(aumid), L"%s!%s", rec->family_name, app_id );
+        swprintf( path, ARRAY_SIZE(path), L"%s\\%s", dir, value );
+        if (write_alias( path, rec->family_name, aumid, target ))
+        {
+            strlist_add( list, path );
+            made = TRUE;
+            TRACE( "alias %s -> %s\n", debugstr_w( path ), debugstr_w( target ) );
+        }
+        CreateDirectoryW( family_dir, NULL );
+        swprintf( path, ARRAY_SIZE(path), L"%s\\%s", family_dir, value );
+        if (write_alias( path, rec->family_name, aumid, target )) strlist_add( list, path );
+    }
+    if (made) windows_apps_on_path();
+
+done:
+    free( app_id );
+    free( exe );
+    if (reader) IXmlReader_Release( reader );
+    IStream_Release( stream );
+}
