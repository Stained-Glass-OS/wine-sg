+/* ---- AddPackageAsync ----------------------------------------------------------------------- */
+
+/* An http: or https: location is downloaded to a temporary file first. */
+static HRESULT fetch( const WCHAR *location, WCHAR *path, size_t size, BOOL *temporary, WCHAR **error_text )
+{
+    WCHAR dir[MAX_PATH];
+    HRESULT hr;
+
+    *temporary = FALSE;
+    if (wcsnicmp( location, L"http://", 7 ) && wcsnicmp( location, L"https://", 8 ))
+    {
+        if (wcslen( location ) >= size) return E_INVALIDARG;
+        wcscpy( path, location );
+        return S_OK;
+    }
+    if (size < MAX_PATH || !GetTempPathW( ARRAY_SIZE(dir), dir ) || !GetTempFileNameW( dir, L"msx", 0, path ))
+        return HRESULT_FROM_WIN32( GetLastError() );
+    *temporary = TRUE;
+    TRACE( "downloading %s to %s\n", debugstr_w( location ), debugstr_w( path ) );
+    if (FAILED(hr = URLDownloadToFileW( NULL, location, path, 0, NULL )))
+    {
+        set_error( error_text, L"The package could not be downloaded", location );
+        DeleteFileW( path );
+        *temporary = FALSE;
+    }
+    return hr;
+}
+
+/* One package or bundle file: verified, then installed. */
+static HRESULT add_one( const WCHAR *location, DeploymentOptions options, WCHAR **error_text )
+{
+    IAppxFactory *factory = NULL;
+    IAppxPackageReader *reader = NULL;
+    IStream *stream = NULL;
+    WCHAR path[MAX_PATH];
+    BOOL temporary;
+    HRESULT hr;
+
+    TRACE( "location %s, options %#x\n", debugstr_w( location ), options );
+
+    if (FAILED(hr = fetch( location, path, ARRAY_SIZE(path), &temporary, error_text ))) return hr;
+    if (FAILED(hr = SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream )))
+    {
+        set_error( error_text, L"The package file could not be opened", location );
+        goto done;
+    }
+    if (FAILED(hr = verify_signature( path )))
+    {
+        set_error( error_text, L"The package's signature is not trusted", NULL );
+        goto done;
+    }
+    if (FAILED(hr = CoCreateInstance( &CLSID_AppxFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IAppxFactory, (void **)&factory )))
+        goto done;
+    if ((hr = IAppxFactory_CreatePackageReader( factory, stream, &reader )) == APPX_E_MISSING_REQUIRED_FILE)
+    {
+        LARGE_INTEGER zero = { 0 };
+
+        IStream_Seek( stream, zero, STREAM_SEEK_SET, NULL );
+        hr = install_bundle( factory, stream, options, error_text );
+        goto done;
+    }
+    if (FAILED(hr))
+    {
+        set_error( error_text, L"The package could not be read", NULL );
+        goto done;
+    }
+    hr = install_package( reader, options, FALSE, NULL, NULL, error_text );
+
+done:
     if (reader) IAppxPackageReader_Release( reader );
     if (factory) IAppxFactory_Release( factory );
     if (stream) IStream_Release( stream );
-    package_record_free( &rec );
+    if (temporary) DeleteFileW( path );
     return hr;
 }
 
+/* The list is the package, then the packages given for it to depend on --
+ * which are installed first. */
+HRESULT add_package_work( const WCHAR *list, DeploymentOptions options, WCHAR **error_text )
+{
+    const WCHAR *dep;
+    HRESULT hr;
+
+    for (dep = list + wcslen( list ) + 1; *dep; dep += wcslen( dep ) + 1)
+        if (FAILED(hr = add_one( dep, options, error_text ))) return hr;
+    return add_one( list, options, error_text );
+}
