+/* A bundle payload package's reader. The bundle's signature (already
+ * verified) covers it: its block map lists every package in the bundle, and
+ * reading it checks it against that. */
+static HRESULT open_payload( IAppxFactory *factory, IAppxBundleReader *bundle, const WCHAR *name, IAppxPackageReader **reader )
+{
+    IAppxFile *file;
+    IStream *stream;
+    HRESULT hr;
+
+    if (FAILED(hr = IAppxBundleReader_GetPayloadPackage( bundle, name, &file ))) return hr;
+    if (SUCCEEDED(hr = IAppxFile_GetStream( file, &stream )))
+    {
+        hr = IAppxFactory_CreatePackageReader( factory, stream, reader );
+        IStream_Release( stream );
+    }
+    IAppxFile_Release( file );
+    return hr;
+}
+
+static HRESULT install_bundle( IAppxFactory *factory, IStream *stream, DeploymentOptions options, WCHAR **error_text )
+{
+    struct bundle_choice choice = { 0 };
+    struct strlist resources = { 0 };
+    IAppxBundleManifestReader *manifest = NULL;
+    IAppxBundleFactory *bundle_factory = NULL;
+    IAppxBundleReader *bundle = NULL;
+    IAppxPackageReader *reader;
+    unsigned int i;
+    HRESULT hr;
+
+    if (FAILED(hr = CoCreateInstance( &CLSID_AppxBundleFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IAppxBundleFactory,
+                                      (void **)&bundle_factory ))) goto done;
+    if (FAILED(hr = IAppxBundleFactory_CreateBundleReader( bundle_factory, stream, &bundle )))
+    {
+        set_error( error_text, L"The bundle could not be read", NULL );
+        goto done;
+    }
+    if (FAILED(hr = IAppxBundleReader_GetManifest( bundle, &manifest ))) goto done;
+    if (FAILED(hr = choose_bundle_packages( manifest, &choice, error_text ))) goto done;
+
+    /* the resource packages first, so the application's record can name them */
+    for (i = 0; i < choice.resource_count; i++)
+    {
+        WCHAR *name = NULL;
+
+        TRACE( "installing resource package %s from the bundle\n", debugstr_w( choice.resources[i] ) );
+        if (FAILED(hr = open_payload( factory, bundle, choice.resources[i], &reader )))
+        {
+            set_error( error_text, L"A resource package in the bundle could not be read", choice.resources[i] );
+            goto done;
+        }
+        hr = install_package( reader, options | DeploymentOptions_ForceUpdateFromAnyVersion, TRUE, NULL, &name, error_text );
+        IAppxPackageReader_Release( reader );
+        if (FAILED(hr)) goto done;
+        strlist_add( &resources, name );
+        free( name );
+    }
+    TRACE( "installing %s from the bundle\n", debugstr_w( choice.application ) );
+    if (FAILED(hr = open_payload( factory, bundle, choice.application, &reader )))
+    {
+        set_error( error_text, L"The bundle's package could not be read", choice.application );
+        goto done;
+    }
+    hr = install_package( reader, options, FALSE, &resources, NULL, error_text );
+    IAppxPackageReader_Release( reader );
+
+done:
+    if (FAILED(hr))
+    {
+        WCHAR *p;
+        for (p = resources.data; p && *p; p += wcslen( p ) + 1) remove_record( p, NULL );
+    }
+    free( resources.data );
+    bundle_choice_free( &choice );
+    if (manifest) IAppxBundleManifestReader_Release( manifest );
+    if (bundle) IAppxBundleReader_Release( bundle );
+    if (bundle_factory) IAppxBundleFactory_Release( bundle_factory );
+    return hr;
+}
