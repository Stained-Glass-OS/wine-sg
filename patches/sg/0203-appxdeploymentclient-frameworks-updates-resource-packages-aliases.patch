+        len = wcslen( arg ) + 1;
+        if (!(grown = realloc( list, (used + len + 1) * sizeof(WCHAR) ))) { hr = E_OUTOFMEMORY; break; }
+        list = grown;
+        memcpy( list + used, arg, len * sizeof(WCHAR) );
