-            NtGdiDeleteObjectApp( ret );
-            ret = prev;
-        }
+        if (!(ret = create_menu_font( bold ))) return 0;
+        if (bold) menu_font_bold = ret; else menu_font = ret;
     }
     return ret;
 }
