     if (awareness == DPI_AWARENESS_UNAWARE) return USER_DEFAULT_SCREEN_DPI;
+    if (awareness == DPI_AWARENESS_SYSTEM_AWARE) return system_aware_dpi( context );
     return system_dpi;
 }
 
