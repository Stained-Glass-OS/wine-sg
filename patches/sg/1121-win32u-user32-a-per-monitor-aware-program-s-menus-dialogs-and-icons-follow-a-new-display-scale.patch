+static HFONT create_menu_font( BOOL bold )
+{
+    NONCLIENTMETRICSW ncm;
+
+    ncm.cbSize = sizeof(NONCLIENTMETRICSW);
+    NtUserSystemParametersInfo( SPI_GETNONCLIENTMETRICS, sizeof(NONCLIENTMETRICSW), &ncm, 0 );
+
+    if (bold)
+    {
+        ncm.lfMenuFont.lfWeight += 300;
+        if (ncm.lfMenuFont.lfWeight > 1000) ncm.lfMenuFont.lfWeight = 1000;
+    }
+    return NtGdiHfontCreate( &ncm.lfMenuFont, sizeof(ncm.lfMenuFont), 0, 0, NULL );
+}
+
+#ifndef SG_MUTANT_MENU_FONT_ONCE
+/* Stained Glass OS: the menu font at the DPI the menu is laid out at -- a
+ * per-monitor v2 window's menu bar at its DPI (0890), a per-monitor aware
+ * program's menus after a new display scale (follow_display_scale). It was
+ * made once for the process: menus stayed at the scale it started at. */
 static HFONT get_menu_font( BOOL bold )
 {
-    static HFONT menu_font, menu_font_bold;
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    static struct { UINT dpi; HFONT font[2]; } fonts[8];
+    UINT dpi = get_system_dpi();
+    HFONT ret = 0;
+    int i;
 
+    pthread_mutex_lock( &lock );
+    for (i = 0; i < ARRAY_SIZE(fonts) && fonts[i].dpi; i++)
+        if (fonts[i].dpi == dpi) break;
+    if (i == ARRAY_SIZE(fonts)) i = ARRAY_SIZE(fonts) - 1;  /* (eight scales: the last slot is reused) */
+    if (fonts[i].dpi != dpi) fonts[i].dpi = dpi, fonts[i].font[0] = fonts[i].font[1] = 0;
+    if (!(ret = fonts[i].font[!!bold])) ret = fonts[i].font[!!bold] = create_menu_font( bold );
+    pthread_mutex_unlock( &lock );
+    return ret;
+}
+#else
+static HFONT get_menu_font( BOOL bold )
+{
+    static HFONT menu_font, menu_font_bold;
     HFONT ret = bold ? menu_font_bold : menu_font;
 
