+/* Stained Glass OS: a system-aware context's own DPI -- the system DPI when
+ * it was made: a per-monitor aware process's system DPI follows a new display
+ * scale (follow_display_scale), the windows its threads made aware of the
+ * system DPI before keep theirs */
+static UINT system_aware_dpi( UINT context )
+{
+    UINT dpi = NTUSER_DPI_CONTEXT_GET_DPI( context );
+    return dpi ? dpi : system_dpi;
+}
