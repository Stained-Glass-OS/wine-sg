     return prev;
 }
 
+/* Stained Glass OS: the display scale changed while the process runs. A
+ * process aware of each monitor's DPI (per-monitor v1 or v2) lays itself
+ * out at its windows' new DPI; what Wine draws for it -- its menus, message
+ * boxes, dialogs, the common controls, the icons and cursors it loads --
+ * goes by the system DPI, which on Windows stays the one the process
+ * started with while the system scales those per monitor. Wine does not,
+ * so they came up at the old scale: tiny after 100% -> 175%. On our one
+ * display the system DPI of such a process is the monitor's: it follows.
+ * A process that is not per-monitor aware keeps its DPI (Wine scales it). */
+BOOL system_dpi_follows_scale(void)
+{
+#ifndef SG_MUTANT_SYSDPI_FIXED
+    return NTUSER_DPI_CONTEXT_IS_MONITOR_AWARE( NtUserGetProcessDpiAwarenessContext( NULL ) );
+#else
+    return FALSE;
+#endif
+}
+
+void follow_display_scale( UINT dpi )
+{
+#ifndef SG_MUTANT_SYSDPI_FIXED
+    if (!NTUSER_DPI_CONTEXT_IS_MONITOR_AWARE( NtUserGetProcessDpiAwarenessContext( NULL ) )) return;
+    if (!dpi || dpi == system_dpi) return;
+    TRACE( "system dpi %u -> %u\n", system_dpi, dpi );
+    system_dpi = dpi;
+    system_dpi_followed = TRUE;
+#endif
+}
+
 /* keep in sync with user32 */
 UINT set_thread_dpi_awareness_context( UINT context )
 {
@@ -4382,7 +4430,7 @@ BOOL WINAPI NtUserGetDpiForMonitor( HMONITOR monitor, UINT type, UINT *x, UINT *
     switch (NTUSER_DPI_CONTEXT_GET_AWARENESS( get_thread_dpi_awareness_context() ))
     {
     case DPI_AWARENESS_UNAWARE:      *x = *y = USER_DEFAULT_SCREEN_DPI; break;
-    case DPI_AWARENESS_SYSTEM_AWARE: *x = *y = system_dpi; break;
+    case DPI_AWARENESS_SYSTEM_AWARE: *x = *y = system_aware_dpi( get_thread_dpi_awareness_context() ); break;
     default:                         get_monitor_dpi( monitor, type, x, y ); break;
     }
     return TRUE;
