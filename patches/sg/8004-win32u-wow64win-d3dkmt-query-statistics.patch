From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, wow64win: D3DKMTQueryStatistics.

GPU monitors (System Informer, Process Explorer, Task Manager-like tools) read an adapter's memory
segments and engines with D3DKMTQueryStatistics, a stub that filled in nothing and returned
success. The adapter, found by its LUID, has its Vulkan memory heaps as segments (device-local
first; the others are aperture segments): commit limit = heap size, committed/resident = this
process's usage from VK_EXT_memory_budget; one node and one VidPN source; per-process queries
need a process handle (another process's usage is not known: 0); a segment, node or source past
the last, an unknown LUID or type are STATUS_INVALID_PARAMETER. Running times and packet counts
stay 0. The WoW64 thunk converts the 32-bit structure (hProcess shifts what follows by 8 bytes).
---
diff --git a/dlls/win32u/d3dkmt.c b/dlls/win32u/d3dkmt.c
index d31583a..0829c71 100644
--- a/dlls/win32u/d3dkmt.c
+++ b/dlls/win32u/d3dkmt.c
@@ -589,10 +589,106 @@ NTSTATUS WINAPI NtGdiDdDDIQueryAdapterInfo( D3DKMT_QUERYADAPTERINFO *desc )
 /******************************************************************************
  *           NtGdiDdDDIQueryStatistics    (win32u.@)
  */
+/* Stained Glass OS: the statistics GPU monitors read (System Informer, Process Explorer, Task
+ * Manager-like tools). An adapter's memory segments are its Vulkan memory heaps, the device-local
+ * ones first; the others are aperture segments (system memory the GPU reaches). VK_EXT_memory_budget
+ * gives each heap's size and this process's usage. There is one node (engine) and one VidPN source;
+ * running times and packet counts are not known and stay 0. */
+static NTSTATUS query_statistics( D3DKMT_QUERYSTATISTICS *stats )
+{
+    VkPhysicalDeviceMemoryBudgetPropertiesEXT budget = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT };
+    VkPhysicalDeviceMemoryProperties2 props = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2, .pNext = &budget };
+    UINT heaps[VK_MAX_MEMORY_HEAPS], count = 0, i, id;
+    BOOL other_process = FALSE;
+    VkPhysicalDevice device;
+    GUID uuid;
+
+    if (!d3dkmt_use_vulkan() || !get_vulkan_uuid_from_luid( &stats->AdapterLuid, &uuid ) ||
+        !(device = get_vulkan_physical_device( &uuid )))
+        return STATUS_INVALID_PARAMETER;
+
+    switch (stats->Type)
+    {
+    case D3DKMT_QUERYSTATISTICS_PROCESS:
+    case D3DKMT_QUERYSTATISTICS_PROCESS_ADAPTER:
+    case D3DKMT_QUERYSTATISTICS_PROCESS_SEGMENT:
+    case D3DKMT_QUERYSTATISTICS_PROCESS_NODE:
+    case D3DKMT_QUERYSTATISTICS_PROCESS_VIDPNSOURCE:
+    {
+        PROCESS_BASIC_INFORMATION pbi;
+        if (!stats->hProcess) return STATUS_INVALID_PARAMETER;
+        if (NtQueryInformationProcess( stats->hProcess, ProcessBasicInformation, &pbi, sizeof(pbi), NULL ))
+            return STATUS_INVALID_PARAMETER;
+        other_process = pbi.UniqueProcessId != GetCurrentProcessId();
+        break;
+    }
+    default:
+        break;
+    }
+
+    pvkGetPhysicalDeviceMemoryProperties2KHR( device, &props );
+    for (i = 0; i < props.memoryProperties.memoryHeapCount; i++)
+        if (props.memoryProperties.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) heaps[count++] = i;
+    for (i = 0; i < props.memoryProperties.memoryHeapCount; i++)
+        if (!(props.memoryProperties.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)) heaps[count++] = i;
+
+    memset( &stats->QueryResult, 0, sizeof(stats->QueryResult) );
+    switch (stats->Type)
+    {
+    case D3DKMT_QUERYSTATISTICS_ADAPTER:
+        stats->QueryResult.AdapterInformation.NbSegments = count;
+        stats->QueryResult.AdapterInformation.NodeCount = 1;
+        stats->QueryResult.AdapterInformation.VidPnSourceCount = 1;
+        return STATUS_SUCCESS;
+    case D3DKMT_QUERYSTATISTICS_PROCESS:
+        stats->QueryResult.ProcessInformation.NodeCount = 1;
+        stats->QueryResult.ProcessInformation.VidPnSourceCount = 1;
+        return STATUS_SUCCESS;
+    case D3DKMT_QUERYSTATISTICS_PROCESS_ADAPTER:
+        stats->QueryResult.ProcessAdapterInformation.NbSegments = count;
+        stats->QueryResult.ProcessAdapterInformation.NodeCount = 1;
+        stats->QueryResult.ProcessAdapterInformation.VidPnSourceCount = 1;
+        return STATUS_SUCCESS;
+    case D3DKMT_QUERYSTATISTICS_SEGMENT:
+    {
+        D3DKMT_QUERYSTATISTICS_SEGMENT_INFORMATION *info = &stats->QueryResult.SegmentInformation;
+        if ((id = stats->QuerySegment.SegmentId) >= count) return STATUS_INVALID_PARAMETER;
+        info->CommitLimit = props.memoryProperties.memoryHeaps[heaps[id]].size;
+        info->BytesCommitted = info->BytesResident = budget.heapUsage[heaps[id]];
+        info->Aperture = !(props.memoryProperties.memoryHeaps[heaps[id]].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT);
+        return STATUS_SUCCESS;
+    }
+    case D3DKMT_QUERYSTATISTICS_PROCESS_SEGMENT:
+    {
+        D3DKMT_QUERYSTATISTICS_PROCESS_SEGMENT_INFORMATION *info = &stats->QueryResult.ProcessSegmentInformation;
+        if ((id = stats->QueryProcessSegment.SegmentId) >= count) return STATUS_INVALID_PARAMETER;
+        /* the budget's usage is this process's; another process's is not known here */
+        if (!other_process) info->BytesCommitted = budget.heapUsage[heaps[id]];
+        info->MaximumWorkingSet = props.memoryProperties.memoryHeaps[heaps[id]].size;
+        return STATUS_SUCCESS;
+    }
+    case D3DKMT_QUERYSTATISTICS_NODE:
+    case D3DKMT_QUERYSTATISTICS_PROCESS_NODE:
+        if (stats->QueryNode.NodeId >= 1) return STATUS_INVALID_PARAMETER;
+        return STATUS_SUCCESS;
+    case D3DKMT_QUERYSTATISTICS_VIDPNSOURCE:
+    case D3DKMT_QUERYSTATISTICS_PROCESS_VIDPNSOURCE:
+        if (stats->QueryVidPnSource.VidPnSourceId >= 1) return STATUS_INVALID_PARAMETER;
+        return STATUS_SUCCESS;
+    default:
+        return STATUS_INVALID_PARAMETER;
+    }
+}
+
 NTSTATUS WINAPI NtGdiDdDDIQueryStatistics( D3DKMT_QUERYSTATISTICS *stats )
 {
-    FIXME( "(%p): stub\n", stats );
+    TRACE( "(%p)\n", stats );
+
+    if (!stats) return STATUS_INVALID_PARAMETER;
+#ifdef SG_MUTANT_KMT_STATS_STUB
     return STATUS_SUCCESS;
+#endif
+    return query_statistics( stats );
 }
 
 /******************************************************************************
diff --git a/dlls/wow64win/gdi.c b/dlls/wow64win/gdi.c
index b1678d4..8514a4a 100644
--- a/dlls/wow64win/gdi.c
+++ b/dlls/wow64win/gdi.c
@@ -1380,9 +1380,33 @@ NTSTATUS WINAPI wow64_NtGdiDdDDIQueryResourceInfoFromNtHandle( UINT *args )
 
 NTSTATUS WINAPI wow64_NtGdiDdDDIQueryStatistics( UINT *args )
 {
-    D3DKMT_QUERYSTATISTICS *stats = get_ptr( &args );
+    /* Stained Glass OS: hProcess is a 32-bit handle, so everything after it is 8 bytes lower in a 32-bit
+     * program's structure; the result union itself has no pointers */
+    struct
+    {
+        D3DKMT_QUERYSTATISTICS_TYPE Type;
+        LUID AdapterLuid;
+        ULONG hProcess;
+        D3DKMT_QUERYSTATISTICS_RESULT QueryResult;
+        union
+        {
+            D3DKMT_QUERYSTATISTICS_QUERY_SEGMENT QuerySegment;
+            D3DKMT_QUERYSTATISTICS_QUERY_NODE QueryNode;
+            D3DKMT_QUERYSTATISTICS_QUERY_VIDPNSOURCE QueryVidPnSource;
+        };
+    } *stats32 = get_ptr( &args );
+    D3DKMT_QUERYSTATISTICS stats;
+    NTSTATUS status;
 
-    return NtGdiDdDDIQueryStatistics( stats );
+    if (!stats32) return STATUS_INVALID_PARAMETER;
+    memset( &stats, 0, sizeof(stats) );
+    stats.Type = stats32->Type;
+    stats.AdapterLuid = stats32->AdapterLuid;
+    stats.hProcess = LongToHandle( stats32->hProcess );  /* GetCurrentProcess() is -1 */
+    stats.QueryNode = stats32->QueryNode;  /* the largest member of the union */
+    status = NtGdiDdDDIQueryStatistics( &stats );
+    stats32->QueryResult = stats.QueryResult;
+    return status;
 }
 
 NTSTATUS WINAPI wow64_NtGdiDdDDIQueryVideoMemoryInfo( UINT *args )
