From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: decoder MIME types and file extensions, SetPalette with an empty palette

Two results Wine's conformance tests record from Windows:
 - The ICO, JPEG and TIFF decoders report the MIME types and file extensions that
   Windows has, separated by commas (image/ico,image/x-icon and .ico,.icon;
   image/jpeg,image/jpe,image/jpg and .jpeg,.jpe,.jpg,.jfif,.exif; image/tiff,image/tif
   and .tiff,.tif), where the registration had one type and semicolon separated
   extensions. Programs that build file filters from them get the same list as on
   Windows.
 - IWICBitmapFrameEncode::SetPalette with a palette that was never initialized is
   WINCODEC_ERR_NOTINITIALIZED for the common (PNG, JPEG, TIFF) encoder frames.
---
--- a/dlls/windowscodecs/encoder.c
+++ b/dlls/windowscodecs/encoder.c
@@ -386,8 +386,21 @@ static HRESULT WINAPI CommonEncoderFrame_SetPalette(IWICBitmapFrameEncode *iface
     else if (This->frame_created)
         hr = WINCODEC_ERR_WRONGSTATE;
     else
-        hr = IWICPalette_GetColors(palette, 256, This->encoder_frame.palette,
-            &This->encoder_frame.num_colors);
+    {
+        UINT count = 0;
+
+        /* a palette that was not initialized has nothing to set */
+        hr = IWICPalette_GetColorCount(palette, &count);
+#ifdef SG_MUTANT_WICINFO_PALETTE_EMPTY_OK
+        if (0)
+#else
+        if (SUCCEEDED(hr) && !count)
+#endif
+            hr = WINCODEC_ERR_NOTINITIALIZED;
+        else if (SUCCEEDED(hr))
+            hr = IWICPalette_GetColors(palette, 256, This->encoder_frame.palette,
+                &This->encoder_frame.num_colors);
+    }
 
     LeaveCriticalSection(&This->parent->lock);
 
--- a/dlls/windowscodecs/regsvr.c
+++ b/dlls/windowscodecs/regsvr.c
@@ -1357,8 +1357,13 @@ static struct regsvr_decoder const decoder_list[] = {
 	"1.0.0.0",
 	&GUID_VendorMicrosoft,
 	&GUID_ContainerFormatIco,
+#ifdef SG_MUTANT_WICINFO_ICO_OLD
 	"image/vnd.microsoft.icon",
 	".ico",
+#else
+	"image/ico,image/x-icon",
+	".ico,.icon",
+#endif
 	ico_formats,
 	ico_patterns
     },
@@ -1368,8 +1373,12 @@ static struct regsvr_decoder const decoder_list[] = {
 	"1.0.0.0",
 	&GUID_VendorMicrosoft,
 	&GUID_ContainerFormatJpeg,
-	"image/jpeg",
-	".jpg;.jpeg;.jfif",
+	"image/jpeg,image/jpe,image/jpg",
+#ifdef SG_MUTANT_WICINFO_SEMICOLON
+	".jpeg;.jpe;.jpg;.jfif;.exif",
+#else
+	".jpeg,.jpe,.jpg,.jfif,.exif",
+#endif
 	jpeg_formats,
 	jpeg_patterns
     },
@@ -1401,8 +1410,8 @@ static struct regsvr_decoder const decoder_list[] = {
 	"1.0.0.0",
 	&GUID_VendorMicrosoft,
 	&GUID_ContainerFormatTiff,
-	"image/tiff",
-	".tif;.tiff",
+	"image/tiff,image/tif",
+	".tiff,.tif",
 	tiff_decode_formats,
 	tiff_patterns
     },
--- a/dlls/windowscodecs/tests/converter.c
+++ b/dlls/windowscodecs/tests/converter.c
@@ -1359,7 +1359,6 @@ static void test_set_frame_palette(IWICBitmapFrameEncode *frameencode)
     ok(hr == S_OK, "CreatePalette failed, hr=%lx\n", hr);
 
     hr = IWICBitmapFrameEncode_SetPalette(frameencode, palette);
-    todo_wine
     ok(hr == WINCODEC_ERR_NOTINITIALIZED, "Unexpected hr=%lx\n", hr);
 
     hr = IWICPalette_InitializePredefined(palette, WICBitmapPaletteTypeFixedHalftone256, FALSE);
--- a/dlls/windowscodecs/tests/info.c
+++ b/dlls/windowscodecs/tests/info.c
@@ -85,14 +85,12 @@ static void test_decoder_info(void)
         {
             &CLSID_WICIcoDecoder,
             "image/ico,image/x-icon",
-            ".ico,.icon",
-            1
+            ".ico,.icon"
         },
         {
             &CLSID_WICJpegDecoder,
             "image/jpeg,image/jpe,image/jpg",
-            ".jpeg,.jpe,.jpg,.jfif,.exif",
-            1
+            ".jpeg,.jpe,.jpg,.jfif,.exif"
         },
         {
             &CLSID_WICPngDecoder,
@@ -102,8 +100,7 @@ static void test_decoder_info(void)
         {
             &CLSID_WICTiffDecoder,
             "image/tiff,image/tif",
-            ".tiff,.tif",
-            1
+            ".tiff,.tif"
         },
         {
             &CLSID_WICDdsDecoder,
