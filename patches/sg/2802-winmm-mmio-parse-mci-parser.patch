-	    dwRet = MCIERR_CANNOT_USE_ALL;
+	    dwRet = MCI_SendCommandToAll(wMsg, dwParam1, dwParam2);
 	} else {
 	    dwRet = MCI_SendCommandFrom32(wDevID, wMsg, dwParam1, dwParam2);
 	}
