+/**************************************************************************
+ * 				MCI_GetLiveDriver		[internal]
+ *
+ * Like MCI_GetDriver, but a device that was opened implicitly for a command
+ * and has finished (stopped) is closed and reported as not open, as if it
+ * had closed itself.
+ */
+static LPWINE_MCIDRIVER MCI_GetLiveDriver(UINT wDevID)
+{
+    LPWINE_MCIDRIVER wmd = MCI_GetDriver(wDevID);
+    MCI_STATUS_PARMS status;
+
+    if (wmd && wmd->auto_opened) {
+	memset(&status, 0, sizeof(status));
+	status.dwItem = MCI_STATUS_MODE;
+	if (!LOWORD(MCI_SendCommandFrom32(wDevID, MCI_STATUS, MCI_STATUS_ITEM, (DWORD_PTR)&status)) &&
+	    status.dwReturn == MCI_MODE_STOP) {
+	    MCI_SendCommand(wDevID, MCI_CLOSE, 0, 0);
+	    wmd = NULL;
+	}
+    }
+    return wmd;
+}
