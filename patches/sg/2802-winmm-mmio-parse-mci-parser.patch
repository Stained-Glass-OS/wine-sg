+/**************************************************************************
+ * 			MCI_SendCommandToAll			[internal]
+ *
+ * "all" is only valid for the commands that make sense on every open
+ * device. When the devices answer differently the result is MCIERR_MULTIPLE,
+ * otherwise the common answer (0 when no device is open).
+ */
+static DWORD MCI_SendCommandToAll(UINT16 wMsg, DWORD_PTR dwParam1, DWORD_PTR dwParam2)
+{
+    LPWINE_MCIDRIVER	wmd;
+    MCIDEVICEID		ids[64];
+    UINT		i, n = 0;
+    DWORD		ret, res = 0;
+    BOOL		first = TRUE;
+
+    switch (wMsg) {
+#ifdef SG_MUTANT_WINMM_MCI_ALL
+    case MCI_PLAY:
+#endif
+    case MCI_PAUSE:
+    case MCI_RESUME:
+    case MCI_STOP:
+	break;
+    default:
+	return MCIERR_CANNOT_USE_ALL;
+    }
+
+    EnterCriticalSection(&WINMM_cs);
+    for (wmd = MciDrivers; wmd && n < ARRAY_SIZE(ids); wmd = wmd->lpNext)
+	ids[n++] = wmd->wDeviceID;
+    LeaveCriticalSection(&WINMM_cs);
+
+    for (i = 0; i < n; i++) {
+	ret = MCI_SendCommandFrom32(ids[i], wMsg, dwParam1, dwParam2);
+	if (first) res = ret;
+#ifndef SG_MUTANT_WINMM_MCI_MULTIPLE
+	else if (res != ret) res = MCIERR_MULTIPLE;
+#endif
+	first = FALSE;
+    }
+    return res;
+}
+
 /**************************************************************************
