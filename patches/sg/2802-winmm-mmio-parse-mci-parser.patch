+/**************************************************************************
+ * 				MCI_MatchKeyword		[internal]
+ *
+ * Compares a (possibly multi word) keyword of a command table with the start
+ * of the arguments. Any run of blanks in the arguments matches the single
+ * blank of the keyword. Returns the number of characters of args consumed, or
+ * -1 when the keyword does not match as a whole word.
+ */
+static int MCI_MatchKeyword(LPCWSTR args, LPCWSTR str, int len)
+{
+    int a = 0, i;
+
+    for (i = 0; i < len; i++) {
+	if (str[i] == ' ') {
+	    if (args[a] != ' ') return -1;
+#ifndef SG_MUTANT_WINMM_MCI_BLANKS
+	    while (args[a] == ' ') a++;
+#else
+	    a++;
+#endif
+	} else {
+	    if (towlower(args[a]) != towlower(str[i])) return -1;
+	    a++;
+	}
+    }
+    if (args[a] != '\0' && args[a] != ' ') return -1;
+    return a;
+}
+
+/* does args contain the given word (case insensitive)? */
+static BOOL MCI_HasWord(LPCWSTR args, LPCWSTR word)
+{
+    int len = lstrlenW(word);
+
+    while (*args) {
+	while (*args == ' ') args++;
+	if (!wcsnicmp(args, word, len) && (args[len] == '\0' || args[len] == ' '))
+	    return TRUE;
+	while (*args && *args != ' ') args++;
+    }
+    return FALSE;
+}
