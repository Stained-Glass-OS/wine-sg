+/* Stained Glass OS: a package installed for all users is installed as an
+ * administrator, as Windows does it: the user is asked (the consent prompt)
+ * and the installation runs elevated. It ran as the user, who may not write
+ * to Program Files or HKEY_LOCAL_MACHINE: PuTTY's installer rolled back at
+ * "put the install directory on the PATH", and installs that got through left
+ * no shortcuts (David). */
+static BOOL process_elevated(void)
+{
+    TOKEN_ELEVATION elevation = { 0 };
+    HANDLE token;
+    DWORD size;
+
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return FALSE;
+    if (!GetTokenInformation(token, TokenElevation, &elevation, sizeof(elevation), &size)) elevation.TokenIsElevated = 0;
+    CloseHandle(token);
+    return elevation.TokenIsElevated != 0;
+}
+
+static const WCHAR *property_value(const WCHAR *properties, const WCHAR *name, WCHAR *buf, DWORD len)
+{
+    const WCHAR *p = properties;
+    size_t n = wcslen(name);
+
+    while (p && (p = wcsstr(p, name)))
+    {
+        if ((p == properties || p[-1] == ' ') && p[n] == '=')
+        {
+            const WCHAR *v = p + n + 1;
+            DWORD i = 0;
+            if (*v == '"') { v++; while (*v && *v != '"' && i < len - 1) buf[i++] = *v++; }
+            else while (*v && *v != ' ' && i < len - 1) buf[i++] = *v++;
+            buf[i] = 0;
+            return buf;
+        }
+        p += n;
+    }
+    return NULL;
+}
+
+static BOOL package_for_all_users(const WCHAR *package, const WCHAR *properties)
+{
+    WCHAR allusers[16] = L"", peruser[16] = L"";
+    MSIHANDLE db, view, rec, suminfo;
+    DWORD len;
+    INT words = 0;
+
+    if (IsProductCode((WCHAR *)package))
+    {
+        WCHAR state[16];
+        len = ARRAY_SIZE(state);
+        return MsiGetProductInfoExW(package, NULL, MSIINSTALLCONTEXT_MACHINE, INSTALLPROPERTY_PRODUCTSTATEW,
+                                    state, &len) == ERROR_SUCCESS;
+    }
+    if (MsiOpenDatabaseW(package, MSIDBOPEN_READONLY, &db) != ERROR_SUCCESS) return FALSE;
+    /* a package that says it needs no elevation (the summary's word count, 8) */
+    if (MsiGetSummaryInformationW(db, NULL, 0, &suminfo) == ERROR_SUCCESS)
+    {
+        MsiSummaryInfoGetPropertyW(suminfo, PIDSI_WORDCOUNT, NULL, &words, NULL, NULL, NULL);
+        MsiCloseHandle(suminfo);
+    }
+    if (MsiDatabaseOpenViewW(db, L"SELECT `Property`, `Value` FROM `Property`", &view) == ERROR_SUCCESS)
+    {
+        MsiViewExecute(view, 0);
+        while (MsiViewFetch(view, &rec) == ERROR_SUCCESS)
+        {
+            WCHAR name[64], value[16];
+            DWORD nlen = ARRAY_SIZE(name), vlen = ARRAY_SIZE(value);
+            if (MsiRecordGetStringW(rec, 1, name, &nlen) == ERROR_SUCCESS &&
+                MsiRecordGetStringW(rec, 2, value, &vlen) == ERROR_SUCCESS)
+            {
+                if (!wcscmp(name, L"ALLUSERS")) lstrcpynW(allusers, value, ARRAY_SIZE(allusers));
+                else if (!wcscmp(name, L"MSIINSTALLPERUSER")) lstrcpynW(peruser, value, ARRAY_SIZE(peruser));
+            }
+            MsiCloseHandle(rec);
+        }
+        MsiCloseHandle(view);
+    }
+    MsiCloseHandle(db);
+    if (words & 8) return FALSE;
+    property_value(properties, L"ALLUSERS", allusers, ARRAY_SIZE(allusers));
+    property_value(properties, L"MSIINSTALLPERUSER", peruser, ARRAY_SIZE(peruser));
+    if (!wcscmp(allusers, L"1")) return TRUE;
+    return !wcscmp(allusers, L"2") && wcscmp(peruser, L"1");
+}
+
+static DWORD run_elevated(void)
+{
+    SHELLEXECUTEINFOW sei = { sizeof(sei) };
+    const WCHAR *args = GetCommandLineW();
+    DWORD code = ERROR_INSTALL_USEREXIT;
+    BOOL quoted = FALSE;
+
+    /* the arguments after the program's name */
+    for (; *args && (quoted || (*args != ' ' && *args != '\t')); args++) if (*args == '"') quoted = !quoted;
+    while (*args == ' ' || *args == '\t') args++;
+    sei.fMask = SEE_MASK_NOCLOSEPROCESS | SEE_MASK_FLAG_NO_UI;
+    sei.lpVerb = L"runas";
+    sei.lpFile = L"msiexec.exe";
+    sei.lpParameters = args;
+    sei.nShow = SW_SHOWNORMAL;
+    WINE_TRACE("installing for all users, elevated: %s\n", wine_dbgstr_w(args));
+    if (!ShellExecuteExW(&sei) || !sei.hProcess) return ERROR_INSTALL_USEREXIT;
+    WaitForSingleObject(sei.hProcess, INFINITE);
+    GetExitCodeProcess(sei.hProcess, &code);
+    CloseHandle(sei.hProcess);
+    return code;
+}
