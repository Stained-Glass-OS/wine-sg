+
+    /* Stained Glass OS: a package installed for all users puts its shortcuts
+     * where all users see them -- the All Users profile's Start menu,
+     * desktop, startup, templates, administrative tools and application
+     * data, as Windows does for ALLUSERS=1. They went to the installing
+     * account's own profile: installed elevated, SYSTEM's, which nobody sees
+     * (David: PuTTY added no icons). */
+    if (msi_get_property_int( package->db, L"ALLUSERS", 0 ) == 1)
+    {
+        static const struct { const WCHAR *name; int csidl; } common[] =
+        {
+            { L"ProgramMenuFolder", CSIDL_COMMON_PROGRAMS },
+            { L"StartMenuFolder", CSIDL_COMMON_STARTMENU },
+            { L"StartupFolder", CSIDL_COMMON_STARTUP },
+            { L"DesktopFolder", CSIDL_COMMON_DESKTOPDIRECTORY },
+            { L"TemplateFolder", CSIDL_COMMON_TEMPLATES },
+            { L"AdminToolsFolder", CSIDL_COMMON_ADMINTOOLS },
+            { L"AppDataFolder", CSIDL_COMMON_APPDATA },
+        };
+        WCHAR pth[MAX_PATH];
+        unsigned int i;
+
+        for (i = 0; i < ARRAY_SIZE(common); i++)
+        {
+            if (FAILED(SHGetFolderPathW( NULL, common[i].csidl | CSIDL_FLAG_CREATE, NULL, 0, pth ))) continue;
+            lstrcatW( pth, L"\\" );
+            msi_set_property( package->db, common[i].name, pth, -1 );
+        }
+    }
