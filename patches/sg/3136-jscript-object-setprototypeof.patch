From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 01:10:42 -0700
Subject: [PATCH] jscript: Object.setPrototypeOf in the ES6 (document mode 11)
 mode

IE11 has Object.setPrototypeOf, none of the earlier modes. It returns the
object, refuses undefined/null objects and prototypes that are not objects or
null, and leaves primitives alone. documentmode.js checks the exposure per mode
and the behaviour.

diff --git a/dlls/jscript/object.c b/dlls/jscript/object.c
index e20f3c7..55b1da0 100644
--- a/dlls/jscript/object.c
+++ b/dlls/jscript/object.c
@@ -1050,6 +1050,40 @@ static HRESULT Object_isSealed(script_ctx_t *ctx, jsval_t vthis, WORD flags, uns
     return S_OK;
 }
 
+/* ECMA-262 6th Edition    19.1.2.18 (IE11 has it in the ES6 mode) */
+static HRESULT Object_setPrototypeOf(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc, jsval_t *argv,
+        jsval_t *r)
+{
+    jsdisp_t *jsthis, *proto = NULL;
+    HRESULT hres;
+
+    TRACE("\n");
+
+    if(argc < 2 || is_undefined(argv[0]) || is_null(argv[0]))
+        return JS_E_OBJECT_EXPECTED;
+    if(is_null(argv[1])) {
+        proto = NULL;
+    }else if(is_object_instance(argv[1])) {
+        if(!(proto = to_jsdisp(get_object(argv[1])))) {
+            FIXME("Host object value\n");
+            return E_FAIL;
+        }
+    }else
+        return JS_E_OBJECT_EXPECTED;
+
+    if(is_object_instance(argv[0]) && (jsthis = to_jsdisp(get_object(argv[0])))) {
+#ifdef SG_MUTANT_JS_NOSETPROTO
+        hres = S_OK;
+#else
+        hres = jsdisp_change_prototype(jsthis, proto);
+#endif
+        if(FAILED(hres))
+            return hres;
+    }
+
+    return r ? jsval_copy(argv[0], r) : S_OK;
+}
+
 static const builtin_prop_t ObjectConstr_props[] = {
     {L"create",                   Object_create,                      PROPF_ES5|PROPF_METHOD|2},
     {L"defineProperties",         Object_defineProperties,            PROPF_ES5|PROPF_METHOD|2},
@@ -1064,6 +1098,7 @@ static const builtin_prop_t ObjectConstr_props[] = {
     {L"keys",                     Object_keys,                        PROPF_ES5|PROPF_METHOD|1},
     {L"preventExtensions",        Object_preventExtensions,           PROPF_ES5|PROPF_METHOD|1},
     {L"seal",                     Object_seal,                        PROPF_ES5|PROPF_METHOD|1},
+    {L"setPrototypeOf",           Object_setPrototypeOf,              PROPF_ES6|PROPF_METHOD|2}
 };
 
 static const builtin_info_t ObjectConstr_info = {
diff --git a/dlls/mshtml/tests/documentmode.js b/dlls/mshtml/tests/documentmode.js
index 3ef8295..db01a1e 100644
--- a/dlls/mshtml/tests/documentmode.js
+++ b/dlls/mshtml/tests/documentmode.js
@@ -3479,6 +3479,25 @@ sync_test("array_reduceright_math", function() {
         ok(!(names[i] in Math), "Math." + names[i] + " found.");
 });
 
+sync_test("object_setprototypeof", function() {
+    var v = document.documentMode;
+    ok(("setPrototypeOf" in Object) === (v >= 11), "Object.setPrototypeOf exposed = " + ("setPrototypeOf" in Object) + " in mode " + v);
+    if(v < 11)
+        return;
+    var proto = { a: 1 }, o = {};
+    ok(Object.setPrototypeOf(o, proto) === o, "setPrototypeOf does not return the object");
+    ok(o.a === 1 && Object.getPrototypeOf(o) === proto, "prototype not set");
+    ok(Object.setPrototypeOf.length === 2, "length = " + Object.setPrototypeOf.length);
+    try {
+        Object.setPrototypeOf(undefined, proto);
+        ok(false, "no exception for undefined");
+    }catch(e) {}
+    try {
+        Object.setPrototypeOf(o, 5);
+        ok(false, "no exception for a number prototype");
+    }catch(e) {}
+});
+
 sync_test("initMessageEvent", function() {
     var e, v = document.documentMode;
     if(!document.createEvent)
