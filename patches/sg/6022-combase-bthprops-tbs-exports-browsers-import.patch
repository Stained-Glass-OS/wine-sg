+/***********************************************************************
+ *      IsErrorPropagationEnabled (combase.@)
+ *
+ * Stained Glass OS: error propagation is the error information kept for the caller
+ * (RO_ERROR_REPORTING_USESETERRORINFO, the default)
+ */
+BOOL WINAPI IsErrorPropagationEnabled(void)
+{
+    TRACE("\n");
+#ifdef SG_MUTANT_ERRPROP_ALWAYS
+    return TRUE;
+#endif
+    return !!(error_reporting_flags & RO_ERROR_REPORTING_USESETERRORINFO);
+}
+
+/***********************************************************************
+ *      RoReportFailedDelegate (combase.@)
+ *
+ * Stained Glass OS: a delegate (an event handler) failed; the failure is reported to a debugger
+ * as an originated error would be, and the call goes on
+ */
+HRESULT WINAPI RoReportFailedDelegate(IUnknown *delegate, IRestrictedErrorInfo *error)
+{
+    TRACE("%p, %p\n", delegate, error);
+
+    if (!delegate || !error) return E_INVALIDARG;
+    if ((error_reporting_flags & RO_ERROR_REPORTING_FORCEEXCEPTIONS) ||
+        (IsDebuggerPresent() && !(error_reporting_flags & RO_ERROR_REPORTING_SUPPRESSEXCEPTIONS)))
+    {
+        ULONG_PTR args[2] = { 0, 0 };
+
+        __TRY
+        {
+            RaiseException(EXCEPTION_RO_ORIGINATEERROR, 0, 2, args);
+        }
+        __EXCEPT_ALL
+        {
+        }
+        __ENDTRY
+    }
+    return S_OK;
+}
+
 /***********************************************************************
  *      RoGetErrorReportingFlags (combase.@)
  */
diff --git a/dlls/tbs/tbs.c b/dlls/tbs/tbs.c
index 233aeef..e2311dd 100644
--- a/dlls/tbs/tbs.c
+++ b/dlls/tbs/tbs.c
@@ -60,6 +60,29 @@ TBS_RESULT WINAPI Tbsi_GetDeviceInfo(UINT32 size, void *info)
     return TBS_E_TPM_NOT_FOUND;
 }
 
+/* Stained Glass OS: no context is ever made (there is no TPM), so none is valid */
+TBS_RESULT WINAPI Tbsip_Submit_Command(TBS_HCONTEXT context, TBS_COMMAND_LOCALITY locality,
+                                       TBS_COMMAND_PRIORITY priority, const BYTE *command, UINT32 command_size,
+                                       BYTE *result, UINT32 *result_size)
+{
+    TRACE("(%p, %u, %u, %p, %u, %p, %p)\n", context, locality, priority, command, command_size, result, result_size);
+
+    if (!command || !result || !result_size) return TBS_E_BAD_PARAMETER;
+    return TBS_E_INVALID_CONTEXT;
+}
+
+TBS_RESULT WINAPI Tbsip_Context_Close(TBS_HCONTEXT context)
+{
+    TRACE("(%p)\n", context);
+    return TBS_E_INVALID_CONTEXT;
+}
+
+TBS_RESULT WINAPI Tbsip_Cancel_Commands(TBS_HCONTEXT context)
+{
+    TRACE("(%p)\n", context);
+    return TBS_E_INVALID_CONTEXT;
+}
