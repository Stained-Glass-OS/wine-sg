index 6f8a794..660d442 100644
--- a/dlls/bluetoothapis/main.c
+++ b/dlls/bluetoothapis/main.c
@@ -671,6 +671,23 @@ BOOL WINAPI BluetoothIsConnectable(HANDLE radio)
     return radio_flag(radio, LOCAL_RADIO_CONNECTABLE);
 }
 
+/*********************************************************************
+ *  BluetoothEnableIncomingConnections
+ *
+ * Stained Glass OS: BlueZ keeps a powered radio connectable, and does not take
+ * connectability on its own: the state asked for is reported as set when the radio
+ * is in it already.
+ */
+BOOL WINAPI BluetoothEnableIncomingConnections(HANDLE radio, BOOL enable)
+{
+    TRACE("(%p, %d)\n", radio, enable);
+
+#ifdef SG_MUTANT_BTH_INCOMING_ALWAYS
+    return TRUE;
+#endif
+    return !BluetoothIsConnectable(radio) == !enable;
+}
+
