From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winspool.drv: AddPrintProvidor, UploadPrinterDriverPackage (3624)

winspool.drv: AddPrintProvidor and UploadPrinterDriverPackage

AddPrintProvidor (levels 1 and 2) needs the right to install drivers
(ERROR_ACCESS_DENIED otherwise), refuses a library that cannot be loaded, and
registers the provider under Print\Providers and in its Order list;
DeletePrintProvidor removes it from the list too. UploadPrinterDriverPackage
copies the package folder into System32\DriverStore\FileRepository and returns
the path of the .inf there (administrators only).
---
diff --git a/dlls/winspool.drv/info.c b/dlls/winspool.drv/info.c
index 3e78640..ecf9208 100644
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -838,6 +838,7 @@ static WCHAR *cups_queue_driver( const WCHAR *model, HKEY printer_key, BOOL *win
 static inline DWORD set_reg_szW( HKEY hkey, const WCHAR *keyname, const WCHAR *value );
 
 BOOL can_install_drivers( void );
+static void provider_order_update(HKEY key, const WCHAR *name, const WCHAR *after, BOOL remove);
 
 /* FALSE when a printer could not be made: the next program tries again */
 static BOOL init_unix_printers( void )
@@ -5915,13 +5916,92 @@ BOOL WINAPI AddPrintProcessorW(WCHAR *name, WCHAR *env, WCHAR *path, WCHAR *prin
     return backend->fpAddPrintProcessor(name, env, path, print_proc);
 }
 
+/*****************************************************************************
+ *          AddPrintProvidorA  [WINSPOOL.@]
+ */
+/* level 2 adds the provider after which the new one is ordered */
+typedef struct { LPWSTR pName, pEnvironment, pDLLName, pOrderAfter; } PROVIDOR_INFO_2W;
+typedef struct { LPSTR pName, pEnvironment, pDLLName, pOrderAfter; } PROVIDOR_INFO_2A;
+
+static const WCHAR providers_key[] = L"System\\CurrentControlSet\\Control\\Print\\Providers";
+
+/* The "Order" value of the Providers key lists the providers the spooler loads, in order. */
+static void provider_order_update(HKEY key, const WCHAR *name, const WCHAR *after, BOOL remove)
+{
+    DWORD type, size = 0, count = 0, i, pos = 0;
+    WCHAR *old = NULL, *out;
+    LONG res;
+
+    if (!(res = RegQueryValueExW(key, L"Order", NULL, &type, NULL, &size)) && type == REG_MULTI_SZ && size)
+    {
+        if (!(old = malloc(size + 2 * sizeof(WCHAR)))) return;
+        RegQueryValueExW(key, L"Order", NULL, &type, (BYTE *)old, &size);
+        old[size / sizeof(WCHAR)] = old[size / sizeof(WCHAR) + 1] = 0;
+    }
+    if (!(out = malloc(((old ? size / sizeof(WCHAR) : 0) + wcslen(name) + 4) * sizeof(WCHAR))))
+    {
+        free(old);
+        return;
+    }
+    for (i = 0; old && old[i]; i += wcslen(old + i) + 1)
+    {
+        size_t len = wcslen(old + i) + 1;
+        if (!wcsicmp(old + i, name)) continue;
+        memcpy(out + pos, old + i, len * sizeof(WCHAR));
+        pos += len;
+        count++;
+        if (!remove && after && !wcsicmp(old + i, after))
+        {
+            wcscpy(out + pos, name);
+            pos += wcslen(name) + 1;
+            after = NULL;
+            name = L"";
+        }
+    }
+    if (!remove && *name)
+    {
+        wcscpy(out + pos, name);
+        pos += wcslen(name) + 1;
+    }
+    out[pos++] = 0;
+    RegSetValueExW(key, L"Order", 0, REG_MULTI_SZ, (BYTE *)out, pos * sizeof(WCHAR));
+    free(out);
+    free(old);
+}
+
 /*****************************************************************************
  *          AddPrintProvidorA  [WINSPOOL.@]
  */
 BOOL WINAPI AddPrintProvidorA(LPSTR pName, DWORD Level, LPBYTE pProviderInfo)
 {
-    FIXME("(%s,0x%08lx,%p): stub\n", debugstr_a(pName), Level, pProviderInfo);
-    return FALSE;
+    PROVIDOR_INFO_2W info = {0};
+    UNICODE_STRING name, env, dll, after;
+    BOOL ret;
+
+    TRACE("(%s,0x%08lx,%p)\n", debugstr_a(pName), Level, pProviderInfo);
+
+    if (!pProviderInfo || (Level != 1 && Level != 2))
+    {
+        SetLastError(ERROR_INVALID_LEVEL);
+        return FALSE;
+    }
+    {
+        const PROVIDOR_INFO_1A *a = (const PROVIDOR_INFO_1A *)pProviderInfo;
+        asciitounicode(&name, pName);
+        asciitounicode(&env, a->pEnvironment);
+        asciitounicode(&dll, a->pDLLName);
+        if (Level == 2) asciitounicode(&after, ((const PROVIDOR_INFO_2A *)pProviderInfo)->pOrderAfter);
+        else RtlInitUnicodeString(&after, NULL);
+        info.pEnvironment = env.Buffer;
+        info.pDLLName = dll.Buffer;
+        info.pOrderAfter = after.Buffer;
+        ret = AddPrintProvidorW(name.Buffer, Level, (BYTE *)&info);
+        RtlFreeUnicodeString(&name);
+        RtlFreeUnicodeString(&env);
+        RtlFreeUnicodeString(&dll);
+        if (Level == 2) RtlFreeUnicodeString(&after);
+    }
+    return ret;
 }
 
 /*****************************************************************************
@@ -5929,8 +6009,59 @@ BOOL WINAPI AddPrintProvidorA(LPSTR pName, DWORD Level, LPBYTE pProviderInfo)
  */
 BOOL WINAPI AddPrintProvidorW(LPWSTR pName, DWORD Level, LPBYTE pProviderInfo)
 {
-    FIXME("(%s,0x%08lx,%p): stub\n", debugstr_w(pName), Level, pProviderInfo);
-    return FALSE;
+    const PROVIDOR_INFO_1W *info = (const PROVIDOR_INFO_1W *)pProviderInfo;
+    const WCHAR *name, *after = NULL;
+    WCHAR path[MAX_PATH];
+    HMODULE module;
+    HKEY providers, key;
+    LONG res;
+
+    TRACE("(%s,0x%08lx,%p)\n", debugstr_w(pName), Level, pProviderInfo);
+
+    if (!pProviderInfo || (Level != 1 && Level != 2))
+    {
+        SetLastError(ERROR_INVALID_LEVEL);
+        return FALSE;
+    }
+    if ((pName && *pName) || !info->pDLLName || !*info->pDLLName)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (info->pEnvironment && !validate_envW(info->pEnvironment)) return FALSE;
+    if (Level == 2) after = ((const PROVIDOR_INFO_2W *)pProviderInfo)->pOrderAfter;
+    if (!can_install_drivers())
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    /* the name of a provider is its library's name without the extension */
+    name = wcsrchr(info->pDLLName, '\\');
+    name = name ? name + 1 : info->pDLLName;
+    wcscpy(path, name);
+    if (wcsrchr(path, '.')) *wcsrchr(path, '.') = 0;
+    /* the spooler loads the library: one that cannot be loaded is refused */
+    if (!(module = LoadLibraryExW(info->pDLLName, NULL, DONT_RESOLVE_DLL_REFERENCES)))
+        return FALSE;
+    FreeLibrary(module);
+    if ((res = RegCreateKeyExW(HKEY_LOCAL_MACHINE, providers_key, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &providers, NULL)))
+    {
+        SetLastError(res);
+        return FALSE;
+    }
+    if ((res = RegCreateKeyExW(providers, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL)))
+    {
+        RegCloseKey(providers);
+        SetLastError(res);
+        return FALSE;
+    }
+    RegSetValueExW(key, L"Name", 0, REG_SZ, (const BYTE *)info->pDLLName, (wcslen(info->pDLLName) + 1) * sizeof(WCHAR));
+    RegCloseKey(key);
+#ifndef SG_MUTANT_PROV_ORDER
+    provider_order_update(providers, path, after, FALSE);
+#endif
+    RegCloseKey(providers);
+    return TRUE;
 }
 
