+static void test_sg_providor_and_upload(void)
+{
+    WCHAR tmp[MAX_PATH], dir[MAX_PATH], inf[MAX_PATH], dll[MAX_PATH], sys[MAX_PATH], out[MAX_PATH], order[1024];
+    PROVIDOR_INFO_1W info = {0};
+    DWORD size, type, attr;
+    ULONG len;
+    HKEY key;
+    HRESULT hr;
+    HANDLE file;
+    BOOL ret;
+
+    GetTempPathW(MAX_PATH, tmp);
+    swprintf(dir, MAX_PATH, L"%ssgpkg%lu", tmp, GetCurrentProcessId());
+    CreateDirectoryW(dir, NULL);
+    swprintf(inf, MAX_PATH, L"%s\\sgdrv.inf", dir);
+    swprintf(sys, MAX_PATH, L"%s\\sgdrv.dll", dir);
+    file = CreateFileW(inf, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+    WriteFile(file, "[Version]\r\n", 11, &size, NULL);
+    CloseHandle(file);
+    GetSystemDirectoryW(out, MAX_PATH);
+    wcscat(out, L"\\version.dll");
+    CopyFileW(out, sys, FALSE);
+
+    len = 0;
+    hr = UploadPrinterDriverPackageW(NULL, inf, NULL, 0, NULL, NULL, &len);
+    if (hr == HRESULT_FROM_WIN32(ERROR_ACCESS_DENIED))
+    {
+        skip("not an administrator\n");
+        goto done;
+    }
+    ok(hr == HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER), "got %#lx\n", hr);
+    ok(len > 1, "got %lu\n", len);
+    len = ARRAY_SIZE(out);
+    hr = UploadPrinterDriverPackageW(NULL, inf, NULL, 0, NULL, out, &len);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(len == lstrlenW(out) + 1, "got %lu\n", len);
+    attr = GetFileAttributesW(out);
+    ok(attr != INVALID_FILE_ATTRIBUTES, "stored inf missing: %s\n", wine_dbgstr_w(out));
+    wcscpy(dll, out);
+    wcscpy(wcsrchr(dll, '\\') + 1, L"sgdrv.dll");
+    ok(GetFileAttributesW(dll) != INVALID_FILE_ATTRIBUTES, "stored dll missing\n");
+    hr = UploadPrinterDriverPackageW(NULL, L"C:\\nonexistent\\x.inf", NULL, 0, NULL, out, &len);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND), "got %#lx\n", hr);
+    hr = UploadPrinterDriverPackageW(L"\\\\remote", inf, NULL, 0, NULL, out, &len);
+    ok(FAILED(hr), "got %#lx\n", hr);
+
+    info.pDLLName = (WCHAR *)L"C:\\nonexistent\\sgprov.dll";
+    SetLastError(0xdeadbeef);
+    ret = AddPrintProvidorW(NULL, 1, (BYTE *)&info);
+    ok(!ret && GetLastError() == ERROR_MOD_NOT_FOUND, "got %d %lu\n", ret, GetLastError());
+    info.pDLLName = sys;
+    ret = AddPrintProvidorW(NULL, 1, (BYTE *)&info);
+    ok(ret, "got %lu\n", GetLastError());
+    if (ret)
+    {
+        ok(!RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Print\\Providers\\sgdrv", 0,
+                KEY_READ, &key), "provider key missing\n");
+        RegCloseKey(key);
+        RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Print\\Providers", 0, KEY_READ, &key);
+        size = sizeof(order);
+        ok(!RegQueryValueExW(key, L"Order", NULL, &type, (BYTE *)order, &size) && type == REG_MULTI_SZ, "no order\n");
+        ok(order[0], "empty order\n");
+        RegCloseKey(key);
+        ret = DeletePrintProvidorW(NULL, NULL, (WCHAR *)L"sgdrv");
+        ok(ret, "got %lu\n", GetLastError());
+        ok(RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Print\\Providers\\sgdrv", 0,
+                KEY_READ, &key), "provider key still there\n");
+    }
+    ret = AddPrintProvidorW(NULL, 3, (BYTE *)&info);
+    ok(!ret && GetLastError() == ERROR_INVALID_LEVEL, "got %d %lu\n", ret, GetLastError());
+
+done:
+    DeleteFileW(inf);
+    DeleteFileW(sys);
+    RemoveDirectoryW(dir);
+}
+
 START_TEST(info)
 {
     hwinspool = LoadLibraryA("winspool.drv");
@@ -3111,6 +3188,7 @@ START_TEST(info)
