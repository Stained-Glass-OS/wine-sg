         return FALSE;
     }
     ret = RegDeleteTreeW(key, pPrintProviderName);
+    if (!ret) provider_order_update(key, pPrintProviderName, NULL, TRUE);
     RegCloseKey(key);
     if (ret)
     {
@@ -9516,26 +9648,133 @@ LPWSTR WINAPI StartDocDlgW( HANDLE hPrinter, DOCINFOW *doc )
     return ret;
 }
 
-/*****************************************************************************
- *          UploadPrinterDriverPackageA [WINSPOOL.@]
- */
-HRESULT WINAPI UploadPrinterDriverPackageA( LPCSTR server, LPCSTR path, LPCSTR env,
-                                            DWORD flags, HWND hwnd, LPSTR dst, PULONG dstlen )
+/* Copies a driver package (the folder of the .inf and everything under it) into the driver store. */
+static BOOL copy_package_tree(const WCHAR *src, const WCHAR *dst)
 {
-    FIXME("%s, %s, %s, %lx, %p, %p, %p\n", debugstr_a(server), debugstr_a(path), debugstr_a(env),
-          flags, hwnd, dst, dstlen);
-    return E_NOTIMPL;
+    WCHAR *s_pat, *s_item, *d_item;
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+    BOOL ret = TRUE;
+
+    CreateDirectoryW(dst, NULL);
+    s_pat = malloc((wcslen(src) + 3) * sizeof(WCHAR));
+    s_item = malloc((wcslen(src) + MAX_PATH + 2) * sizeof(WCHAR));
+    d_item = malloc((wcslen(dst) + MAX_PATH + 2) * sizeof(WCHAR));
+    if (!s_pat || !s_item || !d_item)
+    {
+        free(s_pat); free(s_item); free(d_item);
+        return FALSE;
+    }
+    swprintf(s_pat, wcslen(src) + 3, L"%s\\*", src);
+    if ((find = FindFirstFileW(s_pat, &fd)) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L"..")) continue;
+            swprintf(s_item, wcslen(src) + MAX_PATH + 2, L"%s\\%s", src, fd.cFileName);
+            swprintf(d_item, wcslen(dst) + MAX_PATH + 2, L"%s\\%s", dst, fd.cFileName);
+            if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) ret = copy_package_tree(s_item, d_item) && ret;
+            else ret = CopyFileW(s_item, d_item, FALSE) && ret;
+        } while (FindNextFileW(find, &fd));
+        FindClose(find);
+    }
+    free(s_pat); free(s_item); free(d_item);
+    return ret;
 }
 
 /*****************************************************************************
  *          UploadPrinterDriverPackageW [WINSPOOL.@]
+ *
+ * Copies the package to the driver store under the system directory and
+ * returns the path of its .inf there; the store entry is named after the .inf
+ * and a hash of its source folder, so uploading the same package again finds it.
  */
 HRESULT WINAPI UploadPrinterDriverPackageW( LPCWSTR server, LPCWSTR path, LPCWSTR env,
                                             DWORD flags, HWND hwnd, LPWSTR dst, PULONG dstlen )
 {
-    FIXME("%s, %s, %s, %lx, %p, %p, %p\n", debugstr_w(server), debugstr_w(path), debugstr_w(env),
+    WCHAR full[MAX_PATH], dir[MAX_PATH], store[MAX_PATH], result[MAX_PATH], *p;
+    DWORD hash = 5381, attr;
+    ULONG need;
+    BOOL exists;
+
+    TRACE("%s, %s, %s, %lx, %p, %p, %p\n", debugstr_w(server), debugstr_w(path), debugstr_w(env),
           flags, hwnd, dst, dstlen);
-    return E_NOTIMPL;
+
+    if (!path || !*path || !dstlen || (flags & ~(UPDP_SILENT_UPLOAD | UPDP_UPLOAD_ALWAYS | UPDP_CHECK_DRIVERSTORE)))
+        return HRESULT_FROM_WIN32(ERROR_INVALID_PARAMETER);
+    if (server && *server) return HRESULT_FROM_WIN32(ERROR_INVALID_PRINTER_NAME);
+    if (env && *env && !validate_envW(env)) return HRESULT_FROM_WIN32(GetLastError());
+    if (!can_install_drivers()) return HRESULT_FROM_WIN32(ERROR_ACCESS_DENIED);
+    if (!GetFullPathNameW(path, MAX_PATH, full, NULL)) return HRESULT_FROM_WIN32(GetLastError());
+    attr = GetFileAttributesW(full);
+    if (attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_DIRECTORY))
+        return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    if (!(p = wcsrchr(full, '.')) || wcsicmp(p, L".inf")) return HRESULT_FROM_WIN32(ERROR_INVALID_PARAMETER);
+
+    wcscpy(dir, full);
+    *wcsrchr(dir, '\\') = 0;
+    for (p = dir; *p; p++) hash = hash * 33 + towlower(*p);
+    GetSystemDirectoryW(store, MAX_PATH);
+    swprintf(result, MAX_PATH, L"%s\\DriverStore\\FileRepository\\%s_%08lx\\%s", store,
+             wcsrchr(full, '\\') + 1, hash, wcsrchr(full, '\\') + 1);
+    need = wcslen(result) + 1;
+    if (!dst || *dstlen < need)
+    {
+        *dstlen = need;
+        return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    }
+
+    exists = GetFileAttributesW(result) != INVALID_FILE_ATTRIBUTES;
+    if (!exists || (flags & UPDP_UPLOAD_ALWAYS))
+    {
+        WCHAR root[MAX_PATH], pkg[MAX_PATH];
+
+        swprintf(root, MAX_PATH, L"%s\\DriverStore", store);
+        CreateDirectoryW(root, NULL);
+        swprintf(root, MAX_PATH, L"%s\\DriverStore\\FileRepository", store);
+        CreateDirectoryW(root, NULL);
+        wcscpy(pkg, result);
+        *wcsrchr(pkg, '\\') = 0;
+#ifndef SG_MUTANT_UPLOAD_NOCOPY
+        if (!copy_package_tree(dir, pkg)) return HRESULT_FROM_WIN32(GetLastError());
+#endif
+    }
+    wcscpy(dst, result);
+    *dstlen = need;
+    return S_OK;
+}
+
+/*****************************************************************************
+ *          UploadPrinterDriverPackageA [WINSPOOL.@]
+ */
+HRESULT WINAPI UploadPrinterDriverPackageA( LPCSTR server, LPCSTR path, LPCSTR env,
+                                            DWORD flags, HWND hwnd, LPSTR dst, PULONG dstlen )
+{
+    UNICODE_STRING serverW, pathW, envW;
+    WCHAR dstW[MAX_PATH];
+    ULONG lenW = ARRAY_SIZE(dstW);
+    HRESULT hr;
+
+    asciitounicode(&serverW, server);
+    asciitounicode(&pathW, path);
+    asciitounicode(&envW, env);
+    hr = UploadPrinterDriverPackageW(serverW.Buffer, pathW.Buffer, envW.Buffer, flags, hwnd,
+            dstlen ? dstW : NULL, dstlen ? &lenW : NULL);
+    if (dstlen)
+    {
+        if (hr == S_OK)
+        {
+            int need = WideCharToMultiByte(CP_ACP, 0, dstW, -1, NULL, 0, NULL, NULL);
+            if (dst && *dstlen >= need) WideCharToMultiByte(CP_ACP, 0, dstW, -1, dst, *dstlen, NULL, NULL);
+            else hr = HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+            *dstlen = need;
+        }
+        else if (hr == HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER)) *dstlen = lenW;
+    }
+    RtlFreeUnicodeString(&serverW);
+    RtlFreeUnicodeString(&pathW);
+    RtlFreeUnicodeString(&envW);
+    return hr;
 }
 
