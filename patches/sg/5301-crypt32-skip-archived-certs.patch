From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: enumerations skip archived certificates

crypt32: an enumeration of a store ignores the certificates that have the
archived property, unless the store was opened with
CERT_STORE_ENUM_ARCHIVED_FLAG, as the documentation of CertOpenStore says.
Explicit searches (CertFindCertificateInStore) still find them: they use the
store's own enumeration, as the documentation of CERT_ARCHIVED_PROP_ID says.
---
--- a/dlls/crypt32/cert.c
+++ b/dlls/crypt32/cert.c
@@ -1713,7 +1713,7 @@ static inline PCCERT_CONTEXT cert_compare_certs_in_store(HCERTSTORE store,
 
     ret = prev;
     do {
-        ret = CertEnumCertificatesInStore(store, ret);
+        ret = CRYPT_EnumCertificatesInStore(store, ret);
         if (ret)
             matches = compare(ret, dwType, dwFlags, pvPara);
     } while (ret != NULL && !matches);
@@ -1885,7 +1885,10 @@ typedef PCCERT_CONTEXT (*CertFindFunc)(HCERTSTORE store, DWORD dwType,
 static PCCERT_CONTEXT find_cert_any(HCERTSTORE store, DWORD dwType,
  DWORD dwFlags, const void *pvPara, PCCERT_CONTEXT prev)
 {
+#ifdef SG_MUTANT_FIND_SKIPS
     return CertEnumCertificatesInStore(store, prev);
+#endif
+    return CRYPT_EnumCertificatesInStore(store, prev);
 }
 
 static PCCERT_CONTEXT find_cert_by_issuer(HCERTSTORE store, DWORD dwType,
--- a/dlls/crypt32/crypt32_private.h
+++ b/dlls/crypt32/crypt32_private.h
@@ -340,6 +340,7 @@ typedef struct WINE_CRYPTCERTSTORE
 void CRYPT_InitStore(WINECRYPT_CERTSTORE *store, DWORD dwFlags,
  CertStoreType type, const store_vtbl_t*);
 void CRYPT_FreeStore(WINECRYPT_CERTSTORE *store);
+PCCERT_CONTEXT CRYPT_EnumCertificatesInStore(HCERTSTORE store, PCCERT_CONTEXT prev);
 BOOL WINAPI I_CertUpdateStore(HCERTSTORE store1, HCERTSTORE store2, DWORD unk0,
  DWORD unk1);
 
--- a/dlls/crypt32/store.c
+++ b/dlls/crypt32/store.c
@@ -1137,12 +1137,12 @@ HCERTSTORE WINAPI CertOpenSystemStoreW(HCRYPTPROV_LEGACY hProv,
      CERT_SYSTEM_STORE_CURRENT_USER, szSubSystemProtocol);
 }
 
-PCCERT_CONTEXT WINAPI CertEnumCertificatesInStore(HCERTSTORE hCertStore, PCCERT_CONTEXT pPrev)
+/* the enumeration as the store gives it: archived certificates included */
+PCCERT_CONTEXT CRYPT_EnumCertificatesInStore(HCERTSTORE hCertStore, PCCERT_CONTEXT pPrev)
 {
     cert_t *prev = pPrev ? cert_from_ptr(pPrev) : NULL, *ret;
     WINECRYPT_CERTSTORE *hcs = hCertStore;
 
-    TRACE("(%p, %p)\n", hCertStore, pPrev);
     if (!hCertStore)
         ret = NULL;
     else if (hcs->dwMagic != WINE_CRYPTCERTSTORE_MAGIC)
@@ -1152,6 +1152,32 @@ PCCERT_CONTEXT WINAPI CertEnumCertificatesInStore(HCERTSTORE hCertStore, PCCERT_
     return ret ? &ret->ctx : NULL;
 }
 
+static BOOL cert_is_archived(PCCERT_CONTEXT context)
+{
+    cert_t *cert = cert_from_ptr(context);
+    CRYPT_DATA_BLOB blob;
+
+    return cert->base.properties && ContextPropertyList_FindProperty(cert->base.properties,
+            CERT_ARCHIVED_PROP_ID, &blob);
+}
+
+PCCERT_CONTEXT WINAPI CertEnumCertificatesInStore(HCERTSTORE hCertStore, PCCERT_CONTEXT pPrev)
+{
+    WINECRYPT_CERTSTORE *hcs = hCertStore;
+    PCCERT_CONTEXT ret;
+
+    TRACE("(%p, %p)\n", hCertStore, pPrev);
+
+    ret = CRYPT_EnumCertificatesInStore(hCertStore, pPrev);
+    /* Normally an enumeration ignores the certificates that have the archived property */
+#ifndef SG_MUTANT_ENUM_ARCHIVED
+    while (ret && !(hcs->dwOpenFlags & CERT_STORE_ENUM_ARCHIVED_FLAG) &&
+           cert_is_archived(ret))
+        ret = CRYPT_EnumCertificatesInStore(hCertStore, ret);
+#endif
+    return ret;
+}
+
 BOOL WINAPI CertDeleteCertificateFromStore(PCCERT_CONTEXT pCertContext)
 {
     WINECRYPT_CERTSTORE *hcs;
--- a/dlls/crypt32/tests/store.c
+++ b/dlls/crypt32/tests/store.c
@@ -3318,6 +3318,76 @@ static void test_CryptQueryObject(void)
     ok( ctx == NULL, "got %p\n", ctx );
 }
 
+static unsigned int count_certs(HCERTSTORE store)
+{
+    PCCERT_CONTEXT context = NULL;
+    unsigned int count = 0;
+
+    while ((context = CertEnumCertificatesInStore(store, context))) ++count;
+    return count;
+}
+
+static void test_archived_certs(void)
+{
+    PCCERT_CONTEXT context, found, ctx1, ctx2;
+    CRYPT_DATA_BLOB blob = { 0, NULL };
+    HCERTSTORE store;
+    unsigned int count;
+    BOOL ret;
+
+    store = CertOpenStore(CERT_STORE_PROV_MEMORY, 0, 0, CERT_STORE_CREATE_NEW_FLAG, NULL);
+    ok(!!store, "got error %#lx.\n", GetLastError());
+    ret = CertAddEncodedCertificateToStore(store, X509_ASN_ENCODING, bigCert, sizeof(bigCert),
+            CERT_STORE_ADD_ALWAYS, &ctx1);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    ret = CertAddEncodedCertificateToStore(store, X509_ASN_ENCODING, bigCert2, sizeof(bigCert2),
+            CERT_STORE_ADD_ALWAYS, &ctx2);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    ok(count_certs(store) == 2, "got %u certificates.\n", count_certs(store));
+
+    ret = CertSetCertificateContextProperty(ctx1, CERT_ARCHIVED_PROP_ID, 0, &blob);
+    ok(ret, "got error %#lx.\n", GetLastError());
+
+    /* an enumeration ignores the archived certificate... */
+    ok(count_certs(store) == 1, "got %u certificates.\n", count_certs(store));
+    context = CertEnumCertificatesInStore(store, NULL);
+    ok(context && context->cbCertEncoded == sizeof(bigCert2), "got %p.\n", context);
+    CertFreeCertificateContext(context);
+
+    /* ... but an explicit search finds it. */
+    found = CertFindCertificateInStore(store, X509_ASN_ENCODING, 0, CERT_FIND_EXISTING, ctx1, NULL);
+    ok(!!found, "got error %#lx.\n", GetLastError());
+    CertFreeCertificateContext(found);
+    found = NULL;
+    count = 0;
+    while ((found = CertFindCertificateInStore(store, X509_ASN_ENCODING, 0, CERT_FIND_ANY, NULL, found))) ++count;
+    ok(count == 2, "got %u certificates.\n", count);
+
+    /* the archive flag can be taken away again */
+    ret = CertSetCertificateContextProperty(ctx1, CERT_ARCHIVED_PROP_ID, 0, NULL);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    ok(count_certs(store) == 2, "got %u certificates.\n", count_certs(store));
+
+    CertFreeCertificateContext(ctx1);
+    CertFreeCertificateContext(ctx2);
+    CertCloseStore(store, 0);
+
+    /* a store opened with CERT_STORE_ENUM_ARCHIVED_FLAG enumerates them all */
+    store = CertOpenStore(CERT_STORE_PROV_MEMORY, 0, 0, CERT_STORE_CREATE_NEW_FLAG | CERT_STORE_ENUM_ARCHIVED_FLAG, NULL);
+    ok(!!store, "got error %#lx.\n", GetLastError());
+    ret = CertAddEncodedCertificateToStore(store, X509_ASN_ENCODING, bigCert, sizeof(bigCert),
+            CERT_STORE_ADD_ALWAYS, &ctx1);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    ret = CertAddEncodedCertificateToStore(store, X509_ASN_ENCODING, bigCert2, sizeof(bigCert2),
+            CERT_STORE_ADD_ALWAYS, NULL);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    ret = CertSetCertificateContextProperty(ctx1, CERT_ARCHIVED_PROP_ID, 0, &blob);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    ok(count_certs(store) == 2, "got %u certificates.\n", count_certs(store));
+    CertFreeCertificateContext(ctx1);
+    CertCloseStore(store, 0);
+}
+
 START_TEST(store)
 {
     /* various combinations of CertOpenStore */
@@ -3346,6 +3416,7 @@ START_TEST(store)
     testAddCertificateLink();
 
     testEmptyStore();
+    test_archived_certs();
 
     test_I_UpdateStore();
     test_PFXImportCertStore();
