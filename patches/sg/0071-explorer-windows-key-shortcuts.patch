+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "shellapi.h"
+#include "wine/debug.h"
+#include "explorer_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(explorer);
+
+#ifndef MOD_NOREPEAT
+#define MOD_NOREPEAT 0x4000
+#endif
+
+enum { SK_DESKTOP = 0x5700, SK_MINIMIZE_ALL, SK_RESTORE_ALL, SK_EXPLORER, SK_RUN, SK_SETTINGS, SK_SYSTEM,
+       SK_QUICKLINK, SK_SNAP_LEFT, SK_SNAP_RIGHT, SK_MAXIMIZE, SK_DOWN, SK_LAST };
+
+static HWND sk_tray;
+static HHOOK sk_hook;
+static BOOL win_alone;            /* the Windows key is down, and nothing else was pressed */
+
+/* ---- which windows ----------------------------------------------------- */
+
+static BOOL is_app( HWND hwnd )
+{
+    DWORD pid;
+    LONG ex = GetWindowLongW( hwnd, GWL_EXSTYLE );
+    if (!IsWindowVisible( hwnd ) || GetWindow( hwnd, GW_OWNER )) return FALSE;
+    if (!GetWindowThreadProcessId( hwnd, &pid ) || pid == GetCurrentProcessId()) return FALSE;
+    if ((ex & WS_EX_TOOLWINDOW) && !(ex & WS_EX_APPWINDOW)) return FALSE;
+    return vd_on_current( hwnd );
+}
+
+static HWND active_app(void)
+{
+    HWND fg = GetForegroundWindow();
+    return fg && (fg = GetAncestor( fg, GA_ROOTOWNER )) && is_app( fg ) ? fg : 0;
+}
+
+/* ---- show the desktop, minimize all --------------------------------------- */
+
+static HWND shown[64];            /* what Win+D minimized, top first */
+static int nshown;
+
+static BOOL CALLBACK collect_proc( HWND hwnd, LPARAM lparam )
+{
+    if (nshown < ARRAY_SIZE(shown) && is_app( hwnd ) && !IsIconic( hwnd )) shown[nshown++] = hwnd;
+    return TRUE;
+}
+
+static void minimize_all( BOOL remember )
+{
+    int i;
+    nshown = 0;
+    EnumWindows( collect_proc, 0 );
+    for (i = 0; i < nshown; i++) ShowWindowAsync( shown[i], SW_SHOWMINNOACTIVE );
+    if (!remember) nshown = 0;
+    SetForegroundWindow( sk_tray );
+}
+
+static void restore_all(void)
+{
+    int i;
+    for (i = nshown - 1; i >= 0; i--)
+        if (IsWindow( shown[i] ) && IsIconic( shown[i] )) ShowWindowAsync( shown[i], SW_RESTORE );
+    if (nshown && IsWindow( shown[0] )) SetForegroundWindow( shown[0] );
+    nshown = 0;
+}
+
+static void toggle_desktop(void)
+{
+    /* the second press puts back what the first took away, unless a window
+     * came up in between */
+    if (nshown && !active_app()) restore_all();
+    else minimize_all( TRUE );
+}
+
+/* ---- snapping ---------------------------------------------------------- */
+
+struct snap { HWND hwnd; RECT restore; int side; };   /* side: -1 left, 1 right */
+static struct snap snaps[32];
+
+static struct snap *get_snap( HWND hwnd, BOOL create )
+{
+    int i, free = -1;
+    for (i = 0; i < ARRAY_SIZE(snaps); i++)
+    {
+        if (snaps[i].hwnd == hwnd) return &snaps[i];
+        if (free < 0 && (!snaps[i].hwnd || !IsWindow( snaps[i].hwnd ))) free = i;
+    }
+    if (!create || free < 0) return NULL;
+    snaps[free].hwnd = hwnd;
+    snaps[free].side = 0;
+    return &snaps[free];
+}
+
+static void work_area( HWND hwnd, RECT *rc )
+{
+    MONITORINFO mi = { sizeof(mi) };
+    if (GetMonitorInfoW( MonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST ), &mi )) *rc = mi.rcWork;
+    else SystemParametersInfoW( SPI_GETWORKAREA, 0, rc, 0 );
+}
+
+static void unsnap( HWND hwnd, struct snap *s )
+{
+    SetWindowPos( hwnd, 0, s->restore.left, s->restore.top, s->restore.right - s->restore.left,
+                  s->restore.bottom - s->restore.top, SWP_NOZORDER | SWP_NOACTIVATE );
+    s->side = 0;
+    s->hwnd = 0;
+}
+
+static void snap( int side )
+{
+    HWND hwnd = active_app();
+    struct snap *s;
+    RECT work;
+
+    if (!hwnd || !(GetWindowLongW( hwnd, GWL_STYLE ) & WS_THICKFRAME)) return;  /* not resizable */
+    s = get_snap( hwnd, TRUE );
+    if (s && s->side == -side) { unsnap( hwnd, s ); return; }  /* back from the other side */
+    if (!s || s->side == side) return;
+    if (IsZoomed( hwnd ) || IsIconic( hwnd )) ShowWindow( hwnd, SW_RESTORE );
+    GetWindowRect( hwnd, &s->restore );
+    work_area( hwnd, &work );
+    SetWindowPos( hwnd, 0, side < 0 ? work.left : (work.left + work.right) / 2, work.top,
+                  (work.right - work.left) / 2, work.bottom - work.top, SWP_NOZORDER );
+    s->side = side;
+}
+
+static void window_down(void)
+{
+    HWND hwnd = active_app();
+    struct snap *s;
+
+    if (!hwnd) return;
+    if (IsZoomed( hwnd )) ShowWindowAsync( hwnd, SW_RESTORE );
+    else if ((s = get_snap( hwnd, FALSE )) && s->side) unsnap( hwnd, s );
+    else ShowWindowAsync( hwnd, SW_MINIMIZE );
+}
+
+static void window_up(void)
+{
+    HWND hwnd = active_app();
+    struct snap *s;
+
+    if (!hwnd || !(GetWindowLongW( hwnd, GWL_STYLE ) & WS_MAXIMIZEBOX)) return;
+    if ((s = get_snap( hwnd, FALSE ))) s->hwnd = 0;
+    ShowWindowAsync( hwnd, SW_MAXIMIZE );
+}
+
+/* ---- programs ------------------------------------------------------------- */
+
+static void run( const WCHAR *file, const WCHAR *params )
+{
+    if ((INT_PTR)ShellExecuteW( NULL, NULL, file, params, NULL, SW_SHOWNORMAL ) <= 32)
+        WARN( "could not start %s %s\n", debugstr_w(file), debugstr_w(params) );
+}
+
+static DWORD WINAPI run_dialog_thread( void *arg )
+{
+    void (WINAPI *run_file_dlg)( HWND, HICON, const WCHAR *, const WCHAR *, const WCHAR *, UINT );
+    HMODULE shell32 = LoadLibraryW( L"shell32.dll" );
+
+    if (shell32 && (run_file_dlg = (void *)GetProcAddress( shell32, (const char *)61 )))
+        run_file_dlg( NULL, NULL, NULL, NULL, NULL, 0 );
+    return 0;
+}
+
+static void run_dialog(void)
+{
+    HANDLE thread = CreateThread( NULL, 0, run_dialog_thread, NULL, 0, NULL );
+    if (thread) CloseHandle( thread );
+}
+
+static void open_start(void)
+{
+    HWND start = FindWindowW( L"SgStartPanel", NULL );
+    if (start) PostMessageW( start, WM_USER + 10, 0, 0 );
+    else do_startmenu( sk_tray );
+}
+
+/* the quick-link menu (Win+X), above the Start button */
+static void quick_link(void)
+{
+    enum { QL_APPS = 1, QL_SYSTEM, QL_NETWORK, QL_POWERSHELL, QL_TASKMGR, QL_SETTINGS, QL_EXPLORER,
+           QL_RUN, QL_DESKTOP, QL_CONTROL };
+    HMENU menu = CreatePopupMenu();
+    RECT work;
+    int cmd;
+
+    AppendMenuW( menu, MF_STRING, QL_APPS, L"Apps and &Features" );
+    AppendMenuW( menu, MF_STRING, QL_SYSTEM, L"S&ystem" );
+    AppendMenuW( menu, MF_STRING, QL_NETWORK, L"Net&work Connections" );
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( menu, MF_STRING, QL_POWERSHELL, L"Windows Power&Shell" );
+    AppendMenuW( menu, MF_STRING, QL_TASKMGR, L"Tas&k Manager" );
+    AppendMenuW( menu, MF_STRING, QL_SETTINGS, L"Setti&ngs" );
+    AppendMenuW( menu, MF_STRING, QL_CONTROL, L"Control &Panel" );
+    AppendMenuW( menu, MF_STRING, QL_EXPLORER, L"File &Explorer" );
+    AppendMenuW( menu, MF_STRING, QL_RUN, L"&Run" );
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( menu, MF_STRING, QL_DESKTOP, L"&Desktop" );
+    SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
+    SetForegroundWindow( sk_tray );
+    cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_LEFTALIGN | TPM_BOTTOMALIGN, work.left, work.bottom, 0, sk_tray, NULL );
+    DestroyMenu( menu );
+    switch (cmd)
+    {
+    case QL_APPS: run( L"control.exe", L"appwiz.cpl" ); break;
+    case QL_SYSTEM: run( L"control.exe", L"/name Microsoft.System" ); break;
+    case QL_NETWORK: run( L"control.exe", L"ncpa.cpl" ); break;
+    case QL_POWERSHELL:
+        if ((INT_PTR)ShellExecuteW( NULL, NULL, L"pwsh.exe", NULL, NULL, SW_SHOWNORMAL ) <= 32) run( L"cmd.exe", NULL );
+        break;
+    case QL_TASKMGR: run( L"taskmgr.exe", NULL ); break;
+    case QL_SETTINGS: case QL_CONTROL: run( L"control.exe", NULL ); break;
+    case QL_EXPLORER: run( L"explorer.exe", NULL ); break;
+    case QL_RUN: run_dialog(); break;
+    case QL_DESKTOP: toggle_desktop(); break;
+    }
+}
+
+/* ---- the keys ------------------------------------------------------------ */
+
+BOOL shell_hotkey( WPARAM id )
+{
+    win_alone = FALSE;
+    switch (id)
+    {
+    case SK_DESKTOP: toggle_desktop(); return TRUE;
+    case SK_MINIMIZE_ALL: minimize_all( TRUE ); return TRUE;
+    case SK_RESTORE_ALL: restore_all(); return TRUE;
+    case SK_EXPLORER: run( L"explorer.exe", NULL ); return TRUE;
+    case SK_RUN: run_dialog(); return TRUE;
+    case SK_SETTINGS: run( L"control.exe", NULL ); return TRUE;
+    case SK_SYSTEM: run( L"control.exe", L"/name Microsoft.System" ); return TRUE;
+    case SK_QUICKLINK: quick_link(); return TRUE;
+    case SK_SNAP_LEFT: snap( -1 ); return TRUE;
+    case SK_SNAP_RIGHT: snap( 1 ); return TRUE;
+    case SK_MAXIMIZE: window_up(); return TRUE;
+    case SK_DOWN: window_down(); return TRUE;
+    }
+    return FALSE;
+}
+
+/* The Windows key alone: Start, on its release -- unless another key was
+ * pressed while it was down (a shortcut), as on Windows. */
+static LRESULT CALLBACK win_key_proc( int code, WPARAM wp, LPARAM lp )
+{
+    const KBDLLHOOKSTRUCT *k = (const KBDLLHOOKSTRUCT *)lp;
+
+    if (code == HC_ACTION)
+    {
+        BOOL win = k->vkCode == VK_LWIN || k->vkCode == VK_RWIN;
+        BOOL up = wp == WM_KEYUP || wp == WM_SYSKEYUP;
+
+        if (win && !up && !(GetAsyncKeyState( VK_CONTROL ) < 0 || GetAsyncKeyState( VK_MENU ) < 0 ||
+                            GetAsyncKeyState( VK_SHIFT ) < 0))
+        {
+            if (!win_alone) win_alone = TRUE;
+        }
+        else if (win && up)
+        {
+            if (win_alone) PostMessageW( sk_tray, WM_HOTKEY, SK_LAST, 0 );
+            win_alone = FALSE;
+        }
+        else if (!up) win_alone = FALSE;
+    }
+    return CallNextHookEx( 0, code, wp, lp );
+}
+
+BOOL shell_hotkey_start( WPARAM id )
+{
+    if (id != SK_LAST) return FALSE;
+    open_start();
+    return TRUE;
+}
+
+void initialize_shell_keys( HWND tray )
+{
+    sk_tray = tray;
+    RegisterHotKey( tray, SK_DESKTOP, MOD_WIN | MOD_NOREPEAT, 'D' );
+    RegisterHotKey( tray, SK_MINIMIZE_ALL, MOD_WIN | MOD_NOREPEAT, 'M' );
+    RegisterHotKey( tray, SK_RESTORE_ALL, MOD_WIN | MOD_SHIFT | MOD_NOREPEAT, 'M' );
+    RegisterHotKey( tray, SK_EXPLORER, MOD_WIN | MOD_NOREPEAT, 'E' );
+    RegisterHotKey( tray, SK_RUN, MOD_WIN | MOD_NOREPEAT, 'R' );
+    RegisterHotKey( tray, SK_SETTINGS, MOD_WIN | MOD_NOREPEAT, 'I' );
+    RegisterHotKey( tray, SK_SYSTEM, MOD_WIN | MOD_NOREPEAT, VK_PAUSE );
+    RegisterHotKey( tray, SK_QUICKLINK, MOD_WIN | MOD_NOREPEAT, 'X' );
+    RegisterHotKey( tray, SK_SNAP_LEFT, MOD_WIN, VK_LEFT );
+    RegisterHotKey( tray, SK_SNAP_RIGHT, MOD_WIN, VK_RIGHT );
+    RegisterHotKey( tray, SK_MAXIMIZE, MOD_WIN, VK_UP );
+    RegisterHotKey( tray, SK_DOWN, MOD_WIN, VK_DOWN );
+    sk_hook = SetWindowsHookExW( WH_KEYBOARD_LL, win_key_proc, GetModuleHandleW( NULL ), 0 );
+}
