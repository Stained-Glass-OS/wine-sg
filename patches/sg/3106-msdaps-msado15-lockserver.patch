From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 21:09:27 -0700
Subject: [PATCH] msdaps, msado15: class factory LockServer

Neither class factory keeps a lock count; LockServer logs and succeeds
instead of reporting itself as a stub.

diff --git a/dlls/msado15/main.c b/dlls/msado15/main.c
index 54e65e3..b817a52 100644
--- a/dlls/msado15/main.c
+++ b/dlls/msado15/main.c
@@ -89,7 +89,7 @@ static HRESULT WINAPI msadocf_CreateInstance( IClassFactory *iface, LPUNKNOWN ou
 
 static HRESULT WINAPI msadocf_LockServer( IClassFactory *iface, BOOL dolock )
 {
-    FIXME( "%p, %d\n", iface, dolock );
+    TRACE( "%p, %d\n", iface, dolock );
     return S_OK;
 }
 
diff --git a/dlls/msdaps/main.c b/dlls/msdaps/main.c
index 9143b76..ba95df7 100644
--- a/dlls/msdaps/main.c
+++ b/dlls/msdaps/main.c
@@ -113,7 +113,7 @@ static HRESULT WINAPI CF_CreateInstance(IClassFactory *iface, IUnknown *pOuter,
 
 static HRESULT WINAPI CF_LockServer(IClassFactory *iface, BOOL dolock)
 {
-    FIXME("(%p, %d): stub\n", iface, dolock);
+    TRACE("(%p, %d)\n", iface, dolock);
     return S_OK;
 }
 
