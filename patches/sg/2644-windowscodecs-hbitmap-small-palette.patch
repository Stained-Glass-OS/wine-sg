From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: CreateBitmapFromHBITMAP of an 8 bit bitmap with a small palette

As the Wine tests (todo) record from Windows, an 8 bit bitmap made with a logical palette of 3
to 16 colours is a 4 bit indexed WIC bitmap with a palette of 16 colours; with more colours it
stays 8 bit.

 - The pixels are packed two to a byte (first pixel in the high nibble) in rows of 4 byte
   multiples.
 - The palette is extended with opaque black to 16 colours.
 - Removed the todo marks of the pixel format and the palette count; the 256 colour case
   still differs in the pixel indices (native maps through the system palette).
---
--- a/dlls/windowscodecs/imgfactory.c
+++ b/dlls/windowscodecs/imgfactory.c
@@ -727,6 +727,8 @@ static HRESULT WINAPI ImagingFactory_CreateBitmapFromHBITMAP(IWICImagingFactory2
     IWICBitmapLock *lock;
     UINT size, num_palette_entries = 0;
     PALETTEENTRY entry[256];
+    BOOL packed_4bpp = FALSE;
+    UINT stride;
 
     TRACE("(%p,%p,%p,%u,%p)\n", iface, hbm, hpal, option, bitmap);
 
@@ -753,6 +755,14 @@ static HRESULT WINAPI ImagingFactory_CreateBitmapFromHBITMAP(IWICImagingFactory2
         break;
     case 8:
         format = GUID_WICPixelFormat8bppIndexed;
+        /* a palette of 3 to 16 colours makes a 4 bit image */
+#ifndef SG_MUTANT_WICHBM_8BPP_ALWAYS
+        if (num_palette_entries > 2 && num_palette_entries <= 16)
+        {
+            format = GUID_WICPixelFormat4bppIndexed;
+            packed_4bpp = TRUE;
+        }
+#endif
         break;
     case 16:
         if (!get_16bpp_format(hbm, &format))
@@ -785,7 +795,8 @@ static HRESULT WINAPI ImagingFactory_CreateBitmapFromHBITMAP(IWICImagingFactory2
         return E_INVALIDARG;
     }
 
-    hr = BitmapImpl_Create(bm.bmWidth, bm.bmHeight, bm.bmWidthBytes, 0, NULL, 0, &format,
+    stride = packed_4bpp ? ((bm.bmWidth * 4 + 31) / 32) * 4 : bm.bmWidthBytes;
+    hr = BitmapImpl_Create(bm.bmWidth, bm.bmHeight, stride, 0, NULL, 0, &format,
                            WICBitmapCacheOnLoad, bitmap);
     if (hr != S_OK) return hr;
 
@@ -797,6 +808,8 @@ static HRESULT WINAPI ImagingFactory_CreateBitmapFromHBITMAP(IWICImagingFactory2
         char bmibuf[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
         BITMAPINFO *bmi = (BITMAPINFO *)bmibuf;
 
+        BYTE *dib = NULL;
+
         IWICBitmapLock_GetDataPointer(lock, &size, &buffer);
 
         hdc = CreateCompatibleDC(0);
@@ -805,7 +818,31 @@ static HRESULT WINAPI ImagingFactory_CreateBitmapFromHBITMAP(IWICImagingFactory2
         bmi->bmiHeader.biBitCount = 0;
         GetDIBits(hdc, hbm, 0, 0, NULL, bmi, DIB_RGB_COLORS);
         bmi->bmiHeader.biHeight = -bm.bmHeight;
-        GetDIBits(hdc, hbm, 0, bm.bmHeight, buffer, bmi, DIB_RGB_COLORS);
+        if (packed_4bpp)
+        {
+            UINT x, y;
+
+            if (!(dib = calloc(bm.bmHeight, bm.bmWidthBytes)))
+            {
+                DeleteDC(hdc);
+                IWICBitmapLock_Release(lock);
+                IWICBitmap_Release(*bitmap);
+                *bitmap = NULL;
+                return E_OUTOFMEMORY;
+            }
+            GetDIBits(hdc, hbm, 0, bm.bmHeight, dib, bmi, DIB_RGB_COLORS);
+            for (y = 0; y < bm.bmHeight; ++y)
+                for (x = 0; x < bm.bmWidth; ++x)
+                {
+                    BYTE index = dib[y * bm.bmWidthBytes + x] & 0x0f;
+                    BYTE *dst = &buffer[y * stride + x / 2];
+
+                    *dst = (x & 1) ? (*dst & 0xf0) | index : (*dst & 0x0f) | (index << 4);
+                }
+            free(dib);
+        }
+        else
+            GetDIBits(hdc, hbm, 0, bm.bmHeight, buffer, bmi, DIB_RGB_COLORS);
 
         DeleteDC(hdc);
         IWICBitmapLock_Release(lock);
@@ -822,6 +859,13 @@ static HRESULT WINAPI ImagingFactory_CreateBitmapFromHBITMAP(IWICImagingFactory2
                 for (i = 0; i < num_palette_entries; i++)
                     colors[i] = 0xff000000 | entry[i].peRed << 16 |
                                 entry[i].peGreen << 8 | entry[i].peBlue;
+                /* a 4 bit image has all its 16 colours */
+                if (packed_4bpp)
+                {
+                    for (; i < 16; i++)
+                        colors[i] = 0xff000000;
+                    num_palette_entries = 16;
+                }
 
                 hr = IWICPalette_InitializeCustom(palette, colors, num_palette_entries);
                 if (hr == S_OK)
--- a/dlls/windowscodecs/tests/bitmap.c
+++ b/dlls/windowscodecs/tests/bitmap.c
@@ -870,7 +870,6 @@ static void test_CreateBitmapFromHBITMAP(void)
     ok(hr == S_OK, "CreateBitmapFromHBITMAP error %#lx\n", hr);
 
     IWICBitmap_GetPixelFormat(bitmap, &format);
-    todo_wine
     ok(IsEqualGUID(&format, &GUID_WICPixelFormat4bppIndexed),
        "unexpected pixel format %s\n", wine_dbgstr_guid(&format));
 
@@ -890,7 +889,6 @@ static void test_CreateBitmapFromHBITMAP(void)
 
     hr = IWICPalette_GetColorCount(palette, &count);
     ok(hr == S_OK, "GetColorCount error %#lx\n", hr);
-    todo_wine
     ok(count == 16, "expected 16, got %u\n", count);
 
     IWICPalette_Release(palette);
