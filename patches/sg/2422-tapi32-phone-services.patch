 {
-    FIXME("(%p, %p, %08lx): stub.\n", hPhoneApp, lpMessage, dwTimeout);
-    return 0;
+    DWORD err = check_phone_app( hPhoneApp );
+
+    TRACE("(%p, %p, %08lx)\n", hPhoneApp, lpMessage, dwTimeout);
+    if (err) return err;
+    if (!lpMessage) return PHONEERR_INVALPOINTER;
+    /* the application must have been started with an event or a completion port */
+    if (phone_app_options( hPhoneApp ) == PHONEINITIALIZEEXOPTION_USEHIDDENWINDOW) return PHONEERR_INVALAPPHANDLE;
+    /* No device can ever produce a message. A bounded wait just times out;
+     * waiting forever would hang the caller, so that fails at once. */
+    if (dwTimeout && dwTimeout != INFINITE) Sleep( dwTimeout );
+    return PHONEERR_OPERATIONFAILED;
 }
 
