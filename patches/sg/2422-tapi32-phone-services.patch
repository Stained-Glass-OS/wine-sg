From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] tapi32: phone services for a machine with no phone devices

phone.c claimed success for everything. Like lines (2409, 2420), phones are
modelled on a machine that has TAPI and no devices:

- phoneInitialize, phoneInitializeExA/W and phoneShutdown keep a table of
  applications (hidden window with a callback, event or completion port;
  handle checks; API version bounds; the extended-parameters size); the
  device count is zero. phoneGetMessage waits out its timeout and fails.
- The calls that name a device (phoneNegotiateAPIVersion, phoneNegotiateExtVersion,
  phoneGetDevCaps, phoneOpen, phoneConfigDialog, phoneGetIcon) check the
  application handle and the pointers, then fail with PHONEERR_BADDEVICEID.
- The twenty-two calls that name a phone handle fail with
  PHONEERR_INVALPHONEHANDLE.
tapi.h gains the PHONEERR_* codes and the phone initialize options.
---
--- a/dlls/tapi32/phone.c
+++ b/dlls/tapi32/phone.c
@@ -36,14 +36,146 @@
 */
 WINE_DEFAULT_DEBUG_CHANNEL(tapi);
 
+#include <stdlib.h>
+#include "winerror.h"
+#include "wine/list.h"
+
+#define PHONE_LOW_API_VERSION   0x00010003
+#define PHONE_HIGH_API_VERSION  0x00030001
+/* The Windows header packs this structure to one byte, Wine's does not; the size an application passes is the packed one. */
+#define PHONE_EXPARAMS_SIZE     (FIELD_OFFSET(PHONEINITIALIZEEXPARAMS, dwCompletionKey) + sizeof(DWORD))
+
+/* This models a machine that has TAPI but no phone devices, as lineapp.c does for lines. */
+struct phone_app
+{
+    struct list entry;
+    DWORD id;
+    DWORD options;
+    HANDLE event;
+};
+
+static struct list phone_apps = LIST_INIT( phone_apps );
+static DWORD next_phone_app_id = 0x20001;
+
+static CRITICAL_SECTION phone_cs;
+static CRITICAL_SECTION_DEBUG phone_cs_debug =
+{
+    0, 0, &phone_cs,
+    { &phone_cs_debug.ProcessLocksList, &phone_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": phone_cs") }
+};
+static CRITICAL_SECTION phone_cs = { &phone_cs_debug, -1, 0, 0, 0, 0 };
+
+/* TAPI handles are 32-bit values; only the low 32 bits of the HANDLE count. */
+static struct phone_app *find_phone_app( HPHONEAPP handle )
+{
+    struct phone_app *app;
+
+    LIST_FOR_EACH_ENTRY( app, &phone_apps, struct phone_app, entry )
+        if ((DWORD)(ULONG_PTR)handle == app->id) return app;
+    return NULL;
+}
+
+static DWORD check_phone_app( HPHONEAPP handle )
+{
+    DWORD ret = PHONEERR_INVALAPPHANDLE;
+
+    EnterCriticalSection( &phone_cs );
+    if (find_phone_app( handle )) ret = 0;
+    LeaveCriticalSection( &phone_cs );
+    return ret;
+}
+
+static DWORD phone_app_options( HPHONEAPP handle )
+{
+    struct phone_app *app;
+    DWORD options = 0;
+
+    EnterCriticalSection( &phone_cs );
+    if ((app = find_phone_app( handle ))) options = app->options;
+    LeaveCriticalSection( &phone_cs );
+    return options;
+}
+
+static DWORD init_phone_app( HPHONEAPP *out, PHONECALLBACK callback, DWORD *num_devs, DWORD *api_version,
+                             PHONEINITIALIZEEXPARAMS *ex, BOOL is_ex )
+{
+    DWORD option = PHONEINITIALIZEEXOPTION_USEHIDDENWINDOW;
+    struct phone_app *app;
+
+    if (!out || !num_devs) return PHONEERR_INVALPOINTER;
+    if (is_ex && !api_version) return PHONEERR_INVALPOINTER;
+    if (ex)
+    {
+        if (ex->dwTotalSize < PHONE_EXPARAMS_SIZE) return PHONEERR_STRUCTURETOOSMALL;
+        option = ex->dwOptions;
+#ifdef SG_MUTANT_TAPIP_EXOPT
+        if (0 &&
+#else
+        if (option != PHONEINITIALIZEEXOPTION_USEHIDDENWINDOW &&
+#endif
+            option != PHONEINITIALIZEEXOPTION_USEEVENT &&
+            option != PHONEINITIALIZEEXOPTION_USECOMPLETIONPORT)
+            return PHONEERR_INVALPARAM;
+    }
+    if (option == PHONEINITIALIZEEXOPTION_USEHIDDENWINDOW && !callback) return PHONEERR_INVALPOINTER;
+    if (api_version)
+    {
+        if (*api_version < PHONE_LOW_API_VERSION) return PHONEERR_INCOMPATIBLEAPIVERSION;
+        if (*api_version > PHONE_HIGH_API_VERSION) *api_version = PHONE_HIGH_API_VERSION;
+    }
+    if (!(app = calloc( 1, sizeof(*app) ))) return PHONEERR_NOMEM;
+    app->options = option;
+    if (option == PHONEINITIALIZEEXOPTION_USEEVENT && !(app->event = CreateEventW( NULL, FALSE, FALSE, NULL )))
+    {
+        free( app );
+        return PHONEERR_NOMEM;
+    }
+    EnterCriticalSection( &phone_cs );
+    app->id = next_phone_app_id++;
+    list_add_tail( &phone_apps, &app->entry );
+    LeaveCriticalSection( &phone_cs );
+    if (ex)
+    {
+        ex->dwNeededSize = ex->dwUsedSize = PHONE_EXPARAMS_SIZE;
+        if (option == PHONEINITIALIZEEXOPTION_USEEVENT) ex->Handles.hEvent = app->event;
+    }
+    *num_devs = 0;  /* no phone devices */
+    *(DWORD *)out = app->id;
+    return 0;
+}
+
+static DWORD shutdown_phone_app( HPHONEAPP handle )
+{
+    struct phone_app *app;
+
+    EnterCriticalSection( &phone_cs );
+    if (!(app = find_phone_app( handle )))
+    {
+        LeaveCriticalSection( &phone_cs );
+        return PHONEERR_INVALAPPHANDLE;
+    }
+#ifdef SG_MUTANT_TAPIP_SHUT
+    LeaveCriticalSection( &phone_cs );
+    return 0;
+#endif
+    list_remove( &app->entry );
+    LeaveCriticalSection( &phone_cs );
+    if (app->event) CloseHandle( app->event );
+    free( app );
+    return 0;
+}
+
 /***********************************************************************
  *		phoneClose (TAPI32.@)
  */
 DWORD WINAPI phoneClose(HPHONE hPhone)
 {
-    FIXME("(%p), stub.\n", hPhone);
-    /* call TSPI function here ! */
+#ifdef SG_MUTANT_TAPIP_CLOSE
     return 0;
+#endif
+    TRACE("(%p)\n", hPhone);
+    return PHONEERR_INVALPHONEHANDLE;
 }
 
