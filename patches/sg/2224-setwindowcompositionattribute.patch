From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: SetWindowCompositionAttribute (dark mode colours, accent blur)

SetWindowCompositionAttribute (the undocumented user32 call browsers and
terminals use for dark title bars and blur) failed every call with
ERROR_CALL_NOT_IMPLEMENTED.  WCA_USEDARKMODECOLORS now sets the same window
property DwmSetWindowAttribute(DWMWA_USE_IMMERSIVE_DARK_MODE) sets, and the
blur, acrylic and host-backdrop accent states set the one
DwmEnableBlurBehindWindow sets; the other attributes of the family are
accepted without effect; a wrong size, an unknown attribute, a missing
window or another process's window is refused.

---
--- a/dlls/user32/win.c
+++ b/dlls/user32/win.c
@@ -1768,7 +1768,59 @@ BOOL WINAPI SetWindowDisplayAffinity(HWND hwnd, DWORD affinity)
  */
 BOOL WINAPI SetWindowCompositionAttribute(HWND hwnd, void *data)
 {
-    FIXME("(%p, %p): stub\n", hwnd, data);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    /* WINDOWCOMPOSITIONATTRIBDATA, as browsers and terminals fill it in */
+    struct { DWORD attrib; void *data; SIZE_T size; } *attr = data;
+    DWORD pid;
+
+    TRACE("(%p, %p)\n", hwnd, data);
+
+    if (!attr)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!IsWindow(hwnd))
+    {
+        SetLastError(ERROR_INVALID_WINDOW_HANDLE);
+        return FALSE;
+    }
+    GetWindowThreadProcessId(hwnd, &pid);
+    if (pid != GetCurrentProcessId())
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+
+    switch (attr->attrib)
+    {
+    case 26:  /* WCA_USEDARKMODECOLORS: a BOOL, the same as DWMWA_USE_IMMERSIVE_DARK_MODE */
+        if (!attr->data || attr->size != sizeof(BOOL)) break;
+#ifndef SG_MUTANT_NO_COMPOSITION_DARK
+        if (*(const BOOL *)attr->data) SetPropW(hwnd, L"__wine_dark_caption", (HANDLE)1);
+        else RemovePropW(hwnd, L"__wine_dark_caption");
+        NtUserRedrawWindow( hwnd, NULL, 0, RDW_FRAME | RDW_INVALIDATE );
+#endif
+        return TRUE;
+
+    case 19:  /* WCA_ACCENT_POLICY: AccentState, flags, colour, animation */
+    {
+        const DWORD *policy = attr->data;
+
+        if (!policy || attr->size != 4 * sizeof(DWORD) || policy[0] > 6) break;
+        /* blur behind, acrylic and the host backdrop blur what is behind the
+         * window, the way DwmEnableBlurBehindWindow does; the others do not */
+#ifndef SG_MUTANT_NO_COMPOSITION_ACCENT
+        if (policy[0] >= 3 && policy[0] <= 5) SetPropW(hwnd, L"__wine_dwm_blur", (HANDLE)1);
+        else RemovePropW(hwnd, L"__wine_dwm_blur");
+#endif
+        return TRUE;
+    }
+
+    default:
+        /* the other attributes of the DWM family are accepted and have no effect here */
+        if (attr->attrib >= 1 && attr->attrib <= 29) return TRUE;
+        break;
+    }
+    SetLastError(ERROR_INVALID_PARAMETER);
     return FALSE;
 }
