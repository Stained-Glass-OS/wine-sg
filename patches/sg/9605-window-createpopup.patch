             KillTimer(hwnd, TIMER_TITLE);
@@ -937,3 +946,390 @@
     VariantClear(&str);
     return hres;
 }
+
+#ifndef SG_MUTANT_NO_POPUP
+/***********************************************************************
+ * window.createPopup (Stained Glass OS, wine-sg 9605)
+ *
+ * A popup is a borderless top-most window that never takes the focus, with a
+ * document of its own that the page fills through popup.document; show()
+ * places it (in screen coordinates, or relative to an element), hide() and a
+ * click anywhere outside it take it away, as in Internet Explorer.
+ */
+
+static const GUID IID_IHTMLPopup_sg = {0x3050f666, 0x98b5, 0x11cf, {0xbb,0x82, 0x00,0xaa,0x00,0xbd,0xce,0x0b}};
+
+struct html_popup;
+typedef struct
+{
+    IUnknownVtbl unk;
+    HRESULT (WINAPI *GetTypeInfoCount)(void*,UINT*);
+    HRESULT (WINAPI *GetTypeInfo)(void*,UINT,LCID,ITypeInfo**);
+    HRESULT (WINAPI *GetIDsOfNames)(void*,REFIID,LPOLESTR*,UINT,LCID,DISPID*);
+    HRESULT (WINAPI *Invoke)(void*,DISPID,REFIID,LCID,WORD,DISPPARAMS*,VARIANT*,EXCEPINFO*,UINT*);
+    /* IHTMLPopup */
+    HRESULT (WINAPI *show)(void*,LONG,LONG,LONG,LONG,VARIANT*);
+    HRESULT (WINAPI *hide)(void*);
+    HRESULT (WINAPI *get_document)(void*,IHTMLDocument**);
+    HRESULT (WINAPI *get_isOpen)(void*,VARIANT_BOOL*);
+} popup_vtbl_t;
+
+struct html_popup
+{
+    const popup_vtbl_t *vtbl;
+    LONG ref;
+    struct html_dialog *dlg;
+};
+
+#define POPUP_DISPID_SHOW     27001     /* DISPID_HTMLPOPUP + 1.. */
+#define POPUP_DISPID_HIDE     27002
+#define POPUP_DISPID_DOCUMENT 27003
+#define POPUP_DISPID_ISOPEN   27004
+
+static HHOOK popup_hook;
+static HWND shown_popup;
+
+/* a click outside the open popup closes it */
+static LRESULT CALLBACK popup_mouse_hook(int code, WPARAM wparam, LPARAM lparam)
+{
+    if(code == HC_ACTION && shown_popup &&
+       (wparam == WM_LBUTTONDOWN || wparam == WM_RBUTTONDOWN || wparam == WM_MBUTTONDOWN ||
+        wparam == WM_NCLBUTTONDOWN || wparam == WM_NCRBUTTONDOWN)) {
+        MOUSEHOOKSTRUCT *mh = (MOUSEHOOKSTRUCT*)lparam;
+        if(mh->hwnd != shown_popup && !IsChild(shown_popup, mh->hwnd)) {
+            ShowWindow(shown_popup, SW_HIDE);
+            shown_popup = NULL;
+        }
+    }
+    return CallNextHookEx(popup_hook, code, wparam, lparam);
+}
+
+static HRESULT WINAPI popup_QueryInterface(void *iface, REFIID riid, void **ppv)
+{
+    struct html_popup *This = iface;
+
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch) || IsEqualGUID(riid, &IID_IHTMLPopup_sg)) {
+        *ppv = This;
+        InterlockedIncrement(&This->ref);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI popup_AddRef(void *iface)
+{
+    struct html_popup *This = iface;
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI popup_Release(void *iface)
+{
+    struct html_popup *This = iface;
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        if(This->dlg) {
+            if(This->dlg->hwnd) {
+                if(shown_popup == This->dlg->hwnd)
+                    shown_popup = NULL;
+                DestroyWindow(This->dlg->hwnd);
+            }
+            dialog_release(This->dlg);
+        }
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI popup_GetTypeInfoCount(void *iface, UINT *count)
+{
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI popup_GetTypeInfo(void *iface, UINT index, LCID lcid, ITypeInfo **ti)
+{
+    *ti = NULL;
+    return DISP_E_BADINDEX;
+}
+
+static HRESULT WINAPI popup_GetIDsOfNames(void *iface, REFIID riid, LPOLESTR *names, UINT count, LCID lcid, DISPID *ids)
+{
+    static const struct { const WCHAR *name; DISPID id; } members[] = {
+        { L"show", POPUP_DISPID_SHOW }, { L"hide", POPUP_DISPID_HIDE },
+        { L"document", POPUP_DISPID_DOCUMENT }, { L"isOpen", POPUP_DISPID_ISOPEN },
+    };
+    UINT i, j;
+    HRESULT hres = S_OK;
+
+    for(i = 0; i < count; i++) {
+        ids[i] = DISPID_UNKNOWN;
+        if(i) { hres = DISP_E_UNKNOWNNAME; continue; }
+        for(j = 0; j < ARRAY_SIZE(members); j++)
+            if(!wcsicmp(names[i], members[j].name)) ids[i] = members[j].id;
+        if(ids[i] == DISPID_UNKNOWN) hres = DISP_E_UNKNOWNNAME;
+    }
+    return hres;
+}
+
+static HRESULT WINAPI popup_show(void *iface, LONG x, LONG y, LONG w, LONG h, VARIANT *elem)
+{
+    struct html_popup *This = iface;
+    HWND hwnd = This->dlg->hwnd;
+    POINT origin = {0, 0};
+
+    TRACE("(%p)->(%ld %ld %ld %ld %s)\n", This, x, y, w, h, debugstr_variant(elem));
+
+    if(!hwnd)
+        return E_UNEXPECTED;
+    /* relative to an element: its top-left corner on the screen */
+    if(elem && V_VT(elem) == VT_DISPATCH && V_DISPATCH(elem)) {
+        IHTMLElement2 *elem2;
+        IHTMLRect *rect;
+        LONG left = 0, top = 0;
+
+        if(SUCCEEDED(IDispatch_QueryInterface(V_DISPATCH(elem), &IID_IHTMLElement2, (void**)&elem2))) {
+            if(SUCCEEDED(IHTMLElement2_getBoundingClientRect(elem2, &rect))) {
+                IHTMLRect_get_left(rect, &left);
+                IHTMLRect_get_top(rect, &top);
+                IHTMLRect_Release(rect);
+            }
+            IHTMLElement2_Release(elem2);
+        }
+        origin.x = left;
+        origin.y = top;
+        if(This->dlg->parent && IsWindow(This->dlg->parent)) {
+            HTMLDocumentObj *owner_doc = NULL;
+            HWND doc_hwnd = NULL;
+            IHTMLElement *e;
+
+            /* the element's document window */
+            if(SUCCEEDED(IDispatch_QueryInterface(V_DISPATCH(elem), &IID_IHTMLElement, (void**)&e))) {
+                HTMLElement *el = unsafe_impl_from_IHTMLElement(e);
+                if(el && el->node.doc && el->node.doc->doc_obj)
+                    owner_doc = el->node.doc->doc_obj;
+                if(owner_doc)
+                    doc_hwnd = owner_doc->hwnd;
+                IHTMLElement_Release(e);
+            }
+            ClientToScreen(doc_hwnd ? doc_hwnd : This->dlg->parent, &origin);
+        }
+    }
+    shown_popup = hwnd;
+    if(!popup_hook)
+        popup_hook = SetWindowsHookExW(WH_MOUSE, popup_mouse_hook, NULL, GetCurrentThreadId());
+    SetWindowPos(hwnd, HWND_TOPMOST, origin.x + x, origin.y + y, max(w, 0), max(h, 0),
+                 SWP_NOACTIVATE | SWP_SHOWWINDOW);
+    return S_OK;
+}
+
+static HRESULT WINAPI popup_hide(void *iface)
+{
+    struct html_popup *This = iface;
+
+    TRACE("(%p)\n", This);
+
+    if(This->dlg->hwnd) {
+        ShowWindow(This->dlg->hwnd, SW_HIDE);
+        if(shown_popup == This->dlg->hwnd)
+            shown_popup = NULL;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI popup_get_document(void *iface, IHTMLDocument **p)
+{
+    struct html_popup *This = iface;
+
+    if(!p)
+        return E_POINTER;
+    if(!This->dlg->doc) {
+        *p = NULL;
+        return E_UNEXPECTED;
+    }
+    return IHTMLDocument2_QueryInterface(This->dlg->doc, &IID_IHTMLDocument, (void**)p);
+}
+
+static HRESULT WINAPI popup_get_isOpen(void *iface, VARIANT_BOOL *p)
+{
+    struct html_popup *This = iface;
+
+    if(!p)
+        return E_POINTER;
+    *p = variant_bool(This->dlg->hwnd && IsWindowVisible(This->dlg->hwnd));
+    return S_OK;
+}
+
+static HRESULT WINAPI popup_Invoke(void *iface, DISPID id, REFIID riid, LCID lcid, WORD flags, DISPPARAMS *dp,
+        VARIANT *res, EXCEPINFO *ei, UINT *argerr)
+{
+    struct html_popup *This = iface;
+    UINT argc = dp ? dp->cArgs - dp->cNamedArgs : 0;
+    HRESULT hres;
+
+    switch(id) {
+    case POPUP_DISPID_SHOW: {
+        LONG v[4] = {0};
+        VARIANT *elem = NULL, tmp;
+        UINT i;
+
+        if(!(flags & DISPATCH_METHOD))
+            return DISP_E_MEMBERNOTFOUND;
+        if(argc < 4)
+            return DISP_E_PARAMNOTOPTIONAL;
+        for(i = 0; i < 4; i++) {
+            V_VT(&tmp) = VT_EMPTY;
+            if(FAILED(hres = VariantChangeType(&tmp, &dp->rgvarg[dp->cArgs - 1 - i], 0, VT_I4)))
+                return hres;
+            v[i] = V_I4(&tmp);
+        }
+        if(argc > 4)
+            elem = &dp->rgvarg[dp->cArgs - 5];
+        return popup_show(This, v[0], v[1], v[2], v[3], elem);
+    }
+    case POPUP_DISPID_HIDE:
+        if(!(flags & DISPATCH_METHOD))
+            return DISP_E_MEMBERNOTFOUND;
+        return popup_hide(This);
+    case POPUP_DISPID_DOCUMENT:
+        if(!(flags & DISPATCH_PROPERTYGET) || !res)
+            return DISP_E_MEMBERNOTFOUND;
+        V_VT(res) = VT_DISPATCH;
+        return popup_get_document(This, (IHTMLDocument**)&V_DISPATCH(res));
+    case POPUP_DISPID_ISOPEN:
+        if(!(flags & DISPATCH_PROPERTYGET) || !res)
+            return DISP_E_MEMBERNOTFOUND;
+        V_VT(res) = VT_BOOL;
+        return popup_get_isOpen(This, &V_BOOL(res));
+    }
+    return DISP_E_MEMBERNOTFOUND;
+}
+
+static const popup_vtbl_t popup_vtbl = {
+    { (void*)popup_QueryInterface, (void*)popup_AddRef, (void*)popup_Release },
+    popup_GetTypeInfoCount,
+    popup_GetTypeInfo,
+    popup_GetIDsOfNames,
+    popup_Invoke,
+    popup_show,
+    popup_hide,
+    popup_get_document,
+    popup_get_isOpen
+};
+
+/* the popup's document is ready (an empty page) before createPopup returns */
+static void wait_for_document(struct html_dialog *dlg)
+{
+    thread_data_t *thread_data = get_thread_data(FALSE);
+    unsigned prev_locked = 0;
+    DWORD end = GetTickCount() + 5000;
+    BSTR state;
+    MSG msg;
+
+    if(thread_data && thread_data->tasks_locked) {
+        prev_locked = thread_data->tasks_locked;
+        thread_data->tasks_locked = 0;
+        unblock_tasks_and_timers(thread_data);
+    }
+    while(dlg->doc && (LONG)(end - GetTickCount()) > 0) {
+        BOOL complete = FALSE;
+
+        if(SUCCEEDED(IHTMLDocument2_get_readyState(dlg->doc, &state)) && state) {
+            complete = !wcscmp(state, L"complete");
+            SysFreeString(state);
+        }
+        if(complete)
+            break;
+        MsgWaitForMultipleObjects(0, NULL, FALSE, 50, QS_ALLINPUT);
+        while(PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE)) {
+            if(msg.message == WM_QUIT) {
+                PostQuitMessage(msg.wParam);
+                end = GetTickCount();
+                break;
+            }
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+    }
+    if(thread_data && prev_locked)
+        thread_data->tasks_locked = prev_locked;
+}
+
+HRESULT window_create_popup(HTMLOuterWindow *window, IDispatch **ret)
+{
+    struct html_popup *popup;
+    struct html_dialog *dlg;
+    IPersistMoniker *persist;
+    IMoniker *mk;
+    HWND parent = NULL;
+    RECT rect = {0, 0, 0, 0};
+    HRESULT hres;
+
+    *ret = NULL;
+    if(window->browser && window->browser->doc && window->browser->doc->hwnd)
+        parent = GetAncestor(window->browser->doc->hwnd, GA_ROOT);
+
+    InitOnceExecuteOnce(&class_once, register_class, NULL, NULL);
+    if(!(dlg = alloc_dialog()))
+        return E_OUTOFMEMORY;
+    dlg->popup = TRUE;
+    dlg->parent = parent;
+    dlg->ui_flags = DOCHOSTUIFLAG_DIALOG | DOCHOSTUIFLAG_NO3DBORDER | DOCHOSTUIFLAG_SCROLL_NO |
+                    DOCHOSTUIFLAG_DISABLE_HELP_MENU;
+
+    dlg->hwnd = CreateWindowExW(WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_NOACTIVATE, dialog_class_name, L"",
+                                WS_POPUP | WS_CLIPCHILDREN, 0, 0, 0, 0, parent, NULL, hInst, dlg);
+    if(!dlg->hwnd) {
+        dialog_release(dlg);
+        return E_FAIL;
+    }
+    InterlockedIncrement(&dlg->ref);    /* the window's */
+
+    hres = CoCreateInstance(&CLSID_HTMLDocument, NULL, CLSCTX_INPROC_SERVER, &IID_IHTMLDocument2, (void**)&dlg->doc);
+    if(SUCCEEDED(hres)) {
+        dlg->doc_obj = get_doc_obj_from_document2(dlg->doc);
+        if(dlg->doc_obj)
+            dlg->doc_obj->dialog = dlg;
+        hres = IHTMLDocument2_QueryInterface(dlg->doc, &IID_IOleObject, (void**)&dlg->ole);
+    }
+    if(SUCCEEDED(hres))
+        hres = IOleObject_SetClientSite(dlg->ole, &dlg->IOleClientSite_iface);
+    if(SUCCEEDED(hres))
+        hres = CreateURLMoniker(NULL, L"about:blank", &mk);
+    if(SUCCEEDED(hres)) {
+        hres = IHTMLDocument2_QueryInterface(dlg->doc, &IID_IPersistMoniker, (void**)&persist);
+        if(SUCCEEDED(hres)) {
+            hres = IPersistMoniker_Load(persist, FALSE, mk, NULL, STGM_READ);
+            IPersistMoniker_Release(persist);
+        }
+        IMoniker_Release(mk);
+    }
+    if(SUCCEEDED(hres))
+        hres = IOleObject_DoVerb(dlg->ole, OLEIVERB_INPLACEACTIVATE, NULL, &dlg->IOleClientSite_iface, 0, dlg->hwnd, &rect);
+    if(FAILED(hres)) {
+        DestroyWindow(dlg->hwnd);
+        dialog_release(dlg);
+        return hres;
+    }
+    IOleObject_QueryInterface(dlg->ole, &IID_IOleInPlaceObject, (void**)&dlg->inplace);
+    wait_for_document(dlg);
+
+    if(!(popup = calloc(1, sizeof(*popup)))) {
+        DestroyWindow(dlg->hwnd);
+        dialog_release(dlg);
+        return E_OUTOFMEMORY;
+    }
+    popup->vtbl = &popup_vtbl;
+    popup->ref = 1;
+    popup->dlg = dlg;
+    *ret = (IDispatch*)popup;
+    return S_OK;
+}
+#else
+HRESULT window_create_popup(HTMLOuterWindow *window, IDispatch **ret)
+{
+    *ret = NULL;
+    return E_NOTIMPL;
+}
+#endif
--- a/dlls/mshtml/htmlwindow.c
+++ b/dlls/mshtml/htmlwindow.c
@@ -2097,8 +2097,13 @@
                             IDispatch **ppPopup)
 {
     HTMLWindow *This = impl_from_IHTMLWindow4(iface);
-    FIXME("(%p)->(%p %p)\n", This, varArgIn, ppPopup);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p %p)\n", This, varArgIn, ppPopup);
+
+    /* the argument is reserved */
+    if(!ppPopup)
+        return E_POINTER;
+    return window_create_popup(This->outer_window, ppPopup);
 }
 
 static HRESULT WINAPI HTMLWindow4_get_frameElement(IHTMLWindow4 *iface, IHTMLFrameBase **p)
