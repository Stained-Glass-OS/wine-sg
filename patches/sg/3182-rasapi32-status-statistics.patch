From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 10:01:35 -0700
Subject: [PATCH] rasapi32: connection status and statistics without a known
 connection

RasGetConnectStatus on a handle that is no connection, and RasGetLinkStatistics /
RasGetConnectionStatistics, no longer answer success with nothing filled in: an
unknown handle is ERROR_INVALID_HANDLE, a connected VPN link is
ERROR_NOT_SUPPORTED (its counters are the kernel's, behind NetworkManager).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/rasapi32/rasapi.c b/dlls/rasapi32/rasapi.c
index f1f545f..60f4867 100644
--- a/dlls/rasapi32/rasapi.c
+++ b/dlls/rasapi32/rasapi.c
@@ -766,11 +766,7 @@ DWORD WINAPI RasGetConnectStatusW(HRASCONN hrasconn, LPRASCONNSTATUSW lprasconns
 
     TRACE("(%p,%p)\n",hrasconn,lprasconnstatus);
     if (!lprasconnstatus || lprasconnstatus->dwSize < FIELD_OFFSET(RASCONNSTATUSW, szDeviceType)) return ERROR_INVALID_SIZE;
-    if ((i = sg_find_handle( hrasconn, &v )) == -2)
-    {
-        FIXME("(%p,%p),stub!\n",hrasconn,lprasconnstatus);
-        return 0;
-    }
+    if ((i = sg_find_handle( hrasconn, &v )) == -2) return ERROR_INVALID_HANDLE;   /* no connection is known at all */
     if (i < 0 || !v[i].connected) { free( v ); return ERROR_INVALID_HANDLE; }
     lprasconnstatus->rasconnstate = RASCS_Connected;
     lprasconnstatus->dwError = 0;
@@ -1373,14 +1369,28 @@ DWORD WINAPI RasGetSubEntryPropertiesA(LPCSTR lpszPhonebook, LPCSTR lpszEntry, D
     return ret;
 }
 
+/* the byte and error counters of a VPN link are the kernel's, behind NetworkManager: not visible here */
+static DWORD sg_statistics( HRASCONN h )
+{
+    struct sg_vpn *v;
+    int i = sg_find_handle( h, &v );
+
+    if (i == -2) return ERROR_INVALID_HANDLE;
+    if (i < 0 || !v[i].connected) { free( v ); return ERROR_INVALID_HANDLE; }
+    free( v );
+    return ERROR_NOT_SUPPORTED;
+}
+
 DWORD WINAPI RasGetLinkStatistics(HRASCONN connection, DWORD entry, RAS_STATS *statistics)
 {
-    FIXME("(%p,%lu,%p), stub!\n", connection, entry, statistics);
-    return 0;
+    TRACE("(%p,%lu,%p)\n", connection, entry, statistics);
+    if (!statistics) return ERROR_INVALID_PARAMETER;
+    return sg_statistics( connection );
 }
 
 DWORD WINAPI RasGetConnectionStatistics(HRASCONN connection, RAS_STATS *statistics)
 {
-    FIXME("(%p,%p), stub!\n", connection, statistics);
-    return ERROR_UNKNOWN;
+    TRACE("(%p,%p)\n", connection, statistics);
+    if (!statistics) return ERROR_INVALID_PARAMETER;
+    return sg_statistics( connection );
 }
