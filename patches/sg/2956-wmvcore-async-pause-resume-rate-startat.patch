From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmvcore: async reader Pause/Resume, Start rate, StartAtPosition frames/timecode, accelerator, type negotiation

IWMReader::Pause/Resume hold back delivery and the reader clock (the paused time is not counted against sample timestamps); Start paces samples by a positive rate (0 and non-finite is E_INVALIDARG, reverse NS_E_INVALID_REQUEST); StartAtPosition in WMT_OFFSET_FORMAT_FRAME_NUMBERS / TIMECODE run SetRangeByFrame / SetRangeByTimecode on the callback thread (error reported in WMT_STARTED), playlist offsets are NS_E_INVALID_REQUEST for a file; IWMReaderAccelerator (no codec interface, E_NOINTERFACE) and IWMReaderTypeNegotiation::TryOutputProps (sets the output type); SetProtectStreamSamples validates and refuses without a protection engine. Gate test/wgasync-gate.sh; test/wmv-reader-probe.c now expects frame-number StartAtPosition to be accepted.
---
diff --git a/dlls/wmvcore/async_reader.c b/dlls/wmvcore/async_reader.c
index 5f31d0f..f65c775 100644
--- a/dlls/wmvcore/async_reader.c
+++ b/dlls/wmvcore/async_reader.c
@@ -19,6 +19,7 @@
 #include <stdarg.h>
 #include <stddef.h>
 #include <stdbool.h>
+#include <math.h>
 
 #define COBJMACROS
 #include "windef.h"
@@ -45,6 +46,15 @@ union async_op_data
         QWORD start;
         QWORD duration;
         void *context;
+        float rate;
+        enum
+        {
+            START_RANGE_TIME,
+            START_RANGE_FRAMES,
+            START_RANGE_TIMECODE,
+        } range;
+        WORD stream;
+        WMT_TIMECODE_EXTENSION_DATA timecode[2];
     } start;
 };
 
@@ -245,6 +255,12 @@ struct async_reader
     bool running;
     struct list async_ops;
 
+    /* started: a Start is queued or active (set under cs); paused is under
+     * callback_cs; rate scales the pacing of samples against the clock. */
+    bool started, paused;
+    REFERENCE_TIME pause_began;
+    float rate;
+
     bool user_clock;
     QWORD user_time;
 
@@ -634,8 +650,11 @@ static DWORD async_reader_get_wait_timeout(struct async_reader *reader, QWORD pt
 
     if (!reader->user_clock)
     {
+        current_time = (get_current_time(reader) - reader->clock_start) * (double)reader->rate;
+#ifdef SG_MUTANT_WMV_RATE
         current_time = get_current_time(reader) - reader->clock_start;
-        timeout = (pts - current_time) / 10000;
+#endif
+        timeout = (pts - current_time) / (double)reader->rate / 10000;
     }
 
     return pts > current_time ? timeout : 0;
@@ -658,6 +677,11 @@ static bool async_reader_wait_pts(struct async_reader *reader, QWORD pts)
 
     while (reader->running && list_empty(&reader->async_ops))
     {
+        if (reader->paused)
+        {
+            SleepConditionVariableCS(&reader->callback_cv, &reader->callback_cs, INFINITE);
+            continue;
+        }
         if (!(timeout = async_reader_get_wait_timeout(reader, pts)))
             return true;
         SleepConditionVariableCS(&reader->callback_cv, &reader->callback_cs, timeout);
@@ -706,6 +730,12 @@ static void callback_thread_run(struct async_reader *reader)
     {
         struct sample sample;
 
+        if (reader->paused)
+        {
+            SleepConditionVariableCS(&reader->callback_cv, &reader->callback_cs, INFINITE);
+            continue;
+        }
+
         LeaveCriticalSection(&reader->callback_cs);
         hr = IWMSyncReader2_GetNextSample(reader->reader, 0, &sample.buffer, &sample.pts,
                 &sample.duration, &sample.flags, &sample.output, &sample.stream);
@@ -775,8 +805,26 @@ static DWORD WINAPI async_reader_callback_thread(void *arg)
                 case ASYNC_OP_START:
                 {
                     reader->context = op->u.start.context;
+                    reader->paused = false;
+                    reader->rate = op->u.start.rate;
                     if (SUCCEEDED(hr))
-                        hr = IWMSyncReader2_SetRange(reader->reader, op->u.start.start, op->u.start.duration);
+                    {
+                        switch (op->u.start.range)
+                        {
+                            case START_RANGE_FRAMES:
+                                hr = IWMSyncReader2_SetRangeByFrame(reader->reader, op->u.start.stream,
+                                        op->u.start.start, op->u.start.duration);
+                                break;
+                            case START_RANGE_TIMECODE:
+                                hr = IWMSyncReader2_SetRangeByTimecode(reader->reader, op->u.start.stream,
+                                        &op->u.start.timecode[0], &op->u.start.timecode[1]);
+                                break;
+                            default:
+                                hr = IWMSyncReader2_SetRange(reader->reader, op->u.start.start,
+                                        op->u.start.duration);
+                                break;
+                        }
+                    }
                     if (SUCCEEDED(hr))
                         reader->clock_start = get_current_time(reader);
 
@@ -791,6 +839,7 @@ static DWORD WINAPI async_reader_callback_thread(void *arg)
                 }
 
                 case ASYNC_OP_STOP:
+                    reader->paused = false;
                     LeaveCriticalSection(&reader->callback_cs);
                     IWMReaderCallback_OnStatus(reader->callback, WMT_STOPPED, hr,
                             WMT_TYPE_DWORD, (BYTE *)&zero, reader->context);
@@ -1251,25 +1300,40 @@ static HRESULT WINAPI WMReader_GetOutputFormat(IWMReader *iface, DWORD output,
     return IWMSyncReader2_GetOutputFormat(reader->reader, output, index, props);
 }
 
+static HRESULT async_reader_start(struct async_reader *reader, union async_op_data *data);
+
 static HRESULT WINAPI WMReader_Start(IWMReader *iface,
         QWORD start, QWORD duration, float rate, void *context)
 {
-    union async_op_data data = {.start = {.start = start, .duration = duration, .context = context}};
+    union async_op_data data = {.start = {.start = start, .duration = duration, .context = context,
+            .rate = rate, .range = START_RANGE_TIME}};
     struct async_reader *reader = impl_from_IWMReader(iface);
-    HRESULT hr;
 
     TRACE("reader %p, start %s, duration %s, rate %.8e, context %p.\n",
             reader, debugstr_time(start), debugstr_time(duration), rate, context);
 
-    if (rate != 1.0f)
-        FIXME("Ignoring rate %.8e.\n", rate);
+    return async_reader_start(reader, &data);
+}
+
+static HRESULT async_reader_start(struct async_reader *reader, union async_op_data *data)
+{
+    HRESULT hr;
+
+    /* Only forward playback is paced here: reverse play needs backward seeking
+     * to key frames, which the parser cannot do. */
+    if (!isfinite(data->start.rate) || data->start.rate == 0.0f)
+        return E_INVALIDARG;
+#ifndef SG_MUTANT_WMV_REVERSE
+    if (data->start.rate < 0.0f)
+        return NS_E_INVALID_REQUEST;
+#endif
 
     EnterCriticalSection(&reader->cs);
 
     if (!reader->callback_thread)
         hr = NS_E_INVALID_REQUEST;
-    else
-        hr = async_reader_queue_op(reader, ASYNC_OP_START, &data);
+    else if (SUCCEEDED(hr = async_reader_queue_op(reader, ASYNC_OP_START, data)))
+        reader->started = true;
 
     LeaveCriticalSection(&reader->cs);
 
@@ -1287,26 +1351,77 @@ static HRESULT WINAPI WMReader_Stop(IWMReader *iface)
 
     if (!reader->callback_thread)
         hr = E_UNEXPECTED;
-    else
-        hr = async_reader_queue_op(reader, ASYNC_OP_STOP, NULL);
+    else if (SUCCEEDED(hr = async_reader_queue_op(reader, ASYNC_OP_STOP, NULL)))
+        reader->started = false;
 
     LeaveCriticalSection(&reader->cs);
 
     return hr;
 }
 
+/* Pause holds back the delivery of samples (and the reader's clock) until
+ * Resume; Stop or a new Start ends the pause. */
 static HRESULT WINAPI WMReader_Pause(IWMReader *iface)
 {
-    struct async_reader *This = impl_from_IWMReader(iface);
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+    struct async_reader *reader = impl_from_IWMReader(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("reader %p.\n", reader);
+
+    EnterCriticalSection(&reader->cs);
+
+    if (!reader->callback_thread)
+        hr = E_UNEXPECTED;
+    else if (!reader->started)
+        hr = NS_E_INVALID_REQUEST;
+    else
+    {
+        EnterCriticalSection(&reader->callback_cs);
+        if (!reader->paused)
+        {
+#ifndef SG_MUTANT_WMV_NOPAUSE
+            reader->paused = true;
+#endif
+            reader->pause_began = get_current_time(reader);
+        }
+        LeaveCriticalSection(&reader->callback_cs);
+        WakeConditionVariable(&reader->callback_cv);
+    }
+
+    LeaveCriticalSection(&reader->cs);
+    return hr;
 }
 
 static HRESULT WINAPI WMReader_Resume(IWMReader *iface)
 {
-    struct async_reader *This = impl_from_IWMReader(iface);
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+    struct async_reader *reader = impl_from_IWMReader(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("reader %p.\n", reader);
+
+    EnterCriticalSection(&reader->cs);
+
+    if (!reader->callback_thread)
+        hr = E_UNEXPECTED;
+    else if (!reader->started)
+        hr = NS_E_INVALID_REQUEST;
+    else
+    {
+        EnterCriticalSection(&reader->callback_cs);
+        if (reader->paused)
+        {
+            reader->paused = false;
+#ifndef SG_MUTANT_WMV_RESUMECLOCK
+            /* time spent paused does not count against the samples' timestamps */
+            reader->clock_start += get_current_time(reader) - reader->pause_began;
+#endif
+        }
+        LeaveCriticalSection(&reader->callback_cs);
+        WakeConditionVariable(&reader->callback_cv);
+    }
+
+    LeaveCriticalSection(&reader->cs);
+    return hr;
 }
 
 static const IWMReaderVtbl WMReaderVtbl = {
@@ -1986,6 +2101,7 @@ static HRESULT WINAPI WMReaderAdvanced3_StartAtPosition(IWMReaderAdvanced6 *ifac
         void *offset_start, void *duration, WMT_OFFSET_FORMAT format, float rate, void *context)
 {
     struct async_reader *reader = impl_from_IWMReaderAdvanced6(iface);
+    union async_op_data data = {.start = {.rate = rate, .context = context, .stream = stream_num}};
     QWORD start, length = 0;
 
     TRACE("reader %p, stream_num %u, offset_start %p, duration %p, format %d, rate %f, context %p.\n",
@@ -2004,10 +2120,29 @@ static HRESULT WINAPI WMReaderAdvanced3_StartAtPosition(IWMReaderAdvanced6 *ifac
             return IWMReader_Start(&reader->IWMReader_iface, start, length, rate, context);
 
         case WMT_OFFSET_FORMAT_FRAME_NUMBERS:
-        case WMT_OFFSET_FORMAT_PLAYLIST_OFFSET:
-        case WMT_OFFSET_FORMAT_TIMECODE:
-            FIXME("Offset format %d is not supported.\n", format);
+            /* a frame number and a frame count on a video stream */
+#ifdef SG_MUTANT_WMV_STARTAT
             return E_NOTIMPL;
+#endif
+            data.start.range = START_RANGE_FRAMES;
+            data.start.start = *(QWORD *)offset_start;
+            if (duration)
+                data.start.duration = *(QWORD *)duration;
+            return async_reader_start(reader, &data);
+
+        case WMT_OFFSET_FORMAT_TIMECODE:
+            /* a start and an end WMT_TIMECODE_EXTENSION_DATA */
+            if (!duration)
+                return E_INVALIDARG;
+            data.start.range = START_RANGE_TIMECODE;
+            data.start.timecode[0] = *(WMT_TIMECODE_EXTENSION_DATA *)offset_start;
+            data.start.timecode[1] = *(WMT_TIMECODE_EXTENSION_DATA *)duration;
+            return async_reader_start(reader, &data);
+
+        case WMT_OFFSET_FORMAT_PLAYLIST_OFFSET:
+            /* playlist positions only exist for playlist (ASX) sources, never a file */
+            WARN("Playlist offsets need a playlist source.\n");
+            return NS_E_INVALID_REQUEST;
 
         default:
             return E_INVALIDARG;
@@ -2194,9 +2329,15 @@ static HRESULT WINAPI WMReaderAdvanced6_SetProtectStreamSamples(IWMReaderAdvance
 {
     struct async_reader *reader = impl_from_IWMReaderAdvanced6(iface);
 
-    FIXME("reader %p, cert %p, cert_size %lu, cert_type %#lx, flags %#lx, vector %p, vector_size %p, stub!\n",
+    TRACE("reader %p, cert %p, cert_size %lu, cert_type %#lx, flags %#lx, vector %p, vector_size %p.\n",
             reader, cert, cert_size, cert_type, flags, initialization_vector, initialization_vector_size);
 
+    if (!cert || !cert_size || !initialization_vector_size)
+        return E_INVALIDARG;
+
+    /* Re-encrypting samples for a protected pipeline needs a content protection
+     * engine; without one the request is refused, content is not protected. */
+    WARN("Protecting stream samples is not supported.\n");
     return E_NOTIMPL;
 }
 
@@ -2281,18 +2422,35 @@ static HRESULT WINAPI reader_accl_GetCodecInterface(IWMReaderAccelerator *iface,
 {
     struct async_reader *reader = impl_from_IWMReaderAccelerator(iface);
 
-    FIXME("reader %p, output %lu, iid %s, codec %p, stub!\n", reader, output, debugstr_guid(riid), codec);
+    DWORD count;
+
+    TRACE("reader %p, output %lu, iid %s, codec %p.\n", reader, output, debugstr_guid(riid), codec);
 
-    return E_NOTIMPL;
+    if (!codec)
+        return E_POINTER;
+    *codec = NULL;
+    if (FAILED(IWMSyncReader2_GetOutputCount(reader->reader, &count)) || output >= count)
+        return E_INVALIDARG;
+
+    /* only a hardware accelerated decoder hands out a codec interface */
+    return E_NOINTERFACE;
 }
 
 static HRESULT WINAPI reader_accl_Notify(IWMReaderAccelerator *iface, DWORD output, WM_MEDIA_TYPE *subtype)
 {
     struct async_reader *reader = impl_from_IWMReaderAccelerator(iface);
 
-    FIXME("reader %p, output %lu, subtype %p, stub!\n", reader, output, subtype);
+    DWORD count;
+
+    TRACE("reader %p, output %lu, subtype %p.\n", reader, output, subtype);
 
-    return E_NOTIMPL;
+    if (!subtype)
+        return E_POINTER;
+    if (FAILED(IWMSyncReader2_GetOutputCount(reader->reader, &count)) || output >= count)
+        return E_INVALIDARG;
+
+    /* nothing to renegotiate without an accelerated decoder */
+    return S_OK;
 }
 
