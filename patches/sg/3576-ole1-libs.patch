 OLESTATUS WINAPI OleRegisterClientDoc(LPCSTR classname, LPCSTR docname,
-                                        LONG reserved, LHCLIENTDOC *hRet )
+                                      LONG reserved, LHCLIENTDOC *hRet)
 {
-    FIXME("(%s,%s,...): stub\n",classname,docname);
-    *hRet=++OLE_current_handle;
+    struct client_doc *d;
+
+    TRACE("(%s,%s,%ld,%p)\n", debugstr_a(classname), debugstr_a(docname), reserved, hRet);
+
+    if (!hRet) return OLE_ERROR_ADDRESS;
+    *hRet = 0;
+    if (!classname || !*classname || !docname || !*docname
+        || strlen(classname) >= MAX_PATH || strlen(docname) >= MAX_PATH)
+        return OLE_ERROR_NAME;
+    if (!(d = calloc(1, sizeof(*d)))) return OLE_ERROR_MEMORY;
+    strcpy(d->classname, classname);
+    strcpy(d->docname, docname);
+    EnterCriticalSection(&ole_cs);
+    d->handle = ++OLE_current_handle;
+    list_add_tail(&client_docs, &d->entry);
+    LeaveCriticalSection(&ole_cs);
+    *hRet = d->handle;
     return OLE_OK;
 }
 
+/******************************************************************************
+ *		OleRevokeClientDoc	[OLECLI32.42]
+ */
+OLESTATUS WINAPI OleRevokeClientDoc(LHCLIENTDOC hDoc)
+{
+    struct client_doc *d;
+    OLESTATUS ret = OLE_OK;
+
+    TRACE("(%ld)\n", hDoc);
+
+    EnterCriticalSection(&ole_cs);
+    if (!(d = find_client_doc(hDoc))) ret = OLE_ERROR_HANDLE;
+    else
+    {
+        list_remove(&d->entry);
+        free(d);
+    }
+    LeaveCriticalSection(&ole_cs);
+    return ret;
+}
+
 /******************************************************************************
  *		OleRenameClientDoc	[OLECLI32.43]
  */
 OLESTATUS WINAPI OleRenameClientDoc(LHCLIENTDOC hDoc, LPCSTR newName)
 {
-    FIXME("(%ld,%s,...): stub\n",hDoc, newName);
-    return OLE_OK;
+    struct client_doc *d;
+    OLESTATUS ret = OLE_OK;
+
+    TRACE("(%ld,%s)\n", hDoc, debugstr_a(newName));
+
+    if (!newName || !*newName || strlen(newName) >= MAX_PATH) return OLE_ERROR_NAME;
+    EnterCriticalSection(&ole_cs);
+    if (!(d = find_client_doc(hDoc))) ret = OLE_ERROR_HANDLE;
+    else strcpy(d->docname, newName);
+    LeaveCriticalSection(&ole_cs);
+    return ret;
+}
+
+static OLESTATUS check_client_doc(LHCLIENTDOC hDoc)
+{
+    OLESTATUS ret;
+
+    EnterCriticalSection(&ole_cs);
+    ret = find_client_doc(hDoc) ? OLE_OK : OLE_ERROR_HANDLE;
+    LeaveCriticalSection(&ole_cs);
+    return ret;
 }
 
