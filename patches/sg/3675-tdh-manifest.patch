+static struct manifest *manifests;
+
+static WCHAR *dup_str(const WCHAR *s) { return s ? wcsdup(s) : NULL; }
+
+#define GROW(arr, count) \
+    ((arr) = realloc((arr), ((count) + 1) * sizeof(*(arr))), memset(&(arr)[(count)], 0, sizeof(*(arr))), &(arr)[(count)++])
+
+struct attrs { WCHAR *name[24]; WCHAR *value[24]; int count; };
+
+static const WCHAR *attr(const struct attrs *a, const WCHAR *name)
+{
+    int i;
+    for (i = 0; i < a->count; i++) if (!wcscmp(a->name[i], name)) return a->value[i];
+    return NULL;
+}
+
+static void free_attrs(struct attrs *a)
+{
+    int i;
+    for (i = 0; i < a->count; i++) { free(a->name[i]); free(a->value[i]); }
+    a->count = 0;
+}
+
+static ULONGLONG parse_number(const WCHAR *s)
+{
+    if (!s) return 0;
+    return wcstoull(s, NULL, 0);
+}
