+#ifndef __WINE_TDH_PRIVATE_H
+#define __WINE_TDH_PRIVATE_H
+
+/* the public layouts of the Trace Data Helper structures (MS documentation of TRACE_EVENT_INFO and EVENT_PROPERTY_INFO) */
+typedef struct
+{
+    ULONG Flags;
+    ULONG NameOffset;
+    union
+    {
+        struct { USHORT InType; USHORT OutType; ULONG MapNameOffset; } nonStructType;
+        struct { USHORT StructStartIndex; USHORT NumOfStructMembers; ULONG padding; } structType;
+    } u;
+    USHORT count;
+    USHORT length;
+    ULONG Reserved;
+} EVENT_PROPERTY_INFO_PUBLIC;
+
+typedef struct
+{
+    GUID ProviderGuid;
+    GUID EventGuid;
+    EVENT_DESCRIPTOR EventDescriptor;
+    ULONG DecodingSource;
+    ULONG ProviderNameOffset;
+    ULONG LevelNameOffset;
+    ULONG ChannelNameOffset;
+    ULONG KeywordsNameOffset;
+    ULONG TaskNameOffset;
+    ULONG OpcodeNameOffset;
+    ULONG EventMessageOffset;
+    ULONG ProviderMessageOffset;
+    ULONG BinaryXMLOffset;
+    ULONG BinaryXMLSize;
+    ULONG ActivityIDNameOffset;
+    ULONG RelatedActivityIDNameOffset;
+    ULONG PropertyCount;
+    ULONG TopLevelPropertyCount;
+    ULONG Flags;
+    EVENT_PROPERTY_INFO_PUBLIC EventPropertyInfoArray[1];
+} TRACE_EVENT_INFO_PUBLIC;
+
+ULONG tdh_get_event_info(const EVENT_RECORD *event, TRACE_EVENT_INFO_PUBLIC *out, ULONG *size);
+ULONG tdh_load_manifest(const WCHAR *path);
+ULONG tdh_unload_manifest(const WCHAR *path);
+
+#endif
