+struct named { WCHAR *name; WCHAR *message; WCHAR *id; ULONGLONG value; };
+struct data_item
+{
+    WCHAR *name, *in_type, *out_type, *count, *length, *map;
+    BOOL is_struct;
+    ULONG struct_members;       /* for a struct: the next struct_members data items are its members */
+};
+struct template { WCHAR *tid; struct data_item *items; ULONG count; };
+struct event
+{
+    USHORT id; UCHAR version, level, opcode, channel; USHORT task; ULONGLONG keywords;
