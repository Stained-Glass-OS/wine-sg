From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] net, mpr, explorer, comctl32: network drive errors read as on Windows; See more's tooltip stays off its menu

Three things from the SMB walk:

- NET USE with a wrong password printed only "Logon failure.". Windows'
  NET USE prints "System error 1326 has occurred.", a blank line, and
  "The user name or password is incorrect." -- the message Windows has for
  ERROR_LOGON_FAILURE, which kernelbase's message table now has too. Any
  NET USE failure is reported in that form ("System error N has
  occurred." and the system's message).

- A drive remembered with "Reconnect at sign-in" whose server could not
  be reached, or refused it, at sign-in was simply missing. Windows says
  so: a notification, "Could not reconnect all network drives". mpr's
  SgRestoreConnections (the shell runs it at sign-in, 0839) now shows it
  from the notification area -- the shell keeps it in the notification
  centre too -- and selecting it opens This PC in File Explorer.

- File Explorer's "See more" (...) button: clicked before its tooltip had
  come up, the tooltip came up anyway, over the first item of the menu
  the click had opened. File Explorer now hides its tooltips while one of
  its menus is open (TTM_POP, TTM_ACTIVATE), and comctl32's tooltip, made
  inactive, no longer shows itself when the delay already running ends
  (Windows' does not).

Test: test/smberrors-gate.sh with test/smberrors-probe.c and
test/mapcred-netmountd.py (mutants SG_MUTANT_NETUSE_NO_SYSERR in
programs/net/net.c, SG_MUTANT_NO_RECONNECT_NOTICE in dlls/mpr/wnet.c,
SG_MUTANT_MENU_UNDER_TOOLTIP in programs/explorer/fileexplorer.c and
dlls/comctl32/tooltips.c).
---
--- a/programs/net/net.c
+++ b/programs/net/net.c
@@ -248,7 +248,15 @@
         }
         if (rc != NO_ERROR)
         {
+#ifndef SG_MUTANT_NETUSE_NO_SYSERR
+            /* as Windows' NET USE: "System error 1326 has occurred.", a
+             * blank line, the message, a blank line */
+            output_string(STRING_SYSTEM_ERROR, rc);
             output_error_string(rc);
+            output_printf(L"\n");
+#else
+            output_error_string(rc);
+#endif
             return FALSE;
         }
         output_string(STRING_CMD_SUCCESS);
--- a/programs/net/net.rc
+++ b/programs/net/net.rc
@@ -43,6 +43,7 @@
     STRING_CONFLICT_SWITCHES, "A command was used with conflicting switches.\n"
     STRING_NO_ENTRIES, "There are no entries in the list.\n"
     STRING_CMD_SUCCESS, "The command completed successfully.\n"
+    STRING_SYSTEM_ERROR, "System error %1!u! has occurred.\n\n"
     STRING_USE_USAGE, "Usage:\n\nNET USE [device:] [\\\\computer\\share[\\directory]] [password | *] [/USER:[domain\\]name]\n        [/PERSISTENT:{YES | NO}] [/SAVECRED]\nNET USE device: /DELETE\n"
     STRING_USE_HEADER, "\nStatus       Local     Remote\n\n-------------------------------------------------------------------------------\n"
     STRING_USE_ENTRY,  "%1!-13s!%2!-10s!%3\n"
--- a/programs/net/resources.h
+++ b/programs/net/resources.h
@@ -44,3 +44,4 @@
 #define STRING_CONFLICT_SWITCHES  125
 #define STRING_CMD_SUCCESS        126
 #define STRING_USE_USAGE          127
+#define STRING_SYSTEM_ERROR       128
--- a/dlls/kernelbase/winerror.mc
+++ b/dlls/kernelbase/winerror.mc
@@ -2033,7 +2033,7 @@
 MessageId=1326
 SymbolicName=ERROR_LOGON_FAILURE
 Language=ENU
-Logon failure.
+The user name or password is incorrect.
 .
 MessageId=1327
 SymbolicName=ERROR_ACCOUNT_RESTRICTION
--- a/dlls/mpr/wnet.c
+++ b/dlls/mpr/wnet.c
@@ -31,6 +31,7 @@
 #include "winreg.h"
 #include "winuser.h"
 #include "wincred.h"
+#include "shellapi.h"
 #define WINE_MOUNTMGR_EXTENSIONS
 #include "ddk/mountmgr.h"
 #include "wine/debug.h"
@@ -2391,9 +2392,93 @@
 /* Stained Glass OS: "rundll32 mpr.dll,SgRestoreConnections" -- the shell
  * reconnects the remembered drives at sign-in in a process of its own (a
  * server out of reach must not hold up the desktop) */
+#define WM_SG_RECONNECT_TRAY (WM_APP + 1)
+
+static LRESULT CALLBACK reconnect_notify_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    if (msg == WM_SG_RECONNECT_TRAY)
+    {
+        switch (LOWORD( lp ))
+        {
+        case NIN_BALLOONUSERCLICK:
+        {
+            /* the drives, in File Explorer's This PC */
+            HINSTANCE (WINAPI *shell_execute)( HWND, const WCHAR *, const WCHAR *, const WCHAR *, const WCHAR *, INT );
+            shell_execute = (void *)GetProcAddress( LoadLibraryW( L"shell32.dll" ), "ShellExecuteW" );
+            if (shell_execute) shell_execute( NULL, NULL, L"explorer.exe", L"shell:MyComputerFolder", NULL, SW_SHOWNORMAL );
+            DestroyWindow( hwnd );
+            break;
+        }
+        case NIN_BALLOONTIMEOUT:
+            DestroyWindow( hwnd );
+            break;
+        }
+        return 0;
+    }
+    if (msg == WM_TIMER) { DestroyWindow( hwnd ); return 0; }
+    if (msg == WM_DESTROY) { PostQuitMessage( 0 ); return 0; }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+/* Stained Glass OS: a remembered drive that could not be connected again at
+ * sign-in gets a notification, as on Windows: "Could not reconnect all
+ * network drives"; selecting it shows the drives in File Explorer. From the
+ * notification area (the shell keeps it in the notification centre too). */
+static void notify_reconnect_failed(void)
+{
+    BOOL (WINAPI *notify_icon)( DWORD, NOTIFYICONDATAW * );
+    HMODULE shell32 = LoadLibraryW( L"shell32.dll" );
+    NOTIFYICONDATAW nid = { sizeof(nid) };
+    WNDCLASSW wc = { 0 };
+    HWND hwnd;
+    MSG msg;
+    int i;
+
+    if (!shell32 || !(notify_icon = (void *)GetProcAddress( shell32, "Shell_NotifyIconW" ))) return;
+    wc.lpfnWndProc = reconnect_notify_proc;
+    wc.hInstance = GetModuleHandleW( NULL );
+    wc.lpszClassName = L"SgReconnectNotify";
+    RegisterClassW( &wc );
+    if (!(hwnd = CreateWindowW( L"SgReconnectNotify", L"", 0, 0, 0, 0, 0, NULL, NULL, wc.hInstance, NULL ))) return;
+    nid.hWnd = hwnd;
+    nid.uID = 1;
+    nid.uFlags = NIF_MESSAGE | NIF_ICON | NIF_TIP | NIF_INFO;
+    nid.uCallbackMessage = WM_SG_RECONNECT_TRAY;
+    nid.hIcon = LoadImageW( shell32, MAKEINTRESOURCEW(10), IMAGE_ICON, 0, 0, LR_DEFAULTSIZE );  /* a network drive */
+    if (!nid.hIcon) nid.hIcon = LoadIconW( NULL, (const WCHAR *)IDI_WARNING );
+    lstrcpyW( nid.szTip, L"File Explorer" );
+    lstrcpyW( nid.szInfoTitle, L"Could not reconnect all network drives" );
+    lstrcpyW( nid.szInfo, L"Select here to see your network drives in File Explorer." );
+    nid.dwInfoFlags = NIIF_WARNING;
+    /* the shell's notification area may still be starting (this runs at sign-in) */
+    for (i = 0; i < 60 && !notify_icon( NIM_ADD, &nid ); i++) Sleep( 500 );
+    if (i == 60)
+    {
+        DestroyWindow( hwnd );
+        return;
+    }
+    nid.uVersion = NOTIFYICON_VERSION_4;
+    notify_icon( NIM_SETVERSION, &nid );
+    SetTimer( hwnd, 1, 60000, NULL );   /* no longer than a minute in any case */
+    while (GetMessageW( &msg, NULL, 0, 0 ))
+    {
+        TranslateMessage( &msg );
+        DispatchMessageW( &msg );
+    }
+    notify_icon( NIM_DELETE, &nid );
+}
+
 void WINAPI SgRestoreConnectionsW( HWND hwnd, HINSTANCE inst, WCHAR *cmdline, int show )
 {
-    WNetRestoreConnectionW( NULL, NULL );
+    DWORD ret = WNetRestoreConnectionW( NULL, NULL );
+
+#ifndef SG_MUTANT_NO_RECONNECT_NOTICE
+    if (ret != WN_SUCCESS)
+    {
+        TRACE( "a remembered drive was not reconnected (%lu)\n", ret );
+        notify_reconnect_failed();
+    }
+#endif
 }
 
 /**************************************************************************
--- a/programs/explorer/fileexplorer.c
+++ b/programs/explorer/fileexplorer.c
@@ -1065,8 +1065,20 @@
     int ret;
 
     MapWindowPoints(owner, NULL, (POINT *)&rc, 2);
+#ifndef SG_MUTANT_MENU_UNDER_TOOLTIP
+    /* the button's tooltip ("See more") goes, and stays away while its menu
+     * is open: it covered the menu's first item */
+    if (fe.tooltip)
+    {
+        SendMessageW(fe.tooltip, TTM_POP, 0, 0);
+        SendMessageW(fe.tooltip, TTM_ACTIVATE, FALSE, 0);
+    }
+#endif
     ret = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_LEFTALIGN | TPM_TOPALIGN | TPM_NONOTIFY,
                          rc.left, rc.bottom, 0, fe.hwnd, NULL);
+#ifndef SG_MUTANT_MENU_UNDER_TOOLTIP
+    if (fe.tooltip) SendMessageW(fe.tooltip, TTM_ACTIVATE, TRUE, 0);
+#endif
     DestroyMenu(menu);
     return ret;
 }
--- a/dlls/comctl32/tooltips.c
+++ b/dlls/comctl32/tooltips.c
@@ -1035,6 +1035,13 @@
 
     if (!(infoPtr->bActive) && (infoPtr->nCurrentTool != -1))
 	TOOLTIPS_Hide (infoPtr);
+#ifndef SG_MUTANT_MENU_UNDER_TOOLTIP
+    /* Stained Glass OS: a tooltip made inactive does not come up later
+     * either: the delay already running showed it anyway -- File Explorer's
+     * "See more" tooltip over the first item of the menu it had just opened */
+    if (!infoPtr->bActive)
+        KillTimer (infoPtr->hwndSelf, ID_TIMERSHOW);
+#endif
 
     return 0;
 }
@@ -2027,6 +2034,9 @@
     switch (iTimer) {
     case ID_TIMERSHOW:
         KillTimer (infoPtr->hwndSelf, ID_TIMERSHOW);
+#ifndef SG_MUTANT_MENU_UNDER_TOOLTIP
+        if (!infoPtr->bActive) break;   /* Stained Glass OS: see TOOLTIPS_Activate */
+#endif
 	nOldTool = infoPtr->nTool;
 	if ((infoPtr->nTool = TOOLTIPS_CheckTool (infoPtr, TRUE)) == nOldTool)
 	    TOOLTIPS_Show (infoPtr, FALSE);
