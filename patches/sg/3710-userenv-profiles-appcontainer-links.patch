-BOOL WINAPI LoadUserProfileA( HANDLE hToken, LPPROFILEINFOA lpProfileInfo )
+/* The process token's administrative standing: LoadUserProfile and
+ * UnloadUserProfile need an administrator (enabled Administrators group, not a
+ * filtered token's deny-only one) or LocalSystem, holding SeBackupPrivilege and
+ * SeRestorePrivilege. Impersonating one is not enough, so the process token is
+ * looked at, not the thread's. */
+static BOOL caller_may_load_profiles(void)
 {
-    FIXME("%p %p\n", hToken, lpProfileInfo );
-    lpProfileInfo->hProfile = HKEY_CURRENT_USER;
-    return TRUE;
+    SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    PSID admins = NULL, system = NULL;
+    TOKEN_PRIVILEGES *privs = NULL;
+    TOKEN_GROUPS *groups = NULL;
+    TOKEN_USER *user = NULL;
+    LUID backup, restore;
+    BOOL ok = FALSE, has_backup = FALSE, has_restore = FALSE, admin = FALSE;
+    HANDLE token;
+    DWORD len, i;
+
+    if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return FALSE;
+    if (!LookupPrivilegeValueW( NULL, L"SeBackupPrivilege", &backup ) ||
+        !LookupPrivilegeValueW( NULL, L"SeRestorePrivilege", &restore )) goto done;
+    if (!AllocateAndInitializeSid( &nt, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS,
+                                   0, 0, 0, 0, 0, 0, &admins )) goto done;
+    if (!AllocateAndInitializeSid( &nt, 1, SECURITY_LOCAL_SYSTEM_RID, 0, 0, 0, 0, 0, 0, 0, &system )) goto done;
+
+    GetTokenInformation( token, TokenUser, NULL, 0, &len );
+    if (!(user = HeapAlloc( GetProcessHeap(), 0, len )) ||
+        !GetTokenInformation( token, TokenUser, user, len, &len )) goto done;
+    admin = EqualSid( user->User.Sid, system );
+    if (!admin)
+    {
+        GetTokenInformation( token, TokenGroups, NULL, 0, &len );
+        if (!(groups = HeapAlloc( GetProcessHeap(), 0, len )) ||
+            !GetTokenInformation( token, TokenGroups, groups, len, &len )) goto done;
+        for (i = 0; i < groups->GroupCount; i++)
+            if ((groups->Groups[i].Attributes & SE_GROUP_ENABLED) && EqualSid( groups->Groups[i].Sid, admins ))
+                admin = TRUE;
+    }
+#ifdef SG_MUTANT_NO_ADMIN_CHECK
+    admin = TRUE;
+#endif
+    if (!admin)
+    {
+        SetLastError( ERROR_ACCESS_DENIED );
+        goto done;
+    }
+
+    GetTokenInformation( token, TokenPrivileges, NULL, 0, &len );
+    if (!(privs = HeapAlloc( GetProcessHeap(), 0, len )) ||
+        !GetTokenInformation( token, TokenPrivileges, privs, len, &len )) goto done;
+    for (i = 0; i < privs->PrivilegeCount; i++)
+    {
+        LUID *l = &privs->Privileges[i].Luid;
+        if (l->LowPart == backup.LowPart && l->HighPart == backup.HighPart) has_backup = TRUE;
+        if (l->LowPart == restore.LowPart && l->HighPart == restore.HighPart) has_restore = TRUE;
+    }
+#ifdef SG_MUTANT_NO_PRIV_CHECK
+    has_backup = has_restore = TRUE;
+#endif
+    if (!has_backup || !has_restore) SetLastError( ERROR_PRIVILEGE_NOT_HELD );
+    else ok = TRUE;
+
+done:
+    HeapFree( GetProcessHeap(), 0, privs );
+    HeapFree( GetProcessHeap(), 0, groups );
+    HeapFree( GetProcessHeap(), 0, user );
+    if (admins) FreeSid( admins );
+    if (system) FreeSid( system );
+    CloseHandle( token );
+    return ok;
 }
 
 BOOL WINAPI LoadUserProfileW( HANDLE hToken, LPPROFILEINFOW lpProfileInfo )
 {
-    FIXME("%p %p\n", hToken, lpProfileInfo );
-    lpProfileInfo->hProfile = HKEY_CURRENT_USER;
-    return TRUE;
+    WCHAR *sid_str = NULL, dir[MAX_PATH];
