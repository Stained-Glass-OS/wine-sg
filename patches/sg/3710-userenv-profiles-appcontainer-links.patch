+    if (display_name && wcslen( display_name ) > 512) return E_INVALIDARG;
+    if (description && wcslen( description ) > 2048) return E_INVALIDARG;
+    if (capability_count && !capabilities) return E_INVALIDARG;
+    if (in_app_container()) return E_ACCESSDENIED;
+
+    if (FAILED(hr = DeriveAppContainerSidFromAppContainerName( container_name, &sid ))) return hr;
+    if (!ConvertSidToStringSidW( sid, &sid_str ))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        goto done;
+    }
+
+    wsprintfW( key_name, L"%s\\Mappings\\%s", ac_root, sid_str );
+    if ((err = RegCreateKeyExW( HKEY_CURRENT_USER, key_name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, &disp )))
+    {
+        hr = err == ERROR_ACCESS_DENIED ? E_ACCESSDENIED : HRESULT_FROM_WIN32( err );
+        goto done;
+    }
+#ifdef SG_MUTANT_AC_EXISTS_OK
+    if (0)
+#else
+    if (disp == REG_OPENED_EXISTING_KEY)
+#endif
+    {
+        hr = HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS );
+        goto done;
+    }
+
+    /* the capabilities, as string SIDs in a multi-string */
+    len = 1;
+    for (i = 0; i < capability_count; i++)
+    {
+        WCHAR *str;
+        if (!capabilities[i].Sid || !ConvertSidToStringSidW( capabilities[i].Sid, &str ))
+        {
+            hr = E_INVALIDARG;
+            goto fail;
+        }
+        len += wcslen( str ) + 1;
+        LocalFree( str );
+    }
+    if (!(caps = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, (len + 1) * sizeof(WCHAR) )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
+    for (i = 0, p = caps; i < capability_count; i++)
+    {
+        WCHAR *str;
+        ConvertSidToStringSidW( capabilities[i].Sid, &str );
+        wcscpy( p, str );
+        p += wcslen( str ) + 1;
+        LocalFree( str );
+    }
+
+    RegSetValueExW( key, L"Moniker", 0, REG_SZ, (const BYTE *)container_name, (wcslen( container_name ) + 1) * sizeof(WCHAR) );
+    if (!display_name) display_name = L"";
+    RegSetValueExW( key, L"DisplayName", 0, REG_SZ, (const BYTE *)display_name, (wcslen( display_name ) + 1) * sizeof(WCHAR) );
+    if (!description) description = L"";
+    RegSetValueExW( key, L"Description", 0, REG_SZ, (const BYTE *)description, (wcslen( description ) + 1) * sizeof(WCHAR) );
+    RegSetValueExW( key, L"Capabilities", 0, REG_MULTI_SZ, (const BYTE *)caps, (p - caps + 1) * sizeof(WCHAR) );
+
+    /* the registry storage of the profile */
+    wsprintfW( key_name, L"%s\\Storage\\%s", ac_root, container_name );
+    if (!(err = RegCreateKeyExW( HKEY_CURRENT_USER, key_name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &root, NULL ))) RegCloseKey( root );
+
+    /* the folders, readable by the user, the container and the system only */
+#ifdef SG_MUTANT_AC_NODIR
+    if (0)
+#else
+    if (ac_packages_dir( container_name, dir ))
+#endif
+    {
+        BYTE tokbuf[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE];
+        HANDLE token;
+
+        if (OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+        {
+            if (GetTokenInformation( token, TokenUser, tokbuf, sizeof(tokbuf), &len ))
+            {
+                WCHAR sddl[256];
+                ConvertSidToStringSidW( ((TOKEN_USER *)tokbuf)->User.Sid, &user_str );
+                wsprintfW( sddl, L"D:PAI(A;OICI;FA;;;%s)(A;OICI;FA;;;SY)(A;OICI;FA;;;%s)", user_str, sid_str );
+                if (!ConvertStringSecurityDescriptorToSecurityDescriptorW( sddl, SDDL_REVISION_1, &sa.lpSecurityDescriptor, NULL ))
+                    sa.lpSecurityDescriptor = NULL;
+            }
+            CloseHandle( token );
+        }
+        SHCreateDirectoryExW( NULL, dir, sa.lpSecurityDescriptor ? &sa : NULL );
+        for (i = 0; i < ARRAY_SIZE(subdirs); i++)
+        {
+            wsprintfW( sub, L"%s\\%s", dir, subdirs[i] );
+            CreateDirectoryW( sub, sa.lpSecurityDescriptor ? &sa : NULL );
+        }
+        if (sa.lpSecurityDescriptor) LocalFree( sa.lpSecurityDescriptor );
+    }
+
+    *container_sid = sid;
+    sid = NULL;
+    hr = S_OK;
+    goto done;
+
+fail:
+    RegCloseKey( key );
+    key = NULL;
+    wsprintfW( key_name, L"%s\\Mappings\\%s", ac_root, sid_str );
+    RegDeleteKeyW( HKEY_CURRENT_USER, key_name );
+
+done:
+    if (key) RegCloseKey( key );
+    HeapFree( GetProcessHeap(), 0, caps );
+    LocalFree( user_str );
+    LocalFree( sid_str );
+    if (sid) FreeSid( sid );
+    return hr;
+}
+
+HRESULT WINAPI DeleteAppContainerProfile(PCWSTR container_name)
+{
+    WCHAR key_name[MAX_PATH], dir[MAX_PATH], *sid_str;
+    PSID sid;
+    HRESULT hr;
+
+    TRACE("(%s)\n", debugstr_w(container_name));
+
+    if (!valid_ac_name( container_name )) return E_INVALIDARG;
+    if (in_app_container()) return HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED );
+    if (FAILED(hr = DeriveAppContainerSidFromAppContainerName( container_name, &sid ))) return hr;
+    if (!ConvertSidToStringSidW( sid, &sid_str ))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        FreeSid( sid );
+        return hr;
+    }
+    wsprintfW( key_name, L"%s\\Mappings\\%s", ac_root, sid_str );
+    RegDeleteTreeW( HKEY_CURRENT_USER, key_name );
+    RegDeleteKeyW( HKEY_CURRENT_USER, key_name );
+    wsprintfW( key_name, L"%s\\Storage\\%s", ac_root, container_name );
+    RegDeleteTreeW( HKEY_CURRENT_USER, key_name );
+    RegDeleteKeyW( HKEY_CURRENT_USER, key_name );
+#ifndef SG_MUTANT_AC_KEEP_DIR
+    if (ac_packages_dir( container_name, dir )) delete_tree( dir );
+#endif
+    LocalFree( sid_str );
+    FreeSid( sid );
+    return S_OK;  /* deleting a profile that does not exist succeeds */
+}
+
+/* the moniker (name) of a container from its string SID */
+static BOOL ac_moniker( const WCHAR *sid_str, WCHAR *name, DWORD size )
+{
+    WCHAR key_name[MAX_PATH];
+    HKEY key;
+    DWORD type, len = size;
+    LONG err;
+
+    wsprintfW( key_name, L"%s\\Mappings\\%s", ac_root, sid_str );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, key_name, 0, KEY_READ, &key )) return FALSE;
+    err = RegQueryValueExW( key, L"Moniker", NULL, &type, (BYTE *)name, &len );
+    RegCloseKey( key );
+    return !err && type == REG_SZ;
+}
+
+HRESULT WINAPI GetAppContainerFolderPath(PCWSTR sid_str, PWSTR *path)
+{
+    WCHAR name[80], dir[MAX_PATH];
+
+    TRACE("(%s, %p)\n", debugstr_w(sid_str), path);
+
+    if (!sid_str || !path) return E_INVALIDARG;
+    *path = NULL;
+    if (!ac_moniker( sid_str, name, sizeof(name) )) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    if (!ac_packages_dir( name, dir )) return E_FAIL;
+    if (!(*path = CoTaskMemAlloc( (wcslen( dir ) + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    wcscpy( *path, dir );
+    return S_OK;
+}
+
+HRESULT WINAPI GetAppContainerRegistryLocation(REGSAM access, PHKEY ret_key)
+{
+    WCHAR key_name[MAX_PATH], name[80], *sid_str = NULL;
+    TOKEN_APPCONTAINER_INFORMATION *info;
+    BYTE buffer[sizeof(*info) + SECURITY_MAX_SID_SIZE];
+    HANDLE token;
+    HRESULT hr = E_INVALIDARG;
+    DWORD len;
+    HKEY key;
+    LONG err;
+
+    TRACE("(%#lx, %p)\n", access, ret_key);
+
+    if (!ret_key) return E_INVALIDARG;
+    *ret_key = NULL;
+    if (!OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ) &&
+        !OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return HRESULT_FROM_WIN32( GetLastError() );
+    info = (TOKEN_APPCONTAINER_INFORMATION *)buffer;
+    /* a caller that is not in an AppContainer has no profile to open */
+    if (GetTokenInformation( token, TokenAppContainerSid, buffer, sizeof(buffer), &len ) && info->TokenAppContainer &&
+        ConvertSidToStringSidW( info->TokenAppContainer, &sid_str ))
+    {
+        if (ac_moniker( sid_str, name, sizeof(name) ))
+        {
+            wsprintfW( key_name, L"%s\\Storage\\%s", ac_root, name );
+            if (!(err = RegCreateKeyExW( HKEY_CURRENT_USER, key_name, 0, NULL, 0, access, NULL, &key, NULL )))
+            {
+                *ret_key = key;
+                hr = S_OK;
+            }
+            else hr = HRESULT_FROM_WIN32( err );
+        }
+        LocalFree( sid_str );
+    }
+    CloseHandle( token );
+    return hr;
 }
