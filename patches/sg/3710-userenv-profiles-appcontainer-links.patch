+        return FALSE;
+    }
+    if (!hToken || hToken == INVALID_HANDLE_VALUE)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    if (!caller_may_load_profiles()) return FALSE;
+
+    GetTokenInformation( hToken, TokenUser, NULL, 0, &len );
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER) return FALSE;
+    if (!(user = HeapAlloc( GetProcessHeap(), 0, len ))) return FALSE;
+    if (!GetTokenInformation( hToken, TokenUser, user, len, &len )) goto done;
+    if (!ConvertSidToStringSidW( user->User.Sid, &sid_str )) goto done;
+
+    /* the profile directory is made when it is missing, as a first load does */
+    len = ARRAY_SIZE(dir);
+    if (GetUserProfileDirectoryW( hToken, dir, &len )) CreateDirectoryW( dir, NULL );
+
+    /* the user's hive is HKEY_USERS\<sid>; the server loads it on demand. The
+     * handle is opened for full access and stays the caller's until
+     * UnloadUserProfile closes it. */
+    if ((err = RegCreateKeyExW( HKEY_USERS, sid_str, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, &disp )))
+    {
+        SetLastError( err );
+        goto done;
+    }
+#ifdef SG_MUTANT_LOAD_HKCU
+    RegCloseKey( key );
+    key = HKEY_CURRENT_USER;
+#endif
+    lpProfileInfo->hProfile = key;
+    ret = TRUE;
+
+done:
+    LocalFree( sid_str );
+    HeapFree( GetProcessHeap(), 0, user );
+    return ret;
+}
+
+static WCHAR *dup_ansi( const char *str )
+{
+    WCHAR *ret;
+    int len;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar( CP_ACP, 0, str, -1, NULL, 0 );
+    if ((ret = HeapAlloc( GetProcessHeap(), 0, len * sizeof(WCHAR) )))
+        MultiByteToWideChar( CP_ACP, 0, str, -1, ret, len );
+    return ret;
+}
+
+BOOL WINAPI LoadUserProfileA( HANDLE hToken, LPPROFILEINFOA lpProfileInfo )
+{
+    PROFILEINFOW infoW;
+    BOOL ret;
+
+    TRACE("%p %p\n", hToken, lpProfileInfo );
+
+    if (!lpProfileInfo || lpProfileInfo->dwSize != sizeof(PROFILEINFOA) || !lpProfileInfo->lpUserName)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    memset( &infoW, 0, sizeof(infoW) );
+    infoW.dwSize = sizeof(infoW);
+    infoW.dwFlags = lpProfileInfo->dwFlags;
+    infoW.lpUserName = dup_ansi( lpProfileInfo->lpUserName );
+    infoW.lpProfilePath = dup_ansi( lpProfileInfo->lpProfilePath );
+    infoW.lpDefaultPath = dup_ansi( lpProfileInfo->lpDefaultPath );
+    infoW.lpServerName = dup_ansi( lpProfileInfo->lpServerName );
+    infoW.lpPolicyPath = dup_ansi( lpProfileInfo->lpPolicyPath );
+    ret = LoadUserProfileW( hToken, &infoW );
+    if (ret) lpProfileInfo->hProfile = infoW.hProfile;
+    HeapFree( GetProcessHeap(), 0, infoW.lpUserName );
+    HeapFree( GetProcessHeap(), 0, infoW.lpProfilePath );
+    HeapFree( GetProcessHeap(), 0, infoW.lpDefaultPath );
+    HeapFree( GetProcessHeap(), 0, infoW.lpServerName );
+    HeapFree( GetProcessHeap(), 0, infoW.lpPolicyPath );
+    return ret;
 }
 
