+/*
+ * AppContainer profiles. Windows records a profile's name under the user's
+ * AppContainer registry key and gives it a folder below the Packages folder
+ * of the local application data; both are made here. The key and folder
+ * layout beyond what the documentation names (the Mappings and Storage subkeys,
+ * the AC subfolders, the value names) is a guess.
+ */
+static const WCHAR ac_root[] = L"Software\\Classes\\Local Settings\\Software\\Microsoft\\Windows\\CurrentVersion\\AppContainer";
+
+static BOOL valid_ac_name( const WCHAR *name )
+{
+    size_t len, i;
+
+    if (!name) return FALSE;
+    len = wcslen( name );
+    if (!len || len > 64) return FALSE;
+    for (i = 0; i < len; i++)
+        if (!((name[i] >= 'A' && name[i] <= 'Z') || (name[i] >= 'a' && name[i] <= 'z') ||
+              (name[i] >= '0' && name[i] <= '9') || name[i] == '-' || name[i] == '_' ||
+              name[i] == '.' || name[i] == ' '))
+            return FALSE;
+    return TRUE;
+}
+
+static BOOL in_app_container(void)
+{
+    DWORD is = 0, len;
+    HANDLE token;
+
+    if (!OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ) &&
+        !OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return FALSE;
+    if (!GetTokenInformation( token, TokenIsAppContainer, &is, sizeof(is), &len )) is = 0;
+    CloseHandle( token );
+    return is;
+}
+
+static BOOL ac_packages_dir( const WCHAR *name, WCHAR *dir )
+{
+    if (FAILED(SHGetFolderPathW( NULL, CSIDL_LOCAL_APPDATA | CSIDL_FLAG_CREATE, NULL, SHGFP_TYPE_CURRENT, dir )))
+        return FALSE;
+    if (wcslen( dir ) + wcslen( name ) + 11 > MAX_PATH) return FALSE;
+    wcscat( dir, L"\\Packages\\" );
+    wcscat( dir, name );
+    return TRUE;
+}
+
+static void delete_tree( const WCHAR *dir )
+{
+    WCHAR pattern[MAX_PATH], sub[MAX_PATH];
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+
+    wsprintfW( pattern, L"%s\\*", dir );
+    if ((find = FindFirstFileW( pattern, &fd )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (!wcscmp( fd.cFileName, L"." ) || !wcscmp( fd.cFileName, L".." )) continue;
+            if (wcslen( dir ) + wcslen( fd.cFileName ) + 2 > MAX_PATH) continue;
+            wsprintfW( sub, L"%s\\%s", dir, fd.cFileName );
+            if ((fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) && !(fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT))
+                delete_tree( sub );
+            else
+            {
+                SetFileAttributesW( sub, FILE_ATTRIBUTE_NORMAL );
+                if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) RemoveDirectoryW( sub );
+                else DeleteFileW( sub );
+            }
+        } while (FindNextFileW( find, &fd ));
+        FindClose( find );
+    }
+    RemoveDirectoryW( dir );
+}
