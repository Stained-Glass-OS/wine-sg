From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: a desktop says whether it takes input (UOI_IO)

GetUserObjectInformation with UOI_IO asks whether a desktop is the one
receiving input -- the window station's input desktop -- and for a window
station whether it is the interactive one. Wine knew only the flags, name,
type and user of an object and answered ERROR_INVALID_PARAMETER.
Remote-desktop programs ask it of their desktop before they capture the
screen. AnyDesk did (its log: "Couldn't query the desktops IO flag (87)",
hundreds of times a session) and then refused to send the picture: the
person connecting saw "Access denied -- The remote desktop's image is
inaccessible" over a black view (David, 2026-10-05: AnyDesk "crashes when
we try connecting"). The answer now compares the desktop with the input
desktop (it follows SwitchDesktop), and a buffer smaller than a BOOL gets
ERROR_INSUFFICIENT_BUFFER.

Test: test/inputdesk-gate.sh with test/inputdesk-probe.c (mutant
SG_MUTANT_UOI_IO).
---
--- a/include/winuser.h
+++ b/include/winuser.h
@@ -99,6 +99,8 @@
 #define UOI_NAME        2
 #define UOI_TYPE        3
 #define UOI_USER_SID    4
+#define UOI_HEAPSIZE    5
+#define UOI_IO          6
 
 #define WSF_VISIBLE     1
 #define DF_ALLOWOTHERACCOUNTHOOK  1
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -732,6 +732,47 @@
         }
         return ret;
 
+#ifndef SG_MUTANT_UOI_IO
+    case UOI_IO:
+        {
+            /* whether this object is the one receiving input: for a desktop,
+             * whether it is its window station's input desktop; for a
+             * window station, whether it is the visible (interactive) one */
+            BOOL is_desktop = FALSE, result = FALSE;
+            unsigned int obj_flags = 0;
+            HDESK input;
+
+            if (needed) *needed = sizeof(BOOL);
+            if (len < sizeof(BOOL))
+            {
+                RtlSetLastWin32Error( ERROR_INSUFFICIENT_BUFFER );
+                return FALSE;
+            }
+            SERVER_START_REQ( set_user_object_info )
+            {
+                req->handle = wine_server_obj_handle( handle );
+                req->flags  = 0;
+                ret = !wine_server_call_err( req );
+                if (ret)
+                {
+                    is_desktop = reply->is_desktop;
+                    obj_flags  = reply->old_obj_flags;
+                }
+            }
+            SERVER_END_REQ;
+            if (!ret) return FALSE;
+
+            if (!is_desktop) result = (obj_flags & WSF_VISIBLE) != 0;
+            else if ((input = NtUserOpenInputDesktop( 0, FALSE, 0 )))
+            {
+                result = !NtCompareObjects( handle, input );
+                NtUserCloseDesktop( input );
+            }
+            *(BOOL *)info = result;
+            return TRUE;
+        }
+#endif
+
     case UOI_USER_SID:
         FIXME( "not supported index %d\n", index );
         /* fall through */
