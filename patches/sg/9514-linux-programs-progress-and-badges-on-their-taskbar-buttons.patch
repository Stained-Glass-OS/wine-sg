     if (!RegGetValueW( HKEY_CURRENT_USER, key, L"RelaunchCommand", RRF_RT_REG_SZ, NULL, command, &size ) && command[0])
         win->relaunch = wcsdup( command );
+    /* 9514: the window says whose it is, for the Linux notifications host's
+     * progress and badges (com.canonical.Unity.LauncherEntry, by app) */
+    if (win->hwnd) SetPropW( win->hwnd, L"SgLinuxAppId", (HANDLE)(ULONG_PTR)GlobalAddAtomW( win->appid ) );
 }
 
 /* a value of a Linux app's AppUserModelID key (DisplayName, SgShortcut) */
@@ -3891,6 +3996,7 @@
                 win->hwnd = frame;
                 win->embedded = id;
                 win->xwin = 0;
+                if (win->appid[0]) SetPropW( frame, L"SgLinuxAppId", (HANDLE)(ULONG_PTR)GlobalAddAtomW( win->appid ) );
                 SetWindowLongPtrW( win->button, GWLP_ID, (LONG_PTR)frame );
                 changed = TRUE;
                 continue;
