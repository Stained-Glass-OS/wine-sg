+/* 9514: an app's launcher entry, on the taskbar buttons of its windows --
+ * the shell's frames, which say whose they are (SgLinuxAppId) and take
+ * SG_FRAME_PROGRESS and SG_FRAME_BADGE (explorer) */
+#define SG_FRAME_PROGRESS (WM_APP + 0x5350)
+#define SG_FRAME_BADGE    (WM_APP + 0x5351)
+
+struct sg_launcher
+{
+    WCHAR aumid[130];
+    int count, progress;
+    BOOL urgent;
+};
+static struct sg_launcher sg_launchers[64];
+static UINT sg_launcher_count;
+
+struct sg_launcher_apply { const struct sg_launcher *entry; BOOL flash; };
+
+static BOOL CALLBACK sg_launcher_window( HWND hwnd, LPARAM lp )
+{
+    const struct sg_launcher_apply *apply = (const struct sg_launcher_apply *)lp;
+    const struct sg_launcher *e = apply->entry;
+    WCHAR cls[32], aumid[130];
+    ATOM atom;
+
+    if (!GetClassNameW( hwnd, cls, ARRAY_SIZE(cls) ) || wcscmp( cls, L"SgLinuxWindow" )) return TRUE;
+    if (!(atom = (ATOM)(ULONG_PTR)GetPropW( hwnd, L"SgLinuxAppId" )) ||
+        !GlobalGetAtomNameW( atom, aumid, ARRAY_SIZE(aumid) ) || wcsicmp( aumid, e->aumid )) return TRUE;
+    PostMessageW( hwnd, SG_FRAME_PROGRESS, e->progress == -2 ? 1 : e->progress >= 0 ? 2 : 0, max( e->progress, 0 ) );
+    PostMessageW( hwnd, SG_FRAME_BADGE, max( e->count, 0 ), 0 );
+    if (apply->flash)
+    {
+        FLASHWINFO info = { sizeof(info), hwnd, e->urgent ? FLASHW_TRAY | FLASHW_TIMERNOFG : FLASHW_STOP, 0, 0 };
+        FlashWindowEx( &info );
+    }
+    return TRUE;
+}
+
+static void sg_launcher_apply( const struct sg_launcher *entry, BOOL flash )
+{
+    struct sg_launcher_apply apply = { entry, flash };
+    EnumWindows( sg_launcher_window, (LPARAM)&apply );
+}
+
+/* windows of the app opened since: the count and progress again, every two seconds */
+static DWORD WINAPI sg_launcher_thread( void *arg )
+{
+    for (;;)
+    {
+        UINT i;
+        Sleep( 2000 );
+        EnterCriticalSection( &sg_linux_cs );
+        for (i = 0; i < sg_launcher_count; i++)
+#ifndef SG_MUTANT_LAUNCHER_IGNORED
+            if (sg_launchers[i].count > 0 || sg_launchers[i].progress != -1) sg_launcher_apply( &sg_launchers[i], FALSE );
+#endif
+        LeaveCriticalSection( &sg_linux_cs );
+    }
+    return 0;
+}
+
+static void sg_launcher_update( const char *aumid, int count, int progress, BOOL urgent )
+{
+    struct sg_launcher *e = NULL;
+    BOOL flash;
+    WCHAR id[130];
+    UINT i;
+    static HANDLE thread;
+
+    if (!MultiByteToWideChar( CP_UTF8, 0, aumid, -1, id, ARRAY_SIZE(id) ) || !id[0]) return;
+    EnterCriticalSection( &sg_linux_cs );
+    for (i = 0; i < sg_launcher_count; i++) if (!wcsicmp( sg_launchers[i].aumid, id )) e = &sg_launchers[i];
+    if (!e && sg_launcher_count < ARRAY_SIZE(sg_launchers))
+    {
+        e = &sg_launchers[sg_launcher_count++];
+        lstrcpynW( e->aumid, id, ARRAY_SIZE(e->aumid) );
+        e->count = 0;
+        e->progress = -1;
+        e->urgent = FALSE;
+    }
+    if (e)
+    {
+        flash = e->urgent != urgent;
+        e->count = count;
+        e->progress = progress;
+        e->urgent = urgent;
+#ifndef SG_MUTANT_LAUNCHER_IGNORED
+        sg_launcher_apply( e, flash );
+#endif
+    }
+    LeaveCriticalSection( &sg_linux_cs );
+    if (!thread) thread = CreateThread( NULL, 0, sg_launcher_thread, NULL, 0, NULL );
+}
