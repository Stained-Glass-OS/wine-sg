+/* Stained Glass OS 9514: a Linux program's progress and badge on its button.
+ * Its frame (or stand-in) takes them as messages: SG_FRAME_PROGRESS from
+ * winex11 (XApp's _NET_WM_XAPP_PROGRESS on the program's window) and from
+ * the Linux notifications host (com.canonical.Unity.LauncherEntry's
+ * progress), SG_FRAME_BADGE from the host (LauncherEntry's count: Telegram's
+ * unread messages) -- as a Windows program's ITaskbarList3 progress and
+ * overlay icon (Telegram for Windows shows its count so). */
+#define SG_FRAME_PROGRESS (WM_APP + 0x5350)   /* wparam 0 none, 1 indeterminate, 2 normal; lparam percent */
+#define SG_FRAME_BADGE    (WM_APP + 0x5351)   /* wparam the count, 0 none */
+
+static HICON sg_badge_icon( unsigned int count )
+{
+    int size = SG_SMICON, x, y;
+    BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER), size, -size, 1, 32 }};
+    ICONINFO ii = { TRUE };
+    WCHAR text[8];
+    DWORD *bits;
+    HBITMAP color, mask;
+    HDC dc;
+    HFONT font, old;
+    RECT rc = { 0, 0, size, size };
+    HICON icon;
+
+    if (!(dc = CreateCompatibleDC( 0 ))) return NULL;
+    if (!(color = CreateDIBSection( dc, &bmi, DIB_RGB_COLORS, (void **)&bits, NULL, 0 ))) { DeleteDC( dc ); return NULL; }
+    SelectObject( dc, color );
+    /* a red disc, the count in white on it */
+    for (y = 0; y < size; y++)
+        for (x = 0; x < size; x++)
+        {
+            double dx = x + 0.5 - size / 2.0, dy = y + 0.5 - size / 2.0, r = size / 2.0;
+            double d = r - sqrt( dx * dx + dy * dy );
+            double a = d >= 1 ? 1 : d <= 0 ? 0 : d;
+            BYTE A = (BYTE)(a * 255);
+            bits[y * size + x] = (A << 24) | ((BYTE)(0xD1 * a) << 16) | ((BYTE)(0x34 * a) << 8) | (BYTE)(0x38 * a);
+        }
+    if (count > 99) lstrcpyW( text, L"99+" );
+    else swprintf( text, ARRAY_SIZE(text), L"%u", count );
+    font = CreateFontW( -(size * (count > 9 ? 9 : 11)) / 16, 0, 0, 0, FW_BOLD, 0, 0, 0, DEFAULT_CHARSET, 0, 0,
+                        ANTIALIASED_QUALITY, 0, L"Segoe UI" );
+    old = SelectObject( dc, font );
+    SetBkMode( dc, TRANSPARENT );
+    SetTextColor( dc, RGB( 0xFF, 0xFF, 0xFF ) );
+    GdiFlush();
+    {
+        /* GDI text leaves alpha 0: drawn on a copy, its white pixels made opaque */
+        DWORD *before = malloc( size * size * sizeof(DWORD) );
+        if (before) memcpy( before, bits, size * size * sizeof(DWORD) );
+        DrawTextW( dc, text, -1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX );
+        GdiFlush();
+        if (before)
+        {
+            for (x = 0; x < size * size; x++)
+                if ((bits[x] & 0xffffff) != (before[x] & 0xffffff)) bits[x] = 0xff000000 | (bits[x] & 0xffffff);
+                else bits[x] = before[x];
+            free( before );
+        }
+    }
+    SelectObject( dc, old );
+    DeleteObject( font );
+    DeleteDC( dc );
+    mask = CreateBitmap( size, size, 1, 1, NULL );
+    ii.hbmColor = color;
+    ii.hbmMask = mask;
+    icon = CreateIconIndirect( &ii );
+    DeleteObject( color );
+    DeleteObject( mask );
+    return icon;
+}
+
+static BOOL sg_any_indeterminate(void);
+
+static void sg_frame_progress( struct taskbar_button *win, WPARAM state, LPARAM percent )
+{
+    win->progress_state = state == 1 ? SG_TBPF_INDETERMINATE : state == 2 ? SG_TBPF_NORMAL : SG_TBPF_NOPROGRESS;
+    win->progress_done = state == 2 ? min( max( percent, 0 ), 100 ) : 0;
+    win->progress_total = state == 2 ? 100 : 0;
+    if (sg_any_indeterminate()) SetTimer( tray_window, SG_PROGRESS_TIMER, 50, NULL );
+    InvalidateRect( win->button, NULL, TRUE );
+    if (win->group && win->group != win) InvalidateRect( win->group->button, NULL, TRUE );
+}
+
+static void sg_frame_badge( struct taskbar_button *win, unsigned int count )
+{
+    if (win->overlay) DestroyIcon( win->overlay );
+    win->overlay = count ? sg_badge_icon( count ) : NULL;
+    InvalidateRect( win->button, NULL, TRUE );
+    if (win->group && win->group != win) InvalidateRect( win->group->button, NULL, TRUE );
+}
+
 static LRESULT CALLBACK sg_linux_standin_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
 {
     static UINT end_msg;
     struct taskbar_button *win;
 
+#ifndef SG_MUTANT_FRAME_NO_PROGRESS
+    if (msg == SG_FRAME_PROGRESS || msg == SG_FRAME_BADGE)
+    {
+        if ((win = find_taskbar_button( hwnd )))
+        {
+            if (msg == SG_FRAME_PROGRESS) sg_frame_progress( win, wp, lp );
+            else sg_frame_badge( win, (unsigned int)wp );
+        }
+        return 0;
+    }
+#endif
+
     /* Task Manager's End task, when the program did not close when asked: it
      * is ended (its process killed), as Windows ends a program that does not
      * answer -- a hung Linux program could not be ended (David 2026-10-02) */
@@ -3705,6 +3807,9 @@
