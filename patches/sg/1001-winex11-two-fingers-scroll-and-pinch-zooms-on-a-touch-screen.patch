@@ -2089,6 +2125,179 @@ void x11drv_pen_deselect( Display *display, Window window )
     pXISelectEvents( display, window, pen_masks, pen_device_count );
 }
 
+/***********************************************************************
+ *              x11drv_touch_gestures_enable
+ *
+ * Stained Glass OS (wine-sg 1001): two fingers on a touch screen scroll,
+ * and pinching zooms. A touch reaches programs as the mouse -- the X
+ * server presses and moves the pointer for the first finger (wine-sg 0783)
+ * -- and a second finger did nothing: a page could not be scrolled by
+ * touch at all. The desktop's thread alone (one handler for the session)
+ * takes the touch screens' raw events, which leave the X server's own
+ * pointer emulation as it is, and makes two fingers moving together the
+ * mouse wheel (fingers down: the page follows them, as on a phone), and
+ * two fingers spreading or closing Ctrl+wheel, which zooms in most
+ * programs (a precision touchpad's pinch on Windows is the same).
+ */
+void x11drv_touch_gestures_enable( Display *display )
+{
+    XIEventMask masks[ARRAY_SIZE(touch_devices)];
+    unsigned char bits[XIMaskLen(XI_LASTEVENT)];
+    int i;
+
+#ifdef SG_MUTANT_NO_TOUCH_SCROLL
+    return;
+#endif
+    if (!xinput2_available || !touch_device_count) return;
+    memset( bits, 0, sizeof(bits) );
+    XISetMask( bits, XI_RawTouchBegin );
+    XISetMask( bits, XI_RawTouchUpdate );
+    XISetMask( bits, XI_RawTouchEnd );
+    for (i = 0; i < touch_device_count; i++)
+    {
+        masks[i].deviceid = touch_devices[i].id;
+        masks[i].mask_len = sizeof(bits);
+        masks[i].mask     = bits;
+    }
+    pXISelectEvents( display, DefaultRootWindow( display ), masks, touch_device_count );
+    TRACE( "%d touch screens\n", touch_device_count );
+}
+
+#define MAX_GESTURE_TOUCHES 10
+
+struct gesture_touch
+{
+    unsigned int id;
+    double x, y;           /* on the X screen */
+};
+
+static struct
+{
+    struct gesture_touch touches[MAX_GESTURE_TOUCHES];
+    int count;
+    enum { GESTURE_NONE, GESTURE_PAN, GESTURE_PINCH, GESTURE_DONE } mode;
+    double cx, cy, dist;   /* the two fingers' centre and spread when last turned into the wheel */
+    double sx, sy, sdist;  /* ... and when the second one came down */
+} gesture;
+
+static void gesture_measure( double *cx, double *cy, double *dist )
+{
+    const struct gesture_touch *a = &gesture.touches[0], *b = &gesture.touches[1];
+    *cx = (a->x + b->x) / 2;
+    *cy = (a->y + b->y) / 2;
+    *dist = sqrt( (a->x - b->x) * (a->x - b->x) + (a->y - b->y) * (a->y - b->y) );
+}
+
+static void send_wheel( DWORD flags, int delta, BOOL ctrl )
+{
+    INPUT input = {.type = INPUT_MOUSE}, key = {.type = INPUT_KEYBOARD};
+
+    key.ki.wVk = VK_CONTROL;
+    key.ki.wScan = 0x1d;
+    if (ctrl) NtUserSendHardwareInput( 0, 0, &key, 0 );
+    input.mi.dwFlags = flags;
+    input.mi.mouseData = delta;
+    input.mi.time = NtGetTickCount();
+    NtUserSendHardwareInput( 0, 0, &input, 0 );
+    if (ctrl)
+    {
+        key.ki.dwFlags = KEYEVENTF_KEYUP;
+        NtUserSendHardwareInput( 0, 0, &key, 0 );
+    }
+}
+
+static void gesture_update(void)
+{
+    double cx, cy, dist, step = 48.0 * NtUserGetSystemDpiForProcess( NULL ) / 96;
+
+    gesture_measure( &cx, &cy, &dist );
+    if (gesture.mode == GESTURE_NONE)
+    {
+        double moved = sqrt( (cx - gesture.sx) * (cx - gesture.sx) + (cy - gesture.sy) * (cy - gesture.sy) );
+        double spread = fabs( dist - gesture.sdist );
+
+        if (moved < step / 3 && spread < step / 2) return;
+        gesture.mode = spread > moved ? GESTURE_PINCH : GESTURE_PAN;
+        gesture.cx = cx;
+        gesture.cy = cy;
+        gesture.dist = dist;
+        TRACE( "two fingers: %s\n", gesture.mode == GESTURE_PINCH ? "pinch" : "pan" );
+        /* the first finger pressed the mouse's button: let it go, so the
+         * gesture neither drags nor selects */
+        {
+            INPUT input = {.type = INPUT_MOUSE};
+            input.mi.dwFlags = MOUSEEVENTF_LEFTUP;
+            input.mi.time = NtGetTickCount();
+            NtUserSendHardwareInput( 0, 0, &input, 0 );
+        }
+    }
+    if (gesture.mode == GESTURE_PAN)
+    {
+        /* the page follows the fingers: down shows what is above */
+        while (cy - gesture.cy >= step) { send_wheel( MOUSEEVENTF_WHEEL, WHEEL_DELTA, FALSE ); gesture.cy += step; }
+        while (gesture.cy - cy >= step) { send_wheel( MOUSEEVENTF_WHEEL, -WHEEL_DELTA, FALSE ); gesture.cy -= step; }
+        while (cx - gesture.cx >= step) { send_wheel( MOUSEEVENTF_HWHEEL, -WHEEL_DELTA, FALSE ); gesture.cx += step; }
+        while (gesture.cx - cx >= step) { send_wheel( MOUSEEVENTF_HWHEEL, WHEEL_DELTA, FALSE ); gesture.cx -= step; }
+    }
+    else if (gesture.mode == GESTURE_PINCH && gesture.dist > 0)
+    {
+        /* a step of zoom for every quarter more or less spread */
+        while (dist >= gesture.dist * 1.25) { send_wheel( MOUSEEVENTF_WHEEL, WHEEL_DELTA, TRUE ); gesture.dist *= 1.25; }
+        while (dist <= gesture.dist / 1.25) { send_wheel( MOUSEEVENTF_WHEEL, -WHEEL_DELTA, TRUE ); gesture.dist /= 1.25; }
+    }
+}
+
+/***********************************************************************
+ *           X11DRV_TouchRawEvent
+ */
+static BOOL X11DRV_TouchRawEvent( XGenericEventCookie *xev )
+{
+    XIRawEvent *event = xev->data;
+    Screen *screen = DefaultScreenOfDisplay( event->display );
+    const struct touch_device *touch = NULL;
+    double value;
+    int i;
+
+    for (i = 0; i < touch_device_count; i++) if (touch_devices[i].id == event->deviceid) touch = &touch_devices[i];
+    if (!touch) return FALSE;
+
+    for (i = 0; i < gesture.count; i++) if (gesture.touches[i].id == event->detail) break;
+    if (event->evtype == XI_RawTouchEnd)
+    {
+        if (i == gesture.count) return TRUE;
+        memmove( &gesture.touches[i], &gesture.touches[i + 1], (gesture.count - i - 1) * sizeof(gesture.touches[0]) );
+        if (--gesture.count < 2) gesture.mode = GESTURE_NONE;
+        return TRUE;
+    }
+    if (i == gesture.count)
+    {
+        if (gesture.count == MAX_GESTURE_TOUCHES) return TRUE;
+        gesture.touches[gesture.count].id = event->detail;
+        gesture.touches[gesture.count].x = gesture.touches[gesture.count].y = -1;
+        gesture.count++;
+    }
+    if (pen_valuator( &event->valuators, 0, &value ))
+        gesture.touches[i].x = (value - touch->x_min) * WidthOfScreen( screen ) / (touch->x_max - touch->x_min);
+    if (pen_valuator( &event->valuators, 1, &value ))
+        gesture.touches[i].y = (value - touch->y_min) * HeightOfScreen( screen ) / (touch->y_max - touch->y_min);
+
+    /* two fingers, and only two: a third ends the gesture */
+    if (gesture.count != 2)
+    {
+        if (gesture.count > 2) gesture.mode = GESTURE_DONE;
+        return TRUE;
+    }
+    if (gesture.touches[0].x < 0 || gesture.touches[1].x < 0) return TRUE;
+    if (event->evtype == XI_RawTouchBegin)
+    {
+        gesture_measure( &gesture.sx, &gesture.sy, &gesture.sdist );
+        gesture.mode = GESTURE_NONE;
+        return TRUE;
+    }
+    if (gesture.mode != GESTURE_DONE) gesture_update();
+    return TRUE;
+}
+
 /***********************************************************************
  *           X11DRV_PenRawEvent
  *
@@ -2227,6 +2436,11 @@ BOOL X11DRV_GenericEvent( HWND hwnd, XEvent *xev )
     case XI_RawButtonRelease:
         ret = X11DRV_PenRawEvent( event );
         break;
+    case XI_RawTouchBegin:
+    case XI_RawTouchUpdate:
+    case XI_RawTouchEnd:
+        ret = X11DRV_TouchRawEvent( event );
+        break;
 
     case XI_TouchBegin:
     case XI_TouchUpdate:
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -2779,6 +2779,8 @@ BOOL X11DRV_CreateWindow( HWND hwnd )
         XFlush( data->display );
         NtUserSetProp( hwnd, clip_window_prop, (HANDLE)data->clip_window );
         X11DRV_DisplayDevices_RegisterEventHandlers();
+        /* Stained Glass OS: two-finger scrolling, from this thread alone */
+        x11drv_touch_gestures_enable( data->display );
     }
     return TRUE;
 }
