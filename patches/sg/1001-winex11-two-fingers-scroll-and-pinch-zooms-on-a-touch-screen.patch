From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: two fingers scroll, and a pinch zooms, on a touch screen

A touch reaches Windows programs as the mouse -- the X server presses and
moves the pointer for the first finger (0783), so a tap clicks and a drag
selects or moves a window -- and a second finger did nothing: a page, a
document or a list could not be scrolled by touch at all on a Surface or
a touch-screen laptop.

Now the desktop's thread (one handler for the session) takes the touch
screens' raw XI2 events, which leave the X server's own pointer emulation
as it is. Two fingers moving together are the mouse wheel -- down shows
what is above, as a page follows the fingers on a phone; one notch for
every three lines' height at the display's scale, sideways the horizontal
wheel -- and two fingers spreading or closing are Ctrl+wheel, which zooms
in most programs (a precision touchpad's pinch on Windows is the same).
When the gesture starts, the mouse button the first finger pressed is let
go, so the gesture neither drags nor selects. A third finger ends it.

Test: test/pentouch-gate.sh (mutant SG_MUTANT_NO_TOUCH_SCROLL in winex11
mouse.c): a tap still clicks, two fingers moving down 216 px are four
wheel notches up, two fingers spreading fourfold six Ctrl+wheel notches.
---
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -273,6 +273,16 @@ static struct pen_device pen_devices[SG_MAX_POINTER_DEVICES];
 static int pen_device_count;
 static XContext pen_wintab_context;   /* windows taking the pens through Wintab */
 
+/* Stained Glass OS (wine-sg 1001): touch screens, for two-finger scrolling */
+struct touch_device
+{
+    int    id;
+    double x_min, x_max, y_min, y_max;   /* valuators 0 and 1 */
+};
+
+static struct touch_device touch_devices[4];
+static int touch_device_count;
+
 static const struct pen_device *find_pen_device( int id )
 {
     int i;
@@ -309,6 +319,28 @@ static void load_pen_devices( Display *display )
         struct pen_device pen = {.id = info[i].deviceid, .pressure = -1, .tilt_x = -1, .tilt_y = -1};
 
         if (info[i].use != XISlavePointer || !info[i].name) continue;
+        for (j = 0; j < info[i].num_classes && touch_device_count < ARRAY_SIZE(touch_devices); j++)
+        {
+            XITouchClassInfo *t = (XITouchClassInfo *)info[i].classes[j];
+            struct touch_device *touch = &touch_devices[touch_device_count];
+            int k;
+
+            if (t->type != XITouchClass || t->mode != XIDirectTouch) continue;
+            touch->id = info[i].deviceid;
+            touch->x_min = touch->y_min = 0;
+            touch->x_max = touch->y_max = 0;
+            for (k = 0; k < info[i].num_classes; k++)
+            {
+                XIValuatorClassInfo *v = (XIValuatorClassInfo *)info[i].classes[k];
+                if (v->type != XIValuatorClass) continue;
+                if (v->number == 0) { touch->x_min = v->min; touch->x_max = v->max; }
+                if (v->number == 1) { touch->y_min = v->min; touch->y_max = v->max; }
+            }
+            TRACE( "touch screen %d %s: %f..%f x %f..%f\n", touch->id, debugstr_a(info[i].name),
+                   touch->x_min, touch->x_max, touch->y_min, touch->y_max );
+            if (touch->x_max > touch->x_min && touch->y_max > touch->y_min) touch_device_count++;
+            break;
+        }
         if (!name_has( info[i].name, "stylus" ) && !name_has( info[i].name, "eraser" )) continue;
         pen.eraser = name_has( info[i].name, "eraser" );
         for (j = 0; j < info[i].num_classes; j++)
@@ -526,6 +558,10 @@ void x11drv_pen_deselect( Display *display, Window window )
 {
 }
 
+void x11drv_touch_gestures_enable( Display *display )
+{
+}
