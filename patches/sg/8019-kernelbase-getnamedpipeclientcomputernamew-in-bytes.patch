From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: GetNamedPipeClientComputerNameW, its length in bytes

kernelbase's was a spec stub (on Windows kernelbase exports it; the name is in pdfsam's Java runtime), and kernel32's took ClientComputerNameLength as characters where Learn gives bytes: a caller's N-byte buffer could get up to 2N bytes. It is in kernelbase now (the client's process asked for, so the handle is the connected end of a pipe; this computer's NetBIOS name, every client is local), the length in bytes; kernel32 imports it, and its A form passes the size of its buffer in bytes. winbase.h gains the prototypes.
---
--- a/include/winbase.h
+++ b/include/winbase.h
@@ -2413,6 +2413,9 @@
 WINBASEAPI BOOL        WINAPI GetModuleHandleExA(DWORD,LPCSTR,HMODULE*);
 WINBASEAPI BOOL        WINAPI GetModuleHandleExW(DWORD,LPCWSTR,HMODULE*);
 #define                       GetModuleHandleEx WINELIB_NAME_AW(GetModuleHandleEx)
+WINBASEAPI BOOL        WINAPI GetNamedPipeClientComputerNameA(HANDLE,LPSTR,ULONG);
+WINBASEAPI BOOL        WINAPI GetNamedPipeClientComputerNameW(HANDLE,LPWSTR,ULONG);
+#define                       GetNamedPipeClientComputerName WINELIB_NAME_AW(GetNamedPipeClientComputerName)
 WINBASEAPI BOOL        WINAPI GetNamedPipeClientProcessId(HANDLE,PULONG);
 WINBASEAPI BOOL        WINAPI GetNamedPipeClientSessionId(HANDLE,PULONG);
 WINBASEAPI BOOL        WINAPI GetNamedPipeHandleStateA(HANDLE,LPDWORD,LPDWORD,LPDWORD,LPDWORD,LPSTR,DWORD);
--- a/dlls/kernelbase/sync.c
+++ b/dlls/kernelbase/sync.c
@@ -1711,6 +1711,45 @@
 
 
 /***********************************************************************
+ *           GetNamedPipeClientComputerNameW   (kernelbase.@)
+ *
+ * (wine-sg 8019) The computer a pipe's client runs on: every client here is on this machine, so its
+ * name; the handle must be the connected end of a pipe, which asking for the client's process tells.
+ * The length is the buffer's size in bytes, as Learn gives it.
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH GetNamedPipeClientComputerNameW( HANDLE pipe, WCHAR *name, ULONG len )
+{
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD size = ARRAY_SIZE(computer);
+    IO_STATUS_BLOCK io;
+    ULONG pid;
+
+    TRACE( "(%p, %p, %lu)\n", pipe, name, len );
+
+    if (!set_ntstatus( NtFsControlFile( pipe, NULL, NULL, NULL, &io, FSCTL_PIPE_GET_CONNECTION_ATTRIBUTE,
+                                        (void *)"ClientProcessId", sizeof("ClientProcessId"), &pid, sizeof(pid) )))
+        return FALSE;
+    if (!GetComputerNameExW( ComputerNameNetBIOS, computer, &size )) return FALSE;
+#ifndef SG_MUTANT_PIPE_NAME_CHARS
+    if (len < (size + 1) * sizeof(WCHAR))
+#else
+    if (len < size + 1)
+#endif
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    if (!name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    memcpy( name, computer, (size + 1) * sizeof(WCHAR) );
+    return TRUE;
+}
+
+
+/***********************************************************************
  *           GetNamedPipeHandleStateW   (kernelbase.@)
  */
 BOOL WINAPI DECLSPEC_HOTPATCH GetNamedPipeHandleStateW( HANDLE pipe, DWORD *state, DWORD *instances,
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -607,7 +607,7 @@
 @ stdcall GetNLSVersionEx(long wstr ptr)
 @ stub GetNamedLocaleHashNode
 @ stub GetNamedPipeAttribute
-@ stub GetNamedPipeClientComputerNameW
+@ stdcall GetNamedPipeClientComputerNameW(long ptr long)
 @ stdcall GetNamedPipeHandleStateW(long ptr ptr ptr ptr ptr long)
 @ stdcall GetNamedPipeInfo(long ptr ptr ptr ptr)
 @ stdcall GetNativeSystemInfo(ptr)
