From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxpackaging: IAppxManifestReader2 and IAppxManifestReader3

A manifest reader is also an IAppxManifestReader2 (GetQualifiedResources: every Resource element's Language, uap:Scale and uap:DXFeatureLevel) and an IAppxManifestReader3 (GetCapabilitiesByCapabilityClass: Capability elements classed by their namespace -- restricted, Windows, else general -- and CustomCapability elements as custom; GetTargetDeviceFamilies: every TargetDeviceFamily's name, MinVersion and MaxVersionTested). appxpackaging.idl gains the interfaces and APPX_CAPABILITY_CLASS_TYPE. QueryInterface for them was E_NOINTERFACE.
---
--- a/include/appxpackaging.idl
+++ b/include/appxpackaging.idl
@@ -414,6 +414,75 @@
     HRESULT MoveNext([out, retval] BOOL *has_next);
 }
 
+/* (wine-sg 8234) the Windows 10 manifest reader versions 2 and 3 */
+typedef [v1_enum] enum APPX_CAPABILITY_CLASS_TYPE
+{
+    APPX_CAPABILITY_CLASS_DEFAULT = 0x0,
+    APPX_CAPABILITY_CLASS_GENERAL = 0x1,
+    APPX_CAPABILITY_CLASS_RESTRICTED = 0x2,
+    APPX_CAPABILITY_CLASS_WINDOWS = 0x4,
+    APPX_CAPABILITY_CLASS_ALL = 0x7,
+    APPX_CAPABILITY_CLASS_CUSTOM = 0x8,
+} APPX_CAPABILITY_CLASS_TYPE;
+
+[
+    object,
+    uuid(11d22258-f470-42c1-b291-8361c5437e41),
+    local
+]
+interface IAppxManifestCapabilitiesEnumerator : IUnknown
+{
+    HRESULT GetCurrent([out, retval, string] LPWSTR *capability);
+    HRESULT GetHasCurrent([out, retval] BOOL *has_current);
+    HRESULT MoveNext([out, retval] BOOL *has_next);
+}
+
+[
+    object,
+    uuid(9091b09b-c8d5-4f31-8687-a338259faefb),
+    local
+]
+interface IAppxManifestTargetDeviceFamily : IUnknown
+{
+    HRESULT GetName([out, retval, string] LPWSTR *name);
+    HRESULT GetMinVersion([out, retval] UINT64 *min_version);
+    HRESULT GetMaxVersionTested([out, retval] UINT64 *max_version_tested);
+}
+
+[
+    object,
+    uuid(36537f36-27a4-4788-88c0-733819575017),
+    local
+]
+interface IAppxManifestTargetDeviceFamiliesEnumerator : IUnknown
+{
+    HRESULT GetCurrent([out, retval] IAppxManifestTargetDeviceFamily **target_device_family);
+    HRESULT GetHasCurrent([out, retval] BOOL *has_current);
+    HRESULT MoveNext([out, retval] BOOL *has_next);
+}
+
+[
+    object,
+    uuid(d06f67bc-b31d-4eba-a8af-638e73e77b4d),
+    local
+]
+interface IAppxManifestReader2 : IAppxManifestReader
+{
+    HRESULT GetQualifiedResources([out, retval] IAppxManifestQualifiedResourcesEnumerator **resources);
+}
+
+[
+    object,
+    uuid(c43825ab-69b7-400a-9709-cc37f5a72d24),
+    local
+]
+interface IAppxManifestReader3 : IAppxManifestReader2
+{
+    HRESULT GetCapabilitiesByCapabilityClass([in] APPX_CAPABILITY_CLASS_TYPE capability_class,
+            [out, retval] IAppxManifestCapabilitiesEnumerator **capabilities);
+    HRESULT GetTargetDeviceFamilies([out, retval] IAppxManifestTargetDeviceFamiliesEnumerator **target_device_families);
+}
+
