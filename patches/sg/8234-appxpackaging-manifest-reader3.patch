+/* an attribute by its local name, whatever its namespace (uap:Scale) */
+static HRESULT attribute_any_ns( IXmlReader *reader, const WCHAR *name, WCHAR **value )
+{
+    const WCHAR *local, *v;
+    HRESULT hr;
+
+    *value = NULL;
+    for (hr = IXmlReader_MoveToFirstAttribute( reader ); hr == S_OK; hr = IXmlReader_MoveToNextAttribute( reader ))
+    {
+        if (FAILED(hr = IXmlReader_GetLocalName( reader, &local, NULL ))) break;
+        if (wcscmp( local, name )) continue;
+        if (FAILED(hr = IXmlReader_GetValue( reader, &v, NULL ))) break;
+        if (!(*value = strdupW( v ))) hr = E_OUTOFMEMORY;
+        break;
+    }
+    IXmlReader_MoveToElement( reader );
+    return FAILED(hr) ? hr : S_OK;
+}
+
+/* the class of a Capability element by its namespace: the restricted and Windows capability namespaces,
+ * else general (foundation, uap...) */
+static APPX_CAPABILITY_CLASS_TYPE capability_class( IXmlReader *reader )
+{
+    const WCHAR *ns = NULL;
+
+    if (FAILED(IXmlReader_GetNamespaceUri( reader, &ns, NULL )) || !ns) return APPX_CAPABILITY_CLASS_GENERAL;
+    if (!wcscmp( ns, L"http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" ))
+        return APPX_CAPABILITY_CLASS_RESTRICTED;
+    if (!wcscmp( ns, L"http://schemas.microsoft.com/appx/manifest/foundation/windows10/windowscapabilities" ))
+        return APPX_CAPABILITY_CLASS_WINDOWS;
+    return APPX_CAPABILITY_CLASS_GENERAL;
+}
+
+static HRESULT add_capability( struct manifest *m, IXmlReader *reader, APPX_CAPABILITY_CLASS_TYPE class )
+{
+    struct capability *caps;
+    WCHAR *name = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = attribute( reader, L"Name", &name ))) return hr;
+    if (!name || !name[0] || m->cap_count >= 1024) { free( name ); return APPX_E_INVALID_MANIFEST; }
+    if (!(caps = realloc( m->caps, (m->cap_count + 1) * sizeof(*caps) ))) { free( name ); return E_OUTOFMEMORY; }
+    m->caps = caps;
+    caps[m->cap_count].name = name;
+    caps[m->cap_count++].class = class;
+    return S_OK;
+}
