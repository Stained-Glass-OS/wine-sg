+/* ---- IAppxManifestReader2 / IAppxManifestReader3 (wine-sg 8234) ---------- */
+
+/* one enumerator object for the three lists: qualified resources, capabilities of a class, device families */
+enum list_kind { LIST_QRES, LIST_CAPS, LIST_FAMILIES };
+
+struct list3
+{
+    IAppxManifestQualifiedResourcesEnumerator IAppxManifestQualifiedResourcesEnumerator_iface;
+    IAppxManifestCapabilitiesEnumerator IAppxManifestCapabilitiesEnumerator_iface;
+    IAppxManifestTargetDeviceFamiliesEnumerator IAppxManifestTargetDeviceFamiliesEnumerator_iface;
+    LONG ref;
+    struct manifest *manifest;
+    enum list_kind kind;
+    unsigned int count, index;
+    unsigned int *items;        /* indexes into the manifest's list */
+};
+
+/* an item of a list: a qualified resource or a device family */
+struct item3
+{
+    IAppxManifestQualifiedResource IAppxManifestQualifiedResource_iface;
+    IAppxManifestTargetDeviceFamily IAppxManifestTargetDeviceFamily_iface;
+    LONG ref;
+    struct manifest *manifest;
+    unsigned int index;
+};
+
+static void list3_free( struct list3 *l )
+{
+    IAppxManifestReader_Release( &l->manifest->IAppxManifestReader_iface );
+    free( l->items );
+    free( l );
+}
+
+#define LIST3_IUNKNOWN( iface_type, member, iid ) \
+static inline struct list3 *impl_from_##iface_type( iface_type *iface ) \
+{ \
+    return CONTAINING_RECORD( iface, struct list3, member ); \
+} \
+static HRESULT WINAPI list3_##iface_type##_QueryInterface( iface_type *iface, REFIID riid, void **out ) \
+{ \
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &iid )) \
+    { \
+        *out = iface; \
+        InterlockedIncrement( &impl_from_##iface_type( iface )->ref ); \
+        return S_OK; \
+    } \
+    *out = NULL; \
+    return E_NOINTERFACE; \
+} \
+static ULONG WINAPI list3_##iface_type##_AddRef( iface_type *iface ) \
+{ \
+    return InterlockedIncrement( &impl_from_##iface_type( iface )->ref ); \
+} \
+static ULONG WINAPI list3_##iface_type##_Release( iface_type *iface ) \
+{ \
+    struct list3 *l = impl_from_##iface_type( iface ); \
+    ULONG ref = InterlockedDecrement( &l->ref ); \
+    if (!ref) list3_free( l ); \
+    return ref; \
+} \
+static HRESULT WINAPI list3_##iface_type##_GetHasCurrent( iface_type *iface, BOOL *has ) \
+{ \
+    struct list3 *l = impl_from_##iface_type( iface ); \
+    if (!has) return E_POINTER; \
+    *has = l->index < l->count; \
+    return S_OK; \
+} \
+static HRESULT WINAPI list3_##iface_type##_MoveNext( iface_type *iface, BOOL *has ) \
+{ \
+    struct list3 *l = impl_from_##iface_type( iface ); \
+    if (!has) return E_POINTER; \
+    if (l->index < l->count) l->index++; \
+    *has = l->index < l->count; \
+    return S_OK; \
+}
+
+LIST3_IUNKNOWN( IAppxManifestQualifiedResourcesEnumerator, IAppxManifestQualifiedResourcesEnumerator_iface,
+                IID_IAppxManifestQualifiedResourcesEnumerator )
+LIST3_IUNKNOWN( IAppxManifestCapabilitiesEnumerator, IAppxManifestCapabilitiesEnumerator_iface,
+                IID_IAppxManifestCapabilitiesEnumerator )
+LIST3_IUNKNOWN( IAppxManifestTargetDeviceFamiliesEnumerator, IAppxManifestTargetDeviceFamiliesEnumerator_iface,
+                IID_IAppxManifestTargetDeviceFamiliesEnumerator )
+
+static inline struct item3 *impl_from_IAppxManifestQualifiedResource( IAppxManifestQualifiedResource *iface )
+{
+    return CONTAINING_RECORD( iface, struct item3, IAppxManifestQualifiedResource_iface );
+}
+
+static inline struct item3 *impl_from_IAppxManifestTargetDeviceFamily( IAppxManifestTargetDeviceFamily *iface )
+{
+    return CONTAINING_RECORD( iface, struct item3, IAppxManifestTargetDeviceFamily_iface );
+}
+
+static ULONG item3_release( struct item3 *item )
+{
+    ULONG ref = InterlockedDecrement( &item->ref );
+    if (!ref)
+    {
+        IAppxManifestReader_Release( &item->manifest->IAppxManifestReader_iface );
+        free( item );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI qres_QueryInterface( IAppxManifestQualifiedResource *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxManifestQualifiedResource ))
+    {
+        *out = iface;
+        IAppxManifestQualifiedResource_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI qres_AddRef( IAppxManifestQualifiedResource *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxManifestQualifiedResource( iface )->ref );
+}
+
+static ULONG WINAPI qres_Release( IAppxManifestQualifiedResource *iface )
+{
+    return item3_release( impl_from_IAppxManifestQualifiedResource( iface ) );
+}
+
+static HRESULT WINAPI qres_GetLanguage( IAppxManifestQualifiedResource *iface, LPWSTR *language )
+{
+    struct item3 *item = impl_from_IAppxManifestQualifiedResource( iface );
+    const WCHAR *lang = item->manifest->qres[item->index].language;
+
+    if (!language) return E_POINTER;
+    *language = NULL;
+    if (!lang) return S_OK;
+    return (*language = co_strdupW( lang )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI qres_GetScale( IAppxManifestQualifiedResource *iface, UINT32 *scale )
+{
+    struct item3 *item = impl_from_IAppxManifestQualifiedResource( iface );
+    if (!scale) return E_POINTER;
+    *scale = item->manifest->qres[item->index].scale;
+    return S_OK;
+}
+
+static HRESULT WINAPI qres_GetDXFeatureLevel( IAppxManifestQualifiedResource *iface, DX_FEATURE_LEVEL *level )
+{
+    struct item3 *item = impl_from_IAppxManifestQualifiedResource( iface );
+    if (!level) return E_POINTER;
+    *level = item->manifest->qres[item->index].dx;
+    return S_OK;
+}
+
+static const IAppxManifestQualifiedResourceVtbl qres_vtbl =
+{
+    qres_QueryInterface, qres_AddRef, qres_Release, qres_GetLanguage, qres_GetScale, qres_GetDXFeatureLevel,
+};
+
+static HRESULT WINAPI family_QueryInterface( IAppxManifestTargetDeviceFamily *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxManifestTargetDeviceFamily ))
+    {
+        *out = iface;
+        IAppxManifestTargetDeviceFamily_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI family_AddRef( IAppxManifestTargetDeviceFamily *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxManifestTargetDeviceFamily( iface )->ref );
+}
+
+static ULONG WINAPI family_Release( IAppxManifestTargetDeviceFamily *iface )
+{
+    return item3_release( impl_from_IAppxManifestTargetDeviceFamily( iface ) );
+}
+
+static HRESULT WINAPI family_GetName( IAppxManifestTargetDeviceFamily *iface, LPWSTR *name )
+{
+    struct item3 *item = impl_from_IAppxManifestTargetDeviceFamily( iface );
+    if (!name) return E_POINTER;
+    return (*name = co_strdupW( item->manifest->families[item->index].name )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI family_GetMinVersion( IAppxManifestTargetDeviceFamily *iface, UINT64 *version )
+{
+    struct item3 *item = impl_from_IAppxManifestTargetDeviceFamily( iface );
+    if (!version) return E_POINTER;
+    *version = item->manifest->families[item->index].min_version;
+    return S_OK;
+}
+
+static HRESULT WINAPI family_GetMaxVersionTested( IAppxManifestTargetDeviceFamily *iface, UINT64 *version )
+{
+    struct item3 *item = impl_from_IAppxManifestTargetDeviceFamily( iface );
+    if (!version) return E_POINTER;
+    *version = item->manifest->families[item->index].max_version_tested;
+    return S_OK;
+}
+
+static const IAppxManifestTargetDeviceFamilyVtbl family_vtbl =
+{
+    family_QueryInterface, family_AddRef, family_Release, family_GetName, family_GetMinVersion,
+    family_GetMaxVersionTested,
+};
+
+static struct item3 *item3_create( struct list3 *l )
+{
+    struct item3 *item;
+
+    if (!(item = calloc( 1, sizeof(*item) ))) return NULL;
+    item->IAppxManifestQualifiedResource_iface.lpVtbl = &qres_vtbl;
+    item->IAppxManifestTargetDeviceFamily_iface.lpVtbl = &family_vtbl;
+    item->ref = 1;
+    item->manifest = l->manifest;
+    item->index = l->items[l->index];
+    IAppxManifestReader_AddRef( &l->manifest->IAppxManifestReader_iface );
+    return item;
+}
+
+static HRESULT WINAPI list3_qres_GetCurrent( IAppxManifestQualifiedResourcesEnumerator *iface,
+                                             IAppxManifestQualifiedResource **resource )
+{
+    struct list3 *l = impl_from_IAppxManifestQualifiedResourcesEnumerator( iface );
+    struct item3 *item;
+
+    if (!resource) return E_POINTER;
+    *resource = NULL;
+    if (l->index >= l->count) return APPX_E_PACKAGING_INTERNAL;
+    if (!(item = item3_create( l ))) return E_OUTOFMEMORY;
+    *resource = &item->IAppxManifestQualifiedResource_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI list3_caps_GetCurrent( IAppxManifestCapabilitiesEnumerator *iface, LPWSTR *capability )
+{
+    struct list3 *l = impl_from_IAppxManifestCapabilitiesEnumerator( iface );
+
+    if (!capability) return E_POINTER;
+    *capability = NULL;
+    if (l->index >= l->count) return APPX_E_PACKAGING_INTERNAL;
+    return (*capability = co_strdupW( l->manifest->caps[l->items[l->index]].name )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI list3_families_GetCurrent( IAppxManifestTargetDeviceFamiliesEnumerator *iface,
+                                                 IAppxManifestTargetDeviceFamily **family )
+{
+    struct list3 *l = impl_from_IAppxManifestTargetDeviceFamiliesEnumerator( iface );
+    struct item3 *item;
+
+    if (!family) return E_POINTER;
+    *family = NULL;
+    if (l->index >= l->count) return APPX_E_PACKAGING_INTERNAL;
+    if (!(item = item3_create( l ))) return E_OUTOFMEMORY;
+    *family = &item->IAppxManifestTargetDeviceFamily_iface;
+    return S_OK;
+}
+
