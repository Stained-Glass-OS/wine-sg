+static HRESULT device_add_update_callback(struct d3drm_device *device, D3DRMUPDATECALLBACK cb, void *ctx)
+{
+    SIZE_T i;
+
+    if (!cb)
+        return D3DRMERR_BADVALUE;
+    for (i = 0; i < device->nb_update_callbacks; ++i)
+        if (device->update_callbacks[i].cb == cb && device->update_callbacks[i].ctx == ctx)
+            return D3DRM_OK;
+    if (!d3drm_array_reserve((void **)&device->update_callbacks, &device->update_callbacks_size,
+            device->nb_update_callbacks + 1, sizeof(*device->update_callbacks)))
+        return E_OUTOFMEMORY;
+    device->update_callbacks[device->nb_update_callbacks].cb = cb;
+    device->update_callbacks[device->nb_update_callbacks].ctx = ctx;
+    ++device->nb_update_callbacks;
+    return D3DRM_OK;
+}
+
+static HRESULT device_delete_update_callback(struct d3drm_device *device, D3DRMUPDATECALLBACK cb, void *ctx)
+{
+    SIZE_T i;
+
+    for (i = 0; i < device->nb_update_callbacks; ++i)
+    {
+        if (device->update_callbacks[i].cb != cb || device->update_callbacks[i].ctx != ctx)
+            continue;
+        memmove(&device->update_callbacks[i], &device->update_callbacks[i + 1],
+                (device->nb_update_callbacks - i - 1) * sizeof(*device->update_callbacks));
+        --device->nb_update_callbacks;
+        return D3DRM_OK;
+    }
+    return D3DRMERR_NOTFOUND;
+}
+
+/* The device has no render target to copy from; the callbacks are told that all of it was updated. */
+static void device_update(struct d3drm_device *device)
+{
+    D3DRECT rect;
+    SIZE_T i;
+
+    rect.x1 = rect.y1 = 0;
+    rect.x2 = device->width;
+    rect.y2 = device->height;
+    for (i = 0; i < device->nb_update_callbacks; ++i)
+#ifndef SG_MUTANT_DRMDEV_NO_CALLBACKS
+        device->update_callbacks[i].cb(&device->IDirect3DRMDevice_iface, device->update_callbacks[i].ctx, 1, &rect);
+#else
+        ;
+#endif
+}
