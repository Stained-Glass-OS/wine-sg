From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wineusb.sys: the USB tree that scanner software walks

\\.\HCD0 (the host controller) and its root hub
(\\.\USB#ROOT_HUB20#...), answering the hub IOCTLs programs use to find a
device: the root hub's name, the controller's driver key, the hub's node
information (15 ports), each port's connection information (also _EX and
V2, with the device's descriptor, configuration and open pipes), its driver
key name and descriptors read through the port. The Ambir ImageScan Pro
490i's library walks the tree before it opens \\.\UsbscanN, and said "not
connected" without it. The unix side gives a device's descriptor and
current configuration.
---
--- a/dlls/wineusb.sys/unixlib.h
+++ b/dlls/wineusb.sys/unixlib.h
@@ -74,6 +74,26 @@
     struct unix_device *device;
 };
 
+/* Stained Glass OS: the USB tree (wineusb.c) */
+struct usb_get_device_info_params
+{
+    struct unix_device *device;
+    UINT8 descriptor[18];
+    UINT8 speed;            /* libusb's: 1 low, 2 full, 3 high, 4 super */
+    UINT8 config;
+    UINT8 address;
+};
+
+struct usb_get_descriptor_params
+{
+    struct unix_device *device;
+    UINT8 request_type, request;
+    UINT16 value, index;
+    void *buffer;
+    UINT32 length;
+    UINT32 *ret_length;
+};
+
 enum unix_funcs
 {
     unix_usb_main_loop,
@@ -82,6 +102,8 @@
     unix_usb_submit_urb,
     unix_usb_cancel_transfer,
     unix_usb_destroy_device,
+    unix_usb_get_device_info,
+    unix_usb_get_descriptor,
 };
 
 #endif
--- a/dlls/wineusb.sys/unixlib.c
+++ b/dlls/wineusb.sys/unixlib.c
@@ -639,6 +639,41 @@
     return STATUS_SUCCESS;
 }
 
+/* Stained Glass OS: what the USB tree (wineusb.c) shows of a device */
+static NTSTATUS usb_get_device_info(void *args)
+{
+    struct usb_get_device_info_params *params = args;
+    libusb_device *device = libusb_get_device(params->device->handle);
+    struct libusb_device_descriptor desc;
+    int config = 0;
+
+    libusb_get_device_descriptor(device, &desc);
+    memcpy(params->descriptor, &desc, sizeof(params->descriptor));
+    params->speed = libusb_get_device_speed(device);
+    params->address = libusb_get_device_address(device);
+    if (libusb_get_configuration(params->device->handle, &config) < 0) config = 0;
+    params->config = config;
+    return STATUS_SUCCESS;
+}
+
+/* a control request on a device's default pipe, waited for (the tree's
+ * IOCTL_USB_GET_DESCRIPTOR_FROM_NODE_CONNECTION) */
+static NTSTATUS usb_get_descriptor(void *args)
+{
+    struct usb_get_descriptor_params *params = args;
+    int ret = libusb_control_transfer(params->device->handle, params->request_type, params->request,
+                                      params->value, params->index, params->buffer, params->length, 2000);
+
+    if (ret < 0)
+    {
+        WARN("Failed: %s\n", libusb_strerror(ret));
+        *params->ret_length = 0;
+        return STATUS_UNSUCCESSFUL;
+    }
+    *params->ret_length = ret;
+    return STATUS_SUCCESS;
+}
+
 const unixlib_entry_t __wine_unix_call_funcs[] =
 {
 #define X(name) [unix_ ## name] = name
@@ -648,4 +683,6 @@
     X(usb_submit_urb),
     X(usb_cancel_transfer),
     X(usb_destroy_device),
+    X(usb_get_device_info),
+    X(usb_get_descriptor),
 };
--- a/dlls/wineusb.sys/wineusb.c
+++ b/dlls/wineusb.sys/wineusb.c
@@ -85,6 +85,11 @@
     struct unix_device *unix_device;
 
     LIST_ENTRY irp_list;
+
+    /* the pipes its function driver opened (SELECT_CONFIGURATION), for the
+     * USB tree's connection information */
+    ULONG pipe_count;
+    USB_ENDPOINT_DESCRIPTOR pipes[16];
 };
 
 static DRIVER_OBJECT *driver_obj;
@@ -605,6 +610,23 @@
              * dequeue the IRP until it's actually been queued. */
             EnterCriticalSection(&wineusb_cs);
             status = WINE_UNIX_CALL(unix_usb_submit_urb, &params);
+            if (urb->UrbHeader.Function == URB_FUNCTION_SELECT_CONFIGURATION && status == STATUS_SUCCESS)
+            {
+                USBD_INTERFACE_INFORMATION *iface = &urb->UrbSelectConfiguration.Interface;
+                ULONG i;
+
+                device->pipe_count = min(iface->NumberOfPipes, ARRAY_SIZE(device->pipes));
+                for (i = 0; i < device->pipe_count; ++i)
+                {
+                    USB_ENDPOINT_DESCRIPTOR *ep = &device->pipes[i];
+                    ep->bLength = sizeof(*ep);
+                    ep->bDescriptorType = USB_ENDPOINT_DESCRIPTOR_TYPE;
+                    ep->bEndpointAddress = iface->Pipes[i].EndpointAddress;
+                    ep->bmAttributes = iface->Pipes[i].PipeType;
+                    ep->wMaxPacketSize = iface->Pipes[i].MaximumPacketSize;
+                    ep->bInterval = iface->Pipes[i].Interval;
+                }
+            }
             if (status == STATUS_PENDING)
             {
                 IoMarkIrpPending(irp);
@@ -662,6 +684,8 @@
     return status;
 }
 
+static void create_tree(DRIVER_OBJECT *driver);
+
 static NTSTATUS WINAPI driver_add_device(DRIVER_OBJECT *driver, DEVICE_OBJECT *pdo)
 {
     NTSTATUS ret;
@@ -677,10 +701,362 @@
     IoAttachDeviceToDeviceStack(bus_fdo, pdo);
     bus_pdo = pdo;
     bus_fdo->Flags &= ~DO_DEVICE_INITIALIZING;
+    create_tree(driver);
 
     return STATUS_SUCCESS;
 }
 
+/* Stained Glass OS: the USB tree, as programs see it on Windows -- a host
+ * controller (\\.\HCD0) whose root hub's ports are the devices wineusb knows,
+ * port N the Nth. Scanner software walks it to find its device's port and
+ * speed (the Ambir ImageScan Pro 490i's library said "not connected" without
+ * a host controller); USBView-like tools list it. The IOCTLs and structures
+ * are usbioctl.h's (public); the hub's ports are virtual, the devices and
+ * their descriptors real. */
+
+#define USB_CTL(n) CTL_CODE(FILE_DEVICE_USB, (n), METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_USB_GET_ROOT_HUB_NAME                     USB_CTL(258)    /* on the HCD */
+#define IOCTL_GET_HCD_DRIVERKEY_NAME                    USB_CTL(265)    /* on the HCD */
+#define IOCTL_USB_GET_NODE_INFORMATION                  USB_CTL(258)    /* on a hub */
+#define IOCTL_USB_GET_NODE_CONNECTION_INFORMATION       USB_CTL(259)
+#define IOCTL_USB_GET_DESCRIPTOR_FROM_NODE_CONNECTION   USB_CTL(260)
+#define IOCTL_USB_GET_NODE_CONNECTION_NAME              USB_CTL(261)
+#define IOCTL_USB_GET_NODE_CONNECTION_DRIVERKEY_NAME    USB_CTL(264)
+#define IOCTL_USB_GET_HUB_CAPABILITIES                  USB_CTL(271)
+#define IOCTL_USB_GET_NODE_CONNECTION_ATTRIBUTES        USB_CTL(272)
+#define IOCTL_USB_GET_NODE_CONNECTION_INFORMATION_EX    USB_CTL(274)
+#define IOCTL_USB_GET_HUB_CAPABILITIES_EX               USB_CTL(276)
+#define IOCTL_USB_GET_NODE_CONNECTION_INFORMATION_EX_V2 USB_CTL(279)
+
+#define TREE_PORTS 15
+#define ROOT_HUB_NAME L"USB#ROOT_HUB20#4&wine&0#{f18a0e88-c30c-11d0-8815-00a0c906bed8}"
+
+#include "pshpack1.h"
+struct tree_name { ULONG actual_length; WCHAR name[1]; };
+struct tree_hub_descriptor
+{
+    UCHAR bDescriptorLength, bDescriptorType, bNumberOfPorts;
+    USHORT wHubCharacteristics;
+    UCHAR bPowerOnToPowerGood, bHubControlCurrent, bRemoveAndPowerMask[64];
+};
+struct tree_node_information
+{
+    ULONG node_type;    /* UsbHub */
+    struct tree_hub_descriptor hub;
+    BOOLEAN bus_powered;
+};
+struct tree_connection_info
+{
+    ULONG connection_index;
+    USB_DEVICE_DESCRIPTOR device_desc;
+    UCHAR current_config;
+    UCHAR speed;        /* EX: USB_DEVICE_SPEED; plain: BOOLEAN LowSpeed */
+    BOOLEAN is_hub;
+    USHORT address;
+    ULONG open_pipes;
+    ULONG status;       /* USB_CONNECTION_STATUS: 0 none, 1 connected */
+};
+struct tree_driverkey { ULONG connection_index; ULONG actual_length; WCHAR name[1]; };
+struct tree_descriptor_request
+{
+    ULONG connection_index;
+    UCHAR bmRequest, bRequest;
+    USHORT wValue, wIndex, wLength;
+    UCHAR data[1];
+};
+struct tree_connection_v2 { ULONG connection_index, length, protocols, flags; };
+struct tree_connection_attributes { ULONG connection_index, status, attributes; };
+#include "poppack.h"
+
+static DEVICE_OBJECT *hcd_device, *hub_device;
+
+/* the device at a port (a whole device, not one of its interfaces), with the
+ * lock held; NULL: none */
+static struct usb_device *port_device(ULONG port)
+{
+    struct usb_device *device;
+    ULONG n = 0;
+
+    LIST_FOR_EACH_ENTRY(device, &device_list, struct usb_device, entry)
+    {
+        if (device->interface || device->removed) continue;
+        if (++n == port) return device;
+    }
+    return NULL;
+}
+
+static void tree_name_reply(IRP *irp, ULONG out_size, ULONG prefix, const WCHAR *name, ULONG name_bytes)
+{
+    BYTE *out = irp->AssociatedIrp.SystemBuffer;
+    ULONG total = prefix + name_bytes + sizeof(WCHAR);
+
+    /* the size needed always; the name when it fits */
+    *(ULONG *)(out + prefix - sizeof(ULONG)) = total;
+    if (out_size >= total)
+    {
+        memcpy(out + prefix, name, name_bytes);
+        *(WCHAR *)(out + prefix + name_bytes) = 0;
+        irp->IoStatus.Information = total;
+    }
+    else irp->IoStatus.Information = prefix;
+}
+
+static NTSTATUS tree_hub_ioctl(IRP *irp, ULONG code, ULONG in_size, ULONG out_size)
+{
+    void *buffer = irp->AssociatedIrp.SystemBuffer;
+    struct usb_get_device_info_params info = {0};
+    struct usb_device *device;
+    ULONG port;
+
+    switch (code)
+    {
+    case IOCTL_USB_GET_NODE_INFORMATION:
+    {
+        struct tree_node_information node = {0};
+        if (out_size < sizeof(node)) return STATUS_BUFFER_TOO_SMALL;
+        node.node_type = 0;
+        node.hub.bDescriptorLength = 9;
+        node.hub.bDescriptorType = 0x29;
+        node.hub.bNumberOfPorts = TREE_PORTS;
+        node.bus_powered = FALSE;
+        memcpy(buffer, &node, sizeof(node));
+        irp->IoStatus.Information = sizeof(node);
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_USB_GET_HUB_CAPABILITIES:
+    case IOCTL_USB_GET_HUB_CAPABILITIES_EX:
+        if (out_size < sizeof(ULONG)) return STATUS_BUFFER_TOO_SMALL;
+        *(ULONG *)buffer = code == IOCTL_USB_GET_HUB_CAPABILITIES ? 1 /* high speed */ : 0x0b /* high speed, root */;
+        irp->IoStatus.Information = sizeof(ULONG);
+        return STATUS_SUCCESS;
+
+    case IOCTL_USB_GET_NODE_CONNECTION_INFORMATION:
+    case IOCTL_USB_GET_NODE_CONNECTION_INFORMATION_EX:
+    {
+        struct tree_connection_info conn = {0};
+        struct tree_pipe_info { USB_ENDPOINT_DESCRIPTOR ep; ULONG schedule_offset; } pipe_info[16];
+        ULONG pipe_count = 0, i;
+        if (in_size < sizeof(ULONG) || out_size < sizeof(conn)) return STATUS_BUFFER_TOO_SMALL;
+        port = *(ULONG *)buffer;
+        if (!port || port > TREE_PORTS) return STATUS_INVALID_PARAMETER;
+        conn.connection_index = port;
+        EnterCriticalSection(&wineusb_cs);
+        if ((device = port_device(port)))
+        {
+            struct usb_device *iface;
+
+            info.device = device->unix_device;
+            WINE_UNIX_CALL(unix_usb_get_device_info, &info);
+            /* the pipes open on it: its own, or its interfaces' */
+            LIST_FOR_EACH_ENTRY(iface, &device_list, struct usb_device, entry)
+            {
+                if (iface != device && !(iface->interface && iface->unix_device != device->unix_device &&
+                    iface->busnum == device->busnum && iface->portnum == device->portnum)) continue;
+                for (i = 0; i < iface->pipe_count && pipe_count < ARRAY_SIZE(pipe_info); ++i)
+                {
+                    pipe_info[pipe_count].ep = iface->pipes[i];
+                    pipe_info[pipe_count++].schedule_offset = 0;
+                }
+            }
+        }
+        LeaveCriticalSection(&wineusb_cs);
+        if (device)
+        {
+            memcpy(&conn.device_desc, info.descriptor, sizeof(conn.device_desc));
+            conn.current_config = info.config;
+            /* libusb 1 low, 2 full, 3 high, 4+ super; Windows 0 low, 1 full, 2 high, 3 super */
+            if (code == IOCTL_USB_GET_NODE_CONNECTION_INFORMATION_EX)
+                conn.speed = info.speed ? min(info.speed - 1, 3) : 1;
+            else
+                conn.speed = info.speed == 1;
+            conn.is_hub = conn.device_desc.bDeviceClass == 9;
+            conn.address = info.address;
+            conn.status = 1;
+            conn.open_pipes = pipe_count;
+        }
+        memcpy(buffer, &conn, sizeof(conn));
+        irp->IoStatus.Information = sizeof(conn);
+        /* the pipe list, as much as fits */
+        for (i = 0; i < pipe_count && irp->IoStatus.Information + sizeof(USB_ENDPOINT_DESCRIPTOR) + sizeof(ULONG) <= out_size; ++i)
+        {
+            memcpy((BYTE *)buffer + irp->IoStatus.Information, &pipe_info[i].ep, sizeof(USB_ENDPOINT_DESCRIPTOR));
+            irp->IoStatus.Information += sizeof(USB_ENDPOINT_DESCRIPTOR);
+            *(ULONG *)((BYTE *)buffer + irp->IoStatus.Information) = 0;
+            irp->IoStatus.Information += sizeof(ULONG);
+        }
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_USB_GET_NODE_CONNECTION_INFORMATION_EX_V2:
+    {
+        struct tree_connection_v2 v2;
+        if (in_size < sizeof(v2) || out_size < sizeof(v2)) return STATUS_BUFFER_TOO_SMALL;
+        memcpy(&v2, buffer, sizeof(v2));
+        if (!v2.connection_index || v2.connection_index > TREE_PORTS) return STATUS_INVALID_PARAMETER;
+        EnterCriticalSection(&wineusb_cs);
+        if ((device = port_device(v2.connection_index)))
+        {
+            info.device = device->unix_device;
+            WINE_UNIX_CALL(unix_usb_get_device_info, &info);
+        }
+        LeaveCriticalSection(&wineusb_cs);
+        v2.length = sizeof(v2);
+        v2.protocols = 0x3;   /* USB 1.1 and 2.0 */
+        v2.flags = 0;
+        if (device && info.speed >= 4)
+        {
+            v2.protocols |= 0x4;
+            v2.flags = 0x3;   /* operating at, capable of SuperSpeed */
+        }
+        memcpy(buffer, &v2, sizeof(v2));
+        irp->IoStatus.Information = sizeof(v2);
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_USB_GET_NODE_CONNECTION_ATTRIBUTES:
+    {
+        struct tree_connection_attributes attr = {0};
+        if (in_size < sizeof(ULONG) || out_size < sizeof(attr)) return STATUS_BUFFER_TOO_SMALL;
+        attr.connection_index = *(ULONG *)buffer;
+        EnterCriticalSection(&wineusb_cs);
+        attr.status = port_device(attr.connection_index) ? 1 : 0;
+        LeaveCriticalSection(&wineusb_cs);
+        memcpy(buffer, &attr, sizeof(attr));
+        irp->IoStatus.Information = sizeof(attr);
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_USB_GET_NODE_CONNECTION_DRIVERKEY_NAME:
+    case IOCTL_USB_GET_NODE_CONNECTION_NAME:
+    {
+        WCHAR key[256];
+        ULONG size = 0;
+        DEVICE_OBJECT *pdo = NULL;
+        if (in_size < sizeof(ULONG) || out_size < 2 * sizeof(ULONG)) return STATUS_BUFFER_TOO_SMALL;
+        port = *(ULONG *)buffer;
+        EnterCriticalSection(&wineusb_cs);
+        if ((device = port_device(port))) pdo = device->device_obj;
+        LeaveCriticalSection(&wineusb_cs);
+        if (!pdo) return STATUS_INVALID_PARAMETER;
+        if (code == IOCTL_USB_GET_NODE_CONNECTION_NAME) /* only a hub has one */
+        {
+            tree_name_reply(irp, out_size, 2 * sizeof(ULONG), L"", 0);
+            return STATUS_SUCCESS;
+        }
+        if (IoGetDeviceProperty(pdo, DevicePropertyDriverKeyName, sizeof(key), key, &size)) return STATUS_INVALID_PARAMETER;
+        tree_name_reply(irp, out_size, 2 * sizeof(ULONG), key, size > sizeof(WCHAR) ? size - sizeof(WCHAR) : 0);
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_USB_GET_DESCRIPTOR_FROM_NODE_CONNECTION:
+    {
+        struct tree_descriptor_request *req = buffer;
+        struct usb_get_descriptor_params params = {0};
+        UINT32 got = 0;
+        ULONG header = offsetof(struct tree_descriptor_request, data);
+        NTSTATUS status;
+        if (in_size < header || out_size < header) return STATUS_BUFFER_TOO_SMALL;
+        EnterCriticalSection(&wineusb_cs);
+        device = port_device(req->connection_index);
+        params.device = device ? device->unix_device : NULL;
+        LeaveCriticalSection(&wineusb_cs);
+        if (!device) return STATUS_INVALID_PARAMETER;
+        params.request_type = 0x80;     /* in, standard, device: GET_DESCRIPTOR */
+        params.request = req->bRequest ? req->bRequest : 6;
+        params.value = req->wValue;
+        params.index = req->wIndex;
+        params.buffer = req->data;
+        params.length = min(req->wLength, out_size - header);
+        params.ret_length = &got;
+        if ((status = WINE_UNIX_CALL(unix_usb_get_descriptor, &params))) return status;
+        irp->IoStatus.Information = header + got;
+        return STATUS_SUCCESS;
+    }
+    }
+
+    FIXME("hub ioctl %#lx\n", code);
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS WINAPI tree_ioctl(DEVICE_OBJECT *device, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG code = stack->Parameters.DeviceIoControl.IoControlCode;
+    ULONG in_size = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_size = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    NTSTATUS status = STATUS_INVALID_DEVICE_REQUEST;
+
+    irp->IoStatus.Information = 0;
+    if (device == hcd_device)
+    {
+        if (code == IOCTL_USB_GET_ROOT_HUB_NAME)
+        {
+            if (out_size < sizeof(ULONG)) status = STATUS_BUFFER_TOO_SMALL;
+            else
+            {
+                tree_name_reply(irp, out_size, sizeof(ULONG), ROOT_HUB_NAME, sizeof(ROOT_HUB_NAME) - sizeof(WCHAR));
+                status = STATUS_SUCCESS;
+            }
+        }
+        else if (code == IOCTL_GET_HCD_DRIVERKEY_NAME)
+        {
+            static const WCHAR key[] = L"{36fc9e60-c465-11cf-8056-444553540000}\\0000";
+            if (out_size < sizeof(ULONG)) status = STATUS_BUFFER_TOO_SMALL;
+            else
+            {
+                tree_name_reply(irp, out_size, sizeof(ULONG), key, sizeof(key) - sizeof(WCHAR));
+                status = STATUS_SUCCESS;
+            }
+        }
+        else FIXME("hcd ioctl %#lx\n", code);
+    }
+    else if (device == hub_device)
+        status = tree_hub_ioctl(irp, code, in_size, out_size);
+
+    TRACE("device %p, code %#lx: %#lx.\n", device, code, status);
+    irp->IoStatus.Status = status;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    return status;
+}
+
+static NTSTATUS WINAPI tree_create_close(DEVICE_OBJECT *device, IRP *irp)
+{
+    NTSTATUS status = device == hcd_device || device == hub_device ? STATUS_SUCCESS : STATUS_INVALID_DEVICE_REQUEST;
+
+    irp->IoStatus.Status = status;
+    irp->IoStatus.Information = 0;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    return status;
+}
+
+static void create_tree(DRIVER_OBJECT *driver)
+{
+    UNICODE_STRING hcd = RTL_CONSTANT_STRING(L"\\Device\\USBFDO-0");
+    UNICODE_STRING hcd_link = RTL_CONSTANT_STRING(L"\\DosDevices\\HCD0");
+    UNICODE_STRING hub = RTL_CONSTANT_STRING(L"\\Device\\USBPDO-ROOTHUB");
+    UNICODE_STRING hub_link = RTL_CONSTANT_STRING(L"\\DosDevices\\" ROOT_HUB_NAME);
+    NTSTATUS status;
+
+#ifdef SG_MUTANT_NOUSBTREE
+    return;
+#endif
+    if ((status = IoCreateDevice(driver, 0, &hcd, FILE_DEVICE_CONTROLLER, 0, FALSE, &hcd_device)))
+    {
+        ERR("no host controller device: %#lx\n", status);
+        return;
+    }
+    if ((status = IoCreateDevice(driver, 0, &hub, FILE_DEVICE_USB, 0, FALSE, &hub_device)))
+    {
+        ERR("no root hub device: %#lx\n", status);
+        return;
+    }
+    IoCreateSymbolicLink(&hcd_link, &hcd);
+    IoCreateSymbolicLink(&hub_link, &hub);
+    hcd_device->Flags &= ~DO_DEVICE_INITIALIZING;
+    hub_device->Flags &= ~DO_DEVICE_INITIALIZING;
+}
+
 static void WINAPI driver_unload(DRIVER_OBJECT *driver)
 {
 }
@@ -703,6 +1079,9 @@
     driver->DriverUnload = driver_unload;
     driver->MajorFunction[IRP_MJ_PNP] = driver_pnp;
     driver->MajorFunction[IRP_MJ_INTERNAL_DEVICE_CONTROL] = driver_internal_ioctl;
+    driver->MajorFunction[IRP_MJ_DEVICE_CONTROL] = tree_ioctl;
+    driver->MajorFunction[IRP_MJ_CREATE] = tree_create_close;
+    driver->MajorFunction[IRP_MJ_CLOSE] = tree_create_close;
 
     return STATUS_SUCCESS;
 }
