+/* ---- generic options (*OpenUI) ---- */
+
+struct ui_tuple
+{
+    struct list entry;
+    char *key, *option, *opttrans, *value;
+};
+
+struct ui_parse
+{
+    struct list tuples;       /* every "*Key option: value" line */
+    struct list orders;       /* *OrderDependency values */
+    struct list defaults;     /* *DefaultKey: value */
+    PPD_FEATURE *current;
+    char *group;
+    BOOL utf8;
+};
+
+static char *heap_strdup( const char *str )
+{
+    char *ret;
+    if (!str) return NULL;
+    ret = HeapAlloc( PSDRV_Heap, 0, strlen( str ) + 1 );
+    strcpy( ret, str );
+    return ret;
+}
+
+static WCHAR *ppd_text( const struct ui_parse *ui, const char *str )
+{
+    int len, cp = ui->utf8 ? CP_UTF8 : 1252;
+    WCHAR *ret;
+    if (!str) return NULL;
+    len = MultiByteToWideChar( cp, 0, str, -1, NULL, 0 );
+    ret = HeapAlloc( PSDRV_Heap, 0, len * sizeof(WCHAR) );
+    MultiByteToWideChar( cp, 0, str, -1, ret, len );
+    return ret;
+}
+
+static void ui_record( struct list *list, const char *key, const char *option, const char *opttrans,
+                       const char *value )
+{
+    struct ui_tuple *t = HeapAlloc( PSDRV_Heap, HEAP_ZERO_MEMORY, sizeof(*t) );
+    t->key = heap_strdup( key );
+    t->option = heap_strdup( option );
+    t->opttrans = heap_strdup( opttrans );
+    t->value = heap_strdup( value );
+    list_add_tail( list, &t->entry );
+}
+
+/* options wineps has always handled itself */
+static BOOL builtin_keyword( const char *keyword )
+{
+    static const char *builtin[] = { "PageSize", "PageRegion", "InputSlot", "ManualFeed", "Duplex" };
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(builtin); i++) if (!strcmp( keyword, builtin[i] )) return TRUE;
+    return FALSE;
+}
+
+static void ui_open( struct ui_parse *ui, PPD *ppd, const PPDTuple *tuple, BOOL jcl )
+{
+    PPD_FEATURE *f;
+    const char *keyword = tuple->option ? tuple->option : "";
+
+    ui->current = NULL;
+    if (*keyword == '*') keyword++;
+    if (!*keyword || ppd_find_feature( ppd, keyword )) return;
+    f = HeapAlloc( PSDRV_Heap, HEAP_ZERO_MEMORY, sizeof(*f) );
+    f->keyword = heap_strdup( keyword );
+    f->text = ppd_text( ui, tuple->opttrans ? tuple->opttrans : keyword );
+    f->group = heap_strdup( ui->group );
+    f->jcl = jcl;
+    f->section = jcl ? SECTION_JCL : SECTION_ANY;
+    f->order = 50;
+    if (tuple->value && !strncmp( tuple->value, "PickMany", 8 )) f->type = UI_PICKMANY;
+    else if (tuple->value && !strncmp( tuple->value, "Boolean", 7 )) f->type = UI_BOOLEAN;
+    else f->type = UI_PICKONE;
+    list_add_tail( &ppd->Features, &f->entry );
+    ui->current = f;
+}
+
+/* "10 AnySetup *ColorModel" */
+static void ui_order( PPD *ppd, const char *value )
+{
+    char section[32], keyword[128];
+    float order;
+    PPD_FEATURE *f;
+
+    if (_sscanf_l( value, " %f %31s %127s", c_locale, &order, section, keyword ) != 3 || keyword[0] != '*') return;
+    if (!(f = ppd_find_feature( ppd, keyword + 1 ))) return;
+    f->order = order;
+    if (f->jcl) return;
+    if (!strcmp( section, "ExitServer" )) f->section = SECTION_EXITSERVER;
+    else if (!strcmp( section, "Prolog" )) f->section = SECTION_PROLOG;
+    else if (!strcmp( section, "DocumentSetup" )) f->section = SECTION_DOCUMENT;
+    else if (!strcmp( section, "PageSetup" )) f->section = SECTION_PAGE;
+    else if (!strcmp( section, "JCLSetup" )) f->section = SECTION_JCL;
+    else f->section = SECTION_ANY;
+}
+
+static void ui_finish( struct ui_parse *ui, PPD *ppd )
+{
+    struct ui_tuple *t, *next;
+    PPD_FEATURE *f, *fnext;
+    int index = 0;
+
+    LIST_FOR_EACH_ENTRY( t, &ui->orders, struct ui_tuple, entry ) ui_order( ppd, t->value );
+    LIST_FOR_EACH_ENTRY( t, &ui->tuples, struct ui_tuple, entry )
+    {
+        PPD_OPTION *opt;
+        if (!(f = ppd_find_feature( ppd, t->key + 1 ))) continue;
+        if (ppd_feature_option( f, t->option ) >= 0) continue;  /* the first one counts */
+        if (f->count >= PSDRV_NO_OPTION) continue;
+        f->options = f->options ? HeapReAlloc( PSDRV_Heap, 0, f->options, (f->count + 1) * sizeof(*f->options) )
+                                : HeapAlloc( PSDRV_Heap, 0, sizeof(*f->options) );
+        opt = &f->options[f->count++];
+        opt->name = heap_strdup( t->option );
+        opt->text = ppd_text( ui, t->opttrans ? t->opttrans : t->option );
+        opt->invocation = heap_strdup( t->value ? t->value : "" );
+    }
+    LIST_FOR_EACH_ENTRY( t, &ui->defaults, struct ui_tuple, entry )
+    {
+        if ((f = ppd_find_feature( ppd, t->key + 8 )) && !f->default_option)  /* "*Default" */
+            f->default_option = heap_strdup( t->value );
+    }
+    /* features without options, or that wineps handles itself, are dropped */
+    LIST_FOR_EACH_ENTRY_SAFE( f, fnext, &ppd->Features, PPD_FEATURE, entry )
+    {
+        if (f->count && !builtin_keyword( f->keyword ))
+        {
+            f->index = index++;
+            TRACE( "feature %s (%s) %d options, default %s, order %.1f section %d%s\n", debugstr_a(f->keyword),
+                   debugstr_w(f->text), f->count, debugstr_a(f->default_option), f->order, f->section,
+                   f->jcl ? " JCL" : "" );
+            continue;
+        }
+        list_remove( &f->entry );
+    }
+    ppd->FeatureCount = index;
+
+    LIST_FOR_EACH_ENTRY_SAFE( t, next, &ui->tuples, struct ui_tuple, entry )
+    {
+        list_remove( &t->entry );
+        HeapFree( PSDRV_Heap, 0, t->key );
+        HeapFree( PSDRV_Heap, 0, t->option );
+        HeapFree( PSDRV_Heap, 0, t->opttrans );
+        HeapFree( PSDRV_Heap, 0, t->value );
+        HeapFree( PSDRV_Heap, 0, t );
+    }
+}
