--- /dev/null
+++ b/dlls/wineps.drv/features.c
@@ -0,0 +1,343 @@
+/*
+ * PostScript driver: a PPD's options
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A printer maker's PPD describes the printer's options in *OpenUI groups:
+ * colour, collation, media type, stapling, toner saving, trays...  The
+ * option chosen for each lives in the devmode after wineps's own tables (a
+ * struct feature_selection), the public fields a program sets (dmColor,
+ * dmCollate, dmMediaType, dmPrintQuality) choose the matching options, and
+ * the job carries each option's invocation code where its
+ * *OrderDependency puts it: PJL before the PostScript (*JCLOpenUI options,
+ * between *JCLBegin and *JCLToPSInterpreter), then the prolog, the
+ * document setup and each page's setup, as the Adobe PPD specification
+ * describes.
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winnls.h"
+#include "psdrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(psdrv);
+
+PPD_FEATURE *ppd_find_feature( PPD *ppd, const char *keyword )
+{
+    PPD_FEATURE *f;
+    LIST_FOR_EACH_ENTRY( f, &ppd->Features, PPD_FEATURE, entry )
+        if (!strcmp( f->keyword, keyword )) return f;
+    return NULL;
+}
+
+int ppd_feature_option( const PPD_FEATURE *feature, const char *name )
+{
+    int i;
+    if (!name) return -1;
+    for (i = 0; i < feature->count; i++)
+        if (!strcmp( feature->options[i].name, name )) return i;
+    return -1;
+}
+
+/* the selections follow wineps's tables in the private devmode */
+static SIZE_T tables_size( const PSDRV_DEVMODE *dm )
+{
+    return dm->input_slots * sizeof(struct input_slot) + dm->resolutions * sizeof(struct resolution) +
+           dm->page_sizes * sizeof(struct page_size) + dm->font_subs * sizeof(struct font_sub) +
+           dm->installed_fonts * sizeof(struct installed_font);
+}
+
+struct feature_selection *devmode_features( PSDRV_DEVMODE *dm )
+{
+    struct feature_selection *sel;
+    SIZE_T offset;
+
+    if (!dm || !dm->features) return NULL;
+    offset = FIELD_OFFSET(PSDRV_DEVMODE, data[tables_size( dm )]);
+    if (offset + FIELD_OFFSET(struct feature_selection, option[dm->features]) >
+        dm->dmPublic.dmSize + dm->dmPublic.dmDriverExtra)
+        return NULL;
+    sel = (struct feature_selection *)((BYTE *)dm + offset);
+    if (sel->signature != PSDRV_FEATURE_SIGNATURE || sel->count != dm->features) return NULL;
+    return sel;
+}
+
+/* a program's devmode: ours only if laid out for this printer */
+const struct feature_selection *devmode_features_const( const DEVMODEW *dm, const PRINTERINFO *pi )
+{
+    const PSDRV_DEVMODE *ps = (const PSDRV_DEVMODE *)dm;
+    if (!dm || dm->dmSize != pi->Devmode->dmPublic.dmSize ||
+        dm->dmDriverExtra != pi->Devmode->dmPublic.dmDriverExtra)
+        return NULL;
+    if (ps->features != pi->Devmode->features || ps->input_slots != pi->Devmode->input_slots ||
+        ps->resolutions != pi->Devmode->resolutions || ps->page_sizes != pi->Devmode->page_sizes ||
+        ps->font_subs != pi->Devmode->font_subs || ps->installed_fonts != pi->Devmode->installed_fonts)
+        return NULL;
+    return devmode_features( (PSDRV_DEVMODE *)ps );
+}
+
+int features_selected( PRINTERINFO *pi, PSDRV_DEVMODE *dm, const PPD_FEATURE *f )
+{
+    struct feature_selection *sel = devmode_features( dm );
+    int def;
+
+    if (sel && f->index < sel->count && sel->option[f->index] < f->count) return sel->option[f->index];
+    if (sel && f->index < sel->count && sel->option[f->index] == PSDRV_NO_OPTION) return -1;
+    def = ppd_feature_option( f, f->default_option );
+    return def;
+}
+
+/* is this a colour option of a colour feature (not grey, mono, black)? */
+BOOL features_is_color_option( const PPD_FEATURE *f, int option )
+{
+    static const char *grey[] = { "Gray", "Grey", "Mono", "Black", "BW", "KOnly", "False", "Off", "None" };
+    const char *name = f->options[option].name;
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(grey); i++)
+        if (strstr( name, grey[i] ) || !_strnicmp( name, grey[i], strlen( grey[i] ) )) return FALSE;
+    return TRUE;
+}
+
+/* the feature that chooses colour or grey: a colour keyword with a grey option */
+PPD_FEATURE *features_color( PPD *ppd )
+{
+    static const char *keywords[] = { "ColorModel", "ColorMode", "SelectColor", "Color", "ColorType",
+                                      "ColorOutput", "EFColorMode", "CNColorMode", "BRMonoColor",
+                                      "XRXColor", "OutputMode", "ColorPrint" };
+    PPD_FEATURE *f;
+    unsigned int i;
+    int j;
+
+    for (i = 0; i < ARRAY_SIZE(keywords); i++)
+    {
+        if (!(f = ppd_find_feature( ppd, keywords[i] ))) continue;
+        for (j = 0; j < f->count; j++) if (!features_is_color_option( f, j )) return f;
+    }
+    LIST_FOR_EACH_ENTRY( f, &ppd->Features, PPD_FEATURE, entry )
+    {
+        if (f->jcl || !strstr( f->keyword, "Color" )) continue;
+        for (j = 0; j < f->count; j++) if (!features_is_color_option( f, j )) return f;
+    }
+    return NULL;
+}
+
+void features_set_defaults( PRINTERINFO *pi, PSDRV_DEVMODE *dm )
+{
+    struct feature_selection *sel;
+    PPD_FEATURE *f;
+    SIZE_T offset = FIELD_OFFSET(PSDRV_DEVMODE, data[tables_size( dm )]);
+
+    if (!dm->features) return;
+    sel = (struct feature_selection *)((BYTE *)dm + offset);
+    sel->signature = PSDRV_FEATURE_SIGNATURE;
+    sel->count = dm->features;
+    memset( sel->option, PSDRV_NO_OPTION, sel->count );
+    LIST_FOR_EACH_ENTRY( f, &pi->ppd->Features, PPD_FEATURE, entry )
+    {
+        int def = ppd_feature_option( f, f->default_option );
+        if (f->index < sel->count) sel->option[f->index] = def >= 0 ? def : (f->type == UI_PICKMANY ? PSDRV_NO_OPTION : 0);
+    }
+}
+
+static void select_option( PSDRV_DEVMODE *dm, const PPD_FEATURE *f, int option )
+{
+    struct feature_selection *sel = devmode_features( dm );
+    if (sel && f->index < sel->count && option >= 0 && option < f->count) sel->option[f->index] = option;
+}
+
+/* the public fields a program set choose the options that mean them */
+void features_from_public( PRINTERINFO *pi, PSDRV_DEVMODE *dm, DWORD fields )
+{
+    PPD *ppd = pi->ppd;
+    PPD_FEATURE *f;
+    int i, cur;
+
+    if (!devmode_features( dm )) return;
+    if ((fields & DM_COLOR) && (f = features_color( ppd )))
+    {
+        BOOL color = dm->dmPublic.dmColor == DMCOLOR_COLOR;
+        cur = features_selected( pi, dm, f );
+        if (cur < 0 || features_is_color_option( f, cur ) != color)
+        {
+            int def = ppd_feature_option( f, f->default_option );
+            if (def >= 0 && features_is_color_option( f, def ) == color) select_option( dm, f, def );
+            else for (i = 0; i < f->count; i++)
+                if (features_is_color_option( f, i ) == color) { select_option( dm, f, i ); break; }
+        }
+    }
+    if ((fields & DM_COLLATE) && (f = ppd_find_feature( ppd, "Collate" )))
+    {
+        const char *want = dm->dmPublic.dmCollate == DMCOLLATE_TRUE ? "True" : "False";
+        if ((i = ppd_feature_option( f, want )) >= 0) select_option( dm, f, i );
+    }
+    if ((fields & DM_MEDIATYPE) && (f = ppd_find_feature( ppd, "MediaType" )))
+    {
+        if (dm->dmPublic.dmMediaType >= DMMEDIA_USER && dm->dmPublic.dmMediaType - DMMEDIA_USER < f->count)
+            select_option( dm, f, dm->dmPublic.dmMediaType - DMMEDIA_USER );
+    }
+    if ((fields & DM_PRINTQUALITY) && dm->dmPublic.dmPrintQuality > 0 && (f = ppd_find_feature( ppd, "Resolution" )))
+    {
+        for (i = 0; i < f->count; i++)
+        {
+            int x = 0, y = 0;
+            if (sscanf( f->options[i].name, "%dx%d", &x, &y ) < 1) continue;
+            if (x == dm->dmPublic.dmPrintQuality &&
+                (!y || !(fields & DM_YRESOLUTION) || dm->dmPublic.dmYResolution <= 0 || y == dm->dmPublic.dmYResolution))
+            {
+                select_option( dm, f, i );
+                break;
+            }
+        }
+    }
+}
+
+/* and the options say what the public fields read */
+void features_to_public( PRINTERINFO *pi, PSDRV_DEVMODE *dm )
+{
+    PPD_FEATURE *f;
+    int cur;
+
+    if (!devmode_features( dm )) return;
+    if ((f = features_color( pi->ppd )) && (cur = features_selected( pi, dm, f )) >= 0)
+    {
+        dm->dmPublic.dmColor = features_is_color_option( f, cur ) ? DMCOLOR_COLOR : DMCOLOR_MONOCHROME;
+        dm->dmPublic.dmFields |= DM_COLOR;
+    }
+    if ((f = ppd_find_feature( pi->ppd, "Collate" )) && (cur = features_selected( pi, dm, f )) >= 0)
+    {
+        dm->dmPublic.dmCollate = !strcmp( f->options[cur].name, "True" ) ? DMCOLLATE_TRUE : DMCOLLATE_FALSE;
+        dm->dmPublic.dmFields |= DM_COLLATE;
+    }
+    if ((f = ppd_find_feature( pi->ppd, "MediaType" )) && (cur = features_selected( pi, dm, f )) >= 0)
+    {
+        dm->dmPublic.dmMediaType = DMMEDIA_USER + cur;
+        dm->dmPublic.dmFields |= DM_MEDIATYPE;
+    }
+}
+
+/* a devmode from a program: its private selections if it is ours, then
+ * what its public fields say */
+void features_merge( PRINTERINFO *pi, PSDRV_DEVMODE *dm1, const DEVMODEW *dm2 )
+{
+    const struct feature_selection *in = devmode_features_const( dm2, pi );
+    struct feature_selection *out = devmode_features( dm1 );
+
+    if (!out) return;
+    if (in && in != out) memcpy( out->option, in->option, out->count );
+    features_from_public( pi, dm1, dm2->dmFields );
+}
+
+static int compare_order( const void *a, const void *b )
+{
+    const PPD_FEATURE *fa = *(const PPD_FEATURE * const *)a, *fb = *(const PPD_FEATURE * const *)b;
+    if (fa->order < fb->order) return -1;
+    if (fa->order > fb->order) return 1;
+    return fa->index - fb->index;
+}
+
+/* the options to send in a section, in their order; a printer of the
+ * system's own PPD (CUPS) gets only what differs from its defaults, as
+ * CUPS sends those itself */
+static int section_features( print_ctx *ctx, enum ppd_section section, PPD_FEATURE **out )
+{
+    PPD_FEATURE *f;
+    int count = 0;
+
+    LIST_FOR_EACH_ENTRY( f, &ctx->pi->ppd->Features, PPD_FEATURE, entry )
+    {
+        int cur = features_selected( ctx->pi, ctx->Devmode, f );
+        BOOL in_section;
+
+        if (cur < 0 || !f->options[cur].invocation || !f->options[cur].invocation[0]) continue;
+        if (section == SECTION_JCL) in_section = f->jcl || f->section == SECTION_JCL;
+        else if (section == SECTION_DOCUMENT) in_section = !f->jcl && (f->section == SECTION_DOCUMENT ||
+                                                                        f->section == SECTION_ANY);
+        else in_section = !f->jcl && f->section == section;
+        if (!in_section) continue;
+        if (!ctx->pi->maker_driver && cur == ppd_feature_option( f, f->default_option )) continue;
+        out[count++] = f;
+    }
+    qsort( out, count, sizeof(*out), compare_order );
+    return count;
+}
+
+void features_write( print_ctx *ctx, enum ppd_section section )
+{
+    PPD_FEATURE **list;
+    int count, i;
+
+#ifdef SG_MUTANT_PPDWRITE
