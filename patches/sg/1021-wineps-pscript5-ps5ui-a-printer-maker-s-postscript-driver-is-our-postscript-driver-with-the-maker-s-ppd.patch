+static HMODULE wineps;
+
+/* wineps.drv lives where the printer drivers do */
+static HMODULE load_wineps( void )
+{
+    WCHAR path[MAX_PATH];
+    DWORD size;
+    HMODULE module;
+
+    if ((module = LoadLibraryW( L"wineps.drv" ))) return module;
+    if (GetPrinterDriverDirectoryW( NULL, NULL, 1, (BYTE *)path, sizeof(path) - 32, &size ))
+    {
+        lstrcatW( path, L"\\3\\wineps.drv" );
+        if ((module = LoadLibraryW( path ))) return module;
+    }
+    if (GetPrintProcessorDirectoryW( NULL, NULL, 1, (BYTE *)path, sizeof(path) - 32, &size ))
+    {
+        lstrcatW( path, L"\\wineps.drv" );
+        if ((module = LoadLibraryW( path ))) return module;
+    }
+    ERR( "wineps.drv not found\n" );
+    return NULL;
+}
+
+static FARPROC get_wineps_proc( const char *name )
+{
+    if (!wineps && !(wineps = load_wineps())) return NULL;
+    return GetProcAddress( wineps, name );
+}
+
+DWORD WINAPI DrvDeviceCapabilities( HANDLE printer, WCHAR *device, WORD capability, void *output, DEVMODEW *devmode )
+{
+    DWORD (WINAPI *fn)( HANDLE, WCHAR *, WORD, void *, DEVMODEW * ) = (void *)get_wineps_proc( "DrvDeviceCapabilities" );
+    if (!fn) return GDI_ERROR;
+    return fn( printer, device, capability, output, devmode );
+}
+
+LONG WINAPI DrvDocumentPropertySheets( PROPSHEETUI_INFO *info, LPARAM lparam )
+{
+    LONG (WINAPI *fn)( PROPSHEETUI_INFO *, LPARAM ) = (void *)get_wineps_proc( "DrvDocumentPropertySheets" );
+    if (!fn) return -1;
+    return fn( info, lparam );
+}
