+    }
+    free( list );
+}
+
+/* PJL before the PostScript: *JCLBegin, the JCL options, then the switch
+ * to the PostScript interpreter -- for a maker's driver, whose job goes
+ * to the printer as it is */
+void features_write_jcl_begin( print_ctx *ctx )
+{
+    PPD *ppd = ctx->pi->ppd;
+    PPD_FEATURE **list;
+    int count, i;
+
+    if (!ctx->pi->maker_driver || !ppd->JCLBegin) return;
+    write_spool( ctx, ppd->JCLBegin, strlen( ppd->JCLBegin ) );
+    if (ppd->FeatureCount)
+    {
+        list = malloc( ppd->FeatureCount * sizeof(*list) );
+        count = section_features( ctx, SECTION_JCL, list );
+        for (i = 0; i < count; i++)
+        {
+            const PPD_OPTION *opt = &list[i]->options[features_selected( ctx->pi, ctx->Devmode, list[i] )];
+            TRACE( "JCL *%s %s\n", list[i]->keyword, opt->name );
+            write_spool( ctx, opt->invocation, strlen( opt->invocation ) );
+        }
+        free( list );
+    }
+    if (ppd->JCLToPSInterpreter) write_spool( ctx, ppd->JCLToPSInterpreter, strlen( ppd->JCLToPSInterpreter ) );
+}
+
+void features_write_jcl_end( print_ctx *ctx )
+{
+    PPD *ppd = ctx->pi->ppd;
+    if (!ctx->pi->maker_driver || !ppd->JCLBegin || !ppd->JCLEnd) return;
+    write_spool( ctx, ppd->JCLEnd, strlen( ppd->JCLEnd ) );
+}
