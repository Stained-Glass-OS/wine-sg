+    list = malloc( ctx->pi->ppd->FeatureCount * sizeof(*list) );
+    count = section_features( ctx, section, list );
+    for (i = 0; i < count; i++)
+    {
+        const PPD_OPTION *opt = &list[i]->options[features_selected( ctx->pi, ctx->Devmode, list[i] )];
+        char head[300];
+
+        TRACE( "*%s %s\n", list[i]->keyword, opt->name );
+        snprintf( head, sizeof(head), "mark {\n%%%%BeginFeature: *%s %s\n", list[i]->keyword, opt->name );
+        write_spool( ctx, head, strlen( head ) );
+        write_spool( ctx, opt->invocation, strlen( opt->invocation ) );
