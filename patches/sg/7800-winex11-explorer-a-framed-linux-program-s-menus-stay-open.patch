+/* Stained Glass OS: a menu is no window to frame. Steam's View, Friends,
+ * Games and Help menus are windows of their own that close when they lose
+ * the X focus (David 2026-11-15: they showed "for only a single frame and
+ * then disappear"); the compositor lists such a window once its program's
+ * window is framed (no longer a top-level it shows), and framed it was --
+ * reparented into a Wine window, it lost the focus and closed. A window
+ * manager frames none of these and gives them no taskbar button: a window
+ * whose type is a menu's, a tooltip's, a combo box's list, a drag icon or a
+ * notification (EWMH _NET_WM_WINDOW_TYPE), and a window that asks for no
+ * decorations and is transient for another (ICCCM WM_TRANSIENT_FOR) or asks
+ * for no taskbar button (_NET_WM_STATE_SKIP_TASKBAR) -- its program's popup.
+ * A dialog (transient, decorated) is framed as before. */
+static BOOL is_popup( Display *display, Window child )
+{
+    static const char * const names[] =
+    {
+        "_NET_WM_WINDOW_TYPE", "_NET_WM_WINDOW_TYPE_MENU", "_NET_WM_WINDOW_TYPE_DROPDOWN_MENU",
+        "_NET_WM_WINDOW_TYPE_POPUP_MENU", "_NET_WM_WINDOW_TYPE_TOOLTIP", "_NET_WM_WINDOW_TYPE_COMBO",
+        "_NET_WM_WINDOW_TYPE_DND", "_NET_WM_WINDOW_TYPE_NOTIFICATION", "_NET_WM_STATE", "_NET_WM_STATE_SKIP_TASKBAR",
+    };
+    enum { TYPE, FIRST_POPUP_TYPE, LAST_POPUP_TYPE = 7, STATE, SKIP_TASKBAR, COUNT };
+    Atom atoms[COUNT], type, *list = NULL;
+    Window owner = None;
+    int format, j;
+    unsigned long count = 0, remaining, i;
+    BOOL ret = FALSE;
+
+#ifdef SG_MUTANT_EMBED_FRAMES_MENUS
+    return FALSE;
+#endif
+    if (!XInternAtoms( display, (char **)names, COUNT, False, atoms )) return FALSE;
+    X11DRV_expect_error( display, ignore_error, NULL );
+    if (!XGetWindowProperty( display, child, atoms[TYPE], 0, 16, False, XA_ATOM, &type, &format, &count,
+                             &remaining, (unsigned char **)&list ) && list && format == 32)
+        for (i = 0; i < count && !ret; i++)
+            for (j = FIRST_POPUP_TYPE; j <= LAST_POPUP_TYPE; j++) if (list[i] == atoms[j]) ret = TRUE;
+    if (list) XFree( list );
+    list = NULL;
+    if (sync_check_error( display )) return FALSE;
+    if (!ret && draws_own_frame( display, child ))
+    {
+        X11DRV_expect_error( display, ignore_error, NULL );
+        if (XGetTransientForHint( display, child, &owner ) && owner && owner != DefaultRootWindow( display ))
+            ret = TRUE;
+        else if (!XGetWindowProperty( display, child, atoms[STATE], 0, 32, False, XA_ATOM, &type, &format, &count,
+                                      &remaining, (unsigned char **)&list ) && list && format == 32)
+            for (i = 0; i < count; i++) if (list[i] == atoms[SKIP_TASKBAR]) ret = TRUE;
+        if (list) XFree( list );
+        if (sync_check_error( display )) return FALSE;
+    }
+    if (ret) TRACE( "%lx: a menu or popup, not framed\n", child );
+    return ret;
+}
