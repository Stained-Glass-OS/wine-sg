+/* Stained Glass OS: where the X focus is, for the program's window in its
+ * frame: in it (FOCUS_IN), on a menu of the program (FOCUS_OWN_MENU), or
+ * elsewhere.
+ *
+ * A menu of the program's is a top-level window of its own (Steam's View,
+ * Friends, Games and Help menus, David 2026-11-15): the same process's
+ * (_NET_WM_PID) or saying it is the program window's (WM_TRANSIENT_FOR,
+ * WM_CLIENT_LEADER), a menu or an override-redirect popup (is_popup). A
+ * click into the program activates its frame -- posted, after the click
+ * (WM_X11DRV_SG_EMBED_ACTIVATE) -- and the menu that click opened could be up
+ * and given the focus by then: the frame took the focus back for the
+ * program's window, and the menu, losing it, closed, shown for a single
+ * frame. A window manager gives the focus with the click, and never takes
+ * it from the menu the click opened. */
+enum { FOCUS_ELSEWHERE, FOCUS_IN, FOCUS_OWN_MENU };
+
+static int focus_state( Display *display, Window child )
+{
+    Window focus = None, w, root, parent = None, owner = None, *children;
+    unsigned int n;
+    int revert, i;
+    XWindowAttributes attr;
+    BOOL same, ok = TRUE;
+    long pid;
+
+    X11DRV_expect_error( display, ignore_error, NULL );
+    XGetInputFocus( display, &focus, &revert );
+    /* the top-level the focus is in (or the program's window) */
+    for (w = focus, i = 0; ok && w != None && w != PointerRoot && w != child && i < 16; i++)
+    {
+        if (!(ok = XQueryTree( display, w, &root, &parent, &children, &n ))) break;
+        if (children) XFree( children );
+        if (parent == root) break;
+        w = parent;
+    }
+    if (ok && w == child) { sync_check_error( display ); return FOCUS_IN; }
+    ok = ok && w != None && w != PointerRoot && parent == root && XGetWindowAttributes( display, w, &attr ) &&
+         attr.map_state == IsViewable;
+    if (sync_check_error( display ) || !ok) return FOCUS_ELSEWHERE;
+#ifdef SG_MUTANT_EMBED_FOCUS_OVER_MENU
+    return FOCUS_ELSEWHERE;
+#endif
+    X11DRV_expect_error( display, ignore_error, NULL );
+    pid = get_cardinal( display, child, XInternAtom( display, "_NET_WM_PID", False ) );
+    same = pid && pid == get_cardinal( display, w, XInternAtom( display, "_NET_WM_PID", False ) );
+    if (!same && XGetTransientForHint( display, w, &owner )) same = owner == child;
+    if (!same)
+    {
+        Atom leader_atom = XInternAtom( display, "WM_CLIENT_LEADER", False );
+        Window leader = get_window_prop( display, w, leader_atom );
+        same = leader && (leader == child || leader == get_window_prop( display, child, leader_atom ));
+    }
+    if (sync_check_error( display )) return FOCUS_ELSEWHERE;
+    if (!same || !(attr.override_redirect || is_popup( display, w ))) return FOCUS_ELSEWHERE;
+    TRACE( "%lx: its menu %lx has the focus\n", child, w );
+    return FOCUS_OWN_MENU;
+}
