From: Stained Glass OS <dev@stained-glass.example>
Subject: win32u: a window without a title bar that asks for round corners has them

Newer Windows rounds a popup that asks for it with
DWMWA_WINDOW_CORNER_PREFERENCE (DWMWCP_ROUND, DWMWCP_ROUNDSMALL): the
shell's flyouts do (volume, network, calendar). In the Rounded style
(0483, 0492), such a top-level window is rounded too, by 8 px or 4 px; one
that does not ask keeps square corners.

Gate: test/rounded-gate.sh (a flyout over a window, the window showing
through its corners; a plain popup square).
---
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -1878,6 +1878,16 @@
 
     if (win->parent != get_desktop_window()) return 0;
     if (win->dwExStyle & WS_EX_LAYERED) return 0;
+    pref = (ULONG_PTR)NtUserGetProp( win->obj.handle, cornerW );
+    if ((win->dwStyle & WS_CAPTION) != WS_CAPTION && !(win->dwStyle & (WS_MAXIMIZE | WS_MINIMIZE)) &&
+        (pref == 3 /* DWMWCP_ROUND */ || pref == 4 /* DWMWCP_ROUNDSMALL */))
+    {
+        /* a window without a title bar that asks for round corners (a
+         * flyout) has them in the Rounded style, as on newer Windows */
+        if (!rounded_style()) return 0;
+        radius = muldiv( pref == 4 ? 4 : 8, get_dpi_for_window( win->obj.handle ), USER_DEFAULT_SCREEN_DPI );
+        goto shape;
+    }
     if ((win->dwStyle & WS_CAPTION) != WS_CAPTION || (win->dwStyle & (WS_MAXIMIZE | WS_MINIMIZE)))
     {
         /* popup menus and tooltips are rounded too, as newer Windows draws them */
@@ -1895,7 +1905,6 @@
         goto shape;
     }
     if (!rounded_style()) return 0;
-    pref = (ULONG_PTR)NtUserGetProp( win->obj.handle, cornerW );
     if (pref == 2 /* DWMWCP_DONOTROUND */) return 0;
     radius = muldiv( pref == 4 /* DWMWCP_ROUNDSMALL */ ? 4 : 8, get_dpi_for_window( win->obj.handle ), USER_DEFAULT_SCREEN_DPI );
 shape:
