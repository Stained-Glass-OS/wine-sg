From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 07:14:02 -0700
Subject: [PATCH] mscoree: StrongNameSignatureGeneration[Ex] and
 StrongNameCompareAssemblies (3317)

DECISIONS-2 NET-HOST, CORE review: security. Signing: the key pair comes from a
CryptoAPI private key blob or a key container; the signature size is one RSA block
(with no file, only that size is returned). The key must match the assembly's
public key (CORSEC_E_SIGNATURE_MISMATCH otherwise, nothing written). The CLR header
flag is set before hashing (it is part of the hash) unless SN_TEST_SIGN; the
signature is written into the image's reserved slot, or returned when the caller
passes an output pointer. Signing a signed image again reproduces the signature
Wine Mono's compiler made, bit for bit. StrongNameCompareAssemblies reports
identical, signature-only (signature, flag and checksum) or different.

diff --git a/dlls/mscoree/mscoree.spec b/dlls/mscoree/mscoree.spec
index 8d61ae0..9aba146 100644
--- a/dlls/mscoree/mscoree.spec
+++ b/dlls/mscoree/mscoree.spec
@@ -91,7 +91,7 @@
 @ stub RuntimeOpenImage
 @ stub RuntimeReleaseHandle
 @ stub SetTargetForVTableEntry
-@ stub StrongNameCompareAssemblies
+@ stdcall StrongNameCompareAssemblies(wstr wstr ptr)
 @ stdcall StrongNameErrorInfo()
 @ stdcall StrongNameFreeBuffer(ptr)
 @ stub StrongNameGetBlob
@@ -102,8 +102,8 @@
 @ stdcall StrongNameKeyGen(wstr long ptr ptr)
 @ stdcall StrongNameKeyGenEx(wstr long long ptr ptr)
 @ stdcall StrongNameKeyInstall(wstr ptr long)
-@ stub StrongNameSignatureGeneration
-@ stub StrongNameSignatureGenerationEx
+@ stdcall StrongNameSignatureGeneration(wstr wstr ptr long ptr ptr)
+@ stdcall StrongNameSignatureGenerationEx(wstr wstr ptr long ptr ptr long)
 @ stdcall StrongNameSignatureSize(ptr long ptr)
 @ stdcall StrongNameSignatureVerification(wstr long ptr)
 @ stdcall StrongNameSignatureVerificationEx(wstr long ptr)
diff --git a/dlls/mscoree/strongname.c b/dlls/mscoree/strongname.c
index 073462b..32dbb27 100644
--- a/dlls/mscoree/strongname.c
+++ b/dlls/mscoree/strongname.c
@@ -771,3 +771,208 @@ BOOLEAN WINAPI StrongNameTokenFromAssemblyEx( const WCHAR *path, BYTE **token, U
     if (!key || !key_len) return fail( E_POINTER );
     return token_from_assembly( path, token, token_len, key, key_len );
 }
+
+/* ---- signing ---- */
+
+#define SN_SIGN_ALL_FILES 0x00000001
+#define SN_TEST_SIGN      0x00000002
+
+#define SN_CMP_DIFFERENT 0
+#define SN_CMP_IDENTICAL 1
+#define SN_CMP_SIGONLY   2
+
+/* does the public part of the key pair (a PRIVATEKEYBLOB or a container's key) match the assembly's key? */
+static BOOLEAN key_matches_assembly( HCRYPTKEY key, const struct sn_assembly *as )
+{
+    const struct sn_public_key *pk = (const struct sn_public_key *)as->key;
+    BYTE *pub;
+    DWORD size = 0;
+    BOOLEAN ret = FALSE;
+
+    if (!CryptExportKey( key, 0, PUBLICKEYBLOB, 0, NULL, &size )) return fail_crypt();
+    if (!(pub = malloc( size ))) return fail( E_OUTOFMEMORY );
+    if (CryptExportKey( key, 0, PUBLICKEYBLOB, 0, pub, &size ))
+    {
+        if (size == pk->len && !memcmp( pub + 8, pk->blob + 8, size - 8 )) ret = TRUE;   /* exponent and modulus */
+        else fail( CORSEC_E_SIGNATURE_MISMATCH );
+    }
+    else fail_crypt();
+    free( pub );
+    return ret;
+}
+
+BOOLEAN WINAPI StrongNameSignatureGenerationEx( const WCHAR *path, const WCHAR *container, BYTE *blob, ULONG blob_len,
+                                                BYTE **signature, ULONG *signature_len, DWORD flags )
+{
+    struct sn_image img;
+    struct sn_assembly as;
+    HCRYPTPROV prov = 0;
+    HCRYPTHASH hash;
+    HCRYPTKEY key = 0;
+    BYTE *data = NULL, *sig = NULL;
+    DWORD size, len;
+    ALG_ID alg = CALG_SHA1;
+    BOOLEAN ret = FALSE;
+
+    TRACE( "(%s, %s, %p, %lu, %p, %p, %#lx)\n", debugstr_w(path), debugstr_w(container), blob, blob_len,
+           signature, signature_len, flags );
+
+    if (!signature_len || (!blob && !container)) return fail( E_POINTER );
+    if (flags & ~(SN_SIGN_ALL_FILES | SN_TEST_SIGN)) return fail( E_INVALIDARG );
+
+    if (blob)
+    {
+        if (!CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_AES, CRYPT_VERIFYCONTEXT )) return fail_crypt();
+        if (!CryptImportKey( prov, blob, blob_len, 0, 0, &key )) { fail_crypt(); goto done; }
+    }
+    else
+    {
+        if (!acquire_container( container, 0, &prov )) return FALSE;
+        if (!CryptGetUserKey( prov, AT_SIGNATURE, &key )) { fail_crypt(); goto done; }
+    }
+
+    /* the size of the signature: one RSA block */
+    len = sizeof(len);
+    {
+        DWORD bits = 0;
+        len = sizeof(bits);
+        if (!CryptGetKeyParam( key, KP_KEYLEN, (BYTE *)&bits, &len, 0 )) { fail_crypt(); goto done; }
+        len = bits / 8;
+    }
+    if (!path)
+    {
+        *signature_len = len;
+        ret = TRUE;
+        goto done;
+    }
+
+    if (!read_file( path, &data, &size )) goto done;
+    if (!parse_image( &img, data, size ) || !read_assembly( &img, &as )) goto done;
+    if (!as.key || !(as.flags & 1))
+    {
+        free( as.key );
+        fail( CORSEC_E_MISSING_STRONGNAME );
+        goto done;
+    }
+    if (as.key_len == sizeof(ecma_key) || as.key_len < SN_HEADER_SIZE + PUBKEY_MIN_SIZE ||
+#ifndef SG_MUTANT_SNG_NOMATCH
+        !key_matches_assembly( key, &as ))
+#else
+        FALSE)
+#endif
+    {
+        if (as.key_len == sizeof(ecma_key) || as.key_len < SN_HEADER_SIZE + PUBKEY_MIN_SIZE)
+            fail( CORSEC_E_INVALID_PUBLICKEY );
+        free( as.key );
+        goto done;
+    }
+    if (((const struct sn_public_key *)as.key)->hash_alg) alg = ((const struct sn_public_key *)as.key)->hash_alg;
+    free( as.key );
+    if (!img.sig_len || img.sig_len != len) { fail( CORSEC_E_SIGNATURE_MISMATCH ); goto done; }
+
+    /* the CLR header flag is part of what is signed, so set it before hashing */
+#ifndef SG_MUTANT_SNG_LATEFLAG
+    if (!(flags & SN_TEST_SIGN)) data[img.cor_off + 16] |= COMIMAGE_FLAGS_STRONGNAMESIGNED;
+#endif
+
+    if (!CryptCreateHash( prov, alg, 0, 0, &hash )) { fail_crypt(); goto done; }
+    if (hash_image( &img, hash ))
+    {
+        DWORD sig_len = len;
+
+        if (!(sig = malloc( sig_len ))) fail( E_OUTOFMEMORY );
+        else if (!CryptSignHashW( hash, AT_SIGNATURE, NULL, 0, sig, &sig_len )) fail_crypt();
+        else if (sig_len != len) fail( CORSEC_E_SIGNATURE_MISMATCH );
+        else ret = TRUE;
+    }
+    CryptDestroyHash( hash );
+    if (!ret) goto done;
+#ifdef SG_MUTANT_SNG_LATEFLAG
+    if (!(flags & SN_TEST_SIGN)) data[img.cor_off + 16] |= COMIMAGE_FLAGS_STRONGNAMESIGNED;
+#endif
+
+    if (signature)
+    {
+        *signature = sig;
+        *signature_len = len;
+        sig = NULL;
+    }
+    else
+    {
+        HANDLE file;
+        DWORD written;
+
+        ret = FALSE;
+        file = CreateFileW( path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+        if (file == INVALID_HANDLE_VALUE) { fail( HRESULT_FROM_WIN32( GetLastError() ) ); goto done; }
+        memcpy( data + img.sig_off, sig, len );
+        if (SetFilePointer( file, img.cor_off + 16, NULL, FILE_BEGIN ) != INVALID_SET_FILE_POINTER &&
+            WriteFile( file, data + img.cor_off + 16, 4, &written, NULL ) &&
+            SetFilePointer( file, img.sig_off, NULL, FILE_BEGIN ) != INVALID_SET_FILE_POINTER &&
+            WriteFile( file, sig, len, &written, NULL ) && written == len)
+            ret = TRUE;
+        else fail( HRESULT_FROM_WIN32( GetLastError() ) );
+        CloseHandle( file );
+        *signature_len = len;
+    }
+
+done:
+    free( sig );
+    free( data );
+    if (key) CryptDestroyKey( key );
+    if (prov) CryptReleaseContext( prov, 0 );
+    return ret;
+}
+
+BOOLEAN WINAPI StrongNameSignatureGeneration( const WCHAR *path, const WCHAR *container, BYTE *blob, ULONG blob_len,
+                                              BYTE **signature, ULONG *signature_len )
+{
+    TRACE( "(%s, %s, %p, %lu, %p, %p)\n", debugstr_w(path), debugstr_w(container), blob, blob_len, signature,
+           signature_len );
+    return StrongNameSignatureGenerationEx( path, container, blob, blob_len, signature, signature_len, 0 );
+}
+
+/* two assemblies that differ only by their strong name signature, flag and checksum */
+BOOLEAN WINAPI StrongNameCompareAssemblies( const WCHAR *path1, const WCHAR *path2, DWORD *result )
+{
+    struct sn_image img1, img2;
+    BYTE *data1 = NULL, *data2 = NULL;
+    DWORD size1, size2;
+    BOOLEAN ret = FALSE;
+
+    TRACE( "(%s, %s, %p)\n", debugstr_w(path1), debugstr_w(path2), result );
+
+    if (!path1 || !path2 || !result) return fail( E_POINTER );
+    if (!read_file( path1, &data1, &size1 ) || !read_file( path2, &data2, &size2 )) goto done;
+    if (size1 == size2 && !memcmp( data1, data2, size1 ))
+    {
+        *result = SN_CMP_IDENTICAL;
+        ret = TRUE;
+        goto done;
+    }
+    if (!parse_image( &img1, data1, size1 ) || !parse_image( &img2, data2, size2 )) goto done;
+    *result = SN_CMP_DIFFERENT;
+    if (size1 == size2)
+    {
+        BYTE *d;
+        DWORD k;
+
+        for (k = 0; k < 2; k++)
+        {
+            struct sn_image *img = k ? &img2 : &img1;
+
+            d = img->data;
+            memset( d + img->check_off, 0, 4 );
+#ifndef SG_MUTANT_SNG_CMPSIG
+            d[img->cor_off + 16] &= ~COMIMAGE_FLAGS_STRONGNAMESIGNED;
+            if (img->sig_len) memset( d + img->sig_off, 0, img->sig_len );
+#endif
+        }
+        if (!memcmp( data1, data2, size1 )) *result = SN_CMP_SIGONLY;
+    }
+    ret = TRUE;
+done:
+    free( data1 );
+    free( data2 );
+    return ret;
+}
diff --git a/include/strongname.h b/include/strongname.h
index 1ca0188..e5e19f1 100644
--- a/include/strongname.h
+++ b/include/strongname.h
@@ -38,6 +38,16 @@ BOOLEAN __stdcall StrongNameSignatureVerificationEx(const WCHAR *path, BOOLEAN f
 BOOLEAN __stdcall StrongNameTokenFromAssembly(const WCHAR *path, BYTE **token, ULONG *size);
 BOOLEAN __stdcall StrongNameTokenFromAssemblyEx(const WCHAR *path, BYTE **token, ULONG *size, BYTE **key, ULONG *key_len);
 
+#define SN_SIGN_ALL_FILES       0x00000001
+#define SN_TEST_SIGN            0x00000002
+#define SN_CMP_DIFFERENT        0
+#define SN_CMP_IDENTICAL        1
+#define SN_CMP_SIGONLY          2
+
+BOOLEAN __stdcall StrongNameSignatureGeneration(const WCHAR *path, const WCHAR *container, BYTE *blob, ULONG blob_len, BYTE **sig, ULONG *sig_len);
+BOOLEAN __stdcall StrongNameSignatureGenerationEx(const WCHAR *path, const WCHAR *container, BYTE *blob, ULONG blob_len, BYTE **sig, ULONG *sig_len, DWORD flags);
+BOOLEAN __stdcall StrongNameCompareAssemblies(const WCHAR *path1, const WCHAR *path2, DWORD *result);
+
 #define SN_LEAVE_KEY            0x00000001
 
 DWORD   __stdcall StrongNameErrorInfo(void);
