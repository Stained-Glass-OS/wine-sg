+/* Stained Glass OS: FlashWindowEx with FLASHW_TIMER / FLASHW_TIMERNOFG / a count above one flashes by
+ * itself: a system timer of the window (the rate is dwTimeout, the caret blink time when it is 0) inverts
+ * the caption (WM_NCACTIVATE) and back; a flash is the inversion and its return; the flashing ends after
+ * uCount flashes (never for FLASHW_TIMER; FLASHW_TIMERNOFG when the window gets to the front), with the
+ * caption as it was and the taskbar button told to stop (HSHELL_REDRAW). */
+struct flash_window
+{
+    struct list entry;
+    HWND        hwnd;
+    DWORD       flags;
+    UINT        remaining;
+    BOOL        inverted;
+};
+
+static struct list flash_windows = LIST_INIT( flash_windows );
+static pthread_mutex_t flash_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static BOOL flash_take( HWND hwnd, struct flash_window *copy, BOOL remove )
+{
+    struct flash_window *flash;
+    BOOL found = FALSE;
+
+    pthread_mutex_lock( &flash_lock );
+    LIST_FOR_EACH_ENTRY( flash, &flash_windows, struct flash_window, entry )
+    {
+        if (flash->hwnd != hwnd) continue;
+        if (copy) *copy = *flash;
+        if (remove) { list_remove( &flash->entry ); free( flash ); }
+        found = TRUE;
+        break;
+    }
+    pthread_mutex_unlock( &flash_lock );
+    return found;
+}
+
+static void flash_window_forget( HWND hwnd )
+{
+    flash_take( hwnd, NULL, TRUE );
+}
+
+static void flash_set_caption( HWND hwnd, BOOL inverted )
+{
+    BOOL natural = hwnd == NtUserGetForegroundWindow();
+
+    if (is_iconic( hwnd )) return;
+    send_message( hwnd, WM_NCACTIVATE, inverted ? !natural : natural, 0 );
+}
+
+static void flash_stop( HWND hwnd, BOOL restore )
+{
+    struct flash_window flash;
+
+    if (!flash_take( hwnd, &flash, TRUE )) return;
+    kill_system_timer( hwnd, SYSTEM_TIMER_FLASH_WINDOW );
+    if (!is_window( hwnd )) return;
+    if (restore && (flash.flags & FLASHW_CAPTION)) flash_set_caption( hwnd, FALSE );
+    if ((flash.flags & FLASHW_TRAY) && !(get_window_long( hwnd, GWL_STYLE ) & WS_CHILD) &&
+        !get_window_relative( hwnd, GW_OWNER ))
+    {
+        call_hooks( WH_SHELL, HSHELL_REDRAW, (WPARAM)hwnd, 0, 0 );
+        shell_hook_notify( HSHELL_REDRAW, hwnd, (LPARAM)hwnd );
+    }
+}
+
+void flash_window_timer( HWND hwnd )
+{
+    struct flash_window *flash;
+    BOOL stop = FALSE, to_front = FALSE, inverted = FALSE, caption = FALSE;
+
+    pthread_mutex_lock( &flash_lock );
+    LIST_FOR_EACH_ENTRY( flash, &flash_windows, struct flash_window, entry )
+    {
+        if (flash->hwnd != hwnd) continue;
+#ifdef SG_MUTANT_FLASH_NOSTOP
+        if (0)
+#else
+        if ((flash->flags & FLASHW_TIMERNOFG) == FLASHW_TIMERNOFG && hwnd == NtUserGetForegroundWindow())
+#endif
+        {
+            to_front = TRUE;
+            break;
+        }
+        flash->inverted = !flash->inverted;
+        inverted = flash->inverted;
+        caption = (flash->flags & FLASHW_CAPTION) != 0;
+        if (!inverted && !(flash->flags & FLASHW_TIMER) && !--flash->remaining) stop = TRUE;
+        break;
+    }
+    pthread_mutex_unlock( &flash_lock );
+
+    if (to_front) { flash_stop( hwnd, TRUE ); return; }
+    if (caption) flash_set_caption( hwnd, inverted );
+    if (stop) flash_stop( hwnd, FALSE );
+}
+
+/*******************************************************************
+ *           NtUserFlashWindowEx (win32u.@)
+ */
+BOOL WINAPI NtUserFlashWindowEx( FLASHWINFO *info )
+{
+    struct flash_window *flash;
+    BOOL ret, timed;
+    UINT rate;
+
+    TRACE( "%p\n", info );
+
+    if (!info)
+    {
+        RtlSetLastWin32Error( ERROR_NOACCESS );
+        return FALSE;
+    }
+    if (!info->hwnd || info->cbSize != sizeof(FLASHWINFO) || !is_window( info->hwnd ))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    flash_window_forget( info->hwnd );
+    kill_system_timer( info->hwnd, SYSTEM_TIMER_FLASH_WINDOW );
+    ret = flash_window_once( info );
+
+    /* a single flash is the inversion above; more of them, or no end, run on a timer */
+    timed = (info->dwFlags & (FLASHW_CAPTION | FLASHW_TRAY)) && ((info->dwFlags & FLASHW_TIMER) || info->uCount > 1);
+#ifdef SG_MUTANT_FLASH_NOTIMER
+    timed = FALSE;
+#endif
+    if (!timed || !(flash = calloc( 1, sizeof(*flash) ))) return ret;
+    flash->hwnd = info->hwnd;
+    flash->flags = info->dwFlags;
+    flash->remaining = info->uCount;
+    flash->inverted = TRUE;
+    pthread_mutex_lock( &flash_lock );
+    list_add_tail( &flash_windows, &flash->entry );
+    pthread_mutex_unlock( &flash_lock );
+    rate = info->dwTimeout ? info->dwTimeout : NtUserGetCaretBlinkTime();
+    NtUserSetSystemTimer( info->hwnd, SYSTEM_TIMER_FLASH_WINDOW, rate );
+    return ret;
+}
+
