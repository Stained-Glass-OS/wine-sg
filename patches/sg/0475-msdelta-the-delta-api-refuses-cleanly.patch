+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "msdelta.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msdelta);
+
+static BOOL refuse( const char *what )
+{
+    FIXME( "%s: applying and reading deltas is not implemented\n", what );
+    SetLastError( ERROR_NOT_SUPPORTED );
+    return FALSE;
+}
+
+BOOL WINAPI ApplyDeltaA( DELTA_FLAG_TYPE flags, LPCSTR source, LPCSTR delta, LPCSTR target )
+{
+    TRACE( "%s %s %s\n", debugstr_a(source), debugstr_a(delta), debugstr_a(target) );
+    return refuse( "ApplyDeltaA" );
+}
+
+BOOL WINAPI ApplyDeltaW( DELTA_FLAG_TYPE flags, LPCWSTR source, LPCWSTR delta, LPCWSTR target )
+{
+    TRACE( "%s %s %s\n", debugstr_w(source), debugstr_w(delta), debugstr_w(target) );
+    return refuse( "ApplyDeltaW" );
+}
+
+BOOL WINAPI ApplyDeltaB( DELTA_FLAG_TYPE flags, DELTA_INPUT source, DELTA_INPUT delta, LPDELTA_OUTPUT target )
+{
+    if (target) { target->lpStart = NULL; target->uSize = 0; }
+    return refuse( "ApplyDeltaB" );
+}
+
+BOOL WINAPI ApplyDeltaProvidedB( DELTA_FLAG_TYPE flags, DELTA_INPUT source, DELTA_INPUT delta, void *target, SIZE_T size )
+{
+    return refuse( "ApplyDeltaProvidedB" );
+}
+
+BOOL WINAPI GetDeltaInfoA( LPCSTR delta, LPDELTA_HEADER_INFO info )
+{
+    return refuse( "GetDeltaInfoA" );
+}
+
+BOOL WINAPI GetDeltaInfoW( LPCWSTR delta, LPDELTA_HEADER_INFO info )
+{
+    return refuse( "GetDeltaInfoW" );
+}
+
+BOOL WINAPI GetDeltaInfoB( DELTA_INPUT delta, LPDELTA_HEADER_INFO info )
+{
+    return refuse( "GetDeltaInfoB" );
+}
+
+BOOL WINAPI DeltaFree( void *buffer )
+{
+    /* nothing this library returns needs freeing yet */
+    return TRUE;
+}
--- a/dlls/msdelta/msdelta.spec
+++ b/dlls/msdelta/msdelta.spec
@@ -1,15 +1,18 @@
-@ stub ApplyDeltaA
-@ stub ApplyDeltaB
-@ stub ApplyDeltaProvidedB
-@ stub ApplyDeltaW
+@ stdcall ApplyDeltaA(int64 str str str)
+@ stdcall -arch=win64 ApplyDeltaB(int64 ptr ptr ptr)
+@ stdcall -arch=win32 ApplyDeltaB(int64 long long long long long long ptr)
+@ stdcall -arch=win64 ApplyDeltaProvidedB(int64 ptr ptr ptr long)
+@ stdcall -arch=win32 ApplyDeltaProvidedB(int64 long long long long long long ptr long)
+@ stdcall ApplyDeltaW(int64 wstr wstr wstr)
 @ stub CreateDeltaA
 @ stub CreateDeltaB
 @ stub CreateDeltaW
-@ stub DeltaFree
+@ stdcall DeltaFree(ptr)
 @ stub DeltaNormalizeProvidedB
-@ stub GetDeltaInfoA
-@ stub GetDeltaInfoB
-@ stub GetDeltaInfoW
+@ stdcall GetDeltaInfoA(str ptr)
+@ stdcall -arch=win64 GetDeltaInfoB(ptr ptr)
+@ stdcall -arch=win32 GetDeltaInfoB(long long long ptr)
+@ stdcall GetDeltaInfoW(wstr ptr)
 @ stub GetDeltaSignatureA
 @ stub GetDeltaSignatureB
 @ stub GetDeltaSignatureW
