From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: Implement IComThreadingInfo::SetCurrentLogicalThreadId.

IComThreadingInfo::SetCurrentLogicalThreadId sets the GUID that
GetCurrentLogicalThreadId and CoGetCurrentLogicalThreadId report for the
calling thread, and fails with E_FAIL when the thread is in no apartment, as
documented; it returned E_NOTIMPL.

Gate: test/combase-logicalid-gate.sh.
---
 dlls/combase/combase.c | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index 20bab20..f270ebe 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -2759,9 +2759,23 @@ static HRESULT WINAPI thread_context_info_GetCurrentLogicalThreadId(IComThreadin
 
 static HRESULT WINAPI thread_context_info_SetCurrentLogicalThreadId(IComThreadingInfo *iface, REFGUID logical_thread_id)
 {
-    FIXME("%s stub\n", debugstr_guid(logical_thread_id));
+    struct tlsdata *tlsdata;
+    struct apartment *apt;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%s\n", debugstr_guid(logical_thread_id));
+
+    if (!(apt = apartment_get_current_or_mta()))
+        return E_FAIL;
+    apartment_release(apt);
+
+    if (FAILED(hr = com_get_tlsdata(&tlsdata)))
+        return hr;
+#ifndef SG_MUTANT_LOGICAL_ID_IGNORED
+    tlsdata->causality_id = *logical_thread_id;
+    tlsdata->flags |= OLETLS_UUIDINITIALIZED;
+#endif
+    return S_OK;
 }
 
 static const IComThreadingInfoVtbl thread_context_info_vtbl =
