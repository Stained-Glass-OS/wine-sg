From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: RegGetValue takes REG_SZ or REG_EXPAND_SZ without RRF_NOEXPAND (7004)

RegGetValue failed RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ without
RRF_NOEXPAND with ERROR_INVALID_PARAMETER. Only REG_EXPAND_SZ alone is
invalid that way: with REG_SZ allowed, an expandable value comes back
expanded, as REG_SZ. Python's launcher py.exe reads
PythonCore\X.Y\InstallPath so and reported "No installed Python found!"
after a normal install.
---
diff --git a/dlls/kernelbase/registry.c b/dlls/kernelbase/registry.c
index a5f6235..6c3b998 100644
--- a/dlls/kernelbase/registry.c
+++ b/dlls/kernelbase/registry.c
@@ -3059,8 +3059,15 @@ LSTATUS WINAPI RegGetValueW( HKEY hKey, LPCWSTR pszSubKey, LPCWSTR pszValue,
     if (pvData && !pcbData)
         return ERROR_INVALID_PARAMETER;
 
+    /* Stained Glass OS (wine-sg 7004): a REG_EXPAND_SZ value is returned expanded, as
+     * REG_SZ; only asking for REG_EXPAND_SZ alone without RRF_NOEXPAND is invalid.
+     * RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ is how Python's py.exe reads InstallPath. */
+#ifdef SG_MUTANT_GETVALUE_EXPAND_PAIR
     if ((dwFlags & RRF_RT_REG_EXPAND_SZ) && !(dwFlags & RRF_NOEXPAND) &&
             ((dwFlags & RRF_RT_ANY) != RRF_RT_ANY))
+#else
+    if ((dwFlags & RRF_RT_REG_EXPAND_SZ) && !(dwFlags & RRF_NOEXPAND) && !(dwFlags & RRF_RT_REG_SZ))
+#endif
         return ERROR_INVALID_PARAMETER;
 
     if ((dwFlags & RRF_WOW64_MASK) == RRF_WOW64_MASK)
@@ -3190,8 +3197,15 @@ LSTATUS WINAPI RegGetValueA( HKEY hKey, LPCSTR pszSubKey, LPCSTR pszValue,
     if (pvData && !pcbData)
         return ERROR_INVALID_PARAMETER;
 
+    /* Stained Glass OS (wine-sg 7004): a REG_EXPAND_SZ value is returned expanded, as
+     * REG_SZ; only asking for REG_EXPAND_SZ alone without RRF_NOEXPAND is invalid.
+     * RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ is how Python's py.exe reads InstallPath. */
+#ifdef SG_MUTANT_GETVALUE_EXPAND_PAIR
     if ((dwFlags & RRF_RT_REG_EXPAND_SZ) && !(dwFlags & RRF_NOEXPAND) &&
             ((dwFlags & RRF_RT_ANY) != RRF_RT_ANY))
+#else
+    if ((dwFlags & RRF_RT_REG_EXPAND_SZ) && !(dwFlags & RRF_NOEXPAND) && !(dwFlags & RRF_RT_REG_SZ))
+#endif
         return ERROR_INVALID_PARAMETER;
 
     if ((dwFlags & RRF_WOW64_MASK) == RRF_WOW64_MASK)
