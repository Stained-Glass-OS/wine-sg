From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Win+1..Win+0 press the taskbar's buttons, Win+S and Win+Q search, Win+Alt+D the calendar, Win+Home the other windows away, Win+P the Project pane

Windows' taskbar keys that did nothing (shellfix1's walk):
- Win+1 .. Win+9, Win+0: the taskbar's Nth button, pinned or running, in the
  order shown, as if clicked -- a pinned program starts, a window comes
  forward, or is minimized when it is the one in front, a group offers its
  windows;
- Win+S, Win+Q: Start, ready for typing (what is typed searches), as the
  search box's click;
- Win+Alt+D: the clock's calendar, under the main taskbar's clock;
- Win+Home: every window but the one in front minimized; pressed again with
  that window still in front, they come back;
- Win+P: the Project pane, through ms-settings-displays-topology:projection as
  Windows opens it (sg-shell's Settings registers the URI and draws the pane).

Gate: make test-taskkeys. Mutants: -DSG_MUTANT_WIN_NUMBER_NONE, -DSG_MUTANT_WIN_HOME_NONE.
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -5316,6 +5316,65 @@
     return CallWindowProcW( sg_button_proc, button, msg, wp, lp );
 }
 
+/* Stained Glass OS (wine-sg 9068): the taskbar's keys, as Windows has them.
+ * Win+1..Win+9, Win+0: the taskbar's Nth button (pinned or running, in the
+ * order shown) as if clicked -- a pinned program starts, a window comes
+ * forward (or goes, when it is in front), a group offers its windows. */
+static int sg_button_order( const void *a, const void *b )
+{
+    const HWND *x = a, *y = b;
+    RECT ra, rb;
+
+    GetWindowRect( *x, &ra );
+    GetWindowRect( *y, &rb );
+    if (sg_vertical()) return ra.top != rb.top ? (ra.top < rb.top ? -1 : 1) : 0;
+    if (ra.left != rb.left) return (ra.left < rb.left) == !(GetWindowLongW( tray_window, GWL_EXSTYLE ) & WS_EX_LAYOUTRTL) ? -1 : 1;
+    return 0;
+}
+
+void taskbar_press_nth( int n )
+{
+    HWND list[128], child;
+    WCHAR cls[16];
+    int count = 0;
+
+    if (!tray_window) return;
+    for (child = GetWindow( tray_window, GW_CHILD ); child && count < ARRAY_SIZE(list); child = GetWindow( child, GW_HWNDNEXT ))
+    {
+        LONG_PTR id = GetWindowLongPtrW( child, GWLP_ID );
+
+        if (!IsWindowVisible( child ) || !GetClassNameW( child, cls, ARRAY_SIZE(cls) ) || wcsicmp( cls, L"Button" )) continue;
+        if (id >= SG_PIN_FIRST && id < SG_PIN_FIRST + SG_PIN_MAX) list[count++] = child;
+        /* (the Start button's entry is the one with no window) */
+        else if (id && id != SG_SEARCH_ID && id != SG_TASKVIEW_ID && find_taskbar_button( (HWND)id )) list[count++] = child;
+    }
+    qsort( list, count, sizeof(list[0]), sg_button_order );
+#ifdef SG_MUTANT_WIN_NUMBER_NONE
+    count = 0;
+#endif
+    if (n < 0 || n >= count) return;
+    AllowSetForegroundWindow( ASFW_ANY );
+    SendMessageW( tray_window, WM_COMMAND, MAKEWPARAM( GetWindowLongPtrW( list[n], GWLP_ID ), BN_CLICKED ),
+                  (LPARAM)list[n] );
+}
+
+/* Win+S, Win+Q: Start, ready for typing (what is typed searches), as the
+ * search box's click */
+void taskbar_search(void)
+{
+    HWND sg = FindWindowW( L"SgStartPanel", NULL );
+
+    sg_pass_foreground( sg );
+    if (sg) PostMessageW( sg, WM_USER + 10, 1, 0 );
+    else do_startmenu( tray_window );
+}
+
+/* Win+Alt+D: the clock's calendar, under the main taskbar's clock */
+void taskbar_calendar(void)
+{
+    if (tray_window) sg_toggle_calendar( tray_window );
+}
+
 static void sg_button_middle_click( HWND button )
 {
     WNDPROC old;
