+++ b/programs/explorer/shellkeys.c
@@ -55,7 +55,8 @@
 enum { SK_DESKTOP = 0x5700, SK_MINIMIZE_ALL, SK_RESTORE_ALL, SK_EXPLORER, SK_RUN, SK_SETTINGS, SK_SYSTEM,
        SK_QUICKLINK, SK_NOTIFY, SK_SNAP_LEFT, SK_SNAP_RIGHT, SK_MAXIMIZE, SK_DOWN, SK_DICTATE, SK_SNIP, SK_SNIP_PRTSC, SK_TASKMGR,
        SK_MAG_IN, SK_MAG_IN_PAD, SK_MAG_OUT, SK_MAG_OUT_PAD, SK_MAG_CLOSE, SK_OSK, SK_EMOJI, SK_EMOJI_SEMI,
-       SK_MOVE_LEFT, SK_MOVE_RIGHT, SK_LAST };
+       SK_MOVE_LEFT, SK_MOVE_RIGHT, SK_SEARCH, SK_SEARCH_Q, SK_CALENDAR, SK_TASK1, SK_TASK10 = SK_TASK1 + 9,
+       SK_OTHERS, SK_PROJECT, SK_LAST };
 
 static HWND sk_tray;
 static HHOOK sk_hook;
@@ -138,6 +139,40 @@
     else minimize_all( TRUE );
 }
 
+/* Stained Glass OS (9068): Win+Home minimizes every window but the one in
+ * front; the second press, with that window still in front, puts them back,
+ * as Windows' keyboard "shake" */
+static HWND others[64];
+static int nothers;
+static HWND others_keep;
+
+static BOOL CALLBACK collect_others( HWND hwnd, LPARAM keep )
+{
+    if (nothers < ARRAY_SIZE(others) && hwnd != (HWND)keep && is_app( hwnd ) && !IsIconic( hwnd ))
+        others[nothers++] = hwnd;
+    return TRUE;
+}
+
+static void minimize_others(void)
+{
+    HWND fg = active_app();
+    int i;
+
+    if (nothers && fg && fg == others_keep)
+    {
+        for (i = nothers - 1; i >= 0; i--)
+            if (IsWindow( others[i] ) && IsIconic( others[i] )) ShowWindowAsync( others[i], SW_SHOWNOACTIVATE );
+        nothers = 0;
+        return;
+    }
+    nothers = 0;
+    if (!(others_keep = fg)) return;
+#ifndef SG_MUTANT_WIN_HOME_NONE
+    EnumWindows( collect_others, (LPARAM)fg );
+    for (i = 0; i < nothers; i++) ShowWindowAsync( others[i], SW_SHOWMINNOACTIVE );
+#endif
+}
+
 /* ---- snapping ---------------------------------------------------------- */
 
 struct snap { HWND hwnd; RECT restore; int side; };   /* side: -1 left, 1 right; quarters, see SNAP_TL */
@@ -719,6 +754,24 @@
     case SK_MAG_OUT_PAD: magnifier( MAGNIFIER_ZOOM_OUT ); return TRUE;
     case SK_MAG_CLOSE: magnifier( WM_CLOSE ); return TRUE;
     case SK_OSK: on_screen_keyboard(); return TRUE;
+    /* Stained Glass OS (9068): Win+S / Win+Q search from Start, Win+Alt+D the
+     * clock's calendar, Win+Home the other windows away, Win+1..9 and Win+0 the
+     * taskbar's buttons, as Windows */
+    case SK_SEARCH:
+    case SK_SEARCH_Q: taskbar_search(); return TRUE;
+    case SK_CALENDAR: taskbar_calendar(); return TRUE;
+    case SK_OTHERS: minimize_others(); return TRUE;
+    case SK_PROJECT:
+        /* the Project pane (PC screen only, Duplicate, Extend, Second screen only): Windows opens
+         * it for this URI (sg-shell's Settings registers it) */
+        AllowSetForegroundWindow( ASFW_ANY );
+        ShellExecuteW( NULL, NULL, L"ms-settings-displays-topology:projection", NULL, NULL, SW_SHOWNORMAL );
+        return TRUE;
+    }
+    if (id >= SK_TASK1 && id <= SK_TASK10)
+    {
+        taskbar_press_nth( id - SK_TASK1 );
+        return TRUE;
     }
     return FALSE;
 }
@@ -814,6 +867,16 @@
     RegisterHotKey( tray, SK_MAG_OUT_PAD, MOD_WIN, VK_SUBTRACT );
     RegisterHotKey( tray, SK_MAG_CLOSE, MOD_WIN | MOD_NOREPEAT, VK_ESCAPE );
     RegisterHotKey( tray, SK_OSK, MOD_WIN | MOD_CONTROL | MOD_NOREPEAT, 'O' );
+    RegisterHotKey( tray, SK_SEARCH, MOD_WIN | MOD_NOREPEAT, 'S' );
+    RegisterHotKey( tray, SK_SEARCH_Q, MOD_WIN | MOD_NOREPEAT, 'Q' );
+    RegisterHotKey( tray, SK_CALENDAR, MOD_WIN | MOD_ALT | MOD_NOREPEAT, 'D' );
+    RegisterHotKey( tray, SK_OTHERS, MOD_WIN | MOD_NOREPEAT, VK_HOME );
+    RegisterHotKey( tray, SK_PROJECT, MOD_WIN | MOD_NOREPEAT, 'P' );
+    {
+        int i;
+        for (i = 0; i < 10; i++)   /* Win+1 .. Win+9, then Win+0 the tenth */
+            RegisterHotKey( tray, SK_TASK1 + i, MOD_WIN | MOD_NOREPEAT, i < 9 ? '1' + i : '0' );
+    }
     /* Print Screen opens screen snipping, as Windows 11 does, unless "Use the
      * Print screen key to open screen snipping" is turned off -- through the
      * keyboard hook, while no program holds the key (win_key_proc) */
