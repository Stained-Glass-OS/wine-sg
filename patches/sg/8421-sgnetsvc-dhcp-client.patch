From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sgnetsvc, wine.inf: the DHCP Client service

OpenVPN's Interactive Service names the DHCP Client service (Dhcp) as its
dependency; there was none, so the service manager refused to start it
(ERROR_SERVICE_DEPENDENCY_DELETED, 1075) and OpenVPN's MSI failed at
StartServices (i1014). Windows always has it running. As DNS Client and the
other network services of 6266: DHCP Client, automatic start, a shared-process
service of svchost (LocalServiceNetworkRestricted) in sgnetsvc.dll that runs
and stops when asked; the host's network manager leases the addresses.

Gate test/netsvcs-gate.sh (Dhcp added).
---
--- a/dlls/sgnetsvc/main.c
+++ b/dlls/sgnetsvc/main.c
@@ -1,6 +1,6 @@
 /*
  * Network services Windows has running (DNS Client, IP Helper, Network List Service,
- * WinHTTP Web Proxy Auto-Discovery), hosted by svchost (wine-sg 6266)
+ * WinHTTP Web Proxy Auto-Discovery, DHCP Client), hosted by svchost (wine-sg 6266, 8421)
  *
  * Copyright 2026 Stained Glass OS
  *
@@ -48,6 +48,8 @@
     { L"iphlpsvc", SERVICE_ACCEPT_STOP | SERVICE_ACCEPT_SHUTDOWN },
     { L"netprofm", SERVICE_ACCEPT_STOP | SERVICE_ACCEPT_SHUTDOWN },
     { L"WinHttpAutoProxySvc", SERVICE_ACCEPT_STOP | SERVICE_ACCEPT_SHUTDOWN },
+    /* (vpn2, i1014) DHCP Client: the host's network manager leases the addresses */
+    { L"Dhcp", SERVICE_ACCEPT_STOP | SERVICE_ACCEPT_SHUTDOWN },
 };
 
 static void report( struct netsvc *svc, DWORD state )
@@ -102,3 +104,4 @@
 void WINAPI IphlpsvcServiceMain( DWORD argc, WCHAR **argv ) { run( &services[1] ); }
 void WINAPI NetprofmServiceMain( DWORD argc, WCHAR **argv ) { run( &services[2] ); }
 void WINAPI WinHttpAutoProxyServiceMain( DWORD argc, WCHAR **argv ) { run( &services[3] ); }
+void WINAPI DhcpServiceMain( DWORD argc, WCHAR **argv ) { run( &services[4] ); }
--- a/dlls/sgnetsvc/sgnetsvc.spec
+++ b/dlls/sgnetsvc/sgnetsvc.spec
@@ -2,3 +2,4 @@
 @ stdcall IphlpsvcServiceMain(long ptr)
 @ stdcall NetprofmServiceMain(long ptr)
 @ stdcall WinHttpAutoProxyServiceMain(long ptr)
+@ stdcall DhcpServiceMain(long ptr)
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -271,6 +271,7 @@
 AddService=LanmanServer,0,LanmanServerService
 AddService=FontCache,0,FontCacheService
 AddService=Dnscache,0,DnscacheService
+AddService=Dhcp,0,DhcpService
 AddService=iphlpsvc,0,IphlpsvcService
 AddService=netprofm,0,NetprofmService
 AddService=WinHttpAutoProxySvc,0,WinHttpAutoProxySvcService
@@ -295,6 +296,7 @@
 AddService=LanmanServer,0,LanmanServerService
 AddService=FontCache,0,FontCacheService
 AddService=Dnscache,0,DnscacheService
+AddService=Dhcp,0,DhcpService
 AddService=iphlpsvc,0,IphlpsvcService
 AddService=netprofm,0,NetprofmService
 AddService=WinHttpAutoProxySvc,0,WinHttpAutoProxySvcService
@@ -319,6 +321,7 @@
 AddService=LanmanServer,0,LanmanServerService
 AddService=FontCache,0,FontCacheService
 AddService=Dnscache,0,DnscacheService
+AddService=Dhcp,0,DhcpService
 AddService=iphlpsvc,0,IphlpsvcService
 AddService=netprofm,0,NetprofmService
 AddService=WinHttpAutoProxySvc,0,WinHttpAutoProxySvcService
@@ -343,6 +346,7 @@
 AddService=LanmanServer,0,LanmanServerService
 AddService=FontCache,0,FontCacheService
 AddService=Dnscache,0,DnscacheService
+AddService=Dhcp,0,DhcpService
 AddService=iphlpsvc,0,IphlpsvcService
 AddService=netprofm,0,NetprofmService
 AddService=WinHttpAutoProxySvc,0,WinHttpAutoProxySvcService
@@ -2838,6 +2842,21 @@
 HKR,Parameters,"ServiceMain",,"DnscacheServiceMain"
 HKLM,%CurrentVersionNT%\SvcHost,"NetworkService",0x00010008,"Dnscache"
 
+[DhcpService]
+AddReg=DhcpServiceKeys
+Description="Registers and updates IP addresses and DNS records for this computer."
+DisplayName="DHCP Client"
+ServiceBinary="%11%\svchost.exe -k LocalServiceNetworkRestricted"
+ServiceType=32
+StartType=2
+ErrorControl=1
+
+; (vpn2, i1014) OpenVPN's Interactive Service names it as its dependency (1075 without it)
+[DhcpServiceKeys]
+HKR,Parameters,"ServiceDll",,"%11%\sgnetsvc.dll"
+HKR,Parameters,"ServiceMain",,"DhcpServiceMain"
+HKLM,%CurrentVersionNT%\SvcHost,"LocalServiceNetworkRestricted",0x00010008,"Dhcp"
+
 [IphlpsvcService]
 AddReg=IphlpsvcServiceKeys
 Description="Provides tunnel connectivity using IPv6 transition technologies and IP-HTTPS."
