-#include "ddk/wdm.h"
+#include "ddk/ntddk.h"
 
 #include "wine/list.h"
 
@@ -131,6 +131,59 @@
 static DEVICE_OBJECT *power_complete_device;
 static void *power_complete_context;
 
+/* IoRegisterPlugPlayNotification */
+static const GUID notify_class = {0xdeadbeef, 0x29ef, 0x4538, {0xa5, 0xfd, 0xb6, 0x95, 0x73, 0xa3, 0x62, 0xc4}};
+static const GUID arrival_event = {0xcb3a4004, 0x46f0, 0x11d0, {0xb0, 0x8f, 0x00, 0x60, 0x97, 0x13, 0x05, 0x3f}};
+static const GUID removal_event = {0xcb3a4005, 0x46f0, 0x11d0, {0xb0, 0x8f, 0x00, 0x60, 0x97, 0x13, 0x05, 0x3f}};
+static const GUID target_removed_event = {0xcb3a4008, 0x46f0, 0x11d0, {0xb0, 0x8f, 0x00, 0x60, 0x97, 0x13, 0x05, 0x3f}};
+
+struct notify_log
+{
+    unsigned int count;
+    unsigned int arrivals, removals;
+    void *context;
+    USHORT version, size;
+    GUID class_guid;
+    WCHAR name[128];
+};
+static struct notify_log notify_log, notify_log2;
+
+static void WINAPI interface_notify(void *data, void *context)
+{
+    DEVICE_INTERFACE_CHANGE_NOTIFICATION *n = data;
+    struct notify_log *log = context;
+
+    log->count++;
+    if (IsEqualGUID(&n->Event, &arrival_event)) log->arrivals++;
+    else if (IsEqualGUID(&n->Event, &removal_event)) log->removals++;
+    log->context = context;
+    log->version = n->Version;
+    log->size = n->Size;
+    log->class_guid = n->InterfaceClassGuid;
+    lstrcpynW(log->name, n->SymbolicLinkName->Buffer, ARRAY_SIZE(log->name));
+}
+
+typedef struct
+{
+    USHORT Version;
+    USHORT Size;
+    GUID Event;
+    PFILE_OBJECT FileObject;
+} TARGET_REMOVAL;
+
+static unsigned int target_removed_count;
+static FILE_OBJECT *target_removed_file;
+static FILE_OBJECT *target_file;
+static void *target_entry;
+
+static void WINAPI target_notify(void *data, void *context)
+{
+    TARGET_REMOVAL *n = data;
+
+    if (IsEqualGUID(&n->Event, &target_removed_event)) target_removed_count++;
+    target_removed_file = n->FileObject;
+}
+
 static void WINAPI power_complete(DEVICE_OBJECT *device, UCHAR minor, POWER_STATE state, void *context, IO_STATUS_BLOCK *io)
 {
     power_complete_device = device;
@@ -760,6 +813,50 @@
     return;
 }
 
+static void test_interface_notifications(DEVICE_OBJECT *device_obj)
+{
+    UNICODE_STRING sym2;
+    void *entry, *entry2;
+    NTSTATUS status;
+
+    /* notifications for the interfaces of a class */
+    status = IoRegisterDeviceInterface(device_obj, &notify_class, NULL, &sym2);
+    ok(!status, "Failed to register interface, status %#lx.\n", status);
+    memset(&notify_log, 0, sizeof(notify_log));
+    memset(&notify_log2, 0, sizeof(notify_log2));
+    status = IoRegisterPlugPlayNotification(EventCategoryDeviceInterfaceChange, 0, (void *)&notify_class,
+            device_obj->DriverObject, interface_notify, &notify_log, &entry);
+    ok(!status, "Failed to register notification, status %#lx.\n", status);
+    ok(!notify_log.count, "got %u early notifications\n", notify_log.count);
+    IoSetDeviceInterfaceState(&sym2, TRUE);
+    ok(notify_log.count == 1 && notify_log.arrivals == 1, "got %u notifications, %u arrivals\n", notify_log.count, notify_log.arrivals);
+    ok(notify_log.context == &notify_log, "got context %p\n", notify_log.context);
+    ok(notify_log.version == 1 && notify_log.size == sizeof(DEVICE_INTERFACE_CHANGE_NOTIFICATION),
+            "got version %u size %u\n", notify_log.version, notify_log.size);
+    ok(IsEqualGUID(&notify_log.class_guid, &notify_class), "wrong class\n");
+    ok(!_wcsicmp(notify_log.name, sym2.Buffer), "got name \"%ls\"\n", notify_log.name);
+    IoSetDeviceInterfaceState(&sym2, FALSE);
+    ok(notify_log.count == 2 && notify_log.removals == 1, "got %u notifications, %u removals\n", notify_log.count, notify_log.removals);
+    IoSetDeviceInterfaceState(&sym2, TRUE);
+    ok(notify_log.count == 3, "got %u notifications\n", notify_log.count);
+    /* the existing interfaces are reported when asked for */
+    status = IoRegisterPlugPlayNotification(EventCategoryDeviceInterfaceChange,
+            PNPNOTIFY_DEVICE_INTERFACE_INCLUDE_EXISTING_INTERFACES, (void *)&notify_class,
+            device_obj->DriverObject, interface_notify, &notify_log2, &entry2);
+    ok(!status, "Failed to register notification, status %#lx.\n", status);
+    ok(notify_log2.count == 1 && notify_log2.arrivals == 1, "got %u notifications, %u arrivals\n", notify_log2.count, notify_log2.arrivals);
+    ok(!_wcsicmp(notify_log2.name, sym2.Buffer), "got name \"%ls\"\n", notify_log2.name);
+    status = IoUnregisterPlugPlayNotification(entry);
+    ok(!status, "Failed to unregister, status %#lx.\n", status);
+    status = IoUnregisterPlugPlayNotification(entry2);
+    ok(!status, "Failed to unregister, status %#lx.\n", status);
+    IoSetDeviceInterfaceState(&sym2, FALSE);
+    ok(notify_log.count == 3 && notify_log2.count == 1, "got %u and %u notifications after unregistering\n",
+            notify_log.count, notify_log2.count);
+    RtlFreeUnicodeString(&sym2);
+
+}
+
 static NTSTATUS fdo_ioctl(IRP *irp, IO_STACK_LOCATION *stack, ULONG code)
 {
     switch (code)
@@ -769,6 +866,16 @@
             test_device_properties( bus_pdo );
             return STATUS_SUCCESS;
 
+        case IOCTL_WINETEST_BUS_NOTIFY:
