+
+        case IOCTL_WINETEST_BUS_TARGET_REMOVED:
+            ok(stack->Parameters.DeviceIoControl.OutputBufferLength >= sizeof(ULONG), "short output buffer\n");
+            *(ULONG *)irp->AssociatedIrp.SystemBuffer = target_removed_count;
+            irp->IoStatus.Information = sizeof(ULONG);
+            return STATUS_SUCCESS;
+
         case IOCTL_WINETEST_BUS_REGISTER_IFACE:
             return IoRegisterDeviceInterface(bus_pdo, &bus_class, NULL, &bus_symlink);
 
@@ -962,6 +1069,16 @@
 
 static NTSTATUS WINAPI driver_create(DEVICE_OBJECT *device, IRP *irp)
 {
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+
+    /* the first child opened without synchronous I/O is the one the test removes */
+    if (device != bus_fdo && !target_entry && !(stack->Parameters.Create.Options & FILE_SYNCHRONOUS_IO_NONALERT))
+    {
+        NTSTATUS status = IoRegisterPlugPlayNotification(EventCategoryTargetDeviceChange, 0, stack->FileObject,
+                device->DriverObject, target_notify, NULL, &target_entry);
+        ok(!status, "Failed to register target notification, status %#lx.\n", status);
+        target_file = stack->FileObject;
+    }
     irp->IoStatus.Status = STATUS_SUCCESS;
     IoCompleteRequest(irp, IO_NO_INCREMENT);
     return STATUS_SUCCESS;
@@ -969,6 +1086,14 @@
 
 static NTSTATUS WINAPI driver_close(DEVICE_OBJECT *device, IRP *irp)
 {
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+
+    if (target_entry && stack->FileObject == target_file)
+    {
+        NTSTATUS status = IoUnregisterPlugPlayNotification(target_entry);
+        ok(!status, "Failed to unregister target notification, status %#lx.\n", status);
+        target_entry = NULL;
+    }
     irp->IoStatus.Status = STATUS_SUCCESS;
     IoCompleteRequest(irp, IO_NO_INCREMENT);
     return STATUS_SUCCESS;
