From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: IoRegisterPlugPlayNotification and IoUnregisterPlugPlayNotification.

Both were stubs that did nothing. A registration for
EventCategoryDeviceInterfaceChange now calls the callback with a
DEVICE_INTERFACE_CHANGE_NOTIFICATION (arrival / removal event, class,
symbolic link) whenever an interface of the class is enabled or disabled
with IoSetDeviceInterfaceState, and with
PNPNOTIFY_DEVICE_INTERFACE_INCLUDE_EXISTING_INTERFACES first for each
interface that is enabled now. A registration for
EventCategoryTargetDeviceChange gets the remove-complete notification of the
device a file object was opened on when the PnP manager removes it.
IoUnregisterPlugPlayNotification ends a registration (STATUS_INVALID_PARAMETER
for an unknown one); hardware profile registrations are accepted and never
called.

Test: the PnP test driver registers for an interface class and for the removal of
a child's file; gate test/ntoskrnl-pnptest-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/pnp.c b/dlls/ntoskrnl.exe/pnp.c
--- a/dlls/ntoskrnl.exe/pnp.c
+++ b/dlls/ntoskrnl.exe/pnp.c
@@ -405,15 +405,214 @@
     start_device( device, set, &sp_device );
 }
 
+/* IoRegisterPlugPlayNotification: registrations for the interfaces of a class and for the removal
+ * of a target device (FILE_OBJECT) */
+NTSTATUS WINAPI IoGetDeviceInterfaces( const GUID *class_guid, DEVICE_OBJECT *pdo, ULONG flags, WCHAR **list );
+
+struct plugplay_registration
+{
+    struct list entry;
+    IO_NOTIFICATION_EVENT_CATEGORY category;
+    GUID interface_class;
+    FILE_OBJECT *target;
+    DEVICE_OBJECT *target_device;  /* the device the file was opened on, compared and never dereferenced later */
+    DRIVER_OBJECT *driver;
+    PDRIVER_NOTIFICATION_CALLBACK_ROUTINE callback;
+    void *context;
+};
+
+typedef struct
+{
+    USHORT Version;
+    USHORT Size;
+    GUID Event;
+    FILE_OBJECT *FileObject;
+} SG_TARGET_DEVICE_REMOVAL_NOTIFICATION;
+
+static const GUID sg_device_interface_arrival = {0xcb3a4004, 0x46f0, 0x11d0, {0xb0, 0x8f, 0x00, 0x60, 0x97, 0x13, 0x05, 0x3f}};
+static const GUID sg_device_interface_removal = {0xcb3a4005, 0x46f0, 0x11d0, {0xb0, 0x8f, 0x00, 0x60, 0x97, 0x13, 0x05, 0x3f}};
+static const GUID sg_target_device_remove_complete = {0xcb3a4008, 0x46f0, 0x11d0, {0xb0, 0x8f, 0x00, 0x60, 0x97, 0x13, 0x05, 0x3f}};
+
+static struct list plugplay_registrations = LIST_INIT( plugplay_registrations );
+static CRITICAL_SECTION plugplay_cs;
+static CRITICAL_SECTION_DEBUG plugplay_cs_debug =
+{
+    0, 0, &plugplay_cs,
+    { &plugplay_cs_debug.ProcessLocksList, &plugplay_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": plugplay_cs") }
+};
+static CRITICAL_SECTION plugplay_cs = { &plugplay_cs_debug, -1, 0, 0, 0, 0 };
+
+static void notify_interface( const GUID *class_guid, UNICODE_STRING *name, BOOL arrival )
+{
+    struct plugplay_registration *reg;
+    DEVICE_INTERFACE_CHANGE_NOTIFICATION notification;
+
+#ifdef SG_MUTANT_NOTIFY_NONE
+    return;
+#endif
+    notification.Version = 1;
+    notification.Size = sizeof(notification);
+    notification.Event = arrival ? sg_device_interface_arrival : sg_device_interface_removal;
+    notification.InterfaceClassGuid = *class_guid;
+    notification.SymbolicLinkName = name;
+
+    EnterCriticalSection( &plugplay_cs );
+    LIST_FOR_EACH_ENTRY( reg, &plugplay_registrations, struct plugplay_registration, entry )
+    {
+        if (reg->category != EventCategoryDeviceInterfaceChange || !IsEqualGUID( &reg->interface_class, class_guid )) continue;
+        reg->callback( &notification, reg->context );
+    }
+    LeaveCriticalSection( &plugplay_cs );
+}
+
+/* the registrations for a target whose device stack is the one of the PDO that is going away */
+static void notify_target_removal( DEVICE_OBJECT *pdo, struct plugplay_registration **list, unsigned int *count )
+{
+    struct plugplay_registration *reg;
+    DEVICE_OBJECT *device;
+
+#ifdef SG_MUTANT_NOTIFY_TARGET_NONE
+    return;
+#endif
+    EnterCriticalSection( &plugplay_cs );
+    LIST_FOR_EACH_ENTRY( reg, &plugplay_registrations, struct plugplay_registration, entry )
+    {
+        if (reg->category != EventCategoryTargetDeviceChange || !reg->target_device) continue;
+        for (device = pdo; device; device = device->AttachedDevice)
+            if (device == reg->target_device) break;
+        if (device && *count < 16) list[(*count)++] = reg;
+    }
+    LeaveCriticalSection( &plugplay_cs );
+}
+
+static void call_target_removal( struct plugplay_registration **list, unsigned int count )
+{
+    SG_TARGET_DEVICE_REMOVAL_NOTIFICATION notification;
+    struct plugplay_registration *reg;
+    unsigned int i;
+
+    for (i = 0; i < count; i++)
+    {
+        notification.Version = 1;
+        notification.Size = sizeof(notification);
+        notification.Event = sg_target_device_remove_complete;
+        notification.FileObject = list[i]->target;
+        EnterCriticalSection( &plugplay_cs );
+        /* the registration may have been removed meanwhile */
+        LIST_FOR_EACH_ENTRY( reg, &plugplay_registrations, struct plugplay_registration, entry )
+            if (reg == list[i]) { reg->callback( &notification, reg->context ); break; }
+        LeaveCriticalSection( &plugplay_cs );
+    }
+}
+
+/***********************************************************************
+ *           IoRegisterPlugPlayNotification    (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI IoRegisterPlugPlayNotification( IO_NOTIFICATION_EVENT_CATEGORY category, ULONG flags, void *data,
+        DRIVER_OBJECT *driver, PDRIVER_NOTIFICATION_CALLBACK_ROUTINE callback, void *context, void **notification )
+{
+    struct plugplay_registration *reg;
+    NTSTATUS status;
+
+    TRACE( "category %u, flags %#lx, data %p, driver %p, callback %p, context %p, notification %p.\n",
+           category, flags, data, driver, callback, context, notification );
+
+    if (!callback || !notification) return STATUS_INVALID_PARAMETER;
+    switch (category)
+    {
+    case EventCategoryDeviceInterfaceChange:
+    case EventCategoryTargetDeviceChange:
+        if (!data) return STATUS_INVALID_PARAMETER;
+        break;
+    case EventCategoryHardwareProfileChange:
+        break;
+    default:
+        return STATUS_INVALID_PARAMETER;
+    }
+    if (!(reg = calloc( 1, sizeof(*reg) ))) return STATUS_INSUFFICIENT_RESOURCES;
+    reg->category = category;
+    reg->driver = driver;
+    reg->callback = callback;
+    reg->context = context;
+    if (category == EventCategoryDeviceInterfaceChange) reg->interface_class = *(const GUID *)data;
+    if (category == EventCategoryTargetDeviceChange)
+    {
+        reg->target = data;
+        reg->target_device = reg->target->DeviceObject;
+    }
+    if (driver) ObReferenceObject( driver );
+
+    EnterCriticalSection( &plugplay_cs );
+    list_add_tail( &plugplay_registrations, &reg->entry );
+    LeaveCriticalSection( &plugplay_cs );
+    *notification = reg;
+
+    /* PNPNOTIFY_DEVICE_INTERFACE_INCLUDE_EXISTING_INTERFACES: the enabled interfaces now */
+#ifndef SG_MUTANT_NOTIFY_NO_EXISTING
+    if (category == EventCategoryDeviceInterfaceChange && (flags & 1))
+    {
+        WCHAR *links, *p;
+
+        if (!(status = IoGetDeviceInterfaces( data, NULL, 0, &links )))
+        {
+            for (p = links; *p; p += wcslen( p ) + 1)
+            {
+                DEVICE_INTERFACE_CHANGE_NOTIFICATION notification_data;
+                UNICODE_STRING name;
+
+                RtlInitUnicodeString( &name, p );
+                notification_data.Version = 1;
+                notification_data.Size = sizeof(notification_data);
+                notification_data.Event = sg_device_interface_arrival;
+                notification_data.InterfaceClassGuid = reg->interface_class;
+                notification_data.SymbolicLinkName = &name;
+                callback( &notification_data, context );
+            }
+            ExFreePool( links );
+        }
+    }
+#endif
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           IoUnregisterPlugPlayNotification    (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI IoUnregisterPlugPlayNotification( void *notification )
+{
+    struct plugplay_registration *reg;
+
+    TRACE( "%p\n", notification );
+
+    /* returns once no callback of the registration is running any more */
+    EnterCriticalSection( &plugplay_cs );
+    LIST_FOR_EACH_ENTRY( reg, &plugplay_registrations, struct plugplay_registration, entry )
+    {
+        if (reg != notification) continue;
+        list_remove( &reg->entry );
+        LeaveCriticalSection( &plugplay_cs );
+        if (reg->driver) ObDereferenceObject( reg->driver );
+        free( reg );
+        return STATUS_SUCCESS;
+    }
+    LeaveCriticalSection( &plugplay_cs );
+    return STATUS_INVALID_PARAMETER;
+}
+
 static void send_remove_device_irp( DEVICE_OBJECT *device, UCHAR code )
 {
     struct wine_device *wine_device = CONTAINING_RECORD(device, struct wine_device, device_obj);
+    struct plugplay_registration *targets[16];
+    unsigned int target_count = 0;
     WCHAR id[MAX_DEVICE_ID_LEN];
 
     if (code == IRP_MN_REMOVE_DEVICE && !get_device_instance_id( device, id )) set_device_present( id, FALSE );
 
     TRACE( "Removing device %p, code %x.\n", device, code );
 
+    if (code == IRP_MN_REMOVE_DEVICE) notify_target_removal( device, targets, &target_count );
+
     if (wine_device->children)
     {
         ULONG i;
@@ -422,6 +621,8 @@
     }
 
     send_pnp_irp( device, code );
+
+    if (target_count) call_target_removal( targets, target_count );
 }
 
 static void remove_device( DEVICE_OBJECT *device )
@@ -890,6 +1091,7 @@
     }
 
     iface->enabled = enable;
+    notify_interface( &iface->interface_class, &iface->symbolic_link, enable );
 
     len = offsetof(DEV_BROADCAST_DEVICEINTERFACE_W, dbcc_name[namelen + 1]);
 
