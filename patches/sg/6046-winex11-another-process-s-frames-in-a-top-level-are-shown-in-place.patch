From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: Another process's frames in a top-level are shown in place (6046)

Chromium's GPU process renders into the browser's top-level (0586). As
that window has children, its frames were rendered offscreen and copied
into the browser's X window -- and the browser's own repaint (an
expose, a focus change, sg-deskcomp starting, a lock) put its window
surface over them. The GPU process keeps the last frame and shows it
again only after its own window's repaint (1523), which never happens
for another process's window: Opera and Dropbox went white, frames
included, until they presented again, and a still page never does. Such
a swap chain's client window is now shown in place inside the
browser's X window, where X keeps the browser's painting out of it, as
Windows' compositor keeps a swap chain over GDI. A DPI scale still
needs the copy.
---
diff --git a/dlls/winex11.drv/vulkan.c b/dlls/winex11.drv/vulkan.c
index b48c857..49e5ec6 100644
--- a/dlls/winex11.drv/vulkan.c
+++ b/dlls/winex11.drv/vulkan.c
@@ -496,12 +496,35 @@ static void vulkan_surface_update_size( HWND hwnd, struct x11drv_vulkan_surface
     surface->rect = rect;
 }
 
+/* Stained Glass OS: another process's top-level (Chromium's GPU process renders into the browser's
+ * window, 0586). Its frames copied into that window offscreen were wiped by the browser's own window
+ * surface each time it was flushed (an expose, a repaint, a compositor starting, a lock), and only that
+ * process -- not this one, which keeps the frame -- learns of it: Opera, Dropbox and Edge turned white,
+ * frames included, until they presented again, which a still page never does. The client window
+ * inside the browser's X window is shown as it is instead: X keeps the browser's painting out of it, as
+ * Windows' compositor keeps a swap chain over GDI. Only a DPI scale still needs the offscreen copy. */
+static BOOL foreign_toplevel( HWND hwnd )
+{
+    DWORD pid = 0;
+
+    if (NtUserGetAncestor( hwnd, GA_PARENT ) != NtUserGetDesktopWindow()) return FALSE;
+    NtUserGetWindowThread( hwnd, &pid );
+    return pid && pid != GetCurrentProcessId();
+}
+
 static void vulkan_surface_update_offscreen( HWND hwnd, struct x11drv_vulkan_surface *surface )
 {
     BOOL offscreen = surface->blend || needs_offscreen_rendering( hwnd, FALSE );
     struct x11drv_win_data *data;
 
+#ifndef SG_MUTANT_VK_FOREIGN_OFFSCREEN
+    if (offscreen && !surface->blend && foreign_toplevel( hwnd ) &&
+        NtUserGetDpiForWindow( hwnd ) == NtUserGetWinMonitorDpi( hwnd, MDT_RAW_DPI ))
+        offscreen = FALSE;
+#endif
+
     if (offscreen == surface->offscreen) return;
+    TRACE( "%p: offscreen %d\n", hwnd, offscreen );
     surface->offscreen = offscreen;
 
     if (!surface->offscreen)
