From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: CON opens with TRUNCATE_EXISTING and read access; a cancelled CopyFileEx deletes its destination (3613)

kernelbase: CON opens with TRUNCATE_EXISTING and read access; a cancelled CopyFileEx deletes its destination

CORE: integrator must review.
2230 made TRUNCATE_EXISTING without GENERIC_WRITE ERROR_INVALID_PARAMETER before the console
device names are looked at; Windows 7+ opens CON that way (console.c:1453), so the check is
skipped for CON, CONIN$ and CONOUT$.
0112 made CopyFileEx honour PROGRESS_CANCEL but opened the destination without DELETE
access, so the disposition that removes the partial copy always failed (file.c:1234).
The destination is now opened with DELETE first and without it when the open is a
sharing violation (a holder without FILE_SHARE_DELETE keeps the file, as the test shows
for Windows). The todo_wine 2230 removed stays removed and one more is dropped: it passes.
---
diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 0e6aa52..c4b473b 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -1218,7 +1218,6 @@ static void test_CopyFileEx(void)
     retok = CopyFileExA(source, dest, copy_progress_cb, hfile, NULL, 0);
     ok(!retok, "CopyFileExA unexpectedly succeeded\n");
     ok(GetLastError() == ERROR_REQUEST_ABORTED, "expected ERROR_REQUEST_ABORTED, got %ld\n", GetLastError());
-    todo_wine
     ok(GetFileAttributesA(dest) == INVALID_FILE_ATTRIBUTES, "file was not deleted\n");
 
     retok = CopyFileExA(source, NULL, copy_progress_cb, hfile, NULL, 0);
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index 49c7185..16d0fb7 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -626,7 +626,7 @@ static BOOL copy_file( const WCHAR *source, const WCHAR *dest, COPYFILE2_EXTENDE
     FILE_BASIC_INFORMATION info;
     IO_STATUS_BLOCK io;
     DWORD count;
-    BOOL ret = FALSE;
+    BOOL ret = FALSE, can_delete = FALSE;
     char *buffer;
     LARGE_INTEGER total;
     LONGLONG done_bytes = 0, chunk = 0;
@@ -686,9 +686,20 @@ static BOOL copy_file( const WCHAR *source, const WCHAR *dest, COPYFILE2_EXTENDE
         }
     }
 
-    if ((h2 = CreateFileW( dest, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
-                           (flags & COPY_FILE_FAIL_IF_EXISTS) ? CREATE_NEW : CREATE_ALWAYS,
-                           info.FileAttributes, h1 )) == INVALID_HANDLE_VALUE)
+    /* DELETE access lets a cancelled copy remove the partial destination; a file somebody else holds
+     * without FILE_SHARE_DELETE is opened without it (and then stays, as on Windows) */
+    h2 = INVALID_HANDLE_VALUE;
+#ifndef SG_MUTANT_COPY_CANCEL_KEEPS
+    h2 = CreateFileW( dest, GENERIC_WRITE | DELETE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                      (flags & COPY_FILE_FAIL_IF_EXISTS) ? CREATE_NEW : CREATE_ALWAYS, info.FileAttributes, h1 );
+    can_delete = (h2 != INVALID_HANDLE_VALUE);
+    if (!can_delete && GetLastError() != ERROR_SHARING_VIOLATION) goto open_failed;
+#endif
+    if (h2 == INVALID_HANDLE_VALUE)
+        h2 = CreateFileW( dest, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                          (flags & COPY_FILE_FAIL_IF_EXISTS) ? CREATE_NEW : CREATE_ALWAYS, info.FileAttributes, h1 );
+open_failed:
+    if (h2 == INVALID_HANDLE_VALUE)
     {
         WARN("Unable to open dest %s\n", debugstr_w(dest));
         HeapFree( GetProcessHeap(), 0, buffer );
@@ -715,8 +726,11 @@ static BOOL copy_file( const WCHAR *source, const WCHAR *dest, COPYFILE2_EXTENDE
     if (stop)
     {
         /* cancelled: the partial copy goes (STOP would let it be restarted; we cannot) */
-        FILE_DISPOSITION_INFORMATION disp = { TRUE };
-        NtSetInformationFile( h2, &io, &disp, sizeof(disp), FileDispositionInformation );
+        if (can_delete)
+        {
+            FILE_DISPOSITION_INFORMATION disp = { TRUE };
+            NtSetInformationFile( h2, &io, &disp, sizeof(disp), FileDispositionInformation );
+        }
         HeapFree( GetProcessHeap(), 0, buffer );
         CloseHandle( h1 );
         CloseHandle( h2 );
@@ -920,6 +934,17 @@ static UINT get_nt_file_options( DWORD attributes )
     return options;
 }
 
+/* CON, CONIN$ and CONOUT$, with or without the \\.\ prefix */
+static BOOL is_console_device_name( const WCHAR *filename )
+{
+#ifdef SG_MUTANT_TRUNCATE_CON
+    return FALSE;
+#else
+    const WCHAR *dev = wcsncmp( filename, L"\\\\.\\", 4 ) ? filename : filename + 4;
+    return !wcsicmp( dev, L"CONIN$" ) || !wcsicmp( dev, L"CONOUT$" ) || !wcsicmp( dev, L"CON" );
+#endif
+}
+
 /*************************************************************************
  *	CreateFileW   (kernelbase.@)
  */
@@ -980,7 +1005,9 @@ HANDLE WINAPI DECLSPEC_HOTPATCH CreateFileW( LPCWSTR filename, DWORD access, DWO
 
     /* truncating needs GENERIC_WRITE itself, not just the right to write data */
 #ifndef SG_MUTANT_TRUNCATE_NO_WRITE
-    if (creation == TRUNCATE_EXISTING && !(access & (GENERIC_WRITE | GENERIC_ALL)))
+    /* but the console devices are opened first (CON with read access and TRUNCATE_EXISTING works) */
+    if (creation == TRUNCATE_EXISTING && !(access & (GENERIC_WRITE | GENERIC_ALL)) &&
+        !is_console_device_name( filename ))
     {
         SetLastError( ERROR_INVALID_PARAMETER );
         return INVALID_HANDLE_VALUE;
