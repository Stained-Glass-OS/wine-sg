From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: kernelbase is loaded before kernel32

Firefox's launcher process hooks NtMapViewOfSection in its suspended browser process; the hook finds kernel32 in the PEB's module list and calls its GetModuleHandleW. Wine mapped kernel32 first and then its dependency kernelbase, so the hook ran while kernel32 was in the list with its imports not yet bound, and kernel32's GetModuleHandleW (a stub that jumps through its import table to kernelbase) jumped to an RVA. Every Firefox start in launcher mode crashed; Firefox then turned its launcher off, so only the first start after an install or update showed it. kernelbase is now loaded before kernel32, so kernel32 is bound once it can be seen, and the module lists keep kernel32 before kernelbase as on Windows.
---
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -4713,11 +4713,37 @@
         update_load_config( wm->ldr.DllBase );
 #endif
 
+#ifndef SG_MUTANT_KERNEL32_FIRST
+        /* (wine-sg 8291) kernelbase first: kernel32's exports are stubs that jump through its import table
+         * to kernelbase, and a hook on the mapping of kernel32's dependencies that finds kernel32 in the
+         * module list calls them (Firefox's launcher hooks NtMapViewOfSection in its suspended browser
+         * process and calls kernel32's GetModuleHandleW; it crashed on the unbound import).  Once kernel32 is
+         * in the module list its imports are bound.  The lists keep the order Windows has: kernel32 before
+         * kernelbase. */
+        {
+            WINE_MODREF *kernelbase = NULL;
+
+            load_dll( NULL, L"kernelbase.dll", 0, &kernelbase, FALSE );
+            if ((status = load_dll( NULL, L"kernel32.dll", 0, &kernel32, FALSE )) != STATUS_SUCCESS)
+            {
+                MESSAGE( "wine: could not load kernel32.dll, status %lx\n", status );
+                NtTerminateProcess( GetCurrentProcess(), status );
+            }
+            if (kernelbase && kernelbase != kernel32)
+            {
+                RemoveEntryList( &kernel32->ldr.InLoadOrderLinks );
+                InsertTailList( &kernelbase->ldr.InLoadOrderLinks, &kernel32->ldr.InLoadOrderLinks );
+                RemoveEntryList( &kernel32->ldr.InMemoryOrderLinks );
+                InsertTailList( &kernelbase->ldr.InMemoryOrderLinks, &kernel32->ldr.InMemoryOrderLinks );
+            }
+        }
+#else
         if ((status = load_dll( NULL, L"kernel32.dll", 0, &kernel32, FALSE )) != STATUS_SUCCESS)
         {
             MESSAGE( "wine: could not load kernel32.dll, status %lx\n", status );
             NtTerminateProcess( GetCurrentProcess(), status );
         }
+#endif
         node_kernel32 = kernel32->ldr.DdagNode;
         pBaseThreadInitThunk = RtlFindExportedRoutineByName( kernel32->ldr.DllBase, "BaseThreadInitThunk" );
         LdrGetProcedureAddress( kernel32->ldr.DllBase, &ctrl_routine, 0, (void **)&pCtrlRoutine );
