 HRESULT CALLBACK IViewObject_GetAdvise_Proxy(
@@ -2250,8 +2344,24 @@ HRESULT CALLBACK IViewObject_GetAdvise_Proxy(
     DWORD *pAdvf,
     IAdviseSink **ppAdvSink)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    DWORD aspects, advf;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p, %p.\n", This, pAspects, pAdvf, ppAdvSink);
+
+    /* the remote form wants all three; the local one takes NULL for the
+     * first two */
+#ifndef SG_MUTANT_CALLAS_VIEW
+    hr = IViewObject_RemoteGetAdvise_Proxy(This, &aspects, &advf, ppAdvSink);
+#else
+    hr = E_NOTIMPL;
+#endif
+    if (SUCCEEDED(hr))
+    {
+        if (pAspects) *pAspects = aspects;
+        if (pAdvf) *pAdvf = advf;
+    }
+    return hr;
 }
 
 HRESULT __RPC_STUB IViewObject_GetAdvise_Stub(
@@ -2260,6 +2370,6 @@ HRESULT __RPC_STUB IViewObject_GetAdvise_Stub(
     DWORD *pAdvf,
     IAdviseSink **ppAdvSink)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("%p, %p, %p, %p.\n", This, pAspects, pAdvf, ppAdvSink);
+    return IViewObject_GetAdvise(This, pAspects, pAdvf, ppAdvSink);
 }
