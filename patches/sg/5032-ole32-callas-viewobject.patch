From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ole32: Implement call_as wrappers for IViewObject and ResizeBorder.

The call_as proxy and stub wrappers of IViewObject::Draw (the continue
callback travels as an IContinue the stub turns back into a callback),
GetColorSet, Freeze and GetAdvise (whose local form allows NULL for the
aspects and flags), and of IOleInPlaceActiveObject::ResizeBorder forward to
the remote methods; they returned E_NOTIMPL.

Gate: test/ole32-viewcallas-gate.sh (64/32).
---
 dlls/ole32/usrmarshal.c | 144 ++++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 127 insertions(+), 17 deletions(-)

diff --git a/dlls/ole32/usrmarshal.c b/dlls/ole32/usrmarshal.c
index bdd06cd..8f5a8a5 100644
--- a/dlls/ole32/usrmarshal.c
+++ b/dlls/ole32/usrmarshal.c
@@ -2102,8 +2102,13 @@ HRESULT CALLBACK IOleInPlaceActiveObject_ResizeBorder_Proxy(
     IOleInPlaceUIWindow *pUIWindow,
     BOOL fFrameWindow)
 {
-    FIXME(":stub\n");
+    TRACE("%p, %s, %p, %d.\n", This, wine_dbgstr_rect(prcBorder), pUIWindow, fFrameWindow);
+#ifndef SG_MUTANT_CALLAS_VIEW
+    return IOleInPlaceActiveObject_RemoteResizeBorder_Proxy(This, prcBorder, &IID_IOleInPlaceUIWindow,
+            pUIWindow, fFrameWindow);
+#else
     return E_NOTIMPL;
+#endif
 }
 
 HRESULT __RPC_STUB IOleInPlaceActiveObject_ResizeBorder_Stub(
@@ -2113,8 +2118,8 @@ HRESULT __RPC_STUB IOleInPlaceActiveObject_ResizeBorder_Stub(
     IOleInPlaceUIWindow *pUIWindow,
     BOOL fFrameWindow)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("%p, %s, %s, %p, %d.\n", This, wine_dbgstr_rect(prcBorder), debugstr_guid(riid), pUIWindow, fFrameWindow);
+    return IOleInPlaceActiveObject_ResizeBorder(This, prcBorder, pUIWindow, fFrameWindow);
 }
 
 HRESULT CALLBACK IOleCache2_UpdateCache_Proxy(
@@ -2163,6 +2168,64 @@ HRESULT __RPC_STUB IEnumOLEVERB_Next_Stub(
     return hr;
 }
 
+/* IViewObject::Draw's continue callback crosses as an IContinue */
+struct draw_continue
+{
+    IContinue IContinue_iface;
+    LONG refcount;
+    BOOL (STDMETHODCALLTYPE *callback)(ULONG_PTR);
+    ULONG_PTR param;
+};
+
+static inline struct draw_continue *impl_from_IContinue(IContinue *iface)
+{
+    return CONTAINING_RECORD(iface, struct draw_continue, IContinue_iface);
+}
+
+static HRESULT WINAPI draw_continue_QueryInterface(IContinue *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IContinue))
+    {
+        *obj = iface;
+        IContinue_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI draw_continue_AddRef(IContinue *iface)
+{
+    return InterlockedIncrement(&impl_from_IContinue(iface)->refcount);
+}
+
+static ULONG WINAPI draw_continue_Release(IContinue *iface)
+{
+    struct draw_continue *impl = impl_from_IContinue(iface);
+    ULONG ref = InterlockedDecrement(&impl->refcount);
+    if (!ref) free(impl);
+    return ref;
+}
+
+static HRESULT WINAPI draw_continue_FContinue(IContinue *iface)
+{
+    struct draw_continue *impl = impl_from_IContinue(iface);
+    return impl->callback(impl->param) ? S_OK : S_FALSE;
+}
+
+static const IContinueVtbl draw_continue_vtbl =
+{
+    draw_continue_QueryInterface,
+    draw_continue_AddRef,
+    draw_continue_Release,
+    draw_continue_FContinue,
+};
+
+static BOOL STDMETHODCALLTYPE draw_continue_callback(ULONG_PTR param)
+{
+    return IContinue_FContinue((IContinue *)param) == S_OK;
+}
+
 HRESULT CALLBACK IViewObject_Draw_Proxy(
     IViewObject* This,
     DWORD dwDrawAspect,
@@ -2176,8 +2239,28 @@ HRESULT CALLBACK IViewObject_Draw_Proxy(
     BOOL (STDMETHODCALLTYPE *pfnContinue)(ULONG_PTR dwContinue),
     ULONG_PTR dwContinue)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    struct draw_continue *cont = NULL;
+    HRESULT hr;
+
+    TRACE("%p, %#lx, %ld, %p, %p, %p, %p, %p, %p, %p, %#Ix.\n", This, dwDrawAspect, lindex, pvAspect, ptd,
+          hdcTargetDev, hdcDraw, lprcBounds, lprcWBounds, pfnContinue, dwContinue);
+
+    if (pfnContinue)
+    {
+        if (!(cont = malloc(sizeof(*cont)))) return E_OUTOFMEMORY;
+        cont->IContinue_iface.lpVtbl = &draw_continue_vtbl;
+        cont->refcount = 1;
+        cont->callback = pfnContinue;
+        cont->param = dwContinue;
+    }
+#ifndef SG_MUTANT_CALLAS_VIEW
+    hr = IViewObject_RemoteDraw_Proxy(This, dwDrawAspect, lindex, (ULONG_PTR)pvAspect, ptd, (ULONG_PTR)hdcTargetDev,
+            (ULONG_PTR)hdcDraw, lprcBounds, lprcWBounds, cont ? &cont->IContinue_iface : NULL);
+#else
+    hr = E_NOTIMPL;
+#endif
+    if (cont) IContinue_Release(&cont->IContinue_iface);
+    return hr;
 }
 
 HRESULT __RPC_STUB IViewObject_Draw_Stub(
@@ -2192,8 +2275,10 @@ HRESULT __RPC_STUB IViewObject_Draw_Stub(
     LPCRECTL lprcWBounds,
     IContinue *pContinue)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("%p, %#lx, %ld, %#Ix, %p, %#Ix, %#Ix, %p, %p, %p.\n", This, dwDrawAspect, lindex, pvAspect, ptd,
+          hdcTargetDev, hdcDraw, lprcBounds, lprcWBounds, pContinue);
+    return IViewObject_Draw(This, dwDrawAspect, lindex, (void *)pvAspect, ptd, (HDC)hdcTargetDev, (HDC)hdcDraw,
+            lprcBounds, lprcWBounds, pContinue ? draw_continue_callback : NULL, (ULONG_PTR)pContinue);
 }
 
