+
+static BOOL CALLBACK enum_lines_w_cb(PSRCCODEINFO sci, PVOID ctx)
+{
+    struct enum_lines_w *el = ctx;
+    SRCCODEINFOW sciw;
+
+    sciw.SizeOfStruct = sizeof(sciw);
+    sciw.Key = sci->Key;
+    sciw.ModBase = sci->ModBase;
+    MultiByteToWideChar(CP_ACP, 0, sci->Obj, -1, sciw.Obj, ARRAY_SIZE(sciw.Obj));
+    MultiByteToWideChar(CP_ACP, 0, sci->FileName, -1, sciw.FileName, ARRAY_SIZE(sciw.FileName));
+    sciw.LineNumber = sci->LineNumber;
+    sciw.Address = sci->Address;
+    return el->cb(&sciw, el->user);
+}
