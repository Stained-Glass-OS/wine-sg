+BOOL WINAPI SymEnumLinesW(HANDLE hProcess, ULONG64 base, PCWSTR compiland, PCWSTR srcfile,
+                          PSYM_ENUMLINES_CALLBACKW cb, PVOID user)
+{
+    struct enum_lines_w el;
+    char compilandA[MAX_PATH], srcfileA[MAX_PATH];
+
+    TRACE("(%p %I64x %s %s %p %p)\n", hProcess, base, debugstr_w(compiland), debugstr_w(srcfile), cb, user);
+
+    if (!cb) return FALSE;
+    el.cb = cb;
+    el.user = user;
+    if (compiland) WideCharToMultiByte(CP_ACP, 0, compiland, -1, compilandA, sizeof(compilandA), NULL, NULL);
+    if (srcfile) WideCharToMultiByte(CP_ACP, 0, srcfile, -1, srcfileA, sizeof(srcfileA), NULL, NULL);
+    return SymEnumLines(hProcess, base, compiland ? compilandA : NULL, srcfile ? srcfileA : NULL, enum_lines_w_cb, &el);
 }
 
