+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    siw = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*siw) + MAX_SYM_NAME * sizeof(WCHAR));
+    si = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*si) + MAX_SYM_NAME);
+    if (siw && si)
+    {
+        si->SizeOfStruct = sizeof(*si);
+        si->MaxNameLen = MAX_SYM_NAME;
+        siw->SizeOfStruct = sizeof(*siw);
+        siw->MaxNameLen = MAX_SYM_NAME;
+        if (SymFromAddr(hProcess, Address, &displacement, si))
+        {
+            copy_symbolW(siw, si);
+            EnumSymbolsCallback(siw, siw->Size, UserContext);
+            ret = TRUE;
+        }
+    }
+    HeapFree(GetProcessHeap(), 0, si);
+    HeapFree(GetProcessHeap(), 0, siw);
+    return ret;
+}
