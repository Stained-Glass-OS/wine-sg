+/******************************************************************
+ *		SymEnumProcesses (DBGHELP.@)
+ *
+ */
+BOOL WINAPI SymEnumProcesses(PSYM_ENUMPROCESSES_CALLBACK cb, PVOID user)
+{
+    struct process *pcs, *next;
+
+    TRACE("(%p %p)\n", cb, user);
+
+    if (!cb)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    for (pcs = process_first; pcs; pcs = next)
+    {
+        next = pcs->next;
+        if (!cb(pcs->handle, user)) break;
+    }
     return TRUE;
 }
 
