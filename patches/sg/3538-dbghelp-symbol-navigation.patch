+struct sym_neighbour
+{
+    DWORD64         address;
+    BOOL            next;       /* TRUE: the nearest symbol above, FALSE: the nearest below */
+    BOOL            found;
+    DWORD64         best_address;
+    ULONG           best_size;
+    char            name[MAX_SYM_NAME + 1];
+    DWORD64         mod_base;
+};
+
+static BOOL CALLBACK sym_neighbour_cb(PSYMBOL_INFO si, ULONG size, void *ctx)
+{
+    struct sym_neighbour *sn = ctx;
+
+    if (sn->next ? (si->Address <= sn->address) : (si->Address >= sn->address)) return TRUE;
+    if (sn->found && (sn->next ? (si->Address >= sn->best_address) : (si->Address <= sn->best_address)))
+        return TRUE;
+    sn->found = TRUE;
+    sn->best_address = si->Address;
+    sn->best_size = si->Size;
+    sn->mod_base = si->ModBase;
+    lstrcpynA(sn->name, si->Name, sizeof(sn->name));
+    return TRUE;
+}
+
+/* the symbol after (or before) an address in the module that holds it, by address */
+static BOOL sym_find_neighbour(HANDLE hProcess, DWORD64 address, BOOL next, struct sym_neighbour *sn)
+{
+    DWORD64 base = SymGetModuleBase64(hProcess, address);
+
+    memset(sn, 0, sizeof(*sn));
+    sn->address = address;
+    sn->next = next;
+    if (!base) return FALSE;
+    if (!SymEnumSymbols(hProcess, base, NULL, sym_neighbour_cb, sn)) return FALSE;
+    if (!sn->found)
+    {
+        SetLastError(ERROR_NO_MORE_ITEMS);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL sym_neighbour_to_image_symbol64(HANDLE hProcess, PIMAGEHLP_SYMBOL64 symbol, BOOL next)
+{
+    struct sym_neighbour sn;
+
+    if (!symbol || symbol->SizeOfStruct < sizeof(*symbol))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!sym_find_neighbour(hProcess, symbol->Address, next, &sn)) return FALSE;
+    symbol->Address = sn.best_address;
+    symbol->Size = sn.best_size;
+    symbol->Flags = 0;
+    if (symbol->MaxNameLength)
+        lstrcpynA(symbol->Name, sn.name, symbol->MaxNameLength);
+    return TRUE;
+}
+
+static BOOL sym_neighbour_to_image_symbol(HANDLE hProcess, PIMAGEHLP_SYMBOL symbol, BOOL next)
+{
+    IMAGEHLP_SYMBOL64 *sym64;
+    BOOL ret;
+
+    if (!symbol || symbol->SizeOfStruct < sizeof(*symbol))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(sym64 = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*sym64) + symbol->MaxNameLength)))
+        return FALSE;
+    sym64->SizeOfStruct = sizeof(*sym64);
+    sym64->Address = symbol->Address;
+    sym64->MaxNameLength = symbol->MaxNameLength;
+    if ((ret = sym_neighbour_to_image_symbol64(hProcess, sym64, next)))
+    {
+        symbol->Address = (DWORD)sym64->Address;
+        symbol->Size = sym64->Size;
+        symbol->Flags = sym64->Flags;
+        if (symbol->MaxNameLength) lstrcpynA(symbol->Name, sym64->Name, symbol->MaxNameLength);
+    }
+    HeapFree(GetProcessHeap(), 0, sym64);
+    return ret;
+}
