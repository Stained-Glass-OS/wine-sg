+/******************************************************************
+ *		FindDebugInfoFileExW (DBGHELP.@)
+ *
+ */
+HANDLE WINAPI FindDebugInfoFileExW(PCWSTR FileName, PCWSTR SymbolPath, PWSTR DebugFilePath,
+                                   PFIND_DEBUG_FILE_CALLBACKW Callback, PVOID CallerData)
+{
+    HANDLE h;
+
+    TRACE("(%s %s %p %p %p)\n", debugstr_w(FileName), debugstr_w(SymbolPath), DebugFilePath, Callback, CallerData);
+
+    h = CreateFileW(FileName, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h != INVALID_HANDLE_VALUE)
+        lstrcpynW(DebugFilePath, FileName, MAX_PATH);
+    else
+    {
+        if (!SearchPathW(SymbolPath, file_name(FileName), NULL, MAX_PATH, DebugFilePath, NULL))
+            return NULL;
+        h = CreateFileW(DebugFilePath, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (h == INVALID_HANDLE_VALUE) return NULL;
+    }
+    if (Callback && !Callback(h, DebugFilePath, CallerData))
+    {
+        CloseHandle(h);
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return NULL;
+    }
+    return h;
+}
