+BOOL WINAPI SymGetTypeFromNameW(HANDLE hProcess, ULONG64 BaseOfDll, PCWSTR Name, PSYMBOL_INFOW Symbol)
+{
+    SYMBOL_INFO *si;
+    char nameA[MAX_SYM_NAME];
+    BOOL ret;
+
+    TRACE("(%p %I64x %s %p)\n", hProcess, BaseOfDll, debugstr_w(Name), Symbol);
+
+    if (!Name || !Symbol)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    WideCharToMultiByte(CP_ACP, 0, Name, -1, nameA, sizeof(nameA), NULL, NULL);
+    if (!(si = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*si) + MAX_SYM_NAME))) return FALSE;
+    si->SizeOfStruct = sizeof(*si);
+    si->MaxNameLen = MAX_SYM_NAME;
+    if ((ret = SymGetTypeFromName(hProcess, BaseOfDll, nameA, si)))
+        copy_symbolW(Symbol, si);
+    HeapFree(GetProcessHeap(), 0, si);
+    return ret;
+}
