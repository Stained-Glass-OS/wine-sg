+/***********************************************************************
+ *		SymEnumSymbolsForAddr (DBGHELP.@)
+ *
+ * The symbols found at an address: here the one that holds it.
+ */
+BOOL WINAPI SymEnumSymbolsForAddr(HANDLE hProcess, DWORD64 Address, PSYM_ENUMERATESYMBOLS_CALLBACK EnumSymbolsCallback,
+                                  PVOID UserContext)
+{
+    SYMBOL_INFO *si;
+    DWORD64 displacement;
+    BOOL ret = FALSE;
+
+    TRACE("(%p %I64x %p %p)\n", hProcess, Address, EnumSymbolsCallback, UserContext);
+
+    if (!EnumSymbolsCallback)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(si = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*si) + MAX_SYM_NAME)))
+        return FALSE;
+    si->SizeOfStruct = sizeof(*si);
+    si->MaxNameLen = MAX_SYM_NAME;
+    if (SymFromAddr(hProcess, Address, &displacement, si))
+    {
+        EnumSymbolsCallback(si, si->Size, UserContext);
+        ret = TRUE;
+    }
+    HeapFree(GetProcessHeap(), 0, si);
+    return ret;
+}
+
+/***********************************************************************
+ *		SymEnumSymbolsForAddrW (DBGHELP.@)
