From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winspool: a CUPS printer's status is its queue's

GetPrinter's status of a printer CUPS keeps was the registry's, always
"ready": a printer paused, offline, out of paper or jammed looked ready to
every Windows program, and to Settings' and Devices and Printers' lists.
Levels 2 and 6 (and EnumPrinters, Win32_Printer) now add the queue's
state: printer-state (printing; stopped is paused) and printer-state-
reasons, which CUPS's backends set from what the printer says (offline,
media-empty, media-jam, door-open, toner-low, marker-supply-empty, output-
area-full, any other "-error"). cupsd is asked at most every two seconds,
for all queues at once, as programs poll the status.

Test: test/ptcaps-gate.sh (paused with cupsdisable, ready with
cupsenable; mutant SG_MUTANT_PRNSTATUS).
---
--- a/dlls/winspool.drv/cups.c
+++ b/dlls/winspool.drv/cups.c
@@ -35,6 +35,8 @@
 #include <signal.h>
 #include <sys/wait.h>
 #include <sys/stat.h>
+#include <pthread.h>
+#include <time.h>
 #ifdef HAVE_CUPS_CUPS_H
 #include <cups/cups.h>
 #endif
@@ -511,6 +513,117 @@
 #endif
 }
 
+/* Stained Glass OS: a queue's state, as Windows' printer status bits:
+ * printer-state (idle, processing, stopped) and printer-state-reasons
+ * (offline-report, media-empty-error, media-jam, door-open, toner-low...),
+ * which CUPS's backends set from what the printer says. Asked of cupsd at
+ * most every two seconds for all queues (programs poll the status). */
+static DWORD status_from_cups( const char *state, const char *reasons )
+{
+    static const struct { const char *reason; DWORD status; } map[] =
+    {
+        { "offline", PRINTER_STATUS_OFFLINE },
+        { "shutdown", PRINTER_STATUS_OFFLINE },
+        { "paused", PRINTER_STATUS_PAUSED },
+        { "media-empty", PRINTER_STATUS_PAPER_OUT },
+        { "media-needed", PRINTER_STATUS_PAPER_OUT },
+        { "input-tray-missing", PRINTER_STATUS_PAPER_PROBLEM },
+        { "media-jam", PRINTER_STATUS_PAPER_JAM },
+        { "door-open", PRINTER_STATUS_DOOR_OPEN },
+        { "cover-open", PRINTER_STATUS_DOOR_OPEN },
+        { "toner-low", PRINTER_STATUS_TONER_LOW },
+        { "marker-supply-low", PRINTER_STATUS_TONER_LOW },
+        { "toner-empty", PRINTER_STATUS_NO_TONER },
+        { "marker-supply-empty", PRINTER_STATUS_NO_TONER },
+        { "output-area-full", PRINTER_STATUS_OUTPUT_BIN_FULL },
+        { "output-area-almost-full", PRINTER_STATUS_OUTPUT_BIN_FULL },
+        { "connecting-to-device", PRINTER_STATUS_WAITING },
+        { "cups-waiting-for-job-completed", PRINTER_STATUS_PROCESSING },
+    };
+    DWORD status = 0;
+    char word[128];
+    const char *p = reasons, *end;
+    size_t len, i, plen;
+
+    if (state && atoi( state ) == 5) status |= PRINTER_STATUS_PAUSED;      /* stopped */
+    else if (state && atoi( state ) == 4) status |= PRINTER_STATUS_PRINTING;
+    while (p && *p)
+    {
+        end = strchr( p, ',' );
+        len = end ? (size_t)(end - p) : strlen( p );
+        if (len < sizeof(word))
+        {
+            memcpy( word, p, len );
+            word[len] = 0;
+            for (i = 0; i < ARRAY_SIZE(map); i++)
+            {
+                plen = strlen( map[i].reason );
+                if (!strncmp( word, map[i].reason, plen ) && (!word[plen] || word[plen] == '-'))
+                {
+                    status |= map[i].status;
+                    break;
+                }
+            }
+            if (i == ARRAY_SIZE(map) && len > 6 && !strcmp( word + len - 6, "-error" ))
+                status |= PRINTER_STATUS_ERROR;
+        }
+        p = end ? end + 1 : NULL;
+    }
+    return status;
+}
+
+static NTSTATUS get_printer_status( void *args )
+{
+    const struct get_printer_status_params *params = args;
+#ifdef SONAME_LIBCUPS
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    static struct { char name[256]; DWORD status; } *cache;
+    static int cache_count;
+    static time_t cache_time;
+    char name[512];
+    NTSTATUS ret = STATUS_NOT_FOUND;
+    time_t now = time( NULL );
+    int i;
+
+    if (!pcupsGetDests) return STATUS_NOT_SUPPORTED;
+    if (ntdll_wcstoumbs( params->printer, wcslen( params->printer ) + 1, name, sizeof(name), FALSE ) <= 0)
+        return STATUS_INVALID_PARAMETER;
+
+    pthread_mutex_lock( &lock );
+    if (!cache || now - cache_time >= 2 || now < cache_time)
+    {
+        cups_dest_t *dests;
+        int num = pcupsGetDests( &dests );
+
+        free( cache );
+        cache = calloc( num ? num : 1, sizeof(*cache) );
+        cache_count = 0;
+        for (i = 0; cache && i < num; i++)
+        {
+            if (strlen( dests[i].name ) >= sizeof(cache->name)) continue;
+            strcpy( cache[cache_count].name, dests[i].name );
+            cache[cache_count].status =
+                status_from_cups( pcupsGetOption( "printer-state", dests[i].num_options, dests[i].options ),
+                                  pcupsGetOption( "printer-state-reasons", dests[i].num_options, dests[i].options ) );
+            cache_count++;
+        }
+        pcupsFreeDests( num, dests );
+        cache_time = now;
+    }
+    for (i = 0; i < cache_count; i++)
+        if (!strcmp( cache[i].name, name ))
+        {
+            *params->status = cache[i].status;
+            ret = STATUS_SUCCESS;
+            break;
+        }
+    pthread_mutex_unlock( &lock );
+    return ret;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
 const unixlib_entry_t __wine_unix_call_funcs[] =
 {
     process_attach,
@@ -519,6 +632,7 @@
     get_ppd,
     get_printers_stamp,
     get_device_uri,
+    get_printer_status,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
@@ -631,6 +745,18 @@
     return get_device_uri( &params );
 }
 
+static NTSTATUS wow64_get_printer_status( void *args )
+{
+    struct
+    {
+        PTR32 printer;
+        PTR32 status;
+    } const *params32 = args;
+    struct get_printer_status_params params = { ULongToPtr( params32->printer ), ULongToPtr( params32->status ) };
+
+    return get_printer_status( &params );
+}
+
 const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
 {
     process_attach,
@@ -639,6 +765,7 @@
     wow64_get_ppd,
     wow64_get_printers_stamp,
     wow64_get_device_uri,
+    wow64_get_printer_status,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -3885,6 +3885,29 @@
  *
  * Fills out a PRINTER_INFO_2W struct storing the strings in buf.
  */
+/* Stained Glass OS: the status of a printer CUPS keeps (port CUPS:<queue>),
+ * as its queue says now -- offline, out of paper, paused, printing -- with
+ * the status kept in the registry. Every printer was "ready" to Windows
+ * programs, whatever the printer said. */
+static DWORD printer_status( HKEY printer_key )
+{
+    DWORD status = get_dword_from_reg( printer_key, L"Status" ), live = 0;
+    struct get_printer_status_params params;
+    WCHAR port[300];
+    DWORD size = sizeof(port);
+
+#ifndef SG_MUTANT_PRNSTATUS
+    if (!RegQueryValueExW( printer_key, L"Port", NULL, NULL, (BYTE *)port, &size ) &&
+        !wcsncmp( port, L"CUPS:", 5 ) && port[5])
+    {
+        params.printer = port + 5;
+        params.status = &live;
+        if (UNIX_CALL( get_printer_status, &params )) live = 0;
+    }
+#endif
+    return status | live;
+}
+
 static BOOL WINSPOOL_GetPrinter_2(HKEY hkeyPrinter, PRINTER_INFO_2W *pi2,
 				  LPBYTE buf, DWORD cbBuf, LPDWORD pcbNeeded)
 {
@@ -4018,6 +4041,7 @@
     if (pi2)
     {
         pi2->Attributes = get_dword_from_reg( hkeyPrinter, L"Attributes" );
+        pi2->Status = printer_status( hkeyPrinter );
         pi2->Priority = get_dword_from_reg( hkeyPrinter, L"Priority" );
         pi2->DefaultPriority = get_dword_from_reg( hkeyPrinter, L"Default Priority" );
         pi2->StartTime = get_dword_from_reg( hkeyPrinter, L"StartTime" );
@@ -4286,8 +4310,7 @@
 
         size = sizeof(PRINTER_INFO_6);
         if (size <= cbBuf) {
-            /* FIXME: We do not update the status yet */
-            pi6->dwStatus = get_dword_from_reg( hkeyPrinter, L"Status" );
+            pi6->dwStatus = printer_status( hkeyPrinter );
             ret = TRUE;
         } else {
             ret = FALSE;
--- a/dlls/winspool.drv/wspool.h
+++ b/dlls/winspool.drv/wspool.h
@@ -79,6 +79,13 @@
     unsigned int size;   /* in WCHARs */
 };
 
+/* Stained Glass OS: a CUPS queue's state as PRINTER_STATUS_* bits */
+struct get_printer_status_params
+{
+    const WCHAR *printer;
+    DWORD *status;
+};
+
 #define UNIX_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
 
 enum cups_funcs
@@ -89,5 +96,6 @@
     unix_get_ppd,
     unix_get_printers_stamp,
     unix_get_device_uri,
+    unix_get_printer_status,
     unix_funcs_count,
 };
