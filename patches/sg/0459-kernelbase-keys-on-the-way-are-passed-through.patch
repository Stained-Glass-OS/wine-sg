From: Stained Glass OS contributors
Subject: kernelbase: the keys on the way to a 32-bit-view key are passed through

A 64-bit program opening HKLM\Software\X in the 32-bit view (KEY_WOW64_32KEY)
has its path walked a key at a time, and each key on the way -- HKLM itself
first -- was opened with the access wanted at the end. A standard user asking
to write a key granted to BUILTIN\Users was denied at HKLM. Windows asks
nothing of the keys on the way; they are now opened for whatever is allowed.
Steam's 64-bit client: "The Steam registry path is currently not writable".

--- a/dlls/kernelbase/registry.c
+++ b/dlls/kernelbase/registry.c
@@ -225,7 +225,13 @@
     str.Length = i * sizeof(WCHAR);
 
     if (i < len)
+    {
         options &= ~REG_OPTION_OPEN_LINK;
+        /* Stained Glass OS: a key on the way is only passed through: no access
+         * to it is asked for, as on Windows (a standard user writing a key
+         * granted to Users was denied at HKLM itself) */
+        access_64 = MAXIMUM_ALLOWED | KEY_WOW64_64KEY;
+    }
 
     status = open_key( subkey, root, &str, options, access_64, FALSE );
     if (status == STATUS_OBJECT_NAME_NOT_FOUND && root && is_wow64_key)
@@ -299,7 +305,9 @@
     /* Obtain the parent Wow6432Node if it exists */
     while (!status && name.Length)
     {
-        status = open_subkey( retkey, root, &name, options & ~REG_OPTION_OPEN_LINK, access );
+        /* Stained Glass OS: the parents are passed through, not used */
+        status = open_subkey( retkey, root, &name, options & ~REG_OPTION_OPEN_LINK,
+                              MAXIMUM_ALLOWED | (access & KEY_WOW64_RES) );
         if (root) NtClose( root );
         root = *retkey;
     }
@@ -394,7 +402,11 @@
     str.Length = i * sizeof(WCHAR);
 
     if (i < len)
+    {
         options &= ~REG_OPTION_CREATE_LINK;
+        /* Stained Glass OS: likewise a key on the way to the one created */
+        access_64 = MAXIMUM_ALLOWED;
+    }
 
     status = create_key( subkey, root, str, options, access_64, class, dispos );
     if (!status)
