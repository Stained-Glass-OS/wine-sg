From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: "runas" whose consent is not given fails with ERROR_CANCELLED

When the administrator's consent was not given -- No in the consent
prompt, or no answer before the prompt gave up after two minutes --
ShellExecuteEx "runas" still succeeded, and the process handle it gave
(rundll32 running SgElevate, waiting for the broker's client sg-elevate)
ended with 1: sg-elevate's own "declined". A caller could not tell that
from the program having run and failed with code 1; SG Store said
"msvbvm60.dll could not be put in place (code 1)" when the Visual Basic 6
runtime's consent prompt went unanswered (the regression walk, 2026-10-05).

Windows' ShellExecuteEx fails then, with ERROR_CANCELLED, and shows no
error box of its own. Now SgElevate reads the broker's answer (sg-elevate
--ready's file, 0625) and, when it is "declined", ends with
ERROR_CANCELLED instead of setting the "ready" event; ShellExecuteEx,
woken by its end, sees that code, closes the handles and fails with
ERROR_CANCELLED (hInstApp SE_ERR_ACCESSDENIED), without the error box.
The same for a program that needs an administrator by its manifest
(0259's path). A launched program that ends with 1 still reads as 1.

Test: test/elevreq-gate.sh ("consent not given": runas fails with 1223;
"a launched program that ends with 1 still gives code 1"), mutant
SG_MUTANT_CONSENT_CODE1 (WAIT code 1). SG Store's side: sg-shell
test/store-consent-check.sh.
---
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -317,7 +317,7 @@
  * SYSTEM. Only with the client installed, and never inside a program the
  * broker itself launched (SG_IN_BROKER). */
 static BOOL sg_execute_via_broker( const WCHAR *lpCmd, DWORD flags, void *env,
-                                   STARTUPINFOW *startup, PROCESS_INFORMATION *info )
+                                   STARTUPINFOW *startup, PROCESS_INFORMATION *info, BOOL *declined )
 {
     WCHAR broker[MAX_PATH + 16] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-elevate", *broker_cmd, *p;
     WCHAR rundll[MAX_PATH], ready_name[64];
@@ -325,6 +325,7 @@
     HANDLE ready;
     BOOL ret;
 
+    *declined = FALSE;
     if (GetEnvironmentVariableW( L"SG_IN_BROKER", NULL, 0 )) return FALSE;
     /* SG_ELEVATE names a stand-in broker client (an absolute Unix path), for gates */
     if (GetEnvironmentVariableW( L"SG_ELEVATE", broker + 8, MAX_PATH ) && broker[8] == '/')
@@ -371,7 +372,20 @@
     {
         /* the prompt waits two minutes for an answer; then the launch */
         HANDLE handles[2] = { ready, info->hProcess };
+        DWORD code;
         WaitForMultipleObjects( 2, handles, FALSE, 180000 );
+        /* refused: SgElevate ends with ERROR_CANCELLED straight after the
+         * answer; ShellExecuteEx fails with it, as Windows' does when the
+         * consent is not given */
+        if (WaitForSingleObject( info->hProcess, 0 ) == WAIT_OBJECT_0 &&
+            GetExitCodeProcess( info->hProcess, &code ) && code == ERROR_CANCELLED)
+        {
+            CloseHandle( info->hProcess );
+            CloseHandle( info->hThread );
+            info->hProcess = info->hThread = NULL;
+            *declined = TRUE;
+            ret = FALSE;
+        }
     }
 #endif
     if (ready) CloseHandle( ready );
@@ -423,7 +437,22 @@
     return path;
 }
 
-struct sg_ready { HANDLE event; WCHAR file[MAX_PATH]; };
+struct sg_ready { HANDLE event; WCHAR file[MAX_PATH]; volatile LONG answer; };
+
+/* the broker's answer in the file: '0' launched, '1' declined (or no
+ * answer before the prompt gave up), '2' failed; 0 while there is none */
+static char sg_ready_answer( const WCHAR *file )
+{
+    HANDLE f = CreateFileW( file, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                            NULL, OPEN_EXISTING, 0, NULL );
+    char c = 0;
+    DWORD got = 0;
+
+    if (f == INVALID_HANDLE_VALUE) return 0;
+    if (!ReadFile( f, &c, 1, &got, NULL ) || got != 1) c = 0;
+    CloseHandle( f );
+    return c;
+}
 
 /* the broker's answer arrives in the file: tell ShellExecuteEx */
 static DWORD WINAPI sg_ready_thread( void *arg )
@@ -437,6 +466,12 @@
         if (GetFileAttributesExW( r->file, GetFileExInfoStandard, &data ) && data.nFileSizeLow) break;
         Sleep( 100 );
     }
+    InterlockedExchange( &r->answer, sg_ready_answer( r->file ) );
+#ifndef SG_MUTANT_CONSENT_CODE1
+    /* declined: ShellExecuteEx waits for SgElevate to end (with
+     * ERROR_CANCELLED, below) to know it */
+    if (r->answer != '1')
+#endif
     SetEvent( r->event );
     DeleteFileW( r->file );
     return 0;
@@ -448,6 +483,7 @@
     char broker[MAX_PATH * 3] = "/usr/libexec/stained-glass/sg-elevate", **argv;
     char ready_unix[MAX_PATH * 3];
     const WCHAR *ready_path;
+    struct sg_ready *ready = NULL;
     WCHAR **args, value[MAX_PATH];
     int count = 0, i, len, n;
     WCHAR ** (WINAPI *to_argv)( const WCHAR *, int * );
@@ -472,6 +508,8 @@
             if (r && (r->event = OpenEventW( EVENT_MODIFY_STATE, FALSE, args[0] + 9 )))
             {
                 lstrcpynW( r->file, ready_path, MAX_PATH );
+                r->answer = 0;
+                ready = r;
                 CloseHandle( CreateThread( NULL, 0, sg_ready_thread, r, 0, NULL ) );
                 argv[n++] = (char *)"--ready";
                 argv[n++] = ready_unix;
@@ -496,6 +534,19 @@
     }
     TRACE( "%s --wine with %d arguments\n", debugstr_a(broker), count );
     ret = spawnvp( argv, TRUE );
+#ifndef SG_MUTANT_CONSENT_CODE1
+    /* The consent was not given (No, or no answer before the prompt gave
+     * up): sg-elevate ends with 1 then, as a program that failed with code 1
+     * does -- the store said "could not be put in place (code 1)". The
+     * broker's answer tells them apart; ShellExecuteEx reports the refusal
+     * as Windows' does (ERROR_CANCELLED). */
+    if (ready && ret == 1)
+    {
+        char answer = (char)ready->answer;
+        if (!answer) answer = sg_ready_answer( ready->file );
+        if (answer == '1') ExitProcess( ERROR_CANCELLED );
+    }
+#endif
     /* an exit status, or an NTSTATUS if sg-elevate could not be started */
     ExitProcess( ret > 255 ? 2 : ret );
 }
@@ -514,6 +565,7 @@
     WCHAR curdir[MAX_PATH];
     DWORD dwCreationFlags;
     HANDLE token = NULL;
+    BOOL declined = FALSE;
 
     TRACE("Execute %s from directory %s\n", debugstr_w(lpCmd), debugstr_w(psei->lpDirectory));
 
@@ -544,7 +596,7 @@
      * to the elevation broker, which prompts on the secure surface and starts
      * the program as the SYSTEM account (see sg_execute_via_broker). */
     if (psei->lpVerb && !wcsicmp( psei->lpVerb, L"runas" ) && !token &&
-        sg_execute_via_broker( lpCmd, dwCreationFlags, env, &startup, &info ))
+        sg_execute_via_broker( lpCmd, dwCreationFlags, env, &startup, &info, &declined ))
     {
         if (psei->fMask & SEE_MASK_NOCLOSEPROCESS) psei_out->hProcess = info.hProcess;
         else CloseHandle( info.hProcess );
@@ -553,6 +605,7 @@
         retval = 33;
         goto sg_done;
     }
+    if (declined) goto sg_declined;
 
     if (CreateProcessAsUserW(token, NULL, (LPWSTR)lpCmd, NULL, NULL, FALSE,
             dwCreationFlags, env, NULL, &startup, &info))
@@ -573,7 +626,7 @@
      * requireAdministrator; kernelbase refused with ERROR_ELEVATION_REQUIRED,
      * as Windows does): ask for consent, as Windows' ShellExecute does. */
     else if (GetLastError() == ERROR_ELEVATION_REQUIRED &&
-             sg_execute_via_broker( lpCmd, dwCreationFlags, env, &startup, &info ))
+             sg_execute_via_broker( lpCmd, dwCreationFlags, env, &startup, &info, &declined ))
     {
         if (psei->fMask & SEE_MASK_NOCLOSEPROCESS) psei_out->hProcess = info.hProcess;
         else CloseHandle( info.hProcess );
@@ -581,6 +634,14 @@
         TRACE( "elevation required: routed to the elevation broker\n" );
         retval = 33;
     }
+    else if (declined)
+    {
+sg_declined:
+        /* the consent was not given: Windows' ShellExecuteEx fails with
+         * ERROR_CANCELLED and shows no error of its own */
+        TRACE( "the administrator's consent was not given\n" );
+        retval = SE_ERR_ACCESSDENIED;
+    }
     else if ((retval = GetLastError()) >= 32)
     {
         TRACE("CreateProcess returned error %Id\n", retval);
@@ -588,6 +649,7 @@
     }
 
     CloseHandle(token);
+    if (declined) SetLastError( ERROR_CANCELLED );
 
 sg_done:
     TRACE("returning %Iu\n", retval);
@@ -1883,6 +1945,7 @@
     WCHAR msg[2048];
     int error_code=GetLastError();
 
+    if (error_code == ERROR_CANCELLED) return;   /* Stained Glass OS: the consent was refused; it said so */
     if (retval == SE_ERR_NOASSOC)
         LoadStringW(shell32_hInstance, IDS_SHLEXEC_NOASSOC, msg, ARRAY_SIZE(msg));
     else
