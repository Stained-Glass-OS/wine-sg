From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 16:35:57 -0700
Subject: [PATCH] msxml3: setAttributeNode keeps the namespace of a prefixed
 attribute

An attribute made with a prefix and a namespace (createNode with
NODE_ATTRIBUTE) was stored by its qualified name with no namespace, so
getQualifiedItem and removeQualifiedItem never found it. It is now stored by
its local name in the namespace, which the element declares when it does not
already. Needed by Windows.Data.Xml.Dom SetAttributeNS (windows.ui).

diff --git a/dlls/msxml3/element.c b/dlls/msxml3/element.c
index 5bfba10..2b06aab 100644
--- a/dlls/msxml3/element.c
+++ b/dlls/msxml3/element.c
@@ -1425,10 +1425,11 @@ static HRESULT WINAPI domelem_setAttributeNode(
     BSTR nameW, prefix;
     xmlnode *attr_node;
     xmlAttrPtr attr;
+    xmlNsPtr ns;
     VARIANT valueW;
     HRESULT hr;
 
-    FIXME("(%p)->(%p %p): semi-stub\n", This, attribute, old);
+    TRACE("(%p)->(%p %p)\n", This, attribute, old);
 
     if (!attribute) return E_INVALIDARG;
 
@@ -1462,10 +1463,35 @@ static HRESULT WINAPI domelem_setAttributeNode(
 
     TRACE("attribute: %s=%s\n", debugstr_w(nameW), debugstr_w(V_BSTR(&valueW)));
 
+    ns = NULL;
     hr = IXMLDOMAttribute_get_prefix(attribute, &prefix);
     if (hr == S_OK)
     {
-        FIXME("namespaces not supported: %s\n", debugstr_w(prefix));
+        /* a prefixed attribute is stored by its local name in the namespace
+           the prefix stands for; the element declares it when it does not yet */
+        BSTR uriW = NULL, baseW = NULL;
+
+        if (IXMLDOMAttribute_get_namespaceURI(attribute, &uriW) == S_OK && uriW &&
+            IXMLDOMAttribute_get_baseName(attribute, &baseW) == S_OK && baseW)
+        {
+            xmlChar *href = xmlchar_from_wchar(uriW), *prefixA = xmlchar_from_wchar(prefix);
+
+            if (href && prefixA)
+            {
+                ns = xmlSearchNsByHref(get_element(This)->doc, get_element(This), href);
+                if (!ns || !ns->prefix) ns = xmlNewNs(get_element(This), href, prefixA);
+            }
+            free(href);
+            free(prefixA);
+            if (ns)
+            {
+                SysFreeString(nameW);
+                nameW = baseW;
+                baseW = NULL;
+            }
+        }
+        SysFreeString(uriW);
+        SysFreeString(baseW);
         SysFreeString(prefix);
     }
 
@@ -1481,7 +1507,7 @@ static HRESULT WINAPI domelem_setAttributeNode(
         return E_OUTOFMEMORY;
     }
 
-    attr = xmlSetNsProp(get_element(This), NULL, name, value);
+    attr = xmlSetNsProp(get_element(This), ns, name, value);
     if (attr)
         attr_node->parent = (IXMLDOMNode*)iface;
 
