From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: axis values of font references, alpha blend parameters of grayscale text, faces of foreign files

Three results the Wine tests record from Windows, which were todo.

 - A reference to a font of a collection carries the axis values of the font: weight, width,
   italic and now also slant (-20 degrees for an oblique face, else 0); a reference made of
   a file carries none.
 - IDWriteGlyphRunAnalysis::GetAlphaBlendParams gives a cleartype level of 0 for text
   analysed with grayscale antialiasing (the parameters' level is used for other modes).
 - IDWriteFactory::CreateFontFace makes a face of a file whose loader was registered with
   another factory instead of failing with E_INVALIDARG; such faces are not cached by the
   factory.
 - Removed the todo_wine marks of these tests (84 axis-value checks, the cleartype level,
   the face of a foreign file).
---
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -328,8 +328,8 @@ struct dwrite_font_data
     UINT32 flags; /* enum font_flags */
     struct dwrite_font_propvec propvec;
     struct dwrite_cmap cmap;
-    /* Static axis for weight/width/italic. */
-    DWRITE_FONT_AXIS_VALUE axis[3];
+    /* Static axis for weight/width/italic/slant. */
+    DWRITE_FONT_AXIS_VALUE axis[4];
 
     DWRITE_FONT_METRICS1 metrics;
     IDWriteLocalizedStrings *info_strings[DWRITE_INFORMATIONAL_STRING_SUPPORTED_SCRIPT_LANGUAGE_TAG + 1];
@@ -422,6 +422,7 @@ struct dwrite_glyphrunanalysis
     LONG refcount;
 
     DWRITE_RENDERING_MODE1 rendering_mode;
+    DWRITE_TEXT_ANTIALIAS_MODE aa_mode;
     DWRITE_TEXTURE_TYPE texture_type; /* derived from rendering mode specified on creation */
     DWRITE_GLYPH_RUN run; /* glyphAdvances and glyphOffsets are not used */
     DWRITE_MATRIX m;
@@ -4632,6 +4633,11 @@ static HRESULT init_font_data(const struct fontface_desc *desc, DWRITE_FONT_FAMI
     data->axis[1].value = width_axis_values[props.stretch];
     data->axis[2].axisTag = DWRITE_FONT_AXIS_TAG_ITALIC;
     data->axis[2].value = data->style == DWRITE_FONT_STYLE_ITALIC ? 1.0f : 0.0f;
+    data->axis[3].axisTag = DWRITE_FONT_AXIS_TAG_SLANT;
+    data->axis[3].value = data->style == DWRITE_FONT_STYLE_OBLIQUE ? -20.0f : 0.0f;
+#ifdef SG_MUTANT_DWAXIS_THREE
+    data->axis[3].axisTag = DWRITE_FONT_AXIS_TAG_ITALIC;
+#endif
 
     *ret = data;
     return S_OK;
@@ -6779,6 +6785,11 @@ static HRESULT WINAPI glyphrunanalysis_GetAlphaBlendParams(IDWriteGlyphRunAnalys
         *gamma = IDWriteRenderingParams_GetGamma(params);
         *contrast = IDWriteRenderingParams_GetEnhancedContrast(params);
         *cleartypelevel = IDWriteRenderingParams_GetClearTypeLevel(params);
+#ifndef SG_MUTANT_DWAB_ALIASED_CT
+        /* grayscale glyphs have no subpixel level to blend */
+        if (analysis->aa_mode == DWRITE_TEXT_ANTIALIAS_MODE_GRAYSCALE)
+            *cleartypelevel = 0.0f;
+#endif
         break;
     default:
         ;
@@ -6859,6 +6870,7 @@ HRESULT create_glyphrunanalysis(const struct glyphrunanalysis_desc *desc, IDWrit
     analysis->IDWriteGlyphRunAnalysis_iface.lpVtbl = &glyphrunanalysisvtbl;
     analysis->refcount = 1;
     analysis->rendering_mode = desc->rendering_mode;
+    analysis->aa_mode = desc->aa_mode;
 
     if (desc->rendering_mode == DWRITE_RENDERING_MODE1_ALIASED
             || desc->aa_mode == DWRITE_TEXT_ANTIALIAS_MODE_GRAYSCALE)
--- a/dlls/dwrite/main.c
+++ b/dlls/dwrite/main.c
@@ -952,8 +952,13 @@ HRESULT factory_get_cached_fontface(IDWriteFactory7 *iface, IDWriteFontFile * co
     else {
         struct fileloader *fileloader = factory_get_file_loader(factory, loader);
         IDWriteFontFileLoader_Release(loader);
+#ifdef SG_MUTANT_DWFOREIGN_REJECTED
         if (!fileloader)
             return E_INVALIDARG;
+#endif
+        /* a file made with another factory can be used, it only isn't cached */
+        if (!fileloader)
+            return S_FALSE;
         fontfaces = &fileloader->fontfaces;
     }
 
@@ -1005,6 +1010,10 @@ struct fontfacecached *factory_cache_fontface(IDWriteFactory7 *iface, struct lis
     struct dwritefactory *factory = impl_from_IDWriteFactory7(iface);
     struct fontfacecached *cached;
 
+    /* faces of files from loaders this factory does not know are not cached */
+    if (!fontfaces)
+        return NULL;
+
     /* new cache entry */
     if (!(cached = malloc(sizeof(*cached))))
         return NULL;
--- a/dlls/dwrite/tests/font.c
+++ b/dlls/dwrite/tests/font.c
@@ -3363,7 +3363,6 @@ if (0) { /* crashes on win10 */
     /* file was created with different factory */
     face2 = NULL;
     hr = IDWriteFactory_CreateFontFace(factory2, face_type, 1, &file, 0, DWRITE_FONT_SIMULATIONS_NONE, &face2);
-    todo_wine
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
 if (face2) {
     IDWriteFontFace_Release(face2);
@@ -6046,7 +6045,6 @@ static void test_CreateGlyphRunAnalysis(void)
 
         hr = IDWriteGlyphRunAnalysis_GetAlphaBlendParams(analysis, params, &gamma, &contrast, &cleartype_level);
         ok(hr == S_OK, "Failed to get alpha blend params, hr %#lx.\n", hr);
-        todo_wine
         ok(cleartype_level == 0.0f, "Unexpected cleartype level %f.\n", cleartype_level);
 
         IDWriteRenderingParams_Release(params);
@@ -8146,13 +8144,11 @@ static void test_CreateFontFaceReference(void)
                     (void **)&ref2)))
             {
                 axis_count = IDWriteFontFaceReference1_GetFontAxisValueCount(ref2);
-                todo_wine
                 ok(axis_count >= 4, "Unexpected axis value count.\n");
 
                 hr = IDWriteFontFaceReference1_GetFontAxisValues(ref2, axis_values, ARRAY_SIZE(axis_values));
                 ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
 
-                todo_wine
                 ok(has_main_axis_values(axis_values, axis_count), "Unexpected axis returned.\n");
 
                 IDWriteFontFaceReference1_Release(ref2);
