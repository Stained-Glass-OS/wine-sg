From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: a file moved within one drive letter over two
 filesystems is copied

wine-sg 7816. One drive letter can span two filesystems here (C:\users on a
home of its own partition); on Windows a drive is one volume and a move
within it is a rename. MoveFileEx without MOVEFILE_COPY_ALLOWED failed
with ERROR_NOT_SAME_DEVICE (Rust's fs::rename, Python's os.replace); a file
is now copied there as MOVEFILE_COPY_ALLOWED would. Another drive letter
still gives ERROR_NOT_SAME_DEVICE; a folder still cannot move that way
(7814 makes the same-filesystem case a rename).
---
 dlls/kernelbase/file.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index 991a45b..eaa99d6 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -3119,6 +3119,18 @@ UINT WINAPI DECLSPEC_HOTPATCH GetWindowsDirectoryW( LPWSTR path, UINT count )
 }
 
 
+/* both paths on one drive letter (what Windows calls one volume) */
+static BOOL same_drive( const WCHAR *a, const WCHAR *b )
+{
+    WCHAR fa[MAX_PATH], fb[MAX_PATH];
+    const WCHAR *pa = fa, *pb = fb;
+
+    if (!GetFullPathNameW( a, MAX_PATH, fa, NULL ) || !GetFullPathNameW( b, MAX_PATH, fb, NULL )) return FALSE;
+    if (!wcsncmp( pa, L"\\\\?\\", 4 )) pa += 4;
+    if (!wcsncmp( pb, L"\\\\?\\", 4 )) pb += 4;
+    return pa[0] && pa[1] == ':' && pb[1] == ':' && towupper( pa[0] ) == towupper( pb[0] );
+}
+
 /**************************************************************************
  *	MoveFileExW   (kernelbase.@)
  */
@@ -3189,6 +3201,16 @@ BOOL WINAPI DECLSPEC_HOTPATCH MoveFileWithProgressW( const WCHAR *source, const
     RtlFreeUnicodeString( &nt_name );
     status = NtSetInformationFile( source_handle, &io, rename_info, size, FileRenameInformation );
     HeapFree( GetProcessHeap(), 0, rename_info );
+    if (status == STATUS_NOT_SAME_DEVICE && !(flag & MOVEFILE_COPY_ALLOWED) &&
+        !(info.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) && same_drive( source, dest ))
+    {
+        /* Stained Glass OS (wine-sg 7816): one drive letter over two filesystems (C:\users on a home of
+         * its own partition): on Windows this is one volume and the move a rename; here a file is
+         * copied, as MOVEFILE_COPY_ALLOWED would, rather than refused with ERROR_NOT_SAME_DEVICE */
+#ifndef SG_MUTANT_MOVE_SAME_DRIVE_REFUSED
+        flag |= MOVEFILE_COPY_ALLOWED;
+#endif
+    }
     if (status == STATUS_NOT_SAME_DEVICE && (flag & MOVEFILE_COPY_ALLOWED))
     {
         NtClose( source_handle );
-- 
