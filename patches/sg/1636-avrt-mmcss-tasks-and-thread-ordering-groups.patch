+/* a task's category and priority: 0 rank for a task not known */
+static BOOL find_task(const WCHAR *name, DWORD *priority, int *category)
+{
+    WCHAR path[256], cat[16];
+    DWORD size, value;
+    unsigned int i;
+    HKEY key;
+
+    *priority = 8;
+    *category = 1;  /* Medium */
+    swprintf(path, ARRAY_SIZE(path), L"%s\\Tasks\\%s", profile_key, name);
+    if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_QUERY_VALUE, &key))
+    {
+        size = sizeof(value);
+        if (!RegQueryValueExW(key, L"Priority", NULL, NULL, (BYTE *)&value, &size) && value >= 1 && value <= 8)
+            *priority = value;
+        size = sizeof(cat);
+        if (!RegQueryValueExW(key, L"Scheduling Category", NULL, NULL, (BYTE *)cat, &size))
+            *category = !wcsicmp(cat, L"High") ? 2 : !wcsicmp(cat, L"Low") ? 0 : 1;
+        RegCloseKey(key);
+        return TRUE;
+    }
+    for (i = 0; i < ARRAY_SIZE(default_tasks); i++)
+    {
+        if (wcsicmp(name, default_tasks[i].name)) continue;
+        *priority = default_tasks[i].priority;
+        *category = !wcsicmp(default_tasks[i].category, L"High") ? 2 : !wcsicmp(default_tasks[i].category, L"Low") ? 0 : 1;
+        return TRUE;
+    }
+    return FALSE;
+}
