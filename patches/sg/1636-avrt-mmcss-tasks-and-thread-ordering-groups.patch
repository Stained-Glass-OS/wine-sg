+static const struct mm_task default_tasks[] =
+{
+    { L"Audio",          6, L"Medium" },
+    { L"Capture",        5, L"Medium" },
+    { L"Distribution",   4, L"Medium" },
+    { L"Games",          2, L"Medium" },
+    { L"Playback",       3, L"Medium" },
+    { L"Pro Audio",      1, L"High" },
+    { L"Window Manager", 5, L"Medium" },
+};
