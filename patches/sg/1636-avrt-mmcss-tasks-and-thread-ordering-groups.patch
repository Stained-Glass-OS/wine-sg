+/* Thread ordering groups: a parent thread and its clients run one after
+ * another, once a period: the clients that joined "before" the parent, the
+ * parent, then those that joined after, each in the order they joined.
+ * AvRtWaitOnThreadOrderingGroup ends a thread's turn and waits for its
+ * next; a turn not ended within the timeout passes to the next thread. */
+#define GROUP_MAGIC 0x4f524452  /* ORDR */
+
+struct order_group;
+
+struct order_member
+{
+    DWORD magic;
+    struct order_group *group;
+    struct order_member *next;
+    BOOL parent;
+    BOOL running;   /* it has its turn now (its last wait returned it) */
+};
+
+struct order_group
+{
+    struct order_group *next;
+    GUID guid;
+    ULONGLONG period, timeout;   /* 100 ns units; timeout ~0 for none */
+    struct order_member *members;
+    struct order_member *turn;
+    ULONGLONG cycle_start, turn_start;
+    unsigned int count;
+    BOOL deleted;
+};
+
+static struct order_group *groups;
+static CRITICAL_SECTION group_cs;
+static CRITICAL_SECTION_DEBUG group_cs_debug =
+{
+    0, 0, &group_cs,
+    { &group_cs_debug.ProcessLocksList, &group_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": group_cs") }
+};
+static CRITICAL_SECTION group_cs = { &group_cs_debug, -1, 0, 0, 0, 0 };
+static CONDITION_VARIABLE group_cv = CONDITION_VARIABLE_INIT;
+
+static ULONGLONG now_100ns(void)
+{
+    LARGE_INTEGER counter, freq;
+
+    QueryPerformanceCounter(&counter);
+    QueryPerformanceFrequency(&freq);
+    return counter.QuadPart / freq.QuadPart * 10000000 + counter.QuadPart % freq.QuadPart * 10000000 / freq.QuadPart;
+}
+
+static struct order_member *get_member(HANDLE context)
+{
+    struct order_member *m = context;
+
+    if (!m || m->magic != GROUP_MAGIC)
     {
         SetLastError(ERROR_INVALID_HANDLE);
         return NULL;
     }
+    return m;
+}
+
+/* the turn passes to the next member; after the last a new cycle begins a
+ * period after the last one began */
+static void next_turn(struct order_group *group, ULONGLONG now)
+{
+    if (group->turn && group->turn->next) group->turn = group->turn->next;
+    else
+    {
+        group->turn = group->members;
+        group->cycle_start = max(now, group->cycle_start + group->period);
+    }
+    group->turn_start = group->turn == group->members ? group->cycle_start : now;
+    WakeAllConditionVariable(&group_cv);
+}
 
-    return (HANDLE)0x12345678;
+static void insert_member(struct order_group *group, struct order_member *m, BOOL before)
+{
+    struct order_member **p = &group->members;
+
+#ifdef SG_MUTANT_NO_ORDERING
+    before = FALSE;
+#endif
+    if (before)
+    {
+        /* before the parent, after the other "before" clients */
+        while (*p && !(*p)->parent) p = &(*p)->next;
+    }
+    else while (*p) p = &(*p)->next;
+    m->next = *p;
+    *p = m;
+    group->count++;
+}
+
+BOOL WINAPI AvRtCreateThreadOrderingGroupExW(HANDLE *context, LARGE_INTEGER *period, GUID *guid,
+                                             LARGE_INTEGER *timeout, const WCHAR *task)
+{
+    static const GUID null_guid;
+    struct order_group *group, *g;
+    struct order_member *m;
+
+    TRACE("(%p, %p, %p, %p, %s)\n", context, period, guid, timeout, debugstr_w(task));
+
+    /* a period of half a millisecond to half a second */
+    if (!context || !period || !guid || period->QuadPart < 5000 || period->QuadPart > 5000000 ||
+        (timeout != THREAD_ORDER_GROUP_INFINITE_TIMEOUT && timeout && timeout->QuadPart < period->QuadPart))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(group = calloc(1, sizeof(*group))) || !(m = calloc(1, sizeof(*m))))
+    {
+        free(group);
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    if (!memcmp(guid, &null_guid, sizeof(*guid))) CoCreateGuid(guid);
+    group->guid = *guid;
+    group->period = period->QuadPart;
+    group->timeout = timeout == THREAD_ORDER_GROUP_INFINITE_TIMEOUT ? ~0ull :
+                     timeout ? (ULONGLONG)timeout->QuadPart : 5 * group->period;
+    m->magic = GROUP_MAGIC;
+    m->group = group;
+    m->parent = TRUE;
+    EnterCriticalSection(&group_cs);
+    for (g = groups; g; g = g->next)
+        if (!g->deleted && IsEqualGUID(&g->guid, guid)) break;
+    if (g)
+    {
+        LeaveCriticalSection(&group_cs);
+        free(m);
+        free(group);
+        SetLastError(ERROR_ALREADY_EXISTS);
+        return FALSE;
+    }
+    insert_member(group, m, FALSE);
+    group->next = groups;
+    groups = group;
+    LeaveCriticalSection(&group_cs);
+    /* the parent runs as the task says, Audio unless named */
+    if (task)
+    {
+        DWORD index = 0;
+        HANDLE h = AvSetMmThreadCharacteristicsW(task, &index);
+        if (h) free(h);   /* the boost stays with the thread */
+    }
+    *context = m;
+    return TRUE;
+}
+
+BOOL WINAPI AvRtCreateThreadOrderingGroupExA(HANDLE *context, LARGE_INTEGER *period, GUID *guid,
+                                             LARGE_INTEGER *timeout, const char *task)
+{
+    WCHAR *taskW = NULL;
+    BOOL ret;
+
+    if (task && !(taskW = strdupAW(task)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    ret = AvRtCreateThreadOrderingGroupExW(context, period, guid, timeout, taskW);
+    free(taskW);
+    return ret;
+}
+
+BOOL WINAPI AvRtCreateThreadOrderingGroup(HANDLE *context, LARGE_INTEGER *period, GUID *guid,
+                                          LARGE_INTEGER *timeout)
+{
+    return AvRtCreateThreadOrderingGroupExW(context, period, guid, timeout, NULL);
+}
+
+BOOL WINAPI AvRtJoinThreadOrderingGroup(HANDLE *context, GUID *guid, BOOL before)
+{
+    struct order_group *group;
+    struct order_member *m;
+
+    TRACE("(%p, %s, %d)\n", context, debugstr_guid(guid), before);
+
+    if (!context || !guid)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(m = calloc(1, sizeof(*m))))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    EnterCriticalSection(&group_cs);
+    for (group = groups; group; group = group->next)
+        if (!group->deleted && IsEqualGUID(&group->guid, guid)) break;
+    if (!group)
+    {
+        LeaveCriticalSection(&group_cs);
+        free(m);
+        SetLastError(ERROR_NOT_FOUND);
+        return FALSE;
+    }
+    m->magic = GROUP_MAGIC;
+    m->group = group;
+    insert_member(group, m, before);
+    LeaveCriticalSection(&group_cs);
+    *context = m;
+    return TRUE;
+}
+
+BOOL WINAPI AvRtWaitOnThreadOrderingGroup(HANDLE context)
+{
+    struct order_member *m;
+    struct order_group *group;
+    ULONGLONG now, start;
+    BOOL ret = TRUE;
+
+    TRACE("(%p)\n", context);
+
+    EnterCriticalSection(&group_cs);
+    if (!(m = get_member(context)))
+    {
+        LeaveCriticalSection(&group_cs);
+        return FALSE;
+    }
+    group = m->group;
+    now = now_100ns();
+    /* the first wait of the group starts its first cycle; a member that
+     * had its turn ends it */
+    if (!group->turn)
+    {
+        group->turn = group->members;
+        group->cycle_start = group->turn_start = now;
+    }
+    else if (group->turn == m && m->running) next_turn(group, now);
+    m->running = FALSE;
+    start = now;
+    for (;;)
+    {
+        if (group->deleted)
+        {
+            SetLastError(ERROR_INVALID_HANDLE);
+            ret = FALSE;
+            break;
+        }
+        now = now_100ns();
+        if (group->turn == m && now >= group->turn_start)
+        {
+            m->running = TRUE;
+            break;
+        }
+        /* a turn held too long passes on; a wait as long gives up */
+        if (group->timeout != ~0ull && group->turn != m && now - group->turn_start > group->timeout &&
+            now >= group->turn_start)
+            next_turn(group, now);
+        if (group->timeout != ~0ull && now - start > group->timeout)
+        {
+            SetLastError(ERROR_TIMEOUT);
+            ret = FALSE;
+            break;
+        }
+        SleepConditionVariableCS(&group_cv, &group_cs,
+                                 group->turn == m ? (DWORD)((group->turn_start - now) / 10000 + 1) : 1);
+    }
+    LeaveCriticalSection(&group_cs);
+    return ret;
+}
+
+static void remove_member(struct order_member *m)
+{
+    struct order_group *group = m->group;
+    struct order_member **p;
+
+    for (p = &group->members; *p; p = &(*p)->next)
+        if (*p == m)
+        {
+            if (group->turn == m) next_turn(group, now_100ns());
+            if (group->turn == m) group->turn = NULL;
+            *p = m->next;
+            group->count--;
+            break;
+        }
+    m->magic = 0;
+    WakeAllConditionVariable(&group_cv);
+}
+
+BOOL WINAPI AvRtLeaveThreadOrderingGroup(HANDLE context)
+{
+    struct order_member *m;
+
+    TRACE("(%p)\n", context);
+
+    EnterCriticalSection(&group_cs);
+    if (!(m = get_member(context)) || m->parent)
+    {
+        if (m) SetLastError(ERROR_INVALID_HANDLE);
+        LeaveCriticalSection(&group_cs);
+        return FALSE;
+    }
+    remove_member(m);
+    LeaveCriticalSection(&group_cs);
+    free(m);
+    return TRUE;
+}
+
+BOOL WINAPI AvRtDeleteThreadOrderingGroup(HANDLE context)
+{
+    struct order_member *m;
+    struct order_group *group;
+
+    TRACE("(%p)\n", context);
+
+    EnterCriticalSection(&group_cs);
+    if (!(m = get_member(context)) || !m->parent)
+    {
+        if (m) SetLastError(ERROR_INVALID_HANDLE);
+        LeaveCriticalSection(&group_cs);
+        return FALSE;
+    }
+    /* the clients' waits end with an error; their contexts stay theirs */
+    group = m->group;
+    group->deleted = TRUE;
+    remove_member(m);
+    WakeAllConditionVariable(&group_cv);
+    LeaveCriticalSection(&group_cs);
+    free(m);
+    return TRUE;
 }
