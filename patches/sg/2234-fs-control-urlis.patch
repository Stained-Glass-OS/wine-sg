From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, kernelbase: FileFsControlInformation, UrlIs HASQUERY

Small answers that were FIXME stubs: querying FileFsControlInformation
(a volume's quota settings) gave STATUS_NOT_IMPLEMENTED, it now reports a
volume with quotas neither tracked nor enforced (thresholds -1);
FileFsLabelInformation, a set-only class, is STATUS_INVALID_INFO_CLASS
without a FIXME; FILE_SKIP_SET_USER_EVENT_ON_FAST_IO no longer logs a
FIXME (the flag is kept by the server and only spares an event);
UrlIs(URLIS_HASQUERY) answers instead of logging a stub.

---
--- a/dlls/kernelbase/path.c
+++ b/dlls/kernelbase/path.c
@@ -4742,9 +4742,12 @@ BOOL WINAPI UrlIsA(const char *url, URLIS Urlis)
     case URLIS_URL:
         return PathIsURLA(url);
 
+    case URLIS_HASQUERY:
+#ifndef SG_MUTANT_URLIS_HASQUERY
+        return strchr( url, '?' ) != NULL;
+#endif
     case URLIS_NOHISTORY:
     case URLIS_APPLIABLE:
-    case URLIS_HASQUERY:
     default:
         FIXME("(%s %d): stub\n", debugstr_a(url), Urlis);
     }
@@ -4788,9 +4791,12 @@ BOOL WINAPI UrlIsW(const WCHAR *url, URLIS Urlis)
     case URLIS_URL:
         return PathIsURLW(url);
 
+    case URLIS_HASQUERY:
+#ifndef SG_MUTANT_URLIS_HASQUERY
+        return wcschr( url, '?' ) != NULL;
+#endif
     case URLIS_NOHISTORY:
     case URLIS_APPLIABLE:
-    case URLIS_HASQUERY:
     default:
         FIXME("(%s %d): stub\n", debugstr_w(url), Urlis);
     }
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5543,8 +5543,8 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         {
             FILE_IO_COMPLETION_NOTIFICATION_INFORMATION *info = ptr;
 
-            if (info->Flags & FILE_SKIP_SET_USER_EVENT_ON_FAST_IO)
-                FIXME( "FILE_SKIP_SET_USER_EVENT_ON_FAST_IO not supported\n" );
+            /* FILE_SKIP_SET_USER_EVENT_ON_FAST_IO only spares an event that
+             * a synchronous completion would set; setting it is harmless */
 
             SERVER_START_REQ( set_fd_completion_mode )
             {
@@ -8145,8 +8145,8 @@ NTSTATUS WINAPI NtQueryVolumeInformationFile( HANDLE handle, IO_STATUS_BLOCK *io
     switch( info_class )
     {
     case FileFsLabelInformation:
-        FIXME( "%p: label info not supported\n", handle );
-        status = STATUS_NOT_IMPLEMENTED;
+        /* a class to set only */
+        status = STATUS_INVALID_INFO_CLASS;
         break;
 
     case FileFsSizeInformation:
@@ -8328,9 +8328,29 @@ NTSTATUS WINAPI NtQueryVolumeInformationFile( HANDLE handle, IO_STATUS_BLOCK *io
     }
 
     case FileFsControlInformation:
-        FIXME( "%p: control info not supported\n", handle );
+#ifdef SG_MUTANT_FS_CONTROL
         status = STATUS_NOT_IMPLEMENTED;
         break;
+#endif
+        if (length < 48 /* the size of FILE_FS_CONTROL_INFORMATION */)
+            status = STATUS_BUFFER_TOO_SMALL;
+        else
+        {
+            /* a volume with quotas neither tracked nor enforced */
+            struct
+            {
+                LARGE_INTEGER FreeSpaceStartFiltering, FreeSpaceThreshold, FreeSpaceStopFiltering;
+                LARGE_INTEGER DefaultQuotaThreshold, DefaultQuotaLimit;
+                ULONG FileSystemControlFlags;
+            } *info = buffer;
+
+            memset( info, 0, sizeof(*info) );
+            info->DefaultQuotaThreshold.QuadPart = -1;
+            info->DefaultQuotaLimit.QuadPart = -1;
+            io->Information = sizeof(*info);
+            status = STATUS_SUCCESS;
+        }
+        break;
 
     case FileFsFullSizeInformation:
         if (length < sizeof(FILE_FS_FULL_SIZE_INFORMATION))
