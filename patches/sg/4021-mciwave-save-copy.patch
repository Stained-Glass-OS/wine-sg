From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mciwave: Save copies an opened file instead of moving it.

MCI_SAVE renamed the open file to the new name, so saving a file that was
opened (not recorded) under another name deleted the original, and saving
it under its own name deleted it first. A recording's temporary file is
still moved to its name; an opened file is copied, and saving onto itself
does nothing. Saving is done before the command returns, which is all
MCI_WAIT asks for.
Turns the "Save must not rename the original file" todo_wine of the winmm
mci test into a plain check.
---
 dlls/mciwave/mciwave.c | 37 +++++++++++++++++++++++++------------
 dlls/winmm/tests/mci.c |  2 +-
 2 files changed, 26 insertions(+), 13 deletions(-)

diff --git a/dlls/mciwave/mciwave.c b/dlls/mciwave/mciwave.c
index e5b94e3..883f2aa 100644
--- a/dlls/mciwave/mciwave.c
+++ b/dlls/mciwave/mciwave.c
@@ -43,6 +43,7 @@ typedef struct {
     MCIDEVICEID			wNotifyDeviceID;	/* MCI device ID with a pending notification */
     HANDLE			hCallback;	/* Callback handle for pending notification */
     LPWSTR			lpFileName;	/* Name of file (if any)                     */
+    BOOL			bTemporaryFile;	/* lpFileName is the temporary file of a recording */
     WAVEFORMATEX		wfxRef;
     LPWAVEFORMATEX		lpWaveFormat;	/* Points to wfxRef until set by OPEN or RECORD */
     BOOL			fInput;		/* FALSE = Output, TRUE = Input */
@@ -465,6 +466,7 @@ static LRESULT WAVE_mciOpenFile(WINE_MCIWAVE* wmw, LPCWSTR filename)
     if (!fn) return MCIERR_OUT_OF_MEMORY;
     free(wmw->lpFileName);
     wmw->lpFileName = fn;
+    wmw->bTemporaryFile = FALSE;
 
     if (filename[0]) {
         /* FIXME : what should be done if wmw->hFile is already != 0, or the driver is playin' */
@@ -1034,6 +1036,7 @@ static DWORD WAVE_mciRecord(MCIDEVICEID wDevID, DWORD_PTR dwFlags, DWORD_PTR pmt
     free(wmw->lpFileName);
     dwRet = create_tmp_file(&wmw->hFile, (WCHAR**)&wmw->lpFileName);
     if (dwRet != 0) return dwRet;
+    wmw->bTemporaryFile = TRUE;
 
     /* new RIFF file, lpWaveFormat now valid */
     dwRet = WAVE_mciCreateRIFFSkeleton(wmw);
@@ -1413,15 +1416,13 @@ static DWORD WAVE_mciSave(MCIDEVICEID wDevID, DWORD dwFlags, LPMCI_SAVE_PARMSW l
 {
     WINE_MCIWAVE*	wmw = WAVE_mciGetOpenDev(wDevID);
     DWORD		ret = MCIERR_FILE_NOT_SAVED, tmpRet;
+    WCHAR		src[MAX_PATH], dst[MAX_PATH];
 
     TRACE("%d, %08lX, %p);\n", wDevID, dwFlags, lpParms);
     if (lpParms == NULL)	return MCIERR_NULL_PARAMETER_BLOCK;
     if (wmw     == NULL)	return MCIERR_INVALID_DEVICE_ID;
 
-    if (dwFlags & MCI_WAIT)
-    {
-    	FIXME("MCI_WAIT not implemented\n");
-    }
+    /* saving is done before returning, which is all MCI_WAIT asks for */
     WAVE_mciStop(wDevID, 0, NULL);
 
     ret = mmioAscend(wmw->hFile, &wmw->ckWaveData, 0);
@@ -1439,14 +1440,26 @@ static DWORD WAVE_mciSave(MCIDEVICEID wDevID, DWORD dwFlags, LPMCI_SAVE_PARMSW l
       destination file DOESN'T exist, the delete will fail silently.  Let's also be
       careful not to lose our previous error code.
     */
-    tmpRet = GetLastError();
-    DeleteFileW (lpParms->lpfilename);
-    SetLastError(tmpRet);
-
-    /* FIXME: Open file.wav; Save; must not rename the original file.
-     * Nor must Save a.wav; Save b.wav rename a. */
-    if (0 == mmioRenameW(wmw->lpFileName, lpParms->lpfilename, 0, 0 )) {
-	ret = MMSYSERR_NOERROR;
+    if (!wmw->lpFileName || !GetFullPathNameW(wmw->lpFileName, MAX_PATH, src, NULL) ||
+        !GetFullPathNameW(lpParms->lpfilename, MAX_PATH, dst, NULL))
+        return MCIERR_FILE_NOT_SAVED;
+
+    if (!wcsicmp(src, dst)) {
+        /* the file is already where it is to be saved */
+        ret = MMSYSERR_NOERROR;
+    } else {
+        tmpRet = GetLastError();
+        DeleteFileW (lpParms->lpfilename);
+        SetLastError(tmpRet);
+
+        /* A recording lives in a temporary file, which moves to its name; a
+         * file that was opened stays where it is and is copied. */
+        if (wmw->bTemporaryFile) {
+            if (0 == mmioRenameW(wmw->lpFileName, lpParms->lpfilename, 0, 0 ))
+                ret = MMSYSERR_NOERROR;
+        } else if (CopyFileW(src, dst, FALSE)) {
+            ret = MMSYSERR_NOERROR;
+        }
     }
 
     if (MMSYSERR_NOERROR==ret && (dwFlags & MCI_NOTIFY))
diff --git a/dlls/winmm/tests/mci.c b/dlls/winmm/tests/mci.c
index 60f6003..752d26d 100644
--- a/dlls/winmm/tests/mci.c
+++ b/dlls/winmm/tests/mci.c
@@ -793,7 +793,7 @@ static void test_recordWAVE(HWND hwnd)
 
     /* Save must not rename the original file. */
     if (!DeleteFileA("tempfile1.wav"))
-        todo_wine ok(FALSE, "Save must not rename the original file; DeleteFileA returned %ld\n",
+        ok(FALSE, "Save must not rename the original file; DeleteFileA returned %ld\n",
                 GetLastError());
 
     err = mciSendStringA("set x channels 2", NULL, 0, NULL);
