From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 13:11:07 -0700
Subject: [PATCH] wscript/cscript: script errors, StdIn/StdOut/StdErr,
 GetObject (3241)

An unhandled script error is now reported: cscript writes
"path(line, char) Source: description" to the error stream, wscript shows
the Script/Line/Char/Error/Code/Source dialog, and the exit code is 1 (also
for syntax errors and a missing script file: "Input Error: Can not find
script file ..."). WScript.StdIn/StdOut/StdErr return the process's
standard streams as text streams (cscript only; wscript answers
ERROR_INVALID_HANDLE). WScript.GetObject binds a running instance, a file
through its class, or a moniker, and connects events for a Prefix. The
event sink exposes the event interface's type information.

diff --git a/programs/wscript/host.c b/programs/wscript/host.c
index 1ec2c15..f32733c 100644
--- a/programs/wscript/host.c
+++ b/programs/wscript/host.c
@@ -26,6 +26,9 @@
 #include <ole2.h>
 #include <ocidl.h>
 #include <activscp.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <wchar.h>
 
 #include "wscript.h"
 
@@ -43,6 +46,8 @@ VARIANT_BOOL wshInteractive =
     VARIANT_FALSE;
 #endif
 
+static const GUID CLSID_FileSystemObject = {0x0d43fe01, 0xf093, 0x11cf, {0x89, 0x40, 0x00, 0xa0, 0xc9, 0x05, 0x42, 0x28}};
+
 static HRESULT to_string(VARIANT *src, BSTR *dst)
 {
     VARIANT v;
@@ -92,6 +97,100 @@ static void print_string(const WCHAR *string)
     WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), "\r\n", 2, &count, FALSE);
 }
 
+int script_exit_code;
+
+/* write a line to the error stream (console host) or show it in a dialog (GUI host) */
+static void print_error_string(const WCHAR *string, const WCHAR *title)
+{
+    DWORD count, len, lena;
+    HANDLE err;
+    char *buf;
+
+    if(wshInteractive) {
+        MessageBoxW(NULL, string, title, MB_OK|MB_ICONERROR);
+        return;
+    }
+
+    err = GetStdHandle(STD_ERROR_HANDLE);
+    len = lstrlenW(string);
+    if(WriteConsoleW(err, string, len, &count, NULL)) {
+        WriteConsoleW(err, L"\r\n", 2, &count, NULL);
+        return;
+    }
+
+    lena = WideCharToMultiByte(GetOEMCP(), 0, string, len, NULL, 0, NULL, NULL);
+    buf = malloc(lena + 2);
+    if(!buf)
+        return;
+    WideCharToMultiByte(GetOEMCP(), 0, string, len, buf, lena, NULL, NULL);
+    buf[lena] = '\r';
+    buf[lena + 1] = '\n';
+    WriteFile(err, buf, lena + 2, &count, NULL);
+    free(buf);
+}
+
+void report_host_error(const WCHAR *message)
+{
+    print_error_string(message, L"Script Host");
+    script_exit_code = 1;
+}
+
+/* an unhandled script error: the engine's source and description with the
+ * position, as a console host prints them, or the multi-line dialog of the
+ * GUI host */
+void report_script_error(IActiveScriptError *error)
+{
+    DWORD context;
+    ULONG line = 0;
+    LONG ch = 0;
+    EXCEPINFO ei;
+    WCHAR *text;
+    size_t size;
+    HRESULT hres;
+
+#ifndef SG_MUTANT_WSH_NOCODE
+    script_exit_code = 1;
+#endif
+#ifdef SG_MUTANT_WSH_NOERR
+    return;
+#endif
+
+    memset(&ei, 0, sizeof(ei));
+    hres = IActiveScriptError_GetExceptionInfo(error, &ei);
+    if(FAILED(hres)) {
+        WINE_WARN("GetExceptionInfo failed: %08lx\n", hres);
+        return;
+    }
+    if(ei.pfnDeferredFillIn)
+        ei.pfnDeferredFillIn(&ei);
+    hres = IActiveScriptError_GetSourcePosition(error, &context, &line, &ch);
+    if(FAILED(hres)) {
+        line = 0;
+        ch = 0;
+    }
+
+    size = 128 + lstrlenW(scriptFullName) + SysStringLen(ei.bstrSource) + SysStringLen(ei.bstrDescription);
+    text = malloc(size * sizeof(WCHAR));
+    if(text) {
+        const WCHAR *src = ei.bstrSource ? ei.bstrSource : L"";
+        const WCHAR *desc = ei.bstrDescription ? ei.bstrDescription : L"";
+        DWORD code = ei.scode ? ei.scode : ei.wCode;
+
+        if(wshInteractive)
+            swprintf(text, size, L"Script:\t%ls\nLine:\t%lu\nChar:\t%ld\nError:\t%ls\nCode:\t%08lX\nSource:\t%ls",
+                     scriptFullName, line, ch + 1, desc, code, src);
+        else if(*src)
+            swprintf(text, size, L"%ls(%lu, %ld) %ls: %ls", scriptFullName, line, ch + 1, src, desc);
+        else
+            swprintf(text, size, L"%ls(%lu, %ld) %ls", scriptFullName, line, ch + 1, desc);
+        print_error_string(text, L"Script Host");
+        free(text);
+    }
+    SysFreeString(ei.bstrSource);
+    SysFreeString(ei.bstrDescription);
+    SysFreeString(ei.bstrHelpFile);
+}
+
 static HRESULT WINAPI Host_QueryInterface(IHost *iface, REFIID riid, void **ppv)
 {
     WINE_TRACE("(%s %p)\n", wine_dbgstr_guid(riid), ppv);
@@ -343,19 +442,37 @@ static ULONG WINAPI EventSink_Release(IDispatch *iface)
 
 static HRESULT WINAPI EventSink_GetTypeInfoCount(IDispatch *iface, UINT *count)
 {
-    *count = 0;
+    *count = 1;
     return S_OK;
 }
 
+/* the sink implements the event interface of the object it is connected to */
 static HRESULT WINAPI EventSink_GetTypeInfo(IDispatch *iface, UINT index, LCID lcid, ITypeInfo **ti)
 {
-    return E_NOTIMPL;
+    struct event_sink *This = impl_from_event_IDispatch(iface);
+
+    *ti = NULL;
+    if(index)
+        return DISP_E_BADINDEX;
+    ITypeInfo_AddRef(This->typeinfo);
+    *ti = This->typeinfo;
+    return S_OK;
 }
 
 static HRESULT WINAPI EventSink_GetIDsOfNames(IDispatch *iface, REFIID riid, LPOLESTR *names, UINT count,
         LCID lcid, DISPID *ids)
 {
-    return E_NOTIMPL;
+    struct event_sink *This = impl_from_event_IDispatch(iface);
+    HRESULT hres;
+    UINT i;
+
+    hres = ITypeInfo_GetIDsOfNames(This->typeinfo, names, count, ids);
+    if(hres == TYPE_E_ELEMENTNOTFOUND) {
+        for(i = 0; i < count; i++)
+            ids[i] = DISPID_UNKNOWN;
+        hres = DISP_E_UNKNOWNNAME;
+    }
+    return hres;
 }
 
 static HRESULT WINAPI EventSink_Invoke(IDispatch *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
@@ -645,9 +762,81 @@ static HRESULT WINAPI Host_Echo(IHost *iface, SAFEARRAY *args)
 static HRESULT WINAPI Host_GetObject(IHost *iface, BSTR Pathname, BSTR ProgID,
         BSTR Prefix, IDispatch **out_Dispatch)
 {
-    WINE_FIXME("(%s %s %s %p)\n", wine_dbgstr_w(Pathname), wine_dbgstr_w(ProgID),
+    IUnknown *unk = NULL;
+    HRESULT hres;
+
+    TRACE("(%s %s %s %p)\n", wine_dbgstr_w(Pathname), wine_dbgstr_w(ProgID),
         wine_dbgstr_w(Prefix), out_Dispatch);
+
+    if(!out_Dispatch)
+        return E_POINTER;
+    *out_Dispatch = NULL;
+
+    if(Pathname && !*Pathname)
+        Pathname = NULL;
+    if(ProgID && !*ProgID)
+        ProgID = NULL;
+    if(!Pathname && !ProgID)
+        return E_INVALIDARG;
+#ifdef SG_MUTANT_WSH_NOGETOBJ
     return E_NOTIMPL;
+#endif
+
+    if(!Pathname) {
+        /* a running instance of the class */
+        GUID guid;
+
+        hres = CLSIDFromProgID(ProgID, &guid);
+        if(SUCCEEDED(hres))
+            hres = GetActiveObject(&guid, NULL, &unk);
+    }else if(ProgID) {
+        /* a new object of the class that loads the file */
+        IPersistFile *persist;
+        GUID guid;
+
+        hres = CLSIDFromProgID(ProgID, &guid);
+        if(SUCCEEDED(hres))
+            hres = CoCreateInstance(&guid, NULL, CLSCTX_INPROC_SERVER|CLSCTX_LOCAL_SERVER,
+                    &IID_IUnknown, (void**)&unk);
+        if(SUCCEEDED(hres)) {
+            hres = IUnknown_QueryInterface(unk, &IID_IPersistFile, (void**)&persist);
+            if(SUCCEEDED(hres)) {
+                hres = IPersistFile_Load(persist, Pathname, STGM_READ);
+                IPersistFile_Release(persist);
+            }
+            if(FAILED(hres)) {
+                IUnknown_Release(unk);
+                unk = NULL;
+            }
+        }
+    }else {
+        IBindCtx *bind_ctx;
+        IMoniker *mon;
+        ULONG eaten = 0;
+
+        hres = CreateBindCtx(0, &bind_ctx);
+        if(SUCCEEDED(hres)) {
+            hres = MkParseDisplayName(bind_ctx, Pathname, &eaten, &mon);
+            if(SUCCEEDED(hres)) {
+                hres = IMoniker_BindToObject(mon, bind_ctx, NULL, &IID_IUnknown, (void**)&unk);
+                IMoniker_Release(mon);
+            }
+            IBindCtx_Release(bind_ctx);
+        }
+    }
+    if(FAILED(hres))
+        return hres;
+
+    hres = IUnknown_QueryInterface(unk, &IID_IDispatch, (void**)out_Dispatch);
+    IUnknown_Release(unk);
+    if(SUCCEEDED(hres) && Prefix && *Prefix) {
+        hres = connect_events(*out_Dispatch, Prefix);
+        if(FAILED(hres)) {
+            IDispatch_Release(*out_Dispatch);
+            *out_Dispatch = NULL;
+        }
+    }
+    return hres;
 }
 
 static HRESULT WINAPI Host_DisconnectObject(IHost *iface, IDispatch *Object)
@@ -677,22 +866,73 @@ static HRESULT WINAPI Host_ConnectObject(IHost *iface, IDispatch *Object, BSTR P
     return connect_events(Object, Prefix);
 }
 
-static HRESULT WINAPI Host_get_StdIn(IHost *iface, ITextStream **ppts)
+/* the process's standard streams as text streams of the scripting runtime */
+static HRESULT get_std_stream(int type, ITextStream **out)
 {
-    WINE_FIXME("(%p)\n", ppts);
+    static const WCHAR *method = L"GetStandardStream";
+    IDispatch *fso;
+    DISPID id;
+    DISPPARAMS dp;
+    VARIANT args[2], res;
+    HRESULT hres;
+
+    if(!out)
+        return E_POINTER;
+    *out = NULL;
+
+#ifdef SG_MUTANT_WSH_NOSTD
     return E_NOTIMPL;
+#endif
+#ifndef CSCRIPT_BUILD
+    /* the GUI host has no console streams */
+    return HRESULT_FROM_WIN32(ERROR_INVALID_HANDLE);
+#endif
+
+    hres = CoCreateInstance(&CLSID_FileSystemObject, NULL, CLSCTX_INPROC_SERVER, &IID_IDispatch, (void**)&fso);
+    if(FAILED(hres))
+        return hres;
+
+    hres = IDispatch_GetIDsOfNames(fso, &IID_NULL, (WCHAR**)&method, 1, LOCALE_USER_DEFAULT, &id);
+    if(SUCCEEDED(hres)) {
+        /* arguments are passed last to first: Unicode, then the stream type */
+        V_VT(&args[0]) = VT_BOOL;
+        V_BOOL(&args[0]) = VARIANT_FALSE;
+        V_VT(&args[1]) = VT_I4;
+        V_I4(&args[1]) = type;
+        dp.rgvarg = args;
+        dp.cArgs = 2;
+        dp.cNamedArgs = 0;
+        dp.rgdispidNamedArgs = NULL;
+        VariantInit(&res);
+        hres = IDispatch_Invoke(fso, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &dp, &res, NULL, NULL);
+        if(SUCCEEDED(hres)) {
+            if(V_VT(&res) == VT_DISPATCH && V_DISPATCH(&res))
+                hres = IDispatch_QueryInterface(V_DISPATCH(&res), &IID_ITextStream, (void**)out);
+            else
+                hres = E_UNEXPECTED;
+            VariantClear(&res);
+        }
+    }
+    IDispatch_Release(fso);
+    return hres;
+}
+
+static HRESULT WINAPI Host_get_StdIn(IHost *iface, ITextStream **ppts)
+{
+    TRACE("(%p)\n", ppts);
+    return get_std_stream(0, ppts);
 }
 
 static HRESULT WINAPI Host_get_StdOut(IHost *iface, ITextStream **ppts)
 {
-    WINE_FIXME("(%p)\n", ppts);
-    return E_NOTIMPL;
+    TRACE("(%p)\n", ppts);
+    return get_std_stream(1, ppts);
 }
 
 static HRESULT WINAPI Host_get_StdErr(IHost *iface, ITextStream **ppts)
 {
-    WINE_FIXME("(%p)\n", ppts);
-    return E_NOTIMPL;
+    TRACE("(%p)\n", ppts);
+    return get_std_stream(2, ppts);
 }
 
