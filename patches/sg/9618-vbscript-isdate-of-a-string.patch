From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vbscript: IsDate is True for a string that is a date (9618)

"IsDate returns True if the expression is a date or is recognizable as a
valid date or time." Scripts check typed or read values with
IsDate("2001-02-03") or IsDate(InputBox(...)) before CDate; Wine's IsDate
looked only for a Date variant and answered False for every string. A string
is now a date when it converts to one (VarDateFromStr in the script's locale,
CDate's own first conversion): ISO, short and long dates and times are dates;
words, lone numbers such as "4" and impossible dates such as "2/30/2001" are
not, as before.
---
--- a/dlls/vbscript/global.c
+++ b/dlls/vbscript/global.c
@@ -997,6 +997,23 @@
     return return_short(res, vt);
 }
 
+/* "True if the expression is a date or is recognizable as a valid date or time": a string is
+ * a date when it converts to one, as CDate's first conversion takes it ("4" is no date, wine-sg 9618) */
+static BOOL is_date_value(BuiltinDisp *This, VARIANT *v)
+{
+    DATE date;
+
+    if(V_VT(v) == (VT_BYREF | VT_VARIANT))
+        v = V_VARIANTREF(v);
+    if(V_VT(v) == VT_DATE)
+        return TRUE;
+#ifndef SG_MUTANT_VBS_ISDATE_TYPE_ONLY
+    if(V_VT(v) == VT_BSTR && V_BSTR(v))
+        return SUCCEEDED(VarDateFromStr(V_BSTR(v), This->ctx->lcid, 0, &date));
+#endif
+    return FALSE;
+}
+
 static HRESULT Global_IsDate(BuiltinDisp *This, VARIANT *arg, unsigned args_cnt, VARIANT *res)
 {
     VARIANT val;
@@ -1005,10 +1022,10 @@
     TRACE("(%s)\n", debugstr_variant(arg));
 
     if(take_default_value(This, arg, &val)) {
-        r = V_VT(&val) == VT_DATE;
+        r = is_date_value(This, &val);
         VariantClear(&val);
     }else {
-        r = V_VT(arg) == VT_DATE;
+        r = is_date_value(This, arg);
     }
     return return_bool(res, r);
 }
