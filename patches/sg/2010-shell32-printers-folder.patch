 static HRESULT WINAPI IShellFolder_Printers_fnCompareIDs(IShellFolder2 *iface,
                LPARAM lParam, LPCITEMIDLIST pidl1, LPCITEMIDLIST pidl2)
 {
     IPrintersFolderImpl *This = impl_from_IShellFolder2(iface);
-    FIXME("(%p)->(0x%08Ix,pidl1=%p,pidl2=%p) stub\n", This, lParam, pidl1, pidl2);
-    return E_NOTIMPL;
+    const WCHAR *name1 = printer_pidl_name(pidl1), *name2 = printer_pidl_name(pidl2);
+    UINT column = lParam & 0xffff;
+    WCHAR text1[MAX_PATH], text2[MAX_PATH];
+    DWORD jobs1, jobs2;
+    int result;
+
+    TRACE("(%p)->(0x%08Ix,pidl1=%p,pidl2=%p)\n", This, lParam, pidl1, pidl2);
+
+    if (!name1 || !name2) return E_INVALIDARG;
+    if (column >= ARRAY_SIZE(printers_header)) return E_INVALIDARG;
+#ifdef SG_MUTANT_COMPARE_NAMEONLY
+    column = 0;
+#endif
+    printer_column_text(name1, column, text1, ARRAY_SIZE(text1), &jobs1);
+    printer_column_text(name2, column, text2, ARRAY_SIZE(text2), &jobs2);
+    if (column == 1) result = jobs1 < jobs2 ? -1 : jobs1 > jobs2 ? 1 : 0;
+    else result = wcsicmp(text1, text2);
+    if (!result && column) result = wcsicmp(name1, name2);
+    result = result < 0 ? -1 : result > 0 ? 1 : 0;
+    return MAKE_HRESULT(SEVERITY_SUCCESS, 0, (USHORT)result);
 }
 
