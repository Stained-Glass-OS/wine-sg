From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: Printers folder lists and describes the printers (2010)

shell32: Printers folder lists and describes the printers (2010)

EnumObjects, ParseDisplayName, GetDisplayNameOf, GetDetailsOf/GetDetailsEx,
CompareIDs, GetAttributesOf, BindToObject/Storage, GetUIObjectOf and
GetClassID of the Printers folder, over the winspool printer list. Items
are private pidls carrying the printer name.
---
--- a/dlls/shell32/shfldr_printers.c
+++ b/dlls/shell32/shfldr_printers.c
@@ -26,6 +26,10 @@
 #include "winerror.h"
 #include "windef.h"
 #include "winbase.h"
+#include "wingdi.h"
+#include "winspool.h"
+#include "shlwapi.h"
+#include "oleauto.h"
 
 #include "shell32_main.h"
 #include "wine/debug.h"
@@ -63,6 +67,136 @@ static const shvheader printers_header[] = {
     { NULL, 0, IDS_SHV_COL_MODEL, SHCOLSTATE_TYPE_STR | SHCOLSTATE_ONBYDEFAULT, LVCFMT_LEFT, 20 }
 };
 
+/* Stained Glass OS: the printers come from winspool (EnumPrinters); an item
+ * is a private pidl: size, type, a pad byte, then the printer name. */
+#define PT_PRINTER 0x7e
+
+#include <pshpack1.h>
+struct printer_pidl
+{
+    WORD cb;
+    BYTE type;
+    BYTE pad;
+    WCHAR name[1];
+};
+#include <poppack.h>
+
+static LPITEMIDLIST printer_pidl_create(const WCHAR *name)
+{
+    DWORD len = (lstrlenW(name) + 1) * sizeof(WCHAR);
+    struct printer_pidl *item;
+
+    if (len > 0xfff0) return NULL;
+    if (!(item = SHAlloc(offsetof(struct printer_pidl, name) + len + sizeof(WORD)))) return NULL;
+    item->cb = offsetof(struct printer_pidl, name) + len;
+    item->type = PT_PRINTER;
+    item->pad = 0;
+    memcpy(item->name, name, len);
+    *(WORD *)((BYTE *)item + item->cb) = 0;
+    return (LPITEMIDLIST)item;
+}
+
+/* the name in the first item of a pidl of this folder, NULL if it is not one */
+static const WCHAR *printer_pidl_name(LPCITEMIDLIST pidl)
+{
+    const struct printer_pidl *item = (const struct printer_pidl *)pidl;
+    DWORD chars;
+
+    if (!pidl || item->cb <= offsetof(struct printer_pidl, name) || item->type != PT_PRINTER) return NULL;
+    chars = (item->cb - offsetof(struct printer_pidl, name)) / sizeof(WCHAR);
+    if (!chars || item->name[chars - 1]) return NULL;
+    return item->name;
+}
+
+typedef BOOL (WINAPI *enum_printers_t)(DWORD, WCHAR *, DWORD, BYTE *, DWORD, DWORD *, DWORD *);
+
+/* the local and connected printers, in a buffer to free; *count may be 0 with a NULL buffer */
+static BOOL printers_enum(PRINTER_INFO_2W **list, DWORD *count, BYTE **buffer)
+{
+    static enum_printers_t enum_printers;
+    DWORD need = 0, flags = PRINTER_ENUM_LOCAL | PRINTER_ENUM_CONNECTIONS;
+
+    *list = NULL; *count = 0; *buffer = NULL;
+#ifdef SG_MUTANT_ENUM_EMPTY
+    return TRUE;
+#endif
+    if (!enum_printers)
+    {
+        HMODULE winspool = LoadLibraryW(L"winspool.drv");
+        if (winspool) enum_printers = (enum_printers_t)GetProcAddress(winspool, "EnumPrintersW");
+        if (!enum_printers) return FALSE;
+    }
+    enum_printers(flags, NULL, 2, NULL, 0, &need, count);
+    if (!need) { *count = 0; return TRUE; }
+    if (!(*buffer = malloc(need))) return FALSE;
+    if (!enum_printers(flags, NULL, 2, *buffer, need, &need, count))
+    {
+        free(*buffer);
+        *buffer = NULL;
+        *count = 0;
+        return FALSE;
+    }
+    *list = (PRINTER_INFO_2W *)*buffer;
+    return TRUE;
+}
+
+static const WCHAR *printer_status_text(DWORD status)
+{
+    if (status & PRINTER_STATUS_ERROR) return L"Error";
+    if (status & PRINTER_STATUS_OFFLINE) return L"Offline";
+    if (status & PRINTER_STATUS_PAPER_JAM) return L"Paper jam";
+    if (status & PRINTER_STATUS_PAPER_OUT) return L"Out of paper";
+    if (status & PRINTER_STATUS_PAUSED) return L"Paused";
+    if (status & PRINTER_STATUS_PRINTING) return L"Printing";
+    if (status & PRINTER_STATUS_PENDING_DELETION) return L"Deleting";
+    return L"Ready";
+}
+
+/* the text of a column for one printer of this folder; FALSE when there is no such printer */
+static BOOL printer_column_text(const WCHAR *name, UINT column, WCHAR *text, UINT cch, DWORD *jobs)
+{
+    PRINTER_INFO_2W *list;
+    BYTE *buffer;
+    DWORD count, i;
+    BOOL found = FALSE;
+
+    text[0] = 0;
+    *jobs = 0;
+    if (column == 0)
+    {
+        lstrcpynW(text, name, cch);
+#ifdef SG_MUTANT_DETAILS_NAME_ONLY
+#else
+        found = TRUE;
+#endif
+    }
+    if (!printers_enum(&list, &count, &buffer)) return found;
+    for (i = 0; i < count; i++)
+    {
+        const WCHAR *src = NULL;
+        if (wcsicmp(list[i].pPrinterName, name)) continue;
+        found = TRUE;
+        *jobs = list[i].cJobs;
+        switch (column)
+        {
+        case 1: swprintf(text, cch, L"%lu", list[i].cJobs); break;
+        case 2: src = printer_status_text(list[i].Status); break;
+        case 3: src = list[i].pComment; break;
+        case 4: src = list[i].pLocation; break;
+        case 5: src = list[i].pDriverName; break;
+        }
+#ifdef SG_MUTANT_DETAILS_NAME_ONLY
+        src = NULL;
+#endif
+        if (src) lstrcpynW(text, src, cch);
+        break;
+    }
+    free(buffer);
+    return found;
+}
+
+#define PRINTER_ATTRIBUTES (SFGAO_CANLINK)
+
 static HRESULT WINAPI IShellFolder_Printers_fnQueryInterface(IShellFolder2 *iface,
                REFIID riid, LPVOID *ppvObj)
 {
@@ -125,30 +259,82 @@ static HRESULT WINAPI IShellFolder_Printers_fnParseDisplayName (IShellFolder2 *i
                DWORD * pchEaten, LPITEMIDLIST * ppidl, DWORD * pdwAttributes)
 {
     IPrintersFolderImpl *This = impl_from_IShellFolder2(iface);
+    PRINTER_INFO_2W *list;
+    BYTE *buffer;
+    DWORD count, i;
+    HRESULT hr = HRESULT_FROM_WIN32(ERROR_INVALID_PRINTER_NAME);
 
-    FIXME("(%p)->(HWND=%p,%p,%p=%s,%p,pidl=%p,%p) stub\n", This,
+    TRACE("(%p)->(HWND=%p,%p,%p=%s,%p,pidl=%p,%p)\n", This,
           hwndOwner, pbc, lpszDisplayName, debugstr_w (lpszDisplayName),
           pchEaten, ppidl, pdwAttributes);
 
-    return E_NOTIMPL;
+    if (!ppidl) return E_INVALIDARG;
+    *ppidl = NULL;
+    if (!lpszDisplayName || !*lpszDisplayName) return E_INVALIDARG;
+
+#ifndef SG_MUTANT_PARSE_FAIL
+    if (printers_enum(&list, &count, &buffer))
+    {
+        for (i = 0; i < count; i++)
+        {
+            if (wcsicmp(list[i].pPrinterName, lpszDisplayName)) continue;
+            if (!(*ppidl = printer_pidl_create(list[i].pPrinterName))) hr = E_OUTOFMEMORY;
+            else hr = S_OK;
+            break;
+        }
+        free(buffer);
+    }
+#endif
+    if (hr == S_OK)
+    {
+        if (pchEaten) *pchEaten = lstrlenW(lpszDisplayName);
+        if (pdwAttributes) *pdwAttributes &= PRINTER_ATTRIBUTES;
+    }
+    return hr;
 }
 
 static HRESULT WINAPI IShellFolder_Printers_fnEnumObjects (IShellFolder2 *iface,
                HWND hwndOwner, DWORD dwFlags, LPENUMIDLIST *ppEnumIDList)
 {
     IPrintersFolderImpl *This = impl_from_IShellFolder2(iface);
-    FIXME("(%p)->(HWND=%p flags=0x%08lx pplist=%p) stub\n", This,
+    IEnumIDListImpl *enumlist;
+    PRINTER_INFO_2W *list;
+    BYTE *buffer;
+    DWORD count, i;
+
+    TRACE("(%p)->(HWND=%p flags=0x%08lx pplist=%p)\n", This,
           hwndOwner, dwFlags, ppEnumIDList);
-    return E_NOTIMPL;
+
+    if (!ppEnumIDList) return E_INVALIDARG;
+    if (!(enumlist = IEnumIDList_Constructor())) return E_OUTOFMEMORY;
+    *ppEnumIDList = &enumlist->IEnumIDList_iface;
+
+    /* the printers are not folders */
+    if ((dwFlags & SHCONTF_NONFOLDERS) && printers_enum(&list, &count, &buffer))
+    {
+        for (i = 0; i < count; i++)
+        {
+            LPITEMIDLIST pidl = printer_pidl_create(list[i].pPrinterName);
+            if (pidl) AddToEnumList(enumlist, pidl);
+        }
+        free(buffer);
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI IShellFolder_Printers_fnBindToObject (IShellFolder2 *iface,
                LPCITEMIDLIST pidl, LPBC pbcReserved, REFIID riid, LPVOID *ppvOut)
 {
     IPrintersFolderImpl *This = impl_from_IShellFolder2(iface);
-    FIXME("(%p)->(pidl=%p,%p,%s,%p) stub\n", This,
+
+    TRACE("(%p)->(pidl=%p,%p,%s,%p)\n", This,
