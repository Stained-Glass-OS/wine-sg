From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: IRichEditOle link count, context sensitive help, client site show callbacks (3633)

riched20: IRichEditOle link count, context sensitive help, client site show callbacks

riched20: IRichEditOle::GetLinkCount (counts IOleLink objects), ContextSensitiveHelp (both interfaces), IOleClientSite ShowObject/OnShowWindow return S_OK. Gate fastb-gapre, mutant SG_MUTANT_RE_HELP. WordPad: additive only. Mutant RE_HELP shown caught.

Rebased at integration (integ-2026-10) onto 3255/3257 (fast-a): IOleClientSite::ShowObject and OnShowWindow keep fast-a 3257's implementations (scroll into view, shaded drawing; mutants); 3633's 'nothing to do' versions dropped (they had applied with fuzz into other functions before).
---
diff --git a/dlls/riched20/richole.c b/dlls/riched20/richole.c
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -958,8 +958,12 @@ static HRESULT WINAPI
 IRichEditOle_fnContextSensitiveHelp(IRichEditOle *iface, BOOL fEnterMode)
 {
     struct text_services *services = impl_from_IRichEditOle( iface );
-    FIXME( "stub %p\n", services );
+    TRACE( "(%p)->(%d)\n", services, fEnterMode );
+    /* There is no help mode to enter; the call is only a notification. */
+#ifdef SG_MUTANT_RE_HELP
     return E_NOTIMPL;
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI
@@ -1170,8 +1174,8 @@ static HRESULT STDMETHODCALLTYPE IOleInPlaceSite_fnGetWindow( IOleInPlaceSite *i
 static HRESULT STDMETHODCALLTYPE IOleInPlaceSite_fnContextSensitiveHelp(IOleInPlaceSite *iface, BOOL fEnterMode)
 {
     IOleClientSiteImpl *This = impl_from_IOleInPlaceSite(iface);
-    FIXME("not implemented: (%p)->(%d)\n", This, fEnterMode);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%d)\n", This, fEnterMode);
+    return S_OK;
 }
 
 static HRESULT STDMETHODCALLTYPE IOleInPlaceSite_fnCanInPlaceActivate(IOleInPlaceSite *iface)
@@ -1324,8 +1328,23 @@ IRichEditOle_fnGetClipboardData(IRichEditOle *iface, CHARRANGE *lpchrg,
 static LONG WINAPI IRichEditOle_fnGetLinkCount(IRichEditOle *iface)
 {
     struct text_services *services = impl_from_IRichEditOle( iface );
-    FIXME("stub %p\n", services);
-    return E_NOTIMPL;
+    struct re_object *reobj;
+    LONG count = 0;
+
+    TRACE("(%p)\n", services);
+
+    LIST_FOR_EACH_ENTRY( reobj, &services->editor->reobj_list, struct re_object, entry )
+    {
+        IOleLink *link;
+
+        if (reobj->obj.poleobj && SUCCEEDED(IOleObject_QueryInterface( reobj->obj.poleobj, &IID_IOleLink, (void **)&link )))
+        {
+            IOleLink_Release( link );
+            ++count;
+        }
+    }
+
+    return count;
 }
 
 static HRESULT WINAPI
