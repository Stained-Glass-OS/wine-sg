+/***********************************************************************
+ *      MFCalculateBitmapImageSize (mfplat.@)
+ */
+HRESULT WINAPI MFCalculateBitmapImageSize(const BITMAPINFOHEADER *header, UINT32 size, UINT32 *image_size, BOOL *known)
+{
+    UINT32 width, height, stride;
+    GUID subtype;
+
+    TRACE("%p, %u, %p, %p.\n", header, size, image_size, known);
+
+    if (!header || !image_size || !known)
+        return E_POINTER;
+
+    if (size < sizeof(*header) || header->biSize < sizeof(*header))
+        return E_INVALIDARG;
+
+    width = header->biWidth < 0 ? -header->biWidth : header->biWidth;
+    height = header->biHeight < 0 ? -header->biHeight : header->biHeight;
+
+    *known = TRUE;
+    switch (header->biCompression)
+    {
+        case BI_RGB:
+        case BI_BITFIELDS:
+            /* rows are padded to a 32-bit boundary */
+#ifdef SG_MUTANT_MFBUF_BMP_SIZE
+            stride = ((UINT64)width * header->biBitCount + 7) / 8;
+#else
+            stride = (((UINT64)width * header->biBitCount + 31) & ~31) / 8;
+#endif
+            *image_size = stride * height;
+            return S_OK;
+        default:
+            subtype = MFVideoFormat_Base;
+            subtype.Data1 = header->biCompression;
+            if (SUCCEEDED(MFCalculateImageSize(&subtype, width, height, image_size)))
+                return S_OK;
+    }
+
+    /* not a format we can size: the header's own value is all there is */
+    *known = FALSE;
+    *image_size = header->biSizeImage;
+    return S_OK;
+}
+
