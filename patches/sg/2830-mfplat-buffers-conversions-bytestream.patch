+struct buffer_wrapper
+{
+    IMFMediaBuffer IMFMediaBuffer_iface;
+    LONG refcount;
+
+    IMFMediaBuffer *inner;
+    DWORD offset;
+    DWORD max_length;
+    DWORD current_length;
+};
+
+static struct buffer_wrapper *impl_from_wrapper(IMFMediaBuffer *iface)
+{
+    return CONTAINING_RECORD(iface, struct buffer_wrapper, IMFMediaBuffer_iface);
+}
+
+static HRESULT WINAPI buffer_wrapper_QueryInterface(IMFMediaBuffer *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFMediaBuffer) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFMediaBuffer_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI buffer_wrapper_AddRef(IMFMediaBuffer *iface)
+{
+    struct buffer_wrapper *wrapper = impl_from_wrapper(iface);
+    ULONG refcount = InterlockedIncrement(&wrapper->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static ULONG WINAPI buffer_wrapper_Release(IMFMediaBuffer *iface)
+{
+    struct buffer_wrapper *wrapper = impl_from_wrapper(iface);
+    ULONG refcount = InterlockedDecrement(&wrapper->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        IMFMediaBuffer_Release(wrapper->inner);
+        free(wrapper);
+    }
+
+    return refcount;
+}
+
+static HRESULT WINAPI buffer_wrapper_Lock(IMFMediaBuffer *iface, BYTE **data, DWORD *max_length, DWORD *current_length)
+{
+    struct buffer_wrapper *wrapper = impl_from_wrapper(iface);
+    BYTE *inner_data;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p, %p.\n", iface, data, max_length, current_length);
+
+    if (!data)
+        return E_POINTER;
+
+    if (FAILED(hr = IMFMediaBuffer_Lock(wrapper->inner, &inner_data, NULL, NULL)))
+        return hr;
+
+#ifdef SG_MUTANT_MFBUF_WRAP_OFFSET
+    *data = inner_data;
+#else
+    *data = inner_data + wrapper->offset;
+#endif
+    if (max_length)
+        *max_length = wrapper->max_length;
+    if (current_length)
+        *current_length = wrapper->current_length;
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_Unlock(IMFMediaBuffer *iface)
+{
+    struct buffer_wrapper *wrapper = impl_from_wrapper(iface);
+
+    TRACE("%p.\n", iface);
+
+    return IMFMediaBuffer_Unlock(wrapper->inner);
+}
+
+static HRESULT WINAPI buffer_wrapper_GetCurrentLength(IMFMediaBuffer *iface, DWORD *length)
+{
+    struct buffer_wrapper *wrapper = impl_from_wrapper(iface);
+
+    TRACE("%p, %p.\n", iface, length);
+
+    if (!length)
+        return E_INVALIDARG;
+
+    *length = wrapper->current_length;
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_SetCurrentLength(IMFMediaBuffer *iface, DWORD length)
+{
+    struct buffer_wrapper *wrapper = impl_from_wrapper(iface);
+
+    TRACE("%p, %lu.\n", iface, length);
+
+    if (length > wrapper->max_length)
+        return E_INVALIDARG;
+
+    wrapper->current_length = length;
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_GetMaxLength(IMFMediaBuffer *iface, DWORD *length)
+{
+    struct buffer_wrapper *wrapper = impl_from_wrapper(iface);
+
+    TRACE("%p, %p.\n", iface, length);
+
+    if (!length)
+        return E_INVALIDARG;
+
+    *length = wrapper->max_length;
+
+    return S_OK;
+}
+
+static const IMFMediaBufferVtbl buffer_wrapper_vtbl =
+{
+    buffer_wrapper_QueryInterface,
+    buffer_wrapper_AddRef,
+    buffer_wrapper_Release,
+    buffer_wrapper_Lock,
+    buffer_wrapper_Unlock,
+    buffer_wrapper_GetCurrentLength,
+    buffer_wrapper_SetCurrentLength,
+    buffer_wrapper_GetMaxLength,
+};
+
+static HRESULT create_buffer_wrapper(IMFMediaBuffer *inner, DWORD offset, DWORD length, DWORD current_length,
+        IMFMediaBuffer **out)
+{
+    struct buffer_wrapper *wrapper;
+    DWORD inner_max;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFMediaBuffer_GetMaxLength(inner, &inner_max)))
+        return hr;
+
+#ifndef SG_MUTANT_MFBUF_WRAP_NO_BOUNDS
+    if (offset > inner_max || length > inner_max - offset)
+        return E_INVALIDARG;
+#endif
+
+    if (!(wrapper = calloc(1, sizeof(*wrapper))))
+        return E_OUTOFMEMORY;
+
+    wrapper->IMFMediaBuffer_iface.lpVtbl = &buffer_wrapper_vtbl;
+    wrapper->refcount = 1;
+    IMFMediaBuffer_AddRef((wrapper->inner = inner));
+    wrapper->offset = offset;
+    wrapper->max_length = length;
+    wrapper->current_length = min(current_length, length);
+
+    *out = &wrapper->IMFMediaBuffer_iface;
+
+    return S_OK;
+}
+
+/***********************************************************************
+ *      MFCreateMediaBufferWrapper (mfplat.@)
+ */
+HRESULT WINAPI MFCreateMediaBufferWrapper(IMFMediaBuffer *buffer, DWORD offset, DWORD length, IMFMediaBuffer **out)
+{
+    TRACE("%p, %lu, %lu, %p.\n", buffer, offset, length, out);
+
+    if (!buffer || !out)
+        return E_INVALIDARG;
+
+    /* the wrapper starts out holding the whole range */
+    return create_buffer_wrapper(buffer, offset, length, length, out);
+}
