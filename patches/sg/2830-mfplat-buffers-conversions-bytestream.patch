+/***********************************************************************
+ *      MFConvertToFP16Array (mfplat.@)
+ */
+HRESULT WINAPI MFConvertToFP16Array(WORD *dest, const float *src, DWORD count)
+{
+    DWORD i;
+
+    TRACE("%p, %p, %lu.\n", dest, src, count);
+
+    if (!dest || !src)
+        return E_POINTER;
+
+    for (i = 0; i < count; ++i)
+    {
+        UINT32 bits, mantissa, round_bit;
+        INT32 exponent;
+        WORD sign, half;
+
+        memcpy(&bits, &src[i], sizeof(bits));
+        sign = (bits >> 16) & 0x8000;
+        exponent = (int)((bits >> 23) & 0xff) - 127 + 15;
+        mantissa = bits & 0x7fffff;
+
+        if (((bits >> 23) & 0xff) == 0xff)
+            half = sign | 0x7c00 | (mantissa ? 0x200 | (mantissa >> 13) : 0); /* infinity or NaN */
+        else if (exponent >= 31)
+            half = sign | 0x7c00; /* too large: infinity */
+        else if (exponent <= 0)
+        {
+            if (exponent < -10)
+                half = sign; /* too small: zero */
+            else
+            {
+                /* a subnormal half: shift the implicit one in, rounding to nearest even */
+                mantissa |= 0x800000;
+                round_bit = 1u << (13 - exponent);
+                half = mantissa >> (14 - exponent);
+                if ((mantissa & round_bit) && ((mantissa & (round_bit - 1)) || (half & 1)))
+                    ++half;
+                half |= sign;
+            }
+        }
+        else
+        {
+            half = sign | (exponent << 10) | (mantissa >> 13);
+            /* round to nearest even; a carry out of the mantissa bumps the exponent, as it should */
+#ifndef SG_MUTANT_MFBUF_FP16_NO_ROUND
+            if ((mantissa & 0x1000) && ((mantissa & 0xfff) || (half & 1)))
+                ++half;
+#endif
+        }
+
+        dest[i] = half;
+    }
+
+    return S_OK;
+}
+
+/***********************************************************************
+ *      MFConvertFromFP16Array (mfplat.@)
+ */
+HRESULT WINAPI MFConvertFromFP16Array(float *dest, const WORD *src, DWORD count)
+{
+    DWORD i;
+
+    TRACE("%p, %p, %lu.\n", dest, src, count);
+
+    if (!dest || !src)
+        return E_POINTER;
+
+    for (i = 0; i < count; ++i)
+    {
+        UINT32 sign = (src[i] & 0x8000) << 16, exponent = (src[i] >> 10) & 0x1f, mantissa = src[i] & 0x3ff, bits;
+
+        if (exponent == 0x1f)
+            bits = sign | 0x7f800000 | (mantissa << 13); /* infinity or NaN */
+        else if (exponent)
+            bits = sign | ((exponent + 127 - 15) << 23) | (mantissa << 13);
+        else if (mantissa)
+        {
+            /* a subnormal half is a normal float */
+            exponent = 127 - 15 + 1;
+            while (!(mantissa & 0x400))
+            {
+                mantissa <<= 1;
+                --exponent;
+            }
+            bits = sign | (exponent << 23) | ((mantissa & 0x3ff) << 13);
+        }
+        else
+            bits = sign;
+
+        memcpy(&dest[i], &bits, sizeof(bits));
+    }
+
+    return S_OK;
+}
