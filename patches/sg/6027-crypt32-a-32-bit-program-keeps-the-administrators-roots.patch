From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: a 32-bit program keeps the administrator's roots (6027)

HKLM\Root is one store for 32- and 64-bit programs, but the record of
the roots Wine imported from the host (Software\Wine\Crypt32
ImportedRootCerts, 0042) was read in each program's own registry view.
A 32-bit program found none, took every root for an imported one, and
its host sync deleted the roots an administrator or Group Policy had
added: from then on every signature and certificate chaining to them
failed (CERT_E_CHAINING). The record is now read and written in the
64-bit view.
---
diff --git a/dlls/crypt32/rootstore.c b/dlls/crypt32/rootstore.c
index 0cc632c..34c1180 100644
--- a/dlls/crypt32/rootstore.c
+++ b/dlls/crypt32/rootstore.c
@@ -742,6 +742,14 @@ static HCERTSTORE create_root_store(HCERTSTORE cached, BOOL *delete)
  * here; anything else in HKLM\Root is the administrator's. */
 #define IMPORTED_ROOTS_KEY   L"Software\\Wine\\Crypt32"
 #define IMPORTED_ROOTS_VALUE L"ImportedRootCerts"
+/* HKLM\Root is one store for 32- and 64-bit programs (SystemCertificates is a shared key), so the record
+ * of what was imported into it is one too: a 32-bit process reading its own empty view took every root
+ * for an imported one, and the next host sync deleted the administrator's. */
+#ifdef SG_MUTANT_ROOTS_WOW_VIEW
+#define IMPORTED_ROOTS_VIEW  0
+#else
+#define IMPORTED_ROOTS_VIEW  KEY_WOW64_64KEY
+#endif
 
 static BYTE *read_imported_hashes(DWORD *count)
 {
@@ -750,7 +758,7 @@ static BYTE *read_imported_hashes(DWORD *count)
     HKEY key;
 
     *count = 0;
-    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, IMPORTED_ROOTS_KEY, 0, KEY_READ, &key)) return NULL;
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, IMPORTED_ROOTS_KEY, 0, KEY_READ | IMPORTED_ROOTS_VIEW, &key)) return NULL;
     if (RegQueryValueExW(key, IMPORTED_ROOTS_VALUE, NULL, &type, NULL, &size) || type != REG_BINARY ||
         size % 20 || !(hashes = CryptMemAlloc(size ? size : 1)))
     {
@@ -806,7 +814,8 @@ static void write_imported_hashes(HKEY root_key, HCERTSTORE admin)
             }
             memcpy(hashes + n++ * 20, hash, 20);
         }
-        if (!RegCreateKeyExW(HKEY_LOCAL_MACHINE, IMPORTED_ROOTS_KEY, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL))
+        if (!RegCreateKeyExW(HKEY_LOCAL_MACHINE, IMPORTED_ROOTS_KEY, 0, NULL, 0, KEY_SET_VALUE | IMPORTED_ROOTS_VIEW,
+                             NULL, &key, NULL))
         {
             RegSetValueExW(key, IMPORTED_ROOTS_VALUE, 0, REG_BINARY, hashes, n * 20);
             RegCloseKey(key);
