+
+    return typeinfo_invoke( ISpeechDataKey_tid, iface, dispid, flags, params, result, excepinfo, argerr );
+}
+
+static HRESULT WINAPI speech_data_key_SetBinaryValue( ISpeechDataKey *iface, const BSTR name,
+                                                      VARIANT value )
+{
+    struct data_key *This = impl_from_ISpeechDataKey( iface );
+    VARIANT *v = &value;
+    SAFEARRAY *array;
+    LONG lower, upper;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%s %s)\n", This, debugstr_w( name ), debugstr_variant( &value ) );
+
+    if (V_VT( v ) == (VT_VARIANT | VT_BYREF)) v = V_VARIANTREF( v );
+    if (V_VT( v ) == (VT_ARRAY | VT_UI1)) array = V_ARRAY( v );
+    else if (V_VT( v ) == (VT_ARRAY | VT_UI1 | VT_BYREF)) array = *V_ARRAYREF( v );
+    else return DISP_E_TYPEMISMATCH;
+    if (!array || SafeArrayGetDim( array ) != 1) return DISP_E_TYPEMISMATCH;
+
+    SafeArrayGetLBound( array, 1, &lower );
+    SafeArrayGetUBound( array, 1, &upper );
+    if (FAILED(hr = SafeArrayAccessData( array, (void **)&data ))) return hr;
+    hr = ISpRegDataKey_SetData( &This->ISpRegDataKey_iface, name,
+                                upper >= lower ? upper - lower + 1 : 0, data );
+    SafeArrayUnaccessData( array );
+    return hr;
+}
+
+static HRESULT WINAPI speech_data_key_GetBinaryValue( ISpeechDataKey *iface, const BSTR name,
+                                                      VARIANT *value )
+{
+    struct data_key *This = impl_from_ISpeechDataKey( iface );
+    SAFEARRAY *array;
+    ULONG size = 0;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%s %p)\n", This, debugstr_w( name ), value );
+
+    if (!value) return E_POINTER;
+
+    if (FAILED(hr = ISpRegDataKey_GetData( &This->ISpRegDataKey_iface, name, &size, NULL )))
+        return hr;
+    if (!(array = SafeArrayCreateVector( VT_UI1, 0, size ))) return E_OUTOFMEMORY;
+    if (size)
+    {
+        SafeArrayAccessData( array, (void **)&data );
+        hr = ISpRegDataKey_GetData( &This->ISpRegDataKey_iface, name, &size, data );
+        SafeArrayUnaccessData( array );
+        if (FAILED(hr))
+        {
+            SafeArrayDestroy( array );
+            return hr;
+        }
+    }
+
+    V_VT( value ) = VT_ARRAY | VT_UI1;
+    V_ARRAY( value ) = array;
+    return S_OK;
+}
+
+static HRESULT WINAPI speech_data_key_SetStringValue( ISpeechDataKey *iface, const BSTR name,
+                                                      const BSTR value )
+{
+    struct data_key *This = impl_from_ISpeechDataKey( iface );
+
