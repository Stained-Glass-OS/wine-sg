+/* Storage file names are kept as "<CSIDL>\<file name>" in the Files key of the token. */
+static HRESULT storage_path_from_value( const WCHAR *value, WCHAR **path )
+{
+    WCHAR folder[MAX_PATH];
+    const WCHAR *sep;
+    int csidl = wcstol( value, (WCHAR **)&sep, 10 );
+    SIZE_T len;
+    HRESULT hr;
+
+    if (!sep || *sep != L'\\') return SPERR_INVALID_REGISTRY_KEY;
+    if (FAILED(hr = SHGetFolderPathW( NULL, csidl, NULL, SHGFP_TYPE_CURRENT, folder )))
+        return hr;
+
+    len = wcslen( folder ) + wcslen( sep ) + 1;
+    if (!(*path = CoTaskMemAlloc( len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    swprintf( *path, len, L"%ls%ls", folder, sep );
+    return S_OK;
+}
+
+static HRESULT open_files_key( struct object_token *This, const GUID *caller, BOOL create, ISpDataKey **key )
+{
+    WCHAR name[64] = L"Files";
+
+    if (caller)
+    {
+        wcscat( name, L"\\" );
+        StringFromGUID2( caller, name + wcslen( name ), ARRAY_SIZE(name) - wcslen( name ) );
+    }
+    if (create) return ISpRegDataKey_CreateKey( This->data_key, name, key );
+    return ISpRegDataKey_OpenKey( This->data_key, name, key );
+}
