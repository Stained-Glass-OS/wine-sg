From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 16:59:19 -0700
Subject: [PATCH] d3d10: shader profiles, state block device, effect
 views/buffers and state masks

D3D10Get{Vertex,Geometry,Pixel}ShaderProfile answer for a 10.1 device with the
_4_1 profile and NULL for no device. StateBlock GetDevice and
ReleaseAllDeviceObjects work. Effects: IsValid, ShaderResource Get(Array),
RenderTargetView and DepthStencilView variables (Set/Get and arrays), string
GetStringArray, ConstantBuffer SetConstantBuffer / SetTextureBuffer /
GetTextureBuffer, and ComputeStateBlockMask for passes (buffers, views, samplers
the shaders bind) and techniques (union of their passes).

diff --git a/dlls/d3d10/d3d10_main.c b/dlls/d3d10/d3d10_main.c
index 565b5f4..73afd35 100644
--- a/dlls/d3d10/d3d10_main.c
+++ b/dlls/d3d10/d3d10_main.c
@@ -21,6 +21,7 @@
  */
 
 #include "d3d10_private.h"
+#include "d3d10_1.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(d3d10);
 
@@ -243,23 +244,44 @@ HRESULT WINAPI D3D10CompileEffectFromMemory(void *data, SIZE_T data_size, const
             NULL, "fx_4_0", hlsl_flags, fx_flags, effect, errors);
 }
 
+static const GUID iid_device1 = {0x9b7e4c8f, 0x342c, 0x4106, {0xa1, 0x9f, 0x4f, 0x27, 0x04, 0xf6, 0x89, 0xf0}};
+
+static BOOL device_is_10_1(ID3D10Device *device)
+{
+    ID3D10Device1 *device1;
+    BOOL ret = FALSE;
+
+    if (device && SUCCEEDED(ID3D10Device_QueryInterface(device, &iid_device1, (void **)&device1)))
+    {
+        ret = ID3D10Device1_GetFeatureLevel(device1) >= D3D10_FEATURE_LEVEL_10_1;
+        ID3D10Device1_Release(device1);
+    }
+    return ret;
+}
+
 const char * WINAPI D3D10GetVertexShaderProfile(ID3D10Device *device)
 {
-    FIXME("device %p stub!\n", device);
+    TRACE("device %p.\n", device);
 
-    return "vs_4_0";
+    if (!device)
+        return NULL;
+    return device_is_10_1(device) ? "vs_4_1" : "vs_4_0";
 }
 
 const char * WINAPI D3D10GetGeometryShaderProfile(ID3D10Device *device)
 {
-    FIXME("device %p stub!\n", device);
+    TRACE("device %p.\n", device);
 
-    return "gs_4_0";
+    if (!device)
+        return NULL;
+    return device_is_10_1(device) ? "gs_4_1" : "gs_4_0";
 }
 
 const char * WINAPI D3D10GetPixelShaderProfile(ID3D10Device *device)
 {
-    FIXME("device %p stub!\n", device);
+    TRACE("device %p.\n", device);
 
-    return "ps_4_0";
+    if (!device)
+        return NULL;
+    return device_is_10_1(device) ? "ps_4_1" : "ps_4_0";
 }
