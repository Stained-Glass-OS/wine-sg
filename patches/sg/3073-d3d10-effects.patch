+static void pass_mask_shader_resources(D3D10_STATE_BLOCK_MASK *mask, struct d3d10_effect_variable *shader,
+        D3D10_DEVICE_STATE_TYPES samplers, D3D10_DEVICE_STATE_TYPES resources, D3D10_DEVICE_STATE_TYPES buffers)
+{
+    struct d3d10_effect_shader_variable *sv = &shader->u.shader;
+    unsigned int i;
+
+    for (i = 0; i < sv->resource_count; ++i)
+    {
+        const struct d3d10_effect_shader_resource *sr = &sv->resources[i];
+
+        switch (sr->in_type)
+        {
+            case D3D10_SIT_CBUFFER:
+                D3D10StateBlockMaskEnableCapture(mask, buffers, sr->bind_point, 1);
+                break;
+            case D3D10_SIT_TEXTURE:
+            case D3D10_SIT_TBUFFER:
+                D3D10StateBlockMaskEnableCapture(mask, resources, sr->bind_point, sr->bind_count);
+                break;
+            case D3D10_SIT_SAMPLER:
+                D3D10StateBlockMaskEnableCapture(mask, samplers, sr->bind_point, sr->bind_count);
+                break;
+            default:
+                break;
+        }
+    }
+}
+
 static HRESULT STDMETHODCALLTYPE d3d10_effect_pass_ComputeStateBlockMask(ID3D10EffectPass *iface,
         D3D10_STATE_BLOCK_MASK *mask)
 {
     struct d3d10_effect_pass *pass = impl_from_ID3D10EffectPass(iface);
 
-    FIXME("iface %p, mask %p semi-stub!\n", iface, mask);
+    TRACE("iface %p, mask %p.\n", iface, mask);
+
+    if (!mask)
+        return E_INVALIDARG;
 
+    /* what Apply sets: the shaders with their buffers, views and samplers, and the state objects */
     if (pass->vs.shader != &null_shader_variable)
+    {
         D3D10StateBlockMaskEnableCapture(mask, D3D10_DST_VS, 0, 1);
+        pass_mask_shader_resources(mask, d3d10_array_get_element(pass->vs.shader, pass->vs.index),
+                D3D10_DST_VS_SAMPLERS, D3D10_DST_VS_SHADER_RESOURCES, D3D10_DST_VS_CONSTANT_BUFFERS);
+    }
     if (pass->ps.shader != &null_shader_variable)
+    {
         D3D10StateBlockMaskEnableCapture(mask, D3D10_DST_PS, 0, 1);
+        pass_mask_shader_resources(mask, d3d10_array_get_element(pass->ps.shader, pass->ps.index),
+                D3D10_DST_PS_SAMPLERS, D3D10_DST_PS_SHADER_RESOURCES, D3D10_DST_PS_CONSTANT_BUFFERS);
+    }
     if (pass->gs.shader != &null_shader_variable)
+    {
         D3D10StateBlockMaskEnableCapture(mask, D3D10_DST_GS, 0, 1);
+        pass_mask_shader_resources(mask, d3d10_array_get_element(pass->gs.shader, pass->gs.index),
+                D3D10_DST_GS_SAMPLERS, D3D10_DST_GS_SHADER_RESOURCES, D3D10_DST_GS_CONSTANT_BUFFERS);
+    }
     if (pass->rasterizer)
         D3D10StateBlockMaskEnableCapture(mask, D3D10_DST_RS_RASTERIZER_STATE, 0, 1);
     if (pass->depth_stencil)
@@ -6130,9 +6223,31 @@ static HRESULT STDMETHODCALLTYPE d3d10_effect_constant_buffer_GetRawValue(ID3D10
 static HRESULT STDMETHODCALLTYPE d3d10_effect_constant_buffer_SetConstantBuffer(ID3D10EffectConstantBuffer *iface,
