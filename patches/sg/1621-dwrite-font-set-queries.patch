+/* Stained Glass OS: the font set methods that were stubs. A set's fonts
+ * are looked up by file, face index and simulations; its property values
+ * are listed and counted; it is filtered by properties (all or any of
+ * them), by index, and by family and weight/stretch/style; a builder takes
+ * fonts with properties of their own and whole sets. They failed with
+ * E_NOTIMPL, which programs listing or matching fonts through font sets
+ * (and DirectWrite's own users above it) took as no fonts at all. */
+struct dwrite_stringlist
+{
+    IDWriteStringList IDWriteStringList_iface;
+    LONG refcount;
+    struct { WCHAR *locale; WCHAR *string; } *items;
+    size_t count;
+    size_t capacity;
+};
+
+static struct dwrite_stringlist *impl_from_IDWriteStringList(IDWriteStringList *iface)
+{
+    return CONTAINING_RECORD(iface, struct dwrite_stringlist, IDWriteStringList_iface);
+}
+
+static HRESULT WINAPI stringlist_QueryInterface(IDWriteStringList *iface, REFIID riid, void **obj)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualIID(riid, &IID_IDWriteStringList) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IDWriteStringList_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI stringlist_AddRef(IDWriteStringList *iface)
+{
+    struct dwrite_stringlist *list = impl_from_IDWriteStringList(iface);
+    return InterlockedIncrement(&list->refcount);
+}
+
+static ULONG WINAPI stringlist_Release(IDWriteStringList *iface)
+{
+    struct dwrite_stringlist *list = impl_from_IDWriteStringList(iface);
+    ULONG refcount = InterlockedDecrement(&list->refcount);
+    size_t i;
+
+    if (!refcount)
+    {
+        for (i = 0; i < list->count; ++i)
+        {
+            free(list->items[i].locale);
+            free(list->items[i].string);
+        }
+        free(list->items);
+        free(list);
+    }
+    return refcount;
+}
+
+static UINT32 WINAPI stringlist_GetCount(IDWriteStringList *iface)
+{
+    return impl_from_IDWriteStringList(iface)->count;
+}
+
+static HRESULT WINAPI stringlist_GetLocaleNameLength(IDWriteStringList *iface, UINT32 index, UINT32 *length)
+{
+    struct dwrite_stringlist *list = impl_from_IDWriteStringList(iface);
+
+    if (index >= list->count) { *length = 0; return E_INVALIDARG; }
+    *length = wcslen(list->items[index].locale);
+    return S_OK;
+}
+
+static HRESULT copy_list_string(const WCHAR *str, WCHAR *buffer, UINT32 size)
+{
+    if (size <= wcslen(str))
+    {
+        if (size) *buffer = 0;
+        return E_NOT_SUFFICIENT_BUFFER;
+    }
+    wcscpy(buffer, str);
+    return S_OK;
+}
+
+static HRESULT WINAPI stringlist_GetLocaleName(IDWriteStringList *iface, UINT32 index, WCHAR *name, UINT32 size)
+{
+    struct dwrite_stringlist *list = impl_from_IDWriteStringList(iface);
+
+    if (index >= list->count) { if (size) *name = 0; return E_INVALIDARG; }
+    return copy_list_string(list->items[index].locale, name, size);
+}
+
+static HRESULT WINAPI stringlist_GetStringLength(IDWriteStringList *iface, UINT32 index, UINT32 *length)
+{
+    struct dwrite_stringlist *list = impl_from_IDWriteStringList(iface);
+
+    if (index >= list->count) { *length = 0; return E_INVALIDARG; }
+    *length = wcslen(list->items[index].string);
+    return S_OK;
+}
+
+static HRESULT WINAPI stringlist_GetString(IDWriteStringList *iface, UINT32 index, WCHAR *string, UINT32 size)
+{
+    struct dwrite_stringlist *list = impl_from_IDWriteStringList(iface);
+
+    if (index >= list->count) { if (size) *string = 0; return E_INVALIDARG; }
+    return copy_list_string(list->items[index].string, string, size);
+}
+
+static const IDWriteStringListVtbl stringlistvtbl =
+{
+    stringlist_QueryInterface,
+    stringlist_AddRef,
+    stringlist_Release,
+    stringlist_GetCount,
+    stringlist_GetLocaleNameLength,
+    stringlist_GetLocaleName,
+    stringlist_GetStringLength,
+    stringlist_GetString,
+};
+
+/* adds a (locale, string) pair unless the string is already listed */
+static HRESULT stringlist_add(struct dwrite_stringlist *list, const WCHAR *locale, const WCHAR *string)
+{
+    size_t i;
+
+    for (i = 0; i < list->count; ++i)
+        if (!wcsicmp(list->items[i].string, string) && !wcsicmp(list->items[i].locale, locale)) return S_OK;
+    if (!dwrite_array_reserve((void **)&list->items, &list->capacity, list->count + 1, sizeof(*list->items)))
+        return E_OUTOFMEMORY;
+    list->items[list->count].locale = wcsdup(locale);
+    list->items[list->count].string = wcsdup(string);
+    list->count++;
+    return S_OK;
+}
+
+static BOOL fontset_entry_same_face(struct dwrite_fontset_entry *entry, IDWriteFontFile *file,
+        unsigned int face_index, unsigned int simulations)
