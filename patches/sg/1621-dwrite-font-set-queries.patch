+        if (SUCCEEDED(IDWriteLocalizedStrings_GetString(value, 0, number, ARRAY_SIZE(number))))
+            *fields[i] = wcstoul(number, NULL, 10);
+        IDWriteLocalizedStrings_Release(value);
+    }
+#ifndef SG_MUTANT_NO_FONT_DISTANCE
+    return (sy != style) * 100000 + abs((int)st - (int)stretch) * 1000 + abs((int)w - (int)weight);
+#else
+    return 0;
+#endif
