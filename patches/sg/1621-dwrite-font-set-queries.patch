+/* whether a font has a property value: every property it has can be asked */
+static BOOL fontset_entry_has_property(struct dwrite_fontset_entry *entry, DWRITE_FONT_PROPERTY const *prop)
+{
+    IDWriteLocalizedStrings *value;
+    BOOL ret;
+
+    if (!(prop->propertyId > DWRITE_FONT_PROPERTY_ID_NONE && prop->propertyId <= DWRITE_FONT_PROPERTY_ID_TYPOGRAPHIC_FACE_NAME))
+        return FALSE;
+    if (!(value = fontset_entry_get_property(entry, prop->propertyId))) return FALSE;
+    ret = localizedstrings_contains(value, prop->propertyValue);
+    IDWriteLocalizedStrings_Release(value);
+    return ret;
+}
