+static HRESULT fontset_get_property_values(struct dwrite_fontset *set, DWRITE_FONT_PROPERTY_ID id,
+        const WCHAR *preferred_locales, IDWriteStringList **values)
+{
+    WCHAR locale[LOCALE_NAME_MAX_LENGTH], string[256];
+    struct dwrite_stringlist *list;
+    IDWriteLocalizedStrings *strings;
+    unsigned int i, j, count, found;
+    BOOL exists;
+    HRESULT hr = S_OK;
+
+    *values = NULL;
+    if (!(id > DWRITE_FONT_PROPERTY_ID_NONE && id <= DWRITE_FONT_PROPERTY_ID_TYPOGRAPHIC_FACE_NAME))
+        return E_INVALIDARG;
+    if (!(list = calloc(1, sizeof(*list)))) return E_OUTOFMEMORY;
+    list->IDWriteStringList_iface.lpVtbl = &stringlistvtbl;
+    list->refcount = 1;
+
+    for (i = 0; i < set->count && SUCCEEDED(hr); ++i)
+    {
+        if (!(strings = fontset_entry_get_property(set->entries[i], id))) continue;
+        count = IDWriteLocalizedStrings_GetCount(strings);
+        if (preferred_locales)
+        {
+            /* one value per font: the first preferred locale it has, else
+             * English, else its first */
+            const WCHAR *p = preferred_locales;
+            found = ~0u;
+            while (*p && found == ~0u)
+            {
+                const WCHAR *end = wcschr(p, ';');
+                size_t len = end ? end - p : wcslen(p);
+
+                if (len && len < ARRAY_SIZE(locale))
+                {
+                    memcpy(locale, p, len * sizeof(WCHAR));
+                    locale[len] = 0;
+                    if (SUCCEEDED(IDWriteLocalizedStrings_FindLocaleName(strings, locale, &j, &exists)) && exists)
+                        found = j;
+                }
+                p += len + (end ? 1 : 0);
+            }
+            if (found == ~0u && (FAILED(IDWriteLocalizedStrings_FindLocaleName(strings, L"en-us", &found, &exists)) || !exists))
+                found = 0;
+            if (count && SUCCEEDED(IDWriteLocalizedStrings_GetLocaleName(strings, found, locale, ARRAY_SIZE(locale))) &&
+                    SUCCEEDED(IDWriteLocalizedStrings_GetString(strings, found, string, ARRAY_SIZE(string))))
+                hr = stringlist_add(list, locale, string);
+        }
+        else
+        {
+            for (j = 0; j < count && SUCCEEDED(hr); ++j)
+            {
+                if (SUCCEEDED(IDWriteLocalizedStrings_GetLocaleName(strings, j, locale, ARRAY_SIZE(locale))) &&
+                        SUCCEEDED(IDWriteLocalizedStrings_GetString(strings, j, string, ARRAY_SIZE(string))))
+                    hr = stringlist_add(list, locale, string);
+            }
+        }
+        IDWriteLocalizedStrings_Release(strings);
+    }
+    if (FAILED(hr))
+    {
+        IDWriteStringList_Release(&list->IDWriteStringList_iface);
+        return hr;
+    }
+    *values = &list->IDWriteStringList_iface;
+    return S_OK;
 }
 
