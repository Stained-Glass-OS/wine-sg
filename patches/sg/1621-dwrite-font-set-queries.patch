+static HRESULT fontset_builder_set_properties(struct dwrite_fontset_builder *builder,
+        DWRITE_FONT_PROPERTY const *props, unsigned int count)
+{
+    struct dwrite_fontset_entry *entry = builder->entries[builder->count - 1];
+    IDWriteLocalizedStrings *strings;
+    unsigned int i;
+    HRESULT hr;
+
+    for (i = 0; i < count; ++i)
+    {
+        DWRITE_FONT_PROPERTY_ID id = props[i].propertyId;
+
+        if (!(id > DWRITE_FONT_PROPERTY_ID_NONE && id <= DWRITE_FONT_PROPERTY_ID_TYPOGRAPHIC_FACE_NAME) ||
+                !props[i].propertyValue)
+            return E_INVALIDARG;
+        if (entry->props[id] && entry->props[id] != MISSING_SET_PROP) strings = entry->props[id];
+        else
+        {
+            if (FAILED(hr = create_localizedstrings(&strings))) return hr;
+            entry->props[id] = strings;
+        }
+        entry->given |= 1u << id;
+        if (FAILED(hr = add_localizedstring(strings, props[i].localeName ? props[i].localeName : L"",
+                props[i].propertyValue)))
+            return hr;
+    }
+    return S_OK;
+}
