+        unsigned int count, IDWriteFontSet1 **ret)
+{
+    struct dwrite_fontset *object;
+    struct dwrite_fontset_entry **entries = NULL;
+    unsigned int i;
+
+    *ret = NULL;
+    if (!(object = calloc(1, sizeof(*object)))) return E_OUTOFMEMORY;
+    if (count && !(entries = calloc(count, sizeof(*entries))))
+    {
+        free(object);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; ++i) entries[i] = addref_fontset_entry(picked[i]);
+    init_fontset(object, set->factory, entries, count);
+    *ret = (IDWriteFontSet1 *)&object->IDWriteFontSet3_iface;
+    return S_OK;
