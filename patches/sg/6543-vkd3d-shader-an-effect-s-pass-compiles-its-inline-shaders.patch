From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vkd3d-shader: An effect's pass compiles its inline shaders (6543)

A pass that names its shaders with CompileShader(), as in
SetVertexShader(CompileShader(vs_4_0, VS())), did not compile with fx_5_0
("Unsupported assignment type for state VertexShader", "Unhandled node
type for object-typed field"), and fx_4_0 wrote no shaders. Kodi's video
effects (yuv2rgb_d3d.fx, output_d3d.fx) are written that way: it could
not create its YUV to RGB shader and its video was black. Upstream vkd3d
has this from 1.19, on a reworked compiler.

Each inline shader is compiled from the effect's own preprocessed source
with the named function as the entry point and the call's profile (the
way fxc compiles it on its own), and written as an inline shader
assignment: its blob and stream output declaration for fx_4, the fx_5
shader record for fx_5; the header counts it among the shaders and the
inline shaders. The state's type must match the profile's. Calls with
uniform arguments and ConstructGSWithSO() remain fixmes.
---
diff --git a/libs/vkd3d/libs/vkd3d-shader/fx.c b/libs/vkd3d/libs/vkd3d-shader/fx.c
index e22177e..04a4f08 100644
--- a/libs/vkd3d/libs/vkd3d-shader/fx.c
+++ b/libs/vkd3d/libs/vkd3d-shader/fx.c
@@ -220,6 +220,7 @@ struct fx_write_context
     uint32_t rasterizer_state_count;
     uint32_t blend_state_count;
     uint32_t string_count;
+    uint32_t inline_shader_count;
     int status;
 
     bool child_effect;
@@ -550,6 +551,8 @@ enum fx_4_type_constants
     FX_4_ASSIGNMENT_VARIABLE = 0x2,
     FX_4_ASSIGNMENT_ARRAY_CONSTANT_INDEX = 0x3,
     FX_4_ASSIGNMENT_ARRAY_VARIABLE_INDEX = 0x4,
+    FX_4_ASSIGNMENT_INLINE_SHADER = 0x7,
+    FX_5_ASSIGNMENT_INLINE_SHADER = 0x8,
 };
 
 static const uint32_t fx_4_numeric_base_types[] =
@@ -1635,6 +1638,111 @@ static uint32_t write_fx_4_state_numeric_value(struct hlsl_ir_constant *value, s
     return offset;
 }
 
+/* The function a CompileShader() call names, or NULL with a fixme when the
+ * call is one we cannot compile on its own. */
+static const struct hlsl_ir_function_decl *get_compile_entry(struct hlsl_ctx *ctx,
+        const struct hlsl_ir_compile *compile, const struct vkd3d_shader_location *loc)
+{
+    const struct hlsl_ir_function_decl *decl;
+    size_t i;
+
+    if (compile->compile_type != HLSL_COMPILE_TYPE_COMPILE || !compile->args_count
+            || compile->args[0].node->type != HLSL_IR_CALL)
+    {
+        hlsl_fixme(ctx, loc, "Inline shaders other than CompileShader() are not implemented.");
+        return NULL;
+    }
+    decl = hlsl_ir_call(compile->args[0].node)->decl;
+    for (i = 0; i < decl->parameters.count; ++i)
+    {
+        if (decl->parameters.vars[i]->storage_modifiers & HLSL_STORAGE_UNIFORM)
+        {
+            hlsl_fixme(ctx, loc, "CompileShader() with uniform arguments is not implemented.");
+            return NULL;
+        }
+    }
+    return decl;
+}
+
+/* Compile the function a CompileShader() call names into a dxbc blob in the
+ * unstructured section and return the blob's offset, or 0 for none.  The
+ * shader is compiled from the effect's own preprocessed source with the
+ * function as its entry point and the call's profile, the way a separate
+ * compilation of that function would compile it. */
+static uint32_t write_fx_inline_shader_blob(const struct hlsl_ir_compile *compile,
+        const struct vkd3d_shader_location *loc, struct fx_write_context *fx)
+{
+    struct vkd3d_bytecode_buffer *buffer = &fx->unstructured;
+    struct vkd3d_shader_hlsl_source_info source_info = {0};
+    struct vkd3d_shader_compile_info info;
+    const struct hlsl_ir_function_decl *decl;
+    struct hlsl_ctx *ctx = fx->ctx;
+    struct vkd3d_shader_code blob;
+    uint32_t offset;
+    int ret;
+
+    if (!(decl = get_compile_entry(ctx, compile, loc)))
+        return 0;
+    if (!ctx->source || !ctx->compile_info)
+    {
+        hlsl_fixme(ctx, loc, "Inline shader without the effect source.");
+        return 0;
+    }
+
+    source_info.type = VKD3D_SHADER_STRUCTURE_TYPE_HLSL_SOURCE_INFO;
+    source_info.entry_point = decl->func->name;
+    source_info.profile = compile->profile->name;
+
+    info = *ctx->compile_info;
+    info.next = &source_info;
+    info.target_type = VKD3D_SHADER_TARGET_DXBC_TPF;
+
+#ifdef SG_MUTANT_FX_NO_INLINE_SHADERS
+    return 0;
+#endif
+    if ((ret = hlsl_compile_shader(ctx->source, &info, &blob, ctx->message_context)) < 0)
+    {
+        hlsl_error(ctx, loc, VKD3D_SHADER_ERROR_HLSL_INVALID_SYNTAX,
+                "Failed to compile the inline shader \"%s\" for profile %s.",
+                decl->func->name, compile->profile->name);
+        return 0;
+    }
+
+    offset = put_u32(buffer, blob.size);
+    bytecode_put_bytes_unaligned(buffer, blob.code, blob.size);
+    vkd3d_shader_free_shader_code(&blob);
+    return offset;
+}
+
+static uint32_t write_fx_inline_shader(const struct hlsl_ir_compile *compile,
+        const struct vkd3d_shader_location *loc, struct fx_write_context *fx)
+{
+    struct vkd3d_bytecode_buffer *buffer = &fx->unstructured;
+    uint32_t blob_offset, ret;
+    unsigned int i;
+
+    blob_offset = write_fx_inline_shader_blob(compile, loc, fx);
+
+    if (hlsl_version_lt(fx->ctx, 5, 0))
+    {
+        /* Shader blob, stream output declaration. */
+        ret = put_u32(buffer, blob_offset);
+        put_u32(buffer, 0);
+    }
+    else
+    {
+        /* Shader blob, four stream output declarations, their count, the
+         * rasterized stream, interface bindings count and offset. */
+        ret = put_u32(buffer, blob_offset);
+        for (i = 0; i < 8; ++i)
+            put_u32(buffer, 0);
+    }
+
+    ++fx->inline_shader_count;
+    ++fx->shader_count;
+    return ret;
+}
+
 static void write_fx_4_state_assignment(const struct hlsl_ir_var *var, struct hlsl_state_block_entry *entry,
         struct fx_write_context *fx)
 {
@@ -1729,6 +1837,13 @@ static void write_fx_4_state_assignment(const struct hlsl_ir_var *var, struct hl
             }
             break;
         }
+        case HLSL_IR_COMPILE:
+        {
+            assignment_type = hlsl_version_lt(ctx, 5, 0)
+                    ? FX_4_ASSIGNMENT_INLINE_SHADER : FX_5_ASSIGNMENT_INLINE_SHADER;
+            value_offset = write_fx_inline_shader(hlsl_ir_compile(value), &var->loc, fx);
+            break;
+        }
         default:
             hlsl_fixme(ctx, &var->loc, "Unsupported assignment type for state %s.", entry->name);
     }
@@ -2260,6 +2375,28 @@ static void resolve_fx_4_state_block_values(struct hlsl_ir_var *var, struct hlsl
 
                 break;
             }
+            case HLSL_IR_COMPILE:
+            {
+                const struct hlsl_ir_compile *compile = hlsl_ir_compile(node);
+                enum hlsl_type_class class = hlsl_type_class_from_fx_type(state->type);
+                bool match = false;
+
+                if (compile->compile_type != HLSL_COMPILE_TYPE_COMPILE)
+                    break;
+                switch (compile->profile->type)
+                {
+                    case VKD3D_SHADER_TYPE_VERTEX: match = class == HLSL_CLASS_VERTEX_SHADER; break;
+                    case VKD3D_SHADER_TYPE_PIXEL: match = class == HLSL_CLASS_PIXEL_SHADER; break;
+                    case VKD3D_SHADER_TYPE_HULL: match = class == HLSL_CLASS_HULL_SHADER; break;
+                    case VKD3D_SHADER_TYPE_DOMAIN: match = class == HLSL_CLASS_DOMAIN_SHADER; break;
+                    case VKD3D_SHADER_TYPE_COMPUTE: match = class == HLSL_CLASS_COMPUTE_SHADER; break;
+                    default: break;
+                }
+                if (!match)
+                    hlsl_error(ctx, &ctx->location, VKD3D_SHADER_ERROR_HLSL_INVALID_SYNTAX,
+                            "Type mismatch for the %s state value", entry->name);
+                break;
+            }
             default:
                 hlsl_fixme(ctx, &ctx->location, "Unhandled node type for object-typed field.");
         }
@@ -2775,7 +2912,7 @@ static int hlsl_fx_4_write(struct hlsl_ctx *ctx, struct vkd3d_shader_code *out)
     put_u32(&buffer, fx.rtv_count);
     put_u32(&buffer, fx.dsv_count);
     put_u32(&buffer, fx.shader_count);
-    put_u32(&buffer, 0); /* Inline shader count. */
+    put_u32(&buffer, fx.inline_shader_count);
 
     set_u32(&buffer, size_offset, fx.unstructured.size);
 
@@ -2833,7 +2970,7 @@ static int hlsl_fx_5_write(struct hlsl_ctx *ctx, struct vkd3d_shader_code *out)
     put_u32(&buffer, fx.rtv_count);
     put_u32(&buffer, fx.dsv_count);
     put_u32(&buffer, fx.shader_count);
-    put_u32(&buffer, 0); /* Inline shader count. */
+    put_u32(&buffer, fx.inline_shader_count);
     put_u32(&buffer, fx.group_count); /* Group count. */
     put_u32(&buffer, fx.uav_count);
     put_u32(&buffer, 0); /* Interface variables count. */
diff --git a/libs/vkd3d/libs/vkd3d-shader/hlsl.c b/libs/vkd3d/libs/vkd3d-shader/hlsl.c
index 96de18d..b7b027c 100644
--- a/libs/vkd3d/libs/vkd3d-shader/hlsl.c
+++ b/libs/vkd3d/libs/vkd3d-shader/hlsl.c
@@ -4545,6 +4545,8 @@ int hlsl_compile_shader(const struct vkd3d_shader_code *hlsl, const struct vkd3d
 
     if (!hlsl_ctx_init(&ctx, compile_info, profile, message_context))
         return VKD3D_ERROR_OUT_OF_MEMORY;
+    ctx.source = hlsl;
+    ctx.compile_info = compile_info;
 
     if ((ret = hlsl_lexer_compile(&ctx, hlsl)) == 2)
     {
diff --git a/libs/vkd3d/libs/vkd3d-shader/hlsl.h b/libs/vkd3d/libs/vkd3d-shader/hlsl.h
index 075c76c..ad88ca6 100644
--- a/libs/vkd3d/libs/vkd3d-shader/hlsl.h
+++ b/libs/vkd3d/libs/vkd3d-shader/hlsl.h
@@ -1034,6 +1034,11 @@ struct hlsl_ctx
      *   failure. */
     int result;
 
+    /* The preprocessed source and the compile info, so that an effect can
+     * compile the shaders its passes name with CompileShader(). */
+    const struct vkd3d_shader_code *source;
+    const struct vkd3d_shader_compile_info *compile_info;
+
     /* Pointer to an opaque data structure managed by FLEX (during lexing), that encapsulates the
      *   current state of the scanner. This pointer is required by all FLEX API functions when the
      *   scanner is declared as reentrant, which is the case. */
