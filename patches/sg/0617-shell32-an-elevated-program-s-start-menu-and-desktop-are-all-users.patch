From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: an elevated program's Start menu and desktop are all users'

The elevation broker runs a program as the SYSTEM account, not as the user
who asked (Windows' elevation keeps the user). An installer's own-user
shortcuts went to SYSTEM's Start menu and desktop, which nobody sees:
Blender, Temurin, Audacity and Winamp were not in Start. In a program the
broker started (SG_IN_BROKER), the Programs, Start menu, Startup and desktop
folders are the ones all users share.
---
--- a/dlls/shell32/shellpath.c
+++ b/dlls/shell32/shellpath.c
@@ -2946,6 +2946,31 @@
         return E_INVALIDARG;
     if ((SHGFP_TYPE_CURRENT != dwFlags) && (SHGFP_TYPE_DEFAULT != dwFlags))
         return E_INVALIDARG;
+    /* Stained Glass OS: a program the elevation broker started runs as the
+     * SYSTEM account, not as the user who asked (as Windows' elevation
+     * does): its own Start menu and desktop are SYSTEM's, which nobody sees.
+     * An installer's shortcuts went there (Blender, Temurin, Audacity,
+     * Winamp: not in Start). Its Start menu, programs, startup and desktop
+     * are the ones all users share. */
+    if (!hToken && GetEnvironmentVariableW( L"SG_IN_BROKER", NULL, 0 ))
+    {
+        static const BYTE common[][2] =
+        {
+            { CSIDL_PROGRAMS, CSIDL_COMMON_PROGRAMS },
+            { CSIDL_STARTMENU, CSIDL_COMMON_STARTMENU },
+            { CSIDL_STARTUP, CSIDL_COMMON_STARTUP },
+            { CSIDL_DESKTOPDIRECTORY, CSIDL_COMMON_DESKTOPDIRECTORY },
+            { CSIDL_DESKTOP, CSIDL_COMMON_DESKTOPDIRECTORY },
+        };
+        unsigned int i;
+        for (i = 0; i < ARRAY_SIZE(common); i++)
+            if (folder == common[i][0])
+            {
+                TRACE( "elevated: folder %#lx is all users' %#x\n", folder, common[i][1] );
+                folder = common[i][1];
+                break;
+            }
+    }
     szTemp[0] = 0;
     type = CSIDL_Data[folder].type;
     switch (type)
