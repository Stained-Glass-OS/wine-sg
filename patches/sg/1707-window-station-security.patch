From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, advapi32: window stations and desktops belong to their session's user

With a session for each user (1706), a user's WinSta0 and desktops were
still open to everyone: another user's program could open them by their
\Sessions\N path and read the clipboard, put windows on the desktop or hook
it. Windows gives an interactive window station and its desktops a
descriptor naming the logon. Now, in a shared prefix:

- A new window station or desktop is owned by its creator. SYSTEM and the
  session's user have full access, the creator too, and Administrators
  may read it; nobody else may open it (ACCESS_DENIED). The rights are the
  object type's own, as Windows stores them: WINSTA_ALL_ACCESS | standard
  rights and its read set (0x20303), DESKTOP_ALL_ACCESS | standard rights
  and its read set (0x20041).
- SYSTEM has the default session to itself, as services have session 0 on
  Windows; users get sessions 2, 3 and so on (1706 had the first user share
  session 1 with SYSTEM). So a window station SYSTEM made first, such as
  the lock screen's, is never one a user needs.
- SetSecurityInfo on SE_WINDOW_OBJECT sets the descriptor
  (NtSetSecurityObject, as SetUserObjectSecurity does), and on SE_SERVICE
  goes through SetServiceObjectSecurity. Both used to say they had set it
  without setting anything.

Single-user prefixes are unchanged.

Gate: test/winstasd-gate.sh (sgsystem, sgtest1, sgtest2 against one
machine wineserver). Mutants SG_MUTANT_OPEN_WINSTATIONS,
SG_MUTANT_SETSECINFO_WINDOW_NOOP.
---
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -3624,6 +3624,24 @@ DWORD WINAPI SetSecurityInfo(HANDLE handle, SE_OBJECT_TYPE ObjectType,
         status = NtSetSecurityObject(handle, SecurityInfo, &sd);
         break;
 
+#ifndef SG_MUTANT_SETSECINFO_WINDOW_NOOP
+    /* Stained Glass OS (1707): a window station's or desktop's descriptor is
+     * its own (SetUserObjectSecurity), and a service's the SCM's; both were
+     * reported set without anything set */
+    case SE_WINDOW_OBJECT:
+        status = NtSetSecurityObject(handle, SecurityInfo, &sd);
+        break;
+
+    case SE_SERVICE:
+        if (!SetServiceObjectSecurity(handle, SecurityInfo, &sd))
+        {
+            if (dacl != pDacl) free(dacl);
+            return GetLastError();
+        }
+        status = STATUS_SUCCESS;
+        break;
+#endif
+
     case SE_REGISTRY_WOW64_32KEY:
     case SE_REGISTRY_WOW64_64KEY:
     case SE_REGISTRY_KEY:
--- a/server/process.c
+++ b/server/process.c
@@ -978,29 +978,43 @@ static int startup_info_signaled( struct object *obj, struct wait_queue_entry *e
  * BaseNamedObjects (Local\), window stations and desktops, so users logged on
  * at once do not share WinSta0, see each other's windows or open each other's
  * Local\ objects. SYSTEM (root, the prefix's owner) keeps the default session,
- * as it always had, and the first user to appear shares it; later users get
- * the next ones, kept for the server's life. Global\ objects are shared, as on
+ * as it always had, and has it to itself, as services have session 0 on
+ * Windows (1707: a user's window station is that user's alone); users get the
+ * next ones, kept for the server's life. Global\ objects are shared, as on
  * Windows. */
+static struct { uid_t uid; unsigned int id; } session_map[200];
+static unsigned int session_count;
+
 unsigned int sg_session_for_uid( uid_t uid )
 {
-    static struct { uid_t uid; unsigned int id; } map[200];
-    static unsigned int count, next = default_session_id;
+    static unsigned int next = default_session_id + 1;
     unsigned int i, id;
 
 #ifdef SG_MUTANT_ONE_SESSION
     return default_session_id;
 #endif
     if (!sg_system_prefix || !uid || uid == sg_system_prefix_uid) return default_session_id;
-    for (i = 0; i < count; i++) if (map[i].uid == uid) return map[i].id;
-    if (count == ARRAY_SIZE(map)) return default_session_id;
+    for (i = 0; i < session_count; i++) if (session_map[i].uid == uid) return session_map[i].id;
+    if (session_count == ARRAY_SIZE(session_map)) return default_session_id;
     id = next++;
-    map[count].uid = uid;
-    map[count].id = id;
-    count++;
+    session_map[session_count].uid = uid;
+    session_map[session_count].id = id;
+    session_count++;
     sg_create_session( id );
     return id;
 }
 
+/* the user a session (sg_session_for_uid) belongs to; 0 for one no user has
+ * (SYSTEM's, the default session) */
+int sg_session_user( unsigned int id, uid_t *uid )
+{
+    unsigned int i;
+
+    for (i = 0; i < session_count; i++)
+        if (session_map[i].id == id) { *uid = session_map[i].uid; return 1; }
+    return 0;
+}
+
 /* get a process from an id (and increment the refcount) */
 struct process *get_process_from_id( process_id_t id )
 {
--- a/server/process.h
+++ b/server/process.h
@@ -150,5 +150,6 @@ static inline int is_process_init_done( struct process *process )
 static const unsigned int default_session_id = 1;
 extern void sg_create_session( unsigned int id );
 extern unsigned int sg_session_for_uid( uid_t uid );
+extern int sg_session_user( unsigned int id, uid_t *uid );
 
 #endif  /* __WINE_SERVER_PROCESS_H */
--- a/server/security.h
+++ b/server/security.h
@@ -59,6 +59,8 @@ extern void sg_ensure_user_hive( uid_t uid );
 extern int sg_requester_is_admin(void);
 extern int sg_token_same_user( struct token *a, struct token *b );
 extern struct security_descriptor *sg_create_owner_sd( const struct sid *user_sid );
+extern struct security_descriptor *sg_create_session_object_sd( const struct sid *creator, const struct sid *session_user,
+                                                                unsigned int all_access, unsigned int read_access );
 extern const struct sid local_system_sid;
 extern const struct sid builtin_users_sid;
 extern const struct sid builtin_admins_sid;
--- a/server/token.c
+++ b/server/token.c
@@ -609,6 +609,53 @@ struct security_descriptor *sg_create_owner_sd( const struct sid *user_sid )
     return sd;
 }
 
+/* Stained Glass OS (1707): the security descriptor Windows gives an
+ * interactive window station or desktop: SYSTEM and the session's user (the
+ * logon) have full access, the creator too, Administrators may read (and so
+ * enumerate) it, and nobody else may open it at all -- another user's
+ * programs can neither put windows on it, read its clipboard nor hook it. The
+ * owner is the creator. The rights are the object type's own, as Windows
+ * stores them (its GENERIC_ALL and GENERIC_READ mapped). */
+struct security_descriptor *sg_create_session_object_sd( const struct sid *creator, const struct sid *session_user,
+                                                         unsigned int all_access, unsigned int read_access )
+{
+    struct sid alias_admins_sid = { SID_REVISION, 2, SECURITY_NT_AUTHORITY, { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS }};
+    const struct sid *owner = creator ? creator : &local_system_sid;
+    int own = creator && !equal_sid( creator, &local_system_sid );
+    int user = session_user && !equal_sid( session_user, &local_system_sid ) && !(own && equal_sid( session_user, creator ));
+    unsigned int count = 2 + own + user;
+    struct security_descriptor *sd;
+    size_t owner_len = sid_len( owner );
+    size_t group_len = sid_len( &domain_users_sid );
+    size_t dacl_len = sizeof(struct acl) + count * sizeof(struct ace) +
+                      sid_len( &local_system_sid ) + sid_len( &alias_admins_sid ) +
+                      (own ? sid_len( creator ) : 0) + (user ? sid_len( session_user ) : 0);
+    struct acl *dacl;
+    struct ace *ace;
+    char *ptr;
+
+    if (!(sd = mem_alloc( sizeof(*sd) + owner_len + group_len + dacl_len ))) return NULL;
+    sd->control   = SE_DACL_PRESENT;
+    sd->owner_len = owner_len;
+    sd->group_len = group_len;
+    sd->sacl_len  = 0;
+    sd->dacl_len  = dacl_len;
+    ptr = (char *)(sd + 1);
+    copy_sid( (struct sid *)ptr, owner ); ptr += owner_len;
+    copy_sid( (struct sid *)ptr, &domain_users_sid ); ptr += group_len;
+    dacl = (struct acl *)ptr;
+    dacl->revision = ACL_REVISION;
+    dacl->pad1     = 0;
+    dacl->size     = dacl_len;
+    dacl->count    = count;
+    dacl->pad2     = 0;
+    ace = set_ace( ace_first( dacl ), &local_system_sid, ACCESS_ALLOWED_ACE_TYPE, 0, all_access );
+    ace = set_ace( ace_next( ace ), &alias_admins_sid, ACCESS_ALLOWED_ACE_TYPE, 0, read_access );
+    if (own) ace = set_ace( ace_next( ace ), creator, ACCESS_ALLOWED_ACE_TYPE, 0, all_access );
+    if (user) set_ace( ace_next( ace ), session_user, ACCESS_ALLOWED_ACE_TYPE, 0, all_access );
+    return sd;
+}
+
 /* Stained Glass OS (multi-user debt D17): in a prefix shared between Unix
  * users, the server's token requests are a privilege boundary. Upstream Wine
  * mints tokens for anyone who asks -- every process there is its user's
--- a/server/winstation.c
+++ b/server/winstation.c
@@ -132,6 +132,29 @@ static const struct object_ops desktop_ops =
     desktop_destroy               /* destroy */
 };
 
+/* Stained Glass OS (1707): in a shared prefix a window station or desktop is
+ * its session's user's (and SYSTEM's), as on Windows, where winlogon gives the
+ * logon's interactive window station and desktops such a descriptor; see
+ * sg_create_session_object_sd. Without it any user could open another's
+ * WinSta0 by its \Sessions\N path and read its clipboard, put windows on its
+ * desktop or hook it. */
+static void sg_set_session_object_sd( struct object *obj, const struct type_descr *type )
+{
+    struct security_descriptor *sd;
+    const struct sid *creator = NULL, *user = NULL;
+    uid_t uid;
+
+#ifdef SG_MUTANT_OPEN_WINSTATIONS
+    return;
+#endif
+    if (!sg_system_prefix || !current) return;
+    if (current->process->token) creator = token_get_user( current->process->token );
+    if (sg_session_user( current->process->session_id, &uid )) user = security_unix_uid_to_sid( uid );
+    if (!(sd = sg_create_session_object_sd( creator, user, type->mapping.all, type->mapping.read ))) return;
+    free( obj->sd );
+    obj->sd = sd;
+}
+
 /* create a winstation object */
 static struct winstation *create_winstation( struct object *root, const struct unicode_str *name,
                                              unsigned int attr, unsigned int flags )
@@ -143,6 +166,7 @@ static struct winstation *create_winstation( struct object *root, const struct u
         if (get_error() != STATUS_OBJECT_NAME_EXISTS)
         {
             /* initialize it if it didn't already exist */
+            sg_set_session_object_sd( &winstation->obj, &winstation_type );
             winstation->flags = flags;
             winstation->input_desktop = NULL;
             winstation->clipboard = NULL;
@@ -286,6 +310,7 @@ static struct desktop *create_desktop( const struct unicode_str *name, unsigned
                 release_object( current_desktop );
             }
 
+            sg_set_session_object_sd( &desktop->obj, &desktop_type );
             desktop->winstation = (struct winstation *)grab_object( winstation );
             desktop->top_window = NULL;
             desktop->msg_window = NULL;
