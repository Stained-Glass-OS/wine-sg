+ */
+
+/*
+ * Stained Glass OS (wine-sg 9104): WMCreateWriterFileSink was a stub, so programs that give the
+ * writer a file sink of their own (IWMWriterAdvanced::AddSink) -- fre:ac's WMA encoder, the SDK's
+ * WMVCopy/UncompAVIToWMV pattern -- died on the call. The file sink writes the header the writer
+ * hands it and then each data unit (packet) to its file. At the end the writer gives it the final
+ * header (file size, packet count, durations) and the index, which it writes in place and at the
+ * end; with auto-indexing off it leaves the index out. Start/Stop take the data units whose send
+ * times fall between the two times; Close closes the file, after which data units are dropped;
+ * a second Open moves the output to a new file, which starts with the header.
+ */
+
+#include "wmvcore_private.h"
+#include "wmsdk.h"
+#include "nserror.h"
+#include "asferr.h"
+#include "profile.h"
+#include "asf.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wmvcore);
+
+struct file_sink
+{
+    IWMWriterFileSink3 IWMWriterFileSink3_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+
+    HANDLE file;
+    BOOL closed;            /* Close was called: nothing more goes to the file */
+    BYTE *header;           /* the header unit, for a file opened after it came */
+    DWORD header_size;
+    BOOL header_on_file;
+    UINT64 size;            /* bytes on the file */
+    UINT64 first_send, last_send;   /* 100 ns, of the data units written */
+    BOOL any_unit;
+    UINT64 start_time, stop_time;
+    BOOL stopped;
+    BOOL auto_index;
+    BOOL unbuffered, restrict_memory;
+};
+
+static const IWMWriterFileSink3Vtbl file_sink_vtbl;
+
+static inline struct file_sink *impl_from_IWMWriterFileSink3(IWMWriterFileSink3 *iface)
+{
+    return CONTAINING_RECORD(iface, struct file_sink, IWMWriterFileSink3_iface);
+}
+
+static HRESULT WINAPI sink_QueryInterface(IWMWriterFileSink3 *iface, REFIID iid, void **out)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p, iid %s, out %p.\n", sink, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWMWriterSink)
+            || IsEqualGUID(iid, &IID_IWMWriterFileSink) || IsEqualGUID(iid, &IID_IWMWriterFileSink2)
+            || IsEqualGUID(iid, &IID_IWMWriterFileSink3))
+    {
+        IWMWriterFileSink3_AddRef(*out = &sink->IWMWriterFileSink3_iface);
+        return S_OK;
+    }
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI sink_AddRef(IWMWriterFileSink3 *iface)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+    ULONG ref = InterlockedIncrement(&sink->ref);
+    TRACE("%p increasing refcount to %lu.\n", sink, ref);
+    return ref;
+}
+
+static void sink_close_file(struct file_sink *sink)
+{
+    if (sink->file != INVALID_HANDLE_VALUE)
+    {
+        CloseHandle(sink->file);
+        sink->file = INVALID_HANDLE_VALUE;
+    }
+}
+
+static ULONG WINAPI sink_Release(IWMWriterFileSink3 *iface)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+    ULONG ref = InterlockedDecrement(&sink->ref);
+
+    TRACE("%p decreasing refcount to %lu.\n", sink, ref);
+
+    if (!ref)
+    {
+        sink_close_file(sink);
+        free(sink->header);
+        sink->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&sink->cs);
+        free(sink);
+    }
+    return ref;
+}
+
+static HRESULT write_at(struct file_sink *sink, UINT64 offset, const void *data, DWORD size)
+{
+    LARGE_INTEGER at;
+    DWORD written;
+
+    at.QuadPart = offset;
+    if (!SetFilePointerEx(sink->file, at, NULL, FILE_BEGIN)
+            || !WriteFile(sink->file, data, size, &written, NULL) || written != size)
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (offset + size > sink->size) sink->size = offset + size;
+    return S_OK;
+}
+
+static HRESULT write_header(struct file_sink *sink)
+{
+    HRESULT hr;
+
+    if (sink->file == INVALID_HANDLE_VALUE || !sink->header || sink->header_on_file) return S_OK;
+    if (SUCCEEDED(hr = write_at(sink, 0, sink->header, sink->header_size)))
+        sink->header_on_file = TRUE;
+    return hr;
+}
+
+static HRESULT WINAPI sink_OnHeader(IWMWriterFileSink3 *iface, INSSBuffer *header)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+    DWORD length;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("sink %p, header %p.\n", sink, header);
+
+    if (!header) return E_POINTER;
+    if (FAILED(hr = INSSBuffer_GetBufferAndLength(header, &data, &length))) return hr;
+
+    EnterCriticalSection(&sink->cs);
+    free(sink->header);
+    if (!(sink->header = malloc(max(length, 1))))
+    {
+        sink->header_size = 0;
+        LeaveCriticalSection(&sink->cs);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(sink->header, data, length);
+    sink->header_size = length;
+    sink->header_on_file = FALSE;
+    sink->size = 0;
+    sink->any_unit = FALSE;
+    sink->stopped = FALSE;
+    hr = sink->closed ? S_OK : write_header(sink);
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_IsRealTime(IWMWriterFileSink3 *iface, BOOL *realtime)
+{
+    TRACE("iface %p, realtime %p.\n", iface, realtime);
+
+    if (!realtime) return E_POINTER;
+    *realtime = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_AllocateDataUnit(IWMWriterFileSink3 *iface, DWORD size, INSSBuffer **unit)
+{
+    TRACE("iface %p, size %lu, unit %p.\n", iface, size, unit);
+
+    if (!unit) return E_POINTER;
+    return wm_buffer_create(size, unit);
+}
+
+/* the send time of an ASF data packet (its payload parsing information), in 100 ns */
+static BOOL packet_send_time(const BYTE *data, DWORD size, UINT64 *time)
+{
+    static const BYTE field_size[4] = { 0, 1, 2, 4 };
+    DWORD pos = 0, send;
+    BYTE flags, properties;
+
+    if (!size) return FALSE;
+    if (data[0] & 0x80)
+    {
+        /* error correction data: its length in the low four bits */
+        pos = 1 + (data[0] & 0x0f);
+    }
+    if (pos + 2 > size) return FALSE;
+    flags = data[pos++];
+    properties = data[pos++];
+    pos += field_size[(flags >> 5) & 3];        /* packet length */
+    pos += field_size[(flags >> 1) & 3];        /* sequence */
+    pos += field_size[(flags >> 3) & 3];        /* padding length */
+    if (pos + 6 > size) return FALSE;
+    (void)properties;
+    memcpy(&send, data + pos, 4);
+    *time = (UINT64)send * 10000;
+    return TRUE;
+}
+
+static HRESULT sink_write_unit(struct file_sink *sink, const BYTE *data, DWORD size, UINT64 send, BOOL timed)
+{
+    HRESULT hr;
+
+    if (sink->closed || sink->file == INVALID_HANDLE_VALUE) return S_OK;
+    if (timed)
+    {
+        if (send < sink->start_time) return S_OK;
+        if (send >= sink->stop_time)
+        {
+            sink->stopped = TRUE;
+            return S_OK;
+        }
+    }
+    if (FAILED(hr = write_header(sink))) return hr;
+    if (FAILED(hr = write_at(sink, sink->size, data, size))) return hr;
+    if (timed)
+    {
+        if (!sink->any_unit) sink->first_send = send;
+        sink->last_send = max(sink->last_send, send);
+        sink->any_unit = TRUE;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_OnDataUnit(IWMWriterFileSink3 *iface, INSSBuffer *unit)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+    UINT64 send = 0;
+    DWORD length;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("sink %p, unit %p.\n", sink, unit);
+
+    if (!unit) return E_POINTER;
+    if (FAILED(hr = INSSBuffer_GetBufferAndLength(unit, &data, &length))) return hr;
+
+    EnterCriticalSection(&sink->cs);
+    hr = sink_write_unit(sink, data, length, send, packet_send_time(data, length, &send));
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_OnEndWriting(IWMWriterFileSink3 *iface)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p.\n", sink);
+
+    EnterCriticalSection(&sink->cs);
+    sink_close_file(sink);
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_Open(IWMWriterFileSink3 *iface, const WCHAR *filename)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+    HANDLE file;
+    HRESULT hr;
+
+    TRACE("sink %p, filename %s.\n", sink, debugstr_w(filename));
+
+    if (!filename) return E_POINTER;
+    if (!*filename) return E_INVALIDARG;
+
+    file = CreateFileW(filename, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ, NULL, CREATE_ALWAYS,
+            FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        WARN("%s: %#lx.\n", debugstr_w(filename), hr);
+        return hr;
+    }
+
+    EnterCriticalSection(&sink->cs);
+    /* a new file: the output moves there, starting with the header */
+    sink_close_file(sink);
+    sink->file = file;
+    sink->closed = FALSE;
+    sink->size = 0;
+    sink->any_unit = FALSE;
+    sink->header_on_file = FALSE;
+    hr = write_header(sink);
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_Start(IWMWriterFileSink3 *iface, QWORD start_time)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p, start_time %s.\n", sink, debugstr_time(start_time));
+
+    EnterCriticalSection(&sink->cs);
+    sink->start_time = start_time;
+    sink->stop_time = ~(UINT64)0;
+    sink->stopped = FALSE;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_Stop(IWMWriterFileSink3 *iface, QWORD stop_time)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p, stop_time %s.\n", sink, debugstr_time(stop_time));
+
+    EnterCriticalSection(&sink->cs);
+    sink->stop_time = stop_time;
+    if (sink->any_unit && sink->last_send >= stop_time) sink->stopped = TRUE;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_IsStopped(IWMWriterFileSink3 *iface, BOOL *stopped)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p, stopped %p.\n", sink, stopped);
+
+    if (!stopped) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    *stopped = sink->stopped;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_GetFileDuration(IWMWriterFileSink3 *iface, QWORD *duration)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p, duration %p.\n", sink, duration);
+
+    if (!duration) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    *duration = sink->any_unit ? sink->last_send - sink->first_send : 0;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_GetFileSize(IWMWriterFileSink3 *iface, QWORD *size)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p, size %p.\n", sink, size);
+
+    if (!size) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    *size = sink->size;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_Close(IWMWriterFileSink3 *iface)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p.\n", sink);
+
+    EnterCriticalSection(&sink->cs);
+    sink_close_file(sink);
+    sink->closed = TRUE;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_IsClosed(IWMWriterFileSink3 *iface, BOOL *closed)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p, closed %p.\n", sink, closed);
+
+    if (!closed) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    *closed = sink->closed;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_SetAutoIndexing(IWMWriterFileSink3 *iface, BOOL auto_index)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p, auto_index %d.\n", sink, auto_index);
+
+    EnterCriticalSection(&sink->cs);
+    sink->auto_index = !!auto_index;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_GetAutoIndexing(IWMWriterFileSink3 *iface, BOOL *auto_index)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p, auto_index %p.\n", sink, auto_index);
+
+    if (!auto_index) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    *auto_index = sink->auto_index;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_SetControlStream(IWMWriterFileSink3 *iface, WORD stream, BOOL control)
+{
+    TRACE("iface %p, stream %u, control %d.\n", iface, stream, control);
+
+    /* Start and Stop go by the packets' send times, whichever stream they carry */
+    if (!stream || stream > 127) return E_INVALIDARG;
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_GetMode(IWMWriterFileSink3 *iface, DWORD *mode)
+{
+    TRACE("iface %p, mode %p.\n", iface, mode);
+
+    if (!mode) return E_POINTER;
+    *mode = WMT_FM_SINGLE_BUFFERS | WMT_FM_FILESINK_DATA_UNITS;
+    return S_OK;
+}
+
+static HRESULT append_segment(struct asf_buffer *out, const WMT_BUFFER_SEGMENT *segment)
+{
+    DWORD length;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!segment->pBuffer) return E_POINTER;
+    if (FAILED(hr = INSSBuffer_GetBufferAndLength(segment->pBuffer, &data, &length))) return hr;
+    if (segment->cbOffset > length || segment->cbLength > length - segment->cbOffset) return E_INVALIDARG;
+    asf_put(out, data + segment->cbOffset, segment->cbLength);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_OnDataUnitEx(IWMWriterFileSink3 *iface, WMT_FILESINK_DATA_UNIT *unit)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+    struct asf_buffer out = { 0 };
+    UINT64 send = 0;
+    DWORD i, j;
+    HRESULT hr;
+
+    TRACE("sink %p, unit %p.\n", sink, unit);
+
+    if (!unit) return E_POINTER;
+    /* the packet header, then each payload's header followed by its data fragments */
+    if (FAILED(hr = append_segment(&out, &unit->packetHeaderBuffer))) goto done;
+    for (i = 0; i < unit->cPayloads; i++)
+    {
+        if (FAILED(hr = append_segment(&out, &unit->pPayloadHeaderBuffers[i]))) goto done;
+        for (j = 0; j < unit->cPayloadDataFragments; j++)
+            if (unit->pPayloadDataFragments[j].dwPayloadIndex == i
+                    && FAILED(hr = append_segment(&out, &unit->pPayloadDataFragments[j].segmentData)))
+                goto done;
+    }
+    if (out.failed)
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    EnterCriticalSection(&sink->cs);
+    hr = sink_write_unit(sink, out.data, out.size, send, packet_send_time(out.data, out.size, &send));
+    LeaveCriticalSection(&sink->cs);
+
+done:
+    free(out.data);
+    return hr;
+}
+
+static HRESULT WINAPI sink_SetUnbufferedIO(IWMWriterFileSink3 *iface, BOOL unbuffered, BOOL restrict_memory)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p, unbuffered %d, restrict_memory %d.\n", sink, unbuffered, restrict_memory);
+
+    EnterCriticalSection(&sink->cs);
+    sink->unbuffered = !!unbuffered;
+    sink->restrict_memory = !!restrict_memory;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_GetUnbufferedIO(IWMWriterFileSink3 *iface, BOOL *unbuffered)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p, unbuffered %p.\n", sink, unbuffered);
+
+    if (!unbuffered) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    *unbuffered = sink->unbuffered;
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_CompleteOperations(IWMWriterFileSink3 *iface)
+{
+    struct file_sink *sink = impl_from_IWMWriterFileSink3(iface);
+
+    TRACE("sink %p.\n", sink);
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->file != INVALID_HANDLE_VALUE) FlushFileBuffers(sink->file);
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static const IWMWriterFileSink3Vtbl file_sink_vtbl =
+{
+    sink_QueryInterface,
+    sink_AddRef,
+    sink_Release,
+    sink_OnHeader,
+    sink_IsRealTime,
+    sink_AllocateDataUnit,
+    sink_OnDataUnit,
+    sink_OnEndWriting,
+    sink_Open,
+    sink_Start,
+    sink_Stop,
+    sink_IsStopped,
+    sink_GetFileDuration,
+    sink_GetFileSize,
+    sink_Close,
+    sink_IsClosed,
+    sink_SetAutoIndexing,
+    sink_GetAutoIndexing,
+    sink_SetControlStream,
+    sink_GetMode,
+    sink_OnDataUnitEx,
+    sink_SetUnbufferedIO,
+    sink_GetUnbufferedIO,
+    sink_CompleteOperations,
+};
+
+/* The end of writing (asfmux.c): a file sink of ours gets the final header -- the header unit as
+ * it first came, with the counts and durations filled in, the same size -- and the index objects,
+ * which go after the data. S_FALSE for a sink of the program's own. */
+HRESULT file_sink_finish(IWMWriterSink *iface, const BYTE *header, DWORD header_size,
+        const BYTE *index, DWORD index_size)
+{
+    struct file_sink *sink;
+    HRESULT hr = S_OK;
+
+    if (iface->lpVtbl != (const IWMWriterSinkVtbl *)&file_sink_vtbl) return S_FALSE;
+    sink = impl_from_IWMWriterFileSink3((IWMWriterFileSink3 *)iface);
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->closed || sink->file == INVALID_HANDLE_VALUE || !sink->header_on_file)
+    {
+        LeaveCriticalSection(&sink->cs);
+        return S_OK;
+    }
+#ifndef SG_MUTANT_FILESINK_NO_FINISH
+    if (sink->auto_index && index_size)
+        hr = write_at(sink, sink->size, index, index_size);
+    /* only a file that holds the whole session gets the final counts: one that started later
+     * (Open again, Start after the beginning) keeps the header it was given */
+    if (SUCCEEDED(hr) && header_size == sink->header_size && !sink->start_time
+            && sink->stop_time == ~(UINT64)0)
+        hr = write_at(sink, 0, header, header_size);
+#endif
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+HRESULT WINAPI WMCreateWriterFileSink(IWMWriterFileSink **out)
+{
+    struct file_sink *sink;
+
+    TRACE("out %p.\n", out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(sink = calloc(1, sizeof(*sink)))) return E_OUTOFMEMORY;
+    sink->IWMWriterFileSink3_iface.lpVtbl = &file_sink_vtbl;
+    sink->ref = 1;
+    sink->file = INVALID_HANDLE_VALUE;
+    sink->auto_index = TRUE;
+    sink->stop_time = ~(UINT64)0;
+    InitializeCriticalSectionEx(&sink->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    sink->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": file_sink.cs");
+    *out = (IWMWriterFileSink *)&sink->IWMWriterFileSink3_iface;
+    TRACE("Created file sink %p.\n", sink);
+    return S_OK;
+}
