+/* /R: the directory and everything below it */
+static void search_tree(const WCHAR *dir, const WCHAR *pattern)
+{
+    WCHAR glob[MAX_PATH], sub[MAX_PATH];
+    WIN32_FIND_DATAW fd;
+    HANDLE handle;
+
+    search(dir, pattern);
+    if (wcslen(dir) + 3 > ARRAY_SIZE(glob)) return;
+    wcscpy(glob, dir);
+    wcscat(glob, L"\\*");
+    if ((handle = FindFirstFileExW(glob, FindExInfoBasic, &fd, 0, NULL, 0)) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || (fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT)) continue;
+        if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L"..")) continue;
+        if (PathCombineW(sub, dir, fd.cFileName)) search_tree(sub, pattern);
+    }
+    while (FindNextFileW(handle, &fd));
+    FindClose(handle);
+}
