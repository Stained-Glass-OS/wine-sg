+/* WM_SETHOTKEY: LOBYTE the virtual key, HIBYTE HOTKEYF_SHIFT/CONTROL/ALT/EXT.
+ * 1: set; 2: set, but another window has the same hot key; 0: a child
+ * window; -1: a key that cannot be a hot key. */
+static LRESULT set_window_hotkey( HWND hwnd, WPARAM wparam )
+{
+    UINT vk = LOBYTE(wparam), keys = HIBYTE(LOWORD(wparam)), mods = 0;
+    LRESULT ret = 1;
+
+    if (get_window_long( hwnd, GWL_STYLE ) & WS_CHILD) return 0;
+    if (vk == VK_ESCAPE || vk == VK_SPACE || vk == VK_TAB) return -1;
+
+    NtUserUnregisterHotKey( hwnd, SG_WINDOW_HOTKEY_ID );
+    NtUserRemoveProp( hwnd, hotkey_propW );
+    if (!vk) return 1;  /* removed */
+
+    if (keys & 0x01 /* HOTKEYF_SHIFT */) mods |= MOD_SHIFT;
+    if (keys & 0x02 /* HOTKEYF_CONTROL */) mods |= MOD_CONTROL;
+    if (keys & 0x04 /* HOTKEYF_ALT */) mods |= MOD_ALT;
+    if (!NtUserRegisterHotKey( hwnd, SG_WINDOW_HOTKEY_ID, mods | MOD_NOREPEAT, vk ))
+    {
+        if (RtlGetLastWin32Error() != ERROR_HOTKEY_ALREADY_REGISTERED) return -1;
+        ret = 2;  /* another window has it: kept, and the other wins */
+    }
+    NtUserSetProp( hwnd, hotkey_propW, ULongToHandle( LOWORD(wparam) ) );
+    return ret;
+}
