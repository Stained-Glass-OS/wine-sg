+/* Stained Glass OS 1657: SEE_MASK_INVOKEIDLIST with a verb the item's
+ * shortcut menu carries out itself ("properties", "openas", "delete", ...):
+ * the menu does it, as on Windows, where these have no registry command.
+ * The dialogs among them (properties, openas) run on a thread of their own,
+ * so ShellExecuteEx returns while they are open, as on Windows. */
+static const WCHAR *menu_verbs[] = { L"properties", L"openas", L"delete", L"cut", L"copy",
+                                     L"paste", L"link", L"pintohome", L"unpinfromhome" };
+
+struct menu_verb
+{
+    LPITEMIDLIST pidl;
+    const WCHAR *verb;
+    HWND hwnd;
+    int show;
+    DWORD mask;
+};
+
+static HRESULT run_menu_verb( struct menu_verb *mv )
+{
+    CMINVOKECOMMANDINFOEX ici;
+    IContextMenu *menu = NULL;
+    LPCITEMIDLIST child;
+    IShellFolder *parent;
+    char verbA[64];
+    HMENU hmenu;
+    HRESULT hr;
+
+    hr = SHBindToParent( mv->pidl, &IID_IShellFolder, (void **)&parent, &child );
+    if (SUCCEEDED(hr))
+    {
+        hr = IShellFolder_GetUIObjectOf( parent, mv->hwnd, 1, &child, &IID_IContextMenu, NULL, (void **)&menu );
+        IShellFolder_Release( parent );
+    }
+    if (FAILED(hr)) return hr;
+
+    if ((hmenu = CreatePopupMenu()))
+    {
+        IContextMenu_QueryContextMenu( menu, hmenu, 0, 1, 0x7fff, CMF_NORMAL );
+        DestroyMenu( hmenu );
+    }
+    WideCharToMultiByte( CP_ACP, 0, mv->verb, -1, verbA, sizeof(verbA), NULL, NULL );
+    memset( &ici, 0, sizeof(ici) );
+    ici.cbSize = sizeof(ici);
+    ici.fMask = CMIC_MASK_UNICODE | (mv->mask & SEE_MASK_FLAG_NO_UI ? CMIC_MASK_FLAG_NO_UI : 0);
+    ici.hwnd = mv->hwnd;
+    ici.lpVerb = verbA;
+    ici.lpVerbW = mv->verb;
+    ici.nShow = mv->show;
+    hr = IContextMenu_InvokeCommand( menu, (CMINVOKECOMMANDINFO *)&ici );
+    IContextMenu_Release( menu );
+    TRACE( "verb %s through the item's menu: %#lx\n", debugstr_w(mv->verb), hr );
+    return hr;
+}
+
+static DWORD WINAPI menu_verb_thread( void *arg )
+{
+    struct menu_verb *mv = arg;
+    HRESULT init = CoInitializeEx( NULL, COINIT_APARTMENTTHREADED );
+
+    run_menu_verb( mv );
+    if (SUCCEEDED(init)) CoUninitialize();
+    ILFree( mv->pidl );
+    free( mv );
+    return 0;
+}
+
+static BOOL invoke_menu_verb( SHELLEXECUTEINFOW *sei )
+{
+    struct menu_verb *mv;
+    unsigned int i;
+    HANDLE thread;
+    HRESULT hr;
+
+    if (!(sei->fMask & SEE_MASK_INVOKEIDLIST) || !sei->lpVerb || !*sei->lpVerb) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(menu_verbs); i++) if (!wcsicmp( sei->lpVerb, menu_verbs[i] )) break;
+    if (i == ARRAY_SIZE(menu_verbs)) return FALSE;
+
+    if (!(mv = calloc( 1, sizeof(*mv) ))) return FALSE;
+    if ((sei->fMask & SEE_MASK_IDLIST) && sei->lpIDList) mv->pidl = ILClone( sei->lpIDList );
+    else if (sei->lpFile && *sei->lpFile) mv->pidl = ILCreateFromPathW( sei->lpFile );
+    if (!mv->pidl)
+    {
+        free( mv );
+        return FALSE;
+    }
+    mv->verb = menu_verbs[i];
+    mv->hwnd = sei->hwnd;
+    mv->show = sei->nShow;
+    mv->mask = sei->fMask;
+
+    if (i < 2)  /* a dialog */
+    {
+        if (!(thread = CreateThread( NULL, 0, menu_verb_thread, mv, 0, NULL )))
+        {
+            ILFree( mv->pidl );
+            free( mv );
+            return FALSE;
+        }
+        CloseHandle( thread );
+        sei->hInstApp = (HINSTANCE)33;
+        return TRUE;
+    }
+    hr = run_menu_verb( mv );
+    ILFree( mv->pidl );
+    free( mv );
+    if (FAILED(hr)) return FALSE;
+    sei->hInstApp = (HINSTANCE)33;
+    return TRUE;
+}
+
+/* SEE_MASK_CONNECTNETDRV: a file on a share gets the share connected to a
+ * drive letter first (reconnecting a remembered drive) */
+static void connect_net_drive( const SHELLEXECUTEINFOW *sei )
+{
+    DWORD (WINAPI *pWNetUseConnectionW)( HWND, NETRESOURCEW *, const WCHAR *, const WCHAR *, DWORD,
+                                         WCHAR *, DWORD *, DWORD * );
+    WCHAR share[MAX_PATH], device[MAX_PATH];
+    const WCHAR *p;
+    NETRESOURCEW nr;
+    DWORD size = ARRAY_SIZE(device), result, err;
+    HMODULE mpr;
+
+    if (!sei->lpFile || sei->lpFile[0] != '\\' || sei->lpFile[1] != '\\') return;
+    /* \\server\share */
+    if (!(p = wcschr( sei->lpFile + 2, '\\' ))) return;
+    p = wcschr( p + 1, '\\' );
+    lstrcpynW( share, sei->lpFile, min( (p ? p - sei->lpFile : wcslen( sei->lpFile )) + 1, ARRAY_SIZE(share) ) );
+    if (!(mpr = LoadLibraryW( L"mpr.dll" ))) return;
+    if ((pWNetUseConnectionW = (void *)GetProcAddress( mpr, "WNetUseConnectionW" )))
+    {
+        memset( &nr, 0, sizeof(nr) );
+        nr.dwType = RESOURCETYPE_DISK;
+        nr.lpRemoteName = share;
+        err = pWNetUseConnectionW( sei->hwnd, &nr, NULL, NULL,
+                                   CONNECT_REDIRECT | (sei->fMask & SEE_MASK_FLAG_NO_UI ? 0 : CONNECT_INTERACTIVE),
+                                   device, &size, &result );
+        TRACE( "connected %s: %lu %s\n", debugstr_w(share), err, err ? "" : debugstr_w(device) );
+    }
+    FreeLibrary( mpr );
+}
