+/* A credential crosses as a record: these UTF-8 strings, each NUL-terminated,
+ * in this order, then the secret's length (4 bytes, native order) and the
+ * secret. "key" is the target name folded to lower case (Windows matches
+ * target names without regard to case; the keyring matches attributes
+ * exactly); the numbers are decimal. A read or a delete sends only the key
+ * and the type. An enumeration answers with records, each preceded by its
+ * length (4 bytes). */
+enum cred_field
+{
+    CRED_FIELD_KEY,
+    CRED_FIELD_TARGET,
+    CRED_FIELD_TYPE,
+    CRED_FIELD_USER,
+    CRED_FIELD_COMMENT,
+    CRED_FIELD_ALIAS,
+    CRED_FIELD_PERSIST,
+    CRED_FIELD_FLAGS,
+    CRED_FIELD_WRITTEN,
+    CRED_FIELD_COUNT
+};
