+/*
+ * Credential Manager: the person's keyring (Secret Service) on the Unix side
+ *
+ * Stained Glass OS: CredWrite, CredRead, CredEnumerate and CredDelete keep
+ * credentials in the keyring of the Unix account the program runs as --
+ * gnome-keyring's Secret Service on the person's session bus, through
+ * libsecret, encrypted at rest with their sign-in password -- rather than
+ * only scrambled in their registry hive. libsecret is loaded when first
+ * needed; without it, without a session bus, or with no default keyring or
+ * a locked one, the caller falls back to the registry. Nothing here ever asks
+ * the keyring to prompt: a program asking for a credential must not hang on
+ * an unlock dialog. No secret is ever logged.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <sys/stat.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "wine/debug.h"
+
+#include "cred_unix.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(cred);
+
+/* libsecret's and GLib's types, as far as we use them */
+typedef struct { const char *name; int type; } secret_schema_attribute;
+typedef struct
+{
+    const char *name;
+    int flags;
+    secret_schema_attribute attributes[32];
+    int reserved;
+    void *reserved1, *reserved2, *reserved3, *reserved4, *reserved5, *reserved6, *reserved7;
+} secret_schema;
+typedef struct { unsigned int domain; int code; char *message; } g_error;
+typedef struct g_list { void *data; struct g_list *next, *prev; } g_list;
+
+#define SECRET_SEARCH_ALL          (1 << 1)
+#define SECRET_SEARCH_LOAD_SECRETS (1 << 3)
+
+static const char * const field_names[CRED_FIELD_COUNT] =
+{
+    "key", "target", "type", "user", "comment", "alias", "persist", "flags", "written"
+};
+
+static const secret_schema schema =
+{
+    "org.stainedglass.Credential", 0,
+    {
+        { "key", 0 }, { "target", 0 }, { "type", 0 }, { "user", 0 }, { "comment", 0 },
+        { "alias", 0 }, { "persist", 0 }, { "flags", 0 }, { "written", 0 },
+        { NULL, 0 }
+    }
+};
+
+static void *libsecret;
+
+static int (*p_secret_password_storev_binary_sync)( const secret_schema *, void *, const char *, const char *,
+                                                   void *, void *, g_error ** );
+static g_list *(*p_secret_password_searchv_sync)( const secret_schema *, void *, int, void *, g_error ** );
+static int (*p_secret_password_clearv_sync)( const secret_schema *, void *, void *, g_error ** );
+static void *(*p_secret_retrievable_get_attributes)( void * );
+static void *(*p_secret_retrievable_retrieve_secret_sync)( void *, void *, g_error ** );
+static void *(*p_secret_value_new)( const char *, long, const char * );
+static const char *(*p_secret_value_get)( void *, size_t * );
+static void (*p_secret_value_unref)( void * );
+static void *(*p_secret_service_get_sync)( int, void *, g_error ** );
+static void *(*p_secret_collection_for_alias_sync)( void *, const char *, int, void *, g_error ** );
+static int (*p_secret_collection_get_locked)( void * );
+static unsigned int (*p_g_str_hash)( const void * );
+static int (*p_g_str_equal)( const void *, const void * );
+static void *(*p_g_hash_table_new_full)( unsigned int (*)(const void *), int (*)(const void *, const void *),
+                                         void (*)(void *), void (*)(void *) );
+static int (*p_g_hash_table_insert)( void *, void *, void * );
+static void *(*p_g_hash_table_lookup)( void *, const void * );
+static void (*p_g_hash_table_unref)( void * );
+static void (*p_g_list_free_full)( g_list *, void (*)(void *) );
+static void (*p_g_object_unref)( void * );
+static void (*p_g_error_free)( g_error * );
+
+static pthread_mutex_t keyring_lock = PTHREAD_MUTEX_INITIALIZER;
+static int load_state;   /* 0 not tried, 1 loaded, -1 unusable */
+
+/* A session bus to reach, without GIO's autolaunch: with no address GIO
+ * would start a bus of its own (dbus-launch) for a program run outside any
+ * session -- a service as SYSTEM, a test. */
+static BOOL have_session_bus(void)
+{
+    const char *addr = getenv( "DBUS_SESSION_BUS_ADDRESS" ), *rt = getenv( "XDG_RUNTIME_DIR" );
+    char path[4096];
+    struct stat st;
+
+    if (addr && addr[0]) return TRUE;
+    if (!rt || rt[0] != '/') return FALSE;
+    snprintf( path, sizeof(path), "%s/bus", rt );
+    return !stat( path, &st ) && S_ISSOCK( st.st_mode );
+}
+
+static BOOL load_libsecret(void)
+{
+    if (load_state) return load_state > 0;
+    load_state = -1;
+    if (!have_session_bus())
+    {
+        TRACE( "no session bus\n" );
+        return FALSE;
+    }
+    if (!(libsecret = dlopen( "libsecret-1.so.0", RTLD_NOW )))
+    {
+        TRACE( "no libsecret: %s\n", dlerror() );
+        return FALSE;
+    }
+#define LOAD_FUNCPTR(f) if (!(p_##f = dlsym( libsecret, #f ))) { WARN( "no %s\n", #f ); return FALSE; }
+    LOAD_FUNCPTR(secret_password_storev_binary_sync);
+    LOAD_FUNCPTR(secret_password_searchv_sync);
+    LOAD_FUNCPTR(secret_password_clearv_sync);
+    LOAD_FUNCPTR(secret_retrievable_get_attributes);
+    LOAD_FUNCPTR(secret_retrievable_retrieve_secret_sync);
+    LOAD_FUNCPTR(secret_value_new);
+    LOAD_FUNCPTR(secret_value_get);
+    LOAD_FUNCPTR(secret_value_unref);
+    LOAD_FUNCPTR(secret_service_get_sync);
+    LOAD_FUNCPTR(secret_collection_for_alias_sync);
+    LOAD_FUNCPTR(secret_collection_get_locked);
+    LOAD_FUNCPTR(g_hash_table_new_full);
+    LOAD_FUNCPTR(g_hash_table_insert);
+    LOAD_FUNCPTR(g_hash_table_lookup);
+    LOAD_FUNCPTR(g_hash_table_unref);
+    LOAD_FUNCPTR(g_str_hash);
+    LOAD_FUNCPTR(g_str_equal);
+    LOAD_FUNCPTR(g_list_free_full);
+    LOAD_FUNCPTR(g_object_unref);
+    LOAD_FUNCPTR(g_error_free);
+#undef LOAD_FUNCPTR
+    load_state = 1;
+    return TRUE;
+}
+
+static void clear_error( g_error **err )
+{
+    if (*err) p_g_error_free( *err );
+    *err = NULL;
+}
+
+/* The keyring is usable: a default collection, unlocked. Never prompts. */
+static NTSTATUS keyring_usable(void)
+{
+    g_error *err = NULL;
+    void *service, *coll;
+    int locked;
+
+    if (!load_libsecret()) return STATUS_NOT_SUPPORTED;
+    if (!(service = p_secret_service_get_sync( 0, NULL, &err )))
+    {
+        TRACE( "no Secret Service (error %d)\n", err ? err->code : 0 );
+        clear_error( &err );
+        return STATUS_NOT_SUPPORTED;
+    }
+    coll = p_secret_collection_for_alias_sync( service, "default", 0, NULL, &err );
+    p_g_object_unref( service );
+    if (!coll)
+    {
+        TRACE( "no default keyring (error %d)\n", err ? err->code : 0 );
+        clear_error( &err );
+        return STATUS_NOT_SUPPORTED;
+    }
+    locked = p_secret_collection_get_locked( coll );
+    p_g_object_unref( coll );
+    if (locked)
+    {
+        TRACE( "the default keyring is locked\n" );
+        return STATUS_NOT_SUPPORTED;
+    }
+    return STATUS_SUCCESS;
+}
+
+/* the record's strings, checked to lie inside it */
+static BOOL parse_strings( const char *in, UINT size, const char **fields, UINT count, UINT *used )
+{
+    UINT i, pos = 0;
+
+    for (i = 0; i < count; i++)
+    {
+        const char *end = memchr( in + pos, 0, size - pos );
+        if (pos >= size || !end) return FALSE;
+        fields[i] = in + pos;
+        pos = end - in + 1;
+    }
+    *used = pos;
+    return TRUE;
+}
+
+static void *new_attributes(void)
+{
+    return p_g_hash_table_new_full( p_g_str_hash, p_g_str_equal, NULL, NULL );
+}
+
+static NTSTATUS keyring_write( struct cred_keyring_params *params )
+{
+    const char *fields[CRED_FIELD_COUNT];
+    const char *in = params->in;
+    void *attrs, *match, *value;
+    g_error *err = NULL;
+    UINT used, blob_size, i;
+    char label[1024];
+    NTSTATUS status;
+    int ok;
+
+    if ((status = keyring_usable())) return status;
+    if (!parse_strings( in, params->in_size, fields, CRED_FIELD_COUNT, &used ) ||
+        params->in_size - used < sizeof(UINT))
+        return STATUS_INVALID_PARAMETER;
+    memcpy( &blob_size, in + used, sizeof(UINT) );
+    used += sizeof(UINT);
+    if (params->in_size - used < blob_size) return STATUS_INVALID_PARAMETER;
+
+    /* one item per target and type: whatever else changed (the user name,
+     * the comment) replaces it, rather than adding a second */
+    match = new_attributes();
+    p_g_hash_table_insert( match, (void *)field_names[CRED_FIELD_KEY], (void *)fields[CRED_FIELD_KEY] );
+    p_g_hash_table_insert( match, (void *)field_names[CRED_FIELD_TYPE], (void *)fields[CRED_FIELD_TYPE] );
+    p_secret_password_clearv_sync( &schema, match, NULL, &err );
+    clear_error( &err );
+    p_g_hash_table_unref( match );
+
+    attrs = new_attributes();
+    for (i = 0; i < CRED_FIELD_COUNT; i++)
+        p_g_hash_table_insert( attrs, (void *)field_names[i], (void *)fields[i] );
+    snprintf( label, sizeof(label), "%s (Credential Manager)", fields[CRED_FIELD_TARGET] );
+    value = p_secret_value_new( in + used, blob_size, "application/octet-stream" );
+    ok = p_secret_password_storev_binary_sync( &schema, attrs, NULL, label, value, NULL, &err );
+    if (!ok) WARN( "the keyring refused the credential (error %d)\n", err ? err->code : 0 );
+    clear_error( &err );
+    p_secret_value_unref( value );
+    p_g_hash_table_unref( attrs );
+    return ok ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL;
+}
+
+/* one item as a record at out (if it fits); returns its size */
+static UINT put_record( void *item, char *out, UINT room, BOOL *ok )
+{
+    void *attrs = p_secret_retrievable_get_attributes( item );
+    g_error *err = NULL;
+    void *value = NULL;
+    const char *secret = "";
+    size_t secret_len = 0;
+    UINT size = 0, i, blob;
+
+    *ok = FALSE;
+    if (!attrs) return 0;
+    if ((value = p_secret_retrievable_retrieve_secret_sync( item, NULL, &err )))
+        secret = p_secret_value_get( value, &secret_len );
+    clear_error( &err );
+    if (value)
+    {
+        for (i = 0; i < CRED_FIELD_COUNT; i++)
+        {
+            const char *s = p_g_hash_table_lookup( attrs, field_names[i] );
+            UINT len = s ? strlen( s ) + 1 : 1;
+            if (out && size + len <= room) memcpy( out + size, s ? s : "", len );
+            size += len;
+        }
+        blob = secret_len;
+        if (out && size + sizeof(UINT) + blob <= room)
+        {
+            memcpy( out + size, &blob, sizeof(UINT) );
+            memcpy( out + size + sizeof(UINT), secret, blob );
+        }
+        size += sizeof(UINT) + blob;
+        *ok = TRUE;
+        p_secret_value_unref( value );
+    }
+    p_g_hash_table_unref( attrs );
+    return size;
+}
+
+static NTSTATUS keyring_read( struct cred_keyring_params *params )
+{
+    const char *fields[2];
+    void *attrs;
+    g_error *err = NULL;
+    g_list *items, *l;
+    UINT used, size = 0;
+    NTSTATUS status = STATUS_NOT_FOUND;
+    BOOL ok;
+
+    if ((status = keyring_usable())) return status;
+    status = STATUS_NOT_FOUND;
+    if (!parse_strings( params->in, params->in_size, fields, 2, &used )) return STATUS_INVALID_PARAMETER;
+    attrs = new_attributes();
+    p_g_hash_table_insert( attrs, (void *)field_names[CRED_FIELD_KEY], (void *)fields[0] );
+    p_g_hash_table_insert( attrs, (void *)field_names[CRED_FIELD_TYPE], (void *)fields[1] );
+    items = p_secret_password_searchv_sync( &schema, attrs, SECRET_SEARCH_ALL | SECRET_SEARCH_LOAD_SECRETS, NULL, &err );
+    clear_error( &err );
+    p_g_hash_table_unref( attrs );
+    for (l = items; l; l = l->next)
+    {
+        size = put_record( l->data, params->out, params->out_size, &ok );
+        if (!ok) continue;   /* locked, in another keyring */
+        *params->needed = size;
+        status = size <= params->out_size ? STATUS_SUCCESS : STATUS_BUFFER_TOO_SMALL;
+        break;
+    }
+    if (items) p_g_list_free_full( items, p_g_object_unref );
+    return status;
+}
+
+static NTSTATUS keyring_delete( struct cred_keyring_params *params )
+{
+    const char *fields[2];
+    void *attrs;
+    g_error *err = NULL;
+    UINT used;
+    NTSTATUS status;
+    int found;
+
+    if ((status = keyring_usable())) return status;
+    if (!parse_strings( params->in, params->in_size, fields, 2, &used )) return STATUS_INVALID_PARAMETER;
+    attrs = new_attributes();
+    p_g_hash_table_insert( attrs, (void *)field_names[CRED_FIELD_KEY], (void *)fields[0] );
+    p_g_hash_table_insert( attrs, (void *)field_names[CRED_FIELD_TYPE], (void *)fields[1] );
+    found = p_secret_password_clearv_sync( &schema, attrs, NULL, &err );
+    status = err ? STATUS_UNSUCCESSFUL : found ? STATUS_SUCCESS : STATUS_NOT_FOUND;
+    clear_error( &err );
+    p_g_hash_table_unref( attrs );
+    return status;
+}
+
+static NTSTATUS keyring_enumerate( struct cred_keyring_params *params )
+{
+    char *out = params->out;
+    void *attrs;
+    g_error *err = NULL;
+    g_list *items, *l;
+    UINT size = 0, rec;
+    NTSTATUS status;
+    BOOL ok;
+
+    if ((status = keyring_usable())) return status;
+    attrs = new_attributes();
+    items = p_secret_password_searchv_sync( &schema, attrs, SECRET_SEARCH_ALL | SECRET_SEARCH_LOAD_SECRETS, NULL, &err );
+    clear_error( &err );
+    p_g_hash_table_unref( attrs );
+    for (l = items; l; l = l->next)
+    {
+        BOOL fits = out && size + sizeof(UINT) <= params->out_size;
+        rec = put_record( l->data, fits ? out + size + sizeof(UINT) : NULL,
+                          fits ? params->out_size - size - sizeof(UINT) : 0, &ok );
+        if (!ok) continue;
+        if (fits && size + sizeof(UINT) + rec <= params->out_size) memcpy( out + size, &rec, sizeof(UINT) );
+        size += sizeof(UINT) + rec;
+    }
+    if (items) p_g_list_free_full( items, p_g_object_unref );
+    *params->needed = size;
+    return size <= params->out_size ? STATUS_SUCCESS : STATUS_BUFFER_TOO_SMALL;
+}
+
+#define LOCKED_CALL(name) \
+    static NTSTATUS unix_##name( void *args ) \
+    { \
+        NTSTATUS status; \
+        pthread_mutex_lock( &keyring_lock ); \
+        status = name( args ); \
+        pthread_mutex_unlock( &keyring_lock ); \
+        return status; \
+    }
+
+static NTSTATUS keyring_status( void *args )
+{
+    return keyring_usable();
+}
+
+LOCKED_CALL(keyring_status)
+LOCKED_CALL(keyring_write)
+LOCKED_CALL(keyring_read)
+LOCKED_CALL(keyring_delete)
+LOCKED_CALL(keyring_enumerate)
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    unix_keyring_status,
+    unix_keyring_write,
+    unix_keyring_read,
+    unix_keyring_delete,
+    unix_keyring_enumerate,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_cred_keyring_funcs_count );
+
+#ifdef _WIN64
+
+typedef ULONG PTR32;
+
+static NTSTATUS wow64_call( void *args, NTSTATUS (*func)( void * ) )
+{
+    struct
+    {
+        PTR32 in;
+        UINT  in_size;
+        PTR32 out;
+        UINT  out_size;
+        PTR32 needed;
+    } const *params32 = args;
+    struct cred_keyring_params params =
+    {
+        ULongToPtr( params32->in ), params32->in_size,
+        ULongToPtr( params32->out ), params32->out_size,
+        ULongToPtr( params32->needed )
+    };
+    return func( &params );
+}
+
+static NTSTATUS wow64_keyring_status( void *args ) { return unix_keyring_status( NULL ); }
+static NTSTATUS wow64_keyring_write( void *args ) { return wow64_call( args, unix_keyring_write ); }
+static NTSTATUS wow64_keyring_read( void *args ) { return wow64_call( args, unix_keyring_read ); }
+static NTSTATUS wow64_keyring_delete( void *args ) { return wow64_call( args, unix_keyring_delete ); }
+static NTSTATUS wow64_keyring_enumerate( void *args ) { return wow64_call( args, unix_keyring_enumerate ); }
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    wow64_keyring_status,
+    wow64_keyring_write,
+    wow64_keyring_read,
+    wow64_keyring_delete,
+    wow64_keyring_enumerate,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_cred_keyring_funcs_count );
+
+#endif /* _WIN64 */
