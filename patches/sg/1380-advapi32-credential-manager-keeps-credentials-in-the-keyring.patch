+/* Stained Glass OS: the person's keyring.
+ *
+ * Credentials a program keeps (CRED_PERSIST_LOCAL_MACHINE and _ENTERPRISE)
+ * go to the keyring of the Unix account it runs as -- gnome-keyring's Secret
+ * Service, encrypted with the sign-in password -- through the Unix side
+ * (cred_unix.c). The registry, where Wine keeps them only scrambled, is the
+ * fallback when there is no keyring to use (no session bus, a locked or
+ * missing default keyring: never a prompt), and keeps logon-session
+ * credentials (CRED_PERSIST_SESSION, a volatile key). What an earlier
+ * version left in the registry moves to the keyring the first time one is
+ * there. Target names match without regard to case, as on Windows. */
+static INIT_ONCE keyring_once = INIT_ONCE_STATIC_INIT;
+static BOOL keyring_loaded;
+
+static BOOL CALLBACK keyring_init( INIT_ONCE *once, void *param, void **context )
+{
+    keyring_loaded = !__wine_init_unix_call();
+    return TRUE;
+}
+
+static NTSTATUS keyring_call( unsigned int func, const void *in, UINT in_size, void *out, UINT out_size, UINT *needed )
+{
+    struct cred_keyring_params params = { in, in_size, out, out_size, needed };
+    UINT dummy = 0;
+
+    InitOnceExecuteOnce( &keyring_once, keyring_init, NULL, NULL );
+    if (!keyring_loaded) return STATUS_NOT_SUPPORTED;
+    if (!needed) params.needed = &dummy;
+    return WINE_UNIX_CALL( func, &params );
+}
+
+static DWORD keyring_error( NTSTATUS status )
+{
+    switch (status)
+    {
+    case STATUS_SUCCESS: return ERROR_SUCCESS;
+    case STATUS_NOT_FOUND: return ERROR_NOT_FOUND;
+    case STATUS_NOT_SUPPORTED: return ERROR_NOT_SUPPORTED;
+    case STATUS_NO_MEMORY: return ERROR_OUTOFMEMORY;
+    default: return ERROR_INTERNAL_ERROR;
+    }
+}
+
+/* a UTF-8 copy, "" for NULL */
+static char *keyring_utf8( const WCHAR *s )
+{
+    int len = s ? WideCharToMultiByte( CP_UTF8, 0, s, -1, NULL, 0, NULL, NULL ) : 1;
+    char *ret = malloc( len > 0 ? len : 1 );
+    if (!ret) return NULL;
+    if (s && len > 0) WideCharToMultiByte( CP_UTF8, 0, s, -1, ret, len, NULL, NULL );
+    else ret[0] = 0;
+    return ret;
+}
+
+/* the target name folded to lower case, as the item is found by */
+static char *keyring_key( const WCHAR *target )
+{
+    int len = lstrlenW( target ) + 1;
+    WCHAR *folded = malloc( len * sizeof(WCHAR) );
+    char *ret;
+
+    if (!folded) return NULL;
+    if (!LCMapStringW( LOCALE_INVARIANT, LCMAP_LOWERCASE, target, len, folded, len )) lstrcpyW( folded, target );
+    ret = keyring_utf8( folded );
+    free( folded );
+    return ret;
+}
+
+static char *keyring_append( char *buf, UINT *size, const void *data, UINT len )
+{
+    char *ret = realloc( buf, *size + len );
+    if (!ret)
+    {
+        if (buf) SecureZeroMemory( buf, *size );
+        free( buf );
+        return NULL;
+    }
+    memcpy( ret + *size, data, len );
+    *size += len;
+    return ret;
+}
+
+static void keyring_free( char *buf, UINT size )
+{
+    if (!buf) return;
+    SecureZeroMemory( buf, size );
+    free( buf );
+}
+
+/* key NUL type NUL, what a read or a delete is sent */
+static char *keyring_lookup_request( const WCHAR *target, DWORD type, UINT *size )
+{
+    char *key = keyring_key( target ), *buf = NULL, num[16];
+
+    *size = 0;
+    if (!key) return NULL;
+    sprintf( num, "%lu", type );
+    if ((buf = keyring_append( NULL, size, key, strlen( key ) + 1 )))
+        buf = keyring_append( buf, size, num, strlen( num ) + 1 );
+    free( key );
+    return buf;
+}
+
+struct keyring_record
+{
+    const char *field[CRED_FIELD_COUNT];
+    const BYTE *blob;
+    UINT        blob_size;
+};
+
+static BOOL keyring_parse( const char *rec, UINT size, struct keyring_record *r )
+{
+    UINT i, pos = 0;
+
+    for (i = 0; i < CRED_FIELD_COUNT; i++)
+    {
+        const char *end = pos < size ? memchr( rec + pos, 0, size - pos ) : NULL;
+        if (!end) return FALSE;
+        r->field[i] = rec + pos;
+        pos = end - rec + 1;
+    }
+    if (size - pos < sizeof(UINT)) return FALSE;
+    memcpy( &r->blob_size, rec + pos, sizeof(UINT) );
+    pos += sizeof(UINT);
+    if (size - pos < r->blob_size) return FALSE;
+    r->blob = (const BYTE *)rec + pos;
+    return TRUE;
+}
+
+static DWORD keyring_wide_size( const char *s )
+{
+    return *s ? MultiByteToWideChar( CP_UTF8, 0, s, -1, NULL, 0 ) * sizeof(WCHAR) : 0;
+}
+
+/* the size of a CREDENTIALW and its data, kept 8-byte aligned so that the
+ * next one in an enumeration is too */
+static DWORD keyring_credential_size( const struct keyring_record *r )
+{
+    DWORD size = sizeof(CREDENTIALW) + keyring_wide_size( r->field[CRED_FIELD_TARGET] ) +
+                 keyring_wide_size( r->field[CRED_FIELD_USER] ) + keyring_wide_size( r->field[CRED_FIELD_COMMENT] ) +
+                 keyring_wide_size( r->field[CRED_FIELD_ALIAS] ) + r->blob_size;
+    return (size + 7) & ~7;
+}
+
+static WCHAR *keyring_put_string( const char *s, WCHAR **ptr )
+{
+    WCHAR *ret = *ptr;
+    int len;
+
+    if (!*s) return NULL;
+    len = MultiByteToWideChar( CP_UTF8, 0, s, -1, NULL, 0 );
+    MultiByteToWideChar( CP_UTF8, 0, s, -1, ret, len );
+    *ptr += len;
+    return ret;
+}
+
+static void keyring_fill( const struct keyring_record *r, CREDENTIALW *cred )
+{
+    WCHAR *ptr = (WCHAR *)(cred + 1);
+    ULONGLONG written = _strtoui64( r->field[CRED_FIELD_WRITTEN], NULL, 10 );
+
+    memset( cred, 0, sizeof(*cred) );
+    cred->Flags = strtoul( r->field[CRED_FIELD_FLAGS], NULL, 10 );
+    cred->Type = strtoul( r->field[CRED_FIELD_TYPE], NULL, 10 );
+    cred->Persist = strtoul( r->field[CRED_FIELD_PERSIST], NULL, 10 );
+    cred->LastWritten.dwLowDateTime = (DWORD)written;
+    cred->LastWritten.dwHighDateTime = (DWORD)(written >> 32);
+    cred->TargetName = keyring_put_string( r->field[CRED_FIELD_TARGET], &ptr );
+    cred->UserName = keyring_put_string( r->field[CRED_FIELD_USER], &ptr );
+    cred->Comment = keyring_put_string( r->field[CRED_FIELD_COMMENT], &ptr );
+    cred->TargetAlias = keyring_put_string( r->field[CRED_FIELD_ALIAS], &ptr );
+    if ((cred->CredentialBlobSize = r->blob_size))
+    {
+        cred->CredentialBlob = (BYTE *)ptr;
+        memcpy( cred->CredentialBlob, r->blob, r->blob_size );
+    }
+}
+
+/* the raw record of one credential, or an error */
+static DWORD keyring_read_record( const WCHAR *target, DWORD type, char **rec, UINT *rec_size )
+{
+    UINT req_size, size = 512, needed = 0;
+    char *req = keyring_lookup_request( target, type, &req_size ), *buf = NULL;
+    NTSTATUS status = STATUS_NO_MEMORY;
+
+    if (!req) return ERROR_OUTOFMEMORY;
+    for (;;)
+    {
+        if (!(buf = malloc( size ))) break;
+        status = keyring_call( unix_cred_keyring_read, req, req_size, buf, size, &needed );
+        if (status != STATUS_BUFFER_TOO_SMALL) break;
+        keyring_free( buf, size );
+        buf = NULL;
+        size = needed;
+    }
+    keyring_free( req, req_size );
+    if (status)
+    {
+        keyring_free( buf, size );
+        return keyring_error( status );
+    }
+    *rec = buf;
+    *rec_size = size;
+    return ERROR_SUCCESS;
+}
+
+static DWORD keyring_read_credential( const WCHAR *target, DWORD type, CREDENTIALW **ret )
+{
+    struct keyring_record r;
+    char *rec;
+    UINT rec_size;
+    DWORD err = keyring_read_record( target, type, &rec, &rec_size );
+
+    if (err) return err;
+    if (!keyring_parse( rec, rec_size, &r )) err = ERROR_INTERNAL_ERROR;
+    else if (!(*ret = malloc( keyring_credential_size( &r ) ))) err = ERROR_OUTOFMEMORY;
+    else keyring_fill( &r, *ret );
+    keyring_free( rec, rec_size );
+    return err;
+}
+
+static DWORD keyring_write_credential( const CREDENTIALW *cred, BOOL preserve_blob )
+{
+    char *strings[CRED_FIELD_COUNT] = { 0 }, num[3][16], when[24], *buf = NULL, *old = NULL;
+    const BYTE *blob = cred->CredentialBlob;
+    UINT size = 0, old_size = 0, blob_size = blob ? cred->CredentialBlobSize : 0, i;
+    struct keyring_record r;
+    ULONGLONG written;
+    FILETIME now;
+    NTSTATUS status;
+
+    if (preserve_blob)
+    {
+        blob = NULL;
+        blob_size = 0;
+        if (!keyring_read_record( cred->TargetName, cred->Type, &old, &old_size ) && keyring_parse( old, old_size, &r ))
+        {
+            blob = r.blob;
+            blob_size = r.blob_size;
+        }
+    }
+    GetSystemTimeAsFileTime( &now );
+    written = ((ULONGLONG)now.dwHighDateTime << 32) | now.dwLowDateTime;
+    sprintf( num[0], "%lu", cred->Type );
+    sprintf( num[1], "%lu", cred->Persist );
+    sprintf( num[2], "%lu", cred->Flags );
+    sprintf( when, "%I64u", written );
+    strings[CRED_FIELD_KEY] = keyring_key( cred->TargetName );
+    strings[CRED_FIELD_TARGET] = keyring_utf8( cred->TargetName );
+    strings[CRED_FIELD_USER] = keyring_utf8( cred->UserName );
+    strings[CRED_FIELD_COMMENT] = keyring_utf8( cred->Comment );
+    strings[CRED_FIELD_ALIAS] = keyring_utf8( cred->TargetAlias );
+    for (i = 0; i < CRED_FIELD_COUNT; i++)
+    {
+        const char *s = i == CRED_FIELD_TYPE ? num[0] : i == CRED_FIELD_PERSIST ? num[1] :
+                        i == CRED_FIELD_FLAGS ? num[2] : i == CRED_FIELD_WRITTEN ? when : strings[i];
+        if (!s || !(buf = keyring_append( buf, &size, s, strlen( s ) + 1 ))) break;
+    }
+    if (i == CRED_FIELD_COUNT && (buf = keyring_append( buf, &size, &blob_size, sizeof(UINT) )) && blob_size)
+        buf = keyring_append( buf, &size, blob, blob_size );
+    for (i = 0; i < CRED_FIELD_COUNT; i++) free( strings[i] );
+    keyring_free( old, old_size );
+    if (!buf) return ERROR_OUTOFMEMORY;
+    status = keyring_call( unix_cred_keyring_write, buf, size, NULL, 0, NULL );
+    keyring_free( buf, size );
+    return keyring_error( status );
+}
+
+static DWORD keyring_delete_credential( const WCHAR *target, DWORD type )
+{
+    UINT size;
+    char *req = keyring_lookup_request( target, type, &size );
+    NTSTATUS status;
+
+    if (!req) return ERROR_OUTOFMEMORY;
+    status = keyring_call( unix_cred_keyring_delete, req, size, NULL, 0, NULL );
+    keyring_free( req, size );
+    return keyring_error( status );
+}
+
+/* every credential in the keyring, as records */
+static DWORD keyring_fetch_all( char **all, UINT *all_size )
+{
+    UINT size = 4096, needed = 0;
+    NTSTATUS status;
+    char *buf;
+
+    for (;;)
+    {
+        if (!(buf = malloc( size ))) return ERROR_OUTOFMEMORY;
+        status = keyring_call( unix_cred_keyring_enumerate, NULL, 0, buf, size, &needed );
+        if (status != STATUS_BUFFER_TOO_SMALL) break;
+        keyring_free( buf, size );
+        size = needed + 4096;
+    }
+    if (status)
+    {
+        keyring_free( buf, size );
+        return keyring_error( status );
+    }
+    *all = buf;
+    *all_size = needed;
+    return ERROR_SUCCESS;
+}
+
+static BOOL keyring_matches_filter( const char *target, LPCWSTR filter )
+{
+    int len;
+    WCHAR *name;
+    const WCHAR *p;
+    BOOL ret;
+
+    if (!filter) return TRUE;
+    len = MultiByteToWideChar( CP_UTF8, 0, target, -1, NULL, 0 );
+    if (len <= 0 || !(name = malloc( len * sizeof(WCHAR) ))) return FALSE;
+    MultiByteToWideChar( CP_UTF8, 0, target, -1, name, len );
+    p = wcschr( filter, '*' );
+    ret = CompareStringW( GetThreadLocale(), NORM_IGNORECASE, filter, (p && !p[1] ? p - filter : -1), name,
+                          (p && !p[1] ? p - filter : -1) ) == CSTR_EQUAL;
+    free( name );
+    return ret;
+}
+
+/* As registry_enumerate_credentials: without a buffer, add up the size;
+ * with one, fill it in and move along it. */
+static void keyring_enumerate_credentials( const char *all, UINT all_size, LPCWSTR filter,
+                                           PCREDENTIALW *credentials, char **buffer, DWORD *len, DWORD *count )
+{
+    UINT pos = 0, rec_size;
+    struct keyring_record r;
+
+    if (!all) return;
+    if (buffer) *buffer = (char *)(((ULONG_PTR)*buffer + 7) & ~(ULONG_PTR)7);
+    else *len += 8;   /* room to align the first one */
+    while (all_size - pos >= sizeof(UINT))
+    {
+        memcpy( &rec_size, all + pos, sizeof(UINT) );
+        pos += sizeof(UINT);
+        if (all_size - pos < rec_size) break;
+        if (keyring_parse( all + pos, rec_size, &r ) && keyring_matches_filter( r.field[CRED_FIELD_TARGET], filter ))
+        {
+            DWORD size = keyring_credential_size( &r );
+            if (buffer)
+            {
+                credentials[*count] = (PCREDENTIALW)*buffer;
+                keyring_fill( &r, credentials[*count] );
+                *buffer += size;
+            }
+            else *len += size;
+            (*count)++;
+        }
+        pos += rec_size;
+    }
+}
+
+static DWORD open_cred_mgr_key(HKEY *hkey, BOOL open_for_write);
+static DWORD get_cred_mgr_encryption_key(HKEY hkeyMgr, BYTE key_data[KEY_SIZE]);
+static DWORD registry_read_credential(HKEY hkey, PCREDENTIALW credential,
+                                      const BYTE key_data[KEY_SIZE], char *buffer, DWORD *len);
+
+/* What the registry keeps that belongs in the keyring moves there: each
+ * credential is written, read back, and only then removed from the hive. */
+static void keyring_migrate(void)
+{
+    BYTE key_data[KEY_SIZE];
+    WCHAR name[512];
+    HKEY mgr, hkey;
+    DWORD i = 0, len, moved = 0;
+
+    if (open_cred_mgr_key( &mgr, TRUE )) return;
+    if (get_cred_mgr_encryption_key( mgr, key_data ))
+    {
+        RegCloseKey( mgr );
+        return;
+    }
+    while (!RegEnumKeyW( mgr, i, name, ARRAY_SIZE(name) ))
+    {
+        CREDENTIALW *cred = NULL, *check = NULL;
+        BOOL done = FALSE;
+
+        if (!RegOpenKeyExW( mgr, name, 0, KEY_QUERY_VALUE, &hkey ))
+        {
+            len = sizeof(*cred);
+            if (!registry_read_credential( hkey, NULL, key_data, NULL, &len ) && (cred = calloc( 1, len )))
+            {
+                len = sizeof(*cred);
+                if (!registry_read_credential( hkey, cred, key_data, (char *)(cred + 1), &len ) &&
+                    cred->Persist != CRED_PERSIST_SESSION &&
+                    (cred->Type == CRED_TYPE_GENERIC || cred->Type == CRED_TYPE_DOMAIN_PASSWORD) &&
+                    !keyring_write_credential( cred, FALSE ) &&
+                    !keyring_read_credential( cred->TargetName, cred->Type, &check ))
+                    done = check->CredentialBlobSize == cred->CredentialBlobSize;
+                if (check)
+                {
+                    if (check->CredentialBlob) SecureZeroMemory( check->CredentialBlob, check->CredentialBlobSize );
+                    free( check );
+                }
+                if (cred->CredentialBlob) SecureZeroMemory( cred->CredentialBlob, cred->CredentialBlobSize );
+                free( cred );
+            }
+            RegCloseKey( hkey );
+        }
+        if (done && !RegDeleteKeyW( mgr, name )) moved++;
+        else i++;
+    }
+    RegCloseKey( mgr );
+    if (moved) TRACE( "moved %lu credentials from the registry to the keyring\n", moved );
+}
+
+/* The keyring is there to use (and what the registry had has moved to it). */
+static BOOL keyring_ready(void)
+{
+    static LONG warned, migrated;
+
+#ifdef SG_MUTANT_CRED_KEYRING
+    return FALSE;
+#endif
+    if (keyring_call( unix_cred_keyring_status, NULL, 0, NULL, 0, NULL ))
+    {
+        if (!InterlockedExchange( &warned, 1 ))
+            ERR( "no keyring to keep credentials in (no Secret Service on the session bus, or the keyring is "
+                 "locked): the registry keeps them instead, only scrambled\n" );
+        return FALSE;
+    }
+#ifndef SG_MUTANT_CRED_MIGRATE
+    if (!InterlockedExchange( &migrated, 1 )) keyring_migrate();
+#endif
+    return TRUE;
+}
