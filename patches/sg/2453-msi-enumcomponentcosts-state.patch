From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msi: MsiEnumComponentCosts needs costing started and finished

Ground truth from Wine's package test (2 todo_wine marks removed): MsiEnumComponentCosts is ERROR_INVALID_HANDLE_STATE before CostInitialize has run, and ERROR_FUNCTION_NOT_CALLED until CostFinalize and, as the test says against the documentation, InstallValidate have run too.
---
--- a/dlls/msi/action.c
+++ b/dlls/msi/action.c
@@ -3069,6 +3069,7 @@ static UINT ACTION_InstallValidate(MSIPACKAGE *package)
     UINT rc;
 
     TRACE("InstallValidate\n");
+    package->validate_done = 1;
 
     rc = MSI_DatabaseOpenViewW( package->db, L"SELECT * FROM `Registry`", &view );
     if (rc == ERROR_SUCCESS)
--- a/dlls/msi/msi.c
+++ b/dlls/msi/msi.c
@@ -2020,11 +2020,31 @@ UINT WINAPI MsiEnumComponentCostsW( MSIHANDLE handle, const WCHAR *component, DW
         return r;
     }
 
+#ifndef SG_MUTANT_MSI_COST_STATE
+    {
+        WCHAR *costing = msi_dup_property( package->db, L"CostingComplete" );
+
+        /* costing has not been started (CostInitialize), or it is not finished: CostFinalize and, as
+         * the Windows tests show, InstallValidate as well */
+        if (!costing)
+        {
+            msiobj_release( &package->hdr );
+            return ERROR_INVALID_HANDLE_STATE;
+        }
+        free( costing );
+        if (!msi_get_property_int( package->db, L"CostingComplete", 0 ) || !package->validate_done)
+        {
+            msiobj_release( &package->hdr );
+            return ERROR_FUNCTION_NOT_CALLED;
+        }
+    }
+#else
     if (!msi_get_property_int( package->db, L"CostingComplete", 0 ))
     {
         msiobj_release( &package->hdr );
         return ERROR_FUNCTION_NOT_CALLED;
     }
+#endif
     if (component && component[0] && !(comp = msi_get_loaded_component( package, component )))
     {
         msiobj_release( &package->hdr );
--- a/dlls/msi/msipriv.h
+++ b/dlls/msi/msipriv.h
@@ -484,6 +484,7 @@ typedef struct tagMSIPACKAGE
     unsigned char need_reboot_at_end : 1;
     unsigned char need_reboot_now : 1;
     unsigned char need_rollback : 1;
+    unsigned char validate_done : 1;   /* InstallValidate has run */
     unsigned char rpc_server_started : 1;
 } MSIPACKAGE;
 
--- a/dlls/msi/tests/package.c
+++ b/dlls/msi/tests/package.c
@@ -8418,7 +8418,7 @@ static void test_costs(void)
 
     len = sizeof(drive);
     r = MsiEnumComponentCostsA( hpkg, "one", 0, INSTALLSTATE_LOCAL, drive, &len, &cost, &temp );
-    todo_wine ok( r == ERROR_INVALID_HANDLE_STATE, "Expected ERROR_INVALID_HANDLE_STATE, got %u\n", r );
+    ok( r == ERROR_INVALID_HANDLE_STATE, "Expected ERROR_INVALID_HANDLE_STATE, got %u\n", r );
 
     len = sizeof(drive);
     r = MsiEnumComponentCostsA( hpkg, "one", 0, INSTALLSTATE_LOCAL, NULL, &len, &cost, &temp );
@@ -8442,7 +8442,7 @@ static void test_costs(void)
     /* contrary to what msdn says InstallValidate must be called too */
     len = sizeof(drive);
     r = MsiEnumComponentCostsA( hpkg, "one", 0, INSTALLSTATE_LOCAL, drive, &len, &cost, &temp );
-    todo_wine ok( r == ERROR_FUNCTION_NOT_CALLED, "Expected ERROR_FUNCTION_NOT_CALLED, got %u\n", r );
+    ok( r == ERROR_FUNCTION_NOT_CALLED, "Expected ERROR_FUNCTION_NOT_CALLED, got %u\n", r );
 
     r = MsiDoActionA( hpkg, "InstallValidate" );
     ok( r == ERROR_SUCCESS, "InstallValidate failed %u\n", r );
