From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, ntdll: open a dangling symbolic link as itself to delete it

Deleting a dangling symbolic link (or one that loops) failed with
ERROR_FILE_NOT_FOUND: DeleteFileW and RemoveDirectoryW open the link with
FILE_OPEN_REPARSE_POINT, but the client's open (ADR 0013) and the server's
open_fd() followed it. Such a link is now opened as itself (O_PATH |
O_NOFOLLOW, never through it; nothing is created or truncated at its target),
gets an inode of its own, so delete disposition and delete-on-close unlink the
link. The server keeps the link name only when it is the link the fd is. A
link opened as itself to be deleted skips the FILE_(NON_)DIRECTORY_FILE checks:
a Unix link does not keep whether it was a file or a directory link, and
Windows deletes a file link to a folder with DeleteFileW (msvcp120 tests).

msvcp120/msvcp140 tests: the link deletions and _Unlink of a dangling link
now pass (todo_wine removed), as does tr2_sys__Symlink into a missing folder
(CreateSymbolicLinkA, 5001).

Mutant: SG_MUTANT_DANGLING_LINK_FOLLOWS. Gate: test/linkdel-gate.sh.
---
diff --git a/dlls/msvcp120/tests/msvcp120.c b/dlls/msvcp120/tests/msvcp120.c
--- a/dlls/msvcp120/tests/msvcp120.c
+++ b/dlls/msvcp120/tests/msvcp120.c
@@ -1721,8 +1721,8 @@ static void test_tr2_sys__Stat(void)
     ok(ERROR_SUCCESS == err_code, "tr2_sys__Lstat_wchar(): err_code expect ERROR_SUCCESS, got %d\n", err_code);
 
     if(ret) {
-        todo_wine ok(DeleteFileA("tr2_test_dir/f1_link"), "expect tr2_test_dir/f1_link to exist\n");
-        todo_wine ok(RemoveDirectoryA("tr2_test_dir/dir_link"), "expect tr2_test_dir/dir_link to exist\n");
+        ok(DeleteFileA("tr2_test_dir/f1_link"), "expect tr2_test_dir/f1_link to exist\n");
+        ok(RemoveDirectoryA("tr2_test_dir/dir_link"), "expect tr2_test_dir/dir_link to exist\n");
     }
     ok(DeleteFileA("tr2_test_dir/f1"), "expect tr2_test_dir/f1 to exist\n");
     ok(RemoveDirectoryA("tr2_test_dir"), "expect tr2_test_dir to exist\n");
@@ -1960,7 +1960,7 @@ static void test_tr2_sys__Symlink(void)
         { NULL, "NULL_link", ERROR_INVALID_PARAMETER, FALSE },
         { "f1", NULL, ERROR_INVALID_PARAMETER, FALSE },
         { "not_exist",  "not_exist_link", ERROR_SUCCESS, FALSE },
-        { "f1", "not_exist_dir\\f1_link", ERROR_PATH_NOT_FOUND, TRUE }
+        { "f1", "not_exist_dir\\f1_link", ERROR_PATH_NOT_FOUND, FALSE }
     };
 
     ret = p_tr2_sys__Make_dir("tr2_test_dir");
@@ -1992,11 +1992,11 @@ static void test_tr2_sys__Symlink(void)
     }
 
     ok(DeleteFileA("f1"), "expect f1 to exist\n");
-    todo_wine ok(DeleteFileA("f1_link"), "expect f1_link to exist\n");
-    todo_wine ok(DeleteFileA("tr2_test_dir/f1_link"), "expect tr2_test_dir/f1_link to exist\n");
-    todo_wine ok(DeleteFileA("tr2_test_dir/f1_link_link"), "expect tr2_test_dir/f1_link_link to exist\n");
-    todo_wine ok(DeleteFileA("not_exist_link"), "expect not_exist_link to exist\n");
-    todo_wine ok(DeleteFileA("dir_link"), "expect dir_link to exist\n");
+    ok(DeleteFileA("f1_link"), "expect f1_link to exist\n");
+    ok(DeleteFileA("tr2_test_dir/f1_link"), "expect tr2_test_dir/f1_link to exist\n");
+    ok(DeleteFileA("tr2_test_dir/f1_link_link"), "expect tr2_test_dir/f1_link_link to exist\n");
+    ok(DeleteFileA("not_exist_link"), "expect not_exist_link to exist\n");
+    ok(DeleteFileA("dir_link"), "expect dir_link to exist\n");
     ret = p_tr2_sys__Remove_dir("tr2_test_dir");
     ok(ret == 1, "tr2_sys__Remove_dir(): expect 1 got %d\n", ret);
 }
@@ -2012,7 +2012,7 @@ static void test_tr2_sys__Unlink(void)
         int last_error;
         MSVCP_bool is_todo;
     } tests[] = {
-        { "tr2_test_dir\\f1_symlink", ERROR_SUCCESS, TRUE },
+        { "tr2_test_dir\\f1_symlink", ERROR_SUCCESS, FALSE },
         { "tr2_test_dir\\f1_link", ERROR_SUCCESS, FALSE },
         { "tr2_test_dir\\f1", ERROR_SUCCESS, FALSE },
         { "tr2_test_dir", ERROR_ACCESS_DENIED, FALSE },
diff --git a/dlls/msvcp140/tests/msvcp140.c b/dlls/msvcp140/tests/msvcp140.c
--- a/dlls/msvcp140/tests/msvcp140.c
+++ b/dlls/msvcp140/tests/msvcp140.c
@@ -987,9 +987,9 @@ static void test_Stat(void)
     ok(perms == expected_perms, "_Stat(): perms expect: 0%o, got 0%o\n", expected_perms, perms);
 
     if(ret) {
-        todo_wine ok(DeleteFileW(L"wine_test_dir\\f1_link"),
+        ok(DeleteFileW(L"wine_test_dir\\f1_link"),
                 "expect wine_test_dir/f1_link to exist\n");
-        todo_wine ok(RemoveDirectoryW(L"wine_test_dir\\dir_link"),
+        ok(RemoveDirectoryW(L"wine_test_dir\\dir_link"),
                 "expect wine_test_dir/dir_link to exist\n");
     }
     ok(DeleteFileW(L"wine_test_dir/f1"), "expect wine_test_dir/f1 to exist\n");
@@ -1110,7 +1110,7 @@ static void test_Unlink(void)
         int last_error;
         MSVCP_bool is_todo;
     } tests[] = {
-        { L"wine_test_dir\\f1_symlink", ERROR_SUCCESS, TRUE },
+        { L"wine_test_dir\\f1_symlink", ERROR_SUCCESS, FALSE },
         { L"wine_test_dir\\f1_link", ERROR_SUCCESS, FALSE },
         { L"wine_test_dir\\f1", ERROR_SUCCESS, FALSE },
         { L"wine_test_dir", ERROR_ACCESS_DENIED, FALSE },
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -4543,6 +4543,26 @@ static int sg_client_open( int root_fd, const char *unix_name, ACCESS_MASK acces
     if (fd == -1 && errno == EISDIR && ((access & SG_UNIX_WRITE_ACCESS) || (flags & O_CREAT)))
         fd = openat( root_fd, unix_name, O_RDONLY | O_NONBLOCK | O_CLOEXEC );
 
+    /* Stained Glass OS: a symbolic link opened as itself (FILE_OPEN_REPARSE_POINT,
+     * as DeleteFileW and RemoveDirectoryW open) whose target is missing, or that
+     * loops, is opened as the link -- O_PATH, never through it -- as on Windows,
+     * so that it can be deleted: deleting a dangling link failed with
+     * ERROR_FILE_NOT_FOUND. Nothing is created or truncated at its target. */
+    if (fd == -1 && (options & FILE_OPEN_REPARSE_POINT) && !(flags & O_TRUNC) &&
+        (errno == ENOENT || errno == ELOOP))
+    {
+        struct stat lst;
+        int err = errno;
+
+        if (!fstatat( root_fd, unix_name, &lst, AT_SYMLINK_NOFOLLOW ) && S_ISLNK( lst.st_mode ))
+#ifdef SG_MUTANT_DANGLING_LINK_FOLLOWS
+            fd = openat( root_fd, unix_name, O_PATH | O_CLOEXEC );
+#else
+            fd = openat( root_fd, unix_name, O_PATH | O_NOFOLLOW | O_CLOEXEC );
+#endif
+        if (fd == -1) errno = err;
+    }
+
     if (fd == -1)
     {
         size_t len = strlen( unix_name );
diff --git a/server/fd.c b/server/fd.c
--- a/server/fd.c
+++ b/server/fd.c
@@ -2310,6 +2310,24 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
                 fd->unix_fd = open( name, O_RDONLY | (flags & ~(O_TRUNC | O_CREAT | O_EXCL)), *mode );
         }
 
+        /* Stained Glass OS: a symbolic link opened as itself whose target is
+         * missing, or that loops, is opened as the link (O_PATH, never through
+         * it), so that it can be deleted, as on Windows */
+        if (fd->unix_fd == -1 && (options & FILE_OPEN_REPARSE_POINT) && !(flags & O_TRUNC) &&
+            (errno == ENOENT || errno == ELOOP))
+        {
+            struct stat lst;
+            int err = errno;
+
+            if (!lstat( name, &lst ) && S_ISLNK( lst.st_mode ))
+#ifdef SG_MUTANT_DANGLING_LINK_FOLLOWS
+                fd->unix_fd = open( name, O_PATH | O_CLOEXEC );
+#else
+                fd->unix_fd = open( name, O_PATH | O_NOFOLLOW | O_CLOEXEC );
+#endif
+            if (fd->unix_fd == -1) errno = err;
+        }
+
         if (fd->unix_fd == -1)
         {
             /* check for trailing slash on file path */
@@ -2330,13 +2348,16 @@ opened:
     if (client_created) sg_note_client_create( st.st_dev, st.st_ino );
 #endif
 
-    /* only bother with an inode for normal files and directories */
-    if (S_ISREG(st.st_mode) || S_ISDIR(st.st_mode))
+    /* only bother with an inode for normal files and directories, and for a
+     * symbolic link opened as itself (Stained Glass OS: its target is missing) */
+    if (S_ISREG(st.st_mode) || S_ISDIR(st.st_mode) ||
+        (S_ISLNK(st.st_mode) && (options & FILE_OPEN_REPARSE_POINT)))
     {
         unsigned int err;
         struct inode *inode;
         char *link_name = NULL;
         struct stat lst;
+        int is_link = S_ISLNK(st.st_mode), as_link;
 
         /* Stained Glass OS: a symbolic link opened as itself (FILE_OPEN_REPARSE_POINT,
          * as DeleteFileW and RemoveDirectoryW open) is an object of its own, as on
@@ -2347,6 +2368,15 @@ opened:
             link_name = sg_link_name( path );
             free( path );
         }
+        /* the link the fd is: never another one named by the client */
+        if (is_link && link_name && (lstat( link_name, &lst ) ||
+            lst.st_dev != st.st_dev || lst.st_ino != st.st_ino))
+        {
+            free( link_name );
+            link_name = NULL;
+        }
+        /* opened to be deleted */
+        as_link = link_name != NULL && (access & DELETE);
 #ifndef SG_MUTANT_LINK_SHARES_TARGET
         if (link_name && !lstat( link_name, &lst ) && S_ISLNK( lst.st_mode ))
             inode = get_inode( lst.st_dev, lst.st_ino, fd->unix_fd );
@@ -2388,13 +2418,17 @@ opened:
         list_add_head( &inode->open, &fd->inode_entry );
         closed_fd = NULL;
 
-        /* check directory options */
-        if ((options & FILE_DIRECTORY_FILE) && !S_ISDIR(st.st_mode))
+        /* check directory options. Stained Glass OS: not for a link opened as
+         * itself to be deleted -- whether it is a file or a directory link is not
+         * kept (a Unix link has no kind), so DeleteFileW removes a link to a
+         * folder, as Windows does for a file link, and RemoveDirectoryW a
+         * dangling one */
+        if ((options & FILE_DIRECTORY_FILE) && !S_ISDIR(st.st_mode) && !as_link)
         {
             set_error( STATUS_NOT_A_DIRECTORY );
             goto error;
         }
-        if ((options & FILE_NON_DIRECTORY_FILE) && S_ISDIR(st.st_mode))
+        if ((options & FILE_NON_DIRECTORY_FILE) && S_ISDIR(st.st_mode) && !as_link)
         {
             set_error( STATUS_FILE_IS_A_DIRECTORY );
             goto error;
diff --git a/server/file.c b/server/file.c
--- a/server/file.c
+++ b/server/file.c
@@ -359,6 +359,8 @@ static enum server_fd_type file_get_fd_type( struct fd *fd )
 
     if (S_ISREG(file->mode) || S_ISBLK(file->mode)) return FD_TYPE_FILE;
     if (S_ISDIR(file->mode)) return FD_TYPE_DIR;
+    /* Stained Glass OS: a symbolic link opened as itself (fd.c open_fd) */
+    if (S_ISLNK(file->mode)) return FD_TYPE_FILE;
     return FD_TYPE_CHAR;
 }
 
