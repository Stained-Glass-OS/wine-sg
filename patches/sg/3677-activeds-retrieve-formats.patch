From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] activeds: IADsPathname::Retrieve for the Windows and X.500 path formats (3677)

activeds: IADsPathname::Retrieve for the Windows and X.500 path formats

Retrieve now returns every ADS_FORMAT: the Windows ordered forms (root first,
elements separated by '/') with and without server, DN and parent, and the
X.500 no-server and parent forms. Distinguished names are split at unescaped
commas only.
---
diff --git a/dlls/activeds/pathname.c b/dlls/activeds/pathname.c
index 8142e47..cf73126 100644
--- a/dlls/activeds/pathname.c
+++ b/dlls/activeds/pathname.c
@@ -237,6 +237,85 @@ static HRESULT WINAPI path_SetDisplayType(IADsPathname *iface, LONG type)
     return E_NOTIMPL;
 }
 
+/* Split a distinguished name at its unescaped commas. */
+static WCHAR **split_dn(const WCHAR *dn, int *count)
+{
+    WCHAR **parts = NULL, *copy, *p, *start;
+    int n = 0;
+
+    *count = 0;
+    if (!dn || !*dn) return NULL;
+    if (!(copy = wcsdup(dn))) return NULL;
+    start = copy;
+    for (p = copy; ; p++)
+    {
+#ifndef ACT_MUT_ESC
+        if (*p == '\\' && p[1]) { p++; continue; }
+#endif
+        if (*p == ',' || !*p)
+        {
+            WCHAR **tmp = realloc(parts, (n + 1) * sizeof(*parts));
+            BOOL last = !*p;
+
+            if (!tmp) break;
+            parts = tmp;
+            *p = 0;
+            parts[n++] = wcsdup(start);
+            start = p + 1;
+            if (last) break;
+        }
+    }
+    free(copy);
+    *count = n;
+    return parts;
+}
+
+static void free_parts(WCHAR **parts, int count)
+{
+    while (count--) free(parts[count]);
+    free(parts);
+}
+
+/* The DN in X.500 order ("cn=bar,o=internet") or Windows order ("o=internet/cn=bar"),
+ * optionally without the first (leaf) element: the parent. */
+static WCHAR *format_dn(const WCHAR *dn, BOOL windows, BOOL parent)
+{
+    int count, i, first;
+    WCHAR **parts, *ret;
+    size_t len = 1;
+
+#ifdef ACT_MUT_ORDER
+    windows = FALSE;
+#endif
+#ifdef ACT_MUT_PARENT
+    parent = FALSE;
+#endif
+    first = parent ? 1 : 0;
+    parts = split_dn(dn, &count);
+
+    for (i = first; i < count; i++) len += wcslen(parts[i]) + 1;
+    if (!(ret = malloc(len * sizeof(WCHAR)))) { free_parts(parts, count); return NULL; }
+    ret[0] = 0;
+    if (windows)
+    {
+        for (i = count - 1; i >= first; i--)
+        {
+            wcscat(ret, parts[i]);
+            if (i > first) wcscat(ret, L"/");
+        }
+    }
+    else
+    {
+        for (i = first; i < count; i++)
+        {
+            wcscat(ret, parts[i]);
+            if (i < count - 1) wcscat(ret, L",");
+        }
+    }
+    free_parts(parts, count);
+    return ret;
+}
+
 static HRESULT WINAPI path_Retrieve(IADsPathname *iface, LONG type, BSTR *adspath)
 {
     Pathname *path = impl_from_IADsPathname(iface);
@@ -270,6 +349,48 @@ static HRESULT WINAPI path_Retrieve(IADsPathname *iface, LONG type, BSTR *adspat
         if (path->dn) wcscat(*adspath, path->dn);
         break;
 
+    case ADS_FORMAT_WINDOWS:
+    case ADS_FORMAT_WINDOWS_NO_SERVER:
+    case ADS_FORMAT_X500_NO_SERVER:
+    {
+        BOOL windows = type != ADS_FORMAT_X500_NO_SERVER;
+#ifdef ACT_MUT_SERVER
+        BOOL with_server = FALSE;
+#else
+        BOOL with_server = type == ADS_FORMAT_WINDOWS && path->server;
+#endif
+        WCHAR *dn = format_dn(path->dn, windows, FALSE);
+
+        if (!dn) { *adspath = NULL; break; }
+        len = wcslen(path->provider) + 3 + wcslen(dn) + 1;
+        if (with_server) len += wcslen(path->server) + 1;
+        *adspath = SysAllocStringLen(NULL, len);
+        if (*adspath)
+        {
+            wcscpy(*adspath, path->provider);
+            wcscat(*adspath, L"://");
+            if (with_server)
+            {
+                wcscat(*adspath, path->server);
+                wcscat(*adspath, L"/");
+            }
+            wcscat(*adspath, dn);
+        }
+        free(dn);
+        break;
+    }
+
+    case ADS_FORMAT_WINDOWS_DN:
+    case ADS_FORMAT_WINDOWS_PARENT:
+    case ADS_FORMAT_X500_PARENT:
+    {
+        WCHAR *dn = format_dn(path->dn, type != ADS_FORMAT_X500_PARENT, type != ADS_FORMAT_WINDOWS_DN);
+
+        *adspath = dn ? SysAllocString(dn) : NULL;
+        free(dn);
+        break;
+    }
+
     case ADS_FORMAT_PROVIDER:
         *adspath = SysAllocString(path->provider);
         break;
