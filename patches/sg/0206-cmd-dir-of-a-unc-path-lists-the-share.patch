From: Stained Glass OS <dev@stained-glass.example>
Subject: cmd: `dir \\server\share` lists the share

An argument starting with "\" was taken as relative to the current drive,
so `dir \\dc1\shared` listed Z:\dc1 ("Directory of Z:\dc1", "File not
found"). A UNC path is now complete as it is. The volume header and the
trailer are per root -- a drive's "X:\" or a share's "\\server\share\" --
and a share whose volume information is not available is listed without
a header instead of failing.

--- a/programs/cmd/directory.c
+++ b/programs/cmd/directory.c
@@ -631,6 +631,45 @@
  *
  */
 
+/* The root a listing's volume header and trailer are for: "X:\" or, for a
+ * UNC path, "\\server\share\". */
+static void dir_root(const WCHAR *path, WCHAR *root, size_t size)
+{
+    const WCHAR *p;
+    size_t len;
+
+    if (path[0] == '\\' && path[1] == '\\')
+    {
+        p = wcschr(path + 2, '\\');
+        if (p) p = wcschr(p + 1, '\\');
+        len = p ? p - path : wcslen(path);
+        if (len + 2 > size) len = size - 2;
+        memcpy(root, path, len * sizeof(WCHAR));
+        root[len++] = '\\';
+        root[len] = 0;
+        return;
+    }
+    root[0] = towupper(path[0]);
+    root[1] = ':';
+    root[2] = '\\';
+    root[3] = 0;
+}
+
+/* A UNC path's volume header ("Volume in drive \\server\share is ..."), when
+ * the share says; a share that does not is listed without one. */
+static void print_unc_volume_information(const WCHAR *root)
+{
+    WCHAR label[MAX_PATH], name[MAX_PATH];
+    DWORD serial;
+
+    if (!GetVolumeInformationW(root, label, ARRAY_SIZE(label), &serial, NULL, NULL, NULL, 0)) return;
+    lstrcpynW(name, root, ARRAY_SIZE(name));
+    if (name[0] && name[lstrlenW(name) - 1] == '\\') name[lstrlenW(name) - 1] = 0;
+    if (label[0]) WCMD_output(L"Volume in drive %1 is %2\n", name, label);
+    else WCMD_output(L"Volume in drive %1 has no label.\n", name);
+    WCMD_output(WCMD_LoadMessage(WCMD_VOLUMESERIALNO), HIWORD(serial), LOWORD(serial));
+}
+
