From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcr100: Export details::task_canceled.

msvcr100's details::task_canceled constructors: the class of patch 4546,
whose run-time type name in msvcr100 is in the details namespace (it
moved to Concurrency in msvcr110).
---
 dlls/msvcr100/msvcr100.spec | 12 ++++++------
 dlls/msvcrt/concurrency.c   |  7 +++++++
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/dlls/msvcr100/msvcr100.spec b/dlls/msvcr100/msvcr100.spec
index ac9cdb6..f81e808 100644
--- a/dlls/msvcr100/msvcr100.spec
+++ b/dlls/msvcr100/msvcr100.spec
@@ -224,12 +224,12 @@
 @ cdecl -arch=arm ??0scoped_lock_read@reader_writer_lock@Concurrency@@QAA@AAV12@@Z(ptr ptr) reader_writer_lock_scoped_lock_read_ctor
 @ thiscall -arch=i386 ??0scoped_lock_read@reader_writer_lock@Concurrency@@QAE@AAV12@@Z(ptr ptr) reader_writer_lock_scoped_lock_read_ctor
 @ cdecl -arch=win64 ??0scoped_lock_read@reader_writer_lock@Concurrency@@QEAA@AEAV12@@Z(ptr ptr) reader_writer_lock_scoped_lock_read_ctor
-@ stub -arch=arm ??0task_canceled@details@Concurrency@@QAA@PBD@Z
-@ stub -arch=i386 ??0task_canceled@details@Concurrency@@QAE@PBD@Z
-@ stub -arch=win64 ??0task_canceled@details@Concurrency@@QEAA@PEBD@Z
-@ stub -arch=arm ??0task_canceled@details@Concurrency@@QAA@XZ
-@ stub -arch=i386 ??0task_canceled@details@Concurrency@@QAE@XZ
-@ stub -arch=win64 ??0task_canceled@details@Concurrency@@QEAA@XZ
+@ cdecl -arch=arm ??0task_canceled@details@Concurrency@@QAA@PBD@Z(ptr str) task_canceled_ctor_str
+@ thiscall -arch=i386 ??0task_canceled@details@Concurrency@@QAE@PBD@Z(ptr str) task_canceled_ctor_str
+@ cdecl -arch=win64 ??0task_canceled@details@Concurrency@@QEAA@PEBD@Z(ptr str) task_canceled_ctor_str
+@ cdecl -arch=arm ??0task_canceled@details@Concurrency@@QAA@XZ(ptr) task_canceled_ctor
+@ thiscall -arch=i386 ??0task_canceled@details@Concurrency@@QAE@XZ(ptr) task_canceled_ctor
+@ cdecl -arch=win64 ??0task_canceled@details@Concurrency@@QEAA@XZ(ptr) task_canceled_ctor
 @ cdecl -arch=arm ??0unsupported_os@Concurrency@@QAA@PBD@Z(ptr str) unsupported_os_ctor_str
 @ thiscall -arch=i386 ??0unsupported_os@Concurrency@@QAE@PBD@Z(ptr str) unsupported_os_ctor_str
 @ cdecl -arch=win64 ??0unsupported_os@Concurrency@@QEAA@PEBD@Z(ptr str) unsupported_os_ctor_str
diff --git a/dlls/msvcrt/concurrency.c b/dlls/msvcrt/concurrency.c
index b8f5290..ea0328d 100644
--- a/dlls/msvcrt/concurrency.c
+++ b/dlls/msvcrt/concurrency.c
@@ -958,6 +958,7 @@ scheduler_not_attached* __thiscall scheduler_not_attached_ctor(scheduler_not_att
 
 /* ??0task_canceled@Concurrency@@QAE@PBD@Z */
 /* ??0task_canceled@Concurrency@@QEAA@PEBD@Z */
+/* ??0task_canceled@details@Concurrency@@QAE@PBD@Z */
 DEFINE_THISCALL_WRAPPER(task_canceled_ctor_str, 8)
 task_canceled* __thiscall task_canceled_ctor_str(task_canceled *this, const char *str)
 {
@@ -1078,8 +1079,14 @@ DEFINE_RTTI_DATA1(operation_timed_out, 0, &cexception_rtti_base_descriptor,
         ".?AVoperation_timed_out@Concurrency@@")
 DEFINE_RTTI_DATA1(scheduler_not_attached, 0, &cexception_rtti_base_descriptor,
         ".?AVscheduler_not_attached@Concurrency@@")
+#if _MSVCR_VER == 100 && !defined(SG_MUTANT_TASK_CANCELED_NAME)
+/* msvcr100 has it in the details namespace */
+DEFINE_RTTI_DATA1(task_canceled, 0, &cexception_rtti_base_descriptor,
+        ".?AVtask_canceled@details@Concurrency@@")
+#else
 DEFINE_RTTI_DATA1(task_canceled, 0, &cexception_rtti_base_descriptor,
         ".?AVtask_canceled@Concurrency@@")
+#endif
 DEFINE_RTTI_DATA1(unsupported_os, 0, &cexception_rtti_base_descriptor,
         ".?AVunsupported_os@Concurrency@@")
 #if _MSVCR_VER >= 110
