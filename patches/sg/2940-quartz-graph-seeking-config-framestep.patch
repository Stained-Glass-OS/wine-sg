+static struct filter *find_filter(struct filter_graph *graph, IBaseFilter *filter)
+{
+    struct filter *entry;
+
+    LIST_FOR_EACH_ENTRY(entry, &graph->filters, struct filter, entry)
+    {
+        if (entry->filter == filter)
+            return entry;
+    }
+    return NULL;
+}
+
+static struct filter *find_cached_filter(struct filter_graph *graph, IBaseFilter *filter)
+{
+    struct filter *entry;
+
+    LIST_FOR_EACH_ENTRY(entry, &graph->cache, struct filter, entry)
+    {
+        if (entry->filter == filter)
+            return entry;
+    }
+    return NULL;
+}
