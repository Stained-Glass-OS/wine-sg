+/* Connect |source| to |sink| through the pins of |filter|: |source| goes to one of
+ * its input pins, and one of its output pins goes to |sink|. */
+static HRESULT reconnect_through_filter(struct filter_graph *graph, IPin *source, IPin *sink,
+        const AM_MEDIA_TYPE *mt, IBaseFilter *filter)
+{
+    IFilterGraph2 *iface = &graph->IFilterGraph2_iface;
+    IPin *in_pin, *out_pin;
+    IEnumPins *in_enum, *out_enum;
+    HRESULT hr = VFW_E_CANNOT_CONNECT;
+    PIN_DIRECTION dir;
+
+    if (FAILED(IBaseFilter_EnumPins(filter, &in_enum)))
+        return VFW_E_CANNOT_CONNECT;
+
+    while (hr != S_OK && IEnumPins_Next(in_enum, 1, &in_pin, NULL) == S_OK)
+    {
+        if (SUCCEEDED(IPin_QueryDirection(in_pin, &dir)) && dir == PINDIR_INPUT
+                && SUCCEEDED(IFilterGraph2_ConnectDirect(iface, source, in_pin, mt)))
+        {
+            if (SUCCEEDED(IBaseFilter_EnumPins(filter, &out_enum)))
+            {
+                while (hr != S_OK && IEnumPins_Next(out_enum, 1, &out_pin, NULL) == S_OK)
+                {
+                    if (SUCCEEDED(IPin_QueryDirection(out_pin, &dir)) && dir == PINDIR_OUTPUT
+                            && SUCCEEDED(IFilterGraph2_Connect(iface, out_pin, sink)))
+                        hr = S_OK;
+                    IPin_Release(out_pin);
+                }
+                IEnumPins_Release(out_enum);
+            }
+            if (hr != S_OK)
+                IFilterGraph2_Disconnect(iface, in_pin);
+        }
+        IPin_Release(in_pin);
+    }
+    IEnumPins_Release(in_enum);
+    return hr;
+}
