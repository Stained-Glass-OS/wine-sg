From: Stained Glass OS <dev@stained-glass.example>
Subject: taskmgr, wmplayer: hand off to the App Paths programs

sg-shell registers its Task Manager and Media Player in App Paths for
taskmgr.exe and wmplayer.exe, which ShellExecute and the Run box follow. A
program that starts system32\taskmgr.exe or Program Files' wmplayer.exe
itself got Wine's NT4-era Task Manager, or wmplayer's stub, which does
nothing. Now each, when App Paths names another existing program (not
itself, not one in a system directory), starts that one with the same
arguments and exits, as control.exe does (0072). With nothing registered,
Wine's Task Manager runs as before.

Gate: test/handoff-gate.sh.
---
--- a/programs/taskmgr/taskmgr.c
+++ b/programs/taskmgr/taskmgr.c
@@ -981,6 +981,55 @@
     return 0;
 }
 
+/* Stained Glass OS: when App Paths registers another program for NAME
+ * (sg-shell's), start it with this command line's arguments instead, so
+ * programs and scripts that run NAME with CreateProcess -- which never reads
+ * App Paths -- get the same one as ShellExecute and the Run box. Never a
+ * program in a system directory: no loop. */
+static BOOL hand_off( const WCHAR *name )
+{
+    WCHAR key[MAX_PATH], target[MAX_PATH], self[MAX_PATH], dir[MAX_PATH], *cmd;
+    const WCHAR *args = GetCommandLineW();
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    DWORD size = sizeof(target);
+    HKEY hkey;
+    size_t len;
+    UINT i;
+
+    swprintf( key, ARRAY_SIZE(key), L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\%s", name );
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, key, 0, KEY_QUERY_VALUE | KEY_WOW64_64KEY, &hkey )) return FALSE;
+    i = RegGetValueW( hkey, NULL, NULL, RRF_RT_REG_SZ, NULL, target, &size );
+    RegCloseKey( hkey );
+    if (i || GetFileAttributesW( target ) == INVALID_FILE_ATTRIBUTES) return FALSE;
+    if (GetModuleFileNameW( NULL, self, MAX_PATH ) && !wcsicmp( target, self )) return FALSE;
+    for (i = 0; i < 2; i++)
+    {
+        size_t n;
+        if (!(i ? GetSystemWow64DirectoryW( dir, MAX_PATH ) : GetSystemDirectoryW( dir, MAX_PATH ))) continue;
+        n = wcslen( dir );
+        if (!wcsnicmp( target, dir, n ) && target[n] == '\\' && !wcschr( target + n + 1, '\\' )) return FALSE;
+    }
+
+    /* this command line without the program's name */
+    if (*args == '"') { args++; while (*args && *args != '"') args++; if (*args) args++; }
+    else while (*args && *args != ' ' && *args != '\t') args++;
+    while (*args == ' ' || *args == '\t') args++;
+
+    len = wcslen( target ) + wcslen( args ) + 4;
+    if (!(cmd = malloc( len * sizeof(WCHAR) ))) return FALSE;
+    swprintf( cmd, len, L"\"%s\"%s%s", target, *args ? L" " : L"", args );
+    if (!CreateProcessW( target, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ))
+    {
+        free( cmd );
+        return FALSE;
+    }
+    CloseHandle( pi.hThread );
+    CloseHandle( pi.hProcess );
+    free( cmd );
+    return TRUE;
+}
+
 int APIENTRY WinMain(HINSTANCE hInstance,
                      HINSTANCE hPrevInstance,
                      LPSTR     lpCmdLine,
@@ -990,6 +1039,8 @@
     HANDLE hToken; 
     TOKEN_PRIVILEGES tkp; 
 
+    if (hand_off( L"taskmgr.exe" )) return 0;
+
     InitCommonControls();
 
     /* Initialize global variables */
