From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9: conversions to fewer bits per channel round to the nearest value

D3DXLoadSurfaceFromMemory and the other surface loads converted between formats of the same
component types (unsigned normalised) with bit shifts, which drop the low bits: a 16 bit channel
loaded into 8 bits was truncated. The Wine tests record that native rounds to the nearest value
(0x07d2 of 0xffff gives 8 of 255, not 7).

 - Conversions in which a channel gets fewer bits than it had go through the float path,
   which rounds. Conversions that only widen or re-order channels keep the fast path.
 - Removed the todo marks of six pixels in surface.c (G16R16, A2R10G10B10 and A8B8G8R8 loaded
   into A8R8G8B8 and A1R5G5B5).
---
--- a/dlls/d3dx9_36/surface.c
+++ b/dlls/d3dx9_36/surface.c
@@ -2341,6 +2341,7 @@ void convert_argb_pixels(const BYTE *src, UINT src_row_pitch, UINT src_slice_pit
     DWORD channels[4];
     UINT min_width, min_height, min_depth;
     UINT x, y, z;
+    BOOL narrows = FALSE;
 
     TRACE("src %p, src_row_pitch %u, src_slice_pitch %u, src_size %p, src_format %p, dst %p, "
             "dst_row_pitch %u, dst_slice_pitch %u, dst_size %p, dst_format %p, color_key 0x%08lx, palette %p.\n",
@@ -2350,6 +2351,17 @@ void convert_argb_pixels(const BYTE *src, UINT src_row_pitch, UINT src_slice_pit
     ZeroMemory(channels, sizeof(channels));
     init_argb_conversion_info(src_format, dst_format, &conv_info);
 
+    /* A channel that gets fewer bits is rounded to the nearest value; the bit shifts of the fast
+       path truncate. */
+    for (x = 0; x < 4; ++x)
+    {
+        if (dst_format->bits[x] && src_format->bits[x] > dst_format->bits[x])
+            narrows = TRUE;
+    }
+#ifdef SG_MUTANT_D3DXCONV_TRUNCATE
+    narrows = FALSE;
+#endif
+
     min_width = min(src_size->width, dst_size->width);
     min_height = min(src_size->height, dst_size->height);
     min_depth = min(src_size->depth, dst_size->depth);
@@ -2371,7 +2383,8 @@ void convert_argb_pixels(const BYTE *src, UINT src_row_pitch, UINT src_slice_pit
 
             for (x = 0; x < min_width; x++) {
                 if (format_types_match(src_format, dst_format)
-                        && src_format->bytes_per_pixel <= 4 && dst_format->bytes_per_pixel <= 4)
+                        && src_format->bytes_per_pixel <= 4 && dst_format->bytes_per_pixel <= 4
+                        && !narrows)
                 {
                     DWORD val;
 
