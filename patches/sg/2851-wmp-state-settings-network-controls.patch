+static int find_proxy_protocol(const WCHAR *protocol)
+{
+    static const WCHAR *const protocols[] = {L"http", L"mms", L"rtsp"};
+    unsigned int i;
+
+    if (!protocol)
+        return -1;
+    for (i = 0; i < ARRAY_SIZE(protocols); i++)
+    {
+        if (!_wcsicmp(protocol, protocols[i]))
+#ifdef SG_MUTANT_WMP_PROXY_SHARED
+            return 0;
+#else
+            return i;
+#endif
+    }
+    return -1;
 }
 
