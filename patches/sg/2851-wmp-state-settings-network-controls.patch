+static inline HRESULT return_bstr_empty(const WCHAR *value, BSTR *p)
+{
+    return return_bstr(value ? value : L"", p);
+}
+
+static HRESULT set_bstr(BSTR *dst, BSTR src)
+{
+    BSTR copy = NULL;
+
+    if (src && !(copy = SysAllocStringLen(src, SysStringLen(src))))
+        return E_OUTOFMEMORY;
+    SysFreeString(*dst);
+    *dst = copy;
+    return S_OK;
+}
+
+static HRESULT return_bool(VARIANT_BOOL value, VARIANT_BOOL *p)
+{
+    if (!p)
+        return E_POINTER;
+    *p = value;
+    return S_OK;
+}
+
+static BOOL is_playing_state(WMPPlayState state)
+{
+    return state == wmppsPlaying || state == wmppsScanForward || state == wmppsScanReverse
+            || state == wmppsBuffering || state == wmppsWaiting;
+}
