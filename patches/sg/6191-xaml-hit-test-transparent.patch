From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: the pointer passes through what draws nothing

Clicks on Windows Terminal's new-tab button and tabs did nothing: empty Grids of its title bar lie over them, and our hit testing took any element under the pointer. As on Windows, a panel or a border now takes the pointer only where it draws a background (or a border's brush), and a templated control, a content presenter or a user control only through what they show; text, shapes, images and our own drawn controls take it where they are. A Transparent background still takes it.
---
diff --git a/dlls/windows.ui.xaml/input.c b/dlls/windows.ui.xaml/input.c
index 1ac020a..e268758 100644
--- a/dlls/windows.ui.xaml/input.c
+++ b/dlls/windows.ui.xaml/input.c
@@ -62,6 +62,44 @@ static BOOL hit_testable( struct uielem *elem )
 }
 
 /* the topmost element at a point (x, y in the parent's coordinates) */
+static BOOL has_iface( struct uielem *elem, const GUID *iid )
+{
+    const struct xclass *cls = elem->d.obj.cls;
+    unsigned int i;
+
+    for (i = 0; cls && i < cls->count; i++) if (cls->ifaces[i].iid == iid) return TRUE;
+    return FALSE;
+}
+
+static BOOL has_value( struct uielem *elem, const WCHAR *owner, const WCHAR *name )
+{
+    struct xaml_property *prop = xaml_property_find( owner, name );
+    IInspectable *box = NULL;
+
+    if (!prop) return FALSE;
+    dobj_get_value( &elem->d, prop, &box );
+    if (box) IInspectable_Release( box );
+    return box != NULL;
+}
+
+/* whether an element takes the pointer where it is itself, not only through its children: as on
+ * Windows, a panel or a border only with a background (or a border's brush), a templated control and
+ * a content presenter or user control only through what they show; everything else (text, shapes,
+ * images, our own drawn controls) where it is */
+static BOOL hits_self( struct uielem *elem )
+{
+#ifdef SG_MUTANT_HIT_TRANSPARENT
+    return TRUE;
+#endif
+    if (has_iface( elem, &IID_IPanel )) return has_value( elem, L"Windows.UI.Xaml.Controls.Panel", L"Background" );
+    if (has_iface( elem, &IID_IBorder ))
+        return has_value( elem, L"Windows.UI.Xaml.Controls.Border", L"Background" ) ||
+               has_value( elem, L"Windows.UI.Xaml.Controls.Border", L"BorderBrush" );
+    if (xaml_is_presenter( elem ) || has_iface( elem, &IID_IUserControl )) return FALSE;
+    if (is_control( &elem->d ) && control_from_elem( elem ) && control_from_elem( elem )->template_root) return FALSE;
+    return TRUE;
+}
+
 static struct uielem *hit_test( struct uielem *elem, FLOAT x, FLOAT y )
 {
     struct uielem *child, *hit;
@@ -74,7 +112,7 @@ static struct uielem *hit_test( struct uielem *elem, FLOAT x, FLOAT y )
 #ifdef SG_MUTANT_INPUT_NO_HIT
     return NULL;
 #endif
-    if (x >= 0 && y >= 0 && x < elem->render.width && y < elem->render.height) return elem;
+    if (x >= 0 && y >= 0 && x < elem->render.width && y < elem->render.height && hits_self( elem )) return elem;
     return NULL;
 }
 
