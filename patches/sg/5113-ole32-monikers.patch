From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ole32: file moniker ParseDisplayName, anti-moniker name with a left moniker (patch 5113)

Gap-CORE items 460 and 461. Gate with two mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/ole32/filemoniker.c b/dlls/ole32/filemoniker.c
--- a/dlls/ole32/filemoniker.c
+++ b/dlls/ole32/filemoniker.c
@@ -1164,8 +1164,27 @@
 FileMonikerImpl_ParseDisplayName(IMoniker* iface, IBindCtx* pbc, IMoniker* pmkToLeft,
                      LPOLESTR pszDisplayName, ULONG* pchEaten, IMoniker** ppmkOut)
 {
-    FIXME("(%p,%p,%p,%p,%p,%p),stub!\n",iface,pbc,pmkToLeft,pszDisplayName,pchEaten,ppmkOut);
+    IParseDisplayName *parser;
+    HRESULT hr;
+
+    TRACE("(%p,%p,%p,%p,%p,%p)\n",iface,pbc,pmkToLeft,pszDisplayName,pchEaten,ppmkOut);
+
+    if (!ppmkOut || !pchEaten) return E_POINTER;
+    *ppmkOut = NULL;
+    *pchEaten = 0;
+
+    /* The file is the object that knows how to read the rest of the name ("file!item"): the moniker
+     * is bound to it (through the running object table or the file's class), as for a class moniker. */
+#ifdef SG_MUTANT_FILE_PARSE
     return E_NOTIMPL;
+#endif
+    if (SUCCEEDED(hr = IMoniker_BindToObject(iface, pbc, pmkToLeft, &IID_IParseDisplayName, (void **)&parser)))
+    {
+        hr = IParseDisplayName_ParseDisplayName(parser, pbc, pszDisplayName, pchEaten, ppmkOut);
+        IParseDisplayName_Release(parser);
+    }
+
+    return hr;
 }
 
 /******************************************************************************
diff --git a/dlls/ole32/antimoniker.c b/dlls/ole32/antimoniker.c
--- a/dlls/ole32/antimoniker.c
+++ b/dlls/ole32/antimoniker.c
@@ -457,10 +457,10 @@
     if (!displayname)
         return E_POINTER;
 
-    if (pmkToLeft!=NULL){
-        FIXME("() pmkToLeft!=NULL not implemented\n");
-        return E_NOTIMPL;
-    }
+    /* The name of an anti-moniker is the same whatever is to its left: one "\\.." per level. */
+#ifdef SG_MUTANT_ANTI_LEFT
+    if (pmkToLeft) return E_NOTIMPL;
+#endif
 
     *displayname = ptrW = CoTaskMemAlloc((moniker->count * ARRAY_SIZE(nameW) + 1) * sizeof(WCHAR));
     if (!*displayname)
