+/* ---- Direct3D11CaptureFramePool -------------------------------------------- */
+
+struct frame_pool
+{
+    IDirect3D11CaptureFramePool IDirect3D11CaptureFramePool_iface;
+    IClosable IClosable_iface;
+    IWeakReferenceSource IWeakReferenceSource_iface;
+    struct weak_holder *weak;
+    LONG ref;
+    CRITICAL_SECTION cs;
+
+    IDirect3DDevice *device;      /* the program's WinRT device */
+    ID3D11Device *d3d11;
+    ID3D11DeviceContext *context;
+    INT32 buffers;
+    SizeInt32 size;
+    BOOL closed;
+
+    struct capture_frame **ready; /* frames not taken yet, oldest first */
+    UINT ready_count;
+    struct handler_list arrived;
+};
+
+static inline struct frame_pool *impl_from_IDirect3D11CaptureFramePool( IDirect3D11CaptureFramePool *iface )
+{
+    return CONTAINING_RECORD( iface, struct frame_pool, IDirect3D11CaptureFramePool_iface );
+}
+
+static void pool_drop_frames( struct frame_pool *pool )
+{
+    UINT i;
+    for (i = 0; i < pool->ready_count; i++) IDirect3D11CaptureFrame_Release( &pool->ready[i]->IDirect3D11CaptureFrame_iface );
+    pool->ready_count = 0;
+}
+
+static HRESULT pool_set_device( struct frame_pool *pool, IDirect3DDevice *device )
+{
+    IDirect3DDxgiInterfaceAccess *access;
+    ID3D11Device *d3d11;
+    HRESULT hr;
+
+    if (!device) return E_INVALIDARG;
+    if (FAILED(hr = IDirect3DDevice_QueryInterface( device, &IID_IDirect3DDxgiInterfaceAccess, (void **)&access )))
+        return E_INVALIDARG;
+    hr = IDirect3DDxgiInterfaceAccess_GetInterface( access, &IID_ID3D11Device, (void **)&d3d11 );
+    IDirect3DDxgiInterfaceAccess_Release( access );
+    if (FAILED(hr)) return E_INVALIDARG;
+
+    if (pool->context) ID3D11DeviceContext_Release( pool->context );
+    if (pool->d3d11) ID3D11Device_Release( pool->d3d11 );
+    if (pool->device) IDirect3DDevice_Release( pool->device );
+    IDirect3DDevice_AddRef( (pool->device = device) );
+    pool->d3d11 = d3d11;
+    ID3D11Device_GetImmediateContext( d3d11, &pool->context );
+    return S_OK;
+}
+
+static HRESULT WINAPI pool_QueryInterface( IDirect3D11CaptureFramePool *iface, REFIID iid, void **out )
+{
+    struct frame_pool *impl = impl_from_IDirect3D11CaptureFramePool( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IDirect3D11CaptureFramePool ))
+    {
+        *out = &impl->IDirect3D11CaptureFramePool_iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IClosable ))
+    {
+        *out = &impl->IClosable_iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IWeakReferenceSource ))
+    {
+        *out = &impl->IWeakReferenceSource_iface;
+        IWeakReferenceSource_AddRef( &impl->IWeakReferenceSource_iface );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI pool_AddRef( IDirect3D11CaptureFramePool *iface )
+{
+    struct frame_pool *impl = impl_from_IDirect3D11CaptureFramePool( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI pool_Release( IDirect3D11CaptureFramePool *iface )
+{
+    struct frame_pool *impl = impl_from_IDirect3D11CaptureFramePool( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        weak_holder_detach( &impl->weak );
+        pool_drop_frames( impl );
+        free( impl->ready );
+        handlers_clear( &impl->arrived );
+        if (impl->context) ID3D11DeviceContext_Release( impl->context );
+        if (impl->d3d11) ID3D11Device_Release( impl->d3d11 );
+        if (impl->device) IDirect3DDevice_Release( impl->device );
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
