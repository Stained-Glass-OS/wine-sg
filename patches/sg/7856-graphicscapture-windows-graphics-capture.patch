+/*
+ * A capture item is a monitor or a window (IGraphicsCaptureItemInterop). A
+ * session started on a frame pool reads the item's part of the screen as it
+ * is shown -- through the screen device context, which Stained Glass OS's
+ * winex11 (7857) takes from the compositor's screen capture, the one every
+ * program gets: the lock screen and consent prompts black -- about sixty
+ * times a second, and a picture that changed becomes the pool's next frame:
+ * a B8G8R8A8 Direct3D 11 texture of the pool's device, wrapped as an
+ * IDirect3DSurface (sgd3dinterop, 7854), with FrameArrived raised. The
+ * pointer is drawn into the picture while IsCursorCaptureEnabled is on, as
+ * Windows does. A window that is closed closes its item (Closed) and ends
+ * the frames.
+ *
+ * Unlike Windows: a window's picture is its rectangle of the screen, so what
+ * covers it is in the picture too; the handlers of a pool made with Create
+ * are called on the capture thread, as for CreateFreeThreaded; only
+ * B8G8R8A8UIntNormalized frames; no dirty regions; IsBorderRequired is kept
+ * but no yellow border is drawn (the compositor has no such frame for
+ * ordinary programs).
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+#include "unixlib.h"
+
+
+WINE_DEFAULT_DEBUG_CHANNEL(capture);
+
+#ifndef CAPTUREBLT
+#define CAPTUREBLT 0x40000000
+#endif
+
+/* sgd3dinterop (7854) has no import library */
+static HRESULT create_surface( IDXGISurface *surface, IInspectable **out )
+{
+    static HRESULT (WINAPI *pCreateDirect3D11SurfaceFromDXGISurface)( IDXGISurface *, IInspectable ** );
+
+    if (!pCreateDirect3D11SurfaceFromDXGISurface)
+    {
+        HMODULE module = LoadLibraryW( L"sgd3dinterop.dll" );
+        if (module) pCreateDirect3D11SurfaceFromDXGISurface = (void *)GetProcAddress( module, "CreateDirect3D11SurfaceFromDXGISurface" );
+        if (!pCreateDirect3D11SurfaceFromDXGISurface) return E_NOTIMPL;
+    }
+    return pCreateDirect3D11SurfaceFromDXGISurface( surface, out );
+}
+
+/* B8G8R8A8UIntNormalized */
+#define PIXEL_FORMAT_BGRA8 87
+
+/* ---- event handler lists ------------------------------------------------- */
+
+struct handler_entry
+{
+    IUnknown *handler;   /* a TypedEventHandler<,>, called through its Invoke */
+    INT64 token;
+};
+
+struct handler_list
+{
+    struct handler_entry *entries;
+    UINT count, size;
+    INT64 next_token;
+};
+
+static HRESULT handlers_add( struct handler_list *list, IUnknown *handler, EventRegistrationToken *token )
+{
+    if (!handler || !token) return E_POINTER;
+    if (list->count == list->size)
+    {
+        UINT size = list->size ? list->size * 2 : 4;
+        struct handler_entry *e = realloc( list->entries, size * sizeof(*e) );
+        if (!e) return E_OUTOFMEMORY;
+        list->entries = e;
+        list->size = size;
+    }
+    IUnknown_AddRef( handler );
+    list->entries[list->count].handler = handler;
+    list->entries[list->count].token = ++list->next_token;
+    token->value = list->entries[list->count++].token;
+    return S_OK;
+}
+
+static HRESULT handlers_remove( struct handler_list *list, EventRegistrationToken token )
+{
+    UINT i;
+    for (i = 0; i < list->count; i++)
+    {
+        if (list->entries[i].token != token.value) continue;
+        IUnknown_Release( list->entries[i].handler );
+        memmove( &list->entries[i], &list->entries[i + 1], (list->count - i - 1) * sizeof(*list->entries) );
+        list->count--;
+        return S_OK;
+    }
+    return S_OK;
+}
+
+static void handlers_clear( struct handler_list *list )
+{
+    UINT i;
+    for (i = 0; i < list->count; i++) IUnknown_Release( list->entries[i].handler );
+    free( list->entries );
+    memset( list, 0, sizeof(*list) );
+}
+
+/* a copy of the handlers, to be called outside the lock */
+static UINT handlers_copy( struct handler_list *list, IUnknown ***out )
+{
+    UINT i;
+    *out = NULL;
+    if (!list->count || !(*out = malloc( list->count * sizeof(**out) ))) return 0;
+    for (i = 0; i < list->count; i++)
+    {
+        (*out)[i] = list->entries[i].handler;
+        IUnknown_AddRef( (*out)[i] );
+    }
+    return list->count;
+}
+
+/* IWeakReferenceSource, as C++/WinRT programs need for the events they
+ * register (OBS: the item's Closed, the pool's FrameArrived) */
+#define DEFINE_WEAK_SOURCE( pfx, impl_type, base_expr )                                            \
+    static inline impl_type *pfx##_from_IWeakReferenceSource( IWeakReferenceSource *iface )        \
+    {                                                                                              \
+        return CONTAINING_RECORD( iface, impl_type, IWeakReferenceSource_iface );                  \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_weak_QueryInterface( IWeakReferenceSource *iface, REFIID iid, void **out ) \
+    {                                                                                              \
+        impl_type *impl = pfx##_from_IWeakReferenceSource( iface );                                \
+        return IInspectable_QueryInterface( (IInspectable *)(base_expr), iid, out );               \
+    }                                                                                              \
+    static ULONG WINAPI pfx##_weak_AddRef( IWeakReferenceSource *iface )                           \
+    {                                                                                              \
+        impl_type *impl = pfx##_from_IWeakReferenceSource( iface );                                \
+        return IInspectable_AddRef( (IInspectable *)(base_expr) );                                 \
+    }                                                                                              \
+    static ULONG WINAPI pfx##_weak_Release( IWeakReferenceSource *iface )                          \
+    {                                                                                              \
+        impl_type *impl = pfx##_from_IWeakReferenceSource( iface );                                \
+        return IInspectable_Release( (IInspectable *)(base_expr) );                                \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_weak_GetWeakReference( IWeakReferenceSource *iface, IWeakReference **out ) \
+    {                                                                                              \
+        impl_type *impl = pfx##_from_IWeakReferenceSource( iface );                                \
+        return weak_holder_get_reference( &impl->weak, (IUnknown *)(base_expr), &impl->ref, out ); \
+    }                                                                                              \
+    static const struct IWeakReferenceSourceVtbl pfx##_weak_vtbl =                                 \
+    {                                                                                              \
+        pfx##_weak_QueryInterface,                                                                 \
+        pfx##_weak_AddRef,                                                                         \
+        pfx##_weak_Release,                                                                        \
+        pfx##_weak_GetWeakReference,                                                               \
+    };
+
+/* ---- GraphicsCaptureItem --------------------------------------------------- */
+
+struct capture_item
+{
+    IGraphicsCaptureItem IGraphicsCaptureItem_iface;
+    IWeakReferenceSource IWeakReferenceSource_iface;
+    struct weak_holder *weak;
+    LONG ref;
+    HWND window;          /* a window's item, else a monitor's */
+    HMONITOR monitor;
+    CRITICAL_SECTION cs;
+    struct handler_list closed;
+    BOOL is_closed;
+};
+
+static inline struct capture_item *impl_from_IGraphicsCaptureItem( IGraphicsCaptureItem *iface )
+{
+    return CONTAINING_RECORD( iface, struct capture_item, IGraphicsCaptureItem_iface );
+}
+
+/* where the item is on the screen now (virtual screen coordinates) */
+static BOOL item_rect( struct capture_item *item, RECT *rect )
+{
+    if (item->window)
+    {
+        if (!IsWindow( item->window )) return FALSE;
+        if (FAILED(DwmGetWindowAttribute( item->window, DWMWA_EXTENDED_FRAME_BOUNDS, rect, sizeof(*rect) )))
+            GetWindowRect( item->window, rect );
+        return TRUE;
+    }
+    else
+    {
+        MONITORINFO info = { sizeof(info) };
+        if (!GetMonitorInfoW( item->monitor, &info )) return FALSE;
+        *rect = info.rcMonitor;
+        return TRUE;
+    }
+}
+
+static HRESULT WINAPI item_QueryInterface( IGraphicsCaptureItem *iface, REFIID iid, void **out )
+{
+    struct capture_item *impl = impl_from_IGraphicsCaptureItem( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IWeakReferenceSource ))
+    {
+        *out = &impl->IWeakReferenceSource_iface;
+        IWeakReferenceSource_AddRef( &impl->IWeakReferenceSource_iface );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IGraphicsCaptureItem ))
+    {
+        *out = &impl->IGraphicsCaptureItem_iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI item_AddRef( IGraphicsCaptureItem *iface )
+{
+    struct capture_item *impl = impl_from_IGraphicsCaptureItem( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI item_Release( IGraphicsCaptureItem *iface )
+{
+    struct capture_item *impl = impl_from_IGraphicsCaptureItem( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        weak_holder_detach( &impl->weak );
+        handlers_clear( &impl->closed );
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI item_GetIids( IGraphicsCaptureItem *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI item_GetRuntimeClassName( IGraphicsCaptureItem *iface, HSTRING *class_name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Graphics_Capture_GraphicsCaptureItem,
+                                wcslen( RuntimeClass_Windows_Graphics_Capture_GraphicsCaptureItem ), class_name );
+}
+
+static HRESULT WINAPI item_GetTrustLevel( IGraphicsCaptureItem *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+/* a window's title; a monitor's name, as the display settings show it */
+static HRESULT WINAPI item_get_DisplayName( IGraphicsCaptureItem *iface, HSTRING *value )
+{
+    struct capture_item *impl = impl_from_IGraphicsCaptureItem( iface );
+    WCHAR name[256] = {0};
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (impl->window) GetWindowTextW( impl->window, name, ARRAY_SIZE(name) );
+    else
+    {
+        MONITORINFOEXW info = { sizeof(info) };
+        DISPLAY_DEVICEW device = { sizeof(device) };
+        if (GetMonitorInfoW( impl->monitor, (MONITORINFO *)&info ))
+        {
+            if (EnumDisplayDevicesW( info.szDevice, 0, &device, 0 )) wcscpy( name, device.DeviceString );
+            else wcscpy( name, info.szDevice );
+        }
+    }
+    return WindowsCreateString( name, wcslen( name ), value );
+}
+
+static HRESULT WINAPI item_get_Size( IGraphicsCaptureItem *iface, SizeInt32 *value )
+{
+    struct capture_item *impl = impl_from_IGraphicsCaptureItem( iface );
+    RECT rect;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (!item_rect( impl, &rect )) SetRectEmpty( &rect );
+    value->Width = rect.right - rect.left;
+    value->Height = rect.bottom - rect.top;
+    return S_OK;
+}
+
+static HRESULT WINAPI item_add_Closed( IGraphicsCaptureItem *iface, ITypedEventHandler_GraphicsCaptureItem_IInspectable *handler,
+                                       EventRegistrationToken *token )
+{
+    struct capture_item *impl = impl_from_IGraphicsCaptureItem( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    EnterCriticalSection( &impl->cs );
+    hr = handlers_add( &impl->closed, (IUnknown *)handler, token );
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI item_remove_Closed( IGraphicsCaptureItem *iface, EventRegistrationToken token )
+{
+    struct capture_item *impl = impl_from_IGraphicsCaptureItem( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+
+    EnterCriticalSection( &impl->cs );
+    hr = handlers_remove( &impl->closed, token );
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+DEFINE_WEAK_SOURCE( item, struct capture_item, &impl->IGraphicsCaptureItem_iface )
+
+static const struct IGraphicsCaptureItemVtbl item_vtbl =
+{
+    item_QueryInterface,
+    item_AddRef,
+    item_Release,
+    /* IInspectable methods */
+    item_GetIids,
+    item_GetRuntimeClassName,
+    item_GetTrustLevel,
+    /* IGraphicsCaptureItem methods */
+    item_get_DisplayName,
+    item_get_Size,
+    item_add_Closed,
+    item_remove_Closed,
+};
+
+/* the window is gone: Closed, once */
+static void item_close( struct capture_item *item )
+{
+    IUnknown **handlers;
+    UINT i, count;
+
+    EnterCriticalSection( &item->cs );
+    if (item->is_closed) count = 0;
+    else
+    {
+        item->is_closed = TRUE;
+        count = handlers_copy( &item->closed, &handlers );
+    }
+    LeaveCriticalSection( &item->cs );
+
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_GraphicsCaptureItem_IInspectable_Invoke(
+                (ITypedEventHandler_GraphicsCaptureItem_IInspectable *)handlers[i], &item->IGraphicsCaptureItem_iface, NULL );
+        IUnknown_Release( handlers[i] );
+    }
+    if (count) free( handlers );
+}
+
+static HRESULT capture_item_create( HWND window, HMONITOR monitor, REFIID iid, void **out )
+{
+    struct capture_item *item;
+    HRESULT hr;
+
+    if (!(item = calloc( 1, sizeof(*item) ))) return E_OUTOFMEMORY;
+    item->IGraphicsCaptureItem_iface.lpVtbl = &item_vtbl;
+    item->IWeakReferenceSource_iface.lpVtbl = &item_weak_vtbl;
+    item->ref = 1;
+    item->window = window;
+    item->monitor = monitor;
+    InitializeCriticalSectionEx( &item->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    item->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": capture_item.cs");
+
+    hr = IGraphicsCaptureItem_QueryInterface( &item->IGraphicsCaptureItem_iface, iid, out );
+    IGraphicsCaptureItem_Release( &item->IGraphicsCaptureItem_iface );
+    return hr;
+}
+
+/* the item's activation factory: IGraphicsCaptureItemInterop, as on Windows */
+struct item_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IGraphicsCaptureItemInterop IGraphicsCaptureItemInterop_iface;
+    IGraphicsCaptureItemStatics IGraphicsCaptureItemStatics_iface;
+    LONG ref;
+};
+
+static inline struct item_factory *item_factory_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct item_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI item_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct item_factory *impl = item_factory_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IGraphicsCaptureItemInterop ))
+    {
+        *out = &impl->IGraphicsCaptureItemInterop_iface;
+        IUnknown_AddRef( (IUnknown *)*out );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IGraphicsCaptureItemStatics ))
+    {
+        *out = &impl->IGraphicsCaptureItemStatics_iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI item_factory_AddRef( IActivationFactory *iface )
+{
+    struct item_factory *impl = item_factory_from_IActivationFactory( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI item_factory_Release( IActivationFactory *iface )
+{
+    struct item_factory *impl = item_factory_from_IActivationFactory( iface );
+    return InterlockedDecrement( &impl->ref );
+}
+
+static HRESULT WINAPI item_factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI item_factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Graphics_Capture_GraphicsCaptureItem,
+                                wcslen( RuntimeClass_Windows_Graphics_Capture_GraphicsCaptureItem ), class_name );
+}
+
+static HRESULT WINAPI item_factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI item_factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl item_factory_vtbl =
+{
+    item_factory_QueryInterface,
+    item_factory_AddRef,
+    item_factory_Release,
+    item_factory_GetIids,
+    item_factory_GetRuntimeClassName,
+    item_factory_GetTrustLevel,
+    item_factory_ActivateInstance,
+};
+
+static inline struct item_factory *item_factory_from_IGraphicsCaptureItemInterop( IGraphicsCaptureItemInterop *iface )
+{
+    return CONTAINING_RECORD( iface, struct item_factory, IGraphicsCaptureItemInterop_iface );
+}
+
+static HRESULT WINAPI interop_QueryInterface( IGraphicsCaptureItemInterop *iface, REFIID iid, void **out )
+{
+    struct item_factory *impl = item_factory_from_IGraphicsCaptureItemInterop( iface );
+    return IActivationFactory_QueryInterface( &impl->IActivationFactory_iface, iid, out );
+}
+
+static ULONG WINAPI interop_AddRef( IGraphicsCaptureItemInterop *iface )
+{
+    struct item_factory *impl = item_factory_from_IGraphicsCaptureItemInterop( iface );
+    return IActivationFactory_AddRef( &impl->IActivationFactory_iface );
+}
+
+static ULONG WINAPI interop_Release( IGraphicsCaptureItemInterop *iface )
+{
+    struct item_factory *impl = item_factory_from_IGraphicsCaptureItemInterop( iface );
+    return IActivationFactory_Release( &impl->IActivationFactory_iface );
+}
+
+static HRESULT WINAPI interop_CreateForWindow( IGraphicsCaptureItemInterop *iface, HWND window, REFIID iid, void **result )
+{
+    TRACE( "iface %p, window %p, iid %s, result %p.\n", iface, window, debugstr_guid( iid ), result );
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    /* a top-level window that exists; a child window cannot be captured alone */
+    if (!IsWindow( window ) || GetAncestor( window, GA_ROOT ) != window) return E_INVALIDARG;
+    return capture_item_create( window, NULL, iid, result );
+}
+
+static HRESULT WINAPI interop_CreateForMonitor( IGraphicsCaptureItemInterop *iface, HMONITOR monitor, REFIID iid, void **result )
+{
+    MONITORINFO info = { sizeof(info) };
+
+    TRACE( "iface %p, monitor %p, iid %s, result %p.\n", iface, monitor, debugstr_guid( iid ), result );
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!GetMonitorInfoW( monitor, &info )) return E_INVALIDARG;
+    return capture_item_create( NULL, monitor, iid, result );
+}
+
+static const struct IGraphicsCaptureItemInteropVtbl interop_vtbl =
+{
+    interop_QueryInterface,
+    interop_AddRef,
+    interop_Release,
+    interop_CreateForWindow,
+    interop_CreateForMonitor,
+};
+
+DEFINE_IINSPECTABLE( item_statics, IGraphicsCaptureItemStatics, struct item_factory, IActivationFactory_iface )
+
+static HRESULT WINAPI item_statics_CreateFromVisual( IGraphicsCaptureItemStatics *iface, IVisual *visual, IGraphicsCaptureItem **result )
+{
+    FIXME( "iface %p, visual %p, result %p: a composition visual cannot be captured\n", iface, visual, result );
+    return E_NOTIMPL;
+}
