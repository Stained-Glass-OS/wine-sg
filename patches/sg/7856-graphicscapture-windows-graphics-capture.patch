+static HRESULT WINAPI pool_Recreate( IDirect3D11CaptureFramePool *iface, IDirect3DDevice *device,
+                                     DirectXPixelFormat format, INT32 buffers, SizeInt32 size )
+{
+    struct frame_pool *impl = impl_from_IDirect3D11CaptureFramePool( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, device %p, format %u, buffers %d, size %dx%d.\n", iface, device, format, buffers, size.Width, size.Height );
+
+    if (format != PIXEL_FORMAT_BGRA8 || buffers < 1 || size.Width <= 0 || size.Height <= 0) return E_INVALIDARG;
+    EnterCriticalSection( &impl->cs );
+    if (impl->closed) hr = RO_E_CLOSED;
+    else if (SUCCEEDED(hr = pool_set_device( impl, device )))
+    {
+        pool_drop_frames( impl );
+        impl->buffers = buffers;
+        impl->size = size;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI pool_TryGetNextFrame( IDirect3D11CaptureFramePool *iface, IDirect3D11CaptureFrame **result )
+{
+    struct frame_pool *impl = impl_from_IDirect3D11CaptureFramePool( iface );
+
+    TRACE( "iface %p, result %p.\n", iface, result );
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    EnterCriticalSection( &impl->cs );
+    if (impl->ready_count)
+    {
+        *result = &impl->ready[0]->IDirect3D11CaptureFrame_iface;   /* the pool's reference is the caller's now */
+        memmove( impl->ready, impl->ready + 1, --impl->ready_count * sizeof(*impl->ready) );
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
