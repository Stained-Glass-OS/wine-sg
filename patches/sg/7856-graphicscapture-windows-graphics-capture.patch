+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "unixlib.h"
+
+/* Windows draws a yellow border round what Windows.Graphics.Capture captures.
+ * The session's compositor draws it (sg-compositor's capture_border.c): a
+ * CAPTUREBORDER connection on its control socket says where, a RECT line
+ * each time it moves, and the border lasts as long as the connection does --
+ * a program that ends takes it with it. No compositor: no border. */
+
+static const char *control_path( char *buf, size_t size )
+{
+    const char *path = getenv( "SG_LOCK_CONTROL" );
+
+    if (path && *path) return path;
+    snprintf( buf, size, "/run/stained-glass-seat/seat0/%u/control.sock", (unsigned int)getuid() );
+    return buf;
+}
+
+static int read_line( int fd, char *line, size_t size )
+{
+    size_t n = 0;
+    char c;
+
+    for (;;)
+    {
+        ssize_t r = read( fd, &c, 1 );
+        if (r < 0 && errno == EINTR) continue;
+        if (r <= 0) break;
+        if (c == '\n')
+        {
+            line[n] = 0;
+            return 1;
+        }
+        if (n + 1 < size) line[n++] = c;
+    }
+    line[0] = 0;
+    return 0;
+}
+
+static NTSTATUS border_open( void *args )
+{
+    struct border_params *params = args;
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    struct timeval tv = { .tv_sec = 2 };
+    char buf[128], line[64];
+    const char *path = control_path( buf, sizeof(buf) );
+    int fd;
+
+    params->fd = -1;
+    if (strlen( path ) >= sizeof(addr.sun_path)) return STATUS_NOT_SUPPORTED;
+    strcpy( addr.sun_path, path );
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) < 0) return STATUS_NOT_SUPPORTED;
+    setsockopt( fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv) );
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) < 0 ||
+        write( fd, "CAPTUREBORDER\n", 14 ) != 14 ||
+        !read_line( fd, line, sizeof(line) ) || strcmp( line, "OK capture border" ))
+    {
+        close( fd );
+        return STATUS_NOT_SUPPORTED;
+    }
+    params->fd = fd;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS border_rect( void *args )
+{
+    struct border_params *params = args;
+    char line[96], reply[16];
+    int len;
+
+    if (params->fd < 0) return STATUS_INVALID_HANDLE;
+    if (params->on) len = snprintf( line, sizeof(line), "RECT %d %d %d %d\n", params->x, params->y, params->w, params->h );
+    else len = snprintf( line, sizeof(line), "OFF\n" );
+    if (send( params->fd, line, len, MSG_NOSIGNAL ) != len || !read_line( params->fd, reply, sizeof(reply) ))
+        return STATUS_CONNECTION_DISCONNECTED;
+    return strcmp( reply, "OK" ) ? STATUS_INVALID_PARAMETER : STATUS_SUCCESS;
+}
+
+static NTSTATUS border_close( void *args )
+{
+    struct border_params *params = args;
+
+    if (params->fd >= 0) close( params->fd );
+    params->fd = -1;
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    border_open,
+    border_rect,
+    border_close,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    border_open,
+    border_rect,
+    border_close,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif
