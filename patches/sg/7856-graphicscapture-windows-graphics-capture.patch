+static HRESULT capture_session_create( struct frame_pool *pool, IGraphicsCaptureItem *item, IGraphicsCaptureSession **result )
+{
+    struct capture_session *session;
+
+    if (!(session = calloc( 1, sizeof(*session) ))) return E_OUTOFMEMORY;
+    session->IGraphicsCaptureSession_iface.lpVtbl = &capture_session_vtbl;
+    session->IGraphicsCaptureSession2_iface.lpVtbl = &capture_session2_vtbl;
+    session->IGraphicsCaptureSession3_iface.lpVtbl = &capture_session3_vtbl;
+    session->IClosable_iface.lpVtbl = &capture_session_closable_vtbl;
+    session->IWeakReferenceSource_iface.lpVtbl = &capture_session_weak_vtbl;
+    session->ref = 1;
+    session->cursor = TRUE;      /* Windows' defaults */
+    session->border = TRUE;
+    if (!(session->stop = CreateEventW( NULL, TRUE, FALSE, NULL )))
+    {
+        free( session );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    IDirect3D11CaptureFramePool_AddRef( &pool->IDirect3D11CaptureFramePool_iface );
+    session->pool = pool;
+    IGraphicsCaptureItem_AddRef( item );
+    session->item = impl_from_IGraphicsCaptureItem( item );
+    *result = &session->IGraphicsCaptureSession_iface;
+    return S_OK;
+}
