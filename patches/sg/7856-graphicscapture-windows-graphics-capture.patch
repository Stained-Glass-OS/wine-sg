+/* A new picture: a texture of the pool's size with the picture at its top
+ * left, a frame for it at the end of the queue (the oldest dropped when the
+ * pool's buffers are all in use), and FrameArrived. */
+static void pool_deliver( struct frame_pool *pool, const BYTE *pixels, int width, int height )
+{
+    D3D11_TEXTURE2D_DESC desc = {0};
+    D3D11_BOX box = {0};
+    ID3D11Texture2D *texture = NULL;
+    IDXGISurface *dxgi_surface = NULL;
+    IInspectable *surface = NULL;
+    struct capture_frame *frame;
+    IUnknown **handlers = NULL;
+    LARGE_INTEGER now, freq;
+    UINT i, count = 0;
+
+    EnterCriticalSection( &pool->cs );
+    if (pool->closed || !pool->d3d11) goto done;
+
+    desc.Width = pool->size.Width;
+    desc.Height = pool->size.Height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+    if (FAILED(ID3D11Device_CreateTexture2D( pool->d3d11, &desc, NULL, &texture ))) goto done;
+
+    box.right = min( width, pool->size.Width );
+    box.bottom = min( height, pool->size.Height );
+    box.back = 1;
+    if (box.right && box.bottom)
+        ID3D11DeviceContext_UpdateSubresource( pool->context, (ID3D11Resource *)texture, 0, &box, pixels, width * 4, 0 );
+
+    if (FAILED(ID3D11Texture2D_QueryInterface( texture, &IID_IDXGISurface, (void **)&dxgi_surface ))) goto done;
+    if (FAILED(create_surface( dxgi_surface, &surface ))) goto done;
+    if (!(frame = calloc( 1, sizeof(*frame) ))) goto done;
+    frame->IDirect3D11CaptureFrame_iface.lpVtbl = &frame_vtbl;
+    frame->IClosable_iface.lpVtbl = &frame_closable_vtbl;
+    frame->ref = 1;
+    if (FAILED(IInspectable_QueryInterface( surface, &IID_IDirect3DSurface, (void **)&frame->surface )))
+    {
+        free( frame );
+        goto done;
+    }
+    frame->content_size.Width = width;
+    frame->content_size.Height = height;
+    QueryPerformanceCounter( &now );
+    QueryPerformanceFrequency( &freq );
+    frame->time.Duration = now.QuadPart / freq.QuadPart * 10000000 + now.QuadPart % freq.QuadPart * 10000000 / freq.QuadPart;
+
+    if (pool->ready_count >= (UINT)pool->buffers)
+    {
+        IDirect3D11CaptureFrame_Release( &pool->ready[0]->IDirect3D11CaptureFrame_iface );
+        memmove( pool->ready, pool->ready + 1, --pool->ready_count * sizeof(*pool->ready) );
+    }
+    if (!pool->ready && !(pool->ready = calloc( max( pool->buffers, 1 ), sizeof(*pool->ready) )))
+    {
+        IDirect3D11CaptureFrame_Release( &frame->IDirect3D11CaptureFrame_iface );
+        goto done;
+    }
+    pool->ready[pool->ready_count++] = frame;
+    count = handlers_copy( &pool->arrived, &handlers );
+
+done:
+    LeaveCriticalSection( &pool->cs );
+    if (surface) IInspectable_Release( surface );
+    if (dxgi_surface) IDXGISurface_Release( dxgi_surface );
+    if (texture) ID3D11Texture2D_Release( texture );
+
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable_Invoke(
+                (ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable *)handlers[i],
+                &pool->IDirect3D11CaptureFramePool_iface, NULL );
+        IUnknown_Release( handlers[i] );
+    }
+    free( handlers );
+}
+
+static HRESULT frame_pool_create( IDirect3DDevice *device, DirectXPixelFormat format, INT32 buffers,
+                                  SizeInt32 size, IDirect3D11CaptureFramePool **result )
+{
+    struct frame_pool *pool;
+    HRESULT hr;
+
+    TRACE( "device %p, format %u, buffers %d, size %dx%d.\n", device, format, buffers, size.Width, size.Height );
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (format != PIXEL_FORMAT_BGRA8)
+    {
+        FIXME( "pixel format %u not supported\n", format );
+        return E_INVALIDARG;
+    }
+    if (buffers < 1 || size.Width <= 0 || size.Height <= 0) return E_INVALIDARG;
+    if (!(pool = calloc( 1, sizeof(*pool) ))) return E_OUTOFMEMORY;
+    pool->IDirect3D11CaptureFramePool_iface.lpVtbl = &pool_vtbl;
+    pool->IClosable_iface.lpVtbl = &pool_closable_vtbl;
+    pool->IWeakReferenceSource_iface.lpVtbl = &pool_weak_vtbl;
+    pool->ref = 1;
+    pool->buffers = buffers;
+    pool->size = size;
+    InitializeCriticalSectionEx( &pool->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    pool->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": frame_pool.cs");
+    if (FAILED(hr = pool_set_device( pool, device )))
+    {
+        IDirect3D11CaptureFramePool_Release( &pool->IDirect3D11CaptureFramePool_iface );
+        return hr;
+    }
+    *result = &pool->IDirect3D11CaptureFramePool_iface;
+    return S_OK;
+}
