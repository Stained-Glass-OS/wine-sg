+/* The item's part of the screen as it is shown, into a top-down 32-bit
+ * picture of its size (opaque), with the pointer if wanted. */
+static BYTE *session_capture( struct capture_session *session, int *width, int *height )
+{
+    BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER) }};
+    HDC screen, mem;
+    HBITMAP bitmap, old;
+    BYTE *pixels = NULL;
+    void *bits;
+    RECT rect;
+    int w, h, i;
+
+    if (!item_rect( session->item, &rect )) return NULL;
+    w = rect.right - rect.left;
+    h = rect.bottom - rect.top;
+    if (w <= 0 || h <= 0) return NULL;
+
+    info.bmiHeader.biWidth = w;
+    info.bmiHeader.biHeight = -h;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+
+    if (!(screen = GetDC( NULL ))) return NULL;
+    mem = CreateCompatibleDC( screen );
+    if (mem && (bitmap = CreateDIBSection( mem, &info, DIB_RGB_COLORS, &bits, NULL, 0 )))
+    {
+        old = SelectObject( mem, bitmap );
+        if (BitBlt( mem, 0, 0, w, h, screen, rect.left, rect.top, SRCCOPY | CAPTUREBLT ))
+        {
+            CURSORINFO cursor = { sizeof(cursor) };
+
+#ifndef SG_MUTANT_WGC_NO_CURSOR
+            if (session->cursor && GetCursorInfo( &cursor ) && (cursor.flags & CURSOR_SHOWING))
+            {
+                ICONINFO icon;
+                HCURSOR shape = cursor.hCursor;
+
+                /* another process's cursor cannot be read here: the arrow in its place */
+                if (!shape || !GetIconInfo( shape, &icon ))
+                {
+                    shape = LoadCursorW( NULL, (const WCHAR *)IDC_ARROW );
+                    if (!GetIconInfo( shape, &icon )) shape = NULL;
+                }
+                if (shape)
+                {
+                    DrawIconEx( mem, cursor.ptScreenPos.x - rect.left - icon.xHotspot,
+                                cursor.ptScreenPos.y - rect.top - icon.yHotspot, shape, 0, 0, 0, NULL, DI_NORMAL );
+                    if (icon.hbmMask) DeleteObject( icon.hbmMask );
+                    if (icon.hbmColor) DeleteObject( icon.hbmColor );
+                }
+            }
+#endif
+            GdiFlush();
+            if ((pixels = malloc( (SIZE_T)w * h * 4 )))
+            {
+                memcpy( pixels, bits, (SIZE_T)w * h * 4 );
+                for (i = 0; i < w * h; i++) pixels[i * 4 + 3] = 0xff;   /* the screen has no alpha */
+            }
+        }
+        SelectObject( mem, old );
+        DeleteObject( bitmap );
+    }
+    if (mem) DeleteDC( mem );
+    ReleaseDC( NULL, screen );
+    *width = w;
+    *height = h;
+    return pixels;
+}
+
+static UINT64 hash_pixels( const BYTE *data, SIZE_T size, int width, int height )
+{
+    UINT64 hash = 14695981039346656037ull;
+    SIZE_T i;
+
+    hash = (hash ^ width) * 1099511628211ull;
+    hash = (hash ^ height) * 1099511628211ull;
+    for (i = 0; i < size; i++) hash = (hash ^ data[i]) * 1099511628211ull;
+    return hash;
+}
+
+/* The yellow border round what is captured, as Windows draws it: the
+ * compositor's (unixlib.c), following the item; always on -- IsBorderRequired
+ * is kept, but it does not take the border away. */
+static void border_follow( struct capture_session *session, struct border_params *border, RECT *shown )
+{
+    RECT rect;
+
+    if (border->fd < 0) return;
+    if (!item_rect( session->item, &rect )) SetRectEmpty( &rect );
+    if (EqualRect( &rect, shown )) return;
+    *shown = rect;
+    /* the Wine desktop's coordinates: the virtual screen's top left is 0,0 */
+    border->x = rect.left - GetSystemMetrics( SM_XVIRTUALSCREEN );
+    border->y = rect.top - GetSystemMetrics( SM_YVIRTUALSCREEN );
+    border->w = rect.right - rect.left;
+    border->h = rect.bottom - rect.top;
+    border->on = !IsRectEmpty( &rect );
+    if (WINE_UNIX_CALL( unix_border_rect, border )) WARN( "the compositor did not take the capture border\n" );
+}
+
+/* about sixty pictures a second; one that changed is a frame */
+static DWORD WINAPI capture_thread( void *arg )
+{
+    struct capture_session *session = arg;
+    struct border_params border = { .fd = -1 };
+    RECT shown = {0};
+    UINT64 last = 0;
+    BOOL have = FALSE;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_graphicscapture_session" );
+#ifndef SG_MUTANT_WGC_NO_BORDER
+    if (capture_unix_ready && WINE_UNIX_CALL( unix_border_open, &border )) border.fd = -1;
+#endif
+
+    while (WaitForSingleObject( session->stop, 16 ) == WAIT_TIMEOUT)
+    {
+        int width, height;
+        BYTE *pixels;
+        UINT64 hash;
+
+        border_follow( session, &border, &shown );
+
+        if (session->item->window && !IsWindow( session->item->window ))
+        {
+            item_close( session->item );
+            break;
+        }
+        if (!(pixels = session_capture( session, &width, &height ))) continue;
+        hash = hash_pixels( pixels, (SIZE_T)width * height * 4, width, height );
+#ifdef SG_MUTANT_WGC_ALWAYS_NEW
+        if (1)
+#else
+        if (!have || hash != last)
+#endif
+        {
+            last = hash;
+            have = TRUE;
+            pool_deliver( session->pool, pixels, width, height );
+        }
+        free( pixels );
+    }
+    /* the capture ended: so does the border */
+    if (border.fd >= 0) WINE_UNIX_CALL( unix_border_close, &border );
+    return 0;
+}
+
+static HRESULT WINAPI capture_session_StartCapture( IGraphicsCaptureSession *iface )
+{
+    struct capture_session *impl = impl_from_IGraphicsCaptureSession( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    if (impl->thread) return E_ILLEGAL_METHOD_CALL;
+    if (impl->item->is_closed) return RO_E_CLOSED;
+    ResetEvent( impl->stop );
+    if (!(impl->thread = CreateThread( NULL, 0, capture_thread, impl, 0, NULL ))) return HRESULT_FROM_WIN32( GetLastError() );
+    return S_OK;
+}
