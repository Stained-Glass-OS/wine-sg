diff --git a/dlls/msxml3/saxreader.c b/dlls/msxml3/saxreader.c
index 35d7b64..33387af 100644
--- a/dlls/msxml3/saxreader.c
+++ b/dlls/msxml3/saxreader.c
@@ -3344,6 +3344,15 @@ static HRESULT WINAPI isaxxmlreader_getFeature(
             feature == SchemaValidation)
         return get_feature_value(This, feature, value);
 
+#ifndef SG_MUTANT_SAX_GETFEATURE
+    /* these are only kept for the application, so reading gives back what was set */
+    if (feature == LexicalHandlerParEntities ||
+            feature == ProhibitDTD ||
+            feature == ExternalGeneralEntities ||
+            feature == ExternalParameterEntities)
+        return value ? get_feature_value(This, feature, value) : E_POINTER;
+#endif
+
     FIXME("(%p)->(%s %p) stub\n", This, debugstr_w(feature_name), value);
     return E_NOTIMPL;
 }
@@ -3592,7 +3601,7 @@ HRESULT SAXXMLReader_create(MSXML_VERSION version, LPVOID *ppObj)
     reader->pool.pool = NULL;
     reader->pool.index = 0;
     reader->pool.len = 0;
-    reader->features = Namespaces | NamespacePrefixes;
+    reader->features = Namespaces | NamespacePrefixes | ExternalGeneralEntities | ExternalParameterEntities;
     reader->version = version;
 
     init_dispex(&reader->dispex, (IUnknown*)&reader->IVBSAXXMLReader_iface, &saxreader_dispex);
