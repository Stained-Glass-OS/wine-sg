From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wldap32: LDAP_OPT_SEND_TIMEOUT (1527)

Windows takes LDAP_OPT_SEND_TIMEOUT (an l_timeval, the time allowed for a
request to go out) in ldap_set_option and gives it back from
ldap_get_option; a NULL value is LDAP_PARAM_ERROR. Microsoft 365 sets it,
with signing and sealing, on the connection it opens to the global catalog
(port 3268) as it starts. Wine answered LDAP_NOT_SUPPORTED and Office gave
up before connecting; with this it goes on to find there is no domain
(LDAP_SERVER_DOWN), as on an unjoined Windows machine. The value is kept as
the connection's network timeout in the bundled libldap.

Gate: test/ldapsendtimeout-gate.sh (no server is contacted).
Mutant: SG_MUTANT_LDAP_SEND_TIMEOUT_UNSUPPORTED (gate fails: set=92).
wldap32 conformance: ber unchanged (8 tests, 0 failures); parse needs a
reachable LDAP server and times out before and after.

--- a/dlls/wldap32/option.c
+++ b/dlls/wldap32/option.c
@@ -22,6 +22,7 @@
 #include "windef.h"
 #include "winbase.h"
 #include "winnls.h"
+#include "winsock2.h"
 
 #include "wine/debug.h"
 #include "winldap_private.h"
@@ -100,6 +101,7 @@
     case WLDAP32_LDAP_OPT_REFERRALS:
     case WLDAP32_LDAP_OPT_SIZELIMIT:
     case WLDAP32_LDAP_OPT_TIMELIMIT:
+    case WLDAP32_LDAP_OPT_SEND_TIMEOUT:
         return ldap_get_optionW( ld, option, value );
 
     case WLDAP32_LDAP_OPT_REFERRAL_HOP_LIMIT:
@@ -150,7 +152,6 @@
     case WLDAP32_LDAP_OPT_ROOTDSE_CACHE:
     case WLDAP32_LDAP_OPT_SASL_METHOD:
     case WLDAP32_LDAP_OPT_SECURITY_CONTEXT:
-    case WLDAP32_LDAP_OPT_SEND_TIMEOUT:
     case WLDAP32_LDAP_OPT_SERVER_CERTIFICATE:
     case WLDAP32_LDAP_OPT_SERVER_CONTROLS:
     case WLDAP32_LDAP_OPT_SERVER_ERROR:
@@ -252,6 +253,23 @@
     case WLDAP32_LDAP_OPT_TIMELIMIT:
         return map_error( ldap_get_option( CTX(ld), option, value ) );
 
+#ifndef SG_MUTANT_LDAP_SEND_TIMEOUT_UNSUPPORTED
+    /* Stained Glass OS (wine-sg 1527): the time allowed for a request to go
+     * out, kept as the connection's network timeout (an l_timeval) */
+    case WLDAP32_LDAP_OPT_SEND_TIMEOUT:
+    {
+        struct timeval *tv = NULL;
+        struct l_timeval *out = value;
+
+        if (!out) return WLDAP32_LDAP_PARAM_ERROR;
+        if ((ret = ldap_get_option( CTX(ld), LDAP_OPT_NETWORK_TIMEOUT, &tv )) != LDAP_SUCCESS) return map_error( ret );
+        out->tv_sec = tv ? tv->tv_sec : 0;
+        out->tv_usec = tv ? tv->tv_usec : 0;
+        if (tv) ldap_memfree( tv );
+        return WLDAP32_LDAP_SUCCESS;
+    }
+#endif
+
     case WLDAP32_LDAP_OPT_REFERRAL_HOP_LIMIT:
         return map_error( ldap_get_option( CTX(ld), LDAP_OPT_REFHOPLIMIT, value ) );
 
@@ -300,7 +318,9 @@
     case WLDAP32_LDAP_OPT_ROOTDSE_CACHE:
     case WLDAP32_LDAP_OPT_SASL_METHOD:
     case WLDAP32_LDAP_OPT_SECURITY_CONTEXT:
+#ifdef SG_MUTANT_LDAP_SEND_TIMEOUT_UNSUPPORTED
     case WLDAP32_LDAP_OPT_SEND_TIMEOUT:
+#endif
     case WLDAP32_LDAP_OPT_SERVER_CERTIFICATE:
     case WLDAP32_LDAP_OPT_SERVER_CONTROLS:
     case WLDAP32_LDAP_OPT_SERVER_ERROR:
@@ -355,6 +375,7 @@
     case WLDAP32_LDAP_OPT_SIZELIMIT:
     case WLDAP32_LDAP_OPT_SSL:
     case WLDAP32_LDAP_OPT_TIMELIMIT:
+    case WLDAP32_LDAP_OPT_SEND_TIMEOUT:
         return ldap_set_optionW( ld, option, value );
 
     case WLDAP32_LDAP_OPT_HOST_NAME:
@@ -398,7 +419,6 @@
     case WLDAP32_LDAP_OPT_REFERRAL_CALLBACK:
     case WLDAP32_LDAP_OPT_SASL_METHOD:
     case WLDAP32_LDAP_OPT_SECURITY_CONTEXT:
-    case WLDAP32_LDAP_OPT_SEND_TIMEOUT:
     case WLDAP32_LDAP_OPT_SERVER_ERROR:
     case WLDAP32_LDAP_OPT_SERVER_EXT_ERROR:
     case WLDAP32_LDAP_OPT_SSL_INFO:
@@ -560,6 +580,24 @@
     case WLDAP32_LDAP_OPT_TIMELIMIT:
         return map_error( ldap_set_option( CTX(ld), option, value ) );
 
+#ifndef SG_MUTANT_LDAP_SEND_TIMEOUT_UNSUPPORTED
+    /* Stained Glass OS (wine-sg 1527): Windows takes a send timeout (an
+     * l_timeval). Office sets it, with signing and sealing, on the
+     * connection it opens to the global catalog (port 3268) before it binds;
+     * refused, it gave up with LDAP_NOT_SUPPORTED where Windows goes on to
+     * find there is no domain. Kept as the connection's network timeout. */
+    case WLDAP32_LDAP_OPT_SEND_TIMEOUT:
+    {
+        const struct l_timeval *in = value;
+        struct timeval tv;
+
+        if (!in) return WLDAP32_LDAP_PARAM_ERROR;
+        tv.tv_sec = in->tv_sec;
+        tv.tv_usec = in->tv_usec;
+        return map_error( ldap_set_option( CTX(ld), LDAP_OPT_NETWORK_TIMEOUT, &tv ) );
+    }
+#endif
+
     case WLDAP32_LDAP_OPT_SSL:
     {
         BOOL turn_on;
@@ -637,7 +675,9 @@
     case WLDAP32_LDAP_OPT_REFERRAL_CALLBACK:
     case WLDAP32_LDAP_OPT_SASL_METHOD:
     case WLDAP32_LDAP_OPT_SECURITY_CONTEXT:
+#ifdef SG_MUTANT_LDAP_SEND_TIMEOUT_UNSUPPORTED
     case WLDAP32_LDAP_OPT_SEND_TIMEOUT:
+#endif
     case WLDAP32_LDAP_OPT_SERVER_ERROR:
     case WLDAP32_LDAP_OPT_SERVER_EXT_ERROR:
     case WLDAP32_LDAP_OPT_SSL_INFO:
