@@ -37,3 +44,30 @@
     FIXME( "%s, %p\n", debugstr_w(volume), alg );
     return FALSE;
 }
+
+/* Back a file with a WOF data provider -- for WOF_PROVIDER_FILE, store it
+ * compressed. The overlay filter does this in response to
+ * FSCTL_SET_EXTERNAL_BACKING on the handle, so ask the file system; one that
+ * has no overlay filter refuses, and the file stays as it is. Installers that
+ * compress what they install (Microsoft Edge's) take that as "not here" and
+ * carry on; without this export they crashed. */
+HRESULT WINAPI WofSetFileDataLocation( HANDLE file, ULONG provider, void *info, ULONG length )
+{
+    IO_STATUS_BLOCK io;
+    WOF_EXTERNAL_INFO *wof;
+    NTSTATUS status;
+
+    TRACE( "%p, %lu, %p, %lu\n", file, provider, info, length );
+
+    if (!info && length) return E_INVALIDARG;
+    if (length > 0x10000) return E_INVALIDARG;
+    if (!(wof = malloc( sizeof(*wof) + length ))) return E_OUTOFMEMORY;
+    wof->Version = WOF_CURRENT_VERSION;
+    wof->Provider = provider;
+    if (length) memcpy( wof + 1, info, length );
+    status = NtFsControlFile( file, NULL, NULL, NULL, &io, FSCTL_SET_EXTERNAL_BACKING,
+                              wof, sizeof(*wof) + length, NULL, 0 );
+    free( wof );
+    if (status) return HRESULT_FROM_WIN32( RtlNtStatusToDosError( status ) );
+    return S_OK;
+}
