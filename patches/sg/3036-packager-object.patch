 static HRESULT WINAPI OleObject_GetExtent(IOleObject *iface, DWORD dwDrawAspect, SIZEL *psizel)
 {
     struct Package *This = impl_from_IOleObject(iface);
-    FIXME("(%p)->(%ld, %p)\n", This, dwDrawAspect, psizel);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%ld, %p)\n", This, dwDrawAspect, psizel);
+
+    if(!psizel)
+        return E_POINTER;
+    if(dwDrawAspect != DVASPECT_ICON && dwDrawAspect != DVASPECT_CONTENT)
+        return DV_E_DVASPECT;
+
+    if(This->has_extent){
+        *psizel = This->extent;
+    }else{
+        /* the package is shown as an icon: use the size of a system icon in HIMETRIC units */
+        HDC hdc = GetDC(NULL);
+        int dpix = hdc ? GetDeviceCaps(hdc, LOGPIXELSX) : 96;
+        int dpiy = hdc ? GetDeviceCaps(hdc, LOGPIXELSY) : 96;
+
+        if(hdc)
+            ReleaseDC(NULL, hdc);
+        psizel->cx = MulDiv(GetSystemMetrics(SM_CXICON), 2540, dpix);
+        psizel->cy = MulDiv(GetSystemMetrics(SM_CYICON), 2540, dpiy);
+    }
+    return S_OK;
 }
 
