+static HRESULT write_stream(IStream *stream, const void *data, ULONG size)
+{
+    ULONG written;
+    HRESULT hr = IStream_Write(stream, data, size, &written);
+
+    if(SUCCEEDED(hr) && written != size)
+        hr = STG_E_WRITEFAULT;
+    return hr;
+}
+
 static HRESULT WINAPI PersistStorage_Save(IPersistStorage* iface,
         IStorage *pStgSave, BOOL fSameAsLoad)
 {
     struct Package *This = impl_from_IPersistStorage(iface);
-    FIXME("(%p)->(%p, %u)\n", This, pStgSave, fSameAsLoad);
-    return E_NOTIMPL;
+    static const WORD header[] = { 2 };
+    static const WORD trailer[] = { 0, 3 };
+    IStream *stream = NULL;
+    char labelA[MAX_PATH], pathA[MAX_PATH];
+    const WCHAR *name;
+    HANDLE file;
+    DWORD size, read, total, len;
+    ULARGE_INTEGER pos;
+    LARGE_INTEGER seek;
+    HRESULT hr;
+    BYTE data[4096];
+
+    TRACE("(%p)->(%p, %u)\n", This, pStgSave, fSameAsLoad);
+
+    if(!pStgSave)
+        pStgSave = This->storage;
+    if(!pStgSave)
+        return E_POINTER;
+    if(!*This->filename)
+        return OLE_E_BLANK;
+
+    file = CreateFileW(This->filename, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+            FILE_ATTRIBUTE_NORMAL, NULL);
+    if(file == INVALID_HANDLE_VALUE)
+        return HRESULT_FROM_WIN32(GetLastError());
+    size = GetFileSize(file, NULL);
+
+    name = PathFindFileNameW(This->filename);
+    WideCharToMultiByte(CP_ACP, 0, name, -1, labelA, sizeof(labelA), NULL, NULL);
+    WideCharToMultiByte(CP_ACP, 0, This->filename, -1, pathA, sizeof(pathA), NULL, NULL);
+
+    hr = IStorage_CreateStream(pStgSave, L"\1Ole10Native", STGM_CREATE | STGM_WRITE | STGM_SHARE_EXCLUSIVE, 0, 0,
+            &stream);
+    if(FAILED(hr))
+        goto done;
+
+    /* stream size, filled in once everything is written */
+    total = 0;
+    hr = write_stream(stream, &total, 4);
+    if(SUCCEEDED(hr)) hr = write_stream(stream, header, sizeof(header));
+    if(SUCCEEDED(hr)) hr = write_stream(stream, labelA, strlen(labelA) + 1);
+    if(SUCCEEDED(hr)) hr = write_stream(stream, pathA, strlen(pathA) + 1);
+    if(SUCCEEDED(hr)) hr = write_stream(stream, trailer, sizeof(trailer));
+    len = strlen(pathA) + 1;
+    if(SUCCEEDED(hr)) hr = write_stream(stream, &len, 4);
+    if(SUCCEEDED(hr)) hr = write_stream(stream, pathA, len);
+    if(SUCCEEDED(hr)) hr = write_stream(stream, &size, 4);
+    while(SUCCEEDED(hr) && size){
+        if(!ReadFile(file, data, min(sizeof(data), size), &read, NULL) || !read){
+            hr = E_FAIL;
+            break;
+        }
+        hr = write_stream(stream, data, read);
+        size -= read;
+    }
+    len = lstrlenW(This->filename) + 1;
+    if(SUCCEEDED(hr)) hr = write_stream(stream, &len, 4);
+    if(SUCCEEDED(hr)) hr = write_stream(stream, This->filename, len * sizeof(WCHAR));
+
+    if(SUCCEEDED(hr)){
+        seek.QuadPart = 0;
+        hr = IStream_Seek(stream, seek, STREAM_SEEK_CUR, &pos);
+        if(SUCCEEDED(hr)){
+            /* the leading size does not include itself */
+            total = pos.LowPart - 4;
+            seek.QuadPart = 0;
+            hr = IStream_Seek(stream, seek, STREAM_SEEK_SET, NULL);
+            if(SUCCEEDED(hr))
+                hr = write_stream(stream, &total, 4);
+        }
+    }
+
+done:
+    if(stream)
+        IStream_Release(stream);
+    CloseHandle(file);
+    return hr;
 }
 
 static HRESULT WINAPI PersistStorage_SaveCompleted(IPersistStorage* iface,
         IStorage *pStgNew)
