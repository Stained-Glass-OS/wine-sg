-    FIXME("(%p)->(%ld, %p)\n", This, dwDrawAspect, psizel);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%ld, %p)\n", This, dwDrawAspect, psizel);
+
+    if(!psizel)
+        return E_POINTER;
+    if(dwDrawAspect != DVASPECT_ICON && dwDrawAspect != DVASPECT_CONTENT)
+        return DV_E_DVASPECT;
+
+    This->extent = *psizel;
+    This->has_extent = TRUE;
+    return S_OK;
