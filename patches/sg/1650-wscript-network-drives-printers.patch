+        return create_string_enum(items, This->count, 0, (IEnumVARIANT **)Enum);
+    }
     if (!(items = calloc(ARRAY_SIZE(special_folders), sizeof(*items)))) return E_OUTOFMEMORY;
     for (i = 0; i < ARRAY_SIZE(special_folders); i++) items[i] = special_folder_path(special_folders[i].csidl);
     return create_string_enum(items, ARRAY_SIZE(special_folders), 0, (IEnumVARIANT **)Enum);
@@ -1166,6 +1192,25 @@ static HRESULT WshCollection_Create(IWshCollection **collection)
     return S_OK;
 }
 
+/* a collection of strings (takes them) */
+HRESULT create_string_collection(BSTR *items, ULONG count, IWshCollection **collection)
+{
+    WshCollection *object;
+    HRESULT hr;
+
+    if (FAILED(hr = WshCollection_Create(collection)))
+    {
+        ULONG i;
+        for (i = 0; i < count; i++) SysFreeString(items[i]);
+        free(items);
+        return hr;
+    }
+    object = impl_from_IWshCollection(*collection);
+    object->items = items ? items : calloc(1, sizeof(BSTR));
+    object->count = count;
+    return S_OK;
+}
