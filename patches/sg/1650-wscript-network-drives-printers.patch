 static HRESULT WINAPI WshNetwork2_EnumNetworkDrives(IWshNetwork2 *iface, IWshCollection **ret)
 {
-    FIXME("%p stub\n", ret);
+    TRACE("%p\n", ret);
 
-    return E_NOTIMPL;
+    /* drive letter, share, drive letter, share, ... */
+    return enum_connections(RESOURCETYPE_DISK, ret);
 }
 
 static HRESULT WINAPI WshNetwork2_AddPrinterConnection(IWshNetwork2 *iface, BSTR local_name, BSTR remote_name,
         VARIANT *update_profile, VARIANT *user_name, VARIANT *password)
 {
-    FIXME("%s, %s, %s, %p, %p stub\n", debugstr_w(local_name), debugstr_w(remote_name), debugstr_variant(update_profile),
-            user_name, password);
+    TRACE("%s, %s, %s, %p, %p\n", debugstr_w(local_name), debugstr_w(remote_name), debugstr_variant(update_profile),
+          user_name, password);
 
-    return E_NOTIMPL;
+    /* a port (LPT1) sent to a network printer */
+    if (!remote_name) return E_INVALIDARG;
+    return add_connection(RESOURCETYPE_PRINT, local_name, remote_name, update_profile, user_name, password);
 }
 
 static HRESULT WINAPI WshNetwork2_RemovePrinterConnection(IWshNetwork2 *iface, BSTR name, VARIANT *force, VARIANT *update_profile)
 {
-    FIXME("%s, %s, %s stub\n", debugstr_w(name), debugstr_variant(force), debugstr_variant(update_profile));
+    DWORD ret;
 
-    return E_NOTIMPL;
+    TRACE("%s, %s, %s\n", debugstr_w(name), debugstr_variant(force), debugstr_variant(update_profile));
+
+    if (!name) return E_INVALIDARG;
+    /* a printer connection (\\server\printer), or a port's */
+    if (name[0] == '\\' && name[1] == '\\')
+        return DeletePrinterConnectionW(name) ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+    ret = WNetCancelConnection2W(name, variant_true(update_profile) ? CONNECT_UPDATE_PROFILE : 0, variant_true(force));
+    return ret ? HRESULT_FROM_WIN32(ret) : S_OK;
 }
 
 static HRESULT WINAPI WshNetwork2_EnumPrinterConnections(IWshNetwork2 *iface, IWshCollection **ret)
 {
-    FIXME("%p stub\n", ret);
-
-    return E_NOTIMPL;
+    PRINTER_INFO_2W *info = NULL;
+    DWORD needed = 0, returned = 0, i;
+    BSTR *items = NULL;
+    ULONG count = 0;
+
+    TRACE("%p\n", ret);
+
+    if (!ret) return E_POINTER;
+#ifdef SG_MUTANT_NO_PRINTER_LIST
+    return create_string_collection(NULL, 0, ret);
+#endif
+    /* port, printer, port, printer, ... */
+    EnumPrintersW(PRINTER_ENUM_LOCAL | PRINTER_ENUM_CONNECTIONS, NULL, 2, NULL, 0, &needed, &returned);
+    if (needed && (info = malloc(needed)) &&
+        EnumPrintersW(PRINTER_ENUM_LOCAL | PRINTER_ENUM_CONNECTIONS, NULL, 2, (BYTE *)info, needed, &needed, &returned) &&
+        returned && (items = calloc(returned * 2, sizeof(*items))))
+    {
+        for (i = 0; i < returned; i++)
+        {
+            items[count++] = SysAllocString(info[i].pPortName ? info[i].pPortName : L"");
+            items[count++] = SysAllocString(info[i].pPrinterName ? info[i].pPrinterName : L"");
+        }
+    }
+    free(info);
+    return create_string_collection(items, count, ret);
 }
 
