+/* Stained Glass OS (1650): drives and printers */
+static BOOL variant_true(const VARIANT *v)
+{
+    VARIANT b;
+
+    if (!v || V_VT(v) == VT_ERROR || V_VT(v) == VT_EMPTY) return FALSE;
+    VariantInit(&b);
+    if (FAILED(VariantChangeType(&b, (VARIANT *)v, 0, VT_BOOL))) return FALSE;
+    return V_BOOL(&b) != VARIANT_FALSE;
+}
+
+static WCHAR *variant_string(const VARIANT *v, VARIANT *holder)
+{
+    VariantInit(holder);
+    if (!v || V_VT(v) == VT_ERROR || V_VT(v) == VT_EMPTY || V_VT(v) == VT_NULL) return NULL;
+    if (FAILED(VariantChangeType(holder, (VARIANT *)v, 0, VT_BSTR))) return NULL;
+    return V_BSTR(holder);
+}
+
+static HRESULT add_connection(DWORD type, BSTR local_name, BSTR remote_name, VARIANT *update_profile,
+                              VARIANT *user_name, VARIANT *password)
+{
+    NETRESOURCEW res = { 0 };
+    VARIANT user, pass;
+    DWORD ret;
+
+    res.dwType = type;
+    res.lpLocalName = local_name && local_name[0] ? local_name : NULL;
+    res.lpRemoteName = remote_name;
+    ret = WNetAddConnection2W(&res, variant_string(password, &pass), variant_string(user_name, &user),
+                              variant_true(update_profile) ? CONNECT_UPDATE_PROFILE : 0);
+    VariantClear(&user);
+    VariantClear(&pass);
+    return ret ? HRESULT_FROM_WIN32(ret) : S_OK;
+}
+
+/* the connected resources of a type: local name, remote name, ... */
+static HRESULT enum_connections(DWORD type, IWshCollection **ret)
+{
+    BSTR *items = NULL;
+    ULONG count = 0, size = 0;
+    HANDLE handle;
+    char buffer[16384];
+    DWORD n, bytes, err;
+
+    if (!ret) return E_POINTER;
+    if (!(err = WNetOpenEnumW(RESOURCE_CONNECTED, type, 0, NULL, &handle)))
+    {
+        for (;;)
+        {
+            NETRESOURCEW *res = (NETRESOURCEW *)buffer;
+            DWORD i;
+
+            n = ~0u;
+            bytes = sizeof(buffer);
+            if (WNetEnumResourceW(handle, &n, res, &bytes)) break;
+            for (i = 0; i < n; i++)
+            {
+                if (count + 2 > size)
+                {
+                    BSTR *bigger = realloc(items, (size = max(size * 2, 16)) * sizeof(*items));
+                    if (!bigger) break;
+                    items = bigger;
+                }
+                items[count++] = SysAllocString(res[i].lpLocalName ? res[i].lpLocalName : L"");
+                items[count++] = SysAllocString(res[i].lpRemoteName ? res[i].lpRemoteName : L"");
+            }
+        }
+        WNetCloseEnum(handle);
+    }
+    return create_string_collection(items, count, ret);
+}
+
