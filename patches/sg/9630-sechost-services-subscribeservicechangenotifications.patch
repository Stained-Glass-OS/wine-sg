+/* The services created ("/name") and deleted ("\\name") that a manager handle's
+ * notification reports come from services.exe separated by \001 (a [string] cannot
+ * carry the NULs); the caller gets a multi-string it frees with LocalFree. */
+static WCHAR *names_from_wire( const WCHAR *wire )
+{
+    WCHAR *ret, *p;
+    SIZE_T len;
+
+    if (!wire || !*wire) return NULL;
+    len = wcslen( wire );
+    if (!(ret = LocalAlloc( LMEM_ZEROINIT, (len + 2) * sizeof(WCHAR) ))) return NULL;
+    memcpy( ret, wire, len * sizeof(WCHAR) );
+    for (p = ret; *p; p++) if (*p == 1) *p = 0;
+    return ret;
+}
