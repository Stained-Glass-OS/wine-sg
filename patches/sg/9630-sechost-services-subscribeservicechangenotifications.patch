+/* SubscribeServiceChangeNotifications: a service's status changes, or the services
+ * created and deleted in the database (a manager handle), reported to a callback on a
+ * thread of the subscription's own, as Windows does on its thread pool.  WireGuard's
+ * manager service watches the database this way and ended at once on the stub
+ * (i0977).  Each change is a NotifyServiceStatusChange registration made again after it
+ * fires; services.exe keeps what changes in between for the next one, so nothing is
+ * lost.  The registrations are made on a handle of the subscription's own where it can
+ * open one, so that the caller's handle stays free for its own NotifyServiceStatusChange
+ * or another subscription, and Unsubscribe ends the wait by closing it.  The callback is
+ * never called once Unsubscribe has returned. */
+struct sc_subscription
+{
+    SC_HANDLE handle;
+    BOOL own;               /* a handle of the subscription's own, closed by Unsubscribe */
+    SC_EVENT_TYPE type;
+    PSC_NOTIFICATION_CALLBACK callback;
+    void *context;
+    CRITICAL_SECTION cs;
+    BOOL stopped;
+    LONG ref;
+};
+
+/* the same service (or the database) opened again for the subscription alone */
+static SC_HANDLE own_handle( SC_HANDLE handle, SC_EVENT_TYPE type )
+{
+    QUERY_SERVICE_CONFIGW *config;
+    SC_HANDLE scm, ret = NULL;
+    WCHAR name[257];
+    DWORD size = 0, len = ARRAY_SIZE(name);
+
+#ifdef SG_MUTANT_SUBSCRIBE_SHARED_HANDLE
+    return NULL;
+#endif
+    if (!(scm = OpenSCManagerW( NULL, NULL, SC_MANAGER_CONNECT | SC_MANAGER_ENUMERATE_SERVICE ))) return NULL;
+    if (type == SC_EVENT_DATABASE_CHANGE) return scm;
+    /* a service handle carries no name: its display name, unique in the database, leads to it */
+    QueryServiceConfigW( handle, NULL, 0, &size );
+    if (size && (config = malloc( size )))
+    {
+        if (QueryServiceConfigW( handle, config, size, &size ) && config->lpDisplayName &&
+            GetServiceKeyNameW( scm, config->lpDisplayName, name, &len ))
+            ret = OpenServiceW( scm, name, SERVICE_QUERY_STATUS );
+        free( config );
+    }
+    CloseServiceHandle( scm );
+    return ret;
+}
+
+static void subscription_release( struct sc_subscription *sub )
+{
+    if (InterlockedDecrement( &sub->ref )) return;
+    sub->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &sub->cs );
+    free( sub );
+}
+
+static DWORD WINAPI subscription_thread( void *arg )
+{
+    struct sc_subscription *sub = arg;
+    SERVICE_NOTIFY_STATUS_CHANGE_PARAMS_2 cparams, *result;
+    SC_RPC_NOTIFY_PARAMS_LIST *list;
+    SC_NOTIFY_RPC_HANDLE notify;
+    SC_RPC_NOTIFY_PARAMS params;
+    BOOL b_dummy, stop;
+    GUID g_dummy;
+    DWORD err;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_sechost_service_subscription" );
+
+    for (;;)
+    {
+        memset( &cparams, 0, sizeof(cparams) );
+        cparams.dwNotifyMask = sub->type == SC_EVENT_DATABASE_CHANGE
+                ? SERVICE_NOTIFY_CREATED | SERVICE_NOTIFY_DELETED
+                : SERVICE_NOTIFY_STOPPED | SERVICE_NOTIFY_START_PENDING | SERVICE_NOTIFY_STOP_PENDING |
+                  SERVICE_NOTIFY_RUNNING | SERVICE_NOTIFY_CONTINUE_PENDING | SERVICE_NOTIFY_PAUSE_PENDING |
+                  SERVICE_NOTIFY_PAUSED;
+        params.dwInfoLevel = 2;
+        params.params = &cparams;
+        notify = NULL;
+        b_dummy = FALSE;
+        memset( &g_dummy, 0, sizeof(g_dummy) );
+
+        /* the handle is only used while the subscription stands: Unsubscribe waits for this */
+        EnterCriticalSection( &sub->cs );
+        if (!(stop = sub->stopped))
+        {
+            __TRY
+            {
+                err = svcctl_NotifyServiceStatusChange( sub->handle, params, &g_dummy, &g_dummy, &b_dummy, &notify );
+            }
+            __EXCEPT(rpc_filter)
+            {
+                err = map_exception_code( GetExceptionCode() );
+            }
+            __ENDTRY
+        }
+        LeaveCriticalSection( &sub->cs );
+        if (stop) break;
+        if (err)
+        {
+            WARN( "registration failed: %lu\n", err );
+            break;
+        }
+
+        list = NULL;
+        __TRY
+        {
+            /* blocks until there is a change, or the handle is closed */
+            err = svcctl_GetNotifyResults( notify, &list );
+        }
+        __EXCEPT(rpc_filter)
+        {
+            err = map_exception_code( GetExceptionCode() );
+        }
+        __ENDTRY
+        __TRY
+        {
+            svcctl_CloseNotifyHandle( &notify, &b_dummy );
+        }
+        __EXCEPT(rpc_filter)
+        {
+        }
+        __ENDTRY
+
+        if (err || !list || !list->cElements)
+        {
+            TRACE( "subscription %p ends: %lu\n", sub, err );
+            if (list) MIDL_user_free( list );
+            break;
+        }
+        result = list->NotifyParamsArray[0].params;
+
+        EnterCriticalSection( &sub->cs );
+        if (!sub->stopped && result)
+        {
+            TRACE( "subscription %p: %#lx\n", sub, result->dwNotificationTriggered );
+            sub->callback( result->dwNotificationTriggered, sub->context );
+        }
+        LeaveCriticalSection( &sub->cs );
+
+        if (result)
+        {
+            MIDL_user_free( result->pszServiceNames );
+            MIDL_user_free( result );
+        }
+        MIDL_user_free( list );
+    }
+
+    subscription_release( sub );
+    return 0;
+}
+
+/******************************************************************************
+ *     SubscribeServiceChangeNotifications   (sechost.@)
+ */
+DWORD WINAPI SubscribeServiceChangeNotifications( SC_HANDLE handle, SC_EVENT_TYPE type,
+                                                  PSC_NOTIFICATION_CALLBACK callback, void *context,
+                                                  PSC_NOTIFICATION_REGISTRATION *subscription )
+{
+    struct sc_subscription *sub;
+    HANDLE thread;
+
+    TRACE( "%p %d %p %p %p\n", handle, type, callback, context, subscription );
+
+    if (!handle) return ERROR_INVALID_HANDLE;
+    if (!callback || !subscription) return ERROR_INVALID_PARAMETER;
+#ifdef SG_MUTANT_SUBSCRIBE_STUB
+    return ERROR_CALL_NOT_IMPLEMENTED;
+#endif
+    /* configuration changes are not reported by services.exe */
+    if (type != SC_EVENT_DATABASE_CHANGE && type != SC_EVENT_STATUS_CHANGE)
+    {
+        FIXME( "event type %d not supported\n", type );
+        return ERROR_NOT_SUPPORTED;
+    }
+
+    if (!(sub = calloc( 1, sizeof(*sub) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    if ((sub->handle = own_handle( handle, type ))) sub->own = TRUE;
+    else sub->handle = handle;
+    sub->type = type;
+    sub->callback = callback;
+    sub->context = context;
+    sub->ref = 2;
+    InitializeCriticalSectionEx( &sub->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    sub->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": sc_subscription.cs");
+
+    if (!(thread = CreateThread( NULL, 0, subscription_thread, sub, 0, NULL )))
+    {
+        DWORD err = GetLastError();
+        sub->ref = 1;
+        if (sub->own) CloseServiceHandle( sub->handle );
+        subscription_release( sub );
+        return err;
+    }
+    CloseHandle( thread );
+    *subscription = (PSC_NOTIFICATION_REGISTRATION)sub;
+    return ERROR_SUCCESS;
+}
+
+/******************************************************************************
+ *     UnsubscribeServiceChangeNotifications   (sechost.@)
+ */
+void WINAPI UnsubscribeServiceChangeNotifications( PSC_NOTIFICATION_REGISTRATION subscription )
+{
+    struct sc_subscription *sub = (struct sc_subscription *)subscription;
+
+    TRACE( "%p\n", subscription );
+    if (!sub) return;
+    /* waits for a callback that is running (unless it is this thread's own) */
+    EnterCriticalSection( &sub->cs );
+    sub->stopped = TRUE;
+    /* closing it ends the thread's wait; with the caller's handle the thread ends at the next
+     * change, or when the caller closes it */
+#ifndef SG_MUTANT_SUBSCRIBE_SHARED_HANDLE
+    if (sub->own) CloseServiceHandle( sub->handle );
+#endif
+    LeaveCriticalSection( &sub->cs );
+    subscription_release( sub );
+}
+
