+/* a manager handle's registration takes what it waits for of the changes kept */
+static void fill_manager_notify(struct sc_notify_handle *notify, struct sc_manager_handle *manager)
+{
+    SC_RPC_NOTIFY_PARAMS_LIST *list;
+    SERVICE_NOTIFY_STATUS_CHANGE_PARAMS_2 *cparams;
+
+    if (!(list = calloc(1, sizeof(SC_RPC_NOTIFY_PARAMS_LIST)))) return;
+    if (!(cparams = calloc(1, sizeof(SERVICE_NOTIFY_STATUS_CHANGE_PARAMS_2))))
+    {
+        free(list);
+        return;
+    }
+    cparams->dwNotifyMask = notify->notify_mask;
+    cparams->dwNotificationStatus = ERROR_SUCCESS;
+    cparams->dwNotificationTriggered = manager->pending_mask & notify->notify_mask;
+    cparams->pszServiceNames = manager->pending_names;
+    manager->pending_names = NULL;
+    manager->pending_mask = 0;
+    list->cElements = 1;
+    list->NotifyParamsArray[0].dwInfoLevel = 2;
+    list->NotifyParamsArray[0].params = cparams;
+    InterlockedExchangePointer((void**)&notify->params_list, list);
+    SetEvent(notify->event);
+}
+
+/* a service was created or deleted: every manager handle that watches is told (wine-sg
+ * 9630; it was ERROR_CALL_NOT_IMPLEMENTED).  The database's lock is held. */
+void notify_database_change(const WCHAR *name, BOOL created)
+{
+    struct sc_manager_handle *manager;
+    DWORD bit = created ? SERVICE_NOTIFY_CREATED : SERVICE_NOTIFY_DELETED;
+
+#ifdef SG_MUTANT_NO_DATABASE_NOTIFY
+    return;
+#endif
+    LIST_FOR_EACH_ENTRY(manager, &watched_managers, struct sc_manager_handle, entry)
+    {
+        SIZE_T old = manager->pending_names ? lstrlenW(manager->pending_names) : 0, len = lstrlenW(name);
+        WCHAR *names;
+
+        if ((names = realloc(manager->pending_names, (old + len + 3) * sizeof(WCHAR))))
+        {
+            names[old] = created ? '/' : '\\';
+            memcpy(names + old + 1, name, len * sizeof(WCHAR));
+            names[old + 1 + len] = 1;
+            names[old + 2 + len] = 0;
+            manager->pending_names = names;
+        }
+        manager->pending_mask |= bit;
+        if (manager->notify && (manager->notify->notify_mask & manager->pending_mask))
+        {
+            fill_manager_notify(manager->notify, manager);
+            sc_notify_release(manager->notify);
+            manager->notify = NULL;
+        }
+    }
+}
