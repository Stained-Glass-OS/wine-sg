         data->notify_buffer->dwNotificationTriggered = cparams->dwNotificationTriggered;
-        data->notify_buffer->pszServiceNames = NULL;
+        data->notify_buffer->pszServiceNames = names_from_wire( cparams->pszServiceNames );
 
