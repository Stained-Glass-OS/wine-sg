+static HRESULT WINAPI DefaultExtractIconW_QueryInterface(IExtractIconW *iface, REFIID riid, void **obj)
+{
+    struct default_extract_icon *This = impl_from_default_IExtractIconW(iface);
+    return IDefaultExtractIconInit_QueryInterface(&This->IDefaultExtractIconInit_iface, riid, obj);
+}
