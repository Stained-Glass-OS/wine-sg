+/******************************************************************************
+ * RemoveUsersFromEncryptedFile [ADVAPI32.@]
+ */
+DWORD WINAPI RemoveUsersFromEncryptedFile(LPCWSTR name, PENCRYPTION_CERTIFICATE_HASH_LIST hashes)
+{
+    PENCRYPTION_CERTIFICATE_HASH_LIST none;
+
+    TRACE("(%s %p)\n", debugstr_w(name), hashes);
+    if (!hashes) return ERROR_INVALID_PARAMETER;
+    return QueryUsersOnEncryptedFile(name, &none);
+}
+
+/******************************************************************************
+ * DuplicateEncryptionInfoFile [ADVAPI32.@]
+ */
+DWORD WINAPI DuplicateEncryptionInfoFile(LPCWSTR source, LPCWSTR dest, DWORD creation, DWORD attributes,
+                                         const LPSECURITY_ATTRIBUTES sa)
+{
+    PENCRYPTION_CERTIFICATE_HASH_LIST none;
+
+    TRACE("(%s %s %lu %#lx %p)\n", debugstr_w(source), debugstr_w(dest), creation, attributes, sa);
+    if (!dest) return ERROR_INVALID_PARAMETER;
+    return QueryUsersOnEncryptedFile(source, &none);
+}
+
+/******************************************************************************
+ * FreeEncryptionCertificateHashList [ADVAPI32.@]
+ */
+void WINAPI FreeEncryptionCertificateHashList(PENCRYPTION_CERTIFICATE_HASH_LIST list)
+{
+    DWORD i;
+
+    TRACE("(%p)\n", list);
+    if (!list) return;
+    for (i = 0; i < list->nCert_Hash && list->pUsers; i++)
+    {
+        PENCRYPTION_CERTIFICATE_HASH hash = list->pUsers[i];
+        if (!hash) continue;
+        LocalFree(hash->pUserSid);
+        if (hash->pHash) LocalFree(hash->pHash->pbData);
+        LocalFree(hash->pHash);
+        LocalFree(hash->lpDisplayInformation);
+        LocalFree(hash);
+    }
+    LocalFree(list->pUsers);
+    LocalFree(list);
+}
+
+/******************************************************************************
+ * EncryptionDisable [ADVAPI32.@]
+ *
+ * A folder's files are not to be encrypted: Disable=1 in the [Encryption]
+ * section of its Desktop.ini.
+ */
+BOOL WINAPI EncryptionDisable(LPCWSTR dir, BOOL disable)
+{
+    WCHAR ini[MAX_PATH];
+    DWORD attr;
+
+    TRACE("(%s %d)\n", debugstr_w(dir), disable);
+    if (!dir || (attr = GetFileAttributesW(dir)) == INVALID_FILE_ATTRIBUTES)
+    {
+        SetLastError(dir ? GetLastError() : ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(attr & FILE_ATTRIBUTE_DIRECTORY))
+    {
+        SetLastError(ERROR_DIRECTORY);
+        return FALSE;
+    }
+    if (swprintf(ini, ARRAY_SIZE(ini), L"%s%sDesktop.ini", dir,
+                 dir[0] && dir[wcslen(dir) - 1] == '\\' ? L"" : L"\\") < 0)
+    {
+        SetLastError(ERROR_FILENAME_EXCED_RANGE);
+        return FALSE;
+    }
+    return WritePrivateProfileStringW(L"Encryption", L"Disable", disable ? L"1" : L"0", ini);
+}
