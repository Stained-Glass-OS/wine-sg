+/* SHCreateDefaultExtractIcon: an icon location its creator sets, for the
+ * normal, open and shortcut states, with a default; or a key's DefaultIcon */
+struct default_icon
+{
+    WCHAR *file;
+    int index;
+    BOOL set;
+};
+
+struct default_extract_icon
+{
+    IDefaultExtractIconInit IDefaultExtractIconInit_iface;
+    IExtractIconW IExtractIconW_iface;
+    IExtractIconA IExtractIconA_iface;
+    LONG ref;
+    UINT flags;
+    HKEY key;
+    struct default_icon normal, open, shortcut, fallback;
+};
+
+static inline struct default_extract_icon *impl_from_IDefaultExtractIconInit(IDefaultExtractIconInit *iface)
+{
+    return CONTAINING_RECORD(iface, struct default_extract_icon, IDefaultExtractIconInit_iface);
+}
+
+static inline struct default_extract_icon *impl_from_default_IExtractIconW(IExtractIconW *iface)
+{
+    return CONTAINING_RECORD(iface, struct default_extract_icon, IExtractIconW_iface);
+}
+
+static inline struct default_extract_icon *impl_from_default_IExtractIconA(IExtractIconA *iface)
+{
+    return CONTAINING_RECORD(iface, struct default_extract_icon, IExtractIconA_iface);
+}
+
+static HRESULT WINAPI DefaultExtractIconInit_QueryInterface(IDefaultExtractIconInit *iface, REFIID riid, void **obj)
+{
+    struct default_extract_icon *This = impl_from_IDefaultExtractIconInit(iface);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_guid(riid), obj);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IDefaultExtractIconInit))
+        *obj = &This->IDefaultExtractIconInit_iface;
+    else if (IsEqualIID(riid, &IID_IExtractIconW))
+        *obj = &This->IExtractIconW_iface;
+    else if (IsEqualIID(riid, &IID_IExtractIconA))
+        *obj = &This->IExtractIconA_iface;
+    else
+    {
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*obj);
+    return S_OK;
+}
+
+static ULONG WINAPI DefaultExtractIconInit_AddRef(IDefaultExtractIconInit *iface)
+{
+    struct default_extract_icon *This = impl_from_IDefaultExtractIconInit(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI DefaultExtractIconInit_Release(IDefaultExtractIconInit *iface)
+{
+    struct default_extract_icon *This = impl_from_IDefaultExtractIconInit(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        if (This->key) RegCloseKey(This->key);
+        free(This->normal.file);
+        free(This->open.file);
+        free(This->shortcut.file);
+        free(This->fallback.file);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI DefaultExtractIconInit_SetFlags(IDefaultExtractIconInit *iface, UINT flags)
+{
+    struct default_extract_icon *This = impl_from_IDefaultExtractIconInit(iface);
+
+    TRACE("(%p)->(%#x)\n", This, flags);
+    This->flags = flags;
+    return S_OK;
+}
+
+static HRESULT WINAPI DefaultExtractIconInit_SetKey(IDefaultExtractIconInit *iface, HKEY key)
+{
+    struct default_extract_icon *This = impl_from_IDefaultExtractIconInit(iface);
+    HKEY copy = NULL;
+
+    TRACE("(%p)->(%p)\n", This, key);
+    if (key && RegOpenKeyExW(key, NULL, 0, KEY_READ, &copy)) return E_INVALIDARG;
+    if (This->key) RegCloseKey(This->key);
+    This->key = copy;
+    return S_OK;
+}
+
+static HRESULT set_default_icon(struct default_icon *icon, const WCHAR *file, int index)
+{
+    WCHAR *copy = NULL;
+
+    if (file && !(copy = wcsdup(file))) return E_OUTOFMEMORY;
+    free(icon->file);
+    icon->file = copy;
+    icon->index = index;
+    icon->set = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI DefaultExtractIconInit_SetNormalIcon(IDefaultExtractIconInit *iface, LPCWSTR file, int index)
+{
+    struct default_extract_icon *This = impl_from_IDefaultExtractIconInit(iface);
+
+    TRACE("(%p)->(%s %d)\n", This, debugstr_w(file), index);
+    return set_default_icon(&This->normal, file, index);
+}
+
+static HRESULT WINAPI DefaultExtractIconInit_SetOpenIcon(IDefaultExtractIconInit *iface, LPCWSTR file, int index)
+{
+    struct default_extract_icon *This = impl_from_IDefaultExtractIconInit(iface);
+
+    TRACE("(%p)->(%s %d)\n", This, debugstr_w(file), index);
+    return set_default_icon(&This->open, file, index);
+}
+
+static HRESULT WINAPI DefaultExtractIconInit_SetShortcutIcon(IDefaultExtractIconInit *iface, LPCWSTR file, int index)
+{
+    struct default_extract_icon *This = impl_from_IDefaultExtractIconInit(iface);
+
+    TRACE("(%p)->(%s %d)\n", This, debugstr_w(file), index);
+    return set_default_icon(&This->shortcut, file, index);
+}
+
+static HRESULT WINAPI DefaultExtractIconInit_SetDefaultIcon(IDefaultExtractIconInit *iface, LPCWSTR file, int index)
+{
+    struct default_extract_icon *This = impl_from_IDefaultExtractIconInit(iface);
+
+    TRACE("(%p)->(%s %d)\n", This, debugstr_w(file), index);
+    return set_default_icon(&This->fallback, file, index);
+}
+
+static const IDefaultExtractIconInitVtbl default_extract_icon_init_vtbl =
+{
+    DefaultExtractIconInit_QueryInterface,
+    DefaultExtractIconInit_AddRef,
+    DefaultExtractIconInit_Release,
+    DefaultExtractIconInit_SetFlags,
+    DefaultExtractIconInit_SetKey,
+    DefaultExtractIconInit_SetNormalIcon,
+    DefaultExtractIconInit_SetOpenIcon,
+    DefaultExtractIconInit_SetShortcutIcon,
+    DefaultExtractIconInit_SetDefaultIcon
+};
