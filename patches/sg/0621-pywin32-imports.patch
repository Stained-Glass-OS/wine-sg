+}
+
+/* the icon for the state: open or shortcut if set, else normal, else the
+ * default; a NULL file is an icon of the shell's own */
+static HRESULT WINAPI DefaultExtractIconW_GetIconLocation(IExtractIconW *iface, UINT flags, LPWSTR file,
+                                                          UINT len, INT *index, UINT *out_flags)
+{
+    struct default_extract_icon *This = impl_from_default_IExtractIconW(iface);
+    const struct default_icon *icon = NULL;
+    WCHAR value[MAX_PATH + 16];
+    DWORD size = sizeof(value);
+
+    TRACE("(%p)->(%#x %p %u %p %p)\n", This, flags, file, len, index, out_flags);
+
+    if (!file || !len || !index) return E_INVALIDARG;
+    if ((flags & GIL_OPENICON) && This->open.set) icon = &This->open;
+    else if ((flags & GIL_FORSHORTCUT) && This->shortcut.set) icon = &This->shortcut;
+    else if (This->normal.set) icon = &This->normal;
+
+    if (out_flags) *out_flags = This->flags;
+    if (!icon && This->key &&
+        !RegGetValueW(This->key, L"DefaultIcon", NULL, RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ, NULL, value, &size) &&
+        value[0])
+    {
+        *index = PathParseIconLocationW(value);
+        lstrcpynW(file, value, len);
+        return S_OK;
+    }
+    if (!icon && This->fallback.set) icon = &This->fallback;
+    if (!icon) return S_FALSE;
+
+    if (icon->file) lstrcpynW(file, icon->file, len);
+    else
+    {
+        lstrcpynW(file, swShell32Name, len);
+        if (out_flags) *out_flags |= GIL_PERCLASS;
+    }
+    *index = icon->index;
+    return S_OK;
+}
+
+static HRESULT WINAPI DefaultExtractIconW_Extract(IExtractIconW *iface, LPCWSTR file, UINT index,
+                                                  HICON *large_icon, HICON *small_icon, UINT size)
+{
+    TRACE("(%p)->(%s %u %p %p %u)\n", iface, debugstr_w(file), index, large_icon, small_icon, size);
+    /* the caller extracts from the location */
+    return S_FALSE;
+}
