+/* AssocCreateForClasses: the classes' associations, asked in order; the
+ * first class that has an answer gives it */
+struct assoc_classes
+{
+    IQueryAssociations IQueryAssociations_iface;
+    LONG ref;
+    ULONG count;
+    IQueryAssociations *items[1];
+};
+
+static inline struct assoc_classes *impl_from_assoc_classes(IQueryAssociations *iface)
+{
+    return CONTAINING_RECORD(iface, struct assoc_classes, IQueryAssociations_iface);
+}
+
+static HRESULT WINAPI assoc_classes_QueryInterface(IQueryAssociations *iface, REFIID riid, void **obj)
+{
+    struct assoc_classes *This = impl_from_assoc_classes(iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IQueryAssociations))
+    {
+        *obj = &This->IQueryAssociations_iface;
+        IQueryAssociations_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI assoc_classes_AddRef(IQueryAssociations *iface)
+{
+    struct assoc_classes *This = impl_from_assoc_classes(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI assoc_classes_Release(IQueryAssociations *iface)
+{
+    struct assoc_classes *This = impl_from_assoc_classes(iface);
+    ULONG ref = InterlockedDecrement(&This->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) IQueryAssociations_Release(This->items[i]);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI assoc_classes_Init(IQueryAssociations *iface, ASSOCF flags, LPCWSTR assoc, HKEY key, HWND hwnd)
+{
+    FIXME("(%p) the classes are set by AssocCreateForClasses\n", iface);
+    return E_NOTIMPL;
+}
+
+#define ASSOC_CLASSES_ASK(call) \
+    do { \
+        HRESULT hr = HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION); \
+        ULONG i; \
+        for (i = 0; i < This->count; i++) \
+        { \
+            hr = call; \
+            if (SUCCEEDED(hr) || hr == E_POINTER) break; \
+        } \
+        return hr; \
+    } while (0)
+
+static HRESULT WINAPI assoc_classes_GetString(IQueryAssociations *iface, ASSOCF flags, ASSOCSTR str,
+                                              LPCWSTR extra, LPWSTR out, DWORD *len)
+{
+    struct assoc_classes *This = impl_from_assoc_classes(iface);
+    ASSOC_CLASSES_ASK(IQueryAssociations_GetString(This->items[i], flags, str, extra, out, len));
+}
+
+static HRESULT WINAPI assoc_classes_GetKey(IQueryAssociations *iface, ASSOCF flags, ASSOCKEY key,
+                                           LPCWSTR extra, HKEY *out)
+{
+    struct assoc_classes *This = impl_from_assoc_classes(iface);
+    ASSOC_CLASSES_ASK(IQueryAssociations_GetKey(This->items[i], flags, key, extra, out));
+}
+
+static HRESULT WINAPI assoc_classes_GetData(IQueryAssociations *iface, ASSOCF flags, ASSOCDATA data,
+                                            LPCWSTR extra, void *out, DWORD *size)
+{
+    struct assoc_classes *This = impl_from_assoc_classes(iface);
+    ASSOC_CLASSES_ASK(IQueryAssociations_GetData(This->items[i], flags, data, extra, out, size));
+}
+
+static HRESULT WINAPI assoc_classes_GetEnum(IQueryAssociations *iface, ASSOCF flags, ASSOCENUM assocenum,
+                                            LPCWSTR extra, REFIID riid, void **out)
+{
+    struct assoc_classes *This = impl_from_assoc_classes(iface);
+    ASSOC_CLASSES_ASK(IQueryAssociations_GetEnum(This->items[i], flags, assocenum, extra, riid, out));
+}
+
+#undef ASSOC_CLASSES_ASK
+
+static const IQueryAssociationsVtbl assoc_classes_vtbl =
+{
+    assoc_classes_QueryInterface,
+    assoc_classes_AddRef,
+    assoc_classes_Release,
+    assoc_classes_Init,
+    assoc_classes_GetString,
+    assoc_classes_GetKey,
+    assoc_classes_GetData,
+    assoc_classes_GetEnum
+};
+
+/* one class's associations */
+static HRESULT assoc_class_create(const ASSOCIATIONELEMENT *element, IQueryAssociations **ret)
+{
+    static const WCHAR *prefixes[] =
+    {
+        [ASSOCCLASS_CLSID_STR] = L"CLSID\\",
+        [ASSOCCLASS_APP_STR] = L"Applications\\",
+        [ASSOCCLASS_SYSTEM_STR] = L"SystemFileAssociations\\",
+    };
+    IQueryAssociations *assoc;
+    WCHAR *name = NULL;
+    const WCHAR *str = NULL;
+    HKEY key = NULL;
+    HRESULT hr;
+
+    switch (element->ac)
+    {
+    case ASSOCCLASS_SHELL_KEY:
+    case ASSOCCLASS_PROGID_KEY:
+    case ASSOCCLASS_CLSID_KEY:
+    case ASSOCCLASS_APP_KEY:
+        if (!(key = element->hkClass)) return E_INVALIDARG;
+        break;
+    case ASSOCCLASS_PROGID_STR:
+    case ASSOCCLASS_FIXED_PROGID_STR:
+    case ASSOCCLASS_PROTOCOL_STR:
+        str = element->pszClass;
+        break;
+    case ASSOCCLASS_CLSID_STR:
+    case ASSOCCLASS_APP_STR:
+    case ASSOCCLASS_SYSTEM_STR:
+        if (!element->pszClass) return E_INVALIDARG;
+        if (!(name = malloc((wcslen(prefixes[element->ac]) + wcslen(element->pszClass) + 1) * sizeof(WCHAR))))
+            return E_OUTOFMEMORY;
+        lstrcpyW(name, prefixes[element->ac]);
+        lstrcatW(name, element->pszClass);
+        str = name;
+        break;
+    case ASSOCCLASS_FOLDER:
+        str = L"Folder";
+        break;
+    case ASSOCCLASS_STAR:
+        str = L"*";
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    if (!key && !str)
+    {
+        free(name);
+        return E_INVALIDARG;
+    }
+    if (SUCCEEDED(hr = QueryAssociations_Constructor(NULL, &IID_IQueryAssociations, (void **)&assoc)))
+    {
+        if (SUCCEEDED(hr = IQueryAssociations_Init(assoc, 0, str, key, NULL))) *ret = assoc;
+        else IQueryAssociations_Release(assoc);
+    }
+    free(name);
+    return hr;
+}
