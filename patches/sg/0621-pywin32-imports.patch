+/* the threads' cancel objects (CoSetCancelObject), by thread: a cancel
+ * object is reached from other threads by CoGetCancelObject and CoCancelCall */
+struct cancel_object
+{
+    struct list entry;
+    DWORD tid;
+    IUnknown *object;
+};
+
+static struct list cancel_objects = LIST_INIT(cancel_objects);
+static CRITICAL_SECTION cancel_objects_cs;
+static CRITICAL_SECTION_DEBUG cancel_objects_cs_debug =
+{
+    0, 0, &cancel_objects_cs,
+    { &cancel_objects_cs_debug.ProcessLocksList, &cancel_objects_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": cancel_objects_cs") }
+};
+static CRITICAL_SECTION cancel_objects_cs = { &cancel_objects_cs_debug, -1, 0, 0, 0, 0 };
+
+static void set_cancel_object(struct tlsdata *tlsdata, IUnknown *object)
+{
+    DWORD tid = GetCurrentThreadId();
+    struct cancel_object *cursor, *found = NULL;
+    IUnknown *old;
+
+    EnterCriticalSection(&cancel_objects_cs);
+    LIST_FOR_EACH_ENTRY(cursor, &cancel_objects, struct cancel_object, entry)
+        if (cursor->tid == tid) { found = cursor; break; }
+    if (object)
+    {
+        if (!found && (found = malloc(sizeof(*found))))
+        {
+            found->tid = tid;
+            list_add_tail(&cancel_objects, &found->entry);
+        }
+        if (found) found->object = object;
+        IUnknown_AddRef(object);
+    }
+    else if (found)
+    {
+        list_remove(&found->entry);
+        free(found);
+    }
+    old = tlsdata->cancel_object;
+    tlsdata->cancel_object = object;
+    LeaveCriticalSection(&cancel_objects_cs);
+
+    if (old) IUnknown_Release(old);
+}
+
+static IUnknown *get_cancel_object(DWORD tid)
+{
+    struct cancel_object *cursor;
+    IUnknown *object = NULL;
+
+    if (!tid) tid = GetCurrentThreadId();
+    EnterCriticalSection(&cancel_objects_cs);
+    LIST_FOR_EACH_ENTRY(cursor, &cancel_objects, struct cancel_object, entry)
+    {
+        if (cursor->tid != tid) continue;
+        object = cursor->object;
+        IUnknown_AddRef(object);
+        break;
+    }
+    LeaveCriticalSection(&cancel_objects_cs);
+    return object;
+}
+
 static void com_cleanup_tlsdata(void)
 {
     struct tlsdata *tlsdata = NtCurrentTeb()->ReservedForOle;
@@ -425,6 +493,9 @@
     if (tlsdata->context_token)
         IObjContext_Release(tlsdata->context_token);
 
