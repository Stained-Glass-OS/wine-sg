+/*************************************************************************
+ * AssocCreateForClasses [SHELL32.@]
+ */
+HRESULT WINAPI AssocCreateForClasses(const ASSOCIATIONELEMENT *classes, ULONG count, REFIID riid, void **obj)
+{
+    struct assoc_classes *assoc;
+    HRESULT hr;
+    ULONG i;
+
+    TRACE("(%p %lu %s %p)\n", classes, count, debugstr_guid(riid), obj);
+
+    if (!obj) return E_POINTER;
+    *obj = NULL;
+    if (!classes || !count) return E_INVALIDARG;
+
+    if (!(assoc = calloc(1, offsetof(struct assoc_classes, items[count]))))
+        return E_OUTOFMEMORY;
+    assoc->IQueryAssociations_iface.lpVtbl = &assoc_classes_vtbl;
+    assoc->ref = 1;
+    for (i = 0; i < count; i++)
+        if (SUCCEEDED(assoc_class_create(&classes[i], &assoc->items[assoc->count]))) assoc->count++;
+
+    hr = IQueryAssociations_QueryInterface(&assoc->IQueryAssociations_iface, riid, obj);
+    IQueryAssociations_Release(&assoc->IQueryAssociations_iface);
+    return hr;
+}
