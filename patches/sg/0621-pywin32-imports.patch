+
+static HRESULT WINAPI DefaultExtractIconA_GetIconLocation(IExtractIconA *iface, UINT flags, LPSTR file,
+                                                          UINT len, INT *index, UINT *out_flags)
+{
+    struct default_extract_icon *This = impl_from_default_IExtractIconA(iface);
+    WCHAR fileW[MAX_PATH];
+    HRESULT hr;
+
+    if (!file || !len) return E_INVALIDARG;
+    hr = IExtractIconW_GetIconLocation(&This->IExtractIconW_iface, flags, fileW, MAX_PATH, index, out_flags);
+    if (hr == S_OK) WideCharToMultiByte(CP_ACP, 0, fileW, -1, file, len, NULL, NULL);
+    return hr;
+}
