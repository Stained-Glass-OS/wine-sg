+/*************************************************************************
+ * SHCreateDefaultExtractIcon [SHELL32.@]
+ */
+HRESULT WINAPI SHCreateDefaultExtractIcon(REFIID riid, void **obj)
+{
+    struct default_extract_icon *icon;
+    HRESULT hr;
+
+    TRACE("(%s %p)\n", debugstr_guid(riid), obj);
+
+    if (!obj) return E_POINTER;
+    *obj = NULL;
+    if (!(icon = calloc(1, sizeof(*icon)))) return E_OUTOFMEMORY;
+    icon->IDefaultExtractIconInit_iface.lpVtbl = &default_extract_icon_init_vtbl;
+    icon->IExtractIconW_iface.lpVtbl = &default_extract_iconw_vtbl;
+    icon->IExtractIconA_iface.lpVtbl = &default_extract_icona_vtbl;
+    icon->ref = 1;
+    hr = IDefaultExtractIconInit_QueryInterface(&icon->IDefaultExtractIconInit_iface, riid, obj);
+    IDefaultExtractIconInit_Release(&icon->IDefaultExtractIconInit_iface);
+    return hr;
+}
