+
+/******************************************************************************
+ * QueryUsersOnEncryptedFile [ADVAPI32.@]
+ */
+DWORD WINAPI QueryUsersOnEncryptedFile(LPCWSTR name, PENCRYPTION_CERTIFICATE_HASH_LIST *users)
+{
+    TRACE("(%s %p)\n", debugstr_w(name), users);
+    if (!name || !users) return ERROR_INVALID_PARAMETER;
+    *users = NULL;
+    return GetFileAttributesW(name) == INVALID_FILE_ATTRIBUTES ? GetLastError() : ERROR_FILE_NOT_ENCRYPTED;
+}
+
+/******************************************************************************
+ * QueryRecoveryAgentsOnEncryptedFile [ADVAPI32.@]
+ */
+DWORD WINAPI QueryRecoveryAgentsOnEncryptedFile(LPCWSTR name, PENCRYPTION_CERTIFICATE_HASH_LIST *agents)
+{
+    return QueryUsersOnEncryptedFile(name, agents);
+}
+
+/******************************************************************************
+ * AddUsersToEncryptedFile [ADVAPI32.@]
+ */
+DWORD WINAPI AddUsersToEncryptedFile(LPCWSTR name, PENCRYPTION_CERTIFICATE_LIST users)
+{
+    PENCRYPTION_CERTIFICATE_HASH_LIST none;
+
+    TRACE("(%s %p)\n", debugstr_w(name), users);
+    if (!users) return ERROR_INVALID_PARAMETER;
+    return QueryUsersOnEncryptedFile(name, &none);
+}
