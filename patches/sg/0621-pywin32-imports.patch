+static ULONG WINAPI DefaultExtractIconW_AddRef(IExtractIconW *iface)
+{
+    struct default_extract_icon *This = impl_from_default_IExtractIconW(iface);
+    return IDefaultExtractIconInit_AddRef(&This->IDefaultExtractIconInit_iface);
+}
+
+static ULONG WINAPI DefaultExtractIconW_Release(IExtractIconW *iface)
+{
+    struct default_extract_icon *This = impl_from_default_IExtractIconW(iface);
