From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernel32: Implement Wow64GetThreadSelectorEntry.

Wow64GetThreadSelectorEntry gives a 64-bit process a thread's 32-bit
descriptor entries through RtlWow64GetThreadSelectorEntry, and fails with
ERROR_NOT_SUPPORTED in a 32-bit process, as documented; it returned
STATUS_NOT_IMPLEMENTED.

Gate: test/kernel32-wow64selector-gate.sh.
---
 dlls/kernel32/thread.c | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/dlls/kernel32/thread.c b/dlls/kernel32/thread.c
index 7f1a3f5..a18fb6b 100644
--- a/dlls/kernel32/thread.c
+++ b/dlls/kernel32/thread.c
@@ -77,8 +77,23 @@ void WINAPI FreeLibraryAndExitThread(HINSTANCE hLibModule, DWORD dwExitCode)
  */
 BOOL WINAPI Wow64GetThreadSelectorEntry( HANDLE thread, DWORD selector, WOW64_LDT_ENTRY *selector_entry)
 {
-    FIXME("(%p %lu %p): stub\n", thread, selector, selector_entry);
-    return set_ntstatus( STATUS_NOT_IMPLEMENTED );
+#ifdef _WIN64
+    THREAD_DESCRIPTOR_INFORMATION info;
+
+    TRACE("(%p %lu %p)\n", thread, selector, selector_entry);
+
+    info.Selector = selector;
+    if (!set_ntstatus( RtlWow64GetThreadSelectorEntry( thread, &info, sizeof(info), NULL ))) return FALSE;
+#ifndef SG_MUTANT_WOW64_SEL_EMPTY
+    *selector_entry = info.Entry;   /* WOW64_LDT_ENTRY is LDT_ENTRY */
+#endif
+    return TRUE;
+#else
+    /* only a 64-bit process can ask (documented) */
+    TRACE("(%p %lu %p): not a 64-bit process\n", thread, selector, selector_entry);
+    SetLastError( ERROR_NOT_SUPPORTED );
+    return FALSE;
+#endif
 }
 
 
