+    if (!cms_next(&p, end, &t) || !cms_int(&t, &k->dwVersion)) return FALSE;
+    if (!cms_next(&p, end, &kekid) || kekid.tag != 0x30) return FALSE;
+    q = kekid.content;
+    if (!cms_next(&q, kekid.end, &id) || !cms_octets(a, &id, &k->KeyId)) return FALSE;
+    if (!cms_date_and_other(a, &q, kekid.end, &k->Date, &k->pOtherAttr)) return FALSE;
+    if (!cms_next(&p, end, &t) || !cms_alg(a, &t, &k->KeyEncryptionAlgorithm)) return FALSE;
+    return cms_next(&p, end, &t) && cms_octets(a, &t, &k->EncryptedKey);
+}
+
+static BOOL cms_build_recipient(const struct cms_recipient *r, BYTE *base, DWORD *used)
+{
+    struct cms_arena a = { base, 0 };
+    CMSG_CMS_RECIPIENT_INFO *info = cms_alloc(&a, sizeof(*info));
+    const BYTE *p = r->der;
+    struct cms_tlv t;
+    BOOL ret;
+
+    if (!cms_next(&p, r->der + r->len, &t)) return FALSE;
+    info->dwRecipientChoice = r->choice;
+    switch (r->choice)
+    {
+    case CMSG_KEY_TRANS_RECIPIENT:
+        ret = cms_ktri(&a, t.content, t.end, &info->pKeyTrans);
+        break;
+    case CMSG_KEY_AGREE_RECIPIENT:
+#ifdef SG_MUTANT_ENV_KARI_UNSUPPORTED
+        ret = FALSE;
+        break;
+#endif
+        ret = cms_kari(&a, t.content, t.end, (CMS_KEY_AGREE_RECIPIENT_INFO **)&info->pKeyAgree);
+        break;
+    default:
+        ret = cms_kekri(&a, t.content, t.end, &info->pMailList);
+        break;
+    }
+    *used = a.used;
+    return ret;
+}
+
+static BOOL CRYPT_CopyCmsRecipientInfo(void *pvData, DWORD *pcbData, const struct cms_recipient *r)
+{
+    DWORD used = 0, cap = 4096 + 8 * r->len;
+    BYTE *scratch = CryptMemAlloc(cap);
+    BOOL ret;
+
+    if (!scratch)
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    ret = cms_build_recipient(r, scratch, &used);
+    CryptMemFree(scratch);
+    if (!ret)
+    {
+        SetLastError(CRYPT_E_ASN1_CORRUPT);
+        return FALSE;
+    }
+    if (!pvData)
+    {
+        *pcbData = used;
+        return TRUE;
+    }
+    if (*pcbData < used)
+    {
+        *pcbData = used;
+        SetLastError(ERROR_MORE_DATA);
+        return FALSE;
+    }
+    ret = cms_build_recipient(r, pvData, &used);
+    *pcbData = used;
+    return ret;
+}
