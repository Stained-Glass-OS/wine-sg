From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: enveloped message recipient and attribute parameters

crypt32: enveloped message recipient and attribute parameters

CryptMsgGetParam on a decoded enveloped message answers
CMSG_CMS_RECIPIENT_COUNT_PARAM, CMSG_CMS_RECIPIENT_INFO_PARAM,
CMSG_CMS_RECIPIENT_INDEX_PARAM, CMSG_ENCRYPTED_KEY_INDEX_PARAM,
CMSG_RECIPIENT_INDEX_PARAM, CMSG_UNPROTECTED_ATTR_PARAM and
CMSG_ENCRYPT_PARAM, for key transport, key agreement and KEK recipients.
---
--- a/dlls/crypt32/msg.c
+++ b/dlls/crypt32/msg.c
@@ -2066,12 +2066,26 @@ HCRYPTMSG WINAPI CryptMsgOpenToEncode(DWORD dwMsgEncodingType, DWORD dwFlags,
     return msg;
 }
 
+/* A recipient of an enveloped message as encoded: key transport (0x30), key agreement ([1]) or
+ * mail list ([2]) */
+struct cms_recipient
+{
+    DWORD choice;       /* CMSG_KEY_TRANS_RECIPIENT, ... */
+    int   ktri_index;   /* its index among the key transport recipients data holds, or -1 */
+    DWORD len;
+    BYTE *der;          /* the whole encoding of the recipient info */
+};
+
 typedef struct _CEnvelopedDecodeMsg
 {
     CRYPT_ENVELOPED_DATA *data;
     HCRYPTPROV            crypt_prov;
     CRYPT_DATA_BLOB       content;
     BOOL                  decrypted;
+    struct cms_recipient *recipients;     /* every recipient of the message, in order */
+    DWORD                 n_recipients;
+    CRYPT_ATTRIBUTES     *unprotected;    /* the unprotected attributes, or NULL */
+    int                   decrypt_index;  /* the key transport recipient that decrypted, or -1 */
 } CEnvelopedDecodeMsg;
 
 typedef struct _CDecodeMsg
@@ -2112,6 +2126,14 @@ static void CDecodeMsg_Close(HCRYPTMSG hCryptMsg)
             CryptReleaseContext(msg->u.enveloped_data.crypt_prov, 0);
         LocalFree(msg->u.enveloped_data.data);
         CryptMemFree(msg->u.enveloped_data.content.pbData);
+        {
+            DWORD i;
+
+            for (i = 0; i < msg->u.enveloped_data.n_recipients; i++)
+                CryptMemFree(msg->u.enveloped_data.recipients[i].der);
+            CryptMemFree(msg->u.enveloped_data.recipients);
+            LocalFree(msg->u.enveloped_data.unprotected);
+        }
         break;
     case CMSG_SIGNED:
         if (msg->u.signed_data.info)
@@ -2256,18 +2278,219 @@ static BOOL CDecodeMsg_DecodeHashedContent(CDecodeMsg *msg,
     return ret;
 }
 
+static BOOL cms_der_next(const BYTE **ptr, const BYTE *end, BYTE *tag, const BYTE **content, DWORD *content_len)
+{
+    const BYTE *p = *ptr;
+    DWORD len;
+
+    if (end - p < 2) return FALSE;
+    *tag = *p++;
+    len = *p++;
+    if (len & 0x80)
+    {
+        DWORD n = len & 0x7f;
+
+        if (!n || n > 3 || end - p < n) return FALSE;
+        for (len = 0; n; n--) len = (len << 8) | *p++;
+    }
+    if (len > end - p) return FALSE;
+    *content = p;
+    *content_len = len;
+    *ptr = p + len;
+    return TRUE;
+}
+
+static BYTE *cms_der_tlv(BYTE tag, const BYTE *a, DWORD a_len, const BYTE *b, DWORD b_len, DWORD *out_len)
+{
+    DWORD len = a_len + b_len, header = len < 0x80 ? 2 : len < 0x100 ? 3 : len < 0x10000 ? 4 : 5;
+    BYTE *ret = CryptMemAlloc(header + len);
+
+    if (!ret) return NULL;
+    ret[0] = tag;
+    if (len < 0x80) ret[1] = len;
+    else if (len < 0x100) { ret[1] = 0x81; ret[2] = len; }
+    else if (len < 0x10000) { ret[1] = 0x82; ret[2] = len >> 8; ret[3] = len; }
+    else { ret[1] = 0x83; ret[2] = len >> 16; ret[3] = len >> 8; ret[4] = len; }
+    if (a_len) memcpy(ret + header, a, a_len);
+    if (b_len) memcpy(ret + header + a_len, b, b_len);
+    *out_len = header + len;
+    return ret;
+}
+
+/* Reads the recipients and the unprotected attributes of an EnvelopedData encoding, which the model of
+ * CRYPT_ENVELOPED_DATA (key transport recipients with an issuer and serial number only) does not keep.
+ * When something in the message does not fit that model, *rebuilt is an encoding of the message with
+ * just the recipients it does fit. FALSE if the encoding is not plain DER: the message is then decoded
+ * as it is, without these extras. */
+static BOOL CDecodeMsg_ReadEnvelopedExtras(CEnvelopedDecodeMsg *env, const BYTE *der, DWORD len, BYTE **rebuilt,
+ DWORD *rebuilt_len)
+{
+    const BYTE *p = der, *end = der + len, *c, *inner, *iend, *version, *version_end, *set, *set_end, *eci, *eci_end;
+    const BYTE *e, *start, *unprot = NULL;
+    DWORD clen, n = 0, total, n_legacy = 0, unprot_len = 0;
+    BOOL extra = FALSE;
+    BYTE tag;
+    struct cms_recipient *recipients;
+    BYTE *legacy;
+
+    if (!cms_der_next(&p, end, &tag, &c, &clen) || tag != 0x30) return FALSE;
+    inner = c;
+    iend = c + clen;
+    version = inner;
+    if (!cms_der_next(&inner, iend, &tag, &c, &clen) || tag != 2) return FALSE;
+    version_end = inner;
+    start = inner;
+    if (!cms_der_next(&inner, iend, &tag, &c, &clen)) return FALSE;
+    if (tag == 0xa0) /* originatorInfo */
+    {
+        extra = TRUE;
+        start = inner;
+        if (!cms_der_next(&inner, iend, &tag, &c, &clen)) return FALSE;
+    }
+    if (tag != 0x31) return FALSE;
+    set = c;
+    set_end = c + clen;
+    eci = inner;
+    if (!cms_der_next(&inner, iend, &tag, &c, &clen) || tag != 0x30) return FALSE;
+    eci_end = inner;
+    if (inner < iend)
+    {
+        if (!cms_der_next(&inner, iend, &tag, &c, &clen) || tag != 0xa1 || inner != iend) return FALSE;
+        unprot = c;
+        unprot_len = clen;
+        extra = TRUE;
+    }
+    (void)start;
+
+    /* count, then read the recipients */
+    for (e = set; e < set_end; )
+    {
+        if (!cms_der_next(&e, set_end, &tag, &c, &clen)) return FALSE;
+        if (tag == 0x30 || tag == 0xa1 || tag == 0xa2) n++;
+    }
+    total = n;
+    if (!(recipients = CryptMemAlloc((n ? n : 1) * sizeof(*recipients)))) return FALSE;
+    memset(recipients, 0, (n ? n : 1) * sizeof(*recipients));
+    n = 0;
+    for (e = set; e < set_end; )
+    {
+        const BYTE *rstart = e;
+
+        cms_der_next(&e, set_end, &tag, &c, &clen);
+        if (tag != 0x30 && tag != 0xa1 && tag != 0xa2) continue;
+        recipients[n].len = e - rstart;
+        if (!(recipients[n].der = CryptMemAlloc(recipients[n].len))) goto fail;
+        memcpy(recipients[n].der, rstart, recipients[n].len);
+        recipients[n].choice = tag == 0x30 ? CMSG_KEY_TRANS_RECIPIENT : tag == 0xa1 ? CMSG_KEY_AGREE_RECIPIENT :
+         CMSG_MAIL_LIST_RECIPIENT;
+        recipients[n].ktri_index = -1;
+        if (tag == 0x30)
+        {
+            /* version 0 with an issuer and serial number is what the model holds */
+            const BYTE *q = c, *qend = c + clen, *vc, *rc;
+            DWORD vl, rl;
+            BYTE vtag, rtag;
+
+            if (cms_der_next(&q, qend, &vtag, &vc, &vl) && vtag == 2 && vl == 1 && vc[0] == 0 &&
+             cms_der_next(&q, qend, &rtag, &rc, &rl) && rtag == 0x30)
+                recipients[n].ktri_index = n_legacy++;
+        }
+        n++;
+    }
+    if (n_legacy == n && !extra)
+    {
+        env->recipients = recipients;
+        env->n_recipients = n;
+        *rebuilt = NULL;
+        return TRUE;
+    }
+
+    /* the message with the recipients the model holds */
+    {
+        BYTE *set_data = NULL, *new_set, *body, *result;
+        DWORD set_data_len = 0, new_set_len, body_len, i;
+
+        if (n_legacy)
+        {
+            if (!(set_data = CryptMemAlloc(set_end - set))) goto fail;
+            for (i = 0; i < n; i++)
+                if (recipients[i].ktri_index >= 0)
+                {
+                    memcpy(set_data + set_data_len, recipients[i].der, recipients[i].len);
+                    set_data_len += recipients[i].len;
+                }
+        }
+        if (!(new_set = cms_der_tlv(0x31, set_data, set_data_len, NULL, 0, &new_set_len)))
+        {
+            CryptMemFree(set_data);
+            goto fail;
+        }
+        CryptMemFree(set_data);
+        legacy = new_set;
+        body_len = (version_end - version) + new_set_len + (eci_end - eci);
+        if (!(body = CryptMemAlloc(body_len)))
+        {
+            CryptMemFree(legacy);
+            goto fail;
+        }
+        memcpy(body, version, version_end - version);
+        memcpy(body + (version_end - version), legacy, new_set_len);
+        memcpy(body + (version_end - version) + new_set_len, eci, eci_end - eci);
+        CryptMemFree(legacy);
+        result = cms_der_tlv(0x30, body, body_len, NULL, 0, rebuilt_len);
+        CryptMemFree(body);
+        if (!result) goto fail;
+        *rebuilt = result;
+    }
+    env->recipients = recipients;
+    env->n_recipients = n;
+    if (unprot)
+    {
+        BYTE *attrs_der = cms_der_tlv(0x31, unprot, unprot_len, NULL, 0, &clen);
+        DWORD size;
+
+        if (attrs_der)
+        {
+            CryptDecodeObjectEx(X509_ASN_ENCODING, PKCS_ATTRIBUTES, attrs_der, clen, CRYPT_DECODE_ALLOC_FLAG, NULL,
+             &env->unprotected, &size);
+            CryptMemFree(attrs_der);
+        }
+    }
+    return TRUE;
+
+fail:
+    {
+        DWORD i;
+
+        for (i = 0; i < total; i++) CryptMemFree(recipients[i].der);
+    }
+    CryptMemFree(recipients);
+    return FALSE;
+}
+
 static BOOL CDecodeMsg_DecodeEnvelopedContent(CDecodeMsg *msg,
  const CRYPT_DER_BLOB *blob)
 {
     BOOL ret;
     CRYPT_ENVELOPED_DATA *envelopedData;
-    DWORD size;
+    BYTE *rebuilt = NULL;
+    DWORD size, rebuilt_len = 0;
+    const BYTE *der = blob->pbData;
+    DWORD der_len = blob->cbData;
 
-    ret = CRYPT_AsnDecodePKCSEnvelopedData(blob->pbData, blob->cbData,
+    msg->u.enveloped_data.decrypt_index = -1;
+    if (CDecodeMsg_ReadEnvelopedExtras(&msg->u.enveloped_data, blob->pbData, blob->cbData, &rebuilt, &rebuilt_len) &&
+     rebuilt)
+    {
+        der = rebuilt;
+        der_len = rebuilt_len;
+    }
+    ret = CRYPT_AsnDecodePKCSEnvelopedData(der, der_len,
      CRYPT_DECODE_ALLOC_FLAG, NULL, (CRYPT_ENVELOPED_DATA *)&envelopedData,
      &size);
     if (ret)
         msg->u.enveloped_data.data = envelopedData;
+    CryptMemFree(rebuilt);
     return ret;
 }
 
@@ -3018,6 +3241,362 @@ static BOOL CRYPT_CopyAlgorithmParam(void *pvData, DWORD *pcbData, const CRYPT_A
     return ret;
 }
 
+/* The layouts of the Windows headers for key agreement; wine's wincrypt.h declares the key agreement
+ * recipient info with a different, shorter layout */
+typedef struct _CMS_RECIPIENT_ENCRYPTED_KEY
+{
+    CERT_ID                     RecipientId;
+    CRYPT_DATA_BLOB             EncryptedKey;
+    FILETIME                    Date;
+    PCRYPT_ATTRIBUTE_TYPE_VALUE pOtherAttr;
+} CMS_RECIPIENT_ENCRYPTED_KEY;
+
+typedef struct _CMS_KEY_AGREE_RECIPIENT_INFO
+{
+    DWORD                         dwVersion;
+    DWORD                         dwOriginatorChoice;
+    union
+    {
+        CERT_ID              OriginatorCertId;
+        CERT_PUBLIC_KEY_INFO OriginatorPublicKeyInfo;
+    } u;
+    CRYPT_DATA_BLOB               UserKeyingMaterial;
+    CRYPT_ALGORITHM_IDENTIFIER    KeyEncryptionAlgorithm;
+    DWORD                         cRecipientEncryptedKeys;
+    CMS_RECIPIENT_ENCRYPTED_KEY **rgpRecipientEncryptedKeys;
+} CMS_KEY_AGREE_RECIPIENT_INFO;
+
+struct cms_arena
+{
+    BYTE *base;
+    DWORD used;
+};
+
+struct cms_tlv
+{
+    BYTE        tag;
+    const BYTE *start, *content, *end;
+    DWORD       len;
+};
+
+static void *cms_alloc(struct cms_arena *a, DWORD size)
+{
+    DWORD start = (a->used + 7) & ~7;
+
+    a->used = start + size;
+    memset(a->base + start, 0, size);
+    return a->base + start;
+}
+
+static BYTE *cms_copy(struct cms_arena *a, const BYTE *src, DWORD len)
+{
+    BYTE *dst;
+
+    if (!len) return NULL;
+    dst = cms_alloc(a, len);
+    memcpy(dst, src, len);
+    return dst;
+}
+
+static BOOL cms_next(const BYTE **ptr, const BYTE *end, struct cms_tlv *t)
+{
+    t->start = *ptr;
+    if (!cms_der_next(ptr, end, &t->tag, &t->content, &t->len)) return FALSE;
+    t->end = *ptr;
+    return TRUE;
+}
+
+static BOOL cms_oid(struct cms_arena *a, const struct cms_tlv *t, char **out)
+{
+    char **oid;
+    DWORD size;
+
+    if (t->tag != 6) return FALSE;
+    if (!CryptDecodeObjectEx(X509_ASN_ENCODING, X509_OBJECT_IDENTIFIER, t->start, t->end - t->start,
+     CRYPT_DECODE_ALLOC_FLAG, NULL, &oid, &size)) return FALSE;
+    *out = (char *)cms_copy(a, (BYTE *)*oid, strlen(*oid) + 1);
+    LocalFree(oid);
+    return TRUE;
+}
+
+static BOOL cms_int(const struct cms_tlv *t, DWORD *out)
+{
+    DWORD i;
+
+    if (t->tag != 2 || !t->len || t->len > 5) return FALSE;
+    for (*out = 0, i = 0; i < t->len; i++) *out = (*out << 8) | t->content[i];
+    return TRUE;
+}
+
+static BOOL cms_alg(struct cms_arena *a, const struct cms_tlv *seq, CRYPT_ALGORITHM_IDENTIFIER *out)
+{
+    const BYTE *p = seq->content;
+    struct cms_tlv t;
+
+    if (seq->tag != 0x30 || !cms_next(&p, seq->end, &t) || !cms_oid(a, &t, &out->pszObjId)) return FALSE;
+    if (p < seq->end)
+    {
+        if (!cms_next(&p, seq->end, &t)) return FALSE;
+        out->Parameters.cbData = t.end - t.start;
+        out->Parameters.pbData = cms_copy(a, t.start, out->Parameters.cbData);
+    }
+    return TRUE;
+}
+
+static BOOL cms_octets(struct cms_arena *a, const struct cms_tlv *t, CRYPT_DATA_BLOB *out)
+{
+    if (t->tag != 4) return FALSE;
+    out->cbData = t->len;
+    out->pbData = cms_copy(a, t->content, t->len);
+    return TRUE;
+}
+
+/* issuerAndSerialNumber */
+static BOOL cms_isn(struct cms_arena *a, const struct cms_tlv *seq, CERT_ID *id)
+{
+    const BYTE *p = seq->content;
+    struct cms_tlv name, serial;
+    DWORD i;
+
+    if (seq->tag != 0x30 || !cms_next(&p, seq->end, &name) || name.tag != 0x30 || !cms_next(&p, seq->end, &serial) ||
+     serial.tag != 2) return FALSE;
+    id->dwIdChoice = CERT_ID_ISSUER_SERIAL_NUMBER;
+    id->IssuerSerialNumber.Issuer.cbData = name.end - name.start;
+    id->IssuerSerialNumber.Issuer.pbData = cms_copy(a, name.start, name.end - name.start);
+    id->IssuerSerialNumber.SerialNumber.cbData = serial.len;
+    if (serial.len)
+    {
+        BYTE *dst = cms_alloc(a, serial.len);
+
+        for (i = 0; i < serial.len; i++) dst[i] = serial.content[serial.len - 1 - i];
+        id->IssuerSerialNumber.SerialNumber.pbData = dst;
+    }
+    return TRUE;
+}
+
+static BOOL cms_key_id(struct cms_arena *a, const struct cms_tlv *t, CERT_ID *id)
+{
+    id->dwIdChoice = CERT_ID_KEY_IDENTIFIER;
+    id->KeyId.cbData = t->len;
+    id->KeyId.pbData = cms_copy(a, t->content, t->len);
+    return TRUE;
+}
+
+static BOOL cms_date_and_other(struct cms_arena *a, const BYTE **p, const BYTE *end, FILETIME *date,
+ CRYPT_ATTRIBUTE_TYPE_VALUE **other)
+{
+    struct cms_tlv t;
+    const BYTE *save;
+
+    save = *p;
+    if (*p < end && cms_next(p, end, &t) && t.tag == 0x18)
+    {
+        DWORD size = sizeof(*date);
+
+        if (!CryptDecodeObjectEx(X509_ASN_ENCODING, X509_CHOICE_OF_TIME, t.start, t.end - t.start, 0, NULL, date, &size))
+            return FALSE;
+    }
+    else *p = save;
+    if (*p < end)
+    {
+        const BYTE *q;
+        struct cms_tlv oid, value;
+
+        if (!cms_next(p, end, &t) || t.tag != 0x30) return FALSE;
+        q = t.content;
+        if (!cms_next(&q, t.end, &oid)) return FALSE;
+        *other = cms_alloc(a, sizeof(**other));
+        if (!cms_oid(a, &oid, &(*other)->pszObjId)) return FALSE;
+        if (q < t.end)
+        {
+            if (!cms_next(&q, t.end, &value)) return FALSE;
+            (*other)->Value.cbData = value.end - value.start;
+            (*other)->Value.pbData = cms_copy(a, value.start, (*other)->Value.cbData);
+        }
+    }
+    return TRUE;
+}
+
+/* KeyTransRecipientInfo, as the content of its SEQUENCE */
+static BOOL cms_ktri(struct cms_arena *a, const BYTE *p, const BYTE *end, CMSG_KEY_TRANS_RECIPIENT_INFO **out)
+{
+    CMSG_KEY_TRANS_RECIPIENT_INFO *k = cms_alloc(a, sizeof(*k));
+    struct cms_tlv t;
+
+    *out = k;
+    if (!cms_next(&p, end, &t) || !cms_int(&t, &k->dwVersion)) return FALSE;
+    if (!cms_next(&p, end, &t)) return FALSE;
+    if (t.tag == 0x30) { if (!cms_isn(a, &t, &k->RecipientId)) return FALSE; }
+    else if (t.tag == 0x80) cms_key_id(a, &t, &k->RecipientId);
+    else return FALSE;
+    if (!cms_next(&p, end, &t) || !cms_alg(a, &t, &k->KeyEncryptionAlgorithm)) return FALSE;
+    return cms_next(&p, end, &t) && cms_octets(a, &t, &k->EncryptedKey);
+}
+
+/* KeyAgreeRecipientInfo, as the content of its [1] */
+static BOOL cms_kari(struct cms_arena *a, const BYTE *p, const BYTE *end, CMS_KEY_AGREE_RECIPIENT_INFO **out)
+{
+    CMS_KEY_AGREE_RECIPIENT_INFO *k = cms_alloc(a, sizeof(*k));
+    struct cms_tlv t, originator, keys;
+    const BYTE *q;
+    DWORD count = 0, i;
+
+    *out = k;
+    if (!cms_next(&p, end, &t) || !cms_int(&t, &k->dwVersion)) return FALSE;
+    if (!cms_next(&p, end, &originator) || originator.tag != 0xa0) return FALSE;
+    q = originator.content;
+    if (!cms_next(&q, originator.end, &t)) return FALSE;
+    if (t.tag == 0x30)
+    {
+        k->dwOriginatorChoice = CMSG_KEY_AGREE_ORIGINATOR_CERT;
+        if (!cms_isn(a, &t, &k->u.OriginatorCertId)) return FALSE;
+    }
+    else if (t.tag == 0x80)
+    {
+        k->dwOriginatorChoice = CMSG_KEY_AGREE_ORIGINATOR_CERT;
+        cms_key_id(a, &t, &k->u.OriginatorCertId);
+    }
+    else if (t.tag == 0xa1)
+    {
+        struct cms_tlv alg, key;
+        const BYTE *r = t.content;
+
+        k->dwOriginatorChoice = CMSG_KEY_AGREE_ORIGINATOR_PUBLIC_KEY;
+        if (!cms_next(&r, t.end, &alg) || !cms_alg(a, &alg, &k->u.OriginatorPublicKeyInfo.Algorithm)) return FALSE;
+        if (!cms_next(&r, t.end, &key) || key.tag != 3 || !key.len) return FALSE;
+        k->u.OriginatorPublicKeyInfo.PublicKey.cbData = key.len - 1;
+        k->u.OriginatorPublicKeyInfo.PublicKey.cUnusedBits = key.content[0];
+        k->u.OriginatorPublicKeyInfo.PublicKey.pbData = cms_copy(a, key.content + 1, key.len - 1);
+    }
+    else return FALSE;
+    if (!cms_next(&p, end, &t)) return FALSE;
+    if (t.tag == 0xa1) /* ukm */
+    {
+        struct cms_tlv octets;
+
+        q = t.content;
+        if (!cms_next(&q, t.end, &octets) || !cms_octets(a, &octets, &k->UserKeyingMaterial)) return FALSE;
+        if (!cms_next(&p, end, &t)) return FALSE;
+    }
+    if (!cms_alg(a, &t, &k->KeyEncryptionAlgorithm)) return FALSE;
+    if (!cms_next(&p, end, &keys) || keys.tag != 0x30) return FALSE;
+    for (q = keys.content; q < keys.end; count++)
+        if (!cms_next(&q, keys.end, &t)) return FALSE;
+    k->cRecipientEncryptedKeys = count;
+    k->rgpRecipientEncryptedKeys = cms_alloc(a, count * sizeof(*k->rgpRecipientEncryptedKeys));
+    for (q = keys.content, i = 0; i < count; i++)
+    {
+        CMS_RECIPIENT_ENCRYPTED_KEY *ek = cms_alloc(a, sizeof(*ek));
+        struct cms_tlv rid, enc;
+        const BYTE *r;
+
+        k->rgpRecipientEncryptedKeys[i] = ek;
+        cms_next(&q, keys.end, &t);
+        r = t.content;
+        if (!cms_next(&r, t.end, &rid)) return FALSE;
+        if (rid.tag == 0x30)
+        {
+            if (!cms_isn(a, &rid, &ek->RecipientId)) return FALSE;
+        }
+        else if (rid.tag == 0xa0) /* RecipientKeyIdentifier */
+        {
+            struct cms_tlv ski;
+            const BYTE *s = rid.content;
+
+            if (!cms_next(&s, rid.end, &ski) || ski.tag != 4) return FALSE;
+            cms_key_id(a, &ski, &ek->RecipientId);
+            if (!cms_date_and_other(a, &s, rid.end, &ek->Date, &ek->pOtherAttr)) return FALSE;
+        }
+        else return FALSE;
+        if (!cms_next(&r, t.end, &enc) || !cms_octets(a, &enc, &ek->EncryptedKey)) return FALSE;
+    }
+    return TRUE;
+}
+
+/* KEKRecipientInfo, as the content of its [2] */
+static BOOL cms_kekri(struct cms_arena *a, const BYTE *p, const BYTE *end, CMSG_MAIL_LIST_RECIPIENT_INFO **out)
+{
+    CMSG_MAIL_LIST_RECIPIENT_INFO *k = cms_alloc(a, sizeof(*k));
+    struct cms_tlv t, kekid, id;
