+static void *get_cms_recipient(HCRYPTMSG msg, DWORD index, DWORD *err)
+{
+    DWORD size = 0;
+    BYTE *buf;
+
+    *err = 0;
+    if (!CryptMsgGetParam(msg, CMSG_CMS_RECIPIENT_INFO_PARAM, index, NULL, &size))
+    {
+        *err = GetLastError();
+        return NULL;
