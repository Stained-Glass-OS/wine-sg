+static void test_enveloped_cms_recipients(void)
+{
+    CMSG_CMS_RECIPIENT_INFO *info;
+    HCRYPTMSG msg;
+    DWORD size, count, err;
+    BOOL ret;
+
+    msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, 0, 0, NULL, NULL);
+    ret = CryptMsgUpdate(msg, sg_env_all, sizeof(sg_env_all), TRUE);
+    ok(ret, "CryptMsgUpdate failed: %08lx\n", GetLastError());
+
+    size = sizeof(count);
+    ret = CryptMsgGetParam(msg, CMSG_TYPE_PARAM, 0, &count, &size);
+    ok(ret && count == CMSG_ENVELOPED, "got %d, %lu\n", ret, count);
+
+    /* the key transport recipients with an issuer and serial number, and all of them */
+    size = sizeof(count);
+    ret = CryptMsgGetParam(msg, CMSG_RECIPIENT_COUNT_PARAM, 0, &count, &size);
+    ok(ret && count == 1, "got %d, %lu\n", ret, count);
+    size = sizeof(count);
+    ret = CryptMsgGetParam(msg, CMSG_CMS_RECIPIENT_COUNT_PARAM, 0, &count, &size);
+    ok(ret && count == 4, "got %d, %lu\n", ret, count);
+
+    /* key transport, issuer and serial number */
+    info = get_cms_recipient(msg, 0, &err);
+    ok(!!info, "got error %08lx\n", err);
+    if (info)
+    {
+        CMSG_KEY_TRANS_RECIPIENT_INFO *k;
+
+        ok(info->dwRecipientChoice == CMSG_KEY_TRANS_RECIPIENT, "got choice %lu\n", info->dwRecipientChoice);
+        k = info->pKeyTrans;
+        ok(k->dwVersion == 0, "got version %lu\n", k->dwVersion);
+        ok(k->RecipientId.dwIdChoice == CERT_ID_ISSUER_SERIAL_NUMBER, "got %lu\n", k->RecipientId.dwIdChoice);
+        ok(k->RecipientId.IssuerSerialNumber.SerialNumber.cbData == 1 &&
+                k->RecipientId.IssuerSerialNumber.SerialNumber.pbData[0] == 5, "wrong serial\n");
+        ok(k->RecipientId.IssuerSerialNumber.Issuer.cbData == 17, "got issuer size %lu\n",
+                k->RecipientId.IssuerSerialNumber.Issuer.cbData);
+        ok(!strcmp(k->KeyEncryptionAlgorithm.pszObjId, "1.2.840.113549.1.1.1"), "wrong algorithm\n");
+        ok(k->EncryptedKey.cbData == 3 && k->EncryptedKey.pbData[0] == 0xaa, "wrong key\n");
+        free(info);
+    }
+
+    /* key transport, subject key identifier */
+    info = get_cms_recipient(msg, 1, &err);
+    ok(!!info, "got error %08lx\n", err);
+    if (info)
+    {
+        CMSG_KEY_TRANS_RECIPIENT_INFO *k = info->pKeyTrans;
+
+        ok(info->dwRecipientChoice == CMSG_KEY_TRANS_RECIPIENT && k->dwVersion == 2, "got %lu, %lu\n",
+                info->dwRecipientChoice, k->dwVersion);
+        ok(k->RecipientId.dwIdChoice == CERT_ID_KEY_IDENTIFIER && k->RecipientId.KeyId.cbData == 3 &&
+                k->RecipientId.KeyId.pbData[2] == 3, "wrong key identifier\n");
+        ok(k->EncryptedKey.cbData == 2 && k->EncryptedKey.pbData[0] == 0xdd, "wrong key\n");
+        free(info);
+    }
+
+    /* key agreement, with the originator's public key and two encrypted keys */
+    info = get_cms_recipient(msg, 2, &err);
+    ok(!!info, "got error %08lx\n", err);
+    if (info)
+    {
+        test_key_agree_info *k = (test_key_agree_info *)info->pKeyAgree;
+
+        ok(info->dwRecipientChoice == CMSG_KEY_AGREE_RECIPIENT, "got choice %lu\n", info->dwRecipientChoice);
+        ok(k->dwVersion == 3, "got version %lu\n", k->dwVersion);
+        ok(k->dwOriginatorChoice == CMSG_KEY_AGREE_ORIGINATOR_PUBLIC_KEY, "got %lu\n", k->dwOriginatorChoice);
+        ok(!strcmp(k->u.key.Algorithm.pszObjId, "1.2.840.10045.2.1"), "wrong originator algorithm\n");
+        ok(k->u.key.PublicKey.cbData == 3 && k->u.key.PublicKey.pbData[0] == 4, "wrong originator key\n");
+        ok(k->UserKeyingMaterial.cbData == 3 && !memcmp(k->UserKeyingMaterial.pbData, "ukm", 3), "wrong ukm\n");
+        ok(!strcmp(k->KeyEncryptionAlgorithm.pszObjId, "1.3.133.16.840.63.0.2"), "wrong algorithm\n");
+        ok(k->cRecipientEncryptedKeys == 2, "got %lu keys\n", k->cRecipientEncryptedKeys);
+        if (k->cRecipientEncryptedKeys == 2)
+        {
+            test_encrypted_key *ek = k->rgpRecipientEncryptedKeys[0];
+            SYSTEMTIME st;
+
+            ok(ek->RecipientId.dwIdChoice == CERT_ID_ISSUER_SERIAL_NUMBER &&
+                    ek->RecipientId.IssuerSerialNumber.SerialNumber.pbData[0] == 7, "wrong recipient\n");
+            ok(ek->EncryptedKey.cbData == 2 && ek->EncryptedKey.pbData[1] == 2, "wrong key\n");
+            ek = k->rgpRecipientEncryptedKeys[1];
+            ok(ek->RecipientId.dwIdChoice == CERT_ID_KEY_IDENTIFIER && ek->RecipientId.KeyId.cbData == 2 &&
+                    ek->RecipientId.KeyId.pbData[0] == 9, "wrong key identifier\n");
+            ok(ek->EncryptedKey.cbData == 3 && ek->EncryptedKey.pbData[2] == 5, "wrong key\n");
+            FileTimeToSystemTime(&ek->Date, &st);
+            ok(st.wYear == 2024 && st.wMonth == 1 && st.wDay == 2 && st.wHour == 3 && st.wMinute == 4 &&
+                    st.wSecond == 5, "wrong date %04u-%02u-%02u\n", st.wYear, st.wMonth, st.wDay);
