From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] oleaut32: IRecordInfo reads and writes a record's record and array fields (9611)

GetFieldNoCopy handed a nested record back as VT_BYREF|VT_RECORD without its
IRecordInfo and an array field as the invalid VT_BYREF|VT_SAFEARRAY, and
GetField, PutField and PutFieldNoCopy failed with E_NOTIMPL for both. pywin32's
com_record (how Python scripts use COM structures) reads a nested structure
through GetFieldNoCopy and expects VT_BYREF|VT_RECORD with the field's record
info, and arrays as VT_BYREF|VT_ARRAY|<element>; it writes them with
PutField (VT_RECORD, VT_ARRAY|<element>). Now: GetFieldNoCopy points at the
field with its record info or its array; GetField copies the record
(RecordCreateCopy) or the array; PutField copies a matching record or an array
of the field's element type in (DISP_E_TYPEMISMATCH otherwise);
PutFieldNoCopy takes the array itself. The element type of an array field
comes from the type (enums are VT_I4, structures VT_RECORD), so an empty array
field still reports it.
---
--- a/dlls/oleaut32/recinfo.c
+++ b/dlls/oleaut32/recinfo.c
@@ -37,6 +37,7 @@
     BSTR name;
     ULONG size;             /* its bytes (to the next field or the record's end) */
     IRecordInfo *rec;       /* a field that is itself a record (VT_RECORD) */
+    VARTYPE elem_vt;        /* a SAFEARRAY field: its element type (wine-sg 9611) */
 } fieldstr;
 
 typedef struct {
@@ -458,6 +459,124 @@
     return S_OK;
 }
 
+/* Record and array fields in a VARIANT (Stained Glass OS, wine-sg 9611). A record field is a
+ * VT_RECORD (the record's bytes with the field's IRecordInfo), a SAFEARRAY field a
+ * VT_ARRAY | element type -- what GetField hands back, GetFieldNoCopy points at (VT_BYREF) and
+ * PutField takes, the way Windows does (pywin32's com_record reads nested structures and arrays
+ * of a record through GetFieldNoCopy and writes them through PutField). */
+static VARTYPE array_field_vt(const fieldstr *field, SAFEARRAY *psa)
+{
+    VARTYPE vt;
+
+    if (psa && SUCCEEDED(SafeArrayGetVartype(psa, &vt)))
+        return vt;
+    return field->elem_vt ? field->elem_vt : VT_VARIANT;
+}
+
+/* GetField of a record or array field: a copy */
+static HRESULT copy_aggregate_to_variant(const fieldstr *field, void *src, VARIANT *pvar)
+{
+    HRESULT hres;
+
+#ifdef SG_MUTANT_RECINFO_NO_AGGREGATE_FIELDS
+    return E_NOTIMPL;
+#endif
+    if (field->vt == VT_RECORD)
+    {
+        void *copy = NULL;
+
+        if (!field->rec)
+            return E_NOTIMPL;
+        hres = IRecordInfo_RecordCreateCopy(field->rec, src, &copy);
+        if (FAILED(hres))
+        {
+            if (copy) IRecordInfo_RecordDestroy(field->rec, copy);
+            return hres;
+        }
+        IRecordInfo_AddRef(field->rec);
+        V_VT(pvar) = VT_RECORD;
+        V_RECORD(pvar) = copy;
+        V_RECORDINFO(pvar) = field->rec;
+        return S_OK;
+    }
+    /* VT_SAFEARRAY */
+    V_ARRAY(pvar) = NULL;
+    if (*(SAFEARRAY **)src)
+    {
+        hres = SafeArrayCopy(*(SAFEARRAY **)src, &V_ARRAY(pvar));
+        if (FAILED(hres))
+            return hres;
+    }
+    V_VT(pvar) = VT_ARRAY | array_field_vt(field, *(SAFEARRAY **)src);
+    return S_OK;
+}
+
+/* PutField of a record or array field: the variant's record or array, copied, replaces the field's */
+static HRESULT copy_aggregate_from_variant(const fieldstr *field, VARIANT *src, void *dest, BOOL take)
+{
+    VARIANT *v = src;
+    HRESULT hres;
+
+#ifdef SG_MUTANT_RECINFO_NO_AGGREGATE_FIELDS
+    return E_NOTIMPL;
+#endif
+    if (V_VT(v) == (VT_BYREF | VT_VARIANT))
+        v = V_VARIANTREF(v);
+
+    if (field->vt == VT_RECORD)
+    {
+        if (!field->rec)
+            return E_NOTIMPL;
+        if ((V_VT(v) & ~VT_BYREF) != VT_RECORD || !V_RECORDINFO(v) || !V_RECORD(v))
+            return DISP_E_TYPEMISMATCH;
+        if (!IRecordInfo_IsMatchingType(field->rec, V_RECORDINFO(v)))
+            return DISP_E_TYPEMISMATCH;
+        if (V_RECORD(v) == dest)
+            return S_OK;
+        /* RecordCopy releases what the field held first */
+        return IRecordInfo_RecordCopy(field->rec, V_RECORD(v), dest);
+    }
+
+    /* VT_SAFEARRAY */
+    if (V_VT(v) == VT_NULL || V_VT(v) == VT_EMPTY)
+    {
+        SafeArrayDestroy(*(SAFEARRAY **)dest);
+        *(SAFEARRAY **)dest = NULL;
+        return S_OK;
+    }
+    if (!(V_VT(v) & VT_ARRAY))
+        return DISP_E_TYPEMISMATCH;
+    if (field->elem_vt && field->elem_vt != VT_VARIANT && (V_VT(v) & VT_TYPEMASK) != field->elem_vt)
+        return DISP_E_TYPEMISMATCH;
+    {
+        SAFEARRAY *psa = (V_VT(v) & VT_BYREF) ? *V_ARRAYREF(v) : V_ARRAY(v), *copy = NULL;
+
+        if (psa == *(SAFEARRAY **)dest)
+            return S_OK;
+        if (take && !(V_VT(v) & VT_BYREF))
+        {
+            /* PutFieldNoCopy: the field takes the array itself */
+            copy = psa;
+            V_ARRAY(v) = NULL;
+            V_VT(v) = VT_EMPTY;
+        }
+        else if (psa)
+        {
+            hres = SafeArrayCopy(psa, &copy);
+            if (FAILED(hres))
+                return hres;
+        }
+        SafeArrayDestroy(*(SAFEARRAY **)dest);
+        *(SAFEARRAY **)dest = copy;
+    }
+    return S_OK;
+}
+
+static BOOL is_aggregate_field(const fieldstr *field)
+{
+    return field->vt == VT_SAFEARRAY || (field->vt == VT_RECORD && field->rec);
+}
+
 static HRESULT WINAPI IRecordInfoImpl_GetField(IRecordInfo *iface, PVOID pvData,
                                                 LPCOLESTR szFieldName, VARIANT *pvarField)
 {
@@ -476,6 +595,8 @@
         return TYPE_E_FIELDNOTFOUND;
     
     VariantClear(pvarField);
+    if (is_aggregate_field(&This->fields[i]))
+        return copy_aggregate_to_variant(&This->fields[i], ((PBYTE)pvData)+This->fields[i].offset, pvarField);
     return copy_to_variant(((PBYTE)pvData)+This->fields[i].offset, pvarField,
             This->fields[i].vt);
 }
@@ -498,9 +619,27 @@
         return TYPE_E_FIELDNOTFOUND;
 
     VariantClear(pvarField);
+    if (ppvDataCArray) *ppvDataCArray = NULL;
+#ifndef SG_MUTANT_RECINFO_NO_AGGREGATE_FIELDS
+    if (This->fields[i].vt == VT_RECORD && This->fields[i].rec)
+    {
+        /* the record in place, with its record info (not AddRef'd: the field's own) */
+        V_VT(pvarField) = VT_BYREF|VT_RECORD;
+        V_RECORD(pvarField) = ((PBYTE)pvData)+This->fields[i].offset;
+        V_RECORDINFO(pvarField) = This->fields[i].rec;
+        return S_OK;
+    }
+    if (This->fields[i].vt == VT_SAFEARRAY)
+    {
+        SAFEARRAY **ppsa = (SAFEARRAY **)(((PBYTE)pvData)+This->fields[i].offset);
+
+        V_VT(pvarField) = VT_BYREF|VT_ARRAY|array_field_vt(&This->fields[i], *ppsa);
+        V_ARRAYREF(pvarField) = ppsa;
+        return S_OK;
+    }
+#endif
     V_VT(pvarField) = VT_BYREF|This->fields[i].vt;
     V_BYREF(pvarField) = ((PBYTE)pvData)+This->fields[i].offset;
-    *ppvDataCArray = NULL;
     return S_OK;
 }
 
@@ -525,6 +664,9 @@
     if(i == This->n_vars)
         return TYPE_E_FIELDNOTFOUND;
 
+    if (is_aggregate_field(&This->fields[i]))
+        return copy_aggregate_from_variant(&This->fields[i], pvarField,
+                ((PBYTE)pvData)+This->fields[i].offset, FALSE);
     return copy_from_variant(pvarField, ((PBYTE)pvData)+This->fields[i].offset,
             This->fields[i].vt);
 }
@@ -558,6 +700,9 @@
         return S_OK;
     }
 #endif
+    if (is_aggregate_field(&This->fields[i]))
+        return copy_aggregate_from_variant(&This->fields[i], pvarField,
+                ((PBYTE)pvData)+This->fields[i].offset, TRUE);
     return copy_from_variant(pvarField, ((PBYTE)pvData)+This->fields[i].offset, This->fields[i].vt);
 }
 
@@ -804,6 +949,41 @@
             }
         }
 #endif
+        if (vardesc->elemdescVar.tdesc.vt == VT_SAFEARRAY && vardesc->elemdescVar.tdesc.lptdesc)
+        {
+            /* the element type of a SAFEARRAY field (wine-sg 9611) */
+            const TYPEDESC *elem = vardesc->elemdescVar.tdesc.lptdesc;
+
+            ret->fields[i].elem_vt = elem->vt;
+            if (elem->vt == VT_USERDEFINED)
+            {
+                ITypeInfo *ref_info;
+                TYPEATTR *ref_attr;
+
+                ret->fields[i].elem_vt = VT_VARIANT;
+                if (SUCCEEDED(ITypeInfo_GetRefTypeInfo(pTypeInfo, elem->hreftype, &ref_info)))
+                {
+                    if (SUCCEEDED(ITypeInfo_GetTypeAttr(ref_info, &ref_attr)))
+                    {
+                        switch (ref_attr->typekind)
+                        {
+                        case TKIND_ENUM: ret->fields[i].elem_vt = VT_I4; break;
+                        case TKIND_RECORD: ret->fields[i].elem_vt = VT_RECORD; break;
+                        case TKIND_DISPATCH: ret->fields[i].elem_vt = VT_DISPATCH; break;
+                        case TKIND_INTERFACE:
+                            ret->fields[i].elem_vt = (ref_attr->wTypeFlags & TYPEFLAG_FDISPATCHABLE) ? VT_DISPATCH : VT_UNKNOWN;
+                            break;
+                        case TKIND_ALIAS:
+                            if (ref_attr->tdescAlias.vt != VT_USERDEFINED) ret->fields[i].elem_vt = ref_attr->tdescAlias.vt;
+                            break;
+                        default: break;
+                        }
+                        ITypeInfo_ReleaseTypeAttr(ref_info, ref_attr);
+                    }
+                    ITypeInfo_Release(ref_info);
+                }
+            }
+        }
         ITypeInfo_ReleaseVarDesc(pTypeInfo, vardesc);
     }
     /* each field's bytes: to the next field after it, or to the record's end */
