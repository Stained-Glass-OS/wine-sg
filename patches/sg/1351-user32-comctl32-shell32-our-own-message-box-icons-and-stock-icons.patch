From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32, comctl32, shell32: our own message box icons, and the stock icons of a message

Every message box, task dialog and program asking for the error, warning,
information or question icon got Wine's own painted artwork (IDI_ERROR,
IDI_WARNING, IDI_INFORMATION, IDI_QUESTION; comctl32's TD_ERROR_ICON,
TD_WARNING_ICON and TD_INFORMATION_ICON are the same icons), at 16, 32, 48
and 256 pixels only, so a scaled screen stretched them.

theme/icons.py (run by build.sh after the series) now draws them: flat
shapes in the Windows 10 manner -- a red disc with a white cross, an amber
triangle with a dark "!", blue discs with a white "i" and "?" -- each with a
one-pixel edge a shade darker than its fill, so it keeps its outline on a
light dialog and a dark one alike. It writes them over user32's
oic_hand.svg, oic_bang.svg, oic_note.svg and oic_ques.svg, and build.sh
renders them (theme/images.list) at 16, 20, 24, 32, 40, 48, 64, 96, 128 and
256 pixels, each drawn for its size: glyph strokes are at least two pixels
wide, so they do not thin out at 16 px. Our own drawings, none of Wine's
artwork left.

Here: shell32 carries the same four drawings (sg_error, sg_warning,
sg_info, sg_question; IDs 1350-1353), and SHGetStockIconInfo gives them for
SIID_ERROR, SIID_WARNING, SIID_INFO and SIID_HELP, at the large or small
icon size asked for. It gave the plain file icon for every stock icon (its
resource number was also passed negated to LoadIcon, so no icon was loaded
at all); every other stock icon is still the plain file.

Test: test/msgboxicons-gate.sh with test/msgboxicons-probe.c (mutants:
SG_MUTANT_MSGBOX_ICONS=1 while theme/icons.py runs swaps the error and
information colours; SG_MUTANT_STOCKICONS in dlls/shell32/iconcache.c; the
series without this patch: Wine's frames and the file icon).
---
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -1053,25 +1053,50 @@
  *  Failure: A HRESULT failure code
  *
  */
+/* Stained Glass OS: the stock icons a program shows beside a message --
+ * error, warning, information, help -- are shell32's own drawings of them
+ * (the same as user32's message box icons); every other stock icon is still
+ * the plain file. They were all the plain file. */
+static int stock_icon_resource(SHSTOCKICONID id)
+{
+#ifndef SG_MUTANT_STOCKICONS
+    switch (id)
+    {
+    case SIID_ERROR:   return IDI_SHELL_SG_ERROR;
+    case SIID_WARNING: return IDI_SHELL_SG_WARNING;
+    case SIID_INFO:    return IDI_SHELL_SG_INFO;
+    case SIID_HELP:    return IDI_SHELL_SG_QUESTION;
+    default:           break;
+    }
+#endif
+    return IDI_SHELL_FILE;
+}
+
 HRESULT WINAPI SHGetStockIconInfo(SHSTOCKICONID id, UINT flags, SHSTOCKICONINFO *sii)
 {
-    FIXME("(%d, 0x%x, %p) semi-stub\n", id, flags, sii);
+    int res;
+
+    TRACE("(%d, 0x%x, %p)\n", id, flags, sii);
     if ((id < 0) || (id >= SIID_MAX_ICONS) || !sii || (sii->cbSize != sizeof(SHSTOCKICONINFO))) {
         return E_INVALIDARG;
     }
 
     GetSystemDirectoryW(sii->szPath, MAX_PATH);
 
-    /* no icons defined: use default */
-    sii->iIcon = -IDI_SHELL_FILE;
+    res = stock_icon_resource(id);
+    sii->iIcon = -res;
     lstrcatW(sii->szPath, L"\\shell32.dll");
 
-    if (flags)
+    if (flags & ~(SHGSI_ICON | SHGSI_SMALLICON | SHGSI_LARGEICON | SHGSI_ICONLOCATION))
         FIXME("flags 0x%x not implemented\n", flags);
 
     sii->hIcon = NULL;
     if (flags & SHGSI_ICON)
-        sii->hIcon = LoadIconW(GetModuleHandleW(sii->szPath), MAKEINTRESOURCEW(sii->iIcon));
+    {
+        int cx = GetSystemMetrics((flags & SHGSI_SMALLICON) ? SM_CXSMICON : SM_CXICON);
+        int cy = GetSystemMetrics((flags & SHGSI_SMALLICON) ? SM_CYSMICON : SM_CYICON);
+        sii->hIcon = LoadImageW(shell32_hInstance, MAKEINTRESOURCEW(res), IMAGE_ICON, cx, cy, 0);
+    }
     sii->iSysImageIndex = -1;
 
     TRACE("%3d: returning %s (%d)\n", id, debugstr_w(sii->szPath), sii->iIcon);
--- a/dlls/shell32/shell32.rc
+++ b/dlls/shell32/shell32.rc
@@ -1151,6 +1151,18 @@
 /* @makedep: resources/searching.avi */
 IDR_AVI_FILEDELETE AVI resources/searching.avi
 
+/* Stained Glass OS: the stock icons of a message -- error, warning,
+ * information, question -- drawn by theme/icons.py, the same drawings as
+ * user32's message box icons */
+/* @makedep: resources/sg_error.ico */
+IDI_SHELL_SG_ERROR ICON resources/sg_error.ico
+/* @makedep: resources/sg_warning.ico */
+IDI_SHELL_SG_WARNING ICON resources/sg_warning.ico
+/* @makedep: resources/sg_info.ico */
+IDI_SHELL_SG_INFO ICON resources/sg_info.ico
+/* @makedep: resources/sg_question.ico */
+IDI_SHELL_SG_QUESTION ICON resources/sg_question.ico
+
 /* @makedep: ../../AUTHORS */
 AUTHORS RCDATA ../../AUTHORS
 
--- a/dlls/shell32/shresdef.h
+++ b/dlls/shell32/shresdef.h
@@ -378,6 +378,14 @@
 /* 339 - 511 not used on Windows */
 #define IDI_SHELL_WEB_BROWSER      512
 
+/* Stained Glass OS: the stock icons of a message (SHGetStockIconInfo's
+ * SIID_ERROR, SIID_WARNING, SIID_INFO, SIID_HELP), our own drawings, as
+ * user32's message box icons are (theme/icons.py) */
+#define IDI_SHELL_SG_ERROR         1350
+#define IDI_SHELL_SG_WARNING       1351
+#define IDI_SHELL_SG_INFO          1352
+#define IDI_SHELL_SG_QUESTION      1353
+
 /* 
 AVI resources, windows shell32 has 14 of them: 150-152 and 160-170
