+/* Stained Glass OS (wine-sg 1531): a context's properties. Windows gives a
+ * property for any GUID from ITfContext::GetProperty, made on first use and
+ * the same object after; its values are spans of the document (start, end,
+ * VARIANT) set with SetValue/SetValueStore and read with GetValue,
+ * FindRange and EnumRanges. Word asks for one as it follows its text store
+ * and went on with nothing when Wine said E_NOTIMPL. Spans keep their
+ * character positions; they do not follow later edits. */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "wine/debug.h"
+#include "wine/list.h"
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "winuser.h"
+#include "winerror.h"
+#include "objbase.h"
+#include "oleauto.h"
+
+#include "msctf.h"
+#include "msctf_internal.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msctf);
+
+struct span
+{
+    struct list entry;
+    LONG start, end;
+    VARIANT value;
+};
+
+typedef struct
+{
+    ITfProperty ITfProperty_iface;
+    LONG ref;
+    struct list entry;      /* in the context's list */
+    GUID guid;
+    ITfContext *context;    /* not held; cleared when the context goes */
+    struct list spans;      /* sorted by start, not overlapping */
+} Property;
+
+static inline Property *impl_from_ITfProperty(ITfProperty *iface)
+{
+    return CONTAINING_RECORD(iface, Property, ITfProperty_iface);
+}
+
+static void free_span(struct span *s)
+{
+    list_remove(&s->entry);
+    VariantClear(&s->value);
+    free(s);
+}
+
+/* take [start, end) out of every span, splitting one that covers both ends */
+static HRESULT cut_spans(Property *This, LONG start, LONG end)
+{
+    struct span *s, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(s, next, &This->spans, struct span, entry)
+    {
+        if (s->end <= start || s->start >= end) continue;
+        if (s->start < start && s->end > end)
+        {
+            struct span *tail = calloc(1, sizeof(*tail));
+            if (!tail) return E_OUTOFMEMORY;
+            tail->start = end;
+            tail->end = s->end;
+            VariantInit(&tail->value);
+            VariantCopy(&tail->value, &s->value);
+            list_add_after(&s->entry, &tail->entry);
+            s->end = start;
+            break;
+        }
+        if (s->start >= start && s->end <= end) free_span(s);
+        else if (s->start < start) s->end = start;
+        else s->start = end;
+    }
+    return S_OK;
+}
+
+static HRESULT add_span(Property *This, LONG start, LONG end, const VARIANT *value)
+{
+    struct span *s, *n;
+    HRESULT hr;
+
+    if (FAILED(hr = cut_spans(This, start, end))) return hr;
+    if (!(n = calloc(1, sizeof(*n)))) return E_OUTOFMEMORY;
+    n->start = start;
+    n->end = end;
+    VariantInit(&n->value);
+    if (FAILED(hr = VariantCopy(&n->value, (VARIANT *)value)))
+    {
+        free(n);
+        return hr;
+    }
+    LIST_FOR_EACH_ENTRY(s, &This->spans, struct span, entry)
+    {
+        if (s->start >= end)
+        {
+            list_add_before(&s->entry, &n->entry);
+            return S_OK;
+        }
+    }
+    list_add_tail(&This->spans, &n->entry);
+    return S_OK;
+}
+
+static HRESULT range_extent(ITfRange *range, LONG *start, LONG *end)
+{
+    if (!range) return E_INVALIDARG;
+    Range_GetAnchors(range, start, end);
+    if (*start > *end) { LONG t = *start; *start = *end; *end = t; }
+    return S_OK;
+}
+
+/* an enumeration of ranges made up front */
+typedef struct
+{
+    IEnumTfRanges IEnumTfRanges_iface;
+    LONG ref;
+    ITfRange **ranges;
+    ULONG count, pos;
+} PropEnum;
+
+static inline PropEnum *impl_from_IEnumTfRanges(IEnumTfRanges *iface)
+{
+    return CONTAINING_RECORD(iface, PropEnum, IEnumTfRanges_iface);
+}
+
+static HRESULT PropEnum_Create(ITfRange **ranges, ULONG count, ULONG pos, IEnumTfRanges **ret);
+
+static HRESULT WINAPI PropEnum_QueryInterface(IEnumTfRanges *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumTfRanges))
+    {
+        *ppv = iface;
+        IEnumTfRanges_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI PropEnum_AddRef(IEnumTfRanges *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumTfRanges(iface)->ref);
+}
+
+static ULONG WINAPI PropEnum_Release(IEnumTfRanges *iface)
+{
+    PropEnum *This = impl_from_IEnumTfRanges(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    ULONG i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) ITfRange_Release(This->ranges[i]);
+        free(This->ranges);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI PropEnum_Clone(IEnumTfRanges *iface, IEnumTfRanges **ret)
+{
+    PropEnum *This = impl_from_IEnumTfRanges(iface);
+    if (!ret) return E_INVALIDARG;
+    return PropEnum_Create(This->ranges, This->count, This->pos, ret);
+}
+
+static HRESULT WINAPI PropEnum_Next(IEnumTfRanges *iface, ULONG count, ITfRange **ranges, ULONG *fetched)
+{
+    PropEnum *This = impl_from_IEnumTfRanges(iface);
+    ULONG n = 0;
+
+    if (!ranges) return E_INVALIDARG;
+    while (n < count && This->pos < This->count)
+    {
+        ranges[n] = This->ranges[This->pos++];
+        ITfRange_AddRef(ranges[n]);
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI PropEnum_Reset(IEnumTfRanges *iface)
+{
+    impl_from_IEnumTfRanges(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI PropEnum_Skip(IEnumTfRanges *iface, ULONG count)
+{
+    PropEnum *This = impl_from_IEnumTfRanges(iface);
+    ULONG left = This->count - This->pos;
+
+    if (count > left)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static const IEnumTfRangesVtbl PropEnumVtbl =
+{
+    PropEnum_QueryInterface,
+    PropEnum_AddRef,
+    PropEnum_Release,
+    PropEnum_Clone,
+    PropEnum_Next,
+    PropEnum_Reset,
+    PropEnum_Skip
+};
+
+static HRESULT PropEnum_Create(ITfRange **ranges, ULONG count, ULONG pos, IEnumTfRanges **ret)
+{
+    PropEnum *e = calloc(1, sizeof(*e));
+    ULONG i;
+
+    if (!e) return E_OUTOFMEMORY;
+    if (count && !(e->ranges = calloc(count, sizeof(*e->ranges))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    e->IEnumTfRanges_iface.lpVtbl = &PropEnumVtbl;
+    e->ref = 1;
+    e->count = count;
+    e->pos = pos;
+    for (i = 0; i < count; i++)
+    {
+        e->ranges[i] = ranges[i];
+        ITfRange_AddRef(ranges[i]);
+    }
+    *ret = &e->IEnumTfRanges_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI Property_QueryInterface(ITfProperty *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_ITfReadOnlyProperty) ||
+        IsEqualIID(riid, &IID_ITfProperty))
+    {
+        *ppv = iface;
+        ITfProperty_AddRef(iface);
+        return S_OK;
+    }
+    WARN("unsupported interface %s\n", debugstr_guid(riid));
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI Property_AddRef(ITfProperty *iface)
+{
+    return InterlockedIncrement(&impl_from_ITfProperty(iface)->ref);
+}
+
+static ULONG WINAPI Property_Release(ITfProperty *iface)
+{
+    Property *This = impl_from_ITfProperty(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    struct span *s, *next;
+
+    if (!ref)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE(s, next, &This->spans, struct span, entry) free_span(s);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI Property_GetType(ITfProperty *iface, GUID *guid)
+{
+    Property *This = impl_from_ITfProperty(iface);
+    if (!guid) return E_INVALIDARG;
+    *guid = This->guid;
+    return S_OK;
+}
+
+static HRESULT WINAPI Property_EnumRanges(ITfProperty *iface, TfEditCookie ec, IEnumTfRanges **ret, ITfRange *target)
+{
+    Property *This = impl_from_ITfProperty(iface);
+    LONG start = LONG_MIN, end = LONG_MAX;
+    ITfRange **ranges = NULL;
+    ULONG count = 0, i;
+    struct span *s;
+    HRESULT hr = S_OK;
+
+    TRACE("(%p) %lx %p %p\n", This, ec, ret, target);
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    if (!This->context) return E_FAIL;
+    if (target) range_extent(target, &start, &end);
+
+    LIST_FOR_EACH_ENTRY(s, &This->spans, struct span, entry) count++;
+    if (count && !(ranges = calloc(count, sizeof(*ranges)))) return E_OUTOFMEMORY;
+    count = 0;
+    LIST_FOR_EACH_ENTRY(s, &This->spans, struct span, entry)
+    {
+        LONG a = max(s->start, start), b = min(s->end, end);
+        if (target && (a > b || (a == b && s->start != s->end))) continue;
+        if (FAILED(hr = Range_Constructor(This->context, a, b, &ranges[count]))) break;
+        count++;
+    }
+    if (SUCCEEDED(hr)) hr = PropEnum_Create(ranges, count, 0, ret);
+    for (i = 0; i < count; i++) ITfRange_Release(ranges[i]);
+    free(ranges);
+    return hr;
+}
+
+static HRESULT WINAPI Property_GetValue(ITfProperty *iface, TfEditCookie ec, ITfRange *range, VARIANT *value)
+{
+    Property *This = impl_from_ITfProperty(iface);
+    LONG start, end;
+    struct span *s;
+
+    TRACE("(%p) %lx %p %p\n", This, ec, range, value);
+
+    if (!value) return E_INVALIDARG;
+    VariantInit(value);
+    if (FAILED(range_extent(range, &start, &end))) return E_INVALIDARG;
+    /* the value of the span that holds the whole range; none: VT_EMPTY */
+    LIST_FOR_EACH_ENTRY(s, &This->spans, struct span, entry)
+    {
+        if (s->start <= start && s->end >= end && (s->start < s->end || start == end))
+            return VariantCopy(value, &s->value);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI Property_GetContext(ITfProperty *iface, ITfContext **context)
+{
+    Property *This = impl_from_ITfProperty(iface);
+    if (!context) return E_INVALIDARG;
+    *context = This->context;
+    if (!This->context) return E_FAIL;
+    ITfContext_AddRef(*context);
+    return S_OK;
+}
+
+static HRESULT WINAPI Property_FindRange(ITfProperty *iface, TfEditCookie ec, ITfRange *range,
+        ITfRange **ret, TfAnchor anchor)
+{
+    Property *This = impl_from_ITfProperty(iface);
+    LONG start, end, at;
+    struct span *s;
+
+    TRACE("(%p) %lx %p %p %d\n", This, ec, range, ret, anchor);
+
+    if (ret) *ret = NULL;
+    if (FAILED(range_extent(range, &start, &end))) return E_INVALIDARG;
+    if (!This->context) return E_FAIL;
+    at = anchor == TF_ANCHOR_END ? end : start;
+    LIST_FOR_EACH_ENTRY(s, &This->spans, struct span, entry)
+    {
+        BOOL in = anchor == TF_ANCHOR_END ? (at > s->start && at <= s->end) : (at >= s->start && at < s->end);
+        if (!in) continue;
+        if (!ret) return S_OK;
+        return Range_Constructor(This->context, s->start, s->end, ret);
+    }
+    return S_FALSE;
+}
+
+static HRESULT WINAPI Property_SetValueStore(ITfProperty *iface, TfEditCookie ec, ITfRange *range,
+        ITfPropertyStore *store)
+{
+    Property *This = impl_from_ITfProperty(iface);
+    LONG start, end;
+    VARIANT value;
+    HRESULT hr;
+
+    TRACE("(%p) %lx %p %p\n", This, ec, range, store);
+
+    if (!store || FAILED(range_extent(range, &start, &end))) return E_INVALIDARG;
+    VariantInit(&value);
+    if (FAILED(hr = ITfPropertyStore_GetData(store, &value))) return hr;
+    hr = add_span(This, start, end, &value);
+    VariantClear(&value);
+    return hr;
+}
+
+static HRESULT WINAPI Property_SetValue(ITfProperty *iface, TfEditCookie ec, ITfRange *range, const VARIANT *value)
+{
+    Property *This = impl_from_ITfProperty(iface);
+    LONG start, end;
+
+    TRACE("(%p) %lx %p %p\n", This, ec, range, value);
+
+    if (!value || FAILED(range_extent(range, &start, &end))) return E_INVALIDARG;
+    if (V_VT(value) == VT_EMPTY) return cut_spans(This, start, end);
+    return add_span(This, start, end, value);
+}
+
+static HRESULT WINAPI Property_Clear(ITfProperty *iface, TfEditCookie ec, ITfRange *range)
+{
+    Property *This = impl_from_ITfProperty(iface);
+    LONG start, end;
+    struct span *s, *next;
+
+    TRACE("(%p) %lx %p\n", This, ec, range);
+
+    if (!range)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE(s, next, &This->spans, struct span, entry) free_span(s);
+        return S_OK;
+    }
+    range_extent(range, &start, &end);
+    return cut_spans(This, start, end);
+}
+
+static const ITfPropertyVtbl PropertyVtbl =
+{
+    Property_QueryInterface,
+    Property_AddRef,
+    Property_Release,
+    Property_GetType,
+    Property_EnumRanges,
+    Property_GetValue,
+    Property_GetContext,
+    Property_FindRange,
+    Property_SetValueStore,
+    Property_SetValue,
+    Property_Clear
+};
+
+/* the context's property for guid, made on first use; *ret holds a ref */
+HRESULT Property_Get(ITfContext *context, struct list *properties, REFGUID guid, ITfProperty **ret)
+{
+    Property *p;
+
+    LIST_FOR_EACH_ENTRY(p, properties, Property, entry)
+    {
+        if (IsEqualGUID(&p->guid, guid))
+        {
+            *ret = &p->ITfProperty_iface;
+            ITfProperty_AddRef(*ret);
+            return S_OK;
+        }
+    }
+    if (!(p = calloc(1, sizeof(*p)))) return E_OUTOFMEMORY;
+    p->ITfProperty_iface.lpVtbl = &PropertyVtbl;
+    p->ref = 2; /* the context's and the caller's */
+    p->guid = *guid;
+    p->context = context;
+    list_init(&p->spans);
+    list_add_tail(properties, &p->entry);
+    *ret = &p->ITfProperty_iface;
+    return S_OK;
+}
+
+void Property_FreeAll(struct list *properties)
+{
+    Property *p, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(p, next, properties, Property, entry)
+    {
+        list_remove(&p->entry);
+        p->context = NULL;
+        ITfProperty_Release(&p->ITfProperty_iface);
+    }
+}
