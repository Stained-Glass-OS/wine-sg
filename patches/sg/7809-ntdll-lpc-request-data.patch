+/* Stained Glass OS (wine-sg 7809): a request's data information. The sender describes buffers of its own,
+ * after its message header (64-bit layout, as for 32-bit callers too):
+ *   ULONG count; (padding to 8)  then count entries of { ULONG64 base; ULONG size; (padding) }
+ * at VirtualRangesOffset, inside the message data. While the sender waits for the reply, the process that
+ * received the request may read or write those buffers (NtReadRequestData, NtWriteRequestData), at most
+ * an entry's size, and nothing else of the sender's memory. The server reads the entries from its own copy
+ * of the message, not from the receiver's. */
+#define PORT_MSG_HEADER  40   /* LPC_MESSAGE's header, 64-bit layout */
+#define PORT_DATA_ENTRY  16
+
+static int get_request_data_entry( const struct port_msg *msg, unsigned int index, client_ptr_t *base,
+                                   data_size_t *size )
+{
+    unsigned int count, offset, size32;
+    UINT64 base64;
+
+    if (msg->info_offset < PORT_MSG_HEADER) return 0;
+    offset = msg->info_offset - PORT_MSG_HEADER;
+    if (offset > msg->size || msg->size - offset < 8) return 0;
+    memcpy( &count, msg->data + offset, sizeof(count) );
+    if (index >= count) return 0;
+    if ((msg->size - offset - 8) / PORT_DATA_ENTRY <= index) return 0;
+    offset += 8 + index * PORT_DATA_ENTRY;
+    memcpy( &base64, msg->data + offset, sizeof(base64) );
+    memcpy( &size32, msg->data + offset + 8, sizeof(size32) );
+    *base = base64;
+    *size = size32;
+    return 1;
+}
+
+DECL_HANDLER(port_request_data)
+{
+    struct port *port, *queue;
+    struct port_msg *msg, *request = NULL;
+    client_ptr_t base;
+    data_size_t entry_size, len;
+
+    if (!(port = get_port_obj( current->process, req->handle, 0 ))) return;
+
+    queue = receive_port( port );
+    LIST_FOR_EACH_ENTRY( msg, &awaiting, struct port_msg, entry )
+    {
+        if (msg->type == LPC_REQUEST && msg->id == req->msg_id && msg->owner == queue &&
+            msg->receiver == current->process && (!req->client_tid || msg->tid == req->client_tid))
+        {
+            request = msg;
+            break;
+        }
+    }
+    if (!request)
+    {
+        set_error( STATUS_REPLY_MESSAGE_MISMATCH );
+        goto done;
+    }
+    if (!request->thread || request->thread->state == TERMINATED)
+    {
+        set_error( STATUS_PORT_DISCONNECTED );
+        goto done;
+    }
+    len = req->write ? get_req_data_size() : get_reply_max_size();
+#ifndef SG_MUTANT_LPC_DATA_UNBOUNDED
+    if (!get_request_data_entry( request, req->index, &base, &entry_size ) || len > entry_size)
+#else
+    if (!get_request_data_entry( request, req->index, &base, &entry_size ))
+#endif
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        goto done;
+    }
+    if (req->write)
+    {
+        if (!len || write_process_memory( request->thread->process, base, len, get_req_data() ))
+            reply->size = len;
+    }
+    else if (len)
+    {
+        char *buffer = set_reply_data_size( len );
+        if (buffer && read_process_memory( request->thread->process, base, len, buffer )) reply->size = len;
+    }
+
+done:
+    release_object( port );
+}
+
 /* LPC_CLIENT_DIED through this port when the calling thread ends */
 DECL_HANDLER(register_terminate_port)
 {
