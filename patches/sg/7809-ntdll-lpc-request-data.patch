+/* a buffer the sender of a request described, read or written while it waits (wine-sg 7809) */
+static NTSTATUS port_request_data( HANDLE handle, LPC_MESSAGE *msg, ULONG index, void *buffer, ULONG len,
+                                   ULONG *ret_len, BOOL write )
+{
+    NTSTATUS status;
+
+    if (ret_len) *ret_len = 0;
+    if (!msg) return STATUS_INVALID_PARAMETER;
+    SERVER_START_REQ( port_request_data )
+    {
+        req->handle     = wine_server_obj_handle( handle );
+        req->msg_id     = msg->MessageId;
+        req->client_tid = HandleToULong( msg->ClientId.UniqueThread );
+        req->index      = index;
+        req->write      = write;
+        if (write) wine_server_add_data( req, buffer, len );
+        else wine_server_set_reply( req, buffer, len );
+        status = wine_server_call( req );
+        if (!status && ret_len) *ret_len = reply->size;
+    }
+    SERVER_END_REQ;
+    return status;
+}
+
+
+/***********************************************************************
+ *             NtReadRequestData (NTDLL.@)
+ */
+NTSTATUS WINAPI NtReadRequestData( HANDLE handle, LPC_MESSAGE *msg, ULONG index, void *buffer, ULONG len,
+                                   ULONG *ret_len )
+{
+    TRACE( "(%p,%p,%u,%p,%u,%p)\n", handle, msg, (int)index, buffer, (int)len, ret_len );
+    return port_request_data( handle, msg, index, buffer, len, ret_len, FALSE );
+}
+
+
+/***********************************************************************
+ *             NtWriteRequestData (NTDLL.@)
+ */
+NTSTATUS WINAPI NtWriteRequestData( HANDLE handle, LPC_MESSAGE *msg, ULONG index, void *buffer, ULONG len,
+                                    ULONG *ret_len )
+{
+    TRACE( "(%p,%p,%u,%p,%u,%p)\n", handle, msg, (int)index, buffer, (int)len, ret_len );
+    return port_request_data( handle, msg, index, buffer, len, ret_len, TRUE );
+}
+
+
 /***********************************************************************
  *             NtReplyPort (NTDLL.@)
  */
