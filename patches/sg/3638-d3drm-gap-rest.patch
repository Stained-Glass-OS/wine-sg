+static HRESULT WINAPI d3drm_pmesh_SetVertexDetail(IDirect3DRMProgressiveMesh *iface, DWORD count)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, count %lu.\n", iface, count);
+
+    return pmesh_set_count(pmesh, count, pmesh_vertex_count(pmesh));
