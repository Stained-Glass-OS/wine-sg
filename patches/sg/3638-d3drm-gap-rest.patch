+static void d3drm_animation_set_destroy(struct d3drm_animation_set *set)
+{
+    SIZE_T i;
+
+    d3drm_object_cleanup((IDirect3DRMObject *)&set->IDirect3DRMAnimationSet_iface, &set->obj);
+    for (i = 0; i < set->nb_animations; ++i)
+        IDirect3DRMAnimation2_Release(set->animations[i]);
+    free(set->animations);
+    IDirect3DRM_Release(set->d3drm);
+    free(set);
+}
