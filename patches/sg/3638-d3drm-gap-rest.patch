+/* ----- progressive meshes ----- */
+
+static void d3drm_progressive_mesh_destroy(struct d3drm_progressive_mesh *pmesh)
+{
+    d3drm_object_cleanup((IDirect3DRMObject *)&pmesh->IDirect3DRMProgressiveMesh_iface, &pmesh->obj);
+    if (pmesh->builder)
+        IDirect3DRMMeshBuilder3_Release(pmesh->builder);
+    IDirect3DRM_Release(pmesh->d3drm);
+    free(pmesh);
+}
+
+static struct d3drm_progressive_mesh *impl_from_IDirect3DRMProgressiveMesh(IDirect3DRMProgressiveMesh *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3drm_progressive_mesh, IDirect3DRMProgressiveMesh_iface);
+}
+
+static HRESULT WINAPI d3drm_pmesh_QueryInterface(IDirect3DRMProgressiveMesh *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IDirect3DRMProgressiveMesh) || IsEqualGUID(riid, &IID_IDirect3DRMVisual)
+            || IsEqualGUID(riid, &IID_IDirect3DRMObject) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        IDirect3DRMProgressiveMesh_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    WARN("%s not implemented, returning CLASS_E_CLASSNOTAVAILABLE.\n", debugstr_guid(riid));
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
+
+#define d3drm_pmesh_destroy d3drm_progressive_mesh_destroy
+REFCOUNT_METHODS(d3drm_pmesh, struct d3drm_progressive_mesh, IDirect3DRMProgressiveMesh,
+        IDirect3DRMProgressiveMesh_iface)
+OBJECT_METHODS(d3drm_pmesh, struct d3drm_progressive_mesh, IDirect3DRMProgressiveMesh,
+        IDirect3DRMProgressiveMesh_iface)
+
+static void pmesh_signal(struct d3drm_progressive_mesh *pmesh)
+{
+    if (pmesh->event && (pmesh->event_flags & (D3DRMPMESHEVENT_BASEMESH | D3DRMPMESHEVENT_COMPLETE))
+            && (pmesh->flags & D3DRMPMESHSTATUS_COMPLETE))
+        SetEvent(pmesh->event);
+}
+
+static DWORD pmesh_face_count(struct d3drm_progressive_mesh *pmesh)
+{
+    return pmesh->builder ? IDirect3DRMMeshBuilder3_GetFaceCount(pmesh->builder) : 0;
+}
+
+static DWORD pmesh_vertex_count(struct d3drm_progressive_mesh *pmesh)
+{
+    return pmesh->builder ? IDirect3DRMMeshBuilder3_GetVertexCount(pmesh->builder) : 0;
+}
+
+static HRESULT WINAPI d3drm_pmesh_Clone(IDirect3DRMProgressiveMesh *iface, IUnknown *outer, REFIID iid, void **out)
+{
+    IDirect3DRMProgressiveMesh *clone;
+    HRESULT hr;
+
+    TRACE("iface %p, outer %p, iid %s, out %p.\n", iface, outer, debugstr_guid(iid), out);
+
+    if (out)
+        *out = NULL;
+    if (outer)
+        return CLASS_E_NOAGGREGATION;
+    if (FAILED(hr = IDirect3DRMProgressiveMesh_Duplicate(iface, &clone)))
+        return hr;
+    return object_clone_result((IUnknown *)clone, outer, iid, out);
+}
+
+static HRESULT WINAPI d3drm_pmesh_Load(IDirect3DRMProgressiveMesh *iface, void *filename, void *name,
+        D3DRMLOADOPTIONS flags, D3DRMLOADTEXTURECALLBACK cb, void *ctx)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+    IDirect3DRMMeshBuilder3 *builder;
+    IDirect3DRM3 *d3drm3;
+    HRESULT hr;
+
+    TRACE("iface %p, filename %p, name %p, flags %#lx, cb %p, ctx %p.\n", iface, filename, name, flags, cb, ctx);
+
+    if (FAILED(hr = IDirect3DRM_QueryInterface(pmesh->d3drm, &IID_IDirect3DRM3, (void **)&d3drm3)))
+        return hr;
+    hr = IDirect3DRM3_CreateMeshBuilder(d3drm3, &builder);
+    IDirect3DRM3_Release(d3drm3);
+    if (FAILED(hr))
+        return hr;
+    /* the load is always completed before this returns, so ASYNCHRONOUS is satisfied trivially */
+    hr = IDirect3DRMMeshBuilder3_Load(builder, filename, name, flags & ~D3DRMLOAD_ASYNCHRONOUS,
+            (D3DRMLOADTEXTURE3CALLBACK)cb, ctx);
+    pmesh->load_result = hr;
+    if (FAILED(hr))
+    {
+        IDirect3DRMMeshBuilder3_Release(builder);
+        pmesh->flags = 0;
+        return hr;
+    }
+    if (pmesh->builder)
+        IDirect3DRMMeshBuilder3_Release(pmesh->builder);
+    pmesh->builder = builder;
+    pmesh->flags = D3DRMPMESHSTATUS_VALID | D3DRMPMESHSTATUS_BASEMESHCOMPLETE | D3DRMPMESHSTATUS_COMPLETE
+            | D3DRMPMESHSTATUS_RENDERABLE;
+    pmesh_signal(pmesh);
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_pmesh_GetLoadStatus(IDirect3DRMProgressiveMesh *iface, D3DRMPMESHLOADSTATUS *status)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, status %p.\n", iface, status);
+
+    if (!status)
+        return D3DRMERR_BADVALUE;
+    memset(status, 0, sizeof(*status));
+    status->dwSize = sizeof(*status);
+    status->dwFacesLoaded = pmesh_face_count(pmesh);
+    status->dwVerticesLoaded = pmesh_vertex_count(pmesh);
+    status->dwLoadResult = pmesh->load_result;
+    status->dwFlags = pmesh->flags;
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_pmesh_SetMinRenderDetail(IDirect3DRMProgressiveMesh *iface, D3DVALUE detail)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, detail %.8e.\n", iface, detail);
+
+    if (detail < 0.0f || detail > 1.0f)
+        return D3DRMERR_BADVALUE;
+    pmesh->min_render_detail = detail;
+    if (pmesh->detail < detail)
+        pmesh->detail = detail;
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_pmesh_Abort(IDirect3DRMProgressiveMesh *iface, DWORD flags)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, flags %#lx.\n", iface, flags);
+
+    /* the load already finished, so there is nothing to interrupt */
+    if (!(pmesh->flags & D3DRMPMESHSTATUS_COMPLETE))
+        pmesh->flags |= D3DRMPMESHSTATUS_INTERRUPTED;
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_pmesh_GetFaceDetail(IDirect3DRMProgressiveMesh *iface, DWORD *count)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count)
+        return D3DRMERR_BADVALUE;
+    *count = ceilf(pmesh_face_count(pmesh) * pmesh->detail);
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_pmesh_GetVertexDetail(IDirect3DRMProgressiveMesh *iface, DWORD *count)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count)
+        return D3DRMERR_BADVALUE;
+    *count = ceilf(pmesh_vertex_count(pmesh) * pmesh->detail);
+    return D3DRM_OK;
+}
+
+static HRESULT pmesh_set_count(struct d3drm_progressive_mesh *pmesh, DWORD count, DWORD total)
+{
+    if (!total)
+        return D3DRMERR_BADVALUE;
+    if (count > total)
+        count = total;
+    pmesh->detail = (float)count / total;
+    if (pmesh->detail < pmesh->min_render_detail)
+        pmesh->detail = pmesh->min_render_detail;
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_pmesh_SetFaceDetail(IDirect3DRMProgressiveMesh *iface, DWORD count)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, count %lu.\n", iface, count);
+
+    return pmesh_set_count(pmesh, count, pmesh_face_count(pmesh));
+}
