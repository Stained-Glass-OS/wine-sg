+static HRESULT d3drm_shadow_set_light(struct d3drm_shadow *shadow, IDirect3DRMLight *light)
+{
+    if (!light)
+        return D3DRMERR_BADOBJECT;
+    IDirect3DRMLight_AddRef(light);
+    if (shadow->light)
+        IDirect3DRMLight_Release(shadow->light);
+    shadow->light = light;
+    return D3DRM_OK;
+}
