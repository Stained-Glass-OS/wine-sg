+static HRESULT WINAPI d3drm_animation_set1_Load(IDirect3DRMAnimationSet *iface, void *filename, void *name,
+        D3DRMLOADOPTIONS flags, D3DRMLOADTEXTURECALLBACK cb, void *ctx, IDirect3DRMFrame *parent)
+{
+    IDirect3DRMFrame3 *parent3 = NULL;
+    HRESULT hr;
+
+    TRACE("iface %p, filename %p, name %p, flags %#lx, cb %p, ctx %p, parent %p.\n",
