+/* ----- loading the Animation objects of an AnimationSet data object ----- */
+
+static BOOL frame_find_by_name(IDirect3DRMFrame3 *frame, const char *name, IDirect3DRMFrame3 **found)
+{
+    IDirect3DRMFrameArray *children;
+    char buffer[256];
+    DWORD size = sizeof(buffer), i;
+    BOOL ret = FALSE;
+
+    if (SUCCEEDED(IDirect3DRMFrame3_GetName(frame, &size, buffer)) && !strcmp(buffer, name))
+    {
+        IDirect3DRMFrame3_AddRef(frame);
+        *found = frame;
+        return TRUE;
+    }
+    if (FAILED(IDirect3DRMFrame3_GetChildren(frame, &children)))
+        return FALSE;
+    for (i = 0; !ret && i < IDirect3DRMFrameArray_GetSize(children); ++i)
+    {
+        IDirect3DRMFrame *child1;
+        IDirect3DRMFrame3 *child;
+
+        if (FAILED(IDirect3DRMFrameArray_GetElement(children, i, &child1)))
+            continue;
+        if (SUCCEEDED(IDirect3DRMFrame_QueryInterface(child1, &IID_IDirect3DRMFrame3, (void **)&child)))
+        {
+            ret = frame_find_by_name(child, name, found);
+            IDirect3DRMFrame3_Release(child);
+        }
+        IDirect3DRMFrame_Release(child1);
+    }
+    IDirect3DRMFrameArray_Release(children);
+    return ret;
+}
+
+/* Quaternion of the rotation part of a (scale-free) matrix, D3DRM layout: s first. */
+static D3DRMQUATERNION quaternion_from_matrix(const float m[4][4])
+{
+    D3DRMQUATERNION q;
+    float trace = m[0][0] + m[1][1] + m[2][2], s;
+
+    if (trace > 0.0f)
+    {
+        s = sqrtf(trace + 1.0f) * 2.0f;
+        q.s = 0.25f * s;
+        q.v.x = (m[1][2] - m[2][1]) / s;
+        q.v.y = (m[2][0] - m[0][2]) / s;
+        q.v.z = (m[0][1] - m[1][0]) / s;
+    }
+    else if (m[0][0] > m[1][1] && m[0][0] > m[2][2])
+    {
+        s = sqrtf(1.0f + m[0][0] - m[1][1] - m[2][2]) * 2.0f;
+        q.s = (m[1][2] - m[2][1]) / s;
+        q.v.x = 0.25f * s;
+        q.v.y = (m[1][0] + m[0][1]) / s;
+        q.v.z = (m[2][0] + m[0][2]) / s;
+    }
+    else if (m[1][1] > m[2][2])
+    {
+        s = sqrtf(1.0f + m[1][1] - m[0][0] - m[2][2]) * 2.0f;
+        q.s = (m[2][0] - m[0][2]) / s;
+        q.v.x = (m[1][0] + m[0][1]) / s;
+        q.v.y = 0.25f * s;
+        q.v.z = (m[2][1] + m[1][2]) / s;
+    }
+    else
+    {
+        s = sqrtf(1.0f + m[2][2] - m[0][0] - m[1][1]) * 2.0f;
+        q.s = (m[0][1] - m[1][0]) / s;
+        q.v.x = (m[2][0] + m[0][2]) / s;
+        q.v.y = (m[2][1] + m[1][2]) / s;
+        q.v.z = 0.25f * s;
+    }
+    return q;
+}
+
+static void animation_add_file_keys(IDirect3DRMAnimation2 *animation, const DWORD *data, DWORD size)
+{
+    DWORD type, count, i, k;
+
+    if (size < 8)
+        return;
+    type = data[0];
+    count = data[1];
+    data += 2;
+    size = size / 4 - 2;
+    for (i = 0; i < count; ++i)
+    {
+        DWORD time, values;
+        const float *f;
+
+        if (size < 2)
+            return;
+        time = data[0];
+        values = data[1];
+        data += 2;
+        size -= 2;
+        if (size < values)
+            return;
+        f = (const float *)data;
+        data += values;
+        size -= values;
+
+        switch (type)
+        {
+            case 0:
+                if (values == 4)
+                {
+                    D3DRMQUATERNION q;
+
+                    q.s = f[0]; q.v.x = f[1]; q.v.y = f[2]; q.v.z = f[3];
+                    IDirect3DRMAnimation2_AddRotateKey(animation, time, &q);
+                }
+                break;
+            case 1:
+                if (values == 3)
+                    IDirect3DRMAnimation2_AddScaleKey(animation, time, f[0], f[1], f[2]);
+                break;
+            case 2:
+                if (values == 3)
+                    IDirect3DRMAnimation2_AddPositionKey(animation, time, f[0], f[1], f[2]);
+                break;
+            case 3:
+            case 4:
+                if (values == 16)
+                {
+                    float m[4][4], sx, sy, sz;
+                    D3DRMQUATERNION q;
+
+                    for (k = 0; k < 16; ++k)
+                        m[k / 4][k % 4] = f[k];
+                    sx = sqrtf(m[0][0] * m[0][0] + m[0][1] * m[0][1] + m[0][2] * m[0][2]);
+                    sy = sqrtf(m[1][0] * m[1][0] + m[1][1] * m[1][1] + m[1][2] * m[1][2]);
+                    sz = sqrtf(m[2][0] * m[2][0] + m[2][1] * m[2][1] + m[2][2] * m[2][2]);
+                    IDirect3DRMAnimation2_AddPositionKey(animation, time, m[3][0], m[3][1], m[3][2]);
+                    IDirect3DRMAnimation2_AddScaleKey(animation, time, sx, sy, sz);
+                    for (k = 0; k < 3; ++k)
+                    {
+                        if (sx > 0.0f) m[0][k] /= sx;
+                        if (sy > 0.0f) m[1][k] /= sy;
+                        if (sz > 0.0f) m[2][k] /= sz;
+                    }
+                    q = quaternion_from_matrix(m);
+                    IDirect3DRMAnimation2_AddRotateKey(animation, time, &q);
+                }
+                break;
+        }
+    }
+}
+
+static HRESULT animation_load_data(struct d3drm_animation_set *set, IDirectXFileData *data,
+        IDirect3DRMFrame3 *parent_frame)
+{
+    IDirectXFileObject *child;
+    struct d3drm_animation *animation;
+    HRESULT hr;
+
+    if (FAILED(hr = d3drm_animation_create(&animation, set->d3drm)))
+        return hr;
+    {
+        char name[256];
+        DWORD size = sizeof(name);
+
+        if (SUCCEEDED(IDirectXFileData_GetName(data, name, &size)) && size)
+            d3drm_object_set_name(&animation->obj, name);
+    }
+
+    while (SUCCEEDED(hr = IDirectXFileData_GetNextObject(data, &child)))
+    {
+        IDirectXFileData *cdata = NULL;
+        IDirectXFileDataReference *reference;
+        const GUID *type;
+
+        if (SUCCEEDED(IDirectXFileObject_QueryInterface(child, &IID_IDirectXFileDataReference,
+                (void **)&reference)))
+        {
+            hr = IDirectXFileDataReference_Resolve(reference, &cdata);
+            IDirectXFileDataReference_Release(reference);
+            if (FAILED(hr))
+                cdata = NULL;
+        }
+        else if (FAILED(IDirectXFileObject_QueryInterface(child, &IID_IDirectXFileData, (void **)&cdata)))
+            cdata = NULL;
+
+        if (cdata && SUCCEEDED(IDirectXFileData_GetType(cdata, &type)))
+        {
+            if (IsEqualGUID(type, &TID_D3DRMFrame))
+            {
+                char name[256];
+                DWORD size = sizeof(name);
+                IDirect3DRMFrame3 *frame;
+
+                if (parent_frame && SUCCEEDED(IDirectXFileData_GetName(cdata, name, &size)) && size
+                        && frame_find_by_name(parent_frame, name, &frame))
+                {
+                    animation->frame = frame;
+                    IDirect3DRMFrame3_Release(frame);
+                }
+                else
+                    WARN("Frame %s of the animation not found.\n", debugstr_a(size ? name : ""));
+            }
+            else if (IsEqualGUID(type, &TID_D3DRMAnimationKey))
+            {
+                DWORD size = 0;
+                const void *keys;
+
+                if (SUCCEEDED(IDirectXFileData_GetData(cdata, NULL, &size, (void **)&keys)))
+                    animation_add_file_keys(&animation->IDirect3DRMAnimation2_iface, keys, size);
+            }
+            else if (IsEqualGUID(type, &TID_D3DRMAnimationOptions))
+            {
+                DWORD size = 0;
+                const DWORD *opts;
+
+                if (SUCCEEDED(IDirectXFileData_GetData(cdata, NULL, &size, (void **)&opts)) && size >= 8)
+                    animation->options = (opts[0] ? D3DRMANIMATION_OPEN : D3DRMANIMATION_CLOSED)
+                            | (opts[1] ? D3DRMANIMATION_LINEARPOSITION : D3DRMANIMATION_SPLINEPOSITION);
+            }
+        }
+        if (cdata)
+            IDirectXFileData_Release(cdata);
+        IDirectXFileObject_Release(child);
+    }
+
+    hr = d3drm_animation_set_add(set, &animation->IDirect3DRMAnimation2_iface);
+    IDirect3DRMAnimation2_Release(&animation->IDirect3DRMAnimation2_iface);
+    return hr;
+}
+
+/* Fills the set from an AnimationSet data object. */
+HRESULT d3drm_animation_set_load(struct d3drm_animation_set *set, IDirectXFileData *data,
+        IDirect3DRMFrame3 *parent_frame)
+{
+    IDirectXFileObject *child;
+    HRESULT hr;
+    char name[256];
+    DWORD size = sizeof(name);
+
+    if (SUCCEEDED(IDirectXFileData_GetName(data, name, &size)) && size)
+        d3drm_object_set_name(&set->obj, name);
+
+    while (SUCCEEDED(hr = IDirectXFileData_GetNextObject(data, &child)))
+    {
+        IDirectXFileData *cdata = NULL;
+        IDirectXFileDataReference *reference;
+        const GUID *type;
+
+        if (SUCCEEDED(IDirectXFileObject_QueryInterface(child, &IID_IDirectXFileDataReference,
+                (void **)&reference)))
+        {
+            if (FAILED(IDirectXFileDataReference_Resolve(reference, &cdata)))
+                cdata = NULL;
+            IDirectXFileDataReference_Release(reference);
+        }
+        else if (FAILED(IDirectXFileObject_QueryInterface(child, &IID_IDirectXFileData, (void **)&cdata)))
+            cdata = NULL;
+
+        if (cdata)
+        {
+            if (SUCCEEDED(IDirectXFileData_GetType(cdata, &type)) && IsEqualGUID(type, &TID_D3DRMAnimation))
+                animation_load_data(set, cdata, parent_frame);
+            IDirectXFileData_Release(cdata);
+        }
+        IDirectXFileObject_Release(child);
+    }
+    return hr == DXFILEERR_NOMOREOBJECTS ? D3DRM_OK : hr;
+}
