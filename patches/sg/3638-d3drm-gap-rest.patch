+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IDirect3DRMAnimationSet) || IsEqualGUID(riid, &IID_IDirect3DRMObject)
+            || IsEqualGUID(riid, &IID_IUnknown))
+        *out = &set->IDirect3DRMAnimationSet_iface;
+    else if (IsEqualGUID(riid, &IID_IDirect3DRMAnimationSet2))
