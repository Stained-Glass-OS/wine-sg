+static HRESULT d3drm_animation_set_add(struct d3drm_animation_set *set, IDirect3DRMAnimation2 *animation)
+{
+    SIZE_T i;
+
+    if (!animation)
+        return D3DRMERR_BADOBJECT;
+    for (i = 0; i < set->nb_animations; ++i)
+    {
+        if (set->animations[i] == animation)
+            return D3DRM_OK;
+    }
+    if (!d3drm_array_reserve((void **)&set->animations, &set->animations_size, set->nb_animations + 1,
+            sizeof(*set->animations)))
+        return E_OUTOFMEMORY;
+    IDirect3DRMAnimation2_AddRef(animation);
+    set->animations[set->nb_animations++] = animation;
+    return D3DRM_OK;
+}
+
+static HRESULT d3drm_animation_set_delete(struct d3drm_animation_set *set, IDirect3DRMAnimation2 *animation)
+{
+    SIZE_T i;
+
+    if (!animation)
+        return D3DRMERR_BADOBJECT;
+    for (i = 0; i < set->nb_animations; ++i)
+    {
+        if (set->animations[i] == animation)
+        {
+            IDirect3DRMAnimation2_Release(animation);
+            memmove(&set->animations[i], &set->animations[i + 1],
+                    (set->nb_animations - i - 1) * sizeof(*set->animations));
+            --set->nb_animations;
+            return D3DRM_OK;
+        }
+    }
+    return D3DRMERR_NOTFOUND;
+}
+
+static HRESULT d3drm_animation_set_set_time(struct d3drm_animation_set *set, float time)
+{
+    SIZE_T i;
+    HRESULT hr = D3DRM_OK;
+
+#ifdef SG_MUTANT_DRM_SETTIME
+    return D3DRM_OK;
+#endif
+    for (i = 0; i < set->nb_animations; ++i)
+    {
+        HRESULT h = IDirect3DRMAnimation2_SetTime(set->animations[i], time);
+
+        if (FAILED(h))
+            hr = h;
+    }
+    return hr;
+}
+
+static HRESULT d3drm_animation_set_get_animations(struct d3drm_animation_set *set,
+        IDirect3DRMAnimationArray **out)
+{
+    struct d3drm_animation_array *array;
+    SIZE_T i;
+
+    if (!out)
+        return D3DRMERR_BADVALUE;
+    *out = NULL;
+    if (!(array = calloc(1, sizeof(*array))))
+        return E_OUTOFMEMORY;
+    if (set->nb_animations && !(array->animations = calloc(set->nb_animations, sizeof(*array->animations))))
+    {
+        free(array);
+        return E_OUTOFMEMORY;
+    }
+    array->IDirect3DRMAnimationArray_iface.lpVtbl = &d3drm_animation_array_vtbl;
+    array->ref = 1;
+    array->count = set->nb_animations;
+    for (i = 0; i < set->nb_animations; ++i)
+    {
+        array->animations[i] = set->animations[i];
+        IDirect3DRMAnimation2_AddRef(array->animations[i]);
+    }
+    *out = &array->IDirect3DRMAnimationArray_iface;
+    return D3DRM_OK;
+}
