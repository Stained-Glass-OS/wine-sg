+{ \
+    type *object = CONTAINING_RECORD(iface, type, member); \
+    TRACE("iface %p, cb %p, ctx %p.\n", iface, cb, ctx); \
+    return d3drm_object_delete_destroy_callback(&object->obj, cb, ctx); \
+} \
+static HRESULT WINAPI prefix##_SetAppData(itype *iface, DWORD data) \
+{ \
+    type *object = CONTAINING_RECORD(iface, type, member); \
+    TRACE("iface %p, data %#lx.\n", iface, data); \
+    object->obj.appdata = data; \
+    return D3DRM_OK; \
+} \
+static DWORD WINAPI prefix##_GetAppData(itype *iface) \
+{ \
+    type *object = CONTAINING_RECORD(iface, type, member); \
+    TRACE("iface %p.\n", iface); \
+    return object->obj.appdata; \
+} \
