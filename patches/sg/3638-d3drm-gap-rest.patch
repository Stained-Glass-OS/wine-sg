+static HRESULT d3drm_shadow_set_object(struct d3drm_shadow *shadow, IUnknown *object)
+{
+    IUnknown *visual;
+    HRESULT hr;
+
+    if (!object)
+        return D3DRMERR_BADOBJECT;
+    /* a visual or a frame (the whole hierarchy of which then casts the shadow) */
+    if (FAILED(hr = IUnknown_QueryInterface(object, &IID_IDirect3DRMVisual, (void **)&visual)))
+        return D3DRMERR_BADOBJECT;
+    if (shadow->visual)
+        IUnknown_Release(shadow->visual);
+    shadow->visual = visual;
+    return D3DRM_OK;
+}
