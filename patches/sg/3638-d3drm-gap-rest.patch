+/* ---- deleting, optimizing, sub meshes and the other methods that change what a builder holds ---- */
+
+/* map[old] is the new index of a vertex, or ~0 when it is gone. A face that uses a gone vertex is dropped. The
+ * new vertices are those that are the first with their new index. */
+static HRESULT mesh_builder_remap_vertices(struct d3drm_mesh_builder *mb, const DWORD *map, DWORD new_count)
+{
+    DWORD *data = NULL, *out, *ptr, n, j, i, kept = 0, face_index = 0;
+    DWORD *new_materials = NULL;
+    D3DVECTOR *vertices;
+    struct coords_2d *coords = NULL;
+    D3DCOLOR *colors = NULL;
+    BOOL have_coords = mb->nb_coords2d == mb->nb_vertices && mb->pCoords2d;
+
+    if (mb->face_data_size && !(data = malloc(mb->face_data_size * sizeof(*data))))
+        return E_OUTOFMEMORY;
+    if (mb->material_indices && mb->nb_faces && !(new_materials = malloc(mb->nb_faces * sizeof(*new_materials))))
+    {
+        free(data);
+        return E_OUTOFMEMORY;
+    }
+    out = data;
+    for (ptr = mb->pFaceData, i = 0; i < mb->nb_faces; ++i, ptr += 1 + n * 2)
+    {
+        BOOL keep = TRUE;
+
+        n = *ptr;
+        for (j = 0; j < n; ++j)
+            if (ptr[1 + j * 2] >= mb->nb_vertices || map[ptr[1 + j * 2]] == ~0u)
+                keep = FALSE;
+#ifdef SG_MUTANT_DRM_DELV
+        keep = TRUE;
+#endif
+        if (!keep)
+            continue;
+        *out++ = n;
+        for (j = 0; j < n; ++j)
+        {
+            *out++ = map[ptr[1 + j * 2]];
+            *out++ = ptr[2 + j * 2];
+        }
+        if (new_materials)
+            new_materials[kept] = mb->material_indices[i];
+        ++kept;
+        ++face_index;
+    }
+    if (out)
+        *out++ = 0;
+
+    vertices = mb->vertices;
+    if (have_coords && new_count)
+        coords = mb->pCoords2d;
+    if (mb->vertex_colors && new_count && !(colors = malloc(new_count * sizeof(*colors))))
+    {
+        free(data);
+        free(new_materials);
+        return E_OUTOFMEMORY;
+    }
+    {
+        DWORD next = 0;
+
+        for (i = 0; i < mb->nb_vertices; ++i)
+        {
+            if (map[i] == ~0u || map[i] != next)
+                continue;
+            if (colors)
+                colors[next] = i < mb->nb_vertex_colors ? mb->vertex_colors[i] : mb->color;
+            vertices[next] = vertices[i];
+            if (coords)
+                coords[next] = coords[i];
+            ++next;
+        }
+    }
+    mb->nb_vertices = new_count;
+    if (have_coords)
+        mb->nb_coords2d = new_count;
+    if (colors)
+    {
+        free(mb->vertex_colors);
+        mb->vertex_colors = colors;
+        mb->nb_vertex_colors = new_count;
+    }
+    free(mb->pFaceData);
+    mb->pFaceData = data;
+    mb->face_data_size = data ? out - data : 0;
+    mb->nb_faces = kept;
+    if (mb->material_indices)
+    {
+        free(mb->material_indices);
+        mb->material_indices = new_materials;
+    }
+    return D3DRM_OK;
+}
+
+static HRESULT mesh_builder_delete_vertices(struct d3drm_mesh_builder *mb, DWORD start, DWORD count)
+{
+    DWORD *map, i, next = 0;
+    HRESULT hr;
+
+    if (start > mb->nb_vertices || count > mb->nb_vertices - start)
+        return D3DRMERR_BADVALUE;
+    if (!count)
+        return D3DRM_OK;
+    if (!(map = malloc(mb->nb_vertices * sizeof(*map))))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < mb->nb_vertices; ++i)
+        map[i] = (i >= start && i < start + count) ? ~0u : next++;
+    hr = mesh_builder_remap_vertices(mb, map, mb->nb_vertices - count);
+    free(map);
+    return hr;
+}
+
+/* The normals in [start, start + count) go; the faces that used them lose their normals (index ~0). */
+static HRESULT mesh_builder_delete_normals(struct d3drm_mesh_builder *mb, DWORD start, DWORD count)
+{
+    DWORD *ptr, n, i, j;
+
+    if (start > mb->nb_normals || count > mb->nb_normals - start)
+        return D3DRMERR_BADVALUE;
+    if (!count)
+        return D3DRM_OK;
+    for (ptr = mb->pFaceData, i = 0; i < mb->nb_faces; ++i, ptr += 1 + n * 2)
+    {
+        n = *ptr;
+        for (j = 0; j < n; ++j)
+        {
+            DWORD *idx = &ptr[2 + j * 2];
+
+            if (*idx == ~0u)
+                continue;
+            if (*idx >= start && *idx < start + count)
+                *idx = ~0u;
+            else if (*idx >= start + count)
+                *idx -= count;
+        }
+    }
+    memmove(mb->normals + start, mb->normals + start + count, (mb->nb_normals - start - count) * sizeof(*mb->normals));
+    mb->nb_normals -= count;
+    return D3DRM_OK;
+}
+
+static BOOL face_matches(struct d3drm_mesh_builder *mb, const DWORD *ptr, struct d3drm_face *face)
+{
+    DWORD n = *ptr, j;
+
+    if (n != face->nb_vertices)
+        return FALSE;
+    for (j = 0; j < n; ++j)
+    {
+        const D3DVECTOR *a, *b = &face->vertices[j].position;
+
+        if (ptr[1 + j * 2] >= mb->nb_vertices)
+            return FALSE;
+        a = &mb->vertices[ptr[1 + j * 2]];
+        if (a->x != b->x || a->y != b->y || a->z != b->z)
+            return FALSE;
+    }
+    return TRUE;
+}
+
+/* Face objects are snapshots; the face to delete is the first one with the same corners. */
+static HRESULT mesh_builder_delete_face(struct d3drm_mesh_builder *mb, IDirect3DRMFace2 *face2)
+{
+    struct d3drm_face *face;
+    DWORD *ptr, n, i, *tail;
+    SIZE_T k;
+
+    if (!face2)
+        return D3DRMERR_BADOBJECT;
+    face = CONTAINING_RECORD(face2, struct d3drm_face, IDirect3DRMFace2_iface);
+    for (k = 0; k < mb->nb_extra_faces; ++k)
+    {
+        if (mb->extra_faces[k] == face)
+        {
+            IDirect3DRMFace_Release(&face->IDirect3DRMFace_iface);
+            memmove(&mb->extra_faces[k], &mb->extra_faces[k + 1], (mb->nb_extra_faces - k - 1) * sizeof(*mb->extra_faces));
+            --mb->nb_extra_faces;
+            if (k < mb->nb_leading_extra_faces)
+                --mb->nb_leading_extra_faces;
+            return D3DRM_OK;
+        }
+    }
+    for (ptr = mb->pFaceData, i = 0; i < mb->nb_faces; ++i, ptr += 1 + n * 2)
+    {
+        n = *ptr;
+        if (!face_matches(mb, ptr, face))
+            continue;
+        tail = ptr + 1 + n * 2;
+        memmove(ptr, tail, ((DWORD *)mb->pFaceData + mb->face_data_size - tail) * sizeof(*ptr));
+        mb->face_data_size -= 1 + n * 2;
+        if (mb->material_indices)
+            memmove(&mb->material_indices[i], &mb->material_indices[i + 1], (mb->nb_faces - i - 1) * sizeof(DWORD));
+        --mb->nb_faces;
+        return D3DRM_OK;
+    }
+    return D3DRMERR_NOTFOUND;
+}
+
+/* Merges vertices that have the same position, texture coordinates and colour, and drops the vertices and
+ * normals no face uses. */
+static HRESULT mesh_builder_optimize(struct d3drm_mesh_builder *mb)
+{
+    DWORD *map, *used, *nmap, *ptr, n, i, j, k, next = 0, nnext = 0;
+    BOOL coords = mb->nb_coords2d == mb->nb_vertices && mb->pCoords2d;
+    HRESULT hr;
+
+    if (!mb->nb_vertices)
+        return D3DRM_OK;
+    if (!(map = malloc(mb->nb_vertices * 2 * sizeof(*map))))
+        return E_OUTOFMEMORY;
+    used = map + mb->nb_vertices;
+    memset(used, 0, mb->nb_vertices * sizeof(*used));
+    for (ptr = mb->pFaceData, i = 0; i < mb->nb_faces; ++i, ptr += 1 + n * 2)
+    {
+        n = *ptr;
+        for (j = 0; j < n; ++j)
+            if (ptr[1 + j * 2] < mb->nb_vertices)
+                used[ptr[1 + j * 2]] = 1;
+    }
+    for (i = 0; i < mb->nb_vertices; ++i)
+    {
+        map[i] = ~0u;
+        if (!used[i])
+            continue;
+        for (k = 0; k < i; ++k)
+        {
+            if (map[k] == ~0u || !used[k])
+                continue;
+            if (mb->vertices[k].x != mb->vertices[i].x || mb->vertices[k].y != mb->vertices[i].y
+                    || mb->vertices[k].z != mb->vertices[i].z)
+                continue;
+            if (coords && (mb->pCoords2d[k].u != mb->pCoords2d[i].u || mb->pCoords2d[k].v != mb->pCoords2d[i].v))
+                continue;
+            if (mesh_builder_get_vertex_color(mb, k) != mesh_builder_get_vertex_color(mb, i))
+                continue;
+            map[i] = map[k];
+            break;
+        }
+        if (map[i] == ~0u)
+            map[i] = next++;
+    }
+    hr = mesh_builder_remap_vertices(mb, map, next);
+    free(map);
+    if (FAILED(hr) || !mb->nb_normals)
+        return hr;
+
+    /* unused normals */
+    if (!(nmap = calloc(mb->nb_normals, sizeof(*nmap))))
+        return E_OUTOFMEMORY;
+    for (ptr = mb->pFaceData, i = 0; i < mb->nb_faces; ++i, ptr += 1 + n * 2)
+    {
+        n = *ptr;
+        for (j = 0; j < n; ++j)
+            if (ptr[2 + j * 2] < mb->nb_normals)
+                nmap[ptr[2 + j * 2]] = 1;
+    }
+    for (i = 0; i < mb->nb_normals; ++i)
+    {
+        if (nmap[i])
+        {
+            nmap[i] = nnext;
+            mb->normals[nnext++] = mb->normals[i];
+        }
+        else
+            nmap[i] = ~0u;
+    }
+    for (ptr = mb->pFaceData, i = 0; i < mb->nb_faces; ++i, ptr += 1 + n * 2)
+    {
+        n = *ptr;
+        for (j = 0; j < n; ++j)
+            if (ptr[2 + j * 2] < mb->nb_normals)
+                ptr[2 + j * 2] = nmap[ptr[2 + j * 2]];
+    }
+    mb->nb_normals = nnext;
+    free(nmap);
+    return D3DRM_OK;
+}
