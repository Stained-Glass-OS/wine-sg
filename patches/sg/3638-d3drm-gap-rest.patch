+static HRESULT d3drm_shadow_init(struct d3drm_shadow *shadow, IUnknown *object, IDirect3DRMLight *light,
+        float px, float py, float pz, float nx, float ny, float nz)
+{
+    HRESULT hr;
+
+    if (!object || !light)
+        return D3DRMERR_BADOBJECT;
+    if (nx == 0.0f && ny == 0.0f && nz == 0.0f)
+        return D3DRMERR_BADVALUE;
+    if (FAILED(hr = d3drm_shadow_set_object(shadow, object)))
+        return hr;
+    d3drm_shadow_set_light(shadow, light);
+    return d3drm_shadow_set_plane(shadow, px, py, pz, nx, ny, nz);
