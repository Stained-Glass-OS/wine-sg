+/* Every object a factory creates is listed here (without holding a reference) so that
+ * GetNamedObject, EnumerateObjects, GetDevices and Tick can find it. The entry is removed when
+ * the object is destroyed (d3drm_object_cleanup). */
+void d3drm_object_register(struct d3drm_object *object, IDirect3DRMObject *iface, IDirect3DRM *factory)
+{
+    EnterCriticalSection(&registry_cs);
+    object->registry_iface = iface;
+    object->factory = factory;
+    list_add_tail(&registry, &object->registry_entry);
+    LeaveCriticalSection(&registry_cs);
