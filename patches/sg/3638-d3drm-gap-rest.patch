+/* AddFacesIndexed: faces of vertex (and normal) indices of the builder itself, ended by a face of 0 vertices. */
+static HRESULT mesh_builder_add_faces_indexed(struct d3drm_mesh_builder *mb, DWORD flags, const DWORD *indices,
+        DWORD *first, DWORD *count)
+{
+    const DWORD *ptr;
+    DWORD n, j, added = 0, start = mb->nb_faces + mb->nb_extra_faces;
+    BOOL vertices_only = !!(flags & D3DRMADDFACES_VERTICESONLY);
+
+    if (flags & ~D3DRMADDFACES_VERTICESONLY)
+        return D3DRMERR_BADVALUE;
+    if (!indices)
+        return D3DRMERR_BADVALUE;
+    for (ptr = indices; (n = *ptr); ptr += 1 + n * (vertices_only ? 1 : 2))
+    {
+        for (j = 0; j < n; ++j)
+        {
+            if (ptr[1 + j * (vertices_only ? 1 : 2)] >= mb->nb_vertices)
+                return D3DRMERR_BADVALUE;
+            if (!vertices_only && ptr[2 + j * 2] != ~0u && ptr[2 + j * 2] >= mb->nb_normals)
+                return D3DRMERR_BADVALUE;
+        }
+    }
+    for (ptr = indices; (n = *ptr); ptr += 1 + n * (vertices_only ? 1 : 2))
+    {
+        DWORD *face;
+        HRESULT hr;
+
+        if (!(face = malloc((1 + n * 2) * sizeof(*face))))
+            return E_OUTOFMEMORY;
+        face[0] = n;
+        for (j = 0; j < n; ++j)
+        {
+            face[1 + j * 2] = ptr[1 + j * (vertices_only ? 1 : 2)];
+            face[2 + j * 2] = vertices_only ? (mb->nb_normals ? face[1 + j * 2] % mb->nb_normals : 0) : ptr[2 + j * 2];
+            if (vertices_only && face[2 + j * 2] >= mb->nb_normals)
+                face[2 + j * 2] = ~0u;
+        }
+        hr = mesh_builder_append_face_data(mb, face, 1 + n * 2);
+        free(face);
+        if (FAILED(hr))
+            return hr;
+        ++added;
+    }
+    if (first)
+        *first = start;
+    if (count)
+        *count = added;
+    return D3DRM_OK;
+}
+
+static HRESULT mesh_builder_ensure_coords(struct d3drm_mesh_builder *mb)
+{
+    struct coords_2d *coords;
+
+    if (mb->nb_coords2d >= mb->nb_vertices)
+        return D3DRM_OK;
+    if (!(coords = realloc(mb->pCoords2d, mb->nb_vertices * sizeof(*coords))))
+        return E_OUTOFMEMORY;
+    memset(coords + mb->nb_coords2d, 0, (mb->nb_vertices - mb->nb_coords2d) * sizeof(*coords));
+    mb->pCoords2d = coords;
+    mb->nb_coords2d = mb->nb_vertices;
+    return D3DRM_OK;
+}
+
+/* AddTriangles: consecutive triples of vertices in a flexible vertex format. */
+static HRESULT mesh_builder_add_triangles(struct d3drm_mesh_builder *mb, DWORD flags, DWORD format,
+        DWORD vertex_count, const BYTE *data)
+{
+    DWORD stride = 0, off_normal = 0, off_diffuse = 0, off_tex = 0, i;
+    BOOL has_normal = !!(format & D3DFVF_NORMAL), has_diffuse = !!(format & D3DFVF_DIFFUSE);
+    DWORD tex_count = (format & D3DFVF_TEXCOUNT_MASK) >> D3DFVF_TEXCOUNT_SHIFT;
+    DWORD base_v = mb->nb_vertices, base_n = mb->nb_normals;
+    HRESULT hr;
+
+    if ((format & D3DFVF_POSITION_MASK) != D3DFVF_XYZ || !data || vertex_count % 3)
+        return D3DRMERR_BADVALUE;
+    stride = 12;
+    if (has_normal)
+    {
+        off_normal = stride;
+        stride += 12;
+    }
+    if (has_diffuse)
+    {
+        off_diffuse = stride;
+        stride += 4;
+    }
+    if (format & D3DFVF_SPECULAR)
+        stride += 4;
+    if (tex_count)
+    {
+        off_tex = stride;
+        stride += tex_count * 8;
+    }
+    if (!vertex_count)
+        return D3DRM_OK;
+
+    if (!d3drm_array_reserve((void **)&mb->vertices, &mb->vertices_size, mb->nb_vertices + vertex_count,
+            sizeof(*mb->vertices)))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < vertex_count; ++i)
+    {
+        const BYTE *v = data + i * stride;
+        D3DVECTOR p, nrm;
+        DWORD face[7];
+
+        memcpy(&p, v, sizeof(p));
+        mb->vertices[base_v + i] = p;
+        if (has_normal)
+        {
+            memcpy(&nrm, v + off_normal, sizeof(nrm));
+            if (!d3drm_array_reserve((void **)&mb->normals, &mb->normals_size, mb->nb_normals + 1, sizeof(*mb->normals)))
+                return E_OUTOFMEMORY;
+            mb->normals[mb->nb_normals++] = nrm;
+        }
+        if (i % 3 == 2)
+        {
+            DWORD k;
+
+            face[0] = 3;
+            for (k = 0; k < 3; ++k)
+            {
+                face[1 + k * 2] = base_v + i - 2 + k;
+                face[2 + k * 2] = has_normal ? base_n + i - 2 + k : ~0u;
+            }
+            if (FAILED(hr = mesh_builder_append_face_data(mb, face, 7)))
+                return hr;
+        }
+    }
+    mb->nb_vertices = base_v + vertex_count;
+    if (tex_count || has_diffuse)
+    {
+        if (tex_count && FAILED(hr = mesh_builder_ensure_coords(mb)))
+            return hr;
+        for (i = 0; i < vertex_count; ++i)
+        {
+            const BYTE *v = data + i * stride;
+
+            if (tex_count)
+            {
+                float uv[2];
+
+                memcpy(uv, v + off_tex, sizeof(uv));
+                mb->pCoords2d[base_v + i].u = uv[0];
+                mb->pCoords2d[base_v + i].v = uv[1];
+            }
+            if (has_diffuse)
+            {
+                DWORD color;
+
+                memcpy(&color, v + off_diffuse, sizeof(color));
+                mesh_builder_set_vertex_color(mb, base_v + i, color);
+            }
+        }
+    }
+    return D3DRM_OK;
+}
+
+static void mesh_builder_forget_submesh(struct d3drm_mesh_builder *parent, struct d3drm_mesh_builder *child)
+{
+    SIZE_T i;
+
+    for (i = 0; i < parent->nb_submeshes; ++i)
+    {
+        if (parent->submeshes[i] == child)
+        {
+            memmove(&parent->submeshes[i], &parent->submeshes[i + 1],
+                    (parent->nb_submeshes - i - 1) * sizeof(*parent->submeshes));
+            --parent->nb_submeshes;
+            return;
+        }
+    }
+}
+
+static HRESULT mesh_builder_create_submesh(struct d3drm_mesh_builder *mb, IUnknown **out)
+{
+    struct d3drm_mesh_builder *child;
+    HRESULT hr;
+
+    if (!out)
+        return D3DRMERR_BADVALUE;
+    *out = NULL;
+    if (FAILED(hr = d3drm_mesh_builder_create(&child, mb->d3drm)))
+        return hr;
+    if (!d3drm_array_reserve((void **)&mb->submeshes, &mb->submeshes_size, mb->nb_submeshes + 1, sizeof(*mb->submeshes)))
+    {
+        IDirect3DRMMeshBuilder3_Release(&child->IDirect3DRMMeshBuilder3_iface);
+        return E_OUTOFMEMORY;
+    }
+    child->parent = mb;
+    IDirect3DRMMeshBuilder3_AddRef(&child->IDirect3DRMMeshBuilder3_iface);
+    mb->submeshes[mb->nb_submeshes++] = child;
+    *out = (IUnknown *)&child->IDirect3DRMMeshBuilder3_iface;
+    return D3DRM_OK;
+}
+
+static void d3drm_matrix_mul(struct d3drm_matrix *dst, const struct d3drm_matrix *a, const struct d3drm_matrix *b)
+{
+    struct d3drm_matrix t;
+
+    t._11 = a->_11 * b->_11 + a->_12 * b->_21 + a->_13 * b->_31;
+    t._12 = a->_11 * b->_12 + a->_12 * b->_22 + a->_13 * b->_32;
+    t._13 = a->_11 * b->_13 + a->_12 * b->_23 + a->_13 * b->_33;
+    t._21 = a->_21 * b->_11 + a->_22 * b->_21 + a->_23 * b->_31;
+    t._22 = a->_21 * b->_12 + a->_22 * b->_22 + a->_23 * b->_32;
+    t._23 = a->_21 * b->_13 + a->_22 * b->_23 + a->_23 * b->_33;
+    t._31 = a->_31 * b->_11 + a->_32 * b->_21 + a->_33 * b->_31;
+    t._32 = a->_31 * b->_12 + a->_32 * b->_22 + a->_33 * b->_32;
+    t._33 = a->_31 * b->_13 + a->_32 * b->_23 + a->_33 * b->_33;
+    t._41 = a->_41 * b->_11 + a->_42 * b->_21 + a->_43 * b->_31 + b->_41;
+    t._42 = a->_41 * b->_12 + a->_42 * b->_22 + a->_43 * b->_32 + b->_42;
+    t._43 = a->_41 * b->_13 + a->_42 * b->_23 + a->_43 * b->_33 + b->_43;
+    t._14 = t._24 = t._34 = 0.0f;
+    t._44 = 1.0f;
+    *dst = t;
+}
+
+static void mesh_builder_transform(struct d3drm_mesh_builder *mb, const struct d3drm_matrix *m)
+{
+    DWORD i;
+
+    for (i = 0; i < mb->nb_vertices; ++i)
+    {
+        D3DVECTOR v = mb->vertices[i];
+
+        mb->vertices[i].x = v.x * m->_11 + v.y * m->_21 + v.z * m->_31 + m->_41;
+        mb->vertices[i].y = v.x * m->_12 + v.y * m->_22 + v.z * m->_32 + m->_42;
+        mb->vertices[i].z = v.x * m->_13 + v.y * m->_23 + v.z * m->_33 + m->_43;
+    }
+    for (i = 0; i < mb->nb_normals; ++i)
+    {
+        D3DVECTOR v = mb->normals[i];
+        float len;
+
+        mb->normals[i].x = v.x * m->_11 + v.y * m->_21 + v.z * m->_31;
+        mb->normals[i].y = v.x * m->_12 + v.y * m->_22 + v.z * m->_32;
+        mb->normals[i].z = v.x * m->_13 + v.y * m->_23 + v.z * m->_33;
+        len = sqrtf(mb->normals[i].x * mb->normals[i].x + mb->normals[i].y * mb->normals[i].y
+                + mb->normals[i].z * mb->normals[i].z);
+        if (len > 0.0f)
+        {
+            mb->normals[i].x /= len;
+            mb->normals[i].y /= len;
+            mb->normals[i].z /= len;
+        }
+    }
+}
