+#define d3drm_animation_set1_destroy d3drm_animation_set_destroy
+#define d3drm_animation_set2_destroy d3drm_animation_set_destroy
+
+static struct d3drm_animation_set *impl_from_IDirect3DRMAnimationSet(IDirect3DRMAnimationSet *iface)
