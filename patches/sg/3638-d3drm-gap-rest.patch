+static HRESULT d3drm_animation_copy_keys(struct d3drm_animation_keys *dst, const struct d3drm_animation_keys *src)
+{
+    if (!src->count)
+        return D3DRM_OK;
+    if (!d3drm_array_reserve((void **)&dst->keys, &dst->size, src->count, sizeof(*dst->keys)))
+        return E_OUTOFMEMORY;
+    memcpy(dst->keys, src->keys, src->count * sizeof(*src->keys));
+    dst->count = src->count;
+    return D3DRM_OK;
+}
+
+/* Clone: a new animation with the same keys, options and frame. A key keeps its id. */
+static HRESULT d3drm_animation_clone(struct d3drm_animation *animation, IUnknown *outer, REFIID iid, void **out)
+{
+    struct d3drm_animation *clone;
+    HRESULT hr;
+
+    if (!out)
+        return D3DRMERR_BADVALUE;
+    *out = NULL;
+    if (outer)
+        return CLASS_E_NOAGGREGATION;
+    if (FAILED(hr = d3drm_animation_create(&clone, animation->d3drm)))
+        return hr;
+    clone->options = animation->options;
+    clone->frame = animation->frame;
+    clone->next_id = animation->next_id;
+    if (FAILED(hr = d3drm_animation_copy_keys(&clone->position, &animation->position))
+            || FAILED(hr = d3drm_animation_copy_keys(&clone->scale, &animation->scale))
+            || FAILED(hr = d3drm_animation_copy_keys(&clone->rotate, &animation->rotate)))
+    {
+        IDirect3DRMAnimation2_Release(&clone->IDirect3DRMAnimation2_iface);
+        return hr;
+    }
+    hr = IDirect3DRMAnimation2_QueryInterface(&clone->IDirect3DRMAnimation2_iface, iid, out);
+    IDirect3DRMAnimation2_Release(&clone->IDirect3DRMAnimation2_iface);
+    return hr;
+}
+
+static float animation_wrap_time(const struct d3drm_animation_keys *keys, float time, DWORD options)
+{
+    float last = keys->keys[keys->count - 1].time;
+
+    if (time < 0.0f)
+        time = 0.0f;
+    if ((options & D3DRMANIMATION_CLOSED) && last > 0.0f)
+        return fmodf(time, last);
+    return time;
+}
+
+/* The two keys around time and the fraction between them. */
+static void animation_find(const struct d3drm_animation_keys *keys, float time, SIZE_T *a, SIZE_T *b, float *t)
+{
+    SIZE_T i;
+
+    if (time <= keys->keys[0].time || keys->count == 1)
+    {
+        *a = *b = 0;
+        *t = 0.0f;
+        return;
+    }
+    for (i = 1; i < keys->count; ++i)
+    {
+        if (time <= keys->keys[i].time)
+        {
+            float span = keys->keys[i].time - keys->keys[i - 1].time;
+
+            *a = i - 1;
+            *b = i;
+            *t = span > 0.0f ? (time - keys->keys[i - 1].time) / span : 1.0f;
+            return;
+        }
+    }
+    *a = *b = keys->count - 1;
+    *t = 0.0f;
+}
+
+static float catmull_rom(float p0, float p1, float p2, float p3, float t)
+{
+    return 0.5f * ((2.0f * p1) + (-p0 + p2) * t + (2.0f * p0 - 5.0f * p1 + 4.0f * p2 - p3) * t * t
+            + (-p0 + 3.0f * p1 - 3.0f * p2 + p3) * t * t * t);
+}
+
+static D3DVECTOR animation_vector_at(const struct d3drm_animation_keys *keys, float time, BOOL position,
+        BOOL spline, DWORD options)
+{
+    const struct d3drm_animation_key *k = keys->keys;
+    SIZE_T a, b, p, n;
+    D3DVECTOR r;
+    float t;
+
+    time = animation_wrap_time(keys, time, options);
+    animation_find(keys, time, &a, &b, &t);
+#define KEYVEC(i) (position ? k[i].u.position : k[i].u.scale)
+    if (position && spline && a != b)
+    {
+        D3DVECTOR v0, v1, v2, v3;
+
+        p = a ? a - 1 : a;
+        n = b + 1 < keys->count ? b + 1 : b;
+        v0 = KEYVEC(p); v1 = KEYVEC(a); v2 = KEYVEC(b); v3 = KEYVEC(n);
+        r.x = catmull_rom(v0.x, v1.x, v2.x, v3.x, t);
+        r.y = catmull_rom(v0.y, v1.y, v2.y, v3.y, t);
+        r.z = catmull_rom(v0.z, v1.z, v2.z, v3.z, t);
+        return r;
+    }
+    {
+        D3DVECTOR v1 = KEYVEC(a), v2 = KEYVEC(b);
+
+        r.x = v1.x + (v2.x - v1.x) * t;
+        r.y = v1.y + (v2.y - v1.y) * t;
+        r.z = v1.z + (v2.z - v1.z) * t;
+    }
+#undef KEYVEC
+    return r;
+}
+
+/* Poses the frame as the keys say at the given time. Position keys set the translation row; scale and
+ * rotation keys set the upper 3x3 (scale first, then rotation). Tracks without keys leave the frame alone.
+ * D3DRMANIMATION_POSITION / SCALEANDROTATION restrict the animation to one of the two parts. */
+static HRESULT d3drm_animation_set_time(struct d3drm_animation *animation, float time)
+{
+    D3DRMMATRIX4D m;
+    struct d3drm_matrix *mat = d3drm_matrix(m);
+    BOOL do_pos = !(animation->options & D3DRMANIMATION_SCALEANDROTATION) && animation->position.count;
+    BOOL do_rot = !(animation->options & D3DRMANIMATION_POSITION) && animation->rotate.count;
+    BOOL do_scale = !(animation->options & D3DRMANIMATION_POSITION) && animation->scale.count;
+    HRESULT hr;
+
+    if (!animation->frame)
+        return D3DRM_OK;
+#ifdef SG_MUTANT_DRM_ANIM
+    return D3DRM_OK;
+#endif
+    if (FAILED(hr = IDirect3DRMFrame3_GetTransform(animation->frame, NULL, m)))
+        return hr;
+
+    if (do_rot || do_scale)
+    {
+        D3DVECTOR scale;
+        D3DRMMATRIX4D rot;
+        struct d3drm_matrix *r = d3drm_matrix(rot);
+        D3DRMQUATERNION q;
+        SIZE_T a, b, i;
+        float t, *row;
+
+        scale.x = scale.y = scale.z = 1.0f;
+        q.s = 1.0f;
+        q.v.x = q.v.y = q.v.z = 0.0f;
+
+        if (do_scale)
+            scale = animation_vector_at(&animation->scale, time, FALSE, FALSE, animation->options);
+        if (do_rot)
+        {
+            const struct d3drm_animation_keys *keys = &animation->rotate;
+
+            animation_find(keys, animation_wrap_time(keys, time, animation->options), &a, &b, &t);
+            if (a == b)
+                q = keys->keys[a].u.rotate;
+            else
+                D3DRMQuaternionSlerp(&q, (D3DRMQUATERNION *)&keys->keys[a].u.rotate,
+                        (D3DRMQUATERNION *)&keys->keys[b].u.rotate, t);
+            D3DRMMatrixFromQuaternion(rot, &q);
+        }
+        else
+        {
+            /* no rotation keys: keep the frame's own rotation (its rows without the old scale) */
+            memcpy(rot, m, sizeof(rot));
+            for (i = 0; i < 3; ++i)
+            {
+                float len;
+
+                row = &rot[i][0];
+                len = sqrtf(row[0] * row[0] + row[1] * row[1] + row[2] * row[2]);
+                if (len > 0.0f)
+                    row[0] /= len, row[1] /= len, row[2] /= len;
+            }
+        }
+        /* row i of the 3x3 is the i-th basis vector scaled by scale[i] */
+        mat->_11 = r->_11 * scale.x; mat->_12 = r->_12 * scale.x; mat->_13 = r->_13 * scale.x;
+        mat->_21 = r->_21 * scale.y; mat->_22 = r->_22 * scale.y; mat->_23 = r->_23 * scale.y;
+        mat->_31 = r->_31 * scale.z; mat->_32 = r->_32 * scale.z; mat->_33 = r->_33 * scale.z;
+    }
+    if (do_pos)
+    {
+        D3DVECTOR p = animation_vector_at(&animation->position, time, TRUE,
+                !!(animation->options & D3DRMANIMATION_SPLINEPOSITION), animation->options);
+
+        mat->_41 = p.x;
+        mat->_42 = p.y;
+        mat->_43 = p.z;
+    }
+    return IDirect3DRMFrame3_AddTransform(animation->frame, D3DRMCOMBINE_REPLACE, m);
+}
+
+static struct d3drm_animation_key *animation_find_id(struct d3drm_animation *animation, DWORD id,
+        struct d3drm_animation_keys **track)
+{
+    struct d3drm_animation_keys *tracks[3] = { &animation->rotate, &animation->position, &animation->scale };
+    SIZE_T t, i;
+
+    for (t = 0; t < 3; ++t)
+    {
+        for (i = 0; i < tracks[t]->count; ++i)
+        {
+            if (tracks[t]->keys[i].id == id)
+            {
+                *track = tracks[t];
+                return &tracks[t]->keys[i];
+            }
+        }
+    }
+    return NULL;
