+/* D3DRMLOAD_BYNAME / BYPOSITION / BYGUID / FIRST: does the top-level object take part? */
+static BOOL d3drm_load_selected(IDirectXFileData *data, DWORD flags, void *object_id, DWORD position)
+{
+#ifdef SG_MUTANT_DRM_LOADSEL
+    return TRUE;
+#endif
+    if (flags & D3DRMLOAD_BYNAME)
+    {
+        char name[256];
+        DWORD size = sizeof(name);
+
+        if (!object_id || FAILED(IDirectXFileData_GetName(data, name, &size)))
+            return FALSE;
+        return !strcmp(name, object_id);
+    }
+    if (flags & D3DRMLOAD_BYPOSITION)
+        return object_id && position == *(DWORD *)object_id;
+    if (flags & D3DRMLOAD_BYGUID)
+    {
+        GUID id;
+
+        if (!object_id || FAILED(IDirectXFileData_GetId(data, &id)))
+            return FALSE;
+        return IsEqualGUID(&id, object_id);
+    }
+    return TRUE;
+}
