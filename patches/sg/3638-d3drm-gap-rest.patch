+
+#define REFCOUNT_METHODS(prefix, type, itype, member) \
+static ULONG WINAPI prefix##_AddRef(itype *iface) \
+{ \
+    type *object = CONTAINING_RECORD(iface, type, member); \
+    ULONG refcount = InterlockedIncrement(&object->ref); \
+    TRACE("%p increasing refcount to %lu.\n", iface, refcount); \
+    return refcount; \
+} \
+static ULONG WINAPI prefix##_Release(itype *iface) \
+{ \
+    type *object = CONTAINING_RECORD(iface, type, member); \
+    ULONG refcount = InterlockedDecrement(&object->ref); \
+    TRACE("%p decreasing refcount to %lu.\n", iface, refcount); \
+    if (!refcount) \
+        prefix##_destroy(object); \
+    return refcount; \
