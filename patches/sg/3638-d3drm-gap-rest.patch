+static HRESULT d3drm_texture_clone(struct d3drm_texture *texture, IUnknown *outer, REFIID iid, void **out)
+{
+    struct d3drm_texture *clone;
+    HRESULT hr;
+
+    if (!out)
+        return D3DRMERR_BADVALUE;
+    *out = NULL;
+    if (outer)
+        return CLASS_E_NOAGGREGATION;
+    if (FAILED(hr = d3drm_texture_create(&clone, texture->d3drm)))
+        return hr;
+
+    /* the image belongs to the application and is shared, a surface is shared by reference */
+    clone->image = texture->image;
+    if ((clone->surface = texture->surface))
+        IDirectDrawSurface_AddRef(clone->surface);
+    if (clone->image || clone->surface)
+        IDirect3DRM_AddRef(clone->d3drm);
+    clone->decal_x = texture->decal_x;
+    clone->decal_y = texture->decal_y;
+    clone->max_colors = texture->max_colors;
+    clone->max_shades = texture->max_shades;
+    clone->transparency = texture->transparency;
+    clone->decal_width = texture->decal_width;
+    clone->decal_height = texture->decal_height;
+    clone->decal_scale = texture->decal_scale;
+    clone->decal_transparent_color = texture->decal_transparent_color;
+    clone->cache_importance = texture->cache_importance;
+    clone->cache_flags = texture->cache_flags;
+    clone->downsample_cb = texture->downsample_cb;
+    clone->downsample_ctx = texture->downsample_ctx;
+    clone->validation_cb = texture->validation_cb;
+    clone->validation_ctx = texture->validation_ctx;
+    clone->render_dirty = TRUE;
+    hr = IDirect3DRMTexture3_QueryInterface(&clone->IDirect3DRMTexture3_iface, iid, out);
+    IDirect3DRMTexture3_Release(&clone->IDirect3DRMTexture3_iface);
+    return hr;
+}
