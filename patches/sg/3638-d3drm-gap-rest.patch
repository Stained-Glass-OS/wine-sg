+static HRESULT wrap_apply(struct d3drm_wrap *wrap, IDirect3DRMFrame *frame, IDirect3DRMObject *object)
+{
+    IDirect3DRMMeshBuilder3 *builder;
+    IDirect3DRMFace2 *face;
+    struct d3drm_matrix m, inv, to_ref;
+    struct d3drm_frame *from = NULL, *ref;
+    IDirect3DRMFrame3 *frame3 = NULL;
+    BOOL convert = FALSE;
+    DWORD i, count;
+
+    if (!object)
+        return D3DRMERR_BADOBJECT;
+    if (!wrap->initialized)
+        return D3DRMERR_BADVALUE;
+
+    /* ApplyRelative: the object's points are in the space of the given frame, the wrap is in its reference frame */
+    if (frame && SUCCEEDED(IDirect3DRMFrame_QueryInterface(frame, &IID_IDirect3DRMFrame3, (void **)&frame3)))
+    {
+        from = unsafe_impl_from_IDirect3DRMFrame3(frame3);
+        ref = unsafe_impl_from_IDirect3DRMFrame3(wrap->reference);
+        if (from)
+        {
+            d3drm_frame_world_matrix(from, &m);
+            if (ref)
+            {
+                d3drm_frame_world_matrix(ref, &inv);
+                if (d3drm_matrix_invert_affine(&inv, &inv))
+                    d3drm_matrix_mul(&to_ref, &m, &inv);
+                else
+                    to_ref = m;
+            }
+            else
+                to_ref = m;
+            convert = TRUE;
+        }
+    }
+
+#define CONVERT(p, point) do { if (convert) { D3DVECTOR t_ = (p); \
+        (p).x = t_.x * to_ref._11 + t_.y * to_ref._21 + t_.z * to_ref._31 + ((point) ? to_ref._41 : 0.0f); \
+        (p).y = t_.x * to_ref._12 + t_.y * to_ref._22 + t_.z * to_ref._32 + ((point) ? to_ref._42 : 0.0f); \
+        (p).z = t_.x * to_ref._13 + t_.y * to_ref._23 + t_.z * to_ref._33 + ((point) ? to_ref._43 : 0.0f); } } while (0)
+
+    if (SUCCEEDED(IDirect3DRMObject_QueryInterface(object, &IID_IDirect3DRMMeshBuilder3, (void **)&builder)))
+    {
+        struct d3drm_mesh_builder *mb = impl_from_IDirect3DRMMeshBuilder3(builder);
+        HRESULT hr = mesh_builder_ensure_coords(mb);
+        DWORD *ptr, n, f, j;
+
+        if (SUCCEEDED(hr))
+        {
+            /* one coordinate pair per vertex; its normal is the one the first face using it names */
+            for (i = 0; i < mb->nb_vertices; ++i)
+            {
+                D3DVECTOR p = mb->vertices[i], nrm = {0};
+
+                for (ptr = mb->pFaceData, f = 0; f < mb->nb_faces; ++f, ptr += 1 + n * 2)
+                {
+                    n = *ptr;
+                    for (j = 0; j < n; ++j)
+                        if (ptr[1 + j * 2] == i && ptr[2 + j * 2] < mb->nb_normals)
+                            nrm = mb->normals[ptr[2 + j * 2]];
+                }
+                CONVERT(p, TRUE);
+                CONVERT(nrm, FALSE);
+                wrap_coords(wrap, &p, &nrm, &mb->pCoords2d[i].u, &mb->pCoords2d[i].v);
+            }
+        }
+        IDirect3DRMMeshBuilder3_Release(builder);
+        if (frame3)
+            IDirect3DRMFrame3_Release(frame3);
+        return hr;
+    }
+    if (SUCCEEDED(IDirect3DRMObject_QueryInterface(object, &IID_IDirect3DRMFace2, (void **)&face)))
+    {
+        D3DVECTOR positions[64], normals[64];
+        HRESULT hr;
+
+        count = 0;
+        hr = IDirect3DRMFace2_GetVertices(face, &count, NULL, NULL);
+        if (SUCCEEDED(hr) && count <= ARRAY_SIZE(positions))
+        {
+            hr = IDirect3DRMFace2_GetVertices(face, &count, positions, normals);
+            for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+            {
+                float u, v;
+
+                CONVERT(positions[i], TRUE);
+                CONVERT(normals[i], FALSE);
+                wrap_coords(wrap, &positions[i], &normals[i], &u, &v);
+                hr = IDirect3DRMFace2_SetTextureCoordinates(face, i, u, v);
+            }
+        }
+        else if (SUCCEEDED(hr))
+            hr = D3DRMERR_BADVALUE;
+        IDirect3DRMFace2_Release(face);
+        if (frame3)
+            IDirect3DRMFrame3_Release(frame3);
+        return hr;
+    }
+#undef CONVERT
+    if (frame3)
+        IDirect3DRMFrame3_Release(frame3);
+    return D3DRMERR_BADOBJECT;
+}
