+static void d3drm_clipped_visual_destroy(struct d3drm_clipped_visual *clipped)
+{
+    SIZE_T i;
+
+    d3drm_object_cleanup((IDirect3DRMObject *)&clipped->IDirect3DRMClippedVisual_iface, &clipped->obj);
+    for (i = 0; i < clipped->nb_planes; ++i)
+    {
+        if (clipped->planes[i].reference)
+            IDirect3DRMFrame3_Release(clipped->planes[i].reference);
+    }
+    free(clipped->planes);
+    if (clipped->visual)
+        IDirect3DRMVisual_Release(clipped->visual);
+    IDirect3DRM_Release(clipped->d3drm);
+    free(clipped);
+}
