+/* The levels of a surface made with DDSCAPS_MIPMAP are each the one before at half the size. */
+static HRESULT d3drm_texture_generate_mipmap(struct d3drm_texture *texture)
+{
+    IDirectDrawSurface *level, *next;
+    DDSCAPS caps = { DDSCAPS_MIPMAP };
+    HRESULT hr = D3DRM_OK;
+
+    if (!texture->surface)
+        return D3DRMERR_BADOBJECT;
+    level = texture->surface;
+    IDirectDrawSurface_AddRef(level);
+    while (SUCCEEDED(IDirectDrawSurface_GetAttachedSurface(level, &caps, &next)))
+    {
+        hr = IDirectDrawSurface_Blt(next, NULL, texture->surface, NULL, DDBLT_WAIT, NULL);
+        IDirectDrawSurface_Release(level);
+        level = next;
+        if (FAILED(hr))
+            break;
+    }
+    IDirectDrawSurface_Release(level);
+    return hr;
+}
