+        return D3DRMERR_BADVALUE;
+    shadow->point.x = px;
+    shadow->point.y = py;
+    shadow->point.z = pz;
+    shadow->normal.x = nx;
+    shadow->normal.y = ny;
+    shadow->normal.z = nz;
+    return D3DRM_OK;
+}
