+static void test_sg_gap2_factory(void)
+{
+    IDirect3DRM *d3drm1;
+    IDirect3DRM2 *d3drm2;
+    IDirect3DRM3 *d3drm3;
+    IDirect3DRMObject *object;
+    IDirect3DRMDeviceArray *devices;
+    IDirect3DRMFrame3 *frame, *clone;
