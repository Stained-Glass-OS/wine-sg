+static HRESULT WINAPI d3drm_clipped_visual_Init(IDirect3DRMClippedVisual *iface, IDirect3DRMVisual *visual)
+{
+    struct d3drm_clipped_visual *clipped = impl_from_IDirect3DRMClippedVisual(iface);
+
+    TRACE("iface %p, visual %p.\n", iface, visual);
+
+    if (!visual)
+        return D3DRMERR_BADOBJECT;
+    IDirect3DRMVisual_AddRef(visual);
+    if (clipped->visual)
+        IDirect3DRMVisual_Release(clipped->visual);
+    clipped->visual = visual;
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_clipped_visual_AddPlane(IDirect3DRMClippedVisual *iface, IDirect3DRMFrame3 *reference,
+        D3DVECTOR *point, D3DVECTOR *normal, DWORD flags, DWORD *id)
+{
+    struct d3drm_clipped_visual *clipped = impl_from_IDirect3DRMClippedVisual(iface);
+    struct d3drm_clip_plane *plane;
+
+    TRACE("iface %p, reference %p, point %p, normal %p, flags %#lx, id %p.\n",
+            iface, reference, point, normal, flags, id);
+
+    if (!point || !normal || !id)
+        return D3DRMERR_BADVALUE;
+    if (!d3drm_array_reserve((void **)&clipped->planes, &clipped->planes_size, clipped->nb_planes + 1,
+            sizeof(*clipped->planes)))
+        return E_OUTOFMEMORY;
+    plane = &clipped->planes[clipped->nb_planes++];
+    plane->id = ++clipped->next_id;
+    plane->reference = reference;
+    if (reference)
+        IDirect3DRMFrame3_AddRef(reference);
+    plane->point = *point;
+    plane->normal = *normal;
+    *id = plane->id;
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_clipped_visual_DeletePlane(IDirect3DRMClippedVisual *iface, DWORD id, DWORD flags)
+{
+    struct d3drm_clipped_visual *clipped = impl_from_IDirect3DRMClippedVisual(iface);
+    struct d3drm_clip_plane *plane;
+
+    TRACE("iface %p, id %#lx, flags %#lx.\n", iface, id, flags);
+
+    if (!(plane = clipped_find_plane(clipped, id)))
+        return D3DRMERR_NOTFOUND;
+    if (plane->reference)
+        IDirect3DRMFrame3_Release(plane->reference);
+    memmove(plane, plane + 1, (clipped->planes + clipped->nb_planes - plane - 1) * sizeof(*plane));
+    --clipped->nb_planes;
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_clipped_visual_GetPlaneIDs(IDirect3DRMClippedVisual *iface, DWORD *count, DWORD *ids,
+        DWORD flags)
+{
+    struct d3drm_clipped_visual *clipped = impl_from_IDirect3DRMClippedVisual(iface);
+    SIZE_T i;
+
+    TRACE("iface %p, count %p, ids %p, flags %#lx.\n", iface, count, ids, flags);
+
+    if (!count)
+        return D3DRMERR_BADVALUE;
+    if (ids)
+    {
+        if (*count < clipped->nb_planes)
+        {
+            *count = clipped->nb_planes;
+            return D3DRMERR_BADVALUE;
+        }
+        for (i = 0; i < clipped->nb_planes; ++i)
+            ids[i] = clipped->planes[i].id;
+    }
+    *count = clipped->nb_planes;
+    return D3DRM_OK;
+}
