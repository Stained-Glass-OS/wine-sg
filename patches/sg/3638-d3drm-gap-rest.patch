+/* Searches the directories of the search path for a relative file name. */
+static HRESULT d3drm_search_file(struct d3drm *d3drm, const char *name, char *out)
+{
+    const char *dir = d3drm->search_path, *end;
+
+    while (dir && *dir)
+    {
+        size_t len;
+
+        end = strchr(dir, ';');
+        len = end ? end - dir : strlen(dir);
+        if (len && len + 1 + strlen(name) < MAX_PATH)
+        {
+            memcpy(out, dir, len);
+            if (out[len - 1] != '\\' && out[len - 1] != '/')
+                out[len++] = '\\';
+            strcpy(out + len, name);
+            if (GetFileAttributesA(out) != INVALID_FILE_ATTRIBUTES)
+                return S_OK;
+        }
+        dir = end ? end + 1 : NULL;
+    }
+    return D3DRMERR_FILENOTFOUND;
+}
+
+/* Reads an IStream into memory. The buffer is freed by d3drm_free_load_memory(). */
+static HRESULT d3drm_stream_to_memory(void *source, DXFILELOADMEMORY *mem)
+{
+    IStream *stream = source;
+    SIZE_T size = 0, capacity = 0;
+    BYTE *data = NULL;
+    HRESULT hr;
+
+    if (!stream)
+        return D3DRMERR_BADVALUE;
+    for (;;)
+    {
+        ULONG got = 0;
+
+        if (!d3drm_array_reserve((void **)&data, &capacity, size + 4096, 1))
+        {
+            free(data);
+            return E_OUTOFMEMORY;
+        }
+        hr = IStream_Read(stream, data + size, 4096, &got);
+        size += got;
+        if (FAILED(hr))
+        {
+            free(data);
+            return hr;
+        }
+        if (!got)
+            break;
+    }
+    mem->lpMemory = data;
+    mem->dSize = size;
+    return D3DRM_OK;
+}
+
+typedef HRESULT (WINAPI *url_download_fn)(IUnknown *caller, const char *url, char *file, DWORD size, DWORD reserved,
+        void *cb);
+
+/* URLs are fetched into the cache (file: URLs and http), then read as files. */
+static HRESULT d3drm_url_to_file(const char *url, char *path)
+{
+    static const char file_scheme[] = "file:///";
+    url_download_fn download;
+    HMODULE urlmon;
+    HRESULT hr;
+
+    if (!url)
+        return D3DRMERR_BADVALUE;
+    if (!_strnicmp(url, file_scheme, sizeof(file_scheme) - 1) && strlen(url) - 8 < MAX_PATH)
+    {
+        strcpy(path, url + sizeof(file_scheme) - 1);
+        return D3DRM_OK;
+    }
+    if (!(urlmon = LoadLibraryA("urlmon.dll")) || !(download = (url_download_fn)GetProcAddress(urlmon,
+            "URLDownloadToCacheFileA")))
+        return D3DRMERR_LIBRARYNOTFOUND;
+    hr = download(NULL, url, path, MAX_PATH, 0, NULL);
+    FreeLibrary(urlmon);
+    return FAILED(hr) ? D3DRMERR_FILENOTFOUND : D3DRM_OK;
+}
