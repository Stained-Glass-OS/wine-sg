+static HRESULT WINAPI d3drm_pmesh_GetFaceDetailRange(IDirect3DRMProgressiveMesh *iface, DWORD *min_detail,
+        DWORD *max_detail)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
