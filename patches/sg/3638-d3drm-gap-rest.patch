+    EnterCriticalSection(&registry_cs);
+    LIST_FOR_EACH_ENTRY(object, &registry, struct d3drm_object, registry_entry)
+    {
+        if (object->factory == factory)
+            object->factory = NULL;
+    }
+    LeaveCriticalSection(&registry_cs);
+}
+
+/* Takes a counted snapshot of the live objects of one factory. */
+static IDirect3DRMObject **registry_snapshot(IDirect3DRM *factory, const char *name, SIZE_T *count)
+{
+    IDirect3DRMObject **objects = NULL;
+    struct d3drm_object *object;
+    SIZE_T size = 0;
+
+    *count = 0;
+    EnterCriticalSection(&registry_cs);
+    LIST_FOR_EACH_ENTRY(object, &registry, struct d3drm_object, registry_entry)
+    {
+        if (object->factory != factory)
+            continue;
+        if (name && (!object->name || strcmp(object->name, name)))
+            continue;
+        if (!d3drm_array_reserve((void **)&objects, &size, *count + 1, sizeof(*objects)))
+            break;
+        IDirect3DRMObject_AddRef(object->registry_iface);
+        objects[(*count)++] = object->registry_iface;
+    }
+    LeaveCriticalSection(&registry_cs);
+    return objects;
+}
+
+HRESULT d3drm_registry_find(IDirect3DRM *factory, const char *name, IDirect3DRMObject **out)
+{
+    IDirect3DRMObject **objects;
+    SIZE_T count, i;
+
+    *out = NULL;
+    if (!name)
+        return D3DRMERR_BADVALUE;
+    objects = registry_snapshot(factory, name, &count);
+#ifdef SG_MUTANT_DRM_REG
+    count = 0;
+#endif
+    if (!count)
+    {
+        free(objects);
+        return D3DRMERR_NOTFOUND;
+    }
+    *out = objects[0];
+    for (i = 1; i < count; ++i)
+        IDirect3DRMObject_Release(objects[i]);
+    free(objects);
+    return D3DRM_OK;
+}
+
+HRESULT d3drm_registry_enumerate(IDirect3DRM *factory, D3DRMOBJECTCALLBACK cb, void *ctx)
+{
+    IDirect3DRMObject **objects;
+    SIZE_T count, i;
+
+    if (!cb)
+        return D3DRMERR_BADVALUE;
+    objects = registry_snapshot(factory, NULL, &count);
+    for (i = 0; i < count; ++i)
+    {
+        cb(objects[i], ctx);
+        IDirect3DRMObject_Release(objects[i]);
+    }
+    free(objects);
+    return D3DRM_OK;
+}
+
+void d3drm_registry_tick(IDirect3DRM *factory, float tick)
+{
+    IDirect3DRMObject **objects;
+    SIZE_T count, i;
+
+    objects = registry_snapshot(factory, NULL, &count);
+    /* the root frames get Move() first (it recurses), then every device is updated */
+    for (i = 0; i < count; ++i)
+    {
+        IDirect3DRMFrame3 *frame;
+        IDirect3DRMFrame3 *parent;
+
+        if (FAILED(IDirect3DRMObject_QueryInterface(objects[i], &IID_IDirect3DRMFrame3, (void **)&frame)))
+            continue;
+        if (SUCCEEDED(IDirect3DRMFrame3_GetParent(frame, &parent)) && parent)
+            IDirect3DRMFrame3_Release(parent);
+        else
+            IDirect3DRMFrame3_Move(frame, tick);
+        IDirect3DRMFrame3_Release(frame);
+    }
+    for (i = 0; i < count; ++i)
+    {
+        IDirect3DRMDevice3 *device;
+
+        if (SUCCEEDED(IDirect3DRMObject_QueryInterface(objects[i], &IID_IDirect3DRMDevice3, (void **)&device)))
+        {
+            IDirect3DRMDevice3_Update(device);
+            IDirect3DRMDevice3_Release(device);
+        }
+        IDirect3DRMObject_Release(objects[i]);
+    }
+    free(objects);
+}
