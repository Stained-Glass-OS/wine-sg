+static void test_sg_gap2_scene(void)
+{
+    IDirect3DRMMeshBuilder3 *builder, *cube;
+    IDirect3DRMShadow2 *shadow;
+    IDirect3DRMClippedVisual *clipped;
+    IDirect3DRMUserVisual *user;
+    IDirect3DRMFrame3 *holder, *ground;
+    IDirect3DRMLight *light;
+    IDirect3DRMViewportArray *viewports;
+    IDirect3DRMViewport *vp1;
+    IDirect3DRMDeviceArray *devices;
+    IDirect3DRMViewport2 *vp_clone;
+    IDirect3DRM *factory1;
+    D3DVECTOR point, normal;
+    D3DCOLOR color;
+    HRESULT hr;
+    struct sg_scene s;
+    DDPIXELFORMAT pf;
+    DWORD id;
+
+    sg_scene_init(&s);
+
+    /* the device */
+    ok(IDirect3DRMDevice3_GetColorModel(s.device) == D3DCOLOR_RGB, "Got color model %lu.\n",
+            IDirect3DRMDevice3_GetColorModel(s.device));
+    hr = IDirect3DRMDevice3_Init(s.device, 640, 480);
+    ok(hr == D3DRMERR_BADDEVICE, "Got hr %#lx.\n", hr);
+    hr = IDirect3DRMDevice3_GetViewports(s.device, &viewports);
+    ok(hr == D3DRM_OK && IDirect3DRMViewportArray_GetSize(viewports) == 1, "Got hr %#lx.\n", hr);
+    IDirect3DRMViewportArray_GetElement(viewports, 0, &vp1);
+    {
+        IDirect3DRMViewport2 *vp2;
+
+        IDirect3DRMViewport_QueryInterface(vp1, &IID_IDirect3DRMViewport2, (void **)&vp2);
+        ok(vp2 == s.viewport, "Got viewport %p, expected %p.\n", vp2, s.viewport);
+        IDirect3DRMViewport2_Release(vp2);
+    }
+    IDirect3DRMViewport_Release(vp1);
+    IDirect3DRMViewportArray_Release(viewports);
+    IDirect3DRM3_QueryInterface(s.d3drm, &IID_IDirect3DRM, (void **)&factory1);
+    hr = IDirect3DRM_GetDevices(factory1, &devices);
+    ok(hr == D3DRM_OK && IDirect3DRMDeviceArray_GetSize(devices) == 1, "Got hr %#lx.\n", hr);
+    IDirect3DRMDeviceArray_Release(devices);
+    IDirect3DRM_Release(factory1);
+
+    memset(&pf, 0, sizeof(pf));
+    hr = IDirect3DRMDevice3_FindPreferredTextureFormat(s.device, DDBD_16 | DDBD_32, 0, &pf);
+    ok(hr == D3DRM_OK || hr == D3DRMERR_TEXTUREFORMATNOTFOUND, "Got hr %#lx.\n", hr);
+    {
+        DWORD value;
+
+        hr = IDirect3DRMDevice3_GetStateChangeOptions(s.device, D3DRMSTATECHANGE_RENDER, D3DRENDERSTATE_ZENABLE, &value);
+        ok(hr == D3DRM_OK && value == D3DRMSTATECHANGE_NONVOLATILE, "Got hr %#lx, %#lx.\n", hr, value);
+        hr = IDirect3DRMDevice3_SetStateChangeOptions(s.device, D3DRMSTATECHANGE_RENDER, D3DRENDERSTATE_ZENABLE,
+                D3DRMSTATECHANGE_VOLATILE);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        IDirect3DRMDevice3_GetStateChangeOptions(s.device, D3DRMSTATECHANGE_RENDER, D3DRENDERSTATE_ZENABLE, &value);
+        ok(value == D3DRMSTATECHANGE_VOLATILE, "Got %#lx.\n", value);
+        hr = IDirect3DRMDevice3_RenderStateChange(s.device, D3DRENDERSTATE_ZENABLE, TRUE, 0);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        hr = IDirect3DRMDevice3_GetStateChangeOptions(s.device, 0x1000, 0, &value);
+        ok(hr == D3DRMERR_BADVALUE, "Got hr %#lx.\n", hr);
+    }
+    {
+        IDirect3DRMDevice3 *dclone;
+
+        hr = IDirect3DRMDevice3_Clone(s.device, NULL, &IID_IDirect3DRMDevice3, (void **)&dclone);
+        ok(hr == D3DRM_OK && dclone != s.device, "Got hr %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+            IDirect3DRMDevice3_Release(dclone);
+    }
+
+    /* the viewport */
+    hr = s.viewport->lpVtbl->Clone(s.viewport, NULL, &IID_IDirect3DRMViewport2, (void **)&vp_clone);
+    ok(hr == D3DRM_OK && vp_clone != s.viewport, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(IDirect3DRMViewport2_GetFront(vp_clone) == IDirect3DRMViewport2_GetFront(s.viewport), "Fronts differ.\n");
+        IDirect3DRMViewport2_Release(vp_clone);
+    }
+    s.viewport->lpVtbl->ForceUpdate(s.viewport, 100, 100, 200, 200);
+    sg_clear(&s, 0.0f, 0.0f, 1.0f);
+    IDirect3DRMViewport2_Clear(s.viewport, D3DRMCLEAR_DIRTYRECTS);
+    color = get_surface_color(s.surface, 150, 150);
+    ok(compare_color(color, 0x00000000, 4) || compare_color(color, 0x000000ff, 4), "Got color %08lx.\n", color);
+    color = get_surface_color(s.surface, 20, 20);
+    ok(compare_color(color, 0x000000ff, 2), "Outside the dirty area was cleared, color %08lx.\n", color);
+
+    /* a user visual is asked and then drawn */
+    sg_user_cansee = sg_user_render = 0;
+    IDirect3DRM3_CreateUserVisual(s.d3drm, sg_user_visual_cb, &sg_user_cansee, &user);
+    IDirect3DRM3_CreateFrame(s.d3drm, s.scene, &holder);
+    IDirect3DRMFrame3_AddVisual(holder, (IUnknown *)user);
+    sg_add_light(&s, D3DRMLIGHT_DIRECTIONAL, 1.0f);
+    hr = IDirect3DRMViewport2_Render(s.viewport, s.scene);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    ok(sg_user_cansee == 1 && sg_user_render == 1, "Got %d CANSEE and %d RENDER calls.\n", sg_user_cansee, sg_user_render);
+    IDirect3DRMFrame3_DeleteVisual(holder, (IUnknown *)user);
+    IDirect3DRMUserVisual_Release(user);
+
+    /* a clipped triangle shows the half the plane keeps */
+    sg_clear(&s, 0.0f, 0.0f, 1.0f);
+    builder = sg_add_triangle(&s, holder, 5.0f, 1.0f, 1.0f, 0.0f, 0.0f, NULL);
+    IDirect3DRMFrame3_DeleteVisual(holder, (IUnknown *)builder);
+    hr = IDirect3DRM3_CreateClippedVisual(s.d3drm, (IDirect3DRMVisual *)builder, &clipped);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    point.x = 0.0f; point.y = 0.0f; point.z = 0.0f;
+    normal.x = 1.0f; normal.y = 0.0f; normal.z = 0.0f;
+    hr = IDirect3DRMClippedVisual_AddPlane(clipped, NULL, &point, &normal, 0, &id);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    IDirect3DRMFrame3_AddVisual(holder, (IUnknown *)clipped);
+    hr = IDirect3DRMViewport2_Render(s.viewport, s.scene);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    color = get_surface_color(s.surface, 400, 330);
+    ok(compare_color(color, 0x00ff0000, 4), "The kept half is missing, color %08lx.\n", color);
+    color = get_surface_color(s.surface, 240, 330);
+    ok(compare_color(color, 0x000000ff, 2), "The clipped half is drawn, color %08lx.\n", color);
+    IDirect3DRMFrame3_DeleteVisual(holder, (IUnknown *)clipped);
+    IDirect3DRMClippedVisual_Release(clipped);
+
+    /* a shadow falls on a plane, black */
+    sg_clear(&s, 0.0f, 0.0f, 1.0f);
+    IDirect3DRMFrame3_Release(holder);
+    IDirect3DRM3_CreateFrame(s.d3drm, s.scene, &ground);
+    cube = sg_add_triangle(&s, ground, 4.0f, 0.5f, 0.0f, 1.0f, 0.0f, NULL);
+    IDirect3DRMFrame3_DeleteVisual(ground, (IUnknown *)cube);
+    IDirect3DRM3_CreateLightRGB(s.d3drm, D3DRMLIGHT_DIRECTIONAL, 1.0f, 1.0f, 1.0f, &light);
+    IDirect3DRMFrame3_AddLight(ground, light);
+    /* the light shines straight down the z axis, the plane is z = 6 */
+    hr = IDirect3DRM3_CreateShadow(s.d3drm, (IUnknown *)cube, light, 0.0f, 0.0f, 6.0f, 0.0f, 0.0f, -1.0f, &shadow);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    IDirect3DRMFrame3_AddVisual(ground, (IUnknown *)shadow);
+    hr = IDirect3DRMViewport2_Render(s.viewport, s.scene);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    color = get_surface_color(s.surface, 320, 270);
+    ok(compare_color(color, 0x00000000, 6), "The shadow is not drawn, color %08lx.\n", color);
+    color = get_surface_color(s.surface, 20, 20);
+    ok(compare_color(color, 0x000000ff, 2), "Got color %08lx.\n", color);
+    IDirect3DRMFrame3_DeleteVisual(ground, (IUnknown *)shadow);
+    IDirect3DRMShadow2_Release(shadow);
+    IDirect3DRMLight_Release(light);
+    IDirect3DRMMeshBuilder3_Release(cube);
+    IDirect3DRMMeshBuilder3_Release(builder);
+    IDirect3DRMFrame3_Release(ground);
+
+    /* a builder with rendering disabled is not drawn */
+    sg_clear(&s, 0.0f, 0.0f, 1.0f);
+    IDirect3DRM3_CreateFrame(s.d3drm, s.scene, &holder);
+    builder = sg_add_triangle(&s, holder, 5.0f, 1.0f, 1.0f, 0.0f, 0.0f, NULL);
+    IDirect3DRMViewport2_Render(s.viewport, s.scene);
+    color = get_surface_color(s.surface, 320, 360);
+    ok(compare_color(color, 0x00ff0000, 4), "Got color %08lx.\n", color);
+    IDirect3DRMMeshBuilder3_Enable(builder, D3DRMMESHBUILDER_PICKENABLE);
+    sg_clear(&s, 0.0f, 0.0f, 1.0f);
+    IDirect3DRMViewport2_Render(s.viewport, s.scene);
+    color = get_surface_color(s.surface, 320, 360);
+    ok(compare_color(color, 0x000000ff, 2), "A builder without RENDERENABLE was drawn, color %08lx.\n", color);
+    IDirect3DRMMeshBuilder3_Release(builder);
+    IDirect3DRMFrame3_Release(holder);
+
+    sg_scene_cleanup(&s);
+}
