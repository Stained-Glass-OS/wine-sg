+/* The meshes of the frame and of everything below it, put in the space of the frame. */
+static HRESULT mesh_builder_add_frame_tree(struct d3drm_mesh_builder *mb, struct d3drm_frame *frame,
+        const struct d3drm_matrix *m)
+{
+    SIZE_T i;
+    HRESULT hr;
+
+    for (i = 0; i < frame->nb_visuals; ++i)
+    {
+        struct d3drm_mesh_builder *tmp;
+        IDirect3DRMMeshBuilder3 *src;
+        IDirect3DRMMesh *mesh;
+
+        if (FAILED(d3drm_mesh_builder_create(&tmp, mb->d3drm)))
+            return E_OUTOFMEMORY;
+        hr = D3DRMERR_NOTFOUND;
+        if (SUCCEEDED(IDirect3DRMVisual_QueryInterface(frame->visuals[i], &IID_IDirect3DRMMeshBuilder3,
+                (void **)&src)))
+        {
+            hr = mesh_builder_add_builder(tmp, impl_from_IDirect3DRMMeshBuilder3(src));
+            IDirect3DRMMeshBuilder3_Release(src);
+        }
+        else if (SUCCEEDED(IDirect3DRMVisual_QueryInterface(frame->visuals[i], &IID_IDirect3DRMMesh, (void **)&mesh)))
+        {
+            hr = mesh_builder_add_mesh(tmp, mesh);
+            IDirect3DRMMesh_Release(mesh);
+        }
+        if (SUCCEEDED(hr))
+        {
+            mesh_builder_transform(tmp, m);
+            hr = mesh_builder_add_builder(mb, tmp);
+        }
+        IDirect3DRMMeshBuilder3_Release(&tmp->IDirect3DRMMeshBuilder3_iface);
+        if (FAILED(hr) && hr != D3DRMERR_NOTFOUND)
+            return hr;
+    }
+    for (i = 0; i < frame->nb_children; ++i)
+    {
+        struct d3drm_frame *child = unsafe_impl_from_IDirect3DRMFrame3(frame->children[i]);
+        struct d3drm_matrix cm;
+
+        if (!child)
+            continue;
+        d3drm_matrix_mul(&cm, &child->transform, m);
+        if (FAILED(hr = mesh_builder_add_frame_tree(mb, child, &cm)))
+            return hr;
+    }
+    return D3DRM_OK;
+}
+
+static HRESULT mesh_builder_add_frame(struct d3drm_mesh_builder *mb, IUnknown *iface)
+{
+    IDirect3DRMFrame3 *frame3;
+    struct d3drm_matrix identity_m;
+    HRESULT hr;
+
+    if (!iface)
+        return D3DRMERR_BADOBJECT;
+    if (FAILED(IUnknown_QueryInterface(iface, &IID_IDirect3DRMFrame3, (void **)&frame3)))
+        return D3DRMERR_BADOBJECT;
+    memset(&identity_m, 0, sizeof(identity_m));
+    identity_m._11 = identity_m._22 = identity_m._33 = identity_m._44 = 1.0f;
+    hr = mesh_builder_add_frame_tree(mb, unsafe_impl_from_IDirect3DRMFrame3(frame3), &identity_m);
+    IDirect3DRMFrame3_Release(frame3);
+    return hr;
+}
