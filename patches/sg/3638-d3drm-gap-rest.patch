+static HRESULT WINAPI d3drm_animation_set1_Clone(IDirect3DRMAnimationSet *iface, IUnknown *outer, REFIID iid,
+        void **out);
+
+static HRESULT d3drm_animation_set_clone(struct d3drm_animation_set *set, IUnknown *outer, REFIID iid, void **out)
+{
+    struct d3drm_animation_set *clone;
+    HRESULT hr;
+    SIZE_T i;
+
+    if (out)
+        *out = NULL;
+    if (outer)
+        return CLASS_E_NOAGGREGATION;
+    if (FAILED(hr = d3drm_animation_set_create(set->d3drm, &clone)))
+        return hr;
+    /* the animations are copied too, so that the clone can be driven separately */
+    for (i = 0; i < set->nb_animations; ++i)
+    {
+        IDirect3DRMAnimation2 *copy;
+
+        if (FAILED(hr = IDirect3DRMAnimation2_Clone(set->animations[i], NULL, &IID_IDirect3DRMAnimation2,
+                (void **)&copy)))
+        {
+            IDirect3DRMAnimationSet_Release(&clone->IDirect3DRMAnimationSet_iface);
+            return hr;
+        }
+        hr = d3drm_animation_set_add(clone, copy);
+        IDirect3DRMAnimation2_Release(copy);
+        if (FAILED(hr))
+        {
+            IDirect3DRMAnimationSet_Release(&clone->IDirect3DRMAnimationSet_iface);
+            return hr;
+        }
+    }
+    return object_clone_result((IUnknown *)&clone->IDirect3DRMAnimationSet_iface, outer, iid, out);
+}
+
+static HRESULT WINAPI d3drm_animation_set1_Clone(IDirect3DRMAnimationSet *iface, IUnknown *outer, REFIID iid,
+        void **out)
+{
+    TRACE("iface %p, outer %p, iid %s, out %p.\n", iface, outer, debugstr_guid(iid), out);
+    return d3drm_animation_set_clone(impl_from_IDirect3DRMAnimationSet(iface), outer, iid, out);
+}
