+
+static HRESULT WINAPI d3drm_pmesh_GetDetail(IDirect3DRMProgressiveMesh *iface, D3DVALUE *detail)
+{
+    TRACE("iface %p, detail %p.\n", iface, detail);
+
+    if (!detail)
+        return D3DRMERR_BADVALUE;
+    *detail = impl_from_IDirect3DRMProgressiveMesh(iface)->detail;
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_pmesh_SetDetail(IDirect3DRMProgressiveMesh *iface, D3DVALUE detail)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, detail %.8e.\n", iface, detail);
+
+    if (detail < 0.0f || detail > 1.0f)
+        return D3DRMERR_BADVALUE;
+    pmesh->detail = max(detail, pmesh->min_render_detail);
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_pmesh_RegisterEvents(IDirect3DRMProgressiveMesh *iface, HANDLE event, DWORD flags,
+        DWORD reserved)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, event %p, flags %#lx, reserved %#lx.\n", iface, event, flags, reserved);
+
+    if (!event || (flags & ~(D3DRMPMESHEVENT_BASEMESH | D3DRMPMESHEVENT_COMPLETE)))
+        return D3DRMERR_BADVALUE;
+    pmesh->event = event;
+    pmesh->event_flags = flags;
+    pmesh_signal(pmesh);
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_pmesh_CreateMesh(IDirect3DRMProgressiveMesh *iface, IDirect3DRMMesh **mesh)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, mesh %p.\n", iface, mesh);
+
+    if (!mesh)
+        return D3DRMERR_BADVALUE;
+    *mesh = NULL;
+    if (!pmesh->builder)
+        return D3DRMERR_BADOBJECT;
+    return IDirect3DRMMeshBuilder3_CreateMesh(pmesh->builder, mesh);
+}
+
+static HRESULT WINAPI d3drm_pmesh_Duplicate(IDirect3DRMProgressiveMesh *iface, IDirect3DRMProgressiveMesh **out)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface), *copy;
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return D3DRMERR_BADVALUE;
+    *out = NULL;
+    if (FAILED(hr = d3drm_progressive_mesh_create(pmesh->d3drm, &copy)))
+        return hr;
+    if (pmesh->builder && FAILED(hr = IDirect3DRMMeshBuilder3_Clone(pmesh->builder, NULL,
+            &IID_IDirect3DRMMeshBuilder3, (void **)&copy->builder)))
+    {
+        IDirect3DRMProgressiveMesh_Release(&copy->IDirect3DRMProgressiveMesh_iface);
+        return hr;
+    }
+    copy->detail = pmesh->detail;
+    copy->min_render_detail = pmesh->min_render_detail;
+    copy->flags = pmesh->flags;
+    copy->load_result = pmesh->load_result;
+    *out = &copy->IDirect3DRMProgressiveMesh_iface;
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_pmesh_GetBox(IDirect3DRMProgressiveMesh *iface, D3DRMBOX *box)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, box %p.\n", iface, box);
+
+    if (!box)
+        return D3DRMERR_BADVALUE;
+    if (!pmesh->builder)
+        return D3DRMERR_BADOBJECT;
+    return IDirect3DRMMeshBuilder3_GetBox(pmesh->builder, box);
+}
+
+static HRESULT WINAPI d3drm_pmesh_SetQuality(IDirect3DRMProgressiveMesh *iface, D3DRMRENDERQUALITY quality)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, quality %#lx.\n", iface, quality);
+
+    if (!pmesh->builder)
+        return D3DRMERR_BADOBJECT;
+    return IDirect3DRMMeshBuilder3_SetQuality(pmesh->builder, quality);
+}
+
+static HRESULT WINAPI d3drm_pmesh_GetQuality(IDirect3DRMProgressiveMesh *iface, D3DRMRENDERQUALITY *quality)
+{
+    struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+
+    TRACE("iface %p, quality %p.\n", iface, quality);
+
+    if (!quality)
+        return D3DRMERR_BADVALUE;
+    if (!pmesh->builder)
+        return D3DRMERR_BADOBJECT;
+    *quality = IDirect3DRMMeshBuilder3_GetQuality(pmesh->builder);
+    return D3DRM_OK;
+}
+
+static const IDirect3DRMProgressiveMeshVtbl d3drm_pmesh_vtbl =
+{
+    d3drm_pmesh_QueryInterface,
+    d3drm_pmesh_AddRef,
+    d3drm_pmesh_Release,
+    d3drm_pmesh_Clone,
+    d3drm_pmesh_AddDestroyCallback,
+    d3drm_pmesh_DeleteDestroyCallback,
+    d3drm_pmesh_SetAppData,
+    d3drm_pmesh_GetAppData,
+    d3drm_pmesh_SetName,
+    d3drm_pmesh_GetName,
+    d3drm_pmesh_GetClassName,
+    d3drm_pmesh_Load,
+    d3drm_pmesh_GetLoadStatus,
+    d3drm_pmesh_SetMinRenderDetail,
+    d3drm_pmesh_Abort,
+    d3drm_pmesh_GetFaceDetail,
+    d3drm_pmesh_GetVertexDetail,
+    d3drm_pmesh_SetFaceDetail,
+    d3drm_pmesh_SetVertexDetail,
+    d3drm_pmesh_GetFaceDetailRange,
+    d3drm_pmesh_GetVertexDetailRange,
+    d3drm_pmesh_GetDetail,
+    d3drm_pmesh_SetDetail,
+    d3drm_pmesh_RegisterEvents,
+    d3drm_pmesh_CreateMesh,
+    d3drm_pmesh_Duplicate,
+    d3drm_pmesh_GetBox,
+    d3drm_pmesh_SetQuality,
+    d3drm_pmesh_GetQuality,
+};
+
+HRESULT d3drm_progressive_mesh_create(IDirect3DRM *d3drm, struct d3drm_progressive_mesh **out)
+{
+    static const char classname[] = "ProgressiveMesh";
+    struct d3drm_progressive_mesh *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    object->IDirect3DRMProgressiveMesh_iface.lpVtbl = &d3drm_pmesh_vtbl;
+    object->ref = 1;
+    object->d3drm = d3drm;
+    object->detail = 1.0f;
+    IDirect3DRM_AddRef(d3drm);
+    d3drm_object_init(&object->obj, classname);
+    d3drm_object_register(&object->obj, (IDirect3DRMObject *)&object->IDirect3DRMProgressiveMesh_iface, d3drm);
+    *out = object;
+    return D3DRM_OK;
+}
