+        {
+            IDirect3DRMFrame3_Release(&clone->IDirect3DRMFrame3_iface);
+            return hr;
+        }
+    }
+    *out = clone;
+    return D3DRM_OK;
+}
+
+static HRESULT d3drm_frame_clone(struct d3drm_frame *frame, IUnknown *outer, REFIID iid, void **out)
+{
+    struct d3drm_frame *clone;
+    HRESULT hr;
+
+    if (!out)
+        return D3DRMERR_BADVALUE;
+    *out = NULL;
+    if (outer)
+        return CLASS_E_NOAGGREGATION;
+    if (FAILED(hr = d3drm_frame_clone_tree(frame, &clone)))
+        return hr;
+    hr = IDirect3DRMFrame3_QueryInterface(&clone->IDirect3DRMFrame3_iface, iid, out);
+    IDirect3DRMFrame3_Release(&clone->IDirect3DRMFrame3_iface);
+    return hr;
+}
+
+static HRESULT d3drm_frame_load(struct d3drm_frame *frame, void *source, void *name, D3DRMLOADOPTIONS flags,
+        D3DRMLOADTEXTURECALLBACK cb, void *ctx)
+{
+    IDirect3DRM3 *d3drm3;
+    HRESULT hr;
+
+    if (FAILED(hr = IDirect3DRM_QueryInterface(frame->d3drm, &IID_IDirect3DRM3, (void **)&d3drm3)))
+        return hr;
+    /* the objects found become children (frames, meshes, lights) of this frame */
+    hr = IDirect3DRM3_Load(d3drm3, source, name, NULL, 0, flags, NULL, NULL, cb, ctx, &frame->IDirect3DRMFrame3_iface);
+    IDirect3DRM3_Release(d3drm3);
+    return hr;
+}
+
+struct hierarchy_box
+{
+    D3DVECTOR min, max;
+    BOOL valid;
+};
+
+static void hierarchy_box_add(struct hierarchy_box *hb, const D3DRMBOX *box, const struct d3drm_matrix *m)
+{
+    unsigned int i;
+
+    for (i = 0; i < 8; ++i)
+    {
+        float x = i & 1 ? box->max.x : box->min.x, y = i & 2 ? box->max.y : box->min.y,
+                z = i & 4 ? box->max.z : box->min.z;
+        D3DVECTOR v;
+
+        v.x = x * m->_11 + y * m->_21 + z * m->_31 + m->_41;
+        v.y = x * m->_12 + y * m->_22 + z * m->_32 + m->_42;
+        v.z = x * m->_13 + y * m->_23 + z * m->_33 + m->_43;
+        if (!hb->valid)
+        {
+            hb->min = hb->max = v;
+            hb->valid = TRUE;
+            continue;
+        }
+        hb->min.x = min(hb->min.x, v.x);
+        hb->min.y = min(hb->min.y, v.y);
+        hb->min.z = min(hb->min.z, v.z);
+        hb->max.x = max(hb->max.x, v.x);
+        hb->max.y = max(hb->max.y, v.y);
+        hb->max.z = max(hb->max.z, v.z);
+    }
+}
+
+/* m takes the space of frame into the space the box is reported in. */
+static void frame_hierarchy_box(struct d3drm_frame *frame, const struct d3drm_matrix *m, struct hierarchy_box *hb)
+{
+    SIZE_T i;
+
+    if (frame->box_enable)
+        hierarchy_box_add(hb, &frame->box, m);
+    for (i = 0; i < frame->nb_visuals; ++i)
+    {
+        IDirect3DRMMeshBuilder3 *builder;
+        IDirect3DRMMesh *mesh;
+        D3DRMBOX box;
+
+        if (SUCCEEDED(IDirect3DRMVisual_QueryInterface(frame->visuals[i], &IID_IDirect3DRMMeshBuilder3,
+                (void **)&builder)))
+        {
+            if (SUCCEEDED(IDirect3DRMMeshBuilder3_GetBox(builder, &box)))
+                hierarchy_box_add(hb, &box, m);
+            IDirect3DRMMeshBuilder3_Release(builder);
+        }
+        else if (SUCCEEDED(IDirect3DRMVisual_QueryInterface(frame->visuals[i], &IID_IDirect3DRMMesh,
+                (void **)&mesh)))
+        {
+            if (SUCCEEDED(IDirect3DRMMesh_GetBox(mesh, &box)))
+                hierarchy_box_add(hb, &box, m);
+            IDirect3DRMMesh_Release(mesh);
+        }
+    }
+    for (i = 0; i < frame->nb_children; ++i)
+    {
+        struct d3drm_frame *child = unsafe_impl_from_IDirect3DRMFrame3(frame->children[i]);
+        struct d3drm_matrix cm;
+
+        if (!child)
+            continue;
+        d3drm_matrix_multiply_affine(&cm, &child->transform, m);
+        frame_hierarchy_box(child, &cm, hb);
+    }
+}
+
+static HRESULT d3drm_frame_get_hierarchy_box(struct d3drm_frame *frame, D3DRMBOX *box)
+{
+    struct hierarchy_box hb;
+    struct d3drm_matrix identity_m;
+
+    if (!box)
+        return D3DRMERR_BADVALUE;
+    memset(&hb, 0, sizeof(hb));
+    memset(&identity_m, 0, sizeof(identity_m));
+    identity_m._11 = identity_m._22 = identity_m._33 = identity_m._44 = 1.0f;
+    frame_hierarchy_box(frame, &identity_m, &hb);
+#ifdef SG_MUTANT_DRM_HBOX
+    hb.valid = FALSE;
+#endif
+    /* nothing with a size in the hierarchy: an empty box at the origin */
+    if (hb.valid)
+    {
+        box->min = hb.min;
+        box->max = hb.max;
+    }
+    else
+        memset(box, 0, sizeof(*box));
+    return D3DRM_OK;
+}
