+HRESULT d3drm_shadow_create(IDirect3DRM *d3drm, IUnknown *visual, IDirect3DRMLight *light,
+        const D3DVECTOR *point, const D3DVECTOR *normal, struct d3drm_shadow **out)
+{
+    static const char classname[] = "Shadow";
+    struct d3drm_shadow *object;
+    HRESULT hr;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    object->IDirect3DRMShadow_iface.lpVtbl = &d3drm_shadow1_vtbl;
+    object->IDirect3DRMShadow2_iface.lpVtbl = &d3drm_shadow2_vtbl;
+    object->ref = 1;
+    object->d3drm = d3drm;
+    IDirect3DRM_AddRef(d3drm);
+    d3drm_object_init(&object->obj, classname);
+    d3drm_object_register(&object->obj, (IDirect3DRMObject *)&object->IDirect3DRMShadow_iface, d3drm);
+
+    if (visual || light)
+    {
+        if (FAILED(hr = d3drm_shadow_init(object, visual, light, point->x, point->y, point->z,
+                normal->x, normal->y, normal->z)))
+        {
+            d3drm_shadow1_Release(&object->IDirect3DRMShadow_iface);
+            return hr;
+        }
+    }
+    *out = object;
+    return D3DRM_OK;
+}
