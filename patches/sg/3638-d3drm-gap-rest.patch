+#define OBJECT_METHODS(prefix, type, itype, member) \
+static HRESULT WINAPI prefix##_AddDestroyCallback(itype *iface, D3DRMOBJECTCALLBACK cb, void *ctx) \
+{ \
+    type *object = CONTAINING_RECORD(iface, type, member); \
+    TRACE("iface %p, cb %p, ctx %p.\n", iface, cb, ctx); \
+    return d3drm_object_add_destroy_callback(&object->obj, cb, ctx); \
