+/* ----- animation sets ----- */
+
+struct d3drm_animation_array
+{
+    IDirect3DRMAnimationArray IDirect3DRMAnimationArray_iface;
+    LONG ref;
+    SIZE_T count;
+    IDirect3DRMAnimation2 **animations;
+};
+
+static struct d3drm_animation_array *impl_from_IDirect3DRMAnimationArray(IDirect3DRMAnimationArray *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3drm_animation_array, IDirect3DRMAnimationArray_iface);
+}
+
+static HRESULT WINAPI d3drm_animation_array_QueryInterface(IDirect3DRMAnimationArray *iface, REFIID riid,
+        void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IDirect3DRMAnimationArray) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        IDirect3DRMAnimationArray_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(riid));
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI d3drm_animation_array_AddRef(IDirect3DRMAnimationArray *iface)
+{
+    return InterlockedIncrement(&impl_from_IDirect3DRMAnimationArray(iface)->ref);
+}
+
+static ULONG WINAPI d3drm_animation_array_Release(IDirect3DRMAnimationArray *iface)
+{
+    struct d3drm_animation_array *array = impl_from_IDirect3DRMAnimationArray(iface);
+    ULONG refcount = InterlockedDecrement(&array->ref);
+    SIZE_T i;
+
+    if (!refcount)
+    {
+        for (i = 0; i < array->count; ++i)
+            IDirect3DRMAnimation2_Release(array->animations[i]);
+        free(array->animations);
+        free(array);
+    }
+    return refcount;
+}
+
+static DWORD WINAPI d3drm_animation_array_GetSize(IDirect3DRMAnimationArray *iface)
+{
+    return impl_from_IDirect3DRMAnimationArray(iface)->count;
+}
+
+static HRESULT WINAPI d3drm_animation_array_GetElement(IDirect3DRMAnimationArray *iface, DWORD index,
+        IDirect3DRMAnimation2 **animation)
+{
+    struct d3drm_animation_array *array = impl_from_IDirect3DRMAnimationArray(iface);
+
+    TRACE("iface %p, index %lu, animation %p.\n", iface, index, animation);
+
+    if (!animation)
+        return D3DRMERR_BADVALUE;
+    if (index >= array->count)
+    {
+        *animation = NULL;
+        return D3DRMERR_BADVALUE;
+    }
+    *animation = array->animations[index];
+    IDirect3DRMAnimation2_AddRef(*animation);
+    return D3DRM_OK;
+}
+
+static const IDirect3DRMAnimationArrayVtbl d3drm_animation_array_vtbl =
+{
+    d3drm_animation_array_QueryInterface,
+    d3drm_animation_array_AddRef,
+    d3drm_animation_array_Release,
+    d3drm_animation_array_GetSize,
+    d3drm_animation_array_GetElement,
+};
