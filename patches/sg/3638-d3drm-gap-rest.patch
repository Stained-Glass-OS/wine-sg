+{ \
+    type *object = CONTAINING_RECORD(iface, type, member); \
+    TRACE("iface %p, name %s.\n", iface, debugstr_a(name)); \
+    return d3drm_object_set_name(&object->obj, name); \
+} \
+static HRESULT WINAPI prefix##_GetName(itype *iface, DWORD *size, char *name) \
+{ \
+    type *object = CONTAINING_RECORD(iface, type, member); \
+    TRACE("iface %p, size %p, name %p.\n", iface, size, name); \
+    return d3drm_object_get_name(&object->obj, size, name); \
+} \
+static HRESULT WINAPI prefix##_GetClassName(itype *iface, DWORD *size, char *name) \
+{ \
+    type *object = CONTAINING_RECORD(iface, type, member); \
+    TRACE("iface %p, size %p, name %p.\n", iface, size, name); \
