+HRESULT d3drm_animation_set_create(IDirect3DRM *d3drm, struct d3drm_animation_set **out)
+{
+    static const char classname[] = "AnimationSet";
+    struct d3drm_animation_set *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    object->IDirect3DRMAnimationSet_iface.lpVtbl = &d3drm_animation_set1_vtbl;
+    object->IDirect3DRMAnimationSet2_iface.lpVtbl = &d3drm_animation_set2_vtbl;
+    object->ref = 1;
+    object->d3drm = d3drm;
+    IDirect3DRM_AddRef(d3drm);
+    d3drm_object_init(&object->obj, classname);
+    d3drm_object_register(&object->obj, (IDirect3DRMObject *)&object->IDirect3DRMAnimationSet_iface, d3drm);
+    *out = object;
+    return D3DRM_OK;
+}
