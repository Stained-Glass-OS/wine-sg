+struct set_load_ctx
+{
+    struct d3drm_animation_set *set;
+};
+
+static void __cdecl animation_set_load_cb(IDirect3DRMObject *object, REFIID iid, void *arg)
+{
+    struct set_load_ctx *ctx = arg;
+    IDirect3DRMAnimationSet2 *loaded;
+    IDirect3DRMAnimationArray *array;
+    IDirect3DRMAnimation2 *animation;
+    DWORD i;
+
+    if (FAILED(IDirect3DRMObject_QueryInterface(object, &IID_IDirect3DRMAnimationSet2, (void **)&loaded)))
+        return;
+    if (SUCCEEDED(IDirect3DRMAnimationSet2_GetAnimations(loaded, &array)))
+    {
+        for (i = 0; i < IDirect3DRMAnimationArray_GetSize(array); ++i)
+        {
+            if (SUCCEEDED(IDirect3DRMAnimationArray_GetElement(array, i, &animation)))
+            {
+                d3drm_animation_set_add(ctx->set, animation);
+                IDirect3DRMAnimation2_Release(animation);
+            }
+        }
+        IDirect3DRMAnimationArray_Release(array);
+    }
+    IDirect3DRMAnimationSet2_Release(loaded);
+}
+
+/* Loads the animation sets of a file, selected like IDirect3DRM::Load does, into this set. Frames the
+ * animations drive are looked up by name below parent_frame. */
+static HRESULT d3drm_animation_set_load_file(struct d3drm_animation_set *set, void *source, void *object_id,
+        D3DRMLOADOPTIONS flags, IDirect3DRMFrame3 *parent_frame)
+{
+    static const IID *iids[] = { &IID_IDirect3DRMAnimationSet2 };
+    struct set_load_ctx ctx = { set };
+    IDirect3DRM3 *d3drm3;
+    HRESULT hr;
+
+    if (FAILED(hr = IDirect3DRM_QueryInterface(set->d3drm, &IID_IDirect3DRM3, (void **)&d3drm3)))
+        return hr;
+    hr = IDirect3DRM3_Load(d3drm3, source, object_id, (IID **)iids, 1, flags & ~D3DRMLOAD_ASYNCHRONOUS,
+            animation_set_load_cb, &ctx, NULL, NULL, parent_frame);
+    IDirect3DRM3_Release(d3drm3);
+    return hr;
+}
