+static struct d3drm_clip_plane *clipped_find_plane(struct d3drm_clipped_visual *clipped, DWORD id)
+{
+    SIZE_T i;
+
+    for (i = 0; i < clipped->nb_planes; ++i)
+    {
+        if (clipped->planes[i].id == id)
+            return &clipped->planes[i];
+    }
+    return NULL;
+}
+
+static HRESULT WINAPI d3drm_clipped_visual_Clone(IDirect3DRMClippedVisual *iface, IUnknown *outer, REFIID iid,
+        void **out)
+{
+    struct d3drm_clipped_visual *clipped = impl_from_IDirect3DRMClippedVisual(iface), *clone;
+    HRESULT hr;
+    SIZE_T i;
+
+    TRACE("iface %p, outer %p, iid %s, out %p.\n", iface, outer, debugstr_guid(iid), out);
+
+    if (out)
+        *out = NULL;
+    if (outer)
+        return CLASS_E_NOAGGREGATION;
+    if (FAILED(hr = d3drm_clipped_visual_create(clipped->d3drm, clipped->visual, &clone)))
+        return hr;
+    if (clipped->nb_planes && !(clone->planes = calloc(clipped->nb_planes, sizeof(*clone->planes))))
+    {
+        IDirect3DRMClippedVisual_Release(&clone->IDirect3DRMClippedVisual_iface);
+        return E_OUTOFMEMORY;
+    }
+    clone->planes_size = clipped->nb_planes;
+    for (i = 0; i < clipped->nb_planes; ++i)
+    {
+        clone->planes[i] = clipped->planes[i];
+        if (clone->planes[i].reference)
+            IDirect3DRMFrame3_AddRef(clone->planes[i].reference);
+        ++clone->nb_planes;
+    }
+    clone->next_id = clipped->next_id;
+    return object_clone_result((IUnknown *)&clone->IDirect3DRMClippedVisual_iface, outer, iid, out);
+}
