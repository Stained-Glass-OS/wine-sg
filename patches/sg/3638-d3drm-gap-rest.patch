+/* IDirect3DRMDeviceArray */
+struct d3drm_device_array
+{
+    IDirect3DRMDeviceArray IDirect3DRMDeviceArray_iface;
+    LONG ref;
+    SIZE_T count;
+    IDirect3DRMDevice **devices;
+};
+
+static struct d3drm_device_array *impl_from_IDirect3DRMDeviceArray(IDirect3DRMDeviceArray *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3drm_device_array, IDirect3DRMDeviceArray_iface);
+}
+
+static HRESULT WINAPI d3drm_device_array_QueryInterface(IDirect3DRMDeviceArray *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IDirect3DRMDeviceArray) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        IDirect3DRMDeviceArray_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(riid));
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI d3drm_device_array_AddRef(IDirect3DRMDeviceArray *iface)
+{
+    return InterlockedIncrement(&impl_from_IDirect3DRMDeviceArray(iface)->ref);
+}
+
+static ULONG WINAPI d3drm_device_array_Release(IDirect3DRMDeviceArray *iface)
+{
+    struct d3drm_device_array *array = impl_from_IDirect3DRMDeviceArray(iface);
+    ULONG refcount = InterlockedDecrement(&array->ref);
+    SIZE_T i;
+
+    if (!refcount)
+    {
+        for (i = 0; i < array->count; ++i)
+            IDirect3DRMDevice_Release(array->devices[i]);
+        free(array->devices);
+        free(array);
+    }
+    return refcount;
+}
+
+static DWORD WINAPI d3drm_device_array_GetSize(IDirect3DRMDeviceArray *iface)
+{
+    return impl_from_IDirect3DRMDeviceArray(iface)->count;
+}
+
+static HRESULT WINAPI d3drm_device_array_GetElement(IDirect3DRMDeviceArray *iface, DWORD index,
+        IDirect3DRMDevice **device)
+{
+    struct d3drm_device_array *array = impl_from_IDirect3DRMDeviceArray(iface);
+
+    TRACE("iface %p, index %lu, device %p.\n", iface, index, device);
+
+    if (!device)
+        return D3DRMERR_BADVALUE;
+    if (index >= array->count)
+    {
+        *device = NULL;
+        return D3DRMERR_BADVALUE;
+    }
+    *device = array->devices[index];
+    IDirect3DRMDevice_AddRef(*device);
+    return D3DRM_OK;
+}
+
+static const struct IDirect3DRMDeviceArrayVtbl d3drm_device_array_vtbl =
+{
+    d3drm_device_array_QueryInterface,
+    d3drm_device_array_AddRef,
+    d3drm_device_array_Release,
+    d3drm_device_array_GetSize,
+    d3drm_device_array_GetElement,
+};
+
+HRESULT d3drm_registry_devices(IDirect3DRM *factory, IDirect3DRMDeviceArray **out)
+{
+    struct d3drm_device_array *array;
+    IDirect3DRMObject **objects;
+    SIZE_T count, i;
+
+    if (!out)
+        return D3DRMERR_BADVALUE;
+    *out = NULL;
+    if (!(array = calloc(1, sizeof(*array))))
+        return E_OUTOFMEMORY;
+    array->IDirect3DRMDeviceArray_iface.lpVtbl = &d3drm_device_array_vtbl;
+    array->ref = 1;
+
+    objects = registry_snapshot(factory, NULL, &count);
+    if (count && !(array->devices = calloc(count, sizeof(*array->devices))))
+    {
+        for (i = 0; i < count; ++i)
+            IDirect3DRMObject_Release(objects[i]);
+        free(objects);
+        free(array);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; ++i)
+    {
+        IDirect3DRMDevice *device;
+
+        if (SUCCEEDED(IDirect3DRMObject_QueryInterface(objects[i], &IID_IDirect3DRMDevice, (void **)&device)))
+            array->devices[array->count++] = device;
+        IDirect3DRMObject_Release(objects[i]);
+    }
+    free(objects);
+    *out = &array->IDirect3DRMDeviceArray_iface;
+    return D3DRM_OK;
+}
