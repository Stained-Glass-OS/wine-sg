+HRESULT d3drm_clipped_visual_create(IDirect3DRM *d3drm, IDirect3DRMVisual *visual,
+        struct d3drm_clipped_visual **out)
+{
+    static const char classname[] = "ClippedVisual";
+    struct d3drm_clipped_visual *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    object->IDirect3DRMClippedVisual_iface.lpVtbl = &d3drm_clipped_visual_vtbl;
+    object->ref = 1;
+    object->d3drm = d3drm;
+    IDirect3DRM_AddRef(d3drm);
+    d3drm_object_init(&object->obj, classname);
+    d3drm_object_register(&object->obj, (IDirect3DRMObject *)&object->IDirect3DRMClippedVisual_iface, d3drm);
+    if (visual)
+    {
+        object->visual = visual;
+        IDirect3DRMVisual_AddRef(visual);
+    }
+    *out = object;
+    return D3DRM_OK;
+}
