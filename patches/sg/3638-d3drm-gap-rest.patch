+
+    hr = Direct3DRMCreate(&d3drm1);
+    ok(hr == D3DRM_OK, "Cannot create d3drm, hr %#lx.\n", hr);
+    IDirect3DRM_QueryInterface(d3drm1, &IID_IDirect3DRM2, (void **)&d3drm2);
+    IDirect3DRM_QueryInterface(d3drm1, &IID_IDirect3DRM3, (void **)&d3drm3);
+
+    /* named objects and enumeration */
+    hr = IDirect3DRM3_CreateFrame(d3drm3, NULL, &frame);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    hr = IDirect3DRMFrame3_SetName(frame, "sg_frame");
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    object = (void *)0xdeadbeef;
+    hr = IDirect3DRM3_GetNamedObject(d3drm3, "sg_frame", &object);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    ok(object == (IDirect3DRMObject *)(IDirect3DRMFrame *)frame || object, "Got object %p.\n", object);
+    IDirect3DRMObject_Release(object);
+    hr = IDirect3DRM_GetNamedObject(d3drm1, "sg_frame", &object);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    IDirect3DRMObject_Release(object);
+    hr = IDirect3DRM2_GetNamedObject(d3drm2, "nope", &object);
+    ok(hr == D3DRMERR_NOTFOUND, "Got hr %#lx.\n", hr);
+    ok(!object, "Got object %p.\n", object);
+    count = 0;
+    hr = IDirect3DRM3_EnumerateObjects(d3drm3, sg_enum_cb, &count);
+    ok(hr == D3DRM_OK && count == 1, "Got hr %#lx, count %d.\n", hr, count);
+    IDirect3DRMFrame3_Release(frame);
+    hr = IDirect3DRM3_GetNamedObject(d3drm3, "sg_frame", &object);
+    ok(hr == D3DRMERR_NOTFOUND, "A destroyed object was found, hr %#lx.\n", hr);
+    count = 0;
+    IDirect3DRM3_EnumerateObjects(d3drm3, sg_enum_cb, &count);
+    ok(!count, "Got count %d.\n", count);
+
+    hr = IDirect3DRM3_GetDevices(d3drm3, &devices);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    ok(IDirect3DRMDeviceArray_GetSize(devices) == 0, "Got size %lu.\n", IDirect3DRMDeviceArray_GetSize(devices));
+    IDirect3DRMDeviceArray_Release(devices);
+
+    /* options */
+    hr = IDirect3DRM3_GetOptions(d3drm3, &flags);
+    ok(hr == D3DRM_OK && flags == D3DRMOPTIONS_LEFTHANDED, "Got hr %#lx, flags %#lx.\n", hr, flags);
+    hr = IDirect3DRM3_SetOptions(d3drm3, 0);
+    ok(hr == D3DRMERR_BADVALUE, "Got hr %#lx.\n", hr);
+    hr = IDirect3DRM3_SetOptions(d3drm3, D3DRMOPTIONS_RIGHTHANDED);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    hr = IDirect3DRM3_GetOptions(d3drm3, &flags);
+    ok(hr == D3DRM_OK && flags == D3DRMOPTIONS_RIGHTHANDED, "Got hr %#lx, flags %#lx.\n", hr, flags);
+
+    /* clients */
+    hr = IDirect3DRM3_RegisterClient(d3drm3, &IID_IUnknown, &id);
+    ok(hr == D3DRM_OK && id, "Got hr %#lx, id %#lx.\n", hr, id);
+    hr = IDirect3DRM3_RegisterClient(d3drm3, &IID_IDirect3DRM, &id2);
+    ok(hr == D3DRM_OK && id2 && id2 != id, "Got hr %#lx, id %#lx.\n", hr, id2);
+    hr = IDirect3DRM3_UnregisterClient(d3drm3, &IID_IUnknown);
+    ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    hr = IDirect3DRM3_UnregisterClient(d3drm3, &IID_IUnknown);
+    ok(hr == D3DRMERR_CLIENTNOTREGISTERED, "Got hr %#lx.\n", hr);
+
+    /* aggregation */
+    {
+        IUnknown *unknown;
+
+        hr = IDirect3DRM3_CreateObject(d3drm3, &CLSID_CDirect3DRMFrame, (IUnknown *)d3drm1, &IID_IUnknown,
+                (void **)&unknown);
+        ok(hr == CLASS_E_NOAGGREGATION, "Got hr %#lx.\n", hr);
+    }
+
+    /* Tick moves the root frames */
+    {
+        struct move_ctx { int calls; float delta; } ctx = { 0, 0.0f };
+        (void)ctx;
+        hr = IDirect3DRM3_Tick(d3drm3, 1.0f);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+    }
+
+    /* frame clone */
+    {
+        IDirect3DRMFrame3 *child;
+        IDirect3DRMFrameArray *children;
+        D3DVECTOR v;
+        D3DRMMATRIX4D m;
+
+        IDirect3DRM3_CreateFrame(d3drm3, NULL, &frame);
+        IDirect3DRM3_CreateFrame(d3drm3, frame, &child);
+        IDirect3DRMFrame3_AddTranslation(frame, D3DRMCOMBINE_REPLACE, 1.0f, 2.0f, 3.0f);
+        IDirect3DRMFrame3_AddTranslation(child, D3DRMCOMBINE_REPLACE, 4.0f, 5.0f, 6.0f);
+        IDirect3DRMFrame3_SetColorRGB(frame, 1.0f, 0.0f, 0.0f);
+        hr = IDirect3DRMFrame3_Clone(frame, NULL, &IID_IDirect3DRMFrame3, (void **)&clone);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        hr = IDirect3DRMFrame3_GetTransform(clone, NULL, m);
+        ok(hr == D3DRM_OK && m[3][0] == 1.0f && m[3][1] == 2.0f && m[3][2] == 3.0f, "Got hr %#lx, %f.\n", hr, m[3][0]);
+        ok(IDirect3DRMFrame3_GetColor(clone) == IDirect3DRMFrame3_GetColor(frame), "Colors differ.\n");
+        hr = IDirect3DRMFrame3_GetChildren(clone, &children);
+        ok(hr == D3DRM_OK && IDirect3DRMFrameArray_GetSize(children) == 1, "Got hr %#lx.\n", hr);
+        {
+            IDirect3DRMFrame *c1;
+
+            IDirect3DRMFrameArray_GetElement(children, 0, &c1);
+            ok(c1 != (IDirect3DRMFrame *)child, "The child was not copied.\n");
+            IDirect3DRMFrame_Release(c1);
+        }
+        IDirect3DRMFrameArray_Release(children);
+        IDirect3DRMFrame3_Release(clone);
+        hr = IDirect3DRMFrame3_Clone(frame, (IUnknown *)d3drm1, &IID_IDirect3DRMFrame3, (void **)&clone);
+        ok(hr == CLASS_E_NOAGGREGATION, "Got hr %#lx.\n", hr);
+        (void)v;
+        IDirect3DRMFrame3_Release(child);
+        IDirect3DRMFrame3_Release(frame);
+    }
+
+    IDirect3DRM3_Release(d3drm3);
+    IDirect3DRM2_Release(d3drm2);
+    IDirect3DRM_Release(d3drm1);
+}
