     return hr;
 }
 
+static HRESULT d3drm_create_animation_set_object(void **object, IDirect3DRM *d3drm)
+{
+    struct d3drm_animation_set *set;
+    HRESULT hr;
+
+    if (FAILED(hr = d3drm_animation_set_create(d3drm, &set)))
+        return hr;
+    *object = &set->IDirect3DRMAnimationSet_iface;
+    return hr;
+}
+
+static HRESULT d3drm_create_user_visual_object(void **object, IDirect3DRM *d3drm)
+{
+    struct d3drm_user_visual *visual;
+    HRESULT hr;
+
+    if (FAILED(hr = d3drm_user_visual_create(d3drm, NULL, NULL, &visual)))
+        return hr;
+    *object = &visual->IDirect3DRMUserVisual_iface;
+    return hr;
+}
+
+static HRESULT d3drm_create_shadow_object(void **object, IDirect3DRM *d3drm)
+{
+    struct d3drm_shadow *shadow;
+    HRESULT hr;
+
+    if (FAILED(hr = d3drm_shadow_create(d3drm, NULL, NULL, NULL, NULL, &shadow)))
+        return hr;
+    *object = &shadow->IDirect3DRMShadow_iface;
+    return hr;
+}
+
+static HRESULT d3drm_create_progressive_mesh_object(void **object, IDirect3DRM *d3drm)
+{
+    struct d3drm_progressive_mesh *mesh;
+    HRESULT hr;
+
+    if (FAILED(hr = d3drm_progressive_mesh_create(d3drm, &mesh)))
+        return hr;
+    *object = &mesh->IDirect3DRMProgressiveMesh_iface;
+    return hr;
+}
+
+static HRESULT d3drm_create_clipped_visual_object(void **object, IDirect3DRM *d3drm)
+{
+    struct d3drm_clipped_visual *visual;
+    HRESULT hr;
+
+    if (FAILED(hr = d3drm_clipped_visual_create(d3drm, NULL, &visual)))
+        return hr;
+    *object = &visual->IDirect3DRMClippedVisual_iface;
+    return hr;
+}
