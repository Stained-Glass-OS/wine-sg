+/* Texture coordinates for a point (in the space of the wrap's reference frame): the wrap has an origin, a
+ * direction (z) and an up vector (y). Chrome mapping uses the normal instead of the position. */
+static void wrap_coords(const struct d3drm_wrap *w, const D3DVECTOR *p, const D3DVECTOR *n, float *u, float *v)
+{
+    D3DVECTOR x, y = w->up, z = w->dir, d;
+    float lx, px, py, pz, theta, h;
+
+    /* x = y cross z, then y again perpendicular to both */
+    x.x = y.y * z.z - y.z * z.y;
+    x.y = y.z * z.x - y.x * z.z;
+    x.z = y.x * z.y - y.y * z.x;
+    lx = sqrtf(x.x * x.x + x.y * x.y + x.z * x.z);
+    if (lx > 0.0f)
+    {
+        x.x /= lx; x.y /= lx; x.z /= lx;
+    }
+    y.x = z.y * x.z - z.z * x.y;
+    y.y = z.z * x.x - z.x * x.z;
+    y.z = z.x * x.y - z.y * x.x;
+    if (w->type == D3DRMWRAP_CHROME)
+        d = *n;
+    else
+    {
+        d.x = p->x - w->origin.x;
+        d.y = p->y - w->origin.y;
+        d.z = p->z - w->origin.z;
+    }
+    px = d.x * x.x + d.y * x.y + d.z * x.z;
+    py = d.x * y.x + d.y * y.y + d.z * y.z;
+    pz = d.x * z.x + d.y * z.y + d.z * z.z;
+
+    switch (w->type)
+    {
+        case D3DRMWRAP_FLAT:
+#ifdef SG_MUTANT_DRM_WRAP
+            *u = w->ou - w->su * px;
+#else
+            *u = w->ou + w->su * px;
+#endif
+            *v = w->ov + w->sv * py;
+            break;
+        case D3DRMWRAP_CYLINDER:
+            theta = atan2f(px, pz);
+            *u = w->ou + w->su * (theta / (2.0f * M_PI));
+            *v = w->ov + w->sv * py;
+            break;
+        case D3DRMWRAP_SPHERE:
+            theta = atan2f(px, pz);
+            h = sqrtf(px * px + py * py + pz * pz);
+            *u = w->ou + w->su * (theta / (2.0f * M_PI));
+            *v = w->ov + w->sv * (h > 0.0f ? (asinf(py / h) / M_PI + 0.5f) : 0.5f);
+            break;
+        default:
+            /* chrome: the direction the surface faces, as u and v in [0, 1] */
+            h = sqrtf(px * px + py * py + pz * pz);
+            if (h > 0.0f)
+            {
+                px /= h; py /= h;
+            }
+            *u = w->ou + w->su * (px * 0.5f + 0.5f);
+            *v = w->ov + w->sv * (py * 0.5f + 0.5f);
+            break;
+    }
+}
