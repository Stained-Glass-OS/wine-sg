+static HRESULT d3drm_viewport_clone(struct d3drm_viewport *viewport, IUnknown *outer, REFIID iid, void **out)
+{
+    IDirect3DRM3 *d3drm3;
+    IDirect3DRMDevice3 *device3;
+    IDirect3DRMFrame3 *camera3;
+    IDirect3DRMViewport2 *copy2;
+    struct d3drm_viewport *copy;
+    HRESULT hr;
+
+    if (!out)
+        return D3DRMERR_BADVALUE;
+    *out = NULL;
+    if (outer)
+        return CLASS_E_NOAGGREGATION;
+    if (!viewport->d3d_viewport || !viewport->device)
+        return D3DRMERR_BADOBJECT;
+
+    if (FAILED(hr = IDirect3DRM_QueryInterface(viewport->d3drm, &IID_IDirect3DRM3, (void **)&d3drm3)))
+        return hr;
+    if (FAILED(hr = IDirect3DRMDevice3_QueryInterface(&viewport->device->IDirect3DRMDevice3_iface,
+            &IID_IDirect3DRMDevice3, (void **)&device3)))
+        goto done;
+    if (FAILED(hr = IDirect3DRMFrame_QueryInterface(viewport->camera, &IID_IDirect3DRMFrame3, (void **)&camera3)))
+    {
+        IDirect3DRMDevice3_Release(device3);
+        goto done;
+    }
+    hr = IDirect3DRM3_CreateViewport(d3drm3, device3, camera3, viewport->x, viewport->y, viewport->width,
+            viewport->height, &copy2);
+    IDirect3DRMDevice3_Release(device3);
+    IDirect3DRMFrame3_Release(camera3);
+    if (FAILED(hr))
+        goto done;
+
+    copy = impl_from_IDirect3DRMViewport2(copy2);
+    copy->clip = viewport->clip;
+    copy->projection = viewport->projection;
+    copy->uniform_scaling = viewport->uniform_scaling;
+    hr = IDirect3DRMViewport2_QueryInterface(copy2, iid, out);
+    IDirect3DRMViewport2_Release(copy2);
+
+done:
+    IDirect3DRM3_Release(d3drm3);
+    return hr;
+}
