+    array->ref = 1;
+    array->count = device->nb_viewports;
+#ifdef SG_MUTANT_DRM_VPARRAY
+    array->count = 0;
+#endif
+    for (i = 0; i < array->count; ++i)
+    {
+        array->viewports[i] = &device->viewports[i]->IDirect3DRMViewport_iface;
+        IDirect3DRMViewport_AddRef(array->viewports[i]);
+    }
+    *out = &array->IDirect3DRMViewportArray_iface;
+    return D3DRM_OK;
+}
+
+struct format_search
+{
+    DWORD bitdepths, flags;
+    DDPIXELFORMAT best;
+    int best_score;
+};
+
+static HRESULT CALLBACK enum_texture_format(DDSURFACEDESC *desc, void *ctx)
+{
+    struct format_search *search = ctx;
+    DDPIXELFORMAT *pf = &desc->ddpfPixelFormat;
+    DWORD bits = pf->dwRGBBitCount, mask = bits == 1 ? DDBD_1 : bits == 2 ? DDBD_2 : bits == 4 ? DDBD_4 :
+            bits == 8 ? DDBD_8 : bits == 16 ? DDBD_16 : bits == 24 ? DDBD_24 : bits == 32 ? DDBD_32 : 0;
+    BOOL alpha = !!(pf->dwFlags & DDPF_ALPHAPIXELS), palette = !!(pf->dwFlags & (DDPF_PALETTEINDEXED1
+            | DDPF_PALETTEINDEXED2 | DDPF_PALETTEINDEXED4 | DDPF_PALETTEINDEXED8));
+    int score = 0;
+
+    if (!(pf->dwFlags & (DDPF_RGB | DDPF_PALETTEINDEXED1 | DDPF_PALETTEINDEXED2 | DDPF_PALETTEINDEXED4
+            | DDPF_PALETTEINDEXED8)))
+        return D3DENUMRET_OK;
+    if (!(search->bitdepths & mask))
+        return D3DENUMRET_OK;
+    if ((search->flags & D3DRMFPTF_ALPHA) && !alpha)
+        return D3DENUMRET_OK;
+    if ((search->flags & D3DRMFPTF_NOALPHA) && alpha)
+        return D3DENUMRET_OK;
+    if ((search->flags & D3DRMFPTF_PALETTIZED) && !palette)
+        return D3DENUMRET_OK;
+    if ((search->flags & D3DRMFPTF_NOTPALETTIZED) && palette)
+        return D3DENUMRET_OK;
+    /* the deepest colour wins */
+    score = 1 + bits;
+    if (score > search->best_score)
+    {
+        search->best = *pf;
+        search->best_score = score;
+    }
+    return D3DENUMRET_OK;
+}
+
+static HRESULT d3drm_device_find_texture_format(struct d3drm_device *device, DWORD bitdepths, DWORD flags,
+        DDPIXELFORMAT *pf)
+{
+    struct format_search search;
+    HRESULT hr;
+
+    if (!pf)
+        return D3DRMERR_BADVALUE;
+    if (!device->device)
+        return D3DRMERR_BADOBJECT;
+    memset(&search, 0, sizeof(search));
+    search.bitdepths = bitdepths;
+    search.flags = flags;
+    if (FAILED(hr = IDirect3DDevice_EnumTextureFormats(device->device, (LPD3DENUMTEXTUREFORMATSCALLBACK)enum_texture_format,
+            &search)))
+        return hr;
+    if (!search.best_score)
+        return D3DRMERR_TEXTUREFORMATNOTFOUND;
+    *pf = search.best;
+    return D3DRM_OK;
+}
+
+/* The state class is D3DRMSTATECHANGE_RENDER or _LIGHT; the options of a state are remembered per state. */
+static struct d3drm_state_change *device_state_change(struct d3drm_device *device, DWORD state_class, DWORD idx,
+        BOOL create)
+{
+    SIZE_T i;
+
+    for (i = 0; i < device->nb_state_changes; ++i)
+    {
+        if (device->state_changes[i].state_class == state_class && device->state_changes[i].state_idx == idx)
+            return &device->state_changes[i];
+    }
+    if (!create || !d3drm_array_reserve((void **)&device->state_changes, &device->state_changes_size,
+            device->nb_state_changes + 1, sizeof(*device->state_changes)))
+        return NULL;
+    device->state_changes[device->nb_state_changes].state_class = state_class;
+    device->state_changes[device->nb_state_changes].state_idx = idx;
+    device->state_changes[device->nb_state_changes].flags = D3DRMSTATECHANGE_NONVOLATILE;
+    return &device->state_changes[device->nb_state_changes++];
+}
+
+static HRESULT d3drm_device_state_change(struct d3drm_device *device, DWORD state_class, DWORD state, DWORD value,
+        DWORD flags)
+{
+    IDirect3DDevice2 *device2;
+    struct d3drm_state_change *change;
+    HRESULT hr = D3DRM_OK;
+
+    if (flags & ~(D3DRMSTATECHANGE_UPDATEONLY | D3DRMSTATECHANGE_VOLATILE | D3DRMSTATECHANGE_NONVOLATILE))
+        return D3DRMERR_BADVALUE;
+    if (!device->device)
+        return D3DRMERR_BADOBJECT;
+    /* the options given here replace those set with SetStateChangeOptions for this state */
+    if (flags && (change = device_state_change(device, state_class, state, TRUE)))
+        change->flags = flags;
+    /* UPDATEONLY records the value without sending it to the device now */
+    if (flags & D3DRMSTATECHANGE_UPDATEONLY)
+        return D3DRM_OK;
+    if (FAILED(hr = IDirect3DDevice_QueryInterface(device->device, &IID_IDirect3DDevice2, (void **)&device2)))
+        return D3DRMERR_BADOBJECT;
+    if (state_class == D3DRMSTATECHANGE_RENDER)
+        hr = IDirect3DDevice2_SetRenderState(device2, state, value);
+    else
+        hr = IDirect3DDevice2_SetLightState(device2, state, value);
+    IDirect3DDevice2_Release(device2);
+    return hr;
+}
