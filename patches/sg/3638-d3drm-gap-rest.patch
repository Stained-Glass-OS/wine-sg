+/* Converts a point or direction between the spaces of two frames (NULL is the world). */
+static void clip_convert(IDirect3DRMFrame3 *from, IDirect3DRMFrame3 *to, D3DVECTOR *v, BOOL point)
+{
+    struct d3drm_matrix m, inv;
+    struct d3drm_frame *frame;
+    D3DVECTOR r = *v;
+
+    if ((frame = unsafe_impl_from_IDirect3DRMFrame3(from)))
+    {
+        d3drm_frame_world_matrix(frame, &m);
+        r.x = v->x * m._11 + v->y * m._21 + v->z * m._31 + (point ? m._41 : 0.0f);
+        r.y = v->x * m._12 + v->y * m._22 + v->z * m._32 + (point ? m._42 : 0.0f);
+        r.z = v->x * m._13 + v->y * m._23 + v->z * m._33 + (point ? m._43 : 0.0f);
+    }
+    if ((frame = unsafe_impl_from_IDirect3DRMFrame3(to)))
+    {
+        D3DVECTOR w = r;
+
+        d3drm_frame_world_matrix(frame, &m);
+        if (d3drm_matrix_invert_affine(&m, &inv))
+        {
+            r.x = w.x * inv._11 + w.y * inv._21 + w.z * inv._31 + (point ? inv._41 : 0.0f);
+            r.y = w.x * inv._12 + w.y * inv._22 + w.z * inv._32 + (point ? inv._42 : 0.0f);
+            r.z = w.x * inv._13 + w.y * inv._23 + w.z * inv._33 + (point ? inv._43 : 0.0f);
+        }
+    }
+    *v = r;
+}
+
+static HRESULT WINAPI d3drm_clipped_visual_GetPlane(IDirect3DRMClippedVisual *iface, DWORD id,
+        IDirect3DRMFrame3 *reference, D3DVECTOR *point, D3DVECTOR *normal, DWORD flags)
+{
+    struct d3drm_clipped_visual *clipped = impl_from_IDirect3DRMClippedVisual(iface);
+    struct d3drm_clip_plane *plane;
+
+    TRACE("iface %p, id %#lx, reference %p, point %p, normal %p, flags %#lx.\n",
+            iface, id, reference, point, normal, flags);
+
+    if (!(plane = clipped_find_plane(clipped, id)))
+        return D3DRMERR_NOTFOUND;
+    if (point)
+    {
+        *point = plane->point;
+        clip_convert(plane->reference, reference, point, TRUE);
+    }
+    if (normal)
+    {
+        *normal = plane->normal;
+        clip_convert(plane->reference, reference, normal, FALSE);
+    }
+    return D3DRM_OK;
+}
+
+static HRESULT WINAPI d3drm_clipped_visual_SetPlane(IDirect3DRMClippedVisual *iface, DWORD id,
+        IDirect3DRMFrame3 *reference, D3DVECTOR *point, D3DVECTOR *normal, DWORD flags)
+{
+    struct d3drm_clipped_visual *clipped = impl_from_IDirect3DRMClippedVisual(iface);
+    struct d3drm_clip_plane *plane;
+
+    TRACE("iface %p, id %#lx, reference %p, point %p, normal %p, flags %#lx.\n",
+            iface, id, reference, point, normal, flags);
+
+    if (!point || !normal)
+        return D3DRMERR_BADVALUE;
+    if (!(plane = clipped_find_plane(clipped, id)))
+        return D3DRMERR_NOTFOUND;
+    if (reference)
+        IDirect3DRMFrame3_AddRef(reference);
+    if (plane->reference)
+        IDirect3DRMFrame3_Release(plane->reference);
+    plane->reference = reference;
+    plane->point = *point;
+    plane->normal = *normal;
+    return D3DRM_OK;
+}
