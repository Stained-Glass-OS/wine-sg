+struct writer
+{
+    BOOL binary;
+    BYTE *data;
+    SIZE_T size, capacity;
+    unsigned int depth;
+    HRESULT hr;
+};
+
+static void w_bytes(struct writer *w, const void *data, SIZE_T len)
+{
+    if (FAILED(w->hr))
+        return;
+    if (!d3drm_array_reserve((void **)&w->data, &w->capacity, w->size + len, 1))
+    {
+        w->hr = E_OUTOFMEMORY;
+        return;
+    }
+    memcpy(w->data + w->size, data, len);
+    w->size += len;
+}
+
+static void w_text(struct writer *w, const char *format, ...)
+{
+    char buffer[512];
+    va_list args;
+    int len;
+
+    va_start(args, format);
+    len = vsnprintf(buffer, sizeof(buffer), format, args);
+    va_end(args);
+    if (len > 0)
+        w_bytes(w, buffer, min(len, (int)sizeof(buffer) - 1));
+}
+
+static void w_indent(struct writer *w)
+{
+    unsigned int i;
+
+    for (i = 0; i < w->depth; ++i)
+        w_bytes(w, "  ", 2);
+}
+
+static void w_dword(struct writer *w, DWORD v)
+{
+    w_bytes(w, &v, sizeof(v));
+}
+
+/* the tokens of the binary form are 16 bit; counts and values after them are 32 bit */
+static void w_token(struct writer *w, WORD token)
+{
+#ifdef SG_MUTANT_DRM_SAVE
+    w_bytes(w, &token, sizeof(token));
+#endif
+    w_bytes(w, &token, sizeof(token));
+}
+
+static void w_begin(struct writer *w, const char *type, const char *name)
+{
+    if (w->binary)
+    {
+        w_token(w, TOKEN_NAME);
+        w_dword(w, strlen(type));
+        w_bytes(w, type, strlen(type));
+        if (name && *name)
+        {
+            w_token(w, TOKEN_NAME);
+            w_dword(w, strlen(name));
+            w_bytes(w, name, strlen(name));
+        }
+        w_token(w, TOKEN_OBRACE);
+    }
+    else
+    {
+        w_indent(w);
+        if (name && *name)
+            w_text(w, "%s %s {\n", type, name);
+        else
+            w_text(w, "%s {\n", type);
+    }
+    ++w->depth;
+}
+
+static void w_end(struct writer *w)
+{
+    --w->depth;
+    if (w->binary)
+    {
+        w_token(w, TOKEN_CBRACE);
+        return;
+    }
+    w_indent(w);
+    w_text(w, "}\n");
+}
+
+static void w_ints(struct writer *w, const DWORD *v, DWORD n)
+{
+    if (!w->binary)
+        return;
+    if (!n)
+        return;
+    w_token(w, TOKEN_INTEGER_LIST);
+    w_dword(w, n);
+    w_bytes(w, v, n * sizeof(*v));
+}
+
+static void w_floats(struct writer *w, const float *v, DWORD n)
+{
+    if (!w->binary || !n)
+        return;
+    w_token(w, TOKEN_FLOAT_LIST);
+    w_dword(w, n);
+    w_bytes(w, v, n * sizeof(*v));
+}
+
+/* a single integer member */
+static void w_int(struct writer *w, DWORD v)
+{
+    if (w->binary)
+        w_ints(w, &v, 1);
+    else
+    {
+        w_indent(w);
+        w_text(w, "%lu;\n", v);
+    }
+}
+
+/* count elements of per floats each: "a;b;c;," ... ending with ";;" */
+static void w_float_array(struct writer *w, const float *v, DWORD count, DWORD per)
+{
+    DWORD i, k;
+
+    if (w->binary)
+    {
+        w_floats(w, v, count * per);
+        return;
+    }
+    for (i = 0; i < count; ++i)
+    {
+        w_indent(w);
+        for (k = 0; k < per; ++k)
+            w_text(w, "%.6f;", v[i * per + k]);
+        w_text(w, i + 1 < count ? ",\n" : ";\n");
+    }
+    if (!count)
+    {
+        w_indent(w);
+        w_text(w, ";\n");
+    }
+}
+
+static void w_vectors(struct writer *w, const D3DVECTOR *v, DWORD count)
+{
+    w_float_array(w, (const float *)v, count, 3);
+}
+
+/* the faces of the MeshFace template: a count and the indices; idx[] holds count entries for each face */
+static void w_faces(struct writer *w, const DWORD *sizes, const DWORD *indices, DWORD count)
+{
+    DWORD i, k, pos = 0;
+
+    if (w->binary)
+    {
+        for (i = 0; i < count; ++i)
+        {
+            w_ints(w, &sizes[i], 1);
+            w_ints(w, &indices[pos], sizes[i]);
+            pos += sizes[i];
+        }
+        return;
+    }
+    for (i = 0; i < count; ++i)
+    {
+        w_indent(w);
+        w_text(w, "%lu;", sizes[i]);
+        for (k = 0; k < sizes[i]; ++k)
+            w_text(w, k + 1 < sizes[i] ? "%lu," : "%lu", indices[pos + k]);
+        w_text(w, i + 1 < count ? ";,\n" : ";;\n");
+        pos += sizes[i];
+    }
+    if (!count)
+    {
+        w_indent(w);
+        w_text(w, ";\n");
+    }
+}
+
+static void w_string(struct writer *w, const char *s)
+{
+    if (w->binary)
+    {
+        w_token(w, TOKEN_STRING);
+        w_dword(w, strlen(s));
+        w_bytes(w, s, strlen(s));
+        w_token(w, TOKEN_SEMICOLON);
+        return;
+    }
+    w_indent(w);
+    w_text(w, "\"%s\";\n", s);
+}
+
+static void w_matrix(struct writer *w, const struct d3drm_matrix *m)
+{
+    if (w->binary)
+    {
+        w_floats(w, &m->_11, 16);
+        return;
+    }
+    w_indent(w);
+    w_text(w, "%.6f,%.6f,%.6f,%.6f,\n", m->_11, m->_12, m->_13, m->_14);
+    w_indent(w);
+    w_text(w, "%.6f,%.6f,%.6f,%.6f,\n", m->_21, m->_22, m->_23, m->_24);
+    w_indent(w);
+    w_text(w, "%.6f,%.6f,%.6f,%.6f,\n", m->_31, m->_32, m->_33, m->_34);
+    w_indent(w);
+    w_text(w, "%.6f,%.6f,%.6f,%.6f;;\n", m->_41, m->_42, m->_43, m->_44);
+}
+
+static void w_header(struct writer *w)
+{
+    if (w->binary)
+    {
+        w_bytes(w, "xof 0302bin 0032", 16);
+    }
+    else
+    {
+        /* the templates (with the same header line) the loader of this library registers */
+        w_bytes(w, templates, strlen(templates));
+        w_bytes(w, "\n", 1);
+    }
+    w_begin(w, "Header", NULL);
+    if (w->binary)
+    {
+        DWORD v[3] = { 1 | (0 << 16), 0, 1 };
+
+        /* major and minor are WORDs, flags a DWORD; integers are stored as 32 bit values in the token list */
+        v[0] = 1;
+        v[1] = 0;
+        v[2] = 1;
+        w_ints(w, v, 3);
+    }
+    else
+    {
+        w_indent(w); w_text(w, "1;\n");
+        w_indent(w); w_text(w, "0;\n");
+        w_indent(w); w_text(w, "1;\n");
+    }
+    w_end(w);
+}
+
+/* ----- meshes ----- */
+
+static const char *object_name(struct d3drm_object *obj)
+{
+    return obj->name ? obj->name : "";
+}
+
+static void w_color_rgba(struct writer *w, D3DCOLOR c)
+{
+    float v[4];
+
+    v[0] = RGBA_GETRED(c) / 255.0f;
+    v[1] = RGBA_GETGREEN(c) / 255.0f;
+    v[2] = RGBA_GETBLUE(c) / 255.0f;
+    v[3] = RGBA_GETALPHA(c) / 255.0f;
+    if (w->binary)
+        w_floats(w, v, 4);
+    else
+    {
+        w_indent(w);
+        w_text(w, "%.6f;%.6f;%.6f;%.6f;;\n", v[0], v[1], v[2], v[3]);
+    }
+}
+
+static void w_material(struct writer *w, D3DCOLOR color, IDirect3DRMMaterial2 *material, IDirect3DRMTexture3 *texture,
+        DWORD flags)
+{
+    float power = 0.0f, spec[3] = { 0.0f, 0.0f, 0.0f }, emissive[3] = { 0.0f, 0.0f, 0.0f };
+
+    if (material)
+    {
+        IDirect3DRMMaterial2_GetSpecular(material, &spec[0], &spec[1], &spec[2]);
+        IDirect3DRMMaterial2_GetEmissive(material, &emissive[0], &emissive[1], &emissive[2]);
+        power = IDirect3DRMMaterial2_GetPower(material);
+    }
+    w_begin(w, "Material", NULL);
+    w_color_rgba(w, color);
+    if (w->binary)
+    {
+        w_floats(w, &power, 1);
+        w_floats(w, spec, 3);
+        w_floats(w, emissive, 3);
+    }
+    else
+    {
+        w_indent(w); w_text(w, "%.6f;\n", power);
+        w_indent(w); w_text(w, "%.6f;%.6f;%.6f;;\n", spec[0], spec[1], spec[2]);
+        w_indent(w); w_text(w, "%.6f;%.6f;%.6f;;\n", emissive[0], emissive[1], emissive[2]);
+    }
+    if (texture && (flags & D3DRMXOFSAVE_TEXTURENAMES))
+    {
+        DWORD size = 0;
+        char *name;
+
+        IDirect3DRMTexture3_GetName(texture, &size, NULL);
+        if (size && (name = malloc(size)))
+        {
+            if (SUCCEEDED(IDirect3DRMTexture3_GetName(texture, &size, name)))
+            {
+                w_begin(w, "TextureFilename", NULL);
+                w_string(w, name);
+                w_end(w);
+            }
+            free(name);
+        }
+    }
+    w_end(w);
+}
+
+static void write_mesh_builder(struct writer *w, struct d3drm_mesh_builder *mb, DWORD flags)
+{
+    IDirect3DRMFaceArray *extra = NULL;
+    D3DVECTOR *vertices = NULL, *normals = NULL;
+    DWORD *sizes = NULL, *indices = NULL, *nindices = NULL;
+    DWORD nv = mb->nb_vertices, nn = mb->nb_normals, nf = mb->nb_faces + mb->nb_extra_faces, total = 0, f, k, pos;
+    const DWORD *ptr;
+    BOOL write_normals = !!(flags & D3DRMXOFSAVE_NORMALS), all_normals = TRUE;
+    DWORD i;
+
+    /* face data first, then the faces made with CreateFace: their corners are added as points of their own */
+    (void)extra;
+    for (ptr = mb->pFaceData, f = 0; f < mb->nb_faces; ++f)
+    {
+        total += *ptr;
+        ptr += 1 + *ptr * 2;
+    }
+    for (i = 0; i < mb->nb_extra_faces; ++i)
+        total += mb->extra_faces[i]->nb_vertices;
+
+    vertices = calloc(nv + total + 1, sizeof(*vertices));
+    normals = calloc(nn + total + 1, sizeof(*normals));
+    sizes = calloc(nf + 1, sizeof(*sizes));
+    indices = calloc(total + 1, sizeof(*indices));
+    nindices = calloc(total + 1, sizeof(*nindices));
+    if (!vertices || !normals || !sizes || !indices || !nindices)
+    {
+        w->hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if (nv)
+        memcpy(vertices, mb->vertices, nv * sizeof(*vertices));
+    if (nn)
+        memcpy(normals, mb->normals, nn * sizeof(*normals));
+
+    pos = 0;
+    for (ptr = mb->pFaceData, f = 0; f < mb->nb_faces; ++f)
+    {
+        DWORD n = *ptr;
+
+        sizes[f] = n;
+        for (k = 0; k < n; ++k)
+        {
+            indices[pos + k] = ptr[1 + k * 2];
+            nindices[pos + k] = ptr[2 + k * 2];
+            if (nindices[pos + k] >= nn)
+                all_normals = FALSE;
+        }
+        pos += n;
+        ptr += 1 + n * 2;
+    }
+    {
+        DWORD extra_v = nv, extra_n = nn;
+
+        for (i = 0; i < mb->nb_extra_faces; ++i)
+        {
+            struct d3drm_face *face = mb->extra_faces[i];
+
+            sizes[mb->nb_faces + i] = face->nb_vertices;
+            for (k = 0; k < face->nb_vertices; ++k)
+            {
+                vertices[extra_v] = face->vertices[k].position;
+                indices[pos + k] = extra_v++;
+                if (face->vertices[k].has_normal)
+                {
+                    normals[extra_n] = face->vertices[k].normal;
+                    nindices[pos + k] = extra_n++;
+                }
+                else
+                {
+                    nindices[pos + k] = ~0u;
+                    all_normals = FALSE;
+                }
+            }
+            pos += face->nb_vertices;
+        }
+        nv = extra_v;
+        nn = extra_n;
+    }
+
+    w_begin(w, "Mesh", object_name(&mb->obj));
+    w_int(w, nv);
+    w_vectors(w, vertices, nv);
+    w_int(w, nf);
+    w_faces(w, sizes, indices, nf);
+
+    if (write_normals && nn && all_normals)
+    {
+        w_begin(w, "MeshNormals", NULL);
+        w_int(w, nn);
+        w_vectors(w, normals, nn);
+        w_int(w, nf);
+        w_faces(w, sizes, nindices, nf);
+        w_end(w);
+    }
+    if ((flags & D3DRMXOFSAVE_TEXTURECOORDINATES) && mb->nb_coords2d >= mb->nb_vertices && mb->nb_vertices)
+    {
+        w_begin(w, "MeshTextureCoords", NULL);
+        w_int(w, nv < mb->nb_coords2d ? nv : mb->nb_coords2d);
+        w_float_array(w, (const float *)mb->pCoords2d, nv < mb->nb_coords2d ? nv : mb->nb_coords2d, 2);
+        w_end(w);
+    }
+    if (flags & D3DRMXOFSAVE_MATERIALS)
+    {
+        w_begin(w, "MeshMaterialList", NULL);
+        if (mb->nb_materials && mb->material_indices)
+        {
+            w_int(w, mb->nb_materials);
+            w_int(w, nf);
+            if (w->binary)
+            {
+                DWORD *mi = calloc(nf + 1, sizeof(*mi));
+
+                if (mi)
+                {
+                    for (f = 0; f < nf; ++f)
+                        mi[f] = f < mb->nb_faces ? mb->material_indices[f] : 0;
+                    w_ints(w, mi, nf);
+                    free(mi);
+                }
+            }
+            else
+            {
+                for (f = 0; f < nf; ++f)
+                {
+                    w_indent(w);
+                    w_text(w, "%lu%s\n", f < mb->nb_faces ? mb->material_indices[f] : 0, f + 1 < nf ? "," : ";");
+                }
+            }
+            for (i = 0; i < mb->nb_materials; ++i)
+                w_material(w, mb->materials[i].color, mb->materials[i].material, mb->materials[i].texture, flags);
+        }
+        else
+        {
+            w_int(w, 1);
+            w_int(w, nf);
+            if (w->binary)
+            {
+                DWORD *mi = calloc(nf + 1, sizeof(*mi));
+
+                if (mi)
+                {
+                    w_ints(w, mi, nf);
+                    free(mi);
+                }
+            }
+            else
+            {
+                for (f = 0; f < nf; ++f)
+                {
+                    w_indent(w);
+                    w_text(w, "0%s\n", f + 1 < nf ? "," : ";");
+                }
+            }
+            w_material(w, mb->color, mb->material, mb->texture, flags);
+        }
+        w_end(w);
+    }
+    w_end(w);
+
+done:
+    free(vertices);
+    free(normals);
+    free(sizes);
+    free(indices);
+    free(nindices);
+}
+
+/* ----- frames ----- */
+
+static void write_visual(struct writer *w, IDirect3DRMVisual *visual, DWORD flags)
+{
+    IDirect3DRMMeshBuilder3 *builder;
+    IDirect3DRMMesh *mesh;
+
+    if (SUCCEEDED(IDirect3DRMVisual_QueryInterface(visual, &IID_IDirect3DRMMeshBuilder3, (void **)&builder)))
+    {
+        struct d3drm_mesh_builder *mb = CONTAINING_RECORD(builder, struct d3drm_mesh_builder,
+                IDirect3DRMMeshBuilder3_iface);
+
+        write_mesh_builder(w, mb, flags);
+        IDirect3DRMMeshBuilder3_Release(builder);
+    }
+    else if (SUCCEEDED(IDirect3DRMVisual_QueryInterface(visual, &IID_IDirect3DRMMesh, (void **)&mesh)))
+    {
+        IDirect3DRM3 *d3drm3 = NULL;
+        IDirect3DRMMeshBuilder3 *tmp = NULL;
+        struct d3drm_mesh *impl = CONTAINING_RECORD(mesh, struct d3drm_mesh, IDirect3DRMMesh_iface);
+
+        if (SUCCEEDED(IDirect3DRM_QueryInterface(impl->d3drm, &IID_IDirect3DRM3, (void **)&d3drm3)))
+        {
+            if (SUCCEEDED(IDirect3DRM3_CreateMeshBuilder(d3drm3, &tmp)))
+            {
+                struct d3drm_mesh_builder *mb = CONTAINING_RECORD(tmp, struct d3drm_mesh_builder,
+                        IDirect3DRMMeshBuilder3_iface);
+
+                if (SUCCEEDED(IDirect3DRMMeshBuilder3_AddMesh(tmp, mesh)))
+                    write_mesh_builder(w, mb, flags);
+                IDirect3DRMMeshBuilder3_Release(tmp);
+            }
+            IDirect3DRM3_Release(d3drm3);
+        }
+        IDirect3DRMMesh_Release(mesh);
+    }
+}
+
+static void write_frame(struct writer *w, struct d3drm_frame *frame, DWORD flags)
+{
+    SIZE_T i;
+
+    w_begin(w, "Frame", object_name(&frame->obj));
+    w_begin(w, "FrameTransformMatrix", NULL);
+    w_matrix(w, &frame->transform);
+    w_end(w);
+    for (i = 0; i < frame->nb_visuals; ++i)
+        write_visual(w, frame->visuals[i], flags);
+    for (i = 0; i < frame->nb_children; ++i)
+    {
+        struct d3drm_frame *child = unsafe_impl_from_IDirect3DRMFrame3(frame->children[i]);
+
+        if (child)
+            write_frame(w, child, flags);
+    }
+    w_end(w);
+}
+
+static HRESULT write_file(struct writer *w, const char *filename)
+{
+    HANDLE file;
+    DWORD written;
+    HRESULT hr = w->hr;
+
+    if (SUCCEEDED(hr))
+    {
+        file = CreateFileA(filename, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (file == INVALID_HANDLE_VALUE)
+            hr = D3DRMERR_FILENOTFOUND;
+        else
+        {
+            if (!WriteFile(file, w->data, w->size, &written, NULL) || written != w->size)
+                hr = D3DRMERR_BADFILE;
+            CloseHandle(file);
+        }
+    }
+    free(w->data);
+    return hr;
+}
+
+static HRESULT save_check(const char *filename, D3DRMXOFFORMAT format, DWORD flags)
+{
+    if (!filename)
+        return D3DRMERR_BADVALUE;
+    if (format != D3DRMXOF_BINARY && format != D3DRMXOF_COMPRESSED && format != D3DRMXOF_TEXT)
+        return D3DRMERR_BADVALUE;
+    if (flags & ~D3DRMXOFSAVE_ALL)
+        return D3DRMERR_BADVALUE;
+    return D3DRM_OK;
+}
+
+HRESULT d3drm_save_mesh_builder(struct d3drm_mesh_builder *mb, const char *filename, D3DRMXOFFORMAT format,
+        DWORD flags)
+{
+    struct writer w;
+    HRESULT hr;
+
+    if (FAILED(hr = save_check(filename, format, flags)))
+        return hr;
+    memset(&w, 0, sizeof(w));
+    w.binary = format != D3DRMXOF_TEXT;
+    w_header(&w);
+    write_mesh_builder(&w, mb, flags);
+    return write_file(&w, filename);
+}
+
+HRESULT d3drm_save_frame(struct d3drm_frame *frame, const char *filename, D3DRMXOFFORMAT format, DWORD flags)
+{
+    struct writer w;
+    HRESULT hr;
+
+    if (FAILED(hr = save_check(filename, format, flags)))
+        return hr;
+    memset(&w, 0, sizeof(w));
+    w.binary = format != D3DRMXOF_TEXT;
+    w_header(&w);
+    write_frame(&w, frame, flags);
+    return write_file(&w, filename);
+}
