From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 02:28:04 -0700
Subject: [PATCH] query: LoadIFilter through the persistent handler (3302)

LoadIFilter returned E_NOTIMPL. It now finds a file type's IFilter through
its persistent handler: HKCR\.ext\PersistentHandler (or the same key of the
file type's class) names a CLSID whose PersistentAddinsRegistered\
{89BCB740-6119-101A-BCB7-00DD010655AF} value is the filter's CLSID; the
filter is created with the caller's outer unknown and, for a path, loads
the file through IPersistFile. A bare extension (".ext") gives the filter
without loading a file. No handler or filter is E_FAIL.

Test: test/fastiq-gate.sh (mutants SG_MUTANT_IQ_*).

diff --git a/dlls/query/Makefile.in b/dlls/query/Makefile.in
index 4cce67f..c70583b 100644
--- a/dlls/query/Makefile.in
+++ b/dlls/query/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = query.dll
-IMPORTS   = uuid
+IMPORTS   = uuid ole32 advapi32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
diff --git a/dlls/query/query_main.c b/dlls/query/query_main.c
index 9e27986..6ca6701 100644
--- a/dlls/query/query_main.c
+++ b/dlls/query/query_main.c
@@ -72,9 +72,111 @@ HRESULT WINAPI LocateCatalogsW(WCHAR const *pwszScope, ULONG iBm,
     return CI_E_NOT_RUNNING;
 }
 
+/* the default value of a registry key of HKEY_CLASSES_ROOT, as a CLSID string */
+static BOOL query_class_value(const WCHAR *key, const WCHAR *subkey, WCHAR *buf, DWORD len)
+{
+    WCHAR path[MAX_PATH];
+    DWORD size = len * sizeof(WCHAR), type;
+    HKEY hkey;
+    LONG ret;
+
+    swprintf(path, ARRAY_SIZE(path), subkey ? L"%ls\\%ls" : L"%ls", key, subkey);
+    if (RegOpenKeyExW(HKEY_CLASSES_ROOT, path, 0, KEY_READ, &hkey)) return FALSE;
+    ret = RegQueryValueExW(hkey, NULL, NULL, &type, (BYTE *)buf, &size);
+    RegCloseKey(hkey);
+    return !ret && type == REG_SZ && buf[0];
+}
+
+/* The filter of a file type is found through its persistent handler:
+ * HKCR\.ext\PersistentHandler (or the same key of the file type's class) names a CLSID
+ * whose PersistentAddinsRegistered\{89BCB740-6119-101A-BCB7-00DD010655AF} is the filter's. */
 HRESULT WINAPI LoadIFilter(WCHAR const *pwcsPath, IUnknown *pUnkOuter, void **ppIUnk)
 {
-    FIXME("%s %p %p\n", debugstr_w(pwcsPath), pUnkOuter, ppIUnk);
+    static const WCHAR filter_addin[] = L"PersistentAddinsRegistered\\{89BCB740-6119-101A-BCB7-00DD010655AF}";
+    WCHAR handler[64], filter_clsid[64], key[MAX_PATH], progid[MAX_PATH], *ext, *p;
+    BOOL is_file;
+    CLSID clsid;
+    IUnknown *unk;
+    HRESULT hr;
+
+    TRACE("%s, %p, %p\n", debugstr_w(pwcsPath), pUnkOuter, ppIUnk);
+
+    if (!ppIUnk) return E_INVALIDARG;
     *ppIUnk = NULL;
-    return E_NOTIMPL;
+    if (!pwcsPath || !pwcsPath[0]) return E_INVALIDARG;
+
+    /* a path, or just an extension */
+    ext = NULL;
+    for (p = (WCHAR *)pwcsPath; *p; p++)
+    {
+#ifdef SG_MUTANT_IQ_NODIRDOT
+        if (*p == '.') ext = p;
+#else
+        if (*p == '\\' || *p == '/') ext = NULL;
+        else if (*p == '.') ext = p;
+#endif
+    }
+    if (!ext) return E_FAIL;
+    is_file = ext != pwcsPath;
+
+    if (!query_class_value(ext, L"PersistentHandler", handler, ARRAY_SIZE(handler)))
+    {
+        /* the class of the file type */
+#ifdef SG_MUTANT_IQ_NOCLASS
+        return E_FAIL;
+#endif
+        if (!query_class_value(ext, NULL, progid, ARRAY_SIZE(progid))
+                || !query_class_value(progid, L"PersistentHandler", handler, ARRAY_SIZE(handler)))
+            return E_FAIL;
+    }
+
+    swprintf(key, ARRAY_SIZE(key), L"CLSID\\%ls", handler);
+#ifdef SG_MUTANT_IQ_NOADDIN
+    if (0)
+#else
+    if (!query_class_value(key, filter_addin, filter_clsid, ARRAY_SIZE(filter_clsid)))
+#endif
+        return E_FAIL;
+    if (FAILED(hr = CLSIDFromString(filter_clsid, &clsid))) return E_FAIL;
+
+    if (FAILED(hr = CoCreateInstance(&clsid,
+#ifdef SG_MUTANT_IQ_NOOUTER
+            NULL,
+#else
+            pUnkOuter,
+#endif
+            CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&unk)))
+    {
+        WARN("could not create the filter %s: %#lx\n", debugstr_w(filter_clsid), hr);
+        return hr == E_OUTOFMEMORY ? hr : E_FAIL;
+    }
+
+#ifdef SG_MUTANT_IQ_NOLOAD
+    if (0)
+#else
+    if (is_file && !pUnkOuter)
+#endif
+    {
+        /* the filter reads the file it is given */
+        IPersistFile *persist;
+        if (SUCCEEDED(IUnknown_QueryInterface(unk, &IID_IPersistFile, (void **)&persist)))
+        {
+            hr = IPersistFile_Load(persist, pwcsPath, STGM_READ | STGM_SHARE_DENY_NONE);
+            IPersistFile_Release(persist);
+            if (FAILED(hr))
+            {
+#ifndef SG_MUTANT_IQ_NOREL
+                IUnknown_Release(unk);
+#endif
+#ifdef SG_MUTANT_IQ_NOAUTH
+                return E_FAIL;
+#else
+                return hr == E_ACCESSDENIED || hr == E_OUTOFMEMORY ? hr : E_FAIL;
+#endif
+            }
+        }
+    }
+
+    *ppIUnk = unk;
+    return S_OK;
 }
