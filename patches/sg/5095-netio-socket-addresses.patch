From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] netio.sys: WskGetLocalAddress, WskGetRemoteAddress and more error codes.

Both were stubs returning STATUS_NOT_IMPLEMENTED. WskGetLocalAddress
completes the IRP with the socket's local transport address, or
STATUS_INVALID_DEVICE_STATE when the socket is not bound (a socket accepted on
a listening socket is bound); WskGetRemoteAddress completes it with the remote
address, or STATUS_INVALID_DEVICE_STATE when the socket is not connected. The
Winsock errors WSAEINTR, WSAEHOSTUNREACH, WSAEHOSTDOWN, WSAEISCONN, WSAENOBUFS,
WSAEDISCON, ERROR_OPERATION_ABORTED and ERROR_IO_PENDING map to their NT
status instead of an unmapped-error FIXME and STATUS_UNSUCCESSFUL.

Test: the WSK test driver; gate test/ntoskrnl-netiotest-gate.sh.
---

diff --git a/dlls/netio.sys/netio.c b/dlls/netio.sys/netio.c
--- a/dlls/netio.sys/netio.c
+++ b/dlls/netio.sys/netio.c
@@ -127,6 +127,16 @@
         case WSAECONNRESET:        return STATUS_CONNECTION_RESET;
         case WSAECONNABORTED:      return STATUS_CONNECTION_ABORTED;
         case WSAHOST_NOT_FOUND:    return STATUS_NOT_FOUND;
+        case WSAEINTR:             return STATUS_REQUEST_ABORTED;
+        case WSAEHOSTUNREACH:      return STATUS_HOST_UNREACHABLE;
+        case WSAEHOSTDOWN:         return STATUS_HOST_DOWN;
+#ifndef SG_MUTANT_NETIO_ERRMAP
+        case WSAEISCONN:           return STATUS_CONNECTION_ACTIVE;
+#endif
+        case WSAENOBUFS:           return STATUS_INSUFFICIENT_RESOURCES;
+        case WSAEDISCON:           return STATUS_GRACEFUL_DISCONNECT;
+        case ERROR_OPERATION_ABORTED: return STATUS_CANCELLED;
+        case ERROR_IO_PENDING:     return STATUS_PENDING;
         default:
             FIXME("Unmapped error %lu.\n", err);
             return STATUS_UNSUCCESSFUL;
@@ -327,6 +337,7 @@
         accept_socket->address_family = socket->address_family;
         accept_socket->protocol = socket->protocol;
         accept_socket->flags = WSK_FLAG_CONNECTION_SOCKET;
+        accept_socket->bound = TRUE;
         socket_init(accept_socket);
 
         pGetAcceptExSockaddrs(context->addr_buffer, 0, sizeof(SOCKADDR) + 16, sizeof(SOCKADDR) + 16,
@@ -476,9 +487,35 @@
 
 static NTSTATUS WINAPI wsk_get_local_address(WSK_SOCKET *socket, SOCKADDR *local_address, IRP *irp)
 {
-    FIXME("socket %p, local_address %p, irp %p stub.\n", socket, local_address, irp);
+    struct wsk_socket_internal *s = wsk_socket_internal_from_wsk_socket(socket);
+    SOCKADDR_STORAGE storage;
+    int length = sizeof(storage);
+    NTSTATUS status;
 
-    return STATUS_NOT_IMPLEMENTED;
+    TRACE("socket %p, local_address %p, irp %p.\n", socket, local_address, irp);
+
+    if (!irp)
+        return STATUS_INVALID_PARAMETER;
+
+    irp->IoStatus.Information = 0;
+
+    /* only a socket bound to a local transport address has one */
+#ifdef SG_MUTANT_NETIO_LOCAL
+    if (1)
+#else
+    if (!s->bound)
+#endif
+        status = STATUS_INVALID_DEVICE_STATE;
+    else if (getsockname(s->s, (SOCKADDR *)&storage, &length))
+        status = sock_error_to_ntstatus(WSAGetLastError());
+    else
+    {
+        memcpy(local_address, &storage, length);
+        status = STATUS_SUCCESS;
+    }
+
+    dispatch_irp(irp, status);
+    return STATUS_PENDING;
 }
 
 static const WSK_PROVIDER_LISTEN_DISPATCH wsk_provider_listen_dispatch =
@@ -575,9 +612,37 @@
 
 static NTSTATUS WINAPI wsk_get_remote_address(WSK_SOCKET *socket, SOCKADDR *remote_address, IRP *irp)
 {
-    FIXME("socket %p, remote_address %p, irp %p stub.\n", socket, remote_address, irp);
+    struct wsk_socket_internal *s = wsk_socket_internal_from_wsk_socket(socket);
+    SOCKADDR_STORAGE storage;
+    int length = sizeof(storage);
+    NTSTATUS status;
 
-    return STATUS_NOT_IMPLEMENTED;
+    TRACE("socket %p, remote_address %p, irp %p.\n", socket, remote_address, irp);
+
+    if (!irp)
+        return STATUS_INVALID_PARAMETER;
+
+    irp->IoStatus.Information = 0;
+
+#ifdef SG_MUTANT_NETIO_REMOTE
+    if (getpeername(s->s, (SOCKADDR *)&storage, &length) || 1)
+#else
+    if (getpeername(s->s, (SOCKADDR *)&storage, &length))
+#endif
+    {
+        int error = WSAGetLastError();
+
+        /* a socket that is not connected to a remote transport address */
+        status = error == WSAENOTCONN ? STATUS_INVALID_DEVICE_STATE : sock_error_to_ntstatus(error);
+    }
+    else
+    {
+        memcpy(remote_address, &storage, length);
+        status = STATUS_SUCCESS;
+    }
+
+    dispatch_irp(irp, status);
+    return STATUS_PENDING;
 }
 
 static void WINAPI send_receive_callback(TP_CALLBACK_INSTANCE *instance, void *socket_, TP_WAIT *wait,
diff --git a/dlls/ntoskrnl.exe/tests/driver_netio.c b/dlls/ntoskrnl.exe/tests/driver_netio.c
--- a/dlls/ntoskrnl.exe/tests/driver_netio.c
+++ b/dlls/ntoskrnl.exe/tests/driver_netio.c
@@ -395,7 +395,7 @@
 {
     const WSK_PROVIDER_CONNECTION_DISPATCH *connect_dispatch;
     struct socket_context context;
-    struct sockaddr_in addr;
+    struct sockaddr_in addr, got_addr;
     LARGE_INTEGER timeout;
     WSK_SOCKET *socket;
     NTSTATUS status;
@@ -432,6 +432,24 @@
     ok(!wsk_irp->IoStatus.Information, "Got unexpected Information %#Ix.\n",
             wsk_irp->IoStatus.Information);
 
+    /* neither bound nor connected yet */
+    memset(&got_addr, 0xcc, sizeof(got_addr));
+    IoReuseIrp(wsk_irp, STATUS_UNSUCCESSFUL);
+    IoSetCompletionRoutine(wsk_irp, irp_completion_routine, &irp_complete_event, TRUE, TRUE, TRUE);
+    status = connect_dispatch->WskGetLocalAddress(socket, (SOCKADDR *)&got_addr, wsk_irp);
+    ok(status == STATUS_PENDING || status == STATUS_INVALID_DEVICE_STATE, "Got unexpected status %#lx.\n", status);
+    status = KeWaitForSingleObject(&irp_complete_event, Executive, KernelMode, FALSE, &timeout);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    ok(wsk_irp->IoStatus.Status == STATUS_INVALID_DEVICE_STATE, "Got unexpected status %#lx.\n", wsk_irp->IoStatus.Status);
+
+    IoReuseIrp(wsk_irp, STATUS_UNSUCCESSFUL);
+    IoSetCompletionRoutine(wsk_irp, irp_completion_routine, &irp_complete_event, TRUE, TRUE, TRUE);
+    status = connect_dispatch->WskGetRemoteAddress(socket, (SOCKADDR *)&got_addr, wsk_irp);
+    ok(status == STATUS_PENDING || status == STATUS_INVALID_DEVICE_STATE, "Got unexpected status %#lx.\n", status);
+    status = KeWaitForSingleObject(&irp_complete_event, Executive, KernelMode, FALSE, &timeout);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    ok(wsk_irp->IoStatus.Status == STATUS_INVALID_DEVICE_STATE, "Got unexpected status %#lx.\n", wsk_irp->IoStatus.Status);
+
     memset(&addr, 0, sizeof(addr));
     addr.sin_family = AF_INET;
 
@@ -460,6 +478,41 @@
     ok(!wsk_irp->IoStatus.Information, "Got unexpected Information %#Ix.\n",
             wsk_irp->IoStatus.Information);
 
+    /* the local and the remote transport addresses of the connected socket */
+    memset(&got_addr, 0xcc, sizeof(got_addr));
+    IoReuseIrp(wsk_irp, STATUS_UNSUCCESSFUL);
+    IoSetCompletionRoutine(wsk_irp, irp_completion_routine, &irp_complete_event, TRUE, TRUE, TRUE);
+    status = connect_dispatch->WskGetLocalAddress(socket, (SOCKADDR *)&got_addr, wsk_irp);
+    ok(status == STATUS_PENDING, "Got unexpected status %#lx.\n", status);
+    status = KeWaitForSingleObject(&irp_complete_event, Executive, KernelMode, FALSE, &timeout);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    ok(wsk_irp->IoStatus.Status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", wsk_irp->IoStatus.Status);
+    ok(got_addr.sin_family == AF_INET && got_addr.sin_addr.s_addr == htonl(INADDR_LOOPBACK) && got_addr.sin_port,
+            "Got unexpected local address family %u address %#lx port %u.\n", got_addr.sin_family,
+            got_addr.sin_addr.s_addr, got_addr.sin_port);
+
+    memset(&got_addr, 0xcc, sizeof(got_addr));
+    IoReuseIrp(wsk_irp, STATUS_UNSUCCESSFUL);
+    IoSetCompletionRoutine(wsk_irp, irp_completion_routine, &irp_complete_event, TRUE, TRUE, TRUE);
+    status = connect_dispatch->WskGetRemoteAddress(socket, (SOCKADDR *)&got_addr, wsk_irp);
+    ok(status == STATUS_PENDING, "Got unexpected status %#lx.\n", status);
+    status = KeWaitForSingleObject(&irp_complete_event, Executive, KernelMode, FALSE, &timeout);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    ok(wsk_irp->IoStatus.Status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", wsk_irp->IoStatus.Status);
+    ok(got_addr.sin_family == AF_INET && got_addr.sin_addr.s_addr == htonl(INADDR_LOOPBACK)
+            && got_addr.sin_port == htons(CLIENT_LISTEN_PORT),
+            "Got unexpected remote address family %u address %#lx port %u.\n", got_addr.sin_family,
+            got_addr.sin_addr.s_addr, got_addr.sin_port);
+
+    /* a second connect on a connected socket */
+    IoReuseIrp(wsk_irp, STATUS_UNSUCCESSFUL);
+    IoSetCompletionRoutine(wsk_irp, irp_completion_routine, &irp_complete_event, TRUE, TRUE, TRUE);
+    status = connect_dispatch->WskConnect(socket, (SOCKADDR *)&addr, 0, wsk_irp);
+    ok(status == STATUS_PENDING, "Got unexpected status %#lx.\n", status);
+    status = KeWaitForSingleObject(&irp_complete_event, Executive, KernelMode, FALSE, &timeout);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    ok(wsk_irp->IoStatus.Status == STATUS_CONNECTION_ACTIVE, "Got unexpected status %#lx.\n", wsk_irp->IoStatus.Status);
+
     IoReuseIrp(wsk_irp, STATUS_UNSUCCESSFUL);
     IoSetCompletionRoutine(wsk_irp, irp_completion_routine, &irp_complete_event, TRUE, TRUE, TRUE);
     wsk_irp->IoStatus.Status = 0xdeadbeef;
-- 
2.47.0
