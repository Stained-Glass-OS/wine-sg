From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: RtlGetCurrentTransaction, RtlSetCurrentTransaction

The thread's current transaction is kept in its TEB (CurrentTransactionHandle), as on Windows: RtlSetCurrentTransaction stores it and succeeds, RtlGetCurrentTransaction gives it back. Set always failed and Get always gave NULL.
---
--- a/dlls/ntdll/rtl.c
+++ b/dlls/ntdll/rtl.c
@@ -1962,8 +1962,13 @@
  */
 HANDLE WINAPI RtlGetCurrentTransaction(void)
 {
-    FIXME("() :stub\n");
+    /* (wine-sg 8281) the thread's current transaction, kept in its TEB as on Windows; there being no
+     * transactional file system here, nothing else looks at it */
+    TRACE("()\n");
+#ifdef SG_MUTANT_NO_CURRENT_TRANSACTION
     return NULL;
+#endif
+    return NtCurrentTeb()->CurrentTransactionHandle;
 }
 
 /******************************************************************************
@@ -1971,8 +1976,12 @@
  */
 BOOL WINAPI RtlSetCurrentTransaction(HANDLE new_transaction)
 {
-    FIXME("(%p) :stub\n", new_transaction);
+    TRACE("(%p)\n", new_transaction);
+#ifdef SG_MUTANT_NO_CURRENT_TRANSACTION
     return FALSE;
+#endif
+    NtCurrentTeb()->CurrentTransactionHandle = new_transaction;
+    return TRUE;
 }
 
 /**********************************************************************
