+BOOL WINAPI AuthzGetInformationFromContext(AUTHZ_CLIENT_CONTEXT_HANDLE client_context,
+        AUTHZ_CONTEXT_INFORMATION_CLASS info_class, DWORD size, DWORD *size_required, void *buffer)
+{
+    struct ctx *ctx = (struct ctx *)client_context;
+    static const struct sid_array none;
+    DWORD needed;
+
+    TRACE("(%p,%d,%lu,%p,%p)\n", client_context, info_class, size, size_required, buffer);
+
+    if (!valid_object( ctx, MAGIC_CTX ) || !size_required || (size && !buffer))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    switch (info_class)
+    {
+    case AuthzContextInfoUserSid:
+        needed = sizeof(TOKEN_USER) + GetLengthSid( ctx->user.sid );
+        break;
+    case AuthzContextInfoGroupsSids:
+        needed = groups_size( &ctx->groups );
+        break;
+    case AuthzContextInfoRestrictedSids:
+        needed = groups_size( &ctx->restricted );
+        break;
+    case AuthzContextInfoDeviceSids:
+        needed = groups_size( &none );
+        break;
+    case AuthzContextInfoCapabilitySids:
+        needed = groups_size( &ctx->capabilities );
+        break;
+    case AuthzContextInfoPrivileges:
+        needed = offsetof( TOKEN_PRIVILEGES, Privileges[ctx->priv_count] );
+        break;
+    case AuthzContextInfoExpirationTime:
+        needed = sizeof(LARGE_INTEGER);
+        break;
+    case AuthzContextInfoIdentifier:
+        needed = sizeof(LUID);
+        break;
+    case AuthzContextInfoSecurityAttributes:
+    case AuthzContextInfoUserClaims:
+    case AuthzContextInfoDeviceClaims:
+        needed = sizeof(AUTHZ_SECURITY_ATTRIBUTES_INFORMATION);
+        break;
+    case AuthzContextInfoAppContainerSid:
+        needed = sizeof(TOKEN_APPCONTAINER_INFORMATION) + (ctx->appcontainer ? GetLengthSid( ctx->appcontainer ) : 0);
+        break;
+    default:  /* the reserved classes */
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    *size_required = needed;
+    if (size < needed)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+
+    switch (info_class)
+    {
+    case AuthzContextInfoUserSid:
+    {
+        TOKEN_USER *user = buffer;
+        user->User.Sid = (BYTE *)(user + 1);
+        user->User.Attributes = ctx->user.attrs;
+        CopySid( GetLengthSid( ctx->user.sid ), user->User.Sid, ctx->user.sid );
+        break;
+    }
+    case AuthzContextInfoGroupsSids:        fill_groups( buffer, &ctx->groups ); break;
+    case AuthzContextInfoRestrictedSids:    fill_groups( buffer, &ctx->restricted ); break;
+    case AuthzContextInfoDeviceSids:        fill_groups( buffer, &none ); break;
+    case AuthzContextInfoCapabilitySids:    fill_groups( buffer, &ctx->capabilities ); break;
+    case AuthzContextInfoPrivileges:
+    {
+        TOKEN_PRIVILEGES *privs = buffer;
+        privs->PrivilegeCount = ctx->priv_count;
+        if (ctx->priv_count) memcpy( privs->Privileges, ctx->privs, ctx->priv_count * sizeof(*ctx->privs) );
+        break;
+    }
+    case AuthzContextInfoExpirationTime:    *(LARGE_INTEGER *)buffer = ctx->expire; break;
+    case AuthzContextInfoIdentifier:        *(LUID *)buffer = ctx->id; break;
+    case AuthzContextInfoSecurityAttributes:
+    case AuthzContextInfoUserClaims:
+    case AuthzContextInfoDeviceClaims:
+    {
+        /* tokens here carry no claims: the list is empty */
+        AUTHZ_SECURITY_ATTRIBUTES_INFORMATION *claims = buffer;
+        memset( claims, 0, sizeof(*claims) );
+        claims->Version = AUTHZ_SECURITY_ATTRIBUTES_INFORMATION_VERSION_V1;
+        break;
+    }
+    case AuthzContextInfoAppContainerSid:
+    {
+        TOKEN_APPCONTAINER_INFORMATION *ac = buffer;
+        if (ctx->appcontainer)
+        {
+            ac->TokenAppContainer = (BYTE *)(ac + 1);
+            CopySid( GetLengthSid( ctx->appcontainer ), ac->TokenAppContainer, ctx->appcontainer );
+        }
+        else ac->TokenAppContainer = NULL;
+        break;
+    }
+    default: break;
+    }
+    return TRUE;
+}
