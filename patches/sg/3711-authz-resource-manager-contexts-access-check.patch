+static DWORD groups_size( const struct sid_array *array )
+{
+    DWORD size = offsetof( TOKEN_GROUPS, Groups[array->count] ), i;
+
+    for (i = 0; i < array->count; i++) size += GetLengthSid( array->entries[i].sid );
+    return size;
+}
+
+static void fill_groups( TOKEN_GROUPS *groups, const struct sid_array *array )
+{
+    BYTE *ptr = (BYTE *)&groups->Groups[array->count];
+    DWORD i, len;
+
+    groups->GroupCount = array->count;
+    for (i = 0; i < array->count; i++)
+    {
+        len = GetLengthSid( array->entries[i].sid );
+        CopySid( len, ptr, array->entries[i].sid );
+        groups->Groups[i].Sid = ptr;
+        groups->Groups[i].Attributes = array->entries[i].attrs;
+        ptr += len;
+    }
+}
