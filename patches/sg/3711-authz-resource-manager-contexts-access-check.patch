 /*
- * AUTHZ Implementation
+ * Authz: resource managers, client contexts and access checks
  *
- * Copyright 2009 Austin English
+ * The access check follows Microsoft's documented rules for a discretionary
+ * ACL: the owner's implicit READ_CONTROL and WRITE_DAC (unless an OWNER RIGHTS
+ * entry replaces them), ACEs evaluated in order, deny-only groups matching deny
+ * entries only, PRINCIPAL_SELF replaced by the request's SID, callback ACEs
+ * decided by the resource manager's callback, privileges for WRITE_OWNER and
+ * ACCESS_SYSTEM_SECURITY, and a second pass over the restricting SIDs.
  *
- * This library is free software; you can redistribute it and/or
- * modify it under the terms of the GNU Lesser General Public
- * License as published by the Free Software Foundation; either
- * version 2.1 of the License, or (at your option) any later version.
- *
- * This library is distributed in the hope that it will be useful,
- * but WITHOUT ANY WARRANTY; without even the implied warranty of
- * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
- * Lesser General Public License for more details.
- *
- * You should have received a copy of the GNU Lesser General Public
- * License along with this library; if not, write to the Free Software
- * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ * Not done: object type lists (they fail with ERROR_NOT_SUPPORTED rather than
+ * being checked as a flat object), conditional-expression evaluation (a
+ * conditional callback ACE is unknown: an allow entry does not apply, a deny
+ * entry does), auditing (an audit event handle cannot be created yet) and
+ * central access policies.
  */
+
 #include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
 
 #include "windef.h"
 #include "winbase.h"
+#include "winreg.h"
+#include "winternl.h"
+#include "sddl.h"
+#include "lmaccess.h"
+#include "lmapibuf.h"
+#include "lmerr.h"
 #include "wine/debug.h"
+#include "wine/list.h"
 
 #include "authz.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(authz);
 
+#define MAGIC_RM      0x4d52585a
+#define MAGIC_CTX     0x5843585a
+#define MAGIC_RESULTS 0x5352585a
+
+struct object
+{
+    struct list entry;
+    DWORD magic;
+};
+
+static struct list objects = LIST_INIT( objects );
+static CRITICAL_SECTION objects_cs;
+static CRITICAL_SECTION_DEBUG objects_cs_debug =
+{
+    0, 0, &objects_cs,
+    { &objects_cs_debug.ProcessLocksList, &objects_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": objects_cs") }
+};
+static CRITICAL_SECTION objects_cs = { &objects_cs_debug, -1, 0, 0, 0, 0 };
+
+struct rm
+{
+    struct object obj;
+    DWORD flags;
+    PFN_AUTHZ_DYNAMIC_ACCESS_CHECK check;
+    PFN_AUTHZ_COMPUTE_DYNAMIC_GROUPS compute;
+    PFN_AUTHZ_FREE_DYNAMIC_GROUPS free_groups;
+    WCHAR *name;
+    LONG refs;       /* contexts made from it */
+    BOOL freed;
+};
+
+struct sid_entry
+{
+    PSID sid;
+    DWORD attrs;
+};
+
+struct sid_array
+{
+    struct sid_entry *entries;
+    DWORD count;
+};
+
+struct ctx
+{
+    struct object obj;
+    struct rm *rm;
+    struct sid_entry user;
+    struct sid_array groups, restricted, capabilities;
+    LUID_AND_ATTRIBUTES *privs;
+    DWORD priv_count;
+    PSID appcontainer;
+    LARGE_INTEGER expire;
+    LUID id;
+    DWORD flags;
+};
+
+struct results
+{
+    struct object obj;
+    struct ctx *ctx;
+    PSECURITY_DESCRIPTOR *sds;  /* primary first */
+    DWORD sd_count;
+    BOOL deep;
+};
+
+static void *alloc_object( SIZE_T size, DWORD magic )
+{
+    struct object *obj = calloc( 1, size );
+
+    if (!obj)
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    obj->magic = magic;
+    EnterCriticalSection( &objects_cs );
+    list_add_tail( &objects, &obj->entry );
+    LeaveCriticalSection( &objects_cs );
+    return obj;
+}
+
+/* handles are checked against the list: a stale or foreign handle is refused,
+ * not dereferenced */
+static BOOL valid_object( void *handle, DWORD magic )
+{
+    struct object *obj;
+    BOOL found = FALSE;
+
+    if (!handle) return FALSE;
+    EnterCriticalSection( &objects_cs );
+    LIST_FOR_EACH_ENTRY( obj, &objects, struct object, entry )
+        if (obj == handle && obj->magic == magic) { found = TRUE; break; }
+    LeaveCriticalSection( &objects_cs );
+    return found;
+}
+
+static void unlink_object( struct object *obj )
+{
+    EnterCriticalSection( &objects_cs );
+    list_remove( &obj->entry );
+    obj->magic = 0;
+    LeaveCriticalSection( &objects_cs );
+}
+
+static void free_sid_array( struct sid_array *array )
+{
+    DWORD i;
+
+    for (i = 0; i < array->count; i++) free( array->entries[i].sid );
+    free( array->entries );
+    array->entries = NULL;
+    array->count = 0;
+}
+
+static BOOL append_sid( struct sid_array *array, PSID sid, DWORD attrs )
+{
+    struct sid_entry *entries;
+    DWORD len;
+    PSID copy;
+
+    if (!IsValidSid( sid ))
+    {
+        SetLastError( ERROR_INVALID_SID );
+        return FALSE;
+    }
+    len = GetLengthSid( sid );
+    if (!(copy = malloc( len )) || !CopySid( len, copy, sid ))
+    {
+        free( copy );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    if (!(entries = realloc( array->entries, (array->count + 1) * sizeof(*entries) )))
+    {
+        free( copy );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    array->entries = entries;
+    entries[array->count].sid = copy;
+    entries[array->count].attrs = attrs;
+    array->count++;
+    return TRUE;
+}
+
+static BOOL copy_sid_array( struct sid_array *dst, const struct sid_array *src )
+{
+    DWORD i;
+
+    for (i = 0; i < src->count; i++)
+        if (!append_sid( dst, src->entries[i].sid, src->entries[i].attrs )) return FALSE;
+    return TRUE;
+}
+
+static void free_ctx_contents( struct ctx *ctx )
+{
+    free( ctx->user.sid );
+    free_sid_array( &ctx->groups );
+    free_sid_array( &ctx->restricted );
+    free_sid_array( &ctx->capabilities );
+    free( ctx->privs );
+    free( ctx->appcontainer );
+}
+
+static void destroy_ctx( struct ctx *ctx )
+{
+    unlink_object( &ctx->obj );
+    free_ctx_contents( ctx );
+    free( ctx );
+}
+
+static PSID dup_sid( PSID sid )
+{
+    DWORD len;
+    PSID copy;
+
+    if (!sid) return NULL;
+    len = GetLengthSid( sid );
+    if ((copy = malloc( len ))) CopySid( len, copy, sid );
+    return copy;
+}
+
+static BOOL set_priv_list( struct ctx *ctx, const LUID_AND_ATTRIBUTES *privs, DWORD count )
+{
+    LUID_AND_ATTRIBUTES *copy;
+
+    if (!count) return TRUE;
+    if (!(copy = malloc( count * sizeof(*copy) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    memcpy( copy, privs, count * sizeof(*copy) );
+    ctx->privs = copy;
+    ctx->priv_count = count;
+    return TRUE;
+}
+
+/* dynamic groups: the resource manager's callback adds SIDs to a new context */
+static BOOL add_dynamic_groups( struct ctx *ctx, void *args )
+{
+    SID_AND_ATTRIBUTES *sids = NULL, *restricted = NULL;
+    DWORD count = 0, rcount = 0, i;
+    BOOL ret = TRUE;
+
+    if (!ctx->rm || !ctx->rm->compute) return TRUE;
+    if (!ctx->rm->compute( (AUTHZ_CLIENT_CONTEXT_HANDLE)ctx, args, &sids, &count, &restricted, &rcount ))
+        return FALSE;
+    for (i = 0; ret && i < count; i++) ret = append_sid( &ctx->groups, sids[i].Sid, sids[i].Attributes );
+    for (i = 0; ret && i < rcount; i++) ret = append_sid( &ctx->restricted, restricted[i].Sid, restricted[i].Attributes );
+    if (ctx->rm->free_groups)
+    {
+        if (sids) ctx->rm->free_groups( sids );
+        if (restricted) ctx->rm->free_groups( restricted );
+    }
+    return ret;
+}
+
+static struct ctx *new_ctx( struct rm *rm, LARGE_INTEGER *expire, LUID id, DWORD flags )
+{
+    struct ctx *ctx;
+
+    if (!(ctx = alloc_object( sizeof(*ctx), MAGIC_CTX ))) return NULL;
+    ctx->rm = rm;
+    if (expire) ctx->expire = *expire;
+    else ctx->expire.QuadPart = 0x7fffffffffffffffLL;
+    ctx->id = id;
+    ctx->flags = flags;
+    return ctx;
+}
