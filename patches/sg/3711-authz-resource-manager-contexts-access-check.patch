+static BOOL well_known_sid( WELL_KNOWN_SID_TYPE type, struct sid_array *array, DWORD attrs )
+{
+    BYTE sid[SECURITY_MAX_SID_SIZE];
+    DWORD len = sizeof(sid);
+
+    return CreateWellKnownSid( type, NULL, sid, &len ) && append_sid( array, sid, attrs );
+}
+
+/* groups of a user account: the world, authenticated users and the local
+ * groups the account database lists for it */
+static BOOL add_account_groups( struct ctx *ctx, PSID sid )
+{
+    const DWORD attrs = SE_GROUP_MANDATORY | SE_GROUP_ENABLED_BY_DEFAULT | SE_GROUP_ENABLED;
+    WCHAR *name = NULL, *domain = NULL;
+    DWORD name_len = 0, domain_len = 0, entries = 0, total = 0, i;
+    LOCALGROUP_USERS_INFO_0 *info = NULL;
+    SID_NAME_USE use;
+    BOOL ret = FALSE;
+
+    LookupAccountSidW( NULL, sid, NULL, &name_len, NULL, &domain_len, &use );
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER) return FALSE;
+    if (!(name = malloc( name_len * sizeof(WCHAR) )) || !(domain = malloc( domain_len * sizeof(WCHAR) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        goto done;
+    }
+    if (!LookupAccountSidW( NULL, sid, name, &name_len, domain, &domain_len, &use )) goto done;
+    if (use != SidTypeUser && use != 9 /* SidTypeComputer */)
+    {
+        SetLastError( ERROR_NONE_MAPPED );
+        goto done;
+    }
+
+#ifndef SG_MUTANT_NO_WORLD
