+    TRACE("(0x%lx,%p,%p,%p,%s,%p)\n", flags, access_checker, compute_dyn_groups, free_dyn_groups,
+          debugstr_w(managername), handle);
+
+    if ((flags & ~(AUTHZ_RM_FLAG_NO_AUDIT | AUTHZ_RM_FLAG_INITIALIZE_UNDER_IMPERSONATION |
+                   AUTHZ_RM_FLAG_NO_CENTRAL_ACCESS_POLICIES)) || !handle)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    if (!(flags & AUTHZ_RM_FLAG_NO_AUDIT))
+    {
+        /* auditing needs SeAuditPrivilege enabled in the identity the manager
+         * is initialized as: the process token, or the thread's under
+         * impersonation */
+        BYTE buffer[1024];
+        TOKEN_PRIVILEGES *privs = (TOKEN_PRIVILEGES *)buffer;
+        HANDLE token = NULL;
+        BOOL enabled = FALSE;
+        DWORD len, i;
+        LUID audit;
+
+        if ((flags & AUTHZ_RM_FLAG_INITIALIZE_UNDER_IMPERSONATION))
+            OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token );
+        if (!token && !OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return FALSE;
+        if (LookupPrivilegeValueW( NULL, L"SeAuditPrivilege", &audit ) &&
+            GetTokenInformation( token, TokenPrivileges, buffer, sizeof(buffer), &len ))
+        {
+            for (i = 0; i < privs->PrivilegeCount; i++)
+                if (privs->Privileges[i].Luid.LowPart == audit.LowPart &&
+                    privs->Privileges[i].Luid.HighPart == audit.HighPart &&
+                    (privs->Privileges[i].Attributes & SE_PRIVILEGE_ENABLED))
+                    enabled = TRUE;
+        }
+        CloseHandle( token );
+#ifndef SG_MUTANT_RM_NO_AUDIT_PRIV
+        if (!enabled)
+        {
+            SetLastError( ERROR_PRIVILEGE_NOT_HELD );
+            return FALSE;
+        }
+#endif
+    }
+
+    if (!(rm = alloc_object( sizeof(*rm), MAGIC_RM ))) return FALSE;
+    rm->flags = flags;
+    rm->check = access_checker;
+    rm->compute = compute_dyn_groups;
+    rm->free_groups = free_dyn_groups;
+    if (managername && !(rm->name = wcsdup( managername )))
+    {
+        unlink_object( &rm->obj );
+        free( rm );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    *handle = (AUTHZ_RESOURCE_MANAGER_HANDLE)rm;
+    return TRUE;
 }
 
