index 53befbb..4a4fb0e 100644
--- a/dlls/authz/Makefile.in
+++ b/dlls/authz/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = authz.dll
+IMPORTS   = advapi32 netapi32
 
