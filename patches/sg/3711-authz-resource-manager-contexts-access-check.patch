+/* ---- the access check ---- */
+
+#define IMPLICIT_OWNER_RIGHTS (READ_CONTROL | WRITE_DAC)
+#define ALL_ACCESS_BITS       (STANDARD_RIGHTS_ALL | SPECIFIC_RIGHTS_ALL)
+
+struct view
+{
+    PSID user;                 /* NULL in the restricted pass */
+    DWORD user_attrs;
+    const struct sid_entry *entries;
+    DWORD count;
+};
+
+static BOOL view_has_sid( const struct view *view, PSID sid, BOOL for_deny )
+{
+    DWORD i;
+
+    if (view->user && EqualSid( view->user, sid ))
+    {
+        if (view->user_attrs & SE_GROUP_USE_FOR_DENY_ONLY) return for_deny;
+        return TRUE;
+    }
+    for (i = 0; i < view->count; i++)
+    {
+        DWORD attrs = view->entries[i].attrs;
+
+        if (!EqualSid( view->entries[i].sid, sid )) continue;
+        if (attrs & SE_GROUP_USE_FOR_DENY_ONLY)
+        {
+#ifdef SG_MUTANT_DENY_ONLY_ALLOWS
+            return TRUE;
+#else
+            if (for_deny) return TRUE;
+            continue;
+#endif
+        }
+#ifdef SG_MUTANT_DISABLED_GROUP_MATCHES
+        return TRUE;
+#else
+        if (attrs & SE_GROUP_ENABLED) return TRUE;
+#endif
+    }
+    return FALSE;
+}
