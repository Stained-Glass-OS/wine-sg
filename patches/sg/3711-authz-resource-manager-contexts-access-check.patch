+/* ---- client contexts ---- */
+
+static BOOL token_groups_to_entries( const TOKEN_GROUPS *groups, struct sid_array *out )
+{
+    DWORD i;
+
+    for (i = 0; i < groups->GroupCount; i++)
+        if (!append_sid( out, groups->Groups[i].Sid, groups->Groups[i].Attributes )) return FALSE;
+    return TRUE;
 }
 
+static void *query_token( HANDLE token, TOKEN_INFORMATION_CLASS class )
+{
+    DWORD len = 0;
+    void *buf;
+
+    GetTokenInformation( token, class, NULL, 0, &len );
+    if (!len) return NULL;
+    if (!(buf = malloc( len ))) return NULL;
+    if (!GetTokenInformation( token, class, buf, len, &len ))
+    {
+        free( buf );
+        return NULL;
+    }
+    return buf;
+}
 
