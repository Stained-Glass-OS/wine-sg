+            SID_NAME_USE guse;
+
+            LookupAccountNameW( NULL, info[i].lgrui0_name, NULL, &gsid_len, NULL, &dlen, &guse );
+            gsid_len = sizeof(gsid);
+            if (!(dom = malloc( (dlen + 1) * sizeof(WCHAR) ))) continue;
+            if (LookupAccountNameW( NULL, info[i].lgrui0_name, gsid, &gsid_len, dom, &dlen, &guse ))
+                append_sid( &ctx->groups, gsid, attrs );
+            free( dom );
+        }
+        NetApiBufferFree( info );
+    }
+    ret = TRUE;
+done:
+    free( name );
+    free( domain );
+    return ret;
+}
 
