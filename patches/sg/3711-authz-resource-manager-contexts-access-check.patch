+struct ace_info
 {
-    FIXME("(0x%lx,%p,%p,%p,%08lx:%08lx,%p,%p): stub\n", flags, token_handle, resource_manager,
-            expire_time, id.HighPart, id.LowPart, dynamic_group, client_context);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    ACE_HEADER *header;
+    BOOL allow, callback, object, typed;
+    ACCESS_MASK mask;
+    PSID sid;
+};
+
+/* the parts of an ACE the check needs, or FALSE for an entry that takes no
+ * part in a DACL check (audit, label, compound, malformed) */
+static BOOL parse_ace( ACE_HEADER *ace, DWORD room, struct ace_info *info )
+{
+    DWORD offset;
+    DWORD sid_len;
+
+    memset( info, 0, sizeof(*info) );
+    if (room < sizeof(ACE_HEADER) + sizeof(DWORD) || ace->AceSize < sizeof(ACE_HEADER) + sizeof(DWORD) ||
+        ace->AceSize > room || (ace->AceSize & 3))
+        return FALSE;
+    info->header = ace;
+    switch (ace->AceType)
+    {
+    case ACCESS_ALLOWED_ACE_TYPE:                 info->allow = TRUE; break;
+    case ACCESS_DENIED_ACE_TYPE:                  break;
+    case ACCESS_ALLOWED_OBJECT_ACE_TYPE:          info->allow = TRUE; info->object = TRUE; break;
+    case ACCESS_DENIED_OBJECT_ACE_TYPE:           info->object = TRUE; break;
+    case ACCESS_ALLOWED_CALLBACK_ACE_TYPE:        info->allow = TRUE; info->callback = TRUE; break;
+    case ACCESS_DENIED_CALLBACK_ACE_TYPE:         info->callback = TRUE; break;
+    case ACCESS_ALLOWED_CALLBACK_OBJECT_ACE_TYPE: info->allow = TRUE; info->callback = TRUE; info->object = TRUE; break;
+    case ACCESS_DENIED_CALLBACK_OBJECT_ACE_TYPE:  info->callback = TRUE; info->object = TRUE; break;
+    default: return FALSE;
+    }
+    info->mask = *(ACCESS_MASK *)(ace + 1);
+    offset = sizeof(ACE_HEADER) + sizeof(DWORD);
+    if (info->object)
+    {
+        DWORD flags;
+
+        if (ace->AceSize < offset + sizeof(DWORD)) return FALSE;
+        flags = *(DWORD *)((BYTE *)ace + offset);
+        offset += sizeof(DWORD);
+        if (flags & ACE_OBJECT_TYPE_PRESENT) { info->typed = TRUE; offset += sizeof(GUID); }
+        if (flags & ACE_INHERITED_OBJECT_TYPE_PRESENT) offset += sizeof(GUID);
+    }
+    if (ace->AceSize < offset + 8) return FALSE;
+    info->sid = (BYTE *)ace + offset;
+    sid_len = 8 + ((SID *)info->sid)->SubAuthorityCount * sizeof(DWORD);
+    if (((SID *)info->sid)->SubAuthorityCount == 0 || ((SID *)info->sid)->SubAuthorityCount > SID_MAX_SUB_AUTHORITIES ||
+        offset + sid_len > ace->AceSize)
+        return FALSE;
+    return TRUE;
+}
+
+#define MAX_ACLS 33
+
+struct acl_list
+{
+    ACL *acls[MAX_ACLS];
+    DWORD count;
+};
+
+static BOOL sid_is_owner_rights( PSID sid )
+{
+    SID_IDENTIFIER_AUTHORITY auth = { SECURITY_CREATOR_SID_AUTHORITY };
+    SID *s = sid;
+
+    return !memcmp( &s->IdentifierAuthority, &auth, sizeof(auth) ) && s->SubAuthorityCount == 1 &&
+           s->SubAuthority[0] == SECURITY_CREATOR_OWNER_RIGHTS_RID;
+}
+
+static BOOL sid_is_principal_self( PSID sid )
+{
+    SID_IDENTIFIER_AUTHORITY auth = { SECURITY_NT_AUTHORITY };
+    SID *s = sid;
+
+    return !memcmp( &s->IdentifierAuthority, &auth, sizeof(auth) ) && s->SubAuthorityCount == 1 &&
+           s->SubAuthority[0] == SECURITY_PRINCIPAL_SELF_RID;
+}
+
+static BOOL acls_have_owner_rights( const struct acl_list *list )
+{
+    DWORD a, i;
+
+    for (a = 0; a < list->count; a++)
+    {
+        ACL *acl = list->acls[a];
+        BYTE *ptr = (BYTE *)(acl + 1);
+
+        for (i = 0; i < acl->AceCount; i++)
+        {
+            struct ace_info info;
+            DWORD room = (BYTE *)acl + acl->AclSize - ptr;
+
+            if (room < sizeof(ACE_HEADER) || !parse_ace( (ACE_HEADER *)ptr, room, &info )) break;
+            if (!(info.header->AceFlags & INHERIT_ONLY_ACE) && sid_is_owner_rights( info.sid )) return TRUE;
+            ptr += info.header->AceSize;
+        }
+    }
     return FALSE;
 }
+
+enum ace_decision { ACE_APPLIES, ACE_SKIP, ACE_ERROR };
+
+/* a conditional callback ACE ("artx" data) is not evaluated: unknown */
+static BOOL ace_is_conditional( const struct ace_info *info )
+{
+    DWORD offset = (BYTE *)info->sid - (BYTE *)info->header;
+    DWORD len = 8 + ((SID *)info->sid)->SubAuthorityCount * sizeof(DWORD);
+
+    offset += len;
+    return info->header->AceSize >= offset + 4 && !memcmp( (BYTE *)info->header + offset, "artx", 4 );
+}
+
+static enum ace_decision callback_decision( struct ctx *ctx, const struct ace_info *info, void *args )
+{
+    BOOL applicable = FALSE;
+
+    if (ace_is_conditional( info ) || !ctx->rm || !ctx->rm->check)
+    {
+        /* unknown: an allow entry is left out, a deny entry stands */
+#ifdef SG_MUTANT_CB_ALLOW_UNKNOWN
+        return ACE_APPLIES;
+#else
+        return info->allow ? ACE_SKIP : ACE_APPLIES;
+#endif
+    }
+    if (!ctx->rm->check( (AUTHZ_CLIENT_CONTEXT_HANDLE)ctx, info->header, args, &applicable )) return ACE_ERROR;
+    return applicable ? ACE_APPLIES : ACE_SKIP;
+}
+
+/* the access the DACLs give a view, before privileges: the bits granted by the
+ * first matching allow entries not already denied */
+static BOOL dacl_rights( struct ctx *ctx, const struct view *view, const struct acl_list *list, PSID owner,
+                         PSID self_sid, void *args, ACCESS_MASK *granted )
+{
+    ACCESS_MASK granted_bits = 0, denied = 0;
+#ifdef SG_MUTANT_OWNER_RIGHTS_IGNORED
+    BOOL owner_rights_ace = FALSE;
+#else
+    BOOL owner_rights_ace = acls_have_owner_rights( list );
+#endif
+    BOOL is_owner = owner && view_has_sid( view, owner, FALSE );
+    DWORD a, i;
+
+    if (is_owner && !owner_rights_ace)
+    {
+#ifndef SG_MUTANT_NO_IMPLICIT_OWNER
+        granted_bits = IMPLICIT_OWNER_RIGHTS;
+#endif
+    }
+
+    for (a = 0; a < list->count; a++)
+    {
+        ACL *acl = list->acls[a];
+        BYTE *ptr = (BYTE *)(acl + 1);
+
+        for (i = 0; i < acl->AceCount; i++)
+        {
+            struct ace_info info;
+            DWORD room = (BYTE *)acl + acl->AclSize - ptr;
+            PSID sid;
+            BOOL match;
+
+            if (room < sizeof(ACE_HEADER)) return TRUE;
+            if (!parse_ace( (ACE_HEADER *)ptr, room, &info ))
+            {
+                if (room >= sizeof(ACE_HEADER) && ((ACE_HEADER *)ptr)->AceSize >= sizeof(ACE_HEADER) &&
+                    ((ACE_HEADER *)ptr)->AceSize <= room && !(((ACE_HEADER *)ptr)->AceSize & 3))
+                {
+                    ptr += ((ACE_HEADER *)ptr)->AceSize;  /* an entry that takes no part */
+                    continue;
+                }
+                return TRUE;  /* a malformed ACL stops the walk */
+            }
+            ptr += info.header->AceSize;
+
+#ifndef SG_MUTANT_INHERIT_ONLY
+            if (info.header->AceFlags & INHERIT_ONLY_ACE) continue;
+#endif
+            /* without an object type list only the entries that cover the
+             * whole object count */
+#ifndef SG_MUTANT_TYPED_APPLIES
+            if (info.typed) continue;
+#endif
+
+            sid = info.sid;
+            if (sid_is_principal_self( sid ))
+            {
+#ifdef SG_MUTANT_SELF_ANY
+                if (info.allow) { sid = info.sid; goto matched; }
+#endif
+                if (!self_sid) continue;
+                sid = self_sid;
+            }
+            if (sid_is_owner_rights( sid )) match = is_owner;
+            else match = view_has_sid( view, sid, !info.allow );
+            if (!match) continue;
+#ifdef SG_MUTANT_SELF_ANY
+        matched:
+#endif
+            if (info.callback)
+            {
+                enum ace_decision d = callback_decision( ctx, &info, args );
+
+                if (d == ACE_ERROR) return FALSE;
+                if (d == ACE_SKIP) continue;
+            }
+
+            if (info.allow)
+            {
+#ifdef SG_MUTANT_DENY_IGNORED
+                granted_bits |= info.mask;
+#else
+                granted_bits |= info.mask & ~denied;
+#endif
+            }
+            else
+                denied |= info.mask & ~granted_bits;
+        }
+    }
+    *granted = granted_bits;
+    return TRUE;
+}
+
+static BOOL ctx_has_privilege( struct ctx *ctx, const WCHAR *name )
+{
+    LUID luid;
+    DWORD i;
+
+    if (!LookupPrivilegeValueW( NULL, name, &luid )) return FALSE;
+    for (i = 0; i < ctx->priv_count; i++)
+        if (ctx->privs[i].Luid.LowPart == luid.LowPart && ctx->privs[i].Luid.HighPart == luid.HighPart)
+            return !!(ctx->privs[i].Attributes & SE_PRIVILEGE_ENABLED);
+    return FALSE;
+}
+
+struct check_input
+{
+    PSECURITY_DESCRIPTOR *sds;   /* primary first */
+    DWORD sd_count;
+};
+
+/* every ACL of the object: the primary DACL then the optional ones (a NULL
+ * ACL there is an empty one); *null_dacl is set for a NULL primary DACL */
+static BOOL collect_acls( const struct check_input *in, struct acl_list *list, PSID *owner, BOOL *null_dacl )
+{
+    BOOL present, defaulted;
+    ACL *acl;
+    DWORD i;
+
+    list->count = 0;
+    *null_dacl = FALSE;
+    if (in->sd_count > MAX_ACLS) return FALSE;
+    if (!GetSecurityDescriptorOwner( in->sds[0], owner, &defaulted )) return FALSE;
+    if (!GetSecurityDescriptorDacl( in->sds[0], &present, &acl, &defaulted )) return FALSE;
+    if (!*owner || !present)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!acl) *null_dacl = TRUE;
+    else list->acls[list->count++] = acl;
+
+    for (i = 1; i < in->sd_count; i++)
+    {
+        if (!in->sds[i] || !IsValidSecurityDescriptor( in->sds[i] ))
+        {
+            SetLastError( ERROR_INVALID_SECURITY_DESCR );
+            return FALSE;
+        }
+        if (!GetSecurityDescriptorDacl( in->sds[i], &present, &acl, &defaulted )) return FALSE;
+        if (present && acl) list->acls[list->count++] = acl;
+#ifdef SG_MUTANT_OPT_NULL_ALLOWS
+        if (present && !acl) *null_dacl = TRUE;
+#endif
+    }
+    return TRUE;
+}
+
+/* the access a context holds on the object, as a mask of every bit it could be
+ * given; *status is the per-result error */
+static BOOL max_rights( struct ctx *ctx, const struct check_input *in, PSID self_sid, void *args,
+                        ACCESS_MASK *rights )
+{
+    struct acl_list list;
+    PSID owner;
+    BOOL null_dacl;
+    struct view view;
+    ACCESS_MASK pass = 0, restricted_pass;
+
+    if (!collect_acls( in, &list, &owner, &null_dacl )) return FALSE;
+
+    if (null_dacl)
+        pass = ALL_ACCESS_BITS;
+    else
+    {
+        view.user = ctx->user.sid;
+        view.user_attrs = ctx->user.attrs;
+        view.entries = ctx->groups.entries;
+        view.count = ctx->groups.count;
+        if (!dacl_rights( ctx, &view, &list, owner, self_sid, args, &pass )) return FALSE;
+    }
+
+    if (ctx->restricted.count)
+    {
+#ifndef SG_MUTANT_NO_RESTRICTED_PASS
+        if (null_dacl) restricted_pass = ALL_ACCESS_BITS;
+        else
+        {
+            view.user = NULL;
+            view.user_attrs = 0;
+            view.entries = ctx->restricted.entries;
+            view.count = ctx->restricted.count;
+            if (!dacl_rights( ctx, &view, &list, owner, self_sid, args, &restricted_pass )) return FALSE;
+        }
+        pass &= restricted_pass;
+#endif
+    }
+    *rights = pass;
+    return TRUE;
+}
+
+static BOOL check_request( struct ctx *ctx, const struct check_input *in, AUTHZ_ACCESS_REQUEST *request,
+                           AUTHZ_ACCESS_REPLY *reply )
+{
+    ACCESS_MASK desired = request->DesiredAccess, rights, mask = 0, plain;
+    DWORD error = ERROR_SUCCESS;
+
+    if (!max_rights( ctx, in, request->PrincipalSelfSid, request->OptionalArguments, &rights )) return FALSE;
+
+    if (desired & ACCESS_SYSTEM_SECURITY)
+    {
+        if (ctx_has_privilege( ctx, L"SeSecurityPrivilege" )) rights |= ACCESS_SYSTEM_SECURITY;
+#ifndef SG_MUTANT_SECURITY_PRIV_FREE
+        else error = ERROR_PRIVILEGE_NOT_HELD;
+#else
+        rights |= ACCESS_SYSTEM_SECURITY;
+#endif
+    }
+    if (ctx_has_privilege( ctx, L"SeTakeOwnershipPrivilege" )) rights |= WRITE_OWNER;
+    if ((desired & MAXIMUM_ALLOWED) && ctx_has_privilege( ctx, L"SeSecurityPrivilege" )) rights |= ACCESS_SYSTEM_SECURITY;
+
+    if (!desired) error = ERROR_ACCESS_DENIED;
+    else if (!error)
+    {
+        plain = desired & ~MAXIMUM_ALLOWED;
+        if ((desired & MAXIMUM_ALLOWED))
+        {
+            if (!rights || (plain & ~rights)) error = ERROR_ACCESS_DENIED;
+            else mask = rights;
+        }
+        else if (plain & ~rights) error = ERROR_ACCESS_DENIED;
+        else mask = plain;
+    }
+
+    reply->GrantedAccessMask[0] = error ? 0 : mask;
+    reply->Error[0] = error;
+    if (reply->SaclEvaluationResults) reply->SaclEvaluationResults[0] = 0;
+    return TRUE;
+}
+
+static BOOL validate_request( AUTHZ_ACCESS_REQUEST *request, AUTHZ_ACCESS_REPLY *reply )
+{
+    if (!request || !reply || !reply->GrantedAccessMask || !reply->Error)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (request->ObjectTypeList || request->ObjectTypeListLength)
+    {
+        /* property-level checks are not implemented: a flat check of such a
+         * request would answer for the wrong thing */
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+    if (reply->ResultListLength != 1)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (request->PrincipalSelfSid && !IsValidSid( request->PrincipalSelfSid ))
+    {
+        SetLastError( ERROR_INVALID_SID );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void free_results( struct results *res )
+{
+    DWORD i;
+
+    unlink_object( &res->obj );
+    if (res->deep) for (i = 0; i < res->sd_count; i++) free( res->sds[i] );
+    free( res->sds );
+    free( res );
+}
+
+static PSECURITY_DESCRIPTOR deep_copy_sd( PSECURITY_DESCRIPTOR sd )
+{
+    DWORD len = 0;
+    PSECURITY_DESCRIPTOR copy;
+
+    MakeSelfRelativeSD( sd, NULL, &len );
+    if (!len || !(copy = malloc( len ))) return NULL;
+    if (!MakeSelfRelativeSD( sd, copy, &len ))
+    {
+        free( copy );
+        return NULL;
+    }
+    return copy;
+}
+
+/***********************************************************************
+ *              AuthzAccessCheck (AUTHZ.@)
+ */
+BOOL WINAPI AuthzAccessCheck(DWORD flags, AUTHZ_CLIENT_CONTEXT_HANDLE client_context,
+        AUTHZ_ACCESS_REQUEST *request, AUTHZ_AUDIT_EVENT_HANDLE audit_event,
+        PSECURITY_DESCRIPTOR security, PSECURITY_DESCRIPTOR *optional_security,
+        DWORD optional_security_count, AUTHZ_ACCESS_REPLY *reply,
+        AUTHZ_ACCESS_CHECK_RESULTS_HANDLE *access_check_result)
+{
+    struct ctx *ctx = (struct ctx *)client_context;
+    PSECURITY_DESCRIPTOR *sds;
+    struct check_input in;
+    struct results *res = NULL;
+    DWORD i;
+    BOOL ret = FALSE;
+
+    TRACE("(0x%lx,%p,%p,%p,%p,%p,0x%lx,%p,%p)\n", flags, client_context, request, audit_event,
+          security, optional_security, optional_security_count, reply, access_check_result);
+
+    if ((flags & ~AUTHZ_ACCESS_CHECK_NO_DEEP_COPY_SD) || !security ||
+        ((flags & AUTHZ_ACCESS_CHECK_NO_DEEP_COPY_SD) && !access_check_result) ||
+        (optional_security_count && !optional_security) || optional_security_count >= MAX_ACLS)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!valid_object( ctx, MAGIC_CTX ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (audit_event)
+    {
+        /* audit event handles cannot be made yet */
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    if (!validate_request( request, reply )) return FALSE;
+    if (!IsValidSecurityDescriptor( security ))
+    {
+        SetLastError( ERROR_INVALID_SECURITY_DESCR );
+        return FALSE;
+    }
+
+    if (!(sds = malloc( (optional_security_count + 1) * sizeof(*sds) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    sds[0] = security;
+    for (i = 0; i < optional_security_count; i++) sds[i + 1] = optional_security[i];
+    in.sds = sds;
+    in.sd_count = optional_security_count + 1;
+
+    if (!check_request( ctx, &in, request, reply )) goto done;
+
+    if (access_check_result)
+    {
+        if (!(res = alloc_object( sizeof(*res), MAGIC_RESULTS ))) goto done;
+        res->ctx = ctx;
+        res->sd_count = in.sd_count;
+        res->sds = sds;
+#ifdef SG_MUTANT_NO_DEEPCOPY
+        res->deep = FALSE;
+#else
+        res->deep = !(flags & AUTHZ_ACCESS_CHECK_NO_DEEP_COPY_SD);
+#endif
+        if (res->deep)
+        {
+            for (i = 0; i < in.sd_count; i++)
+                if (!(res->sds[i] = deep_copy_sd( sds[i] )))
+                {
+                    DWORD j;
+                    for (j = 0; j < i; j++) free( res->sds[j] );
+                    unlink_object( &res->obj );
+                    free( res );
+                    res = NULL;
+                    SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+                    goto done;
+                }
+        }
+        sds = NULL;  /* now the handle's */
+        *access_check_result = (AUTHZ_ACCESS_CHECK_RESULTS_HANDLE)res;
+    }
+    ret = TRUE;
+done:
+    free( sds );
+    return ret;
+}
+
+/***********************************************************************
+ *              AuthzCachedAccessCheck (AUTHZ.@)
+ */
+BOOL WINAPI AuthzCachedAccessCheck(DWORD flags, AUTHZ_ACCESS_CHECK_RESULTS_HANDLE handle,
+        AUTHZ_ACCESS_REQUEST *request, AUTHZ_AUDIT_EVENT_HANDLE audit_event, AUTHZ_ACCESS_REPLY *reply)
+{
+    struct results *res = (struct results *)handle;
+    struct check_input in;
+
+    TRACE("(0x%lx,%p,%p,%p,%p)\n", flags, handle, request, audit_event, reply);
+
+    if (flags || !valid_object( res, MAGIC_RESULTS ) || !valid_object( res->ctx, MAGIC_CTX ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (audit_event)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    if (!validate_request( request, reply )) return FALSE;
+    in.sds = res->sds;
+    in.sd_count = res->sd_count;
+    return check_request( res->ctx, &in, request, reply );
+}
+
+/***********************************************************************
+ *              AuthzFreeHandle (AUTHZ.@)
+ */
+BOOL WINAPI AuthzFreeHandle(AUTHZ_ACCESS_CHECK_RESULTS_HANDLE handle)
+{
+    struct results *res = (struct results *)handle;
+
+    TRACE("(%p)\n", handle);
+
+    if (!valid_object( res, MAGIC_RESULTS ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    free_results( res );
+    return TRUE;
+}
