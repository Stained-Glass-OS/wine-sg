+        return FALSE;
+    }
+    if (!(user = query_token( token_handle, TokenUser ))) return FALSE;
+    if (!(groups = query_token( token_handle, TokenGroups ))) goto done;
+    restricted = query_token( token_handle, TokenRestrictedSids );
+    privs = query_token( token_handle, TokenPrivileges );
