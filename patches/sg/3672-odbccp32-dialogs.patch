+WINE_DEFAULT_DEBUG_CHANNEL(odbc);
+
+static HINSTANCE hinstance;
+
+BOOL WINAPI DllMain(HINSTANCE inst, DWORD reason, void *reserved)
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        hinstance = inst;
+        DisableThreadLibraryCalls(inst);
+    }
+    return TRUE;
+}
+
+static const WCHAR *odbcinst_key = L"Software\\ODBC\\ODBCINST.INI";
+static const WCHAR *odbcini_key = L"Software\\ODBC\\ODBC.INI";
+
+static void init_controls(void)
+{
+    INITCOMMONCONTROLSEX icc = { sizeof(icc), ICC_TAB_CLASSES | ICC_LISTVIEW_CLASSES };
+    InitCommonControlsEx(&icc);
+}
+
+static WCHAR *reg_query_string(HKEY root, const WCHAR *subkey, const WCHAR *value)
+{
+    DWORD size = 0, type;
+    WCHAR *buf;
+    HKEY key;
+    LONG res;
+
+    if (RegOpenKeyExW(root, subkey, 0, KEY_QUERY_VALUE, &key)) return NULL;
+    res = RegQueryValueExW(key, value, NULL, &type, NULL, &size);
+    if (res || (type != REG_SZ && type != REG_EXPAND_SZ)) { RegCloseKey(key); return NULL; }
+    buf = calloc(1, size + 2 * sizeof(WCHAR));
+    if (buf && RegQueryValueExW(key, value, NULL, &type, (BYTE *)buf, &size)) { free(buf); buf = NULL; }
+    RegCloseKey(key);
+    return buf;
+}
+
+/* Enumerate the values of a key; cb(name, data, ctx) is called for each. */
+typedef void (*enum_cb)(const WCHAR *name, const WCHAR *data, void *ctx);
+
+static void enum_values(HKEY root, const WCHAR *subkey, enum_cb cb, void *ctx)
+{
+    HKEY key;
+    DWORD i, nlen, dlen, type;
+    WCHAR name[256], data[MAX_PATH];
+
+    if (RegOpenKeyExW(root, subkey, 0, KEY_QUERY_VALUE, &key)) return;
+    for (i = 0; ; i++)
+    {
+        nlen = ARRAY_SIZE(name);
+        dlen = sizeof(data) - sizeof(WCHAR);
+        data[0] = 0;
+        if (RegEnumValueW(key, i, name, &nlen, NULL, &type, (BYTE *)data, &dlen)) break;
+        if (type != REG_SZ) data[0] = 0; else data[dlen / sizeof(WCHAR)] = 0;
+        cb(name, data, ctx);
+    }
+    RegCloseKey(key);
+}
+
+static void add_list_cb(const WCHAR *name, const WCHAR *data, void *ctx)
+{
+    SendMessageW(ctx, LB_ADDSTRING, 0, (LPARAM)name);
+}
+
+static WCHAR *list_sel_text(HWND list)
+{
+    LRESULT sel = SendMessageW(list, LB_GETCURSEL, 0, 0), len;
+    WCHAR *s;
+
+    if (sel == LB_ERR) return NULL;
+    len = SendMessageW(list, LB_GETTEXTLEN, sel, 0);
+    if (len == LB_ERR) return NULL;
+    if (!(s = calloc(len + 1, sizeof(WCHAR)))) return NULL;
+    SendMessageW(list, LB_GETTEXT, sel, (LPARAM)s);
+    return s;
+}
+
+static void fill_driver_list(HWND list)
+{
+    SendMessageW(list, LB_RESETCONTENT, 0, 0);
+    enum_values(HKEY_LOCAL_MACHINE, L"Software\\ODBC\\ODBCINST.INI\\ODBC Drivers", add_list_cb, list);
+}
+
+/* default folder for file data sources: <CommonFileDir>\ODBC\Data Sources */
+static void get_filedsn_dir(WCHAR *dir)
+{
+    WCHAR *common = reg_query_string(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion", L"CommonFileDir");
+
+    if (!common)
+    {
+        DWORD n = GetEnvironmentVariableW(L"CommonProgramFiles", dir, MAX_PATH);
+        if (!n || n >= MAX_PATH) wcscpy(dir, L"C:\\Program Files\\Common Files");
+    }
+    else
+    {
+        lstrcpynW(dir, common, MAX_PATH);
+        free(common);
+    }
+    if (wcslen(dir) + 20 < MAX_PATH) wcscat(dir, L"\\ODBC\\Data Sources");
+}
+
+static BOOL valid_file_name(const WCHAR *name)
+{
+    const WCHAR *base = name, *p;
+
+    if (!*name) return FALSE;
+    for (p = name; *p; p++)
+        if (*p == '\\' || *p == '/') base = p + 1;
+    if (!*base) return FALSE;
+    for (p = base; *p; p++)
+        if (wcschr(L":*?\"<>|", *p) || *p < 32) return FALSE;
+    return TRUE;
+}
+
+/* ---- Create New Data Source wizard --------------------------------------- */
+
+enum { PAGE_TYPE, PAGE_DRIVER, PAGE_FILE, PAGE_REVIEW };
+enum { TYPE_USER, TYPE_SYSTEM, TYPE_FILE };
+
+struct wizard
+{
+    const WCHAR *dsn;       /* optional preset name */
+    int type, page, first_page;
+    WCHAR driver[256];
+    WCHAR file[MAX_PATH];
+    WCHAR *advanced;        /* CR/LF separated keyword=value lines */
+    WCHAR *out_keywords;    /* keywords reported by the driver on a verified connection */
+    BOOL verify;
+    int error;              /* installer error code on failure */
+    const WCHAR *error_msg;
+};
+
+static void show_ctl(HWND hwnd, int id, BOOL show)
+{
+    ShowWindow(GetDlgItem(hwnd, id), show ? SW_SHOW : SW_HIDE);
+}
+
+static const WCHAR *wiz_type_name(int type)
+{
+    return type == TYPE_USER ? L"User Data Source" : type == TYPE_SYSTEM ? L"System Data Source" : L"File Data Source";
+}
+
+static void wiz_build_review(HWND hwnd, struct wizard *w)
+{
+    WCHAR text[2048];
+
+    swprintf(text, ARRAY_SIZE(text), L"Data source type: %ls\r\nDriver: %ls\r\n", wiz_type_name(w->type), w->driver);
+    if (w->type == TYPE_FILE)
+    {
+        wcscat(text, L"Data source file: ");
+        wcscat(text, w->file);
+        wcscat(text, L"\r\n");
+        if (w->advanced && *w->advanced && wcslen(text) + wcslen(w->advanced) + 4 < ARRAY_SIZE(text))
+        {
+            wcscat(text, L"\r\n");
+            wcscat(text, w->advanced);
+        }
+    }
+    else if (w->dsn && *w->dsn)
+    {
+        wcscat(text, L"Data source name: ");
+        lstrcpynW(text + wcslen(text), w->dsn, 200);
+        wcscat(text, L"\r\n");
+    }
+    wcscat(text, L"\r\nClick Finish to create the data source.");
+    SetDlgItemTextW(hwnd, IDC_REVIEW, text);
+}
+
+static void wiz_show_page(HWND hwnd, struct wizard *w)
+{
+    static const WCHAR *titles[] =
+    {
+        L"Select the type of data source you want to configure.",
+        L"Select a driver for which you want to set up a data source.",
+        L"Type the name of the file data source you want to create.",
+        L"The following data source will be created. Review the settings.",
+    };
+    BOOL has_file_page = w->type == TYPE_FILE;
+
+    SetDlgItemTextW(hwnd, IDC_TITLE, titles[w->page]);
+    show_ctl(hwnd, IDC_TYPE_USER, w->page == PAGE_TYPE);
+    show_ctl(hwnd, IDC_TYPE_SYSTEM, w->page == PAGE_TYPE);
+    show_ctl(hwnd, IDC_TYPE_FILE, w->page == PAGE_TYPE);
+    show_ctl(hwnd, IDC_TYPE_TEXT, w->page == PAGE_TYPE);
+    show_ctl(hwnd, IDC_WDRIVERS, w->page == PAGE_DRIVER);
+    show_ctl(hwnd, IDC_ADVANCED, w->page == PAGE_DRIVER && has_file_page);
+    show_ctl(hwnd, IDC_FNLABEL, w->page == PAGE_FILE);
+    show_ctl(hwnd, IDC_FILENAME, w->page == PAGE_FILE);
+    show_ctl(hwnd, IDC_BROWSE, w->page == PAGE_FILE);
+    show_ctl(hwnd, IDC_REVIEW, w->page == PAGE_REVIEW);
+    show_ctl(hwnd, IDC_NEXT, w->page != PAGE_REVIEW);
+    show_ctl(hwnd, IDC_FINISH, w->page == PAGE_REVIEW);
+    EnableWindow(GetDlgItem(hwnd, IDC_BACK), w->page > w->first_page);
+
+    if (w->page == PAGE_TYPE)
+    {
+        SetDlgItemTextW(hwnd, IDC_TYPE_TEXT, w->type == TYPE_FILE
+            ? L"File data sources are stored in a file and can be shared with any user who has the same driver installed."
+            : L"The data source is stored in the registry and is not shared with other machines.");
+    }
+    if (w->page == PAGE_DRIVER)
+    {
+        WCHAR *sel = list_sel_text(GetDlgItem(hwnd, IDC_WDRIVERS));
+        EnableWindow(GetDlgItem(hwnd, IDC_NEXT), sel != NULL);
+        free(sel);
+    }
+    else EnableWindow(GetDlgItem(hwnd, IDC_NEXT), TRUE);
+
+    if (w->page == PAGE_REVIEW) wiz_build_review(hwnd, w);
+    SendMessageW(hwnd, DM_SETDEFID, w->page == PAGE_REVIEW ? IDC_FINISH : IDC_NEXT, 0);
+}
+
+static BOOL wiz_next(HWND hwnd, struct wizard *w)
+{
+    switch (w->page)
+    {
+    case PAGE_TYPE:
+        w->type = IsDlgButtonChecked(hwnd, IDC_TYPE_FILE) ? TYPE_FILE
+                : IsDlgButtonChecked(hwnd, IDC_TYPE_SYSTEM) ? TYPE_SYSTEM : TYPE_USER;
+        w->page = PAGE_DRIVER;
+        break;
+    case PAGE_DRIVER:
+    {
+        WCHAR *sel = list_sel_text(GetDlgItem(hwnd, IDC_WDRIVERS));
+        if (!sel) return FALSE;
+        lstrcpynW(w->driver, sel, ARRAY_SIZE(w->driver));
+        free(sel);
+        w->page = w->type == TYPE_FILE ? PAGE_FILE : PAGE_REVIEW;
+        break;
+    }
+    case PAGE_FILE:
+    {
+        WCHAR name[MAX_PATH];
+        const WCHAR *ext;
+
+        GetDlgItemTextW(hwnd, IDC_FILENAME, name, ARRAY_SIZE(name));
+        if (!valid_file_name(name))
+        {
+            MessageBoxW(hwnd, L"The file name entered is not valid. Please enter a valid file name.",
+                        L"Create New Data Source", MB_OK | MB_ICONEXCLAMATION);
+            SetFocus(GetDlgItem(hwnd, IDC_FILENAME));
+            return FALSE;
+        }
+        ext = wcsrchr(name, '.');
+#ifndef ODBC_MUT_EXT
+        if ((!ext || wcsicmp(ext, L".dsn")) && wcslen(name) + 4 < MAX_PATH) wcscat(name, L".dsn");
+#endif
+        if (!wcschr(name, '\\') && !wcschr(name, '/') && wcslen(name) < MAX_PATH)
+        {
+            WCHAR dir[MAX_PATH], full[MAX_PATH];
+            get_filedsn_dir(dir);
+            if (wcslen(dir) + 1 + wcslen(name) < MAX_PATH)
+            {
+                swprintf(full, ARRAY_SIZE(full), L"%ls\\%ls", dir, name);
+                wcscpy(name, full);
+            }
+        }
+        wcscpy(w->file, name);
+        w->page = PAGE_REVIEW;
+        break;
+    }
+    }
+    wiz_show_page(hwnd, w);
+    return TRUE;
+}
+
+static void wiz_back(HWND hwnd, struct wizard *w)
+{
+    switch (w->page)
+    {
+    case PAGE_DRIVER: w->page = PAGE_TYPE; break;
+    case PAGE_FILE: w->page = PAGE_DRIVER; break;
+    case PAGE_REVIEW: w->page = w->type == TYPE_FILE ? PAGE_FILE : PAGE_DRIVER; break;
+    }
+    wiz_show_page(hwnd, w);
+}
+
+struct advanced
+{
+    WCHAR **text;
+    BOOL *verify;
+};
+
+static INT_PTR CALLBACK advanced_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct advanced *a;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        SetWindowLongPtrW(hwnd, DWLP_USER, lp);
+        a = (struct advanced *)lp;
+        if (*a->text) SetDlgItemTextW(hwnd, IDC_ADV_TEXT, *a->text);
+        CheckDlgButton(hwnd, IDC_VERIFY, *a->verify ? BST_CHECKED : BST_UNCHECKED);
+        return TRUE;
+    case WM_COMMAND:
+        a = (struct advanced *)GetWindowLongPtrW(hwnd, DWLP_USER);
+        if (LOWORD(wp) == IDOK)
+        {
+            int len = GetWindowTextLengthW(GetDlgItem(hwnd, IDC_ADV_TEXT));
+            WCHAR *s = calloc(len + 1, sizeof(WCHAR));
+            if (s)
+            {
+                GetDlgItemTextW(hwnd, IDC_ADV_TEXT, s, len + 1);
+                free(*a->text);
+                *a->text = s;
+            }
+            *a->verify = IsDlgButtonChecked(hwnd, IDC_VERIFY) == BST_CHECKED;
+            EndDialog(hwnd, IDOK);
+            return TRUE;
+        }
+        if (LOWORD(wp) == IDCANCEL) { EndDialog(hwnd, IDCANCEL); return TRUE; }
+        break;
+    }
+    return FALSE;
+}
+
+/* Walk the CR/LF separated keyword lines; cb gets each "key=value" (no DSN=). */
+static void advanced_lines(const WCHAR *adv, void (*cb)(const WCHAR *line, void *ctx), void *ctx)
+{
+    WCHAR *copy, *p;
+
+    if (!adv || !(copy = wcsdup(adv))) return;
+    p = copy;
+    while (*p)
+    {
+        WCHAR *line = p;
+        size_t n = wcscspn(p, L"\r\n");
+
+        p += n;
+        if (*p) *p++ = 0;
+        while (*line == ' ' || *line == '\t') line++;
+#ifdef ODBC_MUT_ADVDSN
+        if (!*line || !wcschr(line, '=')) continue;
+#else
+        if (!*line || !wcschr(line, '=') || !wcsnicmp(line, L"DSN=", 4)) continue;
+#endif
+        cb(line, ctx);
+    }
+    free(copy);
+}
+
+static void write_line_cb(const WCHAR *line, void *ctx)
+{
+    const WCHAR *file = ctx;
+    WCHAR *copy = wcsdup(line), *eq;
+
+    if (!copy) return;
+    eq = wcschr(copy, '=');
+    *eq = 0;
+    WritePrivateProfileStringW(L"ODBC", copy, eq + 1, file);
+    free(copy);
+}
+
+struct conn_build { WCHAR *buf; size_t len, cap; };
+
+static void conn_line_cb(const WCHAR *line, void *ctx)
+{
+    struct conn_build *c = ctx;
+    size_t n = wcslen(line);
+    if (c->len + n + 2 >= c->cap) return;
+    wcscpy(c->buf + c->len, line);
+    c->len += n;
+    c->buf[c->len++] = ';';
+    c->buf[c->len] = 0;
+}
+
+/* Keywords of the connection string the driver returned that a file DSN may keep
+ * (never DRIVER, SAVEFILE, FILEDSN or any password). */
+static void write_out_keywords(const WCHAR *out, const WCHAR *file)
+{
+    WCHAR *copy = wcsdup(out), *p, *next;
+
+    if (!copy) return;
+    for (p = copy; *p; p = next)
+    {
+        WCHAR *semi = wcschr(p, ';'), *eq;
+        if (semi) { *semi = 0; next = semi + 1; } else next = p + wcslen(p);
+        eq = wcschr(p, '=');
+        if (!eq || eq == p) continue;
+        *eq = 0;
+        if (!wcsicmp(p, L"DRIVER") || !wcsicmp(p, L"SAVEFILE") || !wcsicmp(p, L"FILEDSN") ||
+#ifndef ODBC_MUT_PWD
+            !wcsicmp(p, L"PWD") || !wcsicmp(p, L"PASSWORD") ||
+#endif
+            !wcsicmp(p, L"DSN")) continue;
+        WritePrivateProfileStringW(L"ODBC", p, eq + 1, file);
+    }
+    free(copy);
+}
+
+/* Connect through the driver registered in this prefix (the prefix's own
+ * ODBCINST.INI registry key; the host's ODBC configuration is never consulted)
+ * and, as a driver manager does for SAVEFILE, record the connection keywords
+ * the driver reports.  Returns TRUE if the connection succeeded. */
+static BOOL verify_file_dsn(HWND hwnd, struct wizard *w)
+{
+    SQLRETURN (WINAPI *alloc)(SQLSMALLINT, SQLHANDLE, SQLHANDLE *);
+    SQLRETURN (WINAPI *setenv)(SQLHENV, SQLINTEGER, SQLPOINTER, SQLINTEGER);
+    SQLRETURN (WINAPI *drvconn)(SQLHDBC, SQLHWND, SQLWCHAR *, SQLSMALLINT, SQLWCHAR *, SQLSMALLINT, SQLSMALLINT *, SQLUSMALLINT);
+    SQLRETURN (WINAPI *disc)(SQLHDBC);
+    SQLRETURN (WINAPI *freeh)(SQLSMALLINT, SQLHANDLE);
+    WCHAR key[300], *driver_file;
+    HMODULE mod;
+    SQLHANDLE env = NULL, dbc = NULL;
+    BOOL ok = FALSE;
+    struct conn_build c;
+    WCHAR out[1024] = L"";
+    SQLSMALLINT outlen = 0;
+    SQLRETURN r;
+
+    swprintf(key, ARRAY_SIZE(key), L"%ls\\%ls", odbcinst_key, w->driver);
+    if (!(driver_file = reg_query_string(HKEY_LOCAL_MACHINE, key, L"Driver"))) return FALSE;
+    mod = LoadLibraryExW(driver_file, NULL, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+    free(driver_file);
+    if (!mod) return FALSE;
+    alloc = (void *)GetProcAddress(mod, "SQLAllocHandle");
+    setenv = (void *)GetProcAddress(mod, "SQLSetEnvAttr");
+    drvconn = (void *)GetProcAddress(mod, "SQLDriverConnectW");
+    disc = (void *)GetProcAddress(mod, "SQLDisconnect");
+    freeh = (void *)GetProcAddress(mod, "SQLFreeHandle");
+    if (!alloc || !drvconn || !disc || !freeh) goto done;
+
+    c.cap = 2048 + (w->advanced ? wcslen(w->advanced) : 0);
+    c.len = 0;
+    if (!(c.buf = calloc(c.cap, sizeof(WCHAR)))) goto done;
+    advanced_lines(w->advanced, conn_line_cb, &c);
+
+    if (!SQL_SUCCEEDED(alloc(SQL_HANDLE_ENV, SQL_NULL_HANDLE, &env))) goto free_buf;
+    if (setenv) setenv(env, SQL_ATTR_ODBC_VERSION, (SQLPOINTER)SQL_OV_ODBC3, 0);
+    if (!SQL_SUCCEEDED(alloc(SQL_HANDLE_DBC, env, &dbc))) goto free_env;
+    r = drvconn(dbc, hwnd, c.buf, SQL_NTS, out, ARRAY_SIZE(out), &outlen, SQL_DRIVER_COMPLETE);
+    if (r == SQL_SUCCESS)
+    {
+        ok = TRUE;
+        out[ARRAY_SIZE(out) - 1] = 0;
+        w->out_keywords = wcsdup(out[0] ? out : c.buf);
+    }
+    if (SQL_SUCCEEDED(r)) disc(dbc);
+    freeh(SQL_HANDLE_DBC, dbc);
+free_env:
+    freeh(SQL_HANDLE_ENV, env);
+free_buf:
+    free(c.buf);
+done:
+    FreeLibrary(mod);
+    return ok;
+}
+
+static BOOL create_file_dsn(HWND hwnd, struct wizard *w)
+{
+#ifdef ODBC_MUT_VERIFY
+    if (0)
+#else
+    if (w->verify && !verify_file_dsn(hwnd, w))
+#endif
+    {
+        if (MessageBoxW(hwnd, L"A connection could not be made to the data source. Do you want to create the file data source anyway?",
+                        L"Create New Data Source", MB_YESNO | MB_ICONWARNING) != IDYES)
+        {
+            w->error = ODBC_ERROR_CREATE_DSN_FAILED;
+            w->error_msg = L"Could not create the requested DSN";
+            return FALSE;
+        }
+    }
+
+    /* the driver manager may already have written it; always make sure the file has the DRIVER keyword */
+    {
+        WCHAR dir[MAX_PATH], *sep;
+        WCHAR *p;
+        lstrcpynW(dir, w->file, ARRAY_SIZE(dir));
+        sep = wcsrchr(dir, '\\');
+        if (sep)
+        {
+            *sep = 0;
+            for (p = dir + 3; *p; p++)
+                if (*p == '\\') { *p = 0; CreateDirectoryW(dir, NULL); *p = '\\'; }
+            CreateDirectoryW(dir, NULL);
+        }
+    }
+    if (!WritePrivateProfileStringW(L"ODBC", L"DRIVER", w->driver, w->file))
+    {
+        WCHAR msg[MAX_PATH + 80];
+        swprintf(msg, ARRAY_SIZE(msg), L"The file %ls could not be written (error %lu).", w->file, GetLastError());
+        MessageBoxW(hwnd, msg, L"Create New Data Source", MB_OK | MB_ICONERROR);
+        w->error = ODBC_ERROR_CREATE_DSN_FAILED;
+        w->error_msg = L"Could not create the requested DSN";
+        return FALSE;
+    }
+    if (w->out_keywords) write_out_keywords(w->out_keywords, w->file);
+    else advanced_lines(w->advanced, write_line_cb, w->file);
+    return TRUE;
+}
+
+static BOOL wiz_finish(HWND hwnd, struct wizard *w)
+{
+    if (w->type == TYPE_FILE) return create_file_dsn(hwnd, w);
+    else
+    {
+        WCHAR attrs[SQL_MAX_DSN_LENGTH + 16];
+        BOOL ret;
+
+        memset(attrs, 0, sizeof(attrs));
+        if (w->dsn && *w->dsn) swprintf(attrs, ARRAY_SIZE(attrs) - 2, L"DSN=%ls", w->dsn);
+        ret = SQLConfigDataSourceW(hwnd, w->type == TYPE_SYSTEM ? ODBC_ADD_SYS_DSN : ODBC_ADD_DSN, w->driver, attrs);
+        if (!ret)
+        {
+            w->error = ODBC_ERROR_REQUEST_FAILED;
+            w->error_msg = L"Request Failed";
+        }
+        return ret;
+    }
+}
+
+static INT_PTR CALLBACK wizard_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct wizard *w;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        w = (struct wizard *)lp;
+        SetWindowLongPtrW(hwnd, DWLP_USER, lp);
+        CheckRadioButton(hwnd, IDC_TYPE_USER, IDC_TYPE_FILE,
+                         w->type == TYPE_USER ? IDC_TYPE_USER : w->type == TYPE_SYSTEM ? IDC_TYPE_SYSTEM : IDC_TYPE_FILE);
+        fill_driver_list(GetDlgItem(hwnd, IDC_WDRIVERS));
+        wiz_show_page(hwnd, w);
+        return TRUE;
+    case WM_COMMAND:
+        w = (struct wizard *)GetWindowLongPtrW(hwnd, DWLP_USER);
+        switch (LOWORD(wp))
+        {
+        case IDC_TYPE_USER:
+        case IDC_TYPE_SYSTEM:
+        case IDC_TYPE_FILE:
+            w->type = LOWORD(wp) == IDC_TYPE_FILE ? TYPE_FILE : LOWORD(wp) == IDC_TYPE_SYSTEM ? TYPE_SYSTEM : TYPE_USER;
+            wiz_show_page(hwnd, w);
+            return TRUE;
+        case IDC_WDRIVERS:
+            if (HIWORD(wp) == LBN_SELCHANGE) EnableWindow(GetDlgItem(hwnd, IDC_NEXT), TRUE);
+            else if (HIWORD(wp) == LBN_DBLCLK) wiz_next(hwnd, w);
+            return TRUE;
+        case IDC_NEXT:
+            wiz_next(hwnd, w);
+            return TRUE;
+        case IDC_BACK:
+            wiz_back(hwnd, w);
+            return TRUE;
+        case IDC_ADVANCED:
+        {
+            struct advanced a = { &w->advanced, &w->verify };
+            DialogBoxParamW(hinstance, MAKEINTRESOURCEW(IDD_ADVANCED), hwnd, advanced_proc, (LPARAM)&a);
+            return TRUE;
+        }
+        case IDC_BROWSE:
+        {
+            OPENFILENAMEW ofn = { sizeof(ofn) };
+            WCHAR file[MAX_PATH], dir[MAX_PATH];
+
+            GetDlgItemTextW(hwnd, IDC_FILENAME, file, ARRAY_SIZE(file));
+            get_filedsn_dir(dir);
+            ofn.hwndOwner = hwnd;
+            ofn.lpstrFilter = L"File DSN (*.dsn)\0*.dsn\0All files (*.*)\0*.*\0";
+            ofn.lpstrFile = file;
+            ofn.nMaxFile = ARRAY_SIZE(file);
+            ofn.lpstrInitialDir = dir;
+            ofn.lpstrDefExt = L"dsn";
+            ofn.Flags = OFN_OVERWRITEPROMPT | OFN_HIDEREADONLY | OFN_NOCHANGEDIR;
+            if (GetSaveFileNameW(&ofn)) SetDlgItemTextW(hwnd, IDC_FILENAME, file);
+            return TRUE;
+        }
+        case IDC_FINISH:
+            if (wiz_finish(hwnd, w)) EndDialog(hwnd, IDOK);
+            else EndDialog(hwnd, IDABORT);
+            return TRUE;
+        case IDCANCEL:
+            EndDialog(hwnd, IDCANCEL);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+static BOOL run_wizard(HWND hwnd, const WCHAR *dsn, int type, int first_page)
+{
+    struct wizard w = { dsn, type, first_page, first_page };
+    INT_PTR res;
+
+    w.verify = TRUE;
+    init_controls();
+    res = DialogBoxParamW(hinstance, MAKEINTRESOURCEW(IDD_WIZARD), hwnd, wizard_proc, (LPARAM)&w);
+    free(w.advanced);
+    free(w.out_keywords);
+    if (res == IDOK) return TRUE;
+    if (res == IDABORT) odbc_push_error(w.error, w.error_msg);
+#ifdef ODBC_MUT_CANCEL
+    else if (res == IDCANCEL) odbc_push_error(ODBC_ERROR_GENERAL_ERR, L"User cancelled");
+#else
+    else if (res == IDCANCEL) odbc_push_error(ODBC_ERROR_USER_CANCELED, L"User cancelled");
+#endif
+    else odbc_push_error(ODBC_ERROR_GENERAL_ERR, L"General error");
+    return FALSE;
+}
+
+BOOL WINAPI SQLCreateDataSourceW(HWND hwnd, LPCWSTR lpszDS)
+{
+    odbc_clear_errors();
+    TRACE("%p %s\n", hwnd, debugstr_w(lpszDS));
+
+    if (!hwnd || !IsWindow(hwnd))
+    {
+        odbc_push_error(ODBC_ERROR_INVALID_HWND, L"Invalid window handle");
+        return FALSE;
+    }
+    if (lpszDS && *lpszDS && !SQLValidDSNW(lpszDS))
+    {
+        odbc_clear_errors();
+        odbc_push_error(ODBC_ERROR_INVALID_DSN, L"Invalid DSN");
+        return FALSE;
+    }
+#ifdef ODBC_MUT_DEFTYPE
+    return run_wizard(hwnd, lpszDS, TYPE_USER, PAGE_TYPE);
+#endif
+    return run_wizard(hwnd, lpszDS, TYPE_FILE, PAGE_TYPE);
+}
+
+BOOL WINAPI SQLCreateDataSource(HWND hwnd, LPCSTR lpszDS)
+{
+    WCHAR *dsn = NULL;
+    BOOL ret;
+
+    if (lpszDS)
+    {
+        int len = MultiByteToWideChar(CP_ACP, 0, lpszDS, -1, NULL, 0);
+        if (!(dsn = malloc(len * sizeof(WCHAR))))
+        {
+            odbc_clear_errors();
+            odbc_push_error(ODBC_ERROR_OUT_OF_MEM, L"Out of memory");
+            return FALSE;
+        }
+        MultiByteToWideChar(CP_ACP, 0, lpszDS, -1, dsn, len);
+    }
+    ret = SQLCreateDataSourceW(hwnd, dsn);
+    free(dsn);
+    return ret;
+}
+
+/* ---- ODBC Data Source Administrator ------------------------------------- */
+
+enum { TAB_USER, TAB_SYSTEM, TAB_FILE, TAB_DRIVERS, TAB_TRACING };
+
+struct manage
+{
+    int tab;
+    WCHAR filedir[MAX_PATH];
+};
+
+static void list_set_columns(HWND list, int tab)
+{
+    static const WCHAR *dsn_cols[] = { L"Name", L"Driver" };
+    static const WCHAR *file_cols[] = { L"Name", L"Folder" };
+    static const WCHAR *drv_cols[] = { L"Name", L"Driver file", L"Date" };
+    const WCHAR **cols = tab == TAB_FILE ? file_cols : tab == TAB_DRIVERS ? drv_cols : dsn_cols;
+    int i, n = tab == TAB_DRIVERS ? 3 : 2;
+    LVCOLUMNW col = { LVCF_TEXT | LVCF_WIDTH };
+
+    while (SendMessageW(list, LVM_DELETECOLUMN, 0, 0)) ;
+    for (i = 0; i < n; i++)
+    {
+        col.pszText = (WCHAR *)cols[i];
+        col.cx = i == 0 ? 90 : 70;
+        SendMessageW(list, LVM_INSERTCOLUMNW, i, (LPARAM)&col);
+    }
+}
+
+static void list_add_row(HWND list, const WCHAR *c0, const WCHAR *c1, const WCHAR *c2)
+{
+    LVITEMW item = { LVIF_TEXT };
+    int idx = SendMessageW(list, LVM_GETITEMCOUNT, 0, 0);
+
+    item.iItem = idx;
+    item.pszText = (WCHAR *)c0;
+    SendMessageW(list, LVM_INSERTITEMW, 0, (LPARAM)&item);
+    if (c1) { item.iSubItem = 1; item.pszText = (WCHAR *)c1; SendMessageW(list, LVM_SETITEMTEXTW, idx, (LPARAM)&item); }
+    if (c2) { item.iSubItem = 2; item.pszText = (WCHAR *)c2; SendMessageW(list, LVM_SETITEMTEXTW, idx, (LPARAM)&item); }
+}
+
+static void dsn_row_cb(const WCHAR *name, const WCHAR *data, void *ctx)
+{
+    list_add_row(ctx, name, data, NULL);
+}
+
+static void driver_row_cb(const WCHAR *name, const WCHAR *data, void *ctx)
+{
+    WCHAR key[300], date[64] = L"";
+    WCHAR *file;
+    WIN32_FILE_ATTRIBUTE_DATA fad;
+
+    swprintf(key, ARRAY_SIZE(key), L"%ls\\%ls", odbcinst_key, name);
+    file = reg_query_string(HKEY_LOCAL_MACHINE, key, L"Driver");
+    if (file && GetFileAttributesExW(file, GetFileExInfoStandard, &fad))
+    {
+        SYSTEMTIME st;
+        FILETIME lft;
+        FileTimeToLocalFileTime(&fad.ftCreationTime, &lft);
+        if (FileTimeToSystemTime(&lft, &st)) swprintf(date, ARRAY_SIZE(date), L"%04u-%02u-%02u", st.wYear, st.wMonth, st.wDay);
+    }
+    list_add_row(ctx, name, file ? file : L"", date);
+    free(file);
+}
+
+static void manage_update_buttons(HWND hwnd, struct manage *m)
+{
+    HWND list = GetDlgItem(hwnd, IDC_LIST);
+    BOOL sel = SendMessageW(list, LVM_GETNEXTITEM, -1, LVNI_SELECTED) >= 0;
+
+    EnableWindow(GetDlgItem(hwnd, IDC_ADD), m->tab <= TAB_FILE);
+    EnableWindow(GetDlgItem(hwnd, IDC_REMOVE), m->tab <= TAB_FILE && sel);
+    EnableWindow(GetDlgItem(hwnd, IDC_CONFIGURE), m->tab <= TAB_SYSTEM && sel);
+}
+
+static void manage_fill(HWND hwnd, struct manage *m)
+{
+    HWND list = GetDlgItem(hwnd, IDC_LIST);
+    BOOL tracing = m->tab == TAB_TRACING;
+    int id;
+
+    SendMessageW(list, LVM_DELETEALLITEMS, 0, 0);
+    list_set_columns(list, m->tab);
+
+    if (m->tab == TAB_USER || m->tab == TAB_SYSTEM)
+    {
+        WCHAR key[100];
+        swprintf(key, ARRAY_SIZE(key), L"%ls\\ODBC Data Sources", odbcini_key);
+        enum_values(m->tab == TAB_USER ? HKEY_CURRENT_USER : HKEY_LOCAL_MACHINE, key, dsn_row_cb, list);
+        SetDlgItemTextW(hwnd, IDC_DESC, m->tab == TAB_USER
+            ? L"A User data source stores information about how to connect to the indicated data provider. A User data source is only visible to you, and can only be used on the current machine."
+            : L"A System data source stores information about how to connect to the indicated data provider. A System data source is visible to all users on this machine, including NT services.");
+    }
+    else if (m->tab == TAB_FILE)
+    {
+        WCHAR pattern[MAX_PATH + 8];
+        WIN32_FIND_DATAW fd;
+        HANDLE h;
+
+        swprintf(pattern, ARRAY_SIZE(pattern), L"%ls\\*.dsn", m->filedir);
+        if ((h = FindFirstFileW(pattern, &fd)) != INVALID_HANDLE_VALUE)
+        {
+            do { if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) list_add_row(list, fd.cFileName, m->filedir, NULL); }
+            while (FindNextFileW(h, &fd));
+            FindClose(h);
+        }
+        SetDlgItemTextW(hwnd, IDC_DESC, L"A File data source stores its connection information in a file that can be shared with any user who has the same driver installed.");
+    }
+    else if (m->tab == TAB_DRIVERS)
+    {
+        enum_values(HKEY_LOCAL_MACHINE, L"Software\\ODBC\\ODBCINST.INI\\ODBC Drivers", driver_row_cb, list);
+        SetDlgItemTextW(hwnd, IDC_DESC, L"An ODBC driver allows ODBC-enabled programs to get information from ODBC data sources. Drivers are installed by their setup programs.");
+    }
+    SetDlgItemTextW(hwnd, IDC_FILEDIR, m->tab == TAB_FILE ? m->filedir : L"");
+
+    for (id = IDC_LIST; id <= IDC_CONFIGURE; id++) show_ctl(hwnd, id, !tracing);
+    show_ctl(hwnd, IDC_DESC, !tracing);
+    show_ctl(hwnd, IDC_FILEDIR, !tracing);
+    show_ctl(hwnd, IDC_TRACE_ON, tracing);
+    show_ctl(hwnd, IDC_TRACE_LABEL, tracing);
+    show_ctl(hwnd, IDC_TRACE_FILE, tracing);
+    manage_update_buttons(hwnd, m);
+}
+
+static WCHAR *manage_selected(HWND hwnd, int sub)
+{
+    HWND list = GetDlgItem(hwnd, IDC_LIST);
+    int idx = SendMessageW(list, LVM_GETNEXTITEM, -1, LVNI_SELECTED);
+    WCHAR *buf = calloc(MAX_PATH, sizeof(WCHAR));
+    LVITEMW item = { 0 };
+
+    if (idx < 0 || !buf) { free(buf); return NULL; }
+    item.iSubItem = sub;
+    item.pszText = buf;
+    item.cchTextMax = MAX_PATH;
+    SendMessageW(list, LVM_GETITEMTEXTW, idx, (LPARAM)&item);
+    return buf;
+}
+
+static void manage_error_box(HWND hwnd, const WCHAR *what)
+{
+    DWORD code = 0;
+    WCHAR msg[200];
+
+    if (SQLInstallerErrorW(1, &code, NULL, 0, NULL) == SQL_NO_DATA) return;
+    if (code == ODBC_ERROR_REQUEST_FAILED || code == ODBC_ERROR_USER_CANCELED) return;
+    swprintf(msg, ARRAY_SIZE(msg), L"%ls failed: the driver setup library could not be used (installer error %lu).", what, code);
+    MessageBoxW(hwnd, msg, L"ODBC Data Source Administrator", MB_OK | MB_ICONERROR);
+}
+
+static void manage_add(HWND hwnd, struct manage *m)
+{
+    if (m->tab == TAB_FILE)
+    {
+        if (run_wizard(hwnd, NULL, TYPE_FILE, PAGE_DRIVER)) manage_fill(hwnd, m);
+        return;
+    }
+    {
+        INT_PTR res;
+        WCHAR *driver;
+        struct { WCHAR *driver; } pick = { NULL };
+
+        res = DialogBoxParamW(hinstance, MAKEINTRESOURCEW(IDD_PICKDRIVER), hwnd, odbc_pickdriver_proc, (LPARAM)&pick);
+        driver = pick.driver;
+        if (res == IDOK && driver)
+        {
+            WCHAR none[2] = { 0, 0 };
+            BOOL ret = SQLConfigDataSourceW(hwnd, m->tab == TAB_SYSTEM ? ODBC_ADD_SYS_DSN : ODBC_ADD_DSN, driver, none);
+            if (!ret) manage_error_box(hwnd, L"Adding the data source");
+            manage_fill(hwnd, m);
+        }
+        free(driver);
+    }
+}
+
+static void manage_remove(HWND hwnd, struct manage *m)
+{
+    WCHAR *name = manage_selected(hwnd, 0), msg[MAX_PATH + 100];
+
+    if (!name) return;
+    if (m->tab == TAB_FILE)
+    {
+        WCHAR path[2 * MAX_PATH];
+        swprintf(msg, ARRAY_SIZE(msg), L"Are you sure you want to remove the file data source %ls?", name);
+        if (MessageBoxW(hwnd, msg, L"ODBC Data Source Administrator", MB_YESNO | MB_ICONQUESTION) == IDYES)
+        {
+            swprintf(path, ARRAY_SIZE(path), L"%ls\\%ls", m->filedir, name);
+            DeleteFileW(path);
+            manage_fill(hwnd, m);
+        }
+    }
+    else
+    {
+        WCHAR *driver = manage_selected(hwnd, 1), attrs[SQL_MAX_DSN_LENGTH + 16] = { 0 };
+
+        swprintf(msg, ARRAY_SIZE(msg), L"Are you sure you want to remove the data source %ls?", name);
+        if (driver && MessageBoxW(hwnd, msg, L"ODBC Data Source Administrator", MB_YESNO | MB_ICONQUESTION) == IDYES)
+        {
+            UWORD mode;
+            swprintf(attrs, ARRAY_SIZE(attrs) - 2, L"DSN=%ls", name);
+#ifdef ODBC_MUT_REMOVE
+            if (1)
+#else
+            if (!SQLConfigDataSourceW(hwnd, m->tab == TAB_SYSTEM ? ODBC_REMOVE_SYS_DSN : ODBC_REMOVE_DSN, driver, attrs))
+#endif
+            {
+                /* driver (or its setup library) is gone: remove the registry entries ourselves */
+                SQLGetConfigMode(&mode);
+                SQLSetConfigMode(m->tab == TAB_SYSTEM ? ODBC_SYSTEM_DSN : ODBC_USER_DSN);
+                SQLRemoveDSNFromIniW(name);
+                SQLSetConfigMode(mode);
+            }
+            manage_fill(hwnd, m);
+        }
+        free(driver);
+    }
+    free(name);
+}
+
+static void manage_configure(HWND hwnd, struct manage *m)
+{
+    WCHAR *name = manage_selected(hwnd, 0), *driver = manage_selected(hwnd, 1), attrs[SQL_MAX_DSN_LENGTH + 16] = { 0 };
+
+    if (name && driver)
+    {
+        swprintf(attrs, ARRAY_SIZE(attrs) - 2, L"DSN=%ls", name);
+        if (!SQLConfigDataSourceW(hwnd, m->tab == TAB_SYSTEM ? ODBC_CONFIG_SYS_DSN : ODBC_CONFIG_DSN, driver, attrs))
+            manage_error_box(hwnd, L"Configuring the data source");
+        manage_fill(hwnd, m);
+    }
+    free(name);
+    free(driver);
+}
+
+static void trace_load(HWND hwnd)
+{
+    WCHAR *file = reg_query_string(HKEY_LOCAL_MACHINE, L"Software\\ODBC\\ODBC.INI\\ODBC", L"TraceFile");
+    WCHAR *on = reg_query_string(HKEY_LOCAL_MACHINE, L"Software\\ODBC\\ODBC.INI\\ODBC", L"Trace");
+
+    if (file) SetDlgItemTextW(hwnd, IDC_TRACE_FILE, file);
+    CheckDlgButton(hwnd, IDC_TRACE_ON, on && (!wcsicmp(on, L"1") || !wcsicmp(on, L"Yes") || !wcsicmp(on, L"On")) ? BST_CHECKED : BST_UNCHECKED);
+    free(file);
+    free(on);
+}
+
+static void trace_save(HWND hwnd)
+{
+    WCHAR file[MAX_PATH];
+    HKEY key;
+    const WCHAR *on = IsDlgButtonChecked(hwnd, IDC_TRACE_ON) == BST_CHECKED ? L"1" : L"0";
+
+    GetDlgItemTextW(hwnd, IDC_TRACE_FILE, file, ARRAY_SIZE(file));
+    if (RegCreateKeyExW(HKEY_LOCAL_MACHINE, L"Software\\ODBC\\ODBC.INI\\ODBC", 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL)) return;
+    RegSetValueExW(key, L"Trace", 0, REG_SZ, (const BYTE *)on, 2 * sizeof(WCHAR));
+    if (*file) RegSetValueExW(key, L"TraceFile", 0, REG_SZ, (const BYTE *)file, (wcslen(file) + 1) * sizeof(WCHAR));
+    RegCloseKey(key);
+}
+
+static INT_PTR CALLBACK manage_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct manage *m;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        static const WCHAR *tabs[] = { L"User DSN", L"System DSN", L"File DSN", L"Drivers", L"Tracing" };
+        HWND tab = GetDlgItem(hwnd, IDC_TAB);
+        TCITEMW ti = { TCIF_TEXT };
+        int i;
+
+        m = (struct manage *)lp;
+        SetWindowLongPtrW(hwnd, DWLP_USER, lp);
+        for (i = 0; i < ARRAY_SIZE(tabs); i++)
+        {
+            ti.pszText = (WCHAR *)tabs[i];
+            SendMessageW(tab, TCM_INSERTITEMW, i, (LPARAM)&ti);
+        }
+        SendMessageW(GetDlgItem(hwnd, IDC_LIST), LVM_SETEXTENDEDLISTVIEWSTYLE, LVS_EX_FULLROWSELECT, LVS_EX_FULLROWSELECT);
+        get_filedsn_dir(m->filedir);
+        trace_load(hwnd);
+        manage_fill(hwnd, m);
+        return TRUE;
+    }
+    case WM_NOTIFY:
+    {
+        NMHDR *hdr = (NMHDR *)lp;
+        m = (struct manage *)GetWindowLongPtrW(hwnd, DWLP_USER);
+        if (hdr->idFrom == IDC_TAB && hdr->code == TCN_SELCHANGE)
+        {
+            m->tab = SendMessageW(GetDlgItem(hwnd, IDC_TAB), TCM_GETCURSEL, 0, 0);
+            manage_fill(hwnd, m);
+        }
+        else if (hdr->idFrom == IDC_LIST && (hdr->code == LVN_ITEMCHANGED))
+            manage_update_buttons(hwnd, m);
+        else if (hdr->idFrom == IDC_LIST && hdr->code == NM_DBLCLK && m->tab <= TAB_SYSTEM)
+            manage_configure(hwnd, m);
+        return TRUE;
+    }
+    case WM_COMMAND:
+        m = (struct manage *)GetWindowLongPtrW(hwnd, DWLP_USER);
+        switch (LOWORD(wp))
+        {
+        case IDC_ADD: manage_add(hwnd, m); return TRUE;
+        case IDC_REMOVE: manage_remove(hwnd, m); return TRUE;
+        case IDC_CONFIGURE: manage_configure(hwnd, m); return TRUE;
+        case IDOK: trace_save(hwnd); EndDialog(hwnd, IDOK); return TRUE;
+        case IDCANCEL: EndDialog(hwnd, IDCANCEL); return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+INT_PTR CALLBACK odbc_pickdriver_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct { WCHAR *driver; } *p;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        SetWindowLongPtrW(hwnd, DWLP_USER, lp);
+        fill_driver_list(GetDlgItem(hwnd, IDC_DRIVERLIST));
+        return TRUE;
+    case WM_COMMAND:
+        p = (void *)GetWindowLongPtrW(hwnd, DWLP_USER);
+        if (LOWORD(wp) == IDC_DRIVERLIST && HIWORD(wp) == LBN_DBLCLK) wp = IDOK;
+        if (LOWORD(wp) == IDOK)
+        {
+            if (!(p->driver = list_sel_text(GetDlgItem(hwnd, IDC_DRIVERLIST)))) return TRUE;
+            EndDialog(hwnd, IDOK);
+            return TRUE;
+        }
+        if (LOWORD(wp) == IDCANCEL) { EndDialog(hwnd, IDCANCEL); return TRUE; }
+        break;
+    }
+    return FALSE;
+}
+
+BOOL WINAPI SQLManageDataSources(HWND hwnd)
+{
+    struct manage m = { 0 };
+
+    odbc_clear_errors();
+    TRACE("%p\n", hwnd);
+
+#ifndef ODBC_MUT_MHWND
+    if (!hwnd || !IsWindow(hwnd))
+    {
+        odbc_push_error(ODBC_ERROR_INVALID_HWND, L"Invalid window handle");
+        return FALSE;
+    }
+#endif
+    init_controls();
+    DialogBoxParamW(hinstance, MAKEINTRESOURCEW(IDD_MANAGE), hwnd, manage_proc, (LPARAM)&m);
+    return TRUE;
+}
+
+/* ---- SQLGetTranslator ---------------------------------------------------- */
+
+struct translator_pick
+{
+    WCHAR name[256];
+    WCHAR path[MAX_PATH];
+    DWORD option;
+    BOOL none;
+    int error;
+    const WCHAR *error_msg;
+    const WCHAR *preselect;
+};
+
+static BOOL (WINAPI *get_config_translator(const WCHAR *name, struct translator_pick *t, HMODULE *mod))(HWND, DWORD *)
+{
+    WCHAR key[300], *setup;
+    BOOL (WINAPI *fn)(HWND, DWORD *);
+
+    swprintf(key, ARRAY_SIZE(key), L"%ls\\%ls", odbcinst_key, name);
+    setup = reg_query_string(HKEY_LOCAL_MACHINE, key, L"Setup");
+    if (!setup) setup = reg_query_string(HKEY_LOCAL_MACHINE, key, L"Translator");
+    if (!setup) { t->error = ODBC_ERROR_INVALID_NAME; t->error_msg = L"Invalid driver or translator name"; return NULL; }
+    *mod = LoadLibraryExW(setup, NULL, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+    free(setup);
+    if (!*mod) { t->error = ODBC_ERROR_LOAD_LIB_FAILED; t->error_msg = L"Load Library Failed"; return NULL; }
+    fn = (void *)GetProcAddress(*mod, "ConfigTranslator");
+    if (!fn) { FreeLibrary(*mod); *mod = NULL; t->error = ODBC_ERROR_LOAD_LIB_FAILED; t->error_msg = L"Load Library Failed"; }
+    return fn;
+}
+
+static INT_PTR CALLBACK translator_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct translator_pick *t;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        HWND list = GetDlgItem(hwnd, IDC_TRANSLIST);
+        LRESULT sel = 0;
+
+        t = (struct translator_pick *)lp;
+        SetWindowLongPtrW(hwnd, DWLP_USER, lp);
+        SendMessageW(list, LB_ADDSTRING, 0, (LPARAM)L"<No Translator>");
+        enum_values(HKEY_LOCAL_MACHINE, L"Software\\ODBC\\ODBCINST.INI\\ODBC Translators", add_list_cb, list);
+        if (t->preselect && *t->preselect)
+        {
+            LRESULT i = SendMessageW(list, LB_FINDSTRINGEXACT, 0, (LPARAM)t->preselect);
+            if (i != LB_ERR) sel = i;
+        }
+        SendMessageW(list, LB_SETCURSEL, sel, 0);
+        return TRUE;
+    }
+    case WM_COMMAND:
+        t = (struct translator_pick *)GetWindowLongPtrW(hwnd, DWLP_USER);
+        if (LOWORD(wp) == IDC_TRANSLIST && HIWORD(wp) == LBN_DBLCLK) wp = IDOK;
+        if (LOWORD(wp) == IDOK)
+        {
+            HWND list = GetDlgItem(hwnd, IDC_TRANSLIST);
+            WCHAR *name;
+            BOOL (WINAPI *config)(HWND, DWORD *);
+            HMODULE mod = NULL;
+            DWORD option = 0;
+            WCHAR key[300];
+
+            if (SendMessageW(list, LB_GETCURSEL, 0, 0) == 0)
+            {
+                t->none = TRUE;
+                EndDialog(hwnd, IDOK);
+                return TRUE;
+            }
+            if (!(name = list_sel_text(list))) return TRUE;
+            if (!(config = get_config_translator(name, t, &mod)))
+            {
+                free(name);
+                EndDialog(hwnd, IDABORT);
+                return TRUE;
+            }
+            if (!config(hwnd, &option))
+            {
+                /* the translator's setup refused or was cancelled: back to the dialog */
+                FreeLibrary(mod);
+                free(name);
+                return TRUE;
+            }
+            FreeLibrary(mod);
+            lstrcpynW(t->name, name, ARRAY_SIZE(t->name));
+            swprintf(key, ARRAY_SIZE(key), L"%ls\\%ls", odbcinst_key, name);
+            {
+                WCHAR *path = reg_query_string(HKEY_LOCAL_MACHINE, key, L"Translator");
+                if (path) { lstrcpynW(t->path, path, ARRAY_SIZE(t->path)); free(path); }
+                else t->path[0] = 0;
+            }
+            t->option = option;
+            free(name);
+            EndDialog(hwnd, IDOK);
+            return TRUE;
+        }
+        if (LOWORD(wp) == IDCANCEL) { EndDialog(hwnd, IDCANCEL); return TRUE; }
+        break;
+    }
+    return FALSE;
+}
+
+static void copy_out(BOOL wide, const WCHAR *src, void *buf, WORD max, WORD *out)
+{
+    int len;
+
+    if (wide)
+    {
+        len = wcslen(src);
+        if (out) *out = len;
+#ifndef ODBC_MUT_TRUNC
+        if (len >= max) len = max - 1;
+#endif
+        memcpy(buf, src, len * sizeof(WCHAR));
+        ((WCHAR *)buf)[len] = 0;
+    }
+    else
+    {
+        char tmp[2 * MAX_PATH];
+        int n = WideCharToMultiByte(CP_ACP, 0, src, -1, tmp, sizeof(tmp), NULL, NULL);
+        len = n > 0 ? n - 1 : 0;
+        if (out) *out = len;
+#ifndef ODBC_MUT_TRUNC
+        if (len >= max) len = max - 1;
+#endif
+        memcpy(buf, tmp, len);
+        ((char *)buf)[len] = 0;
+    }
+}
+
+static BOOL get_translator(BOOL wide, HWND hwnd, void *name, WORD name_max, WORD *name_out,
+                           void *path, WORD path_max, WORD *path_out, DWORD *option)
+{
+    struct translator_pick t = { { 0 } };
+    WCHAR initial[256] = L"";
+    INT_PTR res;
+
+    odbc_clear_errors();
+
+    if (!hwnd || !IsWindow(hwnd))
+    {
+        odbc_push_error(ODBC_ERROR_INVALID_HWND, L"Invalid window handle");
+        return FALSE;
+    }
+    if (!name || !path || !option) return FALSE;
+    if (!name_max || !path_max || (short)name_max <= 0 || (short)path_max <= 0)
+    {
+        odbc_push_error(ODBC_ERROR_INVALID_BUFF_LEN, L"Invalid buffer length");
+        return FALSE;
+    }
+
+    if (wide) lstrcpynW(initial, name, ARRAY_SIZE(initial));
+    else MultiByteToWideChar(CP_ACP, 0, name, -1, initial, ARRAY_SIZE(initial));
+    t.preselect = initial;
+
+    init_controls();
+    res = DialogBoxParamW(hinstance, MAKEINTRESOURCEW(IDD_TRANSLATOR), hwnd, translator_proc, (LPARAM)&t);
+    if (res == IDABORT)
+    {
+        odbc_push_error(t.error, t.error_msg);
+        return FALSE;
+    }
+    if (res != IDOK) return FALSE;      /* cancelled: Windows returns FALSE */
+
+    if (t.none)
+    {
+#ifdef ODBC_MUT_NONE
+        copy_out(wide, L"junk", name, name_max, name_out);
+#endif
+        if (name_out) *name_out = 0;
+        if (path_out) *path_out = 0;
+        return TRUE;
+    }
+    copy_out(wide, t.name, name, name_max, name_out);
+    copy_out(wide, t.path, path, path_max, path_out);
+    *option = t.option;
+    return TRUE;
+}
+
+BOOL WINAPI SQLGetTranslatorW(HWND hwnd, LPWSTR name, WORD name_max, WORD *name_out,
+                              LPWSTR path, WORD path_max, WORD *path_out, DWORD *option)
+{
+    TRACE("%p %s %d %p %p %d %p %p\n", hwnd, debugstr_w(name), name_max, name_out, path, path_max, path_out, option);
+    return get_translator(TRUE, hwnd, name, name_max, name_out, path, path_max, path_out, option);
+}
+
+BOOL WINAPI SQLGetTranslator(HWND hwnd, LPSTR name, WORD name_max, WORD *name_out,
+                             LPSTR path, WORD path_max, WORD *path_out, DWORD *option)
+{
+    TRACE("%p %s %d %p %p %d %p %p\n", hwnd, debugstr_a(name), name_max, name_out, path, path_max, path_out, option);
+    return get_translator(FALSE, hwnd, name, name_max, name_out, path, path_max, path_out, option);
+}
