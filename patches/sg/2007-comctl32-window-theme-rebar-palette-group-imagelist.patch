From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comctl32: CCM_SETWINDOWTHEME on the common controls, rebar palette, listview group header image list

comctl32: CCM_SETWINDOWTHEME on the common controls, rebar palette, listview group header image list

Sixteen comctl32 controls ignored CCM_SETWINDOWTHEME (TB_/TTM_/RB_/
CBEM_SETWINDOWTHEME): they now apply SetWindowTheme with the sub-app name
and return its result; ComboBoxEx also themes its combo box and edit.
RB_SETPALETTE / RB_GETPALETTE keep the program's palette and select it
while the rebar paints. The list view stores the LVSIL_GROUPHEADER image
list (destroyed with the control unless LVS_SHAREIMAGELISTS). The stale
PrintClient FIXMEs are gone; behaviour there is unchanged.

Gate: test/comctlstub-gate.sh, mutants NOTHEME, COMBOEX_CHILD,
PALETTE_STORE, PALETTE_SELECT, GROUPIML.
---
--- a/dlls/comctl32/comboex.c
+++ b/dlls/comctl32/comboex.c
@@ -28,6 +28,7 @@
 #include "winuser.h"
 #include "winnls.h"
 #include "commctrl.h"
+#include "uxtheme.h"
 #include "comctl32.h"
 #include "wine/debug.h"
 
@@ -2044,8 +2045,16 @@ COMBOEX_WindowProc (HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
 	case CBEM_SETUNICODEFORMAT:
 	    return COMBOEX_SetUnicodeFormat (infoPtr, wParam);
 
-	/*case CBEM_SETWINDOWTHEME:
-	    FIXME("CBEM_SETWINDOWTHEME: stub\n");*/
+	case CBEM_SETWINDOWTHEME:
+	{
+	    /* the visual style follows to the combo box and the edit within it */
+	    HRESULT hr = SetWindowTheme (hwnd, (const WCHAR *)lParam, NULL);
+#ifndef SG_MUTANT_COMBOEX_CHILD
+	    if (SUCCEEDED(hr) && infoPtr->hwndCombo) hr = SetWindowTheme (infoPtr->hwndCombo, (const WCHAR *)lParam, NULL);
+	    if (SUCCEEDED(hr) && infoPtr->hwndEdit) hr = SetWindowTheme (infoPtr->hwndEdit, (const WCHAR *)lParam, NULL);
+#endif
+	    return hr;
+	}
 
 	case WM_SETTEXT:
 	case WM_GETTEXT:
--- a/dlls/comctl32/datetime.c
+++ b/dlls/comctl32/datetime.c
