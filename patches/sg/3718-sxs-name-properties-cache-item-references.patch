+/* split "a.b.c.d" into up to four components, returns how many there are */
+static unsigned int split_version( const WCHAR *str, WORD ver[4] )
+{
+    unsigned int i;
+    WCHAR *end;
+
+    memset( ver, 0, 4 * sizeof(WORD) );
+    if (!str || !*str) return 0;
+    for (i = 0; i < 4; i++)
+    {
+        ver[i] = wcstoul( str, &end, 10 );
+        if (*end != '.') return i + 1;
+        str = end + 1;
+    }
+    return 4;
+}
+
+static BOOL token_to_bytes( const WCHAR *str, BYTE bytes[8] )
+{
+    unsigned int i;
+
+    if (!str || lstrlenW( str ) != 16) return FALSE;
+    for (i = 0; i < 16; i++)
+        if (!iswxdigit( str[i] )) return FALSE;
+    for (i = 0; i < 8; i++)
+    {
+        WCHAR hex[3] = { str[2 * i], str[2 * i + 1], 0 };
+        bytes[i] = wcstoul( hex, NULL, 16 );
+    }
+    return TRUE;
+}
+
+static HRESULT copy_out( void *buffer, DWORD *size, const void *src, DWORD len )
+{
+    DWORD avail = *size;
+
+    *size = len;
+    if (!len) return S_OK;
+    if (avail < len) return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+    if (!buffer) return E_INVALIDARG;
+    memcpy( buffer, src, len );
+    return S_OK;
+}
+
+static HRESULT set_string( WCHAR **dst, const void *prop, DWORD size )
+{
+    WCHAR *str;
+    DWORD len = size / sizeof(WCHAR);
+
+    if (size % sizeof(WCHAR)) return E_INVALIDARG;
+    if (!(str = malloc( (len + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    memcpy( str, prop, size );
+    str[len] = 0;
+    free( *dst );
+    *dst = str;
+    return S_OK;
+}
+
+static HRESULT set_version_component( struct name *name, unsigned int idx, WORD value )
+{
+    WORD ver[4];
+    unsigned int n = split_version( name->version, ver ), i, len;
+    WCHAR *str;
+
+    if (idx >= n) n = idx + 1;
+    ver[idx] = value;
+    if (!(str = malloc( n * 6 * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    for (i = len = 0; i < n; i++)
+        len += swprintf( str + len, 6 + 1, i ? L".%u" : L"%u", ver[i] );
+#ifdef SXS_VERCOMP
+    free( str );
+    return S_OK;
+#endif
+    free( name->version );
+    name->version = str;
+    return S_OK;
+}
+
+static HRESULT clear_extra( struct name *name, DWORD id )
+{
+    free( name->extra[id].data );
+    name->extra[id].data = NULL;
+    name->extra[id].size = 0;
+    return S_OK;
+}
