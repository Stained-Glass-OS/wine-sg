@@ -774,6 +893,17 @@ static HRESULT WINAPI cache_UninstallAssembly(
         goto done;
     }
 
+#ifndef SXS_NOGONE
+    if (GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES)
