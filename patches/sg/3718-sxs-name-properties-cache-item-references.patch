+static BOOL same_property( IAssemblyName *n1, IAssemblyName *n2, DWORD id )
+{
+    BYTE buf1[512], buf2[512];
+    DWORD len1 = sizeof(buf1), len2 = sizeof(buf2);
+    HRESULT hr1 = IAssemblyName_GetProperty( n1, id, buf1, &len1 );
+    HRESULT hr2 = IAssemblyName_GetProperty( n2, id, buf2, &len2 );
+
+    if (FAILED( hr1 ) || FAILED( hr2 )) return hr1 == hr2 && len1 == len2;
+    if (len1 != len2) return FALSE;
+    if (id == ASM_NAME_NAME || id == ASM_NAME_CULTURE)
+        
+#ifdef SXS_CASE
+        return !len1 || !wcscmp( (WCHAR *)buf1, (WCHAR *)buf2 );
+#endif
+        return !len1 || !wcsicmp( (WCHAR *)buf1, (WCHAR *)buf2 );
+    return !memcmp( buf1, buf2, len1 );
+}
