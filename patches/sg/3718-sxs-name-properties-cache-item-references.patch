+/* Install references.  The store keeps one value per reference under
+ * HKLM\Software\Wine\SideBySide\References\<assembly directory name>; the value name is
+ * "<scheme guid>!<identifier>" and the data the non-canonical data (a GUESS of the layout:
+ * Windows keeps these in its own registry tree, which we do not copy). */
+static const WCHAR refs_keyW[] = L"Software\\Wine\\SideBySide\\References\\";
+
+static HRESULT validate_reference( LPCFUSION_INSTALL_REFERENCE ref )
+{
+    if (!ref) return S_OK;
+    if (ref->cbSize != sizeof(*ref) || ref->dwFlags || !ref->szIdentifier || !ref->szIdentifier[0])
+        return E_INVALIDARG;
+    return S_OK;
+}
+
+static WCHAR *reference_key_name( const struct assembly *assembly )
+{
+    WCHAR *name, *key;
+    unsigned int len;
+
+    if (!wcscmp( assembly->type, L"win32-policy" ))
+    {
+        WCHAR *pol = build_policy_name( assembly->arch, assembly->name, assembly->token, &len );
+        if (!pol) return NULL;
+        name = malloc( (len + lstrlenW( assembly->version ) + 2) * sizeof(WCHAR) );
+        if (name) swprintf( name, len + lstrlenW( assembly->version ) + 2, L"%s_%s", pol, assembly->version );
+        free( pol );
+    }
+    else name = build_assembly_name( assembly->arch, assembly->name, assembly->token, assembly->version, &len );
+    if (!name) return NULL;
+    if ((key = malloc( (ARRAY_SIZE(refs_keyW) + lstrlenW( name )) * sizeof(WCHAR) )))
+    {
+        lstrcpyW( key, refs_keyW );
+        lstrcatW( key, name );
+    }
+    free( name );
+    return key;
+}
+
+static WCHAR *reference_value_name( LPCFUSION_INSTALL_REFERENCE ref )
+{
+    WCHAR *ret, guid[40];
+    unsigned int len;
+
+    swprintf( guid, ARRAY_SIZE(guid), L"{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}",
+              ref->guidScheme.Data1, ref->guidScheme.Data2, ref->guidScheme.Data3,
+              ref->guidScheme.Data4[0], ref->guidScheme.Data4[1], ref->guidScheme.Data4[2],
+              ref->guidScheme.Data4[3], ref->guidScheme.Data4[4], ref->guidScheme.Data4[5],
+              ref->guidScheme.Data4[6], ref->guidScheme.Data4[7] );
+    len = lstrlenW( guid ) + 1 + lstrlenW( ref->szIdentifier ) + 1;
+    if ((ret = malloc( len * sizeof(WCHAR) ))) swprintf( ret, len, L"%s!%s", guid, ref->szIdentifier );
+    return ret;
+}
+
+static HRESULT add_reference( const struct assembly *assembly, LPCFUSION_INSTALL_REFERENCE ref )
+{
+    WCHAR *key_name = reference_key_name( assembly ), *value = reference_value_name( ref );
+    const WCHAR *data = ref->szNonCannonicalData ? ref->szNonCannonicalData : L"";
+    HRESULT hr = E_OUTOFMEMORY;
+    HKEY key;
+    LONG err;
+
+    if (key_name && value)
+    {
+        err = RegCreateKeyExW( HKEY_LOCAL_MACHINE, key_name, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL );
+        if (!err)
+        {
+            err = RegSetValueExW( key, value, 0, REG_SZ, (const BYTE *)data, (lstrlenW( data ) + 1) * sizeof(WCHAR) );
+            RegCloseKey( key );
+        }
+        hr = HRESULT_FROM_WIN32( err );
+    }
+    free( key_name );
+    free( value );
+    return hr;
+}
+
+/* removes ref (if not NULL) and returns the number of references left, or -1 when ref was not found */
+static int remove_reference( const struct assembly *assembly, LPCFUSION_INSTALL_REFERENCE ref )
+{
+    WCHAR *key_name = reference_key_name( assembly ), *value = ref ? reference_value_name( ref ) : NULL;
+    DWORD count = 0;
+    int ret = 0;
+    HKEY key;
+
+    if (!key_name) return 0;
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, key_name, 0, KEY_READ | KEY_SET_VALUE, &key ))
+    {
+        if (value && RegDeleteValueW( key, value )) ret = -1;
+        if (ret != -1)
+        {
+            RegQueryInfoKeyW( key, NULL, NULL, NULL, NULL, NULL, NULL, &count, NULL, NULL, NULL, NULL );
+            ret = count;
+        }
+        RegCloseKey( key );
+        if (ret == 0) RegDeleteKeyW( HKEY_LOCAL_MACHINE, key_name );
+    }
+    else if (ref) ret = -1;
+    free( key_name );
+    free( value );
+    return ret;
+}
+
 static HRESULT WINAPI cache_InstallAssembly(
     IAssemblyCache *iface,
     DWORD flags,
@@ -667,6 +778,9 @@ static HRESULT WINAPI cache_InstallAssembly(
 
