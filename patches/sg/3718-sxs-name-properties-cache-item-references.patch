@@ -788,6 +937,7 @@ static HRESULT WINAPI cache_UninstallAssembly(
         RemoveDirectoryW( path );
     }
     if (!wcscmp( assembly->type, L"win32" )) hr = uninstall_assembly( assembly );
+    if (hr == S_OK) *disp = IASSEMBLYCACHE_UNINSTALL_DISPOSITION_UNINSTALLED;
 
 done:
     if (name_obj) IAssemblyName_Release( name_obj );
@@ -799,6 +949,395 @@ done:
     return hr;
 }
 
+struct item_stream
+{
+    struct list entry;
+    WCHAR *name;
+    DWORD format;
+    IStream *stream;
+};
+
+struct item
+{
+    IAssemblyCacheItem IAssemblyCacheItem_iface;
+    LONG refs;
+    struct cache *cache;
+    WCHAR *fullname;
+    BOOL done;
+    struct list streams;
+};
+
+static inline struct item *impl_from_IAssemblyCacheItem( IAssemblyCacheItem *iface )
+{
+    return CONTAINING_RECORD( iface, struct item, IAssemblyCacheItem_iface );
+}
+
+static void clear_item( struct item *item )
+{
+    struct item_stream *s, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( s, next, &item->streams, struct item_stream, entry )
+    {
+        list_remove( &s->entry );
+        IStream_Release( s->stream );
+        free( s->name );
+        free( s );
+    }
+}
+
+static HRESULT WINAPI item_QueryInterface( IAssemblyCacheItem *iface, REFIID riid, void **ret )
+{
+    TRACE("%p, %s, %p\n", iface, debugstr_guid(riid), ret);
+
+    *ret = NULL;
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IAssemblyCacheItem ))
+    {
+        IAssemblyCacheItem_AddRef( iface );
+        *ret = iface;
+        return S_OK;
+    }
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI item_AddRef( IAssemblyCacheItem *iface )
+{
+    struct item *item = impl_from_IAssemblyCacheItem( iface );
+    return InterlockedIncrement( &item->refs );
+}
+
+static ULONG WINAPI item_Release( IAssemblyCacheItem *iface )
+{
+    struct item *item = impl_from_IAssemblyCacheItem( iface );
+    ULONG refs = InterlockedDecrement( &item->refs );
+
+    if (!refs)
+    {
+        clear_item( item );
+        IAssemblyCache_Release( &item->cache->IAssemblyCache_iface );
+        free( item->fullname );
+        free( item );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI item_CreateStream( IAssemblyCacheItem *iface, DWORD flags, LPCWSTR name,
+                                         DWORD format, DWORD format_flags, IStream **ret,
+                                         ULARGE_INTEGER *max_size )
+{
+    struct item *item = impl_from_IAssemblyCacheItem( iface );
+    struct item_stream *s;
+    HRESULT hr;
+
+    TRACE("%p, 0x%08lx, %s, %lu, 0x%08lx, %p, %p\n", iface, flags, debugstr_w(name), format,
+          format_flags, ret, max_size);
+
+    if (!ret || !name || !name[0] || wcspbrk( name, L"\\/:" )) return E_INVALIDARG;
+    *ret = NULL;
+    if (item->done) return E_UNEXPECTED;
+    if (format == STREAM_FORMAT_COMPLIB_MODULE || format == STREAM_FORMAT_COMPLIB_MANIFEST)
+        return HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED ); /* GUESS: the store only holds Win32 assemblies */
+    if (format != STREAM_FORMAT_WIN32_MODULE && format != STREAM_FORMAT_WIN32_MANIFEST) return E_INVALIDARG;
+
+    LIST_FOR_EACH_ENTRY( s, &item->streams, struct item_stream, entry )
+        if (!wcsicmp( s->name, name ) || (format == STREAM_FORMAT_WIN32_MANIFEST && s->format == format))
+            return HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS );
+
+    if (!(s = calloc( 1, sizeof(*s) ))) return E_OUTOFMEMORY;
+    if (!(s->name = wcsdup( name )))
+    {
+        free( s );
+        return E_OUTOFMEMORY;
+    }
+    s->format = format;
+    if ((hr = CreateStreamOnHGlobal( NULL, TRUE, &s->stream )) != S_OK)
+    {
+        free( s->name );
+        free( s );
+        return hr;
+    }
+    list_add_tail( &item->streams, &s->entry );
+    IStream_AddRef( s->stream );
+    *ret = s->stream;
+    return S_OK;
+}
+
+static BOOL stream_data( IStream *stream, void **data, DWORD *size )
+{
+    HGLOBAL hglobal;
+    STATSTG st;
+
+    if (GetHGlobalFromStream( stream, &hglobal ) != S_OK) return FALSE;
+    if (IStream_Stat( stream, &st, STATFLAG_NONAME ) != S_OK) return FALSE;
+    *size = st.cbSize.LowPart;
+    *data = GlobalLock( hglobal );
+    return *data != NULL || !*size;
+}
+
+static BOOL write_data( const WCHAR *path, const void *data, DWORD size )
+{
+    DWORD written;
+    HANDLE h = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    BOOL ret;
+
+    if (h == INVALID_HANDLE_VALUE) return FALSE;
+    ret = WriteFile( h, data, size, &written, NULL ) && written == size;
+    CloseHandle( h );
+    return ret;
+}
+
+static BOOL file_equals( const WCHAR *path, const void *data, DWORD size )
+{
+    HANDLE h = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL );
+    BYTE buf[4096];
+    DWORD got, done = 0;
+    BOOL ret = FALSE;
+
+    if (h == INVALID_HANDLE_VALUE) return FALSE;
+    if (GetFileSize( h, NULL ) == size)
+    {
+        ret = TRUE;
+        while (done < size && ret)
+        {
+            if (!ReadFile( h, buf, sizeof(buf), &got, NULL ) || !got) { ret = FALSE; break; }
+            ret = got <= size - done && !memcmp( buf, (const BYTE *)data + done, got );
+            done += got;
+        }
+    }
+    CloseHandle( h );
+    return ret;
+}
+
+static BOOL item_name_matches( const WCHAR *fullname, const struct assembly *a )
+{
+    IAssemblyName *n;
+    const WCHAR *arch, *name, *token, *type, *version;
+    BOOL ret;
+
+    if (FAILED( CreateAssemblyNameObject( &n, fullname, CANOF_PARSE_DISPLAY_NAME, NULL ) )) return FALSE;
+    arch = get_name_attribute( n, NAME_ATTR_ID_ARCH );
+    name = get_name_attribute( n, NAME_ATTR_ID_NAME );
+    token = get_name_attribute( n, NAME_ATTR_ID_TOKEN );
+    type = get_name_attribute( n, NAME_ATTR_ID_TYPE );
+    version = get_name_attribute( n, NAME_ATTR_ID_VERSION );
+    ret = arch && name && token && version && !wcsicmp( arch, a->arch ) && !wcsicmp( name, a->name ) &&
+          !wcsicmp( token, a->token ) && !wcscmp( version, a->version ) &&
+          (!type || !wcscmp( type, a->type ));
+    IAssemblyName_Release( n );
+    return ret;
+}
+
+static HRESULT WINAPI item_Commit( IAssemblyCacheItem *iface, DWORD flags, ULONG *disp )
+{
+    struct item *item = impl_from_IAssemblyCacheItem( iface );
+    WCHAR tmp[MAX_PATH], dir[MAX_PATH], path[MAX_PATH], *manifest_path = NULL, *dst = NULL;
+    struct item_stream *s, *manifest = NULL;
+    IXMLDOMDocument *doc = NULL;
+    struct assembly *assembly = NULL;
+    ULONG dummy;
+    HRESULT hr, init;
+    void *data;
+    DWORD size;
+    BOOL exists, same = TRUE, dir_made = FALSE;
+    struct file *file;
+
+    TRACE("%p, 0x%08lx, %p\n", iface, flags, disp);
+
+    if (!disp) disp = &dummy;
+    *disp = 0;
+    if (flags & ~(IASSEMBLYCACHEITEM_COMMIT_FLAG_REFRESH | IASSEMBLYCACHEITEM_COMMIT_FLAG_FORCE_REFRESH))
+        return E_INVALIDARG;
+    if (item->done) return E_UNEXPECTED;
+
+    LIST_FOR_EACH_ENTRY( s, &item->streams, struct item_stream, entry )
+        if (s->format == STREAM_FORMAT_WIN32_MANIFEST) manifest = s;
+    if (!manifest) return HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND ); /* GUESS */
+
+    /* the install code works on files: lay the streams out in a private temporary directory */
+    GetTempPathW( ARRAY_SIZE(tmp), tmp );
+    swprintf( dir, ARRAY_SIZE(dir), L"%ssxsitem%lx_%lx\\", tmp, GetCurrentProcessId(), GetTickCount() );
+    if (!CreateDirectoryW( dir, NULL )) return HRESULT_FROM_WIN32( GetLastError() );
+    dir_made = TRUE;
+
+    cache_lock( item->cache );
+    init = CoInitialize( NULL );
+    hr = S_OK;
+    LIST_FOR_EACH_ENTRY( s, &item->streams, struct item_stream, entry )
+    {
+        lstrcpyW( path, dir );
+        lstrcatW( path, s->name );
+        if (!stream_data( s->stream, &data, &size ) || !write_data( path, data, size ))
+        {
+            hr = HRESULT_FROM_WIN32( GetLastError() );
+            if (SUCCEEDED( hr )) hr = E_FAIL;
+            break;
+        }
+    }
+    if (hr != S_OK) goto done;
+
+    lstrcpyW( path, dir );
+    lstrcatW( path, manifest->name );
+    if (!(manifest_path = wcsdup( path ))) { hr = E_OUTOFMEMORY; goto done; }
+
+    hr = CoCreateInstance( &CLSID_DOMDocument, NULL, CLSCTX_INPROC_SERVER, &IID_IXMLDOMDocument, (void **)&doc );
+    if (hr != S_OK) goto done;
+    if ((hr = load_manifest( doc, manifest_path )) != S_OK) goto done;
+    if ((hr = parse_assembly( doc, &assembly )) != S_OK) goto done;
+
+#ifdef SXS_NONAMECHK
+    if (0)
+#else
+    if (item->fullname && !item_name_matches( item->fullname, assembly ))
+#endif
+    {
+        hr = NAME_E_INVALID_NAME;
+        goto done;
+    }
+
+    /* every file of the manifest must have been delivered as a module stream */
+    LIST_FOR_EACH_ENTRY( file, &assembly->files, struct file, entry )
+    {
+        BOOL found = FALSE;
+        LIST_FOR_EACH_ENTRY( s, &item->streams, struct item_stream, entry )
+            if (s->format == STREAM_FORMAT_WIN32_MODULE && !wcsicmp( s->name, file->name )) found = TRUE;
+#ifdef SXS_NOMODCHK
+        found = TRUE;
+#endif
+        if (!found)
+        {
+            hr = HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND ); /* GUESS: Windows reports a missing module */
+            goto done;
+        }
+    }
+
+    if (!wcscmp( assembly->type, L"win32-policy" ))
+        dst = build_policy_filename( assembly->arch, assembly->name, assembly->token, assembly->version );
+    else
+        dst = build_manifest_filename( assembly->arch, assembly->name, assembly->token, assembly->version );
+    if (!dst) { hr = E_OUTOFMEMORY; goto done; }
+    exists = GetFileAttributesW( dst ) != INVALID_FILE_ATTRIBUTES;
+
+    if (exists && !(flags & IASSEMBLYCACHEITEM_COMMIT_FLAG_FORCE_REFRESH))
+    {
+        /* identical content is already installed: nothing to replace */
+        same = stream_data( manifest->stream, &data, &size ) && file_equals( dst, data, size );
+        if (same && !wcscmp( assembly->type, L"win32" ))
+        {
+            WCHAR sxsdir[MAX_PATH], *name, *p;
+            unsigned int len;
+
+            build_sxs_path( sxsdir );
+            name = build_assembly_name( assembly->arch, assembly->name, assembly->token, assembly->version, &len );
+            LIST_FOR_EACH_ENTRY( file, &assembly->files, struct file, entry )
+            {
+                WCHAR *fp = malloc( (lstrlenW( sxsdir ) + len + lstrlenW( file->name ) + 2) * sizeof(WCHAR) );
+                if (!fp || !name) { same = FALSE; free( fp ); break; }
+                swprintf( fp, lstrlenW( sxsdir ) + len + lstrlenW( file->name ) + 2, L"%s%s\\%s", sxsdir, name, file->name );
+                for (p = fp; *p; p++) *p = towlower( *p );
+                LIST_FOR_EACH_ENTRY( s, &item->streams, struct item_stream, entry )
+                    if (s->format == STREAM_FORMAT_WIN32_MODULE && !wcsicmp( s->name, file->name ))
+                        same = same && stream_data( s->stream, &data, &size ) && file_equals( fp, data, size );
+                free( fp );
+            }
+            free( name );
+        }
+    }
+    else same = FALSE;
+
+#ifdef SXS_NOSAME
+    same = FALSE;
+#endif
+    if (exists && same)
+    {
+        *disp = IASSEMBLYCACHEITEM_COMMIT_DISPOSITION_ALREADY_INSTALLED;
+        hr = S_OK;
+        goto done;
+    }
+
+    if (!wcscmp( assembly->type, L"win32-policy" )) hr = install_policy( manifest_path, assembly );
+    else hr = install_assembly( manifest_path, assembly, TRUE );
+    if (hr == S_OK) *disp = exists ? IASSEMBLYCACHEITEM_COMMIT_DISPOSITION_REFRESHED
+                                    : IASSEMBLYCACHEITEM_COMMIT_DISPOSITION_INSTALLED;
+
+done:
