From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] localspl, winprint, wineps: pause, resume and cancel a job while it prints

ControlPrintProcessor was a stub in winprint and wineps, and fpScheduleJob held the jobs lock
for the whole print, so SetJob and EnumJobs from another thread waited until the job was done.
The lock is now released while the print processor prints (the job is kept until it returns);
SetJob pause, resume and cancel of a printing job call the processor's ControlPrintProcessor,
which pauses or stops it between blocks (winprint) or records (wineps); a cancelled job is not
retained and gets no winprint fallback.
---
diff --git a/dlls/localspl/provider.c b/dlls/localspl/provider.c
index 024169e..b6acc39 100644
--- a/dlls/localspl/provider.c
+++ b/dlls/localspl/provider.c
@@ -237,6 +237,9 @@ typedef struct {
     SYSTEMTIME submitted;   /* when the job was made */
     DWORD status;           /* JOB_STATUS_ flags set by SetJob: paused, deleting, retained, printed */
     BOOL spooled;           /* the document is complete (EndDocPrinter), the job waits to be printed */
+    BOOL printing;          /* a print processor is printing it (fpScheduleJob, the lock released) */
+    BOOL (WINAPI *control)(HANDLE, DWORD); /* that processor's ControlPrintProcessor, if it has one */
+    HANDLE hpp;             /* and its handle */
 } job_info_t;
 
 #ifndef JOB_CONTROL_RETAIN
@@ -3717,6 +3720,7 @@ typedef struct {
     HANDLE (WINAPI *open)(WCHAR *, PRINTPROCESSOROPENDATA *);
     BOOL (WINAPI *print)(HANDLE, WCHAR *);
     BOOL (WINAPI *close)(HANDLE);
+    BOOL (WINAPI *control)(HANDLE, DWORD);
 } printproc_t;
 
 static printproc_t * print_proc_load(const WCHAR *name)
@@ -3771,6 +3775,7 @@ static printproc_t * print_proc_load(const WCHAR *name)
     ret->open = (void *)GetProcAddress(ret->hmod, "OpenPrintProcessor");
     ret->print = (void *)GetProcAddress(ret->hmod, "PrintDocumentOnPrintProcessor");
     ret->close = (void *)GetProcAddress(ret->hmod, "ClosePrintProcessor");
+    ret->control = (void *)GetProcAddress(ret->hmod, "ControlPrintProcessor");
     if (!ret->enum_datatypes || !ret->open || !ret->print || !ret->close)
     {
         FreeLibrary(ret->hmod);
@@ -4141,10 +4146,17 @@ static BOOL WINAPI fpSetJob(HANDLE hprinter, DWORD job_id,
         {
         case JOB_CONTROL_PAUSE:
             job->status |= JOB_STATUS_PAUSED;
+            /* a job being printed: its print processor waits */
+            if (job->printing && job->control) job->control(job->hpp, JOB_CONTROL_PAUSE);
             break;
         case JOB_CONTROL_RESUME:
         case JOB_CONTROL_RESTART:
             job->status &= ~JOB_STATUS_PAUSED;
+            if (job->printing)
+            {
+                if (job->control) job->control(job->hpp, JOB_CONTROL_RESUME);
+                break;
+            }
             /* a document that is waiting goes to the print processor now (the job is gone afterwards) */
 #ifndef SG_MUTANT_SETJOB_RESUME
             if (job->spooled && !job->read) ret = fpScheduleJob(hprinter, job_id);
@@ -4155,7 +4167,12 @@ static BOOL WINAPI fpSetJob(HANDLE hprinter, DWORD job_id,
 #ifndef SG_MUTANT_SETJOB_DELMARK
             job->status |= JOB_STATUS_DELETING;
 #endif
-            if (job->spooled && !job->read)
+            if (job->printing)
+            {
+                /* the print processor stops; fpScheduleJob removes the job once it returns */
+                if (job->control) job->control(job->hpp, JOB_CONTROL_CANCEL);
+            }
+            else if (job->spooled && !job->read)
             {
                 DeleteFileW(job->filename);
                 free_job(job);
@@ -4680,7 +4697,21 @@ static BOOL WINAPI fpScheduleJob(HANDLE hprinter, DWORD job_id)
 
     swprintf(name, ARRAY_SIZE(name), L"%s, Job %d", printer->name, job->id);
     job->read = FALSE;
+    /* SetJob may pause, resume or cancel the job while it prints: it reaches the print processor through
+     * ControlPrintProcessor, so the jobs lock is not held meanwhile (the job is not freed while printing) */
+    job->printing = TRUE;
+    job->control = pp->control;
+    job->hpp = hpp;
+#ifndef SG_MUTANT_PPCONTROL_LOCKED
+    LeaveCriticalSection(&printer->info->jobs_cs);
+#endif
     ret = pp->print(hpp, name);
+#ifndef SG_MUTANT_PPCONTROL_LOCKED
+    EnterCriticalSection(&printer->info->jobs_cs);
+#endif
+    job->printing = FALSE;
+    job->control = NULL;
+    job->hpp = NULL;
     TlsSetValue(scheduling_tls, prev_sched);
     if (!ret)
         WARN("PrintDocumentOnPrintProcessor failed %ld\n", GetLastError());
@@ -4691,7 +4722,8 @@ static BOOL WINAPI fpScheduleJob(HANDLE hprinter, DWORD job_id)
      * all (Samsung's, for reasons of its own): the job is not lost, our
      * winprint prints it through the driver */
 #ifndef SG_MUTANT_PPFALLBACK
-    if (!ret && !job->read && wcsicmp(job->print_proc ? job->print_proc : printer->info->print_proc, L"winprint") &&
+    if (!ret && !job->read && !(job->status & JOB_STATUS_DELETING) &&
+        wcsicmp(job->print_proc ? job->print_proc : printer->info->print_proc, L"winprint") &&
         (pp = print_proc_load(L"winprint")))
     {
         WARN("%s gave up on job %ld without reading it; winprint prints it\n",
@@ -4709,7 +4741,7 @@ static BOOL WINAPI fpScheduleJob(HANDLE hprinter, DWORD job_id)
     }
 #endif
 
-    if (job->status & JOB_STATUS_RETAINED)
+    if ((job->status & JOB_STATUS_RETAINED) && !(job->status & JOB_STATUS_DELETING))
     {
         /* a retained job stays in the queue after it was printed */
 #ifndef SG_MUTANT_SETJOB_RETAIN
diff --git a/dlls/wineps.drv/printproc.c b/dlls/wineps.drv/printproc.c
index 77d098e..1c5396c 100644
--- a/dlls/wineps.drv/printproc.c
+++ b/dlls/wineps.drv/printproc.c
@@ -53,6 +53,9 @@ struct pp_data
     INT break_extra;
     INT break_rem;
 
+    HANDLE resume;          /* set while the job may run (ControlPrintProcessor pauses it by resetting it) */
+    LONG cancelled;
+
     INT saved_dc_size;
     INT saved_dc_top;
     struct
@@ -3117,6 +3120,7 @@ HANDLE WINAPI OpenPrintProcessor(WCHAR *port, PRINTPROCESSOROPENDATA *open_data)
         return NULL;
     data->magic = PP_MAGIC;
     data->hport = hport;
+    data->resume = CreateEventW(NULL, TRUE, TRUE, NULL);
     data->port = wcsdup(port);
     data->doc_name = wcsdup(open_data->pDocumentName);
     data->out_file = wcsdup(open_data->pOutputFile);
@@ -3219,6 +3223,14 @@ BOOL WINAPI PrintDocumentOnPrintProcessor(HANDLE pp, WCHAR *doc_name)
 
     while (1)
     {
+        /* paused: wait; cancelled: the rest is not printed */
+        WaitForSingleObject(data->resume, INFINITE);
+        if (ReadNoFence(&data->cancelled))
+        {
+            SetLastError(ERROR_PRINT_CANCELLED);
+            ret = FALSE;
+            goto cleanup;
+        }
         if (!(ret = ReadPrinter(spool_data, &record, sizeof(record), &r)))
             goto cleanup;
         if (!r)
@@ -3311,11 +3323,30 @@ cleanup:
     return EndDocPrinter(data->hport) && ret;
 }
 
+/* called by the spooler, also while PrintDocumentOnPrintProcessor runs on another thread */
 BOOL WINAPI ControlPrintProcessor(HANDLE pp, DWORD cmd)
 {
-    FIXME("%p, %ld\n", pp, cmd);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    struct pp_data *data = get_handle_data(pp);
+
+    TRACE("%p, %ld\n", pp, cmd);
+
+    if (!data) return FALSE;
+    switch (cmd)
+    {
+    case JOB_CONTROL_PAUSE:
+        ResetEvent(data->resume);
+        return TRUE;
+    case JOB_CONTROL_RESUME:
+        SetEvent(data->resume);
+        return TRUE;
+    case JOB_CONTROL_CANCEL:
+        InterlockedExchange(&data->cancelled, 1);
+        SetEvent(data->resume);
+        return TRUE;
+    default:
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
 }
 
 BOOL WINAPI ClosePrintProcessor(HANDLE pp)
@@ -3336,6 +3367,7 @@ BOOL WINAPI ClosePrintProcessor(HANDLE pp)
     HeapFree(GetProcessHeap(), 0, data->ctx->Devmode);
     HeapFree(GetProcessHeap(), 0, data->ctx);
     free(data->saved_dc);
+    CloseHandle(data->resume);
 
     memset(data, 0, sizeof(*data));
     LocalFree(data);
diff --git a/dlls/winprint/printproc.c b/dlls/winprint/printproc.c
index c711168..2159eaf 100644
--- a/dlls/winprint/printproc.c
+++ b/dlls/winprint/printproc.c
@@ -52,6 +52,8 @@ struct pp_data
     DEVMODEW *devmode;
     DWORD job_id;
     BOOL emf;
+    HANDLE resume;          /* set while the job may run (ControlPrintProcessor pauses it by resetting it) */
+    LONG cancelled;
 };
 
 BOOL print_emf_job( HANDLE hport, const WCHAR *printer_name, DEVMODEW *job_devmode, const WCHAR *doc_name,
@@ -158,6 +160,7 @@ HANDLE WINAPI OpenPrintProcessor(WCHAR *port, PRINTPROCESSOROPENDATA *open_data)
     data->out_file = wcsdup(open_data->pOutputFile);
     data->emf = is_emf(open_data->pDatatype);
     data->job_id = open_data->JobId;
+    data->resume = CreateEventW(NULL, TRUE, TRUE, NULL);
     if (open_data->pPrinterName) data->printer_name = wcsdup(open_data->pPrinterName);
     if (open_data->pDevMode)
     {
@@ -198,6 +201,15 @@ BOOL WINAPI PrintDocumentOnPrintProcessor(HANDLE pp, WCHAR *doc_name)
 
     while (ReadPrinter(spool_data, buf, sizeof(buf), &r) && r)
     {
+        /* paused: wait; cancelled: stop here */
+        WaitForSingleObject(data->resume, INFINITE);
+        if (ReadNoFence(&data->cancelled))
+        {
+            ClosePrinter(spool_data);
+            EndDocPrinter(data->hport);
+            SetLastError(ERROR_PRINT_CANCELLED);
+            return FALSE;
+        }
         if (!WritePrinter(data->hport, buf, r, &w) || r != w)
         {
             ClosePrinter(spool_data);
@@ -210,11 +222,32 @@ BOOL WINAPI PrintDocumentOnPrintProcessor(HANDLE pp, WCHAR *doc_name)
     return EndDocPrinter(data->hport);
 }
 
+/* called by the spooler, also while PrintDocumentOnPrintProcessor runs on another thread */
 BOOL WINAPI ControlPrintProcessor(HANDLE pp, DWORD cmd)
 {
-    FIXME("%p, %ld\n", pp, cmd);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    struct pp_data *data = get_handle_data(pp);
+
+    TRACE("%p, %ld\n", pp, cmd);
+
+    if (!data) return FALSE;
+    switch (cmd)
+    {
+    case JOB_CONTROL_PAUSE:
+#ifndef SG_MUTANT_PPCONTROL_NOPAUSE
+        ResetEvent(data->resume);
+#endif
+        return TRUE;
+    case JOB_CONTROL_RESUME:
+        SetEvent(data->resume);
+        return TRUE;
+    case JOB_CONTROL_CANCEL:
+        InterlockedExchange(&data->cancelled, 1);
+        SetEvent(data->resume);
+        return TRUE;
+    default:
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
 }
 
 BOOL WINAPI ClosePrintProcessor(HANDLE pp)
@@ -232,6 +265,7 @@ BOOL WINAPI ClosePrintProcessor(HANDLE pp)
     free(data->out_file);
     free(data->printer_name);
     free(data->devmode);
+    CloseHandle(data->resume);
 
     memset(data, 0, sizeof(*data));
     LocalFree(data);
