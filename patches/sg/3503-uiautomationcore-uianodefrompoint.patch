From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uiautomationcore: UiaNodeFromPoint (3503)

uiautomationcore: UiaNodeFromPoint

UiaNodeFromPoint(x, y, request, data, tree): the node of the window under the point (as IUIAutomation::ElementFromPoint
does), with the requested cache, normalised to the view.
(The rest of this DLL's stubs, options, Clone, NormalizeElement and the *WithOptions finders, had already
been done by 2668/2669.)
---
--- a/dlls/uiautomationcore/uia_client.c
+++ b/dlls/uiautomationcore/uia_client.c
@@ -16,6 +16,7 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
+#include <math.h>
 #include "uia_private.h"
 
 #include "wine/debug.h"
@@ -3368,6 +3369,42 @@ exit:
     return hr;
 }
 
+/***********************************************************************
+ *          UiaNodeFromPoint (uiautomationcore.@)
+ */
+HRESULT WINAPI UiaNodeFromPoint(double x, double y, struct UiaCacheRequest *cache_req, SAFEARRAY **out_req,
+        BSTR *tree_struct)
+{
+    HUIANODE node;
+    POINT pt;
+    HWND hwnd;
+    HRESULT hr;
+
+    TRACE("(%f, %f, %p, %p, %p)\n", x, y, cache_req, out_req, tree_struct);
+
+    if (!cache_req || !out_req || !tree_struct)
+        return E_INVALIDARG;
+
+    *out_req = NULL;
+    *tree_struct = NULL;
+
+    /* The deepest window under the point; the provider tree inside a window is not searched. */
+    pt.x = lround(x);
+    pt.y = lround(y);
+    if (!(hwnd = WindowFromPoint(pt)))
+        return UIA_E_ELEMENTNOTAVAILABLE;
+
+    if (FAILED(hr = UiaNodeFromHandle(hwnd, &node)))
+        return hr;
+
+    hr = UiaGetUpdatedCache(node, cache_req, NormalizeState_View, NULL, out_req, tree_struct);
+    if (FAILED(hr))
+        WARN("UiaGetUpdatedCache failed with hr %#lx\n", hr);
+    UiaNodeRelease(node);
+
+    return hr;
+}
+
 /***********************************************************************
  *          UiaNodeRelease (uiautomationcore.@)
  */
--- a/dlls/uiautomationcore/uiautomationcore.spec
+++ b/dlls/uiautomationcore/uiautomationcore.spec
@@ -78,7 +78,7 @@
 @ stdcall UiaNavigate(ptr long ptr ptr ptr ptr)
 @ stdcall UiaNodeFromFocus(ptr ptr ptr)
 @ stdcall UiaNodeFromHandle(long ptr)
-@ stub UiaNodeFromPoint
+@ stdcall UiaNodeFromPoint(double double ptr ptr ptr)
 @ stdcall UiaNodeFromProvider(ptr ptr)
 @ stdcall UiaNodeRelease(ptr)
 @ stdcall UiaPatternRelease(ptr)
--- a/include/uiautomationcoreapi.h
+++ b/include/uiautomationcoreapi.h
@@ -576,6 +576,7 @@ HRESULT WINAPI UiaHUiaNodeFromVariant(VARIANT *in_val, HUIANODE *huianode);
 HRESULT WINAPI UiaNodeFromHandle(HWND hwnd, HUIANODE *huianode);
 HRESULT WINAPI UiaGetRootNode(HUIANODE *huianode);
 HRESULT WINAPI UiaNodeFromFocus(struct UiaCacheRequest *cache_req, SAFEARRAY **out_req, BSTR *tree_struct);
+HRESULT WINAPI UiaNodeFromPoint(double x, double y, struct UiaCacheRequest *cache_req, SAFEARRAY **out_req, BSTR *tree_struct);
 HRESULT WINAPI UiaDisconnectProvider(IRawElementProviderSimple *elprov);
 HRESULT WINAPI UiaGetUpdatedCache(HUIANODE huianode, struct UiaCacheRequest *cache_req, enum NormalizeState normalize_state,
         struct UiaCondition *normalize_cond, SAFEARRAY **out_req, BSTR *tree_struct);
