+    editor_handle_message( services->editor, EM_SETMODIFY, FALSE, 0, &hr );
+    return S_OK;
 }
 
 static HRESULT WINAPI ITextDocument2Old_fnOpen(ITextDocument2Old *iface, VARIANT *pVar,
                                                LONG Flags, LONG CodePage)
 {
     struct text_services *services = impl_from_ITextDocument2Old(iface);
-    FIXME("stub %p\n", services);
-    return E_NOTIMPL;
+    DWORD access = GENERIC_READ | ((Flags & tomReadOnly) ? 0 : GENERIC_WRITE), share = FILE_SHARE_READ | FILE_SHARE_WRITE;
+    DWORD size, read = 0;
+    HANDLE file;
+    BYTE *data = NULL;
+    WCHAR *name, *text = NULL;
+    HRESULT hr;
+
+    TRACE("(%p)->(%s %lx %ld)\\n", services, debugstr_variant(pVar), Flags, CodePage);
+
+    if (!pVar || V_VT( pVar ) != VT_BSTR || !V_BSTR( pVar )) return E_INVALIDARG;
+    if (Flags & tomShareDenyRead) share &= ~FILE_SHARE_READ;
+    if (Flags & tomShareDenyWrite) share &= ~FILE_SHARE_WRITE;
+    if ((Flags & 0xf) == tomHTML || (Flags & 0xf) == tomWordDocument) return E_NOTIMPL;
+
+    file = CreateFileW( V_BSTR( pVar ), access, share, NULL, doc_disposition( Flags, OPEN_ALWAYS ), FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || !(data = malloc( size + 2 )))
+    {
+        CloseHandle( file );
+        return size == INVALID_FILE_SIZE ? HRESULT_FROM_WIN32( GetLastError() ) : E_OUTOFMEMORY;
+    }
+    if (size && !ReadFile( file, data, size, &read, NULL ))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        free( data );
+        CloseHandle( file );
+        return hr;
+    }
+    data[read] = data[read + 1] = 0;
+
+    if ((Flags & 0xf) == tomRTF || (!(Flags & 0xf) && read >= 5 && !strncmp( (char *)data, "{\\rtf", 5 )))
+    {
+        /* WM_SETTEXT takes RTF in the bytes of the file */
+        editor_handle_message( services->editor, (Flags & tomPasteFile) ? EM_REPLACESEL : WM_SETTEXT, 0, (LPARAM)data, &hr );
+    }
+    else
+    {
+        if (!(text = doc_decode( data, read, CodePage ? CodePage : CP_ACP )))
+        {
+            free( data );
+            CloseHandle( file );
+            return E_OUTOFMEMORY;
+        }
+#ifdef SG_MUTANT_DOC_NO_PASTE
+        editor_handle_message( services->editor, WM_SETTEXT, 0, (LPARAM)text, &hr );
+#else
+        editor_handle_message( services->editor, (Flags & tomPasteFile) ? EM_REPLACESEL : WM_SETTEXT, 0, (LPARAM)text, &hr );
+#endif
+        free( text );
+    }
+    free( data );
+    editor_handle_message( services->editor, EM_SETMODIFY, FALSE, 0, &hr );
+
+    name = wcsdup( V_BSTR( pVar ) );
+    doc_close_file( services );
+    /* the file is only held open to keep others from it */
+#ifndef SG_MUTANT_DOC_KEEP_OPEN
+    if (!(Flags & (tomShareDenyRead | tomShareDenyWrite)))
+    {
+        CloseHandle( file );
+        file = INVALID_HANDLE_VALUE;
+    }
+#endif
+    services->doc_file = file;
+    services->doc_name = name;
+    return S_OK;
+}
+
+struct doc_stream { BYTE *data; DWORD size, capacity; };
+
+static DWORD CALLBACK doc_stream_out(DWORD_PTR cookie, LPBYTE buffer, LONG count, LONG *written)
+{
+    struct doc_stream *stream = (struct doc_stream *)cookie;
+
+    if (stream->size + count > stream->capacity)
+    {
+        DWORD capacity = max( stream->capacity * 2, stream->size + count + 256 );
+        BYTE *data = realloc( stream->data, capacity );
+        if (!data) return 1;
+        stream->data = data;
+        stream->capacity = capacity;
+    }
+    memcpy( stream->data + stream->size, buffer, count );
+    stream->size += count;
+    *written = count;
+    return 0;
 }
 
 static HRESULT WINAPI ITextDocument2Old_fnSave(ITextDocument2Old *iface, VARIANT *pVar,
                                                LONG Flags, LONG CodePage)
 {
     struct text_services *services = impl_from_ITextDocument2Old(iface);
-    FIXME("stub %p\n", services);
-    return E_NOTIMPL;
+    struct doc_stream stream = {0};
+    HANDLE file = INVALID_HANDLE_VALUE, target;
+    WCHAR *name = NULL, *text = NULL;
+    BOOL own = FALSE, reopened = FALSE;
+    DWORD written;
+    HRESULT hr;
+    LONG length;
+
+    TRACE("(%p)->(%s %lx %ld)\\n", services, debugstr_variant(pVar), Flags, CodePage);
+
+    if (pVar && V_VT( pVar ) == VT_BSTR && V_BSTR( pVar ))
+    {
+        target = CreateFileW( V_BSTR( pVar ), GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                              doc_disposition( Flags, CREATE_ALWAYS ), FILE_ATTRIBUTE_NORMAL, NULL );
+        if (target == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+        file = target;
+        own = TRUE;
+        name = wcsdup( V_BSTR( pVar ) );
+    }
+    else if (!pVar || V_VT( pVar ) == VT_EMPTY || V_VT( pVar ) == VT_NULL)
+    {
+        if (services->doc_file != INVALID_HANDLE_VALUE) file = services->doc_file;
+        else if (services->doc_name)
+        {
+            file = CreateFileW( services->doc_name, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                                CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+            if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+            reopened = TRUE;
+        }
+        else return E_FAIL;
+    }
+    else return E_INVALIDARG;
+
+    if ((Flags & 0xf) == tomRTF)
+    {
+        EDITSTREAM es;
+        es.dwCookie = (DWORD_PTR)&stream;
+        es.dwError = 0;
+        es.pfnCallback = doc_stream_out;
+        editor_handle_message( services->editor, EM_STREAMOUT, SF_RTF, (LPARAM)&es, &hr );
+        if (es.dwError) hr = E_FAIL; else hr = S_OK;
+    }
+    else
+    {
+        hr = E_OUTOFMEMORY;
+        length = editor_handle_message( services->editor, WM_GETTEXTLENGTH, 0, 0, &hr );
+        if ((text = malloc( (length + 1) * sizeof(WCHAR) )))
+        {
+            LONG cp = CodePage ? CodePage : CP_ACP, bytes;
+            editor_handle_message( services->editor, WM_GETTEXT, length + 1, (LPARAM)text, &hr );
+            if (cp == 1200 || cp == 1201)
+            {
+                LONG i;
+                stream.size = (length + 1) * sizeof(WCHAR);
+                stream.data = malloc( stream.size );
+                if (stream.data)
+                {
+                    WCHAR *w = (WCHAR *)stream.data;
+                    w[0] = cp == 1201 ? swap16( 0xfeff ) : 0xfeff;
+                    for (i = 0; i < length; i++) w[i + 1] = cp == 1201 ? swap16( text[i] ) : text[i];
+                    hr = S_OK;
+                }
+            }
+            else
+            {
+                bytes = WideCharToMultiByte( cp, 0, text, length, NULL, 0, NULL, NULL );
+                if ((stream.data = malloc( bytes + 1 )))
+                {
+                    WideCharToMultiByte( cp, 0, text, length, (char *)stream.data, bytes, NULL, NULL );
+                    stream.size = bytes;
+                    hr = S_OK;
+                }
+            }
+            free( text );
+        }
+    }
+
+    if (SUCCEEDED(hr))
+    {
+        SetFilePointer( file, 0, NULL, FILE_BEGIN );
+        if (!WriteFile( file, stream.data, stream.size, &written, NULL ) || !SetEndOfFile( file ))
+            hr = HRESULT_FROM_WIN32( GetLastError() );
+    }
+    free( stream.data );
+
+    if (SUCCEEDED(hr))
+    {
+        if (own)
+        {
+            doc_close_file( services );
+            services->doc_file = file;
+            services->doc_name = name;
+            name = NULL;
+            own = FALSE;
+        }
+        editor_handle_message( services->editor, EM_SETMODIFY, FALSE, 0, &hr );
+        hr = S_OK;
+    }
+    if (own || reopened) CloseHandle( file );
+    free( name );
+    return hr;
 }
 
