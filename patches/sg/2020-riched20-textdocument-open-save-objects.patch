+/* Stained Glass OS: a document opened from a file keeps the file open (with
+ * the sharing the flags ask for) until it is replaced or the control goes. */
+
+#define swap16(x) ((WCHAR)((((x) >> 8) & 0xff) | (((x) & 0xff) << 8)))
+
+static void doc_close_file(struct text_services *services)
+{
+    if (services->doc_file != INVALID_HANDLE_VALUE) CloseHandle( services->doc_file );
+    services->doc_file = INVALID_HANDLE_VALUE;
+    free( services->doc_name );
+    services->doc_name = NULL;
+}
+
+static DWORD doc_disposition(LONG flags, DWORD default_disposition)
+{
+    switch (flags & 0xf0)
+    {
+    case tomCreateNew: return CREATE_NEW;
+    case tomCreateAlways: return CREATE_ALWAYS;
+    case tomOpenExisting: return OPEN_EXISTING;
+    case tomOpenAlways: return OPEN_ALWAYS;
+    case tomTruncateExisting: return TRUNCATE_EXISTING;
+    }
+    return default_disposition;
+}
+
+/* the text of a file's bytes in a code page, without its byte order mark */
+static WCHAR *doc_decode(const BYTE *data, DWORD size, LONG codepage)
+{
+    WCHAR *text;
+    int len;
+
+    if (codepage == 1200 || codepage == 1201)
+    {
+        DWORD i, count = size / sizeof(WCHAR);
+        const WCHAR *w = (const WCHAR *)data;
+
+        if (!(text = malloc( (count + 1) * sizeof(WCHAR) ))) return NULL;
+        for (i = 0; i < count; i++) text[i] = codepage == 1201 ? swap16( w[i] ) : w[i];
+        text[count] = 0;
+        if (count && text[0] == 0xfeff) memmove( text, text + 1, count * sizeof(WCHAR) );
+        return text;
+    }
+#ifndef SG_MUTANT_DOC_BOM
+    if (codepage == CP_UTF8 && size >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf)
+#else
+    if (0)
+#endif
+    {
+        data += 3;
+        size -= 3;
+    }
+    len = size ? MultiByteToWideChar( codepage, 0, (const char *)data, size, NULL, 0 ) : 0;
+    if (!(text = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    if (len) MultiByteToWideChar( codepage, 0, (const char *)data, size, text, len );
+    text[len] = 0;
+    return text;
+}
+
