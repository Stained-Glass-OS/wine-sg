+    if (FAILED(hr = inst_arg_str(dp, 1, err, &feature))) { VariantClear(&product); return hr; }
+    if (FAILED(hr = inst_arg_long(dp, 2, err, &mode))) goto done;
+
+    hr = MsiReinstallFeatureW(V_BSTR(&product), V_BSTR(&feature), V_I4(&mode)) == ERROR_SUCCESS
+            ? S_OK : DISP_E_EXCEPTION;
+done:
+    VariantClear(&product);
+    VariantClear(&feature);
+    return hr;
+}
+
+INSTALLER_METHOD(ProvideComponent)
+{
+    VARIANTARG product, feature, component, mode;
+    WCHAR path[MAX_PATH];
+    DWORD len = ARRAY_SIZE(path);
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &feature))) { VariantClear(&product); return hr; }
+    if (FAILED(hr = inst_arg_str(dp, 2, err, &component))) goto done;
+    if (FAILED(hr = inst_arg_long(dp, 3, err, &mode))) goto done2;
+
+    if (MsiProvideComponentW(V_BSTR(&product), V_BSTR(&feature), V_BSTR(&component), V_I4(&mode),
+            path, &len) != ERROR_SUCCESS)
+        hr = DISP_E_EXCEPTION;
+    else
+        hr = inst_return_str(res, path);
+done2:
+    VariantClear(&component);
+done:
+    VariantClear(&product);
+    VariantClear(&feature);
+    return hr;
+}
+
+INSTALLER_METHOD(ComponentPath)
+{
+    VARIANTARG product, component;
+    WCHAR path[MAX_PATH] = L"";
+    DWORD len = ARRAY_SIZE(path);
+    INSTALLSTATE state;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &component))) { VariantClear(&product); return hr; }
+
+    state = MsiGetComponentPathW(V_BSTR(&product), V_BSTR(&component), path, &len);
+    if (state != INSTALLSTATE_LOCAL && state != INSTALLSTATE_SOURCE && state != INSTALLSTATE_ADVERTISED)
+        path[0] = 0;
+    hr = inst_return_str(res, path);
+    VariantClear(&product);
+    VariantClear(&component);
+    return hr;
+}
+
+INSTALLER_METHOD(ProvideQualifiedComponent)
+{
+    VARIANTARG category, qualifier, mode;
+    WCHAR path[MAX_PATH];
+    DWORD len = ARRAY_SIZE(path);
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &category))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &qualifier))) { VariantClear(&category); return hr; }
+    if (FAILED(hr = inst_arg_long(dp, 2, err, &mode))) goto done;
+
+    if (MsiProvideQualifiedComponentW(V_BSTR(&category), V_BSTR(&qualifier), V_I4(&mode), path, &len)
+            != ERROR_SUCCESS)
+        hr = DISP_E_EXCEPTION;
+    else
+        hr = inst_return_str(res, path);
+done:
+    VariantClear(&category);
+    VariantClear(&qualifier);
+    return hr;
+}
+
+/* Calls cb for every (qualifier, application data) pair of a component category. */
+static UINT enum_qualifiers(const WCHAR *category, BOOL (*cb)(const WCHAR *, const WCHAR *, void *), void *ctx)
+{
+    WCHAR qualifier[MAX_PATH], appdata[MAX_PATH];
+    DWORD qlen, alen, i;
+    UINT ret;
+
+    for (i = 0;; i++)
+    {
+        qlen = ARRAY_SIZE(qualifier);
+        alen = ARRAY_SIZE(appdata);
+        ret = MsiEnumComponentQualifiersW(category, i, qualifier, &qlen, appdata, &alen);
+        if (ret != ERROR_SUCCESS) break;
+        if (!cb(qualifier, appdata, ctx)) return ERROR_SUCCESS;
+    }
+    return ret == ERROR_NO_MORE_ITEMS ? ERROR_SUCCESS : ret;
+}
+
+struct qualifier_desc { const WCHAR *qualifier; WCHAR *appdata; };
+
+static BOOL find_qualifier_cb(const WCHAR *qualifier, const WCHAR *appdata, void *ctx)
+{
+    struct qualifier_desc *desc = ctx;
+
+    if (wcsicmp(qualifier, desc->qualifier)) return TRUE;
+    desc->appdata = wcsdup(appdata);
+    return FALSE;
+}
+
+INSTALLER_METHOD(QualifierDescription)
+{
+    struct qualifier_desc desc = { 0 };
+    VARIANTARG category, qualifier;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &category))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &qualifier))) { VariantClear(&category); return hr; }
+
+    desc.qualifier = V_BSTR(&qualifier);
+    if (enum_qualifiers(V_BSTR(&category), find_qualifier_cb, &desc) != ERROR_SUCCESS || !desc.appdata)
+        hr = DISP_E_EXCEPTION;
+    else
+        hr = inst_return_str(res, desc.appdata);
+    free(desc.appdata);
+    VariantClear(&category);
+    VariantClear(&qualifier);
+    return hr;
+}
+
+struct string_collector { WCHAR **strings; int count, cap; HRESULT hr; };
+
+static BOOL collect_qualifier_cb(const WCHAR *qualifier, const WCHAR *appdata, void *ctx)
+{
+    struct string_collector *c = ctx;
+    size_t len = wcslen(qualifier) + wcslen(appdata) + 2;
+    WCHAR *str = malloc(len * sizeof(WCHAR));
+
+    if (!str) { c->hr = E_OUTOFMEMORY; return FALSE; }
+    swprintf(str, len, L"%s\t%s", qualifier, appdata);
+    c->hr = add_string(&c->strings, &c->count, &c->cap, str);
+    free(str);
+    return SUCCEEDED(c->hr);
+}
+
+INSTALLER_METHOD(ComponentQualifiers)
+{
+    struct string_collector c = { 0 };
+    VARIANTARG category;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &category))) return hr;
+
+    if (enum_qualifiers(V_BSTR(&category), collect_qualifier_cb, &c) != ERROR_SUCCESS)
+        hr = DISP_E_EXCEPTION;
+    else if (FAILED(c.hr))
+        hr = c.hr;
+    else
+        hr = return_string_list(res, c.strings, c.count);
+    free_string_array(c.strings, c.count);
+    VariantClear(&category);
+    return hr;
+}
+
+INSTALLER_METHOD(Features)
+{
+    WCHAR name[MAX_FEATURE_CHARS + 1], parent[MAX_FEATURE_CHARS + 1];
+    struct string_collector c = { 0 };
+    VARIANTARG product;
+    HRESULT hr;
+    DWORD i;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+
+    hr = S_OK;
+    for (i = 0; SUCCEEDED(hr) && MsiEnumFeaturesW(V_BSTR(&product), i, name, parent) == ERROR_SUCCESS; i++)
+        hr = add_string(&c.strings, &c.count, &c.cap, name);
+    if (SUCCEEDED(hr))
+        hr = return_string_list(res, c.strings, c.count);
+    free_string_array(c.strings, c.count);
+    VariantClear(&product);
+    return hr;
+}
+
+INSTALLER_METHOD(Components)
+{
+    WCHAR guid[GUID_SIZE];
+    struct string_collector c = { 0 };
+    HRESULT hr = S_OK;
+    DWORD i;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+
+    for (i = 0; SUCCEEDED(hr) && MsiEnumComponentsW(i, guid) == ERROR_SUCCESS; i++)
+        hr = add_string(&c.strings, &c.count, &c.cap, guid);
+    if (SUCCEEDED(hr))
+        hr = return_string_list(res, c.strings, c.count);
+    free_string_array(c.strings, c.count);
+    return hr;
+}
+
+INSTALLER_METHOD(ComponentClients)
+{
+    WCHAR guid[GUID_SIZE];
+    struct string_collector c = { 0 };
+    VARIANTARG component;
+    HRESULT hr;
+    DWORD i;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &component))) return hr;
+
+    hr = S_OK;
+    for (i = 0; SUCCEEDED(hr) && MsiEnumClientsW(V_BSTR(&component), i, guid) == ERROR_SUCCESS; i++)
+        hr = add_string(&c.strings, &c.count, &c.cap, guid);
+    if (SUCCEEDED(hr))
+        hr = return_string_list(res, c.strings, c.count);
+    free_string_array(c.strings, c.count);
+    VariantClear(&component);
+    return hr;
+}
+
+/* Fetches the patch at index i of a product: its code and its transforms (malloc'ed). */
+static UINT get_patch(const WCHAR *product, DWORD i, WCHAR *guid, WCHAR **transforms)
+{
+    DWORD len = 0;
+    UINT ret;
+
+    *transforms = NULL;
+    ret = MsiEnumPatchesW(product, i, guid, NULL, &len);
+    if (ret != ERROR_SUCCESS && ret != ERROR_MORE_DATA) return ret;
+    if (!(*transforms = malloc(++len * sizeof(WCHAR)))) return ERROR_OUTOFMEMORY;
+    ret = MsiEnumPatchesW(product, i, guid, *transforms, &len);
+    if (ret != ERROR_SUCCESS)
+    {
+        free(*transforms);
+        *transforms = NULL;
+    }
+    return ret;
+}
+
+INSTALLER_METHOD(Patches)
+{
+    WCHAR guid[GUID_SIZE], *transforms;
+    struct string_collector c = { 0 };
+    VARIANTARG product;
+    HRESULT hr;
+    DWORD i;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+
+    hr = S_OK;
+    for (i = 0; SUCCEEDED(hr); i++)
+    {
+        UINT ret = get_patch(V_BSTR(&product), i, guid, &transforms);
+
+        if (ret == ERROR_OUTOFMEMORY) hr = E_OUTOFMEMORY;
+        if (ret != ERROR_SUCCESS) break;
+        free(transforms);
+        hr = add_string(&c.strings, &c.count, &c.cap, guid);
+    }
+    if (SUCCEEDED(hr))
+        hr = return_string_list(res, c.strings, c.count);
+    free_string_array(c.strings, c.count);
+    VariantClear(&product);
+    return hr;
+}
+
+INSTALLER_METHOD(PatchInfo)
+{
+    VARIANTARG patch, attr;
+    WCHAR *buf;
+    DWORD len = 0;
+    HRESULT hr;
+    UINT ret;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &patch))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &attr))) { VariantClear(&patch); return hr; }
+
+    hr = DISP_E_EXCEPTION;
+    ret = MsiGetPatchInfoW(V_BSTR(&patch), V_BSTR(&attr), NULL, &len);
+    if (ret == ERROR_SUCCESS || ret == ERROR_MORE_DATA)
+    {
+        buf = malloc(++len * sizeof(WCHAR));
+        if (!buf) hr = E_OUTOFMEMORY;
+        else
+        {
+            if (MsiGetPatchInfoW(V_BSTR(&patch), V_BSTR(&attr), buf, &len) == ERROR_SUCCESS)
+                hr = inst_return_str(res, buf);
+            free(buf);
+        }
+    }
+    VariantClear(&patch);
+    VariantClear(&attr);
+    return hr;
+}
+
+INSTALLER_METHOD(PatchTransforms)
+{
+    VARIANTARG product, patch;
+    WCHAR guid[GUID_SIZE], *transforms;
+    HRESULT hr;
+    DWORD i;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &patch))) { VariantClear(&product); return hr; }
+
+    hr = DISP_E_EXCEPTION;
+    for (i = 0; hr == DISP_E_EXCEPTION; i++)
+    {
+        if (get_patch(V_BSTR(&product), i, guid, &transforms) != ERROR_SUCCESS) break;
+        if (!wcsicmp(guid, V_BSTR(&patch)))
+            hr = inst_return_str(res, transforms);
+        free(transforms);
+    }
+    VariantClear(&product);
+    VariantClear(&patch);
+    return hr;
+}
+
+INSTALLER_METHOD(AddSource)
+{
+    VARIANTARG product, user, source;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &user))) { VariantClear(&product); return hr; }
+    if (FAILED(hr = inst_arg_str(dp, 2, err, &source))) goto done;
+
+    hr = MsiSourceListAddSourceW(V_BSTR(&product), V_BSTR(&user), 0, V_BSTR(&source)) == ERROR_SUCCESS
+            ? S_OK : DISP_E_EXCEPTION;
+    VariantClear(&source);
+done:
+    VariantClear(&product);
+    VariantClear(&user);
+    return hr;
+}
+
+INSTALLER_METHOD(ClearSourceList)
+{
+    VARIANTARG product, user;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &user))) { VariantClear(&product); return hr; }
+
+    hr = MsiSourceListClearAllW(V_BSTR(&product), V_BSTR(&user), 0) == ERROR_SUCCESS ? S_OK : DISP_E_EXCEPTION;
+    VariantClear(&product);
+    VariantClear(&user);
+    return hr;
+}
+
+INSTALLER_METHOD(ForceSourceListResolution)
+{
+    VARIANTARG product, user;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &user))) { VariantClear(&product); return hr; }
+
+    hr = MsiSourceListForceResolutionW(V_BSTR(&product), V_BSTR(&user), 0) == ERROR_SUCCESS
+            ? S_OK : DISP_E_EXCEPTION;
+    VariantClear(&product);
+    VariantClear(&user);
+    return hr;
+}
+
+INSTALLER_METHOD(ShortcutTarget)
+{
+    WCHAR product[GUID_SIZE], feature[MAX_FEATURE_CHARS + 1], component[GUID_SIZE];
+    VARIANTARG path;
+    MSIHANDLE rec;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &path))) return hr;
+
+    if (MsiGetShortcutTargetW(V_BSTR(&path), product, feature, component) != ERROR_SUCCESS)
+    {
+        VariantClear(&path);
+        return DISP_E_EXCEPTION;
+    }
+    VariantClear(&path);
+
+    rec = MsiCreateRecord(3);
+    if (!rec) return DISP_E_EXCEPTION;
+    MsiRecordSetStringW(rec, 1, product);
+    MsiRecordSetStringW(rec, 2, feature);
+    MsiRecordSetStringW(rec, 3, component);
+
+    V_VT(res) = VT_DISPATCH;
+    return create_record(rec, &V_DISPATCH(res));
+}
+
+INSTALLER_METHOD(FileHash)
+{
+    MSIFILEHASHINFO hash;
+    VARIANTARG path, options;
+    MSIHANDLE rec;
+    HRESULT hr;
+    int i;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &path))) return hr;
+    if (FAILED(hr = inst_arg_long(dp, 1, err, &options))) { VariantClear(&path); return hr; }
+
+    hash.dwFileHashInfoSize = sizeof(hash);
+    if (MsiGetFileHashW(V_BSTR(&path), V_I4(&options), &hash) != ERROR_SUCCESS)
+    {
+        VariantClear(&path);
+        return DISP_E_EXCEPTION;
+    }
+    VariantClear(&path);
+
+    rec = MsiCreateRecord(4);
+    if (!rec) return DISP_E_EXCEPTION;
+    for (i = 0; i < 4; i++)
+        MsiRecordSetInteger(rec, i + 1, hash.dwData[i]);
+
+    V_VT(res) = VT_DISPATCH;
+    return create_record(rec, &V_DISPATCH(res));
+}
