+/* Installer methods that wrap the Msi*() product, feature, component and patch APIs. */
+static HRESULT inst_arg_str(DISPPARAMS *dp, UINT idx, UINT *err, VARIANT *v)
+{
+    VariantInit(v);
+    return DispGetParam(dp, idx, VT_BSTR, v, err);
+}
+
+static HRESULT inst_arg_long(DISPPARAMS *dp, UINT idx, UINT *err, VARIANT *v)
+{
+    VariantInit(v);
+    return DispGetParam(dp, idx, VT_I4, v, err);
+}
+
+static HRESULT inst_return_str(VARIANT *result, const WCHAR *str)
+{
+    V_VT(result) = VT_BSTR;
+    V_BSTR(result) = SysAllocString(str);
+    return V_BSTR(result) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT create_string_list(WCHAR **strings, int count, IDispatch **dispatch)
+{
+    struct list_object *list;
+    int i;
+
+    list = calloc(1, sizeof(*list));
+    if (!list) return E_OUTOFMEMORY;
+
+    init_automation_object(&list->autoobj, 0, StringList_tid);
+    *dispatch = &list->autoobj.IDispatch_iface;
+
+    list->data = calloc(count ? count : 1, sizeof(VARIANT));
+    if (!list->data)
+    {
+        IDispatch_Release(*dispatch);
+        return E_OUTOFMEMORY;
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        V_VT(&list->data[i]) = VT_BSTR;
+        V_BSTR(&list->data[i]) = SysAllocString(strings[i]);
+    }
+    list->count = count;
+    return S_OK;
+}
+
+static HRESULT return_string_list(VARIANT *result, WCHAR **strings, int count)
+{
+    IDispatch *dispatch;
+    HRESULT hr = create_string_list(strings, count, &dispatch);
+
+    if (SUCCEEDED(hr))
+    {
+        V_VT(result) = VT_DISPATCH;
+        V_DISPATCH(result) = dispatch;
+    }
+    return hr;
+}
+
+static void free_string_array(WCHAR **strings, int count)
+{
+    while (count--) free(strings[count]);
+    free(strings);
+}
+
+static HRESULT add_string(WCHAR ***strings, int *count, int *cap, const WCHAR *str)
+{
+    if (*count + 1 >= *cap)
+    {
+        WCHAR **tmp = realloc(*strings, (*cap = *cap ? *cap * 2 : 16) * sizeof(**strings));
+        if (!tmp) return E_OUTOFMEMORY;
+        *strings = tmp;
+    }
+    if (!((*strings)[*count] = wcsdup(str))) return E_OUTOFMEMORY;
+    (*count)++;
+    return S_OK;
+}
+
+#define INSTALLER_METHOD(name) \
+static HRESULT InstallerImpl_##name(WORD wFlags, DISPPARAMS *dp, VARIANT *res, EXCEPINFO *ei, UINT *err)
+
+INSTALLER_METHOD(ConfigureProduct)
+{
+    VARIANTARG product, level, state;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_long(dp, 1, err, &level))) goto done;
+    if (FAILED(hr = inst_arg_long(dp, 2, err, &state))) goto done;
+
+    hr = MsiConfigureProductW(V_BSTR(&product), V_I4(&level), V_I4(&state)) == ERROR_SUCCESS
+            ? S_OK : DISP_E_EXCEPTION;
+done:
+    VariantClear(&product);
+    return hr;
+}
+
+INSTALLER_METHOD(ReinstallProduct)
+{
+    VARIANTARG product, mode;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_long(dp, 1, err, &mode))) goto done;
+
+    hr = MsiReinstallProductW(V_BSTR(&product), V_I4(&mode)) == ERROR_SUCCESS ? S_OK : DISP_E_EXCEPTION;
+done:
+    VariantClear(&product);
+    return hr;
+}
+
+INSTALLER_METHOD(CollectUserInfo)
+{
+    VARIANTARG product;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+
+    hr = MsiCollectUserInfoW(V_BSTR(&product)) == ERROR_SUCCESS ? S_OK : DISP_E_EXCEPTION;
+    VariantClear(&product);
+    return hr;
+}
+
+INSTALLER_METHOD(ApplyPatch)
+{
+    VARIANTARG patch, package, type, cmdline;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &patch))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &package))) goto done1;
+    if (FAILED(hr = inst_arg_long(dp, 2, err, &type))) goto done2;
+    if (FAILED(hr = inst_arg_str(dp, 3, err, &cmdline))) goto done2;
+
+    hr = MsiApplyPatchW(V_BSTR(&patch), V_BSTR(&package), V_I4(&type), V_BSTR(&cmdline)) == ERROR_SUCCESS
+            ? S_OK : DISP_E_EXCEPTION;
+    VariantClear(&cmdline);
+done2:
+    VariantClear(&package);
+done1:
+    VariantClear(&patch);
+    return hr;
+}
+
+INSTALLER_METHOD(FeatureParent)
+{
+    VARIANTARG product, feature;
+    WCHAR name[MAX_FEATURE_CHARS + 1], parent[MAX_FEATURE_CHARS + 1];
+    HRESULT hr;
+    DWORD i;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &feature))) { VariantClear(&product); return hr; }
+
+    hr = DISP_E_EXCEPTION;
+    for (i = 0; MsiEnumFeaturesW(V_BSTR(&product), i, name, parent) == ERROR_SUCCESS; i++)
+    {
+        if (!wcsicmp(name, V_BSTR(&feature)))
+        {
+            hr = inst_return_str(res, parent);
+            break;
+        }
+    }
+    VariantClear(&product);
+    VariantClear(&feature);
+    return hr;
+}
+
+INSTALLER_METHOD(FeatureState)
+{
+    VARIANTARG product, feature;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &feature))) { VariantClear(&product); return hr; }
+
+    V_VT(res) = VT_I4;
+    V_I4(res) = MsiQueryFeatureStateW(V_BSTR(&product), V_BSTR(&feature));
+    VariantClear(&product);
+    VariantClear(&feature);
+    return S_OK;
+}
+
+INSTALLER_METHOD(UseFeature)
+{
+    VARIANTARG product, feature, mode;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &feature))) { VariantClear(&product); return hr; }
+    if (FAILED(hr = inst_arg_long(dp, 2, err, &mode))) goto done;
+
+    V_VT(res) = VT_I4;
+    V_I4(res) = MsiUseFeatureExW(V_BSTR(&product), V_BSTR(&feature), V_I4(&mode), 0);
+done:
+    VariantClear(&product);
+    VariantClear(&feature);
+    return hr;
+}
+
+static HRESULT feature_usage(WORD wFlags, DISPPARAMS *dp, VARIANT *res, UINT *err, BOOL date)
+{
+    VARIANTARG product, feature;
+    DWORD count = 0;
+    WORD dos_date = 0;
+    HRESULT hr;
+    UINT ret;
+
+    if (!(wFlags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &feature))) { VariantClear(&product); return hr; }
+
+    ret = MsiGetFeatureUsageW(V_BSTR(&product), V_BSTR(&feature), &count, &dos_date);
+    VariantClear(&product);
+    VariantClear(&feature);
+    if (ret != ERROR_SUCCESS) return DISP_E_EXCEPTION;
+
+    if (date)
+    {
+        FILETIME ft;
+        SYSTEMTIME st;
+
+        V_VT(res) = VT_DATE;
+        V_DATE(res) = 0;
+        if (DosDateTimeToFileTime(dos_date, 0, &ft) && FileTimeToSystemTime(&ft, &st))
+            SystemTimeToVariantTime(&st, &V_DATE(res));
+    }
+    else
+    {
+        V_VT(res) = VT_I4;
+        V_I4(res) = count;
+    }
+    return S_OK;
+}
+
+INSTALLER_METHOD(FeatureUsageCount)
+{
+    return feature_usage(wFlags, dp, res, err, FALSE);
+}
+
+INSTALLER_METHOD(FeatureUsageDate)
+{
+    return feature_usage(wFlags, dp, res, err, TRUE);
+}
+
+INSTALLER_METHOD(ConfigureFeature)
+{
+    VARIANTARG product, feature, state;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (FAILED(hr = inst_arg_str(dp, 0, err, &product))) return hr;
+    if (FAILED(hr = inst_arg_str(dp, 1, err, &feature))) { VariantClear(&product); return hr; }
+    if (FAILED(hr = inst_arg_long(dp, 2, err, &state))) goto done;
+
+    hr = MsiConfigureFeatureW(V_BSTR(&product), V_BSTR(&feature), V_I4(&state)) == ERROR_SUCCESS
+            ? S_OK : DISP_E_EXCEPTION;
+done:
+    VariantClear(&product);
+    VariantClear(&feature);
+    return hr;
+}
+
+INSTALLER_METHOD(ReinstallFeature)
+{
+    VARIANTARG product, feature, mode;
+    HRESULT hr;
+
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
