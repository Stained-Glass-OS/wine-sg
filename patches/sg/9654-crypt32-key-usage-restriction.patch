From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: the key usage restriction extension (2.5.29.4)

AutoHotkey 2's setup makes a self-signed certificate to sign AutoHotkey*_UIA.exe
("Run with UI access"), with the key usage restriction extension Authenticode
signing certificates carry (szOID_KEY_USAGE_RESTRICTION, X509_KEY_USAGE_RESTRICTION:
SEQUENCE { certPolicySet SEQUENCE OF CertPolicyId OPTIONAL, restrictedKeyUsage
KeyUsage OPTIONAL }). Wine had no encoder for it ("Unsupported encoder for
lpszStructType 2.5.29.4"): setup stopped at an error box, and its silent install
(/silent, as winget runs it) never ended. crypt32 now encodes it, and decodes it.

Test: test/kurestrict-gate.sh (mutant SG_MUTANT_NO_KEY_USAGE_RESTRICTION).
---
--- a/dlls/crypt32/encode.c
+++ b/dlls/crypt32/encode.c
@@ -3102,6 +3102,99 @@
     return ret;
 }
 
+/* Stained Glass OS: the key usage restriction extension (szOID_KEY_USAGE_RESTRICTION,
+ * 2.5.29.4, X509_KEY_USAGE_RESTRICTION) -- the one Authenticode signing certificates made with
+ * makecert carry:
+ *   KeyUsageRestrictionSyntax ::= SEQUENCE {
+ *       certPolicySet      SEQUENCE OF CertPolicyId OPTIONAL,  -- CertPolicyId: SEQUENCE OF OID
+ *       restrictedKeyUsage KeyUsage OPTIONAL }                 -- a BIT STRING
+ * AutoHotkey's setup makes such a certificate to sign AutoHotkey*_UIA.exe ("Run with UI access")
+ * and stopped with an error box no silent install could answer: Wine had no encoder for it. */
+static BOOL WINAPI CRYPT_AsnEncodeCertPolicyIdSet(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    const CERT_KEY_USAGE_RESTRICTION_INFO *info = pvStructInfo;
+    DWORD bytesNeeded = 0, lenBytes, size, i;
+    BOOL ret = TRUE;
+
+    /* a CERT_POLICY_ID is laid out as a CERT_ENHKEY_USAGE: a SEQUENCE OF OID */
+    for (i = 0; ret && i < info->cCertPolicyId; i++)
+    {
+        ret = CRYPT_AsnEncodeEnhancedKeyUsage(dwCertEncodingType, NULL, &info->rgCertPolicyId[i],
+         dwFlags & ~CRYPT_ENCODE_ALLOC_FLAG, NULL, NULL, &size);
+        if (ret) bytesNeeded += size;
+    }
+    if (!ret) return FALSE;
+    CRYPT_EncodeLen(bytesNeeded, NULL, &lenBytes);
+    bytesNeeded += 1 + lenBytes;
+    if (!pbEncoded)
+    {
+        *pcbEncoded = bytesNeeded;
+        return TRUE;
+    }
+    if ((ret = CRYPT_EncodeEnsureSpace(dwFlags, pEncodePara, pbEncoded, pcbEncoded, bytesNeeded)))
+    {
+        BYTE *out;
+
+        if (dwFlags & CRYPT_ENCODE_ALLOC_FLAG)
+            pbEncoded = *(BYTE **)pbEncoded;
+        out = pbEncoded;
+        *out++ = ASN_SEQUENCEOF;
+        CRYPT_EncodeLen(bytesNeeded - lenBytes - 1, out, &lenBytes);
+        out += lenBytes;
+        for (i = 0; ret && i < info->cCertPolicyId; i++)
+        {
+            size = bytesNeeded;
+            ret = CRYPT_AsnEncodeEnhancedKeyUsage(dwCertEncodingType, NULL, &info->rgCertPolicyId[i],
+             dwFlags & ~CRYPT_ENCODE_ALLOC_FLAG, NULL, out, &size);
+            if (ret)
+            {
+                out += size;
+                bytesNeeded -= size;
+            }
+        }
+        if (!ret && (dwFlags & CRYPT_ENCODE_ALLOC_FLAG))
+            CRYPT_FreeSpace(pEncodePara, pbEncoded);
+    }
+    return ret;
+}
+
+static BOOL WINAPI CRYPT_AsnEncodeKeyUsageRestriction(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        const CERT_KEY_USAGE_RESTRICTION_INFO *info = pvStructInfo;
+        struct AsnEncodeSequenceItem items[2] = { { 0 } };
+        DWORD cItem = 0;
+
+        if (info->cCertPolicyId)
+        {
+            items[cItem].pvStructInfo = info;
+            items[cItem].encodeFunc = CRYPT_AsnEncodeCertPolicyIdSet;
+            cItem++;
+        }
+        if (info->RestrictedKeyUsage.cbData)
+        {
+            items[cItem].pvStructInfo = &info->RestrictedKeyUsage;
+            items[cItem].encodeFunc = CRYPT_AsnEncodeBits;
+            cItem++;
+        }
+        ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items, cItem, dwFlags, pEncodePara,
+         pbEncoded, pcbEncoded);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
+
 static BOOL CRYPT_AsnEncodeCertPolicyMapping(DWORD dwCertEncodingType,
  const CERT_POLICY_MAPPING *mapping, DWORD dwFlags, BYTE *pbEncoded,
  DWORD *pcbEncoded)
@@ -5324,6 +5417,11 @@
         case LOWORD(X509_CERT_POLICIES):
             encodeFunc = CRYPT_AsnEncodeCertPolicies;
             break;
+#ifndef SG_MUTANT_NO_KEY_USAGE_RESTRICTION
+        case LOWORD(X509_KEY_USAGE_RESTRICTION):
+            encodeFunc = CRYPT_AsnEncodeKeyUsageRestriction;
+            break;
+#endif
         case LOWORD(RSA_CSP_PUBLICKEYBLOB):
             encodeFunc = CRYPT_AsnEncodeRsaPubKey;
             break;
@@ -5438,6 +5536,10 @@
         encodeFunc = CRYPT_AsnEncodeEnumerated;
     else if (!strcmp(lpszStructType, szOID_KEY_USAGE))
         encodeFunc = CRYPT_AsnEncodeBits;
+#ifndef SG_MUTANT_NO_KEY_USAGE_RESTRICTION
+    else if (!strcmp(lpszStructType, szOID_KEY_USAGE_RESTRICTION))
+        encodeFunc = CRYPT_AsnEncodeKeyUsageRestriction;
+#endif
     else if (!strcmp(lpszStructType, szOID_SUBJECT_KEY_IDENTIFIER))
         encodeFunc = CRYPT_AsnEncodeOctets;
     else if (!strcmp(lpszStructType, szOID_BASIC_CONSTRAINTS))
--- a/dlls/crypt32/decode.c
+++ b/dlls/crypt32/decode.c
@@ -3760,6 +3760,66 @@
     return ret;
 }
 
+/* Stained Glass OS: the key usage restriction extension (2.5.29.4), as it is encoded (encode.c) */
+static BOOL CRYPT_AsnDecodeCertPolicyId(const BYTE *pbEncoded, DWORD cbEncoded,
+ DWORD dwFlags, void *pvStructInfo, DWORD *pcbStructInfo, DWORD *pcbDecoded)
+{
+    struct AsnArrayDescriptor arrayDesc = { ASN_SEQUENCEOF,
+     offsetof(CERT_POLICY_ID, cCertPolicyElementId),
+     offsetof(CERT_POLICY_ID, rgbszCertPolicyElementId),
+     FINALMEMBERSIZE(CERT_POLICY_ID, cCertPolicyElementId),
+     CRYPT_AsnDecodeOidInternal, sizeof(LPSTR), TRUE, 0 };
+
+    return CRYPT_AsnDecodeArray(&arrayDesc, pbEncoded, cbEncoded,
+     dwFlags, NULL, pvStructInfo, pcbStructInfo, pcbDecoded);
+}
+
+static BOOL CRYPT_AsnDecodeCertPolicyIdSet(const BYTE *pbEncoded, DWORD cbEncoded,
+ DWORD dwFlags, void *pvStructInfo, DWORD *pcbStructInfo, DWORD *pcbDecoded)
+{
+    struct AsnArrayDescriptor arrayDesc = { ASN_SEQUENCEOF,
+     offsetof(CERT_KEY_USAGE_RESTRICTION_INFO, cCertPolicyId),
+     offsetof(CERT_KEY_USAGE_RESTRICTION_INFO, rgCertPolicyId),
+     MEMBERSIZE(CERT_KEY_USAGE_RESTRICTION_INFO, cCertPolicyId, RestrictedKeyUsage),
+     CRYPT_AsnDecodeCertPolicyId, sizeof(CERT_POLICY_ID), TRUE,
+     offsetof(CERT_POLICY_ID, rgbszCertPolicyElementId) };
+
+    return CRYPT_AsnDecodeArray(&arrayDesc, pbEncoded, cbEncoded,
+     dwFlags, NULL, pvStructInfo, pcbStructInfo, pcbDecoded);
+}
+
+static BOOL WINAPI CRYPT_AsnDecodeKeyUsageRestriction(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const BYTE *pbEncoded, DWORD cbEncoded, DWORD dwFlags,
+ PCRYPT_DECODE_PARA pDecodePara, void *pvStructInfo, DWORD *pcbStructInfo)
+{
+    BOOL ret = FALSE;
+
+    TRACE("%p, %ld, %08lx, %p, %p, %ld\n", pbEncoded, cbEncoded, dwFlags,
+     pDecodePara, pvStructInfo, pvStructInfo ? *pcbStructInfo : 0);
+
+    __TRY
+    {
+        struct AsnDecodeSequenceItem items[] = {
+         { ASN_SEQUENCEOF, offsetof(CERT_KEY_USAGE_RESTRICTION_INFO, cCertPolicyId),
+           CRYPT_AsnDecodeCertPolicyIdSet,
+           MEMBERSIZE(CERT_KEY_USAGE_RESTRICTION_INFO, cCertPolicyId, RestrictedKeyUsage), TRUE,
+           TRUE, offsetof(CERT_KEY_USAGE_RESTRICTION_INFO, rgCertPolicyId), 0 },
+         { ASN_BITSTRING, offsetof(CERT_KEY_USAGE_RESTRICTION_INFO, RestrictedKeyUsage),
+           CRYPT_AsnDecodeBitsInternal, sizeof(CRYPT_BIT_BLOB), TRUE, TRUE,
+           offsetof(CERT_KEY_USAGE_RESTRICTION_INFO, RestrictedKeyUsage.pbData), 0 },
+        };
+
+        ret = CRYPT_AsnDecodeSequence(items, ARRAY_SIZE(items), pbEncoded, cbEncoded,
+         dwFlags, pDecodePara, pvStructInfo, pcbStructInfo, NULL, NULL);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
+
 static BOOL CRYPT_AsnDecodeCertPolicyMapping(const BYTE *pbEncoded,
  DWORD cbEncoded, DWORD dwFlags, void *pvStructInfo, DWORD *pcbStructInfo,
  DWORD *pcbDecoded)
@@ -7379,6 +7439,9 @@
         case LOWORD(X509_CERT_POLICIES):
             decodeFunc = CRYPT_AsnDecodeCertPolicies;
             break;
+        case LOWORD(X509_KEY_USAGE_RESTRICTION):
+            decodeFunc = CRYPT_AsnDecodeKeyUsageRestriction;
+            break;
         case LOWORD(RSA_CSP_PUBLICKEYBLOB):
             decodeFunc = CRYPT_AsnDecodeRsaPubKey;
             break;
@@ -7535,6 +7598,8 @@
         decodeFunc = CRYPT_AsnDecodeEnumerated;
     else if (!strcmp(lpszStructType, szOID_KEY_USAGE))
