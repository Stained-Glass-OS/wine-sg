     else if (!strcmp(lpszStructType, szOID_SUBJECT_KEY_IDENTIFIER))
         decodeFunc = CRYPT_AsnDecodeOctetString;
     else if (!strcmp(lpszStructType, szOID_BASIC_CONSTRAINTS))
