From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Implement URLIS_APPLIABLE.

UrlIsA/W(URLIS_APPLIABLE) is TRUE when "the function is able to determine a
scheme": the URL has a known one, or UrlApplyScheme can guess one (www.,
ftp., a file path). It always returned FALSE with a FIXME. URLIS_NOHISTORY
keeps its FIXME.

Gate: test/kernelbase-urlisappliable-gate.sh (64/32).
---
 dlls/kernelbase/path.c | 24 ++++++++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

diff --git a/dlls/kernelbase/path.c b/dlls/kernelbase/path.c
index bc51e9d..c9994ad 100644
--- a/dlls/kernelbase/path.c
+++ b/dlls/kernelbase/path.c
@@ -4746,8 +4746,16 @@ BOOL WINAPI UrlIsA(const char *url, URLIS Urlis)
 #ifndef SG_MUTANT_URLIS_HASQUERY
         return strchr( url, '?' ) != NULL;
 #endif
-    case URLIS_NOHISTORY:
     case URLIS_APPLIABLE:
+#ifndef SG_MUTANT_URLIS_APPLIABLE
+    {
+        WCHAR *urlW = heap_strdupAtoW( url );
+        BOOL ret = urlW && UrlIsW( urlW, URLIS_APPLIABLE );
+        heap_free( urlW );
+        return ret;
+    }
+#endif
+    case URLIS_NOHISTORY:
     default:
         FIXME("(%s %d): stub\n", debugstr_a(url), Urlis);
     }
@@ -4795,8 +4803,20 @@ BOOL WINAPI UrlIsW(const WCHAR *url, URLIS Urlis)
 #ifndef SG_MUTANT_URLIS_HASQUERY
         return wcschr( url, '?' ) != NULL;
 #endif
-    case URLIS_NOHISTORY:
     case URLIS_APPLIABLE:
+#ifndef SG_MUTANT_URLIS_APPLIABLE
+    {
+        /* "Attempt to determine a valid scheme for the URL": it has a known
+         * one, or one can be guessed for it (www., ftp., a path) */
+        WCHAR buffer[INTERNET_MAX_URL_LENGTH];
+        DWORD len = ARRAY_SIZE(buffer);
+
+        base.cbSize = sizeof(base);
+        if (ParseURLW(url, &base) == S_OK && base.nScheme != URL_SCHEME_UNKNOWN) return TRUE;
+        return UrlApplySchemeW(url, buffer, &len, URL_APPLY_GUESSSCHEME | URL_APPLY_GUESSFILE) == S_OK;
+    }
+#endif
+    case URLIS_NOHISTORY:
     default:
         FIXME("(%s %d): stub\n", debugstr_w(url), Urlis);
     }
