+static WCHAR *wide_from_ansi( const char *str )
+{
+    WCHAR *ret;
+    int len;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar( CP_ACP, 0, str, -1, NULL, 0 );
+    if ((ret = malloc( len * sizeof(WCHAR) ))) MultiByteToWideChar( CP_ACP, 0, str, -1, ret, len );
+    return ret;
+}
+
+/******************************************************************************
+ * TreeResetNamedSecurityInfoA   [ADVAPI32.@]
+ */
+DWORD WINAPI TreeResetNamedSecurityInfoA( LPSTR name, SE_OBJECT_TYPE type, SECURITY_INFORMATION info, PSID owner,
+                                          PSID group, PACL dacl, PACL sacl, BOOL keep_explicit, FN_PROGRESS progress,
+                                          PROG_INVOKE_SETTING pis, PVOID args )
+{
+    WCHAR *nameW = wide_from_ansi( name );
+    DWORD ret;
+
+    TRACE( "(%s, %d, %#lx, ...)\n", debugstr_a(name), type, info );
+    if (name && !nameW) return ERROR_NOT_ENOUGH_MEMORY;
+    ret = TreeResetNamedSecurityInfoW( nameW, type, info, owner, group, dacl, sacl, keep_explicit, progress, pis, args );
+    free( nameW );
+    return ret;
+}
+
+DWORD WINAPI TreeSetNamedSecurityInfoA( LPSTR name, SE_OBJECT_TYPE type, SECURITY_INFORMATION info, PSID owner,
+                                        PSID group, PACL dacl, PACL sacl, DWORD action, FN_PROGRESS progress,
+                                        PROG_INVOKE_SETTING pis, PVOID args )
+{
+    WCHAR *nameW = wide_from_ansi( name );
+    DWORD ret;
+
+    if (name && !nameW) return ERROR_NOT_ENOUGH_MEMORY;
+    ret = TreeSetNamedSecurityInfoW( nameW, type, info, owner, group, dacl, sacl, action, progress, pis, args );
+    free( nameW );
+    return ret;
+}
+
+/* the parent of a named object: its name without the last component */
+static WCHAR *parent_name( const WCHAR *name )
+{
+    const WCHAR *slash = wcsrchr( name, '\\' );
+    WCHAR *ret;
+    size_t len;
+
+    if (!slash || slash == name) return NULL;
+    len = slash - name;
+    /* a drive root keeps its backslash */
+    if (len == 2 && name[1] == ':') len++;
+    if (len >= wcslen( name )) return NULL;
+    if (!(ret = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( ret, name, len * sizeof(WCHAR) );
+    ret[len] = 0;
+    return ret;
+}
+
+static BOOL ace_parts( ACE_HEADER *ace, DWORD *mask, PSID *sid )
+{
+    switch (ace->AceType)
+    {
+    case ACCESS_ALLOWED_ACE_TYPE:
+    case ACCESS_DENIED_ACE_TYPE:
+    case SYSTEM_AUDIT_ACE_TYPE:
+    case SYSTEM_ALARM_ACE_TYPE:
+        *mask = ((ACCESS_ALLOWED_ACE *)ace)->Mask;
+        *sid = &((ACCESS_ALLOWED_ACE *)ace)->SidStart;
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+/* the ancestor's ACE an inherited one comes from: same type, trustee and (mapped) rights, inheritable */
+static BOOL ace_inherited_from( ACE_HEADER *child, ACE_HEADER *parent, BOOL container, BOOL direct,
+                                PGENERIC_MAPPING mapping )
+{
+    DWORD child_mask, parent_mask;
+    PSID child_sid, parent_sid;
+    BYTE inherit = container ? CONTAINER_INHERIT_ACE : OBJECT_INHERIT_ACE;
+
+    if (child->AceType != parent->AceType) return FALSE;
+    if (!ace_parts( child, &child_mask, &child_sid ) || !ace_parts( parent, &parent_mask, &parent_sid )) return FALSE;
+#ifndef SG_MUTANT_INHERIT_ANY_ACE
+    if (!(parent->AceFlags & inherit)) return FALSE;
+#endif
+    if (!direct && (parent->AceFlags & NO_PROPAGATE_INHERIT_ACE)) return FALSE;
+    if (mapping)
+    {
+        MapGenericMask( &child_mask, mapping );
+        MapGenericMask( &parent_mask, mapping );
+    }
+    return child_mask == parent_mask && EqualSid( child_sid, parent_sid );
+}
+
+/******************************************************************************
+ * GetInheritanceSourceW   [ADVAPI32.@]
+ */
+DWORD WINAPI GetInheritanceSourceW( LPWSTR name, SE_OBJECT_TYPE type, SECURITY_INFORMATION info, BOOL container,
+                                    GUID **guids, DWORD guid_count, PACL acl, PFN_OBJECT_MGR_FUNCTS funcs,
+                                    PGENERIC_MAPPING mapping, PINHERITED_FROMW result )
+{
+    ACL_SIZE_INFORMATION size_info;
+    DWORD i;
+
+    TRACE( "(%s, %d, %#lx, %d, %p, %lu, %p, %p, %p, %p)\n", debugstr_w(name), type, info, container, guids,
+           guid_count, acl, funcs, mapping, result );
+
+    if (!name || !acl || !result || (info != DACL_SECURITY_INFORMATION && info != SACL_SECURITY_INFORMATION))
+        return ERROR_INVALID_PARAMETER;
+    if (type != SE_FILE_OBJECT && type != SE_REGISTRY_KEY && type != SE_REGISTRY_WOW64_32KEY)
+    {
+        FIXME( "object type %d\n", type );
+        return ERROR_INVALID_PARAMETER;
+    }
+    if (!GetAclInformation( acl, &size_info, sizeof(size_info), AclSizeInformation )) return GetLastError();
+
+    for (i = 0; i < size_info.AceCount; i++)
+    {
+        ACE_HEADER *ace;
+        WCHAR *current, *up;
+        LONG gap = 0;
+
+        result[i].GenerationGap = 0;
+        result[i].AncestorName = NULL;
+        if (!GetAce( acl, i, (void **)&ace ) || !(ace->AceFlags & INHERITED_ACE)) continue;
+
+        /* up the ancestors to the one whose matching ACE is its own, not inherited */
+        result[i].GenerationGap = -1;
+        current = wcsdup( name );
+        while (current && (up = parent_name( current )))
+        {
+            PSECURITY_DESCRIPTOR sd = NULL;
+            PACL parent_acl = NULL;
+            ACL_SIZE_INFORMATION parent_info;
+            ACE_HEADER *parent_ace;
+            BOOL found = FALSE, explicit = FALSE;
+            DWORD j;
+
+            free( current );
+            current = up;
+            gap++;
+            if (GetNamedSecurityInfoW( current, type, info, NULL, NULL, info == DACL_SECURITY_INFORMATION ? &parent_acl : NULL,
+                                       info == SACL_SECURITY_INFORMATION ? &parent_acl : NULL, &sd ))
+                break;
+            if (parent_acl && GetAclInformation( parent_acl, &parent_info, sizeof(parent_info), AclSizeInformation ))
+            {
+                for (j = 0; j < parent_info.AceCount && !found; j++)
+                {
+                    if (!GetAce( parent_acl, j, (void **)&parent_ace )) continue;
+                    if (!ace_inherited_from( ace, parent_ace, container || gap > 1, gap == 1, mapping )) continue;
+                    found = TRUE;
+                    explicit = !(parent_ace->AceFlags & INHERITED_ACE);
+                }
+            }
+            LocalFree( sd );
+            if (!found) break;
+            if (explicit)
+            {
+                result[i].GenerationGap = gap;
+                if ((result[i].AncestorName = LocalAlloc( LMEM_FIXED, (wcslen( current ) + 1) * sizeof(WCHAR) )))
+                    lstrcpyW( result[i].AncestorName, current );
+                break;
+            }
+        }
+        free( current );
+    }
+    return ERROR_SUCCESS;
+}
+
+/******************************************************************************
+ * GetInheritanceSourceA   [ADVAPI32.@]
+ */
+DWORD WINAPI GetInheritanceSourceA( LPSTR name, SE_OBJECT_TYPE type, SECURITY_INFORMATION info, BOOL container,
+                                    GUID **guids, DWORD guid_count, PACL acl, PFN_OBJECT_MGR_FUNCTS funcs,
+                                    PGENERIC_MAPPING mapping, PINHERITED_FROMA result )
+{
+    ACL_SIZE_INFORMATION size_info;
+    INHERITED_FROMW *wide;
+    WCHAR *nameW;
+    DWORD ret, i;
+
+    if (!name || !acl || !result) return ERROR_INVALID_PARAMETER;
+    if (!GetAclInformation( acl, &size_info, sizeof(size_info), AclSizeInformation )) return GetLastError();
+    if (!(nameW = wide_from_ansi( name ))) return ERROR_NOT_ENOUGH_MEMORY;
+    if (!(wide = calloc( size_info.AceCount + 1, sizeof(*wide) )))
+    {
+        free( nameW );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    ret = GetInheritanceSourceW( nameW, type, info, container, guids, guid_count, acl, funcs, mapping, wide );
+    for (i = 0; ret == ERROR_SUCCESS && i < size_info.AceCount; i++)
+    {
+        result[i].GenerationGap = wide[i].GenerationGap;
+        result[i].AncestorName = NULL;
+        if (wide[i].AncestorName)
+        {
+            int len = WideCharToMultiByte( CP_ACP, 0, wide[i].AncestorName, -1, NULL, 0, NULL, NULL );
+            if ((result[i].AncestorName = LocalAlloc( LMEM_FIXED, len )))
+                WideCharToMultiByte( CP_ACP, 0, wide[i].AncestorName, -1, result[i].AncestorName, len, NULL, NULL );
+            LocalFree( wide[i].AncestorName );
+        }
+    }
+    free( wide );
+    free( nameW );
+    return ret;
+}
+
+/******************************************************************************
+ * FreeInheritedFromArray   [ADVAPI32.@]
+ */
+DWORD WINAPI FreeInheritedFromArray( PINHERITED_FROMW array, USHORT count, PFN_OBJECT_MGR_FUNCTS funcs )
+{
+    USHORT i;
+
+    TRACE( "%p %u %p\n", array, count, funcs );
+    if (!array) return ERROR_INVALID_PARAMETER;
+    for (i = 0; i < count; i++)
+    {
+        LocalFree( array[i].AncestorName );
+        array[i].AncestorName = NULL;
+    }
+    return ERROR_SUCCESS;
+}
