+/******************************************************************************
+ * AccessCheckAndAuditAlarmW    (kernelbase.@)
+ */
+BOOL WINAPI AccessCheckAndAuditAlarmW( LPCWSTR subsystem, LPVOID id, LPWSTR type_name,
+                                       LPWSTR name, PSECURITY_DESCRIPTOR descr, DWORD access,
+                                       PGENERIC_MAPPING mapping, BOOL creation,
+                                       LPDWORD granted, LPBOOL status, LPBOOL on_close )
+{
+    BYTE privs[sizeof(PRIVILEGE_SET) + 8 * sizeof(LUID_AND_ATTRIBUTES)];
+    DWORD len = sizeof(privs);
+    HANDLE token;
+    BOOL audit, ret;
+
+    TRACE( "(%s,%p,%s,%s,%p,%08lx,%p,%x,%p,%p,%p)\n", debugstr_w(subsystem), id, debugstr_w(type_name),
+           debugstr_w(name), descr, access, mapping, creation, granted, status, on_close );
+
+    if (!descr || !mapping || !granted || !status)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!audit_check_begin( 0, NULL, &token, &audit )) return FALSE;
+    ret = AccessCheck( descr, token, access, mapping, (PPRIVILEGE_SET)privs, &len, granted, status );
+    if (ret && on_close) *on_close = audit && sacl_audits_access( descr, token, *status ? *granted : access, *status );
+    CloseHandle( token );
+    return ret;
+}
+
+static BOOL by_type_audit( HANDLE client, PSECURITY_DESCRIPTOR descr, PSID self, DWORD access, DWORD flags,
+                           POBJECT_TYPE_LIST types, DWORD types_len, PGENERIC_MAPPING mapping,
+                           LPDWORD granted, LPBOOL status, LPDWORD granted_list, LPDWORD status_list, LPBOOL on_close )
+{
+    BYTE privs[sizeof(PRIVILEGE_SET) + 8 * sizeof(LUID_AND_ATTRIBUTES)];
+    DWORD len = sizeof(privs);
+    HANDLE token;
+    BOOL audit, ret, ok;
+
+    if (!audit_check_begin( flags, client, &token, &audit )) return FALSE;
+    if (granted_list)
+    {
+        ret = AccessCheckByTypeResultList( descr, self, token, access, types, types_len, mapping,
+                                           (PPRIVILEGE_SET)privs, &len, granted_list, status_list );
+        ok = ret && !status_list[0];
+        if (ret && on_close) *on_close = audit && sacl_audits_access( descr, token, ok ? granted_list[0] : access, ok );
+    }
+    else
+    {
+        ret = AccessCheckByType( descr, self, token, access, types, types_len, mapping,
+                                 (PPRIVILEGE_SET)privs, &len, granted, status );
+        if (ret && on_close) *on_close = audit && sacl_audits_access( descr, token, *status ? *granted : access, *status );
+    }
+    if (!client) CloseHandle( token );
+    return ret;
+}
