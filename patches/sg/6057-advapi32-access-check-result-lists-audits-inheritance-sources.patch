+/* Stained Glass OS: the A forms and the rest of the access-control helpers. */
+
+/******************************************************************************
+ * BuildImpersonateTrusteeA/W   [ADVAPI32.@]
+ */
+VOID WINAPI BuildImpersonateTrusteeA( PTRUSTEEA trustee, PTRUSTEEA impersonate )
+{
+    TRACE( "%p %p\n", trustee, impersonate );
+    trustee->pMultipleTrustee = impersonate;
+    trustee->MultipleTrusteeOperation = TRUSTEE_IS_IMPERSONATE;
+}
+
+VOID WINAPI BuildImpersonateTrusteeW( PTRUSTEEW trustee, PTRUSTEEW impersonate )
+{
+    TRACE( "%p %p\n", trustee, impersonate );
+    trustee->pMultipleTrustee = impersonate;
+    trustee->MultipleTrusteeOperation = TRUSTEE_IS_IMPERSONATE;
+}
+
+/******************************************************************************
+ * BuildImpersonateExplicitAccessWithNameA/W   [ADVAPI32.@]
+ */
+VOID WINAPI BuildImpersonateExplicitAccessWithNameA( PEXPLICIT_ACCESSA access, LPSTR name, PTRUSTEEA trustee,
+                                                     DWORD permissions, ACCESS_MODE mode, DWORD inheritance )
+{
+    TRACE( "%p %s %p %#lx %d %#lx\n", access, debugstr_a(name), trustee, permissions, mode, inheritance );
+    BuildExplicitAccessWithNameA( access, name, permissions, mode, inheritance );
+    BuildImpersonateTrusteeA( &access->Trustee, trustee );
+}
+
+VOID WINAPI BuildImpersonateExplicitAccessWithNameW( PEXPLICIT_ACCESSW access, LPWSTR name, PTRUSTEEW trustee,
+                                                     DWORD permissions, ACCESS_MODE mode, DWORD inheritance )
+{
+    TRACE( "%p %s %p %#lx %d %#lx\n", access, debugstr_w(name), trustee, permissions, mode, inheritance );
+    BuildExplicitAccessWithNameW( access, name, permissions, mode, inheritance );
+    BuildImpersonateTrusteeW( &access->Trustee, trustee );
+}
+
+/******************************************************************************
+ * GetMultipleTrusteeA/W, GetMultipleTrusteeOperationA/W   [ADVAPI32.@]
+ */
+PTRUSTEEA WINAPI GetMultipleTrusteeA( PTRUSTEEA trustee )
+{
+    return trustee ? trustee->pMultipleTrustee : NULL;
+}
+
+PTRUSTEEW WINAPI GetMultipleTrusteeW( PTRUSTEEW trustee )
+{
+    return trustee ? trustee->pMultipleTrustee : NULL;
+}
+
+MULTIPLE_TRUSTEE_OPERATION WINAPI GetMultipleTrusteeOperationA( PTRUSTEEA trustee )
+{
+    return trustee ? trustee->MultipleTrusteeOperation : NO_MULTIPLE_TRUSTEE;
+}
+
+MULTIPLE_TRUSTEE_OPERATION WINAPI GetMultipleTrusteeOperationW( PTRUSTEEW trustee )
+{
+    return trustee ? trustee->MultipleTrusteeOperation : NO_MULTIPLE_TRUSTEE;
+}
