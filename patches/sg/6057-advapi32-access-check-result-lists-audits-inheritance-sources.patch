+        PGENERIC_MAPPING mapping, BOOL creation, LPDWORD granted_list, LPDWORD status_list, LPBOOL on_close )
+{
+    return AccessCheckByTypeResultListAndAuditAlarmByHandleW( NULL, id, client, NULL, NULL, descr, self, access,
+                                                              audit_type, flags, types, types_len, mapping,
+                                                              creation, granted_list, status_list, on_close );
+}
