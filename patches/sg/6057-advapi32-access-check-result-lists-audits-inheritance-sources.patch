+/* Stained Glass OS: the access checks that generate audits. The caller's own (primary) token must hold
+ * SeAuditPrivilege; the check is made for the client the thread impersonates (or the token given).
+ * With AUDIT_ALLOW_NO_PRIVILEGE a caller without the privilege is checked without an audit. */
+static BOOL process_audit_privilege_held(void)
+{
+    PRIVILEGE_SET set;
+    HANDLE token;
+    BOOL result = FALSE, ok;
+
+    if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return FALSE;
+    set.PrivilegeCount = 1;
+    set.Control = PRIVILEGE_SET_ALL_NECESSARY;
+    set.Privilege[0].Luid.LowPart = 21; /* SE_AUDIT_PRIVILEGE */
+    set.Privilege[0].Luid.HighPart = 0;
+    set.Privilege[0].Attributes = 0;
+    ok = PrivilegeCheck( token, &set, &result );
+    CloseHandle( token );
+#ifdef SG_MUTANT_AUDIT_NO_PRIVILEGE_CHECK
+    return TRUE;
+#endif
+    return ok && result;
+}
+
+static BOOL audit_check_begin( DWORD flags, HANDLE client, HANDLE *token, BOOL *audit )
+{
+    *audit = process_audit_privilege_held();
+    if (!*audit && !(flags & AUDIT_ALLOW_NO_PRIVILEGE))
+    {
+        SetLastError( ERROR_PRIVILEGE_NOT_HELD );
+        return FALSE;
+    }
+    if (client)
+    {
+        *token = client;
+        return TRUE;
+    }
+    if (!OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, token ))
+    {
+        SetLastError( ERROR_NO_IMPERSONATION_TOKEN );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* an object ACE applies when its object type is one of these (plain ACEs always apply) */
+static BOOL filter_object_acl( const ACL *orig, PSID self, const GUID *const *set, DWORD set_len, PACL *ret )
+{
+    static const SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    ACL_SIZE_INFORMATION info;
+    PACL acl;
+    DWORD i, k, size;
+
+    if (RtlQueryInformationAcl( (PACL)orig, &info, sizeof(info), AclSizeInformation )) return FALSE;
+    size = orig->AclSize + info.AceCount * (self ? GetLengthSid( self ) : 0) + 64;
+    if (!(acl = LocalAlloc( LMEM_FIXED, size ))) { SetLastError( ERROR_NOT_ENOUGH_MEMORY ); return FALSE; }
+    if (!InitializeAcl( acl, size, ACL_REVISION )) { LocalFree( acl ); return FALSE; }
+    for (i = 0; i < info.AceCount; i++)
+    {
+        ACE_HEADER *ace;
+        PSID sid;
+        DWORD mask, flags, ace_flags;
+        const GUID *object = NULL;
+        BYTE *pos;
+        BOOL allow, ok = TRUE;
+
+        if (RtlGetAce( (PACL)orig, i, (void **)&ace )) continue;
+        ace_flags = ace->AceFlags & (OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE | NO_PROPAGATE_INHERIT_ACE | INHERIT_ONLY_ACE);
+        switch (ace->AceType)
+        {
+        case ACCESS_ALLOWED_ACE_TYPE:
+        case ACCESS_DENIED_ACE_TYPE:
+            mask = ((ACCESS_ALLOWED_ACE *)ace)->Mask;
+            sid = (PSID)&((ACCESS_ALLOWED_ACE *)ace)->SidStart;
+            allow = ace->AceType == ACCESS_ALLOWED_ACE_TYPE;
+            break;
+        case ACCESS_ALLOWED_OBJECT_ACE_TYPE:
+        case ACCESS_DENIED_OBJECT_ACE_TYPE:
+            mask = ((ACCESS_ALLOWED_OBJECT_ACE *)ace)->Mask;
+            flags = ((ACCESS_ALLOWED_OBJECT_ACE *)ace)->Flags;
+            pos = (BYTE *)&((ACCESS_ALLOWED_OBJECT_ACE *)ace)->ObjectType;
+            if (flags & ACE_OBJECT_TYPE_PRESENT) { object = (const GUID *)pos; pos += sizeof(GUID); }
+            if (flags & ACE_INHERITED_OBJECT_TYPE_PRESENT) pos += sizeof(GUID);
+            sid = (PSID)pos;
+            allow = ace->AceType == ACCESS_ALLOWED_OBJECT_ACE_TYPE;
+            if (object)
+                for (ok = FALSE, k = 0; k < set_len && !ok; k++) ok = !memcmp( object, set[k], sizeof(GUID) );
+#ifdef SG_MUTANT_RESULTLIST_SKIP_DENY
+            if (!allow) ok = FALSE;
+#endif
+            break;
+        default:
+            continue;
+        }
+        if (!ok) continue;
+        if (self && *GetSidSubAuthorityCount( sid ) == 1 && *GetSidSubAuthority( sid, 0 ) == SECURITY_PRINCIPAL_SELF_RID &&
+            !memcmp( GetSidIdentifierAuthority( sid ), &nt, sizeof(nt) ))
+            sid = self;
+        if (!(allow ? AddAccessAllowedAceEx( acl, ACL_REVISION, ace_flags, mask, sid )
+                    : AddAccessDeniedAceEx( acl, ACL_REVISION, ace_flags, mask, sid )))
+        {
+            LocalFree( acl );
+            return FALSE;
+        }
+    }
+    *ret = acl;
+    return TRUE;
+}
+
+/* a node's access: the ACEs for it and for its ancestors (an object type's access goes down to its children) */
+static BOOL access_check_node( PSECURITY_DESCRIPTOR descr, PSID self, HANDLE token, DWORD access,
+                               const OBJECT_TYPE_LIST *types, DWORD node, PGENERIC_MAPPING mapping,
+                               PPRIVILEGE_SET priv, LPDWORD priv_len, LPDWORD granted, LPBOOL status )
+{
+    const GUID *path[256];
+    SECURITY_DESCRIPTOR filtered;
+    BOOL present, defaulted, ret;
+    PACL dacl, plain = NULL;
+    PSID owner, group;
+    DWORD count = 0, level = types[node].Level, j;
+
+    if (!GetSecurityDescriptorDacl( descr, &present, &dacl, &defaulted )) return FALSE;
+    if (!present || !dacl) return AccessCheck( descr, token, access, mapping, priv, priv_len, granted, status );
+    path[count++] = types[node].ObjectType;
+#ifndef SG_MUTANT_RESULTLIST_NO_INHERIT
+    for (j = node; j-- > 0 && level && count < ARRAY_SIZE(path); )
+    {
+        if (types[j].Level != level - 1) continue;
+        path[count++] = types[j].ObjectType;
+        level--;
+    }
+#endif
+#ifdef SG_MUTANT_RESULTLIST_ALL_TYPES
+    for (count = 0, j = 0; types[j].ObjectType && count < ARRAY_SIZE(path) && (j == 0 || types[j].Level); j++)
+        path[count++] = types[j].ObjectType;
+#endif
+    if (!filter_object_acl( dacl, self, path, count, &plain )) return FALSE;
+    GetSecurityDescriptorOwner( descr, &owner, &defaulted );
+    GetSecurityDescriptorGroup( descr, &group, &defaulted );
+    InitializeSecurityDescriptor( &filtered, SECURITY_DESCRIPTOR_REVISION );
+    if (owner) SetSecurityDescriptorOwner( &filtered, owner, FALSE );
+    if (group) SetSecurityDescriptorGroup( &filtered, group, FALSE );
+    SetSecurityDescriptorDacl( &filtered, TRUE, plain, FALSE );
+    ret = AccessCheck( &filtered, token, access, mapping, priv, priv_len, granted, status );
+    LocalFree( plain );
+    return ret;
+}
