+        PSECURITY_DESCRIPTOR descr, PSID self, DWORD access, AUDIT_EVENT_TYPE audit_type, DWORD flags,
+        POBJECT_TYPE_LIST types, DWORD types_len, PGENERIC_MAPPING mapping, BOOL creation,
+        LPDWORD granted_list, LPDWORD status_list, LPBOOL on_close )
+{
+    return AccessCheckByTypeResultListAndAuditAlarmW( NULL, id, NULL, NULL, descr, self, access, audit_type, flags,
+                                                      types, types_len, mapping, creation, granted_list,
+                                                      status_list, on_close );
+}
+
+BOOL WINAPI AccessCheckByTypeResultListAndAuditAlarmByHandleA( LPCSTR subsystem, LPVOID id, HANDLE client,
+        LPCSTR type_name, LPCSTR name, PSECURITY_DESCRIPTOR descr, PSID self, DWORD access,
