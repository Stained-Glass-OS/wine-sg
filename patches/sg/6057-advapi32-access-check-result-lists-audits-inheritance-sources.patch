+BOOL WINAPI AccessCheckByTypeAndAuditAlarmW( LPCWSTR subsystem, LPVOID id, LPCWSTR type_name, LPCWSTR name,
+                                             PSECURITY_DESCRIPTOR descr, PSID self, DWORD access,
+                                             AUDIT_EVENT_TYPE audit_type, DWORD flags, POBJECT_TYPE_LIST types,
+                                             DWORD types_len, PGENERIC_MAPPING mapping, BOOL creation,
+                                             LPDWORD granted, LPBOOL status, LPBOOL on_close )
+{
+    TRACE( "(%s,%p,%s,%s,%p,%p,%#lx,%d,%#lx,%p,%lu,%p,%d,%p,%p,%p)\n", debugstr_w(subsystem), id,
+           debugstr_w(type_name), debugstr_w(name), descr, self, access, audit_type, flags, types, types_len,
+           mapping, creation, granted, status, on_close );
+    if (!granted || !status)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return by_type_audit( NULL, descr, self, access, flags, types, types_len, mapping, granted, status,
+                          NULL, NULL, on_close );
+}
