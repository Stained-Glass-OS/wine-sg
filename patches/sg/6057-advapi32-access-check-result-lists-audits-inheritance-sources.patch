+/******************************************************************************
+ * AccessCheckByTypeResultList    (kernelbase.@)
+ */
+BOOL WINAPI AccessCheckByTypeResultList( PSECURITY_DESCRIPTOR descr, PSID sid, HANDLE token, DWORD access,
+                                         POBJECT_TYPE_LIST types, DWORD types_len, PGENERIC_MAPPING mapping,
+                                         PPRIVILEGE_SET priv, LPDWORD priv_len, LPDWORD granted_list,
+                                         LPDWORD status_list )
+{
+    DWORD i;
+
+    TRACE( "%p %p %p %#lx %p %lu %p %p %p %p %p\n", descr, sid, token, access, types, types_len, mapping,
+           priv, priv_len, granted_list, status_list );
+
+    if (!descr || !mapping || !granted_list || !status_list || !types || !types_len)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (sid && !IsValidSid( sid ))
+    {
+        SetLastError( ERROR_INVALID_SID );
+        return FALSE;
+    }
+    for (i = 0; i < types_len; i++)
+    {
+        if (!types[i].ObjectType || (i == 0 ? types[i].Level != 0 : (!types[i].Level || types[i].Level > types[i - 1].Level + 1)))
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+    }
+    /* each object type's own result */
+    for (i = 0; i < types_len; i++)
+    {
+        BOOL status;
+        DWORD len = priv_len ? *priv_len : 0;
+
+        if (!access_check_node( descr, sid, token, access, types, i, mapping, priv, priv_len ? &len : NULL,
+                                &granted_list[i], &status ))
+        {
+            if (priv_len) *priv_len = len;
+            return FALSE;
+        }
+        status_list[i] = status ? ERROR_SUCCESS : ERROR_ACCESS_DENIED;
+        if (!status) granted_list[i] = 0;
+        if (priv_len) *priv_len = len;
+    }
+    return TRUE;
+}
