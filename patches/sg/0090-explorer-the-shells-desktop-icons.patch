+/* Stained Glass OS: the shell's own desktop icons -- This PC, the user's
+ * files, Network, Recycle Bin, Control Panel -- shown as Windows shows them,
+ * by HKCU\...\Explorer\HideDesktopIcons\NewStartPanel ({CLSID} = 0 shown,
+ * 1 hidden; by default the Recycle Bin only, as on Windows). */
+static void add_shell_icons(void)
+{
+    static const struct { const WCHAR *clsid; BOOL shown; const WCHAR *title; } items[] =
+    {
+        { L"{20D04FE0-3AEA-1069-A2D8-08002B30309D}", FALSE, L"This PC" },
+        { L"{59031a47-3f72-44a7-89c5-5595fe6b30ee}", FALSE, NULL },     /* the user's own name */
+        { L"{F02C1A0D-BE21-4350-88B0-7367FC96EF3C}", FALSE, L"Network" },
+        { L"{645FF040-5081-101B-9F08-00AA002F954E}", TRUE,  L"Recycle Bin" },
+        { L"{5399E694-6CE5-4D6C-8FCE-1D8870FDCBA0}", FALSE, L"Control Panel" },
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(items); i++)
+    {
+        struct launcher *launcher;
+        SHFILEINFOW info;
+        LPITEMIDLIST pidl;
+        WCHAR name[64];
+        DWORD hidden = !items[i].shown, size = sizeof(hidden);
+
+        RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\HideDesktopIcons\\NewStartPanel",
+                      items[i].clsid, RRF_RT_REG_DWORD, NULL, &hidden, &size );
+        if (hidden) continue;
+        swprintf( name, ARRAY_SIZE(name), L"::%s", items[i].clsid );
+        if (FAILED(SHParseDisplayName( name, NULL, &pidl, 0, NULL ))) continue;
+        memset( &info, 0, sizeof(info) );
+        if (SHGetFileInfoW( (const WCHAR *)pidl, 0, &info, sizeof(info),
+                            SHGFI_PIDL | SHGFI_ICON | SHGFI_LARGEICON | SHGFI_DISPLAYNAME ) && info.hIcon &&
+            nb_launchers < nb_allocated && (launcher = calloc( 1, sizeof(*launcher) )))
+        {
+            WCHAR user[64];
+            DWORD len = ARRAY_SIZE(user);
+
+            launcher->icon = info.hIcon;
+            if (items[i].title) launcher->title = wcsdup( items[i].title );
+            else launcher->title = wcsdup( GetUserNameW( user, &len ) ? user : info.szDisplayName );
+            launcher->path = wcsdup( L"explorer.exe" );
+            launcher->args = wcsdup( name );
+            if (!wcsicmp( items[i].clsid, L"{5399E694-6CE5-4D6C-8FCE-1D8870FDCBA0}" ))
+            {
+                free( launcher->path ); free( launcher->args );
+                launcher->path = wcsdup( L"control.exe" );
+                launcher->args = NULL;
+            }
+            launchers[nb_launchers++] = launcher;
+        }
+        else if (info.hIcon) DestroyIcon( info.hIcon );
+        CoTaskMemFree( pidl );
+    }
+}
+
