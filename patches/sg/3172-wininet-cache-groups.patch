+
+    TRACE("(0x%s, 0x%08lx, %p)\n", wine_dbgstr_longlong(GroupId), dwFlags, lpReserved);
+
+    if (lpReserved || GroupId <= 0)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    mutex = group_mutex();
+    if (!(gk = group_open(GroupId, KEY_READ)))
+    {
+        group_unlock(mutex);
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return FALSE;
+    }
+    if ((dwFlags & CACHEGROUP_FLAG_FLUSHURL_ONDELETE) && !RegOpenKeyExW(gk, L"Members", 0, KEY_READ, &members))
+    {
+        DWORD i;
+        for (i = 0; ; i++)
+        {
+            WCHAR url[INTERNET_MAX_URL_LENGTH + 1];
+            DWORD len = ARRAY_SIZE(url);
+            if (RegEnumValueW(members, i, url, &len, NULL, NULL, NULL, NULL)) break;
+            #ifndef SG_MUTANT_WININET_FLUSHALL
