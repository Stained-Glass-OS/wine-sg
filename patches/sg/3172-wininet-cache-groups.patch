+
+static BOOL group_set_attribute(GROUPID gid, DWORD flags, DWORD attrs, const INTERNET_CACHE_GROUP_INFOW *info,
+                                void *reserved)
+{
+    HKEY gk;
+    DWORD err = 0;
+
+    if (flags || reserved || !info || !attrs ||
+        (attrs & ~(CACHEGROUP_ATTRIBUTE_FLAG | CACHEGROUP_ATTRIBUTE_TYPE | CACHEGROUP_ATTRIBUTE_QUOTA |
+                   CACHEGROUP_ATTRIBUTE_GROUPNAME | CACHEGROUP_ATTRIBUTE_STORAGE)))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(gk = group_open(gid, KEY_ALL_ACCESS)))
+    {
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return FALSE;
+    }
+    if (attrs & CACHEGROUP_ATTRIBUTE_FLAG)
+        err = RegSetValueExW(gk, L"Flags", 0, REG_DWORD, (const BYTE *)&info->dwGroupFlags, sizeof(DWORD));
+    if (!err && (attrs & CACHEGROUP_ATTRIBUTE_TYPE))
+        err = RegSetValueExW(gk, L"Type", 0, REG_DWORD, (const BYTE *)&info->dwGroupType, sizeof(DWORD));
+    if (!err && (attrs & CACHEGROUP_ATTRIBUTE_QUOTA))
+        err = RegSetValueExW(gk, L"Quota", 0, REG_DWORD, (const BYTE *)&info->dwDiskQuota, sizeof(DWORD));
+    if (!err && (attrs & CACHEGROUP_ATTRIBUTE_STORAGE))
+        err = RegSetValueExW(gk, L"Storage", 0, REG_BINARY, (const BYTE *)info->dwOwnerStorage,
+                             sizeof(info->dwOwnerStorage));
+    if (!err && (attrs & CACHEGROUP_ATTRIBUTE_GROUPNAME))
+    {
+        WCHAR name[GROUPNAME_MAX_LENGTH];
+        lstrcpynW(name, info->szGroupName, ARRAY_SIZE(name));
+        err = RegSetValueExW(gk, L"GroupName", 0, REG_SZ, (const BYTE *)name, (wcslen(name) + 1) * sizeof(WCHAR));
+    }
+    RegCloseKey(gk);
+    if (err) SetLastError(err);
+    return !err;
 }
 
