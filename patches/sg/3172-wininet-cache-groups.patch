+static BOOL set_entry_group(const WCHAR *url, DWORD flags, GROUPID id, BYTE *attrs, DWORD cb, void *reserved)
+{
+    HKEY gk, members;
+    DWORD size = 0, err, one = 1;
+    BOOL ret = FALSE;
+
+    if (!url || attrs || cb || reserved || (flags != INTERNET_CACHE_GROUP_ADD && flags != INTERNET_CACHE_GROUP_REMOVE))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(gk = group_open(id, KEY_ALL_ACCESS)))
+    {
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return FALSE;
+    }
+    if (flags == INTERNET_CACHE_GROUP_ADD)
+    {
+        GetUrlCacheEntryInfoW(url, NULL, &size);
+        if (GetLastError() == ERROR_FILE_NOT_FOUND && !size)
+        {
+            RegCloseKey(gk);
+            return FALSE;
+        }
+        if (!(err = RegCreateKeyExW(gk, L"Members", 0, NULL, 0, KEY_ALL_ACCESS, NULL, &members, NULL)))
+        {
+            err = RegSetValueExW(members, url, 0, REG_DWORD, (BYTE *)&one, sizeof(one));
+            RegCloseKey(members);
+        }
+        if (err) SetLastError(err);
+        ret = !err;
+    }
+    else
+    {
+        if (!(err = RegOpenKeyExW(gk, L"Members", 0, KEY_ALL_ACCESS, &members)))
+        {
+            err = RegDeleteValueW(members, url);
+            RegCloseKey(members);
+        }
+        if (err) SetLastError(err == ERROR_FILE_NOT_FOUND ? ERROR_FILE_NOT_FOUND : err);
+        ret = !err;
+    }
+    RegCloseKey(gk);
+    return ret;
+}
