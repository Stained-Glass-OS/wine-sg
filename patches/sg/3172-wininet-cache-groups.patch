  */
 INTERNETAPI GROUPID WINAPI CreateUrlCacheGroup(DWORD dwFlags, LPVOID lpReserved)
 {
-  FIXME("(0x%08lx, %p): stub\n", dwFlags, lpReserved);
-  return FALSE;
+    HANDLE mutex;
+    HKEY root, gk;
+    ULONGLONG next = 0;
+    DWORD size = sizeof(next), zero = 0;
+    WCHAR name[17];
+    GROUPID id;
+    DWORD err;
+
+    TRACE("(0x%08lx, %p)\n", dwFlags, lpReserved);
+
+    if (lpReserved || (dwFlags & ~(CACHEGROUP_FLAG_NONPURGEABLE | CACHEGROUP_FLAG_GIDONLY)))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return 0;
+    }
+    mutex = group_mutex();
+    if ((err = RegCreateKeyExW(HKEY_CURRENT_USER, groups_root_name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &root, NULL)))
+    {
+        group_unlock(mutex);
+        SetLastError(err);
+        return 0;
+    }
+    if (RegQueryValueExW(root, L"NextId", NULL, NULL, (BYTE *)&next, &size) || next < 0x0100000000000001ull)
+        next = 0x0100000000000001ull;
+    id = next;
+    next++;
+    RegSetValueExW(root, L"NextId", 0, REG_QWORD, (const BYTE *)&next, sizeof(next));
+    if (!(dwFlags & CACHEGROUP_FLAG_GIDONLY))
+    {
+        group_id_name(id, name);
+        if (!(err = RegCreateKeyExW(root, name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &gk, NULL)))
+        {
+            DWORD flags = dwFlags & CACHEGROUP_FLAG_NONPURGEABLE;
+            RegSetValueExW(gk, L"Flags", 0, REG_DWORD, (BYTE *)&flags, sizeof(flags));
+            RegSetValueExW(gk, L"Type", 0, REG_DWORD, (BYTE *)&zero, sizeof(zero));
+            RegSetValueExW(gk, L"Quota", 0, REG_DWORD, (BYTE *)&zero, sizeof(zero));
+            RegCloseKey(gk);
+        }
+        else id = 0;
+    }
+    RegCloseKey(root);
+    group_unlock(mutex);
+    if (!id) SetLastError(err);
+    return id;
 }
 
