 BOOL WINAPI FindNextUrlCacheGroup( HANDLE hFind, GROUPID* lpGroupId, LPVOID lpReserved )
 {
-    FIXME("(%p, %p, %p) stub\n", hFind, lpGroupId, lpReserved);
+    find_handle *handle = hFind;
+    WCHAR name[32];
+    DWORD len;
+    GROUPID id;
+
+    TRACE("(%p, %p, %p)\n", hFind, lpGroupId, lpReserved);
