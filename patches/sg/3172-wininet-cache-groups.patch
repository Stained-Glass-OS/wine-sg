From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 07:52:22 -0700
Subject: [PATCH] wininet: URL cache groups

CreateUrlCacheGroup (GIDONLY and NONPURGEABLE), DeleteUrlCacheGroup (FLUSHURL_ONDELETE removes the
entries that belong to no other group), SetUrlCacheEntryGroupA/W (add/remove, entry must exist),
FindFirst/NextUrlCacheGroup, Get/SetUrlCacheGroupAttributeA/W (flags, type, quota, owner storage,
name, disk usage) and FindFirstUrlCacheEntryEx with a group id. Groups live per user in the registry
(HKCU\Software\Wine\WinInet\CacheGroups); entries are matched by URL, so a group spans containers.
Find handles are now zero-initialised at every allocation site.

diff --git a/dlls/wininet/urlcache.c b/dlls/wininet/urlcache.c
index b679255..d0e23f9 100644
--- a/dlls/wininet/urlcache.c
+++ b/dlls/wininet/urlcache.c
@@ -193,6 +193,11 @@ typedef struct
     DWORD hash_entry_idx;
     DWORD filter; /* CacheEntryType bits an entry needs one of, 0: all */
     BOOL containers; /* enumerates the containers, not the entries */
+    GROUPID group; /* entries: only the members of this group, 0: all */
+    HKEY members; /* group members key */
+    HKEY groups_root; /* group enumeration */
+    DWORD group_idx;
+    BOOL groups; /* enumerates the cache groups */
 } find_handle;
 
 /* List of all containers available */
@@ -3530,30 +3535,160 @@ BOOL WINAPI FindNextUrlCacheContainerW( HANDLE handle, void *info, DWORD *size )
 
 static BOOL urlcache_find_next_entry(HANDLE, LPINTERNET_CACHE_ENTRY_INFOA, LPDWORD, BOOL);
 
+/* Cache groups are kept per user under HKCU\Software\Wine\WinInet\CacheGroups\<id>:
+ * values Flags, Type, Quota, Storage (4 DWORDs), GroupName; the subkey Members has one
+ * value per member URL.  Entries are matched by URL, so a group can span containers. */
+#define CACHEGROUP_FLAG_NONPURGEABLE    0x1
+#define CACHEGROUP_FLAG_FLUSHURL_ONDELETE 0x2
+#define CACHEGROUP_FLAG_GIDONLY         0x4
+#define CACHEGROUP_ATTRIBUTE_GET_ALL    0xffffffff
+#define CACHEGROUP_ATTRIBUTE_BASIC      0x1
+#define CACHEGROUP_ATTRIBUTE_FLAG       0x2
+#define CACHEGROUP_ATTRIBUTE_TYPE       0x4
+#define CACHEGROUP_ATTRIBUTE_QUOTA      0x8
+#define CACHEGROUP_ATTRIBUTE_GROUPNAME  0x10
+#define CACHEGROUP_ATTRIBUTE_STORAGE    0x20
+#define CACHEGROUP_SEARCH_ALL           0x0
+#define CACHEGROUP_SEARCH_BYURL         0x1
+#define INTERNET_CACHE_GROUP_ADD        0
+#define INTERNET_CACHE_GROUP_REMOVE     1
+
+static const WCHAR groups_root_name[] = L"Software\\Wine\\WinInet\\CacheGroups";
+
+static void group_id_name(GROUPID id, WCHAR *buf)
+{
+    static const WCHAR hex[] = L"0123456789abcdef";
+    int i;
+    for (i = 0; i < 16; i++) buf[i] = hex[(id >> (60 - i * 4)) & 0xf];
+    buf[16] = 0;
+}
+
+static BOOL group_id_parse(const WCHAR *name, GROUPID *id)
+{
+    ULONGLONG v = 0;
+    int i;
+    if (wcslen(name) != 16) return FALSE;
+    for (i = 0; i < 16; i++)
+    {
+        WCHAR c = name[i];
+        v <<= 4;
+        if (c >= '0' && c <= '9') v |= c - '0';
+        else if (c >= 'a' && c <= 'f') v |= c - 'a' + 10;
+        else return FALSE;
+    }
+    *id = v;
+    return TRUE;
+}
+
+static HKEY group_open(GROUPID id, REGSAM access)
+{
+    WCHAR path[ARRAY_SIZE(groups_root_name) + 18];
+    HKEY key;
+
+    if (id <= 0) return NULL;
+    wcscpy(path, groups_root_name);
+    wcscat(path, L"\\");
+    group_id_name(id, path + wcslen(path));
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, path, 0, access, &key)) return NULL;
+    return key;
+}
+
+static WCHAR *group_member_name(const char *url)
+{
+    int len = MultiByteToWideChar(CP_ACP, 0, url, -1, NULL, 0);
+    WCHAR *ret = malloc(len * sizeof(WCHAR));
+    if (ret) MultiByteToWideChar(CP_ACP, 0, url, -1, ret, len);
+    return ret;
+}
+
+static BOOL group_has_member(HKEY members, const char *url)
+{
+    WCHAR *name;
+    BOOL ret;
+
+    if (!members) return FALSE;
+    if (!(name = group_member_name(url))) return FALSE;
+    ret = !RegQueryValueExW(members, name, NULL, NULL, NULL, NULL);
+    free(name);
+    return ret;
+}
+
+static HANDLE group_mutex(void)
+{
+    HANDLE m = CreateMutexW(NULL, FALSE, L"Local\\WininetCacheGroups");
+    if (m) WaitForSingleObject(m, INFINITE);
+    return m;
+}
+
+static void group_unlock(HANDLE m)
+{
+    if (m) { ReleaseMutex(m); CloseHandle(m); }
+}
+
+/* does any group other than skip hold url */
+static BOOL url_in_other_group(const WCHAR *url, GROUPID skip)
+{
+    HKEY root;
+    WCHAR name[32];
+    DWORD i, len;
+    BOOL ret = FALSE;
+
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, groups_root_name, 0, KEY_READ, &root)) return FALSE;
+    for (i = 0; !ret; i++)
+    {
+        GROUPID id;
+        HKEY gk, members;
+        len = ARRAY_SIZE(name);
+        if (RegEnumKeyExW(root, i, name, &len, NULL, NULL, NULL, NULL)) break;
+        if (!group_id_parse(name, &id) || id == skip) continue;
+        if (!(gk = group_open(id, KEY_READ))) continue;
+        if (!RegOpenKeyExW(gk, L"Members", 0, KEY_READ, &members))
+        {
+            ret = !RegQueryValueExW(members, url, NULL, NULL, NULL, NULL);
+            RegCloseKey(members);
+        }
+        RegCloseKey(gk);
+    }
+    RegCloseKey(root);
+    return ret;
+}
+
