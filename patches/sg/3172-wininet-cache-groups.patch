+static DWORD group_get_dword(HKEY key, const WCHAR *name)
+{
+    DWORD v = 0, size = sizeof(v);
+    if (RegQueryValueExW(key, name, NULL, NULL, (BYTE *)&v, &size)) v = 0;
+    return v;
+}
+
+static DWORD group_disk_usage(HKEY gk)
+{
+    HKEY members;
+    ULONGLONG total = 0;
+    DWORD i;
+
+    if (RegOpenKeyExW(gk, L"Members", 0, KEY_READ, &members)) return 0;
+    for (i = 0; ; i++)
+    {
+        WCHAR url[INTERNET_MAX_URL_LENGTH + 1];
+        DWORD len = ARRAY_SIZE(url), size = 0;
+        INTERNET_CACHE_ENTRY_INFOW *info;
+        if (RegEnumValueW(members, i, url, &len, NULL, NULL, NULL, NULL)) break;
+        GetUrlCacheEntryInfoW(url, NULL, &size);
+        if (!size || !(info = malloc(size))) continue;
+        if (GetUrlCacheEntryInfoW(url, info, &size)) total += info->dwSizeLow;
+        free(info);
+    }
+    RegCloseKey(members);
+    return (DWORD)((total + 1023) / 1024);
+}
+
+static BOOL group_get_attribute(GROUPID gid, DWORD flags, DWORD attrs, INTERNET_CACHE_GROUP_INFOW *info,
+                                DWORD *size, void *reserved)
+{
+    HKEY gk;
+    DWORD len;
+
+    if (flags || reserved || !size)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(gk = group_open(gid, KEY_READ)))
+    {
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return FALSE;
+    }
+    if (!info || *size < sizeof(*info))
+    {
+        RegCloseKey(gk);
+        *size = sizeof(*info);
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+    memset(info, 0, sizeof(*info));
+    info->dwGroupSize = sizeof(*info);
+    if (attrs & (CACHEGROUP_ATTRIBUTE_BASIC | CACHEGROUP_ATTRIBUTE_FLAG))
+        info->dwGroupFlags = group_get_dword(gk, L"Flags");
+    if (attrs & (CACHEGROUP_ATTRIBUTE_BASIC | CACHEGROUP_ATTRIBUTE_TYPE))
+        info->dwGroupType = group_get_dword(gk, L"Type");
+    if (attrs & (CACHEGROUP_ATTRIBUTE_BASIC | CACHEGROUP_ATTRIBUTE_QUOTA))
+        info->dwDiskQuota = group_get_dword(gk, L"Quota");
+    if (attrs & CACHEGROUP_ATTRIBUTE_STORAGE)
+    {
+        len = sizeof(info->dwOwnerStorage);
+        RegQueryValueExW(gk, L"Storage", NULL, NULL, (BYTE *)info->dwOwnerStorage, &len);
+    }
+    if (attrs & CACHEGROUP_ATTRIBUTE_GROUPNAME)
+    {
+        len = sizeof(info->szGroupName) - sizeof(WCHAR);
+        if (RegQueryValueExW(gk, L"GroupName", NULL, NULL, (BYTE *)info->szGroupName, &len))
+            info->szGroupName[0] = 0;
+    }
+    if (attrs == CACHEGROUP_ATTRIBUTE_GET_ALL)
+        info->dwDiskUsage = group_disk_usage(gk);
+    RegCloseKey(gk);
+    *size = sizeof(*info);
+    return TRUE;
+}
