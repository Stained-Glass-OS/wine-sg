-    /* TODO - Update username/password if required. */
+    /* Stained Glass OS: the user and password go to the data source as its
+     * DBPROP_AUTH_USERID and DBPROP_AUTH_PASSWORD */
     if ((userid && *userid) || (password && *password))
-        FIXME("Username/password parameters currently not supported\n");
