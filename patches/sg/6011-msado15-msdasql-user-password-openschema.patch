+/* Stained Glass OS: the OLE DB schema rowset of an ADO schema */
+static const GUID *schema_guid( SchemaEnum schema )
+{
+    switch (schema)
+    {
+    case adSchemaCatalogs:      return &DBSCHEMA_CATALOGS;
+    case adSchemaColumns:       return &DBSCHEMA_COLUMNS;
+    case adSchemaIndexes:       return &DBSCHEMA_INDEXES;
+    case adSchemaProcedures:    return &DBSCHEMA_PROCEDURES;
+    case adSchemaSchemata:      return &DBSCHEMA_SCHEMATA;
+    case adSchemaTables:        return &DBSCHEMA_TABLES;
+    case adSchemaProviderTypes: return &DBSCHEMA_PROVIDER_TYPES;
+    case adSchemaViews:         return &DBSCHEMA_VIEWS;
+    case adSchemaForeignKeys:   return &DBSCHEMA_FOREIGN_KEYS;
+    case adSchemaPrimaryKeys:   return &DBSCHEMA_PRIMARY_KEYS;
+    default:                    return NULL;
+    }
+}
