+/* a rowset over a statement's results (Execute) or over an ODBC catalog call (schema) */
+static HRESULT create_stmt_rowset( IUnknown *caller, SQLHSTMT hstmt, const struct schema_desc *schema,
+                                   REFIID riid, IUnknown **out )
+{
+    struct msdasql_rowset *msrowset;
+    HRESULT hr;
+
+    msrowset = calloc(1, sizeof(*msrowset));
+    if (!msrowset)
+        return E_OUTOFMEMORY;
+
+    msrowset->IRowset_iface.lpVtbl = &msdasql_rowset_vtbl;
+    msrowset->IRowsetInfo_iface.lpVtbl = &rowset_info_vtbl;
+    msrowset->IColumnsInfo_iface.lpVtbl = &rowset_columninfo_vtbll;
+    msrowset->IAccessor_iface.lpVtbl = &accessor_vtbl;
+    msrowset->IColumnsRowset_iface.lpVtbl = &columnrs_rs_vtbl;
+    msrowset->refs = 1;
+    msrowset->caller = caller;
+    IUnknown_AddRef(caller);
+    msrowset->hstmt = hstmt;
+    msrowset->schema = schema;
+
+    {
+        SQLSMALLINT cols = 0, c;
+
+        SQLNumResultCols(hstmt, &cols);
+        if (cols < 0) cols = 0;
+        if (schema) cols = schema->ncols;
+        rt_init(&msrowset->table, cols);
+        msrowset->sqltypes = calloc(cols ? cols : 1, sizeof(*msrowset->sqltypes));
+        msrowset->unsigned_cols = calloc(cols ? cols : 1, sizeof(*msrowset->unsigned_cols));
+        if (!msrowset->sqltypes || !msrowset->unsigned_cols)
+        {
+            rt_free(&msrowset->table);
+            free(msrowset->sqltypes);
+            free(msrowset->unsigned_cols);
+            IUnknown_Release(caller);
+            free(msrowset);
+            return E_OUTOFMEMORY;
+        }
+        for (c = 0; !schema && c < cols; c++)
+        {
+            SQLWCHAR name[128];
+            SQLSMALLINT namelen, type, digits, nullable;
+            SQLULEN colsize;
+            SQLLEN uns = 0;
+
+            if (SQL_SUCCEEDED(SQLDescribeColW(hstmt, c + 1, name, ARRAY_SIZE(name), &namelen, &type,
+                                              &colsize, &digits, &nullable)))
+                msrowset->sqltypes[c] = type;
+            if (SQL_SUCCEEDED(SQLColAttributesW(hstmt, c + 1, SQL_DESC_UNSIGNED, NULL, 0, NULL, &uns)))
+                msrowset->unsigned_cols[c] = uns != SQL_FALSE;
+        }
+    }
+
+    hr = IRowset_QueryInterface(&msrowset->IRowset_iface, riid, (void**)out);
+    IRowset_Release(&msrowset->IRowset_iface);
+    return hr;
+}
