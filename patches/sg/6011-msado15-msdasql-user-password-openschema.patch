 static HRESULT WINAPI connection_OpenSchema( _Connection *iface, SchemaEnum schema, VARIANT restrictions,
                                              VARIANT schema_id, _Recordset **record_set )
 {
-    FIXME( "%p, %d, %s, %s, %p\n", iface, schema, debugstr_variant(&restrictions),
+    struct connection *connection = impl_from_Connection( iface );
+    VARIANT *list = NULL, *values = NULL;
+    IDBSchemaRowset *schemas;
+    _Recordset *recordset;
+    IUnknown *rowset = NULL;
+    const GUID *guid;
+    GUID provider_guid;
+    LONG lbound, ubound, i;
+    ULONG count = 0;
+    IDispatch *disp;
+    HRESULT hr;
+
+    TRACE( "%p, %d, %s, %s, %p\n", iface, schema, debugstr_variant(&restrictions),
            debugstr_variant(&schema_id), record_set );
-    return E_NOTIMPL;
+
+    if (!record_set) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    *record_set = NULL;
+    if (connection->state == adStateClosed) return MAKE_ADO_HRESULT( adErrObjectClosed );
+
+    if (schema == adSchemaProviderSpecific)
+    {
+        /* the provider's own schema, named by its GUID */
+        if (V_VT(&schema_id) != VT_BSTR || FAILED(CLSIDFromString( V_BSTR(&schema_id), &provider_guid )))
+            return MAKE_ADO_HRESULT( adErrInvalidArgument );
+        guid = &provider_guid;
+    }
+    else if (!(guid = schema_guid( schema ))) return MAKE_ADO_HRESULT( adErrFeatureNotAvailable );
+
+    /* the restrictions: an array of values (Empty for none) */
+    if (V_VT(&restrictions) == (VT_ARRAY | VT_VARIANT) && V_ARRAY(&restrictions))
+    {
+        if (FAILED(hr = SafeArrayGetLBound( V_ARRAY(&restrictions), 1, &lbound )) ||
+            FAILED(hr = SafeArrayGetUBound( V_ARRAY(&restrictions), 1, &ubound )))
+            return hr;
+        count = ubound >= lbound ? ubound - lbound + 1 : 0;
+        if (count && FAILED(hr = SafeArrayAccessData( V_ARRAY(&restrictions), (void **)&list ))) return hr;
+    }
+    else if (V_VT(&restrictions) != VT_EMPTY && V_VT(&restrictions) != VT_ERROR &&
+             V_VT(&restrictions) != VT_NULL)
+        return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    if (count && !(values = calloc( count, sizeof(*values) ))) hr = E_OUTOFMEMORY;
+    else hr = S_OK;
+    for (i = 0; SUCCEEDED(hr) && i < count; i++)
+    {
+        /* Missing (an omitted argument) means no restriction */
+        if (V_VT(&list[i]) == VT_ERROR) V_VT(&values[i]) = VT_EMPTY;
+        else hr = VariantCopy( &values[i], &list[i] );
+    }
+    if (list) SafeArrayUnaccessData( V_ARRAY(&restrictions) );
+
+    if (SUCCEEDED(hr))
+    {
+        if (FAILED(IUnknown_QueryInterface( connection->session, &IID_IDBSchemaRowset, (void **)&schemas )))
+            hr = MAKE_ADO_HRESULT( adErrFeatureNotAvailable );
+        else
+        {
+#ifdef SG_MUTANT_ADO_SCHEMA_NO_RESTRICTIONS
+            count = 0;
+#endif
+            hr = IDBSchemaRowset_GetRowset( schemas, NULL, guid, count, values, &IID_IRowset, 0, NULL, &rowset );
+            IDBSchemaRowset_Release( schemas );
+        }
+    }
+    for (i = 0; i < count; i++) VariantClear( &values[i] );
+    free( values );
+    if (FAILED(hr)) return hr;
+
+    if (FAILED(hr = Recordset_create( (void **)&recordset )))
+    {
+        IUnknown_Release( rowset );
+        return hr;
+    }
+    _Connection_QueryInterface( iface, &IID_IDispatch, (void **)&disp );
+    hr = Recordset_open_rowset( recordset, rowset, disp );
+    IDispatch_Release( disp );
+    IUnknown_Release( rowset );
+    if (FAILED(hr))
+    {
+        _Recordset_Release( recordset );
+        return hr;
+    }
+    *record_set = recordset;
+    return S_OK;
 }
 
