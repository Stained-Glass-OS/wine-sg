+static const WCHAR *restriction_str( ULONG count, const VARIANT *restrictions, ULONG i, SQLSMALLINT *len )
+{
+    *len = 0;
+    if (i >= count || V_VT(&restrictions[i]) != VT_BSTR || !V_BSTR(&restrictions[i])) return NULL;
+    *len = SysStringLen( V_BSTR(&restrictions[i]) );
+    return V_BSTR(&restrictions[i]);
+}
