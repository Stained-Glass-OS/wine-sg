+/* Stained Glass OS: a read-only recordset over a rowset a provider gave
+ * (Connection.OpenSchema): its fields, then all its rows */
+HRESULT Recordset_open_rowset( _Recordset *iface, IUnknown *rowset, IDispatch *connection )
+{
+    struct recordset *recordset = impl_from_Recordset( iface );
+    DBBYTEOFFSET datasize;
+    DBBINDING *bindings;
+    HRESULT hr;
+
+    if (FAILED(hr = fields_create( recordset, &recordset->fields ))) return hr;
+    if (FAILED(hr = create_bindings( rowset, recordset, &bindings, &datasize ))) return hr;
+    recordset->count = 0;
+    hr = load_all_recordset_data( recordset, rowset, bindings, datasize );
+    CoTaskMemFree( bindings );
+    if (FAILED(hr)) return hr;
+    recordset->index = recordset->count ? 0 : -1;
+    ADORecordsetConstruction_put_Rowset( &recordset->ADORecordsetConstruction_iface, rowset );
+    recordset->cursor_type = adOpenStatic;
+    recordset->lock_type = adLockReadOnly;
+    if (connection)
+    {
+        VariantClear( &recordset->active_connection );
+        V_VT(&recordset->active_connection) = VT_DISPATCH;
+        V_DISPATCH(&recordset->active_connection) = connection;
+        IDispatch_AddRef( connection );
+    }
+    recordset->state = adStateOpen;
+    return S_OK;
+}
