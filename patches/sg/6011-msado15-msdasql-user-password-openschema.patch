+static HRESULT schema_fetch_row( void *ctx, struct cell *cells, DBORDINAL ncols )
+{
+    struct msdasql_rowset *rowset = ctx;
+    const struct schema_desc *desc = rowset->schema;
+    SQLSMALLINT data_type = 0;
+    SQLRETURN ret;
+    DBORDINAL i;
+
+    ret = SQLFetch( rowset->hstmt );
+    if (ret == SQL_NO_DATA) return DB_S_ENDOFROWSET;
+    if (!SQL_SUCCEEDED(ret))
+    {
+        dump_sql_diag_records( SQL_HANDLE_STMT, rowset->hstmt );
+        return E_FAIL;
+    }
+    /* the ODBC data type, which some columns depend on */
+    if (desc == &schemas[1])
+    {
+        SQLLEN ind;
+        if (!SQL_SUCCEEDED(SQLGetData( rowset->hstmt, 5, SQL_C_SSHORT, &data_type, 0, &ind )) || ind == SQL_NULL_DATA)
+            data_type = 0;
+    }
+
+    for (i = 0; i < ncols && i < desc->ncols; i++)
+    {
+        const struct schema_col *col = &desc->cols[i];
+        SQLLEN ind = SQL_NULL_DATA;
+        SQLINTEGER value = 0;
+        BYTE *buf = NULL;
+
+        cells[i].status = DBSTATUS_S_ISNULL;
+        cells[i].type = col->type;
+        cells[i].data = NULL;
+        cells[i].len = 0;
+        if (!col->odbc || col->conv == SC_NULL) continue;
+        if ((col->conv == SC_IF_CHAR && !is_char_sqltype( data_type )) ||
+            (col->conv == SC_IF_NUMERIC && !is_numeric_sqltype( data_type )))
+            continue;
+
+        if (col->type == DBTYPE_WSTR)
+        {
+            WCHAR text[1024];
+            if (!SQL_SUCCEEDED(SQLGetData( rowset->hstmt, col->odbc, SQL_C_WCHAR, text, sizeof(text), &ind )) ||
+                ind == SQL_NULL_DATA)
+                continue;
+            if (ind == SQL_NO_TOTAL || ind > (SQLLEN)sizeof(text) - (SQLLEN)sizeof(WCHAR))
+                ind = sizeof(text) - sizeof(WCHAR);
+            if (!(buf = calloc( 1, ind + sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+            memcpy( buf, text, ind );
+            cells[i].len = ind;
+        }
+        else
+        {
+            if (col->conv == SC_HAS_VALUE)
+            {
+                WCHAR text[2];
+                SQLRETURN r = SQLGetData( rowset->hstmt, col->odbc, SQL_C_WCHAR, text, sizeof(text), &ind );
+                value = SQL_SUCCEEDED(r) && ind != SQL_NULL_DATA;
+                ind = 0;
+            }
+            else if (!SQL_SUCCEEDED(SQLGetData( rowset->hstmt, col->odbc, SQL_C_SLONG, &value, 0, &ind )) ||
+                     ind == SQL_NULL_DATA)
+                continue;
+            if (col->conv == SC_NULLABLE_BOOL) value = value != SQL_NO_NULLS;
+            if (col->conv == SC_SQLTYPE_TO_DBTYPE) value = sqltype_to_bindtype( value, TRUE );
+            if (!(buf = calloc( 1, 8 ))) return E_OUTOFMEMORY;
+            switch (col->type)
+            {
+            case DBTYPE_BOOL: *(VARIANT_BOOL *)buf = value ? VARIANT_TRUE : VARIANT_FALSE; cells[i].len = 2; break;
+            case DBTYPE_I2:   *(SHORT *)buf = value; cells[i].len = 2; break;
+            case DBTYPE_UI2:  *(USHORT *)buf = value; cells[i].len = 2; break;
+            default:          *(ULONG *)buf = value; cells[i].len = 4; break;
+            }
+        }
+        cells[i].data = buf;
+        cells[i].status = DBSTATUS_S_OK;
+    }
+    return S_OK;
+}
+
+static HRESULT schema_column_info( const struct schema_desc *desc, DBORDINAL *columns, DBCOLUMNINFO **colinfo,
+                                   OLECHAR **strings )
+{
+    DBCOLUMNINFO *info;
+    OLECHAR *ptr;
+    size_t size = 0;
+    DBORDINAL i;
+
+    for (i = 0; i < desc->ncols; i++) size += wcslen( desc->cols[i].name ) + 1;
+    if (!(info = CoTaskMemAlloc( desc->ncols * sizeof(*info) ))) return E_OUTOFMEMORY;
+    if (!(ptr = *strings = CoTaskMemAlloc( size * sizeof(WCHAR) )))
+    {
+        CoTaskMemFree( info );
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < desc->ncols; i++)
+    {
+        memset( &info[i], 0, sizeof(info[i]) );
+        wcscpy( ptr, desc->cols[i].name );
+        info[i].pwszName = ptr;
+        info[i].iOrdinal = i + 1;
+        info[i].dwFlags = DBCOLUMNFLAGS_ISNULLABLE | DBCOLUMNFLAGS_MAYBENULL;
+        info[i].wType = desc->cols[i].type;
+        switch (desc->cols[i].type)
+        {
+        case DBTYPE_WSTR: info[i].ulColumnSize = 128; break;
+        case DBTYPE_GUID: info[i].ulColumnSize = sizeof(GUID); break;
+        case DBTYPE_DATE: info[i].ulColumnSize = sizeof(DATE); break;
+        case DBTYPE_BOOL: case DBTYPE_I2: case DBTYPE_UI2: info[i].ulColumnSize = 2; break;
+        default: info[i].ulColumnSize = 4; break;
+        }
+        info[i].bPrecision = ~0;
+        info[i].bScale = ~0;
+        info[i].columnid.eKind = DBKIND_NAME;
+        info[i].columnid.uName.pwszName = ptr;
+        ptr += wcslen( ptr ) + 1;
+    }
+    *columns = desc->ncols;
+    *colinfo = info;
+    return S_OK;
+}
