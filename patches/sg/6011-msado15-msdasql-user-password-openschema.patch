+static BOOL is_char_sqltype( SQLSMALLINT type )
+{
+    return type == SQL_CHAR || type == SQL_VARCHAR || type == SQL_LONGVARCHAR || type == SQL_WCHAR ||
+           type == SQL_WVARCHAR || type == SQL_WLONGVARCHAR || type == SQL_BINARY || type == SQL_VARBINARY ||
+           type == SQL_LONGVARBINARY;
+}
+
+static BOOL is_numeric_sqltype( SQLSMALLINT type )
+{
+    return type == SQL_NUMERIC || type == SQL_DECIMAL || type == SQL_INTEGER || type == SQL_SMALLINT ||
+           type == SQL_FLOAT || type == SQL_REAL || type == SQL_DOUBLE || type == SQL_TINYINT || type == SQL_BIGINT;
+}
