+static HRESULT WINAPI schemarowset_GetRowset( IDBSchemaRowset *iface, IUnknown *outer, REFGUID guid,
+        ULONG count, const VARIANT restrictions[], REFIID riid, ULONG set_count, DBPROPSET sets[], IUnknown **rowset )
+{
+    struct msdasql_session *session = impl_from_IDBSchemaRowset( iface );
+    const struct schema_desc *desc = NULL;
+    const WCHAR *r[4];
+    SQLSMALLINT len[4];
+    SQLHSTMT hstmt;
+    SQLRETURN ret;
+    HRESULT hr;
+    ULONG i;
+
+    TRACE( "%p, %p, %s, %lu, %p, %s, %lu, %p, %p\n", session, outer, debugstr_guid(guid), count, restrictions,
+           debugstr_guid(riid), set_count, sets, rowset );
+
+    if (!rowset) return E_INVALIDARG;
+    *rowset = NULL;
+    if (count && !restrictions) return E_INVALIDARG;
+    if (outer) return DB_E_NOAGGREGATION;
+    for (i = 0; i < ARRAY_SIZE(schemas); i++)
+        if (IsEqualGUID( guid, schemas[i].guid )) desc = &schemas[i];
+    if (!desc) return E_INVALIDARG;
+    for (i = 0; i < count; i++)
+        if (V_VT(&restrictions[i]) != VT_EMPTY && !(desc->restrictions & (1 << i)))
+            return DB_E_NOTSUPPORTED;
+    for (i = 0; i < 4; i++) r[i] = restriction_str( count, restrictions, i, &len[i] );
+
+    if (!SQL_SUCCEEDED(SQLAllocHandle( SQL_HANDLE_STMT, session->hdbc, &hstmt ))) return E_FAIL;
+    if (desc == &schemas[0])
+        ret = SQLTablesW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2], len[2],
+                          (SQLWCHAR *)r[3], len[3] );
+    else if (desc == &schemas[1])
+        ret = SQLColumnsW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2], len[2],
+                           (SQLWCHAR *)r[3], len[3] );
+    else if (desc == &schemas[2])
+        ret = SQLProceduresW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2], len[2] );
+    else
+        ret = SQLPrimaryKeysW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2], len[2] );
+    if (!SQL_SUCCEEDED(ret))
+    {
+        dump_sql_diag_records( SQL_HANDLE_STMT, hstmt );
+        SQLFreeHandle( SQL_HANDLE_STMT, hstmt );
+        return E_FAIL;
+    }
+    if (FAILED(hr = create_stmt_rowset( (IUnknown *)&session->session_iface, hstmt, desc, riid, rowset )))
+        SQLFreeHandle( SQL_HANDLE_STMT, hstmt );
+    return hr;
+}
+
+static HRESULT WINAPI schemarowset_GetSchemas( IDBSchemaRowset *iface, ULONG *count, GUID **guids, ULONG **support )
+{
+    struct msdasql_session *session = impl_from_IDBSchemaRowset( iface );
+    ULONG i;
+
+    TRACE( "%p, %p, %p, %p\n", session, count, guids, support );
+
+    if (!count || !guids || !support) return E_INVALIDARG;
+    *guids = CoTaskMemAlloc( ARRAY_SIZE(schemas) * sizeof(GUID) );
+    *support = CoTaskMemAlloc( ARRAY_SIZE(schemas) * sizeof(ULONG) );
+    if (!*guids || !*support)
+    {
+        CoTaskMemFree( *guids );
+        CoTaskMemFree( *support );
+        *guids = NULL;
+        *support = NULL;
+        *count = 0;
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < ARRAY_SIZE(schemas); i++)
+    {
+        (*guids)[i] = *schemas[i].guid;
+        (*support)[i] = schemas[i].restrictions;
+    }
+    *count = ARRAY_SIZE(schemas);
+    return S_OK;
+}
