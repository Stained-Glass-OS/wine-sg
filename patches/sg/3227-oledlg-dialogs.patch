+WCHAR *oleui_strdupAtoW(const char *str)
+{
+    DWORD len;
+    WCHAR *ret;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar(CP_ACP, 0, str, -1, NULL, 0);
+    if (!(ret = malloc(len * sizeof(WCHAR)))) return NULL;
+    MultiByteToWideChar(CP_ACP, 0, str, -1, ret, len);
+    return ret;
+}
+
+char *oleui_strdupWtoA(const WCHAR *str)
+{
+    DWORD len;
+    char *ret;
+
+    if (!str) return NULL;
+    len = WideCharToMultiByte(CP_ACP, 0, str, -1, NULL, 0, NULL, NULL);
+    if (!(ret = malloc(len))) return NULL;
+    WideCharToMultiByte(CP_ACP, 0, str, -1, ret, len, NULL, NULL);
+    return ret;
+}
+
+WCHAR *oleui_cotaskdup(const WCHAR *str)
+{
+    WCHAR *ret;
+    SIZE_T size;
+
+    if (!str) return NULL;
+    size = (lstrlenW(str) + 1) * sizeof(WCHAR);
+    if ((ret = CoTaskMemAlloc(size))) memcpy(ret, str, size);
+    return ret;
+}
+
+/* the checks every dialog function starts with; the error codes are the
+ * "standard field validation errors" of the documentation */
+UINT oleui_validate(const void *s, DWORD size)
+{
+    const struct oleui_common *c = s;
+
+    if (!s) return OLEUI_ERR_STRUCTURENULL;
+    if (IsBadWritePtr((void *)s, size)) return OLEUI_ERR_STRUCTUREINVALID;
+#ifndef SG_MUTANT_OLEDLG_CBSTRUCT
+    if (c->cbStruct != size) return OLEUI_ERR_CBSTRUCTINCORRECT;
+#endif
+    if (c->hWndOwner && !IsWindow(c->hWndOwner)) return OLEUI_ERR_HWNDOWNERINVALID;
+    if (c->lpszCaption && IsBadReadPtr(c->lpszCaption, sizeof(WCHAR))) return OLEUI_ERR_LPSZCAPTIONINVALID;
+    if (c->lpfnHook && IsBadCodePtr((FARPROC)c->lpfnHook)) return OLEUI_ERR_LPFNHOOKINVALID;
+    if (c->lpszTemplate && !IS_INTRESOURCE(c->lpszTemplate) && IsBadReadPtr(c->lpszTemplate, sizeof(WCHAR)))
+        return OLEUI_ERR_LPSZTEMPLATEINVALID;
+    if (c->lpszTemplate && c->hInstance && IsBadReadPtr(c->hInstance, sizeof(WORD)))
+        return OLEUI_ERR_HINSTANCEINVALID;
+    return 0;
+}
+
+static INT_PTR CALLBACK oleui_dlgproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct oleui_dlg *dlg;
+    INT_PTR ret;
+
+    if (msg == WM_INITDIALOG)
+    {
+        dlg = (struct oleui_dlg *)lp;
+        SetWindowLongPtrW(hwnd, DWLP_USER, (LONG_PTR)dlg);
+        if (dlg->common->lpszCaption) SetWindowTextW(hwnd, dlg->common->lpszCaption);
+        ret = dlg->proc(hwnd, msg, wp, lp, dlg);
+        /* the hook function sees the dialog after the library has set it up */
+#ifndef SG_MUTANT_OLEDLG_HOOKINIT
+        if (dlg->common->lpfnHook) dlg->common->lpfnHook(hwnd, msg, wp, (LPARAM)dlg->app_struct);
+#endif
+        return ret;
+    }
+
+    dlg = (struct oleui_dlg *)GetWindowLongPtrW(hwnd, DWLP_USER);
+    if (!dlg) return FALSE;
+
+    if (dlg->common->lpfnHook && (ret = dlg->common->lpfnHook(hwnd, msg, wp, lp)))
+        return ret;
+
+    if (msg == oleui_msg_enddialog)
+    {
+        EndDialog(hwnd, wp);
+        return TRUE;
+    }
+    if (msg == WM_COMMAND && LOWORD(wp) == IDC_OLEUIHELP && HIWORD(wp) == BN_CLICKED)
+    {
+        HWND owner = dlg->common->hWndOwner;
+        if (!owner) owner = GetWindow(hwnd, GW_OWNER);
+        if (owner) SendMessageW(owner, oleui_msg_help, (WPARAM)hwnd, MAKELPARAM(dlg->help_id, 0));
+        return TRUE;
+    }
+    return dlg->proc(hwnd, msg, wp, lp, dlg);
+}
+
+UINT oleui_run_dialog(struct oleui_dlg *dlg, UINT default_id)
+{
+    const struct oleui_common *c = dlg->common;
+    HINSTANCE inst = OLEDLG_hInstance;
+    const DLGTEMPLATE *tmpl;
+    HRSRC rsrc = NULL;
+    HGLOBAL res;
+    INT_PTR ret;
+
+    dlg->help_id = default_id;
+    if (c->hResource)
+    {
+        inst = c->hInstance;
+        rsrc = c->hResource;
+    }
+    else if (c->lpszTemplate)
+    {
+        inst = c->hInstance;
+        if (!(rsrc = FindResourceW(inst, c->lpszTemplate, (LPCWSTR)RT_DIALOG)))
+            return OLEUI_ERR_FINDTEMPLATEFAILURE;
+        dlg->help_id = IS_INTRESOURCE(c->lpszTemplate) ? LOWORD((ULONG_PTR)c->lpszTemplate) : 0;
+    }
+    else if (!(rsrc = FindResourceW(OLEDLG_hInstance, MAKEINTRESOURCEW(default_id), (LPCWSTR)RT_DIALOG)))
+        return OLEUI_ERR_FINDTEMPLATEFAILURE;
+
+    if (!(res = LoadResource(inst, rsrc)) || !(tmpl = LockResource(res)))
+        return OLEUI_ERR_LOADTEMPLATEFAILURE;
+
+    ret = DialogBoxIndirectParamW(OLEDLG_hInstance, tmpl, c->hWndOwner, oleui_dlgproc, (LPARAM)dlg);
+    if (ret == -1) return OLEUI_ERR_DIALOGFAILURE;
+    return (UINT)ret;
+}
+
+/***********************************************************************
+ *  The icon box control: shows the picture of an icon metafile
+ */
+static LRESULT CALLBACK iconbox_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg)
+    {
+    case IBXM_IMAGESET:
+        SetWindowLongPtrW(hwnd, 0, (LONG_PTR)wp);
+        InvalidateRect(hwnd, NULL, TRUE);
+        return 0;
+    case IBXM_IMAGEGET:
+        return GetWindowLongPtrW(hwnd, 0);
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+    {
+        HGLOBAL hmeta = (HGLOBAL)GetWindowLongPtrW(hwnd, 0);
+        PAINTSTRUCT ps;
+        RECT rc;
+        HDC hdc = BeginPaint(hwnd, &ps);
+
+        GetClientRect(hwnd, &rc);
+        FillRect(hdc, &rc, GetSysColorBrush(COLOR_BTNFACE));
+        if (hmeta)
+        {
+            METAFILEPICT *mfp = GlobalLock(hmeta);
+            if (mfp && mfp->hMF)
+            {
+                int w = MulDiv(mfp->xExt, GetDeviceCaps(hdc, LOGPIXELSX), 2540);
+                int h = MulDiv(mfp->yExt, GetDeviceCaps(hdc, LOGPIXELSY), 2540);
+                int cw = rc.right - rc.left, ch = rc.bottom - rc.top;
+                int x, y, saved;
+
+                if (w <= 0) w = 1;
+                if (h <= 0) h = 1;
+                if (w > cw) { h = MulDiv(h, cw, w); w = cw; }
+                if (h > ch) { w = MulDiv(w, ch, h); h = ch; }
+                x = (cw - w) / 2;
+                y = (ch - h) / 2;
+                saved = SaveDC(hdc);
+                SetBkMode(hdc, TRANSPARENT);
+                SetMapMode(hdc, MM_ANISOTROPIC);
+                SetViewportOrgEx(hdc, x, y, NULL);
+                SetViewportExtEx(hdc, w, h, NULL);
+                PlayMetaFile(hdc, mfp->hMF);
+                RestoreDC(hdc, saved);
+            }
+            if (mfp) GlobalUnlock(hmeta);
+        }
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+void oleui_register_classes(void)
+{
+    WNDCLASSW wc = {0};
+
+    wc.style = CS_GLOBALCLASS;
+    wc.lpfnWndProc = iconbox_proc;
+    wc.cbWndExtra = sizeof(LONG_PTR);
+    wc.hInstance = OLEDLG_hInstance;
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW);
+    wc.lpszClassName = iconbox_class;
+    RegisterClassW(&wc);
+}
+
+/***********************************************************************
+ *  Registry helpers
+ */
+static BOOL class_key(const CLSID *clsid, const WCHAR *sub, HKEY *key)
+{
+    WCHAR path[200];
+    int len;
+
+    lstrcpyW(path, L"CLSID\\");
+    StringFromGUID2(clsid, path + 6, 40);
+    len = lstrlenW(path);
+    if (sub)
+    {
+        path[len++] = '\\';
+        lstrcpyW(path + len, sub);
+    }
+    return !RegOpenKeyExW(HKEY_CLASSES_ROOT, path, 0, KEY_READ, key);
+}
+
+BOOL oleui_class_user_type(const CLSID *clsid, BOOL short_name, WCHAR *buf, DWORD len)
+{
+    WCHAR *type = NULL;
+    BOOL ret = FALSE;
+
+    if (SUCCEEDED(OleRegGetUserType(clsid, short_name ? USERCLASSTYPE_SHORT : USERCLASSTYPE_FULL, &type)) && type)
+    {
+        lstrcpynW(buf, type, len);
+        ret = buf[0] != 0;
+    }
+    CoTaskMemFree(type);
+    return ret;
+}
+
+BOOL oleui_class_format(const CLSID *clsid, WCHAR *buf, DWORD len)
+{
+    HKEY key;
+    DWORD size = len * sizeof(WCHAR), type;
+    BOOL ret;
+
+    if (!class_key(clsid, L"DataFormats\\DefaultFile", &key)) return FALSE;
+    ret = !RegQueryValueExW(key, NULL, NULL, &type, (BYTE *)buf, &size) && type == REG_SZ && buf[0];
+    RegCloseKey(key);
+    return ret;
+}
+
+BOOL oleui_format_name(WORD format, WCHAR *buf, DWORD len)
+{
+    static const WCHAR *const std[] = { NULL, L"Text", L"Bitmap", L"MetaFilePict", L"SYLK", L"DIF", L"TIFF",
+                                        L"OEM Text", L"DIB", L"Palette", L"PenData", L"RIFF", L"Wave Audio",
+                                        L"Unicode Text", L"Enhanced MetaFile", L"HDROP", L"Locale" };
+
+    if (!format) return FALSE;
+    if (format < 0xc000)
+    {
+        if (format >= ARRAY_SIZE(std)) return FALSE;
+        lstrcpynW(buf, std[format], len);
+        return TRUE;
+    }
+    return GetClipboardFormatNameW(format, buf, len) > 0;
+}
+
+/* does the comma separated list in the registry value have FORMAT in it */
+static BOOL list_has_format(HKEY key, const WCHAR *format)
+{
+    WCHAR list[1024], *p, *end;
+    DWORD size = sizeof(list) - sizeof(WCHAR), type;
+    int flen = lstrlenW(format);
+
+    if (RegQueryValueExW(key, NULL, NULL, &type, (BYTE *)list, &size) || type != REG_SZ) return FALSE;
+    list[size / sizeof(WCHAR)] = 0;
+    for (p = list; *p;)
+    {
+        while (*p == ' ') p++;
+        end = wcschr(p, ',');
+        if (!end) end = p + lstrlenW(p);
+        {
+            WCHAR *e = end;
+            while (e > p && e[-1] == ' ') e--;
+            if (e - p == flen && !wcsnicmp(p, format, flen)) return TRUE;
+        }
+        p = *end ? end + 1 : end;
+    }
+    return FALSE;
+}
+
+/* does class DST list FORMAT among the formats it reads (or reads and writes) */
+BOOL oleui_class_converts(const CLSID *src, const WCHAR *format, BOOL readwrite, const CLSID *dst)
+{
+    HKEY key;
+    BOOL ret = FALSE;
+
+    if (src && IsEqualGUID(src, dst)) return FALSE;
+    if (!class_key(dst, readwrite ? L"Conversion\\ReadWritable\\Main" : L"Conversion\\Readable\\Main", &key))
+        return FALSE;
+    ret = list_has_format(key, format);
+    RegCloseKey(key);
+    return ret;
+}
+
+BOOL oleui_class_excluded(const CLSID *clsid, const CLSID *list, UINT count)
+{
+    UINT i;
+
+    if (!list) return FALSE;
+    for (i = 0; i < count; i++)
+        if (IsEqualGUID(clsid, &list[i])) return TRUE;
+    return FALSE;
+}
+
+/***********************************************************************
+ *           OleUICanConvertOrActivateAs (OLEDLG.2)
+ */
+BOOL WINAPI OleUICanConvertOrActivateAs(REFCLSID clsid, BOOL is_linked, WORD format)
+{
+    WCHAR fmt[128], name[64];
+    HKEY clsids;
+    DWORD i;
+    BOOL ret = FALSE;
+
+    TRACE("(%s, %d, %#x)\n", debugstr_guid(clsid), is_linked, format);
+
+    /* the original class's own default file format, else the clipboard format given */
+    if (!oleui_class_format(clsid, fmt, ARRAY_SIZE(fmt)) && !oleui_format_name(format, fmt, ARRAY_SIZE(fmt)))
+        return FALSE;
+
+    if (RegOpenKeyExW(HKEY_CLASSES_ROOT, L"CLSID", 0, KEY_READ, &clsids)) return FALSE;
+    for (i = 0; !ret && !RegEnumKeyW(clsids, i, name, ARRAY_SIZE(name)); i++)
+    {
+        CLSID other;
+
+        if (CLSIDFromString(name, &other) != S_OK) continue;
+        if (oleui_class_converts(clsid, fmt, FALSE, &other)) ret = TRUE;
+        /* a link cannot be activated as another class */
+#ifdef SG_MUTANT_OLEDLG_LINKACT
+        else if (oleui_class_converts(clsid, fmt, TRUE, &other)) ret = TRUE;
+#else
+        else if (!is_linked && oleui_class_converts(clsid, fmt, TRUE, &other)) ret = TRUE;
+#endif
+    }
+    RegCloseKey(clsids);
+    return ret;
+}
+
+/***********************************************************************
+ *  Icon metafiles: METAFILEPICT in a global block, as made by
+ *  OleMetafilePictFromIconAndLabel
+ */
+static void mf_text(const WORD *rec, DWORD words, WCHAR *label, DWORD len, BOOL exttext)
+{
+    const WORD *p = rec + 3;
+    WORD count;
+    const char *str;
+
+    if (exttext)
+    {
+        /* y, x, count, options, [clip rect], string */
+        if (words < 7) return;
+        count = p[2];
+        str = (const char *)(p + (p[3] & 6 ? 8 : 4));
+    }
+    else
+    {
+        count = p[0];
+        str = (const char *)(p + 1);
+    }
+    if ((const char *)str + count > (const char *)(rec + words)) return;
+    MultiByteToWideChar(CP_ACP, 0, str, count, label, len - 1);
+    label[min(count, len - 1)] = 0;
+}
+
+HICON oleui_metapict_icon(HGLOBAL hmeta, WCHAR *source, DWORD source_len, UINT *index, WCHAR *label, DWORD label_len)
+{
+    METAFILEPICT *mfp;
+    BYTE *bits;
+    UINT size, off;
+    char comments[4][MAX_PATH];
+    int ncomments = 0;
+    HICON icon = NULL;
+
+    if (source) source[0] = 0;
+    if (label) label[0] = 0;
+    if (index) *index = 0;
+    if (!hmeta || !(mfp = GlobalLock(hmeta))) return NULL;
+    size = mfp->hMF ? GetMetaFileBitsEx(mfp->hMF, 0, NULL) : 0;
+    if (size && (bits = malloc(size)))
+    {
+        if (GetMetaFileBitsEx(mfp->hMF, size, bits))
+        {
+            for (off = sizeof(METAHEADER); off + 6 <= size;)
+            {
+                const WORD *rec = (const WORD *)(bits + off);
+                DWORD words = *(const DWORD *)rec;
+
+                if (words < 3 || off + words * 2 > size) break;
+                if (rec[2] == META_ESCAPE && rec[3] == MFCOMMENT && ncomments < 4)
+                {
+                    WORD count = rec[4];
+                    if (count && count < MAX_PATH && (const BYTE *)rec + 10 + count <= bits + size)
+                    {
+                        memcpy(comments[ncomments], rec + 5, count);
+                        comments[ncomments][count - 1] = 0;
+                        ncomments++;
+                    }
+                }
+                else if (rec[2] == META_TEXTOUT && label && !label[0]) mf_text(rec, words, label, label_len, FALSE);
+                else if (rec[2] == META_EXTTEXTOUT && label && !label[0]) mf_text(rec, words, label, label_len, TRUE);
+                if (rec[2] == 0) break;
+                off += words * 2;
+            }
+        }
+        free(bits);
+    }
+    GlobalUnlock(hmeta);
+
+    /* "IconOnly", then the source file and the icon index */
+    if (ncomments >= 3 && source)
+    {
+        MultiByteToWideChar(CP_ACP, 0, comments[1], -1, source, source_len);
+        if (index) *index = strtoul(comments[2], NULL, 10);
+        if (source[0] && PrivateExtractIconsW(source, *index, GetSystemMetrics(SM_CXICON),
+                                              GetSystemMetrics(SM_CYICON), &icon, NULL, 1, 0) != 1)
+            icon = NULL;
+    }
+    return icon;
+}
+
+void oleui_metapict_free(HGLOBAL hmeta)
+{
+    METAFILEPICT *mfp;
+
+    if (!hmeta) return;
+    if ((mfp = GlobalLock(hmeta)))
+    {
+        if (mfp->hMF) DeleteMetaFile(mfp->hMF);
+        GlobalUnlock(hmeta);
+    }
+    GlobalFree(hmeta);
+}
+
+HGLOBAL oleui_metapict_copy(HGLOBAL hmeta)
+{
+    METAFILEPICT *src, *dst;
+    HGLOBAL ret;
+
+    if (!hmeta || !(src = GlobalLock(hmeta))) return NULL;
+    ret = GlobalAlloc(GMEM_MOVEABLE, sizeof(*src));
+    if (ret && (dst = GlobalLock(ret)))
+    {
+        *dst = *src;
+        dst->hMF = src->hMF ? CopyMetaFileW(src->hMF, NULL) : NULL;
+        GlobalUnlock(ret);
+    }
+    GlobalUnlock(hmeta);
+    return ret;
+}
