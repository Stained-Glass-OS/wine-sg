+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "ole2.h"
+#include "oledlg.h"
+#include "oledlg_private.h"
+#include "resource.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(oledlg);
+
+/***********************************************************************
+ *  Busy
+ */
+struct busy_state
+{
+    OLEUIBUSYW *busy;
+};
+
+struct find_window
+{
+    DWORD thread;
+    HWND found;
+};
+
+static BOOL CALLBACK find_task_window(HWND hwnd, LPARAM lp)
+{
+    struct find_window *fw = (struct find_window *)lp;
+
+    if (GetWindowThreadProcessId(hwnd, NULL) != fw->thread) return TRUE;
+    if (!IsWindowVisible(hwnd) || GetWindow(hwnd, GW_OWNER)) return TRUE;
+    fw->found = hwnd;
+    return FALSE;
+}
+
+/* bring the window of the blocking task forward */
+static BOOL switch_to_task(DWORD task)
+{
+    struct find_window fw = { task, NULL };
+
+    if (!task) return FALSE;
+    EnumWindows(find_task_window, (LPARAM)&fw);
+    if (!fw.found) return FALSE;
+    if (IsIconic(fw.found)) ShowWindow(fw.found, SW_RESTORE);
+    SetForegroundWindow(fw.found);
+    return TRUE;
+}
+
+static INT_PTR busy_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, struct oleui_dlg *dlg)
+{
+    struct busy_state *st = dlg->priv;
+    OLEUIBUSYW *busy = st->busy;
+
+    if (msg == oleui_msg_closebusy)
+    {
+#ifdef SG_MUTANT_OLEDLG_BZCLOSE
+        EndDialog(hwnd, OLEUI_CANCEL);
+#else
+        EndDialog(hwnd, OLEUI_BZ_CALLUNBLOCKED);
+#endif
+        return TRUE;
+    }
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        WCHAR text[300];
+        BOOL not_responding = busy->dwFlags & BZ_NOTRESPONDINGDIALOG;
+
+        if (!busy->lpszCaption)
+        {
+            LoadStringW(OLEDLG_hInstance, not_responding ? IDS_BZ_TITLE_NOTRESPONDING : IDS_BZ_TITLE, text, ARRAY_SIZE(text));
+            SetWindowTextW(hwnd, text);
+        }
+        LoadStringW(OLEDLG_hInstance, not_responding ? IDS_BZ_NOTRESPONDING : IDS_BZ_BUSY, text, ARRAY_SIZE(text));
+        SetDlgItemTextW(hwnd, IDC_BZ_MESSAGE1, text);
+        SendDlgItemMessageW(hwnd, IDC_BZ_ICON, STM_SETICON, (WPARAM)LoadIconW(NULL, (LPCWSTR)IDI_EXCLAMATION), 0);
+
+        /* the Cancel button is not there for a program that does not respond */
+        EnableWindow(GetDlgItem(hwnd, IDCANCEL), !(busy->dwFlags & BZ_DISABLECANCELBUTTON) && !not_responding);
+        EnableWindow(GetDlgItem(hwnd, IDC_BZ_SWITCHTO), !(busy->dwFlags & BZ_DISABLESWITCHTOBUTTON));
+#ifndef SG_MUTANT_OLEDLG_BZFLAGS
+        EnableWindow(GetDlgItem(hwnd, IDC_BZ_RETRY), !(busy->dwFlags & BZ_DISABLERETRYBUTTON));
+#endif
+        if (busy->lphWndDialog) *busy->lphWndDialog = hwnd;
+        return TRUE;
+    }
+
+    case WM_COMMAND:
+        switch (LOWORD(wp))
+        {
+        case IDC_BZ_SWITCHTO:
+            if (switch_to_task((DWORD_PTR)busy->hTask)) EndDialog(hwnd, OLEUI_BZ_RETRYSELECTED);
+            else EndDialog(hwnd, OLEUI_BZ_SWITCHTOSELECTED);
+            return TRUE;
+        case IDC_BZ_RETRY:
+#ifdef SG_MUTANT_OLEDLG_BZRETRY
+            EndDialog(hwnd, OLEUI_BZ_SWITCHTOSELECTED);
+#else
+            EndDialog(hwnd, OLEUI_BZ_RETRYSELECTED);
+#endif
+            return TRUE;
+        case IDCANCEL:
+            EndDialog(hwnd, OLEUI_CANCEL);
+            return TRUE;
+        }
+        break;
+
+    case WM_DESTROY:
+        if (busy->lphWndDialog) *busy->lphWndDialog = NULL;
+        break;
+    }
+    return FALSE;
+}
+
+static UINT run_busy(OLEUIBUSYW *busy, void *app)
+{
+    struct busy_state st;
+    struct oleui_dlg dlg = {0};
+    UINT ret;
+
+    if ((ret = oleui_validate(busy, sizeof(*busy)))) return ret;
+    if (busy->lphWndDialog && IsBadWritePtr(busy->lphWndDialog, sizeof(HWND))) return OLEUI_ERR_STRUCTUREINVALID;
+    if (!(busy->dwFlags & BZ_NOTRESPONDINGDIALOG) || busy->hTask)
+    {
+        /* the task that is blocking has to exist */
+        HANDLE thread = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, (DWORD_PTR)busy->hTask);
+        if (!thread) return OLEUI_BZERR_HTASKINVALID;
+        CloseHandle(thread);
+    }
+
+    st.busy = busy;
+    dlg.common = (const struct oleui_common *)busy;
+    dlg.app_struct = app;
+    dlg.proc = busy_proc;
+    dlg.priv = &st;
+    return oleui_run_dialog(&dlg, IDD_BUSY);
+}
+
+/***********************************************************************
+ *           OleUIBusyW (OLEDLG.15)
+ */
+UINT WINAPI OleUIBusyW(LPOLEUIBUSYW busy)
+{
+    TRACE("(%p)\n", busy);
+    return run_busy(busy, busy);
+}
+
+/***********************************************************************
+ *           OleUIBusyA (OLEDLG.8)
+ */
+UINT WINAPI OleUIBusyA(LPOLEUIBUSYA busya)
+{
+    OLEUIBUSYW busy;
+    WCHAR *caption, *tmpl = NULL;
+    UINT ret;
+
+    TRACE("(%p)\n", busya);
+
+    if (!busya) return OLEUI_ERR_STRUCTURENULL;
+    if (IsBadWritePtr(busya, sizeof(*busya))) return OLEUI_ERR_STRUCTUREINVALID;
+    if (busya->cbStruct != sizeof(*busya)) return OLEUI_ERR_CBSTRUCTINCORRECT;
+
+    memset(&busy, 0, sizeof(busy));
+    busy.cbStruct = sizeof(busy);
+    busy.dwFlags = busya->dwFlags;
+    busy.hWndOwner = busya->hWndOwner;
+    busy.lpfnHook = busya->lpfnHook;
+    busy.lCustData = busya->lCustData;
+    busy.hInstance = busya->hInstance;
+    busy.hResource = busya->hResource;
+    busy.hTask = busya->hTask;
+    busy.lphWndDialog = busya->lphWndDialog;
+    caption = oleui_strdupAtoW(busya->lpszCaption);
+    busy.lpszCaption = caption;
+    if (busya->lpszTemplate && !IS_INTRESOURCE(busya->lpszTemplate)) tmpl = oleui_strdupAtoW(busya->lpszTemplate);
+    busy.lpszTemplate = tmpl ? tmpl : (const WCHAR *)busya->lpszTemplate;
+
+    ret = run_busy(&busy, busya);
+    busya->dwFlags = busy.dwFlags;
+    free(caption);
+    free(tmpl);
+    return ret;
+}
+
+/***********************************************************************
+ *  PromptUser
+ */
+struct prompt_state
+{
+    int template;
+    HWND parent;
+    const WCHAR *title;
+    WCHAR *text;
+};
+
+static INT_PTR CALLBACK prompt_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct prompt_state *st = (struct prompt_state *)GetWindowLongPtrW(hwnd, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        st = (struct prompt_state *)lp;
+        SetWindowLongPtrW(hwnd, DWLP_USER, lp);
+        if (st->title) SetWindowTextW(hwnd, st->title);
+        SetDlgItemTextW(hwnd, IDC_PU_TEXT, st->text);
+        SendDlgItemMessageW(hwnd, IDC_PU_ICON, STM_SETICON, (WPARAM)LoadIconW(NULL, (LPCWSTR)IDI_EXCLAMATION), 0);
+        return TRUE;
+
+    case WM_COMMAND:
+        switch (LOWORD(wp))
+        {
+        case IDC_OLEUIHELP:
+            if (st->parent) SendMessageW(st->parent, oleui_msg_help, (WPARAM)hwnd, MAKELPARAM(st->template, 0));
+            return TRUE;
+        case IDOK:
+        case IDCANCEL:
+        case IDC_PU_LINKS:
+        case IDC_PU_CONVERT:
+            EndDialog(hwnd, LOWORD(wp));
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+static INT prompt_user(INT template, HWND parent, const WCHAR *title, const WCHAR *fmt, va_list args)
+{
+    struct prompt_state st;
+    const DLGTEMPLATE *tmpl;
+    WCHAR text[1024];
+    HRSRC rsrc;
+    HGLOBAL res;
+    WCHAR *source;
+    INT_PTR ret;
+
+    if (!(rsrc = FindResourceW(OLEDLG_hInstance, MAKEINTRESOURCEW(template), (LPCWSTR)RT_DIALOG)))
+        return OLEUI_ERR_FINDTEMPLATEFAILURE;
+    if (!(res = LoadResource(OLEDLG_hInstance, rsrc)) || !(tmpl = LockResource(res)))
+        return OLEUI_ERR_LOADTEMPLATEFAILURE;
+
+    /* the text of the dialog is the format of the arguments */
+    source = (WCHAR *)fmt;
+    st.text = text;
+#ifdef SG_MUTANT_OLEDLG_PUFMT
+    if (source) lstrcpyW(text, source);
+#else
+    if (source) wvsprintfW(text, source, args);
+#endif
+    else text[0] = 0;
+    st.template = template;
+    st.parent = parent;
+    st.title = title;
+    ret = DialogBoxIndirectParamW(OLEDLG_hInstance, tmpl, parent, prompt_proc, (LPARAM)&st);
+    return ret == -1 ? OLEUI_ERR_DIALOGFAILURE : ret;
+}
+
+/* the format string is the text the template holds for IDC_PU_TEXT */
+static WCHAR *template_text(INT template)
+{
+    const DLGTEMPLATE *tmpl;
+    HRSRC rsrc;
+    HGLOBAL res;
+    HWND hwnd;
+    WCHAR *text = NULL;
+    int len;
+
+    if (!(rsrc = FindResourceW(OLEDLG_hInstance, MAKEINTRESOURCEW(template), (LPCWSTR)RT_DIALOG)) ||
+        !(res = LoadResource(OLEDLG_hInstance, rsrc)) || !(tmpl = LockResource(res)))
+        return NULL;
+    /* a hidden window to read the control's text from */
+    hwnd = CreateDialogIndirectParamW(OLEDLG_hInstance, tmpl, NULL, NULL, 0);
+    if (!hwnd) return NULL;
+    len = GetWindowTextLengthW(GetDlgItem(hwnd, IDC_PU_TEXT));
+    if ((text = malloc((len + 1) * sizeof(WCHAR)))) GetDlgItemTextW(hwnd, IDC_PU_TEXT, text, len + 1);
+    DestroyWindow(hwnd);
+    return text;
+}
+
+/***********************************************************************
+ *           OleUIPromptUserW (OLEDLG.13)
+ */
+INT WINAPIV OleUIPromptUserW(INT template, HWND parent, ...)
+{
+    WCHAR *fmt = template_text(template);
+    const WCHAR *title;
+    va_list args;
+    INT ret;
+
+    TRACE("(%d, %p, ...)\n", template, parent);
+
+    va_start(args, parent);
+    title = va_arg(args, const WCHAR *);
+    ret = prompt_user(template, parent, title, fmt, args);
+    va_end(args);
+    free(fmt);
+    return ret;
+}
+
+/***********************************************************************
+ *           OleUIPromptUserA (OLEDLG.10)
+ */
+INT WINAPIV OleUIPromptUserA(INT template, HWND parent, ...)
+{
+    WCHAR *fmt = template_text(template), *title;
+    const char *title_a;
+    va_list args;
+    INT ret;
+
+    TRACE("(%d, %p, ...)\n", template, parent);
+
+    va_start(args, parent);
+    title_a = va_arg(args, const char *);
+    title = oleui_strdupAtoW(title_a);
+    ret = prompt_user(template, parent, title, fmt, args);
+    va_end(args);
+    free(title);
+    free(fmt);
+    return ret;
+}
diff --git a/dlls/oledlg/changeicon.c b/dlls/oledlg/changeicon.c
new file mode 100644
index 0000000..de18497
--- /dev/null
+++ b/dlls/oledlg/changeicon.c
@@ -0,0 +1,423 @@
+/*
+ * OLE UI library: the Change Icon dialog
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "commdlg.h"
+#include "ole2.h"
+#include "oledlg.h"
+#include "oledlg_private.h"
+#include "resource.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(oledlg);
+
+#define MAX_ICONS 500
+
+struct ci_state
+{
+    OLEUICHANGEICONW *ci;
+    HICON cur_icon, def_icon;
+    WCHAR cur_src[MAX_PATH], def_src[MAX_PATH];
+    UINT cur_index, def_index;
+    WCHAR orig_label[128];
+    HICON file_icons[MAX_ICONS];
+    int file_count;
+    WCHAR file[MAX_PATH];
+    HGLOBAL preview;
+    BOOL label_changed;
+};
+
+/* a class's DefaultIcon: the file and index it names, and the icon */
+static HICON class_default_icon(const CLSID *clsid, WCHAR *path, UINT *index)
+{
+    WCHAR key[100], value[MAX_PATH + 16], *comma;
+    DWORD len = sizeof(value);
+    HICON icon = NULL;
+
+    path[0] = 0;
+    *index = 0;
+    lstrcpyW(key, L"CLSID\\");
+    StringFromGUID2(clsid, key + 6, 40);
+    lstrcatW(key, L"\\DefaultIcon");
+    if (!RegGetValueW(HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ, NULL, value, &len))
+    {
+        if ((comma = wcsrchr(value, ',')))
+        {
+            *comma = 0;
+            *index = abs(wcstol(comma + 1, NULL, 10));
+        }
+        ExpandEnvironmentStringsW(value, path, MAX_PATH);
+        if (PrivateExtractIconsW(path, *index, GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON),
+                                 &icon, NULL, 1, 0) != 1)
+            icon = NULL;
+    }
+    if (!icon) path[0] = 0;
+    return icon;
+}
+
+static void ci_free_file_icons(struct ci_state *st)
+{
+    int i;
+
+    for (i = 0; i < st->file_count; i++) DestroyIcon(st->file_icons[i]);
+    st->file_count = 0;
+}
+
+static void ci_update_preview(HWND hwnd, struct ci_state *st)
+{
+    OLEUICHANGEICONW *ci = st->ci;
+    WCHAR label[128], src[MAX_PATH];
+    HICON icon = NULL;
+    UINT index = 0;
+    HGLOBAL meta;
+    int sel;
+
+    GetDlgItemTextW(hwnd, IDC_CI_LABELEDIT, label, ARRAY_SIZE(label));
+#ifdef SG_MUTANT_OLEDLG_CILABEL
+    lstrcpyW(label, st->orig_label);
+#endif
+    src[0] = 0;
+    if (IsDlgButtonChecked(hwnd, IDC_CI_CURRENT))
+    {
+        icon = st->cur_icon;
+        lstrcpyW(src, st->cur_src);
+        index = st->cur_index;
+    }
+    else if (IsDlgButtonChecked(hwnd, IDC_CI_DEFAULT))
+    {
+        icon = st->def_icon;
+        lstrcpyW(src, st->def_src);
+        index = st->def_index;
+    }
+    else
+    {
+        sel = SendDlgItemMessageW(hwnd, IDC_CI_ICONLIST, LB_GETCURSEL, 0, 0);
+        if (sel >= 0 && sel < st->file_count)
+        {
+            icon = st->file_icons[sel];
+            lstrcpyW(src, st->file);
+            index = sel;
+        }
+    }
+    if (!icon) icon = st->cur_icon ? st->cur_icon : st->def_icon;
+    if (!icon) return;
+
+    meta = OleMetafilePictFromIconAndLabel(icon, label, src[0] ? src : NULL, index);
+    if (meta)
+    {
+        oleui_metapict_free(st->preview);
+        st->preview = meta;
+        SendDlgItemMessageW(hwnd, IDC_CI_ICONDISPLAY, IBXM_IMAGESET, (WPARAM)meta, 0);
+    }
+    (void)ci;
+}
+
+static void ci_load_file_icons(HWND hwnd, struct ci_state *st)
+{
+    WCHAR path[MAX_PATH];
+    UINT total, got, i;
+    HICON *icons;
+
+    GetDlgItemTextW(hwnd, IDC_CI_FROMFILEEDIT, path, ARRAY_SIZE(path));
+    SendDlgItemMessageW(hwnd, IDC_CI_ICONLIST, LB_RESETCONTENT, 0, 0);
+    ci_free_file_icons(st);
+    st->file[0] = 0;
+    if (!path[0]) return;
+
+    total = PrivateExtractIconsW(path, 0, GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON),
+                                 NULL, NULL, 0, 0);
+    if (total == ~0u || !total) return;
+    if (total > MAX_ICONS) total = MAX_ICONS;
+    if (!(icons = calloc(total, sizeof(*icons)))) return;
+    got = PrivateExtractIconsW(path, 0, GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON),
+                               icons, NULL, total, 0);
+    if (got != ~0u)
+    {
+        lstrcpyW(st->file, path);
+        for (i = 0; i < got && i < total; i++)
+        {
+            st->file_icons[i] = icons[i];
+            SendDlgItemMessageW(hwnd, IDC_CI_ICONLIST, LB_ADDSTRING, 0, (LPARAM)L"");
+        }
+        st->file_count = got;
+        SendDlgItemMessageW(hwnd, IDC_CI_ICONLIST, LB_SETCURSEL, 0, 0);
+    }
+    free(icons);
+}
+
+static void ci_select(HWND hwnd, struct ci_state *st, int id)
+{
+    BOOL file = id == IDC_CI_FROMFILE;
+
+    CheckRadioButton(hwnd, IDC_CI_CURRENT, IDC_CI_FROMFILE, id);
+    EnableWindow(GetDlgItem(hwnd, IDC_CI_FROMFILEEDIT), file);
+    EnableWindow(GetDlgItem(hwnd, IDC_CI_ICONLIST), file);
+    ci_update_preview(hwnd, st);
+}
+
+static void ci_browse(HWND hwnd, struct ci_state *st)
+{
+    OPENFILENAMEW ofn = {0};
+    WCHAR file[MAX_PATH], title[64];
+    WCHAR filter[160];
+    int n;
+
+    GetDlgItemTextW(hwnd, IDC_CI_FROMFILEEDIT, file, ARRAY_SIZE(file));
+    n = LoadStringW(OLEDLG_hInstance, IDS_CI_FILTER, filter, ARRAY_SIZE(filter) - 2);
+    filter[n + 1] = 0;
+    /* the string table holds the filter with '|' for the separators */
+    for (n = 0; filter[n]; n++) if (filter[n] == '|') filter[n] = 0;
+    LoadStringW(OLEDLG_hInstance, IDS_CI_BROWSE, title, ARRAY_SIZE(title));
+    ofn.lStructSize = sizeof(ofn);
+    ofn.hwndOwner = hwnd;
+    ofn.lpstrFilter = filter;
+    ofn.lpstrFile = file;
+    ofn.nMaxFile = ARRAY_SIZE(file);
+    ofn.lpstrTitle = title;
+    ofn.Flags = OFN_EXPLORER | OFN_FILEMUSTEXIST | OFN_HIDEREADONLY | OFN_PATHMUSTEXIST;
+    if (GetOpenFileNameW(&ofn))
+    {
+        SetDlgItemTextW(hwnd, IDC_CI_FROMFILEEDIT, file);
+        ci_select(hwnd, st, IDC_CI_FROMFILE);
+        ci_load_file_icons(hwnd, st);
+        ci_update_preview(hwnd, st);
+    }
+}
+
+static INT_PTR ci_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, struct oleui_dlg *dlg)
+{
+    struct ci_state *st = dlg->priv;
+    OLEUICHANGEICONW *ci = st->ci;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        WCHAR label[128];
+        int id = IDC_CI_CURRENT;
+
+        st->cur_icon = oleui_metapict_icon(ci->hMetaPict, st->cur_src, ARRAY_SIZE(st->cur_src), &st->cur_index,
+                                           st->orig_label, ARRAY_SIZE(st->orig_label));
+        st->def_icon = class_default_icon(&ci->clsid, st->def_src, &st->def_index);
+        if (!st->def_icon && (ci->dwFlags & CIF_USEICONEXE) && ci->szIconExe[0])
+        {
+            lstrcpyW(st->def_src, ci->szIconExe);
+            st->def_index = 0;
+            if (PrivateExtractIconsW(st->def_src, 0, GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON),
+                                     &st->def_icon, NULL, 1, 0) != 1)
+                st->def_icon = NULL;
+        }
+        if (!st->def_icon)
+        {
+            st->def_icon = CopyIcon(LoadIconW(NULL, (LPCWSTR)IDI_APPLICATION));
+            st->def_src[0] = 0;
+        }
+        if (!st->cur_icon) st->cur_icon = CopyIcon(st->def_icon);
+
+        SendDlgItemMessageW(hwnd, IDC_CI_CURRENTICON, STM_SETICON, (WPARAM)st->cur_icon, 0);
+        SendDlgItemMessageW(hwnd, IDC_CI_DEFAULTICON, STM_SETICON, (WPARAM)st->def_icon, 0);
+        SendDlgItemMessageW(hwnd, IDC_CI_ICONLIST, LB_SETCOLUMNWIDTH, 2 * GetSystemMetrics(SM_CXICON) + 4, 0);
+        SendDlgItemMessageW(hwnd, IDC_CI_LABELEDIT, EM_LIMITTEXT, ARRAY_SIZE(label) - 1, 0);
+        SetDlgItemTextW(hwnd, IDC_CI_LABELEDIT, st->orig_label);
+        if (!(ci->dwFlags & CIF_SHOWHELP)) ShowWindow(GetDlgItem(hwnd, IDC_OLEUIHELP), SW_HIDE);
+
+        if (ci->dwFlags & CIF_SELECTDEFAULT) id = IDC_CI_DEFAULT;
+        else if (ci->dwFlags & CIF_SELECTFROMFILE) id = IDC_CI_FROMFILE;
+        ci_select(hwnd, st, id);
+        return TRUE;
+    }
+
+    case WM_MEASUREITEM:
+    {
+        MEASUREITEMSTRUCT *mi = (MEASUREITEMSTRUCT *)lp;
+        if (wp != IDC_CI_ICONLIST) return FALSE;
+        mi->itemWidth = 2 * GetSystemMetrics(SM_CXICON);
+        mi->itemHeight = GetSystemMetrics(SM_CYICON) + 8;
+        return TRUE;
+    }
+
+    case WM_DRAWITEM:
+    {
+        DRAWITEMSTRUCT *di = (DRAWITEMSTRUCT *)lp;
+        if (wp != IDC_CI_ICONLIST || (int)di->itemID < 0) return FALSE;
+        FillRect(di->hDC, &di->rcItem, GetSysColorBrush((di->itemState & ODS_SELECTED) ? COLOR_HIGHLIGHT : COLOR_WINDOW));
+        if ((int)di->itemID < st->file_count)
+            DrawIcon(di->hDC, (di->rcItem.left + di->rcItem.right - GetSystemMetrics(SM_CXICON)) / 2,
+                     di->rcItem.top + 4, st->file_icons[di->itemID]);
+        if (di->itemState & ODS_FOCUS) DrawFocusRect(di->hDC, &di->rcItem);
+        return TRUE;
+    }
+
+    case WM_COMMAND:
+        switch (LOWORD(wp))
+        {
+        case IDC_CI_CURRENT:
+        case IDC_CI_DEFAULT:
+        case IDC_CI_FROMFILE:
+            if (HIWORD(wp) == BN_CLICKED)
+            {
+                ci_select(hwnd, st, LOWORD(wp));
+                if (LOWORD(wp) == IDC_CI_FROMFILE && !st->file_count) ci_load_file_icons(hwnd, st);
+                ci_update_preview(hwnd, st);
+            }
+            return TRUE;
+        case IDC_CI_BROWSE:
+            ci_browse(hwnd, st);
+            return TRUE;
+        case IDC_CI_ICONLIST:
+            if (HIWORD(wp) == LBN_SELCHANGE) ci_update_preview(hwnd, st);
+            return TRUE;
+        case IDC_CI_LABELEDIT:
+            if (HIWORD(wp) == EN_CHANGE && st->preview) { st->label_changed = TRUE; ci_update_preview(hwnd, st); }
+            return TRUE;
+        case IDC_CI_FROMFILEEDIT:
+            if (HIWORD(wp) == EN_KILLFOCUS)
+            {
+                WCHAR path[MAX_PATH];
+                GetDlgItemTextW(hwnd, IDC_CI_FROMFILEEDIT, path, ARRAY_SIZE(path));
+                if (lstrcmpiW(path, st->file)) { ci_load_file_icons(hwnd, st); ci_update_preview(hwnd, st); }
+            }
+            return TRUE;
+        case IDOK:
+        {
+            DWORD flags = ci->dwFlags & ~(CIF_SELECTCURRENT | CIF_SELECTDEFAULT | CIF_SELECTFROMFILE);
+            BOOL cur = IsDlgButtonChecked(hwnd, IDC_CI_CURRENT);
+
+            if (IsDlgButtonChecked(hwnd, IDC_CI_FROMFILE))
+            {
+                WCHAR path[MAX_PATH];
+                GetDlgItemTextW(hwnd, IDC_CI_FROMFILEEDIT, path, ARRAY_SIZE(path));
+                if (lstrcmpiW(path, st->file)) { ci_load_file_icons(hwnd, st); ci_update_preview(hwnd, st); }
+                if (!st->file_count) return TRUE;   /* nothing to take */
+                flags |= CIF_SELECTFROMFILE;
+            }
+            else flags |= cur ? CIF_SELECTCURRENT : CIF_SELECTDEFAULT;
+#ifndef SG_MUTANT_OLEDLG_CIFLAGS
+            ci->dwFlags = flags;
+#endif
+            /* the current picture stays as it is when nothing about it changed */
+            if (st->preview && !(cur && !st->label_changed))
+            {
+                oleui_metapict_free(ci->hMetaPict);
+                ci->hMetaPict = st->preview;
+                st->preview = NULL;
+            }
+            EndDialog(hwnd, OLEUI_OK);
+            return TRUE;
+        }
+        case IDCANCEL:
+            EndDialog(hwnd, OLEUI_CANCEL);
+            return TRUE;
+        }
+        break;
+
+    case WM_DESTROY:
+        ci_free_file_icons(st);
+        if (st->cur_icon) DestroyIcon(st->cur_icon);
+        if (st->def_icon) DestroyIcon(st->def_icon);
+        oleui_metapict_free(st->preview);
+        st->preview = NULL;
+        st->cur_icon = st->def_icon = NULL;
+        break;
+    }
+    return FALSE;
+}
+
+UINT oleui_changeicon(OLEUICHANGEICONW *ci, void *app)
+{
+    struct ci_state st = {0};
+    struct oleui_dlg dlg = {0};
+    UINT ret;
+
+    if ((ret = oleui_validate(ci, sizeof(*ci)))) return ret;
+    if (!ci->hMetaPict || IsBadReadPtr(ci->hMetaPict, 1) || !GlobalSize(ci->hMetaPict))
+        return OLEUI_CIERR_MUSTHAVECURRENTMETAFILE;
+    if (IsEqualGUID(&ci->clsid, &GUID_NULL) && !(ci->dwFlags & CIF_USEICONEXE))
+        return OLEUI_CIERR_MUSTHAVECLSID;
+    if ((ci->dwFlags & CIF_USEICONEXE) && (ci->cchIconExe < 0 || ci->cchIconExe > MAX_PATH))
+        return OLEUI_CIERR_SZICONEXEINVALID;
+
+    st.ci = ci;
+    dlg.common = (const struct oleui_common *)ci;
+    dlg.app_struct = app;
+    dlg.proc = ci_proc;
+    dlg.priv = &st;
+    return oleui_run_dialog(&dlg, IDD_CHANGEICON);
+}
+
+/***********************************************************************
+ *           OleUIChangeIconW (OLEDLG.16)
+ */
+UINT WINAPI OleUIChangeIconW(LPOLEUICHANGEICONW ci)
+{
+    TRACE("(%p)\n", ci);
+    return oleui_changeicon(ci, ci);
+}
+
+/***********************************************************************
+ *           OleUIChangeIconA (OLEDLG.6)
+ */
+UINT WINAPI OleUIChangeIconA(LPOLEUICHANGEICONA cia)
+{
+    OLEUICHANGEICONW ci;
+    WCHAR *caption, *tmpl = NULL;
+    UINT ret;
+
+    TRACE("(%p)\n", cia);
+
+    if (!cia) return OLEUI_ERR_STRUCTURENULL;
+    if (IsBadWritePtr(cia, sizeof(*cia))) return OLEUI_ERR_STRUCTUREINVALID;
+    if (cia->cbStruct != sizeof(*cia)) return OLEUI_ERR_CBSTRUCTINCORRECT;
+
+    memset(&ci, 0, sizeof(ci));
+    memcpy(&ci, cia, FIELD_OFFSET(OLEUICHANGEICONA, lpszCaption));
+    ci.cbStruct = sizeof(ci);
+    ci.lpfnHook = cia->lpfnHook;
+    ci.lCustData = cia->lCustData;
+    ci.hInstance = cia->hInstance;
+    ci.hResource = cia->hResource;
+    ci.hMetaPict = cia->hMetaPict;
+    ci.clsid = cia->clsid;
+    ci.cchIconExe = cia->cchIconExe;
+    caption = oleui_strdupAtoW(cia->lpszCaption);
+    ci.lpszCaption = caption;
+    if (cia->lpszTemplate && !IS_INTRESOURCE(cia->lpszTemplate)) tmpl = oleui_strdupAtoW(cia->lpszTemplate);
+    ci.lpszTemplate = tmpl ? tmpl : (const WCHAR *)cia->lpszTemplate;
+    MultiByteToWideChar(CP_ACP, 0, cia->szIconExe, -1, ci.szIconExe, MAX_PATH);
+
+    ret = oleui_changeicon(&ci, cia);
+
+    cia->dwFlags = ci.dwFlags;
+    cia->hMetaPict = ci.hMetaPict;
+    free(caption);
+    free(tmpl);
+    return ret;
+}
diff --git a/dlls/oledlg/convert.c b/dlls/oledlg/convert.c
new file mode 100644
index 0000000..32ab4c0
--- /dev/null
+++ b/dlls/oledlg/convert.c
@@ -0,0 +1,457 @@
+/*
+ * OLE UI library: the Convert dialog
+ *
+ * Copyright 2026 Stained Glass OS
