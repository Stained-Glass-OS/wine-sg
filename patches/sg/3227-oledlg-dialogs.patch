+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "ole2.h"
+#include "oledlg.h"
+#include "oledlg_private.h"
+#include "resource.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(oledlg);
+
+struct cv_state
+{
+    OLEUICONVERTW *cv;
+    WCHAR format[128];
+    WCHAR cur_type[128];
+    HGLOBAL icon_meta;      /* the picture shown in the icon box, owned by the dialog */
+    BOOL icon_changed;
+};
+
+static const CLSID *cv_item_clsid(HWND hwnd, int list, int index)
+{
+    LRESULT data;
+
+    if (index < 0) return NULL;
+    data = SendDlgItemMessageW(hwnd, list, LB_GETITEMDATA, index, 0);
+    return data == LB_ERR ? NULL : (const CLSID *)data;
+}
+
+static int cv_active_list(HWND hwnd)
+{
+    if (IsDlgButtonChecked(hwnd, IDC_CV_ACTIVATEAS)) return IDC_CV_ACTIVATELIST;
+    return IDC_CV_CONVERTLIST;
+}
+
+static const CLSID *cv_selected(HWND hwnd)
+{
+    int list = cv_active_list(hwnd);
+    return cv_item_clsid(hwnd, list, SendDlgItemMessageW(hwnd, list, LB_GETCURSEL, 0, 0));
+}
+
+static void cv_fill_lists(HWND hwnd, struct cv_state *st)
+{
+    OLEUICONVERTW *cv = st->cv;
+    HKEY clsids;
+    WCHAR name[64], type[128];
+    DWORD i;
+    BOOL convert_only = cv->dwFlags & CF_CONVERTONLY;
+
+    if (RegOpenKeyExW(HKEY_CLASSES_ROOT, L"CLSID", 0, KEY_READ, &clsids)) return;
+    for (i = 0; !RegEnumKeyW(clsids, i, name, ARRAY_SIZE(name)); i++)
+    {
+        CLSID id;
+        int j;
+
+        if (CLSIDFromString(name, &id) != S_OK) continue;
+        if (oleui_class_excluded(&id, cv->lpClsidExclude, cv->cClsidExclude)) continue;
+        if (!oleui_class_user_type(&id, FALSE, type, ARRAY_SIZE(type))) continue;
+
+        for (j = 0; j < 2; j++)
+        {
+            int list = j ? IDC_CV_ACTIVATELIST : IDC_CV_CONVERTLIST;
+            LRESULT index;
+            CLSID *copy;
+
+            if (j && (convert_only || cv->fIsLinkedObject)) break;
+#ifdef SG_MUTANT_OLEDLG_CVLISTS
+            if (!oleui_class_converts(&cv->clsid, st->format, !j, &id)) continue;
+#else
+            if (!oleui_class_converts(&cv->clsid, st->format, j, &id)) continue;
+#endif
+            if (!(copy = malloc(sizeof(*copy)))) continue;
+            *copy = id;
+            index = SendDlgItemMessageW(hwnd, list, LB_ADDSTRING, 0, (LPARAM)type);
+            if (index == LB_ERR) { free(copy); continue; }
+            SendDlgItemMessageW(hwnd, list, LB_SETITEMDATA, index, (LPARAM)copy);
+        }
+    }
+    RegCloseKey(clsids);
+}
+
+static void cv_free_lists(HWND hwnd)
+{
+    int list, i, count;
+
+    for (list = IDC_CV_ACTIVATELIST; list <= IDC_CV_CONVERTLIST; list += IDC_CV_CONVERTLIST - IDC_CV_ACTIVATELIST)
+    {
+        count = SendDlgItemMessageW(hwnd, list, LB_GETCOUNT, 0, 0);
+        for (i = 0; i < count; i++) free((void *)SendDlgItemMessageW(hwnd, list, LB_GETITEMDATA, i, 0));
+    }
+}
+
+static void cv_select_default(HWND hwnd, int list, const CLSID *def)
+{
+    int i, count = SendDlgItemMessageW(hwnd, list, LB_GETCOUNT, 0, 0);
+
+    for (i = 0; def && i < count; i++)
+    {
+        const CLSID *id = cv_item_clsid(hwnd, list, i);
+        if (id && IsEqualGUID(id, def))
+        {
+            SendDlgItemMessageW(hwnd, list, LB_SETCURSEL, i, 0);
+            return;
+        }
+    }
+    if (count > 0) SendDlgItemMessageW(hwnd, list, LB_SETCURSEL, 0, 0);
+}
+
+static void cv_set_icon(HWND hwnd, struct cv_state *st, HGLOBAL meta)
+{
+    if (meta != st->icon_meta) oleui_metapict_free(st->icon_meta);
+    st->icon_meta = meta;
+    SendDlgItemMessageW(hwnd, IDC_CV_ICONDISPLAY, IBXM_IMAGESET, (WPARAM)meta, 0);
+}
+
+/* the icon of the class the object would have after the dialog */
+static void cv_default_icon(HWND hwnd, struct cv_state *st)
+{
+    OLEUICONVERTW *cv = st->cv;
+    const CLSID *id = cv_selected(hwnd);
+
+    if (!id || IsDlgButtonChecked(hwnd, IDC_CV_ACTIVATEAS)) id = &cv->clsid;
+    cv_set_icon(hwnd, st, OleGetIconOfClass(id, cv->lpszDefLabel, cv->lpszDefLabel == NULL));
+}
+
+static void cv_update(HWND hwnd, struct cv_state *st)
+{
+    OLEUICONVERTW *cv = st->cv;
+    BOOL icon = IsDlgButtonChecked(hwnd, IDC_CV_DISPLAYASICON);
+    BOOL activate = IsDlgButtonChecked(hwnd, IDC_CV_ACTIVATEAS);
+    const CLSID *sel = cv_selected(hwnd);
+    WCHAR type[128], text[600], tail[200];
+    WCHAR *args[2];
+    int list = cv_active_list(hwnd);
+
+    if (cv->dwFlags & CF_CONVERTONLY) activate = FALSE;
+    ShowWindow(GetDlgItem(hwnd, IDC_CV_CONVERTLIST), activate ? SW_HIDE : SW_SHOW);
+    ShowWindow(GetDlgItem(hwnd, IDC_CV_ACTIVATELIST), activate ? SW_SHOW : SW_HIDE);
+
+    type[0] = 0;
+    if (sel) SendDlgItemMessageW(hwnd, list, LB_GETTEXT, SendDlgItemMessageW(hwnd, list, LB_GETCURSEL, 0, 0), (LPARAM)type);
+    args[0] = st->cur_type;
+    args[1] = type;
+    if (!sel) text[0] = 0;
+    else
+    {
+        WCHAR fmt[300];
+        LoadStringW(OLEDLG_hInstance, activate ? IDS_CV_ACTIVATEAS : IDS_CV_CONVERTTO, fmt, ARRAY_SIZE(fmt));
+        FormatMessageW(FORMAT_MESSAGE_FROM_STRING | FORMAT_MESSAGE_ARGUMENT_ARRAY, fmt, 0, 0, text,
+                       ARRAY_SIZE(text), (va_list *)args);
+    }
+    if (icon)
+    {
+        LoadStringW(OLEDLG_hInstance, IDS_CV_ASICON, tail, ARRAY_SIZE(tail));
+        lstrcatW(text, tail);
+    }
+    SetDlgItemTextW(hwnd, IDC_CV_RESULTTEXT, text);
+
+    if (!(cv->dwFlags & CF_CONVERTONLY))
+    {
+        EnableWindow(GetDlgItem(hwnd, IDC_CV_CHANGEICON), icon);
+        ShowWindow(GetDlgItem(hwnd, IDC_CV_ICONDISPLAY), icon ? SW_SHOW : SW_HIDE);
+    }
+}
+
+static INT_PTR cv_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, struct oleui_dlg *dlg)
+{
+    struct cv_state *st = dlg->priv;
+    OLEUICONVERTW *cv = st->cv;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        BOOL convert_only = cv->dwFlags & CF_CONVERTONLY;
+
+        if (!oleui_class_format(&cv->clsid, st->format, ARRAY_SIZE(st->format)))
+            oleui_format_name(cv->wFormat, st->format, ARRAY_SIZE(st->format));
+        if (cv->lpszUserType) lstrcpynW(st->cur_type, cv->lpszUserType, ARRAY_SIZE(st->cur_type));
+        else if (!oleui_class_user_type(&cv->clsid, FALSE, st->cur_type, ARRAY_SIZE(st->cur_type)))
+            LoadStringW(OLEDLG_hInstance, IDS_PS_UNKNOWN_TYPE, st->cur_type, ARRAY_SIZE(st->cur_type));
+        SetDlgItemTextW(hwnd, IDC_CV_OBJECTTYPE, st->cur_type);
+        SetDlgItemTextW(hwnd, IDC_CV_OBJECTTYPE, st->cur_type);
+
+        cv_fill_lists(hwnd, st);
+        cv_select_default(hwnd, IDC_CV_CONVERTLIST, (cv->dwFlags & CF_SETCONVERTDEFAULT) ? &cv->clsidConvertDefault : NULL);
+        cv_select_default(hwnd, IDC_CV_ACTIVATELIST, (cv->dwFlags & CF_SETACTIVATEDEFAULT) ? &cv->clsidActivateDefault : NULL);
+
+        if (!(cv->dwFlags & CF_SHOWHELPBUTTON)) ShowWindow(GetDlgItem(hwnd, IDC_OLEUIHELP), SW_HIDE);
+        if (!convert_only)
+        {
+            BOOL no_activate = (cv->dwFlags & CF_DISABLEACTIVATEAS) || cv->fIsLinkedObject ||
+                               !SendDlgItemMessageW(hwnd, IDC_CV_ACTIVATELIST, LB_GETCOUNT, 0, 0);
+            EnableWindow(GetDlgItem(hwnd, IDC_CV_ACTIVATEAS), !no_activate);
+            CheckRadioButton(hwnd, IDC_CV_CONVERTTO, IDC_CV_ACTIVATEAS,
+                             (cv->dwFlags & CF_SELECTACTIVATEAS) && !no_activate ? IDC_CV_ACTIVATEAS : IDC_CV_CONVERTTO);
+
+            EnableWindow(GetDlgItem(hwnd, IDC_CV_DISPLAYASICON), !(cv->dwFlags & CF_DISABLEDISPLAYASICON));
+            if (cv->dwFlags & CF_HIDECHANGEICON) ShowWindow(GetDlgItem(hwnd, IDC_CV_CHANGEICON), SW_HIDE);
+            if (cv->dvAspect == DVASPECT_ICON)
+            {
+                CheckDlgButton(hwnd, IDC_CV_DISPLAYASICON, BST_CHECKED);
+                if (cv->hMetaPict) cv_set_icon(hwnd, st, oleui_metapict_copy(cv->hMetaPict));
+                else cv_default_icon(hwnd, st);
+            }
+        }
+        cv_update(hwnd, st);
+        return TRUE;
+    }
+
+    case WM_COMMAND:
+        switch (LOWORD(wp))
+        {
+        case IDC_CV_CONVERTTO:
+        case IDC_CV_ACTIVATEAS:
+            if (HIWORD(wp) == BN_CLICKED)
+            {
+                CheckRadioButton(hwnd, IDC_CV_CONVERTTO, IDC_CV_ACTIVATEAS, LOWORD(wp));
+                if (IsDlgButtonChecked(hwnd, IDC_CV_DISPLAYASICON) && !st->icon_changed) cv_default_icon(hwnd, st);
+                cv_update(hwnd, st);
+            }
+            return TRUE;
+        case IDC_CV_CONVERTLIST:
+        case IDC_CV_ACTIVATELIST:
+            if (HIWORD(wp) == LBN_SELCHANGE)
+            {
+                if (IsDlgButtonChecked(hwnd, IDC_CV_DISPLAYASICON) && !st->icon_changed) cv_default_icon(hwnd, st);
+                cv_update(hwnd, st);
+            }
+            else if (HIWORD(wp) == LBN_DBLCLK) SendMessageW(hwnd, WM_COMMAND, IDOK, 0);
+            return TRUE;
+        case IDC_CV_DISPLAYASICON:
+            if (HIWORD(wp) == BN_CLICKED)
+            {
+                if (IsDlgButtonChecked(hwnd, IDC_CV_DISPLAYASICON) && !st->icon_meta)
+                {
+                    if (cv->hMetaPict) cv_set_icon(hwnd, st, oleui_metapict_copy(cv->hMetaPict));
+                    else cv_default_icon(hwnd, st);
+                }
+                cv_update(hwnd, st);
+            }
+            return TRUE;
+        case IDC_CV_CHANGEICON:
+        {
+            OLEUICHANGEICONW ci = {0};
+            const CLSID *sel = cv_selected(hwnd);
+
+            if (!st->icon_meta) return TRUE;
+            ci.cbStruct = sizeof(ci);
+            ci.dwFlags = CIF_SELECTCURRENT | (cv->dwFlags & CF_SHOWHELPBUTTON ? CIF_SHOWHELP : 0);
+            ci.hWndOwner = hwnd;
+            ci.hMetaPict = oleui_metapict_copy(st->icon_meta);
+            ci.clsid = (sel && !IsDlgButtonChecked(hwnd, IDC_CV_ACTIVATEAS)) ? *sel : cv->clsid;
+            if (OleUIChangeIconW(&ci) == OLEUI_OK)
+            {
+                st->icon_changed = TRUE;
+                cv_set_icon(hwnd, st, ci.hMetaPict);
+                cv->fObjectsIconChanged = TRUE;
+            }
+            else oleui_metapict_free(ci.hMetaPict);
+            return TRUE;
+        }
+        case IDOK:
+        {
+            BOOL activate = IsDlgButtonChecked(hwnd, IDC_CV_ACTIVATEAS) && !(cv->dwFlags & CF_CONVERTONLY);
+            const CLSID *sel = cv_selected(hwnd);
+            BOOL icon = IsDlgButtonChecked(hwnd, IDC_CV_DISPLAYASICON);
+
+            cv->clsidNew = sel ? *sel : cv->clsid;
+            cv->dwFlags &= ~(CF_SELECTCONVERTTO | CF_SELECTACTIVATEAS);
+#ifdef SG_MUTANT_OLEDLG_CVFLAGS
+            cv->dwFlags |= CF_SELECTCONVERTTO;
+#else
+            cv->dwFlags |= activate ? CF_SELECTACTIVATEAS : CF_SELECTCONVERTTO;
+#endif
+            cv->dvAspect = icon ? DVASPECT_ICON : DVASPECT_CONTENT;
+            if (icon && st->icon_meta && (st->icon_changed || !cv->hMetaPict || sel))
+            {
+                if (st->icon_changed || !cv->hMetaPict)
+                {
+                    if (cv->hMetaPict) oleui_metapict_free(cv->hMetaPict);
+                    cv->hMetaPict = st->icon_meta;
+                    st->icon_meta = NULL;
+                }
+            }
+            EndDialog(hwnd, OLEUI_OK);
+            return TRUE;
+        }
+        case IDCANCEL:
+            EndDialog(hwnd, OLEUI_CANCEL);
+            return TRUE;
+        }
+        break;
+
+    case WM_DESTROY:
+        cv_free_lists(hwnd);
+        oleui_metapict_free(st->icon_meta);
+        st->icon_meta = NULL;
+        break;
+    }
+    return FALSE;
+}
+
+UINT oleui_convert(OLEUICONVERTW *cv, void *app)
+{
+    struct cv_state st = {0};
+    struct oleui_dlg dlg = {0};
+    UINT ret;
+
+    if ((ret = oleui_validate(cv, sizeof(*cv)))) return ret;
+
+    if (IsEqualGUID(&cv->clsid, &GUID_NULL)) ret = OLEUI_CTERR_CLASSIDINVALID;
+    else if (cv->dvAspect != DVASPECT_CONTENT && cv->dvAspect != DVASPECT_ICON) ret = OLEUI_CTERR_DVASPECTINVALID;
+    else if (cv->hMetaPict && (IsBadReadPtr(cv->hMetaPict, 1) || !GlobalSize(cv->hMetaPict)))
+        ret = OLEUI_CTERR_HMETAPICTINVALID;
+    else if ((cv->lpszUserType && IsBadReadPtr(cv->lpszUserType, sizeof(WCHAR))) ||
+             (cv->lpszDefLabel && IsBadReadPtr(cv->lpszDefLabel, sizeof(WCHAR))))
+        ret = OLEUI_CTERR_STRINGINVALID;
+    else if (cv->cClsidExclude && (!cv->lpClsidExclude ||
+             IsBadReadPtr(cv->lpClsidExclude, cv->cClsidExclude * sizeof(CLSID))))
+        ret = OLEUI_ERR_STRUCTUREINVALID;
+    else
+    {
+        st.cv = cv;
+        dlg.common = (const struct oleui_common *)cv;
+        dlg.app_struct = app;
+        dlg.proc = cv_proc;
+        dlg.priv = &st;
+        ret = oleui_run_dialog(&dlg, (cv->dwFlags & CF_CONVERTONLY) ? IDD_CONVERTONLY : IDD_CONVERT);
+    }
+
+    /* the strings are the dialog's to free */
+#ifndef SG_MUTANT_OLEDLG_CVFREE
+    CoTaskMemFree(cv->lpszUserType);
+    CoTaskMemFree(cv->lpszDefLabel);
+    cv->lpszUserType = NULL;
+    cv->lpszDefLabel = NULL;
+#endif
+    return ret;
+}
+
+/***********************************************************************
+ *           OleUIConvertW (OLEDLG.18)
+ */
+UINT WINAPI OleUIConvertW(LPOLEUICONVERTW cv)
+{
+    TRACE("(%p)\n", cv);
+    return oleui_convert(cv, cv);
+}
+
+/***********************************************************************
+ *           OleUIConvertA (OLEDLG.7)
+ */
+UINT WINAPI OleUIConvertA(LPOLEUICONVERTA cva)
+{
+    OLEUICONVERTW cv;
+    WCHAR *caption, *tmpl = NULL, *tmp;
+    BOOL made_ut = FALSE, made_dl = FALSE;
+    UINT ret;
+
+    TRACE("(%p)\n", cva);
+
+    if (!cva) return OLEUI_ERR_STRUCTURENULL;
+    if (IsBadWritePtr(cva, sizeof(*cva))) return OLEUI_ERR_STRUCTUREINVALID;
+    if (cva->cbStruct != sizeof(*cva)) return OLEUI_ERR_CBSTRUCTINCORRECT;
+
+    memset(&cv, 0, sizeof(cv));
+    cv.cbStruct = sizeof(cv);
+    cv.dwFlags = cva->dwFlags;
+    cv.hWndOwner = cva->hWndOwner;
+    cv.lpfnHook = cva->lpfnHook;
+    cv.lCustData = cva->lCustData;
+    cv.hInstance = cva->hInstance;
+    cv.hResource = cva->hResource;
+    cv.clsid = cva->clsid;
+    cv.clsidConvertDefault = cva->clsidConvertDefault;
+    cv.clsidActivateDefault = cva->clsidActivateDefault;
+    cv.clsidNew = cva->clsidNew;
+    cv.dvAspect = cva->dvAspect;
+    cv.wFormat = cva->wFormat;
+    cv.fIsLinkedObject = cva->fIsLinkedObject;
+    cv.hMetaPict = cva->hMetaPict;
+    cv.fObjectsIconChanged = cva->fObjectsIconChanged;
+    cv.cClsidExclude = cva->cClsidExclude;
+    cv.lpClsidExclude = cva->lpClsidExclude;
+    caption = oleui_strdupAtoW(cva->lpszCaption);
+    cv.lpszCaption = caption;
+    if (cva->lpszTemplate && !IS_INTRESOURCE(cva->lpszTemplate)) tmpl = oleui_strdupAtoW(cva->lpszTemplate);
+    cv.lpszTemplate = tmpl ? tmpl : (const WCHAR *)cva->lpszTemplate;
+    if (cva->lpszUserType && !IsBadReadPtr(cva->lpszUserType, 1))
+    {
+        tmp = oleui_strdupAtoW(cva->lpszUserType);
+        cv.lpszUserType = oleui_cotaskdup(tmp);
+        free(tmp);
+        made_ut = TRUE;
+    }
+    else cv.lpszUserType = (WCHAR *)cva->lpszUserType;
+    if (cva->lpszDefLabel && !IsBadReadPtr(cva->lpszDefLabel, 1))
+    {
+        tmp = oleui_strdupAtoW(cva->lpszDefLabel);
+        cv.lpszDefLabel = oleui_cotaskdup(tmp);
+        free(tmp);
+        made_dl = TRUE;
+    }
+    else cv.lpszDefLabel = (WCHAR *)cva->lpszDefLabel;
+
+    ret = oleui_convert(&cv, cva);
+
+    cva->dwFlags = cv.dwFlags;
+    cva->clsidNew = cv.clsidNew;
+    cva->dvAspect = cv.dvAspect;
+    cva->hMetaPict = cv.hMetaPict;
+    cva->fObjectsIconChanged = cv.fObjectsIconChanged;
+    /* strings the dialog freed are the caller's to lose, the others are our copies */
+    if (made_ut)
+    {
+        if (!cv.lpszUserType) { CoTaskMemFree(cva->lpszUserType); cva->lpszUserType = NULL; }
+        else CoTaskMemFree(cv.lpszUserType);
+    }
+    if (made_dl)
+    {
+        if (!cv.lpszDefLabel) { CoTaskMemFree(cva->lpszDefLabel); cva->lpszDefLabel = NULL; }
+        else CoTaskMemFree(cv.lpszDefLabel);
+    }
+    free(caption);
+    free(tmpl);
+    return ret;
+}
