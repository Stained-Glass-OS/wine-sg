+
+/***********************************************************************
+ *  Update Links
+ */
+struct ul_state
+{
+    IOleUILinkContainerW *cntr;
+    const WCHAR *title;
+    int total, done;
+    DWORD link;
+    BOOL failed, stopped;
+};
+
+#define WM_UL_STEP (WM_APP + 1)
+
+static void ul_draw(HWND hwnd, struct ul_state *st)
+{
+    HWND meter = GetDlgItem(hwnd, IDC_UL_METER);
+    RECT rc;
+    HDC hdc;
+    WCHAR text[16];
+    int percent = st->total > 0 ? min(100, st->done * 100 / st->total) : 100;
+
+    wsprintfW(text, L"%d%%", percent);
+    SetDlgItemTextW(hwnd, IDC_UL_PERCENT, text);
+    if (!meter || !(hdc = GetDC(meter))) return;
+    GetClientRect(meter, &rc);
+    InflateRect(&rc, -1, -1);
+    rc.right = rc.left + (rc.right - rc.left) * percent / 100;
+    FillRect(hdc, &rc, GetSysColorBrush(COLOR_HIGHLIGHT));
+    ReleaseDC(meter, hdc);
+}
+
+static INT_PTR CALLBACK ul_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct ul_state *st = (struct ul_state *)GetWindowLongPtrW(hwnd, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        st = (struct ul_state *)lp;
+        SetWindowLongPtrW(hwnd, DWLP_USER, lp);
+        if (st->title) SetWindowTextW(hwnd, st->title);
+        PostMessageW(hwnd, WM_UL_STEP, 0, 0);
+        return TRUE;
+
+    case WM_PAINT:
+        DefWindowProcW(hwnd, msg, wp, lp);
+        ul_draw(hwnd, st);
+        SetWindowLongPtrW(hwnd, DWLP_MSGRESULT, 0);
+        return TRUE;
+
+    case WM_UL_STEP:
+    {
+        DWORD next = IOleUILinkContainer_GetNextLink(st->cntr, st->link);
+        DWORD opt = 0;
+
+        if (!next)
+        {
+            EndDialog(hwnd, 1);
+            return TRUE;
+        }
+        st->link = next;
+        /* only the links that update automatically are brought up to date */
+#ifdef SG_MUTANT_OLEDLG_ULALL
+        if (TRUE)
+#else
+        if (SUCCEEDED(IOleUILinkContainer_GetLinkUpdateOptions(st->cntr, next, &opt)) && opt == UPDATE_ALWAYS)
+#endif
+        {
+#ifndef SG_MUTANT_OLEDLG_ULFAIL
+            if (FAILED(IOleUILinkContainer_UpdateLink(st->cntr, next, FALSE, FALSE))) st->failed = TRUE;
+#else
+            IOleUILinkContainer_UpdateLink(st->cntr, next, FALSE, FALSE);
+#endif
+        }
+        st->done++;
+        ul_draw(hwnd, st);
+        PostMessageW(hwnd, WM_UL_STEP, 0, 0);
+        return TRUE;
+    }
+
+    case WM_COMMAND:
+        if (LOWORD(wp) == IDC_UL_STOP || LOWORD(wp) == IDCANCEL)
+        {
+            st->stopped = TRUE;
+            EndDialog(hwnd, 0);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+static BOOL update_links(IOleUILinkContainerW *cntr, HWND parent, const WCHAR *title, int links)
+{
+    struct ul_state st = {0};
+    HRSRC rsrc;
+    HGLOBAL res;
+    const DLGTEMPLATE *tmpl;
+
+    if (!cntr || bad_container(cntr)) return FALSE;
+    st.cntr = cntr;
+    st.title = title;
+    st.total = links;
+    if (!(rsrc = FindResourceW(OLEDLG_hInstance, MAKEINTRESOURCEW(IDD_UPDATELINKS), (LPCWSTR)RT_DIALOG)) ||
+        !(res = LoadResource(OLEDLG_hInstance, rsrc)) || !(tmpl = LockResource(res)))
+        return FALSE;
+    if (DialogBoxIndirectParamW(OLEDLG_hInstance, tmpl, parent, ul_proc, (LPARAM)&st) == -1) return FALSE;
+    return !st.failed && !st.stopped;
+}
+
+/***********************************************************************
+ *           OleUIUpdateLinksW (OLEDLG.23)
+ */
+BOOL WINAPI OleUIUpdateLinksW(LPOLEUILINKCONTAINERW cntr, HWND parent, LPWSTR title, INT links)
+{
+    TRACE("(%p, %p, %s, %d)\n", cntr, parent, debugstr_w(title), links);
+    return update_links(cntr, parent, title, links);
+}
+
+/***********************************************************************
+ *           OleUIUpdateLinksA (OLEDLG.9)
+ */
+BOOL WINAPI OleUIUpdateLinksA(LPOLEUILINKCONTAINERA cntr, HWND parent, LPSTR title, INT links)
+{
+    IOleUILinkInfoW *w;
+    WCHAR *titlew;
+    BOOL ret;
+
+    TRACE("(%p, %p, %s, %d)\n", cntr, parent, debugstr_a(title), links);
+
+    if (!cntr || IsBadReadPtr(cntr, sizeof(void *)) || IsBadReadPtr(cntr->lpVtbl, sizeof(*cntr->lpVtbl))) return FALSE;
+    if (!(w = oleui_link_adapter((IOleUILinkInfoA *)cntr))) return FALSE;
+    titlew = oleui_strdupAtoW(title);
+    ret = update_links((IOleUILinkContainerW *)w, parent, titlew, links);
+    free(titlew);
+    oleui_link_adapter_free(w);
+    return ret;
+}
