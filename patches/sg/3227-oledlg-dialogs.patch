+
+/* an ANSI string the container allocated, as a wide string for the dialog; the
+ * original is freed */
+static WCHAR *take_a2w(char *str)
+{
+    WCHAR *ret = NULL;
+    int len;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar(CP_ACP, 0, str, -1, NULL, 0);
+    if ((ret = CoTaskMemAlloc(len * sizeof(WCHAR)))) MultiByteToWideChar(CP_ACP, 0, str, -1, ret, len);
+    CoTaskMemFree(str);
+    return ret;
+}
+
+static int a_len_for_w(const WCHAR *str, ULONG wlen)
+{
+    return WideCharToMultiByte(CP_ACP, 0, str, wlen, NULL, 0, NULL, NULL);
+}
+
+struct link_adapter
+{
+    IOleUILinkInfoW iface;
+    IOleUILinkInfoA *a;
+};
+
+static struct link_adapter *impl_from_link(IOleUILinkInfoW *iface)
+{
+    return CONTAINING_RECORD(iface, struct link_adapter, iface);
+}
+
+static HRESULT WINAPI link_QueryInterface(IOleUILinkInfoW *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI link_AddRef(IOleUILinkInfoW *iface) { return 2; }
+static ULONG WINAPI link_Release(IOleUILinkInfoW *iface) { return 1; }
+
+static DWORD WINAPI link_GetNextLink(IOleUILinkInfoW *iface, DWORD link)
+{
+    return IOleUILinkContainer_GetNextLink((IOleUILinkContainerA *)impl_from_link(iface)->a, link);
+}
+
+static HRESULT WINAPI link_SetLinkUpdateOptions(IOleUILinkInfoW *iface, DWORD link, DWORD opt)
+{
+    return IOleUILinkContainer_SetLinkUpdateOptions((IOleUILinkContainerA *)impl_from_link(iface)->a, link, opt);
+}
+
+static HRESULT WINAPI link_GetLinkUpdateOptions(IOleUILinkInfoW *iface, DWORD link, DWORD *opt)
+{
+    return IOleUILinkContainer_GetLinkUpdateOptions((IOleUILinkContainerA *)impl_from_link(iface)->a, link, opt);
+}
+
+static HRESULT WINAPI link_SetLinkSource(IOleUILinkInfoW *iface, DWORD link, LPWSTR name, ULONG file_len,
+                                         ULONG *eaten, BOOL validate)
+{
+    IOleUILinkContainerA *a = (IOleUILinkContainerA *)impl_from_link(iface)->a;
+    char *str = oleui_strdupWtoA(name);
+    ULONG eaten_a = 0;
+    HRESULT hr;
+
+    if (!str) return E_OUTOFMEMORY;
+    hr = IOleUILinkContainer_SetLinkSource(a, link, str, a_len_for_w(name, file_len), &eaten_a, validate);
+    if (eaten) *eaten = MultiByteToWideChar(CP_ACP, 0, str, eaten_a, NULL, 0);
+    free(str);
+    return hr;
+}
+
+static HRESULT WINAPI link_GetLinkSource(IOleUILinkInfoW *iface, DWORD link, LPWSTR *name, ULONG *file_len,
+                                         LPWSTR *full_type, LPWSTR *short_type, BOOL *available, BOOL *selected)
+{
+    IOleUILinkContainerA *a = (IOleUILinkContainerA *)impl_from_link(iface)->a;
+    char *name_a = NULL, *full_a = NULL, *short_a = NULL;
+    ULONG len_a = 0;
+    HRESULT hr;
+
+    hr = IOleUILinkContainer_GetLinkSource(a, link, name ? &name_a : NULL, &len_a, full_type ? &full_a : NULL,
+                                           short_type ? &short_a : NULL, available, selected);
+    if (name) *name = take_a2w(name_a);
+    if (full_type) *full_type = take_a2w(full_a);
+    if (short_type) *short_type = take_a2w(short_a);
+    if (file_len)
+    {
+        /* the length counted in characters of the converted string */
+        *file_len = len_a;
+        if (name_a && SUCCEEDED(hr)) *file_len = MultiByteToWideChar(CP_ACP, 0, name_a, len_a, NULL, 0);
+    }
+    return hr;
+}
+
+static HRESULT WINAPI link_OpenLinkSource(IOleUILinkInfoW *iface, DWORD link)
+{
+    return IOleUILinkContainer_OpenLinkSource((IOleUILinkContainerA *)impl_from_link(iface)->a, link);
+}
+
+static HRESULT WINAPI link_UpdateLink(IOleUILinkInfoW *iface, DWORD link, BOOL msg, BOOL reserved)
+{
+    return IOleUILinkContainer_UpdateLink((IOleUILinkContainerA *)impl_from_link(iface)->a, link, msg, reserved);
+}
+
+static HRESULT WINAPI link_CancelLink(IOleUILinkInfoW *iface, DWORD link)
+{
+    return IOleUILinkContainer_CancelLink((IOleUILinkContainerA *)impl_from_link(iface)->a, link);
+}
+
+static HRESULT WINAPI link_GetLastUpdate(IOleUILinkInfoW *iface, DWORD link, FILETIME *time)
+{
+    return IOleUILinkInfo_GetLastUpdate(impl_from_link(iface)->a, link, time);
+}
+
+static const IOleUILinkInfoWVtbl link_vtbl =
+{
+    link_QueryInterface,
+    link_AddRef,
+    link_Release,
+    link_GetNextLink,
+    link_SetLinkUpdateOptions,
+    link_GetLinkUpdateOptions,
+    link_SetLinkSource,
+    link_GetLinkSource,
+    link_OpenLinkSource,
+    link_UpdateLink,
+    link_CancelLink,
+    link_GetLastUpdate,
+};
+
+/* A is an IOleUILinkInfoA, or an IOleUILinkContainerA when GetLastUpdate is never called */
+IOleUILinkInfoW *oleui_link_adapter(IOleUILinkInfoA *a)
+{
+    struct link_adapter *ad;
+
+    if (!a) return NULL;
+    if (!(ad = calloc(1, sizeof(*ad)))) return NULL;
+    ad->iface.lpVtbl = &link_vtbl;
+    ad->a = a;
+    return &ad->iface;
+}
+
+void oleui_link_adapter_free(IOleUILinkInfoW *w)
+{
+    if (w) free(impl_from_link(w));
+}
+
+struct obj_adapter
+{
+    IOleUIObjInfoW iface;
+    IOleUIObjInfoA *a;
+};
+
+static struct obj_adapter *impl_from_obj(IOleUIObjInfoW *iface)
+{
+    return CONTAINING_RECORD(iface, struct obj_adapter, iface);
+}
+
+static HRESULT WINAPI obj_QueryInterface(IOleUIObjInfoW *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI obj_AddRef(IOleUIObjInfoW *iface) { return 2; }
+static ULONG WINAPI obj_Release(IOleUIObjInfoW *iface) { return 1; }
+
+static HRESULT WINAPI obj_GetObjectInfo(IOleUIObjInfoW *iface, DWORD obj, DWORD *size, LPWSTR *label,
+                                        LPWSTR *type, LPWSTR *short_type, LPWSTR *location)
+{
+    char *label_a = NULL, *type_a = NULL, *short_a = NULL, *loc_a = NULL;
+    HRESULT hr;
+
+    hr = IOleUIObjInfo_GetObjectInfo(impl_from_obj(iface)->a, obj, size, label ? &label_a : NULL,
+                                     type ? &type_a : NULL, short_type ? &short_a : NULL,
+                                     location ? &loc_a : NULL);
+    if (label) *label = take_a2w(label_a);
+    if (type) *type = take_a2w(type_a);
+    if (short_type) *short_type = take_a2w(short_a);
+    if (location) *location = take_a2w(loc_a);
+    return hr;
+}
+
+static HRESULT WINAPI obj_GetConvertInfo(IOleUIObjInfoW *iface, DWORD obj, CLSID *clsid, WORD *format,
+                                         CLSID *convert_default, LPCLSID *exclude, UINT *exclude_count)
+{
+    return IOleUIObjInfo_GetConvertInfo(impl_from_obj(iface)->a, obj, clsid, format, convert_default,
+                                        exclude, exclude_count);
+}
+
+static HRESULT WINAPI obj_ConvertObject(IOleUIObjInfoW *iface, DWORD obj, REFCLSID clsid)
+{
+    return IOleUIObjInfo_ConvertObject(impl_from_obj(iface)->a, obj, clsid);
+}
+
+static HRESULT WINAPI obj_GetViewInfo(IOleUIObjInfoW *iface, DWORD obj, HGLOBAL *meta, DWORD *aspect, INT *scale)
+{
+    return IOleUIObjInfo_GetViewInfo(impl_from_obj(iface)->a, obj, meta, aspect, scale);
+}
+
+static HRESULT WINAPI obj_SetViewInfo(IOleUIObjInfoW *iface, DWORD obj, HGLOBAL meta, DWORD aspect, INT scale,
+                                      BOOL relative)
+{
+    return IOleUIObjInfo_SetViewInfo(impl_from_obj(iface)->a, obj, meta, aspect, scale, relative);
+}
+
+static const IOleUIObjInfoWVtbl obj_vtbl =
+{
+    obj_QueryInterface,
+    obj_AddRef,
+    obj_Release,
+    obj_GetObjectInfo,
+    obj_GetConvertInfo,
+    obj_ConvertObject,
+    obj_GetViewInfo,
+    obj_SetViewInfo,
+};
+
+IOleUIObjInfoW *oleui_obj_adapter(IOleUIObjInfoA *a)
+{
+    struct obj_adapter *ad;
+
+    if (!a) return NULL;
+    if (!(ad = calloc(1, sizeof(*ad)))) return NULL;
+    ad->iface.lpVtbl = &obj_vtbl;
+    ad->a = a;
+    return &ad->iface;
+}
+
+void oleui_obj_adapter_free(IOleUIObjInfoW *w)
+{
+    if (w) free(impl_from_obj(w));
+}
diff --git a/dlls/oledlg/busy.c b/dlls/oledlg/busy.c
