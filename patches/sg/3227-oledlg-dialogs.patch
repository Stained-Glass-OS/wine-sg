+
+static void op_free_strings(struct op_state *st)
+{
+    CoTaskMemFree(st->label);
+    CoTaskMemFree(st->type);
+    CoTaskMemFree(st->short_type);
+    CoTaskMemFree(st->location);
+    st->label = st->type = st->short_type = st->location = NULL;
+}
+
+static void op_help(HWND page, struct op_state *st, UINT id)
+{
+    HWND parent = GetParent(page);
+    HWND owner = st->op->lpPS ? st->op->lpPS->hwndParent : NULL;
+
+    if (!owner) owner = parent;
+    SendMessageW(owner, oleui_msg_help, (WPARAM)page, MAKELPARAM(id, 0));
+}
+
+/***********************************************************************
+ *  General page
+ */
+static void gp_fill(HWND hwnd, struct op_state *st)
+{
+    OLEUIOBJECTPROPSW *op = st->op;
+    WCHAR text[64], unknown[32];
+    HICON icon = NULL;
+
+    LoadStringW(OLEDLG_hInstance, IDS_OP_UNKNOWN, unknown, ARRAY_SIZE(unknown));
+    op_free_strings(st);
+    st->size = (DWORD)-1;
+    if (!(op->dwFlags & OPF_NOFILLDEFAULT))
+        IOleUIObjInfo_GetObjectInfo(op->lpObjInfo, op->dwObject, &st->size, &st->label, &st->type,
+                                    &st->short_type, &st->location);
+
+    SetDlgItemTextW(hwnd, IDC_GP_OBJECTNAME, st->label ? st->label : L"");
+    SetDlgItemTextW(hwnd, IDC_GP_OBJECTTYPE, st->type ? st->type : unknown);
+    if (st->size == (DWORD)-1) lstrcpyW(text, unknown);
+    else
+    {
+        WCHAR fmt[32];
+        LoadStringW(OLEDLG_hInstance, IDS_OP_SIZE, fmt, ARRAY_SIZE(fmt));
+#ifdef SG_MUTANT_OLEDLG_OPSIZE
+        wsprintfW(text, fmt, st->size / 1024);
+#else
+        wsprintfW(text, fmt, (st->size + 1023) / 1024);
+#endif
+    }
+    SetDlgItemTextW(hwnd, IDC_GP_OBJECTSIZE, text);
+    SetDlgItemTextW(hwnd, IDC_GP_OBJECTLOCATION, st->location ? st->location : L"");
+
+    if (st->meta) icon = oleui_metapict_icon(st->meta, NULL, 0, NULL, NULL, 0);
+    if (!icon) icon = CopyIcon(LoadIconW(NULL, (LPCWSTR)IDI_APPLICATION));
+    icon = (HICON)SendDlgItemMessageW(hwnd, IDC_GP_OBJECTICON, STM_SETICON, (WPARAM)icon, 0);
+    if (icon) DestroyIcon(icon);
+}
+
+static void gp_convert(HWND hwnd, struct op_state *st)
+{
+    OLEUIOBJECTPROPSW *op = st->op;
+    OLEUICONVERTW cv = {0};
+    CLSID clsid, def = {0};
+    CLSID *exclude = NULL;
+    UINT exclude_count = 0;
+    WORD format = 0;
+
+    if (FAILED(IOleUIObjInfo_GetConvertInfo(op->lpObjInfo, op->dwObject, &clsid, &format, &def, &exclude,
+                                            &exclude_count)))
+        return;
+    cv.cbStruct = sizeof(cv);
+    cv.dwFlags = CF_CONVERTONLY | (op->dwFlags & OPF_SHOWHELP ? CF_SHOWHELPBUTTON : 0);
+    cv.hWndOwner = GetParent(hwnd);
+    cv.clsid = clsid;
+    if (!IsEqualGUID(&def, &GUID_NULL))
+    {
+        cv.dwFlags |= CF_SETCONVERTDEFAULT;
+        cv.clsidConvertDefault = def;
+    }
+    cv.wFormat = format;
+    cv.dvAspect = DVASPECT_CONTENT;
+    cv.lpClsidExclude = exclude;
+    cv.cClsidExclude = exclude_count;
+    cv.lpszUserType = st->type ? oleui_cotaskdup(st->type) : NULL;
+    if (OleUIConvertW(&cv) == OLEUI_OK && !IsEqualGUID(&cv.clsidNew, &clsid))
+    {
+        if (SUCCEEDED(IOleUIObjInfo_ConvertObject(op->lpObjInfo, op->dwObject, &cv.clsidNew)))
+            gp_fill(hwnd, st);
+    }
+    CoTaskMemFree(exclude);
+}
+
+static INT_PTR CALLBACK gp_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct op_state *st = (struct op_state *)GetWindowLongPtrW(hwnd, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        OLEUIGNRLPROPSW *gp;
+        BOOL can_convert = FALSE;
+        CLSID clsid;
+        WORD format;
+        CLSID def;
+
+        st = (struct op_state *)((PROPSHEETPAGEW *)lp)->lParam;
+        SetWindowLongPtrW(hwnd, DWLP_USER, (LONG_PTR)st);
+        st->page_general = hwnd;
+        gp = st->op->lpGP;
+        gp_fill(hwnd, st);
+        if (!(st->op->dwFlags & OPF_SHOWHELP)) ShowWindow(GetDlgItem(hwnd, IDC_OLEUIHELP), SW_HIDE);
+        if (!(st->op->dwFlags & OPF_DISABLECONVERT))
+        {
+            CLSID *exclude = NULL;
+            UINT count = 0;
+            if (SUCCEEDED(IOleUIObjInfo_GetConvertInfo(st->op->lpObjInfo, st->op->dwObject, &clsid, &format, &def,
+                                                       &exclude, &count)))
+                can_convert = TRUE;
+            CoTaskMemFree(exclude);
+        }
+        EnableWindow(GetDlgItem(hwnd, IDC_GP_CONVERT), can_convert);
+        if (gp && gp->lpfnHook) gp->lpfnHook(hwnd, msg, wp, (LPARAM)gp);
+        return TRUE;
+    }
+
+    case WM_COMMAND:
+        if (!st) break;
+        if (LOWORD(wp) == IDC_GP_CONVERT && HIWORD(wp) == BN_CLICKED) { gp_convert(hwnd, st); return TRUE; }
+        if (LOWORD(wp) == IDC_OLEUIHELP) { op_help(hwnd, st, IDD_GNRLPROPS); return TRUE; }
+        break;
+    }
+    return FALSE;
+}
+
+/***********************************************************************
+ *  View page
+ */
+static void vp_show(HWND hwnd, struct op_state *st)
+{
+    OLEUIVIEWPROPSW *vp = st->op->lpVP;
+    BOOL icon = st->aspect == DVASPECT_ICON;
+    BOOL scale = !(vp->dwFlags & VPF_DISABLESCALE);
+
+    CheckRadioButton(hwnd, IDC_VP_EDITABLE, IDC_VP_ASICON, icon ? IDC_VP_ASICON : IDC_VP_EDITABLE);
+    EnableWindow(GetDlgItem(hwnd, IDC_VP_CHANGEICON), icon);
+    EnableWindow(GetDlgItem(hwnd, IDC_VP_PERCENT), scale);
+    EnableWindow(GetDlgItem(hwnd, IDC_VP_SPIN), scale);
+    EnableWindow(GetDlgItem(hwnd, IDC_VP_SCALETXT), scale);
+    EnableWindow(GetDlgItem(hwnd, IDC_VP_RELATIVE), scale && !(vp->dwFlags & VPF_DISABLERELATIVE));
+    ShowWindow(GetDlgItem(hwnd, IDC_VP_ICONDISPLAY), icon ? SW_SHOW : SW_HIDE);
+    SendDlgItemMessageW(hwnd, IDC_VP_ICONDISPLAY, IBXM_IMAGESET, (WPARAM)st->meta, 0);
+}
+
+static int vp_scale(HWND hwnd, struct op_state *st)
+{
+    OLEUIVIEWPROPSW *vp = st->op->lpVP;
+    BOOL ok;
+    int value = GetDlgItemInt(hwnd, IDC_VP_PERCENT, &ok, FALSE);
+
+    if (!ok) value = st->scale;
+    if (vp->nScaleMax > vp->nScaleMin) value = max(vp->nScaleMin, min(vp->nScaleMax, value));
+    return value;
+}
+
+static INT_PTR CALLBACK vp_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct op_state *st = (struct op_state *)GetWindowLongPtrW(hwnd, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        OLEUIVIEWPROPSW *vp;
+
+        st = (struct op_state *)((PROPSHEETPAGEW *)lp)->lParam;
+        SetWindowLongPtrW(hwnd, DWLP_USER, (LONG_PTR)st);
+        st->page_view = hwnd;
+        vp = st->op->lpVP;
+        if (!(st->op->dwFlags & OPF_SHOWHELP)) ShowWindow(GetDlgItem(hwnd, IDC_OLEUIHELP), SW_HIDE);
+        if (vp->nScaleMax > vp->nScaleMin)
+            SendDlgItemMessageW(hwnd, IDC_VP_SPIN, UDM_SETRANGE32, vp->nScaleMin, vp->nScaleMax);
+        SendDlgItemMessageW(hwnd, IDC_VP_SPIN, UDM_SETBUDDY, (WPARAM)GetDlgItem(hwnd, IDC_VP_PERCENT), 0);
+        SetDlgItemInt(hwnd, IDC_VP_PERCENT, st->scale, FALSE);
+        CheckDlgButton(hwnd, IDC_VP_RELATIVE, (vp->dwFlags & VPF_SELECTRELATIVE) ? BST_CHECKED : BST_UNCHECKED);
+        vp_show(hwnd, st);
+        return TRUE;
+    }
+
+    case WM_COMMAND:
+        if (!st) break;
+        switch (LOWORD(wp))
+        {
+        case IDC_VP_EDITABLE:
+        case IDC_VP_ASICON:
+            if (HIWORD(wp) == BN_CLICKED)
+            {
+                st->aspect = LOWORD(wp) == IDC_VP_ASICON ? DVASPECT_ICON : DVASPECT_CONTENT;
+                st->view_dirty = TRUE;
+                vp_show(hwnd, st);
+                SendMessageW(GetParent(hwnd), PSM_CHANGED, (WPARAM)hwnd, 0);
+            }
+            return TRUE;
+        case IDC_VP_PERCENT:
+            if (HIWORD(wp) == EN_CHANGE)
+            {
+                st->view_dirty = TRUE;
+                SendMessageW(GetParent(hwnd), PSM_CHANGED, (WPARAM)hwnd, 0);
+            }
+            return TRUE;
+        case IDC_VP_RELATIVE:
+            st->view_dirty = TRUE;
+            SendMessageW(GetParent(hwnd), PSM_CHANGED, (WPARAM)hwnd, 0);
+            return TRUE;
+        case IDC_VP_CHANGEICON:
+        {
+            OLEUICHANGEICONW ci = {0};
+            CLSID *exclude = NULL, def;
+            UINT count = 0;
+            WORD format;
+
+            if (FAILED(IOleUIObjInfo_GetConvertInfo(st->op->lpObjInfo, st->op->dwObject, &ci.clsid, &format, &def,
+                                                    &exclude, &count)))
+                memset(&ci.clsid, 0, sizeof(ci.clsid));
+            CoTaskMemFree(exclude);
+            ci.cbStruct = sizeof(ci);
+            ci.dwFlags = CIF_SELECTCURRENT | (st->op->dwFlags & OPF_SHOWHELP ? CIF_SHOWHELP : 0);
+            ci.hWndOwner = GetParent(hwnd);
+            if (!st->meta) st->meta = OleGetIconOfClass(&ci.clsid, NULL, TRUE);
+            ci.hMetaPict = oleui_metapict_copy(st->meta);
+            if (IsEqualGUID(&ci.clsid, &GUID_NULL)) ci.dwFlags |= CIF_USEICONEXE;
+            if (OleUIChangeIconW(&ci) == OLEUI_OK)
+            {
+                oleui_metapict_free(st->meta);
+                st->meta = ci.hMetaPict;
+                st->view_dirty = TRUE;
+                vp_show(hwnd, st);
+                SendMessageW(GetParent(hwnd), PSM_CHANGED, (WPARAM)hwnd, 0);
+            }
+            else oleui_metapict_free(ci.hMetaPict);
+            return TRUE;
+        }
+        case IDC_OLEUIHELP:
+            op_help(hwnd, st, IDD_VIEWPROPS);
+            return TRUE;
+        }
+        break;
+
+    case WM_NOTIFY:
+#ifdef SG_MUTANT_OLEDLG_OPVIEW
+        if (FALSE)
+#else
+        if (st && ((NMHDR *)lp)->code == PSN_APPLY && st->view_dirty)
+#endif
+        {
+            BOOL relative = IsDlgButtonChecked(hwnd, IDC_VP_RELATIVE) == BST_CHECKED;
+            int scale = vp_scale(hwnd, st);
+
+            if (SUCCEEDED(IOleUIObjInfo_SetViewInfo(st->op->lpObjInfo, st->op->dwObject, st->meta, st->aspect,
+                                                    scale, relative)))
+            {
+                st->scale = scale;
+                st->view_dirty = FALSE;
+                st->op->lpVP->dwFlags = (st->op->lpVP->dwFlags & ~VPF_SELECTRELATIVE) |
+                                        (relative ? VPF_SELECTRELATIVE : 0);
+            }
+        }
+        break;
+    }
+    return FALSE;
+}
+
+/***********************************************************************
+ *  Link page
+ */
+static void lp_fill(HWND hwnd, struct op_state *st)
+{
+    OLEUIOBJECTPROPSW *op = st->op;
+    WCHAR *name = NULL, *full = NULL, *short_type = NULL, *shown;
+    ULONG file_len = 0;
+    BOOL available = TRUE, selected;
+    FILETIME ft;
+    SYSTEMTIME sys;
+    WCHAR text[100], unknown[32];
+    HRESULT hr;
+
+    LoadStringW(OLEDLG_hInstance, IDS_OP_UNKNOWN, unknown, ARRAY_SIZE(unknown));
+    hr = IOleUILinkInfo_GetLinkSource(op->lpLinkInfo, op->dwLink, &name, &file_len, &full, &short_type,
+                                      &available, &selected);
+    if (SUCCEEDED(hr) && name)
+    {
+        /* the file name on the first line, the item on the second */
+        ULONG len = lstrlenW(name);
+        if (file_len > len) file_len = len;
+        shown = malloc((len + 3) * sizeof(WCHAR));
+        if (shown)
+        {
+            const WCHAR *item = name + file_len;
+
+            memcpy(shown, name, file_len * sizeof(WCHAR));
+            shown[file_len] = 0;
+            if (*item == '!') item++;
+            if (*item) { lstrcatW(shown, L"\r\n"); lstrcatW(shown, item); }
+            SetDlgItemTextW(hwnd, IDC_LP_LINKSOURCE, shown);
+            free(shown);
+        }
+    }
+    else SetDlgItemTextW(hwnd, IDC_LP_LINKSOURCE, unknown);
+    CoTaskMemFree(name);
+    CoTaskMemFree(full);
+    CoTaskMemFree(short_type);
+
+    EnableWindow(GetDlgItem(hwnd, IDC_LP_OPENSOURCE), available);
+    EnableWindow(GetDlgItem(hwnd, IDC_LP_UPDATENOW), available);
+
+    /* what the user chose and did not apply yet stays */
+    if (!st->update_dirty &&
+        FAILED(IOleUILinkContainer_GetLinkUpdateOptions((IOleUILinkContainerW *)op->lpLinkInfo, op->dwLink, &st->update)))
+        st->update = UPDATE_ONCALL;
+    CheckRadioButton(hwnd, IDC_LP_AUTOMATIC, IDC_LP_MANUAL, st->update == UPDATE_ALWAYS ? IDC_LP_AUTOMATIC : IDC_LP_MANUAL);
+
+    memset(&ft, 0, sizeof(ft));
+    if (SUCCEEDED(IOleUILinkInfo_GetLastUpdate(op->lpLinkInfo, op->dwLink, &ft)) && (ft.dwLowDateTime || ft.dwHighDateTime))
+    {
+        FILETIME local;
+        FileTimeToLocalFileTime(&ft, &local);
+        FileTimeToSystemTime(&local, &sys);
+        GetDateFormatW(LOCALE_USER_DEFAULT, DATE_SHORTDATE, &sys, NULL, text, ARRAY_SIZE(text));
+        SetDlgItemTextW(hwnd, IDC_LP_DATE, text);
+        GetTimeFormatW(LOCALE_USER_DEFAULT, 0, &sys, NULL, text, ARRAY_SIZE(text));
+        SetDlgItemTextW(hwnd, IDC_LP_TIME, text);
+    }
+    else
+    {
+        SetDlgItemTextW(hwnd, IDC_LP_DATE, unknown);
+        SetDlgItemTextW(hwnd, IDC_LP_TIME, L"");
+    }
+}
+
+static void lp_changed(HWND hwnd)
+{
+    SendMessageW(GetParent(hwnd), PSM_CHANGED, (WPARAM)hwnd, 0);
+}
+
+static INT_PTR CALLBACK lp_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct op_state *st = (struct op_state *)GetWindowLongPtrW(hwnd, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        st = (struct op_state *)((PROPSHEETPAGEW *)lp)->lParam;
+        SetWindowLongPtrW(hwnd, DWLP_USER, (LONG_PTR)st);
+        st->page_link = hwnd;
+        if (!(st->op->dwFlags & OPF_SHOWHELP)) ShowWindow(GetDlgItem(hwnd, IDC_OLEUIHELP), SW_HIDE);
+        lp_fill(hwnd, st);
+        return TRUE;
+    }
+
+    case WM_COMMAND:
+        if (!st) break;
+        switch (LOWORD(wp))
+        {
+        case IDC_LP_AUTOMATIC:
+        case IDC_LP_MANUAL:
+            if (HIWORD(wp) == BN_CLICKED)
+            {
+                st->update = LOWORD(wp) == IDC_LP_AUTOMATIC ? UPDATE_ALWAYS : UPDATE_ONCALL;
+                st->update_dirty = TRUE;
+                lp_changed(hwnd);
+            }
+            return TRUE;
+        case IDC_LP_OPENSOURCE:
+            IOleUILinkContainer_OpenLinkSource((IOleUILinkContainerW *)st->op->lpLinkInfo, st->op->dwLink);
+            return TRUE;
+        case IDC_LP_UPDATENOW:
+            IOleUILinkContainer_UpdateLink((IOleUILinkContainerW *)st->op->lpLinkInfo, st->op->dwLink, TRUE, FALSE);
+            lp_fill(hwnd, st);
+            return TRUE;
+        case IDC_LP_BREAKLINK:
+            if (SUCCEEDED(IOleUILinkContainer_CancelLink((IOleUILinkContainerW *)st->op->lpLinkInfo, st->op->dwLink)))
+            {
+                int id;
+
+                st->link_broken = TRUE;
+                for (id = IDC_LP_OPENSOURCE; id <= IDC_LP_MANUAL; id++)
+                    EnableWindow(GetDlgItem(hwnd, id), FALSE);
+                EnableWindow(GetDlgItem(hwnd, IDC_LP_CHANGESOURCE), FALSE);
+            }
+            return TRUE;
+        case IDC_LP_CHANGESOURCE:
+        {
+            OLEUICHANGESOURCEW cs = {0};
+            WCHAR *name = NULL, *full = NULL, *short_type = NULL;
+            ULONG len = 0;
+            BOOL available, selected;
+
+            if (FAILED(IOleUILinkInfo_GetLinkSource(st->op->lpLinkInfo, st->op->dwLink, &name, &len, &full,
+                                                    &short_type, &available, &selected)))
+                return TRUE;
+            CoTaskMemFree(full);
+            CoTaskMemFree(short_type);
+            cs.cbStruct = sizeof(cs);
+            cs.hWndOwner = GetParent(hwnd);
+            cs.dwFlags = st->op->dwFlags & OPF_SHOWHELP ? CSF_SHOWHELP : 0;
+            cs.lpOleUILinkContainer = (IOleUILinkContainerW *)st->op->lpLinkInfo;
+            cs.dwLink = st->op->dwLink;
+            cs.lpszDisplayName = name;
+            cs.nFileLength = len;
+            if (OleUIChangeSourceW(&cs) == OLEUI_OK)
+            {
+                ULONG eaten = 0;
+                if (!(cs.dwFlags & CSF_VALIDSOURCE) && cs.lpszDisplayName)
+                    IOleUILinkContainer_SetLinkSource((IOleUILinkContainerW *)st->op->lpLinkInfo, st->op->dwLink,
+                                                      cs.lpszDisplayName, cs.nFileLength, &eaten, FALSE);
+                lp_fill(hwnd, st);
+            }
+            if (cs.lpszDisplayName != name) CoTaskMemFree(cs.lpszDisplayName);
+            CoTaskMemFree(name);
+            CoTaskMemFree(cs.lpszFrom);
+            CoTaskMemFree(cs.lpszTo);
+            return TRUE;
+        }
+        case IDC_OLEUIHELP:
+            op_help(hwnd, st, IDD_LINKPROPS);
+            return TRUE;
+        }
+        break;
+
+    case WM_NOTIFY:
+#ifdef SG_MUTANT_OLEDLG_OPLINK
+        if (FALSE)
+#else
+        if (st && ((NMHDR *)lp)->code == PSN_APPLY && st->update_dirty && !st->link_broken)
+#endif
+        {
+            if (SUCCEEDED(IOleUILinkContainer_SetLinkUpdateOptions((IOleUILinkContainerW *)st->op->lpLinkInfo,
+                                                                   st->op->dwLink, st->update)))
+                st->update_dirty = FALSE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+/***********************************************************************
+ *  The sheet
+ */
+#define MAX_PAGES 64
+
+static HPROPSHEETPAGE make_page(UINT id, DLGPROC proc, struct op_state *st)
+{
+    PROPSHEETPAGEW psp = {0};
+
+    psp.dwSize = sizeof(psp);
+    psp.dwFlags = PSP_DEFAULT;
+    psp.hInstance = OLEDLG_hInstance;
+    psp.pszTemplate = MAKEINTRESOURCEW(id);
+    psp.pfnDlgProc = proc;
+    psp.lParam = (LPARAM)st;
+    return CreatePropertySheetPageW(&psp);
+}
+
+static BOOL bad_iface(const void *iface)
+{
+    return !iface || IsBadReadPtr(iface, sizeof(void *)) || IsBadReadPtr(*(void **)iface, 3 * sizeof(void *));
+}
+
+/* the pages the caller put in the header, as page handles */
+static UINT caller_pages(const PROPSHEETHEADERW *h, BOOL ansi, HPROPSHEETPAGE *out, UINT max)
+{
+    UINT i, n = 0;
+
+    if (h->dwFlags & PSH_PROPSHEETPAGE)
+    {
+        const BYTE *p = (const BYTE *)h->ppsp;
+
+        for (i = 0; i < h->nPages && n < max; i++)
+        {
+            const PROPSHEETPAGEW *page = (const PROPSHEETPAGEW *)p;
+            HPROPSHEETPAGE hp = ansi ? CreatePropertySheetPageA((LPCPROPSHEETPAGEA)page) : CreatePropertySheetPageW(page);
+
+            if (hp) out[n++] = hp;
+            p += page->dwSize;
+        }
+    }
+    else
+    {
+        for (i = 0; i < h->nPages && n < max; i++) out[n++] = h->phpage[i];
+    }
+    return n;
+}
+
+static UINT object_properties(OLEUIOBJECTPROPSW *op, void *app, BOOL ansi_pages)
+{
+    struct op_state st = {0};
+    PROPSHEETHEADERW header;
+    HPROPSHEETPAGE pages[MAX_PAGES];
+    INITCOMMONCONTROLSEX icc;
+    UINT ret = OLEUI_OK, n = 0;
+    INT_PTR result;
+    BOOL is_link;
+
+    if (!op) return OLEUI_ERR_STRUCTURENULL;
+    if (IsBadWritePtr(op, sizeof(*op))) return OLEUI_ERR_STRUCTUREINVALID;
+    if (op->cbStruct != sizeof(*op)) return OLEUI_ERR_CBSTRUCTINCORRECT;
+    is_link = (op->dwFlags & OPF_OBJECTISLINK) != 0;
+
+    if (!op->lpPS) return OLEUI_OPERR_PROPSHEETNULL;
+    if (IsBadWritePtr(op->lpPS, sizeof(*op->lpPS))) return OLEUI_OPERR_PROPSHEETINVALID;
+    if (op->lpPS->dwSize != sizeof(PROPSHEETHEADERW)) return OLEUI_OPERR_PROPERTYSHEET;
+    if (!op->lpGP || !op->lpVP || (is_link && !op->lpLP)) return OLEUI_OPERR_SUBPROPNULL;
+    if (IsBadWritePtr(op->lpGP, sizeof(*op->lpGP)) || IsBadWritePtr(op->lpVP, sizeof(*op->lpVP)))
+        return OLEUI_OPERR_SUBPROPINVALID;
+    if (is_link && IsBadWritePtr(op->lpLP, sizeof(*op->lpLP))) return OLEUI_OPERR_PROPSINVALID;
+    if (op->lpGP->cbStruct != sizeof(*op->lpGP) || op->lpVP->cbStruct != sizeof(*op->lpVP) ||
+        (is_link && op->lpLP->cbStruct != sizeof(*op->lpLP)))
+        return OLEUI_ERR_CBSTRUCTINCORRECT;
+    if (bad_iface(op->lpObjInfo)) return OLEUI_OPERR_OBJINFOINVALID;
+    if (is_link && bad_iface(op->lpLinkInfo)) return OLEUI_OPERR_LINKINFOINVALID;
+    if (op->lpPS->nPages && !((op->lpPS->dwFlags & PSH_PROPSHEETPAGE) ? (const void *)op->lpPS->ppsp : (const void *)op->lpPS->phpage))
+        return OLEUI_OPERR_INVALIDPAGES;
+
+    st.op = op;
+    op->lpGP->lpOP = op;
+    op->lpVP->lpOP = op;
+    if (is_link) op->lpLP->lpOP = op;
+
+    /* the object's view as the pages start from */
+    st.scale = 100;
+    st.aspect = DVASPECT_CONTENT;
+    if (FAILED(IOleUIObjInfo_GetViewInfo(op->lpObjInfo, op->dwObject, &st.meta, &st.aspect, &st.scale)))
+        st.meta = NULL;
+    if (st.meta && (IsBadReadPtr(st.meta, 1) || !GlobalSize(st.meta))) return OLEUI_VPERR_METAPICTINVALID;
+    if (st.aspect != DVASPECT_CONTENT && st.aspect != DVASPECT_ICON) return OLEUI_VPERR_DVASPECTINVALID;
+
+    icc.dwSize = sizeof(icc);
+    icc.dwICC = ICC_UPDOWN_CLASS;
+    InitCommonControlsEx(&icc);
+
+    pages[n++] = make_page(IDD_GNRLPROPS, gp_proc, &st);
+    pages[n++] = make_page(IDD_VIEWPROPS, vp_proc, &st);
+    if (is_link) pages[n++] = make_page(IDD_LINKPROPS, lp_proc, &st);
+    if (!pages[0] || !pages[1] || (is_link && !pages[2])) ret = OLEUI_ERR_DIALOGFAILURE;
+    else
+    {
+        UINT own = n;
+
+        n += caller_pages(op->lpPS, ansi_pages, pages + n, MAX_PAGES - n);
+        header = *op->lpPS;
+        header.dwFlags &= ~PSH_PROPSHEETPAGE;
+        header.nPages = n;
+        header.phpage = pages;
+        if (!(header.dwFlags & PSH_USEPSTARTPAGE)) header.nStartPage += own;
+        if (!header.hwndParent) header.hwndParent = op->lpPS->hwndParent;
+
+        result = PropertySheetW(&header);
+        if (result < 0) ret = OLEUI_ERR_DIALOGFAILURE;
+        else ret = result > 0 ? OLEUI_OK : OLEUI_CANCEL;
+    }
+
+    op_free_strings(&st);
+    oleui_metapict_free(st.meta);
+    (void)app;
+    return ret;
+}
+
+/***********************************************************************
+ *           OleUIObjectPropertiesW (OLEDLG.21)
+ */
+UINT WINAPI OleUIObjectPropertiesW(LPOLEUIOBJECTPROPSW op)
+{
+    TRACE("(%p)\n", op);
+    return object_properties(op, op, FALSE);
+}
+
+/***********************************************************************
+ *           OleUIObjectPropertiesA (OLEDLG.11)
+ */
+UINT WINAPI OleUIObjectPropertiesA(LPOLEUIOBJECTPROPSA opa)
+{
+    OLEUIOBJECTPROPSW op;
+    PROPSHEETHEADERW header;
+    IOleUIObjInfoW *obj = NULL;
+    IOleUILinkInfoW *link = NULL;
+    WCHAR *caption = NULL, *icon = NULL, *start = NULL, *wm = NULL, *hdr = NULL;
+    UINT ret;
+
+    TRACE("(%p)\n", opa);
+
+    if (!opa) return OLEUI_ERR_STRUCTURENULL;
+    if (IsBadWritePtr(opa, sizeof(*opa))) return OLEUI_ERR_STRUCTUREINVALID;
+    if (opa->cbStruct != sizeof(*opa)) return OLEUI_ERR_CBSTRUCTINCORRECT;
+
+    memset(&op, 0, sizeof(op));
+    op.cbStruct = sizeof(op);
+    op.dwFlags = opa->dwFlags;
+    op.dwObject = opa->dwObject;
+    op.dwLink = opa->dwLink;
+    op.lpGP = (LPOLEUIGNRLPROPSW)opa->lpGP;
+    op.lpVP = (LPOLEUIVIEWPROPSW)opa->lpVP;
+    op.lpLP = (LPOLEUILINKPROPSW)opa->lpLP;
+    if (!bad_iface(opa->lpObjInfo)) op.lpObjInfo = obj = oleui_obj_adapter(opa->lpObjInfo);
+    else op.lpObjInfo = (LPOLEUIOBJINFOW)opa->lpObjInfo;
+    if (!bad_iface(opa->lpLinkInfo)) op.lpLinkInfo = link = oleui_link_adapter(opa->lpLinkInfo);
+    else op.lpLinkInfo = (LPOLEUILINKINFOW)opa->lpLinkInfo;
+
+    if (opa->lpPS && !IsBadWritePtr(opa->lpPS, sizeof(*opa->lpPS)) && opa->lpPS->dwSize == sizeof(PROPSHEETHEADERA))
+    {
+        memcpy(&header, opa->lpPS, sizeof(header));
+        header.dwSize = sizeof(header);
+        if (opa->lpPS->pszCaption && !IS_INTRESOURCE(opa->lpPS->pszCaption))
+            header.pszCaption = caption = oleui_strdupAtoW(opa->lpPS->pszCaption);
+        if ((opa->lpPS->dwFlags & PSH_USEICONID) && opa->lpPS->pszIcon && !IS_INTRESOURCE(opa->lpPS->pszIcon))
+            header.pszIcon = icon = oleui_strdupAtoW(opa->lpPS->pszIcon);
+        if ((opa->lpPS->dwFlags & PSH_USEPSTARTPAGE) && opa->lpPS->pStartPage && !IS_INTRESOURCE(opa->lpPS->pStartPage))
+            header.pStartPage = start = oleui_strdupAtoW(opa->lpPS->pStartPage);
+        if ((opa->lpPS->dwFlags & PSH_WATERMARK) && opa->lpPS->pszbmWatermark && !IS_INTRESOURCE(opa->lpPS->pszbmWatermark))
+            header.pszbmWatermark = wm = oleui_strdupAtoW(opa->lpPS->pszbmWatermark);
+        if ((opa->lpPS->dwFlags & PSH_HEADER) && opa->lpPS->pszbmHeader && !IS_INTRESOURCE(opa->lpPS->pszbmHeader))
+            header.pszbmHeader = hdr = oleui_strdupAtoW(opa->lpPS->pszbmHeader);
+        op.lpPS = &header;
+    }
+    else op.lpPS = (LPPROPSHEETHEADERW)opa->lpPS;
+
+    ret = object_properties(&op, opa, TRUE);
+
+    opa->dwFlags = op.dwFlags;
+    oleui_obj_adapter_free(obj);
+    oleui_link_adapter_free(link);
+    free(caption);
+    free(icon);
+    free(start);
+    free(wm);
+    free(hdr);
+    return ret;
+}
