+/***********************************************************************
+ *           OleUIInsertObjectW (OLEDLG.20)
+ */
+UINT WINAPI OleUIInsertObjectW(LPOLEUIINSERTOBJECTW lpOleUIInsertObject)
+{
+    OLEUIINSERTOBJECTA io;
+    char *caption = NULL, *tmpl = NULL, *file = NULL;
+    UINT ret;
+
+    TRACE("(%p)\n", lpOleUIInsertObject);
+
+    if (!lpOleUIInsertObject) return OLEUI_ERR_STRUCTURENULL;
+    if (IsBadWritePtr(lpOleUIInsertObject, sizeof(*lpOleUIInsertObject))) return OLEUI_ERR_STRUCTUREINVALID;
+    if (lpOleUIInsertObject->cbStruct != sizeof(*lpOleUIInsertObject)) return OLEUI_ERR_CBSTRUCTINCORRECT;
+
+    /* the two structures are the same but for the strings */
+    memcpy(&io, lpOleUIInsertObject, sizeof(io));
+    if (lpOleUIInsertObject->lpszCaption)
+    {
+        int len = WideCharToMultiByte(CP_ACP, 0, lpOleUIInsertObject->lpszCaption, -1, NULL, 0, NULL, NULL);
+        if ((caption = HeapAlloc(GetProcessHeap(), 0, len)))
+            WideCharToMultiByte(CP_ACP, 0, lpOleUIInsertObject->lpszCaption, -1, caption, len, NULL, NULL);
+        io.lpszCaption = caption;
+    }
+    if (lpOleUIInsertObject->lpszTemplate && !IS_INTRESOURCE(lpOleUIInsertObject->lpszTemplate))
+    {
+        int len = WideCharToMultiByte(CP_ACP, 0, lpOleUIInsertObject->lpszTemplate, -1, NULL, 0, NULL, NULL);
+        if ((tmpl = HeapAlloc(GetProcessHeap(), 0, len)))
+            WideCharToMultiByte(CP_ACP, 0, lpOleUIInsertObject->lpszTemplate, -1, tmpl, len, NULL, NULL);
+        io.lpszTemplate = tmpl;
+    }
+    if (lpOleUIInsertObject->lpszFile)
+    {
+        /* the file name goes in and out through a buffer of the same size */
+        DWORD size = max(lpOleUIInsertObject->cchFile, 1) * 2 + 2;
+        if ((file = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, size)))
+            WideCharToMultiByte(CP_ACP, 0, lpOleUIInsertObject->lpszFile, -1, file, size - 1, NULL, NULL);
+        io.lpszFile = file;
+    }
+
+    ret = OleUIInsertObjectA(&io);
+
+    lpOleUIInsertObject->dwFlags = io.dwFlags;
+    lpOleUIInsertObject->clsid = io.clsid;
+    lpOleUIInsertObject->sc = io.sc;
+    lpOleUIInsertObject->hMetaPict = io.hMetaPict;
+    if (file && lpOleUIInsertObject->cchFile)
+    {
+#ifndef SG_MUTANT_OLEDLG_INSFILE
+        MultiByteToWideChar(CP_ACP, 0, file, -1, lpOleUIInsertObject->lpszFile, lpOleUIInsertObject->cchFile);
+#endif
+        lpOleUIInsertObject->lpszFile[lpOleUIInsertObject->cchFile - 1] = 0;
+    }
+    HeapFree(GetProcessHeap(), 0, caption);
+    HeapFree(GetProcessHeap(), 0, tmpl);
+    HeapFree(GetProcessHeap(), 0, file);
+    return ret;
+}
