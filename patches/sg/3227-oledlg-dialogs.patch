+/***********************************************************************
+ *  Change Source
+ */
+struct cs_state
+{
+    OLEUICHANGESOURCEW *cs;
+    BOOL changed;
+};
+
+static HRESULT cs_set_source(OLEUICHANGESOURCEW *cs, const WCHAR *name, ULONG file_len, BOOL validate)
+{
+    WCHAR *copy = oleui_cotaskdup(name);
+    ULONG eaten = 0;
+    HRESULT hr;
+
+    if (!copy) return E_OUTOFMEMORY;
+    hr = IOleUILinkContainer_SetLinkSource(cs->lpOleUILinkContainer, cs->dwLink, copy, file_len, &eaten, validate);
+    CoTaskMemFree(copy);
+    return hr;
+}
+
+static UINT_PTR CALLBACK cs_hook(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct cs_state *st;
+
+    if (msg == WM_INITDIALOG)
+    {
+        OPENFILENAMEW *ofn = (OPENFILENAMEW *)lp;
+        const WCHAR *name, *item;
+        OLEUICHANGESOURCEW *cs;
+
+        st = (struct cs_state *)ofn->lCustData;
+        SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)st);
+        cs = st->cs;
+        name = cs->lpszDisplayName;
+        item = name + min(cs->nFileLength, (ULONG)lstrlenW(name));
+        if (*item == '!') item++;
+        SetDlgItemTextW(hwnd, edt2, item);
+        return TRUE;
+    }
+
+    if (msg == WM_NOTIFY && ((NMHDR *)lp)->code == CDN_FILEOK)
+    {
+        WCHAR file[MAX_PATH], item[MAX_PATH], *name;
+        OLEUICHANGESOURCEW *cs;
+        ULONG file_len;
+        int len;
+
+        st = (struct cs_state *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+        cs = st->cs;
+        /* the file chosen is in the structure of the file dialog by now */
+        lstrcpynW(file, ((OFNOTIFYW *)lp)->lpOFN->lpstrFile, ARRAY_SIZE(file));
+        GetDlgItemTextW(hwnd, edt2, item, ARRAY_SIZE(item));
+        file_len = lstrlenW(file);
+        len = file_len + lstrlenW(item) + 2;
+        if (!(name = malloc(len * sizeof(WCHAR)))) return FALSE;
+        lstrcpyW(name, file);
+        if (item[0])
+        {
+            lstrcatW(name, L"!");
+            lstrcatW(name, item);
+        }
+
+#ifdef SG_MUTANT_OLEDLG_CSVALID
+        if (FALSE)
+#else
+        if (!(cs->dwFlags & CSF_ONLYGETSOURCE))
+#endif
+        {
+            HRESULT hr = cs_set_source(cs, name, file_len, TRUE);
+            if (SUCCEEDED(hr)) cs->dwFlags |= CSF_VALIDSOURCE;
+            else
+            {
+                WCHAR text[300], title[64];
+
+                LoadStringW(OLEDLG_hInstance, IDS_CS_INVALID, text, ARRAY_SIZE(text));
+                LoadStringW(OLEDLG_hInstance, IDS_CS_TITLE, title, ARRAY_SIZE(title));
+                if (MessageBoxW(hwnd, text, title, MB_YESNO | MB_ICONEXCLAMATION) == IDYES)
+                {
+                    /* the user wants to fix the source */
+                    free(name);
+                    SetWindowLongPtrW(hwnd, DWLP_MSGRESULT, 1);
+                    return TRUE;
+                }
+                /* keep the source anyway, as one that is not available */
+                cs_set_source(cs, name, file_len, FALSE);
+                cs->dwFlags &= ~CSF_VALIDSOURCE;
+            }
+        }
+
+        /* the results */
+        {
+            const WCHAR *old = cs->lpszDisplayName, *old_end;
+            int old_file = min(cs->nFileLength, (ULONG)lstrlenW(old)), common = 0;
+            int new_file = file_len;
+
+            old_end = old + old_file;
+            /* the common trailing path components of the old and the new file name */
+            while (common < old_file && common < new_file &&
+                   towlower(old_end[-1 - common]) == towlower(file[new_file - 1 - common]))
+                common++;
+            while (common > 0 && common < old_file && common < new_file &&
+                   old_end[-common] != '\\' && old_end[-common] != '/')
+                common--;
+#ifdef SG_MUTANT_OLEDLG_CSFROMTO
+            common = 0;
+#endif
+            if (common == old_file || common == new_file) common = 0;
+            else if (common && old_end[-common] != '\\' && old_end[-common] != '/') common = 0;
+
+            CoTaskMemFree(cs->lpszFrom);
+            CoTaskMemFree(cs->lpszTo);
+            cs->lpszFrom = CoTaskMemAlloc((old_file - common + 1) * sizeof(WCHAR));
+            cs->lpszTo = CoTaskMemAlloc((new_file - common + 1) * sizeof(WCHAR));
+            if (cs->lpszFrom) { memcpy(cs->lpszFrom, old, (old_file - common) * sizeof(WCHAR)); cs->lpszFrom[old_file - common] = 0; }
+            if (cs->lpszTo) { memcpy(cs->lpszTo, file, (new_file - common) * sizeof(WCHAR)); cs->lpszTo[new_file - common] = 0; }
+        }
+
+        /* the caller's buffer is left alone: it may not be ours to free */
+        cs->lpszDisplayName = oleui_cotaskdup(name);
+        cs->nFileLength = file_len;
+        st->changed = TRUE;
+        free(name);
+        return FALSE;
+    }
+    return FALSE;
+}
+
+UINT oleui_changesource(OLEUICHANGESOURCEW *cs, void *app)
+{
+    struct cs_state st = {0};
+    OPENFILENAMEW ofn = {0};
+    WCHAR file[MAX_PATH], title[64], filter[160];
+    UINT ret;
+    int n;
+
+    if ((ret = oleui_validate(cs, sizeof(*cs)))) return ret;
+    if (!cs->lpOleUILinkContainer) return OLEUI_CSERR_LINKCNTRNULL;
+    if (bad_container(cs->lpOleUILinkContainer)) return OLEUI_CSERR_LINKCNTRINVALID;
+    if (cs->lpszFrom) return OLEUI_CSERR_FROMNOTNULL;
+    if (cs->lpszTo) return OLEUI_CSERR_TONOTNULL;
+    if (!cs->lpszDisplayName) return OLEUI_CSERR_SOURCENULL;
+    if (IsBadReadPtr(cs->lpszDisplayName, sizeof(WCHAR))) return OLEUI_CSERR_SOURCEINVALID;
+    if (cs->nFileLength > (ULONG)lstrlenW(cs->lpszDisplayName)) return OLEUI_CSERR_SOURCEPARSEERROR;
+
+    st.cs = cs;
+    n = min(cs->nFileLength, MAX_PATH - 1);
+    memcpy(file, cs->lpszDisplayName, n * sizeof(WCHAR));
+    file[n] = 0;
+
+    n = LoadStringW(OLEDLG_hInstance, IDS_CS_FILTER, filter, ARRAY_SIZE(filter) - 2);
+    filter[n + 1] = 0;
+    for (n = 0; filter[n]; n++) if (filter[n] == '|') filter[n] = 0;
+    if (cs->lpszCaption) lstrcpynW(title, cs->lpszCaption, ARRAY_SIZE(title));
+    else LoadStringW(OLEDLG_hInstance, IDS_CS_TITLE, title, ARRAY_SIZE(title));
+
+    ofn.lStructSize = sizeof(ofn);
+    ofn.hwndOwner = cs->hWndOwner;
+    ofn.hInstance = OLEDLG_hInstance;
+    ofn.lpstrFilter = filter;
+    ofn.lpstrFile = file;
+    ofn.nMaxFile = ARRAY_SIZE(file);
+    ofn.lpstrTitle = title;
+    ofn.lpTemplateName = MAKEINTRESOURCEW(IDD_CHANGESOURCE4);
+    ofn.lpfnHook = cs_hook;
+    ofn.lCustData = (LPARAM)&st;
+    ofn.Flags = OFN_EXPLORER | OFN_ENABLEHOOK | OFN_ENABLETEMPLATE | OFN_HIDEREADONLY | OFN_PATHMUSTEXIST;
+    if (cs->lpOFN)
+    {
+        /* what the caller prepared for the file dialog */
+        if (cs->lpOFN->lpstrFilter) { ofn.lpstrFilter = cs->lpOFN->lpstrFilter; ofn.nFilterIndex = cs->lpOFN->nFilterIndex; }
+        ofn.lpstrInitialDir = cs->lpOFN->lpstrInitialDir;
+        if (cs->lpOFN->lpstrTitle) ofn.lpstrTitle = cs->lpOFN->lpstrTitle;
+    }
+
+    if (GetOpenFileNameW(&ofn)) return OLEUI_OK;
+    if (CommDlgExtendedError()) return OLEUI_ERR_DIALOGFAILURE;
+    return OLEUI_CANCEL;
+}
+
+/***********************************************************************
+ *           OleUIChangeSourceW (OLEDLG.17)
+ */
+UINT WINAPI OleUIChangeSourceW(LPOLEUICHANGESOURCEW cs)
+{
+    TRACE("(%p)\n", cs);
+    return oleui_changesource(cs, cs);
+}
+
+static char *cotask_w2a(const WCHAR *str)
+{
+    char *ret;
+    int len;
+
+    if (!str) return NULL;
+    len = WideCharToMultiByte(CP_ACP, 0, str, -1, NULL, 0, NULL, NULL);
+    if ((ret = CoTaskMemAlloc(len))) WideCharToMultiByte(CP_ACP, 0, str, -1, ret, len, NULL, NULL);
+    return ret;
+}
+
+/***********************************************************************
+ *           OleUIChangeSourceA (OLEDLG.12)
+ */
+UINT WINAPI OleUIChangeSourceA(LPOLEUICHANGESOURCEA csa)
+{
+    OLEUICHANGESOURCEW cs;
+    OPENFILENAMEW ofnw = {0};
+    IOleUILinkInfoW *adapter = NULL;
+    WCHAR *caption, *tmpl = NULL, *name = NULL, *filter = NULL, *title = NULL, *dir = NULL;
+    UINT ret;
+
+    TRACE("(%p)\n", csa);
+
+    if (!csa) return OLEUI_ERR_STRUCTURENULL;
+    if (IsBadWritePtr(csa, sizeof(*csa))) return OLEUI_ERR_STRUCTUREINVALID;
+    if (csa->cbStruct != sizeof(*csa)) return OLEUI_ERR_CBSTRUCTINCORRECT;
+
+    memset(&cs, 0, sizeof(cs));
+    cs.cbStruct = sizeof(cs);
+    cs.dwFlags = csa->dwFlags;
+    cs.hWndOwner = csa->hWndOwner;
+    cs.lpfnHook = csa->lpfnHook;
+    cs.lCustData = csa->lCustData;
+    cs.hInstance = csa->hInstance;
+    cs.hResource = csa->hResource;
+    cs.dwLink = csa->dwLink;
+    cs.nFileLength = csa->nFileLength;
+    caption = oleui_strdupAtoW(csa->lpszCaption);
+    cs.lpszCaption = caption;
+    if (csa->lpszTemplate && !IS_INTRESOURCE(csa->lpszTemplate)) tmpl = oleui_strdupAtoW(csa->lpszTemplate);
+    cs.lpszTemplate = tmpl ? tmpl : (const WCHAR *)csa->lpszTemplate;
+    if (csa->lpOleUILinkContainer && !IsBadReadPtr(csa->lpOleUILinkContainer, sizeof(void *)) &&
+        !IsBadReadPtr(csa->lpOleUILinkContainer->lpVtbl, sizeof(*csa->lpOleUILinkContainer->lpVtbl)))
+    {
+        adapter = oleui_link_adapter((IOleUILinkInfoA *)csa->lpOleUILinkContainer);
+        cs.lpOleUILinkContainer = (IOleUILinkContainerW *)adapter;
+    }
+    else cs.lpOleUILinkContainer = (IOleUILinkContainerW *)csa->lpOleUILinkContainer;
+    if (csa->lpszDisplayName && !IsBadReadPtr(csa->lpszDisplayName, 1))
+    {
+        WCHAR *tmpname = oleui_strdupAtoW(csa->lpszDisplayName);
+        ULONG alen = lstrlenA(csa->lpszDisplayName);
+
+        cs.lpszDisplayName = name = oleui_cotaskdup(tmpname);
+        /* the file part is counted in bytes by the caller, in characters by the dialog */
+        cs.nFileLength = csa->nFileLength > alen ? lstrlenW(tmpname) + 1 :
+                MultiByteToWideChar(CP_ACP, 0, csa->lpszDisplayName, csa->nFileLength, NULL, 0);
+        free(tmpname);
+    }
+    else cs.lpszDisplayName = (WCHAR *)csa->lpszDisplayName;
+    cs.lpszFrom = (WCHAR *)csa->lpszFrom;
+    cs.lpszTo = (WCHAR *)csa->lpszTo;
+    if (csa->lpOFN)
+    {
+        ofnw.lpstrInitialDir = dir = oleui_strdupAtoW(csa->lpOFN->lpstrInitialDir);
+        ofnw.lpstrTitle = title = oleui_strdupAtoW(csa->lpOFN->lpstrTitle);
+        if (csa->lpOFN->lpstrFilter)
+        {
+            /* a multi string */
+            const char *p = csa->lpOFN->lpstrFilter;
+            int len = 1;
+            while (*p) { int l = lstrlenA(p) + 1; len += l; p += l; }
+            if ((filter = malloc(len * sizeof(WCHAR))))
+                MultiByteToWideChar(CP_ACP, 0, csa->lpOFN->lpstrFilter, len, filter, len);
+            ofnw.lpstrFilter = filter;
+            ofnw.nFilterIndex = csa->lpOFN->nFilterIndex;
+        }
+        cs.lpOFN = &ofnw;
+    }
+
+    ret = oleui_changesource(&cs, csa);
+
+    if (ret == OLEUI_OK)
+    {
+        /* the results come back as ANSI strings allocated like the wide ones */
+#ifdef SG_MUTANT_OLEDLG_CSANSI
+        csa->nFileLength = cs.nFileLength + 1;
+#else
+        csa->nFileLength = WideCharToMultiByte(CP_ACP, 0, cs.lpszDisplayName, cs.nFileLength, NULL, 0, NULL, NULL);
+#endif
+        csa->lpszDisplayName = cotask_w2a(cs.lpszDisplayName);
+        csa->lpszFrom = cotask_w2a(cs.lpszFrom);
+        csa->lpszTo = cotask_w2a(cs.lpszTo);
+        csa->dwFlags = cs.dwFlags;
+        CoTaskMemFree(cs.lpszFrom);
+        CoTaskMemFree(cs.lpszTo);
+        CoTaskMemFree(cs.lpszDisplayName);
+    }
+    else if (ret == OLEUI_CANCEL) csa->dwFlags = cs.dwFlags;
+    CoTaskMemFree(name);
+    oleui_link_adapter_free(adapter);
+    free(caption);
+    free(tmpl);
+    free(filter);
+    free(title);
+    free(dir);
+    return ret;
+}
+
+/***********************************************************************
+ *  Edit Links
+ */
+struct link_item
+{
+    DWORD link;
+    WCHAR *source;
+    ULONG file_len;
+    WCHAR *full_type, *short_type;
+    BOOL available;
+    DWORD update;
+};
+
+struct el_state
+{
+    OLEUIEDITLINKSW *el;
+    BOOL changed;
+};
+
+static void el_free_item(struct link_item *item)
+{
+    if (!item) return;
+    CoTaskMemFree(item->source);
+    CoTaskMemFree(item->full_type);
+    CoTaskMemFree(item->short_type);
+    free(item);
+}
+
+static void el_item_text(const struct link_item *item, WCHAR *buf, DWORD len)
+{
+    WCHAR upd[40];
+
+    LoadStringW(OLEDLG_hInstance, !item->available ? IDS_EL_UNAVAILABLE :
+                item->update == UPDATE_ALWAYS ? IDS_EL_AUTOMATIC : IDS_EL_MANUAL, upd, ARRAY_SIZE(upd));
+    wsprintfW(buf, L"%.200s\t%.100s\t%s", item->source ? item->source : L"", item->short_type ? item->short_type : L"", upd);
+    (void)len;
+}
+
+/* read the link's data from the container */
+static struct link_item *el_read_item(IOleUILinkContainerW *c, DWORD link, BOOL *selected)
+{
+    struct link_item *item;
+    BOOL sel = FALSE;
+
+    if (!(item = calloc(1, sizeof(*item)))) return NULL;
+    item->link = link;
+    item->available = TRUE;
+    if (FAILED(IOleUILinkContainer_GetLinkSource(c, link, &item->source, &item->file_len, &item->full_type,
+                                                 &item->short_type, &item->available, &sel)))
+    {
+        item->available = FALSE;
+    }
+    if (FAILED(IOleUILinkContainer_GetLinkUpdateOptions(c, link, &item->update))) item->update = UPDATE_ONCALL;
+    if (selected) *selected = sel;
+    return item;
+}
+
+static struct link_item *el_get_item(HWND hwnd, int index)
+{
+    LRESULT r = SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_GETITEMDATA, index, 0);
+    return r == LB_ERR ? NULL : (struct link_item *)r;
+}
+
+static void el_add_item(HWND hwnd, struct link_item *item, BOOL selected)
+{
+    WCHAR text[420];
+    LRESULT index;
+
+    el_item_text(item, text, ARRAY_SIZE(text));
+    index = SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_ADDSTRING, 0, (LPARAM)text);
+    if (index == LB_ERR) { el_free_item(item); return; }
+    SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_SETITEMDATA, index, (LPARAM)item);
+    if (selected) SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_SETSEL, TRUE, index);
+}
+
+static int el_selection(HWND hwnd, int *sel, int max)
+{
+    int count = SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_GETSELCOUNT, 0, 0);
+
+    if (count <= 0) return 0;
+    if (count > max) count = max;
+    return SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_GETSELITEMS, count, (LPARAM)sel);
+}
+
+#define EL_MAX_SEL 4096
+
+static void el_update_ui(HWND hwnd, struct el_state *st)
+{
+    OLEUIEDITLINKSW *el = st->el;
+    int *sel = malloc(EL_MAX_SEL * sizeof(int));
+    int n = sel ? el_selection(hwnd, sel, EL_MAX_SEL) : 0, i;
+    BOOL any_available = FALSE, same_update = TRUE, same_type = TRUE;
+    struct link_item *first = NULL;
+
+    for (i = 0; i < n; i++)
+    {
+        struct link_item *item = el_get_item(hwnd, sel[i]);
+        if (!item) continue;
+        if (!first) first = item;
+        else
+        {
+            if (item->update != first->update) same_update = FALSE;
+            if (lstrcmpW(item->full_type ? item->full_type : L"", first->full_type ? first->full_type : L"")) same_type = FALSE;
+        }
+        if (item->available) any_available = TRUE;
+    }
+    free(sel);
+
+    SetDlgItemTextW(hwnd, IDC_EL_LINKSOURCE, n == 1 && first ? first->source : L"");
+    SetDlgItemTextW(hwnd, IDC_EL_LINKTYPE, first && same_type && first->full_type ? first->full_type : L"");
+    EnableWindow(GetDlgItem(hwnd, IDC_EL_UPDATENOW), n > 0 && any_available && !(el->dwFlags & ELF_DISABLEUPDATENOW));
+    EnableWindow(GetDlgItem(hwnd, IDC_EL_OPENSOURCE), n == 1 && first->available && !(el->dwFlags & ELF_DISABLEOPENSOURCE));
+    EnableWindow(GetDlgItem(hwnd, IDC_EL_CHANGESOURCE), n == 1 && !(el->dwFlags & ELF_DISABLECHANGESOURCE));
+    EnableWindow(GetDlgItem(hwnd, IDC_EL_CANCELLINK), n > 0 && !(el->dwFlags & ELF_DISABLECANCELLINK));
+    EnableWindow(GetDlgItem(hwnd, IDC_EL_AUTOMATIC), n > 0);
+    EnableWindow(GetDlgItem(hwnd, IDC_EL_MANUAL), n > 0);
+    CheckDlgButton(hwnd, IDC_EL_AUTOMATIC, n > 0 && same_update && first->update == UPDATE_ALWAYS ? BST_CHECKED : BST_UNCHECKED);
+    CheckDlgButton(hwnd, IDC_EL_MANUAL, n > 0 && same_update && first->update != UPDATE_ALWAYS ? BST_CHECKED : BST_UNCHECKED);
+}
+
+/* put the item's new text in its row, keeping the selection */
+static void el_refresh_row(HWND hwnd, int index)
+{
+    struct link_item *item = el_get_item(hwnd, index);
+    BOOL sel = SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_GETSEL, index, 0) > 0;
+    WCHAR text[420];
+
+    if (!item) return;
+    el_item_text(item, text, ARRAY_SIZE(text));
+    SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_DELETESTRING, index, 0);
+    SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_INSERTSTRING, index, (LPARAM)text);
+    SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_SETITEMDATA, index, (LPARAM)item);
+    if (sel) SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_SETSEL, TRUE, index);
+}
+
+/* a link has new data from the container */
+static void el_reread(HWND hwnd, struct el_state *st, int index)
+{
+    struct link_item *old = el_get_item(hwnd, index), *item;
+
+    if (!old) return;
+    if (!(item = el_read_item(st->el->lpOleUILinkContainer, old->link, NULL))) return;
+    SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_SETITEMDATA, index, (LPARAM)item);
+    el_free_item(old);
+    el_refresh_row(hwnd, index);
+}
+
+static void el_mark_changed(HWND hwnd, struct el_state *st)
+{
+    WCHAR text[32];
+
+    if (st->changed) return;
+    st->changed = TRUE;
+    LoadStringW(OLEDLG_hInstance, IDS_EL_CLOSE, text, ARRAY_SIZE(text));
+    SetDlgItemTextW(hwnd, IDCANCEL, text);
+}
+
+static void el_change_source(HWND hwnd, struct el_state *st)
+{
+    IOleUILinkContainerW *c = st->el->lpOleUILinkContainer;
+    OLEUICHANGESOURCEW cs = {0};
+    int sel[1], n = el_selection(hwnd, sel, 1), count, i;
+    struct link_item *item;
+    WCHAR *orig;
+
+    if (n != 1 || !(item = el_get_item(hwnd, sel[0]))) return;
+    cs.cbStruct = sizeof(cs);
+    cs.hWndOwner = hwnd;
+    cs.dwFlags = (st->el->dwFlags & ELF_SHOWHELP) ? CSF_SHOWHELP : 0;
+    cs.lpOleUILinkContainer = c;
+    cs.dwLink = item->link;
+    cs.lpszDisplayName = orig = oleui_cotaskdup(item->source ? item->source : L"");
+    cs.nFileLength = item->file_len;
+    /* the dialog validates the new source, the other links to the moved file follow below */
+    if (OleUIChangeSourceW(&cs) == OLEUI_OK)
+    {
+        if (!(cs.dwFlags & CSF_VALIDSOURCE)) { /* kept as unavailable by the dialog */ }
+        el_mark_changed(hwnd, st);
+        el_reread(hwnd, st, sel[0]);
+
+        /* links whose source starts with the old directory move with it */
+        count = SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_GETCOUNT, 0, 0);
+#ifdef SG_MUTANT_OLEDLG_CSFOLLOW
+        if (FALSE)
+#else
+        if (cs.lpszFrom && cs.lpszTo && cs.lpszFrom[0] && lstrcmpiW(cs.lpszFrom, cs.lpszTo))
+#endif
+        {
+            int from_len = lstrlenW(cs.lpszFrom);
+
+            for (i = 0; i < count; i++)
+            {
+                struct link_item *other = el_get_item(hwnd, i);
+                WCHAR *name;
+                ULONG eaten = 0;
+
+                if (!other || i == sel[0] || !other->source || other->file_len < (ULONG)from_len) continue;
+                if (wcsnicmp(other->source, cs.lpszFrom, from_len)) continue;
+                if (other->source[from_len] != '\\' && other->source[from_len] != 0 && other->source[from_len] != '!') continue;
+                if (!(name = CoTaskMemAlloc((lstrlenW(cs.lpszTo) + lstrlenW(other->source) + 1) * sizeof(WCHAR)))) continue;
+                lstrcpyW(name, cs.lpszTo);
+                lstrcatW(name, other->source + from_len);
+                IOleUILinkContainer_SetLinkSource(c, other->link, name,
+                        other->file_len - from_len + lstrlenW(cs.lpszTo), &eaten, TRUE);
+                CoTaskMemFree(name);
+                el_reread(hwnd, st, i);
+            }
+        }
+    }
+    if (cs.lpszDisplayName != orig) CoTaskMemFree(cs.lpszDisplayName);
+    CoTaskMemFree(orig);
+    CoTaskMemFree(cs.lpszFrom);
+    CoTaskMemFree(cs.lpszTo);
+}
+
+static INT_PTR el_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, struct oleui_dlg *dlg)
+{
+    struct el_state *st = dlg->priv;
+    OLEUIEDITLINKSW *el = st->el;
+    int *sel;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        DWORD link = 0;
+        INT tabs[2] = { 124, 188 };
+
+        SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_SETTABSTOPS, 2, (LPARAM)tabs);
+        while ((link = IOleUILinkContainer_GetNextLink(el->lpOleUILinkContainer, link)))
+        {
+            BOOL selected = FALSE;
+            struct link_item *item = el_read_item(el->lpOleUILinkContainer, link, &selected);
+
+            if (item) el_add_item(hwnd, item, selected);
+        }
+        if (!(el->dwFlags & ELF_SHOWHELP)) ShowWindow(GetDlgItem(hwnd, IDC_OLEUIHELP), SW_HIDE);
+        el_update_ui(hwnd, st);
+        return TRUE;
+    }
+
+    case WM_COMMAND:
+        switch (LOWORD(wp))
+        {
+        case IDC_EL_LINKSLISTBOX:
+            if (HIWORD(wp) == LBN_SELCHANGE) el_update_ui(hwnd, st);
+            return TRUE;
+
+        case IDC_EL_AUTOMATIC:
+        case IDC_EL_MANUAL:
+        {
+#ifdef SG_MUTANT_OLEDLG_ELOPT
+            DWORD opt = UPDATE_ONCALL;
+#else
+            DWORD opt = LOWORD(wp) == IDC_EL_AUTOMATIC ? UPDATE_ALWAYS : UPDATE_ONCALL;
+#endif
+            int n, i;
+
+            if (!(sel = malloc(EL_MAX_SEL * sizeof(int)))) return TRUE;
+            n = el_selection(hwnd, sel, EL_MAX_SEL);
+            for (i = 0; i < n; i++)
+            {
+                struct link_item *item = el_get_item(hwnd, sel[i]);
+                if (item && SUCCEEDED(IOleUILinkContainer_SetLinkUpdateOptions(el->lpOleUILinkContainer, item->link, opt)))
+                {
+                    item->update = opt;
+                    el_refresh_row(hwnd, sel[i]);
+                    el_mark_changed(hwnd, st);
+                }
+            }
+            free(sel);
+            el_update_ui(hwnd, st);
+            return TRUE;
+        }
+
+        case IDC_EL_UPDATENOW:
+        {
+            int n, i;
+
+            if (!(sel = malloc(EL_MAX_SEL * sizeof(int)))) return TRUE;
+            n = el_selection(hwnd, sel, EL_MAX_SEL);
+            for (i = 0; i < n; i++)
+            {
+                struct link_item *item = el_get_item(hwnd, sel[i]);
+                if (!item || !item->available) continue;
+                IOleUILinkContainer_UpdateLink(el->lpOleUILinkContainer, item->link, TRUE, FALSE);
+                el_reread(hwnd, st, sel[i]);
+            }
+            free(sel);
+            el_mark_changed(hwnd, st);
+            el_update_ui(hwnd, st);
+            return TRUE;
+        }
+
+        case IDC_EL_OPENSOURCE:
+        {
+            int one[1];
+            struct link_item *item;
+
+            if (el_selection(hwnd, one, 1) == 1 && (item = el_get_item(hwnd, one[0])) &&
+                SUCCEEDED(IOleUILinkContainer_OpenLinkSource(el->lpOleUILinkContainer, item->link)))
+            {
+#ifndef SG_MUTANT_OLEDLG_ELOPEN
+                EndDialog(hwnd, OLEUI_OK);
+#endif
+            }
+            return TRUE;
+        }
+
+        case IDC_EL_CANCELLINK:
+        {
+            int n, i;
+
+            if (!(sel = malloc(EL_MAX_SEL * sizeof(int)))) return TRUE;
+            n = el_selection(hwnd, sel, EL_MAX_SEL);
+            /* from the last row, so the earlier row numbers stay right */
+            for (i = n - 1; i >= 0; i--)
+            {
+                struct link_item *item = el_get_item(hwnd, sel[i]);
+#ifdef SG_MUTANT_OLEDLG_ELBREAK
+                if (item)
+#else
+                if (item && SUCCEEDED(IOleUILinkContainer_CancelLink(el->lpOleUILinkContainer, item->link)))
+#endif
+                {
+                    SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_DELETESTRING, sel[i], 0);
+                    el_free_item(item);
+                    el_mark_changed(hwnd, st);
+                }
+            }
+            free(sel);
+            el_update_ui(hwnd, st);
+            return TRUE;
+        }
+
+        case IDC_EL_CHANGESOURCE:
+            el_change_source(hwnd, st);
+            el_update_ui(hwnd, st);
+            return TRUE;
+
+        case IDCANCEL:
+            EndDialog(hwnd, OLEUI_CANCEL);
+            return TRUE;
+        }
+        break;
+
+    case WM_DESTROY:
+    {
+        int count = SendDlgItemMessageW(hwnd, IDC_EL_LINKSLISTBOX, LB_GETCOUNT, 0, 0), i;
+
+        for (i = 0; i < count; i++) el_free_item(el_get_item(hwnd, i));
+        break;
+    }
+    }
+    return FALSE;
+}
+
+static UINT edit_links(OLEUIEDITLINKSW *el, void *app)
+{
+    struct el_state st = {0};
+    struct oleui_dlg dlg = {0};
+    UINT ret;
+
+    if ((ret = oleui_validate(el, sizeof(*el)))) return ret;
+    if (!el->lpOleUILinkContainer) return OLEUI_ELERR_LINKCNTRNULL;
+    if (bad_container(el->lpOleUILinkContainer)) return OLEUI_ELERR_LINKCNTRINVALID;
+
+    st.el = el;
+    dlg.common = (const struct oleui_common *)el;
+    dlg.app_struct = app;
+    dlg.proc = el_proc;
+    dlg.priv = &st;
+    return oleui_run_dialog(&dlg, IDD_EDITLINKS);
+}
+
+/***********************************************************************
+ *           OleUIEditLinksW (OLEDLG.19)
+ */
+UINT WINAPI OleUIEditLinksW(LPOLEUIEDITLINKSW el)
+{
+    TRACE("(%p)\n", el);
+    return edit_links(el, el);
+}
+
+/***********************************************************************
+ *           OleUIEditLinksA (OLEDLG.5)
+ */
+UINT WINAPI OleUIEditLinksA(LPOLEUIEDITLINKSA ela)
+{
+    OLEUIEDITLINKSW el;
+    IOleUILinkInfoW *adapter = NULL;
+    WCHAR *caption, *tmpl = NULL;
+    UINT ret;
+
+    TRACE("(%p)\n", ela);
+
+    if (!ela) return OLEUI_ERR_STRUCTURENULL;
+    if (IsBadWritePtr(ela, sizeof(*ela))) return OLEUI_ERR_STRUCTUREINVALID;
+    if (ela->cbStruct != sizeof(*ela)) return OLEUI_ERR_CBSTRUCTINCORRECT;
+
+    memset(&el, 0, sizeof(el));
+    el.cbStruct = sizeof(el);
+    el.dwFlags = ela->dwFlags;
+    el.hWndOwner = ela->hWndOwner;
+    el.lpfnHook = ela->lpfnHook;
+    el.lCustData = ela->lCustData;
+    el.hInstance = ela->hInstance;
+    el.hResource = ela->hResource;
+    caption = oleui_strdupAtoW(ela->lpszCaption);
+    el.lpszCaption = caption;
+    if (ela->lpszTemplate && !IS_INTRESOURCE(ela->lpszTemplate)) tmpl = oleui_strdupAtoW(ela->lpszTemplate);
+    el.lpszTemplate = tmpl ? tmpl : (const WCHAR *)ela->lpszTemplate;
+    if (ela->lpOleUILinkContainer && !IsBadReadPtr(ela->lpOleUILinkContainer, sizeof(void *)) &&
+        !IsBadReadPtr(ela->lpOleUILinkContainer->lpVtbl, sizeof(*ela->lpOleUILinkContainer->lpVtbl)))
+    {
+        adapter = oleui_link_adapter((IOleUILinkInfoA *)ela->lpOleUILinkContainer);
+        el.lpOleUILinkContainer = (IOleUILinkContainerW *)adapter;
+    }
+    else el.lpOleUILinkContainer = (IOleUILinkContainerW *)ela->lpOleUILinkContainer;
+
+    ret = edit_links(&el, ela);
+    ela->dwFlags = el.dwFlags;
+    oleui_link_adapter_free(adapter);
+    free(caption);
+    free(tmpl);
+    return ret;
+}
