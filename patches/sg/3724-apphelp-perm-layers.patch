From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] apphelp: permanent layer keys, AppPatch dir (3724)

apphelp: permanent layer keys and the AppPatch directory

SdbSet/GetPermLayerKeys and SetPermLayerState work on the AppCompatFlags
Layers values shared with the Compatibility tab and CreateProcess.
Details in notes/3724.txt.
---
diff --git a/dlls/apphelp/Makefile.in b/dlls/apphelp/Makefile.in
index b677e9c..2431b83 100644
--- a/dlls/apphelp/Makefile.in
+++ b/dlls/apphelp/Makefile.in
@@ -1,4 +1,5 @@
 MODULE = apphelp.dll
+IMPORTS = advapi32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
diff --git a/dlls/apphelp/apphelp.c b/dlls/apphelp/apphelp.c
index 66e59d7..518e2bd 100644
--- a/dlls/apphelp/apphelp.c
+++ b/dlls/apphelp/apphelp.c
@@ -20,6 +20,7 @@
 #include "windef.h"
 #include "winbase.h"
 #include <appcompatapi.h>
+#include "winreg.h"
 
 #include "wine/debug.h"
 
@@ -99,27 +100,211 @@ void WINAPI SdbCloseDatabase(PDB pdb)
 
 void WINAPI SdbGetAppPatchDir(HSDB hsdb, WCHAR *path, DWORD size)
 {
-    FIXME("stub: %p %p %ld\n", hsdb, path, size);
-    if (size && path) *path = 0;
+    static const WCHAR patch[] = L"\\AppPatch";
+    UINT len;
+
+    TRACE("%p %p %ld\n", hsdb, path, size);
+
+    /* %windir%\AppPatch, where the system's compatibility databases live (GUESS: no
+     * separate AppPatch64 directory is used here) */
+    if (!path || !size) return;
+    *path = 0;
+    len = GetWindowsDirectoryW( path, size );
+    if (!len || len + ARRAY_SIZE(patch) > size) { *path = 0; return; }
+    lstrcpyW( path + len, patch );
 }
 
-BOOL WINAPI SetPermLayerState( PCWSTR path, PCWSTR layers, DWORD flags, BOOL machine, BOOL state)
+/* The permanent compatibility layers of a program live where the Compatibility tab
+ * of its Properties and kernelbase's CreateProcess look for them:
+ * HKCU (or HKLM) \Software\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Layers,
+ * one REG_SZ per program named by its full path, holding space separated layer
+ * names (RUNASADMIN, WIN98, ...). The functions below are not documented by
+ * Microsoft: this is their obvious reading (GUESS), kept consistent with that key.
+ * flags of SdbGetPermLayerKeys: 1 = the user's layers, 2 = the machine's. */
+#define GPLK_USER    0x1
+#define GPLK_MACHINE 0x2
+
+static HKEY open_layers_key( BOOL machine, BOOL create, REGSAM access )
 {
-    FIXME("stub: %s %s %ld %d %d\n", debugstr_w(path), debugstr_w(layers), flags, machine, state);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    static const WCHAR layers[] = L"Software\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Layers";
+    HKEY key = 0;
+    LONG err;
+
+    if (create) err = RegCreateKeyExW( machine ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER, layers, 0, NULL, 0, access, NULL, &key, NULL );
+    else err = RegOpenKeyExW( machine ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER, layers, 0, access, &key );
+    if (err) { SetLastError( err ); return 0; }
+    return key;
+}
+
+static BOOL layers_value_name( PCWSTR path, WCHAR *full )
+{
+    if (!path || !*path || !GetFullPathNameW( path, MAX_PATH, full, NULL )) return FALSE;
     return TRUE;
 }
 
-BOOL WINAPI SdbSetPermLayerKeys( PCWSTR path, PCWSTR layers, BOOL machine )
+static BOOL read_layers( BOOL machine, const WCHAR *full, WCHAR *buf, DWORD *size )
 {
-    FIXME("stub: %s %s %d\n", debugstr_w(path), debugstr_w(layers), machine);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    HKEY key = open_layers_key( machine, FALSE, KEY_READ );
+    DWORD type;
+    LONG err;
+
+    if (!key) return FALSE;
+    err = RegQueryValueExW( key, full, NULL, &type, (BYTE *)buf, size );
+    RegCloseKey( key );
+    if (err == ERROR_SUCCESS && type != REG_SZ) err = ERROR_INVALID_DATA;
+    if (err) { SetLastError( err ); return FALSE; }
     return TRUE;
 }
 
+static BOOL write_layers( BOOL machine, const WCHAR *full, const WCHAR *layers )
+{
+    HKEY key;
+    LONG err;
+
+    if (!(key = open_layers_key( machine, TRUE, KEY_SET_VALUE ))) return FALSE;
+#ifdef SG_MUTANT_APPH_NODEL
+    if (!layers)
+#else
+    if (!layers || !*layers)
+#endif
+    {
+        err = RegDeleteValueW( key, full );
+        if (err == ERROR_FILE_NOT_FOUND) err = ERROR_SUCCESS;
+    }
+    else err = RegSetValueExW( key, full, 0, REG_SZ, (const BYTE *)layers, (lstrlenW( layers ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    if (err) { SetLastError( err ); return FALSE; }
+    return TRUE;
+}
+
+BOOL WINAPI SdbSetPermLayerKeys( PCWSTR path, PCWSTR layers, BOOL machine )
+{
+    WCHAR full[MAX_PATH];
+
+    TRACE("%s %s %d\n", debugstr_w(path), debugstr_w(layers), machine);
+
+    if (!layers_value_name( path, full ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return write_layers( machine, full, layers );
+}
+
 BOOL WINAPI SdbGetPermLayerKeys( PCWSTR path, PWSTR layers, PDWORD size, DWORD flags )
 {
-    FIXME("stub: %s %p %p %ld\n", debugstr_w(path), layers, size, flags);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    WCHAR full[MAX_PATH], buf[1024];
+    DWORD len;
+    BOOL machine;
+
+    TRACE("%s %p %p %ld\n", debugstr_w(path), layers, size, flags);
+
+    if (!layers_value_name( path, full ) || !size || (flags & ~(GPLK_USER | GPLK_MACHINE)))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!flags) flags = GPLK_USER | GPLK_MACHINE;
+    /* the user's layers win over the machine's */
+#ifdef SG_MUTANT_APPH_ORDER
+    for (machine = TRUE; ; machine = FALSE)
+#else
+    for (machine = FALSE; ; machine = TRUE)
+#endif
+    {
+        if (flags & (machine ? GPLK_MACHINE : GPLK_USER))
+        {
+            len = sizeof(buf) - sizeof(WCHAR);
+            if (read_layers( machine, full, buf, &len ))
+            {
+                buf[len / sizeof(WCHAR)] = 0;
+                len = (lstrlenW( buf ) + 1) * sizeof(WCHAR);
+                if (!layers || *size < len)
+                {
+                    *size = len;
+                    SetLastError( ERROR_INSUFFICIENT_BUFFER );
+                    return FALSE;
+                }
+                memcpy( layers, buf, len );
+                *size = len;
+                return TRUE;
+            }
+        }
+#ifdef SG_MUTANT_APPH_ORDER
+        if (!machine) break;
+#else
+        if (machine) break;
+#endif
+    }
+    SetLastError( ERROR_NOT_FOUND );
+    return FALSE;
+}
+
+static BOOL next_word( const WCHAR **list, const WCHAR **word, size_t *len )
+{
+    const WCHAR *p = *list;
+
+    while (*p == ' ') p++;
+    if (!*p) return FALSE;
+    *word = p;
+    while (*p && *p != ' ') p++;
+    *len = p - *word;
+    *list = p;
     return TRUE;
 }
+
+static BOOL has_word( const WCHAR *list, const WCHAR *word, size_t len )
+{
+    const WCHAR *w;
+    size_t n;
+
+    while (next_word( &list, &w, &n ))
+        
+#ifdef SG_MUTANT_APPH_CASE
+        if (n == len && !wcsncmp( w, word, len )) return TRUE;
+#else
+        if (n == len && !wcsnicmp( w, word, len )) return TRUE;
+#endif
+    return FALSE;
+}
+
+static BOOL append_word( WCHAR *list, size_t cap, const WCHAR *word, size_t len )
+{
+    size_t cur = lstrlenW( list );
+
+    if (cur + len + 2 > cap) return FALSE;
+    if (cur) list[cur++] = ' ';
+    memcpy( list + cur, word, len * sizeof(WCHAR) );
+    list[cur + len] = 0;
+    return TRUE;
+}
+
+/* adds (state TRUE) or removes (FALSE) the named layers from a program's layers */
+BOOL WINAPI SetPermLayerState( PCWSTR path, PCWSTR layers, DWORD flags, BOOL machine, BOOL state)
+{
+    WCHAR full[MAX_PATH], cur[1024], out[1024];
+    DWORD len = sizeof(cur) - sizeof(WCHAR);
+    const WCHAR *list, *w;
+    size_t n;
+
+    TRACE("%s %s %ld %d %d\n", debugstr_w(path), debugstr_w(layers), flags, machine, state);
+
+    if (!layers_value_name( path, full ) || !layers || !*layers)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (read_layers( machine, full, cur, &len )) cur[len / sizeof(WCHAR)] = 0;
+    else cur[0] = 0;
+    out[0] = 0;
+
+    for (list = cur; next_word( &list, &w, &n ); )
+        if (state || !has_word( layers, w, n )) append_word( out, ARRAY_SIZE(out), w, n );
+    if (state)
+        for (list = layers; next_word( &list, &w, &n ); )
+#ifdef SG_MUTANT_APPH_DUP
+            if (1) append_word( out, ARRAY_SIZE(out), w, n ); else
+#endif
+            if (!has_word( out, w, n )) append_word( out, ARRAY_SIZE(out), w, n );
+    return write_layers( machine, full, out );
+}
