+    if (BCryptOpenAlgorithmProvider( &alg, BCRYPT_RSA_ALGORITHM, NULL, 0 )) return FALSE;
+    status = BCryptGenerateKeyPair( alg, &key, 2048, 0 );
+    ok( !status, "got %#lx\n", status );
+    status = BCryptFinalizeKeyPair( key, 0 );
+    ok( !status, "got %#lx\n", status );
+    BCryptExportKey( key, NULL, BCRYPT_RSAPUBLIC_BLOB, NULL, 0, &size, 0 );
+    buf = malloc( size );
+    status = BCryptExportKey( key, NULL, BCRYPT_RSAPUBLIC_BLOB, buf, size, &size, 0 );
+    ok( !status, "got %#lx\n", status );
+    blob = (BCRYPT_RSAKEY_BLOB *)buf;
+    ok( blob->cbModulus == 256, "got %lu\n", blob->cbModulus );
+    base64( buf + sizeof(*blob), blob->cbPublicExp, exponent_b64 );
