+    ULONG i;
+
+    base64( digest, sizeof(digest), dig );
+    signed_info( si_canon, TRUE, signed_inclusive, signed_inclusive ? INC : EXC, RSA256, dig, "r1" );
+    sign( si_canon, sig_b64 );
+    if (canonical_out) strcpy( canonical_out, si_canon );
+    signed_info( si_doc, FALSE, FALSE, declared_inclusive ? INC : EXC, RSA256, dig, tamper ? "r2" : "r1" );
+    strcpy( doc, "<?xml version=\"1.0\"?><Envelope xmlns=\"urn:env\" xmlns:x=\"urn:x\"><data Id=\"data\">hi</data>" );
+    for (i = 0; i < copies; i++)
+    {
+        sprintf( doc + strlen( doc ), "<Signature xmlns=\"" DSIG "\" Id=\"sig%lu\">%s<SignatureValue>%s</SignatureValue>",
+                 i + 1, si_doc, sig_b64 );
+        sprintf( doc + strlen( doc ), "<KeyInfo Id=\"ki\"><KeyName>test key</KeyName><KeyValue><RSAKeyValue>"
+                 "<Modulus>%s</Modulus><Exponent>%s</Exponent></RSAKeyValue></KeyValue></KeyInfo>"
+                 "<Object Id=\"obj\" MimeType=\"text/plain\"/></Signature>", modulus_b64, exponent_b64 );
+    }
+    strcat( doc, "</Envelope>" );
+    return doc;
+}
+
+static HRESULT open_doc( const char *xml, CRYPT_XML_CHARSET charset, HCRYPTXML *handle )
+{
+    CRYPT_XML_BLOB blob = { charset, strlen( xml ), (BYTE *)xml };
+    return pCryptXmlOpenToDecode( NULL, 0, NULL, 0, &blob, handle );
+}
+
+static void check_blob( const CRYPT_XML_BLOB *blob, const void *data, ULONG len, const char *what )
+{
+    ok( blob->cbData == len, "%s: got %lu, expected %lu\n", what, blob->cbData, len );
+    if (blob->cbData == len) ok( !memcmp( blob->pbData, data, len ), "%s: wrong data\n", what );
+}
+
+static void test_decode(void)
+{
+    char canonical[4096];
+    char *xml = make_doc( FALSE, FALSE, FALSE, canonical, 1 );
+    const CRYPT_XML_DOC_CTXT *ctxt;
+    const CRYPT_XML_SIGNATURE *sig;
+    const CRYPT_XML_REFERENCE *ref;
+    CRYPT_XML_STATUS status;
+    HCRYPTXML handle;
+    HRESULT hr;
+
+    hr = open_doc( xml, CRYPT_XML_CHARSET_AUTO, &handle );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr != S_OK) { free( xml ); return; }
+
+    hr = pCryptXmlGetDocContext( handle, &ctxt );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( ctxt->cbSize == sizeof(*ctxt), "got %lu\n", ctxt->cbSize );
+    ok( ctxt->hDocCtxt == handle, "got %p\n", ctxt->hDocCtxt );
+    ok( ctxt->cSignature == 1, "got %lu\n", ctxt->cSignature );
+    sig = ctxt->rgpSignature[0];
+    ok( sig->cbSize == sizeof(*sig), "got %lu\n", sig->cbSize );
+    ok( !wcscmp( sig->wszId, L"sig1" ), "got %s\n", wine_dbgstr_w( sig->wszId ));
+    ok( !wcscmp( sig->SignedInfo.Canonicalization.wszAlgorithm, L"" EXC ), "got %s\n",
+        wine_dbgstr_w( sig->SignedInfo.Canonicalization.wszAlgorithm ));
+    ok( !wcscmp( sig->SignedInfo.SignatureMethod.wszAlgorithm, L"" RSA256 ), "got %s\n",
+        wine_dbgstr_w( sig->SignedInfo.SignatureMethod.wszAlgorithm ));
+    check_blob( &sig->SignedInfo.Encoded, canonical, strlen( canonical ), "SignedInfo" );
+    ok( sig->SignatureValue.cbData == 256, "got %lu\n", sig->SignatureValue.cbData );
+    ok( sig->cObject == 1, "got %lu\n", sig->cObject );
+    if (sig->cObject)
+    {
+        ok( !wcscmp( sig->rgpObject[0]->wszId, L"obj" ), "got %s\n", wine_dbgstr_w( sig->rgpObject[0]->wszId ));
+        ok( !wcscmp( sig->rgpObject[0]->wszMimeType, L"text/plain" ), "got %s\n",
+            wine_dbgstr_w( sig->rgpObject[0]->wszMimeType ));
+    }
+
+    /* handles */
+    hr = pCryptXmlGetSignature( sig->hSignature, &sig );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( sig == ctxt->rgpSignature[0], "got %p\n", sig );
+    hr = pCryptXmlGetSignature( handle, &sig );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = pCryptXmlGetSignature( (HCRYPTXML)0x1234, &sig );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = pCryptXmlGetSignature( NULL, &sig );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    sig = ctxt->rgpSignature[0];
+
+    /* the references */
+    ok( sig->SignedInfo.cReference == 3, "got %lu\n", sig->SignedInfo.cReference );
+    ref = sig->SignedInfo.rgpReference[0];
+    ok( ref->cbSize == sizeof(*ref), "got %lu\n", ref->cbSize );
+    ok( !wcscmp( ref->wszId, L"r1" ), "got %s\n", wine_dbgstr_w( ref->wszId ));
+    ok( !wcscmp( ref->wszUri, L"#data" ), "got %s\n", wine_dbgstr_w( ref->wszUri ));
+    ok( !wcscmp( ref->wszType, L"urn:t" ), "got %s\n", wine_dbgstr_w( ref->wszType ));
+    ok( !wcscmp( ref->DigestMethod.wszAlgorithm, L"" SHA256 ), "got %s\n", wine_dbgstr_w( ref->DigestMethod.wszAlgorithm ));
+    check_blob( &ref->DigestValue, digest, sizeof(digest), "DigestValue" );
+    ok( ref->cTransform == 2, "got %lu\n", ref->cTransform );
+    if (ref->cTransform == 2)
+    {
+        ok( !wcscmp( ref->rgTransform[0].wszAlgorithm, L"" DSIG L"enveloped-signature" ), "got %s\n",
+            wine_dbgstr_w( ref->rgTransform[0].wszAlgorithm ));
+        ok( !wcscmp( ref->rgTransform[1].wszAlgorithm, L"" EXC ), "got %s\n",
+            wine_dbgstr_w( ref->rgTransform[1].wszAlgorithm ));
+    }
+    hr = pCryptXmlGetReference( ref->hReference, &ref );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( ref == sig->SignedInfo.rgpReference[0], "got %p\n", ref );
+    hr = pCryptXmlGetReference( sig->hSignature, &ref );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ok( !sig->SignedInfo.rgpReference[1]->wszType, "got %s\n", wine_dbgstr_w( sig->SignedInfo.rgpReference[1]->wszType ));
+    ok( !wcscmp( sig->SignedInfo.rgpReference[2]->wszUri, L"http://example.com/x?a=1&b=2" ), "got %s\n",
+        wine_dbgstr_w( sig->SignedInfo.rgpReference[2]->wszUri ));
+
+    /* the key information */
+    ok( sig->pKeyInfo != NULL, "no key info\n" );
+    if (sig->pKeyInfo)
+    {
+        const CRYPT_XML_KEY_INFO *ki = sig->pKeyInfo;
+
+        ok( !wcscmp( ki->wszId, L"ki" ), "got %s\n", wine_dbgstr_w( ki->wszId ));
+        ok( ki->cKeyInfo == 2, "got %lu\n", ki->cKeyInfo );
+        ok( ki->hVerifyKey != NULL, "no key\n" );
+        if (ki->cKeyInfo == 2)
+        {
+            ok( ki->rgKeyInfo[0].dwType == CRYPT_XML_KEYINFO_TYPE_KEYNAME, "got %lu\n", ki->rgKeyInfo[0].dwType );
+            ok( !wcscmp( ki->rgKeyInfo[0].wszKeyName, L"test key" ), "got %s\n",
+                wine_dbgstr_w( ki->rgKeyInfo[0].wszKeyName ));
+            ok( ki->rgKeyInfo[1].dwType == CRYPT_XML_KEYINFO_TYPE_KEYVALUE, "got %lu\n", ki->rgKeyInfo[1].dwType );
+            ok( ki->rgKeyInfo[1].KeyValue.dwType == CRYPT_XML_KEY_VALUE_TYPE_RSA, "got %lu\n",
+                ki->rgKeyInfo[1].KeyValue.dwType );
+            check_blob( &ki->rgKeyInfo[1].KeyValue.RSAKeyValue.Modulus, modulus, 256, "Modulus" );
+        }
+    }
+
+    /* status */
+    hr = pCryptXmlGetStatus( sig->hSignature, &status );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( status.dwErrorStatus == 0, "got %#lx\n", status.dwErrorStatus );
+    ok( status.dwInfoStatus == CRYPT_XML_STATUS_KEY_AVAILABLE, "got %#lx\n", status.dwInfoStatus );
+    hr = pCryptXmlGetStatus( sig->SignedInfo.rgpReference[0]->hReference, &status );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( status.dwErrorStatus == 0, "got %#lx\n", status.dwErrorStatus );
+    ok( status.dwInfoStatus == CRYPT_XML_STATUS_INTERNAL_REFERENCE, "got %#lx\n", status.dwInfoStatus );
+    hr = pCryptXmlGetStatus( sig->SignedInfo.rgpReference[1]->hReference, &status );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( status.dwErrorStatus == CRYPT_XML_STATUS_ERROR_NOT_RESOLVED, "got %#lx\n", status.dwErrorStatus );
+    ok( status.dwInfoStatus == CRYPT_XML_STATUS_INTERNAL_REFERENCE, "got %#lx\n", status.dwInfoStatus );
+    hr = pCryptXmlGetStatus( sig->SignedInfo.rgpReference[2]->hReference, &status );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( status.dwErrorStatus == CRYPT_XML_STATUS_ERROR_NOT_SUPPORTED_TRANSFORM, "got %#lx\n", status.dwErrorStatus );
+    ok( status.dwInfoStatus == 0, "got %#lx\n", status.dwInfoStatus );
+    hr = pCryptXmlGetStatus( handle, &status );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( status.dwErrorStatus == 0, "got %#lx\n", status.dwErrorStatus );
+    hr = pCryptXmlGetStatus( (HCRYPTXML)0x1234, &status );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+
+    /* a reference's handle gives the document too */
+    hr = pCryptXmlGetDocContext( sig->SignedInfo.rgpReference[0]->hReference, &ctxt );
+    ok( hr == S_OK && ctxt->hDocCtxt == handle, "got %#lx\n", hr );
+
+    /* closing a part leaves the document */
+    hr = pCryptXmlClose( sig->SignedInfo.rgpReference[0]->hReference );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = pCryptXmlGetStatus( handle, &status );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = pCryptXmlClose( handle );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = pCryptXmlGetStatus( handle, &status );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = pCryptXmlClose( NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    free( xml );
+}
+
+static void test_charsets_and_limits(void)
+{
+    char *xml = make_doc( FALSE, FALSE, FALSE, NULL, 1 ), *two = make_doc( FALSE, FALSE, FALSE, NULL, 2 );
+    const CRYPT_XML_DOC_CTXT *ctxt;
+    CRYPT_XML_PROPERTY prop;
+    CRYPT_XML_BLOB blob;
+    HCRYPTXML handle;
+    ULONG max = 1;
+    WCHAR *wide;
+    HRESULT hr;
+    int len;
+
+    len = MultiByteToWideChar( CP_UTF8, 0, xml, -1, NULL, 0 ) - 1;
+    wide = malloc( len * sizeof(WCHAR) );
+    MultiByteToWideChar( CP_UTF8, 0, xml, -1, wide, len );
+    blob.dwCharset = CRYPT_XML_CHARSET_UTF16LE;
+    blob.cbData = len * sizeof(WCHAR);
+    blob.pbData = (BYTE *)wide;
+    hr = pCryptXmlOpenToDecode( NULL, 0, NULL, 0, &blob, &handle );
+    ok( hr == S_OK, "UTF-16: got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        pCryptXmlGetDocContext( handle, &ctxt );
+        ok( ctxt->cSignature == 1, "got %lu\n", ctxt->cSignature );
+        ok( ctxt->rgpSignature[0]->SignedInfo.Encoded.cbData > 100, "no SignedInfo\n" );
+        pCryptXmlClose( handle );
+    }
+    free( wide );
+
+    hr = open_doc( two, CRYPT_XML_CHARSET_UTF8, &handle );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        pCryptXmlGetDocContext( handle, &ctxt );
+        ok( ctxt->cSignature == 2, "got %lu\n", ctxt->cSignature );
+        pCryptXmlClose( handle );
+    }
+    prop.dwPropId = CRYPT_XML_PROPERTY_MAX_SIGNATURES;
+    prop.pvValue = &max;
+    prop.cbValue = sizeof(max);
+    blob.dwCharset = CRYPT_XML_CHARSET_AUTO;
+    blob.cbData = strlen( two );
+    blob.pbData = (BYTE *)two;
+    handle = (HCRYPTXML)0xdead;
+    hr = pCryptXmlOpenToDecode( NULL, 0, &prop, 1, &blob, &handle );
+    ok( FAILED(hr), "got %#lx\n", hr );
+    ok( !handle, "got %p\n", handle );
+    free( xml );
+    free( two );
+}
+
+static void test_open_errors(void)
+{
+    static const char dtd[] = "<!DOCTYPE a [<!ENTITY e \"x\">]><a/>";
+    static const char dtd2[] = "<!DOCTYPE a><a/>";
+    static const char none[] = "<a><b/></a>";
+    static const char broken[] = "<a><Signature xmlns=\"" DSIG "\">";
+    static const char nosi[] = "<Signature xmlns=\"" DSIG "\"><SignatureValue>AAAA</SignatureValue></Signature>";
+    CRYPT_XML_BLOB blob = { CRYPT_XML_CHARSET_AUTO, 0, NULL };
+    CRYPT_XML_PROPERTY prop = { 77, NULL, 0 };
+    HCRYPTXML handle;
+    HRESULT hr;
+
+    hr = pCryptXmlOpenToDecode( NULL, 0, NULL, 0, &blob, &handle );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = pCryptXmlOpenToDecode( NULL, 0, NULL, 0, NULL, &handle );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = open_doc( none, CRYPT_XML_CHARSET_AUTO, NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = open_doc( none, CRYPT_XML_CHARSET_AUTO, &handle );
+    ok( hr == CRYPT_E_NOT_FOUND, "got %#lx\n", hr );
+    ok( !handle, "got %p\n", handle );
+    hr = open_doc( dtd, CRYPT_XML_CHARSET_AUTO, &handle );
+    ok( FAILED(hr) && hr != CRYPT_E_NOT_FOUND, "got %#lx\n", hr );
+    hr = open_doc( dtd2, CRYPT_XML_CHARSET_AUTO, &handle );
+    ok( FAILED(hr) && hr != CRYPT_E_NOT_FOUND, "got %#lx\n", hr );
+    hr = open_doc( broken, CRYPT_XML_CHARSET_AUTO, &handle );
+    ok( FAILED(hr), "got %#lx\n", hr );
+    hr = open_doc( nosi, CRYPT_XML_CHARSET_AUTO, &handle );
+    ok( FAILED(hr), "got %#lx\n", hr );
+    blob.pbData = (BYTE *)none;
+    blob.cbData = sizeof(none) - 1;
+    hr = pCryptXmlOpenToDecode( NULL, 0x1, NULL, 0, &blob, &handle );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = pCryptXmlOpenToDecode( NULL, 0, &prop, 1, &blob, &handle );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    blob.dwCharset = 9;
+    hr = pCryptXmlOpenToDecode( NULL, 0, NULL, 0, &blob, &handle );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+}
+
+static void test_verify(void)
+{
+    static const struct
+    {
+        BOOL declared_inclusive, signed_inclusive, tamper, valid;
+        const char *name;
+    } tests[] =
+    {
+        { FALSE, FALSE, FALSE, TRUE,  "exclusive" },
+        { TRUE,  TRUE,  FALSE, TRUE,  "inclusive" },
+        { TRUE,  FALSE, FALSE, FALSE, "declared inclusive, signed exclusive" },
+        { FALSE, TRUE,  FALSE, FALSE, "declared exclusive, signed inclusive" },
+        { FALSE, FALSE, TRUE,  FALSE, "tampered" },
+    };
+    BCRYPT_ALG_HANDLE alg;
+    BCRYPT_KEY_HANDLE pub;
+    BCRYPT_RSAKEY_BLOB *blob;
+    CRYPT_XML_STATUS status;
+    BYTE *buf;
+    ULONG size, i;
+    NTSTATUS nts;
+    HRESULT hr;
+
+    BCryptExportKey( key, NULL, BCRYPT_RSAPUBLIC_BLOB, NULL, 0, &size, 0 );
+    buf = malloc( size );
+    BCryptExportKey( key, NULL, BCRYPT_RSAPUBLIC_BLOB, buf, size, &size, 0 );
+    blob = (BCRYPT_RSAKEY_BLOB *)buf;
+    nts = BCryptOpenAlgorithmProvider( &alg, BCRYPT_RSA_ALGORITHM, NULL, 0 );
+    ok( !nts, "got %#lx\n", nts );
+    nts = BCryptImportKeyPair( alg, NULL, BCRYPT_RSAPUBLIC_BLOB, &pub, buf, size, 0 );
+    ok( !nts, "got %#lx\n", nts );
+    (void)blob;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        char *xml = make_doc( tests[i].declared_inclusive, tests[i].signed_inclusive, tests[i].tamper, NULL, 1 );
+        const CRYPT_XML_DOC_CTXT *ctxt;
+        const CRYPT_XML_SIGNATURE *sig;
+        HCRYPTXML handle;
+
+        hr = open_doc( xml, CRYPT_XML_CHARSET_AUTO, &handle );
+        ok( hr == S_OK, "%s: got %#lx\n", tests[i].name, hr );
+        if (hr == S_OK)
+        {
+            pCryptXmlGetDocContext( handle, &ctxt );
+            sig = ctxt->rgpSignature[0];
+
+            /* the key of the KeyInfo, then a key given */
+            hr = pCryptXmlVerifySignature( sig->hSignature, NULL, 0 );
+            ok( hr == (tests[i].valid ? S_OK : NTE_BAD_SIGNATURE), "%s: got %#lx\n", tests[i].name, hr );
+            pCryptXmlGetStatus( sig->hSignature, &status );
+            if (tests[i].valid)
+            {
+                ok( status.dwInfoStatus & CRYPT_XML_STATUS_SIGNATURE_VALID, "%s: got %#lx\n", tests[i].name, status.dwInfoStatus );
+                ok( !(status.dwErrorStatus & CRYPT_XML_STATUS_ERROR_SIGNATURE_INVALID), "%s: got %#lx\n",
+                    tests[i].name, status.dwErrorStatus );
+            }
+            else
+            {
+                ok( !(status.dwInfoStatus & CRYPT_XML_STATUS_SIGNATURE_VALID), "%s: got %#lx\n", tests[i].name, status.dwInfoStatus );
+                ok( status.dwErrorStatus & CRYPT_XML_STATUS_ERROR_SIGNATURE_INVALID, "%s: got %#lx\n",
+                    tests[i].name, status.dwErrorStatus );
+            }
+            hr = pCryptXmlVerifySignature( sig->hSignature, pub, 0 );
+            ok( hr == (tests[i].valid ? S_OK : NTE_BAD_SIGNATURE), "%s: got %#lx\n", tests[i].name, hr );
+            pCryptXmlClose( handle );
+        }
+        free( xml );
+    }
+
+    /* a document without a key information needs a key */
+    {
+        char *xml = make_doc( FALSE, FALSE, FALSE, NULL, 1 ), *p;
+        const CRYPT_XML_DOC_CTXT *ctxt;
+        HCRYPTXML handle;
+
+        p = strstr( xml, "<KeyInfo" );
+        memmove( p, strstr( p, "<Object" ), strlen( strstr( p, "<Object" )) + 1 );
+        hr = open_doc( xml, CRYPT_XML_CHARSET_AUTO, &handle );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        if (hr == S_OK)
+        {
+            pCryptXmlGetDocContext( handle, &ctxt );
+            ok( !ctxt->rgpSignature[0]->pKeyInfo, "got %p\n", ctxt->rgpSignature[0]->pKeyInfo );
+            hr = pCryptXmlVerifySignature( ctxt->rgpSignature[0]->hSignature, NULL, 0 );
+            ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+            hr = pCryptXmlVerifySignature( ctxt->rgpSignature[0]->hSignature, pub, 0 );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            hr = pCryptXmlVerifySignature( ctxt->rgpSignature[0]->hSignature, pub, 0x1 );
+            ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+            hr = pCryptXmlVerifySignature( handle, pub, 0 );
+            ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+            pCryptXmlClose( handle );
+        }
+        free( xml );
+    }
+    BCryptDestroyKey( pub );
+    BCryptCloseAlgorithmProvider( alg, 0 );
+    free( buf );
+}
+
+START_TEST(cryptxml)
+{
+    HMODULE module = LoadLibraryA( "cryptxml.dll" );
+
+    if (!module)
+    {
+        win_skip( "cryptxml.dll not available\n" );
+        return;
+    }
+#define X(name) p##name = (void *)GetProcAddress( module, #name )
+    X(CryptXmlOpenToDecode);
+    X(CryptXmlClose);
+    X(CryptXmlGetStatus);
+    X(CryptXmlGetDocContext);
+    X(CryptXmlGetSignature);
+    X(CryptXmlGetReference);
+    X(CryptXmlVerifySignature);
+#undef X
+
+    if (!make_key())
+    {
+        skip( "no RSA\n" );
+        return;
+    }
+    test_open_errors();
+    test_decode();
+    test_charsets_and_limits();
+    test_verify();
+    BCryptDestroyKey( key );
+}
