+static void base64( const BYTE *in, ULONG len, char *out )
+{
+    static const char tab[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    ULONG i;
+
+    for (i = 0; i < len; i += 3)
+    {
+        ULONG v = in[i] << 16 | (i + 1 < len ? in[i + 1] << 8 : 0) | (i + 2 < len ? in[i + 2] : 0);
+        *out++ = tab[v >> 18];
+        *out++ = tab[(v >> 12) & 63];
+        *out++ = i + 1 < len ? tab[(v >> 6) & 63] : '=';
+        *out++ = i + 2 < len ? tab[v & 63] : '=';
+    }
+    *out = 0;
