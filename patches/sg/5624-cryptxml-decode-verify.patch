+static const WCHAR dsig_ns[] = L"http://www.w3.org/2000/09/xmldsig#";
+
+enum obj_type { OBJ_DOC = 1, OBJ_SIG, OBJ_REF };
+
+struct obj
+{
+    enum obj_type type;
+    struct doc *doc;
+};
+
+struct ref
+{
+    struct obj obj;
+    CRYPT_XML_REFERENCE pub;
+    struct sig *sig;
+    DWORD err, info;
+};
+
+struct sig
+{
+    struct obj obj;
+    CRYPT_XML_SIGNATURE pub;
+    CRYPT_XML_KEY_INFO key_info;
+    struct xnode *node, *signed_info;
+    struct ref **refs;
+    BCRYPT_ALG_HANDLE key_alg;
+    DWORD err, info;
+};
+
+struct doc
+{
+    struct obj obj;
+    CRYPT_XML_DOC_CTXT pub;
+    struct arena arena;
+    struct xnode *root;
+    struct sig **sigs;
+    struct doc *next;
+};
+
+static CRITICAL_SECTION lock;
+static CRITICAL_SECTION_DEBUG lock_debug =
+{
+    0, 0, &lock,
+    { &lock_debug.ProcessLocksList, &lock_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": lock") }
+};
+static CRITICAL_SECTION lock = { &lock_debug, -1, 0, 0, 0, 0 };
+static struct doc *docs;
+
+/* a handle is only believed when it is one of ours */
+static struct obj *find_obj( HCRYPTXML handle )
+{
+    struct doc *doc;
+    ULONG i, j;
+
+    for (doc = docs; doc; doc = doc->next)
+    {
+        if ((void *)doc == handle) return &doc->obj;
+        for (i = 0; i < doc->pub.cSignature; i++)
+        {
+            struct sig *sig = doc->sigs[i];
+            if ((void *)sig == handle) return &sig->obj;
+            for (j = 0; j < sig->pub.SignedInfo.cReference; j++)
+                if ((void *)sig->refs[j] == handle) return &sig->refs[j]->obj;
+        }
+    }
+    return NULL;
+}
+
+/* elements and attributes */
+
+static struct xnode *child( const struct xnode *e, const WCHAR *local, struct xnode *after )
+{
+    ULONG i = 0;
+
+    if (after) while (i < e->nkids && e->kids[i++] != after) ;
+    for (; i < e->nkids; i++)
+    {
+        struct xnode *k = e->kids[i];
+        if (!k->is_text && !wcscmp( k->ns, dsig_ns ) && !wcscmp( k->local, local )) return k;
+    }
+    return NULL;
+}
+
+static const WCHAR *attr( const struct xnode *e, const WCHAR *local )
+{
+    ULONG i;
+
+    for (i = 0; i < e->nattrs; i++)
+        if (!e->attrs[i].prefix[0] && !wcscmp( e->attrs[i].local, local )) return e->attrs[i].value;
+    return NULL;
+}
+
+static WCHAR *text_of( struct arena *a, const struct xnode *e )
+{
+    SIZE_T len = 0, pos = 0;
+    ULONG i;
+    WCHAR *ret;
+
+    for (i = 0; i < e->nkids; i++) if (e->kids[i]->is_text) len += e->kids[i]->text_len;
+    if (!(ret = arena_alloc( a, (len + 1) * sizeof(WCHAR) ))) return NULL;
+    for (i = 0; i < e->nkids; i++)
+        if (e->kids[i]->is_text)
+        {
+            memcpy( ret + pos, e->kids[i]->text, e->kids[i]->text_len * sizeof(WCHAR) );
+            pos += e->kids[i]->text_len;
+        }
+    return ret;
+}
+
+static BOOL base64_decode( struct arena *a, const WCHAR *str, CRYPT_XML_BLOB *blob )
+{
+    SIZE_T len = wcslen( str ), i;
+    BYTE *out;
+    ULONG acc = 0, bits = 0, n = 0;
+
+    if (!(out = arena_alloc( a, len / 4 * 3 + 3 ))) return FALSE;
+    for (i = 0; i < len; i++)
+    {
+        WCHAR ch = str[i];
+        int v;
+
+        if (ch >= 'A' && ch <= 'Z') v = ch - 'A';
+        else if (ch >= 'a' && ch <= 'z') v = ch - 'a' + 26;
+        else if (ch >= '0' && ch <= '9') v = ch - '0' + 52;
+        else if (ch == '+') v = 62;
+        else if (ch == '/') v = 63;
+        else if (ch == '=') break;
+        else if (ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n') continue;
+        else return FALSE;
+        acc = (acc << 6) | v;
+        bits += 6;
+        if (bits >= 8)
+        {
+            bits -= 8;
+            out[n++] = (acc >> bits) & 0xff;
+        }
+    }
+    blob->dwCharset = CRYPT_XML_CHARSET_UTF8;
+    blob->cbData = n;
+    blob->pbData = out;
+    return TRUE;
+}
+
+/* algorithms */
+
+#define DSIG_MORE L"http://www.w3.org/2001/04/xmldsig-more#"
+
+enum sign_kind { SIGN_RSA = 1, SIGN_DSA, SIGN_ECDSA };
+
+static const struct
+{
+    const WCHAR *uri;
+    enum sign_kind kind;
+    const WCHAR *hash;
+} sign_methods[] =
+{
+    { L"http://www.w3.org/2000/09/xmldsig#rsa-sha1", SIGN_RSA, BCRYPT_SHA1_ALGORITHM },
+    { DSIG_MORE L"rsa-sha256", SIGN_RSA, BCRYPT_SHA256_ALGORITHM },
+    { DSIG_MORE L"rsa-sha384", SIGN_RSA, BCRYPT_SHA384_ALGORITHM },
+    { DSIG_MORE L"rsa-sha512", SIGN_RSA, BCRYPT_SHA512_ALGORITHM },
+    { L"http://www.w3.org/2000/09/xmldsig#dsa-sha1", SIGN_DSA, BCRYPT_SHA1_ALGORITHM },
+    { DSIG_MORE L"ecdsa-sha1", SIGN_ECDSA, BCRYPT_SHA1_ALGORITHM },
+    { DSIG_MORE L"ecdsa-sha256", SIGN_ECDSA, BCRYPT_SHA256_ALGORITHM },
+    { DSIG_MORE L"ecdsa-sha384", SIGN_ECDSA, BCRYPT_SHA384_ALGORITHM },
+    { DSIG_MORE L"ecdsa-sha512", SIGN_ECDSA, BCRYPT_SHA512_ALGORITHM },
+};
+
+static const WCHAR *digest_methods[] =
+{
+    L"http://www.w3.org/2000/09/xmldsig#sha1",
+    L"http://www.w3.org/2001/04/xmlenc#sha256",
+    DSIG_MORE L"sha384",
+    L"http://www.w3.org/2001/04/xmlenc#sha512",
+};
+
+static const WCHAR *transforms[] =
+{
+    L"http://www.w3.org/2000/09/xmldsig#enveloped-signature",
+    L"http://www.w3.org/2000/09/xmldsig#base64",
+    L"http://www.w3.org/TR/2001/REC-xml-c14n-20010315",
+    L"http://www.w3.org/2001/10/xml-exc-c14n#",
+};
+
+#define C14N_INCLUSIVE L"http://www.w3.org/TR/2001/REC-xml-c14n-20010315"
+#define C14N_EXCLUSIVE L"http://www.w3.org/2001/10/xml-exc-c14n#"
+
+static BOOL in_list( const WCHAR *uri, const WCHAR **list, ULONG count )
+{
+    ULONG i;
+
+    if (!uri) return FALSE;
+    for (i = 0; i < count; i++) if (!wcscmp( uri, list[i] )) return TRUE;
+    return FALSE;
+}
+
+static int find_sign_method( const WCHAR *uri )
+{
+    int i;
+
+    if (!uri) return -1;
+    for (i = 0; i < ARRAY_SIZE(sign_methods); i++) if (!wcscmp( uri, sign_methods[i].uri )) return i;
+    return -1;
+}
+
+static int c14n_kind( const WCHAR *uri )
+{
+    if (!uri) return -1;
+    if (!wcscmp( uri, C14N_INCLUSIVE )) return 0;
+    if (!wcscmp( uri, C14N_EXCLUSIVE )) return 1;
+    return -1;
+}
+
+/* the elements of a document that carry an Id */
+static BOOL id_exists( const struct xnode *e, const WCHAR *id )
+{
+    ULONG i;
+
+    if (e->is_text) return FALSE;
+    for (i = 0; i < e->nattrs; i++)
+        if (!e->attrs[i].prefix[0] && (!wcscmp( e->attrs[i].local, L"Id" ) || !wcscmp( e->attrs[i].local, L"ID" ) ||
+                                         !wcscmp( e->attrs[i].local, L"id" )) && !wcscmp( e->attrs[i].value, id ))
+            return TRUE;
+    for (i = 0; i < e->nkids; i++) if (id_exists( e->kids[i], id )) return TRUE;
+    return FALSE;
+}
+
+/* building the structures */
+
+static HRESULT parse_reference( struct doc *doc, struct sig *sig, struct xnode *node, struct ref **ret )
+{
+    struct arena *a = &doc->arena;
+    struct xnode *e, *list;
+    struct ref *ref;
+    ULONG n = 0, i;
+    CRYPT_XML_ALGORITHM *algs;
+    const WCHAR *str;
+
+    if (!(ref = arena_alloc( a, sizeof(*ref) ))) return E_OUTOFMEMORY;
+    ref->obj.type = OBJ_REF;
+    ref->obj.doc = doc;
+    ref->sig = sig;
+    ref->pub.cbSize = sizeof(ref->pub);
+    ref->pub.hReference = ref;
+    ref->pub.wszId = attr( node, L"Id" );
+    ref->pub.wszUri = attr( node, L"URI" );
+    ref->pub.wszType = attr( node, L"Type" );
+    ref->pub.DigestMethod.cbSize = sizeof(ref->pub.DigestMethod);
+    if ((e = child( node, L"DigestMethod", NULL ))) ref->pub.DigestMethod.wszAlgorithm = attr( e, L"Algorithm" );
+    ref->pub.DigestMethod.Encoded.dwCharset = CRYPT_XML_CHARSET_UTF8;
+    if ((e = child( node, L"DigestValue", NULL )))
+    {
+        if (!(str = text_of( a, e ))) return E_OUTOFMEMORY;
+        if (!base64_decode( a, str, &ref->pub.DigestValue )) return HRESULT_FROM_WIN32( ERROR_INVALID_DATA );
+    }
+    if ((list = child( node, L"Transforms", NULL )))
+    {
+        for (e = child( list, L"Transform", NULL ); e; e = child( list, L"Transform", e )) n++;
+        if (n)
+        {
+            if (!(algs = arena_alloc( a, n * sizeof(*algs) ))) return E_OUTOFMEMORY;
+            for (i = 0, e = child( list, L"Transform", NULL ); e; e = child( list, L"Transform", e ), i++)
+            {
+                algs[i].cbSize = sizeof(algs[i]);
+                algs[i].wszAlgorithm = attr( e, L"Algorithm" );
+                algs[i].Encoded.dwCharset = CRYPT_XML_CHARSET_UTF8;
+            }
+            ref->pub.cTransform = n;
+            ref->pub.rgTransform = algs;
+        }
+    }
+
+    /* what can be said without digesting anything */
+    str = ref->pub.wszUri;
+    if (str && (!str[0] || str[0] == '#'))
+    {
+        ref->info |= CRYPT_XML_STATUS_INTERNAL_REFERENCE;
+        if (str[0] == '#' && !id_exists( doc->root, str + 1 )) ref->err |= CRYPT_XML_STATUS_ERROR_NOT_RESOLVED;
+    }
+    if (!in_list( ref->pub.DigestMethod.wszAlgorithm, digest_methods, ARRAY_SIZE(digest_methods) ))
+        ref->err |= CRYPT_XML_STATUS_ERROR_NOT_SUPPORTED_ALGORITHM;
+    for (i = 0; i < ref->pub.cTransform; i++)
+        if (!in_list( ref->pub.rgTransform[i].wszAlgorithm, transforms, ARRAY_SIZE(transforms) ))
+            ref->err |= CRYPT_XML_STATUS_ERROR_NOT_SUPPORTED_TRANSFORM;
+    *ret = ref;
+    return S_OK;
+}
+
+static BOOL import_rsa_key( struct doc *doc, struct sig *sig, struct xnode *rsa, CRYPT_XML_KEY_RSA_KEY_VALUE *value )
 {
-    FIXME( "%p %#lx %p %lu %p %p: stub\n", config, flags, properties, property_count,
-           encoded, crypt_xml );
-    if (crypt_xml) *crypt_xml = NULL;
-    return E_NOTIMPL;
+    struct xnode *m = child( rsa, L"Modulus", NULL ), *x = child( rsa, L"Exponent", NULL );
+    BCRYPT_RSAKEY_BLOB *blob;
+    BYTE *mod, *exp;
+    ULONG size, mod_len, exp_len;
+    BCRYPT_KEY_HANDLE key;
+    WCHAR *str;
+
+    if (!m || !x) return FALSE;
+    if (!(str = text_of( &doc->arena, m )) || !base64_decode( &doc->arena, str, &value->Modulus )) return FALSE;
+    if (!(str = text_of( &doc->arena, x )) || !base64_decode( &doc->arena, str, &value->Exponent )) return FALSE;
+    mod = value->Modulus.pbData;
+    mod_len = value->Modulus.cbData;
+    exp = value->Exponent.pbData;
+    exp_len = value->Exponent.cbData;
+    while (mod_len && !*mod) { mod++; mod_len--; }
+    while (exp_len && !*exp) { exp++; exp_len--; }
+    if (!mod_len || !exp_len || mod_len > 2048 || exp_len > mod_len) return FALSE;
+
+    size = sizeof(*blob) + exp_len + mod_len;
+    if (!(blob = arena_alloc( &doc->arena, size ))) return FALSE;
+    blob->Magic = BCRYPT_RSAPUBLIC_MAGIC;
+    blob->BitLength = mod_len * 8;
+    blob->cbPublicExp = exp_len;
+    blob->cbModulus = mod_len;
+    memcpy( blob + 1, exp, exp_len );
+    memcpy( (BYTE *)(blob + 1) + exp_len, mod, mod_len );
+    if (!sig->key_alg && BCryptOpenAlgorithmProvider( &sig->key_alg, BCRYPT_RSA_ALGORITHM, NULL, 0 )) return FALSE;
+    if (BCryptImportKeyPair( sig->key_alg, NULL, BCRYPT_RSAPUBLIC_BLOB, &key, (BYTE *)blob, size, 0 )) return FALSE;
+    sig->key_info.hVerifyKey = key;
+    return TRUE;
 }
 
-HRESULT WINAPI CryptXmlClose( void *crypt_xml )
+static HRESULT parse_key_info( struct doc *doc, struct sig *sig, struct xnode *node )
+{
+    struct arena *a = &doc->arena;
+    CRYPT_XML_KEY_INFO *info = &sig->key_info;
+    CRYPT_XML_KEY_INFO_ITEM *items;
+    struct xnode *e;
+    ULONG n = 0, i;
+
+    info->cbSize = sizeof(*info);
+    info->wszId = attr( node, L"Id" );
+    sig->pub.pKeyInfo = info;
+    for (i = 0; i < node->nkids; i++) if (!node->kids[i]->is_text) n++;
+    if (!n) return S_OK;
+    if (!(items = arena_alloc( a, n * sizeof(*items) ))) return E_OUTOFMEMORY;
+    info->rgKeyInfo = items;
+    for (i = 0, n = 0; i < node->nkids; i++)
+    {
+        e = node->kids[i];
+        if (e->is_text) continue;
+        if (!wcscmp( e->ns, dsig_ns ) && !wcscmp( e->local, L"KeyName" ))
+        {
+            items[n].dwType = CRYPT_XML_KEYINFO_TYPE_KEYNAME;
+            if (!(items[n].wszKeyName = text_of( a, e ))) return E_OUTOFMEMORY;
+            n++;
+        }
+        else if (!wcscmp( e->ns, dsig_ns ) && !wcscmp( e->local, L"KeyValue" ))
+        {
+            struct xnode *rsa = child( e, L"RSAKeyValue", NULL );
+
+            if (rsa && import_rsa_key( doc, sig, rsa, &items[n].KeyValue.RSAKeyValue ))
+            {
+                items[n].dwType = CRYPT_XML_KEYINFO_TYPE_KEYVALUE;
+                items[n].KeyValue.dwType = CRYPT_XML_KEY_VALUE_TYPE_RSA;
+                n++;
+            }
+            else sig->err |= CRYPT_XML_STATUS_ERROR_KEYINFO_NOT_PARSED;
+        }
+        else sig->err |= CRYPT_XML_STATUS_ERROR_KEYINFO_NOT_PARSED;
+    }
+    info->cKeyInfo = n;
+    if (info->hVerifyKey) sig->info |= CRYPT_XML_STATUS_KEY_AVAILABLE;
+    return S_OK;
+}
+
+static HRESULT parse_signature( struct doc *doc, struct xnode *node, struct sig **ret )
+{
+    struct arena *a = &doc->arena;
+    struct xnode *si, *e;
+    struct sig *sig;
+    const WCHAR *str;
+    ULONG n = 0, i;
+    HRESULT hr;
+
+    if (!(sig = arena_alloc( a, sizeof(*sig) ))) return E_OUTOFMEMORY;
+    sig->obj.type = OBJ_SIG;
+    sig->obj.doc = doc;
+    sig->node = node;
+    sig->pub.cbSize = sizeof(sig->pub);
+    sig->pub.hSignature = sig;
+    sig->pub.wszId = attr( node, L"Id" );
+    *ret = sig;
+
+    if (!(si = child( node, L"SignedInfo", NULL ))) return HRESULT_FROM_WIN32( ERROR_INVALID_DATA );
+    sig->signed_info = si;
+    sig->pub.SignedInfo.cbSize = sizeof(sig->pub.SignedInfo);
+    sig->pub.SignedInfo.wszId = attr( si, L"Id" );
+    sig->pub.SignedInfo.Canonicalization.cbSize = sizeof(CRYPT_XML_ALGORITHM);
+    sig->pub.SignedInfo.SignatureMethod.cbSize = sizeof(CRYPT_XML_ALGORITHM);
+    if ((e = child( si, L"CanonicalizationMethod", NULL ))) sig->pub.SignedInfo.Canonicalization.wszAlgorithm = attr( e, L"Algorithm" );
+    if ((e = child( si, L"SignatureMethod", NULL ))) sig->pub.SignedInfo.SignatureMethod.wszAlgorithm = attr( e, L"Algorithm" );
+    if (!sig->pub.SignedInfo.Canonicalization.wszAlgorithm || !sig->pub.SignedInfo.SignatureMethod.wszAlgorithm)
+        return HRESULT_FROM_WIN32( ERROR_INVALID_DATA );
+    if (c14n_kind( sig->pub.SignedInfo.Canonicalization.wszAlgorithm ) < 0 ||
+        find_sign_method( sig->pub.SignedInfo.SignatureMethod.wszAlgorithm ) < 0)
+        sig->err |= CRYPT_XML_STATUS_ERROR_NOT_SUPPORTED_ALGORITHM;
+
+    for (e = child( si, L"Reference", NULL ); e; e = child( si, L"Reference", e )) n++;
+    if (n)
+    {
+        if (!(sig->refs = arena_alloc( a, n * sizeof(*sig->refs) )) ||
+            !(sig->pub.SignedInfo.rgpReference = arena_alloc( a, n * sizeof(*sig->pub.SignedInfo.rgpReference) )))
+            return E_OUTOFMEMORY;
+        for (i = 0, e = child( si, L"Reference", NULL ); e; e = child( si, L"Reference", e ), i++)
+        {
+            if (FAILED(hr = parse_reference( doc, sig, e, &sig->refs[i] ))) return hr;
+            sig->pub.SignedInfo.rgpReference[i] = &sig->refs[i]->pub;
+            sig->pub.SignedInfo.cReference = i + 1;
+        }
+    }
+
+    if (!(e = child( node, L"SignatureValue", NULL ))) return HRESULT_FROM_WIN32( ERROR_INVALID_DATA );
+    if (!(str = text_of( a, e ))) return E_OUTOFMEMORY;
+    if (!base64_decode( a, str, &sig->pub.SignatureValue )) return HRESULT_FROM_WIN32( ERROR_INVALID_DATA );
+
+    if ((e = child( node, L"KeyInfo", NULL )) && FAILED(hr = parse_key_info( doc, sig, e ))) return hr;
+
+    for (n = 0, e = child( node, L"Object", NULL ); e; e = child( node, L"Object", e )) n++;
+    if (n)
+    {
+        CRYPT_XML_OBJECT *objs;
+
+        if (!(sig->pub.rgpObject = arena_alloc( a, n * sizeof(*sig->pub.rgpObject) )) ||
+            !(objs = arena_alloc( a, n * sizeof(*objs) )))
+            return E_OUTOFMEMORY;
+        for (i = 0, e = child( node, L"Object", NULL ); e; e = child( node, L"Object", e ), i++)
+        {
+            objs[i].cbSize = sizeof(objs[i]);
+            objs[i].hObject = NULL;
+            objs[i].wszId = attr( e, L"Id" );
+            objs[i].wszMimeType = attr( e, L"MimeType" );
+            objs[i].wszEncoding = attr( e, L"Encoding" );
+            sig->pub.rgpObject[i] = &objs[i];
+        }
+        sig->pub.cObject = n;
+    }
+
+    if (!sig->err)
+    {
+        BYTE *data;
