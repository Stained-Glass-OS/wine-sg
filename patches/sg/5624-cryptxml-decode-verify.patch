+                         const char *digest_b64, const char *ref_id )
+{
+    out[0] = 0;
+    if (!canon) strcat( out, "<SignedInfo> <!-- a comment --> " );
+    else strcat( out, inclusive ? "<SignedInfo xmlns=\"" DSIG "\" xmlns:x=\"urn:x\">  "
+                                : "<SignedInfo xmlns=\"" DSIG "\">  " );
+    sprintf( out + strlen( out ), canon ? "<CanonicalizationMethod Algorithm=\"%s\"></CanonicalizationMethod>"
+                                        : "<CanonicalizationMethod Algorithm='%s'/>", c14n_uri );
+    sprintf( out + strlen( out ), canon ? "<SignatureMethod Algorithm=\"%s\"></SignatureMethod>"
+                                        : "<SignatureMethod Algorithm=\"%s\"/>", sig_uri );
+    sprintf( out + strlen( out ), canon ? "<Reference Id=\"%s\" Type=\"urn:t\" URI=\"#data\">"
+                                        : "<Reference URI='#data' Id=\"%s\" Type=\"urn:t\">", ref_id );
+    strcat( out, "<Transforms>" );
+    strcat( out, canon ? "<Transform Algorithm=\"" DSIG "enveloped-signature\"></Transform>"
+                       : "<Transform Algorithm=\"" DSIG "enveloped-signature\"/>" );
+    strcat( out, canon ? "<Transform Algorithm=\"" EXC "\"></Transform>" : "<Transform Algorithm=\"" EXC "\"/>" );
+    strcat( out, "</Transforms>" );
+    strcat( out, canon ? "<DigestMethod Algorithm=\"" SHA256 "\"></DigestMethod>" : "<DigestMethod Algorithm=\"" SHA256 "\"/>" );
+    sprintf( out + strlen( out ), "<DigestValue>%s</DigestValue></Reference>", digest_b64 );
