+enum str_kind { STR_PREFIX, STR_LOCAL, STR_NS };
+
+static WCHAR *reader_string( struct arena *a, IXmlReader *reader, enum str_kind kind )
+{
+    const WCHAR *str = NULL;
+    UINT len = 0;
+    HRESULT hr;
+
+    switch (kind)
+    {
+    case STR_PREFIX: hr = IXmlReader_GetPrefix( reader, &str, &len ); break;
+    case STR_LOCAL: hr = IXmlReader_GetLocalName( reader, &str, &len ); break;
+    default: hr = IXmlReader_GetNamespaceUri( reader, &str, &len ); break;
+    }
+    if (FAILED(hr) || !str) return arena_strdup( a, L"", 0 );
+    return arena_strdup( a, str, len );
+}
+
+static HRESULT read_attributes( struct arena *a, IXmlReader *reader, struct xnode *node )
+{
+    HRESULT hr;
+    UINT n = 0;
+
+    if (FAILED(hr = IXmlReader_GetAttributeCount( reader, &n ))) return hr;
+    if (!n) return S_OK;
+    if (!(node->attrs = arena_alloc( a, n * sizeof(*node->attrs) ))) return E_OUTOFMEMORY;
+    if (IXmlReader_MoveToFirstAttribute( reader ) != S_OK) return S_OK;
+    do
+    {
+        struct xattr *attr = &node->attrs[node->nattrs];
+        const WCHAR *value = NULL;
+        UINT len = 0;
+
+        if (node->nattrs == n) break;
+        attr->prefix = reader_string( a, reader, STR_PREFIX );
+        attr->local = reader_string( a, reader, STR_LOCAL );
+        attr->ns = reader_string( a, reader, STR_NS );
+        if (FAILED(hr = IXmlReader_GetValue( reader, &value, &len ))) return hr;
+        attr->value = arena_strdup( a, value, len );
+        if (!attr->prefix || !attr->local || !attr->ns || !attr->value) return E_OUTOFMEMORY;
+        node->nattrs++;
+    } while (IXmlReader_MoveToNextAttribute( reader ) == S_OK);
+    IXmlReader_MoveToElement( reader );
+    return S_OK;
+}
+
+static HRESULT append_text( struct arena *a, struct xnode *parent, const WCHAR *text, UINT len )
+{
+    struct xnode *last = parent->nkids ? parent->kids[parent->nkids - 1] : NULL;
+    struct xnode *node;
+    WCHAR *str;
+
+    if (last && last->is_text)  /* CDATA next to text */
+    {
+        if (!(str = arena_alloc( a, (last->text_len + len + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+        memcpy( str, last->text, last->text_len * sizeof(WCHAR) );
+        memcpy( str + last->text_len, text, len * sizeof(WCHAR) );
+        last->text = str;
+        last->text_len += len;
+        return S_OK;
+    }
+    if (!(node = arena_alloc( a, sizeof(*node) ))) return E_OUTOFMEMORY;
+    node->is_text = TRUE;
+    if (!(node->text = arena_strdup( a, text, len ))) return E_OUTOFMEMORY;
+    node->text_len = len;
+    return add_kid( a, parent, node ) ? S_OK : E_OUTOFMEMORY;
+}
+
+HRESULT xml_parse( const BYTE *data, ULONG size, CRYPT_XML_CHARSET charset, struct arena *a, struct xnode **root )
+{
+    IXmlReader *reader = NULL;
+    IStream *stream = NULL;
+    struct xnode *doc, *cur;
+    XmlNodeType type;
+    HGLOBAL mem;
+    BYTE *ptr;
+    ULONG nodes = 0, depth = 0, bom = 0;
+    HRESULT hr;
+
+    *root = NULL;
+    if (charset > CRYPT_XML_CHARSET_UTF16BE) return E_INVALIDARG;
+    if (!data || !size) return E_INVALIDARG;
+
+    /* the explicit UTF-16 forms get their byte order mark, which is how the reader is told */
+    if (charset == CRYPT_XML_CHARSET_UTF16LE && !(size >= 2 && data[0] == 0xff && data[1] == 0xfe)) bom = 2;
+    if (charset == CRYPT_XML_CHARSET_UTF16BE && !(size >= 2 && data[0] == 0xfe && data[1] == 0xff)) bom = 2;
+    if (!(mem = GlobalAlloc( GMEM_MOVEABLE, size + bom ))) return E_OUTOFMEMORY;
+    ptr = GlobalLock( mem );
+    if (bom)
+    {
+        ptr[0] = charset == CRYPT_XML_CHARSET_UTF16LE ? 0xff : 0xfe;
+        ptr[1] = charset == CRYPT_XML_CHARSET_UTF16LE ? 0xfe : 0xff;
+    }
+    memcpy( ptr + bom, data, size );
+    GlobalUnlock( mem );
+    if (FAILED(hr = CreateStreamOnHGlobal( mem, TRUE, &stream ))) { GlobalFree( mem ); return hr; }
+
+    if (!(doc = arena_alloc( a, sizeof(*doc) ))) { hr = E_OUTOFMEMORY; goto done; }
+    if (FAILED(hr = CreateXmlReader( &IID_IXmlReader, (void **)&reader, NULL ))) goto done;
+    if (FAILED(hr = IXmlReader_SetProperty( reader, XmlReaderProperty_DtdProcessing,
+#ifdef SG_MUTANT_NO_DTD_BAN
+                                                      DtdProcessing_Parse
+#else
+                                                      DtdProcessing_Prohibit
+#endif
+                                                    )))
+        goto done;
+    if (FAILED(hr = IXmlReader_SetInput( reader, (IUnknown *)stream ))) goto done;
+
+    cur = doc;
+    while ((hr = IXmlReader_Read( reader, &type )) == S_OK)
+    {
+        if (++nodes > XML_MAX_NODES) { hr = E_FAIL; goto done; }
+        switch (type)
+        {
+        case XmlNodeType_Element:
+        {
+            struct xnode *node;
+
+            if (depth >= XML_MAX_DEPTH) { hr = E_FAIL; goto done; }
+            if (!(node = arena_alloc( a, sizeof(*node) ))) { hr = E_OUTOFMEMORY; goto done; }
+            node->prefix = reader_string( a, reader, STR_PREFIX );
+            node->local = reader_string( a, reader, STR_LOCAL );
+            node->ns = reader_string( a, reader, STR_NS );
+            if (!node->prefix || !node->local || !node->ns) { hr = E_OUTOFMEMORY; goto done; }
+            if (FAILED(hr = read_attributes( a, reader, node ))) goto done;
+            if (!add_kid( a, cur, node )) { hr = E_OUTOFMEMORY; goto done; }
+            if (!IXmlReader_IsEmptyElement( reader )) { cur = node; depth++; }
+            break;
+        }
+        case XmlNodeType_EndElement:
+            if (cur == doc) { hr = E_FAIL; goto done; }
+            cur = cur->parent;
+            depth--;
+            break;
+        case XmlNodeType_Text:
+        case XmlNodeType_CDATA:
+        case XmlNodeType_Whitespace:
+        {
+            const WCHAR *text = NULL;
+            UINT len = 0;
+
+            if (cur == doc) break;      /* outside the root element */
+            if (FAILED(hr = IXmlReader_GetValue( reader, &text, &len ))) goto done;
+            if (FAILED(hr = append_text( a, cur, text, len ))) goto done;
+            break;
+        }
+        default:
+            break;
+        }
+    }
+    if (hr == S_FALSE)
+    {
+        hr = S_OK;
+        if (cur != doc || !doc->nkids) hr = E_FAIL;
+    }
+    if (SUCCEEDED(hr)) *root = doc->kids[0];
+
+done:
+    if (reader) IXmlReader_Release( reader );
+    IStream_Release( stream );
+    return hr;
+}
+
+/* canonicalization, after the Canonical XML recommendation (1.0) and its exclusive form */
+
+struct nsent { const WCHAR *prefix, *uri; };
+
+struct c14n
+{
+    struct arena *arena;
+    BOOL exclusive;
+    WCHAR *out;
+    SIZE_T len, cap;
+    BOOL oom;
+    struct nsent *scope, *rendered;
+    ULONG nscope, cscope, nrendered, crendered;
+};
+
+static void put( struct c14n *c, const WCHAR *str, SIZE_T len )
+{
+    if (c->oom) return;
+    if (c->len + len + 1 > c->cap)
+    {
+        SIZE_T cap = max( c->cap * 2, c->len + len + 256 );
+        WCHAR *buf = c->out ? HeapReAlloc( GetProcessHeap(), 0, c->out, cap * sizeof(WCHAR) )
+                            : HeapAlloc( GetProcessHeap(), 0, cap * sizeof(WCHAR) );
+
+        if (!buf) { c->oom = TRUE; return; }
+        c->out = buf;
+        c->cap = cap;
+    }
+    memcpy( c->out + c->len, str, len * sizeof(WCHAR) );
+    c->len += len;
+}
+
+static void puts_( struct c14n *c, const WCHAR *str ) { put( c, str, wcslen( str )); }
+
+static void put_escaped( struct c14n *c, const WCHAR *str, SIZE_T len, BOOL attr )
+{
+    SIZE_T i;
+
+    for (i = 0; i < len; i++)
+    {
+        switch (str[i])
+        {
+        case '&': puts_( c, L"&amp;" ); break;
+        case '<': puts_( c, L"&lt;" ); break;
+        case '>': if (attr) put( c, str + i, 1 ); else puts_( c, L"&gt;" ); break;
+        case '"': if (attr) puts_( c, L"&quot;" ); else put( c, str + i, 1 ); break;
+        case '\t': if (attr) puts_( c, L"&#x9;" ); else put( c, str + i, 1 ); break;
+        case '\n': if (attr) puts_( c, L"&#xA;" ); else put( c, str + i, 1 ); break;
+        case '\r': puts_( c, L"&#xD;" ); break;
+        default: put( c, str + i, 1 ); break;
+        }
+    }
+}
+
+static BOOL push_ns( struct nsent **list, ULONG *count, ULONG *cap, const WCHAR *prefix, const WCHAR *uri )
+{
+    if (*count == *cap)
+    {
+        ULONG new_cap = *cap ? *cap * 2 : 16;
+        struct nsent *p = *list ? HeapReAlloc( GetProcessHeap(), 0, *list, new_cap * sizeof(**list) )
+                                : HeapAlloc( GetProcessHeap(), 0, new_cap * sizeof(**list) );
+        if (!p) return FALSE;
+        *list = p;
+        *cap = new_cap;
+    }
+    (*list)[*count].prefix = prefix;
+    (*list)[*count].uri = uri;
+    (*count)++;
+    return TRUE;
+}
+
+static const WCHAR *ns_find( const struct nsent *list, ULONG count, const WCHAR *prefix )
+{
+    while (count--) if (!wcscmp( list[count].prefix, prefix )) return list[count].uri;
+    return NULL;
+}
+
+static BOOL is_xmlns( const struct xattr *a, const WCHAR **prefix )
+{
+    if (!wcscmp( a->prefix, L"xmlns" )) { *prefix = a->local; return TRUE; }
+    if (!a->prefix[0] && !wcscmp( a->local, L"xmlns" )) { *prefix = L""; return TRUE; }
+    return FALSE;
+}
+
+static int cmp_ns_prefix( const void *a, const void *b )
+{
+    return wcscmp( ((const struct nsent *)a)->prefix, ((const struct nsent *)b)->prefix );
+}
+
+static int cmp_attr( const void *a, const void *b )
+{
+    const struct xattr *x = *(struct xattr * const *)a, *y = *(struct xattr * const *)b;
+    int ret = wcscmp( x->ns, y->ns );
+    return ret ? ret : wcscmp( x->local, y->local );
+}
+
+static BOOL prefix_used( const struct xnode *e, const WCHAR *prefix )
+{
+    ULONG i;
+
+    if (!wcscmp( e->prefix, prefix )) return TRUE;
+    for (i = 0; i < e->nattrs; i++)
+    {
+        const WCHAR *dummy;
+        if (is_xmlns( &e->attrs[i], &dummy )) continue;
+        if (e->attrs[i].prefix[0] && !wcscmp( e->attrs[i].prefix, prefix )) return TRUE;
+    }
+    return FALSE;
+}
+
+static void c14n_element( struct c14n *c, const struct xnode *e )
+{
+    ULONG scope_mark = c->nscope, rendered_mark = c->nrendered, i, n = 0, nattr = 0;
+    struct nsent *decls = NULL;
+    struct xattr **attrs = NULL;
+    const WCHAR *prefix;
+
+    if (c->oom) return;
+    for (i = 0; i < e->nattrs; i++)
+        if (is_xmlns( &e->attrs[i], &prefix ))
+        {
+            if (!push_ns( &c->scope, &c->nscope, &c->cscope, prefix, e->attrs[i].value )) { c->oom = TRUE; return; }
+        }
+        else nattr++;
+
+    /* the namespace declarations this element has to carry */
+    decls = HeapAlloc( GetProcessHeap(), 0, (c->nscope + 2) * sizeof(*decls) );
+    attrs = HeapAlloc( GetProcessHeap(), 0, (nattr + 1) * sizeof(*attrs) );
+    if (!decls || !attrs) { c->oom = TRUE; goto done; }
+    for (i = 0; i <= c->nscope; i++)
+    {
+        const WCHAR *p, *uri, *old;
+        ULONG j;
+        BOOL dup = FALSE;
+
+        p = i < c->nscope ? c->scope[i].prefix : L"";    /* the default namespace is always considered */
+        for (j = 0; j < n; j++) if (!wcscmp( decls[j].prefix, p )) dup = TRUE;
+        if (dup || !wcscmp( p, L"xml" )) continue;
+        uri = ns_find( c->scope, c->nscope, p );
+        if (!uri) uri = L"";
+        if (c->exclusive && !prefix_used( e, p )) continue;
+        old = ns_find( c->rendered, c->nrendered, p );
+        if (old ? !wcscmp( old, uri ) : !uri[0]) continue;
+        decls[n].prefix = p;
+        decls[n].uri = uri;
+        n++;
+    }
+    qsort( decls, n, sizeof(*decls), cmp_ns_prefix );
+    for (i = 0, nattr = 0; i < e->nattrs; i++)
+        if (!is_xmlns( &e->attrs[i], &prefix )) attrs[nattr++] = &e->attrs[i];
+#ifndef SG_MUTANT_C14N_NO_SORT
+    qsort( attrs, nattr, sizeof(*attrs), cmp_attr );
+#endif
+
+    puts_( c, L"<" );
+    if (e->prefix[0]) { puts_( c, e->prefix ); puts_( c, L":" ); }
+    puts_( c, e->local );
+    for (i = 0; i < n; i++)
+    {
+        if (decls[i].prefix[0]) { puts_( c, L" xmlns:" ); puts_( c, decls[i].prefix ); }
+        else puts_( c, L" xmlns" );
+        puts_( c, L"=\"" );
+        put_escaped( c, decls[i].uri, wcslen( decls[i].uri ), TRUE );
+        puts_( c, L"\"" );
+        if (!push_ns( &c->rendered, &c->nrendered, &c->crendered, decls[i].prefix, decls[i].uri )) c->oom = TRUE;
+    }
+    for (i = 0; i < nattr; i++)
+    {
+        puts_( c, L" " );
+        if (attrs[i]->prefix[0]) { puts_( c, attrs[i]->prefix ); puts_( c, L":" ); }
+        puts_( c, attrs[i]->local );
+        puts_( c, L"=\"" );
+        put_escaped( c, attrs[i]->value, wcslen( attrs[i]->value ), TRUE );
+        puts_( c, L"\"" );
+    }
+    puts_( c, L">" );
+    for (i = 0; i < e->nkids; i++)
+    {
+        if (e->kids[i]->is_text) put_escaped( c, e->kids[i]->text, e->kids[i]->text_len, FALSE );
+        else c14n_element( c, e->kids[i] );
+    }
+    puts_( c, L"</" );
+    if (e->prefix[0]) { puts_( c, e->prefix ); puts_( c, L":" ); }
+    puts_( c, e->local );
+    puts_( c, L">" );
+
+done:
+    HeapFree( GetProcessHeap(), 0, decls );
+    HeapFree( GetProcessHeap(), 0, attrs );
+    c->nscope = scope_mark;
+    c->nrendered = rendered_mark;
+}
+
+HRESULT xml_canonicalize( struct arena *a, struct xnode *element, BOOL exclusive, BYTE **data, ULONG *size )
+{
+    struct c14n c = {0};
+    struct xnode *chain[XML_MAX_DEPTH + 2];
+    ULONG depth = 0, i, j;
+    HRESULT hr = S_OK;
+    int len;
+    BYTE *buf;
+
+    c.arena = a;
+#ifdef SG_MUTANT_C14N_ALL_EXCLUSIVE
+    exclusive = TRUE;
+#endif
+    c.exclusive = exclusive;
+    /* the declarations in scope at the element, outermost first */
+    {
+        struct xnode *p = element->parent;
+        while (p && p->parent && depth < ARRAY_SIZE(chain)) { chain[depth++] = p; p = p->parent; }
+    }
+    for (i = depth; i--; )
+        for (j = 0; j < chain[i]->nattrs; j++)
+        {
+            const WCHAR *prefix;
+            if (is_xmlns( &chain[i]->attrs[j], &prefix ) &&
+                !push_ns( &c.scope, &c.nscope, &c.cscope, prefix, chain[i]->attrs[j].value ))
+            {
+                hr = E_OUTOFMEMORY;
+                goto done;
+            }
+        }
+    c14n_element( &c, element );
+    if (c.oom) { hr = E_OUTOFMEMORY; goto done; }
+    len = WideCharToMultiByte( CP_UTF8, 0, c.out, c.len, NULL, 0, NULL, NULL );
+    if (!(buf = arena_alloc( a, len + 1 ))) { hr = E_OUTOFMEMORY; goto done; }
+    WideCharToMultiByte( CP_UTF8, 0, c.out, c.len, (char *)buf, len, NULL, NULL );
+    *data = buf;
+    *size = len;
+
+done:
+    HeapFree( GetProcessHeap(), 0, c.out );
+    HeapFree( GetProcessHeap(), 0, c.scope );
+    HeapFree( GetProcessHeap(), 0, c.rendered );
+    return hr;
+}
