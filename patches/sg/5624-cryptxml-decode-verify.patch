+    strcat( out, canon ? "<DigestMethod Algorithm=\"" SHA1 "\"></DigestMethod>" : "<DigestMethod Algorithm=\"" SHA1 "\"/>" );
+    strcat( out, "<DigestValue>AAAA</DigestValue></Reference>" );
+    strcat( out, "<Reference URI=\"http://example.com/x?a=1&amp;b=2\"><Transforms>" );
+    strcat( out, canon ? "<Transform Algorithm=\"urn:unknown\"></Transform>" : "<Transform Algorithm=\"urn:unknown\"/>" );
+    strcat( out, "</Transforms>" );
+    strcat( out, canon ? "<DigestMethod Algorithm=\"" SHA1 "\"></DigestMethod>" : "<DigestMethod Algorithm=\"" SHA1 "\"/>" );
+    strcat( out, "<DigestValue>AAAA</DigestValue></Reference></SignedInfo>" );
