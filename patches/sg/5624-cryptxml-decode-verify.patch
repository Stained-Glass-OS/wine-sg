+struct arena_block
+{
+    struct arena_block *next;
+};
+
+void *arena_alloc( struct arena *a, SIZE_T size )
+{
+    struct arena_block *b;
+
+    if (size > 0x7ffffff0) return NULL;
+    if (!(b = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*b) + size + 8 ))) return NULL;
+    b->next = a->blocks;
+    a->blocks = b;
+    return (BYTE *)(b + 1);
+}
+
+WCHAR *arena_strdup( struct arena *a, const WCHAR *str, SIZE_T len )
+{
+    WCHAR *ret = arena_alloc( a, (len + 1) * sizeof(WCHAR) );
+
+    if (ret) memcpy( ret, str, len * sizeof(WCHAR) );
+    return ret;
+}
+
+void arena_free( struct arena *a )
+{
+    while (a->blocks)
+    {
+        struct arena_block *b = a->blocks;
+        a->blocks = b->next;
+        HeapFree( GetProcessHeap(), 0, b );
+    }
+}
+
+static BOOL add_kid( struct arena *a, struct xnode *parent, struct xnode *kid )
+{
+    if (parent->nkids == parent->kids_cap)
+    {
+        ULONG cap = parent->kids_cap ? parent->kids_cap * 2 : 4;
+        struct xnode **kids = arena_alloc( a, cap * sizeof(*kids) );
+
+        if (!kids) return FALSE;
+        if (parent->nkids) memcpy( kids, parent->kids, parent->nkids * sizeof(*kids) );
+        parent->kids = kids;
+        parent->kids_cap = cap;
+    }
+    parent->kids[parent->nkids++] = kid;
+    kid->parent = parent;
+    return TRUE;
+}
