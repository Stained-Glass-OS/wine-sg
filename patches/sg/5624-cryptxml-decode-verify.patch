+    CRYPT_XML_BLOB Y;
+    CRYPT_XML_BLOB ExplicitPara;
+} CRYPT_XML_KEY_ECDSA_KEY_VALUE, *PCRYPT_XML_KEY_ECDSA_KEY_VALUE;
+
+typedef struct _CRYPT_XML_KEY_RSA_KEY_VALUE
+{
+    CRYPT_XML_BLOB Modulus;
+    CRYPT_XML_BLOB Exponent;
+} CRYPT_XML_KEY_RSA_KEY_VALUE, *PCRYPT_XML_KEY_RSA_KEY_VALUE;
+
+typedef struct _CRYPT_XML_KEY_VALUE
+{
+    DWORD dwType;
+    union
+    {
+        CRYPT_XML_KEY_DSA_KEY_VALUE DSAKeyValue;
