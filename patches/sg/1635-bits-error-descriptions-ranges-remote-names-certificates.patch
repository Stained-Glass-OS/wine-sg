+/* what an error means: BITS's own, then the system's and WinHTTP's */
+HRESULT bits_error_description(HRESULT code, WCHAR **text)
+{
+    static const struct { HRESULT code; const WCHAR *text; } bits_errors[] =
+    {
+        { BG_E_NOT_FOUND, L"The requested job was not found." },
+        { BG_E_INVALID_STATE, L"The requested action is not allowed in the current job state." },
+        { BG_E_EMPTY, L"There are no files attached to this job." },
+        { BG_E_FILE_NOT_AVAILABLE, L"No file is available because no URL generated an error." },
+        { BG_E_PROTOCOL_NOT_AVAILABLE, L"No protocol is available because no URL generated an error." },
+        { BG_E_DESTINATION_LOCKED, L"The destination file is in use by another program." },
+        { BG_E_NETWORK_DISCONNECTED, L"There is no network connection." },
+        { BG_E_PROXY_LIST_TOO_LARGE, L"The proxy list is too long." },
+        { BG_E_STRING_TOO_LONG, L"The string is too long." },
+        { BG_E_MAXDOWNLOAD_TIMEOUT, L"The job did not finish within its maximum download time." },
+        { BG_E_ERROR_INFORMATION_UNAVAILABLE, L"No error information is available." },
+        { BG_E_HTTP_ERROR_400, L"The server could not understand the request (HTTP 400)." },
+        { BG_E_HTTP_ERROR_401, L"The request needs user authentication (HTTP 401)." },
+        { BG_E_HTTP_ERROR_404, L"The server has not found anything matching the requested URL (HTTP 404)." },
+        { BG_E_HTTP_ERROR_407, L"The proxy needs authentication (HTTP 407)." },
+        { BG_E_HTTP_ERROR_414, L"The URL is too long for the server (HTTP 414)." },
+        { BG_E_HTTP_ERROR_501, L"The server does not support what the request needs (HTTP 501)." },
+        { BG_E_HTTP_ERROR_503, L"The service is temporarily unavailable (HTTP 503)." },
+        { BG_E_HTTP_ERROR_504, L"The gateway timed out (HTTP 504)." },
+        { BG_E_HTTP_ERROR_505, L"The server does not support the HTTP version (HTTP 505)." },
+    };
+    DWORD flags = FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_IGNORE_INSERTS, len;
+    WCHAR *buf = NULL;
+    unsigned int i;
+    HRESULT hr;
+
+    *text = NULL;
+    for (i = 0; i < ARRAY_SIZE(bits_errors); i++)
+        if (bits_errors[i].code == code) return return_strval(bits_errors[i].text, text);
+    if (HRESULT_FACILITY(code) == FACILITY_WIN32 && HRESULT_CODE(code) >= WINHTTP_ERROR_BASE &&
+        HRESULT_CODE(code) <= WINHTTP_ERROR_LAST)
+        len = FormatMessageW(flags | FORMAT_MESSAGE_FROM_HMODULE, GetModuleHandleW(L"winhttp.dll"),
+                             HRESULT_CODE(code), 0, (WCHAR *)&buf, 0, NULL);
+    else
+        len = FormatMessageW(flags | FORMAT_MESSAGE_FROM_SYSTEM, NULL, code, 0, (WCHAR *)&buf, 0, NULL);
+    if (!len) return HRESULT_FROM_WIN32(ERROR_MR_MID_NOT_FOUND);
+    hr = return_strval(buf, text);
+    LocalFree(buf);
+    return hr;
+}
+
+/* the remote names BITS takes: http(s), file, UNC and full local paths */
+HRESULT check_remote_name(const WCHAR *remote)
+{
+    if (!remote || !*remote) return E_INVALIDARG;
+    if (!wcsnicmp(remote, L"http://", 7) || !wcsnicmp(remote, L"https://", 8) || !wcsnicmp(remote, L"file://", 7) ||
+        (remote[0] == '\\' && remote[1] == '\\') || (iswalpha(remote[0]) && remote[1] == ':'))
+        return S_OK;
+    return wcsstr(remote, L"://") ? BG_E_PROTOCOL_NOT_AVAILABLE : E_INVALIDARG;
+}
