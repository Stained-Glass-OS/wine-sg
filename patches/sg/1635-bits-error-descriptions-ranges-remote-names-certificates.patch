+/* the job's security flags and client certificate, for a request */
+static BOOL set_request_security(HINTERNET req, BackgroundCopyJobImpl *job)
+{
+    ULONG options = job->http_options.flags;
+    DWORD security = 0, redirect;
+
+    if (options & BG_SSL_IGNORE_CERT_CN_INVALID) security |= SECURITY_FLAG_IGNORE_CERT_CN_INVALID;
+    if (options & BG_SSL_IGNORE_CERT_DATE_INVALID) security |= SECURITY_FLAG_IGNORE_CERT_DATE_INVALID;
+    if (options & BG_SSL_IGNORE_UNKNOWN_CA) security |= SECURITY_FLAG_IGNORE_UNKNOWN_CA;
+    if (options & BG_SSL_IGNORE_CERT_WRONG_USAGE) security |= SECURITY_FLAG_IGNORE_CERT_WRONG_USAGE;
+    if (security && !WinHttpSetOption(req, WINHTTP_OPTION_SECURITY_FLAGS, &security, sizeof(security))) return FALSE;
+    if (options & BG_SSL_ENABLE_CRL_CHECK)
+    {
+        DWORD enable = WINHTTP_ENABLE_SSL_REVOCATION;
+        WinHttpSetOption(req, WINHTTP_OPTION_ENABLE_FEATURE, &enable, sizeof(enable));
+    }
+    switch (options & BG_HTTP_REDIRECT_POLICY_MASK)
+    {
+    case BG_HTTP_REDIRECT_POLICY_DISALLOW: redirect = WINHTTP_OPTION_REDIRECT_POLICY_NEVER; break;
+    default:
+        redirect = (options & BG_HTTP_REDIRECT_POLICY_ALLOW_HTTPS_TO_HTTP) ? WINHTTP_OPTION_REDIRECT_POLICY_ALWAYS
+                                                                             : WINHTTP_OPTION_REDIRECT_POLICY_DISALLOW_HTTPS_TO_HTTP;
+        break;
+    }
+    WinHttpSetOption(req, WINHTTP_OPTION_REDIRECT_POLICY, &redirect, sizeof(redirect));
+
+    if (job->http_options.cert_set)
+    {
+        static const DWORD locations[] =
+        {
+            CERT_SYSTEM_STORE_CURRENT_USER, CERT_SYSTEM_STORE_LOCAL_MACHINE, CERT_SYSTEM_STORE_CURRENT_SERVICE,
+            CERT_SYSTEM_STORE_SERVICES, CERT_SYSTEM_STORE_USERS, CERT_SYSTEM_STORE_CURRENT_USER_GROUP_POLICY,
+            CERT_SYSTEM_STORE_LOCAL_MACHINE_GROUP_POLICY, CERT_SYSTEM_STORE_LOCAL_MACHINE_ENTERPRISE,
+        };
+        const CERT_CONTEXT *cert = NULL;
+        HCERTSTORE store;
+
+        if ((store = CertOpenStore(CERT_STORE_PROV_SYSTEM_W, 0, 0, locations[job->http_options.cert_location] |
+                                   CERT_STORE_READONLY_FLAG, job->http_options.cert_store)))
+        {
+            if (job->http_options.cert_by_hash)
+            {
+                CRYPT_HASH_BLOB hash = { sizeof(job->http_options.cert_hash), job->http_options.cert_hash };
+                cert = CertFindCertificateInStore(store, X509_ASN_ENCODING, 0, CERT_FIND_SHA1_HASH, &hash, NULL);
+            }
+            else
+                cert = CertFindCertificateInStore(store, X509_ASN_ENCODING, 0, CERT_FIND_SUBJECT_STR_W,
+                                                  job->http_options.cert_subject, NULL);
+            CertCloseStore(store, 0);
+        }
+        if (!cert)
+        {
+            WARN("client certificate not found\n");
+            job->error.code = HRESULT_FROM_WIN32(ERROR_WINHTTP_CLIENT_AUTH_CERT_NEEDED);
+            return FALSE;
+        }
+        WinHttpSetOption(req, WINHTTP_OPTION_CLIENT_CERT_CONTEXT, (void *)cert, sizeof(*cert));
+        CertFreeCertificateContext(cert);
+    }
+    return TRUE;
+}
