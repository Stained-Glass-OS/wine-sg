+/* the job's headers and a Range header for one range */
+static WCHAR *range_headers(const WCHAR *headers, const BG_FILE_RANGE *range)
+{
+    size_t len = (headers ? wcslen(headers) : 0) + 64;
+    WCHAR *ret;
+
+    if (!(ret = malloc(len * sizeof(WCHAR)))) return NULL;
+    if (range->Length == BG_LENGTH_TO_EOF)
+        swprintf(ret, len, L"%sRange: bytes=%I64u-\r\n", headers ? headers : L"", range->InitialOffset);
+    else
+        swprintf(ret, len, L"%sRange: bytes=%I64u-%I64u\r\n", headers ? headers : L"", range->InitialOffset,
+                 range->InitialOffset + range->Length - 1);
+    return ret;
+}
