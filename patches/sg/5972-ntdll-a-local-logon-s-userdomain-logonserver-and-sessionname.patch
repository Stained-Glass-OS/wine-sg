From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: a local logon's USERDOMAIN, LOGONSERVER and SESSIONNAME (5972)

Windows' logon puts USERDOMAIN (the computer, for a local account),
USERDOMAIN_ROAMINGPROFILE, LOGONSERVER (\\COMPUTER) and SESSIONNAME (Console)
in the user's Volatile Environment. In a shared prefix only the user who ran
wineboot had one, so every other user's programs had none of them, and
%USERDOMAIN%\%USERNAME% (icacls, schtasks, installers' ACLs) was "\bob". They
are set from the computer name where nothing set them; a domain logon's
Volatile Environment still names its domain. Gate test/logondomain-gate.sh
(mutant NO_LOGON_VARS).
---
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -1519,6 +1519,39 @@
         if ((value = get_registry_value( *env, *pos, key, computernameW )))
         {
             set_env_var( env, pos, size, computernameW, wcslen(computernameW), value );
+#ifndef SG_MUTANT_NO_LOGON_VARS
+            /* Stained Glass OS: what a local logon puts in the user's Volatile
+             * Environment -- USERDOMAIN (the computer, for a local account),
+             * LOGONSERVER, SESSIONNAME. In a shared prefix only the user who
+             * ran wineboot ever had one, so everyone else's
+             * %USERDOMAIN%\%USERNAME% (icacls, schtasks, installers' ACLs) was
+             * "\\bob". Only where nothing set them: a domain logon's Volatile
+             * Environment (read above) names the domain. */
+            if (user_name)
+            {
+                static const WCHAR domainW[] = {'U','S','E','R','D','O','M','A','I','N',0};
+                static const WCHAR roamingW[] = {'U','S','E','R','D','O','M','A','I','N','_','R','O','A','M','I','N','G','P','R','O','F','I','L','E',0};
+                static const WCHAR logonW[] = {'L','O','G','O','N','S','E','R','V','E','R',0};
+                static const WCHAR sessionW[] = {'S','E','S','S','I','O','N','N','A','M','E',0};
+                static const WCHAR consoleW[] = {'C','o','n','s','o','l','e',0};
+                WCHAR *server;
+
+                if (!find_env_var( *env, *pos, domainW, wcslen(domainW) ))
+                    set_env_var( env, pos, size, domainW, wcslen(domainW), value );
+                if (!find_env_var( *env, *pos, roamingW, wcslen(roamingW) ))
+                    set_env_var( env, pos, size, roamingW, wcslen(roamingW), value );
+                if (!find_env_var( *env, *pos, logonW, wcslen(logonW) ) &&
+                    (server = malloc( (wcslen( value ) + 3) * sizeof(WCHAR) )))
+                {
+                    server[0] = server[1] = '\\';
+                    wcscpy( server + 2, value );
+                    set_env_var( env, pos, size, logonW, wcslen(logonW), server );
+                    free( server );
+                }
+                if (!find_env_var( *env, *pos, sessionW, wcslen(sessionW) ))
+                    set_env_var( env, pos, size, sessionW, wcslen(sessionW), consoleW );
+            }
+#endif
             free( value );
         }
         NtClose( key );
