+/* SSML down to the spoken text and its pauses: one fragment per run of text, one per <break> */
+static ULONG ssml_break_msecs( const WCHAR *tag, ULONG len )
+{
+    static const struct { const WCHAR *name; ULONG msecs; } strengths[] =
+    {
+        { L"none", 0 }, { L"x-weak", 100 }, { L"weak", 250 }, { L"medium", 500 },
+        { L"strong", 750 }, { L"x-strong", 1000 },
+    };
+    WCHAR buf[256], *p, *value;
+    ULONG i;
+
+    lstrcpynW(buf, tag, min(len + 1, ARRAY_SIZE(buf)));
+    if ((p = wcsstr(buf, L"time=")) && (p[5] == '"' || p[5] == '\''))
+    {
+        double n = wcstod(p + 6, &value);
+        while (*value == ' ') value++;
+        if (!wcsnicmp(value, L"ms", 2)) return (ULONG)n;
+        if (*value == 's' || *value == 'S') return (ULONG)(n * 1000);
+        return (ULONG)n;
+    }
+    if ((p = wcsstr(buf, L"strength=")) && (p[9] == '"' || p[9] == '\''))
+        for (i = 0; i < ARRAY_SIZE(strengths); i++)
+            if (!wcsnicmp(p + 10, strengths[i].name, wcslen(strengths[i].name)) &&
+                p[10 + wcslen(strengths[i].name)] == p[9])
+                return strengths[i].msecs;
+    return 500;
+}
+
+/* the plain text (entities decoded, tags gone) and its pieces; FALSE for text that is not SSML */
+static BOOL ssml_to_pieces( const WCHAR *ssml, UINT32 len, WCHAR **plain_out, struct ssml_piece **pieces_out, UINT32 *count )
+{
+    WCHAR *plain = malloc((len + 1) * sizeof(WCHAR));
+    struct ssml_piece *pieces = malloc((len + 2) * sizeof(*pieces));
+    ULONG n = 0, run = 0, i = 0;
+    BOOL in_speak = FALSE, seen_speak = FALSE;
+
+    *count = 0;
+    if (!plain || !pieces) goto fail;
+    while (i < len)
+    {
+        if (ssml[i] == '<')
+        {
+            ULONG end = i;
+            while (end < len && ssml[end] != '>') end++;
+            if (end >= len) goto fail;
+            if (!wcsncmp(ssml + i, L"<!--", 4))
+            {
+                const WCHAR *close = wcsstr(ssml + i, L"-->");
+                if (!close) goto fail;
+                i = close - ssml + 3;
+                continue;
+            }
+            if (!wcsnicmp(ssml + i, L"<speak", 6) && (iswspace(ssml[i + 6]) || ssml[i + 6] == '>'))
+                in_speak = seen_speak = TRUE;
+            else if (!wcsnicmp(ssml + i, L"</speak", 7))
+                in_speak = FALSE;
+            else if (in_speak && !wcsnicmp(ssml + i, L"<break", 6))
+            {
+                if (n > run)
+                {
+                    pieces[*count].start = run;
+                    pieces[*count].len = n - run;
+                    pieces[(*count)++].is_break = FALSE;
+                }
+                pieces[*count].is_break = TRUE;
+                pieces[(*count)++].silence = ssml_break_msecs(ssml + i, end - i);
+                run = n;
+            }
+            else if (in_speak && (!wcsnicmp(ssml + i, L"<p", 2) || !wcsnicmp(ssml + i, L"</p", 3) ||
+                                  !wcsnicmp(ssml + i, L"<s", 2) || !wcsnicmp(ssml + i, L"</s", 3)))
+            {
+                /* paragraphs and sentences: a word gap */
+                if (n && plain[n - 1] != ' ') plain[n++] = ' ';
+            }
+            i = end + 1;
+            continue;
+        }
+        if (!in_speak)
+        {
+            if (!iswspace(ssml[i]) && ssml[i] != 0xfeff) goto fail;   /* text outside <speak> */
+            i++;
+            continue;
+        }
+        if (ssml[i] == '&')
+        {
+            static const struct { const WCHAR *name; WCHAR ch; } entities[] =
+            {
+                { L"&amp;", '&' }, { L"&lt;", '<' }, { L"&gt;", '>' }, { L"&quot;", '"' }, { L"&apos;", '\'' },
+            };
+            ULONG k;
+            BOOL done = FALSE;
+
+            for (k = 0; k < ARRAY_SIZE(entities); k++)
+            {
+                ULONG l = wcslen(entities[k].name);
+                if (i + l <= len && !wcsncmp(ssml + i, entities[k].name, l))
+                {
+                    plain[n++] = entities[k].ch;
+                    i += l;
+                    done = TRUE;
+                    break;
+                }
+            }
+            if (!done && i + 2 < len && ssml[i + 1] == '#')
+            {
+                WCHAR *stop;
+                ULONG code = ssml[i + 2] == 'x' || ssml[i + 2] == 'X' ? wcstoul(ssml + i + 3, &stop, 16)
+                                                                       : wcstoul(ssml + i + 2, &stop, 10);
+                if (*stop == ';' && code && code < 0x10000)
+                {
+                    plain[n++] = code;
+                    i = stop - ssml + 1;
+                    done = TRUE;
+                }
+            }
+            if (!done) plain[n++] = ssml[i++];
+            continue;
+        }
+        plain[n++] = ssml[i++];
+    }
+    if (!seen_speak) goto fail;
+    if (n > run)
+    {
+        pieces[*count].start = run;
+        pieces[*count].len = n - run;
+        pieces[(*count)++].is_break = FALSE;
+    }
+    plain[n] = 0;
+    *plain_out = plain;
+    *pieces_out = pieces;
+    return TRUE;
+
+fail:
+    free(plain);
+    free(pieces);
+    *count = 0;
+    return FALSE;
+}
+
+#define SYNTH_RATE 22050
+
+static HRESULT synthesize( IInspectable *invoker, IInspectable **result )
+{
+    struct synth_request *request = impl_from_request_IInspectable(invoker);
+    struct sapi_output out = { 0 };
+    WAVEFORMATEX wfx = { WAVE_FORMAT_PCM, 1, SYNTH_RATE, SYNTH_RATE * 2, 2, 16, 0 };
+    struct ssml_piece *pieces = NULL, plain_piece;
+    struct synthesis_stream *stream;
+    WCHAR *plain = NULL;
+    UINT32 count = 0, i;
+    LONG rate, pitch;
+    USHORT volume;
+    HGLOBAL wav;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE("request %p, ssml %d, text %s.\n", request, request->ssml, debugstr_wn(request->text, request->len));
+
+    *result = NULL;
+    if (request->ssml)
+    {
+        if (!ssml_to_pieces(request->text, request->len, &plain, &pieces, &count))
+            return 0x80131537; /* SPERR_WINRT_INCORRECT_FORMAT */
+    }
+    else
+    {
+        plain = request->text;
+        plain_piece.start = 0;
+        plain_piece.len = request->len;
+        plain_piece.is_break = FALSE;
+        pieces = &plain_piece;
+        count = request->len ? 1 : 0;
+    }
+
+    hr = S_OK;
+    if (count)
+    {
+        /* SpeakingRate 0.5 .. 6 (3 is SAPI's +10), AudioVolume 0 .. 1, AudioPitch 0 .. 2 */
+        rate = (LONG)floor(10.0 * log(max(request->rate, 0.1)) / log(3.0) + 0.5);
+        volume = (USHORT)max(0.0, min(100.0, request->volume * 100.0 + 0.5));
+        pitch = (LONG)floor((request->pitch - 1.0) * 10.0 + 0.5);
+        if (!request->token[0]) hr = HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+#ifndef SG_MUTANT_WMS_SILENT
+        else hr = sapi_speak(request->token, plain, pieces, count, max(-10, min(10, rate)), volume,
+                             max(-10, min(10, pitch)), &wfx, &out);
+#endif
+        if (FAILED(hr)) WARN("the voice did not speak: %#lx\n", hr);
+    }
+
+    /* the WAV file */
+    if (SUCCEEDED(hr) && !(wav = GlobalAlloc(GMEM_MOVEABLE, 44 + out.size))) hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr))
+    {
+        DWORD v;
+
+        bytes = GlobalLock(wav);
+        memcpy(bytes, "RIFF", 4);
+        v = 36 + out.size; memcpy(bytes + 4, &v, 4);
+        memcpy(bytes + 8, "WAVEfmt ", 8);
+        v = 16; memcpy(bytes + 16, &v, 4);
+        memcpy(bytes + 20, &wfx, 16);
+        memcpy(bytes + 36, "data", 4);
+        v = out.size; memcpy(bytes + 40, &v, 4);
+        if (out.size) memcpy(bytes + 44, out.data, out.size);
+        GlobalUnlock(wav);
+        hr = synthesis_stream_create(wav, &stream);
+    }
+    if (SUCCEEDED(hr))
+    {
+        for (i = 0; i < out.event_count; i++)
+        {
+            struct sapi_event *event = &out.events[i];
+            IMediaMarker *marker;
+            ULONG len = wcslen(plain), text_len = event->text_len, k;
+
+            if (event->word ? !request->word_boundary : !request->sentence_boundary) continue;
+            if (event->text_pos > len) continue;
+            if (!event->word && !text_len)
+            {
+                /* a sentence runs to the next one (or the end), its trailing space left out */
+                ULONG end = len;
+                for (k = i + 1; k < out.event_count; k++)
+                    if (!out.events[k].word && out.events[k].text_pos > event->text_pos)
+                    {
+                        end = min(out.events[k].text_pos, len);
+                        break;
+                    }
+                while (end > event->text_pos && iswspace(plain[end - 1])) end--;
+                text_len = end - event->text_pos;
+            }
+            if (SUCCEEDED(media_marker_create(event->offset * 10000000 / wfx.nAvgBytesPerSec,
+                                              event->word ? L"SpeechWord" : L"SpeechSentence", plain + event->text_pos,
+                                              min(text_len, len - event->text_pos), &marker)))
+            {
+                IVector_IMediaMarker_Append(stream->markers, marker);
+                IMediaMarker_Release(marker);
+            }
+        }
+        *result = (IInspectable *)&stream->ISpeechSynthesisStream_iface;
+    }
+
+    free(out.data);
+    free(out.events);
+    if (request->ssml)
+    {
+        free(plain);
+        free(pieces);
+    }
+    return hr;
+}
+
+static HRESULT synth_request_create( struct synthesizer *synth, HSTRING text, BOOL ssml, IInspectable **out )
+{
+    struct synth_options *options = impl_from_ISpeechSynthesizerOptions(synth->options);
+    struct synth_request *impl;
+    const WCHAR *raw;
+    UINT32 len;
+    HSTRING id;
+
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IInspectable_iface.lpVtbl = &synth_request_vtbl;
+    impl->ref = 1;
+    raw = WindowsGetStringRawBuffer(text, &len);
+    if (!(impl->text = malloc((len + 1) * sizeof(WCHAR))))
+    {
+        free(impl);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(impl->text, raw, len * sizeof(WCHAR));
+    impl->text[len] = 0;
+    impl->len = len;
+    impl->ssml = ssml;
+    if (synth->voice && SUCCEEDED(IVoiceInformation_get_Id(synth->voice, &id)))
+    {
+        const WCHAR *base = wcsrchr(WindowsGetStringRawBuffer(id, NULL), '\\');
+        if (base) lstrcpynW(impl->token, base + 1, ARRAY_SIZE(impl->token));
+        WindowsDeleteString(id);
+    }
+    impl->volume = options->volume;
+    impl->rate = options->rate;
+    impl->pitch = options->pitch;
+    impl->word_boundary = options->word_boundary;
+    impl->sentence_boundary = options->sentence_boundary;
+    *out = &impl->IInspectable_iface;
+    return S_OK;
+}
