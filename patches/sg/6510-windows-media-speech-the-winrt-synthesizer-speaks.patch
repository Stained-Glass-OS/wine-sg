+
+#ifndef __WINE_WINDOWS_MEDIA_SPEECH_SAPI_ENGINE_H
+#define __WINE_WINDOWS_MEDIA_SPEECH_SAPI_ENGINE_H
+
+#include "mmreg.h"
+
+/* a run of the plain text, or a pause */
+struct ssml_piece
+{
+    ULONG start, len;   /* in the plain text */
+    ULONG silence;      /* a break, in milliseconds */
+    BOOL is_break;
+};
+
+struct sapi_event
+{
+    BOOL word;
+    ULONGLONG offset;   /* audio bytes */
+    ULONG text_pos, text_len;
+};
+
+/* what the engine said: the audio (in the format asked for) and its boundaries */
+struct sapi_output
+{
+    BYTE *data;
+    SIZE_T size, capacity;
+    struct sapi_event *events;
+    UINT32 event_count, event_capacity;
+};
+
+/* speaks the pieces of plain with the voice whose token key is token_name; the caller frees
+ * output->data and output->events */
+extern HRESULT sapi_speak( const WCHAR *token_name, const WCHAR *plain, const struct ssml_piece *pieces, UINT32 count,
+                           LONG rate, USHORT volume, LONG pitch, const WAVEFORMATEX *wfx, struct sapi_output *output );
+
+#endif
diff --git a/dlls/windows.media.speech/synthesizer.c b/dlls/windows.media.speech/synthesizer.c
index 91de0e5..e452d4b 100644
--- a/dlls/windows.media.speech/synthesizer.c
+++ b/dlls/windows.media.speech/synthesizer.c
@@ -17,7 +17,12 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
+#include <math.h>
+
 #include "private.h"
+#include "winreg.h"
+#include "shcore.h"
+#include "sapi_engine.h"
 
 #include "wine/debug.h"
 
@@ -29,6 +34,217 @@ WINE_DEFAULT_DEBUG_CHANNEL(speech);
  *
  */
 
+
+/*
+ * Stained Glass OS (wine-sg 6510): the installed voices are SAPI's (HKLM\...\Speech\Voices\
+ * Tokens, the "Wine Default Voice" of msttsengine, 6508): AllVoices lists them, DefaultVoice is
+ * the category's default (or the first), and a new synthesizer speaks with it.
+ */
+struct voice_information
+{
+    IVoiceInformation IVoiceInformation_iface;
+    LONG ref;
+    HSTRING display_name, id, language, description;
+    VoiceGender gender;
+};
+
+static inline struct voice_information *impl_from_IVoiceInformation( IVoiceInformation *iface )
+{
+    return CONTAINING_RECORD(iface, struct voice_information, IVoiceInformation_iface);
+}
+
+static HRESULT WINAPI voice_information_QueryInterface( IVoiceInformation *iface, REFIID iid, void **out )
+{
+    struct voice_information *impl = impl_from_IVoiceInformation(iface);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IVoiceInformation))
+    {
+        IInspectable_AddRef((*out = &impl->IVoiceInformation_iface));
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI voice_information_AddRef( IVoiceInformation *iface )
+{
+    struct voice_information *impl = impl_from_IVoiceInformation(iface);
+    return InterlockedIncrement(&impl->ref);
+}
+
+static ULONG WINAPI voice_information_Release( IVoiceInformation *iface )
+{
+    struct voice_information *impl = impl_from_IVoiceInformation(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+
+    if (!ref)
+    {
+        WindowsDeleteString(impl->display_name);
+        WindowsDeleteString(impl->id);
+        WindowsDeleteString(impl->language);
+        WindowsDeleteString(impl->description);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI voice_information_GetIids( IVoiceInformation *iface, ULONG *iid_count, IID **iids )
+{
+    return SG_GET_IIDS(iid_count, iids, &IID_IVoiceInformation);
+}
+
+static HRESULT WINAPI voice_information_GetRuntimeClassName( IVoiceInformation *iface, HSTRING *class_name )
+{
+    return SG_CLASS_NAME(class_name, L"Windows.Media.SpeechSynthesis.VoiceInformation");
+}
+
+static HRESULT WINAPI voice_information_GetTrustLevel( IVoiceInformation *iface, TrustLevel *trust_level )
+{
+    return sg_get_trust_level(trust_level);
+}
+
+#define VOICE_STRING_GETTER( name, member ) \
+    static HRESULT WINAPI voice_information_get_##name( IVoiceInformation *iface, HSTRING *value ) \
+    { \
+        struct voice_information *impl = impl_from_IVoiceInformation(iface); \
+        if (!value) return E_POINTER; \
+        return WindowsDuplicateString(impl->member, value); \
+    }
+VOICE_STRING_GETTER( DisplayName, display_name )
+VOICE_STRING_GETTER( Id, id )
+VOICE_STRING_GETTER( Language, language )
+VOICE_STRING_GETTER( Description, description )
+
+static HRESULT WINAPI voice_information_get_Gender( IVoiceInformation *iface, VoiceGender *value )
+{
+    struct voice_information *impl = impl_from_IVoiceInformation(iface);
+    if (!value) return E_POINTER;
+    *value = impl->gender;
+    return S_OK;
+}
+
+static const struct IVoiceInformationVtbl voice_information_vtbl =
+{
+    voice_information_QueryInterface,
+    voice_information_AddRef,
+    voice_information_Release,
+    voice_information_GetIids,
+    voice_information_GetRuntimeClassName,
+    voice_information_GetTrustLevel,
+    voice_information_get_DisplayName,
+    voice_information_get_Id,
+    voice_information_get_Language,
+    voice_information_get_Description,
+    voice_information_get_Gender,
+};
+
+static const WCHAR voices_key[] = L"SOFTWARE\\Microsoft\\Speech\\Voices\\Tokens";
+
+/* the token key names of the installed voices, the default first; the count */
+static UINT32 voice_token_names( WCHAR names[][64], UINT32 max )
+{
+    WCHAR def[MAX_PATH] = L"", *base;
+    DWORD size = sizeof(def), i, len;
+    UINT32 count = 0, k;
+    HKEY key;
+
+    RegGetValueW(HKEY_LOCAL_MACHINE, L"SOFTWARE\\Microsoft\\Speech\\Voices", L"DefaultDefaultTokenId", RRF_RT_REG_SZ,
+                 NULL, def, &size);
+    base = wcsrchr(def, '\\');
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, voices_key, 0, KEY_READ, &key)) return 0;
+    for (i = 0; count < max; i++)
+    {
+        WCHAR clsid[64];
+        HKEY token;
+
+        len = 64;
+        if (RegEnumKeyExW(key, i, names[count], &len, NULL, NULL, NULL, NULL)) break;
+        /* a voice an engine speaks */
+        size = sizeof(clsid);
+        if (RegOpenKeyExW(key, names[count], 0, KEY_READ, &token)) continue;
+        if (RegGetValueW(token, NULL, L"CLSID", RRF_RT_REG_SZ, NULL, clsid, &size))
+        {
+            RegCloseKey(token);
+            continue;
+        }
+        RegCloseKey(token);
+        if (base && !wcsicmp(names[count], base + 1) && count)
+        {
+            WCHAR tmp[64];
+            /* the default first */
+            lstrcpyW(tmp, names[0]);
+            lstrcpyW(names[0], names[count]);
+            lstrcpyW(names[count], tmp);
+        }
+        count++;
+    }
+    RegCloseKey(key);
+    for (k = 0; k < count; k++) TRACE("voice %u %s\n", k, debugstr_w(names[k]));
+    return count;
+}
+
+static HRESULT voice_information_create( const WCHAR *name, IVoiceInformation **out )
+{
+    struct voice_information *impl;
+    WCHAR path[MAX_PATH], value[128], lang[LOCALE_NAME_MAX_LENGTH] = L"en-US", desc[256];
+    DWORD size;
+    LCID lcid;
+    HKEY key;
+
+    *out = NULL;
+    swprintf(path, ARRAY_SIZE(path), L"%s\\%s", voices_key, name);
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key)) return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    if (!(impl = calloc(1, sizeof(*impl))))
+    {
+        RegCloseKey(key);
+        return E_OUTOFMEMORY;
+    }
+    impl->IVoiceInformation_iface.lpVtbl = &voice_information_vtbl;
+    impl->ref = 1;
+
+    size = sizeof(value);
