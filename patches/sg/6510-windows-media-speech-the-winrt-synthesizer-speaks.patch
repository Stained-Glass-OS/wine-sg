+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "objbase.h"
+#include "sapiddk.h"
+#include "sperror.h"
+
+#include "sapi_engine.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(speech);
+
+static const WCHAR voices_key[] = L"SOFTWARE\\Microsoft\\Speech\\Voices\\Tokens";
+
+static const GUID sg_IID_ISpTTSEngine = {0xa74d7c8e,0x4cc5,0x4f2f,{0xa6,0xeb,0x80,0x4d,0xee,0x18,0x50,0x0e}};
+static const GUID sg_IID_ISpTTSEngineSite = {0x9880499b,0xcce9,0x11d2,{0xb5,0x03,0x00,0xc0,0x4f,0x79,0x73,0x96}};
+static const GUID sg_IID_ISpEventSink = {0xbe7a9cc9,0x5f9e,0x11d2,{0x96,0x0f,0x00,0xc0,0x4f,0x8e,0xe6,0x28}};
+static const GUID sg_IID_ISpObjectWithToken = {0x5b559f40,0xe952,0x11d2,{0xbb,0x91,0x00,0xc0,0x4f,0x8e,0xe6,0xc0}};
+static const GUID sg_IID_ISpObjectToken = {0x14056589,0xe16c,0x11d2,{0xbb,0x90,0x00,0xc0,0x4f,0x8e,0xe6,0xc0}};
+static const GUID sg_CLSID_SpObjectToken = {0xef411752,0x3736,0x4cb4,{0x9c,0x8c,0x8e,0xf4,0xcc,0xb5,0x8e,0xfe}};
+static const GUID sg_SPDFID_WaveFormatEx = {0xc31adbae,0x527f,0x4ff5,{0xa2,0x30,0xf6,0x2b,0xb6,0x1f,0xf7,0x0c}};
+
+
+/* the engine site: the audio and the boundary events, in memory */
+struct synth_site
+{
+    ISpTTSEngineSite ISpTTSEngineSite_iface;
+    struct sapi_output *out;
+    LONG rate;
+    USHORT volume;
+};
+
+static inline struct synth_site *impl_from_ISpTTSEngineSite( ISpTTSEngineSite *iface )
+{
+    return CONTAINING_RECORD(iface, struct synth_site, ISpTTSEngineSite_iface);
+}
+
+static HRESULT WINAPI synth_site_QueryInterface( ISpTTSEngineSite *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &sg_IID_ISpEventSink) ||
+        IsEqualGUID(iid, &sg_IID_ISpTTSEngineSite))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+/* the site lives on the synthesizing thread's stack, for the one Speak call */
+static ULONG WINAPI synth_site_AddRef( ISpTTSEngineSite *iface ) { return 2; }
+static ULONG WINAPI synth_site_Release( ISpTTSEngineSite *iface ) { return 1; }
+
+static HRESULT WINAPI synth_site_AddEvents( ISpTTSEngineSite *iface, const SPEVENT *events, ULONG count )
+{
+    struct synth_site *site = impl_from_ISpTTSEngineSite(iface);
+    ULONG i;
+
+    for (i = 0; i < count; i++)
+    {
+        struct sapi_event *event;
+
+        if (events[i].eEventId != SPEI_WORD_BOUNDARY && events[i].eEventId != SPEI_SENTENCE_BOUNDARY) continue;
+        if (site->out->event_count == site->out->event_capacity)
+        {
+            UINT32 capacity = max(64, site->out->event_capacity * 2);
+            struct sapi_event *grown = realloc(site->out->events, capacity * sizeof(*grown));
+            if (!grown) return E_OUTOFMEMORY;
+            site->out->events = grown;
+            site->out->event_capacity = capacity;
+        }
+        event = &site->out->events[site->out->event_count++];
+        event->word = events[i].eEventId == SPEI_WORD_BOUNDARY;
+        event->offset = events[i].ullAudioStreamOffset;
+        event->text_pos = events[i].lParam;
+        event->text_len = events[i].wParam;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI synth_site_GetEventInterest( ISpTTSEngineSite *iface, ULONGLONG *interest )
+{
+    *interest = ((ULONGLONG)1 << SPEI_WORD_BOUNDARY) | ((ULONGLONG)1 << SPEI_SENTENCE_BOUNDARY);
+    return S_OK;
+}
+
+static DWORD WINAPI synth_site_GetActions( ISpTTSEngineSite *iface )
+{
+    return SPVES_CONTINUE;
+}
+
+static HRESULT WINAPI synth_site_Write( ISpTTSEngineSite *iface, const void *buf, ULONG size, ULONG *written )
+{
+    struct synth_site *site = impl_from_ISpTTSEngineSite(iface);
+
+    if (written) *written = 0;
+    if (site->out->size + size > site->out->capacity)
+    {
+        SIZE_T capacity = max(site->out->size + size, max(65536, site->out->capacity * 2));
+        BYTE *grown = realloc(site->out->data, capacity);
+        if (!grown) return E_OUTOFMEMORY;
+        site->out->data = grown;
+        site->out->capacity = capacity;
+    }
+    memcpy(site->out->data + site->out->size, buf, size);
+    site->out->size += size;
+    if (written) *written = size;
+    return S_OK;
+}
+
+static HRESULT WINAPI synth_site_GetRate( ISpTTSEngineSite *iface, LONG *rate )
+{
+    *rate = impl_from_ISpTTSEngineSite(iface)->rate;
+    return S_OK;
+}
+
+static HRESULT WINAPI synth_site_GetVolume( ISpTTSEngineSite *iface, USHORT *volume )
+{
+    *volume = impl_from_ISpTTSEngineSite(iface)->volume;
+    return S_OK;
+}
+
+static HRESULT WINAPI synth_site_GetSkipInfo( ISpTTSEngineSite *iface, SPVSKIPTYPE *type, LONG *count )
+{
+    *type = SPVST_SENTENCE;
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI synth_site_CompleteSkip( ISpTTSEngineSite *iface, LONG skipped )
+{
+    return S_OK;
+}
+
+static const struct ISpTTSEngineSiteVtbl synth_site_vtbl =
+{
+    synth_site_QueryInterface,
+    synth_site_AddRef,
+    synth_site_Release,
+    synth_site_AddEvents,
+    synth_site_GetEventInterest,
+    synth_site_GetActions,
+    synth_site_Write,
+    synth_site_GetRate,
+    synth_site_GetVolume,
+    synth_site_GetSkipInfo,
+    synth_site_CompleteSkip,
+};
+
+
+/* the engine of a voice token, set to its token */
+static HRESULT create_voice_engine( const WCHAR *token_name, ISpTTSEngine **engine, LANGID *langid )
+{
+    WCHAR path[MAX_PATH], clsid_str[64], lang[64];
+    ISpObjectWithToken *with_token;
+    ISpObjectToken *token;
+    DWORD size = sizeof(clsid_str);
+    CLSID clsid;
+    HRESULT hr;
+
+    *engine = NULL;
+    *langid = MAKELANGID(LANG_ENGLISH, SUBLANG_ENGLISH_US);
+    swprintf(path, ARRAY_SIZE(path), L"%s\\%s", voices_key, token_name);
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, path, L"CLSID", RRF_RT_REG_SZ, NULL, clsid_str, &size))
+        return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    {
+        WCHAR attributes[MAX_PATH];
+
+        swprintf(attributes, ARRAY_SIZE(attributes), L"%s\\Attributes", path);
+        size = sizeof(lang);
+        if (!RegGetValueW(HKEY_LOCAL_MACHINE, attributes, L"Language", RRF_RT_REG_SZ, NULL, lang, &size))
+            *langid = LANGIDFROMLCID(wcstoul(lang, NULL, 16));
+    }
+    if (FAILED(hr = CLSIDFromString(clsid_str, &clsid))) return hr;
+    if (FAILED(hr = CoCreateInstance(&clsid, NULL, CLSCTX_INPROC_SERVER, &sg_IID_ISpTTSEngine, (void **)engine)))
+        return hr;
+
+    /* the engine reads its voice from its token */
+    swprintf(path, ARRAY_SIZE(path), L"HKEY_LOCAL_MACHINE\\%s\\%s", voices_key, token_name);
+    if (SUCCEEDED(CoCreateInstance(&sg_CLSID_SpObjectToken, NULL, CLSCTX_INPROC_SERVER, &sg_IID_ISpObjectToken, (void **)&token)))
+    {
+        if (SUCCEEDED(ISpObjectToken_SetId(token, NULL, path, FALSE)) &&
+            SUCCEEDED(ISpTTSEngine_QueryInterface(*engine, &sg_IID_ISpObjectWithToken, (void **)&with_token)))
+        {
+            ISpObjectWithToken_SetObjectToken(with_token, token);
+            ISpObjectWithToken_Release(with_token);
+        }
+        ISpObjectToken_Release(token);
+    }
+    return S_OK;
+}
+
+
+HRESULT sapi_speak( const WCHAR *token_name, const WCHAR *plain, const struct ssml_piece *pieces, UINT32 count,
+                    LONG rate, USHORT volume, LONG pitch, const WAVEFORMATEX *wfx, struct sapi_output *output )
+{
+    struct synth_site site = { { &synth_site_vtbl }, output, rate, volume };
+    ISpTTSEngine *engine;
+    SPVTEXTFRAG *frags;
+    LANGID langid;
+    HRESULT hr, init;
+    UINT32 i;
+
+    TRACE("token %s, count %u, rate %ld, volume %u, pitch %ld.\n", debugstr_w(token_name), count, rate, volume, pitch);
+
+    if (!(frags = calloc(count, sizeof(*frags)))) return E_OUTOFMEMORY;
+    init = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    if (SUCCEEDED(hr = create_voice_engine(token_name, &engine, &langid)))
+    {
+        for (i = 0; i < count; i++)
+        {
+            frags[i].pNext = i + 1 < count ? &frags[i + 1] : NULL;
+            frags[i].State.LangID = langid;
+            frags[i].State.Volume = 100;
+            frags[i].State.PitchAdj.MiddleAdj = pitch;
+            if (pieces[i].is_break)
+            {
+                frags[i].State.eAction = SPVA_Silence;
+                frags[i].State.SilenceMSecs = pieces[i].silence;
+                frags[i].pTextStart = plain + (i ? pieces[i - 1].start + pieces[i - 1].len : 0);
+            }
+            else
+            {
+                frags[i].State.eAction = SPVA_Speak;
+                frags[i].pTextStart = plain + pieces[i].start;
+                frags[i].ulTextLen = pieces[i].len;
+                frags[i].ulTextSrcOffset = pieces[i].start;
+            }
+        }
+        hr = ISpTTSEngine_Speak(engine, SPF_DEFAULT, &sg_SPDFID_WaveFormatEx, wfx, frags, &site.ISpTTSEngineSite_iface);
+        ISpTTSEngine_Release(engine);
+    }
+    if (SUCCEEDED(init)) CoUninitialize();
+    free(frags);
+    return hr;
+}
