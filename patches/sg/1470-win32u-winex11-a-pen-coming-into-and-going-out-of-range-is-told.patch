From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, winex11: a pen coming into and going out of range is told

RegisterPointerDeviceNotifications( hwnd, TRUE ) asks for
WM_POINTERDEVICEINRANGE / WM_POINTERDEVICEOUTOFRANGE as well as
WM_POINTERDEVICECHANGE; the range flag was dropped, so a drawing program
never heard the pen come near or go (it shows or hides its brush outline
then). winex11 hears sg-compositor's _SG_PEN_IN_RANGE on the desktop's
thread only, so the window registered for range is named on its top-level
window (a property, any process sees it) and win32u posts the messages,
one per pen device, to each such window when the range changes.

Gate: test/latepen-gate.sh (range in and out, of the arrived pen; not to a
window registered without range). Mutant: SG_MUTANT_NO_PEN_RANGE_MSG.
---
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -2618,6 +2618,11 @@
 /* Stained Glass OS (wine-sg 1420): the windows that asked to hear of pointer
  * devices coming and going (RegisterPointerDeviceNotifications) */
 static HWND sg_pointer_notify_windows[16];
+/* wine-sg 1470: whether the pens are in range (the desktop's process hears
+ * it); a window that asked to hear of a pen coming into and going out of
+ * range is named on its top-level window, for any process to see */
+static BOOL sg_pointer_in_range;
+static const WCHAR sg_pen_rangeW[] = {'_','_','w','i','n','e','_','s','g','_','p','e','n','_','r','a','n','g','e',0};
 
 static BOOL sg_pointer_device_listed( const struct sg_pointer_device *list, UINT count, UINT handle )
 {
@@ -2629,6 +2634,7 @@
 BOOL sg_register_pointer_notify( HWND hwnd, BOOL range )
 {
     UINT i, free_slot = ARRAY_SIZE(sg_pointer_notify_windows);
+    HWND top;
 
     if (!(hwnd = get_full_window_handle( hwnd )) || !is_window( hwnd ))
     {
@@ -2645,6 +2651,11 @@
     }
     if (i == ARRAY_SIZE(sg_pointer_notify_windows) && free_slot < i) sg_pointer_notify_windows[free_slot] = hwnd;
     pthread_mutex_unlock( &sg_pointer_devices_lock );
+    if ((top = NtUserGetAncestor( hwnd, GA_ROOT )))
+    {
+        if (range) NtUserSetProp( top, sg_pen_rangeW, hwnd );
+        else if (NtUserGetProp( top, sg_pen_rangeW ) == hwnd) NtUserRemoveProp( top, sg_pen_rangeW );
+    }
     TRACE( "hwnd %p range %d\n", hwnd, range );
     return TRUE;
 }
@@ -2696,6 +2707,42 @@
     return ret;
 }
 
+/* Stained Glass OS (wine-sg 1470): the display driver tells a pen came into
+ * or went out of range of the screen (winex11: the desktop's thread hears
+ * sg-compositor say it); the windows registered with
+ * RegisterPointerDeviceNotifications( hwnd, TRUE ), in any process, hear it
+ * as WM_POINTERDEVICEINRANGE / WM_POINTERDEVICEOUTOFRANGE of each pen
+ * device, as on Windows -- a drawing program shows or hides its brush
+ * outline then. Before, the range flag was dropped. Only a change is told. */
+BOOL sg_pointer_range( BOOL in_range )
+{
+    UINT pens[SG_MAX_POINTER_DEVICES];
+    UINT i, j, npens = 0;
+    HWND *list, hwnd;
+    BOOL changed;
+
+    in_range = !!in_range;
+    pthread_mutex_lock( &sg_pointer_devices_lock );
+    changed = sg_pointer_in_range != in_range;
+    sg_pointer_in_range = in_range;
+    for (i = 0; changed && i < sg_pointer_device_count; i++)
+        if (sg_pointer_device_list[i].type == PT_PEN) pens[npens++] = sg_pointer_device_list[i].handle;
+    pthread_mutex_unlock( &sg_pointer_devices_lock );
+
+    TRACE( "%s, changed %d, %u pens\n", in_range ? "in range" : "out of range", changed, npens );
+    if (!changed || !npens || !(list = list_window_children( get_desktop_window() ))) return changed;
+#ifndef SG_MUTANT_NO_PEN_RANGE_MSG
+    for (j = 0; list[j]; j++)
+    {
+        if (!(hwnd = NtUserGetProp( list[j], sg_pen_rangeW )) || !is_window( hwnd )) continue;
+        for (i = 0; i < npens; i++)
+            NtUserPostMessage( hwnd, in_range ? WM_POINTERDEVICEINRANGE : WM_POINTERDEVICEOUTOFRANGE, pens[i], 0 );
+    }
+#endif
+    free( list );
+    return changed;
+}
+
 /* Stained Glass OS (wine-sg 1150): GetSystemMetrics' SM_DIGITIZER and
  * SM_MAXIMUMTOUCHES, from the display driver's devices -- Qt, for one, takes
  * touches only with a touch screen named there */
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -7529,6 +7529,9 @@
     case NtUserCallTwoParam_SgRegisterPointerNotify:
         return sg_register_pointer_notify( UlongToHandle( arg1 ), arg2 );
 
+    case NtUserCallTwoParam_SgPointerRange:
+        return sg_pointer_range( arg1 );
+
     default:
         FIXME( "invalid code %u\n", (int)code );
         return 0;
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -113,6 +113,7 @@
 extern BOOL get_clip_cursor( RECT *rect, UINT dpi, MONITOR_DPI_TYPE type );
 extern UINT sg_pointer_devices( UINT count, struct sg_pointer_device *devices );
 extern BOOL sg_register_pointer_notify( HWND hwnd, BOOL range );
+extern BOOL sg_pointer_range( BOOL in_range );
 /* Stained Glass OS: touches as touches (wine-sg 1150, input.c) */
 extern void free_touch_state(void);
 extern void sg_touch_retrieved( MSG *msg, UINT hw_id, UINT32 info );
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -1235,6 +1235,8 @@
     NtUserCallTwoParam_SgGetTouchInput,
     /* Stained Glass OS: pointer devices coming and going (wine-sg 1420) */
     NtUserCallTwoParam_SgRegisterPointerNotify,
+    /* Stained Glass OS: a pen in and out of range (wine-sg 1470) */
+    NtUserCallTwoParam_SgPointerRange,
 };
 
 /* Stained Glass OS: the pointer message (a pen's) the thread is handling,
@@ -1364,6 +1366,12 @@
     return NtUserCallTwoParam( HandleToUlong( hwnd ), range, NtUserCallTwoParam_SgRegisterPointerNotify );
 }
 
+/* the display driver tells a pen came into or went out of range (wine-sg 1470) */
+static inline BOOL NtUserSgPointerRange( BOOL in_range )
+{
+    return NtUserCallTwoParam( in_range, 0, NtUserCallTwoParam_SgPointerRange );
+}
+
 /* the display driver sets the list */
 static inline UINT NtUserSgSetPointerDevices( UINT count, const struct sg_pointer_device *devices )
 {
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -2295,9 +2295,10 @@
     TRACE( "%d touch screens\n", count );
 }
 
-/* the root window's _SG_PEN_IN_RANGE changed (sg-compositor): 0, a pen left
- * the range -- every pen's pointer leaves (the server sends WM_POINTERLEAVE
- * to the window the pen was over, if any) */
+/* the root window's _SG_PEN_IN_RANGE changed (sg-compositor): win32u tells
+ * the windows registered for it (wine-sg 1470); 0, a pen left the range --
+ * every pen's pointer leaves (the server sends WM_POINTERLEAVE to the window
+ * the pen was over, if any) */
 void x11drv_pen_range_notify( XPropertyEvent *event )
 {
     unsigned long count, remaining;
@@ -2316,6 +2317,7 @@
         XFree( value );
     }
     TRACE( "pen %s\n", in_range ? "in range" : "out of range" );
+    NtUserSgPointerRange( in_range );  /* WM_POINTERDEVICEINRANGE / OUTOFRANGE */
 #ifdef SG_MUTANT_NO_PEN_LEAVE
     return;
 #endif
