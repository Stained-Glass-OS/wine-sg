From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernel32: private profile edge cases (flush result, struct errors, double-null lists, delete creates file)

Private-profile functions differed from Windows in edge cases that Wine's
own conformance tests (todo_wine) describe: flushing the cache with
WritePrivateProfileString(NULL, NULL, NULL, file) returns TRUE whether or
not the file exists; GetPrivateProfileStruct fails with ERROR_BAD_LENGTH
(missing key, value of another length) or ERROR_INVALID_DATA (bad hex
digit, wrong checksum); cut-short and exactly-fitting name lists from the
ANSI functions end with two nulls; deleting a section or key of a file that
does not exist creates it, empty (not when the section is registry-mapped).

---
--- a/dlls/kernel32/profile.c
+++ b/dlls/kernel32/profile.c
@@ -906,7 +906,13 @@ static INT PROFILE_GetSection( const WCHAR *filename, LPCWSTR section_name,
     return 0;
 }
 
-static BOOL PROFILE_DeleteSection( const WCHAR *filename, const WCHAR *name )
+/* a profile that was never read from or written to a file: the file does not exist yet */
+static BOOL profile_file_missing(void)
+{
+    return !CurProfile->LastWriteTime.dwLowDateTime && !CurProfile->LastWriteTime.dwHighDateTime;
+}
+
+static BOOL PROFILE_DeleteSection( const WCHAR *filename, const WCHAR *name, BOOL create )
 {
     PROFILESECTION **section;
 
@@ -931,6 +937,14 @@ static BOOL PROFILE_DeleteSection( const WCHAR *filename, const WCHAR *name )
             break;
         }
     }
+#ifndef SG_MUTANT_NO_CREATE_ON_DELETE
+    /* deleting from a file that does not exist creates it, empty */
+    if (create && profile_file_missing())
+    {
+        CurProfile->changed = TRUE;
+        PROFILE_FlushFile();
+    }
+#endif
 
     LeaveCriticalSection( &PROFILE_CritSect );
     return TRUE;
@@ -1277,6 +1291,7 @@ static void delete_key_values( HKEY key )
 static BOOL delete_section( const WCHAR *filename, const WCHAR *section )
 {
     HKEY key, subkey, section_key;
+    BOOL mapped = FALSE;
 
     if ((key = open_file_mapping_key( filename )))
     {
@@ -1286,6 +1301,7 @@ static BOOL delete_section( const WCHAR *filename, const WCHAR *section )
             HKEY entry_key;
             DWORD i;
 
+            mapped = TRUE;
             for (i = 0; (entry = enum_key( subkey, i )); ++i)
             {
                 if (!(path = get_key_value( subkey, entry )))
@@ -1315,6 +1331,7 @@ static BOOL delete_section( const WCHAR *filename, const WCHAR *section )
         }
         else if (get_mapped_section_key( filename, section, NULL, TRUE, &section_key ))
         {
+            mapped = TRUE;
             delete_key_values( section_key );
             RegCloseKey( section_key );
         }
@@ -1322,7 +1339,7 @@ static BOOL delete_section( const WCHAR *filename, const WCHAR *section )
         RegCloseKey( key );
     }
 
-    return PROFILE_DeleteSection( filename, section );
+    return PROFILE_DeleteSection( filename, section, !mapped );
 }
 
 /********************* API functions **********************************/
@@ -1469,6 +1486,10 @@ INT WINAPI GetPrivateProfileStringA( LPCSTR section, LPCSTR entry,
                 ret = len - 1;
         }
         buffer[ret] = 0;
+#ifndef SG_MUTANT_NO_A_DOUBLENULL
+        /* a list of names always ends with two nulls, even when it was cut short */
+        if ((!section || !entry) && (UINT)ret + 1 < len) buffer[ret + 1] = 0;
+#endif
     }
 
     RtlFreeUnicodeString(&sectionW);
@@ -1664,7 +1685,11 @@ BOOL WINAPI WritePrivateProfileStringW( LPCWSTR section, LPCWSTR entry,
             if (CurProfile) PROFILE_ReleaseFile();
         }
         LeaveCriticalSection( &PROFILE_CritSect );
+#ifdef SG_MUTANT_NO_FLUSH_TRUE
         return FALSE;
+#else
+        return TRUE;  /* flushing the cache always succeeds, whether or not the file exists */
+#endif
     }
     if (!entry) return delete_section( filename, section );
 
@@ -1689,7 +1714,12 @@ BOOL WINAPI WritePrivateProfileStringW( LPCWSTR section, LPCWSTR entry,
         if (!section)
             SetLastError(ERROR_FILE_NOT_FOUND);
         else
+        {
+#ifndef SG_MUTANT_NO_CREATE_ON_DELETE
+            if (!string && profile_file_missing()) CurProfile->changed = TRUE;
+#endif
             ret = PROFILE_SetString( section, entry, string, FALSE);
+        }
         if (ret) ret = PROFILE_FlushFile();
     }
 
@@ -1959,6 +1989,9 @@ DWORD WINAPI GetPrivateProfileSectionNamesA( LPSTR buffer, DWORD size,
         }
         else
           ret = ret-1;
+#ifndef SG_MUTANT_NO_A_DOUBLENULL
+        if ((DWORD)ret + 1 < size) buffer[ret + 1] = 0;
+#endif
     }
     else if(size)
         buffer[0] = '\0';
@@ -1999,20 +2032,35 @@ BOOL WINAPI GetPrivateProfileStructW (LPCWSTR section, LPCWSTR key,
     int val;
     WCHAR *p, *buffer;
 
-    if (!(buffer = HeapAlloc( GetProcessHeap(), 0, (2 * len + 3) * sizeof(WCHAR) ))) return FALSE;
+    /* one character more than the value must have, so that a value that is too long shows */
+    if (!(buffer = HeapAlloc( GetProcessHeap(), 0, (2 * len + 4) * sizeof(WCHAR) ))) return FALSE;
 
-    if (GetPrivateProfileStringW( section, key, NULL, buffer, 2 * len + 3, filename ) != 2 * len + 2)
+    /* a missing key or a value of the wrong length is a bad length; bad hex digits or a
+     * checksum that does not match are invalid data */
+    if (GetPrivateProfileStringW( section, key, NULL, buffer, 2 * len + 4, filename ) != 2 * len + 2)
+    {
+#ifndef SG_MUTANT_NO_STRUCT_ERR
+        SetLastError( ERROR_BAD_LENGTH );
+#endif
         goto done;
+    }
 
     for (p = buffer; len; p += 2, len--)
     {
-        if ((val = get_hex_byte( p )) == -1) goto done;
+        if ((val = get_hex_byte( p )) == -1) goto invalid;
         *data++ = val;
         chksum += val;
     }
     /* retrieve stored checksum value */
-    if ((val = get_hex_byte( p )) == -1) goto done;
+    if ((val = get_hex_byte( p )) == -1) goto invalid;
     ret = ((BYTE)val == chksum);
+    if (!ret)
+    {
+    invalid:
+#ifndef SG_MUTANT_NO_STRUCT_ERR
+        SetLastError( ERROR_INVALID_DATA );
+#endif
+    }
 
 done:
     HeapFree( GetProcessHeap(), 0, buffer );
