From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Task View shows Chrome -- a window whose client area is one colour has nothing drawn

0816 took Task View's and Alt+Tab's picture of a window from the screen
when what Wine keeps of it -- PrintWindow's picture -- was all black: a
window drawing through Direct3D, OpenGL or Vulkan. Chrome draws so too,
but its class paints a dark gray background first and Wine draws a frame
round it, so its picture was the frame and a gray rectangle, not black:
Chrome showed as an empty card in Task View and in Alt+Tab (regression
walk on a fresh install, 2026-10-05). A picture whose client area is all
one colour now counts as nothing drawn, black or not. A window that
really is one colour loses nothing: it is taken from the screen while in
front, and otherwise keeps its last picture.

Test: test/glthumbgray-gate.sh with test/glthumb-probe.c's "gray" mode
(mutant SG_MUTANT_THUMB_BLACK_ONLY); glthumb, taskview-anim and
taskview-linux pass.
---
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -110,19 +110,43 @@
 /* Stained Glass OS: a picture with nothing in it. A window that draws
  * through Direct3D, OpenGL or Vulkan (WPF: Sonos, David 2026-10-05; games,
  * players) presents straight to its X window: what Wine kept of it, which
- * PrintWindow gives, is black. Every 8th pixel of every 8th row looked at. */
-static BOOL all_black( HDC dc, HBITMAP bmp, int w, int h )
+ * PrintWindow gives, is black -- or its class's background (Chrome). Every
+ * 8th pixel of every 8th row of its client area looked at. */
+static BOOL all_black( HWND hwnd, HDC dc, HBITMAP bmp, int w, int h )
 {
     BITMAPINFO bi = { { sizeof(BITMAPINFOHEADER), w, -h, 1, 32, BI_RGB } };
-    DWORD *px;
+    DWORD *px, first;
     int x, y;
     BOOL black = TRUE;
+    RECT client = { 0, 0, w, h };
 
+#ifndef SG_MUTANT_THUMB_BLACK_ONLY
+    /* Its client area, where the program draws, all one colour: nothing of
+     * it is there. The colour is the window's background when its class has
+     * one -- Chrome's dark gray, inside the frame Wine draws round it: Chrome
+     * showed as an empty card in Task View and Alt+Tab (regression walk
+     * 2026-10-05). A window that really is one colour is taken from the
+     * screen while in front, or keeps its last picture: no harm. */
+    {
+        RECT wr;
+        POINT org = { 0, 0 };
+        if (GetWindowRect( hwnd, &wr ) && GetClientRect( hwnd, &client ) && ClientToScreen( hwnd, &org ))
+        {
+            OffsetRect( &client, org.x - wr.left, org.y - wr.top );
+            IntersectRect( &client, &client, &(RECT){ 0, 0, w, h } );
+        }
+        if (client.right - client.left < 16 || client.bottom - client.top < 16) SetRect( &client, 0, 0, w, h );
+    }
+#endif
     if (!(px = malloc( (size_t)w * h * 4 ))) return FALSE;
     if (!GetDIBits( dc, bmp, 0, h, px, &bi, DIB_RGB_COLORS )) { free( px ); return FALSE; }
-    for (y = 0; y < h && black; y += 8)
-        for (x = 0; x < w; x += 8)
-            if (px[y * w + x] & 0xffffff) { black = FALSE; break; }
+    first = px[client.top * w + client.left] & 0xffffff;
+#ifdef SG_MUTANT_THUMB_BLACK_ONLY
+    first = 0;
+#endif
+    for (y = client.top; y < client.bottom && black; y += 8)
+        for (x = client.left; x < client.right; x += 8)
+            if ((px[y * w + x] & 0xffffff) != first) { black = FALSE; break; }
     free( px );
     return black;
 }
@@ -168,7 +192,7 @@
     {
 #ifndef SG_MUTANT_D3D_THUMB_BLACK
         SelectObject( full, first );
-        if (all_black( full, whole, w, h ))
+        if (all_black( hwnd, full, whole, w, h ))
         {
             /* drawn through Direct3D or OpenGL: from the screen, while it is
              * in front -- the last picture otherwise, not a black one */
