--- a/dlls/dmime/dmime_main.c
+++ b/dlls/dmime/dmime_main.c
@@ -37,6 +37,31 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(dmime);
 
+HRESULT track_play_ex(IDirectMusicTrack *track, void *state_data, REFERENCE_TIME start_time,
+        REFERENCE_TIME end_time, REFERENCE_TIME offset, DWORD flags, IDirectMusicPerformance *performance,
+        IDirectMusicSegmentState *segment_state, DWORD track_id)
+{
+    MUSIC_TIME music_start, music_end, music_offset;
+    HRESULT hr;
+
+    if (!performance) return E_POINTER;
+
+#ifdef SG_MUTANT_PLAYEX
+    return IDirectMusicTrack_Play(track, state_data, start_time, end_time, 0, flags, performance,
+            segment_state, track_id);
+#endif
+    /* the segment starts at 'offset', start_time and end_time are relative to it */
+    if (FAILED(hr = IDirectMusicPerformance_ReferenceToMusicTime(performance, offset, &music_offset))
+            || FAILED(hr = IDirectMusicPerformance_ReferenceToMusicTime(performance, offset + start_time,
+                    &music_start))
+            || FAILED(hr = IDirectMusicPerformance_ReferenceToMusicTime(performance, offset + end_time,
+                    &music_end)))
+        return hr;
+
+    return IDirectMusicTrack_Play(track, state_data, music_start - music_offset,
+            music_end - music_offset, music_offset, flags, performance, segment_state, track_id);
+}
+
 typedef struct {
         IClassFactory IClassFactory_iface;
         HRESULT (*fnCreateInstance)(REFIID riid, void **ret_iface);
