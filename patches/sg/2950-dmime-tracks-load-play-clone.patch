+
+static HRESULT parse_sysex_chunk(IDirectMusicSysExTrack *This, IStream *stream, struct chunk_entry *chunk)
+{
+    DMUS_IO_SYSEX_ITEM header;
+    struct sysex_item *item;
+    DWORD offset = 0;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!(data = malloc(chunk->size ? chunk->size : 1))) return E_OUTOFMEMORY;
+    if (FAILED(hr = stream_chunk_get_data(stream, chunk, data, chunk->size))) goto done;
+
+    while (chunk->size - offset >= sizeof(header))
+    {
+        memcpy(&header, data + offset, sizeof(header));
+        offset += sizeof(header);
+
+#ifdef SG_MUTANT_SYSEX_LOAD
+        if (header.dwSysExLength > chunk->size - offset) break;
+#endif
+        if (header.dwSysExLength > chunk->size - offset)
+        {
+            WARN("Truncated sysex item, length %lu\n", header.dwSysExLength);
+            hr = DMUS_E_UNSUPPORTED_STREAM;
+            break;
+        }
+        if (!(item = malloc(offsetof(struct sysex_item, data[header.dwSysExLength]))))
+        {
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        item->time = header.mtTime;
+        item->pchannel = header.dwPChannel;
+        item->length = header.dwSysExLength;
+        memcpy(item->data, data + offset, item->length);
+        offset += item->length;
+        list_add_tail(&This->items, &item->entry);
+
+        TRACE("Loaded sysex item: time %ld, pchannel %lu, length %lu\n", item->time, item->pchannel,
+                item->length);
+    }
+
+done:
+    free(data);
+    return hr;
+}
