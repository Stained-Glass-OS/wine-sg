+            hr = parse_object_list(This, stream, &chunk);
+        else
+            WARN("Ignoring chunk %s %s\n", debugstr_fourcc(chunk.id), debugstr_fourcc(chunk.type));
+
+#ifdef SG_MUTANT_PARAM_LOAD
+        if (FAILED(hr)) return S_OK;
