+static HRESULT parse_param_list(struct param_object *object, IStream *stream, struct chunk_entry *list)
+{
+    struct chunk_entry chunk = {.parent = list};
+    struct param_info *param;
+    HRESULT hr;
+
+    if (!(param = calloc(1, sizeof(*param)))) return E_OUTOFMEMORY;
+    list_add_tail(&object->params, &param->entry);
+
+    while ((hr = stream_next_chunk(stream, &chunk)) == S_OK)
+    {
+        switch (chunk.id)
+        {
+        case DMUS_FOURCC_PARAMCONTROLTRACK_PARAM_CHUNK:
+            hr = stream_chunk_get_data(stream, &chunk, &param->header, sizeof(param->header));
+            break;
+
+        case DMUS_FOURCC_PARAMCONTROLTRACK_CURVES_CHUNK:
+            free(param->curves);
+            param->curves = NULL;
+            hr = stream_chunk_get_array(stream, &chunk, (void **)&param->curves, &param->curve_count,
+                    sizeof(*param->curves));
+            break;
+
+        default:
+            WARN("Ignoring chunk %s\n", debugstr_fourcc(chunk.id));
+            break;
+        }
+
+        if (FAILED(hr)) return hr;
+    }
+
+    return hr;
+}
+
+static HRESULT parse_object_list(IDirectMusicParamControlTrack *This, IStream *stream,
+        struct chunk_entry *list)
+{
+    struct chunk_entry chunk = {.parent = list};
+    struct param_object *object;
+    HRESULT hr;
+
+    if (!(object = calloc(1, sizeof(*object)))) return E_OUTOFMEMORY;
+    list_init(&object->params);
+    list_add_tail(&This->objects, &object->entry);
+
+    while ((hr = stream_next_chunk(stream, &chunk)) == S_OK)
+    {
+        switch (MAKE_IDTYPE(chunk.id, chunk.type))
+        {
+        case DMUS_FOURCC_PARAMCONTROLTRACK_OBJECT_CHUNK:
+            hr = stream_chunk_get_data(stream, &chunk, &object->header, sizeof(object->header));
+            TRACE("Loaded object %s, pchannel %lu, stage %lu\n", debugstr_dmguid(&object->header.guidObject),
+                    object->header.dwPChannel, object->header.dwStage);
+            break;
+
+        case MAKE_IDTYPE(FOURCC_LIST, DMUS_FOURCC_PARAMCONTROLTRACK_PARAM_LIST):
+            hr = parse_param_list(object, stream, &chunk);
+            break;
+
+        default:
+            WARN("Ignoring chunk %s %s\n", debugstr_fourcc(chunk.id), debugstr_fourcc(chunk.type));
+            break;
+        }
+
+        if (FAILED(hr)) return hr;
+    }
+
+    return hr;
+}
+
