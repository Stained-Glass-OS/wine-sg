+static HRESULT parse_tool_form(struct graph *This, IStream *stream, struct chunk_entry *form)
+{
+    struct chunk_entry chunk = {.parent = form};
+    DMUS_IO_TOOL_HEADER *header = NULL;
+    IDirectMusicTool *tool = NULL;
+    IPersistStream *persist;
+    HRESULT hr;
+
+    while ((hr = stream_next_chunk(stream, &chunk)) == S_OK)
+    {
+        if (chunk.id == DMUS_FOURCC_TOOL_CHUNK)
+        {
+            free(header);
+            if (chunk.size < offsetof(DMUS_IO_TOOL_HEADER, dwPChannels)) return DMUS_E_UNSUPPORTED_STREAM;
+            if (!(header = calloc(1, max(chunk.size, sizeof(*header))))) return E_OUTOFMEMORY;
+            if (FAILED(hr = stream_read(stream, header, chunk.size))) break;
+            if (header->cPChannels > (chunk.size - offsetof(DMUS_IO_TOOL_HEADER, dwPChannels)) / sizeof(DWORD))
+            {
+                hr = DMUS_E_UNSUPPORTED_STREAM;
+                break;
+            }
+            TRACE("Found tool %s, index %ld, %lu pchannels\n", debugstr_dmguid(&header->guidClassID),
+                    header->lIndex, header->cPChannels);
+        }
+        else if (header && !tool
+                && (header->ckid ? chunk.id == header->ckid
+                        : chunk.id == FOURCC_LIST && chunk.type == header->fccType))
+        {
+            /* the tool loads its own data, starting at the chunk header */
+            if (FAILED(hr = CoCreateInstance(&header->guidClassID, NULL, CLSCTX_INPROC_SERVER,
+                    &IID_IDirectMusicTool, (void **)&tool)))
+                break;
+            if (SUCCEEDED(hr = IDirectMusicTool_QueryInterface(tool, &IID_IPersistStream, (void **)&persist)))
+            {
+                if (SUCCEEDED(hr = stream_reset_chunk_start(stream, &chunk)))
+                    hr = IPersistStream_Load(persist, stream);
+                IPersistStream_Release(persist);
+            }
+            else hr = S_OK; /* tool without any data to load */
+            if (FAILED(hr)) break;
+        }
+    }
+
+#ifdef SG_MUTANT_GRAPH_INSERT
+    if (SUCCEEDED(hr) && header && tool && 0)
+#else
+    if (SUCCEEDED(hr) && header && tool)
+#endif
+    {
+        LONG index = header->lIndex;
+        hr = IDirectMusicGraph_InsertTool(&This->IDirectMusicGraph_iface, tool,
+                header->cPChannels ? header->dwPChannels : NULL, header->cPChannels, index);
+    }
+    else if (SUCCEEDED(hr)) hr = DMUS_E_UNSUPPORTED_STREAM;
+
+    if (tool) IDirectMusicTool_Release(tool);
+    free(header);
+    return hr;
+}
+
+static HRESULT parse_tool_list(struct graph *This, IStream *stream, struct chunk_entry *list)
+{
+    struct chunk_entry chunk = {.parent = list};
+    HRESULT hr;
+
+    while ((hr = stream_next_chunk(stream, &chunk)) == S_OK)
+    {
+        if (chunk.id == FOURCC_RIFF && chunk.type == DMUS_FOURCC_TOOL_FORM)
+            hr = parse_tool_form(This, stream, &chunk);
+        if (FAILED(hr)) return hr;
+    }
+
+    return SUCCEEDED(hr) ? S_OK : hr;
+}
+
 static HRESULT WINAPI graph_IPersistStream_Load(IPersistStream *iface, IStream *stream)
 {
     struct graph *This = impl_from_IPersistStream(iface);
+    struct chunk_entry riff = {0};
+    struct chunk_entry chunk = {.parent = &riff};
+    HRESULT hr;
+
+    TRACE("(%p, %p)\n", This, stream);
 
-    FIXME("(%p, %p): Loading not implemented yet\n", This, stream);
+    if (!stream) return E_POINTER;
+
+    if ((hr = stream_get_chunk(stream, &riff)) != S_OK) return hr;
+    if (riff.id != FOURCC_RIFF || riff.type != DMUS_FOURCC_TOOLGRAPH_FORM)
+    {
+        TRACE("loading failed: unexpected %s\n", debugstr_chunk(&riff));
+        stream_skip_chunk(stream, &riff);
+        return DMUS_E_CHUNKNOTFOUND;
+    }
+
+    /* descriptor chunks first, then the list of tools */
+    if (FAILED(hr = dmobj_parsedescriptor(stream, &riff, &This->dmobj.desc,
+            DMUS_OBJ_OBJECT|DMUS_OBJ_NAME|DMUS_OBJ_CATEGORY|DMUS_OBJ_VERSION)))
+        return hr;
+    This->dmobj.desc.guidClass = CLSID_DirectMusicGraph;
+    This->dmobj.desc.dwValidData |= DMUS_OBJ_CLASS;
+
+    if (FAILED(hr = stream_reset_chunk_data(stream, &riff))) return hr;
+    while ((hr = stream_next_chunk(stream, &chunk)) == S_OK)
+    {
+        if (chunk.id == FOURCC_LIST && chunk.type == DMUS_FOURCC_TOOL_LIST)
+            hr = parse_tool_list(This, stream, &chunk);
+        if (FAILED(hr)) return hr;
+    }
 
-    return IDirectMusicObject_ParseDescriptor(&This->dmobj.IDirectMusicObject_iface, stream,
-            &This->dmobj.desc);
+    return SUCCEEDED(hr) ? S_OK : hr;
 }
 
