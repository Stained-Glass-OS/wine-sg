-	return S_OK;
+    static const DWORD delivery_flags = DMUS_PMSGF_TOOL_IMMEDIATE | DMUS_PMSGF_TOOL_QUEUE | DMUS_PMSGF_TOOL_ATTIME;
+    IDirectMusicLyricsTrack *This = impl_from_IDirectMusicTrack8(iface);
+    struct lyrics_event *event;
+    IDirectMusicGraph *graph;
+    HRESULT hr = S_OK;
+
+    TRACE("(%p, %p, %ld, %ld, %ld, %#lx, %p, %p, %ld)\n", This, state_data, start_time, end_time,
+            time_offset, flags, performance, segment_state, track_id);
+
+    if (!performance) return E_POINTER;
+
+    if (FAILED(hr = IDirectMusicPerformance_QueryInterface(performance, &IID_IDirectMusicGraph,
+            (void **)&graph)))
