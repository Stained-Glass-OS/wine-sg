From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 02:54:08 -0700
Subject: [PATCH] webservices: WsCombineUrl, WsCopyError, WsTrimXmlWhitespace,
 WsVerifyXmlNCName, WsAbortListener, real WsAbortServiceProxy

WsCombineUrl resolves a reference against a base URL per RFC 3986 (dot
segment removal unless WS_URL_FLAGS_NO_PATH_COLLAPSE). WsCopyError
copies strings, fault, fault action, original error code and language.
WsVerifyXmlNCName and WsTrimXmlWhitespace follow the XML 1.0 name and
whitespace productions. WsAbortListener cancels a pending accept,
releases the port and leaves the listener faulted (reset allowed from
faulted). WsAbortServiceProxy aborts the channel and faults an active
proxy instead of returning E_NOTIMPL.

diff --git a/dlls/webservices/error.c b/dlls/webservices/error.c
index 9e57f45..b6f4ad7 100644
--- a/dlls/webservices/error.c
+++ b/dlls/webservices/error.c
@@ -707,3 +707,72 @@ done:
     TRACE( "returning %#lx\n", hr );
     return hr;
 }
+
+/**************************************************************************
+ *          WsCopyError		[webservices.@]
+ */
+HRESULT WINAPI WsCopyError( WS_ERROR *src_handle, WS_ERROR *dst_handle )
+{
+    struct error *src = (struct error *)src_handle, *dst = (struct error *)dst_handle;
+    struct error *first, *second;
+    ULONG i, code = 0;
+    LANGID langid = 0;
+    HRESULT hr = S_OK;
+
+    TRACE( "%p %p\n", src_handle, dst_handle );
+
+    if (!src || !dst) return E_INVALIDARG;
+    if (src == dst) return S_OK;
+
+    /* lock in address order so that two opposite copies cannot deadlock */
+    first = src < dst ? src : dst;
+    second = src < dst ? dst : src;
+    EnterCriticalSection( &first->cs );
+    EnterCriticalSection( &second->cs );
+
+    if (src->magic != ERROR_MAGIC || dst->magic != ERROR_MAGIC)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+
+    prop_get( src->prop, src->prop_count, WS_ERROR_PROPERTY_ORIGINAL_ERROR_CODE, &code, sizeof(code) );
+    prop_get( src->prop, src->prop_count, WS_ERROR_PROPERTY_LANGID, &langid, sizeof(langid) );
+
+    reset_error( dst );
+
+    if (src->strs_count)
+    {
+        if (!(dst->strs = ws_alloc_zero( dst->heap, src->strs_count * sizeof(WS_STRING) )))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+        dst->strs_size = src->strs_count;
+        for (i = 0; i < src->strs_count; i++)
+        {
+            if (!copy_string( dst->heap, &src->strs[i], &dst->strs[i] ))
+            {
+                hr = E_OUTOFMEMORY;
+                goto done;
+            }
+            dst->strs_count++;
+        }
+    }
+    if (src->fault && !(dst->fault = dup_fault( dst->heap, src->fault ))) hr = E_OUTOFMEMORY;
+#ifdef SG_MUTANT_WSABORT_COPY
+    dst->fault = NULL;
+#endif
+    if (hr == S_OK && src->fault_action.length) hr = set_action( dst, &src->fault_action );
+    if (hr == S_OK)
+    {
+        prop_set( dst->prop, dst->prop_count, WS_ERROR_PROPERTY_ORIGINAL_ERROR_CODE, &code, sizeof(code) );
+        prop_set( dst->prop, dst->prop_count, WS_ERROR_PROPERTY_LANGID, &langid, sizeof(langid) );
+    }
+
+done:
+    LeaveCriticalSection( &second->cs );
+    LeaveCriticalSection( &first->cs );
+    TRACE( "returning %#lx\n", hr );
+    return hr;
+}
diff --git a/dlls/webservices/listener.c b/dlls/webservices/listener.c
index b47ccc9..705198a 100644
--- a/dlls/webservices/listener.c
+++ b/dlls/webservices/listener.c
@@ -525,6 +525,40 @@ HRESULT WINAPI WsCloseListener( WS_LISTENER *handle, const WS_ASYNC_CONTEXT *ctx
     return hr;
 }
 
+/**************************************************************************
+ *          WsAbortListener		[webservices.@]
+ */
+HRESULT WINAPI WsAbortListener( WS_LISTENER *handle, WS_ERROR *error )
+{
+    struct listener *listener = (struct listener *)handle;
+    HRESULT hr = S_OK;
+
+    TRACE( "%p %p\n", handle, error );
+
+    if (!listener) return E_INVALIDARG;
+
+    EnterCriticalSection( &listener->cs );
+
+    if (listener->magic != LISTENER_MAGIC)
+    {
+        LeaveCriticalSection( &listener->cs );
+        return E_INVALIDARG;
+    }
+
+    /* cancels a pending WsAcceptChannel and releases the port */
+    if (listener->state == WS_LISTENER_STATE_OPEN)
+    {
+        reset_listener( listener );
+#ifndef SG_MUTANT_WSABORT_LISTENER
+        listener->state = WS_LISTENER_STATE_FAULTED;
+#endif
+    }
+
+    LeaveCriticalSection( &listener->cs );
+    TRACE( "returning %#lx\n", hr );
+    return hr;
+}
+
 /**************************************************************************
  *          WsResetListener		[webservices.@]
  */
@@ -546,7 +580,8 @@ HRESULT WINAPI WsResetListener( WS_LISTENER *handle, WS_ERROR *error )
         return E_INVALIDARG;
     }
 
-    if (listener->state != WS_LISTENER_STATE_CREATED && listener->state != WS_LISTENER_STATE_CLOSED)
+    if (listener->state != WS_LISTENER_STATE_CREATED && listener->state != WS_LISTENER_STATE_CLOSED &&
+        listener->state != WS_LISTENER_STATE_FAULTED)
         hr = WS_E_INVALID_OPERATION;
     else
         reset_listener( listener );
diff --git a/dlls/webservices/proxy.c b/dlls/webservices/proxy.c
index a6bd043..c99676c 100644
--- a/dlls/webservices/proxy.c
+++ b/dlls/webservices/proxy.c
@@ -369,8 +369,29 @@ HRESULT WINAPI WsCloseServiceProxy( WS_SERVICE_PROXY *handle, const WS_ASYNC_CON
  */
 HRESULT WINAPI WsAbortServiceProxy( WS_SERVICE_PROXY *handle, WS_ERROR *error )
 {
-    FIXME( "%p %p\n", handle, error );
-    return E_NOTIMPL;
+    struct proxy *proxy = (struct proxy *)handle;
+    HRESULT hr;
+
+    TRACE( "%p %p\n", handle, error );
+
+    if (!proxy) return E_INVALIDARG;
+
+    /* a pending call holds the lock, so the channel is aborted first to make it return */
+    if ((hr = WsAbortChannel( proxy->channel, NULL )) != S_OK) return hr;
+
+    EnterCriticalSection( &proxy->cs );
+    if (proxy->magic != PROXY_MAGIC)
+    {
+        LeaveCriticalSection( &proxy->cs );
+        return E_INVALIDARG;
+    }
+    if (proxy->state == WS_SERVICE_PROXY_STATE_OPEN || proxy->state == WS_SERVICE_PROXY_STATE_OPENING ||
+        proxy->state == WS_SERVICE_PROXY_STATE_CLOSING)
+        proxy->state = WS_SERVICE_PROXY_STATE_FAULTED;
+    LeaveCriticalSection( &proxy->cs );
+
+    TRACE( "returning %#lx\n", hr );
+    return hr;
 }
 
