diff --git a/dlls/webservices/string.c b/dlls/webservices/string.c
index 34e6710..d2994ea 100644
--- a/dlls/webservices/string.c
+++ b/dlls/webservices/string.c
@@ -830,3 +830,59 @@ HRESULT WINAPI WsXmlStringEquals( const WS_XML_STRING *str1, const WS_XML_STRING
     if (!memcmp( str1->bytes, str2->bytes, str1->length )) return S_OK;
     return S_FALSE;
 }
+
+static BOOL is_ncname_start( unsigned int ch )
+{
+    return (ch >= 'A' && ch <= 'Z') || ch == '_' || (ch >= 'a' && ch <= 'z') ||
+           (ch >= 0xc0 && ch <= 0xd6) || (ch >= 0xd8 && ch <= 0xf6) || (ch >= 0xf8 && ch <= 0x2ff) ||
+           (ch >= 0x370 && ch <= 0x37d) || (ch >= 0x37f && ch <= 0x1fff) || (ch >= 0x200c && ch <= 0x200d) ||
+           (ch >= 0x2070 && ch <= 0x218f) || (ch >= 0x2c00 && ch <= 0x2fef) || (ch >= 0x3001 && ch <= 0xd7ff) ||
+           (ch >= 0xf900 && ch <= 0xfdcf) || (ch >= 0xfdf0 && ch <= 0xfffd) || (ch >= 0x10000 && ch <= 0xeffff);
+}
+
+static BOOL is_ncname_char( unsigned int ch )
+{
+    return is_ncname_start( ch ) || ch == '-' || ch == '.' || (ch >= '0' && ch <= '9') || ch == 0xb7 ||
+           (ch >= 0x300 && ch <= 0x36f) || ch == 0x203f || ch == 0x2040;
+}
+
+/**************************************************************************
+ *          WsVerifyXmlNCName		[webservices.@]
+ */
+HRESULT WINAPI WsVerifyXmlNCName( const WCHAR *chars, ULONG len, WS_ERROR *error )
+{
+    ULONG i;
+
+    TRACE( "%s %p\n", debugstr_wn(chars, len), error );
+
+    if (!chars || !len) return E_INVALIDARG;
+
+    for (i = 0; i < len; i++)
+    {
+        unsigned int ch = chars[i];
+
+        if (ch >= 0xd800 && ch <= 0xdbff && i + 1 < len && chars[i + 1] >= 0xdc00 && chars[i + 1] <= 0xdfff)
+            ch = 0x10000 + ((ch - 0xd800) << 10) + (chars[++i] - 0xdc00);
+
+        if (!(i ? is_ncname_char( ch ) : is_ncname_start( ch ))) return WS_E_INVALID_FORMAT;
+    }
+    return S_OK;
+}
+
+/**************************************************************************
+ *          WsTrimXmlWhitespace		[webservices.@]
+ */
+HRESULT WINAPI WsTrimXmlWhitespace( WCHAR *chars, ULONG len, WCHAR **trimmed, ULONG *trimmed_len, WS_ERROR *error )
+{
+    TRACE( "%s %p %p %p\n", debugstr_wn(chars, len), trimmed, trimmed_len, error );
+
+    if (!chars || !trimmed || !trimmed_len) return E_INVALIDARG;
+
+    while (len && (*chars == ' ' || *chars == '\t' || *chars == '\r' || *chars == '\n')) { chars++; len--; }
+    while (len && (chars[len - 1] == ' ' || chars[len - 1] == '\t' || chars[len - 1] == '\r' ||
+                   chars[len - 1] == '\n')) len--;
+
+    *trimmed = chars;
+    *trimmed_len = len;
+    return S_OK;
+}
diff --git a/dlls/webservices/url.c b/dlls/webservices/url.c
index c4a638d..801ba53 100644
--- a/dlls/webservices/url.c
+++ b/dlls/webservices/url.c
@@ -607,3 +607,225 @@ done:
     TRACE( "returning %#lx\n", hr );
     return hr;
 }
+
+
+struct url_ref
+{
+    const WCHAR *scheme, *auth, *path, *query, *frag;
+    ULONG scheme_len, auth_len, path_len, query_len, frag_len;
+    BOOL has_scheme, has_auth, has_query, has_frag;
+};
+
+/* generic RFC 3986 splitting; no validation of the characters */
+static void split_url( const WCHAR *str, ULONG len, struct url_ref *ref )
+{
+    ULONG i = 0, start;
+
+    memset( ref, 0, sizeof(*ref) );
+    if (len && ((str[0] | 0x20) >= 'a' && (str[0] | 0x20) <= 'z'))
+    {
+        for (i = 1; i < len; i++)
+        {
+            WCHAR c = str[i];
+            if (!(((c | 0x20) >= 'a' && (c | 0x20) <= 'z') || (c >= '0' && c <= '9') || c == '+' || c == '-' ||
+                  c == '.')) break;
+        }
+        if (i < len && str[i] == ':')
+        {
+            ref->has_scheme = TRUE;
+            ref->scheme = str;
+            ref->scheme_len = i;
+            i++;
+        }
+        else i = 0;
+    }
+    if (i + 1 < len && str[i] == '/' && str[i + 1] == '/')
+    {
+        i += 2;
+        start = i;
+        while (i < len && str[i] != '/' && str[i] != '?' && str[i] != '#') i++;
+        ref->has_auth = TRUE;
+        ref->auth = str + start;
+        ref->auth_len = i - start;
+    }
+    start = i;
+    while (i < len && str[i] != '?' && str[i] != '#') i++;
+    ref->path = str + start;
+    ref->path_len = i - start;
+    if (i < len && str[i] == '?')
+    {
+        start = ++i;
+        while (i < len && str[i] != '#') i++;
+        ref->has_query = TRUE;
+        ref->query = str + start;
+        ref->query_len = i - start;
+    }
+    if (i < len && str[i] == '#')
+    {
+        ref->has_frag = TRUE;
+        ref->frag = str + i + 1;
+        ref->frag_len = len - i - 1;
+    }
+}
+
+/* RFC 3986 5.2.4, in place; the output never grows beyond the input */
+static ULONG remove_dot_segments( WCHAR *path, ULONG len )
+{
+    WCHAR *out = path;
+    ULONG i = 0;
+
+    while (i < len)
+    {
+        const WCHAR *in = path + i;
+        ULONG rem = len - i;
+
+        if (rem >= 3 && in[0] == '.' && in[1] == '.' && in[2] == '/') i += 3;
+        else if (rem >= 2 && in[0] == '.' && in[1] == '/') i += 2;
+        else if (rem >= 3 && in[0] == '/' && in[1] == '.' && in[2] == '/') i += 2;
+        else if (rem == 2 && in[0] == '/' && in[1] == '.') len = i + 1; /* "/." becomes "/" */
+        else if (rem >= 4 && in[0] == '/' && in[1] == '.' && in[2] == '.' && in[3] == '/')
+        {
+            i += 3;
+            while (out > path && *--out != '/') {}
+        }
+        else if (rem == 3 && in[0] == '/' && in[1] == '.' && in[2] == '.')
+        {
+            i += 2;
+            path[i] = '/';
+            while (out > path && *--out != '/') {}
+        }
+        else if ((rem == 1 && in[0] == '.') || (rem == 2 && in[0] == '.' && in[1] == '.')) i = len;
+        else
+        {
+            if (path[i] == '/') *out++ = path[i++];
+            while (i < len && path[i] != '/') *out++ = path[i++];
+        }
+    }
+    return out - path;
+}
+
+static ULONG collapse( WCHAR *path, ULONG len, ULONG flags )
+{
+    if (flags & WS_URL_FLAGS_NO_PATH_COLLAPSE) return len;
+#ifdef SG_MUTANT_WSABORT_DOTS
+    return len;
+#endif
+    return remove_dot_segments( path, len );
+}
+
+/**************************************************************************
+ *          WsCombineUrl		[webservices.@]
+ */
+HRESULT WINAPI WsCombineUrl( const WS_STRING *base, const WS_STRING *ref_str, ULONG flags, WS_HEAP *heap,
+                             WS_STRING *ret, WS_ERROR *error )
+{
+    struct url_ref b, r;
+    const WCHAR *scheme, *auth, *query;
+    ULONG scheme_len, auth_len, query_len, path_len, len, i;
+    BOOL has_auth, has_query;
+    WCHAR *path, *str, *p;
+
+    TRACE( "%s %s %#lx %p %p %p\n", base ? debugstr_wn(base->chars, base->length) : "null",
+           ref_str ? debugstr_wn(ref_str->chars, ref_str->length) : "null", flags, heap, ret, error );
+
+    if (!base || !ref_str || !heap || !ret) return E_INVALIDARG;
+    if (flags & ~(WS_URL_FLAGS_ALLOW_HOST_WILDCARDS | WS_URL_FLAGS_NO_PATH_COLLAPSE | WS_URL_FLAGS_ZERO_TERMINATE))
+        return E_INVALIDARG;
+    if (!base->length || !base->chars || !ref_str->chars) return E_INVALIDARG;
+
+    split_url( base->chars, base->length, &b );
+    if (!b.has_scheme) return WS_E_INVALID_FORMAT;
+    split_url( ref_str->chars, ref_str->length, &r );
+
+    if (!(path = ws_alloc( heap, (base->length + ref_str->length + 2) * sizeof(WCHAR) ))) return WS_E_QUOTA_EXCEEDED;
+
+    if (r.has_scheme)
+    {
+        scheme = r.scheme; scheme_len = r.scheme_len;
+        auth = r.auth; auth_len = r.auth_len; has_auth = r.has_auth;
+        memcpy( path, r.path, r.path_len * sizeof(WCHAR) );
+        path_len = collapse( path, r.path_len, flags );
+        query = r.query; query_len = r.query_len; has_query = r.has_query;
+    }
+    else
+    {
+        scheme = b.scheme; scheme_len = b.scheme_len;
+        if (r.has_auth)
+        {
+            auth = r.auth; auth_len = r.auth_len; has_auth = TRUE;
+            memcpy( path, r.path, r.path_len * sizeof(WCHAR) );
+            path_len = collapse( path, r.path_len, flags );
+            query = r.query; query_len = r.query_len; has_query = r.has_query;
+        }
+        else
+        {
+            auth = b.auth; auth_len = b.auth_len; has_auth = b.has_auth;
+            if (!r.path_len)
+            {
+                memcpy( path, b.path, b.path_len * sizeof(WCHAR) );
+                path_len = b.path_len;
+                if (r.has_query) { query = r.query; query_len = r.query_len; has_query = TRUE; }
+                else { query = b.query; query_len = b.query_len; has_query = b.has_query; }
+            }
+            else
+            {
+                if (r.path[0] == '/')
+                {
+                    memcpy( path, r.path, r.path_len * sizeof(WCHAR) );
+                    path_len = r.path_len;
+                }
+                else
+                {
+                    /* merge */
+                    if (b.has_auth && !b.path_len) { path[0] = '/'; path_len = 1; }
+                    else
+                    {
+                        for (path_len = b.path_len; path_len && b.path[path_len - 1] != '/'; path_len--) {}
+                        memcpy( path, b.path, path_len * sizeof(WCHAR) );
+                    }
+                    memcpy( path + path_len, r.path, r.path_len * sizeof(WCHAR) );
+                    path_len += r.path_len;
+                }
+                path_len = collapse( path, path_len, flags );
+                query = r.query; query_len = r.query_len; has_query = r.has_query;
+            }
+        }
+    }
+
+    len = scheme_len + 1 + (has_auth ? 2 + auth_len : 0) + path_len + (has_query ? 1 + query_len : 0) +
+          (r.has_frag ? 1 + r.frag_len : 0);
+    if (!(str = ws_alloc( heap, (len + 1) * sizeof(WCHAR) )))
+    {
+        ws_free( heap, path, (base->length + ref_str->length + 2) * sizeof(WCHAR) );
+        return WS_E_QUOTA_EXCEEDED;
+    }
+    p = str;
+    for (i = 0; i < scheme_len; i++) *p++ = scheme[i];
+    *p++ = ':';
+    if (has_auth)
+    {
+        *p++ = '/'; *p++ = '/';
+        memcpy( p, auth, auth_len * sizeof(WCHAR) );
+        p += auth_len;
+    }
+    memcpy( p, path, path_len * sizeof(WCHAR) );
+    p += path_len;
+    if (has_query)
+    {
+        *p++ = '?';
+        memcpy( p, query, query_len * sizeof(WCHAR) );
+        p += query_len;
+    }
+    if (r.has_frag)
+    {
+        *p++ = '#';
+        memcpy( p, r.frag, r.frag_len * sizeof(WCHAR) );
+        p += r.frag_len;
+    }
+    if (flags & WS_URL_FLAGS_ZERO_TERMINATE) *p = 0;
+    ws_free( heap, path, (base->length + ref_str->length + 2) * sizeof(WCHAR) );
+
+    ret->chars = str;
+    ret->length = p - str;
+    return S_OK;
+}
