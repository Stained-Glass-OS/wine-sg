From: Stained Glass OS <dev@stained-glass.example>
Subject: msvcrt: the C99 complex functions of msvcr120 and ucrtbase

Every function of MSVC's <complex.h> but creal and _Cbuild was a stub:
cabs, carg, cimag, conj, cproj, cexp, clog, clog10, cpow, csqrt, the
trigonometric and hyperbolic functions and their inverses, each in its
double, float and long double form, and _FCbuild, _LCbuild, _Cmulcc,
_Cmulcr and their float and long double forms. numpy calls crealf when it
is imported, so `import numpy` aborted the process ("unimplemented function
ucrtbase.dll.crealf") -- as did anything else built with MSVC that uses
complex numbers.

As MSVC lays them out: a _Dcomplex (and _Lcomplex: long double is double)
is 16 bytes, returned through a hidden pointer that the spec files list
first, as for _Cbuild; a _Fcomplex is 8 bytes and returned in registers,
as a 64-bit integer is.

Gate: test/devtools-gate.sh (complex, 64- and 32-bit).
---
--- a/dlls/msvcrt/math.c
+++ b/dlls/msvcrt/math.c
@@ -2970,4 +2970,154 @@
     return z._Val[0];
 }
 
+/* The C99 complex functions of msvcr120/ucrtbase (numpy, and anything else
+ * built with MSVC's <complex.h>). _Dcomplex and _Lcomplex (long double is
+ * double) are 16 bytes: returned through a hidden pointer, which the spec
+ * files list as the first argument, as for _Cbuild. _Fcomplex is 8 bytes and
+ * returned in registers (eax:edx, rax), as a 64-bit integer is. */
+typedef struct { double r, i; } cplx;
+
+static inline double c_copysign( double x, double y )
+{
+    union { double d; UINT64 u; } ux = { x }, uy = { y };
+    ux.u = (ux.u & ~((UINT64)1 << 63)) | (uy.u & ((UINT64)1 << 63));
+    return ux.d;
+}
+
+static inline cplx cplx_make( double r, double i ) { cplx c = { r, i }; return c; }
+static inline cplx cplx_d( _Dcomplex z ) { return cplx_make( z._Val[0], z._Val[1] ); }
+static inline cplx cplx_f( _Fcomplex z ) { return cplx_make( z._Val[0], z._Val[1] ); }
+static inline _Dcomplex *ret_d( _Dcomplex *ret, cplx c ) { ret->_Val[0] = c.r; ret->_Val[1] = c.i; return ret; }
+static inline unsigned __int64 ret_f( cplx c )
+{
+    union { _Fcomplex f; unsigned __int64 u; } u;
+    u.f._Val[0] = c.r;
+    u.f._Val[1] = c.i;
+    return u.u;
+}
+
+static cplx cplx_mul( cplx a, cplx b ) { return cplx_make( a.r * b.r - a.i * b.i, a.r * b.i + a.i * b.r ); }
+static cplx cplx_add( cplx a, cplx b ) { return cplx_make( a.r + b.r, a.i + b.i ); }
+static cplx cplx_sub( cplx a, cplx b ) { return cplx_make( a.r - b.r, a.i - b.i ); }
+static cplx cplx_neg( cplx a ) { return cplx_make( -a.r, -a.i ); }
+/* multiplying by i and by -i */
+static cplx cplx_muli( cplx a ) { return cplx_make( -a.i, a.r ); }
+static cplx cplx_mulmi( cplx a ) { return cplx_make( a.i, -a.r ); }
+
+static double c_abs( cplx z ) { return hypot( z.r, z.i ); }
+static double c_arg( cplx z ) { return atan2( z.i, z.r ); }
+static cplx c_proj( cplx z )
+{
+    if (isinf( z.r ) || isinf( z.i )) return cplx_make( INFINITY, c_copysign( 0.0, z.i ) );
+    return z;
+}
+static cplx c_exp( cplx z )
+{
+    double e = exp( z.r );
+    if (z.i == 0.0) return cplx_make( e, z.i );
+    return cplx_make( e * cos( z.i ), e * sin( z.i ) );
+}
+static cplx c_log( cplx z ) { return cplx_make( log( c_abs( z ) ), c_arg( z ) ); }
+static cplx c_log10( cplx z )
+{
+    cplx l = c_log( z );
+    return cplx_make( l.r / M_LN10, l.i / M_LN10 );
+}
+static cplx c_sqrt( cplx z )
+{
+    double t;
+    if (z.r == 0.0 && z.i == 0.0) return cplx_make( 0.0, z.i );
+    if (isinf( z.i )) return cplx_make( INFINITY, z.i );
+    t = sqrt( (fabs( z.r ) + c_abs( z )) / 2 );
+    if (z.r >= 0.0) return cplx_make( t, z.i / (2 * t) );
+    return cplx_make( fabs( z.i ) / (2 * t), c_copysign( t, z.i ) );
+}
+static cplx c_pow( cplx z, cplx w )
+{
+    if (z.r == 0.0 && z.i == 0.0)
+    {
+        if (w.r == 0.0 && w.i == 0.0) return cplx_make( 1.0, 0.0 );
+        return cplx_make( 0.0, 0.0 );
+    }
+    return c_exp( cplx_mul( w, c_log( z ) ) );
+}
+static cplx c_sinh( cplx z ) { return cplx_make( sinh( z.r ) * cos( z.i ), cosh( z.r ) * sin( z.i ) ); }
+static cplx c_cosh( cplx z ) { return cplx_make( cosh( z.r ) * cos( z.i ), sinh( z.r ) * sin( z.i ) ); }
+static cplx c_tanh( cplx z )
+{
+    double d;
+    if (fabs( z.r ) > 20.0)
+        return cplx_make( c_copysign( 1.0, z.r ), 4 * sin( z.i ) * cos( z.i ) * exp( -2 * fabs( z.r ) ) );
+    d = cosh( 2 * z.r ) + cos( 2 * z.i );
+    return cplx_make( sinh( 2 * z.r ) / d, sin( 2 * z.i ) / d );
+}
+static cplx c_sin( cplx z ) { return cplx_make( sin( z.r ) * cosh( z.i ), cos( z.r ) * sinh( z.i ) ); }
+static cplx c_cos( cplx z ) { return cplx_make( cos( z.r ) * cosh( z.i ), -sin( z.r ) * sinh( z.i ) ); }
+static cplx c_tan( cplx z ) { return cplx_mulmi( c_tanh( cplx_muli( z ) ) ); }
+static cplx c_asinh( cplx z )
+{
+    if (z.r < 0.0) return cplx_neg( c_asinh( cplx_neg( z ) ) );
+    return c_log( cplx_add( z, c_sqrt( cplx_add( cplx_mul( z, z ), cplx_make( 1.0, 0.0 ) ) ) ) );
+}
+static cplx c_asin( cplx z ) { return cplx_mulmi( c_asinh( cplx_muli( z ) ) ); }
+static cplx c_acos( cplx z )
+{
+    cplx a = c_asin( z );
+    return cplx_make( M_PI_2 - a.r, -a.i );
+}
+static cplx c_acosh( cplx z )
+{
+    cplx w = c_log( cplx_add( z, cplx_mul( c_sqrt( cplx_add( z, cplx_make( 1.0, 0.0 ) ) ),
+                                           c_sqrt( cplx_sub( z, cplx_make( 1.0, 0.0 ) ) ) ) ) );
+    return w;
+}
+static cplx c_atanh( cplx z )
+{
+    cplx a = c_log( cplx_add( cplx_make( 1.0, 0.0 ), z ) );
+    cplx b = c_log( cplx_sub( cplx_make( 1.0, 0.0 ), z ) );
+    return cplx_make( (a.r - b.r) / 2, (a.i - b.i) / 2 );
+}
+static cplx c_atan( cplx z ) { return cplx_mulmi( c_atanh( cplx_muli( z ) ) ); }
+
+unsigned __int64 CDECL _FCbuild( float r, float i ) { return ret_f( cplx_make( r, i ) ); }
+_Dcomplex * CDECL _Cmulcc( _Dcomplex *ret, _Dcomplex a, _Dcomplex b ) { return ret_d( ret, cplx_mul( cplx_d( a ), cplx_d( b ) ) ); }
+_Dcomplex * CDECL _Cmulcr( _Dcomplex *ret, _Dcomplex a, double b ) { return ret_d( ret, cplx_make( a._Val[0] * b, a._Val[1] * b ) ); }
+unsigned __int64 CDECL _FCmulcc( _Fcomplex a, _Fcomplex b ) { return ret_f( cplx_mul( cplx_f( a ), cplx_f( b ) ) ); }
+unsigned __int64 CDECL _FCmulcr( _Fcomplex a, float b ) { return ret_f( cplx_make( a._Val[0] * b, a._Val[1] * b ) ); }
+
+double CDECL MSVCR120_cimag( _Dcomplex z ) { return z._Val[1]; }
+float CDECL MSVCR120_crealf( _Fcomplex z ) { return z._Val[0]; }
+float CDECL MSVCR120_cimagf( _Fcomplex z ) { return z._Val[1]; }
+double CDECL MSVCR120_cabs( _Dcomplex z ) { return c_abs( cplx_d( z ) ); }
+float CDECL MSVCR120_cabsf( _Fcomplex z ) { return c_abs( cplx_f( z ) ); }
+double CDECL MSVCR120_carg( _Dcomplex z ) { return c_arg( cplx_d( z ) ); }
+float CDECL MSVCR120_cargf( _Fcomplex z ) { return c_arg( cplx_f( z ) ); }
+_Dcomplex * CDECL MSVCR120_cpow( _Dcomplex *ret, _Dcomplex z, _Dcomplex w ) { return ret_d( ret, c_pow( cplx_d( z ), cplx_d( w ) ) ); }
+unsigned __int64 CDECL MSVCR120_cpowf( _Fcomplex z, _Fcomplex w ) { return ret_f( c_pow( cplx_f( z ), cplx_f( w ) ) ); }
+
+#define CPLX_FUNC(name, impl) \
+    _Dcomplex * CDECL MSVCR120_##name( _Dcomplex *ret, _Dcomplex z ) { return ret_d( ret, impl( cplx_d( z ) ) ); } \
+    unsigned __int64 CDECL MSVCR120_##name##f( _Fcomplex z ) { return ret_f( impl( cplx_f( z ) ) ); }
+
+static cplx c_conj( cplx z ) { return cplx_make( z.r, -z.i ); }
+CPLX_FUNC(conj, c_conj)
+CPLX_FUNC(cproj, c_proj)
+CPLX_FUNC(cexp, c_exp)
+CPLX_FUNC(clog, c_log)
+CPLX_FUNC(clog10, c_log10)
+CPLX_FUNC(csqrt, c_sqrt)
+CPLX_FUNC(csin, c_sin)
+CPLX_FUNC(ccos, c_cos)
+CPLX_FUNC(ctan, c_tan)
+CPLX_FUNC(csinh, c_sinh)
+CPLX_FUNC(ccosh, c_cosh)
+CPLX_FUNC(ctanh, c_tanh)
+CPLX_FUNC(casin, c_asin)
+CPLX_FUNC(cacos, c_acos)
+CPLX_FUNC(catan, c_atan)
+CPLX_FUNC(casinh, c_asinh)
+CPLX_FUNC(cacosh, c_acosh)
+CPLX_FUNC(catanh, c_atanh)
+#undef CPLX_FUNC
+
 #endif /* _MSVCR_VER>=120 */
