From: Stained Glass OS <ke7oxh@gmail.com>
Subject: loader: programs start from the running server's Wine until it restarts

An apt upgrade with a server protocol bump (877 -> 880) on David's machine
broke the running session between wine-sg's unpack and the restart of the
machine's wineserver (sg-session's postinst, minutes later). Every program
started in that window loaded the new ntdll and died with "version mismatch
877/880": the lock screen among them (Win+L gave an empty purple screen for
about two minutes), and anything a running program started.

Windows keeps the old binaries until the restart. wine-sg's preinst now keeps
the tree the running server uses as hard links (/opt/wine-sg-running) and
names it in /run/wine-sg/redirect, before the new files land. The loader
follows that file and starts the kept tree's loader, with the same arguments
and argv[0] (ntdll is found next to it), so new programs keep working with
the running server. The postinst ends it when the new Wine can talk to the
server (same protocol number, shipped as share/wine/sg-server-protocol; for
an older tree, a test client); otherwise it lasts until the server restarts
(a drop-in on sg-wineserver clears it at start) or the next boot (/run).

Only a root-owned file that no one else can write is followed, and only to a
root-owned loader; the kept tree's own loader does not follow it again.
SG_WINE_REDIRECT=0 starts the installed Wine (the package's check).

Gate: test-runningtree. Mutant SG_MUTANT_NO_LOADER_REDIRECT.

diff --git a/loader/main.c b/loader/main.c
index ecb51ef..39b39b9 100644
--- a/loader/main.c
+++ b/loader/main.c
@@ -250,10 +250,61 @@ static void *load_ntdll( char *argv0 )
 /**********************************************************************
  *           main
  */
+/* Stained Glass OS: while a Wine update waits for the machine's wineserver to restart, every
+ * program starts from the Wine that server runs, as Windows keeps the old binaries until the
+ * restart. An update that changes the server protocol can no longer talk to the running server:
+ * the new files land when the package is unpacked, but the server restarts only later (or at
+ * the next boot), and every program started in between died with "version mismatch" -- the
+ * lock screen among them, so Win+L gave an empty screen. wine-sg's preinst keeps the running
+ * tree (hard links, /opt/wine-sg-running) and names it in /run/wine-sg/redirect; the file goes
+ * when the new Wine can talk to the server, or when the server restarts. Only a root-owned file
+ * that no one else can write is followed, and only to a root-owned loader. SG_WINE_REDIRECT=0
+ * starts the installed Wine regardless (the package's own check). */
+static void sg_redirect( char *argv[] )
+{
+    const char *redirect = getenv( "SG_WINE_REDIRECT_FILE" );  /* tests; still root's file only */
+    char dir[PATH_MAX], self[PATH_MAX], target[PATH_MAX + 16];
+    const char *env = getenv( "SG_WINE_REDIRECT" );
+    struct stat st;
+    ssize_t len;
+    int fd;
+
+#ifdef SG_MUTANT_NO_LOADER_REDIRECT
+    return;
+#endif
+    if (env && !strcmp( env, "0" )) return;
+    if (!redirect || !redirect[0]) redirect = "/run/wine-sg/redirect";
+    if ((fd = open( redirect, O_RDONLY | O_CLOEXEC | O_NOFOLLOW )) == -1) return;
+    if (fstat( fd, &st ) || !S_ISREG( st.st_mode ) || st.st_uid || (st.st_mode & 022))
+    {
+        close( fd );
+        return;
+    }
+    len = read( fd, dir, sizeof(dir) - 1 );
+    close( fd );
+    if (len <= 0) return;
+    dir[len] = 0;
+    while (len && (dir[len - 1] == '\n' || dir[len - 1] == '/')) dir[--len] = 0;
+    if (dir[0] != '/' || !len) return;
+
+    /* already the kept tree (its own loader, or its preloader) */
+    if ((len = readlink( "/proc/self/exe", self, sizeof(self) - 1 )) > 0)
+    {
+        self[len] = 0;
+        if (!strncmp( self, dir, strlen( dir ) ) && self[strlen( dir )] == '/') return;
+    }
+
+    snprintf( target, sizeof(target), "%s/bin/wine", dir );
+    if (stat( target, &st ) || !S_ISREG( st.st_mode ) || st.st_uid || (st.st_mode & 022)) return;
+    argv[0] = target;  /* ntdll is found next to argv[0] */
+    execv( target, argv );
+}
+
 int main( int argc, char *argv[] )
 {
     void *handle;
 
+    sg_redirect( argv );
     init_reserved_areas();
 
     if ((handle = load_ntdll( argv[0] )))
