+/* Stained Glass OS: what the installed licenses say about a product (SKU) or
+ * an application -- their <tm:infoStr>, <tm:infoInt> and <tm:infoBin>
+ * items (productName, ApplicationBitmap, licenseType, ...), as Windows reads
+ * them. "Name" and "Description" are the productName and productDescription
+ * items. Values are returned as the license gives them; nothing is made up. */
+static int base64_value(char c)
+{
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '+') return 62;
+    if (c == '/') return 63;
+    return -1;
+}
+
+/* the text of an info item named NAME (case-insensitive), unescaped, and its kind */
+static char *license_info_item(const char *text, const char *name, char *kind)
+{
+    size_t len = strlen(name);
+    const char *p = text;
+
+    while ((p = strstr(p, "name=\"")))
+    {
+        const char *start = p + 6, *tag, *end;
+        char *out, *o;
+
+        p = start;
+        if (_strnicmp(start, name, len) || start[len] != '"' || start[len + 1] != '>') continue;
+        for (tag = start; tag > text && *tag != '<'; tag--) ;
+        if (!strncmp(tag, "<tm:infoStr", 11) || !strncmp(tag, "<sl:infoStr", 11)) *kind = 's';
+        else if (!strncmp(tag, "<tm:infoInt", 11) || !strncmp(tag, "<sl:infoInt", 11)) *kind = 'i';
+        else if (!strncmp(tag, "<tm:infoBin", 11) || !strncmp(tag, "<sl:infoBin", 11)) *kind = 'b';
+        else continue;
+        start += len + 2;
+        if (!(end = strchr(start, '<'))) return NULL;
+        if (!(o = out = malloc(end - start + 1))) return NULL;
+        while (start < end)
+        {
+            if (!strncmp(start, "&amp;", 5)) { *o++ = '&'; start += 5; }
+            else if (!strncmp(start, "&lt;", 4)) { *o++ = '<'; start += 4; }
+            else if (!strncmp(start, "&gt;", 4)) { *o++ = '>'; start += 4; }
+            else if (!strncmp(start, "&quot;", 6)) { *o++ = '"'; start += 6; }
+            else if (!strncmp(start, "&apos;", 6)) { *o++ = '\''; start += 6; }
+            else *o++ = *start++;
+        }
+        *o = 0;
+        return out;
+    }
+    return NULL;
+}
+
+static HRESULT license_information(const char *id_name, const SLID *id, const WCHAR *name, SLDATATYPE *type,
+                                   UINT *size, BYTE **value)
+{
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH], path[MAX_PATH];
+    char aname[128], *item = NULL, kind = 0;
+    WIN32_FIND_DATAW fd;
+    HANDLE find, file;
+    HRESULT hr = SL_E_VALUE_NOT_FOUND;
+
+    if (!name || !size || !value) return E_INVALIDARG;
+    if (!wcsicmp(name, L"Name")) name = L"productName";
+    else if (!wcsicmp(name, L"Description")) name = L"productDescription";
+    if (!WideCharToMultiByte(CP_UTF8, 0, name, -1, aname, sizeof(aname), NULL, NULL)) return not_found(name, type, size, value);
+    if (!store_dir(L"licenses", dir)) return not_found(name, type, size, value);
+    swprintf(pattern, MAX_PATH, L"%s\\*", dir);
+    if ((find = FindFirstFileW(pattern, &fd)) == INVALID_HANDLE_VALUE) return not_found(name, type, size, value);
+    do
+    {
+        DWORD fsize, got;
+        char *text;
+        GUID g;
+
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        swprintf(path, MAX_PATH, L"%s\\%s", dir, fd.cFileName);
+        file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+        if (file == INVALID_HANDLE_VALUE) continue;
+        fsize = GetFileSize(file, NULL);
+        if (fsize == INVALID_FILE_SIZE || fsize > 16 * 1024 * 1024 || !(text = malloc(fsize + 1)))
+        {
+            CloseHandle(file);
+            continue;
+        }
+        if (!ReadFile(file, text, fsize, &got, NULL)) got = 0;
+        CloseHandle(file);
+        text[got] = 0;
+        if (license_guid(text, id_name, &g) && IsEqualGUID(&g, id)) item = license_info_item(text, aname, &kind);
+        free(text);
+    } while (!item && FindNextFileW(find, &fd));
+    FindClose(find);
+
+    if (!item) return not_found(name, type, size, value);
+    TRACE("%s: %s\n", debugstr_w(name), debugstr_a(item));
+    if (kind == 'i')
+    {
+        if (!(*value = LocalAlloc(LMEM_FIXED, sizeof(DWORD)))) hr = E_OUTOFMEMORY;
+        else
+        {
+            *(DWORD *)*value = strtoul(item, NULL, 0);
+            *size = sizeof(DWORD);
+            if (type) *type = SL_DATA_DWORD;
+            hr = S_OK;
+        }
+    }
+    else if (kind == 'b')
+    {
+        size_t n = 0, bits = 0, i;
+        DWORD acc = 0;
+        BYTE *out;
+
+        if (!(out = LocalAlloc(LMEM_FIXED, strlen(item) * 3 / 4 + 3))) hr = E_OUTOFMEMORY;
+        else
+        {
+            for (i = 0; item[i]; i++)
+            {
+                int v = base64_value(item[i]);
+                if (v < 0) continue;
+                acc = (acc << 6) | v;
+                bits += 6;
+                if (bits >= 8) { bits -= 8; out[n++] = (BYTE)(acc >> bits); }
+            }
+            *value = out;
+            *size = n;
+            if (type) *type = SL_DATA_BINARY;
+            hr = S_OK;
+        }
+    }
+    else
+    {
+        int len = MultiByteToWideChar(CP_UTF8, 0, item, -1, NULL, 0);
+        if (!(*value = LocalAlloc(LMEM_FIXED, len * sizeof(WCHAR)))) hr = E_OUTOFMEMORY;
+        else
+        {
+            MultiByteToWideChar(CP_UTF8, 0, item, -1, (WCHAR *)*value, len);
+            *size = len * sizeof(WCHAR);
+            if (type) *type = SL_DATA_SZ;
+            hr = S_OK;
+        }
+    }
+    free(item);
+    return hr;
+}
+
 HRESULT WINAPI SLGetProductSkuInformation(HSLC handle, const SLID *sku, const WCHAR *name, SLDATATYPE *type,
                                           UINT *size, BYTE **value)
 {
+    TRACE("(%p %s %s)\n", handle, debugstr_guid(sku), debugstr_w(name));
     if (!handle || !sku) return E_INVALIDARG;
-    return not_found(name, type, size, value);
+    return license_information("productSkuId", sku, name, type, size, value);
 }
 
 HRESULT WINAPI SLGetApplicationInformation(HSLC handle, const SLID *app, const WCHAR *name, SLDATATYPE *type,
                                            UINT *size, BYTE **value)
 {
+    TRACE("(%p %s %s)\n", handle, debugstr_guid(app), debugstr_w(name));
     if (!handle || !app) return E_INVALIDARG;
-    return not_found(name, type, size, value);
+    return license_information("applicationId", app, name, type, size, value);
 }
 
 HRESULT WINAPI SLGetServiceInformation(HSLC handle, const WCHAR *name, SLDATATYPE *type, UINT *size, BYTE **value)
@@ -413,12 +559,30 @@
     return not_found(name, type, size, value);
 }
 
-/* no right is granted by this store */
+/* whether any product key is installed in the store */
+static BOOL any_product_key(void)
+{
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH];
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+    BOOL found = FALSE;
+
+    if (!store_dir(L"keys", dir)) return FALSE;
+    swprintf(pattern, MAX_PATH, L"%s\\*", dir);
+    if ((find = FindFirstFileW(pattern, &fd)) == INVALID_HANDLE_VALUE) return FALSE;
+    do if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) found = TRUE;
+    while (!found && FindNextFileW(find, &fd));
+    FindClose(find);
+    return found;
+}
+
 HRESULT WINAPI SLConsumeRight(HSLC handle, const SLID *app, const SLID *sku, const WCHAR *right, void *reserved)
 {
     TRACE("(%p %s %s %s %p)\n", handle, debugstr_guid(app), debugstr_guid(sku), debugstr_w(right), reserved);
     if (!handle || !app) return E_INVALIDARG;
-    return SL_E_RIGHT_NOT_GRANTED;
+    /* no right is ever granted here; the reason, as Windows gives it: with
+     * no product key installed, that one (Office then offers to activate) */
+    return any_product_key() ? SL_E_RIGHT_NOT_GRANTED : SL_E_PKEY_NOT_INSTALLED;
 }
 
