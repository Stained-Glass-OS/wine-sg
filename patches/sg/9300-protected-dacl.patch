From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32, server: SetSecurityInfo keeps PROTECTED_DACL_SECURITY_INFORMATION; a file's protected DACL is kept

SetSecurityInfo / SetNamedSecurityInfoW with PROTECTED_DACL_SECURITY_INFORMATION merged the parent
folder's inheritable ACEs in all the same and never marked the descriptor SE_DACL_PROTECTED; a file's
DACL (its Unix mode, ADR 0013) could not say it either. The flag now decides whether the parent's ACEs
are merged (UNPROTECTED_ turns inheritance back on, neither keeps what the object had), the
descriptor carries SE_DACL_PROTECTED, and the file server keeps it in a user.sg.dacl_protected extended
attribute that file and directory descriptors report again. .NET's SetAccessRuleProtection(true, ...)
depends on it: Duplicati 2.4 refused to start ("the data folder inherits permissions from its
parent"); icacls /inheritance:r uses it too. Gate: test/protdacl-gate.sh.
---
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -4229,6 +4229,11 @@
     return STATUS_SUCCESS;
 }
 
+#ifndef PROTECTED_DACL_SECURITY_INFORMATION
+#define PROTECTED_DACL_SECURITY_INFORMATION   0x80000000
+#define UNPROTECTED_DACL_SECURITY_INFORMATION 0x20000000
+#endif
+
 /******************************************************************************
  * SetSecurityInfo [ADVAPI32.@]
  */
@@ -4252,6 +4257,17 @@
         SetSecurityDescriptorGroup(&sd, psidGroup, FALSE);
     if (SecurityInfo & DACL_SECURITY_INFORMATION)
     {
+        /* Stained Glass OS (9300): PROTECTED_DACL_SECURITY_INFORMATION makes the
+         * DACL the caller's alone -- nothing inherited from the parent -- and the
+         * descriptor says so (SE_DACL_PROTECTED); UNPROTECTED_ turns inheritance
+         * back on; with neither, the object keeps what it had. The flag was
+         * dropped: the parent's ACEs were merged in all the same, and the folder
+         * read back as inheriting (.NET SetAccessRuleProtection; Duplicati 2.4
+         * refused its data folder). */
+        BOOL protect = FALSE;
+#ifndef SG_MUTANT_PROTECTED_DACL_IGNORED
+        if (SecurityInfo & PROTECTED_DACL_SECURITY_INFORMATION) protect = TRUE;
+#endif
         if (ObjectType == SE_FILE_OBJECT && pDacl)
         {
             SECURITY_DESCRIPTOR_CONTROL control;
@@ -4278,10 +4294,11 @@
             free(psd);
             if (status)
                 return RtlNtStatusToDosError(status);
-            /* TODO: copy some control flags to new sd */
+            if (!(SecurityInfo & (PROTECTED_DACL_SECURITY_INFORMATION | UNPROTECTED_DACL_SECURITY_INFORMATION)))
+                protect = (control & SE_DACL_PROTECTED) != 0;
 
             /* inherit parent directory DACL */
-            if (!(control & SE_DACL_PROTECTED))
+            if (!protect)
             {
                 status = NtQueryObject(handle, ObjectNameInformation, NULL, 0, &size);
                 if (status != STATUS_INFO_LENGTH_MISMATCH)
@@ -4344,6 +4361,7 @@
         }
 
         SetSecurityDescriptorDacl(&sd, TRUE, dacl, FALSE);
+        if (protect) SetSecurityDescriptorControl(&sd, SE_DACL_PROTECTED, SE_DACL_PROTECTED);
     }
     if (SecurityInfo & SACL_SECURITY_INFORMATION)
         SetSecurityDescriptorSacl(&sd, TRUE, pSacl, FALSE);
--- a/server/file.c
+++ b/server/file.c
@@ -465,6 +465,43 @@
     return sd;
 }
 
+#ifndef PROTECTED_DACL_SECURITY_INFORMATION
+#define PROTECTED_DACL_SECURITY_INFORMATION   0x80000000
+#define UNPROTECTED_DACL_SECURITY_INFORMATION 0x20000000
+#endif
+
+/* Stained Glass OS (9300): a file's DACL is its Unix mode (ADR 0013), which
+ * has no room for "protected" -- the DACL inherits nothing from the parent
+ * (SetSecurityInfo with PROTECTED_DACL_SECURITY_INFORMATION, .NET's
+ * SetAccessRuleProtection). It is kept beside the mode, in an extended
+ * attribute, and the descriptor read back says SE_DACL_PROTECTED again.
+ * Best effort: a file system without user attributes keeps no flag. */
+#define SG_XATTR_DACL_PROTECTED "user.sg.dacl_protected"
+
+void sg_dacl_protection_set( int unix_fd, const struct security_descriptor *sd, unsigned int set_info )
+{
+    int protect;
+
+    if (!(set_info & DACL_SECURITY_INFORMATION)) return;
+    protect = (sd->control & SE_DACL_PROTECTED) != 0;
+    if (set_info & PROTECTED_DACL_SECURITY_INFORMATION) protect = 1;
+    if (set_info & UNPROTECTED_DACL_SECURITY_INFORMATION) protect = 0;
+#ifndef SG_MUTANT_DACL_PROTECTION_NOT_KEPT
+    if (protect) fsetxattr( unix_fd, SG_XATTR_DACL_PROTECTED, "1", 1, 0 );
+    else fremovexattr( unix_fd, SG_XATTR_DACL_PROTECTED );
+#endif
+}
+
+struct security_descriptor *sg_dacl_protection_get( int unix_fd, struct security_descriptor *sd )
+{
+    char flag;
+
+    if (!sd) return sd;
+    if (fgetxattr( unix_fd, SG_XATTR_DACL_PROTECTED, &flag, 1 ) == 1) sd->control |= SE_DACL_PROTECTED;
+    else sd->control &= ~SE_DACL_PROTECTED;
+    return sd;
+}
+
 static struct security_descriptor *file_get_sd( struct object *obj )
 {
     struct file *file = (struct file *)obj;
@@ -482,7 +519,7 @@
     /* mode and uid the same? if so, no need to re-generate security descriptor */
     if (obj->sd && (st.st_mode & (S_IRWXU|S_IRWXO)) == (file->mode & (S_IRWXU|S_IRWXO)) &&
         (st.st_uid == file->uid))
-        return obj->sd;
+        return sg_dacl_protection_get( unix_fd, obj->sd );
 
     sd = mode_to_sd( st.st_mode,
                      security_unix_uid_to_sid( st.st_uid ),
@@ -493,7 +530,7 @@
     file->uid = st.st_uid;
     free( obj->sd );
     obj->sd = sd;
-    return sd;
+    return sg_dacl_protection_get( unix_fd, sd );
 }
 
 static mode_t file_access_to_mode( unsigned int access )
@@ -892,6 +929,7 @@
             return 0;
         }
         if (fstat( unix_fd, &st ) != -1) sg_users_group( unix_fd, &st );
+        sg_dacl_protection_set( unix_fd, sd, set_info );
     }
     return 1;
 }
--- a/server/change.c
+++ b/server/change.c
@@ -346,7 +346,7 @@
     if (obj->sd &&
         (st.st_mode & (S_IRWXU|S_IRWXO)) == (dir->mode & (S_IRWXU|S_IRWXO)) &&
         (st.st_uid == dir->uid))
-        return obj->sd;
+        return sg_dacl_protection_get( unix_fd, obj->sd );
 
     sd = mode_to_sd( st.st_mode,
                      security_unix_uid_to_sid( st.st_uid ),
@@ -357,7 +357,7 @@
     dir->uid = st.st_uid;
     free( obj->sd );
     obj->sd = sd;
-    return sd;
+    return sg_dacl_protection_get( unix_fd, sd );
 }
 
 static int dir_set_sd( struct object *obj, const struct security_descriptor *sd,
@@ -405,6 +405,7 @@
             return 0;
         }
         if (fstat( unix_fd, &st ) != -1) sg_users_group( unix_fd, &st );
+        sg_dacl_protection_set( unix_fd, sd, set_info );
     }
     return 1;
 }
--- a/server/file.h
+++ b/server/file.h
@@ -173,6 +173,8 @@
 extern void file_set_error(void);
 extern struct security_descriptor *mode_to_sd( mode_t mode, const struct sid *user, const struct sid *group );
 extern mode_t sd_to_mode( const struct security_descriptor *sd, const struct sid *owner );
+extern void sg_dacl_protection_set( int unix_fd, const struct security_descriptor *sd, unsigned int set_info );
+extern struct security_descriptor *sg_dacl_protection_get( int unix_fd, struct security_descriptor *sd );
 struct stat;
 extern void sg_users_group( int unix_fd, const struct stat *st );
 extern int sg_dir_shares_write( int fd, const char *path );
