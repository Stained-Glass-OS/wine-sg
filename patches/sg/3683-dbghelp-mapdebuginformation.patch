From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dbghelp: MapDebugInformation and UnmapDebugInformation (3683)

dbghelp: MapDebugInformation and UnmapDebugInformation

The 32-bit-only legacy calls were stubs that failed with
ERROR_CALL_NOT_IMPLEMENTED. MapDebugInformation maps the image (given as a
handle, or opened by name and searched for along the symbol path) and
returns the IMAGE_DEBUG_INFORMATION: image base (or the one the caller
passes), size, checksum, machine, section headers, time stamp, the debug
directory, a description of the COFF symbol table, and the file path and
name. UnmapDebugInformation unmaps and frees it.
---
diff --git a/dlls/dbghelp/image.c b/dlls/dbghelp/image.c
index 4ba71eb..da3c217 100644
--- a/dlls/dbghelp/image.c
+++ b/dlls/dbghelp/image.c
@@ -38,15 +38,125 @@ DWORD WINAPI GetTimestampForLoadedLibrary(HMODULE Module)
 #ifndef _WIN64
 WINE_DEFAULT_DEBUG_CHANNEL(dbghelp);
 
-/***********************************************************************
- *		MapDebugInformation (DBGHELP.@)
- */
+/* the debug information of one image: the mapped file and everything the structure points to live
+ * in the block the caller gets (strings behind the structure) and the view */
 PIMAGE_DEBUG_INFORMATION WINAPI MapDebugInformation(HANDLE FileHandle, PCSTR FileName,
                                                     PCSTR SymbolPath, ULONG ImageBase)
 {
-    FIXME("(%p, %s, %s, 0x%08lx): stub\n", FileHandle, debugstr_a(FileName), debugstr_a(SymbolPath), ImageBase);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return NULL;
+    PIMAGE_DEBUG_INFORMATION info = NULL;
+    HANDLE file = FileHandle, mapping;
+    BOOL opened = FALSE;
+    IMAGE_NT_HEADERS32 *nt;
+    char found[MAX_PATH];
+    const char *name, *base_name;
+    DWORD file_size, dir_rva, dir_size;
+    BYTE *view;
+    SIZE_T len;
+
+    TRACE("(%p, %s, %s, 0x%08lx)\n", FileHandle, debugstr_a(FileName), debugstr_a(SymbolPath), ImageBase);
+
+    if (!file || file == INVALID_HANDLE_VALUE)
+    {
+        if (!FileName)
+        {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return NULL;
+        }
+        name = FileName;
+        if (GetFileAttributesA(name) == INVALID_FILE_ATTRIBUTES && SymbolPath
+            && SearchPathA(SymbolPath, FileName, NULL, MAX_PATH, found, NULL))
+            name = found;
+        file = CreateFileA(name, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+        if (file == INVALID_HANDLE_VALUE) return NULL;
+        opened = TRUE;
+    }
+    else name = FileName ? FileName : "";
+
+    file_size = GetFileSize(file, NULL);
+    mapping = CreateFileMappingW(file, NULL, PAGE_READONLY, 0, 0, NULL);
+#ifdef MAPDBG_MUT_CLOSE
+    CloseHandle(file);
+#else
+    if (opened) CloseHandle(file);
+#endif
+    if (!mapping) return NULL;
+    view = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, 0);
+    CloseHandle(mapping);
+    if (!view) return NULL;
+
+    nt = (IMAGE_NT_HEADERS32 *)RtlImageNtHeader((HMODULE)view);
+    if (!nt || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR32_MAGIC)
+    {
+        /* a 64-bit image does not fit the 32-bit structure */
+        UnmapViewOfFile(view);
+        SetLastError(ERROR_BAD_EXE_FORMAT);
+        return NULL;
+    }
+
+    base_name = strrchr(name, '\\');
+    if (!base_name) base_name = strrchr(name, '/');
+    base_name = base_name ? base_name + 1 : name;
+    len = strlen(name) + 1 + strlen(base_name) + 1;
+    if (!(info = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*info) + sizeof(IMAGE_COFF_SYMBOLS_HEADER) + len)))
+    {
+        UnmapViewOfFile(view);
+        SetLastError(ERROR_OUTOFMEMORY);
+        return NULL;
+    }
+    info->List.Flink = info->List.Blink = &info->List;
+    info->ReservedSize = file_size;
+    info->ReservedMappedBase = view;
+    info->ReservedMachine = nt->FileHeader.Machine;
+    info->ReservedCharacteristics = nt->FileHeader.Characteristics;
+    info->ReservedCheckSum = nt->OptionalHeader.CheckSum;
+#ifdef MAPDBG_MUT_BASE
+    info->ImageBase = nt->OptionalHeader.ImageBase;
+#else
+    info->ImageBase = ImageBase ? ImageBase : nt->OptionalHeader.ImageBase;
+#endif
+    info->SizeOfImage = nt->OptionalHeader.SizeOfImage;
+    info->ReservedNumberOfSections = nt->FileHeader.NumberOfSections;
+    info->ReservedSections = IMAGE_FIRST_SECTION(nt);
+    info->ReservedTimeDateStamp = nt->FileHeader.TimeDateStamp;
+    info->ReservedRomImage = nt->OptionalHeader.Magic == IMAGE_ROM_OPTIONAL_HDR_MAGIC;
+#ifdef MAPDBG_MUT_COFF
+    if (0
+#else
+    if (nt->FileHeader.PointerToSymbolTable && nt->FileHeader.NumberOfSymbols
+#endif
+        && nt->FileHeader.PointerToSymbolTable < file_size)
+    {
+        /* the COFF symbol table sits in the file; its header describes where (offsets from the mapped base) */
+        info->CoffSymbols = (IMAGE_COFF_SYMBOLS_HEADER *)(info + 1);
+        info->CoffSymbols->NumberOfSymbols = nt->FileHeader.NumberOfSymbols;
+        info->CoffSymbols->LvaToFirstSymbol = nt->FileHeader.PointerToSymbolTable;
+        info->CoffSymbols->RvaToFirstByteOfCode = nt->OptionalHeader.BaseOfCode;
+        info->CoffSymbols->RvaToLastByteOfCode = nt->OptionalHeader.BaseOfCode + nt->OptionalHeader.SizeOfCode;
+        info->CoffSymbols->RvaToFirstByteOfData = nt->OptionalHeader.BaseOfData;
+        info->CoffSymbols->RvaToLastByteOfData = nt->OptionalHeader.BaseOfData + nt->OptionalHeader.SizeOfInitializedData;
+        info->SizeOfCoffSymbols = nt->FileHeader.NumberOfSymbols * 18;
+    }
+    info->ImageFilePath = (char *)(info + 1) + sizeof(IMAGE_COFF_SYMBOLS_HEADER);
+    strcpy(info->ImageFilePath, name);
+    info->ImageFileName = info->ImageFilePath + strlen(name) + 1;
+#ifdef MAPDBG_MUT_NAME
+    strcpy(info->ImageFileName, name);
+#else
+    strcpy(info->ImageFileName, base_name);
+#endif
+
+    if (nt->OptionalHeader.NumberOfRvaAndSizes > IMAGE_DIRECTORY_ENTRY_DEBUG)
+    {
+        dir_rva = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_DEBUG].VirtualAddress;
+        dir_size = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_DEBUG].Size;
+        if (dir_rva && dir_size)
+        {
+            info->ReservedDebugDirectory = RtlImageRvaToVa((IMAGE_NT_HEADERS *)nt, (HMODULE)view, dir_rva, NULL);
+            if (info->ReservedDebugDirectory)
+                info->ReservedNumberOfDebugDirectories = dir_size / sizeof(IMAGE_DEBUG_DIRECTORY);
+        }
+    }
+    return info;
 }
 
 /***********************************************************************
@@ -54,8 +164,15 @@ PIMAGE_DEBUG_INFORMATION WINAPI MapDebugInformation(HANDLE FileHandle, PCSTR Fil
  */
 BOOL WINAPI UnmapDebugInformation(PIMAGE_DEBUG_INFORMATION DebugInfo)
 {
-    FIXME("(%p): stub\n", DebugInfo);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    TRACE("(%p)\n", DebugInfo);
+
+    if (!DebugInfo)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (DebugInfo->ReservedMappedBase) UnmapViewOfFile(DebugInfo->ReservedMappedBase);
+    HeapFree(GetProcessHeap(), 0, DebugInfo);
+    return TRUE;
 }
 #endif
