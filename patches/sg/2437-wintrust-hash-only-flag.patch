From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wintrust: WTD_HASH_ONLY_FLAG skips the signer certificate judgement

With the flag set, WinVerifyTrust checks only the file hash against the signature and does not judge the signer's certificate (trust, time, revocation); it was ignored. It showed up as a regression against stock Wine once the Authenticode final policy stopped letting a SHA-256 certificate through unchecked (the hash-only softpub cases then returned CERT_E_CHAINING instead of S_OK). The softpub todo marks that now pass are removed.
---
--- a/dlls/wintrust/softpub.c
+++ b/dlls/wintrust/softpub.c
@@ -1589,7 +1589,13 @@ HRESULT WINAPI SoftpubAuthenticode(CRYPT_PROVIDER_DATA *data)
         DWORD i;
 
         ret = TRUE;
-        for (i = 0; ret && i < data->csSigners; i++)
+        /* WTD_HASH_ONLY_FLAG: only the file hash is checked, the signer's
+         * certificate (trust, time, revocation) is not judged at all. */
+        for (i = 0; ret && i < data->csSigners
+#ifndef SG_MUTANT_HASHONLY_IGNORED
+         && !(data->pWintrustData->dwProvFlags & WTD_HASH_ONLY_FLAG)
+#endif
+         ; i++)
         {
             BYTE hash[64];
             DWORD size = sizeof(hash);
--- a/dlls/wintrust/tests/softpub.c
+++ b/dlls/wintrust/tests/softpub.c
@@ -1628,7 +1628,7 @@ static void test_wintrust_digest(void)
         /* 32-bit tests */
         {
             {{ SelfSignedFile32, sizeof(SelfSignedFile32) }},
-            { CERT_E_CHAINING, TRUE }, { S_OK, FALSE }
+            { CERT_E_CHAINING, FALSE }, { S_OK, FALSE }
         },
         {
             {{ SelfSignedFile32, sizeof(SelfSignedFile32) },
@@ -1658,7 +1658,7 @@ static void test_wintrust_digest(void)
         /* 64-bit tests */
         {
             {{ SelfSignedFile64, sizeof(SelfSignedFile64) }},
-            { CERT_E_CHAINING, TRUE }, { S_OK, FALSE }
+            { CERT_E_CHAINING, FALSE }, { S_OK, FALSE }
         },
         {
             {{ SelfSignedFile64, sizeof(SelfSignedFile64) },
@@ -1822,7 +1822,7 @@ static void test_multiple_signatures(void)
     settings.cSecondarySigs = 0xcccccccc;
     settings.dwVerifiedSigIndex = 0xcccccccc;
     status = WinVerifyTrust(NULL, &WVTPolicyGUID, &data);
-    todo_wine ok(status == CERT_E_UNTRUSTEDROOT || status == CERT_E_CHAINING, "Failed, ret %#lx\n", status);
+    ok(status == CERT_E_UNTRUSTEDROOT || status == CERT_E_CHAINING, "Failed, ret %#lx\n", status);
     ok(settings.cSecondarySigs == 0xcccccccc, "Got %lu.\n", settings.cSecondarySigs);
     todo_wine ok(settings.dwVerifiedSigIndex == 2, "Got %lu.\n", settings.dwVerifiedSigIndex);
 
@@ -1865,7 +1865,7 @@ static void test_multiple_signatures(void)
     settings.cSecondarySigs = 0xcccccccc;
     settings.dwVerifiedSigIndex = 0xcccccccc;
     status = WinVerifyTrust(NULL, &WVTPolicyGUID, &data);
-    todo_wine ok(status == CERT_E_UNTRUSTEDROOT || status == CERT_E_CHAINING, "Failed, ret %#lx\n", status);
+    ok(status == CERT_E_UNTRUSTEDROOT || status == CERT_E_CHAINING, "Failed, ret %#lx\n", status);
     ok(settings.cSecondarySigs == 2, "Got %lu.\n", settings.cSecondarySigs);
     todo_wine ok(settings.dwVerifiedSigIndex == 2, "Got %lu.\n", settings.dwVerifiedSigIndex);
 
@@ -1879,7 +1879,7 @@ static void test_multiple_signatures(void)
     settings.dwVerifiedSigIndex = 0xcccccccc;
     settings.dwIndex = 1;
     status = WinVerifyTrust(NULL, &WVTPolicyGUID, &data);
-    todo_wine ok(status == CERT_E_UNTRUSTEDROOT || status == CERT_E_CHAINING, "Failed, ret %#lx\n", status);
+    ok(status == CERT_E_UNTRUSTEDROOT || status == CERT_E_CHAINING, "Failed, ret %#lx\n", status);
     ok(settings.cSecondarySigs == 2, "Got %lu.\n", settings.cSecondarySigs);
     todo_wine ok(settings.dwVerifiedSigIndex == 1, "Got %lu.\n", settings.dwVerifiedSigIndex);
     settings.dwIndex = 0;
