From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sc, services, reg tests: sc create argument checks, tags, dependency cycles (3519)

sc, services, reg tests: sc create argument checks, tags, dependency cycles

sc create now reports a type, start or error word it does not know as an invalid command line (1639),
treats "type= interact" without own or share as the invalid parameter it is (87), passes tag= yes on so
the service manager refuses a tag for a program (87), and prints the "[SC] CreateService FAILED n:"
text. The service manager refuses a service that, through the services it depends on, would depend on
itself (ERROR_CIRCULAR_DEPENDENCY). Four reg test marks that now pass are removed.
---
--- a/programs/sc/sc.c
+++ b/programs/sc/sc.c
@@ -48,6 +48,16 @@
     return FALSE;
 }
 
+static void print_failure( const WCHAR *api, DWORD err )
+{
+    WCHAR *msg = NULL;
+
+    FormatMessageW( FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL,
+                    err, 0, (WCHAR *)&msg, 0, NULL );
+    wprintf( L"[SC] %ls FAILED %lu:\n\n%ls\n", api, err, msg ? msg : L"" );
+    LocalFree( msg );
+}
+
 struct create_params
 {
     const WCHAR *displayname;
@@ -60,11 +70,13 @@
     DWORD start;
     DWORD error;
     BOOL tag;
+    BOOL bad_value; /* a type, start or error word that is not one of the documented ones */
 };
 
 static BOOL parse_create_params( int argc, const WCHAR *argv[], struct create_params *cp )
 {
     unsigned int i;
+    BOOL type_given = FALSE;
 
     cp->displayname = NULL;
     cp->type        = SERVICE_WIN32_OWN_PROCESS;
@@ -73,6 +85,7 @@
     cp->binpath     = NULL;
     cp->group       = NULL;
     cp->tag         = FALSE;
+    cp->bad_value   = FALSE;
     cp->depend      = NULL;
     cp->obj         = NULL;
     cp->password    = NULL;
@@ -91,21 +104,25 @@
 
         if (PARSE( L"tag=", &tag ))
         {
-            if (!wcsicmp( tag, L"yes" ))
-            {
-                WINE_FIXME("tag argument not supported\n");
-                cp->tag = TRUE;
-            }
+            if (!wcsicmp( tag, L"yes" )) cp->tag = TRUE;
+            else if (wcsicmp( tag, L"no" )) cp->bad_value = TRUE;
             continue;
         }
         if (PARSE( L"type=", &type ))
         {
-            if (!wcsicmp( type, L"own" )) cp->type = SERVICE_WIN32_OWN_PROCESS;
-            else if (!wcsicmp( type, L"share" )) cp->type = SERVICE_WIN32_SHARE_PROCESS;
+            /* the first type= starts from nothing; interact is a flag on top of own or share */
+            if (!type_given)
+            {
+                type_given = TRUE;
+                cp->type = 0;
+            }
+            if (!wcsicmp( type, L"own" )) cp->type = (cp->type & SERVICE_INTERACTIVE_PROCESS) | SERVICE_WIN32_OWN_PROCESS;
+            else if (!wcsicmp( type, L"share" )) cp->type = (cp->type & SERVICE_INTERACTIVE_PROCESS) | SERVICE_WIN32_SHARE_PROCESS;
             else if (!wcsicmp( type, L"kernel" )) cp->type = SERVICE_KERNEL_DRIVER;
             else if (!wcsicmp( type, L"filesys" )) cp->type = SERVICE_FILE_SYSTEM_DRIVER;
             else if (!wcsicmp( type, L"rec" )) cp->type = SERVICE_RECOGNIZER_DRIVER;
             else if (!wcsicmp( type, L"interact" )) cp->type |= SERVICE_INTERACTIVE_PROCESS;
+            else cp->bad_value = TRUE;
             continue;
         }
         if (PARSE( L"start=", &start ))
@@ -115,6 +132,7 @@
             else if (!wcsicmp( start, L"auto" )) cp->start = SERVICE_AUTO_START;
             else if (!wcsicmp( start, L"demand" )) cp->start = SERVICE_DEMAND_START;
             else if (!wcsicmp( start, L"disabled" )) cp->start = SERVICE_DISABLED;
+            else cp->bad_value = TRUE;
             continue;
         }
         if (PARSE( L"error=", &error ))
@@ -123,6 +141,7 @@
             else if (!wcsicmp( error, L"severe" )) cp->error = SERVICE_ERROR_SEVERE;
             else if (!wcsicmp( error, L"critical" )) cp->error = SERVICE_ERROR_CRITICAL;
             else if (!wcsicmp( error, L"ignore" )) cp->error = SERVICE_ERROR_IGNORE;
+            else cp->bad_value = TRUE;
             continue;
         }
     }
@@ -385,20 +404,21 @@
     if (!wcsicmp( argv[1], L"create" ))
     {
         struct create_params cp;
+        DWORD tag_id = 0;
 
         if (argc < 4)
         {
             CloseServiceHandle( manager );
             usage();
         }
-        if (!parse_create_params( argc - 3, argv + 3, &cp ))
+        if (!parse_create_params( argc - 3, argv + 3, &cp ) || cp.bad_value)
         {
             WINE_ERR("failed to parse create parameters\n");
             CloseServiceHandle( manager );
-            return ret;
+            return ERROR_INVALID_COMMAND_LINE;
         }
         service = CreateServiceW( manager, argv[2], cp.displayname, SERVICE_ALL_ACCESS,
-                                  cp.type, cp.start, cp.error, cp.binpath, cp.group, NULL,
+                                  cp.type, cp.start, cp.error, cp.binpath, cp.group, cp.tag ? &tag_id : NULL,
                                   cp.depend, cp.obj, cp.password );
         if (service)
         {
@@ -408,7 +428,7 @@
         else
         {
             ret = GetLastError();
-            WINE_ERR("failed to create service %lu\n", ret);
+            print_failure( L"CreateService", ret );
         }
     }
     else if (!wcsicmp( argv[1], L"description" ))
--- a/programs/services/rpc.c
+++ b/programs/services/rpc.c
@@ -683,6 +683,23 @@
     return ERROR_SUCCESS;
 }
 
+/* whether following the service dependencies from "from" reaches "target" */
+static BOOL service_depends_on(struct scmdatabase *db, const WCHAR *services, const WCHAR *target, unsigned int depth)
+{
+    const WCHAR *name;
+
+    if (!services || depth > 64) return FALSE;
+    for (name = services; *name; name += lstrlenW(name) + 1)
+    {
+        struct service_entry *dep;
+
+        if (!wcsicmp(name, target)) return TRUE;
+        if ((dep = scmdatabase_find_service(db, name)) && service_depends_on(db, dep->dependOnServices, target, depth + 1))
+            return TRUE;
+    }
+    return FALSE;
+}
+
 static DWORD create_serviceW(
     SC_RPC_HANDLE hSCManager,
     LPCWSTR lpServiceName,
@@ -738,7 +755,13 @@
     entry->config.lpServiceStartName = wcsdup(lpServiceStartName);
     entry->config.lpDisplayName = wcsdup(lpDisplayName);
 
-    if (lpdwTagId)      /* TODO: In most situations a non-NULL TagId will generate an ERROR_INVALID_PARAMETER. */
+    /* a tag belongs to the drivers that start before the service manager */
+    if (lpdwTagId && !(dwServiceType & SERVICE_DRIVER))
+    {
+        free_service_entry(entry);
+        return ERROR_INVALID_PARAMETER;
+    }
+    if (lpdwTagId)
         entry->config.dwTagId = *lpdwTagId;
     else
         entry->config.dwTagId = 0;
@@ -762,6 +785,13 @@
         return err;
     }
 
+    if (service_depends_on(manager->db, entry->dependOnServices, lpServiceName, 0))
+    {
+        scmdatabase_unlock(manager->db);
+        free_service_entry(entry);
+        return ERROR_CIRCULAR_DEPENDENCY;
+    }
+
     /* the display name may match neither another display name nor a service name */
     if (scmdatabase_find_service_by_displayname(manager->db, get_display_name(entry))
