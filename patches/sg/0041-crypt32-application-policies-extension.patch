From: Stained Glass OS <dev@stained-glass.example>
Subject: crypt32: support the application policies extension

Microsoft's Marketplace CAs carry a critical application policies extension
(1.3.6.1.4.1.311.21.10). Wine did not know it, so every chain through them --
winget's source package among them -- failed with CERT_E_CRITICAL once the
chain was actually checked (patches 0039, 0040).

Accept it, and enforce it the way Windows does: like an extended key usage,
on any certificate in the chain, when a usage is requested.

--- a/dlls/crypt32/chain.c
+++ b/dlls/crypt32/chain.c
@@ -1822,6 +1822,8 @@
                 ret = TRUE;
             else if (!strcmp(oid, szOID_ENHANCED_KEY_USAGE))
                 ret = TRUE;
+            else if (!strcmp(oid, szOID_APPLICATION_CERT_POLICIES))
+                ret = TRUE;    /* enforced with the usages, CRYPT_CheckUsages */
             else
             {
                 FIXME("unsupported critical extension %s\n",
@@ -2838,6 +2840,53 @@
             chain->rgpChain[0]->rgpElement[0]->TrustStatus.dwErrorStatus |=
              CERT_TRUST_IS_NOT_VALID_FOR_USAGE;
         }
+        /* Microsoft's application policies extension restricts, like an
+         * extended key usage, what a certificate -- CA or end -- and so the
+         * chain below it may be used for. Its policy identifiers are usage
+         * OIDs. */
+        else
+        {
+            PCERT_SIMPLE_CHAIN simple = chain->rgpChain[0];
+            DWORD e;
+
+            for (e = 0; e < simple->cElement; e++)
+            {
+                PCCERT_CONTEXT cert = simple->rgpElement[e]->pCertContext;
+                CERT_POLICIES_INFO *policies;
+                DWORD size, i, j;
+                BOOL all = TRUE, any = FALSE;
+
+                if (!(ext = CertFindExtension(szOID_APPLICATION_CERT_POLICIES,
+                 cert->pCertInfo->cExtension, cert->pCertInfo->rgExtension)))
+                    continue;
+                if (!CryptDecodeObjectEx(X509_ASN_ENCODING, X509_CERT_POLICIES,
+                 ext->Value.pbData, ext->Value.cbData, CRYPT_DECODE_ALLOC_FLAG,
+                 NULL, &policies, &size))
+                {
+                    all = any = FALSE;
+                }
+                else
+                {
+                    for (i = 0; i < pChainPara->RequestedUsage.Usage.cUsageIdentifier; i++)
+                    {
+                        BOOL match = FALSE;
+                        for (j = 0; !match && j < policies->cPolicyInfo; j++)
+                            match = !strcmp(policies->rgPolicyInfo[j].pszPolicyIdentifier,
+                             pChainPara->RequestedUsage.Usage.rgpszUsageIdentifier[i]);
+                        if (match) any = TRUE;
+                        else all = FALSE;
+                    }
+                    LocalFree(policies);
+                }
+                if (pChainPara->RequestedUsage.dwType == USAGE_MATCH_TYPE_AND ? !all : !any)
+                {
+                    TRACE_(chain)("element %lu's application policies exclude the requested usage\n", e);
+                    chain->TrustStatus.dwErrorStatus |= CERT_TRUST_IS_NOT_VALID_FOR_USAGE;
+                    simple->rgpElement[e]->TrustStatus.dwErrorStatus |= CERT_TRUST_IS_NOT_VALID_FOR_USAGE;
+                    break;
+                }
+            }
+        }
     }
     if (pChainPara->cbSize >= sizeof(CERT_CHAIN_PARA) &&
      pChainPara->RequestedIssuancePolicy.Usage.cUsageIdentifier)
