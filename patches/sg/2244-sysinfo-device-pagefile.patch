From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, wow64: SystemDeviceInformation, SystemPageFileInformation

NtQuerySystemInformation answered STATUS_INVALID_INFO_CLASS for two classes
tools and runtimes read: SystemDeviceInformation (how many disks, floppies,
CD-ROMs, tapes, serial and parallel ports: counted from /sys/block) and
SystemPageFileInformation (the swap space as the one page file, in pages,
named \??\C:\pagefile.sys as psapi's EnumPageFiles already lists it; none
listed, success with no data, when the host has no swap). wow64 passes the
first through and converts the UNICODE_STRING of the second.

---
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -3142,6 +3142,76 @@ static void sg_get_boot_guid( GUID *guid )
     memcpy( guid->Data4, b + 8, 8 );
 }
 
+/* Stained Glass OS: SystemDeviceInformation and SystemPageFileInformation */
+typedef struct
+{
+    ULONG NumberOfDisks;
+    ULONG NumberOfFloppies;
+    ULONG NumberOfCdRoms;
+    ULONG NumberOfTapes;
+    ULONG NumberOfSerialPorts;
+    ULONG NumberOfParallelPorts;
+} SYSTEM_DEVICE_INFORMATION;
+
+typedef struct
+{
+    ULONG NextEntryOffset;
+    ULONG TotalSize;     /* in pages */
+    ULONG TotalInUse;
+    ULONG PeakUsage;
+    UNICODE_STRING PageFileName;
+} SYSTEM_PAGEFILE_INFORMATION;
+
+static void get_device_counts( SYSTEM_DEVICE_INFORMATION *info )
+{
+#ifdef __linux__
+    struct dirent *entry;
+    DIR *dir;
+
+    if (!(dir = opendir( "/sys/block" ))) goto fallback;
+    while ((entry = readdir( dir )))
+    {
+        const char *n = entry->d_name;
+
+        if (n[0] == '.') continue;
+        if (!strncmp( n, "sr", 2 ) || !strncmp( n, "scd", 3 )) info->NumberOfCdRoms++;
+        else if (!strncmp( n, "fd", 2 )) info->NumberOfFloppies++;
+        else if (!strncmp( n, "st", 2 ) || !strncmp( n, "nst", 3 )) info->NumberOfTapes++;
+        else if (strncmp( n, "loop", 4 ) && strncmp( n, "ram", 3 ) && strncmp( n, "zram", 4 ) &&
+                 strncmp( n, "dm-", 3 ) && strncmp( n, "md", 2 ) && strncmp( n, "nbd", 3 ))
+            info->NumberOfDisks++;
+    }
+    closedir( dir );
+    return;
+fallback:
+#endif
+    info->NumberOfDisks = 1;
+}
+
+/* the swap space, in pages: the one page file */
+static BOOL get_swap_pages( ULONGLONG *total, ULONGLONG *used )
+{
+#ifdef __linux__
+    unsigned long long swap_total = 0, swap_free = 0, value;
+    char line[128];
+    FILE *fp;
+
+    if (!(fp = fopen( "/proc/meminfo", "r" ))) return FALSE;
+    while (fgets( line, sizeof(line), fp ))
+    {
+        if (sscanf( line, "SwapTotal: %llu", &value ) == 1) swap_total = value * 1024;
+        else if (sscanf( line, "SwapFree: %llu", &value ) == 1) swap_free = value * 1024;
+    }
+    fclose( fp );
+    if (!swap_total) return FALSE;
+    *total = swap_total / page_size;
+    *used = (swap_total - min( swap_free, swap_total )) / page_size;
+    return TRUE;
+#else
+    return FALSE;
+#endif
+}
+
 /******************************************************************************
  *              NtQuerySystemInformation  (NTDLL.@)
  */
@@ -3457,6 +3527,60 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
         break;
     }
 
+    case SystemDeviceInformation:  /* 7 */
+    {
+        SYSTEM_DEVICE_INFORMATION sdi = { 0 };
+
+#ifdef SG_MUTANT_NO_DEVICE_INFO
+        return STATUS_INVALID_INFO_CLASS;
+#endif
+
+        len = sizeof(sdi);
+        if (size != len) ret = STATUS_INFO_LENGTH_MISMATCH;
+        else if (!info) ret = STATUS_ACCESS_VIOLATION;
+        else
+        {
+            get_device_counts( &sdi );
+            memcpy( info, &sdi, len );
+        }
+        break;
+    }
+
+    case SystemPageFileInformation:  /* 18 */
+    {
+#ifdef SG_MUTANT_NO_PAGEFILE_INFO
+        return STATUS_INVALID_INFO_CLASS;
+#endif
+        static const char name[] = "\\??\\C:\\pagefile.sys";
+        WCHAR nameW[ARRAY_SIZE(name)];
+        SYSTEM_PAGEFILE_INFORMATION spi = { 0 };
+        ULONGLONG total, used;
+        unsigned int i;
+
+        if (!get_swap_pages( &total, &used )) break;  /* no page file: nothing to list */
+        len = sizeof(spi) + sizeof(nameW);
+        if (size < len)
+        {
+            ret = STATUS_INFO_LENGTH_MISMATCH;
+            break;
+        }
+        if (!info)
+        {
+            ret = STATUS_ACCESS_VIOLATION;
+            break;
+        }
+        for (i = 0; i < ARRAY_SIZE(name); i++) nameW[i] = (unsigned char)name[i];
+        spi.TotalSize = total;
+        spi.TotalInUse = used;
+        spi.PeakUsage = used;
+        spi.PageFileName.Length = sizeof(nameW) - sizeof(WCHAR);
+        spi.PageFileName.MaximumLength = sizeof(nameW);
+        spi.PageFileName.Buffer = (WCHAR *)((char *)info + sizeof(spi));
+        memcpy( info, &spi, sizeof(spi) );
+        memcpy( (char *)info + sizeof(spi), nameW, sizeof(nameW) );
+        break;
+    }
+
     case SystemFileCacheInformation:  /* 21 */
     {
         SYSTEM_CACHE_INFORMATION sci = { 0 };
--- a/dlls/wow64/system.c
+++ b/dlls/wow64/system.c
@@ -363,6 +363,7 @@ NTSTATUS WINAPI wow64_NtQuerySystemInformation( UINT *args )
     case SystemBootEnvironmentInformation:  /* SYSTEM_BOOT_ENVIRONMENT_INFORMATION */
     case SystemSecureBootInformation:  /* SYSTEM_SECUREBOOT_INFORMATION */
     case SystemWineVersionInformation:  /* char[] */
+    case SystemDeviceInformation:  /* SYSTEM_DEVICE_INFORMATION */
         return NtQuerySystemInformation( class, ptr, len, retlen );
 
     case SystemRangeStartInformation:  /* ULONG_PTR */
@@ -498,6 +499,31 @@ NTSTATUS WINAPI wow64_NtQuerySystemInformation( UINT *args )
         }
         else return STATUS_INFO_LENGTH_MISMATCH;
 
+    case SystemPageFileInformation:  /* SYSTEM_PAGEFILE_INFORMATION: a UNICODE_STRING and its text */
+    {
+        struct { ULONG next, total, used, peak; UNICODE_STRING32 name; } *info32 = ptr;
+        ULONG size = len + sizeof(UNICODE_STRING) - sizeof(UNICODE_STRING32), retsize = 0;
+        struct { ULONG next, total, used, peak; UNICODE_STRING name; } *info;
+
+        info = Wow64AllocateTemp( size );
+        status = NtQuerySystemInformation( class, info, size, &retsize );
+        if (retsize) retsize = retsize - sizeof(*info) + sizeof(*info32);
+        if (!status && retsize)
+        {
+            info32->next = 0;
+            info32->total = info->total;
+            info32->used = info->used;
+            info32->peak = info->peak;
+            info32->name.Length = info->name.Length;
+            info32->name.MaximumLength = info->name.MaximumLength;
+            info32->name.Buffer = PtrToUlong( info32 + 1 );
+            memcpy( info32 + 1, info->name.Buffer, info->name.MaximumLength );
+        }
+        if (retlen) *retlen = retsize;
+        if (status == STATUS_INFO_LENGTH_MISMATCH && !retsize) retsize = 0;
+        return status;
+    }
+
     case SystemFileCacheInformation:   /* SYSTEM_CACHE_INFORMATION */
         if (len >= sizeof(SYSTEM_CACHE_INFORMATION32))
         {
