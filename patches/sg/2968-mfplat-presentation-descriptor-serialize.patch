From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfplat: MFSerializePresentationDescriptor / MFDeserializePresentationDescriptor

Two spec stubs implemented. The serialized layout is private (attribute streams of the descriptor, each stream
descriptor and each media type, plus the selected flags, stream identifiers and current type index) and
round-trips streams, selection, media types, current types and attributes. Output is CoTaskMemAlloc'ed.
Gate: test/mfplat-pdser-gate.sh
---
diff --git a/dlls/mfplat/main.c b/dlls/mfplat/main.c
index 8852db1..2a0d8d1 100644
--- a/dlls/mfplat/main.c
+++ b/dlls/mfplat/main.c
@@ -3935,6 +3935,301 @@ HRESULT WINAPI MFDeserializeAttributesFromStream(IMFAttributes *attributes, DWOR
     return hr;
 }
 
+/* Presentation descriptor serialization (MFSerializePresentationDescriptor). The byte layout is private to this
+ * implementation (the real one is not documented), little endian:
+ *
+ *   UINT32 magic ('MFPD'), the descriptor attributes (attribute stream), UINT32 stream count, then per stream
+ *   UINT32 selected, UINT32 identifier, the stream descriptor attributes, UINT32 media type count, per type
+ *   UINT32 present flag followed (if set) by the media type attributes, and finally UINT32 current media type
+ *   index (or 0xffffffff if none is set).
+ */
+#define PRESENTATION_STREAM_MAGIC 0x4450464d
+
+static HRESULT pd_stream_write(IStream *stream, const void *data, ULONG size)
+{
+    ULONG written;
+    HRESULT hr = IStream_Write(stream, data, size, &written);
+    return SUCCEEDED(hr) && written != size ? E_FAIL : hr;
+}
+
+static HRESULT pd_stream_write_u32(IStream *stream, UINT32 value)
+{
+    return pd_stream_write(stream, &value, sizeof(value));
+}
+
+static HRESULT pd_stream_read_u32(IStream *stream, UINT32 *value)
+{
+    return attr_stream_read(stream, value, sizeof(*value));
+}
+
+/***********************************************************************
+ *      MFSerializePresentationDescriptor (mfplat.@)
+ */
+HRESULT WINAPI MFSerializePresentationDescriptor(IMFPresentationDescriptor *pd, DWORD *size, BYTE **data)
+{
+    IStream *stream;
+    HGLOBAL hglobal;
+    STATSTG stat;
+    DWORD count, i, j;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p.\n", pd, size, data);
+
+    if (!pd || !size || !data)
+        return E_INVALIDARG;
+
+    *size = 0;
+    *data = NULL;
+
+    if (FAILED(hr = IMFPresentationDescriptor_GetStreamDescriptorCount(pd, &count)))
+        return hr;
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream)))
+        return hr;
+
+    hr = pd_stream_write_u32(stream, PRESENTATION_STREAM_MAGIC);
+    if (SUCCEEDED(hr))
+        hr = MFSerializeAttributesToStream((IMFAttributes *)pd, 0, stream);
+    if (SUCCEEDED(hr))
+        hr = pd_stream_write_u32(stream, count);
+
+    for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+    {
+        IMFMediaTypeHandler *handler = NULL;
+        IMFStreamDescriptor *sd = NULL;
+        IMFMediaType *type, *current = NULL;
+        DWORD type_count = 0, id = 0;
+        UINT32 current_index = ~0u;
+        BOOL selected;
+
+        if (FAILED(hr = IMFPresentationDescriptor_GetStreamDescriptorByIndex(pd, i, &selected, &sd)))
+            break;
+
+        if (SUCCEEDED(hr = IMFStreamDescriptor_GetStreamIdentifier(sd, &id))
+                && SUCCEEDED(hr = IMFStreamDescriptor_GetMediaTypeHandler(sd, &handler))
+                && SUCCEEDED(hr = IMFMediaTypeHandler_GetMediaTypeCount(handler, &type_count)))
+        {
+            if (FAILED(IMFMediaTypeHandler_GetCurrentMediaType(handler, &current)))
+                current = NULL;
+
+            if (FAILED(hr = pd_stream_write_u32(stream, selected)) || FAILED(hr = pd_stream_write_u32(stream, id))
+                    || FAILED(hr = MFSerializeAttributesToStream((IMFAttributes *)sd, 0, stream))
+                    || FAILED(hr = pd_stream_write_u32(stream, type_count)))
+                goto stream_done;
+
+            for (j = 0; SUCCEEDED(hr) && j < type_count; ++j)
+            {
+                type = NULL;
+                if (FAILED(hr = IMFMediaTypeHandler_GetMediaTypeByIndex(handler, j, &type)))
+                    break;
+                if (SUCCEEDED(hr = pd_stream_write_u32(stream, 1)))
+                    hr = MFSerializeAttributesToStream((IMFAttributes *)type, 0, stream);
+                if (SUCCEEDED(hr) && current && current_index == ~0u)
+                {
+                    BOOL equal = FALSE;
+                    if (SUCCEEDED(IMFAttributes_Compare((IMFAttributes *)type, (IMFAttributes *)current,
+                            MF_ATTRIBUTES_MATCH_ALL_ITEMS, &equal)) && equal)
+                        current_index = j;
+                }
+                IMFMediaType_Release(type);
+            }
+            if (SUCCEEDED(hr))
+                hr = pd_stream_write_u32(stream, current_index);
+        }
+stream_done:
+        if (current)
+            IMFMediaType_Release(current);
+        if (handler)
+            IMFMediaTypeHandler_Release(handler);
+        IMFStreamDescriptor_Release(sd);
+    }
+
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IStream_Stat(stream, &stat, STATFLAG_NONAME)))
+    {
+        if (!(*data = CoTaskMemAlloc(stat.cbSize.LowPart)))
+            hr = E_OUTOFMEMORY;
+        else if (SUCCEEDED(hr = GetHGlobalFromStream(stream, &hglobal)))
+        {
+            void *ptr = GlobalLock(hglobal);
+            memcpy(*data, ptr, stat.cbSize.LowPart);
+            GlobalUnlock(hglobal);
+            *size = stat.cbSize.LowPart;
+        }
+        if (FAILED(hr))
+        {
+            CoTaskMemFree(*data);
+            *data = NULL;
+        }
+    }
+
+    IStream_Release(stream);
+    return hr;
+}
+
+/***********************************************************************
+ *      MFDeserializePresentationDescriptor (mfplat.@)
+ */
+HRESULT WINAPI MFDeserializePresentationDescriptor(DWORD size, BYTE *data, IMFPresentationDescriptor **pd)
+{
+    IMFStreamDescriptor **sds = NULL;
+    IMFPresentationDescriptor *out = NULL;
+    IMFAttributes *pd_attrs = NULL;
+    UINT32 magic, count, i, j;
+    BOOL *selected = NULL;
+    IStream *stream;
+    HGLOBAL hglobal;
+    HRESULT hr;
+    void *ptr;
+
+    TRACE("%lu, %p, %p.\n", size, data, pd);
+
+    if (pd)
+        *pd = NULL;
+    if (!data || !pd || !size)
+        return E_INVALIDARG;
+
+    if (!(hglobal = GlobalAlloc(GMEM_MOVEABLE, size)))
+        return E_OUTOFMEMORY;
+    ptr = GlobalLock(hglobal);
+    memcpy(ptr, data, size);
+    GlobalUnlock(hglobal);
+    if (FAILED(hr = CreateStreamOnHGlobal(hglobal, TRUE, &stream)))
+    {
+        GlobalFree(hglobal);
+        return hr;
+    }
+
+    if (FAILED(hr = pd_stream_read_u32(stream, &magic)))
+        goto done;
+    if (magic != PRESENTATION_STREAM_MAGIC)
+    {
+        hr = MF_E_INVALID_FORMAT;
+        goto done;
+    }
+    if (FAILED(hr = MFCreateAttributes(&pd_attrs, 0)) || FAILED(hr = MFDeserializeAttributesFromStream(pd_attrs, 0, stream))
+            || FAILED(hr = pd_stream_read_u32(stream, &count)))
+        goto done;
+    if (!count || count > size)
+    {
+        hr = MF_E_INVALID_FORMAT;
+        goto done;
+    }
+
+    sds = calloc(count, sizeof(*sds));
+    selected = calloc(count, sizeof(*selected));
+    if (!sds || !selected)
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+
+    for (i = 0; i < count; ++i)
+    {
+        IMFMediaType **types = NULL;
+        IMFAttributes *sd_attrs = NULL;
+        UINT32 sel, id, type_count, current;
+        IMFMediaTypeHandler *handler;
+
+        if (FAILED(hr = pd_stream_read_u32(stream, &sel)) || FAILED(hr = pd_stream_read_u32(stream, &id))
+                || FAILED(hr = MFCreateAttributes(&sd_attrs, 0))
+                || FAILED(hr = MFDeserializeAttributesFromStream(sd_attrs, 0, stream)))
+        {
+            if (sd_attrs)
+                IMFAttributes_Release(sd_attrs);
+            goto done;
+        }
+        selected[i] = !!sel;
+
+        if (FAILED(hr = pd_stream_read_u32(stream, &type_count)) || !type_count || type_count > size)
+        {
+            IMFAttributes_Release(sd_attrs);
+            if (SUCCEEDED(hr))
+                hr = MF_E_INVALID_FORMAT;
+            goto done;
+        }
+        if (!(types = calloc(type_count, sizeof(*types))))
+        {
+            IMFAttributes_Release(sd_attrs);
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+
+        for (j = 0; j < type_count; ++j)
+        {
+            UINT32 present;
+
+            if (FAILED(hr = pd_stream_read_u32(stream, &present)))
+                break;
+            if (!present)
+                continue;
+            if (FAILED(hr = MFCreateMediaType(&types[j])))
+                break;
+            if (FAILED(hr = MFDeserializeAttributesFromStream((IMFAttributes *)types[j], 0, stream)))
+                break;
+        }
+
+        if (SUCCEEDED(hr) && SUCCEEDED(hr = pd_stream_read_u32(stream, &current))
+                && SUCCEEDED(hr = MFCreateStreamDescriptor(id, type_count, types, &sds[i])))
+        {
+            hr = IMFAttributes_CopyAllItems(sd_attrs, (IMFAttributes *)sds[i]);
+#ifdef SG_MUTANT_PDSER_NO_CURRENT
+            current = ~0u;
+#endif
+            if (SUCCEEDED(hr) && current < type_count && types[current]
+                    && SUCCEEDED(IMFStreamDescriptor_GetMediaTypeHandler(sds[i], &handler)))
+            {
+                hr = IMFMediaTypeHandler_SetCurrentMediaType(handler, types[current]);
+                IMFMediaTypeHandler_Release(handler);
+            }
+        }
+
+        for (j = 0; j < type_count; ++j)
+            if (types[j])
+                IMFMediaType_Release(types[j]);
+        free(types);
+        IMFAttributes_Release(sd_attrs);
+        if (FAILED(hr))
+            goto done;
+    }
+
+    if (SUCCEEDED(hr = MFCreatePresentationDescriptor(count, sds, &out)))
+    {
+#ifdef SG_MUTANT_PDSER_NO_ATTRS
+        hr = S_OK;
+#else
+        hr = IMFAttributes_CopyAllItems(pd_attrs, (IMFAttributes *)out);
+#endif
+        for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+        {
+#ifdef SG_MUTANT_PDSER_NO_SELECTION
+            if (0)
+#endif
+            if (selected[i])
+                hr = IMFPresentationDescriptor_SelectStream(out, i);
+        }
+        if (SUCCEEDED(hr))
+        {
+            *pd = out;
+            out = NULL;
+        }
+    }
+
+done:
+    if (out)
+        IMFPresentationDescriptor_Release(out);
+    if (sds)
+    {
+        for (i = 0; i < count; ++i)
+            if (sds[i])
+                IMFStreamDescriptor_Release(sds[i]);
+    }
+    free(sds);
+    free(selected);
+    if (pd_attrs)
+        IMFAttributes_Release(pd_attrs);
+    IStream_Release(stream);
+    return hr;
+}
+
 struct bytestream
 {
     struct attributes attributes;
diff --git a/dlls/mfplat/mfplat.spec b/dlls/mfplat/mfplat.spec
index 2a09c80..25119d3 100644
--- a/dlls/mfplat/mfplat.spec
+++ b/dlls/mfplat/mfplat.spec
@@ -87,7 +87,7 @@
 @ stdcall MFDeserializeAttributesFromStream(ptr long ptr)
 @ stub MFDeserializeEvent
 @ stub MFDeserializeMediaTypeFromStream
-@ stub MFDeserializePresentationDescriptor
+@ stdcall MFDeserializePresentationDescriptor(long ptr ptr)
 @ stdcall MFEndCreateFile(ptr ptr)
 @ stub MFEndGetHostByName
 @ stdcall MFEndRegisterWorkQueueWithMMCSS(ptr ptr) rtworkq.RtwqEndRegisterWorkQueueWithMMCSS
@@ -152,7 +152,7 @@
 @ stdcall MFSerializeAttributesToStream(ptr long ptr)
 @ stub MFSerializeEvent
 @ stub MFSerializeMediaTypeToStream
-@ stub MFSerializePresentationDescriptor
+@ stdcall MFSerializePresentationDescriptor(ptr ptr ptr)
 @ stub MFSetSockaddrAny
 @ stdcall MFShutdown()
 @ stdcall MFStartup(long long)
