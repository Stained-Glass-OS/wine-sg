From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: GetFileMUIPath finds a file's MUI resource file

GetFileMUIPath failed with ERROR_CALL_NOT_IMPLEMENTED (63 times in the
logs). Programs that keep their resources in .mui files (MMC snap-ins,
.NET and Office components) look them up with it.

It finds <dir>\<language>\<file>.mui (a bare file name is looked for in
the system folder): for the language asked for, by name or identifier;
else for the user's preferred UI languages in order; with
MUI_USE_SEARCH_ALL_LANGUAGES, every language folder, one per call, with
the enumerator, then ERROR_NO_MORE_FILES. MUI_LANG_NEUTRAL_PE_FILE and
MUI_NON_LANG_NEUTRAL_FILE give the file itself. The language is returned
as a name or a four-digit identifier as asked; buffers too small give
ERROR_INSUFFICIENT_BUFFER and the lengths needed; no file is
ERROR_FILE_NOT_FOUND.

Wine's kernel32 locale tests: no failures, as before.

Gate: test/muipath-gate.sh. Mutant SG_MUTANT_NO_MUI_PATH
(kernelbase/locale.c).
---
--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -6054,15 +6054,160 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetFileMUIInfo( DWORD flags, const WCHAR *path,
 /******************************************************************************
  *	GetFileMUIPath   (kernelbase.@)
  */
+/* "<dir>\\<language>\\<file>.mui" when it exists */
+static BOOL find_mui_file( const WCHAR *dir, const WCHAR *name, const WCHAR *lang, WCHAR *path, size_t size )
+{
+    DWORD attr;
+
+    if (_snwprintf( path, size, L"%s\\%s\\%s.mui", dir, lang, name ) < 0) return FALSE;
+    attr = GetFileAttributesW( path );
+    return attr != INVALID_FILE_ATTRIBUTES && !(attr & FILE_ATTRIBUTE_DIRECTORY);
+}
+
 BOOL WINAPI /* DECLSPEC_HOTPATCH */ GetFileMUIPath( DWORD flags, const WCHAR *filepath,
                                                     WCHAR *language, ULONG *languagelen,
                                                     WCHAR *muipath, ULONG *muipathlen,
                                                     ULONGLONG *enumerator )
 {
+#ifndef SG_MUTANT_NO_MUI_PATH
+    /* The MUI resource file for a language: <dir>\<language>\<file>.mui.
+     * Programs that ship their resources in .mui files (MMC snap-ins, .NET
+     * and Office components) look theirs up with it; it failed with
+     * ERROR_CALL_NOT_IMPLEMENTED (63 FIXMEs in the logs). The language is
+     * the one asked for, else the user's preferred UI languages in order;
+     * MUI_USE_SEARCH_ALL_LANGUAGES walks every language folder, one per
+     * call, with the enumerator. */
+    WCHAR dir[MAX_PATH], full[MAX_PATH], found_lang[LOCALE_NAME_MAX_LENGTH], path[MAX_PATH * 2];
+    WCHAR *name, *langs = NULL;
+    ULONG count, size = 0, needed_lang, needed_path;
+    const WCHAR *lang;
+    BOOL found = FALSE;
+
+    TRACE( "0x%lx, %s, %s, %p, %p, %p, %p\n", flags, debugstr_w(filepath),
+           debugstr_w(language), languagelen, muipath, muipathlen, enumerator );
+
+    if (!filepath || !*filepath || !languagelen || !muipathlen || (!language && *languagelen) ||
+        (!muipath && *muipathlen) || ((flags & MUI_LANGUAGE_ID) && (flags & MUI_LANGUAGE_NAME)) ||
+        ((flags & MUI_USE_SEARCH_ALL_LANGUAGES) && !enumerator))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (wcschr( filepath, '\\' ) || wcschr( filepath, '/' ))
+    {
+        if (!GetFullPathNameW( filepath, ARRAY_SIZE(full), full, &name ) || !name) return FALSE;
+    }
+    else
+    {
+        GetSystemDirectoryW( full, ARRAY_SIZE(full) );
+        if (wcslen( full ) + 1 + wcslen( filepath ) >= ARRAY_SIZE(full))
+        {
+            SetLastError( ERROR_FILENAME_EXCED_RANGE );
+            return FALSE;
+        }
+        wcscat( full, L"\\" );
+        name = full + wcslen( full );
+        wcscat( full, filepath );
+    }
+    lstrcpynW( dir, full, name - full );  /* without the backslash */
+
+    if (flags & (MUI_LANG_NEUTRAL_PE_FILE | MUI_NON_LANG_NEUTRAL_FILE))
+    {
+        /* the file itself, which holds its own resources */
+        DWORD attr = GetFileAttributesW( full );
+        if (attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_DIRECTORY))
+        {
+            SetLastError( ERROR_FILE_NOT_FOUND );
+            return FALSE;
+        }
+        lstrcpynW( path, full, ARRAY_SIZE(path) );
+        found_lang[0] = 0;
+        found = TRUE;
+    }
+    else if (language && *language)
+    {
+        /* the language asked for, by name or by identifier */
+        if (flags & MUI_LANGUAGE_ID)
+        {
+            LCID lcid = wcstoul( language, NULL, 16 );
+            if (!LCIDToLocaleName( lcid, found_lang, ARRAY_SIZE(found_lang), 0 )) found_lang[0] = 0;
+        }
+        else lstrcpynW( found_lang, language, ARRAY_SIZE(found_lang) );
+        found = found_lang[0] && find_mui_file( dir, name, found_lang, path, ARRAY_SIZE(path) );
+    }
+    else if (flags & MUI_USE_SEARCH_ALL_LANGUAGES)
+    {
+        WIN32_FIND_DATAW data;
+        WCHAR pattern[MAX_PATH + 4];
+        ULONGLONG index = 0;
+        HANDLE find;
+
+        _snwprintf( pattern, ARRAY_SIZE(pattern), L"%s\\*", dir );
+        if ((find = FindFirstFileW( pattern, &data )) != INVALID_HANDLE_VALUE)
+        {
+            do
+            {
+                if (!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || data.cFileName[0] == '.') continue;
+                if (!LocaleNameToLCID( data.cFileName, 0 )) continue;
+                if (!find_mui_file( dir, name, data.cFileName, path, ARRAY_SIZE(path) )) continue;
+                if (index++ < *enumerator) continue;
+                lstrcpynW( found_lang, data.cFileName, ARRAY_SIZE(found_lang) );
+                found = TRUE;
+            } while (!found && FindNextFileW( find, &data ));
+            FindClose( find );
+        }
+        if (!found)
+        {
+            SetLastError( ERROR_NO_MORE_FILES );
+            return FALSE;
+        }
+        *enumerator = index;
+    }
+    else
+    {
+        /* the user's preferred UI languages, in order */
+        count = 0;
+        if (GetUserPreferredUILanguages( MUI_LANGUAGE_NAME, &count, NULL, &size ) &&
+            (langs = HeapAlloc( GetProcessHeap(), 0, size * sizeof(WCHAR) )) &&
+            GetUserPreferredUILanguages( MUI_LANGUAGE_NAME, &count, langs, &size ))
+        {
+            for (lang = langs; *lang && !found; lang += wcslen( lang ) + 1)
+            {
+                if (!find_mui_file( dir, name, lang, path, ARRAY_SIZE(path) )) continue;
+                lstrcpynW( found_lang, lang, ARRAY_SIZE(found_lang) );
+                found = TRUE;
+            }
+        }
+        HeapFree( GetProcessHeap(), 0, langs );
+    }
+    if (!found)
+    {
+        SetLastError( ERROR_FILE_NOT_FOUND );
+        return FALSE;
+    }
+
+    if (flags & MUI_LANGUAGE_ID && found_lang[0])
+        swprintf( found_lang, ARRAY_SIZE(found_lang), L"%04x", LocaleNameToLCID( found_lang, 0 ) & 0xffff );
+    needed_lang = wcslen( found_lang ) + 1;
+    needed_path = wcslen( path ) + 1;
+    if (*languagelen < needed_lang || *muipathlen < needed_path)
+    {
+        *languagelen = needed_lang;
+        *muipathlen = needed_path;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    wcscpy( language, found_lang );
+    wcscpy( muipath, path );
+    *languagelen = needed_lang;
+    *muipathlen = needed_path;
+    return TRUE;
+#else
     FIXME( "stub: 0x%lx, %s, %s, %p, %p, %p, %p\n", flags, debugstr_w(filepath),
            debugstr_w(language), languagelen, muipath, muipathlen, enumerator );
     SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
     return FALSE;
+#endif
 }
 
 
