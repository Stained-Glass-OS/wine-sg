@@ -3686,13 +3715,41 @@ PVOID WINAPI MmAllocateNonCachedMemory( SIZE_T size )
     return VirtualAlloc( NULL, size, MEM_RESERVE|MEM_COMMIT, PAGE_READWRITE|PAGE_NOCACHE );
 }
 
+/* Stained Glass OS: "physical" memory has no meaning to a driver running in a process: pages come from the
+ * process' address space and MmGetPhysicalAddress() reports the virtual address (identity), so a block
+ * satisfies a physical range when its address does. */
+static PVOID alloc_contiguous( SIZE_T size, ULONGLONG low, ULONGLONG high, ULONGLONG boundary, ULONG protect )
+{
+    SIZE_T alloc_size = (size + 0xfff) & ~(SIZE_T)0xfff;
+    ULONG_PTR zero_bits = 0;
+    PVOID addr = NULL;
+
+    if (!size || size > ~(SIZE_T)0 - 0xfff) return NULL;
+    if (high < ~(ULONGLONG)0)
+    {
+        /* NtAllocateVirtualMemory takes the mask of the address bits that may be set */
+        if (high + 1 <= alloc_size) return NULL;
+        zero_bits = (ULONG_PTR)(~(ULONGLONG)0 >> __builtin_clzll( high | 1 ));
+    }
+    if (NtAllocateVirtualMemory( GetCurrentProcess(), &addr, zero_bits, &alloc_size, MEM_RESERVE | MEM_COMMIT, protect ))
+        return NULL;
+    if ((ULONGLONG)(ULONG_PTR)addr < low || (ULONGLONG)(ULONG_PTR)addr + size - 1 > high ||
+        (boundary && ((ULONGLONG)(ULONG_PTR)addr / boundary != ((ULONGLONG)(ULONG_PTR)addr + size - 1) / boundary)))
+    {
+        alloc_size = 0;
+        NtFreeVirtualMemory( GetCurrentProcess(), &addr, &alloc_size, MEM_RELEASE );
+        return NULL;
+    }
+    return addr;
+}
+
 /***********************************************************************
  *           MmAllocateContiguousMemory   (NTOSKRNL.EXE.@)
  */
 PVOID WINAPI MmAllocateContiguousMemory( SIZE_T size, PHYSICAL_ADDRESS highest_valid_address )
 {
-    FIXME( "%Iu, %s stub\n", size, wine_dbgstr_longlong(highest_valid_address.QuadPart) );
-    return NULL;
+    TRACE( "%Iu, %s\n", size, wine_dbgstr_longlong(highest_valid_address.QuadPart) );
+    return alloc_contiguous( size, 0, highest_valid_address.QuadPart, 0, PAGE_READWRITE );
 }
 
 /***********************************************************************
@@ -3704,19 +3761,77 @@ PVOID WINAPI MmAllocateContiguousMemorySpecifyCache( SIZE_T size,
                                                      PHYSICAL_ADDRESS BoundaryAddressMultiple,
                                                      MEMORY_CACHING_TYPE CacheType )
 {
-    FIXME(": stub\n");
-    return NULL;
+    TRACE( "%Iu, %s, %s, %s, %u\n", size, wine_dbgstr_longlong(lowest_valid_address.QuadPart),
+           wine_dbgstr_longlong(highest_valid_address.QuadPart),
+           wine_dbgstr_longlong(BoundaryAddressMultiple.QuadPart), CacheType );
+    if (CacheType > MmWriteCombined) return NULL;
+    return alloc_contiguous( size, lowest_valid_address.QuadPart, highest_valid_address.QuadPart,
+                             BoundaryAddressMultiple.QuadPart,
+                             CacheType == MmNonCached ? PAGE_READWRITE | PAGE_NOCACHE : PAGE_READWRITE );
+}
+
+/***********************************************************************
+ *           MmFreeContiguousMemory   (NTOSKRNL.EXE.@)
+ */
+void WINAPI MmFreeContiguousMemory( PVOID addr )
+{
+    SIZE_T size = 0;
+
+    TRACE( "%p\n", addr );
+    NtFreeVirtualMemory( GetCurrentProcess(), &addr, &size, MEM_RELEASE );
+}
+
+/***********************************************************************
+ *           MmFreeContiguousMemorySpecifyCache   (NTOSKRNL.EXE.@)
+ */
+void WINAPI MmFreeContiguousMemorySpecifyCache( PVOID addr, SIZE_T size, MEMORY_CACHING_TYPE type )
+{
+    TRACE( "%p, %Iu, %u\n", addr, size, type );
+    MmFreeContiguousMemory( addr );
 }
 
 /***********************************************************************
  *           MmAllocatePagesForMdl   (NTOSKRNL.EXE.@)
+ *
+ * The pages are one block of the process' memory; the MDL describes them (identity "physical" numbers) and
+ * is not mapped until MmMapLockedPagesSpecifyCache().
  */
 PMDL WINAPI MmAllocatePagesForMdl(PHYSICAL_ADDRESS lowaddress, PHYSICAL_ADDRESS highaddress,
                                   PHYSICAL_ADDRESS skipbytes, SIZE_T size)
 {
-    FIXME("%s %s %s %Iu: stub\n", wine_dbgstr_longlong(lowaddress.QuadPart), wine_dbgstr_longlong(highaddress.QuadPart),
-                                  wine_dbgstr_longlong(skipbytes.QuadPart), size);
-    return NULL;
+    PFN_NUMBER *pfns;
+    PVOID addr;
+    PMDL mdl;
+    SIZE_T i;
+
+    TRACE("%s %s %s %Iu\n", wine_dbgstr_longlong(lowaddress.QuadPart), wine_dbgstr_longlong(highaddress.QuadPart),
+          wine_dbgstr_longlong(skipbytes.QuadPart), size);
+
+    if (!size || (size & 0xfff) || size > 0xffffffff) return NULL;
+    if (!(addr = alloc_contiguous( size, lowaddress.QuadPart, highaddress.QuadPart, 0, PAGE_READWRITE ))) return NULL;
+    if (!(mdl = IoAllocateMdl( addr, size, FALSE, FALSE, NULL )))
+    {
+        MmFreeContiguousMemory( addr );
+        return NULL;
+    }
+    pfns = MmGetMdlPfnArray( mdl );
+    for (i = 0; i < size / 0x1000; i++) pfns[i] = ((ULONG_PTR)addr >> 12) + i;
+    mdl->MdlFlags |= MDL_PAGES_LOCKED | MDL_ALLOCATED_FIXED_SIZE;
+    return mdl;
+}
+
+/***********************************************************************
+ *           MmFreePagesFromMdl   (NTOSKRNL.EXE.@)
+ *
+ * Releases the pages, not the MDL (the caller frees it with ExFreePool).
+ */
+void WINAPI MmFreePagesFromMdl( PMDL mdl )
+{
+    TRACE( "%p\n", mdl );
+    if (!mdl || !mdl->StartVa) return;
+    MmFreeContiguousMemory( (PVOID)((ULONG_PTR)mdl->StartVa & ~(ULONG_PTR)0xfff) );
+    mdl->MdlFlags &= ~MDL_PAGES_LOCKED;
+    mdl->ByteCount = 0;
 }
 
 static ULONG mdl_page_count( const MDL *mdl )
@@ -3794,8 +3909,8 @@ BOOLEAN WINAPI MmIsAddressValid(PVOID VirtualAddress)
 PHYSICAL_ADDRESS WINAPI MmGetPhysicalAddress(void *virtual_address)
 {
     PHYSICAL_ADDRESS ret;
-    FIXME("(%p): semi-stub\n", virtual_address);
-    ret.QuadPart = (ULONG_PTR)virtual_address;
+    TRACE("(%p)\n", virtual_address);
+    ret.QuadPart = (ULONG_PTR)virtual_address;  /* identity: see alloc_contiguous() */
     return ret;
 }
 
@@ -5138,6 +5253,25 @@ void WINAPI KeBugCheckEx(ULONG code, ULONG_PTR param1, ULONG_PTR param2, ULONG_P
     ExitProcess( code );
 }
 
+/* Stained Glass OS: ProbeForRead/Write raise (they do not return a status): STATUS_DATATYPE_MISALIGNMENT when the
+ * address is not a multiple of the alignment, STATUS_ACCESS_VIOLATION when the range wraps around or is not
+ * entirely below MmUserProbeAddress (the end of the user address space).  A length of 0 is never probed. */
+static void probe_user_range( const void *address, SIZE_T length, ULONG alignment )
+{
+    static ULONG_PTR user_limit;
+
+    if (!length) return;
+    if (alignment > 1 && ((ULONG_PTR)address & (alignment - 1))) RtlRaiseStatus( STATUS_DATATYPE_MISALIGNMENT );
+    if (!user_limit)
+    {
+        SYSTEM_BASIC_INFORMATION info;
+        NtQuerySystemInformation( SystemBasicInformation, &info, sizeof(info), NULL );
+        user_limit = (ULONG_PTR)info.HighestUserAddress + 1;
+    }
+    if ((ULONG_PTR)address + length < (ULONG_PTR)address || (ULONG_PTR)address + length > user_limit)
+        RtlRaiseStatus( STATUS_ACCESS_VIOLATION );
+}
+
 /***********************************************************************
  *           ExRaiseAccessViolation   (NTOSKRNL.EXE.@)
  */
@@ -5917,11 +6051,63 @@ NTSTATUS WINAPI MmCopyVirtualMemory(PEPROCESS fromprocess, void *fromaddress, PE
                                     void *toaddress, SIZE_T bufsize, KPROCESSOR_MODE mode,
                                     SIZE_T *copied)
 {
-    FIXME("fromprocess %p, fromaddress %p, toprocess %p, toaddress %p, bufsize %Iu, mode %d, copied %p stub.\n",
+    HANDLE from = NULL, to = NULL;
+    NTSTATUS status = STATUS_SUCCESS;
+    SIZE_T done = 0;
+    char *buffer;
+
+    TRACE("fromprocess %p, fromaddress %p, toprocess %p, toaddress %p, bufsize %Iu, mode %d, copied %p.\n",
             fromprocess, fromaddress, toprocess, toaddress, bufsize, mode, copied);
 
     *copied = 0;
-    return STATUS_NOT_IMPLEMENTED;
+    if (!bufsize) return STATUS_SUCCESS;
+    if (mode == UserMode)
+    {
+        /* the addresses are untrusted: they must lie in the user address space (raised as STATUS_ACCESS_VIOLATION
+         * by the probe, caught here and returned) */
+        __TRY
+        {
+            probe_user_range( fromaddress, bufsize, 1 );
+            probe_user_range( toaddress, bufsize, 1 );
+        }
+        __EXCEPT_ALL
+        {
+            return STATUS_ACCESS_VIOLATION;
+        }
+        __ENDTRY
+    }
+    if (!(buffer = HeapAlloc( GetProcessHeap(), 0, min( bufsize, 0x10000 ) ))) return STATUS_INSUFFICIENT_RESOURCES;
+
+    if (HandleToUlong( PsGetProcessId( fromprocess )) == GetCurrentProcessId()) from = GetCurrentProcess();
+    else if (!(from = OpenProcess( PROCESS_VM_READ, FALSE, HandleToUlong( PsGetProcessId( fromprocess )) )))
+        status = STATUS_ACCESS_DENIED;
+    if (!status)
+    {
+        if (HandleToUlong( PsGetProcessId( toprocess )) == GetCurrentProcessId()) to = GetCurrentProcess();
+        else if (!(to = OpenProcess( PROCESS_VM_WRITE | PROCESS_VM_OPERATION, FALSE, HandleToUlong( PsGetProcessId( toprocess )) )))
+            status = STATUS_ACCESS_DENIED;
+    }
+    while (!status && done < bufsize)
+    {
+        SIZE_T chunk = min( bufsize - done, 0x10000 ), got = 0;
+
+        /* a chunk is written only for the bytes read: a fault half way gives STATUS_PARTIAL_COPY */
+        status = NtReadVirtualMemory( from, (char *)fromaddress + done, buffer, chunk, &got );
+        if (got)
+        {
+            SIZE_T put = 0;
+            NTSTATUS write_status = NtWriteVirtualMemory( to, (char *)toaddress + done, buffer, got, &put );
+            done += put;
+            if (write_status) status = write_status;
+            else if (put < got) status = STATUS_PARTIAL_COPY;
+        }
+        if (status && status != STATUS_ACCESS_DENIED) status = STATUS_PARTIAL_COPY;
+    }
+    if (from && from != GetCurrentProcess()) CloseHandle( from );
+    if (to && to != GetCurrentProcess()) CloseHandle( to );
+    HeapFree( GetProcessHeap(), 0, buffer );
+    *copied = done;
+    return status;
 }
 
