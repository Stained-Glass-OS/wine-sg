+KIRQL WINAPI KeGetCurrentIrql(void)
 {
-    FIXME("new %u old %p: stub.\n", new, old);
+    return get_thread_irql();
+}
+
+KIRQL WINAPI KfRaiseIrql(KIRQL new)
+{
+    KIRQL old = get_thread_irql();
+
+    TRACE("new %u old %u.\n", new, old);
+    /* raising to a lower level than the current one is a driver bug that stops Windows */
+    if (new < old) KeBugCheckEx( IRQL_NOT_GREATER_OR_EQUAL, old, new, 0, 0 );
+    set_thread_irql( new );
+    return old;
 }
 
 void WINAPI KeLowerIrql(KIRQL new)
 {
-    FIXME("new %u: stub.\n", new);
+    KIRQL old = get_thread_irql();
+
+    TRACE("new %u old %u.\n", new, old);
+    if (new > old) KeBugCheckEx( IRQL_NOT_LESS_OR_EQUAL, old, new, 0, 0 );
+    set_thread_irql( new );
+}
+
+KIRQL WINAPI KeRaiseIrqlToDpcLevel(void)
+{
+    return KfRaiseIrql( DISPATCH_LEVEL );
+}
+
+KIRQL WINAPI KeRaiseIrqlToSynchLevel(void)
+{
+    return KfRaiseIrql( SYNCH_LEVEL );
 }
 
 #endif
