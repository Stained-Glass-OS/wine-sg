  */
 KPRIORITY WINAPI KeQueryPriorityThread( PKTHREAD Thread )
 {
-    FIXME("(%p): stub.\n", Thread);
-    /* priority must be a value between 0 and 31 */
-    return 15;
+    /* the dynamic priority 0..31 out of the process' priority class and the thread's relative priority
+     * (the table of "Scheduling Priorities"); a thread that cannot be opened is a normal one */
+    static const int class_base[] = { 8, 4, 24, 13, 6, 10 };  /* normal, idle, realtime, high, below, above */
+    KPRIORITY base = 8;
+    int relative = 0, i;
+    BOOL realtime = FALSE;
+    HANDLE process, thread;
+
+    TRACE("(%p)\n", Thread);
+    if (!Thread) return 8;
+
+    if ((thread = OpenThread( THREAD_QUERY_LIMITED_INFORMATION, FALSE, HandleToUlong(Thread->id.UniqueThread) )))
+    {
+        relative = GetThreadPriority( thread );
+        CloseHandle( thread );
+        if (relative == THREAD_PRIORITY_ERROR_RETURN) relative = 0;
+    }
+    if ((process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, HandleToUlong(Thread->id.UniqueProcess) )))
+    {
+        DWORD class = GetPriorityClass( process );
+        CloseHandle( process );
+        for (i = 0; i < ARRAY_SIZE(class_base); i++)
+        {
+            static const DWORD classes[] = { NORMAL_PRIORITY_CLASS, IDLE_PRIORITY_CLASS, REALTIME_PRIORITY_CLASS,
+                                             HIGH_PRIORITY_CLASS, BELOW_NORMAL_PRIORITY_CLASS, ABOVE_NORMAL_PRIORITY_CLASS };
+            if (class == classes[i]) { base = class_base[i]; realtime = (i == 2); break; }
+        }
+    }
+    if (relative == THREAD_PRIORITY_IDLE) return realtime ? 16 : 1;
+    if (relative == THREAD_PRIORITY_TIME_CRITICAL) return realtime ? 31 : 15;
+    return base + relative;
 }
 
