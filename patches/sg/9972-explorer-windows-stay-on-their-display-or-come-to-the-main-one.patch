From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: a window stays on its display when the displays change, or comes to the main one

Windows keeps each window on its display when a display is unplugged, made
the main one, moved or given another resolution: coordinates start at the
main display, so a window on a display that stays moves with that display's
rectangle, and one on a display that is gone is brought to the main display,
at the same place relative to it. Wine kept every rectangle as it was: after
the main display of two was unplugged the windows on the other display were
off the screen (ledger i0645). The shell's desktop takes the displays at its
start and at each WM_DISPLAYCHANGE and places the windows again; a display is
known by its EDID's maker and product and its place among the displays alike.
---
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -3008,6 +3008,159 @@
 #endif
 }
 
+/* Stained Glass OS (wine-sg 9972): the displays changed -- one unplugged, another made the main
+ * one, one moved or given another resolution. Windows keeps each window on its display: a
+ * window on a display that is still there stays on it (Windows' coordinates start at the main
+ * display, so its rectangle moves with the display's), and one on a display that is gone comes
+ * to the main display, at the same place relative to it, as Windows brings it back. Wine kept
+ * every rectangle as it was: after the main display of two was unplugged, the windows on the
+ * other one were off the screen (ledger i0645). A display is known by its EDID's maker and
+ * product (DisplayConfig's target name) and its place among the displays alike. */
+struct sg_mon { RECT rc, work; UINT mfg, product, nth; BOOL primary; };
+/* (user32's export; Wine's winuser.h does not declare it) */
+LONG WINAPI QueryDisplayConfig( UINT32, UINT32 *, DISPLAYCONFIG_PATH_INFO *, UINT32 *, DISPLAYCONFIG_MODE_INFO *,
+                                DISPLAYCONFIG_TOPOLOGY_ID * );
+static struct sg_mon sg_mons[16];
+static int sg_nmons = -1;
+
+static void sg_monitors_read( struct sg_mon *mons, int *count )
+{
+    DISPLAYCONFIG_PATH_INFO paths[16];
+    DISPLAYCONFIG_MODE_INFO modes[32];
+    UINT32 np = ARRAY_SIZE(paths), nm = ARRAY_SIZE(modes), i;
+    int n = 0, j;
+
+    *count = 0;
+    if (QueryDisplayConfig( QDC_ONLY_ACTIVE_PATHS, &np, paths, &nm, modes, NULL )) return;
+    for (i = 0; i < np && n < 16; i++)
+    {
+        DISPLAYCONFIG_SOURCE_DEVICE_NAME source = { { DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME, sizeof(source),
+                                                      paths[i].sourceInfo.adapterId, paths[i].sourceInfo.id } };
+        DISPLAYCONFIG_TARGET_DEVICE_NAME target = { { DISPLAYCONFIG_DEVICE_INFO_GET_TARGET_NAME, sizeof(target),
+                                                      paths[i].targetInfo.adapterId, paths[i].targetInfo.id } };
+        DEVMODEW dm = { .dmSize = sizeof(dm) };
+        MONITORINFO mi = { sizeof(mi) };
+        HMONITOR mon;
+        POINT pt;
+
+        if (DisplayConfigGetDeviceInfo( &source.header )) continue;
+        if (!EnumDisplaySettingsW( source.viewGdiDeviceName, ENUM_CURRENT_SETTINGS, &dm )) continue;
+        pt.x = dm.dmPosition.x + dm.dmPelsWidth / 2;
+        pt.y = dm.dmPosition.y + dm.dmPelsHeight / 2;
+        if (!(mon = MonitorFromPoint( pt, MONITOR_DEFAULTTONULL )) || !GetMonitorInfoW( mon, &mi )) continue;
+        for (j = 0; j < n; j++) if (EqualRect( &mons[j].rc, &mi.rcMonitor )) break;   /* a clone */
+        if (j < n) continue;
+        if (DisplayConfigGetDeviceInfo( &target.header )) target.edidManufactureId = target.edidProductCodeId = 0;
+        mons[n].rc = mi.rcMonitor;
+        mons[n].work = mi.rcWork;
+        mons[n].primary = !!(mi.dwFlags & MONITORINFOF_PRIMARY);
+        mons[n].mfg = target.edidManufactureId;
+        mons[n].product = target.edidProductCodeId;
+        n++;
+    }
+    /* the displays alike, told apart by their order from left to right */
+    for (j = 0; j < n; j++)
+    {
+        int k;
+        mons[j].nth = 0;
+        for (k = 0; k < n; k++)
+            if (k != j && mons[k].mfg == mons[j].mfg && mons[k].product == mons[j].product &&
+                (mons[k].rc.left < mons[j].rc.left || (mons[k].rc.left == mons[j].rc.left && mons[k].rc.top < mons[j].rc.top)))
+                mons[j].nth++;
+    }
+    *count = n;
+}
+
+static int sg_monitor_at( const struct sg_mon *mons, int count, const RECT *rc )
+{
+    POINT pt = { (rc->left + rc->right) / 2, (rc->top + rc->bottom) / 2 };
+    int i, best = -1, best_area = 0;
+    RECT part;
+    for (i = 0; i < count; i++) if (PtInRect( &mons[i].rc, pt )) return i;
+    for (i = 0; i < count; i++)
+        if (IntersectRect( &part, &mons[i].rc, rc ) &&
+            (part.right - part.left) * (part.bottom - part.top) > best_area)
+        {
+            best = i;
+            best_area = (part.right - part.left) * (part.bottom - part.top);
+        }
+    return best;
+}
+
+struct sg_rescue { struct sg_mon *old, *now; int nold, nnow; DWORD pid; };
+
+static BOOL CALLBACK sg_rescue_window( HWND hwnd, LPARAM lp )
+{
+    struct sg_rescue *r = (struct sg_rescue *)lp;
+    WCHAR cls[64];
+    RECT rc, work;
+    int m, n, w, h, x, y;
+    DWORD pid = 0;
+
+    if (!IsWindowVisible( hwnd ) || IsIconic( hwnd )) return TRUE;
+    GetWindowThreadProcessId( hwnd, &pid );
+    if (pid == r->pid) return TRUE;   /* the shell's own (desktop, taskbars) place themselves */
+    if (!GetWindowRect( hwnd, &rc ) || (m = sg_monitor_at( r->old, r->nold, &rc )) < 0) return TRUE;
+    for (n = 0; n < r->nnow; n++)
+        if (r->now[n].mfg == r->old[m].mfg && r->now[n].product == r->old[m].product && r->now[n].nth == r->old[m].nth) break;
+    if (n == r->nnow)
+    {
+        /* its display is gone: the main display */
+        for (n = 0; n < r->nnow && !r->now[n].primary; n++) ;
+        if (n == r->nnow) return TRUE;
+    }
+    work = r->now[n].work;
+    w = rc.right - rc.left;
+    h = rc.bottom - rc.top;
+    if (IsZoomed( hwnd ))
+    {
+        /* maximized: the new display's work area, as Windows maximizes it there */
+        int dx = rc.left - r->old[m].work.left, dy = rc.top - r->old[m].work.top;
+        x = work.left + dx; y = work.top + dy;
+        w = work.right - work.left - 2 * dx; h = work.bottom - work.top - 2 * dy;
+    }
+    else
+    {
+        /* the same place on its display, kept on its work area */
+        x = r->now[n].rc.left + (rc.left - r->old[m].rc.left);
+        y = r->now[n].rc.top + (rc.top - r->old[m].rc.top);
+        if (w > work.right - work.left) w = work.right - work.left;
+        if (h > work.bottom - work.top) h = work.bottom - work.top;
+        if (x + w > work.right) x = work.right - w;
+        if (y + h > work.bottom) y = work.bottom - h;
+        if (x < work.left) x = work.left;
+        if (y < work.top) y = work.top;
+    }
+    if (x == rc.left && y == rc.top && w == rc.right - rc.left && h == rc.bottom - rc.top) return TRUE;
+    GetClassNameW( hwnd, cls, ARRAY_SIZE(cls) );
+    WINE_TRACE( "%p %s: %s -> %d,%d %dx%d\n", hwnd, debugstr_w(cls), wine_dbgstr_rect( &rc ), x, y, w, h );
+    SetWindowPos( hwnd, 0, x, y, w, h, SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_ASYNCWINDOWPOS );
+    return TRUE;
+}
+
+/* the displays now; with WINDOWS, each window on the display it was on, or on the main one */
+static void sg_monitors_changed( BOOL windows )
+{
+    struct sg_mon now[16];
+    int count, i;
+
+    sg_monitors_read( now, &count );
+    if (!count) return;
+#ifdef SG_MUTANT_RESCUE_NONE
+    windows = FALSE;
+#endif
+    if (windows && sg_nmons > 0)
+    {
+        BOOL same = count == sg_nmons;
+        struct sg_rescue r = { sg_mons, now, sg_nmons, count, GetCurrentProcessId() };
+        /* (a work area changed alone -- a taskbar shown or moved -- moves nothing) */
+        for (i = 0; same && i < count; i++) same = EqualRect( &now[i].rc, &sg_mons[i].rc );
+        if (!same) EnumWindows( sg_rescue_window, (LPARAM)&r );
+    }
+    memcpy( sg_mons, now, sizeof(now[0]) * count );
+    sg_nmons = count;
+}
+
 static LRESULT WINAPI desktop_wnd_proc( HWND hwnd, UINT message, WPARAM wp, LPARAM lp )
 {
     TRACE( "got msg %04x wp %Ix lp %Ix\n", message, wp, lp );
@@ -3061,6 +3214,8 @@
     case WM_DISPLAYCHANGE:
         /* the displays changed: the icons are drawn from the main display's corner (wine-sg 7752) */
         if (!using_root) { InvalidateRect( hwnd, NULL, TRUE ); sg_dump(); }
+        /* and each window stays on its display, or comes to the main one (9972) */
+        if (!using_root) sg_monitors_changed( TRUE );
         break;
 
     case WM_SG_DESKTOP_REPAINT:
@@ -4207,6 +4362,7 @@
         SystemParametersInfoW( SPI_SETDESKWALLPAPER, 0, NULL, FALSE );
         ClipCursor( NULL );
         initialize_display_settings( width, height );
+        if (!using_root) sg_monitors_changed( FALSE );   /* the displays, before any change (9972) */
         initialize_appbar();
 
         initialize_systray( using_root, enable_shell, show_systray, no_tray_items );
