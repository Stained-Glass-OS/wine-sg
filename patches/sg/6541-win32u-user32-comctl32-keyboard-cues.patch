diff --git a/dlls/win32u/defwnd.c b/dlls/win32u/defwnd.c
index 53e626f..c426cb1 100644
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -3179,6 +3179,57 @@ static LRESULT set_window_hotkey( HWND hwnd, WPARAM wparam )
  * metrics are the window's DPI's while DefWindowProc lays out, draws and
  * hit-tests the frame; a message sent from there to a program's window
  * procedure has them as usual again (call_window_proc). */
+/* Stained Glass OS (wine-sg 6541): the keyboard cues state of a window (WM_QUERYUISTATE,
+ * WM_CHANGEUISTATE, WM_UPDATEUISTATE): which access-key underlines and focus rectangles it hides
+ * until the keyboard is used. */
+static UINT get_ui_state( HWND hwnd )
+{
+    WND *win = get_win_ptr( hwnd );
+    UINT state;
+
+    if (!win || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return 0;
+    state = win->ui_state;
+    release_win_ptr( win );
+    return state;
+}
+
+static void set_ui_state( HWND hwnd, UINT state )
+{
+    WND *win = get_win_ptr( hwnd );
+
+    if (!win || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return;
+    win->ui_state = state;
+    release_win_ptr( win );
+}
+
+BOOL keyboard_cues_on(void)
+{
+    BOOL on = FALSE;
+    NtUserSystemParametersInfo( SPI_GETKEYBOARDCUES, 0, &on, 0 );
+    return on;
+}
+
+/* what WM_QUERYUISTATE answers */
+UINT query_ui_state( HWND hwnd )
+{
+#ifdef SG_MUTANT_UISTATE_NONE
+    return 0;
+#endif
+    if (keyboard_cues_on()) return get_ui_state( hwnd ) & ~(UISF_HIDEACCEL | UISF_HIDEFOCUS);
+    return get_ui_state( hwnd );
+}
+
+static UINT apply_ui_state( UINT state, UINT action, UINT flags )
+{
+    switch (action)
+    {
+    case UIS_SET: return state | flags;
+    case UIS_CLEAR: return state & ~flags;
+    case UIS_INITIALIZE: return keyboard_cues_on() ? state & ~flags : state | flags;
+    }
+    return state;
+}
+
 LRESULT default_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, BOOL ansi )
 {
     UINT context, prev, dpi;
@@ -3593,6 +3644,10 @@ static LRESULT default_window_proc_dpi( HWND hwnd, UINT msg, WPARAM wparam, LPAR
         break;
 
     case WM_SYSKEYDOWN:
+        /* the keyboard is in use: show the access keys (wine-sg 6541) */
+        if ((wparam == VK_MENU || wparam == VK_LMENU || wparam == VK_RMENU || wparam == VK_F10) &&
+            !(HIWORD( lparam ) & KF_REPEAT) && (get_ui_state( NtUserGetAncestor( hwnd, GA_ROOT ) ) & UISF_HIDEACCEL))
+            send_message( hwnd, WM_CHANGEUISTATE, MAKEWPARAM( UIS_CLEAR, UISF_HIDEACCEL ), 0 );
         if (HIWORD( lparam ) & KEYDATA_ALT)
         {
             if ((wparam == VK_MENU || wparam == VK_LMENU || wparam == VK_RMENU) && !menu_sys_key)
@@ -3691,6 +3746,51 @@ static LRESULT default_window_proc_dpi( HWND hwnd, UINT msg, WPARAM wparam, LPAR
         if (lparam & PRF_CLIENT) send_message(hwnd, WM_PRINTCLIENT, wparam, lparam );
         break;
 
+    case WM_QUERYUISTATE:
+        result = query_ui_state( hwnd );
+        break;
+
+    case WM_CHANGEUISTATE:
+    {
+        UINT action = LOWORD( wparam ), flags = HIWORD( wparam ), cur, new;
+        HWND parent;
+
+        if (action < UIS_SET || action > UIS_INITIALIZE || (flags & ~(UISF_HIDEFOCUS | UISF_HIDEACCEL | UISF_ACTIVE)) || lparam)
+            break;
+        /* a child passes it up: the top-level window decides, and tells all its children */
+        if ((get_window_long( hwnd, GWL_STYLE ) & WS_CHILD) && (parent = NtUserGetAncestor( hwnd, GA_PARENT )) &&
+            parent != get_desktop_window())
+        {
+            send_message( parent, WM_CHANGEUISTATE, wparam, lparam );
+            break;
+        }
+        cur = get_ui_state( hwnd );
+        new = apply_ui_state( cur, action, flags );
+        if (new != cur)
+            send_message( hwnd, WM_UPDATEUISTATE, MAKEWPARAM( (new & flags) ? UIS_SET : UIS_CLEAR, flags ), 0 );
+        break;
+    }
+
+    case WM_UPDATEUISTATE:
+    {
+        UINT action = LOWORD( wparam ), flags = HIWORD( wparam );
+        HWND *children;
+        int i;
+
+        if (action < UIS_SET || action > UIS_INITIALIZE || (flags & ~(UISF_HIDEFOCUS | UISF_HIDEACCEL | UISF_ACTIVE)) || lparam)
+            break;
+        set_ui_state( hwnd, apply_ui_state( get_ui_state( hwnd ), action, flags ) );
+        /* the menu bar's underlines follow */
+        if ((flags & UISF_HIDEACCEL) && !(get_window_long( hwnd, GWL_STYLE ) & WS_CHILD) && get_menu( hwnd ))
+            NtUserDrawMenuBar( hwnd );
+        if ((children = list_window_children( hwnd )))
+        {
+            for (i = 0; children[i]; i++) send_message( children[i], WM_UPDATEUISTATE, wparam, lparam );
+            free( children );
+        }
+        break;
+    }
+
     case WM_APPCOMMAND:
         {
             HWND parent = get_parent( hwnd );
diff --git a/dlls/win32u/menu.c b/dlls/win32u/menu.c
index ea3ef49..ac2d158 100644
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -2389,6 +2389,19 @@ got_bitmap:
