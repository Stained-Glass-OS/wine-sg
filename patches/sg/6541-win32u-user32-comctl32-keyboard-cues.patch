 /* Draw a single menu item */
+/* Stained Glass OS (wine-sg 6541): menus underline their access keys when "Underline access keys"
+ * is on, or once the keyboard is used: a menu opened with the keyboard (Alt, F10, Alt+letter), or a
+ * menu bar whose window has been told so (Alt: WM_CHANGEUISTATE); one opened with the mouse hides
+ * them, as on Windows. */
+static int menu_tracking_cues = -1;  /* while a menu is open: 1 opened with the keyboard, 0 the mouse */
+
+static BOOL menu_hides_accel( HWND owner )
+{
+    if (keyboard_cues_on()) return FALSE;
+    if (menu_tracking_cues >= 0) return !menu_tracking_cues;
+    return owner && (query_ui_state( owner ) & UISF_HIDEACCEL);
+}
+
 static void draw_menu_item( HWND hwnd, struct menu *menu, HWND owner, HDC hdc,
                             struct menu_item *item, BOOL menu_bar, UINT odaction )
 {
@@ -2666,6 +2679,7 @@ static void draw_menu_item( HWND hwnd, struct menu *menu, HWND owner, HDC hdc,
             DT_CENTER | DT_VCENTER | DT_SINGLELINE :
             DT_LEFT | DT_VCENTER | DT_SINGLELINE;
 
+        if (menu_hides_accel( owner )) format |= DT_HIDEPREFIX;
         if (!(menu->dwStyle & MNS_CHECKORBMP))
             rect.left += menu->textOffset;
 
@@ -4485,12 +4499,14 @@ void track_mouse_menu_bar( HWND hwnd, INT ht, int x, int y )
     if (get_window_long( hwnd, GWL_EXSTYLE ) & WS_EX_LAYOUTRTL) flags |= TPM_LAYOUTRTL;
     if (is_menu( handle ))
     {
+        menu_tracking_cues = 0;
         init_tracking( hwnd, handle, FALSE, flags );
 
         /* fetch the window menu again, it may have changed */
         handle = ht == HTSYSMENU ? get_win_sys_menu( hwnd ) : get_menu( hwnd );
         track_menu( handle, flags, x, y, hwnd, NULL );
         exit_tracking( hwnd, FALSE );
+        menu_tracking_cues = -1;
     }
 }
 
@@ -4519,6 +4535,7 @@ void track_keyboard_menu_bar( HWND hwnd, UINT wparam, WCHAR ch )
 
     if (!is_menu( menu )) return;
 
+    menu_tracking_cues = 1;
     init_tracking( hwnd, menu, FALSE, flags );
 
     /* fetch the window menu again, it may have changed */
@@ -4549,6 +4566,7 @@ void track_keyboard_menu_bar( HWND hwnd, UINT wparam, WCHAR ch )
 track_menu:
     track_menu( menu, flags, 0, 0, hwnd, NULL );
     exit_tracking( hwnd, FALSE );
+    menu_tracking_cues = -1;
