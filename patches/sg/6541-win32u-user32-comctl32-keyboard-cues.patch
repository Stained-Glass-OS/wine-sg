+/* Stained Glass OS (wine-sg 6541): a new window's keyboard cues state. A child takes its parent's;
+ * a top-level window hides access-key underlines and focus rectangles until the keyboard is used
+ * (Alt, Tab), unless "Underline access keys" (SPI_SETKEYBOARDCUES) is on. */
+UINT initial_ui_state( HWND parent )
+{
+    WND *win;
+    UINT state;
+
+    if (parent && (win = get_win_ptr( parent )) && win != WND_OTHER_PROCESS && win != WND_DESKTOP)
+    {
+        state = win->ui_state;
+        release_win_ptr( win );
+        return state;
+    }
+    /* a window opened from the keyboard shows them */
+    return last_input_keyboard ? 0 : UISF_HIDEFOCUS | UISF_HIDEACCEL;
+}
