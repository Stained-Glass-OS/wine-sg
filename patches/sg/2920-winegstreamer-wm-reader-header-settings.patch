 static HRESULT WINAPI header_info_GetCodecInfo(IWMHeaderInfo3 *iface, DWORD index, WORD *name_len,
         WCHAR *name, WORD *desc_len, WCHAR *desc, WMT_CODEC_INFO_TYPE *type, WORD *size, BYTE *info)
 {
-    FIXME("iface %p, index %lu, name_len %p, name %p, desc_len %p, desc %p, type %p, size %p, info %p, stub!\n",
+    struct wm_reader *reader = impl_from_IWMHeaderInfo3(iface);
+    WORD req_name_len, req_desc_len, req_size, info_size;
+    WCHAR name_buf[32], desc_buf[1] = {0};
+    WMT_CODEC_INFO_TYPE codec_type;
+    struct wg_format codec_format;
+    const struct wg_format *format;
+    BYTE info_buf[4];
+    AM_MEDIA_TYPE mt;
+    DWORD name_size;
+
+    TRACE("iface %p, index %lu, name_len %p, name %p, desc_len %p, desc %p, type %p, size %p, info %p.\n",
             iface, index, name_len, name, desc_len, desc, type, size, info);
-    return E_NOTIMPL;
+
+    if (!name_len || !desc_len || !size)
+        return E_INVALIDARG;
+    if (!reader->wg_parser)
+        return E_UNEXPECTED;
+
+    EnterCriticalSection(&reader->cs);
+    if (index >= reader->stream_count)
+    {
+        LeaveCriticalSection(&reader->cs);
+        return E_INVALIDARG;
+    }
+    wg_parser_stream_get_codec_format(reader->streams[index].wg_stream, &codec_format);
+    format = (codec_format.major_type != WG_MAJOR_TYPE_UNKNOWN) ? &codec_format : &reader->streams[index].format;
+    if (!amt_from_wg_format(&mt, format, true))
+    {
+        LeaveCriticalSection(&reader->cs);
+        return E_OUTOFMEMORY;
+    }
+    LeaveCriticalSection(&reader->cs);
+
+    /* The codec is named by its identifier: the FOURCC of a video stream, the
+     * format tag of an audio stream (that is also the codec information). */
+    if (IsEqualGUID(&mt.majortype, &MEDIATYPE_Video) && mt.cbFormat >= sizeof(VIDEOINFOHEADER))
+    {
+        DWORD fourcc = ((VIDEOINFOHEADER *)mt.pbFormat)->bmiHeader.biCompression;
+        codec_type = WMT_CODECINFO_VIDEO;
+        memcpy(info_buf, &fourcc, sizeof(fourcc));
+        info_size = sizeof(fourcc);
+        if (fourcc > 0xff)
+            swprintf(name_buf, ARRAY_SIZE(name_buf), L"%c%c%c%c", (char)fourcc, (char)(fourcc >> 8),
+                    (char)(fourcc >> 16), (char)(fourcc >> 24));
+        else
+            wcscpy(name_buf, L"Video");
+    }
+    else if (IsEqualGUID(&mt.majortype, &MEDIATYPE_Audio) && mt.cbFormat >= sizeof(WAVEFORMATEX))
+    {
+        WORD tag = ((WAVEFORMATEX *)mt.pbFormat)->wFormatTag;
+        codec_type = WMT_CODECINFO_AUDIO;
+        memcpy(info_buf, &tag, sizeof(tag));
+        info_size = sizeof(tag);
+        swprintf(name_buf, ARRAY_SIZE(name_buf), L"Audio format %#06x", tag);
+    }
+    else
+    {
+        codec_type = WMT_CODECINFO_UNKNOWN;
+        info_size = 0;
+        wcscpy(name_buf, L"Unknown");
+    }
+    FreeMediaType(&mt);
+#ifdef SG_MUTANT_CODECTYPE
+    if (codec_type != WMT_CODECINFO_UNKNOWN)
+        codec_type = !codec_type;
+#endif
+
+    req_name_len = *name_len;
+    req_desc_len = *desc_len;
+    req_size = *size;
+    name_size = wcslen(name_buf) + 1;
+    *name_len = name_size;
+    *desc_len = ARRAY_SIZE(desc_buf);
+    *size = info_size;
+
+    if ((name && req_name_len < name_size) || (desc && req_desc_len < ARRAY_SIZE(desc_buf))
+            || (info && req_size < info_size))
+        return ASF_E_BUFFERTOOSMALL;
+
+    if (name)
+        memcpy(name, name_buf, name_size * sizeof(WCHAR));
+    if (desc)
+        memcpy(desc, desc_buf, sizeof(desc_buf));
+    if (type)
+        *type = codec_type;
+    if (info)
+        memcpy(info, info_buf, info_size);
+    return S_OK;
 }
 
