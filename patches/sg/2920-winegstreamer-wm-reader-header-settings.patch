+
+/* What a reader's header exposes: the file's attributes (stream number 0) and
+ * none on the individual streams. The attribute list is the one the parser can
+ * answer from; a reader's header is read-only. */
+static const struct file_attr
+{
+    const WCHAR *name;
+    WMT_ATTR_DATATYPE type;
+}
+file_attrs[] =
+{
+    {L"Duration", WMT_TYPE_QWORD},
+    {L"Seekable", WMT_TYPE_BOOL},
+};
+
+static WORD header_attr_count(WORD stream_number)
+{
+    return stream_number ? 0 : ARRAY_SIZE(file_attrs);
+}
+
+static DWORD header_attr_size(WMT_ATTR_DATATYPE type)
+{
+    return type == WMT_TYPE_QWORD ? sizeof(QWORD) : sizeof(BOOL);
+}
+
+static HRESULT header_read_attr(struct wm_reader *reader, WORD index, WCHAR *name, WORD *name_len,
+        WMT_ATTR_DATATYPE *type, BYTE *value, DWORD *size)
+{
+    const struct file_attr *attr;
+    DWORD name_size, value_size;
+    WORD req_name_len;
+    DWORD req_size;
+
+    if (!name_len || !size)
+        return E_INVALIDARG;
+    if (!reader->wg_parser)
+        return E_UNEXPECTED;
+    if (index >= ARRAY_SIZE(file_attrs))
+        return E_INVALIDARG;
+
+    attr = &file_attrs[index];
+    name_size = wcslen(attr->name) + 1;
+    value_size = header_attr_size(attr->type);
+    req_name_len = *name_len;
+    req_size = *size;
+    *name_len = name_size;
+    *size = value_size;
+
+    if (name && req_name_len < name_size)
+        return ASF_E_BUFFERTOOSMALL;
+    if (value && req_size < value_size)
+        return ASF_E_BUFFERTOOSMALL;
+
+    if (type)
+        *type = attr->type;
+    if (name)
+        memcpy(name, attr->name, name_size * sizeof(WCHAR));
+    if (value)
+    {
+        if (attr->type == WMT_TYPE_QWORD)
+        {
+            QWORD duration;
+
+            EnterCriticalSection(&reader->cs);
+            duration = wg_parser_stream_get_duration(wg_parser_get_stream(reader->wg_parser, 0));
+            LeaveCriticalSection(&reader->cs);
+            memcpy(value, &duration, sizeof(duration));
+        }
+        else
+        {
+            BOOL seekable = TRUE;
+            memcpy(value, &seekable, sizeof(seekable));
+        }
+    }
+    return S_OK;
+}
