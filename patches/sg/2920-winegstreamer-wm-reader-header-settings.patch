+#define READER_PACKET_SIZE 3200
 
 /* The Windows Media Format SDK string getters: a NULL buffer returns the
  * length needed, in characters including the terminator; a short buffer
@@ -2161,13 +2164,13 @@ static HRESULT WINAPI profile_GetExpectedPacketCount(IWMProfile3 *iface, QWORD d
         return E_INVALIDARG;
 
     /* The bytes the streams' bitrates produce over the duration, in packets
-     * of the 3200 bytes that are the usual packet size of a file. */
+     * of the READER_PACKET_SIZE bytes that are the usual packet size of a file. */
     EnterCriticalSection(&reader->cs);
     for (i = 0; (attrs = profile_entry(reader, i, &number, &stream, &extra)); ++i)
         bytes += attrs->bitrate / 8.0 * (duration / 10000000.0);
     LeaveCriticalSection(&reader->cs);
 
-    *count = (QWORD)ceil(bytes / 3200.0);
+    *count = (QWORD)ceil(bytes / READER_PACKET_SIZE);
     return S_OK;
 }
 
