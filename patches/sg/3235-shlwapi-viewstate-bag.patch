From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:26:08 -0700
Subject: [PATCH] shlwapi: SHGetViewStatePropertyBag (3235)

Registry-backed view state bags (per folder, all folders, inherit; per user
or all users) with the documented defaults search. CORE review: shlwapi is
used everywhere, but this export had returned E_NOTIMPL, so nothing that
worked before changes.

diff --git a/dlls/shlwapi/ordinal.c b/dlls/shlwapi/ordinal.c
index c8db793..d62cf5d 100644
--- a/dlls/shlwapi/ordinal.c
+++ b/dlls/shlwapi/ordinal.c
@@ -4472,6 +4472,217 @@ static const IPropertyBagVtbl reg_bag_vtbl =
     reg_bag_Write,
 };
 
+/***********************************************************************
+ *             SHGetViewStatePropertyBag [SHLWAPI.515]
+ *
+ * Property bag for the view state of a folder (see the MSDN page).  The bags live in the registry
+ * under Software\Microsoft\Windows\Shell\ViewState (HKCU for SHGVSPB_PERUSER, HKLM for ALLUSERS):
+ * Folders\<id of the pidl>\<bag name>, AllFolders\<bag name> and Inherit\<id>\<bag name>.  The layout
+ * is our own (GUESS: Windows' is not documented, so the data is not shared with it).  When a folder
+ * bag does not hold a value, the Inherit bags of the ancestors, then the user defaults, then the
+ * global defaults answer (unless SHGVSPB_NOAUTODEFAULTS).
+ */
+struct view_bag
+{
+    IPropertyBag IPropertyBag_iface;
+    LONG ref;
+    IPropertyBag *bags[8];   /* [0] is the bag of the request and takes the writes */
+    unsigned int count;
+};
+
+static inline struct view_bag *impl_from_view_bag(IPropertyBag *iface)
+{
+    return CONTAINING_RECORD(iface, struct view_bag, IPropertyBag_iface);
+}
+
+static HRESULT WINAPI view_bag_QueryInterface(IPropertyBag *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IPropertyBag))
+    {
+        *out = iface;
+        IPropertyBag_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI view_bag_AddRef(IPropertyBag *iface)
+{
+    return InterlockedIncrement(&impl_from_view_bag(iface)->ref);
+}
+
+static ULONG WINAPI view_bag_Release(IPropertyBag *iface)
+{
+    struct view_bag *bag = impl_from_view_bag(iface);
+    ULONG ref = InterlockedDecrement(&bag->ref);
+    unsigned int i;
+
+    if (!ref)
+    {
+        for (i = 0; i < bag->count; i++) IPropertyBag_Release(bag->bags[i]);
+        free(bag);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI view_bag_Read(IPropertyBag *iface, const WCHAR *name, VARIANT *var, IErrorLog *log)
+{
+    struct view_bag *bag = impl_from_view_bag(iface);
+    HRESULT hr = E_FAIL, first = S_OK;
+    unsigned int i;
+
+    TRACE("(%p)->(%s, %p, %p)\n", bag, debugstr_w(name), var, log);
+
+    for (i = 0; i < bag->count; i++)
+    {
+        VARTYPE vt = var ? V_VT(var) : VT_EMPTY;
+
+        hr = IPropertyBag_Read(bag->bags[i], name, var, log);
+        if (SUCCEEDED(hr)) return hr;
+        if (!i) first = hr;
+        if (var) V_VT(var) = vt;
+        if (hr == E_POINTER) break;
+    }
+    return first;
+}
+
+static HRESULT WINAPI view_bag_Write(IPropertyBag *iface, const WCHAR *name, VARIANT *var)
+{
+    struct view_bag *bag = impl_from_view_bag(iface);
+
+    TRACE("(%p)->(%s, %p)\n", bag, debugstr_w(name), var);
+#ifdef SG_MUTANT_VIEWBAG_WRITE
+    return IPropertyBag_Write(bag->bags[bag->count - 1], name, var);
+#endif
+    return IPropertyBag_Write(bag->bags[0], name, var);
+}
+
+static const IPropertyBagVtbl view_bag_vtbl =
+{
+    view_bag_QueryInterface,
+    view_bag_AddRef,
+    view_bag_Release,
+    view_bag_Read,
+    view_bag_Write,
+};
+
+HRESULT WINAPI SHCreatePropertyBagOnRegKey(HKEY hKey, LPCWSTR subkey, DWORD grfMode, REFIID riid, void **ppv);
+
+/* a name for the first "levels" items of the pidl */
+static void view_pidl_id(const ITEMIDLIST *pidl, int levels, WCHAR id[17])
+{
+    const BYTE *p = (const BYTE *)pidl;
+    ULONGLONG hash = 14695981039346656037ULL;   /* FNV-1a */
+    int i;
+
+#ifdef SG_MUTANT_VIEWBAG_SAMEID
+    levels = 0;
+#endif
+    for (i = 0; p && i < levels && *(const USHORT *)p; i++)
+    {
+        USHORT cb = *(const USHORT *)p;
+        USHORT n;
+
+        for (n = 0; n < cb; n++) { hash ^= p[n]; hash *= 1099511628211ULL; }
+        p += cb;
+    }
+    swprintf(id, 17, L"%08x%08x", (unsigned int)(hash >> 32), (unsigned int)hash);
+}
+
+static int view_pidl_levels(const ITEMIDLIST *pidl)
+{
+    const BYTE *p = (const BYTE *)pidl;
+    int n = 0;
+
+    while (p && *(const USHORT *)p) { p += *(const USHORT *)p; n++; }
+    return n;
+}
+
+static HRESULT view_open_bag(HKEY root, const WCHAR *path, BOOL writable, IPropertyBag **bag)
+{
+    return SHCreatePropertyBagOnRegKey(root, path, writable ? STGM_READWRITE | STGM_CREATE : STGM_READ,
+                                       &IID_IPropertyBag, (void **)bag);
+}
+
+HRESULT WINAPI SHGetViewStatePropertyBag(PCIDLIST_ABSOLUTE pidl, PCWSTR bag_name, DWORD flags, REFIID riid, void **ppv)
+{
+    static const WCHAR base[] = L"Software\\Microsoft\\Windows\\Shell\\ViewState";
+    DWORD user = flags & (SHGVSPB_PERUSER | SHGVSPB_ALLUSERS);
+    DWORD scope = flags & (SHGVSPB_PERFOLDER | SHGVSPB_ALLFOLDERS | SHGVSPB_INHERIT);
+    struct view_bag *bag;
+    WCHAR path[MAX_PATH + 64], id[17];
+    const WCHAR *name = bag_name ? bag_name : L"";
+    HKEY root;
+    HRESULT hr;
+    int levels, i;
+
+    TRACE("%p, %s, %#lx, %s, %p\n", pidl, debugstr_w(bag_name), flags, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!IsEqualIID(riid, &IID_IUnknown) && !IsEqualIID(riid, &IID_IPropertyBag)) return E_NOINTERFACE;
+#ifndef SG_MUTANT_VIEWBAG_USER
+    if (user != SHGVSPB_PERUSER && user != SHGVSPB_ALLUSERS) return E_INVALIDARG;
+#endif
+    if (scope != SHGVSPB_PERFOLDER && scope != SHGVSPB_ALLFOLDERS && scope != SHGVSPB_INHERIT) return E_INVALIDARG;
+#ifndef SG_MUTANT_VIEWBAG_ALLPIDL
+    if (scope == SHGVSPB_ALLFOLDERS && (pidl || (flags & SHGVSPB_ROAM))) return E_INVALIDARG;
+#endif
+    if (scope != SHGVSPB_ALLFOLDERS && !pidl) return E_INVALIDARG;
+    if (wcslen(name) > MAX_PATH - 8) return E_INVALIDARG;
+
+    if (!(bag = calloc(1, sizeof(*bag)))) return E_OUTOFMEMORY;
+    bag->IPropertyBag_iface.lpVtbl = &view_bag_vtbl;
+    bag->ref = 1;
+
+    levels = view_pidl_levels(pidl);
+    view_pidl_id(pidl, levels, id);
+#ifdef SG_MUTANT_VIEWBAG_ROOT
+    root = HKEY_CURRENT_USER;
+#else
+    root = user == SHGVSPB_ALLUSERS ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER;
+#endif
+    if (scope == SHGVSPB_ALLFOLDERS) swprintf(path, ARRAY_SIZE(path), L"%ls\\AllFolders\\%ls", base, name);
+    else swprintf(path, ARRAY_SIZE(path), L"%ls\\%ls\\%ls\\%ls", base, scope == SHGVSPB_INHERIT ? L"Inherit" : L"Folders", id, name);
+
+    hr = view_open_bag(root, path, TRUE, &bag->bags[0]);
+    if (FAILED(hr) && user == SHGVSPB_ALLUSERS)
+        hr = view_open_bag(root, path, FALSE, &bag->bags[0]);   /* shared settings may be read-only */
+    if (FAILED(hr))
+    {
+        free(bag);
+        return hr;
+    }
+    bag->count = 1;
+
+#ifdef SG_MUTANT_VIEWBAG_NOAUTO
+    if (scope == SHGVSPB_PERFOLDER)
+#else
+    if (scope == SHGVSPB_PERFOLDER && !(flags & SHGVSPB_NOAUTODEFAULTS))
+#endif
+    {
+        /* defaults: the Inherit bags of the ancestors (nearest first), the user defaults, the global defaults */
+#ifdef SG_MUTANT_VIEWBAG_NOINHERIT
+        levels = 0;
+#endif
+        for (i = levels - 1; i >= 0 && bag->count < ARRAY_SIZE(bag->bags) - 2; i--)
+        {
+            view_pidl_id(pidl, i, id);
+            swprintf(path, ARRAY_SIZE(path), L"%ls\\Inherit\\%ls\\%ls", base, id, name);
+            if (SUCCEEDED(view_open_bag(HKEY_CURRENT_USER, path, FALSE, &bag->bags[bag->count]))) bag->count++;
+            if (bag->count < ARRAY_SIZE(bag->bags) - 2 &&
+                SUCCEEDED(view_open_bag(HKEY_LOCAL_MACHINE, path, FALSE, &bag->bags[bag->count]))) bag->count++;
+        }
+        swprintf(path, ARRAY_SIZE(path), L"%ls\\AllFolders\\%ls", base, name);
+        if (SUCCEEDED(view_open_bag(HKEY_CURRENT_USER, path, FALSE, &bag->bags[bag->count]))) bag->count++;
+        if (SUCCEEDED(view_open_bag(HKEY_LOCAL_MACHINE, path, FALSE, &bag->bags[bag->count]))) bag->count++;
+    }
+
+    *ppv = &bag->IPropertyBag_iface;
+    return S_OK;
+}
+
 /***********************************************************************
  *             SHCreatePropertyBagOnRegKey [SHLWAPI.471]
  *
diff --git a/dlls/shlwapi/shlwapi_main.c b/dlls/shlwapi/shlwapi_main.c
index ea45bdf..abacf66 100644
--- a/dlls/shlwapi/shlwapi_main.c
+++ b/dlls/shlwapi/shlwapi_main.c
@@ -263,16 +263,6 @@ UINT WINAPI WhichPlatform(void)
     return state;
 }
 
-/***********************************************************************
- *             SHGetViewStatePropertyBag [SHLWAPI.515]
- */
-HRESULT WINAPI SHGetViewStatePropertyBag(PCIDLIST_ABSOLUTE pidl, PCWSTR bag_name, DWORD flags, REFIID riid, void **ppv)
-{
-    FIXME("%p, %s, %#lx, %s, %p stub.\n", pidl, debugstr_w(bag_name), flags, debugstr_guid(riid), ppv);
-
-    return E_NOTIMPL;
-}
-
