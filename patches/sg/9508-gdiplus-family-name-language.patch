From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: GdipGetFamilyName gives the name in the language asked for

GdipGetFamilyName ignored its language ('No support for handling of multiple languages!', NAPS2 in the 2026-11-21 census): the family's name in the user's language came back whatever was asked. The name table of the family's font is now read (GetFontData) for the family name (name ID 1) of the Windows platform in that language; LANG_NEUTRAL, and a language the font does not name its family in, give the family's own name as before.
---
--- a/dlls/gdiplus/font.c
+++ b/dlls/gdiplus/font.c
@@ -807,11 +807,56 @@
  * NOTES
  *   If name is NULL, XP and Vista crash but not Windows 7+
  */
+/* wine-sg 9508: the family name (name ID 1) of the font in the name table for the Windows platform, Unicode
+ * BMP, in LANGUAGE; FALSE when it has none in that language */
+static BOOL get_localized_family_name(const GpFontFamily *family, LANGID language, WCHAR *name)
+{
+    static const DWORD name_tag = 0x656d616e; /* 'name' */
+    LOGFONTW lf = {0};
+    HFONT hfont, old;
+    HDC hdc;
+    BYTE *data = NULL;
+    DWORD size;
+    BOOL ret = FALSE;
+
+    lf.lfHeight = -12;
+    lf.lfCharSet = DEFAULT_CHARSET;
+    lstrcpynW(lf.lfFaceName, family->FamilyName, LF_FACESIZE);
+    if (!(hdc = CreateCompatibleDC(0))) return FALSE;
+    hfont = CreateFontIndirectW(&lf);
+    old = SelectObject(hdc, hfont);
+    size = GetFontData(hdc, name_tag, 0, NULL, 0);
+    if (size != GDI_ERROR && size >= 6 && (data = malloc(size)) && GetFontData(hdc, name_tag, 0, data, size) == size)
+    {
+        UINT count = (data[2] << 8) | data[3], strings = (data[4] << 8) | data[5], i;
+
+        for (i = 0; i < count && 6 + (i + 1) * 12 <= size; i++)
+        {
+            const BYTE *rec = data + 6 + i * 12;
+            UINT platform = (rec[0] << 8) | rec[1], encoding = (rec[2] << 8) | rec[3];
+            UINT lang = (rec[4] << 8) | rec[5], id = (rec[6] << 8) | rec[7];
+            UINT len = (rec[8] << 8) | rec[9], offset = (rec[10] << 8) | rec[11], j;
+
+            if (platform != 3 || encoding != 1 || id != 1 || lang != language) continue;
+            if (strings + offset > size || len > size - strings - offset) continue;
+            len = min(len / 2, LF_FACESIZE - 1);
+            for (j = 0; j < len; j++)
+                name[j] = (data[strings + offset + j * 2] << 8) | data[strings + offset + j * 2 + 1];
+            name[len] = 0;
+            ret = len != 0;
+            break;
+        }
+    }
+    free(data);
+    SelectObject(hdc, old);
+    DeleteObject(hfont);
+    DeleteDC(hdc);
+    return ret;
+}
+
 GpStatus WINGDIPAPI GdipGetFamilyName (GDIPCONST GpFontFamily *family,
                                        WCHAR *name, LANGID language)
 {
-    static int lang_fixme;
-
     TRACE("%p, %p, %d\n", family, name, language);
 
     if (family == NULL)
@@ -820,8 +865,12 @@
     if (name == NULL)
          return Ok;
 
-    if (language != LANG_NEUTRAL && !lang_fixme++)
-        FIXME("No support for handling of multiple languages!\n");
+    /* wine-sg 9508: the name in the language asked for (LANG_NEUTRAL: the user's language, as the family's
+     * own name already is) when the font has one, else the family's name */
+#ifndef SG_MUTANT_GDIP_FAMILY_NAME_LANG
+    if (language != LANG_NEUTRAL && get_localized_family_name(family, language, name))
+        return Ok;
+#endif
 
     lstrcpynW (name, family->FamilyName, LF_FACESIZE);
 
