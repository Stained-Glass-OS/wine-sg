+#include "prsht.h"
+#include "ddk/compstui.h"
+#include "psdrv.h"
+#include "../unidrvui/drvui.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(psdrv);
+
+/* the features wineps keeps in the public devmode, by its own tables */
+enum { PSF_PAGESIZE = 1, PSF_INPUTSLOT, PSF_DUPLEX, PSF_ORIENTATION, PSF_RESOLUTION };
+
+struct ps_feature_ref
+{
+    int          kind;      /* PSF_*, or 0 for a PPD feature of the generic list */
+    PPD_FEATURE *feature;
+};
+
+struct ps_ui
+{
+    struct drvui ui;
+    PRINTERINFO *pi;
+    PSDRV_DEVMODE *dm;
+    DOCUMENTPROPERTYHEADERW *dph;
+    DEVICEPROPERTYHEADER *devh;
+    struct ps_feature_ref *refs;
+};
+
+static UINT ppd_cp = CP_ACP;
+
+static WCHAR *dup_a( struct drvui *ui, const char *str )
+{
+    WCHAR buf[256];
+    MultiByteToWideChar( ppd_cp, 0, str ? str : "", -1, buf, ARRAY_SIZE(buf) );
+    return drvui_strdup( ui, buf );
+}
+
+static WCHAR *cpsui_text( struct drvui *ui, UINT id, const char *fallback )
+{
+    WCHAR buf[256];
+    if (LoadStringW( GetModuleHandleW( L"compstui.dll" ), id, buf, ARRAY_SIZE(buf) )) return drvui_strdup( ui, buf );
+    return dup_a( ui, fallback );
+}
+
+static struct drvui_feature *add_feature( struct ps_ui *pu, int kind, PPD_FEATURE *f, const char *name, WCHAR *text,
+                                          BYTE dmpub, unsigned int count )
+{
+    struct drvui_feature *df = &pu->ui.features[pu->ui.feature_count];
+    pu->refs[pu->ui.feature_count].kind = kind;
+    pu->refs[pu->ui.feature_count].feature = f;
+    pu->ui.feature_count++;
+    df->name = drvui_strdupA( &pu->ui, name );
+    df->text = text;
+    df->dmpub = dmpub;
+    df->options = drvui_alloc( &pu->ui, max( 1, count ) * sizeof(*df->options) );
+    df->sel = -1;
+    return df;
+}
+
+static void ps_fill_features( struct ps_ui *pu )
+{
+    PPD *ppd = pu->pi->ppd;
+    struct drvui *ui = &pu->ui;
+    struct drvui_feature *df;
+    PAGESIZE *page, *cur_page;
+    INPUTSLOT *slot, *cur_slot;
+    DUPLEX *duplex, *cur_duplex;
+    RESOLUTION *res;
+    PPD_FEATURE *f, *color = features_color( ppd );
+    unsigned int count = 5, n;
+
+    ppd_cp = ppd->codepage ? ppd->codepage : CP_ACP;
+    LIST_FOR_EACH_ENTRY( f, &ppd->Features, PPD_FEATURE, entry ) count++;
+    ui->features = drvui_alloc( ui, count * sizeof(*ui->features) );
+    pu->refs = drvui_alloc( ui, count * sizeof(*pu->refs) );
+    if (!ui->features || !pu->refs) return;
+
+    n = list_count( &ppd->PageSizes );
+    if (n && (df = add_feature( pu, PSF_PAGESIZE, NULL, "PageSize", cpsui_text( ui, IDS_CPSUI_FORMNAME, "PageSize" ),
+                                DMPUB_FORMNAME, n )))
+    {
+        cur_page = find_pagesize( ppd, &pu->dm->dmPublic );
+        LIST_FOR_EACH_ENTRY( page, &ppd->PageSizes, PAGESIZE, entry )
+        {
+            if (page == cur_page) df->sel = df->count;
+            df->options[df->count].name = drvui_strdupA( ui, page->Name );
+            df->options[df->count++].text = drvui_strdup( ui, page->FullName );
+        }
+    }
+    n = 0;
+    LIST_FOR_EACH_ENTRY( slot, &ppd->InputSlots, INPUTSLOT, entry ) if (slot->InvocationString) n++;
+    if (n && (df = add_feature( pu, PSF_INPUTSLOT, NULL, "InputSlot", cpsui_text( ui, IDS_CPSUI_SOURCE, "InputSlot" ),
+                                DMPUB_DEFSOURCE, n )))
+    {
+        cur_slot = find_slot( ppd, &pu->dm->dmPublic );
+        LIST_FOR_EACH_ENTRY( slot, &ppd->InputSlots, INPUTSLOT, entry )
+        {
+            if (!slot->InvocationString) continue;
+            if (slot == cur_slot) df->sel = df->count;
+            df->options[df->count].name = drvui_strdupA( ui, slot->Name );
+            df->options[df->count++].text = dup_a( ui, slot->FullName ? slot->FullName : slot->Name );
+        }
+    }
+    n = list_count( &ppd->Duplexes );
+    if (n && (df = add_feature( pu, PSF_DUPLEX, NULL, "Duplex", cpsui_text( ui, IDS_CPSUI_DUPLEX, "Duplex" ),
+                                DMPUB_DUPLEX, n )))
+    {
+        cur_duplex = find_duplex( ppd, &pu->dm->dmPublic );
+        LIST_FOR_EACH_ENTRY( duplex, &ppd->Duplexes, DUPLEX, entry )
+        {
+            if (duplex == cur_duplex) df->sel = df->count;
+            df->options[df->count].name = drvui_strdupA( ui, duplex->Name );
+            df->options[df->count++].text = dup_a( ui, duplex->FullName ? duplex->FullName : duplex->Name );
+        }
+    }
+    if ((df = add_feature( pu, PSF_ORIENTATION, NULL, "Orientation",
+                           cpsui_text( ui, IDS_CPSUI_ORIENTATION, "Orientation" ), DMPUB_ORIENTATION, 2 )))
+    {
+        df->options[0].name = drvui_strdupA( ui, "Portrait" );
+        df->options[0].text = cpsui_text( ui, IDS_CPSUI_PORTRAIT, "Portrait" );
+        df->options[1].name = drvui_strdupA( ui, "Landscape" );
+        df->options[1].text = cpsui_text( ui, IDS_CPSUI_LANDSCAPE, "Landscape" );
+        df->count = 2;
+        df->sel = pu->dm->dmPublic.dmOrientation == DMORIENT_LANDSCAPE ? 1 : 0;
+    }
+    /* the resolutions wineps knows, when the PPD has no Resolution option of its own */
+    n = list_count( &ppd->Resolutions );
+    if (n > 1 && !ppd_find_feature( ppd, "Resolution" ) &&
+        (df = add_feature( pu, PSF_RESOLUTION, NULL, "Resolution",
+                           cpsui_text( ui, IDS_CPSUI_RESOLUTION, "Resolution" ), DMPUB_PRINTQUALITY, n )))
+    {
+        LIST_FOR_EACH_ENTRY( res, &ppd->Resolutions, RESOLUTION, entry )
+        {
+            char name[32];
+            WCHAR text[32];
+            if (res->resx == res->resy) sprintf( name, "%ddpi", res->resx );
+            else sprintf( name, "%dx%ddpi", res->resx, res->resy );
+            if (res->resx == pu->dm->dmPublic.dmPrintQuality) df->sel = df->count;
+            swprintf( text, ARRAY_SIZE(text), L"%S", name );
+            df->options[df->count].name = drvui_strdupA( ui, name );
+            df->options[df->count++].text = drvui_strdup( ui, text );
+        }
+    }
+    LIST_FOR_EACH_ENTRY( f, &ppd->Features, PPD_FEATURE, entry )
+    {
+        BYTE dmpub = 0;
+        int i;
+
+        if (f == color) dmpub = DMPUB_COLOR;
+        else if (!strcmp( f->keyword, "Resolution" )) dmpub = DMPUB_PRINTQUALITY;
+        else if (!strcmp( f->keyword, "MediaType" )) dmpub = DMPUB_MEDIATYPE;
+        else if (!strcmp( f->keyword, "OutputBin" )) dmpub = DMPUB_OUTPUTBIN;
+        if (!(df = add_feature( pu, 0, f, f->keyword, drvui_strdup( ui, f->text ), dmpub, f->count ))) continue;
+        df->printer = f->group && !strncmp( f->group, "InstallableOptions", 18 );
+        for (i = 0; i < f->count; i++)
+        {
+            df->options[i].name = drvui_strdupA( ui, f->options[i].name );
+            df->options[i].text = drvui_strdup( ui, f->options[i].text );
+        }
+        df->count = f->count;
+        df->sel = features_selected( pu->pi, pu->dm, f );
+    }
+}
+
+static void ps_apply( struct drvui *ui )
+{
+    struct ps_ui *pu = CONTAINING_RECORD( ui, struct ps_ui, ui );
+    PSDRV_DEVMODE *dm = pu->dm;
+    PPD *ppd = pu->pi->ppd;
+    unsigned int i;
+    int n;
+
+    for (i = 0; i < ui->feature_count; i++)
+    {
+        struct drvui_feature *df = &ui->features[i];
+        int sel = df->sel;
+
+        if (sel < 0 || sel >= df->count) continue;
+        switch (pu->refs[i].kind)
+        {
+        case PSF_PAGESIZE:
+        {
+            PAGESIZE *page;
+            n = 0;
+            LIST_FOR_EACH_ENTRY( page, &ppd->PageSizes, PAGESIZE, entry )
+            {
+                if (n++ != sel) continue;
+                dm->dmPublic.dmPaperSize = page->WinPage;
+                dm->dmPublic.dmPaperWidth = paper_size_from_points( page->PaperDimension->x );
+                dm->dmPublic.dmPaperLength = paper_size_from_points( page->PaperDimension->y );
+                lstrcpynW( dm->dmPublic.dmFormName, page->FullName, CCHFORMNAME );
+                dm->dmPublic.dmFields |= DM_PAPERSIZE | DM_PAPERWIDTH | DM_PAPERLENGTH | DM_FORMNAME;
+                break;
+            }
+            break;
+        }
+        case PSF_INPUTSLOT:
+        {
+            INPUTSLOT *slot;
+            n = 0;
+            LIST_FOR_EACH_ENTRY( slot, &ppd->InputSlots, INPUTSLOT, entry )
+            {
+                if (!slot->InvocationString || n++ != sel) continue;
+                dm->dmPublic.dmDefaultSource = slot->WinBin;
+                dm->dmPublic.dmFields |= DM_DEFAULTSOURCE;
+                break;
+            }
+            break;
+        }
+        case PSF_DUPLEX:
+        {
+            DUPLEX *duplex;
+            n = 0;
+            LIST_FOR_EACH_ENTRY( duplex, &ppd->Duplexes, DUPLEX, entry )
+            {
+                if (n++ != sel) continue;
+                dm->dmPublic.dmDuplex = duplex->WinDuplex;
+                dm->dmPublic.dmFields |= DM_DUPLEX;
+                break;
+            }
+            break;
+        }
+        case PSF_ORIENTATION:
+            dm->dmPublic.dmOrientation = sel ? DMORIENT_LANDSCAPE : DMORIENT_PORTRAIT;
+            dm->dmPublic.dmFields |= DM_ORIENTATION;
+            break;
+        case PSF_RESOLUTION:
+        {
+            RESOLUTION *res;
+            n = 0;
+            LIST_FOR_EACH_ENTRY( res, &ppd->Resolutions, RESOLUTION, entry )
+            {
+                if (n++ != sel) continue;
+                dm->dmPublic.dmPrintQuality = res->resx;
+                dm->dmPublic.dmYResolution = res->resy;
+                dm->dmPublic.dmFields |= DM_PRINTQUALITY | DM_YRESOLUTION;
+                break;
+            }
+            break;
+        }
+        default:
+            features_select( dm, pu->refs[i].feature, sel );
+            break;
+        }
+    }
+    features_to_public( pu->pi, dm );
+    dm->dmPublic.dmCopies = max( 1, ui->copies );
+    dm->dmPublic.dmFields |= DM_COPIES;
+
+    /* what the driver keeps for the printer, and what the program gets */
+    memcpy( pu->pi->Devmode, dm, dm->dmPublic.dmSize + dm->dmPublic.dmDriverExtra );
+    if (pu->dph && pu->dph->pdmOut && (pu->dph->fMode & (DM_COPY | DM_UPDATE)))
+        memcpy( pu->dph->pdmOut, dm, dm->dmPublic.dmSize + dm->dmPublic.dmDriverExtra );
+    TRACE( "applied: paper %d, orientation %d, copies %d\n", dm->dmPublic.dmPaperSize, dm->dmPublic.dmOrientation,
+           dm->dmPublic.dmCopies );
+}
+
+static const struct drvui_funcs ps_funcs = { ps_apply };
+
+void ps_ui_free( void *ptr )
+{
+    struct ps_ui *pu = ptr;
+    if (!pu) return;
+    drvui_free( &pu->ui );
+    free( pu->dm );
+    free( pu );
+}
+
+/* a sheet's pages: at PROPSHEETUI_REASON_INIT */
+LONG ps_ui_sheets( PROPSHEETUI_INFO *info, PRINTERINFO *pi, DOCUMENTPROPERTYHEADERW *dph,
+                   DEVICEPROPERTYHEADER *devh )
+{
+    struct ps_ui *pu = calloc( 1, sizeof(*pu) );
+    DWORD size = pi->Devmode->dmPublic.dmSize + pi->Devmode->dmPublic.dmDriverExtra;
+    const WCHAR *name = dph ? dph->pszPrinterName : devh->pszPrinterName;
+
+    if (!pu || !(pu->dm = malloc( size )))
+    {
+        free( pu );
+        return ERR_CPSUI_ALLOCMEM_FAILED;
+    }
+    memcpy( pu->dm, pi->Devmode, size );
+    if (dph && (dph->fMode & (DM_IN_BUFFER | DM_MODIFY)) && dph->pdmIn) PSDRV_MergeDevmodes( pu->dm, dph->pdmIn, pi );
+    pu->pi = pi;
+    pu->dph = dph;
+    pu->devh = devh;
+    pu->ui.funcs = &ps_funcs;
+    pu->ui.device = !dph;
+    pu->ui.mode = dph ? dph->fMode : devh->Flags;
+    pu->ui.printer = dph ? dph->hPrinter : devh->hPrinter;
+    pu->ui.dm = &pu->dm->dmPublic;
+    pu->ui.copies = max( 1, pu->dm->dmPublic.dmCopies );
+    pu->ui.max_copies = 999;
+    lstrcpynW( pu->ui.printer_name, name, ARRAY_SIZE(pu->ui.printer_name) );
+    MultiByteToWideChar( pi->ppd->codepage ? pi->ppd->codepage : CP_ACP, 0, pi->ppd->NickName ? pi->ppd->NickName : "", -1, pu->ui.model,
+                         ARRAY_SIZE(pu->ui.model) );
+    if (!pu->ui.model[0]) lstrcpynW( pu->ui.model, name, ARRAY_SIZE(pu->ui.model) );
+    wcscpy( pu->ui.caller, L"PostScript Driver" );
+    ps_fill_features( pu );
+    if (dph && (dph->fMode & (DM_COPY | DM_UPDATE)) && dph->pdmOut) memcpy( dph->pdmOut, pu->dm, size );
+    info->UserData = (ULONG_PTR)pu;
+    return drvui_add_pages( &pu->ui, info );
+}
