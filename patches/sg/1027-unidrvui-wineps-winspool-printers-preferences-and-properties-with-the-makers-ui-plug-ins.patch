+/* what PrinterProperties hands the driver */
+typedef struct
+{
+    WORD    cbSize;
+    WORD    Flags;
+    HANDLE  hPrinter;
+    LPWSTR  pszPrinterName;
+} DEVICEPROPERTYHEADER;
+
+/* a sheet of ours: the GPD's features as options (drvui.c) */
+struct uni_ui
+{
+    struct drvui ui;
+    struct config cfg;
+    DOCUMENTPROPERTYHEADERW *dph;
+    DEVICEPROPERTYHEADER *devh;
+    gpd_sel sel[UNIDRV_MAX_FEATURES];
+    FORM_INFO_1W *forms;    /* the system's papers, in DMPAPER order */
+    DWORD form_count;
+};
+
+/* the standard features carry CPSUI's names and settings */
+static const struct { const char *name; BYTE dmpub; UINT text; } standard_features[] =
+{
+    { "PaperSize", DMPUB_FORMNAME, IDS_CPSUI_FORMNAME },
+    { "InputBin", DMPUB_DEFSOURCE, IDS_CPSUI_SOURCE },
+    { "MediaType", DMPUB_MEDIATYPE, IDS_CPSUI_MEDIA },
+    { "Resolution", DMPUB_PRINTQUALITY, IDS_CPSUI_RESOLUTION },
+    { "ColorMode", DMPUB_COLOR, IDS_CPSUI_COLOR_APPERANCE },
+    { "Duplex", DMPUB_DUPLEX, IDS_CPSUI_DUPLEX },
+    { "Orientation", DMPUB_ORIENTATION, IDS_CPSUI_ORIENTATION },
+    { "OutputBin", DMPUB_OUTPUTBIN, IDS_CPSUI_OUTPUTBIN },
+    { "Collate", 0, IDS_CPSUI_COLLATE },
+    { "PageProtect", 0, IDS_CPSUI_PAGEPROTECT },
+    { "Halftone", 0, IDS_CPSUI_HALFTONE },
+    { "Memory", 0, IDS_CPSUI_PRINTERMEM_KB },
+};
+
+static WCHAR *feature_text( struct uni_ui *uu, int f )
+{
+    struct gpd *gpd = uu->cfg.gpd;
+    const char *name = gpd_feature_attr( gpd, f, "Name" ), *id = gpd_feature_attr( gpd, f, "rcNameID" );
+    WCHAR buf[256];
+    unsigned int i;
+    int n;
+
+    for (i = 0; i < ARRAY_SIZE(standard_features); i++)
+    {
+        if (strcmp( gpd->features[f].name, standard_features[i].name )) continue;
+        if (LoadStringW( GetModuleHandleW( L"compstui.dll" ), standard_features[i].text, buf, ARRAY_SIZE(buf) ))
+            return drvui_strdup( &uu->ui, buf );
+    }
+    if (name && name[0] == '"')
+    {
+        char tmp[256];
+        lstrcpynA( tmp, name + 1, sizeof(tmp) );
+        if (strchr( tmp, '"' )) *strchr( tmp, '"' ) = 0;
+        MultiByteToWideChar( CP_ACP, 0, tmp, -1, buf, ARRAY_SIZE(buf) );
+        return drvui_strdup( &uu->ui, buf );
+    }
+    if (id && gpd_int( gpd, id, &n ) && gpd->resources && LoadStringW( gpd->resources, n, buf, ARRAY_SIZE(buf) ))
+        return drvui_strdup( &uu->ui, buf );
+    MultiByteToWideChar( CP_ACP, 0, gpd->features[f].name, -1, buf, ARRAY_SIZE(buf) );
+    return drvui_strdup( &uu->ui, buf );
+}
+
+/* the standard options' names (the GPD names them by Microsoft's resource
+ * IDs, in a DLL we do not have) */
+static const struct { const char *feature, *option; UINT text; } standard_options[] =
+{
+    { "Orientation", "PORTRAIT", IDS_CPSUI_PORTRAIT },
+    { "Orientation", "LANDSCAPE_CC90", IDS_CPSUI_LANDSCAPE },
+    { "Orientation", "LANDSCAPE_CC270", IDS_CPSUI_ROT_LAND },
+    { "Duplex", "NONE", IDS_CPSUI_SIMPLEX },
+    { "Duplex", "VERTICAL", IDS_CPSUI_LONG_SIDE },
+    { "Duplex", "HORIZONTAL", IDS_CPSUI_SHORT_SIDE },
+    { "Collate", "ON", IDS_CPSUI_COLLATED },
+    { NULL, "ON", IDS_CPSUI_ON },
+    { NULL, "OFF", IDS_CPSUI_OFF },
+    { NULL, "NONE", IDS_CPSUI_NONE },
+    { "ColorMode", "Mono", IDS_CPSUI_MONOCHROME },
+    { "ColorMode", "Color", IDS_CPSUI_COLOR },
+    { "InputBin", "AUTO", IDS_CPSUI_AUTOSELECT },
+    { "InputBin", "MANUAL", IDS_CPSUI_MANUAL_TRAY },
+    { "InputBin", "UPPER", IDS_CPSUI_UPPER_TRAY },
+    { "InputBin", "LOWER", IDS_CPSUI_LOWER_TRAY },
+    { "InputBin", "MIDDLE", IDS_CPSUI_MIDDLE_TRAY },
+    { "InputBin", "ENVFEED", IDS_CPSUI_ENVELOPE_TRAY },
+    { "MediaType", "STANDARD", IDS_CPSUI_STANDARD },
+    { "MediaType", "TRANSPARENCY", IDS_CPSUI_TRANSPARENCY },
+    { "MediaType", "GLOSSY", IDS_CPSUI_GLOSSY },
+};
+
+static void option_text( struct uni_ui *uu, int f, unsigned int o, WCHAR *buf, int len )
+{
+    struct gpd *gpd = uu->cfg.gpd;
+    const char *name = gpd_option_attr( gpd, NULL, f, o, "Name" );
+    const char *id = gpd_option_attr( gpd, NULL, f, o, "rcNameID" );
+    const char *feature = gpd->features[f].name, *option = gpd->features[f].options[o].name;
+    unsigned int i;
+    int n;
+
+    if (name || (id && gpd_int( gpd, id, &n ) && gpd->resources && LoadStringW( gpd->resources, n, buf, len )))
+    {
+        gpd_display_name( gpd, f, o, buf, len );
+        return;
+    }
+    if (!strcmp( feature, "PaperSize" ) && uu->forms)
+    {
+        short paper = unidrv_paper_id( gpd, f, o );
+        if (paper > 0 && paper <= (int)uu->form_count)
+        {
+            lstrcpynW( buf, uu->forms[paper - 1].pName, len );
+            return;
+        }
+    }
+    for (i = 0; i < ARRAY_SIZE(standard_options); i++)
+    {
+        if (standard_options[i].feature && strcmp( standard_options[i].feature, feature )) continue;
+        if (strcmp( standard_options[i].option, option )) continue;
+        if (LoadStringW( GetModuleHandleW( L"compstui.dll" ), standard_options[i].text, buf, len )) return;
+    }
+    gpd_display_name( gpd, f, o, buf, len );
+}
+
+static void uni_fill_features( struct uni_ui *uu )
+{
+    struct gpd *gpd = uu->cfg.gpd;
+    struct drvui *ui = &uu->ui;
+    unsigned int f, o, i;
+    WCHAR text[256];
+
+    ui->features = drvui_alloc( ui, max( 1, gpd->feature_count ) * sizeof(*ui->features) );
+    if (!ui->features) return;
+    for (f = 0; f < gpd->feature_count && f < UNIDRV_MAX_FEATURES; f++)
+    {
+        struct drvui_feature *df = &ui->features[ui->feature_count++];
+        const char *conceal = gpd_feature_attr( gpd, f, "ConcealFromUI?" );
+
+        df->name = drvui_strdupA( ui, gpd->features[f].name );
+        df->text = feature_text( uu, f );
+        df->printer = unidrv_printer_feature( gpd, f );
+        df->hidden = conceal && gpd_bool( gpd, conceal, FALSE );
+        for (i = 0; i < ARRAY_SIZE(standard_features); i++)
+            if (!strcmp( gpd->features[f].name, standard_features[i].name )) df->dmpub = standard_features[i].dmpub;
+        df->options = drvui_alloc( ui, max( 1, gpd->features[f].option_count ) * sizeof(*df->options) );
+        if (!df->options) continue;
+        for (o = 0; o < gpd->features[f].option_count; o++)
+        {
+            df->options[o].name = drvui_strdupA( ui, gpd->features[f].options[o].name );
+            option_text( uu, f, o, text, ARRAY_SIZE(text) );
+            df->options[o].text = drvui_strdup( ui, text );
+        }
+        df->count = gpd->features[f].option_count;
+        df->sel = uu->sel[f];
+    }
+}
+
+static void uni_apply( struct drvui *ui )
+{
+    struct uni_ui *uu = CONTAINING_RECORD( ui, struct uni_ui, ui );
+    unsigned int f;
+
+    for (f = 0; f < ui->feature_count; f++) uu->sel[f] = ui->features[f].sel;
+    if (ui->device)
+    {
+        if (!unidrv_save_printer_features( uu->cfg.printer ? uu->cfg.printer : uu->devh->hPrinter, uu->cfg.gpd,
+                                           uu->sel ))
+            WARN( "the printer's features were not saved\n" );
+        return;
+    }
+    unidrv_sel_to_devmode( uu->cfg.gpd, uu->sel, ui->dm );
+    ui->dm->dmCopies = max( 1, ui->copies );
+    ui->dm->dmFields |= DM_COPIES;
+    if (uu->dph->pdmOut && (uu->dph->fMode & (DM_COPY | DM_UPDATE)))
+        memcpy( uu->dph->pdmOut, ui->dm, ui->dm->dmSize + ui->dm->dmDriverExtra );
+}
+
+static const struct drvui_funcs uni_funcs = { uni_apply };
+
+static void uni_ui_free( struct uni_ui *uu )
+{
+    free( uu->forms );
+    drvui_free( &uu->ui );
+    free( uu->ui.dm );
+    close_config( &uu->cfg );
+    free( uu );
+}
+
+static struct uni_ui *uni_ui_create( HANDLE printer, const WCHAR *name, const DEVMODEW *in, BOOL device )
+{
+    struct uni_ui *uu = calloc( 1, sizeof(*uu) );
+    const char *copies;
+    int n;
+
+    if (!uu) return NULL;
+    if (!open_config( &uu->cfg, printer, name ))
+    {
+        free( uu );
+        return NULL;
+    }
+    uu->ui.funcs = &uni_funcs;
+    uu->ui.device = device;
+    uu->ui.printer = printer ? printer : uu->cfg.printer;
+    lstrcpynW( uu->ui.printer_name, name, ARRAY_SIZE(uu->ui.printer_name) );
+    lstrcpynW( uu->ui.model, name, ARRAY_SIZE(uu->ui.model) );
+    wcscpy( uu->ui.caller, L"Unidrv Printer Driver" );
+    uu->ui.dm = make_devmode( &uu->cfg, name, in );
+    if (uu->cfg.oem_size) uu->ui.oem_dm = (BYTE *)uu->ui.dm + uu->ui.dm->dmSize + sizeof(struct unidrv_dm);
+    uu->ui.oem_dm_size = uu->cfg.oem_size;
+    unidrv_devmode_to_sel( uu->cfg.gpd, uu->ui.dm, uu->sel );
+    unidrv_load_printer_features( uu->ui.printer, uu->cfg.gpd, uu->sel );
+    uu->ui.copies = max( 1, uu->ui.dm->dmCopies );
+    copies = gpd_global( uu->cfg.gpd, uu->sel, "MaxCopies" );
+    uu->ui.max_copies = copies && gpd_int( uu->cfg.gpd, copies, &n ) && n > 0 ? n : 999;
+    {
+        DWORD needed = 0;
+        EnumFormsW( uu->ui.printer, 1, NULL, 0, &needed, &uu->form_count );
+        if (needed && (uu->forms = malloc( needed )) &&
+            !EnumFormsW( uu->ui.printer, 1, (BYTE *)uu->forms, needed, &needed, &uu->form_count ))
+            uu->form_count = 0;
+    }
+    uni_fill_features( uu );
+    return uu;
+}
