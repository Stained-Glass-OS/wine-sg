+/******************************************************************************
+ *           DrvDevicePropertySheets (wineps.drv.@)
+ *
+ * The printer's sheet: its installable options, and the maker's plug-ins' pages.
+ */
+LONG WINAPI DrvDevicePropertySheets(PROPSHEETUI_INFO *info, LPARAM lparam)
+{
+    DEVICEPROPERTYHEADER *devh;
+    PRINTERINFO *pi;
+
+    TRACE("(info=%p, lparam=%Id)\n", info, lparam);
+    if (!info || !(devh = (DEVICEPROPERTYHEADER *)info->lParamInit)) return ERR_CPSUI_GETLASTERROR;
+    switch (info->Reason)
+    {
+    case PROPSHEETUI_REASON_INIT:
+        if (!(pi = PSDRV_FindPrinterInfo(devh->pszPrinterName))) return ERR_CPSUI_GETLASTERROR;
+        return ps_ui_sheets( info, pi, NULL, devh );
+    case PROPSHEETUI_REASON_DESTROY:
+        ps_ui_free( (void *)info->UserData );
+        info->UserData = 0;
+        break;
+    }
+    return CPSUI_OK;
+}
