+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE core_DrvUpdateUISetting( core_ui *iface, void *pci, void *item, DWORD prev, DWORD mode )
+{
+    TRACE( "%p %lu %lu\n", item, prev, mode );
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE core_GetOptions( core_ui *iface, void *pci, DWORD flags, const char *wanted, DWORD in_size,
+                                                  char *buf, DWORD size, DWORD *needed )
+{
+    struct drvui *ui = from_uiobj( pci );
+    unsigned int i;
+    DWORD used = 0;
+
+    TRACE( "%s\n", wanted ? debugstr_a(wanted) : "(all)" );
+
+    if (!ui) return E_INVALIDARG;
+    if (wanted)
+    {
+        const char *p;
+        for (p = wanted; *p; p += strlen( p ) + 1)
+        {
+            struct drvui_feature *f = find_feature( ui, p );
+            mstr_add( buf, size, &used, p );
+            mstr_add( buf, size, &used, f && f->sel >= 0 && f->sel < f->count ? f->options[f->sel].name : "" );
+        }
+    }
+    else for (i = 0; i < ui->feature_count; i++)
+    {
+        struct drvui_feature *f = &ui->features[i];
+        if (f->sel < 0 || f->sel >= f->count) continue;
+        mstr_add( buf, size, &used, f->name );
+        mstr_add( buf, size, &used, f->options[f->sel].name );
+    }
+    return mstr_done( buf, size, used, needed );
+}
+
+static HRESULT STDMETHODCALLTYPE core_SetOptions( core_ui *iface, void *pci, DWORD flags, const char *list, DWORD in_size,
+                                                  DWORD *result )
+{
+    struct drvui *ui = from_uiobj( pci );
+    const char *p;
+    unsigned int i;
+
+    TRACE( "%s\n", debugstr_a(list) );
+
+    if (!ui || !list) return E_INVALIDARG;
+    for (p = list; *p; )
+    {
+        struct drvui_feature *f = find_feature( ui, p );
+        const char *option = p + strlen( p ) + 1;
+        if (!*option) break;
+        for (i = 0; f && i < f->count; i++)
+            if (!strcmp( f->options[i].name, option )) f->sel = i;
+        TRACE( "%s = %s\n", debugstr_a(p), debugstr_a(option) );
+        p = option + strlen( option ) + 1;
+    }
+    sync_items( ui );
+    if (result) *result = SETOPTIONS_RESULT_NO_CONFLICT;
+    return S_OK;
+}
