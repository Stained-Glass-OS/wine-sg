+/* the code page of a PPD's translation strings: its *LanguageEncoding,
+ * or for "None" or none given, its *LanguageVersion's (Adobe's PPD spec) */
+static UINT ppd_encoding_codepage( const char *encoding )
+{
+    if (!stricmp( encoding, "UTF-8" )) return CP_UTF8;
+    if (!stricmp( encoding, "ISOLatin1" )) return 1252;
+    if (!stricmp( encoding, "WindowsANSI" )) return CP_ACP;
+    if (!stricmp( encoding, "JIS83-RKSJ" )) return 932;
+    if (!stricmp( encoding, "MacStandard" )) return 10000;
+    return 0;
+}
+
+static UINT ppd_language_codepage( const char *language )
+{
+    static const struct { const char *name; UINT cp; } languages[] =
+    {
+        { "Simplified", 936 }, { "Chinese", 936 }, { "Traditional", 950 }, { "Japanese", 932 },
+        { "Korean", 949 }, { "Russian", 1251 }, { "Bulgarian", 1251 }, { "Ukrainian", 1251 },
+        { "Polish", 1250 }, { "Czech", 1250 }, { "Hungarian", 1250 }, { "Slovak", 1250 }, { "Slovenian", 1250 },
+        { "Croatian", 1250 }, { "Romanian", 1250 }, { "Greek", 1253 }, { "Turkish", 1254 }, { "Hebrew", 1255 },
+        { "Arabic", 1256 }, { "Thai", 874 }, { "Estonian", 1257 }, { "Latvian", 1257 }, { "Lithuanian", 1257 },
+    };
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(languages); i++)
+        if (!stricmp( language, languages[i].name )) return languages[i].cp;
+    return 1252;
+}
