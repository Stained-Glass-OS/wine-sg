+
+static HRESULT STDMETHODCALLTYPE core_GetFeatureAttribute( core_ui *iface, void *pci, DWORD flags, const char *feature,
+                                                           const char *attr, DWORD *type, BYTE *buf, DWORD size,
+                                                           DWORD *needed )
+{
+    struct drvui *ui = from_uiobj( pci );
+    struct drvui_feature *f;
+
+    TRACE( "%s %s\n", debugstr_a(feature), debugstr_a(attr) );
+
+    if (!ui || !attr || !(f = find_feature( ui, feature ))) return E_INVALIDARG;
+    if (!strcmp( attr, "DisplayName" ))
+        return put_attr( ADT_UNICODE, f->text, (wcslen( f->text ) + 1) * sizeof(WCHAR), type, buf, size, needed );
+    if (!strcmp( attr, "DefaultOption" ) && f->sel >= 0 && f->sel < f->count)
+        return put_attr( ADT_ASCII, f->options[f->sel].name, strlen( f->options[f->sel].name ) + 1, type, buf, size,
+                         needed );
+    return E_INVALIDARG;
+}
+
+static HRESULT STDMETHODCALLTYPE core_GetOptionAttribute( core_ui *iface, void *pci, DWORD flags, const char *feature,
+                                                          const char *option, const char *attr, DWORD *type, BYTE *buf,
+                                                          DWORD size, DWORD *needed )
+{
+    struct drvui *ui = from_uiobj( pci );
+    struct drvui_feature *f;
+    unsigned int i;
+
+    TRACE( "%s %s %s\n", debugstr_a(feature), debugstr_a(option), debugstr_a(attr) );
+
+    if (!ui || !attr || !(f = find_feature( ui, feature ))) return E_INVALIDARG;
+    for (i = 0; i < f->count; i++)
+    {
+        if (strcmp( f->options[i].name, option )) continue;
+        if (!strcmp( attr, "DisplayName" ))
+            return put_attr( ADT_UNICODE, f->options[i].text, (wcslen( f->options[i].text ) + 1) * sizeof(WCHAR),
+                             type, buf, size, needed );
+        break;
+    }
+    return E_INVALIDARG;
+}
+
+static HRESULT STDMETHODCALLTYPE core_EnumFeatures( core_ui *iface, void *pci, DWORD flags, char *buf, DWORD size,
+                                                    DWORD *needed )
+{
+    struct drvui *ui = from_uiobj( pci );
+    unsigned int i;
+    DWORD used = 0;
+
+    TRACE( "\n" );
+
+    if (!ui) return E_INVALIDARG;
+    for (i = 0; i < ui->feature_count; i++) mstr_add( buf, size, &used, ui->features[i].name );
+    return mstr_done( buf, size, used, needed );
+}
+
+static HRESULT STDMETHODCALLTYPE core_EnumOptions( core_ui *iface, void *pci, DWORD flags, const char *feature,
+                                                   char *buf, DWORD size, DWORD *needed )
+{
+    struct drvui *ui = from_uiobj( pci );
+    struct drvui_feature *f;
+    unsigned int i;
+    DWORD used = 0;
+
+    TRACE( "%s\n", debugstr_a(feature) );
+
+    if (!ui || !(f = find_feature( ui, feature ))) return E_INVALIDARG;
+    for (i = 0; i < f->count; i++) mstr_add( buf, size, &used, f->options[i].name );
+    return mstr_done( buf, size, used, needed );
+}
