+/* the features that are the printer's (*FeatureType: PRINTER_PROPERTY,
+ * installable options): kept with the printer, set in its Device Settings */
+BOOL unidrv_printer_feature( struct gpd *gpd, int feature )
+{
+    const char *type = gpd_feature_attr( gpd, feature, "FeatureType" );
+    return type && strstr( type, "PRINTER_PROPERTY" );
+}
+
+#define PRINTER_FEATURES_VALUE L"SG Printer Features"
+
+/* "feature\0option\0...\0" in the printer's data */
+void unidrv_load_printer_features( HANDLE printer, struct gpd *gpd, gpd_sel *sel )
+{
+    DWORD type, size = 0;
+    char *buf, *p;
+    int f, o;
+
+    if (!printer || GetPrinterDataW( printer, (WCHAR *)PRINTER_FEATURES_VALUE, &type, NULL, 0, &size ) != ERROR_MORE_DATA ||
+        !size || !(buf = calloc( 1, size + 2 )))
+        return;
+    if (!GetPrinterDataW( printer, (WCHAR *)PRINTER_FEATURES_VALUE, &type, (BYTE *)buf, size, &size ))
+    {
+        for (p = buf; *p; )
+        {
+            char *option = p + strlen( p ) + 1;
+            if (!*option) break;
+            if ((f = gpd_find_feature( gpd, p )) >= 0 && unidrv_printer_feature( gpd, f ) &&
+                (o = gpd_find_option( gpd, f, option )) >= 0)
+                sel[f] = o;
+            p = option + strlen( option ) + 1;
+        }
+    }
+    free( buf );
+}
+
+BOOL unidrv_save_printer_features( HANDLE printer, struct gpd *gpd, const gpd_sel *sel )
+{
+    char buf[8192];
+    DWORD used = 0;
+    unsigned int f;
+
+    for (f = 0; f < gpd->feature_count && f < UNIDRV_MAX_FEATURES; f++)
+    {
+        const char *name = gpd->features[f].name, *option;
+        size_t len1, len2;
+        if (!unidrv_printer_feature( gpd, f ) || sel[f] >= gpd->features[f].option_count) continue;
+        option = gpd->features[f].options[sel[f]].name;
+        len1 = strlen( name ) + 1;
+        len2 = strlen( option ) + 1;
+        if (used + len1 + len2 + 1 > sizeof(buf)) break;
+        memcpy( buf + used, name, len1 );
+        memcpy( buf + used + len1, option, len2 );
+        used += len1 + len2;
+    }
+    buf[used++] = 0;
+#ifdef SG_MUTANT_PRINTERFEATURES
+    return TRUE;
+#endif
+    return !SetPrinterDataW( printer, (WCHAR *)PRINTER_FEATURES_VALUE, REG_BINARY, (BYTE *)buf, used );
+}
