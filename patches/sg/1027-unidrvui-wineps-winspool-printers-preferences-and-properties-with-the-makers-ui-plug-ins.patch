+/* an attribute of a feature itself (*Name, *FeatureType, *ConcealFromUI?) */
+const char *gpd_feature_attr( const struct gpd *gpd, int feature, const char *key )
+{
+    const char *found = NULL;
+    unsigned int i, j;
+
+    if (feature < 0 || feature >= (int)gpd->feature_count) return NULL;
+    for (i = 0; i < gpd->features[feature].count; i++)
+    {
+        const struct gpd_node *node = gpd->features[feature].nodes[i];
+        for (j = 0; j < node->count; j++)
+            if (node->kids[j]->value && node->kids[j]->key && !strcmp( node->kids[j]->key, key ))
+                found = node->kids[j]->value;
+    }
+    return found ? gpd_resolve( gpd, found ) : NULL;
+}
