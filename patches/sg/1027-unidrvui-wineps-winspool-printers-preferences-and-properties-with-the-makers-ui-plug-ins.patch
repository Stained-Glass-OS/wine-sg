+/* ---- strings ---- */
+
+static void keep( struct drvui *ui, void *ptr )
+{
+    if (!ptr) return;
+    if (ui->string_count == ui->string_size)
+    {
+        unsigned int size = max( 64, ui->string_size * 2 );
+        void **list = realloc( ui->strings, size * sizeof(*list) );
+        if (!list) return;
+        ui->strings = list;
+        ui->string_size = size;
+    }
+    ui->strings[ui->string_count++] = ptr;
+}
+
+void *drvui_alloc( struct drvui *ui, size_t size )
+{
+    void *ptr = calloc( 1, size );
+    keep( ui, ptr );
+    return ptr;
+}
+
+WCHAR *drvui_strdup( struct drvui *ui, const WCHAR *str )
+{
+    WCHAR *ret = str ? wcsdup( str ) : NULL;
+    keep( ui, ret );
+    return ret;
+}
+
+char *drvui_strdupA( struct drvui *ui, const char *str )
+{
+    char *ret = str ? strdup( str ) : NULL;
+    keep( ui, ret );
+    return ret;
+}
+
+static struct drvui *from_uiobj( void *pci )
+{
+    return pci ? CONTAINING_RECORD( pci, struct drvui, uiobj ) : NULL;
+}
+
+/* ---- what the plug-ins ask of the core (IPrintOemDriverUI, IPrintCoreUI2) ---- */
+
+static struct drvui_feature *find_feature( struct drvui *ui, const char *name )
+{
+    unsigned int i;
+    for (i = 0; name && i < ui->feature_count; i++)
+        if (!strcmp( ui->features[i].name, name )) return &ui->features[i];
+    return NULL;
+}
+
+static void mstr_add( char *buf, DWORD size, DWORD *used, const char *str )
+{
+    DWORD len = strlen( str ) + 1;
+    if (buf && *used + len < size) memcpy( buf + *used, str, len );
+    *used += len;
+}
+
+static HRESULT mstr_done( char *buf, DWORD size, DWORD used, DWORD *needed )
+{
+    if (needed) *needed = used + 1;
+    if (!buf || size < used + 1) return E_OUTOFMEMORY;
+    buf[used] = 0;
+    return S_OK;
+}
+
+static void sync_items( struct drvui *ui );
+
+typedef struct core_ui core_ui;
+struct core_ui { const void *lpVtbl; };
+
+static HRESULT STDMETHODCALLTYPE core_QueryInterface( core_ui *iface, REFIID riid, void **out )
+{
+    TRACE( "%s\n", debugstr_guid( riid ) );
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &iid_driver_ui ) || IsEqualGUID( riid, &iid_core_ui2 ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    WARN( "%s\n", debugstr_guid( riid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE core_AddRef( core_ui *iface ) { return 2; }
+static ULONG STDMETHODCALLTYPE core_Release( core_ui *iface ) { return 1; }
+
+/* the option chosen for a feature, as a list of one */
+static HRESULT STDMETHODCALLTYPE core_DrvGetDriverSetting( core_ui *iface, void *pci, const char *feature, void *out,
+                                                           DWORD size, DWORD *needed, DWORD *count )
+{
+    struct drvui *ui = from_uiobj( pci );
+    struct drvui_feature *f;
+    DWORD used = 0;
+
+    if (!ui) return E_INVALIDARG;
+    TRACE( "%s\n", (ULONG_PTR)feature >> 16 ? debugstr_a(feature) : wine_dbg_sprintf( "#%Iu", (ULONG_PTR)feature ) );
+    if (!((ULONG_PTR)feature >> 16)) return E_NOTIMPL;   /* the numbered settings */
+    if (!(f = find_feature( ui, feature )) || f->sel < 0 || f->sel >= f->count) return E_INVALIDARG;
+    mstr_add( out, size, &used, f->options[f->sel].name );
+    if (count) *count = 1;
+    TRACE( "%s = %s\n", debugstr_a(feature), debugstr_a(f->options[f->sel].name) );
+    return mstr_done( out, size, used, needed );
+}
+
+static HRESULT STDMETHODCALLTYPE core_DrvUpgradeRegistrySetting( core_ui *iface, HANDLE printer, const char *feature,
