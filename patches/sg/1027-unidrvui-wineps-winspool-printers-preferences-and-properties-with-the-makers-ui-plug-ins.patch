+#ifndef __WINE_DRVUI_H
+#define __WINE_DRVUI_H
+
+/* Shared by our Unidrv (unidrvui) and PostScript (wineps.drv, behind
+ * ps5ui) configuration DLLs: the core describes the printer's features
+ * (from its GPD or PPD) and the devmode; drvui.c makes the Layout,
+ * Paper/Quality and Advanced pages (or Device Settings) out of them through
+ * CPSUI, and hosts the maker's UI plug-ins (IPrintOemUI), which add options
+ * to those pages and pages of their own. */
+
+struct drvui_option
+{
+    char  *name;            /* the GPD/PPD keyword */
+    WCHAR *text;            /* what the user sees */
+};
+
+struct drvui_feature
+{
+    char  *name;
+    WCHAR *text;
+    BYTE   dmpub;           /* DMPUB_* when it is one of the standard settings */
+    BOOL   printer;         /* a property of the printer (Device Settings), not of documents */
+    BOOL   hidden;
+    unsigned int count;
+    struct drvui_option *options;
+    int    sel;
+};
+
+struct drvui;
+
+struct drvui_funcs
+{
+    /* the user's choices (features[].sel, copies) into ui->dm, or the
+     * printer's settings when ui->device */
+    void (*apply)( struct drvui *ui );
+};
+
+#define DRVUI_MAX_PLUGINS 4
+
+struct drvui_plugin;
+
+struct drvui
+{
+    const struct drvui_funcs *funcs;
+    void         *core;             /* the core's own state */
+    HANDLE        printer;
+    WCHAR         printer_name[MAX_PATH];
+    BOOL          device;           /* the printer's sheet, not a document's */
+    DWORD         mode;             /* the header's fMode or Flags */
+    DEVMODEW     *dm;               /* the document's devmode, while the sheet shows */
+    void         *oem_dm;           /* the plug-ins' part of it */
+    DWORD         oem_dm_size;
+    struct drvui_feature *features;
+    unsigned int  feature_count;
+    LONG          copies, max_copies;
+    WCHAR         model[MAX_PATH];  /* the treeview's root */
+    WCHAR         caller[64];
+    HINSTANCE     instance;
+
+    /* what drvui.c builds */
+    struct { DWORD cbSize; void *procs; } uiobj;
+    COMPROPSHEETUI cpsui;
+    OPTITEM      *items;
+    unsigned int  item_count;
+    unsigned int  our_items;
+    int          *item_feature;     /* per item: feature index, -1 copies, -2 a heading, -3 a plug-in's */
+    void        **strings;          /* what to free */
+    unsigned int  string_count, string_size;
+    HANDLE        heap;             /* the plug-ins' */
+    struct drvui_plugin *plugins;
+    unsigned int  plugin_count;
+    BOOL          applied;
+};
+
+/* fills in the plug-ins, then adds the pages: at PROPSHEETUI_REASON_INIT */
+extern LONG drvui_add_pages( struct drvui *ui, PROPSHEETUI_INFO *info );
+extern void drvui_free( struct drvui *ui );
+extern WCHAR *drvui_strdup( struct drvui *ui, const WCHAR *str );
+extern char *drvui_strdupA( struct drvui *ui, const char *str );
+extern void *drvui_alloc( struct drvui *ui, size_t size );
+
+#endif /* __WINE_DRVUI_H */
