+
+static HRESULT put_attr( DWORD type, const void *data, DWORD len, DWORD *data_type, BYTE *buf, DWORD size,
+                         DWORD *needed )
+{
+    if (data_type) *data_type = type;
+    if (needed) *needed = len;
+    if (!buf || size < len) return E_OUTOFMEMORY;
+    memcpy( buf, data, len );
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE core_GetGlobalAttribute( core_ui *iface, void *pci, DWORD flags, const char *attr,
+                                                          DWORD *type, BYTE *buf, DWORD size, DWORD *needed )
