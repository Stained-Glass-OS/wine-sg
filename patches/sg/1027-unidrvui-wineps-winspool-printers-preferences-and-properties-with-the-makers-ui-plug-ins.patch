+/* ---- the plug-ins ---- */
+
+static unsigned int config_files( HANDLE printer, WCHAR files[DRVUI_MAX_PLUGINS][MAX_PATH] )
+{
+    DRIVER_INFO_3W *info;
+    DWORD needed = 0;
+    unsigned int count = 0, i;
+    WCHAR *p;
+
+    GetPrinterDriverW( printer, NULL, 3, NULL, 0, &needed );
+    if (!needed || !(info = malloc( needed ))) return 0;
+    if (!GetPrinterDriverW( printer, NULL, 3, (BYTE *)info, needed, &needed )) needed = 0;
+    for (p = needed ? info->pDependentFiles : NULL; p && *p && !count; p += wcslen( p ) + 1)
+    {
+        const WCHAR *ext = wcsrchr( p, '.' );
+        WCHAR key[32], value[MAX_PATH], dir[MAX_PATH], *slash;
+
+        if (!ext || wcsicmp( ext, L".ini" )) continue;
+        lstrcpynW( dir, p, MAX_PATH );
+        if ((slash = wcsrchr( dir, '\\' ))) slash[1] = 0;
+        else dir[0] = 0;
+        for (i = 1; i <= DRVUI_MAX_PLUGINS; i++)
+        {
+            const WCHAR *base;
+            swprintf( key, ARRAY_SIZE(key), L"OEMConfigFile%u", i );
+            if (!GetPrivateProfileStringW( L"OEMFiles", key, L"", value, MAX_PATH, p )) continue;
+            base = wcsrchr( value, '\\' ) ? wcsrchr( value, '\\' ) + 1 : value;
+            swprintf( files[count++], MAX_PATH, L"%s%s", dir, base );
+        }
+    }
+    free( info );
+    return count;
+}
+
+static void load_plugins( struct drvui *ui )
+{
+    WCHAR files[DRVUI_MAX_PLUGINS][MAX_PATH];
+    unsigned int count, i;
+
+#ifdef SG_MUTANT_UIPLUGIN
+    return;
+#endif
+    if (!(count = config_files( ui->printer, files ))) return;
+    if (!(ui->plugins = calloc( count, sizeof(*ui->plugins) ))) return;
+    for (i = 0; i < count; i++)
+    {
+        struct drvui_plugin *p = &ui->plugins[ui->plugin_count];
+        HRESULT (WINAPI *get_class)( REFCLSID, REFIID, void ** );
+        OEMDMPARAM param;
+        DWORD sig = 0, size = 0;
+        void *dm;
+        IClassFactory *factory;
+        IUnknown *unk;
+
+        if (!(p->module = LoadLibraryW( files[i] )))
+        {
+            WARN( "cannot load %s\n", debugstr_w(files[i]) );
+            continue;
+        }
+        if ((get_class = (void *)GetProcAddress( p->module, "DllGetClassObject" )) &&
+            SUCCEEDED(get_class( &clsid_oem_ui, &IID_IClassFactory, (void **)&factory )))
+        {
+            if (SUCCEEDED(IClassFactory_CreateInstance( factory, NULL, &IID_IUnknown, (void **)&unk )))
+            {
+                p->ui2 = SUCCEEDED(IUnknown_QueryInterface( unk, &iid_oem_ui2, (void **)&p->oem ));
+                if (!p->ui2) IUnknown_QueryInterface( unk, &iid_oem_ui, (void **)&p->oem );
+                IUnknown_Release( unk );
+            }
+            IClassFactory_Release( factory );
+        }
+        if (!p->oem)
+        {
+            WARN( "%s: no IPrintOemUI\n", debugstr_w(files[i]) );
+            FreeLibrary( p->module );
+            continue;
+        }
+        p->oem->lpVtbl->GetInfo( p->oem, OEMGI_GETSIGNATURE, &sig, sizeof(sig), &size );
+        p->oem->lpVtbl->PublishDriverInterface( p->oem, (IUnknown *)&the_core );
+        /* its part of the devmode, as the core keeps it */
+        memset( &param, 0, sizeof(param) );
+        param.cbSize = sizeof(param);
+        param.pdriverobj = &ui->uiobj;
+        param.hPrinter = ui->printer;
+        param.hModule = p->module;
+        param.pPublicDMIn = param.pPublicDMOut = ui->dm;
+        if (SUCCEEDED(p->oem->lpVtbl->DevMode( p->oem, OEMDM_SIZE, &param )) && param.cbBufSize && !ui->oem_dm &&
+            !ui->plugin_count && (ui->oem_dm = drvui_alloc( ui, param.cbBufSize )))
+        {
+            /* a core that keeps no part for it (our PostScript driver): its
+             * defaults, for this sheet */
+            ui->oem_dm_size = param.cbBufSize;
+            param.pOEMDMOut = ui->oem_dm;
+            p->oem->lpVtbl->DevMode( p->oem, OEMDM_DEFAULT, &param );
+        }
+        else if (param.cbBufSize && param.cbBufSize == ui->oem_dm_size && ui->oem_dm &&
+                 (dm = calloc( 1, param.cbBufSize )))
+        {
+            param.pOEMDMOut = dm;
+            p->oem->lpVtbl->DevMode( p->oem, OEMDM_DEFAULT, &param );
+            param.pOEMDMIn = ui->oem_dm;
+            if (SUCCEEDED(p->oem->lpVtbl->DevMode( p->oem, OEMDM_MERGE, &param )))
+                memcpy( ui->oem_dm, dm, param.cbBufSize );
+            free( dm );
+        }
+        TRACE( "%s: UI plug-in (IPrintOemUI%s) %08lx, devmode part %lu\n", debugstr_w(files[i]), p->ui2 ? "2" : "",
+               sig, param.cbBufSize );
+        ui->plugin_count++;
+    }
+}
+
+/* ---- the options ---- */
+
+static OPTITEM *new_item( struct drvui *ui, int feature, BYTE level, const WCHAR *name )
+{
+    OPTITEM *item = &ui->items[ui->item_count];
+    item->cbSize = sizeof(*item);
+    item->Level = level;
+    item->pName = (WCHAR *)name;
+    ui->item_feature[ui->item_count++] = feature;
+    return item;
+}
+
+static void feature_item( struct drvui *ui, int index, BYTE level )
+{
+    struct drvui_feature *f = &ui->features[index];
+    OPTITEM *item = new_item( ui, index, level, f->text );
+    OPTTYPE *type = drvui_alloc( ui, sizeof(*type) );
+    OPTPARAM *params = drvui_alloc( ui, max( 1, f->count ) * sizeof(*params) );
+    unsigned int i;
+
+    if (!type || !params) return;
+    for (i = 0; i < f->count; i++)
+    {
+        params[i].cbSize = sizeof(params[i]);
+        params[i].pData = f->options[i].text;
+    }
+    type->cbSize = sizeof(*type);
+    type->Type = f->count == 2 && f->dmpub == DMPUB_ORIENTATION ? TVOT_2STATES : TVOT_COMBOBOX;
+    type->Count = f->count;
+    type->pOptParam = params;
+    item->pOptType = type;
+    item->Sel = f->sel;
+    item->DMPubID = f->dmpub;
+}
+
+static void copies_item( struct drvui *ui, BYTE level )
+{
+    OPTITEM *item = new_item( ui, -1, level, (WCHAR *)IDS_CPSUI_COPIES );
+    OPTTYPE *type = drvui_alloc( ui, sizeof(*type) );
+    OPTPARAM *params = drvui_alloc( ui, 2 * sizeof(*params) );
+
+    if (!type || !params) return;
+    params[0].cbSize = params[1].cbSize = sizeof(OPTPARAM);
+    params[0].pData = (WCHAR *)L"";
+    params[1].IconID = 1;
+    params[1].lParam = ui->max_copies;
+    type->cbSize = sizeof(*type);
+    type->Type = TVOT_UDARROW;
+    type->Count = 2;
+    type->pOptParam = params;
+    item->pOptType = type;
+    item->Sel = ui->copies;
+    item->DMPubID = DMPUB_COPIES_COLLATE;
+}
+
+/* the treeview's sections, and the settings each holds */
+static const struct { UINT title; BYTE dmpubs[8]; } sections[] =
+{
+    { IDS_CPSUI_PAPER_OUTPUT, { DMPUB_FORMNAME, DMPUB_DEFSOURCE, DMPUB_MEDIATYPE, DMPUB_COPIES_COLLATE,
+                                DMPUB_OUTPUTBIN, DMPUB_STAPLE } },
+    { IDS_CPSUI_GRAPHIC, { DMPUB_PRINTQUALITY, DMPUB_COLOR, DMPUB_SCALE, DMPUB_ICMMETHOD, DMPUB_ICMINTENT,
+                           DMPUB_DITHERTYPE } },
+    { IDS_CPSUI_DOCUMENT, { DMPUB_ORIENTATION, DMPUB_DUPLEX, DMPUB_NUP, DMPUB_PAGEORDER, DMPUB_BOOKLET_EDGE } },
+};
+
+static BOOL in_section( unsigned int s, BYTE dmpub )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(sections[s].dmpubs); i++) if (sections[s].dmpubs[i] && sections[s].dmpubs[i] == dmpub) return TRUE;
+    return FALSE;
+}
+
+static BOOL shown( struct drvui *ui, const struct drvui_feature *f )
+{
+    return !f->hidden && f->count && (ui->device ? f->printer : !f->printer);
+}
+
+static void build_items( struct drvui *ui, unsigned int extra )
+{
+    unsigned int max = ui->feature_count + ARRAY_SIZE(sections) + 3 + extra, s, i;
+    BOOL any;
+
+    ui->items = drvui_alloc( ui, max * sizeof(*ui->items) );
+    ui->item_feature = drvui_alloc( ui, max * sizeof(*ui->item_feature) );
+    if (!ui->items || !ui->item_feature) return;
+
+    if (!ui->device)
+    {
+        for (s = 0; s < ARRAY_SIZE(sections); s++)
+        {
+            any = s == 0;   /* copies */
+            for (i = 0; i < ui->feature_count; i++)
+                if (shown( ui, &ui->features[i] ) && in_section( s, ui->features[i].dmpub )) any = TRUE;
+            if (!any) continue;
+            new_item( ui, -2, 0, (WCHAR *)(ULONG_PTR)sections[s].title );
+            if (s == 0) copies_item( ui, 1 );
+            for (i = 0; i < ui->feature_count; i++)
+                if (shown( ui, &ui->features[i] ) && in_section( s, ui->features[i].dmpub )) feature_item( ui, i, 1 );
+        }
+    }
+    any = FALSE;
+    for (i = 0; i < ui->feature_count; i++)
+    {
+        struct drvui_feature *f = &ui->features[i];
+        if (!shown( ui, f )) continue;
+        if (!ui->device && f->dmpub)
+        {
+            for (s = 0; s < ARRAY_SIZE(sections); s++) if (in_section( s, f->dmpub )) break;
+            if (s < ARRAY_SIZE(sections)) continue;
+        }
+        if (!any) new_item( ui, -2, 0, (WCHAR *)(ULONG_PTR)IDS_CPSUI_DEVICEOPTIONS );
+        any = TRUE;
+        feature_item( ui, i, 1 );
+    }
+    ui->our_items = ui->item_count;
+}
+
+/* the options' values back into the features */
+static void read_items( struct drvui *ui )
+{
+    unsigned int i;
+    for (i = 0; i < ui->our_items; i++)
+    {
+        int f = ui->item_feature[i];
+        if (f >= 0) ui->features[f].sel = ui->items[i].Sel;
+        else if (f == -1) ui->copies = ui->items[i].Sel;
+    }
+}
+
+static void sync_items( struct drvui *ui )
+{
+    unsigned int i;
+    for (i = 0; ui->items && i < ui->our_items; i++)
+    {
+        int f = ui->item_feature[i];
+        if (f < 0 || ui->items[i].Sel == ui->features[f].sel) continue;
+        ui->items[i].Sel = ui->features[f].sel;
+        ui->items[i].Flags |= OPTIF_CHANGED;
+    }
+}
+
+static struct drvui_plugin *item_plugin( struct drvui *ui, const OPTITEM *item )
+{
+    unsigned int i, index = item - ui->items;
+    for (i = 0; i < ui->plugin_count; i++)
+        if (ui->plugins[i].count && index >= ui->plugins[i].first && index < ui->plugins[i].first + ui->plugins[i].count)
+            return &ui->plugins[i];
+    return NULL;
+}
+
+static LONG CALLBACK options_callback( CPSUICBPARAM *param )
+{
+    struct drvui *ui = (struct drvui *)param->UserData;
+    struct drvui_plugin *plugin;
+    LONG ret = CPSUICB_ACTION_NONE, r;
+    unsigned int i;
+
+    if (param->Reason == CPSUICB_REASON_APPLYNOW)
+    {
+        /* the plug-ins check theirs first */
+        for (i = 0; i < ui->plugin_count; i++)
+        {
+            if (!ui->plugins[i].cuip.OEMCUIPCallback) continue;
+            r = ui->plugins[i].cuip.OEMCUIPCallback( param, &ui->plugins[i].cuip );
+            if (r == CPSUICB_ACTION_NO_APPLY_EXIT) return r;
+        }
+        read_items( ui );
+#ifndef SG_MUTANT_UIAPPLY
+        ui->funcs->apply( ui );
+#endif
+        ui->applied = TRUE;
+        TRACE( "applied, %u features\n", ui->feature_count );
+        return CPSUICB_ACTION_ITEMS_APPLIED;
+    }
+    if (param->pCurItem && (plugin = item_plugin( ui, param->pCurItem )) && plugin->cuip.OEMCUIPCallback)
+        return plugin->cuip.OEMCUIPCallback( param, &plugin->cuip );
+    /* a plug-in's callback sees changes to ours too, as they may follow them */
+    for (i = 0; i < ui->plugin_count; i++)
+    {
+        if (!ui->plugins[i].cuip.OEMCUIPCallback || param->Reason != CPSUICB_REASON_SEL_CHANGED) continue;
+        r = ui->plugins[i].cuip.OEMCUIPCallback( param, &ui->plugins[i].cuip );
+        if (r != CPSUICB_ACTION_NONE) ret = r;
+    }
+    read_items( ui );
+    return ret;
+}
+
+/* a plug-in's own pages: its DocumentPropertySheets is a PFNPROPSHEETUI */
+static LONG CALLBACK plugin_sheets( PROPSHEETUI_INFO *info, LPARAM lparam )
+{
+    struct drvui_plugin *p = CONTAINING_RECORD( (OEMUIPSPARAM *)info->lParamInit, struct drvui_plugin, pages.param );
+    HRESULT hr;
+
+    if (p->pages.ui->device) hr = p->oem->lpVtbl->DevicePropertySheets( p->oem, info, lparam );
+    else hr = p->oem->lpVtbl->DocumentPropertySheets( p->oem, info, lparam );
+    TRACE( "reason %u: %#lx\n", info->Reason, hr );
+    if (info->Reason == PROPSHEETUI_REASON_INIT) return SUCCEEDED(hr) ? 1 : 0;
+    return SUCCEEDED(hr) ? 1 : -1;
+}
+
+LONG drvui_add_pages( struct drvui *ui, PROPSHEETUI_INFO *info )
+{
+    DWORD mode = ui->device ? OEMCUIP_PRNPROP : OEMCUIP_DOCPROP;
+    unsigned int i, j, extra = 0;
+    BOOL hide = FALSE;
+    LONG result = 0;
+
+    ui->uiobj.cbSize = sizeof(ui->uiobj);
+    ui->uiobj.procs = (void *)&ui_procs;
+    if (!ui->heap) ui->heap = HeapCreate( 0, 0, 0 );
+    load_plugins( ui );
+
+    /* a plug-in may show the whole sheet itself */
+    TRACE( "%u plug-ins, devmode part %p (%lu bytes)\n", ui->plugin_count, ui->oem_dm, ui->oem_dm_size );
+    for (i = 0; i < ui->plugin_count; i++)
+        if (ui->plugins[i].ui2 && ui->plugins[i].oem->lpVtbl->HideStandardUI( ui->plugins[i].oem, mode ) == S_OK)
+            hide = TRUE;
+    TRACE( "standard pages %s\n", hide ? "hidden" : "shown" );
+
+    if (!hide)
+    {
+        /* our options first: the plug-ins look at them (to hide those they
+         * replace) when they say how many they add */
+        build_items( ui, 256 );
+        if (!ui->items) return ERR_CPSUI_ALLOCMEM_FAILED;
+        for (i = 0; i < ui->plugin_count; i++)
+        {
+            struct drvui_plugin *p = &ui->plugins[i];
+            p->cuip.cbSize = sizeof(p->cuip);
+            p->cuip.poemuiobj = &ui->uiobj;
+            p->cuip.hPrinter = ui->printer;
+            p->cuip.pPrinterName = ui->printer_name;
+            p->cuip.hModule = p->module;
+            p->cuip.hOEMHeap = ui->heap;
+            p->cuip.pPublicDM = ui->device ? NULL : ui->dm;
+            p->cuip.pOEMDM = ui->device ? NULL : ui->oem_dm;
+            p->cuip.dwFlags = ui->mode;
+            p->cuip.pDrvOptItems = ui->items;
+            p->cuip.cDrvOptItems = ui->item_count;
+            if (FAILED(p->oem->lpVtbl->CommonUIProp( p->oem, mode, &p->cuip ))) p->cuip.cOEMOptItems = 0;
+            TRACE( "plug-in %u wants %lu options\n", i, p->cuip.cOEMOptItems );
+            extra += p->cuip.cOEMOptItems;
+        }
+        if (extra > 256)
+        {
+            WARN( "%u options from the plug-ins: some are left out\n", extra );
+            extra = 256;
+        }
+        for (i = 0; i < ui->plugin_count; i++)
+        {
+            struct drvui_plugin *p = &ui->plugins[i];
+            DWORD want = min( p->cuip.cOEMOptItems, ui->our_items + 256 - ui->item_count );
+            if (!want) continue;
+            p->first = ui->item_count;
+            p->cuip.pDrvOptItems = ui->items;
+            p->cuip.cDrvOptItems = ui->item_count;
+            p->cuip.pOEMOptItems = &ui->items[ui->item_count];
+            p->cuip.cOEMOptItems = want;
+            if (FAILED(p->oem->lpVtbl->CommonUIProp( p->oem, mode, &p->cuip ))) continue;
+            p->count = min( p->cuip.cOEMOptItems, want );
+            for (j = 0; j < p->count; j++) ui->item_feature[ui->item_count + j] = -3;
+            ui->item_count += p->count;
+            TRACE( "plug-in %u: %u options\n", i, p->count );
+        }
+
+        ui->cpsui.cbSize = sizeof(ui->cpsui);
+        ui->cpsui.Flags = (ui->mode & 1 /* DPS_NOPERMISSION */) && ui->device ? 0 : CPSUIF_UPDATE_PERMISSION;
+        ui->cpsui.hInstCaller = ui->instance;
+        ui->cpsui.pCallerName = ui->caller;
+        ui->cpsui.UserData = (ULONG_PTR)ui;
+        ui->cpsui.pfnCallBack = options_callback;
+        ui->cpsui.pOptItem = ui->items;
+        ui->cpsui.cOptItem = ui->item_count;
+        ui->cpsui.pOptItemName = ui->model;
+        if (ui->device) ui->cpsui.pDlgPage = CPSUI_PDLGPAGE_PRINTERPROP;
+        else if (ui->mode & 0x10 /* DM_ADVANCED */) ui->cpsui.pDlgPage = CPSUI_PDLGPAGE_ADVDOCPROP;
+        else ui->cpsui.pDlgPage = CPSUI_PDLGPAGE_DOCPROP;
+        if (!info->pfnComPropSheet( info->hComPropSheet, CPSFUNC_ADD_PCOMPROPSHEETUIW, (LPARAM)&ui->cpsui,
+                                    (LPARAM)&result ))
+        {
+            WARN( "no option pages: %ld\n", result );
+            if (!ui->plugin_count) return result < 0 ? result : ERR_CPSUI_GETLASTERROR;
+        }
+    }
+
+    /* the plug-ins' own pages */
+    for (i = 0; i < ui->plugin_count; i++)
+    {
+        struct drvui_plugin *p = &ui->plugins[i];
+        p->pages.param.cbSize = sizeof(p->pages.param);
+        p->pages.param.poemuiobj = &ui->uiobj;
+        p->pages.param.hPrinter = ui->printer;
+        p->pages.param.pPrinterName = ui->printer_name;
+        p->pages.param.hModule = p->module;
+        p->pages.param.hOEMHeap = ui->heap;
+        p->pages.param.pPublicDM = ui->device ? NULL : ui->dm;
+        p->pages.param.pOEMDM = ui->device ? NULL : ui->oem_dm;
+        p->pages.param.dwFlags = ui->mode;
+        p->pages.ui = ui;
+        p->pages.plugin = p;
+        info->pfnComPropSheet( info->hComPropSheet, CPSFUNC_ADD_PFNPROPSHEETUIW, (LPARAM)plugin_sheets,
+                               (LPARAM)&p->pages.param );
+    }
+    return 1;
+}
+
+void drvui_free( struct drvui *ui )
+{
+    unsigned int i;
+
+    for (i = 0; i < ui->plugin_count; i++)
+    {
+        ui->plugins[i].oem->lpVtbl->Release( ui->plugins[i].oem );
+        FreeLibrary( ui->plugins[i].module );
+    }
+    free( ui->plugins );
+    ui->plugins = NULL;
+    ui->plugin_count = 0;
+    for (i = 0; i < ui->string_count; i++) free( ui->strings[i] );
+    free( ui->strings );
+    ui->strings = NULL;
+    ui->string_count = ui->string_size = 0;
+    if (ui->heap) HeapDestroy( ui->heap );
+    ui->heap = NULL;
+}
