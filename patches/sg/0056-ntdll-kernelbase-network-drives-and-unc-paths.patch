+/* Stained Glass OS: network drives and UNC paths.
+ *
+ * Shares are CIFS mounts under SG_NET_UNC/<server>/<share>, made by
+ * sg-netmountd (sg-session) with the user's own Kerberos ticket; a user's
+ * drive letters are symlinks in SG_NET_DRIVES/<uid>/. Like a Windows logon
+ * session's own DosDevices directory, a user's letters are looked up before
+ * the prefix's (dosdevices), and belong to that user alone. A UNC path whose
+ * share is not mounted yet asks sg-netmountd to mount it, as Windows' SMB
+ * redirector connects on first use. */
+#define SG_NET_ROOT   "/run/stained-glass-net"
+#define SG_NET_UNC    SG_NET_ROOT "/unc/"
+#define SG_NET_DRIVES SG_NET_ROOT "/drives/"
+#define SG_NET_SOCKET SG_NET_ROOT "/netmount.sock"
+
+/* the user's own drive letters: a bitmask, rescanned at most once a second */
+static unsigned int sg_user_drives( BOOL rescan )
+{
+    static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+    static unsigned int mask;
+    static time_t last;
+    time_t now = time( NULL );
+    unsigned int ret;
+
+    mutex_lock( &mutex );
+    if (now != last || rescan)
+    {
+        char dir[64];
+        DIR *d;
+        struct dirent *de;
+
+        mask = 0;
+        snprintf( dir, sizeof(dir), SG_NET_DRIVES "%u", (unsigned int)getuid() );
+        if ((d = opendir( dir )))
+        {
+            while ((de = readdir( d )))
+                if (de->d_name[0] >= 'a' && de->d_name[0] <= 'z' && de->d_name[1] == ':' && !de->d_name[2])
+                    mask |= 1u << (de->d_name[0] - 'a');
+            closedir( d );
+        }
+        last = now;
+    }
+    ret = mask;
+    mutex_unlock( &mutex );
+    return ret;
+}
+
+/* is path a mount point (not an empty directory a failed mount left)? */
+static BOOL sg_net_is_mount( const char *path )
+{
+    char parent[600];
+    struct stat st, pst;
+    char *p;
+
+    snprintf( parent, sizeof(parent), "%s", path );
+    if (!(p = strrchr( parent, '/' ))) return FALSE;
+    *p = 0;
+    return !stat( path, &st ) && !stat( parent, &pst ) && st.st_dev != pst.st_dev;
+}
+
+/* ask sg-netmountd to mount \\server\share; TRUE once it is mounted */
+static BOOL sg_net_mount( const char *server, const char *share )
+{
+    static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+    static char failed[256];
+    static time_t failed_time;
+    struct sockaddr_un addr = { .sun_family = AF_UNIX, .sun_path = SG_NET_SOCKET };
+    struct timeval tv = { 60, 0 };
+    char req[600], reply[64];
+    BOOL ret = FALSE;
+    ssize_t len = 0, r;
+    int fd;
+
+    if (snprintf( req, sizeof(req), "MOUNT\t%s\t%s\n", server, share ) >= sizeof(req)) return FALSE;
+
+    /* a share that just failed is not asked for again at once: programs probe */
+    mutex_lock( &mutex );
+    if (!strcmp( failed, req ) && time( NULL ) - failed_time < 10)
+    {
+        mutex_unlock( &mutex );
+        return FALSE;
+    }
+    mutex_unlock( &mutex );
+
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) == -1) return FALSE;
+    setsockopt( fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv) );
+    if (!connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) &&
+        write( fd, req, strlen(req) ) == strlen(req))
+    {
+        while (len < sizeof(reply) - 1 && (r = read( fd, reply + len, sizeof(reply) - 1 - len )) > 0)
+        {
+            len += r;
+            if (memchr( reply, '\n', len )) break;
+        }
+        reply[len] = 0;
+        ret = !strncmp( reply, "OK ", 3 );
+    }
+    close( fd );
+    TRACE( "mount \\\\%s\\%s: %s\n", server, share, ret ? "ok" : debugstr_a(reply) );
+
+    if (!ret)
+    {
+        mutex_lock( &mutex );
+        strcpy( failed, req );
+        failed_time = time( NULL );
+        mutex_unlock( &mutex );
+    }
+    return ret;
+}
+
+/* Where a DOS prefix (a drive "x:" or "unc") lives: the user's network drive
+ * or share directory, or NULL for the prefix's own dosdevices. name is the
+ * rest of the path after the prefix. */
+static const char *sg_net_base( const WCHAR *prefix, int prefix_len, const WCHAR *name, int name_len,
+                                char *buf, size_t size )
+{
+    static const WCHAR uncW[] = {'u','n','c'};
+    char server[256], share[256], path[600];
+    struct stat st;
+    int i, start, len;
+
+    if (prefix_len == 2 && prefix[1] == ':' && prefix[0] >= 'a' && prefix[0] <= 'z')
+    {
+        if (!(sg_user_drives( FALSE ) & (1u << (prefix[0] - 'a'))))
+        {
+            /* A letter the prefix does not have either may have been mapped
+             * a moment ago (net use, then at once dir H:): look again. */
+            char global[PATH_MAX];
+            snprintf( global, sizeof(global), "%s/dosdevices/%c:", config_dir, (char)prefix[0] );
+            if (!lstat( global, &st ) || !(sg_user_drives( TRUE ) & (1u << (prefix[0] - 'a')))) return NULL;
+        }
+        snprintf( buf, size, SG_NET_DRIVES "%u/", (unsigned int)getuid() );
+        return buf;
+    }
+    if (prefix_len != 3 || memcmp( prefix, uncW, sizeof(uncW) )) return NULL;
+
+    /* \\server\share: both must be there to name a share */
+    for (i = prefix_len; i < name_len && name[i] == '\\'; i++);
+    start = i;
+    while (i < name_len && name[i] != '\\') i++;
+    if ((len = i - start) <= 0 || len >= 64) return NULL;
+    len = ntdll_wcstoumbs( name + start, len, server, sizeof(server) - 1, TRUE );
+    if (len <= 0) return NULL;
+    server[len] = 0;
+    while (i < name_len && name[i] == '\\') i++;
+    start = i;
+    while (i < name_len && name[i] != '\\') i++;
+    if ((len = i - start) <= 0 || len >= 81) return NULL;
+    len = ntdll_wcstoumbs( name + start, len, share, sizeof(share) - 1, TRUE );
+    if (len <= 0) return NULL;
+    share[len] = 0;
+    for (i = 0; server[i]; i++) if (server[i] >= 'A' && server[i] <= 'Z') server[i] += 'a' - 'A';
+    for (i = 0; share[i]; i++) if (share[i] >= 'A' && share[i] <= 'Z') share[i] += 'a' - 'A';
+
+    snprintf( path, sizeof(path), SG_NET_UNC "%s/%s", server, share );
+    if ((stat( path, &st ) || !S_ISDIR( st.st_mode ) || !sg_net_is_mount( path )) && !sg_net_mount( server, share ))
+        return NULL;
+    /* the caller appends the prefix itself: "unc" */
+    snprintf( buf, size, "%s/", SG_NET_ROOT );
+    return buf;
+}
