 static HRESULT STDMETHODCALLTYPE d2d_device_ID2D1Device5_CreateDeviceContext(ID2D1Device6 *iface,
@@ -5042,6 +5106,27 @@ struct d2d_device *unsafe_impl_from_ID2D1Device(ID2D1Device1 *iface)
     return CONTAINING_RECORD(iface, struct d2d_device, ID2D1Device6_iface);
 }
 
+/* The bitmap a render target draws to, if it is one of ours. */
+struct d2d_bitmap *d2d_render_target_get_bitmap(ID2D1RenderTarget *iface)
+{
+    ID2D1DeviceContext6 *dc;
+    struct d2d_device_context *context;
+    struct d2d_bitmap *bitmap = NULL;
+
+    if (FAILED(ID2D1RenderTarget_QueryInterface(iface, &IID_ID2D1DeviceContext6, (void **)&dc)))
+        return NULL;
+
+    if (dc->lpVtbl == &d2d_device_context_vtbl)
+    {
+        context = impl_from_ID2D1DeviceContext(dc);
+        if (context->target.type == D2D_TARGET_BITMAP)
+            bitmap = context->target.bitmap;
+    }
+    ID2D1DeviceContext6_Release(dc);
+
+    return bitmap;
+}
+
 void d2d_device_init(struct d2d_device *device, struct d2d_factory *factory, IDXGIDevice *dxgi_device)
 {
     device->ID2D1Device6_iface.lpVtbl = &d2d_device_vtbl;
@@ -5050,6 +5135,13 @@ void d2d_device_init(struct d2d_device *device, struct d2d_factory *factory, IDX
     ID2D1Factory1_AddRef(device->factory);
     device->dxgi_device = dxgi_device;
     IDXGIDevice_AddRef(device->dxgi_device);
+#ifdef SG_MUTANT_D2D_DEFAULTS
+    device->max_texture_memory = 0;
+#else
+    device->max_texture_memory = 64 * 1024 * 1024;
+#endif
+    device->max_color_glyph_cache = 4 * 1024 * 1024;
+    device->rendering_priority = D2D1_RENDERING_PRIORITY_NORMAL;
 }
 
