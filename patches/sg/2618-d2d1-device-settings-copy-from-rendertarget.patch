From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: device settings, rendering controls and CopyFromRenderTarget

The device and device context setters of Direct2D 1.x were empty, and
ID2D1Bitmap1::CopyFromRenderTarget returned E_NOTIMPL, so applications that copy a
rendered frame into a CPU readable bitmap (screenshots, thumbnails, tests) got nothing.

 - ID2D1Device: SetMaximumTextureMemory / GetMaximumTextureMemory keep their value
   (default 64 MiB), ClearResources is accepted.
 - ID2D1Device1: GetRenderingPriority / SetRenderingPriority (normal, low; an unknown
   value is ignored).
 - ID2D1Device4: Set/GetMaximumColorGlyphCacheMemory (default 4 MiB).
 - ID2D1DeviceContext: Set/GetRenderingControls keep the settings (default unknown
   precision, 512x512 tiles); an unknown buffer precision changes nothing.
 - ID2D1Bitmap1::CopyFromRenderTarget: copies the given rectangle of the bitmap a
   device context draws to into the bitmap at a destination point. A missing render
   target, one without a bitmap, and an empty or out-of-range rectangle are E_INVALIDARG.
---
--- a/dlls/d2d1/bitmap.c
+++ b/dlls/d2d1/bitmap.c
@@ -184,9 +184,55 @@ static HRESULT STDMETHODCALLTYPE d2d_bitmap_CopyFromBitmap(ID2D1Bitmap1 *iface,
 static HRESULT STDMETHODCALLTYPE d2d_bitmap_CopyFromRenderTarget(ID2D1Bitmap1 *iface,
         const D2D1_POINT_2U *dst_point, ID2D1RenderTarget *render_target, const D2D1_RECT_U *src_rect)
 {
-    FIXME("iface %p, dst_point %p, render_target %p, src_rect %p stub!\n", iface, dst_point, render_target, src_rect);
+    struct d2d_bitmap *dst_bitmap = impl_from_ID2D1Bitmap1(iface);
+    struct d2d_bitmap *src_bitmap;
+    ID3D11DeviceContext *context;
+    ID3D11Device *device;
+    D3D11_BOX box;
+
+    TRACE("iface %p, dst_point %p, render_target %p, src_rect %p.\n", iface, dst_point, render_target, src_rect);
+
+    if (!render_target)
+        return E_INVALIDARG;
+
+    if (!(src_bitmap = d2d_render_target_get_bitmap(render_target)))
+    {
+        WARN("The render target does not draw to a bitmap.\n");
+        return E_INVALIDARG;
+    }
+
+    if (src_rect)
+    {
+#ifndef SG_MUTANT_D2D_COPYRT_NO_BOUNDS
+        if (src_rect->left >= src_rect->right || src_rect->top >= src_rect->bottom
+                || src_rect->right > src_bitmap->pixel_size.width || src_rect->bottom > src_bitmap->pixel_size.height)
+            return E_INVALIDARG;
+#endif
+
+        box.left = src_rect->left;
+        box.top = src_rect->top;
+        box.front = 0;
+        box.right = src_rect->right;
+        box.bottom = src_rect->bottom;
+        box.back = 1;
+    }
+
+    /* whatever was drawn has to be in the texture */
+    ID2D1RenderTarget_Flush(render_target, NULL, NULL);
+
+    ID3D11Resource_GetDevice(dst_bitmap->resource, &device);
+    ID3D11Device_GetImmediateContext(device, &context);
+    ID3D11DeviceContext_CopySubresourceRegion(context, dst_bitmap->resource, 0,
+#ifdef SG_MUTANT_D2D_COPYRT_SWAPPED_POINT
+            dst_point ? dst_point->y : 0, dst_point ? dst_point->x : 0, 0,
+#else
+            dst_point ? dst_point->x : 0, dst_point ? dst_point->y : 0, 0,
+#endif
+            src_bitmap->resource, 0, src_rect ? &box : NULL);
+    ID3D11DeviceContext_Release(context);
+    ID3D11Device_Release(device);
 
-    return E_NOTIMPL;
+    return S_OK;
 }
 
 static HRESULT STDMETHODCALLTYPE d2d_bitmap_CopyFromMemory(ID2D1Bitmap1 *iface,
