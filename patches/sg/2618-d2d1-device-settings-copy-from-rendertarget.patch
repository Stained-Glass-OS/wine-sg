--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -2916,13 +2916,32 @@ static void STDMETHODCALLTYPE d2d_device_context_GetTarget(ID2D1DeviceContext6 *
 static void STDMETHODCALLTYPE d2d_device_context_SetRenderingControls(ID2D1DeviceContext6 *iface,
         const D2D1_RENDERING_CONTROLS *rendering_controls)
 {
-    FIXME("iface %p, rendering_controls %p stub!\n", iface, rendering_controls);
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+
+    TRACE("iface %p, rendering_controls %p.\n", iface, rendering_controls);
+
+#ifdef SG_MUTANT_D2D_PRECISION_ANY
+    if (0)
+#else
+    if (rendering_controls->bufferPrecision > D2D1_BUFFER_PRECISION_32BPC_FLOAT)
+#endif
+    {
+        WARN("Unknown buffer precision %u.\n", rendering_controls->bufferPrecision);
+        return;
+    }
+
+    /* the settings are kept; rendering is done in the precision of the target */
+    context->rendering_controls = *rendering_controls;
 }
 
 static void STDMETHODCALLTYPE d2d_device_context_GetRenderingControls(ID2D1DeviceContext6 *iface,
