+
+    TRACE("iface %p, priority %#x.\n", iface, priority);
+
+#ifdef SG_MUTANT_D2D_PRIORITY_ANY
+    if (0)
+#else
+    if (priority != D2D1_RENDERING_PRIORITY_NORMAL && priority != D2D1_RENDERING_PRIORITY_LOW)
+#endif
+    {
+        WARN("Unknown priority %#x.\n", priority);
+        return;
+    }
+
+    device->rendering_priority = priority;
 }
 
 static HRESULT WINAPI d2d_device_CreateDeviceContext1(ID2D1Device6 *iface, D2D1_DEVICE_CONTEXT_OPTIONS options,
@@ -4940,7 +4985,20 @@ static HRESULT STDMETHODCALLTYPE d2d_device_ID2D1Device2_CreateDeviceContext(ID2
 static void STDMETHODCALLTYPE d2d_device_FlushDeviceContexts(ID2D1Device6 *iface,
         ID2D1Bitmap *bitmap)
 {
-    FIXME("iface %p, bitmap %p stub!\n", iface, bitmap);
+    struct d2d_device *device = impl_from_ID2D1Device(iface);
+    ID3D11DeviceContext *d3d_context;
+    ID3D11Device *d3d_device;
+
+    TRACE("iface %p, bitmap %p.\n", iface, bitmap);
+
+    /* drawing is recorded in the Direct3D context of the device; make it reach the GPU */
+    if (SUCCEEDED(IDXGIDevice_QueryInterface(device->dxgi_device, &IID_ID3D11Device, (void **)&d3d_device)))
+    {
+        ID3D11Device_GetImmediateContext(d3d_device, &d3d_context);
+        ID3D11DeviceContext_Flush(d3d_context);
+        ID3D11DeviceContext_Release(d3d_context);
+        ID3D11Device_Release(d3d_device);
+    }
 }
 
