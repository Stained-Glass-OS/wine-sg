From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: WindingModeOutline and output channels (6505)

GdipWindingModeOutline and GdipSetImageAttributesOutputChannel returned
NotImplemented. The outline is what the path fills under the winding
rule: the path is transformed and flattened, its edges split where they
cross, and the pieces with the filled area on one side only chained into
closed figures (overlapping figures merged, a pentagram's middle kept,
holes turned the other way kept). An output channel draws the image as
one CMYK channel in gray (C = 1 - R, M = 1 - G, Y = 1 - B, K their least).
---
diff --git a/dlls/gdiplus/gdiplus_private.h b/dlls/gdiplus/gdiplus_private.h
index b59acbf..abdee20 100644
--- a/dlls/gdiplus/gdiplus_private.h
+++ b/dlls/gdiplus/gdiplus_private.h
@@ -552,6 +552,8 @@ struct GpImageAttributes{
     BOOL threshold_enabled[ColorAdjustTypeCount];
     REAL threshold[ColorAdjustTypeCount];
     enum imageattr_noop noop[ColorAdjustTypeCount];
+    BOOL output_channel_enabled[ColorAdjustTypeCount];   /* 6505 */
+    ColorChannelFlags output_channel[ColorAdjustTypeCount];
 };
 
 struct GpFont{
diff --git a/dlls/gdiplus/graphics.c b/dlls/gdiplus/graphics.c
index b70c9dd..34affd7 100644
--- a/dlls/gdiplus/graphics.c
+++ b/dlls/gdiplus/graphics.c
@@ -989,6 +989,35 @@ PixelFormat apply_image_attributes(const GpImageAttributes *attributes, LPBYTE d
             }
     }
 
+    if (attributes->output_channel_enabled[type] || attributes->output_channel_enabled[ColorAdjustTypeDefault])
+    {
+        ColorChannelFlags channel = attributes->output_channel_enabled[type] ?
+                attributes->output_channel[type] : attributes->output_channel[ColorAdjustTypeDefault];
+
+        if (!data || fmt != PixelFormat32bppARGB)
+            return PixelFormat32bppARGB;
+
+#ifndef SG_MUTANT_GDIP_OUTPUT_CHANNEL_NONE
+        for (y=0; y<height; y++)
+            for (x=0; x<width; x++)
+            {
+                ARGB *src_color = (ARGB*)(data + stride * y + sizeof(ARGB) * x);
+                BYTE c = 255 - ((*src_color >> 16) & 0xff), m = 255 - ((*src_color >> 8) & 0xff),
+                     yl = 255 - (*src_color & 0xff), ink, k = min(c, min(m, yl));
+
+                switch (channel)
+                {
+                case ColorChannelFlagsC: ink = c; break;
+                case ColorChannelFlagsM: ink = m; break;
+                case ColorChannelFlagsY: ink = yl; break;
+                default: ink = k; break;
+                }
+                ink = 255 - ink;
+                *src_color = (*src_color & 0xff000000) | (ink << 16) | (ink << 8) | ink;
+            }
+#endif
+    }
+
     return fmt;
 }
 
diff --git a/dlls/gdiplus/graphicspath.c b/dlls/gdiplus/graphicspath.c
index 936d9dc..de2ccd6 100644
--- a/dlls/gdiplus/graphicspath.c
+++ b/dlls/gdiplus/graphicspath.c
@@ -2833,10 +2833,224 @@ GpStatus WINGDIPAPI GdipClearPathMarkers(GpPath* path)
     return Ok;
 }
 
+/* Stained Glass OS (wine-sg 6505): the outline of what the path fills under the winding rule.
+ * The path is transformed and flattened, its figures' edges split where they cross, and the
+ * pieces kept that have the filled area on one side only, turned so it lies on their left;
+ * they are chained into closed figures, which replace the path. */
+struct outline_edge
+{
+    GpPointF a, b;
+};
+
+/* the nonzero winding number of P against the figures (FIGS: start indices, NFIGS of them) */
+static int outline_winding(const GpPointF *pts, const INT *figs, INT nfigs, INT count, GpPointF p)
+{
+    int winding = 0;
+    INT f, i;
+
+    for (f = 0; f < nfigs; f++)
+    {
+        INT start = figs[f], end = f + 1 < nfigs ? figs[f + 1] : count;
+        for (i = start; i < end; i++)
+        {
+            GpPointF a = pts[i], b = pts[i + 1 < end ? i + 1 : start];
+            REAL cross = (b.X - a.X) * (p.Y - a.Y) - (p.X - a.X) * (b.Y - a.Y);
+            if (a.Y <= p.Y)
+            {
+                if (b.Y > p.Y && cross > 0) winding++;
+            }
+            else if (b.Y <= p.Y && cross < 0) winding--;
+        }
+    }
+    return winding;
+}
+
+static int outline_cmp_t(const void *a, const void *b)
+{
+    REAL x = *(const REAL *)a, y = *(const REAL *)b;
+    return x < y ? -1 : x > y;
+}
+
 GpStatus WINGDIPAPI GdipWindingModeOutline(GpPath *path, GpMatrix *matrix, REAL flatness)
 {
-   FIXME("stub: %p, %p, %.2f\n", path, matrix, flatness);
-   return NotImplemented;
+    struct outline_edge *edges = NULL, *kept = NULL;
+    GpPointF *pts = NULL, *out = NULL;
+    BYTE *types = NULL;
+    INT *figs = NULL, nfigs = 0, count, nedges = 0, nkept = 0, i, j, f, nout = 0;
+    REAL **splits = NULL;
+    INT *nsplits = NULL;
+    BOOL *used = NULL;
+    REAL eps;
+    GpStatus stat;
+
+    TRACE("(%p, %p, %.2f)\n", path, matrix, flatness);
+
+    if (!path)
+        return InvalidParameter;
+    if ((stat = GdipFlattenPath(path, matrix, flatness)) != Ok)
+        return stat;
+#ifdef SG_MUTANT_GDIP_OUTLINE_KEEP_ALL
+    return Ok;
+#endif
+    count = path->pathdata.Count;
+    if (count < 3)
+        return Ok;
+
+    stat = OutOfMemory;
+    if (!(pts = malloc(count * sizeof(*pts))) || !(figs = malloc(count * sizeof(*figs))) ||
+        !(edges = malloc(count * sizeof(*edges))))
+        goto done;
+    memcpy(pts, path->pathdata.Points, count * sizeof(*pts));
+    for (i = 0; i < count; i++)
+        if (!i || (path->pathdata.Types[i] & PathPointTypePathTypeMask) == PathPointTypeStart)
+            figs[nfigs++] = i;
+
+    /* the figures' edges, each figure closed */
+    for (f = 0; f < nfigs; f++)
+    {
+        INT start = figs[f], end = f + 1 < nfigs ? figs[f + 1] : count;
+        if (end - start < 3) continue;
+        for (i = start; i < end; i++)
+        {
+            GpPointF a = pts[i], b = pts[i + 1 < end ? i + 1 : start];
+            if (a.X == b.X && a.Y == b.Y) continue;
+            edges[nedges].a = a;
+            edges[nedges].b = b;
+            nedges++;
+        }
+    }
+
+    /* where edges cross: the parameters along each */
+    if (!(splits = calloc(nedges ? nedges : 1, sizeof(*splits))) || !(nsplits = calloc(nedges ? nedges : 1, sizeof(*nsplits))))
+        goto done;
+    for (i = 0; i < nedges; i++)
+    {
+        const struct outline_edge *e = &edges[i];
+        for (j = 0; j < nedges; j++)
+        {
+            const struct outline_edge *o = &edges[j];
+            REAL dx = e->b.X - e->a.X, dy = e->b.Y - e->a.Y, ox = o->b.X - o->a.X, oy = o->b.Y - o->a.Y;
+            REAL denom = dx * oy - dy * ox, t, u;
+            void *grown;
+
+            if (i == j || fabsf(denom) < 1e-12f)
+                continue;
+            if (max(e->a.X, e->b.X) < min(o->a.X, o->b.X) || max(o->a.X, o->b.X) < min(e->a.X, e->b.X) ||
+                max(e->a.Y, e->b.Y) < min(o->a.Y, o->b.Y) || max(o->a.Y, o->b.Y) < min(e->a.Y, e->b.Y))
+                continue;
+            t = ((o->a.X - e->a.X) * oy - (o->a.Y - e->a.Y) * ox) / denom;
+            u = ((o->a.X - e->a.X) * dy - (o->a.Y - e->a.Y) * dx) / denom;
+            if (t <= 1e-5f || t >= 1.0f - 1e-5f || u < -1e-5f || u > 1.0f + 1e-5f)
+                continue;
+            if (!(grown = realloc(splits[i], (nsplits[i] + 1) * sizeof(REAL))))
+                goto done;
+            splits[i] = grown;
+            splits[i][nsplits[i]++] = t;
+        }
+    }
+
+    /* the pieces with the filled area on one side only, the area on their left */
+    {
+        INT total = nedges;
+        for (i = 0; i < nedges; i++) total += nsplits[i];
+        if (!(kept = malloc((total ? total : 1) * sizeof(*kept))))
+            goto done;
+    }
+    for (i = 0; i < nedges; i++)
+    {
+        const struct outline_edge *e = &edges[i];
+        REAL prev = 0.0f;
+
+        if (nsplits[i]) qsort(splits[i], nsplits[i], sizeof(REAL), outline_cmp_t);
+        for (j = 0; j <= nsplits[i]; j++)
+        {
+            REAL t = j < nsplits[i] ? splits[i][j] : 1.0f, len, nx, ny, d;
+            GpPointF a, b, m, l, r;
+            BOOL in_l, in_r;
+            INT k;
+
+            if (t - prev < 1e-6f) continue;
+            a.X = e->a.X + (e->b.X - e->a.X) * prev; a.Y = e->a.Y + (e->b.Y - e->a.Y) * prev;
+            b.X = e->a.X + (e->b.X - e->a.X) * t;    b.Y = e->a.Y + (e->b.Y - e->a.Y) * t;
+            prev = t;
+            len = sqrtf((b.X - a.X) * (b.X - a.X) + (b.Y - a.Y) * (b.Y - a.Y));
+            if (len < 1e-6f) continue;
+            nx = -(b.Y - a.Y) / len; ny = (b.X - a.X) / len;
+            d = max(1e-4f, min(1e-2f, len * 1e-3f));
+            m.X = (a.X + b.X) / 2; m.Y = (a.Y + b.Y) / 2;
+            l.X = m.X + nx * d; l.Y = m.Y + ny * d;
+            r.X = m.X - nx * d; r.Y = m.Y - ny * d;
+            in_l = outline_winding(pts, figs, nfigs, count, l) != 0;
+            in_r = outline_winding(pts, figs, nfigs, count, r) != 0;
+            if (in_l == in_r) continue;
+            if (in_r) { GpPointF swap = a; a = b; b = swap; }
+            /* the same piece of two figures' shared edge once */
+            for (k = 0; k < nkept; k++)
+                if (fabsf(kept[k].a.X - a.X) < 1e-4f && fabsf(kept[k].a.Y - a.Y) < 1e-4f &&
+                    fabsf(kept[k].b.X - b.X) < 1e-4f && fabsf(kept[k].b.Y - b.Y) < 1e-4f)
+                    break;
+            if (k < nkept) continue;
+            kept[nkept].a = a;
+            kept[nkept].b = b;
+            nkept++;
+        }
+    }
+
+    /* chained into closed figures */
+    eps = 1e-3f;
+    if (!(used = calloc(nkept ? nkept : 1, sizeof(*used))) || !(out = malloc((nkept * 2 + 1) * sizeof(*out))) ||
+        !(types = malloc((nkept * 2 + 1) * sizeof(*types))))
+        goto done;
+    for (i = 0; i < nkept; i++)
+    {
+        INT first = nout, cur = i, steps = 0;
+
+        if (used[i]) continue;
+        used[i] = TRUE;
+        out[nout] = kept[i].a; types[nout++] = PathPointTypeStart;
+        for (;;)
+        {
+            GpPointF end = kept[cur].b;
+            INT next = -1;
+
+            if (fabsf(end.X - out[first].X) < eps && fabsf(end.Y - out[first].Y) < eps)
+                break;   /* closed */
+            for (j = 0; j < nkept; j++)
+                if (!used[j] && fabsf(kept[j].a.X - end.X) < eps && fabsf(kept[j].a.Y - end.Y) < eps)
+                {
+                    next = j;
+                    break;
+                }
+            out[nout] = end; types[nout++] = PathPointTypeLine;
+            if (next < 0 || ++steps > nkept) break;   /* an open end: closed as it is */
+            used[next] = TRUE;
+            cur = next;
+        }
+        if (nout - first < 3) { nout = first; continue; }
+        types[nout - 1] |= PathPointTypeCloseSubpath;
+    }
+
+    if (!lengthen_path(path, nout - path->pathdata.Count > 0 ? nout - path->pathdata.Count : 0))
+        goto done;
+    memcpy(path->pathdata.Points, out, nout * sizeof(*out));
+    memcpy(path->pathdata.Types, types, nout);
+    path->pathdata.Count = nout;
+    path->newfigure = TRUE;
+    stat = Ok;
+
+done:
+    if (splits)
+        for (i = 0; i < nedges; i++) free(splits[i]);
+    free(splits);
+    free(nsplits);
+    free(used);
+    free(out);
+    free(types);
+    free(kept);
+    free(edges);
+    free(figs);
+    free(pts);
+    return stat;
 }
 
 #define FLAGS_INTPATH 0x4000
diff --git a/dlls/gdiplus/imageattributes.c b/dlls/gdiplus/imageattributes.c
index 4a3da92..5f1a984 100644
--- a/dlls/gdiplus/imageattributes.c
+++ b/dlls/gdiplus/imageattributes.c
@@ -227,17 +227,24 @@ GpStatus WINGDIPAPI GdipSetImageAttributesNoOp(GpImageAttributes *imageAttr,
     return Ok;
 }
 
+/* Stained Glass OS (wine-sg 6505): the image drawn as one CMYK channel, in gray (white:
+ * none of that ink, black: all of it) -- prepress previews. Without a CMYK profile the
+ * channels are the plain conversion: C = 1 - R, M = 1 - G, Y = 1 - B, K = min(C, M, Y). */
 GpStatus WINGDIPAPI GdipSetImageAttributesOutputChannel(GpImageAttributes *imageAttr,
     ColorAdjustType type, BOOL enableFlag, ColorChannelFlags channelFlags)
 {
-    static int calls;
-
     TRACE("(%p,%u,%i,%x)\n", imageAttr, type, enableFlag, channelFlags);
 
-    if(!(calls++))
-        FIXME("not implemented\n");
+    if (!imageAttr || type >= ColorAdjustTypeCount)
+        return InvalidParameter;
+    if (enableFlag && (UINT)channelFlags >= ColorChannelFlagsLast)
+        return InvalidParameter;
 
-    return NotImplemented;
+    imageAttr->output_channel_enabled[type] = enableFlag;
+    if (enableFlag)
+        imageAttr->output_channel[type] = channelFlags;
+
+    return Ok;
 }
 
 GpStatus WINGDIPAPI GdipSetImageAttributesOutputChannelColorProfile(GpImageAttributes *imageAttr,
@@ -339,6 +346,7 @@ GpStatus WINGDIPAPI GdipResetImageAttributes(GpImageAttributes *imageAttr,
         return InvalidParameter;
 
     memset(&imageAttr->colormatrices[type], 0, sizeof(imageAttr->colormatrices[type]));
+    imageAttr->output_channel_enabled[type] = FALSE;
     GdipSetImageAttributesColorKeys(imageAttr, type, FALSE, 0, 0);
     GdipSetImageAttributesRemapTable(imageAttr, type, FALSE, 0, NULL);
     GdipSetImageAttributesGamma(imageAttr, type, FALSE, 0.0);
