From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: IFolderView2 items, selection, positions; SHCreateItemWithParent (2042)

IFolderView / IFolderView2 of the shell view: GetItemPosition,
GetDefaultSpacing (the system's icon spacing), GetAutoArrange (the view's
FWF_AUTOARRANGE flag), SelectAndPositionItems, GetItem (as an IShellItem or
other interface), GetVisibleItem, GetSelection (the folder itself when
nothing is selected and the caller asks for it), GetSelectionState and
InvokeVerbOnSelection (through the selection's context menu). SHCreateItemWithParent
creates an item from a parent folder or parent pidl and a child pidl. All
were stubs.
---
--- a/dlls/shell32/shlview.c
+++ b/dlls/shell32/shlview.c
@@ -4373,11 +4373,38 @@
     return S_OK;
 }
 
+HRESULT WINAPI SHCreateItemWithParent(PCIDLIST_ABSOLUTE pidl_parent, IShellFolder *psf, PCUITEMID_CHILD pidl,
+        REFIID riid, void **ppv);
+
+/* The index of the item of a pidl in the list, or -1 */
+static int folderview_find_item(IShellViewImpl *This, PCUITEMID_CHILD pidl)
+{
+    int i, count;
+    LVITEMW item;
+
+    if (!This->hWndList || !pidl) return -1;
+    count = SendMessageW(This->hWndList, LVM_GETITEMCOUNT, 0, 0);
+    for (i = 0; i < count; i++)
+    {
+        item.mask = LVIF_PARAM;
+        item.iItem = i;
+        item.iSubItem = 0;
+        if (!SendMessageW(This->hWndList, LVM_GETITEMW, 0, (LPARAM)&item) || !item.lParam) continue;
+        if (!HRESULT_CODE(IShellFolder_CompareIDs(This->pSFParent, 0, pidl, (PCUITEMID_CHILD)item.lParam))) return i;
+    }
+    return -1;
+}
+
 static HRESULT WINAPI FolderView_GetItemPosition(IFolderView2 *iface, PCUITEMID_CHILD pidl, POINT *ppt)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p)->(%p %p), stub\n", This, pidl, ppt);
-    return E_NOTIMPL;
+    int index;
+
+    TRACE("(%p)->(%p %p)\n", This, pidl, ppt);
+
+    if (!pidl || !ppt || !This->hWndList) return E_INVALIDARG;
+    if ((index = folderview_find_item(This, pidl)) < 0) return E_INVALIDARG;
+    return SendMessageW(This->hWndList, LVM_GETITEMPOSITION, index, (LPARAM)ppt) ? S_OK : E_FAIL;
 }
 
 static HRESULT WINAPI FolderView_GetSpacing(IFolderView2 *iface, POINT *pt)
@@ -4403,15 +4430,27 @@
 static HRESULT WINAPI FolderView_GetDefaultSpacing(IFolderView2 *iface, POINT *pt)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p)->(%p), stub\n", This, pt);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, pt);
+
+    if (!pt) return E_INVALIDARG;
+    /* the spacing of icons before a program changes it */
+    pt->x = GetSystemMetrics(SM_CXICONSPACING);
+    pt->y = GetSystemMetrics(SM_CYICONSPACING);
+    return S_OK;
 }
 
 static HRESULT WINAPI FolderView_GetAutoArrange(IFolderView2 *iface)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p), stub\n", This);
-    return E_NOTIMPL;
+
+    TRACE("(%p)\n", This);
+
+    if (!This->hWndList) return S_FALSE;
+#ifdef SG_MUTANT_FV_AUTOARRANGE
+    return S_FALSE;
+#endif
+    return (This->FolderSettings.fFlags & FWF_AUTOARRANGE) ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI FolderView_SelectItem(IFolderView2 *iface, int item, DWORD flags)
@@ -4453,8 +4492,30 @@
                                      PCUITEMID_CHILD_ARRAY apidl, POINT *apt, DWORD flags)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p)->(%u %p %p %lx), stub\n", This, cidl, apidl, apt, flags);
-    return E_NOTIMPL;
+    UINT i;
+
+    TRACE("(%p)->(%u %p %p %lx)\n", This, cidl, apidl, apt, flags);
+
+    if (!This->hWndList) return E_FAIL;
+    if (cidl && !apidl) return E_INVALIDARG;
+
+    /* the first item deselects the others when asked to, the rest add to the selection */
+    for (i = 0; i < cidl; i++)
+    {
+        int index = folderview_find_item(This, apidl[i]);
+        DWORD item_flags = i ? (flags & ~SVSI_DESELECTOTHERS) : flags;
+
+        if (index < 0) return E_INVALIDARG;
+        FolderView_SelectItem(iface, index, item_flags);
+#ifndef SG_MUTANT_FV_POSITION
+        if (apt)
+        {
+            POINT pt = apt[i];
+            SendMessageW(This->hWndList, LVM_SETITEMPOSITION32, index, (LPARAM)&pt);
+        }
+#endif
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI FolderView2_SetGroupBy(IFolderView2 *iface, REFPROPERTYKEY key, BOOL ascending)
@@ -4607,16 +4668,39 @@
 static HRESULT WINAPI FolderView2_GetItem(IFolderView2 *iface, int item, REFIID riid, void **ppv)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p)->(%d %s %p), stub\n", This, item, debugstr_guid(riid), ppv);
-    return E_NOTIMPL;
+    PITEMID_CHILD pidl;
+    HRESULT hr;
+
+    TRACE("(%p)->(%d %s %p)\n", This, item, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (FAILED(hr = FolderView_Item(iface, item, &pidl))) return hr;
+    hr = SHCreateItemWithParent(NULL, This->pSFParent, pidl, riid, ppv);
+    ILFree(pidl);
+    return hr;
 }
 
 static HRESULT WINAPI FolderView2_GetVisibleItem(IFolderView2 *iface, int start, BOOL previous,
     int *item)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p)->(%d %d %p), stub\n", This, start, previous, item);
-    return E_NOTIMPL;
+    int count, next;
+
+    TRACE("(%p)->(%d %d %p)\n", This, start, previous, item);
+
+    if (!item) return E_POINTER;
+    *item = -1;
+    if (!This->hWndList) return E_FAIL;
+
+    /* the item after the start, or before it; -1 starts from the end of the list */
+    count = SendMessageW(This->hWndList, LVM_GETITEMCOUNT, 0, 0);
+    if (previous) next = start < 0 ? count - 1 : start - 1;
+    else next = start + 1;
+    if (next < 0 || next >= count) return S_FALSE;
+
+    *item = next;
+    return S_OK;
 }
 
 static HRESULT WINAPI FolderView2_GetSelectedItem(IFolderView2 *iface, int start, int *item)
@@ -4635,23 +4719,93 @@
     IShellItemArray **array)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p)->(%d %p), stub\n", This, none_implies_folder, array);
-    return E_NOTIMPL;
+    UINT count;
+    HRESULT hr;
+
+    TRACE("(%p)->(%d %p)\n", This, none_implies_folder, array);
+
+    if (!array) return E_POINTER;
+    *array = NULL;
+    if (!This->hWndList) return E_FAIL;
+
+    if ((count = ShellView_GetSelections(This)))
+        return SHCreateShellItemArray(NULL, This->pSFParent, count, (LPCITEMIDLIST *)This->apidl, array);
+
+    /* nothing selected: the folder itself, when asked to */
+    if (none_implies_folder)
+    {
+        PIDLIST_ABSOLUTE folder = NULL;
+        IPersistFolder2 *pf2;
+
+        if (SUCCEEDED(IShellFolder_QueryInterface(This->pSFParent, &IID_IPersistFolder2, (void **)&pf2)))
+        {
+            IPersistFolder2_GetCurFolder(pf2, &folder);
+            IPersistFolder2_Release(pf2);
+        }
+        if (folder)
+        {
+            hr = SHCreateShellItemArrayFromIDLists(1, (PCIDLIST_ABSOLUTE_ARRAY)&folder, array);
+            ILFree(folder);
+            return hr;
+        }
+    }
+    return S_FALSE;
 }
 
 static HRESULT WINAPI FolderView2_GetSelectionState(IFolderView2 *iface, PCUITEMID_CHILD pidl,
     DWORD *flags)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p)->(%p %p), stub\n", This, pidl, flags);
-    return E_NOTIMPL;
+    int index;
+    UINT state;
+
+    TRACE("(%p)->(%p %p)\n", This, pidl, flags);
+
+    if (!pidl || !flags) return E_INVALIDARG;
+    *flags = 0;
+    if ((index = folderview_find_item(This, pidl)) < 0) return E_INVALIDARG;
+    state = SendMessageW(This->hWndList, LVM_GETITEMSTATE, index, LVIS_SELECTED | LVIS_FOCUSED);
+    if (state & LVIS_SELECTED) *flags |= SVSI_SELECT;
+    if (state & LVIS_FOCUSED) *flags |= SVSI_FOCUSED;
+    return S_OK;
 }
 
 static HRESULT WINAPI FolderView2_InvokeVerbOnSelection(IFolderView2 *iface, LPCSTR verb)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p)->(%s), stub\n", This, debugstr_a(verb));
-    return E_NOTIMPL;
+    IContextMenu *menu = NULL;
+    CMINVOKECOMMANDINFO cmi;
+    HMENU hmenu;
+    HRESULT hr;
+    UINT command = 0;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_a(verb));
+
+    if (!This->hWndList || !ShellView_GetSelections(This)) return S_FALSE;
+    hr = IShellFolder_GetUIObjectOf(This->pSFParent, This->hWndParent, This->cidl, (LPCITEMIDLIST *)This->apidl,
+                                    &IID_IContextMenu, NULL, (void **)&menu);
+    if (FAILED(hr) || !menu) return FAILED(hr) ? hr : E_FAIL;
+
+    /* the menu is built for the verbs to be known, and the default one is its default item */
+    hmenu = CreatePopupMenu();
+    hr = IContextMenu_QueryContextMenu(menu, hmenu, 0, FCIDM_SHVIEWFIRST, FCIDM_SHVIEWLAST, CMF_NORMAL | CMF_DEFAULTONLY);
+    if (SUCCEEDED(hr) && !verb)
+    {
+        command = GetMenuDefaultItem(hmenu, FALSE, GMDI_GOINTOPOPUPS);
+        if (command == ~0u) hr = E_FAIL;
+    }
+    if (SUCCEEDED(hr))
+    {
+        memset(&cmi, 0, sizeof(cmi));
+        cmi.cbSize = sizeof(cmi);
+        cmi.hwnd = This->hWndParent;
+        cmi.lpVerb = verb ? verb : MAKEINTRESOURCEA(command - FCIDM_SHVIEWFIRST);
+        cmi.nShow = SW_SHOWNORMAL;
+        hr = IContextMenu_InvokeCommand(menu, &cmi);
+    }
+    DestroyMenu(hmenu);
+    IContextMenu_Release(menu);
+    return hr;
 }
 
 static HRESULT WINAPI FolderView2_SetViewModeAndIconSize(IFolderView2 *iface, FOLDERVIEWMODE mode,
--- a/dlls/shell32/shellitem.c
+++ b/dlls/shell32/shellitem.c
@@ -747,9 +747,24 @@
 HRESULT WINAPI SHCreateItemWithParent(PCIDLIST_ABSOLUTE pidl_parent, IShellFolder *psf,
                                 PCUITEMID_CHILD pidl, REFIID riid, void **ppv)
 {
-    FIXME("(%p, %p, %p, %s, %p)\n", pidl_parent, psf, pidl, debugstr_guid(riid), ppv);
+    IShellItem *item;
+    HRESULT hr;
 
+    TRACE("(%p, %p, %p, %s, %p)\n", pidl_parent, psf, pidl, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+
+    /* the parent is given as a folder, or by its location */
+    if (!pidl || (!pidl_parent && !psf)) return E_INVALIDARG;
+
+#ifdef SG_MUTANT_ITEM_PARENT
     return E_NOTIMPL;
+#endif
+    if (FAILED(hr = SHCreateShellItem(pidl_parent, psf, pidl, &item))) return hr;
+    hr = IShellItem_QueryInterface(item, riid, ppv);
+    IShellItem_Release(item);
+    return hr;
 }
 
 HRESULT WINAPI SHCreateItemInKnownFolder(REFKNOWNFOLDERID rfid, DWORD flags,
