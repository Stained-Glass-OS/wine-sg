From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] urlmon: URLOpenPullStreamA

URLOpenPullStreamA, the ANSI form of URLOpenPullStreamW, was a spec stub.
---
--- a/dlls/urlmon/umstream.c
+++ b/dlls/urlmon/umstream.c
@@ -395,6 +395,35 @@
     return hr;
 }
 
+#ifndef SG_MUTANT_NO_PULL_STREAM_A
+/***********************************************************************
+ *		URLOpenPullStreamA (URLMON.@)
+ *
+ * (wine-sg 8280) The ANSI form of URLOpenPullStreamW.
+ */
+HRESULT WINAPI URLOpenPullStreamA(IUnknown *caller, const char *url, DWORD reserved, IBindStatusCallback *callback)
+{
+    WCHAR *urlW;
+    HRESULT hr;
+    int len;
+
+    TRACE("%p %s %lu %p\n", caller, debugstr_a(url), reserved, callback);
+
+    if (!url) return E_INVALIDARG;
+    len = MultiByteToWideChar(CP_ACP, 0, url, -1, NULL, 0);
+    if (!(urlW = malloc(len * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    MultiByteToWideChar(CP_ACP, 0, url, -1, urlW, len);
+    hr = URLOpenPullStreamW(caller, urlW, reserved, callback);
+    free(urlW);
+    return hr;
+}
+#else
+HRESULT WINAPI URLOpenPullStreamA(IUnknown *caller, const char *url, DWORD reserved, IBindStatusCallback *callback)
+{
+    return E_NOTIMPL;
+}
+#endif
+
 /***********************************************************************
  *		URLOpenPullStreamW (URLMON.@)
  */
--- a/dlls/urlmon/urlmon.spec
+++ b/dlls/urlmon/urlmon.spec
@@ -87,7 +87,7 @@
 @ stub URLDownloadW
 @ stdcall URLOpenBlockingStreamA(ptr str ptr long ptr)
 @ stdcall URLOpenBlockingStreamW(ptr wstr ptr long ptr)
-@ stub URLOpenPullStreamA
+@ stdcall URLOpenPullStreamA(ptr str long ptr)
 @ stdcall URLOpenPullStreamW(ptr wstr long ptr)
 @ stdcall URLOpenStreamA(ptr str long ptr)
 @ stdcall URLOpenStreamW(ptr wstr long ptr)
