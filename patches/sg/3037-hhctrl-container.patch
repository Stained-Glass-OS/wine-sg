From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 13:55:01 -0700
Subject: [PATCH] hhctrl: container site methods, in-memory storage for the web
 browser control, HH_PRETRANSLATEMESSAGE

- IOleClientSite/IOleInPlaceSite/IOleInPlaceFrame methods return the standard answers of a container
  without tools or menus instead of E_NOTIMPL; DeactivateAndUndo deactivates the control
- IID_IOleInPlaceFrame is answered with the frame interface
- the web browser control gets a real in-memory storage (StgCreateDocfile) instead of a stub IStorage
- HH_PRETRANSLATEMESSAGE lets the help windows process dialog keyboard messages

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/hhctrl.ocx/hhctrl.c b/dlls/hhctrl.ocx/hhctrl.c
index d4bc0b5..4a13ca6 100644
--- a/dlls/hhctrl.ocx/hhctrl.c
+++ b/dlls/hhctrl.ocx/hhctrl.c
@@ -388,12 +388,18 @@ HWND WINAPI HtmlHelpW(HWND caller, LPCWSTR filename, UINT command, DWORD_PTR dat
         return info->WinType.hwndHelp;
     }
     case HH_PRETRANSLATEMESSAGE: {
-        static BOOL warned = FALSE;
+        MSG *msg = (MSG *)data;
+        HHInfo *info;
 
-        if (!warned)
+        /* the caller's message loop hands keyboard messages to the help windows first */
+        if (!msg)
+            return 0;
+        LIST_FOR_EACH_ENTRY(info, &window_list, HHInfo, entry)
         {
-            FIXME("HH_PRETRANSLATEMESSAGE unimplemented\n");
-            warned = TRUE;
+            HWND help = info->WinType.hwndHelp;
+
+            if (help && (msg->hwnd == help || IsChild(help, msg->hwnd)) && IsDialogMessageW(help, msg))
+                return (HWND)TRUE;
         }
         return 0;
     }
