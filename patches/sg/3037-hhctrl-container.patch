 static HRESULT STDMETHODCALLTYPE InPlace_DeactivateAndUndo(IOleInPlaceSite *iface)
 {
-    return E_NOTIMPL;
+    WebBrowserContainer *This = impl_from_IOleInPlaceSite(iface);
+    IOleInPlaceObject *inplace;
+    HRESULT hr;
+
+    if (!This->ole_obj)
+        return E_UNEXPECTED;
+    if (FAILED(hr = IOleObject_QueryInterface(This->ole_obj, &IID_IOleInPlaceObject, (void **)&inplace)))
+        return hr;
+    hr = IOleInPlaceObject_InPlaceDeactivate(inplace);
+    IOleInPlaceObject_Release(inplace);
+    return hr;
 }
 
