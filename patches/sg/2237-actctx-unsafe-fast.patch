From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: RtlActivate/DeactivateActivationContextUnsafeFast, RtlQueryInformationActiveActivationContext

RtlActivateActivationContextUnsafeFast / RtlDeactivateActivationContextUnsafeFast
(frames in caller-allocated storage, no reference taken on the context) and
RtlQueryInformationActiveActivationContext were exported stubs, so a binary
importing them failed to load. Frames Wine allocates now carry flags saying
they hold a reference and are heap blocks, and popping a frame (early
deactivation, thread teardown) honours them: a caller frame is neither
freed nor does it drop a reference it never took.

---
--- a/dlls/ntdll/actctx.c
+++ b/dlls/ntdll/actctx.c
@@ -32,6 +32,7 @@
 #include "ddk/ntddk.h"
 #include "ddk/wdm.h"
 #include "ntdll_misc.h"
+#include "wine/asm.h"
 #include "wine/exception.h"
 #include "wine/debug.h"
 
@@ -3431,6 +3432,27 @@ static HANDLE get_current_actctx_no_addref(void)
     return NULL;
 }
 
+/* flags of an activation context stack frame (Windows' values) */
+#define FRAME_FLAG_RELEASE_ON_DEACTIVATE  0x01  /* the frame holds a reference to the context */
+#define FRAME_FLAG_HEAP_ALLOCATED         0x08  /* the frame is a heap block to free on deactivation */
+
+/* storage supplied by the caller of RtlActivateActivationContextUnsafeFast */
+struct caller_stack_frame
+{
+    SIZE_T  size;
+    ULONG   format;
+    RTL_ACTIVATION_CONTEXT_STACK_FRAME frame;
+    void   *extra[3];
+};
+#define CALLER_STACK_FRAME_FORMAT_WHISTLER 1
+
+/* pop a frame that is no longer active: drop the reference it holds, free it if it is ours */
+static void release_stack_frame( RTL_ACTIVATION_CONTEXT_STACK_FRAME *frame )
+{
+    if (frame->Flags & FRAME_FLAG_RELEASE_ON_DEACTIVATE) RtlReleaseActivationContext( frame->ActivationContext );
+    if (frame->Flags & FRAME_FLAG_HEAP_ALLOCATED) RtlFreeHeap( GetProcessHeap(), 0, frame );
+}
+
 /* find the appropriate activation context for RtlQueryInformationActivationContext */
 static NTSTATUS find_query_actctx( HANDLE *handle, DWORD flags, ULONG class )
 {
@@ -5454,7 +5476,7 @@ NTSTATUS WINAPI RtlActivateActivationContextEx( ULONG flags, TEB *teb, HANDLE ha
     frame = RtlAllocateHeap( GetProcessHeap(), HEAP_GENERATE_EXCEPTIONS, sizeof(*frame) );
     frame->Previous = actctx_stack->ActiveFrame;
     frame->ActivationContext = handle;
-    frame->Flags = 0;
+    frame->Flags = FRAME_FLAG_RELEASE_ON_DEACTIVATE | FRAME_FLAG_HEAP_ALLOCATED;
     actctx_stack->ActiveFrame = frame;
     RtlAddRefActivationContext( handle );
 
@@ -5491,13 +5513,67 @@ void WINAPI RtlDeactivateActivationContext( ULONG flags, ULONG_PTR cookie )
     while (top != actctx_stack->ActiveFrame)
     {
         frame = top->Previous;
-        RtlReleaseActivationContext( top->ActivationContext );
-        RtlFreeHeap( GetProcessHeap(), 0, top );
+        release_stack_frame( top );
         top = frame;
     }
 }
 
 
+/******************************************************************
+ *		RtlActivateActivationContextUnsafeFast (NTDLL.@)
+ *
+ * Activate a context in frame storage supplied by the caller. No reference
+ * is taken on the context: the caller keeps it alive until the matching
+ * RtlDeactivateActivationContextUnsafeFast.
+ */
+DEFINE_FASTCALL_WRAPPER( RtlActivateActivationContextUnsafeFast, 8 )
+RTL_ACTIVATION_CONTEXT_STACK_FRAME * FASTCALL RtlActivateActivationContextUnsafeFast( struct caller_stack_frame *frame, void *handle )
+{
+    ACTIVATION_CONTEXT_STACK *actctx_stack = NtCurrentTeb()->ActivationContextStackPointer;
+
+    frame->size   = sizeof(*frame);
+    frame->format = CALLER_STACK_FRAME_FORMAT_WHISTLER;
+    frame->frame.Previous = actctx_stack->ActiveFrame;
+    frame->frame.ActivationContext = handle;
+    frame->frame.Flags = 0;
+#ifdef SG_MUTANT_FRAME_OWNED
+    frame->frame.Flags = FRAME_FLAG_RELEASE_ON_DEACTIVATE | FRAME_FLAG_HEAP_ALLOCATED;
+#endif
+    actctx_stack->ActiveFrame = &frame->frame;
+    TRACE( "%p ctx %p\n", frame, handle );
+    return &frame->frame;
+}
+
+
+/******************************************************************
+ *		RtlDeactivateActivationContextUnsafeFast (NTDLL.@)
+ */
+DEFINE_FASTCALL_WRAPPER( RtlDeactivateActivationContextUnsafeFast, 4 )
+RTL_ACTIVATION_CONTEXT_STACK_FRAME * FASTCALL RtlDeactivateActivationContextUnsafeFast( struct caller_stack_frame *frame )
+{
+    ACTIVATION_CONTEXT_STACK *actctx_stack = NtCurrentTeb()->ActivationContextStackPointer;
+    RTL_ACTIVATION_CONTEXT_STACK_FRAME *top = actctx_stack->ActiveFrame;
+
+    TRACE( "%p\n", frame );
+
+    if (top != &frame->frame) RtlRaiseStatus( STATUS_SXS_EARLY_DEACTIVATION );
+    actctx_stack->ActiveFrame = frame->frame.Previous;
+    return actctx_stack->ActiveFrame;
+}
+
+
+/******************************************************************
+ *		RtlQueryInformationActiveActivationContext (NTDLL.@)
+ *
+ * RtlQueryInformationActivationContext on the context in effect for the thread.
+ */
+NTSTATUS WINAPI RtlQueryInformationActiveActivationContext( ULONG class, void *buffer, SIZE_T bufsize, SIZE_T *retlen )
+{
+    return RtlQueryInformationActivationContext( QUERY_ACTCTX_FLAG_USE_ACTIVE_ACTCTX, NULL, NULL, class,
+                                                 buffer, bufsize, retlen );
+}
+
+
 /******************************************************************
  *		RtlFreeThreadActivationContextStack (NTDLL.@)
  */
@@ -5518,8 +5594,7 @@ void WINAPI RtlFreeActivationContextStack( ACTIVATION_CONTEXT_STACK *actctx_stac
     while (frame)
     {
         RTL_ACTIVATION_CONTEXT_STACK_FRAME *prev = frame->Previous;
-        RtlReleaseActivationContext( frame->ActivationContext );
-        RtlFreeHeap( GetProcessHeap(), 0, frame );
+        release_stack_frame( frame );
         frame = prev;
     }
     actctx_stack->ActiveFrame = NULL;
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -482,7 +482,7 @@
 @ stdcall RtlAcquireSRWLockShared(ptr)
 @ stdcall RtlActivateActivationContext(long ptr ptr)
 @ stdcall RtlActivateActivationContextEx(long ptr ptr ptr)
-@ stub RtlActivateActivationContextUnsafeFast
+@ stdcall -fastcall RtlActivateActivationContextUnsafeFast(ptr ptr)
 @ stdcall RtlAddAccessAllowedAce(ptr long long ptr)
 @ stdcall RtlAddAccessAllowedAceEx(ptr long long long ptr)
 @ stdcall RtlAddAccessAllowedObjectAce(ptr long long long ptr ptr ptr)
@@ -606,7 +606,7 @@
 @ stub RtlCutoverTimeToSystemTime
 @ stdcall RtlDeNormalizeProcessParams(ptr)
 @ stdcall RtlDeactivateActivationContext(long long)
-@ stub RtlDeactivateActivationContextUnsafeFast
+@ stdcall -fastcall RtlDeactivateActivationContextUnsafeFast(ptr)
 @ stub RtlDebugPrintTimes
 @ stdcall RtlDecodePointer(ptr)
 @ stdcall RtlDecodeSystemPointer(ptr) RtlDecodePointer
@@ -943,7 +943,7 @@
 @ stdcall RtlQueryHeapInformation(long long ptr long ptr)
 @ stdcall RtlQueryInformationAcl(ptr ptr long long)
 @ stdcall RtlQueryInformationActivationContext(long long ptr long ptr long ptr)
-@ stub RtlQueryInformationActiveActivationContext
+@ stdcall RtlQueryInformationActiveActivationContext(long ptr long ptr)
 @ stub RtlQueryInterfaceMemoryStream
 @ stdcall RtlQueryPackageIdentity(long ptr ptr ptr ptr ptr)
 @ stdcall RtlQueryPerformanceCounter(ptr)
