+++ b/dlls/sapi/events.c
@@ -0,0 +1,373 @@
+/*
+ * Speech API (SAPI) event queue and notification, shared by the objects that
+ * are event sources (voices, audio devices).
+ *
+ * This library is free software; you can redistribute it and/or
