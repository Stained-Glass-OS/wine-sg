+    HWND hwnd;
+    UINT msg;
+    WPARAM wparam;
+    LPARAM lparam;
+    SPNOTIFYCALLBACK *callback;
+    void *callback_iface;
+    HANDLE event;
+};
+
+void events_init( struct sp_events *ev, ULONGLONG interest );
+void events_free( struct sp_events *ev );
+HRESULT events_set_notify_sink( struct sp_events *ev, ISpNotifySink *sink );
+HRESULT events_set_notify_window( struct sp_events *ev, HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam );
+HRESULT events_set_notify_callback( struct sp_events *ev, SPNOTIFYCALLBACK *callback, WPARAM wparam, LPARAM lparam );
+HRESULT events_set_notify_callback_interface( struct sp_events *ev, void *callback, WPARAM wparam, LPARAM lparam );
+HRESULT events_set_notify_event( struct sp_events *ev );
+HRESULT events_wait( struct sp_events *ev, DWORD timeout );
+HANDLE events_get_handle( struct sp_events *ev );
+HRESULT events_set_interest( struct sp_events *ev, ULONGLONG event, ULONGLONG queued );
+HRESULT events_get( struct sp_events *ev, ULONG count, SPEVENT *array, ULONG *fetched );
+HRESULT events_get_info( struct sp_events *ev, SPEVENTSOURCEINFO *info );
+HRESULT events_add( struct sp_events *ev, const SPEVENT *events, ULONG count );
