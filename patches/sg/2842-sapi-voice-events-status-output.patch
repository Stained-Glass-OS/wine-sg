+/* Queues audio from a wave stream to the output. */
+static HRESULT play_wave_stream(struct speech_voice *This, IStream *stream, const WAVEFORMATEX *wfx, DWORD flags,
+                                ULONG *number)
+{
+    struct async_result *result = NULL;
+    struct play_task *play;
+    SIZE_T size;
+    HRESULT hr;
+
+    if (!This->output && FAILED(hr = ISpVoice_SetOutput(&This->ISpVoice_iface, NULL, TRUE)))
+        return hr;
+
+    size = wfx->wFormatTag == WAVE_FORMAT_PCM ? sizeof(WAVEFORMATEX) : sizeof(WAVEFORMATEX) + wfx->cbSize;
+    if (!(play = calloc(1, sizeof(*play))))
+        return E_OUTOFMEMORY;
+    if (!(play->wfx = CoTaskMemAlloc(size)))
+    {
+        free(play);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(play->wfx, wfx, size);
+    if (wfx->wFormatTag == WAVE_FORMAT_PCM) play->wfx->cbSize = 0;
+
+    play->task.proc = play_proc;
+    play->voice = This;
+    IStream_AddRef(play->stream = stream);
+    play->stream_num = InterlockedIncrement(&This->cur_stream_num);
+
+    if (!(flags & SPF_ASYNC))
+    {
+        if (!(result = malloc(sizeof(*result))) || !(result->done = CreateEventW(NULL, FALSE, FALSE, NULL)))
+        {
+            free(result);
+            IStream_Release(stream);
+            CoTaskMemFree(play->wfx);
+            free(play);
+            return E_OUTOFMEMORY;
+        }
+        result->hr = E_FAIL;
+        play->result = result;
+    }
+
+    InterlockedIncrement(&This->pending);
+    if (FAILED(hr = async_queue_task(&This->queue, &play->task)))
+    {
+        InterlockedDecrement(&This->pending);
+        if (result)
+        {
+            CloseHandle(result->done);
+            free(result);
+        }
+        IStream_Release(stream);
+        CoTaskMemFree(play->wfx);
+        free(play);
+        return hr;
+    }
+
+    if (number) *number = play->stream_num;
+    if (flags & SPF_ASYNC) return S_OK;
+
+    WaitForSingleObject(result->done, INFINITE);
+    hr = result->hr;
+    CloseHandle(result->done);
+    free(result);
+    return hr;
+}
