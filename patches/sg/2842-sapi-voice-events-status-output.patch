+struct play_task
+{
+    struct async_task task;
+    struct async_result *result;
+
+    struct speech_voice *voice;
+    IStream *stream;
+    WAVEFORMATEX *wfx;
+    ULONG stream_num;
+};
+
+static void play_proc(struct async_task *task)
+{
+    struct play_task *play = (struct play_task *)task;
+    struct speech_voice *This = play->voice;
+    WAVEFORMATEX *output_wfx = NULL;
+    ISpAudio *audio = NULL;
+    GUID output_fmtid;
+    HRESULT hr = S_OK;
+    BYTE buf[4096];
+    ULONG read;
+
+    TRACE("(%p).\n", task);
+
+    EnterCriticalSection(&This->cs);
+
+    if (This->actions & SPVES_ABORT)
+    {
+        LeaveCriticalSection(&This->cs);
+        goto done;
+    }
+
+    This->cur_stream = play->stream_num;
+
+    /* The output takes the format of the audio it is given. */
+    if (SUCCEEDED(hr = ISpStreamFormat_GetFormat(This->output, &output_fmtid, &output_wfx)) &&
+        (memcmp(output_wfx, play->wfx, sizeof(WAVEFORMATEX)) || memcmp(output_wfx + 1, play->wfx + 1, output_wfx->cbSize)) &&
+        SUCCEEDED(ISpStreamFormat_QueryInterface(This->output, &IID_ISpAudio, (void **)&audio)))
+    {
+        hr = ISpAudio_SetFormat(audio, &SPDFID_WaveFormatEx, play->wfx);
+        ISpAudio_Release(audio);
+        audio = NULL;
+    }
+    CoTaskMemFree(output_wfx);
+    if (FAILED(hr))
+    {
+        LeaveCriticalSection(&This->cs);
+        goto done;
+    }
+
+    if (SUCCEEDED(ISpStreamFormat_QueryInterface(This->output, &IID_ISpAudio, (void **)&audio)))
+        ISpAudio_SetState(audio, This->paused ? SPAS_PAUSE : SPAS_RUN, 0);
+    This->actions = SPVES_RATE | SPVES_VOLUME;
+
+    LeaveCriticalSection(&This->cs);
+
+    voice_post_event(This, SPEI_START_INPUT_STREAM, play->stream_num);
+    while (SUCCEEDED(hr = IStream_Read(play->stream, buf, sizeof(buf), &read)) && read)
+    {
+        ULONG written;
+
+        EnterCriticalSection(&This->cs);
+        read = This->actions & SPVES_ABORT ? 0 : read;
+        LeaveCriticalSection(&This->cs);
+        if (!read) break;
+        if (FAILED(hr = ISpStreamFormat_Write(This->output, buf, read, &written)))
+            break;
+    }
+    if (SUCCEEDED(hr))
+    {
+        ISpStreamFormat_Commit(This->output, STGC_DEFAULT);
+        if (audio)
+            WaitForSingleObject(ISpAudio_EventHandle(audio), INFINITE);
+    }
+    voice_post_event(This, SPEI_END_INPUT_STREAM, play->stream_num);
+
+    EnterCriticalSection(&This->cs);
+    This->last_result = hr;
+    LeaveCriticalSection(&This->cs);
+
+done:
+    if (audio)
+    {
+        ISpAudio_SetState(audio, SPAS_CLOSED, 0);
+        ISpAudio_Release(audio);
+    }
+    IStream_Release(play->stream);
+    CoTaskMemFree(play->wfx);
+    InterlockedDecrement(&This->pending);
+
+    if (play->result)
+    {
+        play->result->hr = hr;
+        SetEvent(play->result->done);
+    }
+}
