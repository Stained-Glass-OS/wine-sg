+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "objbase.h"
+
+#include "sapiddk.h"
+#include "sperror.h"
+
+#include "sapi_private.h"
+
+void events_init(struct sp_events *ev, ULONGLONG interest)
+{
+    memset(ev, 0, sizeof(*ev));
+    InitializeCriticalSection(&ev->cs);
+    ev->event_interest = ev->queued_interest = interest;
+}
+
+static void clear_event(SPEVENT *event)
+{
+    switch (event->elParamType)
+    {
+        case SPET_LPARAM_IS_TOKEN:
+        case SPET_LPARAM_IS_OBJECT:
+            if (event->lParam) IUnknown_Release((IUnknown *)event->lParam);
+            break;
+        case SPET_LPARAM_IS_POINTER:
+        case SPET_LPARAM_IS_STRING:
+            CoTaskMemFree((void *)event->lParam);
+            break;
+    }
+    event->lParam = 0;
+}
+
+static void release_notify(struct sp_events *ev)
+{
+    if (ev->sink) ISpNotifySink_Release(ev->sink);
+    if (ev->event) CloseHandle(ev->event);
+    ev->sink = NULL;
+    ev->callback_iface = NULL;
+    ev->event = NULL;
+    ev->notify = NOTIFY_NONE;
+}
+
+void events_free(struct sp_events *ev)
+{
+    ULONG i;
+
+    for (i = 0; i < ev->count; i++)
+        clear_event(&ev->queue[i]);
+    free(ev->queue);
+    release_notify(ev);
+    DeleteCriticalSection(&ev->cs);
+}
+
+HRESULT events_set_notify_sink(struct sp_events *ev, ISpNotifySink *sink)
+{
+    HRESULT hr = S_OK;
+
+    if (!sink) return E_INVALIDARG;
+
+    EnterCriticalSection(&ev->cs);
+    if (ev->notify != NOTIFY_NONE) hr = SPERR_ALREADY_INITIALIZED;
+    else
+    {
+        ISpNotifySink_AddRef(ev->sink = sink);
+        ev->notify = NOTIFY_SINK;
+    }
+    LeaveCriticalSection(&ev->cs);
+    return hr;
+}
+
+HRESULT events_set_notify_window(struct sp_events *ev, HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    HRESULT hr = S_OK;
+
+    if (!hwnd) return E_INVALIDARG;
+
+    EnterCriticalSection(&ev->cs);
+    if (ev->notify != NOTIFY_NONE) hr = SPERR_ALREADY_INITIALIZED;
+    else
+    {
+        ev->hwnd = hwnd;
+        ev->msg = msg;
+        ev->wparam = wparam;
+        ev->lparam = lparam;
+        ev->notify = NOTIFY_WINDOW;
+    }
+    LeaveCriticalSection(&ev->cs);
+    return hr;
+}
+
+HRESULT events_set_notify_callback(struct sp_events *ev, SPNOTIFYCALLBACK *callback, WPARAM wparam, LPARAM lparam)
+{
+    HRESULT hr = S_OK;
+
+    if (!callback) return E_INVALIDARG;
+
+    EnterCriticalSection(&ev->cs);
+    if (ev->notify != NOTIFY_NONE) hr = SPERR_ALREADY_INITIALIZED;
+    else
+    {
+        ev->callback = callback;
+        ev->wparam = wparam;
+        ev->lparam = lparam;
+        ev->notify = NOTIFY_CALLBACK;
+    }
+    LeaveCriticalSection(&ev->cs);
+    return hr;
+}
+
+HRESULT events_set_notify_callback_interface(struct sp_events *ev, void *callback, WPARAM wparam, LPARAM lparam)
+{
+    HRESULT hr = S_OK;
+
+    if (!callback) return E_INVALIDARG;
+
+    EnterCriticalSection(&ev->cs);
+    if (ev->notify != NOTIFY_NONE) hr = SPERR_ALREADY_INITIALIZED;
+    else
+    {
+        ev->callback_iface = callback;
+        ev->wparam = wparam;
+        ev->lparam = lparam;
+        ev->notify = NOTIFY_CALLBACK_IFACE;
+    }
+    LeaveCriticalSection(&ev->cs);
+    return hr;
+}
+
+HRESULT events_set_notify_event(struct sp_events *ev)
+{
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&ev->cs);
+#ifdef SG_MUTANT_SAPIVOICE_NOTIFY_TWICE
+    if (ev->event) hr = S_OK;
+    else
+#endif
+    if (ev->notify != NOTIFY_NONE) hr = SPERR_ALREADY_INITIALIZED;
+    else if (!(ev->event = CreateEventW(NULL, TRUE, ev->count != 0, NULL)))
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    else
+        ev->notify = NOTIFY_EVENT;
+    LeaveCriticalSection(&ev->cs);
+    return hr;
+}
+
+HRESULT events_wait(struct sp_events *ev, DWORD timeout)
+{
+    HANDLE handle;
+    DWORD ret;
+
+    EnterCriticalSection(&ev->cs);
+    handle = ev->notify == NOTIFY_EVENT ? ev->event : NULL;
+    LeaveCriticalSection(&ev->cs);
+
+    if (!handle) return SPERR_UNINITIALIZED;
+    ret = WaitForSingleObject(handle, timeout);
+    if (ret == WAIT_OBJECT_0) return S_OK;
+    if (ret == WAIT_TIMEOUT) return S_FALSE;
+    return HRESULT_FROM_WIN32(GetLastError());
+}
+
+HANDLE events_get_handle(struct sp_events *ev)
+{
+    HANDLE handle;
+
+    EnterCriticalSection(&ev->cs);
+    handle = ev->notify == NOTIFY_EVENT ? ev->event : NULL;
+    LeaveCriticalSection(&ev->cs);
+    return handle;
+}
+
+HRESULT events_set_interest(struct sp_events *ev, ULONGLONG event, ULONGLONG queued)
+{
+    /* Both masks carry the two flag bits, and what is queued is a part of what is of interest. */
+    if ((event & SPFEI_FLAGCHECK) != SPFEI_FLAGCHECK || (queued & SPFEI_FLAGCHECK) != SPFEI_FLAGCHECK)
+        return E_INVALIDARG;
+    if (queued & ~event)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&ev->cs);
+    ev->event_interest = event;
+    ev->queued_interest = queued;
+    LeaveCriticalSection(&ev->cs);
+    return S_OK;
+}
+
+HRESULT events_get(struct sp_events *ev, ULONG count, SPEVENT *array, ULONG *fetched)
+{
+    ULONG n;
+
+    if (!count) return E_INVALIDARG;
+    if (!array) return E_POINTER;
+
+    EnterCriticalSection(&ev->cs);
+    n = min(count, ev->count);
+    memcpy(array, ev->queue, n * sizeof(*array));
+    memmove(ev->queue, ev->queue + n, (ev->count - n) * sizeof(*array));
+    ev->count -= n;
+    if (!ev->count && ev->event) ResetEvent(ev->event);
+    LeaveCriticalSection(&ev->cs);
+
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+HRESULT events_get_info(struct sp_events *ev, SPEVENTSOURCEINFO *info)
+{
+    if (!info) return E_POINTER;
+
+    EnterCriticalSection(&ev->cs);
+    info->ullEventInterest = ev->event_interest;
+    info->ullQueuedInterest = ev->queued_interest;
+    info->ulCount = ev->count;
+    LeaveCriticalSection(&ev->cs);
+    return S_OK;
+}
+
+/* Copies the event so that the queue owns its parameter. */
+static BOOL copy_event(SPEVENT *dst, const SPEVENT *src)
+{
+    *dst = *src;
+    switch (src->elParamType)
+    {
+        case SPET_LPARAM_IS_TOKEN:
+        case SPET_LPARAM_IS_OBJECT:
+            if (src->lParam) IUnknown_AddRef((IUnknown *)src->lParam);
+            break;
+        case SPET_LPARAM_IS_POINTER:
+        {
+            void *copy = NULL;
+            if (src->lParam && src->wParam)
+            {
+                if (!(copy = CoTaskMemAlloc(src->wParam))) return FALSE;
+                memcpy(copy, (void *)src->lParam, src->wParam);
+            }
+            dst->lParam = (LPARAM)copy;
+            break;
+        }
+        case SPET_LPARAM_IS_STRING:
+        {
+            WCHAR *copy = NULL;
+            if (src->lParam)
+            {
+                SIZE_T size = (wcslen((WCHAR *)src->lParam) + 1) * sizeof(WCHAR);
+                if (!(copy = CoTaskMemAlloc(size))) return FALSE;
+                memcpy(copy, (void *)src->lParam, size);
+            }
+            dst->lParam = (LPARAM)copy;
+            break;
+        }
+    }
+    return TRUE;
+}
+
+HRESULT events_add(struct sp_events *ev, const SPEVENT *events, ULONG count)
+{
+    ULONG i;
+    BOOL notify = FALSE;
+    enum notify_type type;
+    ISpNotifySink *sink = NULL;
+    SPNOTIFYCALLBACK *callback;
+    HWND hwnd;
+    UINT msg;
+    WPARAM wparam;
+    LPARAM lparam;
+    HANDLE event;
+    void *callback_iface;
+    HRESULT hr = S_OK;
+
+    if (count && !events) return E_POINTER;
+
+    EnterCriticalSection(&ev->cs);
+    for (i = 0; i < count; i++)
+    {
+        ULONGLONG bit = 1ull << events[i].eEventId;
+
+        if (events[i].eEventId >= 64) continue;
+#ifdef SG_MUTANT_SAPIVOICE_EVENT_NO_QUEUE
+        if (0)
+#else
+        if (ev->queued_interest & bit)
+#endif
+        {
+            if (ev->count == ev->capacity)
+            {
+                ULONG new_cap = ev->capacity ? ev->capacity * 2 : 16;
+                SPEVENT *new_queue = realloc(ev->queue, new_cap * sizeof(*new_queue));
+                if (!new_queue)
+                {
+                    hr = E_OUTOFMEMORY;
+                    break;
+                }
+                ev->queue = new_queue;
+                ev->capacity = new_cap;
+            }
+            if (!copy_event(&ev->queue[ev->count], &events[i]))
+            {
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+            ev->count++;
+            notify = TRUE;
+        }
+        else if (ev->event_interest & bit)
+            notify = TRUE;
+    }
+
+    type = ev->notify;
+    callback = ev->callback;
+    callback_iface = ev->callback_iface;
+    hwnd = ev->hwnd;
+    msg = ev->msg;
+    wparam = ev->wparam;
+    lparam = ev->lparam;
+    event = ev->event;
+    if (notify)
+    {
+        if (type == NOTIFY_SINK && (sink = ev->sink)) ISpNotifySink_AddRef(sink);
+        if (type == NOTIFY_EVENT && ev->count) SetEvent(event);
+    }
+    LeaveCriticalSection(&ev->cs);
+
+    if (!notify) return hr;
+
+    switch (type)
+    {
+        case NOTIFY_SINK:
+            ISpNotifySink_Notify(sink);
+            ISpNotifySink_Release(sink);
+            break;
+        case NOTIFY_WINDOW:
+            PostMessageW(hwnd, msg, wparam, lparam);
+            break;
+        case NOTIFY_CALLBACK:
+            callback(wparam, lparam);
+            break;
+        case NOTIFY_CALLBACK_IFACE:
+        {
+            /* ISpNotifyCallback is a plain C++ class: one virtual method, no reference counting. */
+            const struct notify_callback_vtbl *vtbl = *(const struct notify_callback_vtbl **)callback_iface;
+            vtbl->NotifyCallback(callback_iface, wparam, lparam);
+            break;
+        }
+        default:
+            break;
+    }
+    return hr;
+}
