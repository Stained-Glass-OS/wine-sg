+/* Keeps what ISpVoice::GetStatus reports up to date with the events of a stream. */
+static void voice_track_event(struct speech_voice *This, const SPEVENT *event)
+{
+    EnterCriticalSection(&This->cs);
+    switch (event->eEventId)
+    {
+        case SPEI_WORD_BOUNDARY:
+            This->word_pos = event->lParam;
+            This->word_len = event->wParam;
+            break;
+        case SPEI_SENTENCE_BOUNDARY:
+            This->sent_pos = event->lParam;
+            This->sent_len = event->wParam;
+            break;
+        case SPEI_TTS_BOOKMARK:
+            This->bookmark_id = event->wParam;
+            free(This->bookmark);
+            This->bookmark = event->elParamType == SPET_LPARAM_IS_STRING && event->lParam ?
+                    wcsdup((const WCHAR *)event->lParam) : NULL;
+            break;
+        case SPEI_PHONEME:
+            This->phoneme_id = HIWORD(event->lParam);
+            break;
+        case SPEI_VISEME:
+            This->viseme_id = HIWORD(event->lParam);
+            break;
+    }
+    LeaveCriticalSection(&This->cs);
+}
+
+static void voice_post_event(struct speech_voice *This, WORD id, ULONG stream_num)
+{
+    SPEVENT event = { 0 };
+
+    event.eEventId = id;
+    event.ulStreamNum = stream_num;
+    events_add(&This->events, &event, 1);
+}
