+
+/* Event queue and notification of an event source (events.c) */
+#define SPET_LPARAM_IS_UNDEFINED 0
+#define SPET_LPARAM_IS_TOKEN     1
+#define SPET_LPARAM_IS_OBJECT    2
+#define SPET_LPARAM_IS_POINTER   3
+#define SPET_LPARAM_IS_STRING    4
+
+#define SPFEI_FLAGCHECK       ((1ull << SPEI_RESERVED1) | (1ull << SPEI_RESERVED2))
+#define SPFEI(event)          ((1ull << (event)) | SPFEI_FLAGCHECK)
+#define SPFEI_ALL_TTS_EVENTS  (0x000000000000fffeull | SPFEI_FLAGCHECK)
