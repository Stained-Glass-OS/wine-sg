+#define TX_DEFAULT_TIMEOUT 60000
+
+/* wait for the replies of the enlistments in the given phase; cs is held */
+static BOOL tx_wait_replies(Transaction *tx, enum enlist_phase phase)
+{
+    DWORD timeout = tx->opts.ulTimeout ? tx->opts.ulTimeout : TX_DEFAULT_TIMEOUT;
+    ULONGLONG end = GetTickCount64() + timeout;
+    unsigned int i;
+
+    for (;;)
+    {
+        BOOL pending = FALSE;
+        ULONGLONG now;
+
+        for (i = 0; i < tx->count; i++)
+            if (tx->enlist[i]->phase == phase) pending = TRUE;
+        if (!pending) return TRUE;
+        if ((now = GetTickCount64()) >= end) return FALSE;
+        SleepConditionVariableCS(&tx->cond, &tx->cs, end - now);
+    }
+}
+
+/* snapshot of the enlistments, holding a reference on each; cs is held */
+static Enlistment **tx_snapshot(Transaction *tx, unsigned int *count)
+{
+    Enlistment **list;
+    unsigned int i;
+
+    *count = tx->count;
+    if (!(list = malloc((tx->count ? tx->count : 1) * sizeof(*list)))) return NULL;
+    for (i = 0; i < tx->count; i++)
+    {
+        list[i] = tx->enlist[i];
+        ITransactionEnlistmentAsync_AddRef(&list[i]->ITransactionEnlistmentAsync_iface);
+    }
+    return list;
+}
+
+static void tx_release_snapshot(Enlistment **list, unsigned int count)
+{
+    unsigned int i;
+
+    for (i = 0; i < count; i++)
+        ITransactionEnlistmentAsync_Release(&list[i]->ITransactionEnlistmentAsync_iface);
+    free(list);
+}
+
+/* tell the resources to abort; cs is held and left for the calls to the resources */
+static void tx_do_abort(Transaction *tx, BOID *reason)
+{
+    Enlistment **list;
+    unsigned int count, i;
+
+    tx->state = TX_ABORTING;
+    if (!(list = tx_snapshot(tx, &count)))
+    {
+        tx->state = TX_ABORTED;
+        return;
+    }
+
+    for (i = 0; i < count; i++)
+        if (list[i]->phase != EN_DONE) list[i]->phase = EN_ABORT_SENT;
+    LeaveCriticalSection(&tx->cs);
+
+    for (i = 0; i < count; i++)
+    {
+        HRESULT hr;
+
+        if (list[i]->phase != EN_ABORT_SENT) continue;
+        hr = ITransactionResourceAsync_AbortRequest(list[i]->res, reason, FALSE, NULL);
+        if (FAILED(hr))
+        {
+            EnterCriticalSection(&tx->cs);
+            list[i]->phase = EN_DONE;
+            LeaveCriticalSection(&tx->cs);
+        }
+    }
+
+    EnterCriticalSection(&tx->cs);
+    tx_wait_replies(tx, EN_ABORT_SENT);
+    tx->state = TX_ABORTED;
+    tx_release_snapshot(list, count);
+}
