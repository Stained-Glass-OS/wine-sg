 static HRESULT WINAPI Transaction_Commit(ITransaction *iface,
     BOOL fRetaining, DWORD grfTC, DWORD grfRM)
 {
-    FIXME("(%p, %d, %08lx, %08lx): stub\n", iface, fRetaining, grfTC, grfRM);
-    return E_NOTIMPL;
+    Transaction *This = impl_from_ITransaction(iface);
+    Enlistment **list;
+    unsigned int count, i;
+    BOOL ok = TRUE, single, any_commit = FALSE;
+    HRESULT hr;
+
+    TRACE("(%p, %d, %08lx, %08lx)\n", iface, fRetaining, grfTC, grfRM);
+
+    if (fRetaining) return XACT_E_NOTSUPPORTED;
+
+    EnterCriticalSection(&This->cs);
+    if (This->state != TX_ACTIVE)
+    {
+        hr = This->state == TX_ABORTED ? XACT_E_ABORTED : XACT_E_NOTRANSACTION;
+        LeaveCriticalSection(&This->cs);
+        return hr;
+    }
+
+    This->state = TX_PREPARING;
+    if (!(list = tx_snapshot(This, &count)))
+    {
+        This->state = TX_ACTIVE;
+        LeaveCriticalSection(&This->cs);
+        return E_OUTOFMEMORY;
+    }
+    single = count == 1;
+    for (i = 0; i < count; i++) list[i]->phase = EN_PREPARE_SENT;
+    LeaveCriticalSection(&This->cs);
+
+    /* phase one */
+    for (i = 0; i < count; i++)
+    {
+        hr = ITransactionResourceAsync_PrepareRequest(list[i]->res, FALSE, grfRM, FALSE, single);
+        if (FAILED(hr))
+        {
+            EnterCriticalSection(&This->cs);
+            list[i]->phase = EN_PREPARED;
+            list[i]->reply = hr;
+            LeaveCriticalSection(&This->cs);
+        }
+    }
+
+    EnterCriticalSection(&This->cs);
+    if (!tx_wait_replies(This, EN_PREPARE_SENT)) ok = FALSE;
+    for (i = 0; i < count && ok; i++)
+    {
+        if (list[i]->phase == EN_PREPARE_SENT) ok = FALSE;
+        else if (FAILED(list[i]->reply)) ok = FALSE;
+    }
+
+    if (!ok)
+    {
+        tx_do_abort(This, NULL);
+        LeaveCriticalSection(&This->cs);
+        tx_release_snapshot(list, count);
+        return XACT_E_ABORTED;
+    }
+
+    /* phase two */
+    This->state = TX_COMMITTING;
+    for (i = 0; i < count; i++)
+    {
+        if (list[i]->readonly || list[i]->committed_single)
+            list[i]->phase = EN_DONE;
+        else
+        {
+            list[i]->phase = EN_COMMIT_SENT;
+            any_commit = TRUE;
+        }
+    }
+    LeaveCriticalSection(&This->cs);
+
+    for (i = 0; i < count; i++)
+    {
+        if (list[i]->phase != EN_COMMIT_SENT) continue;
+        hr = ITransactionResourceAsync_CommitRequest(list[i]->res, grfRM, NULL);
+        if (FAILED(hr))
+        {
+            EnterCriticalSection(&This->cs);
+            list[i]->phase = EN_DONE;
+            LeaveCriticalSection(&This->cs);
+        }
+    }
+
+    EnterCriticalSection(&This->cs);
+    if (any_commit) tx_wait_replies(This, EN_COMMIT_SENT);
+    This->state = TX_COMMITTED;
+    LeaveCriticalSection(&This->cs);
+
+    tx_release_snapshot(list, count);
+    return S_OK;
 }
