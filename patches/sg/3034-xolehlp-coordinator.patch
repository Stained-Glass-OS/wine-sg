+/* Enlistment: what a resource manager uses to answer the transaction manager */
+
+static inline Enlistment *impl_from_ITransactionEnlistmentAsync(ITransactionEnlistmentAsync *iface)
+{
+    return CONTAINING_RECORD(iface, Enlistment, ITransactionEnlistmentAsync_iface);
+}
+
+static HRESULT WINAPI Enlistment_QueryInterface(ITransactionEnlistmentAsync *iface, REFIID iid, void **ppv)
+{
+    TRACE("(%p,%s,%p)\n", iface, debugstr_guid(iid), ppv);
+
+    if (!ppv) return E_INVALIDARG;
+    if (IsEqualIID(&IID_IUnknown, iid) || IsEqualIID(&IID_ITransactionEnlistmentAsync, iid))
+    {
+        *ppv = iface;
+        ITransactionEnlistmentAsync_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI Enlistment_AddRef(ITransactionEnlistmentAsync *iface)
+{
+    Enlistment *This = impl_from_ITransactionEnlistmentAsync(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI Enlistment_Release(ITransactionEnlistmentAsync *iface)
+{
+    Enlistment *This = impl_from_ITransactionEnlistmentAsync(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        Transaction *tx = This->tx;
+        unsigned int i;
+
+        EnterCriticalSection(&tx->cs);
+        for (i = 0; i < tx->count; i++)
+        {
+            if (tx->enlist[i] != This) continue;
+            tx->enlist[i] = tx->enlist[--tx->count];
+            break;
+        }
+        LeaveCriticalSection(&tx->cs);
+
+        ITransactionResourceAsync_Release(This->res);
+        Transaction_Release(&tx->ITransaction_iface);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT enlistment_reply(Enlistment *This, enum enlist_phase expected, HRESULT hr)
+{
+    Transaction *tx = This->tx;
+    HRESULT ret = S_OK;
+
+    EnterCriticalSection(&tx->cs);
+    if (This->phase != expected)
+        ret = E_UNEXPECTED;
+    else
+    {
+        This->reply = hr;
+        if (expected == EN_PREPARE_SENT)
+        {
+            This->phase = EN_PREPARED;
+            if (hr == XACT_S_READONLY) This->readonly = TRUE;
+            if (hr == XACT_S_SINGLEPHASE) This->committed_single = TRUE;
+        }
+        else
+            This->phase = EN_DONE;
+    }
+    WakeAllConditionVariable(&tx->cond);
+    LeaveCriticalSection(&tx->cs);
+    return ret;
+}
+
+static HRESULT WINAPI Enlistment_PrepareRequestDone(ITransactionEnlistmentAsync *iface, HRESULT hr,
+        IMoniker *pmk, BOID *pboidReason)
+{
+    Enlistment *This = impl_from_ITransactionEnlistmentAsync(iface);
+
+    TRACE("(%p, %08lx, %p, %p)\n", iface, hr, pmk, pboidReason);
+
+    /* the read-only and single phase answers are successes */
+    return enlistment_reply(This, EN_PREPARE_SENT, hr);
+}
+
+static HRESULT WINAPI Enlistment_CommitRequestDone(ITransactionEnlistmentAsync *iface, HRESULT hr)
+{
+    Enlistment *This = impl_from_ITransactionEnlistmentAsync(iface);
+
+    TRACE("(%p, %08lx)\n", iface, hr);
+
+    return enlistment_reply(This, EN_COMMIT_SENT, hr);
+}
+
+static HRESULT WINAPI Enlistment_AbortRequestDone(ITransactionEnlistmentAsync *iface, HRESULT hr)
+{
+    Enlistment *This = impl_from_ITransactionEnlistmentAsync(iface);
+
+    TRACE("(%p, %08lx)\n", iface, hr);
+
+    return enlistment_reply(This, EN_ABORT_SENT, hr);
+}
+
+static const ITransactionEnlistmentAsyncVtbl Enlistment_Vtbl = {
+    Enlistment_QueryInterface,
+    Enlistment_AddRef,
+    Enlistment_Release,
+    Enlistment_PrepareRequestDone,
+    Enlistment_CommitRequestDone,
+    Enlistment_AbortRequestDone
+};
+
+static HRESULT Enlistment_Create(Transaction *tx, ITransactionResourceAsync *res, Enlistment **out)
+{
+    Enlistment *This, **list;
+
+    EnterCriticalSection(&tx->cs);
+    if (tx->state != TX_ACTIVE)
+    {
+        LeaveCriticalSection(&tx->cs);
+        return XACT_E_NOTRANSACTION;
+    }
+
+    if (!(This = calloc(1, sizeof(*This))) || !(list = realloc(tx->enlist, (tx->count + 1) * sizeof(*list))))
+    {
+        free(This);
+        LeaveCriticalSection(&tx->cs);
+        return E_OUTOFMEMORY;
+    }
+    This->ITransactionEnlistmentAsync_iface.lpVtbl = &Enlistment_Vtbl;
+    This->ref = 1;
+    This->tx = tx;
+    This->res = res;
+    ITransactionResourceAsync_AddRef(res);
+    Transaction_AddRef(&tx->ITransaction_iface);
+    tx->enlist = list;
+    tx->enlist[tx->count++] = This;
+    LeaveCriticalSection(&tx->cs);
+
+    *out = This;
+    return S_OK;
+}
