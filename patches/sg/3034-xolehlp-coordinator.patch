 static HRESULT WINAPI Transaction_Abort(ITransaction *iface,
     BOID *pboidReason, BOOL fRetaining, BOOL fAsync)
 {
-    FIXME("(%p, %p, %d, %d): stub\n", iface, pboidReason, fRetaining, fAsync);
-    return E_NOTIMPL;
+    Transaction *This = impl_from_ITransaction(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("(%p, %p, %d, %d)\n", iface, pboidReason, fRetaining, fAsync);
+
+    if (fRetaining) return XACT_E_NOTSUPPORTED;
+
+    EnterCriticalSection(&This->cs);
+    if (This->state == TX_ACTIVE)
+        tx_do_abort(This, pboidReason);
+    else if (This->state != TX_ABORTED)
+        hr = XACT_E_NOTRANSACTION;
+    LeaveCriticalSection(&This->cs);
+    return hr;
 }
