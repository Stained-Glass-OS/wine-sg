From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: IoGetDeviceInterfaces.

It returned STATUS_NOT_IMPLEMENTED. It now returns the symbolic links of the
registered interfaces of a device interface class as a multi-string
allocated from paged pool (an empty list is a single null): the enabled ones,
and with DEVICE_INTERFACE_INCLUDE_NONACTIVE the disabled ones as well,
narrowed to the device's interfaces when a PDO is given
(STATUS_INVALID_DEVICE_REQUEST when it is not a device with an id).

Test: the PnP test driver checks the lists before and after the interface is
enabled; gate test/ntoskrnl-pnptest-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/pnp.c b/dlls/ntoskrnl.exe/pnp.c
--- a/dlls/ntoskrnl.exe/pnp.c
+++ b/dlls/ntoskrnl.exe/pnp.c
@@ -953,6 +953,116 @@
 }
 
 /***********************************************************************
+ *           IoGetDeviceInterfaces   (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI IoGetDeviceInterfaces( const GUID *class_guid, DEVICE_OBJECT *pdo, ULONG flags, WCHAR **list )
+{
+    SP_DEVICE_INTERFACE_DATA iface = {sizeof(iface)};
+    WCHAR pdo_id[MAX_DEVICE_ID_LEN];
+    WCHAR *out = NULL, *result;
+    SIZE_T used = 0, capacity = 0;
+    NTSTATUS status = STATUS_SUCCESS;
+    HDEVINFO set;
+    DWORD i;
+
+    TRACE( "class %s, pdo %p, flags %#lx, list %p.\n", debugstr_guid( class_guid ), pdo, flags, list );
+
+    if (pdo && get_device_instance_id( pdo, pdo_id )) return STATUS_INVALID_DEVICE_REQUEST;
+
+    set = SetupDiGetClassDevsW( class_guid, NULL, NULL, DIGCF_DEVICEINTERFACE );
+    if (set == INVALID_HANDLE_VALUE) set = NULL;
+
+#ifdef SG_MUTANT_IFACES_EMPTY
+    if (set) SetupDiDestroyDeviceInfoList( set );
+    set = NULL;
+#endif
+    for (i = 0; set && SetupDiEnumDeviceInterfaces( set, NULL, class_guid, i, &iface ); i++)
+    {
+        SP_DEVINFO_DATA sp_device = {sizeof(sp_device)};
+        SP_DEVICE_INTERFACE_DETAIL_DATA_W *detail;
+        struct device_interface *known = NULL, *entry;
+        DWORD size = 0;
+        WCHAR *path;
+        SIZE_T len;
+
+#ifndef SG_MUTANT_IFACES_ALL
+        if (!(flags & DEVICE_INTERFACE_INCLUDE_NONACTIVE) && !(iface.Flags & SPINT_ACTIVE)) continue;
+#endif
+        SetupDiGetDeviceInterfaceDetailW( set, &iface, NULL, 0, &size, NULL );
+        if (!size || !(detail = malloc( size ))) continue;
+        detail->cbSize = sizeof(*detail);
+        if (!SetupDiGetDeviceInterfaceDetailW( set, &iface, detail, size, NULL, &sp_device ))
+        {
+            free( detail );
+            continue;
+        }
+
+        if (pdo)
+        {
+            WCHAR id[MAX_DEVICE_ID_LEN];
+
+            if (!SetupDiGetDeviceInstanceIdW( set, &sp_device, id, ARRAY_SIZE(id), NULL ) || wcsicmp( id, pdo_id ))
+            {
+                free( detail );
+                continue;
+            }
+        }
+
+        /* the kernel form of the path: \??\ in place of \\?\ (setupapi's case is its own; the
+         * interfaces registered in this process keep the case they were registered with) */
+        len = wcslen( detail->DevicePath );
+        if (!(path = malloc( (len + 1) * sizeof(WCHAR) )))
+        {
+            free( detail );
+            continue;
+        }
+        wcscpy( path, detail->DevicePath );
+        free( detail );
+        if (len >= 4) path[1] = '?';
+        WINE_RB_FOR_EACH_ENTRY( entry, &device_interfaces, struct device_interface, entry )
+        {
+            if (entry->symbolic_link.Length == len * sizeof(WCHAR) && !wcsnicmp( entry->symbolic_link.Buffer, path, len ))
+            {
+                known = entry;
+                break;
+            }
+        }
+        if (known) memcpy( path, known->symbolic_link.Buffer, len * sizeof(WCHAR) );
+
+        if (used + len + 2 > capacity)
+        {
+            WCHAR *new = realloc( out, (capacity = max( capacity * 2, used + len + 2 )) * sizeof(WCHAR) );
+
+            if (!new)
+            {
+                free( path );
+                status = STATUS_INSUFFICIENT_RESOURCES;
+                break;
+            }
+            out = new;
+        }
+        memcpy( out + used, path, (len + 1) * sizeof(WCHAR) );
+        used += len + 1;
+        free( path );
+    }
+    if (set) SetupDiDestroyDeviceInfoList( set );
+
+    if (!status)
+    {
+        /* the strings end with an extra null; an empty list is a single null */
+        if (!(result = ExAllocatePool( PagedPool, (used + 1) * sizeof(WCHAR) ))) status = STATUS_INSUFFICIENT_RESOURCES;
+        else
+        {
+            if (used) memcpy( result, out, used * sizeof(WCHAR) );
+            result[used] = 0;
+            *list = result;
+        }
+    }
+    free( out );
+    return status;
+}
+
+/***********************************************************************
  *           IoRegisterDeviceInterface (NTOSKRNL.EXE.@)
  */
 NTSTATUS WINAPI IoRegisterDeviceInterface(DEVICE_OBJECT *device, const GUID *class_guid,
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -2060,19 +2060,6 @@
 }
 
 /***********************************************************************
- *           IoGetDeviceInterfaces   (NTOSKRNL.EXE.@)
- */
-NTSTATUS WINAPI IoGetDeviceInterfaces( const GUID *InterfaceClassGuid,
-                                       PDEVICE_OBJECT PhysicalDeviceObject,
-                                       ULONG Flags, PWSTR *SymbolicLinkList )
-{
-    FIXME( "stub: %s %p %lx %p\n", debugstr_guid(InterfaceClassGuid),
-           PhysicalDeviceObject, Flags, SymbolicLinkList );
-    return STATUS_NOT_IMPLEMENTED;
-}
-
-
-/***********************************************************************
  *           IoGetDeviceObjectPointer   (NTOSKRNL.EXE.@)
  */
 NTSTATUS  WINAPI IoGetDeviceObjectPointer( UNICODE_STRING *name, ACCESS_MASK access, PFILE_OBJECT *file, PDEVICE_OBJECT *device )
diff --git a/dlls/ntoskrnl.exe/tests/driver_pnp.c b/dlls/ntoskrnl.exe/tests/driver_pnp.c
--- a/dlls/ntoskrnl.exe/tests/driver_pnp.c
+++ b/dlls/ntoskrnl.exe/tests/driver_pnp.c
@@ -299,7 +299,10 @@
             static const WCHAR expect_symlink[] = L"\\??\\Wine#Test#1#{deadbeef-29ef-4538-a5fd-b69573a362c2}";
             static const LARGE_INTEGER wait_time = {.QuadPart = -500 * 10000};
             POWER_STATE state = {.DeviceState = PowerDeviceD0};
+            static const GUID unknown_class = {0xdeadbeef, 0x29ef, 0x4538, {0xa5, 0xfd, 0xb6, 0x95, 0x73, 0xa3, 0x62, 0xc3}};
+            WCHAR *list, *p;
             NTSTATUS status;
+            BOOL found;
 
             irp_queue_init(&device->irp_queue);
 
@@ -315,8 +318,37 @@
             ok(!kmemcmp(device->child_symlink.Buffer, expect_symlink, device->child_symlink.MaximumLength),
                     "Got symlink \"%ls\".\n", device->child_symlink.Buffer);
 
+            /* registered but not enabled yet */
+            status = IoGetDeviceInterfaces(&child_class, device_obj, 0, &list);
+            ok(!status, "Failed to get interfaces, status %#lx.\n", status);
+            ok(list && !list[0], "expected an empty list, got \"%ls\".\n", list);
+            if (!status) ExFreePool(list);
+            status = IoGetDeviceInterfaces(&child_class, device_obj, DEVICE_INTERFACE_INCLUDE_NONACTIVE, &list);
+            ok(!status, "Failed to get interfaces, status %#lx.\n", status);
+            ok(list && !_wcsicmp(list, device->child_symlink.Buffer) && !list[wcslen(list) + 1],
+                    "got list \"%ls\".\n", list);
+            if (!status) ExFreePool(list);
+
             IoSetDeviceInterfaceState(&device->child_symlink, TRUE);
 
+            status = IoGetDeviceInterfaces(&child_class, device_obj, 0, &list);
+            ok(!status, "Failed to get interfaces, status %#lx.\n", status);
+            ok(list && !_wcsicmp(list, device->child_symlink.Buffer) && !list[wcslen(list) + 1],
+                    "got list \"%ls\".\n", list);
+            if (!status) ExFreePool(list);
+
+            status = IoGetDeviceInterfaces(&child_class, NULL, 0, &list);
+            ok(!status, "Failed to get interfaces, status %#lx.\n", status);
+            for (p = list, found = FALSE; !status && *p; p += wcslen(p) + 1)
+                if (!_wcsicmp(p, device->child_symlink.Buffer)) found = TRUE;
+            ok(found, "the interface is not in the list of the class\n");
+            if (!status) ExFreePool(list);
+
+            status = IoGetDeviceInterfaces(&unknown_class, NULL, DEVICE_INTERFACE_INCLUDE_NONACTIVE, &list);
+            ok(!status, "Failed to get interfaces, status %#lx.\n", status);
+            ok(list && !list[0], "expected an empty list, got \"%ls\".\n", list);
+            if (!status) ExFreePool(list);
+
             state = PoSetPowerState(device_obj, DevicePowerState, state);
             ok(state.DeviceState == device->power_state, "got previous state %u\n", state.DeviceState);
             device->power_state = PowerDeviceD0;
