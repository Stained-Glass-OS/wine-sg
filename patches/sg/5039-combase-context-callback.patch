From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: Run ContextCallback for callers in the context.

IContextCallback::ContextCallback on the object context runs the function
and returns its result when the caller is already in that context: on the
context's own thread, or on any MTA thread for a context that belongs to
the MTA. It returned E_NOTIMPL. Entering an STA's context from another
apartment is still not supported (FIXME).

Gate: test/combase-ctxcallback-gate.sh (64/32).
---
 dlls/combase/combase.c | 42 +++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 41 insertions(+), 1 deletion(-)

diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index d63d6bc..20bab20 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -2646,6 +2646,8 @@ struct thread_context
     IContextCallback IContextCallback_iface;
     IObjContext IObjContext_iface;
     LONG refcount;
+    DWORD tid;      /* the thread whose context this is */
+    BOOL mta;       /* made in the MTA, whose threads share one context */
 };
 
 static inline struct thread_context *impl_from_IComThreadingInfo(IComThreadingInfo *iface)
@@ -2791,11 +2793,34 @@ static ULONG WINAPI thread_context_callback_Release(IContextCallback *iface)
     return IComThreadingInfo_Release(&context->IComThreadingInfo_iface);
 }
 
+/* is the caller in this context: its thread, or the MTA for an MTA context */
+static BOOL thread_context_is_current(const struct thread_context *context)
+{
+    struct apartment *apt;
+    BOOL ret;
+
+    if (context->tid == GetCurrentThreadId()) return TRUE;
+    if (!context->mta || !(apt = apartment_get_current_or_mta())) return FALSE;
+    ret = apt->multi_threaded;
+    apartment_release(apt);
+    return ret;
+}
+
 static HRESULT WINAPI thread_context_callback_ContextCallback(IContextCallback *iface,
         PFNCONTEXTCALL callback, ComCallData *param, REFIID riid, int method, IUnknown *punk)
 {
-    FIXME("%p, %p, %p, %s, %d, %p\n", iface, callback, param, debugstr_guid(riid), method, punk);
+    struct thread_context *context = impl_from_IContextCallback(iface);
+
+    TRACE("%p, %p, %p, %s, %d, %p\n", iface, callback, param, debugstr_guid(riid), method, punk);
 
+    if (!callback) return E_INVALIDARG;
+    /* "Enters the object context, executes the specified function, and
+     * returns": a caller already in it just runs the function */
+#ifndef SG_MUTANT_CTXCALLBACK_NOTIMPL
+    if (thread_context_is_current(context))
+        return callback(param);
+#endif
+    FIXME("entering the context of thread %04lx from another apartment is not supported\n", context->tid);
     return E_NOTIMPL;
 }
 
@@ -2942,10 +2967,25 @@ HRESULT WINAPI CoGetContextToken(ULONG_PTR *token)
         /* Context token does not take a reference, it's always zero until the
            interface is explicitly requested with CoGetObjectContext(). */
         context->refcount = 0;
+        context->tid = GetCurrentThreadId();
 
         tlsdata->context_token = &context->IObjContext_iface;
     }
 
+    /* the thread's context lasts across CoUninitialize: it is the MTA's
+     * while the thread is in the MTA */
+    {
+        struct thread_context *context = impl_from_IObjContext(tlsdata->context_token);
+        struct apartment *apt;
+
+        context->mta = FALSE;
+        if ((apt = apartment_get_current_or_mta()))
+        {
+            context->mta = apt->multi_threaded;
+            apartment_release(apt);
+        }
+    }
+
     *token = (ULONG_PTR)tlsdata->context_token;
     TRACE("context_token %p\n", tlsdata->context_token);
 
