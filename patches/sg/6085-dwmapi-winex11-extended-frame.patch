From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwmapi, winex11: a frame extended into the client area shows, with its caption buttons

Paint.NET 5 and SumatraPDF draw their own title bar: the client area covers the caption, the frame is
extended over the top band (DwmExtendFrameIntoClientArea), the band is painted transparent black under the
program's tabs and title, and DWM shows the frame there and draws and hit-tests the caption buttons
(DwmDefWindowProc). Wine had no DWM: a black bar without minimise, maximise or close. dwmapi keeps a window's
positive margins in properties; winex11, flushing a 32-bit surface, gives the bands' transparent black pixels
the caption colour (white, or dark when the window asked for a dark title bar) and, when the client area covers
the caption, draws the buttons (close, maximise or restore, minimise) where DWMWA_CAPTION_BUTTON_BOUNDS reports
them; DwmDefWindowProc answers WM_NCHITTEST with HTCLOSE/HTMAXBUTTON/HTMINBUTTON over them, so the default window
procedure presses them as it does any caption button.
---
diff --git a/dlls/dwmapi/dwmapi_main.c b/dlls/dwmapi/dwmapi_main.c
index 7219d6a..744fcc6 100644
--- a/dlls/dwmapi/dwmapi_main.c
+++ b/dlls/dwmapi/dwmapi_main.c
@@ -40,6 +40,30 @@ WINE_DEFAULT_DEBUG_CHANNEL(dwmapi);
 static int get_display_frequency(void);
 
 
+/* the caption buttons' rectangle in window coordinates (what winex11 draws
+ * into an extended frame), and how many there are */
+static int caption_buttons(HWND hwnd, RECT *rect)
+{
+    LONG style = GetWindowLongW(hwnd, GWL_STYLE), exstyle = GetWindowLongW(hwnd, GWL_EXSTYLE);
+    int buttons = 0, frame;
+    RECT window;
+
+    SetRectEmpty(rect);
+    if ((style & WS_CAPTION) != WS_CAPTION || !GetWindowRect(hwnd, &window)) return 0;
+    if (style & WS_SYSMENU)
+    {
+        buttons = 1;
+        if (style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX)) buttons += 2;
+        else if (exstyle & WS_EX_CONTEXTHELP) buttons++;
+    }
+    frame = (style & WS_THICKFRAME) ? GetSystemMetrics(SM_CXSIZEFRAME) : GetSystemMetrics(SM_CXFIXEDFRAME);
+    rect->right = window.right - window.left - frame;
+    rect->left = rect->right - buttons * GetSystemMetrics(SM_CXSIZE);
+    rect->top = (style & WS_THICKFRAME) ? GetSystemMetrics(SM_CYSIZEFRAME) : GetSystemMetrics(SM_CYFIXEDFRAME);
+    rect->bottom = rect->top + GetSystemMetrics(SM_CYCAPTION) - 1;
+    return buttons;
+}
+
 /**********************************************************************
  *           DwmIsCompositionEnabled         (DWMAPI.@)
  */
@@ -86,6 +110,30 @@ HRESULT WINAPI DwmExtendFrameIntoClientArea(HWND hwnd, const MARGINS* margins)
     TRACE("margins %d,%d,%d,%d\n", margins->cxLeftWidth, margins->cxRightWidth,
           margins->cyTopHeight, margins->cyBottomHeight);
 
+    /* Positive margins: the frame shows in those bands of the client area
+     * where the program leaves its pixels transparent, with the caption
+     * buttons when the client area covers the caption (the display driver
+     * composes them; see winex11's dwm_extended_frame) */
+    if (margins->cxLeftWidth >= 0 && margins->cxRightWidth >= 0 &&
+        margins->cyTopHeight >= 0 && margins->cyBottomHeight >= 0)
+    {
+        ULONG_PTR tb = MAKELONG( min( margins->cyTopHeight, 0xffff ), min( margins->cyBottomHeight, 0xffff ) );
+        ULONG_PTR lr = MAKELONG( min( margins->cxLeftWidth, 0xffff ), min( margins->cxRightWidth, 0xffff ) );
+        BOOL changed = (ULONG_PTR)GetPropW( hwnd, L"__wine_dwm_frame_tb" ) != tb ||
+                       (ULONG_PTR)GetPropW( hwnd, L"__wine_dwm_frame_lr" ) != lr;
+
+        if (tb) SetPropW( hwnd, L"__wine_dwm_frame_tb", (HANDLE)tb );
+        else RemovePropW( hwnd, L"__wine_dwm_frame_tb" );
+        if (lr) SetPropW( hwnd, L"__wine_dwm_frame_lr", (HANDLE)lr );
+        else RemovePropW( hwnd, L"__wine_dwm_frame_lr" );
+        if (changed) RedrawWindow( hwnd, NULL, NULL, RDW_INVALIDATE | RDW_ALLCHILDREN );
+    }
+    else
+    {
+        RemovePropW( hwnd, L"__wine_dwm_frame_tb" );
+        RemovePropW( hwnd, L"__wine_dwm_frame_lr" );
+    }
+
     /* Negative margins make the whole window a "sheet of glass": the program's
      * own per-pixel alpha is what is shown.  The display driver picks this up
      * when it next creates the window's surface. */
@@ -426,11 +474,36 @@ HRESULT WINAPI DwmEnableBlurBehindWindow(HWND hWnd, const DWM_BLURBEHIND *pBlurB
  */
 BOOL WINAPI DwmDefWindowProc(HWND hWnd, UINT Msg, WPARAM wParam, LPARAM lParam, LRESULT *plResult)
 {
-    /* DWM draws no caption buttons of its own into extended frames here:
-     * the window's own procedure handles every message */
+    RECT buttons, window, client;
+    POINT pt;
+    int count, width;
+
     TRACE("%p %#x %#Ix %#Ix %p\n", hWnd, Msg, wParam, lParam, plResult);
 
+    /* the caption buttons drawn into a frame extended over the caption (see
+     * DwmExtendFrameIntoClientArea): DWM hit-tests them; pressing one is the
+     * default window procedure's, as for any caption button */
+    if (Msg != WM_NCHITTEST || !plResult) return FALSE;
+    if (!LOWORD((ULONG_PTR)GetPropW(hWnd, L"__wine_dwm_frame_tb"))) return FALSE;
+    if (!(count = caption_buttons(hWnd, &buttons))) return FALSE;
+    if (!GetWindowRect(hWnd, &window) || !GetClientRect(hWnd, &client)) return FALSE;
+    MapWindowPoints(hWnd, 0, (POINT *)&client, 2);
+    if (client.top > window.top + 1) return FALSE;  /* the caption is the window's own */
+    pt.x = (short)LOWORD(lParam) - window.left;
+    pt.y = (short)HIWORD(lParam) - window.top;
+    if (IsZoomed(hWnd)) OffsetRect(&buttons, 0, -buttons.top);
+#ifdef SG_MUTANT_DWM_NO_HITTEST
     return FALSE;
+#endif
+    if (!PtInRect(&buttons, pt)) return FALSE;
+    width = (buttons.right - buttons.left) / count;
+    switch ((buttons.right - 1 - pt.x) / width)
+    {
+    case 0: *plResult = HTCLOSE; break;
+    case 1: *plResult = count == 3 ? HTMAXBUTTON : HTHELP; break;
+    default: *plResult = HTMINBUTTON; break;
+    }
+    return TRUE;
 }
 
 /**********************************************************************
@@ -504,25 +577,12 @@ HRESULT WINAPI DwmGetWindowAttribute(HWND hwnd, DWORD attribute, PVOID pv_attrib
     case DWMWA_CAPTION_BUTTON_BOUNDS:
     {
         /* the caption buttons' rectangle, in window coordinates */
-        RECT *rect = pv_attribute, window;
-        LONG style = GetWindowLongW(hwnd, GWL_STYLE), exstyle = GetWindowLongW(hwnd, GWL_EXSTYLE);
-        int buttons = 0, frame, width;
+        RECT *rect = pv_attribute;
 
         if (!rect) return E_INVALIDARG;
         if (size < sizeof(*rect)) return E_NOT_SUFFICIENT_BUFFER;
-        if ((style & WS_CAPTION) != WS_CAPTION || !GetWindowRect(hwnd, &window)) return E_INVALIDARG;
-        if (style & WS_SYSMENU)
-        {
-            buttons = 1;
-            if (style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX)) buttons += 2;
-            else if (exstyle & WS_EX_CONTEXTHELP) buttons++;
-        }
-        frame = (style & WS_THICKFRAME) ? GetSystemMetrics(SM_CXSIZEFRAME) : GetSystemMetrics(SM_CXFIXEDFRAME);
-        width = window.right - window.left;
-        rect->right = width - frame;
-        rect->left = rect->right - buttons * GetSystemMetrics(SM_CXSIZE);
-        rect->top = (style & WS_THICKFRAME) ? GetSystemMetrics(SM_CYSIZEFRAME) : GetSystemMetrics(SM_CYFIXEDFRAME);
-        rect->bottom = rect->top + GetSystemMetrics(SM_CYCAPTION) - 1;
+        if ((GetWindowLongW(hwnd, GWL_STYLE) & WS_CAPTION) != WS_CAPTION) return E_INVALIDARG;
+        caption_buttons(hwnd, rect);
         hr = S_OK;
         break;
     }
diff --git a/dlls/winex11.drv/bitblt.c b/dlls/winex11.drv/bitblt.c
index 18c4e5d..4c4a169 100644
--- a/dlls/winex11.drv/bitblt.c
+++ b/dlls/winex11.drv/bitblt.c
@@ -1959,6 +1959,131 @@ static BOOL put_over_backdrop( struct x11drv_window_surface *surface, XImage *xi
     return TRUE;
 }
 
+/* Stained Glass OS: what DWM shows of a frame extended into the client area
+ * (DwmExtendFrameIntoClientArea with margins; dwmapi keeps them in window
+ * properties). A program paints the extended part transparent black and its
+ * own controls over it, expecting the frame to show through and DWM to draw
+ * the caption buttons when the program's frame covers the caption (Paint.NET,
+ * SumatraPDF): here the transparent pixels get the caption colour and the
+ * buttons are drawn in the place DWMWA_CAPTION_BUTTON_BOUNDS reports. */
+static void dwm_frame_line( ULONG *row, int x0, int x1, ULONG color, const RECT *clip, int y )
+{
+    int x;
+    if (y < clip->top || y >= clip->bottom) return;
+    for (x = max( x0, clip->left ); x < min( x1, clip->right ); x++) row[x] = color;
+}
+
+static void dwm_frame_buttons( ULONG *bits, int stride, const RECT *dirty, const RECT *buttons, int count,
+                               BOOL maximized, ULONG glyph )
+{
+    int i, w = (buttons->right - buttons->left) / max( count, 1 ), h = buttons->bottom - buttons->top;
+    int size = max( 8, min( 10, h / 3 ) ), k;
+
+    for (i = 0; i < count; i++)
+    {
+        /* right to left: close, maximize/restore, minimize */
+        int cx = buttons->right - i * w - w / 2, cy = buttons->top + h / 2, x0 = cx - size / 2, y0 = cy - size / 2;
+        int kind = i == 0 ? 0 : (i == 1 && count == 3) ? 1 : 2;
+
+        if (kind == 0)
+            for (k = 0; k <= size; k++)
+            {
+                dwm_frame_line( bits + (y0 + k) * stride, x0 + k, x0 + k + 1, glyph, dirty, y0 + k );
+                dwm_frame_line( bits + (y0 + k) * stride, x0 + size - k, x0 + size - k + 1, glyph, dirty, y0 + k );
+            }
+        else if (kind == 1)
+        {
+            int off = maximized ? 2 : 0;
+            dwm_frame_line( bits + (y0 + off) * stride, x0, x0 + size + 1 - off, glyph, dirty, y0 + off );
+            dwm_frame_line( bits + (y0 + size) * stride, x0, x0 + size + 1 - off, glyph, dirty, y0 + size );
+            for (k = y0 + off; k <= y0 + size; k++)
+            {
+                dwm_frame_line( bits + k * stride, x0, x0 + 1, glyph, dirty, k );
+                dwm_frame_line( bits + k * stride, x0 + size - off, x0 + size - off + 1, glyph, dirty, k );
+            }
+            if (maximized)
+            {
+                dwm_frame_line( bits + y0 * stride, x0 + off, x0 + size + 1, glyph, dirty, y0 );
+                for (k = y0; k <= y0 + size - off; k++)
+                    dwm_frame_line( bits + k * stride, x0 + size, x0 + size + 1, glyph, dirty, k );
+            }
+        }
+        else dwm_frame_line( bits + cy * stride, x0, x0 + size + 1, glyph, dirty, cy );
+    }
+}
+
+static void dwm_extended_frame( struct x11drv_window_surface *surface, const BITMAPINFO *info, const void *src_bits,
+                                void *dst_bits, int stride_bytes, const RECT *dirty )
+{
+    static const WCHAR tb_prop[] = {'_','_','w','i','n','e','_','d','w','m','_','f','r','a','m','e','_','t','b',0};
+    static const WCHAR lr_prop[] = {'_','_','w','i','n','e','_','d','w','m','_','f','r','a','m','e','_','l','r',0};
+    static const WCHAR dark_prop[] = {'_','_','w','i','n','e','_','d','a','r','k','_','c','a','p','t','i','o','n',0};
+    HWND hwnd = surface->header.hwnd;
+    ULONG_PTR tb, lr;
+    struct x11drv_win_data *data;
+    RECT client, window, band[4], clip, buttons;
+    const ULONG *src;
+    ULONG *dst, color, glyph;
+    int stride = stride_bytes / sizeof(ULONG), i, x, y, count = 0, frame;
+    LONG style, exstyle;
+    BOOL dark, maximized;
+
+    if (info->bmiHeader.biBitCount != 32 || surface->image->ximage->bits_per_pixel != 32) return;
+    tb = (ULONG_PTR)NtUserGetProp( hwnd, tb_prop );
+    lr = (ULONG_PTR)NtUserGetProp( hwnd, lr_prop );
+    if (!tb && !lr) return;
+    if (!(data = get_win_data( hwnd ))) return;
+    client = data->rects.client;
+    window = data->rects.window;
+    OffsetRect( &client, -data->rects.visible.left, -data->rects.visible.top );
+    OffsetRect( &window, -data->rects.visible.left, -data->rects.visible.top );
+    release_win_data( data );
+
+    style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
+    exstyle = NtUserGetWindowLongW( hwnd, GWL_EXSTYLE );
+    dark = NtUserGetProp( hwnd, dark_prop ) != NULL;
+    maximized = (style & WS_MAXIMIZE) != 0;
+    color = 0xff000000 | (dark ? 0x202020 : 0xffffff);
+    glyph = 0xff000000 | (dark ? 0xffffff : 0x000000);
+
+    /* the extended bands: top, bottom, left, right of the client area */
+    SetRect( &band[0], client.left, client.top, client.right, client.top + LOWORD(tb) );
+    SetRect( &band[1], client.left, client.bottom - HIWORD(tb), client.right, client.bottom );
+    SetRect( &band[2], client.left, client.top, client.left + LOWORD(lr), client.bottom );
+    SetRect( &band[3], client.right - HIWORD(lr), client.top, client.right, client.bottom );
+    src = src_bits;
+    dst = dst_bits;
+    for (i = 0; i < 4; i++)
+    {
+        if (!intersect_rect( &clip, &band[i], dirty )) continue;
+        for (y = clip.top; y < clip.bottom; y++)
+            for (x = clip.left; x < clip.right; x++)
+#ifndef SG_MUTANT_DWM_FRAME_BLACK
+                if (!src[y * stride + x]) dst[y * stride + x] = color;
+#else
+                ;
+#endif
+    }
+
+    /* the caption buttons, when the program's client area covers the caption */
+    if ((style & WS_CAPTION) != WS_CAPTION || !(style & WS_SYSMENU) || client.top > window.top + 1 || !LOWORD(tb))
+        return;
+    count = 1;
+    if (style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX)) count += 2;
+    else if (exstyle & WS_EX_CONTEXTHELP) count++;
+    frame = (style & WS_THICKFRAME) ? NtUserGetSystemMetrics( SM_CXSIZEFRAME ) : NtUserGetSystemMetrics( SM_CXFIXEDFRAME );
+    buttons.right = window.right - frame;
+    buttons.left = buttons.right - count * NtUserGetSystemMetrics( SM_CXSIZE );
+    buttons.top = window.top + ((style & WS_THICKFRAME) ? NtUserGetSystemMetrics( SM_CYSIZEFRAME )
+                                                        : NtUserGetSystemMetrics( SM_CYFIXEDFRAME ));
+    buttons.bottom = buttons.top + NtUserGetSystemMetrics( SM_CYCAPTION ) - 1;
+    if (maximized) OffsetRect( &buttons, 0, -buttons.top + max( 0, client.top ) );
+    if (!intersect_rect( &clip, &buttons, dirty )) return;
+#ifndef SG_MUTANT_DWM_NO_BUTTONS
+    dwm_frame_buttons( dst, stride, &clip, &buttons, count, maximized, glyph );
+#endif
+}
+
 /***********************************************************************
  *           x11drv_surface_flush
  */
@@ -1992,20 +2117,24 @@ static BOOL x11drv_surface_flush( struct window_surface *window_surface, const R
         int map[256], *mapping = get_window_surface_mapping( ximage->bits_per_pixel, map );
         int width_bytes = ximage->bytes_per_line;
 
-        src += dirty->top * width_bytes;
-        dst += dirty->top * width_bytes;
-        copy_image_byteswap( color_info, src, dst, width_bytes, width_bytes, dirty->bottom - dirty->top,
+        copy_image_byteswap( color_info, src + dirty->top * width_bytes, dst + dirty->top * width_bytes,
+                             width_bytes, width_bytes, dirty->bottom - dirty->top,
                              surface->byteswap, mapping, ~0u, alpha_bits );
+        if (!surface->byteswap && !mapping) dwm_extended_frame( surface, color_info, src, dst, width_bytes, dirty );
     }
     else if (alpha_bits)
     {
         int x, y, stride = ximage->bytes_per_line / sizeof(ULONG);
         ULONG *ptr = (ULONG *)dst + dirty->top * stride;
 
+        /* the frame colour goes where the program left the pixels transparent: see them before the alpha */
+        dwm_extended_frame( surface, color_info, src, dst, ximage->bytes_per_line, dirty );
+
         for (y = dirty->top; y < dirty->bottom; y++, ptr += stride)
             for (x = dirty->left; x < dirty->right; x++)
                 ptr[x] |= alpha_bits;
     }
+    else dwm_extended_frame( surface, color_info, src, dst, ximage->bytes_per_line, dirty );
 
     if (put_over_backdrop( surface, ximage, rect, dirty )) ;
     else if (!put_shm_image( ximage, &surface->image->shminfo, surface->window, surface->gc, rect, dirty ))
