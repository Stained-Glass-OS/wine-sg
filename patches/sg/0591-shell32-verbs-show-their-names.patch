From: Stained Glass OS <ke7oxh@gmail.com>
Subject: shell32: a program's own right-click verbs show their names

David: "Run with debugging" should be in File Explorer too -- it was, as
"sgdebugreport". get_verb_desc asked for the size of the verb key's default
value and waited for ERROR_MORE_DATA, but a size query answers ERROR_SUCCESS:
the name was never read, and every program's own verb showed its key's name.
Now MUIVerb (a plain string), then the default value, as Windows shows them.

Gate: make test-verblabel.
--- a/dlls/shell32/shlview_cmenu.c
+++ b/dlls/shell32/shlview_cmenu.c
@@ -1414,11 +1414,26 @@
         {L"runas", IDS_VERB_RUNAS},
     };
 
-    if ((ret = RegGetValueW(key, verb, NULL, RRF_RT_REG_SZ, NULL, NULL, &size)) == ERROR_MORE_DATA)
+    /* Stained Glass OS: the verb's own name for itself -- MUIVerb, or the
+     * key's default value -- as Windows shows it. A size query answers
+     * ERROR_SUCCESS, not ERROR_MORE_DATA, so the default value was never
+     * read and every program's own verb showed its key's name ("Run with
+     * debugging" showed as "sgdebugreport"). An indirect "@dll,-id" MUIVerb
+     * is left to the default value. */
+    if (!(ret = RegGetValueW(key, verb, L"MUIVerb", RRF_RT_REG_SZ, NULL, NULL, &size)) && size > sizeof(WCHAR))
     {
         desc = malloc(size);
-        RegGetValueW(key, verb, NULL, RRF_RT_REG_SZ, NULL, desc, &size);
-        return desc;
+        if (!RegGetValueW(key, verb, L"MUIVerb", RRF_RT_REG_SZ, NULL, desc, &size) && desc[0] != '@')
+            return desc;
+        free(desc);
+    }
+    size = 0;
+    if (!(ret = RegGetValueW(key, verb, NULL, RRF_RT_REG_SZ, NULL, NULL, &size)) && size > sizeof(WCHAR))
+    {
+        desc = malloc(size);
+        if (!RegGetValueW(key, verb, NULL, RRF_RT_REG_SZ, NULL, desc, &size) && desc[0] != '@')
+            return desc;
+        free(desc);
     }
 
