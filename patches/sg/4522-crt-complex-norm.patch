From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcrt: Implement norm, normf and norml.

norm, normf and norml of <complex.h> (the squared magnitude of a
_Dcomplex, _Fcomplex or _Lcomplex) were spec stubs in msvcr120 and
ucrtbase; msvcr120_app forwards. They take their argument as the other
complex functions there do (long double is double).
---
 dlls/msvcr120/msvcr120.spec         | 6 +++---
 dlls/msvcr120_app/msvcr120_app.spec | 6 +++---
 dlls/msvcrt/math.c                  | 7 +++++++
 dlls/ucrtbase/ucrtbase.spec         | 6 +++---
 4 files changed, 16 insertions(+), 9 deletions(-)

diff --git a/dlls/msvcr120/msvcr120.spec b/dlls/msvcr120/msvcr120.spec
index 6a64341..d80896b 100644
--- a/dlls/msvcr120/msvcr120.spec
+++ b/dlls/msvcr120/msvcr120.spec
@@ -2306,9 +2306,9 @@
 @ cdecl nexttoward(double double) __nexttoward
 @ cdecl nexttowardf(float double) __nexttowardf
 @ cdecl nexttowardl(double double) __nexttoward
-@ stub norm
-@ stub normf
-@ stub norml
+@ cdecl norm(int128) MSVCR120_norm
+@ cdecl normf(int64) MSVCR120_normf
+@ cdecl norml(int128) MSVCR120_norm
 @ cdecl perror(str)
 @ cdecl pow(double double)
 @ cdecl -arch=!i386 powf(float float)
diff --git a/dlls/msvcr120_app/msvcr120_app.spec b/dlls/msvcr120_app/msvcr120_app.spec
index bcf6cd0..3da694b 100644
--- a/dlls/msvcr120_app/msvcr120_app.spec
+++ b/dlls/msvcr120_app/msvcr120_app.spec
@@ -1970,9 +1970,9 @@
 @ cdecl nexttoward(double double) msvcr120.nexttoward
 @ cdecl nexttowardf(float double) msvcr120.nexttowardf
 @ cdecl nexttowardl(double double) msvcr120.nexttowardl
-@ stub norm
-@ stub normf
-@ stub norml
+@ cdecl norm(int128) msvcr120.norm
+@ cdecl normf(int64) msvcr120.normf
+@ cdecl norml(int128) msvcr120.norml
 @ cdecl perror(str) msvcr120.perror
 @ cdecl pow(double double) msvcr120.pow
 @ cdecl -arch=!i386 powf(float float) msvcr120.powf
diff --git a/dlls/msvcrt/math.c b/dlls/msvcrt/math.c
index b3b0f29..bcb4981 100644
--- a/dlls/msvcrt/math.c
+++ b/dlls/msvcrt/math.c
@@ -3092,6 +3092,13 @@ float CDECL MSVCR120_crealf( _Fcomplex z ) { return z._Val[0]; }
 float CDECL MSVCR120_cimagf( _Fcomplex z ) { return z._Val[1]; }
 double CDECL MSVCR120_cabs( _Dcomplex z ) { return c_abs( cplx_d( z ) ); }
 float CDECL MSVCR120_cabsf( _Fcomplex z ) { return c_abs( cplx_f( z ) ); }
+/* norm: the squared magnitude */
+#ifndef SG_MUTANT_NORM_IS_ABS
+double CDECL MSVCR120_norm( _Dcomplex z ) { return z._Val[0] * z._Val[0] + z._Val[1] * z._Val[1]; }
+#else
+double CDECL MSVCR120_norm( _Dcomplex z ) { return c_abs( cplx_d( z ) ); }
+#endif
+float CDECL MSVCR120_normf( _Fcomplex z ) { return z._Val[0] * z._Val[0] + z._Val[1] * z._Val[1]; }
 double CDECL MSVCR120_carg( _Dcomplex z ) { return c_arg( cplx_d( z ) ); }
 float CDECL MSVCR120_cargf( _Fcomplex z ) { return c_arg( cplx_f( z ) ); }
 _Dcomplex * CDECL MSVCR120_cpow( _Dcomplex *ret, _Dcomplex z, _Dcomplex w ) { return ret_d( ret, c_pow( cplx_d( z ), cplx_d( w ) ) ); }
diff --git a/dlls/ucrtbase/ucrtbase.spec b/dlls/ucrtbase/ucrtbase.spec
index 425c5d4..cfe34ea 100644
--- a/dlls/ucrtbase/ucrtbase.spec
+++ b/dlls/ucrtbase/ucrtbase.spec
@@ -2444,9 +2444,9 @@
 @ cdecl nexttoward(double double) __nexttoward
 @ cdecl nexttowardf(float double) __nexttowardf
 @ cdecl nexttowardl(double double) __nexttoward
-@ stub norm
-@ stub normf
-@ stub norml
+@ cdecl norm(int128) MSVCR120_norm
+@ cdecl normf(int64) MSVCR120_normf
+@ cdecl norml(int128) MSVCR120_norm
 @ cdecl perror(str)
 @ cdecl pow(double double)
 @ cdecl powf(float float)
