+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "windef.h"
+
+LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
+
+/* @makedep: ../shell32/resources/blank.ico */
+1 ICON ../shell32/resources/blank.ico
+/* a document */
+/* @makedep: ../shell32/resources/document.ico */
+2 ICON ../shell32/resources/document.ico
+/* a folder, closed and open */
+/* @makedep: ../shell32/resources/folder.ico */
+3 ICON ../shell32/resources/folder.ico
+/* @makedep: ../shell32/resources/folder_open.ico */
+4 ICON ../shell32/resources/folder_open.ico
+/* the elevation shield (Windows 7's id) */
+/* @makedep: ../user32/resources/oic_shield.ico */
+78 ICON ../user32/resources/oic_shield.ico
+/* secure, connected */
+/* @makedep: ../shell32/resources/security.ico */
+106 ICON ../shell32/resources/security.ico
+/* a compressed folder */
+/* @makedep: ../shell32/resources/folder.ico */
+174 ICON ../shell32/resources/folder.ico
+/* the libraries: Documents, Pictures, Music, Videos */
+/* @makedep: ../shell32/resources/mydocs.ico */
+1002 ICON ../shell32/resources/mydocs.ico
+/* @makedep: ../shell32/resources/image.ico */
+1003 ICON ../shell32/resources/image.ico
+/* @makedep: ../shell32/resources/audio.ico */
+1004 ICON ../shell32/resources/audio.ico
+/* @makedep: ../shell32/resources/video.ico */
+1005 ICON ../shell32/resources/video.ico
+/* the elevation shield */
+/* @makedep: ../user32/resources/oic_shield.ico */
+1028 ICON ../user32/resources/oic_shield.ico
--- a/dlls/shell32/shell32.rc
+++ b/dlls/shell32/shell32.rc
@@ -578,6 +578,11 @@
 /* @makedep: resources/document.ico */
 IDI_SHELL_FILE ICON resources/document.ico
 
+/* Stained Glass OS (i1012): a change under way, at the id programs ask for (shell32,-16739;
+ * WireGuard's tunnel starting or stopping) */
+/* @makedep: resources/update.ico */
+16739 ICON resources/update.ico
+
 /* @makedep: resources/document.ico */
 IDI_SHELL_DOCUMENT ICON resources/document.ico
 
