 static const IMFClockStateSinkVtbl audio_renderer_clock_sink_vtbl =
@@ -1090,46 +1111,178 @@ static ULONG WINAPI audio_renderer_policy_Release(IMFAudioPolicy *iface)
     return IMFMediaSink_Release(&renderer->IMFMediaSink_iface);
 }
 
+/* The policy is the renderer's audio session's: the values are kept here, so that they outlive the
+ * audio client (it is made again for each media type), and are given to the session. */
+static HRESULT audio_renderer_get_session_control(struct audio_renderer *renderer, IAudioSessionControl **control)
+{
+    if (!renderer->audio_client)
+        return MF_E_NOT_INITIALIZED;
+    return IAudioClient_GetService(renderer->audio_client, &IID_IAudioSessionControl, (void **)control);
+}
+
+static void audio_renderer_apply_policy(struct audio_renderer *renderer)
+{
+    IAudioSessionControl *control;
+
+    if (FAILED(audio_renderer_get_session_control(renderer, &control)))
+        return;
+
+    if (!IsEqualGUID(&renderer->policy.grouping, &GUID_NULL))
+        IAudioSessionControl_SetGroupingParam(control, &renderer->policy.grouping, NULL);
+    if (renderer->policy.display_name)
+        IAudioSessionControl_SetDisplayName(control, renderer->policy.display_name, NULL);
+    if (renderer->policy.icon_path)
+        IAudioSessionControl_SetIconPath(control, renderer->policy.icon_path, NULL);
+    IAudioSessionControl_Release(control);
+}
+
+static HRESULT audio_renderer_set_policy_string(struct audio_renderer *renderer, WCHAR **dest, const WCHAR *value)
+{
+    WCHAR *copy = NULL;
+
+    if (value && !(copy = wcsdup(value)))
+        return E_OUTOFMEMORY;
+
+    free(*dest);
+    *dest = copy;
+
+    return S_OK;
+}
+
+static HRESULT audio_renderer_get_policy_string(const WCHAR *value, WCHAR **ret)
+{
+    size_t size = (value ? wcslen(value) + 1 : 1) * sizeof(WCHAR);
+
+    if (!(*ret = CoTaskMemAlloc(size)))
+        return E_OUTOFMEMORY;
+    memcpy(*ret, value ? value : L"", size);
+
+    return S_OK;
+}
+
 static HRESULT WINAPI audio_renderer_policy_SetGroupingParam(IMFAudioPolicy *iface, REFGUID param)
 {
-    FIXME("%p, %s.\n", iface, debugstr_guid(param));
+    struct audio_renderer *renderer = impl_from_IMFAudioPolicy(iface);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p, %s.\n", iface, debugstr_guid(param));
+
+    if (!param)
+        return E_POINTER;
+
+    EnterCriticalSection(&renderer->cs);
+    if (renderer->flags & SAR_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        renderer->policy.grouping = *param;
+        audio_renderer_apply_policy(renderer);
+    }
+    LeaveCriticalSection(&renderer->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI audio_renderer_policy_GetGroupingParam(IMFAudioPolicy *iface, GUID *param)
 {
-    FIXME("%p, %p.\n", iface, param);
+    struct audio_renderer *renderer = impl_from_IMFAudioPolicy(iface);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p.\n", iface, param);
+
+    if (!param)
+        return E_POINTER;
+
+    EnterCriticalSection(&renderer->cs);
+#ifdef SG_MUTANT_SAR_SHUTDOWN
+    if (0)
+#else
+    if (renderer->flags & SAR_SHUT_DOWN)
+#endif
+        hr = MF_E_SHUTDOWN;
+    else
+        *param = renderer->policy.grouping;
+    LeaveCriticalSection(&renderer->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI audio_renderer_policy_SetDisplayName(IMFAudioPolicy *iface, const WCHAR *name)
 {
-    FIXME("%p, %s.\n", iface, debugstr_w(name));
+    struct audio_renderer *renderer = impl_from_IMFAudioPolicy(iface);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p, %s.\n", iface, debugstr_w(name));
+
+    EnterCriticalSection(&renderer->cs);
+    if (renderer->flags & SAR_SHUT_DOWN)
