 static HRESULT WINAPI audio_renderer_policy_SetIconPath(IMFAudioPolicy *iface, const WCHAR *path)
 {
-    FIXME("%p, %s.\n", iface, debugstr_w(path));
+    struct audio_renderer *renderer = impl_from_IMFAudioPolicy(iface);
