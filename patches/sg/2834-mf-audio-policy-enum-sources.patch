+        return E_POINTER;
+
+    EnterCriticalSection(&renderer->cs);
+    if (renderer->flags & SAR_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+        hr = audio_renderer_get_policy_string(renderer->policy.icon_path, path);
+    LeaveCriticalSection(&renderer->cs);
+
+    return hr;
 }
 
