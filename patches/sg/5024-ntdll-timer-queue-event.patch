From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Return at once from RtlDeleteTimerQueueEx with an event.

RtlDeleteTimerQueueEx with an event returns at once; the timer thread sets
the event (a duplicate of the caller's handle) when the last callback is
done, as documented. It waited for the timer thread first.

Gate: test/ntdll-timerqueue-event-gate.sh (64/32).
---
 dlls/ntdll/threadpool.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/threadpool.c b/dlls/ntdll/threadpool.c
index 2059119..ce66f64 100644
--- a/dlls/ntdll/threadpool.c
+++ b/dlls/ntdll/threadpool.c
@@ -90,6 +90,7 @@ struct timer_queue
     BOOL quit;                  /* queue should be deleted; once set, never unset */
     HANDLE event;
     HANDLE thread;
+    HANDLE completion_event;    /* set when the queue is gone (RtlDeleteTimerQueueEx) */
 };
 
 /*
@@ -745,6 +746,11 @@ static void WINAPI timer_queue_thread_proc(LPVOID p)
     NtClose(q->event);
     RtlDeleteCriticalSection(&q->cs);
     q->magic = 0;
+    if (q->completion_event)
+    {
+        NtSetEvent(q->completion_event, NULL);
+        NtClose(q->completion_event);
+    }
     RtlFreeHeap(GetProcessHeap(), 0, q);
     RtlExitUserThread( 0 );
 }
@@ -786,6 +792,7 @@ NTSTATUS WINAPI RtlCreateTimerQueue(PHANDLE NewTimerQueue)
     RtlInitializeCriticalSection(&q->cs);
     list_init(&q->timers);
     q->quit = FALSE;
+    q->completion_event = NULL;
     q->magic = TIMER_QUEUE_MAGIC;
     status = NtCreateEvent(&q->event, EVENT_ALL_ACCESS, NULL, SynchronizationEvent, FALSE);
     if (status != STATUS_SUCCESS)
@@ -835,6 +842,12 @@ NTSTATUS WINAPI RtlDeleteTimerQueueEx(HANDLE TimerQueue, HANDLE CompletionEvent)
     thread = q->thread;
 
     RtlEnterCriticalSection(&q->cs);
+#ifndef SG_MUTANT_TIMERQUEUE_EVENT_WAITS
+    /* the timer thread sets the event when the last timer is done: return now */
+    if (CompletionEvent && CompletionEvent != INVALID_HANDLE_VALUE)
+        NtDuplicateObject(NtCurrentProcess(), CompletionEvent, NtCurrentProcess(), &q->completion_event,
+                          0, 0, DUPLICATE_SAME_ACCESS);
+#endif
     q->quit = TRUE;
     if (list_head(&q->timers))
         /* When the last timer is removed, it will signal the timer thread to
@@ -853,12 +866,13 @@ NTSTATUS WINAPI RtlDeleteTimerQueueEx(HANDLE TimerQueue, HANDLE CompletionEvent)
     }
     else
     {
+#ifdef SG_MUTANT_TIMERQUEUE_EVENT_WAITS
         if (CompletionEvent)
         {
-            FIXME("asynchronous return on completion event unimplemented\n");
             NtWaitForSingleObject(thread, FALSE, NULL);
             NtSetEvent(CompletionEvent, NULL);
         }
+#endif
         status = STATUS_PENDING;
     }
 
