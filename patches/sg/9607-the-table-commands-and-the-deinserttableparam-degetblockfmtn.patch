+/*
+ * TriEdit, which the control is built on in Windows, does the table commands
+ * itself on the document: DECMD_INSERTTABLE puts a table (its rows, columns,
+ * attributes and caption from a DEInsertTableParam object) where the
+ * selection is; the row, column and cell commands work on the table cell the
+ * selection is in. DEGetBlockFmtNamesParam receives the names of the block
+ * formats (DECMD_GETBLOCKFMTNAMES).
+ */
+
+#define COBJMACROS
+
+#include "dhtmled.h"
+#include "mshtml.h"
+#include "mshtmcid.h"
+#include "dhtmled_private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dhtmled);
+
+/* ---- the selection's table cell ---- */
+
+static HRESULT selection_range(IHTMLDocument2 *doc, IHTMLTxtRange **ret)
+{
+    IHTMLSelectionObject *sel;
+    IDispatch *disp = NULL;
+    HRESULT hr;
+
+    *ret = NULL;
+    if (FAILED(hr = IHTMLDocument2_get_selection(doc, &sel))) return hr;
+    hr = IHTMLSelectionObject_createRange(sel, &disp);
+    IHTMLSelectionObject_Release(sel);
+    if (FAILED(hr) || !disp) return FAILED(hr) ? hr : E_FAIL;
+    hr = IDispatch_QueryInterface(disp, &IID_IHTMLTxtRange, (void **)ret);
+    IDispatch_Release(disp);
+    return hr;
+}
+
+static BOOL is_tag(IHTMLElement *elem, const WCHAR *tag)
+{
+    BSTR name = NULL;
+    BOOL ret;
+
+    if (FAILED(IHTMLElement_get_tagName(elem, &name)) || !name) return FALSE;
+    ret = !wcsicmp(name, tag);
+    SysFreeString(name);
+    return ret;
+}
+
+/* the element itself or its nearest ancestor with one of the tags */
+static IHTMLElement *closest(IHTMLElement *elem, const WCHAR *tag1, const WCHAR *tag2)
+{
+    IHTMLElement *cur = elem, *parent;
+
+    if (cur) IHTMLElement_AddRef(cur);
+    while (cur)
+    {
+        if (is_tag(cur, tag1) || (tag2 && is_tag(cur, tag2))) return cur;
+        parent = NULL;
+        IHTMLElement_get_parentElement(cur, &parent);
+        IHTMLElement_Release(cur);
+        cur = parent;
+    }
+    return NULL;
+}
+
+/* the cell at the start (or the end) of the selection */
+static IHTMLElement *selection_cell(IHTMLDocument2 *doc, BOOL end)
+{
+    IHTMLTxtRange *range, *dup = NULL;
+    IHTMLElement *parent = NULL, *cell;
+
+    if (FAILED(selection_range(doc, &range))) return NULL;
+    if (SUCCEEDED(IHTMLTxtRange_duplicate(range, &dup)) && dup)
+    {
+        IHTMLTxtRange_collapse(dup, end ? VARIANT_FALSE : VARIANT_TRUE);
+        IHTMLTxtRange_parentElement(dup, &parent);
+        IHTMLTxtRange_Release(dup);
+    }
+    IHTMLTxtRange_Release(range);
+    if (!parent) return NULL;
+    cell = closest(parent, L"TD", L"TH");
+    IHTMLElement_Release(parent);
+    return cell;
+}
+
+struct cell_pos
+{
+    IHTMLElement *cell;
+    IHTMLTableCell *table_cell;
+    IHTMLTableRow *row;
+    IHTMLTable *table;
+    LONG cell_index, row_index;
+};
+
+static void free_pos(struct cell_pos *pos)
+{
+    if (pos->table) IHTMLTable_Release(pos->table);
+    if (pos->row) IHTMLTableRow_Release(pos->row);
+    if (pos->table_cell) IHTMLTableCell_Release(pos->table_cell);
+    if (pos->cell) IHTMLElement_Release(pos->cell);
+    memset(pos, 0, sizeof(*pos));
+}
+
+static HRESULT cell_position(IHTMLElement *cell, struct cell_pos *pos)
+{
+    IHTMLElement *row_elem = NULL, *table_elem = NULL;
+    HRESULT hr;
+
+    memset(pos, 0, sizeof(*pos));
+    pos->cell = cell;
+    IHTMLElement_AddRef(cell);
+    if (FAILED(hr = IHTMLElement_QueryInterface(cell, &IID_IHTMLTableCell, (void **)&pos->table_cell))) goto fail;
+    if (!(row_elem = closest(cell, L"TR", NULL))) { hr = E_FAIL; goto fail; }
+    hr = IHTMLElement_QueryInterface(row_elem, &IID_IHTMLTableRow, (void **)&pos->row);
+    if (SUCCEEDED(hr)) table_elem = closest(row_elem, L"TABLE", NULL);
+    IHTMLElement_Release(row_elem);
+    if (FAILED(hr)) goto fail;
+    if (!table_elem) { hr = E_FAIL; goto fail; }
+    hr = IHTMLElement_QueryInterface(table_elem, &IID_IHTMLTable, (void **)&pos->table);
+    IHTMLElement_Release(table_elem);
+    if (FAILED(hr)) goto fail;
+    IHTMLTableCell_get_cellIndex(pos->table_cell, &pos->cell_index);
+    IHTMLTableRow_get_rowIndex(pos->row, &pos->row_index);
+    return S_OK;
+fail:
+    free_pos(pos);
+    return hr;
+}
+
+static HRESULT table_row(IHTMLTable *table, LONG index, IHTMLTableRow **ret)
+{
+    IHTMLElementCollection *rows;
+    IDispatch *disp = NULL;
+    VARIANT name, idx;
+    HRESULT hr;
+
+    *ret = NULL;
+    if (FAILED(hr = IHTMLTable_get_rows(table, &rows))) return hr;
+    V_VT(&name) = VT_I4; V_I4(&name) = index;
+    V_VT(&idx) = VT_I4; V_I4(&idx) = 0;
+    hr = IHTMLElementCollection_item(rows, name, idx, &disp);
+    IHTMLElementCollection_Release(rows);
+    if (FAILED(hr) || !disp) return FAILED(hr) ? hr : E_FAIL;
+    hr = IDispatch_QueryInterface(disp, &IID_IHTMLTableRow, (void **)ret);
+    IDispatch_Release(disp);
+    return hr;
+}
+
+static LONG collection_length(IHTMLElementCollection *col)
+{
+    LONG len = 0;
+    if (col) IHTMLElementCollection_get_length(col, &len);
+    return len;
+}
+
+static LONG row_count(IHTMLTable *table)
+{
+    IHTMLElementCollection *rows = NULL;
+    LONG len;
+
+    IHTMLTable_get_rows(table, &rows);
+    len = collection_length(rows);
+    if (rows) IHTMLElementCollection_Release(rows);
+    return len;
+}
+
+static LONG cell_count(IHTMLTableRow *row)
+{
+    IHTMLElementCollection *cells = NULL;
+    LONG len;
+
+    IHTMLTableRow_get_cells(row, &cells);
+    len = collection_length(cells);
+    if (cells) IHTMLElementCollection_Release(cells);
+    return len;
+}
+
+static HRESULT row_cell(IHTMLTableRow *row, LONG index, IHTMLElement **ret)
+{
+    IHTMLElementCollection *cells;
+    IDispatch *disp = NULL;
+    VARIANT name, idx;
+    HRESULT hr;
+
+    *ret = NULL;
+    if (FAILED(hr = IHTMLTableRow_get_cells(row, &cells))) return hr;
+    V_VT(&name) = VT_I4; V_I4(&name) = index;
+    V_VT(&idx) = VT_I4; V_I4(&idx) = 0;
+    hr = IHTMLElementCollection_item(cells, name, idx, &disp);
+    IHTMLElementCollection_Release(cells);
+    if (FAILED(hr) || !disp) return FAILED(hr) ? hr : E_FAIL;
+    hr = IDispatch_QueryInterface(disp, &IID_IHTMLElement, (void **)ret);
+    IDispatch_Release(disp);
+    return hr;
+}
+
+static HRESULT insert_cell(IHTMLTableRow *row, LONG index)
+{
+    IDispatch *cell = NULL;
+    IHTMLElement *elem;
+    HRESULT hr;
+
+    hr = IHTMLTableRow_insertCell(row, index, &cell);
+    if (SUCCEEDED(hr) && cell)
+    {
+        /* an empty cell would collapse: the editor puts a space in it */
+        if (SUCCEEDED(IDispatch_QueryInterface(cell, &IID_IHTMLElement, (void **)&elem)))
+        {
+            BSTR nbsp = SysAllocString(L"&nbsp;");
+            IHTMLElement_put_innerHTML(elem, nbsp);
+            SysFreeString(nbsp);
+            IHTMLElement_Release(elem);
+        }
+        IDispatch_Release(cell);
+    }
+    return hr;
+}
+
+static HRESULT insert_row(struct cell_pos *pos)
+{
+    IDispatch *disp = NULL;
+    IHTMLTableRow *row;
+    LONG i, n = cell_count(pos->row);
+    HRESULT hr;
+
+    /* above the selection's row, as wide as it */
+    if (FAILED(hr = IHTMLTable_insertRow(pos->table, pos->row_index, &disp)) || !disp) return FAILED(hr) ? hr : E_FAIL;
+    hr = IDispatch_QueryInterface(disp, &IID_IHTMLTableRow, (void **)&row);
+    IDispatch_Release(disp);
+    if (FAILED(hr)) return hr;
+    for (i = 0; i < n && SUCCEEDED(hr); i++) hr = insert_cell(row, -1);
+    IHTMLTableRow_Release(row);
+    return hr;
+}
+
+static HRESULT insert_col(struct cell_pos *pos)
+{
+    IHTMLTableRow *row;
+    LONG i, rows = row_count(pos->table), cells;
+    HRESULT hr = S_OK;
+
+    /* left of the selection's column, in every row */
+    for (i = 0; i < rows && SUCCEEDED(hr); i++)
+    {
+        if (FAILED(table_row(pos->table, i, &row))) continue;
+        cells = cell_count(row);
+        hr = insert_cell(row, pos->cell_index < cells ? pos->cell_index : -1);
+        IHTMLTableRow_Release(row);
+    }
+    return hr;
+}
+
+static HRESULT delete_col(struct cell_pos *pos)
+{
+    IHTMLTableRow *row;
+    LONG i, rows = row_count(pos->table);
+    HRESULT hr = S_OK;
+
+    for (i = 0; i < rows && SUCCEEDED(hr); i++)
+    {
+        if (FAILED(table_row(pos->table, i, &row))) continue;
+        if (pos->cell_index < cell_count(row)) hr = IHTMLTableRow_deleteCell(row, pos->cell_index);
+        IHTMLTableRow_Release(row);
+    }
+    return hr;
+}
+
+/* the selected cells of a row become one: their contents joined, their spans added */
+static HRESULT merge_cells(IHTMLDocument2 *doc, struct cell_pos *pos)
+{
+    IHTMLElement *last_cell, *next;
+    struct cell_pos last;
+    LONG span, next_span, i, end_index;
+    HRESULT hr;
+
+    if (!(last_cell = selection_cell(doc, TRUE))) return E_UNEXPECTED;
+    hr = cell_position(last_cell, &last);
+    IHTMLElement_Release(last_cell);
+    if (FAILED(hr)) return hr;
+    end_index = last.cell_index;
+    if (last.row_index != pos->row_index || end_index <= pos->cell_index)
+    {
+        free_pos(&last);
+        return E_UNEXPECTED;    /* one row, more than one cell */
+    }
+    free_pos(&last);
+    IHTMLTableCell_get_colSpan(pos->table_cell, &span);
+    for (i = pos->cell_index + 1; i <= end_index; i++)
+    {
+        IHTMLTableCell *tc;
+        BSTR html = NULL, mine = NULL, joined;
+
+        if (FAILED(hr = row_cell(pos->row, pos->cell_index + 1, &next))) break;
+        next_span = 1;
+        if (SUCCEEDED(IHTMLElement_QueryInterface(next, &IID_IHTMLTableCell, (void **)&tc)))
+        {
+            IHTMLTableCell_get_colSpan(tc, &next_span);
+            IHTMLTableCell_Release(tc);
+        }
+        IHTMLElement_get_innerHTML(next, &html);
+        IHTMLElement_get_innerHTML(pos->cell, &mine);
+        joined = SysAllocStringLen(NULL, SysStringLen(mine) + SysStringLen(html));
+        if (joined)
+        {
+            memcpy(joined, mine ? mine : L"", SysStringLen(mine) * sizeof(WCHAR));
+            memcpy(joined + SysStringLen(mine), html ? html : L"", SysStringLen(html) * sizeof(WCHAR));
+            IHTMLElement_put_innerHTML(pos->cell, joined);
+            SysFreeString(joined);
+        }
+        SysFreeString(html);
+        SysFreeString(mine);
+        IHTMLElement_Release(next);
+        span += next_span;
+        if (FAILED(hr = IHTMLTableRow_deleteCell(pos->row, pos->cell_index + 1))) break;
+    }
+    IHTMLTableCell_put_colSpan(pos->table_cell, span);
+    return hr;
+}
+
+/* a cell becomes two side by side; the cells of its column in the other rows span both */
+static HRESULT split_cell(struct cell_pos *pos)
+{
+    IHTMLTableRow *row;
+    IHTMLElement *cell;
+    IHTMLTableCell *tc;
+    LONG span = 1, i, rows;
+    HRESULT hr;
+
+    IHTMLTableCell_get_colSpan(pos->table_cell, &span);
+    if (span > 1)
+    {
+        IHTMLTableCell_put_colSpan(pos->table_cell, span - 1);
+        return insert_cell(pos->row, pos->cell_index + 1);
+    }
+    if (FAILED(hr = insert_cell(pos->row, pos->cell_index + 1))) return hr;
+    rows = row_count(pos->table);
+    for (i = 0; i < rows; i++)
+    {
+        if (i == pos->row_index || FAILED(table_row(pos->table, i, &row))) continue;
+        if (pos->cell_index < cell_count(row) && SUCCEEDED(row_cell(row, pos->cell_index, &cell)))
+        {
+            if (SUCCEEDED(IHTMLElement_QueryInterface(cell, &IID_IHTMLTableCell, (void **)&tc)))
+            {
+                LONG s = 1;
+                IHTMLTableCell_get_colSpan(tc, &s);
+                IHTMLTableCell_put_colSpan(tc, s + 1);
+                IHTMLTableCell_Release(tc);
+            }
+            IHTMLElement_Release(cell);
+        }
+        IHTMLTableRow_Release(row);
+    }
+    return S_OK;
+}
+
+static HRESULT get_param(IDispatch *disp, const WCHAR *name, VARTYPE vt, VARIANT *ret)
+{
+    DISPPARAMS dp = {0};
+    LPOLESTR n = (LPOLESTR)name;
+    DISPID id;
+    HRESULT hr;
+
+    VariantInit(ret);
+    if (FAILED(hr = IDispatch_GetIDsOfNames(disp, &IID_NULL, &n, 1, LOCALE_USER_DEFAULT, &id))) return hr;
+    if (FAILED(hr = IDispatch_Invoke(disp, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_PROPERTYGET, &dp, ret, NULL, NULL)))
+        return hr;
+    return VariantChangeType(ret, ret, 0, vt);
+}
+
+static void append(WCHAR **buf, size_t *len, size_t *size, const WCHAR *str)
+{
+    size_t n = lstrlenW(str);
+    WCHAR *b;
+
+    if (!*buf) return;
+    if (*len + n + 1 > *size)
+    {
+        *size = (*len + n + 1) * 2;
+        if (!(b = HeapReAlloc(GetProcessHeap(), 0, *buf, *size * sizeof(WCHAR))))
+        {
+            HeapFree(GetProcessHeap(), 0, *buf);
+            *buf = NULL;
+            return;
+        }
+        *buf = b;
+    }
+    memcpy(*buf + *len, str, (n + 1) * sizeof(WCHAR));
+    *len += n;
+}
+
+/* DECMD_INSERTTABLE: the table a DEInsertTableParam describes, where the selection is */
+static HRESULT insert_table(IHTMLDocument2 *doc, VARIANT *in)
+{
+    VARIANT rows, cols, table_attrs, cell_attrs, caption;
+    IHTMLTxtRange *range;
+    IDispatch *params;
+    WCHAR *html;
+    size_t len = 0, size = 256;
+    LONG r, c;
+    BSTR str;
+    HRESULT hr;
+
+    if (!in || V_VT(in) != VT_DISPATCH || !(params = V_DISPATCH(in))) return E_INVALIDARG;
+    if (FAILED(hr = get_param(params, L"NumRows", VT_I4, &rows))) return hr;
+    if (FAILED(hr = get_param(params, L"NumCols", VT_I4, &cols))) return hr;
+    if (V_I4(&rows) < 1 || V_I4(&cols) < 1 || V_I4(&rows) > 1000 || V_I4(&cols) > 1000) return E_INVALIDARG;
+    get_param(params, L"TableAttrs", VT_BSTR, &table_attrs);
+    get_param(params, L"CellAttrs", VT_BSTR, &cell_attrs);
+    get_param(params, L"Caption", VT_BSTR, &caption);
+
+    if (!(html = HeapAlloc(GetProcessHeap(), 0, size * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    html[0] = 0;
+    append(&html, &len, &size, L"<TABLE");
+    if (V_VT(&table_attrs) == VT_BSTR && V_BSTR(&table_attrs) && *V_BSTR(&table_attrs))
+    {
+        append(&html, &len, &size, L" ");
+        append(&html, &len, &size, V_BSTR(&table_attrs));
+    }
+    append(&html, &len, &size, L">");
+    if (V_VT(&caption) == VT_BSTR && V_BSTR(&caption) && *V_BSTR(&caption))
+    {
+        append(&html, &len, &size, L"<CAPTION>");
+        append(&html, &len, &size, V_BSTR(&caption));
+        append(&html, &len, &size, L"</CAPTION>");
+    }
+    append(&html, &len, &size, L"<TBODY>");
+    for (r = 0; r < V_I4(&rows); r++)
+    {
+        append(&html, &len, &size, L"<TR>");
+        for (c = 0; c < V_I4(&cols); c++)
+        {
+            append(&html, &len, &size, L"<TD");
+            if (V_VT(&cell_attrs) == VT_BSTR && V_BSTR(&cell_attrs) && *V_BSTR(&cell_attrs))
+            {
+                append(&html, &len, &size, L" ");
+                append(&html, &len, &size, V_BSTR(&cell_attrs));
+            }
+            append(&html, &len, &size, L">&nbsp;</TD>");
+        }
+        append(&html, &len, &size, L"</TR>");
+    }
+    append(&html, &len, &size, L"</TBODY></TABLE>");
+    VariantClear(&table_attrs);
+    VariantClear(&cell_attrs);
+    VariantClear(&caption);
+    if (!html) return E_OUTOFMEMORY;
+
+    str = SysAllocString(html);
+    HeapFree(GetProcessHeap(), 0, html);
+    if (!str) return E_OUTOFMEMORY;
+    if (SUCCEEDED(hr = selection_range(doc, &range)))
+    {
+        hr = IHTMLTxtRange_pasteHTML(range, str);
+        IHTMLTxtRange_Release(range);
+    }
+    SysFreeString(str);
+    return hr;
+}
+
+BOOL is_table_command(DHTMLEDITCMDID id)
+{
+    switch (id)
+    {
+    case DECMD_INSERTTABLE: case DECMD_INSERTROW: case DECMD_INSERTCOL: case DECMD_INSERTCELL:
+    case DECMD_DELETEROWS: case DECMD_DELETECOLS: case DECMD_DELETECELLS:
+    case DECMD_MERGECELLS: case DECMD_SPLITCELL:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+HRESULT table_command(IHTMLDocument2 *doc, DHTMLEDITCMDID id, VARIANT *in)
+{
+    struct cell_pos pos;
+    IHTMLElement *cell;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_DH_NO_TABLES
+    return E_NOTIMPL;
+#endif
+    if (id == DECMD_INSERTTABLE) return insert_table(doc, in);
+    if (!(cell = selection_cell(doc, FALSE))) return E_UNEXPECTED;    /* not in a table */
+    hr = cell_position(cell, &pos);
+    IHTMLElement_Release(cell);
+    if (FAILED(hr)) return hr;
+    switch (id)
+    {
+    case DECMD_INSERTROW:   hr = insert_row(&pos); break;
+    case DECMD_INSERTCOL:   hr = insert_col(&pos); break;
+    case DECMD_INSERTCELL:  hr = insert_cell(pos.row, pos.cell_index); break;
+    case DECMD_DELETEROWS:  hr = IHTMLTable_deleteRow(pos.table, pos.row_index); break;
+    case DECMD_DELETECOLS:  hr = delete_col(&pos); break;
+    case DECMD_DELETECELLS: hr = IHTMLTableRow_deleteCell(pos.row, pos.cell_index); break;
+    case DECMD_MERGECELLS:  hr = merge_cells(doc, &pos); break;
+    case DECMD_SPLITCELL:   hr = split_cell(&pos); break;
+    default:                hr = OLECMDERR_E_NOTSUPPORTED; break;
+    }
+    free_pos(&pos);
+    return hr;
+}
+
+DHTMLEDITCMDF table_command_status(IHTMLDocument2 *doc, DHTMLEDITCMDID id)
+{
+    IHTMLElement *start, *end;
+    DHTMLEDITCMDF ret = DECMDF_DISABLED;
+
+#ifdef SG_MUTANT_DH_NO_TABLES
+    return DECMDF_NOTSUPPORTED;
+#endif
+    if (id == DECMD_INSERTTABLE) return DECMDF_ENABLED;
+    if (!(start = selection_cell(doc, FALSE))) return DECMDF_DISABLED;
+    if (id != DECMD_MERGECELLS)
+        ret = DECMDF_ENABLED;
+    else if ((end = selection_cell(doc, TRUE)))
+    {
+        /* more than one cell of a row is selected */
+        struct cell_pos a, b;
+        if (end != start && SUCCEEDED(cell_position(start, &a)))
+        {
+            if (SUCCEEDED(cell_position(end, &b)))
+            {
+                if (a.row_index == b.row_index && b.cell_index > a.cell_index) ret = DECMDF_ENABLED;
+                free_pos(&b);
+            }
+            free_pos(&a);
+        }
+        IHTMLElement_Release(end);
+    }
+    IHTMLElement_Release(start);
+    return ret;
+}
+
+/* ---- DEInsertTableParam and DEGetBlockFmtNamesParam ---- */
+
+typedef struct
+{
+    IDispatch IDispatch_iface;          /* the vtable is IDEInsertTableParam / IDEGetBlockFmtNamesParam */
+    LONG ref;
+    BOOL names;                         /* DEGetBlockFmtNamesParam */
+    LONG rows, cols;
+    BSTR table_attrs, cell_attrs, caption;
+    VARIANT names_value;
+} ParamObject;
+
+static inline ParamObject *impl_from_param(void *iface)
+{
+    return CONTAINING_RECORD(iface, ParamObject, IDispatch_iface);
+}
+
+static HRESULT WINAPI Param_QueryInterface(void *iface, REFIID riid, void **ppv)
+{
+    ParamObject *This = impl_from_param(iface);
+
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch) ||
+        (!This->names && IsEqualGUID(riid, &IID_IDEInsertTableParam)) ||
+        (This->names && IsEqualGUID(riid, &IID_IDEGetBlockFmtNamesParam)))
+    {
+        *ppv = &This->IDispatch_iface;
+        InterlockedIncrement(&This->ref);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI Param_AddRef(void *iface)
+{
+    return InterlockedIncrement(&impl_from_param(iface)->ref);
+}
+
+static ULONG WINAPI Param_Release(void *iface)
+{
+    ParamObject *This = impl_from_param(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        SysFreeString(This->table_attrs);
+        SysFreeString(This->cell_attrs);
+        SysFreeString(This->caption);
+        VariantClear(&This->names_value);
+        HeapFree(GetProcessHeap(), 0, This);
+    }
+    return ref;
+}
+
+static HRESULT param_typeinfo(ParamObject *This, ITypeInfo **ret)
+{
+    return get_param_typeinfo(This->names ? &IID_IDEGetBlockFmtNamesParam : &IID_IDEInsertTableParam, ret);
+}
+
+static HRESULT WINAPI Param_GetTypeInfoCount(void *iface, UINT *count)
+{
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI Param_GetTypeInfo(void *iface, UINT index, LCID lcid, ITypeInfo **ti)
+{
+    ParamObject *This = impl_from_param(iface);
+    HRESULT hr;
+
+    if (index) return DISP_E_BADINDEX;
+    if (SUCCEEDED(hr = param_typeinfo(This, ti))) ITypeInfo_AddRef(*ti);
+    return hr;
+}
+
+static HRESULT WINAPI Param_GetIDsOfNames(void *iface, REFIID riid, LPOLESTR *names, UINT count, LCID lcid, DISPID *ids)
+{
+    ParamObject *This = impl_from_param(iface);
+    ITypeInfo *ti;
+    HRESULT hr;
+
+    if (FAILED(hr = param_typeinfo(This, &ti))) return hr;
+    return ITypeInfo_GetIDsOfNames(ti, names, count, ids);
+}
+
+static HRESULT WINAPI Param_Invoke(void *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *params, VARIANT *res, EXCEPINFO *ei, UINT *argerr)
+{
+    ParamObject *This = impl_from_param(iface);
+    ITypeInfo *ti;
+    HRESULT hr;
+
+    if (FAILED(hr = param_typeinfo(This, &ti))) return hr;
+    return ITypeInfo_Invoke(ti, iface, id, flags, params, res, ei, argerr);
+}
+
+static HRESULT WINAPI Param_get_NumRows(void *iface, LONG *v) { if (!v) return E_POINTER; *v = impl_from_param(iface)->rows; return S_OK; }
+static HRESULT WINAPI Param_put_NumRows(void *iface, LONG v) { impl_from_param(iface)->rows = v; return S_OK; }
+static HRESULT WINAPI Param_get_NumCols(void *iface, LONG *v) { if (!v) return E_POINTER; *v = impl_from_param(iface)->cols; return S_OK; }
+static HRESULT WINAPI Param_put_NumCols(void *iface, LONG v) { impl_from_param(iface)->cols = v; return S_OK; }
+
+static HRESULT get_str(BSTR str, BSTR *v)
+{
+    if (!v) return E_POINTER;
+    return (*v = SysAllocString(str ? str : L"")) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT put_str(BSTR *str, BSTR v)
+{
+    BSTR copy = SysAllocString(v ? v : L"");
+    if (!copy) return E_OUTOFMEMORY;
+    SysFreeString(*str);
+    *str = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI Param_get_TableAttrs(void *iface, BSTR *v) { return get_str(impl_from_param(iface)->table_attrs, v); }
+static HRESULT WINAPI Param_put_TableAttrs(void *iface, BSTR v) { return put_str(&impl_from_param(iface)->table_attrs, v); }
+static HRESULT WINAPI Param_get_CellAttrs(void *iface, BSTR *v) { return get_str(impl_from_param(iface)->cell_attrs, v); }
+static HRESULT WINAPI Param_put_CellAttrs(void *iface, BSTR v) { return put_str(&impl_from_param(iface)->cell_attrs, v); }
+static HRESULT WINAPI Param_get_Caption(void *iface, BSTR *v) { return get_str(impl_from_param(iface)->caption, v); }
+static HRESULT WINAPI Param_put_Caption(void *iface, BSTR v) { return put_str(&impl_from_param(iface)->caption, v); }
+
+static HRESULT WINAPI Param_get_Names(void *iface, VARIANT *v)
+{
+    if (!v) return E_POINTER;
+    VariantInit(v);
+    return VariantCopy(v, &impl_from_param(iface)->names_value);
+}
+
+static HRESULT WINAPI Param_put_Names(void *iface, VARIANT *v)
+{
+    ParamObject *This = impl_from_param(iface);
+
+    if (!v) return E_INVALIDARG;
+    VariantClear(&This->names_value);
+    return VariantCopyInd(&This->names_value, v);
+}
+
+static const struct
+{
+    void *unk[3];
+    void *disp[4];
+    void *members[10];
+}
+table_param_vtbl =
+{
+    { Param_QueryInterface, Param_AddRef, Param_Release },
+    { Param_GetTypeInfoCount, Param_GetTypeInfo, Param_GetIDsOfNames, Param_Invoke },
+    { Param_get_NumRows, Param_put_NumRows, Param_get_NumCols, Param_put_NumCols, Param_get_TableAttrs,
+      Param_put_TableAttrs, Param_get_CellAttrs, Param_put_CellAttrs, Param_get_Caption, Param_put_Caption }
+},
+names_param_vtbl =
+{
+    { Param_QueryInterface, Param_AddRef, Param_Release },
+    { Param_GetTypeInfoCount, Param_GetTypeInfo, Param_GetIDsOfNames, Param_Invoke },
+    { Param_get_Names, Param_put_Names }
+};
+
+static HRESULT create_param(BOOL names, REFIID iid, void **out)
+{
+    ParamObject *This;
+    HRESULT hr;
+
+    if (!(This = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->IDispatch_iface.lpVtbl = (const IDispatchVtbl *)(names ? (const void *)&names_param_vtbl : (const void *)&table_param_vtbl);
+    This->ref = 1;
+    This->names = names;
+    /* TriEdit's defaults: a table of two rows and columns */
+    This->rows = This->cols = 2;
+    hr = Param_QueryInterface(&This->IDispatch_iface, iid, out);
+    Param_Release(&This->IDispatch_iface);
+    return hr;
+}
+
+HRESULT insert_table_param_create(REFIID iid, void **out)
+{
+    return create_param(FALSE, iid, out);
+}
+
+HRESULT block_fmt_names_param_create(REFIID iid, void **out)
+{
+    return create_param(TRUE, iid, out);
+}
