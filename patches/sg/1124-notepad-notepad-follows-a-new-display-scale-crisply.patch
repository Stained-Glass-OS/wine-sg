From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] notepad: Notepad follows a new display scale crisply

Notepad (ours, 0100) was aware of the system DPI: after a new display
scale Wine scaled its picture -- soft at 175%. It is per-monitor v2 now and
lays itself out again on WM_DPICHANGED: its text (the same point size),
its tabs, status bar and find bar at the new scale, at the size suggested.

At 100% nothing changes.

Test: test/dpifollow-gate.sh part 6 (mutant SG_MUTANT_NOTEPAD_DPI_IGNORED
in main.c); test/notepad gate.
---
--- a/programs/notepad/main.c
+++ b/programs/notepad/main.c
@@ -127,6 +127,7 @@ static BOOL doc_modified(DOC *d)
 }
 
 static void layout_main(void);
+static void make_fonts(void);
 static void update_title(void);
 static void update_status(void);
 static BOOL open_file(const WCHAR *path, ENCODING force, BOOL new_tab);
@@ -2306,6 +2307,38 @@ static LRESULT CALLBACK main_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
     case WM_INITMENUPOPUP:
         init_menu((HMENU)wp);
         return 0;
+#ifndef SG_MUTANT_NOTEPAD_DPI_IGNORED
+    case WM_DPICHANGED:
+    {
+        /* Stained Glass OS: a new display scale while Notepad is open (it is
+         * per-monitor v2): its text, tabs, status bar and find bar at it --
+         * crisp, not Wine's scaled picture of a window at the old scale */
+        const RECT *r = (const RECT *)lp;
+        int old = G.dpi, i;
+        BOOL find_shown = G.findbar && IsWindowVisible(G.findbar);
+        HFONT fonts[] = { G.ui_font, G.ui_bold, G.sym_font };
+
+        if (!HIWORD(wp) || HIWORD(wp) == (UINT)old) return 0;
+        G.dpi = HIWORD(wp);
+        G.lf.lfHeight = MulDiv(G.lf.lfHeight, G.dpi, old);
+        make_fonts();
+        for (i = 0; i < ARRAY_SIZE(fonts); i++) if (fonts[i]) DeleteObject(fonts[i]);
+        G.tab_h = S(40);
+        G.status_h = S(26);
+        for (i = 0; i < G.ndocs; i++) ed_set_font(G.docs[i]->ed, &G.lf);
+        if (G.findbar)
+        {
+            /* its dialog made again at the new scale */
+            DestroyWindow(G.findbar);
+            G.findbar = NULL;
+            if (find_shown) open_find(G.replace_mode);
+        }
+        SetWindowPos(hwnd, NULL, r->left, r->top, r->right - r->left, r->bottom - r->top, SWP_NOZORDER | SWP_NOACTIVATE);
+        layout_main();
+        RedrawWindow(hwnd, NULL, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN);
+        return 0;
+    }
+#endif
     case WM_MEASUREITEM:
         if (menubar_measure((MEASUREITEMSTRUCT *)lp)) return TRUE;
         break;
--- a/programs/notepad/notepad.manifest
+++ b/programs/notepad/notepad.manifest
@@ -16,6 +16,7 @@
 <application xmlns="urn:schemas-microsoft-com:asm.v3">
     <windowsSettings>
         <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
+        <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
     </windowsSettings>
 </application>
 </assembly>
