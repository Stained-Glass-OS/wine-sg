+static HRESULT component_create(const struct component_info *info, INetCfgComponent **out)
+{
+    NetComponent *This = HeapAlloc(GetProcessHeap(), 0, sizeof(*This));
+
+    if (!This) return E_OUTOFMEMORY;
+    This->INetCfgComponent_iface.lpVtbl = &component_vtbl;
+    This->ref = 1;
+    This->info = info;
+    *out = &This->INetCfgComponent_iface;
+    return S_OK;
+}
+
+static const struct component_info *find_component(const GUID *class_guid, const WCHAR *id)
+{
+    ULONG i;
+
+    for (i = 0; i < ARRAY_SIZE(components); i++)
+    {
+        if (class_guid && !IsEqualGUID(class_guid, components[i].class_guid)) continue;
+        if (id && wcsicmp(id, components[i].id)) continue;
+        return &components[i];
+    }
+    return NULL;
+}
