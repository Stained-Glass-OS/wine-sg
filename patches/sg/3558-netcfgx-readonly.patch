+
+static HRESULT WINAPI class_FindComponent(INetCfgClass *iface, LPCWSTR id, INetCfgComponent **out)
+{
+    const struct component_info *info;
+
+    if (!id || !out) return E_POINTER;
+    *out = NULL;
+    if (!(info = find_component(&impl_from_INetCfgClass(iface)->class_guid, id))) return S_FALSE;
+    return component_create(info, out);
+}
+
+static HRESULT WINAPI class_EnumComponents(INetCfgClass *iface, IEnumNetCfgComponent **out)
+{
+    if (!out) return E_POINTER;
+    return enum_create(&impl_from_INetCfgClass(iface)->class_guid, 0, out);
+}
