+cpp_quote("#define NETCFG_E_NOT_INITIALIZED      MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, 0xA021)")
 cpp_quote("#define NETCFG_E_NO_WRITE_LOCK        MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, 0xA024)")
 
