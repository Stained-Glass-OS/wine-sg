+/* ---- IEnumNetCfgComponent ---- */
+
+typedef struct
+{
+    IEnumNetCfgComponent IEnumNetCfgComponent_iface;
+    LONG ref;
+    GUID class_guid;
+    ULONG pos;   /* index into components */
+} NetComponentEnum;
+
+static inline NetComponentEnum *impl_from_IEnumNetCfgComponent(IEnumNetCfgComponent *iface)
+{
+    return CONTAINING_RECORD(iface, NetComponentEnum, IEnumNetCfgComponent_iface);
+}
+
+static HRESULT WINAPI enum_QueryInterface(IEnumNetCfgComponent *iface, REFIID riid, void **out)
+{
+    NetComponentEnum *This = impl_from_IEnumNetCfgComponent(iface);
+
+    if (IsEqualGUID(riid, &IID_IEnumNetCfgComponent) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *out = &This->IEnumNetCfgComponent_iface;
+        IEnumNetCfgComponent_AddRef(*out);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_AddRef(IEnumNetCfgComponent *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumNetCfgComponent(iface)->ref);
+}
+
+static ULONG WINAPI enum_Release(IEnumNetCfgComponent *iface)
+{
+    NetComponentEnum *This = impl_from_IEnumNetCfgComponent(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref) HeapFree(GetProcessHeap(), 0, This);
+    return ref;
+}
+
+/* next component of the class from position *pos, or NULL */
+static const struct component_info *enum_next_info(const GUID *class_guid, ULONG *pos)
+{
+    while (*pos < ARRAY_SIZE(components))
+    {
+        const struct component_info *info = &components[(*pos)++];
+        if (IsEqualGUID(class_guid, info->class_guid)) return info;
+    }
+    return NULL;
+}
+
+static HRESULT WINAPI enum_Next(IEnumNetCfgComponent *iface, ULONG celt, INetCfgComponent **rgelt, ULONG *fetched)
+{
+    NetComponentEnum *This = impl_from_IEnumNetCfgComponent(iface);
+    const struct component_info *info;
+    ULONG count = 0;
+    HRESULT hr = S_OK;
+
+    if (!rgelt) return E_POINTER;
+    while (count < celt && (info = enum_next_info(&This->class_guid, &This->pos)))
+    {
+        if (FAILED(hr = component_create(info, &rgelt[count])))
+            break;
+        count++;
+    }
+    if (fetched) *fetched = count;
+    if (FAILED(hr)) return hr;
+    return count == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_Skip(IEnumNetCfgComponent *iface, ULONG celt)
+{
+    NetComponentEnum *This = impl_from_IEnumNetCfgComponent(iface);
+    ULONG count = 0;
+
+    while (count < celt && enum_next_info(&This->class_guid, &This->pos)) count++;
+    return count == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_Reset(IEnumNetCfgComponent *iface)
+{
+    impl_from_IEnumNetCfgComponent(iface)->pos = 0;
+    return S_OK;
+}
+
+static const IEnumNetCfgComponentVtbl enum_vtbl;
+
+static HRESULT enum_create(const GUID *class_guid, ULONG pos, IEnumNetCfgComponent **out)
+{
+    NetComponentEnum *This = HeapAlloc(GetProcessHeap(), 0, sizeof(*This));
+
+    if (!This) return E_OUTOFMEMORY;
+    This->IEnumNetCfgComponent_iface.lpVtbl = &enum_vtbl;
+    This->ref = 1;
+    This->class_guid = *class_guid;
+    This->pos = pos;
+    *out = &This->IEnumNetCfgComponent_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_Clone(IEnumNetCfgComponent *iface, IEnumNetCfgComponent **out)
+{
+    NetComponentEnum *This = impl_from_IEnumNetCfgComponent(iface);
+
+    if (!out) return E_POINTER;
+    return enum_create(&This->class_guid, This->pos, out);
+}
+
+static const IEnumNetCfgComponentVtbl enum_vtbl =
+{
+    enum_QueryInterface, enum_AddRef, enum_Release, enum_Next, enum_Skip, enum_Reset, enum_Clone
+};
