+static HRESULT co_string(const WCHAR *src, WCHAR **out)
+{
+    SIZE_T size = (wcslen(src) + 1) * sizeof(WCHAR);
+
+    if (!out) return E_POINTER;
+    if (!(*out = CoTaskMemAlloc(size))) return E_OUTOFMEMORY;
+    memcpy(*out, src, size);
+    return S_OK;
+}
+
+/* ---- INetCfgComponent ---- */
+
+typedef struct
+{
+    INetCfgComponent INetCfgComponent_iface;
+    LONG ref;
+    const struct component_info *info;
+} NetComponent;
+
+static inline NetComponent *impl_from_INetCfgComponent(INetCfgComponent *iface)
+{
+    return CONTAINING_RECORD(iface, NetComponent, INetCfgComponent_iface);
+}
+
+static HRESULT WINAPI component_QueryInterface(INetCfgComponent *iface, REFIID riid, void **out)
+{
+    NetComponent *This = impl_from_INetCfgComponent(iface);
+
+    if (IsEqualGUID(riid, &IID_INetCfgComponent) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *out = &This->INetCfgComponent_iface;
+        INetCfgComponent_AddRef(*out);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI component_AddRef(INetCfgComponent *iface)
+{
+    return InterlockedIncrement(&impl_from_INetCfgComponent(iface)->ref);
+}
+
+static ULONG WINAPI component_Release(INetCfgComponent *iface)
+{
+    NetComponent *This = impl_from_INetCfgComponent(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref) HeapFree(GetProcessHeap(), 0, This);
+    return ref;
+}
+
+static HRESULT WINAPI component_GetDisplayName(INetCfgComponent *iface, LPWSTR *name)
+{
+    return co_string(impl_from_INetCfgComponent(iface)->info->display_name, name);
+}
+
+static HRESULT WINAPI component_SetDisplayName(INetCfgComponent *iface, LPCWSTR name)
+{
+    FIXME("%p %s\n", iface, debugstr_w(name));
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI component_GetHelpText(INetCfgComponent *iface, LPWSTR *text)
+{
+    return co_string(impl_from_INetCfgComponent(iface)->info->help_text, text);
+}
+
+static HRESULT WINAPI component_GetId(INetCfgComponent *iface, LPWSTR *id)
+{
+    return co_string(impl_from_INetCfgComponent(iface)->info->id, id);
+}
+
+static HRESULT WINAPI component_GetCharacteristics(INetCfgComponent *iface, DWORD *chars)
+{
+    if (!chars) return E_POINTER;
+    *chars = impl_from_INetCfgComponent(iface)->info->characteristics;
+    return S_OK;
+}
+
+static HRESULT WINAPI component_GetInstanceGuid(INetCfgComponent *iface, GUID *guid)
+{
