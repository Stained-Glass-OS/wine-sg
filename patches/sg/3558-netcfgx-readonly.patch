+/* ---- the write lock: one holder on the whole system, kept in a named semaphore ---- */
+
+#define LOCK_MAPPING_SIZE 1024
+static const WCHAR lock_semaphore_name[] = L"Global\\SGNetCfgWriteLock";
+static const WCHAR lock_mapping_name[] = L"Global\\SGNetCfgWriteLockHolder";
+
 typedef struct NetConfiguration
 {
     INetCfg INetCfg_iface;
     INetCfgLock INetCfgLock_iface;
 
     LONG ref;
+    BOOL initialized;
+    HANDLE lock_semaphore;   /* non-NULL while this object holds the write lock */
+    HANDLE holder_map;       /* the description of the holder, visible to others while the lock is held */
 } NetConfiguration;
 
 static inline NetConfiguration *impl_from_INetCfg(INetCfg *iface)
@@ -45,6 +437,63 @@
     return CONTAINING_RECORD(iface, NetConfiguration, INetCfgLock_iface);
 }
 
+static BOOL is_admin(void)
+{
+    SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    PSID admins;
+    BOOL ret = FALSE;
+
+    if (AllocateAndInitializeSid(&nt, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS, 0, 0, 0, 0, 0, 0, &admins))
+    {
+        if (!CheckTokenMembership(NULL, admins, &ret)) ret = FALSE;
+        FreeSid(admins);
+    }
+    return ret;
+}
+
+static HANDLE lock_set_holder(const WCHAR *description)
+{
+    HANDLE map = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, LOCK_MAPPING_SIZE, lock_mapping_name);
+    WCHAR *view;
+
+    if (!map) return NULL;
+    if ((view = MapViewOfFile(map, FILE_MAP_WRITE, 0, 0, LOCK_MAPPING_SIZE)))
+    {
+        lstrcpynW(view, description, LOCK_MAPPING_SIZE / sizeof(WCHAR));
+        UnmapViewOfFile(view);
+    }
+    return map;
+}
+
+/* the description of the client holding the lock, as a CoTaskMem string (NULL if unknown) */
+static WCHAR *lock_get_holder(void)
+{
+    HANDLE map = OpenFileMappingW(FILE_MAP_READ, FALSE, lock_mapping_name);
+    WCHAR *view, *ret = NULL;
+
+    if (!map) return NULL;
+    if ((view = MapViewOfFile(map, FILE_MAP_READ, 0, 0, LOCK_MAPPING_SIZE)))
+    {
+        WCHAR copy[LOCK_MAPPING_SIZE / sizeof(WCHAR)];
+
+        lstrcpynW(copy, view, ARRAY_SIZE(copy));   /* the view is read-only and need not be terminated */
+        co_string(copy, &ret);
+        UnmapViewOfFile(view);
+    }
+    CloseHandle(map);
+    return ret;
+}
+
+static void release_write_lock(NetConfiguration *This)
+{
+    if (!This->lock_semaphore) return;
+    if (This->holder_map) CloseHandle(This->holder_map);
+    This->holder_map = NULL;
+    ReleaseSemaphore(This->lock_semaphore, 1, NULL);
+    CloseHandle(This->lock_semaphore);
+    This->lock_semaphore = NULL;
+}
