+static HRESULT WINAPI component_OpenParamKey(INetCfgComponent *iface, HKEY *key)
+{
+    static const WCHAR prefix[] = L"System\\CurrentControlSet\\Services\\";
+    NetComponent *This = impl_from_INetCfgComponent(iface);
+    WCHAR path[128];
+    LONG err;
+
+    if (!key) return E_POINTER;
+    wcscpy(path, prefix);
+    wcscat(path, This->info->bind_name);
+    wcscat(path, L"\\Parameters");
+    if ((err = RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_ALL_ACCESS, key)))
+    {
+        *key = NULL;
+        return HRESULT_FROM_WIN32(err);
+    }
+    return S_OK;
