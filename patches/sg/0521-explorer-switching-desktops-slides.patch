From: Stained Glass OS <ke7oxh@gmail.com>
Subject: explorer: switching virtual desktops slides

David: "simple apps panning when you switch desktop". Switching, a picture of
the work area rides a topmost, click-through window over the switch and slides
off toward the desktop being left (smooth-step, 260 ms), uncovering the other,
as Windows 10 does. With "Show animations in Windows" on and
HKCU\Software\Stained Glass\Effects SlideDesktops (on unless 0); not under Task
View. SG_DESKTOP_SLIDE_MS sets the length (for gates).

Gate: make test-desktop-slide.
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -359,11 +359,114 @@
     else SetForegroundWindow( vd_tray );
 }
 
+/* Stained Glass OS: switching desktops slides -- the desktop being left moves
+ * off to the side, uncovering the other (David 2026-09-29: "apps panning when
+ * you switch desktop"), as Windows 10 does. A picture of the work area rides a
+ * topmost, click-through window that the switch happens under. With "Show
+ * animations in Windows" on and HKCU\Software\Stained Glass\Effects
+ * SlideDesktops (on unless 0). SG_DESKTOP_SLIDE_MS sets the length (gates). */
+static BOOL tv_animations(void);
+static HWND slide_wnd;
+static HBITMAP slide_bmp;
+static DWORD slide_start;
+static int slide_dir, slide_w;
+
+static int slide_ms(void)
+{
+    const char *e = getenv( "SG_DESKTOP_SLIDE_MS" );
+    int ms = e ? atoi( e ) : 260;
+    return ms > 0 ? ms : 260;
+}
+
+static BOOL slide_enabled(void)
+{
+    DWORD v = 1, size = sizeof(v);
+    if (!tv_animations()) return FALSE;
+    RegGetValueW( HKEY_CURRENT_USER, L"Software\\Stained Glass\\Effects", L"SlideDesktops",
+                  RRF_RT_REG_DWORD, NULL, &v, &size );
+    return v != 0;
+}
+
+static LRESULT CALLBACK slide_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    switch (msg)
+    {
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC dc = BeginPaint( hwnd, &ps ), mdc = CreateCompatibleDC( dc );
+        RECT rc;
+        GetClientRect( hwnd, &rc );
+        SelectObject( mdc, slide_bmp );
+        BitBlt( dc, 0, 0, rc.right, rc.bottom, mdc, 0, 0, SRCCOPY );
+        DeleteDC( mdc );
+        EndPaint( hwnd, &ps );
+        return 0;
+    }
+    case WM_TIMER:
+    {
+        RECT work;
+        double t = (double)(GetTickCount() - slide_start) / slide_ms(), e;
+        if (t >= 1.0) { DestroyWindow( hwnd ); return 0; }
+        e = t * t * (3.0 - 2.0 * t);   /* smooth step */
+        SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
+        SetWindowPos( hwnd, HWND_TOPMOST, work.left - slide_dir * (int)(slide_w * e), work.top, 0, 0,
+                      SWP_NOSIZE | SWP_NOACTIVATE );
+        return 0;
+    }
+    case WM_DESTROY:
+        if (slide_bmp) DeleteObject( slide_bmp );
+        slide_bmp = 0;
+        slide_wnd = 0;
+        return 0;
+    case WM_NCHITTEST:
+        return HTTRANSPARENT;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+static void slide_begin( int dir )
+{
+    static BOOL registered;
+    RECT work;
+    HDC screen, mdc;
+
+    if (slide_wnd) DestroyWindow( slide_wnd );
+    if (!slide_enabled()) return;
+    if (!registered)
+    {
+        WNDCLASSW wc = { 0 };
+        wc.lpfnWndProc = slide_proc;
+        wc.lpszClassName = L"SgDesktopSlide";
+        wc.hCursor = LoadCursorW( 0, (const WCHAR *)IDC_ARROW );
+        registered = !!RegisterClassW( &wc );
+    }
+    SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
+    slide_w = work.right - work.left;
+    screen = GetDC( 0 );
+    mdc = CreateCompatibleDC( screen );
+    slide_bmp = CreateCompatibleBitmap( screen, slide_w, work.bottom - work.top );
+    SelectObject( mdc, slide_bmp );
+    BitBlt( mdc, 0, 0, slide_w, work.bottom - work.top, screen, work.left, work.top, SRCCOPY );
+    DeleteDC( mdc );
+    ReleaseDC( 0, screen );
+    slide_dir = dir;
+    slide_wnd = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE | WS_EX_TRANSPARENT,
+                                 L"SgDesktopSlide", NULL, WS_POPUP, work.left, work.top,
+                                 slide_w, work.bottom - work.top, 0, 0, 0, 0 );
+    if (!slide_wnd) { DeleteObject( slide_bmp ); slide_bmp = 0; return; }
+    ShowWindow( slide_wnd, SW_SHOWNOACTIVATE );
+    UpdateWindow( slide_wnd );
+    slide_start = GetTickCount();
+    SetTimer( slide_wnd, 1, 15, NULL );
+}
+
 void vd_switch( int d, BOOL indicate )
 {
     HWND fg;
 
     if (d < 0 || d >= vd_count || d == vd_current) return;
+    if (!taskview) slide_begin( d > vd_current ? 1 : -1 );
     TRACE( "switching from desktop %d to %d of %d\n", vd_current, d, vd_count );
     if ((fg = GetForegroundWindow()) && GetAncestor( fg, GA_ROOTOWNER ) && is_app_window( GetAncestor( fg, GA_ROOTOWNER )))
         capture_thumb( GetAncestor( fg, GA_ROOTOWNER ));
