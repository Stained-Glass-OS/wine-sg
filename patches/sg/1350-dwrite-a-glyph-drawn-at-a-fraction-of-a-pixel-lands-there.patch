+/* Stained Glass OS: a glyph's origin in the run, split into the whole pixel
+ * its bitmap is placed at and the fraction (26.6, in 1/16 pixel steps) its
+ * outline is moved by before it is rendered. The origin was truncated to the
+ * pixel (OffsetRect takes integers): Skia, which draws each glyph at a
+ * quarter pixel of its place through the run's transform, had every glyph
+ * up to 3/4 pixel off -- uneven letter spacing in Chromium (VS Code, Chrome,
+ * Edge). Aliased glyphs are placed at the nearest whole pixel. */
+static void glyphrunanalysis_split_origin(const struct dwrite_glyphrunanalysis *analysis, unsigned int i,
+        POINT *whole, struct dwrite_glyphbitmap *glyph_bitmap)
+{
+    float x = analysis->origins[i].x, y = analysis->origins[i].y;
+#ifndef SG_MUTANT_DWSPACING
+    int fx, fy;
+
+    if (analysis->rendering_mode == DWRITE_RENDERING_MODE1_ALIASED)
+    {
+        whole->x = floorf(x + 0.5f);
+        whole->y = floorf(y + 0.5f);
+        glyph_bitmap->offset_x = glyph_bitmap->offset_y = 0;
+        return;
+    }
+    whole->x = floorf(x);
+    whole->y = floorf(y);
+    fx = (int)floorf((x - whole->x) * 16.0f + 0.5f) * 4;
+    fy = (int)floorf((y - whole->y) * 16.0f + 0.5f) * 4;
+    if (fx >= 64) { whole->x++; fx = 0; }
+    if (fy >= 64) { whole->y++; fy = 0; }
+    glyph_bitmap->offset_x = fx;
+    glyph_bitmap->offset_y = fy;
+#else
+    whole->x = x;
+    whole->y = y;
+    glyph_bitmap->offset_x = glyph_bitmap->offset_y = 0;
+#endif
+}
+
 static void glyphrunanalysis_get_texturebounds(struct dwrite_glyphrunanalysis *analysis, RECT *bounds)
 {
     struct dwrite_glyphbitmap glyph_bitmap;
