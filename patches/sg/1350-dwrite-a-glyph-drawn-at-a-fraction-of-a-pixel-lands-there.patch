 }
 
+/* Stained Glass OS: a glyph drawn at a fraction of a pixel (Skia asks for
+ * each glyph at 0, 1/4, 1/2 and 3/4 of a pixel, in the run's transform) is
+ * moved by that fraction before it is measured and rendered; it was drawn at
+ * the whole pixel, every glyph up to 3/4 pixel off its place -- Chromium's
+ * text, VS Code's, read "Fun dam entals". Offsets are 26.6, y down. Bitmap
+ * glyphs cannot move by less than a pixel and are left. */
+static void glyph_translate_subpixel(FT_Glyph glyph, int offset_x, int offset_y)
+{
+#ifndef SG_MUTANT_DWSPACING
+    FT_Vector delta;
+
+    if ((!offset_x && !offset_y) || glyph->format != FT_GLYPH_FORMAT_OUTLINE)
+        return;
+    delta.x = offset_x;
+    delta.y = -offset_y;
+    pFT_Glyph_Transform(glyph, NULL, &delta);
+#endif
+}
+
 static NTSTATUS get_glyph_bbox(void *args)
 {
     struct get_glyph_bbox_params *params = args;
@@ -566,6 +585,7 @@
         /* Includes oblique and user transform. */
         pFT_Glyph_Transform(glyph, &m, NULL);
     }
+    glyph_translate_subpixel(glyph, params->offset_x, params->offset_y);
 
     pFT_Glyph_Get_CBox(glyph, FT_GLYPH_BBOX_PIXELS, &bbox);
     pFT_Done_Glyph(glyph);
@@ -703,6 +723,7 @@
             /* Includes oblique and user transform. */
             pFT_Glyph_Transform(glyph, &m, NULL);
         }
+        glyph_translate_subpixel(glyph, params->offset_x, params->offset_y);
 
