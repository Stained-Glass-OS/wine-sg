From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: a ComboBox's selected item centred, a presenter's VerticalContentAlignment

A ComboBox showed its selected item at the top of the box (Windows Terminal's settings: the text touched the box's top edge) or in the middle of its width. It is now at the left after WinUI's ComboBoxPadding and in the middle of the height, as WinUI's ComboBox template places its content presenter. A ContentPresenter with a VerticalContentAlignment set (WinUI's item templates centre theirs) now places an element content by it, not only a string.
---
diff --git a/dlls/windows.ui.xaml/control.c b/dlls/windows.ui.xaml/control.c
index 9f81a41..d3d25f3 100644
--- a/dlls/windows.ui.xaml/control.c
+++ b/dlls/windows.ui.xaml/control.c
@@ -349,6 +349,21 @@ void control_arrange( struct uielem *elem, struct xsize final, struct xsize *use
             rect.height = size.height;
         }
     }
+#ifndef SG_MUTANT_PRESENTER_VCONTENT_IGNORED
+    else if (xaml_is_presenter( elem ) && dobj_has_value( &control->e.d, prop_vcontent ))
+    {
+        /* an element content: placed by a VerticalContentAlignment set on the presenter (WinUI's
+         * ListViewItem and ComboBox templates centre theirs) */
+        INT32 v = get_enum( control, prop_vcontent, &IID_IReference_VerticalAlignment, XALIGN_STRETCH );
+        FLOAT h = control->child->desired.height;
+
+        if (v != XALIGN_STRETCH && h < rect.height)
+        {
+            rect.y += v == XALIGN_CENTER ? (rect.height - h) / 2 : v == XALIGN_RIGHT ? rect.height - h : 0;
+            rect.height = h;
+        }
+    }
+#endif
     uielem_arrange( control->child, rect );
 }
 
diff --git a/dlls/windows.ui.xaml/textinput.c b/dlls/windows.ui.xaml/textinput.c
index fab57f8..2b8de45 100644
--- a/dlls/windows.ui.xaml/textinput.c
+++ b/dlls/windows.ui.xaml/textinput.c
@@ -3673,10 +3673,12 @@ static void combo_make_face( struct items_control *combo )
     combo->face = face;
 }
 
+#define COMBO_PADDING 11
+
 static void combo_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
 {
     struct items_control *combo = items_from_elem( elem );
-    struct xsize infinite = { INFINITY, INFINITY }, inner = { fmax( 0, available.width - COMBO_CHEVRON ), available.height };
+    struct xsize infinite = { INFINITY, INFINITY }, inner = { fmax( 0, available.width - COMBO_CHEVRON - COMBO_PADDING ), available.height };
     struct uielem *child;
     FLOAT width = 0;
 
@@ -3702,12 +3704,12 @@ static void combo_measure( struct uielem *elem, struct xsize available, struct x
         uielem_measure( child, infinite );
         width = fmax( width, child->desired.width );
     }
-    desired->width = width + COMBO_CHEVRON;
+    desired->width = width + COMBO_CHEVRON + COMBO_PADDING;
     desired->height = 32;
     if (combo->face)
     {
         uielem_measure( combo->face, inner );
-        desired->width = fmax( desired->width, combo->face->desired.width + COMBO_CHEVRON );
+        desired->width = fmax( desired->width, combo->face->desired.width + COMBO_CHEVRON + COMBO_PADDING );
         desired->height = fmax( desired->height, combo->face->desired.height );
     }
 }
@@ -3717,6 +3719,33 @@ static void combo_arrange( struct uielem *elem, struct xsize final, struct xsize
     struct items_control *combo = items_from_elem( elem );
     struct xrect rect = { 0, 0, fmax( 0, final.width - COMBO_CHEVRON ), final.height };
 
+    /* what is selected: in the middle, as WinUI's ComboBox template centres its content presenter */
+#ifndef SG_MUTANT_COMBO_FACE_TOP
+    if (combo->face)
+    {
+        struct xaml_property *vcontent = xaml_property_find( L"Windows.UI.Xaml.Controls.Control", L"VerticalContentAlignment" );
+        struct uielem *child;
+        INT32 center = XALIGN_CENTER;
+
+        struct xaml_property *hcontent = xaml_property_find( L"Windows.UI.Xaml.Controls.Control", L"HorizontalContentAlignment" );
+        INT32 left = XALIGN_LEFT;
+
+        /* the item itself (its text at its left, in the middle), and its content presenter */
+        if (hcontent && !dobj_has_value( &combo->face->d, hcontent ))
+            put_box( &combo->face->d, hcontent, xbox_ref( &IID_IReference_HorizontalAlignment, &left, sizeof(left) ) );
+        if (vcontent && !dobj_has_value( &combo->face->d, vcontent ))
+            put_box( &combo->face->d, vcontent, xbox_ref( &IID_IReference_VerticalAlignment, &center, sizeof(center) ) );
+        LIST_FOR_EACH_ENTRY( child, &combo->face->children, struct uielem, entry )
+            if (vcontent && xaml_is_presenter( child ) && !dobj_has_value( &child->d, vcontent ))
+                put_box( &child->d, vcontent, xbox_ref( &IID_IReference_VerticalAlignment, &center, sizeof(center) ) );
+    }
+    /* after WinUI's ComboBoxPadding at its left */
+    if (rect.width > COMBO_PADDING)
+    {
+        rect.x = COMBO_PADDING;
+        rect.width -= COMBO_PADDING;
+    }
+#endif
     if (combo->face) uielem_arrange( combo->face, rect );
     *used = final;
 }
