From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] webservices: reader integer overflow, duplicate xmlns, move and buffer checks

From Wine's own reader tests (real Windows): 32 and 64 bit integers that do
not fit are malformed (WS_E_INVALID_FORMAT) while 8 and 16 bit ones
overflow, uint64 overflow is malformed, a minus on an unsigned value is
WS_E_NUMERIC_OVERFLOW, one prefix declared twice on an element is
WS_E_INVALID_FORMAT, WsGetNamespaceFromPrefix works after the end element
(prefix gone), WsMoveReader needs an XML buffer input, and WsReadXmlBuffer
without input is E_FAIL. 9 todo_wine marks removed.

Gate: test/wsreader-gate.sh extended. Mutants SG_MUTANT_WS_INTOVF, _UNEG,
_DUPNS, _NSSTATE, _MOVEBUF, _NOINPUT are caught.
---
--- a/dlls/webservices/reader.c
+++ b/dlls/webservices/reader.c
@@ -709,7 +709,12 @@ HRESULT WINAPI WsGetNamespaceFromPrefix( WS_XML_READER *handle, const WS_XML_STR
         return E_INVALIDARG;
     }
 
-    if (reader->state != READER_STATE_STARTELEMENT) hr = WS_E_INVALID_OPERATION;
+#ifndef SG_MUTANT_WS_NSSTATE
+    if (reader->state == READER_STATE_INITIAL)
+#else
+    if (reader->state != READER_STATE_STARTELEMENT)
+#endif
+        hr = WS_E_INVALID_OPERATION;
     else if (!prefix->length)
     {
         *ns = &empty_ns;
@@ -725,7 +730,7 @@ HRESULT WINAPI WsGetNamespaceFromPrefix( WS_XML_READER *handle, const WS_XML_STR
         *ns = &xmlns_ns;
         found = TRUE;
     }
-    else
+    else if (reader->state == READER_STATE_STARTELEMENT || reader->state == READER_STATE_STARTATTRIBUTE)
     {
         WS_XML_ELEMENT_NODE *elem = &reader->current->hdr;
         ULONG i;
@@ -2027,6 +2032,24 @@ static HRESULT read_attributes_text( struct reader *reader, WS_XML_ELEMENT_NODE
     return S_OK;
 }
 
+/* the same prefix cannot be declared twice on one element */
+static BOOL has_duplicate_xmlns( const WS_XML_ELEMENT_NODE *elem )
+{
+    ULONG i, j;
+
+    for (i = 0; i < elem->attributeCount; i++)
+    {
+        if (!elem->attributes[i]->isXmlNs) continue;
+        for (j = i + 1; j < elem->attributeCount; j++)
+        {
+            if (!elem->attributes[j]->isXmlNs) continue;
+            if (WsXmlStringEquals( elem->attributes[i]->prefix, elem->attributes[j]->prefix, NULL ) == S_OK)
+                return TRUE;
+        }
+    }
+    return FALSE;
+}
+
 static HRESULT read_element_text( struct reader *reader )
 {
     unsigned int len = 0, ch, skip;
@@ -2068,6 +2091,13 @@ static HRESULT read_element_text( struct reader *reader )
     if (!(parent = find_parent( reader ))) goto error;
     if ((hr = parse_qname( start, len, &elem->prefix, &elem->localName )) != S_OK) goto error;
     if ((hr = read_attributes_text( reader, elem )) != S_OK) goto error;
+#ifndef SG_MUTANT_WS_DUPNS
+    if (has_duplicate_xmlns( elem ))
+    {
+        hr = WS_E_INVALID_FORMAT;
+        goto error;
+    }
+#endif
     if ((hr = set_namespaces( reader, elem )) != S_OK) goto error;
 
     read_insert_node( reader, parent, node );
@@ -3623,6 +3653,20 @@ static HRESULT read_move_to( struct reader *reader, WS_MOVE_TO move, BOOL *found
     return success ? S_OK : WS_E_INVALID_FORMAT;
 }
 
+/* what the writer needs when it copies from a reader: any buffer input, not only an XML buffer */
+HRESULT move_reader_internal( WS_XML_READER *handle, WS_MOVE_TO move )
+{
+    struct reader *reader = (struct reader *)handle;
+    HRESULT hr;
+
+    EnterCriticalSection( &reader->cs );
+    if (reader->magic != READER_MAGIC) hr = E_INVALIDARG;
+    else if (reader->input_type != WS_XML_READER_INPUT_TYPE_BUFFER) hr = WS_E_INVALID_OPERATION;
+    else hr = read_move_to( reader, move, NULL );
+    LeaveCriticalSection( &reader->cs );
+    return hr;
+}
+
 /**************************************************************************
  *          WsMoveReader		[webservices.@]
  */
@@ -3644,7 +3688,11 @@ HRESULT WINAPI WsMoveReader( WS_XML_READER *handle, WS_MOVE_TO move, BOOL *found
         return E_INVALIDARG;
     }
 
+#ifndef SG_MUTANT_WS_MOVEBUF
+    if (!reader->input_buf) hr = WS_E_INVALID_OPERATION;
+#else
     if (reader->input_type != WS_XML_READER_INPUT_TYPE_BUFFER) hr = WS_E_INVALID_OPERATION;
+#endif
     else hr = read_move_to( reader, move, found );
 
     LeaveCriticalSection( &reader->cs );
@@ -3755,6 +3803,10 @@ static HRESULT str_to_int64( const unsigned char *str, ULONG len, INT64 min, INT
         if ((!negative && (*ret > max / 10 || *ret * 10 > max - val)) ||
             (negative && (*ret < min / 10 || *ret * 10 < min - val)))
         {
+            /* Windows: 8 and 16 bit values overflow, 32 and 64 bit ones are malformed */
+#ifndef SG_MUTANT_WS_INTOVF
+            if (max > MAX_INT16) return WS_E_INVALID_FORMAT;
+#endif
             return WS_E_NUMERIC_OVERFLOW;
         }
         *ret = *ret * 10 + val;
@@ -3773,6 +3825,16 @@ static HRESULT str_to_uint64( const unsigned char *str, ULONG len, UINT64 max, U
     while (len && read_isspace( ptr[len - 1] )) { len--; }
     if (!len) return WS_E_INVALID_FORMAT;
 
+    /* a sign is not accepted: a minus is a value below the range, a plus is malformed */
+    if (*ptr == '-' && len > 1)
+    {
+        unsigned int i;
+        for (i = 1; i < len; i++) if (!isdigit( ptr[i] )) return WS_E_INVALID_FORMAT;
+#ifndef SG_MUTANT_WS_UNEG
+        return WS_E_NUMERIC_OVERFLOW;
+#endif
+    }
+
     while (len--)
     {
         unsigned int val;
@@ -3780,7 +3842,13 @@ static HRESULT str_to_uint64( const unsigned char *str, ULONG len, UINT64 max, U
         if (!isdigit( *ptr )) return WS_E_INVALID_FORMAT;
         val = *ptr - '0';
 
-        if ((*ret > max / 10 || *ret * 10 > max - val)) return WS_E_NUMERIC_OVERFLOW;
+        if ((*ret > max / 10 || *ret * 10 > max - val))
+        {
+#ifndef SG_MUTANT_WS_INTOVF
+            if (max == MAX_UINT64) return WS_E_INVALID_FORMAT;
+#endif
+            return WS_E_NUMERIC_OVERFLOW;
+        }
         *ret = *ret * 10 + val;
         ptr++;
     }
@@ -7672,7 +7740,11 @@ HRESULT WINAPI WsReadXmlBuffer( WS_XML_READER *handle, WS_HEAP *heap, WS_XML_BUF
         return E_INVALIDARG;
     }
 
+#ifndef SG_MUTANT_WS_NOINPUT
+    if (!reader->input_type) hr = E_FAIL;
+#else
     if (!reader->input_type) hr = WS_E_INVALID_OPERATION;
+#endif
     else
     {
         if ((hr = WsCreateWriter( NULL, 0, &writer, NULL )) != S_OK) goto done;
--- a/dlls/webservices/tests/reader.c
