+/* Eval, Execute, ExecuteGlobal (Stained Glass OS 1652) */
+static HRESULT run_dynamic_code(BuiltinDisp *This, VARIANT *arg, dyncode_mode_t mode, VARIANT *res)
+{
+    VARIANT ret;
+    HRESULT hres;
+    BSTR src;
+
+    TRACE("(%s %d)\n", debugstr_variant(arg), mode);
+
+    if (V_VT(arg) == VT_NULL) return MAKE_VBSERROR(VBSE_ILLEGAL_NULL_USE);
+    if (FAILED(hres = to_string(arg, &src))) return hres;
+    V_VT(&ret) = VT_EMPTY;
+    hres = exec_dynamic_code(This->ctx, src, mode, &ret);
+    SysFreeString(src);
+    if (SUCCEEDED(hres) && res) *res = ret;
+    else VariantClear(&ret);
+    return hres;
+}
