+static BOOL is_local_name(exec_ctx_t *scope, const WCHAR *name)
+{
+    dynamic_var_t *var;
+    unsigned i;
+
+    for(i = 0; i < scope->func->var_cnt; i++)
+        if(!wcsicmp(scope->func->vars[i].name, name)) return TRUE;
+    for(i = 0; i < scope->func->arg_cnt; i++)
+        if(!wcsicmp(scope->func->args[i].name, name)) return TRUE;
+    for(var = scope->dynamic_vars; var; var = var->next)
+        if(!wcsicmp(var->name, name)) return TRUE;
+    return FALSE;
+}
+
+/* Eval, Execute and ExecuteGlobal (Stained Glass OS 1652). Eval evaluates an
+ * expression and Execute runs statements in the scope of the procedure that
+ * calls them: its arguments, variables and Me, and variables they declare
+ * are its own. ExecuteGlobal runs statements at the global level. Functions
+ * and classes they declare are global. Errors, compile errors included, are
+ * raised in the caller, where On Error can handle them. */
+HRESULT exec_dynamic_code(script_ctx_t *ctx, const WCHAR *src, dyncode_mode_t mode, VARIANT *res)
+{
+    exec_ctx_t *scope = NULL;
+    vbscode_t *code;
+    VARIANT ret;
+    BOOL local;
+    unsigned i;
+    HRESULT hres;
+
+    hres = compile_script(ctx, src, NULL, NULL, 0, 0,
+                          SCRIPTTEXT_SG_NOREPORT | (mode == DYNCODE_EVAL ? SCRIPTTEXT_ISEXPRESSION : 0), &code);
+    if(FAILED(hres))
+        return hres;
+
+    if(mode != DYNCODE_EXECUTE_GLOBAL) {
+        scope = ctx->exec_top;
+        while(scope && scope->scope)
+            scope = scope->scope;
+    }
+#ifdef SG_MUTANT_EXECUTE_GLOBAL_SCOPE
+    scope = NULL;
+#endif
+    local = scope && scope->func->type != FUNC_GLOBAL;
+
+    hres = register_global_code(ctx, code, !local);
+    for(i = 0; SUCCEEDED(hres) && local && i < code->main_code.var_cnt; i++) {
+        VARIANT *v;
+        if(is_local_name(scope, code->main_code.vars[i].name))
+            hres = MAKE_VBSERROR(VBSE_NAME_REDEFINED);
+        else
+            hres = add_dynamic_var(scope, code->main_code.vars[i].name, FALSE, &v);
+    }
+
+    V_VT(&ret) = VT_EMPTY;
+    if(SUCCEEDED(hres))
+        hres = exec_script_scoped(ctx, FALSE, &code->main_code, NULL, NULL, &ret, scope);
+    if(FAILED(hres)) {
+        /* the error is the caller's, at its statement */
+        clear_error_loc(ctx);
+    }else if(res && mode == DYNCODE_EVAL) {
+        *res = ret;
+        V_VT(&ret) = VT_EMPTY;
+    }
+    VariantClear(&ret);
+
+    /* code that declared no function or class is not needed any more */
+    if(!code->funcs && !code->classes) {
+        list_remove(&code->entry);
+        release_vbscode(code);
+    }
+    return hres;
+}
