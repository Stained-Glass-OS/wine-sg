+/* GetRef (Stained Glass OS 1652): an object whose default method calls a
+ * script procedure, as event handlers are given ("window.onload =
+ * GetRef(...)"). It lives as long as its holders do; when the script is
+ * closed it stops calling. */
+typedef struct {
+    IDispatch IDispatch_iface;
+    LONG ref;
+    script_ctx_t *ctx;
+    function_t *func;
+    struct list entry;
+} FuncRef;
+
+static inline FuncRef *impl_from_FuncRef(IDispatch *iface)
+{
+    return CONTAINING_RECORD(iface, FuncRef, IDispatch_iface);
+}
+
+static HRESULT WINAPI FuncRef_QueryInterface(IDispatch *iface, REFIID riid, void **ppv)
+{
+    FuncRef *This = impl_from_FuncRef(iface);
+
+    if (IsEqualGUID(&IID_IUnknown, riid) || IsEqualGUID(&IID_IDispatch, riid))
+    {
+        *ppv = &This->IDispatch_iface;
+        IDispatch_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI FuncRef_AddRef(IDispatch *iface)
+{
+    FuncRef *This = impl_from_FuncRef(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI FuncRef_Release(IDispatch *iface)
+{
+    FuncRef *This = impl_from_FuncRef(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        if (This->ctx) list_remove(&This->entry);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI FuncRef_GetTypeInfoCount(IDispatch *iface, UINT *count)
+{
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI FuncRef_GetTypeInfo(IDispatch *iface, UINT index, LCID lcid, ITypeInfo **info)
+{
+    return DISP_E_BADINDEX;
+}
+
+static HRESULT WINAPI FuncRef_GetIDsOfNames(IDispatch *iface, REFIID riid, LPOLESTR *names, UINT count,
+        LCID lcid, DISPID *ids)
+{
+    UINT i;
+    for (i = 0; i < count; i++) ids[i] = DISPID_UNKNOWN;
+    return DISP_E_UNKNOWNNAME;
+}
+
+static HRESULT WINAPI FuncRef_Invoke(IDispatch *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *dp, VARIANT *res, EXCEPINFO *ei, UINT *err)
+{
+    FuncRef *This = impl_from_FuncRef(iface);
+    DISPPARAMS empty = { NULL, NULL, 0, 0 };
+    unsigned cnt;
+
+    TRACE("(%p)->(%ld %x %p)\n", This, id, flags, dp);
+
+    if (id != DISPID_VALUE) return DISP_E_MEMBERNOTFOUND;
+    if (!(flags & (DISPATCH_METHOD | DISPATCH_PROPERTYGET))) return DISP_E_MEMBERNOTFOUND;
+    if (!This->ctx || !This->func) return E_UNEXPECTED;
+    if (!dp) dp = &empty;
+    cnt = dp->cArgs - dp->cNamedArgs;
+    if (cnt != This->func->arg_cnt) return MAKE_VBSERROR(VBSE_FUNC_ARITY_MISMATCH);
+    if (res) V_VT(res) = VT_EMPTY;
+    /* called from outside a running script (an event): errors are reported */
+    return exec_script(This->ctx, This->ctx->exec_top == NULL, This->func, NULL, dp, res);
+}
+
+static const IDispatchVtbl FuncRefVtbl = {
+    FuncRef_QueryInterface,
+    FuncRef_AddRef,
+    FuncRef_Release,
+    FuncRef_GetTypeInfoCount,
+    FuncRef_GetTypeInfo,
+    FuncRef_GetIDsOfNames,
+    FuncRef_Invoke
+};
+
+void detach_func_refs(script_ctx_t *ctx)
+{
+    FuncRef *iter, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(iter, next, &ctx->func_refs, FuncRef, entry)
+    {
+        list_remove(&iter->entry);
+        iter->ctx = NULL;
+        iter->func = NULL;
+    }
 }
 
 static HRESULT Global_GetRef(BuiltinDisp *This, VARIANT *arg, unsigned args_cnt, VARIANT *res)
