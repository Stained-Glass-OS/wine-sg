+    ScriptDisp *obj = This->ctx->script_obj;
+    function_t *func = NULL;
+    FuncRef *ref;
+    HRESULT hres;
+    size_t i;
+    BSTR name;
+
+    TRACE("(%s)\n", debugstr_variant(arg));
+
+    if (V_VT(arg) == VT_NULL) return MAKE_VBSERROR(VBSE_ILLEGAL_NULL_USE);
+    if (FAILED(hres = to_string(arg, &name))) return hres;
+    for (i = 0; obj && i < obj->global_funcs_cnt; i++)
+    {
+        if (!wcsicmp(obj->global_funcs[i]->name, name))
+        {
+            func = obj->global_funcs[i];
+            break;
+        }
+    }
+    SysFreeString(name);
+#ifdef SG_MUTANT_GETREF_NOTHING
+    func = NULL;
+#endif
+    if (!func) return MAKE_VBSERROR(VBSE_ILLEGAL_FUNC_CALL);
+
+    if (!(ref = calloc(1, sizeof(*ref)))) return E_OUTOFMEMORY;
+    ref->IDispatch_iface.lpVtbl = &FuncRefVtbl;
+    ref->ref = 1;
+    ref->ctx = This->ctx;
+    ref->func = func;
+    list_add_tail(&This->ctx->func_refs, &ref->entry);
+
+    if (!res)
+    {
+        IDispatch_Release(&ref->IDispatch_iface);
+        return S_OK;
+    }
+    V_VT(res) = VT_DISPATCH;
+    V_DISPATCH(res) = &ref->IDispatch_iface;
+    return S_OK;
 }
 
