+/* ---- async operation that is complete when it is created ---- */
+
+struct profile_async
+{
+    IAsyncOperation_ConnectionProfile IAsyncOperation_ConnectionProfile_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+
+    IConnectionProfile *result;
+    IAsyncOperationCompletedHandler_ConnectionProfile *handler;
+    AsyncStatus status;
+    HRESULT error;
+    UINT32 id;
+};
+
+static inline struct profile_async *profile_async_from( IAsyncOperation_ConnectionProfile *iface )
+{
+    return CONTAINING_RECORD( iface, struct profile_async, IAsyncOperation_ConnectionProfile_iface );
+}
+
+static inline struct profile_async *profile_async_from_info( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct profile_async, IAsyncInfo_iface );
+}
+
+static HRESULT WINAPI profile_async_QueryInterface( IAsyncOperation_ConnectionProfile *iface, REFIID iid, void **out )
+{
+    struct profile_async *impl = profile_async_from( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncOperation_ConnectionProfile ))
+        *out = &impl->IAsyncOperation_ConnectionProfile_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI profile_async_AddRef( IAsyncOperation_ConnectionProfile *iface )
+{
+    return InterlockedIncrement( &profile_async_from( iface )->ref );
+}
+
+static ULONG WINAPI profile_async_Release( IAsyncOperation_ConnectionProfile *iface )
+{
+    struct profile_async *impl = profile_async_from( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->result) IConnectionProfile_Release( impl->result );
+        if (impl->handler) IAsyncOperationCompletedHandler_ConnectionProfile_Release( impl->handler );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI profile_async_GetIids( IAsyncOperation_ConnectionProfile *iface, ULONG *count, IID **iids )
+{
+    IID *list;
+
+    if (!count || !iids) return E_POINTER;
+    if (!(list = CoTaskMemAlloc( 2 * sizeof(IID) ))) return E_OUTOFMEMORY;
+    list[0] = IID_IAsyncOperation_ConnectionProfile;
+    list[1] = IID_IAsyncInfo;
+    *iids = list;
+    *count = 2;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_async_GetRuntimeClassName( IAsyncOperation_ConnectionProfile *iface, HSTRING *name )
+{
+    return get_class_name( L"Windows.Foundation.IAsyncOperation`1<Windows.Networking.Connectivity.ConnectionProfile>", name );
+}
+
+static HRESULT WINAPI profile_async_GetTrustLevel( IAsyncOperation_ConnectionProfile *iface, TrustLevel *level )
+{
+    return get_base_trust( level );
+}
+
+static HRESULT WINAPI profile_async_put_Completed( IAsyncOperation_ConnectionProfile *iface,
+                                                   IAsyncOperationCompletedHandler_ConnectionProfile *handler )
+{
+    struct profile_async *impl = profile_async_from( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return S_OK;
+    IAsyncOperationCompletedHandler_ConnectionProfile_AddRef( (impl->handler = handler) );
+    /* already complete: the handler runs at once */
+    IAsyncOperationCompletedHandler_ConnectionProfile_Invoke( handler, iface, impl->status );
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_async_get_Completed( IAsyncOperation_ConnectionProfile *iface,
+                                                   IAsyncOperationCompletedHandler_ConnectionProfile **handler )
+{
+    struct profile_async *impl = profile_async_from( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    if (!handler) return E_POINTER;
+    if ((*handler = impl->handler)) IAsyncOperationCompletedHandler_ConnectionProfile_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_async_GetResults( IAsyncOperation_ConnectionProfile *iface, IConnectionProfile **results )
+{
+    struct profile_async *impl = profile_async_from( iface );
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+    if (!results) return E_POINTER;
+    *results = NULL;
+    if (impl->status == Error) return impl->error;
+    if ((*results = impl->result)) IConnectionProfile_AddRef( *results );
+    return S_OK;
+}
