+static HRESULT get_local_usage( struct connection_profile *impl, DateTime start, DateTime end, RoamingStates states,
+                                IDataUsage **value )
+{
+    struct adapter_info adapter;
+    struct data_usage *usage;
+    MIB_IF_ROW2 row;
+    FILETIME now;
+    UINT64 boot, now64;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (end.UniversalTime < start.UniversalTime) return E_INVALIDARG;
+    if (FAILED(hr = profile_get_adapter( impl, &adapter, NULL, NULL ))) return hr;
+
+    if (!(usage = calloc( 1, sizeof(*usage) ))) return E_OUTOFMEMORY;
+    usage->IDataUsage_iface.lpVtbl = &data_usage_vtbl;
+    usage->ref = 1;
+
+    /* the counters run from the boot: a period that ended before it, or one
+     * of roaming only, saw nothing on this host */
+    GetSystemTimeAsFileTime( &now );
+    now64 = ((UINT64)now.dwHighDateTime << 32) | now.dwLowDateTime;
+    boot = now64 - GetTickCount64() * 10000;
+    memset( &row, 0, sizeof(row) );
+    row.InterfaceLuid = adapter.luid;
+    if ((UINT64)end.UniversalTime >= boot && (states & RoamingStates_NotRoaming || !states) && !GetIfEntry2( &row ))
+    {
+        usage->sent = row.OutOctets;
+        usage->received = row.InOctets;
+    }
+    *value = &usage->IDataUsage_iface;
+    return S_OK;
 }
 
