+        hr = INetworkSecuritySettings_get_NetworkAuthenticationType( security, &auth );
+        ok( hr == S_OK && auth <= NetworkAuthenticationType_Ihv, "got hr %#lx, auth %d.\n", hr, auth );
+        hr = INetworkSecuritySettings_get_NetworkEncryptionType( security, &encryption );
+        ok( hr == S_OK && encryption <= NetworkEncryptionType_Ihv, "got hr %#lx, encryption %d.\n", hr, encryption );
+        INetworkSecuritySettings_Release( security );
+    }
+}
+
+static void test_lists_and_events(void)
+{
+    static const WCHAR *name = L"Windows.Networking.Connectivity.NetworkInformation";
+    INetworkInformationStatics *statics;
+    IVectorView_ConnectionProfile *profiles;
+    IIterable_ConnectionProfile *iterable;
+    IIterator_ConnectionProfile *iterator;
+    IVectorView_LanIdentifier *lans;
+    IVectorView_HostName *hosts;
+    IConnectionProfile *profile, *items[8];
+    struct status_handler handler = {{&status_handler_vtbl}, 1};
+    EventRegistrationToken token, token2;
+    UINT32 size, count, i;
+    boolean flag, has;
+    HSTRING str;
+    HRESULT hr;
+    IUnknown *unk;
+
+    WindowsCreateString( name, wcslen( name ), &str );
+    hr = RoGetActivationFactory( str, &IID_INetworkInformationStatics, (void **)&statics );
+    WindowsDeleteString( str );
+    if (FAILED(hr))
+    {
+        win_skip( "NetworkInformation not available.\n" );
+        return;
+    }
+
+    hr = INetworkInformationStatics_GetConnectionProfiles( statics, NULL );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+    hr = INetworkInformationStatics_GetConnectionProfiles( statics, &profiles );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IVectorView_ConnectionProfile_get_Size( profiles, &size );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    trace( "%u connection profiles\n", size );
+
+    hr = IVectorView_ConnectionProfile_GetAt( profiles, size, &profile );
+    ok( hr == E_BOUNDS, "got hr %#lx.\n", hr );
+    ok( !profile, "got %p.\n", profile );
+
+    hr = IVectorView_ConnectionProfile_QueryInterface( profiles, &IID_IIterable_ConnectionProfile, (void **)&iterable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IVectorView_ConnectionProfile_QueryInterface( profiles, &IID_IInspectable, (void **)&unk );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IUnknown_Release( unk );
+    hr = IIterable_ConnectionProfile_First( iterable, &iterator );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    count = 0;
+    hr = IIterator_ConnectionProfile_get_HasCurrent( iterator, &has );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    while (has)
+    {
+        hr = IIterator_ConnectionProfile_get_Current( iterator, &profile );
+        ok( hr == S_OK && profile, "got hr %#lx.\n", hr );
+        IConnectionProfile_Release( profile );
+        count++;
+        IIterator_ConnectionProfile_MoveNext( iterator, &has );
+    }
+    ok( count == size, "iterated %u of %u.\n", count, size );
+    hr = IIterator_ConnectionProfile_get_Current( iterator, &profile );
+    ok( hr == E_BOUNDS, "got hr %#lx.\n", hr );
+    IIterator_ConnectionProfile_Release( iterator );
+    IIterable_ConnectionProfile_Release( iterable );
+
+    count = 0xdeadbeef;
+    hr = IVectorView_ConnectionProfile_GetMany( profiles, 0, ARRAY_SIZE(items), items, &count );
+    ok( hr == S_OK && count == min( size, ARRAY_SIZE(items) ), "got hr %#lx, count %u.\n", hr, count );
+    for (i = 0; i < count; i++)
+    {
+        UINT32 index = 0xdeadbeef;
+
+        hr = IVectorView_ConnectionProfile_IndexOf( profiles, items[i], &index, &flag );
+        ok( hr == S_OK && flag && index == i, "got hr %#lx, found %d, index %u (expected %u).\n", hr, flag, index, i );
+        test_profile( items[i] );
+        IConnectionProfile_Release( items[i] );
+    }
+    IVectorView_ConnectionProfile_Release( profiles );
+
+    hr = INetworkInformationStatics_GetLanIdentifiers( statics, &lans );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IVectorView_LanIdentifier_get_Size( lans, &size );
+    ok( hr == S_OK && size == 0, "got hr %#lx, size %u.\n", hr, size );
+    IVectorView_LanIdentifier_Release( lans );
+
+    hr = INetworkInformationStatics_GetHostNames( statics, &hosts );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IVectorView_HostName_get_Size( hosts, &size );
+    ok( hr == S_OK && size > 0, "got hr %#lx, size %u.\n", hr, size );
+    for (i = 0; i < size; i++)
+    {
+        IHostName *host;
+        HSTRING raw;
+
+        hr = IVectorView_HostName_GetAt( hosts, i, &host );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = IHostName_get_RawName( host, &raw );
+        ok( hr == S_OK && WindowsGetStringLen( raw ) > 0, "got hr %#lx.\n", hr );
+        trace( "host name %s\n", debugstr_hstring( raw ) );
+        WindowsDeleteString( raw );
+        IHostName_Release( host );
+    }
+    IVectorView_HostName_Release( hosts );
+
+    hr = INetworkInformationStatics_add_NetworkStatusChanged( statics, NULL, &token );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+    hr = INetworkInformationStatics_add_NetworkStatusChanged( statics, &handler.INetworkStatusChangedEventHandler_iface, &token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( token.value != 0, "got token %#I64x.\n", token.value );
+    hr = INetworkInformationStatics_add_NetworkStatusChanged( statics, &handler.INetworkStatusChangedEventHandler_iface, &token2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( token2.value != token.value, "got equal tokens.\n" );
+    ok( handler.ref == 3, "got ref %ld.\n", handler.ref );
+    hr = INetworkInformationStatics_remove_NetworkStatusChanged( statics, token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = INetworkInformationStatics_remove_NetworkStatusChanged( statics, token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( handler.ref == 2, "got ref %ld.\n", handler.ref );
+    hr = INetworkInformationStatics_remove_NetworkStatusChanged( statics, token2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( handler.ref == 1, "got ref %ld.\n", handler.ref );
+
+    INetworkInformationStatics_Release( statics );
+}
+
 START_TEST(connectivity)
 {
     HRESULT hr;
@@ -143,6 +462,7 @@ START_TEST(connectivity)
     ok( hr == S_OK, "RoInitialize failed, hr %#lx\n", hr );
 
     test_NetworkInformationStatics();
+    test_lists_and_events();
 
     RoUninitialize();
 }
