+#define DEFINE_OBJECT( pfx, itype, st, member, iid, classname )                                         \
+    static inline st *pfx##_from( itype *iface ) { return CONTAINING_RECORD( iface, st, member ); }     \
+    static void pfx##_destroy( st *impl );                                                               \
+    static HRESULT WINAPI pfx##_QueryInterface( itype *iface, REFIID riid, void **out )                  \
+    {                                                                                                    \
+        st *impl = pfx##_from( iface );                                                                  \
+        TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( riid ), out );                       \
+        if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IInspectable ) ||              \
+            IsEqualGUID( riid, &IID_IAgileObject ) || IsEqualGUID( riid, iid ))                          \
+        {                                                                                                \
+            *out = &impl->member;                                                                        \
+            InterlockedIncrement( &impl->ref );                                                          \
+            return S_OK;                                                                                 \
+        }                                                                                                \
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( riid ) );                \
+        *out = NULL;                                                                                     \
+        return E_NOINTERFACE;                                                                            \
+    }                                                                                                    \
+    static ULONG WINAPI pfx##_AddRef( itype *iface )                                                     \
+    {                                                                                                    \
+        return InterlockedIncrement( &pfx##_from( iface )->ref );                                        \
+    }                                                                                                    \
+    static ULONG WINAPI pfx##_Release( itype *iface )                                                    \
+    {                                                                                                    \
+        st *impl = pfx##_from( iface );                                                                  \
+        ULONG ref = InterlockedDecrement( &impl->ref );                                                  \
+        if (!ref) pfx##_destroy( impl );                                                                 \
+        return ref;                                                                                      \
+    }                                                                                                    \
+    static HRESULT WINAPI pfx##_GetIids( itype *iface, ULONG *count, IID **iids )                        \
+    {                                                                                                    \
+        return get_one_iid( iid, count, iids );                                                          \
+    }                                                                                                    \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( itype *iface, HSTRING *name )                       \
+    {                                                                                                    \
+        return get_class_name( classname, name );                                                        \
+    }                                                                                                    \
+    static HRESULT WINAPI pfx##_GetTrustLevel( itype *iface, TrustLevel *level )                         \
+    {                                                                                                    \
+        return get_base_trust( level );                                                                  \
+    }
+
