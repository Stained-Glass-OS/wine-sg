+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(connectivity);
+
+/* IVectorView<T>, IIterable<T> and IIterator<T> have the same method layout for
+ * every T that is one pointer (an HSTRING or an interface), so one
+ * implementation serves all of them; only the identifiers and the element
+ * copy/free differ. */
+struct kind_info
+{
+    const IID *view_iid, *iterable_iid, *iterator_iid;
+    const WCHAR *view_name, *iterable_name, *iterator_name;
+    BOOL is_string;
+};
+
+static const struct kind_info *kind_info( enum vector_kind kind )
+{
+    static const struct kind_info infos[] =
+    {
+        { &IID_IVectorView_HSTRING, &IID_IIterable_HSTRING, &IID_IIterator_HSTRING,
+          L"Windows.Foundation.Collections.IVectorView`1<String>",
+          L"Windows.Foundation.Collections.IIterable`1<String>",
+          L"Windows.Foundation.Collections.IIterator`1<String>", TRUE },
+        { &IID_IVectorView_ConnectionProfile, &IID_IIterable_ConnectionProfile, &IID_IIterator_ConnectionProfile,
+          L"Windows.Foundation.Collections.IVectorView`1<Windows.Networking.Connectivity.ConnectionProfile>",
+          L"Windows.Foundation.Collections.IIterable`1<Windows.Networking.Connectivity.ConnectionProfile>",
+          L"Windows.Foundation.Collections.IIterator`1<Windows.Networking.Connectivity.ConnectionProfile>", FALSE },
+        { &IID_IVectorView_LanIdentifier, &IID_IIterable_LanIdentifier, &IID_IIterator_LanIdentifier,
+          L"Windows.Foundation.Collections.IVectorView`1<Windows.Networking.Connectivity.LanIdentifier>",
+          L"Windows.Foundation.Collections.IIterable`1<Windows.Networking.Connectivity.LanIdentifier>",
+          L"Windows.Foundation.Collections.IIterator`1<Windows.Networking.Connectivity.LanIdentifier>", FALSE },
+        { &IID_IVectorView_HostName, &IID_IIterable_HostName, &IID_IIterator_HostName,
+          L"Windows.Foundation.Collections.IVectorView`1<Windows.Networking.HostName>",
+          L"Windows.Foundation.Collections.IIterable`1<Windows.Networking.HostName>",
+          L"Windows.Foundation.Collections.IIterator`1<Windows.Networking.HostName>", FALSE },
+    };
+    return &infos[kind];
+}
+
+/* untyped views of the three interfaces */
+typedef struct IGenericVtbl IGenericVtbl;
+typedef struct { const IGenericVtbl *lpVtbl; } IGeneric;
+struct IGenericVtbl
+{
+    HRESULT (WINAPI *QueryInterface)( IGeneric *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( IGeneric *iface );
+    ULONG (WINAPI *Release)( IGeneric *iface );
+    HRESULT (WINAPI *GetIids)( IGeneric *iface, ULONG *count, IID **iids );
+    HRESULT (WINAPI *GetRuntimeClassName)( IGeneric *iface, HSTRING *name );
+    HRESULT (WINAPI *GetTrustLevel)( IGeneric *iface, TrustLevel *level );
+    union
+    {
+        struct { HRESULT (WINAPI *GetAt)( IGeneric *iface, UINT32 index, void **value );
+                 HRESULT (WINAPI *get_Size)( IGeneric *iface, UINT32 *value );
+                 HRESULT (WINAPI *IndexOf)( IGeneric *iface, void *element, UINT32 *index, BOOLEAN *found );
+                 HRESULT (WINAPI *GetMany)( IGeneric *iface, UINT32 start, UINT32 size, void **items, UINT32 *count ); } view;
+        struct { HRESULT (WINAPI *First)( IGeneric *iface, IGeneric **value ); } iterable;
+        struct { HRESULT (WINAPI *get_Current)( IGeneric *iface, void **value );
+                 HRESULT (WINAPI *get_HasCurrent)( IGeneric *iface, boolean *value );
+                 HRESULT (WINAPI *MoveNext)( IGeneric *iface, boolean *value );
+                 HRESULT (WINAPI *GetMany)( IGeneric *iface, UINT32 size, void **items, UINT32 *count ); } iterator;
+    } u;
+};
+
+static HRESULT get_iids( const IID **iids_in, ULONG n, ULONG *count, IID **iids )
+{
+    ULONG i;
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( n * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < n; i++) (*iids)[i] = *iids_in[i];
+    *count = n;
+    return S_OK;
+}
+
+static HRESULT copy_element( const struct kind_info *info, void *src, void **dst )
+{
+    if (info->is_string) return WindowsDuplicateString( src, (HSTRING *)dst );
+    *dst = src;
+    if (src) IUnknown_AddRef( (IUnknown *)src );
+    return S_OK;
+}
+
+static void free_element( const struct kind_info *info, void *element )
+{
+    if (!element) return;
+    if (info->is_string) WindowsDeleteString( element );
+    else IUnknown_Release( (IUnknown *)element );
+}
+
+struct vector_view
+{
+    IGeneric view;
+    IGeneric iterable;
+    LONG ref;
+    const struct kind_info *info;
+    UINT32 size;
+    void *elements[1];
+};
+
+static struct vector_view *view_from_view( IGeneric *iface )
+{
+    return CONTAINING_RECORD( iface, struct vector_view, view );
+}
+
+static struct vector_view *view_from_iterable( IGeneric *iface )
+{
+    return CONTAINING_RECORD( iface, struct vector_view, iterable );
+}
+
+/* IIterator */
+
+struct iterator
+{
+    IGeneric iface;
+    LONG ref;
+    struct vector_view *view;
+    UINT32 index;
+};
+
+static const IGenericVtbl iterator_vtbl;
+static const IGenericVtbl view_vtbl;
+static const IGenericVtbl iterable_vtbl;
+
+static struct iterator *iterator_from( IGeneric *iface )
+{
+    return CONTAINING_RECORD( iface, struct iterator, iface );
+}
+
+static HRESULT WINAPI iterator_QueryInterface( IGeneric *iface, REFIID iid, void **out )
+{
+    struct iterator *impl = iterator_from( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->view->info->iterator_iid ))
+    {
+        *out = iface;
+        IUnknown_AddRef( (IUnknown *)iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI iterator_AddRef( IGeneric *iface )
+{
+    return InterlockedIncrement( &iterator_from( iface )->ref );
+}
+
+static ULONG WINAPI iterator_Release( IGeneric *iface )
+{
+    struct iterator *impl = iterator_from( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IUnknown_Release( (IUnknown *)&impl->view->view );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( IGeneric *iface, ULONG *count, IID **iids )
+{
+    const IID *list[] = { iterator_from( iface )->view->info->iterator_iid };
+    return get_iids( list, 1, count, iids );
+}
+
+static HRESULT WINAPI iterator_GetRuntimeClassName( IGeneric *iface, HSTRING *name )
+{
+    const WCHAR *str = iterator_from( iface )->view->info->iterator_name;
+    if (!name) return E_POINTER;
+    return WindowsCreateString( str, wcslen( str ), name );
+}
+
+static HRESULT WINAPI view_GetTrustLevel( IGeneric *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_get_Current( IGeneric *iface, void **value )
+{
+    struct iterator *impl = iterator_from( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (impl->index >= impl->view->size) return E_BOUNDS;
+    return copy_element( impl->view->info, impl->view->elements[impl->index], value );
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( IGeneric *iface, boolean *value )
+{
+    struct iterator *impl = iterator_from( iface );
+
+    if (!value) return E_POINTER;
+    *value = impl->index < impl->view->size;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( IGeneric *iface, boolean *value )
+{
+    struct iterator *impl = iterator_from( iface );
+
+    if (!value) return E_POINTER;
+    if (impl->index < impl->view->size) impl->index++;
+    *value = impl->index < impl->view->size;
+    return S_OK;
+}
+
+static HRESULT many( struct vector_view *view, UINT32 start, UINT32 size, void **items, UINT32 *count )
+{
+    UINT32 i;
+    HRESULT hr;
+
+    if (!count) return E_POINTER;
+    *count = 0;
+    if (size && !items) return E_POINTER;
+    for (i = start; i < view->size && i - start < size; i++)
+    {
+        if (FAILED(hr = copy_element( view->info, view->elements[i], &items[i - start] )))
+        {
+            while (i-- > start) free_element( view->info, items[i - start] );
+            return hr;
+        }
+    }
+    *count = i > start ? i - start : 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetMany( IGeneric *iface, UINT32 size, void **items, UINT32 *count )
+{
+    struct iterator *impl = iterator_from( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, size %u, items %p, count %p.\n", iface, size, items, count );
+    if (FAILED(hr = many( impl->view, impl->index, size, items, count ))) return hr;
+    impl->index += *count;
+    return S_OK;
+}
+
+static const IGenericVtbl iterator_vtbl =
+{
+    iterator_QueryInterface, iterator_AddRef, iterator_Release,
+    iterator_GetIids, iterator_GetRuntimeClassName, view_GetTrustLevel,
+    { .iterator = { iterator_get_Current, iterator_get_HasCurrent, iterator_MoveNext, iterator_GetMany } },
+};
+
+/* IVectorView */
+
+static HRESULT WINAPI view_QueryInterface( IGeneric *iface, REFIID iid, void **out )
+{
+    struct vector_view *impl = view_from_view( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->info->view_iid ))
+        *out = &impl->view;
+    else if (IsEqualGUID( iid, impl->info->iterable_iid ))
+        *out = &impl->iterable;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI view_AddRef( IGeneric *iface )
+{
+    return InterlockedIncrement( &view_from_view( iface )->ref );
+}
+
+static ULONG WINAPI view_Release( IGeneric *iface )
+{
+    struct vector_view *impl = view_from_view( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT32 i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->size; i++) free_element( impl->info, impl->elements[i] );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI view_GetIids( IGeneric *iface, ULONG *count, IID **iids )
+{
+    struct vector_view *impl = view_from_view( iface );
+    const IID *list[] = { impl->info->view_iid, impl->info->iterable_iid };
+    return get_iids( list, 2, count, iids );
+}
+
+static HRESULT WINAPI view_GetRuntimeClassName( IGeneric *iface, HSTRING *name )
+{
+    const WCHAR *str = view_from_view( iface )->info->view_name;
+    if (!name) return E_POINTER;
+    return WindowsCreateString( str, wcslen( str ), name );
+}
+
+static HRESULT WINAPI view_GetAt( IGeneric *iface, UINT32 index, void **value )
+{
+    struct vector_view *impl = view_from_view( iface );
+
+    TRACE( "iface %p, index %u, value %p.\n", iface, index, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (index >= impl->size) return E_BOUNDS;
+    return copy_element( impl->info, impl->elements[index], value );
+}
+
+static HRESULT WINAPI view_get_Size( IGeneric *iface, UINT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = view_from_view( iface )->size;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_IndexOf( IGeneric *iface, void *element, UINT32 *index, BOOLEAN *found )
+{
+    struct vector_view *impl = view_from_view( iface );
+    UINT32 i;
+
+    TRACE( "iface %p, element %p, index %p, found %p.\n", iface, element, index, found );
+    if (!index || !found) return E_POINTER;
+    for (i = 0; i < impl->size; i++)
+    {
+        if (impl->info->is_string)
+        {
+            INT32 cmp;
+            if (SUCCEEDED(WindowsCompareStringOrdinal( impl->elements[i], element, &cmp )) && !cmp) break;
+        }
+        else if (impl->elements[i] == element) break;
+    }
+    *found = i < impl->size;
+    *index = *found ? i : 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_GetMany( IGeneric *iface, UINT32 start, UINT32 size, void **items, UINT32 *count )
+{
+    struct vector_view *impl = view_from_view( iface );
+
+    TRACE( "iface %p, start %u, size %u, items %p, count %p.\n", iface, start, size, items, count );
+    if (start > impl->size) return E_BOUNDS;
+    return many( impl, start, size, items, count );
+}
+
+static const IGenericVtbl view_vtbl =
+{
+    view_QueryInterface, view_AddRef, view_Release,
+    view_GetIids, view_GetRuntimeClassName, view_GetTrustLevel,
+    { .view = { view_GetAt, view_get_Size, view_IndexOf, view_GetMany } },
+};
+
+/* IIterable */
+
+static HRESULT WINAPI iterable_QueryInterface( IGeneric *iface, REFIID iid, void **out )
+{
+    return view_QueryInterface( &view_from_iterable( iface )->view, iid, out );
+}
+
+static ULONG WINAPI iterable_AddRef( IGeneric *iface )
+{
+    return view_AddRef( &view_from_iterable( iface )->view );
+}
+
+static ULONG WINAPI iterable_Release( IGeneric *iface )
+{
+    return view_Release( &view_from_iterable( iface )->view );
+}
+
+static HRESULT WINAPI iterable_GetIids( IGeneric *iface, ULONG *count, IID **iids )
+{
+    return view_GetIids( &view_from_iterable( iface )->view, count, iids );
+}
+
+static HRESULT WINAPI iterable_GetRuntimeClassName( IGeneric *iface, HSTRING *name )
+{
+    const WCHAR *str = view_from_iterable( iface )->info->iterable_name;
+    if (!name) return E_POINTER;
+    return WindowsCreateString( str, wcslen( str ), name );
+}
+
+static HRESULT WINAPI iterable_First( IGeneric *iface, IGeneric **value )
+{
+    struct vector_view *view = view_from_iterable( iface );
+    struct iterator *iter;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    if (!(iter = calloc( 1, sizeof(*iter) ))) return E_OUTOFMEMORY;
+    iter->iface.lpVtbl = &iterator_vtbl;
+    iter->ref = 1;
+    iter->view = view;
+    InterlockedIncrement( &view->ref );
+    *value = &iter->iface;
+    return S_OK;
+}
+
+static const IGenericVtbl iterable_vtbl =
+{
+    iterable_QueryInterface, iterable_AddRef, iterable_Release,
+    iterable_GetIids, iterable_GetRuntimeClassName, view_GetTrustLevel,
+    { .iterable = { iterable_First } },
+};
+
+HRESULT vector_view_create( enum vector_kind kind, void **elements, UINT32 count, void **out )
+{
+    const struct kind_info *info = kind_info( kind );
+    struct vector_view *impl;
+    UINT32 i;
+
+    if (!(impl = calloc( 1, offsetof( struct vector_view, elements[count ? count : 1] ) )))
+    {
+        for (i = 0; i < count; i++) free_element( info, elements[i] );
+        return E_OUTOFMEMORY;
+    }
+    impl->view.lpVtbl = &view_vtbl;
+    impl->iterable.lpVtbl = &iterable_vtbl;
+    impl->ref = 1;
+    impl->info = info;
+    impl->size = count;
+    if (count) memcpy( impl->elements, elements, count * sizeof(*elements) );
+    *out = &impl->view;
+    return S_OK;
+}
