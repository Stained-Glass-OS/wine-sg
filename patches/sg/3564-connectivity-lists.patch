+/* ---- the host network, as the objects below see it ---- */
+
+struct adapter_info
+{
+    GUID id;
+    NET_LUID luid;
+    DWORD if_index;
+    DWORD if_type;
+    ULONG64 tx_speed, rx_speed;
+    IF_OPER_STATUS oper_status;
+    BOOL has_gateway;
+    SOCKADDR_IN gateway;
+};
+
+static IP_ADAPTER_ADDRESSES *get_adapters( void )
+{
+    ULONG size = 16384, flags = GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER | GAA_FLAG_INCLUDE_GATEWAYS;
+    IP_ADAPTER_ADDRESSES *buf;
+    ULONG err, tries;
+
+    for (tries = 0; tries < 4; tries++)
+    {
+        if (!(buf = malloc( size ))) return NULL;
+        if (!(err = GetAdaptersAddresses( AF_UNSPEC, flags, NULL, buf, &size ))) return buf;
+        free( buf );
+        if (err != ERROR_BUFFER_OVERFLOW) break;
+    }
+    return NULL;
+}
+
+static void fill_adapter_info( const IP_ADAPTER_ADDRESSES *aa, struct adapter_info *info )
+{
+    IP_ADAPTER_GATEWAY_ADDRESS_LH *gw;
+
+    memset( info, 0, sizeof(*info) );
+    ConvertInterfaceLuidToGuid( &aa->Luid, &info->id );
+    info->luid = aa->Luid;
+    info->if_index = aa->IfIndex;
+    info->if_type = aa->IfType;
+    info->tx_speed = aa->TransmitLinkSpeed == ~(ULONG64)0 ? 0 : aa->TransmitLinkSpeed;
+    info->rx_speed = aa->ReceiveLinkSpeed == ~(ULONG64)0 ? 0 : aa->ReceiveLinkSpeed;
+    info->oper_status = aa->OperStatus;
+    for (gw = aa->FirstGatewayAddress; gw; gw = gw->Next)
+        if (gw->Address.lpSockaddr && gw->Address.lpSockaddr->sa_family == AF_INET)
+        {
+            info->gateway = *(SOCKADDR_IN *)gw->Address.lpSockaddr;
+            info->has_gateway = TRUE;
+            break;
+        }
+}
+
+static BOOL find_adapter( const GUID *id, struct adapter_info *info )
+{
+    IP_ADAPTER_ADDRESSES *all, *aa;
+    BOOL found = FALSE;
+    GUID guid;
+
+    if (!(all = get_adapters())) return FALSE;
+    for (aa = all; aa && !found; aa = aa->Next)
+    {
+        if (ConvertInterfaceLuidToGuid( &aa->Luid, &guid ) || !IsEqualGUID( &guid, id )) continue;
+        fill_adapter_info( aa, info );
+        found = TRUE;
+    }
+    free( all );
+    return found;
+}
+
+static NetworkConnectivityLevel connectivity_level( NLM_CONNECTIVITY connectivity )
+{
+    if (connectivity == NLM_CONNECTIVITY_DISCONNECTED) return NetworkConnectivityLevel_None;
+    if (connectivity & ( NLM_CONNECTIVITY_IPV4_INTERNET | NLM_CONNECTIVITY_IPV6_INTERNET ))
+        return NetworkConnectivityLevel_InternetAccess;
+    if (connectivity & ( NLM_CONNECTIVITY_IPV4_LOCALNETWORK | NLM_CONNECTIVITY_IPV6_LOCALNETWORK |
+                         NLM_CONNECTIVITY_IPV4_NOTRAFFIC | NLM_CONNECTIVITY_IPV6_NOTRAFFIC ))
+        return NetworkConnectivityLevel_LocalAccess;
+    return NetworkConnectivityLevel_ConstrainedInternetAccess;
+}
