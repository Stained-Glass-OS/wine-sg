From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Refuse collection arguments for local pipes.

GetNamedPipeHandleState fails with ERROR_INVALID_PARAMETER when it is asked
for the collection count or the collect-data timeout: those exist only for the
client end of a pipe to another machine, and every pipe here is local. It
returned zeros. Removes a todo_wine in the kernel32 pipe test.

Gate: test/kernel32-pipestate-gate.sh (64/32).
---
 dlls/kernel32/tests/pipe.c | 1 -
 dlls/kernelbase/sync.c     | 9 +++++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/dlls/kernel32/tests/pipe.c b/dlls/kernel32/tests/pipe.c
index be40c0f..8eafa46 100644
--- a/dlls/kernel32/tests/pipe.c
+++ b/dlls/kernel32/tests/pipe.c
@@ -2453,7 +2453,6 @@ static void test_NamedPipeHandleState(void)
     SetLastError(0xdeadbeef);
     ret = GetNamedPipeHandleStateA(server, &state, &instances, &maxCollectionCount,
         &collectDataTimeout, userName, ARRAY_SIZE(userName));
-    todo_wine
     ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER,
        "expected ERROR_INVALID_PARAMETER, got %ld\n", GetLastError());
     /* A byte-mode pipe server can't be changed to message mode. */
diff --git a/dlls/kernelbase/sync.c b/dlls/kernelbase/sync.c
index 1dd70d6..ac87c9b 100644
--- a/dlls/kernelbase/sync.c
+++ b/dlls/kernelbase/sync.c
@@ -1721,6 +1721,15 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetNamedPipeHandleStateW( HANDLE pipe, DWORD *stat
 
     FIXME( "%p %p %p %p %p %p %ld: semi-stub\n", pipe, state, instances, max_count, timeout, user, size );
 
+#ifndef SG_MUTANT_PIPE_COLLECTION_ACCEPTED
+    /* the collection count and timeout exist only for the client end of a
+     * pipe to another machine; every pipe here is local */
+    if (max_count || timeout)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+#endif
     if (max_count) *max_count = 0;
     if (timeout) *timeout = 0;
     if (user && size && !GetEnvironmentVariableW( L"WINEUSERNAME", user, size )) user[0] = 0;
