From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:32:32 -0700
Subject: [PATCH] ole32: OLE clipboard advise methods answer
 OLE_E_ADVISENOTSUPPORTED (3259)

The OLE clipboard data object (the snapshot) does not support advisory
notifications. DAdvise, DUnadvise and EnumDAdvise answered E_NOTIMPL; they
now answer OLE_E_ADVISENOTSUPPORTED, the result the documentation gives
for a data object that does not support them (DAdvise sets *conn to 0,
EnumDAdvise sets the enumerator to NULL).

diff --git a/dlls/ole32/clipboard.c b/dlls/ole32/clipboard.c
index c546089..23ef643 100644
--- a/dlls/ole32/clipboard.c
+++ b/dlls/ole32/clipboard.c
@@ -1729,37 +1729,50 @@ end:
 /************************************************************************
  *               snapshot_DAdvise
  *
- * The OLE Clipboard does not implement this method
+ * The OLE Clipboard does not support advisory notifications: a data object
+ * used only for data transfer answers OLE_E_ADVISENOTSUPPORTED (documented
+ * for IDataObject::DAdvise; the value of the native clipboard is a GUESS).
  */
 static HRESULT WINAPI snapshot_DAdvise(IDataObject *iface, FORMATETC *fmt,
                                        DWORD flags, IAdviseSink *sink,
                                        DWORD *conn)
 {
     TRACE("%p, %p, %lx, %p, %p.\n", iface, fmt, flags, sink, conn);
+#ifdef SG_MUTANT_CLIP_ADVISE
     return E_NOTIMPL;
+#endif
+    if (conn) *conn = 0;
+    return OLE_E_ADVISENOTSUPPORTED;
 }
 
 /************************************************************************
  *              snapshot_DUnadvise
  *
- * The OLE Clipboard does not implement this method
+ * No advise connection exists on the OLE Clipboard
  */
 static HRESULT WINAPI snapshot_DUnadvise(IDataObject* iface, DWORD conn)
 {
     TRACE("%p, %ld.\n", iface, conn);
+#ifdef SG_MUTANT_CLIP_ADVISE
     return E_NOTIMPL;
+#endif
+    return OLE_E_ADVISENOTSUPPORTED;
 }
 
 /************************************************************************
  *             snapshot_EnumDAdvise
  *
- * The OLE Clipboard does not implement this method
+ * Advisory notifications are not supported by the OLE Clipboard
  */
 static HRESULT WINAPI snapshot_EnumDAdvise(IDataObject* iface,
                                            IEnumSTATDATA** enum_advise)
 {
-    TRACE("(%p, %p): not implemented\n", iface, enum_advise);
+    TRACE("(%p, %p)\n", iface, enum_advise);
+#ifdef SG_MUTANT_CLIP_ADVISE
     return E_NOTIMPL;
+#endif
+    if (enum_advise) *enum_advise = NULL;
+    return OLE_E_ADVISENOTSUPPORTED;
 }
 
 static const IDataObjectVtbl snapshot_vtable =
