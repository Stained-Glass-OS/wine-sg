From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: OpenGL frames in another process's top-level window stay on screen

Chromium's GPU process presents into the browser's window; on wined3d (no Vulkan) that is OpenGL into another process's top-level. When the window seemed to need offscreen rendering (it has children and something covered part of it), the offscreen window stayed inside the browser's X window and the copies went astray; otherwise the browser's own window surface was flushed over the frames. Such a window now gets the client window in place (as 0586 for Vulkan), its thread is told of the swap chain (6500's WM_WINE_CLIENT_SURFACE), and an empty surface clip region clips everything instead of nothing. Slack 4.52's window is no longer white.
---
diff --git a/dlls/winex11.drv/bitblt.c b/dlls/winex11.drv/bitblt.c
index 4c4a169..bcf491a 100644
--- a/dlls/winex11.drv/bitblt.c
+++ b/dlls/winex11.drv/bitblt.c
@@ -1779,6 +1779,16 @@ static void x11drv_surface_set_clip( struct window_surface *window_surface, cons
 
     TRACE( "surface %p, rects %p, count %u\n", surface, rects, count );
 
+    /* Stained Glass OS (wine-sg 6099): an empty clip region (RECTS but no rectangle) is no
+     * surface at all, not no clipping. A window whose whole client area belongs to a swap chain
+     * -- a pixel format of its own, or another process's (6500) -- with no frame and no child
+     * that paints had an empty region, and its whole surface was then put over the frames each
+     * time it was flushed (Slack's window on wined3d white after a repaint). */
+#ifndef SG_MUTANT_EMPTY_CLIP_PAINTS
+    if (!count && rects)
+        XSetClipRectangles( gdi_display, surface->gc, 0, 0, NULL, 0, YXBanded );
+    else
+#endif
     if (!count)
         XSetClipMask( gdi_display, surface->gc, None );
     else if ((xrects = xrectangles_from_rects( rects, count )))
diff --git a/dlls/winex11.drv/opengl.c b/dlls/winex11.drv/opengl.c
index f084b67..9db6e52 100644
--- a/dlls/winex11.drv/opengl.c
+++ b/dlls/winex11.drv/opengl.c
@@ -234,6 +234,7 @@ struct gl_drawable
     HDC                            hdc_src;
     HDC                            hdc_dst;
     BOOL                           presented;    /* a frame was copied into the top-level (6096) */
+    BOOL                           foreign;      /* another process's window was told of it (6099) */
 };
 
 struct wgl_pbuffer
@@ -961,6 +962,9 @@ static void release_gl_drawable( struct gl_drawable *gl )
     }
     if (gl->hdc_src) NtGdiDeleteObjectApp( gl->hdc_src );
     if (gl->hdc_dst) NtGdiDeleteObjectApp( gl->hdc_dst );
+    if (gl->foreign)
+        NtUserMessageCall( gl->hwnd, WM_WINE_CLIENT_SURFACE, GetCurrentProcessId(), -1, NULL,
+                           NtUserSendNotifyMessage, FALSE );
     free( gl );
 }
 
@@ -1094,6 +1098,27 @@ static GLXContext create_glxcontext(Display *display, struct wgl_context *contex
 /***********************************************************************
  *              create_gl_drawable
  */
+/* Stained Glass OS (wine-sg 6099): another process's top-level window -- Chromium's GPU process
+ * renders into the browser's window. Rendered offscreen (the window has children, or something
+ * covered it when the drawable was made) its frames were to be copied into it, but this process
+ * has no data of that window: the offscreen window stayed inside the browser's X window, over its
+ * client area, and the copies went to the wrong place -- Slack's window was white (or showed what
+ * was under it), on wined3d. As Vulkan does (0586), such a window gets the client window shown
+ * in place; X keeps the frames, and the window's own surface leaves the area to them (below). */
+static BOOL gl_needs_offscreen( HWND hwnd, BOOL known_child )
+{
+    BOOL offscreen = needs_offscreen_rendering( hwnd, known_child );
+#ifndef SG_MUTANT_GL_FOREIGN_OFFSCREEN
+    DWORD pid = 0;
+
+    if (offscreen && NtUserGetAncestor( hwnd, GA_PARENT ) == NtUserGetDesktopWindow() &&
+        NtUserGetDpiForWindow( hwnd ) == NtUserGetWinMonitorDpi( hwnd, MDT_RAW_DPI ) &&
+        NtUserGetWindowThread( hwnd, &pid ) && pid && pid != GetCurrentProcessId())
+        offscreen = FALSE;
+#endif
+    return offscreen;
+}
+
 static struct gl_drawable *create_gl_drawable( HWND hwnd, const struct glx_pixel_format *format, BOOL known_child,
                                                BOOL mutable_pf )
 {
@@ -1121,7 +1146,7 @@ static struct gl_drawable *create_gl_drawable( HWND hwnd, const struct glx_pixel
     gl->rect = rect;
     gl->mutable_pf = mutable_pf;
 
-    if (!needs_offscreen_rendering( hwnd, known_child ))
+    if (!gl_needs_offscreen( hwnd, known_child ))
     {
         gl->type = DC_GL_WINDOW;
         gl->colormap = XCreateColormap( gdi_display, get_dummy_parent(), visual->visual,
@@ -1190,6 +1215,21 @@ static struct gl_drawable *create_gl_drawable( HWND hwnd, const struct glx_pixel
         return NULL;
     }
 
+    /* Stained Glass OS (wine-sg 6099): an OpenGL drawable for another process's window --
+     * Chromium's GPU process presents into the browser's window, through wined3d where there
+     * is no Vulkan. As 6500 does for Vulkan, the window's thread is told, so that its window
+     * surface leaves the area to our frames: Slack's window was white, the browser's own
+     * surface flushed over every frame. */
+#ifndef SG_MUTANT_GL_FOREIGN_PAINTED
+    {
+        DWORD pid = 0;
+        NtUserGetWindowThread( hwnd, &pid );
+        if (pid && pid != GetCurrentProcessId())
+            gl->foreign = NtUserMessageCall( hwnd, WM_WINE_CLIENT_SURFACE, GetCurrentProcessId(), 1, NULL,
+                                             NtUserSendNotifyMessage, FALSE );
+    }
+#endif
+
     pthread_mutex_lock( &context_mutex );
     if (!XFindContext( gdi_display, (XID)hwnd, gl_hwnd_context, (char **)&prev ))
     {
@@ -1319,7 +1359,7 @@ void sync_gl_drawable( HWND hwnd, BOOL known_child )
     case DC_GL_WINDOW:
     case DC_GL_CHILD_WIN:
         is_offscreen = old->type == DC_GL_CHILD_WIN;
-        if (is_offscreen == needs_offscreen_rendering( hwnd, known_child ))
+        if (is_offscreen == gl_needs_offscreen( hwnd, known_child ))
         {
             update_gl_drawable_size( old );
             break;
