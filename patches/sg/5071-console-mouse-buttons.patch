From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Ask the console host for the number of mouse buttons.

GetNumberOfConsoleMouseButtons asks the console host, which answers with the
number of buttons of the mouse (SM_CMOUSEBUTTONS), as conhost does on
Windows; it reported a fixed 2. With no console, or Wine's console without
a host, it fails like the other console calls; a NULL pointer is
ERROR_INVALID_PARAMETER. New condrv ioctl IOCTL_CONDRV_GET_MOUSE_BUTTONS.

Gate: test/kernelbase-consolemouse-gate.sh (on a private X server).
---
 dlls/kernelbase/console.c  | 12 +++++++++---
 include/wine/condrv.h      |  1 +
 programs/conhost/conhost.c | 15 +++++++++++++++
 3 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/dlls/kernelbase/console.c b/dlls/kernelbase/console.c
index 7a4e566..8c5e61a 100644
--- a/dlls/kernelbase/console.c
+++ b/dlls/kernelbase/console.c
@@ -1344,9 +1344,15 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetNumberOfConsoleInputEvents( HANDLE handle, DWOR
  */
 BOOL WINAPI GetNumberOfConsoleMouseButtons( DWORD *count )
 {
-    FIXME( "(%p): stub\n", count );
-    *count = 2;
-    return TRUE;
+    TRACE( "(%p)\n", count );
+
+    if (!count)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return console_ioctl( RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle, IOCTL_CONDRV_GET_MOUSE_BUTTONS,
+                          NULL, 0, count, sizeof(*count), NULL );
 }
 
 
diff --git a/include/wine/condrv.h b/include/wine/condrv.h
index 72e9262..4030a4e 100644
--- a/include/wine/condrv.h
+++ b/include/wine/condrv.h
@@ -46,6 +46,7 @@
 #define IOCTL_CONDRV_GET_PROCESS_LIST      CTL_CODE(FILE_DEVICE_CONSOLE, 23, METHOD_BUFFERED, FILE_ANY_ACCESS)
 #define IOCTL_CONDRV_READ_CONSOLE_CONTROL  CTL_CODE(FILE_DEVICE_CONSOLE, 24, METHOD_BUFFERED, FILE_READ_ACCESS)
 #define IOCTL_CONDRV_GET_INPUT_COUNT       CTL_CODE(FILE_DEVICE_CONSOLE, 25, METHOD_BUFFERED, FILE_READ_ACCESS)
+#define IOCTL_CONDRV_GET_MOUSE_BUTTONS     CTL_CODE(FILE_DEVICE_CONSOLE, 26, METHOD_BUFFERED, FILE_ANY_ACCESS)
 
 /* console output ioctls */
 #define IOCTL_CONDRV_WRITE_CONSOLE         CTL_CODE(FILE_DEVICE_CONSOLE, 30, METHOD_BUFFERED, FILE_WRITE_ACCESS)
diff --git a/programs/conhost/conhost.c b/programs/conhost/conhost.c
index 18fa8ed..f0798d3 100644
--- a/programs/conhost/conhost.c
+++ b/programs/conhost/conhost.c
@@ -3517,6 +3517,21 @@ static NTSTATUS console_input_ioctl( struct console *console, unsigned int code,
             return STATUS_SUCCESS;
         }
 
+    case IOCTL_CONDRV_GET_MOUSE_BUTTONS:
+        {
+            DWORD *count;
+            TRACE( "get mouse buttons\n" );
+            if (in_size || *out_size != sizeof(*count)) return STATUS_INVALID_PARAMETER;
+            if (!(count = alloc_ioctl_buffer( sizeof(*count )))) return STATUS_NO_MEMORY;
+            /* the buttons of the mouse the console's window gets, as conhost answers on Windows */
+#ifndef SG_MUTANT_MOUSE_BUTTONS_FIXED
+            *count = GetSystemMetrics( SM_CMOUSEBUTTONS );
+#else
+            *count = 2;
+#endif
+            return STATUS_SUCCESS;
+        }
+
     case IOCTL_CONDRV_GET_WINDOW:
         {
             condrv_handle_t *result;
