+/* Stained Glass OS: the netsh commands scripts use to change the network,
+ * through sg-netctl (NetworkManager):
+ *
+ *   interface ip|ipv4 set address [name=]NAME [source=]dhcp|static [addr [mask [gateway [metric]]]]
+ *   interface ip|ipv4 set dns|dnsservers [name=]NAME [source=]dhcp|static [addr] [register=...]
+ *   interface ip|ipv4 add dns|dnsservers [name=]NAME [addr=]ADDR [index=N]
+ *   interface ip|ipv4 show config|address|dns [[name=]NAME]
+ *   interface show interface
+ *   wlan show networks | show profiles | connect name=PROFILE [ssid=SSID] | disconnect
+ *
+ * Adapter names are the ones ipconfig and these show. Anything else is
+ * accepted and ignored, as before, so installers that configure a firewall
+ * do not fail. */
+
+#include <stdio.h>
+#include <windows.h>
 #include "wine/debug.h"
+#include "wine/sgnetctl.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(netsh);
 
-int __cdecl wmain(int argc, WCHAR *argv[])
+/* ---- parameters ------------------------------------------------------- */
+
+struct params { const WCHAR *names[8]; const WCHAR *values[8]; int count; };
+
+/* named (key=value) arguments go to their slot, the rest fill the others in order */
+static void parse_params( int argc, WCHAR **argv, const WCHAR *const *slots, int nslots, struct params *p )
+{
+    int i, j;
+    memset( p, 0, sizeof(*p) );
+    p->count = nslots;
+    for (i = 0; i < nslots; i++) p->names[i] = slots[i];
+    for (i = 0; i < argc; i++)
+    {
+        WCHAR *eq = wcschr( argv[i], '=' );
+        if (eq)
+        {
+            size_t kl = eq - argv[i];
+            for (j = 0; j < nslots; j++)
+                if (wcslen( slots[j] ) == kl && !wcsnicmp( argv[i], slots[j], kl )) break;
+            if (j == nslots)
+            {
+                /* aliases */
+                if (kl == 4 && !wcsnicmp( argv[i], L"addr", 4 )) j = 2;
+                else if (kl == 9 && !wcsnicmp( argv[i], L"interface", 9 )) j = 0;
+                else continue;
+            }
+            p->values[j] = eq + 1;
+        }
+        else
+        {
+            for (j = 0; j < nslots; j++) if (!p->values[j]) break;
+            if (j < nslots) p->values[j] = argv[i];
+        }
+    }
+}
+
+static const WCHAR *param( const struct params *p, int i )
+{
+    return i < p->count ? p->values[i] : NULL;
+}
+
+/* a dotted mask as a prefix length; -1 when it is not one */
+static int mask_to_prefix( const WCHAR *mask )
+{
+    unsigned int a, b, c, d, m;
+    int n = 0;
+    if (swscanf( mask, L"%u.%u.%u.%u", &a, &b, &c, &d ) != 4 || a > 255 || b > 255 || c > 255 || d > 255) return -1;
+    m = (a << 24) | (b << 16) | (c << 8) | d;
+    while (m & 0x80000000) { n++; m <<= 1; }
+    return m ? -1 : n;
+}
+
+/* ---- answers -------------------------------------------------------------- */
+
+static int report( const struct sgnet_reply *r )
 {
+    if (r->ok) return 0;
+    if (!wcscmp( r->kind, L"denied" ))
+        wprintf( L"The requested operation requires elevation (Run as administrator).\n\n" );
+    else if (!wcscmp( r->kind, L"notfound" ))
+        wprintf( L"The filename, directory name, or volume label syntax is incorrect.\n\n" );
+    else
+        wprintf( L"%ls\n\n", r->message[0] ? r->message : L"The operation failed." );
+    return 1;
+}
+
+static int request( struct sgnet_reply *r, int argc, const WCHAR **argv )
+{
+    int ret = sgnet_request( argv, argc, r );
+    if (ret < 0)
+    {
+        wprintf( L"The network settings service is not available on this system.\n\n" );
+        return -1;
+    }
+    return ret;
+}
+
+static void dns_list( const struct sgnet_reply *adapters, int at, WCHAR *out, size_t len )
+{
+    const WCHAR *dns;
     int i;
+    out[0] = 0;
+    for (i = 0; (dns = sgnet_field( adapters, at, L"IPV4-DNS", i )); i++)
+    {
+        if (i) wcsncat( out, L",", len - wcslen( out ) - 1 );
+        wcsncat( out, dns, len - wcslen( out ) - 1 );
+    }
+}
+
+/* ---- interface ip ------------------------------------------------------ */
+
+static int set_address( int argc, WCHAR **argv )
+{
+    static const WCHAR *const slots[] = { L"name", L"source", L"address", L"mask", L"gateway", L"gwmetric" };
+    struct sgnet_reply adapters, r;
+    struct params p;
+    const WCHAR *name, *source, *args[8];
+    WCHAR cidr[64], dns[256];
+    int n = 0, at, prefix, ret;
+
+    parse_params( argc, argv, slots, ARRAY_SIZE(slots), &p );
+    name = param( &p, 0 );
+    source = param( &p, 1 );
+    if (!name || !source) { wprintf( L"The syntax supplied for this command is not valid. Check help for the correct syntax.\n\n" ); return 1; }
+
+    if (!wcsicmp( source, L"dhcp" ))
+    {
+        args[n++] = L"ipv4"; args[n++] = name; args[n++] = L"dhcp";
+    }
+    else if (!wcsicmp( source, L"static" ))
+    {
+        if (!param( &p, 2 ) || !param( &p, 3 ) || (prefix = mask_to_prefix( param( &p, 3 ) )) < 0)
+        {
+            wprintf( L"The syntax supplied for this command is not valid. Check help for the correct syntax.\n\n" );
+            return 1;
+        }
+        /* a fixed address keeps the DNS servers the adapter has, as on Windows */
+        if ((ret = request( &adapters, 1, (const WCHAR *[]){ L"adapters" } )) < 0) return 1;
+        if (!ret) { ret = report( &adapters ); sgnet_free( &adapters ); return ret; }
+        if ((at = sgnet_adapter( &adapters, name )) < 0)
+        {
+            sgnet_free( &adapters );
+            wprintf( L"The filename, directory name, or volume label syntax is incorrect.\n\n" );
+            return 1;
+        }
+        dns_list( &adapters, at, dns, ARRAY_SIZE(dns) );
+        sgnet_free( &adapters );
+        swprintf( cidr, ARRAY_SIZE(cidr), L"%ls/%d", param( &p, 2 ), prefix );
+        args[n++] = L"ipv4"; args[n++] = name; args[n++] = L"static"; args[n++] = cidr;
+        if (param( &p, 4 ) && wcsicmp( param( &p, 4 ), L"none" )) { args[n++] = L"--gateway"; args[n++] = param( &p, 4 ); }
+        if (dns[0]) { args[n++] = L"--dns"; args[n++] = dns; }
+    }
+    else { wprintf( L"The syntax supplied for this command is not valid. Check help for the correct syntax.\n\n" ); return 1; }
+
+    if ((ret = request( &r, n, args )) < 0) return 1;
+    ret = report( &r );
+    sgnet_free( &r );
+    return ret;
+}
+
+static int set_dns( int argc, WCHAR **argv, BOOL add )
+{
+    static const WCHAR *const set_slots[] = { L"name", L"source", L"address", L"register", L"validate" };
+    static const WCHAR *const add_slots[] = { L"name", L"address", L"index", L"validate" };
+    struct sgnet_reply adapters, r;
+    struct params p;
+    const WCHAR *name, *args[4];
+    WCHAR dns[256], list[3][64], *tok, *ctx;
+    int at, count = 0, index, i, ret;
+
+    if (!add)
+    {
+        parse_params( argc, argv, set_slots, ARRAY_SIZE(set_slots), &p );
+        name = param( &p, 0 );
+        if (!name || !param( &p, 1 )) { wprintf( L"The syntax supplied for this command is not valid. Check help for the correct syntax.\n\n" ); return 1; }
+        args[0] = L"dns"; args[1] = name;
+        if (!wcsicmp( param( &p, 1 ), L"dhcp" )) args[2] = L"auto";
+        else if (!wcsicmp( param( &p, 1 ), L"static" ) && param( &p, 2 ) && wcsicmp( param( &p, 2 ), L"none" )) args[2] = param( &p, 2 );
+        else { wprintf( L"The syntax supplied for this command is not valid. Check help for the correct syntax.\n\n" ); return 1; }
+    }
+    else
+    {
+        parse_params( argc, argv, add_slots, ARRAY_SIZE(add_slots), &p );
+        name = param( &p, 0 );
+        if (!name || !param( &p, 1 )) { wprintf( L"The syntax supplied for this command is not valid. Check help for the correct syntax.\n\n" ); return 1; }
+        if ((ret = request( &adapters, 1, (const WCHAR *[]){ L"adapters" } )) < 0) return 1;
+        if (!ret) { ret = report( &adapters ); sgnet_free( &adapters ); return ret; }
+        if ((at = sgnet_adapter( &adapters, name )) < 0)
+        {
+            sgnet_free( &adapters );
+            wprintf( L"The filename, directory name, or volume label syntax is incorrect.\n\n" );
+            return 1;
+        }
+        dns_list( &adapters, at, dns, ARRAY_SIZE(dns) );
+        sgnet_free( &adapters );
+        for (tok = wcstok( dns, L",", &ctx ); tok && count < 3; tok = wcstok( NULL, L",", &ctx ))
+            if (wcsicmp( tok, param( &p, 1 ) )) lstrcpynW( list[count++], tok, 64 );
+        index = param( &p, 2 ) ? _wtoi( param( &p, 2 ) ) - 1 : count;
+        if (index < 0) index = 0;
+        if (index > count) index = count;
+        if (count == 3) count = 2;  /* three at most: the last one gives way */
+        for (i = count; i > index; i--) lstrcpyW( list[i], list[i - 1] );
+        lstrcpynW( list[index], param( &p, 1 ), 64 );
+        count++;
+        dns[0] = 0;
+        for (i = 0; i < count; i++) { if (i) wcscat( dns, L"," ); wcscat( dns, list[i] ); }
+        args[0] = L"dns"; args[1] = name; args[2] = dns;
+    }
+    if ((ret = request( &r, 3, args )) < 0) return 1;
+    ret = report( &r );
+    sgnet_free( &r );
+    return ret;
+}
+
+static void show_prefix( const WCHAR *cidr, WCHAR *addr, WCHAR *line, size_t len )
+{
+    const WCHAR *slash = wcschr( cidr, '/' );
+    int prefix = slash ? _wtoi( slash + 1 ) : 32;
+    unsigned int m = prefix ? 0xffffffffu << (32 - prefix) : 0, a, b, c, d, ip;
+
+    lstrcpynW( addr, cidr, slash ? (int)(slash - cidr) + 1 : 64 );
+    if (swscanf( addr, L"%u.%u.%u.%u", &a, &b, &c, &d ) != 4) { line[0] = 0; return; }
+    ip = ((a << 24) | (b << 16) | (c << 8) | d) & m;
+    swprintf( line, len, L"%u.%u.%u.%u/%d (mask %u.%u.%u.%u)", ip >> 24, (ip >> 16) & 255, (ip >> 8) & 255, ip & 255,
+              prefix, m >> 24, (m >> 16) & 255, (m >> 8) & 255, m & 255 );
+}
+
+static int show_config( int argc, WCHAR **argv )
+{
+    struct sgnet_reply r;
+    const WCHAR *filter = NULL, *v, *type;
+    WCHAR addr[64], line[128];
+    int i, k, ret;
+
+    if (argc > 0) filter = wcschr( argv[0], '=' ) ? wcschr( argv[0], '=' ) + 1 : argv[0];
+    if ((ret = request( &r, 1, (const WCHAR *[]){ L"adapters" } )) < 0) return 1;
+    if (!ret) { ret = report( &r ); sgnet_free( &r ); return ret; }
+    wprintf( L"\n" );
+    for (i = 0; i < r.count; i++)
+    {
+        BOOL dhcp, dns_auto;
+        if (wcsncmp( r.lines[i], L"ADAPTER ", 8 )) continue;
+        if (filter && wcsicmp( r.lines[i] + 8, filter )) continue;
+        type = sgnet_field( &r, i, L"TYPE", 0 );
+        if (!type || (wcscmp( type, L"ethernet" ) && wcscmp( type, L"wifi" ))) continue;
+        dhcp = (v = sgnet_field( &r, i, L"IPV4-METHOD", 0 )) && !wcscmp( v, L"auto" );
+        dns_auto = !(v = sgnet_field( &r, i, L"IPV4-DNS-AUTO", 0 )) || !wcscmp( v, L"yes" );
+        wprintf( L"Configuration for interface \"%ls\"\n", r.lines[i] + 8 );
+        wprintf( L"    DHCP enabled:                         %ls\n", dhcp ? L"Yes" : L"No" );
+        for (k = 0; (v = sgnet_field( &r, i, L"IPV4-ADDRESS", k )); k++)
+        {
+            show_prefix( v, addr, line, ARRAY_SIZE(line) );
+            wprintf( L"    IP Address:                           %ls\n", addr );
+            wprintf( L"    Subnet Prefix:                        %ls\n", line );
+        }
+        if ((v = sgnet_field( &r, i, L"IPV4-GATEWAY", 0 )))
+            wprintf( L"    Default Gateway:                      %ls\n", v );
+        wprintf( L"    %-38ls", dns_auto && dhcp ? L"DNS servers configured through DHCP:" : L"Statically Configured DNS Servers:" );
+        if (!(v = sgnet_field( &r, i, L"IPV4-DNS", 0 ))) wprintf( L"None\n" );
+        else for (k = 0; (v = sgnet_field( &r, i, L"IPV4-DNS", k )); k++)
+            wprintf( k ? L"                                          %ls\n" : L"%ls\n", v );
+        wprintf( L"    Register with which suffix:           Primary only\n\n" );
+    }
+    sgnet_free( &r );
+    return 0;
+}
+
+static int show_interfaces(void)
+{
+    struct sgnet_reply r;
+    const WCHAR *state;
+    int i, ret;
+
+    if ((ret = request( &r, 1, (const WCHAR *[]){ L"adapters" } )) < 0) return 1;
+    if (!ret) { ret = report( &r ); sgnet_free( &r ); return ret; }
+    wprintf( L"\nAdmin State    State          Type             Interface Name\n" );
+    wprintf( L"-------------------------------------------------------------------------\n" );
+    for (i = 0; i < r.count; i++)
+    {
+        if (wcsncmp( r.lines[i], L"ADAPTER ", 8 )) continue;
+        state = sgnet_field( &r, i, L"STATE", 0 );
+        wprintf( L"%-15ls%-15ls%-17ls%ls\n",
+                 state && !wcscmp( state, L"unavailable" ) ? L"Disabled" : L"Enabled",
+                 state && !wcscmp( state, L"connected" ) ? L"Connected" : L"Disconnected",
+                 L"Dedicated", r.lines[i] + 8 );
+    }
+    wprintf( L"\n" );
+    sgnet_free( &r );
+    return 0;
+}
+
+/* ---- wlan ------------------------------------------------------------- */
+
+static const WCHAR *auth_name( const WCHAR *security )
+{
+    if (!wcscmp( security, L"open" )) return L"Open";
+    if (!wcscmp( security, L"sae" )) return L"WPA3-Personal";
+    if (!wcscmp( security, L"enterprise" )) return L"WPA2-Enterprise";
+    if (!wcscmp( security, L"wep" )) return L"Shared";
+    return L"WPA2-Personal";
+}
+
+/* field n of a tab-separated line, copied */
+static void tab_field( const WCHAR *line, int n, WCHAR *out, size_t len )
+{
+    const WCHAR *end;
+    while (n-- && (line = wcschr( line, '\t' ))) line++;
+    if (!line) { out[0] = 0; return; }
+    end = wcschr( line, '\t' );
+    lstrcpynW( out, line, min( len, end ? (size_t)(end - line) + 1 : len ) );
+}
+
+static int wlan( int argc, WCHAR **argv )
+{
+    struct sgnet_reply r;
+    WCHAR f[5][256];
+    int i, n = 0, ret;
+
+    if (argc >= 2 && !wcsicmp( argv[0], L"show" ) && !wcsicmp( argv[1], L"networks" ))
+    {
+        if ((ret = request( &r, 2, (const WCHAR *[]){ L"wifi", L"scan" } )) < 0) return 1;
+        if (!ret) { ret = report( &r ); sgnet_free( &r ); return ret; }
+        for (i = 0; i < r.count; i++) if (!wcsncmp( r.lines[i], L"WIFI ", 5 )) n++;
+        wprintf( L"\nInterface name : Wi-Fi\nThere are %d networks currently visible.\n\n", n );
+        for (i = 0, n = 0; i < r.count; i++)
+        {
+            if (wcsncmp( r.lines[i], L"WIFI ", 5 )) continue;
+            tab_field( r.lines[i] + 5, 1, f[1], 256 );
+            tab_field( r.lines[i] + 5, 5, f[4], 256 );
+            wprintf( L"SSID %d : %ls\n    Network type            : Infrastructure\n"
+                     L"    Authentication          : %ls\n    Encryption              : %ls\n\n",
+                     ++n, f[4], auth_name( f[1] ), !wcscmp( f[1], L"open" ) ? L"None" : L"CCMP" );
+        }
+        sgnet_free( &r );
+        return 0;
+    }
+    if (argc >= 2 && !wcsicmp( argv[0], L"show" ) && !wcsicmp( argv[1], L"profiles" ))
+    {
+        if ((ret = request( &r, 2, (const WCHAR *[]){ L"wifi", L"saved" } )) < 0) return 1;
+        if (!ret) { ret = report( &r ); sgnet_free( &r ); return ret; }
+        wprintf( L"\nProfiles on interface Wi-Fi:\n\nUser profiles\n-------------\n" );
+        for (i = 0; i < r.count; i++)
+        {
+            if (wcsncmp( r.lines[i], L"SAVED ", 6 )) continue;
+            tab_field( r.lines[i] + 6, 3, f[3], 256 );
+            wprintf( L"    All User Profile     : %ls\n", f[3] );
+        }
+        wprintf( L"\n" );
+        sgnet_free( &r );
+        return 0;
+    }
+    if (argc >= 1 && !wcsicmp( argv[0], L"connect" ))
+    {
+        static const WCHAR *const slots[] = { L"name", L"ssid", L"interface" };
+        struct params p;
+        const WCHAR *args[6];
+
+        parse_params( argc - 1, argv + 1, slots, ARRAY_SIZE(slots), &p );
+        if (!param( &p, 0 )) { wprintf( L"The syntax supplied for this command is not valid. Check help for the correct syntax.\n\n" ); return 1; }
+        args[n++] = L"wifi"; args[n++] = L"connect"; args[n++] = L"--ssid"; args[n++] = param( &p, 1 ) ? param( &p, 1 ) : param( &p, 0 );
+        if ((ret = request( &r, n, args )) < 0) return 1;
+        if (ret) wprintf( L"Connection request was completed successfully.\n" );
+        else if (!wcscmp( r.kind, L"notfound" ) || !wcscmp( r.kind, L"auth" ))
+            wprintf( L"There is no profile \"%ls\" assigned to the specified interface.\n", param( &p, 0 ) );
+        else report( &r );
+        sgnet_free( &r );
+        return ret ? 0 : 1;
+    }
+    if (argc >= 1 && !wcsicmp( argv[0], L"disconnect" ))
+    {
+        if ((ret = request( &r, 2, (const WCHAR *[]){ L"wifi", L"disconnect" } )) < 0) return 1;
+        if (ret) wprintf( L"Disconnection request was completed successfully for interface \"Wi-Fi\".\n" );
+        else report( &r );
+        sgnet_free( &r );
+        return ret ? 0 : 1;
+    }
+    return -1;
+}
