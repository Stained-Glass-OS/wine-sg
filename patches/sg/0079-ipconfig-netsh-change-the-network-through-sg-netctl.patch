+/* ---- the command line ---------------------------------------------------- */
+
+static BOOL is( const WCHAR *arg, const WCHAR *word ) { return arg && !wcsicmp( arg, word ); }
+
+static int dispatch( int argc, WCHAR **argv )
+{
+    if (argc >= 1 && (is( argv[0], L"interface" ) || is( argv[0], L"int" )))
+    {
+        if (argc >= 3 && is( argv[1], L"show" ) && is( argv[2], L"interface" )) return show_interfaces();
+        if (argc >= 3 && (is( argv[1], L"ip" ) || is( argv[1], L"ipv4" )))
+        {
+            if (argc >= 4 && is( argv[2], L"set" ) && (is( argv[3], L"address" ) || is( argv[3], L"addr" )))
+                return set_address( argc - 4, argv + 4 );
+            if (argc >= 4 && is( argv[2], L"set" ) && (is( argv[3], L"dns" ) || is( argv[3], L"dnsservers" ) || is( argv[3], L"dnsserver" )))
+                return set_dns( argc - 4, argv + 4, FALSE );
+            if (argc >= 4 && is( argv[2], L"add" ) && (is( argv[3], L"dns" ) || is( argv[3], L"dnsservers" ) || is( argv[3], L"dnsserver" )))
+                return set_dns( argc - 4, argv + 4, TRUE );
+            if (argc >= 4 && is( argv[2], L"show" ) && (is( argv[3], L"config" ) || is( argv[3], L"address" ) ||
+                                                        is( argv[3], L"addresses" ) || is( argv[3], L"dns" ) || is( argv[3], L"dnsservers" )))
+                return show_config( argc - 4, argv + 4 );
+        }
+    }
+    if (argc >= 1 && is( argv[0], L"wlan" )) return wlan( argc - 1, argv + 1 );
+    return -1;
+}
