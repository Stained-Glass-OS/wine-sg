+#ifndef __WINE_SGNETCTL_H
+#define __WINE_SGNETCTL_H
+
+#include <stdlib.h>
+#include <string.h>
+
+#define SGNET_MAX_LINES 1024
+
+struct sgnet_reply
+{
+    int    ok;                       /* 1 OK, 0 ERROR */
+    WCHAR  kind[32];                 /* denied, invalid, notfound, auth, unsupported, failed */
+    WCHAR  message[512];
+    int    count;
+    WCHAR *lines[SGNET_MAX_LINES];   /* the answer before its last line */
+};
+
+/* sg-netctl, or the native program SG_NETCTL names (a Unix path; for tests) */
+static inline const WCHAR *sgnet_netctl_path(void)
+{
+    static WCHAR path[MAX_PATH];
+    WCHAR unix_path[MAX_PATH - 8];
+
+    if (!path[0])
+    {
+        if (GetEnvironmentVariableW( L"SG_NETCTL", unix_path, ARRAY_SIZE(unix_path) ) && unix_path[0] == '/')
+        {
+            WCHAR *p;
+            swprintf( path, ARRAY_SIZE(path), L"\\\\?\\unix%ls", unix_path );
+            for (p = path + 8; *p; p++) if (*p == '/') *p = '\\';
+        }
+        else wcscpy( path, L"\\\\?\\unix\\usr\\bin\\sg-netctl" );
+    }
+    return path;
+}
+
+static inline void sgnet_free( struct sgnet_reply *r )
+{
+    int i;
+    for (i = 0; i < r->count; i++) free( r->lines[i] );
+    r->count = 0;
+}
+
+/* append an argument, quoted as the C runtime splits a command line */
+static inline void sgnet_quote( WCHAR *cmd, size_t len, const WCHAR *arg )
+{
+    size_t n = wcslen( cmd );
+    int slashes = 0;
+
+    if (n + 4 >= len) return;
+    if (n) cmd[n++] = ' ';
+    cmd[n++] = '"';
+    for (; *arg && n + 4 < len; arg++)
+    {
+        if (*arg == '\\') { slashes++; cmd[n++] = '\\'; continue; }
+        if (*arg == '"')
+        {
+            while (slashes-- >= 0 && n + 2 < len) cmd[n++] = '\\';
+        }
+        slashes = 0;
+        cmd[n++] = *arg;
+    }
+    while (slashes-- > 0 && n + 2 < len) cmd[n++] = '\\';
+    cmd[n++] = '"';
+    cmd[n] = 0;
+}
+
+/* A temporary file: in %TEMP%, made if it is not there yet (an account
+ * that has not signed in has no profile), else in the Unix /tmp. */
+static inline BOOL sgnet_temp_file( WCHAR *dir, WCHAR *name )
+{
+    WCHAR *p;
+
+    if (GetTempPathW( MAX_PATH, dir ))
+    {
+        if (GetTempFileNameW( dir, L"sgn", 0, name )) return TRUE;
+        for (p = dir + 3; *p; p++)
+        {
+            if (*p != '\\') continue;
+            *p = 0;
+            CreateDirectoryW( dir, NULL );
+            *p = '\\';
+        }
+        if (GetTempFileNameW( dir, L"sgn", 0, name )) return TRUE;
+    }
+    wcscpy( dir, L"\\\\?\\unix\\tmp\\" );
+    return GetTempFileNameW( dir, L"sgn", 0, name );
+}
+
+#define SGNET_EXIT   L"SGNET-EXIT:"
+#define SGNET_EXIT_A "SGNET-EXIT:"
+static const WCHAR sgnet_shell[] = L"\\\\?\\unix\\bin\\sh";
+
+/* Run a native program (path: its \\?\unix\ name); its standard output and
+ * error, as text, in *out (malloc'd, NUL-terminated UTF-8), and its exit
+ * code. FALSE: not run, or no answer within timeout ms. */
+static inline BOOL sgnet_run_native( const WCHAR *path, const WCHAR *const *argv, int argc,
+                                     char **out, DWORD *exit_code, DWORD timeout )
+{
+    WCHAR unix_path[MAX_PATH], *p;
+    SECURITY_ATTRIBUTES sa = { sizeof(sa), NULL, TRUE };
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR tmp[MAX_PATH], name[MAX_PATH], cmd[8192] = L"";
+    HANDLE file;
+    DWORD size, got;
+    BOOL ret = FALSE;
+    int i;
+
+    *out = NULL;
+    *exit_code = 1;
+    if (GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES) return FALSE;
+    if (wcsncmp( path, L"\\\\?\\unix\\", 9 )) return FALSE;
+    lstrcpynW( unix_path, path + 8, ARRAY_SIZE(unix_path) );
+    for (p = unix_path; *p; p++) if (*p == '\\') *p = '/';
+    if (!sgnet_temp_file( tmp, name )) return FALSE;
+    file = CreateFileW( name, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa,
+                        CREATE_ALWAYS, FILE_ATTRIBUTE_TEMPORARY | FILE_FLAG_DELETE_ON_CLOSE, NULL );
+    if (file == INVALID_HANDLE_VALUE) { DeleteFileW( name ); return FALSE; }
+
+    /* A native program's process handle does not wait for it: run it under
+     * a fixed shell that writes its exit status last, and wait for that. The
+     * program and its arguments are the shell's positional parameters, never
+     * part of the script. */
+    sgnet_quote( cmd, ARRAY_SIZE(cmd), sgnet_shell );
+    sgnet_quote( cmd, ARRAY_SIZE(cmd), L"-c" );
+    sgnet_quote( cmd, ARRAY_SIZE(cmd), L"\"$@\"; echo \"" SGNET_EXIT "$?\"" );
+    sgnet_quote( cmd, ARRAY_SIZE(cmd), L"sh" );
+    sgnet_quote( cmd, ARRAY_SIZE(cmd), unix_path );
+    for (i = 0; i < argc; i++) sgnet_quote( cmd, ARRAY_SIZE(cmd), argv[i] );
+    si.dwFlags = STARTF_USESTDHANDLES;
+    si.hStdInput = NULL;
+    si.hStdOutput = si.hStdError = file;
+    if (CreateProcessW( sgnet_shell, cmd, NULL, NULL, TRUE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi ))
+    {
+        DWORD start = GetTickCount();
+        CloseHandle( pi.hThread );
+        CloseHandle( pi.hProcess );
+        while (GetTickCount() - start < timeout)
+        {
+            char *mark;
+            size = GetFileSize( file, NULL );
+            if (size != INVALID_FILE_SIZE && size && (*out = malloc( size + 1 )))
+            {
+                SetFilePointer( file, 0, NULL, FILE_BEGIN );
+                if (!ReadFile( file, *out, size, &got, NULL )) got = 0;
+                (*out)[got] = 0;
+                if ((mark = strstr( *out, SGNET_EXIT_A )) && strchr( mark, '\n' ))
+                {
+                    *exit_code = atoi( mark + strlen( SGNET_EXIT_A ) );
+                    *mark = 0;
+                    ret = TRUE;
+                    break;
+                }
+                free( *out );
+                *out = NULL;
+            }
+            Sleep( 20 );
+        }
+    }
+    CloseHandle( file );
+    return ret;
+}
+
+/* sg-netctl ARGS; -1 when it is not there (a plain Wine), else 1 OK / 0 ERROR */
+static inline int sgnet_request( const WCHAR *const *argv, int argc, struct sgnet_reply *r )
+{
+    char *text, *line, *next;
+    DWORD code;
+    WCHAR *w;
+    int len;
+
+    memset( r, 0, sizeof(*r) );
+    if (GetFileAttributesW( sgnet_netctl_path() ) == INVALID_FILE_ATTRIBUTES) return -1;
+    if (!sgnet_run_native( sgnet_netctl_path(), argv, argc, &text, &code, 120000 ))
+    {
+        wcscpy( r->kind, L"failed" );
+        wcscpy( r->message, L"the network settings service did not answer" );
+        return 0;
+    }
+    for (line = text; line && *line; line = next)
+    {
+        if ((next = strchr( line, '\n' ))) *next++ = 0;
+        len = MultiByteToWideChar( CP_UTF8, 0, line, -1, NULL, 0 );
+        if (!(w = malloc( len * sizeof(WCHAR) ))) break;
+        MultiByteToWideChar( CP_UTF8, 0, line, -1, w, len );
+        if (!wcscmp( w, L"OK" )) { r->ok = 1; free( w ); break; }
+        if (!wcsncmp( w, L"ERROR ", 6 ))
+        {
+            WCHAR *sp = wcschr( w + 6, ' ' );
+            if (sp) { *sp = 0; lstrcpynW( r->message, sp + 1, ARRAY_SIZE(r->message) ); }
+            lstrcpynW( r->kind, w + 6, ARRAY_SIZE(r->kind) );
+            free( w );
+            break;
+        }
+        if (r->count < SGNET_MAX_LINES) r->lines[r->count++] = w;
+        else free( w );
+    }
+    if (!r->ok && !r->kind[0])
+    {
+        wcscpy( r->kind, L"failed" );
+        wcscpy( r->message, L"the network settings service gave no answer" );
+    }
+    free( text );
+    return r->ok;
+}
+
+/* the value after "KEY " in an adapter's block (from line `from` to its END); the n-th */
+static inline const WCHAR *sgnet_field( const struct sgnet_reply *r, int from, const WCHAR *key, int n )
+{
+    size_t kl = wcslen( key );
+    int i;
+    for (i = from; i < r->count; i++)
+    {
+        if (i > from && !wcscmp( r->lines[i], L"END" )) break;
+        if (!wcsncmp( r->lines[i], key, kl ) && r->lines[i][kl] == ' ' && n-- == 0) return r->lines[i] + kl + 1;
+    }
+    return NULL;
+}
+
+/* the line at which an adapter's block starts, or -1 */
+static inline int sgnet_adapter( const struct sgnet_reply *r, const WCHAR *name )
+{
+    int i;
+    for (i = 0; i < r->count; i++)
+        if (!wcsncmp( r->lines[i], L"ADAPTER ", 8 ) && (!name || !wcsicmp( r->lines[i] + 8, name ))) return i;
+    return -1;
+}
+
+#endif /* __WINE_SGNETCTL_H */
