+/* Stained Glass OS: /release and /renew through sg-netctl (the network is
+ * NetworkManager's): every adapter with DHCP, or those whose name matches */
+static BOOL adapter_matches(const WCHAR *name, const WCHAR *pattern)
+{
+    WCHAR *star;
+    size_t len;
+
+    if (!pattern) return TRUE;
+    if (!(star = wcschr(pattern, '*'))) return !wcsicmp(name, pattern);
+    len = star - pattern;
+    return !wcsnicmp(name, pattern, len);  /* "Eth*" -- a prefix, as scripts use it */
+}
+
+static int lease(BOOL renew, const WCHAR *pattern)
+{
+    struct sgnet_reply adapters, r;
+    const WCHAR *verb = renew ? L"renew" : L"release";
+    const WCHAR *args[2];
+    int i, done = 0, failed = 0, ret;
+
+    if ((ret = sgnet_request((const WCHAR *const[]){ L"adapters" }, 1, &adapters)) < 0)
+    {
+        ipconfig_printfW(L"\nWindows IP Configuration\n\nThe operation failed as no adapter is in the state permissible for this operation.\n");
+        return 1;
+    }
+    for (i = 0; i < adapters.count; i++)
+    {
+        const WCHAR *name, *method, *type;
+
+        if (wcsncmp(adapters.lines[i], L"ADAPTER ", 8)) continue;
+        name = adapters.lines[i] + 8;
+        type = sgnet_field(&adapters, i, L"TYPE", 0);
+        method = sgnet_field(&adapters, i, L"IPV4-METHOD", 0);
+        if (!type || (wcscmp(type, L"ethernet") && wcscmp(type, L"wifi"))) continue;
+        if (!adapter_matches(name, pattern)) continue;
+        if (!method || wcscmp(method, L"auto")) continue;  /* not DHCP */
+        args[0] = verb;
+        args[1] = name;
+        if (sgnet_request(args, 2, &r) != 1)
+        {
+            if (!wcscmp(r.kind, L"denied"))
+                ipconfig_printfW(L"\nThe requested operation requires elevation.\n");
+            else
+                ipconfig_printfW(L"\nAn error occurred while %1 interface %2 : %3\n",
+                                 renew ? L"renewing" : L"releasing", name, r.message);
+            failed++;
+        }
+        else done++;
+        sgnet_free(&r);
+    }
+    sgnet_free(&adapters);
+    if (!done && !failed)
+    {
+        ipconfig_printfW(L"\nWindows IP Configuration\n\nThe operation failed as no adapter is in the state permissible for this operation.\n");
+        return 1;
+    }
+    if (done) print_basic_information();
+    return failed ? 1 : 0;
+}
+
+static int flush_dns(void)
+{
+    static const WCHAR resolvectl[] = L"\\\\?\\unix\\usr\\bin\\resolvectl";
+    const WCHAR *args[] = { L"flush-caches" };
+    DWORD code;
+    char *out;
+
+    ipconfig_printfW(L"\nWindows IP Configuration\n\n");
+    if (sgnet_run_native(resolvectl, args, 1, &out, &code, 30000) && !code)
+    {
+        free(out);
+        ipconfig_printfW(L"Successfully flushed the DNS Resolver Cache.\n");
+        return 0;
+    }
+    free(out);
+    ipconfig_printfW(L"Could not flush the DNS Resolver Cache: Function failed during execution.\n");
+    return 1;
+}
