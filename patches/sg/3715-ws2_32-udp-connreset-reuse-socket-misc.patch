+#else
+    post = NULL;
+#endif
+    ReleaseSRWLockExclusive( &async_lock );
+
+    /* a cancelled request never posts its message */
+    if (!cancelled)
+    {
+        if (post) post( query->hWnd, query->uMsg, (WPARAM)query->handle, lparam );
+        else PostMessageW( query->hWnd, query->uMsg, (WPARAM)query->handle, lparam );
