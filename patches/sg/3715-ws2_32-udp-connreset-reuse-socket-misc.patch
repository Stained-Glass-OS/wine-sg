+static SRWLOCK async_lock = SRWLOCK_INIT;
+static struct list pending_queries = LIST_INIT( pending_queries );
+static ULONG completed_queries[64];
+static unsigned int completed_next;
+static LPWPUPOSTMESSAGE post_routine;
