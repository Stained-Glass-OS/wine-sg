+#ifdef linux
+/* Read and drop the queued ICMP errors of a UDP socket; returns the number of entries and, in
+ * *unreach, how many of them were "port unreachable". */
+static int sock_drain_errqueue( struct sock *sock, int *unreach )
+{
+    int fd = get_unix_fd( sock->fd ), total = 0;
+
+    *unreach = 0;
+    while (total < 1024)
+    {
+        char data[1], control[256];
+        struct iovec iov = { data, sizeof(data) };
+        struct msghdr hdr;
+        struct cmsghdr *cmsg;
