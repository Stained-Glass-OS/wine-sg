 {
-    FIXME("stub.\n");
-    return INVALID_SOCKET;
+    /* Stained Glass OS: the multipoint session of a UDP socket is an IP multicast group. The result
+     * is another handle of s, which joins the group unless JL_SENDER_ONLY. Closing the leaf does not
+     * leave the group while s is open. Which socket gets the datagrams, and the FD_CONNECT
+     * notification of a non-blocking join, are not verified against Windows. */
+    WSAPROTOCOL_INFOW info;
+    int len, type, err;
+    SOCKET leaf;
+
+    TRACE( "socket %#Ix, addr %p, addrlen %d, caller_data %p, callee_data %p, socket_qos %p, group_qos %p, flags %#lx\n",
+           s, addr, addrlen, caller_data, callee_data, socket_qos, group_qos, flags );
+
+    if (!socket_list_find( s ))
+    {
+        SetLastError( WSAENOTSOCK );
+        return INVALID_SOCKET;
+    }
+    if (!addr || addrlen < (int)sizeof(addr->sa_family) || IsBadReadPtr( addr, addrlen ))
+    {
+        SetLastError( WSAEFAULT );
+        return INVALID_SOCKET;
+    }
+
+    len = sizeof(type);
+    if (getsockopt( s, SOL_SOCKET, SO_TYPE, (char *)&type, &len ))
+        return INVALID_SOCKET;
+    len = sizeof(info);
+    if (getsockopt( s, SOL_SOCKET, SO_PROTOCOL_INFOW, (char *)&info, &len ))
+        return INVALID_SOCKET;
+    if (type != SOCK_DGRAM || (info.iAddressFamily != AF_INET && info.iAddressFamily != AF_INET6))
+    {
+        SetLastError( WSAEOPNOTSUPP );
+        return INVALID_SOCKET;
+    }
+    if (addr->sa_family != info.iAddressFamily)
+    {
+        SetLastError( WSAEAFNOSUPPORT );
+        return INVALID_SOCKET;
+    }
+    if (addrlen < (info.iAddressFamily == AF_INET ? (int)sizeof(struct sockaddr_in) : (int)sizeof(struct sockaddr_in6)))
+    {
+        SetLastError( WSAEFAULT );
+        return INVALID_SOCKET;
+    }
+    if (flags != JL_SENDER_ONLY && flags != JL_RECEIVER_ONLY && flags != JL_BOTH)
+    {
+        SetLastError( WSAEINVAL );
+        return INVALID_SOCKET;
+    }
+    if (caller_data && caller_data->len)
+    {
+        SetLastError( WSAEPROTONOSUPPORT );  /* a datagram session has no connect data */
+        return INVALID_SOCKET;
+    }
+    if (info.iAddressFamily == AF_INET
+        ? (((const struct sockaddr_in *)addr)->sin_addr.S_un.S_un_b.s_b1 & 0xf0) != 0xe0
+        : ((const struct sockaddr_in6 *)addr)->sin6_addr.u.Byte[0] != 0xff)
+    {
+        SetLastError( WSAEADDRNOTAVAIL );
+        return INVALID_SOCKET;
+    }
+    if (callee_data) callee_data->len = 0;
+
+    /* the leaf is a second handle of the socket: it has the same local address and the same membership */
+    if (!DuplicateHandle( GetCurrentProcess(), (HANDLE)s, GetCurrentProcess(), (HANDLE *)&leaf, 0, TRUE,
+                          DUPLICATE_SAME_ACCESS ))
+    {
+        SetLastError( WSAENOBUFS );
+        return INVALID_SOCKET;
+    }
+
+#ifndef SG_MUTANT_JOIN_NO_MEMBERSHIP
+    if (flags != JL_SENDER_ONLY)
+#else
+    if (0)
+#endif
+    {
+        int ret;
+
+        if (info.iAddressFamily == AF_INET)
+        {
+            struct ip_mreq mreq;
+
+            memset( &mreq, 0, sizeof(mreq) );
+            mreq.imr_multiaddr = ((const struct sockaddr_in *)addr)->sin_addr;
+            ret = setsockopt( s, IPPROTO_IP, IP_ADD_MEMBERSHIP, (char *)&mreq, sizeof(mreq) );
+        }
+        else
+        {
+            struct ipv6_mreq mreq;
+
+            memset( &mreq, 0, sizeof(mreq) );
+            mreq.ipv6mr_multiaddr = ((const struct sockaddr_in6 *)addr)->sin6_addr;
+            ret = setsockopt( s, IPPROTO_IPV6, IPV6_ADD_MEMBERSHIP, (char *)&mreq, sizeof(mreq) );
+        }
+        if (ret)
+        {
+            err = WSAGetLastError();
+            CloseHandle( (HANDLE)leaf );
+            SetLastError( err );
+            return INVALID_SOCKET;
+        }
+    }
+    if (!socket_list_add( leaf ))
+    {
+        CloseHandle( (HANDLE)leaf );
+        SetLastError( WSAENOBUFS );
+        return INVALID_SOCKET;
+    }
+    WSASetLastError( 0 );
+    return leaf;
 }
 
