+/* Stained Glass OS: the ioctls after which the server holds a new Unix fd for the handle */
+BOOL sock_ioctl_replaces_fd( UINT code )
+{
+    return code == IOCTL_AFD_WINE_DISCONNECT_REUSE;
+}
