             errno = EWOULDBLOCK;
 
         if (errno != EWOULDBLOCK) WARN( "recvmsg: %s\n", strerror( errno ) );
+#ifdef linux
+        if (errno == ECONNREFUSED)
+        {
+            int type;
+            socklen_t len = sizeof(type);
+
+            /* An ICMP port unreachable on a UDP socket: the server reads the error queue and decides
+             * whether this receive fails (SIO_UDP_CONNRESET), so just try again. */
+            if (!getsockopt( fd, SOL_SOCKET, SO_TYPE, &type, &len ) && type == SOCK_DGRAM)
