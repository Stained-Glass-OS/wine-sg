            s, overlapped, error, transferred, errcode );
 
-    if (errcode)
-        *errcode = WSAEINVAL;
-
-    return NULL;
+    /* Only sockets made by WPUCreateSocketHandle (layered service providers) can complete
+     * requests this way, and this ws2_32 has no service provider interface, so there is
+     * no such socket: every handle gets the documented WSAEINVAL. */
+    if (!errcode)
+    {
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    *errcode = WSAEINVAL;
+    return SOCKET_ERROR;
 }
