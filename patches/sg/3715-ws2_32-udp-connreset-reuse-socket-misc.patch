+/***********************************************************************
+ *           server_invalidate_fd_cache
+ *
+ * Stained Glass OS: the server replaced the Unix fd behind a handle (DisconnectEx with
+ * TF_REUSE_SOCKET): forget, and close, the copy this process cached.
+ */
+void server_invalidate_fd_cache( HANDLE handle )
+{
+    sigset_t sigset;
+    int fd;
+
+    server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
+    fd = remove_fd_from_cache( handle );
+    server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+    if (fd != -1) close( fd );
+}
+
