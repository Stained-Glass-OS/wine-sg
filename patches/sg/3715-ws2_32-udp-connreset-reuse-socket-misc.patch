 INT WINAPI WSACancelAsyncRequest(HANDLE hAsyncTaskHandle)
 {
-    FIXME("(%p),stub\n", hAsyncTaskHandle);
+    struct async_query_header *query;
+    int err = WSAEINVAL;
+    unsigned int i;
+
+    TRACE( "(%p)\n", hAsyncTaskHandle );
+
+    if (hAsyncTaskHandle)
+    {
+        AcquireSRWLockExclusive( &async_lock );
+        LIST_FOR_EACH_ENTRY( query, &pending_queries, struct async_query_header, entry )
+        {
+            if (query->handle != hAsyncTaskHandle || query->cancelled) continue;
+#ifndef SG_MUTANT_CANCEL_NOFLAG
+            query->cancelled = TRUE;
+#endif
+            err = 0;
+            break;
+        }
+        if (err)
+        {
+            for (i = 0; i < ARRAY_SIZE(completed_queries); i++)
+                if (completed_queries[i] == HandleToUlong( hAsyncTaskHandle )) err = WSAEALREADY;
+        }
+        ReleaseSRWLockExclusive( &async_lock );
+    }
+
+    if (err)
+    {
+        SetLastError( err );
+        return SOCKET_ERROR;
+    }
     return 0;
 }
 
