From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 00:29:43 -0700
Subject: [PATCH] extrac32: /A cabinet chain and file name arguments (3295)

extrac32 /A was a FIXME and file name arguments were ignored (every file
was extracted). Now /A follows the cabinet chain (the next cabinet is
taken from the cabinet information, split files are completed from it, and
each following cabinet is processed in turn); without /A only the first
cabinet is processed. The file names after the cabinet (wildcards allowed,
matched against the name in the cabinet and its last component) select what
is extracted (/E) or listed (/D).

diff --git a/programs/extrac32/extrac32.c b/programs/extrac32/extrac32.c
index 6d6dd2e..8535eac 100644
--- a/programs/extrac32/extrac32.c
+++ b/programs/extrac32/extrac32.c
@@ -33,6 +33,32 @@ WINE_DEFAULT_DEBUG_CHANNEL(extrac32);
 
 static BOOL force_mode;
 static BOOL show_content;
+static BOOL all_cabinets;            /* /A: follow the cabinet chain */
+static WCHAR **file_names;           /* names (wildcards allowed) to extract or list; NULL: every file */
+static int file_name_count;
+
+/* context handed to the setup callback */
+struct extract_context
+{
+    WCHAR *dest;
+    WCHAR cab_dir[MAX_PATH];         /* directory of the first cabinet, where the next ones are looked for */
+    WCHAR next[MAX_PATH];            /* the cabinet that follows the one being processed, if any */
+    BOOL info_seen;                  /* the first cabinet information of this cabinet was recorded */
+};
+
+static BOOL name_wanted(const WCHAR *name)
+{
+    const WCHAR *base = PathFindFileNameW(name);
+    int i;
+
+#ifdef SG_MUTANT_EXTRAC_FILTER
+    return TRUE;
+#endif
+    if (!file_name_count) return TRUE;
+    for (i = 0; i < file_name_count; i++)
+        if (PathMatchSpecW(name, file_names[i]) || PathMatchSpecW(base, file_names[i])) return TRUE;
+    return FALSE;
+}
 
 static void create_target_directory(LPWSTR Target)
 {
@@ -54,10 +80,49 @@ static UINT WINAPI ExtCabCallback(PVOID Context, UINT Notification, UINT_PTR Par
     FILE_IN_CABINET_INFO_W *pInfo;
     FILEPATHS_W *pFilePaths;
 
+    struct extract_context *ctx = Context;
+
     switch(Notification)
     {
+        case SPFILENOTIFY_CABINETINFO:
+        {
+            /* the first notification of each cabinet names the cabinet that follows it; the later ones
+             * are for cabinets opened to finish a split file */
+            CABINET_INFO_W *ci = (CABINET_INFO_W *)Param1;
+            if (!ctx->info_seen)
+            {
+#ifndef SG_MUTANT_EXTRAC_FIRSTINFO
+                ctx->info_seen = TRUE;
+#endif
+                lstrcpynW(ctx->next, ci->CabinetFile ? ci->CabinetFile : L"", MAX_PATH);
+            }
+            return NO_ERROR;
+        }
+        case SPFILENOTIFY_NEEDNEWCABINET:
+        {
+            CABINET_INFO_W *ci = (CABINET_INFO_W *)Param1;
+            WCHAR *next_dir = (WCHAR *)Param2;
+            WCHAR next[MAX_PATH];
+
+            /* a file continues in the next cabinet of the chain: only /A follows it */
+#ifndef SG_MUTANT_EXTRAC_SPLIT
+            if (!all_cabinets) return ERROR_FILE_NOT_FOUND;
+#endif
+            PathCombineW(next, ctx->cab_dir, ci->CabinetFile);
+            if (!PathFileExistsW(next))
+            {
+                WINE_ERR("Next cabinet %s not found\n", wine_dbgstr_w(next));
+                return ERROR_FILE_NOT_FOUND;
+            }
+#ifdef SG_MUTANT_EXTRAC_NODIR
+            return ERROR_FILE_NOT_FOUND;
+#endif
+            lstrcpyW(next_dir, ctx->cab_dir);
+            return NO_ERROR;
+        }
         case SPFILENOTIFY_FILEINCABINET:
             pInfo = (FILE_IN_CABINET_INFO_W*)Param1;
+            if (!name_wanted(pInfo->NameInCabinet)) return FILEOP_SKIP;
             if(show_content)
             {
                 FILETIME ft;
@@ -82,7 +147,7 @@ static UINT WINAPI ExtCabCallback(PVOID Context, UINT Notification, UINT_PTR Par
             }
             else
             {
-                lstrcpyW(pInfo->FullTargetName, (LPCWSTR)Context);
+                lstrcpyW(pInfo->FullTargetName, ctx->dest);
                 lstrcatW(pInfo->FullTargetName, pInfo->NameInCabinet);
                 /* SetupIterateCabinet() doesn't create full path to target by itself,
                    so we should do it manually */
@@ -99,8 +164,34 @@ static UINT WINAPI ExtCabCallback(PVOID Context, UINT Notification, UINT_PTR Par
 
 static void extract(LPCWSTR cabfile, LPWSTR destdir)
 {
-    if (!SetupIterateCabinetW(cabfile, 0, ExtCabCallback, destdir))
-        WINE_ERR("Could not extract cab file %s\n", wine_dbgstr_w(cabfile));
+    struct extract_context ctx;
+    WCHAR current[MAX_PATH];
+    int count;
+
+    ctx.dest = destdir;
+    if (!GetFullPathNameW(cabfile, MAX_PATH, ctx.cab_dir, NULL)) lstrcpyW(ctx.cab_dir, cabfile);
+    *PathFindFileNameW(ctx.cab_dir) = 0;
+    lstrcpyW(current, cabfile);
+
+    /* /A: go on with the cabinet that follows, until the chain ends */
+    for (count = 0; count < 1000; count++)
+    {
+        ctx.next[0] = 0;
+        ctx.info_seen = FALSE;
+        if (!SetupIterateCabinetW(current, 0, ExtCabCallback, &ctx))
+        {
+            WINE_ERR("Could not extract cab file %s\n", wine_dbgstr_w(current));
+            return;
+        }
+#ifdef SG_MUTANT_EXTRAC_ALWAYS
+        if (!ctx.next[0]) return;
+#elif defined(SG_MUTANT_EXTRAC_NOCHAIN)
+        return;
+#else
+        if (!all_cabinets || !ctx.next[0]) return;
+#endif
+        PathCombineW(current, ctx.cab_dir, ctx.next);
+    }
 }
 
 static void copy_file(LPCWSTR source, LPCWSTR destination)
@@ -260,7 +351,7 @@ int PASCAL wWinMain(HINSTANCE hInstance, HINSTANCE prev, LPWSTR cmdline, int sho
         switch(check)
         {
             case 'A':
-                WINE_FIXME("/A not implemented\n");
+                all_cabinets = TRUE;
                 break;
             case 'Y':
                 force_mode = TRUE;
@@ -297,6 +388,12 @@ int PASCAL wWinMain(HINSTANCE hInstance, HINSTANCE prev, LPWSTR cmdline, int sho
     if (cmd == 'E' && !path[0])
         GetCurrentDirectoryW(MAX_PATH, path);
 
+    if (cmd != 'C' && i < argc)
+    {
+        file_names = &argv[i];
+        file_name_count = argc - i;
+    }
+
     PathAddBackslashW(path);
 
     /* Execute the specified command */
