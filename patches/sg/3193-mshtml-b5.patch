+typedef struct {
+    IEnumConnectionPoints IEnumConnectionPoints_iface;
+
+    LONG ref;
+
+    unsigned iter, count;
+    IConnectionPoint **cps;
+} EnumConnectionPoints;
+
+static const IEnumConnectionPointsVtbl EnumConnectionPointsVtbl;
+
+static inline EnumConnectionPoints *impl_from_IEnumConnectionPoints(IEnumConnectionPoints *iface)
+{
+    return CONTAINING_RECORD(iface, EnumConnectionPoints, IEnumConnectionPoints_iface);
+}
+
+static HRESULT WINAPI EnumConnectionPoints_QueryInterface(IEnumConnectionPoints *iface, REFIID riid, void **ppv)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_mshtml_guid(riid), ppv);
+
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumConnectionPoints)) {
+        *ppv = &This->IEnumConnectionPoints_iface;
+    }else {
+        WARN("(%p)->(%s %p)\n", This, debugstr_mshtml_guid(riid), ppv);
+        *ppv = NULL;
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown*)*ppv);
+    return S_OK;
+}
+
+static ULONG WINAPI EnumConnectionPoints_AddRef(IEnumConnectionPoints *iface)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG ref = InterlockedIncrement(&This->ref);
+
+    TRACE("(%p) ref=%ld\n", This, ref);
+
+    return ref;
+}
+
+static ULONG WINAPI EnumConnectionPoints_Release(IEnumConnectionPoints *iface)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    unsigned i;
+
+    TRACE("(%p) ref=%ld\n", This, ref);
+
+    if(!ref) {
+        for(i = 0; i < This->count; i++)
+            IConnectionPoint_Release(This->cps[i]);
+        free(This->cps);
+        free(This);
+    }
+
+    return ref;
+}
+
+static HRESULT WINAPI EnumConnectionPoints_Next(IEnumConnectionPoints *iface, ULONG cConnections,
+        IConnectionPoint **ppCP, ULONG *pcFetched)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG fetched = 0;
+
+    TRACE("(%p)->(%ld %p %p)\n", This, cConnections, ppCP, pcFetched);
+
+    if(!ppCP || (!pcFetched && cConnections != 1))
+        return E_POINTER;
+
+    while(fetched < cConnections && This->iter < This->count) {
+        ppCP[fetched] = This->cps[This->iter++];
+        IConnectionPoint_AddRef(ppCP[fetched]);
+        fetched++;
+    }
+
+    if(pcFetched)
+        *pcFetched = fetched;
+    return fetched == cConnections ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumConnectionPoints_Skip(IEnumConnectionPoints *iface, ULONG cConnections)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+
+    TRACE("(%p)->(%ld)\n", This, cConnections);
+
+    if(cConnections > This->count - This->iter) {
+        This->iter = This->count;
+        return S_FALSE;
+    }
+    This->iter += cConnections;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumConnectionPoints_Reset(IEnumConnectionPoints *iface)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+
+    TRACE("(%p)\n", This);
+
+    This->iter = 0;
+    return S_OK;
+}
+
+static HRESULT create_enum_cps(IConnectionPoint **cps, unsigned count, unsigned iter, IEnumConnectionPoints **ret)
+{
+    EnumConnectionPoints *enum_cps;
+    unsigned i;
+
+    enum_cps = malloc(sizeof(*enum_cps));
+    if(!enum_cps)
+        return E_OUTOFMEMORY;
+    enum_cps->cps = malloc(max(count, 1) * sizeof(*cps));
+    if(!enum_cps->cps) {
+        free(enum_cps);
+        return E_OUTOFMEMORY;
+    }
+
+    enum_cps->IEnumConnectionPoints_iface.lpVtbl = &EnumConnectionPointsVtbl;
+    enum_cps->ref = 1;
+    enum_cps->iter = iter;
+    enum_cps->count = count;
+    for(i = 0; i < count; i++) {
+        enum_cps->cps[i] = cps[i];
+        IConnectionPoint_AddRef(cps[i]);
+    }
+
+    *ret = &enum_cps->IEnumConnectionPoints_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumConnectionPoints_Clone(IEnumConnectionPoints *iface, IEnumConnectionPoints **ppEnum)
+{
+    EnumConnectionPoints *This = impl_from_IEnumConnectionPoints(iface);
+
+    TRACE("(%p)->(%p)\n", This, ppEnum);
+
+    if(!ppEnum)
+        return E_POINTER;
+    return create_enum_cps(This->cps, This->count, This->iter, ppEnum);
+}
+
+static const IEnumConnectionPointsVtbl EnumConnectionPointsVtbl = {
+    EnumConnectionPoints_QueryInterface,
+    EnumConnectionPoints_AddRef,
+    EnumConnectionPoints_Release,
+    EnumConnectionPoints_Next,
+    EnumConnectionPoints_Skip,
+    EnumConnectionPoints_Reset,
+    EnumConnectionPoints_Clone
+};
+
 static HRESULT WINAPI ConnectionPointContainer_EnumConnectionPoints(IConnectionPointContainer *iface,
         IEnumConnectionPoints **ppEnum)
 {
     ConnectionPointContainer *This = impl_from_IConnectionPointContainer(iface);
-    FIXME("(%p)->(%p)\n", This, ppEnum);
-    return E_NOTIMPL;
+    IConnectionPoint **cps;
+    unsigned count, i;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, ppEnum);
+
+    if(!ppEnum)
+        return E_POINTER;
+
+    if(This->forward_container)
+        return IConnectionPointContainer_EnumConnectionPoints(&This->forward_container->IConnectionPointContainer_iface,
+                ppEnum);
+
+    for(count = 0; This->cp_entries && This->cp_entries[count].riid; count++);
+    cps = malloc(max(count, 1) * sizeof(*cps));
+    if(!cps)
+        return E_OUTOFMEMORY;
+    for(i = 0; i < count; i++) {
+        ConnectionPoint *cp = get_cp(This, This->cp_entries[i].riid, TRUE);
+        if(!cp) {
+            free(cps);
+            return E_OUTOFMEMORY;
+        }
+        cps[i] = &cp->IConnectionPoint_iface;
+    }
+
+    hres = create_enum_cps(cps, count, 0, ppEnum);
+    free(cps);
+    return hres;
 }
 
