-    FIXME("(%p)->(%s %ld %p)\n", This, debugstr_w(bstrURL), lIndex, plIndex);
-    return E_NOTIMPL;
+    UINT32 imports;
+    nsAString nsstr;
+    nsresult nsres;
+    WCHAR *rule;
+    UINT32 new_index;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s %ld %p)\n", This, debugstr_w(bstrURL), lIndex, plIndex);
+
+    if(!bstrURL || !*bstrURL || !plIndex)
+        return E_INVALIDARG;
+
+    hres = sheet_count_imports(This, &imports, NULL);
+    if(FAILED(hres))
+        return hres;
+    /* imports come first: the index is among them, and -1 is the end */
+    if(lIndex < 0 || (UINT32)lIndex > imports)
+        lIndex = imports;
+
+#ifdef SG_MUTANT_B5_IMPORT
+    *plIndex = 0;
+    return S_OK;
+#endif
+    rule = malloc((wcslen(bstrURL) + 16) * sizeof(WCHAR));
+    if(!rule)
+        return E_OUTOFMEMORY;
+    swprintf(rule, wcslen(bstrURL) + 16, L"@import url(\"%s\");", bstrURL);
+    nsAString_InitDepend(&nsstr, rule);
+    nsres = nsIDOMCSSStyleSheet_InsertRule(This->nsstylesheet, &nsstr, lIndex, &new_index);
+    nsAString_Finish(&nsstr);
+    free(rule);
+    if(NS_FAILED(nsres)) {
+        WARN("failed: %08lx\n", nsres);
+        return map_nsresult(nsres);
+    }
+    *plIndex = new_index;
+    return S_OK;
