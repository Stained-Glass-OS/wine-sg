         return S_OK;
     }
 
-    FIXME("local storage not supported\n");
-    return E_NOTIMPL;
+    /* the quota counts the characters of every name and value, as the session storage does */
+    WaitForSingleObject(This->mutex, INFINITE);
+    hres = get_node_list(This->filename, &node_list);
+    if(SUCCEEDED(hres)) {
+        LONG count, i;
+        UINT64 used = 0;
+
+        hres = IXMLDOMNodeList_get_length(node_list, &count);
+        for(i = 0; SUCCEEDED(hres) && i < count; i++) {
+            IXMLDOMNode *node;
+            IXMLDOMElement *elem;
+            VARIANT name;
+
+            hres = IXMLDOMNodeList_get_item(node_list, i, &node);
+            if(hres != S_OK)
+                break;
+            if(SUCCEEDED(IXMLDOMNode_QueryInterface(node, &IID_IXMLDOMElement, (void**)&elem))) {
+                static const WCHAR *const attrs[] = { L"name", L"value" };
+                unsigned a;
+
+                for(a = 0; a < ARRAY_SIZE(attrs); a++) {
+                    if(SUCCEEDED(IXMLDOMElement_getAttribute(elem, (BSTR)attrs[a], &name))) {
+                        if(V_VT(&name) == VT_BSTR)
+                            used += SysStringLen(V_BSTR(&name));
+                        VariantClear(&name);
+                    }
+                }
+                IXMLDOMElement_Release(elem);
+            }
+            IXMLDOMNode_Release(node);
+        }
+        IXMLDOMNodeList_Release(node_list);
+        if(SUCCEEDED(hres)) {
+#ifdef SG_MUTANT_B5_STORAGE
+            used = 0;
+#endif
+            *p = used > MAX_QUOTA ? 0 : MAX_QUOTA - used;
+            hres = S_OK;
+        }
+    }
+    ReleaseMutex(This->mutex);
+    return hres;
 }
 
