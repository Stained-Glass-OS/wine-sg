+DISPEX_IDISPATCH_IMPL(HTMLClipboardData, IHTMLDataTransfer, impl_from_IHTMLDataTransfer(iface)->dispex)
+
+enum clip_format { CLIP_NONE, CLIP_TEXT, CLIP_URL };
+
+static enum clip_format clip_format_from_name(const WCHAR *name)
+{
+    if(!name)
+        return CLIP_NONE;
+    if(!wcsicmp(name, L"Text"))
+        return CLIP_TEXT;
+    if(!wcsicmp(name, L"URL"))
+        return CLIP_URL;
+    return CLIP_NONE;
+}
+
+static UINT clip_format_id(enum clip_format format)
+{
+    return format == CLIP_TEXT ? CF_UNICODETEXT : RegisterClipboardFormatW(L"UniformResourceLocatorW");
+}
+
+static HRESULT WINAPI HTMLClipboardData_setData(IHTMLDataTransfer *iface, BSTR format, VARIANT *data, VARIANT_BOOL *pret)
+{
+    HTMLClipboardData *This = impl_from_IHTMLDataTransfer(iface);
+    enum clip_format fmt = clip_format_from_name(format);
+    VARIANT str;
+    HGLOBAL mem;
+    WCHAR *ptr;
+    SIZE_T size;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s %s %p)\n", This, debugstr_w(format), debugstr_variant(data), pret);
+
+    if(!pret)
+        return E_POINTER;
+    *pret = VARIANT_FALSE;
+    if(!data)
+        return E_INVALIDARG;
+    if(fmt == CLIP_NONE)
+        return S_OK;   /* other formats are not stored */
+
+    V_VT(&str) = VT_EMPTY;
+    hres = VariantChangeType(&str, data, 0, VT_BSTR);
+    if(FAILED(hres))
+        return hres;
+
+    size = (SysStringLen(V_BSTR(&str)) + 1) * sizeof(WCHAR);
+    mem = GlobalAlloc(GMEM_MOVEABLE, size);
+    if(mem && (ptr = GlobalLock(mem))) {
+        memcpy(ptr, V_BSTR(&str) ? V_BSTR(&str) : L"", size);
+        ptr[size / sizeof(WCHAR) - 1] = 0;
+        GlobalUnlock(mem);
+        if(OpenClipboard(NULL)) {
+            EmptyClipboard();
+            if(SetClipboardData(clip_format_id(fmt), mem)) {
+                *pret = VARIANT_TRUE;
+                mem = NULL;
+            }
+            CloseClipboard();
+        }
+    }
+    if(mem)
+        GlobalFree(mem);
+    VariantClear(&str);
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLClipboardData_getData(IHTMLDataTransfer *iface, BSTR format, VARIANT *pvarRet)
+{
+    HTMLClipboardData *This = impl_from_IHTMLDataTransfer(iface);
+    enum clip_format fmt = clip_format_from_name(format);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(format), pvarRet);
+
+    if(!pvarRet)
+        return E_POINTER;
+    V_VT(pvarRet) = VT_NULL;
+    if(fmt == CLIP_NONE)
+        return S_OK;
+
+#ifdef SG_MUTANT_B5_CLIP
+    return S_OK;
+#endif
+    if(OpenClipboard(NULL)) {
+        HANDLE mem = GetClipboardData(clip_format_id(fmt));
+        const WCHAR *ptr;
+
+        if(mem && (ptr = GlobalLock(mem))) {
+            BSTR text = SysAllocString(ptr);
+            GlobalUnlock(mem);
+            if(!text) {
+                CloseClipboard();
+                return E_OUTOFMEMORY;
+            }
+            V_VT(pvarRet) = VT_BSTR;
+            V_BSTR(pvarRet) = text;
+        }
+        CloseClipboard();
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLClipboardData_clearData(IHTMLDataTransfer *iface, BSTR format, VARIANT_BOOL *pret)
+{
+    HTMLClipboardData *This = impl_from_IHTMLDataTransfer(iface);
+    enum clip_format fmt = clip_format_from_name(format);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(format), pret);
+
+    if(!pret)
+        return E_POINTER;
+    *pret = VARIANT_FALSE;
+
+    /* no format: everything */
+    if(fmt == CLIP_NONE && format && *format)
+        return S_OK;
+    if(OpenClipboard(NULL)) {
+        if(EmptyClipboard())
+            *pret = VARIANT_TRUE;
+        CloseClipboard();
+    }
+    return S_OK;
+}
