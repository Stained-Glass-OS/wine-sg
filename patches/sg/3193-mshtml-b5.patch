+static HRESULT clip_put_string(BSTR *dst, BSTR v, const WCHAR *const *allowed)
+{
+    BSTR copy;
+
+    for( ; *allowed; allowed++)
+        if(v && !wcsicmp(v, *allowed))
+            break;
+    if(!*allowed)
+        return E_INVALIDARG;
+    copy = SysAllocString(*allowed);
+    if(!copy)
+        return E_OUTOFMEMORY;
+    SysFreeString(*dst);
+    *dst = copy;
+    return S_OK;
+}
