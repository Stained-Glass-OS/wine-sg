+/* toStaticHTML removes script and everything that runs: scripting elements, event attributes, script URLs and
+   style expressions */
+static BOOL is_script_url(const WCHAR *value)
+{
+    while(*value && (*value <= ' '))
+        value++;
+    return !wcsnicmp(value, L"javascript:", 11) || !wcsnicmp(value, L"vbscript:", 9) || !wcsnicmp(value, L"jscript:", 8);
+}
+
+static BOOL has_style_expression(const WCHAR *value)
+{
+    const WCHAR *p;
+    for(p = value; *p; p++) {
+        if(!wcsnicmp(p, L"expression", 10)) {
+            const WCHAR *q = p + 10;
+            while(*q == ' ' || *q == '\t' || *q == '\r' || *q == '\n') q++;
+            if(*q == '(')
+                return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static void static_html_strip_attrs(nsIDOMElement *elem)
+{
+    nsIDOMMozNamedAttrMap *attrs;
+    UINT32 len, i;
+
+    if(NS_FAILED(nsIDOMElement_GetAttributes(elem, &attrs)) || !attrs)
+        return;
+    nsIDOMMozNamedAttrMap_GetLength(attrs, &len);
+    for(i = len; i--; ) {
+        nsIDOMAttr *attr;
+        nsAString name_str, value_str;
+        const WCHAR *name, *value;
+        BOOL remove;
+
+        if(NS_FAILED(nsIDOMMozNamedAttrMap_Item(attrs, i, &attr)) || !attr)
+            continue;
+        nsAString_Init(&name_str, NULL);
+        nsAString_Init(&value_str, NULL);
+        nsIDOMAttr_GetName(attr, &name_str);
+        nsIDOMAttr_GetValue(attr, &value_str);
+        nsAString_GetData(&name_str, &name);
+        nsAString_GetData(&value_str, &value);
+
+        remove = !wcsnicmp(name, L"on", 2) || is_script_url(value) ||
+                 (!wcsicmp(name, L"style") && has_style_expression(value)) ||
+                 !wcsicmp(name, L"dynsrc") || !wcsicmp(name, L"lowsrc");
+        if(remove)
+            nsIDOMElement_RemoveAttribute(elem, &name_str);
+        nsAString_Finish(&name_str);
+        nsAString_Finish(&value_str);
+        nsIDOMAttr_Release(attr);
+    }
+    nsIDOMMozNamedAttrMap_Release(attrs);
+}
+
+static void static_html_strip(nsIDOMNode *parent)
+{
+    nsIDOMNode *child, *next;
+
+#ifdef SG_MUTANT_B5_STATIC
+    return;
+#endif
+
+    nsIDOMNode_GetFirstChild(parent, &child);
+    while(child) {
+        UINT16 type = 0;
+        BOOL removed = FALSE;
+
+        nsIDOMNode_GetNextSibling(child, &next);
+        nsIDOMNode_GetNodeType(child, &type);
+        if(type == 1 /* ELEMENT_NODE */) {
+            nsIDOMElement *elem;
+
+            if(NS_SUCCEEDED(nsIDOMNode_QueryInterface(child, &IID_nsIDOMElement, (void**)&elem))) {
+                nsAString tag_str;
+                const WCHAR *tag;
+
+                nsAString_Init(&tag_str, NULL);
+                nsIDOMElement_GetTagName(elem, &tag_str);
+                nsAString_GetData(&tag_str, &tag);
+                if(!wcsicmp(tag, L"script") || !wcsicmp(tag, L"applet") || !wcsicmp(tag, L"object") ||
+                   !wcsicmp(tag, L"embed") || !wcsicmp(tag, L"noscript")) {
+                    nsIDOMNode *removed_node;
+                    nsIDOMNode_RemoveChild(parent, child, &removed_node);
+                    if(removed_node)
+                        nsIDOMNode_Release(removed_node);
+                    removed = TRUE;
+                }else {
+                    static_html_strip_attrs(elem);
+                }
+                nsAString_Finish(&tag_str);
+                nsIDOMElement_Release(elem);
+            }
+        }
+        if(!removed)
+            static_html_strip(child);
+        nsIDOMNode_Release(child);
+        child = next;
+    }
+}
