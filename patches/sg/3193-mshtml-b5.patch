+/* The import rules are the leading rules of a sheet. */
+static HRESULT sheet_count_imports(HTMLStyleSheet *This, UINT32 *count, UINT32 *length)
+{
+    nsIDOMCSSRuleList *list;
+    UINT32 len, i;
+
+    if(NS_FAILED(nsIDOMCSSStyleSheet_GetCssRules(This->nsstylesheet, &list)))
+        return E_FAIL;
+    nsIDOMCSSRuleList_GetLength(list, &len);
+    for(i = 0; i < len; i++) {
+        nsIDOMCSSRule *rule;
+        UINT16 type = 0;
+
+        if(NS_FAILED(nsIDOMCSSRuleList_Item(list, i, &rule)) || !rule)
+            break;
+        nsIDOMCSSRule_GetType(rule, &type);
+        nsIDOMCSSRule_Release(rule);
+        if(type != 3 /* IMPORT_RULE */)
+            break;
+    }
+    nsIDOMCSSRuleList_Release(list);
+    *count = i;
+    if(length) *length = len;
+    return S_OK;
+}
