+/* window.clipboardData: the Text and URL formats of the system clipboard */
+typedef struct {
+    DispatchEx dispex;
+    IHTMLDataTransfer IHTMLDataTransfer_iface;
+    BSTR drop_effect, effect_allowed;
+} HTMLClipboardData;
+
+static inline HTMLClipboardData *impl_from_IHTMLDataTransfer(IHTMLDataTransfer *iface)
+{
+    return CONTAINING_RECORD(iface, HTMLClipboardData, IHTMLDataTransfer_iface);
+}
