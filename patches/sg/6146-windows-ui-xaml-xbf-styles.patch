+    if ((!owner || !wcscmp( owner, L"Setter" )) && xaml_setter_markup( obj, name, str, value )) return S_OK;
     if (!owner && str && !wcscmp( name, L"TargetType" ))
     {
         WCHAR *full = writer->resolve_type ? writer->resolve_type( writer, str ) : NULL;
