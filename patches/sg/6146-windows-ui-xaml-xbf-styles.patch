+static HRESULT load_xbf( struct xbf_blob *blob, UINT32 section, IInspectable *component, struct uielem *templated_parent,
+                         IInspectable **out );
+
 HRESULT xaml_load_xbf( const BYTE *data, size_t size, IInspectable *component, IInspectable **out )
+{
+    struct xbf_blob *blob;
+    HRESULT hr;
+
+    *out = NULL;
+    if (size > 64 * 1024 * 1024 || !(blob = malloc( offsetof(struct xbf_blob, data[size]) ))) return E_OUTOFMEMORY;
+    blob->ref = 1;
+    blob->size = size;
+    memcpy( blob->data, data, size );
+    hr = load_xbf( blob, 0, component, NULL, out );
+    xaml_xbf_blob_release( blob );
+    return hr;
+}
+
+/* a compiled template's content (a section of its file) made for a control */
+HRESULT xaml_load_xbf_template( struct xbf_blob *blob, UINT32 section, struct uielem *templated_parent, IInspectable **root )
+{
+    return load_xbf( blob, section, NULL, templated_parent, root );
+}
