+/* the name of a style's or a setter's property: Owner.Name when its owner is one of ours */
+static WCHAR *setter_property( struct xbf_state *s, UINT16 id, BOOL string_id )
+{
+    WCHAR *name = NULL, *owner = NULL, *ret;
+
+    if (string_id) return xbf_string( s->xbf, id );
+    if (!property_name( s, id, &name, &owner )) return NULL;
+    if (!owner) return name;
+    if ((ret = malloc( (wcslen( owner ) + wcslen( name ) + 2) * sizeof(WCHAR) )))
+        swprintf( ret, wcslen( owner ) + wcslen( name ) + 2, L"%s.%s", owner, name );
+    free( name );
+    free( owner );
+    return ret;
+}
+
+/* a style's setters: made and added to the style */
+static HRESULT read_style_setters( struct xbf_state *s, struct rd *r, UINT32 section )
+{
+    IInspectable *style = top_object( s );
+    UINT32 i, n = rd_7bit( r );
+    HRESULT hr = S_OK;
+
+#ifdef SG_MUTANT_XBF_NO_SETTERS
+    style = NULL;
+#endif
+    if (n > 4096) return E_INVALIDARG;
+    for (i = 0; i < n && !r->bad && SUCCEEDED(hr); i++)
+    {
+        BYTE type = rd_u8( r );
+        IInspectable *setter = NULL, *obj = NULL;
+        WCHAR *prop = NULL, *value = NULL;
+        UINT32 offset = 0;
+
+        switch (type)
+        {
+        case 0x01: case 0x02: case 0x08:   /* by name (and type); value: a resource or an object of the section */
+            prop = setter_property( s, rd_u16( r ), TRUE );
+            rd_u16( r );
+            offset = rd_7bit( r );
+            break;
+        case 0x11: case 0x12: case 0x18:   /* by property ID */
+            prop = setter_property( s, rd_u16( r ), FALSE );
+            offset = rd_7bit( r );
+            break;
+        case 0x20:                          /* by name, an inline value */
+            prop = setter_property( s, rd_u16( r ), TRUE );
+            rd_u16( r );
+            value = read_value( s, r );
+            break;
+        case 0x30:                          /* by property ID, an inline value */
+            prop = setter_property( s, rd_u16( r ), FALSE );
+            value = read_value( s, r );
+            break;
+        default:
+            r->bad = TRUE;
+        }
+        if (!r->bad && prop && style && SUCCEEDED(xaml_writer_create( s->writer, NULL, L"Setter", &setter )))
+        {
+            xaml_setter_markup( setter, L"Property", prop, NULL );
+            if (value) xaml_setter_markup( setter, L"Value", value, NULL );
+            else if (type == 0x08 || type == 0x18)
+            {
+                if ((obj = section_object( s, section, offset, &hr )))
+                {
+                    xaml_setter_markup( setter, L"Value", NULL, obj );
+                    IInspectable_Release( obj );
+                }
+            }
+            else
+            {
+                /* a resource: read with the setter as the object it is set on */
+                unsigned int frames = s->nframes;
+                IInspectable_AddRef( setter );
+                if (SUCCEEDED(hr = push_frame( s, setter, FALSE ))) hr = read_section( s, section, offset, READ_NODE );
+                while (s->nframes > frames)
+                {
+                    IInspectable *extra = pop_frame( s );
+                    if (extra) IInspectable_Release( extra );
+                }
+            }
+            if (SUCCEEDED(hr)) hr = xaml_writer_set( s->writer, style, NULL, L"Setters", NULL, setter );
+            IInspectable_Release( setter );
+            if (hr == E_INVALIDARG) hr = S_OK;
+        }
+        free( prop );
+        free( value );
+    }
+    return r->bad ? E_INVALIDARG : hr;
+}
