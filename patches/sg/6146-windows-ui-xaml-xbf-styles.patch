+/* a dictionary's resources: made and added to the collection being read */
+static HRESULT read_dictionary( struct xbf_state *s, struct rd *r, UINT32 section, BOOL extended )
+{
+    struct collection *c = s->ncolls ? &s->colls[s->ncolls - 1] : NULL;
+    UINT32 i, n;
+    HRESULT hr = S_OK;
+
+    n = rd_7bit( r );
+    if (n > 65536) return E_INVALIDARG;
+    for (i = 0; i < n && !r->bad && SUCCEEDED(hr); i++)
+    {
+        WCHAR *key = xbf_string( s->xbf, rd_u16( r ) );
+        UINT32 offset = rd_7bit( r );
+        IInspectable *obj;
+
+        if (!key) { r->bad = TRUE; break; }
+        if (!r->bad && c && c->owner && (obj = section_object( s, section, offset, &hr )))
+        {
+            hr = xaml_writer_add_keyed( s->writer, c->owner, c->name, obj, key );
+            IInspectable_Release( obj );
+            if (hr == E_INVALIDARG) hr = S_OK;
+        }
+        free( key );
+    }
+    n = rd_7bit( r );
+    for (i = 0; i < n && !r->bad; i++) rd_u16( r );
+    n = rd_7bit( r );   /* styles without a key: implicit ones */
+    if (n > 65536) return E_INVALIDARG;
+    for (i = 0; i < n && !r->bad && SUCCEEDED(hr); i++)
+    {
+        IInspectable *obj;
+        UINT32 offset;
+
+        rd_u16( r );
+        offset = rd_7bit( r );
+        if (!r->bad && c && c->owner && (obj = section_object( s, section, offset, &hr )))
+        {
+            hr = xaml_writer_add_keyed( s->writer, c->owner, c->name, obj, NULL );
+            IInspectable_Release( obj );
+            if (hr == E_INVALIDARG) hr = S_OK;
+        }
+    }
+    if (extended) rd_7bit( r );
+    n = rd_7bit( r );
+    for (i = 0; i < n && !r->bad; i++) rd_u16( r );
+    return r->bad ? E_INVALIDARG : hr;
+}
