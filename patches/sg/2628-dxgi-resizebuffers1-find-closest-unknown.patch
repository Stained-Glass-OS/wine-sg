From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dxgi: ResizeBuffers1 of Direct3D 11 swap chains, matching modes without a format

 - IDXGISwapChain3::ResizeBuffers1 was E_NOTIMPL. On a Direct3D 11 swap chain it is
   ResizeBuffers once the node masks (which can only name the one node; checked also when the
   buffer count is zero, for the count the swap chain has) and the command queues (which
   Direct3D 12 swap chains have; a Direct3D 11 device is not one) are valid:
   DXGI_ERROR_INVALID_CALL otherwise.
 - IDXGIOutput::FindClosestMatchingMode with DXGI_FORMAT_UNKNOWN and a device was E_NOTIMPL:
   the mode is matched in the format the output shows now.
The todo_wine marks of the dxgi tests for both are removed.
---
--- a/dlls/dxgi/output.c
+++ b/dlls/dxgi/output.c
@@ -64,13 +64,23 @@ static HRESULT dxgi_output_find_closest_matching_mode(struct dxgi_output *output
     if (mode->format_id == WINED3DFMT_UNKNOWN && !device)
         return DXGI_ERROR_INVALID_CALL;
 
+    wined3d_mutex_lock();
     if (mode->format_id == WINED3DFMT_UNKNOWN)
     {
-        FIXME("Matching formats to device not implemented.\n");
+        struct wined3d_display_mode current;
+
+        /* No format to match: the one the output shows now. */
+#ifdef SG_MUTANT_DXGI_FIND_UNKNOWN
+        wined3d_mutex_unlock();
         return E_NOTIMPL;
+#endif
+        if (FAILED(hr = wined3d_output_get_display_mode(output->wined3d_output, &current, NULL)))
+        {
+            wined3d_mutex_unlock();
+            return hr;
+        }
+        mode->format_id = current.format_id;
     }
-
-    wined3d_mutex_lock();
     hr = wined3d_output_find_closest_matching_mode(output->wined3d_output, mode);
     wined3d_mutex_unlock();
 
--- a/dlls/dxgi/swapchain.c
+++ b/dlls/dxgi/swapchain.c
@@ -899,11 +899,45 @@ static HRESULT STDMETHODCALLTYPE d3d11_swapchain_ResizeBuffers1(IDXGISwapChain4
         UINT buffer_count, UINT width, UINT height, DXGI_FORMAT format, UINT flags,
         const UINT *node_mask, IUnknown * const *present_queue)
 {
-    FIXME("iface %p, buffer_count %u, width %u, height %u, format %s, flags %#x, "
-            "node_mask %p, present_queue %p stub!\n",
+    UINT i;
+
+    TRACE("iface %p, buffer_count %u, width %u, height %u, format %s, flags %#x, "
+            "node_mask %p, present_queue %p.\n",
             iface, buffer_count, width, height, debug_dxgi_format(format), flags, node_mask, present_queue);
 
-    return E_NOTIMPL;
+    /* One adapter with one node: the masks that are given can only name it. */
+    if (node_mask)
+    {
+        UINT count = buffer_count;
+
+        if (!count)
+        {
+            struct d3d11_swapchain *swapchain = d3d11_swapchain_from_IDXGISwapChain4(iface);
+            struct wined3d_swapchain_desc wined3d_desc;
+
+            wined3d_mutex_lock();
+            wined3d_swapchain_get_desc(swapchain->wined3d_swapchain, &wined3d_desc);
+            wined3d_mutex_unlock();
+            count = wined3d_desc.backbuffer_count;
+        }
+        for (i = 0; i < count; ++i)
+        {
+#ifndef SG_MUTANT_DXGI_RESIZE1_MASKS
+            if (node_mask[i] & ~1u)
+                return DXGI_ERROR_INVALID_CALL;
+#endif
+        }
+    }
+    /* Command queues belong to Direct3D 12 swap chains. */
+#ifndef SG_MUTANT_DXGI_RESIZE1_QUEUE
+    if (present_queue)
+    {
+        WARN("Present queues on a Direct3D 11 swap chain.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
+#endif
+
+    return d3d11_swapchain_ResizeBuffers(iface, buffer_count, width, height, format, flags);
 }
 
 /* IDXGISwapChain4 methods */
--- a/dlls/dxgi/tests/dxgi.c
+++ b/dlls/dxgi/tests/dxgi.c
@@ -1566,7 +1566,7 @@ static void test_find_closest_matching_mode(void)
 
     memset(&mode, 0, sizeof(mode));
     hr = IDXGIOutput_FindClosestMatchingMode(output, &mode, &matching_mode, (IUnknown *)device);
-    todo_wine ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
 
     hr = IDXGIOutput_GetDisplayModeList(output, DXGI_FORMAT_R8G8B8A8_UNORM, 0, &mode_count, NULL);
     ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
@@ -4335,7 +4335,7 @@ static void test_swapchain_resize(IUnknown *device, BOOL is_d3d12)
     {
         hr = IDXGISwapChain3_ResizeBuffers1(swapchain3, 2, 320, 240,
                 DXGI_FORMAT_B8G8R8A8_UNORM, 0, node_mask, present_queue);
-        todo_wine ok(hr == DXGI_ERROR_INVALID_CALL, "Got unexpected hr %#lx.\n", hr);
+        ok(hr == DXGI_ERROR_INVALID_CALL, "Got unexpected hr %#lx.\n", hr);
         IDXGISwapChain3_Release(swapchain3);
     }
     else
