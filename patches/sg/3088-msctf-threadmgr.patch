+/* whether the modifier of a preserved key is as the key asks: any side, or a given one */
+static BOOL modifier_matches(UINT mods, UINT any, UINT left, UINT right, int vk_any, int vk_left, int vk_right)
+{
+    BOOL pressed = GetKeyState(vk_any) & 0x8000;
+
+    if (!(mods & (any | left | right))) return !pressed;
+    if ((mods & left) && !(GetKeyState(vk_left) & 0x8000)) return FALSE;
+    if ((mods & right) && !(GetKeyState(vk_right) & 0x8000)) return FALSE;
+    if ((mods & any) && !pressed) return FALSE;
+    return TRUE;
+}
+
+/* the preserved key that a key press or release is, if it is one */
+static PreservedKey *find_preserved_key(ThreadMgr *This, WPARAM vk, BOOL up)
+{
+    struct list *cursor;
+
+    LIST_FOR_EACH(cursor, &This->CurrentPreservedKeys)
+    {
+        PreservedKey *key = LIST_ENTRY(cursor, PreservedKey, entry);
+        UINT mods = key->prekey.uModifiers;
+
+        if (key->prekey.uVKey != vk) continue;
+        if (!!(mods & TF_MOD_ON_KEYUP) != !!up) continue;
+        if (!(mods & TF_MOD_IGNORE_ALL_MODIFIER) &&
+            (!modifier_matches(mods, TF_MOD_ALT, TF_MOD_LALT, TF_MOD_RALT, VK_MENU, VK_LMENU, VK_RMENU) ||
+             !modifier_matches(mods, TF_MOD_CONTROL, TF_MOD_LCONTROL, TF_MOD_RCONTROL, VK_CONTROL, VK_LCONTROL, VK_RCONTROL) ||
+             !modifier_matches(mods, TF_MOD_SHIFT, TF_MOD_LSHIFT, TF_MOD_RSHIFT, VK_SHIFT, VK_LSHIFT, VK_RSHIFT)))
+            continue;
+        return key;
+    }
+    return NULL;
+}
+
+/* the key goes to the preserved key it is, else to the text service in the foreground */
+static HRESULT keystroke_dispatch(ThreadMgr *This, WPARAM wParam, LPARAM lParam, BOOL up, BOOL test, BOOL *eaten)
+{
+    ITfContext *pic = NULL;
+    PreservedKey *key;
+    ITfKeyEventSink *sink;
+    HRESULT hr = S_OK;
+
+    if (!eaten)
+        return E_INVALIDARG;
+    *eaten = FALSE;
+
+    if (This->focus)
+        ITfDocumentMgr_GetTop(This->focus, &pic);
+
+#ifdef SG_MUTANT_NO_PRESERVED
+    if (0)
+#else
+    if ((key = find_preserved_key(This, wParam, up)))
+#endif
+    {
+        if (test)
+            *eaten = TRUE;
+        else if (SUCCEEDED(get_textservice_sink(key->tid, &IID_ITfKeyEventSink, (IUnknown **)&sink)) && sink)
+            hr = ITfKeyEventSink_OnPreservedKey(sink, pic, &key->guid, eaten);
+    }
+    else if ((sink = This->foregroundKeyEventSink))
+    {
+        if (test)
+            hr = up ? ITfKeyEventSink_OnTestKeyUp(sink, pic, wParam, lParam, eaten)
+                    : ITfKeyEventSink_OnTestKeyDown(sink, pic, wParam, lParam, eaten);
+        else
+            hr = up ? ITfKeyEventSink_OnKeyUp(sink, pic, wParam, lParam, eaten)
+                    : ITfKeyEventSink_OnKeyDown(sink, pic, wParam, lParam, eaten);
+    }
+
+    if (pic)
+        ITfContext_Release(pic);
+    return hr;
+}
