+typedef struct tagEnumUIElements
+{
+    IEnumTfUIElements IEnumTfUIElements_iface;
+    LONG refCount;
+
+    ITfUIElement **elements;
+    ULONG count, pos;
+} EnumUIElements;
+
+static inline EnumUIElements *impl_from_IEnumTfUIElements(IEnumTfUIElements *iface)
+{
+    return CONTAINING_RECORD(iface, EnumUIElements, IEnumTfUIElements_iface);
+}
+
+static HRESULT WINAPI EnumUIElements_QueryInterface(IEnumTfUIElements *iface, REFIID iid, void **ppvOut)
+{
+    *ppvOut = NULL;
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IEnumTfUIElements))
+    {
+        *ppvOut = iface;
+        IEnumTfUIElements_AddRef(iface);
+        return S_OK;
+    }
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EnumUIElements_AddRef(IEnumTfUIElements *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumTfUIElements(iface)->refCount);
+}
+
+static ULONG WINAPI EnumUIElements_Release(IEnumTfUIElements *iface)
+{
+    EnumUIElements *This = impl_from_IEnumTfUIElements(iface);
+    ULONG ret = InterlockedDecrement(&This->refCount);
+    ULONG i;
+
+    if (!ret)
+    {
+        for (i = 0; i < This->count; i++) ITfUIElement_Release(This->elements[i]);
+        free(This->elements);
+        free(This);
+    }
+    return ret;
+}
+
+static const IEnumTfUIElementsVtbl EnumUIElementsVtbl;
+
+static HRESULT EnumUIElements_Create(ITfUIElement **elements, ULONG count, ULONG pos, IEnumTfUIElements **ret)
+{
+    EnumUIElements *This;
+    ULONG i;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    if (count && !(This->elements = calloc(count, sizeof(*elements))))
+    {
+        free(This);
+        return E_OUTOFMEMORY;
+    }
+    This->IEnumTfUIElements_iface.lpVtbl = &EnumUIElementsVtbl;
+    This->refCount = 1;
+    This->count = count;
+    This->pos = pos;
+    for (i = 0; i < count; i++)
+    {
+        This->elements[i] = elements[i];
+        ITfUIElement_AddRef(elements[i]);
+    }
+    *ret = &This->IEnumTfUIElements_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumUIElements_Clone(IEnumTfUIElements *iface, IEnumTfUIElements **ret)
+{
+    EnumUIElements *This = impl_from_IEnumTfUIElements(iface);
+
+    if (!ret) return E_INVALIDARG;
+    return EnumUIElements_Create(This->elements, This->count, This->pos, ret);
+}
+
+static HRESULT WINAPI EnumUIElements_Next(IEnumTfUIElements *iface, ULONG count, ITfUIElement **element,
+                                          ULONG *fetched)
+{
+    EnumUIElements *This = impl_from_IEnumTfUIElements(iface);
+    ULONG n = 0;
+
+    if (!element || (!fetched && count != 1)) return E_INVALIDARG;
+    while (n < count && This->pos < This->count)
+    {
+        element[n] = This->elements[This->pos++];
+        ITfUIElement_AddRef(element[n]);
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumUIElements_Reset(IEnumTfUIElements *iface)
+{
+    impl_from_IEnumTfUIElements(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumUIElements_Skip(IEnumTfUIElements *iface, ULONG count)
+{
+    EnumUIElements *This = impl_from_IEnumTfUIElements(iface);
+
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static const IEnumTfUIElementsVtbl EnumUIElementsVtbl =
+{
+    EnumUIElements_QueryInterface,
+    EnumUIElements_AddRef,
+    EnumUIElements_Release,
+    EnumUIElements_Clone,
+    EnumUIElements_Next,
+    EnumUIElements_Reset,
+    EnumUIElements_Skip,
+};
