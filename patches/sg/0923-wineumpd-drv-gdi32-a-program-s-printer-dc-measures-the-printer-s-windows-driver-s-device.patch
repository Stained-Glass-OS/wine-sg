+ */
+
+/*
+ * A program's printer DC records the pages for the print processor; what it
+ * needs from the driver is the device's measurements, which the driver gave
+ * in its GDIINFO.  This driver answers GetDeviceCaps from them and leaves
+ * everything else (fonts included) to the layers below.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <pthread.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "ntgdi.h"
+#include "wine/gdi_driver.h"
+#include "wine/debug.h"
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(umpd);
+
+struct umpd_pdev
+{
+    struct gdi_physdev dev;
+    struct umpd_caps   caps;
+    BOOL               swapped;   /* turned since the caps were made */
+};
+
+static const struct gdi_dc_funcs umpd_funcs;
+
+/* the caps of the DC being created; set around NtGdiOpenDCW */
+static pthread_mutex_t open_lock = PTHREAD_MUTEX_INITIALIZER;
+static const struct umpd_caps *opening;
+
+static inline struct umpd_pdev *get_umpd_dev( PHYSDEV dev )
+{
+    return (struct umpd_pdev *)dev;
+}
+
+static BOOL create_dc( PHYSDEV *dev, const WCHAR *device, const WCHAR *output, const DEVMODEW *devmode )
+{
+    struct umpd_pdev *pdev;
+
+    if (!opening) return FALSE;
+    TRACE( "%s: %dx%d at %d dpi\n", debugstr_w(device), opening->horz_res, opening->vert_res, opening->log_x );
+    if (!(pdev = calloc( 1, sizeof(*pdev) ))) return FALSE;
+    pdev->caps = *opening;
+    push_dc_driver( dev, &pdev->dev, &umpd_funcs );
+    return TRUE;
+}
+
+static BOOL create_compatible_dc( PHYSDEV orig, PHYSDEV *dev )
+{
+    struct umpd_pdev *pdev, *src = get_umpd_dev( orig );
+
+    if (!(pdev = calloc( 1, sizeof(*pdev) ))) return FALSE;
+    pdev->caps = src->caps;
+    pdev->swapped = src->swapped;
+    push_dc_driver( dev, &pdev->dev, &umpd_funcs );
+    return TRUE;
+}
+
+static BOOL delete_dc( PHYSDEV dev )
+{
+    free( get_umpd_dev( dev ) );
+    return TRUE;
+}
+
+static INT get_device_caps( PHYSDEV dev, INT cap )
+{
+    struct umpd_pdev *pdev = get_umpd_dev( dev );
+    const struct umpd_caps *c = &pdev->caps;
+    BOOL sw = pdev->swapped;
+
+    switch (cap)
+    {
+    case DRIVERVERSION: return 0x600;
+    case TECHNOLOGY: return DT_RASPRINTER;
+    case HORZSIZE: return sw ? c->vert_size : c->horz_size;
+    case VERTSIZE: return sw ? c->horz_size : c->vert_size;
+    case HORZRES: return sw ? c->vert_res : c->horz_res;
+    case VERTRES: return sw ? c->horz_res : c->vert_res;
+    case LOGPIXELSX: return sw ? c->log_y : c->log_x;
+    case LOGPIXELSY: return sw ? c->log_x : c->log_y;
+    case PHYSICALWIDTH: return sw ? c->phys_h : c->phys_w;
+    case PHYSICALHEIGHT: return sw ? c->phys_w : c->phys_h;
+    case PHYSICALOFFSETX: return sw ? c->offset_y : c->offset_x;
+    case PHYSICALOFFSETY: return sw ? c->offset_x : c->offset_y;
+    case BITSPIXEL:
+        /* as with the PostScript driver: a compatible bitmap keeps its colours */
+        return 32;
+    case PLANES: return 1;
+    case NUMCOLORS: return -1;
+    case NUMPENS: return 10;
+    case NUMBRUSHES: return -1;
+    case NUMFONTS: return 0;
+    case NUMMARKERS: return 0;
+    case PDEVICESIZE: return sizeof(struct umpd_pdev);
+    case TEXTCAPS: return c->text_caps;
+    case RASTERCAPS: return c->raster_caps;
+    case ASPECTX: return c->aspect_x;
+    case ASPECTY: return c->aspect_y;
+    case ASPECTXY: return c->aspect_xy;
+    case CURVECAPS: return CC_CIRCLES | CC_PIE | CC_CHORD | CC_ELLIPSES | CC_WIDE | CC_STYLED |
+                           CC_WIDESTYLED | CC_INTERIORS | CC_ROUNDRECT;
+    case LINECAPS: return LC_POLYLINE | LC_MARKER | LC_POLYMARKER | LC_WIDE | LC_STYLED | LC_WIDESTYLED |
+                          LC_INTERIORS;
+    case POLYGONALCAPS: return PC_POLYGON | PC_RECTANGLE | PC_WINDPOLYGON | PC_SCANLINE | PC_WIDE |
+                               PC_STYLED | PC_WIDESTYLED | PC_INTERIORS;
+    case CLIPCAPS: return CP_RECTANGLE;
+    case SHADEBLENDCAPS: return SB_NONE;
+    case COLORRES: return 0;
+    case NUMRESERVED: return 0;
+    case SCALINGFACTORX: case SCALINGFACTORY: return 0;
+    case VREFRESH: case DESKTOPHORZRES: case DESKTOPVERTRES: case BLTALIGNMENT: return 0;
+    }
+    dev = GET_NEXT_PHYSDEV( dev, pGetDeviceCaps );
+    return dev->funcs->pGetDeviceCaps( dev, cap );
+}
+
+static BOOL reset_dc( PHYSDEV dev, const DEVMODEW *devmode )
+{
+    struct umpd_pdev *pdev = get_umpd_dev( dev );
+
+    /* only a change of orientation is followed without the driver */
+    if (devmode && (devmode->dmFields & DM_ORIENTATION))
+        pdev->swapped = (devmode->dmOrientation == DMORIENT_LANDSCAPE) !=
+                        (pdev->caps.orientation == DMORIENT_LANDSCAPE);
+    return TRUE;
+}
+
+static INT ext_escape( PHYSDEV dev, INT escape, INT in_size, const void *in, INT out_size, void *out )
+{
+    switch (escape)
+    {
+    case QUERYESCSUPPORT:
+        if (in && in_size >= sizeof(DWORD))
+        {
+            DWORD code = *(const DWORD *)in;
+            return code == QUERYESCSUPPORT || code == GETPHYSPAGESIZE || code == GETPRINTINGOFFSET ||
+                   code == STARTDOC || code == ENDDOC || code == NEWFRAME || code == ABORTDOC ||
+                   code == SETCOPYCOUNT;
+        }
+        return 0;
+    case SETCOPYCOUNT:
+        if (out && out_size >= sizeof(DWORD)) *(DWORD *)out = in && in_size >= sizeof(DWORD) ? *(const DWORD *)in : 1;
+        return 1;
+    }
+    dev = GET_NEXT_PHYSDEV( dev, pExtEscape );
+    return dev->funcs->pExtEscape( dev, escape, in_size, in, out_size, out );
+}
+
+static INT start_doc( PHYSDEV dev, const DOCINFOW *doc ) { return 1; }
+static INT end_doc( PHYSDEV dev ) { return 1; }
+static INT start_page( PHYSDEV dev ) { return 1; }
+static INT end_page( PHYSDEV dev ) { return 1; }
+static INT abort_doc( PHYSDEV dev ) { return 1; }
+
+static const struct gdi_dc_funcs umpd_funcs =
+{
+    .pAbortDoc = abort_doc,
+    .pCreateCompatibleDC = create_compatible_dc,
+    .pCreateDC = create_dc,
+    .pDeleteDC = delete_dc,
+    .pEndDoc = end_doc,
+    .pEndPage = end_page,
+    .pExtEscape = ext_escape,
+    .pGetDeviceCaps = get_device_caps,
+    .pResetDC = reset_dc,
+    .pStartDoc = start_doc,
+    .pStartPage = start_page,
+    .priority = GDI_PRIORITY_GRAPHICS_DRV
+};
+
+static NTSTATUS open_dc( void *arg )
+{
+    struct open_dc_params *params = arg;
+    UNICODE_STRING device_str, output_str;
+
+    device_str.Length = device_str.MaximumLength = lstrlenW( params->device ) * sizeof(WCHAR);
+    device_str.Buffer = (WCHAR *)params->device;
+    if (params->output)
+    {
+        output_str.Length = output_str.MaximumLength = lstrlenW( params->output ) * sizeof(WCHAR);
+        output_str.Buffer = (WCHAR *)params->output;
+    }
+    pthread_mutex_lock( &open_lock );
+    opening = params->caps;
+    params->hdc = NtGdiOpenDCW( &device_str, params->devmode, params->output ? &output_str : NULL,
+                                WINE_GDI_DRIVER_VERSION, 0, (HANDLE)&umpd_funcs, NULL, NULL );
+    opening = NULL;
+    pthread_mutex_unlock( &open_lock );
+    return params->hdc != 0;
+}
