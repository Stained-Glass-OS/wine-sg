+        PTR32 device;
+        PTR32 devmode;
+        PTR32 output;
+        PTR32 caps;
+        PTR32 hdc;
+    } *params32 = args;
+    struct open_dc_params params =
+    {
+        ULongToPtr( params32->device ), ULongToPtr( params32->devmode ), ULongToPtr( params32->output ),
+        ULongToPtr( params32->caps ), 0
