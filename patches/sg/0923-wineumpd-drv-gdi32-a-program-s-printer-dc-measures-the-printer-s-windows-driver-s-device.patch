+/* a printer whose driver is a printer graphics DLL (the maker's own, or
+ * Unidrv) is opened through the host for such drivers, not the PostScript
+ * driver */
+static void get_printer_driver_module( const WCHAR *device, WCHAR *module, DWORD size )
+{
+    DRIVER_INFO_3W *info;
+    const WCHAR *base;
+    HANDLE printer;
+    DWORD needed = 0;
+
+#ifdef SG_MUTANT_UMPDDC
+    return;
+#endif
+    if (wcsicmp( module, L"wineps.drv" ) && wcsicmp( module, L"winspool" )) return;
+    if (!OpenPrinterW( (WCHAR *)device, &printer, NULL )) return;
+    GetPrinterDriverW( printer, NULL, 3, NULL, 0, &needed );
+    if (needed && (info = HeapAlloc( GetProcessHeap(), 0, needed )))
+    {
+        if (GetPrinterDriverW( printer, NULL, 3, (BYTE *)info, needed, &needed ) && info->pDriverPath)
+        {
+            base = wcsrchr( info->pDriverPath, '\\' );
+            base = base ? base + 1 : info->pDriverPath;
+            if (wcsicmp( base, L"wineps.drv" ) && wcsicmp( base, L"wineps16.drv" ))
+            {
+                TRACE( "%s: driver %s\n", debugstr_w(device), debugstr_w(info->pDriverPath) );
+                lstrcpynW( module, L"wineumpd.drv", size );
+            }
+        }
+        HeapFree( GetProcessHeap(), 0, info );
+    }
+    ClosePrinter( printer );
+}
+
