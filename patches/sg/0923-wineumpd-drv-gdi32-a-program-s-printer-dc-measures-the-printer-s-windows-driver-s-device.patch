+/*
+ * gdi32 opens a DC through us for a printer whose driver is a printer
+ * graphics DLL rather than our PostScript driver.  We ask the driver what the
+ * device measures (DrvEnablePDEV fills a GDIINFO), as GDI does, and make a DC
+ * that answers with those measurements.  The drawing itself is recorded by
+ * gdi32 for the print processor, which runs the driver again for output.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winspool.h"
+#include "ddk/winddi.h"
+#include "wine/printdrv.h"
+#include "wine/debug.h"
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(umpd);
+
+static BOOL get_caps( const WCHAR *device, const DEVMODEW *devmode, struct umpd_caps *caps )
+{
+    BOOL (WINAPI *enable_driver)( ULONG, ULONG, DRVENABLEDATA * );
+    void (WINAPI *disable_driver)( void );
+    DHPDEV (WINAPI *enable_pdev)( DEVMODEW *, WCHAR *, ULONG, HSURF *, ULONG, ULONG *, ULONG, DEVINFO *,
+                                  HDEV, WCHAR *, HANDLE ) = NULL;
+    void (WINAPI *disable_pdev)( DHPDEV ) = NULL;
+    struct wine_eng_device dev;
+    DRIVER_INFO_3W *info = NULL;
+    DRVENABLEDATA ded;
+    GDIINFO gi;
+    DEVINFO di;
+    HMODULE module = NULL;
+    HANDLE printer;
+    DWORD needed = 0;
+    DHPDEV dhpdev;
+    BOOL ret = FALSE;
+    ULONG i;
+
+    if (!OpenPrinterW( (WCHAR *)device, &printer, NULL )) return FALSE;
+    GetPrinterDriverW( printer, NULL, 3, NULL, 0, &needed );
+    if (!needed || !(info = malloc( needed )) ||
+        !GetPrinterDriverW( printer, NULL, 3, (BYTE *)info, needed, &needed ) || !info->pDriverPath)
+        goto done;
+    if (!(module = LoadLibraryW( info->pDriverPath )))
+    {
+        const WCHAR *base = wcsrchr( info->pDriverPath, '\\' );
+        module = LoadLibraryW( base ? base + 1 : info->pDriverPath );
+    }
+    if (!module)
+    {
+        WARN( "cannot load %s\n", debugstr_w(info->pDriverPath) );
+        goto done;
+    }
+    enable_driver = (void *)GetProcAddress( module, "DrvEnableDriver" );
+    disable_driver = (void *)GetProcAddress( module, "DrvDisableDriver" );
+    memset( &ded, 0, sizeof(ded) );
+    if (!enable_driver || !enable_driver( DDI_DRIVER_VERSION_NT5_01, sizeof(ded), &ded )) goto done;
+    for (i = 0; i < ded.c; i++)
+    {
+        if (ded.pdrvfn[i].iFunc == INDEX_DrvEnablePDEV) enable_pdev = (void *)ded.pdrvfn[i].pfn;
+        if (ded.pdrvfn[i].iFunc == INDEX_DrvDisablePDEV) disable_pdev = (void *)ded.pdrvfn[i].pfn;
+    }
+    if (!enable_pdev) goto done;
+
+    memset( &dev, 0, sizeof(dev) );
+    dev.magic = WINE_ENG_DEVICE_MAGIC;
+    dev.printer = printer;
+    memset( &gi, 0, sizeof(gi) );
+    memset( &di, 0, sizeof(di) );
+    dhpdev = enable_pdev( (DEVMODEW *)devmode, (WCHAR *)device, 0, NULL, sizeof(gi), (ULONG *)&gi, sizeof(di), &di,
+                          (HDEV)&dev, (WCHAR *)device, printer );
+    if (dhpdev)
+    {
+        caps->horz_size = gi.ulHorzSize;
+        caps->vert_size = gi.ulVertSize;
+        caps->horz_res = gi.ulHorzRes;
+        caps->vert_res = gi.ulVertRes;
+        caps->log_x = gi.ulLogPixelsX;
+        caps->log_y = gi.ulLogPixelsY;
+        caps->phys_w = gi.szlPhysSize.cx;
+        caps->phys_h = gi.szlPhysSize.cy;
+        caps->offset_x = gi.ptlPhysOffset.x;
+        caps->offset_y = gi.ptlPhysOffset.y;
+        caps->bits_pixel = gi.cBitsPixel * gi.cPlanes;
+        caps->num_colors = gi.ulNumColors;
+        caps->text_caps = gi.flTextCaps;
+        caps->raster_caps = gi.flRaster | RC_GDI20_OUTPUT;
+        caps->aspect_x = gi.ulAspectX;
+        caps->aspect_y = gi.ulAspectY;
+        caps->aspect_xy = gi.ulAspectXY;
+        caps->orientation = devmode && (devmode->dmFields & DM_ORIENTATION) ? devmode->dmOrientation : DMORIENT_PORTRAIT;
+        /* a negative size is in micrometres */
+        if ((LONG)gi.ulHorzSize < 0) caps->horz_size = -(LONG)gi.ulHorzSize / 1000;
+        if ((LONG)gi.ulVertSize < 0) caps->vert_size = -(LONG)gi.ulVertSize / 1000;
+        TRACE( "%s: %dx%d at %dx%d dpi, sheet %dx%d, offset %d,%d\n", debugstr_w(device), caps->horz_res,
+               caps->vert_res, caps->log_x, caps->log_y, caps->phys_w, caps->phys_h, caps->offset_x,
+               caps->offset_y );
+        if (disable_pdev) disable_pdev( dhpdev );
+        ret = caps->horz_res > 0 && caps->vert_res > 0 && caps->log_x > 0 && caps->log_y > 0;
+    }
+    if (disable_driver) disable_driver();
+
+done:
+    if (module) FreeLibrary( module );
+    free( info );
+    ClosePrinter( printer );
+    return ret;
+}
+
+/* a 32-bit program and a 64-bit driver: our 64-bit host measures */
+static BOOL get_caps_from_host( const WCHAR *device, const DEVMODEW *devmode, struct umpd_caps *caps )
+{
+    WCHAR dir[MAX_PATH], dm_file[MAX_PATH], out_file[MAX_PATH], host[MAX_PATH], *cmd;
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    DWORD code = 1, w;
+    HANDLE file;
+    char buf[512];
+    BOOL wow64 = FALSE, ret = FALSE;
+    size_t len;
+    long v[17];
+
+    if (!IsWow64Process( GetCurrentProcess(), &wow64 ) || !wow64) return FALSE;
+    GetTempPathW( MAX_PATH, dir );
+    if (!GetTempFileNameW( dir, L"sdm", 0, dm_file )) return FALSE;
+    if (!GetTempFileNameW( dir, L"scp", 0, out_file ))
+    {
+        DeleteFileW( dm_file );
+        return FALSE;
+    }
+    file = CreateFileW( dm_file, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        if (devmode) WriteFile( file, devmode, devmode->dmSize + devmode->dmDriverExtra, &w, NULL );
+        CloseHandle( file );
+    }
+    GetWindowsDirectoryW( host, MAX_PATH );
+    lstrcatW( host, L"\\sysnative\\splwow64.exe" );
+    len = wcslen( host ) + wcslen( device ) + wcslen( dm_file ) + wcslen( out_file ) + 32;
+    cmd = malloc( len * sizeof(WCHAR) );
+    swprintf( cmd, len, L"\"%s\" caps \"%s\" \"%s\" \"%s\"", host, device, dm_file, out_file );
+    if (CreateProcessW( host, cmd, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi ))
+    {
+        WaitForSingleObject( pi.hProcess, INFINITE );
+        GetExitCodeProcess( pi.hProcess, &code );
+        CloseHandle( pi.hProcess );
+        CloseHandle( pi.hThread );
+    }
+    free( cmd );
+    file = CreateFileW( out_file, GENERIC_READ, 0, NULL, OPEN_EXISTING, 0, NULL );
+    if (!code && file != INVALID_HANDLE_VALUE)
+    {
+        DWORD got = 0;
+        ReadFile( file, buf, sizeof(buf) - 1, &got, NULL );
+        buf[got] = 0;
+        if (sscanf( buf, "%ld %ld %ld %ld %ld %ld %ld %ld %ld %ld %ld %ld %ld %ld %ld %ld %ld", &v[0], &v[1], &v[2],
+                    &v[3], &v[4], &v[5], &v[6], &v[7], &v[8], &v[9], &v[10], &v[11], &v[12], &v[13], &v[14],
+                    &v[15], &v[16] ) == 17)
+        {
+            caps->horz_size = v[0] < 0 ? -v[0] / 1000 : v[0];
+            caps->vert_size = v[1] < 0 ? -v[1] / 1000 : v[1];
+            caps->horz_res = v[2];
+            caps->vert_res = v[3];
+            caps->log_x = v[4];
+            caps->log_y = v[5];
+            caps->phys_w = v[6];
+            caps->phys_h = v[7];
+            caps->offset_x = v[8];
+            caps->offset_y = v[9];
+            caps->bits_pixel = v[10];
+            caps->num_colors = v[11];
+            caps->text_caps = v[12];
+            caps->raster_caps = v[13] | RC_GDI20_OUTPUT;
+            caps->aspect_x = v[14];
+            caps->aspect_y = v[15];
+            caps->aspect_xy = v[16];
+            caps->orientation = devmode && (devmode->dmFields & DM_ORIENTATION) ? devmode->dmOrientation
+                                                                                 : DMORIENT_PORTRAIT;
+            ret = caps->horz_res > 0 && caps->vert_res > 0 && caps->log_x > 0 && caps->log_y > 0;
+        }
+    }
+    if (file != INVALID_HANDLE_VALUE) CloseHandle( file );
+    DeleteFileW( dm_file );
+    DeleteFileW( out_file );
+    TRACE( "%s from the 64-bit host: %d\n", debugstr_w(device), ret );
+    return ret;
+}
+
+/******************************************************************************
+ *      umpd_open_dc
+ */
+HDC CDECL umpd_open_dc( const WCHAR *device, const DEVMODEW *devmode, const WCHAR *output )
+{
+    struct open_dc_params params;
+    struct umpd_caps caps;
+
+    TRACE( "%s %p %s\n", debugstr_w(device), devmode, debugstr_w(output) );
+    if (!device) return 0;
+    memset( &caps, 0, sizeof(caps) );
+    if (!get_caps( device, devmode, &caps ) && !get_caps_from_host( device, devmode, &caps ))
+    {
+        WARN( "the driver of %s gave no device measurements\n", debugstr_w(device) );
+        return 0;
+    }
+    params.device = device;
+    params.devmode = devmode;
+    params.output = output;
+    params.caps = &caps;
+    params.hdc = 0;
+    if (!WINE_UNIX_CALL( unix_open_dc, &params )) return 0;
+    return params.hdc;
+}
+
+BOOL WINAPI DllMain( HINSTANCE instance, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls( instance );
+        if (__wine_init_unix_call()) return FALSE;
+    }
+    return TRUE;
+}
