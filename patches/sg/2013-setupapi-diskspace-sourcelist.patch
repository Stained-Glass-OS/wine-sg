+/***********************************************************************
+*		SetupRemoveFromDiskSpaceListW  (SETUPAPI.@)
+*/
+BOOL WINAPI SetupRemoveFromDiskSpaceListW(HDSKSPC diskspace, PCWSTR targetfile, UINT operation,
+                                          PVOID reserved1, UINT reserved2)
+{
+    DISKSPACELIST *list = diskspace;
+    WCHAR full[MAX_PATH];
+    struct file_entry *entry;
+
+    TRACE("(%p, %s, %u, %p, %u)\n", diskspace, debugstr_w(targetfile), operation, reserved1, reserved2);
+
+    if (!diskspace)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!targetfile || reserved1 || reserved2 || (operation != FILEOP_COPY && operation != FILEOP_DELETE))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!disk_space_path(targetfile, full) || !(entry = find_entry(list, full, operation)))
+    {
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return FALSE;
+    }
+    drop_entry(list, entry);
+    return TRUE;
+}
+
+/***********************************************************************
+*		SetupRemoveFromDiskSpaceListA  (SETUPAPI.@)
+*/
+BOOL WINAPI SetupRemoveFromDiskSpaceListA(HDSKSPC diskspace, PCSTR targetfile, UINT operation,
+                                          PVOID reserved1, UINT reserved2)
+{
+    WCHAR *file = NULL;
+    BOOL ret;
+
+    if (targetfile)
+    {
+        DWORD len = MultiByteToWideChar(CP_ACP, 0, targetfile, -1, NULL, 0);
+        if (!(file = malloc(len * sizeof(WCHAR))))
+        {
+            SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+            return FALSE;
+        }
+        MultiByteToWideChar(CP_ACP, 0, targetfile, -1, file, len);
+    }
+    ret = SetupRemoveFromDiskSpaceListW(diskspace, file, operation, reserved1, reserved2);
+    free(file);
+    return ret;
+}
+
+/***********************************************************************
+*		SetupQueryDrivesInDiskSpaceListW  (SETUPAPI.@)
+*
+* The drives of the list as "X:" strings, one after the other, ended by an
+* extra NUL.
+*/
+BOOL WINAPI SetupQueryDrivesInDiskSpaceListW(HDSKSPC diskspace, PWSTR buffer, DWORD size, PDWORD required)
+{
+    DISKSPACELIST *list = diskspace;
+    DWORD i, needed = 1;
+
+    TRACE("(%p, %p, %lu, %p)\n", diskspace, buffer, size, required);
+
+    if (!diskspace)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    needed += list->dwDriveCount * 3;
+    if (!list->dwDriveCount) needed++;
+#ifdef SG_MUTANT_DRIVES_SIZE
+    needed--;
+#endif
+    if (required) *required = needed;
+    if (buffer && size >= needed)
+    {
+        for (i = 0; i < list->dwDriveCount; i++)
+        {
+            buffer[i * 3] = list->Drives[i].lpzName[0];
+            buffer[i * 3 + 1] = ':';
+            buffer[i * 3 + 2] = 0;
+        }
+        buffer[list->dwDriveCount * 3] = 0;
+        if (!list->dwDriveCount) buffer[0] = buffer[1] = 0;
+        return TRUE;
+    }
+    if (!buffer && !size) return TRUE;   /* only the size asked for */
+    SetLastError(ERROR_INSUFFICIENT_BUFFER);
     return FALSE;
 }
 
