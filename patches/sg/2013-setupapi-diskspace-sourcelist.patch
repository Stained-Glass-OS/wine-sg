+/*
+ * Setup source lists: where Setup looks for installation files
+ *
+ * Stained Glass OS. The persistent lists are the "Installation Sources"
+ * multi-string value of the setup key, in HKLM (the system list) or HKCU
+ * (the user list); a temporary list lives in the process.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <wchar.h>
+#include <wctype.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "winnls.h"
+#include "setupapi.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(setupapi);
+
+#define SRCLIST_TEMPORARY 0x00000001
+#define SRCLIST_NOBROWSE  0x00000002
+#define SRCLIST_SYSTEM    0x00000010
+#define SRCLIST_USER      0x00000020
+#define SRCLIST_SYSIFADMIN 0x00000040
+#define SRCLIST_SUBDIRS   0x00000100
+#define SRCLIST_APPEND    0x00000200
+#define SRCLIST_NOSTRIPPLATFORM 0x00000400
+
+#define SRCLIST_KNOWN (SRCLIST_TEMPORARY | SRCLIST_NOBROWSE | SRCLIST_SYSTEM | SRCLIST_USER | \
+                       SRCLIST_SYSIFADMIN | SRCLIST_SUBDIRS | SRCLIST_APPEND | SRCLIST_NOSTRIPPLATFORM)
+#define SRCLIST_WHERE (SRCLIST_TEMPORARY | SRCLIST_SYSTEM | SRCLIST_USER | SRCLIST_SYSIFADMIN)
+
+static const WCHAR setup_key[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Setup";
+static const WCHAR sources_value[] = L"Installation Sources";
+
+static CRITICAL_SECTION source_cs;
+static CRITICAL_SECTION_DEBUG source_cs_debug =
+{
+    0, 0, &source_cs,
+    { &source_cs_debug.ProcessLocksList, &source_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": source_cs") }
+};
+static CRITICAL_SECTION source_cs = { &source_cs_debug, -1, 0, 0, 0, 0 };
+
+/* a list of strings in one block: count strings, the block is a multi-string */
+struct string_list { WCHAR *data; UINT count; SIZE_T chars; };
+
+static WCHAR *temporary_data;   /* multi-string of the temporary list */
+static UINT temporary_count;
+static SIZE_T temporary_chars;
+
+static void list_free( struct string_list *list ) { free( list->data ); memset( list, 0, sizeof(*list) ); }
+
+static BOOL list_contains( const struct string_list *list, const WCHAR *source )
+{
+    const WCHAR *p = list->data;
+    UINT i;
+    for (i = 0; i < list->count; i++, p += wcslen( p ) + 1)
+        if (!wcsicmp( p, source )) return TRUE;
+    return FALSE;
+}
+
+static BOOL list_append( struct string_list *list, const WCHAR *source )
+{
+    SIZE_T len = wcslen( source ) + 1;
+    WCHAR *data = realloc( list->data, (list->chars + len + 1) * sizeof(WCHAR) );
+    if (!data) return FALSE;
+    memcpy( data + list->chars, source, len * sizeof(WCHAR) );
+    list->chars += len;
+    data[list->chars] = 0;
+    list->data = data;
+    list->count++;
+    return TRUE;
+}
+
+static BOOL is_admin(void)
+{
+    SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    PSID admins;
+    BOOL member = FALSE;
+
+    if (!AllocateAndInitializeSid( &nt, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS, 0, 0, 0, 0, 0, 0, &admins ))
+        return FALSE;
+    if (!CheckTokenMembership( NULL, admins, &member )) member = FALSE;
+    FreeSid( admins );
+    return member;
+}
+
+/* which list a persistent request names: HKLM, HKCU, or NULL for the temporary one */
+static BOOL source_root( DWORD flags, HKEY *root, BOOL *temporary )
+{
+    *temporary = FALSE;
+    if (flags & SRCLIST_TEMPORARY) { *temporary = TRUE; return TRUE; }
+    if (flags & SRCLIST_SYSTEM) { *root = HKEY_LOCAL_MACHINE; return TRUE; }
+    if (flags & SRCLIST_USER) { *root = HKEY_CURRENT_USER; return TRUE; }
+    if (flags & SRCLIST_SYSIFADMIN) { *root = is_admin() ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER; return TRUE; }
+    return FALSE;
+}
+
+static void registry_list_read( HKEY root, struct string_list *list )
+{
+    DWORD type, size = 0;
+    HKEY key;
+    WCHAR *data;
+
+    memset( list, 0, sizeof(*list) );
+    if (RegOpenKeyExW( root, setup_key, 0, KEY_READ, &key )) return;
+    if (!RegQueryValueExW( key, sources_value, NULL, &type, NULL, &size ) && type == REG_MULTI_SZ && size >= sizeof(WCHAR) &&
+        (data = malloc( size + 2 * sizeof(WCHAR) )))
+    {
+        if (!RegQueryValueExW( key, sources_value, NULL, &type, (BYTE *)data, &size ))
+        {
+            const WCHAR *p;
+            data[size / sizeof(WCHAR)] = 0;
+            data[size / sizeof(WCHAR) + 1] = 0;
+            for (p = data; *p; p += wcslen( p ) + 1) list_append( list, p );
+        }
+        free( data );
+    }
+    RegCloseKey( key );
+}
+
+static LONG registry_list_write( HKEY root, const struct string_list *list )
+{
+    static const WCHAR empty[2] = {0};
+    HKEY key;
+    LONG ret;
+
+    if ((ret = RegCreateKeyExW( root, setup_key, 0, NULL, 0, KEY_WRITE, NULL, &key, NULL ))) return ret;
+    if (list->count) ret = RegSetValueExW( key, sources_value, 0, REG_MULTI_SZ, (const BYTE *)list->data, (list->chars + 1) * sizeof(WCHAR) );
+    else ret = RegSetValueExW( key, sources_value, 0, REG_MULTI_SZ, (const BYTE *)empty, sizeof(empty) );
+    RegCloseKey( key );
+    return ret;
+}
+
+static void temporary_get( struct string_list *list )
+{
+    memset( list, 0, sizeof(*list) );
+    if (temporary_count && (list->data = malloc( (temporary_chars + 1) * sizeof(WCHAR) )))
+    {
+        memcpy( list->data, temporary_data, (temporary_chars + 1) * sizeof(WCHAR) );
+        list->count = temporary_count;
+        list->chars = temporary_chars;
+    }
+}
+
+static void temporary_set( struct string_list *list )
+{
+    free( temporary_data );
+    temporary_data = list->data;
+    temporary_count = list->count;
+    temporary_chars = list->chars;
+    list->data = NULL;
+}
+
+/***********************************************************************
+ *      SetupAddToSourceListW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupAddToSourceListW( DWORD flags, PCWSTR source )
+{
+    struct string_list list;
+    HKEY root = NULL;
+    BOOL temporary, ok = TRUE;
+    LONG err = 0;
+
+    TRACE( "0x%08lx %s\n", flags, debugstr_w( source ) );
+
+    if ((flags & ~SRCLIST_KNOWN) || !(flags & SRCLIST_WHERE) || !source || !*source)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    source_root( flags, &root, &temporary );
+
+    EnterCriticalSection( &source_cs );
+    if (temporary) temporary_get( &list ); else registry_list_read( root, &list );
+    if (!list_contains( &list, source ))
+    {
+#ifdef SG_MUTANT_SOURCE_NO_ADD
+        ok = TRUE;
+#else
+        ok = list_append( &list, source );
+#endif
+        if (!ok) err = ERROR_NOT_ENOUGH_MEMORY;
+        else if (temporary) temporary_set( &list );
+        else err = registry_list_write( root, &list );
+    }
+    LeaveCriticalSection( &source_cs );
+    list_free( &list );
+    if (err) SetLastError( err );
+    return !err;
+}
+
+/***********************************************************************
+ *      SetupAddToSourceListA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupAddToSourceListA( DWORD flags, PCSTR source )
+{
+    WCHAR *sourceW = NULL;
+    BOOL ret;
+
+    if (source)
+    {
+        DWORD len = MultiByteToWideChar( CP_ACP, 0, source, -1, NULL, 0 );
+        if (!(sourceW = malloc( len * sizeof(WCHAR) ))) { SetLastError( ERROR_NOT_ENOUGH_MEMORY ); return FALSE; }
+        MultiByteToWideChar( CP_ACP, 0, source, -1, sourceW, len );
+    }
+    ret = SetupAddToSourceListW( flags, sourceW );
+    free( sourceW );
+    return ret;
+}
+
+/***********************************************************************
+ *      SetupSetSourceListW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupSetSourceListW( DWORD flags, PCWSTR *sources, UINT count )
+{
+    struct string_list list = {0};
+    HKEY root = NULL;
+    BOOL temporary;
+    LONG err = 0;
+    UINT i;
+
+    TRACE( "0x%08lx %p %u\n", flags, sources, count );
+
+    if ((flags & ~SRCLIST_KNOWN) || !(flags & SRCLIST_WHERE) || (count && !sources))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (!sources[i] || !*sources[i] || (!list_contains( &list, sources[i] ) && !list_append( &list, sources[i] )))
+        {
+            list_free( &list );
+            SetLastError( sources[i] && *sources[i] ? ERROR_NOT_ENOUGH_MEMORY : ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+    }
+    source_root( flags, &root, &temporary );
+
+    EnterCriticalSection( &source_cs );
+#ifdef SG_MUTANT_SOURCE_SET_APPEND
+    if (!temporary)
+    {
+        struct string_list old;
+        UINT n;
+        const WCHAR *q;
+        registry_list_read( root, &old );
+        for (q = list.data, n = 0; n < list.count; n++, q += wcslen( q ) + 1)
+            if (!list_contains( &old, q )) list_append( &old, q );
+        list_free( &list );
+        list = old;
+    }
+#endif
+    if (temporary) temporary_set( &list ); else err = registry_list_write( root, &list );
+    LeaveCriticalSection( &source_cs );
+    list_free( &list );
+    if (err) SetLastError( err );
+    return !err;
+}
+
+/***********************************************************************
+ *      SetupSetSourceListA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupSetSourceListA( DWORD flags, PCSTR *sources, UINT count )
+{
+    WCHAR **list = NULL;
+    BOOL ret;
+    UINT i;
+
+    if (count && sources)
+    {
+        if (!(list = calloc( count, sizeof(*list) ))) { SetLastError( ERROR_NOT_ENOUGH_MEMORY ); return FALSE; }
+        for (i = 0; i < count; i++)
+        {
+            DWORD len;
+            if (!sources[i]) continue;
+            len = MultiByteToWideChar( CP_ACP, 0, sources[i], -1, NULL, 0 );
+            if (!(list[i] = malloc( len * sizeof(WCHAR) ))) break;
+            MultiByteToWideChar( CP_ACP, 0, sources[i], -1, list[i], len );
+        }
+        if (i < count)
+        {
+            while (i--) free( list[i] );
+            free( list );
+            SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+            return FALSE;
+        }
+    }
+    ret = SetupSetSourceListW( flags, (PCWSTR *)list, count );
+    for (i = 0; list && i < count; i++) free( list[i] );
+    free( list );
+    return ret;
+}
+
+/***********************************************************************
+ *      SetupQuerySourceListW (SETUPAPI.@)
+ *
+ * The temporary list if asked for, then the user list, then the system list,
+ * each source once, as pointers into one block that SetupFreeSourceList frees.
+ */
+BOOL WINAPI SetupQuerySourceListW( DWORD flags, PCWSTR **list, PUINT count )
+{
+    struct string_list all = {0}, part;
+    PCWSTR *result;
+    WCHAR *text;
+    UINT i;
+    SIZE_T size;
+    const WCHAR *p;
+
+    TRACE( "0x%08lx %p %p\n", flags, list, count );
+
+    if ((flags & ~SRCLIST_KNOWN) || !(flags & SRCLIST_WHERE) || !list || !count)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    EnterCriticalSection( &source_cs );
+    if (flags & SRCLIST_TEMPORARY)
+    {
+        temporary_get( &part );
+        for (p = part.data, i = 0; i < part.count; i++, p += wcslen( p ) + 1)
+            if (!list_contains( &all, p )) list_append( &all, p );
+        list_free( &part );
+    }
+    if ((flags & SRCLIST_USER) || ((flags & SRCLIST_SYSIFADMIN) && !is_admin()))
+    {
+        registry_list_read( HKEY_CURRENT_USER, &part );
+        for (p = part.data, i = 0; i < part.count; i++, p += wcslen( p ) + 1)
+            if (!list_contains( &all, p )) list_append( &all, p );
+        list_free( &part );
+    }
+    if ((flags & SRCLIST_SYSTEM) || ((flags & SRCLIST_SYSIFADMIN) && is_admin()))
+    {
+        registry_list_read( HKEY_LOCAL_MACHINE, &part );
+        for (p = part.data, i = 0; i < part.count; i++, p += wcslen( p ) + 1)
+            if (!list_contains( &all, p )) list_append( &all, p );
+        list_free( &part );
+    }
+    LeaveCriticalSection( &source_cs );
+
+    size = all.count * sizeof(PCWSTR) + (all.chars + 1) * sizeof(WCHAR);
+    if (!(result = malloc( size )))
+    {
+        list_free( &all );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    text = (WCHAR *)(result + all.count);
+    if (all.chars) memcpy( text, all.data, all.chars * sizeof(WCHAR) );
+    text[all.chars] = 0;
+    for (p = text, i = 0; i < all.count; i++, p += wcslen( p ) + 1) result[i] = p;
+    *list = result;
+    *count = all.count;
+    list_free( &all );
+    return TRUE;
+}
+
+/***********************************************************************
+ *      SetupQuerySourceListA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupQuerySourceListA( DWORD flags, PCSTR **list, PUINT count )
+{
+    PCWSTR *wide;
+    PCSTR *result;
+    UINT n, i;
+    SIZE_T chars = 0;
+    char *text;
+
+    if (!SetupQuerySourceListW( flags, &wide, &n )) return FALSE;
+    for (i = 0; i < n; i++) chars += WideCharToMultiByte( CP_ACP, 0, wide[i], -1, NULL, 0, NULL, NULL );
+    if (!(result = malloc( n * sizeof(PCSTR) + chars + 1 )))
+    {
+        SetupFreeSourceListW( &wide, n );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    text = (char *)(result + n);
+    for (i = 0; i < n; i++)
+    {
+        result[i] = text;
+        text += WideCharToMultiByte( CP_ACP, 0, wide[i], -1, text, chars, NULL, NULL );
+    }
+    *text = 0;
+    SetupFreeSourceListW( &wide, n );
+    *list = result;
+    *count = n;
+    return TRUE;
+}
+
+/***********************************************************************
+ *      SetupFreeSourceListW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupFreeSourceListW( PCWSTR **list, UINT count )
+{
+    TRACE( "%p %u\n", list, count );
+
+    if (!list)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    free( *list );
+    *list = NULL;
+    return TRUE;
+}
+
+/***********************************************************************
+ *      SetupFreeSourceListA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupFreeSourceListA( PCSTR **list, UINT count )
+{
+    TRACE( "%p %u\n", list, count );
+
+    if (!list)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    free( *list );
+    *list = NULL;
+    return TRUE;
+}
+
+/***********************************************************************
+ *      SetupCancelTemporarySourceList (SETUPAPI.@)
+ */
+BOOL WINAPI SetupCancelTemporarySourceList(void)
+{
+    TRACE( "\n" );
+    EnterCriticalSection( &source_cs );
+    free( temporary_data );
+    temporary_data = NULL;
+    temporary_count = 0;
+    temporary_chars = 0;
+    LeaveCriticalSection( &source_cs );
+    return TRUE;
+}
