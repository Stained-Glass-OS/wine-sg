+/* the drive entry that holds a path, by its letter; NULL for a path without one */
+static int find_drive(const DISKSPACELIST *list, const WCHAR *path)
+{
+    DWORD i;
+
+    if (!path[0] || path[1] != ':') return -1;
+    for (i = 0; i < list->dwDriveCount; i++)
+        if (towupper(list->Drives[i].lpzName[0]) == towupper(path[0])) return i;
+    return -1;
+}
+
+static LONGLONG round_to_cluster(LONGLONG size, DWORD cluster)
+{
+    return (size + cluster - 1) / cluster * cluster;
+}
+
+static BOOL existing_size(const WCHAR *path, LONGLONG *size)
+{
+    WIN32_FILE_ATTRIBUTE_DATA data;
+
+    if (!GetFileAttributesExW(path, GetFileExInfoStandard, &data) || (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+        return FALSE;
+    *size = ((LONGLONG)data.nFileSizeHigh << 32) | data.nFileSizeLow;
+    return TRUE;
+}
+
+static BOOL disk_space_path( const WCHAR *file, WCHAR *full )
+{
+    DWORD len = GetFullPathNameW(file, MAX_PATH, full, NULL);
+    return len && len < MAX_PATH;
+}
+
+static struct file_entry *find_entry(DISKSPACELIST *list, const WCHAR *path, UINT op)
+{
+    DWORD i;
+
+    for (i = 0; i < list->file_count; i++)
+        if (list->files[i].op == op && !wcsicmp(list->files[i].path, path)) return &list->files[i];
+    return NULL;
+}
+
+static void drop_entry(DISKSPACELIST *list, struct file_entry *entry)
+{
+    list->Drives[entry->drive].dwWantedSpace -= entry->delta;
+    free(entry->path);
+    memmove(entry, entry + 1, (list->files + list->file_count - entry - 1) * sizeof(*entry));
+    list->file_count--;
+}
+
+/***********************************************************************
+*		SetupAddToDiskSpaceListW  (SETUPAPI.@)
+*
+* Stained Glass OS: a copy needs the file's size in whole clusters on its
+* drive, less what a file already there takes; a delete gives that back.
+* A file added again replaces its earlier entry.
+*/
+BOOL WINAPI SetupAddToDiskSpaceListW(HDSKSPC diskspace, PCWSTR targetfile,
+                                    LONGLONG filesize, UINT operation,
+                                    PVOID reserved1, UINT reserved2)
+{
+    DISKSPACELIST *list = diskspace;
+    WCHAR full[MAX_PATH];
+    struct file_entry *entry, *files;
+    LONGLONG current = 0, delta;
+    BOOL exists;
+    int drive;
+
+    TRACE("(%p, %s, %I64d, %u, %p, %u)\n", diskspace, debugstr_w(targetfile), filesize, operation, reserved1, reserved2);
+
+    if (!diskspace)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!targetfile || filesize < 0 || reserved1 || reserved2 || (operation != FILEOP_COPY && operation != FILEOP_DELETE))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!disk_space_path(targetfile, full))
+    {
+        SetLastError(ERROR_INVALID_NAME);
+        return FALSE;
+    }
+    if ((drive = find_drive(list, full)) < 0)
+    {
+        SetLastError(ERROR_INVALID_DRIVE);
+        return FALSE;
+    }
+
+    exists = existing_size(full, &current);
+    if (operation == FILEOP_COPY)
+        delta = round_to_cluster(filesize, list->Drives[drive].cluster) -
+                (exists ? round_to_cluster(current, list->Drives[drive].cluster) : 0);
+    else
+        delta = exists ? -round_to_cluster(current, list->Drives[drive].cluster) : 0;
+#ifdef SG_MUTANT_NO_CLUSTER
+    if (operation == FILEOP_COPY) delta = filesize - (exists ? current : 0);
+#endif
+
+    if ((entry = find_entry(list, full, operation))) drop_entry(list, entry);
+    if (!(files = realloc(list->files, (list->file_count + 1) * sizeof(*files))))
+    {
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+    list->files = files;
+    if (!(files[list->file_count].path = wcsdup(full)))
+    {
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+    files[list->file_count].op = operation;
+    files[list->file_count].delta = delta;
+    files[list->file_count].drive = drive;
+    list->file_count++;
+#ifndef SG_MUTANT_ADD_NOT_COUNTED
+    list->Drives[drive].dwWantedSpace += delta;
+#endif
+    return TRUE;
+}
+
