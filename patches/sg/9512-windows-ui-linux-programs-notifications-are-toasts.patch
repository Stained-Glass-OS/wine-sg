From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui: Linux programs' notifications are toasts

A Linux program notifies through the session's
org.freedesktop.Notifications (notify-send, Thunderbird's new mail,
Telegram, a browser's web notifications); nothing owned that name, and
every one of them was lost -- no toast, nothing in the notification
centre (David 2026-11-27: Linux programs first class).

sg-session's sg-notify-bridge now owns it and hands each notification to
a host in this DLL, rundll32 windows.ui.dll,SgLinuxNotifications, on its
standard input: SHOW <id> <AUMID> <name> <toast XML> shows it as a toast
of the program's AppUserModelID (SG.LinuxApp.<desktop id>, its Start
shortcut's, sg-shell's sg-linuxapp), so it looks and stacks as a Windows
program's toast, is kept in the notification centre's history and is
turned off per app; the same number again replaces it (its tag), HIDE
takes it back. What the person does goes out on standard output: ACT
<id> <arguments> for a click on it ("default") or a button (its key) --
on screen or later in the notification centre, which reaches the
toast this host still holds (SgActivateNotification) -- CLOSED <id>
<reason> for its close button (2) or a hide (3), EXPIRED <id> when its
time ran out (it stays in the centre). An ID with no registered name gets
the program's name the bridge gives. The input's end ends the host.

Gate: test/linuxnotify-gate.sh (mutant SG_MUTANT_LINUX_NOTE_NO_ANSWER).
---
--- a/dlls/windows.ui/toast.c
+++ b/dlls/windows.ui/toast.c
@@ -77,6 +77,7 @@
     DWORD seq;              /* its notification history entry, plus one; 0 none */
     BOOL has_activator;     /* its program registered a COM activator, ... */
     CLSID activator;        /* ... this one */
+    UINT sg_linux_id;       /* Stained Glass OS 9512: a Linux program's notification's number (SgLinuxNotifications) */
 };
 
 struct toast_action
@@ -764,11 +765,16 @@
     free( event );
 }
 
+static void sg_linux_event( struct toast *toast, enum toast_event_kind kind, const WCHAR *arguments,
+                            ToastDismissalReason reason );
+
 static void raise_event( struct toast *toast, enum toast_event_kind kind, const WCHAR *arguments,
                          ToastDismissalReason reason, HRESULT error )
 {
     struct toast_event *event;
 
+    if (toast->sg_linux_id) sg_linux_event( toast, kind, arguments, reason );
+
     if (!(event = calloc( 1, sizeof(*event) ))) return;
     event->toast = toast;
     IToastNotification_AddRef( &toast->IToastNotification_iface );
@@ -4155,3 +4161,255 @@
 };
 
 IActivationFactory *scheduled_toast_factory = &scheduled_statics.IActivationFactory_iface;
+
+
+/*
+ * Stained Glass OS 9512: Linux programs' notifications
+ *
+ * A Linux program notifies through the session's org.freedesktop.Notifications
+ * (notify-send, Thunderbird's new mail, Telegram, a browser's web
+ * notifications). sg-session's sg-notify-bridge owns that name and hands each
+ * notification to this host (rundll32 windows.ui.dll,SgLinuxNotifications),
+ * which shows it as a toast of the program's AppUserModelID -- SG.LinuxApp.
+ * <desktop id>, its Start shortcut's (sg-shell's sg-linuxapp) -- so it looks,
+ * stacks, is kept in the notification centre and is turned off per app as a
+ * Windows program's toast. What the person does with it goes back.
+ *
+ *   in   SHOW <id>\t<AUMID>\t<name>\t<toast XML>   show (again: the same tag replaces it)
+ *        HIDE <id>                               the program took it back
+ *   out  READY
+ *        ACT <id>\t<arguments>                   clicked: "default", or an action's key
+ *        CLOSED <id>\t<reason>                   dismissed: 2 by the person, 3 hidden
+ *        EXPIRED <id>                            its time ran out (it stays in the centre)
+ *
+ * Lines are UTF-8. A program whose ID has no registered name gets the name
+ * the bridge gives (HKCU\Software\Classes\AppUserModelId\<ID> DisplayName).
+ * The end of the input ends the host.
+ */
+
+struct sg_linux_note
+{
+    UINT id;
+    IToastNotification *toast;
+    IToastNotifier *notifier;
+};
+
+static struct sg_linux_note *sg_linux_notes;
+static UINT sg_linux_count, sg_linux_size;
+static HANDLE sg_linux_out;
+static CRITICAL_SECTION sg_linux_cs;
+static CRITICAL_SECTION_DEBUG sg_linux_cs_debug =
+{
+    0, 0, &sg_linux_cs,
+    { &sg_linux_cs_debug.ProcessLocksList, &sg_linux_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": sg_linux_cs") }
+};
+static CRITICAL_SECTION sg_linux_cs = { &sg_linux_cs_debug, -1, 0, 0, 0, 0 };
+
+static void sg_linux_write( const char *line )
+{
+    DWORD written;
+    EnterCriticalSection( &sg_linux_cs );
+    if (sg_linux_out) WriteFile( sg_linux_out, line, strlen( line ), &written, NULL );
+    LeaveCriticalSection( &sg_linux_cs );
+}
+
+static void sg_linux_event( struct toast *toast, enum toast_event_kind kind, const WCHAR *arguments,
+                            ToastDismissalReason reason )
+{
+    char line[1100], args[1024] = "";
+    char *p;
+
+    if (arguments && !WideCharToMultiByte( CP_UTF8, 0, arguments, -1, args, sizeof(args), NULL, NULL )) args[0] = 0;
+    for (p = args; *p; p++) if (*p == '\t' || *p == '\n' || *p == '\r') *p = ' ';
+    if (kind == TOAST_ACTIVATED) snprintf( line, sizeof(line), "ACT %u\t%s\n", toast->sg_linux_id, args[0] ? args : "default" );
+    else if (kind == TOAST_DISMISSED && reason == ToastDismissalReason_TimedOut) snprintf( line, sizeof(line), "EXPIRED %u\n", toast->sg_linux_id );
+    else if (kind == TOAST_DISMISSED)
+        snprintf( line, sizeof(line), "CLOSED %u\t%u\n", toast->sg_linux_id,
+                  reason == ToastDismissalReason_ApplicationHidden ? 3 : 2 );
+    else return;
+    sg_linux_write( line );
+}
+
+static struct sg_linux_note *sg_linux_find( UINT id )
+{
+    UINT i;
+    for (i = 0; i < sg_linux_count; i++) if (sg_linux_notes[i].id == id) return &sg_linux_notes[i];
+    return NULL;
+}
+
+static WCHAR *sg_linux_utf16( const char *str )
+{
+    int len = MultiByteToWideChar( CP_UTF8, 0, str, -1, NULL, 0 );
+    WCHAR *ret = len > 0 ? malloc( len * sizeof(WCHAR) ) : NULL;
+    if (ret) MultiByteToWideChar( CP_UTF8, 0, str, -1, ret, len );
+    return ret;
+}
+
+/* the program's name for its ID, unless it registered one */
+static void sg_linux_name( const WCHAR *aumid, const WCHAR *name )
+{
+    WCHAR key[300], have[256];
+    DWORD size = sizeof(have);
+    HKEY hkey;
+
+    if (!name || !*name || wcslen( aumid ) > 200) return;
+    swprintf( key, ARRAY_SIZE(key), L"Software\\Classes\\AppUserModelId\\%s", aumid );
+    if (!RegGetValueW( HKEY_CURRENT_USER, key, L"DisplayName", RRF_RT_REG_SZ, NULL, have, &size ) && *have) return;
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, key, 0, NULL, 0, KEY_SET_VALUE, NULL, &hkey, NULL )) return;
+    RegSetValueExW( hkey, L"DisplayName", 0, REG_SZ, (const BYTE *)name, (wcslen( name ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( hkey );
+}
+
+static void sg_linux_hide( struct sg_linux_note *note )
+{
+    IToastNotifier_Hide( note->notifier, note->toast );
+}
+
+static void sg_linux_forget( struct sg_linux_note *note )
+{
+    struct toast *toast = impl_from_IToastNotification( note->toast );
+    toast->sg_linux_id = 0;
+    IToastNotification_Release( note->toast );
+    IToastNotifier_Release( note->notifier );
+    *note = sg_linux_notes[--sg_linux_count];
+}
+
+static void sg_linux_show( UINT id, const WCHAR *aumid, const WCHAR *name, const WCHAR *xml )
+{
+    struct sg_linux_note *note;
+    IXmlDocument *doc = NULL;
+    IXmlDocumentIO *io = NULL;
+    IToastNotification *toast = NULL;
+    IToastNotification2 *toast2 = NULL;
+    IToastNotifier *notifier = NULL;
+    HSTRING str = NULL;
+    WCHAR tag[16];
+    HRESULT hr;
+
+    sg_linux_name( aumid, name );
+    if (FAILED(hr = xml_document_create( &doc ))) goto done;
+    if (FAILED(hr = IXmlDocument_QueryInterface( doc, &IID_IXmlDocumentIO, (void **)&io ))) goto done;
+    if (FAILED(hr = WindowsCreateString( xml, wcslen( xml ), &str ))) goto done;
+    if (FAILED(hr = IXmlDocumentIO_LoadXml( io, str ))) goto done;
+    WindowsDeleteString( str );
+    str = NULL;
+    if (FAILED(hr = create_toast( doc, &toast ))) goto done;
+    /* the same number again (replaces_id) replaces it, on screen and in the centre: its tag */
+    swprintf( tag, ARRAY_SIZE(tag), L"%u", id );
+    if (SUCCEEDED(IToastNotification_QueryInterface( toast, &IID_IToastNotification2, (void **)&toast2 )))
+    {
+        if (SUCCEEDED(WindowsCreateString( tag, wcslen( tag ), &str ))) IToastNotification2_put_Tag( toast2, str );
+        WindowsDeleteString( str );
+        str = NULL;
+        if (SUCCEEDED(WindowsCreateString( L"linux", 5, &str ))) IToastNotification2_put_Group( toast2, str );
+        WindowsDeleteString( str );
+        str = NULL;
+        IToastNotification2_Release( toast2 );
+    }
+    if (FAILED(hr = notifier_create( aumid, &notifier ))) goto done;
+    /* the one it replaces is no longer ours to answer for */
+    if ((note = sg_linux_find( id ))) sg_linux_forget( note );
+    if (sg_linux_count == sg_linux_size)
+    {
+        UINT size = sg_linux_size ? 2 * sg_linux_size : 16;
+        struct sg_linux_note *grown = realloc( sg_linux_notes, size * sizeof(*grown) );
+        if (!grown) { hr = E_OUTOFMEMORY; goto done; }
+        sg_linux_notes = grown;
+        sg_linux_size = size;
+    }
+#ifndef SG_MUTANT_LINUX_NOTE_NO_ANSWER
+    impl_from_IToastNotification( toast )->sg_linux_id = id;
+#endif
+    note = &sg_linux_notes[sg_linux_count++];
+    note->id = id;
+    note->toast = toast;
+    note->notifier = notifier;
+    IToastNotification_AddRef( toast );
+    IToastNotifier_AddRef( notifier );
+    hr = IToastNotifier_Show( notifier, toast );
+
+done:
+    if (FAILED(hr)) WARN( "notification %u for %s not shown: %#lx\n", id, debugstr_w(aumid), hr );
+    WindowsDeleteString( str );
+    if (notifier) IToastNotifier_Release( notifier );
+    if (toast) IToastNotification_Release( toast );
+    if (io) IXmlDocumentIO_Release( io );
+    if (doc) IXmlDocument_Release( doc );
+}
+
+static void sg_linux_command( char *line )
+{
+    char *fields[4], *p = line;
+    WCHAR *aumid, *name, *xml;
+    int n = 0;
+    UINT id;
+
+    if (!strncmp( line, "HIDE ", 5 ))
+    {
+        struct sg_linux_note *note;
+        id = strtoul( line + 5, NULL, 10 );
+        if ((note = sg_linux_find( id )))
+        {
+            sg_linux_hide( note );
+            sg_linux_forget( note );
+        }
+        return;
+    }
+    if (strncmp( line, "SHOW ", 5 )) return;
+    p = line + 5;
+    while (n < 4)
+    {
+        fields[n++] = p;
+        if (n == 4 || !(p = strchr( p, '\t' ))) break;
+        *p++ = 0;
+    }
+    if (n < 4) return;
+    id = strtoul( fields[0], NULL, 10 );
+    aumid = sg_linux_utf16( fields[1] );
+    name = sg_linux_utf16( fields[2] );
+    xml = sg_linux_utf16( fields[3] );
+    if (id && aumid && *aumid && xml) sg_linux_show( id, aumid, name, xml );
+    free( aumid );
+    free( name );
+    free( xml );
+}
+
+/***********************************************************************
+ *      SgLinuxNotifications (windows.ui.@)
+ *
+ * Stained Glass OS: rundll32 entry point of the host of Linux programs'
+ * notifications (see above). Its commands come on its standard input.
+ */
+void WINAPI SgLinuxNotifications( HWND hwnd, HINSTANCE instance, LPSTR cmdline, int show )
+{
+    HANDLE in = GetStdHandle( STD_INPUT_HANDLE );
+    char buf[65536], *line, *end;
+    DWORD got, have = 0;
+    BOOL ro = SUCCEEDED(RoInitialize( RO_INIT_MULTITHREADED ));
+
+    sg_linux_out = GetStdHandle( STD_OUTPUT_HANDLE );
+    if (sg_linux_out == INVALID_HANDLE_VALUE) sg_linux_out = NULL;
+    sg_linux_write( "READY\n" );
+    while (in && in != INVALID_HANDLE_VALUE && have < sizeof(buf) - 1 &&
+           ReadFile( in, buf + have, sizeof(buf) - 1 - have, &got, NULL ) && got)
+    {
+        have += got;
+        buf[have] = 0;
+        for (line = buf; (end = strchr( line, '\n' )); line = end + 1)
+        {
+            *end = 0;
+            if (end > line && end[-1] == '\r') end[-1] = 0;
+            sg_linux_command( line );
+        }
+        have -= line - buf;
+        memmove( buf, line, have );
+        if (have == sizeof(buf) - 1) have = 0;   /* a line too long for a notification: dropped */
+    }
+    /* the bridge is gone: what is on screen goes with this host */
+    while (sg_linux_count) sg_linux_forget( &sg_linux_notes[0] );
+    EnterCriticalSection( &sg_linux_cs );
+    sg_linux_out = NULL;
+    LeaveCriticalSection( &sg_linux_cs );
+    if (ro) RoUninitialize();
+}
--- a/dlls/windows.ui/windows.ui.spec
+++ b/dlls/windows.ui/windows.ui.spec
@@ -7,4 +7,5 @@
 @ stub CreateControlInputEx
 @ stdcall SgActivateNotification(long wstr)
 @ stdcall SgToastScheduler(long long str long)
+@ stdcall SgLinuxNotifications(long long str long)
 @ stdcall SgCoreWindowForThread(ptr)
