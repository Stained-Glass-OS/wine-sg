+                free(conn->extra_buf);
+                conn->extra_len = 0;
+                if((conn->extra_buf = malloc(in_bufs[1].cbBuffer))) {
+                    memcpy(conn->extra_buf, (BYTE*)in_bufs[0].pvBuffer + in_bufs[0].cbBuffer - in_bufs[1].cbBuffer,
+                           in_bufs[1].cbBuffer);
+                    conn->extra_len = in_bufs[1].cbBuffer;
+                }
+            }
+#else
