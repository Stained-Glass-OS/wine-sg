From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wininet, winhttp: keep what follows the handshake in the same read

A TLS 1.3 server may send its session tickets (or data) right after its Finished; they then
arrive in the client's last handshake read, and schannel returns them as SECBUFFER_EXTRA.
wininet and winhttp logged "SECBUFFER_EXTRA not supported" and dropped them, so DecryptMessage
started in the middle of a record and every request failed (raw.githubusercontent.com: 12030,
SEC_E_INTERNAL_ERROR). Those bytes now go to the connection's extra buffer, which the first
read already takes before anything new from the socket.
---
--- a/dlls/wininet/netconnection.c
+++ b/dlls/wininet/netconnection.c
@@ -549,8 +549,24 @@
                 DeleteSecurityContext(&connection->ssl_ctx);
             connection->ssl_ctx = ctx;
 
+#ifndef SG_MUTANT_TLS_DROP_EXTRA
+            /* Stained Glass OS (8416): what came after the handshake in the same read (a TLS 1.3
+             * server's session tickets, sent with its Finished) is the start of the stream that
+             * DecryptMessage reads; dropped, every later record was misread. It is the end of
+             * the input. */
+            if(in_bufs[1].BufferType == SECBUFFER_EXTRA && in_bufs[1].cbBuffer) {
+                free(connection->extra_buf);
+                connection->extra_len = 0;
+                if((connection->extra_buf = malloc(in_bufs[1].cbBuffer))) {
+                    memcpy(connection->extra_buf, (BYTE*)in_bufs[0].pvBuffer + in_bufs[0].cbBuffer - in_bufs[1].cbBuffer,
+                           in_bufs[1].cbBuffer);
+                    connection->extra_len = in_bufs[1].cbBuffer;
+                }
+            }
+#else
             if(in_bufs[1].BufferType == SECBUFFER_EXTRA)
                 FIXME("SECBUFFER_EXTRA not supported\n");
+#endif
 
             status = QueryContextAttributesW(&ctx, SECPKG_ATTR_STREAM_SIZES, &connection->ssl_sizes);
             if(status != SEC_E_OK) {
--- a/dlls/winhttp/net.c
+++ b/dlls/winhttp/net.c
@@ -488,8 +488,24 @@
                 out_buf.cbBuffer = 0;
             }
 #endif
+#ifndef SG_MUTANT_TLS_DROP_EXTRA
