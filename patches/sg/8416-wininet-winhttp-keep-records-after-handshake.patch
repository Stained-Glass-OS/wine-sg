                 FIXME("SECBUFFER_EXTRA not supported\n");
+#endif
 
             status = QueryContextAttributesW(&ctx, SECPKG_ATTR_STREAM_SIZES, &conn->ssl_sizes);
             if(status != SEC_E_OK) {
