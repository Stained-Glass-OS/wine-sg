From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the taskbar's menu has Cascade windows, Show windows stacked, Show windows side by side and their Undo

Windows 10's taskbar menu arranges the windows: Cascade windows, Show windows
stacked, Show windows side by side (beside Show the desktop), and after one
of them "Undo Cascade all windows" / "Undo Show all windows stacked" / "Undo
Show all windows side by side", which puts each window back where it was.
Ours had none (the commands existed for programs only, 1646).

Gate: make test-taskkeys (side by side and Undo). Mutant: -DSG_MUTANT_MENU_NO_ARRANGE.
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -5809,11 +5809,74 @@
 }
 
 /* Stained Glass OS: the bar's own menu, as Windows 10's: search, the Task
- * View button, Show the desktop, Task Manager, Lock the taskbar and Taskbar
+ * View button, Cascade windows, Show windows stacked / side by side (and their
+ * Undo), Show the desktop, Task Manager, Lock the taskbar and Taskbar
  * settings. It writes what Settings > Personalization > Taskbar writes, and
  * the bar follows the same way (WM_SETTINGCHANGE "TraySettings"). */
 enum { SG_MENU_SEARCH_OFF = 1, SG_MENU_SEARCH_ICON, SG_MENU_SEARCH_BOX, SG_MENU_TASKVIEW, SG_MENU_DESKTOP,
-       SG_MENU_TASKMGR, SG_MENU_LOCK, SG_MENU_SETTINGS, SG_MENU_KEYBOARD };
+       SG_MENU_TASKMGR, SG_MENU_LOCK, SG_MENU_SETTINGS, SG_MENU_KEYBOARD, SG_MENU_CASCADE, SG_MENU_STACKED,
+       SG_MENU_SIDE, SG_MENU_UNDO };
+
+/* Stained Glass OS (9069): what Cascade windows / Show windows stacked / side by
+ * side moved, to put back with the menu's Undo, as Windows 10 offers it */
+static struct { HWND hwnd; RECT rect; BOOL zoomed; } sg_arranged[64];
+static int sg_narranged;
+static const WCHAR *sg_arranged_undo;
+
+static BOOL CALLBACK sg_note_arranged( HWND hwnd, LPARAM lp )
+{
+    LONG ex = GetWindowLongW( hwnd, GWL_EXSTYLE );
+
+    if (sg_narranged >= ARRAY_SIZE(sg_arranged) || !IsWindowVisible( hwnd ) || IsIconic( hwnd )) return TRUE;
+    if ((ex & WS_EX_TOOLWINDOW) && !(ex & WS_EX_APPWINDOW)) return TRUE;
+    if (!GetWindowRect( hwnd, &sg_arranged[sg_narranged].rect )) return TRUE;
+    sg_arranged[sg_narranged].zoomed = IsZoomed( hwnd );
+    sg_arranged[sg_narranged++].hwnd = hwnd;
+    return TRUE;
+}
+
+static void sg_arrange( int how )
+{
+    sg_narranged = 0;
+    EnumWindows( sg_note_arranged, 0 );
+#ifdef SG_MUTANT_MENU_NO_ARRANGE
+    return;
+#endif
+    if (how == SG_MENU_CASCADE)
+    {
+        CascadeWindows( NULL, MDITILE_ZORDER, NULL, 0, NULL );
+        sg_arranged_undo = L"&Undo Cascade all windows";
+    }
+    else if (how == SG_MENU_STACKED)
+    {
+        TileWindows( NULL, MDITILE_HORIZONTAL, NULL, 0, NULL );
+        sg_arranged_undo = L"&Undo Show all windows stacked";
+    }
+    else
+    {
+        TileWindows( NULL, MDITILE_VERTICAL, NULL, 0, NULL );
+        sg_arranged_undo = L"&Undo Show all windows side by side";
+    }
+}
+
+static void sg_arrange_undo(void)
+{
+    int i;
+
+    for (i = sg_narranged - 1; i >= 0; i--)
+    {
+        HWND hwnd = sg_arranged[i].hwnd;
+        const RECT *r = &sg_arranged[i].rect;
+
+        if (!IsWindow( hwnd )) continue;
+        /* (another program's window: without waiting for it, as the arranging does) */
+        if (sg_arranged[i].zoomed) ShowWindowAsync( hwnd, SW_MAXIMIZE );
+        else SetWindowPos( hwnd, 0, r->left, r->top, r->right - r->left, r->bottom - r->top,
+                           SWP_NOZORDER | SWP_NOACTIVATE | SWP_ASYNCWINDOWPOS );
+    }
+    sg_narranged = 0;
+    sg_arranged_undo = NULL;
+}
 
 /* Stained Glass OS: the touch keyboard's button (sg-shell's sg-touchkbd puts
  * it in the notification area): Windows' TipbandDesiredVisibility, not set,
@@ -5854,7 +5917,12 @@
