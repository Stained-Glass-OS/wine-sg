 #endif
     AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    /* Stained Glass OS (9069): Windows 10's window arranging, and its Undo */
+    AppendMenuW( menu, MF_STRING, SG_MENU_CASCADE, L"&Cascade windows" );
+    AppendMenuW( menu, MF_STRING, SG_MENU_STACKED, L"Show windows st&acked" );
+    AppendMenuW( menu, MF_STRING, SG_MENU_SIDE, L"Show windows side by s&ide" );
     AppendMenuW( menu, MF_STRING, SG_MENU_DESKTOP, L"Show the &desktop" );
+    if (sg_arranged_undo && sg_narranged) AppendMenuW( menu, MF_STRING, SG_MENU_UNDO, sg_arranged_undo );
     AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
     AppendMenuW( menu, MF_STRING, SG_MENU_TASKMGR, L"Tas&k Manager" );
     AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
@@ -5887,6 +5955,10 @@
         break;
     }
     case SG_MENU_DESKTOP: shell_show_desktop(); break;
+    case SG_MENU_CASCADE:
+    case SG_MENU_STACKED:
+    case SG_MENU_SIDE: sg_arrange( cmd ); break;
