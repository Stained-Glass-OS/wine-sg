From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.security.authentication.web.core: AAD account properties, sign-out

A work account the broker gave had no Properties. MSAL (OneDrive's OneAuth) builds its account from the WebAccount's Authority, TenantId and OID and stopped: "MSAL AAD account cannot be constructed without a valid WAM Authority", then OneDrive showed error 0x8004e4cf after signing in. A WebAccount from a token answer or FindAllAccounts now has Authority (https://<host>/<tenant>/), TenantId, OID, UPN, UserName, SignInName and DisplayName, from the helper's account. WebAccount.SignOutAsync, SignOutAsync(clientId) and WebTokenRequestResult.InvalidateCacheAsync returned E_NOTIMPL (MSAL's recovery after an error); they now complete.
---
diff --git a/dlls/windows.security.authentication.web.core/broker.c b/dlls/windows.security.authentication.web.core/broker.c
index 6a1ce6c..b2b46b8 100644
--- a/dlls/windows.security.authentication.web.core/broker.c
+++ b/dlls/windows.security.authentication.web.core/broker.c
@@ -420,6 +420,64 @@ static void response_property( IWebTokenResponse *response, const char *name, co
     free( wvalue );
 }
 
+static void map_put( IMap_HSTRING_HSTRING *map, const WCHAR *name, const char *value )
+{
+    WCHAR *wvalue = from_utf8( value );
+    HSTRING k, v;
+    boolean replaced;
+
+    if (map && wvalue && SUCCEEDED(WindowsCreateString( name, wcslen( name ), &k )))
+    {
+        if (SUCCEEDED(WindowsCreateString( wvalue, wcslen( wvalue ), &v )))
+        {
+            IMap_HSTRING_HSTRING_Insert( map, k, v, &replaced );
+            WindowsDeleteString( v );
+        }
+        WindowsDeleteString( k );
+    }
+    free( wvalue );
+}
+
+/* A work or school account's properties, as the Windows broker's AAD accounts have them: MSAL builds
+ * its account from them and gives up without an Authority ("MSAL AAD account cannot be constructed
+ * without a valid WAM Authority": OneDrive). From the helper's account: home_account_id is
+ * "<oid>.<tenant>", environment the authority's host. */
+static void account_set_properties( IWebAccount *account, const struct json *acc )
+{
+    IMap_HSTRING_HSTRING *props;
+    const char *home = json_str( acc, "home_account_id" ), *env = json_str( acc, "environment" );
+    const char *realm = json_str( acc, "realm" ), *oid = json_str( acc, "local_account_id" ), *user = json_str( acc, "username" );
+    char tenant[128] = "", object[128] = "", authority[384];
+    const char *dot;
+
+#ifdef SG_MUTANT_WAM_NO_ACCOUNT_PROPERTIES
+    return;
+#endif
+    if (!account || !(props = account_properties( account ))) return;
+    if (home && (dot = strchr( home, '.' )))
+    {
+        snprintf( object, sizeof(object), "%.*s", (int)(dot - home), home );
+        snprintf( tenant, sizeof(tenant), "%s", dot + 1 );
+    }
+    if (realm && realm[0]) snprintf( tenant, sizeof(tenant), "%s", realm );
+    if (oid && oid[0]) snprintf( object, sizeof(object), "%s", oid );
+    if (!env || !env[0]) env = "login.microsoftonline.com";
+    if (tenant[0])
+    {
+        snprintf( authority, sizeof(authority), "https://%s/%s/", env, tenant );
+        map_put( props, L"Authority", authority );
+        map_put( props, L"TenantId", tenant );
+    }
+    if (object[0]) map_put( props, L"OID", object );
+    if (user && user[0])
+    {
+        map_put( props, L"UPN", user );
+        map_put( props, L"UserName", user );
+        map_put( props, L"SignInName", user );
+        map_put( props, L"DisplayName", user );
+    }
+}
+
 static HRESULT make_result( WebTokenRequestStatus status, const WCHAR *message, UINT32 code, IInspectable **result )
 {
     IWebProviderError *error = NULL;
@@ -458,6 +516,7 @@ static HRESULT success_result( IWebAccountProvider *provider, const struct json
         WindowsDeleteString( id );
         WindowsDeleteString( name );
         if (FAILED(hr)) goto done;
+        account_set_properties( account, acc );
     }
     WindowsCreateString( wtoken, wcslen( wtoken ), &tok );
     hr = token_response_create( tok, account, NULL, &response );
@@ -638,7 +697,8 @@ HRESULT broker_accounts( IWebAccountProvider *provider, IInspectable **result )
             {
                 WindowsCreateString( wid, wcslen( wid ), &id );
                 WindowsCreateString( wname, wcslen( wname ), &name );
-                if (SUCCEEDED(account_create( provider, id, name, WebAccountState_Connected, &accounts[count] ))) count++;
+                if (SUCCEEDED(account_create( provider, id, name, WebAccountState_Connected, &accounts[count] )))
+                    account_set_properties( accounts[count++], list->items[i] );
                 WindowsDeleteString( id );
                 WindowsDeleteString( name );
             }
diff --git a/dlls/windows.security.authentication.web.core/objects.c b/dlls/windows.security.authentication.web.core/objects.c
index 8d23c1b..3ba3f9c 100644
--- a/dlls/windows.security.authentication.web.core/objects.c
