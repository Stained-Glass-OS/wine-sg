@@ -1252,6 +1252,121 @@ static HRESULT WINAPI account2_get_Properties( IWebAccount2 *iface, IMap_HSTRING
     return S_OK;
 }
 
+/* an action already done: signing out and invalidating a cache have nothing to do here, since
+ * the helper keeps no session of the program's own (MSAL's recovery path calls them and gave up on
+ * E_NOTIMPL) */
+struct done_action
+{
+    IAsyncAction IAsyncAction_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    IAsyncActionCompletedHandler *handler;
+};
+
+static struct done_action *done_from_action( IAsyncAction *iface ) { return CONTAINING_RECORD( iface, struct done_action, IAsyncAction_iface ); }
+static struct done_action *done_from_info( IAsyncInfo *iface ) { return CONTAINING_RECORD( iface, struct done_action, IAsyncInfo_iface ); }
+
+static HRESULT WINAPI done_QueryInterface( IAsyncAction *iface, REFIID iid, void **out )
+{
+    struct done_action *impl = done_from_action( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncAction ))
+        *out = &impl->IAsyncAction_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI done_AddRef( IAsyncAction *iface ) { return InterlockedIncrement( &done_from_action( iface )->ref ); }
+
+static ULONG WINAPI done_Release( IAsyncAction *iface )
+{
+    struct done_action *impl = done_from_action( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->handler) IAsyncActionCompletedHandler_Release( impl->handler );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI done_GetIids( IAsyncAction *iface, ULONG *count, IID **iids ) { *count = 0; *iids = NULL; return S_OK; }
+static HRESULT WINAPI done_GetRuntimeClassName( IAsyncAction *iface, HSTRING *name ) { *name = NULL; return S_OK; }
+static HRESULT WINAPI done_GetTrustLevel( IAsyncAction *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI done_put_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler *handler )
+{
+    struct done_action *impl = done_from_action( iface );
+
+    if (!handler) return E_INVALIDARG;
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    IAsyncActionCompletedHandler_AddRef( (impl->handler = handler) );
+    return IAsyncActionCompletedHandler_Invoke( handler, iface, Completed );
+}
+
+static HRESULT WINAPI done_get_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler **handler )
+{
+    struct done_action *impl = done_from_action( iface );
+
+    if ((*handler = impl->handler)) IAsyncActionCompletedHandler_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI done_GetResults( IAsyncAction *iface ) { return S_OK; }
+
+static const IAsyncActionVtbl done_vtbl =
+{
+    done_QueryInterface, done_AddRef, done_Release, done_GetIids, done_GetRuntimeClassName, done_GetTrustLevel,
+    done_put_Completed, done_get_Completed, done_GetResults,
+};
+
+static HRESULT WINAPI done_info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )
+{
+    return done_QueryInterface( &done_from_info( iface )->IAsyncAction_iface, iid, out );
+}
+static ULONG WINAPI done_info_AddRef( IAsyncInfo *iface ) { return done_AddRef( &done_from_info( iface )->IAsyncAction_iface ); }
+static ULONG WINAPI done_info_Release( IAsyncInfo *iface ) { return done_Release( &done_from_info( iface )->IAsyncAction_iface ); }
+static HRESULT WINAPI done_info_GetIids( IAsyncInfo *iface, ULONG *count, IID **iids ) { *count = 0; *iids = NULL; return S_OK; }
+static HRESULT WINAPI done_info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *name ) { *name = NULL; return S_OK; }
+static HRESULT WINAPI done_info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI done_info_get_Id( IAsyncInfo *iface, UINT32 *id ) { *id = 1; return S_OK; }
+static HRESULT WINAPI done_info_get_Status( IAsyncInfo *iface, AsyncStatus *status ) { *status = Completed; return S_OK; }
+static HRESULT WINAPI done_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *code ) { *code = S_OK; return S_OK; }
+static HRESULT WINAPI done_info_Cancel( IAsyncInfo *iface ) { return S_OK; }
+static HRESULT WINAPI done_info_Close( IAsyncInfo *iface ) { return S_OK; }
+
+static const IAsyncInfoVtbl done_info_vtbl =
+{
+    done_info_QueryInterface, done_info_AddRef, done_info_Release, done_info_GetIids, done_info_GetRuntimeClassName,
+    done_info_GetTrustLevel, done_info_get_Id, done_info_get_Status, done_info_get_ErrorCode, done_info_Cancel,
+    done_info_Close,
+};
+
+static HRESULT done_action_create( IInspectable **out )
+{
+    struct done_action *impl;
+
+#ifdef SG_MUTANT_WAM_SIGNOUT_NOTIMPL
+    *out = NULL;
+    return E_NOTIMPL;
+#endif
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAsyncAction_iface.lpVtbl = &done_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &done_info_vtbl;
+    impl->ref = 1;
+    *out = (IInspectable *)&impl->IAsyncAction_iface;
+    return S_OK;
+}
+
