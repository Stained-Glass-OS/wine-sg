 {
     FIXME( "iface %p, size %d, operation %p stub!\n", iface, size, operation );
@@ -1261,16 +1376,14 @@ static HRESULT WINAPI account2_GetPictureAsync( IWebAccount2 *iface, WebAccountP
 
 static HRESULT WINAPI account2_SignOutAsync( IWebAccount2 *iface, IInspectable **operation )
 {
-    FIXME( "iface %p, operation %p stub!\n", iface, operation );
-    *operation = NULL;
-    return E_NOTIMPL;
