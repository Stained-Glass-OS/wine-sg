From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 18:42:32 -0700
Subject: [PATCH] atl: marshal helpers, AtlSetErrorInfo, AtlDevModeW2A,
 per-user registration

AtlMarshalPtrInProc marshals an interface into a new stream (in-process, table-strong),
AtlUnmarshalPtr reads it back from the start, AtlFreeMarshalStream releases the marshal
data and the stream. AtlSetErrorInfo (a ProgID as the source, a string or resource as the
description, help context and file) sets the thread's error information and returns hr, or
DISP_E_EXCEPTION for 0. AtlDevModeW2A converts a device mode. AtlSetPerUserRegistration /
AtlGetPerUserRegistration keep the setting and the registrar then writes HKEY_CLASSES_ROOT
scripts under HKEY_CURRENT_USER\Software\Classes. The specs of atl, atl80, atl90, atl100 and
atl110 export the two new functions.

diff --git a/dlls/atl/atl.c b/dlls/atl/atl.c
index 32e0c72..ec4e790 100644
--- a/dlls/atl/atl.c
+++ b/dlls/atl/atl.c
@@ -31,6 +31,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(atl);
 typedef unsigned char cpp_bool;
 
 static ICatRegister *catreg;
+BOOL atl_per_user_registration;
 
 /***********************************************************************
  *           AtlAdvise         [atl100.@]
@@ -93,7 +94,17 @@ HRESULT WINAPI AtlUnadvise(IUnknown *pUnkCP, const IID *iid, DWORD dw)
  */
 HRESULT WINAPI AtlFreeMarshalStream(IStream *stm)
 {
-    FIXME("%p\n", stm);
+    TRACE("%p\n", stm);
+
+    /* the interface was marshalled into the stream: release what that holds, then the stream */
+    if (stm)
+    {
+        LARGE_INTEGER zero = {{0}};
+
+        IStream_Seek(stm, zero, STREAM_SEEK_SET, NULL);
+        CoReleaseMarshalData(stm);
+        IStream_Release(stm);
+    }
     return S_OK;
 }
 
@@ -102,8 +113,19 @@ HRESULT WINAPI AtlFreeMarshalStream(IStream *stm)
  */
 HRESULT WINAPI AtlMarshalPtrInProc(IUnknown *pUnk, const IID *iid, IStream **pstm)
 {
-    FIXME("%p %p %p\n", pUnk, iid, pstm);
-    return E_FAIL;
+    HRESULT hr;
+
+    TRACE("%p %s %p\n", pUnk, debugstr_guid(iid), pstm);
+
+    if (!pstm) return E_INVALIDARG;
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, pstm))) return hr;
+    hr = CoMarshalInterface(*pstm, iid, pUnk, MSHCTX_INPROC, NULL, MSHLFLAGS_TABLESTRONG);
+    if (FAILED(hr))
+    {
+        IStream_Release(*pstm);
+        *pstm = NULL;
+    }
+    return hr;
 }
 
 /***********************************************************************
@@ -111,8 +133,15 @@ HRESULT WINAPI AtlMarshalPtrInProc(IUnknown *pUnk, const IID *iid, IStream **pst
  */
 HRESULT WINAPI AtlUnmarshalPtr(IStream *stm, const IID *iid, IUnknown **ppUnk)
 {
-    FIXME("%p %p %p\n", stm, iid, ppUnk);
-    return E_FAIL;
+    LARGE_INTEGER zero = {{0}};
+
+    TRACE("%p %s %p\n", stm, debugstr_guid(iid), ppUnk);
+
+    if (!ppUnk) return E_INVALIDARG;
+    *ppUnk = NULL;
+    if (!stm) return E_INVALIDARG;
+    IStream_Seek(stm, zero, STREAM_SEEK_SET, NULL);
+    return CoUnmarshalInterface(stm, iid, (void **)ppUnk);
 }
 
 /***********************************************************************
@@ -942,8 +971,9 @@ HRESULT WINAPI AtlGetObjectSourceInterface(IUnknown *unk, GUID *libid, IID *iid,
  */
 HRESULT WINAPI AtlSetPerUserRegistration(cpp_bool bEnable)
 {
-    FIXME("stub: bEnable: %d\n", bEnable);
-    return E_NOTIMPL;
+    TRACE("bEnable: %d\n", bEnable);
+    atl_per_user_registration = bEnable;
+    return S_OK;
 }
 
 /***********************************************************************
@@ -951,13 +981,81 @@ HRESULT WINAPI AtlSetPerUserRegistration(cpp_bool bEnable)
  */
 HRESULT WINAPI AtlGetPerUserRegistration(cpp_bool *pbEnabled)
 {
-    FIXME("stub: returning false\n");
-    *pbEnabled = 0;
+    TRACE("%p\n", pbEnabled);
+    if (!pbEnabled) return E_POINTER;
+    *pbEnabled = atl_per_user_registration;
     return S_OK;
 }
 
 #endif
 
+/***********************************************************************
+ *           AtlSetErrorInfo            [atl100.@]
+ *
+ * Sets the error information of the thread: the source is the ProgID of the object,
+ * the description a string or the resource whose number it is.
+ */
+HRESULT WINAPI AtlSetErrorInfo(const CLSID *clsid, LPCOLESTR desc, DWORD help_id, LPCOLESTR help_file,
+                               const IID *iid, HRESULT hr, HINSTANCE inst)
+{
+    ICreateErrorInfo *create;
+    IErrorInfo *info;
+    WCHAR buffer[1024], *progid;
+
+    TRACE("%s %p %lu %s %s %#lx %p\n", debugstr_guid(clsid), desc, help_id, debugstr_w(help_file),
+          debugstr_guid(iid), hr, inst);
+
+    if (SUCCEEDED(CreateErrorInfo(&create)))
+    {
+        if (iid) ICreateErrorInfo_SetGUID(create, iid);
+        if (clsid && SUCCEEDED(ProgIDFromCLSID(clsid, &progid)))
+        {
+            ICreateErrorInfo_SetSource(create, progid);
+            CoTaskMemFree(progid);
+        }
+        if (desc)
+        {
+            if (!HIWORD(desc))
+            {
+                if (LoadStringW(inst, LOWORD(desc), buffer, ARRAY_SIZE(buffer))) desc = buffer;
+                else desc = NULL;
+            }
+            if (desc) ICreateErrorInfo_SetDescription(create, (LPOLESTR)desc);
+        }
+        ICreateErrorInfo_SetHelpContext(create, help_id);
+        if (help_file) ICreateErrorInfo_SetHelpFile(create, (LPOLESTR)help_file);
+        if (SUCCEEDED(ICreateErrorInfo_QueryInterface(create, &IID_IErrorInfo, (void **)&info)))
+        {
+            SetErrorInfo(0, info);
+            IErrorInfo_Release(info);
+        }
+        ICreateErrorInfo_Release(create);
+    }
+    return hr ? hr : DISP_E_EXCEPTION;
+}
+
+/***********************************************************************
+ *           AtlDevModeW2A              [atl100.@]
+ *
+ * The ANSI form of a device mode: the names are converted, the rest is copied.
+ */
+DEVMODEA * WINAPI AtlDevModeW2A(DEVMODEA *dest, const DEVMODEW *src)
+{
+    TRACE("%p %p\n", dest, src);
+
+    if (!dest || !src) return NULL;
+    memset(dest, 0, sizeof(*dest));
+    WideCharToMultiByte(CP_ACP, 0, src->dmDeviceName, -1, (char *)dest->dmDeviceName, CCHDEVICENAME, NULL, NULL);
+    /* the members from the specification version to the collate setting are alike in both forms */
+    memcpy(&dest->dmSpecVersion, &src->dmSpecVersion,
+           offsetof(DEVMODEA, dmFormName) - offsetof(DEVMODEA, dmSpecVersion));
+    dest->dmSize = sizeof(DEVMODEA);
+    WideCharToMultiByte(CP_ACP, 0, src->dmFormName, -1, (char *)dest->dmFormName, CCHFORMNAME, NULL, NULL);
+    memcpy(&dest->dmLogPixels, &src->dmLogPixels, sizeof(DEVMODEA) - offsetof(DEVMODEA, dmLogPixels));
+    if (src->dmDriverExtra) memcpy(dest + 1, src + 1, src->dmDriverExtra);
+    return dest;
+}
+
 /***********************************************************************
  *           AtlGetVersion              [atl100.@]
  */
