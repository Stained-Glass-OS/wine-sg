+++ b/dlls/atl/registrar.c
@@ -28,6 +28,8 @@ WINE_DEFAULT_DEBUG_CHANNEL(atl);
  * ATLRegistrar implementation
  */
 
+extern BOOL atl_per_user_registration;
+
 static const struct {
     WCHAR name[22];
     HKEY  key;
@@ -379,6 +381,7 @@ static HRESULT do_process_root_key(LPCOLESTR data, BOOL do_register)
     strbuf buf;
     HRESULT hres;
     unsigned int i;
+    HKEY root, classes;
 
     strbuf_init(&buf);
     hres = get_word(&iter, &buf);
@@ -408,7 +411,19 @@ static HRESULT do_process_root_key(LPCOLESTR data, BOOL do_register)
             hres = DISP_E_EXCEPTION;
             break;
         }
-        hres = do_process_key(&iter, root_keys[i].key, &buf, do_register);
+        root = root_keys[i].key;
+        classes = NULL;
+        /* a per-user registration puts the classes in the user's own set */
+#ifdef SG_MUTANT_NO_PERUSER
+        if(0
+#else
+        if(root == HKEY_CLASSES_ROOT && atl_per_user_registration
+#endif
+           && !RegCreateKeyExW(HKEY_CURRENT_USER, L"Software\\Classes", 0, NULL, 0, KEY_ALL_ACCESS, NULL, &classes, NULL))
+            root = classes;
+        hres = do_process_key(&iter, root, &buf, do_register);
+        if(classes)
+            RegCloseKey(classes);
         if(FAILED(hres)) {
             WARN("Processing key failed: %08lx\n", hres);
             break;
