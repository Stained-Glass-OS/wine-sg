         FIXME("jsdisp->builtin_info->class = %d\n", jsdisp->builtin_info->class);
diff --git a/dlls/jscript/tests/intl.js b/dlls/jscript/tests/intl.js
index ed9e73c..332d9c9 100644
--- a/dlls/jscript/tests/intl.js
+++ b/dlls/jscript/tests/intl.js
@@ -224,5 +224,33 @@ ok(typeof dt.toLocaleString() === "string", "toLocaleString()");
 
 /* Intl objects stay out of earlier modes: checked in mshtml's documentmode.js */
 ok(Object.prototype.toString.call(Intl) === "[object Object]", "Intl class");
+ok(Object.prototype.toString.call(new Intl.Collator()) === "[object Object]", "Collator class");
+ok(Object.prototype.toString.call(new Intl.NumberFormat()) === "[object Object]", "NumberFormat class");
+ok(Object.prototype.toString.call(new Intl.DateTimeFormat()) === "[object Object]", "DateTimeFormat class");
+
+/* class names of the other objects: no Symbol.toStringTag in IE11 */
+ok(Object.prototype.toString.call(new Map()) === "[object Object]", "Map class");
+ok(Object.prototype.toString.call(new Set()) === "[object Object]", "Set class");
+ok(Object.prototype.toString.call(new WeakMap()) === "[object Object]", "WeakMap class");
+ok(Object.prototype.toString.call(JSON) === "[object JSON]", "JSON class");
+ok(Object.prototype.toString.call(new DataView(new ArrayBuffer(1))) === "[object Object]", "DataView class");
+(function() {
+    ok(Object.prototype.toString.call(arguments) === "[object Arguments]", "arguments class");
+})();
+
+/* getOwnPropertyNames lists non-enumerable own properties too */
+ok(Object.getOwnPropertyNames([]).sort().join() === "length", "getOwnPropertyNames([]) = " + Object.getOwnPropertyNames([]).sort().join());
+tmp = Object.getOwnPropertyNames(Array.prototype);
+ok(tmp.indexOf("push") !== -1 && tmp.indexOf("length") !== -1 && tmp.indexOf("constructor") !== -1, "getOwnPropertyNames(Array.prototype) = " + tmp);
+ok(Object.keys([]).length === 0, "Object.keys([]) is still empty");
+
+/* a property descriptor with both accessors and a value */
+try {
+    Object.defineProperty({}, "x", { get: function() {}, value: 1 });
+    ok(false, "defineProperty with get and value did not throw");
+}catch(ex) {
+    ok(ex instanceof TypeError, "defineProperty threw " + ex);
+    ok((ex.number >>> 0) === 0x800a01bd, "defineProperty error number = " + (ex.number >>> 0).toString(16));
+}
 
 reportSuccess();
