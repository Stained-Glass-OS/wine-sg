From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 01:44:06 -0700
Subject: [PATCH] jscript: class names, getOwnPropertyNames and the descriptor
 error number

- Object.prototype.toString: the class name table is indexed by class with
  designated initializers (the Intl classes of the previous patch would have
  read past it); arguments is "[object Arguments]" and JSON "[object JSON]"
  from the ES5 language version on. Map, Set, WeakMap and DataView stay
  "[object Object]" (IE11 has no Symbol.toStringTag), as the mshtml tests say.
- Object.getOwnPropertyNames also lists the object's non-enumerable builtin
  properties ([] has "length", Array.prototype has push, ...): the builtin table
  entries are created when all own properties are enumerated.
- A property descriptor with both accessors and a value reports the number
  0x800a01bd like native instead of Wine's private message id.

Removes the todo_wine marks for these in mshtml's es5.js.

diff --git a/dlls/jscript/dispex.c b/dlls/jscript/dispex.c
index 52973f7..f285e62 100644
--- a/dlls/jscript/dispex.c
+++ b/dlls/jscript/dispex.c
@@ -3077,12 +3077,37 @@ HRESULT disp_delete(IDispatch *disp, DISPID id, BOOL *ret)
     return S_OK;
 }
 
+/* Creates the properties of the object's own builtin table, for the enumeration
+ * of all own properties (non-enumerable ones are not created until used). */
+static HRESULT fill_builtin_props(jsdisp_t *obj)
+{
+    dispex_prop_t *prop;
+    unsigned i;
+    HRESULT hres;
+
+    for(i = 0; i < obj->builtin_info->props_cnt; i++) {
+        const WCHAR *name = obj->builtin_info->props[i].name;
+        hres = find_prop_name(obj, string_hash(name), name, FALSE, NULL, &prop);
+        if(FAILED(hres))
+            return hres;
+    }
+    return S_OK;
+}
+
 HRESULT jsdisp_next_prop(jsdisp_t *obj, DISPID id, enum jsdisp_enum_type enum_type, DISPID *ret)
 {
     dispex_prop_t *iter;
     DWORD idx = id;
     HRESULT hres;
 
+#ifndef SG_MUTANT_JS_NOOWNBUILTIN
+    if(id == DISPID_STARTENUM && enum_type == JSDISP_ENUM_OWN) {
+        hres = fill_builtin_props(obj);
+        if(FAILED(hres))
+            return hres;
+    }
+#endif
+
     if(id == DISPID_STARTENUM || idx >= obj->prop_cnt) {
         hres = (enum_type == JSDISP_ENUM_ALL) ? fill_protrefs(obj) : fill_props(obj);
         if(FAILED(hres))
diff --git a/dlls/jscript/error.c b/dlls/jscript/error.c
index 2a64c8f..8f4a5c8 100644
--- a/dlls/jscript/error.c
+++ b/dlls/jscript/error.c
@@ -180,6 +180,11 @@ static HRESULT create_error(script_ctx_t *ctx, jsdisp_t *constr,
     jsdisp_t *err;
     HRESULT hres;
 
+    /* Wine's own message id for a descriptor with both accessors and a value
+     * must not show: native reports the generic "unsupported action" number. */
+    if(number == (UINT)JS_E_PROP_DESC_MISMATCH)
+        number = JS_E_INVALID_ACTION;
+
     hres = alloc_error(ctx, NULL, constr, &err);
     if(FAILED(hres))
         return hres;
