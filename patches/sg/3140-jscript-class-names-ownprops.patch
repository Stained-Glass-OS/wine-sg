+        [JSCLASS_INTL_NUMBERFORMAT]    = L"[object Object]",
+        [JSCLASS_INTL_DATETIMEFORMAT]  = L"[object Object]",
     };
+    /* class names newer language versions know (IE11 has no Symbol.toStringTag: Map, Set, WeakMap and
+     * DataView stay "[object Object]") */
+    static const struct { jsclass_t class; DWORD version; const WCHAR *name; } es5_names[] = {
+        { JSCLASS_ARGUMENTS, SCRIPTLANGUAGEVERSION_ES5, L"[object Arguments]" },
+        { JSCLASS_JSON,      SCRIPTLANGUAGEVERSION_ES5, L"[object JSON]" },
+    };
+    unsigned i;
 
     TRACE("\n");
 
@@ -79,8 +85,13 @@ static HRESULT Object_toString(script_ctx_t *ctx, jsval_t vthis, WORD flags, uns
         str = L"[object Object]";
     }else if(jsdisp->builtin_info->to_string) {
         hres = jsdisp->builtin_info->to_string(jsdisp, &ret);
-    }else if(names[jsdisp->builtin_info->class]) {
+    }else if(jsdisp->builtin_info->class < ARRAY_SIZE(names) && names[jsdisp->builtin_info->class]) {
         str = names[jsdisp->builtin_info->class];
+#ifndef SG_MUTANT_JS_NOARGSCLASS
+        for(i = 0; i < ARRAY_SIZE(es5_names); i++)
+            if(es5_names[i].class == jsdisp->builtin_info->class && ctx->version >= es5_names[i].version)
+                str = es5_names[i].name;
