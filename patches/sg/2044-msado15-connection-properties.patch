From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msado15: connection timeouts, database, isolation, attributes (2044)

msado15 ADODB.Connection keeps ConnectionTimeout (default 15, refused
while open or negative), DefaultDatabase, IsolationLevel (the known levels,
default cursor stability) and Attributes (the two retaining bits), reports
Version "6.1", and BeginTrans / CommitTrans / RollbackTrans report a closed
connection. They were stubs.
---
--- a/dlls/msado15/connection.c
+++ b/dlls/msado15/connection.c
@@ -54,6 +54,10 @@
     LONG                      refs;
     ObjectStateEnum           state;
     LONG                      timeout;
+    LONG                      connect_timeout;
+    WCHAR                    *default_database;
+    IsolationLevelEnum        isolation;
+    LONG                      attributes;
     WCHAR                    *datasource;
     WCHAR                    *provider;
     ConnectModeEnum           mode;
@@ -110,6 +114,7 @@
         free( connection->cp_connev.sinks );
         free( connection->provider );
         free( connection->datasource );
+        free( connection->default_database );
         free( connection );
     }
     return refs;
@@ -257,20 +262,28 @@
 
 static HRESULT WINAPI connection_get_ConnectionTimeout( _Connection *iface, LONG *timeout )
 {
-    FIXME( "%p, %p\n", iface, timeout );
-    return E_NOTIMPL;
+    struct connection *connection = impl_from_Connection( iface );
+    TRACE( "%p, %p\n", iface, timeout );
+    *timeout = connection->connect_timeout;
+    return S_OK;
 }
 
 static HRESULT WINAPI connection_put_ConnectionTimeout( _Connection *iface, LONG timeout )
 {
-    FIXME( "%p, %ld\n", iface, timeout );
-    return E_NOTIMPL;
+    struct connection *connection = impl_from_Connection( iface );
+    TRACE( "%p, %ld\n", iface, timeout );
+    if (connection->state == adStateOpen) return MAKE_ADO_HRESULT( adErrObjectOpen );
+    if (timeout < 0) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    connection->connect_timeout = timeout;
+    return S_OK;
 }
 
 static HRESULT WINAPI connection_get_Version( _Connection *iface, BSTR *str )
 {
-    FIXME( "%p, %p\n", iface, str );
-    return E_NOTIMPL;
+    TRACE( "%p, %p\n", iface, str );
+    if (!str) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    *str = SysAllocString( L"6.1" );
+    return *str ? S_OK : E_OUTOFMEMORY;
 }
 
 static HRESULT WINAPI connection_Close( _Connection *iface )
@@ -348,19 +361,25 @@
 
 static HRESULT WINAPI connection_BeginTrans( _Connection *iface, LONG *transaction_level )
 {
+    struct connection *connection = impl_from_Connection( iface );
     FIXME( "%p, %p\n", iface, transaction_level );
+    if (connection->state == adStateClosed) return MAKE_ADO_HRESULT( adErrObjectClosed );
     return E_NOTIMPL;
 }
 
 static HRESULT WINAPI connection_CommitTrans( _Connection *iface )
 {
+    struct connection *connection = impl_from_Connection( iface );
     FIXME( "%p\n", iface );
+    if (connection->state == adStateClosed) return MAKE_ADO_HRESULT( adErrObjectClosed );
     return E_NOTIMPL;
 }
 
 static HRESULT WINAPI connection_RollbackTrans( _Connection *iface )
 {
+    struct connection *connection = impl_from_Connection( iface );
     FIXME( "%p\n", iface );
+    if (connection->state == adStateClosed) return MAKE_ADO_HRESULT( adErrObjectClosed );
     return E_NOTIMPL;
 }
 
@@ -422,38 +441,67 @@
 
 static HRESULT WINAPI connection_get_DefaultDatabase( _Connection *iface, BSTR *str )
 {
-    FIXME( "%p, %p\n", iface, str );
-    return E_NOTIMPL;
+    struct connection *connection = impl_from_Connection( iface );
+    TRACE( "%p, %p\n", iface, str );
+    if (!str) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    *str = SysAllocString( connection->default_database ? connection->default_database : L"" );
+    return *str ? S_OK : E_OUTOFMEMORY;
 }
 
 static HRESULT WINAPI connection_put_DefaultDatabase( _Connection *iface, BSTR str )
 {
-    FIXME( "%p, %s\n", iface, debugstr_w(str) );
-    return E_NOTIMPL;
+    struct connection *connection = impl_from_Connection( iface );
+    WCHAR *copy = NULL;
+    TRACE( "%p, %s\n", iface, debugstr_w(str) );
+    if (str && !(copy = wcsdup( str ))) return E_OUTOFMEMORY;
+    free( connection->default_database );
+    connection->default_database = copy;
+    return S_OK;
 }
 
 static HRESULT WINAPI connection_get_IsolationLevel( _Connection *iface, IsolationLevelEnum *level )
 {
-    FIXME( "%p, %p\n", iface, level );
-    return E_NOTIMPL;
+    struct connection *connection = impl_from_Connection( iface );
+    TRACE( "%p, %p\n", iface, level );
+    *level = connection->isolation;
+    return S_OK;
 }
 
 static HRESULT WINAPI connection_put_IsolationLevel( _Connection *iface, IsolationLevelEnum level )
 {
-    FIXME( "%p, %d\n", iface, level );
-    return E_NOTIMPL;
+    struct connection *connection = impl_from_Connection( iface );
+    TRACE( "%p, %d\n", iface, level );
+    switch (level)
+    {
+    case adXactUnspecified: case adXactChaos: case adXactBrowse:
+    case adXactCursorStability:
+    case adXactRepeatableRead:
+    case adXactIsolated:
+        connection->isolation = level;
+        return S_OK;
+    default:
+        return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    }
 }
 
 static HRESULT WINAPI connection_get_Attributes( _Connection *iface, LONG *attr )
 {
-    FIXME( "%p, %p\n", iface, attr );
-    return E_NOTIMPL;
+    struct connection *connection = impl_from_Connection( iface );
+    TRACE( "%p, %p\n", iface, attr );
+    *attr = connection->attributes;
+    return S_OK;
 }
 
 static HRESULT WINAPI connection_put_Attributes( _Connection *iface, LONG attr )
 {
-    FIXME( "%p, %ld\n", iface, attr );
-    return E_NOTIMPL;
+    struct connection *connection = impl_from_Connection( iface );
+    TRACE( "%p, %ld\n", iface, attr );
+    /* only retaining on commit (0x20000) and on abort (0x40000) */
+#ifndef SG_MUTANT_ADO_CONNATTR
+    if (attr & ~(0x20000 | 0x40000)) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+#endif
+    connection->attributes = attr;
+    return S_OK;
 }
 
 static HRESULT WINAPI connection_get_CursorLocation( _Connection *iface, CursorLocationEnum *cursor_loc )
@@ -868,6 +916,10 @@
     connection->refs = 1;
     connection->state = adStateClosed;
     connection->timeout = 30;
+    connection->connect_timeout = 15;
+    connection->default_database = NULL;
+    connection->isolation = adXactCursorStability;
+    connection->attributes = 0;
     connection->datasource = NULL;
     if (!(connection->provider = wcsdup( L"MSDASQL" )))
     {
