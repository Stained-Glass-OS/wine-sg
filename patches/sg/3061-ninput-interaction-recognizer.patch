+static void emit(struct interaction_context *c, INTERACTION_ID id, INTERACTION_FLAGS flags, float x, float y,
+        const void *arguments)
+{
+    INTERACTION_CONTEXT_OUTPUT output = {0};
+
+    if (!c->callback) return;
+    output.interactionId = id;
+    output.interactionFlags = flags;
+    output.inputType = c->input_type;
+    output.x = x;
+    output.y = y;
+    if (id == INTERACTION_ID_TAP && arguments) output.arguments.tap = *(const INTERACTION_ARGUMENTS_TAP *)arguments;
+    else if (id == INTERACTION_ID_MANIPULATION && arguments)
+        output.arguments.manipulation = *(const INTERACTION_ARGUMENTS_MANIPULATION *)arguments;
+    c->callback(c->data, &output);
+}
