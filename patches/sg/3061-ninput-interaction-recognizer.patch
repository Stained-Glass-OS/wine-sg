+}
+
+HRESULT WINAPI GetStateInteractionContext(HINTERACTIONCONTEXT handle, const POINTER_INFO *pointer_info,
+        INTERACTION_STATE *state)
+{
+    struct interaction_context *context = context_from_handle(handle);
+
+    TRACE("context %p, pointer_info %p, state %p.\n", context, pointer_info, state);
+
+    if (!context)
+        return E_HANDLE;
+    if (!state)
+        return E_POINTER;
+
+    if (context->hold_active || context->drag_active || context->manip_active || context->inertia_active
+            || active_pointers(context, NULL, NULL))
+        *state = INTERACTION_STATE_IN_INTERACTION;
+    else if (context->tap_pending && (context->enable[INTERACTION_ID_TAP] & INTERACTION_CONFIGURATION_FLAG_TAP_DOUBLE)
+             && (!pointer_info || pointer_info->dwTime - context->last_tap_time <= DOUBLE_TAP_TIME))
+        *state = INTERACTION_STATE_POSSIBLE_DOUBLE_TAP;
+    else
+        *state = INTERACTION_STATE_IDLE;
+    return S_OK;
+}
+
+HRESULT WINAPI ResetInteractionContext(HINTERACTIONCONTEXT handle)
+{
+    struct interaction_context *context = context_from_handle(handle);
+    unsigned int i;
+
+    TRACE("context %p.\n", context);
+
+    if (!context)
+        return E_HANDLE;
+
+    for (i = 0; i < MAX_POINTERS; i++) context->pointers[i].down = FALSE;
+    context->tap_candidate = context->hold_active = context->drag_active = context->manip_active = FALSE;
+    context->hold_cancelled = context->tap_pending = context->inertia_active = FALSE;
+    free(context->buffered);
+    context->buffered = NULL;
+    context->buffered_count = 0;
+    return S_OK;
+}
+
+HRESULT WINAPI StopInteractionContext(HINTERACTIONCONTEXT handle)
+{
+    struct interaction_context *context = context_from_handle(handle);
+    unsigned int i;
+
+    TRACE("context %p.\n", context);
+
+    if (!context)
+        return E_HANDLE;
+
+    end_interactions(context, INTERACTION_FLAG_END, context->last_cx, context->last_cy);
+    context->inertia_active = FALSE;
+    for (i = 0; i < MAX_POINTERS; i++) context->pointers[i].down = FALSE;
+    return S_OK;
+}
+
+HRESULT WINAPI ProcessInertiaInteractionContext(HINTERACTIONCONTEXT handle)
+{
+    struct interaction_context *c = context_from_handle(handle);
+    INTERACTION_ARGUMENTS_MANIPULATION args = {0};
+    float decel, dt = 16, speed;
+
+    TRACE("context %p.\n", c);
+
+    if (!c)
+        return E_HANDLE;
+    if (!c->inertia_active)
+        return S_OK;
+
+    decel = c->inertia[INERTIA_PARAMETER_TRANSLATION_DECELERATION];
+    if (decel <= 0) decel = 0.0005f; /* pixels per millisecond squared */
+
+    speed = hypotf(c->velocity.velocityX, c->velocity.velocityY);
+    if (speed <= decel * dt)
+    {
+        c->inertia_active = FALSE;
+        end_interactions(c, INTERACTION_FLAG_END | INTERACTION_FLAG_INERTIA, c->last_cx, c->last_cy);
+        return S_OK;
+    }
+
+    c->velocity.velocityX -= c->velocity.velocityX / speed * decel * dt;
+    c->velocity.velocityY -= c->velocity.velocityY / speed * decel * dt;
+    args.delta.translationX = c->velocity.velocityX * dt;
+    args.delta.translationY = c->velocity.velocityY * dt;
+    args.delta.scale = 1;
+    c->cumulative.translationX += args.delta.translationX;
+    c->cumulative.translationY += args.delta.translationY;
+    c->last_cx += args.delta.translationX;
+    c->last_cy += args.delta.translationY;
+    args.cumulative = c->cumulative;
+    args.veolcity = c->velocity;
+    args.railsState = MANIPULATION_RAILS_STATE_FREE;
+    emit(c, INTERACTION_ID_MANIPULATION, INTERACTION_FLAG_INERTIA, c->last_cx, c->last_cy, &args);
+    return S_OK;
 }
