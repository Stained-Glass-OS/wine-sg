diff --git a/dlls/ninput/tests/ninput.c b/dlls/ninput/tests/ninput.c
index 54ea6f0..e30025a 100644
--- a/dlls/ninput/tests/ninput.c
+++ b/dlls/ninput/tests/ninput.c
@@ -117,9 +117,174 @@ static void test_configuration(void)
     ok(hr == S_OK, "Failed to destroy context, hr %#lx.\n", hr);
 }
 
+struct output_log
+{
+    int count;
+    INTERACTION_CONTEXT_OUTPUT out[32];
+};
+
+static void CALLBACK output_cb(void *data, const INTERACTION_CONTEXT_OUTPUT *output)
+{
+    struct output_log *log = data;
+
+    if (log->count < ARRAY_SIZE(log->out)) log->out[log->count] = *output;
+    log->count++;
+}
+
+static POINTER_INFO make_info(UINT32 id, UINT32 flags, int x, int y, DWORD time)
+{
+    POINTER_INFO info = {0};
+
+    info.pointerType = PT_TOUCH;
+    info.pointerId = id;
+    info.pointerFlags = flags;
+    info.ptPixelLocation.x = x;
+    info.ptPixelLocation.y = y;
+    info.dwTime = time;
+    return info;
+}
+
+static void test_recognizer(void)
+{
+    static const INTERACTION_CONTEXT_CONFIGURATION tap_config[] =
+    {
+        { INTERACTION_ID_TAP, INTERACTION_CONFIGURATION_FLAG_TAP | INTERACTION_CONFIGURATION_FLAG_TAP_DOUBLE },
+        { INTERACTION_ID_HOLD, INTERACTION_CONFIGURATION_FLAG_HOLD },
+        { INTERACTION_ID_DRAG, INTERACTION_CONFIGURATION_FLAG_DRAG },
+    };
+    static const INTERACTION_CONTEXT_CONFIGURATION manip_config[] =
+    {
+        { INTERACTION_ID_MANIPULATION, INTERACTION_CONFIGURATION_FLAG_MANIPULATION
+                | INTERACTION_CONFIGURATION_FLAG_MANIPULATION_TRANSLATION_X
+                | INTERACTION_CONFIGURATION_FLAG_MANIPULATION_TRANSLATION_Y },
+    };
+    INTERACTION_CONTEXT_CONFIGURATION got[3] = {{INTERACTION_ID_TAP}, {INTERACTION_ID_HOLD}, {INTERACTION_ID_DRAG}};
+    struct output_log log = {0};
+    HINTERACTIONCONTEXT context;
+    POINTER_INFO info;
+    INTERACTION_STATE state;
+    HRESULT hr;
+    float f;
+
+    hr = CreateInteractionContext(&context);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = RegisterOutputCallbackInteractionContext(context, output_cb, &log);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = SetInteractionConfigurationInteractionContext(context, ARRAY_SIZE(tap_config), tap_config);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = GetInteractionConfigurationInteractionContext(context, ARRAY_SIZE(got), got);
+    ok(hr == S_OK && got[0].enable == (INTERACTION_CONFIGURATION_FLAG_TAP | INTERACTION_CONFIGURATION_FLAG_TAP_DOUBLE)
+            && got[2].enable == INTERACTION_CONFIGURATION_FLAG_DRAG, "Got hr %#lx.\n", hr);
+    hr = GetInteractionConfigurationInteractionContext(context, 0, got);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    hr = AddPointerInteractionContext(context, 1);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    /* a tap */
+    info = make_info(1, POINTER_FLAG_DOWN | POINTER_FLAG_INCONTACT, 100, 100, 1000);
+    hr = ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = GetStateInteractionContext(context, NULL, &state);
+    ok(hr == S_OK && state == INTERACTION_STATE_IN_INTERACTION, "Got hr %#lx, state %d.\n", hr, state);
+    ok(!log.count, "Got %d outputs.\n", log.count);
+    info = make_info(1, POINTER_FLAG_UP, 101, 100, 1050);
+    hr = ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(log.count == 1 && log.out[0].interactionId == INTERACTION_ID_TAP
+            && log.out[0].interactionFlags == (INTERACTION_FLAG_BEGIN | INTERACTION_FLAG_END)
+            && log.out[0].arguments.tap.count == 1, "Got %d outputs.\n", log.count);
+    hr = GetStateInteractionContext(context, &info, &state);
+    ok(hr == S_OK && state == INTERACTION_STATE_POSSIBLE_DOUBLE_TAP, "Got hr %#lx, state %d.\n", hr, state);
+
+    /* the second tap */
+    info = make_info(1, POINTER_FLAG_DOWN | POINTER_FLAG_INCONTACT, 101, 101, 1200);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    info = make_info(1, POINTER_FLAG_UP, 101, 101, 1250);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    ok(log.count == 2 && log.out[1].arguments.tap.count == 2, "Got %d outputs.\n", log.count);
+
+    /* a hold, which is no tap */
+    log.count = 0;
+    info = make_info(1, POINTER_FLAG_DOWN | POINTER_FLAG_INCONTACT, 50, 50, 5000);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    info = make_info(1, POINTER_FLAG_UPDATE | POINTER_FLAG_INCONTACT, 50, 50, 6000);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    ok(log.count == 1 && log.out[0].interactionId == INTERACTION_ID_HOLD
+            && log.out[0].interactionFlags == INTERACTION_FLAG_BEGIN, "Got %d outputs.\n", log.count);
+    info = make_info(1, POINTER_FLAG_UP, 50, 50, 6100);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    ok(log.count == 2 && log.out[1].interactionId == INTERACTION_ID_HOLD
+            && log.out[1].interactionFlags == INTERACTION_FLAG_END, "Got %d outputs.\n", log.count);
+
+    /* a drag */
+    log.count = 0;
+    info = make_info(1, POINTER_FLAG_DOWN | POINTER_FLAG_INCONTACT, 10, 10, 8000);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    info = make_info(1, POINTER_FLAG_UPDATE | POINTER_FLAG_INCONTACT, 40, 10, 8020);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    info = make_info(1, POINTER_FLAG_UP, 40, 10, 8040);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    ok(log.count == 2 && log.out[0].interactionId == INTERACTION_ID_DRAG
+            && log.out[0].interactionFlags == INTERACTION_FLAG_BEGIN
+            && log.out[1].interactionFlags == INTERACTION_FLAG_END, "Got %d outputs.\n", log.count);
+
+    /* a manipulation */
+    log.count = 0;
+    hr = SetInteractionConfigurationInteractionContext(context, ARRAY_SIZE(manip_config), manip_config);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    info = make_info(1, POINTER_FLAG_DOWN | POINTER_FLAG_INCONTACT, 0, 0, 9000);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    info = make_info(1, POINTER_FLAG_UPDATE | POINTER_FLAG_INCONTACT, 20, 10, 9020);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    info = make_info(1, POINTER_FLAG_UPDATE | POINTER_FLAG_INCONTACT, 30, 10, 9040);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    info = make_info(1, POINTER_FLAG_UP, 30, 10, 9050);
+    ProcessPointerFramesInteractionContext(context, 1, 1, &info);
+    ok(log.count == 3 && log.out[0].interactionId == INTERACTION_ID_MANIPULATION
+            && log.out[0].interactionFlags == INTERACTION_FLAG_BEGIN
+            && log.out[0].arguments.manipulation.delta.translationX == 20
+            && log.out[1].arguments.manipulation.cumulative.translationX == 30
+            && log.out[2].interactionFlags == INTERACTION_FLAG_END, "Got %d outputs.\n", log.count);
+
+    hr = RemovePointerInteractionContext(context, 1);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = RemovePointerInteractionContext(context, 1);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    /* parameters */
+    hr = SetInertiaParameterInteractionContext(context, INERTIA_PARAMETER_TRANSLATION_DECELERATION, 0.5f);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    f = 0;
+    hr = GetInertiaParameterInteractionContext(context, INERTIA_PARAMETER_TRANSLATION_DECELERATION, &f);
+    ok(hr == S_OK && f == 0.5f, "Got hr %#lx, %f.\n", hr, f);
+    hr = SetInertiaParameterInteractionContext(context, 99, 1.0f);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = SetMouseWheelParameterInteractionContext(context, MOUSE_WHEEL_PARAMETER_PAGE_TRANSLATION_Y, 2.0f);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    f = 0;
+    hr = GetMouseWheelParameterInteractionContext(context, MOUSE_WHEEL_PARAMETER_PAGE_TRANSLATION_Y, &f);
+    ok(hr == S_OK && f == 2.0f, "Got hr %#lx, %f.\n", hr, f);
+    hr = SetPivotInteractionContext(context, 1.0f, 2.0f, 3.0f);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    hr = ResetInteractionContext(context);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = StopInteractionContext(context);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = ProcessInertiaInteractionContext(context);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = ResetInteractionContext(NULL);
+    ok(hr == E_HANDLE, "Got hr %#lx.\n", hr);
+
+    hr = DestroyInteractionContext(context);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+}
+
 START_TEST(ninput)
 {
     test_context();
     test_properties();
     test_configuration();
+    test_recognizer();
 }
