+
+static struct pointer *find_pointer(struct interaction_context *c, UINT32 id)
+{
+    unsigned int i;
+
+    for (i = 0; i < MAX_POINTERS; i++)
+        if (c->pointers[i].added && c->pointers[i].id == id) return &c->pointers[i];
+    return NULL;
+}
+
+HRESULT WINAPI AddPointerInteractionContext(HINTERACTIONCONTEXT handle, UINT32 pointer_id)
+{
+    struct interaction_context *context = context_from_handle(handle);
+    unsigned int i;
+
+    TRACE("context %p, pointer_id %u.\n", context, pointer_id);
+
+    if (!context)
+        return E_HANDLE;
+    if (find_pointer(context, pointer_id))
+        return S_OK;
+    for (i = 0; i < MAX_POINTERS; i++)
+    {
+        if (!context->pointers[i].added)
+        {
+            memset(&context->pointers[i], 0, sizeof(context->pointers[i]));
+            context->pointers[i].id = pointer_id;
+            context->pointers[i].added = TRUE;
+            return S_OK;
+        }
+    }
+    return E_INVALIDARG;
+}
+
+HRESULT WINAPI RemovePointerInteractionContext(HINTERACTIONCONTEXT handle, UINT32 pointer_id)
+{
+    struct interaction_context *context = context_from_handle(handle);
+    struct pointer *pointer;
+
+    TRACE("context %p, pointer_id %u.\n", context, pointer_id);
+
+    if (!context)
+        return E_HANDLE;
+    if (!(pointer = find_pointer(context, pointer_id)))
+        return E_INVALIDARG;
+    pointer->added = FALSE;
+    pointer->down = FALSE;
+    return S_OK;
+}
+
+static unsigned int active_pointers(struct interaction_context *c, struct pointer **first, struct pointer **second)
+{
+    unsigned int i, n = 0;
+
+    for (i = 0; i < MAX_POINTERS; i++)
+    {
+        if (!c->pointers[i].added || !c->pointers[i].down) continue;
+        if (n == 0 && first) *first = &c->pointers[i];
+        if (n == 1 && second) *second = &c->pointers[i];
+        n++;
+    }
+    return n;
+}
+
+static void end_interactions(struct interaction_context *c, INTERACTION_FLAGS flag, float x, float y)
+{
+    if (c->hold_active) emit(c, INTERACTION_ID_HOLD, flag, x, y, NULL);
+    if (c->drag_active) emit(c, INTERACTION_ID_DRAG, flag, x, y, NULL);
+    if (c->manip_active)
+    {
+        INTERACTION_ARGUMENTS_MANIPULATION args = { .cumulative = c->cumulative, .veolcity = c->velocity };
+
+        emit(c, INTERACTION_ID_MANIPULATION, flag, x, y, &args);
+    }
+    c->hold_active = c->drag_active = c->manip_active = FALSE;
+}
+
+static BOOL manipulation_enabled(struct interaction_context *c)
+{
+    return c->enable[INTERACTION_ID_MANIPULATION] & INTERACTION_CONFIGURATION_FLAG_MANIPULATION;
+}
+
+/* Runs the recognizer after the pointers of one frame have been updated. */
+static void recognize(struct interaction_context *c, DWORD time, BOOL went_down, BOOL went_up)
+{
+    struct pointer *p1 = NULL, *p2 = NULL;
+    unsigned int n = active_pointers(c, &p1, &p2);
+    float cx = 0, cy = 0;
+
+    if (went_down && n == 1)
+    {
+        c->tap_candidate = TRUE;
+        c->hold_cancelled = FALSE;
+        c->cumulative = (MANIPULATION_TRANSFORM){ 0, 0, 1, 0, 0 };
+        c->velocity = (MANIPULATION_VELOCITY){0};
+        c->inertia_active = FALSE;
+        c->last_cx = p1->x;
+        c->last_cy = p1->y;
+        c->last_time = time;
+    }
+
+    if (n)
+    {
+        cx = p1->x;
+        cy = p1->y;
+        if (n >= 2)
+        {
+            cx = (p1->x + p2->x) / 2;
+            cy = (p1->y + p2->y) / 2;
+        }
+
+        {
+            float moved = hypotf(p1->x - p1->start_x, p1->y - p1->start_y);
+            BOOL moving = moved > MOVE_THRESHOLD || n >= 2;
+
+            if (moving && c->tap_candidate) c->tap_candidate = FALSE;
+            if (moving && c->hold_active)
+            {
+                emit(c, INTERACTION_ID_HOLD, INTERACTION_FLAG_CANCEL, p1->start_x, p1->start_y, NULL);
+                c->hold_active = FALSE;
+                c->hold_cancelled = TRUE;
+            }
+
+            if (!moving && !c->hold_active && !c->hold_cancelled && n == 1 && time - p1->down_time >= HOLD_TIME
+                    && (c->enable[INTERACTION_ID_HOLD] & INTERACTION_CONFIGURATION_FLAG_HOLD))
+            {
+                c->tap_candidate = FALSE;
+                c->hold_active = TRUE;
+                emit(c, INTERACTION_ID_HOLD, INTERACTION_FLAG_BEGIN, p1->start_x, p1->start_y, NULL);
+            }
+
+            if (moving && manipulation_enabled(c))
+            {
+                INTERACTION_ARGUMENTS_MANIPULATION args = {0};
+                UINT32 enable = c->enable[INTERACTION_ID_MANIPULATION];
+                float dist = 0, angle = 0, dt = (float)(time - c->last_time);
+                float dx = cx - c->last_cx, dy = cy - c->last_cy;
+                INTERACTION_FLAGS flags = INTERACTION_FLAG_NONE;
+
+                if (n >= 2)
+                {
+                    dist = hypotf(p2->x - p1->x, p2->y - p1->y);
+                    angle = atan2f(p2->y - p1->y, p2->x - p1->x);
+                }
+                if (!c->manip_active)
+                {
+                    flags = INTERACTION_FLAG_BEGIN;
+                    c->manip_active = TRUE;
+                    c->last_dist = dist;
+                    c->last_angle = angle;
+                    /* the movement before the threshold counts */
+                    dx = cx - p1->start_x;
+                    dy = cy - p1->start_y;
+                }
+                if (!(enable & INTERACTION_CONFIGURATION_FLAG_MANIPULATION_TRANSLATION_X)) dx = 0;
+                if (!(enable & INTERACTION_CONFIGURATION_FLAG_MANIPULATION_TRANSLATION_Y)) dy = 0;
+                args.delta.translationX = dx;
+                args.delta.translationY = dy;
+                args.delta.scale = 1;
+                if (n >= 2 && c->last_dist > 0)
+                {
+                    if (enable & INTERACTION_CONFIGURATION_FLAG_MANIPULATION_SCALING)
+                    {
+                        args.delta.scale = dist / c->last_dist;
+                        args.delta.expansion = dist - c->last_dist;
+                    }
+                    if (enable & INTERACTION_CONFIGURATION_FLAG_MANIPULATION_ROTATION)
+                        args.delta.rotation = angle - c->last_angle;
+                }
+                c->cumulative.translationX += args.delta.translationX;
+                c->cumulative.translationY += args.delta.translationY;
+                c->cumulative.scale *= args.delta.scale;
+                c->cumulative.expansion += args.delta.expansion;
+                c->cumulative.rotation += args.delta.rotation;
+                if (dt > 0)
+                {
+                    c->velocity.velocityX = args.delta.translationX / dt;
+                    c->velocity.velocityY = args.delta.translationY / dt;
+                    c->velocity.velocityExpansion = args.delta.expansion / dt;
+                    c->velocity.velocityAngular = args.delta.rotation / dt;
+                }
+                args.cumulative = c->cumulative;
+                args.veolcity = c->velocity;
+                args.railsState = MANIPULATION_RAILS_STATE_FREE;
+                emit(c, INTERACTION_ID_MANIPULATION, flags, cx, cy, &args);
+                c->last_cx = cx;
+                c->last_cy = cy;
+                c->last_dist = dist;
+                c->last_angle = angle;
+                c->last_time = time;
+            }
+            else if (moving && !c->drag_active && !c->manip_active && n == 1
+                     && (c->enable[INTERACTION_ID_DRAG] & INTERACTION_CONFIGURATION_FLAG_DRAG))
+            {
+                c->drag_active = TRUE;
+                emit(c, INTERACTION_ID_DRAG, INTERACTION_FLAG_BEGIN, p1->start_x, p1->start_y, NULL);
+            }
+        }
+    }
+
+    if (went_up && n == 0)
+    {
+        float x = c->last_cx, y = c->last_cy;
+
+        if (c->tap_candidate && (c->enable[INTERACTION_ID_TAP] & INTERACTION_CONFIGURATION_FLAG_TAP))
+        {
+            INTERACTION_ARGUMENTS_TAP args = { 1 };
+
+            if ((c->enable[INTERACTION_ID_TAP] & INTERACTION_CONFIGURATION_FLAG_TAP_DOUBLE) && c->tap_pending
+                    && time - c->last_tap_time <= DOUBLE_TAP_TIME
+                    && hypotf(x - c->last_tap_x, y - c->last_tap_y) <= 2 * MOVE_THRESHOLD)
+            {
+                args.count = 2;
+                c->tap_pending = FALSE;
+            }
+            else
+            {
+                c->tap_pending = TRUE;
+                c->last_tap_time = time;
+                c->last_tap_x = x;
+                c->last_tap_y = y;
+            }
+            emit(c, INTERACTION_ID_TAP, INTERACTION_FLAG_BEGIN | INTERACTION_FLAG_END, x, y, &args);
+        }
+        c->tap_candidate = FALSE;
+
+        if (c->manip_active && (c->enable[INTERACTION_ID_MANIPULATION]
+                & (INTERACTION_CONFIGURATION_FLAG_MANIPULATION_TRANSLATION_INERTIA
+                   | INTERACTION_CONFIGURATION_FLAG_MANIPULATION_ROTATION_INERTIA
+                   | INTERACTION_CONFIGURATION_FLAG_MANIPULATION_SCALING_INERTIA))
+                && (fabsf(c->velocity.velocityX) > 0.01f || fabsf(c->velocity.velocityY) > 0.01f))
+        {
+            /* the manipulation goes on as inertia; ProcessInertia() steps it */
+            c->inertia_active = TRUE;
+            c->hold_active = c->drag_active = FALSE;
+            return;
+        }
+        end_interactions(c, INTERACTION_FLAG_END, x, y);
+    }
+}
+
+static void process_info(struct interaction_context *c, const POINTER_INFO *info, BOOL *went_down, BOOL *went_up,
+        DWORD *time)
+{
+    struct pointer *pointer = find_pointer(c, info->pointerId);
+
+    if (!pointer)
+    {
+        if (c->filter_pointers || !(info->pointerFlags & POINTER_FLAG_DOWN)) return;
+        AddPointerInteractionContext((HINTERACTIONCONTEXT)c, info->pointerId);
+        if (!(pointer = find_pointer(c, info->pointerId))) return;
+    }
+
+    c->input_type = info->pointerType;
+    *time = info->dwTime;
+    pointer->x = info->ptPixelLocation.x;
+    pointer->y = info->ptPixelLocation.y;
+    if (info->pointerFlags & POINTER_FLAG_DOWN)
+    {
+        pointer->down = TRUE;
+        pointer->start_x = pointer->x;
+        pointer->start_y = pointer->y;
+        pointer->down_time = info->dwTime;
+        *went_down = TRUE;
+    }
+    else if (info->pointerFlags & POINTER_FLAG_UP)
+    {
+        pointer->down = FALSE;
+        *went_up = TRUE;
+    }
+}
+
+HRESULT WINAPI ProcessPointerFramesInteractionContext(HINTERACTIONCONTEXT handle, UINT32 entries_count,
+        UINT32 pointer_count, const POINTER_INFO *pointer_info)
+{
+    struct interaction_context *context = context_from_handle(handle);
+    UINT32 frame, i;
+
+    TRACE("context %p, entries_count %u, pointer_count %u, pointer_info %p.\n", context, entries_count,
+            pointer_count, pointer_info);
+
+    if (!context)
+        return E_HANDLE;
+    if (!entries_count || !pointer_count)
+        return E_INVALIDARG;
+    if (!pointer_info)
+        return E_POINTER;
+
+    /* the history is newest first: replay it from the oldest frame */
+    for (frame = entries_count; frame--; )
+    {
+        const POINTER_INFO *info = pointer_info + (SIZE_T)frame * pointer_count;
+        BOOL went_down = FALSE, went_up = FALSE;
+        DWORD time = 0;
+
+        for (i = 0; i < pointer_count; i++)
+            process_info(context, &info[i], &went_down, &went_up, &time);
+        recognize(context, time, went_down, went_up);
+    }
+    return S_OK;
+}
+
+HRESULT WINAPI BufferPointerPacketsInteractionContext(HINTERACTIONCONTEXT handle, UINT32 entries_count,
+        const POINTER_INFO *pointer_info)
+{
+    struct interaction_context *context = context_from_handle(handle);
+    POINTER_INFO *buffer;
+
+    TRACE("context %p, entries_count %u, pointer_info %p.\n", context, entries_count, pointer_info);
 
     if (!context)
         return E_HANDLE;
+    if (!entries_count)
+        return E_INVALIDARG;
+    if (!pointer_info)
+        return E_POINTER;
+    if (entries_count > MAX_BUFFERED - context->buffered_count)
+        return E_INVALIDARG;
 
+    if (!(buffer = realloc(context->buffered, (context->buffered_count + entries_count) * sizeof(*buffer))))
+        return E_OUTOFMEMORY;
+    context->buffered = buffer;
+    /* the packets arrive newest first, as in a history */
+    memcpy(buffer + context->buffered_count, pointer_info, entries_count * sizeof(*buffer));
+    context->buffered_count += entries_count;
     return S_OK;
 }
 
