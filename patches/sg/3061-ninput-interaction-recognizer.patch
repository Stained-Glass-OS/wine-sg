+
+    TRACE("context %p, threshold %u, distance %p.\n", context, threshold, distance);
+
+    if (!context)
+        return E_HANDLE;
+    if (!distance)
+        return E_POINTER;
+    if (threshold >= CROSS_SLIDE_THRESHOLD_COUNT)
+        return E_INVALIDARG;
+    *distance = context->cross_slide[threshold];
+    return S_OK;
