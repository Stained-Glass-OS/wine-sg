+    UINT32 i;
+
+    TRACE("context %p, count %u, parameters %p.\n", context, count, parameters);
+
+    if (!context)
+        return E_HANDLE;
+    if (!count)
+        return E_INVALIDARG;
+    if (!parameters)
+        return E_POINTER;
+    for (i = 0; i < count; i++)
+        if (parameters[i].threshold >= CROSS_SLIDE_THRESHOLD_COUNT)
