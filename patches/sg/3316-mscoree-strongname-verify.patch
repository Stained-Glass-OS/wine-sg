+
+/*
+ * Strong name signatures of assemblies on disk (ECMA-335 II.6.2): the signature is an RSA signature
+ * over a hash of the image. The hash covers the DOS header and stub, the PE headers with the
+ * checksum and the certificate directory entry cleared, the section headers, and the raw data of
+ * every section except the signature itself (the headers between the section table and the first
+ * section, and data after the last section such as an Authenticode block, are not hashed).
+ */
+
+#define SN_MAX_FILE   0x40000000
+#define SN_SECTION_SIZE 40
+
+struct sn_image
+{
+    BYTE   *data;
+    DWORD   size;
+    DWORD   pe_off;        /* offset of the PE signature */
+    DWORD   opt_off;       /* offset of the optional header */
+    DWORD   opt_size;
+    DWORD   sect_off;      /* offset of the section table */
+    DWORD   nsect;
+    DWORD   check_off;     /* checksum field */
+    DWORD   cert_off;      /* certificate table directory entry (8 bytes) */
+    DWORD   cor_off;       /* offset of the CLR header */
+    DWORD   cor_flags;
+    DWORD   sig_off;       /* strong name signature: file offset and size, 0 if none */
+    DWORD   sig_len;
+};
+
+static inline DWORD rd32( const BYTE *p ) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((DWORD)p[3] << 24); }
+static inline WORD rd16( const BYTE *p ) { return p[0] | (p[1] << 8); }
+
+static BOOL rva_to_offset( const struct sn_image *img, DWORD rva, DWORD *off )
+{
+    DWORD i;
+
+    for (i = 0; i < img->nsect; i++)
+    {
+        const BYTE *s = img->data + img->sect_off + i * SN_SECTION_SIZE;
+        DWORD vsize = rd32( s + 8 ), va = rd32( s + 12 ), rsize = rd32( s + 16 ), raw = rd32( s + 20 );
+
+        if (!vsize || vsize < rsize) vsize = rsize;
+        if (rva >= va && rva - va < vsize)
+        {
+            *off = raw + (rva - va);
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static BOOLEAN read_file( const WCHAR *path, BYTE **data, DWORD *size )
+{
+    LARGE_INTEGER len;
+    HANDLE file;
+    DWORD read;
+    BYTE *buf;
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,
+                        FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return fail( HRESULT_FROM_WIN32( GetLastError() ) );
+    if (!GetFileSizeEx( file, &len ) || len.QuadPart > SN_MAX_FILE)
+    {
+        CloseHandle( file );
+        return fail( len.QuadPart > SN_MAX_FILE ? CORSEC_E_INVALID_IMAGE_FORMAT : HRESULT_FROM_WIN32( GetLastError() ) );
+    }
+    if (!(buf = malloc( len.LowPart ? len.LowPart : 1 )))
+    {
+        CloseHandle( file );
+        return fail( E_OUTOFMEMORY );
+    }
+    if (!ReadFile( file, buf, len.LowPart, &read, NULL ) || read != len.LowPart)
+    {
+        free( buf );
+        CloseHandle( file );
+        return fail( HRESULT_FROM_WIN32( GetLastError() ) );
+    }
+    CloseHandle( file );
+    *data = buf;
+    *size = len.LowPart;
+    return TRUE;
+}
+
+/* locate the parts of the image the signature depends on */
+static BOOLEAN parse_image( struct sn_image *img, BYTE *data, DWORD size )
+{
+    DWORD dd, off;
+    BOOL pe32plus;
+
+    memset( img, 0, sizeof(*img) );
+    img->data = data;
+    img->size = size;
+
+    if (size < 0x40 || data[0] != 'M' || data[1] != 'Z') return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+    img->pe_off = rd32( data + 0x3c );
+    if (img->pe_off < 0x40 || img->pe_off > size || size - img->pe_off < 24 + 2 ||
+        rd32( data + img->pe_off ) != 0x4550)
+        return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+    img->nsect = rd16( data + img->pe_off + 6 );
+    img->opt_size = rd16( data + img->pe_off + 20 );
+    img->opt_off = img->pe_off + 24;
+    if (img->opt_size < 2 || img->opt_size > size - img->opt_off) return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+    pe32plus = rd16( data + img->opt_off ) == 0x20b;
+    if (!pe32plus && rd16( data + img->opt_off ) != 0x10b) return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+
+    dd = pe32plus ? 112 : 96;
+    img->sect_off = img->opt_off + img->opt_size;
+    if (img->nsect > (size - img->sect_off) / SN_SECTION_SIZE) return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+    if (img->opt_size < dd + 15 * 8) return fail( CORSEC_E_INVALID_IMAGE_FORMAT );  /* no CLR directory */
+    img->check_off = img->opt_off + 64;
+    img->cert_off = img->opt_off + dd + 4 * 8;
+
+    off = rd32( data + img->opt_off + dd + 14 * 8 );
+    if (!off || !rva_to_offset( img, off, &off ) || off > size || size - off < 48)
+        return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+    img->cor_off = off;
+    img->cor_flags = rd32( data + off + 16 );
+    if (rd32( data + off + 36 ))   /* size of the strong name signature directory */
+    {
+        img->sig_len = rd32( data + off + 36 );
+        if (!rva_to_offset( img, rd32( data + off + 32 ), &img->sig_off ) ||
+            img->sig_off > size || img->sig_len > size - img->sig_off)
+            return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+    }
+    return TRUE;
+}
+
+/* the hash of the image; each part is fed to CryptHashData in the order above */
+static BOOLEAN hash_image( const struct sn_image *img, HCRYPTHASH hash )
+{
+    BYTE *head;
+    DWORD i, hlen = img->sect_off;
+
+    /* DOS header and stub, then the NT headers with the checksum and certificate entry cleared */
+    if (!(head = malloc( hlen ))) return fail( E_OUTOFMEMORY );
+    memcpy( head, img->data, hlen );
+#ifndef SG_MUTANT_SNV_CHECKSUM
+    memset( head + img->check_off, 0, 4 );
+#endif
+    if (img->cert_off + 8 <= hlen) memset( head + img->cert_off, 0, 8 );
+    if (!CryptHashData( hash, head, hlen, 0 )) { free( head ); return fail_crypt(); }
+    free( head );
+
+    if (!CryptHashData( hash, img->data + img->sect_off, img->nsect * SN_SECTION_SIZE, 0 )) return fail_crypt();
+
+    for (i = 0; i < img->nsect; i++)
+    {
+        const BYTE *s = img->data + img->sect_off + i * SN_SECTION_SIZE;
+        DWORD rsize = rd32( s + 16 ), raw = rd32( s + 20 );
+
+        if (raw > img->size || rsize > img->size - raw) return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+#ifdef SG_MUTANT_SNV_LASTSECT
+        if (i == img->nsect - 1) continue;
+#endif
+        if (img->sig_len && img->sig_off >= raw && img->sig_off < raw + rsize)
+        {
+            DWORD before = img->sig_off - raw, after;
+
+            if (img->sig_len > rsize - before) return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+            after = rsize - before - img->sig_len;
+            if (before && !CryptHashData( hash, img->data + raw, before, 0 )) return fail_crypt();
+            if (after && !CryptHashData( hash, img->data + img->sig_off + img->sig_len, after, 0 )) return fail_crypt();
+        }
+        else if (rsize && !CryptHashData( hash, img->data + raw, rsize, 0 )) return fail_crypt();
+    }
+    return TRUE;
+}
+
+static const BYTE ecma_key[16] = { 0, 0, 0, 0, 0, 0, 0, 0, 4, 0, 0, 0, 0, 0, 0, 0 };
+
+struct sn_assembly
+{
+    BYTE   *key;           /* the public key blob of the assembly (copy), NULL if none */
+    ULONG   key_len;
+    WCHAR   name[260];
+    DWORD   flags;
+};
+
+/* the manifest's public key and name, through the metadata engine */
+static BOOLEAN read_assembly( const struct sn_image *img, struct sn_assembly *as )
+{
+    IMetaDataAssemblyImport *import;
+    const void *key;
+    ULONG key_len = 0, len;
+    mdAssembly token;
+    HRESULT hr;
+
+    memset( as, 0, sizeof(*as) );
+    if (FAILED(hr = MetaData_OpenMemory( img->data, img->size, &IID_IMetaDataAssemblyImport, (IUnknown **)&import )))
+        return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+    if (SUCCEEDED(hr = IMetaDataAssemblyImport_GetAssemblyFromScope( import, &token )) &&
+        SUCCEEDED(hr = IMetaDataAssemblyImport_GetAssemblyProps( import, token, &key, &key_len, NULL, as->name,
+                                                                 ARRAY_SIZE(as->name), &len, NULL, &as->flags )))
+    {
+        if (key_len && !(as->key = malloc( key_len ))) hr = E_OUTOFMEMORY;
+        else if (key_len) { memcpy( as->key, key, key_len ); as->key_len = key_len; }
+    }
+    IMetaDataAssemblyImport_Release( import );
+    if (FAILED(hr)) return fail( hr == E_OUTOFMEMORY ? hr : CORSEC_E_MISSING_STRONGNAME );
+    return TRUE;
+}
+
+static BOOLEAN token_of_blob( const BYTE *blob, ULONG len, BYTE token[8] )
+{
+    HCRYPTPROV prov;
+    HCRYPTHASH hash;
+    BYTE digest[20];
+    DWORD size = sizeof(digest);
+    BOOLEAN ret = FALSE;
+    int i;
+
+    if (!CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT )) return fail_crypt();
+    if (CryptCreateHash( prov, CALG_SHA1, 0, 0, &hash ))
+    {
+        ret = CryptHashData( hash, blob, len, 0 ) && CryptGetHashParam( hash, HP_HASHVAL, digest, &size, 0 );
+        CryptDestroyHash( hash );
+    }
+    if (!ret) fail_crypt();
+    CryptReleaseContext( prov, 0 );
+    if (ret) for (i = 0; i < 8; i++) token[i] = digest[19 - i];
+    return ret;
+}
+
+/* HKLM\Software\Microsoft\StrongName\Verification\<name>,<token>: assemblies registered to skip verification */
+static BOOL skip_registered( const struct sn_assembly *as )
+{
+    static const WCHAR hex[] = L"0123456789abcdef";
+    WCHAR token[17] = L"*", keyname[300];
+    BYTE tok[8];
+    HKEY root, sub;
+    const WCHAR *names[2] = { as->name, L"*" };
+    const WCHAR *tokens[2];
+    BOOL ret = FALSE;
+    int i, j;
+
+    if (as->key && token_of_blob( as->key, as->key_len, tok ))
+    {
+        for (i = 0; i < 8; i++) { token[i * 2] = hex[tok[i] >> 4]; token[i * 2 + 1] = hex[tok[i] & 15]; }
+        token[16] = 0;
+    }
+    tokens[0] = token;
+    tokens[1] = L"*";
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\StrongName\\Verification", 0, KEY_READ, &root ))
+        return FALSE;
+    for (i = 0; i < 2 && !ret; i++)
+        for (j = 0; j < 2 && !ret; j++)
+        {
+            swprintf( keyname, ARRAY_SIZE(keyname), L"%s,%s", names[i], tokens[j] );
+            if (!RegOpenKeyExW( root, keyname, 0, KEY_READ, &sub )) { RegCloseKey( sub ); ret = TRUE; }
+        }
+    RegCloseKey( root );
+    return ret;
+}
+
+/* verify the signature; FALSE with the error set when the image is not validly signed */
+static BOOLEAN verify_image( const struct sn_image *img, const struct sn_assembly *as )
+{
+    const struct sn_public_key *pk = (const struct sn_public_key *)as->key;
+    const RSAPUBKEY *rsa;
+    HCRYPTPROV prov;
+    HCRYPTHASH hash;
+    HCRYPTKEY key;
+    ALG_ID alg;
+    BOOLEAN ret = FALSE;
+
+    if (!as->key || !as->key_len || !(as->flags & 1 /* afPublicKey */)) return fail( CORSEC_E_MISSING_STRONGNAME );
+    /* the ECMA key marks standard-library assemblies: there is no signature to check */
+    if (as->key_len == sizeof(ecma_key) && !memcmp( as->key, ecma_key, sizeof(ecma_key) )) return TRUE;
+    if (!check_public_key( as->key, as->key_len, &rsa )) return fail( CORSEC_E_INVALID_PUBLICKEY );
+    if (!(img->cor_flags & COMIMAGE_FLAGS_STRONGNAMESIGNED) || !img->sig_len) return fail( CORSEC_E_INVALID_STRONGNAME );
+    if (img->sig_len != rsa->bitlen / 8) return fail( CORSEC_E_INVALID_STRONGNAME );
+
+    alg = pk->hash_alg ? pk->hash_alg : CALG_SHA1;
+    if (!CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_AES, CRYPT_VERIFYCONTEXT )) return fail_crypt();
+    if (CryptImportKey( prov, pk->blob, pk->len, 0, 0, &key ))
+    {
+        if (CryptCreateHash( prov, alg, 0, 0, &hash ))
+        {
+            if (hash_image( img, hash ))
+            {
+                /* the signature is stored little-endian, as CryptVerifySignature takes it */
+#ifndef SG_MUTANT_SNV_ACCEPT
+                if (CryptVerifySignatureW( hash, img->data + img->sig_off, img->sig_len, key, NULL, 0 )) ret = TRUE;
+#ifdef SG_MUTANT_SNV_ZERO
+                else if (!*(DWORD *)(img->data + img->sig_off)) ret = TRUE;   /* a delay-signed image */
+#endif
+                else fail( CORSEC_E_INVALID_STRONGNAME );
+#else
+                ret = TRUE;
+#endif
+            }
+            CryptDestroyHash( hash );
+        }
+        else fail_crypt();
+        CryptDestroyKey( key );
+    }
+    else fail_crypt();
+    CryptReleaseContext( prov, 0 );
+    return ret;
+}
+
+static BOOLEAN verify_file( const WCHAR *path, BOOLEAN force, BOOLEAN *performed )
+{
+    struct sn_image img;
+    struct sn_assembly as;
+    BYTE *data;
+    DWORD size;
+    BOOLEAN ret;
+
+    *performed = FALSE;
+    if (!path) return fail( E_POINTER );
+    if (!read_file( path, &data, &size )) return FALSE;
+    if (!parse_image( &img, data, size ) || !read_assembly( &img, &as ))
+    {
+        free( data );
+        return FALSE;
+    }
+    if (!force && skip_registered( &as ))
+    {
+#ifndef SG_MUTANT_SNV_SKIP
+        ret = TRUE;
+#else
+        ret = verify_image( &img, &as );
+#endif
+    }
+    else
+    {
+        ret = verify_image( &img, &as );
+        *performed = ret;
+    }
+    free( as.key );
+    free( data );
+    return ret;
+}
+
+BOOLEAN WINAPI StrongNameSignatureVerification( const WCHAR *path, DWORD flags, DWORD *out_flags )
+{
+    BOOLEAN performed, ret;
+
+    TRACE( "(%s, %#lx, %p)\n", debugstr_w(path), flags, out_flags );
+
+    ret = verify_file( path, (flags & SN_INFLAG_FORCE_VER) != 0, &performed );
+    if (out_flags) *out_flags = performed ? SN_OUTFLAG_WAS_VERIFIED : 0;
+    return ret;
+}
+
+BOOLEAN WINAPI StrongNameSignatureVerificationEx( const WCHAR *path, BOOLEAN force, BOOLEAN *verified )
+{
+    BOOLEAN performed, ret;
+
+    TRACE( "(%s, %u, %p)\n", debugstr_w(path), force, verified );
+
+    ret = verify_file( path, force, &performed );
+    if (verified) *verified = performed;
+    return ret;
+}
+
+static BOOLEAN token_from_assembly( const WCHAR *path, BYTE **token, ULONG *token_len, BYTE **key, ULONG *key_len )
+{
+    struct sn_image img;
+    struct sn_assembly as;
+    BYTE *data, *out;
+    DWORD size;
+
+    if (!path || !token || !token_len) return fail( E_POINTER );
+    if (!read_file( path, &data, &size )) return FALSE;
+    if (!parse_image( &img, data, size ) || !read_assembly( &img, &as ))
+    {
+        free( data );
+        return FALSE;
+    }
+    free( data );
+    if (!as.key || !as.key_len)
+    {
+        free( as.key );
+        return fail( CORSEC_E_MISSING_STRONGNAME );
+    }
+    if (!(out = malloc( 8 )))
+    {
+        free( as.key );
+        return fail( E_OUTOFMEMORY );
+    }
+    if (!token_of_blob( as.key, as.key_len, out ))
+    {
+        free( as.key );
+        free( out );
+        return FALSE;
+    }
+    *token = out;
+    *token_len = 8;
+    if (key) { *key = as.key; *key_len = as.key_len; }
+    else free( as.key );
+    return TRUE;
+}
+
+BOOLEAN WINAPI StrongNameTokenFromAssembly( const WCHAR *path, BYTE **token, ULONG *token_len )
+{
+    TRACE( "(%s, %p, %p)\n", debugstr_w(path), token, token_len );
+    return token_from_assembly( path, token, token_len, NULL, NULL );
+}
+
+BOOLEAN WINAPI StrongNameTokenFromAssemblyEx( const WCHAR *path, BYTE **token, ULONG *token_len,
+                                              BYTE **key, ULONG *key_len )
+{
+    TRACE( "(%s, %p, %p, %p, %p)\n", debugstr_w(path), token, token_len, key, key_len );
+    if (!key || !key_len) return fail( E_POINTER );
+    return token_from_assembly( path, token, token_len, key, key_len );
+}
