 BOOLEAN __stdcall StrongNameTokenFromAssembly(const WCHAR *path, BYTE **token, ULONG *size);
+BOOLEAN __stdcall StrongNameTokenFromAssemblyEx(const WCHAR *path, BYTE **token, ULONG *size, BYTE **key, ULONG *key_len);
 
 #define SN_LEAVE_KEY            0x00000001
 
