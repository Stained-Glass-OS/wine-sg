     IMetaDataDispenserEx_Release(dispenser);
     return hr;
 }
+
+/* a read-only scope over an assembly image in memory */
+HRESULT MetaData_OpenMemory(const void *data, ULONG size, REFIID riid, IUnknown **obj)
+{
+    IMetaDataDispenserEx *dispenser;
+    IUnknown *unk;
+    HRESULT hr;
+
+    *obj = NULL;
+    if (FAILED(hr = MetaDataDispenser_CreateInstance(&unk))) return hr;
+    hr = IUnknown_QueryInterface(unk, &IID_IMetaDataDispenserEx, (void **)&dispenser);
+    IUnknown_Release(unk);
+    if (FAILED(hr)) return hr;
+    hr = IMetaDataDispenserEx_OpenScopeOnMemory(dispenser, data, size, 0, riid, obj);
+    IMetaDataDispenserEx_Release(dispenser);
+    return hr;
+}
