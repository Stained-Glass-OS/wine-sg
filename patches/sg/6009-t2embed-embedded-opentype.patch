From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] t2embed: Embedded OpenType (6009)

TTEmbedFont, TTEmbedFontFromFileA, TTGetEmbeddedFontInfo,
TTLoadEmbeddedFont (with a new family name), TTDeleteEmbeddedFont and
TTEnableEmbeddingForFacename, in the EOT format, with embedding levels from
fsType and XOR encryption (G-EOT).
---
diff --git a/dlls/t2embed/main.c b/dlls/t2embed/main.c
index c4ceec1..1414111 100644
--- a/dlls/t2embed/main.c
+++ b/dlls/t2embed/main.c
@@ -18,6 +18,7 @@
  */
 
 #include <stdarg.h>
+#include <stdlib.h>
 
 #include "windef.h"
 #include "winbase.h"
@@ -28,31 +29,474 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(t2embed);
 
+/* Stained Glass OS: fonts embedded in documents, in the Embedded OpenType
+ * structure (the EOT file format, W3C member submission 2008): a header naming
+ * the font (OS/2 and name table data, embedding permissions) followed by the
+ * font's data, optionally XOR-encrypted. MicroType Express compression and
+ * subsetting are not done: the whole font is embedded uncompressed, which every
+ * reader of the structure accepts. */
+
+#define EOT_MAGIC        0x504c
+#define EOT_VERSION_1    0x00010000
+#define EOT_VERSION_2_1  0x00020001
+#define EOT_VERSION_2_2  0x00020002
+
+static WORD get_be16( const BYTE *p ) { return (p[0] << 8) | p[1]; }
+static DWORD get_be32( const BYTE *p ) { return ((DWORD)p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3]; }
+static void put_be16( BYTE *p, WORD v ) { p[0] = v >> 8; p[1] = v; }
+static void put_be32( BYTE *p, DWORD v ) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }
+
+/* a table of an sfnt font in memory */
+static const BYTE *find_table( const BYTE *font, DWORD size, DWORD tag, DWORD *length )
+{
+    DWORD count, i, offset, len;
+
+    if (size < 12) return NULL;
+    count = get_be16( font + 4 );
+    if (12 + count * 16 > size) return NULL;
+    for (i = 0; i < count; i++)
+    {
+        const BYTE *entry = font + 12 + i * 16;
+        if (get_be32( entry ) != tag) continue;
+        offset = get_be32( entry + 8 );
+        len = get_be32( entry + 12 );
+        if (offset > size || len > size - offset) return NULL;
+        *length = len;
+        return font + offset;
+    }
+    return NULL;
+}
+
+#define TAG(a,b,c,d) (((DWORD)(a) << 24) | ((DWORD)(b) << 16) | ((DWORD)(c) << 8) | (DWORD)(d))
+
+/* a name (Windows platform, Unicode, US English first) as little-endian UTF-16 */
+static WCHAR *get_font_name( const BYTE *font, DWORD size, WORD id, USHORT *bytes )
+{
+    const BYTE *name, *rec, *best = NULL;
+    DWORD len, count, strings, i;
+    WCHAR *ret;
+
+    *bytes = 0;
+    if (!(name = find_table( font, size, TAG('n','a','m','e'), &len )) || len < 6) return NULL;
+    count = get_be16( name + 2 );
+    strings = get_be16( name + 4 );
+    for (i = 0; i < count && 6 + (i + 1) * 12 <= len; i++)
+    {
+        rec = name + 6 + i * 12;
+        if (get_be16( rec ) != 3 || get_be16( rec + 2 ) != 1 || get_be16( rec + 6 ) != id) continue;
+        if (!best || get_be16( rec + 4 ) == 0x409) best = rec;
+    }
+    if (!best) return NULL;
+    len -= min( len, strings + get_be16( best + 10 ) );
+    len = min( len, get_be16( best + 8 ) ) & ~1;
+    if (!(ret = malloc( len + sizeof(WCHAR) ))) return NULL;
+    for (i = 0; i < len / 2; i++)
+        ret[i] = get_be16( name + strings + get_be16( best + 10 ) + i * 2 );
+    ret[len / 2] = 0;
+    *bytes = len;
+    return ret;
+}
+
+static ULONG embed_level( WORD fstype )
+{
+    fstype &= 0xf;
+    if (fstype == LICENSE_INSTALLABLE) return EMBED_INSTALLABLE;
+    if (fstype & LICENSE_EDITABLE) return EMBED_EDITABLE;
+    if (fstype & LICENSE_PREVIEWPRINT) return EMBED_PREVIEWPRINT;
+    if (fstype & LICENSE_NOEMBEDDING) return EMBED_NOEMBEDDING;
+    return EMBED_INSTALLABLE;
+}
+
+struct buffer
+{
+    BYTE *data;
+    DWORD size, used;
+};
+
+static BOOL buffer_add( struct buffer *b, const void *data, DWORD size )
+{
+    if (b->used + size > b->size)
+    {
+        DWORD new_size = max( b->size * 2, b->used + size + 256 );
+        BYTE *new_data = realloc( b->data, new_size );
+        if (!new_data) return FALSE;
+        b->data = new_data;
+        b->size = new_size;
+    }
+    memcpy( b->data + b->used, data, size );
+    b->used += size;
+    return TRUE;
+}
+
+static BOOL buffer_add16( struct buffer *b, USHORT v ) { return buffer_add( b, &v, sizeof(v) ); }
+static BOOL buffer_add32( struct buffer *b, ULONG v ) { return buffer_add( b, &v, sizeof(v) ); }
+
+static BOOL buffer_add_name( struct buffer *b, const WCHAR *name, USHORT bytes )
+{
+    return buffer_add16( b, 0 ) && buffer_add16( b, bytes ) && (!bytes || buffer_add( b, name, bytes ));
+}
+
+/* the EOT structure of the font data */
+static LONG embed_font_data( const BYTE *font, DWORD size, ULONG flags, ULONG *priv_status, ULONG *status,
+                             WRITEEMBEDPROC write, void *stream, TTEMBEDINFO *info )
+{
+    const BYTE *os2, *head;
+    DWORD os2_len, head_len, i;
+    struct buffer b = { 0 };
+    WCHAR *names[4];
+    USHORT bytes[4];
+    static const WORD ids[4] = { 1, 2, 5, 4 }; /* family, style, version, full */
+    BYTE byte;
+    WORD fstype;
+    LONG ret = E_NONE;
+    BYTE *data;
+
+    if (!(os2 = find_table( font, size, TAG('O','S','/','2'), &os2_len )) || os2_len < 78) return E_NOOS2;
+    if (!(head = find_table( font, size, TAG('h','e','a','d'), &head_len )) || head_len < 12) return E_FONTDATAINVALID;
+    fstype = get_be16( os2 + 8 );
+    *priv_status = embed_level( fstype );
+#ifndef SG_MUTANT_EOT_IGNORE_PERMISSIONS
+    if (*priv_status == EMBED_NOEMBEDDING) return E_FONTNOTEMBEDDABLE;
+#endif
+    *status = 0;
+
+    for (i = 0; i < 4; i++) names[i] = get_font_name( font, size, ids[i], &bytes[i] );
+
+    buffer_add32( &b, 0 );                       /* EOTSize, below */
+    buffer_add32( &b, size );                    /* FontDataSize */
+    buffer_add32( &b, EOT_VERSION_2_1 );
+    buffer_add32( &b, flags & TTEMBED_XORENCRYPTDATA );
+    buffer_add( &b, os2 + 32, 10 );              /* PANOSE */
+    byte = DEFAULT_CHARSET;
+    buffer_add( &b, &byte, 1 );
+    byte = (get_be16( os2 + 62 ) & 1) ? 1 : 0;   /* fsSelection italic */
+    buffer_add( &b, &byte, 1 );
+    buffer_add32( &b, get_be16( os2 + 4 ) );     /* usWeightClass */
+    buffer_add16( &b, fstype );
+    buffer_add16( &b, EOT_MAGIC );
+    for (i = 0; i < 4; i++) buffer_add32( &b, get_be32( os2 + 42 + i * 4 ) );       /* ulUnicodeRange1..4 */
+    for (i = 0; i < 2; i++) buffer_add32( &b, os2_len >= 86 ? get_be32( os2 + 78 + i * 4 ) : 0 ); /* ulCodePageRange */
+    buffer_add32( &b, get_be32( head + 8 ) );    /* checkSumAdjustment */
+    for (i = 0; i < 4; i++) buffer_add32( &b, 0 );
+    for (i = 0; i < 4; i++) buffer_add_name( &b, names[i], bytes[i] );
+    /* the root string: the documents (URLs) the font may be used with */
+    if (info && info->usRootStrSize && info->pusRootStr)
+        buffer_add_name( &b, info->pusRootStr, info->usRootStrSize * sizeof(WCHAR) );
+    else
+        buffer_add_name( &b, NULL, 0 );
+    if (!buffer_add( &b, font, size )) ret = E_NOFREEMEMORY;
+    for (i = 0; i < 4; i++) free( names[i] );
+    if (ret) goto done;
+
+    *(ULONG *)b.data = b.used;
+    if (flags & TTEMBED_XORENCRYPTDATA)
+    {
+#ifndef SG_MUTANT_EOT_NO_XOR
+        data = b.data + b.used - size;
+        for (i = 0; i < size; i++) data[i] ^= 0x50;
+#endif
+    }
+    if (write( stream, b.data, b.used ) != b.used) ret = E_SAVETOSTREAMFAILED;
+done:
+    free( b.data );
+    return ret;
+}
+
+static LONG embed_font_from_dc( HDC hdc, BYTE **data, DWORD *size )
+{
+    DWORD len;
+
+    if (!hdc) return E_HDCINVALID;
+    if ((len = GetFontData( hdc, 0, 0, NULL, 0 )) == GDI_ERROR || !len) return E_NOTATRUETYPEFONT;
+    if (!(*data = malloc( len ))) return E_NOFREEMEMORY;
+    if (GetFontData( hdc, 0, 0, *data, len ) != len)
+    {
+        free( *data );
+        return E_ERRORACCESSINGFONTDATA;
+    }
+    *size = len;
+    return E_NONE;
+}
+
+static LONG check_embed_args( ULONG flags, ULONG charset, ULONG *priv_status, ULONG *status, WRITEEMBEDPROC write,
+                              void *stream, USHORT *chars, USHORT char_count )
+{
+    if (!priv_status) return E_PRIVSTATUSINVALID;
+    if (!status) return E_STATUSINVALID;
+    if (!write || !stream) return E_STREAMINVALID;
+    if ((flags & TTEMBED_SUBSET) && (!chars || !char_count))
+        return !chars ? E_CHARCODESETINVALID : E_CHARCODECOUNTINVALID;
+    if (charset != CHARSET_UNICODE && charset != CHARSET_SYMBOL && charset != CHARSET_GLYPHIDX) return E_CHARCODESETINVALID;
+    return E_NONE;
+}
+
+LONG WINAPI TTEmbedFont(HDC hDC, ULONG ulFlags, ULONG ulCharSet, ULONG *pulPrivStatus,
+                         ULONG *pulStatus, WRITEEMBEDPROC lpfnWriteToStream, LPVOID lpvWriteStream,
+                         USHORT *pusCharCodeSet, USHORT usCharCodeCount, USHORT usLanguage,
+                         TTEMBEDINFO *pTTEmbedInfo)
+{
+    BYTE *data;
+    DWORD size;
+    LONG ret;
+
+    TRACE("%p, %#lx, %lu, %p, %p, %p, %p, %p, %u, %u, %p\n", hDC,
+          ulFlags, ulCharSet, pulPrivStatus, pulStatus, lpfnWriteToStream,
+          lpvWriteStream, pusCharCodeSet, usCharCodeCount, usLanguage,
+          pTTEmbedInfo);
+
+    if ((ret = check_embed_args( ulFlags, ulCharSet, pulPrivStatus, pulStatus, lpfnWriteToStream, lpvWriteStream,
+                                 pusCharCodeSet, usCharCodeCount ))) return ret;
+    if ((ret = embed_font_from_dc( hDC, &data, &size ))) return ret;
+    ret = embed_font_data( data, size, ulFlags, pulPrivStatus, pulStatus, lpfnWriteToStream, lpvWriteStream, pTTEmbedInfo );
+    free( data );
+    return ret;
+}
+
+LONG WINAPI TTEmbedFontFromFileA(HDC hDC, LPCSTR szFontFileName, USHORT usTTCIndex, ULONG ulFlags,
+                                 ULONG ulCharSet, ULONG *pulPrivStatus, ULONG *pulStatus,
+                                 WRITEEMBEDPROC lpfnWriteToStream, LPVOID lpvWriteStream,
+                                 USHORT *pusCharCodeSet, USHORT usCharCodeCount, USHORT usLanguage,
+                                 TTEMBEDINFO *pTTEmbedInfo)
+{
+    HANDLE file;
+    BYTE *data;
+    DWORD size, read;
+    LONG ret;
+
+    TRACE("%p, %s, %u, %#lx, %lu\n", hDC, debugstr_a(szFontFileName), usTTCIndex, ulFlags, ulCharSet);
+
+    if ((ret = check_embed_args( ulFlags, ulCharSet, pulPrivStatus, pulStatus, lpfnWriteToStream, lpvWriteStream,
+                                 pusCharCodeSet, usCharCodeCount ))) return ret;
+    if (!szFontFileName) return E_FILE_NOT_FOUND;
+    file = CreateFileA( szFontFileName, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return E_FILE_NOT_FOUND;
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || !(data = malloc( size )))
+    {
+        CloseHandle( file );
+        return E_NOFREEMEMORY;
+    }
+    ReadFile( file, data, size, &read, NULL );
+    CloseHandle( file );
+    if (read != size) ret = E_ERRORREADINGFONTDATA;
+    else if (size >= 12 && get_be32( data ) == TAG('t','t','c','f'))
+    {
+        /* a collection: the font at the index, as a font file of its own */
+        DWORD count = get_be32( data + 8 ), offset, tables, i, total, pos;
+        BYTE *one;
+
+        if (usTTCIndex >= count || 12 + count * 4 > size) ret = E_TTC_INDEX_OUT_OF_RANGE;
+        else if ((offset = get_be32( data + 12 + usTTCIndex * 4 )) + 12 > size) ret = E_FONTDATAINVALID;
+        else
+        {
+            tables = get_be16( data + offset + 4 );
+            total = 12 + tables * 16;
+            for (i = 0; i < tables && offset + 12 + (i + 1) * 16 <= size; i++)
+                total += (get_be32( data + offset + 12 + i * 16 + 12 ) + 3) & ~3;
+            if (!(one = calloc( 1, total ))) ret = E_NOFREEMEMORY;
+            else
+            {
+                memcpy( one, data + offset, 12 + tables * 16 );
+                pos = 12 + tables * 16;
+                for (i = 0; i < tables; i++)
+                {
+                    BYTE *entry = one + 12 + i * 16;
+                    DWORD toff = get_be32( entry + 8 ), tlen = get_be32( entry + 12 );
+                    if (toff > size || tlen > size - toff || pos + tlen > total) { ret = E_FONTDATAINVALID; break; }
+                    memcpy( one + pos, data + toff, tlen );
+                    put_be32( entry + 8, pos );
+                    pos += (tlen + 3) & ~3;
+                }
+                if (!ret) ret = embed_font_data( one, total, ulFlags, pulPrivStatus, pulStatus,
+                                                 lpfnWriteToStream, lpvWriteStream, pTTEmbedInfo );
+                free( one );
+            }
+        }
+    }
+    else ret = embed_font_data( data, size, ulFlags, pulPrivStatus, pulStatus, lpfnWriteToStream, lpvWriteStream,
+                                pTTEmbedInfo );
+    free( data );
+    return ret;
+}
+
+/* an EOT structure from the stream: the font data (decrypted), its permissions and flags */
+struct eot
+{
+    BYTE *header;
+    ULONG size;
+    BYTE *font;
+    ULONG font_size;
+    ULONG flags;
+    WORD fstype;
+};
+
+static LONG read_eot( READEMBEDPROC read, void *stream, struct eot *eot )
+{
+    ULONG fixed[4], i;
+
+    memset( eot, 0, sizeof(*eot) );
+    if (!read || !stream) return E_STREAMINVALID;
+    if (read( stream, fixed, sizeof(fixed) ) != sizeof(fixed)) return E_READFROMSTREAMFAILED;
+    eot->size = fixed[0];
+    eot->font_size = fixed[1];
+    eot->flags = fixed[3];
+    if (eot->size < 82 || eot->font_size > eot->size - 82 ||
+        (fixed[2] != EOT_VERSION_1 && fixed[2] != EOT_VERSION_2_1 && fixed[2] != EOT_VERSION_2_2))
+        return E_FONTDATAINVALID;
+    if (!(eot->header = malloc( eot->size ))) return E_NOFREEMEMORY;
+    memcpy( eot->header, fixed, sizeof(fixed) );
+    if (read( stream, eot->header + sizeof(fixed), eot->size - sizeof(fixed) ) != eot->size - sizeof(fixed))
+    {
+        free( eot->header );
+        return E_READFROMSTREAMFAILED;
+    }
+    if (*(USHORT *)(eot->header + 34) != EOT_MAGIC)
+    {
+        free( eot->header );
+        return E_FONTDATAINVALID;
+    }
+    eot->fstype = *(USHORT *)(eot->header + 32);
+    eot->font = eot->header + eot->size - eot->font_size;
+    if (eot->flags & TTEMBED_TTCOMPRESSED)
+    {
+        FIXME( "MicroType Express compressed font data\n" );
+        free( eot->header );
+        return E_ERRORDECOMPRESSINGFONTDATA;
+    }
+    if (eot->flags & TTEMBED_XORENCRYPTDATA)
+        for (i = 0; i < eot->font_size; i++) eot->font[i] ^= 0x50;
+    return E_NONE;
+}
+
+/* the more restrictive of the font's embedding level and the caller's */
+static ULONG restrict_level( ULONG font, ULONG caller )
+{
+    static const int rank[5] = { 0, 2, 1, 0, 3 }; /* PREVIEWPRINT 2, EDITABLE 1, INSTALLABLE 0, NOEMBEDDING 3 */
+    if (caller < EMBED_PREVIEWPRINT || caller > EMBED_NOEMBEDDING) return font;
+    return rank[caller] > rank[font] ? caller : font;
+}
+
+/* the font with its family name changed (the Windows names of the name table) */
+static BYTE *rename_font( const BYTE *font, DWORD size, const WCHAR *family, DWORD *new_size )
+{
+    static const WORD ids[] = { 1, 4, 6, 16 };
+    DWORD count = get_be16( font + 4 ), i, j, name_off = 0, name_len, len = lstrlenW( family ) * 2, pos;
+    BYTE *ret, *table;
+
+    for (i = 0; i < count; i++)
+        if (get_be32( font + 12 + i * 16 ) == TAG('n','a','m','e')) name_off = 12 + i * 16;
+    if (!name_off) return NULL;
+    name_len = 6 + ARRAY_SIZE(ids) * 12 + ARRAY_SIZE(ids) * len;
+    *new_size = ((size + 3) & ~3) + name_len;
+    if (!(ret = calloc( 1, *new_size ))) return NULL;
+    memcpy( ret, font, size );
+    table = ret + ((size + 3) & ~3);
+    put_be16( table, 0 );
+    put_be16( table + 2, ARRAY_SIZE(ids) );
+    put_be16( table + 4, 6 + ARRAY_SIZE(ids) * 12 );
+    pos = 0;
+    for (i = 0; i < ARRAY_SIZE(ids); i++)
+    {
+        BYTE *rec = table + 6 + i * 12, *str = table + 6 + ARRAY_SIZE(ids) * 12 + pos;
+        put_be16( rec, 3 );
+        put_be16( rec + 2, 1 );
+        put_be16( rec + 4, 0x409 );
+        put_be16( rec + 6, ids[i] );
+        put_be16( rec + 8, len );
+        put_be16( rec + 10, pos );
+        for (j = 0; j < len / 2; j++) put_be16( str + j * 2, family[j] );
+        pos += len;
+    }
+    put_be32( ret + name_off + 8, table - ret );
+    put_be32( ret + name_off + 12, name_len );
+    return ret;
+}
+
 LONG WINAPI TTLoadEmbeddedFont(HANDLE *phFontReference, ULONG ulFlags,
                                ULONG *pulPrivStatus, ULONG ulPrivs,
                                ULONG *pulStatus, READEMBEDPROC lpfnReadFromStream,
                                LPVOID lpvReadStream, LPWSTR szWinFamilyName,
                                LPSTR szMacFamilyName, TTLOADINFO *pTTLoadInfo)
 {
-    FIXME("%p, %#lx, %p, %lu, %p, %p, %p, %s, %s, %p stub\n", phFontReference,
+    struct eot eot;
+    BYTE *renamed = NULL;
+    DWORD fonts = 0, size;
+    HANDLE handle;
+    LONG ret;
+
+    TRACE("%p, %#lx, %p, %lu, %p, %p, %p, %s, %s, %p\n", phFontReference,
           ulFlags, pulPrivStatus, ulPrivs, pulStatus, lpfnReadFromStream,
           lpvReadStream, debugstr_w(szWinFamilyName), szMacFamilyName,
           pTTLoadInfo);
 
-    return E_API_NOTIMPL;
+    if (!phFontReference) return E_FONTREFERENCEINVALID;
+    if (!pulPrivStatus) return E_PRIVSTATUSINVALID;
+    if (!pulStatus) return E_STATUSINVALID;
+    *phFontReference = NULL;
+    if ((ret = read_eot( lpfnReadFromStream, lpvReadStream, &eot ))) return ret;
+
+    *pulPrivStatus = restrict_level( embed_level( eot.fstype ), ulPrivs );
+    *pulStatus = (eot.flags & TTEMBED_SUBSET) ? TTLOAD_FONT_SUBSETTED : 0;
+    if (embed_level( eot.fstype ) == EMBED_NOEMBEDDING)
+    {
+        free( eot.header );
+        return E_FONTNOTEMBEDDABLE;
+    }
+    size = eot.font_size;
+    if (szWinFamilyName && *szWinFamilyName)
+    {
+        if (!(renamed = rename_font( eot.font, eot.font_size, szWinFamilyName, &size )))
+        {
+            free( eot.header );
+            return E_NAMECHANGEFAILED;
+        }
+    }
+#ifdef SG_MUTANT_EOT_NO_INSTALL
+    handle = (HANDLE)1; fonts = 1;
+#else
+    handle = AddFontMemResourceEx( renamed ? renamed : eot.font, size, NULL, &fonts );
+#endif
+    free( renamed );
+    free( eot.header );
+    if (!handle || !fonts) return E_ADDFONTFAILED;
+    *phFontReference = handle;
+    return E_NONE;
 }
 
-LONG WINAPI TTEmbedFont(HDC hDC, ULONG ulFlags, ULONG ulCharSet, ULONG *pulPrivStatus,
-                         ULONG *pulStatus, WRITEEMBEDPROC lpfnWriteToStream, LPVOID lpvWriteStream,
-                         USHORT *pusCharCodeSet, USHORT usCharCodeCount, USHORT usLanguage,
-                         TTEMBEDINFO *pTTEmbedInfo)
+LONG WINAPI TTGetEmbeddedFontInfo(ULONG ulFlags, ULONG *pulPrivStatus, ULONG ulPrivs, ULONG *pulStatus,
+                                  READEMBEDPROC lpfnReadFromStream, LPVOID lpvReadStream, TTLOADINFO *pTTLoadInfo)
 {
-    FIXME("%p, %#lx, %lu, %p, %p, %p, %p, %p, %u, %u, %p stub\n", hDC,
-          ulFlags, ulCharSet, pulPrivStatus, pulStatus, lpfnWriteToStream,
-          lpvWriteStream, pusCharCodeSet, usCharCodeCount, usLanguage,
-          pTTEmbedInfo);
+    struct eot eot;
+    LONG ret;
+
+    TRACE("%#lx, %p, %lu, %p, %p, %p, %p\n", ulFlags, pulPrivStatus, ulPrivs, pulStatus,
+          lpfnReadFromStream, lpvReadStream, pTTLoadInfo);
+
+    if (!pulPrivStatus) return E_PRIVSTATUSINVALID;
+    if (!pulStatus) return E_STATUSINVALID;
+    if ((ret = read_eot( lpfnReadFromStream, lpvReadStream, &eot ))) return ret;
+    *pulPrivStatus = restrict_level( embed_level( eot.fstype ), ulPrivs );
+    *pulStatus = (eot.flags & TTEMBED_SUBSET) ? TTLOAD_FONT_SUBSETTED : 0;
+    free( eot.header );
+    return E_NONE;
+}
+
+LONG WINAPI TTEnableEmbeddingForFacename(LPCSTR facename, BOOL enable)
+{
+    HKEY hkey;
+    DWORD value = !!enable;
+    LONG ret;
+
+    TRACE("(%s %d)\n", debugstr_a(facename), enable);
 
-    return E_API_NOTIMPL;
+    if (!facename) return E_FACENAMEINVALID;
+    /* the list TTIsEmbeddingEnabledForFacename reads: a face with 0 is excluded */
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Shared Tools\\t2embed", 0, NULL, 0,
+                         KEY_SET_VALUE, NULL, &hkey, NULL ))
+        return E_WINDOWSAPI;
+    ret = RegSetValueExA( hkey, facename, 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+    RegCloseKey( hkey );
