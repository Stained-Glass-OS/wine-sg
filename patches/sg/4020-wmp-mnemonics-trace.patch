From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmp: GetControlInfo and OnMnemonic trace.

The player has no mnemonics, so E_NOTIMPL is what these return; they no
longer report FIXMEs.
---
 dlls/wmp/oleobj.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/dlls/wmp/oleobj.c b/dlls/wmp/oleobj.c
index cbabc3b..079dfdb 100644
--- a/dlls/wmp/oleobj.c
+++ b/dlls/wmp/oleobj.c
@@ -779,17 +779,18 @@ static ULONG WINAPI OleControl_Release(IOleControl *iface)
     return IOleObject_Release(&This->IOleObject_iface);
 }
 
+/* The player control defines no mnemonics, which these report with E_NOTIMPL. */
 static HRESULT WINAPI OleControl_GetControlInfo(IOleControl *iface, CONTROLINFO *pCI)
 {
     WindowsMediaPlayer *This = impl_from_IOleControl(iface);
-    FIXME("(%p)->(%p)\n", This, pCI);
+    TRACE("(%p)->(%p)\n", This, pCI);
     return E_NOTIMPL;
 }
 
 static HRESULT WINAPI OleControl_OnMnemonic(IOleControl *iface, MSG *msg)
 {
     WindowsMediaPlayer *This = impl_from_IOleControl(iface);
-    FIXME("(%p)->(%p)\n", This, msg);
+    TRACE("(%p)->(%p)\n", This, msg);
     return E_NOTIMPL;
 }
 
