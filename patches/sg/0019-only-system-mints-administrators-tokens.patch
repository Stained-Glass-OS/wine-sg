+/* Stained Glass OS (multi-user debt D17): in a prefix shared between Unix
+ * users, the server's token requests are a privilege boundary. Upstream Wine
+ * mints tokens for anyone who asks -- every process there is its user's
+ * administrator anyway -- but here a standard user who can obtain a token
+ * naming SYSTEM or Administrators has everything SYSTEM has on the Windows
+ * side. Only SYSTEM's own processes (the prefix owner, or root) may mint or
+ * assign arbitrary tokens; that stands in for SeCreateTokenPrivilege and
+ * SeAssignPrimaryTokenPrivilege, which only SYSTEM holds on Windows. Elevated
+ * programs will reach administrative rights through the elevation broker
+ * (ADR 0012), which starts them as the SYSTEM account. */
+int sg_requester_is_admin(void)
+{
+    uid_t uid;
+
+    if (!sg_system_prefix || !current) return 1;
+    uid = current->process->peer_uid;
+    return uid == 0 || uid == sg_system_prefix_uid;
+}
+
+int sg_token_same_user( struct token *a, struct token *b )
+{
+    return equal_sid( a->user, b->user );
+}
+
 static int acl_is_valid( const struct acl *acl, data_size_t size )
 {
