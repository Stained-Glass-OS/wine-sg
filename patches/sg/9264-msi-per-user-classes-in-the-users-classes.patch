+
+UINT ACTION_RegisterClassInfo( MSIPACKAGE *package )
+{
+    HKEY root = enter_classes_root( package );
+    UINT r = registerclassinfo_in( package );
+    leave_classes_root( root );
+    return r;
+}
+
