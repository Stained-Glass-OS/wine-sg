+       SK_QUICKLINK, SK_SNAP_LEFT, SK_SNAP_RIGHT, SK_MAXIMIZE, SK_DOWN, SK_DICTATE, SK_SNIP, SK_SNIP_PRTSC, SK_TASKMGR, SK_LAST };
 
