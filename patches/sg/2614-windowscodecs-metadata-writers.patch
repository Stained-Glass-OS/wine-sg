+static HRESULT create_writer_from_reader(IWICMetadataReader *reader, const GUID *vendor,
+        IWICMetadataWriter **writer)
+{
+    IWICStreamProvider *provider = NULL;
+    IWICPersistStream *persist = NULL;
+    IWICMetadataWriter *result = NULL;
+    DWORD options = 0;
+    IStream *stream = NULL, *clone = NULL;
+    GUID format, reader_vendor;
+    UINT count, i;
+    HRESULT hr;
+
+    if (FAILED(hr = IWICMetadataReader_GetMetadataFormat(reader, &format)))
+        return hr;
+
+    reader_vendor = GUID_VendorMicrosoft;
+    if (SUCCEEDED(IWICMetadataReader_QueryInterface(reader, &IID_IWICStreamProvider, (void **)&provider)))
+    {
+        IWICStreamProvider_GetPersistOptions(provider, &options);
+        IWICStreamProvider_GetPreferredVendorGUID(provider, &reader_vendor);
+        if (SUCCEEDED(IWICStreamProvider_GetStream(provider, &stream)))
+            clone_stream(stream, &clone);
+        if (stream) IStream_Release(stream);
+        IWICStreamProvider_Release(provider);
+    }
+
+    if (FAILED(hr = create_metadata_writer(&format, vendor ? vendor : &reader_vendor, 0, &result)))
+        goto done;
+
+    if (FAILED(hr = IWICMetadataWriter_QueryInterface(result, &IID_IWICPersistStream, (void **)&persist)))
+        goto done;
+
+    hr = IWICPersistStream_LoadEx(persist, NULL, vendor ? vendor : &reader_vendor, options);
+
+    if (SUCCEEDED(hr))
+        hr = IWICMetadataReader_GetCount(reader, &count);
+
+    for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+    {
+        PROPVARIANT schema, id, value;
+
+        PropVariantInit(&schema);
+        PropVariantInit(&id);
+        PropVariantInit(&value);
+        hr = IWICMetadataReader_GetValueByIndex(reader, i, &schema, &id, &value);
+        if (SUCCEEDED(hr))
+            hr = IWICMetadataWriter_SetValue(result, &schema, &id, &value);
+        PropVariantClear(&schema);
+        PropVariantClear(&id);
+        PropVariantClear(&value);
+    }
+
+    /* it keeps a stream of its own, a copy of the one the reader keeps */
+    if (SUCCEEDED(hr) && clone)
+        hr = MetadataHandler_SetCachedStream(result, clone);
+
+    /* what is nested in the items is converted too */
+    if (SUCCEEDED(hr))
+        hr = IWICMetadataWriter_GetCount(result, &count);
+
+    for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+    {
+        PROPVARIANT schema, id, value;
+        IWICMetadataReader *nested;
+        IWICMetadataWriter *nested_writer;
+
+        PropVariantInit(&schema);
+        PropVariantInit(&id);
+        PropVariantInit(&value);
+        hr = IWICMetadataWriter_GetValueByIndex(result, i, &schema, &id, &value);
+
+        if (SUCCEEDED(hr) && value.vt == VT_UNKNOWN && value.punkVal
+                && SUCCEEDED(IUnknown_QueryInterface(value.punkVal, &IID_IWICMetadataReader, (void **)&nested)))
+        {
+            if (SUCCEEDED(IUnknown_QueryInterface(value.punkVal, &IID_IWICMetadataWriter, (void **)&nested_writer)))
+                IWICMetadataWriter_Release(nested_writer);
+#ifdef SG_MUTANT_MDW_NESTED_PLAIN
+            else if (0)
+#else
+            else if (SUCCEEDED(hr = create_writer_from_reader(nested, vendor, &nested_writer)))
+#endif
+            {
+                PROPVARIANT converted;
+
+                converted.vt = VT_UNKNOWN;
+                converted.punkVal = (IUnknown *)nested_writer;
+                hr = IWICMetadataWriter_SetValueByIndex(result, i, &schema, &id, &converted);
+                IWICMetadataWriter_Release(nested_writer);
+            }
+            IWICMetadataReader_Release(nested);
+        }
+
+        PropVariantClear(&schema);
+        PropVariantClear(&id);
+        PropVariantClear(&value);
+    }
+
+done:
+    if (persist) IWICPersistStream_Release(persist);
+    if (clone) IStream_Release(clone);
+
+    if (FAILED(hr))
+    {
+        if (result) IWICMetadataWriter_Release(result);
+        return hr;
+    }
+
+    *writer = result;
+    return S_OK;
 }
 
