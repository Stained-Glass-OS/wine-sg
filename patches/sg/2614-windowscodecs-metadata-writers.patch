+    /* only the creation flags apply: a writer is made empty, nothing is persisted */
+#ifndef SG_MUTANT_MDW_FACTORY_OPTIONS
+    if (options & WICPersistOptionMask)
+        return E_INVALIDARG;
+#endif
+
