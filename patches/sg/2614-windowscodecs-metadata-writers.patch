+static void ifd_load_nested_reader(IStream *input, DWORD persist_options, MetadataItem *item)
+{
+    IWICPersistStream *persist;
+    IWICMetadataReader *reader;
+    LARGE_INTEGER pos;
+    HRESULT hr;
+
+    if (item->id.vt != VT_UI2 || item->value.vt != VT_UI4)
+        return;
+
+    switch (item->id.uiVal)
+    {
+        case 0x8769:
+            hr = ExifMetadataReader_CreateInstance(&IID_IWICMetadataReader, (void **)&reader);
+            break;
+        case 0x8825:
+            hr = GpsMetadataReader_CreateInstance(&IID_IWICMetadataReader, (void **)&reader);
+            break;
+        default:
+            return;
+    }
+    if (FAILED(hr)) return;
+
+    if (SUCCEEDED(hr = IWICMetadataReader_QueryInterface(reader, &IID_IWICPersistStream, (void **)&persist)))
+    {
+        pos.QuadPart = item->value.ulVal;
+        hr = IStream_Seek(input, pos, STREAM_SEEK_SET, NULL);
+        if (SUCCEEDED(hr))
+            hr = IWICPersistStream_LoadEx(persist, input, NULL,
+                    (persist_options & WICPersistOptionBigEndian) | IFD_NESTED_OPTION);
+        IWICPersistStream_Release(persist);
+    }
+
+    if (SUCCEEDED(hr))
+    {
+        item->value.vt = VT_UNKNOWN;
+        item->value.punkVal = (IUnknown *)reader;
+    }
+    else
+        IWICMetadataReader_Release(reader);
+}
