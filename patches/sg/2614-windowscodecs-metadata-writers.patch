+static HRESULT WINAPI MetadataWriterInfo_QueryInterface(IWICMetadataWriterInfo *iface,
+    REFIID riid, void **ppv)
+{
+    MetadataReaderInfo *This = impl_from_IWICMetadataReaderInfo((IWICMetadataReaderInfo *)iface);
+
+    TRACE("(%p,%s,%p)\n", iface, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_INVALIDARG;
+
+    if (IsEqualIID(&IID_IUnknown, riid) ||
+        IsEqualIID(&IID_IWICComponentInfo, riid) ||
+        IsEqualIID(&IID_IWICMetadataHandlerInfo, riid) ||
+        IsEqualIID(&IID_IWICMetadataWriterInfo, riid))
+    {
+        *ppv = &This->base.IWICComponentInfo_iface;
