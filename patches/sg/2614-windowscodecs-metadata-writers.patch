+/* A copy of the whole stream in memory. */
+static HRESULT clone_stream(IStream *stream, IStream **clone)
+{
+    LARGE_INTEGER zero = {{0}};
+    STATSTG stat;
+    HGLOBAL global;
+    ULONG read;
+    void *data;
+    HRESULT hr;
+
+    *clone = NULL;
+    if (FAILED(hr = IStream_Stat(stream, &stat, STATFLAG_NONAME)))
+        return hr;
+    if (stat.cbSize.HighPart || stat.cbSize.LowPart > 0x10000000)
+        return E_OUTOFMEMORY;
+
+    if (!(global = GlobalAlloc(GMEM_MOVEABLE, stat.cbSize.LowPart)))
+        return E_OUTOFMEMORY;
+
+    data = GlobalLock(global);
+    hr = IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+    if (SUCCEEDED(hr))
+        hr = IStream_Read(stream, data, stat.cbSize.LowPart, &read);
+    GlobalUnlock(global);
+
+    if (SUCCEEDED(hr) && read != stat.cbSize.LowPart)
+        hr = WINCODEC_ERR_BADMETADATAHEADER;
+
+    if (SUCCEEDED(hr))
+        hr = CreateStreamOnHGlobal(global, TRUE, clone);
+
+    if (FAILED(hr))
+        GlobalFree(global);
+    else
+        IStream_Seek(*clone, zero, STREAM_SEEK_SET, NULL);
+
+    return hr;
+}
