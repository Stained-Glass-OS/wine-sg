+static BOOL metadata_item_matches(const MetadataItem *item, const PROPVARIANT *schema, const PROPVARIANT *id)
+{
+    if (schema && item->schema.vt != VT_EMPTY && schema->vt != VT_EMPTY)
+    {
+        if (PropVariantCompareEx(schema, &item->schema, 0, PVCF_USESTRCMPI) != 0) return FALSE;
+    }
+
+    return PropVariantCompareEx(id, &item->id, 0, PVCF_USESTRCMPI) == 0;
+}
+
 static HRESULT WINAPI MetadataHandler_SetValue(IWICMetadataWriter *iface,
-    const PROPVARIANT *pvarSchema, const PROPVARIANT *pvarId, const PROPVARIANT *pvarValue)
+    const PROPVARIANT *schema, const PROPVARIANT *id, const PROPVARIANT *value)
 {
-    FIXME("(%p,%p,%p,%p): stub\n", iface, pvarSchema, pvarId, pvarValue);
-    return E_NOTIMPL;
+    MetadataHandler *This = impl_from_IWICMetadataWriter(iface);
+    MetadataItem item, *items;
+    HRESULT hr;
+    DWORD i;
+
+    TRACE("(%p,%p,%p,%p)\n", iface, schema, id, value);
+
+    if (!id || !value) return E_INVALIDARG;
+
+    EnterCriticalSection(&This->lock);
+
+    for (i = 0; i < This->item_count; i++)
+        if (metadata_item_matches(&This->items[i], schema, id)) break;
+
+#ifdef SG_MUTANT_MDW_SETVALUE_APPENDS
+    i = This->item_count;
+#endif
+    if (i < This->item_count)
+    {
+        PROPVARIANT copy;
+
+        PropVariantInit(&copy);
+        if (SUCCEEDED(hr = PropVariantCopy(&copy, value)))
+        {
+            PropVariantClear(&This->items[i].value);
+            This->items[i].value = copy;
+            This->dirty = TRUE;
+        }
+        LeaveCriticalSection(&This->lock);
+        return hr;
+    }
+
+    PropVariantInit(&item.schema);
+    PropVariantInit(&item.id);
+    PropVariantInit(&item.value);
+    hr = schema ? PropVariantCopy(&item.schema, schema) : S_OK;
+    if (SUCCEEDED(hr)) hr = PropVariantCopy(&item.id, id);
+    if (SUCCEEDED(hr)) hr = PropVariantCopy(&item.value, value);
+
+    if (SUCCEEDED(hr) && !(items = realloc(This->items, (This->item_count + 1) * sizeof(*items))))
+        hr = E_OUTOFMEMORY;
+
+    if (SUCCEEDED(hr))
+    {
+        This->items = items;
+        This->items[This->item_count++] = item;
+        This->dirty = TRUE;
+    }
+    else
+    {
+        PropVariantClear(&item.schema);
+        PropVariantClear(&item.id);
+        PropVariantClear(&item.value);
+    }
+
+    LeaveCriticalSection(&This->lock);
+    return hr;
 }
 
