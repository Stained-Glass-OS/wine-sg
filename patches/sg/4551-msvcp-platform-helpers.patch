 dlls/msvcp120/msvcp120.spec         |  2 +-
 dlls/msvcp120_app/msvcp120_app.spec |  2 +-
 dlls/msvcp140/msvcp140.spec         |  8 ++++----
 dlls/msvcp90/details.c              | 40 +++++++++++++++++++++++++++++++++++++
 dlls/msvcp_win/msvcp_win.spec       |  8 ++++----
 6 files changed, 51 insertions(+), 11 deletions(-)

