index 1c7f17c..80be359 100644
--- a/dlls/msvcp90/details.c
+++ b/dlls/msvcp90/details.c
@@ -1309,3 +1309,43 @@ const BYTE byte_reverse_table[256] =
     0x0f, 0x8f, 0x4f, 0xcf, 0x2f, 0xaf, 0x6f, 0xef, 0x1f, 0x9f, 0x5f, 0xdf, 0x3f, 0xbf, 0x7f, 0xff,
 };
 #endif
+
+#if _MSVCP_VER >= 110
+/* ?_GetNextAsyncId@details@Concurrency@@YAIXZ */
+/* ?GetNextAsyncId@platform@details@Concurrency@@YAIXZ */
+unsigned int __cdecl GetNextAsyncId(void)
+{
+    static LONG next_id;
+
+    TRACE("()\n");
+#ifdef SG_MUTANT_ASYNC_ID_CONSTANT
+    return 1;
+#endif
+    return InterlockedIncrement(&next_id);
+}
+#endif
+
+#if _MSVCP_VER >= 140
+/* ?CaptureCallstack@platform@details@Concurrency@@YAIPAPAXII@Z */
+/* ?CaptureCallstack@platform@details@Concurrency@@YA_KPEAPEAX_K1@Z */
+size_t __cdecl DECLSPEC_NOINLINE CaptureCallstack(void **frames, size_t skip, size_t count)
+{
+    TRACE("(%p %Iu %Iu)\n", frames, skip, count);
+
+    if (count > 0xffff - 1) count = 0xffff - 1;
+    if (skip > 0xffff - 2) return 0;
+#ifdef SG_MUTANT_CALLSTACK_OWN_FRAME
+    return RtlCaptureStackBackTrace(skip, count, frames, NULL);
+#endif
+    /* skip counts the frames above this function */
+    return RtlCaptureStackBackTrace(skip + 1, count, frames, NULL);
+}
+
+/* __set_stl_sync_api_mode: picks the system primitives (Vista, Windows 7,
+ * ConcRT) the mutexes and condition variables use. Wine's library has one
+ * implementation, on SRW locks and condition variables, for every mode. */
+void __cdecl __set_stl_sync_api_mode(int mode)
+{
+    TRACE("(%d)\n", mode);
+}
+#endif
