+/***********************************************************************
+ *              SetupLogFileW  (SETUPAPI.@)
+ */
+BOOL WINAPI SetupLogFileW(
+    HSPFILELOG FileLogHandle,
+    PCWSTR LogSectionName,
+    PCWSTR SourceFileName,
+    PCWSTR TargetFileName,
+    DWORD Checksum,
+    PCWSTR DiskTagfile,
+    PCWSTR DiskDescription,
+    PCWSTR OtherInfo,
+    DWORD Flags )
+{
+    struct file_log *log = get_file_log(FileLogHandle);
+    WCHAR *value, *p;
+    SIZE_T len;
+    BOOL ret;
+
+    TRACE("(%p, %s, %s, %s, %ld, %s, %s, %s, %ld)\n", FileLogHandle,
+        debugstr_w(LogSectionName), debugstr_w(SourceFileName),
+        debugstr_w(TargetFileName), Checksum, debugstr_w(DiskTagfile),
+        debugstr_w(DiskDescription), debugstr_w(OtherInfo), Flags);
+
+    if (!log) { SetLastError(ERROR_INVALID_HANDLE); return FALSE; }
+    if (!TargetFileName || (Flags & ~SPFILELOG_OEMFILE))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (log->query_only) { SetLastError(ERROR_ACCESS_DENIED); return FALSE; }
+
+    len = 3 * (SourceFileName ? lstrlenW(SourceFileName) : 0) + 3 * (DiskTagfile ? lstrlenW(DiskTagfile) : 0) +
+          3 * (DiskDescription ? lstrlenW(DiskDescription) : 0) + 3 * (OtherInfo ? lstrlenW(OtherInfo) : 0) + 64;
+    if (!(value = malloc(len * sizeof(WCHAR)))) { SetLastError(ERROR_NOT_ENOUGH_MEMORY); return FALSE; }
+
+    p = value;
+    filelog_escape(SourceFileName, p); p += lstrlenW(p); *p++ = ',';
+    p += swprintf(p, 16, L"%lu", Checksum); *p++ = ',';
+    filelog_escape(DiskTagfile, p); p += lstrlenW(p); *p++ = ',';
+    filelog_escape(DiskDescription, p); p += lstrlenW(p); *p++ = ',';
+    filelog_escape(OtherInfo, p); p += lstrlenW(p); *p++ = ',';
+    swprintf(p, 16, L"%lu", Flags);
+
+    ret = WritePrivateProfileStringW(LogSectionName ? LogSectionName : L"Files.WinNt", TargetFileName, value, log->path);
+    free(value);
+    return ret;
+}
+
+/***********************************************************************
+ *              SetupLogFileA  (SETUPAPI.@)
+ */
+BOOL WINAPI SetupLogFileA(
+    HSPFILELOG FileLogHandle,
+    PCSTR LogSectionName,
+    PCSTR SourceFileName,
+    PCSTR TargetFileName,
+    DWORD Checksum,
+    PCSTR DiskTagfile,
+    PCSTR DiskDescription,
+    PCSTR OtherInfo,
+    DWORD Flags )
+{
+    WCHAR *w[6] = { 0 };
+    const char *a[6] = { LogSectionName, SourceFileName, TargetFileName, DiskTagfile, DiskDescription, OtherInfo };
+    BOOL ret;
+    int i;
+
+    for (i = 0; i < 6; i++)
+    {
+        int len;
+        if (!a[i]) continue;
+        len = MultiByteToWideChar(CP_ACP, 0, a[i], -1, NULL, 0);
+        if (!(w[i] = malloc(len * sizeof(WCHAR)))) { ret = FALSE; SetLastError(ERROR_NOT_ENOUGH_MEMORY); goto done; }
+        MultiByteToWideChar(CP_ACP, 0, a[i], -1, w[i], len);
+    }
+    ret = SetupLogFileW(FileLogHandle, w[0], w[1], w[2], Checksum, w[3], w[4], w[5], Flags);
+done:
+    for (i = 0; i < 6; i++) free(w[i]);
+    return ret;
+}
+
+/***********************************************************************
+ *              SetupQueryFileLogW  (SETUPAPI.@)
+ */
+BOOL WINAPI SetupQueryFileLogW(HSPFILELOG FileLogHandle, PCWSTR LogSectionName, PCWSTR TargetFilename,
+                               SetupFileLogInfo DesiredInfo, PWSTR DataOut, DWORD ReturnBufferSize,
+                               PDWORD RequiredSize)
+{
+    struct file_log *log = get_file_log(FileLogHandle);
+    WCHAR value[1024], *field, *end;
+    DWORD i, needed;
+
+    TRACE("(%p, %s, %s, %d, %p, %lu, %p)\n", FileLogHandle, debugstr_w(LogSectionName),
+          debugstr_w(TargetFilename), DesiredInfo, DataOut, ReturnBufferSize, RequiredSize);
+
+    if (!log) { SetLastError(ERROR_INVALID_HANDLE); return FALSE; }
+    if (!TargetFilename || (unsigned int)DesiredInfo >= SetupFileLogMax)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    GetPrivateProfileStringW(LogSectionName ? LogSectionName : L"Files.WinNt", TargetFilename, L"\x01", value,
+                             ARRAY_SIZE(value), log->path);
+    if (value[0] == 1)
+    {
+        SetLastError(ERROR_NOT_FOUND);
+        return FALSE;
+    }
+
+    field = value;
+    for (i = 0; i < (DWORD)DesiredInfo; i++)
+    {
+        if (!(field = wcschr(field, ','))) break;
+        field++;
+    }
+    if (!field) field = value + lstrlenW(value);
+    if ((end = wcschr(field, ','))) *end = 0;
+    filelog_unescape(field);
+
+    needed = lstrlenW(field) + 1;
+    if (RequiredSize) *RequiredSize = needed;
+    if (DataOut)
+    {
+        if (ReturnBufferSize < needed) { SetLastError(ERROR_INSUFFICIENT_BUFFER); return FALSE; }
+        lstrcpyW(DataOut, field);
+    }
+    else if (ReturnBufferSize)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *              SetupQueryFileLogA  (SETUPAPI.@)
+ */
+BOOL WINAPI SetupQueryFileLogA(HSPFILELOG FileLogHandle, PCSTR LogSectionName, PCSTR TargetFilename,
+                               SetupFileLogInfo DesiredInfo, PSTR DataOut, DWORD ReturnBufferSize,
+                               PDWORD RequiredSize)
+{
+    WCHAR *section = NULL, *target = NULL, out[1024];
+    DWORD needed = 0;
+    BOOL ret;
+
+    if (LogSectionName)
+    {
+        int len = MultiByteToWideChar(CP_ACP, 0, LogSectionName, -1, NULL, 0);
+        if (!(section = malloc(len * sizeof(WCHAR)))) return FALSE;
+        MultiByteToWideChar(CP_ACP, 0, LogSectionName, -1, section, len);
+    }
+    if (TargetFilename)
+    {
+        int len = MultiByteToWideChar(CP_ACP, 0, TargetFilename, -1, NULL, 0);
+        if (!(target = malloc(len * sizeof(WCHAR)))) { free(section); return FALSE; }
+        MultiByteToWideChar(CP_ACP, 0, TargetFilename, -1, target, len);
+    }
+    ret = SetupQueryFileLogW(FileLogHandle, section, target, DesiredInfo, out, ARRAY_SIZE(out), &needed);
+    free(section);
+    free(target);
+    if (!ret) return FALSE;
+
+    needed = WideCharToMultiByte(CP_ACP, 0, out, -1, NULL, 0, NULL, NULL);
+    if (RequiredSize) *RequiredSize = needed;
+    if (DataOut)
+    {
+        if (ReturnBufferSize < needed) { SetLastError(ERROR_INSUFFICIENT_BUFFER); return FALSE; }
+        WideCharToMultiByte(CP_ACP, 0, out, -1, DataOut, ReturnBufferSize, NULL, NULL);
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *              SetupRemoveFileLogEntryW  (SETUPAPI.@)
+ */
+BOOL WINAPI SetupRemoveFileLogEntryW(HSPFILELOG FileLogHandle, PCWSTR LogSectionName, PCWSTR TargetFilename)
+{
+    struct file_log *log = get_file_log(FileLogHandle);
+
+    TRACE("(%p, %s, %s)\n", FileLogHandle, debugstr_w(LogSectionName), debugstr_w(TargetFilename));
+
+    if (!log) { SetLastError(ERROR_INVALID_HANDLE); return FALSE; }
+    if (log->query_only) { SetLastError(ERROR_ACCESS_DENIED); return FALSE; }
+    /* without a target the whole section goes */
+    return WritePrivateProfileStringW(LogSectionName ? LogSectionName : L"Files.WinNt", TargetFilename, NULL, log->path);
+}
+
+/***********************************************************************
+ *              SetupRemoveFileLogEntryA  (SETUPAPI.@)
+ */
+BOOL WINAPI SetupRemoveFileLogEntryA(HSPFILELOG FileLogHandle, PCSTR LogSectionName, PCSTR TargetFilename)
+{
+    WCHAR *section = NULL, *target = NULL;
+    BOOL ret;
+
+    if (LogSectionName)
+    {
+        int len = MultiByteToWideChar(CP_ACP, 0, LogSectionName, -1, NULL, 0);
+        if (!(section = malloc(len * sizeof(WCHAR)))) return FALSE;
+        MultiByteToWideChar(CP_ACP, 0, LogSectionName, -1, section, len);
+    }
+    if (TargetFilename)
+    {
+        int len = MultiByteToWideChar(CP_ACP, 0, TargetFilename, -1, NULL, 0);
+        if (!(target = malloc(len * sizeof(WCHAR)))) { free(section); return FALSE; }
+        MultiByteToWideChar(CP_ACP, 0, TargetFilename, -1, target, len);
+    }
+    ret = SetupRemoveFileLogEntryW(FileLogHandle, section, target);
+    free(section);
+    free(target);
+    return ret;
+}
+
