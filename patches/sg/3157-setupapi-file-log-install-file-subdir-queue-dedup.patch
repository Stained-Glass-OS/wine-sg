+/* The file log is an INI file: each section lists, per target file, the
+ * source, checksum, tag file, disk description, other info and flags (commas
+ * and percent signs escaped as %2C and %25). */
+#define FILELOG_MAGIC 0x6c6c6c66
+
+struct file_log
+{
+    DWORD magic;
+    BOOL  query_only;
+    WCHAR path[MAX_PATH];
+};
+
+static struct file_log *get_file_log( HSPFILELOG handle )
+{
+    struct file_log *log = handle;
+
+    if (!log || log == INVALID_HANDLE_VALUE) return NULL;
+    __TRY
+    {
+        if (log->magic != FILELOG_MAGIC) log = NULL;
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        log = NULL;
+    }
+    __ENDTRY
+    return log;
+}
+
+static void filelog_escape( const WCHAR *src, WCHAR *dst )
+{
+#ifdef SG_MUTANT_SETUP_NOESCAPE
+    if (src) lstrcpyW( dst, src ); else *dst = 0;
+    return;
+#endif
+    if (src)
+        for (; *src; src++)
+        {
+            if (*src == ',') { lstrcpyW( dst, L"%2C" ); dst += 3; }
+            else if (*src == '%') { lstrcpyW( dst, L"%25" ); dst += 3; }
+            else *dst++ = *src;
+        }
+    *dst = 0;
+}
+
+static void filelog_unescape( WCHAR *str )
+{
+    WCHAR *out = str;
+
+    for (; *str; str++)
+    {
+        if (str[0] == '%' && str[1] == '2' && str[2] == 'C') { *out++ = ','; str += 2; }
+        else if (str[0] == '%' && str[1] == '2' && str[2] == '5') { *out++ = '%'; str += 2; }
+        else *out++ = *str;
+    }
+    *out = 0;
+}
+
 /***********************************************************************
  *		SetupInitializeFileLogW(SETUPAPI.@)
  */
 HSPFILELOG WINAPI SetupInitializeFileLogW(LPCWSTR LogFileName, DWORD Flags)
 {
-    FIXME("Stub %s, 0x%lx\n",debugstr_w(LogFileName),Flags);
-    return INVALID_HANDLE_VALUE;
+    struct file_log *log;
+    DWORD attrs;
+
+    TRACE("%s, %#lx\n", debugstr_w(LogFileName), Flags);
+
+    if ((Flags & ~(SPFILELOG_SYSTEMLOG | SPFILELOG_FORCENEW | SPFILELOG_QUERYONLY)) ||
+        (!(Flags & SPFILELOG_SYSTEMLOG) && !LogFileName) || ((Flags & SPFILELOG_SYSTEMLOG) && LogFileName))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return INVALID_HANDLE_VALUE;
+    }
+
+    if (!(log = calloc(1, sizeof(*log))))
+    {
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return INVALID_HANDLE_VALUE;
+    }
+    log->magic = FILELOG_MAGIC;
+    log->query_only = !!(Flags & SPFILELOG_QUERYONLY);
+
+    if (Flags & SPFILELOG_SYSTEMLOG)
+    {
+        GetWindowsDirectoryW(log->path, MAX_PATH);
+        lstrcatW(log->path, L"\\repair");
+        if (!log->query_only) CreateDirectoryW(log->path, NULL);
+        lstrcatW(log->path, L"\\setup.log");
+    }
+    else
+    {
+        if (!GetFullPathNameW(LogFileName, MAX_PATH, log->path, NULL))
+        {
+            free(log);
+            return INVALID_HANDLE_VALUE;
+        }
+    }
+
+    attrs = GetFileAttributesW(log->path);
+    if (log->query_only)
+    {
+        if (attrs == INVALID_FILE_ATTRIBUTES)
+        {
+            SetLastError(ERROR_FILE_NOT_FOUND);
+            free(log);
+            return INVALID_HANDLE_VALUE;
+        }
+    }
+    else
+    {
+        if (attrs != INVALID_FILE_ATTRIBUTES && (Flags & SPFILELOG_FORCENEW)) DeleteFileW(log->path);
+        if (attrs == INVALID_FILE_ATTRIBUTES || (Flags & SPFILELOG_FORCENEW))
+        {
+            HANDLE file = CreateFileW(log->path, GENERIC_WRITE, FILE_SHARE_READ, NULL, CREATE_ALWAYS,
+                                      FILE_ATTRIBUTE_NORMAL, NULL);
+            if (file == INVALID_HANDLE_VALUE)
+            {
+                free(log);
+                return INVALID_HANDLE_VALUE;
+            }
+            CloseHandle(file);
+            WritePrivateProfileStringW(L"Version", L"Signature", L"$Windows NT$", log->path);
+        }
+    }
+    return log;
 }
 
