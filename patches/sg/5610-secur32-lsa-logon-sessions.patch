+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "winternl.h"
+#include "sspi.h"
+#include "ntsecapi.h"
+#include "ntsecpkg.h"
+#include "wine/test.h"
+
+static const WCHAR ssp_key[] = L"System\\CurrentControlSet\\Control\\Lsa\\lsa_ssp.dll";
+
+/* the package is loaded by secur32 when a process starts, so the tests run in a
+ * child process started once the package is registered */
+static void test_dispatch_table(void)
+{
+    LSA_DISPATCH_TABLE *(WINAPI *get_dispatch)(void);
+    LSA_DISPATCH_TABLE *d;
+    LUID a = { 0x1234, 0x5678 }, b = { 0x4321, 0x8765 }, c = { 0x7777, 0x1 };
+    char buf[64];
+    LSA_STRING key1, key2, cred1, cred2, cred3, credb, pk, got;
+    ULONG context, key_len;
+    NTSTATUS status;
+    HMODULE mod;
+
+    mod = GetModuleHandleA("lsa_ssp.dll");
+    ok(!!mod, "the test package was not loaded\n");
+    if (!mod) return;
+    get_dispatch = (void *)GetProcAddress(mod, "lsa_ssp_get_dispatch");
+    d = get_dispatch();
+    ok(!!d, "the package got no dispatch table\n");
+    if (!d) return;
+
+    RtlInitString(&key1, "key one");
+    RtlInitString(&key2, "key 2");
+    RtlInitString(&cred1, "credential 1");
+    RtlInitString(&cred2, "credential 2");
+    RtlInitString(&cred3, "credential 3");
+    RtlInitString(&credb, "credential b");
+
+    status = d->CreateLogonSession(&a);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    status = d->CreateLogonSession(&a);
+    ok(status == STATUS_LOGON_SESSION_COLLISION, "got %#lx\n", status);
+    status = d->CreateLogonSession(&b);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+
+    /* a session that does not exist */
+    status = d->AddCredential(&c, 7, &key1, &cred1);
+    ok(status == STATUS_NO_SUCH_LOGON_SESSION, "got %#lx\n", status);
+    context = 0;
+    pk = key1;
+    status = d->GetCredentials(&c, 7, &context, FALSE, &pk, &key_len, &got);
+    ok(status == STATUS_NO_SUCH_LOGON_SESSION, "got %#lx\n", status);
+    status = d->DeleteCredential(&c, 7, &key1);
+    ok(status == STATUS_NO_SUCH_LOGON_SESSION, "got %#lx\n", status);
+    status = d->DeleteLogonSession(&c);
+    ok(status == STATUS_NO_SUCH_LOGON_SESSION, "got %#lx\n", status);
+
+    /* nothing stored yet */
+    context = 0;
+    status = d->GetCredentials(&a, 7, &context, TRUE, &pk, &key_len, &got);
+    ok(status == ERROR_GEN_FAILURE, "got %#lx\n", status);
+
+    status = d->AddCredential(&a, 7, &key1, &cred1);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    status = d->AddCredential(&a, 7, &key2, &cred2);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    status = d->AddCredential(&a, 8, &key1, &cred3);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    status = d->AddCredential(&b, 7, &key1, &credb);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+
+    /* all of a package's credentials, one for each call */
+    context = 0;
+    pk.Buffer = buf;
+    pk.Length = 0;
+    pk.MaximumLength = sizeof(buf);
+    memset(&got, 0xcc, sizeof(got));
+    key_len = 0;
+    status = d->GetCredentials(&a, 7, &context, TRUE, &pk, &key_len, &got);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    ok(context == 1, "got context %lu\n", context);
+    ok(key_len == key1.Length, "got key length %lu\n", key_len);
+    ok(pk.Length == key1.Length && !memcmp(pk.Buffer, key1.Buffer, key1.Length), "got key %s\n", debugstr_an(pk.Buffer, pk.Length));
+    ok(got.Length == cred1.Length && !memcmp(got.Buffer, cred1.Buffer, cred1.Length), "got credential %s\n",
+       debugstr_an(got.Buffer, got.Length));
+    ok(got.Buffer != cred1.Buffer, "the credential was not copied\n");
+    d->FreeLsaHeap(got.Buffer);
+
+    /* too little room for the key: nothing is consumed */
+    pk.MaximumLength = 2;
+    key_len = 0;
+    status = d->GetCredentials(&a, 7, &context, TRUE, &pk, &key_len, &got);
+    ok(status == STATUS_MORE_ENTRIES, "got %#lx\n", status);
+    ok(context == 1, "got context %lu\n", context);
+    ok(key_len == key2.Length, "got key length %lu\n", key_len);
+    pk.MaximumLength = sizeof(buf);
+    status = d->GetCredentials(&a, 7, &context, TRUE, &pk, &key_len, &got);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    ok(context == 2, "got context %lu\n", context);
+    ok(pk.Length == key2.Length && !memcmp(pk.Buffer, key2.Buffer, key2.Length), "got key %s\n", debugstr_an(pk.Buffer, pk.Length));
+    ok(got.Length == cred2.Length && !memcmp(got.Buffer, cred2.Buffer, cred2.Length), "got credential %s\n",
+       debugstr_an(got.Buffer, got.Length));
+    d->FreeLsaHeap(got.Buffer);
+
+    /* the credential of the other package is not theirs, and then there are no more */
+    status = d->GetCredentials(&a, 7, &context, TRUE, &pk, &key_len, &got);
+    ok(status == ERROR_GEN_FAILURE, "got %#lx\n", status);
+    context = 0;
+    status = d->GetCredentials(&a, 8, &context, TRUE, &pk, &key_len, &got);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    ok(got.Length == cred3.Length && !memcmp(got.Buffer, cred3.Buffer, cred3.Length), "got credential %s\n",
+       debugstr_an(got.Buffer, got.Length));
+    d->FreeLsaHeap(got.Buffer);
+    status = d->GetCredentials(&a, 9, &context, TRUE, &pk, &key_len, &got);
+    ok(status == ERROR_GEN_FAILURE, "got %#lx\n", status);
+
+    /* by key */
+    context = 0;
+    pk = key2;
+    status = d->GetCredentials(&a, 7, &context, FALSE, &pk, &key_len, &got);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    ok(context == 2, "got context %lu\n", context);
+    ok(got.Length == cred2.Length && !memcmp(got.Buffer, cred2.Buffer, cred2.Length), "got credential %s\n",
+       debugstr_an(got.Buffer, got.Length));
+    d->FreeLsaHeap(got.Buffer);
+    status = d->GetCredentials(&a, 7, &context, FALSE, &pk, &key_len, &got);
+    ok(status == ERROR_GEN_FAILURE, "got %#lx\n", status);
+
+    /* the other session has its own */
+    context = 0;
+    pk = key1;
+    status = d->GetCredentials(&b, 7, &context, FALSE, &pk, &key_len, &got);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    ok(got.Length == credb.Length && !memcmp(got.Buffer, credb.Buffer, credb.Length), "got credential %s\n",
+       debugstr_an(got.Buffer, got.Length));
+    d->FreeLsaHeap(got.Buffer);
+
+    /* deleting */
+    status = d->DeleteCredential(&a, 9, &key2);
+    ok(status == ERROR_GEN_FAILURE, "got %#lx\n", status);
+    status = d->DeleteCredential(&a, 7, &key1);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    status = d->DeleteCredential(&a, 7, &key1);
+    ok(status == ERROR_GEN_FAILURE, "got %#lx\n", status);
+    context = 0;
+    pk.MaximumLength = sizeof(buf);
+    pk.Buffer = buf;
+    status = d->GetCredentials(&a, 7, &context, TRUE, &pk, &key_len, &got);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    ok(pk.Length == key2.Length && !memcmp(pk.Buffer, key2.Buffer, key2.Length), "got key %s\n", debugstr_an(pk.Buffer, pk.Length));
+    d->FreeLsaHeap(got.Buffer);
+
+    /* one of two equal keys goes */
+    status = d->AddCredential(&a, 7, &key2, &cred1);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    status = d->DeleteCredential(&a, 7, &key2);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    context = 0;
+    pk = key2;
+    status = d->GetCredentials(&a, 7, &context, FALSE, &pk, &key_len, &got);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    ok(got.Length == cred1.Length && !memcmp(got.Buffer, cred1.Buffer, cred1.Length), "got credential %s\n",
+       debugstr_an(got.Buffer, got.Length));
+    d->FreeLsaHeap(got.Buffer);
+
+    /* deleting the session drops its credentials */
+    status = d->DeleteLogonSession(&a);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    status = d->DeleteLogonSession(&a);
+    ok(status == STATUS_NO_SUCH_LOGON_SESSION, "got %#lx\n", status);
+    status = d->AddCredential(&a, 7, &key1, &cred1);
+    ok(status == STATUS_NO_SUCH_LOGON_SESSION, "got %#lx\n", status);
+    context = 0;
+    status = d->GetCredentials(&a, 7, &context, FALSE, &pk, &key_len, &got);
+    ok(status == STATUS_NO_SUCH_LOGON_SESSION, "got %#lx\n", status);
+    context = 0;
+    pk = key1;
+    status = d->GetCredentials(&b, 7, &context, FALSE, &pk, &key_len, &got);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    d->FreeLsaHeap(got.Buffer);
+
+    /* a new session with the same id starts empty */
+    status = d->CreateLogonSession(&a);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    context = 0;
+    pk = key2;
+    status = d->GetCredentials(&a, 7, &context, FALSE, &pk, &key_len, &got);
+    ok(status == ERROR_GEN_FAILURE, "got %#lx\n", status);
+
+    status = d->DeleteLogonSession(&a);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    status = d->DeleteLogonSession(&b);
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+}
+
+START_TEST(lsa)
+{
+    PROCESS_INFORMATION info;
+    STARTUPINFOA startup = { sizeof(startup) };
+    char **argv, cmd[MAX_PATH + 32];
+    HKEY key;
+    DWORD exit_code = 0, err;
+    int argc;
+
+    argc = winetest_get_mainargs(&argv);
+    if (argc >= 3 && !strcmp(argv[2], "child"))
+    {
+        test_dispatch_table();
+        ExitProcess(winetest_get_failures());
+    }
+
+    if (!GetProcAddress(GetModuleHandleA("ntdll.dll"), "wine_get_version"))
+    {
+        win_skip("the package is loaded by the system's LSA\n");
+        return;
+    }
+    err = RegCreateKeyExW(HKEY_LOCAL_MACHINE, ssp_key, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL);
+    if (err)
+    {
+        skip("cannot register a security package: %lu\n", err);
+        return;
+    }
+    RegCloseKey(key);
+
+    sprintf(cmd, "\"%s\" lsa child", argv[0]);
+    if (!CreateProcessA(NULL, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &startup, &info))
+    {
+        ok(0, "CreateProcess failed: %lu\n", GetLastError());
+    }
+    else
+    {
+        WaitForSingleObject(info.hProcess, 60000);
+        GetExitCodeProcess(info.hProcess, &exit_code);
+        ok(!exit_code, "the child reported %lu failures\n", exit_code);
+        CloseHandle(info.hProcess);
+        CloseHandle(info.hThread);
+    }
+    RegDeleteKeyW(HKEY_LOCAL_MACHINE, ssp_key);
+}
