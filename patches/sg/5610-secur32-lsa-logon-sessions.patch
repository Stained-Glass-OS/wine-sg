From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] secur32: LSA logon sessions and credentials

secur32: LsaCallAuthenticationPackage-side logon sessions and credentials

The security package dispatch table gets real CreateLogonSession,
DeleteLogonSession, AddCredential, GetCredentials and DeleteCredential,
keeping the logon sessions and their credentials in the package process.
---
--- a/dlls/secur32/lsa.c
+++ b/dlls/secur32/lsa.c
@@ -36,6 +36,7 @@
 #include "rpc.h"
 
 #include "wine/debug.h"
+#include "wine/list.h"
 #include "secur32_priv.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(secur32);
@@ -224,38 +225,216 @@ NTSTATUS WINAPI LsaLogonUser(HANDLE LsaHandle, PLSA_STRING OriginName,
     return STATUS_SUCCESS;
 }
 
+struct lsa_credential
+{
+    struct list entry;
+    ULONG package_id;
+    LSA_STRING primary_key;
+    LSA_STRING credentials;
+};
+
+struct lsa_session
+{
+    struct list entry;
+    LUID id;
+    struct list credentials;
+};
+
+static struct list lsa_sessions = LIST_INIT(lsa_sessions);
+static SRWLOCK lsa_sessions_lock = SRWLOCK_INIT;
+
+static struct lsa_session *find_lsa_session(const LUID *id)
+{
+    struct lsa_session *session;
+
+    LIST_FOR_EACH_ENTRY(session, &lsa_sessions, struct lsa_session, entry)
+        if (session->id.LowPart == id->LowPart && session->id.HighPart == id->HighPart) return session;
+    return NULL;
+}
+
+static void free_lsa_credential(struct lsa_credential *cred)
+{
+    list_remove(&cred->entry);
+    free(cred->primary_key.Buffer);
+    free(cred->credentials.Buffer);
+    free(cred);
+}
+
+static BOOL copy_lsa_string(LSA_STRING *dst, const LSA_STRING *src)
+{
+    dst->Length = dst->MaximumLength = 0;
+    dst->Buffer = NULL;
+    if (!src || !src->Length) return TRUE;
+    if (!(dst->Buffer = malloc(src->Length))) return FALSE;
+    memcpy(dst->Buffer, src->Buffer, src->Length);
+    dst->Length = dst->MaximumLength = src->Length;
+    return TRUE;
+}
+
+static BOOL lsa_string_equal(const LSA_STRING *a, const LSA_STRING *b)
+{
+    return a->Length == b->Length && (!a->Length || !memcmp(a->Buffer, b->Buffer, a->Length));
+}
+
 static NTSTATUS NTAPI lsa_CreateLogonSession(LUID *logon_id)
 {
-    FIXME("%p: stub\n", logon_id);
-    return STATUS_NOT_IMPLEMENTED;
+    struct lsa_session *session;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE("%p\n", logon_id);
+
+    AcquireSRWLockExclusive(&lsa_sessions_lock);
+#ifdef SG_MUTANT_LSA_NO_COLLISION
+    if (0)
+#else
+    if (find_lsa_session(logon_id))
+#endif
+        status = STATUS_LOGON_SESSION_COLLISION;
+    else if (!(session = calloc(1, sizeof(*session)))) status = STATUS_NO_MEMORY;
+    else
+    {
+        session->id = *logon_id;
+        list_init(&session->credentials);
+        list_add_tail(&lsa_sessions, &session->entry);
+    }
+    ReleaseSRWLockExclusive(&lsa_sessions_lock);
+    return status;
 }
 
 static NTSTATUS NTAPI lsa_DeleteLogonSession(LUID *logon_id)
 {
-    FIXME("%p: stub\n", logon_id);
-    return STATUS_NOT_IMPLEMENTED;
+    struct lsa_session *session;
+    struct list *ptr;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE("%p\n", logon_id);
+
+    AcquireSRWLockExclusive(&lsa_sessions_lock);
+    if (!(session = find_lsa_session(logon_id))) status = STATUS_NO_SUCH_LOGON_SESSION;
+    else
+    {
+        while ((ptr = list_head(&session->credentials)))
+            free_lsa_credential(LIST_ENTRY(ptr, struct lsa_credential, entry));
+#ifndef SG_MUTANT_LSA_DELETE_KEEPS_SESSION
+        list_remove(&session->entry);
+        free(session);
+#endif
+    }
+    ReleaseSRWLockExclusive(&lsa_sessions_lock);
+    return status;
 }
 
 static NTSTATUS NTAPI lsa_AddCredential(LUID *logon_id, ULONG package_id,
     LSA_STRING *primary_key, LSA_STRING *credentials)
 {
-    FIXME("%p,%lu,%s,%s: stub\n", logon_id, package_id,
-        debugstr_as(primary_key), debugstr_as(credentials));
-    return STATUS_NOT_IMPLEMENTED;
+    struct lsa_session *session;
+    struct lsa_credential *cred;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE("%p,%lu,%s,%s\n", logon_id, package_id, debugstr_as(primary_key), debugstr_as(credentials));
+
+    AcquireSRWLockExclusive(&lsa_sessions_lock);
+    if (!(session = find_lsa_session(logon_id))) status = STATUS_NO_SUCH_LOGON_SESSION;
+    else if (!(cred = calloc(1, sizeof(*cred)))) status = STATUS_NO_MEMORY;
+    else
+    {
+        cred->package_id = package_id;
+        if (!copy_lsa_string(&cred->primary_key, primary_key) || !copy_lsa_string(&cred->credentials, credentials))
+        {
+            free(cred->primary_key.Buffer);
+            free(cred);
+            status = STATUS_NO_MEMORY;
+        }
+        else list_add_tail(&session->credentials, &cred->entry);
+    }
+    ReleaseSRWLockExclusive(&lsa_sessions_lock);
+    return status;
 }
 
+static void * NTAPI lsa_AllocateLsaHeap(ULONG size);
+
 static NTSTATUS NTAPI lsa_GetCredentials(LUID *logon_id, ULONG package_id, ULONG *context,
     BOOLEAN retrieve_all, LSA_STRING *primary_key, ULONG *primary_key_len, LSA_STRING *credentials)
 {
-    FIXME("%p,%#lx,%p,%d,%p,%p,%p: stub\n", logon_id, package_id, context,
-        retrieve_all, primary_key, primary_key_len, credentials);
-    return STATUS_NOT_IMPLEMENTED;
+    struct lsa_session *session;
+    struct lsa_credential *cred;
+    ULONG index = 0;
+    NTSTATUS status = ERROR_GEN_FAILURE;
+
+    TRACE("%p,%#lx,%p,%d,%p,%p,%p\n", logon_id, package_id, context, retrieve_all, primary_key,
+        primary_key_len, credentials);
+
+    AcquireSRWLockExclusive(&lsa_sessions_lock);
+    if (!(session = find_lsa_session(logon_id)))
+    {
+        ReleaseSRWLockExclusive(&lsa_sessions_lock);
+        return STATUS_NO_SUCH_LOGON_SESSION;
+    }
+
+    LIST_FOR_EACH_ENTRY(cred, &session->credentials, struct lsa_credential, entry)
+    {
+        if (index++ < *context) continue;
+        if (cred->package_id != package_id) continue;
+        if (!retrieve_all && !lsa_string_equal(&cred->primary_key, primary_key)) continue;
+
+        if (retrieve_all)
+        {
+            if (primary_key_len) *primary_key_len = cred->primary_key.Length;
+            if (primary_key->MaximumLength < cred->primary_key.Length)
+            {
+                /* nothing is consumed: the caller asks again with room */
+#ifdef SG_MUTANT_LSA_MORE_CONSUMES
+                *context = index;
+#endif
+                status = STATUS_MORE_ENTRIES;
+                break;
+            }
+        }
+        credentials->Buffer = cred->credentials.Length ? lsa_AllocateLsaHeap(cred->credentials.Length) : NULL;
+        if (cred->credentials.Length && !credentials->Buffer)
+        {
+            status = STATUS_NO_MEMORY;
+            break;
+        }
+        memcpy(credentials->Buffer, cred->credentials.Buffer, cred->credentials.Length);
+        credentials->Length = credentials->MaximumLength = cred->credentials.Length;
+        if (retrieve_all)
+        {
+            memcpy(primary_key->Buffer, cred->primary_key.Buffer, cred->primary_key.Length);
+            primary_key->Length = cred->primary_key.Length;
+        }
+#ifndef SG_MUTANT_LSA_NO_ADVANCE
+        *context = index;
+#endif
+        status = STATUS_SUCCESS;
+        break;
+    }
+    ReleaseSRWLockExclusive(&lsa_sessions_lock);
+    return status;
 }
 
 static NTSTATUS NTAPI lsa_DeleteCredential(LUID *logon_id, ULONG package_id, LSA_STRING *primary_key)
 {
-    FIXME("%p,%#lx,%s: stub\n", logon_id, package_id, debugstr_as(primary_key));
-    return STATUS_NOT_IMPLEMENTED;
+    struct lsa_session *session;
+    struct lsa_credential *cred;
+    NTSTATUS status = ERROR_GEN_FAILURE;
+
+    TRACE("%p,%#lx,%s\n", logon_id, package_id, debugstr_as(primary_key));
+
+    AcquireSRWLockExclusive(&lsa_sessions_lock);
+    if (!(session = find_lsa_session(logon_id))) status = STATUS_NO_SUCH_LOGON_SESSION;
+    else
+    {
+        LIST_FOR_EACH_ENTRY(cred, &session->credentials, struct lsa_credential, entry)
+        {
+            if (cred->package_id != package_id || !lsa_string_equal(&cred->primary_key, primary_key)) continue;
+            free_lsa_credential(cred);
+            status = STATUS_SUCCESS;
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive(&lsa_sessions_lock);
+    return status;
 }
 
 static void * NTAPI lsa_AllocateLsaHeap(ULONG size)
--- a/dlls/secur32/tests/Makefile.in
+++ b/dlls/secur32/tests/Makefile.in
@@ -2,6 +2,9 @@ TESTDLL   = secur32.dll
 IMPORTS   = secur32 crypt32 advapi32 ws2_32
 
 SOURCES = \
+	lsa.c \
+	lsa_ssp.c \
+	lsa_ssp.spec \
 	main.c \
 	negotiate.c \
 	ntlm.c \
