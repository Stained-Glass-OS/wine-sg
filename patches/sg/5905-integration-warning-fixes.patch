From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] widl, dxgi, winegstreamer, gdi32: warning fixes for the merged series (5905)

Compiler warnings of new code in the merged series, no behaviour change:
- widl (3309): the switches over typegen types that had no case for the
  new TGT_PIPE get an explicit empty one (what they did before: nothing).
- dxgi: GetSharedResourceAdapterLuid lost two variables when fast-a 3324
  replaced fast-b 3719's private-export lookup.
- winegstreamer (3299): the /dev path buffer holds any directory entry name.
- gdi32 (5222): the NamedEscape trace prints its integers with matching
  formats.

Integration patch (integ-2026-10).
---
diff --git a/dlls/dxgi/factory.c b/dlls/dxgi/factory.c
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -452,9 +452,6 @@ done:
 static HRESULT STDMETHODCALLTYPE dxgi_factory_GetSharedResourceAdapterLuid(IWineDXGIFactory *iface,
         HANDLE resource, LUID *luid)
 {
-    HRESULT (CDECL *get_luid)(HANDLE, LUID *);
-    HMODULE d3d11;
-
     TRACE("iface %p, resource %p, luid %p.\n", iface, resource, luid);
 
     if (!luid)
diff --git a/dlls/gdi32/enhmetafile.c b/dlls/gdi32/enhmetafile.c
--- a/dlls/gdi32/enhmetafile.c
+++ b/dlls/gdi32/enhmetafile.c
@@ -2448,7 +2448,7 @@ BOOL WINAPI PlayEnhMetaFileRecord(
         if ((esc->cjDriver & 1) || esc->cjDriver > avail || esc->cjIn > avail - esc->cjDriver) break;
         if (!(name = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, esc->cjDriver + sizeof(WCHAR) ))) break;
         memcpy( name, esc->Data, esc->cjDriver );
-        TRACE( "NamedEscape: driver %s, escape %d, %d bytes\n", debugstr_w(name), esc->iEscape, esc->cjIn );
+        TRACE( "NamedEscape: driver %s, escape %ld, %ld bytes\n", debugstr_w(name), (long)esc->iEscape, (long)esc->cjIn );
         NamedEscape( hdc, name, esc->iEscape, esc->cjIn, (const char *)esc->Data + esc->cjDriver, 0, NULL );
         HeapFree( GetProcessHeap(), 0, name );
         break;
diff --git a/dlls/winegstreamer/wg_capture.c b/dlls/winegstreamer/wg_capture.c
--- a/dlls/winegstreamer/wg_capture.c
+++ b/dlls/winegstreamer/wg_capture.c
@@ -145,7 +145,7 @@ NTSTATUS wg_capture_enum(void *args)
         for (i = 0; i < n; ++i)
         {
             const char *name = names[i]->d_name;
-            char path[64];
+            char path[sizeof("/dev/") + sizeof(names[i]->d_name)];
             struct v4l2_capability cap;
             uint32_t caps;
             int fd;
