+/* Stained Glass OS: a printer's input bins by their print schema names, the
+ * others as ours ("ns0000:Bin<number>"); every bin was psk:AutoSelect */
+static const struct
+{
+    const WCHAR *name;
+    int bin;
+} psk_bins[] =
+{
+    { L"psk:AutoSelect", DMBIN_AUTO },
+    { L"psk:Manual", DMBIN_MANUAL },
+    { L"psk:Cassette", DMBIN_CASSETTE },
+    { L"psk:Tractor", DMBIN_TRACTOR },
+    { L"psk:EnvelopeFeed", DMBIN_ENVELOPE },
+    { L"psk:High", DMBIN_LARGECAPACITY },
+};
+
+static int option_to_bin(const WCHAR *name)
+{
+    const WCHAR *local = wcschr(name, ':');
+    WCHAR *end;
+    unsigned long bin;
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(psk_bins); i++)
+        if (!wcscmp(name, psk_bins[i].name)) return psk_bins[i].bin;
+    if (local && wcsncmp(name, L"psk:", 4) && !wcsncmp(local + 1, L"Bin", 3))
+    {
+        bin = wcstoul(local + 4, &end, 10);
+        if (!*end && bin && bin <= 0x7fff) return bin;
+    }
+    FIXME("%s\n", wine_dbgstr_w(name));
+    return DMBIN_AUTO;
+}
+
+static const WCHAR *bin_to_option(int bin)
+{
+    static WCHAR names[DMBIN_USER + 512][16];  /* bins are WORDs; the drivers' own ones from DMBIN_USER */
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(psk_bins); i++)
+        if (psk_bins[i].bin == bin) return psk_bins[i].name;
+    if (bin <= 0 || bin >= ARRAY_SIZE(names)) return L"psk:AutoSelect";
+    if (!names[bin][0]) swprintf(names[bin], ARRAY_SIZE(names[bin]), L"ns0000:Bin%d", bin);
+    return names[bin];
+}
