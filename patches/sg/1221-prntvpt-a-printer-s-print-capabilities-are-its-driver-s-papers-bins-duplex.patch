+static void read_JobDuplex(IXMLDOMDocument2 *doc, struct ticket *ticket)
+{
+    IXMLDOMNode *node, *option;
+    IXMLDOMElement *element;
+    VARIANT var;
+    HRESULT hr;
+
+    hr = IXMLDOMDocument2_selectSingleNode(doc, (BSTR)L"psf:PrintTicket/psf:Feature[@name='psk:JobDuplexAllDocumentsContiguously']", &node);
+    if (hr != S_OK) return;
