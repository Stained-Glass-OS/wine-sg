+/* Stained Glass OS: a paper of the driver's own (a label, a GPD's or a PPD's
+ * page) is an option of ours, "ns0000:Paper<number>" -- the prefix the
+ * capabilities declare, whatever prefix a program's ticket gives it */
+#define SG_PRIVATE_NS L"urn:stained-glass-os:printing:driver"
+
+static int private_paper(const WCHAR *name)
+{
+    const WCHAR *local = wcschr(name, ':');
+    WCHAR *end;
+    unsigned long paper;
+
+    if (!local || !wcsncmp(name, L"psk:", 4)) return -1;
+    if (wcsncmp(local + 1, L"Paper", 5)) return -1;
+    paper = wcstoul(local + 6, &end, 10);
+    if (*end || !paper || paper > 0x7fff) return -1;
+    return paper;
+}
