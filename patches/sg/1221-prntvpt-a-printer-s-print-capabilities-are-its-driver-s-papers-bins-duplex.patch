+                TRACE("duplex: %s => %d\n", wine_dbgstr_w(V_BSTR(&var)), ticket->job.duplex);
+            }
+            VariantClear(&var);
+            IXMLDOMElement_Release(element);
+        }
+        IXMLDOMNode_Release(option);
+    }
+    IXMLDOMNode_Release(node);
+}
