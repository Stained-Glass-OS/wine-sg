+/* Stained Glass OS: a printer's PrintCapabilities, made from what its driver
+ * tells DeviceCapabilities -- the papers (by name and size, the driver's own
+ * ones in our private namespace), a custom size's range, the imageable area,
+ * colour, resolutions, orientations, collation, duplex, input bins and
+ * copies. Every feature was written empty: programs that choose a page from
+ * the capabilities (DYMO Connect looks for its label among the papers, WPF's
+ * PrintDialog lists them) found none and printed on a "custom" page the
+ * driver did not have. Works for any driver: a CUPS printer's PPD through
+ * wineps, a printer maker's Windows driver through its DrvDeviceCapabilities. */
+
+static HRESULT write_string_value(IXMLDOMElement *root, const WCHAR *type, const WCHAR *text)
+{
+    IXMLDOMElement *child;
+    HRESULT hr;
+    BSTR str;
+
+    hr = create_element(root, L"psf:Value", &child);
+    if (hr != S_OK) return hr;
+
+    hr = add_attribute(child, L"xsi:type", type);
+    if (hr == S_OK)
+    {
+        str = SysAllocString(text);
+        hr = IXMLDOMElement_put_text(child, str);
+        SysFreeString(str);
+    }
+
+    IXMLDOMElement_Release(child);
+    return hr;
+}
+
+static HRESULT add_property(IXMLDOMElement *root, const WCHAR *name, const WCHAR *type, const WCHAR *text)
+{
+    IXMLDOMElement *property;
+    HRESULT hr;
+
+    hr = create_element(root, L"psf:Property", &property);
+    if (hr != S_OK) return hr;
+    hr = add_attribute(property, L"name", name);
+    if (hr == S_OK) hr = write_string_value(property, type, text);
+    IXMLDOMElement_Release(property);
+    return hr;
+}
+
+static HRESULT add_int_property(IXMLDOMElement *root, const WCHAR *name, int value)
+{
+    IXMLDOMElement *property;
+    HRESULT hr;
+
+    hr = create_element(root, L"psf:Property", &property);
+    if (hr != S_OK) return hr;
+    hr = add_attribute(property, L"name", name);
+    if (hr == S_OK) hr = write_int_value(property, value);
+    IXMLDOMElement_Release(property);
+    return hr;
+}
+
+static HRESULT add_int_scored(IXMLDOMElement *root, const WCHAR *name, int value)
+{
+    IXMLDOMElement *property;
+    HRESULT hr;
+
+    hr = create_ScoredProperty(root, name, &property);
+    if (hr != S_OK) return hr;
+    hr = write_int_value(property, value);
+    IXMLDOMElement_Release(property);
+    return hr;
+}
+
+static HRESULT add_display_name(IXMLDOMElement *root, const WCHAR *text)
+{
+    return add_property(root, L"psk:DisplayName", L"xsd:string", text);
+}
+
+/* a feature with its selection type and display name */
+static HRESULT create_caps_Feature(IXMLDOMElement *root, const WCHAR *name, const WCHAR *display, IXMLDOMElement **feature)
+{
+    HRESULT hr;
+
+    hr = create_Feature(root, name, feature);
+    if (hr != S_OK) return hr;
+    hr = add_property(*feature, L"psf:SelectionType", L"xsd:QName", L"psk:PickOne");
+    if (hr == S_OK) hr = add_display_name(*feature, display);
+    if (hr != S_OK) IXMLDOMElement_Release(*feature);
+    return hr;
+}
+
+/* an option with a display name, and nothing else */
+static HRESULT add_caps_Option(IXMLDOMElement *feature, const WCHAR *name, const WCHAR *display)
+{
+    IXMLDOMElement *option;
+    HRESULT hr;
+
+    hr = create_Option(feature, name, &option);
+    if (hr != S_OK) return hr;
+    hr = add_display_name(option, display);
+    IXMLDOMElement_Release(option);
+    return hr;
+}
+
+/* an integer parameter's definition: psk:JobCopiesAllDocuments, a custom
+ * size's psk:PageMediaSizeMediaSizeWidth/Height */
+static HRESULT add_ParameterDef(IXMLDOMElement *root, const WCHAR *name, const WCHAR *display, int def,
+                                int min, int max, const WCHAR *unit)
+{
+    IXMLDOMElement *parameter;
+    HRESULT hr;
+
+    hr = create_ParameterDef(root, name, &parameter);
+    if (hr != S_OK) return hr;
+    hr = add_property(parameter, L"psf:DataType", L"xsd:QName", L"xsd:integer");
+    if (hr == S_OK) hr = add_int_property(parameter, L"psf:DefaultValue", def);
+    if (hr == S_OK) hr = add_int_property(parameter, L"psf:MinValue", min);
+    if (hr == S_OK) hr = add_int_property(parameter, L"psf:MaxValue", max);
+    if (hr == S_OK) hr = add_int_property(parameter, L"psf:Multiple", 1);
+    if (hr == S_OK) hr = add_property(parameter, L"psf:Mandatory", L"xsd:QName", L"psk:Conditional");
+    if (hr == S_OK) hr = add_property(parameter, L"psf:UnitType", L"xsd:string", unit);
+    if (hr == S_OK) hr = add_display_name(parameter, display);
+    IXMLDOMElement_Release(parameter);
+    return hr;
+}
