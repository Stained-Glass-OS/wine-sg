+    hr = IXMLDOMNode_selectSingleNode(node, (BSTR)L"./psf:Option", &option);
+    if (hr == S_OK)
+    {
+        if (IXMLDOMNode_QueryInterface(option, &IID_IXMLDOMElement, (void **)&element) == S_OK)
+        {
+            VariantInit(&var);
+            if (IXMLDOMElement_getAttribute(element, (BSTR)L"name", &var) == S_OK && V_VT(&var) == VT_BSTR)
+            {
+                if (!wcscmp(V_BSTR(&var), L"psk:TwoSidedLongEdge")) ticket->job.duplex = DMDUP_VERTICAL;
+                else if (!wcscmp(V_BSTR(&var), L"psk:TwoSidedShortEdge")) ticket->job.duplex = DMDUP_HORIZONTAL;
