+/* the paper's size when the devmode names a paper only */
+static void paper_size_from_driver(struct prn_provider *prov, struct ticket *ticket)
+{
+    int count, i;
+    WORD *papers;
+    POINT *pt;
+
+    if (ticket->page.media.size.width > 0 && ticket->page.media.size.height > 0) return;
+    if (ticket->page.media.paper <= 0) return;
+    count = DeviceCapabilitiesW(prov->name, NULL, DC_PAPERS, NULL, NULL);
+    if (count <= 0) return;
+    papers = calloc(count, sizeof(*papers));
+    pt = calloc(count, sizeof(*pt));
+    if (papers && pt && DeviceCapabilitiesW(prov->name, NULL, DC_PAPERS, (LPWSTR)papers, NULL) == count &&
+        DeviceCapabilitiesW(prov->name, NULL, DC_PAPERSIZE, NULL, NULL) <= count &&
+        DeviceCapabilitiesW(prov->name, NULL, DC_PAPERSIZE, (LPWSTR)pt, NULL) > 0)
+    {
+        for (i = 0; i < count; i++)
+            if (papers[i] == ticket->page.media.paper)
+            {
+                ticket->page.media.size.width = pt[i].x * 100;
+                ticket->page.media.size.height = pt[i].y * 100;
+                break;
+            }
+    }
+    free(papers);
+    free(pt);
+}
