+/* Stained Glass OS: a custom size the driver has a paper of (a program
+ * naming its label by size) is that paper: within half a millimetre, either
+ * way round */
+static int driver_paper_of_size(const WCHAR *device, int width, int length)
+{
+    int count, i, paper = 0;
+    WORD *papers;
+    POINT *pt;
+
+    if (width <= 0 || length <= 0) return 0;
+    count = DeviceCapabilitiesW(device, NULL, DC_PAPERS, NULL, NULL);
+    if (count <= 0) return 0;
+    papers = calloc(count, sizeof(*papers));
+    pt = calloc(count, sizeof(*pt));
+    if (papers && pt && DeviceCapabilitiesW(device, NULL, DC_PAPERS, (LPWSTR)papers, NULL) == count &&
+        DeviceCapabilitiesW(device, NULL, DC_PAPERSIZE, NULL, NULL) <= count &&
+        DeviceCapabilitiesW(device, NULL, DC_PAPERSIZE, (LPWSTR)pt, NULL) > 0)
+    {
+        for (i = 0; i < count && !paper; i++)
+        {
+            if (pt[i].x <= 0 || pt[i].y <= 0) continue;
+            if ((abs(pt[i].x - width) <= 5 && abs(pt[i].y - length) <= 5) ||
+                (abs(pt[i].x - length) <= 5 && abs(pt[i].y - width) <= 5))
+                paper = papers[i];
+        }
+    }
+    free(papers);
+    free(pt);
+    TRACE("%dx%d: paper %d\n", width, length, paper);
+    return paper;
+}
