+/* the page's imageable area for the ticket's settings, as a program's
+ * printer DC has it, in microns */
+static HRESULT write_PageImageableSize_caps(const WCHAR *device, IXMLDOMElement *root, const DEVMODEW *dm)
+{
+    IXMLDOMElement *size, *area;
+    int dpix, dpiy;
+    HRESULT hr;
+    HDC hdc;
+
+    hdc = CreateICW(NULL, device, NULL, dm);
+    if (!hdc) return S_OK;  /* nothing known: no imageable area */
+
+    dpix = GetDeviceCaps(hdc, LOGPIXELSX);
+    dpiy = GetDeviceCaps(hdc, LOGPIXELSY);
+    if (dpix <= 0 || dpiy <= 0)
+    {
+        DeleteDC(hdc);
+        return S_OK;
+    }
+
+    hr = create_element(root, L"psf:Property", &size);
+    if (hr == S_OK)
+    {
+        hr = add_attribute(size, L"name", L"psk:PageImageableSize");
+        if (hr == S_OK)
+            hr = add_int_property(size, L"psk:ImageableSizeWidth", MulDiv(GetDeviceCaps(hdc, PHYSICALWIDTH), 25400, dpix));
+        if (hr == S_OK)
+            hr = add_int_property(size, L"psk:ImageableSizeHeight", MulDiv(GetDeviceCaps(hdc, PHYSICALHEIGHT), 25400, dpiy));
+        if (hr == S_OK) hr = create_element(size, L"psf:Property", &area);
+        if (hr == S_OK)
+        {
+            hr = add_attribute(area, L"name", L"psk:ImageableArea");
+            if (hr == S_OK)
+                hr = add_int_property(area, L"psk:OriginWidth", MulDiv(GetDeviceCaps(hdc, PHYSICALOFFSETX), 25400, dpix));
+            if (hr == S_OK)
+                hr = add_int_property(area, L"psk:OriginHeight", MulDiv(GetDeviceCaps(hdc, PHYSICALOFFSETY), 25400, dpiy));
+            if (hr == S_OK)
+                hr = add_int_property(area, L"psk:ExtentWidth", MulDiv(GetDeviceCaps(hdc, HORZRES), 25400, dpix));
+            if (hr == S_OK)
+                hr = add_int_property(area, L"psk:ExtentHeight", MulDiv(GetDeviceCaps(hdc, VERTRES), 25400, dpiy));
+            IXMLDOMElement_Release(area);
+        }
+        IXMLDOMElement_Release(size);
+    }
+
+    DeleteDC(hdc);
+    return hr;
+}
