index 9f571d6..a03c9a3 100644
--- a/programs/explorer/explorer.c
+++ b/programs/explorer/explorer.c
@@ -205,6 +205,10 @@ int WINAPI wWinMain(HINSTANCE hinstance,
         ERR( "Could not initialize COM\n" );
