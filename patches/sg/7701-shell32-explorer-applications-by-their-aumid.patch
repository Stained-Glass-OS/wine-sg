--- /dev/null
+++ b/dlls/shell32/appactivate.c
@@ -0,0 +1,379 @@
+/*
+ * ApplicationActivationManager: packaged applications by their AppUserModelID
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * A packaged application is named by its AppUserModelID, "<package family
+ * name>!<application id>". IApplicationActivationManager starts it (with
+ * arguments, for files, for URIs) and returns its process id; ShellExecuteEx
+ * and explorer.exe start "shell:AppsFolder\<AUMID>" the same way. The
+ * application is the package's (appxdeploymentclient's records,
+ * HKCU\Software\Wine\AppModel\Packages, then the machine's) Application
+ * element of that Id in the manifest of its InstallLocation; its Executable is
+ * started in the package's content folder (its external location for a
+ * package with one), so the process has the package's identity (kernelbase,
+ * 0061). Of several installed versions the highest is started.
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "winuser.h"
+#include "shlobj.h"
+#include "shobjidl.h"
+#include "shlwapi.h"
+#include "shellapi.h"
+#include "xmllite.h"
+#include "shell32_main.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+/* xmllite's IIDs are not in libuuid */
+static const GUID iid_xml_reader = {0x7279fc81,0x709d,0x4095,{0xb6,0x3d,0x69,0xfe,0x4b,0x0d,0x90,0x30}};
+
+struct app_target
+{
+    WCHAR exe[MAX_PATH];
+    WCHAR dir[MAX_PATH];
+};
+
+/* a manifest's Executable as a path in the content folder: relative, no ".." */
+static BOOL content_path( const WCHAR *root, const WCHAR *name, WCHAR *out, size_t size )
+{
+    const WCHAR *p = name, *start;
+    WCHAR *q;
+
+    if (!name[0] || name[0] == '\\' || name[0] == '/' || wcschr( name, ':' )) return FALSE;
+    while (*p)
+    {
+        start = p;
+        while (*p && *p != '\\' && *p != '/') p++;
+        if (p == start || (p - start == 2 && start[0] == '.' && start[1] == '.') ||
+            (p - start == 1 && start[0] == '.')) return FALSE;
+        if (*p) p++;
+    }
+    if (swprintf( out, size, L"%s\\%s", root, name ) < 0) return FALSE;
+    for (q = out; *q; q++) if (*q == '/') *q = '\\';
+    return TRUE;
+}
+
+/* the Executable of the manifest's application of this Id */
+static BOOL manifest_executable( const WCHAR *manifest, const WCHAR *app_id, WCHAR *exe, DWORD size )
+{
+    IXmlReader *reader = NULL;
+    IStream *stream = NULL;
+    XmlNodeType node;
+    BOOL ret = FALSE;
+
+    if (FAILED(SHCreateStreamOnFileEx( manifest, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream )))
+        return FALSE;
+    if (FAILED(CreateXmlReader( &iid_xml_reader, (void **)&reader, NULL ))) goto done;
+    IXmlReader_SetProperty( reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit );
+    if (FAILED(IXmlReader_SetInput( reader, (IUnknown *)stream ))) goto done;
+
+    while (!ret && IXmlReader_Read( reader, &node ) == S_OK)
+    {
+        const WCHAR *name, *value;
+        UINT depth;
+
+        if (node != XmlNodeType_Element) continue;
+        IXmlReader_GetLocalName( reader, &name, NULL );
+        IXmlReader_GetDepth( reader, &depth );
+        /* Package > Applications > Application */
+        if (depth != 2 || wcscmp( name, L"Application" )) continue;
+        if (IXmlReader_MoveToAttributeByName( reader, L"Id", NULL ) != S_OK ||
+            FAILED(IXmlReader_GetValue( reader, &value, NULL )) || wcsicmp( value, app_id )) continue;
+        IXmlReader_MoveToElement( reader );
+        if (IXmlReader_MoveToAttributeByName( reader, L"Executable", NULL ) == S_OK &&
+            SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL )) && wcslen( value ) < size)
+        {
+            wcscpy( exe, value );
+            ret = TRUE;
+        }
+        break;
+    }
+
+done:
+    if (reader) IXmlReader_Release( reader );
+    IStream_Release( stream );
+    return ret;
+}
+
+static DWORD reg_dword( HKEY key, const WCHAR *name )
+{
+    DWORD value = 0, size = sizeof(value);
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_DWORD, NULL, &value, &size )) value = 0;
+    return value;
+}
+
+/* The application an AUMID names, among the user's packages and then the machine's. */
+static BOOL find_application( const WCHAR *aumid, struct app_target *target )
+{
+    static const HKEY roots[2] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE };
+    WCHAR family[256], app_id[256], name[256], value[MAX_PATH], location[MAX_PATH], root[MAX_PATH];
+    WCHAR manifest[MAX_PATH + 32], exe[MAX_PATH];
+    const WCHAR *bang;
+    UINT64 best = 0, version;
+    DWORD len, index, size, i;
+    BOOL found = FALSE;
+    HKEY key, sub;
+
+    if (!aumid || !(bang = wcschr( aumid, '!' )) || bang == aumid || !bang[1] ||
+        bang - aumid >= ARRAY_SIZE(family) || wcslen( bang + 1 ) >= ARRAY_SIZE(app_id)) return FALSE;
+    lstrcpynW( family, aumid, bang - aumid + 1 );
+    wcscpy( app_id, bang + 1 );
+
+    for (i = 0; i < ARRAY_SIZE(roots); i++)
+    {
+        if (RegOpenKeyExW( roots[i], L"Software\\Wine\\AppModel\\Packages", 0, KEY_READ | KEY_WOW64_64KEY, &key ))
+            continue;
+        index = 0;
+        while (len = ARRAY_SIZE(name), !RegEnumKeyExW( key, index++, name, &len, NULL, NULL, NULL, NULL ))
+        {
+            if (RegOpenKeyExW( key, name, 0, KEY_READ, &sub )) continue;
+            size = sizeof(value);
+            if (RegGetValueW( sub, NULL, L"FamilyName", RRF_RT_REG_SZ, NULL, value, &size ) || wcsicmp( value, family ) ||
+                reg_dword( sub, L"Staged" ) || reg_dword( sub, L"Framework" ) || reg_dword( sub, L"ResourcePackage" ))
+            {
+                RegCloseKey( sub );
+                continue;
+            }
+            size = sizeof(version);
+            if (RegGetValueW( sub, NULL, L"Version", RRF_RT_REG_QWORD, NULL, &version, &size )) version = 0;
+            size = sizeof(location);
+            if ((!found || version > best) &&
+                !RegGetValueW( sub, NULL, L"InstallLocation", RRF_RT_REG_SZ, NULL, location, &size ))
+            {
+                size = sizeof(root);
+                if (RegGetValueW( sub, NULL, L"ExternalLocation", RRF_RT_REG_SZ, NULL, root, &size ))
+                    wcscpy( root, location );
+                swprintf( manifest, ARRAY_SIZE(manifest), L"%s\\AppxManifest.xml", location );
+                if (manifest_executable( manifest, app_id, exe, ARRAY_SIZE(exe) ) &&
+                    content_path( root, exe, target->exe, ARRAY_SIZE(target->exe) ))
+                {
+                    wcscpy( target->dir, root );
+                    best = version;
+                    found = TRUE;
+                }
+            }
+            RegCloseKey( sub );
+        }
+        RegCloseKey( key );
+        /* the user's own registration comes before the machine's */
+        if (found) break;
+    }
+    TRACE( "%s -> %s\n", debugstr_w( aumid ), found ? debugstr_w( target->exe ) : "not found" );
+    return found;
+}
+
+/* Start the application an AUMID names with these arguments. */
+HRESULT activate_application( const WCHAR *aumid, const WCHAR *args, DWORD *pid, HANDLE *process )
+{
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    struct app_target target;
+    WCHAR *cmdline;
+    size_t len;
+
+    if (pid) *pid = 0;
+    if (process) *process = NULL;
+    if (!aumid || !aumid[0]) return E_INVALIDARG;
+#ifndef SG_MUTANT_AUMID_NO_LOOKUP
+    if (!find_application( aumid, &target ))
+#endif
+        return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+
+    len = wcslen( target.exe ) + (args ? wcslen( args ) : 0) + 4;
+    if (!(cmdline = malloc( len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    swprintf( cmdline, len, args && args[0] ? L"\"%s\" %s" : L"\"%s\"", target.exe, args );
+    if (!CreateProcessW( target.exe, cmdline, NULL, NULL, FALSE, 0, NULL, target.dir, &si, &pi ))
+    {
+        DWORD err = GetLastError();
+        free( cmdline );
+        return HRESULT_FROM_WIN32( err );
+    }
+    free( cmdline );
+    AllowSetForegroundWindow( pi.dwProcessId );
+    if (pid) *pid = pi.dwProcessId;
+    if (process) *process = pi.hProcess;
+    else CloseHandle( pi.hProcess );
+    CloseHandle( pi.hThread );
+    return S_OK;
+}
+
+/* "shell:AppsFolder\<AUMID>" (or the Applications folder's CLSID): the AUMID; NULL for anything else */
+const WCHAR *apps_folder_aumid( const WCHAR *path )
+{
+    static const WCHAR *prefixes[] = { L"shell:AppsFolder\\", L"shell:::{4234d49b-0245-4df3-b780-3893943456e1}\\",
+                                       L"::{4234d49b-0245-4df3-b780-3893943456e1}\\" };
+    unsigned int i;
+
+    if (!path) return NULL;
+    for (i = 0; i < ARRAY_SIZE(prefixes); i++)
+    {
+        size_t len = wcslen( prefixes[i] );
+        if (!wcsnicmp( path, prefixes[i], len ) && wcschr( path + len, '!' )) return path + len;
+    }
+    return NULL;
+}
+
+/* ---- IApplicationActivationManager ------------------------------------------------------------ */
+
+struct activation_manager
+{
+    IApplicationActivationManager IApplicationActivationManager_iface;
+    LONG ref;
+};
+
+static inline struct activation_manager *impl_from_IApplicationActivationManager( IApplicationActivationManager *iface )
+{
+    return CONTAINING_RECORD( iface, struct activation_manager, IApplicationActivationManager_iface );
+}
+
+static HRESULT WINAPI manager_QueryInterface( IApplicationActivationManager *iface, REFIID iid, void **out )
+{
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IApplicationActivationManager ))
+    {
+        *out = iface;
+        IApplicationActivationManager_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI manager_AddRef( IApplicationActivationManager *iface )
+{
+    return InterlockedIncrement( &impl_from_IApplicationActivationManager( iface )->ref );
+}
+
+static ULONG WINAPI manager_Release( IApplicationActivationManager *iface )
+{
+    struct activation_manager *impl = impl_from_IApplicationActivationManager( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI manager_ActivateApplication( IApplicationActivationManager *iface, LPCWSTR aumid,
+                                                   LPCWSTR arguments, ACTIVATEOPTIONS options, DWORD *pid )
+{
+    TRACE( "(%p, %s, %s, %#x, %p)\n", iface, debugstr_w( aumid ), debugstr_w( arguments ), options, pid );
+    if (!pid) return E_POINTER;
+    return activate_application( aumid, arguments, pid, NULL );
+}
+
+/* the items' names (file paths, or URIs), each quoted, separated by spaces */
+static HRESULT item_arguments( IShellItemArray *items, BOOL urls, WCHAR **out )
+{
+    DWORD count = 0, i;
+    size_t len = 1, used = 0;
+    WCHAR *args, *grown;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!items) return E_INVALIDARG;
+    if (FAILED(hr = IShellItemArray_GetCount( items, &count ))) return hr;
+    if (!(args = calloc( 1, sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        IShellItem *item;
+        WCHAR *name = NULL;
+
+        if (FAILED(hr = IShellItemArray_GetItemAt( items, i, &item ))) break;
+        hr = IShellItem_GetDisplayName( item, urls ? SIGDN_URL : SIGDN_FILESYSPATH, &name );
+        if (FAILED(hr) && urls) hr = IShellItem_GetDisplayName( item, SIGDN_DESKTOPABSOLUTEPARSING, &name );
+        IShellItem_Release( item );
+        if (FAILED(hr)) break;
+        len += wcslen( name ) + 3;
+        if (!(grown = realloc( args, len * sizeof(WCHAR) )))
+        {
+            CoTaskMemFree( name );
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        args = grown;
+        used += swprintf( args + used, len - used, used ? L" \"%s\"" : L"\"%s\"", name );
+        CoTaskMemFree( name );
+    }
+    if (FAILED(hr))
+    {
+        free( args );
+        return hr;
+    }
+    *out = args;
+    return S_OK;
+}
+
+static HRESULT WINAPI manager_ActivateForFile( IApplicationActivationManager *iface, LPCWSTR aumid,
+                                               IShellItemArray *items, LPCWSTR verb, DWORD *pid )
+{
+    WCHAR *args;
+    HRESULT hr;
+
+    TRACE( "(%p, %s, %p, %s, %p)\n", iface, debugstr_w( aumid ), items, debugstr_w( verb ), pid );
+    if (!pid) return E_POINTER;
+    *pid = 0;
+    if (FAILED(hr = item_arguments( items, FALSE, &args ))) return hr;
+    hr = activate_application( aumid, args, pid, NULL );
+    free( args );
+    return hr;
+}
+
+static HRESULT WINAPI manager_ActivateForProtocol( IApplicationActivationManager *iface, LPCWSTR aumid,
+                                                   IShellItemArray *items, DWORD *pid )
+{
+    WCHAR *args;
+    HRESULT hr;
+
+    TRACE( "(%p, %s, %p, %p)\n", iface, debugstr_w( aumid ), items, pid );
+    if (!pid) return E_POINTER;
+    *pid = 0;
+    if (FAILED(hr = item_arguments( items, TRUE, &args ))) return hr;
+    hr = activate_application( aumid, args, pid, NULL );
+    free( args );
+    return hr;
+}
+
+static const IApplicationActivationManagerVtbl manager_vtbl =
+{
+    manager_QueryInterface,
+    manager_AddRef,
+    manager_Release,
+    manager_ActivateApplication,
+    manager_ActivateForFile,
+    manager_ActivateForProtocol,
+};
+
+HRESULT WINAPI ApplicationActivationManager_Constructor( IUnknown *outer, REFIID riid, void **out )
+{
+    struct activation_manager *impl;
+    HRESULT hr;
+
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IApplicationActivationManager_iface.lpVtbl = &manager_vtbl;
+    impl->ref = 1;
+    hr = IApplicationActivationManager_QueryInterface( &impl->IApplicationActivationManager_iface, riid, out );
+    IApplicationActivationManager_Release( &impl->IApplicationActivationManager_iface );
+    return hr;
+}
