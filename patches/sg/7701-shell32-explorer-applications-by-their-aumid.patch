+/* Stained Glass OS: "shell:AppsFolder\<AUMID>", a packaged application (appactivate.c) */
+static BOOL shell_execute_aumid( LPSHELLEXECUTEINFOW sei, const WCHAR *aumid )
+{
+    HANDLE process;
+    HRESULT hr;
+
+    TRACE( "application %s, parameters %s\n", debugstr_w( aumid ), debugstr_w( sei->lpParameters ) );
+    if (FAILED(hr = activate_application( aumid, sei->lpParameters, NULL, &process )))
+    {
+        sei->hInstApp = (HINSTANCE)SE_ERR_FNF;
+        if (!(sei->fMask & SEE_MASK_FLAG_NO_UI)) do_error_dialog( SE_ERR_FNF, sei->hwnd );
+        SetLastError( ERROR_FILE_NOT_FOUND );
+        return FALSE;
+    }
+    sei->hInstApp = (HINSTANCE)33;
+    if (sei->fMask & SEE_MASK_NOCLOSEPROCESS) sei->hProcess = process;
+    else CloseHandle( process );
+    return TRUE;
+}
+
 static BOOL SHELL_execute( LPSHELLEXECUTEINFOW sei, SHELL_ExecuteW32 execfunc )
 {
     /* Stained Glass OS 1657: SEE_MASK_FLAG_DDEWAIT (NOASYNC), ASYNCOK and
@@ -2367,6 +2387,9 @@ static BOOL SHELL_execute( LPSHELLEXECUTEINFOW sei, SHELL_ExecuteW32 execfunc )
     sei->hProcess = NULL;
     sei_tmp.hProcess = NULL;
 
+    if (!(sei_tmp.fMask & SEE_MASK_IDLIST) && sei_tmp.lpFile && apps_folder_aumid( sei_tmp.lpFile ))
+        return shell_execute_aumid( sei, apps_folder_aumid( sei_tmp.lpFile ) );
+
     /* make copies of all path/command strings */
     if (!sei_tmp.lpFile)
     {
