+        ExitProcess(ShellExecuteW(NULL,NULL,parameters.root,NULL,NULL,SW_SHOWDEFAULT) > (HINSTANCE)32 ?
+                    EXIT_SUCCESS : EXIT_FAILURE);
     /* shell:<known folder> is ours to open (ShellExecute would send it back here) */
     if(parameters.root[0] && !(parameters.root[0] == ':' && parameters.root[1] == ':') &&
        wcsnicmp(parameters.root, L"shell:", 6) && !PathIsDirectoryW(parameters.root))
