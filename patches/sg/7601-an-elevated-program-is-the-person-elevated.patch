From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, ntdll: an elevated program is the person who asked, elevated (7601)

On Windows, consent gives the same user a full token: an elevated program
is still that person. Here an elevated program runs on disk as the SYSTEM
account (ADR 0012), and it had SYSTEM's token too, so its HKCU, profile and
Start menu were SYSTEM's, and what an installer started when it was done
(MediaMonkey's Inno "launch", Dropbox) ran as SYSTEM in the person's
session with SYSTEM's settings.

- set_process_info SET_PROCESS_INFO_ELEVATED, with SET_PROCESS_INFO_SESSION:
  SYSTEM's own program, before it has a window station, takes the person's
  elevated token -- their SID and hive, Administrators, an administrator's
  privileges, elevation type Full, high integrity. What it starts inherits
  it. A refusal leaves it SYSTEM's and the session move stands. The server's
  own checks still go by the Unix account.
- ntdll asks for it when SG_ELEVATED_IDENTITY=1 (sg-elevated-run).
- A file's descriptor gives Administrators what it gives SYSTEM, as
  Windows' own folders do: an elevated program checking before it writes
  (AccessCheck on Program Files) would otherwise be refused.

Gate test-elevid; mutants SG_MUTANT_ELEVATED_AS_SYSTEM, SG_MUTANT_FILE_NO_ADMINS.
---
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -1272,6 +1272,7 @@
 #define SET_PROCESS_INFO_TOKEN    0x04
 #define SET_PROCESS_INFO_CHILD_POLICY 0x08
 #define SET_PROCESS_INFO_SESSION  0x10
+#define SET_PROCESS_INFO_ELEVATED 0x20
 
 
 /* Retrieve information about a thread */
--- a/include/wine/server_protocol.h
+++ b/include/wine/server_protocol.h
@@ -1360,6 +1360,7 @@
 #define SET_PROCESS_INFO_TOKEN    0x04
 #define SET_PROCESS_INFO_CHILD_POLICY 0x08
 #define SET_PROCESS_INFO_SESSION  0x10
+#define SET_PROCESS_INFO_ELEVATED 0x20
 
 
 
--- a/server/security.h
+++ b/server/security.h
@@ -59,6 +59,7 @@
 extern struct token *token_create_for_uid( unsigned primary, int impersonation_level,
                                            int elevation, unsigned int session_id, uid_t uid );
 extern void sg_ensure_user_hive( uid_t uid );
+extern struct token *token_create_elevated_for_uid( unsigned int session_id, uid_t uid );
 /* Stained Glass OS: may the requesting process mint or assign tokens? */
 extern int sg_requester_is_admin(void);
 extern int sg_token_same_user( struct token *a, struct token *b );
--- a/server/token.c
+++ b/server/token.c
@@ -1492,16 +1492,33 @@
  * has, and the integrity label drops from high to medium. Leaving any one of
  * them at the admin value leaves a token that is non-admin in name only.
  */
+static struct token *token_create_for_uid_ex( unsigned primary, int impersonation_level,
+                                              int elevation, unsigned int session_id, uid_t uid, int elevated );
+
 struct token *token_create_for_uid( unsigned primary, int impersonation_level,
                                     int elevation, unsigned int session_id, uid_t uid )
 {
+    return token_create_for_uid_ex( primary, impersonation_level, elevation, session_id, uid, 0 );
+}
+
+/* Stained Glass OS 7601: a person's elevated token, as Windows' consent gives
+ * an administrator -- the person's own SID, holding Administrators and an
+ * administrator's privileges, elevation type Full, high integrity */
+struct token *token_create_elevated_for_uid( unsigned int session_id, uid_t uid )
+{
+    return token_create_for_uid_ex( TRUE, -1, TokenElevationTypeFull, session_id, uid, 1 );
+}
+
+static struct token *token_create_for_uid_ex( unsigned primary, int impersonation_level,
+                                              int elevation, unsigned int session_id, uid_t uid, int elevated )
+{
     struct token *token = NULL;
     struct sid alias_admins_sid = { SID_REVISION, 2, SECURITY_NT_AUTHORITY, { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS }};
     struct sid alias_users_sid = { SID_REVISION, 2, SECURITY_NT_AUTHORITY, { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_USERS }};
     struct sid logon_sid = { SID_REVISION, 3, SECURITY_NT_AUTHORITY, { SECURITY_LOGON_IDS_RID, 0, 0 }};
     const struct sid *user_sid = security_unix_uid_to_sid( uid );
     struct acl *default_dacl = sg_create_system_dacl( user_sid );
-    int is_admin = (uid == 0 || uid == sg_system_prefix_uid);
+    int is_admin = elevated || uid == 0 || uid == sg_system_prefix_uid;
 
     static const struct luid_attr user_privs[] =
     {
--- a/server/process.c
+++ b/server/process.c
@@ -1813,6 +1813,39 @@
     return 0;
 }
 
+/* Stained Glass OS 7601: an elevated program is the person who asked for it,
+ * elevated -- on Windows consent gives the same user a full token. On disk it
+ * runs as the SYSTEM account (ADR 0012: Program Files, HKLM), and it had
+ * SYSTEM's token too: its HKCU, profile and Start menu were SYSTEM's, and what
+ * an installer started when done (MediaMonkey, Dropbox) ran as SYSTEM in the
+ * person's session, with SYSTEM's settings. Now it has the person's SID and
+ * hive, Administrators and an administrator's privileges; what it starts
+ * inherits that. Only for SYSTEM's own program, before it has a window
+ * station; the server's own checks still go by the Unix account. */
+static void sg_elevate_as_user( struct process *process, uid_t uid, unsigned int session_id )
+{
+    struct thread *thread;
+    struct token *token;
+
+#ifdef SG_MUTANT_ELEVATED_AS_SYSTEM
+    return;
+#endif
+    /* (the session it joined stands either way: a refusal leaves it SYSTEM's) */
+    if (process->peer_uid && process->peer_uid != sg_system_prefix_uid) return;
+    if (uid < 1000 || uid == sg_system_prefix_uid || process->winstation) return;
+    sg_ensure_user_hive( uid );
+    if (!(token = token_create_elevated_for_uid( session_id, uid ))) return;
+    release_object( process->token );
+    process->token = token;
+    free( process->obj.sd );
+    process->obj.sd = sg_create_owner_sd( token_get_user( token ) );
+    LIST_FOR_EACH_ENTRY( thread, &process->thread_list, struct thread, proc_entry )
+    {
+        free( thread->obj.sd );
+        thread->obj.sd = sg_create_owner_sd( token_get_user( token ) );
+    }
+}
+
 /* set information about a process */
 DECL_HANDLER(set_process_info)
 {
@@ -1840,6 +1873,7 @@
             {
                 process->session_id = id;
                 token_set_session_id( process->token, id );
+                if (req->mask & SET_PROCESS_INFO_ELEVATED) sg_elevate_as_user( process, req->session_uid, id );
             }
         }
         if (req->mask & SET_PROCESS_INFO_TOKEN)
--- a/server/file.c
+++ b/server/file.c
@@ -371,6 +371,8 @@
     return (struct fd *)grab_object( file->fd );
 }
 
+static const struct sid sg_file_admins_sid = { SID_REVISION, 2, SECURITY_NT_AUTHORITY, { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS } };
+
 struct security_descriptor *mode_to_sd( mode_t mode, const struct sid *user, const struct sid *group )
 {
     struct security_descriptor *sd;
@@ -381,6 +383,9 @@
     char *ptr;
 
     dacl_size = sizeof(*dacl) + sizeof(*ace) + sid_len( &local_system_sid );
+#ifndef SG_MUTANT_FILE_NO_ADMINS
+    dacl_size += sizeof(*ace) + sid_len( &sg_file_admins_sid );
+#endif
     if (mode & S_IRWXU) dacl_size += sizeof(*ace) + sid_len( user );
     if ((!(mode & S_IRUSR) && (mode & (S_IRGRP|S_IROTH))) ||
         (!(mode & S_IWUSR) && (mode & (S_IWGRP|S_IWOTH))) ||
@@ -406,6 +411,9 @@
     dacl->size     = dacl_size;
     dacl->count    = 1;
     dacl->pad2     = 0;
+#ifndef SG_MUTANT_FILE_NO_ADMINS
+    dacl->count++;
+#endif
     if (mode & S_IRWXU) dacl->count++;
     if ((!(mode & S_IRUSR) && (mode & (S_IRGRP|S_IROTH))) ||
         (!(mode & S_IWUSR) && (mode & (S_IWGRP|S_IWOTH))) ||
@@ -418,6 +426,14 @@
     /* always give FILE_ALL_ACCESS for Local System */
     ace = set_ace( (struct ace *)(dacl + 1), &local_system_sid,
                    ACCESS_ALLOWED_ACE_TYPE, flags, FILE_ALL_ACCESS );
+#ifndef SG_MUTANT_FILE_NO_ADMINS
+    /* Stained Glass OS 7601: and for Administrators, as Windows' own folders
+     * give them (Program Files, Windows, every profile). An elevated program
+     * is now an administrator, not SYSTEM: one that checks before it writes
+     * (AccessCheck on Program Files) would otherwise find it may not. What is
+     * allowed on disk is still the Unix permissions' decision. */
+    ace = set_ace( ace_next( ace ), &sg_file_admins_sid, ACCESS_ALLOWED_ACE_TYPE, flags, FILE_ALL_ACCESS );
+#endif
 
     if (mode & S_IRWXU)
     {
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1711,13 +1711,16 @@
      * only for SYSTEM */
     {
         const char *uid_str = getenv( "SG_SESSION_UID" );
+        /* and, for an elevated program, the requesting person's elevated token (7601) */
+        const char *elevated = getenv( "SG_ELEVATED_IDENTITY" );
 
         if (uid_str && *uid_str)
         {
             SERVER_START_REQ( set_process_info )
             {
                 req->handle      = wine_server_obj_handle( GetCurrentProcess() );
-                req->mask        = SET_PROCESS_INFO_SESSION;
+                req->mask        = SET_PROCESS_INFO_SESSION |
+                                   (elevated && !strcmp( elevated, "1" ) ? SET_PROCESS_INFO_ELEVATED : 0);
                 req->session_uid = strtoul( uid_str, NULL, 10 );
                 ret = wine_server_call( req );
             }
