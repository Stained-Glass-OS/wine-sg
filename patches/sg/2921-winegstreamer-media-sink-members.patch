 static HRESULT WINAPI stream_sink_type_handler_GetMediaTypeByIndex(IMFMediaTypeHandler *iface, DWORD index,
         IMFMediaType **type)
 {
-    FIXME("iface %p, index %lu, type %p.\n", iface, index, type);
+    struct stream_sink *stream_sink = impl_from_IMFMediaTypeHandler(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
+    IMFMediaType *copy;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, index %lu, type %p.\n", iface, index, type);
+
+    if (!type)
+        return E_POINTER;
+
+    EnterCriticalSection(&media_sink->cs);
+    if (index || !stream_sink->type)
+        hr = MF_E_NO_MORE_TYPES;
+    else if (SUCCEEDED(hr = MFCreateMediaType(&copy)))
+    {
+        if (SUCCEEDED(hr = IMFMediaType_CopyAllItems(stream_sink->type, (IMFAttributes *)copy)))
+            *type = copy;
+        else
+            IMFMediaType_Release(copy);
+    }
+    LeaveCriticalSection(&media_sink->cs);
+    return hr;
 }
 
+static HRESULT media_sink_rebuild_muxer(struct media_sink *media_sink, struct stream_sink *skip,
