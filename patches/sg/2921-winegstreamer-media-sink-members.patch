+static HRESULT stream_sink_check_type(struct stream_sink *stream_sink, IMFMediaType *type)
+{
+    GUID major, subtype, cur_major, cur_subtype;
+
+    if (FAILED(IMFMediaType_GetMajorType(type, &major)))
+        return MF_E_INVALIDMEDIATYPE;
+    if (!stream_sink->type)
+        return S_OK;
+
+    /* The stream keeps the kind of media it was added with. */
+    if (FAILED(IMFMediaType_GetMajorType(stream_sink->type, &cur_major)) || !IsEqualGUID(&major, &cur_major))
+        return MF_E_INVALIDMEDIATYPE;
+    if (SUCCEEDED(IMFMediaType_GetGUID(stream_sink->type, &MF_MT_SUBTYPE, &cur_subtype)))
+    {
+        if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)) || !IsEqualGUID(&subtype, &cur_subtype))
+            return MF_E_INVALIDMEDIATYPE;
+    }
+    return S_OK;
+}
+
 static HRESULT WINAPI stream_sink_type_handler_IsMediaTypeSupported(IMFMediaTypeHandler *iface,
         IMFMediaType *in_type, IMFMediaType **out_type)
 {
-    FIXME("iface %p, in_type %p, out_type %p.\n", iface, in_type, out_type);
+    struct stream_sink *stream_sink = impl_from_IMFMediaTypeHandler(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, in_type %p, out_type %p.\n", iface, in_type, out_type);
+
+    if (!in_type)
+        return E_POINTER;
+    if (out_type)
+        *out_type = NULL; /* there is no closest type to offer */
+
+    EnterCriticalSection(&media_sink->cs);
+    hr = stream_sink_check_type(stream_sink, in_type);
+    LeaveCriticalSection(&media_sink->cs);
+    return hr;
 }
 
 static HRESULT WINAPI stream_sink_type_handler_GetMediaTypeCount(IMFMediaTypeHandler *iface, DWORD *count)
 {
-    FIXME("iface %p, count %p.\n", iface, count);
+    struct stream_sink *stream_sink = impl_from_IMFMediaTypeHandler(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count)
+        return E_POINTER;
+
+    /* One type is accepted: the one the stream was added with. */
+    EnterCriticalSection(&media_sink->cs);
+    *count = stream_sink->type ? 1 : 0;
+#ifdef SG_MUTANT_TYPECOUNT
+    *count = 0;
+#endif
+    LeaveCriticalSection(&media_sink->cs);
+    return S_OK;
