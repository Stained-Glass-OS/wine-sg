+        hr = MF_E_INVALIDREQUEST; /* the muxer is already running with the old type */
+    else if (SUCCEEDED(hr = stream_sink_check_type(stream_sink, type))
+            && SUCCEEDED(hr = media_sink_rebuild_muxer(media_sink, NULL, stream_sink, type)))
+    {
+        IMFMediaType_AddRef(type);
+        if (stream_sink->type)
+            IMFMediaType_Release(stream_sink->type);
+        stream_sink->type = type;
+    }
+
+    LeaveCriticalSection(&media_sink->cs);
+    return hr;
 }
 
