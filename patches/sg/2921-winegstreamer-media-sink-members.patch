+/* The muxer takes its streams when they are added and has no way of dropping
+ * or changing one, so removing a stream or changing its type, before anything
+ * was written, builds a new muxer holding the streams as they are to be. */
+static HRESULT media_sink_rebuild_muxer(struct media_sink *media_sink, struct stream_sink *skip,
+        struct stream_sink *replace, IMFMediaType *new_type)
+{
+    struct stream_sink *stream_sink;
+    struct wg_format format;
+    wg_muxer_t muxer;
+    HRESULT hr;
+
+    if (FAILED(hr = wg_muxer_create(media_sink->format, &muxer)))
+        return hr;
+
+    LIST_FOR_EACH_ENTRY(stream_sink, &media_sink->stream_sinks, struct stream_sink, entry)
+    {
+        IMFMediaType *type = stream_sink == replace ? new_type : stream_sink->type;
+
+        if (stream_sink == skip)
+            continue;
+        mf_media_type_to_wg_format(type, &format);
+        if (FAILED(hr = wg_muxer_add_stream(muxer, stream_sink->id, &format)))
+        {
+            wg_muxer_destroy(muxer);
+            return hr;
+        }
+    }
+
+    wg_muxer_destroy(media_sink->muxer);
+    media_sink->muxer = muxer;
+    return S_OK;
+}
