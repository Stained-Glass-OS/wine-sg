             IMFAsyncResult_Release(command->u.finalize.result);
         free(command);
@@ -338,6 +358,12 @@ static HRESULT WINAPI stream_sink_ProcessSample(IMFStreamSink *iface, IMFSample
         return MF_E_SHUTDOWN;
     }
 
+    if (stream_sink->removed)
+    {
+        LeaveCriticalSection(&media_sink->cs);
+        return MF_E_STREAMSINK_REMOVED;
+    }
+
     if (media_sink->state != STATE_STARTED && media_sink->state != STATE_PAUSED)
     {
         LeaveCriticalSection(&media_sink->cs);
@@ -351,6 +377,7 @@ static HRESULT WINAPI stream_sink_ProcessSample(IMFStreamSink *iface, IMFSample
     }
     IMFSample_AddRef((command->u.process.sample = sample));
     command->u.process.stream_id = stream_sink->id;
+    command->u.process.generation = stream_sink->generation;
 
     hr = MFPutWorkItem(MFASYNC_CALLBACK_QUEUE_STANDARD,
             &media_sink->async_callback, &command->IUnknown_iface);
@@ -364,17 +391,67 @@ static HRESULT WINAPI stream_sink_ProcessSample(IMFStreamSink *iface, IMFSample
 static HRESULT WINAPI stream_sink_PlaceMarker(IMFStreamSink *iface, MFSTREAMSINK_MARKER_TYPE marker_type,
         const PROPVARIANT *marker_value, const PROPVARIANT *context_value)
 {
-    FIXME("iface %p, marker_type %d, marker_value %p, context_value %p stub!\n",
+    struct stream_sink *stream_sink = impl_from_IMFStreamSink(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
+    struct async_command *command;
+    HRESULT hr;
+
+    TRACE("iface %p, marker_type %d, marker_value %p, context_value %p.\n",
             iface, marker_type, marker_value, context_value);
 
-    return E_NOTIMPL;
+    EnterCriticalSection(&media_sink->cs);
+
+    if (stream_sink->removed || media_sink->state == STATE_SHUTDOWN)
+    {
+        LeaveCriticalSection(&media_sink->cs);
+        return MF_E_STREAMSINK_REMOVED;
+    }
+
+    /* The marker goes through the same queue as the samples, so that the
+     * MEStreamSinkMarker event is raised once everything placed before it has
+     * been handled. */
+    if (FAILED(hr = async_command_create(ASYNC_MARKER, &command)))
+    {
+        LeaveCriticalSection(&media_sink->cs);
+        return hr;
+    }
+    command->u.marker.stream_id = stream_sink->id;
+    command->u.marker.generation = stream_sink->generation;
+    PropVariantInit(&command->u.marker.context);
+    if (context_value)
+        hr = PropVariantCopy(&command->u.marker.context, context_value);
+    if (SUCCEEDED(hr))
+        hr = MFPutWorkItem(MFASYNC_CALLBACK_QUEUE_STANDARD, &media_sink->async_callback, &command->IUnknown_iface);
+    IUnknown_Release(&command->IUnknown_iface);
+
+    LeaveCriticalSection(&media_sink->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI stream_sink_Flush(IMFStreamSink *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct stream_sink *stream_sink = impl_from_IMFStreamSink(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&media_sink->cs);
+
+    if (stream_sink->removed || media_sink->state == STATE_SHUTDOWN)
+        hr = MF_E_STREAMSINK_REMOVED;
+    else
+    {
+        /* Samples still waiting in the work queue are dropped when they come
+         * up (their generation is stale); markers among them are still
+         * signalled, so that nobody waits on one forever. */
+        ++stream_sink->generation;
+    }
+
+    LeaveCriticalSection(&media_sink->cs);
+
+    return hr;
 }
 
 static const IMFStreamSinkVtbl stream_sink_vtbl =
