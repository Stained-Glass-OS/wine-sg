+
+/* Application restart and recovery. What a process registers is kept in a
+ * block of its own that PEB->WerRegistrationData points to, laid out the
+ * same for 32- and 64-bit processes, so that GetApplicationRestartSettings
+ * and GetApplicationRecoveryCallback can read another process's. When the
+ * process crashes, its recovery callback is run (it pings with
+ * ApplicationRecoveryInProgress, ends with ApplicationRecoveryFinished) and
+ * it is started again with its command line when it had run a minute, as
+ * the error reporting does. */
+#define ARR_MAGIC 0x52414753  /* SGAR */
+
+struct arr_data
+{
+    ULONG   magic;
+    ULONG   restart_registered;
+    ULONG   restart_flags;
+    ULONG   recovery_registered;
+    ULONG64 recovery_callback;
+    ULONG64 recovery_param;
+    ULONG   recovery_ping;
+    ULONG   recovery_flags;
+    WCHAR   cmdline[RESTART_MAX_CMD_LINE];
+};
+
+static HANDLE recovery_ping_event, recovery_done_event;
+static LONG recovery_in_progress;
+
+static struct arr_data *get_arr_data( BOOL create )
+{
+    struct arr_data *data = NtCurrentTeb()->Peb->WerRegistrationData;
+    SIZE_T size = sizeof(*data);
+    void *ptr = NULL;
+
+    if (data || !create) return data;
+    if (NtAllocateVirtualMemory( GetCurrentProcess(), &ptr, 0, &size, MEM_COMMIT, PAGE_READWRITE )) return NULL;
+    data = ptr;
+    data->magic = ARR_MAGIC;
+    if (InterlockedCompareExchangePointer( &NtCurrentTeb()->Peb->WerRegistrationData, data, NULL ))
+    {
+        size = 0;
+        NtFreeVirtualMemory( GetCurrentProcess(), &ptr, &size, MEM_RELEASE );
+    }
+    return NtCurrentTeb()->Peb->WerRegistrationData;
+}
+
+/* a copy of a process's registrations: this one's, or another's read from
+ * its PEB */
+static HRESULT read_arr_data( HANDLE process, struct arr_data *ret )
+{
+    PROCESS_BASIC_INFORMATION pbi;
+    ULONG_PTR peb32 = 0;
+    ULONG64 addr = 0;
+    SIZE_T got;
+
+    if (!GetProcessId( process )) return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+    if (GetProcessId( process ) == GetCurrentProcessId())
+    {
+        struct arr_data *data = get_arr_data( FALSE );
+        if (!data) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+        *ret = *data;
+        return S_OK;
+    }
+    if (NtQueryInformationProcess( process, ProcessWow64Information, &peb32, sizeof(peb32), NULL ))
+        return HRESULT_FROM_WIN32( ERROR_ACCESS_DENIED );
+#ifdef _WIN64
+    if (peb32)
+    {
+        ULONG ptr32 = 0;
+        if (!ReadProcessMemory( process, (char *)peb32 + FIELD_OFFSET( PEB32, WerRegistrationData ),
+                                &ptr32, sizeof(ptr32), &got ))
+            return HRESULT_FROM_WIN32( GetLastError() );
+        addr = ptr32;
+    }
+    else
+#else
+    {
+        BOOL self_wow64 = FALSE;
+        IsWow64Process( GetCurrentProcess(), &self_wow64 );
+        /* a 64-bit process from a 32-bit one: its PEB is out of reach */
+        if (self_wow64 && !peb32) return HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED );
+    }
+#endif
+    {
+        void *ptr = NULL;
+        if (!peb32 || sizeof(void *) == 4)
+        {
+            if (NtQueryInformationProcess( process, ProcessBasicInformation, &pbi, sizeof(pbi), NULL ))
+                return HRESULT_FROM_WIN32( ERROR_ACCESS_DENIED );
+            if (!ReadProcessMemory( process, (char *)pbi.PebBaseAddress + FIELD_OFFSET( PEB, WerRegistrationData ),
+                                    &ptr, sizeof(ptr), &got ))
+                return HRESULT_FROM_WIN32( GetLastError() );
+            addr = (ULONG_PTR)ptr;
+        }
+    }
+    if (!addr) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    if (!ReadProcessMemory( process, (void *)(ULONG_PTR)addr, ret, sizeof(*ret), &got ) || ret->magic != ARR_MAGIC)
+        return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    return S_OK;
+}
+
+/***********************************************************************
+ *         RegisterApplicationRestart   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ RegisterApplicationRestart( const WCHAR *cmdline, DWORD flags )
+{
+    struct arr_data *data;
+
+    TRACE( "(%s, %#lx)\n", debugstr_w(cmdline), flags );
+
+    if (flags & ~(RESTART_NO_CRASH | RESTART_NO_HANG | RESTART_NO_PATCH | RESTART_NO_REBOOT)) return E_INVALIDARG;
+    if (cmdline && wcslen( cmdline ) >= RESTART_MAX_CMD_LINE) return E_INVALIDARG;
+#ifndef SG_MUTANT_NO_APP_RESTART
+    if (!(data = get_arr_data( TRUE ))) return E_OUTOFMEMORY;
+    RtlEnterCriticalSection( &wer_cs );
+    data->restart_flags = flags;
+    lstrcpynW( data->cmdline, cmdline ? cmdline : L"", RESTART_MAX_CMD_LINE );
+    data->restart_registered = 1;
+    RtlLeaveCriticalSection( &wer_cs );
+#endif
+    return S_OK;
+}
+
+/***********************************************************************
+ *         UnregisterApplicationRestart   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ UnregisterApplicationRestart(void)
+{
+    struct arr_data *data = get_arr_data( FALSE );
+
+    TRACE( "\n" );
+
+    if (data) data->restart_registered = 0;
+    return S_OK;
+}
+
+/***********************************************************************
+ *         GetApplicationRestartSettings   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ GetApplicationRestartSettings( HANDLE process, WCHAR *cmdline,
+                                                                      DWORD *size, DWORD *flags )
+{
+    struct arr_data data;
+    DWORD len;
+    HRESULT hr;
+
+    TRACE( "(%p, %p, %p, %p)\n", process, cmdline, size, flags );
+
+    if (!size) return E_INVALIDARG;
+    if (FAILED(hr = read_arr_data( process, &data ))) return hr;
+    if (!data.restart_registered) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    data.cmdline[RESTART_MAX_CMD_LINE - 1] = 0;
+    len = wcslen( data.cmdline ) + 1;
+    if (!cmdline || *size < len)
+    {
+        *size = len;
+        return cmdline ? HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER ) : S_OK;
+    }
+    memcpy( cmdline, data.cmdline, len * sizeof(WCHAR) );
+    *size = len;
+    if (flags) *flags = data.restart_flags;
+    return S_OK;
+}
+
+/***********************************************************************
+ *         RegisterApplicationRecoveryCallback   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ RegisterApplicationRecoveryCallback( APPLICATION_RECOVERY_CALLBACK callback,
+                                                                            void *param, DWORD ping, DWORD flags )
+{
+    struct arr_data *data;
+
+    TRACE( "(%p, %p, %lu, %#lx)\n", callback, param, ping, flags );
+
+    if (!callback || ping > RECOVERY_MAX_PING_INTERVAL || flags) return E_INVALIDARG;
+    if (!(data = get_arr_data( TRUE ))) return E_OUTOFMEMORY;
+    RtlEnterCriticalSection( &wer_cs );
+    data->recovery_callback = (ULONG_PTR)callback;
+    data->recovery_param = (ULONG_PTR)param;
+    data->recovery_ping = ping ? ping : RECOVERY_DEFAULT_PING_INTERVAL;
+    data->recovery_flags = flags;
+    data->recovery_registered = 1;
+    RtlLeaveCriticalSection( &wer_cs );
+    return S_OK;
+}
+
+/***********************************************************************
+ *         UnregisterApplicationRecoveryCallback   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ UnregisterApplicationRecoveryCallback(void)
+{
+    struct arr_data *data = get_arr_data( FALSE );
+
+    TRACE( "\n" );
+
+    if (data) data->recovery_registered = 0;
+    return S_OK;
+}
+
+/***********************************************************************
+ *         GetApplicationRecoveryCallback   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ GetApplicationRecoveryCallback( HANDLE process,
+                                                                       APPLICATION_RECOVERY_CALLBACK *callback,
+                                                                       void **param, DWORD *ping, DWORD *flags )
+{
+    struct arr_data data;
+    HRESULT hr;
+
+    TRACE( "(%p, %p, %p, %p, %p)\n", process, callback, param, ping, flags );
+
+    if (!callback) return E_INVALIDARG;
+    if (FAILED(hr = read_arr_data( process, &data ))) return hr;
+    if (!data.recovery_registered) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    *callback = (APPLICATION_RECOVERY_CALLBACK)(ULONG_PTR)data.recovery_callback;
+    if (param) *param = (void *)(ULONG_PTR)data.recovery_param;
+    if (ping) *ping = data.recovery_ping;
+    if (flags) *flags = data.recovery_flags;
+    return S_OK;
+}
+
+/***********************************************************************
+ *         ApplicationRecoveryInProgress   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ ApplicationRecoveryInProgress( BOOL *canceled )
+{
+    TRACE( "(%p)\n", canceled );
+
+    if (!canceled) return E_INVALIDARG;
+    /* only a recovery callback, while it recovers, pings */
+    if (!recovery_in_progress) return E_FAIL;
+    *canceled = FALSE;  /* there is no one here to cancel it */
+    if (recovery_ping_event) SetEvent( recovery_ping_event );
+    return S_OK;
+}
+
+/***********************************************************************
+ *         ApplicationRecoveryFinished   (kernelbase.@)
+ */
+void WINAPI /* DECLSPEC_HOTPATCH */ ApplicationRecoveryFinished( BOOL success )
+{
+    TRACE( "(%d)\n", success );
+
+    if (recovery_in_progress && recovery_done_event) SetEvent( recovery_done_event );
+}
+
+static DWORD WINAPI recovery_thread( void *arg )
+{
+    struct arr_data *data = arg;
+
+    ((APPLICATION_RECOVERY_CALLBACK)(ULONG_PTR)data->recovery_callback)( (void *)(ULONG_PTR)data->recovery_param );
+    return 0;
+}
+
+static void crash_recovery_and_restart(void)
+{
+    struct arr_data *data = get_arr_data( FALSE );
+    FILETIME created, exited, kernel, user, now;
+    WCHAR *cmdline, image[MAX_PATH];
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    ULONGLONG ran;
+    DWORD len;
+
+    if (!data || InterlockedExchange( &recovery_in_progress, 1 )) return;
+
+#ifndef SG_MUTANT_NO_CRASH_RECOVERY
+    if (data->recovery_registered)
+#else
+    if (0)
+#endif
+    {
+        HANDLE thread, waits[3];
+
+        recovery_ping_event = CreateEventW( NULL, FALSE, FALSE, NULL );
+        recovery_done_event = CreateEventW( NULL, TRUE, FALSE, NULL );
+        if ((thread = CreateThread( NULL, 0, recovery_thread, data, 0, NULL )))
+        {
+            waits[0] = recovery_done_event;
+            waits[1] = thread;
+            waits[2] = recovery_ping_event;
+            /* each ping gives it another interval; silence ends it */
+            while (WaitForMultipleObjects( 3, waits, FALSE, data->recovery_ping ) == WAIT_OBJECT_0 + 2) ;
+            CloseHandle( thread );
+        }
+    }
+
+    if (!data->restart_registered || (data->restart_flags & RESTART_NO_CRASH)) return;
+    /* a program that crashes within a minute is not started again */
+    GetProcessTimes( GetCurrentProcess(), &created, &exited, &kernel, &user );
+    GetSystemTimeAsFileTime( &now );
+    ran = ((ULONGLONG)now.dwHighDateTime << 32 | now.dwLowDateTime) -
+          ((ULONGLONG)created.dwHighDateTime << 32 | created.dwLowDateTime);
+#ifndef SG_MUTANT_RESTART_AT_ONCE
+    if (ran < 60 * (ULONGLONG)10000000) return;
+#endif
+    if (!(len = GetModuleFileNameW( NULL, image, ARRAY_SIZE(image) )) || len >= ARRAY_SIZE(image)) return;
+    if (!(cmdline = HeapAlloc( GetProcessHeap(), 0, (len + RESTART_MAX_CMD_LINE + 4) * sizeof(WCHAR) ))) return;
+    swprintf( cmdline, len + RESTART_MAX_CMD_LINE + 4, L"\"%s\" %s", image, data->cmdline );
+    TRACE( "restarting %s\n", debugstr_w(cmdline) );
+    if (CreateProcessW( image, cmdline, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ))
+    {
+        CloseHandle( pi.hThread );
+        CloseHandle( pi.hProcess );
+    }
+    HeapFree( GetProcessHeap(), 0, cmdline );
+}
