From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.web: HttpResponseMessage names the request it answers

Found at integration (Office sweep on qa3 with 5928): Excel, PowerPoint and
Outlook crashed in react-native-win32.dll (the Copilot button) with a NULL
read: React Native for Windows reads
HttpResponseMessage.RequestMessage().RequestUri() of the responses its HTTP
module gets, and get_RequestMessage always answered NULL (on origin/main too; 10.0-427 did
not crash there, presumably because the integration's windows.web header and
content work (3211, 3290) lets those requests succeed now).

The response keeps the request it answers (HttpBaseProtocolFilter's
SendRequestAsync, which HttpClient's SendRequestAsync, GetAsync, PostAsync,
PutAsync and DeleteAsync go through), as Windows does; put_RequestMessage
replaces it.

Gate webreqmsg (test-webreqmsg): against a local server, SendRequestAsync's
response names the very request with its RequestUri, GetAsync's names one
with the URL, put/NULL work; mutant SG_MUTANT_RESPONSE_NO_REQUEST fails it.
windows.web conformance 64/32 0 failures; fastwebhdr, fastwebb1, jsonweb and
webverbs pass.
---
diff --git a/dlls/windows.web/http_filter.c b/dlls/windows.web/http_filter.c
--- a/dlls/windows.web/http_filter.c
+++ b/dlls/windows.web/http_filter.c
@@ -668,7 +668,7 @@ static HRESULT WINAPI http_filter_send_SendRequestAsync( IHttpFilter *iface, IIn
     resp_data = NULL;
     http_content_set_raw_headers( resp_content, raw_headers );
     http_response_headers_create( raw_headers ? raw_headers : L"", &resp_headers );
-    if (FAILED( hr = http_response_create( status, resp_content, resp_headers, &response ) )) goto done;
+    if (FAILED( hr = http_response_create( status, resp_content, resp_headers, request, &response ) )) goto done;
 
     hr = http_async_complete_iface( &IID_IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress,
                                     (IInspectable *)response, operation );
diff --git a/dlls/windows.web/http_response.c b/dlls/windows.web/http_response.c
--- a/dlls/windows.web/http_response.c
+++ b/dlls/windows.web/http_response.c
@@ -25,6 +25,7 @@ struct http_response
     HttpStatusCode status;
     IHttpContent *content;
     IHttpResponseHeaderCollection *headers;
+    IHttpRequestMessage *request;   /* the request this answers (Windows sets it; React Native reads its Uri) */
 };
 
 static inline struct http_response *impl_from_IHttpResponseMessage( IHttpResponseMessage *iface )
@@ -60,6 +61,7 @@ static ULONG WINAPI response_Release( IHttpResponseMessage *iface )
     {
         if (impl->content) IHttpContent_Release( impl->content );
         if (impl->headers) IHttpResponseHeaderCollection_Release( impl->headers );
+        if (impl->request) IHttpRequestMessage_Release( impl->request );
         free( impl );
     }
     return ref;
@@ -102,8 +104,28 @@ static HRESULT WINAPI response_get_IsSuccessStatusCode( IHttpResponseMessage *if
 }
 static HRESULT WINAPI response_get_ReasonPhrase( IHttpResponseMessage *iface, HSTRING *value ) { *value = NULL; return S_OK; }
 static HRESULT WINAPI response_put_ReasonPhrase( IHttpResponseMessage *iface, HSTRING value ) { return S_OK; }
-static HRESULT WINAPI response_get_RequestMessage( IHttpResponseMessage *iface, IHttpRequestMessage **value ) { *value = NULL; return S_OK; }
-static HRESULT WINAPI response_put_RequestMessage( IHttpResponseMessage *iface, IHttpRequestMessage *value ) { return S_OK; }
+static HRESULT WINAPI response_get_RequestMessage( IHttpResponseMessage *iface, IHttpRequestMessage **value )
+{
+    struct http_response *impl = impl_from_IHttpResponseMessage( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+#ifdef SG_MUTANT_RESPONSE_NO_REQUEST
+    *value = NULL;
+    return S_OK;
+#endif
+    if ((*value = impl->request)) IHttpRequestMessage_AddRef( *value );
+    return S_OK;
+}
+static HRESULT WINAPI response_put_RequestMessage( IHttpResponseMessage *iface, IHttpRequestMessage *value )
+{
+    struct http_response *impl = impl_from_IHttpResponseMessage( iface );
+    IHttpRequestMessage *old;
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (value) IHttpRequestMessage_AddRef( value );
+    old = InterlockedExchangePointer( (void **)&impl->request, value );
+    if (old) IHttpRequestMessage_Release( old );
+    return S_OK;
+}
 static HRESULT WINAPI response_get_Source( IHttpResponseMessage *iface, HttpResponseMessageSource *value ) { *value = HttpResponseMessageSource_Network; return S_OK; }
 static HRESULT WINAPI response_put_Source( IHttpResponseMessage *iface, HttpResponseMessageSource value ) { return S_OK; }
 static HRESULT WINAPI response_get_StatusCode( IHttpResponseMessage *iface, HttpStatusCode *value )
@@ -146,7 +168,7 @@ static const struct IHttpResponseMessageVtbl response_vtbl =
 };
 
 HRESULT http_response_create( HttpStatusCode status, IHttpContent *content,
-        IHttpResponseHeaderCollection *headers, IHttpResponseMessage **out )
+        IHttpResponseHeaderCollection *headers, IHttpRequestMessage *request, IHttpResponseMessage **out )
 {
     struct http_response *impl;
     if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
@@ -155,6 +177,7 @@ HRESULT http_response_create( HttpStatusCode status, IHttpContent *content,
     impl->status = status;
     if ((impl->content = content)) IHttpContent_AddRef( content );
     if ((impl->headers = headers)) IHttpResponseHeaderCollection_AddRef( headers );
+    if ((impl->request = request)) IHttpRequestMessage_AddRef( request );
     *out = &impl->IHttpResponseMessage_iface;
     return S_OK;
 }
diff --git a/dlls/windows.web/private.h b/dlls/windows.web/private.h
--- a/dlls/windows.web/private.h
+++ b/dlls/windows.web/private.h
@@ -106,7 +106,8 @@ extern HRESULT http_async_complete_error( const GUID *iid, HRESULT error, IInspe
 extern HRESULT http_async_get_iface_result( IInspectable *op, IInspectable **result );
 extern HRESULT http_async_get_string_result( IInspectable *op, HSTRING *result );
 
-extern HRESULT http_response_create( HttpStatusCode status, IHttpContent *content, IHttpResponseHeaderCollection *headers, IHttpResponseMessage **out );
+extern HRESULT http_response_create( HttpStatusCode status, IHttpContent *content, IHttpResponseHeaderCollection *headers,
+                                     IHttpRequestMessage *request, IHttpResponseMessage **out );
 
 extern unsigned int http_request_headers_count( IHttpRequestHeaderCollection *iface );
 extern BOOL http_request_headers_at( IHttpRequestHeaderCollection *iface, unsigned int i, const WCHAR **name, const WCHAR **value );
