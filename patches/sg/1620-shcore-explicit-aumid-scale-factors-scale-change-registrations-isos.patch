+/* the process's explicit AppUserModelID: kept and read back (taskbar
+ * grouping, jump lists and toasts key on it); Get returned E_NOTIMPL */
+static WCHAR *explicit_aumid;
+static CRITICAL_SECTION aumid_cs;
+static CRITICAL_SECTION_DEBUG aumid_cs_debug =
+{
+    0, 0, &aumid_cs,
+    { &aumid_cs_debug.ProcessLocksList, &aumid_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": aumid_cs") }
+};
+static CRITICAL_SECTION aumid_cs = { &aumid_cs_debug, -1, 0, 0, 0, 0 };
+
 HRESULT WINAPI SetCurrentProcessExplicitAppUserModelID(const WCHAR *appid)
 {
+#ifndef SG_MUTANT_NO_AUMID
+    WCHAR *copy;
+
+    TRACE("%s\n", debugstr_w(appid));
+
+    /* at most 128 characters */
+    if (!appid || !*appid || wcslen( appid ) > 128) return E_INVALIDARG;
+    if (!(copy = wcsdup( appid ))) return E_OUTOFMEMORY;
+    EnterCriticalSection( &aumid_cs );
+    free( explicit_aumid );
+    explicit_aumid = copy;
+    LeaveCriticalSection( &aumid_cs );
+    return S_OK;
+#else
     FIXME("%s: stub\n", debugstr_w(appid));
     return S_OK;
+#endif
 }
 
 HRESULT WINAPI GetCurrentProcessExplicitAppUserModelID(const WCHAR **appid)
 {
+#ifndef SG_MUTANT_NO_AUMID
+    HRESULT hr = S_OK;
+    WCHAR *copy = NULL;
+
+    TRACE("%p\n", appid);
+
+    if (!appid) return E_INVALIDARG;
+    EnterCriticalSection( &aumid_cs );
+    if (!explicit_aumid) hr = E_FAIL;
+    else if ((copy = CoTaskMemAlloc( (wcslen( explicit_aumid ) + 1) * sizeof(WCHAR) )))
+        wcscpy( copy, explicit_aumid );
+    else hr = E_OUTOFMEMORY;
+    LeaveCriticalSection( &aumid_cs );
+    *appid = copy;
+    return hr;
+#else
     FIXME("%p: stub\n", appid);
     *appid = NULL;
     return E_NOTIMPL;
+#endif
 }
 
