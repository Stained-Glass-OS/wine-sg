+/* the scale factor nearest a DPI: the monitor's is its effective DPI over
+ * 96, as the shell names it (120 dpi is 125%, 144 is 150%); it was always
+ * 100% */
+static DEVICE_SCALE_FACTOR scale_from_dpi( UINT dpi )
+{
+    static const DEVICE_SCALE_FACTOR scales[] =
+    {
+        SCALE_100_PERCENT, SCALE_120_PERCENT, SCALE_125_PERCENT, SCALE_140_PERCENT, SCALE_150_PERCENT,
+        SCALE_160_PERCENT, SCALE_175_PERCENT, SCALE_180_PERCENT, SCALE_200_PERCENT, SCALE_225_PERCENT,
+        SCALE_250_PERCENT, SCALE_300_PERCENT, SCALE_350_PERCENT, SCALE_400_PERCENT, SCALE_450_PERCENT,
+        SCALE_500_PERCENT,
+    };
+    UINT percent = MulDiv( dpi, 100, USER_DEFAULT_SCREEN_DPI ), i, best = 0;
+
+    for (i = 1; i < ARRAY_SIZE(scales); i++)
+        if (abs( (int)scales[i] - (int)percent ) < abs( (int)scales[best] - (int)percent )) best = i;
+    return scales[best];
+}
+
 HRESULT WINAPI GetScaleFactorForMonitor(HMONITOR monitor, DEVICE_SCALE_FACTOR *scale)
 {
+#ifndef SG_MUTANT_NO_SCALE_FACTOR
+    UINT x, y;
+
+    TRACE("(%p %p)\n", monitor, scale);
+
+    if (!scale) return E_INVALIDARG;
+    if (!GetDpiForMonitorInternal( monitor, MDT_EFFECTIVE_DPI, &x, &y ))
+    {
+        *scale = DEVICE_SCALE_FACTOR_INVALID;
+        return E_INVALIDARG;
+    }
+    *scale = scale_from_dpi( x );
+    return S_OK;
+#else
     FIXME("(%p %p): stub\n", monitor, scale);
 
     *scale = SCALE_100_PERCENT;
     return S_OK;
+#endif
 }
 
 DEVICE_SCALE_FACTOR WINAPI GetScaleFactorForDevice(DISPLAY_DEVICE_TYPE device_type)
 {
-    FIXME("%d\n", device_type);
+    static const POINT origin;
+    DEVICE_SCALE_FACTOR scale;
+
+    /* the primary display's; there is no immersive one apart from it */
+    TRACE("%d\n", device_type);
 
-    return SCALE_100_PERCENT;
+    if (FAILED(GetScaleFactorForMonitor( MonitorFromPoint( origin, MONITOR_DEFAULTTOPRIMARY ), &scale )))
+        return SCALE_100_PERCENT;
+    return scale;
 }
 
