 /*************************************************************************
  * RegisterScaleChangeEvent        [SHCORE.@]
  */
+/* Scale change notifications: a hidden window hears the display and
+ * settings broadcasts, and when the primary display's scale factor has
+ * changed it sets each registered event and posts each registered
+ * window its message. Both registrations failed with E_NOTIMPL. */
+struct scale_registration
+{
+    struct list entry;
+    DWORD_PTR   cookie;
+    HANDLE      event;
+    HWND        hwnd;
+    UINT        msg;
+};
+
+static struct list scale_registrations = LIST_INIT( scale_registrations );
+static DWORD_PTR next_scale_cookie = 1;
+static DEVICE_SCALE_FACTOR last_scale;
+static HWND scale_window;
+static CRITICAL_SECTION scale_cs;
+static CRITICAL_SECTION_DEBUG scale_cs_debug =
+{
+    0, 0, &scale_cs,
+    { &scale_cs_debug.ProcessLocksList, &scale_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": scale_cs") }
+};
+static CRITICAL_SECTION scale_cs = { &scale_cs_debug, -1, 0, 0, 0, 0 };
+
+static LRESULT CALLBACK scale_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == WM_DISPLAYCHANGE || msg == WM_SETTINGCHANGE || msg == WM_DPICHANGED)
+    {
+        DEVICE_SCALE_FACTOR scale = GetScaleFactorForDevice( DEVICE_PRIMARY );
+        struct scale_registration *reg;
+
+        EnterCriticalSection( &scale_cs );
+        if (scale != last_scale)
+        {
+            last_scale = scale;
+            LIST_FOR_EACH_ENTRY( reg, &scale_registrations, struct scale_registration, entry )
+            {
+                if (reg->event) SetEvent( reg->event );
+                if (reg->hwnd) PostMessageW( reg->hwnd, reg->msg, 0, 0 );
+            }
+        }
+        LeaveCriticalSection( &scale_cs );
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static DWORD CALLBACK scale_thread( void *arg )
+{
+    WNDCLASSW cls = { 0 };
+    HANDLE ready = arg;
+    MSG msg;
+
+    cls.lpfnWndProc = scale_window_proc;
+    cls.lpszClassName = L"__wine_shcore_scale";
+    RegisterClassW( &cls );
+    scale_window = CreateWindowExW( WS_EX_TOOLWINDOW, cls.lpszClassName, NULL, WS_POPUP, 0, 0, 0, 0, NULL, NULL, NULL, NULL );
+    SetEvent( ready );
+    while (GetMessageW( &msg, NULL, 0, 0 )) DispatchMessageW( &msg );
+    return 0;
+}
+
+static HRESULT add_scale_registration( HANDLE event, HWND hwnd, UINT msg, DWORD_PTR *cookie )
+{
+    struct scale_registration *reg;
+    HANDLE thread, ready;
+
+    if (!(reg = calloc( 1, sizeof(*reg) ))) return E_OUTOFMEMORY;
+    reg->event = event;
+    reg->hwnd = hwnd;
+    reg->msg = msg;
+    EnterCriticalSection( &scale_cs );
+    if (!scale_window)
+    {
+        last_scale = GetScaleFactorForDevice( DEVICE_PRIMARY );
+        ready = CreateEventW( NULL, TRUE, FALSE, NULL );
+        if ((thread = CreateThread( NULL, 0, scale_thread, ready, 0, NULL )))
+        {
+            WaitForSingleObject( ready, 5000 );
+            CloseHandle( thread );
+        }
+        CloseHandle( ready );
+    }
+    reg->cookie = next_scale_cookie++;
+    list_add_tail( &scale_registrations, &reg->entry );
+    *cookie = reg->cookie;
+    LeaveCriticalSection( &scale_cs );
+    return S_OK;
+}
+
+static HRESULT remove_scale_registration( DWORD_PTR cookie )
+{
+    struct scale_registration *reg;
+    HRESULT hr = E_INVALIDARG;
+
+    EnterCriticalSection( &scale_cs );
+    LIST_FOR_EACH_ENTRY( reg, &scale_registrations, struct scale_registration, entry )
+    {
+        if (reg->cookie != cookie) continue;
+        list_remove( &reg->entry );
+        free( reg );
+        hr = S_OK;
+        break;
+    }
+    LeaveCriticalSection( &scale_cs );
+    return hr;
+}
+
 HRESULT WINAPI RegisterScaleChangeEvent(HANDLE handle, DWORD_PTR *cookie)
 {
+#ifndef SG_MUTANT_NO_SCALE_FACTOR
+    TRACE("(%p, %p)\n", handle, cookie);
+    if (!handle || !cookie) return E_INVALIDARG;
+    return add_scale_registration( handle, NULL, 0, cookie );
+#else
     FIXME("(%p, %p) stub\n", handle, cookie);
     return E_NOTIMPL;
+#endif
+}
+
+/*************************************************************************
+ * UnregisterScaleChangeEvent        [SHCORE.@]
+ */
+HRESULT WINAPI UnregisterScaleChangeEvent(DWORD_PTR cookie)
+{
+    TRACE("(%#Ix)\n", cookie);
+    return remove_scale_registration( cookie );
 }
 
 /*************************************************************************
@@ -2536,11 +2756,24 @@ HRESULT WINAPI RegisterScaleChangeEvent(HANDLE handle, DWORD_PTR *cookie)
  */
 HRESULT WINAPI RegisterScaleChangeNotifications(DISPLAY_DEVICE_TYPE display_device, HWND hwnd, UINT msg, DWORD *cookie)
 {
-    FIXME("(%d, %p, %u, %p) stub\n", display_device, hwnd, msg, cookie);
+    DWORD_PTR value;
+    HRESULT hr;
+
+    TRACE("(%d, %p, %u, %p)\n", display_device, hwnd, msg, cookie);
 
     if (cookie) *cookie = 0;
+    if (!cookie || !IsWindow( hwnd )) return E_INVALIDARG;
+    if (SUCCEEDED(hr = add_scale_registration( NULL, hwnd, msg, &value ))) *cookie = value;
+    return hr;
+}
 
-    return E_NOTIMPL;
+/*************************************************************************
+ * RevokeScaleChangeNotifications        [SHCORE.@]
+ */
+HRESULT WINAPI RevokeScaleChangeNotifications(DISPLAY_DEVICE_TYPE display_device, DWORD cookie)
+{
+    TRACE("(%d, %lu)\n", display_device, cookie);
+    return remove_scale_registration( cookie );
 }
 
