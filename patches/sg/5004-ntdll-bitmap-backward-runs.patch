From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Implement RtlFindLastBackwardRunClear and RtlFindLastBackwardRunSet.

RtlFindLastBackwardRunClear and RtlFindLastBackwardRunSet search a bitmap
backwards from the given index for the nearest run of clear (set) bits and
return its length, with its lowest index in the out parameter; 0 when there
is none or the index is outside the bitmap. They returned 0 always.

Gate: test/ntdll-bitmap-backward-gate.sh (64/32).
---
 dlls/ntdll/rtlbitmap.c | 31 +++++++++++++++++++++++++++----
 1 file changed, 27 insertions(+), 4 deletions(-)

diff --git a/dlls/ntdll/rtlbitmap.c b/dlls/ntdll/rtlbitmap.c
index 4bf028f..8f26515 100644
--- a/dlls/ntdll/rtlbitmap.c
+++ b/dlls/ntdll/rtlbitmap.c
@@ -719,6 +719,27 @@ ULONG WINAPI RtlFindNextForwardRunClear(PCRTL_BITMAP lpBits, ULONG ulStart, PULO
   return ulSize;
 }
 
+/* the run of bits equal to "set" nearest below or at "from": its length and
+ * (in *pos) its lowest index; 0 when there is none */
+static ULONG find_backward_run( PCRTL_BITMAP bitmap, ULONG from, ULONG *pos, BOOLEAN set )
+{
+  const BYTE *bits;
+  LONG i, end;
+
+  if (!bitmap || !pos || from >= bitmap->SizeOfBitMap) return 0;
+  bits = (const BYTE *)bitmap->Buffer;
+#define BIT_IS(n) ((!!(bits[(n) >> 3] & (1 << ((n) & 7)))) == !!set)
+  for (i = from; i >= 0 && !BIT_IS(i); i--) ;
+  if (i < 0) return 0;
+  end = i;
+#ifndef SG_MUTANT_BACKWARD_RUN_ONE
+  while (i > 0 && BIT_IS(i - 1)) i--;
+#endif
+#undef BIT_IS
+  *pos = i;
+  return end - i + 1;
+}
+
 /*************************************************************************
  * RtlFindLastBackwardRunSet	[NTDLL.@]
  *
@@ -736,8 +757,9 @@ ULONG WINAPI RtlFindNextForwardRunClear(PCRTL_BITMAP lpBits, ULONG ulStart, PULO
  */
 ULONG WINAPI RtlFindLastBackwardRunSet(PCRTL_BITMAP lpBits, ULONG ulStart, PULONG lpPos)
 {
-  FIXME("(%p,%lu,%p)-stub!\n", lpBits, ulStart, lpPos);
-  return 0;
+  TRACE("(%p,%lu,%p)\n", lpBits, ulStart, lpPos);
+
+  return find_backward_run( lpBits, ulStart, lpPos, TRUE );
 }
 
 /*************************************************************************
@@ -757,8 +779,9 @@ ULONG WINAPI RtlFindLastBackwardRunSet(PCRTL_BITMAP lpBits, ULONG ulStart, PULON
  */
 ULONG WINAPI RtlFindLastBackwardRunClear(PCRTL_BITMAP lpBits, ULONG ulStart, PULONG lpPos)
 {
-  FIXME("(%p,%lu,%p)-stub!\n", lpBits, ulStart, lpPos);
-  return 0;
+  TRACE("(%p,%lu,%p)\n", lpBits, ulStart, lpPos);
+
+  return find_backward_run( lpBits, ulStart, lpPos, FALSE );
 }
 
 /*************************************************************************
