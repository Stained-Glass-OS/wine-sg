From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dcomp: a window becomes glass by a frame change sent after Commit

0605 makes a window whose composition swap chain has alpha a sheet of glass,
with SetWindowPos(SWP_FRAMECHANGED) -- from inside Commit, on the program's
own thread, so its window procedure ran in the middle of its frame. Qt 6
answered the frame change by resizing its swap chain and left it
unpresented: Audacity 4's window stayed empty and its first-run dialog
never appeared. The frame change now comes from a thread of its own, as a
message the program handles after Commit returns. Chrome's menus stay glass.
---
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -481,6 +481,17 @@
     return refcount;
 }
 
+/* The frame change that makes a window glass is sent from a thread of its
+ * own: SetWindowPos from Commit itself re-entered the program's window
+ * procedure in the middle of its frame (Qt 6: the resize it answered with
+ * left its swap chain unpresented and its windows blank -- Audacity 4). */
+static DWORD WINAPI glass_frame_changed(void *arg)
+{
+    SetWindowPos(arg, 0, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE |
+                 SWP_NOOWNERZORDER | SWP_FRAMECHANGED);
+    return 0;
+}
+
 static void commit_visual(HWND window, struct composition_visual *visual, float x, float y)
 {
     IWineDXGICompositionSwapChain *swapchain;
@@ -504,9 +515,14 @@
                 (desc.AlphaMode == DXGI_ALPHA_MODE_PREMULTIPLIED || desc.AlphaMode == DXGI_ALPHA_MODE_STRAIGHT) &&
                 !GetPropW(window, L"__wine_dwm_glass"))
             {
+                HANDLE thread;
+
                 SetPropW(window, L"__wine_dwm_glass", (HANDLE)1);
-                SetWindowPos(window, 0, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE |
-                             SWP_NOOWNERZORDER | SWP_FRAMECHANGED);
+#ifndef SG_MUTANT_REENTER
+                if ((thread = CreateThread(NULL, 0, glass_frame_changed, window, 0, NULL))) CloseHandle(thread);
+                else
+#endif
+                    glass_frame_changed(window);
             }
             IDXGISwapChain1_Release(chain);
         }
