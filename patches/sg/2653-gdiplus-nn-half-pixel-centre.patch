From: Stained Glass OS <ke7oxh@gmail.com>
gdiplus: DrawImage nearest neighbour with the half pixel offset samples destination pixel centres

With PixelOffsetModeHalf/HighQuality a destination pixel belongs to the image
when its centre lies inside the transformed image, and is sampled at its
centre.  Removes the todo_wine marks of test_DrawImage_scale cases 16-27.
---
--- a/dlls/gdiplus/graphics.c
+++ b/dlls/gdiplus/graphics.c
@@ -41,6 +41,17 @@
 #include "wine/debug.h"
 #include "wine/list.h"
 
+#ifdef SG_MUTANT_GPNN_HALF_CORNER
+#define GPNN_HALF_CORNER 1
+#else
+#define GPNN_HALF_CORNER 0
+#endif
+#ifdef SG_MUTANT_GPNN_HALF_ROUND
+#define GPNN_HALF_ROUND 1
+#else
+#define GPNN_HALF_ROUND 0
+#endif
+
 WINE_DEFAULT_DEBUG_CHANNEL(gdiplus);
 
 /* looks-right constants */
@@ -1276,6 +1287,13 @@ static ARGB resample_bitmap_pixel_footprint(GDIPCONST GpRect *src_rect, LPBYTE b
             pixel_offset = 0.0;
             break;
         }
+        if ((offset_mode == PixelOffsetModeHalf || offset_mode == PixelOffsetModeHighQuality) && !GPNN_HALF_CORNER)
+        {
+            /* the destination pixel is sampled at its centre */
+            return sample_bitmap_pixel(src_rect, bits, width, height,
+                floorf(point->X + 0.5f * (footprint[0].X + footprint[1].X)),
+                floorf(point->Y + 0.5f * (footprint[0].Y + footprint[1].Y)), attributes);
+        }
         return sample_bitmap_pixel(src_rect, bits, width, height,
             floorf(point->X + pixel_offset), floorf(point->Y + pixel_offset), attributes);
     }
@@ -3448,6 +3466,23 @@ GpStatus WINGDIPAPI GdipDrawImagePointsRect(GpGraphics *graphics, GpImage *image
                 if (dst_area.bottom < pti[i].y) dst_area.bottom = pti[i].y;
             }
 
+            if (do_resampling && interpolation == InterpolationModeNearestNeighbor &&
+                (offset_mode == PixelOffsetModeHalf || offset_mode == PixelOffsetModeHighQuality))
+            {
+                /* a pixel belongs to the image when its centre is inside it */
+                REAL minx = ptf[0].X, miny = ptf[0].Y;
+                for (i = 1; i < 4; i++)
+                {
+                    if (ptf[i].X < minx) minx = ptf[i].X;
+                    if (ptf[i].Y < miny) miny = ptf[i].Y;
+                }
+                if (!GPNN_HALF_ROUND)
+                {
+                    dst_area.left = ceilf(minx - 0.5f);
+                    dst_area.top = ceilf(miny - 0.5f);
+                }
+            }
+
             stat = get_graphics_device_bounds(graphics, &graphics_bounds);
             if (stat != Ok) return stat;
 
@@ -3559,8 +3594,15 @@ GpStatus WINGDIPAPI GdipDrawImagePointsRect(GpGraphics *graphics, GpImage *image
                     for (x = dst_area.left, src_pointf = src_pointf_row; x < dst_area.right;
                          x++, src_pointf.X += x_dx, src_pointf.Y += x_dy)
                     {
-                        if (src_pointf.X >= srcx && src_pointf.X < srcx + srcwidth &&
-                            src_pointf.Y >= srcy && src_pointf.Y < srcy + srcheight)
+                        REAL cx = src_pointf.X, cy = src_pointf.Y;
+                        if (interpolation == InterpolationModeNearestNeighbor &&
+                            (offset_mode == PixelOffsetModeHalf || offset_mode == PixelOffsetModeHighQuality))
+                        {
+                            cx += 0.5f * (x_dx + y_dx);
+                            cy += 0.5f * (x_dy + y_dy);
+                        }
+                        if (cx >= srcx && cx < srcx + srcwidth &&
+                            cy >= srcy && cy < srcy + srcheight)
                             *dst_color = resample_bitmap_pixel_footprint(&src_area, src_data, bitmap->width,
                                                                          bitmap->height, &src_pointf, footprint,
                                                                          imageAttributes, interpolation, offset_mode);
