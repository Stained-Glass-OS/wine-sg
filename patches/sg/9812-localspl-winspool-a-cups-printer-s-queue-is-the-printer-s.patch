+/* Stained Glass OS (9812): the jobs of a CUPS queue (a CUPS: port's
+ * printer), which is where a Windows program's document waits once it is
+ * spooled: listed as the printer's jobs, and paused, resumed, restarted or
+ * cancelled from them */
+struct cups_job
+{
+    unsigned int id;
+    unsigned int state;         /* IPP job-state: 3 pending, 4 held, 5 processing, 6 stopped */
+    unsigned int reasons;       /* CUPS_JOB_* below */
+    unsigned int size;          /* bytes */
+    unsigned int pages;         /* job-impressions, 0 unknown */
+    unsigned int pages_done;    /* job-impressions-completed */
+    unsigned int priority;      /* 1..100 */
+    unsigned int pad;
+    INT64 created;              /* time-at-creation, seconds since 1970 */
+    WCHAR title[256];
+    WCHAR user[128];
+};
+#define CUPS_JOB_ERROR    1     /* a job-state-reason ending in -error */
+#define CUPS_JOB_PRINTER_STOPPED 2
+
+struct get_cups_jobs_params
+{
+    const WCHAR *queue;
+    struct cups_job *jobs;
+    unsigned int count;         /* room in jobs */
+    unsigned int *total;        /* the queue's not-completed jobs */
+};
+
+struct control_cups_job_params
+{
+    const WCHAR *queue;
+    unsigned int id;            /* 0: the queue itself */
+    unsigned int command;       /* JOB_CONTROL_*, or PRINTER_CONTROL_* | 0x100 for the queue */
+};
+
 #define UNIX_CALL(func, params) WINE_UNIX_CALL(unix_ ## func, params)
 
