+/* Stained Glass OS (9812): pausing, resuming and purging a CUPS printer is
+ * its CUPS queue's (an administrator's, as CUPS decides); other printers and
+ * commands stay winspool's own (ERROR_NOT_SUPPORTED) */
+static BOOL WINAPI fpSetPrinter(HANDLE hprinter, DWORD level, BYTE *data, DWORD command)
+{
+    printer_t *printer = (printer_t *)hprinter;
+    struct control_cups_job_params params;
+    NTSTATUS status;
+
+    TRACE("%p %ld %p %ld\n", hprinter, level, data, command);
+
+    if (!printer || printer->header.type != HANDLE_PRINTER)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!cups_queue(printer->info) ||
+        (command != PRINTER_CONTROL_PAUSE && command != PRINTER_CONTROL_RESUME && command != PRINTER_CONTROL_PURGE))
+    {
+        SetLastError(ERROR_NOT_SUPPORTED);
+        return FALSE;
+    }
+    params.queue = cups_queue(printer->info);
+    params.id = 0;
+    params.command = 0x100 | command;
+    status = UNIX_CALL(control_cups_job, &params);
+    if (status == STATUS_NOT_SUPPORTED)
+    {
+        SetLastError(ERROR_NOT_SUPPORTED);
+        return FALSE;
+    }
+    if (status) SetLastError(RtlNtStatusToDosError(status));
+    return !status;
+}
