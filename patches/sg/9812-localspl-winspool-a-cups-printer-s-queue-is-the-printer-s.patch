+    DO_FUNC(ippGetCount); \
+    DO_FUNC(ippGetGroupTag); \
+    DO_FUNC(ippGetInteger); \
+    DO_FUNC(ippGetName); \
+    DO_FUNC(ippGetString); \
+    DO_FUNC(ippNewRequest); \
+    DO_FUNC(ippNextAttribute)
 
 #define DO_FUNC(f) static typeof(f) *p##f
 CUPS_FUNCS;
 #undef DO_FUNC
 static cups_dest_t * (*pcupsGetNamedDest)(http_t *, const char *, const char *);
 static const char *  (*pcupsLastErrorString)(void);
+#define DO_FUNC(f) static typeof(f) *p##f
+CUPS_JOB_FUNCS;
