+/* SetJob's command on a CUPS job: TRUE when CUPS did it */
+static BOOL control_cups_job(const printer_info_t *info, const struct cups_job *job, DWORD command)
+{
+    struct control_cups_job_params params;
+    NTSTATUS status;
+
+    params.queue = cups_queue(info);
+    params.id = job->id;
+    params.command = command;
+    switch (command)
+    {
+    case 0:
+    case JOB_CONTROL_SENT_TO_PRINTER: case JOB_CONTROL_LAST_PAGE_EJECTED:
+    case JOB_CONTROL_RETAIN: case JOB_CONTROL_RELEASE:
+        return TRUE;    /* CUPS keeps and releases its jobs itself */
+    }
+    status = UNIX_CALL(control_cups_job, &params);
+    /* Restart of a document that has not started printing: it prints from its start
+     * anyway (a held one once released) */
+    if (status == STATUS_INVALID_DEVICE_STATE && command == JOB_CONTROL_RESTART && job->state != 5)
+    {
+        params.command = JOB_CONTROL_RESUME;
+        status = job->state == 4 ? UNIX_CALL(control_cups_job, &params) : STATUS_SUCCESS;
+    }
+    if (status == STATUS_NOT_FOUND) status = STATUS_INVALID_PARAMETER;  /* it has just finished */
+    if (status) SetLastError(RtlNtStatusToDosError(status));
+    return !status;
+}
