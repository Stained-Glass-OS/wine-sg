+static BOOL cups_jobs_ok;
 
 #endif /* SONAME_LIBCUPS */
 
@@ -447,7 +470,13 @@
 
         len = wcslen(document_title);
         doc->cups.doc_title = malloc(len * 3 + 1);
+#ifdef SG_MUTANT_CUPS_TITLE_SHORT
         ntdll_wcstoumbs(document_title, len + 1, doc->cups.doc_title, len + 3 + 1, FALSE);
+#else
+        /* Stained Glass OS (9812): room for every character's UTF-8 (a title of
+         * accented or CJK characters was cut, or the job had no name) */
+        ntdll_wcstoumbs(document_title, len + 1, doc->cups.doc_title, len * 3 + 1, FALSE);
+#endif
 
         return TRUE;
     }
@@ -456,6 +485,200 @@
