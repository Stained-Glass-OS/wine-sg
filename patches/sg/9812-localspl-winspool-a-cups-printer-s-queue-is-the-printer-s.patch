+    CUPS_JOB_FUNCS;
+#undef DO_FUNC
     return STATUS_SUCCESS;
 #else /* SONAME_LIBCUPS */
     return STATUS_NOT_SUPPORTED;
@@ -532,6 +759,8 @@
     start_doc,
