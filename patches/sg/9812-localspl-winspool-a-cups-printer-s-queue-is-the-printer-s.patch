 }
 
+#ifdef SONAME_LIBCUPS
+static const char *no_password(const char *prompt, http_t *http, const char *method,
+                               const char *resource, void *data)
+{
+    return NULL;
+}
+
+/* the queue's name in UTF-8, NULL if too long */
+static BOOL queue_name(const WCHAR *queue, char *name, size_t size)
+{
+    return ntdll_wcstoumbs(queue, wcslen(queue) + 1, name, size, FALSE) > 0;
+}
+
+static void utf8_to_wstr(const char *str, WCHAR *out, unsigned int count)
+{
+    DWORD len;
+
+    out[0] = 0;
+    if (!str) return;
+    len = ntdll_umbstowcs(str, strlen(str), out, count - 1);
+    out[min(len, count - 1)] = 0;
+}
+
+static NTSTATUS status_from_ipp(int status)
+{
+    if (status <= 0x00ff) return STATUS_SUCCESS;          /* successful-ok-* */
+    switch (status)
+    {
+    case IPP_STATUS_ERROR_FORBIDDEN:
+    case IPP_STATUS_ERROR_NOT_AUTHENTICATED:
+    case IPP_STATUS_ERROR_NOT_AUTHORIZED:
+    case IPP_STATUS_ERROR_CUPS_AUTHENTICATION_CANCELED:
+        return STATUS_ACCESS_DENIED;
+    case IPP_STATUS_ERROR_NOT_FOUND:
+    case IPP_STATUS_ERROR_GONE:
+        return STATUS_NOT_FOUND;
+    case IPP_STATUS_ERROR_NOT_POSSIBLE:
+        return STATUS_INVALID_DEVICE_STATE;
+    case IPP_STATUS_ERROR_SERVICE_UNAVAILABLE:
+    case IPP_STATUS_ERROR_INTERNAL:
+        return STATUS_DEVICE_NOT_READY;
+    default:
+        return STATUS_UNSUCCESSFUL;
+    }
+}
+#endif
+
+static NTSTATUS get_cups_jobs(void *args)
+{
+#ifdef SONAME_LIBCUPS
+    static const char *const wanted[] =
+    {
+        "job-id", "job-name", "job-originating-user-name", "job-state", "job-state-reasons",
+        "job-k-octets", "job-impressions", "job-impressions-completed", "job-priority",
+        "time-at-creation",
+    };
+    const struct get_cups_jobs_params *params = args;
+    char name[512], uri[1024];
+    ipp_t *request, *response;
+    ipp_attribute_t *attr;
+    unsigned int n = 0;
+    NTSTATUS ret;
+
+    *params->total = 0;
+    if (!cups_jobs_ok) return STATUS_NOT_SUPPORTED;
+    if (!queue_name(params->queue, name, sizeof(name))) return STATUS_INVALID_PARAMETER;
+    if (phttpAssembleURIf(HTTP_URI_CODING_ALL, uri, sizeof(uri), "ipp", NULL, "localhost", 0,
+                          "/printers/%s", name) < HTTP_URI_STATUS_OK)
+        return STATUS_INVALID_PARAMETER;
+
+    /* a Windows program has no terminal to type a CUPS password at: an
+     * operation CUPS wants a password for fails instead (access denied);
+     * the callback is the calling thread's */
+    pcupsSetPasswordCB2(no_password, NULL);
+    request = pippNewRequest(IPP_OP_GET_JOBS);
+    pippAddString(request, IPP_TAG_OPERATION, IPP_TAG_URI, "printer-uri", NULL, uri);
+    pippAddString(request, IPP_TAG_OPERATION, IPP_TAG_NAME, "requesting-user-name", NULL, pcupsUser());
+    pippAddString(request, IPP_TAG_OPERATION, IPP_TAG_KEYWORD, "which-jobs", NULL, "not-completed");
+    pippAddStrings(request, IPP_TAG_OPERATION, IPP_TAG_KEYWORD, "requested-attributes",
+                   ARRAY_SIZE(wanted), NULL, wanted);
+    response = pcupsDoRequest(CUPS_HTTP_DEFAULT, request, "/");
+    ret = status_from_ipp(pcupsLastError());
+    if (!response) return ret ? ret : STATUS_DEVICE_NOT_READY;
+    if (ret)
+    {
+        pippDelete(response);
+        return ret;
+    }
+
+    for (attr = pippFirstAttribute(response); attr; attr = pippNextAttribute(response))
+    {
+        struct cups_job job;
+
+        while (attr && pippGetGroupTag(attr) != IPP_TAG_JOB) attr = pippNextAttribute(response);
+        if (!attr) break;
+        memset(&job, 0, sizeof(job));
+        job.priority = 50;
+        for (; attr && pippGetGroupTag(attr) == IPP_TAG_JOB; attr = pippNextAttribute(response))
+        {
+            const char *aname = pippGetName(attr);
+            int i;
+
+            if (!aname) continue;
+            if (!strcmp(aname, "job-id")) job.id = pippGetInteger(attr, 0);
+            else if (!strcmp(aname, "job-name")) utf8_to_wstr(pippGetString(attr, 0, NULL), job.title, ARRAY_SIZE(job.title));
+            else if (!strcmp(aname, "job-originating-user-name"))
+                utf8_to_wstr(pippGetString(attr, 0, NULL), job.user, ARRAY_SIZE(job.user));
+            else if (!strcmp(aname, "job-state")) job.state = pippGetInteger(attr, 0);
+            else if (!strcmp(aname, "job-k-octets")) job.size = min(pippGetInteger(attr, 0), 0x3fffff) * 1024;
+            else if (!strcmp(aname, "job-impressions")) job.pages = pippGetInteger(attr, 0);
+            else if (!strcmp(aname, "job-impressions-completed")) job.pages_done = pippGetInteger(attr, 0);
+            else if (!strcmp(aname, "job-priority")) job.priority = pippGetInteger(attr, 0);
+            else if (!strcmp(aname, "time-at-creation")) job.created = pippGetInteger(attr, 0);
+            else if (!strcmp(aname, "job-state-reasons"))
+                for (i = 0; i < pippGetCount(attr); i++)
+                {
+                    const char *r = pippGetString(attr, i, NULL);
+                    size_t len = r ? strlen(r) : 0;
+
+                    if (len > 6 && !strcmp(r + len - 6, "-error")) job.reasons |= CUPS_JOB_ERROR;
+                    if (r && !strcmp(r, "printer-stopped")) job.reasons |= CUPS_JOB_PRINTER_STOPPED;
+                }
+        }
+        if (job.id)
+        {
+            if (n < params->count) params->jobs[n] = job;
+            n++;
+        }
+        if (!attr) break;
+    }
+    pippDelete(response);
+    *params->total = n;
+    return STATUS_SUCCESS;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
+/* JOB_CONTROL_* and PRINTER_CONTROL_* (winspool.h) */
+#define CJ_PAUSE   1
+#define CJ_RESUME  2
+#define CJ_CANCEL  3
+#define CJ_RESTART 4
+#define CJ_DELETE  5
+#define CJ_QUEUE   0x100
+
+static NTSTATUS control_cups_job(void *args)
+{
+#ifdef SONAME_LIBCUPS
+    const struct control_cups_job_params *params = args;
+    char name[512], uri[1024];
+    ipp_t *request, *response;
+    ipp_op_t op;
+    NTSTATUS ret;
+
+    if (!cups_jobs_ok) return STATUS_NOT_SUPPORTED;
+    if (!queue_name(params->queue, name, sizeof(name))) return STATUS_INVALID_PARAMETER;
+    switch (params->command)
+    {
+    case CJ_PAUSE:   op = IPP_OP_HOLD_JOB; break;
+    case CJ_RESUME:  op = IPP_OP_RELEASE_JOB; break;
+    case CJ_RESTART: op = IPP_OP_RESTART_JOB; break;
+    case CJ_CANCEL:
+    case CJ_DELETE:  op = IPP_OP_CANCEL_JOB; break;
+    case CJ_QUEUE | CJ_PAUSE:  op = IPP_OP_PAUSE_PRINTER; break;
+    case CJ_QUEUE | CJ_RESUME: op = IPP_OP_RESUME_PRINTER; break;
+    case CJ_QUEUE | 3:         op = IPP_OP_PURGE_JOBS; break;   /* PRINTER_CONTROL_PURGE */
+    default: return STATUS_INVALID_PARAMETER;
+    }
+    if (params->command & CJ_QUEUE)
+        ret = phttpAssembleURIf(HTTP_URI_CODING_ALL, uri, sizeof(uri), "ipp", NULL, "localhost", 0,
+                                "/printers/%s", name) < HTTP_URI_STATUS_OK;
+    else
+        ret = phttpAssembleURIf(HTTP_URI_CODING_ALL, uri, sizeof(uri), "ipp", NULL, "localhost", 0,
+                                "/jobs/%u", params->id) < HTTP_URI_STATUS_OK;
+    if (ret) return STATUS_INVALID_PARAMETER;
+
+    pcupsSetPasswordCB2(no_password, NULL);
+    request = pippNewRequest(op);
+    pippAddString(request, IPP_TAG_OPERATION, IPP_TAG_URI,
+                  (params->command & CJ_QUEUE) ? "printer-uri" : "job-uri", NULL, uri);
+    pippAddString(request, IPP_TAG_OPERATION, IPP_TAG_NAME, "requesting-user-name", NULL, pcupsUser());
+    response = pcupsDoRequest(CUPS_HTTP_DEFAULT, request,
+                              (params->command & CJ_QUEUE) ? "/admin/" : "/jobs/");
+    ret = status_from_ipp(pcupsLastError());
+    if (response) pippDelete(response);
+    TRACE("%s job %u command %#x: %#x (%s)\n", debugstr_a(name), params->id, params->command, (int)ret,
+          pcupsLastErrorString ? debugstr_a(pcupsLastErrorString()) : "");
+    return ret;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
 static NTSTATUS process_attach(void *args)
 {
 #ifdef SONAME_LIBCUPS
@@ -476,6 +699,10 @@
 #define DO_FUNC(x) p##x = dlsym(libcups_handle, #x)
     CUPS_OPT_FUNCS;
 #undef DO_FUNC
