+/* Stained Glass OS (9812): a CUPS printer's documents wait in CUPS once they
+ * are spooled (the program's own job ends when CUPS has the data), so its
+ * queue is CUPS's: listed after the jobs being spooled here, and paused,
+ * resumed, restarted and cancelled with IPP as their owner. Another user's
+ * documents keep CUPS's privacy (their names are not shown) and CUPS decides
+ * who may control them. */
+static const WCHAR *cups_queue(const printer_info_t *info)
+{
+#ifdef SG_MUTANT_CUPSJOBS_NONE
+    return NULL;
+#endif
+    if (info->port && !wcsnicmp(info->port, L"CUPS:", 5) && info->port[5]) return info->port + 5;
+    return NULL;
+}
+
+/* the CUPS queue's jobs (count of them), NULL without any */
+static struct cups_job *cups_jobs(const printer_info_t *info, unsigned int *count)
+{
+    const WCHAR *queue = cups_queue(info);
+    struct get_cups_jobs_params params;
+    struct cups_job *jobs = NULL, *more;
+    unsigned int room = 8, total = 0;
+
+    *count = 0;
+    if (!queue) return NULL;
+    for (;;)
+    {
+        if (!(more = realloc(jobs, room * sizeof(*jobs))))
+        {
+            free(jobs);
+            return NULL;
+        }
+        jobs = more;
+        params.queue = queue;
+        params.jobs = jobs;
+        params.count = room;
+        params.total = &total;
+        if (UNIX_CALL(get_cups_jobs, &params) || !total)
+        {
+            free(jobs);
+            return NULL;
+        }
+        if (total <= room) break;
+        room = total + 8;
+    }
+    *count = total;
+    return jobs;
+}
+
+static const struct cups_job *find_cups_job(const struct cups_job *jobs, unsigned int count, DWORD id)
+{
+    unsigned int i;
+
+    for (i = 0; i < count; i++) if (jobs[i].id == id) return &jobs[i];
+    return NULL;
+}
+
+static DWORD cups_job_status(const struct cups_job *job)
+{
+    DWORD status = 0;
+
+    switch (job->state)
+    {
+    case 4: status = JOB_STATUS_PAUSED; break;              /* held */
+    case 5: status = JOB_STATUS_PRINTING; break;            /* processing */
+    case 6: status = JOB_STATUS_ERROR; break;               /* stopped while printing */
+    }
+    if (job->reasons & CUPS_JOB_ERROR) status |= JOB_STATUS_ERROR;
+    return status;
+}
+
+/* a CUPS job's JOB_INFO, laid out as fill_job_info lays out a job of ours */
+static void fill_cups_job_info(printer_t *printer, const struct cups_job *job, DWORD level, DWORD position,
+        DWORD next_id, BYTE *info_ptr, BYTE *data, DWORD *s, BOOL fill, const WCHAR *machine)
+{
+    WCHAR *p = (WCHAR *)(data + *s), *str;
+    const WCHAR *user = job->user[0] ? job->user : NULL;
+    const WCHAR *title = job->title[0] ? job->title : NULL;
+    SYSTEMTIME submitted;
+    LARGE_INTEGER time;
+    FILETIME ft;
+
+    memset(&submitted, 0, sizeof(submitted));
+    if (job->created > 0)
+    {
+        RtlSecondsSince1970ToTime((DWORD)job->created, &time);
+        ft.dwLowDateTime = time.u.LowPart;
+        ft.dwHighDateTime = time.u.HighPart;
+        FileTimeToSystemTime(&ft, &submitted);
+    }
+    switch (level)
+    {
+    case 1:
+    {
+        JOB_INFO_1W *info = (JOB_INFO_1W *)info_ptr;
+
+        if (fill) memset(info, 0, sizeof(*info));
+        str = job_string(title, &p, s, fill); if (fill) info->pDocument = str;
+        str = job_string(printer->info->name, &p, s, fill); if (fill) info->pPrinterName = str;
+        str = job_string(L"RAW", &p, s, fill); if (fill) info->pDatatype = str;
+        str = job_string(user, &p, s, fill); if (fill) info->pUserName = str;
+        str = job_string(machine[0] ? machine : NULL, &p, s, fill); if (fill) info->pMachineName = str;
+        if (fill)
+        {
+            info->JobId = job->id;
+            info->Status = cups_job_status(job);
+            info->Priority = min(max(job->priority, MIN_PRIORITY), MAX_PRIORITY);
+            info->Position = position;
+            info->TotalPages = job->pages;
+            info->PagesPrinted = job->pages_done;
+            info->Submitted = submitted;
+        }
+        break;
+    }
+    case 2:
+    {
+        JOB_INFO_2W *info = (JOB_INFO_2W *)info_ptr;
+
+        if (fill) memset(info, 0, sizeof(*info));
+        str = job_string(title, &p, s, fill); if (fill) info->pDocument = str;
+        str = job_string(printer->info->name, &p, s, fill); if (fill) info->pPrinterName = str;
+        str = job_string(L"RAW", &p, s, fill); if (fill) info->pDatatype = str;
+        str = job_string(user, &p, s, fill); if (fill) info->pUserName = str;
+        str = job_string(user, &p, s, fill); if (fill) info->pNotifyName = str;
