From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] evr: filter stream count, media event sink, mixer service

The EVR DirectShow filter:

- IEVRFilterConfig::SetNumberOfStreams / GetNumberOfStreams: the count (1 by
  default) is kept, E_INVALIDARG outside 1..16, VFW_E_ALREADY_CONNECTED while
  the input pin is connected, E_POINTER for NULL, and the mixer gets the extra
  input streams (also when it is created later). Extra input pins are not
  created yet.
- IMediaEventSink::Notify: the mixer and presenter's EC_SAMPLE_NEEDED,
  EC_PROCESSING_LATENCY and EC_SAMPLE_LATENCY stay inside the filter, every
  other event is passed on to the filter graph.
- IMFGetService::GetService: MR_VIDEO_MIXER_SERVICE returns the mixer's
  interfaces (processor, bitmap, mixer control...); an unknown service is
  logged as a warning.
- Receive for a sample type the filter cannot copy fails with
  VFW_E_TYPE_NOT_ACCEPTED instead of E_NOTIMPL.
---
diff --git a/dlls/evr/evr.c b/dlls/evr/evr.c
index 108f13c..7e2ed5c 100644
--- a/dlls/evr/evr.c
+++ b/dlls/evr/evr.c
@@ -23,6 +23,7 @@
 #include <stdio.h>
 
 #include "evr_private.h"
+#include "evcode.h"
 #include "d3d9.h"
 #include "mferror.h"
 #include "mfapi.h"
@@ -54,8 +55,11 @@ struct evr
     IMFVideoSampleAllocator *allocator;
     IMFMediaType *media_type;
     unsigned int flags;
+    DWORD stream_count;
 };
 
+#define EVR_MAX_STREAMS 16
+
 static void evr_uninitialize(struct evr *filter)
 {
     if (filter->mixer)
@@ -71,6 +75,31 @@ static void evr_uninitialize(struct evr *filter)
     }
 }
 
+/* Brings the mixer's input stream count in line with IEVRFilterConfig::SetNumberOfStreams. */
+static HRESULT evr_configure_mixer_streams(struct evr *filter)
+{
+    DWORD count = 0, i, id;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_STREAMS_NOMIXER
+    return S_OK;
+#endif
+    if (!filter->mixer || filter->stream_count <= 1)
+        return S_OK;
+
+    if (FAILED(hr = IMFTransform_GetStreamCount(filter->mixer, &count, NULL)))
+        return hr;
+
+    for (i = count; i < filter->stream_count; ++i)
+    {
+        id = i;
+        if (FAILED(hr = IMFTransform_AddInputStreams(filter->mixer, 1, &id)))
+            return hr;
+    }
+
+    return S_OK;
+}
+
 static HRESULT evr_initialize(struct evr *filter, IMFTransform *mixer, IMFVideoPresenter *presenter)
 {
     HRESULT hr = S_OK;
@@ -105,6 +134,8 @@ static HRESULT evr_initialize(struct evr *filter, IMFTransform *mixer, IMFVideoP
 
     /* FIXME: configure mixer and presenter */
 
+    evr_configure_mixer_streams(filter);
+
     return hr;
 }
 
@@ -429,7 +460,7 @@ static HRESULT evr_copy_sample_buffer(struct evr *filter, const GUID *subtype, I
 static HRESULT evr_render(struct strmbase_renderer *iface, IMediaSample *input_sample)
 {
     struct evr *filter = impl_from_strmbase_renderer(iface);
-    HRESULT hr = E_NOTIMPL;
+    HRESULT hr = VFW_E_TYPE_NOT_ACCEPTED;
     GUID subtype = { 0 };
     IMFSample *sample;
 
@@ -456,7 +487,7 @@ static HRESULT evr_render(struct strmbase_renderer *iface, IMediaSample *input_s
     }
     else
     {
-        FIXME("Unhandled input type %s.\n", debugstr_guid(&subtype));
+        WARN("Unhandled input type %s.\n", debugstr_guid(&subtype));
     }
 
     return hr;
@@ -548,19 +579,45 @@ static ULONG WINAPI filter_config_Release(IEVRFilterConfig *iface)
 static HRESULT WINAPI filter_config_SetNumberOfStreams(IEVRFilterConfig *iface, DWORD count)
 {
     struct evr *filter = impl_from_IEVRFilterConfig(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("filter %p, count %lu.\n", filter, count);
+
+#ifndef SG_MUTANT_STREAMS_NOLIMIT
+    if (!count || count > EVR_MAX_STREAMS)
+        return E_INVALIDARG;
+#endif
+
+    EnterCriticalSection(&filter->renderer.filter.filter_cs);
+
+    /* The input pins can only be reconfigured while nothing is connected. */
+    if (filter->renderer.sink.pin.peer)
+        hr = VFW_E_ALREADY_CONNECTED;
+    else
+    {
+        filter->stream_count = count;
+        hr = evr_configure_mixer_streams(filter);
+    }
 
-    FIXME("filter %p, count %lu, stub!\n", filter, count);
+    LeaveCriticalSection(&filter->renderer.filter.filter_cs);
 
-    return E_NOTIMPL;
+    return hr;
 }
 
 static HRESULT WINAPI filter_config_GetNumberOfStreams(IEVRFilterConfig *iface, DWORD *count)
 {
     struct evr *filter = impl_from_IEVRFilterConfig(iface);
 
-    FIXME("filter %p, count %p, stub!\n", filter, count);
+    TRACE("filter %p, count %p.\n", filter, count);
+
+    if (!count)
+        return E_POINTER;
+
+    EnterCriticalSection(&filter->renderer.filter.filter_cs);
+    *count = filter->stream_count;
+    LeaveCriticalSection(&filter->renderer.filter.filter_cs);
 
-    return E_NOTIMPL;
+    return S_OK;
 }
 
 static const IEVRFilterConfigVtbl filter_config_vtbl =
@@ -651,9 +708,18 @@ static HRESULT WINAPI filter_get_service_GetService(IMFGetService *iface, REFGUI
         if (filter->presenter)
             hr = IMFVideoPresenter_QueryInterface(filter->presenter, &IID_IMFGetService, (void **)&gs);
     }
+    else if (IsEqualGUID(service, &MR_VIDEO_MIXER_SERVICE))
+    {
+        /* The mixer's own interfaces: processor, bitmap, mixer control, position mapper... */
+        if (!filter->mixer)
+            hr = evr_initialize(filter, NULL, NULL);
+
+        if (filter->mixer)
+            hr = IMFTransform_QueryInterface(filter->mixer, riid, obj);
+    }
     else
     {
-        FIXME("Unsupported service %s.\n", debugstr_guid(service));
+        WARN("Unsupported service %s.\n", debugstr_guid(service));
     }
 
     LeaveCriticalSection(&filter->renderer.filter.filter_cs);
@@ -748,9 +814,46 @@ static ULONG WINAPI filter_media_event_sink_Release(IMediaEventSink *iface)
 
 static HRESULT WINAPI filter_media_event_sink_Notify(IMediaEventSink *iface, LONG event, LONG_PTR param1, LONG_PTR param2)
 {
-    FIXME("iface %p, event %ld, param1 %Id, param2 %Id.\n", iface, event, param1, param2);
+    struct evr *filter = impl_from_IMediaEventSink(iface);
+    IMediaEventSink *graph_sink;
+    IFilterGraph *graph;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, event %ld, param1 %Id, param2 %Id.\n", iface, event, param1, param2);
+
+    switch (event)
+    {
+        case EC_SAMPLE_NEEDED:
+        case EC_PROCESSING_LATENCY:
+        case EC_SAMPLE_LATENCY:
+            /* Mixer and presenter bookkeeping, handled by the filter itself: the sample flow is driven
+               by the upstream pin. */
+#ifndef SG_MUTANT_NOTIFY_FORWARDALL
+            break;
+#endif
+
+        default:
+            /* Everything else is a graph event. No filter lock here: events come from mixer and presenter
+               calls made with their locks held, while the filter calls into them under its own lock. */
+#ifdef SG_MUTANT_NOTIFY_DROPALL
+            graph = NULL;
+#else
+            graph = filter->renderer.filter.graph;
+#endif
+            if (graph)
+            {
+                IFilterGraph_AddRef(graph);
+                if (SUCCEEDED(IFilterGraph_QueryInterface(graph, &IID_IMediaEventSink, (void **)&graph_sink)))
+                {
+                    hr = IMediaEventSink_Notify(graph_sink, event, param1, param2);
+                    IMediaEventSink_Release(graph_sink);
+                }
+                IFilterGraph_Release(graph);
+            }
+            break;
+    }
 
-    return E_NOTIMPL;
+    return hr;
 }
 
 static const IMediaEventSinkVtbl filter_media_event_sink_vtbl =
@@ -843,6 +946,7 @@ HRESULT evr_filter_create(IUnknown *outer, void **out)
     object->IMFVideoRenderer_iface.lpVtbl = &filter_video_renderer_vtbl;
     object->IMediaEventSink_iface.lpVtbl = &filter_media_event_sink_vtbl;
     object->IMFTopologyServiceLookup_iface.lpVtbl = &filter_service_lookup_vtbl;
+    object->stream_count = 1;
 
     TRACE("Created EVR %p.\n", object);
     *out = &object->renderer.filter.IUnknown_inner;
