From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dism: the .NET Framework 3.5 feature is reported and can be turned on

dism.exe was a stub that printed nothing and exited 0. Installers and
scripts for .NET 3.5 programs run "dism /online /get-featureinfo
/featurename:NetFx3" and look for "State : Enabled", or "dism /online
/enable-feature /featurename:NetFx3 /all" and look at the exit code; with
no output they took 3.5 for missing (David 2026-10-05: Meedio/MeediOS).

For the running system (/Online) dism now answers /Get-Features (list or
/Format:Table), /Get-FeatureInfo and /Enable-Feature for the optional
features it knows (programs/dism/features.c: NetFx3, NetFx4-AdvSrvs),
which are enabled when their .NET Framework is registered as installed
(NDP\v3.5, NDP\v4\Full Install=1 -- Wine Mono's). /Enable-Feature succeeds
when the feature is on and fails with DISM's "source files not found"
(0x800f081f) when no .NET Framework is installed; an unknown feature is
0x800f080c; /Disable-Feature is not supported; /Image (offline images) is
not supported. Other commands are the stub as before.

Test: test/netfx3-gate.sh (mutant SG_MUTANT_DISM_NETFX3).
---
--- a/programs/dism/dism.c
+++ b/programs/dism/dism.c
@@ -16,14 +16,209 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
+#include <stdarg.h>
+#include <stdio.h>
+#include <windows.h>
+#include <winternl.h>
+#include "features.h"
+
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(dism);
 
+/*
+ * Stained Glass OS: dism.exe answers for the optional features (features.c)
+ * on the running system (/Online): /Get-Features, /Get-FeatureInfo and
+ * /Enable-Feature for the .NET Framework 3.5 (NetFx3), which installers of
+ * .NET 3.5 programs ask about ("dism /online /get-featureinfo
+ * /featurename:NetFx3", then look for "State : Enabled"; or
+ * "dism /online /enable-feature /featurename:NetFx3 /all"). It was a stub
+ * that printed nothing, so they took 3.5 for missing. Everything else is
+ * still the stub.
+ */
+
+static BOOL quiet;
+
+static void output( const WCHAR *fmt, ... )
+{
+    WCHAR buf[1024];
+    DWORD written;
+    int len, size;
+    va_list args;
+    char *str;
+
+    va_start( args, fmt );
+    len = vswprintf( buf, ARRAY_SIZE(buf), fmt, args );
+    va_end( args );
+    if (len <= 0) return;
+    if (WriteConsoleW( GetStdHandle( STD_OUTPUT_HANDLE ), buf, len, &written, NULL )) return;
+    /* redirected: in the OEM code page, as console programs write */
+    size = WideCharToMultiByte( GetOEMCP(), 0, buf, len, NULL, 0, NULL, NULL );
+    if (!(str = malloc( size ))) return;
+    WideCharToMultiByte( GetOEMCP(), 0, buf, len, str, size, NULL, NULL );
+    WriteFile( GetStdHandle( STD_OUTPUT_HANDLE ), str, size, &written, NULL );
+    free( str );
+}
+
+static void header(void)
+{
+    RTL_OSVERSIONINFOEXW info = { sizeof(info) };
+
+    if (quiet) return;
+    RtlGetVersion( &info );
+    output( L"\r\nDeployment Image Servicing and Management tool\r\nVersion: 10.0.%lu.1\r\n\r\n",
+            info.dwBuildNumber );
+    output( L"Image Version: %lu.%lu.%lu.0\r\n\r\n", info.dwMajorVersion, info.dwMinorVersion,
+            info.dwBuildNumber );
+}
+
+static int error( DWORD code, const WCHAR *message )
+{
+    if (code < 0x10000) output( L"\r\nError: %lu\r\n\r\n%s\r\n", code, message );
+    else output( L"\r\nError: 0x%08lx\r\n\r\n%s\r\n", code, message );
+    return code;
+}
+
+static void success(void)
+{
+    if (!quiet) output( L"The operation completed successfully.\r\n" );
+}
+
+static const WCHAR *state_name( const struct optional_feature *feature )
+{
+    return optional_feature_enabled( feature ) ? L"Enabled" : L"Disabled";
+}
+
+static int get_features( BOOL table )
+{
+    unsigned int i;
+
+    header();
+    if (!quiet && table)
+    {
+        output( L"------------------------------------------- | --------\r\n" );
+        output( L"%-43s | %s\r\n", L"Feature Name", L"State" );
+        output( L"------------------------------------------- | --------\r\n" );
+    }
+    for (i = 0; !quiet && i < optional_feature_count; i++)
+    {
+        if (table) output( L"%-43s | %s\r\n", optional_features[i].name, state_name( &optional_features[i] ) );
+        else output( L"Feature Name : %s\r\nState : %s\r\n\r\n", optional_features[i].name,
+                     state_name( &optional_features[i] ) );
+    }
+    if (!quiet && table) output( L"\r\n" );
+    success();
+    return 0;
+}
+
+static int get_feature_info( const WCHAR *name )
+{
+    const struct optional_feature *feature;
+
+    header();
+    if (!name) return error( ERROR_INVALID_PARAMETER, L"The /FeatureName option is required." );
+    if (!(feature = find_optional_feature( name )))
+        return error( DISM_E_UNKNOWN_FEATURE, L"Feature name is unknown." );
+    if (!quiet)
+    {
+        output( L"Feature Information:\r\n\r\n" );
+        output( L"Feature Name : %s\r\n", feature->name );
+        output( L"Display Name : %s\r\n", feature->display_name );
+        output( L"Description : %s\r\n", feature->display_name );
+        output( L"Restart Required : Possible\r\n" );
+        output( L"State : %s\r\n\r\n", state_name( feature ) );
+    }
+    success();
+    return 0;
+}
+
+static int enable_feature( const WCHAR *name )
+{
+    const struct optional_feature *feature;
+
+    header();
+    if (!name) return error( ERROR_INVALID_PARAMETER, L"The /FeatureName option is required." );
+    if (!(feature = find_optional_feature( name )))
+        return error( DISM_E_UNKNOWN_FEATURE, L"Feature name is unknown." );
+    if (!optional_feature_enabled( feature ))
+        return error( DISM_E_SOURCE_MISSING, L"The source files could not be found: the .NET Framework "
+                      L"(Wine Mono) is not installed." );
+    if (!quiet)
+    {
+        output( L"Enabling feature(s)\r\n" );
+        output( L"[==========================100.0%%==========================]\r\n" );
+    }
+    success();
+    return 0;
+}
+
+static int disable_feature( const WCHAR *name )
+{
+    header();
+    if (!name) return error( ERROR_INVALID_PARAMETER, L"The /FeatureName option is required." );
+    if (!find_optional_feature( name ))
+        return error( DISM_E_UNKNOWN_FEATURE, L"Feature name is unknown." );
+    return error( ERROR_NOT_SUPPORTED, L"This feature cannot be turned off." );
+}
+
+/* "/Name" or "-Name", "/Name:value"; returns the value or "" if it matches */
+static const WCHAR *option( const WCHAR *arg, const WCHAR *name )
+{
+    size_t len = wcslen( name );
+
+    if (arg[0] != '/' && arg[0] != '-') return NULL;
+    if (wcsnicmp( arg + 1, name, len )) return NULL;
+    if (!arg[len + 1]) return L"";
+    if (arg[len + 1] == ':') return arg + len + 2;
+    return NULL;
+}
+
+enum command { CMD_NONE, CMD_GET_FEATURES, CMD_GET_FEATURE_INFO, CMD_ENABLE_FEATURE, CMD_DISABLE_FEATURE };
+
 int __cdecl wmain(int argc, WCHAR *argv[])
 {
+    enum command command = CMD_NONE;
+    const WCHAR *feature = NULL, *value;
+    BOOL online = FALSE, image = FALSE, table = FALSE;
     int i;
 
+    for (i = 1; i < argc; i++)
+    {
+        if (option( argv[i], L"Online" )) online = TRUE;
+        else if (option( argv[i], L"Image" )) image = TRUE;
+        else if (option( argv[i], L"Quiet" )) quiet = TRUE;
+        else if (option( argv[i], L"Get-Features" )) command = CMD_GET_FEATURES;
+        else if (option( argv[i], L"Get-FeatureInfo" )) command = CMD_GET_FEATURE_INFO;
+        else if (option( argv[i], L"Enable-Feature" )) command = CMD_ENABLE_FEATURE;
+        else if (option( argv[i], L"Disable-Feature" )) command = CMD_DISABLE_FEATURE;
+        else if ((value = option( argv[i], L"FeatureName" )) && *value) { if (!feature) feature = value; }
+        else if ((value = option( argv[i], L"Format" ))) table = !wcsicmp( value, L"Table" );
+    }
+
+#ifndef SG_MUTANT_DISM_NETFX3
+    if (command != CMD_NONE)
+    {
+        if (image)
+        {
+            header();
+            return error( ERROR_NOT_SUPPORTED, L"Offline images are not supported; use /Online." );
+        }
+        if (!online)
+        {
+            header();
+            return error( ERROR_INVALID_PARAMETER, L"Specify /Online for the running system." );
+        }
+        switch (command)
+        {
+        case CMD_GET_FEATURES:     return get_features( table );
+        case CMD_GET_FEATURE_INFO: return get_feature_info( feature );
+        case CMD_ENABLE_FEATURE:   return enable_feature( feature );
+        case CMD_DISABLE_FEATURE:  return disable_feature( feature );
+        default: break;
+        }
+    }
+#endif
+
     WINE_FIXME("stub:");
     for (i = 0; i < argc; i++)
         WINE_FIXME(" %s", wine_dbgstr_w(argv[i]));
--- /dev/null
+++ b/programs/dism/features.c
@@ -0,0 +1,58 @@
+/*
+ * Optional features (Stained Glass OS): the "Turn Windows features on or
+ * off" features dism.exe and fondue.exe answer for.
+ *
+ * The .NET Framework 3.5 (NetFx3) is an optional feature on Windows 8 and
+ * later: installers of .NET 3.5 programs ask DISM or the Features on Demand
+ * tool (fondue.exe) whether it is on, or to turn it on, and Microsoft's own
+ * 3.5 setup refuses to install and points at "Turn Windows features on or
+ * off". Here the .NET Framework is Wine Mono's, which registers 2.0, 3.0,
+ * 3.5 and 4.x as installed: a feature is on when its .NET Framework is
+ * registered as installed (NDP\v3.5, NDP\v4\Full Install=1), off otherwise.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <windef.h>
+#include <winbase.h>
+#include <winreg.h>
+#include "features.h"
+
+const struct optional_feature optional_features[] =
+{
+    { L"NetFx3", L".NET Framework 3.5 (includes .NET 2.0 and 3.0)",
+      L"Software\\Microsoft\\NET Framework Setup\\NDP\\v3.5" },
+    { L"NetFx4-AdvSrvs", L".NET Framework 4.8 Advanced Services",
+      L"Software\\Microsoft\\NET Framework Setup\\NDP\\v4\\Full" },
+};
+const unsigned int optional_feature_count = ARRAY_SIZE(optional_features);
+
+const struct optional_feature *find_optional_feature( const WCHAR *name )
+{
+    unsigned int i;
+
+    for (i = 0; i < optional_feature_count; i++)
+        if (!wcsicmp( optional_features[i].name, name )) return &optional_features[i];
+    return NULL;
+}
+
+BOOL optional_feature_enabled( const struct optional_feature *feature )
+{
+    DWORD installed = 0, size = sizeof(installed);
+
+    return !RegGetValueW( HKEY_LOCAL_MACHINE, feature->ndp_key, L"Install", RRF_RT_REG_DWORD,
+                          NULL, &installed, &size ) && installed == 1;
+}
--- /dev/null
+++ b/programs/dism/features.h
@@ -0,0 +1,35 @@
+/*
+ * Optional features (Stained Glass OS): the "Turn Windows features on or
+ * off" features dism.exe and fondue.exe answer for.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+struct optional_feature
+{
+    const WCHAR *name;
+    const WCHAR *display_name;
+    const WCHAR *ndp_key;   /* HKLM key whose Install=1 says the feature is there */
+};
+
+/* DISM's own error codes for these cases */
+#define DISM_E_UNKNOWN_FEATURE  0x800f080c
+#define DISM_E_SOURCE_MISSING   0x800f081f
+
+extern const struct optional_feature optional_features[];
+extern const unsigned int optional_feature_count;
+
+const struct optional_feature *find_optional_feature( const WCHAR *name );
+BOOL optional_feature_enabled( const struct optional_feature *feature );
--- a/programs/dism/Makefile.in
+++ b/programs/dism/Makefile.in
@@ -1,7 +1,9 @@
 MODULE    = dism.exe
+IMPORTS   = advapi32
 
 EXTRADLLFLAGS = -mconsole -municode
 
 SOURCES = \
 	dism.c \
+	features.c \
 	version.rc
