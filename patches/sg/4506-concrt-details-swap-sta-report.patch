From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] concrt140, msvcp: concurrent queue swap, non-blocking thread check, unhandled task error report.

Three FIXME stubs of the Concurrency Runtime details, in concrt140 and in
the msvcp copy of the same file: _Concurrent_queue_base_v4::_Internal_swap
exchanges the contents of two queues; _Task_impl_base::_IsNonBlockingThread
tells whether the thread is in an application STA (a Windows Runtime UI
thread, where waiting on a task is not allowed), looking at the apartment
only when combase is already loaded so no import is added;
_ExceptionHolder::ReportUnhandledError ends the program through
terminate(), as an unobserved task exception does.
---
 dlls/concrt140/details.c | 43 +++++++++++++++++++++++++++++++++++++++----
 dlls/msvcp90/details.c   | 43 +++++++++++++++++++++++++++++++++++++++----
 2 files changed, 78 insertions(+), 8 deletions(-)

diff --git a/dlls/concrt140/details.c b/dlls/concrt140/details.c
index a8e7478..67ea5df 100644
--- a/dlls/concrt140/details.c
+++ b/dlls/concrt140/details.c
@@ -21,6 +21,7 @@
 #include <stdarg.h>
 
 #include "wine/debug.h"
+#include "objbase.h"
 #include "wine/exception.h"
 #include "details.h"
 
@@ -344,7 +345,22 @@ DEFINE_THISCALL_WRAPPER(_Concurrent_queue_base_v4__Internal_swap, 8)
 void __thiscall _Concurrent_queue_base_v4__Internal_swap(
         _Concurrent_queue_base_v4 *this, _Concurrent_queue_base_v4 *r)
 {
-    FIXME("(%p %p) stub\n", this, r);
+    queue_data *data;
+    size_t count;
+
+    TRACE("(%p %p)\n", this, r);
+
+    /* the queues trade their contents (both hold items of the same type) */
+    if (this == r) return;
+#ifdef SG_MUTANT_QUEUE_SWAP_NOP
+    return;
+#endif
+    data = this->data;
+    this->data = r->data;
+    r->data = data;
+    count = this->alloc_count;
+    this->alloc_count = r->alloc_count;
+    r->alloc_count = count;
 }
 
 DEFINE_THISCALL_WRAPPER(_Concurrent_queue_base_v4_dummy, 4)
@@ -1073,17 +1089,36 @@ void __cdecl _Release_chore(_Threadpool_chore *chore)
 /* ?_IsNonBlockingThread@_Task_impl_base@details@Concurrency@@SA_NXZ */
 bool __cdecl _Task_impl_base__IsNonBlockingThread(void)
 {
-    FIXME("() stub\n");
-    return FALSE;
+    HRESULT (WINAPI *get_apartment_type)(APTTYPE*, APTTYPEQUALIFIER*);
+    APTTYPEQUALIFIER qualifier;
+    HMODULE combase;
+    APTTYPE type;
+
+    TRACE("()\n");
+
+    /* Waiting on a task is not allowed in an application STA (a Windows
+     * Runtime UI thread). A thread with no COM loaded is in none. */
+    if (!(combase = GetModuleHandleW(L"combase.dll")) ||
+        !(get_apartment_type = (void *)GetProcAddress(combase, "CoGetApartmentType")) ||
+        FAILED(get_apartment_type(&type, &qualifier)))
+        return FALSE;
+#ifdef SG_MUTANT_NONBLOCKING_ANY_STA
+    return type == APTTYPE_STA || type == APTTYPE_MAINSTA;
+#endif
+    return type == APTTYPE_STA && qualifier == 6 /* APTTYPEQUALIFIER_APPLICATION_STA */;
 }
 
 /* ?ReportUnhandledError@_ExceptionHolder@details@Concurrency@@AAAXXZ */
 /* ?ReportUnhandledError@_ExceptionHolder@details@Concurrency@@AAEXXZ */
+void __cdecl terminate(void);
+
 /* ?ReportUnhandledError@_ExceptionHolder@details@Concurrency@@AEAAXXZ */
 DEFINE_THISCALL_WRAPPER(_ExceptionHolder__ReportUnhandledError, 4)
 void __thiscall _ExceptionHolder__ReportUnhandledError(void *this)
 {
-    FIXME("(%p) stub\n", this);
+    /* the exception of a task that nobody observed ends the program */
+    ERR("(%p) unobserved exception of a task, terminating\n", this);
+    terminate();
 }
 
 __ASM_BLOCK_BEGIN(concurrency_details_vtables)
diff --git a/dlls/msvcp90/details.c b/dlls/msvcp90/details.c
index 984a277..0183439 100644
--- a/dlls/msvcp90/details.c
+++ b/dlls/msvcp90/details.c
@@ -22,6 +22,7 @@
 #include "msvcp90.h"
 
 #include "wine/debug.h"
+#include "objbase.h"
 #include "wine/exception.h"
 
 #if _MSVCP_VER >= 100
@@ -358,7 +359,22 @@ DEFINE_THISCALL_WRAPPER(_Concurrent_queue_base_v4__Internal_swap, 8)
 void __thiscall _Concurrent_queue_base_v4__Internal_swap(
         _Concurrent_queue_base_v4 *this, _Concurrent_queue_base_v4 *r)
 {
-    FIXME("(%p %p) stub\n", this, r);
+    queue_data *data;
+    size_t count;
+
+    TRACE("(%p %p)\n", this, r);
+
+    /* the queues trade their contents (both hold items of the same type) */
+    if (this == r) return;
+#ifdef SG_MUTANT_QUEUE_SWAP_NOP
+    return;
+#endif
+    data = this->data;
+    this->data = r->data;
+    r->data = data;
+    count = this->alloc_count;
+    this->alloc_count = r->alloc_count;
+    r->alloc_count = count;
 }
 
 DEFINE_THISCALL_WRAPPER(_Concurrent_queue_base_v4_dummy, 4)
@@ -1088,17 +1104,36 @@ void __cdecl _Release_chore(_Threadpool_chore *chore)
 /* ?_IsNonBlockingThread@_Task_impl_base@details@Concurrency@@SA_NXZ */
 bool __cdecl _Task_impl_base__IsNonBlockingThread(void)
 {
-    FIXME("() stub\n");
-    return FALSE;
+    HRESULT (WINAPI *get_apartment_type)(APTTYPE*, APTTYPEQUALIFIER*);
+    APTTYPEQUALIFIER qualifier;
+    HMODULE combase;
+    APTTYPE type;
+
+    TRACE("()\n");
+
+    /* Waiting on a task is not allowed in an application STA (a Windows
+     * Runtime UI thread). A thread with no COM loaded is in none. */
+    if (!(combase = GetModuleHandleW(L"combase.dll")) ||
+        !(get_apartment_type = (void *)GetProcAddress(combase, "CoGetApartmentType")) ||
+        FAILED(get_apartment_type(&type, &qualifier)))
+        return FALSE;
+#ifdef SG_MUTANT_NONBLOCKING_ANY_STA
+    return type == APTTYPE_STA || type == APTTYPE_MAINSTA;
+#endif
+    return type == APTTYPE_STA && qualifier == 6 /* APTTYPEQUALIFIER_APPLICATION_STA */;
 }
 
 /* ?ReportUnhandledError@_ExceptionHolder@details@Concurrency@@AAAXXZ */
 /* ?ReportUnhandledError@_ExceptionHolder@details@Concurrency@@AAEXXZ */
+void __cdecl terminate(void);
+
 /* ?ReportUnhandledError@_ExceptionHolder@details@Concurrency@@AEAAXXZ */
 DEFINE_THISCALL_WRAPPER(_ExceptionHolder__ReportUnhandledError, 4)
 void __thiscall _ExceptionHolder__ReportUnhandledError(void *this)
 {
-    FIXME("(%p) stub\n", this);
+    /* the exception of a task that nobody observed ends the program */
+    ERR("(%p) unobserved exception of a task, terminating\n", this);
