From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comctl32: EM_FMTLINES soft line breaks in the v6 edit control

EM_FMTLINES switched a flag and logged that soft breaks were not
implemented. As documented, with it set a multiline edit control reports its
text with a soft line break (two carriage returns and a line feed) at the end of
each line that word wrapping broke: WM_GETTEXT returns them and
WM_GETTEXTLENGTH counts them; a hard line break is left as it is, the display
and the control's own buffer are untouched, and EM_FMTLINES FALSE takes them
away again.
---
--- a/dlls/comctl32/edit.c
+++ b/dlls/comctl32/edit.c
@@ -2338,10 +2338,9 @@ static LRESULT EDIT_EM_CharFromPos(EDITSTATE *es, INT x, INT y)
 static BOOL EDIT_EM_FmtLines(EDITSTATE *es, BOOL add_eol)
 {
 	es->flags &= ~EF_USE_SOFTBRK;
-	if (add_eol) {
-		es->flags |= EF_USE_SOFTBRK;
-		FIXME("soft break enabled, not implemented\n");
-	}
+	/* the soft breaks are put into the text WM_GETTEXT returns; the display and
+	 * the buffer are untouched */
+	if (add_eol) es->flags |= EF_USE_SOFTBRK;
 	return add_eol;
 }
 
@@ -3203,13 +3202,55 @@ static void EDIT_WM_ContextMenu(EDITSTATE *es, INT x, INT y)
  *	WM_GETTEXT
  *
  */
+/* the number of lines word wrapping broke, which EM_FMTLINES gives a soft
+ * line break (\r\r\n) when the text is read */
+static UINT EDIT_SoftBreakCount(const EDITSTATE *es)
+{
+    const LINEDEF *line;
+    UINT count = 0;
+
+#ifdef SG_MUTANT_FMT_NOOP
+    return 0;
+#endif
+    if (!(es->style & ES_MULTILINE) || !(es->flags & EF_USE_SOFTBRK)) return 0;
+    for (line = es->first_line_def; line; line = line->next)
+        if (line->ending == END_WRAP) count++;
+    return count;
+}
+
 static INT EDIT_WM_GetText(const EDITSTATE *es, INT count, LPWSTR dst)
 {
+    const LINEDEF *line;
+    INT len = 0;
+
     if (!count)
         return 0;
 
-    lstrcpynW(dst, es->text, count);
-    return lstrlenW(dst);
+    if (!EDIT_SoftBreakCount(es))
+    {
+        lstrcpynW(dst, es->text, count);
+        return lstrlenW(dst);
+    }
+
+    /* "A soft line break consists of two carriage returns and a line feed and is
+     * inserted at the end of a line that is broken because of wordwrapping" */
+    for (line = es->first_line_def; line && len < count - 1; line = line->next)
+    {
+        INT n = min(line->length, count - 1 - len);
+
+        memcpy(dst + len, es->text + line->index, n * sizeof(WCHAR));
+        len += n;
+        if (line->ending == END_WRAP && n == line->length)
+        {
+            static const WCHAR soft[] = {'\r', '\r', '\n'};
+
+            n = min(3, count - 1 - len);
+            memcpy(dst + len, soft, n * sizeof(WCHAR));
+            len += n;
+        }
+    }
+    dst[len] = 0;
+    return len;
 }
 
 /*********************************************************************
@@ -4823,7 +4864,7 @@ static LRESULT CALLBACK EDIT_WindowProc(HWND hwnd, UINT msg, WPARAM wParam, LPAR
         break;
 
     case WM_GETTEXTLENGTH:
-        result = get_text_length(es);
+        result = get_text_length(es) + 3 * EDIT_SoftBreakCount(es);
         break;
 
     case WM_HSCROLL:
--- a/dlls/comctl32/tests/edit.c
+++ b/dlls/comctl32/tests/edit.c
@@ -3838,6 +3838,72 @@ static void test_format_rect(void)
     }
 }
 
+static void test_EM_FMTLINES(void)
+{
+    static const WCHAR text[] = L"aaaa bbbb cccc dddd eeee ffff gggg hhhh iiii jjjj";
+    static const WCHAR hard[] = L"one\r\ntwo";
+    WCHAR buffer[256], *p;
+    int lines, softs, len;
+    HWND edit;
+    LRESULT ret;
+
+    edit = CreateWindowW(L"Edit", text, WS_POPUP | WS_VISIBLE | ES_MULTILINE | ES_AUTOVSCROLL, 0, 0, 70, 200,
+                         NULL, NULL, hinst, NULL);
+    ok(!!edit, "CreateWindow failed.\n");
+
+    lines = SendMessageW(edit, EM_GETLINECOUNT, 0, 0);
+    ok(lines > 2, "Got %d lines, expected the text to wrap.\n", lines);
+
+    /* without the soft breaks the text is the text */
+    len = SendMessageW(edit, WM_GETTEXT, ARRAY_SIZE(buffer), (LPARAM)buffer);
+    ok(len == lstrlenW(text) && !lstrcmpW(buffer, text), "Got %d, %s.\n", len, wine_dbgstr_w(buffer));
+    ok(SendMessageW(edit, WM_GETTEXTLENGTH, 0, 0) == lstrlenW(text), "wrong length\n");
+
+    ret = SendMessageW(edit, EM_FMTLINES, TRUE, 0);
+    ok(ret == TRUE, "Got %Id.\n", ret);
+
+    /* one soft line break at the end of each line that word wrapping broke */
+    ret = SendMessageW(edit, WM_GETTEXTLENGTH, 0, 0);
+    ok(ret == lstrlenW(text) + 3 * (lines - 1), "Got length %Id, expected %d.\n", ret, lstrlenW(text) + 3 * (lines - 1));
+    len = SendMessageW(edit, WM_GETTEXT, ARRAY_SIZE(buffer), (LPARAM)buffer);
+    ok(len == ret, "Got %d, expected %Id.\n", len, ret);
+    softs = 0;
+    for (p = buffer; *p; p++)
+        if (p[0] == '\r' && p[1] == '\r' && p[2] == '\n') softs++;
+    ok(softs == lines - 1, "Got %d soft breaks for %d lines.\n", softs, lines);
+    /* and no more than that: without them it is the text */
+    {
+        WCHAR *out = buffer, *in = buffer;
+
+        while (*in)
+        {
+            if (in[0] == '\r' && in[1] == '\r' && in[2] == '\n') in += 3;
+            else *out++ = *in++;
+        }
+        *out = 0;
+    }
+    ok(!lstrcmpW(buffer, text), "Got %s.\n", wine_dbgstr_w(buffer));
+
+    /* a buffer that is too small */
+    memset(buffer, 0xcc, sizeof(buffer));
+    len = SendMessageW(edit, WM_GETTEXT, 8, (LPARAM)buffer);
+    ok(len == 7 && !buffer[7], "Got %d.\n", len);
+
+    ret = SendMessageW(edit, EM_FMTLINES, FALSE, 0);
+    ok(ret == FALSE, "Got %Id.\n", ret);
+    len = SendMessageW(edit, WM_GETTEXT, ARRAY_SIZE(buffer), (LPARAM)buffer);
+    ok(len == lstrlenW(text) && !lstrcmpW(buffer, text), "Got %d, %s.\n", len, wine_dbgstr_w(buffer));
+    DestroyWindow(edit);
+
+    /* a hard line break is left as it is */
+    edit = CreateWindowW(L"Edit", hard, WS_POPUP | WS_VISIBLE | ES_MULTILINE | ES_AUTOVSCROLL, 0, 0, 200, 200,
+                         NULL, NULL, hinst, NULL);
+    SendMessageW(edit, EM_FMTLINES, TRUE, 0);
+    len = SendMessageW(edit, WM_GETTEXT, ARRAY_SIZE(buffer), (LPARAM)buffer);
+    ok(len == lstrlenW(hard) && !lstrcmpW(buffer, hard), "Got %d, %s.\n", len, wine_dbgstr_w(buffer));
+    DestroyWindow(edit);
+}
+
 START_TEST(edit)
 {
     ULONG_PTR ctx_cookie;
@@ -3886,6 +3952,7 @@ START_TEST(edit)
     test_cue_banner();
     test_ime();
     test_format_rect();
+    test_EM_FMTLINES();
 
     UnregisterWindowClasses();
 
