+
     return DPN_OK;
 }
 
 static HRESULT WINAPI IDirectPlay8ThreadPoolImpl_SetThreadCount(IDirectPlay8ThreadPool *iface,
         const DWORD dwProcessorNum, const DWORD dwNumThreads, const DWORD dwFlags)
 {
-    FIXME("(%p)->(%lx,%lx,%lx): stub\n", iface, dwProcessorNum, dwNumThreads, dwFlags);
+    PFNDPNMESSAGEHANDLER handler;
+    void *context;
+    DWORD *count, old, i;
+
+    TRACE("(%p)->(%lx,%lx,%lx)\n", iface, dwProcessorNum, dwNumThreads, dwFlags);
+
+    if(!threadpool_msghandler)
+        return DPNERR_UNINITIALIZED;
+
+    if(dwFlags)
+        return DPNERR_INVALIDFLAGS;
+
+    if(dwProcessorNum == -1)
+        count = &threadpool_all_threads;
+    else if(dwProcessorNum < MAX_PROCESSORS)
+        count = &threadpool_proc_threads[dwProcessorNum];
+    else
+        return DPNERR_INVALIDPARAM;
+
+    handler = threadpool_msghandler;
+    context = threadpool_usercontext;
+    old = *count;
+    *count = dwNumThreads;
+
+    for(i = old; i < dwNumThreads; i++)
+    {
+        DPNMSG_CREATE_THREAD msg;
+
+        msg.dwSize = sizeof(msg);
+        msg.dwFlags = 0;
+        msg.dwProcessorNum = dwProcessorNum == -1 ? 0 : dwProcessorNum;
+        msg.pvUserContext = NULL;
+        handler(context, DPN_MSGID_CREATE_THREAD, &msg);
+    }
+    for(i = dwNumThreads; i < old; i++)
+    {
+        DPNMSG_DESTROY_THREAD msg;
+
+        msg.dwSize = sizeof(msg);
+        msg.dwProcessorNum = dwProcessorNum == -1 ? 0 : dwProcessorNum;
+        msg.pvUserContext = NULL;
+        handler(context, DPN_MSGID_DESTROY_THREAD, &msg);
+    }
+
     return DPN_OK;
 }
 
