+/* The thread pool is a per-process service shared by all pool objects. Thread
+ * counts are tracked and announced with DPN_MSGID_CREATE_THREAD and
+ * DPN_MSGID_DESTROY_THREAD messages to the registered handler; no worker
+ * threads are started on behalf of the application. */
+#define MAX_PROCESSORS 64
+static DWORD threadpool_all_threads;                    /* set with processor number -1 */
+static DWORD threadpool_proc_threads[MAX_PROCESSORS];
+
+static DWORD threadpool_total(void)
+{
+    DWORD i, total = threadpool_all_threads;
+
+    for (i = 0; i < MAX_PROCESSORS; i++) total += threadpool_proc_threads[i];
+    return total;
+}
+
 static HRESULT WINAPI IDirectPlay8ThreadPoolImpl_Close(IDirectPlay8ThreadPool *iface,
         const DWORD dwFlags)
 {
     IDirectPlay8ThreadPoolImpl *This = impl_from_IDirectPlay8ThreadPool(iface);
 
-    FIXME("(%p)->(%lx)\n", This, dwFlags);
+    TRACE("(%p)->(%lx)\n", This, dwFlags);
 
     if(!threadpool_msghandler)
         return DPNERR_UNINITIALIZED;
 
+    if(dwFlags)
+        return DPNERR_INVALIDFLAGS;
+
     threadpool_msghandler = NULL;
+    threadpool_usercontext = NULL;
+    threadpool_all_threads = 0;
+    memset(threadpool_proc_threads, 0, sizeof(threadpool_proc_threads));
 
     return DPN_OK;
 }
