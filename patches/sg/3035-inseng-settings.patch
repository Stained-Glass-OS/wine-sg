From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 13:51:12 -0700
Subject: [PATCH] inseng: install engine settings and callback registration

SetBaseUrl, SetDownloadDir, SetInstallDrive, SetInstallOptions, SetHWND, SetIStream, SetLocalCif,
Register/UnregisterInstallEngineCallback, Abort, Suspend and Resume keep their state instead of failing.
Downloading and installing components is not implemented.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/inseng/inseng_main.c b/dlls/inseng/inseng_main.c
index f7ce3f1..841c733 100644
--- a/dlls/inseng/inseng_main.c
+++ b/dlls/inseng/inseng_main.c
@@ -38,8 +38,38 @@ WINE_DEFAULT_DEBUG_CHANNEL(inseng);
 struct InstallEngine {
     IInstallEngine2 IInstallEngine2_iface;
     LONG ref;
+
+    IInstallEngineCallback *callback;
+    char *base_url;
+    char *download_dir;
+    char *local_cif;
+    char install_drive;
+    DWORD install_options;
+    HWND hwnd;
+    IStream *stream;
+    BOOL suspended, aborted;
 };
 
+static char *dup_str(const char *str)
+{
+    size_t len = strlen(str) + 1;
+    char *ret = malloc(len);
+
+    if(ret) memcpy(ret, str, len);
+    return ret;
+}
+
+static HRESULT set_string(char **dst, const char *src)
+{
+    char *copy;
+
+    if(!src) return E_INVALIDARG;
+    if(!(copy = dup_str(src))) return E_OUTOFMEMORY;
+    free(*dst);
+    *dst = copy;
+    return S_OK;
+}
+
 static inline InstallEngine *impl_from_IInstallEngine2(IInstallEngine2 *iface)
 {
     return CONTAINING_RECORD(iface, InstallEngine, IInstallEngine2_iface);
@@ -85,8 +115,14 @@ static ULONG WINAPI InstallEngine_Release(IInstallEngine2 *iface)
 
     TRACE("(%p) ref=%ld\n", This, ref);
 
-    if(!ref)
+    if(!ref) {
+        if(This->callback) IInstallEngineCallback_Release(This->callback);
+        if(This->stream) IStream_Release(This->stream);
+        free(This->base_url);
+        free(This->download_dir);
+        free(This->local_cif);
         free(This);
+    }
 
     return ref;
 }
@@ -143,15 +179,26 @@ static HRESULT WINAPI InstallEngine_IsComponentInstalled(IInstallEngine2 *iface,
 static HRESULT WINAPI InstallEngine_RegisterInstallEngineCallback(IInstallEngine2 *iface, IInstallEngineCallback *callback)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)->(%p)\n", This, callback);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", This, callback);
+
+    if(!callback) return E_INVALIDARG;
+    if(This->callback) IInstallEngineCallback_Release(This->callback);
+    This->callback = callback;
+    IInstallEngineCallback_AddRef(callback);
+    return S_OK;
 }
 
 static HRESULT WINAPI InstallEngine_UnregisterInstallEngineCallback(IInstallEngine2 *iface)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+
+    TRACE("(%p)\n", This);
+
+    if(This->callback) {
+        IInstallEngineCallback_Release(This->callback);
+        This->callback = NULL;
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI InstallEngine_SetAction(IInstallEngine2 *iface, const char *id, DWORD action, DWORD priority)
@@ -185,71 +232,89 @@ static HRESULT WINAPI InstallEngine_GetDisplayName(IInstallEngine2 *iface, const
 static HRESULT WINAPI InstallEngine_SetBaseUrl(IInstallEngine2 *iface, const char *base_name)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)->(%s)\n", This, debugstr_a(base_name));
-    return E_NOTIMPL;
+    TRACE("(%p)->(%s)\n", This, debugstr_a(base_name));
+    return set_string(&This->base_url, base_name);
 }
 
 static HRESULT WINAPI InstallEngine_SetDownloadDir(IInstallEngine2 *iface, const char *download_dir)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)->(%s)\n", This, debugstr_a(download_dir));
-    return E_NOTIMPL;
+    TRACE("(%p)->(%s)\n", This, debugstr_a(download_dir));
+    return set_string(&This->download_dir, download_dir);
 }
 
 static HRESULT WINAPI InstallEngine_SetInstallDrive(IInstallEngine2 *iface, char drive)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)->(%c)\n", This, drive);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%c)\n", This, drive);
+
+    if(!((drive >= 'a' && drive <= 'z') || (drive >= 'A' && drive <= 'Z'))) return E_INVALIDARG;
+    This->install_drive = drive;
+    return S_OK;
 }
 
 static HRESULT WINAPI InstallEngine_SetInstallOptions(IInstallEngine2 *iface, DWORD flags)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)->(%lx)\n", This, flags);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%lx)\n", This, flags);
+
+    This->install_options = flags;
+    return S_OK;
 }
 
 static HRESULT WINAPI InstallEngine_SetHWND(IInstallEngine2 *iface, HWND hwnd)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)->(%p)\n", This, hwnd);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", This, hwnd);
+
+    This->hwnd = hwnd;
+    return S_OK;
 }
 
 static HRESULT WINAPI InstallEngine_SetIStream(IInstallEngine2 *iface, IStream *stream)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)->(%p)\n", This, stream);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", This, stream);
+
+    if(stream) IStream_AddRef(stream);
+    if(This->stream) IStream_Release(This->stream);
+    This->stream = stream;
+    return S_OK;
 }
 
 static HRESULT WINAPI InstallEngine_Abort(IInstallEngine2 *iface, DWORD flags)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)->(%lx)\n", This, flags);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%lx)\n", This, flags);
+
+    This->aborted = TRUE;
+    return S_OK;
 }
 
 static HRESULT WINAPI InstallEngine_Suspend(IInstallEngine2 *iface)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+    TRACE("(%p)\n", This);
+
+    This->suspended = TRUE;
+    return S_OK;
 }
 
 static HRESULT WINAPI InstallEngine_Resume(IInstallEngine2 *iface)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+
+    TRACE("(%p)\n", This);
+
+    This->suspended = FALSE;
+    return S_OK;
 }
 
 static HRESULT WINAPI InstallEngine2_SetLocalCif(IInstallEngine2 *iface, const char *cif)
 {
     InstallEngine *This = impl_from_IInstallEngine2(iface);
-    FIXME("(%p)->(%s)\n", This, debugstr_a(cif));
-    return E_NOTIMPL;
+    TRACE("(%p)->(%s)\n", This, debugstr_a(cif));
+    return set_string(&This->local_cif, cif);
 }
 
 static HRESULT WINAPI InstallEngine2_GetICifFile(IInstallEngine2 *iface, ICifFile **cif_file)
@@ -333,7 +398,9 @@ static HRESULT WINAPI InstallEngineCF_CreateInstance(IClassFactory *iface, IUnkn
 
     TRACE("(%p %s %p)\n", outer, debugstr_guid(riid), ppv);
 
-    engine = malloc(sizeof(*engine));
+    if(outer) return CLASS_E_NOAGGREGATION;
+
+    engine = calloc(1, sizeof(*engine));
     if(!engine)
         return E_OUTOFMEMORY;
 
@@ -371,7 +438,7 @@ HRESULT WINAPI DllGetClassObject(REFCLSID rclsid, REFIID iid, LPVOID *ppv)
 
 BOOL WINAPI CheckTrustEx( LPVOID a, LPVOID b, LPVOID c, LPVOID d, LPVOID e )
 {
-    FIXME("%p %p %p %p %p\n", a, b, c, d, e );
+    FIXME("%p %p %p %p %p: signatures are not verified\n", a, b, c, d, e );
     return TRUE;
 }
 
@@ -380,6 +447,6 @@ BOOL WINAPI CheckTrustEx( LPVOID a, LPVOID b, LPVOID c, LPVOID d, LPVOID e )
  */
 HRESULT WINAPI DllInstall(BOOL bInstall, LPCWSTR cmdline)
 {
-    FIXME("(%s, %s): stub\n", bInstall ? "TRUE" : "FALSE", debugstr_w(cmdline));
+    TRACE("(%s, %s)\n", bInstall ? "TRUE" : "FALSE", debugstr_w(cmdline));
     return S_OK;
 }
