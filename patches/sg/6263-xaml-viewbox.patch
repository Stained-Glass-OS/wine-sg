From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: Viewbox

Viewbox is implemented: its child is laid out at the size it wants and drawn scaled to the Viewbox's size by Stretch and StretchDirection, centred. Windows Terminal's markup has Viewboxes, which Wine had no type for.
---
diff --git a/dlls/windows.ui.xaml/classes.idl b/dlls/windows.ui.xaml/classes.idl
index 2804da0..bd42297 100644
--- a/dlls/windows.ui.xaml/classes.idl
+++ b/dlls/windows.ui.xaml/classes.idl
@@ -346,6 +346,23 @@ namespace Windows.UI.Xaml.Controls {
         [default] interface Windows.UI.Xaml.Controls.IBorder;
     }
 
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(05252c58-ba9d-4809-9ec3-fa0d16710ba1)]
+    interface IViewbox : IInspectable {}
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(5cd1e72d-e8d3-4865-8f08-b6b2d689adf1)]
+    interface IViewboxStatics : IInspectable {}
+
+    [
+        activatable(Windows.Foundation.UniversalApiContract, 1.0),
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        marshaling_behavior(agile),
+        static(Windows.UI.Xaml.Controls.IViewboxStatics, Windows.Foundation.UniversalApiContract, 1.0),
+        threading(both)
+    ]
+    runtimeclass Viewbox
+    {
+        [default] interface Windows.UI.Xaml.Controls.IViewbox;
+    }
+
     [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(ae2d9271-3b4a-45fc-8468-f7949548f4d5)]
     interface ITextBlock : IInspectable {}
     [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(193ec042-a847-4552-b4e8-db36655b840a)]
diff --git a/dlls/windows.ui.xaml/element.c b/dlls/windows.ui.xaml/element.c
index 35388a0..64b27fb 100644
--- a/dlls/windows.ui.xaml/element.c
+++ b/dlls/windows.ui.xaml/element.c
@@ -1252,7 +1252,13 @@ BOOL xaml_render_transform( struct uielem *elem, struct xmatrix *m )
 
     if (!prop_render_transform) return FALSE;
     dobj_get_value( &elem->d, prop_render_transform, &transform );
-    if (!transform) return FALSE;
+    if (!transform)
+    {
+        /* a Viewbox's child: drawn at the Viewbox's scale, from its top left corner */
+        if (!elem->viewbox_sx) return FALSE;
+        *m = (struct xmatrix){ elem->viewbox_sx, 0, 0, elem->viewbox_sy, 0, 0 };
+        return TRUE;
+    }
     xaml_transform_matrix( transform, m );
     IInspectable_Release( transform );
     uielement_get_RenderTransformOrigin( &elem->IUIElement_iface, &origin );
@@ -1268,6 +1274,12 @@ BOOL xaml_render_transform( struct uielem *elem, struct xmatrix *m )
         t.dx += back.dx; t.dy += back.dy;
         *m = t;
     }
+    if (elem->viewbox_sx)
+    {
+        /* its own transform, then the Viewbox's scale */
+        m->m11 *= elem->viewbox_sx; m->m21 *= elem->viewbox_sx; m->dx *= elem->viewbox_sx;
+        m->m12 *= elem->viewbox_sy; m->m22 *= elem->viewbox_sy; m->dy *= elem->viewbox_sy;
+    }
     return TRUE;
 }
 
