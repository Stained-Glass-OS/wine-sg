diff --git a/dlls/windows.ui.xaml/panel.c b/dlls/windows.ui.xaml/panel.c
index 9966004..b101b30 100644
--- a/dlls/windows.ui.xaml/panel.c
+++ b/dlls/windows.ui.xaml/panel.c
@@ -2162,6 +2162,237 @@ static struct xfactory border_factory_obj =
 
 IActivationFactory *border_factory = &border_factory_obj.IActivationFactory_iface;
 
+/* ---- Viewbox: its child at the size it wants, scaled to the Viewbox's (wine-sg 6263) ---- */
+
+enum { STRETCH_NONE, STRETCH_FILL, STRETCH_UNIFORM, STRETCH_UNIFORM_TO_FILL };
+enum { STRETCH_UP_ONLY, STRETCH_DOWN_ONLY, STRETCH_BOTH };
+
+static struct xaml_property *prop_viewbox_stretch, *prop_viewbox_direction;
+
+struct viewbox
+{
+    struct uielem e;
+    struct xiface IViewbox_iface;
+    struct uielem *child;
+};
+
+static struct viewbox *viewbox_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface, struct viewbox, IViewbox_iface );
+}
+
+static BOOL WINAPI init_viewbox( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR viewbox[] = L"Windows.UI.Xaml.Controls.Viewbox";
+
+    xaml_elements_init();
+    prop_viewbox_stretch = xaml_property_register( viewbox, L"Stretch", L"Windows.UI.Xaml.Media.Stretch",
+                                                   xbox_int32( STRETCH_UNIFORM ), FALSE, invalidate_changed );
+    prop_viewbox_direction = xaml_property_register( viewbox, L"StretchDirection", L"Windows.UI.Xaml.Controls.StretchDirection",
+                                                     xbox_int32( STRETCH_BOTH ), FALSE, invalidate_changed );
+    return TRUE;
+}
+
+static void viewbox_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_viewbox, NULL, NULL );
+}
+
+/* the scale of content of a size in a space of another, by the Viewbox's Stretch and StretchDirection */
+static void viewbox_scale( struct uielem *elem, struct xsize space, struct xsize content, DOUBLE *sx, DOUBLE *sy )
+{
+    INT32 stretch = dobj_int( &elem->d, prop_viewbox_stretch, STRETCH_UNIFORM );
+    INT32 direction = dobj_int( &elem->d, prop_viewbox_direction, STRETCH_BOTH );
+    BOOL w_inf = isinf( space.width ) || space.width != space.width, h_inf = isinf( space.height ) || space.height != space.height;
+    DOUBLE x = 1, y = 1;
+
+    *sx = *sy = 1;
+#ifdef SG_MUTANT_VIEWBOX_NO_SCALE
+    return;
+#endif
+    if (stretch == STRETCH_NONE || content.width <= 0 || content.height <= 0 || (w_inf && h_inf)) return;
+    if (!w_inf) x = space.width / content.width;
+    if (!h_inf) y = space.height / content.height;
+    if (w_inf) x = y;
+    else if (h_inf) y = x;
+    else if (stretch == STRETCH_UNIFORM) x = y = min( x, y );
+    else if (stretch == STRETCH_UNIFORM_TO_FILL) x = y = max( x, y );
+    else if (stretch == STRETCH_FILL && (w_inf || h_inf)) x = y = w_inf ? y : x;
+    if (direction == STRETCH_UP_ONLY) { x = max( x, 1 ); y = max( y, 1 ); }
+    else if (direction == STRETCH_DOWN_ONLY) { x = min( x, 1 ); y = min( y, 1 ); }
+    *sx = x;
+    *sy = y;
+}
+
+static void viewbox_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct viewbox *vb = CONTAINING_RECORD( elem, struct viewbox, e );
+    struct xsize unbounded = { INFINITY, INFINITY }, content;
+    DOUBLE sx, sy;
+
+    desired->width = desired->height = 0;
+    if (!vb->child) return;
+    uielem_measure( vb->child, unbounded );
+    content = vb->child->desired;
+    viewbox_scale( elem, available, content, &sx, &sy );
+    desired->width = content.width * sx;
+    desired->height = content.height * sy;
+}
+
+static void viewbox_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct viewbox *vb = CONTAINING_RECORD( elem, struct viewbox, e );
+    struct xsize content;
+    struct xrect rect;
+    DOUBLE sx, sy;
+
+    *used = final;
+    if (!vb->child) return;
+    content = vb->child->desired;
+    viewbox_scale( elem, final, content, &sx, &sy );
+    /* the child at its own size, drawn scaled, in the middle */
+    rect.x = (final.width - content.width * sx) / 2;
+    rect.y = (final.height - content.height * sy) / 2;
+    rect.width = content.width;
+    rect.height = content.height;
+    uielem_arrange( vb->child, rect );
+    vb->child->viewbox_sx = sx;
+    vb->child->viewbox_sy = sy;
+    TRACE( "%p: content %gx%g in %gx%g, scale %g,%g\n", elem, content.width, content.height, final.width, final.height, sx, sy );
+}
+
+static const struct elem_ops viewbox_ops = { viewbox_measure, viewbox_arrange };
+
+static HRESULT WINAPI viewbox_get_Child( struct xiface *iface, IInspectable **value )
+{
+    struct viewbox *vb = viewbox_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (vb->child) IUnknown_QueryInterface( vb->child->d.obj.outer, &IID_IUIElement, (void **)value );
+    return S_OK;
+}
+
+static HRESULT WINAPI viewbox_put_Child( struct xiface *iface, IInspectable *value )
+{
+    struct viewbox *vb = viewbox_from_iface( iface );
+    struct uielem *child = NULL;
+
+    if (value && !(child = uielem_from_inspectable( value ))) return E_INVALIDARG;
+    if (child && child->parent && child->parent != &vb->e) return E_INVALIDARG;
+    if (vb->child == child) return S_OK;
+    if (vb->child)
+    {
+        vb->child->viewbox_sx = vb->child->viewbox_sy = 0;
+        uielem_remove_child( &vb->e, vb->child );
+    }
+    vb->child = child;
+    if (child) uielem_add_child( &vb->e, child );
+    uielem_invalidate_measure( &vb->e );
+    return S_OK;
+}
+
+static HRESULT WINAPI viewbox_get_Stretch( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = dobj_int( &viewbox_from_iface( iface )->e.d, prop_viewbox_stretch, STRETCH_UNIFORM );
+    return S_OK;
+}
+
+static HRESULT WINAPI viewbox_put_Stretch( struct xiface *iface, INT32 value )
+{
+    return put_boxed( &viewbox_from_iface( iface )->e.d, prop_viewbox_stretch, xbox_int32( value ) );
+}
+
+static HRESULT WINAPI viewbox_get_StretchDirection( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = dobj_int( &viewbox_from_iface( iface )->e.d, prop_viewbox_direction, STRETCH_BOTH );
+    return S_OK;
+}
+
+static HRESULT WINAPI viewbox_put_StretchDirection( struct xiface *iface, INT32 value )
+{
+    return put_boxed( &viewbox_from_iface( iface )->e.d, prop_viewbox_direction, xbox_int32( value ) );
+}
+
+static const void *viewbox_vtbl[] =
+{
+    IViewbox_STUBS,
+    [IViewbox_Child] = viewbox_get_Child,
+    [IViewbox_SetChild] = viewbox_put_Child,
+    [IViewbox_Stretch] = viewbox_get_Stretch,
+    [IViewbox_SetStretch] = viewbox_put_Stretch,
+    [IViewbox_StretchDirection] = viewbox_get_StretchDirection,
+    [IViewbox_SetStretchDirection] = viewbox_put_StretchDirection,
+};
+
+static const struct xiface_entry viewbox_ifaces[] =
+{
+    { &IID_IViewbox, offsetof(struct viewbox, IViewbox_iface) },
+    UIELEM_IFACES,
+};
+
+static void viewbox_destroy( struct xobj *obj )
+{
+    struct viewbox *vb = CONTAINING_RECORD( obj, struct viewbox, e.d.obj );
+    vb->child = NULL;
+    uielem_cleanup( &vb->e );
+}
+
+static const struct xclass viewbox_class =
+{
+    L"Windows.UI.Xaml.Controls.Viewbox", viewbox_ifaces, ARRAY_SIZE(viewbox_ifaces), viewbox_destroy,
+};
+
+static HRESULT activate_viewbox( IInspectable **out )
+{
+    struct viewbox *vb;
+
+    panels_init();
+    viewbox_init();
+    if (!(vb = calloc( 1, sizeof(*vb) ))) return E_OUTOFMEMORY;
+    vb->IViewbox_iface.vtbl = viewbox_vtbl;
+    uielem_init( &vb->e, &viewbox_class, &viewbox_ops, NULL );
+    *out = (IInspectable *)&vb->IViewbox_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI viewbox_statics_StretchProperty( struct xfiface *iface, IInspectable **value )
+{
+    viewbox_init();
+    if (!value) return E_POINTER;
+    IInspectable_AddRef( (*value = xaml_property_iface( prop_viewbox_stretch )) );
+    return S_OK;
+}
+
+static HRESULT WINAPI viewbox_statics_StretchDirectionProperty( struct xfiface *iface, IInspectable **value )
+{
+    viewbox_init();
+    if (!value) return E_POINTER;
+    IInspectable_AddRef( (*value = xaml_property_iface( prop_viewbox_direction )) );
+    return S_OK;
+}
+
+static const void *viewbox_statics_vtbl[] =
+{
+    IViewboxStatics_FSTUBS,
+    [IViewboxStatics_StretchProperty] = viewbox_statics_StretchProperty,
+    [IViewboxStatics_StretchDirectionProperty] = viewbox_statics_StretchDirectionProperty,
+};
+
+static struct xfactory viewbox_factory_obj =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Controls.Viewbox",
+    { &IID_IViewboxStatics },
+    { { viewbox_statics_vtbl } },
+    activate_viewbox,
+};
+
+IActivationFactory *viewbox_factory = &viewbox_factory_obj.IActivationFactory_iface;
+
 /* ---- the properties ---- */
 
 static BOOL WINAPI init_panels( INIT_ONCE *once, void *param, void **context )
diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
index 7faa36f..73c414d 100644
--- a/dlls/windows.ui.xaml/private.h
+++ b/dlls/windows.ui.xaml/private.h
@@ -330,6 +330,7 @@ struct uielem
     struct xrect final;             /* of the last Arrange */
     struct xsize render;            /* RenderSize */
