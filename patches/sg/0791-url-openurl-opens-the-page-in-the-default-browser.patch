From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] url: OpenURL opens the page in the default browser

David 2026-10-04: "windows apps/command line can't seem to open firefox
for linux" -- installing Claude Code in PowerShell, its sign-in printed an
address to go to instead of opening the browser. Programs open a page with
rundll32 url.dll,OpenURL URL (Claude Code among them); Wine's OpenURL was
a stub that did nothing. It now gives the URL -- the rest of rundll32's
command line, without surrounding blanks or quotes -- to ShellExecute,
which opens it with the protocol's handler: the default browser, Linux
Firefox on Stained Glass.

Test: test/openurl-gate.sh with test/openurl-handler.c (an https handler
of the gate's records the whole URL, &s and all; mutant
SG_MUTANT_OPENURL_STUB).
---
--- a/dlls/url/url_main.c
+++ b/dlls/url/url_main.c
@@ -17,6 +17,7 @@
  */
 
 #include <stdarg.h>
+#include <string.h>
 #include "windef.h"
 #include "winbase.h"
 #include "winreg.h"
@@ -89,7 +90,28 @@
  */
 void WINAPI OpenURLA(HWND hwnd, HINSTANCE inst, LPCSTR cmdline, INT show)
 {
+#ifndef SG_MUTANT_OPENURL_STUB
+    /* rundll32 url.dll,OpenURL URL -- how programs (Claude Code's sign-in
+     * among them) open a page in the default browser: the URL goes to its
+     * protocol's handler, the rest of the command line as it is, without
+     * surrounding blanks or quotes */
+    const char *s = cmdline, *e;
+    char *url;
+
+    TRACE("(%p, %p, %s, %d)\n", hwnd, inst, debugstr_a(cmdline), show);
+    if (!s) return;
+    while (*s == ' ' || *s == '\t') s++;
+    e = s + strlen(s);
+    while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n')) e--;
+    if (e - s >= 2 && *s == '"' && e[-1] == '"') { s++; e--; }
+    if (e == s || !(url = HeapAlloc(GetProcessHeap(), 0, e - s + 1))) return;
+    memcpy(url, s, e - s);
+    url[e - s] = 0;
+    ShellExecuteA(hwnd, NULL, url, NULL, NULL, show ? show : SW_SHOWNORMAL);
+    HeapFree(GetProcessHeap(), 0, url);
+#else
     FIXME("(%p, %p, %s, %d): stub!\n", hwnd, inst, debugstr_a(cmdline), show);
+#endif
 }
 
