From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uxtheme: buffered painting honours its parameters, clears and sets alpha

BeginBufferedPaint logged "painting parameters are ignored" (1621 times in
the logs) and ignored them; BufferedPaintClear and BufferedPaintSetAlpha
failed with E_NOTIMPL -- programs drawing on glass or animating themed
controls set the alpha GDI leaves at 0 with BufferedPaintSetAlpha.

The parameters' excluded rectangle is left out of the buffer's clip and
of the copy back, so the target keeps its pixels there; a blend function
copies the buffer back with GdiAlphaBlend. Buffers are new for each paint,
so they always start erased (BPPF_ERASE). BufferedPaintClear sets a
rectangle (or the whole buffer) to ARGB 0 -- in a 32-bit buffer's bits,
else with BLACKNESS; BufferedPaintSetAlpha sets the alpha of a rectangle
of a 32-bit buffer, bottom-up or top-down. Both fail with E_FAIL for no
buffer. BufferedPaintInit/UnInit stop logging FIXMEs: there is nothing to
set up. BPPF_ERASE, BPPF_NOCLIP and BPPF_NONCLIENT are added to uxtheme.h.

Wine's uxtheme system tests: the two BufferedPaintClear checks marked
todo_wine pass and are no longer marked; no failures.

Gate: test/bufpaint-gate.sh. Mutant SG_MUTANT_NO_PAINT_PARAMS
(uxtheme/buffer.c).
---
--- a/dlls/uxtheme/buffer.c
+++ b/dlls/uxtheme/buffer.c
@@ -40,6 +40,11 @@ struct paintbuffer
     HBITMAP bitmap;
     RECT rect;
     void *bits;
+    BOOL exclude;       /* the painting parameters: a rectangle not copied back, */
+    RECT exclude_rect;
+    BOOL blend;         /* and a blend instead of a copy */
+    BLENDFUNCTION blendfunc;
+    BOOL bottom_up;     /* BPBF_DIB's rows */
 };
 
 static void free_paintbuffer(struct paintbuffer *buffer)
@@ -59,7 +64,8 @@ static struct paintbuffer *get_buffer_obj(HPAINTBUFFER handle)
  */
 HRESULT WINAPI BufferedPaintInit(VOID)
 {
-    FIXME("Stub ()\n");
+    /* buffers are made for each paint; nothing is kept per thread */
+    TRACE("()\n");
     return S_OK;
 }
 
@@ -68,7 +74,7 @@ HRESULT WINAPI BufferedPaintInit(VOID)
  */
 HRESULT WINAPI BufferedPaintUnInit(VOID)
 {
-    FIXME("Stub ()\n");
+    TRACE("()\n");
     return S_OK;
 }
 
@@ -91,12 +97,35 @@ HPAINTBUFFER WINAPI BeginBufferedPaint(HDC targetdc, const RECT *rect,
     if (!targetdc || IsRectEmpty(rect))
         return NULL;
 
-    if (params)
-        FIXME("painting parameters are ignored\n");
-
-    buffer = malloc(sizeof(*buffer));
+    buffer = calloc(1, sizeof(*buffer));
     buffer->targetdc = targetdc;
     buffer->rect = *rect;
+#ifndef SG_MUTANT_NO_PAINT_PARAMS
+    /* The painting parameters (1621 FIXMEs in the logs): a rectangle left
+     * out when the buffer is copied back, and a blend function to copy it
+     * back with. Buffers are new for every paint, so they start erased
+     * (BPPF_ERASE) whatever the flags. */
+    if (params)
+    {
+        if (params->cbSize < sizeof(*params))
+        {
+            free(buffer);
+            return NULL;
+        }
+        if (params->dwFlags & ~(BPPF_ERASE | BPPF_NOCLIP | BPPF_NONCLIENT))
+            WARN("unknown flags %#lx\n", params->dwFlags);
+        if (params->prcExclude)
+        {
+            buffer->exclude = TRUE;
+            buffer->exclude_rect = *params->prcExclude;
+        }
+        if (params->pBlendFunction)
+        {
+            buffer->blend = TRUE;
+            buffer->blendfunc = *params->pBlendFunction;
+        }
+    }
+#endif
     buffer->memorydc = CreateCompatibleDC(targetdc);
 
     switch (format)
@@ -117,6 +146,7 @@ HPAINTBUFFER WINAPI BeginBufferedPaint(HDC targetdc, const RECT *rect,
         bmi->bmiHeader.biBitCount = format == BPBF_TOPDOWNMONODIB ? 1 : 32;
         bmi->bmiHeader.biPlanes = 1;
         bmi->bmiHeader.biCompression = BI_RGB;
+        buffer->bottom_up = format == BPBF_DIB;
         buffer->bitmap = CreateDIBSection(buffer->memorydc, bmi, DIB_RGB_COLORS, &buffer->bits, NULL, 0);
         break;
     default:
@@ -135,6 +165,9 @@ HPAINTBUFFER WINAPI BeginBufferedPaint(HDC targetdc, const RECT *rect,
 
     SetWindowOrgEx(buffer->memorydc, rect->left, rect->top, NULL);
     IntersectClipRect(buffer->memorydc, rect->left, rect->top, rect->right, rect->bottom);
+    if (buffer->exclude)
+        ExcludeClipRect(buffer->memorydc, buffer->exclude_rect.left, buffer->exclude_rect.top,
+                        buffer->exclude_rect.right, buffer->exclude_rect.bottom);
     DeleteObject(SelectObject(buffer->memorydc, buffer->bitmap));
 
     *retdc = buffer->memorydc;
@@ -156,12 +189,27 @@ HRESULT WINAPI EndBufferedPaint(HPAINTBUFFER bufferhandle, BOOL update)
 
     if (update)
     {
-        if (!BitBlt(buffer->targetdc, buffer->rect.left, buffer->rect.top,
-                buffer->rect.right - buffer->rect.left, buffer->rect.bottom - buffer->rect.top,
-                buffer->memorydc, buffer->rect.left, buffer->rect.top, SRCCOPY))
+        int saved = 0;
+        BOOL ret;
+
+        if (buffer->exclude)
         {
-            WARN("BitBlt() failed\n");
+            saved = SaveDC(buffer->targetdc);
+            ExcludeClipRect(buffer->targetdc, buffer->exclude_rect.left, buffer->exclude_rect.top,
+                            buffer->exclude_rect.right, buffer->exclude_rect.bottom);
         }
+        if (buffer->blend)
+            ret = GdiAlphaBlend(buffer->targetdc, buffer->rect.left, buffer->rect.top,
+                    buffer->rect.right - buffer->rect.left, buffer->rect.bottom - buffer->rect.top,
+                    buffer->memorydc, buffer->rect.left, buffer->rect.top,
+                    buffer->rect.right - buffer->rect.left, buffer->rect.bottom - buffer->rect.top,
+                    buffer->blendfunc);
+        else
+            ret = BitBlt(buffer->targetdc, buffer->rect.left, buffer->rect.top,
+                    buffer->rect.right - buffer->rect.left, buffer->rect.bottom - buffer->rect.top,
+                    buffer->memorydc, buffer->rect.left, buffer->rect.top, SRCCOPY);
+        if (!ret) WARN("copying the buffer back failed\n");
+        if (saved) RestoreDC(buffer->targetdc, saved);
     }
 
     free_paintbuffer(buffer);
@@ -171,10 +219,51 @@ HRESULT WINAPI EndBufferedPaint(HPAINTBUFFER bufferhandle, BOOL update)
 /***********************************************************************
  *      BufferedPaintClear                                 (UXTHEME.@)
  */
+/* the part of the buffer a rectangle in the target's coordinates covers,
+ * in the buffer bitmap's pixels */
+static BOOL buffer_area(const struct paintbuffer *buffer, const RECT *prc, RECT *area)
+{
+    if (!prc) prc = &buffer->rect;
+    if (!IntersectRect(area, prc, &buffer->rect)) return FALSE;
+    OffsetRect(area, -buffer->rect.left, -buffer->rect.top);
+    return TRUE;
+}
+
 HRESULT WINAPI BufferedPaintClear(HPAINTBUFFER hBufferedPaint, const RECT *prc)
 {
+#ifndef SG_MUTANT_NO_PAINT_PARAMS
+    struct paintbuffer *buffer = get_buffer_obj(hBufferedPaint);
+    RECT area;
+    int x, y, width;
+
+    TRACE("(%p %s)\n", hBufferedPaint, wine_dbgstr_rect(prc));
+
+    if (!buffer) return E_FAIL;
+    /* to ARGB {0, 0, 0, 0}: black and fully transparent */
+    if (!buffer_area(buffer, prc, &area)) return S_OK;
+    if (buffer->bits && GetObjectType(buffer->bitmap) == OBJ_BITMAP)
+    {
+        DIBSECTION dib;
+
+        if (GetObjectW(buffer->bitmap, sizeof(dib), &dib) == sizeof(dib) && dib.dsBm.bmBitsPixel == 32)
+        {
+            width = buffer->rect.right - buffer->rect.left;
+            for (y = area.top; y < area.bottom; y++)
+            {
+                int row = buffer->bottom_up ? (buffer->rect.bottom - buffer->rect.top - 1 - y) : y;
+                DWORD *line = (DWORD *)buffer->bits + row * width;
+                for (x = area.left; x < area.right; x++) line[x] = 0;
+            }
+            return S_OK;
+        }
+    }
+    PatBlt(buffer->memorydc, buffer->rect.left + area.left, buffer->rect.top + area.top,
+           area.right - area.left, area.bottom - area.top, BLACKNESS);
+    return S_OK;
+#else
     FIXME("Stub (%p %p)\n", hBufferedPaint, prc);
     return E_NOTIMPL;
+#endif
 }
 
 /***********************************************************************
@@ -182,8 +271,33 @@ HRESULT WINAPI BufferedPaintClear(HPAINTBUFFER hBufferedPaint, const RECT *prc)
  */
 HRESULT WINAPI BufferedPaintSetAlpha(HPAINTBUFFER hBufferedPaint, const RECT *prc, BYTE alpha)
 {
+#ifndef SG_MUTANT_NO_PAINT_PARAMS
+    struct paintbuffer *buffer = get_buffer_obj(hBufferedPaint);
+    DIBSECTION dib;
+    RECT area;
+    int x, y, width;
+
+    TRACE("(%p %s %u)\n", hBufferedPaint, wine_dbgstr_rect(prc), alpha);
+
+    if (!buffer) return E_FAIL;
+    /* GDI leaves alpha 0 where it draws; programs set it to 255 after
+     * drawing text on glass. Only 32-bit buffers have an alpha channel. */
+    if (!buffer->bits || GetObjectW(buffer->bitmap, sizeof(dib), &dib) != sizeof(dib) ||
+        dib.dsBm.bmBitsPixel != 32)
+        return E_FAIL;
+    if (!buffer_area(buffer, prc, &area)) return S_OK;
+    width = buffer->rect.right - buffer->rect.left;
+    for (y = area.top; y < area.bottom; y++)
+    {
+        int row = buffer->bottom_up ? (buffer->rect.bottom - buffer->rect.top - 1 - y) : y;
+        BYTE *line = (BYTE *)buffer->bits + row * width * 4;
+        for (x = area.left; x < area.right; x++) line[x * 4 + 3] = alpha;
+    }
+    return S_OK;
+#else
     FIXME("Stub (%p %p %u)\n", hBufferedPaint, prc, alpha);
     return E_NOTIMPL;
+#endif
 }
 
 /***********************************************************************
--- a/dlls/uxtheme/tests/system.c
+++ b/dlls/uxtheme/tests/system.c
@@ -1032,11 +1032,9 @@ static void test_buffered_paint(void)
 
     /* clearing */
     hr = pBufferedPaintClear(NULL, NULL);
-    todo_wine
     ok(hr == E_FAIL, "Unexpected return code %#lx\n", hr);
 
     hr = pBufferedPaintClear(buffer, NULL);
-    todo_wine
     ok(hr == S_OK, "Unexpected return code %#lx\n", hr);
 
     /* access buffer attributes */
--- a/include/uxtheme.h
+++ b/include/uxtheme.h
@@ -247,6 +247,10 @@ typedef struct _BP_PAINTPARAMS
 	const BLENDFUNCTION *pBlendFunction;
 } BP_PAINTPARAMS, *PBP_PAINTPARAMS;
 
+#define BPPF_ERASE     0x0001
+#define BPPF_NOCLIP    0x0002
+#define BPPF_NONCLIENT 0x0004
+
 THEMEAPI_(HPAINTBUFFER) BeginBufferedPaint(HDC, const RECT *, BP_BUFFERFORMAT, BP_PAINTPARAMS *,HDC *);
 THEMEAPI EndBufferedPaint(HPAINTBUFFER, BOOL);
 THEMEAPI BufferedPaintClear(HPAINTBUFFER, const RECT *);
