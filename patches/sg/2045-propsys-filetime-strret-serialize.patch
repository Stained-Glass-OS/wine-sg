+++ b/dlls/propsys/propvar.c
@@ -29,6 +29,7 @@
 #include "winreg.h"
 #include "winuser.h"
 #include "shlobj.h"
+#include "shlwapi.h"
 #include "propvarutil.h"
 #include "strsafe.h"
 
@@ -2592,3 +2593,625 @@
     TRACE("%p, %p, %p\n", var, items, count);
     return variant_vector_op(var, 0, NULL, count, TRUE, (void **)items, sizeof(**items), convert_Double_item);
 }
+
+/* FILETIME, STRRET, resource and serialization conversions */
+
+#define SG_PSTF_UTC   0
+#define SG_PSTF_LOCAL 1
+
+HRESULT WINAPI InitPropVariantFromFileTime(const FILETIME *ft, PROPVARIANT *pv)
+{
+    TRACE("%p, %p\n", ft, pv);
+
+    if (!pv) return E_INVALIDARG;
+    PropVariantInit(pv);
+    if (!ft) return E_INVALIDARG;
+    pv->vt = VT_FILETIME;
+    pv->filetime = *ft;
+    return S_OK;
+}
+
+HRESULT WINAPI PropVariantToFileTime(REFPROPVARIANT pv, UINT flags, FILETIME *ret)
+{
+    FILETIME ft;
+
+    TRACE("%p, %u, %p\n", pv, flags, ret);
+
+    if (!pv || !ret) return E_INVALIDARG;
+    if (flags != SG_PSTF_UTC && flags != SG_PSTF_LOCAL) return E_INVALIDARG;
+
+    switch (pv->vt)
+    {
+    case VT_FILETIME:
+        ft = pv->filetime;
+        break;
+    case VT_DATE:
+    {
+        SYSTEMTIME st;
+        if (!VariantTimeToSystemTime(pv->date, &st) || !SystemTimeToFileTime(&st, &ft))
+            return E_INVALIDARG;
+        break;
+    }
+    default:
+        return TYPE_E_TYPEMISMATCH;
+    }
+
+#ifndef SG_MUTANT_FT_LOCAL
+    if (flags == SG_PSTF_LOCAL && !FileTimeToLocalFileTime(&ft, &ft))
+        return HRESULT_FROM_WIN32(GetLastError());
+#endif
+    *ret = ft;
+    return S_OK;
+}
+
+static HRESULT WINAPI convert_FileTime_item(REFPROPVARIANT pv, void *out)
+{
+    return PropVariantToFileTime(pv, SG_PSTF_UTC, out);
+}
+
+HRESULT WINAPI PropVariantToFileTimeVector(REFPROPVARIANT pv, FILETIME *items, ULONG max_count, ULONG *count)
+{
+    TRACE("%p, %p, %lu, %p\n", pv, items, max_count, count);
+    return propvar_to_vector(pv, max_count, sizeof(*items), items, count, convert_FileTime_item);
+}
+
+HRESULT WINAPI PropVariantToFileTimeVectorAlloc(REFPROPVARIANT pv, FILETIME **items, ULONG *count)
+{
+    TRACE("%p, %p, %p\n", pv, items, count);
+    return propvar_to_vector_alloc(pv, sizeof(**items), (void **)items, count, convert_FileTime_item);
+}
+
+HRESULT WINAPI InitVariantFromFileTimeArray(const FILETIME *items, ULONG count, VARIANT *var)
+{
+    double *dates;
+    ULONG i;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %p\n", items, count, var);
+
+    if (!var) return E_INVALIDARG;
+    VariantInit(var);
+    if (!items && count) return E_INVALIDARG;
+    if (!(dates = CoTaskMemAlloc(max(count, 1) * sizeof(*dates)))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        SYSTEMTIME st;
+        if (!FileTimeToSystemTime(&items[i], &st) || !SystemTimeToVariantTime(&st, &dates[i]))
+        {
+            CoTaskMemFree(dates);
+            return E_INVALIDARG;
+        }
+    }
+    hr = variant_array_from(VT_DATE, dates, count, sizeof(*dates), var);
+    CoTaskMemFree(dates);
+    return hr;
+}
+
+HRESULT WINAPI VariantToFileTime(const VARIANT *var, UINT flags, FILETIME *ret)
+{
+    PROPVARIANT pv;
+    HRESULT hr;
+
+    TRACE("%p, %u, %p\n", var, flags, ret);
+
+    if (!ret) return E_INVALIDARG;
+    if (var && V_VT(var) == VT_DATE)
+    {
+        PropVariantInit(&pv);
+        pv.vt = VT_DATE;
+        pv.date = V_DATE(var);
+    }
+    else if (FAILED(hr = variant_to_propvar(var, &pv))) return hr;
+    hr = PropVariantToFileTime(&pv, flags, ret);
+    PropVariantClear(&pv);
+    return hr;
+}
+
+HRESULT WINAPI VariantToDosDateTime(const VARIANT *var, WORD *date, WORD *time)
+{
+    FILETIME ft;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", var, date, time);
+
+    if (!date || !time) return E_INVALIDARG;
+    if (FAILED(hr = VariantToFileTime(var, SG_PSTF_UTC, &ft))) return hr;
+    if (!FileTimeToDosDateTime(&ft, date, time)) return E_INVALIDARG;
+    return S_OK;
+}
+
+HRESULT WINAPI VariantToBuffer(const VARIANT *var, void *ret, UINT cb)
+{
+    PROPVARIANT pv;
+    HRESULT hr;
+
+    TRACE("%p, %p, %u\n", var, ret, cb);
+
+    if (!ret) return E_INVALIDARG;
+    if (FAILED(hr = variant_to_propvar(var, &pv))) return hr;
+    hr = PropVariantToBuffer(&pv, ret, cb);
+    PropVariantClear(&pv);
+    return hr;
+}
+
+HRESULT WINAPI InitPropVariantFromStrRet(STRRET *strret, PCUITEMID_CHILD pidl, PROPVARIANT *pv)
+{
+    WCHAR *str;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", strret, pidl, pv);
+
+    if (!pv) return E_INVALIDARG;
+    PropVariantInit(pv);
+    if (!strret) return E_INVALIDARG;
+    if (FAILED(hr = StrRetToStrW(strret, pidl, &str))) return hr;
+    pv->vt = VT_LPWSTR;
+    pv->pwszVal = str;
+    return S_OK;
+}
+
+HRESULT WINAPI InitVariantFromStrRet(STRRET *strret, PCUITEMID_CHILD pidl, VARIANT *var)
+{
+    BSTR str;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", strret, pidl, var);
+
+    if (!var) return E_INVALIDARG;
+    VariantInit(var);
+    if (!strret) return E_INVALIDARG;
+    if (FAILED(hr = StrRetToBSTR(strret, pidl, &str))) return hr;
+    V_VT(var) = VT_BSTR;
+    V_BSTR(var) = str;
+    return S_OK;
+}
+
+HRESULT WINAPI PropVariantToStrRet(REFPROPVARIANT pv, STRRET *strret)
+{
+    WCHAR *str;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", pv, strret);
+
+    if (!pv || !strret) return E_INVALIDARG;
+    if (FAILED(hr = PropVariantToStringAlloc(pv, &str))) return hr;
+    strret->uType = STRRET_WSTR;
+    strret->pOleStr = str;
+    return S_OK;
+}
+
+HRESULT WINAPI VariantToStrRet(const VARIANT *var, STRRET *strret)
+{
+    PROPVARIANT pv;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", var, strret);
+
+    if (!strret) return E_INVALIDARG;
+    if (FAILED(hr = variant_to_propvar(var, &pv))) return hr;
+    hr = PropVariantToStrRet(&pv, strret);
+    PropVariantClear(&pv);
+    return hr;
+}
+
+#ifdef SG_MUTANT_STRVEC
+#define KEEP_ITEM(end, p) 1
+#else
+#define KEEP_ITEM(end, p) ((end) > (p))
+#endif
+
+/* A semicolon separated list becomes a vector of strings; empty items are dropped. */
+HRESULT WINAPI InitPropVariantFromStringAsVector(const WCHAR *str, PROPVARIANT *pv)
+{
+    WCHAR **items = NULL;
+    const WCHAR *p;
+    ULONG count = 0, n;
+    HRESULT hr = S_OK;
+
+    TRACE("%s, %p\n", debugstr_w(str), pv);
+
+    if (!pv) return E_INVALIDARG;
+    PropVariantInit(pv);
+    if (!str || !*str) return S_OK;
+
+    for (p = str; *p; )
+    {
+        const WCHAR *end = wcschr(p, ';');
+        if (!end) end = p + lstrlenW(p);
+        if (KEEP_ITEM(end, p)) count++;
+        p = *end ? end + 1 : end;
+    }
+    if (!count) return S_OK;
+
+    if (!(items = CoTaskMemAlloc(count * sizeof(*items)))) return E_OUTOFMEMORY;
+    n = 0;
+    for (p = str; *p && n < count; )
+    {
+        const WCHAR *end = wcschr(p, ';');
+        if (!end) end = p + lstrlenW(p);
+        if (KEEP_ITEM(end, p))
+        {
+            if (!(items[n] = CoTaskMemAlloc((end - p + 1) * sizeof(WCHAR)))) { hr = E_OUTOFMEMORY; break; }
+            memcpy(items[n], p, (end - p) * sizeof(WCHAR));
+            items[n][end - p] = 0;
+            n++;
+        }
+        p = *end ? end + 1 : end;
+    }
+    if (FAILED(hr))
+    {
+        while (n--) CoTaskMemFree(items[n]);
+        CoTaskMemFree(items);
+        return hr;
+    }
+    pv->vt = VT_LPWSTR | VT_VECTOR;
+    pv->calpwstr.cElems = count;
+    pv->calpwstr.pElems = items;
+    return S_OK;
+}
+
+HRESULT WINAPI InitPropVariantFromResource(HINSTANCE inst, UINT id, PROPVARIANT *pv)
+{
+    const WCHAR *res;
+    WCHAR *str;
+    int len;
+
+    TRACE("%p, %u, %p\n", inst, id, pv);
+
+    if (!pv) return E_INVALIDARG;
+    PropVariantInit(pv);
+    if (!(len = LoadStringW(inst, id, (WCHAR *)&res, 0)))
+    {
+        DWORD err = GetLastError();
+        return err ? HRESULT_FROM_WIN32(err) : HRESULT_FROM_WIN32(ERROR_RESOURCE_NAME_NOT_FOUND);
+    }
+    if (!(str = CoTaskMemAlloc((len + 1) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    memcpy(str, res, len * sizeof(WCHAR));
+    str[len] = 0;
+    pv->vt = VT_LPWSTR;
+    pv->pwszVal = str;
+    return S_OK;
+}
+
+HRESULT WINAPI InitVariantFromResource(HINSTANCE inst, UINT id, VARIANT *var)
+{
+    const WCHAR *res;
+    int len;
+
+    TRACE("%p, %u, %p\n", inst, id, var);
+
+    if (!var) return E_INVALIDARG;
+    VariantInit(var);
+    if (!(len = LoadStringW(inst, id, (WCHAR *)&res, 0)))
+    {
+        DWORD err = GetLastError();
+        return err ? HRESULT_FROM_WIN32(err) : HRESULT_FROM_WIN32(ERROR_RESOURCE_NAME_NOT_FOUND);
+    }
+    if (!(V_BSTR(var) = SysAllocStringLen(res, len))) return E_OUTOFMEMORY;
+    V_VT(var) = VT_BSTR;
+    return S_OK;
+}
+
+HRESULT WINAPI InitPropVariantFromPropVariantVectorElem(REFPROPVARIANT src, ULONG index, PROPVARIANT *dst)
+{
+    PROPVARIANT elem;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %p\n", src, index, dst);
+
+    if (!src || !dst) return E_INVALIDARG;
+    if (FAILED(hr = propvar_get_element(src, index, &elem))) { PropVariantInit(dst); return hr; }
+    return PropVariantCopy(dst, &elem);
+}
+
+HRESULT WINAPI InitPropVariantVectorFromPropVariant(REFPROPVARIANT src, PROPVARIANT *dst)
+{
+    ULONG size;
+    PROPVARIANT elem;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", src, dst);
+
+    if (!src || !dst) return E_INVALIDARG;
+    if (src->vt & VT_VECTOR) return PropVariantCopy(dst, src);
+
+    PropVariantInit(dst);
+    if (!(size = propvar_element_size(src->vt))) return E_INVALIDARG;
+    if (FAILED(hr = PropVariantCopy(&elem, src))) return hr;
+    if (!(dst->caub.pElems = CoTaskMemAlloc(size)))
+    {
+        PropVariantClear(&elem);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(dst->caub.pElems, &elem.bVal, size);   /* ownership of any string passes to the vector */
+    dst->caub.cElems = 1;
+    dst->vt = src->vt | VT_VECTOR;
+    return S_OK;
+}
+
+HRESULT WINAPI InitVariantFromVariantArrayElem(const VARIANT *var, ULONG index, VARIANT *ret)
+{
+    PROPVARIANT pv, elem;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %p\n", var, index, ret);
+
+    if (!ret) return E_INVALIDARG;
+    VariantInit(ret);
+    if (FAILED(hr = variant_to_propvar(var, &pv))) return hr;
+    if (SUCCEEDED(hr = propvar_get_element(&pv, index, &elem)))
+        hr = PropVariantToVariant(&elem, ret);
+    PropVariantClear(&pv);
+    return hr;
+}
+
+HRESULT WINAPI ClearVariantArray(VARIANT *vars, UINT count)
+{
+    UINT i;
+
+    TRACE("%p, %u\n", vars, count);
+
+    if (!vars && count) return E_INVALIDARG;
+    for (i = 0; i < count; i++) VariantClear(&vars[i]);
+    return S_OK;
+}
+
+/* Serialized property values (the [MS-OLEPS] TypedPropertyValue layout) */
+
+struct sbuf
+{
+    BYTE *data;
+    ULONG len, cap;
+    BOOL fail;
+};
+
+static void sbuf_put(struct sbuf *b, const void *src, ULONG n)
+{
+    if (b->fail) return;
+    if (b->len + n > b->cap)
+    {
+        ULONG cap = max(b->cap * 2, b->len + n + 64);
+        BYTE *p = CoTaskMemAlloc(cap);
+        if (!p) { b->fail = TRUE; return; }
+        if (b->len) memcpy(p, b->data, b->len);
+        CoTaskMemFree(b->data);
+        b->data = p;
+        b->cap = cap;
+    }
+    if (src) memcpy(b->data + b->len, src, n);
+    else memset(b->data + b->len, 0, n);
+    b->len += n;
+}
+
+static void sbuf_pad(struct sbuf *b)
+{
+#ifdef SG_MUTANT_STG_PAD
+    return;
+#endif
+    if (b->len % 4) sbuf_put(b, NULL, 4 - b->len % 4);
+}
+
+static ULONG ser_fixed_size(VARTYPE vt)
+{
+    switch (vt)
+    {
+    case VT_I1: case VT_UI1: return 1;
+    case VT_I2: case VT_UI2: case VT_BOOL: return 2;
+    case VT_I4: case VT_UI4: case VT_R4: case VT_ERROR: case VT_INT: case VT_UINT: return 4;
+    case VT_I8: case VT_UI8: case VT_R8: case VT_CY: case VT_DATE: case VT_FILETIME: return 8;
+    case VT_CLSID: return sizeof(GUID);
+    default: return 0;
+    }
+}
+
+static void ser_string(struct sbuf *b, VARTYPE vt, const void *str)
+{
+    DWORD n;
+
+    if (vt == VT_LPSTR)
+    {
+        const char *s = str ? str : "";
+        n = strlen(s) + 1;
+        sbuf_put(b, &n, 4);
+        sbuf_put(b, s, n);
+    }
+    else
+    {
+        const WCHAR *s = str ? str : L"";
+        n = lstrlenW(s) + 1;
+        sbuf_put(b, &n, 4);
+        sbuf_put(b, s, n * sizeof(WCHAR));
+    }
+    sbuf_pad(b);
+}
+
+HRESULT WINAPI StgSerializePropVariant(const PROPVARIANT *pv, SERIALIZEDPROPERTYVALUE **out, ULONG *size)
+{
+    struct sbuf b = {0};
+    VARTYPE base;
+    DWORD type;
+    ULONG fixed, i;
+
+    TRACE("%p, %p, %p\n", pv, out, size);
+
+    if (!pv || !out || !size) return E_INVALIDARG;
+    *out = NULL;
+    *size = 0;
+
+    base = pv->vt & ~VT_VECTOR;
+    type = pv->vt;
+    sbuf_put(&b, &type, 4);
+
+    if (pv->vt & VT_VECTOR)
+    {
+        DWORD n = pv->caub.cElems;
+        if ((fixed = ser_fixed_size(base)))
+        {
+            sbuf_put(&b, &n, 4);
+            sbuf_put(&b, pv->caub.pElems, n * fixed);
+            sbuf_pad(&b);
+        }
+        else if (base == VT_LPSTR || base == VT_LPWSTR)
+        {
+            sbuf_put(&b, &n, 4);
+            for (i = 0; i < n; i++) ser_string(&b, base, pv->calpstr.pElems[i]);
+        }
+        else
+        {
+            CoTaskMemFree(b.data);
+            return STG_E_INVALIDPARAMETER;
+        }
+    }
+    else if (pv->vt == VT_EMPTY || pv->vt == VT_NULL)
+    {
+    }
+    else if (base == VT_CLSID)
+    {
+        sbuf_put(&b, pv->puuid, sizeof(GUID));
+    }
+    else if ((fixed = ser_fixed_size(base)))
+    {
+        sbuf_put(&b, &pv->bVal, fixed);
+        sbuf_pad(&b);
+    }
+    else if (base == VT_LPSTR || base == VT_LPWSTR)
+    {
+        ser_string(&b, base, pv->pszVal);
+    }
+    else if (base == VT_BLOB)
+    {
+        DWORD n = pv->blob.cbSize;
+        sbuf_put(&b, &n, 4);
+        sbuf_put(&b, pv->blob.pBlobData, n);
+        sbuf_pad(&b);
+    }
+    else
+    {
+        CoTaskMemFree(b.data);
+        return STG_E_INVALIDPARAMETER;
+    }
+
+    if (b.fail)
+    {
+        CoTaskMemFree(b.data);
+        return E_OUTOFMEMORY;
+    }
+    *out = (SERIALIZEDPROPERTYVALUE *)b.data;
+    *size = b.len;
+    return S_OK;
+}
+
+struct sreader
+{
+    const BYTE *p;
+    ULONG left;
+};
+
+static BOOL sread(struct sreader *r, void *dst, ULONG n)
+{
+    if (n > r->left) return FALSE;
+    if (dst) memcpy(dst, r->p, n);
+    r->p += n;
+    r->left -= n;
+    return TRUE;
+}
+
+static BOOL sskip_pad(struct sreader *r, ULONG consumed)
+{
+    ULONG pad = (4 - consumed % 4) % 4;
+    return sread(r, NULL, pad);
+}
+
+static HRESULT deser_string(struct sreader *r, VARTYPE vt, void **ret)
+{
+    DWORD n, bytes;
+    void *s;
+
+    if (!sread(r, &n, 4)) return E_INVALIDARG;
+    bytes = vt == VT_LPSTR ? n : n * sizeof(WCHAR);
+    if (!n || (vt == VT_LPWSTR && n > 0x7fffffff / sizeof(WCHAR)) || bytes > r->left) return E_INVALIDARG;
+    if (!(s = CoTaskMemAlloc(bytes + sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    sread(r, s, bytes);
+    memset((BYTE *)s + bytes, 0, sizeof(WCHAR));    /* always terminated, whatever the data says */
+    if (!sskip_pad(r, bytes)) { CoTaskMemFree(s); return E_INVALIDARG; }
+    *ret = s;
+    return S_OK;
+}
+
+HRESULT WINAPI StgDeserializePropVariant(const SERIALIZEDPROPERTYVALUE *prop, ULONG cbmax, PROPVARIANT *pv)
+{
+    struct sreader r;
+    DWORD type, n;
+    VARTYPE base;
+    ULONG fixed;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %lu, %p\n", prop, cbmax, pv);
+
+    if (!pv) return E_INVALIDARG;
+    PropVariantInit(pv);
+    if (!prop) return E_INVALIDARG;
+
+    r.p = (const BYTE *)prop;
+    r.left = cbmax;
+    if (!sread(&r, &type, 4) || (type >> 16)) return E_INVALIDARG;
+    base = type & ~VT_VECTOR;
+
+    if (type & VT_VECTOR)
+    {
+        ULONG i;
+        if (!sread(&r, &n, 4)) return E_INVALIDARG;
+        if ((fixed = ser_fixed_size(base)))
+        {
+            if (n > r.left / fixed) return E_INVALIDARG;
+            if (!(pv->caub.pElems = CoTaskMemAlloc(max(n, 1) * fixed))) return E_OUTOFMEMORY;
+            sread(&r, pv->caub.pElems, n * fixed);
+            if (!sskip_pad(&r, n * fixed)) { CoTaskMemFree(pv->caub.pElems); return E_INVALIDARG; }
+        }
+        else if (base == VT_LPSTR || base == VT_LPWSTR)
+        {
+            if (n > r.left / 4) return E_INVALIDARG;
+            if (!(pv->calpstr.pElems = CoTaskMemAlloc(max(n, 1) * sizeof(void *)))) return E_OUTOFMEMORY;
+            for (i = 0; i < n && SUCCEEDED(hr); i++)
+                hr = deser_string(&r, base, (void **)&pv->calpstr.pElems[i]);
+            if (FAILED(hr))
+            {
+                while (i--) CoTaskMemFree(pv->calpstr.pElems[i]);
+                CoTaskMemFree(pv->calpstr.pElems);
+                return hr;
+            }
+        }
+        else return STG_E_INVALIDPARAMETER;
+        pv->caub.cElems = n;
+        pv->vt = type;
+        return S_OK;
+    }
+
+    if (type == VT_EMPTY || type == VT_NULL)
+    {
+    }
+    else if (base == VT_CLSID)
+    {
+        if (!(pv->puuid = CoTaskMemAlloc(sizeof(GUID)))) return E_OUTOFMEMORY;
+        if (!sread(&r, pv->puuid, sizeof(GUID))) { CoTaskMemFree(pv->puuid); return E_INVALIDARG; }
+    }
+    else if ((fixed = ser_fixed_size(base)))
+    {
+        if (!sread(&r, &pv->bVal, fixed) || !sskip_pad(&r, fixed)) return E_INVALIDARG;
+    }
+    else if (base == VT_LPSTR || base == VT_LPWSTR)
+    {
+        if (FAILED(hr = deser_string(&r, base, (void **)&pv->pszVal))) return hr;
+    }
+    else if (base == VT_BLOB)
+    {
+        if (!sread(&r, &n, 4) || n > r.left) return E_INVALIDARG;
+        if (!(pv->blob.pBlobData = CoTaskMemAlloc(max(n, 1)))) return E_OUTOFMEMORY;
+        sread(&r, pv->blob.pBlobData, n);
+        pv->blob.cbSize = n;
+    }
+    else return STG_E_INVALIDPARAMETER;
+
+    pv->vt = type;
+    return S_OK;
+}
