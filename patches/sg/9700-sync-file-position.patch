From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, server: a synchronous file object with no unix fd keeps its position, as the I/O manager does

On Windows the I/O manager itself answers FilePositionInformation for a file object opened for
synchronous I/O, whatever the device: it gets or sets the file object's CurrentByteOffset and the
driver never sees the request. So SetFilePointerEx and the C runtime's lseek() succeed on a pipe or a
console (the device ignores the position). Wine's pipes have no unix fd and the server said
"unsupported info class": Python's tell()/lseek() on a subprocess pipe failed (calibre, Cura).
The server keeps the position of such objects; set_fd_pos_info sets it. Overlapped handles are
unchanged. Gate: test/pipepos-gate.sh. Mutant: SG_MUTANT_NO_SYNC_POSITION.
---
--- a/server/fd.c
+++ b/server/fd.c
@@ -157,6 +157,7 @@
     struct completion   *completion;  /* completion object attached to this fd */
     apc_param_t          comp_key;    /* completion key to set in completion events */
     unsigned int         comp_flags;  /* completion flags */
+    file_pos_t           position;    /* CurrentByteOffset of a synchronous file object with no unix fd */
 };
 
 static void fd_dump( struct object *obj, int verbose );
@@ -1972,6 +1973,7 @@
     fd->map_size   = 0;
     fd->access     = 0;
     fd->options    = 0;
+    fd->position   = 0;
     fd->sharing    = 0;
     fd->unix_fd    = -1;
     fd->unix_name  = NULL;
@@ -2012,6 +2014,7 @@
     fd->map_size   = 0;
     fd->access     = 0;
     fd->options    = options;
+    fd->position   = 0;
     fd->sharing    = 0;
     fd->unix_name  = NULL;
     fd->nt_name    = NULL;
@@ -3253,13 +3256,49 @@
 }
 
 /* query file info */
+/* Stained Glass OS: as on Windows, the I/O manager itself keeps the position (CurrentByteOffset) of a
+ * file object opened for synchronous I/O, whatever the device: querying or setting FilePositionInformation
+ * never reaches the driver, so it works on pipes, consoles and devices too (the device ignores it). Wine's
+ * objects with no unix fd answered "unsupported info class" (Python's tell()/lseek() on a subprocess
+ * pipe: calibre, Cura). Files with a unix fd keep their lseek() position in ntdll. */
+static int fd_keeps_position( struct fd *fd )
+{
+#ifdef SG_MUTANT_NO_SYNC_POSITION
+    return 0;
+#endif
+    return fd->unix_fd == -1 && (fd->options & (FILE_SYNCHRONOUS_IO_ALERT | FILE_SYNCHRONOUS_IO_NONALERT));
+}
+
 DECL_HANDLER(get_file_info)
 {
     struct fd *fd = get_handle_fd_obj( current->process, req->handle, 0 );
 
     if (fd)
     {
-        fd->fd_ops->get_file_info( fd, req->handle, req->info_class );
+        if (req->info_class == FilePositionInformation && fd_keeps_position( fd ))
+        {
+            FILE_POSITION_INFORMATION info;
+            if (get_reply_max_size() < sizeof(info)) set_error( STATUS_INFO_LENGTH_MISMATCH );
+            else
+            {
+                info.CurrentByteOffset.QuadPart = fd->position;
+                set_reply_data( &info, sizeof(info) );
+            }
+        }
+        else fd->fd_ops->get_file_info( fd, req->handle, req->info_class );
+        release_object( fd );
+    }
+}
+
+/* set the position of a synchronous file object with no unix fd (see fd_keeps_position) */
+DECL_HANDLER(set_fd_pos_info)
+{
+    struct fd *fd = get_handle_fd_obj( current->process, req->handle, 0 );
+
+    if (fd)
+    {
+        if (!fd_keeps_position( fd )) set_error( STATUS_BAD_DEVICE_TYPE );
+        else fd->position = req->position;
         release_object( fd );
     }
 }
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -6033,7 +6033,21 @@
             const FILE_POSITION_INFORMATION *info = ptr;
 
             if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )))
+            {
+                /* no unix fd (a pipe, a console): a synchronous file object's position is kept by the
+                 * server, as Windows' I/O manager keeps it (wine-sg 9700) */
+                if (status == STATUS_BAD_DEVICE_TYPE)
+                {
+                    SERVER_START_REQ( set_fd_pos_info )
+                    {
+                        req->handle   = wine_server_obj_handle( handle );
+                        req->position = info->CurrentByteOffset.QuadPart;
+                        status = wine_server_call( req );
+                    }
+                    SERVER_END_REQ;
+                }
                 return set_file_info_status( io, status );
+            }
 
             if (lseek( fd, info->CurrentByteOffset.QuadPart, SEEK_SET ) == (off_t)-1)
                 status = errno_to_status( errno );
