+/* DataTemplate.ExtensionInstance: an attached property compiled x:Bind data templates keep their
+ * IDataTemplateExtension in, on the template's root */
+static struct xaml_property *prop_extension_instance;
+
+static struct xaml_property *extension_instance_prop(void)
+{
+    if (!prop_extension_instance)
+        prop_extension_instance = xaml_property_register( L"Windows.UI.Xaml.DataTemplate", L"ExtensionInstance",
+                                                          L"Windows.UI.Xaml.IDataTemplateExtension", NULL, TRUE, NULL );
+    return prop_extension_instance;
+}
+
+static HRESULT WINAPI data_templ_ExtensionInstanceProperty( struct xfiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    IInspectable_AddRef( (*value = xaml_property_iface( extension_instance_prop() )) );
+    return S_OK;
+}
+
+static HRESULT WINAPI data_templ_GetExtensionInstance( struct xfiface *iface, IInspectable *element, IInspectable **value )
+{
+    struct dobj *obj = dobj_from_inspectable( element );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!obj) return E_INVALIDARG;
+    return dobj_get_value( obj, extension_instance_prop(), value );
+}
+
+static HRESULT WINAPI data_templ_SetExtensionInstance( struct xfiface *iface, IInspectable *element, IInspectable *value )
+{
+    struct dobj *obj = dobj_from_inspectable( element );
+
+    TRACE( "%p, %p\n", element, value );
+#ifdef SG_MUTANT_NO_TEMPLATE_EXTENSION
+    return E_NOTIMPL;
+#endif
+    if (!obj) return E_INVALIDARG;
+    return dobj_set_value( obj, extension_instance_prop(), value );
+}
+
+static const void *data_templ_statics2_vtbl[] =
+{
+    IDataTemplateStatics2_FSTUBS,
+    [IDataTemplateStatics2_ExtensionInstanceProperty] = data_templ_ExtensionInstanceProperty,
+    [IDataTemplateStatics2_GetExtensionInstance] = data_templ_GetExtensionInstance,
+    [IDataTemplateStatics2_SetExtensionInstance] = data_templ_SetExtensionInstance,
+};
+
 static struct xfactory data_templ_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.DataTemplate",
-                                                  { NULL }, { { NULL } }, activate_data_template };
+                                                  { &IID_IDataTemplateStatics2 }, { { data_templ_statics2_vtbl } },
+                                                  activate_data_template };
 static struct xfactory panel_templ_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Controls.ItemsPanelTemplate",
                                                    { NULL }, { { NULL } }, activate_panel_template };
 IActivationFactory *data_template_factory = &data_templ_factory_obj.IActivationFactory_iface;
