diff --git a/dlls/windows.ui.xaml/object.c b/dlls/windows.ui.xaml/object.c
index df2971e..f052c34 100644
--- a/dlls/windows.ui.xaml/object.c
+++ b/dlls/windows.ui.xaml/object.c
@@ -20,6 +20,8 @@
 
 #include <stdlib.h>
 #include "private.h"
