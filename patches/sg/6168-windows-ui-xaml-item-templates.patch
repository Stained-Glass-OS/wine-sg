+/* ---- weak references: IWeakReferenceSource on every object, as C++/WinRT asks for it ---- */
+
+struct xweak
+{
+    IWeakReferenceSource IWeakReferenceSource_iface;    /* the object's: counted on the object */
+    IWeakReference IWeakReference_iface;                /* the holders': counted on the block */
+    LONG refs;                                          /* the holders, and one for the object */
+    struct xobj *obj;                                   /* NULL once it is gone */
+};
+
+static struct xweak *weak_from_source( IWeakReferenceSource *iface )
+{
+    return CONTAINING_RECORD( iface, struct xweak, IWeakReferenceSource_iface );
+}
+
+static struct xweak *weak_from_reference( IWeakReference *iface )
+{
+    return CONTAINING_RECORD( iface, struct xweak, IWeakReference_iface );
+}
+
+static HRESULT WINAPI weak_source_QueryInterface( IWeakReferenceSource *iface, REFIID iid, void **out )
+{
+    struct xweak *weak = weak_from_source( iface );
+    if (!weak->obj) return E_UNEXPECTED;
+    return IUnknown_QueryInterface( weak->obj->outer, iid, out );
+}
+
+static ULONG WINAPI weak_source_AddRef( IWeakReferenceSource *iface )
+{
+    struct xweak *weak = weak_from_source( iface );
+    return weak->obj ? IUnknown_AddRef( weak->obj->outer ) : 1;
+}
+
+static ULONG WINAPI weak_source_Release( IWeakReferenceSource *iface )
+{
+    struct xweak *weak = weak_from_source( iface );
+    return weak->obj ? IUnknown_Release( weak->obj->outer ) : 1;
+}
+
+static HRESULT WINAPI weak_source_GetWeakReference( IWeakReferenceSource *iface, IWeakReference **out )
+{
+    struct xweak *weak = weak_from_source( iface );
+
+    if (!out) return E_POINTER;
+    InterlockedIncrement( &weak->refs );
+    *out = &weak->IWeakReference_iface;
+    return S_OK;
+}
+
+static const IWeakReferenceSourceVtbl weak_source_vtbl =
+{
+    weak_source_QueryInterface, weak_source_AddRef, weak_source_Release, weak_source_GetWeakReference,
+};
+
+static HRESULT WINAPI weak_ref_QueryInterface( IWeakReference *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference ) || IsEqualGUID( iid, &IID_IAgileObject ))
+    {
+        IWeakReference_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI weak_ref_AddRef( IWeakReference *iface )
+{
+    return InterlockedIncrement( &weak_from_reference( iface )->refs );
+}
+
+static ULONG WINAPI weak_ref_Release( IWeakReference *iface )
+{
+    struct xweak *weak = weak_from_reference( iface );
+    ULONG refs = InterlockedDecrement( &weak->refs );
+    if (!refs) free( weak );
+    return refs;
+}
+
+/* Resolve: the object while it lives (its controlling one), else NULL */
+static HRESULT WINAPI weak_ref_Resolve( IWeakReference *iface, REFIID iid, IInspectable **out )
+{
+    struct xweak *weak = weak_from_reference( iface );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+#ifdef SG_MUTANT_XAML_NO_WEAK_RESOLVE
+    return S_OK;
+#endif
+    if (!weak->obj || weak->obj->ref <= 0) return S_OK;
+    return IUnknown_QueryInterface( weak->obj->outer, iid, (void **)out );
+}
+
+static const IWeakReferenceVtbl weak_ref_vtbl =
+{
+    weak_ref_QueryInterface, weak_ref_AddRef, weak_ref_Release, weak_ref_Resolve,
+};
+
+static struct xweak *obj_weak( struct xobj *obj )
+{
+    struct xweak *weak;
+
+    if (obj->weak) return obj->weak;
+    if (!(weak = calloc( 1, sizeof(*weak) ))) return NULL;
+    weak->IWeakReferenceSource_iface.lpVtbl = &weak_source_vtbl;
+    weak->IWeakReference_iface.lpVtbl = &weak_ref_vtbl;
+    weak->refs = 1;
+    weak->obj = obj;
+    obj->weak = weak;
+    return weak;
+}
+
 /* ---- the inner, non-delegating IInspectable ----------------------------- */
 
 static HRESULT WINAPI inner_QueryInterface( IInspectable *iface, REFIID iid, void **out )
@@ -48,6 +161,14 @@ static HRESULT WINAPI inner_QueryInterface( IInspectable *iface, REFIID iid, voi
         IInspectable_AddRef( &obj->IInspectable_inner );
         return S_OK;
     }
+    if (IsEqualGUID( iid, &IID_IWeakReferenceSource ))
+    {
+        struct xweak *weak = obj_weak( obj );
+        if (!weak) return E_OUTOFMEMORY;
+        *out = &weak->IWeakReferenceSource_iface;
+        IUnknown_AddRef( obj->outer );
+        return S_OK;
+    }
     for (i = 0; i < obj->cls->count; i++)
     {
         if (IsEqualGUID( iid, obj->cls->ifaces[i].iid ))
@@ -74,6 +195,12 @@ static ULONG WINAPI inner_Release( IInspectable *iface )
 
     if (!ref)
     {
+        if (obj->weak)
+        {
+            obj->weak->obj = NULL;   /* its weak references resolve to nothing now */
+            IWeakReference_Release( &obj->weak->IWeakReference_iface );
+            obj->weak = NULL;
+        }
         if (obj->cls->destroy) obj->cls->destroy( obj );
         free( obj );
     }
@@ -150,6 +277,7 @@ void xobj_init( struct xobj *obj, const struct xclass *cls, IInspectable *outer
     obj->outer = outer ? (IUnknown *)outer : (IUnknown *)&obj->IInspectable_inner;
     obj->ref = 1;
     obj->cls = cls;
+    obj->weak = NULL;
     for (i = 0; i < cls->count; i++) iface_at( obj, i )->obj = obj;
 }
 
