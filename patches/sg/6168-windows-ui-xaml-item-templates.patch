 WINE_DEFAULT_DEBUG_CHANNEL(xaml);
 
@@ -33,6 +35,117 @@ static struct xiface *iface_at( struct xobj *obj, unsigned int index )
     return (struct xiface *)((char *)obj + obj->cls->ifaces[index].offset);
