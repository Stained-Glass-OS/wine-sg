From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: weak references, DataTemplate extension, conditional XAML blocks, item presenters

NanaZip's address bar suggestions showed as empty highlighted rows; making their items took five fixes, each general. Every XAML object now answers IWeakReferenceSource, so C++/WinRT code holding weak references to elements (compiled x:Bind data templates do) no longer crashes; a weak reference resolves while the object lives and to nothing after. DataTemplate has its ExtensionInstance attached property (SetExtensionInstance/GetExtensionInstance), which compiled data templates set on their root. Compiled XAML's conditional blocks inside an object (a property set only when an API contract is or is not present) are read, the blocks whose condition does not hold being skipped, instead of failing the whole template; a member that cannot be set is now skipped too. ListViewItemPresenter and GridViewItemPresenter in item templates present the item's content, the containers are a type of ours for TemplateBinding, and a control hands its content over to its template's presenter. Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/control.c b/dlls/windows.ui.xaml/control.c
index d3f8840..357f547 100644
--- a/dlls/windows.ui.xaml/control.c
+++ b/dlls/windows.ui.xaml/control.c
@@ -188,6 +188,8 @@ static void content_changed( struct dobj *obj, struct xaml_property *prop, IInsp
     struct uielem *child = uielem_from_inspectable( new_value );
     WCHAR *str;
 
+    TRACE( "%p (kind %d, template %p): content %p, parent %p\n", control, control->kind, control->template_root, child,
+           child ? child->parent : NULL );
     if (control->template_root && control->kind != KIND_PRESENTER) return;   /* its ContentPresenter shows it */
 
     if (child)
@@ -246,9 +248,13 @@ static void apply_template( struct control *control )
     control->template_tried = TRUE;
     dobj_get_value( &control->e.d, prop_template, &template );
     if (!template) return;
+    /* the content is shown by the template's ContentPresenter: it leaves the control first, so that
+     * the presenter can take it */
+#ifndef SG_MUTANT_TEMPLATE_CONTENT_KEPT
+    if (control->child && control->kind != KIND_PRESENTER) set_child( control, NULL, FALSE );
+#endif
     if ((control->template_root = xaml_template_apply( template, &control->e )))
     {
-        /* the content is shown by the template's ContentPresenter now */
         if (control->child) set_child( control, NULL, FALSE );
         if (SUCCEEDED(IUnknown_QueryInterface( control->e.d.obj.outer, &IID_IFrameworkElementOverrides, (void **)&overrides )))
         {
@@ -256,6 +262,14 @@ static void apply_template( struct control *control )
             IInspectable_Release( overrides );
         }
     }
+    else if (control->kind != KIND_PRESENTER && prop_content)
+    {
+        /* no template made: the control shows its content itself again */
+        IInspectable *content = NULL;
+        dobj_get_value( &control->e.d, prop_content, &content );
+        if (content) content_changed( &control->e.d, prop_content, NULL, content );
+        if (content) IInspectable_Release( content );
+    }
     IInspectable_Release( template );
 }
 
