+/***********************************************************************
+ *      sg_embed_key
+ *
+ * Alt+Tab from a framed Linux window: the Tab comes to the frame (its key
+ * grab), but Alt's release would go to the program, which has the X focus,
+ * and the switcher never saw it -- it stayed open until Enter or a click
+ * (David 2026-10-02). From the Tab until Alt is released, the frame has the
+ * whole keyboard.
+ */
+void sg_embed_key( HWND hwnd, XKeyEvent *event )
+{
+    static Window grabbed;
+    KeySym sym;
+
+    if (grabbed && event->type == KeyRelease)
+    {
+        sym = XLookupKeysym( event, 0 );
+        if (sym == XK_Alt_L || sym == XK_Alt_R || sym == XK_Meta_L || sym == XK_Meta_R)
+        {
+            XUngrabKeyboard( event->display, event->time );
+            grabbed = 0;
+        }
+        return;
+    }
+    if (event->type != KeyPress || grabbed || !embed_count || !(event->state & Mod1Mask)) return;
+    if (!sg_embed_is_frame( event->window )) return;
+    sym = XLookupKeysym( event, 0 );
+    if (sym != XK_Tab && sym != XK_ISO_Left_Tab) return;
+#ifndef SG_MUTANT_ALTTAB_NO_GRAB
+    if (XGrabKeyboard( event->display, event->window, False, GrabModeAsync, GrabModeAsync, event->time ) == GrabSuccess)
+        grabbed = event->window;
+#endif
+}
+
 /* the frame holds a program's window (the X focus there is still ours) */
 BOOL sg_embed_has_child( HWND hwnd )
 {
