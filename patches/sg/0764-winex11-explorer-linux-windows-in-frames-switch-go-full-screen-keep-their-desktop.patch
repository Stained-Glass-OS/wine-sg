+/* A program asks a window manager for full screen with a _NET_WM_STATE
+ * message to the root, which the compositor's window manager takes -- and
+ * ignores for a window it no longer manages (YouTube's button in Linux
+ * Firefox did nothing, David 2026-10-02). The message goes to every client
+ * listening for SubstructureNotify on the root as well: on a connection of
+ * its own, this thread hears those about framed windows and says so with
+ * _SG_EMBED_FULLSCREEN on the window, which the frame's thread watches
+ * (sg_embed_event), and in _NET_WM_STATE, which the program waits for. */
+static void *state_thread( void *arg )
+{
+    Display *d = arg;
+    Window root = DefaultRootWindow( d );
+    Atom wm_state = XInternAtom( d, "_NET_WM_STATE", False );
+    Atom fs = XInternAtom( d, "_NET_WM_STATE_FULLSCREEN", False );
+    Atom ours = XInternAtom( d, "_SG_EMBED_FULLSCREEN", False );
+    XEvent ev;
+
+    XSelectInput( d, root, SubstructureNotifyMask );
+    for (;;)
+    {
+        Window r, parent, *children = NULL;
+        unsigned int n;
+        Atom type;
+        int format;
+        unsigned long count, remaining;
+        unsigned char *prop = NULL;
+        long on, now = 0;
+
+        XNextEvent( d, &ev );
+        if (ev.type != ClientMessage || ev.xclient.message_type != wm_state || ev.xclient.format != 32) continue;
+        if ((Atom)ev.xclient.data.l[1] != fs && (Atom)ev.xclient.data.l[2] != fs) continue;
+        /* only a window we framed: its parent is not the root */
+        if (!XQueryTree( d, ev.xclient.window, &r, &parent, &children, &n )) continue;
+        if (children) XFree( children );
+        if (parent == root) continue;
+        if (!XGetWindowProperty( d, ev.xclient.window, ours, 0, 1, False, XA_CARDINAL, &type, &format, &count,
+                                 &remaining, &prop ) && prop && count)
+            now = *(long *)prop;
+        if (prop) XFree( prop );
+        on = ev.xclient.data.l[0] == 2 ? !now : ev.xclient.data.l[0] == 1;   /* toggle, add, remove */
+        XChangeProperty( d, ev.xclient.window, ours, XA_CARDINAL, 32, PropModeReplace, (unsigned char *)&on, 1 );
+        if (on) XChangeProperty( d, ev.xclient.window, wm_state, XA_ATOM, 32, PropModeReplace, (unsigned char *)&fs, 1 );
+        else XChangeProperty( d, ev.xclient.window, wm_state, XA_ATOM, 32, PropModeReplace, NULL, 0 );
+        XFlush( d );
+    }
+    return NULL;
+}
+
+static Display *state_owner;   /* the frame's display, whose server the thread joins */
+
+static void state_thread_start(void)
+{
+    Display *own;
+    pthread_t t;
+    if (!(own = XOpenDisplay( DisplayString( state_owner ) ))) return;
+    if (pthread_create( &t, NULL, state_thread, own )) { XCloseDisplay( own ); return; }
+    pthread_detach( t );
+}
+
+static void start_state_thread( Display *display )
+{
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+    state_owner = display;
+    pthread_once( &once, state_thread_start );
+}
