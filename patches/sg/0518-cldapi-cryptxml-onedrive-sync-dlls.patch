+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * Microsoft's XML digital signature API (cryptxml.h).  OneDrive's
+ * FileSyncClient.dll imports it to verify signed XML; without the module the
+ * client cannot be loaded at all.  Signature verification is not yet
+ * implemented, so the decode/verify entry points report failure rather than
+ * asserting a document is valid.
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(cryptxml);
+
+HRESULT WINAPI CryptXmlOpenToDecode( const void *config, DWORD flags, const void *properties,
+                                     ULONG property_count, const void *encoded, void **crypt_xml )
+{
+    FIXME( "%p %#lx %p %lu %p %p: stub\n", config, flags, properties, property_count,
+           encoded, crypt_xml );
+    if (crypt_xml) *crypt_xml = NULL;
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI CryptXmlClose( void *crypt_xml )
+{
+    TRACE( "%p\n", crypt_xml );
+    return S_OK;
+}
+
+HRESULT WINAPI CryptXmlGetStatus( void *crypt_xml, void *status )
+{
+    FIXME( "%p %p: stub\n", crypt_xml, status );
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI CryptXmlVerifySignature( void *signature, void *key, DWORD flags )
+{
+    FIXME( "%p %p %#lx: stub\n", signature, key, flags );
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI CryptXmlGetDocContext( void *crypt_xml, const void **doc_context )
+{
+    FIXME( "%p %p: stub\n", crypt_xml, doc_context );
+    if (doc_context) *doc_context = NULL;
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI CryptXmlGetSignature( void *crypt_xml, const void **signature )
+{
+    FIXME( "%p %p: stub\n", crypt_xml, signature );
+    if (signature) *signature = NULL;
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI CryptXmlGetReference( void *crypt_xml, const void **reference )
+{
+    FIXME( "%p %p: stub\n", crypt_xml, reference );
+    if (reference) *reference = NULL;
+    return E_NOTIMPL;
+}
