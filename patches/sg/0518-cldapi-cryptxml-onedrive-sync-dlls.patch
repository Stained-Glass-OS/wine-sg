+    FIXME( "%p %p: stub\n", info, params );
+    return E_NOTIMPL;
+}
+
+DWORD WINAPI CfGetPlaceholderStateFromAttributeTag( DWORD attributes, DWORD reparse_tag )
+{
+    TRACE( "%#lx %#lx\n", attributes, reparse_tag );
+    return CF_PLACEHOLDER_STATE_NO_STATES;
+}
+
+HRESULT WINAPI CfGetPlaceholderInfo( HANDLE handle, DWORD info_class, void *buffer,
+                                     DWORD length, DWORD *returned )
