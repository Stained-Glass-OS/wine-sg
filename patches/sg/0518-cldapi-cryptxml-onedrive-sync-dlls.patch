+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * The Windows Cloud Filter API (Files On-Demand placeholders).  This is the
+ * host-side surface a cloud sync provider such as OneDrive's FileSyncFALWB.dll
+ * statically imports.  The filesystem-filter behaviour behind placeholders is
+ * not yet provided; the calls report "not supported" so a provider degrades to
+ * classic full-file sync rather than failing to load.  CfGetPlatformInfo does
+ * report the running Windows build, which a provider reads to decide whether
+ * the Cloud Filter API is present at all.
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(cldapi);
+
+struct CF_PLATFORM_INFO
+{
+    DWORD BuildNumber;
+    DWORD RevisionNumber;
+    DWORD IntegrationNumber;
+};
+
+/* CF_PLACEHOLDER_STATE bit flags */
+#define CF_PLACEHOLDER_STATE_NO_STATES 0x00000000
+
+HRESULT WINAPI CfGetPlatformInfo( struct CF_PLATFORM_INFO *info )
+{
+    RTL_OSVERSIONINFOEXW ver = { .dwOSVersionInfoSize = sizeof(ver) };
+
+    TRACE( "%p\n", info );
+
+    if (!info) return E_INVALIDARG;
+    RtlGetVersion( &ver );
+    info->BuildNumber = ver.dwBuildNumber;
+    info->RevisionNumber = 0;
+    info->IntegrationNumber = 0;
+    return S_OK;
+}
+
+HRESULT WINAPI CfRegisterSyncRoot( const WCHAR *path, const void *registration,
+                                   const void *policies, DWORD flags )
+{
+    FIXME( "%s %p %p %#lx: stub\n", debugstr_w(path), registration, policies, flags );
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI CfUnregisterSyncRoot( const WCHAR *path )
+{
+    FIXME( "%s: stub\n", debugstr_w(path) );
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI CfConnectSyncRoot( const WCHAR *path, const void *callbacks,
+                                  const void *context, DWORD flags, void *key )
+{
+    FIXME( "%s %p %p %#lx %p: stub\n", debugstr_w(path), callbacks, context, flags, key );
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI CfDisconnectSyncRoot( LONGLONG key )
+{
+    FIXME( "%s: stub\n", wine_dbgstr_longlong(key) );
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI CfCreatePlaceholders( const WCHAR *base, void *entries, DWORD count,
+                                     DWORD flags, LONG *processed )
+{
+    FIXME( "%s %p %lu %#lx %p: stub\n", debugstr_w(base), entries, count, flags, processed );
+    if (processed) *processed = 0;
+    return E_NOTIMPL;
+}
+
