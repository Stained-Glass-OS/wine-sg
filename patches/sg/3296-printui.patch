From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 00:35:10 -0700
Subject: [PATCH] printui: delete printer, driver and connection, set default
 printer (3296)

printui.dll's PrintUIEntry now carries out the command line verbs that need
no dialog: /dl (delete a local printer, /n), /dd (delete a driver, /m, /h
architecture, /v version), /dn (delete a printer connection), and /y (make
/n the default printer). Failures are reported in a message box unless /q.
The command parser took the character after a flag such as /q for the
second letter of the previous command (/dl /n x /q became /d with no
subcommand); that is fixed, and the /r and /t option slots, swapped in the
header, are put in the order of the option string.

diff --git a/dlls/printui/Makefile.in b/dlls/printui/Makefile.in
index 7c58c19..2edb8ed 100644
--- a/dlls/printui/Makefile.in
+++ b/dlls/printui/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = printui.dll
-IMPORTS   = shell32
+IMPORTS   = shell32 winspool user32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
diff --git a/dlls/printui/printui.c b/dlls/printui/printui.c
index 13669f0..931db5a 100644
--- a/dlls/printui/printui.c
+++ b/dlls/printui/printui.c
@@ -30,6 +30,7 @@
 #include "winver.h"
 #include "winnls.h"
 #include "shellapi.h"
+#include "winspool.h"
 
 #include "wine/debug.h"
 #include "printui_private.h"
@@ -159,6 +160,8 @@ static BOOL parse_rundll(context_t * cx)
                 }
                 else
                 {
+                    BOOL new_command = FALSE;
+
                     ptr = wcschr(flagsW, c);
                     if (ptr) {
                         index = ptr - flagsW;
@@ -169,6 +172,7 @@ static BOOL parse_rundll(context_t * cx)
                     {
                         cx->command = c;
                         cx->subcommand = '\0';
+                        new_command = TRUE;
                         TRACE(" cmd: %s\n", debugstr_w(txtW));
                     }
 
@@ -180,8 +184,13 @@ static BOOL parse_rundll(context_t * cx)
                     c = get_next_wchar(cx, FALSE);
 
                     /* Some commands use two wchar */
-                    if ((cx->command == 'd') || (cx->command == 'g') || (cx->command == 'i') ||
-                        (cx->command == 'S') || (cx->command == 'X') ){
+#ifdef SG_MUTANT_PRINTUI_PARSE
+                    if (((cx->command == 'd') || (cx->command == 'g') || (cx->command == 'i') ||
+                        (cx->command == 'S') || (cx->command == 'X'))) {
+#else
+                    if (new_command && ((cx->command == 'd') || (cx->command == 'g') || (cx->command == 'i') ||
+                        (cx->command == 'S') || (cx->command == 'X'))) {
+#endif
                         cx->subcommand = c;
                         txtW[0] = c;
                         TRACE(" sub: %s\n", debugstr_w(txtW));
@@ -210,6 +219,78 @@ static BOOL parse_rundll(context_t * cx)
     return TRUE;
 }
 
+/* ################################
+ * report_error() [Internal]
+ *
+ * The user is told of a failed command, unless /q (quiet) was given.
+ */
+static void report_error(context_t *cx, DWORD error)
+{
+    WCHAR text[128];
+
+    TRACE("error %lu\n", error);
+    if (cx->flags[FLAG_Q]) return;
+    swprintf(text, ARRAY_SIZE(text), L"Operation could not be completed (error 0x%08lx).", error);
+    MessageBoxW(cx->hWnd, text, L"Printer", MB_OK | MB_ICONERROR);
+}
+
+/* the printer name argument (/n), or NULL */
+static LPWSTR printer_name(context_t *cx)
+{
+    return cx->options[OPT_N] && cx->options[OPT_N][0] ? cx->options[OPT_N] : NULL;
+}
+
+/* /dl: delete a local printer */
+static DWORD delete_local_printer(context_t *cx)
+{
+    PRINTER_DEFAULTSW defaults = { NULL, NULL, PRINTER_ALL_ACCESS };
+    LPWSTR name = printer_name(cx);
+    HANDLE printer;
+    DWORD error = ERROR_SUCCESS;
+
+    if (!name) return ERROR_INVALID_PARAMETER;
+    if (!OpenPrinterW(name, &printer, &defaults)) return GetLastError();
+#ifndef SG_MUTANT_PRINTUI_DL
+    if (!DeletePrinter(printer)) error = GetLastError();
+#endif
+    ClosePrinter(printer);
+    return error;
+}
+
+/* /dd: delete a printer driver (/m model, /h architecture, /v version) */
+static DWORD delete_driver(context_t *cx)
+{
+    LPWSTR model = cx->options[OPT_M], arch = cx->options[OPT_H], env = NULL;
+    DWORD version = 3;
+
+    if (!model || !model[0]) return ERROR_INVALID_PARAMETER;
+#ifdef SG_MUTANT_PRINTUI_ARCH
+    if (0)
+#else
+    if (arch && arch[0])
+#endif
+    {
+        if (!wcsicmp(arch, L"x86") || !wcsicmp(arch, L"Intel")) env = (LPWSTR)L"Windows NT x86";
+        else if (!wcsicmp(arch, L"x64") || !wcsicmp(arch, L"AMD64")) env = (LPWSTR)L"Windows x64";
+        else if (!wcsicmp(arch, L"Itanium") || !wcsicmp(arch, L"IA64")) env = (LPWSTR)L"Windows IA64";
+        else return ERROR_INVALID_ENVIRONMENT;
+    }
+    if (cx->options[OPT_V] && cx->options[OPT_V][0])
+    {
+        /* "3", "Type 3", "Type 3 - User Mode": the version is the digit */
+        LPWSTR p = cx->options[OPT_V];
+        while (*p && (*p < '0' || *p > '9')) p++;
+        if (!*p) return ERROR_INVALID_PARAMETER;
+        version = *p - '0';
+        /* the spooler keeps one driver version per environment (3) */
+#ifndef SG_MUTANT_PRINTUI_VER
+        if (version != 3) return ERROR_UNKNOWN_PRINTER_DRIVER;
+#endif
+    }
+    if (!DeletePrinterDriverExW(NULL, env, model, 0, 0)) return GetLastError();
+    return ERROR_SUCCESS;
+}
+
 /*****************************************************
  *  PrintUIEntryW                [printui.@]
  *  Commandline-Interface for using printui.dll with rundll32.exe
@@ -235,8 +316,29 @@ void WINAPI PrintUIEntryW(HWND hWnd, HINSTANCE hInst, LPCWSTR pCommand, DWORD nC
     }
 
     if (res && cx.command) {
+        DWORD error = ERROR_SUCCESS;
+
         switch (cx.command)
         {
+            case 'd':
+                switch (cx.subcommand)
+                {
+                    case 'l':   /* delete a local printer */
+                        error = delete_local_printer(&cx);
+                        break;
+                    case 'n':   /* delete a printer connection */
+                        if (!printer_name(&cx)) error = ERROR_INVALID_PARAMETER;
+                        else if (!DeletePrinterConnectionW(printer_name(&cx))) error = GetLastError();
+                        break;
+                    case 'd':   /* delete a printer driver */
+                        error = delete_driver(&cx);
+                        break;
+                    default:
+                        FIXME("command not implemented: /d%c\n", cx.subcommand);
+                        error = ERROR_CALL_NOT_IMPLEMENTED;
+                }
+                if (error) report_error(&cx, error);
+                break;
 
             default:
             {
@@ -249,7 +351,16 @@ void WINAPI PrintUIEntryW(HWND hWnd, HINSTANCE hInst, LPCWSTR pCommand, DWORD nC
         }
     }
 
-    if ((res == FALSE) || (cx.command == '\0')) {
+    if (res && !cx.command && cx.flags[FLAG_Y])
+    {
+        /* /y alone: make the printer given by /n the default printer */
+        LPWSTR name = printer_name(&cx);
+        if (!name) report_error(&cx, ERROR_INVALID_PARAMETER);
+#ifndef SG_MUTANT_PRINTUI_DEFAULT
+        else if (!SetDefaultPrinterW(name)) report_error(&cx, GetLastError());
+#endif
+    }
+    else if ((res == FALSE) || (cx.command == '\0')) {
         FIXME("dialog: Printer / The operation was not successful\n");
     }
 
