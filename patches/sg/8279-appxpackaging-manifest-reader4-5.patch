From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxpackaging: IAppxManifestReader4 and IAppxManifestReader5

A manifest reader is also an IAppxManifestReader4 and an IAppxManifestReader5. GetOptionalPackageInfo says whether the package is an optional one -- it names its main package in a MainPackageDependency -- and which; GetMainPackageDependencies enumerates those dependencies with their name, publisher and package family name. Interfaces and IIDs as the MSIX SDK's AppxPackaging.hpp (MIT) declares them.
---
--- a/include/appxpackaging.idl
+++ b/include/appxpackaging.idl
@@ -483,6 +483,63 @@
     HRESULT GetTargetDeviceFamilies([out, retval] IAppxManifestTargetDeviceFamiliesEnumerator **target_device_families);
 }
 
+/* Stained Glass OS (8279): IAppxManifestReader4/5 and their objects, as the MSIX SDK's
+ * AppxPackaging.hpp (MIT) declares them */
+[
+    object,
+    uuid(2634847d-5b5d-4fe5-a243-002ff95edc7e),
+    local
+]
+interface IAppxManifestOptionalPackageInfo : IUnknown
+{
+    HRESULT GetIsOptionalPackage([out, retval] BOOL *is_optional_package);
+    HRESULT GetMainPackageName([out, retval, string] LPWSTR *main_package_name);
+}
+
+[
+    object,
+    uuid(05d0611c-bc29-46d5-97e2-84b9c79bd8ae),
+    local
+]
+interface IAppxManifestMainPackageDependency : IUnknown
+{
+    HRESULT GetName([out, retval, string] LPWSTR *name);
+    HRESULT GetPublisher([out, retval, string] LPWSTR *publisher);
+    HRESULT GetPackageFamilyName([out, retval, string] LPWSTR *package_family_name);
+}
+
+[
+    object,
+    uuid(a99c4f00-51d2-4f0f-ba46-7ed5255ebdff),
+    local
+]
+interface IAppxManifestMainPackageDependenciesEnumerator : IUnknown
+{
+    HRESULT GetCurrent([out, retval] IAppxManifestMainPackageDependency **main_package_dependency);
+    HRESULT GetHasCurrent([out, retval] BOOL *has_current);
+    HRESULT MoveNext([out, retval] BOOL *has_next);
+}
+
+[
+    object,
+    uuid(4579bb7c-741d-4161-b5a1-47bd3b78ad9b),
+    local
+]
+interface IAppxManifestReader4 : IAppxManifestReader3
+{
+    HRESULT GetOptionalPackageInfo([out, retval] IAppxManifestOptionalPackageInfo **optional_package_info);
+}
+
+[
+    object,
+    uuid(8d7ae132-a690-4c00-b75a-6aae1feaac80),
+    local
+]
+interface IAppxManifestReader5 : IUnknown
+{
+    HRESULT GetMainPackageDependencies([out, retval] IAppxManifestMainPackageDependenciesEnumerator **main_package_dependencies);
+}
+
