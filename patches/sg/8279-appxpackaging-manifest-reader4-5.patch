-static const IAppxManifestReader3Vtbl reader3_vtbl =
+/* ---- IAppxManifestReader4 / IAppxManifestReader5 (wine-sg 8279) ------------ */
+
+static WCHAR *wcsdup_co( const WCHAR *str )
+{
+    SIZE_T len = (wcslen( str ) + 1) * sizeof(WCHAR);
+    WCHAR *ret = CoTaskMemAlloc( len );
+    if (ret) memcpy( ret, str, len );
+    return ret;
+}
+
+struct optional_info
+{
+    IAppxManifestOptionalPackageInfo IAppxManifestOptionalPackageInfo_iface;
+    LONG ref;
+    WCHAR *main_name;   /* NULL: not an optional package */
+};
+
+static inline struct optional_info *impl_from_IAppxManifestOptionalPackageInfo( IAppxManifestOptionalPackageInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct optional_info, IAppxManifestOptionalPackageInfo_iface );
+}
+
+static HRESULT WINAPI optional_QueryInterface( IAppxManifestOptionalPackageInfo *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxManifestOptionalPackageInfo ))
+    {
+        *out = iface;
+        IAppxManifestOptionalPackageInfo_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI optional_AddRef( IAppxManifestOptionalPackageInfo *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxManifestOptionalPackageInfo( iface )->ref );
+}
+
+static ULONG WINAPI optional_Release( IAppxManifestOptionalPackageInfo *iface )
+{
+    struct optional_info *info = impl_from_IAppxManifestOptionalPackageInfo( iface );
+    ULONG ref = InterlockedDecrement( &info->ref );
+    if (!ref)
+    {
+        free( info->main_name );
+        free( info );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI optional_GetIsOptionalPackage( IAppxManifestOptionalPackageInfo *iface, BOOL *optional )
+{
+    if (!optional) return E_POINTER;
+    *optional = impl_from_IAppxManifestOptionalPackageInfo( iface )->main_name != NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI optional_GetMainPackageName( IAppxManifestOptionalPackageInfo *iface, LPWSTR *name )
+{
+    struct optional_info *info = impl_from_IAppxManifestOptionalPackageInfo( iface );
+
+    if (!name) return E_POINTER;
+    *name = NULL;
+    if (!info->main_name) return S_OK;   /* not an optional package: no main package */
+    return (*name = wcsdup_co( info->main_name )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static const IAppxManifestOptionalPackageInfoVtbl optional_vtbl =
+{
+    optional_QueryInterface,
+    optional_AddRef,
+    optional_Release,
+    optional_GetIsOptionalPackage,
+    optional_GetMainPackageName,
+};
+
+static HRESULT WINAPI reader4_GetOptionalPackageInfo( IAppxManifestReader4 *iface, IAppxManifestOptionalPackageInfo **out )
+{
+    struct manifest *m = CONTAINING_RECORD( iface, struct manifest, IAppxManifestReader3_iface );
+    struct optional_info *info;
+
+    TRACE( "iface %p, out %p.\n", iface, out );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(info = calloc( 1, sizeof(*info) ))) return E_OUTOFMEMORY;
+    info->IAppxManifestOptionalPackageInfo_iface.lpVtbl = &optional_vtbl;
+    info->ref = 1;
+    /* an optional package names its main package in a MainPackageDependency */
+    if (m->main_count && !(info->main_name = wcsdup( m->mains[0].name )))
+    {
+        free( info );
+        return E_OUTOFMEMORY;
+    }
+    *out = &info->IAppxManifestOptionalPackageInfo_iface;
+    return S_OK;
+}
+
+struct main_dep
+{
+    IAppxManifestMainPackageDependency IAppxManifestMainPackageDependency_iface;
+    LONG ref;
+    WCHAR *name, *publisher;
+};
+
+static inline struct main_dep *impl_from_IAppxManifestMainPackageDependency( IAppxManifestMainPackageDependency *iface )
+{
+    return CONTAINING_RECORD( iface, struct main_dep, IAppxManifestMainPackageDependency_iface );
+}
+
+static HRESULT WINAPI main_dep_QueryInterface( IAppxManifestMainPackageDependency *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxManifestMainPackageDependency ))
+    {
+        *out = iface;
+        IAppxManifestMainPackageDependency_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI main_dep_AddRef( IAppxManifestMainPackageDependency *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxManifestMainPackageDependency( iface )->ref );
+}
+
+static ULONG WINAPI main_dep_Release( IAppxManifestMainPackageDependency *iface )
+{
+    struct main_dep *dep = impl_from_IAppxManifestMainPackageDependency( iface );
+    ULONG ref = InterlockedDecrement( &dep->ref );
+    if (!ref)
+    {
+        free( dep->name );
+        free( dep->publisher );
+        free( dep );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI main_dep_GetName( IAppxManifestMainPackageDependency *iface, LPWSTR *name )
+{
+    if (!name) return E_POINTER;
+    return (*name = wcsdup_co( impl_from_IAppxManifestMainPackageDependency( iface )->name )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI main_dep_GetPublisher( IAppxManifestMainPackageDependency *iface, LPWSTR *publisher )
+{
+    struct main_dep *dep = impl_from_IAppxManifestMainPackageDependency( iface );
+
+    if (!publisher) return E_POINTER;
+    *publisher = NULL;
+    if (!dep->publisher) return S_OK;   /* the attribute is optional */
+    return (*publisher = wcsdup_co( dep->publisher )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI main_dep_GetPackageFamilyName( IAppxManifestMainPackageDependency *iface, LPWSTR *family )
+{
+    struct main_dep *dep = impl_from_IAppxManifestMainPackageDependency( iface );
+    WCHAR pub[14];
+    SIZE_T len;
+    HRESULT hr;
+
+    if (!family) return E_POINTER;
+    *family = NULL;
+    if (!dep->publisher) return S_OK;   /* no publisher: no family name to make */
+    if (FAILED(hr = publisher_id( dep->publisher, pub ))) return hr;
+    len = wcslen( dep->name ) + 16;
+    if (!(*family = CoTaskMemAlloc( len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    swprintf( *family, len, L"%s_%s", dep->name, pub );
+    return S_OK;
+}
+
+static const IAppxManifestMainPackageDependencyVtbl main_dep_vtbl =
+{
+    main_dep_QueryInterface,
+    main_dep_AddRef,
+    main_dep_Release,
+    main_dep_GetName,
+    main_dep_GetPublisher,
+    main_dep_GetPackageFamilyName,
+};
+
+struct main_deps
+{
+    IAppxManifestMainPackageDependenciesEnumerator IAppxManifestMainPackageDependenciesEnumerator_iface;
+    LONG ref;
+    IAppxManifestReader *manifest;   /* kept alive for its list */
+    unsigned int pos;
+};
+
+static inline struct main_deps *impl_from_IAppxManifestMainPackageDependenciesEnumerator( IAppxManifestMainPackageDependenciesEnumerator *iface )
+{
+    return CONTAINING_RECORD( iface, struct main_deps, IAppxManifestMainPackageDependenciesEnumerator_iface );
+}
+
+static HRESULT WINAPI main_deps_QueryInterface( IAppxManifestMainPackageDependenciesEnumerator *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxManifestMainPackageDependenciesEnumerator ))
+    {
+        *out = iface;
+        IAppxManifestMainPackageDependenciesEnumerator_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI main_deps_AddRef( IAppxManifestMainPackageDependenciesEnumerator *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxManifestMainPackageDependenciesEnumerator( iface )->ref );
+}
+
+static ULONG WINAPI main_deps_Release( IAppxManifestMainPackageDependenciesEnumerator *iface )
+{
+    struct main_deps *e = impl_from_IAppxManifestMainPackageDependenciesEnumerator( iface );
+    ULONG ref = InterlockedDecrement( &e->ref );
+    if (!ref)
+    {
+        IAppxManifestReader_Release( e->manifest );
+        free( e );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI main_deps_GetCurrent( IAppxManifestMainPackageDependenciesEnumerator *iface,
+                                            IAppxManifestMainPackageDependency **out )
+{
+    struct main_deps *e = impl_from_IAppxManifestMainPackageDependenciesEnumerator( iface );
+    struct manifest *m = impl_from_IAppxManifestReader( e->manifest );
+    struct main_dep *dep;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (e->pos >= m->main_count) return E_BOUNDS;
+    if (!(dep = calloc( 1, sizeof(*dep) ))) return E_OUTOFMEMORY;
+    dep->IAppxManifestMainPackageDependency_iface.lpVtbl = &main_dep_vtbl;
+    dep->ref = 1;
+    dep->name = wcsdup( m->mains[e->pos].name );
+    dep->publisher = m->mains[e->pos].publisher ? wcsdup( m->mains[e->pos].publisher ) : NULL;
+    if (!dep->name || (m->mains[e->pos].publisher && !dep->publisher))
+    {
+        IAppxManifestMainPackageDependency_Release( &dep->IAppxManifestMainPackageDependency_iface );
+        return E_OUTOFMEMORY;
+    }
+    *out = &dep->IAppxManifestMainPackageDependency_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI main_deps_GetHasCurrent( IAppxManifestMainPackageDependenciesEnumerator *iface, BOOL *has )
+{
+    struct main_deps *e = impl_from_IAppxManifestMainPackageDependenciesEnumerator( iface );
+
+    if (!has) return E_POINTER;
+    *has = e->pos < impl_from_IAppxManifestReader( e->manifest )->main_count;
+    return S_OK;
+}
+
+static HRESULT WINAPI main_deps_MoveNext( IAppxManifestMainPackageDependenciesEnumerator *iface, BOOL *has )
+{
+    struct main_deps *e = impl_from_IAppxManifestMainPackageDependenciesEnumerator( iface );
+    unsigned int count = impl_from_IAppxManifestReader( e->manifest )->main_count;
+
+    if (!has) return E_POINTER;
+    if (e->pos < count) e->pos++;
+    *has = e->pos < count;
+    return S_OK;
+}
+
+static const IAppxManifestMainPackageDependenciesEnumeratorVtbl main_deps_vtbl =
+{
+    main_deps_QueryInterface,
+    main_deps_AddRef,
+    main_deps_Release,
+    main_deps_GetCurrent,
+    main_deps_GetHasCurrent,
+    main_deps_MoveNext,
+};
+
+static inline struct manifest *impl_from_IAppxManifestReader5( IAppxManifestReader5 *iface )
+{
+    return CONTAINING_RECORD( iface, struct manifest, IAppxManifestReader5_iface );
+}
+
+static HRESULT WINAPI reader5_QueryInterface( IAppxManifestReader5 *iface, REFIID iid, void **out )
+{
+    return manifest_QueryInterface( &impl_from_IAppxManifestReader5( iface )->IAppxManifestReader_iface, iid, out );
+}
+
+static ULONG WINAPI reader5_AddRef( IAppxManifestReader5 *iface )
+{
+    return manifest_AddRef( &impl_from_IAppxManifestReader5( iface )->IAppxManifestReader_iface );
+}
+
+static ULONG WINAPI reader5_Release( IAppxManifestReader5 *iface )
+{
+    return manifest_Release( &impl_from_IAppxManifestReader5( iface )->IAppxManifestReader_iface );
+}
+
+static HRESULT WINAPI reader5_GetMainPackageDependencies( IAppxManifestReader5 *iface,
+                                                          IAppxManifestMainPackageDependenciesEnumerator **out )
+{
+    struct manifest *m = impl_from_IAppxManifestReader5( iface );
+    struct main_deps *e;
+
+    TRACE( "iface %p, out %p.\n", iface, out );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(e = calloc( 1, sizeof(*e) ))) return E_OUTOFMEMORY;
+    e->IAppxManifestMainPackageDependenciesEnumerator_iface.lpVtbl = &main_deps_vtbl;
+    e->ref = 1;
+    e->manifest = &m->IAppxManifestReader_iface;
+    IAppxManifestReader_AddRef( e->manifest );
+    *out = &e->IAppxManifestMainPackageDependenciesEnumerator_iface;
+    return S_OK;
+}
+
+static const IAppxManifestReader5Vtbl reader5_vtbl =
+{
+    reader5_QueryInterface,
+    reader5_AddRef,
+    reader5_Release,
+    reader5_GetMainPackageDependencies,
+};
