+/* the objects of the container: the control */
+struct enum_unknown
+{
+    IEnumUnknown IEnumUnknown_iface;
+    LONG ref;
+    IUnknown *objects[1];
+    ULONG count, pos;
+};
+
+static inline struct enum_unknown *impl_from_IEnumUnknown(IEnumUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_unknown, IEnumUnknown_iface);
+}
+
+static HRESULT WINAPI EnumUnknown_QueryInterface(IEnumUnknown *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumUnknown))
+    {
+        *ppv = iface;
+        IEnumUnknown_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EnumUnknown_AddRef(IEnumUnknown *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumUnknown(iface)->ref);
+}
+
+static ULONG WINAPI EnumUnknown_Release(IEnumUnknown *iface)
+{
+    struct enum_unknown *This = impl_from_IEnumUnknown(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    ULONG i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) IUnknown_Release(This->objects[i]);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI EnumUnknown_Next(IEnumUnknown *iface, ULONG celt, IUnknown **rgelt, ULONG *fetched)
+{
+    struct enum_unknown *This = impl_from_IEnumUnknown(iface);
+    ULONG n = 0;
+
+    if (!rgelt || (!fetched && celt != 1)) return E_POINTER;
+    while (n < celt && This->pos < This->count)
+    {
+        rgelt[n] = This->objects[This->pos++];
+        IUnknown_AddRef(rgelt[n]);
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumUnknown_Skip(IEnumUnknown *iface, ULONG celt)
+{
+    struct enum_unknown *This = impl_from_IEnumUnknown(iface);
+
+    if (celt > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumUnknown_Reset(IEnumUnknown *iface)
+{
+    impl_from_IEnumUnknown(iface)->pos = 0;
+    return S_OK;
+}
+
+static const IEnumUnknownVtbl EnumUnknown_vtbl;
+
+static HRESULT enum_unknown_create(IUnknown *object, ULONG pos, IEnumUnknown **ret)
+{
+    struct enum_unknown *This;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->IEnumUnknown_iface.lpVtbl = &EnumUnknown_vtbl;
+    This->ref = 1;
+    if (object)
+    {
+        This->objects[0] = object;
+        IUnknown_AddRef(object);
+        This->count = 1;
+    }
+    This->pos = pos;
+    *ret = &This->IEnumUnknown_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumUnknown_Clone(IEnumUnknown *iface, IEnumUnknown **ret)
+{
+    struct enum_unknown *This = impl_from_IEnumUnknown(iface);
+
+    if (!ret) return E_POINTER;
+    return enum_unknown_create(This->count ? This->objects[0] : NULL, This->pos, ret);
+}
+
+static const IEnumUnknownVtbl EnumUnknown_vtbl =
+{
+    EnumUnknown_QueryInterface, EnumUnknown_AddRef, EnumUnknown_Release,
+    EnumUnknown_Next, EnumUnknown_Skip, EnumUnknown_Reset, EnumUnknown_Clone,
+};
