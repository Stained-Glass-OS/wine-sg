+static HRESULT WINAPI OleControlSite_TransformCoords( IOleControlSite* iface, POINTL* pPtlHimetric, POINTF* pPtfContainer, DWORD dwFlags)
 {
-    FIXME( "\n" );
-    return E_NOTIMPL;
+    HDC hdc;
+    int dpi_x, dpi_y;
+    float x, y;
+
+    TRACE( "(%p,%p,%p,%lx)\n", iface, pPtlHimetric, pPtfContainer, dwFlags );
+
+    if (!pPtlHimetric || !pPtfContainer) return E_INVALIDARG;
+    if ((dwFlags & (XFORMCOORDS_HIMETRICTOCONTAINER | XFORMCOORDS_CONTAINERTOHIMETRIC)) == 0) return E_INVALIDARG;
+
+    hdc = GetDC( NULL );
+    dpi_x = GetDeviceCaps( hdc, LOGPIXELSX );
+    dpi_y = GetDeviceCaps( hdc, LOGPIXELSY );
+    ReleaseDC( NULL, hdc );
+
+    /* the container's units are pixels; a hundredth of a millimeter is 1/2540 of an inch */
+    if (dwFlags & XFORMCOORDS_HIMETRICTOCONTAINER)
+    {
+        x = (float)pPtlHimetric->x * dpi_x / 2540.0f;
+        y = (float)pPtlHimetric->y * dpi_y / 2540.0f;
+        pPtfContainer->x = x;
+        pPtfContainer->y = y;
+    }
+    else
+    {
+        pPtlHimetric->x = (LONG)(pPtfContainer->x * 2540.0f / dpi_x + (pPtfContainer->x < 0 ? -0.5f : 0.5f));
+        pPtlHimetric->y = (LONG)(pPtfContainer->y * 2540.0f / dpi_y + (pPtfContainer->y < 0 ? -0.5f : 0.5f));
+    }
+    return S_OK;
 }
