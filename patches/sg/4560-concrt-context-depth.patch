+DEFINE_THISCALL_WRAPPER(_Context_ctor, 8)
+_Context* __thiscall _Context_ctor(_Context *this, Context *context)
+{
+    TRACE("(%p %p)\n", this, context);
+    this->context = context;
+    return this;
+}
+
+/* ??_F_Context@details@Concurrency@@QAEXXZ */
+/* ??_F_Context@details@Concurrency@@QEAAXXZ */
+/* the default constructor closure: no context */
+DEFINE_THISCALL_WRAPPER(_Context_default_ctor, 4)
+void __thiscall _Context_default_ctor(_Context *this)
+{
+#ifdef SG_MUTANT_CONTEXT_CLOSURE_CURRENT
+    this->context = Context_CurrentContext();
+    return;
+#endif
+    _Context_ctor(this, NULL);
+}
