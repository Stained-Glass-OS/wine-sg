+/* ?_GetCurrentInlineDepth@_StackGuard@details@Concurrency@@CAAEA_KXZ */
+/* the depth of chores the current context runs inline, which the
+ * _StackGuard objects of the headers count up and down */
+size_t* __cdecl _StackGuard__GetCurrentInlineDepth(void)
+{
+    static size_t unknown_depth;
+    ExternalContextBase *ctx = (ExternalContextBase*)get_current_context();
+
+    TRACE("()\n");
+
+    if (ctx->context.vtable != &ExternalContextBase_vtable) {
+        ERR("unknown context set\n");
+        return &unknown_depth;
+    }
+#ifdef SG_MUTANT_INLINE_DEPTH_SHARED
+    return &unknown_depth;
+#endif
+    return &ctx->inline_depth;
+}
 #endif
 
