From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: RestartDialogEx shows the caller's reason (6072)

The reason was ignored (FIXME); the confirmation now shows it before the
question. shelldialogs test extended.
---
diff --git a/dlls/shell32/dialogs.c b/dlls/shell32/dialogs.c
index 29b99e0..fb30da8 100644
--- a/dlls/shell32/dialogs.c
+++ b/dlls/shell32/dialogs.c
@@ -686,14 +686,24 @@ void WINAPI RunFileDlgAW(
  *
  * Put up a confirm box, return TRUE if the user confirmed
  */
-static BOOL ConfirmDialog(HWND hWndOwner, UINT PromptId, UINT TitleId)
+static BOOL ConfirmDialog(HWND hWndOwner, const WCHAR *reason, UINT PromptId, UINT TitleId)
 {
   WCHAR Prompt[256];
   WCHAR Title[256];
+  WCHAR *text = Prompt;
+  BOOL ret;
 
   LoadStringW(shell32_hInstance, PromptId, Prompt, ARRAY_SIZE(Prompt));
   LoadStringW(shell32_hInstance, TitleId, Title, ARRAY_SIZE(Title));
-  return MessageBoxW(hWndOwner, Prompt, Title, MB_YESNO|MB_ICONQUESTION) == IDYES;
+  /* the caller's reason comes first, then the question */
+#ifndef SG_MUTANT_RESTART_NO_REASON
+  if (reason && *reason && (text = malloc((wcslen(reason) + wcslen(Prompt) + 3) * sizeof(WCHAR))))
+      swprintf(text, wcslen(reason) + wcslen(Prompt) + 3, L"%s\n\n%s", reason, Prompt);
+  if (!text) text = Prompt;
+#endif
+  ret = MessageBoxW(hWndOwner, text, Title, MB_YESNO|MB_ICONQUESTION) == IDYES;
+  if (text != Prompt) free(text);
+  return ret;
 }
 
 
@@ -705,8 +715,7 @@ int WINAPI RestartDialogEx(HWND hWndOwner, LPCWSTR lpwstrReason, DWORD uFlags, D
 {
     TRACE("(%p)\n", hWndOwner);
 
-    /* FIXME: use lpwstrReason */
-    if (ConfirmDialog(hWndOwner, IDS_RESTART_PROMPT, IDS_RESTART_TITLE))
+    if (ConfirmDialog(hWndOwner, lpwstrReason, IDS_RESTART_PROMPT, IDS_RESTART_TITLE))
     {
         HANDLE hToken;
         TOKEN_PRIVILEGES npr;
@@ -747,7 +756,7 @@ void WINAPI ExitWindowsDialog (HWND hWndOwner)
 {
     TRACE("(%p)\n", hWndOwner);
 
-    if (ConfirmDialog(hWndOwner, IDS_SHUTDOWN_PROMPT, IDS_SHUTDOWN_TITLE))
+    if (ConfirmDialog(hWndOwner, NULL, IDS_SHUTDOWN_PROMPT, IDS_SHUTDOWN_TITLE))
     {
         HANDLE hToken;
         TOKEN_PRIVILEGES npr;
diff --git a/dlls/shell32/tests/shelldialogs.c b/dlls/shell32/tests/shelldialogs.c
index df0220e..fa91967 100644
--- a/dlls/shell32/tests/shelldialogs.c
+++ b/dlls/shell32/tests/shelldialogs.c
@@ -55,6 +55,8 @@ struct run
     UINT drive;
 };
 
+static int (WINAPI *pRestartDialogEx)(HWND, const WCHAR *, DWORD, DWORD);
+
 static DWORD WINAPI run_thread(void *param)
 {
     struct run *r = param;
@@ -65,6 +67,7 @@ static DWORD WINAPI run_thread(void *param)
     case 0: r->result.pick = PickIconDlg(NULL, r->path, ARRAY_SIZE(r->path), &r->index); break;
     case 1: r->result.hr = SHMultiFileProperties(r->data, 0); break;
     case 2: r->result.fmt = SHFormatDrive(NULL, r->drive, 0xffff, 0); break;
+    case 3: r->result.pick = pRestartDialogEx(NULL, L"The settings take effect after a restart.", EWX_REBOOT, 0); break;
     }
     CoUninitialize();
     return 0;
@@ -137,6 +140,30 @@ static UINT count_icons(const WCHAR *path)
     return n == ~0u ? 0 : n;
 }
 
+/* RestartDialogEx shows the caller's reason before its question; "No" restarts nothing */
+static void test_restart_reason(void)
+{
+    struct run r = {0};
+    WCHAR text[512];
+    HWND box;
+
+    pRestartDialogEx = (void *)GetProcAddress(GetModuleHandleA("shell32.dll"), MAKEINTRESOURCEA(730));
+    ok(pRestartDialogEx != NULL, "no RestartDialogEx\n");
+    if (!pRestartDialogEx) return;
+    start_run(&r, 3);
+    box = wait_dialog(&r, NULL, NULL);
+    ok(box != NULL, "no confirmation\n");
+    if (box)
+    {
+        GetDlgItemTextW(box, 0xffff, text, ARRAY_SIZE(text));
+        ok(!wcsncmp(text, L"The settings take effect after a restart.", 41), "text %s\n", wine_dbgstr_w(text));
+        ok(wcslen(text) > 45, "no question after the reason: %s\n", wine_dbgstr_w(text));
+        press_async(box, IDNO);
+    }
+    finish_run(&r);
+    ok(r.result.pick == 0, "got %d\n", r.result.pick);
+}
+
 static void test_pickicon(void)
 {
     static const WCHAR shell32_path[] = L"%SystemRoot%\\system32\\shell32.dll";
@@ -681,6 +708,7 @@ START_TEST(shelldialogs)
     test_pickicon();
     test_multi_properties();
     test_format();
+    test_restart_reason();
 
     {
         WCHAR from[MAX_PATH + 2] = {0};
