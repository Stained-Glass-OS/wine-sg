+static const BYTE heif_magic_hevc[] = {'f','t','y','p','h','e','v','c'};
+static const BYTE heif_magic_hevx[] = {'f','t','y','p','h','e','v','x'};
+static const BYTE heif_magic_heim[] = {'f','t','y','p','h','e','i','m'};
