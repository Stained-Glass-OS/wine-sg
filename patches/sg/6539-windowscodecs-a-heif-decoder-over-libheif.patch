     {   &CLSID_WICPngDecoder,
 	"The Wine Project",
 	"PNG Decoder",
diff --git a/dlls/windowscodecs/unixlib.c b/dlls/windowscodecs/unixlib.c
new file mode 100644
index 0000000..37d9d5a
--- /dev/null
+++ b/dlls/windowscodecs/unixlib.c
@@ -0,0 +1,218 @@
+/*
+ * HEIF/HEIC images through libheif, loaded at run time (wine-sg 6539)
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wincodecs);
+
+/* the parts of libheif's API used here (libheif 1.x, LGPL) */
+struct heif_context;
+struct heif_image_handle;
+struct heif_image;
+struct heif_error
+{
+    int code;           /* 0: ok */
+    int subcode;
+    const char *message;
+};
+#define HEIF_COLORSPACE_RGB          1
+#define HEIF_CHROMA_INTERLEAVED_RGBA 11
+#define HEIF_CHANNEL_INTERLEAVED     10
+
+static void *libheif;
+static struct heif_error (*p_heif_init)( void * );
+static struct heif_context *(*p_heif_context_alloc)( void );
+static void (*p_heif_context_free)( struct heif_context * );
+static struct heif_error (*p_heif_context_read_from_memory_without_copy)( struct heif_context *, const void *, size_t, const void * );
+static struct heif_error (*p_heif_context_get_primary_image_handle)( struct heif_context *, struct heif_image_handle ** );
+static void (*p_heif_image_handle_release)( const struct heif_image_handle * );
+static int (*p_heif_image_handle_has_alpha_channel)( const struct heif_image_handle * );
+static struct heif_error (*p_heif_decode_image)( const struct heif_image_handle *, struct heif_image **, int, int, const void * );
+static int (*p_heif_image_get_width)( const struct heif_image *, int );
+static int (*p_heif_image_get_height)( const struct heif_image *, int );
+static const uint8_t *(*p_heif_image_get_plane_readonly)( const struct heif_image *, int, int * );
+static void (*p_heif_image_release)( const struct heif_image * );
+static int (*p_heif_have_decoder_for_format)( int );
+#define HEIF_COMPRESSION_HEVC 1
+
+static pthread_once_t init_once = PTHREAD_ONCE_INIT;
+static BOOL heif_ready;
+
+static void load_libheif(void)
+{
+#ifdef SG_MUTANT_HEIF_NO_LIBRARY
+    return;
+#endif
+    if (!(libheif = dlopen( "libheif.so.1", RTLD_NOW )))
+    {
+        WARN( "libheif not found: no HEIF images\n" );
+        return;
+    }
+#define LOAD(f) if (!(p_##f = dlsym( libheif, #f ))) { WARN( "libheif lacks %s\n", #f ); return; }
+    LOAD(heif_init)
+    LOAD(heif_context_alloc)
+    LOAD(heif_context_free)
+    LOAD(heif_context_read_from_memory_without_copy)
+    LOAD(heif_context_get_primary_image_handle)
+    LOAD(heif_image_handle_release)
+    LOAD(heif_image_handle_has_alpha_channel)
+    LOAD(heif_decode_image)
+    LOAD(heif_image_get_width)
+    LOAD(heif_image_get_height)
+    LOAD(heif_image_get_plane_readonly)
+    LOAD(heif_image_release)
+#undef LOAD
+    p_heif_have_decoder_for_format = dlsym( libheif, "heif_have_decoder_for_format" );
+    /* loads the decoder plugins (Debian's libde265 one) */
+    if (p_heif_init( NULL ).code)
+    {
+        WARN( "heif_init failed\n" );
+        return;
+    }
+    if (p_heif_have_decoder_for_format && !p_heif_have_decoder_for_format( HEIF_COMPRESSION_HEVC ))
+    {
+        WARN( "libheif has no HEVC decoder (libheif-plugin-libde265): no HEIC images\n" );
+        return;
+    }
+    heif_ready = TRUE;
+}
+
+static NTSTATUS heif_init( void *args )
+{
+    pthread_once( &init_once, load_libheif );
+    return heif_ready ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS heif_open( void *args )
+{
+    struct heif_open_params *params = args;
+    struct heif_image_handle *handle = NULL;
+    struct heif_image *image = NULL;
+    struct heif_context *ctx;
+    struct heif_error err;
+
+    params->image = 0;
+    if (heif_init( NULL )) return STATUS_NOT_SUPPORTED;
+    if (!(ctx = p_heif_context_alloc())) return STATUS_NO_MEMORY;
+
+    err = p_heif_context_read_from_memory_without_copy( ctx, (const void *)(ULONG_PTR)params->data,
+                                                        params->size, NULL );
+    if (!err.code) err = p_heif_context_get_primary_image_handle( ctx, &handle );
+    if (!err.code)
+    {
+        params->has_alpha = !!p_heif_image_handle_has_alpha_channel( handle );
+        /* the transformations (rotation, mirroring, crop) applied, as the image is shown */
+        err = p_heif_decode_image( handle, &image, HEIF_COLORSPACE_RGB, HEIF_CHROMA_INTERLEAVED_RGBA, NULL );
+    }
+    if (handle) p_heif_image_handle_release( handle );
+    p_heif_context_free( ctx );
+    if (err.code || !image)
+    {
+        WARN( "could not decode the image: %s\n", err.message ? err.message : "?" );
+        if (image) p_heif_image_release( image );
+        return STATUS_INVALID_IMAGE_FORMAT;
+    }
+    params->width = p_heif_image_get_width( image, HEIF_CHANNEL_INTERLEAVED );
+    params->height = p_heif_image_get_height( image, HEIF_CHANNEL_INTERLEAVED );
+    params->image = (ULONG_PTR)image;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS heif_copy( void *args )
+{
+    const struct heif_copy_params *params = args;
+    const struct heif_image *image = (const struct heif_image *)(ULONG_PTR)params->image;
+    BYTE *dst = (BYTE *)(ULONG_PTR)params->buffer;
+    const uint8_t *src;
+    int src_stride, width, height, x, y;
+
+    if (!image) return STATUS_INVALID_PARAMETER;
+    width = p_heif_image_get_width( image, HEIF_CHANNEL_INTERLEAVED );
+    height = p_heif_image_get_height( image, HEIF_CHANNEL_INTERLEAVED );
+    if (!(src = p_heif_image_get_plane_readonly( image, HEIF_CHANNEL_INTERLEAVED, &src_stride )))
+        return STATUS_UNSUCCESSFUL;
+    if ((UINT64)params->stride * height > params->size || params->stride < (UINT32)width * 4)
+        return STATUS_BUFFER_TOO_SMALL;
+
+    for (y = 0; y < height; y++)
+    {
+        const uint8_t *s = src + (size_t)y * src_stride;
+        BYTE *d = dst + (size_t)y * params->stride;
+        for (x = 0; x < width; x++, s += 4, d += 4)
+        {
+            /* RGBA -> BGRA */
+            d[0] = s[2];
+            d[1] = s[1];
+            d[2] = s[0];
+            d[3] = s[3];
+        }
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS heif_close( void *args )
+{
+    const struct heif_close_params *params = args;
+
+    if (params->image) p_heif_image_release( (const struct heif_image *)(ULONG_PTR)params->image );
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    heif_init,
+    heif_open,
+    heif_copy,
+    heif_close,
+};
+
+C_ASSERT( ARRAY_SIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    heif_init,
+    heif_open,
+    heif_copy,
+    heif_close,
+};
+
+C_ASSERT( ARRAY_SIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif /* _WIN64 */
