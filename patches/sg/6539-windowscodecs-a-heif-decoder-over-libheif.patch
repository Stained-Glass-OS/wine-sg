+};
+
 static const BYTE png_magic[] = {137,80,78,71,13,10,26,10};
 
 static GUID const * const png_formats[] = {
@@ -1393,6 +1421,19 @@ static struct regsvr_decoder const decoder_list[] = {
 	wmp_formats,
 	wmp_patterns
     },
+#ifndef SG_MUTANT_HEIF_NOT_REGISTERED
+    {   &CLSID_WICHeifDecoder,
+	"The Wine Project",
+	"HEIF Decoder",
+	"1.0.0.0",
+	&GUID_VendorMicrosoft,
+	&GUID_ContainerFormatHeif,
+	"image/heic,image/heif",
+	".heic,.heif,.hif",
+	heif_formats,
+	heif_patterns
+    },
