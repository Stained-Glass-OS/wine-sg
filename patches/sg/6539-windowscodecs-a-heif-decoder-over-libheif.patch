diff --git a/dlls/windowscodecs/heifformat.c b/dlls/windowscodecs/heifformat.c
new file mode 100644
index 0000000..06f6032
--- /dev/null
+++ b/dlls/windowscodecs/heifformat.c
@@ -0,0 +1,196 @@
+/*
+ * HEIF/HEIC decoder (wine-sg 6539): libheif, loaded at run time by the Unix side
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "objbase.h"
+
+#include "wincodecs_private.h"
+#include "unixlib.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wincodecs);
+
+/* HEIF images (iPhone photos, HEIC) come from the HEIF Image Extensions on Windows; here libheif and
+ * its HEVC decoder plugin decode them when they are installed. Without them the decoder declines
+ * every image, and WIC finds no component for the file (WINCODEC_ERR_COMPONENTNOTFOUND). */
+
+struct heif_decoder
+{
+    struct decoder decoder;
+    struct decoder_frame frame;
+    BYTE *bits;
+    UINT stride;
+};
+
+static INIT_ONCE heif_once = INIT_ONCE_STATIC_INIT;
+static BOOL heif_available;
+
+static BOOL WINAPI heif_init_once( INIT_ONCE *once, void *param, void **context )
+{
+    heif_available = !__wine_init_unix_call() && !WINE_UNIX_CALL( unix_heif_init, NULL );
+    return TRUE;
+}
+
+BOOL heif_decoding_available(void)
+{
+    InitOnceExecuteOnce( &heif_once, heif_init_once, NULL, NULL );
+    return heif_available;
+}
+
+static inline struct heif_decoder *impl_from_decoder( struct decoder *iface )
+{
+    return CONTAINING_RECORD( iface, struct heif_decoder, decoder );
+}
+
+static HRESULT CDECL heif_decoder_initialize( struct decoder *iface, IStream *stream, struct decoder_stat *st )
+{
+    struct heif_decoder *This = impl_from_decoder( iface );
+    struct heif_open_params open = { 0 };
+    struct heif_copy_params copy;
+    struct heif_close_params close;
+    ULONGLONG size;
+    ULONG read;
+    BYTE *data;
+    NTSTATUS status;
+    HRESULT hr;
+
+    TRACE( "decoder %p, stream %p\n", iface, stream );
+    if (!heif_decoding_available()) return WINCODEC_ERR_COMPONENTNOTFOUND;
+
+    if (FAILED(hr = stream_getsize( stream, &size ))) return hr;
+    if (!size || size > 0x40000000) return WINCODEC_ERR_BADIMAGE;
+    if (!(data = malloc( size ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = stream_seek( stream, 0, STREAM_SEEK_SET, NULL )) ||
+        FAILED(hr = stream_read( stream, data, size, &read )) || read != size)
+    {
+        free( data );
+        return FAILED(hr) ? hr : WINCODEC_ERR_BADIMAGE;
+    }
+
+    open.data = (ULONG_PTR)data;
+    open.size = size;
+    status = WINE_UNIX_CALL( unix_heif_open, &open );
+    free( data );
+    if (status == STATUS_NOT_SUPPORTED) return WINCODEC_ERR_COMPONENTNOTFOUND;
+    if (status || !open.image || !open.width || !open.height) return WINCODEC_ERR_BADIMAGE;
+
+    This->stride = open.width * 4;
+    if (!(This->bits = malloc( (SIZE_T)This->stride * open.height )))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        copy.image = open.image;
+        copy.buffer = (ULONG_PTR)This->bits;
+        copy.stride = This->stride;
+        copy.size = This->stride * open.height;
+        hr = WINE_UNIX_CALL( unix_heif_copy, &copy ) ? WINCODEC_ERR_BADIMAGE : S_OK;
+    }
+    close.image = open.image;
+    WINE_UNIX_CALL( unix_heif_close, &close );
+    if (FAILED(hr))
+    {
+        free( This->bits );
+        This->bits = NULL;
+        return hr;
+    }
+
+    This->frame.width = open.width;
+    This->frame.height = open.height;
+    This->frame.bpp = 32;
+    This->frame.pixel_format = open.has_alpha ? GUID_WICPixelFormat32bppBGRA : GUID_WICPixelFormat32bppBGR;
+    This->frame.dpix = This->frame.dpiy = 96.0;
+    This->frame.num_color_contexts = 0;
+    This->frame.num_colors = 0;
+
+    st->flags = WICBitmapDecoderCapabilityCanDecodeAllImages | WICBitmapDecoderCapabilityCanDecodeSomeImages;
+    st->frame_count = 1;
+    return S_OK;
+}
+
+static HRESULT CDECL heif_decoder_get_frame_info( struct decoder *iface, UINT frame, struct decoder_frame *info )
+{
+    *info = impl_from_decoder( iface )->frame;
+    return S_OK;
+}
+
+static HRESULT CDECL heif_decoder_copy_pixels( struct decoder *iface, UINT frame, const WICRect *prc,
+                                               UINT stride, UINT buffersize, BYTE *buffer )
+{
+    struct heif_decoder *This = impl_from_decoder( iface );
+
+    return copy_pixels( This->frame.bpp, This->bits, This->frame.width, This->frame.height, This->stride,
+                        prc, stride, buffersize, buffer );
+}
+
+static HRESULT CDECL heif_decoder_get_metadata_blocks( struct decoder *iface, UINT frame, UINT *count,
+                                                       struct decoder_block **blocks )
+{
+    *count = 0;
+    *blocks = NULL;
+    return S_OK;
+}
+
+static HRESULT CDECL heif_decoder_get_color_context( struct decoder *iface, UINT frame, UINT num,
+                                                     BYTE **data, DWORD *datasize )
+{
+    return E_NOTIMPL;
+}
+
+static void CDECL heif_decoder_destroy( struct decoder *iface )
+{
+    struct heif_decoder *This = impl_from_decoder( iface );
+
+    free( This->bits );
+    free( This );
+}
+
+static const struct decoder_funcs heif_decoder_vtable =
+{
+    heif_decoder_initialize,
+    heif_decoder_get_frame_info,
+    heif_decoder_copy_pixels,
+    heif_decoder_get_metadata_blocks,
+    heif_decoder_get_color_context,
+    heif_decoder_destroy,
+};
+
+HRESULT HeifDecoder_CreateInstance( REFIID iid, void **ppv )
+{
+    struct decoder_info info;
+    struct heif_decoder *This;
+    HRESULT hr;
+
+    if (!(This = calloc( 1, sizeof(*This) ))) return E_OUTOFMEMORY;
+    This->decoder.vtable = &heif_decoder_vtable;
+    info.container_format = GUID_ContainerFormatHeif;
+    info.block_format = GUID_ContainerFormatHeif;
+    info.clsid = CLSID_WICHeifDecoder;
+
+    hr = CommonDecoder_CreateInstance( &This->decoder, &info, iid, ppv );
+    return hr;
+}
