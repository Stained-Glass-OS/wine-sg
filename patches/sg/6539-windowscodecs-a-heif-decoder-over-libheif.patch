+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_WINDOWSCODECS_UNIXLIB_H
+#define __WINE_WINDOWSCODECS_UNIXLIB_H
+
+#include "wine/unixlib.h"
+
+/* no pointers but UINT64 addresses: the same for 32- and 64-bit callers */
+
+/* decodes the file's primary image; image is the decoded image's handle (0 on failure) */
+struct heif_open_params
+{
+    UINT64 data;        /* the file's bytes */
+    UINT64 size;
+    UINT64 image;       /* out */
+    UINT32 width;       /* out */
+    UINT32 height;      /* out */
+    UINT32 has_alpha;   /* out */
+};
+
+/* the image's pixels as 32-bit BGRA rows */
+struct heif_copy_params
+{
+    UINT64 image;
+    UINT64 buffer;
+    UINT32 stride;
+    UINT32 size;
+};
+
+struct heif_close_params
+{
+    UINT64 image;
+};
+
+enum windowscodecs_funcs
+{
+    unix_heif_init,     /* STATUS_NOT_SUPPORTED: no libheif (or no HEVC decoder plugin) */
+    unix_heif_open,
+    unix_heif_copy,
+    unix_heif_close,
+    unix_funcs_count,
+};
+
+#endif /* __WINE_WINDOWSCODECS_UNIXLIB_H */
