From: Stained Glass OS <dev@stained-glass.example>
Subject: d3dcompiler: shader reflection reports the minimum feature level and the requirement flags

ID3D11ShaderReflection::GetMinFeatureLevel returned E_NOTIMPL and
GetRequiresFlags 0. ComputeSharp.D2D1 (so Paint.NET) reflects every effect
shader to learn the feature level it needs, and stopped. The level now
comes from the shader model (4_0_level_9_x shaders, which carry a
Direct3D 9 shader, are 9_1; 4.0 is 10_0, 4.1 10_1, 5.x 11_0), raised to
11_1 for what needs it; the requirement flags are the SFI0 chunk's.

Gate: test/d2dfx-gate.sh.
---
--- a/dlls/d3dcompiler_43/reflection.c
+++ b/dlls/d3dcompiler_43/reflection.c
@@ -135,6 +135,8 @@
     char *creator;
     UINT flags;
     UINT version;
+    BOOL has_aon9;              /* a Direct3D 9 shader too: 4_0_level_9_x */
+    UINT64 requires_flags;      /* from SFI0 */
     UINT bound_resource_count;
     UINT constant_buffer_count;
 
@@ -700,9 +702,29 @@
 static HRESULT STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetMinFeatureLevel(
         ID3D11ShaderReflection *iface, D3D_FEATURE_LEVEL *level)
 {
-    FIXME("iface %p, level %p stub!\n", iface, level);
+    struct d3dcompiler_shader_reflection *reflection = impl_from_ID3D11ShaderReflection(iface);
+    UINT major = (reflection->version >> 4) & 0xf, minor = reflection->version & 0xf;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, level %p.\n", iface, level);
+
+    if (!level)
+        return E_INVALIDARG;
+
+    if (reflection->has_aon9)
+        *level = D3D_FEATURE_LEVEL_9_1;
+    else if (major >= 5)
+        *level = D3D_FEATURE_LEVEL_11_0;
+    else if (major == 4 && minor >= 1)
+        *level = D3D_FEATURE_LEVEL_10_1;
+    else
+        *level = D3D_FEATURE_LEVEL_10_0;
+
+    if (reflection->requires_flags & (D3D_SHADER_REQUIRES_UAVS_AT_EVERY_STAGE | D3D_SHADER_REQUIRES_64_UAVS
+            | D3D_SHADER_REQUIRES_11_1_DOUBLE_EXTENSIONS | D3D_SHADER_REQUIRES_11_1_SHADER_EXTENSIONS
+            | D3D_SHADER_REQUIRES_TILED_RESOURCES))
+        *level = max(*level, D3D_FEATURE_LEVEL_11_1);
+
+    return S_OK;
 }
 
 static UINT STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetThreadGroupSize(
@@ -728,9 +750,11 @@
 static UINT64 STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetRequiresFlags(
         ID3D11ShaderReflection *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct d3dcompiler_shader_reflection *reflection = impl_from_ID3D11ShaderReflection(iface);
 
-    return 0;
+    TRACE("iface %p.\n", iface);
+
+    return reflection->requires_flags;
 }
 #endif
 
@@ -1947,6 +1971,15 @@
                 }
                 break;
 
+            case TAG_Aon9:
+                reflection->has_aon9 = TRUE;
+                break;
+
+            case MAKE_TAG('S', 'F', 'I', '0'):
+                if (section->data.size >= sizeof(UINT64))
+                    memcpy(&reflection->requires_flags, section->data.code, sizeof(UINT64));
+                break;
+
             default:
                 FIXME("Unhandled section %s!\n", debugstr_fourcc(section->tag));
                 break;
