From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Wine's windows come in front of Linux programs' windows

Every Wine window -- File Explorer, Notepad, the Start menu -- lives in
Wine's desktop window, one X window below a Linux program's (SG Office's
editors): with an SG Office document open, the Start menu, a program
started from it and File Explorer brought forward from its taskbar button
all stayed hidden behind it, and that button minimized the window instead
(Wine still had it as its active window).

While the compositor's list (sg-lockctl XWINDOWS) says a Linux program's
window has the focus, a Wine window coming forward -- in any process,
File Explorer's in this one too -- has the taskbar ask the compositor for
the desktop in front (XDESKTOP, sg-compositor 0.2.0+sg20). Wine's last
active window is deactivated when a Linux window takes the focus, so
bringing it forward again is noticed; its button brings it forward
rather than minimizing it. The list is read a tick late: for 2.5 s after
the taskbar changed what is in front, it is not taken as news.

Gate: test/desktopfront-gate.sh (SG_MUTANT_NO_DESKTOP_FRONT fails it).
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1455,6 +1455,53 @@
     sg_run_lockctl( args );
 }
 
+/* Stained Glass OS: Wine's windows and the Linux programs' windows take turns
+ * in front. Every Wine window -- File Explorer, Notepad, the Start menu --
+ * lives in Wine's desktop window, one X window under a Linux program's (SG
+ * Office's editors), which would hide them all: a Wine window brought forward
+ * (its button, Start, a program opening one) while a Linux window is in front
+ * has the compositor put the desktop in front (XDESKTOP). A Linux window
+ * stays shown and on the taskbar; its button brings it forward again.
+ * sg_xwin_front: a Linux program's window is in front of Wine's desktop (the
+ * compositor's list says it has the focus, or its button just brought it). */
+static BOOL sg_xwin_front;
+/* when the taskbar last changed which is in front: the compositor's list,
+ * read a tick late, does not know yet */
+static DWORD sg_xwin_front_time;
+
+static void sg_desktop_front(void)
+{
+    struct taskbar_button *win;
+
+#ifdef SG_MUTANT_NO_DESKTOP_FRONT
+    return;
+#endif
+    if (!sg_xwin_front) return;
+    sg_xwin_front = FALSE;
+    sg_xwin_front_time = GetTickCount();
+    sg_run_lockctl( L"XDESKTOP" );
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+        if (win->xwin && win->xwin_focused)
+        {
+            win->xwin_focused = FALSE;   /* until the next list says otherwise */
+            InvalidateRect( win->button, NULL, FALSE );
+        }
+}
+
+/* a window brought forward, in any process (this one's File Explorer too) */
+static void CALLBACK sg_foreground_event( HWINEVENTHOOK hook, DWORD event, HWND hwnd, LONG object,
+                                          LONG child, DWORD thread, DWORD time )
+{
+    WCHAR class[64];
+
+    if (!sg_xwin_front || !hwnd || object != OBJID_WINDOW) return;
+    if (hwnd == tray_window || hwnd == GetDesktopWindow() || !IsWindowVisible( hwnd )) return;
+    if (GetClassNameW( hwnd, class, ARRAY_SIZE(class) ) &&
+        (!wcscmp( class, L"SgLinuxWindow" ) || !wcscmp( class, L"Progman" ) || !wcscmp( class, L"WorkerW" )))
+        return;
+    sg_desktop_front();
+}
+
 /* Task View's action on a Linux window, by its stand-in */
 void sg_linux_window_command( HWND stand_in, const WCHAR *verb )
 {
@@ -1639,6 +1686,27 @@
         free( win );
         changed = TRUE;
     }
+    /* a Linux program's window has the focus (the person clicked it): it is
+     * in front of Wine's desktop, and Wine's last active window is not --
+     * deactivated, so that bringing it (or any) forward again is noticed */
+    {
+        BOOL front = FALSE;
+        LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+            if (win->xwin && win->xwin_focused && !win->xwin_minimized) front = TRUE;
+#ifndef SG_MUTANT_NO_DESKTOP_FRONT
+        if (GetTickCount() - sg_xwin_front_time > 2500)
+#else
+        if (0)
+#endif
+        {
+            if (front && !sg_xwin_front)
+            {
+                HWND fg = GetForegroundWindow();
+                if (fg && fg != tray_window && fg != GetDesktopWindow()) SetForegroundWindow( GetDesktopWindow() );
+            }
+            sg_xwin_front = front;
+        }
+    }
     if (changed) sync_taskbar_buttons();
 }
 
@@ -2498,7 +2566,13 @@
     if (hwnd && (win = find_taskbar_button( hwnd )) && win->xwin)
     {
         /* a Linux program's window: forward, or away when it is in front */
-        sg_xwin_command( win, win->xwin_focused && !win->xwin_minimized ? L"XMINIMIZE" : L"XACTIVATE" );
+        BOOL away = win->xwin_focused && !win->xwin_minimized;
+        sg_xwin_command( win, away ? L"XMINIMIZE" : L"XACTIVATE" );
+        if (!away)
+        {
+            sg_xwin_front = TRUE;
+            sg_xwin_front_time = GetTickCount();
+        }
         sg_sync_xwindows();
         return;
     }
@@ -2507,6 +2581,15 @@
 
 static void activate_taskbar_window( HWND hwnd )
 {
+    /* behind a Linux program's window: forward, not minimized for being
+     * Wine's active window */
+    if (hwnd && sg_xwin_front)
+    {
+        sg_desktop_front();
+        SetForegroundWindow( hwnd );
+        if (IsIconic( hwnd )) SendMessageW( hwnd, WM_SYSCOMMAND, SC_RESTORE, 0 );
+        return;
+    }
     if (!hwnd)  /* start button */
     {
         /* Stained Glass OS: open our Start menu (sg-start, an AGPL program in
@@ -3032,6 +3115,9 @@
                      WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS );
     SetWinEventHook( EVENT_OBJECT_LOCATIONCHANGE, EVENT_OBJECT_LOCATIONCHANGE, NULL, sg_window_event, 0, 0,
                      WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS );
+    /* this process's windows too (File Explorer's) */
+    SetWinEventHook( EVENT_SYSTEM_FOREGROUND, EVENT_SYSTEM_FOREGROUND, NULL, sg_foreground_event, 0, 0,
+                     WINEVENT_OUTOFCONTEXT );
 }
 
 /* what SHAppBarMessage reports and sets (appbar.c) */
