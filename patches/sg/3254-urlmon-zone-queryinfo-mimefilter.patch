From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 19:57:33 -0700
Subject: [PATCH] urlmon: zone elevation prompt, query info, mime filter, IUri
 DWORD properties (3254)

- CoInternetIsFeatureZoneElevationEnabled asks the user when the zone
  policy is URLPOLICY_QUERY (yes allows the elevation: S_FALSE, no keeps
  it disallowed: S_OK) instead of leaving a FIXME.
- CoInternetQueryInfo answers E_FAIL, not E_NOTIMPL, for an option it
  does not know when no protocol handler answers (the Wine test and the
  documentation agree with the short buffer case).
- The MIME filter protocol's LockRequest, UnlockRequest and Terminate
  succeed (dwOptions 0), as documented for a protocol with nothing to
  lock or free.
- IUri::GetPropertyDWORD gives E_INVALIDARG and 0 for a property that is
  not a DWORD property.

diff --git a/dlls/urlmon/internet.c b/dlls/urlmon/internet.c
index a38fbbb..88c8360 100644
--- a/dlls/urlmon/internet.c
+++ b/dlls/urlmon/internet.c
@@ -18,6 +18,7 @@
  */
 
 #include "urlmon_main.h"
+#include "resource.h"
 #include "winreg.h"
 #include "shlwapi.h"
 #include "strsafe.h"
@@ -527,8 +528,12 @@ HRESULT WINAPI CoInternetQueryInfo(LPCWSTR pwzUrl, QUERYOPTION QueryOption,
         break;
 
     default:
-        FIXME("Not supported option %d\n", QueryOption);
+        /* no protocol handler answers: the option is unknown, as for a buffer that is too small, E_FAIL */
+        WARN("Not supported option %d\n", QueryOption);
+#ifdef SG_MUTANT_URLMON_QUERYINFO
         return E_NOTIMPL;
+#endif
+        return E_FAIL;
     }
 
     return S_OK;
@@ -919,8 +924,22 @@ HRESULT WINAPI CoInternetIsFeatureZoneElevationEnabled(LPCWSTR szFromURL, LPCWST
         switch(policy) {
         case URLPOLICY_ALLOW:
             return S_FALSE;
-        case URLPOLICY_QUERY:
-            FIXME("Ask user dialog not implemented\n");
+        case URLPOLICY_QUERY: {
+            WCHAR fmt[256], caption[64], *text;
+            size_t len;
+
+            /* the user decides: yes allows the elevation, no keeps it disallowed */
+            LoadStringW(urlmon_instance, IDS_ZONE_ELEVATION_PROMPT, fmt, ARRAY_SIZE(fmt));
+            LoadStringW(urlmon_instance, IDS_ZONE_ELEVATION_CAPTION, caption, ARRAY_SIZE(caption));
+            len = wcslen(fmt) + wcslen(szToURL) + (szFromURL ? wcslen(szFromURL) : 0) + 1;
+            text = malloc(len * sizeof(WCHAR));
+            if(!text)
+                return S_OK;
+            swprintf(text, len, fmt, szFromURL ? szFromURL : L"", szToURL);
+            hres = MessageBoxW(NULL, text, caption, MB_YESNO | MB_ICONWARNING) == IDYES ? S_FALSE : S_OK;
+            free(text);
+            return hres;
+        }
         default:
             return S_OK;
         }
diff --git a/dlls/urlmon/mimefilter.c b/dlls/urlmon/mimefilter.c
index 70dd982..86da6b8 100644
--- a/dlls/urlmon/mimefilter.c
+++ b/dlls/urlmon/mimefilter.c
@@ -113,8 +113,11 @@ static HRESULT WINAPI MimeFilterProtocol_Abort(IInternetProtocol *iface, HRESULT
 static HRESULT WINAPI MimeFilterProtocol_Terminate(IInternetProtocol *iface, DWORD dwOptions)
 {
     MimeFilter *This = impl_from_IInternetProtocol(iface);
-    FIXME("(%p)->(%08lx)\n", This, dwOptions);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%08lx)\n", This, dwOptions);
+
+    /* the filter holds nothing that needs freeing before it is released */
+    return dwOptions ? E_INVALIDARG : S_OK;
 }
 
 static HRESULT WINAPI MimeFilterProtocol_Suspend(IInternetProtocol *iface)
@@ -152,15 +155,18 @@ static HRESULT WINAPI MimeFilterProtocol_Seek(IInternetProtocol *iface, LARGE_IN
 static HRESULT WINAPI MimeFilterProtocol_LockRequest(IInternetProtocol *iface, DWORD dwOptions)
 {
     MimeFilter *This = impl_from_IInternetProtocol(iface);
-    FIXME("(%p)->(%08lx)\n", This, dwOptions);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%08lx)\n", This, dwOptions);
+
+    /* a protocol that does not need to lock its request succeeds */
+    return dwOptions ? E_INVALIDARG : S_OK;
 }
 
 static HRESULT WINAPI MimeFilterProtocol_UnlockRequest(IInternetProtocol *iface)
 {
     MimeFilter *This = impl_from_IInternetProtocol(iface);
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+    TRACE("(%p)\n", This);
+    return S_OK;
 }
 
 static const IInternetProtocolVtbl MimeFilterProtocolVtbl = {
diff --git a/dlls/urlmon/resource.h b/dlls/urlmon/resource.h
index 3ff2ac6..969b1e5 100644
--- a/dlls/urlmon/resource.h
+++ b/dlls/urlmon/resource.h
@@ -24,3 +24,5 @@
 #define IDS_AXINSTALL_FAILURE       1100
 #define IDS_AXINSTALL_INSTALLN      1101
 #define IDS_AXINSTALL_INSTALL       1102
+#define IDS_ZONE_ELEVATION_PROMPT  1103
+#define IDS_ZONE_ELEVATION_CAPTION 1104
diff --git a/dlls/urlmon/uri.c b/dlls/urlmon/uri.c
index d0c2a9a..65a4a29 100644
--- a/dlls/urlmon/uri.c
+++ b/dlls/urlmon/uri.c
@@ -4490,8 +4490,13 @@ static HRESULT WINAPI Uri_GetPropertyDWORD(IUri *iface, Uri_PROPERTY uriProp, DW
         hres = S_OK;
         break;
     default:
-        FIXME("(%p)->(%d %p %lx)\n", This, uriProp, pcchProperty, dwFlags);
+        /* not a DWORD property */
+#ifdef SG_MUTANT_URLMON_URIDWORD
         hres = E_NOTIMPL;
+        break;
+#endif
+        *pcchProperty = 0;
+        hres = E_INVALIDARG;
     }
 
     return hres;
diff --git a/dlls/urlmon/urlmon.rc b/dlls/urlmon/urlmon.rc
index 70d7aad..8495340 100644
--- a/dlls/urlmon/urlmon.rc
+++ b/dlls/urlmon/urlmon.rc
@@ -50,6 +50,8 @@ STRINGTABLE
     IDS_AXINSTALL_FAILURE    "Installation of component failed: %08x"
     IDS_AXINSTALL_INSTALLN   "Install (%d)"
     IDS_AXINSTALL_INSTALL    "Install"
+    IDS_ZONE_ELEVATION_PROMPT "The page %s is trying to open %s, which is in a different security zone. Do you want to allow this?"
+    IDS_ZONE_ELEVATION_CAPTION "Security Warning"
 }
 
 LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
