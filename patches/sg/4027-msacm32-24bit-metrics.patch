From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msacm32: 24 bit PCM conversions, hardware driver count, stream messages.

The PCM converter handles 8/16/24 bit to 24 bit at the same rate and
with rate changes, acmMetrics(ACM_METRIC_COUNT_HARDWARE) counts drivers
with hardware support, and acmStreamMessage forwards driver messages
(ACMDM_USER range) to the stream's driver.
---
 dlls/msacm32/msacm32_main.c |   7 ++-
 dlls/msacm32/pcmconverter.c | 107 +++++++++++++++++++++++++++++++++++++++++---
 dlls/msacm32/stream.c       |  18 ++++++--
 3 files changed, 119 insertions(+), 13 deletions(-)

diff --git a/dlls/msacm32/msacm32_main.c b/dlls/msacm32/msacm32_main.c
index ad33c88..5d36611 100644
--- a/dlls/msacm32/msacm32_main.c
+++ b/dlls/msacm32/msacm32_main.c
@@ -218,8 +218,11 @@ MMRESULT WINAPI acmMetrics(HACMOBJ hao, UINT uMetric, LPVOID pMetric)
     case ACM_METRIC_COUNT_HARDWARE:
         if (hao) return MMSYSERR_INVALHANDLE;
         if (!pMetric) return MMSYSERR_INVALPARAM;
-        *(LPDWORD)pMetric = 0;
-        FIXME("ACM_METRIC_COUNT_HARDWARE not implemented\n");
+        for (padid = MSACM_pFirstACMDriverID; padid; padid = padid->pNextACMDriverID)
+            if (!(padid->fdwSupport & ACMDRIVERDETAILS_SUPPORTF_DISABLED) &&
+                (padid->fdwSupport & ACMDRIVERDETAILS_SUPPORTF_HARDWARE) && CheckLocal(padid))
+                val++;
+        *(LPDWORD)pMetric = val;
         break;
 
     case ACM_METRIC_DRIVER_PRIORITY:
diff --git a/dlls/msacm32/pcmconverter.c b/dlls/msacm32/pcmconverter.c
index 0b9724b..dadf602 100644
--- a/dlls/msacm32/pcmconverter.c
+++ b/dlls/msacm32/pcmconverter.c
@@ -522,16 +522,64 @@ static	void cvtSS2416K(const unsigned char* src, int ns, unsigned char* dst)
 }
 
 
+/* Conversions to and from 24 bits: the samples are taken to the 32 bit domain
+ * of R24() (24 significant bits), mixed or duplicated between channel counts,
+ * and written at the destination depth. */
+static inline int R8_32(const unsigned char *src) { return C816(*src) << 16; }
+static inline int R16_32(const unsigned char *src) { return R16(src) << 16; }
+static inline void W8_32(unsigned char *dst, int s) { *dst = C248(s); }
+static inline void W16_32(unsigned char *dst, int s) { W16(dst, C2416(s)); }
+
+static inline int mix_32(int l, int r)
+{
+    LONGLONG sum = (LONGLONG)l + r;
+
+    if (sum > 0x7fffff00) sum = 0x7fffff00;
+    else if (sum < -0x7fffff00) sum = -0x7fffff00;
+    return sum;
+}
+
+#define DEFINE_CVT_KEEP_RATE(name, src_size, src_channels, dst_size, dst_channels, READ, WRITE) \
+static void name(const unsigned char *src, int ns, unsigned char *dst) \
+{ \
+    int l, r; \
+    TRACE("(%p, %d, %p)\n", src, ns, dst); \
+    while (ns--) { \
+        l = READ(src); \
+        r = src_channels == 2 ? READ(src + src_size) : l; \
+        if (dst_channels == 2) { \
+            WRITE(dst, l); dst += dst_size; \
+            WRITE(dst, r); dst += dst_size; \
+        } else { \
+            WRITE(dst, src_channels == 2 ? mix_32(l, r) : l); dst += dst_size; \
+        } \
+        src += src_size * src_channels; \
+    } \
+}
+
+DEFINE_CVT_KEEP_RATE(cvtSS824K, 1, 2, 3, 2, R8_32, W24)
+DEFINE_CVT_KEEP_RATE(cvtSM824K, 1, 2, 3, 1, R8_32, W24)
+DEFINE_CVT_KEEP_RATE(cvtMS824K, 1, 1, 3, 2, R8_32, W24)
+DEFINE_CVT_KEEP_RATE(cvtMM824K, 1, 1, 3, 1, R8_32, W24)
+DEFINE_CVT_KEEP_RATE(cvtSS1624K, 2, 2, 3, 2, R16_32, W24)
+DEFINE_CVT_KEEP_RATE(cvtSM1624K, 2, 2, 3, 1, R16_32, W24)
+DEFINE_CVT_KEEP_RATE(cvtMS1624K, 2, 1, 3, 2, R16_32, W24)
+DEFINE_CVT_KEEP_RATE(cvtMM1624K, 2, 1, 3, 1, R16_32, W24)
+DEFINE_CVT_KEEP_RATE(cvtSS2424K, 3, 2, 3, 2, R24, W24)
+DEFINE_CVT_KEEP_RATE(cvtSM2424K, 3, 2, 3, 1, R24, W24)
+DEFINE_CVT_KEEP_RATE(cvtMS2424K, 3, 1, 3, 2, R24, W24)
+DEFINE_CVT_KEEP_RATE(cvtMM2424K, 3, 1, 3, 1, R24, W24)
+
 static const PCM_CONVERT_KEEP_RATE PCM_ConvertKeepRate[] = {
     cvtSS88K,	cvtSM88K,   cvtMS88K,   cvtMM88K,
     cvtSS816K,	cvtSM816K,  cvtMS816K,  cvtMM816K,
-    NULL, NULL, NULL, NULL, /* TODO: 8->24 */
+    cvtSS824K,  cvtSM824K,  cvtMS824K,  cvtMM824K,
     cvtSS168K,	cvtSM168K,  cvtMS168K,  cvtMM168K,
     cvtSS1616K, cvtSM1616K, cvtMS1616K, cvtMM1616K,
-    NULL, NULL, NULL, NULL, /* TODO: 16->24 */
+    cvtSS1624K, cvtSM1624K, cvtMS1624K, cvtMM1624K,
     cvtSS248K, cvtSM248K, cvtMS248K, cvtMM248K,
     cvtSS2416K, cvtSM2416K, cvtMS2416K, cvtMM2416K,
-    NULL, NULL, NULL, NULL, /* TODO: 24->24 */
+    cvtSS2424K, cvtSM2424K, cvtMS2424K, cvtMM2424K,
 };
 
 /* the conversion routines with rate conversion are labelled cvt<X><Y><N><M>C
@@ -953,15 +1001,60 @@ static void cvtMM2424C(const DWORD srcRate, const unsigned char *src, DWORD *nsr
     }
 }
 
+#define DEFINE_CVT_CHANGE_RATE(name, src_size, src_channels, dst_size, dst_channels, READ, WRITE) \
+static void name(const DWORD srcRate, const unsigned char *src, DWORD *nsrc, \
+                 const DWORD dstRate, unsigned char *dst, DWORD *ndst) \
+{ \
+    DWORD error = srcRate / 2; \
+    DWORD maxSrc = *nsrc, maxDst = *ndst; \
+    int l, r; \
+    *ndst = 0; \
+    for (*nsrc = 0; *nsrc < maxSrc; (*nsrc)++) { \
+        error += dstRate; \
+        while (error > srcRate) { \
+            if (*ndst == maxDst) \
+                return; \
+            (*ndst)++; \
+            error -= srcRate; \
+            l = READ(src); \
+            r = src_channels == 2 ? READ(src + src_size) : l; \
+            if (dst_channels == 2) { \
+                WRITE(dst, l); dst += dst_size; \
+                WRITE(dst, r); dst += dst_size; \
+            } else { \
+                WRITE(dst, src_channels == 2 ? mix_32(l, r) : l); dst += dst_size; \
+            } \
+        } \
+        src += src_size * src_channels; \
+    } \
+}
+
+DEFINE_CVT_CHANGE_RATE(cvtSS824C, 1, 2, 3, 2, R8_32, W24)
+DEFINE_CVT_CHANGE_RATE(cvtSM824C, 1, 2, 3, 1, R8_32, W24)
+DEFINE_CVT_CHANGE_RATE(cvtMS824C, 1, 1, 3, 2, R8_32, W24)
+DEFINE_CVT_CHANGE_RATE(cvtMM824C, 1, 1, 3, 1, R8_32, W24)
+DEFINE_CVT_CHANGE_RATE(cvtSS1624C, 2, 2, 3, 2, R16_32, W24)
+DEFINE_CVT_CHANGE_RATE(cvtSM1624C, 2, 2, 3, 1, R16_32, W24)
+DEFINE_CVT_CHANGE_RATE(cvtMS1624C, 2, 1, 3, 2, R16_32, W24)
+DEFINE_CVT_CHANGE_RATE(cvtMM1624C, 2, 1, 3, 1, R16_32, W24)
+DEFINE_CVT_CHANGE_RATE(cvtSS248C, 3, 2, 1, 2, R24, W8_32)
+DEFINE_CVT_CHANGE_RATE(cvtSM248C, 3, 2, 1, 1, R24, W8_32)
+DEFINE_CVT_CHANGE_RATE(cvtMS248C, 3, 1, 1, 2, R24, W8_32)
+DEFINE_CVT_CHANGE_RATE(cvtMM248C, 3, 1, 1, 1, R24, W8_32)
+DEFINE_CVT_CHANGE_RATE(cvtSS2416C, 3, 2, 2, 2, R24, W16_32)
+DEFINE_CVT_CHANGE_RATE(cvtSM2416C, 3, 2, 2, 1, R24, W16_32)
+DEFINE_CVT_CHANGE_RATE(cvtMS2416C, 3, 1, 2, 2, R24, W16_32)
+DEFINE_CVT_CHANGE_RATE(cvtMM2416C, 3, 1, 2, 1, R24, W16_32)
+
 static const PCM_CONVERT_CHANGE_RATE PCM_ConvertChangeRate[] = {
     cvtSS88C,   cvtSM88C,   cvtMS88C,   cvtMM88C,
     cvtSS816C,	cvtSM816C,  cvtMS816C,  cvtMM816C,
-    NULL, NULL, NULL, NULL, /* TODO: 8->24 */
+    cvtSS824C,  cvtSM824C,  cvtMS824C,  cvtMM824C,
     cvtSS168C,	cvtSM168C,  cvtMS168C,  cvtMM168C,
     cvtSS1616C, cvtSM1616C, cvtMS1616C, cvtMM1616C,
-    NULL, NULL, NULL, NULL, /* TODO: 16->24 */
-    NULL, NULL, NULL, NULL, /* TODO: 24->8 */
-    NULL, NULL, NULL, NULL, /* TODO: 24->16 */
+    cvtSS1624C, cvtSM1624C, cvtMS1624C, cvtMM1624C,
+    cvtSS248C,  cvtSM248C,  cvtMS248C,  cvtMM248C,
+    cvtSS2416C, cvtSM2416C, cvtMS2416C, cvtMM2416C,
     cvtSS2424C, cvtSM2424C, cvtMS2424C, cvtMM2424C,
 };
 
diff --git a/dlls/msacm32/stream.c b/dlls/msacm32/stream.c
index 1fcd2e3..0c6d073 100644
--- a/dlls/msacm32/stream.c
+++ b/dlls/msacm32/stream.c
@@ -24,7 +24,6 @@
 /* TODO
  * 	+ asynchronous conversion is not implemented
  *	+ callback/notification
- *	* acmStreamMessage
  *	+ properly close ACM streams
  */
 
@@ -138,9 +137,20 @@ MMRESULT WINAPI acmStreamConvert(HACMSTREAM has, PACMSTREAMHEADER pash,
 MMRESULT WINAPI acmStreamMessage(HACMSTREAM has, UINT uMsg, LPARAM lParam1,
 				 LPARAM lParam2)
 {
-    FIXME("(%p, %u, %Id, %Id): stub\n", has, uMsg, lParam1, lParam2);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return MMSYSERR_ERROR;
+    PWINE_ACMSTREAM was;
+
+    TRACE("(%p, %u, %Id, %Id)\n", has, uMsg, lParam1, lParam2);
+
+    if ((was = ACM_GetStream(has)) == NULL) {
+        WARN("invalid handle\n");
+        return MMSYSERR_INVALHANDLE;
+    }
+    /* only driver defined messages may be sent through a stream handle */
+    if (uMsg < ACMDM_USER || uMsg >= ACMDM_RESERVED_LOW) {
+        WARN("invalid message %#x\n", uMsg);
+        return MMSYSERR_INVALPARAM;
+    }
+    return MSACM_Message((HACMDRIVER)was->pDrv, uMsg, lParam1, lParam2);
 }
 
