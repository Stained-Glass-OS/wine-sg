From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: the display devices a session records stay user-writable

0011/0242 keep the display configuration (Control\Video, GraphicsDrivers,
DEVICEMAP\VIDEO) writable by interactive users. The display devices it
records were not: the GPU (Enum\PCI), the monitors (Enum\DISPLAY) and their
device classes, once the machine stamped them (0024), were admin-only. The
desktop owner's display setup failed ("Failed to write gpu"), left a record
naming a GPU it could not write, and every program redid the display setup
at every display call ("Failed to read display config" -- 321 times for
Notepad; Telegram showed no window). They get the same exception.
---
--- a/server/registry.c
+++ b/server/registry.c
@@ -488,14 +488,29 @@
     /* HKLM\HARDWARE\DEVICEMAP\VIDEO: which source is which, read by every
      * program's display setup (wine-sg 0242) */
     static const WCHAR mapW[]   = {'\\','D','E','V','I','C','E','M','A','P','\\','V','I','D','E','O'};
-    data_size_t chars = len / sizeof(WCHAR), i;
-
-    for (i = 0; i + ARRAY_SIZE(videoW) <= chars; i++)
+    /* and the display devices it records: the GPU (Enum\PCI) and monitors
+     * (Enum\DISPLAY), and their device classes. Read-only to users, the
+     * desktop owner's display setup failed at "Failed to write gpu", found
+     * no source, and every program redid it at every display call ("Failed
+     * to read display config", hundreds of times per program) */
+    static const WCHAR pciW[]   = {'\\','E','n','u','m','\\','P','C','I'};
+    static const WCHAR dispW[]  = {'\\','E','n','u','m','\\','D','I','S','P','L','A','Y'};
+    static const WCHAR classdW[] = {'\\','C','l','a','s','s','\\','{','4','D','3','6','E','9','6','8','-','E','3','2','5','-',
+                                    '1','1','C','E','-','B','F','C','1','-','0','8','0','0','2','B','E','1','0','3','1','8','}'};
+    static const WCHAR classmW[] = {'\\','C','l','a','s','s','\\','{','4','D','3','6','E','9','6','E','-','E','3','2','5','-',
+                                    '1','1','C','E','-','B','F','C','1','-','0','8','0','0','2','B','E','1','0','3','1','8','}'};
+    static const struct { const WCHAR *s; data_size_t n; } names[] =
     {
-        if (!memicmp_strW( name + i, videoW, sizeof(videoW) )) return 1;
-        if (i + ARRAY_SIZE(gfxW) <= chars && !memicmp_strW( name + i, gfxW, sizeof(gfxW) )) return 1;
-        if (i + ARRAY_SIZE(mapW) <= chars && !memicmp_strW( name + i, mapW, sizeof(mapW) )) return 1;
-    }
+        { videoW, ARRAY_SIZE(videoW) }, { gfxW, ARRAY_SIZE(gfxW) }, { mapW, ARRAY_SIZE(mapW) },
+        { pciW, ARRAY_SIZE(pciW) }, { dispW, ARRAY_SIZE(dispW) },
+        { classdW, ARRAY_SIZE(classdW) }, { classmW, ARRAY_SIZE(classmW) },
+    };
+    data_size_t chars = len / sizeof(WCHAR), i, j;
+
+    for (i = 0; i < chars; i++)
+        for (j = 0; j < ARRAY_SIZE(names); j++)
+            if (i + names[j].n <= chars && !memicmp_strW( name + i, names[j].s, names[j].n * sizeof(WCHAR) ))
+                return 1;
     return 0;
 }
 
