From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3drm: mesh scale/translate/box, group mapping and quality (3507)

d3drm: mesh scale, translate, box, group mapping and quality; builder macros in d3drmobj.h

IDirect3DRMMesh Scale, Translate, GetBox (over the groups' vertices), Set/GetGroupMapping and
Set/GetGroupQuality (a group keeps both, quality starting at gouraud).
include/d3drmobj.h: the IDirect3DRMMeshBuilder, 2 and 3 macros for Translate and SetColorSource passed the
wrong arguments (Translate(p,a) for three values; SetColorSource(p,a,b,c)). The builder's own accessors are
2670's.
---
--- a/dlls/d3drm/d3drm_private.h
+++ b/dlls/d3drm/d3drm_private.h
@@ -249,6 +249,8 @@ struct mesh_group
     D3DCOLOR color;
     IDirect3DRMMaterial2* material;
     IDirect3DRMTexture3* texture;
+    D3DRMMAPPING mapping;
+    D3DRMRENDERQUALITY quality;
 };
 
 struct d3drm_mesh
--- a/dlls/d3drm/meshbuilder.c
+++ b/dlls/d3drm/meshbuilder.c
@@ -2878,24 +2878,87 @@ static HRESULT WINAPI d3drm_mesh_GetClassName(IDirect3DRMMesh *iface, DWORD *siz
 static HRESULT WINAPI d3drm_mesh_Scale(IDirect3DRMMesh *iface,
         D3DVALUE sx, D3DVALUE sy, D3DVALUE sz)
 {
-    FIXME("iface %p, sx %.8e, sy %.8e, sz %.8e stub!\n", iface, sx, sy, sz);
+    struct d3drm_mesh *mesh = impl_from_IDirect3DRMMesh(iface);
+    SIZE_T g;
+    unsigned int i;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, sx %.8e, sy %.8e, sz %.8e.\n", iface, sx, sy, sz);
+
+    for (g = 0; g < mesh->nb_groups; ++g)
+    {
+        for (i = 0; i < mesh->groups[g].nb_vertices; ++i)
+        {
+            D3DRMVERTEX *v = &mesh->groups[g].vertices[i];
+
+            v->position.x *= sx;
+            v->position.y *= sy;
+            v->position.z *= sz;
+        }
+    }
+
+    return D3DRM_OK;
 }
 
 static HRESULT WINAPI d3drm_mesh_Translate(IDirect3DRMMesh *iface,
         D3DVALUE tx, D3DVALUE ty, D3DVALUE tz)
 {
-    FIXME("iface %p, tx %.8e, ty %.8e, tz %.8e stub!\n", iface, tx, ty, tz);
+    struct d3drm_mesh *mesh = impl_from_IDirect3DRMMesh(iface);
+    SIZE_T g;
+    unsigned int i;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, tx %.8e, ty %.8e, tz %.8e.\n", iface, tx, ty, tz);
+
+    for (g = 0; g < mesh->nb_groups; ++g)
+    {
+        for (i = 0; i < mesh->groups[g].nb_vertices; ++i)
+        {
+            D3DRMVERTEX *v = &mesh->groups[g].vertices[i];
+
+            v->position.x += tx;
+            v->position.y += ty;
+            v->position.z += tz;
+        }
+    }
+
+    return D3DRM_OK;
 }
 
 static HRESULT WINAPI d3drm_mesh_GetBox(IDirect3DRMMesh *iface, D3DRMBOX *box)
 {
-    FIXME("iface %p, box %p stub!\n", iface, box);
+    struct d3drm_mesh *mesh = impl_from_IDirect3DRMMesh(iface);
+    BOOL first = TRUE;
+    SIZE_T g;
+    unsigned int i;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, box %p.\n", iface, box);
+
+    if (!box)
+        return D3DRMERR_BADVALUE;
+
+    memset(box, 0, sizeof(*box));
+    for (g = 0; g < mesh->nb_groups; ++g)
+    {
+        for (i = 0; i < mesh->groups[g].nb_vertices; ++i)
+        {
+            const D3DVECTOR *p = &mesh->groups[g].vertices[i].position;
+
+            if (first)
+            {
+                box->min = *p;
+                box->max = *p;
+                first = FALSE;
+                continue;
+            }
+            box->min.x = min(box->min.x, p->x);
+            box->min.y = min(box->min.y, p->y);
+            box->min.z = min(box->min.z, p->z);
+            box->max.x = max(box->max.x, p->x);
+            box->max.y = max(box->max.y, p->y);
+            box->max.z = max(box->max.z, p->z);
+        }
+    }
+
+    return D3DRM_OK;
 }
 
 static HRESULT WINAPI d3drm_mesh_AddGroup(IDirect3DRMMesh *iface, unsigned vertex_count,
@@ -2949,6 +3012,8 @@ static HRESULT WINAPI d3drm_mesh_AddGroup(IDirect3DRMMesh *iface, unsigned verte
 
     group->material = NULL;
     group->texture = NULL;
+    group->mapping = 0;
+    group->quality = D3DRMRENDER_GOURAUD;
 
     *id = mesh->nb_groups++;
 
@@ -3008,16 +3073,30 @@ static HRESULT WINAPI d3drm_mesh_SetGroupColorRGB(IDirect3DRMMesh *iface,
 
 static HRESULT WINAPI d3drm_mesh_SetGroupMapping(IDirect3DRMMesh *iface, D3DRMGROUPINDEX id, D3DRMMAPPING value)
 {
-    FIXME("iface %p, id %#lx, value %#lx stub!\n", iface, id, value);
+    struct d3drm_mesh *mesh = impl_from_IDirect3DRMMesh(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, id %#lx, value %#lx.\n", iface, id, value);
+
+    if (id >= mesh->nb_groups)
+        return D3DRMERR_BADVALUE;
+
+    mesh->groups[id].mapping = value;
+
+    return D3DRM_OK;
 }
 
 static HRESULT WINAPI d3drm_mesh_SetGroupQuality(IDirect3DRMMesh *iface, D3DRMGROUPINDEX id, D3DRMRENDERQUALITY value)
 {
-    FIXME("iface %p, id %#lx, value %#lx stub!\n", iface, id, value);
+    struct d3drm_mesh *mesh = impl_from_IDirect3DRMMesh(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, id %#lx, value %#lx.\n", iface, id, value);
+
+    if (id >= mesh->nb_groups)
+        return D3DRMERR_BADVALUE;
+
+    mesh->groups[id].quality = value;
+
+    return D3DRM_OK;
 }
 
 static HRESULT WINAPI d3drm_mesh_SetGroupMaterial(IDirect3DRMMesh *iface,
@@ -3130,15 +3209,25 @@ static D3DCOLOR WINAPI d3drm_mesh_GetGroupColor(IDirect3DRMMesh *iface, D3DRMGRO
 
 static D3DRMMAPPING WINAPI d3drm_mesh_GetGroupMapping(IDirect3DRMMesh *iface, D3DRMGROUPINDEX id)
 {
-    FIXME("iface %p, id %#lx stub!\n", iface, id);
+    struct d3drm_mesh *mesh = impl_from_IDirect3DRMMesh(iface);
 
-    return 0;
+    TRACE("iface %p, id %#lx.\n", iface, id);
+
+    if (id >= mesh->nb_groups)
+        return 0;
+
+    return mesh->groups[id].mapping;
 }
 static D3DRMRENDERQUALITY WINAPI d3drm_mesh_GetGroupQuality(IDirect3DRMMesh *iface, D3DRMGROUPINDEX id)
 {
-    FIXME("iface %p, id %#lx stub!\n", iface, id);
+    struct d3drm_mesh *mesh = impl_from_IDirect3DRMMesh(iface);
 
-    return 0;
+    TRACE("iface %p, id %#lx.\n", iface, id);
+
+    if (id >= mesh->nb_groups)
+        return 0;
+
+    return mesh->groups[id].quality;
 }
 
