From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: in the shell's desktop a key goes to the foreground window, not the window under the pointer

Windows gives the keyboard to the foreground thread. In the shell's desktop the X focus is
on the desktop's X window whenever the foreground has no X window of its own (the taskbar,
Start, explorer's popup menus), and X then hands a key to the X window under the pointer
inside it -- another program's. Wine queued that key to the window's own thread, which is
not the foreground's: Win+X, T with the pointer resting over File Explorer never reached the
menu (wineserver trace: File Explorer's thread sent the key, no thread got it). A key now goes
to the foreground window in a virtual desktop when X gave it to its window for the pointer (the
X focus on a window around it); a window holding the X focus itself keeps its keys, as before.

Gate: test/shellkeys-gate.sh (Win+X, T with the pointer resting over File Explorer: failed
on 10.0-1170 to 1180); mutant SG_MUTANT_KEYS_UNDER_POINTER.
---
 dlls/winex11.drv/keyboard.c | 42 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

--- a/dlls/winex11.drv/keyboard.c
+++ b/dlls/winex11.drv/keyboard.c
@@ -1399,6 +1399,27 @@ static void update_lock_state( HWND hwnd, WORD vkey, UINT state, UINT time )
     }
 }
 
+/* Stained Glass OS 9115: whether X gave this key to its window for the X focus -- held by the
+ * window itself or one inside it -- rather than for the pointer being in it while the focus is on
+ * a window around it */
+static BOOL sg_key_for_x_focus( const XKeyEvent *event )
+{
+    Window focus, root, parent, *children;
+    unsigned int count;
+    int revert;
+
+    XGetInputFocus( event->display, &focus, &revert );
+    if (focus == None || focus == PointerRoot) return FALSE;
+    while (focus != event->window)
+    {
+        if (!XQueryTree( event->display, focus, &root, &parent, &children, &count )) return FALSE;
+        if (children) XFree( children );
+        if (!parent || focus == root) return FALSE;
+        focus = parent;
+    }
+    return TRUE;
+}
+
 /***********************************************************************
  *           X11DRV_KeyEvent
  *
@@ -1542,6 +1563,27 @@ BOOL X11DRV_KeyEvent( HWND hwnd, XEvent *xev )
     if ( event->type == KeyRelease ) dwFlags |= KEYEVENTF_KEYUP;
     if ( vkey & 0x100 )              dwFlags |= KEYEVENTF_EXTENDEDKEY;
 
+#ifndef SG_MUTANT_KEYS_UNDER_POINTER
+    /* Stained Glass OS 9115: in the shell's desktop a key goes to the foreground window, as
+     * Windows gives the keyboard to the foreground thread. The X focus is on the desktop's X
+     * window when the foreground has no X window of its own (the taskbar, Start, explorer's
+     * menus), and X then hands a key to whatever window lies under the pointer inside it:
+     * another program's -- Win+X, T with the pointer over File Explorer went to File
+     * Explorer's thread, not to the menu, and was lost. A key the window got because it holds
+     * the X focus (itself or a window inside it) is its own, as before. */
+    if (is_virtual_desktop() && !sg_key_for_x_focus( event ))
+    {
+        HWND foreground = NtUserGetForegroundWindow();
+
+        if (foreground && foreground != NtUserGetDesktopWindow() &&
+            (!hwnd || NtUserGetAncestor( hwnd, GA_ROOT ) != foreground))
+        {
+            TRACE_(key)( "key for %p, under the pointer, goes to the foreground %p\n", hwnd, foreground );
+            hwnd = foreground;
+        }
+    }
+#endif
+
     update_lock_state( hwnd, vkey, event->state, event_time );
 
     X11DRV_send_keyboard_input( hwnd, vkey & 0xff, bScan, dwFlags, event_time );
