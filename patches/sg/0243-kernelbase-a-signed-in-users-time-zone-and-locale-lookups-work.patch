From: Stained Glass OS <dev@stained-glass.example>
Subject: kernelbase: a signed-in user's time zone and locale lookups work in a shared prefix

kernelbase opened HKLM's Time Zones and Control\Nls keys with KEY_ALL_ACCESS,
which in a shared (system) prefix only administrators get -- a signed-in
user, even an administrator with a filtered token, is refused. Both handles
stayed NULL: GetTimeZoneInformation returned TIME_ZONE_ID_INVALID with the
zone's name an unresolved "@tzres.dll,-47168", GetTimeZoneInformationForYear
failed (Firefox's Rust time code panicked "No such local time" on its first
page), and EnumSystemCodePages and EnumSystemLanguageGroups found nothing.
They are only read: when full access is refused they are opened for reading,
and the zones' keys are read with KEY_READ.

Found by the 2026-09-26 ISO QA pass. Gate: test/userlocale-gate.sh
(make test-userlocale).
---
--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -1950,10 +1950,21 @@
     RtlInitCodePageTable( ansi_ptr, &ansi_cpinfo );
     RtlInitCodePageTable( oem_ptr, &oem_cpinfo );
 
-    RegCreateKeyExW( HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Nls",
-                     0, NULL, REG_OPTION_NON_VOLATILE, KEY_ALL_ACCESS, NULL, &nls_key, NULL );
-    RegCreateKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion\\Time Zones",
-                     0, NULL, REG_OPTION_NON_VOLATILE, KEY_ALL_ACCESS, NULL, &tz_key, NULL );
+    /* Stained Glass OS: in a shared (system) prefix HKLM is administrators-
+     * write, and a signed-in user -- even an administrator, whose token is
+     * filtered -- is refused KEY_ALL_ACCESS: both handles stayed NULL, so
+     * every time-zone lookup failed (GetTimeZoneInformation returned
+     * TIME_ZONE_ID_INVALID, GetTimeZoneInformationForYear FALSE: Firefox
+     * panicked "No such local time" on its first page) and the locale, code
+     * page and language group enumerations found nothing. They are only
+     * read, so fall back to read access, as Windows gives users. */
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Nls",
+                         0, NULL, REG_OPTION_NON_VOLATILE, KEY_ALL_ACCESS, NULL, &nls_key, NULL ))
+        RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Nls", 0, KEY_READ, &nls_key );
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion\\Time Zones",
+                         0, NULL, REG_OPTION_NON_VOLATILE, KEY_ALL_ACCESS, NULL, &tz_key, NULL ))
+        RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion\\Time Zones",
+                       0, KEY_READ, &tz_key );
     RegCreateKeyExW( HKEY_CURRENT_USER, L"Control Panel\\International",
                      0, NULL, REG_OPTION_NON_VOLATILE, KEY_ALL_ACCESS, NULL, &intl_key, NULL );
 
