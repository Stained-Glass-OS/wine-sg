+/* The content of the body moves into a new child and the body becomes the multipart container. */
+static HRESULT body_to_multipart(MimeMessage *This, body_t *body, const char *sub, body_t **child_out)
+{
+    MimeBody *mb = body->mime_body, *cb;
+    header_t *header, *next;
+    body_t *child;
+    ENCODINGTYPE enc;
