+    schema_prop_t *prop;
+    BOOL found = FALSE;
+
+    AcquireSRWLockShared(&schema_lock);
+    LIST_FOR_EACH_ENTRY(prop, &schema_props, schema_prop_t, entry)
+    {
+        if (name ? !lstrcmpiA(prop->prop.name, name) : prop->prop.id == id)
+        {
+            *out = prop->prop;
+            found = TRUE;
+            break;
+        }
+    }
+    ReleaseSRWLockShared(&schema_lock);
+    return found;
+}
