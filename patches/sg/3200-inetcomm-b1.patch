+/* a quoted string or an atom; moves *p past it. The text is allocated. */
+static char *next_astring(const char **p)
+{
+    const char *s = *p;
+    char *out, *o;
+
+    while (*s == ' ') s++;
+    if (*s == '"')
+    {
+        o = out = malloc(strlen(s) + 1);
+        for (s++; *s && *s != '"'; s++)
+        {
+            if (*s == '\\' && s[1]) s++;
+            *o++ = *s;
+        }
+        *o = 0;
+        if (*s == '"') s++;
+    }
+    else
+    {
+        const char *start = s;
+        while (*s && *s != ' ' && *s != ')' && *s != '(') s++;
+        out = malloc(s - start + 1);
+        memcpy(out, start, s - start);
+        out[s - start] = 0;
+    }
+    *p = s;
+    return out;
+}
+
+static void update_seq(IMAPTransport *This, DWORD msn, DWORD uid)
+{
+    if (!msn) return;
+    if (msn > This->seq_count)
+    {
+        DWORD *bigger = realloc(This->seq_to_uid, msn * sizeof(DWORD));
+        if (!bigger) return;
+        memset(bigger + This->seq_count, 0, (msn - This->seq_count) * sizeof(DWORD));
+        This->seq_to_uid = bigger;
+        This->seq_count = msn;
+    }
+    This->seq_to_uid[msn - 1] = uid;
+}
+
+static BOOL parse_internal_date(const char *s, FILETIME *ft)
+{
+    static const char months[] = "JanFebMarAprMayJunJulAugSepOctNovDec";
+    SYSTEMTIME st = {0};
+    char mon[4] = {0};
+    int day, year, h, m, sec, zone = 0, i;
+    char sign = '+';
+
+    while (*s == ' ') s++;
+    if (sscanf(s, "%d-%3s-%d %d:%d:%d %c%d", &day, mon, &year, &h, &m, &sec, &sign, &zone) < 6) return FALSE;
+    for (i = 0; i < 12; i++) if (!strncasecmp(mon, months + i * 3, 3)) break;
+    if (i == 12) return FALSE;
+    st.wDay = day; st.wMonth = i + 1; st.wYear = year; st.wHour = h; st.wMinute = m; st.wSecond = sec;
+    if (!SystemTimeToFileTime(&st, ft)) return FALSE;
+    /* the zone is subtracted to get UTC */
+    {
+        LONGLONG offset = ((zone / 100) * 60 + zone % 100) * 60 * 10000000LL;
+        ULARGE_INTEGER u;
+        u.LowPart = ft->dwLowDateTime; u.HighPart = ft->dwHighDateTime;
+#ifdef SG_MUTANT_INET_IMAP_DATE
+        u.QuadPart = sign == '-' ? u.QuadPart - offset : u.QuadPart + offset;
+#else
+        u.QuadPart = sign == '-' ? u.QuadPart + offset : u.QuadPart - offset;
+#endif
+        ft->dwLowDateTime = u.LowPart; ft->dwHighDateTime = u.HighPart;
+    }
+    return TRUE;
+}
