+static char *encode_base64_lines(const BYTE *data, SIZE_T size, SIZE_T *length)
+{
+    static const char table[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    SIZE_T i, n = 0, col = 0;
+    char *out = malloc((size + 2) / 3 * 4 + (size / 57 + 1) * 2 + 1);
+
+    if (!out) return NULL;
+    for (i = 0; i < size; i += 3)
+    {
+        DWORD v = data[i] << 16;
+        if (i + 1 < size) v |= data[i + 1] << 8;
+        if (i + 2 < size) v |= data[i + 2];
+        out[n++] = table[v >> 18 & 63];
+        out[n++] = table[v >> 12 & 63];
+        out[n++] = i + 1 < size ? table[v >> 6 & 63] : '=';
+        out[n++] = i + 2 < size ? table[v & 63] : '=';
+        if ((col += 4) >= 76 && i + 3 < size) { out[n++] = '\r'; out[n++] = '\n'; col = 0; }
+    }
+    if (size) { out[n++] = '\r'; out[n++] = '\n'; }
+    out[n] = 0;
+    *length = n;
+    return out;
+}
