+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "mimeole.h"
+#include "wine/list.h"
+#include "wine/debug.h"
+
+#include "inetcomm_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(inetcomm);
+
+/* the header of each address type; type n is the bit 1 << n. The first types are the predefined ones. */
+#define ADDRESS_TYPE_COUNT 32
+#define FIRST_CUSTOM_TYPE 11
+static const char *address_types[ADDRESS_TYPE_COUNT] =
+{
+    "From", "Sender", "To", "Cc", "Bcc", "Reply-To", "Return-Path", "Return-Receipt-To", "Rr", "Apparently-To",
+    "Disposition-Notification-To",
+};
+static SRWLOCK address_types_lock = SRWLOCK_INIT;
+
+/* A new address type for the named header: the bit of an existing type of that name or the next free one. */
+HRESULT MimeAddressTypes_register(const char *name, DWORD *type)
+{
+    HRESULT hr = S_OK;
+    int i;
+
+    AcquireSRWLockExclusive(&address_types_lock);
+    for (i = 0; i < ADDRESS_TYPE_COUNT && address_types[i]; i++)
+        if (!lstrcmpiA(address_types[i], name)) break;
+    if (i == ADDRESS_TYPE_COUNT) hr = E_FAIL;  /* documented: MIME_E_NO_MORE_ADDRESS_TYPES, whose value is not known */
+    else if (!address_types[i])
+    {
+        char *copy = malloc(strlen(name) + 1);
+        if (copy) address_types[i] = strcpy(copy, name);
+        else hr = E_OUTOFMEMORY;
+    }
+    ReleaseSRWLockExclusive(&address_types_lock);
+    if (SUCCEEDED(hr)) *type = 1u << i;
+    return hr;
+}
+
+typedef struct
+{
+    struct list entry;
+    HADDRESS handle;
+    DWORD type;
+    ENCODINGTYPE enc;
+    char *friendly;
+    char *email;
+    HCHARSET charset;
+    DWORD cookie;
+    CERTSTATE certstate;
+    BLOB signing, encryption;
+} address_t;
+
+typedef struct
+{
+    IMimeAddressTable IMimeAddressTable_iface;
+    LONG ref;
+    IMimePropertySet *props;
+    struct list addrs;
+    DWORD next_handle;
+    char *cached[ADDRESS_TYPE_COUNT];
+    BOOL loaded;
+} address_table;
+
+static inline address_table *impl_from_IMimeAddressTable(IMimeAddressTable *iface)
+{
+    return CONTAINING_RECORD(iface, address_table, IMimeAddressTable_iface);
+}
+
+static char *dup_string(const char *s)
+{
+    char *ret;
+    if (!s) return NULL;
+    ret = malloc(strlen(s) + 1);
+    if (ret) strcpy(ret, s);
+    return ret;
+}
+
+static char *com_dup_string(const char *s)
+{
+    char *ret = CoTaskMemAlloc(strlen(s) + 1);
+    if (ret) strcpy(ret, s);
+    return ret;
+}
+
+static void free_address(address_t *addr)
+{
+    free(addr->friendly);
+    free(addr->email);
+    free(addr->signing.pBlobData);
+    free(addr->encryption.pBlobData);
+    free(addr);
+}
+
+static void free_addresses(struct list *list)
+{
+    address_t *addr, *next;
+    LIST_FOR_EACH_ENTRY_SAFE(addr, next, list, address_t, entry)
+    {
+        list_remove(&addr->entry);
+        free_address(addr);
+    }
+}
+
+static int type_index(DWORD type)
+{
+    int i;
+
+    if (!type || (type & (type - 1))) return -1;
+    for (i = 0; !(type & (1u << i)); i++) {}
+    return address_types[i] ? i : -1;
+}
+
+/* a single known address type */
+static BOOL valid_single_type(DWORD type)
+{
+    return type_index(type) >= 0;
+}
+
+static char *trim_copy(const char *start, const char *end)
+{
+    char *ret;
+    while (start < end && (*start == ' ' || *start == '\t' || *start == '\r' || *start == '\n')) start++;
+    while (end > start && (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' || end[-1] == '\n')) end--;
+    if (!(ret = malloc(end - start + 1))) return NULL;
+    memcpy(ret, start, end - start);
+    ret[end - start] = 0;
+    return ret;
+}
+
+/* a quoted string loses its quotes and backslashes */
+static void unquote(char *s)
+{
+    char *in = s, *out = s;
+    BOOL quoted = FALSE;
+
+    while (*in)
+    {
+        if (*in == '"') { quoted = !quoted; in++; continue; }
+        if (*in == '\\' && in[1]) in++;
+        *out++ = *in++;
+    }
+    *out = 0;
+}
+
+static char *decode_text(const char *text)
+{
+    PROPVARIANT value;
+    RFC1522INFO info = { TRUE };
+    char *ret = NULL;
+
+    PropVariantInit(&value);
+    value.vt = VT_LPSTR;
+    if (SUCCEEDED(MimeOleDecodeHeader(NULL, text, &value, &info)) && value.vt == VT_LPSTR && value.pszVal)
+        ret = dup_string(value.pszVal);
+    PropVariantClear(&value);
+    return ret ? ret : dup_string(text);
+}
+
+static char *encode_text(const char *text)
+{
+    PROPVARIANT value;
+    RFC1522INFO info = { TRUE };
+    char *encoded = NULL, *ret;
+
+    PropVariantInit(&value);
+    value.vt = VT_LPSTR;
+    value.pszVal = (char *)text;
+    if (FAILED(MimeOleEncodeHeader(NULL, &value, &encoded, &info)) || !encoded) return dup_string(text);
+    ret = dup_string(encoded);
+    CoTaskMemFree(encoded);
+    return ret;
+}
+
+static address_t *new_address(DWORD type, ENCODINGTYPE enc, const char *friendly, const char *email)
+{
+    address_t *addr = calloc(1, sizeof(*addr));
+
+    if (!addr) return NULL;
+    addr->type = type;
+    addr->enc = IET_DECODED;
+    if (friendly && *friendly)
+        addr->friendly = enc == IET_ENCODED ? decode_text(friendly) : dup_string(friendly);
+    addr->email = dup_string(email);
+    if (!addr->email || (friendly && *friendly && !addr->friendly))
+    {
+        free_address(addr);
+        return NULL;
+    }
+    return addr;
+}
+
+/* One address entry: "Name <user@host>", "user@host (Name)", "<user@host>" or "user@host" */
+static address_t *parse_entry(const char *start, const char *end, DWORD type, ENCODINGTYPE enc)
+{
+    const char *p, *open = NULL, *close = NULL, *comment = NULL, *comment_end = NULL;
+    char *name = NULL, *mail = NULL;
+    address_t *addr = NULL;
+    BOOL quoted = FALSE;
+    int depth = 0;
+
+    for (p = start; p < end; p++)
+    {
+        if (*p == '\\' && p + 1 < end) { p++; continue; }
+        if (*p == '"' && !depth) { quoted = !quoted; continue; }
+        if (quoted) continue;
+        if (*p == '(') { if (!depth++ && !comment) comment = p + 1; }
+        else if (*p == ')' && depth) { if (!--depth && !comment_end) comment_end = p; }
+        else if (!depth && *p == '<' && !open) open = p;
+        else if (!depth && *p == '>' && open && !close) close = p;
+    }
+
+    if (open && close)
+    {
+        mail = trim_copy(open + 1, close);
+        name = trim_copy(start, open);
+        if (name && !*name && comment && comment_end)
+        {
+            free(name);
+            name = trim_copy(comment, comment_end);
+        }
+    }
+    else
+    {
+        const char *mail_end = comment ? comment - 1 : end;
+        mail = trim_copy(start, mail_end);
+        if (comment && comment_end) name = trim_copy(comment, comment_end);
+    }
+    if (name) unquote(name);
+    if (mail && strchr(mail, '"')) unquote(mail);
+    if (mail && *mail) addr = new_address(type, enc, name, mail);
+    free(name);
+    free(mail);
+    return addr;
+}
+
+/* The addresses of a header value or an RFC 822 address string, in order. Groups contribute their members. */
+static void parse_addresses(const char *text, DWORD type, ENCODINGTYPE enc, struct list *out)
+{
+    const char *p = text, *start = text;
+    BOOL quoted = FALSE;
+    int angle = 0, paren = 0;
+    address_t *addr;
+
+    list_init(out);
+    for (;; p++)
+    {
+        BOOL end = !*p;
+
+        if (!end)
+        {
+            if (*p == '\\' && p[1]) { p++; continue; }
+            if (*p == '"' && !paren) { quoted = !quoted; continue; }
+            if (quoted) continue;
+            if (*p == '(') paren++;
+            else if (*p == ')' && paren) paren--;
+            if (paren) continue;
+            if (*p == '<') angle++;
+            else if (*p == '>' && angle) angle--;
+            else if (!angle && *p == ':') { start = p + 1; continue; }  /* the name of a group */
+        }
+        if (end || (!angle && (*p == ',' || *p == ';')))
+        {
+            if ((addr = parse_entry(start, p, type, enc))) list_add_tail(out, &addr->entry);
+            start = p + 1;
+            if (end) break;
+        }
+    }
+}
+
+static BOOL needs_quotes(const char *s)
+{
+    for (; *s; s++)
+        if (strchr("()<>@,;:\\\".[]", *s)) return TRUE;
+    return FALSE;
+}
+
+static void append_text(char **buf, size_t *len, size_t *cap, const char *text)
+{
+    size_t n = strlen(text);
+
+    if (*len + n + 1 > *cap)
+    {
+        char *bigger;
+        *cap = (*len + n + 1) * 2;
+        if (!(bigger = realloc(*buf, *cap))) return;
+        *buf = bigger;
+    }
+    memcpy(*buf + *len, text, n + 1);
+    *len += n;
+}
+
+static void append_quoted(char **buf, size_t *len, size_t *cap, const char *name)
+{
+    char one[2] = {0, 0};
+
+    append_text(buf, len, cap, "\"");
+    for (; *name; name++)
+    {
+        if (*name == '"' || *name == '\\') append_text(buf, len, cap, "\\");
+        one[0] = *name;
+        append_text(buf, len, cap, one);
+    }
+    append_text(buf, len, cap, "\"");
+}
+
+/* the text of the addresses matching 'types' in one of the ADDRESSFORMAT layouts */
+static char *format_addresses(address_table *table, DWORD types, ADDRESSFORMAT format)
+{
+    size_t len = 0, cap = 128;
+    char *buf = malloc(cap), *encoded;
+    const char *separator = format >= AFT_RFC822_DECODED ? ", " : "; ";
+    address_t *addr;
+    BOOL first = TRUE;
+    size_t line = 0;
+
+    if (!buf) return NULL;
+    buf[0] = 0;
+    LIST_FOR_EACH_ENTRY(addr, &table->addrs, address_t, entry)
+    {
+        const char *friendly = addr->friendly && *addr->friendly ? addr->friendly : NULL;
+        size_t before;
+
+        if (!(addr->type & types)) continue;
+        if (!first)
+        {
+            append_text(&buf, &len, &cap, separator);
+            line += strlen(separator);
+        }
+        first = FALSE;
+        before = len;
+
+        switch (format)
+        {
+        case AFT_DISPLAY_FRIENDLY:
+            append_text(&buf, &len, &cap, friendly ? friendly : addr->email);
+            break;
+        case AFT_DISPLAY_EMAIL:
+            append_text(&buf, &len, &cap, addr->email);
+            break;
+        case AFT_DISPLAY_BOTH:
+            if (friendly && strcmp(friendly, addr->email))
+            {
+                append_text(&buf, &len, &cap, friendly);
+#ifdef SG_MUTANT_INET_ADDR_FORMAT
+                append_text(&buf, &len, &cap, " ");
+#else
+                append_text(&buf, &len, &cap, " <");
+#endif
+                append_text(&buf, &len, &cap, addr->email);
+                append_text(&buf, &len, &cap, ">");
+            }
+            else append_text(&buf, &len, &cap, addr->email);
+            break;
+        default:
+            if (friendly && strcmp(friendly, addr->email))
+            {
+                if (format != AFT_RFC822_DECODED && (encoded = encode_text(friendly)))
+                {
+                    if (strcmp(encoded, friendly)) append_text(&buf, &len, &cap, encoded);
+                    else if (needs_quotes(friendly)) append_quoted(&buf, &len, &cap, friendly);
+                    else append_text(&buf, &len, &cap, friendly);
+                    free(encoded);
+                }
+                else if (needs_quotes(friendly)) append_quoted(&buf, &len, &cap, friendly);
+                else append_text(&buf, &len, &cap, friendly);
+                append_text(&buf, &len, &cap, " <");
+                append_text(&buf, &len, &cap, addr->email);
+                append_text(&buf, &len, &cap, ">");
+            }
+            else append_text(&buf, &len, &cap, addr->email);
+            /* a transmitted header may be wrapped between addresses */
+            if (format == AFT_RFC822_TRANSMIT && line + (len - before) > 76 && before > 0 && buf[before - 1] == ' ')
+            {
+                append_text(&buf, &len, &cap, "  ");
+                memmove(buf + before + 2, buf + before, len - before - 2 + 1);
+                buf[before - 1] = '\r';
+                buf[before] = '\n';
+                buf[before + 1] = '\t';
+                line = 0;
+            }
+            break;
+        }
+        line += len - before;
+    }
+    return buf;
+}
+
+static void clear_cached(address_table *table)
+{
+    int i;
+    for (i = 0; i < ARRAY_SIZE(table->cached); i++)
+    {
+        free(table->cached[i]);
+        table->cached[i] = NULL;
+    }
+}
+
+static char *get_header(address_table *table, int idx)
+{
+    PROPVARIANT value;
+    char *ret = NULL;
+
+    PropVariantInit(&value);
+    value.vt = VT_LPSTR;
+    if (IMimePropertySet_GetProp(table->props, address_types[idx], 0, &value) == S_OK &&
+        value.vt == VT_LPSTR && value.pszVal)
+        ret = dup_string(value.pszVal);
+    PropVariantClear(&value);
+    return ret;
+}
+
+static void remove_type(address_table *table, DWORD type)
+{
+    address_t *addr, *next;
+    LIST_FOR_EACH_ENTRY_SAFE(addr, next, &table->addrs, address_t, entry)
+    {
+        if (addr->type != type) continue;
+        list_remove(&addr->entry);
+        free_address(addr);
+    }
+}
+
+/* take over what other code changed in the headers since the last look */
+static void refresh(address_table *table)
+{
+    int i;
+
+    if (!table->props) return;
+    for (i = 0; i < ADDRESS_TYPE_COUNT && address_types[i]; i++)
+    {
+        char *current = get_header(table, i);
+        struct list parsed;
+        address_t *addr, *next;
+
+        if (table->loaded && ((!current && !table->cached[i]) ||
+            (current && table->cached[i] && !strcmp(current, table->cached[i]))))
+        {
+            free(current);
+            continue;
+        }
+        remove_type(table, (1u << i));
+        if (current)
+        {
+            parse_addresses(current, (1u << i), IET_ENCODED, &parsed);
+            LIST_FOR_EACH_ENTRY_SAFE(addr, next, &parsed, address_t, entry)
+            {
+                list_remove(&addr->entry);
+                addr->handle = ULongToHandle(++table->next_handle);
+                list_add_tail(&table->addrs, &addr->entry);
+            }
+        }
+        free(table->cached[i]);
+        table->cached[i] = current;
+    }
+    table->loaded = TRUE;
+}
+
+/* write the addresses of one type back into its header */
+static void sync_type(address_table *table, DWORD type)
+{
+    int idx = type_index(type);
+    char *text;
+
+    if (idx < 0 || !table->props) return;
+    text = format_addresses(table, type, AFT_RFC822_TRANSMIT);
+    free(table->cached[idx]);
+    table->cached[idx] = NULL;
+    if (text && *text)
+    {
+        PROPVARIANT value;
+        PropVariantInit(&value);
+        value.vt = VT_LPSTR;
+        value.pszVal = text;
+    #ifndef SG_MUTANT_INET_ADDR_SYNC
+        IMimePropertySet_SetProp(table->props, address_types[idx], 0, &value);
+#endif
+        table->cached[idx] = text;
+        return;
+    }
+    free(text);
+    IMimePropertySet_DeleteProp(table->props, address_types[idx]);
+}
+
+static address_t *find_address(address_table *table, HADDRESS handle)
+{
+    address_t *addr;
+    LIST_FOR_EACH_ENTRY(addr, &table->addrs, address_t, entry)
+        if (addr->handle == handle) return addr;
+    return NULL;
+}
+
+static HRESULT copy_blob(BLOB *to, const BLOB *from)
+{
+    free(to->pBlobData);
+    to->pBlobData = NULL;
+    to->cbSize = 0;
+    if (!from->cbSize || !from->pBlobData) return S_OK;
+    if (!(to->pBlobData = malloc(from->cbSize))) return E_OUTOFMEMORY;
+    memcpy(to->pBlobData, from->pBlobData, from->cbSize);
+    to->cbSize = from->cbSize;
+    return S_OK;
+}
+
+/* fill the properties the caller asked for in props->dwProps */
+static HRESULT fill_props(const address_t *addr, ADDRESSPROPS *props)
+{
+    DWORD wanted = props->dwProps;
+
+    props->pszFriendly = NULL;
+    props->pszEmail = NULL;
+    props->pwszReserved = NULL;
+    memset(&props->tbSigning, 0, sizeof(props->tbSigning));
+    memset(&props->tbEncryption, 0, sizeof(props->tbEncryption));
+
+    if (wanted & IAP_HANDLE) props->hAddress = addr->handle;
+    if (wanted & IAP_CHARSET) props->hCharset = addr->charset;
+    if (wanted & IAP_ADRTYPE) props->dwAdrType = addr->type;
+    if (wanted & IAP_ENCODING) props->ietFriendly = addr->enc;
+    if (wanted & IAP_COOKIE) props->dwCookie = addr->cookie;
+    if (wanted & IAP_CERTSTATE) props->certstate = addr->certstate;
+    if ((wanted & IAP_FRIENDLY) && addr->friendly && !(props->pszFriendly = com_dup_string(addr->friendly)))
+        return E_OUTOFMEMORY;
+    if ((wanted & IAP_FRIENDLYW) && addr->friendly)
+    {
+        int n = MultiByteToWideChar(CP_ACP, 0, addr->friendly, -1, NULL, 0);
+        if ((props->pwszReserved = CoTaskMemAlloc(n * sizeof(WCHAR))))
+            MultiByteToWideChar(CP_ACP, 0, addr->friendly, -1, props->pwszReserved, n);
+    }
+    if ((wanted & IAP_EMAIL) && !(props->pszEmail = com_dup_string(addr->email))) return E_OUTOFMEMORY;
+    if ((wanted & IAP_SIGNING_PRINT) && addr->signing.cbSize &&
+        (props->tbSigning.pBlobData = CoTaskMemAlloc(addr->signing.cbSize)))
+    {
+        memcpy(props->tbSigning.pBlobData, addr->signing.pBlobData, addr->signing.cbSize);
+        props->tbSigning.cbSize = addr->signing.cbSize;
+    }
+    if ((wanted & IAP_ENCRYPTION_PRINT) && addr->encryption.cbSize &&
+        (props->tbEncryption.pBlobData = CoTaskMemAlloc(addr->encryption.cbSize)))
+    {
+        memcpy(props->tbEncryption.pBlobData, addr->encryption.pBlobData, addr->encryption.cbSize);
+        props->tbEncryption.cbSize = addr->encryption.cbSize;
+    }
+    return S_OK;
+}
+
+static HRESULT apply_props(address_t *addr, const ADDRESSPROPS *props)
+{
+    DWORD set = props->dwProps;
+    char *text;
+
+    if ((set & IAP_EMAIL) && props->pszEmail && *props->pszEmail)
+    {
+        if (!(text = dup_string(props->pszEmail))) return E_OUTOFMEMORY;
+        free(addr->email);
+        addr->email = text;
+    }
+    if (set & IAP_FRIENDLY)
+    {
+        free(addr->friendly);
+        addr->friendly = NULL;
+        if (props->pszFriendly && *props->pszFriendly)
+        {
+            ENCODINGTYPE enc = (set & IAP_ENCODING) ? props->ietFriendly : IET_DECODED;
+            addr->friendly = enc == IET_ENCODED ? decode_text(props->pszFriendly) : dup_string(props->pszFriendly);
+        }
+    }
+    else if ((set & IAP_FRIENDLYW) && props->pwszReserved)
+    {
+        int n = WideCharToMultiByte(CP_ACP, 0, props->pwszReserved, -1, NULL, 0, NULL, NULL);
+        free(addr->friendly);
+        if ((addr->friendly = malloc(n)))
+            WideCharToMultiByte(CP_ACP, 0, props->pwszReserved, -1, addr->friendly, n, NULL, NULL);
+    }
+    if (set & IAP_CHARSET) addr->charset = props->hCharset;
+    if (set & IAP_COOKIE) addr->cookie = props->dwCookie;
+    if (set & IAP_CERTSTATE) addr->certstate = props->certstate;
+    if (set & IAP_SIGNING_PRINT) copy_blob(&addr->signing, &props->tbSigning);
+    if (set & IAP_ENCRYPTION_PRINT) copy_blob(&addr->encryption, &props->tbEncryption);
+    return S_OK;
+}
+
+static HRESULT list_to_array(struct list *list, DWORD types, DWORD wanted, ADDRESSLIST *out, BOOL parsed_only)
+{
+    ULONG count = 0, i = 0;
+    address_t *addr;
+    ADDRESSPROPS *array;
+
+    LIST_FOR_EACH_ENTRY(addr, list, address_t, entry)
+        if (addr->type & types) count++;
+    out->cAdrs = 0;
+    out->prgAdr = NULL;
+    if (!count) return S_OK;
+    if (!(array = CoTaskMemAlloc(count * sizeof(*array)))) return E_OUTOFMEMORY;
+    memset(array, 0, count * sizeof(*array));
+    LIST_FOR_EACH_ENTRY(addr, list, address_t, entry)
+    {
+        if (!(addr->type & types)) continue;
+        array[i].dwProps = wanted;
+        fill_props(addr, &array[i]);
+        i++;
+    }
+    out->cAdrs = count;
+    out->prgAdr = array;
+    return S_OK;
+}
+
+static HRESULT WINAPI address_table_QueryInterface(IMimeAddressTable *iface, REFIID riid, void **ppv)
+{
+    TRACE("(%p)->(%s, %p)\n", iface, debugstr_guid(riid), ppv);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IMimeAddressTable))
+    {
+        *ppv = iface;
+        IMimeAddressTable_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    FIXME("no interface for %s\n", debugstr_guid(riid));
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI address_table_AddRef(IMimeAddressTable *iface)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI address_table_Release(IMimeAddressTable *iface)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        free_addresses(&This->addrs);
+        clear_cached(This);
+        if (This->props) IMimePropertySet_Release(This->props);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT add_address(address_table *This, address_t *addr, HADDRESS *handle)
+{
+    addr->handle = ULongToHandle(++This->next_handle);
+    list_add_tail(&This->addrs, &addr->entry);
+    if (handle) *handle = addr->handle;
+    return S_OK;
+}
+
+static HRESULT WINAPI address_table_Append(IMimeAddressTable *iface, DWORD type, ENCODINGTYPE enc,
+        const char *friendly, const char *email, HADDRESS *handle)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    address_t *addr;
+
+    TRACE("(%p)->(%08lx, %d, %s, %s, %p)\n", iface, type, enc, debugstr_a(friendly), debugstr_a(email), handle);
+
+    if (!email || !*email) return E_INVALIDARG;
+#ifndef SG_MUTANT_INET_ADDRTYPE
+    if (!valid_single_type(type)) return MIME_E_NOT_FOUND;
+#endif
+    refresh(This);
+    if (!(addr = new_address(type, enc, friendly, email))) return E_OUTOFMEMORY;
+    add_address(This, addr, handle);
+    sync_type(This, type);
+    return S_OK;
+}
+
+static HRESULT WINAPI address_table_Insert(IMimeAddressTable *iface, ADDRESSPROPS *props, HADDRESS *handle)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    address_t *addr;
+    DWORD type;
+
+    TRACE("(%p)->(%p, %p)\n", iface, props, handle);
+
+    if (!props || !(props->dwProps & IAP_EMAIL) || !props->pszEmail || !*props->pszEmail) return E_INVALIDARG;
+    type = (props->dwProps & IAP_ADRTYPE) ? props->dwAdrType : IAT_TO;
+    if (!valid_single_type(type)) return MIME_E_NOT_FOUND;
+    refresh(This);
+    if (!(addr = new_address(type, IET_DECODED, NULL, props->pszEmail))) return E_OUTOFMEMORY;
+    apply_props(addr, props);
+    add_address(This, addr, handle);
+    sync_type(This, type);
+    return S_OK;
+}
+
+static HRESULT WINAPI address_table_SetProps(IMimeAddressTable *iface, HADDRESS handle, ADDRESSPROPS *props)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    address_t *addr;
+    DWORD old_type;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p, %p)\n", iface, handle, props);
+
+    if (!props) return E_INVALIDARG;
+    refresh(This);
+    if (!(addr = find_address(This, handle))) return MIME_E_INVALID_HANDLE;
+    if ((props->dwProps & IAP_ADRTYPE) && !valid_single_type(props->dwAdrType)) return MIME_E_NOT_FOUND;
+    old_type = addr->type;
+    if (FAILED(hr = apply_props(addr, props))) return hr;
+    if (props->dwProps & IAP_ADRTYPE) addr->type = props->dwAdrType;
+    sync_type(This, old_type);
+    if (addr->type != old_type) sync_type(This, addr->type);
+    return S_OK;
+}
+
+static HRESULT WINAPI address_table_GetProps(IMimeAddressTable *iface, HADDRESS handle, ADDRESSPROPS *props)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    address_t *addr;
+
+    TRACE("(%p)->(%p, %p)\n", iface, handle, props);
+
+    if (!props) return E_INVALIDARG;
+    refresh(This);
+    if (!(addr = find_address(This, handle))) return MIME_E_INVALID_HANDLE;
+    return fill_props(addr, props);
+}
+
+static HRESULT WINAPI address_table_GetSender(IMimeAddressTable *iface, ADDRESSPROPS *props)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    address_t *addr;
+#ifdef SG_MUTANT_INET_SENDER
+    DWORD types[] = { IAT_SENDER, IAT_FROM };
+#else
+    DWORD types[] = { IAT_FROM, IAT_SENDER };
+#endif
+    int i;
+
+    TRACE("(%p)->(%p)\n", iface, props);
+
+    if (!props) return E_INVALIDARG;
+    refresh(This);
+    /* the From header first, the Sender header when there is no From */
+    for (i = 0; i < ARRAY_SIZE(types); i++)
+        LIST_FOR_EACH_ENTRY(addr, &This->addrs, address_t, entry)
+            if (addr->type == types[i]) return fill_props(addr, props);
+    return MIME_E_NOT_FOUND;
+}
+
+static HRESULT WINAPI address_table_CountTypes(IMimeAddressTable *iface, DWORD types, ULONG *count)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    address_t *addr;
+
+    TRACE("(%p)->(%08lx, %p)\n", iface, types, count);
+
+    if (!count) return E_INVALIDARG;
+    refresh(This);
+    *count = 0;
+    LIST_FOR_EACH_ENTRY(addr, &This->addrs, address_t, entry)
+        if (addr->type & types) (*count)++;
+    return S_OK;
+}
+
+static HRESULT WINAPI address_table_GetTypes(IMimeAddressTable *iface, DWORD types, DWORD wanted, ADDRESSLIST *list)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+
+    TRACE("(%p)->(%08lx, %08lx, %p)\n", iface, types, wanted, list);
+
+    if (!list) return E_INVALIDARG;
+    refresh(This);
+    return list_to_array(&This->addrs, types, wanted, list, FALSE);
+}
+
+typedef struct
+{
+    IMimeEnumAddressTypes IMimeEnumAddressTypes_iface;
+    LONG ref;
+    ULONG count, pos;
+    DWORD wanted;
+    address_t **items;
+} address_enum;
+
+static inline address_enum *impl_from_IMimeEnumAddressTypes(IMimeEnumAddressTypes *iface)
+{
+    return CONTAINING_RECORD(iface, address_enum, IMimeEnumAddressTypes_iface);
+}
+
+static const IMimeEnumAddressTypesVtbl address_enum_vtbl;
+
+static address_t *copy_address(const address_t *from)
+{
+    address_t *addr = calloc(1, sizeof(*addr));
+
+    if (!addr) return NULL;
+    *addr = *from;
+    addr->friendly = dup_string(from->friendly);
+    addr->email = dup_string(from->email);
+    addr->signing.pBlobData = addr->encryption.pBlobData = NULL;
+    addr->signing.cbSize = addr->encryption.cbSize = 0;
+    copy_blob(&addr->signing, &from->signing);
+    copy_blob(&addr->encryption, &from->encryption);
+    return addr;
+}
+
+static HRESULT WINAPI address_enum_QueryInterface(IMimeEnumAddressTypes *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IMimeEnumAddressTypes))
+    {
+        *ppv = iface;
+        IMimeEnumAddressTypes_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI address_enum_AddRef(IMimeEnumAddressTypes *iface)
+{
+    address_enum *This = impl_from_IMimeEnumAddressTypes(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI address_enum_Release(IMimeEnumAddressTypes *iface)
+{
+    address_enum *This = impl_from_IMimeEnumAddressTypes(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    ULONG i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) free_address(This->items[i]);
+        free(This->items);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI address_enum_Next(IMimeEnumAddressTypes *iface, ULONG count, ADDRESSPROPS *array, ULONG *fetched)
+{
+    address_enum *This = impl_from_IMimeEnumAddressTypes(iface);
+    ULONG done = 0;
+
+    TRACE("(%p)->(%lu, %p, %p)\n", iface, count, array, fetched);
+
+    if (!array && count) return E_INVALIDARG;
+    while (done < count && This->pos < This->count)
+    {
+        array[done].dwProps = This->wanted;
+        if (FAILED(fill_props(This->items[This->pos], &array[done]))) break;
+        This->pos++;
+        done++;
+    }
+    if (fetched) *fetched = done;
+    return done == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI address_enum_Skip(IMimeEnumAddressTypes *iface, ULONG count)
+{
+    address_enum *This = impl_from_IMimeEnumAddressTypes(iface);
+
+    TRACE("(%p)->(%lu)\n", iface, count);
+
+#ifdef SG_MUTANT_INET_ENUM
+    return S_OK;
+#endif
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI address_enum_Reset(IMimeEnumAddressTypes *iface)
+{
+    address_enum *This = impl_from_IMimeEnumAddressTypes(iface);
+
+    TRACE("(%p)\n", iface);
+    This->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI address_enum_Clone(IMimeEnumAddressTypes *iface, IMimeEnumAddressTypes **ret)
+{
+    address_enum *This = impl_from_IMimeEnumAddressTypes(iface), *clone;
+    ULONG i;
+
+    TRACE("(%p)->(%p)\n", iface, ret);
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    if (!(clone = calloc(1, sizeof(*clone)))) return E_OUTOFMEMORY;
+    clone->IMimeEnumAddressTypes_iface.lpVtbl = &address_enum_vtbl;
+    clone->ref = 1;
+    clone->wanted = This->wanted;
+    clone->pos = This->pos;
+    if (This->count && !(clone->items = calloc(This->count, sizeof(*clone->items))))
+    {
+        free(clone);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < This->count; i++)
+    {
+        if (!(clone->items[i] = copy_address(This->items[i])))
+        {
+            IMimeEnumAddressTypes_Release(&clone->IMimeEnumAddressTypes_iface);
+            return E_OUTOFMEMORY;
+        }
+        clone->count++;
+    }
+    *ret = &clone->IMimeEnumAddressTypes_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI address_enum_Count(IMimeEnumAddressTypes *iface, ULONG *count)
+{
+    address_enum *This = impl_from_IMimeEnumAddressTypes(iface);
+
+    TRACE("(%p)->(%p)\n", iface, count);
+
+    if (!count) return E_INVALIDARG;
+    *count = This->count;
+    return S_OK;
+}
+
+static const IMimeEnumAddressTypesVtbl address_enum_vtbl =
+{
+    address_enum_QueryInterface,
+    address_enum_AddRef,
+    address_enum_Release,
+    address_enum_Next,
+    address_enum_Skip,
+    address_enum_Reset,
+    address_enum_Clone,
+    address_enum_Count
+};
+
+static HRESULT WINAPI address_table_EnumTypes(IMimeAddressTable *iface, DWORD types, DWORD wanted,
+        IMimeEnumAddressTypes **ret)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    address_enum *e;
+    address_t *addr;
+
+    TRACE("(%p)->(%08lx, %08lx, %p)\n", iface, types, wanted, ret);
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    refresh(This);
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
+    e->IMimeEnumAddressTypes_iface.lpVtbl = &address_enum_vtbl;
+    e->ref = 1;
+    e->wanted = wanted;
+    LIST_FOR_EACH_ENTRY(addr, &This->addrs, address_t, entry)
+        if (addr->type & types) e->count++;
+    if (e->count && !(e->items = calloc(e->count, sizeof(*e->items))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    e->count = 0;
+    LIST_FOR_EACH_ENTRY(addr, &This->addrs, address_t, entry)
+    {
+        if (!(addr->type & types)) continue;
+        if (!(e->items[e->count] = copy_address(addr)))
+        {
+            IMimeEnumAddressTypes_Release(&e->IMimeEnumAddressTypes_iface);
+            return E_OUTOFMEMORY;
+        }
+        e->count++;
+    }
+    *ret = &e->IMimeEnumAddressTypes_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI address_table_Delete(IMimeAddressTable *iface, HADDRESS handle)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    address_t *addr;
+    DWORD type;
+
+    TRACE("(%p)->(%p)\n", iface, handle);
+
+    refresh(This);
+    if (!(addr = find_address(This, handle))) return MIME_E_INVALID_HANDLE;
+    type = addr->type;
+    list_remove(&addr->entry);
+    free_address(addr);
+    sync_type(This, type);
+    return S_OK;
+}
+
+static HRESULT WINAPI address_table_DeleteTypes(IMimeAddressTable *iface, DWORD types)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    address_t *addr, *next;
+    DWORD changed = 0;
+    int i;
+
+    TRACE("(%p)->(%08lx)\n", iface, types);
+
+    refresh(This);
+    LIST_FOR_EACH_ENTRY_SAFE(addr, next, &This->addrs, address_t, entry)
+    {
+        if (!(addr->type & types)) continue;
+        changed |= addr->type;
+        list_remove(&addr->entry);
+        free_address(addr);
+    }
+    if (!changed) return MIME_E_NOT_FOUND;
+    for (i = 0; i < ADDRESS_TYPE_COUNT && address_types[i]; i++)
+        if (changed & (1u << i)) sync_type(This, (1u << i));
+    return S_OK;
+}
+
+static HRESULT WINAPI address_table_GetFormat(IMimeAddressTable *iface, DWORD types, ADDRESSFORMAT format, char **ret)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    address_t *addr;
+    BOOL found = FALSE;
+    char *text;
+
+    TRACE("(%p)->(%08lx, %d, %p)\n", iface, types, format, ret);
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    if (format > AFT_RFC822_TRANSMIT) return E_INVALIDARG;
+    refresh(This);
+    LIST_FOR_EACH_ENTRY(addr, &This->addrs, address_t, entry)
+        if (addr->type & types) { found = TRUE; break; }
+    if (!found) return MIME_E_NO_DATA;
+    if (!(text = format_addresses(This, types, format))) return E_OUTOFMEMORY;
+    *ret = com_dup_string(text);
+    free(text);
+    return *ret ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI address_table_AppendRfc822(IMimeAddressTable *iface, DWORD type, ENCODINGTYPE enc,
+        const char *rfc822)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface);
+    struct list parsed;
+    address_t *addr, *next;
+
+    TRACE("(%p)->(%08lx, %d, %s)\n", iface, type, enc, debugstr_a(rfc822));
+
+    if (!rfc822) return E_INVALIDARG;
+    if (!valid_single_type(type)) return MIME_E_NOT_FOUND;
+    refresh(This);
+    parse_addresses(rfc822, type, enc, &parsed);
+    LIST_FOR_EACH_ENTRY_SAFE(addr, next, &parsed, address_t, entry)
+    {
+        list_remove(&addr->entry);
+        add_address(This, addr, NULL);
+    }
+    sync_type(This, type);
+    return S_OK;
+}
+
+static HRESULT WINAPI address_table_ParseRfc822(IMimeAddressTable *iface, DWORD type, ENCODINGTYPE enc,
+        const char *rfc822, ADDRESSLIST *list)
+{
+    struct list parsed;
+    HRESULT hr;
+
+    TRACE("(%p)->(%08lx, %d, %s, %p)\n", iface, type, enc, debugstr_a(rfc822), list);
+
+    if (!rfc822 || !list) return E_INVALIDARG;
+    if (!valid_single_type(type)) return MIME_E_NOT_FOUND;
+    parse_addresses(rfc822, type, enc, &parsed);
+    hr = list_to_array(&parsed, type, IAP_FRIENDLY | IAP_EMAIL | IAP_ENCODING | IAP_CHARSET | IAP_ADRTYPE, list, TRUE);
+    free_addresses(&parsed);
+    return hr;
+}
+
+static HRESULT address_table_create(IMimePropertySet *props, IMimeAddressTable **ret);
+
+static HRESULT WINAPI address_table_Clone(IMimeAddressTable *iface, IMimeAddressTable **ret)
+{
+    address_table *This = impl_from_IMimeAddressTable(iface), *clone;
+    address_t *addr, *copy;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", iface, ret);
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    refresh(This);
+    /* a copy that does not write into the headers */
+    if (FAILED(hr = address_table_create(NULL, ret))) return hr;
+    clone = impl_from_IMimeAddressTable(*ret);
+    LIST_FOR_EACH_ENTRY(addr, &This->addrs, address_t, entry)
+    {
+        if (!(copy = copy_address(addr)))
+        {
+            IMimeAddressTable_Release(*ret);
+            *ret = NULL;
+            return E_OUTOFMEMORY;
+        }
+        list_add_tail(&clone->addrs, &copy->entry);
+    }
+    clone->next_handle = This->next_handle;
+    return S_OK;
+}
+
+static HRESULT WINAPI address_table_BindToObject(IMimeAddressTable *iface, REFIID riid, void **ppv)
+{
+    TRACE("(%p)->(%s, %p)\n", iface, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_INVALIDARG;
+    return IMimeAddressTable_QueryInterface(iface, riid, ppv);
+}
+
+static const IMimeAddressTableVtbl address_table_vtbl =
+{
+    address_table_QueryInterface,
+    address_table_AddRef,
+    address_table_Release,
+    address_table_Append,
+    address_table_Insert,
+    address_table_SetProps,
+    address_table_GetProps,
+    address_table_GetSender,
+    address_table_CountTypes,
+    address_table_GetTypes,
+    address_table_EnumTypes,
+    address_table_Delete,
+    address_table_DeleteTypes,
+    address_table_GetFormat,
+    address_table_AppendRfc822,
+    address_table_ParseRfc822,
+    address_table_Clone,
+    address_table_BindToObject
+};
+
+static HRESULT address_table_create(IMimePropertySet *props, IMimeAddressTable **ret)
+{
+    address_table *table = calloc(1, sizeof(*table));
+
+    if (!table) return E_OUTOFMEMORY;
+    table->IMimeAddressTable_iface.lpVtbl = &address_table_vtbl;
+    table->ref = 1;
+    list_init(&table->addrs);
+    table->props = props;
+    if (props) IMimePropertySet_AddRef(props);
+    *ret = &table->IMimeAddressTable_iface;
+    return S_OK;
+}
+
+/* The address table of a property set. The table keeps the property set alive. */
+HRESULT MimeAddressTable_create(IMimePropertySet *props, void **obj)
+{
+    IMimeAddressTable *table;
+    HRESULT hr;
+
+    if (FAILED(hr = address_table_create(props, &table))) return hr;
+    refresh(impl_from_IMimeAddressTable(table));
+    *obj = table;
+    return S_OK;
+}
+
+/***********************************************************************
+ *              MimeGetAddressFormatW (INETCOMM.@)
+ */
+HRESULT WINAPI MimeGetAddressFormatW(REFIID riid, void *object, DWORD types, ADDRESSFORMAT format, WCHAR **ret)
+{
+    IMimeAddressTable *table = NULL;
+    IMimeMessage *message;
+    IMimePropertySet *props;
+    char *text = NULL;
+    HRESULT hr;
+    int n;
+
+    TRACE("(%s, %p, %08lx, %d, %p)\n", debugstr_guid(riid), object, types, format, ret);
+
+    if (!ret || !object) return E_INVALIDARG;
+    *ret = NULL;
+
+    if (IsEqualIID(riid, &IID_IMimeAddressTable))
+    {
+        table = object;
+        IMimeAddressTable_AddRef(table);
+    }
+    else if (IsEqualIID(riid, &IID_IMimeMessage))
+    {
+        message = object;
+        if (FAILED(hr = IMimeMessage_GetAddressTable(message, &table))) return hr;
+    }
+    else if (IsEqualIID(riid, &IID_IMimePropertySet) || IsEqualIID(riid, &IID_IMimeBody))
+    {
+        props = object;
+        if (FAILED(hr = IMimePropertySet_BindToObject(props, &IID_IMimeAddressTable, (void **)&table))) return hr;
+    }
+    else return E_INVALIDARG;
+
+    hr = IMimeAddressTable_GetFormat(table, types, format, &text);
+    IMimeAddressTable_Release(table);
+    if (FAILED(hr)) return hr;
+
+    n = MultiByteToWideChar(CP_ACP, 0, text, -1, NULL, 0);
+    if ((*ret = CoTaskMemAlloc(n * sizeof(WCHAR)))) MultiByteToWideChar(CP_ACP, 0, text, -1, *ret, n);
+    else hr = E_OUTOFMEMORY;
+    CoTaskMemFree(text);
+    return hr;
+}
