 static HRESULT WINAPI IMAPTransport_Disconnect(IIMAPTransport *iface)
 {
-    FIXME("(): stub\n");
-    return E_NOTIMPL;
+    IMAPTransport *This = impl_from_IIMAPTransport(iface);
