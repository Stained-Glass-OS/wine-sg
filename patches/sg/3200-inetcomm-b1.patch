+HRESULT InternetTransport_IsState(InternetTransport *This, IXPISSTATE isstate)
+{
+    BOOL connected = This->Status == IXP_CONNECTED || This->Status == IXP_AUTHORIZING ||
+                     This->Status == IXP_AUTHRETRY || This->Status == IXP_AUTHORIZED;
+
+    switch (isstate)
+    {
+    case IXP_IS_CONNECTED: return connected ? S_OK : S_FALSE;
+    case IXP_IS_BUSY: return This->fnCompletion ? S_OK : S_FALSE;
+    case IXP_IS_READY: return connected && !This->fnCompletion ? S_OK : S_FALSE;
+    case IXP_IS_AUTHENTICATED: return This->Status == IXP_AUTHORIZED ? S_OK : S_FALSE;
+    default: return E_INVALIDARG;
+    }
+}
