+static const char *base_name(const char *path)
+{
+    const char *p, *name = path;
+
+    for (p = path; *p; p++) if (*p == '\\' || *p == '/') name = p + 1;
+    return name;
+}
+
+/* the bytes as an attachment body: base64 data with the headers of an attachment */
+static HRESULT attach_data(MimeMessage *This, body_t *section, const BYTE *data, SIZE_T size,
+        const char *pri, const char *sub, body_t **out)
+{
+    SIZE_T length;
+    char *text = encode_base64_lines(data, size, &length);
+    IStream *stream;
+    body_t *body;
+    HRESULT hr;
+
+    if (!text) return E_OUTOFMEMORY;
+    hr = memory_stream_from(text, length, &stream);
+    free(text);
+    if (FAILED(hr)) return hr;
+    if (!(body = new_child(This, section, FALSE)))
+    {
+        IStream_Release(stream);
+        return E_OUTOFMEMORY;
+    }
+    IMimeBody_SetData(&body->mime_body->IMimeBody_iface, IET_BASE64, pri, sub, &IID_IStream, stream);
+    IStream_Release(stream);
+    body_set_type(body->mime_body, pri, sub);
+#ifndef SG_MUTANT_INET_ATTACH
+    body_set_transfer(body->mime_body, IET_BASE64);
+#endif
+    *out = body;
+    return S_OK;
+}
+
+static HRESULT stream_or_file_bytes(IStream *stream, const char *path, BYTE **data, SIZE_T *size)
+{
+    HANDLE file;
+    DWORD read, len;
+
+    if (stream) return read_whole_stream(stream, data, size);
+    file = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+    len = GetFileSize(file, NULL);
+    if (len == INVALID_FILE_SIZE || !(*data = malloc(len ? len : 1)))
+    {
+        CloseHandle(file);
+        return E_OUTOFMEMORY;
+    }
+    if (!ReadFile(file, *data, len, &read, NULL))
+    {
+        HRESULT hr = HRESULT_FROM_WIN32(GetLastError());
+        CloseHandle(file);
+        free(*data);
+        return hr;
+    }
+    CloseHandle(file);
+    *size = read;
+    return S_OK;
+}
+
+static BOOL combine_url(const char *base, const char *url, char *out, DWORD size)
+{
+    WCHAR wbase[INTERNET_MAX_URL_LENGTH], wurl[INTERNET_MAX_URL_LENGTH], wout[INTERNET_MAX_URL_LENGTH];
+    DWORD len = ARRAY_SIZE(wout);
+
+    MultiByteToWideChar(CP_ACP, 0, base, -1, wbase, ARRAY_SIZE(wbase));
+    MultiByteToWideChar(CP_ACP, 0, url, -1, wurl, ARRAY_SIZE(wurl));
+    if (FAILED(CoInternetCombineUrl(wbase, wurl, 0, wout, len, &len, 0))) return FALSE;
+    return WideCharToMultiByte(CP_ACP, 0, wout, -1, out, size, NULL, NULL) > 0;
+}
