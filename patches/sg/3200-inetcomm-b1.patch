+    if (!(child = new_child(This, body, FALSE))) return E_OUTOFMEMORY;
+    cb = child->mime_body;
+
+    LIST_FOR_EACH_ENTRY_SAFE(header, next, &mb->headers, header_t, entry)
+    {
+        if (!is_content_header(header)) continue;
+        list_remove(&header->entry);
+        list_add_tail(&cb->headers, &header->entry);
+    }
+    cb->content_pri_type = mb->content_pri_type;
+    cb->content_sub_type = mb->content_sub_type;
+    mb->content_pri_type = mb->content_sub_type = NULL;
+#ifndef SG_MUTANT_INET_TOMULTI
+    cb->data = mb->data;
+    cb->data_iid = mb->data_iid;
+    mb->data = NULL;
+    memset(&mb->data_iid, 0, sizeof(mb->data_iid));
+#endif
+    enc = mb->encoding;
+    cb->encoding = enc;
+    mb->encoding = IET_7BIT;
+    cb->main_text = mb->main_text;
+    mb->main_text = FALSE;
+    cb->body_offsets = mb->body_offsets;
