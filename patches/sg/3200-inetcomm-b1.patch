diff --git a/dlls/inetcomm/mimeaddr.c b/dlls/inetcomm/mimeaddr.c
new file mode 100644
index 0000000..fb5e7e9
--- /dev/null
+++ b/dlls/inetcomm/mimeaddr.c
@@ -0,0 +1,1233 @@
+/*
+ * MIME address table (IMimeAddressTable, IMimeEnumAddressTypes)
+ *
+ * The table presents the address headers of a property set (From, To, Cc ...)
+ * as a list of addresses and writes changes back into the headers.
+ *
