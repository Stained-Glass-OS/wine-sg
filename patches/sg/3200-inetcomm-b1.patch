+static BOOL has_flag(const char *start, const char *end, const char *flag)
+{
+    size_t n = strlen(flag);
+    const char *p;
+
+    for (p = start; p + n <= end; p++)
+        if (!strncasecmp(p, flag, n)) return TRUE;
+    return FALSE;
+}
+
+static HRESULT read_stream_bytes(IStream *stream, BYTE **data, SIZE_T *size)
+{
+    LARGE_INTEGER zero = {{0}};
+    SIZE_T cap = 4096, len = 0;
+    BYTE *buf = malloc(cap);
+    ULONG read;
+    HRESULT hr;
+
+    *data = NULL;
+    *size = 0;
+    if (!buf) return E_OUTOFMEMORY;
+    IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+    for (;;)
+    {
+        if (len + 4096 > cap)
+        {
+            BYTE *bigger = realloc(buf, cap *= 2);
+            if (!bigger) { free(buf); return E_OUTOFMEMORY; }
+            buf = bigger;
+        }
+        hr = IStream_Read(stream, buf + len, 4096, &read);
+        if (FAILED(hr)) { free(buf); return hr; }
+        if (!read) break;
+        len += read;
+    }
+    *data = buf;
+    *size = len;
+    return S_OK;
+}
+
+static IMAP_MSGFLAGS parse_flags(const char *s, const char *end)
+{
+    static const struct { const char *name; IMAP_MSGFLAGS flag; } names[] =
+    {
+        { "\\Answered", IMAP_MSG_ANSWERED }, { "\\Flagged", IMAP_MSG_FLAGGED }, { "\\Deleted", IMAP_MSG_DELETED },
+        { "\\Seen", IMAP_MSG_SEEN }, { "\\Draft", IMAP_MSG_DRAFT },
+    };
+    IMAP_MSGFLAGS flags = IMAP_MSG_NOFLAGS;
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        size_t n = strlen(names[i].name);
+        const char *p;
+        for (p = s; p + n <= end; p++)
+            if (!strncasecmp(p, names[i].name, n) && (p + n == end || strchr(" )\r\n", p[n]))) { flags |= names[i].flag; break; }
+    }
+    return flags;
+}
+
+static void parse_capability(IMAPTransport *This, const char *list)
+{
+    char *copy = strdup(list), *tok, *save = NULL;
+
+    for (tok = strtok_s(copy, " ", &save); tok; tok = strtok_s(NULL, " ", &save))
+    {
+        if (!strcasecmp(tok, "IMAP4")) This->capability |= IMAP_CAPABILITY_IMAP4;
+        else if (!strcasecmp(tok, "IMAP4rev1")) This->capability |= IMAP_CAPABILITY_IMAP4rev1;
+        else if (!strcasecmp(tok, "IDLE")) This->capability |= IMAP_CAPABILITY_IDLE;
+    }
+    free(copy);
+}
