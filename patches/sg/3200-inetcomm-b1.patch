+static const char *content_type_of_name(const char *name, char *buffer, DWORD size, const char **sub)
+{
+    const char *dot = strrchr(name, '.');
+    char *slash;
+    DWORD len = size;
+
+    if (dot && !RegGetValueA(HKEY_CLASSES_ROOT, dot, "Content Type", RRF_RT_REG_SZ, NULL, buffer, &len) &&
+        (slash = strchr(buffer, '/')))
+    {
+        *slash = 0;
+        *sub = slash + 1;
+        return buffer;
+    }
+    *sub = "octet-stream";
+    return "application";
+}
