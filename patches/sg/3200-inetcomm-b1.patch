+static void handle_untagged(IMAPTransport *This, imap_cmd *cmd, const char *line)
+{
+    const char *p = line + 1;
+    IMAP_RESPONSE r;
+    char *word;
+    DWORD n;
+
+    while (*p == ' ') p++;
+
+    if (isdigit((unsigned char)*p))
+    {
+        n = strtoul(p, (char **)&p, 10);
+        while (*p == ' ') p++;
+        if (!strncasecmp(p, "EXISTS", 6) || !strncasecmp(p, "RECENT", 6))
+        {
+            MBOX_MSGCOUNT count;
+            BOOL exists = !strncasecmp(p, "EXISTS", 6);
+
+            memset(&count, 0, sizeof(count));
+            if (exists) { count.bGotExistsResponse = TRUE; count.dwExists = n; }
+            else { count.bGotRecentResponse = TRUE; count.dwRecent = n; }
+            memset(&r, 0, sizeof(r));
+            r.irdResponseData.pmcMsgCount = &count;
+            respond(This, cmd, irtMAILBOX_UPDATE, S_OK, NULL, &r);
+        }
+        else if (!strncasecmp(p, "EXPUNGE", 7))
+        {
+            if (n && n <= This->seq_count)
+            {
+                memmove(This->seq_to_uid + n - 1, This->seq_to_uid + n, (This->seq_count - n) * sizeof(DWORD));
+                This->seq_count--;
+            }
+            memset(&r, 0, sizeof(r));
+            r.irdResponseData.dwDeletedMsgSeqNum = n;
+#ifndef SG_MUTANT_INET_IMAP_EXPUNGE
+            respond(This, cmd, irtDELETED_MSG, S_OK, NULL, &r);
+#endif
+        }
+        else if (!strncasecmp(p, "FETCH", 5)) handle_fetch(This, cmd, n, p + 5);
+        return;
+    }
+
+    word = next_astring(&p);
+    if (!strcasecmp(word, "OK") || !strcasecmp(word, "NO") || !strcasecmp(word, "BAD") ||
+        !strcasecmp(word, "PREAUTH") || !strcasecmp(word, "BYE"))
+    {
+        BOOL bye = !strcasecmp(word, "BYE");
+
+        while (*p == ' ') p++;
+        if (*p == '[')
+        {
+            const char *code = p + 1, *end = strchr(code, ']');
+            size_t clen = end ? end - code : strlen(code);
+            char *value = malloc(clen + 1);
+
+            memcpy(value, code, clen);
+            value[clen] = 0;
+            if (!strncasecmp(value, "UNSEEN ", 7))
+            {
+                MBOX_MSGCOUNT count = { .bGotUnseenResponse = TRUE, .dwUnseen = atol(value + 7) };
+                memset(&r, 0, sizeof(r));
+                r.irdResponseData.pmcMsgCount = &count;
+                respond(This, cmd, irtMAILBOX_UPDATE, S_OK, NULL, &r);
+            }
+            else if (!strncasecmp(value, "PERMANENTFLAGS", 14))
+            {
+                memset(&r, 0, sizeof(r));
+                r.irdResponseData.imfImapMessageFlags = parse_flags(value, value + strlen(value));
+                respond(This, cmd, irtPERMANENT_FLAGS, S_OK, NULL, &r);
+            }
+            else if (!strncasecmp(value, "UIDVALIDITY ", 12))
+            {
+                memset(&r, 0, sizeof(r));
+                r.irdResponseData.dwUIDValidity = atol(value + 12);
+                respond(This, cmd, irtUIDVALIDITY, S_OK, NULL, &r);
+            }
+            else if (!strcasecmp(value, "READ-WRITE") || !strcasecmp(value, "READ-ONLY"))
+            {
+                memset(&r, 0, sizeof(r));
+                r.irdResponseData.bReadWrite = !strcasecmp(value, "READ-WRITE");
+                respond(This, cmd, irtREADWRITE_STATUS, S_OK, NULL, &r);
+            }
+            else if (!strcasecmp(value, "TRYCREATE")) respond_simple(This, cmd, irtTRYCREATE, S_OK, NULL);
+            else if (!strcasecmp(value, "ALERT")) respond_simple(This, cmd, irtSERVER_ALERT, S_OK, end ? end + 1 : "");
+            else if (!strncasecmp(value, "CAPABILITY ", 11)) parse_capability(This, value + 11);
+            free(value);
+        }
+        else if (bye) respond_simple(This, cmd, irtERROR_NOTIFICATION, IXP_E_CONNECTION_DROPPED, p);
+        free(word);
+        return;
+    }
+    if (!strcasecmp(word, "CAPABILITY")) parse_capability(This, p);
+    else if (!strcasecmp(word, "FLAGS"))
+    {
+        memset(&r, 0, sizeof(r));
+        r.irdResponseData.imfImapMessageFlags = parse_flags(p, p + strlen(p));
+        respond(This, cmd, irtAPPLICABLE_FLAGS, S_OK, NULL, &r);
+    }
+    else if (!strcasecmp(word, "LIST") || !strcasecmp(word, "LSUB"))
+    {
+        IMAP_LISTLSUB_RESPONSE listing;
+        const char *open = strchr(p, '('), *close = open ? strchr(open, ')') : NULL;
+        char *delim, *name;
+
+        memset(&listing, 0, sizeof(listing));
+        if (open && close)
+        {
+            IMAP_MBOXFLAGS flags = IMAP_MBOX_NOFLAGS;
+            if (has_flag(open, close, "\\Noinferiors")) flags |= IMAP_MBOX_NOINFERIORS;
+            if (has_flag(open, close, "\\Noselect")) flags |= IMAP_MBOX_NOSELECT;
+            if (has_flag(open, close, "\\Marked")) flags |= IMAP_MBOX_MARKED;
+            if (has_flag(open, close, "\\Unmarked")) flags |= IMAP_MBOX_UNMARKED;
+            listing.imfMboxFlags = flags;
+            p = close + 1;
+        }
+        delim = next_astring(&p);
+        name = next_astring(&p);
+        listing.cHierarchyChar = strcasecmp(delim, "NIL") ? delim[0] : 0;
+        listing.pszMailboxName = name;
+        memset(&r, 0, sizeof(r));
+        r.irdResponseData.illrdMailboxListing = listing;
+        respond(This, cmd, irtMAILBOX_LISTING, S_OK, NULL, &r);
+        free(delim);
+        free(name);
+    }
+    else if (!strcasecmp(word, "SEARCH"))
+    {
+        IRangeList *list;
+
+        if (SUCCEEDED(CreateRangeList(&list)))
+        {
+            while (*p)
+            {
+                while (*p == ' ') p++;
+                if (!isdigit((unsigned char)*p)) break;
+                IRangeList_AddSingleValue(list, strtoul(p, (char **)&p, 10));
+            }
+            memset(&r, 0, sizeof(r));
+            r.irdResponseData.prlSearchResults = list;
+            respond(This, cmd, irtSEARCH, S_OK, NULL, &r);
+            IRangeList_Release(list);
+        }
+    }
+    else if (!strcasecmp(word, "STATUS"))
+    {
+        IMAP_STATUS_RESPONSE status;
+        char *name = next_astring(&p);
+        const char *open = strchr(p, '(');
+
+        memset(&status, 0, sizeof(status));
+        status.pszMailboxName = name;
+        while (open && *open && *open != ')')
+        {
+            char *key, *val;
+            open++;
+            while (*open == ' ') open++;
+            if (*open == ')' || !*open) break;
+            key = next_astring(&open);
+            val = next_astring(&open);
+            if (!strcasecmp(key, "MESSAGES")) { status.fMessages = TRUE; status.dwMessages = atol(val); }
+            else if (!strcasecmp(key, "RECENT")) { status.fRecent = TRUE; status.dwRecent = atol(val); }
+            else if (!strcasecmp(key, "UIDNEXT")) { status.fUIDNext = TRUE; status.dwUIDNext = atol(val); }
+            else if (!strcasecmp(key, "UIDVALIDITY")) { status.fUIDValidity = TRUE; status.dwUIDValidity = atol(val); }
+            else if (!strcasecmp(key, "UNSEEN")) { status.fUnseen = TRUE; status.dwUnseen = atol(val); }
+            free(key);
+            free(val);
+        }
+        memset(&r, 0, sizeof(r));
+        r.irdResponseData.pisrStatusResponse = &status;
+        respond(This, cmd, irtMAILBOX_STATUS, S_OK, NULL, &r);
+        free(name);
+    }
+    free(word);
+}
+
+/* Read what the server sends until every command that was started has its tagged answer. */
+static HRESULT imap_process(IMAPTransport *This, BOOL stop_at_first_tagged)
+{
+    HRESULT hr = S_OK;
+
+    while (!list_empty(&This->pending))
+    {
+        imap_cmd *cmd = LIST_ENTRY(list_head(&This->pending), imap_cmd, entry);
+        char *line;
+
+        if (!cmd->sent)
+        {
+            if (FAILED(hr = imap_send_line(This, cmd->tag, cmd->command))) break;
+            cmd->sent = TRUE;
+        }
+        if (FAILED(hr = imap_readline(This, &line))) break;
+
+        if (line[0] == '*') handle_untagged(This, cmd, line);
+        else if (line[0] == '+')
+        {
+            /* the server asks for the data of an APPEND */
+            if (cmd->literal)
+            {
+                APPEND_PROGRESS progress = { cmd->literal_size, cmd->literal_size };
+                IMAP_RESPONSE r;
+
+                hr = imap_send_raw(This, (char *)cmd->literal, cmd->literal_size);
+                if (SUCCEEDED(hr)) hr = imap_send_raw(This, "\r\n", 2);
+                memset(&r, 0, sizeof(r));
+                r.irdResponseData.papAppendProgress = &progress;
+                respond(This, cmd, irtAPPEND_PROGRESS, S_OK, NULL, &r);
+                free(cmd->literal);
+                cmd->literal = NULL;
+                if (FAILED(hr)) { free(line); break; }
+            }
+        }
+        else if (!strncmp(line, cmd->tag, strlen(cmd->tag)) && line[strlen(cmd->tag)] == ' ')
+        {
+            const char *status = line + strlen(cmd->tag) + 1;
+            HRESULT result = !strncasecmp(status, "OK", 2) ? S_OK : E_FAIL;
+
+            /* a completion can carry a response code too */
+            if (status[2] == ' ' && status[3] == '[') handle_untagged(This, cmd, line + strlen(cmd->tag));
+            respond_simple(This, cmd, irtCOMMAND_COMPLETION, result, status + (status[2] ? 3 : 2));
+            list_remove(&cmd->entry);
+            free_cmd(cmd);
+            if (stop_at_first_tagged) { free(line); break; }
+        }
+        free(line);
+    }
+    if (FAILED(hr) && !list_empty(&This->pending))
+    {
+        /* the connection is gone: the waiting commands fail */
+        while (!list_empty(&This->pending))
+        {
+            imap_cmd *cmd = LIST_ENTRY(list_head(&This->pending), imap_cmd, entry);
+            respond_simple(This, cmd, irtCOMMAND_COMPLETION, hr, NULL);
+            list_remove(&cmd->entry);
+            free_cmd(cmd);
+        }
+    }
+    return hr;
+}
+
+/* run from the window of the transport: the answers arrive after the call that started the command */
+static void imap_pump(InternetTransport *transport)
+{
+    IMAPTransport *This = CONTAINING_RECORD(transport, IMAPTransport, InetTransport);
+
+    if (This->in_pump || transport->Status == IXP_DISCONNECTED) return;
+    This->in_pump = TRUE;
+    IIMAPTransport_AddRef((IIMAPTransport *)&transport->u.vtblIMAP);
+    imap_process(This, FALSE);
+    This->in_pump = FALSE;
+    IIMAPTransport_Release((IIMAPTransport *)&transport->u.vtblIMAP);
+}
+
+/* start a command: it is queued and run when the window of the transport gets to it */
+static HRESULT imap_start(IMAPTransport *This, WPARAM wParam, LPARAM lParam, IIMAPCallback *cb, char *command,
+        BYTE *literal, DWORD literal_size)
+{
+    imap_cmd *cmd;
+
+    if (This->InetTransport.Status == IXP_DISCONNECTED) { free(command); free(literal); return IXP_E_NOT_CONNECTED; }
+    if (!(cmd = calloc(1, sizeof(*cmd)))) { free(command); free(literal); return E_OUTOFMEMORY; }
+    sprintf(cmd->tag, "A%04lu", ++This->next_tag);
+    cmd->wParam = wParam;
+    cmd->lParam = lParam;
+    cmd->cb = cb;
+    if (cb) IIMAPCallback_AddRef(cb);
+    cmd->command = command;
+    cmd->literal = literal;
+    cmd->literal_size = literal_size;
+    list_add_tail(&This->pending, &cmd->entry);
+    PostMessageW(This->InetTransport.hwnd, IX_IMAP_PUMP, 0, 0);
+    return S_OK;
+}
+
+/* a mailbox name as a quoted string */
+static char *quoted(const char *name)
+{
+    char *out = malloc(strlen(name) * 2 + 3), *o = out;
+
+    if (!out) return NULL;
+    *o++ = '"';
+    for (; *name; name++)
+    {
+        if (*name == '"' || *name == '\\') *o++ = '\\';
+        *o++ = *name;
+    }
+    *o++ = '"';
+    *o = 0;
+    return out;
+}
+
+static HRESULT imap_command(IIMAPTransport *iface, WPARAM wParam, LPARAM lParam, IIMAPCallback *cb,
+        const char *verb, const char *arg1, const char *arg2)
+{
+    IMAPTransport *This = impl_from_IIMAPTransport(iface);
+    char *a1 = NULL, *a2 = NULL, *command;
+
+    if (arg1 && !(a1 = quoted(arg1))) return E_OUTOFMEMORY;
+    if (arg2 && !(a2 = quoted(arg2))) { free(a1); return E_OUTOFMEMORY; }
+    command = malloc(strlen(verb) + (a1 ? strlen(a1) : 0) + (a2 ? strlen(a2) : 0) + 3);
+    if (command) sprintf(command, "%s%s%s%s%s", verb, a1 ? " " : "", a1 ? a1 : "", a2 ? " " : "", a2 ? a2 : "");
+    free(a1);
+    free(a2);
+    if (!command) return E_OUTOFMEMORY;
+    return imap_start(This, wParam, lParam, cb, command, NULL, 0);
+}
