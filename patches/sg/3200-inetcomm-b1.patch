+/* ---- the connection: reading lines and literals, blocking with the server's timeout ---- */
+
+static HRESULT imap_recv(IMAPTransport *This, char *buf, int size)
+{
+    DWORD timeout = This->InetTransport.ServerInfo.dwTimeout;
+    struct timeval tv;
+    fd_set fds;
+    int ret;
+
+    FD_ZERO(&fds);
+    FD_SET(This->InetTransport.Socket, &fds);
+    tv.tv_sec = timeout ? timeout : IMAP_DEFAULT_TIMEOUT;
+    tv.tv_usec = 0;
+    if (select(0, &fds, NULL, NULL, &tv) <= 0) return IXP_E_TIMEOUT;
+    ret = recv(This->InetTransport.Socket, buf, size, 0);
+    if (ret == 0) return IXP_E_CONNECTION_DROPPED;
+    if (ret < 0) return IXP_E_CONN_RECV;
+    return ret;
+}
+
+/* one line without its line ending (the buffer grows as needed) */
+static HRESULT imap_readline(IMAPTransport *This, char **line)
+{
+    size_t len = 0, cap = 256;
+    char *buf = malloc(cap), c;
+    int ret;
+
+    *line = NULL;
+    if (!buf) return E_OUTOFMEMORY;
+    for (;;)
+    {
+        if ((ret = imap_recv(This, &c, 1)) < 0) { free(buf); return ret; }
+        if (c == '\n') break;
+        if (len + 2 > cap)
+        {
+            char *bigger = realloc(buf, cap *= 2);
+            if (!bigger) { free(buf); return E_OUTOFMEMORY; }
+            buf = bigger;
+        }
+        buf[len++] = c;
+    }
+    if (len && buf[len - 1] == '\r') len--;
+    buf[len] = 0;
+    *line = buf;
+    if (This->InetTransport.pCallback && This->InetTransport.fCommandLogging)
+        ITransportCallback_OnCommand(This->InetTransport.pCallback, CMD_RESP, buf, 0,
+                                     (IInternetTransport *)&This->InetTransport.u.vtbl);
+    return S_OK;
+}
+
+static HRESULT imap_readn(IMAPTransport *This, char *buf, DWORD size)
+{
+    DWORD done = 0;
+    int ret;
+
+    while (done < size)
+    {
+        if ((ret = imap_recv(This, buf + done, size - done)) < 0) return ret;
+        done += ret;
+    }
+    return S_OK;
+}
+
+static HRESULT imap_send_raw(IMAPTransport *This, const char *data, int size)
+{
+    int sent = 0, ret;
+
+    while (sent < size)
+    {
+        ret = send(This->InetTransport.Socket, data + sent, size - sent, 0);
+        if (ret <= 0) return IXP_E_CONN_SEND;
+        sent += ret;
+    }
+    return S_OK;
+}
+
+static HRESULT imap_send_line(IMAPTransport *This, const char *tag, const char *command)
+{
+    char *line = malloc(strlen(tag) + strlen(command) + 4);
+    HRESULT hr;
+
+    if (!line) return E_OUTOFMEMORY;
+    sprintf(line, "%s %s\r\n", tag, command);
+    if (This->InetTransport.pCallback && This->InetTransport.fCommandLogging)
+        ITransportCallback_OnCommand(This->InetTransport.pCallback, CMD_SEND, line, 0,
+                                     (IInternetTransport *)&This->InetTransport.u.vtbl);
+    hr = imap_send_raw(This, line, strlen(line));
+    free(line);
+    return hr;
+}
