     IStream *pStream, ULONG cbSize)
 {
-    FIXME("(%p, %ld)\n", pStream, cbSize);
-    return E_NOTIMPL;
+    SMTPTransport *This = (SMTPTransport *)iface;
+    char *data, *stuffed, *in, *out;
+    ULONG read = 0, i, extra = 0;
+    HRESULT hr;
+
+    TRACE("(%p, %ld)\n", pStream, cbSize);
+
+    if (!pStream) return E_INVALIDARG;
+    if (!cbSize) return S_OK;
+    if (!(data = HeapAlloc(GetProcessHeap(), 0, cbSize))) return E_OUTOFMEMORY;
+    hr = IStream_Read(pStream, data, cbSize, &read);
+    if (FAILED(hr)) { HeapFree(GetProcessHeap(), 0, data); return hr; }
+
+    /* a line that starts with a dot gets another one, so that it is not taken for the end of the data */
+    for (i = 0; i < read; i++)
+#ifndef SG_MUTANT_INET_SMTP_DOT
+        if (data[i] == '.' && (i == 0 ? This->data_line_start : data[i - 1] == '\n')) extra++;
+#endif
+    if (!(stuffed = HeapAlloc(GetProcessHeap(), 0, read + extra + 1)))
+    {
+        HeapFree(GetProcessHeap(), 0, data);
+        return E_OUTOFMEMORY;
+    }
+    for (in = data, out = stuffed, i = 0; i < read; i++, in++)
+    {
+#ifndef SG_MUTANT_INET_SMTP_DOT
+        if (*in == '.' && (i == 0 ? This->data_line_start : in[-1] == '\n')) *out++ = '.';
+#endif
+        *out++ = *in;
+    }
+    if (read) This->data_line_start = data[read - 1] == '\n';
+    hr = InternetTransport_Write(&This->InetTransport, stuffed, out - stuffed,
+        SMTPTransport_CallbackDoNothing);
+    HeapFree(GetProcessHeap(), 0, stuffed);
+    HeapFree(GetProcessHeap(), 0, data);
+    return hr;
 }
 
