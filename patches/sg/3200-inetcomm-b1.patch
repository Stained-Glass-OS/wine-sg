diff --git a/dlls/inetcomm/rangelist.c b/dlls/inetcomm/rangelist.c
new file mode 100644
index 0000000..fced774
--- /dev/null
+++ b/dlls/inetcomm/rangelist.c
@@ -0,0 +1,425 @@
+/*
+ * IRangeList: a set of message numbers kept as ranges
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "mimeole.h"
+#include "imnxport.h"
+#include "wine/debug.h"
+
+#include "inetcomm_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(inetcomm);
+
+typedef struct { ULONG low, high; } range_t;
+
+typedef struct
+{
+    IRangeList IRangeList_iface;
+    LONG ref;
+    range_t *ranges;   /* sorted, apart, not touching */
+    ULONG count, cap;
+} range_list;
+
+static inline range_list *impl_from_IRangeList(IRangeList *iface)
+{
+    return CONTAINING_RECORD(iface, range_list, IRangeList_iface);
+}
+
+static HRESULT insert_range(range_list *list, ULONG low, ULONG high)
+{
+    ULONG i = 0, first, last;
+
+    if (low > high) { ULONG t = low; low = high; high = t; }
+    /* the ranges that overlap or touch the new one are merged into it */
+#ifdef SG_MUTANT_INET_RANGE
+    while (i < list->count && list->ranges[i].high != ~0u && list->ranges[i].high < low) i++;
+#else
+    while (i < list->count && list->ranges[i].high != ~0u && list->ranges[i].high + 1 < low) i++;
+#endif
+    first = i;
+    while (i < list->count && (high == ~0u || list->ranges[i].low <= high + 1))
+    {
+        if (list->ranges[i].low < low) low = list->ranges[i].low;
+        if (list->ranges[i].high > high) high = list->ranges[i].high;
+        i++;
+    }
+    last = i;
+    if (last == first)
+    {
+        if (list->count == list->cap)
+        {
+            ULONG cap = list->cap ? list->cap * 2 : 8;
+            range_t *bigger = realloc(list->ranges, cap * sizeof(*bigger));
+            if (!bigger) return E_OUTOFMEMORY;
+            list->ranges = bigger;
+            list->cap = cap;
+        }
+        memmove(&list->ranges[first + 1], &list->ranges[first], (list->count - first) * sizeof(range_t));
+        list->count++;
+    }
+    else if (last - first > 1)
+    {
+        memmove(&list->ranges[first + 1], &list->ranges[last], (list->count - last) * sizeof(range_t));
+        list->count -= last - first - 1;
+    }
+    list->ranges[first].low = low;
+    list->ranges[first].high = high;
+    return S_OK;
+}
+
+static HRESULT remove_range(range_list *list, ULONG low, ULONG high)
+{
+    range_list result = { .ranges = NULL };
+    ULONG i;
+    HRESULT hr = S_OK;
+
+    if (low > high) { ULONG t = low; low = high; high = t; }
+    for (i = 0; i < list->count && SUCCEEDED(hr); i++)
+    {
+        range_t r = list->ranges[i];
+
+        if (r.high < low || r.low > high) { hr = insert_range(&result, r.low, r.high); continue; }
+        if (r.low < low) hr = insert_range(&result, r.low, low - 1);
+        if (SUCCEEDED(hr) && r.high > high) hr = insert_range(&result, high + 1, r.high);
+    }
+    if (FAILED(hr)) { free(result.ranges); return hr; }
+    free(list->ranges);
+    list->ranges = result.ranges;
+    list->count = result.count;
+    list->cap = result.cap;
+    return S_OK;
+}
+
+static HRESULT WINAPI range_QueryInterface(IRangeList *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IRangeList))
+    {
+        *ppv = iface;
+        IRangeList_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI range_AddRef(IRangeList *iface)
+{
+    range_list *This = impl_from_IRangeList(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI range_Release(IRangeList *iface)
+{
+    range_list *This = impl_from_IRangeList(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        free(This->ranges);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI range_Clear(IRangeList *iface)
+{
+    range_list *This = impl_from_IRangeList(iface);
+
+    TRACE("(%p)\n", iface);
+    This->count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI range_IsInRange(IRangeList *iface, const ULONG value)
+{
+    range_list *This = impl_from_IRangeList(iface);
+    ULONG i;
+
+    TRACE("(%p)->(%lu)\n", iface, value);
+    for (i = 0; i < This->count; i++)
+        if (value >= This->ranges[i].low && value <= This->ranges[i].high) return S_OK;
+    return S_FALSE;
+}
+
+/* the documentation does not say what an empty list answers: S_FALSE and the error value */
+static HRESULT WINAPI range_Min(IRangeList *iface, ULONG *min)
+{
+    range_list *This = impl_from_IRangeList(iface);
+
+    TRACE("(%p)->(%p)\n", iface, min);
+    if (!min) return E_INVALIDARG;
+    if (!This->count) { *min = RL_RANGE_ERROR; return S_FALSE; }
+    *min = This->ranges[0].low;
+    return S_OK;
+}
+
+static HRESULT WINAPI range_Max(IRangeList *iface, ULONG *max)
+{
+    range_list *This = impl_from_IRangeList(iface);
+
+    TRACE("(%p)->(%p)\n", iface, max);
+    if (!max) return E_INVALIDARG;
+    if (!This->count) { *max = RL_RANGE_ERROR; return S_FALSE; }
+    *max = This->ranges[This->count - 1].high;
+    return S_OK;
+}
+
+static HRESULT WINAPI range_Save(IRangeList *iface, byte **dest, ULONG *size)
+{
+    range_list *This = impl_from_IRangeList(iface);
+
+    TRACE("(%p)->(%p, %p)\n", iface, dest, size);
+    if (!dest || !size) return E_INVALIDARG;
+    *size = This->count * sizeof(range_t);
+    if (!(*dest = CoTaskMemAlloc(*size ? *size : 1))) return E_OUTOFMEMORY;
+    memcpy(*dest, This->ranges, *size);
+    return S_OK;
+}
+
+static HRESULT WINAPI range_Load(IRangeList *iface, byte *source, const ULONG size)
+{
+    range_list *This = impl_from_IRangeList(iface);
+    const range_t *in = (const range_t *)source;
+    ULONG i;
+    HRESULT hr = S_OK;
+
+    TRACE("(%p)->(%p, %lu)\n", iface, source, size);
+    if (!source || size % sizeof(range_t)) return E_INVALIDARG;
+    This->count = 0;
+    for (i = 0; i < size / sizeof(range_t) && SUCCEEDED(hr); i++) hr = insert_range(This, in[i].low, in[i].high);
+    return hr;
+}
+
+static HRESULT WINAPI range_AddRange(IRangeList *iface, const ULONG low, const ULONG high)
+{
+    TRACE("(%p)->(%lu, %lu)\n", iface, low, high);
+    return insert_range(impl_from_IRangeList(iface), low, high);
+}
+
+static HRESULT WINAPI range_AddSingleValue(IRangeList *iface, const ULONG value)
+{
+    TRACE("(%p)->(%lu)\n", iface, value);
+    return insert_range(impl_from_IRangeList(iface), value, value);
+}
+
+static HRESULT WINAPI range_AddRangeList(IRangeList *iface, const IRangeList *other)
+{
+    range_list *This = impl_from_IRangeList(iface), *from = impl_from_IRangeList((IRangeList *)other);
+    ULONG i;
+    HRESULT hr = S_OK;
+
+    TRACE("(%p)->(%p)\n", iface, other);
+    if (!other) return E_INVALIDARG;
+    for (i = 0; i < from->count && SUCCEEDED(hr); i++) hr = insert_range(This, from->ranges[i].low, from->ranges[i].high);
+    return hr;
+}
+
+static HRESULT WINAPI range_DeleteRange(IRangeList *iface, const ULONG low, const ULONG high)
+{
+    TRACE("(%p)->(%lu, %lu)\n", iface, low, high);
+    return remove_range(impl_from_IRangeList(iface), low, high);
+}
+
+static HRESULT WINAPI range_DeleteSingleValue(IRangeList *iface, const ULONG value)
+{
+    TRACE("(%p)->(%lu)\n", iface, value);
+    return remove_range(impl_from_IRangeList(iface), value, value);
+}
+
+static HRESULT WINAPI range_DeleteRangeList(IRangeList *iface, const IRangeList *other)
+{
+    range_list *This = impl_from_IRangeList(iface), *from = impl_from_IRangeList((IRangeList *)other);
+    ULONG i;
+    HRESULT hr = S_OK;
+
+    TRACE("(%p)->(%p)\n", iface, other);
+    if (!other) return E_INVALIDARG;
+    for (i = 0; i < from->count && SUCCEEDED(hr); i++) hr = remove_range(This, from->ranges[i].low, from->ranges[i].high);
+    return hr;
+}
+
+static const range_t *find_range(range_list *list, ULONG value)
+{
+    ULONG i;
+    for (i = 0; i < list->count; i++)
+        if (value >= list->ranges[i].low && value <= list->ranges[i].high) return &list->ranges[i];
+    return NULL;
+}
+
+static HRESULT WINAPI range_MinOfRange(IRangeList *iface, const ULONG value, ULONG *min)
+{
+    const range_t *r;
+
+    TRACE("(%p)->(%lu, %p)\n", iface, value, min);
+    if (!min) return E_INVALIDARG;
+    if (!(r = find_range(impl_from_IRangeList(iface), value))) { *min = RL_RANGE_ERROR; return S_FALSE; }
+    *min = r->low;
+    return S_OK;
+}
+
+static HRESULT WINAPI range_MaxOfRange(IRangeList *iface, const ULONG value, ULONG *max)
+{
+    const range_t *r;
+
+    TRACE("(%p)->(%lu, %p)\n", iface, value, max);
+    if (!max) return E_INVALIDARG;
+    if (!(r = find_range(impl_from_IRangeList(iface), value))) { *max = RL_RANGE_ERROR; return S_FALSE; }
+    *max = r->high;
+    return S_OK;
+}
+
+static HRESULT WINAPI range_RangeToIMAPString(IRangeList *iface, LPSTR *dest, LPDWORD length)
+{
+    range_list *This = impl_from_IRangeList(iface);
+    char *text, *p;
+    ULONG i;
+
+    TRACE("(%p)->(%p, %p)\n", iface, dest, length);
+    if (!dest) return E_INVALIDARG;
+    if (!(text = CoTaskMemAlloc(This->count * 24 + 1))) return E_OUTOFMEMORY;
+    p = text;
+    for (i = 0; i < This->count; i++)
+    {
+        const range_t *r = &This->ranges[i];
+        char low[16], high[16];
+
+        if (i) *p++ = ',';
+        if (r->low == RL_LAST_MESSAGE) strcpy(low, "*"); else sprintf(low, "%lu", r->low);
+        if (r->high == RL_LAST_MESSAGE) strcpy(high, "*"); else sprintf(high, "%lu", r->high);
+        if (r->low == r->high) p += sprintf(p, "%s", low);
+        else p += sprintf(p, "%s:%s", low, high);
+    }
+    *p = 0;
+    *dest = text;
+    if (length) *length = p - text;
+    return S_OK;
+}
+
+static HRESULT WINAPI range_Next(IRangeList *iface, const ULONG current, ULONG *next)
+{
+    range_list *This = impl_from_IRangeList(iface);
+    ULONG i;
+
+    TRACE("(%p)->(%lu, %p)\n", iface, current, next);
+    if (!next) return E_INVALIDARG;
+    for (i = 0; i < This->count; i++)
+    {
+        if (current >= This->ranges[i].low && current < This->ranges[i].high) { *next = current + 1; return S_OK; }
+        if (current < This->ranges[i].low) { *next = This->ranges[i].low; return S_OK; }
+    }
+    *next = RL_RANGE_ERROR;
+    return S_FALSE;
+}
+
+static HRESULT WINAPI range_Prev(IRangeList *iface, const ULONG current, ULONG *prev)
+{
+    range_list *This = impl_from_IRangeList(iface);
+    LONG i;
+
+    TRACE("(%p)->(%lu, %p)\n", iface, current, prev);
+    if (!prev) return E_INVALIDARG;
+    for (i = This->count - 1; i >= 0; i--)
+    {
+        if (current > This->ranges[i].high) { *prev = This->ranges[i].high; return S_OK; }
+        if (current > This->ranges[i].low) { *prev = current - 1; return S_OK; }
+    }
+    *prev = RL_RANGE_ERROR;
+    return S_FALSE;
+}
+
+static HRESULT WINAPI range_Cardinality(IRangeList *iface, ULONG *count)
+{
+    range_list *This = impl_from_IRangeList(iface);
+    ULONG i;
+
+    TRACE("(%p)->(%p)\n", iface, count);
+    if (!count) return E_INVALIDARG;
+    *count = 0;
+    for (i = 0; i < This->count; i++) *count += This->ranges[i].high - This->ranges[i].low + 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI range_CardinalityFrom(IRangeList *iface, const ULONG start, ULONG *count)
+{
+    range_list *This = impl_from_IRangeList(iface);
+    ULONG i;
+
+    TRACE("(%p)->(%lu, %p)\n", iface, start, count);
+    if (!count) return E_INVALIDARG;
+    *count = 0;
+    for (i = 0; i < This->count; i++)
+    {
+        ULONG low = This->ranges[i].low, high = This->ranges[i].high;
+        if (high < start) continue;
+        if (low < start) low = start;
+        *count += high - low + 1;
+    }
+    return S_OK;
+}
+
+static const IRangeListVtbl range_vtbl =
+{
+    range_QueryInterface,
+    range_AddRef,
+    range_Release,
+    range_Clear,
+    range_IsInRange,
+    range_Min,
+    range_Max,
+    range_Save,
+    range_Load,
+    range_AddRange,
+    range_AddSingleValue,
+    range_AddRangeList,
+    range_DeleteRange,
+    range_DeleteSingleValue,
+    range_DeleteRangeList,
+    range_MinOfRange,
+    range_MaxOfRange,
+    range_RangeToIMAPString,
+    range_Next,
+    range_Prev,
+    range_Cardinality,
+    range_CardinalityFrom
+};
+
+/***********************************************************************
+ *              CreateRangeList (INETCOMM.@)
+ */
+HRESULT WINAPI CreateRangeList(IRangeList **ret)
+{
+    range_list *list;
+
+    TRACE("(%p)\n", ret);
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    if (!(list = calloc(1, sizeof(*list)))) return E_OUTOFMEMORY;
+    list->IRangeList_iface.lpVtbl = &range_vtbl;
+    list->ref = 1;
+    *ret = &list->IRangeList_iface;
+    return S_OK;
+}
