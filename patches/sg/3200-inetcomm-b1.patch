+/* text for a body: seven bit text goes as it is, the rest is base64 */
+static HRESULT prepare_text(ENCODINGTYPE enc, IStream *in, IStream **out, ENCODINGTYPE *out_enc, BOOL *utf8)
+{
+    BYTE *data, *conv = NULL;
+    SIZE_T size, i;
+    BOOL ascii = TRUE;
+    HRESULT hr;
+
+    *utf8 = FALSE;
+    if (FAILED(hr = read_whole_stream(in, &data, &size))) return hr;
+    if (enc == IET_UNICODE)
+    {
+        const WCHAR *wide = (const WCHAR *)data;
+        SIZE_T count = size / sizeof(WCHAR);
+        int n;
+
+        if (count && wide[0] == 0xfeff) { wide++; count--; }
+        n = WideCharToMultiByte(CP_UTF8, 0, wide, count, NULL, 0, NULL, NULL);
+        if (!(conv = malloc(n + 1))) { free(data); return E_OUTOFMEMORY; }
+        WideCharToMultiByte(CP_UTF8, 0, wide, count, (char *)conv, n, NULL, NULL);
+        free(data);
+        data = conv;
+        size = n;
+        *utf8 = TRUE;
+    }
+    for (i = 0; i < size; i++) if (data[i] > 127 || !data[i]) { ascii = FALSE; break; }
+    if (ascii)
+    {
+        *out_enc = IET_7BIT;
+        hr = memory_stream_from(data, size, out);
+    }
+    else
+    {
+        SIZE_T length;
+        char *text = encode_base64_lines(data, size, &length);
+
+        *out_enc = IET_BASE64;
+        hr = text ? memory_stream_from(text, length, out) : E_OUTOFMEMORY;
+        free(text);
+    }
+    free(data);
+    return hr;
+}
