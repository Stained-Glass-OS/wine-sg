+/* "* n FETCH (...)": the attributes and the body parts, which may be literals */
+static HRESULT handle_fetch(IMAPTransport *This, imap_cmd *cmd, DWORD msn, const char *list)
+{
+    FETCH_CMD_RESULTS results;
+    IMAP_RESPONSE r;
+    const char *p = list;
+    char *line_copy = NULL;
+    HRESULT hr = S_OK;
+
+    memset(&results, 0, sizeof(results));
+    results.dwMsgSeqNum = msn;
+    results.lpFetchCookie1 = cmd ? cmd->wParam : 0;
+    results.lpFetchCookie2 = cmd ? cmd->lParam : 0;
+
+    while (*p && *p != ')')
+    {
+        char *name;
+
+        while (*p == ' ' || *p == '(') p++;
+        if (!*p || *p == ')') break;
+        name = next_astring(&p);
+        if (!strcasecmp(name, "FLAGS"))
+        {
+            const char *open = strchr(p, '('), *close = open ? strchr(open, ')') : NULL;
+            if (open && close) { results.bMsgFlags = TRUE; results.mfMsgFlags = parse_flags(open, close); p = close + 1; }
+        }
+        else if (!strcasecmp(name, "UID")) { char *v = next_astring(&p); results.bUID = TRUE; results.dwUID = atol(v); free(v); }
+        else if (!strcasecmp(name, "RFC822.SIZE")) { char *v = next_astring(&p); results.bRFC822Size = TRUE; results.dwRFC822Size = atol(v); free(v); }
+        else if (!strcasecmp(name, "INTERNALDATE"))
+        {
+            char *v = next_astring(&p);
+            results.bInternalDate = parse_internal_date(v, &results.ftInternalDate);
+            free(v);
+        }
+        else if (!strncasecmp(name, "BODY[", 5) || !strncasecmp(name, "BODY.PEEK[", 10) || !strncasecmp(name, "RFC822", 6))
+        {
+            /* a body part: a literal "{n}" at the end of the line, or a string */
+            FETCH_BODY_PART part;
+            char *data = NULL;
+            const char *brace;
+
+            memset(&part, 0, sizeof(part));
+            part.dwMsgSeqNum = msn;
+            part.pszBodyTag = name;
+            part.lpFetchCookie1 = results.lpFetchCookie1;
+            part.lpFetchCookie2 = results.lpFetchCookie2;
+            while (*p == ' ') p++;
+            if (*p == '{' && (brace = strchr(p, '}')))
+            {
+                DWORD n = atol(p + 1);
+                if (!(data = malloc(n + 1))) { free(name); return E_OUTOFMEMORY; }
+#ifdef SG_MUTANT_INET_IMAP_LITERAL
+                n = n > 2 ? n - 2 : n;
+#endif
+                if (FAILED(hr = imap_readn(This, data, n))) { free(data); free(name); return hr; }
+                data[n] = 0;
+                part.dwSizeOfData = part.dwTotalBytes = n;
+                /* what follows the literal on its line */
+                free(line_copy);
+                if (FAILED(hr = imap_readline(This, &line_copy))) { free(data); free(name); return hr; }
+                p = line_copy;
+            }
+            else if (*p == '"') { data = next_astring(&p); part.dwSizeOfData = part.dwTotalBytes = strlen(data); }
+            else { data = strdup(""); }
+            part.fDone = TRUE;
+            part.pszData = data;
+            memset(&r, 0, sizeof(r));
+            r.irdResponseData.pFetchBodyPart = &part;
+            respond(This, cmd, irtFETCH_BODY, S_OK, NULL, &r);
+            free(data);
+        }
+        else
+        {
+            /* an attribute that is not reported: skip its value */
+            while (*p == ' ') p++;
+            if (*p == '(') { int depth = 0; do { if (*p == '(') depth++; else if (*p == ')') depth--; p++; } while (*p && depth); }
+            else free(next_astring(&p));
+        }
+        free(name);
+    }
+
+    if (results.bUID) update_seq(This, msn, results.dwUID);
+    if (results.bMsgFlags || results.bRFC822Size || results.bUID || results.bInternalDate)
+    {
+        memset(&r, 0, sizeof(r));
+        r.irdResponseData.pFetchResults = &results;
+        respond(This, cmd, irtUPDATE_MSG, S_OK, NULL, &r);
+    }
+    free(line_copy);
+    return hr;
+}
