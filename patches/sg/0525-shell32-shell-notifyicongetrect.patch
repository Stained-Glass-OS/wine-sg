+/* Shell_NotifyIconGetRect (shell32): where an icon is on the screen. The
+ * request names the icon by its GUID or by its window and id; part 0 asks
+ * whether it is shown, 1 and 2 its top left and bottom right corners. */
+#define SYSTRAY_GET_ICON_RECT 0x53470001
+
+struct systray_rect_request  /* platform-independent, as struct notify_data */
+{
+    DWORD hWnd;
+    UINT  uID;
+    GUID  guidItem;
+    DWORD part;
+};
+
+static LRESULT handle_rect_request( const COPYDATASTRUCT *cds )
+{
+    static const GUID zero_guid;
+    const struct systray_rect_request *req = cds->lpData;
+    struct icon *icon = NULL, *ptr;
+    RECT rect;
+
+    if (cds->cbData < sizeof(*req)) return 0;
+    if (memcmp( &req->guidItem, &zero_guid, sizeof(GUID) ))
+    {
+        LIST_FOR_EACH_ENTRY( ptr, &icon_list, struct icon, entry )
+            if (!memcmp( &ptr->guid, &req->guidItem, sizeof(GUID) )) { icon = ptr; break; }
+    }
+    else icon = get_icon( LongToHandle( req->hWnd ), req->uID );
+
+    if (!icon || icon->display == ICON_DISPLAY_HIDDEN || !icon->window ||
+        !GetWindowRect( icon->window, &rect ))
+        return 0;
+    switch (req->part)
+    {
+    case 0: return 1;
+    case 1: return MAKELONG( rect.left, rect.top );
+    case 2: return MAKELONG( rect.right, rect.bottom );
+    }
+    return 0;
+}
