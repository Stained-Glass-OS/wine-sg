+/* explorer's systray (programs/explorer/systray.c) answers these */
+#define SYSTRAY_GET_ICON_RECT 0x53470001
+
+struct systray_rect_request  /* platform-independent, as struct notify_data */
+{
+    DWORD hWnd;
+    UINT  uID;
+    GUID  guidItem;
+    DWORD part;
+};
+
 HRESULT WINAPI Shell_NotifyIconGetRect(const NOTIFYICONIDENTIFIER* identifier, RECT* icon_location)
 {
-    FIXME("stub (%p) (%p)\n", identifier, icon_location);
-    return E_NOTIMPL;
+    struct systray_rect_request req;
+    COPYDATASTRUCT cds;
+    LRESULT corner;
+    HWND tray;
+
+    TRACE("(%p) (%p)\n", identifier, icon_location);
+
+    if (!identifier || !icon_location || identifier->cbSize != sizeof(*identifier))
+        return E_INVALIDARG;
+    if (!(tray = FindWindowW( L"Shell_TrayWnd", NULL ))) return E_FAIL;
+
+    req.hWnd = HandleToLong( identifier->hWnd );
+    req.uID = identifier->uID;
+    req.guidItem = identifier->guidItem;
+    cds.dwData = SYSTRAY_GET_ICON_RECT;
+    cds.cbData = sizeof(req);
+    cds.lpData = &req;
+
+    req.part = 0;   /* is the icon shown? */
+    if (!SendMessageW( tray, WM_COPYDATA, 0, (LPARAM)&cds )) return E_FAIL;
+    req.part = 1;
+    corner = SendMessageW( tray, WM_COPYDATA, 0, (LPARAM)&cds );
+    icon_location->left = (short)LOWORD( corner );
+    icon_location->top = (short)HIWORD( corner );
+    req.part = 2;
+    corner = SendMessageW( tray, WM_COPYDATA, 0, (LPARAM)&cds );
+    icon_location->right = (short)LOWORD( corner );
+    icon_location->bottom = (short)HIWORD( corner );
+    TRACE("%s\n", wine_dbgstr_rect( icon_location ));
+    return S_OK;
 }
