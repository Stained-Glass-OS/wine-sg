From: Stained Glass OS <dev@stained-glass.example>
Subject: wineps: AlphaBlend prints

The PostScript driver's EMF playback dropped EMR_ALPHABLEND, so anything a
program alpha-blended onto a printer DC -- Direct2D's DC render target
presents that way (0300), which is how LibreOffice prints text -- was
missing from the page.

PostScript has no alpha: the bitmap's pixels that are at least half covered
(per-pixel alpha times the constant alpha) are un-premultiplied and drawn
through a clip region built from them, so the transparent part leaves what
is already on the page. Text printed this way is sharp at the printer's
resolution.

Gate: test/dcrt-print-gate.sh (print half); test/office-docs-gate.sh prints
a .docx from LibreOffice.
---
--- a/dlls/wineps.drv/printproc.c
+++ b/dlls/wineps.drv/printproc.c
@@ -402,6 +402,142 @@
     return !err;
 }
 
+/* PostScript has no alpha. An AlphaBlend (Direct2D's DC render targets
+ * present with one -- LibreOffice prints its text that way) is drawn as its
+ * opaque pixels: those at least half covered, un-premultiplied, through a
+ * clip region built from them, so what is under the transparent part of the
+ * bitmap stays as it was instead of turning black or vanishing. */
+static int alpha_blend(print_ctx *ctx, const EMRALPHABLEND *p)
+{
+    const BITMAPINFO *bi = (const BITMAPINFO *)((BYTE *)p + p->offBmiSrc);
+    BLENDFUNCTION blend = *(const BLENDFUNCTION *)&p->dwRop;
+    char info_buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+    BITMAPINFO *info = (BITMAPINFO *)info_buffer;
+    int width, height, x, y, count = 0, max_rects, ret = TRUE;
+    BOOL use_alpha;
+    EMRSTRETCHBLT blt;
+    RGNDATA *rgn_data;
+    HBITMAP bitmap;
+    DWORD *bits;
+    POINT pts[2];
+    XFORM xform;
+    RECT *rects;
+    HDC hdc;
+    HRGN rgn;
+
+    if (!p->cbBmiSrc || !p->cxSrc || !p->cySrc || !p->cxDest || !p->cyDest) return TRUE;
+
+    width = bi->bmiHeader.biWidth;
+    height = abs(bi->bmiHeader.biHeight);
+    use_alpha = (blend.AlphaFormat & AC_SRC_ALPHA) && bi->bmiHeader.biBitCount == 32;
+
+    /* the source as 32-bpp top-down BGRA, whatever it was recorded as */
+    memset(info, 0, sizeof(info->bmiHeader));
+    info->bmiHeader.biSize = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth = width;
+    info->bmiHeader.biHeight = -height;
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biBitCount = 32;
+    info->bmiHeader.biCompression = BI_RGB;
+    hdc = CreateCompatibleDC(NULL);
+    if (!(bitmap = CreateDIBSection(hdc, info, DIB_RGB_COLORS, (void **)&bits, NULL, 0)))
+    {
+        DeleteDC(hdc);
+        return FALSE;
+    }
+    SetDIBits(hdc, bitmap, 0, height, (const BYTE *)p + p->offBitsSrc, bi, p->iUsageSrc);
+
+    max_rects = p->cySrc * ((p->cxSrc + 1) / 2) + 1;
+    if (!(rgn_data = malloc(FIELD_OFFSET(RGNDATA, Buffer[max_rects * sizeof(RECT)]))))
+    {
+        DeleteObject(bitmap);
+        DeleteDC(hdc);
+        return FALSE;
+    }
+    rects = (RECT *)rgn_data->Buffer;
+
+    for (y = p->ySrc; y < p->ySrc + p->cySrc; y++)
+    {
+        int run = -1;
+
+        for (x = p->xSrc; x <= p->xSrc + p->cxSrc; x++)
+        {
+            BOOL opaque = FALSE;
+
+            if (x < p->xSrc + p->cxSrc && x >= 0 && x < width && y >= 0 && y < height)
+            {
+                DWORD *px = bits + y * width + x;
+                UINT a = use_alpha ? *px >> 24 : 255;
+
+                if (a * blend.SourceConstantAlpha / 255 >= 128)
+                {
+                    opaque = TRUE;
+                    if (use_alpha && a < 255)
+                    {
+                        UINT b = (*px & 0xff) * 255 / a, g = ((*px >> 8) & 0xff) * 255 / a;
+                        UINT r = ((*px >> 16) & 0xff) * 255 / a;
+
+                        *px = (a << 24) | (min(r, 255) << 16) | (min(g, 255) << 8) | min(b, 255);
+                    }
+                }
+            }
+            if (opaque && run < 0) run = x;
+            else if (!opaque && run >= 0)
+            {
+                SetRect(&rects[count++], run - p->xSrc, y - p->ySrc, x - p->xSrc, y - p->ySrc + 1);
+                run = -1;
+            }
+        }
+    }
+
+    if (count)
+    {
+        /* the region, from source pixels to device units of the destination */
+        pts[0].x = p->xDest;
+        pts[0].y = p->yDest;
+        pts[1].x = p->xDest + p->cxDest;
+        pts[1].y = p->yDest + p->cyDest;
+        LPtoDP(ctx->hdc, pts, 2);
+        xform.eM11 = (FLOAT)(pts[1].x - pts[0].x) / p->cxSrc;
+        xform.eM12 = xform.eM21 = 0.0f;
+        xform.eM22 = (FLOAT)(pts[1].y - pts[0].y) / p->cySrc;
+        xform.eDx = pts[0].x;
+        xform.eDy = pts[0].y;
+
+        rgn_data->rdh.dwSize = sizeof(rgn_data->rdh);
+        rgn_data->rdh.iType = RDH_RECTANGLES;
+        rgn_data->rdh.nCount = count;
+        rgn_data->rdh.nRgnSize = count * sizeof(RECT);
+        SetRect(&rgn_data->rdh.rcBound, 0, 0, p->cxSrc, p->cySrc);
+        rgn = ExtCreateRegion(&xform, FIELD_OFFSET(RGNDATA, Buffer[count * sizeof(RECT)]), rgn_data);
+
+        memset(&blt, 0, sizeof(blt));
+        blt.xDest = p->xDest;
+        blt.yDest = p->yDest;
+        blt.cxDest = p->cxDest;
+        blt.cyDest = p->cyDest;
+        blt.dwRop = SRCCOPY;
+        blt.xSrc = p->xSrc;
+        blt.ySrc = p->ySrc;
+        blt.xformSrc = p->xformSrc;
+        blt.iUsageSrc = DIB_RGB_COLORS;
+        blt.cbBmiSrc = sizeof(info->bmiHeader);
+        blt.cxSrc = p->cxSrc;
+        blt.cySrc = p->cySrc;
+
+        SaveDC(ctx->hdc);
+        if (rgn) ExtSelectClipRgn(ctx->hdc, rgn, RGN_AND);
+        ret = stretch_blt(ctx, &blt, info, (const BYTE *)bits);
+        RestoreDC(ctx->hdc, -1);
+        if (rgn) DeleteObject(rgn);
+    }
+
+    free(rgn_data);
+    DeleteObject(bitmap);
+    DeleteDC(hdc);
+    return ret;
+}
+
 #define FRGND_ROP3(ROP4)        ((ROP4) & 0x00FFFFFF)
 #define BKGND_ROP3(ROP4)        (ROP3Table[((ROP4)>>24) & 0xFF])
 
@@ -2805,8 +2941,9 @@
         return PlayEnhMetaFileRecord(data->ctx->hdc, htable, rec, handle_count);
     }
 
-    case EMR_EXTFLOODFILL:
     case EMR_ALPHABLEND:
+        return alpha_blend(data->ctx, (const EMRALPHABLEND *)rec);
+    case EMR_EXTFLOODFILL:
         break;
 
     case EMR_SETWINDOWEXTEX:
