+/* Stained Glass OS: a new surface starts in the window colour. What the
+ * program has not painted yet is shown as the window's background, as on
+ * Windows -- it was black, and every window opened with a black flash (David
+ * 2026-09-29): a surface's first flush sends all of it (window_surface_flush). */
+static void fill_new_surface( struct window_surface *surface )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    COLORREF color = get_sys_color( COLOR_WINDOW );
+    DWORD *bits, pixel, masks[3] = { 0xff0000, 0x00ff00, 0x0000ff };
+    UINT i, count;
+
+    if (!(bits = window_surface_get_color( surface, info ))) return;
+    if (info->bmiHeader.biBitCount != 32) return;
+    if (info->bmiHeader.biCompression == BI_BITFIELDS) memcpy( masks, info->bmiColors, sizeof(masks) );
+    else if (info->bmiHeader.biCompression != BI_RGB) return;
+    if (masks[0] == 0xff0000 && masks[1] == 0x00ff00 && masks[2] == 0x0000ff)
+        pixel = (GetRValue( color ) << 16) | (GetGValue( color ) << 8) | GetBValue( color );
+    else if (masks[0] == 0x0000ff && masks[1] == 0x00ff00 && masks[2] == 0xff0000)
+        pixel = (GetBValue( color ) << 16) | (GetGValue( color ) << 8) | GetRValue( color );
+    else return;
+    count = info->bmiHeader.biWidth * abs( info->bmiHeader.biHeight );
+    for (i = 0; i < count; i++) bits[i] = pixel;
+}
+
