--- /dev/null
+++ b/dlls/iphlpapi/netwrite.c
@@ -0,0 +1,528 @@
+/*
+ * iphlpapi: changing the network -- addresses, routes and neighbour (ARP)
+ * entries -- through sg-netctl (Stained Glass OS)
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* The network is NetworkManager's, behind sg-netctl, which decides from the
+ * Unix account who may change it. Every call here needs an administrator (the
+ * Administrators group in the caller's token) and is refused with
+ * ERROR_ACCESS_DENIED otherwise, before sg-netctl is asked. The requests are
+ *
+ *   addr  add|del DEVICE ADDRESS/PREFIX
+ *   route add|del|set DEVICE DESTINATION/PREFIX [--gateway ADDRESS] [--metric N]
+ *   neigh add DEVICE ADDRESS HWADDR [--permanent]
+ *   neigh del DEVICE ADDRESS
+ *   neigh flush [DEVICE] [--family 4|6]
+ *
+ * and sg-netctl answers "OK" or "ERROR <kind> <message>", kind one of denied,
+ * invalid, notfound, unsupported, failed. A plain Wine without sg-netctl, or
+ * cannot change the network: the new calls say ERROR_NOT_SUPPORTED; the older
+ * ones, which used to say NO_ERROR without doing anything, still do when there
+ * is no sg-netctl at all, so programs that only try carry on. Where there is one,
+ * every call returns the real result (kind "exists" is ERROR_OBJECT_ALREADY_EXISTS). */
+
+#include <stdarg.h>
+#define IPHLPAPI_DLL_LINKAGE
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winsock2.h"
+#include "ws2ipdef.h"
+#include "ws2tcpip.h"
+#include "iphlpapi.h"
+#include "ipifcons.h"
+#include "ifdef.h"
+#include "netioapi.h"
+#include "wine/debug.h"
+#include "wine/sgnetctl.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(iphlpapi);
+
+static BOOL caller_is_admin(void)
+{
+    SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    PSID admins;
+    BOOL member = FALSE;
+
+    if (!AllocateAndInitializeSid( &nt, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS,
+                                   0, 0, 0, 0, 0, 0, &admins )) return FALSE;
+#ifdef SG_MUTANT_NW_NOADMIN
+    member = TRUE;
+#else
+    if (!CheckTokenMembership( NULL, admins, &member )) member = FALSE;
+#endif
+    FreeSid( admins );
+    return member;
+}
+
+static BOOL is_ip_family( ADDRESS_FAMILY f ) { return f == AF_INET || f == AF_INET6; }
+
+/* The Linux name of an interface, given its LUID or index (the alias of the interface row). */
+static DWORD interface_name( const NET_LUID *luid, NET_IFINDEX index, WCHAR *name, DWORD len )
+{
+    MIB_IF_ROW2 row = {0};
+    DWORD err;
+
+    if (!luid->Value && !index) return ERROR_INVALID_PARAMETER;
+    row.InterfaceLuid = *luid;
+    row.InterfaceIndex = index;
+    if ((err = GetIfEntry2( &row ))) return err;
+    lstrcpynW( name, row.Alias, len );
+    return name[0] ? NO_ERROR : ERROR_NOT_FOUND;
+}
+
+static BOOL address_text( const SOCKADDR_INET *a, WCHAR *buf, DWORD len )
+{
+    if (a->si_family == AF_INET) return InetNtopW( AF_INET, (void *)&a->Ipv4.sin_addr, buf, len ) != NULL;
+    return InetNtopW( AF_INET6, (void *)&a->Ipv6.sin6_addr, buf, len ) != NULL;
+}
+
+static BOOL address_is_zero( const SOCKADDR_INET *a )
+{
+    static const IN6_ADDR zero6;
+    if (a->si_family == AF_INET) return !a->Ipv4.sin_addr.s_addr;
+    return a->si_family == AF_INET6 && !memcmp( &a->Ipv6.sin6_addr, &zero6, sizeof(zero6) );
+}
+
+static BOOL is_multicast( const SOCKADDR_INET *a )
+{
+    if (a->si_family == AF_INET) return (ntohl( a->Ipv4.sin_addr.s_addr ) >> 28) == 0xe;
+    return a->si_family == AF_INET6 && a->Ipv6.sin6_addr.s6_addr[0] == 0xff;
+}
+
+static DWORD map_reply( int ret, const struct sgnet_reply *r, BOOL legacy )
+{
+    if (ret < 0) return legacy ? NO_ERROR : ERROR_NOT_SUPPORTED;  /* no sg-netctl at all: a plain Wine */
+    if (ret) return NO_ERROR;
+    if (!wcscmp( r->kind, L"denied" )) return ERROR_ACCESS_DENIED;
+    if (!wcscmp( r->kind, L"invalid" )) return ERROR_INVALID_PARAMETER;
+    if (!wcscmp( r->kind, L"notfound" )) return ERROR_NOT_FOUND;
+    if (!wcscmp( r->kind, L"exists" )) return ERROR_OBJECT_ALREADY_EXISTS;
+    if (!wcscmp( r->kind, L"unsupported" )) return ERROR_NOT_SUPPORTED;
+    return ERROR_GEN_FAILURE;
+}
+
+/* argv: the request; legacy: the older calls that answered NO_ERROR when nothing could be done */
+static DWORD netctl( const WCHAR *const *argv, int argc, BOOL legacy )
+{
+    struct sgnet_reply r;
+    int ret = sgnet_request( argv, argc, &r );
+#ifdef SG_MUTANT_NW_LEGACY
+    legacy = FALSE;
+#endif
+    DWORD err = map_reply( ret, &r, legacy );
+
+    if (legacy && ret < 0) FIXME( "the network is not changed: %s\n", debugstr_w( argv[0] ) );
+    sgnet_free( &r );
+    return err;
+}
+
+static DWORD prefix_text( const SOCKADDR_INET *a, UINT8 prefix, WCHAR *buf, DWORD len )
+{
+    WCHAR addr[64];
+
+    if (!address_text( a, addr, ARRAY_SIZE(addr) )) return ERROR_INVALID_PARAMETER;
+    swprintf( buf, len, L"%s/%u", addr, prefix );
+    return NO_ERROR;
+}
+
+static UINT8 default_prefix( const SOCKADDR_INET *a )
+{
+    DWORD ip;
+
+    if (a->si_family == AF_INET6) return 64;
+    ip = ntohl( a->Ipv4.sin_addr.s_addr );
+#ifdef SG_MUTANT_NW_PREFIX
+    return 24;
+#endif
+    return (ip >> 31) == 0 ? 8 : (ip >> 30) == 2 ? 16 : 24;  /* the address class */
+}
+
+static DWORD unicast_request( const MIB_UNICASTIPADDRESS_ROW *row, const WCHAR *verb )
+{
+    WCHAR dev[256], spec[96];
+    const WCHAR *args[4];
+    UINT8 prefix;
+    DWORD err;
+
+    if (!row || !is_ip_family( row->Address.si_family )) return ERROR_INVALID_PARAMETER;
+    if (address_is_zero( &row->Address ) || is_multicast( &row->Address )) return ERROR_INVALID_PARAMETER;
+    prefix = row->OnLinkPrefixLength == 255 ? default_prefix( &row->Address ) : row->OnLinkPrefixLength;
+    if (prefix > (row->Address.si_family == AF_INET ? 32 : 128)) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    if ((err = interface_name( &row->InterfaceLuid, row->InterfaceIndex, dev, ARRAY_SIZE(dev) ))) return err;
+    if ((err = prefix_text( &row->Address, prefix, spec, ARRAY_SIZE(spec) ))) return err;
+    args[0] = L"addr"; args[1] = verb; args[2] = dev; args[3] = spec;
+    return netctl( args, 4, FALSE );
+}
+
+/******************************************************************
+ *    CreateUnicastIpAddressEntry (IPHLPAPI.@)
+ */
+DWORD WINAPI CreateUnicastIpAddressEntry( const MIB_UNICASTIPADDRESS_ROW *row )
+{
+    TRACE( "%p\n", row );
+    return unicast_request( row, L"add" );
+}
+
+/******************************************************************
+ *    DeleteUnicastIpAddressEntry (IPHLPAPI.@)
+ */
+DWORD WINAPI DeleteUnicastIpAddressEntry( const MIB_UNICASTIPADDRESS_ROW *row )
+{
+    TRACE( "%p\n", row );
+    return unicast_request( row, L"del" );
+}
+
+/******************************************************************
+ *    SetUnicastIpAddressEntry (IPHLPAPI.@)
+ *
+ * Only the lifetimes and the like of an address that is there can be set,
+ * and the system keeps its own: the address has to exist, and nothing else
+ * changes.
+ */
+DWORD WINAPI SetUnicastIpAddressEntry( const MIB_UNICASTIPADDRESS_ROW *row )
+{
+    MIB_UNICASTIPADDRESS_ROW copy;
+    DWORD err;
+
+    TRACE( "%p\n", row );
+    if (!row || !is_ip_family( row->Address.si_family )) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    copy = *row;
+    if ((err = GetUnicastIpAddressEntry( &copy ))) return err;
+    return NO_ERROR;
+}
+
+static DWORD anycast_request( const MIB_ANYCASTIPADDRESS_ROW *row )
+{
+    if (!row || !is_ip_family( row->Address.si_family )) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    return ERROR_NOT_SUPPORTED;  /* Linux has no anycast addresses to make this way */
+}
+
+/******************************************************************
+ *    CreateAnycastIpAddressEntry (IPHLPAPI.@)
+ */
+DWORD WINAPI CreateAnycastIpAddressEntry( const MIB_ANYCASTIPADDRESS_ROW *row )
+{
+    TRACE( "%p\n", row );
+    return anycast_request( row );
+}
+
+/******************************************************************
+ *    DeleteAnycastIpAddressEntry (IPHLPAPI.@)
+ */
+DWORD WINAPI DeleteAnycastIpAddressEntry( const MIB_ANYCASTIPADDRESS_ROW *row )
+{
+    TRACE( "%p\n", row );
+    return anycast_request( row );
+}
+
+static DWORD forward_request( const MIB_IPFORWARD_ROW2 *row, const WCHAR *verb, BOOL legacy )
+{
+    WCHAR dev[256], dest[96], gateway[64], metric[16];
+    const WCHAR *args[9];
+    int n = 0;
+    DWORD err;
+    ADDRESS_FAMILY family;
+
+    if (!row) return ERROR_INVALID_PARAMETER;
+    family = row->DestinationPrefix.Prefix.si_family;
+    if (!is_ip_family( family )) return ERROR_INVALID_PARAMETER;
+    if (row->DestinationPrefix.PrefixLength > (family == AF_INET ? 32 : 128)) return ERROR_INVALID_PARAMETER;
+    if (row->NextHop.si_family && row->NextHop.si_family != family) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    if ((err = interface_name( &row->InterfaceLuid, row->InterfaceIndex, dev, ARRAY_SIZE(dev) ))) return err;
+    if ((err = prefix_text( &row->DestinationPrefix.Prefix, row->DestinationPrefix.PrefixLength, dest, ARRAY_SIZE(dest) )))
+        return err;
+    args[n++] = L"route"; args[n++] = verb; args[n++] = dev; args[n++] = dest;
+    if (row->NextHop.si_family && !address_is_zero( &row->NextHop ))
+    {
+        if (!address_text( &row->NextHop, gateway, ARRAY_SIZE(gateway) )) return ERROR_INVALID_PARAMETER;
+#ifndef SG_MUTANT_NW_GATEWAY
+        args[n++] = L"--gateway"; args[n++] = gateway;
+#endif
+    }
+    if (wcscmp( verb, L"del" ))
+    {
+        swprintf( metric, ARRAY_SIZE(metric), L"%u", row->Metric );
+        args[n++] = L"--metric"; args[n++] = metric;
+    }
+    return netctl( args, n, legacy );
+}
+
+/******************************************************************
+ *    CreateIpForwardEntry2 (IPHLPAPI.@)
+ */
+DWORD WINAPI CreateIpForwardEntry2( const MIB_IPFORWARD_ROW2 *row )
+{
+    TRACE( "%p\n", row );
+    return forward_request( row, L"add", FALSE );
+}
+
+/******************************************************************
+ *    DeleteIpForwardEntry2 (IPHLPAPI.@)
+ */
+DWORD WINAPI DeleteIpForwardEntry2( const MIB_IPFORWARD_ROW2 *row )
+{
+    TRACE( "%p\n", row );
+    return forward_request( row, L"del", FALSE );
+}
+
+/******************************************************************
+ *    SetIpForwardEntry2 (IPHLPAPI.@)
+ *
+ * The route's metric is what can change.
+ */
+DWORD WINAPI SetIpForwardEntry2( const MIB_IPFORWARD_ROW2 *row )
+{
+    TRACE( "%p\n", row );
+    return forward_request( row, L"set", FALSE );
+}
+
+/* the older, IPv4-only route calls */
+static void forward_row( const MIB_IPFORWARDROW *in, MIB_IPFORWARD_ROW2 *out )
+{
+    DWORD mask = ntohl( in->dwForwardMask ), bits = 0;
+
+    memset( out, 0, sizeof(*out) );
+    out->InterfaceIndex = in->dwForwardIfIndex;
+    out->DestinationPrefix.Prefix.Ipv4.sin_family = AF_INET;
+    out->DestinationPrefix.Prefix.Ipv4.sin_addr.s_addr = in->dwForwardDest;
+    while (mask & 0x80000000) { bits++; mask <<= 1; }
+    out->DestinationPrefix.PrefixLength = bits;
+    if (in->dwForwardNextHop)
+    {
+        out->NextHop.Ipv4.sin_family = AF_INET;
+        out->NextHop.Ipv4.sin_addr.s_addr = in->dwForwardNextHop;
+    }
+    out->Metric = in->dwForwardMetric1;
+}
+
+static DWORD legacy_forward( const MIB_IPFORWARDROW *row, const WCHAR *verb )
+{
+    MIB_IPFORWARD_ROW2 row2;
+
+    if (!row) return ERROR_INVALID_PARAMETER;
+    forward_row( row, &row2 );
+    return forward_request( &row2, verb, TRUE );
+}
+
+DWORD net_create_forward_entry( const MIB_IPFORWARDROW *row ) { return legacy_forward( row, L"add" ); }
+DWORD net_delete_forward_entry( const MIB_IPFORWARDROW *row ) { return legacy_forward( row, L"del" ); }
+DWORD net_set_forward_entry( const MIB_IPFORWARDROW *row ) { return legacy_forward( row, L"set" ); }
+
+static DWORD neigh_request( const SOCKADDR_INET *address, const NET_LUID *luid, NET_IFINDEX index, const BYTE *mac,
+                            ULONG mac_len, BOOL permanent, const WCHAR *verb, BOOL legacy )
+{
+    WCHAR dev[256], addr[64], hw[32];
+    const WCHAR *args[7];
+    int n = 0;
+    DWORD err;
+
+    if (!address || !is_ip_family( address->si_family ) || address_is_zero( address )) return ERROR_INVALID_PARAMETER;
+    if (!wcscmp( verb, L"add" ) && (mac_len != 6 || !mac)) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    if ((err = interface_name( luid, index, dev, ARRAY_SIZE(dev) ))) return err;
+    if (!address_text( address, addr, ARRAY_SIZE(addr) )) return ERROR_INVALID_PARAMETER;
+    args[n++] = L"neigh"; args[n++] = verb; args[n++] = dev; args[n++] = addr;
+    if (!wcscmp( verb, L"add" ))
+    {
+        swprintf( hw, ARRAY_SIZE(hw), L"%02x:%02x:%02x:%02x:%02x:%02x", mac[0], mac[1], mac[2], mac[3], mac[4], mac[5] );
+        args[n++] = hw;
+        if (permanent) args[n++] = L"--permanent";
+    }
+    return netctl( args, n, legacy );
+}
+
+/******************************************************************
+ *    CreateIpNetEntry2 (IPHLPAPI.@)
+ */
+DWORD WINAPI CreateIpNetEntry2( const MIB_IPNET_ROW2 *row )
+{
+    TRACE( "%p\n", row );
+    if (!row) return ERROR_INVALID_PARAMETER;
+    return neigh_request( &row->Address, &row->InterfaceLuid, row->InterfaceIndex, row->PhysicalAddress,
+                          row->PhysicalAddressLength, row->State == NlnsPermanent, L"add", FALSE );
+}
+
+/******************************************************************
+ *    DeleteIpNetEntry2 (IPHLPAPI.@)
+ */
+DWORD WINAPI DeleteIpNetEntry2( const MIB_IPNET_ROW2 *row )
+{
+    TRACE( "%p\n", row );
+    if (!row) return ERROR_INVALID_PARAMETER;
+    return neigh_request( &row->Address, &row->InterfaceLuid, row->InterfaceIndex, NULL, 0, FALSE, L"del", FALSE );
+}
+
+/******************************************************************
+ *    SetIpNetEntry2 (IPHLPAPI.@)
+ *
+ * The hardware address (and so the entry) is replaced.
+ */
+DWORD WINAPI SetIpNetEntry2( MIB_IPNET_ROW2 *row )
+{
+    TRACE( "%p\n", row );
+    if (!row) return ERROR_INVALID_PARAMETER;
+    return neigh_request( &row->Address, &row->InterfaceLuid, row->InterfaceIndex, row->PhysicalAddress,
+                          row->PhysicalAddressLength, row->State == NlnsPermanent, L"add", FALSE );
+}
+
+static DWORD legacy_neigh( const MIB_IPNETROW *row, const WCHAR *verb )
+{
+    SOCKADDR_INET a = {{0}};
+    NET_LUID luid = {0};
+
+    if (!row) return ERROR_INVALID_PARAMETER;
+    a.Ipv4.sin_family = AF_INET;
+    a.Ipv4.sin_addr.s_addr = row->dwAddr;
+    return neigh_request( &a, &luid, row->dwIndex, row->bPhysAddr, row->dwPhysAddrLen,
+                          row->dwType == MIB_IPNET_TYPE_STATIC, verb, TRUE );
+}
+
+DWORD net_create_net_entry( const MIB_IPNETROW *row ) { return legacy_neigh( row, L"add" ); }
+DWORD net_delete_net_entry( const MIB_IPNETROW *row ) { return legacy_neigh( row, L"del" ); }
+DWORD net_set_net_entry( const MIB_IPNETROW *row ) { return legacy_neigh( row, L"add" ); }
+
+static DWORD flush_neighbours( ADDRESS_FAMILY family, const NET_LUID *luid, NET_IFINDEX index, BOOL legacy )
+{
+    WCHAR dev[256];
+    const WCHAR *args[6];
+    int n = 0;
+    DWORD err;
+
+    if (family != AF_UNSPEC && !is_ip_family( family )) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    args[n++] = L"neigh"; args[n++] = L"flush";
+    if (luid->Value || index)
+    {
+        if ((err = interface_name( luid, index, dev, ARRAY_SIZE(dev) ))) return err;
+        args[n++] = dev;
+    }
+    if (family != AF_UNSPEC)
+    {
+        args[n++] = L"--family"; args[n++] = family == AF_INET ? L"4" : L"6";
+    }
+    return netctl( args, n, legacy );
+}
+
+/******************************************************************
+ *    FlushIpNetTable2 (IPHLPAPI.@)
+ */
+DWORD WINAPI FlushIpNetTable2( ADDRESS_FAMILY family, NET_IFINDEX index )
+{
+    NET_LUID none = {0};
+
+    TRACE( "%u, %lu\n", family, index );
+    return flush_neighbours( family, &none, index, FALSE );
+}
+
+DWORD net_flush_net_table( DWORD index )
+{
+    NET_LUID none = {0};
+
+    if (!index) return ERROR_INVALID_PARAMETER;
+    return flush_neighbours( AF_INET, &none, index, TRUE );
+}
+
+/******************************************************************
+ *    FlushIpPathTable (IPHLPAPI.@)
+ *
+ * There are no cached paths to forget (GetIpPathTable is empty), so for an
+ * administrator this has nothing to do.
+ */
+DWORD WINAPI FlushIpPathTable( ADDRESS_FAMILY family )
+{
+    TRACE( "%u\n", family );
+    if (family != AF_UNSPEC && !is_ip_family( family )) return ERROR_INVALID_PARAMETER;
+    if (!caller_is_admin()) return ERROR_ACCESS_DENIED;
+    return NO_ERROR;
+}
+
+/* AddIPAddress / DeleteIPAddress: the address added is remembered under the context handed out */
+static struct nte { ULONG context; DWORD index; IPAddr address; IPMask mask; } *ntes;
+static unsigned int nte_count;
+static ULONG nte_next = 1;
+static CRITICAL_SECTION nte_cs;
+static CRITICAL_SECTION_DEBUG nte_cs_debug =
+{
+    0, 0, &nte_cs, { &nte_cs_debug.ProcessLocksList, &nte_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": nte_cs") }
+};
+static CRITICAL_SECTION nte_cs = { &nte_cs_debug, -1, 0, 0, 0, 0 };
+
+static void nte_row( DWORD index, IPAddr address, IPMask mask, MIB_UNICASTIPADDRESS_ROW *row )
+{
+    DWORD m = ntohl( mask ), bits = 0;
+
+    InitializeUnicastIpAddressEntry( row );
+    row->InterfaceIndex = index;
+    row->Address.Ipv4.sin_family = AF_INET;
+    row->Address.Ipv4.sin_addr.s_addr = address;
+    while (m & 0x80000000) { bits++; m <<= 1; }
+    row->OnLinkPrefixLength = bits;
+}
+
+DWORD net_add_ip_address( IPAddr address, IPMask mask, DWORD index, ULONG *context, ULONG *instance )
+{
+    MIB_UNICASTIPADDRESS_ROW row;
+    struct nte *n;
+    DWORD err;
+
+    if (!address || !context || !instance) return ERROR_INVALID_PARAMETER;
+    nte_row( index, address, mask, &row );
+    if ((err = unicast_request( &row, L"add" ))) return err;
+    EnterCriticalSection( &nte_cs );
+    if ((n = realloc( ntes, (nte_count + 1) * sizeof(*ntes) )))
+    {
+        ntes = n;
+        ntes[nte_count].context = *context = nte_next++;
+        ntes[nte_count].index = index;
+        ntes[nte_count].address = address;
+        ntes[nte_count].mask = mask;
+        nte_count++;
+        *instance = 0;
+    }
+    else err = ERROR_NOT_ENOUGH_MEMORY;
+    LeaveCriticalSection( &nte_cs );
+    return err;
+}
+
+DWORD net_delete_ip_address( ULONG context )
+{
+    MIB_UNICASTIPADDRESS_ROW row;
+    DWORD err = ERROR_INVALID_PARAMETER;
+    unsigned int i;
+
+    EnterCriticalSection( &nte_cs );
+    for (i = 0; i < nte_count; i++)
+    {
+        if (ntes[i].context != context) continue;
+        nte_row( ntes[i].index, ntes[i].address, ntes[i].mask, &row );
+        if (!(err = unicast_request( &row, L"del" )))
+            memmove( ntes + i, ntes + i + 1, (--nte_count - i) * sizeof(*ntes) );
+        break;
+    }
+    LeaveCriticalSection( &nte_cs );
+    return err;
+}
