From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] webservices: reader checks the XML declaration and empty input like Windows

Wine's own reader tests record from real Windows: a document whose first
bytes are not a plausible XML declaration has no charset (WS_E_INVALID_FORMAT),
the declaration needs version= and may carry encoding= and standalone=
before "?>", an empty document cannot be read, and a buffer input has no
UTF8_TRIM_SIZE or STREAM_BUFFER_SIZE property (E_INVALIDARG). That removes
9 todo_wine marks from dlls/webservices/tests/reader.c.

Gate: test/wsreader-gate.sh (64 and 32 bit). Mutants SG_MUTANT_WS_DECL,
_XMLDECL, _EMPTYDOC and _BUFPROP are caught.
---
--- a/dlls/webservices/reader.c
+++ b/dlls/webservices/reader.c
@@ -819,6 +819,12 @@ HRESULT WINAPI WsGetReaderProperty( WS_XML_READER *handle, WS_XML_READER_PROPERT
 
     if (!reader->input_type) hr = WS_E_INVALID_OPERATION;
     else if (id == WS_XML_READER_PROPERTY_CHARSET) hr = get_charset( reader, buf, size );
+    /* these belong to a stream the reader reads, not to a buffer it was handed */
+#ifndef SG_MUTANT_WS_BUFPROP
+    else if (reader->input_type == WS_XML_READER_INPUT_TYPE_BUFFER &&
+             (id == WS_XML_READER_PROPERTY_UTF8_TRIM_SIZE || id == WS_XML_READER_PROPERTY_STREAM_BUFFER_SIZE))
+        hr = E_INVALIDARG;
+#endif
     else hr = prop_get( reader->prop, reader->prop_count, id, buf, size );
 
     LeaveCriticalSection( &reader->cs );
@@ -1107,6 +1113,31 @@ static inline HRESULT read_cmp( struct reader *reader, const char *str, int len
     return S_OK;
 }
 
+/* name = "value" or name = 'value' */
+static HRESULT read_xmldecl_value( struct reader *reader, const char *name )
+{
+    ULONG len = strlen( name );
+    unsigned char quote, c;
+
+    if (read_cmp( reader, name, len ) != S_OK) return WS_E_INVALID_FORMAT;
+    read_skip( reader, len );
+    read_skip_whitespace( reader );
+    if (read_cmp( reader, "=", 1 ) != S_OK) return WS_E_INVALID_FORMAT;
+    read_skip( reader, 1 );
+    read_skip_whitespace( reader );
+    if (read_more_data( reader, 1, NULL, NULL ) != S_OK) return WS_E_INVALID_FORMAT;
+    quote = *read_current_ptr( reader );
+    if (quote != '"' && quote != '\'') return WS_E_INVALID_FORMAT;
+    read_skip( reader, 1 );
+    for (;;)
+    {
+        if (read_more_data( reader, 1, NULL, NULL ) != S_OK) return WS_E_INVALID_FORMAT;
+        c = *read_current_ptr( reader );
+        read_skip( reader, 1 );
+        if (c == quote) return S_OK;
+    }
+}
+
 static HRESULT read_xmldecl( struct reader *reader )
 {
     HRESULT hr;
@@ -1120,11 +1151,23 @@ static HRESULT read_xmldecl( struct reader *reader )
     if ((hr = read_cmp( reader, "<?xml ", 6 )) != S_OK) return hr;
     read_skip( reader, 6 );
 
-    /* FIXME: parse attributes */
-    for (;;)
+    /* version is required, encoding and standalone may follow, in that order */
+    read_skip_whitespace( reader );
+#ifndef SG_MUTANT_WS_XMLDECL
+    if ((hr = read_xmldecl_value( reader, "version" )) != S_OK) return hr;
+#else
+    while (read_cmp( reader, "?>", 2 ) != S_OK) read_skip( reader, 1 );
+#endif
+    read_skip_whitespace( reader );
+    if (read_cmp( reader, "encoding", 8 ) == S_OK)
     {
-        if (read_more_data( reader, 1, NULL, NULL ) != S_OK || *read_current_ptr( reader ) == '?' ) break;
-        read_skip( reader, 1 );
+        if ((hr = read_xmldecl_value( reader, "encoding" )) != S_OK) return hr;
+        read_skip_whitespace( reader );
+    }
+    if (read_cmp( reader, "standalone", 10 ) == S_OK)
+    {
+        if ((hr = read_xmldecl_value( reader, "standalone" )) != S_OK) return hr;
+        read_skip_whitespace( reader );
     }
 
     if ((hr = read_cmp( reader, "?>", 2 )) != S_OK) return hr;
@@ -3029,6 +3072,10 @@ static HRESULT read_node_text( struct reader *reader )
     {
         if (read_end_of_data( reader ))
         {
+            /* a document with nothing in it is not a document */
+#ifndef SG_MUTANT_WS_EMPTYDOC
+            if (reader->state == READER_STATE_INITIAL) return WS_E_INVALID_FORMAT;
+#endif
             reader->current = LIST_ENTRY( list_tail( &reader->root->children ), struct node, entry );
             reader->last    = reader->current;
             reader->state   = READER_STATE_EOF;
@@ -7052,12 +7099,32 @@ static inline BOOL is_utf16le( const unsigned char *data, ULONG size, ULONG *off
            (size >= 4 && data[0] == '<' && !data[1] && !(*offset = 0));
 }
 
+/* the characters of the text, whatever its width */
+static inline unsigned int text_char( const unsigned char *data, ULONG size, ULONG i, WS_CHARSET charset )
+{
+    if (charset == WS_CHARSET_UTF16LE) return (i + 1) * 2 <= size ? data[i * 2] | (data[i * 2 + 1] << 8) : ~0u;
+    return i < size ? data[i] : ~0u;
+}
+
+static BOOL valid_declaration_start( const unsigned char *data, ULONG size, WS_CHARSET charset )
+{
+    static const char decl[] = "<?xml", version[] = "version";
+    ULONG i = 0, j;
+
+    if (text_char( data, size, 0, charset ) != '<' || text_char( data, size, 1, charset ) != '?') return TRUE;
+    for (j = 0; j < sizeof(decl) - 1; j++, i++)
+        if (text_char( data, size, i, charset ) != (unsigned char)decl[j]) return FALSE;
+    if (!iswspace( text_char( data, size, i, charset ) )) return FALSE;
+    while (iswspace( text_char( data, size, i, charset ) )) i++;
+    for (j = 0; j < sizeof(version) - 1; j++, i++)
+        if (text_char( data, size, i, charset ) != (unsigned char)version[j]) return FALSE;
+    return TRUE;
+}
+
 static WS_CHARSET detect_charset( const unsigned char *data, ULONG size, ULONG *offset )
 {
     WS_CHARSET ret = 0;
 
-    /* FIXME: parse xml declaration */
-
     if (is_utf16le( data, size, offset )) ret = WS_CHARSET_UTF16LE;
     else if (is_utf8( data, size, offset )) ret = WS_CHARSET_UTF8;
     else
@@ -7066,6 +7133,12 @@ static WS_CHARSET detect_charset( const unsigned char *data, ULONG size, ULONG *
         return 0;
     }
 
+    /* A document that opens with "<?" has to open with an XML declaration, and the declaration has
+     * to begin with its version; anything else, or too little of it, is no document. */
+#ifndef SG_MUTANT_WS_DECL
+    if (!valid_declaration_start( data + *offset, size - *offset, ret )) return 0;
+#endif
+
     TRACE( "detected charset %u\n", ret );
     return ret;
 }
