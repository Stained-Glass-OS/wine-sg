From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ole32: OleConvertOLESTREAMToIStorageEx; the embedded object's streams kept

OleConvertOLESTREAMToIStorageEx converts an OLE 1 stream to an OLE 2 storage and hands back its presentation object -- clipboard format (METAFILEPICT, DIB or BITMAP), width, height, size and data, in a global memory handle or the caller's stream -- instead of writing a presentation stream; the inverse of OleConvertIStorageToOLESTREAMEx. It was a spec stub. Also: when the OLE 1 stream held an OLE 2 storage, its temporary copy was opened with plain STGM_READ, which is refused, so OleConvertOLESTREAMToIStorage lost the object's own streams; it is opened for exclusive reading now. ole2.h gains the function.
---
--- a/include/ole2.h
+++ b/include/ole2.h
@@ -144,6 +144,7 @@
 WINOLE32API HRESULT     WINAPI OleConvertIStorageToOLESTREAM( LPSTORAGE pstg, LPOLESTREAM lpolestream);
 WINOLE32API HRESULT     WINAPI OleConvertIStorageToOLESTREAMEx( LPSTORAGE stg, CLIPFORMAT cf, LONG width, LONG height,
                                                                 DWORD size, LPSTGMEDIUM medium, LPOLESTREAM olestream );
+HRESULT     WINAPI OleConvertOLESTREAMToIStorageEx(LPOLESTREAM,LPSTORAGE,CLIPFORMAT*,LONG*,LONG*,DWORD*,LPSTGMEDIUM);
 WINOLE32API HRESULT     WINAPI OleDoAutoConvert( LPSTORAGE pStg, LPCLSID pClsidNew );
 WINOLE32API HRESULT     WINAPI OleGetAutoConvert( REFCLSID clsidOld, LPCLSID pClsidNew );
 WINOLE32API HRESULT     WINAPI OleSetAutoConvert( REFCLSID clsidOld, REFCLSID clsidNew );
--- a/dlls/ole32/storage32.c
+++ b/dlls/ole32/storage32.c
@@ -9921,7 +9921,13 @@
         CloseHandle(hFile);
 
         /* Open and copy temp storage to the Dest Storage */
+        /* (wine-sg 8274) opened for reading, exclusively: plain STGM_READ (deny none, direct) is refused,
+         * and the embedded object's streams were lost */
+#ifdef SG_MUTANT_OLE20_TEMP_SHARE
         hRes = StgOpenStorage(wstrTempFile, NULL, STGM_READ, NULL, 0, &pTempStorage);
+#else
+        hRes = StgOpenStorage(wstrTempFile, NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, NULL, 0, &pTempStorage);
+#endif
         if(hRes == S_OK)
         {
             hRes = IStorage_CopyTo(pTempStorage, 0, NULL, NULL, pDestStorage);
@@ -10512,6 +10518,117 @@
     return hRes;
 }
 
+#ifndef SG_MUTANT_NO_OLESTREAM_TO_STORAGE_EX
+/*************************************************************************
+ * OleConvertOLESTREAMToIStorageEx [OLE32.@]
+ *
+ * (wine-sg 8274) Like OleConvertOLESTREAMToIStorage, but the presentation object of the OLE 1 stream is
+ * handed back -- its clipboard format (METAFILEPICT, DIB or BITMAP), width, height and data, in a global
+ * memory handle (TYMED_NULL given) or written into the caller's stream (TYMED_ISTREAM) -- and the storage
+ * gets no presentation stream. The inverse of OleConvertIStorageToOLESTREAMEx.
+ */
+HRESULT WINAPI OleConvertOLESTREAMToIStorageEx(LPOLESTREAM stream, LPSTORAGE stg, CLIPFORMAT *cf, LONG *width,
+                                               LONG *height, DWORD *size, LPSTGMEDIUM medium)
+{
+    OLECONVERT_OLESTREAM_DATA data[2];
+    HRESULT hr;
+    int i;
+
+    TRACE("%p, %p, %p, %p, %p, %p, %p\n", stream, stg, cf, width, height, size, medium);
+
+    if (!stream || !stg || !cf || !width || !height || !size || !medium) return E_INVALIDARG;
+    if (medium->tymed != TYMED_NULL && medium->tymed != TYMED_ISTREAM) return E_INVALIDARG;
+    *cf = 0;
+    *width = *height = 0;
+    *size = 0;
+
+    memset(data, 0, sizeof(data));
+    hr = OLECONVERT_LoadOLE10(stream, &data[0], TRUE);
+    if (hr == S_OK) hr = OLECONVERT_LoadOLE10(stream, &data[1], FALSE);
+    if (hr == S_OK)
+    {
+        if (data[0].dwDataLength > sizeof(STORAGE_magic) && !memcmp(data[0].pData, STORAGE_magic, sizeof(STORAGE_magic)))
+            OLECONVERT_GetOLE20FromOLE10(stg, data[0].pData, data[0].dwDataLength);
+        else
+            OLECONVERT_CreateOle10NativeStream(stg, data[0].pData, data[0].dwDataLength);
+        hr = OLECONVERT_CreateCompObjStream(stg, data[0].strOleTypeName);
+        if (hr == S_OK) STORAGE_CreateOleStream(stg, 0);
+    }
+    if (hr == S_OK && data[1].dwTypeID && (data[1].dwDataLength || data[1].strOleTypeName[0]))
+    {
+        BYTE *joined = NULL;
+        const BYTE *bytes = data[1].pData;
+        DWORD len = data[1].dwDataLength;
+
+        /* OLECONVERT_LoadOLE10 keeps the first 8 bytes of a presentation object apart: for a metafile that
+         * is the METAFILEPICT16 header, not part of the data; a DIB's or bitmap's data starts with them */
+        if (!strcmp(data[1].strOleTypeName, "METAFILEPICT")) *cf = CF_METAFILEPICT;
+        else if (!strcmp(data[1].strOleTypeName, "DIB")) *cf = CF_DIB;
+        else if (!strcmp(data[1].strOleTypeName, "BITMAP")) *cf = CF_BITMAP;
+        else FIXME("presentation format %s\n", debugstr_a(data[1].strOleTypeName));
+        if (*cf == CF_DIB || *cf == CF_BITMAP)
+        {
+            if (!(joined = HeapAlloc(GetProcessHeap(), 0, len + 8))) hr = E_OUTOFMEMORY;
+            else
+            {
+                memcpy(joined, data[1].strUnknown, 8);
+                if (len) memcpy(joined + 8, data[1].pData, len);
+                bytes = joined;
+                len += 8;
+            }
+        }
+
+        if (*cf && hr == S_OK)
+        {
+            *width = data[1].dwMetaFileWidth;
+            *height = -(LONG)data[1].dwMetaFileHeight;
+            *size = len;
+            if (medium->tymed == TYMED_ISTREAM)
+            {
+                ULONG written = 0;
+                if (!medium->pstm) hr = E_INVALIDARG;
+                else if (SUCCEEDED(hr = IStream_Write(medium->pstm, bytes, len, &written)) && written != len)
+                    hr = STG_E_WRITEFAULT;
+                if (SUCCEEDED(hr)) hr = S_OK;
+            }
+            else
+            {
+                HGLOBAL mem = GlobalAlloc(GMEM_MOVEABLE, len ? len : 1);
+                void *p;
+
+                if (!mem || !(p = GlobalLock(mem)))
+                {
+                    if (mem) GlobalFree(mem);
+                    hr = E_OUTOFMEMORY;
+                }
+                else
+                {
+                    memcpy(p, bytes, len);
+                    GlobalUnlock(mem);
+                    medium->tymed = TYMED_HGLOBAL;
+                    medium->hGlobal = mem;
+                    medium->pUnkForRelease = NULL;
+                }
+            }
+        }
+        HeapFree(GetProcessHeap(), 0, joined);
+    }
+
+    for (i = 0; i < 2; i++)
+    {
+        HeapFree(GetProcessHeap(), 0, data[i].pData);
+        HeapFree(GetProcessHeap(), 0, data[i].pstrOleObjFileName);
+    }
+    return hr;
+}
+#else
+HRESULT WINAPI OleConvertOLESTREAMToIStorageEx(LPOLESTREAM stream, LPSTORAGE stg, CLIPFORMAT *cf, LONG *width,
+                                               LONG *height, DWORD *size, LPSTGMEDIUM medium)
+{
+    return E_NOTIMPL;
+}
+#endif
+
 /*************************************************************************
  * OleConvertIStorageToOLESTREAM [OLE32.@]
  *
--- a/dlls/ole32/ole32.spec
+++ b/dlls/ole32/ole32.spec
@@ -195,7 +195,7 @@
 @ stdcall OleConvertIStorageToOLESTREAM(ptr ptr)
 @ stdcall OleConvertIStorageToOLESTREAMEx(ptr long long long long ptr ptr)
 @ stdcall OleConvertOLESTREAMToIStorage(ptr ptr ptr)
-@ stub OleConvertOLESTREAMToIStorageEx
+@ stdcall OleConvertOLESTREAMToIStorageEx(ptr ptr ptr ptr ptr ptr ptr)
 @ stdcall OleCreate(ptr ptr long ptr ptr ptr ptr)
 @ stdcall OleCreateDefaultHandler(ptr ptr ptr ptr)
 @ stdcall OleCreateEmbeddingHelper(ptr ptr long ptr ptr ptr)
