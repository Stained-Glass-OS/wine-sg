 {
-    FIXME("iface %p, type_name %s, value %p stub!\n", iface, debugstr_hstring(type_name), value);
+    TRACE("iface %p, type_name %s, value %p.\n", iface, debugstr_hstring(type_name), value);
 
     if (!type_name)
         return E_INVALIDARG;
 
-    return E_NOTIMPL;
+    *value = is_type_present( type_name );
