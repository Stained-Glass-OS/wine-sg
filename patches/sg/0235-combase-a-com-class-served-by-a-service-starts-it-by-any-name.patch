From: Stained Glass OS <dev@stained-glass.example>
Subject: combase: a COM class served by a service starts it by any name, with its ServiceParameters

An AppID's LocalService names the service that serves a class; combase read
it into a buffer the size of a GUID, so a longer name (Google's updater's
"GoogleUpdaterInternalService152.0.7933.0") was "no LocalService value" and
the class was started through dllhost instead, which failed. It also read
"ServiceParams" where Windows keeps "ServiceParameters", so the service was
never told it was started for COM (the updater's "--com-service"). Names up
to 256 characters are read and the parameters are split like a command line
and passed to StartService.

With 0236 and 0237, Google Chrome's enterprise MSI installs (it ran its
updater, whose COM service never came up: MSI error 1627).

Gate: test/appfix-gate.sh.
---
--- a/dlls/combase/rpc.c
+++ b/dlls/combase/rpc.c
@@ -424,7 +424,7 @@
 static HRESULT create_local_service(REFCLSID rclsid)
 {
     HRESULT hr;
-    WCHAR buf[CHARS_IN_GUID];
+    WCHAR buf[257], *params = NULL, **args = NULL;
     HKEY hkey;
     LONG r;
     DWORD type, sz;
@@ -435,33 +435,46 @@
     if (FAILED(hr))
         return hr;
 
-    /* read the LocalService and ServiceParameters values from the AppID key */
+    /* read the LocalService and ServiceParameters values from the AppID key;
+     * a service name can be up to 256 characters (Google's updater's are
+     * longer than a GUID) */
     sz = sizeof buf;
     r = RegQueryValueExW(hkey, L"LocalService", NULL, &type, (LPBYTE)buf, &sz);
-    if (r == ERROR_SUCCESS && type == REG_SZ)
+    if (r == ERROR_SUCCESS && (type == REG_SZ || type == REG_EXPAND_SZ))
     {
         DWORD num_args = 0;
-        LPWSTR args[1] = { NULL };
+        WCHAR *p;
 
-        /*
-         * FIXME: I'm not really sure how to deal with the service parameters.
-         *        I suspect that the string returned from RegQueryValueExW
-         *        should be split into a number of arguments by spaces.
-         *        It would make more sense if ServiceParams contained a
-         *        REG_MULTI_SZ here, but it's a REG_SZ for the services
-         *        that I'm interested in for the moment.
-         */
-        r = RegQueryValueExW(hkey, L"ServiceParams", NULL, &type, NULL, &sz);
-        if (r == ERROR_SUCCESS && type == REG_SZ && sz)
+        buf[ARRAY_SIZE(buf) - 1] = 0;
+        /* the service's arguments, split like a command line */
+        r = RegQueryValueExW(hkey, L"ServiceParameters", NULL, &type, NULL, &sz);
+        if (r == ERROR_SUCCESS && (type == REG_SZ || type == REG_EXPAND_SZ) && sz > sizeof(WCHAR)
+                && (params = calloc(1, sz + sizeof(WCHAR)))
+                && (args = calloc(sz / sizeof(WCHAR) + 1, sizeof(*args))))
         {
-            args[0] = calloc(1, sz);
-            num_args++;
-            RegQueryValueExW(hkey, L"ServiceParams", NULL, &type, (LPBYTE)args[0], &sz);
+            RegQueryValueExW(hkey, L"ServiceParameters", NULL, &type, (LPBYTE)params, &sz);
+            for (p = params; *p;)
+            {
+                while (*p == ' ' || *p == '\t') *p++ = 0;
+                if (!*p) break;
+                if (*p == '"')
+                {
+                    args[num_args++] = ++p;
+                    while (*p && *p != '"') p++;
+                    if (*p) *p++ = 0;
+                }
+                else
+                {
+                    args[num_args++] = p;
+                    while (*p && *p != ' ' && *p != '\t') p++;
+                }
+            }
         }
         r = start_local_service(buf, num_args, (LPCWSTR *)args);
         if (r != ERROR_SUCCESS)
             hr = REGDB_E_CLASSNOTREG; /* FIXME: check retval */
-        free(args[0]);
+        free(args);
+        free(params);
     }
     else
     {
