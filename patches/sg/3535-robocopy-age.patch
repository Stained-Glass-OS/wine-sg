From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] robocopy: /MAXAGE and /MINAGE (3535)

robocopy: /MAXAGE and /MINAGE

robocopy /MAXAGE:n and /MINAGE:n (days, or a date YYYYMMDD) keep files by last-write age instead of ignoring the switches. /R /W /COPY stay parsed and ignored.
---
--- a/programs/robocopy/main.c
+++ b/programs/robocopy/main.c
@@ -63,6 +63,7 @@
     BOOL no_progress, no_file_list, no_dir_list, no_header, no_summary, no_size, no_class, tee;
     int levels;                    /* 0: unlimited */
     ULONGLONG max_size, min_size;  /* 0: none */
+    ULONGLONG max_age_cut, min_age_cut;  /* last-write cut-offs (FILETIME), 0: none */
     DWORD attr_add, attr_remove;
     HANDLE log;
 } opt;
@@ -337,6 +338,12 @@
         size = file_size( &fd );
         if ((opt.max_size && size > opt.max_size) || (opt.min_size && size < opt.min_size)) continue;
 
+        {
+            ULONGLONG wt = ((ULONGLONG)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime;
+            if (opt.max_age_cut && wt < opt.max_age_cut) continue;   /* older than /MAXAGE */
+            if (opt.min_age_cut && wt > opt.min_age_cut) continue;   /* newer than /MINAGE */
+        }
+
         s = join( src, fd.cFileName );
         d = join( dst, fd.cFileName );
         stats.files_total++;
@@ -448,6 +455,37 @@
     return FALSE;
 }
 
+/* /MAXAGE and /MINAGE: a number below 1900 is days back from now, otherwise a date YYYYMMDD; the result is the
+ * last-write time that bounds the age */
+static ULONGLONG age_cutoff( const WCHAR *s )
+{
+    long n = wcstol( s, NULL, 10 );
+    ULARGE_INTEGER u;
+
+    if (n <= 0) return 0;
+    if (n < 1900)
+    {
+        FILETIME ft;
+        GetSystemTimeAsFileTime( &ft );
+        u.LowPart = ft.dwLowDateTime;
+        u.HighPart = ft.dwHighDateTime;
+        return u.QuadPart - (ULONGLONG)n * 86400 * 10000000;
+    }
+    else
+    {
+        SYSTEMTIME st = { 0 };
+        FILETIME ft;
+
+        st.wYear = n / 10000;
+        st.wMonth = n / 100 % 100;
+        st.wDay = n % 100;
+        if (!SystemTimeToFileTime( &st, &ft )) return 0;
+        u.LowPart = ft.dwLowDateTime;
+        u.HighPart = ft.dwHighDateTime;
+        return u.QuadPart;
+    }
+}
+
 static DWORD parse_attrs( const WCHAR *s )
 {
     DWORD a = 0;
@@ -531,6 +569,8 @@
         else if (is_option( a, L"/IT", NULL )) opt.include_tweaked = TRUE;
         else if (is_option( a, L"/MAX", &value ) && value) opt.max_size = _wcstoui64( value, NULL, 10 );
         else if (is_option( a, L"/MIN", &value ) && value) opt.min_size = _wcstoui64( value, NULL, 10 );
+        else if (is_option( a, L"/MAXAGE", &value ) && value) opt.max_age_cut = age_cutoff( value );
+        else if (is_option( a, L"/MINAGE", &value ) && value) opt.min_age_cut = age_cutoff( value );
         else if (is_option( a, L"/L", NULL )) opt.list_only = TRUE;
         else if (is_option( a, L"/CREATE", NULL )) opt.create_only = TRUE;
         else if (is_option( a, L"/A+", &value )) opt.attr_add = parse_attrs( value );
@@ -571,7 +611,7 @@
                  is_option( a, L"/NODCOPY", NULL ) || is_option( a, L"/UNICODE", NULL ) || is_option( a, L"/IPG", &value ) ||
                  is_option( a, L"/REG", NULL ) || is_option( a, L"/TBD", NULL ) || is_option( a, L"/256", NULL ) ||
                  is_option( a, L"/EFSRAW", NULL ) || is_option( a, L"/IM", NULL ) || is_option( a, L"/NOSD", NULL ) ||
-                 is_option( a, L"/NODD", NULL ) || is_option( a, L"/MAXAGE", &value ) || is_option( a, L"/MINAGE", &value ) ||
+                 is_option( a, L"/NODD", NULL ) ||
                  is_option( a, L"/MAXLAD", &value ) || is_option( a, L"/MINLAD", &value ))
             WINE_TRACE( "accepted %s\n", wine_dbgstr_w(a) );
         else
