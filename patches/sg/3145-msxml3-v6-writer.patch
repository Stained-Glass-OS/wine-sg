From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 02:20:46 -0700
Subject: [PATCH] msxml3: version 6 SAX writer follows native for NULL
 arguments and declarations

The Wine msxml6 tests record how MXXMLWriter60 differs from the older
writers: a NULL string with length zero is accepted by characters,
ignorableWhitespace, processingInstruction, comment, startDTD and the
declaration handlers; the VB handlers return E_INVALIDARG for NULL
pointers and pass exact string lengths; DTD, ELEMENT, ENTITY and NOTATION
declarations are written the way native writes them (including the partial
output of calls that fail); an attribute default is not written for
#REQUIRED/#IMPLIED; an encoding that was chosen is not stated when the
output is a string; put_encoding("") and put_version(NULL or "") are
accepted; and SAXAttributes60 getQName checks pointers first and clears its
results. The writer also holds its output stream twice, as native does for
all versions. todo_wine marks that now pass are removed in the msxml3 and
msxml6 saxreader tests.

Office-facing: needs the Office sweep at integration.

diff --git a/dlls/msxml3/mxwriter.c b/dlls/msxml3/mxwriter.c
index 868bfa2..a732826 100644
--- a/dlls/msxml3/mxwriter.c
+++ b/dlls/msxml3/mxwriter.c
@@ -183,6 +183,7 @@ typedef struct
 
     BSTR encoding; /* exact property value */
     xml_encoding xml_enc;
+    BOOL encoding_set; /* put_encoding succeeded with a name */
 
     /* contains a pending (or not closed yet) element name or NULL if
        we don't have to close */
@@ -588,14 +589,21 @@ static void write_prolog_buffer(mxwriter *writer)
     write_output_buffer(writer, versionW, ARRAY_SIZE(versionW));
     write_output_buffer_quoted(writer, writer->version, -1);
 
-    /* encoding */
-    write_output_buffer(writer, encodingW, ARRAY_SIZE(encodingW));
+    /* encoding: version 6 does not state a chosen encoding for a string output */
+#ifdef SG_MUTANT_WRITER_ENC
+    if (1)
+#else
+    if (writer->class_version != MSXML6 || writer->dest || !writer->encoding_set)
+#endif
+    {
+        write_output_buffer(writer, encodingW, ARRAY_SIZE(encodingW));
 
-    if (writer->dest)
-        write_output_buffer(writer, writer->encoding, -1);
-    else
-        write_output_buffer(writer, utf16W, ARRAY_SIZE(utf16W) - 1);
-    write_output_buffer(writer, quotW, 1);
+        if (writer->dest)
+            write_output_buffer(writer, writer->encoding, -1);
+        else
+            write_output_buffer(writer, utf16W, ARRAY_SIZE(utf16W) - 1);
+        write_output_buffer(writer, quotW, 1);
+    }
 
     /* standalone */
     write_output_buffer(writer, standaloneW, ARRAY_SIZE(standaloneW));
@@ -1016,6 +1024,16 @@ static HRESULT dom_processing_instruction(mxwriter *writer, const WCHAR *target,
     return hr;
 }
 
+static void release_dest(mxwriter *writer)
+{
+    if (!writer->dest) return;
+#ifndef SG_MUTANT_WRITER_STREAMREF
+    IStream_Release(writer->dest);
+#endif
+    IStream_Release(writer->dest);
+    writer->dest = NULL;
+}
+
 static ULONG WINAPI mxwriter_Release(IMXWriter *iface)
 {
     mxwriter *This = impl_from_IMXWriter( iface );
@@ -1029,7 +1047,7 @@ static ULONG WINAPI mxwriter_Release(IMXWriter *iface)
         flush_output_buffer(This);
         free_output_buffer(&This->buffer);
 
-        if (This->dest) IStream_Release(This->dest);
+        release_dest(This);
         dom_release_nodes(This);
         if (This->dom) IXMLDOMDocument_Release(This->dom);
         SysFreeString(This->version);
@@ -1094,8 +1112,7 @@ static HRESULT WINAPI mxwriter_put_output(IMXWriter *iface, VARIANT dest)
     {
     case VT_EMPTY:
     {
-        if (This->dest) IStream_Release(This->dest);
-        This->dest = NULL;
+        release_dest(This);
         dom_release_nodes(This);
         if (This->dom) IXMLDOMDocument_Release(This->dom);
         This->dom = NULL;
@@ -1114,8 +1131,7 @@ static HRESULT WINAPI mxwriter_put_output(IMXWriter *iface, VARIANT dest)
         {
             dom_release_nodes(This);
             if (This->dom) IXMLDOMDocument_Release(This->dom);
-            if (This->dest) IStream_Release(This->dest);
-            This->dest = NULL;
+            release_dest(This);
             This->dom = dom;
             close_output_buffer(This);
             break;
@@ -1133,10 +1149,12 @@ static HRESULT WINAPI mxwriter_put_output(IMXWriter *iface, VARIANT dest)
             /* Recreate the output buffer to make sure it's using the correct encoding. */
             close_output_buffer(This);
 
-            if (This->dest) IStream_Release(This->dest);
+            release_dest(This);
             if (This->dom) IXMLDOMDocument_Release(This->dom);
             This->dom = NULL;
             dom_release_nodes(This);
+            /* the destination stream is referenced twice, as native does */
+            IStream_AddRef(stream);
             This->dest = stream;
             break;
         }
@@ -1209,6 +1227,10 @@ static HRESULT WINAPI mxwriter_put_encoding(IMXWriter *iface, BSTR encoding)
 
     TRACE("(%p)->(%s)\n", This, debugstr_w(encoding));
 
+    /* an empty name leaves the encoding as it is */
+    if (This->class_version == MSXML6 && encoding && !*encoding)
+        return S_OK;
+
     enc = parse_encoding_name(encoding);
     if (enc == XmlEncoding_Unknown)
     {
@@ -1222,6 +1244,7 @@ static HRESULT WINAPI mxwriter_put_encoding(IMXWriter *iface, BSTR encoding)
 
     SysReAllocString(&This->encoding, encoding);
     This->xml_enc = enc;
+    This->encoding_set = TRUE;
 
     TRACE("got encoding %d\n", This->xml_enc);
     close_output_buffer(This);
@@ -1309,13 +1332,18 @@ static HRESULT WINAPI mxwriter_get_omitXMLDeclaration(IMXWriter *iface, VARIANT_
 static HRESULT WINAPI mxwriter_put_version(IMXWriter *iface, BSTR version)
 {
     mxwriter *This = impl_from_IMXWriter( iface );
+    const WCHAR *new_version;
 
     TRACE("(%p)->(%s)\n", This, debugstr_w(version));
 
-    if (!version) return E_INVALIDARG;
+    if (This->class_version == MSXML6 && (!version || !*version))
+        new_version = L"1.0";
+    else
+        new_version = version;
+    if (!new_version) return E_INVALIDARG;
 
     SysFreeString(This->version);
-    This->version = SysAllocString(version);
+    This->version = SysAllocString(new_version);
 
     return S_OK;
 }
@@ -1519,6 +1547,26 @@ static void mxwriter_write_starttag(mxwriter *writer, const WCHAR *qname, int le
     writer_inc_indent(writer);
 }
 
+/* version 6 accepts a NULL string when its length is zero */
+static inline BOOL writer_is_v6(const mxwriter *writer)
+{
+#ifdef SG_MUTANT_WRITER_V6
+    return FALSE;
+#endif
+    return writer->class_version == MSXML6;
+}
+
+/* the VB handlers pass NULL pointers back as E_INVALIDARG in version 6, with exact string lengths */
+static inline HRESULT vb_null_arg(const mxwriter *writer)
+{
+    return writer_is_v6(writer) ? E_INVALIDARG : E_POINTER;
+}
+
+static inline int vb_len(const mxwriter *writer, BSTR str)
+{
+    return writer_is_v6(writer) ? SysStringLen(str) : -1;
+}
+
 static HRESULT WINAPI SAXContentHandler_startElement(
     ISAXContentHandler *iface,
     const WCHAR *namespaceUri,
@@ -1623,7 +1671,8 @@ static HRESULT WINAPI SAXContentHandler_characters(
 
     TRACE("(%p)->(%s:%d)\n", This, debugstr_wn(chars, nchars), nchars);
 
-    if (!chars) return E_INVALIDARG;
+    if (!chars && !(writer_is_v6(This) && !nchars)) return E_INVALIDARG;
+    if (!chars) chars = L"";
 
     if (This->dom) return dom_characters(This, chars, nchars);
 
@@ -1660,7 +1709,8 @@ static HRESULT WINAPI SAXContentHandler_ignorableWhitespace(
 
     TRACE("(%p)->(%s)\n", This, debugstr_wn(chars, nchars));
 
-    if (!chars) return E_INVALIDARG;
+    if (!chars && !(writer_is_v6(This) && !nchars)) return E_INVALIDARG;
+    if (!chars) chars = L"";
 
     if (This->dom) return dom_characters(This, chars, nchars);
 
@@ -1682,7 +1732,8 @@ static HRESULT WINAPI SAXContentHandler_processingInstruction(
 
     TRACE("(%p)->(%s %s)\n", This, debugstr_wn(target, ntarget), debugstr_wn(data, ndata));
 
-    if (!target) return E_INVALIDARG;
+    if (!target && !(writer_is_v6(This) && !ntarget)) return E_INVALIDARG;
+    if (!target) target = L"";
 
     if (This->dom) return dom_processing_instruction(This, target, ntarget, data, ndata);
 
@@ -1764,11 +1815,13 @@ static HRESULT WINAPI SAXLexicalHandler_startDTD(ISAXLexicalHandler *iface,
     TRACE("(%p)->(%s %s %s)\n", This, debugstr_wn(name, name_len), debugstr_wn(publicId, publicId_len),
         debugstr_wn(systemId, systemId_len));
 
-    if (!name) return E_INVALIDARG;
+    if (!name && !(writer_is_v6(This) && !name_len)) return E_INVALIDARG;
+    if (!name) name = L"";
 
     write_output_buffer(This, doctypeW, ARRAY_SIZE(doctypeW));
 
-    if (*name)
+    /* version 6 writes the separator even when there is no name */
+    if (*name || writer_is_v6(This))
     {
         write_output_buffer(This, name, name_len);
         write_output_buffer(This, spaceW, 1);
@@ -1863,7 +1916,8 @@ static HRESULT WINAPI SAXLexicalHandler_comment(ISAXLexicalHandler *iface, const
 
     TRACE("(%p)->(%s:%d)\n", This, debugstr_wn(chars, nchars), nchars);
 
-    if (!chars) return E_INVALIDARG;
+    if (!chars && !(writer_is_v6(This) && !nchars)) return E_INVALIDARG;
+    if (!chars) chars = L"";
 
     close_element_starttag(This);
     write_node_indent(This);
@@ -1919,6 +1973,18 @@ static HRESULT WINAPI SAXDeclHandler_elementDecl(ISAXDeclHandler *iface,
     TRACE("(%p)->(%s:%d %s:%d)\n", This, debugstr_wn(name, n_name), n_name,
         debugstr_wn(model, n_model), n_model);
 
+    if (writer_is_v6(This))
+    {
+        if ((!name && n_name) || (!model && n_model)) return E_INVALIDARG;
+
+        write_output_buffer(This, elementW, ARRAY_SIZE(elementW));
+        if (name) write_output_buffer(This, name, n_name);
+        write_output_buffer(This, spaceW, ARRAY_SIZE(spaceW));
+        if (model) write_output_buffer(This, model, n_model);
+        write_output_buffer(This, closetagW, ARRAY_SIZE(closetagW));
+        return S_OK;
+    }
+
     if (!name || !model) return E_INVALIDARG;
 
     write_output_buffer(This, elementW, ARRAY_SIZE(elementW));
@@ -1933,6 +1999,13 @@ static HRESULT WINAPI SAXDeclHandler_elementDecl(ISAXDeclHandler *iface,
     return S_OK;
 }
 
+static BOOL is_no_default_mode(const WCHAR *mode, int len)
+{
+    if (!mode) return FALSE;
+    if (len == -1) len = lstrlenW(mode);
+    return (len == 9 && !wcsncmp(mode, L"#REQUIRED", 9)) || (len == 8 && !wcsncmp(mode, L"#IMPLIED", 8));
+}
+
 static HRESULT WINAPI SAXDeclHandler_attributeDecl(ISAXDeclHandler *iface,
     const WCHAR *element, int n_element, const WCHAR *attr, int n_attr,
     const WCHAR *type, int n_type, const WCHAR *Default, int n_default,
@@ -1941,6 +2014,7 @@ static HRESULT WINAPI SAXDeclHandler_attributeDecl(ISAXDeclHandler *iface,
     mxwriter *This = impl_from_ISAXDeclHandler( iface );
     static const WCHAR attlistW[] = {'<','!','A','T','T','L','I','S','T',' '};
     static const WCHAR closetagW[] = {'>','\r','\n'};
+    BOOL write_value;
 
     TRACE("(%p)->(%s:%d %s:%d %s:%d %s:%d %s:%d)\n", This, debugstr_wn(element, n_element), n_element,
         debugstr_wn(attr, n_attr), n_attr, debugstr_wn(type, n_type), n_type, debugstr_wn(Default, n_default), n_default,
@@ -1962,12 +2036,17 @@ static HRESULT WINAPI SAXDeclHandler_attributeDecl(ISAXDeclHandler *iface,
         write_output_buffer(This, spaceW, ARRAY_SIZE(spaceW));
     }
 
+    /* version 6 keeps the default value only for a default or #FIXED attribute,
+       and has no separator after a mode that is last */
+    write_value = n_value && !(writer_is_v6(This) && is_no_default_mode(Default, n_default));
+
     if (n_default) {
         write_output_buffer(This, Default, n_default);
-        write_output_buffer(This, spaceW, ARRAY_SIZE(spaceW));
+        if (write_value || !writer_is_v6(This))
+            write_output_buffer(This, spaceW, ARRAY_SIZE(spaceW));
     }
 
-    if (n_value)
+    if (write_value)
         write_output_buffer_quoted(This, value, n_value);
 
     write_output_buffer(This, closetagW, ARRAY_SIZE(closetagW));
@@ -1983,6 +2062,19 @@ static HRESULT WINAPI SAXDeclHandler_internalEntityDecl(ISAXDeclHandler *iface,
     TRACE("(%p)->(%s:%d %s:%d)\n", This, debugstr_wn(name, n_name), n_name,
         debugstr_wn(value, n_value), n_value);
 
+    if (writer_is_v6(This))
+    {
+        if (n_name == -1 || n_value == -1 || (!name && n_name) || (!value && n_value))
+            return E_INVALIDARG;
+
+        write_output_buffer(This, entityW, ARRAY_SIZE(entityW));
+        if (name) write_output_buffer(This, name, n_name);
+        write_output_buffer(This, spaceW, ARRAY_SIZE(spaceW));
+        write_output_buffer_quoted(This, value ? value : L"", n_value);
+        write_output_buffer(This, closetagW, ARRAY_SIZE(closetagW));
+        return S_OK;
+    }
+
     if (!name || !value) return E_INVALIDARG;
 
     write_output_buffer(This, entityW, ARRAY_SIZE(entityW));
@@ -2008,6 +2100,31 @@ static HRESULT WINAPI SAXDeclHandler_externalEntityDecl(ISAXDeclHandler *iface,
     TRACE("(%p)->(%s:%d %s:%d %s:%d)\n", This, debugstr_wn(name, n_name), n_name,
         debugstr_wn(publicId, n_publicId), n_publicId, debugstr_wn(systemId, n_systemId), n_systemId);
 
+    if (writer_is_v6(This))
+    {
+        if (n_name == -1 || (!name && n_name)) return E_INVALIDARG;
+
+        write_output_buffer(This, entityW, ARRAY_SIZE(entityW));
+        if (!publicId && !systemId) return E_INVALIDARG;
+        write_output_buffer(This, name, n_name);
+        write_output_buffer(This, spaceW, ARRAY_SIZE(spaceW));
+        if (publicId)
+        {
+            write_output_buffer(This, publicW, ARRAY_SIZE(publicW));
+            write_output_buffer_quoted(This, publicId, n_publicId);
+            if (!systemId) return E_INVALIDARG;
+            write_output_buffer(This, spaceW, ARRAY_SIZE(spaceW));
+            write_output_buffer_quoted(This, systemId, n_systemId);
+        }
+        else
+        {
+            write_output_buffer(This, systemW, ARRAY_SIZE(systemW));
+            write_output_buffer_quoted(This, systemId, n_systemId);
+        }
+        write_output_buffer(This, closetagW, ARRAY_SIZE(closetagW));
+        return S_OK;
+    }
+
     if (!name || !systemId) return E_INVALIDARG;
 
     write_output_buffer(This, entityW, ARRAY_SIZE(entityW));
@@ -2098,9 +2215,10 @@ static HRESULT WINAPI VBSAXDeclHandler_elementDecl(IVBSAXDeclHandler *iface, BST
     TRACE("(%p)->(%p %p)\n", This, name, model);
 
     if (!name || !model)
-        return E_POINTER;
+        return vb_null_arg(This);
 
-    return ISAXDeclHandler_elementDecl(&This->ISAXDeclHandler_iface, *name, -1, *model, -1);
+    return ISAXDeclHandler_elementDecl(&This->ISAXDeclHandler_iface, *name, vb_len(This, *name),
+        *model, vb_len(This, *model));
 }
 
 static HRESULT WINAPI VBSAXDeclHandler_attributeDecl(IVBSAXDeclHandler *iface,
@@ -2124,9 +2242,10 @@ static HRESULT WINAPI VBSAXDeclHandler_internalEntityDecl(IVBSAXDeclHandler *ifa
     TRACE("(%p)->(%p %p)\n", This, name, value);
 
     if (!name || !value)
-        return E_POINTER;
+        return vb_null_arg(This);
 
-    return ISAXDeclHandler_internalEntityDecl(&This->ISAXDeclHandler_iface, *name, -1, *value, -1);
+    return ISAXDeclHandler_internalEntityDecl(&This->ISAXDeclHandler_iface, *name, vb_len(This, *name),
+        *value, vb_len(This, *value));
 }
 
 static HRESULT WINAPI VBSAXDeclHandler_externalEntityDecl(IVBSAXDeclHandler *iface,
@@ -2137,9 +2256,10 @@ static HRESULT WINAPI VBSAXDeclHandler_externalEntityDecl(IVBSAXDeclHandler *ifa
     TRACE("(%p)->(%p %p %p)\n", This, name, publicid, systemid);
 
     if (!name || !publicid || !systemid)
-        return E_POINTER;
+        return vb_null_arg(This);
 
-    return ISAXDeclHandler_externalEntityDecl(&This->ISAXDeclHandler_iface, *name, -1, *publicid, -1, *systemid, -1);
+    return ISAXDeclHandler_externalEntityDecl(&This->ISAXDeclHandler_iface, *name, vb_len(This, *name),
+        *publicid, vb_len(This, *publicid), *systemid, vb_len(This, *systemid));
 }
 
 static const IVBSAXDeclHandlerVtbl VBSAXDeclHandlerVtbl = {
@@ -2210,9 +2330,10 @@ static HRESULT WINAPI VBSAXLexicalHandler_startDTD(IVBSAXLexicalHandler *iface,
     TRACE("(%p)->(%p %p %p)\n", This, name, publicId, systemId);
 
     if (!name || !publicId || !systemId)
-        return E_POINTER;
+        return vb_null_arg(This);
 
-    return ISAXLexicalHandler_startDTD(&This->ISAXLexicalHandler_iface, *name, -1, *publicId, -1, *systemId, -1);
+    return ISAXLexicalHandler_startDTD(&This->ISAXLexicalHandler_iface, *name, vb_len(This, *name),
+        *publicId, vb_len(This, *publicId), *systemId, vb_len(This, *systemId));
 }
 
 static HRESULT WINAPI VBSAXLexicalHandler_endDTD(IVBSAXLexicalHandler *iface)
@@ -2264,9 +2385,9 @@ static HRESULT WINAPI VBSAXLexicalHandler_comment(IVBSAXLexicalHandler *iface, B
     TRACE("(%p)->(%p)\n", This, chars);
 
     if (!chars)
-        return E_POINTER;
+        return vb_null_arg(This);
 
-    return ISAXLexicalHandler_comment(&This->ISAXLexicalHandler_iface, *chars, -1);
+    return ISAXLexicalHandler_comment(&This->ISAXLexicalHandler_iface, *chars, vb_len(This, *chars));
 }
 
 static const IVBSAXLexicalHandlerVtbl VBSAXLexicalHandlerVtbl = {
@@ -2382,7 +2503,7 @@ static HRESULT WINAPI VBSAXContentHandler_startElement(IVBSAXContentHandler *ifa
 
     TRACE("(%p)->(%p %p %p %p)\n", This, namespaceURI, localName, QName, attrs);
 
-    if (!namespaceURI || !*namespaceURI || !localName || !QName)
+    if (!namespaceURI || (!*namespaceURI && !writer_is_v6(This)) || !localName || !QName)
         return E_INVALIDARG;
 
     TRACE("(%s %s %s)\n", debugstr_w(*namespaceURI), debugstr_w(*localName), debugstr_w(*QName));
@@ -2538,10 +2659,14 @@ static HRESULT WINAPI SAXDTDHandler_notationDecl(ISAXDTDHandler *iface,
     TRACE("(%p)->(%s:%d, %s:%d, %s:%d)\n", This, debugstr_wn(name, n_name), n_name,
         debugstr_wn(publicid, n_publicid), n_publicid, debugstr_wn(systemid, n_systemid), n_systemid);
 
+    if (writer_is_v6(This))
+        write_output_buffer(This, notationW, ARRAY_SIZE(notationW));
+
     if (!name || !n_name)
         return E_INVALIDARG;
 
-    write_output_buffer(This, notationW, ARRAY_SIZE(notationW));
+    if (!writer_is_v6(This))
+        write_output_buffer(This, notationW, ARRAY_SIZE(notationW));
     write_output_buffer(This, name, n_name);
 
     if (!publicid && !systemid)
@@ -2882,6 +3007,7 @@ HRESULT MXWriter_create(MSXML_VERSION version, void **ppObj)
     This->encoding = SysAllocString(utf16W);
     This->version  = SysAllocString(version10W);
     This->xml_enc  = XmlEncoding_UTF16;
+    This->encoding_set = FALSE;
 
     This->element = NULL;
     This->cdata = FALSE;
@@ -3454,8 +3580,27 @@ static HRESULT WINAPI SAXAttributes_getQName(ISAXAttributes *iface, int index, c
 
     TRACE("(%p)->(%d %p %p)\n", This, index, qname, length);
 
-    if (index >= This->length) return E_INVALIDARG;
-    if (!qname || !length) return E_POINTER;
+#ifndef SG_MUTANT_MXATTR_V6
+    if (This->class_version == MSXML6)
+#else
+    if (0)
+#endif
+    {
+        /* version 6 checks the pointers first and clears the results */
+        if (!qname || !length)
+        {
+            if (qname) *qname = NULL;
+            return E_POINTER;
+        }
+        *qname = NULL;
+        *length = 0;
+        if (index >= This->length || index < 0) return E_INVALIDARG;
+    }
+    else
+    {
+        if (index >= This->length) return E_INVALIDARG;
+        if (!qname || !length) return E_POINTER;
+    }
 
     *qname = This->attr[index].qname;
     *length = SysStringLen(This->attr[index].qname);
diff --git a/dlls/msxml3/tests/saxreader.c b/dlls/msxml3/tests/saxreader.c
