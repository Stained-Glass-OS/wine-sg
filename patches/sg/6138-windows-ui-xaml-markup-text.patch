+/* one of our classes' factories, whatever the switch (our own markup reader makes our objects) */
+HRESULT xaml_get_factory( const WCHAR *name, IActivationFactory **factory )
+{
+    unsigned int i;
+
+    *factory = NULL;
+    for (i = 0; i < ARRAY_SIZE(classes); i++)
+        if (!wcscmp( name, classes[i].name ))
+            return IActivationFactory_QueryInterface( *classes[i].factory, &IID_IActivationFactory, (void **)factory );
